load("./lib/bazel_exec.axl", "VESPER", "VESPER_TOOLS", "prebuild_executables")
load("./lib/process.axl", "command", "root_path")

_QUERY = "filter(':example/', //crates/...)"

def _prebuild(ctx: TaskContext) -> int:
    root = ctx.std.env.aspect_root_dir()
    destination = ctx.args.tool_args[0] if ctx.args.tool_args else ".ci-bazel-executables"
    path = root_path(root, destination)
    if ctx.std.fs.exists(path):
        ctx.std.fs.remove_file(path)
    bazel = ctx.std.env.var("BAZEL") or "bazel"
    flags = (ctx.std.env.var("BAZEL_FLAGS") or "").split()
    examples = command(ctx, bazel, ["query"] + flags + [_QUERY], root).stdout("piped").stderr("null").spawn().wait_with_output()
    targets = [VESPER, VESPER_TOOLS, "//crates/vesper-oracles:bin/logos42"] + examples.stdout.split()
    count = prebuild_executables(ctx, root, path, targets)
    if count == None:
        ctx.std.io.stderr.write("warning: prebuilding acceptance executables failed; each task will build its own\n")
        return 0
    ctx.std.io.stdout.write("Prebuilt %d executables into %s\n" % (count, destination))
    return 0

prebuild_acceptance = task(
    kind = "prebuild-acceptance",
    group = ["ci"],
    summary = "Build and record the executables needed by the acceptance tasks",
    implementation = _prebuild,
    args = {"tool_args": args.trailing_var_args(description = "Optional manifest path, default .ci-bazel-executables.")},
)
