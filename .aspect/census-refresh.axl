"""Regenerate the Rust census and publish the generated-file-only refresh."""

load("./lib/process.axl", "capture", "check", "command", "exit_code")

def _required(ctx, name):
    value = ctx.std.env.var(name)
    if not value:
        ctx.std.process.exit(2, name + " is required")
    return value

def _generate(ctx: TaskContext) -> int:
    root = ctx.std.env.aspect_root_dir()
    report = capture(ctx, ctx.std.env.current_exe(), ["maintenance", "rust-census"], root)
    ctx.std.fs.write(root + "/" + _required(ctx, "FILE"), report)
    return 0

generate_census = task(
    kind = "generate-census",
    group = ["ci"],
    summary = "Regenerate the Rust census for its refresh pull request",
    implementation = _generate,
)

def publish_census(changed, branch, file, run, get, tell):
    list_prs = ["pr", "list", "--head", branch, "--state", "open", "--json", "number"]
    if not changed:
        for pr in json.decode(get("gh", list_prs)):
            run("gh", ["pr", "close", str(pr["number"]), "--delete-branch", "--comment", "The census on main is current; this refresh is obsolete."])
        tell("the census on main is current\n")
        return
    run("git", ["checkout", "-B", branch])
    run("git", [
        "-c", "user.name=github-actions",
        "-c", "user.email=41898282+github-actions[bot]@users.noreply.github.com",
        "commit", "-q", "-m", "Refresh the Rust census", "--", file,
    ])
    run("git", ["push", "--force", "origin", branch])
    if not json.decode(get("gh", list_prs)):
        sha = get("git", ["rev-parse", "--short", "origin/main"]).strip()
        run("gh", ["pr", "create", "--base", "main", "--head", branch, "--title", "Refresh the Rust census", "--body",
                   "Regenerated by .github/workflows/rust-census.yml from main at %s. It changes only %s; merge it like any green PR." % (sha, file)])

def _publish(ctx: TaskContext) -> int:
    root = ctx.std.env.aspect_root_dir()
    file = _required(ctx, "FILE")
    branch = _required(ctx, "BRANCH")
    diff = exit_code(command(ctx, "git", ["diff", "--quiet", "--", file], root).status())
    if diff not in [0, 1]:
        ctx.std.process.exit(diff, "Could not check changes to the generated census")
    publish_census(
        diff == 1,
        branch,
        file,
        lambda tool, argv: check(ctx, tool, argv, root),
        lambda tool, argv: capture(ctx, tool, argv, root),
        ctx.std.io.stdout.write,
    )
    return 0

refresh_census_pr = task(
    kind = "refresh-census-pr",
    group = ["ci"],
    summary = "Open, update or close the generated Rust census pull request",
    implementation = _publish,
)
