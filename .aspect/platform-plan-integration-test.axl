"""Exercise platform planning against a real Git checkout."""

load("./lib/process.axl", "capture")
load("./lib/task-fixture.axl", "contains", "equal", "fixture_workspace", "invoke_fixture", "write_fixture")

_CATALOG = "/scripts/ci/platform_test_profiles.json"

def _test(ctx):
    workspace = fixture_workspace(ctx, "vesper-platform-plan-test-")
    root, cwd = workspace.root, workspace.cwd

    def git(argv):
        return capture(ctx, "git", argv, root).strip()

    def run(argv, status = 0, env = {}, tool = None):
        return invoke_fixture(ctx, argv, cwd, status, env, tool)

    git(["init", "-q", "-b", "main"])
    for key, value in {"user.name": "Fixture", "user.email": "fixture@example.invalid", "commit.gpgsign": "false"}.items():
        git(["config", key, value])
    good = {"package": "vesper", "target": "suite", "bazel": "//:test/suite", "group": "proof",
            "source": "tests/suite.rs", "skip_tests": ["slow"]}
    policy = {
        "version": 1, "shared_paths": ["Cargo.*"],
        "groups": {"frontend": {"paths": ["src/native*"]}, "proof": {"paths": ["lean/**"]}},
        "deferred_targets": [good],
    }
    source = root + "/tests/suite.rs"
    write_fixture(ctx, root + _CATALOG, json.encode(policy))
    write_fixture(ctx, source, "#[test]\n#[cfg(unix)]\nfn slow() {}\n#[test]\nfn fast() {}\n")
    git(["add", "scripts", "tests"])
    git(["commit", "-qm", "base"])
    base = git(["rev-parse", "HEAD"])
    command = ["ci", "platform-test-plan", "--", "plan"]
    empty = json.decode(run(command + ["--profile=pr", "--base", base, "--head", base]).stdout)
    equal((empty["groups"], empty["changed_paths"]), ([], []))
    branch_path = "src/native part λ\nodd.rs"
    git(["switch", "-qc", "feature"])
    write_fixture(ctx, root + "/" + branch_path, "fixture\n")
    git(["add", "src"])
    git(["commit", "-qm", "feature"])
    feature = git(["rev-parse", "HEAD"])
    body = json.decode(run(command + ["--profile", "pr", "--head", feature, "--base", base]).stdout)
    equal(body, {"profile": "pr", "groups": ["frontend"], "sha": feature,
                 "reason": "groups selected from changed paths", "changed_paths": [branch_path]})
    for unavailable in ["", "f" * 40, "bad-ref"]:
        result = json.decode(run(command + ["--profile", "pr", "--head", feature, "--base", unavailable]).stdout)
        equal(result["groups"], ["frontend", "proof"])
        equal(result["reason"], "base unavailable; full coverage selected")
    full = command + ["--profile", "full", "--head"]
    for invalid, message in [("HEAD", "full 40-hex SHA"), ("f" * 40, "commit unavailable"), (base, "checked-out commit")]:
        contains(message, run(full + [invalid], 2).stderr)
    run(command + ["--profile", "quick", "--head", feature], 2)
    run(full, 2)
    verify_dispatch = ["ci", "verify-platform-dispatch"]
    verify_checkout = ["ci", "verify-platform-checkout"]
    run(verify_dispatch, env = {"PR_HEAD": feature})
    run(verify_checkout, env = {"EXPECTED_SHA": feature})
    run(verify_checkout, 2, {"EXPECTED_SHA": base})
    run(verify_checkout, 2, {"EXPECTED_SHA": ""})
    contains("neither the dispatched PR head nor its test merge", run(verify_dispatch, 2, {"PR_HEAD": base}).stderr)
    run(verify_dispatch, 2, {"PR_HEAD": ""})
    git(["switch", "-q", "main"])
    git(["merge", "--no-ff", "-qm", "test merge", "feature"])
    run(verify_dispatch, env = {"PR_HEAD": feature})
    head = git(["rev-parse", "HEAD"])
    output_file, output_dir = root + "/github output", root + "/runner temp"
    write_fixture(ctx, output_file, "earlier=preserved\n")
    workflow = ["ci", "plan-platform-workflow"]
    env = {"GITHUB_OUTPUT": output_file, "RUNNER_TEMP": output_dir, "REQUESTED_PROFILE": "pr", "BASE_SHA": base}
    result = json.decode(run(workflow, env = env).stdout)
    equal(result, json.decode(ctx.std.fs.read_to_string(output_dir + "/platform-plan.json")))
    equal(result["sha"], head)
    equal(ctx.std.fs.read_to_string(output_file), 'earlier=preserved\nprofile=pr\ngroups=["frontend"]\nsha=' + head + "\n")
    run(workflow, 2, dict(env, GITHUB_OUTPUT = ""))

    git(["switch", "--orphan", "unrelated"])
    git(["commit", "--allow-empty", "-qm", "unrelated root"])
    unrelated = git(["rev-parse", "HEAD"])
    git(["switch", "-q", "main"])
    result = json.decode(run(command + ["--profile", "pr", "--head", head, "--base", unrelated]).stdout)
    equal(result["reason"], "diff unavailable; full coverage selected")
    equal(result["groups"], ["frontend", "proof"])

    pwsh = ctx.std.process.which("pwsh")
    if pwsh:
        script = "/scripts/windows/verify-platform-checkout.ps1"
        write_fixture(ctx, root + script, ctx.std.fs.read_to_string(workspace.source + script))
        argv = ["-NoProfile", "-File", root + script]
        run(argv, env = {"EXPECTED_SHA": head}, tool = pwsh)
        contains("found " + head, run(argv, 2, {"EXPECTED_SHA": "f" * 40}, pwsh).stderr)
        run(argv, 2, {"EXPECTED_SHA": ""}, pwsh)

    def reject(message, changes = {}):
        write_fixture(ctx, root + _CATALOG, json.encode(dict(policy, **changes)))
        output = run(["ci", "platform-test-plan", "--", "--profile", "full", "--head", head], 2)
        equal(output.stdout, "")
        contains(message, output.stderr)

    reject("unsupported platform test policy version", {"version": 2})
    reject("policy needs named escalation groups", {"groups": {}})
    reject("invalid paths for proof", {"groups": {"proof": {"paths": [""]}}})
    reject("invalid shared paths", {"shared_paths": [1]})
    reject("invalid deferred-target record", {"deferred_targets": [{}]})
    reject("unknown escalation group", {"deferred_targets": [dict(good, group = "missing")]})
    reject("selectors disagree", {"deferred_targets": [dict(good, bazel = "//:test/other")]})
    reject("duplicate deferred-target selector", {"deferred_targets": [good, good]})
    reject("invalid exact test-case selectors", {"deferred_targets": [dict(good, skip_tests = ["slow", "slow"])]})
    reject("stale test cases", {"deferred_targets": [dict(good, skip_tests = ["renamed"])]})
    reject("partial exclusion leaves no PR tests", {"deferred_targets": [dict(good, skip_tests = ["slow", "fast"])]})
    ctx.std.fs.remove_file(source)
    reject("catalog source missing")
    return 0

test_platform_plan_integration = task(
    kind = "platform-plan-integration", group = ["ci", "tests"],
    summary = "Test platform selection, receipt identity and malformed catalogs in real Git histories",
    implementation = _test,
)
