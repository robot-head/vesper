"""Format generators that operate on checked source data with native AXL."""

load("./lib/process.axl", "root_path")

def _bit_length(value: int) -> int:
    # Both the largest power and the widest quotient fit in 1024 bits.
    remaining = value
    for bit in range(1025):
        if remaining == 0:
            return bit
        remaining >>= 1
    fail("power exceeds the generator's bit bound")

def _hex64(value: int) -> str:
    return ("0000000000000000" + ("%x" % value))[-16:]

def _gen_pow5(ctx: TaskContext) -> int:
    lo = -342
    hi = 308
    powers = [1]
    for _ in range(-lo):
        powers.append(powers[-1] * 5)
    lines = [
        "// @generated by aspect crate serde gen-pow5; do not edit.",
        "/// `(high, low)` 64-bit halves of the 128-bit significand of 5^q,",
        "/// for q = %d at index 0 through q = %d." % (lo, hi),
        "pub(crate) static POW5_128: [(u64, u64); %d] = [" % (hi - lo + 1),
    ]
    for q in range(lo, hi + 1):
        power = powers[abs(q)]
        bits = _bit_length(power)
        if q < 0:
            # The +1 survives for small negative powers. More negative ones
            # use a wider quotient, then truncate it to 128 bits.
            exponent = bits + 127 if q >= -27 else 2 * bits + 128
            power = (1 << exponent) // power + 1
            bits = _bit_length(power)
        if bits > 128:
            power >>= bits - 128
        elif q >= 0:
            power <<= 128 - bits
        lines.append("    (0x%s, 0x%s)," % (_hex64(power >> 64), _hex64(power & ((1 << 64) - 1))))
    lines.append("];")
    ctx.std.io.stdout.write("\n".join(lines) + "\n")
    return 0

serde_gen_pow5 = task(
    kind = "gen-pow5",
    group = ["crate", "serde"],
    summary = "Generate the 128-bit power-of-five table used by the decimal parser",
    implementation = _gen_pow5,
)

def _markdown_unescape(text: str) -> str:
    result = []
    escaped = False
    for char in text.elems():
        if escaped or char != "\\":
            result.append(char)
            escaped = False
        else:
            escaped = True
    if escaped:
        result.append("\\")
    return "".join(result)

def _static_table(rfc: str) -> str:
    started = False
    rows = []
    capacity = 0
    for line in rfc.splitlines():
        if line.startswith("# Static Table"):
            started = True
        if started and line.startswith("{: title"):
            break
        if not started or not line.startswith("|") or not line.rstrip().endswith("|"):
            continue
        fields = line.rstrip()[1:-1].split("|", 2)
        if len(fields) != 3 or not fields[0].strip().isdigit():
            continue
        index = int(fields[0].strip())
        if index != len(rows):
            fail("Expected RFC 9204 static index %d, got %d" % (len(rows), index))
        name = fields[1].strip()
        value = _markdown_unescape(fields[2].strip())
        rows.append((name, value))
        capacity += len(name) + len(value)
    if len(rows) != 99:
        fail("Expected 99 RFC 9204 static entries, got %d" % len(rows))
    out = [
        "// Generated by aspect crate prism-h3 gen-tables from the RFC 9204 text.",
        "// Do not edit by hand.",
        "",
        "// The QPACK static table (RFC 9204 Appendix A): the names and values",
        "// concatenated, and the end of each name and value (two per index).",
        "pub fn static_bytes() -> ChunkSeq[u8] {",
        "    let mut b = ChunkSeq::with_capacity[u8](%d);" % capacity,
    ]
    for name, value in rows:
        out.append("    b.extend(in %s.as_bytes());" % json.encode(name))
        if value:
            out.append("    b.extend(in %s.as_bytes());" % json.encode(value))
    out.extend(["    b", "}", "", "pub fn static_ends() -> ChunkSeq[u64] {"])
    out.append("    let mut e = ChunkSeq::with_capacity[u64](198);")
    offset = 0
    for name, value in rows:
        for field in [name, value]:
            offset += len(field)
            out.append("    e.push(%d);" % offset)
    out.extend(["    e", "}", ""])
    return "\n".join(out)

def _huffman_table(table: str) -> str:
    table = table.partition("ENCODE_TABLE")[2].partition("];")[0]
    entries = []
    for row in table.split("("):
        fields = row.partition(")")[0].split(",")
        if len(fields) != 2 or not fields[0].strip().isdigit():
            continue
        bits = int(fields[0].strip())
        value = int(fields[1].strip().replace("_", ""), 16)
        entries.append("    c.push(%d);" % ((bits << 32) | value))
    if len(entries) != 257:
        fail("Expected 257 HPACK Huffman entries, got %d" % len(entries))
    out = [
        "// Generated by aspect crate prism-h3 gen-tables from the h2 0.4.12 crate's",
        "// ENCODE_TABLE. Do not edit by hand.",
        "",
        "// The HPACK Huffman code (RFC 7541 Appendix B): `bit length << 32 | code`",
        "// per symbol, symbol 256 being EOS.",
        "pub fn huffman_codes() -> ChunkSeq[u64] {",
        "    let mut c = ChunkSeq::with_capacity[u64](257);",
    ]
    return "\n".join(out + entries + ["    c", "}", ""])

def _gen_tables(ctx: TaskContext) -> int:
    inputs = ctx.args.tool_args
    if len(inputs) != 3:
        ctx.std.process.exit(2, "Expected <rfc9204.md> <h2-table.rs> <crate-dir>")
    cwd = ctx.std.env.current_dir()
    rfc, h2, crate = [root_path(cwd, path) for path in inputs]
    static_table = _static_table(ctx.std.fs.read_to_string(rfc))
    huffman = _huffman_table(ctx.std.fs.read_to_string(h2))
    ctx.std.fs.write(crate + "/vesper/src/static_table.ves", static_table)
    ctx.std.fs.write(crate + "/vesper/src/huffman_codes.ves", huffman)
    return 0

prism_h3_gen_tables = task(
    kind = "gen-tables",
    group = ["crate", "prism-h3"],
    summary = "Regenerate the RFC 9204 static table and HPACK Huffman codes",
    implementation = _gen_tables,
    args = {"tool_args": args.trailing_var_args(description = "Pass RFC 9204 Markdown, the h2 0.4.12 Huffman table and the crate directory.")},
)
