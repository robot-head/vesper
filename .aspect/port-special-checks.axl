"""Crate port checks that need Rust test artifacts or verifier diagnostics."""

load("./lib/cargo.axl", "test_artifacts")
load("./lib/port_checks.axl", "divergence", "port_checks")
load("./lib/process.axl", "check", "command", "scratch_dir")

_FEATURE = ["--features", "vesper-port-divergent"]
_SERIAL = ["--", "--test-threads=1"]

def _ignis(ctx: TaskContext, root: str):
    env = {}
    for suite in ["planner", "multi_backend", "lifecycle"]:
        paths = test_artifacts(ctx, root, ["--color", "never", "-p", "vesper-ignis"] + _FEATURE + ["--test", suite], [suite])
        env["VESPER_IGNIS_DIVERGENT_" + suite.upper()] = paths[0]
    check(ctx, "cargo", ["test", "--locked", "-p", "vesper-ignis", "--test", "divergence", "--", "--nocapture"], root, env)
    ctx.std.io.stdout.write("Detected divergent Ignis port tests\n")

ignis_check = port_checks(
    "ignis", "check",
    [["-p", "vesper-ignis"], ["-p", "vesper-ignis", "--features", "vesper-port"]],
    [],
    after = _ignis,
)

def _realtime_output(ctx: TaskContext, root: str, compiler: str, entry: str, policy: str, output: str, target: str = ""):
    package = "crates/vesper-resonance/vesper"
    argv = ["emit", package, "--emit", "object", "-o", output, "--entry", entry]
    if target:
        argv.extend(["--target", target])
    argv.extend(["--verify-realtime", "--verify-policy", package + "/../port/" + policy])
    return command(ctx, compiler, argv, root).stdout("piped").stderr("piped").spawn().wait_with_output()

def _realtime(ctx: TaskContext, root: str):
    compiler = ctx.std.env.var("VESPER_PORT_COMPILER")
    if not compiler:
        ctx.std.process.exit(1, "Set VESPER_PORT_COMPILER to run the realtime verifier")
    artifact = scratch_dir(ctx, "vesper-realtime-") + "/audio.o"
    for target in ["x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu"]:
        result = _realtime_output(ctx, root, compiler, "rt_audio", "realtime-policy.json", artifact, target)
        log = result.stdout + "\n" + result.stderr
        lines = log.splitlines()
        finding = any([line.endswith("native verifier finding(s)") for line in lines])
        unexpected = any([
            line.startswith("error:") or ("error[" in line and "error[realtime/rt-unbounded-loop]" not in line)
            for line in lines
        ])
        if (not result.status.success and not finding) or unexpected or "panicked" in log or "was not emitted" in log:
            ctx.std.io.stderr.write(log)
            ctx.std.process.exit(1, "The realtime verifier rejected the port's audio path on " + target)

    result = _realtime_output(ctx, root, compiler, "compile_schedule", "realtime-control.json", artifact)
    log = result.stdout + "\n" + result.stderr
    if "error[realtime/rt-unknown-callee]" not in log:
        ctx.std.io.stderr.write(log)
        ctx.std.process.exit(1, "The realtime verifier's positive control was not rejected")
    ctx.std.io.stdout.write("Realtime verifier accepted both audio targets and rejected the allocation control\n")

prism_test_port = port_checks(
    "prism", "test-port",
    [
        ["-p", "vesper-prism"],
        ["-p", "vesper-prism-h3"],
    ],
    [
        divergence(area, _FEATURE + ["--test", suite] + _SERIAL, [failed], [passed])
        for area, suite, failed, passed in [
            ("framing", "framing", "exact_limits_accept_and_overruns_poison_without_retaining_excess", "host_must_be_unique_and_unambiguous_with_valid_port_and_address"),
            ("responses", "responses", "body_forbidden_statuses_omit_length_and_never_accept_a_payload", "exact_binary_response_and_repeated_fields_are_not_combined"),
            ("routing", "routing", "query_entries_plus_duplicates_and_empty_forms_are_defined", "utf8_policy_is_explicit_for_paths_and_queries"),
            ("routing", "routing", "static_segments_beat_parameters_independent_of_insertion_order", "utf8_policy_is_explicit_for_paths_and_queries"),
            ("connection", "connection", "out_of_order_completions_cannot_starve_the_earliest_response", "single_byte_feed_issues_each_request_once"),
        ]
    ],
)

