resonance_test_port = port_checks(
    "resonance", "test-port",
    [
        ["-p", "vesper-resonance", "-p", "vesper-resonance-seed"],
    ],
    [
        divergence(area, _FEATURE + ["--test", suite] + _SERIAL, [failed], [passed])
        for area, suite, failed, passed in [
            ("kernels", "simd", "bank_render_matches_reference_with_events", "host_reports_its_paths"),
            ("events", "realtime", "malformed_event_streams_are_typed_errors", "emergency_silence_zeroes_the_rest_and_drops_are_counted"),
            ("lease", "realtime", "lease_must_be_fully_written_to_commit", "emergency_silence_zeroes_the_rest_and_drops_are_counted"),
            ("pdc", "pdc", "parallel_branches_get_compensation_delays", "buffer_liveness_reuses_buffers"),
            ("graph", "port_differential", "graph_outputs_match_the_rust_build", "events_and_ramps_match_the_rust_build"),
            ("slab", "slab", "delay_slab_read_write_wraps_and_clones_cleanly", "clones_are_realigned_and_hold_the_same_samples"),
            ("simd", "simd", "tick_is_bit_identical_over_filter_range", "host_reports_its_paths"),
            ("confine", "confinement", "allocation_two_calls_deep_is_rejected_with_its_path", "loops_follow_the_policy"),
        ]
    ],
    after = _realtime,
)

loom_cas_test_port = port_checks(
    "loom-cas", "test-port",
    [
        ["-p", "vesper-loom-cas", "-p", "vesper-loom-cas-seed"],
    ],
    [
        divergence(area, _FEATURE + args, [], [], env = {"VESPER_CAS_DIVERGE": area},
                   diagnostics = [evidence] if not anchored else [],
                   line_prefixes = [evidence] if anchored else [])
        for area, args, evidence, anchored in [
            ("name", ["--lib"], "test tree::tests::rejects_adversarial_names ... FAILED", False),
            ("name", ["--test", "codec_differential"], "codecs_agree_with_the_rust_build ... FAILED", False),
            ("id", ["--test", "codec_differential"], "codecs_agree_with_the_rust_build ... FAILED", False),
            ("tree", ["--lib"], "test tree::tests::directory_entries_must_have_zero_size ... FAILED", False),
            ("tree", ["--test", "codec_differential"], "codecs_agree_with_the_rust_build ... FAILED", False),
            ("drv", ["--test", "codec_differential"], "codecs_agree_with_the_rust_build ... FAILED", False),
            ("store", ["--test", "store"], "corrupted_objects_are_rejected_reported_and_repaired ... FAILED", False),
            ("fold", ["--lib"], "test port::tests::name_fold_fixed_cases ... FAILED", False),
            ("fold", ["--test", "store"], "ingest_rejects_nonportable_names ... FAILED", False),
            ("walk", ["--test", "store"], "ingest_rejects_nonportable_names ... FAILED", False),
            ("pack", ["--test", "transfer_acceptance"], "complete_valid_hashes_do_not_authorize_duplicate_extra_missing_or_reordered_records ... FAILED", False),
        ]
    ],
)

