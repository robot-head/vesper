            ("log", ["--test", "self_host_sim_session"], "wal_ops: ", True),
            ("quic", ["--lib"], "test model::umem::tests::header_errors_bounds_and_a_dropping_binding ... FAILED", False),
            ("quic", ["--test", "self_host_sim_session"], "quic_wire: ", True),
            ("process", ["--test", "models"], "test stale_host_completions_are_rejected_without_losing_the_response ... FAILED", False),
            ("failure", ["--test", "models"], "test partitions_heal_and_delayed_failures_replay_exactly ... FAILED", False),
            ("validate", ["--test", "models"], "test model_scenarios_are_validated_at_load ... FAILED", False),
