    [
        divergence(area, _FEATURE + args + _SERIAL, [], [], env = {"VESPER_SIM_DIVERGE": area},
                   diagnostics = [evidence] if not anchored else [],
                   line_prefixes = [evidence] if anchored else [])
        for area, args, evidence, anchored in [
            ("link", ["--lib"], "test model::link::tests::micro_burst_builds_queue_delay_then_tail_drops ... FAILED", False),
            ("link", ["--test", "self_host_sim_session"], "warp_wan: ", True),
            ("wal", ["--test", "self_host_sim_session"], "the port validated the payload", False),
            ("net", ["--lib"], "test model::net::tests::bounds_are_checked_before_anything_is_retained ... FAILED", False),
