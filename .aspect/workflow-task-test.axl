"""Test native dispatch without changing GitHub state."""

load("./native-dispatch.axl", "dispatch", "find_dispatch")

def _equal(actual, expected):
    if actual != expected:
        fail("Expected %r, got %r" % (expected, actual))

def _find(statuses, requests, runs, expected, message = ""):
    calls = []
    output = []
    data = {
        "/commits/head/status": {"statuses": [{"context": key, "state": value} for key, value in statuses]},
        "/commits/head/pulls": requests,
        "/actions/workflows/platforms.yml/runs?event=workflow_dispatch&head_sha=head&per_page=100": {"workflow_runs": runs},
    }

    def get(path):
        calls.append(path)
        return data[path]

    _equal(find_dispatch("owner/repo", "head", get, lambda text: output.append(text)), expected)
    _equal("".join(output), message)

def _dispatch(head, status, expected):
    calls = []
    output = []

    def get(path):
        _equal(path, "/pulls/13")
        return {"head": {"sha": head}}

    def run(args):
        calls.append(args)
        return status

    _equal(dispatch("owner/repo", "head", "13", "branch", get, run, lambda text: output.append(text)), expected)
    if head != "head":
        _equal(calls, [])
        _equal(output, ["PR #13 moved on to later; its own BuildBuddy results start it\n"])
    else:
        _equal(calls, [[
            "workflow", "run", "platforms.yml", "--repo", "owner/repo", "--ref", "branch",
            "-f", "profile=pr", "-f", "checkout_ref=refs/pull/13/merge", "-f", "pull_request=13",
        ]])
        _equal(output, [] if status else ["::warning::could not dispatch Platforms on branch; merge main into it\n"])

def _test(ctx: TaskContext) -> int:
    statuses = [(name, "success") for name in ["Test all targets", "Self-host differentials", "Native and acceptance scripts"]]
    _find(statuses[:2], [], [], None, "Native and acceptance scripts is absent\n")
    for split in ["Self-host codegen differentials", "Self-host differentials 2"]:
        _find(statuses + [(split, "pending")], [], [], None, "no open pull request has head as its head\n")
        _find(statuses + [(split, "error")], [], [], None, "BuildBuddy failed: " + split + "\n")
    _find([("Test all targets", "failure"), statuses[2]], [], [], None, "BuildBuddy failed: Test all targets\n")
    fork = {"state": "open", "head": {"sha": "head", "repo": {"full_name": "fork/repo"}}}
    stale = {"state": "open", "head": {"sha": "old", "repo": {"full_name": "owner/repo"}}}
    closed = {"state": "closed", "head": {"sha": "head", "repo": {"full_name": "owner/repo"}}}
    _find(statuses, [fork, stale, closed], [], None, "no open pull request has head as its head\n")
    allowed = {"number": 13, "state": "open", "head": {"sha": "head", "ref": "branch", "repo": {"full_name": "owner/repo"}}, "base": {"ref": "main"}}
    _find([statuses[2], ("Test all targets", "pending")], [allowed], [], {"number": "13", "base": "main", "branch": "branch"})
    _find(statuses, [allowed], [{"conclusion": None}], None, "Platforms already started for PR #13 at head\n")
    _find(statuses, [fork, allowed], [{"conclusion": "cancelled"}], {"number": "13", "base": "main", "branch": "branch"})
    _dispatch("later", True, "")
    _dispatch("head", False, "")
    _dispatch("head", True, "started macOS and Windows for PR #13 at head\n")
    ctx.std.io.stdout.write("Passed native dispatch cases\n")
    return 0

test_workflow_tasks = task(
    kind = "workflow-tasks",
    group = ["ci", "tests"],
    summary = "Verify native dispatch plans",
    implementation = _test,
)
