load("./lib/script.axl", "run_command")

_ROOT = "/repo with spaces"

def _assert_equal(actual, expected):
    if actual != expected:
        fail("Expected %r, got %r" % (expected, actual))

def _fake_context(calls, tool_args: list[str], code: int | None, signal: int | None):
    def command(interpreter):
        calls.append(("interpreter", interpreter))

        def add_args(argv):
            calls.append(("args", argv))

        def current_dir(path):
            calls.append(("cwd", path))

        def status():
            calls.append(("status",))
            return struct(code = code, signal = signal)

        return struct(args = add_args, current_dir = current_dir, status = status)

    return struct(
        args = struct(tool_args = tool_args),
        std = struct(
            env = struct(aspect_root_dir = lambda: _ROOT),
            process = struct(command = command),
        ),
    )

def _test_script_argv():
    calls = []
    tool_args = ["--flag", "", "two words", "--", "*"]
    ctx = _fake_context(calls, tool_args, 0, None)
    _assert_equal(run_command(ctx, "python3", ["-u"], False, "scripts/check.py"), 0)
    _assert_equal(calls, [
        ("interpreter", "python3"),
        ("args", ["-u", _ROOT + "/scripts/check.py"] + tool_args),
        ("status",),
    ])

def _test_fixed_command():
    calls = []
    ctx = _fake_context(calls, ["-q"], 23, None)
    _assert_equal(run_command(ctx, "python3", ["-m", "unittest"], True, ""), 23)
    _assert_equal(calls, [
        ("interpreter", "python3"),
        ("args", ["-m", "unittest", "-q"]),
        ("cwd", _ROOT),
        ("status",),
    ])

def _test_rooted_script_without_arguments():
    calls = []
    ctx = _fake_context(calls, [], 0, None)
    _assert_equal(run_command(ctx, "sh", [], True, "scripts/check.sh"), 0)
    _assert_equal(calls, [
        ("interpreter", "sh"),
        ("args", [_ROOT + "/scripts/check.sh"]),
        ("cwd", _ROOT),
        ("status",),
    ])

def _test_exit_status():
    for code, signal, expected in [(0, None, 0), (2, None, 2), (255, None, 255), (None, 9, 137), (None, 15, 143), (None, None, 128)]:
        ctx = _fake_context([], [], code, signal)
        _assert_equal(run_command(ctx, "sh", [], False, ""), expected)

def _run_tests(_ctx: TaskContext) -> int:
    tests = [
        _test_script_argv,
        _test_fixed_command,
        _test_rooted_script_without_arguments,
        _test_exit_status,
    ]
    for test_case in tests:
        test_case()
    print("Passed %d Aspect command runner unit tests" % len(tests))
    return 0

aspect_unit = task(
    kind = "aspect-unit",
    group = ["ci", "tests"],
    summary = "Run the AXL command runner unit tests",
    implementation = _run_tests,
)
