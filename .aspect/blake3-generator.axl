"""Generate the unrolled Vesper BLAKE3 compression routine."""

load("./lib/process.axl", "root_path")

_PERMUTATION = [2, 6, 3, 10, 7, 0, 4, 13, 1, 11, 12, 5, 9, 14, 15, 8]
_QUARTERS = [
    (0, 4, 8, 12), (1, 5, 9, 13), (2, 6, 10, 14), (3, 7, 11, 15),
    (0, 5, 10, 15), (1, 6, 11, 12), (2, 7, 8, 13), (3, 4, 9, 14),
]
_IV = [0x6A09E667, 0xBB67AE85, 0x3C6EF372, 0xA54FF53A]
_WORD = """fn word(in m: Slice[u32], i: u64) -> u32 {
    match m.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}
"""
_HEADER = """// @vesper-std/hash::compress: the BLAKE3 compression function.
//
// Generated by aspect maintenance gen-blake3 from the BLAKE3
// reference implementation; do not edit by hand. The 16-word state lives in
// `out`; each round is 8 calls of the quarter round `g` with the message
// permutation applied to the arguments. One straight-line function with the
// state in 16 locals runs more instructions when optimized (shared values are
// recomputed at each store) and takes minutes to compile unoptimized in a
// debug compiler; see docs/parallel-results/self-host-std-data.md.
"""
_QUARTER_FUNCTION = """// The quarter round on state words `a`, `b`, `c` and `d` of `v`.
fn g(inout v: Slice[u32], a: u64, b: u64, c: u64, d: u64, x: u32, y: u32) {
    let mut va = word(in v, a);
    let mut vb = word(in v, b);
    let mut vc = word(in v, c);
    let mut vd = word(in v, d);
    va = wrapping_add(wrapping_add(va, vb), x);
    vd = rotate_right(vd ^ va, 16);
    vc = wrapping_add(vc, vd);
    vb = rotate_right(vb ^ vc, 12);
    va = wrapping_add(wrapping_add(va, vb), y);
    vd = rotate_right(vd ^ va, 8);
    vc = wrapping_add(vc, vd);
    vb = rotate_right(vb ^ vc, 7);
    v.try_set(a, va);
    v.try_set(b, vb);
    v.try_set(c, vc);
    v.try_set(d, vd);
}
"""
_COMPRESS_SIGNATURE = """// Compress the 16 message words `m` into the chaining value `cv` (8 words)
// and write the 16 output words to `out`, which must hold 16 words. Missing
// words read as zero and writes past the end of `out` are dropped, so the
// function is total.
pub fn compress(
    in cv: Slice[u32],
    in m: Slice[u32],
    counter: u64,
    block_len: u32,
    flags: u32,
    inout out: Slice[u32]
) {"""
_INITIAL_VALUES = ["wrapping_u32(counter)", "wrapping_u32(counter >> 32)", "block_len", "flags"]

def _rounds() -> list[list[int]]:
    order = list(range(16))
    rounds = []
    for _ in range(7):
        rounds.append(order)
        order = [order[index] for index in _PERMUTATION]
    return rounds

def _slice_compress() -> str:
    lines = [_HEADER, _WORD, _QUARTER_FUNCTION, _COMPRESS_SIGNATURE]
    for index in range(16):
        lines.append("    let m%d = word(in m, %d);" % (index, index))
    for index in range(8):
        lines.append("    out.try_set(%d, word(in cv, %d));" % (index, index))
    for index, value in enumerate(_IV):
        lines.append("    out.try_set(%d, %d);" % (8 + index, value))
    for index, value in enumerate(_INITIAL_VALUES):
        lines.append("    out.try_set(%d, %s);" % (12 + index, value))
    for number, order in enumerate(_rounds(), start = 1):
        lines.append("    // Round %d." % number)
        for index, quarter in enumerate(_QUARTERS):
            a, b, c, d = quarter
            lines.append("    g(inout out, %d, %d, %d, %d, m%d, m%d);" % (a, b, c, d, order[2 * index], order[2 * index + 1]))
    for index in range(8):
        lines.append("    out.try_set(%d, word(in out, %d) ^ word(in out, %d));" % (index, index, index + 8))
    for index in range(8):
        lines.append("    out.try_set(%d, word(in out, %d) ^ word(in cv, %d));" % (index + 8, index + 8, index))
    return "\n".join(lines + ["}", ""])

def _straight_line_compress() -> str:
    lines = [_WORD, "pub fn compress(in cv: Slice[u32], in m: Slice[u32], counter: u64, block_len: u32, flags: u32, inout out: Slice[u32]) {"]
    for index in range(8):
        lines.append("    let c%d = word(in cv, %d);" % (index, index))
    for index in range(16):
        lines.append("    let m%d = word(in m, %d);" % (index, index))
    for index in range(8):
        lines.append("    let mut s%d = c%d;" % (index, index))
    for index, value in enumerate(_IV):
        lines.append("    let mut s%d: u32 = %d;" % (8 + index, value))
    for index, value in enumerate(_INITIAL_VALUES):
        lines.append("    let mut s%d = %s;" % (12 + index, value))
    for order in _rounds():
        for index, quarter in enumerate(_QUARTERS):
            a, b, c, d = quarter
            x, y = order[2 * index], order[2 * index + 1]
            lines.extend([
                "    s%d = wrapping_add(wrapping_add(s%d, s%d), m%d);" % (a, a, b, x),
                "    s%d = rotate_right(s%d ^ s%d, 16);" % (d, d, a),
                "    s%d = wrapping_add(s%d, s%d);" % (c, c, d),
                "    s%d = rotate_right(s%d ^ s%d, 12);" % (b, b, c),
                "    s%d = wrapping_add(wrapping_add(s%d, s%d), m%d);" % (a, a, b, y),
                "    s%d = rotate_right(s%d ^ s%d, 8);" % (d, d, a),
                "    s%d = wrapping_add(s%d, s%d);" % (c, c, d),
                "    s%d = rotate_right(s%d ^ s%d, 7);" % (b, b, c),
            ])
    for index in range(8):
        lines.append("    out.try_set(%d, s%d ^ s%d);" % (index, index, index + 8))
    for index in range(8):
        lines.append("    out.try_set(%d, s%d ^ c%d);" % (index + 8, index + 8, index))
    return "\n".join(lines + ["}", ""])

def _generate(ctx: TaskContext) -> int:
    argv = ctx.args.tool_args
    if not argv or argv[1:] not in [[], ["--straight-line"]]:
        ctx.std.process.exit(2, "usage: aspect maintenance gen-blake3 -- OUTPUT [--straight-line]")
    source = _straight_line_compress() if len(argv) == 2 else _slice_compress()
    ctx.std.fs.write(root_path(ctx.std.env.current_dir(), argv[0]), source)
    return 0

generate_blake3 = task(
    kind = "gen-blake3",
    group = ["maintenance"],
    summary = "Generate the unrolled BLAKE3 compression source",
    implementation = _generate,
    args = {"tool_args": args.trailing_var_args(description = "Output file and optional --straight-line.")},
)
