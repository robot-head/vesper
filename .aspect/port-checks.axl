            ("lib", ["--lib"], ["devices::queue::reference::differential::capture_matches_the_rust_capture"], ["devices::queue::reference::abba::both_builds_compute_the_same_workload"]),
            ("seccomp", ["--test", "seccomp"], ["malformed_programs_are_rejected"], ["compiled_profile_allows_exactly_the_allowlist"]),
            ("seccomp_port", ["--test", "seccomp_port"], ["validate_and_evaluate_match_rust"], ["compile_matches_rust"]),
            ("guest_mem_port", ["--test", "guest_mem_port"], ["layout_and_locate_match_rust"], ["out_of_bounds_and_overflow_match_rust"]),
            ("block_port", ["--test", "block_port"], ["discard_and_write_zeroes_match_rust"], ["span_and_config_match_rust"]),
            ("net_port", ["--test", "net_port"], ["tx_and_ctrl_match_rust"], ["config_space_matches_rust"]),
            ("vsock_port", ["--test", "vsock_port"], ["credit_saturates_on_shrunken_alloc"], ["header_codec_matches_rust"]),
            ("vmgenid_port", ["--test", "vmgenid_port"], ["address_validation_matches_rust"], ["encode_matches_rust"]),
