"""Cargo and divergence checks for the Vesper crate ports."""

load("./lib/port_checks.axl", "divergence", "port_checks")

_FEATURE = ["--features", "vesper-port-divergent"]
_SERIAL = ["--", "--test-threads=1"]

aegis_check = port_checks(
    "aegis",
    "check",
    [
        ["-p", "vesper-aegis"],
    ],
    [
        divergence(name, _FEATURE + ["--test"] + args + _SERIAL, [failed], [passed], env = {"VESPER_AEGIS_DIVERGE": name})
        for name, args, failed, passed in [
            ("reader", ["parser_fuzz"], "tdx_parser_never_panics_and_round_trips", "claims_wire_decoder_never_panics"),
            ("snp", ["vendor_samples_rest"], "snp_report_versions_and_reserved_fields", "real_quote_v5_td15_ex_verifies_end_to_end"),
            ("tdx", ["vendor_samples_rest"], "real_quote_v5_td15_ex_verifies_end_to_end", "snp_report_versions_and_reserved_fields"),
            ("sgx", ["sgx_quote_v3"], "real_sgx_quote_v3_verifies_end_to_end", "sgx_quote_mutations_never_panic"),
            ("wire", ["port_differential"], "claims_wire_agrees", "snp_reports_agree"),
            ("policy", ["port_differential"], "policy_decisions_agree", "snp_reports_agree"),
            ("time", ["port_differential"], "timestamps_agree", "snp_reports_agree"),
            ("cbor", ["cbor_differential"], "edge_cases_match_ciborium", "random_items_match_ciborium"),
            ("cca", ["port_differential"], "cca_claims_agree", "snp_reports_agree"),
            ("cose", ["port_differential"], "cose_sign1_agrees", "snp_reports_agree"),
            ("corim", ["port_differential"], "corims_agree", "snp_reports_agree"),
            ("corim_cca", ["port_differential"], "corim_store_agrees", "snp_reports_agree"),
            ("gpa", ["gpa_props"], "tracker_matches_reference_bitmap", "dropped_owner_is_counted_as_leaked"),
            ("host", ["host"], "clock_validator_rejects_backwards_and_jumps", "mmap_validator_rejects_overlap_and_invalid_replies"),
        ]
    ],
)

aether_test_port = port_checks(
    "aether",
    "test-port",
    [
        ["-p", "vesper-aether"],
        ["-p", "vesper-aether", "--features", "vesper-port"],
    ],
    [
        divergence(name, _FEATURE + args + _SERIAL, failed, passed)
        for name, args, failed, passed in [
            ("slot_plan", ["--test", "slot_plan"], ["accepts_adjacent_aligned_slots", "overlap_check_matches_pairwise_definition"], ["rejects_each_malformed_region"]),
            ("slot_plan_port", ["--test", "slot_plan_port"], ["verify_matches_the_rust_verifier"], []),
            ("pvh_port", ["--test", "pvh_port"], ["truncations_and_bit_flips_match"], []),
            ("hotset_port", ["--test", "hotset_port"], ["decode_matches_on_valid_and_mutated_encodings"], ["runs_match"]),
            ("hotset", ["--test", "hotset"], ["encoded_form_is_validated"], ["runs_coalesce_and_split_at_the_batch_size"]),
