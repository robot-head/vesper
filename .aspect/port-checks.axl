    [
        ["-p", "vesper-bench-seed", "-p", "vesper-bench"],
        ["-p", "vesper-bench", "--features", "vesper-port"],
    ],
    [
        divergence(name, _FEATURE + ["--test"] + args + _SERIAL, [failed], [passed], env = {"VESPER_BENCH_DIVERGE": name})
        for name, args, failed, passed in [
            ("arithmetic", ["statistics"], "width_specific_counter_model_has_explicit_wrap_and_range_limits", "known_regression_improvement_ties_and_mixed_results"),
            ("paired_difference", ["paired_difference"], "fractional_and_out_of_range_differences_fail_at_their_index", "exact_per_operation_differences_preserve_sign_and_order"),
            ("walsh", ["hodges_lehmann"], "point_estimate_retains_quarter_units_and_integer_extremes", "bounds_and_ambiguous_ranks_fail_closed"),
            ("signed_rank", ["signed_rank"], "zeros_ties_limits_and_extreme_magnitudes_are_explicit", "exact_tied_signed_ranks_match_enumerated_sign_assignments"),
            ("signed_rank_confidence", ["differential"], "signed_rank_family_matches_rust", "wire_records_match_rust"),
            ("hodges_lehmann", ["hodges_lehmann"], "paired_difference_gate_uses_exact_interval_bounds_and_preserves_evidence", "point_estimate_retains_quarter_units_and_integer_extremes"),
            ("statistics", ["layout"], "survival_requires_the_interval_to_exclude_no_difference", "plans_are_deterministic_bounded_and_varied"),
            ("mann_whitney", ["statistics"], "mann_whitney_known_rank_vectors_and_ties", "independent_binomial_rank_and_coverage_vectors"),
            ("contract", ["differential"], "contract_parser_and_gate_match_rust", "wire_records_match_rust"),
            ("contract_gate", ["contract_gate"], "documented_numerical_gates_compare_exact_ratios", "unknown_zero_and_unsupported_evidence_are_never_passes"),
            ("wire", ["wire"], "malformed_records_are_typed_errors", "layout_is_exactly_one_padding_free_cache_line"),
            ("layout", ["differential"], "arithmetic_and_layout_match_rust", "wire_records_match_rust"),
