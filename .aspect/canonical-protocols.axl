"""Exercise actual codecs, explicit lint policy and measured or unavailable PMU."""

load("@std//hash.axl", "sha256")
load("./bounded-stdio.axl", "bounded_run", "utf8")
load("./lib/bazel_exec.axl", "executable", "run_target")
load("./lib/process.axl", "capture", "command", "exit_code", "root_path", "scratch_dir")
load("./lib/source-macro-fixtures.axl", "digest", "equal", "require")
load("./lib/strict-json.axl", "decode_list", "decode_object")

PROTO_PROFILE = "vesper.protobuf.explicit-presence/1"
PROTO_SCHEMA = '{"profile":"vesper.protobuf.explicit-presence/1","root":0,"messages":[{"fields":[{"number":1,"kind":"u64","repeated":false}]}]}'
# Fixed regressions for the exact schema bytes above and input 08 2a.
PROTO_INPUT_BLAKE3 = "d1a1ec12a16f4c9020a0e8e9500e8ed4aafce737dcb56baa3f805e0b96039785"
PROTO_SCHEMA_BLAKE3 = "187b1a3ce443d2d3fef0525c3708fcf54e16e9b63ba43a84ce6b5b7c9b7d3b7b"
PMU_PROVIDER = "linux.perf_event_open.group_read"
CLOCK_PROVIDER = "std::time::Instant"
UNAVAILABLE_REASONS = [
    "UnsupportedPlatform", "PermissionDenied", "OsError", "InvalidRead",
    "InvalidMetadata", "WrongProcessOrThread", "InvalidState",
    "ForeignOrStaleToken", "Exhausted", "CounterRegression",
    "NotFullyScheduled", "NoEvents",
]
_EXAMPLES = ["//crates/vesper-grammar:example/" + name for name in ["protobuf", "der", "ipc"]]
_PROBE = "//crates/vesper-bench-pmu:example/probe"
_USAGE = "Pass -- --binary <vesper> --root <repository> --work <empty directory outside the repository>."
_LIMIT = 32 * 1024 * 1024

def _hex(text):
    return bytes([int(text[index:index + 2], 16) for index in range(0, len(text), 2)])

def _sha256(data):
    hash = sha256()
    hash.update(data)
    return hash.hexdigest()

def _digits(value, signed = False):
    if type(value) != "string":
        return False
    text = value[1:] if signed and value.startswith("-") else value
    return bool(text) and all([digit in "0123456789" for digit in text.elems()])

def _decimal(value, label, positive = False):
    require(_digits(value), "%s must be a decimal string, got %r" % (label, value))
    number = int(value)
    require(not positive or number > 0, "invalid %s: %s" % (label, value))
    return number

def _runner(ctx, root, work, binary):
    def read(path):
        return ctx.std.fs.open(path).read()

    def write(path, data):
        raw = bytes(data)
        stream = ctx.std.fs.create(path)
        written = stream.write(raw)
        stream.close()
        require(written == len(raw), "Incomplete fixture write: " + path)

    def file(name, data):
        path = work + "/" + name
        write(path, data)
        return path

    def run(*argv, success = True):
        values = [str(value) for value in argv]
        result = bounded_run(ctx, root, work, binary, values, timeout = 60, stdout_limit = _LIMIT, stderr_limit = _LIMIT, label = "Canonical protocol compiler")
        stdout = utf8(result.stdout)
        stderr = utf8(result.stderr)
        if success != None:
            require((result.code == 0) == success, "Unexpected exit %d: %r\nstdout=%s\nstderr=%s" % (result.code, values, stdout, stderr))
        return struct(code = result.code, stdout = stdout)

    def report(*argv, success = True):
        result = run(success = success, *(list(argv) + ["--json"]))
        return decode_object(result.stdout), result.code

    def grammar(kind, path, *options, success = True):
        before = read(path)
        data, _ = report(success = success, *(["grammar", "check", kind, path] + list(options)))
        require(read(path) == before, "Grammar command mutated its input")
        require(data["schema"] == "vesper.grammar/1" and data["status"] == ("valid" if success else "invalid"), "Wrong grammar status: %r" % data)
        if success:
            require(data["format"] == kind and data["input_bytes"] == len(before) and data["consumed_bytes"] == len(before), "Grammar did not consume actual bytes")
            require(digest(data["input_blake3"]), "Grammar input identity is missing")
        else:
            require(type(data.get("error")) == "string" and bool(data["error"]), "Invalid grammar report omitted its error")
        return data

    return struct(read = read, write = write, file = file, run = run, report = report, grammar = grammar)

def _check_protocols(run, originals):
    schema = run.file("protobuf-schema.json", PROTO_SCHEMA)
    encoded = run.file("message.pb", _hex("082a"))
    data = run.grammar("protobuf", encoded, "--schema", schema)
    result = data["result"]
    require(data["input_blake3"] == PROTO_INPUT_BLAKE3
            and result["schema_blake3"] == PROTO_SCHEMA_BLAKE3,
            "protobuf actual input/schema snapshot hash differs")
    require(result["profile"] == PROTO_PROFILE and result["roundtrip_bytes_equal"] == True,
            "protobuf did not execute canonical byte roundtrip")
    require(result["projection"]["fields"] == [
        {"number": 1, "value": {"kind": "u64", "value": "42"}}],
        "protobuf did not decode the actual u64 value 42")
    require(result["projection"]["field_occurrences"] == 1
            and not result["projection_truncated"], "unexpected protobuf projection")
    for raw in (_hex("08aa00"), _hex("08010802"), _hex("1001"), _hex("0880")):
        run.write(encoded, raw)
        run.grammar("protobuf", encoded, "--schema", schema, success = False)
    run.write(encoded, _hex("082a"))
    for bad_schema in (
        PROTO_SCHEMA.replace('"root":0', '"root":0,"\\u0072oot":0'),
        PROTO_SCHEMA.replace('"root":0', '"root":0,"unknown":{}'),
        PROTO_SCHEMA.replace('"kind":"u64"', '"kind":"u64","message":null'),
    ):
        run.write(schema, bytes(bad_schema))
        run.grammar("protobuf", encoded, "--schema", schema, success = False)
        require(run.read(schema) == bytes(bad_schema), "schema validator wrote its input")
    run.write(schema, bytes(PROTO_SCHEMA))

    # OpenSSL 3.5.7-generated fixture recorded in the leaf DER test/example:
    # Boolean true, integer -129, bits A0, octets 00ff, null, rsaEncryption OID.
    der_bytes = _hex("301c0101ff0202ff7f030200a0040200ff050006092a864886f70d010101")
    der = run.file("openssl-profile.der", der_bytes)
    result = run.grammar("der", der)["result"]
    children = result["projection"]["value"]["children"]
    require(result["profile"] == "vesper.der.universal-subset/1"
            and result["roundtrip_bytes_equal"] == True and result["nodes"] == 7,
            "DER did not validate/reencode the independent fixture")
    require(result["projection"]["kind"] == "Sequence" and len(children) == 6
            and children[0]["value"]["value"] == True
            and children[1]["value"]["value_i64"] == "-129"
            and children[2]["value"]["unused_bits"] == 0
            and children[2]["value"]["payload"]["hex_prefix"] == "a0"
            and children[3]["value"]["hex_prefix"] == "00ff"
            and children[4]["kind"] == "Null"
            and children[5]["value"]["hex_prefix"] == "2a864886f70d010101",
            "DER actual logical values differ")
    run.write(der, _hex("3106020101020102"))
    result = run.grammar("der", der, "--set-of")["result"]
    require(result["root_set_of"] == True and result["roundtrip_bytes_equal"] == True
            and result["projection"]["kind"] == "SetOf"
            and [c["value"]["value_i64"] for c in result["projection"]["value"]["children"]]
            == ["1", "2"], "typed SET OF canonical order differs")
    run.grammar("der", der, success = False)  # Tag 17 alone does not mean SET OF.
    run.write(der, _hex("3106020102020101"))
    run.grammar("der", der, "--set-of", success = False)
    for raw in [_hex(s) for s in ["04810100", "010101", "0202ffff", "30800000", "05000500", "a000"]]:
        run.write(der, raw)
        run.grammar("der", der, success = False)

    expected = decode_object(utf8(originals["ipc-expected.json"]))["fixtures"]
    for name, reference in expected.items():
        require(name in originals and len(originals[name]) == reference["bytes"]
                and _sha256(originals[name]) == reference["sha256"],
                "committed PyArrow reference bytes differ: %s" % name)
    for name, version in (("modern-v5.arrow", "V5"), ("legacy-v4.arrow", "V4")):
        raw = originals[name]
        require(_sha256(raw) == expected[name]["sha256"],
                "independent Arrow fixture identity changed: %s" % name)
        path = run.file("ipc-%s" % name, raw)
        result = run.grammar("arrow-ipc", path)["result"]
        require(result["profile"] == "arrow.ipc.signed-i64/1"
                and result["canonical_serialization_claimed"] == False
                and result["metadata_version"] == version
                and result["metadata_version_discriminant"] == (4 if version == "V5" else 3)
                and result["batch_count"] == 3 and result["total_rows"] == 13,
                "Arrow version/framing/structural scope differs")
        require([b["rows"] for b in result["batches"]] == [9, 0, 4]
                and [f["name"]["preview"] for f in result["fields"]] == ["nullable", "required"]
                and [f["nullable"] for f in result["fields"]] == [True, False],
                "Arrow schema or real batch lengths differ")
        columns = result["batches"][0]["columns"]
        require(columns[0]["nulls"] == 2 and columns[0]["sum"] == "11"
                and columns[1]["nulls"] == 0 and columns[1]["sum"] == "450"
                and columns[0]["values"] == ["1", None, "-2", "0", "1099511627776",
                                              "-1099511627776", None, "7"]
                and columns[0]["values_truncated"] == True,
                "Arrow actual bitmaps/values/sums differ")
        require(result["batches"][2]["columns"][0]["nulls"] == 4
                and result["batches"][2]["columns"][0]["sum"] == None
                and result["batches"][2]["columns"][1]["sum"] == "12",
                "all-null Arrow evidence was fabricated as a number")
    overflow = run.file("ipc-sum-overflow.arrow", originals["sum-overflow.arrow"])
    column = run.grammar("arrow-ipc", overflow)["result"]["batches"][0]["columns"][0]
    require(column["values"] == ["9223372036854775807", "1"]
            and column["sum"] == None and "Overflow" in column["sum_unavailable_reason"],
            "valid Arrow input's overflowing sum was promoted to numeric evidence")
    for name, reason in {
        "compressed.arrow": "UnsupportedCompression", "dictionary.arrow": "UnsupportedDictionary",
        "nested.arrow": "UnsupportedNested", "int32.arrow": "UnsupportedType",
        "unsigned.arrow": "UnsupportedType", "custom-metadata.arrow": "UnsupportedMetadata",
    }.items():
        path = run.file("unsupported-%s" % name, originals[name])
        require(reason in run.grammar("arrow-ipc", path, success = False)["error"],
                "unsupported actual Arrow fixture did not fail explicitly: %s" % name)


def _check_policy(run, originals):
    source = run.file("lint-demo.ves", originals["lint-demo.ves"])
    config = run.file("Loom.lint.toml", originals["Loom.lint.toml"])
    before = run.read(source)
    initial, _ = run.report("lint", source, "--config", config, success = False)
    require(initial["status"] == "denied" and initial["outcome"]["remaining_denied"] == 2
            and run.read(source) == before, "explicit deny did not fail read-only")
    unused = [d for d in initial["diagnostics"] if d["code"] == "L0102"]
    require(len(unused) == 2 and all([d["severity"] == "deny" for d in unused]),
            "two actual unused effects were not denied")
    policy = initial["policy"]
    require(policy["provenance"]["kind"] == "explicit"
            and policy["provenance"]["path"] == config
            and policy["provenance"]["bytes"] == len(originals["Loom.lint.toml"])
            and digest(policy["provenance"]["blake3"]),
            "policy snapshot provenance is missing")
    require(sorted([r["lint"] for r in policy["unavailable"]]) == [
        "demote_alloc_to_region", "missed_fip_opportunity", "overly_restrictive_mode"]
        and all([r["available"] == False for r in policy["unavailable"]])
        and policy["plugin_packs_supported"] == False,
        "future analyses were fabricated as available")
    fixed, _ = run.report("lint", source, "--config", config, "--fix", "--semver-safe")
    require(fixed["status"] == "checked" and fixed["changed"] == True
            and fixed["applied_edits"] >= 2 and fixed["outcome"]["remaining_denied"] == 0
            and run.read(source) != before, "validated fix did not clear denied unused effects")
    require(fixed["semver"]["classification"] in ["patch", "minor"]
            and fixed["semver"]["required_adapters"] == [], "actual SemVer gate was not compatible")
    require(decode_list(run.run("check", source, "--json").stdout) == []
            and run.run("run", source).stdout.strip() == "42", "fixed source did not check/run as 42")
    final, _ = run.report("lint", source, "--config", config)
    require(not any([d["code"] == "L0102" for d in final["diagnostics"]])
            and final["outcome"]["remaining_denied"] == 0, "denied findings survived fix")
    require(run.read(config) == originals["Loom.lint.toml"], "lint mutated policy config")
    run.write(source, before)
    allow = run.file("allow.toml", '[lints.vesper]\nunused_effect_capability="allow"\noverbroad_inout_projection="allow"\n')
    allowed, _ = run.report("lint", source, "--config", allow, "--fix", "--semver-safe")
    require(allowed["diagnostics"] == [] and not allowed["changed"]
            and allowed["outcome"]["suppressed"] == 3 and run.read(source) == before,
            "allow policy still applied a suppressed fix")
    for bad in ('[lints.vesper]\nunused_effect_capability="future"\n',
                '[lints.vesper]\ndemote_alloc_to_region="deny"\n',
                '[lints.plugins]\nexample={path="plugin.wasm"}\n'):
        invalid = run.file("invalid.toml", bad)
        data, _ = run.report("lint", source, "--config", invalid, "--fix", success = False)
        require(data["status"] == "invalid" and run.read(source) == before
                and run.read(invalid) == bytes(bad), "invalid policy changed owned source/config")


def _check_pairs(pairs, unit, count = 6):
    require(type(pairs) == "list" and len(pairs) == count, "wrong %s pair count" % unit)
    for pair in pairs:
        require(sorted(pair.keys()) == ["baseline_total_" + unit, "candidate_total_" + unit,
                                     "operations_per_arm", "regression_basis_points"],
                "%s pair contains mislabeled or extra measurement fields" % unit)
        _decimal(pair["baseline_total_%s" % unit], "baseline %s" % unit, positive = True)
        _decimal(pair["candidate_total_%s" % unit], "candidate %s" % unit, positive = True)
        require(pair["operations_per_arm"] == 16, "pair did not represent both ABBA windows")
        require(_digits(pair["regression_basis_points"]["floor"], signed = True)
                and _digits(pair["regression_basis_points"]["ceil"], signed = True),
                "ratio bounds lost their exact string representation")


def _check_pmu(run, platform):
    source = run.file("finite-pmu.ves", "fn helper()->u64{42}\nfn main()->u64{helper()}\n")
    before = run.read(source)
    for flags, metric in ((["--pmu"], "time"), (["--metric", "cycles"], "cycles"),
                          (["--pmu", "--metric", "instructions"], "instructions")):
        data, code = run.report(success = None, *(["bench", source, "--samples", 6, "--warmup", 0,
                                   "--iterations", 8] + flags))
        require(run.read(source) == before, "PMU benchmark rewrote source")
        require(data["schema"] == "vesper.bench/1" and data["metric"] == metric,
                "requested metric was not preserved")
        pmu = data["pmu"]
        require(pmu["requested"] == True and pmu["provider"] == PMU_PROVIDER,
                "PMU provider/request identity missing")
        if data["status"] == "inconclusive":
            require(code != 0 and pmu["status"] == "unavailable"
                    and data["provider_requested"] == PMU_PROVIDER
                    and data["evidence"]["hardware_pmu"] == "unavailable",
                    "unavailable PMU falsely succeeded or claimed hardware evidence")
            failure = pmu.get("unavailable") or data.get("observer_error", {}).get("unavailable")
            require(type(failure) == "dict" and failure["reason"] in UNAVAILABLE_REASONS
                    and type(failure["operation"]) == "string" and bool(failure["operation"])
                    and (failure["errno"] == None or type(failure["errno"]) == "int"),
                    "unavailability lost reason/operation/errno")
            if "observer_error" in data:
                require(data["observer_cleanup_errors"] == 0,
                        "observer cleanup loss was mislabeled as mere unavailability")
            if platform != "linux":
                require(failure["reason"] == "UnsupportedPlatform", "non-Linux PMU did not stay unavailable")
            require(all([k not in data for k in ["pairs", "analysis", "clock", "body_calls"]])
                    and all([k not in pmu for k in ["windows", "cycles_pairs", "instructions_pairs"]]),
                    "unavailable PMU exposed samples/counters or a wall-clock fallback")
            require(data["unit"] == {"time": "nanoseconds", "cycles": "cycles",
                                     "instructions": "instructions"}[metric],
                    "unavailable report silently switched units")
            continue
        require(code == 0 and data["status"] == "measured" and pmu["status"] == "measured",
                "unexpected PMU/run failure: %s" % data)
        unit = {"time": "ns", "cycles": "cycles", "instructions": "instructions"}[metric]
        require(data["provider"] == (CLOCK_PROVIDER if metric == "time" else PMU_PROVIDER)
                and data["unit"] == ("nanoseconds" if metric == "time" else metric),
                "selected metric provider/unit do not match measured evidence")
        require(data["body_calls"] == 192 and data["config"] == {
            "epochs": 6, "warmup_epochs": 0, "operations_per_window": 8}, "wrong actual callback count")
        for arm in ("candidate", "baseline"):
            jit = data[arm]["jit"]
            require(jit["modules"] == 1 and jit["compilations"] == 1
                    and jit["entries"] == 1 and jit["defined_functions"] == 2 and jit["runs"] == 96,
                    "PMU kernel was not prepared once and actually invoked 96 times per arm")
        _check_pairs(data["pairs"], unit)
        analysis = data["analysis"]
        require(analysis["gate_decision"] == None and analysis["threshold_bp"] == None
                and analysis["interval"] != None, "measurement-only run incorrectly applied a speed gate")
        nested_pairs = [analysis["median_lower"], analysis["median_upper"],
                        analysis["interval"]["lower"], analysis["interval"]["upper"]]
        _check_pairs(nested_pairs, unit, 4)
        require(all([pair in data["pairs"] for pair in nested_pairs]),
                "analysis endpoints are not actual selected-metric samples")
        require(data["candidate"]["source_blake3"] == data["baseline"]["source_blake3"]
                and digest(data["candidate"]["source_blake3"]),
                "same-source baseline/candidate identities differ")
        clock = data["clock"]
        require(clock["provider"] == CLOCK_PROVIDER and clock["unit"] == "nanoseconds",
                "nested clock was mislabeled as a hardware counter")
        _decimal(clock["elapsed_run_ns"], "clock elapsed", positive = True)
        _check_pairs(clock["pairs"], "ns")
        require(pmu["cycles_unit"] == "cycles" and pmu["instructions_unit"] == "instructions",
                "raw hardware units are missing")
        for counter in ("cycles", "instructions"):
            _check_pairs(pmu["%s_pairs" % counter], counter)
        require(data["pairs"] == (clock["pairs"] if metric == "time" else pmu["%s_pairs" % metric]),
                "top-level pairs did not select the requested provider evidence")
        windows = pmu["windows"]
        require(len(windows) == 24 and type(pmu["scope"]) == "string" and bool(pmu["scope"]),
                "observed windows/measurement boundary scope missing")
        for index, window in enumerate(windows):
            invocation, completion = window["invocation"], window["completion"]
            require(invocation["arm"] == ("baseline" if index % 4 in (0, 3) else "candidate")
                    and invocation["epoch"] == index // 4 and invocation["window"] == index % 4
                    and invocation["warmup"] == False and invocation["operation"] == 0,
                    "PMU windows were not actual A/B/B/A order")
            require(completion["invocation"] == invocation
                    and completion["planned_operations"] == 8 and completion["attempted_operations"] == 8
                    and completion["successful_operations"] == 8 and completion["body"] == "Completed"
                    and completion["clock"]["status"] == "measured", "observer callback invariants differ")
            _decimal(completion["clock"]["elapsed_ns"], "observed elapsed", positive = True)
            _decimal(window["cycles"], "cycles", positive = True)
            _decimal(window["instructions"], "instructions", positive = True)
            require(_decimal(window["enabled_ns"], "enabled", positive = True)
                    == _decimal(window["running_ns"], "running", positive = True),
                    "multiplexed/unscheduled counters were accepted")
        # Independently check each paired total against its actual two observed
        # windows; a relabeled or synthetic selected pair must not pass.
        for epoch in range(6):
            group = windows[epoch * 4:epoch * 4 + 4]
            for counter in ("ns", "cycles", "instructions"):
                totals = [int(w["completion"]["clock"]["elapsed_ns"] if counter == "ns"
                              else w[counter]) for w in group]
                pair = (clock["pairs"] if counter == "ns" else pmu["%s_pairs" % counter])[epoch]
                require(int(pair["baseline_total_%s" % counter]) == totals[0] + totals[3]
                        and int(pair["candidate_total_%s" % counter]) == totals[1] + totals[2],
                        "paired evidence does not aggregate actual ABBA windows")

def _check_fixtures(ctx, root, work, binary):
    require(ctx.std.fs.exists(binary) and ctx.std.fs.metadata(binary).is_file, "Missing executable: " + binary)
    require(work != root and not work.startswith(root.rstrip("/") + "/") and not ctx.std.fs.read_dir(work),
            "Work must be an empty disposable directory outside the repository")
    fixture_dir = root + "/crates/vesper-grammar/tests/fixtures/ipc"
    tracked = {
        "ipc-expected.json": fixture_dir + "/expected.json",
        "lint-demo.ves": root + "/crates/vesper-lint/examples/lint_demo.ves",
        "Loom.lint.toml": root + "/crates/vesper-lint/examples/Loom.lint.toml",
    }
    for entry in ctx.std.fs.read_dir(fixture_dir):
        if entry.path.endswith(".arrow"):
            name = entry.path.rsplit("/", 1)[-1]
            tracked[name] = fixture_dir + "/" + name
    run = _runner(ctx, root, work, binary)
    originals = {name: run.read(path) for name, path in tracked.items()}

    def verify_tracked():
        for name, path in tracked.items():
            require(run.read(path) == originals[name], "Tracked fixture changed: " + path)

    ctx.defer(verify_tracked)
    _check_protocols(run, originals)
    _check_policy(run, originals)
    _check_pmu(run, ctx.std.env.os())
    verify_tracked()
    ctx.std.io.stdout.write("PMU CLI acceptance: selected metric and provider verified; unavailable stays nonzero without samples, or actual positive counters retain separate clock evidence\n")
    ctx.std.io.stdout.write("Canonical protocol acceptance: protobuf 42/hash/roundtrip, strict DER/typed SET OF, real Arrow V4/V5, explicit lint deny/fix/run 42 and PMU evidence scope passed\n")

def _check(ctx):
    cwd = ctx.std.env.current_dir()
    options = {}
    pending = ""
    for value in ctx.args.tool_args:
        if pending:
            if value.startswith("--"):
                ctx.std.process.exit(2, "Missing value for " + pending)
            options[pending] = value
            pending = ""
        elif value in ["--help", "-h"]:
            ctx.std.io.stdout.write(_USAGE + "\n")
            return 0
        else:
            flag, equals, argument = value.partition("=")
            if flag not in ["--binary", "--root", "--work"]:
                ctx.std.process.exit(2, "Unknown option: " + value)
            if equals:
                options[flag] = argument
            else:
                pending = flag
    if pending or not all([options.get(flag) for flag in ["--binary", "--root", "--work"]]):
        ctx.std.process.exit(2, _USAGE)
    root, work, binary = [capture(ctx, "realpath", [root_path(cwd, options[flag])], cwd).rstrip("\r\n") for flag in ["--root", "--work", "--binary"]]
    _check_fixtures(ctx, root, work, binary)
    return 0

def _probe_status(status):
    if status == 0:
        return "PMU probe completed with actual checked positive counters; no speed threshold applied."
    if status == 2:
        return "PMU probe reported unavailable (exit 2); no hardware-success or zero-count claim."
    return None

def _suite(ctx):
    root = ctx.std.env.aspect_root_dir()
    binary = executable(ctx, root, "//:bin/vesper")
    if ctx.std.fs.exists(binary + ".exe") and ctx.std.fs.metadata(binary + ".exe").is_file:
        binary += ".exe"
    _check_fixtures(ctx, root, scratch_dir(ctx, "vesper-canonical-protocols-"), binary)
    for example in _EXAMPLES:
        run_target(ctx, root, example)
    probe = executable(ctx, root, _PROBE)
    status = exit_code(command(ctx, probe, [], root).status())
    message = _probe_status(status)
    if message == None:
        ctx.std.process.exit(status, "PMU probe failed unexpectedly (exit %d)." % status)
    ctx.std.io.stdout.write(message + "\n")
    return 0

check_canonical_protocols = task(
    kind = "check-canonical-protocols", group = ["acceptance"],
    summary = "Check codecs, policy and PMU against a supplied compiler",
    implementation = _check, args = {"tool_args": args.trailing_var_args(description = _USAGE)},
)

test_canonical_protocols = task(
    kind = "test-canonical-protocols", group = ["acceptance"],
    summary = "Exercise codecs, lint policy, PMU and their Bazel examples",
    implementation = _suite,
)

def _test(ctx):
    equal(_hex("00a0ff"), bytes([0, 160, 255]), "Fixture bytes")
    equal(_sha256(bytes("abc")), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", "Fixture checksum")
    for invalid in [None, 0, "", "-", "+1", "1.0", "1\n", "١"]:
        require(not _digits(invalid, signed = True), "Invalid decimal accepted: %r" % invalid)
    require(_digits("0") and _digits("-10", signed = True) and not _digits("-10"), "Decimal sign validation")
    equal(_decimal("18446744073709551615", "counter", positive = True), 18446744073709551615, "Exact integer conversion")
    _check_pairs([{
        "baseline_total_cycles": "10", "candidate_total_cycles": "9",
        "operations_per_arm": 16, "regression_basis_points": {"floor": "-1000", "ceil": "-1000"},
    }], "cycles", 1)
    require("positive counters" in _probe_status(0), "Measured probe receipt missing")
    require("reported unavailable" in _probe_status(2), "Unavailable probe receipt missing")
    equal(_probe_status(5), None, "Unexpected probe exit must propagate")
    work = scratch_dir(ctx, "vesper-canonical-tests-")
    run = _runner(ctx, work, work, "pwd")
    fixture = run.file("bytes with spaces", _hex("00a0ff"))
    equal(run.read(fixture), _hex("00a0ff"), "Binary fixture round trip")
    run.write(fixture, "shorter")
    equal(run.read(fixture), bytes("shorter"), "Rewrite truncates the fixture")
    equal(run.run().stdout.strip(), work, "Compiler working directory")
    return 0

test_canonical_protocol_fixtures = task(
    kind = "canonical-protocol-fixtures", group = ["ci", "tests"],
    summary = "Test canonical protocol fixture bytes and PMU evidence helpers",
    implementation = _test,
)
