"""Exercise actual Lean formatter document proofs and emitted witnesses."""

load("./lib/bazel_exec.axl", "executable")
load("./lib/process.axl", "command", "exit_code", "root_path", "scratch_dir")
load("./lib/strict-json.axl", "decode_object")

_MODEL = "lean/StylusAndLintSafety.lean"
_FIXTURES = "/tests/fixtures/format_proof/"
_MAX_OUTPUT = 4 * 1024 * 1024
_COMMENTS = "Vesper.StylusGenerated.comments_preserved"
_PROJECTION = "Vesper.StylusSafety.projection_narrowing_preserves_disjointness"
_PROOF_FLAGS = ["--format", "--json"]
_WITNESS_FLAGS = ["--format", "--emit-lean"]
_USAGE = "Pass -- --binary <vesper> [--lean <lean>] [--model <model>] [--work <directory>]."

def _require(condition, message: str):
    if not condition:
        fail(message)

def _run_process(ctx, argv, cwd, env, timeout, stdout, stderr):
    cmd = command(ctx, argv[0], argv[1:], cwd, env)
    child = cmd.process_group(0).stdout(ctx.std.fs.create(stdout)).stderr(ctx.std.fs.create(stderr)).spawn()
    status = child.try_wait(timeout_ms = timeout * 1000)
    if status == None:
        child.kill()
        child.wait()
        return None
    return exit_code(status)

def _execute(ctx: TaskContext, harness: struct, argv: list[str], *, expected: int = 0, cwd: str = "", env: dict[str, str] = {}, timeout: int = 360) -> str:
    stdout = harness.work + "/stdout"
    stderr = harness.work + "/stderr"
    actual = harness.run_process(ctx, argv, cwd or harness.root, env, timeout, stdout, stderr)
    _require(actual != None, "Timed out after %d seconds: %r" % (timeout, argv))
    for path in [stdout, stderr]:
        _require(ctx.std.fs.metadata(path).size <= _MAX_OUTPUT, "Output exceeds 4 MiB: %r" % argv)
    if actual != expected:
        for path in [stdout, stderr]:
            ctx.std.io.stderr.write(ctx.std.fs.open(path).read())
        fail("Expected exit %d, got %d: %r" % (expected, actual, argv))
    harness.counts["commands"] += 1
    return stdout

def _source(ctx: TaskContext, harness: struct, data) -> str:
    harness.counts["sources"] += 1
    path = "%s/source-%d.ves" % (harness.work, harness.counts["sources"])
    if type(data) == "string":
        ctx.std.fs.write(path, data)
    else:
        stream = ctx.std.fs.create(path)
        written = stream.write(data)
        stream.close()
        _require(written == len(data), "Short write while creating " + path)
    return path

def _verify(ctx: TaskContext, harness: struct, path: str, flags: list[str], *, expected: int = 0) -> str:
    original = ctx.std.fs.open(path).read()
    result = _execute(ctx, harness, [harness.binary, "verify", path] + flags, expected = expected)
    _require(ctx.std.fs.open(path).read() == original, "verify changed its source: " + path)
    return result

def _digest(value) -> bool:
    return type(value) == "string" and len(value) == 64 and all([char in "0123456789abcdef" for char in value.elems()])

def _checked(ctx: TaskContext, harness: struct, source, lean: str) -> tuple:
    path = _source(ctx, harness, source)
    output = _verify(ctx, harness, path, _PROOF_FLAGS + ["--lean", lean, "--timeout", "300"])
    report = decode_object(ctx.std.fs.read_to_string(output))
    _require(report["schema"] == "vesper.format-proof/1" and report["status"] == "kernel_checked" and report["scope"] == "formatter_document_model", "Unexpected format-proof schema, status or scope")
    _require(report["input_bytes"] == ctx.std.fs.metadata(path).size and report["output_bytes"] > 0 and report["document_nodes"] > 0, "Invalid proof byte or document node counts")
    _require("4.35.0" in report["lean_version"], "Unexpected Lean version in proof report")
    for field in ["source_blake3", "output_blake3"]:
        _require(_digest(report[field]), "Invalid " + field)
    audit = report["audit"]
    _require(audit["accepted"] and audit["kernel_replayed"] and not audit["cache_eligible"], "Expected an accepted, independently replayed proof without caching")
    _require(audit["forbidden_axioms"] == [], "Proof uses forbidden axioms")
    names = []
    for theorem in audit["theorems"]:
        names.append(theorem["name"])
        _require(theorem["axioms"] == [], "Theorem uses axioms: " + theorem["name"])
    _require(_COMMENTS in names and _PROJECTION in names, "Required theorems are missing")
    for field in ["world", "checked_source", "semantic_checked", "rust_renderer_verified", "program_verified"]:
        _require(field not in report, "Unexpected proof claim: " + field)
    harness.counts["kernel_reports"] += 1
    return path, report

def _rejected(ctx: TaskContext, harness: struct, data, flags: list[str]):
    path = _source(ctx, harness, data)
    output = _verify(ctx, harness, path, flags, expected = 1)
    if "--emit-lean" in flags and "--json" not in flags:
        _require(ctx.std.fs.metadata(output).size == 0, "Failed witness emission wrote output")
    else:
        report = decode_object(ctx.std.fs.read_to_string(output))
        _require(report["status"] == "rejected" and report["stage"] and report["message"], "Expected a rejection report with a stage and message")
        for field in ["audit", "source_blake3", "output_blake3", "lean_version", "document_nodes"]:
            _require(field not in report, "Unexpected proof field in rejection report: " + field)

def _replay(ctx: TaskContext, harness: struct, lean: str, model: str, witness: str):
    directory = harness.work + "/independent-kernel"
    ctx.std.fs.create_dir(directory)
    ctx.std.fs.copy(model, directory + "/StylusAndLintSafety.lean")
    ctx.std.fs.copy(witness, directory + "/Witness.lean")
    argv = ["env", "-u", "LEAN_SRC_PATH", "-u", "LEAN_PLUGIN_PATH", lean, "--trust=0"]
    env = {"LEAN_PATH": directory}
    for module in ["StylusAndLintSafety", "Witness"]:
        _execute(ctx, harness, argv + ["-o", module + ".olean", module + ".lean"], cwd = directory, env = env)
    ctx.std.fs.write(directory + "/Inspect.lean", "import Witness\n#check %s\n#print axioms %s\n#print axioms %s\n" % (_COMMENTS, _COMMENTS, _PROJECTION))
    output = _execute(ctx, harness, argv + ["Inspect.lean"], cwd = directory, env = env)
    report = ctx.std.fs.read_to_string(output)
    _require(report.count("does not depend on any axioms") == 2 and "sorryAx" not in report, "Independent witness replay did not verify two axiom-free theorems")
    ctx.std.fs.write(directory + "/NoInjection.lean", "import Witness\n#check injected\n")
    _execute(ctx, harness, argv + ["NoInjection.lean"], expected = 1, cwd = directory, env = env)

def _run(ctx: TaskContext, root: str, binary: str, launcher: str, model: str, parent: str, run_process) -> int:
    binary = root_path(root, binary)
    if ctx.std.fs.exists(binary + ".exe") and ctx.std.fs.metadata(binary + ".exe").is_file:
        binary += ".exe"
    _require(ctx.std.fs.exists(binary), "Compiler not found: " + binary)
    model = root_path(root, model)
    _require(ctx.std.fs.exists(model), "Lean model not found: " + model)
    if parent:
        parent = root_path(root, parent)
        ctx.std.fs.create_dir_all(parent)
        work = ctx.std.fs.mkdtemp(parent = parent, prefix = "vesper-format-proof-")
        ctx.defer(lambda: ctx.std.fs.remove_dir_all(work))
    else:
        work = scratch_dir(ctx, "vesper-format-proof-")
    harness = struct(root = root, work = work, binary = binary, run_process = run_process, counts = {"commands": 0, "sources": 0, "kernel_reports": 0})
    prefix = _execute(ctx, harness, [launcher, "--print-prefix"], timeout = 45)
    lean = root_path(root, ctx.std.fs.read_to_string(prefix).strip()) + "/bin/lean"
    _require(ctx.std.fs.exists(lean) and ctx.std.fs.metadata(lean).is_file, "Lean executable not found: " + lean)
    # The acceptance report excludes launcher discovery.
    harness.counts["commands"] = 0
    version = _execute(ctx, harness, [lean, "--version"])
    _require("version 4.35.0," in ctx.std.fs.read_to_string(version), "Expected Lean version 4.35.0")

    commented = ctx.std.fs.read_to_string(root + _FIXTURES + "commented.ves")
    path, first = _checked(ctx, harness, commented, lean)
    _require(first["comment_tokens"] == 3, "Expected three comment tokens")
    formatted = _source(ctx, harness, commented)
    _execute(ctx, harness, [binary, "fmt", formatted, "--json"])
    _require(first["output_bytes"] == ctx.std.fs.metadata(formatted).size, "Proof output size differs from formatter output")
    _, changed = _checked(ctx, harness, commented.replace("final 🦀", "current 🦀"), lean)
    _require(first["source_blake3"] != changed["source_blake3"] and first["output_blake3"] != changed["output_blake3"], "Changed comment must change both proof digests")
    _, macro = _checked(ctx, harness, ctx.std.fs.open(root + _FIXTURES + "macro.ves").read(), lean)
    _require(macro["comment_tokens"] == 2, "Expected two macro comment tokens")
    hostile = _source(ctx, harness, ctx.std.fs.open(root + _FIXTURES + "hostile.ves").read())
    witness = _verify(ctx, harness, hostile, _WITNESS_FLAGS + ["--lean", lean, "--timeout", "300"])
    text = ctx.std.fs.read_to_string(witness).replace("«", "").replace("»", "")
    _require("comments_preserved" in text and "Vesper.StylusGenerated" in text and not text.lstrip().startswith("{"), "Expected a Lean source witness")
    _replay(ctx, harness, lean, model, witness)

    # The source is fn main(){<0xff>}.
    malformed_utf8 = bytes([102, 110, 32, 109, 97, 105, 110, 40, 41, 123, 255, 125])
    for data in ["fn main(){let x=;", "fn main(){/* unclosed", "fn main(){unknown!{raw}}", malformed_utf8, " " * (128 * 1024 + 1)]:
        _rejected(ctx, harness, data, _PROOF_FLAGS)
        _rejected(ctx, harness, data, _WITNESS_FLAGS)
    for flags in [["--json"], _PROOF_FLAGS + ["--emit-lean"], _PROOF_FLAGS + ["--timeout", "0"], _PROOF_FLAGS + ["--timeout", "301"], _PROOF_FLAGS + ["--unknown"]]:
        _rejected(ctx, harness, commented, flags)
    missing = work + "/nonexistent-real-lean"
    _rejected(ctx, harness, commented, _PROOF_FLAGS + ["--lean", missing])
    output = _verify(ctx, harness, path, _WITNESS_FLAGS + ["--lean", missing], expected = 1)
    _require(ctx.std.fs.metadata(output).size == 0, "Failed witness emission wrote output")
    _execute(ctx, harness, [binary, "verify", work] + _PROOF_FLAGS, expected = 1)
    for entry in ctx.std.fs.read_dir(work):
        _require(not entry.path.startswith(".vesper-"), "Unexpected proof scratch file: " + entry.path)
    ctx.std.io.stdout.write(json.encode({
        "status": "passed",
        "commands": harness.counts["commands"],
        "kernel_reports": harness.counts["kernel_reports"],
        "independent_witness_replay": True,
        "scope": "formatter_document_model; no semantic or Rust-refinement proof",
    }) + "\n")
    return 0

def check_with(ctx: TaskContext, root: str, values: list[str], run_process = _run_process) -> int:
    options = {}
    pending = ""
    for value in values:
        if pending:
            if value.startswith("--"):
                ctx.std.process.exit(2, "Missing value for " + pending)
            options[pending] = value
            pending = ""
        elif value in ["-h", "--help"]:
            ctx.std.io.stdout.write(_USAGE + "\n")
            return 0
        else:
            flag, equals, argument = value.partition("=")
            if flag not in ["--binary", "--lean", "--model", "--work"]:
                ctx.std.process.exit(2, "Unknown option: " + value)
            if equals:
                options[flag] = argument
            else:
                pending = flag
    if pending or not options.get("--binary"):
        ctx.std.process.exit(2, _USAGE)
    lean = options.get("--lean", ctx.std.env.var("VESPER_LEAN") or "lean")
    model = options.get("--model", ctx.std.env.var("VESPER_FORMAT_PROOF_MODEL") or _MODEL)
    return _run(ctx, root, options["--binary"], lean, model, options.get("--work", ""), run_process)

check_format_proof = task(
    kind = "check-format-proof",
    group = ["acceptance"],
    summary = "Check actual Lean formatter proofs with the given compiler",
    implementation = lambda ctx: check_with(ctx, ctx.std.env.aspect_root_dir(), ctx.args.tool_args),
    args = {"tool_args": args.trailing_var_args(description = _USAGE)},
)

def suite_with(ctx: TaskContext, root: str, run_process = _run_process) -> int:
    binary = ctx.std.env.var("VESPER_FORMAT_PROOF_BINARY") or executable(ctx, root, "//:bin/vesper")
    lean = ctx.std.env.var("VESPER_LEAN")
    lean_path = root + "/.ci-lean-path"
    if not lean and ctx.std.fs.exists(lean_path):
        lean = ctx.std.fs.read_to_string(lean_path).rstrip("\r\n")
    return _run(ctx, root, binary, lean or "lean", ctx.std.env.var("VESPER_FORMAT_PROOF_MODEL") or _MODEL, "", run_process)

test_format_proof = task(
    kind = "test-format-proof",
    group = ["acceptance"],
    summary = "Check actual Lean formatter proofs with the workspace compiler",
    implementation = lambda ctx: suite_with(ctx, ctx.std.env.aspect_root_dir()),
)
