"""Check round trips from the finite_float_json example to an independent parser."""

load("./lib/process.axl", "command", "exit_code", "root_path", "scratch_dir")
load("./lib/strict-json.axl", "decode_object")

_EDGES = [
    0x0000000000000000, 0x8000000000000000,
    0x0000000000000001, 0x8000000000000001,
    0x000FFFFFFFFFFFFF, 0x800FFFFFFFFFFFFF,
    0x0010000000000000, 0x8010000000000000,
    0x0010000000000001, 0x8010000000000001,
    0x7FEFFFFFFFFFFFFF, 0xFFEFFFFFFFFFFFFF,
    0x7FEFFFFFFFFFFFFE, 0xFFEFFFFFFFFFFFFE,
    0x3FF0000000000000, 0xBFF0000000000000,
    0x3FEFFFFFFFFFFFFF, 0x3FF0000000000001,
    0x3CB0000000000000, 0x3FB999999999999A,
    0xBFB999999999999A, 0x4340000000000000,
    0x4340000000000001, 0xC340000000000001,
]
_MAX_RECORDS = len(_EDGES) + 4096
_MAX_OUTPUT = _MAX_RECORDS * 1024
_HEX = "0123456789abcdef"

def _corpus():
    values = list(_EDGES)
    state = 0x6A09E667F3BCC909
    for _ in range(4096):
        state = (state * 6364136223846793005 + 1442695040888963407) & ((1 << 64) - 1)
        if state & 0x7FF0000000000000 != 0x7FF0000000000000:
            values.append(state)
    return values

def _hex(bits):
    return "".join([_HEX[(bits >> shift) & 15] for shift in range(60, -1, -4)])

def _binary64(bits):
    biased = (bits >> 52) & 0x7FF
    fraction = bits & ((1 << 52) - 1)
    significand = fraction if biased == 0 else (1 << 52) + fraction
    exponent = (biased or 1) - 1075
    value = float(significand)
    # Scaling by powers of two is exact for these binary64 components. Split
    # large exponents so the scaling factors themselves remain representable.
    for _ in range(3):
        if exponent == 0:
            break
        shift = min(512, abs(exponent))
        # Start above the evaluator's signed small-integer shift range.
        factor = float((1 << 32) << shift) / 4294967296.0
        if exponent < 0:
            value /= factor
            exponent += shift
        else:
            value *= factor
            exponent -= shift
    return -value if bits >> 63 else value

def _matches(bits, token):
    # Parse the original JSON number, including integer spellings beyond u64
    # and negative zero, without an intermediate integer conversion.
    value = float(token)
    if bits & ((1 << 63) - 1) == 0:
        return value == 0.0 and token.startswith("-") == bool(bits >> 63)
    return value == _binary64(bits)

def _validate_record(line, bits):
    if len(line) > 1024:
        fail("Float record exceeds 1024 bytes")
    record = decode_object(line)
    if sorted(record) != ["bits", "value"] or record["bits"] != _hex(bits) or type(record["value"]) not in ["int", "float"]:
        fail("Unexpected float record for " + _hex(bits))
    # The decoded keys and hex string establish that only the field separator
    # can contain a literal comma. Locate the unquoted number in either order.
    fields = line.strip()[1:-1].split(",")
    values = [field.partition(":")[2].strip() for field in fields]
    token = values[0] if values[1].startswith('"') else values[1]
    if not _matches(bits, token):
        fail("JSON value does not round trip for %s: %r, expected %r" % (_hex(bits), float(token), _binary64(bits)))

def _execute(ctx: TaskContext, root: str, binary: str, work: str):
    stdout = work + "/stdout"
    stderr = work + "/stderr"
    child = command(ctx, binary, [], root).process_group(0).stdin("null").stdout(ctx.std.fs.create(stdout)).stderr(ctx.std.fs.create(stderr)).spawn()
    status = None
    for _ in range(120):
        status = child.try_wait(timeout_ms = 250)
        if ctx.std.fs.metadata(stdout).size > _MAX_OUTPUT or ctx.std.fs.metadata(stderr).size > 65536:
            if status == None:
                child.kill()
                child.wait()
            fail("Example output exceeded its finite allowance")
        if status != None:
            break
    if status == None:
        child.kill()
        child.wait()
        fail("Example exceeded its process deadline")
    if not status.success or ctx.std.fs.metadata(stderr).size:
        ctx.std.io.stderr.write(ctx.std.fs.open(stderr).read())
        fail("Expected a successful example with no stderr, got exit %d" % exit_code(status))
    return ctx.std.fs.read_to_string(stdout), ctx.std.fs.metadata(stdout).size

def _file(ctx: TaskContext, path: str) -> bool:
    return ctx.std.fs.exists(path) and ctx.std.fs.metadata(path).is_file

def _check(ctx: TaskContext) -> int:
    values = ctx.args.tool_args
    if len(values) == 2 and values[0] == "--binary":
        binary = values[1]
    elif len(values) == 1 and values[0].startswith("--binary="):
        binary = values[0].removeprefix("--binary=")
    elif values == ["--help"] or values == ["-h"]:
        ctx.std.io.stdout.write("Pass -- --binary <finite_float_json>.\n")
        return 0
    else:
        ctx.std.process.exit(2, "Expected --binary <finite_float_json>")
    root = ctx.std.env.aspect_root_dir()
    binary = root_path(root, binary)
    if not _file(ctx, binary):
        binary += ".exe"
    if not _file(ctx, binary):
        fail("Example binary not found: " + binary)
    work = scratch_dir(ctx, "vesper-float-json-")
    first, size = _execute(ctx, root, binary, work)
    second, _ = _execute(ctx, root, binary, work)
    if first != second:
        fail("Actual encoded corpus must be deterministic")
    expected = _corpus()
    lines = first.splitlines()
    if len(lines) != len(expected):
        fail("Expected %d float records, got %d" % (len(expected), len(lines)))
    for line, bits in zip(lines, expected):
        _validate_record(line, bits)
    ctx.std.io.stdout.write(json.encode({
        "status": "passed",
        "processes": 2,
        "finite_values_per_process": len(expected),
        "output_bytes_per_process": size,
        "scope": "actual finite binary64 JSON interoperability including negative zero; no throughput or proof claim",
    }) + "\n")
    return 0

check_float_json = task(
    kind = "check-float-json",
    group = ["acceptance"],
    summary = "Check the example's finite binary64 JSON output and deterministic corpus",
    implementation = _check,
    args = {"tool_args": args.trailing_var_args(description = "Pass -- --binary <finite_float_json>.")},
)

def _test(ctx: TaskContext) -> int:
    for bits, token, matches in [
        (0x0000000000000000, "0", True),
        (0x0000000000000000, "-0", False),
        (0x8000000000000000, "-0", True),
        (0x8000000000000000, "0", False),
        (0x0000000000000001, "5e-324", True),
        (0x0000000000000001, "1e-324", False),
        (0x8000000000000001, "-5e-324", True),
        (0x000FFFFFFFFFFFFF, "2.225073858507201e-308", True),
        (0x0010000000000000, "2.2250738585072014e-308", True),
        (0x0010000000000000, "2.225073858507201e-308", False),
        (0x7FEFFFFFFFFFFFFF, "1.7976931348623157e308", True),
        (0x7FEFFFFFFFFFFFFF, "1.7976931348623155e308", False),
        (0xFFEFFFFFFFFFFFFF, "-1.7976931348623157e308", True),
        (0x814C9B9193578E26, "-2.085821589009216e-302", True),
        (0x4340000000000000, "9007199254740993", True),
        (0x4340000000000001, "9007199254740993", False),
        (0x4340000000000001, "9007199254740994", True),
    ]:
        if _matches(bits, token) != matches:
            fail("Unexpected JSON round trip for " + token + " and " + _hex(bits))
    _validate_record(' { "value" : -0, "bits" : "8000000000000000" } ', 0x8000000000000000)
    _validate_record('{"bits":"3fb999999999999a","value":0.1}', 0x3FB999999999999A)
    corpus = _corpus()
    if len(corpus) != 4118 or corpus[:len(_EDGES)] != _EDGES or corpus[len(_EDGES)] != 0x139260D4258F4EE4:
        fail("Finite binary64 corpus changed")
    ctx.std.io.stdout.write("Passed binary64 edge cases, JSON parsing and corpus sampling\n")
    return 0

test_float_json = task(
    kind = "float-json",
    group = ["ci", "tests"],
    summary = "Test the finite binary64 JSON oracle",
    implementation = _test,
)
