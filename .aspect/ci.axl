load("./lib/process.axl", "check", "command", "exit_code")

def _platform_tests(ctx: TaskContext) -> int:
    root = ctx.std.env.aspect_root_dir()
    for suite in [
        "aspect-unit",
        "merge-gate",
        "hardware-ci",
        "workflow-tasks",
        "platform-completion",
        "release-validation",
        "format-proof",
        "float-json",
        "ndjson-columns",
        "doc-navigation",
        "diagnostics",
        "rewrite-witness",
        "doc-links",
        "source-tooling",
        "source-macro-fixtures",
        "stylus-fixtures",
        "editor-fixtures",
        "recovery-fixtures",
        "canonical-protocol-fixtures",
        "arrow-fixtures",
        "tensor-interop-fixtures",
        "tensor-reference-fixtures",
        "generated-assets",
        "native-cli",
        "platform-plan-integration",
        "cargo-metadata",
        "bazel-cli",
        "tls-fixtures",
        "wasm-fixture-build",
        "crmath-reference",
        "rust-test-conversion",
        "rust-census",
        "flip-gate",
        "profile-runner",
        "workflows",
        "automation-policy",
        "logos-sweep",
        "logos-sweep-summary",
        "logos-pins",
        "logos-setup",
        "lean-toolchains",
        "lean-workflow",
        "disk-ci",
        "port-abi-parity",
        "port-regression",
        "stage2-wasmtime",
        "bootstrap-seeds",
        "simd-fixture",
    ]:
        check(ctx, ctx.std.env.current_exe(), ["ci", "tests", suite], root)
    return 0

platform_tests = task(
    kind = "platform-tests",
    group = ["ci"],
    summary = "Run the platform planning, policy and workflow tests",
    implementation = _platform_tests,
)

tests_aspect_tasks = platform_tests.alias(
    kind = "aspect-tasks",
    group = ["ci", "tests"],
    summary = "Run the native Aspect regression suite",
)

def _pulse(ctx: TaskContext) -> int:
    root = ctx.std.env.aspect_root_dir()
    argv = ["test", "--locked", "--test", "pulse_port"] + ctx.args.tool_args
    return exit_code(command(ctx, "cargo", argv, root).status())

pulse_port_tests = task(
    kind = "test-pulse-port", group = ["ci"],
    summary = "Run the @vesper/pulse port differentials against vesper_pulse",
    implementation = _pulse,
    args = {"tool_args": args.trailing_var_args(description = "Additional Cargo test arguments.")},
)
