load("./lib/process.axl", "check")
load("./lib/script.axl", "command_task", "run_command", "script_task")


tests_aspect_tasks = script_task("aspect-tasks", ["ci", "tests"], "scripts/ci/tests/test_platform_aspect_tasks.py", "python3")

def _platform_tests(ctx: TaskContext) -> int:
    root = ctx.std.env.aspect_root_dir()
    for suite in [
        "merge-gate",
        "hardware-ci",
        "workflow-tasks",
        "platform-completion",
        "release-validation",
        "format-proof",
        "float-json",
        "ndjson-columns",
        "doc-navigation",
        "diagnostics",
        "rewrite-witness",
        "doc-links",
        "source-tooling",
        "source-macro-fixtures",
        "stylus-fixtures",
        "editor-fixtures",
        "recovery-fixtures",
        "canonical-protocol-fixtures",
        "rust-census",
        "flip-gate",
        "profile-runner",
        "workflows",
        "logos-sweep",
        "logos-sweep-summary",
        "logos-pins",
        "logos-setup",
    ]:
        check(ctx, ctx.std.env.current_exe(), ["ci", "tests", suite], root)
    return run_command(ctx, "python3", ["-m", "unittest", "discover", "-s", "scripts/ci/tests", "-p", "test_platform*.py"], True, "")

platform_tests = task(
    kind = "platform-tests",
    group = ["ci"],
    summary = "Run the platform planning, policy and workflow tests",
    implementation = _platform_tests,
    args = {"tool_args": args.trailing_var_args(description = "Optional unittest flags for the platform tests.")},
)

def _historical_platform_tests(ctx):
    root = ctx.std.env.var("PLATFORM_WORKSPACE")
    if not root or root == ctx.std.env.aspect_root_dir():
        ctx.std.process.exit(2, "Set PLATFORM_WORKSPACE to the historical checkout")
    check(ctx, "python3", ["-m", "pip", "install", "PyYAML==6.0.2"], root)
    if ctx.std.fs.exists(root + "/.aspect/version.axl"):
        check(ctx, ctx.std.env.current_exe(), ["ci", "platform-tests"], root)
    else:
        check(ctx, "python3", ["-m", "unittest", "discover", "-s", "scripts/ci/tests", "-p", "test_platform*.py"], root)
    return 0

historical_platform_tests = task(
    kind = "test-historical-platform-regressions",
    group = ["ci"],
    summary = "Run the regression suite shipped with an older release checkout",
    implementation = _historical_platform_tests,
)

pulse_port_tests = command_task(
    "test-pulse-port",
    ["ci"],
    "Run the @vesper/pulse port differentials against vesper_pulse",
    "cargo",
    ["test", "--locked", "--test", "pulse_port"],
)
