load("./lib/script.axl", "command_task", "script_task")

flip_gate = script_task("flip-gate", ["ci"], "scripts/ci/flip_gate.py", "python3")
lean_replay_scope = script_task("lean-replay-scope", ["ci"], "scripts/ci/lean_replay_scope.py", "python3")
merge_gate = script_task("merge-gate", ["ci"], "scripts/ci/merge_gate.py", "python3")
platform_test_plan = script_task("platform-test-plan", ["ci"], "scripts/ci/platform_test_plan.py", "python3")
port_harness_selection = script_task("port-harness-selection", ["ci"], "scripts/ci/port_harness_selection.py", "python3")
reclaim_disk = script_task("reclaim-disk", ["ci"], "scripts/ci/reclaim-disk.sh", "bash")
test_platform_profile = script_task("test-platform-profile", ["ci"], "scripts/ci/test-platform-profile.py", "python3")

tests_aspect_tasks = script_task("aspect-tasks", ["ci", "tests"], "scripts/ci/tests/test_platform_aspect_tasks.py", "python3")
tests_flip_gate = script_task("flip-gate", ["ci", "tests"], "scripts/ci/tests/test_platform_flip_gate.py", "python3")
tests_lean_replay_scope = script_task("lean-replay-scope", ["ci", "tests"], "scripts/ci/tests/test_platform_lean_replay_scope.py", "python3")
tests_merge_gate = script_task("merge-gate", ["ci", "tests"], "scripts/ci/tests/test_platform_merge_gate.py", "python3")
tests_port_selection = script_task("port-selection", ["ci", "tests"], "scripts/ci/tests/test_platform_port_selection.py", "python3")
tests_profile_runner = script_task("profile-runner", ["ci", "tests"], "scripts/ci/tests/test_platform_profile_runner.py", "python3")
tests_test_plan = script_task("test-plan", ["ci", "tests"], "scripts/ci/tests/test_platform_test_plan.py", "python3")
tests_workflows = script_task("workflows", ["ci", "tests"], "scripts/ci/tests/test_platform_workflows.py", "python3")

platform_tests = command_task(
    "platform-tests",
    ["ci"],
    "Run the platform planning, policy and workflow tests",
    "python3",
    ["-m", "unittest", "discover", "-s", "scripts/ci/tests", "-p", "test_platform*.py"],
)
