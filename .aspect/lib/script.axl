"""Run repository tooling with the caller's environment and standard streams."""

def run_command(
        ctx,
        interpreter: str,
        argv: list[str],
        from_root: bool,
        script_path: str) -> int:
    root = ctx.std.env.aspect_root_dir()
    script = [root + "/" + script_path] if script_path else []
    command = ctx.std.process.command(interpreter)
    command.args(argv + script + ctx.args.tool_args)
    if from_root:
        command.current_dir(root)
    status = command.status()
    return status.code if status.code != None else 128 + (status.signal or 0)

def _command_task(
        name: str,
        group: list[str],
        summary: str,
        interpreter: str,
        argv: list[str],
        from_root: bool,
        script_path: str = ""):
    def _run(ctx: TaskContext) -> int:
        return run_command(ctx, interpreter, argv, from_root, script_path)

    return task(
        kind = name,
        group = group,
        summary = summary,
        implementation = _run,
        args = {
            "tool_args": args.trailing_var_args(
                description = "Arguments passed to the tool. Put -- before tool flags.",
            ),
        },
    )

def command_task(
        name: str,
        group: list[str],
        summary: str,
        interpreter: str,
        argv: list[str]):
    return _command_task(name, group, summary, interpreter, argv, from_root = True)

def script_task(
        name: str,
        group: list[str],
        path: str,
        interpreter: str,
        from_root: bool = False):
    return _command_task(name, group, "Run " + path, interpreter, [], from_root, script_path = path)
