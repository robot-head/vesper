// The option prelude (src/option_methods.rs): `Option`'s methods.
impl [T: mod copy] Option[T] {
    fn is_some(self) -> bool {
        match self {
            Option::Some(_) => true,
            Option::None => false,
        }
    }
    fn is_none(self) -> bool {
        match self {
            Option::Some(_) => false,
            Option::None => true,
        }
    }
    fn unwrap_or(self, fallback: T) -> T {
        match self {
            Option::Some(x) => x,
            Option::None => fallback,
        }
    }
    fn or(self, other: Option[T]) -> Option[T] {
        match self {
            Option::Some(x) => Option::Some(x),
            Option::None => other,
        }
    }
}
