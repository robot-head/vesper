load("//tools/bazel:defs.bzl", "vesper_crate")

exports_files([
    "Cargo.lock",
    "Cargo.toml",
])

# The root package also owns docs/, examples/, lean/, scripts/ and tools/
# (directories without their own BUILD.bazel), which the CLI and its tests read.
vesper_crate(
    extra_compile_data = ["//crates/vesper-doc:files"],
    extra_test_data = [
        "//crates/vesper-doc:files",
        "//crates/vesper-grammar:files",
        "//crates/vesper-loom-trust:files",
    ],
    # Six tests run serially, each kernel-replaying Lean's Std (one re-checks
    # the whole Lean package). On macOS runners they finish one by one but
    # take more than 900 s in total, so the target gets the 3600 s ceiling.
    test_timeouts = {"test/proof_audit_cli": "eternal"},
)
# Narrow slices of the root package for members that read them.
filegroup(
    name = "examples",
    srcs = glob(["examples/**"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "lean",
    srcs = glob(["lean/**"]),
    visibility = ["//visibility:public"],
)
