load("//tools/bazel:defs.bzl", "vesper_crate")

exports_files([
    "Cargo.lock",
    "Cargo.toml",
])

# The root package also owns docs/, examples/, lean/, scripts/ and tools/
# (directories without their own BUILD.bazel), which the CLI and its tests read.
vesper_crate(
    extra_compile_data = ["//crates/vesper-doc:files"],
    extra_test_data = [
        "//crates/vesper-doc:files",
        "//crates/vesper-grammar:files",
        "//crates/vesper-loom-trust:files",
    ],
    # Six tests run serially, each kernel-replaying Lean's Std; on macOS
    # runners the target needs well over 15 minutes, so it runs on Linux
    # (BuildBuddy) only.
    test_target_compatible_with = {
        "test/proof_audit_cli": select({
            "@platforms//os:macos": ["@platforms//:incompatible"],
            "//conditions:default": [],
        }),
    },
    # Actual formatter witnesses replay Lean serially; keep every case enabled
    # while allowing the complete target 900 seconds on slower macOS runners.
    test_timeouts = {
        "test/format_proof_cli": "long",
    },
)
# Narrow slices of the root package for members that read them.
filegroup(
    name = "examples",
    srcs = glob(["examples/**"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "lean",
    srcs = glob(["lean/**"]),
    visibility = ["//visibility:public"],
)
