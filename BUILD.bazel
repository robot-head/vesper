# Fixed logical replays read only their sources, provenance, snapshot tool and
# negative-control fixtures. Documentation changes must not replay all packets.
filegroup(
    name = "proof_packet_data",
    srcs = glob([
        "lean/**",
        "tools/lean4lean-foundations42/**",
        "tools/lean4lean42/source-manifest.json",
        "tools/lean4lean42/patches/kernel.patch",
        "tools/resource-model42/**",
    ]),
)

# Narrow slices of the root package for members that read them.
# @vesper-std/sort (#1096) as a path dependency of port packages
# (packages/ has no BUILD.bazel of its own).
vesper_package(
    name = "std_sort_package",
    srcs = glob(["packages/vesper-std/sort/src/**/*.ves"]),
    manifest = "packages/vesper-std/sort/Loom.toml",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "examples",
    srcs = glob(["examples/**"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "lean",
    srcs = glob(["lean/**"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "website",
    srcs = glob(["website/**"]),
    visibility = ["//visibility:public"],
)

