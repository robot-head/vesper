    # the library compilation used by every crate and integration test.
    binary_compile_data = [
        "lean/**",
        "tools/logos42/**",
        "tools/resource-model42/KernelSnapshot.lean",
        "docs/rfcs/resource-model42-source-manifest.json",
    ],
    # Only files embedded by library/binary sources, including cfg(test) code.
    # Runtime docs, website pages and proof packets must not rebuild the compiler.
    compile_data = [
        "assets/fonts/**",
        "examples/*.ves",
        "src/**/*.ves",
        "tests/fixtures/source_macros/keep.ves",
        "lean/StylusAndLintSafety.lean",
        "lean/RewriteWitness.lean",
        "tools/proof-audit/Audit.lean",
    ],
    copy_test_cwd = [
        "test/lean4lean_foundations42",
        "test/lean4lean_construction42",
        "test/lean4lean_order42",
        "test/lean4lean_map42",
        "test/lean4lean_normalize42",
        "test/lean4lean_normalization42",
        "test/lean4lean_comparison42",
        "test/lean4lean_shape42",
        "test/lean4lean_addability42",
        "test/lean4lean_completion42",
        "test/lean4lean_reconstruction42",
        "test/lean4lean_normalized_completion42",
