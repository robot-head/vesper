load("//tools/bazel:defs.bzl", "vesper_crate")

exports_files([
    "Cargo.lock",
    "Cargo.toml",
])

# The root package also owns docs/, examples/, lean/, scripts/ and tools/
# (directories without their own BUILD.bazel), which the CLI and its tests read.
vesper_crate(
    copy_test_cwd = [
        "test/lean4lean_foundations42",
        "test/lean4lean_construction42",
        "test/lean4lean_order42",
        "test/lean4lean_map42",
        "test/lean4lean_normalize42",
        "test/lean4lean_normalization42",
        "test/lean4lean_comparison42",
        "test/resource_oracle42",
    ],
    extra_compile_data = ["//crates/vesper-doc:files"],
    extra_test_data = [
        "//crates/vesper-doc:files",
        "//crates/vesper-grammar:files",
        "//crates/vesper-loom-trust:files",
    ],
    # One Lean -M4096 stage plus estimated wrapper/runtime overhead; see #537.
    test_tags = {
        # Lean 4.35 full-library audits allow 8 GiB, plus wrapper overhead.
        "test/lean4lean_foundations42": ["resources:memory:9216", "resources:cpu:1"],
        "test/lean4lean_construction42": ["resources:memory:9216", "resources:cpu:1"],
        "test/lean4lean_order42": ["resources:memory:9216", "resources:cpu:1"],
        "test/lean4lean_map42": ["resources:memory:9216", "resources:cpu:1"],
        "test/lean4lean_normalize42": ["resources:memory:9216", "resources:cpu:1"],
        "test/lean4lean_normalization42": ["resources:memory:9216", "resources:cpu:1"],
        "test/lean4lean_comparison42": ["resources:memory:9216", "resources:cpu:1"],
        "test/logos42_acceptance": ["resources:memory:9216", "resources:cpu:1"],
        # Serial Lean -j1/-M4096 stages plus estimated wrapper overhead (#615).
        "test/resource_oracle42": ["resources:memory:5120", "resources:cpu:1"],
        # Four actual corpus workers; memory is an estimate, not an RSS cap.
        "test/self_host_front_end": ["resources:memory:5120", "resources:cpu:4"],
    },
    # Long, platform-neutral Lean replays run on Linux (BuildBuddy) only; see
    # "Linux-only suites" in docs/ci-platforms.md.
    test_target_compatible_with = {
        # Fresh Logos replay of all three complete model import closures.
        # Keep the external native-checker setup on the Linux lane.
        "test/logos42_acceptance": select({
            "@platforms//os:macos": ["@platforms//:incompatible"],
            "//conditions:default": [],
        }),
        # Six tests run serially, each kernel-replaying Lean's Std; on macOS
        # runners the target needs well over 15 minutes.
        "test/proof_audit_cli": select({
            "@platforms//os:macos": ["@platforms//:incompatible"],
            "//conditions:default": [],
        }),
        # Serial Lean kernel replays, 135-390 s each on macOS. They keep
        # running on Windows (Cargo), which exercises their cfg(windows)
        # process and executable-path code; macOS shares Linux's Unix paths.
        "test/format_proof_cli": select({
            "@platforms//os:macos": ["@platforms//:incompatible"],
            "//conditions:default": [],
        }),
        "test/oracle42_acceptance": select({
            "@platforms//os:macos": ["@platforms//:incompatible"],
            "//conditions:default": [],
        }),
        "test/replay42_kernel": select({
            "@platforms//os:macos": ["@platforms//:incompatible"],
            "//conditions:default": [],
        }),
        # Full logical-model replay exceeds 300 s on the Linux executor.
        # Linux and Windows retain every semantic/audit/control assertion;
        # proof_audit_private still exercises portability on macOS too.
        "test/resource_model42": select({
            "@platforms//os:macos": ["@platforms//:incompatible"],
            "//conditions:default": [],
        }),
        # The complete fixed foundation replay timed out after 300.3 s on
        # macOS. Linux and Windows keep the full audit and negative controls;
        # proof_audit_private keeps macOS process/path coverage.
        "test/lean4lean_foundations42": select({
            "@platforms//os:macos": ["@platforms//:incompatible"],
            "//conditions:default": [],
        }),
        # Same fixed logical replay and complete controls; see #443.
        "test/lean4lean_construction42": select({
            "@platforms//os:macos": ["@platforms//:incompatible"],
            "//conditions:default": [],
        }),
        # Same fixed logical replay and complete controls; see #443.
        "test/lean4lean_order42": select({
            "@platforms//os:macos": ["@platforms//:incompatible"],
            "//conditions:default": [],
        }),
        # Same fixed logical replay and complete controls; see #443.
        "test/lean4lean_map42": select({
            "@platforms//os:macos": ["@platforms//:incompatible"],
            "//conditions:default": [],
        }),
        # Same fixed logical replay and complete controls; see #443.
        "test/lean4lean_normalize42": select({
            "@platforms//os:macos": ["@platforms//:incompatible"],
            "//conditions:default": [],
        }),
        # Same fixed logical replay and complete controls; see #443.
        "test/lean4lean_normalization42": select({
            "@platforms//os:macos": ["@platforms//:incompatible"],
            "//conditions:default": [],
        }),
        # Same fixed logical replay and complete controls; see #443.
        "test/lean4lean_comparison42": select({
            "@platforms//os:macos": ["@platforms//:incompatible"],
            "//conditions:default": [],
        }),
    },
    # Actual formatter witnesses replay Lean serially; keep every case enabled
    # while allowing the complete target 900 seconds on slower macOS runners.
    test_timeouts = {
        "test/format_proof_cli": "long",
        # Fresh replay covers both complete model import closures.
        "test/logos42_acceptance": "eternal",
        "test/oracle42_acceptance": "long",
        "test/replay42_kernel": "long",
        # Fresh model compilation, 285 theorem roots and actual negative controls.
        "test/resource_model42": "long",
        # Runs the Vesper-source front end on every repository source; about
        # 2.5 min on a 4-core Linux host, over 300 s on the macOS runner.
        "test/self_host_front_end": "long",
    },
)
# Narrow slices of the root package for members that read them.
filegroup(
    name = "examples",
    srcs = glob(["examples/**"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "lean",
    srcs = glob(["lean/**"]),
    visibility = ["//visibility:public"],
)
