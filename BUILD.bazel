        "//crates/vesper-doc:files",
        # tests/native_export_v2.rs embeds the port pilot's Vesper sources.
        "//crates/vesper-port-pilot:files",
    ],
    extra_test_data = [
        "//crates/vesper-doc:files",
        "//crates/vesper-grammar:files",
        "//crates/vesper-loom-trust:files",
        # The self-hosted parser compares every repository .ves source.
