        "test/std_env": [":files"],
        "test/std_fs": [":files"],
        "test/std_process": [":files"],
        # Milestone 7: the verified backend over the self-hosted front end.
        "test/verified_codegen_fail_front_end": glob(["packages/**/*.ves"]),
        "test/self_host_front_end": glob([
            "packages/**/*.ves",
            "examples/**/*.ves",
            "src/**/*.ves",
            "tests/fixtures/**/*.ves",
