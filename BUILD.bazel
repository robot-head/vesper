    test_path_binaries = {"test/self_host_front_end": []},
    # The corpus implements TEST_TOTAL_SHARDS/TEST_SHARD_INDEX itself.
    test_shards = {"test/self_host_front_end": 4},
    # Reservations include subprocess overhead; they do not enforce RSS limits.
    # `lean_replay` marks the Lean/Logos replay suite. PR runs of "Test all
