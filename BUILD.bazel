        "test/self_host_front_v2": glob([
            "**/*.ves",
            "packages/vesper-front/**",
            "tests/self_host_parse.rs",
            "tests/self_host_front_end.rs",
        ]) + ["//crates/vesper-syntax:files"],
        # @vesper-std/fs, process and env (#1125): drivers over the packages
