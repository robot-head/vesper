    name = "proof_packet_data",
    srcs = glob([
        "lean/**",
        "tools/lean4lean-foundations42/**",
        "tools/lean4lean42/source-manifest.json",
        "tools/lean4lean42/patches/kernel.patch",
        "tools/resource-model42/**",
    ]),
)

# Narrow slices of the root package for members that read them.
# @vesper-std/sort (#1096) as a path dependency of port packages
# (packages/ has no BUILD.bazel of its own).
vesper_package(
    name = "std_sort_package",
    srcs = glob(["packages/vesper-std/sort/src/**/*.ves"]),
    manifest = "packages/vesper-std/sort/Loom.toml",
    visibility = ["//visibility:public"],
)

# The front end v2 and @vesper-std/hash(-sys) as dependencies of the fmt and
# highlight ports (self-hosting SH1 lane 11, #1154).
vesper_package(
    name = "front_package",
    srcs = glob(["packages/vesper-front/src/**/*.ves"]),
    manifest = "packages/vesper-front/Loom.toml",
    visibility = ["//visibility:public"],
)

vesper_package(
    name = "std_hash_package",
    srcs = glob(["packages/vesper-std/hash/src/**/*.ves"]),
    manifest = "packages/vesper-std/hash/Loom.toml",
    visibility = ["//visibility:public"],
)

# The AST and @vesper-std/arena and intern as dependencies of the lint port
# (self-hosting SH1 lane 13, #1156) and of the hybrid compiler's parse module
# (lane 12, #1155).
vesper_package(
    name = "std_arena_package",
    srcs = glob(["packages/vesper-std/arena/src/**/*.ves"]),
    manifest = "packages/vesper-std/arena/Loom.toml",
    visibility = ["//visibility:public"],
)

vesper_package(
    name = "std_intern_package",
