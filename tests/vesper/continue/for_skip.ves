fn main() -> i64 {
    let mut s = 0;
    for i in 0..30 {
        if i % 3 == 0 {
            continue;
        }
        s = wrapping_add(s, i);
    }
    s
}

test {
    @test fn for_skip() -> bool {
        main() == 300
    }
