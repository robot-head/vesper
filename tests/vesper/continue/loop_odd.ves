// Converted from tests/continue.rs (`continue_in_loop_and_for`) by scripts/convert-rust-tests.py.
// Run with `vesper test --engines all` (tests/vesper/README.md).

fn main() -> i64 {
    let mut i = 0;
    let mut s = 0;
    loop {
        i = wrapping_add(i, 1);
        if i >= 20 {
            break;
        }
        if i % 2 == 0 {
            continue;
        }
        s = wrapping_add(s, i);
    }
    s
}

test {
    @test fn loop_odd() -> bool {
        main() == 100
    }
}
