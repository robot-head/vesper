// Run with `vesper test --engines all` (tests/vesper/README.md).

fn main() -> u64 {
    let mut total: u64 = 0;
    for i in 0..50 {
        let mut s: ChunkSeq[u64] = ChunkSeq::new();
        s.push(wrapping_u64(i));
        s.push(2);
        if i % 2 == 0 {
            continue;
        }
        total = wrapping_add(total, s.len());
    }
    total
}

test {
    @test fn drops() -> bool {
        main() == 50
    }
}
