// Converted from tests/continue.rs (`continue_follows_the_mode_rules`) by scripts/convert-rust-tests.py.
// Run with `vesper test --engines all` (tests/vesper/README.md).

linear struct Token {
    n: i64
}
fn eat(sink t: Token) -> i64 {
    let Token {
        n
    }
    = t;
    n
}

test {
    @test(expect_error = E0312, message = "moved in a previous iteration") fn main() -> i64 {
        let t = Token {
            n: 1
        };
        let mut i = 0;
        loop {
            i = wrapping_add(i, 1);
            if i < 3 {
                let _ = eat(t);
                continue;
            }
            break 0;
        }
    }
}
