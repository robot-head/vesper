// Run with `vesper test --engines all` (tests/vesper/README.md).

fn main() -> i64 {
    let mut n = 0;
    for i in 7..=7 {
        n = wrapping_add(n, i);
        continue;
    }
    n
}

test {
    @test fn closed_single() -> bool {
        main() == 7
    }
}
