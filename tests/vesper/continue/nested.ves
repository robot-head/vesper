// Converted from tests/continue.rs (`continue_targets_the_innermost_loop`) by scripts/convert-rust-tests.py.
// Run with `vesper test --engines all` (tests/vesper/README.md).

fn main() -> i64 {
    let mut s = 0;
    for i in 0..5 {
        let mut j = 0;
        loop {
            j = wrapping_add(j, 1);
            if j > 4 {
                break;
            }
            if j == i {
                continue;
            }
            s = wrapping_add(s, 1);
        }
        if i == 2 {
            continue;
        }
        s = wrapping_add(s, 100);
    }
    s
}

test {
    @test fn nested() -> bool {
        main() == 416
    }
}
