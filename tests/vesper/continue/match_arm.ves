fn main() -> i64 {
    let mut s = 0;
    for i in 0..10 {
        let w = match i % 4 {
            0 => continue,
            1 => 10,
            _ => 1
        };
        if i == 9 {
            continue
        }
        s = wrapping_add(s, w);
    }
    s
}

test {
    @test fn match_arm() -> bool {
        main() == 24
    }
}
