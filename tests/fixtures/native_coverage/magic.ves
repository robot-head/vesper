// Lane 23 native coverage fixtures for `vesper fuzz --native-coverage`.

// Overflows only for one 64-bit key that is not a literal of the module, so
// neither random inputs nor source-literal hints reach it: the comparison
// operand logged by the instrumented `icmp` hands it to Crucible's solver.
fn unlock(key: u64, len: u32) -> u32 eff [Fail[ArithOverflow]] {
    let magic: u64 = 4660 * 4660 + 77;
    if key == magic {
        len * 65536
    } else {
        len / 2
    }
}

// A signed magic value behind two guards.
fn gate(x: i64, y: i64) -> i64 eff [Fail[ArithOverflow]] {
    let wanted = 0 - 9000 * 9000 - 3;
    if x == wanted {
        if y > 1000000 {
            y * y * y * y
        } else {
            y
        }
    } else {
        x / 2
    }
}

fn main() -> i64 {
    7
}
