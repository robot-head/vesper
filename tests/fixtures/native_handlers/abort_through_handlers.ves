// An overflow deep inside nested handlers aborts to the outer Fail handler;
// the inner handler's parked body is cancelled, not resumed.
linear effect Ask {
    fn ask() -> i64;
}

fn grow(sink n: i64) -> i64 eff [Fail[ArithOverflow], Ask] {
    if n == 0 {
        Ask::ask()
    } else {
        grow(n - 1) * 1000
    }
}

fn main() -> i64 {
    handle Fail[ArithOverflow] in {
        handle Ask in {
            grow(10)
        } with {
            return value => value,
            ask(resume) => resume(7) + 1,
        }
    } with {
        return value => value,
        raise(overflow, resume) => -1,
    }
}
