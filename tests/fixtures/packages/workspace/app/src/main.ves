// Root module of @demo/app: imports a dependency and a sibling file.
use @demo/geometry::{
    Point,
    point,
    manhattan,
    coordinate_sum
};
use @demo/geometry::shapes::area::{
    Shape,
    area as shape_area,
    checked_side
};
use @demo/geometry::counting::count_twice;
use self::report::total;

fn scale() -> i64 {
    3
}

fn origin() -> Point {
    point(0, 0)
}

fn main() -> i64 {
    let d = manhattan(point(1, 2), point(4, -2));
    let a = wrapping_add(shape_area(Shape::Square(scale())), shape_area(Rect(2, 5)));
    let checked = handle Fail[RuntimeError] in {
        shape_area(checked_side(wrapping_sub(0, 1)))
    } with {
        return value => value,
        raise(error, _) => 7,
    };
    let sums = wrapping_add(coordinate_sum(point(20, 30)), coordinate_sum(origin()));
    let counted = count_twice();
    wrapping_add(wrapping_add(wrapping_add(total(d, a), sums), checked), counted)
}
