//! Café 🦀 links to [Tx], [close], [Tx::commit], [Ask], [Ask::ask] and [Score].
/// Repeated [Tx] and [`Tx::commit`] preserve their original byte spans.
linear struct Tx {
    id: u64
}
impl Tx {
    /// Commit consumes a [Tx].
    fn commit(sink self) -> u64 {
        let Tx {
            id
        }
        = self;
        id
    }
}
linear effect Ask {
    fn ask() -> i64;
}
trait Score {
    fn score(in self) -> i64;
}
fn close(sink tx: Tx) -> u64 {
    tx.commit()
}
fn main() -> i64 {
    42
}
