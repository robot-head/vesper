fn main()
    -> (
        (u8, u8),
        (u16, u16),
        (u32, u32),
        (u64, u64),
        (usize, usize),
        (i8, i8),
        (i16, i16),
        (i32, i32),
        (i64, i64),
        (isize, isize)
    ) {
    (
        try_u8(100, 27),
        try_u16(60000, 5001),
        try_u32(2000000000, 77),
        try_u64(18446744073709551000, 9),
        try_usize(9223372036854775807, 1),
        try_i8(-60, 7),
        try_i16(-32000, -700),
        try_i32(-1073741000, -99),
        try_i64(-9223372036854775000, 12345),
        try_isize(4611686018427387903, -2),
    )
}
