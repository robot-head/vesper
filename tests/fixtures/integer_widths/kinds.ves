// Every integer kind's checked arithmetic, comparisons and negation, as one
// program that the evaluator, the JIT and Lean extraction agree on.

fn mix_u8(a: u8, b: u8) -> u8 eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    let q: u8 = a / b;
    let r: u8 = a % b;
    if q < r {
        r - q + 0
    } else {
        q - r + 0
    }
}

fn grow_u8(a: u8) -> u8 eff [Fail[ArithOverflow]] {
    a * 2
}

fn try_u8(a: u8, b: u8) -> (u8, u8) {
    handle Fail[RuntimeError] in {
        handle Fail[ArithOverflow] in {
            (mix_u8(a, b), grow_u8(a))
        } with {
            return v => v,
            raise(e, k) => {
                let code: u8 = 1;
                let zero: u8 = 0;
                (code, zero)
            }
        }
    } with {
        return v => v,
        raise(e, k) => {
            let code: u8 = 2;
            let zero: u8 = 0;
            (code, zero)
        }
    }
}

