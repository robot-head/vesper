fn mix_i8(a: i8, b: i8) -> i8 eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    let q: i8 = a / b;
    let r: i8 = a % b;
    let n: i8 = -(b % 5);
    if q < r {
        r - q + n
    } else {
        q - r + n
    }
}

fn grow_i8(a: i8) -> i8 eff [Fail[ArithOverflow]] {
    a * 2
}

fn try_i8(a: i8, b: i8) -> (i8, i8) {
    handle Fail[RuntimeError] in {
        handle Fail[ArithOverflow] in {
            (mix_i8(a, b), grow_i8(a))
        } with {
            return v => v,
            raise(e, k) => {
                let code: i8 = 1;
                let zero: i8 = 0;
                (code, zero)
            }
        }
    } with {
        return v => v,
        raise(e, k) => {
            let code: i8 = 2;
            let zero: i8 = 0;
            (code, zero)
        }
    }
}

