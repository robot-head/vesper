// Enums with payloads, generic enums after substitution, and match.
copy enum Shape {
    Empty,
    Square(i64),
    Rect(i64, i64),
    Labeled {
        id: u8,
        wide: bool,
        side: i64
    }
}

copy struct Pair {
    a: i64,
    b: i64
}

fn area(in s: Shape) -> i64 eff [Fail[ArithOverflow]] {
    match s {
        Shape::Empty => 0,
        Shape::Square(n) => n * n,
        Shape::Rect(w, h) => w * h,
        Shape::Labeled {
            id: _,
            wide: true,
            side
        } => side * 2,
        Shape::Labeled {
            id: 4,
            wide: false,
            side
        } => side + 4,
        Shape::Labeled {
            id: _,
            wide: false,
            side
        } => side,
    }
}

fn pick(n: i64) -> Shape {
    if n == 0 {
        Shape::Empty
    } else if n == 1 {
        Shape::Square(7)
    } else if n == 2 {
        Shape::Rect(3, 5)
    } else if n == 3 {
        Shape::Labeled {
            id: 9,
            wide: true,
            side: 11
        }
    } else {
        Shape::Labeled {
            id: 4,
            wide: false,
            side: 20
        }
    }
}

fn first(o: Option[Pair]) -> i64 {
    match o {
        Some(
            Pair {
                a,
                b: 0
            }
        ) => a,
        Some(
            Pair {
                a: _,
                b
            }
        ) => b,
        None => -1,
    }
}

fn total(n: i64, acc: i64) -> i64 eff [Fail[ArithOverflow]] {
    if n < 0 {
        acc
    } else {
        total(n - 1, acc + area(in pick(n)))
    }
}

fn main() -> (i64, i64, i64, i64, Option[u32], Shape) eff [Fail[ArithOverflow]] {
    let none: Option[Pair] = None;
    let small: Option[u32] = Some(42);
    (
        total(4, 0),
        first(
            Some(
                Pair {
                    a: 5,
                    b: 0
                }
            )
        ),
        first(
            Some(
                Pair {
                    a: 5,
                    b: 6
                }
            )
        ),
        first(none),
        small,
        pick(2)
    )
}
