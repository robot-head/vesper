// A generic ConstTime function is checked by the backend verifier at each
// emitted instance, with that instance's concrete parameter layouts (wave
// seven, lane 23; wave six rejected it as capability.generic-unsupported).
copy struct Secret[T] {
    value: T,
}

fn ct_id[T](sink s: Secret[T]) -> Secret[T] eff [ConstTime] {
    s
}

fn declassify_u64(s: Secret[u64]) -> u64 eff [ConstTime] {
    let Secret {
        value
    }
    = ct_id(s);
    value
}

fn main() -> u64 {
    let s: Secret[u64] = Secret {
        value: 4
    };
    declassify_u64(s)
}
