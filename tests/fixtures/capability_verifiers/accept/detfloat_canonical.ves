// A DetFloat kernel whose results escape through a store and a return. The
// backend compiles DetFloat programs with NaN canonicalisation, so Kinetic's
// auditor accepts the escaping float arithmetic on both ISAs.
copy struct Sample {
    left: f64,
    right: f64,
}

fn mix(in s: Sample, gain: f64) -> Sample eff [DetFloat] {
    Sample {
        left: s.left * gain + s.right * (1.0 - gain),
        right: s.right * gain - s.left / 2.0
    }
}

fn energy(in s: Sample) -> f64 eff [DetFloat] {
    s.left * s.left + s.right * s.right
}

fn main() -> f64 {
    let s = mix(
        in Sample {
            left: 0.5,
            right: 0.25
        },
        0.75
    );
    energy(in s)
}
