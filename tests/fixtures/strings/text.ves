// UTF-8 strings on every backend: byte access, char decoding, building,
// views, comparison and validation over ASCII and multi-byte text.

// A polynomial hash of the code points of a view.
fn chars_hash(in s: Str) -> u64 {
    let mut i: u64 = 0;
    let mut acc: u64 = 7;
    loop {
        match s.next_char(i) {
            Option::Some(decoded) => {
                let (c, next) = decoded;
                acc = wrapping_add(wrapping_mul(acc, 31), widen_u64(c));
                i = next;
            }
            Option::None => break,
        }
    }
    acc
}

// A polynomial hash of the bytes of a slice.
fn bytes_hash(in b: Slice[u8]) -> u64 {
    let mut acc: u64 = 11;
    for i in 0..b.len() {
        match b.try_get(i) {
            Option::Some(x) => acc = wrapping_add(wrapping_mul(acc, 257), widen_u64(x)),
            Option::None => {}
        }
    }
    acc
}

// Bit k of the result is set when the k-th comparison holds.
fn order_bits(in a: Str, in b: Str) -> u64 {
    let mut bits: u64 = 0;
    if a == b {
        bits = bits | 1;
    }
    if a != b {
        bits = bits | 2;
    }
    if a < b {
        bits = bits | 4;
    }
    if a <= b {
        bits = bits | 8;
    }
    if a > b {
        bits = bits | 16;
    }
    if a >= b {
        bits = bits | 32;
    }
    bits
}

fn built() -> String {
    let mut s = String::with_capacity(2);
    s.push_str("h");
    s.push_char(233);
    s.push_str("llo, ");
    s.push_char(19990);
    s.push_char(30028);
    s.push_char(32);
    s.push_char(128512);
    s
}

fn checksum() -> u64 eff [Fail[RuntimeError]] {
    let ascii = "plain ascii";
    let mixed = built();
    let joined = mixed.concat(" and ".concat(ascii));
    let mut total: u64 = 0;
    total = wrapping_add(wrapping_mul(total, 1000003), joined.len());
    total = wrapping_add(wrapping_mul(total, 1000003), joined.char_count());
    total = wrapping_add(wrapping_mul(total, 1000003), chars_hash(joined));
    total = wrapping_add(wrapping_mul(total, 1000003), chars_hash(mixed[1..3]));
    total = wrapping_add(wrapping_mul(total, 1000003), chars_hash(mixed[8..14]));
    total = wrapping_add(wrapping_mul(total, 1000003), bytes_hash(mixed.as_bytes()));
    total = wrapping_add(wrapping_mul(total, 1000003), widen_u64(mixed.byte_at(1)));
    total = wrapping_add(wrapping_mul(total, 1000003), widen_u64(mixed.char_at(1)));
    total = wrapping_add(wrapping_mul(total, 1000003), widen_u64(mixed.char_at(8)));
    let after_ascii = mixed.is_char_boundary(1);
    let inside_char = mixed.is_char_boundary(2);
    let at_end = mixed.is_char_boundary(mixed.len());
    let boundary: u64 = if after_ascii && !inside_char && at_end {
        1
    } else {
        0
    };
    total = wrapping_add(wrapping_mul(total, 1000003), boundary);
    let missing: u64 = match mixed.try_byte_at(mixed.len()) {
        Option::Some(b) => 1,
        Option::None => 2,
    };
    total = wrapping_add(wrapping_mul(total, 1000003), missing);
    let rejected: u64 = if mixed.concat("").len() == mixed.len() {
        1
    } else {
        0
    };
    total = wrapping_add(wrapping_mul(total, 1000003), rejected);
    let mut scratch = "temporary";
    let surrogate: u64 = if scratch.push_char(55296) {
        1
    } else {
        0
    };
    let too_big: u64 = if scratch.push_char(1114112) {
        1
    } else {
        0
    };
    let top: u64 = if scratch.push_char(1114111) {
        1
    } else {
        0
    };
    total = wrapping_add(
        wrapping_mul(total, 1000003),
        wrapping_add(wrapping_mul(surrogate, 4), wrapping_add(wrapping_mul(too_big, 2), top))
    );
    total = wrapping_add(wrapping_mul(total, 1000003), scratch.len());
    scratch.clear();
    scratch.reserve(100);
    scratch.push_str(mixed[0..1]);
    total = wrapping_add(wrapping_mul(total, 1000003), chars_hash(scratch));
    total = wrapping_add(wrapping_mul(total, 1000003), order_bits("abc", "abd"));
    total = wrapping_add(wrapping_mul(total, 1000003), order_bits("abc", "ab"));
    total = wrapping_add(wrapping_mul(total, 1000003), order_bits("", ""));
    total = wrapping_add(wrapping_mul(total, 1000003), order_bits("z", "é"));
    total = wrapping_add(wrapping_mul(total, 1000003), order_bits(mixed, joined));
    total = wrapping_add(wrapping_mul(total, 1000003), order_bits(mixed[0..1], "h"));
    let same: u64 = if mixed == built() && mixed != ascii {
        1
    } else {
        0
    };
    total = wrapping_add(wrapping_mul(total, 1000003), same);
    total
}

fn main() -> u64 {
    handle Fail[RuntimeError] in {
        checksum()
    } with {
        return x => x,
        raise(e, k) => 1,
    }
}
