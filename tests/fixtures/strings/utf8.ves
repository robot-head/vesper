// UTF-8 validation (RFC 3629) through String::from_utf8: overlong forms,
// surrogates, values past U+10FFFF, stray and truncated continuations.

fn chars_hash(in s: Str) -> u64 {
    let mut i: u64 = 0;
    let mut acc: u64 = 7;
    loop {
        match s.next_char(i) {
            Option::Some(decoded) => {
                let (c, next) = decoded;
                acc = wrapping_add(wrapping_mul(acc, 31), widen_u64(c));
                i = next;
            }
            Option::None => break,
        }
    }
    acc
}

// The first `n` of five bytes.
fn bytes(n: u64, a: u8, b: u8, c: u8, d: u8, e: u8) -> ChunkSeq[u8] {
    let mut s: ChunkSeq[u8] = ChunkSeq::new[u8]();
    if n > 0 {
        s.push(a);
    }
    if n > 1 {
        s.push(b);
    }
    if n > 2 {
        s.push(c);
    }
    if n > 3 {
        s.push(d);
    }
    if n > 4 {
        s.push(e);
    }
    s
}

fn case(k: u64) -> ChunkSeq[u8] {
    match k {
        0 => bytes(0, 0, 0, 0, 0, 0),
        1 => bytes(1, 65, 0, 0, 0, 0),
        2 => bytes(2, 195, 169, 0, 0, 0),
        3 => bytes(2, 192, 128, 0, 0, 0),
        4 => bytes(2, 193, 191, 0, 0, 0),
        5 => bytes(3, 224, 128, 128, 0, 0),
        6 => bytes(3, 224, 160, 128, 0, 0),
        7 => bytes(3, 237, 160, 128, 0, 0),
        8 => bytes(3, 237, 159, 191, 0, 0),
        9 => bytes(4, 240, 143, 191, 191, 0),
        10 => bytes(4, 240, 144, 128, 128, 0),
        11 => bytes(4, 244, 143, 191, 191, 0),
        12 => bytes(4, 244, 144, 128, 128, 0),
        13 => bytes(4, 245, 128, 128, 128, 0),
        14 => bytes(1, 128, 0, 0, 0, 0),
        15 => bytes(2, 226, 130, 0, 0, 0),
        16 => bytes(5, 97, 226, 130, 172, 98),
        17 => bytes(1, 255, 0, 0, 0, 0),
        18 => bytes(2, 195, 40, 0, 0, 0),
        _ => bytes(3, 239, 187, 191, 0, 0),
    }
}

fn validate(in b: Slice[u8]) -> u64 {
    match String::from_utf8(in b) {
        Option::Some(s) => wrapping_add(chars_hash(s), s.len()),
        Option::None => 0,
    }
}

fn main() -> u64 {
    let mut total: u64 = 0;
    let cases: u64 = 20;
    for k in 0..cases {
        let b = case(k);
        total = wrapping_add(wrapping_mul(total, 1000003), validate(in b.as_slice()));
    }
    total
}
