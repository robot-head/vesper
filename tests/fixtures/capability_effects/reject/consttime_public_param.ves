// expect: E0705
// Secret-parameter inference follows direct calls only: a function value's
// public parameter still rejects a secret.
copy struct Secret[T] {
    value: T,
}

fn mix(s: Secret[u64], sink f: fn(u64) -> u64 eff [ConstTime]) -> Secret[u64] eff [ConstTime] {
    let Secret {
        value
    }
    = s;
    Secret {
        value: f(value)
    }
}

fn main() -> u64 {
    0
}
