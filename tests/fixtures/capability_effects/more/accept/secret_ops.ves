// The built-in secret operations of §23.2: a branch-free tag check over
// little-endian loads, a constant-time select and a single declassification
// at the verdict.
copy struct SecU64 {
    value: u64,
}

copy struct SecMask64 {
    bits: u64,
}

fn verify_tag_ct(
    expected: (u8, u8, u8, u8, u8, u8, u8, u8),
    computed: (u8, u8, u8, u8, u8, u8, u8, u8)
) -> bool eff [ConstTime] {
    let e: SecU64 = load_sec_u64le(expected);
    let diff: SecU64 = e.bit_xor(load_sec_u64le(computed));
    let zero: SecMask64 = diff.ct_is_zero();
    zero.declassify_bool()
}

fn choose(flag: SecMask64, a: SecU64, b: SecU64) -> SecU64 eff [ConstTime] {
    let other: SecMask64 = flag.ct_not();
    let first = ct_select(flag, a, b);
    let second = other.ct_select(a, b);
    first.wrapping_add(second)
}

fn main() -> u64 {
    let a: (u8, u8, u8, u8, u8, u8, u8, u8) = (1, 2, 3, 4, 5, 6, 7, 8);
    let b: (u8, u8, u8, u8, u8, u8, u8, u8) = (1, 2, 3, 4, 5, 6, 7, 8);
    let c: (u8, u8, u8, u8, u8, u8, u8, u8) = (1, 2, 3, 4, 5, 6, 7, 9);
    let five = SecU64 {
        value: 5
    };
    let same = five
        .ct_eq(
        SecU64 {
            value: 5
        }
    );
    let sum = choose(
        same,
        SecU64 {
            value: 10
        },
        SecU64 {
            value: 20
        }
    );
    let thirty = sum
        .ct_eq(
        SecU64 {
            value: 30
        }
    );
    if verify_tag_ct(a, b) && !verify_tag_ct(a, c) && thirty.declassify_bool() {
        1
    } else {
        0
    }
}
