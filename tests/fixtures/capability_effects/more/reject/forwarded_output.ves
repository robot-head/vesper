// expect: E0702
// A function that forwards its own inout parameter to a callee that writes
// a secret into it returns that secret to its callers too.
copy struct Secret[T] {
    value: T,
}

fn store(inout out: u64, x: u64) -> Unit eff [ConstTime] {
    out = x;
}

fn forward(inout out: u64, x: u64) -> Unit eff [ConstTime] {
    store(inout out, x);
}

fn leak(s: Secret[u64]) -> Secret[u64] eff [ConstTime] {
    let Secret {
        value
    }
    = s;
    let o: u64 = 0;
    forward(inout o, value);
    if o == 0 {
        s
    } else {
        s
    }
}

fn main() -> u64 {
    0
}
