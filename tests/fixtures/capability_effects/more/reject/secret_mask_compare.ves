// expect: E0707
// Masks are secret: they are used in selects and declassified, never
// compared.
copy struct SecU64 {
    value: u64,
}

copy struct SecMask64 {
    bits: u64,
}

fn same(a: SecU64, b: SecU64) -> SecMask64 eff [ConstTime] {
    a.ct_eq(b)
}

fn main() -> bool {
    let m = same(
        SecU64 {
            value: 1
        },
        SecU64 {
            value: 2
        }
    );
    m == m
}
