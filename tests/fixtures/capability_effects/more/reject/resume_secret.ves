// expect: E0702
// A handler that resumes with a secret makes every perform site of that
// operation secret, also in another function.
copy struct Secret[T] {
    value: T,
}

linear effect Key {
    fn fetch() -> u64;
}

fn use_key(x: u64) -> u64 eff [ConstTime, Key] {
    let k = Key::fetch();
    if k == x {
        1
    } else {
        0
    }
}

fn run(s: Secret[u64]) -> Secret[u64] eff [ConstTime] {
    let Secret {
        value
    }
    = s;
    let r = handle Key in {
        use_key(3)
    } with {
        return result => result,
        fetch(resume) => resume(value),
    };
    s
}

fn main() -> u64 {
    0
}
