// expect E0608: struct conformances are opt-in, so `Point` has no `Ord` without `impl Ord for Point {}`.
copy struct Point {
    x: i64
}

fn max[T: mod copy](a: T, b: T) -> T where T: Ord {
    match a.cmp(b) {
        Less => b,
        _ => a
    }
}

fn main() -> i64 {
    let p = max(
        Point {
            x: 1
        },
        Point {
            x: 2
        }
    );
    p.x
}
