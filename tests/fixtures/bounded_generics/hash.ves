// The builtin `Hash` is deterministic: scalars, tuples and derived structs.
copy struct Point {
    x: i64,
    y: u8
}

impl Hash for Point {}

fn digest[T: mod copy](x: T) -> u64 where T: Hash {
    x.hash()
}

fn main() -> u64 {
    let p = Point {
        x: wrapping_sub(0, 1),
        y: 7
    };
    wrapping_add(
        wrapping_add(digest(wrapping_sub(0, 1)), digest(p)),
        wrapping_add(digest((true, 3)), digest(42))
    )
}
