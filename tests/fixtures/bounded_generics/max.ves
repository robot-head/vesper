// A generic `max` over the builtin `Ord`, at scalars and a derived struct.
copy struct Point {
    x: i64,
    y: i64
}

fn max[T: mod copy](in a: T, in b: T) -> T where T: Ord {
    match a.cmp(b) {
        Less => b,
        _ => a
    }
}

fn main() -> i64 {
    let small = max(3, 7);
    let flag = max(true, false);
    let p = max(
        Point {
            x: 1,
            y: 9
        },
        Point {
            x: 2,
            y: 0
        }
    );
    let f = if flag {
        1
    } else {
        0
    };
    wrapping_add(wrapping_add(wrapping_mul(small, 100), wrapping_mul(p.x, 10)), f)
}
