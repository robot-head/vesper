// [T-RegionScope]: a block result cannot mention its own region.
copy struct Point {
    x: i64,
    y: i64,
}

fn main() -> i64 {
    let leaked = region r {
        (
            1,
            r
                .box(
                Point {
                    x: 1,
                    y: 2
                }
            )
        )
    };
    0
}
