// The third payload does not fit in 40 bytes.
copy struct Wide {
    a: i64,
    b: i64,
}

fn main() -> i64 {
    region r(40) {
        let x = r
            .box(
            Wide {
                a: 1,
                b: 2
            }
        );
        let y = r
            .box(
            Wide {
                a: 3,
                b: 4
            }
        );
        let z = r
            .box(
            Wide {
                a: 5,
                b: 6
            }
        );
        r.get(x).a
    }
}
