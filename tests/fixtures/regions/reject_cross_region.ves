// A box belongs to the region that allocated it.
copy struct Point {
    x: i64,
    y: i64,
}

fn main() -> i64 {
    region a {
        region b {
            let p = a
                .box(
                Point {
                    x: 1,
                    y: 2
                }
            );
            b.get(p).x
        }
    }
}
