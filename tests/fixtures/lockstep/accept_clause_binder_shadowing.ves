linear effect Ask {
    fn ask() -> i64;
}
fn main() -> i64 {
    handle Ask in {
        Ask::ask()
    } with {
        return x => x,
        ask(k) => {
            let v = handle Ask in {
                5
            } with {
                return k => k,
                ask(q) => q(1),
            };
            k(v)
        },
    }
}
