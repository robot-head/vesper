linear effect Ask {
    fn ask() -> i64;
}
fn main() -> i64 {
    handle Fail[ArithOverflow] in {
        let m = 9223372036854775807;
        handle Ask in {
            Ask::ask()
        } with {
            return v => v,
            ask(k) => {
                let w = m + 1;
                k(w)
            },
        }
    } with {
        return v => v,
        raise(e, _) => -7,
    }
}
