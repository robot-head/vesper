fn main() -> i64 {
    handle Fail[ArithOverflow] in {
        handle Fail[RuntimeError] in {
            let a = -9223372036854775807 - 1;
            let b = -1;
            a / b
        } with {
            return v => v,
            raise(e, _) => -2,
        }
    } with {
        return v => v,
        raise(e, _) => -1,
    }
}
