// expect: E0758
copy struct Secret[T] {
    value: T,
}

copy struct Login {
    user_id: u64,
    password: Secret[u64],
}

fn fingerprint(s: Secret[u64]) -> u64 {
    7
}

impl Telemetrable for Login {
    fn telemetry_attr(in self) -> TelemetryAttr {
        TelemetryAttr::Count(fingerprint(self.password))
    }
}

fn main() -> u64 {
    0
}
