@shot(title = 'transaction.vsp', theme = 'dawn', dpi = 2)
linear struct WriteTxn {
    wal_slot: u64
}

impl WriteTxn {
    fn commit(sink self) -> u64 {
        let WriteTxn {
            wal_slot
        }
        = self;
        wal_slot
    }
}

fn main() -> u64 {
    let tx = WriteTxn {
    //  ^? WriteTxn : mod linear
        wal_slot: 42
    };
    tx.commit() //^! consumes the linear transaction
//  ^?
}
