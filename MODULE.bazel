"""Bazel build for the Vesper workspace.

Cargo.toml and Cargo.lock stay the source of truth: rules_rs reads the Cargo
workspace and lockfile directly, so every first-party and third-party
dependency edge comes from Cargo metadata. See docs/bazel.md.
"""

module(name = "vesper")

bazel_dep(name = "rules_rs", version = "0.2.4")
bazel_dep(name = "llvm", version = "0.8.26")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")

toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
toolchains.toolchain(
    edition = "2024",
    version = "1.100.0",
)
use_repo(toolchains, "default_rust_toolchains")

rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

register_toolchains(
    "@default_rust_toolchains//...",
    "@llvm//toolchain:all",
)

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    incompatible_no_root_alias_targets = True,
    incompatible_no_root_crate_data = True,
    platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
    ],
)

# aws-lc-sys (rustls and aws-lc-rs): build AWS-LC with Bazel's C toolchain
# instead of its CMake build script. Mirrors
# @rules_rs//3rd_party/aws-lc-sys:include.MODULE.bazel.
bazel_dep(name = "aws-lc", version = "5.1.0.bcr.3")

rules_rust_bindgen = use_extension("@rules_rs//rs:rules_rust_bindgen.bzl", "rules_rust_bindgen")
use_repo(rules_rust_bindgen, "rules_rust_bindgen")

register_toolchains("@rules_rust_bindgen//:all")

crate.annotation(
    crate = "aws-lc-rs",
    gen_build_script = "off",
)
crate.annotation(
    additive_build_file = "@rules_rs//3rd_party/aws-lc-sys:additive.BUILD.bazel",
    crate = "aws-lc-sys",
    extra_aliased_targets = {"aws_lc_sys_build_info": "aws_lc_sys_build_info"},
    gen_build_script = "off",
    rustc_flags = ["--cfg=use_bindgen_pregenerated"],
    deps = ["@crates//aws_lc_sys_build_info"],
)

inject_repo(crate, "aws-lc")

# Its build script only exports OUT_DIR as DEBUG_OUTPUT_DIR, which the proc
# macro would then embed as an absolute sandbox path.
crate.annotation(
    crate = "wasmtime-internal-component-macro",
    gen_build_script = "off",
    rustc_env = {"DEBUG_OUTPUT_DIR": "wasmtime-component-macro-debug"},
)
use_repo(crate, "crates")

use_repo(toolchains, "host_cargo")

cargo_workspace = use_extension("//tools/bazel:cargo_workspace.bzl", "cargo_workspace")
use_repo(cargo_workspace, "vesper_cargo")
