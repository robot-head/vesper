// Division by zero raises RuntimeError, which the handler turns into 42.
fn divide(divisor: i64) -> i64 eff [Fail[RuntimeError]] {
    84 / divisor
}

fn main() -> i64 {
    handle Fail[RuntimeError] in {
        divide(0)
    } with {
        return value => value,
        raise(error, _) => 42,
    }
}
