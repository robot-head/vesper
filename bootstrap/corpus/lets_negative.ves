// Let bindings, unary minus and truncating division of negatives.
fn mix(a: i64, b: i64) -> i64 eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    let p = a * b;
    let q = -p / 4;
    let r = q % 5;
    p + q - r * 3
}

fn main() -> i64 {
    handle Fail[RuntimeError] in {
        handle Fail[ArithOverflow] in {
            mix(-7, 13)
        } with {
            return value => value,
            raise(error, resume) => -1,
        }
    } with {
        return value => value,
        raise(error, _) => -2,
    }
}
