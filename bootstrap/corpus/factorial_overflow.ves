// 25! overflows i64, so the handler's value is the result.
fn fact(n: i64) -> i64 eff [Fail[ArithOverflow]] {
    if n <= 1 {
        1
    } else {
        n * fact(n - 1)
    }
}

fn main() -> i64 {
    handle Fail[ArithOverflow] in {
        fact(25)
    } with {
        return value => value,
        raise(error, resume) => 7,
    }
}
