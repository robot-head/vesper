# GitHub fallback until Vesper has an upstream Linguist language and grammar.
*.ves linguist-language=Rust

# Keep the published manuscript byte-exact and its editable sources portable.
website/*.pdf binary
docs/manuscript/*.typ text eol=lf

# Unified-diff context lines and this verbatim upstream license retain their bytes.
tools/logos42/patches/*.patch whitespace=-blank-at-eol
tools/logos42/controls/ARENA-LICENSE whitespace=-blank-at-eof
