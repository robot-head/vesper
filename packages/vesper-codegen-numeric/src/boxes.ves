// The Box runtime of AOT objects (src/fip/aot_runtime.rs): `vesper_box_alloc`
// (calloc of at least eight bytes, exit 72 on out of memory) and
// `vesper_box_free`, both counting live boxes in the local word
// `vesper_box_live` with an atomic add.

use @vesper/cranelift::{
    DataId,
    append_block_params_for_function_params,
    block_param,
    builder_new,
    cc_eq,
    cc_ult,
    create_block,
    data_align,
    data_new,
    data_zeroinit,
    declare_data,
    declare_function,
    define_data,
    import_data,
    import_function,
    ins_atomic_rmw,
    ins_brif0,
    ins_call,
    ins_icmp,
    ins_icmp_imm,
    ins_jump0,
    ins_return1,
    ins_select,
    ins_symbol_value,
    ins_trap,
    linkage_import,
    linkage_local,
    mem_trusted,
    module_get_data,
    module_get_function,
    switch_to_block,
    trap_user,
    ty_i64,
    vals1,
    vals2,
};
use self::rt::{
    rt_call,
    rt_call1,
    rt_finish,
    rt_import,
    rt_k,
    rt_sig,
};
use self::tiled::{
    tl_return0,
};

const BOX_OOM_STATUS: i64 = 72;
// The trap code after the exit call (`TrapCode::unwrap_user(72)`).
const BOX_OOM_TRAP: u32 = 72;
// `AtomicRmwOp::Add` in the shim's codes.
const ATOMIC_ADD: u32 = 1;

// `live_counter`: the zeroed, eight-byte aligned, writable counter word.
fn box_live_counter(inout module: Module) -> Option[DataId] eff [Ffi[Cranelift]] {
    match module_get_data(inout module, in "vesper_box_live".as_bytes()) {
        Some(id) => return Some(id),
        None => {},
    }
    let id = declare_data(inout module, in "vesper_box_live".as_bytes(), linkage_local(), true);
    let mut data = match data_new() {
        Some(data) => data,
        None => return None,
    };
    data_zeroinit(inout data, 8);
    data_align(inout data, 8);
    if define_data(inout module, id, data) {
        Some(id)
    } else {
        None
    }
}

fn box_count(inout builder: Builder, in module: Module, live: DataId, delta: i64) eff [
    Ffi[Cranelift]
] {
    let data = import_data(inout builder, in module, live);
    let address = ins_symbol_value(inout builder, ty_i64(), data);
    let delta_value = rt_k(inout builder, delta);
    ins_atomic_rmw(inout builder, ATOMIC_ADD, ty_i64(), mem_trusted(), address, delta_value);
}

// `declare_or_define` and `declare_or_define_free` on a module that holds
// neither yet: `alloc` and `free` select them, in that order; the counter
// is defined once.
pub fn define_box_runtime(
    inout module: Module,
    alloc: bool,
    free: bool
) -> bool eff [Ffi[Cranelift]] {
    if !alloc && !free {
        return true;
    }
    let live = match box_live_counter(inout module) {
        Some(counter) => counter,
        None => return false,
    };
    if alloc {
        let missing = match module_get_function(inout module, in "vesper_box_alloc".as_bytes()) {
            Some(_) => false,
            None => true,
        };
        if missing && !box_define_alloc(inout module, live) {
            return false;
        }
    }
    if free {
        let missing = match module_get_function(inout module, in "vesper_box_free".as_bytes()) {
            Some(_) => false,
            None => true,
        };
        if missing && !box_define_free(inout module, live) {
            return false;
        }
    }
    true
}

fn box_define_alloc(inout module: Module, live: DataId) -> bool eff [Ffi[Cranelift]] {
    let calloc = rt_import(inout module, in "calloc".as_bytes(), 2, true);
    let exit_fn = rt_import(inout module, in "exit".as_bytes(), 1, false);
    let alloc_sig = rt_sig(inout module, 1, true);
    let alloc_id = declare_function(
        inout module,
        in "vesper_box_alloc".as_bytes(),
        linkage_local(),
        alloc_sig
    );
    let mut builder = match builder_new(in module, alloc_sig) {
        Some(builder) => builder,
        None => return false,
    };
    let entry = create_block(inout builder);
    let oom = create_block(inout builder);
    let ok_block = create_block(inout builder);
    append_block_params_for_function_params(inout builder, entry);
    switch_to_block(inout builder, entry);
    let requested = block_param(inout builder, entry, 0);
    let eight = rt_k(inout builder, 8);
    let too_small = ins_icmp(inout builder, cc_ult(), requested, eight);
    let size = ins_select(inout builder, too_small, eight, requested);
    let one = rt_k(inout builder, 1);
    let args = vals2(one, size);
    let ptr = rt_call1(inout builder, inout module, calloc, in args.as_slice());
    let is_null = ins_icmp_imm(inout builder, cc_eq(), ptr, 0);
    ins_brif0(inout builder, is_null, oom, ok_block);

    switch_to_block(inout builder, oom);
    let exit_ref = import_function(inout builder, inout module, exit_fn);
    let status = rt_k(inout builder, BOX_OOM_STATUS);
    let status_args = vals1(status);
    ins_call(inout builder, exit_ref, in status_args.as_slice());
    ins_trap(inout builder, trap_user(BOX_OOM_TRAP));

    switch_to_block(inout builder, ok_block);
    box_count(inout builder, in module, live, 1);
    ins_return1(inout builder, ptr);
    rt_finish(inout module, alloc_id, builder)
}

fn box_define_free(inout module: Module, live: DataId) -> bool eff [Ffi[Cranelift]] {
    let free_sig = rt_sig(inout module, 1, false);
    let libc_free = declare_function(
        inout module,
        in "free".as_bytes(),
        linkage_import(),
        free_sig
    );
    let box_free_id = declare_function(
        inout module,
        in "vesper_box_free".as_bytes(),
        linkage_local(),
        free_sig
    );
    let mut builder = match builder_new(in module, free_sig) {
        Some(builder) => builder,
        None => return false,
    };
    let entry = create_block(inout builder);
    let do_free = create_block(inout builder);
    let done = create_block(inout builder);
    append_block_params_for_function_params(inout builder, entry);
    switch_to_block(inout builder, entry);
    let ptr = block_param(inout builder, entry, 0);
    let is_null = ins_icmp_imm(inout builder, cc_eq(), ptr, 0);
    ins_brif0(inout builder, is_null, done, do_free);

    switch_to_block(inout builder, do_free);
    let args = vals1(ptr);
    rt_call(inout builder, inout module, libc_free, in args.as_slice());
    box_count(inout builder, in module, live, -1);
    ins_jump0(inout builder, done);

    switch_to_block(inout builder, done);
    tl_return0(inout builder);
    rt_finish(inout module, box_free_id, builder)
}
