// @vesper/codegen-numeric: native lowering of the numeric and memory
// families in Vesper (self-hosting wave SH4, lane 11, #1285).
//
// Rust stays the default compiler. This package emits through
// @vesper/cranelift (the C-ABI shim, owner decision 2026-11-19) and is
// compared with the Rust lowering by tests/self_host_codegen_numeric.rs.
//
// Part 1 holds what needs no lent builder from lane 1 (#1275):
// - rt.ves: helpers shared by the generated runtimes.
// - regions.ves: the region runtime of AOT executables
//   (src/regions/aot_runtime.rs).
// - tiled.ves: the TiledSeq runtime (src/tiled/aot_runtime.rs).
// - boxes.ves: the Box runtime (src/fip/aot_runtime.rs).
// - shapes.ves: the vector lane shapes and chunk plans of src/vector.rs
//   and src/native_vector.rs.
//
// Parts 2 and 3 hold the `numeric` hook of `vesper::codegen_swap`
// (`numeric_hook` below), the in-function emission:
// - vector.ves: vector operations (`Codegen::vector_op`) and the request
//   dispatch.
// - tiled_ops.ves: `TiledSeq` operations (`Codegen::tiled_op`).
// - floats.ves: float intrinsics, conversions and the subnormal flush.
//
// The part 1 test (crates/vesper-codegen-numeric-test) assembles
// @vesper/cranelift's source with these files into one unit, without their
// `use` items; the hook tests and the hybrid build load the package.

use @vesper/cranelift::{
    module_finish,
    module_free,
    module_new,
    object_publish,
};
use self::boxes::{
    define_box_runtime,
};
use self::regions::{
    define_region_runtime,
};
use self::tiled::{
    define_tiled_runtime,
};
use self::vector::{
    hook_entry,
};

// The `numeric` hook: `call` is the address of the lent call. Returns 1
// when it emitted the request, 0 to leave it to the Rust code.
pub fn numeric_hook(call: u64) -> u64 eff [Ffi[Cranelift]] {
    hook_entry(call)
}

// Runtime families of `runtime_object`.
pub const RT_REGIONS: u32 = 1;
pub const RT_TILED: u32 = 2;
pub const RT_BOX_ALLOC: u32 = 4;
pub const RT_BOX_FREE: u32 = 8;

// An object module for `triple` with Cranelift `flags` holding the
// runtimes `families` selects, in the order the Rust lowering defines
// them; the object is published to the host (`take_published`), 0 on a
// failure.
pub fn runtime_object(in triple: Slice[u8], in flags: Slice[u8], families: u32)
    -> u64 eff [Ffi[Cranelift]] {
    let mut m = match module_new(in triple, in flags, in "vesper".as_bytes()) {
        Some(m) => m,
        None => return 0,
    };
    let mut ok = true;
    if (families & RT_REGIONS) != 0 || (families & RT_TILED) != 0 {
        ok = define_region_runtime(inout m);
    }
    if ok && (families & RT_TILED) != 0 {
        ok = define_tiled_runtime(inout m);
    }
    if ok {
        ok = define_box_runtime(
            inout m,
            (families & RT_BOX_ALLOC) != 0,
            (families & RT_BOX_FREE) != 0
        );
    }
    if !ok {
        module_free(m);
        return 0;
    }
    match module_finish(m) {
        Some(o) => object_publish(o),
        None => 0,
    }
}
