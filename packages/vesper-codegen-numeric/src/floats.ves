// The `numeric` hook's float family: `Codegen::math`, the float
// conversions of `Codegen::float_unary` and `Codegen::flush` (Rust:
// src/float_math/native.rs and src/native.rs), emitted through the lent
// Cranelift builder (self-hosting SH4 lane 11, #1285, part 3).
//
// The Rust code sends one typed request per operation, with what it
// resolved (the words are documented in `codegen_swap::numeric` of
// src/codegen_swap.rs). Errors (arity, a non-float operand) and the raise
// of a checked narrowing stay in the Rust code. Every emission makes the
// Cranelift calls of the Rust function in the same order.

use @vesper/cranelift::codes::{
    Bin,
    Cv,
    FloatCc,
    IntCc,
    Ternary,
    TyCode,
    Un,
};
use @vesper/cranelift::{
    Builder,
    Ty,
    Value,
    call_arg,
    call_arg_count,
    ins_binary,
    ins_convert,
    ins_f32const,
    ins_f64const,
    ins_fcmp,
    ins_icmp_imm,
    ins_iconst,
    ins_select,
    ins_unary,
    value_of_word,
    value_type,
};

// Request ops (`codegen_swap::numeric`).
pub const NUM_FLOAT_MATH: u32 = 4;
pub const NUM_FLOAT_CONVERT: u32 = 5;
pub const NUM_FLOAT_TO_INT: u32 = 6;
pub const NUM_FLOAT_BITS: u32 = 7;
pub const NUM_FLOAT_NARROW_TEST: u32 = 8;
pub const NUM_FLOAT_FLUSH: u32 = 9;

// Float words and conversion classes (`numeric::FROM_*`).
const FROM_F32: u64 = 1;
const FROM_F64: u64 = 2;
const FROM_SIGNED: u64 = 3;
const FROM_UNSIGNED: u64 = 4;

// `MathOp::ALL` positions from 1.
const MATH_SQRT: u64 = 1;
const MATH_ABS: u64 = 2;
const MATH_FLOOR: u64 = 3;
const MATH_CEIL: u64 = 4;
const MATH_ROUND: u64 = 5;
const MATH_TRUNC: u64 = 6;
const MATH_MIN: u64 = 7;
const MATH_MAX: u64 = 8;
const MATH_FMA: u64 = 9;

// Shim opcodes (crates/vesper-cranelift-sys/src/codes.rs).

// IEEE 754 bit patterns of the constants the Rust code emits.
const F32_HALF: u32 = 1056964608;
const F32_ONE: u32 = 1065353216;
const F32_MIN_POSITIVE: u32 = 8388608;
const F64_HALF: u64 = 4602678819172646912;
const F64_ONE: u64 = 4607182418800017408;
const F64_MIN_POSITIVE: u64 = 4503599627370496;

// The f64 -> f32 narrowing of `f32_bits_of`.
const F64_SIGN_SHIFT: u64 = 63;
const F32_SIGN_SHIFT: u64 = 31;
const F64_MANTISSA_BITS: u64 = 52;
const F64_MANTISSA_MASK: u64 = 4503599627370495;
const F64_IMPLICIT_BIT: u64 = 4503599627370496;
const F64_EXPONENT_MASK: u64 = 2047;
const F32_MANTISSA_BITS: u64 = 23;
// The f64 mantissa bits an f32 drops.
const F32_DROPPED_BITS: u64 = 29;
const F32_INFINITY: u64 = 2139095040;
const F32_QUIET_NAN: u64 = 2143289344;
// f64 biased exponents: the f32 exponent is the f64 one less 896 (1023 -
// 127); 897 is the least normal f32 and 1151 the first that overflows.
const F32_EXPONENT_REBIAS: u64 = 896;
const F32_LEAST_NORMAL_EXPONENT: u64 = 897;
const F32_OVERFLOW_EXPONENT: u64 = 1151;
// A shift that drops every significand bit.
const WORD_BITS: u64 = 64;

// `to_bits_f32(nearest_f32(from_bits_f64(bits)))` in integer arithmetic:
// the f32 nearest the f64 `bits` (ties to even), with an infinity for an
// overflow, a signed zero for an underflow and a quiet NaN that keeps the
// payload's top bits for a NaN. Stage 2's Wasm backend has no `f32`, and
// this is the package's only `f32` value (#2210).
fn f32_bits_of(bits: u64) -> u32 {
    let sign = (bits >> F64_SIGN_SHIFT) << F32_SIGN_SHIFT;
    let exponent = (bits >> F64_MANTISSA_BITS) & F64_EXPONENT_MASK;
    let mantissa = bits & F64_MANTISSA_MASK;
    if exponent == F64_EXPONENT_MASK {
        if mantissa == 0 {
            return wrapping_u32(sign | F32_INFINITY);
        }
        return wrapping_u32(sign | F32_QUIET_NAN | (mantissa >> F32_DROPPED_BITS));
    }
    if exponent >= F32_OVERFLOW_EXPONENT {
        return wrapping_u32(sign | F32_INFINITY);
    }
    if exponent == 0 {
        return wrapping_u32(sign);
    }
    let (significand, shift, base) = if exponent >= F32_LEAST_NORMAL_EXPONENT {
        (
            mantissa,
            F32_DROPPED_BITS,
            wrapping_sub(exponent, F32_EXPONENT_REBIAS) << F32_MANTISSA_BITS
        )
    } else {
        (
            mantissa | F64_IMPLICIT_BIT,
            wrapping_add(F32_DROPPED_BITS, wrapping_sub(F32_LEAST_NORMAL_EXPONENT, exponent)),
            0
        )
    };
    if shift >= WORD_BITS {
        return wrapping_u32(sign);
    }
    let bit: u64 = 1;
    let kept = wrapping_shr_u64(significand, wrapping_u32(shift));
    let rest = significand & wrapping_sub(wrapping_shl_u64(bit, wrapping_u32(shift)), 1);
    let half = wrapping_shl_u64(bit, wrapping_u32(wrapping_sub(shift, 1)));
    let rounded = if rest > half || (rest == half && (kept & 1) == 1) {
        wrapping_add(kept, 1)
    } else {
        kept
    };
    // A carry out of the mantissa moves into the exponent (up to infinity).
    wrapping_u32(sign | wrapping_add(base, rounded))
}

fn fty(code: u32) -> Ty {
    Ty { code: code }
}

fn arg(call: u64, i: u64) -> u64 eff [Ffi[Cranelift]] {
    call_arg(call, i)
}

fn arg_value(call: u64, i: u64) -> Value eff [Ffi[Cranelift]] {
    value_of_word(call_arg(call, i))
}

fn is_f32(inout builder: Builder, value: Value) -> bool eff [Ffi[Cranelift]] {
    value_type(inout builder, value).code == TyCode::F32
}

// `float_const(ty, x)` for the constants above: `f32const` of the `f32`
// bits when `value` is an `f32`, else `f64const`.
fn float_const_like(
    inout builder: Builder,
    value: Value,
    bits32: u32,
    bits64: u64
) -> Value eff [Ffi[Cranelift]] {
    if is_f32(inout builder, value) {
        ins_f32const(inout builder, bits32)
    } else {
        ins_f64const(inout builder, bits64)
    }
}

// `float_const(ty, x)` of an `f64` bit pattern: `x as f32` for `f32`.
fn float_const_of(inout builder: Builder, f32_kind: bool, bits: u64) -> Value eff [Ffi[Cranelift]] {
    if f32_kind {
        ins_f32const(inout builder, f32_bits_of(bits))
    } else {
        ins_f64const(inout builder, bits)
    }
}

// Whether `op` is a float request this hook answers, with its operand
// count right.
pub fn float_known(call: u64, op: u32) -> bool eff [Ffi[Cranelift]] {
    let n = call_arg_count(call);
    if op == NUM_FLOAT_MATH {
        if n < 2 {
            return false;
        }
        let math_op = arg(call, 0);
        let arity: u64 = if math_op == MATH_MIN || math_op == MATH_MAX {
            2
        } else if math_op == MATH_FMA {
            3
        } else if math_op >= MATH_SQRT && math_op <= MATH_TRUNC {
            1
        } else {
            0
        };
        return arity > 0 && n == wrapping_add(arity, 1);
    }
    if op == NUM_FLOAT_CONVERT {
        let to = arg(call, 0);
        let from = arg(call, 1);
        return n == 3
            && (to == FROM_F32 || to == FROM_F64)
            && from >= FROM_F32
            && from <= FROM_UNSIGNED;
    }
    if op == NUM_FLOAT_TO_INT {
        return n == 5;
    }
    if op == NUM_FLOAT_BITS {
        let kind = arg(call, 1);
        return n == 3 && (kind == FROM_F32 || kind == FROM_F64);
    }
    if op == NUM_FLOAT_NARROW_TEST {
        let kind = arg(call, 0);
        return n == 4 && (kind == FROM_F32 || kind == FROM_F64);
    }
    if op == NUM_FLOAT_FLUSH {
        return n == 1;
    }
    false
}

// `Codegen::math`.
fn math(call: u64, inout builder: Builder) -> Value eff [Ffi[Cranelift]] {
    let math_op = arg(call, 0);
    let x = arg_value(call, 1);
    if math_op == MATH_SQRT {
        return ins_unary(inout builder, Un::Sqrt, x);
    }
    if math_op == MATH_ABS {
        return ins_unary(inout builder, Un::Fabs, x);
    }
    if math_op == MATH_FLOOR {
        return ins_unary(inout builder, Un::Floor, x);
    }
    if math_op == MATH_CEIL {
        return ins_unary(inout builder, Un::Ceil, x);
    }
    if math_op == MATH_TRUNC {
        return ins_unary(inout builder, Un::Trunc, x);
    }
    if math_op == MATH_MIN {
        return ins_binary(inout builder, Bin::Fmin, x, arg_value(call, 2));
    }
    if math_op == MATH_MAX {
        return ins_binary(inout builder, Bin::Fmax, x, arg_value(call, 2));
    }
    if math_op == MATH_FMA {
        let y = arg_value(call, 2);
        let z = arg_value(call, 3);
        return Value { id: Cranelift::vcl_ternary(inout builder, Ternary::Fma, x.id, y.id, z.id) };
    }
    // `round`: t = trunc(x); |x - t| >= 0.5 moves t one away from zero.
    let t = ins_unary(inout builder, Un::Trunc, x);
    let distance = ins_binary(inout builder, Bin::Fsub, x, t);
    let distance = ins_unary(inout builder, Un::Fabs, distance);
    let half = float_const_like(inout builder, x, F32_HALF, F64_HALF);
    let far = ins_fcmp(inout builder, FloatCc::Ge, distance, half);
    let one = float_const_like(inout builder, x, F32_ONE, F64_ONE);
    let step = ins_binary(inout builder, Bin::Fcopysign, one, x);
    let away = ins_binary(inout builder, Bin::Fadd, t, step);
    ins_select(inout builder, far, away, t)
}

// `float_unary`'s conversion to a float kind.
fn convert(call: u64, inout builder: Builder) -> Value eff [Ffi[Cranelift]] {
    let target = if arg(call, 0) == FROM_F32 {
        fty(TyCode::F32)
    } else {
        fty(TyCode::F64)
    };
    let from = arg(call, 1);
    let operand = arg_value(call, 2);
    let op = if from == FROM_F32 {
        Cv::Fpromote
    } else if from == FROM_F64 {
        Cv::Fdemote
    } else if from == FROM_SIGNED {
        Cv::FcvtFromSint
    } else {
        Cv::FcvtFromUint
    };
    ins_convert(inout builder, op, target, operand)
}

// `float_to_integer`: truncation toward zero, clamped, NaN to zero.
fn to_integer(call: u64, inout builder: Builder) -> Value eff [Ffi[Cranelift]] {
    let signed = arg(call, 0) != 0;
    let bits = arg(call, 1);
    let lo = wrapping_i64(arg(call, 2));
    let hi = wrapping_i64(arg(call, 3));
    let operand = arg_value(call, 4);
    if signed {
        let int_value = ins_convert(inout builder, Cv::FcvtToSintSat, fty(TyCode::I64), operand);
        if bits == 64 {
            return int_value;
        }
        let lo = ins_iconst(inout builder, fty(TyCode::I64), lo);
        let hi = ins_iconst(inout builder, fty(TyCode::I64), hi);
        let int_value = ins_binary(inout builder, Bin::Smax, int_value, lo);
        ins_binary(inout builder, Bin::Smin, int_value, hi)
    } else {
        let int_value = ins_convert(inout builder, Cv::FcvtToUintSat, fty(TyCode::I64), operand);
        if bits == 64 {
            return int_value;
        }
        let hi = ins_iconst(inout builder, fty(TyCode::I64), hi);
        ins_binary(inout builder, Bin::Umin, int_value, hi)
    }
}

// `to_bits_k` and `from_bits_k`.
fn bits(call: u64, inout builder: Builder) -> Value eff [Ffi[Cranelift]] {
    let to_bits = arg(call, 0) != 0;
    let f64_kind = arg(call, 1) == FROM_F64;
    let operand = arg_value(call, 2);
    if to_bits && f64_kind {
        return ins_convert(inout builder, Cv::Bitcast, fty(TyCode::I64), operand);
    }
    if to_bits {
        let word32 = ins_convert(inout builder, Cv::Bitcast, fty(TyCode::I32), operand);
        return ins_convert(inout builder, Cv::Uextend, fty(TyCode::I64), word32);
    }
    if f64_kind {
        return ins_convert(inout builder, Cv::Bitcast, fty(TyCode::F64), operand);
    }
    let word32 = ins_convert(inout builder, Cv::Ireduce, fty(TyCode::I32), operand);
    ins_convert(inout builder, Cv::Bitcast, fty(TyCode::F32), word32)
}

// The range test of a checked float narrowing: the overflow flag.
fn narrow_test(call: u64, inout builder: Builder) -> Value eff [Ffi[Cranelift]] {
    let f32_kind = arg(call, 0) == FROM_F32;
    let operand = arg_value(call, 3);
    let truncated = ins_unary(inout builder, Un::Trunc, operand);
    let lo = float_const_of(inout builder, f32_kind, arg(call, 1));
    let hi = float_const_of(inout builder, f32_kind, arg(call, 2));
    // Ordered comparisons: a NaN fails both.
    let above = ins_fcmp(inout builder, FloatCc::Ge, truncated, lo);
    let below = ins_fcmp(inout builder, FloatCc::Lt, truncated, hi);
    let in_range = ins_binary(inout builder, Bin::Band, above, below);
    ins_icmp_imm(inout builder, IntCc::Eq, in_range, 0)
}

// `Codegen::flush`: a subnormal becomes a zero of the same sign.
fn flush(call: u64, inout builder: Builder) -> Value eff [Ffi[Cranelift]] {
    let operand = arg_value(call, 0);
    let magnitude = ins_unary(inout builder, Un::Fabs, operand);
    let smallest = float_const_like(inout builder, operand, F32_MIN_POSITIVE, F64_MIN_POSITIVE);
    let tiny = ins_fcmp(inout builder, FloatCc::Lt, magnitude, smallest);
    let zero = float_const_like(inout builder, operand, 0, 0);
    let signed_zero = ins_binary(inout builder, Bin::Fcopysign, zero, operand);
    ins_select(inout builder, tiny, signed_zero, operand)
}

// One float request `op` (checked by `float_known`).
pub fn float_request(call: u64, op: u32, inout builder: Builder) -> Value eff [Ffi[Cranelift]] {
    if op == NUM_FLOAT_MATH {
        math(call, inout builder)
    } else if op == NUM_FLOAT_CONVERT {
        convert(call, inout builder)
    } else if op == NUM_FLOAT_TO_INT {
        to_integer(call, inout builder)
    } else if op == NUM_FLOAT_BITS {
        bits(call, inout builder)
    } else if op == NUM_FLOAT_NARROW_TEST {
        narrow_test(call, inout builder)
    } else {
        flush(call, inout builder)
    }
}
