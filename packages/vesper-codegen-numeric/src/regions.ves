// The region runtime of AOT executables (src/regions/aot_runtime.rs),
// transliterated function by function: `define` declares the libc imports
// and the fault messages and defines the four helpers and the ten
// `vesper_region_*` entry points as local functions of the module.
//
// Layout (offsets of the region record, a slot and a watermark) and the
// handle encoding are the Rust module's constants; see its documentation.

use @vesper/cranelift::{
    Block,
    DataId,
    FuncId,
    Value,
    Var,
    append_block_param,
    block_param,
    builder_new,
    cc_eq,
    cc_ne,
    cc_uge,
    cc_ugt,
    cc_ult,
    create_block,
    declare_var,
    def_var,
    import_data,
    ins_band_imm,
    ins_bor,
    ins_brif,
    ins_brif0,
    ins_iadd,
    ins_iadd_imm,
    ins_icmp,
    ins_icmp_imm,
    ins_imul_imm,
    ins_ishl_imm,
    ins_isub,
    ins_jump,
    ins_jump0,
    ins_load,
    ins_return,
    ins_return1,
    ins_store,
    ins_symbol_value,
    ins_trap,
    ins_umax,
    ins_ushr_imm,
    mem_trusted,
    module_get_function,
    switch_to_block,
    trap_user,
    ty_i64,
    use_var,
    vals1,
    vals2,
    vals3,
};
use self::rt::{
    no_vals,
    rt_call,
    rt_call1,
    rt_entry,
    rt_finish,
    rt_import,
    rt_k,
    rt_local,
    rt_message,
    rt_numbered,
    rt_sig,
    rt_text,
};

const R_BASE: i32 = 0;
const R_CAP: i32 = 8;
const R_CURSOR: i32 = 16;
const R_SLOTS: i32 = 24;
const R_NSLOTS: i32 = 32;
const R_SLOTCAP: i32 = 40;
const R_MARKS: i32 = 48;
const R_NMARKS: i32 = 56;
const R_MARKCAP: i32 = 64;
const R_SERIAL: i32 = 72;
const R_RECORD: i64 = 80;

const S_START: i32 = 0;
const S_LEN: i32 = 8;
const S_PRIOR: i32 = 16;
const S_SERIAL: i32 = 24;
const S_LIVE: i32 = 32;
const S_SLOT: i64 = 40;

const M_SERIAL: i32 = 0;
const M_SLOTS: i32 = 8;
const M_CURSOR: i32 = 16;
const M_MARK: i64 = 24;

const INDEX_BITS: i64 = 21;
// (1 << INDEX_BITS) - 1
const INDEX_MASK: i64 = 2097151;
// 1 << (63 - INDEX_BITS)
const MAX_SERIAL: i64 = 4398046511104;
// crate::regions::store::{MAX_ALLOCATIONS, MAX_CHECKPOINTS}
const MAX_ALLOCATIONS: i64 = 1048576;
const MAX_CHECKPOINTS: i64 = 256;

// Exit status of an executable after a region fault.
pub const REGION_FAULT_STATUS: i64 = 70;
// The trap code after a fault call (`TrapCode::unwrap_user(5)`).
const REGION_TRAP: u32 = 5;

// Fault message indices (the order of `FAULTS`).
const F_EXHAUSTED: i64 = 0;
const F_ALLOCATIONS: i64 = 1;
const F_CHECKPOINTS: i64 = 2;
const F_STALE: i64 = 3;
const F_BOUNDS: i64 = 4;
const F_MEMORY: i64 = 5;
const REGION_FAULTS: u32 = 6;

fn region_fault_text(i: u32) -> Str {
    if i == 0 {
        "region bound exhausted"
    } else if i == 1 {
        "region bound exhausted: too many allocations"
    } else if i == 2 {
        "region bound exhausted: too many checkpoints"
    } else if i == 3 {
        "region handle is stale (rewound, reset or moved out)"
    } else if i == 4 {
        "region handle does not belong to this region"
    } else {
        "out of memory"
    }
}

// The `which` of the four helpers `region_emit` defines before the
// entry points (whose `which` is their index, below 100).
enum RegionHelper: _ {
    Fault = 100,
    Reclaim = 101,
    Resolve = 102,
    FindMark = 103,
}

// The runtime entry points: name and `i64` parameter count (`FUNCTIONS`).
const REGION_FUNCTIONS: u32 = 10;
fn region_function_name(i: u32) -> Str {
    if i == 0 {
        "vesper_region_open"
    } else if i == 1 {
        "vesper_region_close"
    } else if i == 2 {
        "vesper_region_alloc"
    } else if i == 3 {
        "vesper_region_load"
    } else if i == 4 {
        "vesper_region_store"
    } else if i == 5 {
        "vesper_region_release"
    } else if i == 6 {
        "vesper_region_checkpoint"
    } else if i == 7 {
        "vesper_region_rewind"
    } else if i == 8 {
        "vesper_region_commit"
    } else {
        "vesper_region_used"
    }
}
fn region_function_params(i: u32) -> u32 {
    if i == 2 || i == 5 || i == 7 || i == 8 {
        2
    } else if i == 3 {
        3
    } else if i == 4 {
        4
    } else {
        1
    }
}

struct RegionImports {
    malloc: FuncId,
    realloc: FuncId,
    free: FuncId,
    memset: FuncId,
    memmove: FuncId,
    write: FuncId,
    exit: FuncId,
    fault: FuncId,
    reclaim: FuncId,
    resolve: FuncId,
    find_mark: FuncId,
    messages: ChunkSeq[u32],
    lengths: ChunkSeq[i64],
}

// Defines every runtime function in `module` (`define`). The caller checks that
// the module does not hold it yet (`defined`) and that pointers are 64-bit.
pub fn define_region_runtime(inout module: Module) -> bool eff [Ffi[Cranelift]] {
    match module_get_function(inout module, in "vesper_region_fault".as_bytes()) {
        Some(_) => return true,
        None => {},
    }
    let mut messages: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut lengths: ChunkSeq[i64] = ChunkSeq::new[i64]();
    for i in 0..REGION_FAULTS {
        let bytes = rt_text(in "vesper: native region fault: ", in region_fault_text(i));
        let name = rt_numbered(in "vesper_region_message", i);
        match rt_message(inout module, in name.as_slice(), in bytes.as_slice()) {
            Some(id) => {
                messages.push(id.id);
                lengths.push(wrapping_i64(bytes.len()));
            },
            None => return false,
        }
    }
    let imports = RegionImports {
        malloc: rt_import(inout module, in "malloc".as_bytes(), 1, true),
        realloc: rt_import(inout module, in "realloc".as_bytes(), 2, true),
        free: rt_import(inout module, in "free".as_bytes(), 1, false),
        memset: rt_import(inout module, in "memset".as_bytes(), 3, true),
        memmove: rt_import(inout module, in "memmove".as_bytes(), 3, true),
        write: rt_import(inout module, in "write".as_bytes(), 3, true),
        exit: rt_import(inout module, in "exit".as_bytes(), 1, false),
        fault: rt_local(inout module, in "vesper_region_fault".as_bytes(), 1, false),
        reclaim: rt_local(inout module, in "vesper_region_reclaim".as_bytes(), 1, false),
        resolve: rt_local(inout module, in "vesper_region_resolve".as_bytes(), 2, true),
        find_mark: rt_local(inout module, in "vesper_region_find_mark".as_bytes(), 2, true),
        messages,
        lengths,
    };
    if !region_emit(inout module, in imports, imports.fault, 1, false, RegionHelper::Fault) {
        return false;
    }
    if !region_emit(inout module, in imports, imports.reclaim, 1, false, RegionHelper::Reclaim) {
        return false;
    }
    if !region_emit(inout module, in imports, imports.resolve, 2, true, RegionHelper::Resolve) {
        return false;
    }
    if !region_emit(inout module, in imports, imports.find_mark, 2, true, RegionHelper::FindMark) {
        return false;
    }
    for i in 0..REGION_FUNCTIONS {
        let params = region_function_params(i);
        let id = rt_local(inout module, in region_function_name(i).as_bytes(), params, true);
        if !region_emit(inout module, in imports, id, params, true, i) {
            return false;
        }
    }
    true
}

// The `emit` closure: one function whose body is `which` (0-9 the entry
// points in `FUNCTIONS` order, 100-103 the helpers).
fn region_emit(
    inout module: Module,
    in imports: RegionImports,
    id: FuncId,
    params: u32,
    ret: bool,
    which: u32
) -> bool eff [Ffi[Cranelift]] {
    let sig = rt_sig(inout module, params, ret);
    let mut builder = match builder_new(in module, sig) {
        Some(builder) => builder,
        None => return false,
    };
    let entry = rt_entry(inout builder, false);
    let param0 = block_param(inout builder, entry, 0);
    let param1 = if params > 1 {
        block_param(inout builder, entry, 1)
    } else {
        param0
    };
    let param2 = if params > 2 {
        block_param(inout builder, entry, 2)
    } else {
        param0
    };
    let param3 = if params > 3 {
        block_param(inout builder, entry, 3)
    } else {
        param0
    };
    if which == RegionHelper::Fault {
        rg_fault_body(inout builder, inout module, in imports, param0);
    } else if which == RegionHelper::Reclaim {
        rg_reclaim_body(inout builder, param0);
    } else if which == RegionHelper::Resolve {
        rg_resolve_body(inout builder, inout module, in imports, param0, param1);
    } else if which == RegionHelper::FindMark {
        rg_find_mark_body(inout builder, inout module, in imports, param0, param1);
    } else if which == 0 {
        rg_open(inout builder, inout module, in imports, param0);
    } else if which == 1 {
        rg_close(inout builder, inout module, in imports, param0);
    } else if which == 2 {
        rg_alloc(inout builder, inout module, in imports, param0, param1);
    } else if which == 3 {
        rg_load_word(inout builder, inout module, in imports, param0, param1, param2);
    } else if which == 4 {
        rg_store_word(inout builder, inout module, in imports, param0, param1, param2, param3);
    } else if which == 5 {
        rg_release(inout builder, inout module, in imports, param0, param1);
    } else if which == 6 {
        rg_checkpoint(inout builder, inout module, in imports, param0);
    } else if which == 7 {
        rg_rewind(inout builder, inout module, in imports, param0, param1);
    } else if which == 8 {
        rg_commit(inout builder, inout module, in imports, param0, param1);
    } else {
        rg_used(inout builder, param0);
    }
    rt_finish(inout module, id, builder)
}

fn rg_ld(inout builder: Builder, addr: Value, off: i32) -> Value eff [Ffi[Cranelift]] {
    ins_load(inout builder, ty_i64(), mem_trusted(), addr, off)
}
fn rg_st(inout builder: Builder, value: Value, addr: Value, off: i32) eff [Ffi[Cranelift]] {
    ins_store(inout builder, mem_trusted(), value, addr, off);
}
fn rg_ret(inout builder: Builder, value: Value) eff [Ffi[Cranelift]] {
    ins_return1(inout builder, value);
}
fn rg_ret0(inout builder: Builder) eff [Ffi[Cranelift]] {
    let zero = rt_k(inout builder, 0);
    rg_ret(inout builder, zero);
}

// Continues in a fresh block when `cond` is false; reports `fault`
// otherwise.
fn rg_fault_if(
    inout builder: Builder,
    inout module: Module,
    in imports: RegionImports,
    cond: Value,
    fault: i64
) eff [Ffi[Cranelift]] {
    let fault_block = create_block(inout builder);
    let ok_block = create_block(inout builder);
    ins_brif0(inout builder, cond, fault_block, ok_block);
    switch_to_block(inout builder, fault_block);
    let fault_arg = rt_k(inout builder, fault);
    let args = vals1(fault_arg);
    rt_call(inout builder, inout module, imports.fault, in args.as_slice());
    ins_trap(inout builder, trap_user(REGION_TRAP));
    switch_to_block(inout builder, ok_block);
}
fn rg_fault_if_zero(
    inout builder: Builder,
    inout module: Module,
    in imports: RegionImports,
    value: Value,
    fault: i64
) eff [Ffi[Cranelift]] {
    let is_zero = ins_icmp_imm(inout builder, cc_eq(), value, 0);
    rg_fault_if(inout builder, inout module, in imports, is_zero, fault);
}

// `vesper_region_fault(message index)`: write, exit.
fn rg_fault_body(
    inout builder: Builder,
    inout module: Module,
    in imports: RegionImports,
    index: Value
) eff [Ffi[Cranelift]] {
    let mut blocks: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..REGION_FAULTS {
        let next = create_block(inout builder);
        let match_block = create_block(inout builder);
        let is_match = ins_icmp_imm(inout builder, cc_eq(), index, widen_i64(i));
        ins_brif0(inout builder, is_match, match_block, next);
        blocks.push(match_block.id);
        switch_to_block(inout builder, next);
    }
    ins_trap(inout builder, trap_user(REGION_TRAP));
    for i in 0..REGION_FAULTS {
        let at = widen_u64(i);
        let block = match blocks.try_get(at) {
            Some(block_id) => Block { id: block_id },
            None => return,
        };
        let data = match imports.messages.try_get(at) {
            Some(data_id) => DataId { id: data_id },
            None => return,
        };
        let len = match imports.lengths.try_get(at) {
            Some(msg_len) => msg_len,
            None => return,
        };
        switch_to_block(inout builder, block);
        let global_value = import_data(inout builder, in module, data);
        let ptr = ins_symbol_value(inout builder, ty_i64(), global_value);
        let fd = rt_k(inout builder, 2);
        let len_value = rt_k(inout builder, len);
        let args = vals3(fd, ptr, len_value);
        rt_call1(inout builder, inout module, imports.write, in args.as_slice());
        let status = rt_k(inout builder, REGION_FAULT_STATUS);
        let status_args = vals1(status);
        rt_call(inout builder, inout module, imports.exit, in status_args.as_slice());
        ins_trap(inout builder, trap_user(REGION_TRAP));
    }
}

fn rg_var(inout builder: Builder, init: Value) -> Var eff [Ffi[Cranelift]] {
    let var = declare_var(inout builder, ty_i64());
    def_var(inout builder, var, init);
    var
}

// Grows the array at `ptr_off`/`len_off`/`cap_off` of `record` so that one
// more `entry_bytes`-byte element fits; returns the array base.
fn rg_reserve(
    inout builder: Builder,
    inout module: Module,
    in imports: RegionImports,
    record: Value,
    ptr_off: i32,
    len_off: i32,
    cap_off: i32,
    entry_bytes: i64
) -> Value eff [Ffi[Cranelift]] {
    let len = rg_ld(inout builder, record, len_off);
    let cap = rg_ld(inout builder, record, cap_off);
    let full = ins_icmp(inout builder, cc_uge(), len, cap);
    let grow = create_block(inout builder);
    let done = create_block(inout builder);
    ins_brif0(inout builder, full, grow, done);
    switch_to_block(inout builder, grow);
    let doubled = ins_ishl_imm(inout builder, cap, 1);
    let sixteen = rt_k(inout builder, 16);
    let new_cap = ins_umax(inout builder, doubled, sixteen);
    let bytes = ins_imul_imm(inout builder, new_cap, entry_bytes);
    let old_base = rg_ld(inout builder, record, ptr_off);
    let args = vals2(old_base, bytes);
    let new_base = rt_call1(inout builder, inout module, imports.realloc, in args.as_slice());
    rg_fault_if_zero(inout builder, inout module, in imports, new_base, F_MEMORY);
    rg_st(inout builder, new_base, record, ptr_off);
    rg_st(inout builder, new_cap, record, cap_off);
    ins_jump0(inout builder, done);
    switch_to_block(inout builder, done);
    rg_ld(inout builder, record, ptr_off)
}

fn rg_open(
    inout builder: Builder,
    inout module: Module,
    in imports: RegionImports,
    capacity: Value
) eff [Ffi[Cranelift]] {
    let size = rt_k(inout builder, R_RECORD);
    let args = vals1(size);
    let rec = rt_call1(inout builder, inout module, imports.malloc, in args.as_slice());
    rg_fault_if_zero(inout builder, inout module, in imports, rec, F_MEMORY);
    let zero = rt_k(inout builder, 0);
    // Every word of the record, offsets 0..R_RECORD step 8.
    for word in 0..10 {
        rg_st(inout builder, zero, rec, wrapping_mul(word, 8));
    }
    rg_st(inout builder, capacity, rec, R_CAP);
    let one = rt_k(inout builder, 1);
    rg_st(inout builder, one, rec, R_SERIAL);
    rg_ret(inout builder, rec);
}

fn rg_close(
    inout builder: Builder,
    inout module: Module,
    in imports: RegionImports,
    record: Value
) eff [Ffi[Cranelift]] {
    for i in 0..3 {
        let off: i32 = if i == 0 {
            R_BASE
        } else if i == 1 {
            R_SLOTS
        } else {
            R_MARKS
        };
        let array = rg_ld(inout builder, record, off);
        let args = vals1(array);
        rt_call(inout builder, inout module, imports.free, in args.as_slice());
    }
    let args = vals1(record);
    rt_call(inout builder, inout module, imports.free, in args.as_slice());
    rg_ret0(inout builder);
}

fn rg_alloc(
    inout builder: Builder,
    inout module: Module,
    in imports: RegionImports,
    record: Value,
    size: Value
) eff [Ffi[Cranelift]] {
    // slot_bytes: round up to whole words, at least one.
    let plus = ins_iadd_imm(inout builder, size, 7);
    let rounded = ins_band_imm(inout builder, plus, -8);
    let eight = rt_k(inout builder, 8);
    let size = ins_umax(inout builder, rounded, eight);
    let slot_count = rg_ld(inout builder, record, R_NSLOTS);
    let exceeded = ins_icmp_imm(inout builder, cc_uge(), slot_count, MAX_ALLOCATIONS);
    rg_fault_if(inout builder, inout module, in imports, exceeded, F_ALLOCATIONS);
    let serial = rg_ld(inout builder, record, R_SERIAL);
    let exceeded = ins_icmp_imm(inout builder, cc_uge(), serial, MAX_SERIAL);
    rg_fault_if(inout builder, inout module, in imports, exceeded, F_ALLOCATIONS);
    let cap = rg_ld(inout builder, record, R_CAP);
    let cursor = rg_ld(inout builder, record, R_CURSOR);
    // Fits when cursor + size <= capacity (both below 2^31, no overflow).
    let end = ins_iadd(inout builder, cursor, size);
    let exceeded = ins_icmp(inout builder, cc_ugt(), end, cap);
    rg_fault_if(inout builder, inout module, in imports, exceeded, F_EXHAUSTED);
    // The chunk is obtained by the first allocation.
    let base = rg_ld(inout builder, record, R_BASE);
    let no_chunk = ins_icmp_imm(inout builder, cc_eq(), base, 0);
    let alloc_block = create_block(inout builder);
    let ready_block = create_block(inout builder);
    ins_brif0(inout builder, no_chunk, alloc_block, ready_block);
    switch_to_block(inout builder, alloc_block);
    let args = vals1(cap);
    let chunk = rt_call1(inout builder, inout module, imports.malloc, in args.as_slice());
    rg_fault_if_zero(inout builder, inout module, in imports, chunk, F_MEMORY);
    rg_st(inout builder, chunk, record, R_BASE);
    ins_jump0(inout builder, ready_block);
    switch_to_block(inout builder, ready_block);
    let slots = rg_reserve(
        inout builder,
        inout module,
        in imports,
        record,
        R_SLOTS,
        R_NSLOTS,
        R_SLOTCAP,
        S_SLOT
    );
    let off = ins_imul_imm(inout builder, slot_count, S_SLOT);
    let entry = ins_iadd(inout builder, slots, off);
    rg_st(inout builder, cursor, entry, S_START);
    rg_st(inout builder, size, entry, S_LEN);
    rg_st(inout builder, cursor, entry, S_PRIOR);
    rg_st(inout builder, serial, entry, S_SERIAL);
    let one = rt_k(inout builder, 1);
    rg_st(inout builder, one, entry, S_LIVE);
    let base = rg_ld(inout builder, record, R_BASE);
    let payload = ins_iadd(inout builder, base, cursor);
    let zero = rt_k(inout builder, 0);
    let args = vals3(payload, zero, size);
    rt_call1(inout builder, inout module, imports.memset, in args.as_slice());
    rg_st(inout builder, end, record, R_CURSOR);
    let new_count = ins_iadd_imm(inout builder, slot_count, 1);
    rg_st(inout builder, new_count, record, R_NSLOTS);
    let next_serial = ins_iadd_imm(inout builder, serial, 1);
    rg_st(inout builder, next_serial, record, R_SERIAL);
    let high = ins_ishl_imm(inout builder, serial, INDEX_BITS);
    let handle = ins_bor(inout builder, high, slot_count);
    rg_ret(inout builder, handle);
}

// `vesper_region_resolve(record, handle)`: the live slot entry or a fault.
fn rg_resolve_body(
    inout builder: Builder,
    inout module: Module,
    in imports: RegionImports,
    record: Value,
    handle: Value
) eff [Ffi[Cranelift]] {
    let index = ins_band_imm(inout builder, handle, INDEX_MASK);
    let serial = ins_ushr_imm(inout builder, handle, INDEX_BITS);
    let slot_count = rg_ld(inout builder, record, R_NSLOTS);
    let stale = ins_icmp(inout builder, cc_uge(), index, slot_count);
    rg_fault_if(inout builder, inout module, in imports, stale, F_STALE);
    let slots = rg_ld(inout builder, record, R_SLOTS);
    let off = ins_imul_imm(inout builder, index, S_SLOT);
    let entry = ins_iadd(inout builder, slots, off);
    let entry_serial = rg_ld(inout builder, entry, S_SERIAL);
    let stale = ins_icmp(inout builder, cc_ne(), entry_serial, serial);
    rg_fault_if(inout builder, inout module, in imports, stale, F_STALE);
    let live = rg_ld(inout builder, entry, S_LIVE);
    rg_fault_if_zero(inout builder, inout module, in imports, live, F_STALE);
    rg_ret(inout builder, entry);
}

// The address of word `index` of the payload `handle`.
fn rg_word(
    inout builder: Builder,
    inout module: Module,
    in imports: RegionImports,
    record: Value,
    handle: Value,
    index: Value
) -> Value eff [Ffi[Cranelift]] {
    let args = vals2(record, handle);
    let entry = rt_call1(inout builder, inout module, imports.resolve, in args.as_slice());
    let len = rg_ld(inout builder, entry, S_LEN);
    let words = ins_ushr_imm(inout builder, len, 3);
    let out_of_bounds = ins_icmp(inout builder, cc_uge(), index, words);
    rg_fault_if(inout builder, inout module, in imports, out_of_bounds, F_BOUNDS);
    let start = rg_ld(inout builder, entry, S_START);
    let base = rg_ld(inout builder, record, R_BASE);
    let at = ins_iadd(inout builder, base, start);
    let off = ins_ishl_imm(inout builder, index, 3);
    ins_iadd(inout builder, at, off)
}

fn rg_load_word(
    inout builder: Builder,
    inout module: Module,
    in imports: RegionImports,
    record: Value,
    handle: Value,
    index: Value
) eff [Ffi[Cranelift]] {
    let at = rg_word(inout builder, inout module, in imports, record, handle, index);
    let word = rg_ld(inout builder, at, 0);
    rg_ret(inout builder, word);
}

fn rg_store_word(
    inout builder: Builder,
    inout module: Module,
    in imports: RegionImports,
    record: Value,
    handle: Value,
    index: Value,
    value: Value
) eff [Ffi[Cranelift]] {
    let at = rg_word(inout builder, inout module, in imports, record, handle, index);
    rg_st(inout builder, value, at, 0);
    rg_ret0(inout builder);
}

fn rg_release(
    inout builder: Builder,
    inout module: Module,
    in imports: RegionImports,
    record: Value,
    handle: Value
) eff [Ffi[Cranelift]] {
    let args = vals2(record, handle);
    let entry = rt_call1(inout builder, inout module, imports.resolve, in args.as_slice());
    let zero = rt_k(inout builder, 0);
    rg_st(inout builder, zero, entry, S_LIVE);
    let reclaim_args = vals1(record);
    rt_call(inout builder, inout module, imports.reclaim, in reclaim_args.as_slice());
    rg_ret0(inout builder);
}

// The `step` closure of `reclaim_body`: leave for `done` when `cond`.
fn rg_step(inout builder: Builder, done: Block, cond: Value) eff [Ffi[Cranelift]] {
    let next = create_block(inout builder);
    ins_brif0(inout builder, cond, done, next);
    switch_to_block(inout builder, next);
}

// `vesper_region_reclaim(record)`: pops moved payloads at the unprotected
// tip so that their bytes are reused.
fn rg_reclaim_body(inout builder: Builder, record: Value) eff [Ffi[Cranelift]] {
    let head = create_block(inout builder);
    let done = create_block(inout builder);
    ins_jump0(inout builder, head);
    switch_to_block(inout builder, head);
    let slot_count = rg_ld(inout builder, record, R_NSLOTS);
    let empty = ins_icmp_imm(inout builder, cc_eq(), slot_count, 0);
    rg_step(inout builder, done, empty);
    let last = ins_iadd_imm(inout builder, slot_count, -1);
    let slots = rg_ld(inout builder, record, R_SLOTS);
    let off = ins_imul_imm(inout builder, last, S_SLOT);
    let entry = ins_iadd(inout builder, slots, off);
    let live = rg_ld(inout builder, entry, S_LIVE);
    let is_live = ins_icmp_imm(inout builder, cc_ne(), live, 0);
    rg_step(inout builder, done, is_live);
    // The newest watermark protects the slots it recorded.
    let mark_count = rg_ld(inout builder, record, R_NMARKS);
    let marks = rg_ld(inout builder, record, R_MARKS);
    let has_mark = ins_icmp_imm(inout builder, cc_ne(), mark_count, 0);
    let with_mark = create_block(inout builder);
    let floor_known = create_block(inout builder);
    append_block_param(inout builder, floor_known, ty_i64());
    let zero = rt_k(inout builder, 0);
    let none = no_vals();
    let zero_args = vals1(zero);
    ins_brif(
        inout builder,
        has_mark,
        with_mark,
        in none.as_slice(),
        floor_known,
        in zero_args.as_slice()
    );
    switch_to_block(inout builder, with_mark);
    let top = ins_iadd_imm(inout builder, mark_count, -1);
    let mark_off = ins_imul_imm(inout builder, top, M_MARK);
    let mark = ins_iadd(inout builder, marks, mark_off);
    let floor_slots = rg_ld(inout builder, mark, M_SLOTS);
    let floor_args = vals1(floor_slots);
    ins_jump(inout builder, floor_known, in floor_args.as_slice());
    switch_to_block(inout builder, floor_known);
    let floor = block_param(inout builder, floor_known, 0);
    let below = ins_icmp(inout builder, cc_ult(), last, floor);
    rg_step(inout builder, done, below);
    let start = rg_ld(inout builder, entry, S_START);
    let len = rg_ld(inout builder, entry, S_LEN);
    let end = ins_iadd(inout builder, start, len);
    let cursor = rg_ld(inout builder, record, R_CURSOR);
    let not_tip = ins_icmp(inout builder, cc_ne(), cursor, end);
    rg_step(inout builder, done, not_tip);
    rg_st(inout builder, last, record, R_NSLOTS);
    let prior = rg_ld(inout builder, entry, S_PRIOR);
    rg_st(inout builder, prior, record, R_CURSOR);
    ins_jump0(inout builder, head);
    switch_to_block(inout builder, done);
    let nothing = no_vals();
    ins_return(inout builder, in nothing.as_slice());
}

fn rg_checkpoint(
    inout builder: Builder,
    inout module: Module,
    in imports: RegionImports,
    record: Value
) eff [Ffi[Cranelift]] {
    let mark_count = rg_ld(inout builder, record, R_NMARKS);
    let too_many = ins_icmp_imm(inout builder, cc_uge(), mark_count, MAX_CHECKPOINTS);
    rg_fault_if(inout builder, inout module, in imports, too_many, F_CHECKPOINTS);
    let marks = rg_reserve(
        inout builder,
        inout module,
        in imports,
        record,
        R_MARKS,
        R_NMARKS,
        R_MARKCAP,
        M_MARK
    );
    let off = ins_imul_imm(inout builder, mark_count, M_MARK);
    let entry = ins_iadd(inout builder, marks, off);
    let serial = rg_ld(inout builder, record, R_SERIAL);
    rg_st(inout builder, serial, entry, M_SERIAL);
    let slot_count = rg_ld(inout builder, record, R_NSLOTS);
    rg_st(inout builder, slot_count, entry, M_SLOTS);
    let cursor = rg_ld(inout builder, record, R_CURSOR);
    rg_st(inout builder, cursor, entry, M_CURSOR);
    let new_mark_count = ins_iadd_imm(inout builder, mark_count, 1);
    rg_st(inout builder, new_mark_count, record, R_NMARKS);
    let next_serial = ins_iadd_imm(inout builder, serial, 1);
    rg_st(inout builder, next_serial, record, R_SERIAL);
    rg_ret(inout builder, serial);
}

// `vesper_region_find_mark(record, serial)`: the newest watermark position
// with that serial, or a fault.
fn rg_find_mark_body(
    inout builder: Builder,
    inout module: Module,
    in imports: RegionImports,
    record: Value,
    serial: Value
) eff [Ffi[Cranelift]] {
    let mark_count = rg_ld(inout builder, record, R_NMARKS);
    let pos_var = rg_var(inout builder, mark_count);
    let head = create_block(inout builder);
    ins_jump0(inout builder, head);
    switch_to_block(inout builder, head);
    let remaining = use_var(inout builder, pos_var);
    rg_fault_if_zero(inout builder, inout module, in imports, remaining, F_STALE);
    let pos = ins_iadd_imm(inout builder, remaining, -1);
    def_var(inout builder, pos_var, pos);
    let marks = rg_ld(inout builder, record, R_MARKS);
    let off = ins_imul_imm(inout builder, pos, M_MARK);
    let entry = ins_iadd(inout builder, marks, off);
    let entry_serial = rg_ld(inout builder, entry, M_SERIAL);
    let hit = ins_icmp(inout builder, cc_eq(), entry_serial, serial);
    let found = create_block(inout builder);
    ins_brif0(inout builder, hit, found, head);
    switch_to_block(inout builder, found);
    rg_ret(inout builder, pos);
}

fn rg_mark_at(inout builder: Builder, record: Value, pos: Value) -> Value eff [Ffi[Cranelift]] {
    let marks = rg_ld(inout builder, record, R_MARKS);
    let off = ins_imul_imm(inout builder, pos, M_MARK);
    ins_iadd(inout builder, marks, off)
}

fn rg_rewind(
    inout builder: Builder,
    inout module: Module,
    in imports: RegionImports,
    record: Value,
    serial: Value
) eff [Ffi[Cranelift]] {
    let args = vals2(record, serial);
    let pos = rt_call1(inout builder, inout module, imports.find_mark, in args.as_slice());
    let entry = rg_mark_at(inout builder, record, pos);
    let slots = rg_ld(inout builder, entry, M_SLOTS);
    let cursor = rg_ld(inout builder, entry, M_CURSOR);
    rg_st(inout builder, pos, record, R_NMARKS);
    rg_st(inout builder, slots, record, R_NSLOTS);
    rg_st(inout builder, cursor, record, R_CURSOR);
    rg_ret0(inout builder);
}

fn rg_commit(
    inout builder: Builder,
    inout module: Module,
    in imports: RegionImports,
    record: Value,
    serial: Value
) eff [Ffi[Cranelift]] {
    let args = vals2(record, serial);
    let pos = rt_call1(inout builder, inout module, imports.find_mark, in args.as_slice());
    let entry = rg_mark_at(inout builder, record, pos);
    let mark_count = rg_ld(inout builder, record, R_NMARKS);
    let after = ins_isub(inout builder, mark_count, pos);
    let after = ins_iadd_imm(inout builder, after, -1);
    let bytes = ins_imul_imm(inout builder, after, M_MARK);
    let next = ins_iadd_imm(inout builder, entry, M_MARK);
    let move_args = vals3(entry, next, bytes);
    rt_call1(inout builder, inout module, imports.memmove, in move_args.as_slice());
    let new_mark_count = ins_iadd_imm(inout builder, mark_count, -1);
    rg_st(inout builder, new_mark_count, record, R_NMARKS);
    let reclaim_args = vals1(record);
    rt_call(inout builder, inout module, imports.reclaim, in reclaim_args.as_slice());
    rg_ret0(inout builder);
}

fn rg_used(inout builder: Builder, record: Value) eff [Ffi[Cranelift]] {
    let used = rg_ld(inout builder, record, R_CURSOR);
    rg_ret(inout builder, used);
}
