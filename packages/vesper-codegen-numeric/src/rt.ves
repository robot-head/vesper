// Shared emission helpers of the generated AOT runtimes (regions.ves,
// tiled.ves, boxes.ves): the `sig`/`import`/`local` closures and the
// `ld`/`st`/`k`/`call` methods of the Rust generators, as functions over
// the module and builder handles of @vesper/cranelift.
//
// Every helper emits exactly the Cranelift calls of its Rust original in
// the same order, so values, blocks, function references and global values
// are numbered as in the Rust lowering.

use @vesper/cranelift::{
    Block,
    DataId,
    FuncId,
    SigId,
    Value,
    append_block_params_for_function_params,
    call_conv_default,
    create_block,
    data_define,
    data_new,
    declare_data,
    declare_function,
    define_data,
    define_function,
    import_function,
    ins_call,
    ins_iconst,
    inst_result,
    linkage_import,
    linkage_local,
    seal_all_blocks,
    seal_block,
    sig_new,
    sig_param,
    sig_return,
    switch_to_block,
    ty_i64,
};

// A signature of `params` `i64` parameters and, with `ret`, one `i64`
// result, in the target's default calling convention (`m.make_signature()`).
pub fn rt_sig(inout module: Module, params: u32, ret: bool) -> SigId eff [Ffi[Cranelift]] {
    let sig = sig_new(inout module, call_conv_default());
    for _ in 0..params {
        sig_param(inout module, sig, ty_i64());
    }
    if ret {
        sig_return(inout module, sig, ty_i64());
    }
    sig
}

fn rt_declare(
    inout module: Module,
    in name: Slice[u8],
    linkage: u32,
    params: u32,
    ret: bool
) -> FuncId eff [Ffi[Cranelift]] {
    let sig = rt_sig(inout module, params, ret);
    declare_function(inout module, in name, linkage, sig)
}

// `declare_function(name, Linkage::Import, sig)`.
pub fn rt_import(
    inout module: Module,
    in name: Slice[u8],
    params: u32,
    ret: bool
) -> FuncId eff [Ffi[Cranelift]] {
    rt_declare(inout module, in name, linkage_import(), params, ret)
}

// `declare_function(name, Linkage::Local, sig)`.
pub fn rt_local(
    inout module: Module,
    in name: Slice[u8],
    params: u32,
    ret: bool
) -> FuncId eff [Ffi[Cranelift]] {
    rt_declare(inout module, in name, linkage_local(), params, ret)
}

// A local, read-only data object holding `bytes`.
pub fn rt_message(
    inout module: Module,
    in name: Slice[u8],
    in bytes: Slice[u8]
) -> Option[DataId] eff [Ffi[Cranelift]] {
    let id = declare_data(inout module, in name, linkage_local(), false);
    let mut data = match data_new() {
        Some(data) => data,
        None => return None,
    };
    data_define(inout data, in bytes);
    if define_data(inout module, id, data) {
        Some(id)
    } else {
        None
    }
}

// `prefix ++ text ++ "\n"`.
pub fn rt_text(in prefix: Str, in text: Str) -> ChunkSeq[u8] {
    let mut line: ChunkSeq[u8] = ChunkSeq::new[u8]();
    line.extend(in prefix.as_bytes());
    line.extend(in text.as_bytes());
    line.push(10);
    line
}

// `name ++ decimal(i)` for a one-digit `i`.
pub fn rt_numbered(in name: Str, i: u32) -> ChunkSeq[u8] {
    let mut bytes: ChunkSeq[u8] = ChunkSeq::new[u8]();
    bytes.extend(in name.as_bytes());
    bytes.push(wrapping_add(48, wrapping_u8(i)));
    bytes
}

pub fn rt_k(inout builder: Builder, value: i64) -> Value eff [Ffi[Cranelift]] {
    ins_iconst(inout builder, ty_i64(), value)
}

// The entry block with the function's parameters, as both Rust generators
// open a body; returns the block. `seal` seals it at once (the tiled
// runtime's `compile`).
pub fn rt_entry(inout builder: Builder, seal: bool) -> Block eff [Ffi[Cranelift]] {
    let entry = create_block(inout builder);
    append_block_params_for_function_params(inout builder, entry);
    switch_to_block(inout builder, entry);
    if seal {
        seal_block(inout builder, entry);
    }
    entry
}

// `declare_func_in_func` then `call`; the call's instruction is the
// builder's last, so `inst_result(inout b, 0)` reads its result.
pub fn rt_call(
    inout builder: Builder,
    inout module: Module,
    func: FuncId,
    in args: Slice[u32]
) eff [Ffi[Cranelift]] {
    let func_ref = import_function(inout builder, inout module, func);
    ins_call(inout builder, func_ref, in args);
}

pub fn rt_call1(
    inout builder: Builder,
    inout module: Module,
    func: FuncId,
    in args: Slice[u32]
) -> Value eff [Ffi[Cranelift]] {
    let func_ref = import_function(inout builder, inout module, func);
    ins_call(inout builder, func_ref, in args);
    inst_result(inout builder, 0)
}

// The value list of 4 arguments (vals1-vals3 cover fewer).
fn vals4(first: Value, second: Value, third: Value, fourth: Value) -> ChunkSeq[u32] {
    let mut values = ChunkSeq::with_capacity[u32](4);
    values.push(first.id);
    values.push(second.id);
    values.push(third.id);
    values.push(fourth.id);
    values
}

pub fn no_vals() -> ChunkSeq[u32] {
    ChunkSeq::new[u32]()
}

// Seal every block and compile the function into `func`.
pub fn rt_finish(
    inout module: Module,
    func: FuncId,
    sink builder: Builder
) -> bool eff [Ffi[Cranelift]] {
    let mut builder = builder;
    seal_all_blocks(inout builder);
    define_function(inout module, func, builder)
}
