// The lane-shape decisions of the vector lowering: src/vector.rs (`Elem`,
// `Shape`, `Profile`, `Conv`, `Intrinsic::lookup` and its properties) and
// the chunk types of src/native_vector.rs (`chunk_type`, `mask_type`,
// `lane_type`), as tables over small codes.
//
// A vector or mask is its packed lane bytes; the native lowering moves it
// as one, two or four 128-bit Cranelift chunks. Types are the shim's codes
// (`lane | log2(lanes) << 8`, @vesper/cranelift).
//
// This file needs no Cranelift handle: tests/self_host_codegen_numeric.rs
// checks it on its own and compares `vector_decisions` with the Rust API.

// Elem, in `Elem::ALL` order.
pub const E_U8: u32 = 0;
const E_U32: u32 = 1;
const E_U64: u32 = 2;
const E_I64: u32 = 3;
pub const E_F32: u32 = 4;
const E_F64: u32 = 5;
pub const ELEMS: u32 = 6;

// `CHUNK_BITS`: every vector lowers as 1, 2 or 4 128-bit chunks.
const CHUNK_BITS: u32 = 128;

// Shim type codes of the lanes.
pub const TY_I8: u32 = 1;
pub const TY_I32: u32 = 3;
pub const TY_I64: u32 = 4;
const TY_F32: u32 = 6;
const TY_F64: u32 = 7;

pub fn elem_name(elem: u32) -> Str {
    if elem == E_U8 {
        "u8"
    } else if elem == E_U32 {
        "u32"
    } else if elem == E_U64 {
        "u64"
    } else if elem == E_I64 {
        "i64"
    } else if elem == E_F32 {
        "f32"
    } else {
        "f64"
    }
}
pub fn elem_bits(elem: u32) -> u32 {
    if elem == E_U8 {
        8
    } else if elem == E_U32 || elem == E_F32 {
        32
    } else {
        64
    }
}
pub fn elem_is_float(elem: u32) -> bool {
    elem == E_F32 || elem == E_F64
}
// The unsigned lane of the same width (`to_bits`/`from_bits`).
pub fn elem_bits_elem(elem: u32) -> u32 {
    if elem == E_F32 {
        E_U32
    } else if elem == E_F64 {
        E_U64
    } else {
        elem
    }
}
pub fn elem_is_signed(elem: u32) -> bool {
    elem == E_I64
}
// All-ones value of one lane, as raw bits.
pub fn elem_mask(elem: u32) -> u64 {
    if elem_bits(elem) == 64 {
        18446744073709551615
    } else {
        wrapping_sub(wrapping_shl_u64(1, elem_bits(elem)), 1)
    }
}

// `lane_type`: the scalar type of one lane.
pub fn lane_ty(elem: u32) -> u32 {
    if elem == E_U8 {
        TY_I8
    } else if elem == E_U32 {
        TY_I32
    } else if elem == E_F32 {
        TY_F32
    } else if elem == E_F64 {
        TY_F64
    } else {
        TY_I64
    }
}
fn log2_lanes(elem: u32) -> u32 {
    // 128 / bits lanes: 16, 4 or 2.
    if elem == E_U8 {
        4
    } else if elem_bits(elem) == 32 {
        2
    } else {
        1
    }
}
// `chunk_type`: `i8x16`, `i32x4`, `i64x2`, `f32x4` or `f64x2`.
pub fn chunk_ty(elem: u32) -> u32 {
    lane_ty(elem) | wrapping_shl_u32(log2_lanes(elem), 8)
}
// `mask_type`: the integer chunk masks of `elem` use.
pub fn mask_chunk_ty(elem: u32) -> u32 {
    if elem == E_F32 {
        chunk_ty(E_U32)
    } else if elem == E_F64 {
        chunk_ty(E_U64)
    } else {
        chunk_ty(elem)
    }
}

// `Shape::new`: a shape of 128, 256 or 512 bits.
pub fn shape_valid(elem: u32, lanes: u32) -> bool {
    let bits = wrapping_mul(elem_bits(elem), lanes);
    bits == 128 || bits == 256 || bits == 512
}
pub fn shape_bits(elem: u32, lanes: u32) -> u32 {
    wrapping_mul(elem_bits(elem), lanes)
}
pub fn shape_bytes(elem: u32, lanes: u32) -> u32 {
    shape_bits(elem, lanes) >> 3
}
pub fn shape_chunks(elem: u32, lanes: u32) -> u32 {
    shape_bits(elem, lanes) >> 7
}
pub fn lanes_per_chunk(elem: u32) -> u32 {
    wrapping_shl_u32(1, log2_lanes(elem))
}
// `layout_words`: the packed lane bytes as eight-byte words.
pub fn shape_layout_words(elem: u32, lanes: u32) -> u32 {
    shape_bytes(elem, lanes) >> 3
}

// Profile, in `Profile::ALL` order.
const P_BASELINE128: u32 = 0;
const P_AVX2: u32 = 1;
const P_AVX512: u32 = 2;
const P_SVE2: u32 = 3;
const P_RVV1: u32 = 4;
const PROFILES: u32 = 5;

pub fn profile_name(profile: u32) -> Str {
    if profile == P_BASELINE128 {
        "Baseline128"
    } else if profile == P_AVX2 {
        "Avx2"
    } else if profile == P_AVX512 {
        "Avx512"
    } else if profile == P_SVE2 {
        "Sve2"
    } else {
        "Rvv1"
    }
}
// `required_profile`: the narrowest profile whose registers hold a shape.
pub fn shape_required_profile(elem: u32, lanes: u32) -> u32 {
    let bits = shape_bits(elem, lanes);
    if bits == 128 {
        P_BASELINE128
    } else if bits == 256 {
        P_AVX2
    } else {
        P_AVX512
    }
}
// The profile lattice: `p ⊑ q`.
pub fn profile_le(p: u32, q: u32) -> bool {
    p == q || p == P_BASELINE128 || (p == P_AVX2 && q == P_AVX512)
}
pub fn profile_fixed_bits(profile: u32) -> u32 {
    if profile == P_AVX2 {
        256
    } else if profile == P_AVX512 {
        512
    } else {
        128
    }
}
// `cranelift_requirements`, written as `arch flag,flag`, or `-` when
// Cranelift 0.125 cannot target the profile.
fn put_requirements(inout out: ChunkSeq[u8], profile: u32) {
    if profile == P_BASELINE128 {
        put(inout out, "any");
    } else if profile == P_AVX2 {
        put(inout out, "x86_64 has_avx2,has_fma");
    } else if profile == P_AVX512 {
        put(inout out, "x86_64 has_avx512f,has_avx512vl");
    } else {
        put(inout out, "-");
    }
}

// Conversions (`Conv`).
const C_TO_BITS: u32 = 0;
const C_FROM_BITS: u32 = 1;
pub const C_WIDEN: u32 = 2;
pub const C_NARROW: u32 = 3;

fn conv_name(conv: u32) -> Str {
    if conv == C_TO_BITS {
        "ToBits"
    } else if conv == C_FROM_BITS {
        "FromBits"
    } else if conv == C_WIDEN {
        "Widen"
    } else {
        "Narrow"
    }
}
pub fn conv_accepts(conv: u32, elem: u32) -> bool {
    if conv == C_TO_BITS {
        elem_is_float(elem)
    } else if conv == C_FROM_BITS {
        elem == E_U32 || elem == E_U64
    } else if conv == C_WIDEN {
        elem == E_F32
    } else {
        elem == E_F64
    }
}
pub fn conv_target(conv: u32, elem: u32) -> u32 {
    if conv == C_TO_BITS {
        elem_bits_elem(elem)
    } else if (conv == C_FROM_BITS && elem == E_U32) || conv == C_NARROW {
        E_F32
    } else {
        E_F64
    }
}

// Intrinsics: a family and an operation within it.
const I_NONE: u32 = 0;
const I_UNKNOWN: u32 = 1;
pub const I_SPLAT: u32 = 2;
pub const I_FROM: u32 = 3;
pub const I_BINARY: u32 = 4;
pub const I_NOT: u32 = 5;
pub const I_UNARY: u32 = 6;
pub const I_MUL_ADD: u32 = 7;
pub const I_CONVERT: u32 = 8;
pub const I_SHIFT: u32 = 9;
pub const I_COMPARE: u32 = 10;
pub const I_SELECT: u32 = 11;
pub const I_MASK_BINARY: u32 = 12;
pub const I_MASK_NOT: u32 = 13;
pub const I_MASK_COUNT: u32 = 14;
pub const I_MASK_BITMASK: u32 = 15;
pub const I_MASK_ANY: u32 = 16;
pub const I_MASK_ALL: u32 = 17;
pub const I_REDUCE: u32 = 18;
pub const I_EXTRACT: u32 = 19;
pub const I_REPLACE: u32 = 20;
pub const I_SHUFFLE: u32 = 21;
pub const I_LOAD_MASKED: u32 = 22;
const I_LOAD: u32 = 23;
const I_STORE: u32 = 24;
const I_STORE_MASKED: u32 = 25;
pub const I_IN_BOUNDS: u32 = 26;
pub const I_ACTIVE: u32 = 27;
const I_ISA_SUPPORTED: u32 = 28;

// BinOp, in declaration order.
pub const B_ADD: u32 = 0;
pub const B_SUB: u32 = 1;
pub const B_MUL: u32 = 2;
pub const B_DIV: u32 = 3;
pub const B_MIN: u32 = 4;
pub const B_MAX: u32 = 5;
pub const B_AND: u32 = 6;
pub const B_OR: u32 = 7;
pub const B_XOR: u32 = 8;
pub const B_SATURATING_ADD: u32 = 9;
pub const B_SATURATING_SUB: u32 = 10;

// ReduceOp, in declaration order.
pub const RD_ADD: u32 = 0;
pub const RD_XOR: u32 = 1;
pub const RD_OR: u32 = 2;
pub const RD_AND: u32 = 3;

// An intrinsic as `family << 8 | op`.
fn intr(family: u32, op: u32) -> u32 {
    wrapping_shl_u32(family, 8) | op
}
pub fn family_of(intrinsic: u32) -> u32 {
    intrinsic >> 8
}
pub fn op_of(intrinsic: u32) -> u32 {
    intrinsic & 255
}

fn bytes_eq(in bytes: Slice[u8], in text: Str) -> bool {
    let text_bytes = text.as_bytes();
    if bytes.len() != text_bytes.len() {
        return false;
    }
    for i in 0..bytes.len() {
        let left = match bytes.try_get(i) {
            Some(v) => v,
            None => return false,
        };
        let right = match text_bytes.try_get(i) {
            Some(v) => v,
            None => return false,
        };
        if left != right {
            return false;
        }
    }
    true
}

// The operations of each namespace, in `Intrinsic::lookup` order: the
// path's last segment and the intrinsic.
const VEC_OPS: u32 = 44;
fn vec_op(op_index: u32) -> Str {
    if op_index == 0 {
        "splat"
    } else if op_index == 1 {
        "from"
    } else if op_index == 2 {
        "add"
    } else if op_index == 3 {
        "sub"
    } else if op_index == 4 {
        "mul"
    } else if op_index == 5 {
        "div"
    } else if op_index == 6 {
        "min"
    } else if op_index == 7 {
        "max"
    } else if op_index == 8 {
        "and"
    } else if op_index == 9 {
        "or"
    } else if op_index == 10 {
        "xor"
    } else if op_index == 11 {
        "saturating_add"
    } else if op_index == 12 {
        "saturating_sub"
    } else if op_index == 13 {
        "not"
    } else if op_index == 14 {
        "sqrt"
    } else if op_index == 15 {
        "abs"
    } else if op_index == 16 {
        "neg"
    } else if op_index == 17 {
        "mul_add"
    } else if op_index == 18 {
        "to_bits"
    } else if op_index == 19 {
        "from_bits"
    } else if op_index == 20 {
        "widen_f64"
    } else if op_index == 21 {
        "nearest_f32"
    } else if op_index == 22 {
        "load"
    } else if op_index == 23 {
        "store"
    } else if op_index == 24 {
        "store_masked"
    } else if op_index == 25 {
        "shl"
    } else if op_index == 26 {
        "shr"
    } else if op_index == 27 {
        "eq"
    } else if op_index == 28 {
        "ne"
    } else if op_index == 29 {
        "lt"
    } else if op_index == 30 {
        "le"
    } else if op_index == 31 {
        "gt"
    } else if op_index == 32 {
        "ge"
    } else if op_index == 33 {
        "select"
    } else if op_index == 34 {
        "reduce_add"
    } else if op_index == 35 {
        "reduce_xor"
    } else if op_index == 36 {
        "reduce_or"
    } else if op_index == 37 {
        "reduce_and"
    } else if op_index == 38 {
        "reduce_min"
    } else if op_index == 39 {
        "reduce_max"
    } else if op_index == 40 {
        "extract"
    } else if op_index == 41 {
        "replace"
    } else if op_index == 42 {
        "shuffle"
    } else {
        "load_masked"
    }
}
fn vec_intrinsic(op_index: u32) -> u32 {
    if op_index == 0 {
        intr(I_SPLAT, 0)
    } else if op_index == 1 {
        intr(I_FROM, 0)
    } else if op_index <= 12 {
        intr(I_BINARY, wrapping_sub(op_index, 2))
    } else if op_index == 13 {
        intr(I_NOT, 0)
    } else if op_index <= 16 {
        intr(I_UNARY, wrapping_sub(op_index, 14))
    } else if op_index == 17 {
        intr(I_MUL_ADD, 0)
    } else if op_index <= 21 {
        intr(I_CONVERT, wrapping_sub(op_index, 18))
    } else if op_index == 22 {
        intr(I_LOAD, 0)
    } else if op_index == 23 {
        intr(I_STORE, 0)
    } else if op_index == 24 {
        intr(I_STORE_MASKED, 0)
    } else if op_index <= 26 {
        intr(I_SHIFT, wrapping_sub(op_index, 25))
    } else if op_index <= 32 {
        intr(I_COMPARE, wrapping_sub(op_index, 27))
    } else if op_index == 33 {
        intr(I_SELECT, 0)
    } else if op_index <= 39 {
        intr(I_REDUCE, wrapping_sub(op_index, 34))
    } else if op_index == 40 {
        intr(I_EXTRACT, 0)
    } else if op_index == 41 {
        intr(I_REPLACE, 0)
    } else if op_index == 42 {
        intr(I_SHUFFLE, 0)
    } else {
        intr(I_LOAD_MASKED, 0)
    }
}
const MASK_OPS: u32 = 10;
fn mask_op(op_index: u32) -> Str {
    if op_index == 0 {
        "and"
    } else if op_index == 1 {
        "or"
    } else if op_index == 2 {
        "xor"
    } else if op_index == 3 {
        "not"
    } else if op_index == 4 {
        "count"
    } else if op_index == 5 {
        "bitmask"
    } else if op_index == 6 {
        "any"
    } else if op_index == 7 {
        "all"
    } else if op_index == 8 {
        "in_bounds"
    } else {
        "active"
    }
}
fn mask_intrinsic(op_index: u32) -> u32 {
    if op_index <= 2 {
        intr(I_MASK_BINARY, op_index)
    } else if op_index <= 7 {
        // not, count, bitmask, any, all
        intr(wrapping_add(I_MASK_NOT, wrapping_sub(op_index, 3)), 0)
    } else if op_index == 8 {
        intr(I_IN_BOUNDS, 0)
    } else {
        intr(I_ACTIVE, 0)
    }
}

// `Intrinsic::lookup`: I_NONE outside the reserved namespaces, I_UNKNOWN
// for an unknown name inside one.
pub fn intrinsic_lookup(in name: Slice[u8]) -> u32 {
    // Split at the first `::`.
    let n = name.len();
    let mut cut: u64 = n;
    if n >= 2 {
        for i in 0..wrapping_sub(n, 1) {
            if cut == n {
                let first_byte = match name.try_get(i) {
                    Some(v) => v,
                    None => 0,
                };
                let second_byte = match name.try_get(wrapping_add(i, 1)) {
                    Some(v) => v,
                    None => 0,
                };
                if first_byte == 58 && second_byte == 58 {
                    cut = i;
                }
            }
        }
    }
    if cut == n {
        return I_NONE;
    }
    let space = name[0..cut];
    let op = name[wrapping_add(cut, 2)..n];
    if bytes_eq(in space, "Vec") {
        for k in 0..VEC_OPS {
            if bytes_eq(in op, vec_op(k)) {
                return vec_intrinsic(k);
            }
        }
        I_UNKNOWN
    } else if bytes_eq(in space, "Mask") {
        for k in 0..MASK_OPS {
            if bytes_eq(in op, mask_op(k)) {
                return mask_intrinsic(k);
            }
        }
        I_UNKNOWN
    } else if bytes_eq(in space, "Isa") {
        if bytes_eq(in op, "supported") {
            intr(I_ISA_SUPPORTED, 0)
        } else {
            I_UNKNOWN
        }
    } else {
        I_NONE
    }
}

fn binop_name(op: u32) -> Str {
    if op == B_ADD {
        "Add"
    } else if op == B_SUB {
        "Sub"
    } else if op == B_MUL {
        "Mul"
    } else if op == B_DIV {
        "Div"
    } else if op == B_MIN {
        "Min"
    } else if op == B_MAX {
        "Max"
    } else if op == B_AND {
        "And"
    } else if op == B_OR {
        "Or"
    } else if op == B_XOR {
        "Xor"
    } else if op == B_SATURATING_ADD {
        "SaturatingAdd"
    } else {
        "SaturatingSub"
    }
}
fn cmp_name(op: u32) -> Str {
    if op == 0 {
        "Eq"
    } else if op == 1 {
        "Ne"
    } else if op == 2 {
        "Lt"
    } else if op == 3 {
        "Le"
    } else if op == 4 {
        "Gt"
    } else {
        "Ge"
    }
}
fn reduce_name(op: u32) -> Str {
    if op == RD_ADD {
        "Add"
    } else if op == RD_XOR {
        "Xor"
    } else if op == RD_OR {
        "Or"
    } else if op == RD_AND {
        "And"
    } else if op == 4 {
        "Min"
    } else {
        "Max"
    }
}

// The intrinsic as Rust's `{:?}` writes it (`Binary(Add)`).
fn put_intrinsic(inout out: ChunkSeq[u8], intrinsic: u32) {
    let family = family_of(intrinsic);
    let op = op_of(intrinsic);
    if family == I_SPLAT {
        put(inout out, "Splat");
    } else if family == I_FROM {
        put(inout out, "From");
    } else if family == I_BINARY {
        put(inout out, "Binary(");
        put(inout out, binop_name(op));
        put(inout out, ")");
    } else if family == I_NOT {
        put(inout out, "Not");
    } else if family == I_UNARY {
        put(inout out, "Unary(");
        put(
            inout out,
            if op == 0 {
                "Sqrt"
            } else if op == 1 {
                "Abs"
            } else {
                "Neg"
            }
        );
        put(inout out, ")");
    } else if family == I_MUL_ADD {
        put(inout out, "MulAdd");
    } else if family == I_CONVERT {
        put(inout out, "Convert(");
        put(inout out, conv_name(op));
        put(inout out, ")");
    } else if family == I_SHIFT {
        put(inout out, if op == 0 { "Shift(Shl)" } else { "Shift(Shr)" });
    } else if family == I_COMPARE {
        put(inout out, "Compare(");
        put(inout out, cmp_name(op));
        put(inout out, ")");
    } else if family == I_SELECT {
        put(inout out, "Select");
    } else if family == I_MASK_BINARY {
        put(
            inout out,
            if op == 0 {
                "MaskBinary(And)"
            } else if op == 1 {
                "MaskBinary(Or)"
            } else {
                "MaskBinary(Xor)"
            }
        );
    } else if family == I_MASK_NOT {
        put(inout out, "MaskNot");
    } else if family == I_MASK_COUNT {
        put(inout out, "MaskCount");
    } else if family == I_MASK_BITMASK {
        put(inout out, "MaskBitmask");
    } else if family == I_MASK_ANY {
        put(inout out, "MaskAny");
    } else if family == I_MASK_ALL {
        put(inout out, "MaskAll");
    } else if family == I_REDUCE {
        put(inout out, "Reduce(");
        put(inout out, reduce_name(op));
        put(inout out, ")");
    } else if family == I_EXTRACT {
        put(inout out, "Extract");
    } else if family == I_REPLACE {
        put(inout out, "Replace");
    } else if family == I_SHUFFLE {
        put(inout out, "Shuffle");
    } else if family == I_LOAD_MASKED {
        put(inout out, "LoadMasked");
    } else if family == I_LOAD {
        put(inout out, "Load");
    } else if family == I_STORE {
        put(inout out, "Store");
    } else if family == I_STORE_MASKED {
        put(inout out, "StoreMasked");
    } else if family == I_IN_BOUNDS {
        put(inout out, "InBounds");
    } else if family == I_ACTIVE {
        put(inout out, "Active");
    } else {
        put(inout out, "IsaSupported");
    }
}

pub fn takes_shape_arguments(intrinsic: u32) -> bool {
    let family = family_of(intrinsic);
    family == I_SPLAT
        || family == I_FROM
        || family == I_LOAD_MASKED
        || family == I_LOAD
        || family == I_IN_BOUNDS
        || family == I_ACTIVE
}
pub fn mask_result(intrinsic: u32) -> bool {
    let family = family_of(intrinsic);
    family == I_COMPARE
        || family == I_MASK_BINARY
        || family == I_MASK_NOT
        || family == I_IN_BOUNDS
        || family == I_ACTIVE
}
pub fn mask_operand(intrinsic: u32) -> bool {
    let family = family_of(intrinsic);
    family == I_SELECT
        || family == I_MASK_BINARY
        || family == I_MASK_NOT
        || family == I_MASK_COUNT
        || family == I_MASK_BITMASK
        || family == I_MASK_ANY
        || family == I_MASK_ALL
}
// `constant_positions(args)` as `start..end`.
pub fn constants_start(intrinsic: u32) -> u64 {
    let family = family_of(intrinsic);
    if family == I_EXTRACT || family == I_REPLACE || family == I_SHUFFLE {
        1
    } else {
        0
    }
}
pub fn constants_end(intrinsic: u32, args: u64) -> u64 {
    let family = family_of(intrinsic);
    if family == I_EXTRACT || family == I_REPLACE {
        2
    } else if family == I_SHUFFLE {
        if args > 1 { args } else { 1 }
    } else {
        0
    }
}

// `lane_error`, or the empty string.
pub fn lane_error(intrinsic: u32, elem: u32) -> Str {
    let family = family_of(intrinsic);
    let op = op_of(intrinsic);
    if family == I_BINARY && op == B_MUL && elem == E_U8 {
        "Vec::mul is not defined for u8 lanes"
    } else if family == I_BINARY && op == B_DIV && !elem_is_float(elem) {
        "Vec::div is defined for f32 and f64 lanes only"
    } else if (family == I_UNARY || family == I_MUL_ADD) && !elem_is_float(elem) {
        "Vec::sqrt, Vec::abs, Vec::neg and Vec::mul_add are defined for f32 and f64 lanes only"
    } else if family == I_CONVERT && !conv_accepts(op, elem) {
        if op == C_TO_BITS {
            "Vec::to_bits takes f32 or f64 lanes"
        } else if op == C_FROM_BITS {
            "Vec::from_bits takes u32 or u64 lanes"
        } else if op == C_WIDEN {
            "Vec::widen_f64 takes f32 lanes"
        } else {
            "Vec::nearest_f32 takes f64 lanes"
        }
    } else if family == I_BINARY
        && (op == B_SATURATING_ADD || op == B_SATURATING_SUB)
        && elem != E_U8
    {
        "saturating lane arithmetic is defined for u8 lanes only"
    } else if elem_is_float(elem)
        && (
            (family == I_BINARY && (op == B_AND || op == B_OR || op == B_XOR))
                || family == I_NOT
                || family == I_SHIFT
                || (family == I_REDUCE && (op == RD_AND || op == RD_OR || op == RD_XOR))
        )
    {
        "bitwise lane operations are not defined for float lanes"
    } else if (family == I_LOAD_MASKED || family == I_IN_BOUNDS) && elem != E_U8 {
        "string loads produce u8 lanes"
    } else {
        ""
    }
}

// ---------------------------------------------------------------------------
// The decision dump: the elements, every (element, lane count) up to 64,
// the profiles, the conversions of every valid shape and, for each line of
// `input` (an intrinsic path), its lookup and properties.

fn put(inout out: ChunkSeq[u8], in text: Str) {
    out.extend(in text.as_bytes());
}
fn put_u64(inout out: ChunkSeq[u8], value: u64) {
    if value >= 10 {
        put_u64(inout out, value / 10);
    }
    out.push(wrapping_add(48, wrapping_u8(value % 10)));
}
fn put_bool(inout out: ChunkSeq[u8], flag: bool) {
    put(inout out, if flag { "1" } else { "0" });
}
fn sp(inout out: ChunkSeq[u8]) {
    out.push(32);
}
fn nl(inout out: ChunkSeq[u8]) {
    out.push(10);
}

pub fn vector_decisions(in input: Str) -> ChunkSeq[u64] {
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for elem in 0..ELEMS {
        put(inout out, "elem ");
        put(inout out, elem_name(elem));
        sp(inout out);
        put_u64(inout out, widen_u64(elem_bits(elem)));
        sp(inout out);
        put_bool(inout out, elem_is_float(elem));
        put_bool(inout out, elem_is_signed(elem));
        sp(inout out);
        put(inout out, elem_name(elem_bits_elem(elem)));
        sp(inout out);
        put_u64(inout out, elem_mask(elem));
        put(inout out, " lane ");
        put_u64(inout out, widen_u64(lane_ty(elem)));
        put(inout out, " chunk ");
        put_u64(inout out, widen_u64(chunk_ty(elem)));
        put(inout out, " mask ");
        put_u64(inout out, widen_u64(mask_chunk_ty(elem)));
        put(inout out, " per ");
        put_u64(inout out, widen_u64(lanes_per_chunk(elem)));
        nl(inout out);
        for lanes in 0..65 {
            if shape_valid(elem, lanes) {
                put(inout out, "shape [");
                put(inout out, elem_name(elem));
                put(inout out, ", ");
                put_u64(inout out, widen_u64(lanes));
                put(inout out, "] ");
                put_u64(inout out, widen_u64(shape_bits(elem, lanes)));
                sp(inout out);
                put_u64(inout out, widen_u64(shape_bytes(elem, lanes)));
                sp(inout out);
                put_u64(inout out, widen_u64(shape_chunks(elem, lanes)));
                sp(inout out);
                put_u64(inout out, widen_u64(shape_layout_words(elem, lanes)));
                sp(inout out);
                put(inout out, profile_name(shape_required_profile(elem, lanes)));
                for conv in 0..4 {
                    sp(inout out);
                    put(inout out, conv_name(conv));
                    put(inout out, "=");
                    let target = conv_target(conv, elem);
                    if shape_valid(target, lanes) {
                        put(inout out, elem_name(target));
                    } else {
                        put(inout out, "-");
                    }
                    if conv_accepts(conv, elem) {
                        put(inout out, "+");
                    }
                }
                nl(inout out);
            }
        }
    }
    for profile in 0..PROFILES {
        put(inout out, "profile ");
        put(inout out, profile_name(profile));
        sp(inout out);
        put_u64(inout out, widen_u64(profile_fixed_bits(profile)));
        sp(inout out);
        for other_profile in 0..PROFILES {
            put_bool(inout out, profile_le(profile, other_profile));
        }
        sp(inout out);
        put_requirements(inout out, profile);
        nl(inout out);
    }
    // One intrinsic path per input line.
    let bytes = input.as_bytes();
    let n = bytes.len();
    let mut start: u64 = 0;
    for i in 0..wrapping_add(n, 1) {
        let at_end = i == n;
        let byte = if at_end {
            10
        } else {
            match bytes.try_get(i) {
                Some(v) => v,
                None => 10,
            }
        };
        if byte == 10 {
            if i > start {
                put_lookup(inout out, in bytes[start..i]);
            }
            start = wrapping_add(i, 1);
        }
    }
    pack(in out)
}

fn put_lookup(inout out: ChunkSeq[u8], in name: Slice[u8]) {
    put(inout out, "intrinsic ");
    out.extend(in name);
    sp(inout out);
    let intrinsic = intrinsic_lookup(in name);
    if intrinsic == I_NONE {
        put(inout out, "none");
    } else if intrinsic == I_UNKNOWN {
        put(inout out, "unknown");
    } else {
        put_intrinsic(inout out, intrinsic);
        sp(inout out);
        put_bool(inout out, takes_shape_arguments(intrinsic));
        put_bool(inout out, mask_result(intrinsic));
        put_bool(inout out, mask_operand(intrinsic));
        for args in 0..4 {
            sp(inout out);
            put_u64(inout out, constants_start(intrinsic));
            put(inout out, "..");
            put_u64(inout out, constants_end(intrinsic, args));
        }
        for elem in 0..ELEMS {
            let err = lane_error(intrinsic, elem);
            if err.len() != 0 {
                put(inout out, " | ");
                put(inout out, elem_name(elem));
                put(inout out, ": ");
                put(inout out, err);
            }
        }
    }
    nl(inout out);
}

// `[len, little-endian words...]`.
fn pack(in text: ChunkSeq[u8]) -> ChunkSeq[u64] {
    let n = text.len();
    let mut out = ChunkSeq::with_capacity[u64](wrapping_add(n >> 3, 2));
    out.push(n);
    let mut word: u64 = 0;
    let mut byte_count: u32 = 0;
    for i in 0..n {
        let byte = match text.try_get(i) {
            Some(v) => widen_u64(v),
            None => 0,
        };
        word = word | wrapping_shl_u64(byte, wrapping_mul(byte_count, 8));
        byte_count = wrapping_add(byte_count, 1);
        if byte_count == 8 {
            out.push(word);
            word = 0;
            byte_count = 0;
        }
    }
    if byte_count != 0 {
        out.push(word);
    }
    out
}
