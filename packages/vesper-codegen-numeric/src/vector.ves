// The `numeric` hook's vector family: `Codegen::vector_op` of
// src/native_vector.rs, emitted through the lent Cranelift builder
// (self-hosting SH4 lane 11, #1285, part 2).
//
// A vector or mask is a pointer to its packed lane bytes. Each operation
// loads it as one, two or four 128-bit chunks, computes chunk by chunk and
// stores the result into a fresh stack slot, emitting exactly the
// Cranelift calls of the Rust function in the same order.
//
// `Codegen::vector_op` sends one request per operation (see
// `codegen_swap::numeric`); this file reads it and never consults the IR.

use @vesper/cranelift::codes::{
    Bin,
    BinImm,
    Cv,
    FloatCc,
    IntCc,
    MemFlag,
    Ternary,
    TyCode,
    Un,
};
use @vesper/cranelift::{
    Ty,
    Value,
    call_arg,
    call_arg_count,
    call_builder,
    call_module,
    call_op,
    call_result_value,
    call_return_builder,
    call_return_module,
    create_block,
    create_stack_slot,
    ins_binary,
    ins_binary_imm,
    ins_bitselect,
    ins_brif0,
    ins_convert,
    ins_extractlane,
    ins_fcmp,
    ins_icmp,
    ins_icmp_imm,
    ins_iconst,
    ins_insertlane,
    ins_jump0,
    ins_load,
    ins_select,
    ins_shuffle,
    ins_stack_addr,
    ins_store,
    ins_uload8,
    ins_unary,
    ins_vconst,
    module_pointer_type,
    switch_to_block,
    value_of_word,
};
use self::atomic_ops::{
    atomic_known,
    atomic_request,
};
use self::boxes::{
    define_box_runtime,
};
use self::region_ops::{
    NUM_REGION,
    region_known,
    region_request,
};
use self::regions::{
    define_region_runtime,
};
use self::tiled::{
    define_tiled_runtime,
};
use self::floats::{
    float_known,
    float_request,
};
use self::shapes::{
    B_ADD,
    B_AND,
    B_DIV,
    B_MAX,
    B_MIN,
    B_MUL,
    B_OR,
    B_SATURATING_ADD,
    B_SATURATING_SUB,
    B_SUB,
    B_XOR,
    C_NARROW,
    C_WIDEN,
    ELEMS,
    E_F32,
    E_U8,
    I_ACTIVE,
    I_BINARY,
    I_COMPARE,
    I_CONVERT,
    I_EXTRACT,
    I_FROM,
    I_IN_BOUNDS,
    I_LOAD_MASKED,
    I_MASK_ALL,
    I_MASK_ANY,
    I_MASK_BINARY,
    I_MASK_BITMASK,
    I_MASK_COUNT,
    I_MASK_NOT,
    I_MUL_ADD,
    I_NOT,
    I_REDUCE,
    I_REPLACE,
    I_SELECT,
    I_SHIFT,
    I_SHUFFLE,
    I_SPLAT,
    I_UNARY,
    RD_ADD,
    RD_AND,
    RD_OR,
    RD_XOR,
    chunk_ty,
    conv_accepts,
    conv_target,
    elem_bits,
    elem_bits_elem,
    elem_is_float,
    elem_is_signed,
    elem_mask,
    family_of,
    lane_ty,
    lanes_per_chunk,
    mask_chunk_ty,
    op_of,
    shape_bytes,
    shape_chunks,
    shape_valid,
};
use self::tiled_ops::{
    NUM_TILED,
    tiled_known,
    tiled_request,
};

// `codegen_swap::numeric::VECTOR`, `ISA_SUPPORTED`, and `RUNTIME`.
pub const NUM_VECTOR: u32 = 2;
pub const NUM_ISA_SUPPORTED: u32 = 3;
pub const NUM_RUNTIME: u32 = 14;
const RT_KIND_REGIONS: u64 = 1;
const RT_KIND_TILED: u64 = 2;
const RT_KIND_BOX_ALLOC: u64 = 3;
const RT_KIND_BOX_FREE: u64 = 4;

// Argument words of NUM_VECTOR: the intrinsic (`family << 8 | op`), the
// element, the lane count, the number of literal constants, the constants,
// then the operand values.
const VA_INTRINSIC: u64 = 0;
const VA_ELEM: u64 = 1;
const VA_LANES: u64 = 2;
const VA_CONSTANTS: u64 = 3;
const VA_FIRST_CONSTANT: u64 = 4;

pub const HOOK_HANDLED: u64 = 1;
pub const HOOK_DECLINED: u64 = 0;

// Memory flags: `MemFlags::new()` and `little()`.
const MF_PLAIN: u32 = 0;
// Stack slots are aligned to 1 << 3.
const SLOT_ALIGN_SHIFT: u32 = 3;
const CHUNK_BYTES: u32 = 16;

// Shim op codes (crates/vesper-cranelift-sys/src/codes.rs).

// `ShiftOp`, `UnaryOp`, `MaskOp` and the remaining `CmpOp`/`ReduceOp` codes
// (the others are in shapes.ves).
const SH_SHL: u32 = 0;
const UO_SQRT: u32 = 0;
const UO_ABS: u32 = 1;
const MO_AND: u32 = 0;
const MO_OR: u32 = 1;
const CM_EQ: u32 = 0;
const CM_NE: u32 = 1;
const CM_LT: u32 = 2;
const CM_LE: u32 = 3;
const CM_GT: u32 = 4;
const RD_MIN: u32 = 4;
const ALL_LANES_64: u32 = 64;

fn vty(code: u32) -> Ty {
    Ty { code: code }
}
fn vx_i64() -> Ty {
    vty(TyCode::I64)
}

// ---------------------------------------------------------------------------
// The request.

fn vx_arg(call: u64, i: u64) -> u64 eff [Ffi[Cranelift]] {
    call_arg(call, i)
}
fn vx_constant_count(call: u64) -> u64 eff [Ffi[Cranelift]] {
    vx_arg(call, VA_CONSTANTS)
}
fn vx_constant(call: u64, i: u64) -> u32 eff [Ffi[Cranelift]] {
    wrapping_u32(vx_arg(call, wrapping_add(VA_FIRST_CONSTANT, i)))
}
fn vx_first_operand(call: u64) -> u64 eff [Ffi[Cranelift]] {
    wrapping_add(VA_FIRST_CONSTANT, vx_constant_count(call))
}
fn vx_operand_count(call: u64) -> u64 eff [Ffi[Cranelift]] {
    wrapping_sub(call_arg_count(call), vx_first_operand(call))
}
fn vx_operand(call: u64, i: u64) -> Value eff [Ffi[Cranelift]] {
    value_of_word(vx_arg(call, wrapping_add(vx_first_operand(call), i)))
}

// ---------------------------------------------------------------------------
// The helpers of src/native_vector.rs.

// `alloc_uninit` (no zeroing) and `alloc` (zeroed word by word).
fn vx_alloc(
    inout builder: Builder,
    in module: Module,
    size: u32,
    zeroed: bool
) -> Value eff [Ffi[Cranelift]] {
    let bytes = if size < 8 { 8 } else { size };
    let slot = create_stack_slot(inout builder, bytes, SLOT_ALIGN_SHIFT);
    let ptr = ins_stack_addr(inout builder, module_pointer_type(in module), slot, 0);
    if zeroed {
        for i in 0..(widen_u64(bytes) >> 3) {
            let zero = ins_iconst(inout builder, vx_i64(), 0);
            ins_store(inout builder, MF_PLAIN, zero, ptr, wrapping_i32(wrapping_mul(i, 8)));
        }
    }
    ptr
}

// `k / per` and `k % per` for a lanes-per-chunk count (a power of two).
fn vx_div(k: u64, per: u64) -> u64 {
    if per == 16 {
        k >> 4
    } else if per == 4 {
        k >> 2
    } else if per == 2 {
        k >> 1
    } else {
        k
    }
}
fn vx_rem(k: u64, per: u64) -> u64 {
    k & wrapping_sub(per, 1)
}

fn vx_chunk_offset(chunk_index: u64) -> i32 {
    wrapping_i32(wrapping_mul(chunk_index, 16))
}

fn vx_bitcast(inout builder: Builder, ty: u32, value: Value) -> Value eff [Ffi[Cranelift]] {
    ins_convert(inout builder, Cv::BitcastLe, vty(ty), value)
}

fn vx_zero_chunk(inout builder: Builder, ty: u32) -> Value eff [Ffi[Cranelift]] {
    let mut zeros: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](16);
    for _ in 0..16 {
        zeros.push(0);
    }
    ins_vconst(inout builder, vty(ty), in zeros.as_slice())
}

fn vx_load_chunks(
    inout builder: Builder,
    ptr: Value,
    elem: u32,
    lanes: u32,
    mask: bool
) -> ChunkSeq[u32] eff [Ffi[Cranelift]] {
    let ty = if mask {
        mask_chunk_ty(elem)
    } else {
        chunk_ty(elem)
    };
    let chunk_count = widen_u64(shape_chunks(elem, lanes));
    let mut out = ChunkSeq::with_capacity[u32](chunk_count);
    for chunk_index in 0..chunk_count {
        let chunk = ins_load(
            inout builder,
            vty(ty),
            MemFlag::LittleEndian,
            ptr,
            vx_chunk_offset(chunk_index)
        );
        out.push(chunk.id);
    }
    out
}

fn vx_store_chunks(
    inout builder: Builder,
    in module: Module,
    elem: u32,
    lanes: u32,
    in chunks: Slice[u32]
) -> Value eff [Ffi[Cranelift]] {
    // The chunks write every byte of the vector.
    let ptr = vx_alloc(inout builder, in module, shape_bytes(elem, lanes), false);
    for chunk_index in 0..chunks.len() {
        let chunk = match chunks.try_get(chunk_index) {
            Some(chunk_id) => chunk_id,
            None => 0,
        };
        ins_store(
            inout builder,
            MemFlag::LittleEndian,
            value_of_word(widen_u64(chunk)),
            ptr,
            vx_chunk_offset(chunk_index)
        );
    }
    ptr
}

fn vx_chunk(in chunks: Slice[u32], index: u64) -> Value {
    match chunks.try_get(index) {
        Some(id) => Value { id: id },
        None => Value { id: 0 },
    }
}

// A backend scalar (`i64` or a float) as one lane, and back.
fn vx_lane_of(inout builder: Builder, scalar: Value, elem: u32) -> Value eff [Ffi[Cranelift]] {
    let lane_type = lane_ty(elem);
    if lane_type == TyCode::I8 || lane_type == TyCode::I32 {
        ins_convert(inout builder, Cv::Ireduce, vty(lane_type), scalar)
    } else {
        scalar
    }
}
fn vx_scalar_of(inout builder: Builder, lane: Value, elem: u32) -> Value eff [Ffi[Cranelift]] {
    let lane_type = lane_ty(elem);
    if lane_type == TyCode::I8 || lane_type == TyCode::I32 {
        ins_convert(inout builder, Cv::Uextend, vx_i64(), lane)
    } else {
        lane
    }
}

fn vx_less(elem: u32) -> u32 {
    if elem_is_signed(elem) {
        IntCc::Slt
    } else {
        IntCc::Ult
    }
}

fn vx_binary_chunk(
    inout builder: Builder,
    op: u32,
    elem: u32,
    lhs: Value,
    rhs: Value
) -> Value eff [Ffi[Cranelift]] {
    if elem_is_float(elem) {
        return if op == B_ADD {
            ins_binary(inout builder, Bin::Fadd, lhs, rhs)
        } else if op == B_SUB {
            ins_binary(inout builder, Bin::Fsub, lhs, rhs)
        } else if op == B_MUL {
            ins_binary(inout builder, Bin::Fmul, lhs, rhs)
        } else if op == B_DIV {
            ins_binary(inout builder, Bin::Fdiv, lhs, rhs)
        } else if op == B_MIN {
            ins_binary(inout builder, Bin::Fmin, lhs, rhs)
        } else if op == B_MAX {
            ins_binary(inout builder, Bin::Fmax, lhs, rhs)
        } else {
            // Rejected by the checker.
            lhs
        };
    }
    if op == B_ADD {
        ins_binary(inout builder, Bin::Iadd, lhs, rhs)
    } else if op == B_SUB {
        ins_binary(inout builder, Bin::Isub, lhs, rhs)
    } else if op == B_MUL {
        ins_binary(inout builder, Bin::Imul, lhs, rhs)
    } else if op == B_MIN {
        let pick_rhs = ins_icmp(inout builder, vx_less(elem), rhs, lhs);
        ins_bitselect(inout builder, pick_rhs, rhs, lhs)
    } else if op == B_MAX {
        let pick_rhs = ins_icmp(inout builder, vx_less(elem), lhs, rhs);
        ins_bitselect(inout builder, pick_rhs, rhs, lhs)
    } else if op == B_AND {
        ins_binary(inout builder, Bin::Band, lhs, rhs)
    } else if op == B_OR {
        ins_binary(inout builder, Bin::Bor, lhs, rhs)
    } else if op == B_XOR {
        ins_binary(inout builder, Bin::Bxor, lhs, rhs)
    } else if op == B_SATURATING_ADD {
        ins_binary(inout builder, Bin::UaddSat, lhs, rhs)
    } else if op == B_SATURATING_SUB {
        ins_binary(inout builder, Bin::UsubSat, lhs, rhs)
    } else {
        // `Div`: rejected by the checker.
        lhs
    }
}

fn vx_int_cc(op: u32, signed: bool) -> u32 {
    if op == CM_EQ {
        IntCc::Eq
    } else if op == CM_NE {
        IntCc::Ne
    } else if signed {
        if op == CM_LT {
            IntCc::Slt
        } else if op == CM_LE {
            IntCc::Sle
        } else if op == CM_GT {
            IntCc::Sgt
        } else {
            IntCc::Sge
        }
    } else if op == CM_LT {
        IntCc::Ult
    } else if op == CM_LE {
        IntCc::Ule
    } else if op == CM_GT {
        IntCc::Ugt
    } else {
        IntCc::Uge
    }
}
fn vx_float_cc(op: u32) -> u32 {
    if op == CM_EQ {
        FloatCc::Eq
    } else if op == CM_NE {
        FloatCc::Ne
    } else if op == CM_LT {
        FloatCc::Lt
    } else if op == CM_LE {
        FloatCc::Le
    } else if op == CM_GT {
        FloatCc::Gt
    } else {
        FloatCc::Ge
    }
}

fn vx_reduce_step(
    inout builder: Builder,
    op: u32,
    elem: u32,
    acc: Value,
    lane: Value
) -> Value eff [Ffi[Cranelift]] {
    if elem_is_float(elem) {
        return if op == RD_MIN {
            ins_binary(inout builder, Bin::Fmin, acc, lane)
        } else if op == wrapping_add(RD_MIN, 1) {
            ins_binary(inout builder, Bin::Fmax, acc, lane)
        } else {
            ins_binary(inout builder, Bin::Fadd, acc, lane)
        };
    }
    let reduced = if op == RD_ADD {
        ins_binary(inout builder, Bin::Iadd, acc, lane)
    } else if op == RD_XOR {
        ins_binary(inout builder, Bin::Bxor, acc, lane)
    } else if op == RD_OR {
        ins_binary(inout builder, Bin::Bor, acc, lane)
    } else if op == RD_AND {
        ins_binary(inout builder, Bin::Band, acc, lane)
    } else {
        let take_lane = if op == RD_MIN {
            ins_icmp(inout builder, vx_less(elem), lane, acc)
        } else {
            ins_icmp(inout builder, vx_less(elem), acc, lane)
        };
        ins_select(inout builder, take_lane, lane, acc)
    };
    if elem_bits(elem) < 64 {
        ins_binary_imm(inout builder, BinImm::BandImm, reduced, wrapping_i64(elem_mask(elem)))
    } else {
        reduced
    }
}

// Lane `i` of the mask at `ptr` as bit `i` of an `i64`.
fn vx_bitmask(
    inout builder: Builder,
    ptr: Value,
    elem: u32,
    lanes: u32
) -> Value eff [Ffi[Cranelift]] {
    let chunks = vx_load_chunks(inout builder, ptr, elem, lanes, true);
    let per = widen_u64(lanes_per_chunk(elem));
    let mut acc = ins_iconst(inout builder, vx_i64(), 0);
    for chunk_index in 0..chunks.len() {
        let bits = ins_convert(
            inout builder,
            Cv::VhighBits,
            vx_i64(),
            vx_chunk(in chunks.as_slice(), chunk_index)
        );
        let shifted = if chunk_index == 0 {
            bits
        } else {
            ins_binary_imm(
                inout builder,
                BinImm::IshlImm,
                bits,
                wrapping_i64(wrapping_mul(per, chunk_index))
            )
        };
        acc = ins_binary(inout builder, Bin::Bor, acc, shifted);
    }
    acc
}

// Lanes available from `offset` below `len`: `len - offset`, or 0.
fn vx_available(inout builder: Builder, offset: Value, len: Value) -> Value eff [Ffi[Cranelift]] {
    let inside = ins_icmp(inout builder, IntCc::Ult, offset, len);
    let rest = ins_binary(inout builder, Bin::Isub, len, offset);
    let zero = ins_iconst(inout builder, vx_i64(), 0);
    ins_select(inout builder, inside, rest, zero)
}

// The mask of lanes `i` with `offset + i < len`.
fn vx_active(
    inout builder: Builder,
    in module: Module,
    offset: Value,
    len: Value,
    elem: u32,
    lanes: u32
) -> Value eff [Ffi[Cranelift]] {
    let available = vx_available(inout builder, offset, len);
    // Clamp to the lane count so the bound fits every lane type.
    let lane_count = ins_iconst(inout builder, vx_i64(), widen_i64(lanes));
    let small = ins_icmp(inout builder, IntCc::Ult, available, lane_count);
    let bound = ins_select(inout builder, small, available, lane_count);
    let ty = mask_chunk_ty(elem);
    let lane_code = ty & 255;
    let lane = if lane_code == TyCode::I8 || lane_code == TyCode::I32 {
        ins_convert(inout builder, Cv::Ireduce, vty(lane_code), bound)
    } else {
        bound
    };
    let bounds = ins_convert(inout builder, Cv::Splat, vty(ty), lane);
    let width = widen_u64(elem_bits(elem_bits_elem(elem)) >> 3);
    let per = widen_u64(lanes_per_chunk(elem));
    let n_chunks = widen_u64(shape_chunks(elem, lanes));
    let mut chunks = ChunkSeq::with_capacity[u32](n_chunks);
    for chunk_index in 0..n_chunks {
        let mut bytes: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](16);
        for j in 0..per {
            let i = wrapping_add(wrapping_mul(chunk_index, per), j);
            for byte in 0..width {
                bytes.push(wrapping_u8(wrapping_shr_u64(i, wrapping_u32(wrapping_mul(byte, 8)))));
            }
        }
        let iota = ins_vconst(inout builder, vty(ty), in bytes.as_slice());
        let cmp = ins_icmp(inout builder, IntCc::Ugt, bounds, iota);
        chunks.push(cmp.id);
    }
    vx_store_chunks(inout builder, in module, elem, lanes, in chunks.as_slice())
}

// `Vec::load_masked[u8, N](s, offset)`.
fn vx_load_masked(
    inout builder: Builder,
    in module: Module,
    string: Value,
    offset: Value,
    elem: u32,
    lanes: u32
) -> Value eff [Ffi[Cranelift]] {
    let result = vx_alloc(inout builder, in module, shape_bytes(elem, lanes), true);
    let len = ins_load(inout builder, vx_i64(), MF_PLAIN, string, 0);
    let available = vx_available(inout builder, offset, len);
    let full = ins_icmp_imm(inout builder, IntCc::Uge, available, widen_i64(lanes));
    let base = ins_load(inout builder, vx_i64(), MF_PLAIN, string, 16);
    let fast = create_block(inout builder);
    let slow = create_block(inout builder);
    let join = create_block(inout builder);
    ins_brif0(inout builder, full, fast, slow);
    switch_to_block(inout builder, fast);
    let start = ins_binary(inout builder, Bin::Iadd, base, offset);
    for chunk_index in 0..widen_u64(shape_chunks(elem, lanes)) {
        let chunk = ins_load(
            inout builder,
            vty(chunk_ty(E_U8)),
            MemFlag::LittleEndian,
            start,
            vx_chunk_offset(chunk_index)
        );
        ins_store(
            inout builder,
            MemFlag::LittleEndian,
            chunk,
            result,
            vx_chunk_offset(chunk_index)
        );
    }
    ins_jump0(inout builder, join);
    switch_to_block(inout builder, slow);
    let zero = ins_iconst(inout builder, vx_i64(), 0);
    for i in 0..widen_u64(lanes) {
        let valid = ins_icmp_imm(inout builder, IntCc::Ugt, available, wrapping_i64(i));
        let at = ins_binary_imm(inout builder, BinImm::IaddImm, offset, wrapping_i64(i));
        // A lane past the end reads the (zeroed) result buffer instead: the
        // data of an empty string is null.
        let address = ins_binary(inout builder, Bin::Iadd, base, at);
        let address = ins_select(inout builder, valid, address, result);
        let byte = ins_uload8(inout builder, vx_i64(), MF_PLAIN, address, 0);
        let byte = ins_select(inout builder, valid, byte, zero);
        let byte = ins_convert(inout builder, Cv::Ireduce, vty(TyCode::I8), byte);
        ins_store(inout builder, MF_PLAIN, byte, result, wrapping_i32(i));
    }
    ins_jump0(inout builder, join);
    switch_to_block(inout builder, join);
    result
}

// ---------------------------------------------------------------------------
// One operation.

// Whether the request can be emitted without an error of the Rust code
// (which then reports it): operand and constant counts, lane indices.
fn vx_well_formed(call: u64, intrinsic: u32, elem: u32, lanes: u32) -> bool eff [Ffi[Cranelift]] {
    let family = family_of(intrinsic);
    let wide = widen_u64(lanes);
    let needs = if family == I_SPLAT
        || family == I_NOT
        || family == I_UNARY
        || family == I_CONVERT
        || family == I_MASK_NOT
        || family == I_MASK_COUNT
        || family == I_MASK_BITMASK
        || family == I_MASK_ANY
        || family == I_MASK_ALL
        || family == I_REDUCE
        || family == I_EXTRACT
        || family == I_SHUFFLE
    {
        1
    } else if family == I_BINARY
        || family == I_SHIFT
        || family == I_COMPARE
        || family == I_MASK_BINARY
        || family == I_REPLACE
        || family == I_LOAD_MASKED
        || family == I_IN_BOUNDS
        || family == I_ACTIVE
    {
        2
    } else if family == I_MUL_ADD || family == I_SELECT {
        3
    } else if family == I_FROM {
        wide
    } else {
        // Slice I/O and `Isa::supported` are not lanes operations here.
        return false;
    };
    if vx_operand_count(call) < needs {
        return false;
    }
    if family == I_FROM && vx_operand_count(call) != wide {
        return false;
    }
    if family == I_CONVERT {
        let conv = op_of(intrinsic);
        if !conv_accepts(conv, elem) {
            return false;
        }
    }
    let constants = vx_constant_count(call);
    if family == I_SHUFFLE && constants != wide {
        return false;
    }
    if family == I_EXTRACT || family == I_REPLACE {
        if constants < 1 {
            return false;
        }
    }
    for k in 0..constants {
        if widen_u64(vx_constant(call, k)) >= wide {
            return false;
        }
    }
    shape_valid(elem, lanes)
}

// Emit the operation and answer its value.
fn vx_emit(
    call: u64,
    inout builder: Builder,
    in module: Module,
    intrinsic: u32,
    elem: u32,
    lanes: u32
) -> Value eff [Ffi[Cranelift]] {
    let family = family_of(intrinsic);
    let sub_op = op_of(intrinsic);
    let per = widen_u64(lanes_per_chunk(elem));
    let n_chunks = widen_u64(shape_chunks(elem, lanes));
    if family == I_SPLAT {
        let lane = vx_lane_of(inout builder, vx_operand(call, 0), elem);
        let chunk = ins_convert(inout builder, Cv::Splat, vty(chunk_ty(elem)), lane);
        let mut chunks = ChunkSeq::with_capacity[u32](n_chunks);
        for _ in 0..n_chunks {
            chunks.push(chunk.id);
        }
        return vx_store_chunks(inout builder, in module, elem, lanes, in chunks.as_slice());
    }
    if family == I_FROM {
        // `vec![zero; chunks]`: one constant, cloned.
        let zero = vx_zero_chunk(inout builder, chunk_ty(elem));
        let mut chunks = ChunkSeq::with_capacity[u32](n_chunks);
        for _ in 0..n_chunks {
            chunks.push(zero.id);
        }
        for lane_index in 0..widen_u64(lanes) {
            let lane = vx_lane_of(inout builder, vx_operand(call, lane_index), elem);
            let chunk_index = vx_div(lane_index, per);
            let into = vx_chunk(in chunks.as_slice(), chunk_index);
            let result = ins_insertlane(
                inout builder,
                into,
                lane,
                wrapping_u32(vx_rem(lane_index, per))
            );
            let _set = chunks.try_set(chunk_index, result.id);
        }
        return vx_store_chunks(inout builder, in module, elem, lanes, in chunks.as_slice());
    }
    if family == I_BINARY || family == I_COMPARE || family == I_MASK_BINARY {
        let mask = family == I_MASK_BINARY;
        let first_chunks = vx_load_chunks(inout builder, vx_operand(call, 0), elem, lanes, mask);
        let second_chunks = vx_load_chunks(inout builder, vx_operand(call, 1), elem, lanes, mask);
        let mut out = ChunkSeq::with_capacity[u32](n_chunks);
        for chunk_index in 0..n_chunks {
            let x = vx_chunk(in first_chunks.as_slice(), chunk_index);
            let y = vx_chunk(in second_chunks.as_slice(), chunk_index);
            let result = if family == I_BINARY {
                vx_binary_chunk(inout builder, sub_op, elem, x, y)
            } else if family == I_COMPARE {
                if elem_is_float(elem) {
                    ins_fcmp(inout builder, vx_float_cc(sub_op), x, y)
                } else {
                    ins_icmp(inout builder, vx_int_cc(sub_op, elem_is_signed(elem)), x, y)
                }
            } else if sub_op == MO_AND {
                ins_binary(inout builder, Bin::Band, x, y)
            } else if sub_op == MO_OR {
                ins_binary(inout builder, Bin::Bor, x, y)
            } else {
                ins_binary(inout builder, Bin::Bxor, x, y)
            };
            out.push(result.id);
        }
        return vx_store_chunks(inout builder, in module, elem, lanes, in out.as_slice());
    }
    if family == I_NOT || family == I_MASK_NOT || family == I_UNARY {
        let first_chunks = vx_load_chunks(
            inout builder,
            vx_operand(call, 0),
            elem,
            lanes,
            family == I_MASK_NOT
        );
        let mut out = ChunkSeq::with_capacity[u32](n_chunks);
        for chunk_index in 0..n_chunks {
            let x = vx_chunk(in first_chunks.as_slice(), chunk_index);
            let op = if family != I_UNARY {
                Un::Bnot
            } else if sub_op == UO_SQRT {
                Un::Sqrt
            } else if sub_op == UO_ABS {
                Un::Fabs
            } else {
                Un::Fneg
            };
            let result = ins_unary(inout builder, op, x);
            out.push(result.id);
        }
        return vx_store_chunks(inout builder, in module, elem, lanes, in out.as_slice());
    }
    if family == I_MUL_ADD {
        let first_chunks = vx_load_chunks(inout builder, vx_operand(call, 0), elem, lanes, false);
        let second_chunks = vx_load_chunks(inout builder, vx_operand(call, 1), elem, lanes, false);
        let third_chunks = vx_load_chunks(inout builder, vx_operand(call, 2), elem, lanes, false);
        let mut out = ChunkSeq::with_capacity[u32](n_chunks);
        for chunk_index in 0..n_chunks {
            let x = vx_chunk(in first_chunks.as_slice(), chunk_index);
            let y = vx_chunk(in second_chunks.as_slice(), chunk_index);
            let z = vx_chunk(in third_chunks.as_slice(), chunk_index);
            let result = Value {
                id: Cranelift::vcl_ternary(inout builder, Ternary::Fma, x.id, y.id, z.id)
            };
            out.push(result.id);
        }
        return vx_store_chunks(inout builder, in module, elem, lanes, in out.as_slice());
    }
    if family == I_CONVERT {
        let target = conv_target(sub_op, elem);
        let first_chunks = vx_load_chunks(inout builder, vx_operand(call, 0), elem, lanes, false);
        let mut out = ChunkSeq::with_capacity[u32](wrapping_mul(n_chunks, 2));
        if sub_op == C_WIDEN {
            // Each f32x4 chunk widens to two f64x2 chunks: its low half,
            // then its high half moved down.
            let mut upper: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](16);
            for _ in 0..2 {
                for j in 8..16 {
                    upper.push(wrapping_u8(j));
                }
            }
            for chunk_index in 0..n_chunks {
                let x = vx_chunk(in first_chunks.as_slice(), chunk_index);
                let low = ins_unary(inout builder, Un::FvpromoteLow, x);
                out.push(low.id);
                let bytes = vx_bitcast(inout builder, chunk_ty(E_U8), x);
                let moved = ins_shuffle(inout builder, bytes, bytes, in upper.as_slice());
                let moved = vx_bitcast(inout builder, chunk_ty(E_F32), moved);
                let high = ins_unary(inout builder, Un::FvpromoteLow, moved);
                out.push(high.id);
            }
        } else if sub_op == C_NARROW {
            // Two f64x2 chunks narrow to one f32x4 chunk.
            let mut joined: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](16);
            for j in 0..8 {
                joined.push(wrapping_u8(j));
            }
            for j in 16..24 {
                joined.push(wrapping_u8(j));
            }
            for chunk_index in 0..(n_chunks >> 1) {
                let lo = ins_unary(
                    inout builder,
                    Un::Fvdemote,
                    vx_chunk(in first_chunks.as_slice(), wrapping_mul(chunk_index, 2))
                );
                let hi = ins_unary(
                    inout builder,
                    Un::Fvdemote,
                    vx_chunk(
                        in first_chunks.as_slice(),
                        wrapping_add(wrapping_mul(chunk_index, 2), 1)
                    )
                );
                let lo = vx_bitcast(inout builder, chunk_ty(E_U8), lo);
                let hi = vx_bitcast(inout builder, chunk_ty(E_U8), hi);
                let both = ins_shuffle(inout builder, lo, hi, in joined.as_slice());
                let result = vx_bitcast(inout builder, chunk_ty(E_F32), both);
                out.push(result.id);
            }
        } else {
            // `ToBits` and `FromBits`: one bitcast per chunk, same lane count.
            for chunk_index in 0..n_chunks {
                let result = vx_bitcast(
                    inout builder,
                    chunk_ty(target),
                    vx_chunk(in first_chunks.as_slice(), chunk_index)
                );
                out.push(result.id);
            }
        }
        return vx_store_chunks(inout builder, in module, target, lanes, in out.as_slice());
    }
    if family == I_SHIFT {
        let first_chunks = vx_load_chunks(inout builder, vx_operand(call, 0), elem, lanes, false);
        // Cranelift masks a vector shift amount to the lane width.
        let amount = vx_operand(call, 1);
        let mut out = ChunkSeq::with_capacity[u32](n_chunks);
        for chunk_index in 0..n_chunks {
            let x = vx_chunk(in first_chunks.as_slice(), chunk_index);
            let op = if sub_op == SH_SHL {
                Bin::Ishl
            } else if elem_is_signed(elem) {
                Bin::Sshr
            } else {
                Bin::Ushr
            };
            let result = ins_binary(inout builder, op, x, amount);
            out.push(result.id);
        }
        return vx_store_chunks(inout builder, in module, elem, lanes, in out.as_slice());
    }
    if family == I_SELECT {
        let mask_chunks = vx_load_chunks(inout builder, vx_operand(call, 0), elem, lanes, true);
        let first_chunks = vx_load_chunks(inout builder, vx_operand(call, 1), elem, lanes, false);
        let second_chunks = vx_load_chunks(inout builder, vx_operand(call, 2), elem, lanes, false);
        let mut out = ChunkSeq::with_capacity[u32](n_chunks);
        for chunk_index in 0..n_chunks {
            let mask = if elem_is_float(elem) {
                vx_bitcast(
                    inout builder,
                    chunk_ty(elem),
                    vx_chunk(in mask_chunks.as_slice(), chunk_index)
                )
            } else {
                vx_chunk(in mask_chunks.as_slice(), chunk_index)
            };
            let result = ins_bitselect(
                inout builder,
                mask,
                vx_chunk(in first_chunks.as_slice(), chunk_index),
                vx_chunk(in second_chunks.as_slice(), chunk_index)
            );
            out.push(result.id);
        }
        return vx_store_chunks(inout builder, in module, elem, lanes, in out.as_slice());
    }
    if family == I_MASK_BITMASK {
        return vx_bitmask(inout builder, vx_operand(call, 0), elem, lanes);
    }
    if family == I_MASK_COUNT {
        let bits = vx_bitmask(inout builder, vx_operand(call, 0), elem, lanes);
        return ins_unary(inout builder, Un::Popcnt, bits);
    }
    if family == I_MASK_ANY || family == I_MASK_ALL {
        let bits = vx_bitmask(inout builder, vx_operand(call, 0), elem, lanes);
        let flag = if family == I_MASK_ANY {
            ins_icmp_imm(inout builder, IntCc::Ne, bits, 0)
        } else {
            let full = if lanes == ALL_LANES_64 {
                -1
            } else {
                wrapping_i64(wrapping_sub(wrapping_shl_u64(1, lanes), 1))
            };
            ins_icmp_imm(inout builder, IntCc::Eq, bits, full)
        };
        return ins_convert(inout builder, Cv::Uextend, vx_i64(), flag);
    }
    if family == I_REDUCE {
        let chunks = vx_load_chunks(inout builder, vx_operand(call, 0), elem, lanes, false);
        let mut acc = Value { id: 0 };
        for lane_index in 0..widen_u64(lanes) {
            let lane = ins_extractlane(
                inout builder,
                vx_chunk(in chunks.as_slice(), vx_div(lane_index, per)),
                wrapping_u32(vx_rem(lane_index, per))
            );
            let x = vx_scalar_of(inout builder, lane, elem);
            acc = if lane_index == 0 {
                x
            } else {
                vx_reduce_step(inout builder, sub_op, elem, acc, x)
            };
        }
        return acc;
    }
    if family == I_EXTRACT {
        let lane_index = widen_u64(vx_constant(call, 0));
        let chunks = vx_load_chunks(inout builder, vx_operand(call, 0), elem, lanes, false);
        let lane = ins_extractlane(
            inout builder,
            vx_chunk(in chunks.as_slice(), vx_div(lane_index, per)),
            wrapping_u32(vx_rem(lane_index, per))
        );
        return vx_scalar_of(inout builder, lane, elem);
    }
    if family == I_REPLACE {
        let lane_index = widen_u64(vx_constant(call, 0));
        let mut chunks = vx_load_chunks(inout builder, vx_operand(call, 0), elem, lanes, false);
        let lane = vx_lane_of(inout builder, vx_operand(call, 1), elem);
        let into = vx_chunk(in chunks.as_slice(), vx_div(lane_index, per));
        let result = ins_insertlane(
            inout builder,
            into,
            lane,
            wrapping_u32(vx_rem(lane_index, per))
        );
        let _set = chunks.try_set(vx_div(lane_index, per), result.id);
        return vx_store_chunks(inout builder, in module, elem, lanes, in chunks.as_slice());
    }
    if family == I_SHUFFLE {
        let chunks = vx_load_chunks(inout builder, vx_operand(call, 0), elem, lanes, false);
        if n_chunks == 1 {
            // One `shuffle` of the chunk's bytes.
            let width = widen_u64(elem_bits(elem) >> 3);
            let mut bytes: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](16);
            for lane_index in 0..widen_u64(lanes) {
                let source = widen_u64(vx_constant(call, lane_index));
                for j in 0..width {
                    bytes.push(wrapping_u8(wrapping_add(wrapping_mul(source, width), j)));
                }
            }
            let bytes_in = vx_bitcast(
                inout builder,
                chunk_ty(E_U8),
                vx_chunk(in chunks.as_slice(), 0)
            );
            let shuffled = ins_shuffle(inout builder, bytes_in, bytes_in, in bytes.as_slice());
            let out = vx_bitcast(inout builder, chunk_ty(elem), shuffled);
            let mut one = ChunkSeq::with_capacity[u32](1);
            one.push(out.id);
            return vx_store_chunks(inout builder, in module, elem, lanes, in one.as_slice());
        }
        let mut out = ChunkSeq::with_capacity[u32](n_chunks);
        for chunk_index in 0..n_chunks {
            out.push(vx_chunk(in chunks.as_slice(), chunk_index).id);
        }
        for lane_index in 0..widen_u64(lanes) {
            let source = widen_u64(vx_constant(call, lane_index));
            let lane = ins_extractlane(
                inout builder,
                vx_chunk(in chunks.as_slice(), vx_div(source, per)),
                wrapping_u32(vx_rem(source, per))
            );
            let into = vx_chunk(in out.as_slice(), vx_div(lane_index, per));
            let result = ins_insertlane(
                inout builder,
                into,
                lane,
                wrapping_u32(vx_rem(lane_index, per))
            );
            let _set = out.try_set(vx_div(lane_index, per), result.id);
        }
        return vx_store_chunks(inout builder, in module, elem, lanes, in out.as_slice());
    }
    if family == I_LOAD_MASKED {
        return vx_load_masked(
            inout builder,
            in module,
            vx_operand(call, 0),
            vx_operand(call, 1),
            elem,
            lanes
        );
    }
    if family == I_IN_BOUNDS {
        let len = ins_load(inout builder, vx_i64(), MF_PLAIN, vx_operand(call, 0), 0);
        return vx_active(inout builder, in module, vx_operand(call, 1), len, elem, lanes);
    }
    // I_ACTIVE (vx_well_formed admits nothing else).
    vx_active(inout builder, in module, vx_operand(call, 0), vx_operand(call, 1), elem, lanes)
}

// One `numeric` request on the lent handles.
fn numeric_request(
    call: u64,
    inout builder: Builder,
    inout module: Module
) -> u64 eff [Ffi[Cranelift]] {
    let op = call_op(call);
    if op == NUM_TILED {
        if !tiled_known(call) {
            return HOOK_DECLINED;
        }
        let result = tiled_request(call, inout builder, inout module);
        call_result_value(call, result);
        return HOOK_HANDLED;
    }
    if op == NUM_REGION {
        if !region_known(call) {
            return HOOK_DECLINED;
        }
        let result = region_request(call, inout builder, inout module);
        call_result_value(call, result);
        return HOOK_HANDLED;
    }
    if atomic_known(call, op) {
        let result = atomic_request(call, op, inout builder, inout module);
        call_result_value(call, result);
        return HOOK_HANDLED;
    }
    if float_known(call, op) {
        let result = float_request(call, op, inout builder);
        call_result_value(call, result);
        return HOOK_HANDLED;
    }
    if op == NUM_ISA_SUPPORTED {
        let result = ins_iconst(inout builder, vx_i64(), wrapping_i64(vx_arg(call, 0)));
        call_result_value(call, result);
        return HOOK_HANDLED;
    }
    if op == NUM_RUNTIME && call_arg_count(call) >= 1 {
        let kind = vx_arg(call, 0);
        if kind == RT_KIND_REGIONS {
            if define_region_runtime(inout module) {
                return HOOK_HANDLED;
            }
            return HOOK_DECLINED;
        }
        if kind == RT_KIND_TILED {
            if define_tiled_runtime(inout module) {
                return HOOK_HANDLED;
            }
            return HOOK_DECLINED;
        }
        if kind == RT_KIND_BOX_ALLOC {
            if define_box_runtime(inout module, true, false) {
                return HOOK_HANDLED;
            }
            return HOOK_DECLINED;
        }
        if kind == RT_KIND_BOX_FREE {
            if define_box_runtime(inout module, false, true) {
                return HOOK_HANDLED;
            }
            return HOOK_DECLINED;
        }
        return HOOK_DECLINED;
    }
    if op != NUM_VECTOR || call_arg_count(call) < VA_FIRST_CONSTANT {
        return HOOK_DECLINED;
    }
    if call_arg_count(call) < vx_first_operand(call) {
        return HOOK_DECLINED;
    }
    let intrinsic = wrapping_u32(vx_arg(call, VA_INTRINSIC));
    let elem = wrapping_u32(vx_arg(call, VA_ELEM));
    let lanes = wrapping_u32(vx_arg(call, VA_LANES));
    if elem >= ELEMS || !vx_well_formed(call, intrinsic, elem, lanes) {
        return HOOK_DECLINED;
    }
    let result = vx_emit(call, inout builder, in module, intrinsic, elem, lanes);
    call_result_value(call, result);
    HOOK_HANDLED
}

// The `numeric` hook (exported from the package root as `numeric_hook`):
// `call` is the address of the lent call. Returns 1 when it emitted the
// request, 0 to leave it to the Rust code.
pub fn hook_entry(call: u64) -> u64 eff [Ffi[Cranelift]] {
    let mut builder = match call_builder(call) {
        Some(builder) => builder,
        None => return HOOK_DECLINED,
    };
    let mut module = match call_module(call) {
        Some(module) => module,
        None => {
            call_return_builder(call, builder);
            return HOOK_DECLINED;
        }
    };
    let handled = numeric_request(call, inout builder, inout module);
    call_return_module(call, module);
    call_return_builder(call, builder);
    handled
}
