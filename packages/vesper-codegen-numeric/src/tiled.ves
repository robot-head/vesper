// The TiledSeq runtime of AOT executables (src/tiled/aot_runtime.rs),
// transliterated function by function: nine `vesper_tiled_*` entry points
// and three helpers as local functions of the module, over libc and the
// region runtime's `vesper_region_alloc` (regions.ves, defined first).

use @vesper/cranelift::{
    DataId,
    FuncId,
    Value,
    append_block_param,
    block_param,
    builder_new,
    cc_eq,
    cc_ne,
    cc_uge,
    cc_ugt,
    cc_ule,
    cc_ult,
    create_block,
    import_data,
    ins_band,
    ins_brif0,
    ins_global_value,
    ins_iadd,
    ins_iadd_imm,
    ins_icmp,
    ins_icmp_imm,
    ins_imul,
    ins_ishl_imm,
    ins_istore32,
    ins_istore8,
    ins_isub,
    ins_jump,
    ins_jump0,
    ins_load,
    ins_return,
    ins_return1,
    ins_select,
    ins_store,
    ins_trap,
    ins_udiv,
    ins_uload32,
    ins_uload8,
    ins_urem,
    module_get_function,
    switch_to_block,
    trap_user,
    ty_i64,
    vals1,
    vals2,
    vals3,
};
use self::regions::{
    define_region_runtime,
};
use self::rt::{
    no_vals,
    rt_call,
    rt_call1,
    rt_entry,
    rt_finish,
    rt_import,
    rt_k,
    rt_local,
    rt_message,
    rt_numbered,
    rt_sig,
    rt_text,
};

// The sequence record: field offsets and size in bytes.
const T_W: i32 = 0;
const T_STRIDE: i32 = 8;
const T_COLD_W: i32 = 16;
const T_LEN: i32 = 24;
const T_CAP: i32 = 32;
const T_HOT_RAW: i32 = 40;
const T_HOT_PTR: i32 = 48;
const T_COLD_PTR: i32 = 56;
const T_REGION_ID: i32 = 64;
const T_CHARGED: i32 = 72;
const T_ROW_CHARGE: i32 = 80;
const T_HOT_BYTES: i32 = 88;
const T_RECORD_BYTES: i64 = 96;

// Exit status of an executable after a tiled fault.
pub const TILED_FAULT_STATUS: i64 = 71;
// The trap code after a fault call (`TrapCode::unwrap_user(1)`).
const TILED_TRAP: u32 = 1;

// Faults (the discriminants of `Fault`).
const TF_INVALID: i64 = 0;
const TF_BOUNDS: i64 = 1;
const TF_MEMORY: i64 = 2;
const TILED_FAULTS: u32 = 3;

fn tiled_fault_text(i: u32) -> Str {
    if i == 0 {
        "invalid TiledSeq handle or width"
    } else if i == 1 {
        "TiledSeq index out of bounds"
    } else {
        "out of memory allocating TiledSeq buffer"
    }
}

struct TiledImports {
    malloc: FuncId,
    realloc: FuncId,
    free: FuncId,
    memset: FuncId,
    memmove: FuncId,
    write: FuncId,
    exit: FuncId,
    region_alloc: FuncId,
    fault: FuncId,
    ensure_tiles: FuncId,
    charge_region: FuncId,
    messages: ChunkSeq[u32],
    lengths: ChunkSeq[i64],
}

// `define` after the region runtime: `region_alloc` is its
// `vesper_region_alloc`, which a second declaration of the same name finds.
pub fn define_tiled_runtime(inout module: Module) -> bool eff [Ffi[Cranelift]] {
    match module_get_function(inout module, in "vesper_tiled_fault".as_bytes()) {
        Some(_) => return true,
        None => {},
    }
    if !define_region_runtime(inout module) {
        return false;
    }
    let mut messages: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut lengths: ChunkSeq[i64] = ChunkSeq::new[i64]();
    for i in 0..TILED_FAULTS {
        let text = rt_text(in "vesper: native tiled fault: ", in tiled_fault_text(i));
        let name = rt_numbered(in "vesper_tiled_msg_", i);
        match rt_message(inout module, in name.as_slice(), in text.as_slice()) {
            Some(id) => {
                messages.push(id.id);
                lengths.push(wrapping_i64(text.len()));
            },
            None => return false,
        }
    }
    let region_alloc = rt_local(inout module, in "vesper_region_alloc".as_bytes(), 2, true);
    let imports = TiledImports {
        malloc: rt_import(inout module, in "malloc".as_bytes(), 1, true),
        realloc: rt_import(inout module, in "realloc".as_bytes(), 2, true),
        free: rt_import(inout module, in "free".as_bytes(), 1, false),
        memset: rt_import(inout module, in "memset".as_bytes(), 3, true),
        memmove: rt_import(inout module, in "memmove".as_bytes(), 3, true),
        write: rt_import(inout module, in "write".as_bytes(), 3, true),
        exit: rt_import(inout module, in "exit".as_bytes(), 1, false),
        region_alloc,
        fault: rt_local(inout module, in "vesper_tiled_fault".as_bytes(), 1, false),
        ensure_tiles: rt_local(inout module, in "vesper_tiled_ensure_tiles".as_bytes(), 2, false),
        charge_region: rt_local(inout module, in "vesper_tiled_charge_region".as_bytes(), 2, false),
        messages,
        lengths,
    };
    if !tl_compile(inout module, in imports, imports.fault, 1, false, 100) {
        return false;
    }
    if !tl_compile(inout module, in imports, imports.charge_region, 2, false, 101) {
        return false;
    }
    if !tl_compile(inout module, in imports, imports.ensure_tiles, 2, false, 102) {
        return false;
    }
    for i in 0..9 {
        let params = tiled_function_params(i);
        let id = rt_local(inout module, in tiled_function_name(i).as_bytes(), params, true);
        if !tl_compile(inout module, in imports, id, params, true, i) {
            return false;
        }
    }
    true
}

fn tiled_function_name(i: u32) -> Str {
    if i == 0 {
        "vesper_tiled_new"
    } else if i == 1 {
        "vesper_tiled_len"
    } else if i == 2 {
        "vesper_tiled_tile_count"
    } else if i == 3 {
        "vesper_tiled_push_begin"
    } else if i == 4 {
        "vesper_tiled_hot_load"
    } else if i == 5 {
        "vesper_tiled_hot_store"
    } else if i == 6 {
        "vesper_tiled_cold_load"
    } else if i == 7 {
        "vesper_tiled_cold_store"
    } else {
        "vesper_tiled_tile_col_ptr"
    }
}
fn tiled_function_params(i: u32) -> u32 {
    if i == 0 || i == 5 {
        5
    } else if i == 4 || i == 7 {
        4
    } else if i == 6 || i == 8 {
        3
    } else {
        1
    }
}

// `compile`: a fresh function whose entry block is sealed at once; `which`
// is 0-8 for the entry points in `define` order and 100-102 for the fault,
// charge and ensure helpers.
fn tl_compile(
    inout module: Module,
    in imports: TiledImports,
    id: FuncId,
    params: u32,
    ret: bool,
    which: u32
) -> bool eff [Ffi[Cranelift]] {
    let sig = rt_sig(inout module, params, ret);
    let mut builder = match builder_new(in module, sig) {
        Some(builder) => builder,
        None => return false,
    };
    let entry = rt_entry(inout builder, true);
    let param0 = block_param(inout builder, entry, 0);
    let param1 = if params > 1 {
        block_param(inout builder, entry, 1)
    } else {
        param0
    };
    let param2 = if params > 2 {
        block_param(inout builder, entry, 2)
    } else {
        param0
    };
    let param3 = if params > 3 {
        block_param(inout builder, entry, 3)
    } else {
        param0
    };
    let param4 = if params > 4 {
        block_param(inout builder, entry, 4)
    } else {
        param0
    };
    if which == 100 {
        tl_fault(inout builder, inout module, in imports, param0);
    } else if which == 101 {
        tl_charge_region(inout builder, inout module, in imports, param0, param1);
    } else if which == 102 {
        tl_ensure_tiles(inout builder, inout module, in imports, param0, param1);
    } else if which == 0 {
        tl_new(inout builder, inout module, in imports, param0, param1, param2, param3, param4);
    } else if which == 1 {
        tl_len(inout builder, inout module, in imports, param0);
    } else if which == 2 {
        tl_tile_count(inout builder, inout module, in imports, param0);
    } else if which == 3 {
        tl_push_begin(inout builder, inout module, in imports, param0);
    } else if which == 4 {
        tl_hot_load(inout builder, inout module, in imports, param0, param1, param2, param3);
    } else if which == 5 {
        tl_hot_store(
            inout builder,
            inout module,
            in imports,
            param0,
            param1,
            param2,
            param3,
            param4
        );
    } else if which == 6 {
        let ptr = tl_cold_ptr(inout builder, inout module, in imports, param0, param1, param2);
        let word = tl_ld(inout builder, ptr, 0);
        ins_return1(inout builder, word);
    } else if which == 7 {
        let ptr = tl_cold_ptr(inout builder, inout module, in imports, param0, param1, param2);
        ins_store(inout builder, 0, param3, ptr, 0);
        let zero = rt_k(inout builder, 0);
        ins_return1(inout builder, zero);
    } else {
        tl_tile_col_ptr(inout builder, inout module, in imports, param0, param1, param2);
    }
    rt_finish(inout module, id, builder)
}

// `load(types::I64, MemFlags::new(), p, off)` and its store.
fn tl_ld(inout builder: Builder, addr: Value, off: i32) -> Value eff [Ffi[Cranelift]] {
    ins_load(inout builder, ty_i64(), 0, addr, off)
}
fn tl_st(inout builder: Builder, value: Value, addr: Value, off: i32) eff [Ffi[Cranelift]] {
    ins_store(inout builder, 0, value, addr, off);
}
pub fn tl_return0(inout builder: Builder) eff [Ffi[Cranelift]] {
    let nothing = no_vals();
    ins_return(inout builder, in nothing.as_slice());
}

fn tl_trigger_fault(
    inout builder: Builder,
    inout module: Module,
    in imports: TiledImports,
    fault: i64
) eff [Ffi[Cranelift]] {
    let code = rt_k(inout builder, fault);
    let args = vals1(code);
    rt_call(inout builder, inout module, imports.fault, in args.as_slice());
    ins_trap(inout builder, trap_user(TILED_TRAP));
}

fn tl_check_non_null(
    inout builder: Builder,
    inout module: Module,
    in imports: TiledImports,
    ptr: Value,
    fault: i64
) eff [Ffi[Cranelift]] {
    let is_null = ins_icmp_imm(inout builder, cc_eq(), ptr, 0);
    let fail_blk = create_block(inout builder);
    let ok_blk = create_block(inout builder);
    ins_brif0(inout builder, is_null, fail_blk, ok_blk);
    switch_to_block(inout builder, fail_blk);
    tl_trigger_fault(inout builder, inout module, in imports, fault);
    switch_to_block(inout builder, ok_blk);
}

fn tl_fault(
    inout builder: Builder,
    inout module: Module,
    in imports: TiledImports,
    code: Value
) eff [Ffi[Cranelift]] {
    let fd = rt_k(inout builder, 2);
    let done = create_block(inout builder);
    for i in 0..TILED_FAULTS {
        let at = widen_u64(i);
        let data = match imports.messages.try_get(at) {
            Some(data_id) => DataId { id: data_id },
            None => return,
        };
        let len = match imports.lengths.try_get(at) {
            Some(msg_len) => msg_len,
            None => return,
        };
        let matches = ins_icmp_imm(inout builder, cc_eq(), code, widen_i64(i));
        let hit = create_block(inout builder);
        let miss = create_block(inout builder);
        ins_brif0(inout builder, matches, hit, miss);
        switch_to_block(inout builder, hit);
        let global_value = import_data(inout builder, in module, data);
        let ptr = ins_global_value(inout builder, ty_i64(), global_value);
        let len_value = rt_k(inout builder, len);
        let args = vals3(fd, ptr, len_value);
        rt_call(inout builder, inout module, imports.write, in args.as_slice());
        ins_jump0(inout builder, done);
        switch_to_block(inout builder, miss);
    }
    ins_jump0(inout builder, done);
    switch_to_block(inout builder, done);
    let status = rt_k(inout builder, TILED_FAULT_STATUS);
    let status_args = vals1(status);
    rt_call(inout builder, inout module, imports.exit, in status_args.as_slice());
    ins_trap(inout builder, trap_user(TILED_TRAP));
}

fn tl_checked_mul(
    inout builder: Builder,
    inout module: Module,
    in imports: TiledImports,
    lhs: Value,
    rhs: Value,
    fault: i64
) -> Value eff [Ffi[Cranelift]] {
    let rhs_nonzero = ins_icmp_imm(inout builder, cc_ne(), rhs, 0);
    let check_blk = create_block(inout builder);
    let ok_blk = create_block(inout builder);
    ins_brif0(inout builder, rhs_nonzero, check_blk, ok_blk);
    switch_to_block(inout builder, check_blk);
    let max_u64 = rt_k(inout builder, -1);
    let limit = ins_udiv(inout builder, max_u64, rhs);
    let overflow = ins_icmp(inout builder, cc_ugt(), lhs, limit);
    let fail_blk = create_block(inout builder);
    ins_brif0(inout builder, overflow, fail_blk, ok_blk);
    switch_to_block(inout builder, fail_blk);
    tl_trigger_fault(inout builder, inout module, in imports, fault);
    switch_to_block(inout builder, ok_blk);
    ins_imul(inout builder, lhs, rhs)
}

// `checked_add_imm_or_fault` for `imm` = 63, the one use.
fn tl_checked_add63(
    inout builder: Builder,
    inout module: Module,
    in imports: TiledImports,
    lhs: Value,
    fault: i64
) -> Value eff [Ffi[Cranelift]] {
    // (u64::MAX - 63) as i64
    let overflow = ins_icmp_imm(inout builder, cc_ugt(), lhs, -64);
    let fail_blk = create_block(inout builder);
    let ok_blk = create_block(inout builder);
    ins_brif0(inout builder, overflow, fail_blk, ok_blk);
    switch_to_block(inout builder, fail_blk);
    tl_trigger_fault(inout builder, inout module, in imports, fault);
    switch_to_block(inout builder, ok_blk);
    ins_iadd_imm(inout builder, lhs, 63)
}

fn tl_checked_shl3(
    inout builder: Builder,
    inout module: Module,
    in imports: TiledImports,
    val: Value,
    fault: i64
) -> Value eff [Ffi[Cranelift]] {
    // (u64::MAX >> 3) as i64
    let overflow = ins_icmp_imm(inout builder, cc_ugt(), val, 2305843009213693951);
    let fail_blk = create_block(inout builder);
    let ok_blk = create_block(inout builder);
    ins_brif0(inout builder, overflow, fail_blk, ok_blk);
    switch_to_block(inout builder, fail_blk);
    tl_trigger_fault(inout builder, inout module, in imports, fault);
    switch_to_block(inout builder, ok_blk);
    ins_ishl_imm(inout builder, val, 3)
}

fn tl_safe_div_ceil(
    inout builder: Builder,
    count: Value,
    width: Value
) -> Value eff [Ffi[Cranelift]] {
    let is_zero = ins_icmp_imm(inout builder, cc_eq(), count, 0);
    let zero_blk = create_block(inout builder);
    let nonzero_blk = create_block(inout builder);
    let done_blk = create_block(inout builder);
    append_block_param(inout builder, done_blk, ty_i64());
    ins_brif0(inout builder, is_zero, zero_blk, nonzero_blk);
    switch_to_block(inout builder, zero_blk);
    let zero = rt_k(inout builder, 0);
    let zero_args = vals1(zero);
    ins_jump(inout builder, done_blk, in zero_args.as_slice());
    switch_to_block(inout builder, nonzero_blk);
    let count_minus_1 = ins_iadd_imm(inout builder, count, -1);
    let quotient = ins_udiv(inout builder, count_minus_1, width);
    let result = ins_iadd_imm(inout builder, quotient, 1);
    let result_args = vals1(result);
    ins_jump(inout builder, done_blk, in result_args.as_slice());
    switch_to_block(inout builder, done_blk);
    block_param(inout builder, done_blk, 0)
}

fn tl_charge_region(
    inout builder: Builder,
    inout module: Module,
    in imports: TiledImports,
    seq: Value,
    rows: Value
) eff [Ffi[Cranelift]] {
    let region_id = tl_ld(inout builder, seq, T_REGION_ID);
    let no_region = ins_icmp_imm(inout builder, cc_eq(), region_id, 0);
    let done = create_block(inout builder);
    let active = create_block(inout builder);
    ins_brif0(inout builder, no_region, done, active);
    switch_to_block(inout builder, active);
    let row_charge = tl_ld(inout builder, seq, T_ROW_CHARGE);
    let target = tl_checked_mul(
        inout builder,
        inout module,
        in imports,
        rows,
        row_charge,
        TF_MEMORY
    );
    let charged = tl_ld(inout builder, seq, T_CHARGED);
    let need = ins_icmp(inout builder, cc_ugt(), target, charged);
    let do_alloc = create_block(inout builder);
    ins_brif0(inout builder, need, do_alloc, done);
    switch_to_block(inout builder, do_alloc);
    let delta = ins_isub(inout builder, target, charged);
    let args = vals2(region_id, delta);
    rt_call(inout builder, inout module, imports.region_alloc, in args.as_slice());
    tl_st(inout builder, target, seq, T_CHARGED);
    ins_jump0(inout builder, done);
    switch_to_block(inout builder, done);
    tl_return0(inout builder);
}

fn tl_ensure_tiles(
    inout builder: Builder,
    inout module: Module,
    in imports: TiledImports,
    seq: Value,
    needed: Value
) eff [Ffi[Cranelift]] {
    let cap = tl_ld(inout builder, seq, T_CAP);
    let fits = ins_icmp(inout builder, cc_ule(), needed, cap);
    let done = create_block(inout builder);
    let grow = create_block(inout builder);
    ins_brif0(inout builder, fits, done, grow);
    switch_to_block(inout builder, grow);

    let one = rt_k(inout builder, 1);
    let cap_nonzero = ins_icmp_imm(inout builder, cc_ne(), cap, 0);
    let base_cap = ins_select(inout builder, cap_nonzero, cap, one);
    // (u64::MAX >> 1) as i64
    let half_max = rt_k(inout builder, 9223372036854775807);
    let can_double = ins_icmp(inout builder, cc_ule(), base_cap, half_max);
    let shifted = ins_ishl_imm(inout builder, base_cap, 1);
    let doubled = ins_select(inout builder, can_double, shifted, needed);
    let use_doubled = ins_icmp(inout builder, cc_uge(), doubled, needed);
    let new_tiles = ins_select(inout builder, use_doubled, doubled, needed);

    let stride = tl_ld(inout builder, seq, T_STRIDE);
    let new_hot_bytes = tl_checked_mul(
        inout builder,
        inout module,
        in imports,
        new_tiles,
        stride,
        TF_MEMORY
    );
    let alloc_bytes = tl_checked_add63(
        inout builder,
        inout module,
        in imports,
        new_hot_bytes,
        TF_MEMORY
    );
    let malloc_args = vals1(alloc_bytes);
    let new_raw = rt_call1(inout builder, inout module, imports.malloc, in malloc_args.as_slice());
    tl_check_non_null(inout builder, inout module, in imports, new_raw, TF_MEMORY);
    let zero = rt_k(inout builder, 0);
    let memset_args = vals3(new_raw, zero, alloc_bytes);
    rt_call(inout builder, inout module, imports.memset, in memset_args.as_slice());

    let raw_plus = ins_iadd_imm(inout builder, new_raw, 63);
    let mask = rt_k(inout builder, -64);
    let new_aligned = ins_band(inout builder, raw_plus, mask);

    let old_raw = tl_ld(inout builder, seq, T_HOT_RAW);
    let old_aligned = tl_ld(inout builder, seq, T_HOT_PTR);
    let old_bytes = tl_ld(inout builder, seq, T_HOT_BYTES);
    let has_old = ins_icmp_imm(inout builder, cc_ne(), old_raw, 0);
    let copy_old = create_block(inout builder);
    let after_copy = create_block(inout builder);
    ins_brif0(inout builder, has_old, copy_old, after_copy);
    switch_to_block(inout builder, copy_old);
    let memmove_args = vals3(new_aligned, old_aligned, old_bytes);
    rt_call(inout builder, inout module, imports.memmove, in memmove_args.as_slice());
    let free_args = vals1(old_raw);
    rt_call(inout builder, inout module, imports.free, in free_args.as_slice());
    ins_jump0(inout builder, after_copy);
    switch_to_block(inout builder, after_copy);

    tl_st(inout builder, new_raw, seq, T_HOT_RAW);
    tl_st(inout builder, new_aligned, seq, T_HOT_PTR);
    tl_st(inout builder, new_hot_bytes, seq, T_HOT_BYTES);

    let width = tl_ld(inout builder, seq, T_W);
    let cold_width = tl_ld(inout builder, seq, T_COLD_W);
    let has_cold = ins_icmp_imm(inout builder, cc_ne(), cold_width, 0);
    let grow_cold = create_block(inout builder);
    let finish = create_block(inout builder);
    ins_brif0(inout builder, has_cold, grow_cold, finish);
    switch_to_block(inout builder, grow_cold);
    let old_rows = ins_imul(inout builder, cap, width);
    let old_cold_bytes = ins_imul(inout builder, old_rows, cold_width);
    let old_cold_bytes = ins_ishl_imm(inout builder, old_cold_bytes, 3);
    let new_rows = tl_checked_mul(
        inout builder,
        inout module,
        in imports,
        new_tiles,
        width,
        TF_MEMORY
    );
    let new_cold_words = tl_checked_mul(
        inout builder,
        inout module,
        in imports,
        new_rows,
        cold_width,
        TF_MEMORY
    );
    let new_cold_bytes = tl_checked_shl3(
        inout builder,
        inout module,
        in imports,
        new_cold_words,
        TF_MEMORY
    );
    let old_cold = tl_ld(inout builder, seq, T_COLD_PTR);
    let realloc_args = vals2(old_cold, new_cold_bytes);
    let new_cold = rt_call1(
        inout builder,
        inout module,
        imports.realloc,
        in realloc_args.as_slice()
    );
    tl_check_non_null(inout builder, inout module, in imports, new_cold, TF_MEMORY);
    let tail = ins_iadd(inout builder, new_cold, old_cold_bytes);
    let delta_cold = ins_isub(inout builder, new_cold_bytes, old_cold_bytes);
    let tail_args = vals3(tail, zero, delta_cold);
    rt_call(inout builder, inout module, imports.memset, in tail_args.as_slice());
    tl_st(inout builder, new_cold, seq, T_COLD_PTR);
    ins_jump0(inout builder, finish);

    switch_to_block(inout builder, finish);
    tl_st(inout builder, new_tiles, seq, T_CAP);
    ins_jump0(inout builder, done);
    switch_to_block(inout builder, done);
    tl_return0(inout builder);
}

fn tl_new(
    inout builder: Builder,
    inout module: Module,
    in imports: TiledImports,
    width: Value,
    stride: Value,
    cold_width: Value,
    region_id: Value,
    cap: Value
) eff [Ffi[Cranelift]] {
    let bad_width = ins_icmp_imm(inout builder, cc_eq(), width, 0);
    let fail_blk = create_block(inout builder);
    let ok_blk = create_block(inout builder);
    ins_brif0(inout builder, bad_width, fail_blk, ok_blk);
    switch_to_block(inout builder, fail_blk);
    tl_trigger_fault(inout builder, inout module, in imports, TF_INVALID);
    switch_to_block(inout builder, ok_blk);

    let record_size = rt_k(inout builder, T_RECORD_BYTES);
    let malloc_args = vals1(record_size);
    let seq = rt_call1(inout builder, inout module, imports.malloc, in malloc_args.as_slice());
    tl_check_non_null(inout builder, inout module, in imports, seq, TF_MEMORY);
    let zero = rt_k(inout builder, 0);
    let memset_args = vals3(seq, zero, record_size);
    rt_call(inout builder, inout module, imports.memset, in memset_args.as_slice());

    let width_minus_1 = ins_iadd_imm(inout builder, width, -1);
    let numerator = ins_iadd(inout builder, stride, width_minus_1);
    let hot_per_row = ins_udiv(inout builder, numerator, width);
    let cold_bytes = ins_ishl_imm(inout builder, cold_width, 3);
    let sum = ins_iadd(inout builder, hot_per_row, cold_bytes);
    let eight = rt_k(inout builder, 8);
    let at_least_8 = ins_icmp_imm(inout builder, cc_uge(), sum, 8);
    let row_charge = ins_select(inout builder, at_least_8, sum, eight);

    tl_st(inout builder, width, seq, T_W);
    tl_st(inout builder, stride, seq, T_STRIDE);
    tl_st(inout builder, cold_width, seq, T_COLD_W);
    tl_st(inout builder, region_id, seq, T_REGION_ID);
    tl_st(inout builder, row_charge, seq, T_ROW_CHARGE);

    let has_cap = ins_icmp_imm(inout builder, cc_ne(), cap, 0);
    let init_cap = create_block(inout builder);
    let done = create_block(inout builder);
    ins_brif0(inout builder, has_cap, init_cap, done);
    switch_to_block(inout builder, init_cap);
    let charge_args = vals2(seq, cap);
    rt_call(inout builder, inout module, imports.charge_region, in charge_args.as_slice());
    let tiles = tl_safe_div_ceil(inout builder, cap, width);
    let ensure_args = vals2(seq, tiles);
    rt_call(inout builder, inout module, imports.ensure_tiles, in ensure_args.as_slice());
    ins_jump0(inout builder, done);
    switch_to_block(inout builder, done);
    ins_return1(inout builder, seq);
}

fn tl_len(inout builder: Builder, inout module: Module, in imports: TiledImports, seq: Value) eff [
    Ffi[Cranelift]
] {
    tl_check_non_null(inout builder, inout module, in imports, seq, TF_INVALID);
    let len = tl_ld(inout builder, seq, T_LEN);
    ins_return1(inout builder, len);
}

fn tl_tile_count(
    inout builder: Builder,
    inout module: Module,
    in imports: TiledImports,
    seq: Value
) eff [Ffi[Cranelift]] {
    tl_check_non_null(inout builder, inout module, in imports, seq, TF_INVALID);
    let len = tl_ld(inout builder, seq, T_LEN);
    let width = tl_ld(inout builder, seq, T_W);
    let tiles = tl_safe_div_ceil(inout builder, len, width);
    ins_return1(inout builder, tiles);
}

fn tl_push_begin(
    inout builder: Builder,
    inout module: Module,
    in imports: TiledImports,
    seq: Value
) eff [Ffi[Cranelift]] {
    tl_check_non_null(inout builder, inout module, in imports, seq, TF_INVALID);
    let row = tl_ld(inout builder, seq, T_LEN);
    let max_u64 = rt_k(inout builder, -1);
    let at_max = ins_icmp(inout builder, cc_eq(), row, max_u64);
    let ok_len = create_block(inout builder);
    let fail_len = create_block(inout builder);
    ins_brif0(inout builder, at_max, fail_len, ok_len);
    switch_to_block(inout builder, fail_len);
    tl_trigger_fault(inout builder, inout module, in imports, TF_MEMORY);
    switch_to_block(inout builder, ok_len);
    let next_len = ins_iadd_imm(inout builder, row, 1);
    let charge_args = vals2(seq, next_len);
    rt_call(inout builder, inout module, imports.charge_region, in charge_args.as_slice());
    let width = tl_ld(inout builder, seq, T_W);
    let tiles = tl_safe_div_ceil(inout builder, next_len, width);
    let ensure_args = vals2(seq, tiles);
    rt_call(inout builder, inout module, imports.ensure_tiles, in ensure_args.as_slice());
    tl_st(inout builder, next_len, seq, T_LEN);
    ins_return1(inout builder, row);
}

// The row bounds check shared by the hot and cold pointers.
fn tl_row_check(
    inout builder: Builder,
    inout module: Module,
    in imports: TiledImports,
    seq: Value,
    row: Value
) eff [Ffi[Cranelift]] {
    tl_check_non_null(inout builder, inout module, in imports, seq, TF_INVALID);
    let len = tl_ld(inout builder, seq, T_LEN);
    let in_bounds = ins_icmp(inout builder, cc_ult(), row, len);
    let ok_blk = create_block(inout builder);
    let fail_blk = create_block(inout builder);
    ins_brif0(inout builder, in_bounds, ok_blk, fail_blk);
    switch_to_block(inout builder, fail_blk);
    tl_trigger_fault(inout builder, inout module, in imports, TF_BOUNDS);
    switch_to_block(inout builder, ok_blk);
}

fn tl_hot_ptr(
    inout builder: Builder,
    inout module: Module,
    in imports: TiledImports,
    seq: Value,
    row: Value,
    col_off: Value,
    elem_bytes: Value
) -> Value eff [Ffi[Cranelift]] {
    tl_row_check(inout builder, inout module, in imports, seq, row);
    let width = tl_ld(inout builder, seq, T_W);
    let tile = ins_udiv(inout builder, row, width);
    let lane = ins_urem(inout builder, row, width);
    let stride = tl_ld(inout builder, seq, T_STRIDE);
    let base_tile = ins_imul(inout builder, tile, stride);
    let lane_off = ins_imul(inout builder, lane, elem_bytes);
    let tile_col_off = ins_iadd(inout builder, base_tile, col_off);
    let off = ins_iadd(inout builder, tile_col_off, lane_off);
    let hot_ptr = tl_ld(inout builder, seq, T_HOT_PTR);
    ins_iadd(inout builder, hot_ptr, off)
}

fn tl_hot_load(
    inout builder: Builder,
    inout module: Module,
    in imports: TiledImports,
    seq: Value,
    row: Value,
    col_off: Value,
    elem_bytes: Value
) eff [Ffi[Cranelift]] {
    let ptr = tl_hot_ptr(inout builder, inout module, in imports, seq, row, col_off, elem_bytes);
    let is_byte = ins_icmp_imm(inout builder, cc_eq(), elem_bytes, 1);
    let byte_blk = create_block(inout builder);
    let wider_blk = create_block(inout builder);
    ins_brif0(inout builder, is_byte, byte_blk, wider_blk);
    switch_to_block(inout builder, byte_blk);
    let byte = ins_uload8(inout builder, ty_i64(), 0, ptr, 0);
    ins_return1(inout builder, byte);

    switch_to_block(inout builder, wider_blk);
    let is_word32 = ins_icmp_imm(inout builder, cc_eq(), elem_bytes, 4);
    let word32_blk = create_block(inout builder);
    let word64_blk = create_block(inout builder);
    ins_brif0(inout builder, is_word32, word32_blk, word64_blk);
    switch_to_block(inout builder, word32_blk);
    let word32 = ins_uload32(inout builder, 0, ptr, 0);
    ins_return1(inout builder, word32);

    switch_to_block(inout builder, word64_blk);
    let word64 = tl_ld(inout builder, ptr, 0);
    ins_return1(inout builder, word64);
}

fn tl_hot_store(
    inout builder: Builder,
    inout module: Module,
    in imports: TiledImports,
    seq: Value,
    row: Value,
    col_off: Value,
    elem_bytes: Value,
    val: Value
) eff [Ffi[Cranelift]] {
    let ptr = tl_hot_ptr(inout builder, inout module, in imports, seq, row, col_off, elem_bytes);
    let zero = rt_k(inout builder, 0);
    let is_byte = ins_icmp_imm(inout builder, cc_eq(), elem_bytes, 1);
    let byte_blk = create_block(inout builder);
    let wider_blk = create_block(inout builder);
    ins_brif0(inout builder, is_byte, byte_blk, wider_blk);
    switch_to_block(inout builder, byte_blk);
    ins_istore8(inout builder, 0, val, ptr, 0);
    ins_return1(inout builder, zero);

    switch_to_block(inout builder, wider_blk);
    let is_word32 = ins_icmp_imm(inout builder, cc_eq(), elem_bytes, 4);
    let word32_blk = create_block(inout builder);
    let word64_blk = create_block(inout builder);
    ins_brif0(inout builder, is_word32, word32_blk, word64_blk);
    switch_to_block(inout builder, word32_blk);
    ins_istore32(inout builder, 0, val, ptr, 0);
    ins_return1(inout builder, zero);

    switch_to_block(inout builder, word64_blk);
    tl_st(inout builder, val, ptr, 0);
    ins_return1(inout builder, zero);
}

fn tl_cold_ptr(
    inout builder: Builder,
    inout module: Module,
    in imports: TiledImports,
    seq: Value,
    row: Value,
    word_off: Value
) -> Value eff [Ffi[Cranelift]] {
    tl_row_check(inout builder, inout module, in imports, seq, row);
    let cold_width = tl_ld(inout builder, seq, T_COLD_W);
    let row_off = ins_imul(inout builder, row, cold_width);
    let word_index = ins_iadd(inout builder, row_off, word_off);
    let byte_off = ins_ishl_imm(inout builder, word_index, 3);
    let cold_ptr = tl_ld(inout builder, seq, T_COLD_PTR);
    ins_iadd(inout builder, cold_ptr, byte_off)
}

fn tl_tile_col_ptr(
    inout builder: Builder,
    inout module: Module,
    in imports: TiledImports,
    seq: Value,
    tile_idx: Value,
    col_off: Value
) eff [Ffi[Cranelift]] {
    tl_check_non_null(inout builder, inout module, in imports, seq, TF_INVALID);
    let len = tl_ld(inout builder, seq, T_LEN);
    let width = tl_ld(inout builder, seq, T_W);
    let tile_count = tl_safe_div_ceil(inout builder, len, width);
    let ok_blk = create_block(inout builder);
    let fail_blk = create_block(inout builder);
    let valid = ins_icmp(inout builder, cc_ult(), tile_idx, tile_count);
    ins_brif0(inout builder, valid, ok_blk, fail_blk);
    switch_to_block(inout builder, fail_blk);
    tl_trigger_fault(inout builder, inout module, in imports, TF_BOUNDS);
    switch_to_block(inout builder, ok_blk);

    let stride = tl_ld(inout builder, seq, T_STRIDE);
    let tile_off = ins_imul(inout builder, tile_idx, stride);
    let off = ins_iadd(inout builder, tile_off, col_off);
    let hot_ptr = tl_ld(inout builder, seq, T_HOT_PTR);
    let ptr = ins_iadd(inout builder, hot_ptr, off);
    ins_return1(inout builder, ptr);
}
