// The WIT the wasm backend writes (src/wasm_backend/component.rs
// `exports`), read into a type table. Only that grammar is accepted:
//
//   package vesper:program@0.1.0;
//   interface entry {
//     record %name { %field: ty, ... }
//     variant %name { %case, %case(ty), ... }
//     main: func(%param: ty, ...) -> ty;
//   }
//   world program { import <host>; export wasi:cli/run@0.2.0; export entry; }
//
// with the host imports of host.ves, or the Nexus plugin world
//
//   package vesper:program@0.1.0;
//   world plugin { export run: func(%p: ty, ...) -> ty; }
//
// where `ty` is a scalar, `string`, `tuple<ty, ...>` or a `%name`
// defined above it. Anything else sets `err`, and the caller hands the
// module to Rust's wit-component instead.
//
// Types are interned: a scalar, a tuple of the same elements, or a
// definition is one row of `tys`, so a row number is the identity
// wit-component's type maps key on (`TypeId` for definitions, the
// structure for anonymous types).

use @vesper/check-data::util::{add, inc, w};
use self::host::host_import;

pub const NONE32: u32 = 4294967295;

// `Ty::kind`.
pub const T_PRIM: u8 = 0;
pub const T_TUPLE: u8 = 1;
pub const T_NAMED: u8 = 2;
// `result` without payloads (`wasi:cli/run`'s result type).
pub const T_UNIT_RESULT: u8 = 3;

// `Def::kind`.
pub const D_RECORD: u8 = 0;
pub const D_VARIANT: u8 = 1;

// Primitive value type bytes of the component binary format.
const P_BOOL: u8 = 127;
const P_S8: u8 = 126;
const P_U8: u8 = 125;
const P_S16: u8 = 124;
const P_U16: u8 = 123;
const P_S32: u8 = 122;
pub const P_U32: u8 = 121;
const P_S64: u8 = 120;
const P_U64: u8 = 119;
const P_F32: u8 = 118;
const P_F64: u8 = 117;
const P_CHAR: u8 = 116;
pub const P_STRING: u8 = 115;

// Why a WIT is outside the subset (`Wit::err`).
pub const E_SYNTAX: u64 = 1;
pub const E_UNKNOWN_TYPE: u64 = 2;
pub const E_WORLD: u64 = 3;
pub const E_IMPORT: u64 = 4;

// Characters.
const C_TAB: u8 = 9;
const C_LF: u8 = 10;
const C_CR: u8 = 13;
const C_SPACE: u8 = 32;
const C_PERCENT: u8 = 37;
const C_LPAREN: u8 = 40;
const C_RPAREN: u8 = 41;
const C_COMMA: u8 = 44;
const C_MINUS: u8 = 45;
const C_COLON: u8 = 58;
const C_SEMI: u8 = 59;
const C_LT: u8 = 60;
const C_GT: u8 = 62;
const C_LBRACE: u8 = 123;
const C_RBRACE: u8 = 125;

// A type: a primitive (`data` is its byte), a tuple
// (`tuple_elems[data..data+elem_count]`), a definition (`data` is its `defs` row)
// or the unit result.
pub copy struct Ty {
    kind: u8,
    data: u64,
    elem_count: u64,
}

// A record or variant: its name `text[name_start..name_start+name_len]`, its fields
// or cases `fields[field_start..field_start+field_count]`, and its `tys` row.
pub copy struct Def {
    kind: u8,
    name_start: u64,
    name_len: u64,
    field_start: u64,
    field_count: u64,
    ty: u32,
}

// A record field, variant case (`ty` is NONE32 without a payload) or
// function parameter.
pub copy struct Field {
    name_start: u64,
    name_len: u64,
    ty: u32,
}

// A function: its name, its parameters `fields[param_start..param_start+param_count]`
// and its result (NONE32 for none).
pub copy struct Func {
    name_start: u64,
    name_len: u64,
    param_start: u64,
    param_count: u64,
    result: u32,
}

pub struct Wit {
    text: ChunkSeq[u8],
    tys: ChunkSeq[Ty],
    tuple_elems: ChunkSeq[u32],
    defs: ChunkSeq[Def],
    fields: ChunkSeq[Field],
    funcs: ChunkSeq[Func],
    // The world's exports in order: 0 = wasi:cli/run, 1 = entry.
    exports: ChunkSeq[u8],
    // The world's host imports in order (host.ves `H_*`).
    imports: ChunkSeq[u8],
    // `world plugin { export run: func(...) -> ...; }`: funcs[entry_start..].
    plugin: bool,
    // `funcs` row of wasi:cli/run's `run`.
    run_func: u64,
    // `funcs[entry_start..]` are the entry interface's functions.
    entry_start: u64,
    err: u64,
}

pub fn wit_new() -> Wit {
    Wit {
        text: ChunkSeq::new[u8](),
        tys: ChunkSeq::new[Ty](),
        tuple_elems: ChunkSeq::new[u32](),
        defs: ChunkSeq::new[Def](),
        fields: ChunkSeq::new[Field](),
        funcs: ChunkSeq::new[Func](),
        exports: ChunkSeq::new[u8](),
        imports: ChunkSeq::new[u8](),
        plugin: false,
        run_func: 0,
        entry_start: 0,
        err: 0,
    }
}

pub fn ty_at(in wit: Wit, ty_row: u32) -> Ty {
    match wit.tys.try_get(widen_u64(ty_row)) {
        Option::Some(x) => x,
        Option::None => Ty { kind: T_PRIM, data: 0, elem_count: 0 },
    }
}

pub fn def_at(in wit: Wit, def_row: u64) -> Def {
    match wit.defs.try_get(def_row) {
        Option::Some(x) => x,
        Option::None => Def {
            kind: 0,
            name_start: 0,
            name_len: 0,
            field_start: 0,
            field_count: 0,
            ty: 0
        },
    }
}

pub fn field_at(in wit: Wit, i: u64) -> Field {
    match wit.fields.try_get(i) {
        Option::Some(x) => x,
        Option::None => Field { name_start: 0, name_len: 0, ty: NONE32 },
    }
}

pub fn func_at(in wit: Wit, i: u64) -> Func {
    match wit.funcs.try_get(i) {
        Option::Some(x) => x,
        Option::None => Func {
            name_start: 0,
            name_len: 0,
            param_start: 0,
            param_count: 0,
            result: NONE32
        },
    }
}

pub fn arg_at(in wit: Wit, i: u64) -> u32 {
    match wit.tuple_elems.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

pub fn text_at(in wit: Wit, i: u64) -> u8 {
    match wit.text.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

fn byte(in bytes: Slice[u8], i: u64) -> u8 {
    match bytes.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

fn is_word(c: u8) -> bool {
    (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == C_MINUS
}

fn is_space(c: u8) -> bool {
    c == C_SPACE || c == C_LF || c == C_TAB || c == C_CR
}

// The reader: a position in the WIT bytes.
pub copy struct Cur {
    pos: u64,
}

fn skip(inout cursor: Cur, in src: Slice[u8]) {
    loop {
        if cursor.pos >= src.len() || !is_space(byte(in src, cursor.pos)) {
            break;
        }
        cursor.pos = inc(cursor.pos);
    }
}

// The next byte after blanks (0 at the end), not consumed.
fn peek(inout cursor: Cur, in src: Slice[u8]) -> u8 {
    skip(inout cursor, in src);
    byte(in src, cursor.pos)
}

fn punct(inout cursor: Cur, in src: Slice[u8], inout wit: Wit, expected: u8) {
    if peek(inout cursor, in src) == expected {
        cursor.pos = inc(cursor.pos);
    } else {
        wit.err = E_SYNTAX;
    }
}

// A word (`%` stripped): its bytes `src[start..end]`.
fn word(inout cursor: Cur, in src: Slice[u8], inout wit: Wit) -> (u64, u64) {
    skip(inout cursor, in src);
    if byte(in src, cursor.pos) == C_PERCENT {
        cursor.pos = inc(cursor.pos);
    }
    let start = cursor.pos;
    loop {
        if cursor.pos >= src.len() || !is_word(byte(in src, cursor.pos)) {
            break;
        }
        cursor.pos = inc(cursor.pos);
    }
    if cursor.pos == start {
        wit.err = E_SYNTAX;
    }
    (start, cursor.pos)
}

fn same(in text: Slice[u8], start: u64, end: u64, in lit: Slice[u8]) -> bool {
    if wrapping_sub(end, start) != lit.len() {
        return false;
    }
    for i in 0..lit.len() {
        if byte(in text, add(start, i)) != byte(in lit, i) {
            return false;
        }
    }
    true
}

fn keyword(inout cursor: Cur, in src: Slice[u8], inout wit: Wit, in lit: Slice[u8]) {
    let (start, end) = word(inout cursor, in src, inout wit);
    if !same(in src, start, end, in lit) {
        wit.err = E_SYNTAX;
    }
}

// Copy `src[start..end]` into the name text; its start.
fn name(inout wit: Wit, in src: Slice[u8], start: u64, end: u64) -> u64 {
    let name_at = wit.text.len();
    wit.text.extend(in src[start..end]);
    name_at
}

fn intern(inout wit: Wit, kind: u8, data: u64, elem_count: u64) -> u32 {
    for i in 0..wit.tys.len() {
        match wit.tys.try_get(i) {
            Option::Some(existing) => {
                if existing.kind == kind && existing.kind != T_TUPLE && existing.data == data {
                    return wrapping_u32(i);
                }
            },
            Option::None => {},
        }
    }
    let new_row = wrapping_u32(wit.tys.len());
    wit.tys.push(Ty { kind: kind, data: data, elem_count: elem_count });
    new_row
}

// A tuple of the `elem_count` element rows at `tuple_elems[elems_start..]`: an
// existing row with the same elements (dropping the new copy), else a new one.
fn intern_tuple(inout wit: Wit, elems_start: u64, elem_count: u64) -> u32 {
    for i in 0..wit.tys.len() {
        let existing = match wit.tys.try_get(i) {
            Option::Some(existing) => existing,
            Option::None => Ty { kind: T_PRIM, data: 0, elem_count: 0 },
        };
        if existing.kind == T_TUPLE && existing.elem_count == elem_count {
            let mut same_elems = true;
            for k in 0..elem_count {
                if arg_at(in wit, add(existing.data, k)) != arg_at(in wit, add(elems_start, k)) {
                    same_elems = false;
                    break;
                }
            }
            if same_elems {
                wit.tuple_elems.truncate(elems_start);
                return wrapping_u32(i);
            }
        }
    }
    let new_row = wrapping_u32(wit.tys.len());
    wit.tys.push(Ty { kind: T_TUPLE, data: elems_start, elem_count: elem_count });
    new_row
}

fn prim(in src: Slice[u8], start: u64, end: u64) -> u8 {
    if same(in src, start, end, in "bool".as_bytes()) {
        return P_BOOL;
    }
    if same(in src, start, end, in "s8".as_bytes()) {
        return P_S8;
    }
    if same(in src, start, end, in "u8".as_bytes()) {
        return P_U8;
    }
    if same(in src, start, end, in "s16".as_bytes()) {
        return P_S16;
    }
    if same(in src, start, end, in "u16".as_bytes()) {
        return P_U16;
    }
    if same(in src, start, end, in "s32".as_bytes()) {
        return P_S32;
    }
    if same(in src, start, end, in "u32".as_bytes()) {
        return P_U32;
    }
    if same(in src, start, end, in "s64".as_bytes()) {
        return P_S64;
    }
    if same(in src, start, end, in "u64".as_bytes()) {
        return P_U64;
    }
    if same(in src, start, end, in "f32".as_bytes()) {
        return P_F32;
    }
    if same(in src, start, end, in "f64".as_bytes()) {
        return P_F64;
    }
    if same(in src, start, end, in "char".as_bytes()) {
        return P_CHAR;
    }
    if same(in src, start, end, in "string".as_bytes()) {
        return P_STRING;
    }
    0
}

// The definition named `src[start..end]`, or NONE32.
fn find_def(in wit: Wit, in src: Slice[u8], start: u64, end: u64) -> u32 {
    for i in 0..wit.defs.len() {
        let candidate = def_at(in wit, i);
        if candidate.name_len == wrapping_sub(end, start) {
            let mut matches = true;
            for k in 0..candidate.name_len {
                if text_at(in wit, add(candidate.name_start, k)) != byte(in src, add(start, k)) {
                    matches = false;
                    break;
                }
            }
            if matches {
                return candidate.ty;
            }
        }
    }
    NONE32
}

fn ty(inout cursor: Cur, in src: Slice[u8], inout wit: Wit, depth: u64) -> u32 {
    if depth > 64 {
        wit.err = E_SYNTAX;
        return 0;
    }
    let named = peek(inout cursor, in src) == C_PERCENT;
    let (start, end) = word(inout cursor, in src, inout wit);
    if wit.err != 0 {
        return 0;
    }
    if !named && same(in src, start, end, in "tuple".as_bytes()) {
        punct(inout cursor, in src, inout wit, C_LT);
        let mut elems = ChunkSeq::new[u32]();
        loop {
            if wit.err != 0 {
                return 0;
            }
            elems.push(ty(inout cursor, in src, inout wit, inc(depth)));
            if peek(inout cursor, in src) == C_COMMA {
                cursor.pos = inc(cursor.pos);
            } else {
                break;
            }
        }
        punct(inout cursor, in src, inout wit, C_GT);
        let elems_start = wit.tuple_elems.len();
        wit.tuple_elems.extend(in elems.as_slice());
        return intern_tuple(inout wit, elems_start, elems.len());
    }
    if !named {
        let prim_byte = prim(in src, start, end);
        if prim_byte != 0 {
            return intern(inout wit, T_PRIM, widen_u64(prim_byte), 0);
        }
    }
    let def_ty = find_def(in wit, in src, start, end);
    if def_ty == NONE32 {
        wit.err = E_UNKNOWN_TYPE;
        return 0;
    }
    def_ty
}

// `record %n { %f: ty, ... }` or `variant %n { %c, %c(ty), ... }`.
fn def(inout cursor: Cur, in src: Slice[u8], inout wit: Wit, kind: u8) {
    let (start, end) = word(inout cursor, in src, inout wit);
    punct(inout cursor, in src, inout wit, C_LBRACE);
    let mut items = ChunkSeq::new[Field]();
    loop {
        if wit.err != 0 || peek(inout cursor, in src) == C_RBRACE {
            break;
        }
        let (field_name_start, field_name_end) = word(inout cursor, in src, inout wit);
        let mut field_ty = NONE32;
        if kind == D_RECORD {
            punct(inout cursor, in src, inout wit, C_COLON);
            field_ty = ty(inout cursor, in src, inout wit, 0);
        } else if peek(inout cursor, in src) == C_LPAREN {
            cursor.pos = inc(cursor.pos);
            field_ty = ty(inout cursor, in src, inout wit, 0);
            punct(inout cursor, in src, inout wit, C_RPAREN);
        }
        let field_name_at = name(inout wit, in src, field_name_start, field_name_end);
        items.push(Field {
            name_start: field_name_at,
            name_len: wrapping_sub(field_name_end, field_name_start),
            ty: field_ty
        });
        if peek(inout cursor, in src) == C_COMMA {
            cursor.pos = inc(cursor.pos);
        }
    }
    punct(inout cursor, in src, inout wit, C_RBRACE);
    if wit.err != 0 {
        return;
    }
    let first_field = wit.fields.len();
    wit.fields.extend(in items.as_slice());
    let name_at = name(inout wit, in src, start, end);
    let def_row = wit.defs.len();
    let def_ty = intern(inout wit, T_NAMED, def_row, 0);
    wit.defs.push(Def {
        kind: kind,
        name_start: name_at,
        name_len: wrapping_sub(end, start),
        field_start: first_field,
        field_count: items.len(),
        ty: def_ty
    });
}

// `name: func(%p: ty, ...) [-> ty];` after its name `src[start..end]`.
fn func(inout cursor: Cur, in src: Slice[u8], inout wit: Wit, start: u64, end: u64) {
    punct(inout cursor, in src, inout wit, C_COLON);
    keyword(inout cursor, in src, inout wit, in "func".as_bytes());
    punct(inout cursor, in src, inout wit, C_LPAREN);
    let mut params = ChunkSeq::new[Field]();
    loop {
        if wit.err != 0 || peek(inout cursor, in src) == C_RPAREN {
            break;
        }
        let (param_name_start, param_name_end) = word(inout cursor, in src, inout wit);
        punct(inout cursor, in src, inout wit, C_COLON);
        let param_ty = ty(inout cursor, in src, inout wit, 0);
        let param_name_at = name(inout wit, in src, param_name_start, param_name_end);
        params.push(Field {
            name_start: param_name_at,
            name_len: wrapping_sub(param_name_end, param_name_start),
            ty: param_ty
        });
        if peek(inout cursor, in src) == C_COMMA {
            cursor.pos = inc(cursor.pos);
        }
    }
    punct(inout cursor, in src, inout wit, C_RPAREN);
    let mut result = NONE32;
    if peek(inout cursor, in src) == C_MINUS {
        cursor.pos = inc(cursor.pos);
        punct(inout cursor, in src, inout wit, C_GT);
        result = ty(inout cursor, in src, inout wit, 0);
    }
    punct(inout cursor, in src, inout wit, C_SEMI);
    if wit.err != 0 {
        return;
    }
    let first_param = wit.fields.len();
    wit.fields.extend(in params.as_slice());
    let name_at = name(inout wit, in src, start, end);
    wit.funcs.push(Func {
        name_start: name_at,
        name_len: wrapping_sub(end, start),
        param_start: first_param,
        param_count: params.len(),
        result: result
    });
}

// The text of a world item up to its `;`, blanks removed.
fn item(inout cursor: Cur, in src: Slice[u8], inout wit: Wit) -> ChunkSeq[u8] {
    let mut out = ChunkSeq::new[u8]();
    loop {
        if cursor.pos >= src.len() {
            wit.err = E_SYNTAX;
            break;
        }
        let ch = byte(in src, cursor.pos);
        cursor.pos = inc(cursor.pos);
        if ch == C_SEMI {
            break;
        }
        if !is_space(ch) {
            out.push(ch);
        }
    }
    out
}

fn world(inout cursor: Cur, in src: Slice[u8], inout wit: Wit) {
    keyword(inout cursor, in src, inout wit, in "program".as_bytes());
    punct(inout cursor, in src, inout wit, C_LBRACE);
    loop {
        if wit.err != 0 || peek(inout cursor, in src) == C_RBRACE {
            break;
        }
        let (start, end) = word(inout cursor, in src, inout wit);
        let item_bytes = item(inout cursor, in src, inout wit);
        let item_text = item_bytes.as_slice();
        if same(in src, start, end, in "import".as_bytes()) {
            let host = host_import(in item_text);
            if host == 255 {
                wit.err = E_IMPORT;
                return;
            }
            wit.imports.push(host);
            continue;
        }
        if !same(in src, start, end, in "export".as_bytes()) {
            wit.err = E_WORLD;
            return;
        }
        if same(in item_text, 0, item_text.len(), in "wasi:cli/run@0.2.0".as_bytes()) {
            wit.exports.push(0);
        } else if same(in item_text, 0, item_text.len(), in "entry".as_bytes()) {
            wit.exports.push(1);
        } else {
            wit.err = E_WORLD;
            return;
        }
    }
    punct(inout cursor, in src, inout wit, C_RBRACE);
}

// `world plugin { export run: func(...) -> ...; }` after `world` (the
// Nexus plugin world: its functions are `funcs[entry_start..]`).
fn plugin(inout cursor: Cur, in src: Slice[u8], inout wit: Wit) {
    wit.plugin = true;
    keyword(inout cursor, in src, inout wit, in "plugin".as_bytes());
    punct(inout cursor, in src, inout wit, C_LBRACE);
    loop {
        if wit.err != 0 || peek(inout cursor, in src) == C_RBRACE {
            break;
        }
        keyword(inout cursor, in src, inout wit, in "export".as_bytes());
        let (start, end) = word(inout cursor, in src, inout wit);
        func(inout cursor, in src, inout wit, start, end);
    }
    punct(inout cursor, in src, inout wit, C_RBRACE);
    if wit.err == 0 && wit.funcs.len() == wit.entry_start {
        wit.err = E_WORLD;
    }
    if wit.err == 0 && peek(inout cursor, in src) != 0 {
        wit.err = E_SYNTAX;
    }
}

// Read the backend's WIT; `err` is 0 when it is inside the subset.
pub fn parse(in src: Slice[u8]) -> Wit {
    let mut wit = wit_new();
    let mut cursor = Cur { pos: 0 };
    keyword(inout cursor, in src, inout wit, in "package".as_bytes());
    let item_bytes = item(inout cursor, in src, inout wit);
    let package_name = item_bytes.as_slice();
    if !same(in package_name, 0, package_name.len(), in "vesper:program@0.1.0".as_bytes()) {
        wit.err = E_WORLD;
        return wit;
    }
    // wasi:cli/run's `run: func() -> result`.
    let result_ty = intern(inout wit, T_UNIT_RESULT, 0, 0);
    let run_name = wit.text.len();
    wit.text.extend(in "run".as_bytes());
    wit.run_func = wit.funcs.len();
    wit.funcs.push(Func {
        name_start: run_name,
        name_len: 3,
        param_start: 0,
        param_count: 0,
        result: result_ty
    });
    wit.entry_start = wit.funcs.len();
    let (kw_start, kw_end) = word(inout cursor, in src, inout wit);
    if same(in src, kw_start, kw_end, in "world".as_bytes()) {
        plugin(inout cursor, in src, inout wit);
        return wit;
    }
    if !same(in src, kw_start, kw_end, in "interface".as_bytes()) {
        wit.err = E_SYNTAX;
    }
    keyword(inout cursor, in src, inout wit, in "entry".as_bytes());
    punct(inout cursor, in src, inout wit, C_LBRACE);
    loop {
        if wit.err != 0 || peek(inout cursor, in src) == C_RBRACE {
            break;
        }
        let (start, end) = word(inout cursor, in src, inout wit);
        if same(in src, start, end, in "record".as_bytes()) {
            def(inout cursor, in src, inout wit, D_RECORD);
        } else if same(in src, start, end, in "variant".as_bytes()) {
            def(inout cursor, in src, inout wit, D_VARIANT);
        } else {
            func(inout cursor, in src, inout wit, start, end);
        }
    }
    punct(inout cursor, in src, inout wit, C_RBRACE);
    keyword(inout cursor, in src, inout wit, in "world".as_bytes());
    world(inout cursor, in src, inout wit);
    if wit.err == 0 && peek(inout cursor, in src) != 0 {
        wit.err = E_SYNTAX;
    }
    wit
}
