// The host interfaces a backend world imports (`src/wasm_backend/host.rs`
// and `packages/vesper-wasm-backend/src/host.ves`: wasi:cli/stdout with
// wasi:io, wasi:clocks/monotonic-clock, vesper:beacon/trace,
// wasi:cli/environment, and wasi:filesystem/{types,preopens} with
// wasi:clocks/wall-clock), and the core modules wit-component writes to
// lower them.
//
// wit-component encodes each imported interface as an instance type from
// the WIT `Resolve`. The backend's host WIT is fixed (`IO_WIT`, `CLI_WIT`,
// `CLOCKS_WIT`, `FILESYSTEM_WIT`, `BEACON_WIT`), so their instance types
// are kept here as wit-component writes them; tests/self_host_wit_component.rs
// compares every component with host imports against Rust's, byte for
// byte.

use @vesper/check-data::util::{add, inc};

const NONE32: u32 = 4294967295;

// The world's host imports (`Wit::imports`).
const H_STDOUT: u8 = 0;
const H_CLOCK: u8 = 1;
const H_TRACE: u8 = 2;
const H_ENV: u8 = 3;
const H_FS_TYPES: u8 = 4;
const H_FS_PREOPENS: u8 = 5;

// The instance types wit-component imports, in topological order within
// each capability dependency chain.
const IF_ERROR: u8 = 0;
const IF_STREAMS: u8 = 1;
const IF_STDOUT: u8 = 2;
const IF_CLOCK: u8 = 3;
const IF_TRACE: u8 = 4;
const IF_ENV: u8 = 5;
const IF_WALL_CLOCK: u8 = 6;
const IF_FS_TYPES: u8 = 7;
const IF_FS_PREOPENS: u8 = 8;
const IF_COUNT: u64 = 9;

// How a core import lowers (`LowerKind`).
const L_NONE: u8 = 0;
// `canon lower` without options, straight into the core instance.
const L_DIRECT: u8 = 1;
// Through the shim table, lowered with `memory` (optionally `realloc`, `utf8`).
const L_MEMORY: u8 = 2;
const L_MEMORY_UTF8: u8 = 3;
const L_MEMORY_REALLOC: u8 = 4;
const L_MEMORY_REALLOC_UTF8: u8 = 5;
// `[resource-drop]<name>`: `canon resource.drop` of the aliased type.
const L_DROP: u8 = 6;

// Core value types and type forms.
const VT_REF_NULL: u8 = 99;
const VT_REF: u8 = 100;
const FORM_FUNC: u8 = 96;
const FORM_CONT: u8 = 93;
const EXTERN_FUNC: u8 = 0;
const EXTERN_TABLE: u8 = 1;
const TYPE_FUNCREF: u8 = 112;
const LIMITS_WITH_MAX: u8 = 1;
const ELEM_ACTIVE_DEFAULT_TABLE: u8 = 0;
const OP_LOCAL_GET: u8 = 32;
const OP_CALL_INDIRECT: u8 = 17;
const OP_I32_CONST: u8 = 65;
const OP_END: u8 = 11;

const CORE_HEADER_BYTES: u64 = 8;
const S_TYPE: u8 = 1;
const S_IMPORT: u8 = 2;
const S_FUNCTION: u8 = 3;
const S_TABLE: u8 = 4;
const S_EXPORT: u8 = 7;
const S_ELEMENT: u8 = 9;
const S_CODE: u8 = 10;

fn byte(in bytes: Slice[u8], i: u64) -> u8 {
    match bytes.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

pub fn put_uleb(inout out: ChunkSeq[u8], v: u64) {
    let mut rest = v;
    loop {
        let group = wrapping_u8(rest & 127);
        rest = rest >> 7;
        if rest == 0 {
            out.push(group);
            break;
        }
        out.push(group | 128);
    }
}

fn put_sleb(inout out: ChunkSeq[u8], v: u64) {
    let mut rest = v;
    loop {
        let group = wrapping_u8(rest & 127);
        rest = rest >> 7;
        if rest == 0 && (group & 64) == 0 {
            out.push(group);
            break;
        }
        out.push(group | 128);
    }
}

fn put_bytes(inout out: ChunkSeq[u8], in bytes: Slice[u8]) {
    put_uleb(inout out, bytes.len());
    out.extend(in bytes);
}

// `n` in decimal (the shim's export names).
pub fn put_decimal(inout out: ChunkSeq[u8], n: u64) {
    let mut digits = ChunkSeq::new[u8]();
    let mut rest = n;
    loop {
        digits.push(wrapping_add(48, wrapping_u8(rest % 10)));
        rest = rest / 10;
        if rest == 0 {
            break;
        }
    }
    let mut k = digits.len();
    loop {
        if k == 0 {
            break;
        }
        k = wrapping_sub(k, 1);
        out.push(byte(in digits.as_slice(), k));
    }
}

fn at64(in s: Slice[u64], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

pub fn eq(in a: Slice[u8], in b: Slice[u8]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for i in 0..a.len() {
        if byte(in a, i) != byte(in b, i) {
            return false;
        }
    }
    true
}

fn hex_digit(c: u8) -> u8 {
    if c >= 97 {
        wrapping_sub(c, 87)
    } else {
        wrapping_sub(c, 48)
    }
}

// The bytes of hex text `hex`.
fn unhex(inout out: ChunkSeq[u8], in hex: Slice[u8]) {
    let mut i: u64 = 0;
    loop {
        if inc(i) >= hex.len() {
            break;
        }
        let hi = hex_digit(byte(in hex, i));
        let lo = hex_digit(byte(in hex, inc(i)));
        out.push(wrapping_add(wrapping_mul(hi, 16), lo));
        i = add(i, 2);
    }
}

fn at32(in s: Slice[u32], i: u64) -> u32 {
    match s.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

fn spliced_instance_type(
    inout out: ChunkSeq[u8],
    in prefix: Slice[u8],
    dep_alias: u32,
    in suffix: Slice[u8]
) {
    unhex(inout out, in prefix);
    put_uleb(inout out, widen_u64(dep_alias));
    unhex(inout out, in suffix);
}

// ------------------------------------------------------- host interfaces

pub fn if_count() -> u64 {
    IF_COUNT
}

pub fn needs_descriptor_alias(host: u8) -> bool {
    host == H_FS_PREOPENS
}

pub fn lower_ok(kind: u8) -> bool {
    kind != L_NONE
}

pub fn lower_is_drop(kind: u8) -> bool {
    kind == L_DROP
}

pub fn lower_is_indirect(kind: u8) -> bool {
    kind == L_MEMORY
        || kind == L_MEMORY_UTF8
        || kind == L_MEMORY_REALLOC
        || kind == L_MEMORY_REALLOC_UTF8
}

pub fn lower_uses_realloc(kind: u8) -> bool {
    kind == L_MEMORY_REALLOC || kind == L_MEMORY_REALLOC_UTF8
}

pub fn lower_uses_utf8(kind: u8) -> bool {
    kind == L_MEMORY_UTF8 || kind == L_MEMORY_REALLOC_UTF8
}

// The interfaces a world import of host capability `host` brings, in
// topological order (`n` of them from `first`).
pub fn import_ifaces(host: u8) -> (u8, u64) {
    if host == H_STDOUT {
        (IF_ERROR, 3)
    } else if host == H_CLOCK {
        (IF_CLOCK, 1)
    } else if host == H_TRACE {
        (IF_TRACE, 1)
    } else if host == H_ENV {
        (IF_ENV, 1)
    } else if host == H_FS_TYPES {
        (IF_WALL_CLOCK, 2)
    } else {
        (IF_WALL_CLOCK, 3)
    }
}

// Host capability of a world import's name; 255 if none.
pub fn host_import(in name: Slice[u8]) -> u8 {
    if eq(in name, in "wasi:cli/stdout@0.2.0".as_bytes()) {
        H_STDOUT
    } else if eq(in name, in "wasi:clocks/monotonic-clock@0.2.0".as_bytes()) {
        H_CLOCK
    } else if eq(in name, in "vesper:beacon/trace@0.1.0".as_bytes()) {
        H_TRACE
    } else if eq(in name, in "wasi:cli/environment@0.2.0".as_bytes()) {
        H_ENV
    } else if eq(in name, in "wasi:filesystem/types@0.2.0".as_bytes()) {
        H_FS_TYPES
    } else if eq(in name, in "wasi:filesystem/preopens@0.2.0".as_bytes()) {
        H_FS_PREOPENS
    } else {
        255
    }
}

pub fn host_name(iface: u8, inout out: ChunkSeq[u8]) {
    if iface == IF_ERROR {
        out.extend(in "wasi:io/error@0.2.0".as_bytes());
    } else if iface == IF_STREAMS {
        out.extend(in "wasi:io/streams@0.2.0".as_bytes());
    } else if iface == IF_STDOUT {
        out.extend(in "wasi:cli/stdout@0.2.0".as_bytes());
    } else if iface == IF_CLOCK {
        out.extend(in "wasi:clocks/monotonic-clock@0.2.0".as_bytes());
    } else if iface == IF_TRACE {
        out.extend(in "vesper:beacon/trace@0.1.0".as_bytes());
    } else if iface == IF_ENV {
        out.extend(in "wasi:cli/environment@0.2.0".as_bytes());
    } else if iface == IF_WALL_CLOCK {
        out.extend(in "wasi:clocks/wall-clock@0.2.0".as_bytes());
    } else if iface == IF_FS_TYPES {
        out.extend(in "wasi:filesystem/types@0.2.0".as_bytes());
    } else {
        out.extend(in "wasi:filesystem/preopens@0.2.0".as_bytes());
    }
}

// The interface named `name`; 255 if it is not a host interface.
pub fn iface_of(in name: Slice[u8]) -> u8 {
    for i in 0..IF_COUNT {
        let mut candidate = ChunkSeq::new[u8]();
        host_name(wrapping_u8(i), inout candidate);
        if eq(in candidate.as_slice(), in name) {
            return wrapping_u8(i);
        }
    }
    255
}

// The instance type of interface `iface` (one type-section item).
pub fn instance_type(iface: u8, in alias_types: Slice[u32], inout out: ChunkSeq[u8]) {
    if iface == IF_ERROR {
        // (instance (export "error" (type (sub resource))))
        unhex(inout out, in "42010400056572726f720301".as_bytes());
    } else if iface == IF_STREAMS {
        // output-stream, error (outer), stream-error and
        // [method]output-stream.blocking-write-and-flush
        spliced_instance_type(
            inout out,
            in "420b04000d6f75747075742d73747265616d030102030201".as_bytes(),
            at32(in alias_types, widen_u64(IF_ERROR)),
            in ""
                .as_bytes()
        );
    } else if iface == IF_STDOUT {
        // output-stream (outer) and get-stdout
        spliced_instance_type(
            inout out,
            in "420502030201".as_bytes(),
            at32(in alias_types, widen_u64(IF_STREAMS)),
            in "04000d6f75747075742d73747265616d030000016901014000000204000a6765742d7374646f75740103"
                .as_bytes()
        );
    } else if iface == IF_CLOCK {
        // instant and now
        unhex(
            inout out,
            in "42040177040007696e7374616e7403000001400000010400036e6f770102".as_bytes()
        );
    } else if iface == IF_TRACE {
        // span-context, active-span, telemetry-attr and the six functions
        unhex(
            inout out,
            in ""
                .as_bytes()
        );
    } else if iface == IF_ENV {
        // get-environment, get-arguments, initial-cwd
        unhex(
            inout out,
            in "420a016f027373017000014000000104000f6765742d656e7669726f6e6d656e740102017073014000000304000d6765742d617267756d656e74730104016b73014000000504000b696e697469616c2d6377640106"
                .as_bytes()
        );
    } else if iface == IF_WALL_CLOCK {
        // datetime
        unhex(
            inout out,
            in "4202017202077365636f6e6473770b6e616e6f7365636f6e6473790400086461746574696d65030000"
                .as_bytes()
        );
    } else if iface == IF_FS_TYPES {
        // descriptor, directory-entry-stream, datetime (outer), stats and methods
        spliced_instance_type(
            inout out,
            in ""
                .as_bytes(),
            at32(in alias_types, widen_u64(IF_WALL_CLOCK)),
            in ""
                .as_bytes()
        );
    } else {
        // descriptor (outer) and get-directories
        spliced_instance_type(
            inout out,
            in "420702030201".as_bytes(),
            at32(in alias_types, widen_u64(IF_FS_TYPES)),
            in "04000a64657363726970746f72030000016901016f020273017003014000000404000f6765742d6469726563746f726965730105"
                .as_bytes()
        );
    }
}

// The type interface `iface` exports that later interfaces alias (`error`,
// `output-stream`, `datetime`, `descriptor`); empty for none.
pub fn aliased_type(iface: u8, need_descriptor: bool, inout out: ChunkSeq[u8]) {
    if iface == IF_ERROR {
        out.extend(in "error".as_bytes());
    } else if iface == IF_STREAMS {
        out.extend(in "output-stream".as_bytes());
    } else if iface == IF_WALL_CLOCK {
        out.extend(in "datetime".as_bytes());
    } else if iface == IF_FS_TYPES && need_descriptor {
        out.extend(in "descriptor".as_bytes());
    }
}

// How function `func` of interface `iface` lowers: whether it needs the memory,
// cabi_realloc, and/or UTF-8 (`LoweringInfo` of wit-component's `encoding`).
pub fn lower_kind(iface: u8, in func: Slice[u8]) -> u8 {
    if iface == IF_STDOUT {
        if eq(in func, in "get-stdout".as_bytes()) {
            return L_DIRECT;
        }
    } else if iface == IF_STREAMS {
        if eq(in func, in "[method]output-stream.blocking-write-and-flush".as_bytes()) {
            return L_MEMORY;
        }
        if eq(in func, in "[resource-drop]output-stream".as_bytes()) {
            return L_DROP;
        }
    } else if iface == IF_CLOCK {
        if eq(in func, in "now".as_bytes()) {
            return L_DIRECT;
        }
    } else if iface == IF_TRACE {
        if eq(in func, in "current-ctx".as_bytes()) {
            return L_MEMORY;
        }
        if eq(in func, in "start-span".as_bytes())
            || eq(in func, in "start-child".as_bytes())
            || eq(in func, in "emit-err".as_bytes()) {
            return L_MEMORY_UTF8;
        }
        if eq(in func, in "emit-ok".as_bytes()) || eq(in func, in "emit-attr".as_bytes()) {
            return L_DIRECT;
        }
    } else if iface == IF_ENV {
        if eq(in func, in "get-arguments".as_bytes())
            || eq(in func, in "get-environment".as_bytes())
            || eq(in func, in "initial-cwd".as_bytes()) {
            return L_MEMORY_REALLOC_UTF8;
        }
    } else if iface == IF_FS_PREOPENS {
        if eq(in func, in "get-directories".as_bytes()) {
            return L_MEMORY_REALLOC_UTF8;
        }
    } else if iface == IF_FS_TYPES {
        if eq(in func, in "[method]descriptor.read".as_bytes()) {
            return L_MEMORY_REALLOC;
        }
        if eq(in func, in "[method]directory-entry-stream.read-directory-entry".as_bytes()) {
            return L_MEMORY_REALLOC_UTF8;
        }
        if eq(in func, in "[method]descriptor.open-at".as_bytes())
            || eq(in func, in "[method]descriptor.stat-at".as_bytes())
            || eq(in func, in "[method]descriptor.create-directory-at".as_bytes())
            || eq(in func, in "[method]descriptor.remove-directory-at".as_bytes())
            || eq(in func, in "[method]descriptor.unlink-file-at".as_bytes())
            || eq(in func, in "[method]descriptor.rename-at".as_bytes()) {
            return L_MEMORY_UTF8;
        }
        if eq(in func, in "[method]descriptor.write".as_bytes())
            || eq(in func, in "[method]descriptor.stat".as_bytes())
            || eq(in func, in "[method]descriptor.sync".as_bytes())
            || eq(in func, in "[method]descriptor.read-directory".as_bytes()) {
            return L_MEMORY;
        }
        if eq(in func, in "[resource-drop]descriptor".as_bytes())
            || eq(in func, in "[resource-drop]directory-entry-stream".as_bytes()) {
            return L_DROP;
        }
    }
    L_NONE
}

// ------------------------------------------------- the core module's imports

// A core function type: its parameter and result value types
// (`bytes[param_start..param_start+param_len]`, `param_count` of them; likewise the results).
pub copy struct Sig {
    param_start: u64,
    param_len: u64,
    param_count: u64,
    result_start: u64,
    result_len: u64,
    result_count: u64,
}

// A function import: module `text[module_start..module_start+module_len]`, field
// `text[field_start..field_start+field_len]`, type `ty`.
pub copy struct Imp {
    module_start: u64,
    module_len: u64,
    field_start: u64,
    field_len: u64,
    ty: u64,
}

pub struct Core {
    // false when the module is outside what the port reads.
    ok: bool,
    bytes: ChunkSeq[u8],
    sigs: ChunkSeq[Sig],
    text: ChunkSeq[u8],
    imports: ChunkSeq[Imp],
}

pub fn imp_at(in core: Core, i: u64) -> Imp {
    match core.imports.try_get(i) {
        Option::Some(x) => x,
        Option::None => Imp { module_start: 0, module_len: 0, field_start: 0, field_len: 0, ty: 0 },
    }
}

pub fn sig_at(in core: Core, i: u64) -> Sig {
    match core.sigs.try_get(i) {
        Option::Some(x) => x,
        Option::None => Sig {
            param_start: 0,
            param_len: 0,
            param_count: 0,
            result_start: 0,
            result_len: 0,
            result_count: 0
        },
    }
}

copy struct Rd {
    pos: u64,
    ok: bool,
}

fn rd_byte(inout reader: Rd, in wasm: Slice[u8]) -> u8 {
    if reader.pos >= wasm.len() {
        reader.ok = false;
        return 0;
    }
    let value = byte(in wasm, reader.pos);
    reader.pos = inc(reader.pos);
    value
}

fn rd_leb(inout reader: Rd, in wasm: Slice[u8]) -> u64 {
    let mut value: u64 = 0;
    let mut shift: u64 = 0;
    loop {
        let group = rd_byte(inout reader, in wasm);
        if !reader.ok || shift > 56 {
            reader.ok = false;
            return 0;
        }
        value = value | wrapping_shl_u64(widen_u64(group & 127), wrapping_u32(shift));
        shift = add(shift, 7);
        if (group & 128) == 0 {
            return value;
        }
    }
}

// A value-type vector into `core.bytes`: its start, byte length and count.
fn valtypes(inout reader: Rd, in wasm: Slice[u8], inout core: Core) -> (u64, u64, u64) {
    let count = rd_leb(inout reader, in wasm);
    let start = core.bytes.len();
    for k in 0..count {
        if !reader.ok {
            break;
        }
        let valtype = rd_byte(inout reader, in wasm);
        core.bytes.push(valtype);
        if valtype == VT_REF || valtype == VT_REF_NULL {
            // the heap type (s33)
            loop {
                let heap_byte = rd_byte(inout reader, in wasm);
                core.bytes.push(heap_byte);
                if !reader.ok || (heap_byte & 128) == 0 {
                    break;
                }
            }
        }
    }
    (start, wrapping_sub(core.bytes.len(), start), count)
}

// The function types and function imports of core module `wasm`.
pub fn read_core(in wasm: Slice[u8]) -> Core {
    let mut core = Core {
        ok: true,
        bytes: ChunkSeq::new[u8](),
        sigs: ChunkSeq::new[Sig](),
        text: ChunkSeq::new[u8](),
        imports: ChunkSeq::new[Imp](),
    };
    let mut reader = Rd { pos: CORE_HEADER_BYTES, ok: wasm.len() >= CORE_HEADER_BYTES };
    loop {
        if !reader.ok || reader.pos >= wasm.len() {
            break;
        }
        let id = rd_byte(inout reader, in wasm);
        let size = rd_leb(inout reader, in wasm);
        let end = add(reader.pos, size);
        if !reader.ok || end > wasm.len() {
            core.ok = false;
            return core;
        }
        if id == S_TYPE {
            let count = rd_leb(inout reader, in wasm);
            for k in 0..count {
                let form = rd_byte(inout reader, in wasm);
                if form == FORM_CONT {
                    rd_leb(inout reader, in wasm);
                    core.sigs.push(Sig {
                        param_start: 0,
                        param_len: 0,
                        param_count: 0,
                        result_start: 0,
                        result_len: 0,
                        result_count: 0
                    });
                } else if form == FORM_FUNC {
                    let (param_start, param_len, param_count) = valtypes(
                        inout reader,
                        in wasm,
                        inout core
                    );
                    let (result_start, result_len, result_count) = valtypes(
                        inout reader,
                        in wasm,
                        inout core
                    );
                    core.sigs.push(Sig {
                        param_start: param_start,
                        param_len: param_len,
                        param_count: param_count,
                        result_start: result_start,
                        result_len: result_len,
                        result_count: result_count
                    });
                } else {
                    core.ok = false;
                    return core;
                }
            }
        } else if id == S_IMPORT {
            let count = rd_leb(inout reader, in wasm);
            for k in 0..count {
                let module_len = rd_leb(inout reader, in wasm);
                let module_start = core.text.len();
                for j in 0..module_len {
                    core.text.push(rd_byte(inout reader, in wasm));
                }
                let field_len = rd_leb(inout reader, in wasm);
                let field_start = core.text.len();
                for j in 0..field_len {
                    core.text.push(rd_byte(inout reader, in wasm));
                }
                if rd_byte(inout reader, in wasm) != EXTERN_FUNC {
                    core.ok = false;
                    return core;
                }
                let sig_index = rd_leb(inout reader, in wasm);
                core.imports.push(Imp {
                    module_start: module_start,
                    module_len: module_len,
                    field_start: field_start,
                    field_len: field_len,
                    ty: sig_index
                });
            }
        }
        if !reader.ok || reader.pos > end {
            core.ok = false;
            return core;
        }
        reader.pos = end;
    }
    core.ok = reader.ok;
    core
}

// ------------------------------------------- the shim and fixup modules

fn section(inout out: ChunkSeq[u8], id: u8, in body: Slice[u8]) {
    out.push(id);
    put_bytes(inout out, in body);
}

fn module_head(inout out: ChunkSeq[u8]) {
    // "\0asm", version 1
    out.push(0);
    out.push(97);
    out.push(115);
    out.push(109);
    out.push(1);
    out.push(0);
    out.push(0);
    out.push(0);
}

fn same_core_sig(in core: Core, first: u64, second: u64) -> bool {
    let first_sig = sig_at(in core, first);
    let second_sig = sig_at(in core, second);
    first_sig.param_count == second_sig.param_count
        && first_sig.result_count == second_sig.result_count
        && eq(
            in core.bytes[first_sig.param_start..add(first_sig.param_start, first_sig.param_len)],
            in core.bytes[second_sig.param_start..add(second_sig.param_start, second_sig.param_len)]
        )
        && eq(
            in core.bytes[
                first_sig.result_start..add(first_sig.result_start, first_sig.result_len)
            ],
            in core.bytes[
                second_sig.result_start..add(second_sig.result_start, second_sig.result_len)
            ]
        )
}

fn dedup_sigs(in core: Core, in sigs: Slice[u64]) -> (ChunkSeq[u64], ChunkSeq[u64]) {
    let mut unique = ChunkSeq::new[u64]();
    let mut type_of = ChunkSeq::new[u64]();
    for k in 0..sigs.len() {
        let sig = at64(in sigs, k);
        let mut found = unique.len();
        for u in 0..unique.len() {
            if same_core_sig(in core, at64(in unique.as_slice(), u), sig) {
                found = u;
                break;
            }
        }
        if found == unique.len() {
            unique.push(sig);
        }
        type_of.push(found);
    }
    (unique, type_of)
}

fn func_types(in core: Core, in sigs: Slice[u64], inout out: ChunkSeq[u8]) {
    put_uleb(inout out, sigs.len());
    for k in 0..sigs.len() {
        let sig = sig_at(in core, at64(in sigs, k));
        out.push(FORM_FUNC);
        put_uleb(inout out, sig.param_count);
        out.extend(in core.bytes[sig.param_start..add(sig.param_start, sig.param_len)]);
        put_uleb(inout out, sig.result_count);
        out.extend(in core.bytes[sig.result_start..add(sig.result_start, sig.result_len)]);
    }
}

fn table_type(size: u64, inout out: ChunkSeq[u8]) {
    // funcref, limits n..n
    out.push(TYPE_FUNCREF);
    out.push(LIMITS_WITH_MAX);
    put_uleb(inout out, size);
    put_uleb(inout out, size);
}

// `wit-component-shim-module`: function k (type_of[k], the core signature
// of the k-th indirectly lowered import) calls table slot k, which the
// fixup module fills with the real lowering.
pub fn shim_module(
    in core: Core,
    in sigs: Slice[u64],
    in producers: Slice[u8],
    inout out: ChunkSeq[u8]
) {
    let n = sigs.len();
    let (unique, type_of) = dedup_sigs(in core, in sigs);
    module_head(inout out);
    let mut body = ChunkSeq::new[u8]();
    func_types(in core, in unique.as_slice(), inout body);
    section(inout out, S_TYPE, in body.as_slice());
    body.clear();
    put_uleb(inout body, n);
    for k in 0..n {
        put_uleb(inout body, at64(in type_of.as_slice(), k));
    }
    section(inout out, S_FUNCTION, in body.as_slice());
    body.clear();
    put_uleb(inout body, 1);
    table_type(n, inout body);
    section(inout out, S_TABLE, in body.as_slice());
    body.clear();
    put_uleb(inout body, inc(n));
    for k in 0..n {
        let mut name = ChunkSeq::new[u8]();
        put_decimal(inout name, k);
        put_bytes(inout body, in name.as_slice());
        body.push(EXTERN_FUNC);
        put_uleb(inout body, k);
    }
    put_bytes(inout body, in "$imports".as_bytes());
    // table 0
    body.push(EXTERN_TABLE);
    body.push(0);
    section(inout out, S_EXPORT, in body.as_slice());
    body.clear();
    put_uleb(inout body, n);
    for k in 0..n {
        let sig = sig_at(in core, at64(in sigs, k));
        let mut code = ChunkSeq::new[u8]();
        // no locals
        code.push(0);
        for param in 0..sig.param_count {
            code.push(OP_LOCAL_GET);
            put_uleb(inout code, param);
        }
        // i32.const k; call_indirect (type type_of[k]) (table 0); end
        code.push(OP_I32_CONST);
        put_sleb(inout code, k);
        code.push(OP_CALL_INDIRECT);
        put_uleb(inout code, at64(in type_of.as_slice(), k));
        code.push(0);
        code.push(OP_END);
        put_bytes(inout body, in code.as_slice());
    }
    section(inout out, S_CODE, in body.as_slice());
    out.extend(in producers);
}

// `wit-component-fixup`: imports the lowerings ("actual" "k") and the
// shim's table, and fills the table with them.
pub fn fixup_module(
    in core: Core,
    in sigs: Slice[u64],
    in producers: Slice[u8],
    inout out: ChunkSeq[u8]
) {
    let n = sigs.len();
    let (unique, type_of) = dedup_sigs(in core, in sigs);
    module_head(inout out);
    let mut body = ChunkSeq::new[u8]();
    func_types(in core, in unique.as_slice(), inout body);
    section(inout out, S_TYPE, in body.as_slice());
    body.clear();
    put_uleb(inout body, inc(n));
    for k in 0..n {
        put_bytes(inout body, in "actual".as_bytes());
        let mut name = ChunkSeq::new[u8]();
        put_decimal(inout name, k);
        put_bytes(inout body, in name.as_slice());
        body.push(EXTERN_FUNC);
        put_uleb(inout body, at64(in type_of.as_slice(), k));
    }
    put_bytes(inout body, in "shim".as_bytes());
    put_bytes(inout body, in "$imports".as_bytes());
    body.push(EXTERN_TABLE);
    table_type(n, inout body);
    section(inout out, S_IMPORT, in body.as_slice());
    body.clear();
    // one active segment at (i32.const 0) of funcs 0..n
    put_uleb(inout body, 1);
    body.push(ELEM_ACTIVE_DEFAULT_TABLE);
    body.push(OP_I32_CONST);
    body.push(0);
    body.push(OP_END);
    put_uleb(inout body, n);
    for k in 0..n {
        put_uleb(inout body, k);
    }
    section(inout out, S_ELEMENT, in body.as_slice());
    out.extend(in producers);
}
