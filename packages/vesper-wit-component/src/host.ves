// The host interfaces a backend world imports (`src/wasm_backend/host.rs`
// and `packages/vesper-wasm-backend/src/host.ves`: wasi:cli/stdout with
// wasi:io, wasi:clocks/monotonic-clock, vesper:beacon/trace,
// wasi:cli/environment, and wasi:filesystem/{types,preopens} with
// wasi:clocks/wall-clock), and the core modules wit-component writes to
// lower them.
//
// wit-component encodes each imported interface as an instance type from
// the WIT `Resolve`. The backend's host WIT is fixed (`IO_WIT`, `CLI_WIT`,
// `CLOCKS_WIT`, `FILESYSTEM_WIT`, `BEACON_WIT`), so their instance types
// are kept here as wit-component writes them; tests/self_host_wit_component.rs
// compares every component with host imports against Rust's, byte for
// byte.

use @vesper/check-data::util::{
    add,
    inc
};

const NONE32: u32 = 4294967295;

// The world's host imports (`Wit::imports`).
const H_STDOUT: u8 = 0;
const H_CLOCK: u8 = 1;
const H_TRACE: u8 = 2;
const H_ENV: u8 = 3;
const H_FS_TYPES: u8 = 4;
const H_FS_PREOPENS: u8 = 5;

// The instance types wit-component imports, in topological order within
// each capability dependency chain.
const IF_ERROR: u8 = 0;
const IF_STREAMS: u8 = 1;
const IF_STDOUT: u8 = 2;
const IF_CLOCK: u8 = 3;
const IF_TRACE: u8 = 4;
const IF_ENV: u8 = 5;
const IF_WALL_CLOCK: u8 = 6;
const IF_FS_TYPES: u8 = 7;
const IF_FS_PREOPENS: u8 = 8;
const IF_COUNT: u64 = 9;

// How a core import lowers (`LowerKind`).
const L_NONE: u8 = 0;
// `canon lower` without options, straight into the core instance.
const L_DIRECT: u8 = 1;
// Through the shim table, lowered with `memory` (optionally `realloc`, `utf8`).
const L_MEMORY: u8 = 2;
const L_MEMORY_UTF8: u8 = 3;
const L_MEMORY_REALLOC: u8 = 4;
const L_MEMORY_REALLOC_UTF8: u8 = 5;
// `[resource-drop]<name>`: `canon resource.drop` of the aliased type.
const L_DROP: u8 = 6;

// Core value types and type forms.
const VT_REF_NULL: u8 = 99;
const VT_REF: u8 = 100;
const FORM_FUNC: u8 = 96;
const FORM_CONT: u8 = 93;
const EXTERN_FUNC: u8 = 0;
const EXTERN_TABLE: u8 = 1;
const TYPE_FUNCREF: u8 = 112;
const LIMITS_WITH_MAX: u8 = 1;
const ELEM_ACTIVE_DEFAULT_TABLE: u8 = 0;
const OP_LOCAL_GET: u8 = 32;
const OP_CALL_INDIRECT: u8 = 17;
const OP_I32_CONST: u8 = 65;
const OP_END: u8 = 11;

const CORE_HEADER_BYTES: u64 = 8;
const S_TYPE: u8 = 1;
const S_IMPORT: u8 = 2;
const S_FUNCTION: u8 = 3;
const S_TABLE: u8 = 4;
const S_EXPORT: u8 = 7;
const S_ELEMENT: u8 = 9;
const S_CODE: u8 = 10;

fn byte(in b: Slice[u8], i: u64) -> u8 {
    match b.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

pub fn put_uleb(inout out: ChunkSeq[u8], v: u64) {
    let mut x = v;
    loop {
        let b = wrapping_u8(x & 127);
        x = x >> 7;
        if x == 0 {
            out.push(b);
            break;
        }
        out.push(b | 128);
    }
}

fn put_sleb(inout out: ChunkSeq[u8], v: u64) {
    let mut x = v;
    loop {
        let b = wrapping_u8(x & 127);
        x = x >> 7;
        if x == 0 && (b & 64) == 0 {
            out.push(b);
            break;
        }
        out.push(b | 128);
    }
}

fn put_bytes(inout out: ChunkSeq[u8], in s: Slice[u8]) {
    put_uleb(inout out, s.len());
    out.extend(in s);
}

// `n` in decimal (the shim's export names).
pub fn put_decimal(inout out: ChunkSeq[u8], n: u64) {
    let mut digits = ChunkSeq::new[u8]();
    let mut x = n;
    loop {
        digits.push(wrapping_add(48, wrapping_u8(x % 10)));
        x = x / 10;
        if x == 0 {
            break;
        }
    }
    let mut k = digits.len();
    loop {
        if k == 0 {
            break;
        }
        k = wrapping_sub(k, 1);
        out.push(byte(in digits.as_slice(), k));
    }
}

fn at64(in s: Slice[u64], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

pub fn eq(in a: Slice[u8], in b: Slice[u8]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for i in 0..a.len() {
        if byte(in a, i) != byte(in b, i) {
            return false;
        }
    }
    true
}

fn hex_digit(c: u8) -> u8 {
    if c >= 97 {
        wrapping_sub(c, 87)
    } else {
        wrapping_sub(c, 48)
    }
}

// The bytes of hex text `h`.
fn unhex(inout out: ChunkSeq[u8], in h: Slice[u8]) {
    let mut i: u64 = 0;
    loop {
        if inc(i) >= h.len() {
            break;
        }
        let hi = hex_digit(byte(in h, i));
        let lo = hex_digit(byte(in h, inc(i)));
        out.push(wrapping_add(wrapping_mul(hi, 16), lo));
        i = add(i, 2);
    }
}

fn at32(in s: Slice[u32], i: u64) -> u32 {
    match s.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

fn spliced_instance_type(
    inout out: ChunkSeq[u8],
    in pref: Slice[u8],
    dep_idx: u32,
    in suff: Slice[u8]
) {
    unhex(inout out, in pref);
    put_uleb(inout out, widen_u64(dep_idx));
    unhex(inout out, in suff);
}

// ------------------------------------------------------- host interfaces

pub fn if_count() -> u64 {
    IF_COUNT
}

pub fn needs_descriptor_alias(h: u8) -> bool {
    h == H_FS_PREOPENS
}

pub fn lower_ok(l: u8) -> bool {
    l != L_NONE
}

pub fn lower_is_drop(l: u8) -> bool {
    l == L_DROP
}

pub fn lower_is_indirect(l: u8) -> bool {
    l == L_MEMORY || l == L_MEMORY_UTF8 || l == L_MEMORY_REALLOC || l == L_MEMORY_REALLOC_UTF8
}

pub fn lower_uses_realloc(l: u8) -> bool {
    l == L_MEMORY_REALLOC || l == L_MEMORY_REALLOC_UTF8
}

pub fn lower_uses_utf8(l: u8) -> bool {
    l == L_MEMORY_UTF8 || l == L_MEMORY_REALLOC_UTF8
}

// The interfaces a world import of host capability `h` brings, in
// topological order (`n` of them from `first`).
pub fn import_ifaces(h: u8) -> (u8, u64) {
    if h == H_STDOUT {
        (IF_ERROR, 3)
    } else if h == H_CLOCK {
        (IF_CLOCK, 1)
    } else if h == H_TRACE {
        (IF_TRACE, 1)
    } else if h == H_ENV {
        (IF_ENV, 1)
    } else if h == H_FS_TYPES {
        (IF_WALL_CLOCK, 2)
    } else {
        (IF_WALL_CLOCK, 3)
    }
}

// Host capability of a world import's name; 255 if none.
pub fn host_import(in name: Slice[u8]) -> u8 {
    if eq(in name, in "wasi:cli/stdout@0.2.0".as_bytes()) {
        H_STDOUT
    } else if eq(in name, in "wasi:clocks/monotonic-clock@0.2.0".as_bytes()) {
        H_CLOCK
    } else if eq(in name, in "vesper:beacon/trace@0.1.0".as_bytes()) {
        H_TRACE
    } else if eq(in name, in "wasi:cli/environment@0.2.0".as_bytes()) {
        H_ENV
    } else if eq(in name, in "wasi:filesystem/types@0.2.0".as_bytes()) {
        H_FS_TYPES
    } else if eq(in name, in "wasi:filesystem/preopens@0.2.0".as_bytes()) {
        H_FS_PREOPENS
    } else {
        255
    }
}

pub fn host_name(i: u8, inout out: ChunkSeq[u8]) {
    if i == IF_ERROR {
        out.extend(in "wasi:io/error@0.2.0".as_bytes());
    } else if i == IF_STREAMS {
        out.extend(in "wasi:io/streams@0.2.0".as_bytes());
    } else if i == IF_STDOUT {
        out.extend(in "wasi:cli/stdout@0.2.0".as_bytes());
    } else if i == IF_CLOCK {
        out.extend(in "wasi:clocks/monotonic-clock@0.2.0".as_bytes());
    } else if i == IF_TRACE {
        out.extend(in "vesper:beacon/trace@0.1.0".as_bytes());
    } else if i == IF_ENV {
        out.extend(in "wasi:cli/environment@0.2.0".as_bytes());
    } else if i == IF_WALL_CLOCK {
        out.extend(in "wasi:clocks/wall-clock@0.2.0".as_bytes());
    } else if i == IF_FS_TYPES {
        out.extend(in "wasi:filesystem/types@0.2.0".as_bytes());
    } else {
        out.extend(in "wasi:filesystem/preopens@0.2.0".as_bytes());
    }
}

// The interface named `name`; 255 if it is not a host interface.
pub fn iface_of(in name: Slice[u8]) -> u8 {
    for i in 0..IF_COUNT {
        let mut n = ChunkSeq::new[u8]();
        host_name(wrapping_u8(i), inout n);
        if eq(in n.as_slice(), in name) {
            return wrapping_u8(i);
        }
    }
    255
}

// The instance type of interface `i` (one type-section item).
pub fn instance_type(i: u8, in halias: Slice[u32], inout out: ChunkSeq[u8]) {
    if i == IF_ERROR {
        // (instance (export "error" (type (sub resource))))
        unhex(inout out, in "42010400056572726f720301".as_bytes());
    } else if i == IF_STREAMS {
        // output-stream, error (outer), stream-error and
        // [method]output-stream.blocking-write-and-flush
        spliced_instance_type(
            inout out,
            in "420b04000d6f75747075742d73747265616d030102030201".as_bytes(),
            at32(in halias, widen_u64(IF_ERROR)),
            in ""
                .as_bytes()
        );
    } else if i == IF_STDOUT {
        // output-stream (outer) and get-stdout
        spliced_instance_type(
            inout out,
            in "420502030201".as_bytes(),
            at32(in halias, widen_u64(IF_STREAMS)),
            in "04000d6f75747075742d73747265616d030000016901014000000204000a6765742d7374646f75740103"
                .as_bytes()
        );
    } else if i == IF_CLOCK {
        // instant and now
        unhex(
            inout out,
            in "42040177040007696e7374616e7403000001400000010400036e6f770102".as_bytes()
        );
    } else if i == IF_TRACE {
        // span-context, active-span, telemetry-attr and the six functions
        unhex(
            inout out,
            in ""
                .as_bytes()
        );
    } else if i == IF_ENV {
        // get-environment, get-arguments, initial-cwd
        unhex(
            inout out,
            in "420a016f027373017000014000000104000f6765742d656e7669726f6e6d656e740102017073014000000304000d6765742d617267756d656e74730104016b73014000000504000b696e697469616c2d6377640106"
                .as_bytes()
        );
    } else if i == IF_WALL_CLOCK {
        // datetime
        unhex(
            inout out,
            in "4202017202077365636f6e6473770b6e616e6f7365636f6e6473790400086461746574696d65030000"
                .as_bytes()
        );
    } else if i == IF_FS_TYPES {
        // descriptor, directory-entry-stream, datetime (outer), stats and methods
        spliced_instance_type(
            inout out,
            in ""
                .as_bytes(),
            at32(in halias, widen_u64(IF_WALL_CLOCK)),
            in ""
                .as_bytes()
        );
    } else {
        // descriptor (outer) and get-directories
        spliced_instance_type(
            inout out,
            in "420702030201".as_bytes(),
            at32(in halias, widen_u64(IF_FS_TYPES)),
            in "04000a64657363726970746f72030000016901016f020273017003014000000404000f6765742d6469726563746f726965730105"
                .as_bytes()
        );
    }
}

// The type interface `i` exports that later interfaces alias (`error`,
// `output-stream`, `datetime`, `descriptor`); empty for none.
pub fn aliased_type(i: u8, need_desc: bool, inout out: ChunkSeq[u8]) {
    if i == IF_ERROR {
        out.extend(in "error".as_bytes());
    } else if i == IF_STREAMS {
        out.extend(in "output-stream".as_bytes());
    } else if i == IF_WALL_CLOCK {
        out.extend(in "datetime".as_bytes());
    } else if i == IF_FS_TYPES && need_desc {
        out.extend(in "descriptor".as_bytes());
    }
}

// How function `f` of interface `i` lowers: whether it needs the memory,
// cabi_realloc, and/or UTF-8 (`LoweringInfo` of wit-component's `encoding`).
pub fn lower_kind(i: u8, in f: Slice[u8]) -> u8 {
    if i == IF_STDOUT {
        if eq(in f, in "get-stdout".as_bytes()) {
            return L_DIRECT;
        }
    } else if i == IF_STREAMS {
        if eq(in f, in "[method]output-stream.blocking-write-and-flush".as_bytes()) {
            return L_MEMORY;
        }
        if eq(in f, in "[resource-drop]output-stream".as_bytes()) {
            return L_DROP;
        }
    } else if i == IF_CLOCK {
        if eq(in f, in "now".as_bytes()) {
            return L_DIRECT;
        }
    } else if i == IF_TRACE {
        if eq(in f, in "current-ctx".as_bytes()) {
            return L_MEMORY;
        }
        if eq(in f, in "start-span".as_bytes())
            || eq(in f, in "start-child".as_bytes())
            || eq(in f, in "emit-err".as_bytes()) {
            return L_MEMORY_UTF8;
        }
        if eq(in f, in "emit-ok".as_bytes()) || eq(in f, in "emit-attr".as_bytes()) {
            return L_DIRECT;
        }
    } else if i == IF_ENV {
        if eq(in f, in "get-arguments".as_bytes())
            || eq(in f, in "get-environment".as_bytes())
            || eq(in f, in "initial-cwd".as_bytes()) {
            return L_MEMORY_REALLOC_UTF8;
        }
    } else if i == IF_FS_PREOPENS {
        if eq(in f, in "get-directories".as_bytes()) {
            return L_MEMORY_REALLOC_UTF8;
        }
    } else if i == IF_FS_TYPES {
        if eq(in f, in "[method]descriptor.read".as_bytes()) {
            return L_MEMORY_REALLOC;
        }
        if eq(in f, in "[method]directory-entry-stream.read-directory-entry".as_bytes()) {
            return L_MEMORY_REALLOC_UTF8;
        }
        if eq(in f, in "[method]descriptor.open-at".as_bytes())
            || eq(in f, in "[method]descriptor.stat-at".as_bytes())
            || eq(in f, in "[method]descriptor.create-directory-at".as_bytes())
            || eq(in f, in "[method]descriptor.remove-directory-at".as_bytes())
            || eq(in f, in "[method]descriptor.unlink-file-at".as_bytes())
            || eq(in f, in "[method]descriptor.rename-at".as_bytes()) {
            return L_MEMORY_UTF8;
        }
        if eq(in f, in "[method]descriptor.write".as_bytes())
            || eq(in f, in "[method]descriptor.stat".as_bytes())
            || eq(in f, in "[method]descriptor.sync".as_bytes())
            || eq(in f, in "[method]descriptor.read-directory".as_bytes()) {
            return L_MEMORY;
        }
        if eq(in f, in "[resource-drop]descriptor".as_bytes())
            || eq(in f, in "[resource-drop]directory-entry-stream".as_bytes()) {
            return L_DROP;
        }
    }
    L_NONE
}

// ------------------------------------------------- the core module's imports

// A core function type: its parameter and result value types
// (`types.bytes[p0..p0+pn]`, `pc` of them; likewise the results).
pub copy struct Sig {
    p0: u64,
    pn: u64,
    pc: u64,
    r0: u64,
    rn: u64,
    rc: u64,
}

// A function import: module `text[m0..m0+mn]`, field `text[f0..f0+fl]`,
// type `ty`.
pub copy struct Imp {
    m0: u64,
    mn: u64,
    f0: u64,
    fl: u64,
    ty: u64,
}

pub struct Core {
    // false when the module is outside what the port reads.
    ok: bool,
    bytes: ChunkSeq[u8],
    sigs: ChunkSeq[Sig],
    text: ChunkSeq[u8],
    imps: ChunkSeq[Imp],
}

pub fn imp_at(in c: Core, i: u64) -> Imp {
    match c.imps.try_get(i) {
        Option::Some(x) => x,
        Option::None => Imp {
            m0: 0,
            mn: 0,
            f0: 0,
            fl: 0,
            ty: 0
        },
    }
}

pub fn sig_at(in c: Core, i: u64) -> Sig {
    match c.sigs.try_get(i) {
        Option::Some(x) => x,
        Option::None => Sig {
            p0: 0,
            pn: 0,
            pc: 0,
            r0: 0,
            rn: 0,
            rc: 0
        },
    }
}

copy struct Rd {
    pos: u64,
    ok: bool,
}

fn rd_byte(inout r: Rd, in b: Slice[u8]) -> u8 {
    if r.pos >= b.len() {
        r.ok = false;
        return 0;
    }
    let x = byte(in b, r.pos);
    r.pos = inc(r.pos);
    x
}

fn rd_leb(inout r: Rd, in b: Slice[u8]) -> u64 {
    let mut v: u64 = 0;
    let mut shift: u64 = 0;
    loop {
        let x = rd_byte(inout r, in b);
        if !r.ok || shift > 56 {
            r.ok = false;
            return 0;
        }
        v = v | wrapping_shl_u64(widen_u64(x & 127), wrapping_u32(shift));
        shift = add(shift, 7);
        if (x & 128) == 0 {
            return v;
        }
    }
}

// A value-type vector into `c.bytes`: its start, byte length and count.
fn valtypes(inout r: Rd, in b: Slice[u8], inout c: Core) -> (u64, u64, u64) {
    let n = rd_leb(inout r, in b);
    let start = c.bytes.len();
    for k in 0..n {
        if !r.ok {
            break;
        }
        let x = rd_byte(inout r, in b);
        c.bytes.push(x);
        if x == VT_REF || x == VT_REF_NULL {
            // the heap type (s33)
            loop {
                let y = rd_byte(inout r, in b);
                c.bytes.push(y);
                if !r.ok || (y & 128) == 0 {
                    break;
                }
            }
        }
    }
    (start, wrapping_sub(c.bytes.len(), start), n)
}

// The function types and function imports of core module `b`.
pub fn read_core(in b: Slice[u8]) -> Core {
    let mut c = Core {
        ok: true,
        bytes: ChunkSeq::new[u8](),
        sigs: ChunkSeq::new[Sig](),
        text: ChunkSeq::new[u8](),
        imps: ChunkSeq::new[Imp](),
    };
    let mut r = Rd {
        pos: CORE_HEADER_BYTES,
        ok: b.len() >= CORE_HEADER_BYTES
    };
    loop {
        if !r.ok || r.pos >= b.len() {
            break;
        }
        let id = rd_byte(inout r, in b);
        let size = rd_leb(inout r, in b);
        let end = add(r.pos, size);
        if !r.ok || end > b.len() {
            c.ok = false;
            return c;
        }
        if id == S_TYPE {
            let n = rd_leb(inout r, in b);
            for k in 0..n {
                let form = rd_byte(inout r, in b);
                if form == FORM_CONT {
                    rd_leb(inout r, in b);
                    c
                        .sigs
                        .push(
                            Sig {
                                p0: 0,
                                pn: 0,
                                pc: 0,
                                r0: 0,
                                rn: 0,
                                rc: 0
                            }
                        );
                } else if form == FORM_FUNC {
                    let (p0, pn, pc) = valtypes(inout r, in b, inout c);
                    let (r0, rn, rc) = valtypes(inout r, in b, inout c);
                    c
                        .sigs
                        .push(
                            Sig {
                                p0: p0,
                                pn: pn,
                                pc: pc,
                                r0: r0,
                                rn: rn,
                                rc: rc
                            }
                        );
                } else {
                    c.ok = false;
                    return c;
                }
            }
        } else if id == S_IMPORT {
            let n = rd_leb(inout r, in b);
            for k in 0..n {
                let ml = rd_leb(inout r, in b);
                let m0 = c.text.len();
                for j in 0..ml {
                    c.text.push(rd_byte(inout r, in b));
                }
                let fl = rd_leb(inout r, in b);
                let f0 = c.text.len();
                for j in 0..fl {
                    c.text.push(rd_byte(inout r, in b));
                }
                if rd_byte(inout r, in b) != EXTERN_FUNC {
                    c.ok = false;
                    return c;
                }
                let ty = rd_leb(inout r, in b);
                c
                    .imps
                    .push(
                        Imp {
                            m0: m0,
                            mn: ml,
                            f0: f0,
                            fl: fl,
                            ty: ty
                        }
                    );
            }
        }
        if !r.ok || r.pos > end {
            c.ok = false;
            return c;
        }
        r.pos = end;
    }
    c.ok = r.ok;
    c
}

// ------------------------------------------- the shim and fixup modules

fn section(inout out: ChunkSeq[u8], id: u8, in body: Slice[u8]) {
    out.push(id);
    put_bytes(inout out, in body);
}

fn module_head(inout out: ChunkSeq[u8]) {
    // "\0asm", version 1
    out.push(0);
    out.push(97);
    out.push(115);
    out.push(109);
    out.push(1);
    out.push(0);
    out.push(0);
    out.push(0);
}

fn same_core_sig(in c: Core, a: u64, b: u64) -> bool {
    let sa = sig_at(in c, a);
    let sb = sig_at(in c, b);
    sa.pc == sb.pc
        && sa.rc == sb.rc
        && eq(in c.bytes[sa.p0..add(sa.p0, sa.pn)], in c.bytes[sb.p0..add(sb.p0, sb.pn)])
        && eq(in c.bytes[sa.r0..add(sa.r0, sa.rn)], in c.bytes[sb.r0..add(sb.r0, sb.rn)])
}

fn dedup_sigs(in c: Core, in sigs: Slice[u64]) -> (ChunkSeq[u64], ChunkSeq[u64]) {
    let mut uniq = ChunkSeq::new[u64]();
    let mut type_of = ChunkSeq::new[u64]();
    for k in 0..sigs.len() {
        let s = at64(in sigs, k);
        let mut found = uniq.len();
        for u in 0..uniq.len() {
            if same_core_sig(in c, at64(in uniq.as_slice(), u), s) {
                found = u;
                break;
            }
        }
        if found == uniq.len() {
            uniq.push(s);
        }
        type_of.push(found);
    }
    (uniq, type_of)
}

fn func_types(in c: Core, in sigs: Slice[u64], inout out: ChunkSeq[u8]) {
    put_uleb(inout out, sigs.len());
    for k in 0..sigs.len() {
        let s = sig_at(in c, at64(in sigs, k));
        out.push(FORM_FUNC);
        put_uleb(inout out, s.pc);
        out.extend(in c.bytes[s.p0..add(s.p0, s.pn)]);
        put_uleb(inout out, s.rc);
        out.extend(in c.bytes[s.r0..add(s.r0, s.rn)]);
    }
}

fn table_type(n: u64, inout out: ChunkSeq[u8]) {
    // funcref, limits n..n
    out.push(TYPE_FUNCREF);
    out.push(LIMITS_WITH_MAX);
    put_uleb(inout out, n);
    put_uleb(inout out, n);
}

// `wit-component-shim-module`: function k (type_of[k], the core signature
// of the k-th indirectly lowered import) calls table slot k, which the
// fixup module fills with the real lowering.
pub fn shim_module(
    in c: Core,
    in sigs: Slice[u64],
    in producers: Slice[u8],
    inout out: ChunkSeq[u8]
) {
    let n = sigs.len();
    let (uniq, type_of) = dedup_sigs(in c, in sigs);
    module_head(inout out);
    let mut body = ChunkSeq::new[u8]();
    func_types(in c, in uniq.as_slice(), inout body);
    section(inout out, S_TYPE, in body.as_slice());
    body.clear();
    put_uleb(inout body, n);
    for k in 0..n {
        put_uleb(inout body, at64(in type_of.as_slice(), k));
    }
    section(inout out, S_FUNCTION, in body.as_slice());
    body.clear();
    put_uleb(inout body, 1);
    table_type(n, inout body);
    section(inout out, S_TABLE, in body.as_slice());
    body.clear();
    put_uleb(inout body, inc(n));
    for k in 0..n {
        let mut name = ChunkSeq::new[u8]();
        put_decimal(inout name, k);
        put_bytes(inout body, in name.as_slice());
        body.push(EXTERN_FUNC);
        put_uleb(inout body, k);
    }
    put_bytes(inout body, in "$imports".as_bytes());
    // table 0
    body.push(EXTERN_TABLE);
    body.push(0);
    section(inout out, S_EXPORT, in body.as_slice());
    body.clear();
    put_uleb(inout body, n);
    for k in 0..n {
        let s = sig_at(in c, at64(in sigs, k));
        let mut code = ChunkSeq::new[u8]();
        // no locals
        code.push(0);
        for p in 0..s.pc {
            code.push(OP_LOCAL_GET);
            put_uleb(inout code, p);
        }
        // i32.const k; call_indirect (type type_of[k]) (table 0); end
        code.push(OP_I32_CONST);
        put_sleb(inout code, k);
        code.push(OP_CALL_INDIRECT);
        put_uleb(inout code, at64(in type_of.as_slice(), k));
        code.push(0);
        code.push(OP_END);
        put_bytes(inout body, in code.as_slice());
    }
    section(inout out, S_CODE, in body.as_slice());
    out.extend(in producers);
}

// `wit-component-fixup`: imports the lowerings ("actual" "k") and the
// shim's table, and fills the table with them.
pub fn fixup_module(
    in c: Core,
    in sigs: Slice[u64],
    in producers: Slice[u8],
    inout out: ChunkSeq[u8]
) {
    let n = sigs.len();
    let (uniq, type_of) = dedup_sigs(in c, in sigs);
    module_head(inout out);
    let mut body = ChunkSeq::new[u8]();
    func_types(in c, in uniq.as_slice(), inout body);
    section(inout out, S_TYPE, in body.as_slice());
    body.clear();
    put_uleb(inout body, inc(n));
    for k in 0..n {
        put_bytes(inout body, in "actual".as_bytes());
        let mut name = ChunkSeq::new[u8]();
        put_decimal(inout name, k);
        put_bytes(inout body, in name.as_slice());
        body.push(EXTERN_FUNC);
        put_uleb(inout body, at64(in type_of.as_slice(), k));
    }
    put_bytes(inout body, in "shim".as_bytes());
    put_bytes(inout body, in "$imports".as_bytes());
    body.push(EXTERN_TABLE);
    table_type(n, inout body);
    section(inout out, S_IMPORT, in body.as_slice());
    body.clear();
    // one active segment at (i32.const 0) of funcs 0..n
    put_uleb(inout body, 1);
    body.push(ELEM_ACTIVE_DEFAULT_TABLE);
    body.push(OP_I32_CONST);
    body.push(0);
    body.push(OP_END);
    put_uleb(inout body, n);
    for k in 0..n {
        put_uleb(inout body, k);
    }
    section(inout out, S_ELEMENT, in body.as_slice());
    out.extend(in producers);
}
