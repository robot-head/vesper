// The component wit-component 0.261 writes for the backend's world
// (`ComponentEncoder::encode`, encoding.rs), byte for byte, written
// directly from the WIT type table instead of through a `Resolve`, the
// `component-type` round trip and validation (owner's call, 2026-11-21).
//
// The order is wit-component's: the core module, the root types of the
// exported interfaces (`declare_types_for_imported_intrinsics`), the core
// instance and its memory, then per exported interface the `canon lift`
// of each function and a nested shim component that imports the types
// and functions and re-exports them typed, instantiated with them and
// exported as the interface instance. Then the `component-name` and
// `producers` custom sections.
//
// `B` is wasm-encoder's `ComponentBuilder`: consecutive items of one kind
// share a section, and every index space counts its items and keeps the
// debug names given.

use @vesper/check-data::util::{add, inc, w};
use self::host::{
    Core, Imp, aliased_type, fixup_module, host_name, if_count, iface_of, import_ifaces, imp_at,
    instance_type, lower_is_drop, lower_is_indirect, lower_kind, lower_ok, lower_uses_realloc,
    lower_uses_utf8, needs_descriptor_alias, put_decimal, read_core, shim_module
};
use self::wit::{Wit, Ty, Def, Field, Func, ty_at, def_at, field_at, func_at, arg_at, text_at};

// wit.ves's constants (a `use` of a constant is not read by the Vesper
// package assembler yet, so they are repeated here).
const NONE32: u32 = 4294967295;
const T_PRIM: u8 = 0;
const T_TUPLE: u8 = 1;
const T_NAMED: u8 = 2;
const T_UNIT_RESULT: u8 = 3;
const D_RECORD: u8 = 0;
const P_STRING: u8 = 115;

const NONE8: u8 = 255;

// Why `encode` declines (lib.ves answers 32 + it).
pub const X_CORE: u64 = 1;
pub const X_IMPORT: u64 = 2;
pub const X_PLUGIN: u64 = 3;

// Section ids.
const S_CUSTOM: u8 = 0;
const S_CORE_MODULE: u8 = 1;
const S_CORE_INSTANCE: u8 = 2;
const S_COMPONENT: u8 = 4;
const S_INSTANCE: u8 = 5;
const S_ALIAS: u8 = 6;
const S_TYPE: u8 = 7;
const S_CANON: u8 = 8;
const S_IMPORT: u8 = 10;
const S_EXPORT: u8 = 11;

// Index spaces, in the order their names are written (instances twice,
// as `append_names` does).
const NS_CORE_FUNC: u8 = 0;
const NS_CORE_MEMORY: u8 = 1;
const NS_CORE_MODULE: u8 = 2;
const NS_CORE_INSTANCE: u8 = 3;
const NS_INSTANCE: u8 = 4;
const NS_FUNC: u8 = 5;
const NS_TYPE: u8 = 6;
const NS_COMPONENT: u8 = 7;
const NS_COUNT: u64 = 8;

// Sorts.
const SORT_CORE: u8 = 0;
const CORE_FUNC: u8 = 0;
const CORE_MEMORY: u8 = 2;
const CORE_MODULE: u8 = 17;
const CORE_INSTANCE: u8 = 18;
const SORT_FUNC: u8 = 1;
const SORT_TYPE: u8 = 3;
const SORT_COMPONENT: u8 = 4;
const SORT_INSTANCE: u8 = 5;

// Type constructors.
const TY_RECORD: u8 = 114;
const TY_VARIANT: u8 = 113;
const TY_TUPLE: u8 = 111;
const TY_RESULT: u8 = 106;
const TY_FUNC: u8 = 64;

// Canonical options.
const OPT_UTF8: u8 = 0;
const OPT_MEMORY: u8 = 3;
const OPT_REALLOC: u8 = 4;

// Canonical functions.
const CANON_LIFT: u8 = 0;
const CANON_LOWER: u8 = 1;
const CANON_RESOURCE_DROP: u8 = 3;

// Alias kinds, core instance forms and the instance extern sort.
const ALIAS_EXPORT: u8 = 0;
const ALIAS_CORE_EXPORT: u8 = 1;
const INSTANTIATE: u8 = 0;
const FROM_EXPORTS: u8 = 1;
const EXTERN_INSTANCE: u8 = 5;

// The name-section subsection of declaration names.
const NAMES_DECLS: u8 = 1;

// How a type encoder ascribes a definition (`ValtypeEncoder::export_type`).
const M_ROOT: u8 = 0;
const M_IMPORT: u8 = 1;
const M_EXPORT: u8 = 2;

// The interfaces the backend's world exports (`Wit::exports`).
const I_RUN: u8 = 0;

fn byte(in bytes: Slice[u8], i: u64) -> u8 {
    match bytes.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

pub fn uleb(inout out: ChunkSeq[u8], v: u64) {
    let mut rest = v;
    loop {
        let group = wrapping_u8(rest & 127);
        rest = rest >> 7;
        if rest == 0 {
            out.push(group);
            break;
        }
        out.push(group | 128);
    }
}

// A type index as wasm-encoder writes it (`i64`, signed LEB128).
fn sleb_index(inout out: ChunkSeq[u8], v: u32) {
    let mut rest = widen_u64(v);
    loop {
        let group = wrapping_u8(rest & 127);
        rest = rest >> 7;
        if rest == 0 && (group & 64) == 0 {
            out.push(group);
            break;
        }
        out.push(group | 128);
    }
}

fn put_str(inout out: ChunkSeq[u8], in bytes: Slice[u8]) {
    uleb(inout out, bytes.len());
    out.extend(in bytes);
}

// `wit.text[name_at..name_at+name_len]` as a string.
fn put_name(inout out: ChunkSeq[u8], in wit: Wit, name_at: u64, name_len: u64) {
    uleb(inout out, name_len);
    out.extend(in wit.text[name_at..add(name_at, name_len)]);
}

pub copy struct NameRow {
    ns: u8,
    index: u32,
    name_start: u64,
    name_len: u64,
}

pub struct B {
    out: ChunkSeq[u8],
    section: ChunkSeq[u8],
    section_id: u8,
    item_count: u64,
    space_counts: ChunkSeq[u32],
    names: ChunkSeq[NameRow],
    text: ChunkSeq[u8],
}

pub fn b_new() -> B {
    let mut counts = ChunkSeq::new[u32]();
    for i in 0..NS_COUNT {
        counts.push(0);
    }
    let mut out = ChunkSeq::new[u8]();
    // "\0asm", component version 0x0d, layer 1
    out.push(0);
    out.push(97);
    out.push(115);
    out.push(109);
    out.push(13);
    out.push(0);
    out.push(1);
    out.push(0);
    B {
        out: out,
        section: ChunkSeq::new[u8](),
        section_id: NONE8,
        item_count: 0,
        space_counts: counts,
        names: ChunkSeq::new[NameRow](),
        text: ChunkSeq::new[u8](),
    }
}

impl B {
    fn flush(inout self) {
        if self.section_id == NONE8 {
            return;
        }
        let mut count_bytes = ChunkSeq::new[u8]();
        uleb(inout count_bytes, self.item_count);
        self.out.push(self.section_id);
        uleb(inout self.out, add(count_bytes.len(), self.section.len()));
        self.out.extend(in count_bytes.as_slice());
        self.out.extend(in self.section.as_slice());
        self.section.clear();
        self.section_id = NONE8;
        self.item_count = 0;
    }

    // Start one more item of section `id` (in `self.section`).
    fn item(inout self, id: u8) {
        if self.section_id != id {
            self.flush();
            self.section_id = id;
        }
        self.item_count = inc(self.item_count);
    }

    // A whole section of its own (`core_module_raw`, `component`, custom).
    fn raw(inout self, id: u8, in body: Slice[u8]) {
        self.flush();
        self.out.push(id);
        uleb(inout self.out, body.len());
        self.out.extend(in body);
    }

    fn next(inout self, ns: u8) -> u32 {
        let slot = widen_u64(ns);
        let count = match self.space_counts.try_get(slot) {
            Option::Some(x) => x,
            Option::None => 0,
        };
        self.space_counts.try_set(slot, wrapping_add(count, 1));
        count
    }

    fn add_anon(inout self, ns: u8) -> u32 {
        self.next(ns)
    }

    fn add(inout self, ns: u8, in name: Slice[u8]) -> u32 {
        let new_index = self.next(ns);
        let name_at = self.text.len();
        self.text.extend(in name);
        self.names
            .push(NameRow { ns: ns, index: new_index, name_start: name_at, name_len: name.len() });
        new_index
    }

    fn name_map(in self, ns: u8, inout out: ChunkSeq[u8]) {
        let mut count: u64 = 0;
        for i in 0..self.names.len() {
            match self.names.try_get(i) {
                Option::Some(row) => {
                    if row.ns == ns {
                        count = inc(count);
                    }
                },
                Option::None => {},
            }
        }
        uleb(inout out, count);
        for i in 0..self.names.len() {
            match self.names.try_get(i) {
                Option::Some(row) => {
                    if row.ns == ns {
                        uleb(inout out, widen_u64(row.index));
                        uleb(inout out, row.name_len);
                        out.extend(in self.text[row.name_start..add(row.name_start, row.name_len)]);
                    }
                },
                Option::None => {},
            }
        }
    }

    fn has_names(in self, ns: u8) -> bool {
        for i in 0..self.names.len() {
            match self.names.try_get(i) {
                Option::Some(row) => {
                    if row.ns == ns {
                        return true;
                    }
                },
                Option::None => {},
            }
        }
        false
    }

    // One `decls` subsection: its sort bytes, then the name map.
    fn decls(in self, ns: u8, core: bool, kind: u8, inout out: ChunkSeq[u8]) {
        if !self.has_names(ns) {
            return;
        }
        let mut body = ChunkSeq::new[u8]();
        if core {
            body.push(SORT_CORE);
        }
        body.push(kind);
        self.name_map(ns, inout body);
        out.push(NAMES_DECLS);
        uleb(inout out, body.len());
        out.extend(in body.as_slice());
    }

    // `append_names`: the `component-name` custom section.
    fn append_names(inout self) {
        let mut subsections = ChunkSeq::new[u8]();
        self.decls(NS_CORE_FUNC, true, CORE_FUNC, inout subsections);
        self.decls(NS_CORE_MEMORY, true, CORE_MEMORY, inout subsections);
        self.decls(NS_CORE_MODULE, true, CORE_MODULE, inout subsections);
        self.decls(NS_CORE_INSTANCE, true, CORE_INSTANCE, inout subsections);
        self.decls(NS_INSTANCE, false, SORT_INSTANCE, inout subsections);
        self.decls(NS_FUNC, false, SORT_FUNC, inout subsections);
        self.decls(NS_TYPE, false, SORT_TYPE, inout subsections);
        self.decls(NS_COMPONENT, false, SORT_COMPONENT, inout subsections);
        self.decls(NS_INSTANCE, false, SORT_INSTANCE, inout subsections);
        if subsections.len() == 0 {
            return;
        }
        let mut body = ChunkSeq::new[u8]();
        put_str(inout body, in "component-name".as_bytes());
        body.extend(in subsections.as_slice());
        self.raw(S_CUSTOM, in body.as_slice());
    }

    fn finish(inout self) -> ChunkSeq[u8] {
        self.flush();
        let mut out = ChunkSeq::new[u8]();
        swap(inout out, inout self.out);
        out
    }

    // A type definition from its encoded bytes; its index.
    fn type_def(inout self, in body: Slice[u8]) -> u32 {
        self.item(S_TYPE);
        self.section.extend(in body);
        self.add_anon(NS_TYPE)
    }
}

// The `producers` section wit-component adds (`base_producers`):
// processed-by wit-component 0.261.0.
fn producers(inout out: ChunkSeq[u8]) {
    let mut body = ChunkSeq::new[u8]();
    put_str(inout body, in "producers".as_bytes());
    uleb(inout body, 1);
    put_str(inout body, in "processed-by".as_bytes());
    uleb(inout body, 1);
    put_str(inout body, in "wit-component".as_bytes());
    put_str(inout body, in "0.261.0".as_bytes());
    out.push(S_CUSTOM);
    uleb(inout out, body.len());
    out.extend(in body.as_slice());
}

// A type encoder's maps over one index space: the index each `tys` row was
// given (NONE32 if none yet), and the function types defined so far.
pub struct E {
    mode: u8,
    row_index: ChunkSeq[u32],
    sig_funcs: ChunkSeq[u64],
    sig_types: ChunkSeq[u32],
    // `import-type-*` imports, as `defs` rows, in order.
    imports: ChunkSeq[u64],
}

fn e_new(in wit: Wit, mode: u8) -> E {
    let mut map = ChunkSeq::new[u32]();
    for i in 0..wit.tys.len() {
        map.push(NONE32);
    }
    E {
        mode: mode,
        row_index: map,
        sig_funcs: ChunkSeq::new[u64](),
        sig_types: ChunkSeq::new[u32](),
        imports: ChunkSeq::new[u64](),
    }
}

fn mapped(in encoder: E, ty_row: u32) -> u32 {
    match encoder.row_index.try_get(widen_u64(ty_row)) {
        Option::Some(x) => x,
        Option::None => NONE32,
    }
}

// The value type of row `ty_row` (defining it first if needed).
fn valtype(inout encoder: E, inout builder: B, in wit: Wit, ty_row: u32, inout out: ChunkSeq[u8]) {
    let ty = ty_at(in wit, ty_row);
    if ty.kind == T_PRIM {
        out.push(wrapping_u8(ty.data));
        return;
    }
    let type_index = index(inout encoder, inout builder, in wit, ty_row);
    sleb_index(inout out, type_index);
}

// `encode_valtype` for a non-primitive row: its index in this space.
fn index(inout encoder: E, inout builder: B, in wit: Wit, ty_row: u32) -> u32 {
    let known = mapped(in encoder, ty_row);
    if known != NONE32 {
        return known;
    }
    let ty = ty_at(in wit, ty_row);
    let mut body = ChunkSeq::new[u8]();
    if ty.kind == T_TUPLE {
        body.push(TY_TUPLE);
        uleb(inout body, ty.elem_count);
        for k in 0..ty.elem_count {
            valtype(
                inout encoder,
                inout builder,
                in wit,
                arg_at(in wit, add(ty.data, k)),
                inout body
            );
        }
    } else if ty.kind == T_UNIT_RESULT {
        body.push(TY_RESULT);
        body.push(0);
        body.push(0);
    } else {
        let def = def_at(in wit, ty.data);
        if def.kind == D_RECORD {
            body.push(TY_RECORD);
        } else {
            body.push(TY_VARIANT);
        }
        uleb(inout body, def.field_count);
        for k in 0..def.field_count {
            let field = field_at(in wit, add(def.field_start, k));
            put_name(inout body, in wit, field.name_start, field.name_len);
            if def.kind == D_RECORD {
                valtype(inout encoder, inout builder, in wit, field.ty, inout body);
            } else {
                if field.ty == NONE32 {
                    body.push(0);
                } else {
                    body.push(1);
                    valtype(inout encoder, inout builder, in wit, field.ty, inout body);
                }
                // no `refines`
                body.push(0);
            }
        }
    }
    let mut type_index = builder.type_def(in body.as_slice());
    if ty.kind == T_NAMED {
        let def = def_at(in wit, ty.data);
        if encoder.mode == M_IMPORT {
            let mut import_name = ChunkSeq::new[u8]();
            import_name.extend(in "import-type-".as_bytes());
            import_name.extend(in wit.text[def.name_start..add(def.name_start, def.name_len)]);
            builder.item(S_IMPORT);
            builder.section.push(0);
            put_str(inout builder.section, in import_name.as_slice());
            builder.section.push(SORT_TYPE);
            // TypeBounds::Eq
            builder.section.push(0);
            uleb(inout builder.section, widen_u64(type_index));
            type_index = builder.add(NS_TYPE, in import_name.as_slice());
            encoder.imports.push(ty.data);
        } else if encoder.mode == M_EXPORT {
            builder.item(S_EXPORT);
            builder.section.push(0);
            put_name(inout builder.section, in wit, def.name_start, def.name_len);
            builder.section.push(SORT_TYPE);
            uleb(inout builder.section, widen_u64(type_index));
            builder.section.push(0);
            type_index = builder
                .add(NS_TYPE, in wit.text[def.name_start..add(def.name_start, def.name_len)]);
        }
    }
    encoder.row_index.try_set(widen_u64(ty_row), type_index);
    type_index
}

fn same_name(in wit: Wit, first_at: u64, first_len: u64, second_at: u64, second_len: u64) -> bool {
    if first_len != second_len {
        return false;
    }
    for k in 0..first_len {
        if text_at(in wit, add(first_at, k)) != text_at(in wit, add(second_at, k)) {
            return false;
        }
    }
    true
}

// Functions `f` and `g` have one signature (`FunctionKey`: parameter names
// and types, and the result).
fn same_sig(in wit: Wit, f: u64, g: u64) -> bool {
    let first = func_at(in wit, f);
    let second = func_at(in wit, g);
    if first.param_count != second.param_count || first.result != second.result {
        return false;
    }
    for k in 0..first.param_count {
        let first_param = field_at(in wit, add(first.param_start, k));
        let second_param = field_at(in wit, add(second.param_start, k));
        if first_param.ty != second_param.ty
            || !same_name(
                in wit,
                first_param.name_start,
                first_param.name_len,
                second_param.name_start,
                second_param.name_len
            ) {
            return false;
        }
    }
    true
}

// `encode_func_type` for `funcs` row `f`.
fn func_type(inout encoder: E, inout builder: B, in wit: Wit, f: u64) -> u32 {
    for i in 0..encoder.sig_funcs.len() {
        let seen = match encoder.sig_funcs.try_get(i) {
            Option::Some(x) => x,
            Option::None => 0,
        };
        if same_sig(in wit, f, seen) {
            return match encoder.sig_types.try_get(i) {
                Option::Some(x) => x,
                Option::None => 0,
            };
        }
    }
    let func = func_at(in wit, f);
    let mut body = ChunkSeq::new[u8]();
    body.push(TY_FUNC);
    uleb(inout body, func.param_count);
    for k in 0..func.param_count {
        let param = field_at(in wit, add(func.param_start, k));
        put_name(inout body, in wit, param.name_start, param.name_len);
        valtype(inout encoder, inout builder, in wit, param.ty, inout body);
    }
    if func.result == NONE32 {
        body.push(1);
        body.push(0);
    } else {
        body.push(0);
        valtype(inout encoder, inout builder, in wit, func.result, inout body);
    }
    let type_index = builder.type_def(in body.as_slice());
    encoder.sig_funcs.push(f);
    encoder.sig_types.push(type_index);
    type_index
}

// Flat core values of row `ty_row` in the canonical ABI.
fn flat(in wit: Wit, ty_row: u32, depth: u64) -> u64 {
    let ty = ty_at(in wit, ty_row);
    if depth > 64 {
        return 2;
    }
    if ty.kind == T_PRIM {
        if wrapping_u8(ty.data) == P_STRING {
            return 2;
        }
        return 1;
    }
    if ty.kind == T_UNIT_RESULT {
        return 1;
    }
    if ty.kind == T_TUPLE {
        let mut total: u64 = 0;
        for k in 0..ty.elem_count {
            total = add(total, flat(in wit, arg_at(in wit, add(ty.data, k)), inc(depth)));
        }
        return total;
    }
    let def = def_at(in wit, ty.data);
    let mut total: u64 = 0;
    for k in 0..def.field_count {
        let field = field_at(in wit, add(def.field_start, k));
        if field.ty != NONE32 {
            let part = flat(in wit, field.ty, inc(depth));
            if def.kind == D_RECORD {
                total = add(total, part);
            } else if part > total {
                total = part;
            }
        }
    }
    if def.kind == D_RECORD {
        total
    } else {
        inc(total)
    }
}

fn has_string(in wit: Wit, ty_row: u32, depth: u64) -> bool {
    let ty = ty_at(in wit, ty_row);
    if depth > 64 {
        return true;
    }
    if ty.kind == T_PRIM {
        return wrapping_u8(ty.data) == P_STRING;
    }
    if ty.kind == T_UNIT_RESULT {
        return false;
    }
    if ty.kind == T_TUPLE {
        for k in 0..ty.elem_count {
            if has_string(in wit, arg_at(in wit, add(ty.data, k)), inc(depth)) {
                return true;
            }
        }
        return false;
    }
    let def = def_at(in wit, ty.data);
    for k in 0..def.field_count {
        let field = field_at(in wit, add(def.field_start, k));
        if field.ty != NONE32 && has_string(in wit, field.ty, inc(depth)) {
            return true;
        }
    }
    false
}

// The interface's functions: `funcs[func_start..func_start+func_count]`; its definitions are
// all of `defs` for the entry and none for wasi:cli/run.
copy struct Iface {
    kind: u8,
    func_start: u64,
    func_count: u64,
}

fn iface(in wit: Wit, kind: u8) -> Iface {
    if kind == I_RUN {
        Iface { kind: kind, func_start: wit.run_func, func_count: 1 }
    } else {
        Iface {
            kind: kind,
            func_start: wit.entry_start,
            func_count: wrapping_sub(wit.funcs.len(), wit.entry_start)
        }
    }
}

fn iface_name(kind: u8, inout out: ChunkSeq[u8]) {
    if kind == I_RUN {
        out.extend(in "wasi:cli/run@0.2.0".as_bytes());
    } else {
        out.extend(in "vesper:program/entry@0.1.0".as_bytes());
    }
}

fn defs_of(in wit: Wit, kind: u8) -> u64 {
    if kind == I_RUN { 0 } else { wit.defs.len() }
}

fn takes_string(in wit: Wit, func: Func) -> bool {
    for k in 0..func.param_count {
        if has_string(in wit, field_at(in wit, add(func.param_start, k)).ty, 0) {
            return true;
        }
    }
    false
}

fn at32(in s: Slice[u32], i: u64) -> u32 {
    match s.try_get(i) {
        Option::Some(x) => x,
        Option::None => NONE32,
    }
}

fn at64(in s: Slice[u64], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

// The core module wit-component embeds: the input and the producers.
fn main_module(inout builder: B, in core: Slice[u8]) {
    let mut module = ChunkSeq::with_capacity[u8](add(core.len(), 64));
    module.extend(in core);
    producers(inout module);
    builder.raw(S_CORE_MODULE, in module.as_slice());
    builder.add(NS_CORE_MODULE, in "main".as_bytes());
}

fn alias_core_export(inout builder: B, sort: u8, inst: u32, in name: Slice[u8]) {
    builder.item(S_ALIAS);
    builder.section.push(SORT_CORE);
    builder.section.push(sort);
    builder.section.push(ALIAS_CORE_EXPORT);
    uleb(inout builder.section, widen_u64(inst));
    put_str(inout builder.section, in name);
}

fn alias_export(inout builder: B, sort: u8, inst: u32, in name: Slice[u8]) {
    builder.item(S_ALIAS);
    builder.section.push(sort);
    builder.section.push(ALIAS_EXPORT);
    uleb(inout builder.section, widen_u64(inst));
    put_str(inout builder.section, in name);
}

fn memory_alias(inout builder: B, inst: u32) -> u32 {
    alias_core_export(inout builder, CORE_MEMORY, inst, in "memory".as_bytes());
    builder.add(NS_CORE_MEMORY, in "memory".as_bytes())
}

// The component for core module `core` and the parsed world `wit` into
// `out`; 0, or why it declines (`X_*`).
pub fn encode(in core: Slice[u8], in wit: Wit, inout out: ChunkSeq[u8]) -> u64 {
    if wit.plugin {
        return encode_plugin(in core, in wit, inout out);
    }
    let mut builder = b_new();
    // The host interfaces: each instance type and import, and the types
    // later interfaces alias (`encode_imports`).
    let iface_total = if_count();
    let mut host_insts = ChunkSeq::new[u32]();
    let mut alias_types = ChunkSeq::new[u32]();
    for iface_id in 0..iface_total {
        host_insts.push(NONE32);
        alias_types.push(NONE32);
    }
    let mut need_descriptor = false;
    for pos in 0..wit.imports.len() {
        let host = match wit.imports.try_get(pos) {
            Option::Some(k) => k,
            Option::None => 0,
        };
        if needs_descriptor_alias(host) {
            need_descriptor = true;
        }
    }
    for pos in 0..wit.imports.len() {
        let host = match wit.imports.try_get(pos) {
            Option::Some(k) => k,
            Option::None => 0,
        };
        let (first_iface, iface_count) = import_ifaces(host);
        for k in 0..iface_count {
            let iface_id = wrapping_add(first_iface, wrapping_u8(k));
            if at32(in host_insts.as_slice(), widen_u64(iface_id)) != NONE32 {
                continue;
            }
            let mut name = ChunkSeq::new[u8]();
            host_name(iface_id, inout name);
            let mut type_name = ChunkSeq::new[u8]();
            type_name.extend(in "ty-".as_bytes());
            type_name.extend(in name.as_slice());
            builder.item(S_TYPE);
            instance_type(iface_id, in alias_types.as_slice(), inout builder.section);
            let inst_type = builder.add(NS_TYPE, in type_name.as_slice());
            builder.item(S_IMPORT);
            builder.section.push(0);
            put_str(inout builder.section, in name.as_slice());
            builder.section.push(EXTERN_INSTANCE);
            uleb(inout builder.section, widen_u64(inst_type));
            let host_inst = builder.add(NS_INSTANCE, in name.as_slice());
            host_insts.try_set(widen_u64(iface_id), host_inst);
            let mut alias = ChunkSeq::new[u8]();
            aliased_type(iface_id, need_descriptor, inout alias);
            if alias.len() > 0 {
                alias_export(inout builder, SORT_TYPE, host_inst, in alias.as_slice());
                let alias_ty = builder.add(NS_TYPE, in alias.as_slice());
                alias_types.try_set(widen_u64(iface_id), alias_ty);
            }
        }
    }
    main_module(inout builder, in core);
    let core_info = read_core(in core);
    if !core_info.ok {
        return X_CORE;
    }
    // Each import's interface and lowering; the indirect ones (through the
    // shim) in order.
    let mut import_iface_ids = ChunkSeq::new[u8]();
    let mut lowerings = ChunkSeq::new[u8]();
    let mut indirect = ChunkSeq::new[u64]();
    let mut sigs = ChunkSeq::new[u64]();
    for k in 0..core_info.imports.len() {
        let func_import = imp_at(in core_info, k);
        let iface_id = iface_of(
            in core_info
                .text[
                    func_import.module_start..add(func_import.module_start, func_import.module_len)
                ]
        );
        if iface_id == NONE8 || at32(in host_insts.as_slice(), widen_u64(iface_id)) == NONE32 {
            return X_IMPORT;
        }
        let lowering = lower_kind(
            iface_id,
            in core_info
                .text[func_import.field_start..add(func_import.field_start, func_import.field_len)]
        );
        if !lower_ok(lowering) || func_import.ty >= core_info.sigs.len() {
            return X_IMPORT;
        }
        if lower_is_indirect(lowering) {
            indirect.push(k);
            sigs.push(func_import.ty);
        }
        import_iface_ids.push(iface_id);
        lowerings.push(lowering);
    }
    let mut producer_section = ChunkSeq::new[u8]();
    producers(inout producer_section);
    let mut shim_inst = NONE32;
    if indirect.len() > 0 {
        let mut module = ChunkSeq::new[u8]();
        shim_module(in core_info, in sigs.as_slice(), in producer_section.as_slice(), inout module);
        builder.raw(S_CORE_MODULE, in module.as_slice());
        let shim_index = builder.add(NS_CORE_MODULE, in "wit-component-shim-module".as_bytes());
        builder.item(S_CORE_INSTANCE);
        builder.section.push(INSTANTIATE);
        uleb(inout builder.section, widen_u64(shim_index));
        uleb(inout builder.section, 0);
        shim_inst = builder.add(NS_CORE_INSTANCE, in "wit-component-shim-instance".as_bytes());
    }
    let mut root = e_new(in wit, M_ROOT);
    // The exported interfaces' own types.
    for pos in 0..wit.exports.len() {
        let kind = match wit.exports.try_get(pos) {
            Option::Some(k) => k,
            Option::None => 0,
        };
        for def_row in 0..defs_of(in wit, kind) {
            index(inout root, inout builder, in wit, def_at(in wit, def_row).ty);
        }
    }
    // One core instance per imported module (in order of first import),
    // then the main instance with them (`encode_core_instantiation`).
    let mut instance_args = ChunkSeq::new[u8]();
    let mut arg_count: u64 = 0;
    let mut done = ChunkSeq::new[bool]();
    for k in 0..core_info.imports.len() {
        done.push(false);
    }
    for k in 0..core_info.imports.len() {
        if match done.try_get(k) {
            Option::Some(is_done) => is_done,
            Option::None => true,
        }
        {
            continue;
        }
        let first_import = imp_at(in core_info, k);
        let iface_id = byte(in import_iface_ids.as_slice(), k);
        let mut exports = ChunkSeq::new[u8]();
        let mut export_count: u64 = 0;
        for j in k..core_info.imports.len() {
            let func_import = imp_at(in core_info, j);
            if byte(in import_iface_ids.as_slice(), j) != iface_id {
                continue;
            }
            done.try_set(j, true);
            let field_end = add(func_import.field_start, func_import.field_len);
            let lowering = byte(in lowerings.as_slice(), j);
            let host_inst = at32(in host_insts.as_slice(), widen_u64(iface_id));
            let mut core_func: u32 = 0;
            if lower_is_indirect(lowering) {
                let mut slot: u64 = 0;
                for q in 0..indirect.len() {
                    if at64(in indirect.as_slice(), q) == j {
                        slot = q;
                    }
                }
                let mut slot_name = ChunkSeq::new[u8]();
                put_decimal(inout slot_name, slot);
                alias_core_export(inout builder, CORE_FUNC, shim_inst, in slot_name.as_slice());
                let mut func_name = ChunkSeq::new[u8]();
                indirect_name(in core_info, func_import, inout func_name);
                core_func = builder.add(NS_CORE_FUNC, in func_name.as_slice());
            } else if lower_is_drop(lowering) {
                // `[resource-drop]` and the resource's name
                alias_export(
                    inout builder,
                    SORT_TYPE,
                    host_inst,
                    in core_info.text[add(func_import.field_start, 15)..field_end]
                );
                let resource_ty = builder
                    .add(NS_TYPE, in core_info.text[add(func_import.field_start, 15)..field_end]);
                builder.item(S_CANON);
                builder.section.push(CANON_RESOURCE_DROP);
                uleb(inout builder.section, widen_u64(resource_ty));
                core_func = builder.add(NS_CORE_FUNC, in "resource.drop".as_bytes());
            } else {
                alias_export(
                    inout builder,
                    SORT_FUNC,
                    host_inst,
                    in core_info.text[func_import.field_start..field_end]
                );
                let host_func = builder
                    .add(NS_FUNC, in core_info.text[func_import.field_start..field_end]);
                builder.item(S_CANON);
                builder.section.push(CANON_LOWER);
                builder.section.push(0);
                uleb(inout builder.section, widen_u64(host_func));
                uleb(inout builder.section, 0);
                core_func = builder
                    .add(NS_CORE_FUNC, in core_info.text[func_import.field_start..field_end]);
            }
            put_str(inout exports, in core_info.text[func_import.field_start..field_end]);
            exports.push(CORE_FUNC);
            uleb(inout exports, widen_u64(core_func));
            export_count = inc(export_count);
        }
        builder.item(S_CORE_INSTANCE);
        builder.section.push(FROM_EXPORTS);
        uleb(inout builder.section, export_count);
        builder.section.extend(in exports.as_slice());
        let module_end = add(first_import.module_start, first_import.module_len);
        let core_inst = builder
            .add(NS_CORE_INSTANCE, in core_info.text[first_import.module_start..module_end]);
        put_str(inout instance_args, in core_info.text[first_import.module_start..module_end]);
        instance_args.push(CORE_INSTANCE);
        uleb(inout instance_args, widen_u64(core_inst));
        arg_count = inc(arg_count);
    }
    // (core instance (instantiate 0 (with ...)))
    builder.item(S_CORE_INSTANCE);
    builder.section.push(INSTANTIATE);
    uleb(inout builder.section, 0);
    uleb(inout builder.section, arg_count);
    builder.section.extend(in instance_args.as_slice());
    let main_inst = builder.add(NS_CORE_INSTANCE, in "main".as_bytes());
    let mem = memory_alias(inout builder, main_inst);
    let mut realloc = NONE32;
    // The fixup module fills the shim's table with the real lowerings.
    if indirect.len() > 0 {
        let mut module = ChunkSeq::new[u8]();
        fixup_module(
            in core_info,
            in sigs.as_slice(),
            in producer_section.as_slice(),
            inout module
        );
        builder.raw(S_CORE_MODULE, in module.as_slice());
        let fixup_index = builder.add(NS_CORE_MODULE, in "wit-component-fixup".as_bytes());
        let mut actual = ChunkSeq::new[u8]();
        for q in 0..indirect.len() {
            let j = at64(in indirect.as_slice(), q);
            let func_import = imp_at(in core_info, j);
            let field_end = add(func_import.field_start, func_import.field_len);
            let host_inst = at32(
                in host_insts.as_slice(),
                widen_u64(byte(in import_iface_ids.as_slice(), j))
            );
            alias_export(
                inout builder,
                SORT_FUNC,
                host_inst,
                in core_info.text[func_import.field_start..field_end]
            );
            let host_func = builder
                .add(NS_FUNC, in core_info.text[func_import.field_start..field_end]);
            let import_lowering = byte(in lowerings.as_slice(), j);
            let need_realloc = lower_uses_realloc(import_lowering);
            let utf8 = lower_uses_utf8(import_lowering);
            if need_realloc && realloc == NONE32 {
                alias_core_export(
                    inout builder,
                    CORE_FUNC,
                    main_inst,
                    in "cabi_realloc".as_bytes()
                );
                realloc = builder.add(NS_CORE_FUNC, in "cabi_realloc".as_bytes());
            }
            builder.item(S_CANON);
            builder.section.push(CANON_LOWER);
            builder.section.push(0);
            uleb(inout builder.section, widen_u64(host_func));
            let mut opt_count: u64 = 1;
            if need_realloc {
                opt_count = inc(opt_count);
            }
            if utf8 {
                opt_count = inc(opt_count);
            }
            uleb(inout builder.section, opt_count);
            builder.section.push(OPT_MEMORY);
            uleb(inout builder.section, widen_u64(mem));
            if need_realloc {
                builder.section.push(OPT_REALLOC);
                uleb(inout builder.section, widen_u64(realloc));
            }
            if utf8 {
                builder.section.push(OPT_UTF8);
            }
            let mut func_name = ChunkSeq::new[u8]();
            indirect_name(in core_info, func_import, inout func_name);
            let core_func = builder.add(NS_CORE_FUNC, in func_name.as_slice());
            let mut slot_name = ChunkSeq::new[u8]();
            put_decimal(inout slot_name, q);
            put_str(inout actual, in slot_name.as_slice());
            actual.push(CORE_FUNC);
            uleb(inout actual, widen_u64(core_func));
        }
        builder.item(S_CORE_INSTANCE);
        builder.section.push(FROM_EXPORTS);
        uleb(inout builder.section, indirect.len());
        builder.section.extend(in actual.as_slice());
        let actual_inst = builder.add(NS_CORE_INSTANCE, in "actual".as_bytes());
        builder.item(S_CORE_INSTANCE);
        builder.section.push(INSTANTIATE);
        uleb(inout builder.section, widen_u64(fixup_index));
        uleb(inout builder.section, 2);
        put_str(inout builder.section, in "actual".as_bytes());
        builder.section.push(CORE_INSTANCE);
        uleb(inout builder.section, widen_u64(actual_inst));
        put_str(inout builder.section, in "shim".as_bytes());
        builder.section.push(CORE_INSTANCE);
        uleb(inout builder.section, widen_u64(shim_inst));
        builder.add(NS_CORE_INSTANCE, in "fixup".as_bytes());
    }
    for pos in 0..wit.exports.len() {
        let kind = match wit.exports.try_get(pos) {
            Option::Some(k) => k,
            Option::None => 0,
        };
        export_iface(
            inout builder,
            inout root,
            in wit,
            iface(in wit, kind),
            main_inst,
            mem,
            inout realloc
        );
    }
    builder.append_names();
    builder.flush();
    builder.out.extend(in producer_section.as_slice());
    let component = builder.finish();
    out.extend(in component.as_slice());
    0
}

// "indirect-<module>-<field>"
fn indirect_name(in core: Core, func_import: Imp, inout out: ChunkSeq[u8]) {
    out.extend(in "indirect-".as_bytes());
    out.extend(
        in core.text[
            func_import.module_start..add(func_import.module_start, func_import.module_len)
        ]
    );
    out.push(45);
    out.extend(
        in core.text[func_import.field_start..add(func_import.field_start, func_import.field_len)]
    );
}

// The Nexus plugin world: its functions lifted and exported at the root.
fn encode_plugin(in core: Slice[u8], in wit: Wit, inout out: ChunkSeq[u8]) -> u64 {
    let mut builder = b_new();
    main_module(inout builder, in core);
    builder.item(S_CORE_INSTANCE);
    builder.section.push(INSTANTIATE);
    uleb(inout builder.section, 0);
    uleb(inout builder.section, 0);
    let main_inst = builder.add(NS_CORE_INSTANCE, in "main".as_bytes());
    memory_alias(inout builder, main_inst);
    let mut root = e_new(in wit, M_ROOT);
    for func_row in wit.entry_start..wit.funcs.len() {
        let func = func_at(in wit, func_row);
        // The backend's plugin entry is fn(u32, u64) -> i64: no options.
        if takes_string(in wit, func)
            || (
                func.result != NONE32
                    && (has_string(in wit, func.result, 0) || flat(in wit, func.result, 0) > 1)
            ) {
            return X_PLUGIN;
        }
        let func_ty = func_type(inout root, inout builder, in wit, func_row);
        let name_end = add(func.name_start, func.name_len);
        alias_core_export(
            inout builder,
            CORE_FUNC,
            main_inst,
            in wit.text[func.name_start..name_end]
        );
        let core_func = builder.add(NS_CORE_FUNC, in wit.text[func.name_start..name_end]);
        builder.item(S_CANON);
        builder.section.push(CANON_LIFT);
        builder.section.push(0);
        uleb(inout builder.section, widen_u64(core_func));
        uleb(inout builder.section, 0);
        uleb(inout builder.section, widen_u64(func_ty));
        let lifted = builder.add(NS_FUNC, in wit.text[func.name_start..name_end]);
        builder.item(S_EXPORT);
        builder.section.push(0);
        put_str(inout builder.section, in wit.text[func.name_start..name_end]);
        builder.section.push(SORT_FUNC);
        uleb(inout builder.section, widen_u64(lifted));
        builder.section.push(0);
        builder.add(NS_FUNC, in wit.text[func.name_start..name_end]);
    }
    builder.append_names();
    let mut producer_section = ChunkSeq::new[u8]();
    producers(inout producer_section);
    builder.flush();
    builder.out.extend(in producer_section.as_slice());
    let component = builder.finish();
    out.extend(in component.as_slice());
    0
}

// `encode_interface_export` for interface `iface_info`.
fn export_iface(
    inout builder: B,
    inout root: E,
    in wit: Wit,
    iface_info: Iface,
    main_inst: u32,
    mem: u32,
    inout realloc: u32
) {
    let mut full_name = ChunkSeq::new[u8]();
    iface_name(iface_info.kind, inout full_name);
    // Instantiation arguments: (name, sort, index).
    let mut instance_args = ChunkSeq::new[u8]();
    let mut arg_count: u64 = 0;
    for k in 0..iface_info.func_count {
        let func_row = add(iface_info.func_start, k);
        let func = func_at(in wit, func_row);
        let func_ty = func_type(inout root, inout builder, in wit, func_row);
        let mut core_name = ChunkSeq::new[u8]();
        core_name.extend(in full_name.as_slice());
        core_name.push(35);
        core_name.extend(in wit.text[func.name_start..add(func.name_start, func.name_len)]);
        builder.item(S_ALIAS);
        builder.section.push(SORT_CORE);
        builder.section.push(CORE_FUNC);
        builder.section.push(1);
        uleb(inout builder.section, widen_u64(main_inst));
        put_str(inout builder.section, in core_name.as_slice());
        let core_func = builder.add(NS_CORE_FUNC, in core_name.as_slice());
        let string_params = takes_string(in wit, func);
        let mut uses_strings = string_params;
        if string_params && realloc == NONE32 {
            alias_core_export(inout builder, CORE_FUNC, main_inst, in "cabi_realloc".as_bytes());
            realloc = builder.add(NS_CORE_FUNC, in "cabi_realloc".as_bytes());
        }
        let mut needs_memory = false;
        if func.result != NONE32 {
            if has_string(in wit, func.result, 0) {
                uses_strings = true;
            }
            if flat(in wit, func.result, 0) > 1 {
                needs_memory = true;
            }
        }
        builder.item(S_CANON);
        builder.section.push(0);
        builder.section.push(0);
        uleb(inout builder.section, widen_u64(core_func));
        let mut opt_count: u64 = 0;
        if needs_memory || uses_strings {
            opt_count = inc(opt_count);
        }
        if string_params {
            opt_count = inc(opt_count);
        }
        if uses_strings {
            opt_count = inc(opt_count);
        }
        uleb(inout builder.section, opt_count);
        if needs_memory || uses_strings {
            builder.section.push(OPT_MEMORY);
            uleb(inout builder.section, widen_u64(mem));
        }
        if string_params {
            builder.section.push(OPT_REALLOC);
            uleb(inout builder.section, widen_u64(realloc));
        }
        if uses_strings {
            builder.section.push(OPT_UTF8);
        }
        uleb(inout builder.section, widen_u64(func_ty));
        let lifted = builder
            .add(NS_FUNC, in wit.text[func.name_start..add(func.name_start, func.name_len)]);
        put_import_func_name(inout instance_args, in wit, func);
        instance_args.push(SORT_FUNC);
        uleb(inout instance_args, widen_u64(lifted));
        arg_count = inc(arg_count);
    }
    // The shim component.
    let mut shim = b_new();
    let mut import_encoder = e_new(in wit, M_IMPORT);
    for k in 0..iface_info.func_count {
        let func_row = add(iface_info.func_start, k);
        let func = func_at(in wit, func_row);
        let import_ty = func_type(inout import_encoder, inout shim, in wit, func_row);
        let mut import_name = ChunkSeq::new[u8]();
        import_name.extend(in "import-func-".as_bytes());
        import_name.extend(in wit.text[func.name_start..add(func.name_start, func.name_len)]);
        shim.item(S_IMPORT);
        shim.section.push(0);
        put_str(inout shim.section, in import_name.as_slice());
        shim.section.push(SORT_FUNC);
        uleb(inout shim.section, widen_u64(import_ty));
        shim.add(NS_FUNC, in import_name.as_slice());
    }
    for k in 0..import_encoder.imports.len() {
        let def = def_at(
            in wit,
            match import_encoder.imports.try_get(k) {
                Option::Some(x) => x,
                Option::None => 0,
            }
        );
        uleb(inout instance_args, add(def.name_len, 12));
        instance_args.extend(in "import-type-".as_bytes());
        instance_args.extend(in wit.text[def.name_start..add(def.name_start, def.name_len)]);
        instance_args.push(SORT_TYPE);
        uleb(inout instance_args, widen_u64(mapped(in root, def.ty)));
        arg_count = inc(arg_count);
    }
    let mut export_encoder = e_new(in wit, M_EXPORT);
    for def_row in 0..defs_of(in wit, iface_info.kind) {
        index(inout export_encoder, inout shim, in wit, def_at(in wit, def_row).ty);
    }
    for k in 0..iface_info.func_count {
        let func_row = add(iface_info.func_start, k);
        let func = func_at(in wit, func_row);
        let export_ty = func_type(inout export_encoder, inout shim, in wit, func_row);
        shim.item(S_EXPORT);
        shim.section.push(0);
        put_name(inout shim.section, in wit, func.name_start, func.name_len);
        shim.section.push(SORT_FUNC);
        uleb(inout shim.section, k);
        // ascribed type: (func t)
        shim.section.push(1);
        shim.section.push(SORT_FUNC);
        uleb(inout shim.section, widen_u64(export_ty));
        shim.add(NS_FUNC, in wit.text[func.name_start..add(func.name_start, func.name_len)]);
    }
    let nested = shim.finish();
    builder.raw(S_COMPONENT, in nested.as_slice());
    let mut comp_name = ChunkSeq::new[u8]();
    comp_name.extend(in full_name.as_slice());
    comp_name.extend(in "-shim-component".as_bytes());
    let shim_comp = builder.add(NS_COMPONENT, in comp_name.as_slice());
    builder.item(S_INSTANCE);
    builder.section.push(0);
    uleb(inout builder.section, widen_u64(shim_comp));
    uleb(inout builder.section, arg_count);
    builder.section.extend(in instance_args.as_slice());
    let mut inst_name = ChunkSeq::new[u8]();
    inst_name.extend(in full_name.as_slice());
    inst_name.extend(in "-shim-instance".as_bytes());
    let shim_inst = builder.add(NS_INSTANCE, in inst_name.as_slice());
    builder.item(S_EXPORT);
    builder.section.push(0);
    put_str(inout builder.section, in full_name.as_slice());
    builder.section.push(SORT_INSTANCE);
    uleb(inout builder.section, widen_u64(shim_inst));
    builder.section.push(0);
    builder.add(NS_INSTANCE, in full_name.as_slice());
    // The interface's own types leave the root maps.
    for def_row in 0..defs_of(in wit, iface_info.kind) {
        root.row_index.try_set(widen_u64(def_at(in wit, def_row).ty), NONE32);
    }
}

fn put_import_func_name(inout out: ChunkSeq[u8], in wit: Wit, func: Func) {
    uleb(inout out, add(func.name_len, 12));
    out.extend(in "import-func-".as_bytes());
    out.extend(in wit.text[func.name_start..add(func.name_start, func.name_len)]);
}
