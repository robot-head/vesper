// `Renamer` of src/packages.rs: renames a module's references to their
// internal names and shifts its spans to the module's base offset, in
// place in the module's `@vesper/ast` arenas. Names are compared as global
// symbols (`tr`); a renamed name is interned back into the AST (`back`).
//
// Diagnostics carry file-local spans (the node's span before it shifts),
// as in Rust.

use @vesper/ast::{
    Ast, Lit, AdtNode, ArgNode, AssocBindNode, AssocDeclNode, ClauseNode, ConfNode, EffectDeclNode,
    EffectNode, EffectsNode, ExprNode, FieldNode, FnNode, GenericNode, ImplNode, ParamNode, PatNode,
    StmtNode, TraitNode, TraitRefNode, TypeNode, VariantNode, WhereNode, expr_at, list_at, list_len,
    none as ast_none, pat_at, type_at
};
use @vesper-std/collections::flat_table::{FlatTable};
use @vesper-std/arena::{idx_from_raw};
use self::state::{
    St, at32, at64, at8, const_flags, emit, err, hi, inc, kind_has, kind_type, kind_value, lo, n32,
    none, pair, push_sym, sym_byte, sym_len, sym_path_split, sym_slice, sym_starts, w
};
use self::load::{adt_at, back, effect_decl_at, fn_at, tr};
use self::resolve::{qualified, sugar_name, unknown_import};

fn file(in loader: St) -> u32 {
    at32(in loader.mod_file, w(loader.cur_module))
}

fn sh(in loader: St, pos: u32) -> u32 {
    wrapping_add(pos, loader.shift)
}

// Marks `node` renamed; whether it already was.
fn revisit(inout seen: FlatTable[u32, u8], node: u32) -> bool {
    match seen.insert(node, 1) {
        Option::Some(_) => true,
        Option::None => false,
    }
}

fn has(in stack: ChunkSeq[u32], sym: u32) -> bool {
    let mut i = stack.len();
    loop {
        if i == 0 {
            break false;
        }
        i = wrapping_sub(i, 1);
        if at32(in stack, i) == sym {
            break true;
        }
    }
}

// `is_qualified`: `self::..`, `super::..` or `@scope/name::..`.
fn is_qualified(in loader: St, name: u32) -> bool {
    sym_starts(in loader, name, in "self::")
        || sym_starts(in loader, name, in "super::")
        || sym_starts(in loader, name, in "@")
}

// Whether `start..end` lies in a hole of region `region`.
fn in_hole(in loader: St, region: u64, start: u32, end: u32) -> bool {
    let first = w(at32(in loader.sr_hole_first, region));
    let count = w(at32(in loader.sr_hole_count, region));
    for hole in first..wrapping_add(first, count) {
        let at = hole << 1;
        if at32(in loader.sr_holes, at) <= start && end <= at32(in loader.sr_holes, inc(at)) {
            return true;
        }
    }
    false
}

// `Renamer::definition`: the module defining the innermost expanded
// region that holds `start..end` outside its holes (the last of equally
// long ones), when that module is another one; else `none()`.
fn definition(in loader: St, start: u32, end: u32) -> u32 {
    let mut best = none();
    let mut best_len: u32 = 0;
    let mut i = loader.cur_region_count;
    loop {
        if i == 0 {
            break;
        }
        i = wrapping_sub(i, 1);
        let region = wrapping_add(loader.cur_region_first, i);
        let region_start = at32(in loader.sr_start, region);
        let region_end = at32(in loader.sr_end, region);
        if region_start <= start && end <= region_end && !in_hole(in loader, region, start, end) {
            let len = wrapping_sub(region_end, region_start);
            if best == none() || len < best_len {
                best = n32(region);
                best_len = len;
            }
        }
    }
    if best == none() {
        return none();
    }
    let author = at32(in loader.sr_author, w(best));
    if author == loader.cur_module {
        none()
    } else {
        author
    }
}

// Whether `name` starts with the module's fresh sugar prefix.
fn fresh(in loader: St, name: u32) -> bool {
    let prefix = loader.cur_prefix;
    if prefix == none() {
        return false;
    }
    let len = sym_len(in loader, prefix);
    if sym_len(in loader, name) < len {
        return false;
    }
    for i in 0..len {
        if sym_byte(in loader, name, i) != sym_byte(in loader, prefix, i) {
            return false;
        }
    }
    true
}

// A free name of a sugar template that `scope` defines: resolved there,
// else left for the checker. A name the caller binds is reported, as it
// would capture the template's reference.
fn resolve_at_definition(
    inout loader: St,
    scope: u32,
    name: u32,
    start: u32,
    end: u32,
    ns: u8
) -> u32 {
    let target = sugar_name(inout loader, scope, name, ns);
    if target != none() {
        return target;
    }
    let bound = match loader.names.get(name) {
        Option::Some(binding) => kind_has(wrapping_u8(binding >> 32), ns),
        Option::None => false,
    };
    let hidden = !loader.is_root && match loader.hidden.get(name) {
        Option::Some(kind) => kind_has(kind, ns),
        Option::None => false,
    };
    let local = (ns == kind_value() && has(in loader.values, name))
        || (ns == kind_type() && has(in loader.types, name));
    if !fresh(in loader, name) && (bound || hidden || local) {
        err(inout loader, unknown_import(), start, end);
        let mut msg = String::new();
        msg.push_str(in "'");
        push_sym(in loader, name, inout msg);
        msg.push_str(in "' is not declared or imported in the module that defines this sugar");
        loader.err_msg.push_str(in msg);
        emit(inout loader, file(in loader));
    }
    none()
}

// `Renamer::resolve`: a free name in namespace `ns`: an imported or own
// item, else left for the checker (`none()`). A variant of an enum the
// module does not see, or a root module item reached without an import,
// is reported.
fn resolve(inout loader: St, name: u32, start: u32, end: u32, ns: u8) -> u32 {
    let scope = definition(in loader, start, end);
    if scope != none() {
        return resolve_at_definition(inout loader, scope, name, start, end, ns);
    }
    match loader.names.get(name) {
        Option::Some(binding) => {
            if kind_has(wrapping_u8(binding >> 32), ns) {
                return lo(binding);
            }
        },
        Option::None => {},
    }
    // Variants are values: a type such as `String` is never one, even when
    // some package's enum has a variant of that spelling.
    match loader.variant_owner.get(name) {
        Option::Some(owner) => {
            if ns != kind_type() && !loader.targets.contains_key(owner) {
                err(inout loader, unknown_import(), start, end);
                let shown = match loader.variant_shown.get(name) {
                    Option::Some(x) => x,
                    Option::None => loader.empty_sym,
                };
                let mut msg = String::new();
                msg.push_str(in "variant '");
                push_sym(in loader, name, inout msg);
                msg.push_str(in "' belongs to enum ");
                push_sym(in loader, shown, inout msg);
                msg.push_str(in ", which is not declared or imported in this module");
                loader.err_msg.push_str(in msg);
                loader.err_help.push_str(in "import the enum to use its variants");
                loader.err_has_help = true;
                emit(inout loader, file(in loader));
                return none();
            }
        },
        Option::None => {},
    }
    if !loader.is_root {
        match loader.hidden.get(name) {
            Option::Some(kind) => {
                if kind_has(kind, ns) {
                    err(inout loader, unknown_import(), start, end);
                    let mut msg = String::new();
                    msg.push_str(in "'");
                    push_sym(in loader, name, inout msg);
                    msg.push_str(in "' is not declared or imported in this module");
                    loader.err_msg.push_str(in msg);
                    let mut help = String::new();
                    help.push_str(in "items of other modules need an import such as `use self::");
                    push_sym(in loader, name, inout help);
                    help.push_str(in ";` or a path such as `self::");
                    push_sym(in loader, name, inout help);
                    help.push_str(in "`");
                    loader.err_help.push_str(in help);
                    loader.err_has_help = true;
                    emit(inout loader, file(in loader));
                }
            },
            Option::None => {},
        }
    }
    none()
}

// `Renamer::type_name`: a path name `Head::rest` or a plain type or
// effect name. Returns the new name (or `name`).
fn type_name(inout loader: St, name: u32, start: u32, end: u32) -> u32 {
    let len = sym_len(in loader, name);
    let cut = sym_path_split(in loader, name);
    let scope = definition(in loader, start, end);
    // A value enum member `E::M` (own `const$E::M` or imported).
    if cut < len && scope == none() {
        match loader.names.get(name) {
            Option::Some(binding) => {
                return lo(binding);
            },
            Option::None => {},
        }
    }
    if is_qualified(in loader, name) {
        let module = if scope == none() {
            loader.cur_module
        } else {
            scope
        };
        let resolved = qualified(inout loader, module, name, start, end);
        if resolved == none() {
            emit(inout loader, file(in loader));
            return name;
        }
        return resolved;
    }
    let head = if cut >= len {
        name
    } else {
        sym_slice(inout loader, name, 0, cut)
    };
    if scope == none() && has(in loader.types, head) {
        return name;
    }
    let target = resolve(inout loader, head, start, end, kind_type());
    if target == none() {
        return name;
    }
    if cut >= len {
        return target;
    }
    let mut out = String::new();
    push_sym(in loader, target, inout out);
    out.push_str(in "::");
    let rest = sym_slice(inout loader, name, wrapping_add(cut, 2), len);
    push_sym(in loader, rest, inout out);
    loader.interner.intern(in out).id()
}

fn value_name(inout loader: St, name: u32, start: u32, end: u32) -> u32 {
    if sym_path_split(in loader, name) < sym_len(in loader, name) {
        return type_name(inout loader, name, start, end);
    }
    if has(in loader.values, name) && definition(in loader, start, end) == none() {
        return name;
    }
    let target = resolve(inout loader, name, start, end, kind_value());
    if target == none() { name } else { target }
}

// A new literal node of the constant `name`'s value, or `ast_none()` when
// it has none.
fn literal_of(in loader: St, inout ast: Ast, name: u32) -> u32 {
    match loader.lit_row.get(name) {
        Option::Some(row) => {
            let index = w(row);
            let lit = Lit {
                kind: at8(in loader.lit_kind, index),
                neg: at8(in loader.lit_neg, index) != 0,
                bits: at64(in loader.lit_bits, index),
                hi: at64(in loader.lit_hi, index)
            };
            ast.lits.alloc(lit).raw()
        },
        Option::None => ast_none(),
    }
}

// Renames AST name `sym` through `f`'s result: the AST symbol to store.
fn store(inout loader: St, inout ast: Ast, old: u32, new_g: u32, old_g: u32) -> u32 {
    if new_g == old_g {
        old
    } else {
        back(inout loader, inout ast, new_g)
    }
}

// ---------------------------------------------------------------- types

fn ty(inout loader: St, inout ast: Ast, ty_id: u32, start: u32, end: u32) {
    if ty_id == ast_none() {
        return;
    }
    let mut node = type_at(in ast, ty_id);
    if node.kind == 1 {
        let name = tr(inout loader, in ast, node.a);
        if list_len(in ast, node.b) == 0
            && has(in loader.types, name)
            && definition(in loader, start, end) == none()
        {
            return;
        }
        let new_name = type_name(inout loader, name, start, end);
        if new_name != name {
            node.a = back(inout loader, inout ast, new_name);
            ast.types.set(idx_from_raw[TypeNode](ty_id), node);
        }
        for i in 0..list_len(in ast, node.b) {
            let child = list_at(in ast, node.b, i);
            ty(inout loader, inout ast, child, start, end);
        }
    } else if node.kind == 2 {
        for i in 0..list_len(in ast, node.a) {
            let child = list_at(in ast, node.a, i);
            ty(inout loader, inout ast, child, start, end);
        }
    } else if node.kind == 3 {
        let param_words = list_len(in ast, node.a);
        let mut i: u64 = 0;
        loop {
            if inc(i) >= wrapping_add(param_words, 1) {
                break;
            }
            let child = list_at(in ast, node.a, inc(i));
            ty(inout loader, inout ast, child, start, end);
            i = wrapping_add(i, 2);
        }
        ty(inout loader, inout ast, node.b, start, end);
        effects(inout loader, inout ast, node.c, start, end);
    } else if node.kind == 4 {
        effects(inout loader, inout ast, node.a, start, end);
    }
}

fn effects_at(in ast: Ast, effects_id: u32) -> EffectsNode {
    ast.effects.get_or(
        idx_from_raw[EffectsNode](effects_id),
        EffectsNode { instances: 0, tail: ast_none() }
    )
}

fn effect_at(in ast: Ast, effect_id: u32) -> EffectNode {
    ast.effect_nodes.get_or(
        idx_from_raw[EffectNode](effect_id),
        EffectNode { label: ast_none(), name: ast_none(), args: 0 }
    )
}

pub fn effects(inout loader: St, inout ast: Ast, effects_id: u32, start: u32, end: u32) {
    if effects_id == ast_none() {
        return;
    }
    let row = effects_at(in ast, effects_id);
    for i in 0..list_len(in ast, row.instances) {
        let effect_id = list_at(in ast, row.instances, i);
        one_effect(inout loader, inout ast, effect_id, start, end);
    }
}

fn one_effect(inout loader: St, inout ast: Ast, effect_id: u32, start: u32, end: u32) {
    if effect_id == ast_none() {
        return;
    }
    let mut node = effect_at(in ast, effect_id);
    let name = tr(inout loader, in ast, node.name);
    if !has(in loader.types, name) || definition(in loader, start, end) != none() {
        let new_name = type_name(inout loader, name, start, end);
        if new_name != name {
            node.name = back(inout loader, inout ast, new_name);
            ast.effect_nodes.set(idx_from_raw[EffectNode](effect_id), node);
        }
    }
    for i in 0..list_len(in ast, node.args) {
        let arg_ty = list_at(in ast, node.args, i);
        ty(inout loader, inout ast, arg_ty, start, end);
    }
}

// Capability labels of an effect row are value names.
fn labels(inout loader: St, in ast: Ast, effects_id: u32) {
    if effects_id == ast_none() {
        return;
    }
    let row = effects_at(in ast, effects_id);
    for i in 0..list_len(in ast, row.instances) {
        let effect_node = effect_at(in ast, list_at(in ast, row.instances, i));
        if effect_node.label != ast_none() {
            let label = tr(inout loader, in ast, effect_node.label);
            loader.values.push(label);
        }
    }
}

fn generic_name(in ast: Ast, generic_id: u32) -> u32 {
    match ast.generics.get(idx_from_raw[GenericNode](generic_id)) {
        Option::Some(generic) => generic.name,
        Option::None => ast_none(),
    }
}

fn generics(inout loader: St, in ast: Ast, list: u32) {
    for i in 0..list_len(in ast, list) {
        let name = tr(inout loader, in ast, generic_name(in ast, list_at(in ast, list, i)));
        loader.types.push(name);
    }
}

// ---------------------------------------------------------------- patterns

// A constructor pattern's name (file-local span): a constant (own or
// imported) names its function, and a field-less pattern of a literal
// constant becomes the literal (kind 3). Kept out of `pattern`'s frame.
fn constructor_pattern(inout loader: St, inout ast: Ast, node: PatNode) -> PatNode {
    let mut result = node;
    let name = tr(inout loader, in ast, result.a);
    let scope = definition(in loader, result.start, result.end);
    let local = if scope != none() {
        sugar_name(inout loader, scope, name, kind_value())
    } else {
        match loader.names.get(name) {
            Option::Some(binding) => lo(binding),
            Option::None => none(),
        }
    };
    let new_name = if local != none() && (const_flags(inout loader, local) & 2) != 0 {
        local
    } else {
        type_name(inout loader, name, result.start, result.end)
    };
    if new_name != name {
        result.a = back(inout loader, inout ast, new_name);
    }
    if list_len(in ast, result.b) == 0
        && result.c == 0
        && (const_flags(inout loader, new_name) & 2) != 0
    {
        let literal = literal_of(in loader, inout ast, new_name);
        if literal != ast_none() {
            result.kind = 3;
            result.a = literal;
            result.b = ast_none();
            result.c = ast_none();
        }
    }
    result
}

fn pattern(inout loader: St, inout ast: Ast, pat_id: u32) {
    if pat_id == ast_none() {
        return;
    }
    let mut node = pat_at(in ast, pat_id);
    if revisit(inout loader.seen_pat, pat_id) {
        node.start = wrapping_sub(node.start, loader.shift);
        node.end = wrapping_sub(node.end, loader.shift);
    }
    if node.kind == 2 {
        let name = tr(inout loader, in ast, node.a);
        loader.values.push(name);
    } else if node.kind == 4 {
        for i in 0..list_len(in ast, node.a) {
            let child = list_at(in ast, node.a, i);
            pattern(inout loader, inout ast, child);
        }
    } else if node.kind == 5 {
        node = constructor_pattern(inout loader, inout ast, node);
        if node.kind == 5 {
            let field_count = list_len(in ast, node.b);
            let mut i: u64 = 0;
            loop {
                if inc(i) >= wrapping_add(field_count, 1) {
                    break;
                }
                let child = list_at(in ast, node.b, inc(i));
                pattern(inout loader, inout ast, child);
                i = wrapping_add(i, 2);
            }
        }
    }
    node.start = sh(in loader, node.start);
    node.end = sh(in loader, node.end);
    ast.pats.set(idx_from_raw[PatNode](pat_id), node);
}

fn clause(inout loader: St, inout ast: Ast, clause_id: u32) {
    let node = ast.clauses.get_or(
        idx_from_raw[ClauseNode](clause_id),
        ClauseNode { name: ast_none(), pats: 0, body: ast_none() }
    );
    let mark = loader.values.len();
    for i in 0..list_len(in ast, node.pats) {
        let pat_id = list_at(in ast, node.pats, i);
        pattern(inout loader, inout ast, pat_id);
    }
    expr(inout loader, inout ast, node.body);
    loader.values.truncate(mark);
}

fn param(inout loader: St, inout ast: Ast, param_id: u32) {
    let mut node = ast.params.get_or(
        idx_from_raw[ParamNode](param_id),
        ParamNode { name: ast_none(), pass: 0, projections: 0, ty: ast_none(), start: 0, end: 0 }
    );
    if revisit(inout loader.seen_param, param_id) {
        node.start = wrapping_sub(node.start, loader.shift);
        node.end = wrapping_sub(node.end, loader.shift);
    }
    ty(inout loader, inout ast, node.ty, node.start, node.end);
    let name = tr(inout loader, in ast, node.name);
    loader.values.push(name);
    node.start = sh(in loader, node.start);
    node.end = sh(in loader, node.end);
    ast.params.set(idx_from_raw[ParamNode](param_id), node);
}

// ---------------------------------------------------------------- exprs

fn stmt(inout loader: St, inout ast: Ast, stmt_id: u32) {
    let node = ast.stmts.get_or(
        idx_from_raw[StmtNode](stmt_id),
        StmtNode { kind: 0, pat: ast_none(), ty: ast_none(), value: ast_none(), mutable: false }
    );
    if node.kind == 1 {
        expr(inout loader, inout ast, node.value);
        let pat_node = pat_at(in ast, node.pat);
        ty(inout loader, inout ast, node.ty, pat_node.start, pat_node.end);
        pattern(inout loader, inout ast, node.pat);
    } else if node.kind == 2 {
        expr(inout loader, inout ast, node.value);
    }
}

fn exprs(inout loader: St, inout ast: Ast, list: u32) {
    for i in 0..list_len(in ast, list) {
        let expr_id = list_at(in ast, list, i);
        expr(inout loader, inout ast, expr_id);
    }
}

// The second word of each pair of a list of pairs.
fn pair_exprs(inout loader: St, inout ast: Ast, list: u32) {
    let len = list_len(in ast, list);
    let mut i: u64 = 0;
    loop {
        if inc(i) >= wrapping_add(len, 1) {
            break;
        }
        let expr_id = list_at(in ast, list, inc(i));
        expr(inout loader, inout ast, expr_id);
        i = wrapping_add(i, 2);
    }
}

// A name expression `node` (file-local span): its renamed name, or, for an
// imported constant or a path to one, a call of its function, as the
// lowering makes a module's own (empty callee span); an untyped value enum
// member is its literal. Kept out of `expr`, whose frame every node pays.
fn name_expr(inout loader: St, inout ast: Ast, node: ExprNode) -> ExprNode {
    let mut result = node;
    let name = tr(inout loader, in ast, result.a);
    let written = (const_flags(inout loader, name) & 1) != 0;
    let new_name = value_name(inout loader, name, result.start, result.end);
    if new_name != name {
        result.a = back(inout loader, inout ast, new_name);
    }
    // An imported constant or a path to one is a call of its function,
    // as the lowering makes a module's own (empty callee span); an
    // untyped value enum member is its literal.
    if written || (const_flags(inout loader, new_name) & 2) == 0 {
        return result;
    }
    let literal = if loader.untyped.contains_key(new_name) {
        literal_of(in loader, inout ast, new_name)
    } else {
        ast_none()
    };
    if literal != ast_none() {
        result.kind = 1;
        result.a = literal;
        result.b = ast_none();
        result.c = ast_none();
    } else {
        let pos = sh(in loader, result.start);
        let callee = ast.exprs
            .alloc(ExprNode {
                kind: 2,
                start: pos,
                end: pos,
                a: result.a,
                b: ast_none(),
                c: ast_none(),
                d: ast_none(),
                e: ast_none()
            })
            .raw();
        result.kind = 6;
        result.a = callee;
        result.b = 0;
        result.c = 0;
    }
    result
}

fn expr(inout loader: St, inout ast: Ast, expr_id: u32) {
    if expr_id == ast_none() {
        return;
    }
    if w(expr_id) >= loader.parsed_expr_count {
        return;
    }
    let mut node = expr_at(in ast, expr_id);
    if revisit(inout loader.seen_expr, expr_id) {
        node.start = wrapping_sub(node.start, loader.shift);
        node.end = wrapping_sub(node.end, loader.shift);
    }
    let kind = node.kind;
    if kind == 2 {
        node = name_expr(inout loader, inout ast, node);
    } else if kind == 3 {
        exprs(inout loader, inout ast, node.a);
    } else if kind == 4 {
        let name = tr(inout loader, in ast, node.a);
        let new_name = type_name(inout loader, name, node.start, node.end);
        if new_name != name {
            node.a = back(inout loader, inout ast, new_name);
        }
        pair_exprs(inout loader, inout ast, node.b);
    } else if kind == 5 {
        let mark = loader.values.len();
        for i in 0..list_len(in ast, node.a) {
            let stmt_id = list_at(in ast, node.a, i);
            stmt(inout loader, inout ast, stmt_id);
        }
        expr(inout loader, inout ast, node.b);
        loader.values.truncate(mark);
    } else if kind == 6 {
        expr(inout loader, inout ast, node.a);
        for i in 0..list_len(in ast, node.b) {
            let ty_id = list_at(in ast, node.b, i);
            ty(inout loader, inout ast, ty_id, node.start, node.end);
        }
        for i in 0..list_len(in ast, node.c) {
            let arg_id = list_at(in ast, node.c, i);
            let arg = ast.args.get_or(
                idx_from_raw[ArgNode](arg_id),
                ArgNode { pass: 0, explicit: false, expr: ast_none() }
            );
            expr(inout loader, inout ast, arg.expr);
        }
    } else if kind == 7 || kind == 9 {
        expr(inout loader, inout ast, node.a);
    } else if kind == 10 {
        expr(inout loader, inout ast, node.b);
    } else if kind == 8 {
        expr(inout loader, inout ast, node.a);
        expr(inout loader, inout ast, node.b);
    } else if kind == 11 || kind == 12 {
        expr(inout loader, inout ast, node.b);
        expr(inout loader, inout ast, node.c);
    } else if kind == 13 {
        expr(inout loader, inout ast, node.a);
        expr(inout loader, inout ast, node.b);
        expr(inout loader, inout ast, node.c);
    } else if kind == 14 {
        expr(inout loader, inout ast, node.a);
        let arm_words = list_len(in ast, node.b);
        let mut i: u64 = 0;
        loop {
            if inc(i) >= wrapping_add(arm_words, 1) {
                break;
            }
            let mark = loader.values.len();
            let arm_pat = list_at(in ast, node.b, i);
            pattern(inout loader, inout ast, arm_pat);
            let arm_body = list_at(in ast, node.b, inc(i));
            expr(inout loader, inout ast, arm_body);
            loader.values.truncate(mark);
            i = wrapping_add(i, 2);
        }
    } else if kind == 15 {
        let mark = loader.values.len();
        for i in 0..list_len(in ast, node.a) {
            let param_id = list_at(in ast, node.a, i);
            param(inout loader, inout ast, param_id);
        }
        ty(inout loader, inout ast, node.c, node.start, node.end);
        effects(inout loader, inout ast, node.d, node.start, node.end);
        labels(inout loader, in ast, node.d);
        expr(inout loader, inout ast, node.e);
        loader.values.truncate(mark);
    } else if kind == 16 {
        one_effect(inout loader, inout ast, node.a, node.start, node.end);
        let mark = loader.values.len();
        let label = effect_at(in ast, node.a).label;
        if label != ast_none() {
            let label_name = tr(inout loader, in ast, label);
            loader.values.push(label_name);
        }
        if node.b != ast_none() {
            expr(inout loader, inout ast, node.c);
            let state_mark = loader.values.len();
            pattern(inout loader, inout ast, node.b);
            loader.values.truncate(state_mark);
        }
        expr(inout loader, inout ast, node.d);
        for i in 0..list_len(in ast, node.e) {
            let clause_id = list_at(in ast, node.e, i);
            clause(inout loader, inout ast, clause_id);
        }
        loader.values.truncate(mark);
    } else if kind == 17 {
        expr(inout loader, inout ast, node.a);
    } else if kind == 18 {
        expr(inout loader, inout ast, node.b);
        let mark = loader.values.len();
        pattern(inout loader, inout ast, node.a);
        expr(inout loader, inout ast, node.c);
        loader.values.truncate(mark);
    } else if kind == 19 {
        expr(inout loader, inout ast, node.a);
        expr(inout loader, inout ast, node.b);
    } else if kind == 20 || kind == 21 {
        expr(inout loader, inout ast, node.a);
    }
    node.start = sh(in loader, node.start);
    node.end = sh(in loader, node.end);
    ast.exprs.set(idx_from_raw[ExprNode](expr_id), node);
}

// ---------------------------------------------------------------- items

// `Renamer::function`; `name` is the new name (or `none()` to keep it).
fn function(inout loader: St, inout ast: Ast, fn_id: u32, outer: u32, name: u32) {
    let mut node = fn_at(in ast, fn_id);
    let type_mark = loader.types.len();
    let value_mark = loader.values.len();
    generics(inout loader, in ast, outer);
    generics(inout loader, in ast, node.generics);
    for i in 0..list_len(in ast, node.params) {
        let param_id = list_at(in ast, node.params, i);
        param(inout loader, inout ast, param_id);
    }
    ty(inout loader, inout ast, node.result, node.start, node.end);
    effects(inout loader, inout ast, node.effects, node.start, node.end);
    labels(inout loader, in ast, node.effects);
    expr(inout loader, inout ast, node.body);
    loader.types.truncate(type_mark);
    loader.values.truncate(value_mark);
    if name != none() {
        node.name = name;
    }
    node.start = sh(in loader, node.start);
    node.end = sh(in loader, node.end);
    ast.fns.set(idx_from_raw[FnNode](fn_id), node);
}

fn fns(inout loader: St, inout ast: Ast, list: u32, outer: u32) {
    for i in 0..list_len(in ast, list) {
        let fn_id = list_at(in ast, list, i);
        function(inout loader, inout ast, fn_id, outer, none());
    }
}

pub fn trait_ref(inout loader: St, inout ast: Ast, tref_id: u32) {
    if tref_id == ast_none() {
        return;
    }
    let mut node = ast.trait_refs.get_or(
        idx_from_raw[TraitRefNode](tref_id),
        TraitRefNode { package: ast_none(), name: ast_none(), args: 0, start: 0, end: 0 }
    );
    if revisit(inout loader.seen_tref, tref_id) {
        node.start = wrapping_sub(node.start, loader.shift);
        node.end = wrapping_sub(node.end, loader.shift);
    }
    for i in 0..list_len(in ast, node.args) {
        let arg_ty = list_at(in ast, node.args, i);
        ty(inout loader, inout ast, arg_ty, node.start, node.end);
    }
    node.start = sh(in loader, node.start);
    node.end = sh(in loader, node.end);
    ast.trait_refs.set(idx_from_raw[TraitRefNode](tref_id), node);
}

// The AST symbol of an item's new name: its bound name, else unchanged.
fn own_name(inout loader: St, inout ast: Ast, sym: u32) -> u32 {
    let global = tr(inout loader, in ast, sym);
    match loader.names.get(global) {
        Option::Some(binding) => {
            if lo(binding) == global {
                sym
            } else {
                back(inout loader, inout ast, lo(binding))
            }
        },
        Option::None => sym,
    }
}

pub fn item(inout loader: St, inout ast: Ast, kind: u8, node: u32) {
    if kind == 1 {
        let mut adt = adt_at(in ast, node);
        let old = adt.name;
        adt.name = own_name(inout loader, inout ast, old);
        let mark = loader.types.len();
        generics(inout loader, in ast, adt.generics);
        for i in 0..list_len(in ast, adt.variants) {
            let variant_id = list_at(in ast, adt.variants, i);
            let mut variant = ast.variants.get_or(
                idx_from_raw[VariantNode](variant_id),
                VariantNode { name: ast_none(), fields: 0, named: false }
            );
            if !adt.is_enum && variant.name == old && adt.name != old {
                variant.name = adt.name;
                ast.variants.set(idx_from_raw[VariantNode](variant_id), variant);
            }
            for j in 0..list_len(in ast, variant.fields) {
                let field_id = list_at(in ast, variant.fields, j);
                let field = ast.fields.get_or(
                    idx_from_raw[FieldNode](field_id),
                    FieldNode { name: ast_none(), ty: ast_none(), modality: 3, temperature: 0 }
                );
                ty(inout loader, inout ast, field.ty, adt.start, adt.end);
            }
        }
        loader.types.truncate(mark);
        adt.start = sh(in loader, adt.start);
        adt.end = sh(in loader, adt.end);
        ast.adts.set(idx_from_raw[AdtNode](node), adt);
    } else if kind == 2 {
        let func = fn_at(in ast, node);
        let name = own_name(inout loader, inout ast, func.name);
        function(inout loader, inout ast, node, 0, name);
    } else if kind == 3 {
        let mut decl = effect_decl_at(in ast, node);
        decl.name = own_name(inout loader, inout ast, decl.name);
        let mark = loader.types.len();
        generics(inout loader, in ast, decl.generics);
        fns(inout loader, inout ast, decl.ops, 0);
        loader.types.truncate(mark);
        decl.start = sh(in loader, decl.start);
        decl.end = sh(in loader, decl.end);
        ast.effect_decls.set(idx_from_raw[EffectDeclNode](node), decl);
    } else if kind == 4 {
        let impl_node = ast.impls.get_or(
            idx_from_raw[ImplNode](node),
            ImplNode { ty: ast_none(), generics: 0, methods: 0 }
        );
        let mark = loader.types.len();
        generics(inout loader, in ast, impl_node.generics);
        let mut start: u32 = 0;
        let mut end: u32 = 0;
        if list_len(in ast, impl_node.methods) > 0 {
            let method = fn_at(in ast, list_at(in ast, impl_node.methods, 0));
            start = method.start;
            end = method.end;
        }
        ty(inout loader, inout ast, impl_node.ty, start, end);
        fns(inout loader, inout ast, impl_node.methods, impl_node.generics);
        loader.types.truncate(mark);
    } else if kind == 5 {
        let mut trait_node = ast.traits.get_or(
            idx_from_raw[TraitNode](node),
            TraitNode {
                name: ast_none(),
                public: false,
                generics: 0,
                assoc: 0,
                methods: 0,
                start: 0,
                end: 0
            }
        );
        let mark = loader.types.len();
        loader.types.push(loader.self_ty_sym);
        generics(inout loader, in ast, trait_node.generics);
        for i in 0..list_len(in ast, trait_node.assoc) {
            let assoc = assoc_decl_at(in ast, list_at(in ast, trait_node.assoc, i));
            let assoc_name = tr(inout loader, in ast, assoc.name);
            loader.types.push(assoc_name);
        }
        fns(inout loader, inout ast, trait_node.methods, 0);
        for i in 0..list_len(in ast, trait_node.assoc) {
            let assoc_id = list_at(in ast, trait_node.assoc, i);
            let mut assoc = assoc_decl_at(in ast, assoc_id);
            assoc.start = sh(in loader, assoc.start);
            assoc.end = sh(in loader, assoc.end);
            ast.assoc_decls.set(idx_from_raw[AssocDeclNode](assoc_id), assoc);
        }
        loader.types.truncate(mark);
        trait_node.start = sh(in loader, trait_node.start);
        trait_node.end = sh(in loader, trait_node.end);
        ast.traits.set(idx_from_raw[TraitNode](node), trait_node);
    } else if kind == 6 {
        let mut conf = conf_at(in ast, node);
        let mark = loader.types.len();
        loader.types.push(loader.self_ty_sym);
        generics(inout loader, in ast, conf.generics);
        trait_ref(inout loader, inout ast, conf.trait_ref);
        ty(inout loader, inout ast, conf.self_ty, conf.start, conf.end);
        for i in 0..list_len(in ast, conf.wheres) {
            let where_id = list_at(in ast, conf.wheres, i);
            let mut where_node = ast.wheres.get_or(
                idx_from_raw[WhereNode](where_id),
                WhereNode { ty: ast_none(), trait_ref: ast_none(), start: 0, end: 0 }
            );
            ty(inout loader, inout ast, where_node.ty, conf.start, conf.end);
            trait_ref(inout loader, inout ast, where_node.trait_ref);
            where_node.start = sh(in loader, where_node.start);
            where_node.end = sh(in loader, where_node.end);
            ast.wheres.set(idx_from_raw[WhereNode](where_id), where_node);
        }
        for i in 0..list_len(in ast, conf.assoc) {
            let bind_id = list_at(in ast, conf.assoc, i);
            let mut bind = ast.assoc_binds.get_or(
                idx_from_raw[AssocBindNode](bind_id),
                AssocBindNode { name: ast_none(), ty: ast_none(), start: 0, end: 0 }
            );
            ty(inout loader, inout ast, bind.ty, conf.start, conf.end);
            bind.start = sh(in loader, bind.start);
            bind.end = sh(in loader, bind.end);
            ast.assoc_binds.set(idx_from_raw[AssocBindNode](bind_id), bind);
        }
        fns(inout loader, inout ast, conf.methods, 0);
        loader.types.truncate(mark);
        conf.start = sh(in loader, conf.start);
        conf.end = sh(in loader, conf.end);
        ast.confs.set(idx_from_raw[ConfNode](node), conf);
    }
}

pub fn assoc_decl_at(in ast: Ast, id: u32) -> AssocDeclNode {
    ast.assoc_decls.get_or(
        idx_from_raw[AssocDeclNode](id),
        AssocDeclNode { name: ast_none(), bound: 0, start: 0, end: 0 }
    )
}

pub fn conf_at(in ast: Ast, id: u32) -> ConfNode {
    ast.confs.get_or(
        idx_from_raw[ConfNode](id),
        ConfNode {
            model: ast_none(),
            public: false,
            generics: 0,
            trait_ref: ast_none(),
            self_ty: ast_none(),
            wheres: 0,
            assoc: 0,
            methods: 0,
            start: 0,
            end: 0
        }
    )
}

// `Renamer::owner`: the owner of a trait bound, `f`, `Type::method` or
// `Type`, through the module's bound names (any namespace).
pub fn owner(inout loader: St, bound_owner: u32) -> u32 {
    let len = sym_len(in loader, bound_owner);
    let cut = sym_path_split(in loader, bound_owner);
    let head = if cut >= len {
        bound_owner
    } else {
        sym_slice(inout loader, bound_owner, 0, cut)
    };
    let target = match loader.names.get(head) {
        Option::Some(binding) => lo(binding),
        Option::None => {
            return bound_owner;
        },
    };
    if cut >= len {
        return target;
    }
    let mut out = String::new();
    push_sym(in loader, target, inout out);
    out.push_str(in "::");
    let rest = sym_slice(inout loader, bound_owner, wrapping_add(cut, 2), len);
    push_sym(in loader, rest, inout out);
    loader.interner.intern(in out).id()
}
