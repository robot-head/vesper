// `Resolver` of src/packages.rs: module and item lookup over the whole
// package graph (`use` targets, qualified paths, re-exports) and the
// internal name of every item.
//
// A call that fails (`Err(Diagnostic)` in Rust) returns `none()` and
// leaves the diagnostic pending in `St.err_*`; the caller emits it with
// `emit` or drops it.

use @vesper-std/intern::{symbol_from_id};
use self::state::{
    St, at32, at64, const_of, const_prefix, join_path, kind_both, kind_sugar, kind_value, emit, err,
    find_module, hi, inc, lo, mod_path_into, mod_path_len, mod_seg, n32, none, pair, push_decimal,
    push_sym, sym_byte, sym_len, sym_less, sym_path_split, sym_slice, sym_starts, w
};

pub fn no_key() -> u64 {
    18446744073709551615
}

// Codes of the loader's diagnostics (src/packages.rs).
pub fn unknown_import() -> u32 {
    111
}

pub fn private_item() -> u32 {
    112
}

pub fn ambiguous() -> u32 {
    113
}

// ---------------------------------------------------------------- names

// Appends bytes `from..to` of `sym`, escaped (`escape_component`): `_`
// becomes `_1` and `-` becomes `_2`.
fn push_escaped(inout loader: St, sym: u32, from: u64, to: u64) {
    let (sym_start, sym_end) = loader.interner.span(symbol_from_id(sym));
    let mut run = wrapping_add(sym_start, from);
    let end = wrapping_add(sym_start, to);
    let mut i = run;
    loop {
        if i >= end || i >= sym_end {
            break;
        }
        let byte = match loader.interner.text_byte(i) {
            Option::Some(byte) => byte,
            Option::None => 0,
        };
        if byte == 95 || byte == 45 {
            loader.buf.push_str(in loader.interner.text[run..i]);
            if byte == 95 {
                loader.buf.push_str(in "_1");
            } else {
                loader.buf.push_str(in "_2");
            }
            run = inc(i);
        }
        i = inc(i);
    }
    let stop = if end < sym_end { end } else { sym_end };
    if run < stop {
        loader.buf.push_str(in loader.interner.text[run..stop]);
    }
}

// `mangled(name, path, item)`: the escaped components of the package's
// scope and name, the module path and the item, joined by `__`.
fn mangle(inout loader: St, module: u32, item: u32) -> u32 {
    let pkg_name = at32(in loader.pkg_name, w(at32(in loader.mod_pkg, w(module))));
    let len = sym_len(in loader, pkg_name);
    // `trim_start_matches('@')`.
    let mut start: u64 = 0;
    loop {
        if start >= len || sym_byte(in loader, pkg_name, start) != 64 {
            break;
        }
        start = inc(start);
    }
    let mut slash = len;
    let mut i = start;
    loop {
        if i >= len {
            break;
        }
        if sym_byte(in loader, pkg_name, i) == 47 {
            slash = i;
            break;
        }
        i = inc(i);
    }
    loader.buf.clear();
    if slash == len {
        // No scope: `("", name)`, the name untrimmed.
        loader.buf.push_str(in "__");
        push_escaped(inout loader, pkg_name, 0, len);
    } else {
        push_escaped(inout loader, pkg_name, start, slash);
        loader.buf.push_str(in "__");
        push_escaped(inout loader, pkg_name, inc(slash), len);
    }
    for k in 0..mod_path_len(in loader, module) {
        loader.buf.push_str(in "__");
        let seg = mod_seg(in loader, module, k);
        push_escaped(inout loader, seg, 0, sym_len(in loader, seg));
    }
    loader.buf.push_str(in "__");
    push_escaped(inout loader, item, 0, sym_len(in loader, item));
    loader.interner.intern(in loader.buf).id()
}

// Source items shadow foreign types of the same name.
pub fn is_foreign(in loader: St, key: u64) -> bool {
    loader.foreign_types.contains_key(key) && !loader.item_kind.contains_key(key)
}

// `Resolver::name_of`: its root re-export name, its plain name in the root
// package's root module, else the mangled name.
pub fn name_of(inout loader: St, key: u64) -> u32 {
    if is_foreign(in loader, key) {
        return lo(key);
    }
    match loader.renamed.get(key) {
        Option::Some(name) => {
            return name;
        },
        Option::None => {},
    }
    let module = hi(key);
    let item = lo(key);
    if module == loader.root_mod {
        return item;
    }
    match loader.mangled.get(key) {
        Option::Some(name) => {
            return name;
        },
        Option::None => {},
    }
    let mangled = mangle(inout loader, module, item);
    loader.mangled.insert(key, mangled);
    mangled
}

// `Resolver::shown`: `@scope/name::m::item`, appended to `out`.
pub fn push_shown(in loader: St, key: u64, inout out: String) {
    let module = hi(key);
    push_sym(in loader, at32(in loader.pkg_name, w(at32(in loader.mod_pkg, w(module)))), inout out);
    for k in 0..mod_path_len(in loader, module) {
        out.push_str(in "::");
        push_sym(in loader, mod_seg(in loader, module, k), inout out);
    }
    out.push_str(in "::");
    push_sym(in loader, lo(key), inout out);
}

pub fn shown(inout loader: St, key: u64) -> u32 {
    let mut text = String::new();
    push_shown(in loader, key, inout text);
    loader.interner.intern(in text).id()
}

// ---------------------------------------------------------------- paths

// `Resolver::root_of`: a path root, `self` (the package root), `super`
// repeated `supers` times (ancestors of `cur_module`) or the dependency
// `package` of `cur_module`'s package. Returns the package (or `none()`),
// writes the base module path to `base` and its display name to `shown`.
fn root_of(
    inout loader: St,
    cur_module: u32,
    package: u32,
    supers: u32,
    start: u32,
    end: u32,
    inout base: ChunkSeq[u32],
    inout shown: String
) -> u32 {
    let pkg = at32(in loader.mod_pkg, w(cur_module));
    base.clear();
    shown.clear();
    if package != none() {
        let first = w(at32(in loader.pkg_dep_first, w(pkg)));
        let count = w(at32(in loader.pkg_dep_len, w(pkg)));
        for i in 0..count {
            if at32(in loader.dep_name, wrapping_add(first, i)) == package {
                let dep = at32(in loader.dep_target, wrapping_add(first, i));
                push_sym(in loader, at32(in loader.pkg_name, w(dep)), inout shown);
                return dep;
            }
        }
        let mut optional = false;
        let opt_first = w(at32(in loader.pkg_opt_first, w(pkg)));
        let opt_count = w(at32(in loader.pkg_opt_len, w(pkg)));
        for i in 0..opt_count {
            if at32(in loader.opt_name, wrapping_add(opt_first, i)) == package {
                optional = true;
            }
        }
        err(inout loader, unknown_import(), start, end);
        let mut msg = String::new();
        push_sym(in loader, package, inout msg);
        if optional {
            msg.push_str(in " is an optional dependency of ");
            push_sym(in loader, at32(in loader.pkg_name, w(pkg)), inout msg);
            msg.push_str(in ", and package checking does not enable optional dependencies yet");
        } else {
            msg.push_str(in " is not a dependency of ");
            push_sym(in loader, at32(in loader.pkg_name, w(pkg)), inout msg);
            msg.push_str(in "; add it to [dependencies] in Loom.toml");
        }
        loader.err_msg.push_str(in msg);
        return none();
    }
    let depth = mod_path_len(in loader, cur_module);
    if supers == 0 {
        shown.push_str(in "self");
        return pkg;
    }
    if w(supers) > depth {
        err(inout loader, unknown_import(), start, end);
        let mut msg = String::new();
        msg.push_str(in "`super` goes above the package root: module ");
        msg.push_str(in "self");
        for k in 0..depth {
            msg.push_str(in "::");
            push_sym(in loader, mod_seg(in loader, cur_module, k), inout msg);
        }
        msg.push_str(in " has ");
        push_decimal(inout msg, depth);
        msg.push_str(in " ancestor module(s)");
        loader.err_msg.push_str(in msg);
        return none();
    }
    shown.push_str(in "self");
    let keep = wrapping_sub(depth, w(supers));
    for k in 0..keep {
        let seg = mod_seg(in loader, cur_module, k);
        base.push(seg);
        shown.push_str(in "::");
        push_sym(in loader, seg, inout shown);
    }
    pkg
}

// `Resolver::use_module`: the module use row `use_row` of `cur_module`
// names, or `none()`; writes its display name to `shown`.
pub fn use_module(inout loader: St, cur_module: u32, use_row: u32, inout shown: String) -> u32 {
    let start = at32(in loader.use_start, w(use_row));
    let end = at32(in loader.use_end, w(use_row));
    let mut path: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let pkg = root_of(
        inout loader,
        cur_module,
        at32(in loader.use_package, w(use_row)),
        at32(in loader.use_supers, w(use_row)),
        start,
        end,
        inout path,
        inout shown
    );
    if pkg == none() {
        return none();
    }
    let first = w(at32(in loader.use_path_first, w(use_row)));
    let count = w(at32(in loader.use_path_len, w(use_row)));
    for i in 0..count {
        let seg = at32(in loader.segments, wrapping_add(first, i));
        path.push(seg);
        shown.push_str(in "::");
        push_sym(in loader, seg, inout shown);
    }
    let module = find_module(in loader, pkg, in path);
    if module == none() {
        err(inout loader, unknown_import(), start, end);
        let mut msg = String::new();
        msg.push_str(in "no module ");
        msg.push_str(in shown);
        loader.err_msg.push_str(in msg);
    }
    module
}

// `Resolver::lookup`: item `name` of `target_module`, declared there (and
// `pub`, unless the lookup comes from that module) or one of its `pub use`
// names. Returns the item key (or `no_key()`) and its kind.
pub fn lookup(
    inout loader: St,
    target_module: u32,
    name: u32,
    same: bool,
    in shown: String,
    start: u32,
    end: u32
) -> (u64, u8) {
    // A constant `NAME` (or a value enum member `E::M`) is the function
    // `const$NAME`.
    let mut item = name;
    if !loader.item_kind.contains_key(pair(target_module, name)) {
        let const_name = const_of(inout loader, name);
        if loader.item_kind.contains_key(pair(target_module, const_name)) {
            item = const_name;
        }
    }
    let key = pair(target_module, item);
    match loader.item_kind.get(key) {
        Option::Some(kind) => {
            if !same && !loader.public.contains_key(key) {
                err(inout loader, private_item(), start, end);
                let mut msg = String::new();
                msg.push_str(in "'");
                push_sym(in loader, name, inout msg);
                msg.push_str(in "' is private to module ");
                msg.push_str(in shown);
                loader.err_msg.push_str(in msg);
                loader.err_help.push_str(in "mark the item `pub` to export it");
                loader.err_has_help = true;
                return (no_key(), 0);
            }
            return (key, kind);
        },
        Option::None => {},
    }
    let local_key = pair(target_module, name);
    match loader.reexport_key.get(local_key) {
        Option::Some(target) => {
            let kind = match loader.reexport_kind.get(local_key) {
                Option::Some(stored_kind) => stored_kind,
                Option::None => 0,
            };
            return (target, kind);
        },
        Option::None => {},
    }
    if loader.foreign_types.contains_key(local_key) {
        return (local_key, kind_both());
    }
    err(inout loader, unknown_import(), start, end);
    let mut msg = String::new();
    msg.push_str(in "module ");
    msg.push_str(in shown);
    msg.push_str(in " has no item '");
    push_sym(in loader, name, inout msg);
    msg.push_str(in "'");
    loader.err_msg.push_str(in msg);
    let first_byte = sym_byte(in loader, name, 0);
    if sym_len(in loader, name) > 0
        && first_byte >= 65
        && first_byte <= 90
        && mod_path_len(in loader, target_module) == 0 {
        loader.err_help.push_str(
            in "a `.vsys` library is not an item: every module names it directly, as `Lib::f(..)` and `eff [Ffi[Lib]]`, with no import"
        );
        loader.err_has_help = true;
    }
    (no_key(), 0)
}

// The local name of use-name row `name_row` (`UseName::local`).
pub fn local_of(in loader: St, name_row: u64) -> u32 {
    let alias = at32(in loader.import_alias, name_row);
    if alias != none() {
        alias
    } else {
        at32(in loader.import_name, name_row)
    }
}

// Inserts member `member` with item key `key` into `loader.result_members`
// and `loader.result_keys`, keeping them in the members' byte order.
fn grp_insert(inout loader: St, member: u32, key: u64) {
    loader.result_members.push(member);
    loader.result_keys.push(key);
    let mut j = wrapping_sub(loader.result_members.len(), 1);
    loop {
        if j == 0 {
            break;
        }
        let prev = at32(in loader.result_members, wrapping_sub(j, 1));
        if !sym_less(in loader, member, prev) {
            break;
        }
        let prev_key = at64(in loader.result_keys, wrapping_sub(j, 1));
        loader.result_members.try_set(j, prev);
        loader.result_keys.try_set(j, prev_key);
        loader.result_members.try_set(wrapping_sub(j, 1), member);
        loader.result_keys.try_set(wrapping_sub(j, 1), key);
        j = wrapping_sub(j, 1);
    }
}

// `Resolver::group`: the members of a value enum `name` of `target_module`,
// declared there (and `pub`, unless the lookup comes from that module) or
// re-exported by it, into `loader.result_members` (member names, in byte
// order) and `loader.result_keys` (their constants' item keys). Returns 0 when the module has no
// value enum of that name, 1 with the members, 2 with a pending error.
pub fn group(
    inout loader: St,
    target_module: u32,
    name: u32,
    same: bool,
    in shown: String,
    start: u32,
    end: u32
) -> u8 {
    loader.result_members.clear();
    loader.result_keys.clear();
    match loader.group_head.get(pair(target_module, name)) {
        Option::Some(first) => {
            let mut row = first;
            loop {
                if row == none() {
                    break;
                }
                let item = at32(in loader.group_const, w(row));
                if !same && !loader.public.contains_key(pair(target_module, item)) {
                    err(inout loader, private_item(), start, end);
                    let mut msg = String::new();
                    msg.push_str(in "value enum '");
                    push_sym(in loader, name, inout msg);
                    msg.push_str(in "' is private to module ");
                    msg.push_str(in shown);
                    loader.err_msg.push_str(in msg);
                    loader.err_help.push_str(in "mark the enum `pub` to export it");
                    loader.err_has_help = true;
                    loader.result_members.clear();
                    loader.result_keys.clear();
                    return 2;
                }
                let member = at32(in loader.group_member, w(row));
                grp_insert(inout loader, member, pair(target_module, item));
                row = at32(in loader.group_next, w(row));
            }
            return 1;
        },
        Option::None => {},
    }
    // Re-exported members `name::M` (listed by their head `name`).
    let mut row = match loader.path_reexport_head.get(pair(target_module, name)) {
        Option::Some(head_row) => head_row,
        Option::None => none(),
    };
    if row == none() {
        return 0;
    }
    let prefix_len = wrapping_add(sym_len(in loader, name), 2);
    loop {
        if row == none() {
            break;
        }
        let local = at32(in loader.path_reexport_name, w(row));
        let member = sym_slice(inout loader, local, prefix_len, sym_len(in loader, local));
        let key = at64_key(in loader, pair(target_module, local));
        grp_insert(inout loader, member, key);
        row = at32(in loader.path_reexport_next, w(row));
    }
    if loader.result_members.len() == 0 {
        0
    } else {
        1
    }
}

// Records the re-export of `local` by `module`.
fn reexp_add(inout loader: St, module: u32, local: u32, target: u64, kind: u8) {
    let key = pair(module, local);
    loader.reexport_key.insert(key, target);
    loader.reexport_kind.insert(key, kind);
    // A path local `E::M` is listed under its head `E` for `group`.
    let cut = sym_path_split(in loader, local);
    if cut < sym_len(in loader, local) {
        let head = sym_slice(inout loader, local, 0, cut);
        let head_key = pair(module, head);
        let next = match loader.path_reexport_head.get(head_key) {
            Option::Some(head_row) => head_row,
            Option::None => none(),
        };
        loader.path_reexport_head.insert(head_key, n32(loader.path_reexport_name.len()));
        loader.path_reexport_name.push(local);
        loader.path_reexport_next.push(next);
    }
    if module == loader.root_mod {
        loader.root_reexports.push(local);
    }
}

// `Resolver::reexports`: every module's `pub use` names, resolved to the
// items they re-export, following chains to a fixed point. Names that do
// not resolve are reported when the module's imports are bound.
pub fn reexports(inout loader: St) {
    let mut shown = String::new();
    loop {
        let mut changed = false;
        for module in 0..loader.mod_pkg.len() {
            let use_first = w(at32(in loader.mod_use_first, module));
            let use_count = w(at32(in loader.mod_use_len, module));
            for use_index in 0..use_count {
                let use_row = wrapping_add(use_first, use_index);
                let public = match loader.use_public.try_get(use_row) {
                    Option::Some(byte) => byte != 0,
                    Option::None => false,
                };
                if public {
                    let target_module = use_module(
                        inout loader,
                        n32(module),
                        n32(use_row),
                        inout shown
                    );
                    loader.err_code = 0;
                    if target_module != none() {
                        let same = target_module == n32(module);
                        let names_first = w(at32(in loader.use_names_first, use_row));
                        let name_count = w(at32(in loader.use_names_len, use_row));
                        for k in 0..name_count {
                            let name_row = wrapping_add(names_first, k);
                            let local = local_of(in loader, name_row);
                            let key = pair(n32(module), local);
                            if !loader.reexport_key.contains_key(key) {
                                let group_status = group(
                                    inout loader,
                                    target_module,
                                    at32(in loader.import_name, name_row),
                                    same,
                                    in shown,
                                    at32(in loader.import_start, name_row),
                                    at32(in loader.import_end, name_row)
                                );
                                loader.err_code = 0;
                                if group_status == 1 {
                                    // A value enum re-exports each member
                                    // `E::M`.
                                    for i in 0..loader.result_members.len() {
                                        let member = at32(in loader.result_members, i);
                                        let target = at64(in loader.result_keys, i);
                                        let local_member = join_path(inout loader, local, member);
                                        if !loader
                                            .reexport_key
                                            .contains_key(pair(n32(module), local_member)) {
                                            reexp_add(
                                                inout loader,
                                                n32(module),
                                                local_member,
                                                target,
                                                kind_value()
                                            );
                                            changed = true;
                                        }
                                    }
                                } else {
                                    let (found, kind) = lookup(
                                        inout loader,
                                        target_module,
                                        at32(in loader.import_name, name_row),
                                        same,
                                        in shown,
                                        at32(in loader.import_start, name_row),
                                        at32(in loader.import_end, name_row)
                                    );
                                    loader.err_code = 0;
                                    if found != no_key() {
                                        reexp_add(inout loader, n32(module), local, found, kind);
                                        changed = true;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if !changed {
            break;
        }
    }
}

// `Resolver::overrides`: the items the root package's root module
// re-exports take their root names (`pub use self::m::f as g;` exports
// `m::f` as `g`). Visits the re-exported names in byte order, as Rust's
// `BTreeMap` does.
pub fn overrides(inout loader: St) {
    let root = loader.root_mod;
    if root == none() {
        return;
    }
    // Insertion sort by text: a root module re-exports few names.
    let mut order: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..loader.root_reexports.len() {
        let name = at32(in loader.root_reexports, i);
        order.push(name);
        let mut j = i;
        loop {
            if j == 0 {
                break;
            }
            let left = at32(in order, wrapping_sub(j, 1));
            let right = at32(in order, j);
            if !sym_less(in loader, right, left) {
                break;
            }
            order.try_set(wrapping_sub(j, 1), right);
            order.try_set(j, left);
            j = wrapping_sub(j, 1);
        }
    }
    let file = at32(in loader.mod_file, w(root));
    for i in 0..order.len() {
        let written = at32(in order, i);
        // A re-exported sugar renames nothing.
        let sugar = match loader.reexport_kind.get(pair(root, written)) {
            Option::Some(k) => k == kind_sugar(),
            Option::None => false,
        };
        if sugar {
            continue;
        }
        let item = at64_key(in loader, pair(root, written));
        // A constant keeps its function prefix under its new name.
        let local = if sym_starts(in loader, lo(item), in const_prefix()) {
            const_of(inout loader, written)
        } else {
            written
        };
        if hi(item) == root && lo(item) == local {
            continue;
        }
        match loader.renamed.get(item) {
            Option::Some(first) => {
                // The span of the first use name of the root module whose
                // local name is `local`.
                let mut start: u32 = 0;
                let mut end: u32 = 0;
                let use_first = w(at32(in loader.mod_use_first, w(root)));
                let use_count = w(at32(in loader.mod_use_len, w(root)));
                let mut found = false;
                for use_index in 0..use_count {
                    let use_row = wrapping_add(use_first, use_index);
                    let names_first = w(at32(in loader.use_names_first, use_row));
                    let name_count = w(at32(in loader.use_names_len, use_row));
                    for k in 0..name_count {
                        let name_row = wrapping_add(names_first, k);
                        if !found && local_of(in loader, name_row) == local {
                            found = true;
                            start = at32(in loader.import_start, name_row);
                            end = at32(in loader.import_end, name_row);
                        }
                    }
                }
                err(inout loader, ambiguous(), start, end);
                let mut msg = String::new();
                push_shown(in loader, item, inout msg);
                msg.push_str(in " is re-exported by the root module as both '");
                push_sym(in loader, first, inout msg);
                msg.push_str(in "' and '");
                push_sym(in loader, local, inout msg);
                msg.push_str(in "'");
                loader.err_msg.push_str(in msg);
                loader.err_help.push_str(in "an item has one exported name; keep one `pub use`");
                loader.err_has_help = true;
                emit(inout loader, file);
            },
            Option::None => {
                loader.renamed.insert(item, local);
            },
        }
    }
}

fn at64_key(in loader: St, key: u64) -> u64 {
    match loader.reexport_key.get(key) {
        Option::Some(target) => target,
        Option::None => no_key(),
    }
}

// `Resolver::qualified`: a qualified path `self::m::f`, `super::m::T::new`
// or `@scope/name::m::E::V`, from `cur_module`: its root, the longest
// module path that leaves an item, the item, then any `::rest`, as the
// item's internal name followed by `::rest`. Returns `none()` on error.
pub fn qualified(inout loader: St, cur_module: u32, path: u32, start: u32, end: u32) -> u32 {
    // `path.split("::")`.
    let mut segs: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let len = sym_len(in loader, path);
    let mut seg_start: u64 = 0;
    loop {
        let mut i = seg_start;
        let mut cut = len;
        loop {
            if inc(i) >= len {
                break;
            }
            if sym_byte(in loader, path, i) == 58 && sym_byte(in loader, path, inc(i)) == 58 {
                cut = i;
                break;
            }
            i = inc(i);
        }
        let seg = sym_slice(inout loader, path, seg_start, cut);
        segs.push(seg);
        if cut >= len {
            break;
        }
        seg_start = wrapping_add(cut, 2);
    }
    let head = at32(in segs, 0);
    let mut package = none();
    let mut supers: u32 = 0;
    let mut first: u64 = 1;
    if sym_byte(in loader, head, 0) == 64 && sym_len(in loader, head) > 0 {
        package = head;
    } else if head == loader.super_sym {
        let mut super_count: u64 = 0;
        loop {
            if super_count >= segs.len() || at32(in segs, super_count) != loader.super_sym {
                break;
            }
            super_count = inc(super_count);
        }
        supers = n32(super_count);
        first = super_count;
    }
    let mut base: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut shown = String::new();
    let pkg = root_of(
        inout loader,
        cur_module,
        package,
        supers,
        start,
        end,
        inout base,
        inout shown
    );
    if pkg == none() {
        return none();
    }
    let rest = wrapping_sub(segs.len(), first);
    if first >= segs.len() {
        err(inout loader, unknown_import(), start, end);
        let mut msg = String::new();
        msg.push_str(in "the path `");
        push_sym(in loader, path, inout msg);
        msg.push_str(in "` names a module, not an item");
        loader.err_msg.push_str(in msg);
        return none();
    }
    // The longest prefix of `rest` that is a module, leaving an item.
    let mut module_len = rest;
    let mut module = none();
    let mut probe: ChunkSeq[u32] = ChunkSeq::new[u32]();
    loop {
        if module_len == 0 {
            break;
        }
        module_len = wrapping_sub(module_len, 1);
        probe.clear();
        probe.extend(in base.as_slice());
        for k in 0..module_len {
            probe.push(at32(in segs, wrapping_add(first, k)));
        }
        let found = find_module(in loader, pkg, in probe);
        if found != none() {
            module = found;
            break;
        }
    }
    if module == none() {
        err(inout loader, unknown_import(), start, end);
        let mut msg = String::new();
        msg.push_str(in "no module ");
        msg.push_str(in shown);
        loader.err_msg.push_str(in msg);
        return none();
    }
    for k in 0..module_len {
        shown.push_str(in "::");
        push_sym(in loader, at32(in segs, wrapping_add(first, k)), inout shown);
    }
    let same = module == cur_module;
    let item = at32(in segs, wrapping_add(first, module_len));
    // `m::E::M` names the member `M` of the value enum `E` of `m`.
    if wrapping_add(module_len, 2) == rest {
        let group_status = group(inout loader, module, item, same, in shown, start, end);
        loader.err_code = 0;
        if group_status == 1 {
            let member = at32(in segs, wrapping_add(first, inc(module_len)));
            for i in 0..loader.result_members.len() {
                if at32(in loader.result_members, i) == member {
                    let key = at64(in loader.result_keys, i);
                    return name_of(inout loader, key);
                }
            }
        }
    }
    let (key, kind) = lookup(inout loader, module, item, same, in shown, start, end);
    if key == no_key() {
        let first_byte = sym_byte(in loader, item, 0);
        if loader.err_code == unknown_import()
            && inc(module_len) < rest
            && sym_len(in loader, item) > 0
            && first_byte >= 97
            && first_byte <= 122 {
            err(inout loader, unknown_import(), start, end);
            let mut msg = String::new();
            msg.push_str(in "no module ");
            msg.push_str(in shown);
            msg.push_str(in "::");
            push_sym(in loader, item, inout msg);
            loader.err_msg.push_str(in msg);
        }
        return none();
    }
    let target = name_of(inout loader, key);
    if inc(module_len) >= rest {
        return target;
    }
    let mut out = String::new();
    push_sym(in loader, target, inout out);
    for k in inc(module_len)..rest {
        out.push_str(in "::");
        push_sym(in loader, at32(in segs, wrapping_add(first, k)), inout out);
    }
    loader.interner.intern(in out).id()
}
