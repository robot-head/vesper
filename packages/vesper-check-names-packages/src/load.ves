// The input decoder and the per-module tables (`Resolver::new`).
//
// The Rust side (tests/self_host_check_names_packages.rs) does the
// loader's I/O and manifest checks (`Loader::package`) and passes the
// package graph, in little-endian words (`str` is a byte length, then the
// bytes padded to a multiple of eight):
//
//   packages   count; per package its name (str), its dependencies (count,
//              then per dependency its name (str) and package index) and
//              its optional dependencies' names (count, then str each)
//   files      count; per file its display path (str) and base offset
//   modules    count; per module its package, its path (count, then str
//              each segment), its file and its source text (str)
//   foreign types (optional suffix) count; per type the package and name (str)
//   sugars     (optional suffix, after the foreign types) count; per `sugar`
//              declaration its module, its name (str) and 1 when it is
//              `pub`, else 0. The Rust loader expands sugar before assembly
//              (`Loader::expand_sugars`), so module texts hold no sugar;
//              these are the names `Resolver::new` adds to the tables.
//
// Package 0 is the root package.

use @vesper/ast::{
    Ast, lit_at, AdtNode, EffectDeclNode, FnNode, ItemNode, UseNameNode, UseNode, VariantNode,
    list_at, list_len, none as ast_none
};
use @vesper/check-data::util::{stage2_heap_mark, stage2_heap_reset, stage2_heap_swap};
use @vesper/ast::lower::{L, lower_source, lower_source_perm};
use @vesper-std/arena::{idx_from_raw};
use @vesper-std/intern::{symbol_from_id};
use self::state::{
    St, at32, at8, const_of, const_prefix, sym_byte, sym_len, sym_slice, sym_starts, find_module,
    inc, kind_both, kind_sugar, kind_type, kind_value, mod_hash, n32, none, pair, w
};

fn rd(in bytes: Slice[u8], inout pos: u64) -> u64 {
    let word = match bytes.try_read_u64_le(pos) {
        Option::Some(word) => word,
        Option::None => 0,
    };
    pos = wrapping_add(pos, 8);
    word
}

// A string's byte range; `pos` moves past its padding.
fn rd_str(in bytes: Slice[u8], inout pos: u64) -> (u64, u64) {
    let len = rd(in bytes, inout pos);
    let start = pos;
    pos = wrapping_add(pos, wrapping_add(len, 7) & 18446744073709551608);
    (start, wrapping_add(start, len))
}

fn rd_sym_bytes(inout loader: St, in input: Slice[u8], inout pos: u64) -> u32 {
    let (start, end) = rd_str(in input, inout pos);
    match String::from_utf8(in input[start..end]) {
        Option::Some(text) => loader.interner.intern(in text.as_str()).id(),
        Option::None => loader.interner.intern(in "").id(),
    }
}

pub fn decode(inout loader: St, in input: Str) {
    decode_bytes(inout loader, in input.as_bytes());
}

pub fn decode_bytes(inout loader: St, in input: Slice[u8]) {
    let mut pos: u64 = 0;
    let pkg_count = rd(in input, inout pos);
    for pkg_index in 0..pkg_count {
        let name = rd_sym_bytes(inout loader, in input, inout pos);
        loader.pkg_name.push(name);
        let dep_count = rd(in input, inout pos);
        loader.pkg_dep_first.push(n32(loader.dep_name.len()));
        loader.pkg_dep_len.push(n32(dep_count));
        for i in 0..dep_count {
            let dep_name = rd_sym_bytes(inout loader, in input, inout pos);
            loader.dep_name.push(dep_name);
            loader.dep_target.push(n32(rd(in input, inout pos)));
        }
        let opt_count = rd(in input, inout pos);
        loader.pkg_opt_first.push(n32(loader.opt_name.len()));
        loader.pkg_opt_len.push(n32(opt_count));
        for i in 0..opt_count {
            let opt_name = rd_sym_bytes(inout loader, in input, inout pos);
            loader.opt_name.push(opt_name);
        }
    }
    let file_count = rd(in input, inout pos);
    for file_index in 0..file_count {
        let display = rd_sym_bytes(inout loader, in input, inout pos);
        loader.file_display.push(display);
        loader.file_base.push(rd(in input, inout pos));
    }
    let mod_count = rd(in input, inout pos);
    let mut path: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for module in 0..mod_count {
        let pkg = n32(rd(in input, inout pos));
        loader.mod_pkg.push(pkg);
        let seg_count = rd(in input, inout pos);
        loader.mod_seg_first.push(n32(loader.segments.len()));
        loader.mod_seg_len.push(n32(seg_count));
        path.clear();
        for i in 0..seg_count {
            let seg = rd_sym_bytes(inout loader, in input, inout pos);
            loader.segments.push(seg);
            path.push(seg);
        }
        loader.mod_file.push(n32(rd(in input, inout pos)));
        let (text_start, text_end) = rd_str(in input, inout pos);
        loader.mod_text_start.push(text_start);
        loader.mod_text_end.push(text_end);
        let hash = mod_hash(pkg, in path);
        match loader.mod_index.insert(hash, n32(module)) {
            Option::Some(other) => {
                loader.mod_collide = true;
                // Keep the first module at this hash.
                loader.mod_index.insert(hash, other);
            },
            Option::None => {},
        }
        if pkg == 0 && seg_count == 0 {
            loader.root_mod = n32(module);
        }
    }
    // An absent suffix is a graph with no foreign types.
    let foreign_count = rd(in input, inout pos);
    path.clear();
    for _i in 0..foreign_count {
        let pkg = n32(rd(in input, inout pos));
        let name = rd_sym_bytes(inout loader, in input, inout pos);
        let root = find_module(in loader, pkg, in path);
        if root != none() {
            loader.foreign_types.insert(pair(root, name), 1);
        }
    }
    // An absent suffix is a graph that declares no sugar.
    let sugar_count = rd(in input, inout pos);
    for _i in 0..sugar_count {
        loader.sugar_mod.push(n32(rd(in input, inout pos)));
        let name = rd_sym_bytes(inout loader, in input, inout pos);
        loader.sugar_name.push(name);
        // 1 when the declaration is `pub`.
        loader.sugar_public.push(wrapping_u8(rd(in input, inout pos)));
    }
}

// ---------------------------------------------------------------- AST symbols

// The global symbol of AST symbol `sym` of the module being read.
pub fn tr(inout loader: St, in ast: Ast, sym: u32) -> u32 {
    if sym == ast_none() {
        return none();
    }
    let index = w(sym);
    let cached = at32(in loader.ast_to_global, index);
    if cached != none() && cached != 0 {
        return wrapping_sub(cached, 1);
    }
    loader.buf.clear();
    ast.names.resolve_into(symbol_from_id(sym), inout loader.buf);
    let global = loader.interner.intern(in loader.buf).id();
    if index >= loader.ast_to_global.len() {
        loader.ast_to_global.resize(inc(index), 0);
    }
    loader.ast_to_global.try_set(index, wrapping_add(global, 1));
    global
}

// The AST symbol of global symbol `global` (interned into the module's AST).
pub fn back(inout loader: St, inout ast: Ast, global: u32) -> u32 {
    match loader.global_to_ast.get(global) {
        Option::Some(ast_sym) => {
            return ast_sym;
        },
        Option::None => {},
    }
    loader.buf.clear();
    loader.interner.resolve_into(symbol_from_id(global), inout loader.buf);
    let ast_sym = ast.names.intern(in loader.buf).id();
    loader.global_to_ast.insert(global, ast_sym);
    let index = w(ast_sym);
    if index >= loader.ast_to_global.len() {
        loader.ast_to_global.resize(inc(index), 0);
    }
    loader.ast_to_global.try_set(index, wrapping_add(global, 1));
    ast_sym
}

// Starts reading a module's AST: the symbol maps are per AST.
pub fn begin_module(inout loader: St) {
    loader.ast_to_global.clear();
    loader.global_to_ast.clear();
    loader.seen_expr.clear();
    loader.seen_pat.clear();
    loader.seen_param.clear();
    loader.seen_tref.clear();
}

pub fn item_at(in ast: Ast, id: u32) -> ItemNode {
    ast.items.get_or(idx_from_raw[ItemNode](id), ItemNode { kind: 0, node: 0 })
}

pub fn adt_at(in ast: Ast, id: u32) -> AdtNode {
    ast.adts.get_or(
        idx_from_raw[AdtNode](id),
        AdtNode {
            name: ast_none(),
            mode: 0,
            generics: 0,
            variants: 0,
            is_enum: false,
            tiled: false,
            tile_width: 0,
            start: 0,
            end: 0
        }
    )
}

pub fn fn_at(in ast: Ast, id: u32) -> FnNode {
    ast.fns.get_or(
        idx_from_raw[FnNode](id),
        FnNode {
            name: ast_none(),
            fip: false,
            generics: 0,
            params: 0,
            result: ast_none(),
            effects: ast_none(),
            body: ast_none(),
            start: 0,
            end: 0
        }
    )
}

pub fn effect_decl_at(in ast: Ast, id: u32) -> EffectDeclNode {
    ast.effect_decls.get_or(
        idx_from_raw[EffectDeclNode](id),
        EffectDeclNode { name: ast_none(), linear: false, generics: 0, ops: 0, start: 0, end: 0 }
    )
}

fn use_at(in ast: Ast, id: u32) -> UseNode {
    ast.uses.get_or(
        idx_from_raw[UseNode](id),
        UseNode {
            package: ast_none(),
            supers: 0,
            path: 0,
            names: 0,
            public: false,
            start: 0,
            end: 0
        }
    )
}

fn use_name_at(in ast: Ast, id: u32) -> UseNameNode {
    ast.use_names.get_or(
        idx_from_raw[UseNameNode](id),
        UseNameNode { name: ast_none(), alias: ast_none(), start: 0, end: 0 }
    )
}

pub fn variant_name(in ast: Ast, variant_id: u32) -> u32 {
    match ast.variants.get(idx_from_raw[VariantNode](variant_id)) {
        Option::Some(variant) => variant.name,
        Option::None => ast_none(),
    }
}

// `Kind::of`: an item's name and kind, or (none, 0).
pub fn item_name(in ast: Ast, item: ItemNode) -> (u32, u8) {
    if item.kind == 1 {
        (adt_at(in ast, item.node).name, kind_both())
    } else if item.kind == 2 {
        (fn_at(in ast, item.node).name, kind_value())
    } else if item.kind == 3 {
        (effect_decl_at(in ast, item.node).name, kind_type())
    } else {
        (ast_none(), 0)
    }
}

// `Resolver::new` for `module`: its item kinds and `pub` names, its
// imports and its enums.
pub fn collect(inout loader: St, in ast: Ast, module: u32) {
    loader.mod_items_first.push(n32(loader.item_list.len()));
    let first = loader.item_list.len();
    for i in 0..ast.m_items.len() {
        let item_row = item_at(in ast, at32(in ast.m_items, i));
        let (name, kind) = item_name(in ast, item_row);
        if kind != 0 {
            let global_name = tr(inout loader, in ast, name);
            match loader.item_kind.insert(pair(module, global_name), kind) {
                Option::Some(_) => {},
                Option::None => index_constant(inout loader, module, global_name),
            }
            loader.item_list.push(global_name);
        }
        if item_row.kind == 1 {
            let adt = adt_at(in ast, item_row.node);
            if adt.is_enum {
                let enum_name = tr(inout loader, in ast, adt.name);
                loader.enum_mod.push(module);
                loader.enum_name.push(enum_name);
                loader.enum_variant_first.push(n32(loader.enum_variants.len()));
                let variant_count = list_len(in ast, adt.variants);
                loader.enum_variant_len.push(n32(variant_count));
                for k in 0..variant_count {
                    let variant = tr(
                        inout loader,
                        in ast,
                        variant_name(in ast, list_at(in ast, adt.variants, k))
                    );
                    loader.enum_variants.push(variant);
                }
            }
        }
    }
    // The module's sugar names follow its items, so a sugar's kind wins
    // over an item of the same name, as in the Rust table.
    for i in 0..loader.sugar_mod.len() {
        if at32(in loader.sugar_mod, i) == module {
            let global_name = at32(in loader.sugar_name, i);
            match loader.item_kind.insert(pair(module, global_name), kind_sugar()) {
                Option::Some(_) => {},
                Option::None => index_constant(inout loader, module, global_name),
            }
            loader.item_list.push(global_name);
            if at8(in loader.sugar_public, i) != 0 {
                loader.public.insert(pair(module, global_name), 1);
            }
        }
    }
    loader.mod_items_len.push(n32(wrapping_sub(loader.item_list.len(), first)));
    for i in 0..ast.m_public.len() {
        let global_name = tr(inout loader, in ast, at32(in ast.m_public, i));
        loader.public.insert(pair(module, global_name), 1);
    }
    loader.mod_use_first.push(n32(loader.use_package.len()));
    loader.mod_use_len.push(n32(ast.m_uses.len()));
    for i in 0..ast.m_uses.len() {
        let use_node = use_at(in ast, at32(in ast.m_uses, i));
        let package = tr(inout loader, in ast, use_node.package);
        loader.use_package.push(package);
        loader.use_supers.push(use_node.supers);
        loader.use_path_first.push(n32(loader.segments.len()));
        let path_len = list_len(in ast, use_node.path);
        loader.use_path_len.push(n32(path_len));
        for k in 0..path_len {
            let seg = tr(inout loader, in ast, list_at(in ast, use_node.path, k));
            loader.segments.push(seg);
        }
        loader.use_names_first.push(n32(loader.import_name.len()));
        let name_count = list_len(in ast, use_node.names);
        loader.use_names_len.push(n32(name_count));
        for k in 0..name_count {
            let use_name = use_name_at(in ast, list_at(in ast, use_node.names, k));
            let import_name = tr(inout loader, in ast, use_name.name);
            let import_alias = tr(inout loader, in ast, use_name.alias);
            loader.import_name.push(import_name);
            loader.import_alias.push(import_alias);
            loader.import_start.push(use_name.start);
            loader.import_end.push(use_name.end);
        }
        loader.use_public.push(if use_node.public { 1 } else { 0 });
        loader.use_start.push(use_node.start);
        loader.use_end.push(use_node.end);
    }
}

// A constant `const$P::M` of `module`: (module, every prefix P) for the
// "declared and imported" check, and `M` as a member of the value enum
// `P` (`Table::group`).
fn index_constant(inout loader: St, module: u32, name: u32) {
    if !sym_starts(in loader, name, in const_prefix()) {
        return;
    }
    let body_start = const_prefix().len();
    let len = sym_len(in loader, name);
    let mut last = len;
    let mut i = body_start;
    loop {
        if inc(i) >= len {
            break;
        }
        if sym_byte(in loader, name, i) == 58 && sym_byte(in loader, name, inc(i)) == 58 {
            let prefix = sym_slice(inout loader, name, body_start, i);
            loader.own_prefix.insert(pair(module, prefix), 1);
            last = i;
            i = wrapping_add(i, 2);
        } else {
            i = inc(i);
        }
    }
    if last == len {
        return;
    }
    let group = sym_slice(inout loader, name, body_start, last);
    let member = sym_slice(inout loader, name, wrapping_add(last, 2), len);
    let key = pair(module, group);
    let next = match loader.group_head.get(key) {
        Option::Some(prev_head) => prev_head,
        Option::None => none(),
    };
    loader.group_head.insert(key, n32(loader.group_member.len()));
    loader.group_member.push(member);
    loader.group_const.push(name);
    loader.group_next.push(next);
}

// The constants of `module` with a literal value (`const_literal`).
fn constants(inout loader: St, in lowered: L, module: u32) {
    for i in 0..lowered.consts.len() {
        let lit_id = at32(in lowered.const_lits, i);
        if lit_id != ast_none() {
            let global = tr(inout loader, in lowered.ast, at32(in lowered.consts, i));
            let func = const_of(inout loader, global);
            let lit = lit_at(in lowered.ast, lit_id);
            loader.lit_module.push(module);
            loader.lit_func.push(func);
            loader.lit_kind.push(lit.kind);
            loader.lit_neg.push(if lit.neg { 1 } else { 0 });
            loader.lit_bits.push(lit.bits);
            loader.lit_hi.push(lit.hi);
            loader.lit_untyped.push(at8(in lowered.const_untyped, i));
        }
    }
}

// Parses every module and collects its tables.
pub fn collect_all(inout loader: St, in input: Str) {
    collect_all_bytes(inout loader, in input.as_bytes());
}

pub fn collect_all_bytes(inout loader: St, in input: Slice[u8]) {
    let has_perm = stage2_heap_mark() != 0;
    let mut ast_perm_buf = ChunkSeq::new[u8]();
    let ast_perm_end = if has_perm {
        ast_perm_buf.reserve(268435456);
        stage2_heap_mark()
    } else {
        0
    };
    let mut ast_perm = if has_perm {
        wrapping_sub(ast_perm_end, 268435456)
    } else {
        0
    };
    for module in 0..loader.mod_pkg.len() {
        let maybe_start = loader.mod_text_start.try_get(module);
        let maybe_end = loader.mod_text_end.try_get(module);
        let (start, end) = match maybe_start {
            Option::Some(found_start) => match maybe_end {
                Option::Some(found_end) => (found_start, found_end),
                Option::None => (0, 0),
            },
            Option::None => (0, 0),
        };
        let lowered = match String::from_utf8(in input[start..end]) {
            Option::Some(src) => lower_source_perm(in src.as_str(), inout ast_perm, ast_perm_end),
            Option::None => lower_source_perm(in "", inout ast_perm, ast_perm_end),
        };
        loader.parse_errors = wrapping_add(loader.parse_errors, lowered.p.d.code.len());
        begin_module(inout loader);
        collect(inout loader, in lowered.ast, n32(module));
        constants(inout loader, in lowered, n32(module));
        loader.cached_lowerings.push(sink lowered);
    }
    let mut reversed = ChunkSeq::new[L]();
    loop {
        match loader.cached_lowerings.pop() {
            Option::Some(cached) => reversed.push(sink cached),
            Option::None => {
                break;
            },
        }
    }
    loader.cached_lowerings = reversed;
}
