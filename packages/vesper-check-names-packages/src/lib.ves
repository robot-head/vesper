// @vesper/check-names-packages: the package assembler of src/packages.rs
// (`Loader::assemble`, `Resolver`, `Renamer`) in Vesper (self-hosting wave
// SH2 lane 6, #1178). Rust stays the default; nothing here replaces Rust
// code.
//
// Given the package graph the Rust loader read (load.ves describes the
// input), it parses every module with @vesper/ast, builds each module's
// table of names, resolves `use` imports and `pub use` re-exports across
// packages, renames every item and reference to its internal name
// (`demo__geometry__shapes__area`), shifts every span to its file's offset
// in the virtual concatenation, and reports E0111-E0113 as Rust does.
//
// The design is the census's: names are interned symbols, tables are flat
// rows and `FlatTable`s keyed by packed pairs of `u32`, never `String`
// maps. Assembly parses each module once to build the tables and once to
// rename it. The cursor hands each renamed AST to its caller in load order.

use @vesper/ast::{
    Ast, BoundNode, GenericNode, ImplNode, ItemNode, ModelUseNode, TraitNode, VariantNode, list_at,
    list_len, none as ast_none, type_name as ast_type_name
};
use @vesper/ast::lower::{lower_source};
use @vesper/ast::dump::{dump_ast};
use @vesper-std/collections::flat_table::{FlatTable};
use @vesper-std/intern::{Interner};
use @vesper-std/arena::{idx_from_raw};
use @vesper/check-data::{pack_text};
use self::state::{
    St, at32, at64, at8, join_path, kind_value, emit, err, hi, inc, kind_has, kind_sugar, lo, n32,
    none, pair, push_sym, put, put_sym, st_new, w
};
use self::load::{
    adt_at, back, begin_module, collect_all, collect_all_bytes, decode, decode_bytes,
    effect_decl_at, fn_at, item_at, item_name, tr, variant_name
};
use self::resolve::{
    ambiguous, group, is_foreign, local_of, lookup, name_of, no_key, overrides, reexports, shown,
    use_module
};
use self::rename::{assoc_decl_at, conf_at, effects, item, owner, trait_ref};

fn text_range(in loader: St, module: u64) -> (u64, u64) {
    let start = match loader.mod_text_start.try_get(module) {
        Option::Some(offset) => offset,
        Option::None => 0,
    };
    let end = match loader.mod_text_end.try_get(module) {
        Option::Some(offset) => offset,
        Option::None => 0,
    };
    (start, end)
}

// Root-module names other modules must not reach unimported, and the
// owning enum of every variant (first declaration wins).
fn hidden_and_variants(inout loader: St) {
    let root = loader.root_mod;
    if root != none() {
        let first = w(at32(in loader.mod_items_first, w(root)));
        let count = w(at32(in loader.mod_items_len, w(root)));
        for i in 0..count {
            let name = at32(in loader.item_list, wrapping_add(first, i));
            match loader.item_kind.get(pair(root, name)) {
                Option::Some(kind) => {
                    loader.hidden.insert(name, kind);
                },
                Option::None => {},
            }
        }
        for i in 0..loader.root_reexports.len() {
            let name = at32(in loader.root_reexports, i);
            let key = pair(root, name);
            match loader.reexport_key.get(key) {
                Option::Some(target) => {
                    if !is_foreign(in loader, target) {
                        match loader.reexport_kind.get(key) {
                            Option::Some(kind) => {
                                loader.hidden.insert(name, kind);
                            },
                            Option::None => {},
                        }
                    }
                },
                Option::None => {},
            }
        }
    }
    for enum_index in 0..loader.enum_mod.len() {
        let key = pair(at32(in loader.enum_mod, enum_index), at32(in loader.enum_name, enum_index));
        let owner_name = name_of(inout loader, key);
        let owner_shown = shown(inout loader, key);
        let first = w(at32(in loader.enum_variant_first, enum_index));
        let count = w(at32(in loader.enum_variant_len, enum_index));
        for i in 0..count {
            let variant = at32(in loader.enum_variants, wrapping_add(first, i));
            if !loader.variant_owner.contains_key(variant) {
                loader.variant_owner.insert(variant, owner_name);
                loader.variant_shown.insert(variant, owner_shown);
            }
        }
    }
}

// The literal value of every constant that has one, by internal name
// (latest declaration wins), and the untyped value enum members.
fn literals(inout loader: St) {
    for i in 0..loader.lit_module.len() {
        let key = pair(at32(in loader.lit_module, i), at32(in loader.lit_func, i));
        let name = name_of(inout loader, key);
        if at8(in loader.lit_untyped, i) == 1 {
            loader.untyped.insert(name, 1);
        }
        loader.lit_row.insert(name, n32(i));
    }
}

fn ambiguous_name(inout loader: St, local: u32, start: u32, end: u32, in what: Str, file: u32) {
    err(inout loader, ambiguous(), start, end);
    let mut msg = String::new();
    msg.push_str(in "'");
    push_sym(in loader, local, inout msg);
    msg.push_str(in what);
    loader.err_msg.push_str(in msg);
    emit(inout loader, file);
}

// A value enum import: each member `E::M` of the enum in `loader.result_members`
// and `loader.result_keys` becomes the local constant `local::M` (`assemble`'s group
// branch).
fn bind_group(
    inout loader: St,
    module: u32,
    local: u32,
    public: bool,
    start: u32,
    end: u32,
    file: u32,
    inout exported: ChunkSeq[u32]
) {
    if loader.item_kind.contains_key(pair(module, local))
        || loader.own_prefix.contains_key(pair(module, local))
    {
        ambiguous_name(
            inout loader,
            local,
            start,
            end,
            in "' is both declared in this module and imported",
            file
        );
        return;
    }
    let mut members: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut targets: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..loader.result_members.len() {
        let member = at32(in loader.result_members, i);
        let key = at64(in loader.result_keys, i);
        let local_member = join_path(inout loader, local, member);
        members.push(local_member);
        let target = name_of(inout loader, key);
        targets.push(target);
    }
    // The member set, sorted by symbol (a set compares by its elements).
    let mut source: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..targets.len() {
        let target = at32(in targets, i);
        let mut j = source.len();
        let mut dup = false;
        for k in 0..source.len() {
            if at32(in source, k) == target {
                dup = true;
            }
        }
        if !dup {
            source.push(target);
            loop {
                if j == 0 {
                    break;
                }
                let prev = at32(in source, wrapping_sub(j, 1));
                if prev <= target {
                    break;
                }
                source.try_set(j, prev);
                source.try_set(wrapping_sub(j, 1), target);
                j = wrapping_sub(j, 1);
            }
        }
    }
    match loader.groups.get(local) {
        Option::Some(range) => {
            let first = lo(range);
            let len = w(hi(range));
            let mut same = len == source.len();
            if same {
                for k in 0..len {
                    if at32(in loader.group_pool, wrapping_add(w(first), k)) != at32(in source, k) {
                        same = false;
                    }
                }
            }
            if !same {
                ambiguous_name(
                    inout loader,
                    local,
                    start,
                    end,
                    in "' is imported twice from different items",
                    file
                );
                return;
            }
        },
        Option::None => {},
    }
    for i in 0..members.len() {
        match loader.names.get(at32(in members, i)) {
            Option::Some(binding) => {
                if lo(binding) != at32(in targets, i) {
                    ambiguous_name(
                        inout loader,
                        local,
                        start,
                        end,
                        in "' is imported twice from different items",
                        file
                    );
                    return;
                }
            },
            Option::None => {},
        }
    }
    let first = loader.group_pool.len();
    loader.group_pool.extend(in source.as_slice());
    loader.groups.insert(local, first | wrapping_shl_u64(source.len(), 32));
    for i in 0..members.len() {
        let target = at32(in targets, i);
        if public {
            exported.push(target);
        }
        loader.names.insert(
            at32(in members, i),
            w(target) | wrapping_shl_u64(widen_u64(kind_value()), 32)
        );
        loader.targets.insert(target, 1);
    }
}

// The names `module` binds: its own items, then its imports (reported
// when they do not resolve or clash). Returns the targets of its `pub use`
// names in `exported`.
fn bind(inout loader: St, module: u32, inout exported: ChunkSeq[u32]) {
    loader.names.clear();
    loader.targets.clear();
    loader.groups.clear();
    loader.group_pool.clear();
    let file = at32(in loader.mod_file, w(module));
    let first = w(at32(in loader.mod_items_first, w(module)));
    let count = w(at32(in loader.mod_items_len, w(module)));
    for i in 0..count {
        let name = at32(in loader.item_list, wrapping_add(first, i));
        let key = pair(module, name);
        let mangled = name_of(inout loader, key);
        if mangled != name && !loader.renamed.contains_key(key) {
            let shown_name = shown(inout loader, key);
            loader.qualified.insert(mangled, shown_name);
        }
        let kind = match loader.item_kind.get(key) {
            Option::Some(k) => k,
            Option::None => 0,
        };
        loader.names.insert(name, w(mangled) | wrapping_shl_u64(widen_u64(kind), 32));
        loader.targets.insert(mangled, 1);
    }
    let use_first = w(at32(in loader.mod_use_first, w(module)));
    let use_count = w(at32(in loader.mod_use_len, w(module)));
    let mut module_shown = String::new();
    for use_index in 0..use_count {
        let use_row = wrapping_add(use_first, use_index);
        let target_module = use_module(inout loader, module, n32(use_row), inout module_shown);
        if target_module == none() {
            emit(inout loader, file);
            continue;
        }
        let same = target_module == module;
        let public = match loader.use_public.try_get(use_row) {
            Option::Some(flag) => flag != 0,
            Option::None => false,
        };
        let names_first = w(at32(in loader.use_names_first, use_row));
        let name_count = w(at32(in loader.use_names_len, use_row));
        for k in 0..name_count {
            let name_row = wrapping_add(names_first, k);
            let start = at32(in loader.import_start, name_row);
            let end = at32(in loader.import_end, name_row);
            // A value enum imports each member `E::M` as a constant.
            let group_status = group(
                inout loader,
                target_module,
                at32(in loader.import_name, name_row),
                same,
                in module_shown,
                start,
                end
            );
            if group_status == 2 {
                emit(inout loader, file);
                continue;
            }
            if group_status == 1 {
                let local = local_of(in loader, name_row);
                bind_group(inout loader, module, local, public, start, end, file, inout exported);
                continue;
            }
            let (key, kind) = lookup(
                inout loader,
                target_module,
                at32(in loader.import_name, name_row),
                same,
                in module_shown,
                start,
                end
            );
            if key == no_key() {
                emit(inout loader, file);
                continue;
            }
            let target = name_of(inout loader, key);
            let local = local_of(in loader, name_row);
            if loader.item_kind.contains_key(pair(module, local)) {
                err(inout loader, ambiguous(), start, end);
                let mut msg = String::new();
                msg.push_str(in "'");
                push_sym(in loader, local, inout msg);
                msg.push_str(in "' is both declared in this module and imported");
                loader.err_msg.push_str(in msg);
                emit(inout loader, file);
                continue;
            }
            let clash = match loader.names.get(local) {
                Option::Some(binding) => lo(binding) != target,
                Option::None => false,
            };
            if clash {
                err(inout loader, ambiguous(), start, end);
                let mut msg = String::new();
                msg.push_str(in "'");
                push_sym(in loader, local, inout msg);
                msg.push_str(in "' is imported twice from different items");
                loader.err_msg.push_str(in msg);
                emit(inout loader, file);
            } else {
                // A sugar is no item of the output, and a `.vsys` type is
                // not a source item: a root module exports neither.
                if public && kind != kind_sugar() && !is_foreign(in loader, key) {
                    exported.push(target);
                }
                loader.names.insert(local, w(target) | wrapping_shl_u64(widen_u64(kind), 32));
                loader.targets.insert(target, 1);
            }
        }
    }
}

fn generic_names(inout loader: St, in ast: Ast, list: u32) {
    for i in 0..list_len(in ast, list) {
        let generic_id = list_at(in ast, list, i);
        let name = match ast.generics.get(idx_from_raw[GenericNode](generic_id)) {
            Option::Some(generic) => generic.name,
            Option::None => ast_none(),
        };
        let global = tr(inout loader, in ast, name);
        loader.scope_pool.push(global);
    }
}

fn scope_put(inout loader: St, owner_name: u32, first: u64) {
    let len = wrapping_sub(loader.scope_pool.len(), first);
    loader.scopes.insert(owner_name, first | wrapping_shl_u64(len, 32));
}

// `generic_scopes`: the generic parameters in scope for each trait-bound
// owner (`f`, `Type::method` or `Type`), from the items as parsed.
fn generic_scopes(inout loader: St, inout ast: Ast) {
    loader.scopes.clear();
    loader.scope_pool.clear();
    for i in 0..ast.m_items.len() {
        let item_row = item_at(in ast, at32(in ast.m_items, i));
        if item_row.kind == 1 {
            let adt = adt_at(in ast, item_row.node);
            let first = loader.scope_pool.len();
            generic_names(inout loader, in ast, adt.generics);
            let name = tr(inout loader, in ast, adt.name);
            scope_put(inout loader, name, first);
        } else if item_row.kind == 2 {
            let func = fn_at(in ast, item_row.node);
            let first = loader.scope_pool.len();
            generic_names(inout loader, in ast, func.generics);
            let name = tr(inout loader, in ast, func.name);
            scope_put(inout loader, name, first);
        } else if item_row.kind == 4 {
            let impl_node = ast.impls.get_or(
                idx_from_raw[ImplNode](item_row.node),
                ImplNode { ty: ast_none(), generics: 0, methods: 0 }
            );
            let ty_name = ast_type_name(in ast, impl_node.ty);
            let type_sym = if ty_name == ast_none() {
                loader.empty_sym
            } else {
                tr(inout loader, in ast, ty_name)
            };
            for k in 0..list_len(in ast, impl_node.methods) {
                let method = fn_at(in ast, list_at(in ast, impl_node.methods, k));
                let first = loader.scope_pool.len();
                generic_names(inout loader, in ast, impl_node.generics);
                generic_names(inout loader, in ast, method.generics);
                let mut key = String::new();
                push_sym(in loader, type_sym, inout key);
                key.push_str(in "::");
                let method_name = tr(inout loader, in ast, method.name);
                push_sym(in loader, method_name, inout key);
                let key_sym = loader.interner.intern(in key).id();
                scope_put(inout loader, key_sym, first);
            }
        }
    }
}

// `global_names`: enum variants, effect operations, traits and models,
// with their file-local spans, appended as (name, start, end) triples.
fn global_names(inout loader: St, in ast: Ast, item_row: ItemNode, inout out: ChunkSeq[u32]) {
    out.clear();
    if item_row.kind == 1 {
        let adt = adt_at(in ast, item_row.node);
        if adt.is_enum {
            for i in 0..list_len(in ast, adt.variants) {
                let name = tr(
                    inout loader,
                    in ast,
                    variant_name(in ast, list_at(in ast, adt.variants, i))
                );
                out.push(name);
                out.push(adt.start);
                out.push(adt.end);
            }
        }
    } else if item_row.kind == 3 {
        let decl = effect_decl_at(in ast, item_row.node);
        for i in 0..list_len(in ast, decl.ops) {
            let op = fn_at(in ast, list_at(in ast, decl.ops, i));
            let name = tr(inout loader, in ast, op.name);
            out.push(name);
            out.push(op.start);
            out.push(op.end);
        }
    } else if item_row.kind == 5 {
        let trait_node = ast.traits.get_or(
            idx_from_raw[TraitNode](item_row.node),
            TraitNode {
                name: ast_none(),
                public: false,
                generics: 0,
                assoc: 0,
                methods: 0,
                start: 0,
                end: 0
            }
        );
        let name = tr(inout loader, in ast, trait_node.name);
        out.push(name);
        out.push(trait_node.start);
        out.push(trait_node.end);
    } else if item_row.kind == 6 {
        let conf = conf_at(in ast, item_row.node);
        if conf.model != ast_none() {
            let name = tr(inout loader, in ast, conf.model);
            out.push(name);
            out.push(conf.start);
            out.push(conf.end);
        }
    }
}

fn check_globals(inout loader: St, in found: ChunkSeq[u32]) {
    let file = at32(in loader.mod_file, w(loader.cur_module));
    let mut i: u64 = 0;
    loop {
        if i >= found.len() {
            break;
        }
        let name = at32(in found, i);
        let start = at32(in found, inc(i));
        let end = at32(in found, wrapping_add(i, 2));
        match loader.globals.get(name) {
            Option::Some(first_file) => {
                if first_file != file {
                    err(inout loader, ambiguous(), start, end);
                    let mut msg = String::new();
                    msg.push_str(in "'");
                    push_sym(in loader, name, inout msg);
                    msg.push_str(in "' is also declared in ");
                    push_sym(in loader, at32(in loader.file_display, w(first_file)), inout msg);
                    msg.push_str(
                        in "; enum variants, effect operations, traits and models share one namespace"
                    );
                    loader.err_msg.push_str(in msg);
                    emit(inout loader, file);
                }
            },
            Option::None => {
                loader.globals.insert(name, file);
            },
        }
        i = wrapping_add(i, 3);
    }
}

// Binds and renames `module`.
fn assemble_module(inout loader: St, in input: Str, module: u32) -> AssembledModule {
    assemble_module_bytes(inout loader, in input.as_bytes(), module)
}

// The expanded regions of `module`, for `definition`.
fn enter_regions(inout loader: St, module: u32) {
    match loader.sugar_row.get(module) {
        Option::Some(row) => {
            loader.cur_region_first = w(at32(in loader.srm_first, w(row)));
            loader.cur_region_count = w(at32(in loader.srm_count, w(row)));
            loader.cur_prefix = at32(in loader.srm_prefix, w(row));
        },
        Option::None => {
            loader.cur_region_count = 0;
            loader.cur_prefix = none();
        },
    }
}

fn assemble_module_bytes(inout loader: St, in input: Slice[u8], module: u32) -> AssembledModule {
    let mut exported: ChunkSeq[u32] = ChunkSeq::new[u32]();
    bind(inout loader, module, inout exported);
    loader.cur_module = module;
    enter_regions(inout loader, module);
    loader.cur_pkg = at32(in loader.mod_pkg, w(module));
    loader.is_root = module == loader.root_mod;
    let file = at32(in loader.mod_file, w(module));
    loader
        .shift = n32(match loader.file_base.try_get(w(file)) {
            Option::Some(base) => base,
            Option::None => 0,
        });
    loader.values.clear();
    loader.types.clear();
    let mut lowered = match loader.cached_lowerings.pop() {
        Option::Some(cached) => cached,
        Option::None => {
            let (start, end) = text_range(in loader, w(module));
            match String::from_utf8(in input[start..end]) {
                Option::Some(src) => lower_source(in src.as_str()),
                Option::None => lower_source(in ""),
            }
        },
    };
    begin_module(inout loader);
    loader.parsed_expr_count = lowered.ast.exprs.len();
    generic_scopes(inout loader, inout lowered.ast);
    let mut found: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..lowered.ast.m_items.len() {
        let item_row = item_at(in lowered.ast, at32(in lowered.ast.m_items, i));
        global_names(inout loader, in lowered.ast, item_row, inout found);
        item(inout loader, inout lowered.ast, item_row.kind, item_row.node);
        check_globals(inout loader, in found);
    }
    for i in 0..lowered.ast.m_bounds.len() {
        let bound_id = at32(in lowered.ast.m_bounds, i);
        let mut bound = lowered.ast.bounds.get_or(
            idx_from_raw[BoundNode](bound_id),
            BoundNode {
                param: ast_none(),
                trait_ref: ast_none(),
                start: 0,
                end: 0,
                owner: ast_none()
            }
        );
        let mark = loader.types.len();
        let owner_sym = tr(inout loader, in lowered.ast, bound.owner);
        match loader.scopes.get(owner_sym) {
            Option::Some(range) => {
                let first = range & 4294967295;
                let len = range >> 32;
                for k in 0..len {
                    let generic = at32(in loader.scope_pool, wrapping_add(first, k));
                    loader.types.push(generic);
                }
            },
            Option::None => {},
        }
        let new_owner = owner(inout loader, owner_sym);
        if new_owner != owner_sym {
            bound.owner = back(inout loader, inout lowered.ast, new_owner);
        }
        trait_ref(inout loader, inout lowered.ast, bound.trait_ref);
        loader.types.truncate(mark);
        bound.start = wrapping_add(bound.start, loader.shift);
        bound.end = wrapping_add(bound.end, loader.shift);
        lowered.ast.bounds.set(idx_from_raw[BoundNode](bound_id), bound);
    }
    for i in 0..lowered.ast.m_model_uses.len() {
        let model_use_id = at32(in lowered.ast.m_model_uses, i);
        let mut model_use = lowered.ast.model_uses.get_or(
            idx_from_raw[ModelUseNode](model_use_id),
            ModelUseNode { model: ast_none(), start: 0, end: 0, scope_start: 0, scope_end: 0 }
        );
        model_use.start = wrapping_add(model_use.start, loader.shift);
        model_use.end = wrapping_add(model_use.end, loader.shift);
        model_use.scope_start = wrapping_add(model_use.scope_start, loader.shift);
        model_use.scope_end = wrapping_add(model_use.scope_end, loader.shift);
        lowered.ast.model_uses.set(idx_from_raw[ModelUseNode](model_use_id), model_use);
    }
    for i in 0..lowered.ast.m_public.len() {
        let public_name = tr(inout loader, in lowered.ast, at32(in lowered.ast.m_public, i));
        match loader.names.get(public_name) {
            Option::Some(binding) => loader.public_out.push(lo(binding)),
            Option::None => {},
        }
    }
    if loader.is_root {
        loader.public_out.extend(in exported.as_slice());
    }
    // The assembled module has no imports; its public names are listed
    // once for the whole program.
    lowered.ast.m_uses.clear();
    lowered.ast.m_public.clear();
    AssembledModule { ast: lowered.ast, file: file }
}

/// A prepared package graph. Pull renamed modules in load order with
/// `assemble_next`. Public names, qualified names and diagnostics are
/// complete after the last module.
pub struct Assembly {
    loader: St,
    next_module: u64
}

/// One module's renamed AST, with spans in the virtual concatenation.
pub struct AssembledModule {
    ast: Ast,
    file: u32
}

/// Package-wide metadata. The public and qualified names and file display
/// paths use `names`. The file arrays are indexed by `AssembledModule.file`.
pub struct AssemblyMetadata {
    names: Interner,
    public_items: ChunkSeq[u32],
    qualified: FlatTable[u32, u32],
    file_display: ChunkSeq[u32],
    file_base: ChunkSeq[u64],
    // File-local sugar contracts: (file, word count, module, author map, regions).
    pub sugar_policy_words: ChunkSeq[u64],
    pub sugar_policy_truncated: bool,
    // Assembler diagnostics in the canonical `diag ...` text format.
    diagnostics: ChunkSeq[u8],
    // The same as rows: per diagnostic its file, code (111 for E0111),
    // start, end (file-local), message length and help length (`u64::MAX`
    // for none); the message and help bytes follow each other in
    // `diagnostic_text`.
    diagnostic_rows: ChunkSeq[u64],
    diagnostic_text: ChunkSeq[u8]
}

// A package-loader expansion plan consumes the same relative module IDs
// as the assembly graph. Names are owned so the resolver can be dropped
// before the expansion pass starts.
pub struct ResolvedSugarImport {
    pub caller_module: u32,
    pub local_name: String,
    pub definition_module: u32,
    pub definition_name: String,
}

// Resolve sugar imports before executable bodies are lowered. The input is
// the regular graph envelope with import-only module text and the sugar
// declaration suffix. Keep visibility and public re-export rules identical
// to full assembly; unresolved ordinary imports are not reported until the
// expanded graph is actually assembled.
pub fn resolve_sugar_imports_bytes(in input: Slice[u8]) -> ChunkSeq[ResolvedSugarImport] {
    let mut loader = st_new();
    decode_bytes(inout loader, in input);
    collect_all_bytes(inout loader, in input);
    reexports(inout loader);
    let mut resolved = ChunkSeq::new[ResolvedSugarImport]();
    let mut shown = String::new();
    for module in 0..loader.mod_pkg.len() {
        let use_first = w(at32(in loader.mod_use_first, module));
        let use_count = w(at32(in loader.mod_use_len, module));
        for use_index in 0..use_count {
            let use_row = wrapping_add(use_first, use_index);
            let target = use_module(inout loader, n32(module), n32(use_row), inout shown);
            loader.err_code = 0;
            if target == none() {
                continue;
            }
            let names_first = w(at32(in loader.use_names_first, use_row));
            let names_count = w(at32(in loader.use_names_len, use_row));
            for index in 0..names_count {
                let name_row = wrapping_add(names_first, index);
                let (key, kind) = lookup(
                    inout loader,
                    target,
                    at32(in loader.import_name, name_row),
                    target == n32(module),
                    in shown,
                    at32(in loader.import_start, name_row),
                    at32(in loader.import_end, name_row)
                );
                loader.err_code = 0;
                if key != no_key() && kind == kind_sugar() {
                    let mut local_name = String::new();
                    push_sym(in loader, local_of(in loader, name_row), inout local_name);
                    let mut definition_name = String::new();
                    push_sym(in loader, lo(key), inout definition_name);
                    resolved.push(
                        sink ResolvedSugarImport {
                            caller_module: n32(module),
                            local_name: local_name,
                            definition_module: hi(key),
                            definition_name: definition_name
                        }
                    );
                }
            }
        }
    }
    resolved
}

pub fn assembly_begin(in input: Str) -> Assembly {
    assembly_begin_bytes(in input.as_bytes())
}

pub fn assembly_begin_bytes(in input: Slice[u8]) -> Assembly {
    let mut loader = st_new();
    decode_bytes(inout loader, in input);
    collect_all_bytes(inout loader, in input);
    reexports(inout loader);
    overrides(inout loader);
    hidden_and_variants(inout loader);
    literals(inout loader);
    Assembly { loader: loader, next_module: 0 }
}

/// The number of parse diagnostics across the graph's modules.
pub fn assembly_parse_errors(in assembly: Assembly) -> u64 {
    assembly.loader.parse_errors
}

/// `input` is the same encoded graph passed to `assembly_begin`. Each
/// returned AST owns its arenas and can outlive the next call. Its name
/// symbols belong to its own interner.
pub fn assemble_next(inout assembly: Assembly, in input: Str) -> Option[AssembledModule] {
    assemble_next_bytes(inout assembly, in input.as_bytes())
}

pub fn assemble_next_bytes(
    inout assembly: Assembly,
    in input: Slice[u8]
) -> Option[AssembledModule] {
    if assembly.next_module >= assembly.loader.mod_pkg.len() {
        return Option::None;
    }
    let module = n32(assembly.next_module);
    assembly.next_module = inc(assembly.next_module);
    Option::Some(assemble_module_bytes(inout assembly.loader, in input, module))
}

// Open sugar policy data while retaining the resolver for the definition-site
// effect rows. The no-policy path does not copy the file table.
pub fn assembly_sugar_policy(in assembly: Assembly) -> Option[(ChunkSeq[u64], ChunkSeq[u64])] {
    if assembly.loader.sugar_policy_truncated {
        return Option::None;
    }
    let mut words = ChunkSeq::new[u64]();
    let mut bases = ChunkSeq::new[u64]();
    if assembly.loader.sugar_policy_words.len() != 0 {
        words.extend(in assembly.loader.sugar_policy_words.as_slice());
        bases.extend(in assembly.loader.file_base.as_slice());
    }
    Option::Some((words, bases))
}

pub fn assembly_source_size(in assembly: Assembly, module: u64) -> Option[u64] {
    if module >= assembly.loader.mod_pkg.len() {
        return Option::None;
    }
    let (start, end) = text_range(in assembly.loader, module);
    if end < start {
        Option::None
    } else {
        Option::Some(wrapping_sub(end, start))
    }
}

// Resolve the synthetic signature's effect row without adding the signature
// to the module's AST, declarations, or exports. Call after draining
// the ordinary module cursor.
pub fn resolve_sugar_effect_row(
    inout assembly: Assembly,
    author: u64,
    inout ast: Ast,
    row: u32
) -> bool {
    if author >= assembly.loader.mod_pkg.len() {
        return false;
    }
    let module = n32(author);
    let diagnostics_before = assembly.loader.diags.len();
    let mut unused_exports = ChunkSeq::new[u32]();
    bind(inout assembly.loader, module, inout unused_exports);
    assembly.loader.cur_module = module;
    assembly.loader.cur_pkg = at32(in assembly.loader.mod_pkg, author);
    // The row resolves where the sugar is defined: no region applies.
    assembly.loader.cur_region_count = 0;
    assembly.loader.cur_prefix = none();
    assembly.loader.is_root = module == assembly.loader.root_mod;
    assembly.loader.types.clear();
    assembly.loader.values.clear();
    begin_module(inout assembly.loader);
    effects(inout assembly.loader, inout ast, row, 0, 0);
    assembly.loader.diags.len() == diagnostics_before
}

/// Takes the metadata accumulated so far and releases the resolver tables.
pub fn assembly_metadata(sink assembly: Assembly) -> AssemblyMetadata {
    AssemblyMetadata {
        names: assembly.loader.interner,
        public_items: assembly.loader.public_out,
        qualified: assembly.loader.qualified,
        file_display: assembly.loader.file_display,
        file_base: assembly.loader.file_base,
        sugar_policy_words: assembly.loader.sugar_policy_words,
        sugar_policy_truncated: assembly.loader.sugar_policy_truncated,
        diagnostics: assembly.loader.diags,
        diagnostic_rows: assembly.loader.diag_rows,
        diagnostic_text: assembly.loader.diag_text
    }
}

// The assembly without the text: the diagnostics' bytes plus the public
// and qualified names, for the timings (Rust builds no text either).
pub fn assemble_only(in input: Str) -> u64 {
    let mut assembly = assembly_begin(in input);
    for _i in 0..assembly.loader.mod_pkg.len() {
        let _module = assemble_next(inout assembly, in input);
    }
    let meta = assembly_metadata(sink assembly);
    wrapping_add(
        wrapping_add(meta.diagnostics.len(), meta.public_items.len()),
        meta.qualified.len()
    )
}

// The assembled program as text, for the differential test:
//   diag <file> <code> <start>..<end> <message>[ help: <help>]
//   qualified <internal name> <display name>     (any order)
//   public <name>
// then every module's dump (@vesper/ast dump.ves) with its imports and
// public names removed. Packed by `pack_text`.
pub fn assemble_text(in input: Str) -> ChunkSeq[u64] {
    let mut assembly = assembly_begin(in input);
    let mut dumps = ChunkSeq::new[u8]();
    for _i in 0..assembly.loader.mod_pkg.len() {
        match assemble_next(inout assembly, in input) {
            Option::Some(module) => dump_ast(in module.ast, inout dumps),
            Option::None => {},
        }
    }
    let meta = assembly_metadata(sink assembly);
    let mut out = ChunkSeq::new[u8]();
    out.extend(in meta.diagnostics.as_slice());
    for i in 0..meta.qualified.len() {
        match meta.qualified.entry_at(i) {
            Option::Some((internal, display)) => {
                put(inout out, in "qualified ");
                put_sym(inout out, in meta.names, internal);
                out.push(32);
                put_sym(inout out, in meta.names, display);
                out.push(10);
            },
            Option::None => {},
        }
    }
    for i in 0..meta.public_items.len() {
        put(inout out, in "public ");
        put_sym(inout out, in meta.names, at32(in meta.public_items, i));
        out.push(10);
    }
    out.extend(in dumps.as_slice());
    pack_text(in out)
}

// The number of modules the input names, for a quick check of the decoder.
pub fn module_count(in input: Str) -> u64 {
    let mut loader = st_new();
    decode(inout loader, in input);
    loader.mod_pkg.len()
}

// Decodes the input and parses every module once (no tables, no renaming):
// the parse cost inside `assemble_text`, which parses each module twice,
// for the timings. Returns the number of items parsed.
pub fn parse_modules(in input: Str) -> u64 {
    let mut loader = st_new();
    decode(inout loader, in input);
    let mut item_count: u64 = 0;
    for module in 0..loader.mod_pkg.len() {
        let (start, end) = text_range(in loader, module);
        let lowered = lower_source(in input[start..end]);
        item_count = wrapping_add(item_count, lowered.ast.m_items.len());
    }
    item_count
}
