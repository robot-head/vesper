// The loader state of the package assembler: the package graph the Rust
// loader read from disk, every module's declared names and imports as flat
// rows, the resolver's tables and the output buffers.
//
// Names are symbols of one global interner `St.interner` (the census design: no
// `String`-keyed maps). A module is a row index; an item key
// (`ItemKey` in src/packages.rs) is `module << 32 | name`. Tables keyed by
// pairs pack the two `u32`s into one `u64` the same way.

use @vesper/ast::lower::L;
use @vesper-std/intern::{Interner, interner_new, symbol_from_id};
use @vesper-std/collections::flat_table::{FlatTable, flat_table_new};

// An absent index or symbol.
pub fn none() -> u32 {
    4294967295
}

// Name kinds (`Kind` in src/packages.rs): which namespaces a name lives in.
pub fn kind_value() -> u8 {
    1
}

pub fn kind_type() -> u8 {
    2
}

pub fn kind_both() -> u8 {
    3
}

// A `sugar` declaration's name: importable like an item, but in neither
// namespace, so no reference resolves to it (`Kind::Sugar`).
pub fn kind_sugar() -> u8 {
    4
}

// `Kind::has`.
pub fn kind_has(kind: u8, ns: u8) -> bool {
    kind == kind_both() || kind == ns
}

pub fn w(value: u32) -> u64 {
    widen_u64(value)
}

pub fn n32(value: u64) -> u32 {
    wrapping_u32(value)
}

pub fn inc(value: u64) -> u64 {
    wrapping_add(value, 1)
}

pub fn pair(high: u32, low: u32) -> u64 {
    wrapping_shl_u64(widen_u64(high), 32) | widen_u64(low)
}

pub fn hi(key: u64) -> u32 {
    wrapping_u32(key >> 32)
}

pub fn lo(key: u64) -> u32 {
    wrapping_u32(key & 4294967295)
}

pub fn at32(in seq: ChunkSeq[u32], i: u64) -> u32 {
    match seq.try_get(i) {
        Option::Some(value) => value,
        Option::None => none(),
    }
}

pub fn at64(in seq: ChunkSeq[u64], i: u64) -> u64 {
    match seq.try_get(i) {
        Option::Some(value) => value,
        Option::None => 0,
    }
}

pub fn at8(in seq: ChunkSeq[u8], i: u64) -> u8 {
    match seq.try_get(i) {
        Option::Some(value) => value,
        Option::None => 0,
    }
}

// Optional generated-to-original ranges in the package graph.
pub copy struct SourceSegment {
    file: u32,
    generated_start: u64,
    generated_end: u64,
    source_start: u64,
    source_end: u64,
    copied: bool,
}

pub struct St {
    interner: Interner,
    buf: String,
    // Packages: name, dependencies (name -> package) and the names of
    // optional dependencies (for E0111's message).
    pkg_name: ChunkSeq[u32],
    pkg_dep_first: ChunkSeq[u32],
    pkg_dep_len: ChunkSeq[u32],
    dep_name: ChunkSeq[u32],
    dep_target: ChunkSeq[u32],
    pkg_opt_first: ChunkSeq[u32],
    pkg_opt_len: ChunkSeq[u32],
    opt_name: ChunkSeq[u32],
    // Files: display path and base offset in the virtual concatenation.
    file_display: ChunkSeq[u32],
    file_base: ChunkSeq[u64],
    source_segments: ChunkSeq[SourceSegment],
    sugar_policy_words: ChunkSeq[u64],
    sugar_policy_truncated: bool,
    // Modules, in load order: package, module path (segments in `segments`),
    // file, and the source's byte range in the input.
    mod_pkg: ChunkSeq[u32],
    mod_file: ChunkSeq[u32],
    mod_seg_first: ChunkSeq[u32],
    mod_seg_len: ChunkSeq[u32],
    segments: ChunkSeq[u32],
    mod_text_start: ChunkSeq[u64],
    mod_text_end: ChunkSeq[u64],
    // (package, path) hash -> module; `mod_collide` when two share a hash.
    mod_index: FlatTable[u64, u32],
    mod_collide: bool,
    // The root package's root module, or `none()`.
    root_mod: u32,
    // `Table`: item kinds and `pub` names, keyed (module, name).
    item_kind: FlatTable[u64, u8],
    // Bridge types provided by .vsys libraries, keyed (root module, name).
    foreign_types: FlatTable[u64, u8],
    // Each module's `sugar` declarations (`ModuleSugar::declarations`), in
    // input order: the module, the name and whether it is `pub` (1).
    sugar_mod: ChunkSeq[u32],
    sugar_name: ChunkSeq[u32],
    sugar_public: ChunkSeq[u8],
    // Sugar regions of the expanded modules (the regions suffix): per
    // module with regions its row (`sugar_row`), its fresh prefix and its
    // range of regions; per region its expanded span (file-local), the
    // module that defines its rule and its range of holes (start, end
    // pairs in `sr_holes`). A malformed suffix leaves no module with
    // regions and marks the policy trailer truncated.
    sugar_row: FlatTable[u32, u32],
    srm_prefix: ChunkSeq[u32],
    srm_first: ChunkSeq[u32],
    srm_count: ChunkSeq[u32],
    sr_start: ChunkSeq[u32],
    sr_end: ChunkSeq[u32],
    sr_author: ChunkSeq[u32],
    sr_hole_first: ChunkSeq[u32],
    sr_hole_count: ChunkSeq[u32],
    sr_holes: ChunkSeq[u32],
    // The regions of the module being renamed (`cur_region_count` 0 for
    // none) and its fresh prefix (`none()` without regions).
    cur_region_first: u64,
    cur_region_count: u64,
    cur_prefix: u32,
    public: FlatTable[u64, u8],
    // Each module's declared names in source order (`Kind::of`; a name
    // declared twice appears twice, its kind is the last one's).
    mod_items_first: ChunkSeq[u32],
    mod_items_len: ChunkSeq[u32],
    item_list: ChunkSeq[u32],
    // `UseDecl` rows of each module, and their `UseName` rows.
    mod_use_first: ChunkSeq[u32],
    mod_use_len: ChunkSeq[u32],
    use_package: ChunkSeq[u32],
    use_supers: ChunkSeq[u32],
    use_path_first: ChunkSeq[u32],
    use_path_len: ChunkSeq[u32],
    use_names_first: ChunkSeq[u32],
    use_names_len: ChunkSeq[u32],
    use_public: ChunkSeq[u8],
    use_start: ChunkSeq[u32],
    use_end: ChunkSeq[u32],
    import_name: ChunkSeq[u32],
    import_alias: ChunkSeq[u32],
    import_start: ChunkSeq[u32],
    import_end: ChunkSeq[u32],
    // Enums in load order, with their variant names.
    enum_mod: ChunkSeq[u32],
    enum_name: ChunkSeq[u32],
    enum_variant_first: ChunkSeq[u32],
    enum_variant_len: ChunkSeq[u32],
    enum_variants: ChunkSeq[u32],
    // `Resolver::reexported`: (module, local) -> item key and kind, and the
    // root module's re-exported local names in insertion order.
    reexport_key: FlatTable[u64, u64],
    reexport_kind: FlatTable[u64, u8],
    root_reexports: ChunkSeq[u32],
    // The re-exported path locals `E::M` of each module, listed by (module,
    // E) through `path_reexport_next`: the members of re-exported value enums.
    path_reexport_head: FlatTable[u64, u32],
    path_reexport_name: ChunkSeq[u32],
    path_reexport_next: ChunkSeq[u32],
    // Value enums (`Table::group`): (module, enum) -> its first member row;
    // each row is a member name, its constant `const$E::M` and the next
    // row. `own_prefix` holds (module, P) for every constant `const$P::..`.
    group_head: FlatTable[u64, u32],
    group_member: ChunkSeq[u32],
    group_const: ChunkSeq[u32],
    group_next: ChunkSeq[u32],
    own_prefix: FlatTable[u64, u8],
    // The last `group` result: members in byte order and their item keys.
    result_members: ChunkSeq[u32],
    result_keys: ChunkSeq[u64],
    // Constants with a literal value (`const_literal`), as parsed: module,
    // function name, the literal and whether the constant is an untyped
    // value enum member. `lit_row` maps each one's internal name to its
    // row (latest declaration wins); `untyped` holds the untyped ones.
    lit_module: ChunkSeq[u32],
    lit_func: ChunkSeq[u32],
    lit_kind: ChunkSeq[u8],
    lit_neg: ChunkSeq[u8],
    lit_bits: ChunkSeq[u64],
    lit_hi: ChunkSeq[u64],
    lit_untyped: ChunkSeq[u8],
    lit_row: FlatTable[u32, u32],
    untyped: FlatTable[u32, u8],
    // `Resolver::renamed`: item key -> root name.
    renamed: FlatTable[u64, u32],
    // `mangled` names already built, by item key.
    mangled: FlatTable[u64, u32],
    // The last error of a resolver call (`Err(Diagnostic)`).
    err_code: u32,
    err_msg: String,
    err_help: String,
    err_has_help: bool,
    err_start: u32,
    err_end: u32,
    // `assemble`'s maps: root names other modules must not reach, the
    // owning enum of every variant, and the first module declaring each
    // global name.
    hidden: FlatTable[u32, u8],
    variant_owner: FlatTable[u32, u32],
    variant_shown: FlatTable[u32, u32],
    globals: FlatTable[u32, u32],
    // The outputs: diagnostics, `SourceMap::qualified` (mangled -> shown),
    // and `Module::public_items`.
    diags: ChunkSeq[u8],
    // The same diagnostics as rows for the Vesper driver (#1986): per
    // diagnostic its file, code, start, end, message length and help length
    // (`u64::MAX` for none), the message and help bytes in `diag_text`.
    diag_rows: ChunkSeq[u64],
    diag_text: ChunkSeq[u8],
    qualified: FlatTable[u32, u32],
    public_out: ChunkSeq[u32],
    // The module being renamed (`Renamer`): its bound names (local ->
    // target | kind << 32), the set of their targets, the value and type
    // scopes, and its symbol maps between the AST's interner and `interner`.
    names: FlatTable[u32, u64],
    targets: FlatTable[u32, u8],
    values: ChunkSeq[u32],
    types: ChunkSeq[u32],
    cur_module: u32,
    cur_pkg: u32,
    is_root: bool,
    shift: u32,
    ast_to_global: ChunkSeq[u32],
    global_to_ast: FlatTable[u32, u32],
    // Nodes of the module's AST already renamed. The lowering shares some
    // nodes where Rust's parser clones them (an array repetition's element,
    // an or-pattern arm's body, a generic impl's bound): a revisit renames
    // again from the node's file-local span, and the span moves once.
    seen_expr: ChunkSeq[u8],
    seen_pat: ChunkSeq[u8],
    seen_param: ChunkSeq[u8],
    seen_tref: ChunkSeq[u8],
    // `const_flags` of each global symbol asked about, by symbol id (with
    // bit 2 set; 0 when not computed yet).
    const_flag: ChunkSeq[u8],
    // The module's expression count before renaming: the nodes the renamer
    // makes (a constant's call callee) come after it and are final.
    parsed_expr_count: u64,
    // `assemble`'s per-module `groups`: local enum name -> range of
    // `group_pool` (its member constants, sorted).
    groups: FlatTable[u32, u64],
    group_pool: ChunkSeq[u32],
    // `generic_scopes`: owner -> range of `scope_pool`.
    scopes: FlatTable[u32, u64],
    scope_pool: ChunkSeq[u32],
    // Interned spellings the renamer compares against.
    self_sym: u32,
    super_sym: u32,
    self_ty_sym: u32,
    cached_lowerings: ChunkSeq[L],
    // Parse diagnostics of every module (the Vesper driver's package load
    // assembles only graphs without any, #1986).
    parse_errors: u64,
    empty_sym: u32
}

pub fn st_new() -> St {
    let mut interner = interner_new();
    let empty_sym = interner.intern(in "").id();
    let self_sym = interner.intern(in "self").id();
    let super_sym = interner.intern(in "super").id();
    let self_ty_sym = interner.intern(in "Self").id();
    St {
        interner: interner,
        buf: String::new(),
        pkg_name: ChunkSeq::new[u32](),
        pkg_dep_first: ChunkSeq::new[u32](),
        pkg_dep_len: ChunkSeq::new[u32](),
        dep_name: ChunkSeq::new[u32](),
        dep_target: ChunkSeq::new[u32](),
        pkg_opt_first: ChunkSeq::new[u32](),
        pkg_opt_len: ChunkSeq::new[u32](),
        opt_name: ChunkSeq::new[u32](),
        file_display: ChunkSeq::new[u32](),
        file_base: ChunkSeq::new[u64](),
        source_segments: ChunkSeq::new[SourceSegment](),
        sugar_policy_words: ChunkSeq::new[u64](),
        sugar_policy_truncated: false,
        mod_pkg: ChunkSeq::new[u32](),
        mod_file: ChunkSeq::new[u32](),
        mod_seg_first: ChunkSeq::new[u32](),
        mod_seg_len: ChunkSeq::new[u32](),
        segments: ChunkSeq::new[u32](),
        mod_text_start: ChunkSeq::new[u64](),
        mod_text_end: ChunkSeq::new[u64](),
        mod_index: flat_table_new[u64, u32](),
        mod_collide: false,
        root_mod: none(),
        item_kind: flat_table_new[u64, u8](),
        foreign_types: flat_table_new[u64, u8](),
        sugar_mod: ChunkSeq::new[u32](),
        sugar_name: ChunkSeq::new[u32](),
        sugar_public: ChunkSeq::new[u8](),
        sugar_row: flat_table_new[u32, u32](),
        srm_prefix: ChunkSeq::new[u32](),
        srm_first: ChunkSeq::new[u32](),
        srm_count: ChunkSeq::new[u32](),
        sr_start: ChunkSeq::new[u32](),
        sr_end: ChunkSeq::new[u32](),
        sr_author: ChunkSeq::new[u32](),
        sr_hole_first: ChunkSeq::new[u32](),
        sr_hole_count: ChunkSeq::new[u32](),
        sr_holes: ChunkSeq::new[u32](),
        cur_region_first: 0,
        cur_region_count: 0,
        cur_prefix: none(),
        public: flat_table_new[u64, u8](),
        mod_items_first: ChunkSeq::new[u32](),
        mod_items_len: ChunkSeq::new[u32](),
        item_list: ChunkSeq::new[u32](),
        mod_use_first: ChunkSeq::new[u32](),
        mod_use_len: ChunkSeq::new[u32](),
        use_package: ChunkSeq::new[u32](),
        use_supers: ChunkSeq::new[u32](),
        use_path_first: ChunkSeq::new[u32](),
        use_path_len: ChunkSeq::new[u32](),
        use_names_first: ChunkSeq::new[u32](),
        use_names_len: ChunkSeq::new[u32](),
        use_public: ChunkSeq::new[u8](),
        use_start: ChunkSeq::new[u32](),
        use_end: ChunkSeq::new[u32](),
        import_name: ChunkSeq::new[u32](),
        import_alias: ChunkSeq::new[u32](),
        import_start: ChunkSeq::new[u32](),
        import_end: ChunkSeq::new[u32](),
        enum_mod: ChunkSeq::new[u32](),
        enum_name: ChunkSeq::new[u32](),
        enum_variant_first: ChunkSeq::new[u32](),
        enum_variant_len: ChunkSeq::new[u32](),
        enum_variants: ChunkSeq::new[u32](),
        reexport_key: flat_table_new[u64, u64](),
        reexport_kind: flat_table_new[u64, u8](),
        root_reexports: ChunkSeq::new[u32](),
        path_reexport_head: flat_table_new[u64, u32](),
        path_reexport_name: ChunkSeq::new[u32](),
        path_reexport_next: ChunkSeq::new[u32](),
        group_head: flat_table_new[u64, u32](),
        group_member: ChunkSeq::new[u32](),
        group_const: ChunkSeq::new[u32](),
        group_next: ChunkSeq::new[u32](),
        own_prefix: flat_table_new[u64, u8](),
        result_members: ChunkSeq::new[u32](),
        result_keys: ChunkSeq::new[u64](),
        lit_module: ChunkSeq::new[u32](),
        lit_func: ChunkSeq::new[u32](),
        lit_kind: ChunkSeq::new[u8](),
        lit_neg: ChunkSeq::new[u8](),
        lit_bits: ChunkSeq::new[u64](),
        lit_hi: ChunkSeq::new[u64](),
        lit_untyped: ChunkSeq::new[u8](),
        lit_row: flat_table_new[u32, u32](),
        untyped: flat_table_new[u32, u8](),
        renamed: flat_table_new[u64, u32](),
        mangled: flat_table_new[u64, u32](),
        err_code: 0,
        err_msg: String::new(),
        err_help: String::new(),
        err_has_help: false,
        err_start: 0,
        err_end: 0,
        hidden: flat_table_new[u32, u8](),
        variant_owner: flat_table_new[u32, u32](),
        variant_shown: flat_table_new[u32, u32](),
        globals: flat_table_new[u32, u32](),
        diags: ChunkSeq::new[u8](),
        diag_rows: ChunkSeq::new[u64](),
        diag_text: ChunkSeq::new[u8](),
        qualified: flat_table_new[u32, u32](),
        public_out: ChunkSeq::new[u32](),
        names: flat_table_new[u32, u64](),
        targets: flat_table_new[u32, u8](),
        values: ChunkSeq::new[u32](),
        types: ChunkSeq::new[u32](),
        cur_module: 0,
        cur_pkg: 0,
        is_root: false,
        shift: 0,
        ast_to_global: ChunkSeq::new[u32](),
        global_to_ast: flat_table_new[u32, u32](),
        seen_expr: ChunkSeq::new[u8](),
        seen_pat: ChunkSeq::new[u8](),
        seen_param: ChunkSeq::new[u8](),
        seen_tref: ChunkSeq::new[u8](),
        const_flag: ChunkSeq::new[u8](),
        cached_lowerings: ChunkSeq::new[L](),
        parse_errors: 0,
        parsed_expr_count: 0,
        groups: flat_table_new[u32, u64](),
        group_pool: ChunkSeq::new[u32](),
        scopes: flat_table_new[u32, u64](),
        scope_pool: ChunkSeq::new[u32](),
        self_sym: self_sym,
        super_sym: super_sym,
        self_ty_sym: self_ty_sym,
        empty_sym: empty_sym
    }
}

// ---------------------------------------------------------------- symbols

// The byte range of symbol `sym` in `loader.interner`'s text.
pub fn sym_range(in loader: St, sym: u32) -> (u64, u64) {
    loader.interner.span(symbol_from_id(sym))
}

pub fn sym_len(in loader: St, sym: u32) -> u64 {
    let (start, end) = sym_range(in loader, sym);
    wrapping_sub(end, start)
}

// Byte `i` of symbol `sym` (0 past its end).
pub fn sym_byte(in loader: St, sym: u32, i: u64) -> u8 {
    let (start, end) = sym_range(in loader, sym);
    let at = wrapping_add(start, i);
    if at >= end {
        return 0;
    }
    match loader.interner.text_byte(at) {
        Option::Some(byte) => byte,
        Option::None => 0,
    }
}

// Appends the text of `sym` to `out`.
pub fn push_sym(in loader: St, sym: u32, inout out: String) {
    loader.interner.resolve_into(symbol_from_id(sym), inout out);
}

// Interns `loader.buf`.
pub fn intern_buf(inout loader: St) -> u32 {
    match loader.interner.lookup(in loader.buf) {
        Option::Some(sym) => sym.id(),
        Option::None => loader.interner.intern(in loader.buf).id(),
    }
}

// The global symbol of `text`, interned if it is new. It is looked up
// first: Stage 2 copies the whole loader each time a call changes one of
// its fields in place (`inout loader.interner`), so a name the interner
// already holds is found without that copy.
pub fn intern_str(inout loader: St, in text: Str) -> u32 {
    match loader.interner.lookup(in text) {
        Option::Some(sym) => sym.id(),
        Option::None => loader.interner.intern(in text).id(),
    }
}

// Whether `sym` starts with `prefix`.
pub fn sym_starts(in loader: St, sym: u32, in prefix: Str) -> bool {
    let len = prefix.len();
    if sym_len(in loader, sym) < len {
        return false;
    }
    let prefix_bytes = prefix.as_bytes();
    for i in 0..len {
        let byte = match prefix_bytes.try_get(i) {
            Option::Some(byte) => byte,
            Option::None => 0,
        };
        if sym_byte(in loader, sym, i) != byte {
            return false;
        }
    }
    true
}

// The offset of the first `::` in `sym`, or its length when it has none.
pub fn sym_path_split(in loader: St, sym: u32) -> u64 {
    let len = sym_len(in loader, sym);
    let mut i: u64 = 0;
    loop {
        if inc(i) >= len {
            break len;
        }
        if sym_byte(in loader, sym, i) == 58 && sym_byte(in loader, sym, inc(i)) == 58 {
            break i;
        }
        i = inc(i);
    }
}

// Symbol of bytes `a..b` of `sym`.
pub fn sym_slice(inout loader: St, sym: u32, from: u64, to: u64) -> u32 {
    let (start, end) = sym_range(in loader, sym);
    let abs_from = wrapping_add(start, from);
    let mut abs_to = wrapping_add(start, to);
    if abs_to > end {
        abs_to = end;
    }
    let rel_from = wrapping_sub(abs_from, start);
    let rel_to = wrapping_sub(abs_to, start);
    match loader.interner.lookup_span(symbol_from_id(sym), rel_from, rel_to) {
        Option::Some(found) => {
            return found.id();
        },
        Option::None => {},
    }
    let mut text = String::new();
    loader.interner.resolve_into(symbol_from_id(sym), inout text);
    intern_str(inout loader, in text[rel_from..rel_to])
}

// Whether two symbols' texts are in byte order `a < b` (Rust's `String`
// order, which `BTreeMap` keys iterate in).
pub fn sym_less(in loader: St, a: u32, b: u32) -> bool {
    let a_len = sym_len(in loader, a);
    let b_len = sym_len(in loader, b);
    let mut i: u64 = 0;
    loop {
        if i >= a_len || i >= b_len {
            break a_len < b_len;
        }
        let a_byte = sym_byte(in loader, a, i);
        let b_byte = sym_byte(in loader, b, i);
        if a_byte != b_byte {
            break a_byte < b_byte;
        }
        i = inc(i);
    }
}

// Whether `needle` occurs in `sym` (one pass over the interner's text; the
// renamer asks for every new name).
pub fn sym_contains(in loader: St, sym: u32, in needle: Str) -> bool {
    let (start, end) = sym_range(in loader, sym);
    let needle_len = needle.len();
    if needle_len == 0 || wrapping_sub(end, start) < needle_len {
        return false;
    }
    let text = loader.interner.text.as_bytes();
    let needle_bytes = needle.as_bytes();
    let first_byte = match needle_bytes.try_get(0) {
        Option::Some(byte) => byte,
        Option::None => 0,
    };
    let last = wrapping_sub(end, needle_len);
    let mut i = start;
    loop {
        if i > last {
            break false;
        }
        let byte = match text.try_get(i) {
            Option::Some(byte) => byte,
            Option::None => 0,
        };
        if byte == first_byte {
            let mut j: u64 = 1;
            let found = loop {
                if j >= needle_len {
                    break true;
                }
                let text_byte = match text.try_get(wrapping_add(i, j)) {
                    Option::Some(text_byte) => text_byte,
                    Option::None => 0,
                };
                let needle_byte = match needle_bytes.try_get(j) {
                    Option::Some(needle_byte) => needle_byte,
                    Option::None => 0,
                };
                if text_byte != needle_byte {
                    break false;
                }
                j = inc(j);
            };
            if found {
                break true;
            }
        }
        i = inc(i);
    }
}

// The prefix of a module constant's function (`CONST_PREFIX`).
pub fn const_prefix() -> Str {
    "const$"
}

// `const$` followed by the text of `sym`.
pub fn const_of(inout loader: St, sym: u32) -> u32 {
    let mut text = String::new();
    text.push_str(in const_prefix());
    loader.interner.resolve_into(symbol_from_id(sym), inout text);
    intern_str(inout loader, in text)
}

// `a::b`.
pub fn join_path(inout loader: St, head: u32, tail: u32) -> u32 {
    let mut text = String::new();
    loader.interner.resolve_into(symbol_from_id(head), inout text);
    text.push_str(in "::");
    loader.interner.resolve_into(symbol_from_id(tail), inout text);
    intern_str(inout loader, in text)
}

// `is_const_function`: `const$NAME`, or one renamed into a package
// (`{scope}__{package}__{module}__const$NAME`).
pub fn is_const_function(in loader: St, sym: u32) -> bool {
    sym_starts(in loader, sym, in const_prefix()) || sym_contains(in loader, sym, in "__const$")
}

// Bit 0: `sym` contains `const$`; bit 1: it is a constant's function
// (`is_const_function`). Cached per symbol: the renamer asks for every
// name expression.
pub fn const_flags(inout loader: St, sym: u32) -> u8 {
    let index = w(sym);
    let cached = at8(in loader.const_flag, index);
    if cached != 0 {
        return cached & 3;
    }
    let mut flags: u8 = 0;
    if sym_contains(in loader, sym, in const_prefix()) {
        flags = 1;
        if is_const_function(in loader, sym) {
            flags = 3;
        }
    }
    if index >= loader.const_flag.len() {
        loader.const_flag.resize(inc(index), 0);
    }
    loader.const_flag.try_set(index, flags | 4);
    flags
}

// ---------------------------------------------------------------- output

pub fn put(inout out: ChunkSeq[u8], in text: Str) {
    out.extend(in text.as_bytes());
}

pub fn put_string(inout out: ChunkSeq[u8], in text: String) {
    out.extend(in text.as_bytes());
}

pub fn put_decimal(inout out: ChunkSeq[u8], value: u64) {
    if value >= 10 {
        put_decimal(inout out, value / 10);
    }
    out.push(wrapping_u8(wrapping_add(value % 10, 48)));
}

pub fn push_decimal(inout out: String, value: u64) {
    if value >= 10 {
        push_decimal(inout out, value / 10);
    }
    out.push_char(wrapping_u32(wrapping_add(value % 10, 48)));
}

pub fn put_sym(inout out: ChunkSeq[u8], in names: Interner, sym: u32) {
    let (start, end) = names.span(symbol_from_id(sym));
    for i in start..end {
        match names.text_byte(i) {
            Option::Some(byte) => out.push(byte),
            Option::None => {},
        }
    }
}

// ---------------------------------------------------------------- modules

pub fn mod_hash(pkg: u32, in path: ChunkSeq[u32]) -> u64 {
    let mut hash: u64 = 14695981039346656037;
    hash = wrapping_mul(hash ^ widen_u64(pkg), 1099511628211);
    for i in 0..path.len() {
        hash = wrapping_mul(hash ^ widen_u64(at32(in path, i)), 1099511628211);
    }
    hash
}

// Whether `module` is package `pkg`'s module `path`.
pub fn mod_is(in loader: St, module: u32, pkg: u32, in path: ChunkSeq[u32]) -> bool {
    if at32(in loader.mod_pkg, w(module)) != pkg {
        return false;
    }
    let len = w(at32(in loader.mod_seg_len, w(module)));
    if len != path.len() {
        return false;
    }
    let first = w(at32(in loader.mod_seg_first, w(module)));
    for i in 0..len {
        if at32(in loader.segments, wrapping_add(first, i)) != at32(in path, i) {
            return false;
        }
    }
    true
}

// The module `path` of package `pkg`, or `none()` (`tables.contains_key`).
pub fn find_module(in loader: St, pkg: u32, in path: ChunkSeq[u32]) -> u32 {
    match loader.mod_index.get(mod_hash(pkg, in path)) {
        Option::Some(module) => {
            if mod_is(in loader, module, pkg, in path) {
                return module;
            }
        },
        Option::None => {
            if !loader.mod_collide {
                return none();
            }
        },
    }
    if !loader.mod_collide {
        return none();
    }
    for module in 0..loader.mod_pkg.len() {
        if mod_is(in loader, n32(module), pkg, in path) {
            return n32(module);
        }
    }
    none()
}

// The path of `module`, appended to `out`.
pub fn mod_path_into(in loader: St, module: u32, inout out: ChunkSeq[u32]) {
    let first = w(at32(in loader.mod_seg_first, w(module)));
    let len = w(at32(in loader.mod_seg_len, w(module)));
    for i in 0..len {
        out.push(at32(in loader.segments, wrapping_add(first, i)));
    }
}

pub fn mod_path_len(in loader: St, module: u32) -> u64 {
    w(at32(in loader.mod_seg_len, w(module)))
}

pub fn mod_seg(in loader: St, module: u32, i: u64) -> u32 {
    at32(in loader.segments, wrapping_add(w(at32(in loader.mod_seg_first, w(module))), i))
}

// ---------------------------------------------------------------- errors

// Starts an error (`Diagnostic::new(code, ..)`); the caller writes the
// message into `loader.err_msg`.
pub fn err(inout loader: St, code: u32, start: u32, end: u32) {
    loader.err_code = code;
    loader.err_msg.clear();
    loader.err_help.clear();
    loader.err_has_help = false;
    loader.err_start = start;
    loader.err_end = end;
}

fn original_position(in loader: St, file: u32, position: u64, at_end: bool) -> u64 {
    let probe = if at_end && position != 0 {
        wrapping_sub(position, 1)
    } else {
        position
    };
    for i in 0..loader.source_segments.len() {
        match loader.source_segments.try_get(i) {
            Option::Some(segment) => {
                if segment.file == file
                    && segment.generated_start <= probe
                    && probe < segment.generated_end
                {
                    if segment.copied {
                        let mapped = wrapping_add(
                            segment.source_start,
                            wrapping_sub(position, segment.generated_start)
                        );
                        return if mapped > segment.source_end {
                            segment.source_end
                        } else {
                            mapped
                        };
                    }
                    return if at_end {
                        segment.source_end
                    } else {
                        segment.source_start
                    };
                }
            },
            Option::None => {},
        }
    }
    position
}

// Writes the pending error as a diagnostic of `file`, one line:
// `diag <file> E0<code> <start>..<end> <message>[ help: <help>]`.
pub fn emit(inout loader: St, file: u32) {
    let start = original_position(in loader, file, w(loader.err_start), false);
    let mapped_end = if loader.err_start == loader.err_end {
        start
    } else {
        original_position(in loader, file, w(loader.err_end), true)
    };
    let end = if mapped_end < start {
        start
    } else {
        mapped_end
    };
    loader.diag_rows.push(w(file));
    loader.diag_rows.push(w(loader.err_code));
    loader.diag_rows.push(start);
    loader.diag_rows.push(end);
    loader.diag_rows.push(loader.err_msg.len());
    loader.diag_text.extend(in loader.err_msg.as_bytes());
    if loader.err_has_help {
        loader.diag_rows.push(loader.err_help.len());
        loader.diag_text.extend(in loader.err_help.as_bytes());
    } else {
        loader.diag_rows.push(18446744073709551615);
    }
    loader.diags.extend(in "diag ".as_bytes());
    put_decimal(inout loader.diags, w(file));
    loader.diags.extend(in " E0".as_bytes());
    put_decimal(inout loader.diags, w(loader.err_code));
    loader.diags.push(32);
    put_decimal(inout loader.diags, start);
    loader.diags.extend(in "..".as_bytes());
    put_decimal(inout loader.diags, end);
    loader.diags.push(32);
    loader.diags.extend(in loader.err_msg.as_bytes());
    if loader.err_has_help {
        loader.diags.extend(in " help: ".as_bytes());
        loader.diags.extend(in loader.err_help.as_bytes());
    }
    loader.diags.push(10);
    loader.err_code = 0;
}

test {
    fn test_diagnostics_project_bootstrap_source_ranges() -> bool {
        let mut loader = st_new();
        loader.source_segments.push(SourceSegment {
            file: 0,
            generated_start: 20,
            generated_end: 40,
            source_start: 12,
            source_end: 15,
            copied: false
        });
        loader.source_segments.push(SourceSegment {
            file: 0,
            generated_start: 40,
            generated_end: 50,
            source_start: 15,
            source_end: 25,
            copied: true
        });
        original_position(in loader, 0, 25, false) == 12
            && original_position(in loader, 0, 40, true) == 15
            && original_position(in loader, 0, 43, false) == 18
            && original_position(in loader, 1, 43, false) == 43
    }
}
