// Module stack_bound of @vesper/backend-checks (see lib.ves): the shared
// worst-case stack analysis of src/stack_bound.rs (`stack_bound_report`
// for Cranelift graphs, `render`) and the analysis it runs,
// `vesper_silicon::stack::analyze_stack` (crates/vesper-silicon/src/stack.rs).
//
// Word-level, so other ports can reuse it (SH4 lane 16 wraps it with the
// eBPF-origin checks): build a `StackGraph` and a `StackPol`, call
// `analyze_stack`, read the rows it appends to a `Report` (input.ves):
//
// - `sr`: per policy root, in policy order: root, budget, has worst case,
//   worst case, within budget, worst path (at, n in `spool`);
// - `sf`: findings in Rust order: function, has inst, inst, rule (at, len)
//   and message (at, len) in `text`.
//
// Names are `Names` symbols; `analyze_stack` interns nothing.

use @vesper/check-data::names::{Names};
use self::input::{Report};
use self::util::{cmp_names, filled, g, put, putn, puts, st};

const NONE: u64 = 18446744073709551615;

pub struct StackGraph {
    // per function: name, frame bytes (ids are positions)
    pub names: ChunkSeq[u64],
    pub frames: ChunkSeq[u64],
    // (caller, callee)
    pub calls: ChunkSeq[u64],
    // (caller, instruction)
    pub indirect: ChunkSeq[u64],
    // (caller, symbol, has inst, inst)
    pub external: ChunkSeq[u64],
}

pub fn graph_new() -> StackGraph {
    StackGraph {
        names: ChunkSeq::new[u64](),
        frames: ChunkSeq::new[u64](),
        calls: ChunkSeq::new[u64](),
        indirect: ChunkSeq::new[u64](),
        external: ChunkSeq::new[u64](),
    }
}

pub struct StackPol {
    // (function, budget) in policy order
    pub roots: ChunkSeq[u64],
    // (symbol, bytes) in symbol order
    pub external_bounds: ChunkSeq[u64],
    // (caller, at, n) over `targets`, caller order
    pub indirect_targets: ChunkSeq[u64],
    pub targets: ChunkSeq[u64],
}

pub fn pol_new() -> StackPol {
    StackPol {
        roots: ChunkSeq::new[u64](),
        external_bounds: ChunkSeq::new[u64](),
        indirect_targets: ChunkSeq::new[u64](),
        targets: ChunkSeq::new[u64](),
    }
}

pub const RULE_RECURSION: Str = "silicon.stack.recursion";
pub const RULE_INDIRECT: Str = "silicon.stack.unresolved_indirect_call";
pub const RULE_EXTERNAL: Str = "silicon.stack.unbounded_external_call";
pub const RULE_BUDGET: Str = "silicon.stack.budget_exceeded";
pub const RULE_UNKNOWN_ROOT: Str = "silicon.stack.unknown_root";
pub const RULE_UNKNOWN_TARGET: Str = "silicon.stack.unknown_indirect_target";

// A finding whose message is `report.text[msg..]`.
fn finding(inout report: Report, function: u64, has_inst: bool, inst: u64, in rule: Str, msg: u64) {
    let msg_len = wrapping_sub(report.text.len(), msg);
    let rule_at = report.text.len();
    put(inout report.text, rule);
    report.sf.push(function);
    if has_inst {
        report.sf.push(1);
    } else {
        report.sf.push(0);
    }
    report.sf.push(inst);
    report.sf.push(rule_at);
    report.sf.push(wrapping_sub(report.text.len(), rule_at));
    report.sf.push(msg);
    report.sf.push(msg_len);
}

// The value bound to `key` in (key, value) rows, or NONE.
fn lookup2(in rows: ChunkSeq[u64], key: u64) -> u64 {
    let n = rows.len() / 2;
    for i in 0..n {
        if g(in rows, wrapping_mul(i, 2)) == key {
            return g(in rows, wrapping_add(wrapping_mul(i, 2), 1));
        }
    }
    NONE
}

// `Succ` order: functions by id, then bounded symbols by (name, bytes).
fn succ_less(in names: Names, kind_a: u64, a1: u64, a2: u64, kind_b: u64, b1: u64, b2: u64) -> i64 {
    if kind_a != kind_b {
        if kind_a < kind_b {
            return -1;
        }
        return 1;
    }
    if kind_a == 0 {
        if a1 < b1 {
            return -1;
        }
        if a1 > b1 {
            return 1;
        }
        return 0;
    }
    let order = cmp_names(in names, a1, b1);
    if order != 0 {
        return order;
    }
    if a2 < b2 {
        return -1;
    }
    if a2 > b2 {
        return 1;
    }
    0
}

// Inserts (kind, a, b) into caller `v`'s sorted set; rows of 3 words in
// `succ[start[v]..]`, kept per caller in `lists` (one ChunkSeq per caller
// is not available, so callers own slices of a flat table rebuilt below).
fn set_add(in names: Names, inout set: ChunkSeq[u64], kind: u64, a: u64, b: u64) {
    let n = set.len() / 3;
    let mut at = n;
    for i in 0..n {
        let order = succ_less(
            in names,
            kind,
            a,
            b,
            g(in set, wrapping_mul(i, 3)),
            g(in set, wrapping_add(wrapping_mul(i, 3), 1)),
            g(in set, wrapping_add(wrapping_mul(i, 3), 2))
        );
        if order == 0 {
            return;
        }
        if order < 0 && at == n {
            at = i;
        }
    }
    set.resize(wrapping_add(set.len(), 3), 0);
    let mut i = n;
    loop {
        if i <= at {
            break;
        }
        i = wrapping_sub(i, 1);
        for w in 0..3 {
            st(
                inout set,
                wrapping_add(wrapping_mul(wrapping_add(i, 1), 3), w),
                g(in set, wrapping_add(wrapping_mul(i, 3), w))
            );
        }
    }
    st(inout set, wrapping_mul(at, 3), kind);
    st(inout set, wrapping_add(wrapping_mul(at, 3), 1), a);
    st(inout set, wrapping_add(wrapping_mul(at, 3), 2), b);
}

// Successor sets of all functions: `pending` collects (caller, kind, a, b)
// in insertion order; `build` turns it into per-caller sorted rows.
struct Succ {
    start: ChunkSeq[u64],
    rows: ChunkSeq[u64],
}

fn build_succ(in names: Names, n: u64, in pending: ChunkSeq[u64]) -> Succ {
    let mut start = filled(wrapping_add(n, 1), 0);
    let mut rows: ChunkSeq[u64] = ChunkSeq::new[u64]();
    // Callers in id order; each caller's entries in insertion order.
    let count = pending.len() / 4;
    let mut caller_start: ChunkSeq[u64] = filled(wrapping_add(n, 1), 0);
    for e in 0..count {
        let caller = g(in pending, wrapping_mul(e, 4));
        st(
            inout caller_start,
            wrapping_add(caller, 1),
            wrapping_add(g(in caller_start, wrapping_add(caller, 1)), 1)
        );
    }
    for v in 0..n {
        st(
            inout caller_start,
            wrapping_add(v, 1),
            wrapping_add(g(in caller_start, wrapping_add(v, 1)), g(in caller_start, v))
        );
    }
    let mut order = filled(count, 0);
    let mut fill = filled(n, 0);
    for e in 0..count {
        let caller = g(in pending, wrapping_mul(e, 4));
        let slot = wrapping_add(g(in caller_start, caller), g(in fill, caller));
        st(inout order, slot, e);
        st(inout fill, caller, wrapping_add(g(in fill, caller), 1));
    }
    for v in 0..n {
        st(inout start, v, rows.len() / 3);
        let mut set: ChunkSeq[u64] = ChunkSeq::new[u64]();
        for k in g(in caller_start, v)..g(in caller_start, wrapping_add(v, 1)) {
            let entry_at = wrapping_mul(g(in order, k), 4);
            set_add(
                in names,
                inout set,
                g(in pending, wrapping_add(entry_at, 1)),
                g(in pending, wrapping_add(entry_at, 2)),
                g(in pending, wrapping_add(entry_at, 3))
            );
        }
        rows.extend(in set.as_slice());
    }
    st(inout start, n, rows.len() / 3);
    Succ { start: start, rows: rows }
}

fn push4(inout seq: ChunkSeq[u64], a: u64, b: u64, c: u64, d: u64) {
    seq.push(a);
    seq.push(b);
    seq.push(c);
    seq.push(d);
}

// Tarjan's strongly connected components over the function successors of
// `succ` (iterative, as stack.rs's `tarjan`). Returns the components
// flattened: `comp` holds members sorted, `comp_start` the bounds.
fn tarjan(n: u64, in succ: Succ, inout comp: ChunkSeq[u64], inout comp_start: ChunkSeq[u64]) {
    let mut index = filled(n, NONE);
    let mut low = filled(n, 0);
    let mut on_stack = filled(n, 0);
    let mut stack: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut next_index: u64 = 0;
    comp_start.push(0);
    for start in 0..n {
        if g(in index, start) != NONE {
            continue;
        }
        // (v, child) frames; child counts function successors only.
        let mut work: ChunkSeq[u64] = ChunkSeq::new[u64]();
        work.push(start);
        work.push(0);
        loop {
            let top = work.len();
            if top == 0 {
                break;
            }
            let v = g(in work, wrapping_sub(top, 2));
            let child = g(in work, wrapping_sub(top, 1));
            if child == 0 && g(in index, v) == NONE {
                st(inout index, v, next_index);
                st(inout low, v, next_index);
                next_index = wrapping_add(next_index, 1);
                stack.push(v);
                st(inout on_stack, v, 1);
            }
            // The child-th function successor of v.
            let mut target = NONE;
            let mut seen: u64 = 0;
            for k in g(in succ.start, v)..g(in succ.start, wrapping_add(v, 1)) {
                if target == NONE && g(in succ.rows, wrapping_mul(k, 3)) == 0 {
                    if seen == child {
                        target = g(in succ.rows, wrapping_add(wrapping_mul(k, 3), 1));
                    }
                    seen = wrapping_add(seen, 1);
                }
            }
            if target != NONE {
                st(inout work, wrapping_sub(top, 1), wrapping_add(child, 1));
                if g(in index, target) == NONE {
                    work.push(target);
                    work.push(0);
                } else if g(in on_stack, target) == 1 {
                    let target_index = g(in index, target);
                    if target_index < g(in low, v) {
                        st(inout low, v, target_index);
                    }
                }
                continue;
            }
            work.truncate(wrapping_sub(top, 2));
            if work.len() > 0 {
                let parent = g(in work, wrapping_sub(work.len(), 2));
                if g(in low, v) < g(in low, parent) {
                    st(inout low, parent, g(in low, v));
                }
            }
            if g(in low, v) == g(in index, v) {
                let from = comp.len();
                loop {
                    let stack_len = stack.len();
                    if stack_len == 0 {
                        break;
                    }
                    let member = g(in stack, wrapping_sub(stack_len, 1));
                    stack.truncate(wrapping_sub(stack_len, 1));
                    st(inout on_stack, member, 0);
                    comp.push(member);
                    if member == v {
                        break;
                    }
                }
                // sort the component (insertion sort)
                let to = comp.len();
                let mut i = wrapping_add(from, 1);
                loop {
                    if i >= to {
                        break;
                    }
                    let member = g(in comp, i);
                    let mut j = i;
                    loop {
                        if j <= from || g(in comp, wrapping_sub(j, 1)) <= member {
                            break;
                        }
                        st(inout comp, j, g(in comp, wrapping_sub(j, 1)));
                        j = wrapping_sub(j, 1);
                    }
                    st(inout comp, j, member);
                    i = wrapping_add(i, 1);
                }
                comp_start.push(comp.len());
            }
        }
    }
}

// `analyze_stack(graph, policy)`: findings and root rows into `report`.
pub fn analyze_stack(
    in names: Names,
    in graph: StackGraph,
    in policy: StackPol,
    inout report: Report
) {
    let n = graph.names.len();
    // name -> id: the last function with that name (`HashMap` collect).
    let mut pending: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut unbounded = filled(n, 0);
    for e in 0..graph.calls.len() / 2 {
        push4(
            inout pending,
            g(in graph.calls, wrapping_mul(e, 2)),
            0,
            g(in graph.calls, wrapping_add(wrapping_mul(e, 2), 1)),
            0
        );
    }
    for e in 0..graph.external.len() / 4 {
        let base = wrapping_mul(e, 4);
        let caller = g(in graph.external, base);
        let sym = g(in graph.external, wrapping_add(base, 1));
        let bytes = lookup2(in policy.external_bounds, sym);
        if bytes != NONE {
            push4(inout pending, caller, 1, sym, bytes);
        } else {
            st(inout unbounded, caller, 1);
            let message_at = report.text.len();
            put(inout report.text, "call to `");
            puts(inout report.text, in names, sym);
            put(
                inout report.text,
                "` has no declared stack bound; list it in StackPolicy::external_bounds"
            );
            finding(
                inout report,
                g(in graph.names, caller),
                g(in graph.external, wrapping_add(base, 2)) == 1,
                g(in graph.external, wrapping_add(base, 3)),
                RULE_EXTERNAL,
                message_at
            );
        }
    }
    for e in 0..graph.indirect.len() / 2 {
        let caller = g(in graph.indirect, wrapping_mul(e, 2));
        let inst = g(in graph.indirect, wrapping_add(wrapping_mul(e, 2), 1));
        let caller_name = g(in graph.names, caller);
        let mut row = NONE;
        for t in 0..policy.indirect_targets.len() / 3 {
            if row == NONE && g(in policy.indirect_targets, wrapping_mul(t, 3)) == caller_name {
                row = t;
            }
        }
        if row == NONE {
            st(inout unbounded, caller, 1);
            let message_at = report.text.len();
            put(inout report.text, "indirect call without a policy-listed target set");
            finding(inout report, caller_name, true, inst, RULE_INDIRECT, message_at);
        } else {
            let targets_at = g(in policy.indirect_targets, wrapping_add(wrapping_mul(row, 3), 1));
            let target_count = g(in policy.indirect_targets, wrapping_add(wrapping_mul(row, 3), 2));
            for q in 0..target_count {
                let target = g(in policy.targets, wrapping_add(targets_at, q));
                let mut id = NONE;
                for f in 0..n {
                    if g(in graph.names, f) == target {
                        id = f;
                    }
                }
                if id != NONE {
                    push4(inout pending, caller, 0, id, 0);
                } else {
                    let bytes = lookup2(in policy.external_bounds, target);
                    if bytes != NONE {
                        push4(inout pending, caller, 1, target, bytes);
                    } else {
                        st(inout unbounded, caller, 1);
                        let message_at = report.text.len();
                        put(inout report.text, "indirect target `");
                        puts(inout report.text, in names, target);
                        put(inout report.text, "` is neither defined nor bounded");
                        finding(
                            inout report,
                            caller_name,
                            true,
                            inst,
                            RULE_UNKNOWN_TARGET,
                            message_at
                        );
                    }
                }
            }
        }
    }
    let succ = build_succ(in names, n, in pending);
    let mut comp: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut comp_start: ChunkSeq[u64] = ChunkSeq::new[u64]();
    tarjan(n, in succ, inout comp, inout comp_start);
    let comp_count = wrapping_sub(comp_start.len(), 1);
    let mut cyclic = filled(n, 0);
    for ci in 0..comp_count {
        let lo = g(in comp_start, ci);
        let hi = g(in comp_start, wrapping_add(ci, 1));
        let first = g(in comp, lo);
        let mut is_cycle = wrapping_sub(hi, lo) > 1;
        if !is_cycle {
            for k in g(in succ.start, first)..g(in succ.start, wrapping_add(first, 1)) {
                if g(in succ.rows, wrapping_mul(k, 3)) == 0
                    && g(in succ.rows, wrapping_add(wrapping_mul(k, 3), 1)) == first {
                    is_cycle = true;
                }
            }
        }
        if is_cycle {
            let message_at = report.text.len();
            put(inout report.text, "recursive call cycle among {");
            for k in lo..hi {
                let v = g(in comp, k);
                st(inout cyclic, v, 1);
                if k > lo {
                    put(inout report.text, ", ");
                }
                puts(inout report.text, in names, g(in graph.names, v));
            }
            put(inout report.text, "}");
            finding(inout report, g(in graph.names, first), false, 0, RULE_RECURSION, message_at);
        }
    }
    // depth (has, value) and best successor row per function
    let mut has_depth = filled(n, 0);
    let mut depth = filled(n, 0);
    let mut best = filled(n, NONE);
    for ci in 0..comp_count {
        for k in g(in comp_start, ci)..g(in comp_start, wrapping_add(ci, 1)) {
            let v = g(in comp, k);
            if g(in cyclic, v) == 0 && g(in unbounded, v) == 0 {
                let mut deepest: u64 = 0;
                let mut pick = NONE;
                let mut ok = true;
                for q in g(in succ.start, v)..g(in succ.start, wrapping_add(v, 1)) {
                    if ok {
                        let kind = g(in succ.rows, wrapping_mul(q, 3));
                        let succ_id = g(in succ.rows, wrapping_add(wrapping_mul(q, 3), 1));
                        let mut succ_depth: u64 = 0;
                        if kind == 0 {
                            if g(in has_depth, succ_id) == 0 {
                                ok = false;
                            } else {
                                succ_depth = g(in depth, succ_id);
                            }
                        } else {
                            succ_depth = g(in succ.rows, wrapping_add(wrapping_mul(q, 3), 2));
                        }
                        if ok && (pick == NONE || succ_depth > deepest) {
                            deepest = succ_depth;
                            pick = q;
                        }
                    }
                }
                if ok {
                    st(inout has_depth, v, 1);
                    st(inout depth, v, wrapping_add(g(in graph.frames, v), deepest));
                    st(inout best, v, pick);
                }
            }
        }
    }
    for ri in 0..policy.roots.len() / 2 {
        let root = g(in policy.roots, wrapping_mul(ri, 2));
        let budget = g(in policy.roots, wrapping_add(wrapping_mul(ri, 2), 1));
        let mut id = NONE;
        for f in 0..n {
            if g(in graph.names, f) == root {
                id = f;
            }
        }
        if id == NONE {
            let message_at = report.text.len();
            put(inout report.text, "stack root is not a function of this program");
            finding(inout report, root, false, 0, RULE_UNKNOWN_ROOT, message_at);
            report.sr.push(root);
            report.sr.push(budget);
            report.sr.push(0);
            report.sr.push(0);
            report.sr.push(0);
            report.sr.push(report.spool.len());
            report.sr.push(0);
            continue;
        }
        let has_worst = g(in has_depth, id) == 1;
        let worst = g(in depth, id);
        let path_at = report.spool.len();
        if has_worst {
            let mut cur = id;
            loop {
                report.spool.push(g(in graph.names, cur));
                let q = g(in best, cur);
                if q == NONE {
                    break;
                }
                let kind = g(in succ.rows, wrapping_mul(q, 3));
                let succ_id = g(in succ.rows, wrapping_add(wrapping_mul(q, 3), 1));
                if kind == 1 {
                    report.spool.push(succ_id);
                    break;
                }
                cur = succ_id;
            }
        }
        let path_len = wrapping_sub(report.spool.len(), path_at);
        let within = has_worst && worst <= budget;
        if has_worst && !within {
            let message_at = report.text.len();
            put(inout report.text, "worst-case stack ");
            putn(inout report.text, worst);
            put(inout report.text, " bytes exceeds @stack_limit(");
            putn(inout report.text, budget);
            put(inout report.text, ") along ");
            for k in 0..path_len {
                if k > 0 {
                    put(inout report.text, " -> ");
                }
                puts(inout report.text, in names, g(in report.spool, wrapping_add(path_at, k)));
            }
            finding(inout report, root, false, 0, RULE_BUDGET, message_at);
        } else if !has_worst {
            let message_at = report.text.len();
            put(
                inout report.text,
                "worst-case stack depth is unbounded (recursion or unresolved call reachable)"
            );
            finding(inout report, root, false, 0, RULE_BUDGET, message_at);
        }
        report.sr.push(root);
        report.sr.push(budget);
        if has_worst {
            report.sr.push(1);
        } else {
            report.sr.push(0);
        }
        report.sr.push(worst);
        if within {
            report.sr.push(1);
        } else {
            report.sr.push(0);
        }
        report.sr.push(path_at);
        report.sr.push(path_len);
    }
    report.has_stack = true;
}

// `stack_bound::render`: one line per root.
pub fn render(in names: Names, in report: Report, inout out: ChunkSeq[u8]) {
    for ri in 0..report.sr.len() / 7 {
        let base = wrapping_mul(ri, 7);
        put(inout out, "stack ");
        puts(inout out, in names, g(in report.sr, base));
        put(inout out, ": worst case ");
        if g(in report.sr, wrapping_add(base, 2)) == 1 {
            putn(inout out, g(in report.sr, wrapping_add(base, 3)));
            put(inout out, " bytes");
        } else {
            put(inout out, "unbounded");
        }
        put(inout out, " of ");
        putn(inout out, g(in report.sr, wrapping_add(base, 1)));
        put(inout out, " byte budget (");
        if g(in report.sr, wrapping_add(base, 4)) == 1 {
            put(inout out, "ok");
        } else {
            put(inout out, "exceeded");
        }
        put(inout out, ") via ");
        let path_at = g(in report.sr, wrapping_add(base, 5));
        let path_len = g(in report.sr, wrapping_add(base, 6));
        if path_len == 0 {
            put(inout out, "-");
        }
        for k in 0..path_len {
            if k > 0 {
                put(inout out, " -> ");
            }
            puts(inout out, in names, g(in report.spool, wrapping_add(path_at, k)));
        }
        put(inout out, "\n");
    }
}
