// Module detfloat of @vesper/backend-checks (see lib.ves): Kinetic's
// DetFloat audit of crates/vesper-kinetic/src/detfloat.rs (`audit`) over
// one emitted function's CLIF tables: fused multiply-adds and float calls,
// horizontal reduction order, and NaN escapes. Instruction indices in
// findings are layout positions.
//
// Reduction shapes are trees in `Sh` (leaf: lane; node: two children), and
// a lane tree is memoized per value as a row of `Lt`.

use @vesper/check-data::names::{Names};
use self::input::{Cx, arg, block_row, ent_row, fw, iw, nargs, pw, val};
use self::report::{raw_finding};
use self::util::{contains, filled, g, put, putn, puts, spells, st};

const EXT_KNOWN: u64 = 3;
const EXT_LIBCALL: u64 = 2;
const EXT_TESTCASE: u64 = 1;
const EXT_USER: u64 = 0;
const F_INSTS: u64 = 33;
const F_NINSTS: u64 = 34;
const F_NVALS: u64 = 28;
const I_ARGS: u64 = 5;
const I_CALL: u64 = 15;
const I_CONST: u64 = 13;
const I_CONST_LEN: u64 = 12;
const I_COND: u64 = 11;
const I_DESTS: u64 = 21;
const I_EXT: u64 = 19;
const I_FLAGS: u64 = 2;
const I_FMT: u64 = 3;
const I_IMM: u64 = 10;
const I_OP: u64 = 1;
const I_RESULTS: u64 = 7;
const IS_CALL: u64 = 1;
const I_SIG_FLOAT: u64 = 18;
const X_INDEX: u64 = 2;
const X_KIND: u64 = 0;
const X_NS: u64 = 1;
const X_S1: u64 = 4;
const X_S2: u64 = 5;
const BA_VALUE: u64 = 0;
const CALL_DIRECT: u64 = 1;
const CALL_INDIRECT: u64 = 2;
const CC_EQUAL: u64 = 4;
const CC_NOT_EQUAL: u64 = 2;
const CC_ORDERED: u64 = 3;
const CC_UNORDERED: u64 = 1;
const FMT_BINARY: u64 = 14;
const FMT_BINARY_IMM8: u64 = 13;
const FMT_FLOAT_COMPARE: u64 = 19;
const FMT_LOAD_NO_OFFSET: u64 = 2;
const FMT_UNARY: u64 = 17;
const FMT_UNARY_CONST: u64 = 18;
const FMT_UNARY_IEEE32: u64 = 15;
const FMT_UNARY_IEEE64: u64 = 16;
const OP_ATOMIC_STORE: u64 = 37;
const OP_BITCAST: u64 = 35;
const OP_BITSELECT: u64 = 31;
const OP_CEIL: u64 = 20;
const OP_EXTRACTLANE: u64 = 28;
const OP_FADD: u64 = 13;
const OP_FDEMOTE: u64 = 25;
const OP_FDIV: u64 = 16;
const OP_FLOOR: u64 = 21;
const OP_FMA: u64 = 12;
const OP_FMAX: u64 = 19;
const OP_FMIN: u64 = 18;
const OP_FMUL: u64 = 15;
const OP_FPROMOTE: u64 = 24;
const OP_FSUB: u64 = 14;
const OP_FVDEMOTE: u64 = 26;
const OP_FVPROMOTE_LOW: u64 = 27;
const OP_NEAREST: u64 = 23;
const OP_RETURN: u64 = 38;
const OP_SCALAR_TO_VECTOR: u64 = 33;
const OP_SELECT: u64 = 29;
const OP_SELECT_SPECTRE_GUARD: u64 = 30;
const OP_SPLAT: u64 = 32;
const OP_SQRT: u64 = 17;
const OP_STACK_STORE: u64 = 9;
const OP_STORE: u64 = 36;
const OP_TRUNC: u64 = 22;
const OP_VCONST: u64 = 34;
const NONE: u64 = 18446744073709551615;

// `audit`'s policy: `allowed` holds names; `user` maps func id -> name + 1.
pub struct DetPolicy {
    allow_fma: bool,
    allowed: ChunkSeq[u64],
    canonicalizes: bool,
    sequential: bool,
}

fn is_float(ty: u64) -> bool {
    (ty >> 40) & 1 == 1
}

fn lanes(ty: u64) -> u64 {
    (ty >> 16) & 65535
}

fn lane_bits(ty: u64) -> u64 {
    ty & 65535
}

// The libcall of a direct call row, as its name symbol, or NONE.
fn libcall(in ctx: Cx, row: u64) -> u64 {
    if iw(in ctx, row, I_CALL) != CALL_DIRECT {
        return NONE;
    }
    let ext_at = iw(in ctx, row, I_EXT);
    if pw(in ctx, wrapping_add(ext_at, X_KIND)) != EXT_LIBCALL {
        return NONE;
    }
    pw(in ctx, wrapping_add(ext_at, X_S1))
}

fn is_fma_libcall(in names: Names, sym: u64) -> bool {
    spells(in names, sym, "FmaF32") || spells(in names, sym, "FmaF64")
}

fn is_rounding_libcall(in names: Names, sym: u64) -> bool {
    spells(in names, sym, "CeilF32")
        || spells(in names, sym, "CeilF64")
        || spells(in names, sym, "FloorF32")
        || spells(in names, sym, "FloorF64")
        || spells(in names, sym, "TruncF32")
        || spells(in names, sym, "TruncF64")
        || spells(in names, sym, "NearestF32")
        || spells(in names, sym, "NearestF64")
}

// `callee_name`: the name of a direct callee as the audit sees it.
fn callee_name(inout ctx: Cx, row: u64, in by_id: ChunkSeq[u64]) -> u64 {
    let ext_at = iw(in ctx, row, I_EXT);
    let kind = pw(in ctx, wrapping_add(ext_at, X_KIND));
    if kind == EXT_USER {
        let ns = pw(in ctx, wrapping_add(ext_at, X_NS));
        let index = pw(in ctx, wrapping_add(ext_at, X_INDEX));
        if ns == 0 && g(in by_id, index) != 0 {
            return wrapping_sub(g(in by_id, index), 1);
        }
        let at = ctx.report.text.len();
        put(inout ctx.report.text, "u");
        putn(inout ctx.report.text, ns);
        put(inout ctx.report.text, ":");
        putn(inout ctx.report.text, index);
        let sym = ctx.names.intern(in ctx.report.text[at..ctx.report.text.len()]);
        ctx.report.text.truncate(at);
        return widen_u64(sym);
    }
    if kind == EXT_TESTCASE {
        // `trim_start_matches('%')`
        let name_id = wrapping_u32(pw(in ctx, wrapping_add(ext_at, X_S1)));
        let len = ctx.names.size(name_id);
        let mut from: u64 = 0;
        loop {
            if from >= len || ctx.names.byte(name_id, from) != 37 {
                break;
            }
            from = wrapping_add(from, 1);
        }
        let at = ctx.report.text.len();
        for k in from..len {
            ctx.report.text.push(ctx.names.byte(name_id, k));
        }
        let sym = ctx.names.intern(in ctx.report.text[at..ctx.report.text.len()]);
        ctx.report.text.truncate(at);
        return widen_u64(sym);
    }
    if kind == EXT_LIBCALL {
        return pw(in ctx, wrapping_add(ext_at, X_S1));
    }
    pw(in ctx, wrapping_add(ext_at, X_S2))
}

// Whether the first `n` bytes of name `name_id` spell `lit`.
fn prefix_is(in names: Names, name_id: u32, n: u64, in lit: Str) -> bool {
    let lit_bytes = lit.as_bytes();
    if lit_bytes.len() != n {
        return false;
    }
    for k in 0..n {
        let byte = lit_bytes.try_get(k).unwrap_or(0);
        if names.byte(name_id, k) != byte {
            return false;
        }
    }
    true
}

// `LIBM_TRANSCENDENTALS` holds the first `n` bytes of `sym`.
fn libm_name(in names: Names, sym: u64, n: u64) -> bool {
    let name_id = wrapping_u32(sym);
    prefix_is(in names, name_id, n, "sin")
        || prefix_is(in names, name_id, n, "cos")
        || prefix_is(in names, name_id, n, "tan")
        || prefix_is(in names, name_id, n, "asin")
        || prefix_is(in names, name_id, n, "acos")
        || prefix_is(in names, name_id, n, "atan")
        || prefix_is(in names, name_id, n, "atan2")
        || prefix_is(in names, name_id, n, "sinh")
        || prefix_is(in names, name_id, n, "cosh")
        || prefix_is(in names, name_id, n, "tanh")
        || prefix_is(in names, name_id, n, "asinh")
        || prefix_is(in names, name_id, n, "acosh")
        || prefix_is(in names, name_id, n, "atanh")
        || prefix_is(in names, name_id, n, "exp")
        || prefix_is(in names, name_id, n, "exp2")
        || prefix_is(in names, name_id, n, "exp10")
        || prefix_is(in names, name_id, n, "expm1")
        || prefix_is(in names, name_id, n, "log")
        || prefix_is(in names, name_id, n, "log2")
        || prefix_is(in names, name_id, n, "log10")
        || prefix_is(in names, name_id, n, "log1p")
        || prefix_is(in names, name_id, n, "pow")
        || prefix_is(in names, name_id, n, "cbrt")
        || prefix_is(in names, name_id, n, "hypot")
        || prefix_is(in names, name_id, n, "erf")
        || prefix_is(in names, name_id, n, "erfc")
        || prefix_is(in names, name_id, n, "tgamma")
        || prefix_is(in names, name_id, n, "lgamma")
        || prefix_is(in names, name_id, n, "sincos")
        || prefix_is(in names, name_id, n, "fmod")
        || prefix_is(in names, name_id, n, "remainder")
}

fn is_libm(in names: Names, sym: u64) -> bool {
    let name_id = wrapping_u32(sym);
    let len = names.size(name_id);
    if len > 0
        && names.byte(name_id, wrapping_sub(len, 1)) == 102
        && libm_name(in names, sym, wrapping_sub(len, 1)) {
        return true;
    }
    libm_name(in names, sym, len)
}

fn check_fma_and_calls(
    inout ctx: Cx,
    func: u64,
    in policy: DetPolicy,
    in by_id: ChunkSeq[u64],
    func_name: u64
) {
    let first = fw(in ctx, func, F_INSTS);
    let n = fw(in ctx, func, F_NINSTS);
    for k in 0..n {
        let row = wrapping_add(first, k);
        let op = iw(in ctx, row, I_OP);
        if op == OP_FMA && !policy.allow_fma {
            let message_at = ctx.report.text.len();
            put(
                inout ctx.report.text,
                "fused multiply-add rounds once; DetFloat requires two-rounded fmul + fadd unless explicit DetFloat::fma is allowed"
            );
            raw_finding(inout ctx, func_name, true, k, "detfloat.fma", message_at);
        } else {
            let kind = iw(in ctx, row, I_CALL);
            if kind == CALL_DIRECT {
                let lib = libcall(in ctx, row);
                let mut skip = false;
                if lib != NONE {
                    if is_fma_libcall(in ctx.names, lib) && !policy.allow_fma {
                        let message_at = ctx.report.text.len();
                        put(inout ctx.report.text, "call to fused multiply-add libcall ");
                        puts(inout ctx.report.text, in ctx.names, lib);
                        raw_finding(inout ctx, func_name, true, k, "detfloat.fma", message_at);
                        skip = true;
                    } else if is_fma_libcall(in ctx.names, lib)
                        || is_rounding_libcall(in ctx.names, lib) {
                        skip = true;
                    }
                }
                if !skip && iw(in ctx, row, I_SIG_FLOAT) == 1 {
                    let name = callee_name(inout ctx, row, in by_id);
                    if !contains(in policy.allowed, name) {
                        if is_libm(in ctx.names, name) {
                            let message_at = ctx.report.text.len();
                            put(inout ctx.report.text, "call to platform libm `");
                            puts(inout ctx.report.text, in ctx.names, name);
                            put(
                                inout ctx.report.text,
                                "`, which is not guaranteed correctly rounded; route it through an allowlisted correctly-rounded implementation"
                            );
                            raw_finding(inout ctx, func_name, true, k, "detfloat.libm", message_at);
                        } else {
                            let message_at = ctx.report.text.len();
                            put(inout ctx.report.text, "float call to `");
                            puts(inout ctx.report.text, in ctx.names, name);
                            put(inout ctx.report.text, "`, which is not on the DetFloat allowlist");
                            raw_finding(
                                inout ctx,
                                func_name,
                                true,
                                k,
                                "detfloat.unlisted-float-call",
                                message_at
                            );
                        }
                    }
                }
            } else if kind == CALL_INDIRECT && iw(in ctx, row, I_SIG_FLOAT) == 1 {
                let message_at = ctx.report.text.len();
                put(
                    inout ctx.report.text,
                    "indirect call with float arguments or results cannot be checked"
                );
                raw_finding(
                    inout ctx,
                    func_name,
                    true,
                    k,
                    "detfloat.indirect-float-call",
                    message_at
                );
            }
        }
    }
}

// ----- reductions -------------------------------------------------------------

// Shape nodes: (kind 0 leaf / 1 node, lane or left, right, min lane).
struct Sh {
    nodes: ChunkSeq[u64],
}

fn leaf(inout shapes: Sh, lane: u64) -> u64 {
    let i = shapes.nodes.len() / 4;
    shapes.nodes.push(0);
    shapes.nodes.push(lane);
    shapes.nodes.push(0);
    shapes.nodes.push(lane);
    i
}

fn node(inout shapes: Sh, a: u64, b: u64) -> u64 {
    let i = shapes.nodes.len() / 4;
    let min_a = g(in shapes.nodes, wrapping_add(wrapping_mul(a, 4), 3));
    let min_b = g(in shapes.nodes, wrapping_add(wrapping_mul(b, 4), 3));
    let mut min_lane = min_a;
    if min_b < min_lane {
        min_lane = min_b;
    }
    shapes.nodes.push(1);
    shapes.nodes.push(a);
    shapes.nodes.push(b);
    shapes.nodes.push(min_lane);
    i
}

// The normalized pre-order words of shape `i`: children ordered by their
// minimum lane (`Shape::normalized`).
fn normal(in shapes: Sh, i: u64, inout out: ChunkSeq[u64]) {
    let base = wrapping_mul(i, 4);
    if g(in shapes.nodes, base) == 0 {
        out.push(0);
        out.push(g(in shapes.nodes, wrapping_add(base, 1)));
        return;
    }
    let left = g(in shapes.nodes, wrapping_add(base, 1));
    let right = g(in shapes.nodes, wrapping_add(base, 2));
    out.push(1);
    let min_left = g(in shapes.nodes, wrapping_add(wrapping_mul(left, 4), 3));
    let min_right = g(in shapes.nodes, wrapping_add(wrapping_mul(right, 4), 3));
    if min_left <= min_right {
        normal(in shapes, left, inout out);
        normal(in shapes, right, inout out);
    } else {
        normal(in shapes, right, inout out);
        normal(in shapes, left, inout out);
    }
}

fn pairwise(inout shapes: Sh, lo: u64, hi: u64) -> u64 {
    if wrapping_sub(hi, lo) == 1 {
        return leaf(inout shapes, lo);
    }
    let mid = wrapping_add(lo, wrapping_sub(hi, lo) / 2);
    let left = pairwise(inout shapes, lo, mid);
    let right = pairwise(inout shapes, mid, hi);
    node(inout shapes, left, right)
}

fn sequential(inout shapes: Sh, n: u64) -> u64 {
    let mut tree = leaf(inout shapes, 0);
    for lane in 1..n {
        let next_leaf = leaf(inout shapes, lane);
        tree = node(inout shapes, tree, next_leaf);
    }
    tree
}

// Lane trees per value: memo word 0 unknown, 1 none, 2 + tree row. Tree
// rows: vector, op, mask, shape.
struct Lt {
    memo: ChunkSeq[u64],
    rows: ChunkSeq[u64],
    shapes: Sh,
}

fn def_row(in ctx: Cx, func: u64, v: u64) -> u64 {
    let def_ent = val(in ctx, func, v, 2);
    if def_ent == 0 {
        return NONE;
    }
    ent_row(in ctx, func, wrapping_sub(def_ent, 1))
}

fn lane_tree(in ctx: Cx, func: u64, inout lane_trees: Lt, v: u64) -> u64 {
    let memo_word = g(in lane_trees.memo, v);
    if memo_word != 0 {
        if memo_word == 1 {
            return NONE;
        }
        return wrapping_sub(memo_word, 2);
    }
    let tree = lane_tree_compute(in ctx, func, inout lane_trees, v);
    if tree == NONE {
        st(inout lane_trees.memo, v, 1);
    } else {
        st(inout lane_trees.memo, v, wrapping_add(tree, 2));
    }
    tree
}

fn lane_tree_compute(in ctx: Cx, func: u64, inout lane_trees: Lt, v: u64) -> u64 {
    let row = def_row(in ctx, func, v);
    if row == NONE {
        return NONE;
    }
    let op = iw(in ctx, row, I_OP);
    let fmt = iw(in ctx, row, I_FMT);
    if fmt == FMT_BINARY_IMM8 && op == OP_EXTRACTLANE {
        let vector = arg(in ctx, row, 0);
        let ty = val(in ctx, func, vector, 1);
        if !is_float(ty) || lanes(ty) > 64 {
            return NONE;
        }
        let imm = iw(in ctx, row, I_IMM);
        let shape = leaf(inout lane_trees.shapes, imm);
        let tree = lane_trees.rows.len() / 4;
        lane_trees.rows.push(vector);
        lane_trees.rows.push(0);
        lane_trees.rows.push(wrapping_shl_u64(1, wrapping_u32(imm)));
        lane_trees.rows.push(shape);
        return tree;
    }
    if fmt == FMT_BINARY && (op == OP_FADD || op == OP_FMUL) {
        let left = lane_tree(in ctx, func, inout lane_trees, arg(in ctx, row, 0));
        if left == NONE {
            return NONE;
        }
        let right = lane_tree(in ctx, func, inout lane_trees, arg(in ctx, row, 1));
        if right == NONE {
            return NONE;
        }
        let left_row = wrapping_mul(left, 4);
        let right_row = wrapping_mul(right, 4);
        let left_op = g(in lane_trees.rows, wrapping_add(left_row, 1));
        let right_op = g(in lane_trees.rows, wrapping_add(right_row, 1));
        let same = (left_op == 0 || left_op == op) && (right_op == 0 || right_op == op);
        let left_mask = g(in lane_trees.rows, wrapping_add(left_row, 2));
        let right_mask = g(in lane_trees.rows, wrapping_add(right_row, 2));
        if g(in lane_trees.rows, left_row) != g(in lane_trees.rows, right_row)
            || !same
            || left_mask & right_mask != 0 {
            return NONE;
        }
        let shape = node(
            inout lane_trees.shapes,
            g(in lane_trees.rows, wrapping_add(left_row, 3)),
            g(in lane_trees.rows, wrapping_add(right_row, 3))
        );
        let tree = lane_trees.rows.len() / 4;
        lane_trees.rows.push(g(in lane_trees.rows, left_row));
        lane_trees.rows.push(op);
        lane_trees.rows.push(left_mask | right_mask);
        lane_trees.rows.push(shape);
        return tree;
    }
    NONE
}

fn check_reductions(inout ctx: Cx, func: u64, sequential_order: bool, fname: u64) {
    let value_count = fw(in ctx, func, F_NVALS);
    let mut lane_trees = Lt {
        memo: filled(value_count, 0),
        rows: ChunkSeq::new[u64](),
        shapes: Sh { nodes: ChunkSeq::new[u64]() },
    };
    let first = fw(in ctx, func, F_INSTS);
    let n = fw(in ctx, func, F_NINSTS);
    let mut found: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for k in 0..n {
        let row = wrapping_add(first, k);
        let op = iw(in ctx, row, I_OP);
        if (op == OP_FADD || op == OP_FMUL) && iw(in ctx, row, wrapping_add(I_RESULTS, 1)) > 0 {
            let result = pw(in ctx, iw(in ctx, row, I_RESULTS));
            let tree = lane_tree(in ctx, func, inout lane_trees, result);
            if tree != NONE {
                let tree_row = wrapping_mul(tree, 4);
                let lane_count = lanes(val(in ctx, func, g(in lane_trees.rows, tree_row), 1));
                let mut full_mask: u64 = 18446744073709551615;
                if lane_count != 64 {
                    full_mask = wrapping_sub(wrapping_shl_u64(1, wrapping_u32(lane_count)), 1);
                }
                if lane_count >= 2
                    && g(in lane_trees.rows, wrapping_add(tree_row, 2)) == full_mask {
                    let mut expected = 0;
                    if sequential_order {
                        expected = sequential(inout lane_trees.shapes, lane_count);
                    } else {
                        expected = pairwise(inout lane_trees.shapes, 0, lane_count);
                    }
                    let mut actual_words: ChunkSeq[u64] = ChunkSeq::new[u64]();
                    let mut expected_words: ChunkSeq[u64] = ChunkSeq::new[u64]();
                    normal(
                        in lane_trees.shapes,
                        g(in lane_trees.rows, wrapping_add(tree_row, 3)),
                        inout actual_words
                    );
                    normal(in lane_trees.shapes, expected, inout expected_words);
                    let mut same = actual_words.len() == expected_words.len();
                    if same {
                        for q in 0..actual_words.len() {
                            if g(in actual_words, q) != g(in expected_words, q) {
                                same = false;
                            }
                        }
                    }
                    if !same {
                        found.push(k);
                        found.push(g(in lane_trees.rows, wrapping_add(tree_row, 1)));
                        found.push(lane_count);
                    }
                }
            }
        }
    }
    for q in 0..found.len() / 3 {
        let k = g(in found, wrapping_mul(q, 3));
        let op = g(in found, wrapping_add(wrapping_mul(q, 3), 1));
        let lane_count = g(in found, wrapping_add(wrapping_mul(q, 3), 2));
        let message_at = ctx.report.text.len();
        putn(inout ctx.report.text, lane_count);
        put(inout ctx.report.text, "-lane horizontal ");
        if op == OP_FADD {
            put(inout ctx.report.text, "fadd");
        } else if op == 0 {
            put(inout ctx.report.text, "float");
        } else {
            put(inout ctx.report.text, "fmul");
        }
        put(inout ctx.report.text, " reduction is not in the policy's ");
        if sequential_order {
            put(inout ctx.report.text, "Sequential");
        } else {
            put(inout ctx.report.text, "PairwiseTree");
        }
        put(inout ctx.report.text, " order");
        raw_finding(inout ctx, fname, true, k, "detfloat.reduction-order", message_at);
    }
}

// ----- NaN escapes ------------------------------------------------------------

fn generates_nan(op: u64) -> bool {
    op == OP_FADD
        || op == OP_FSUB
        || op == OP_FMUL
        || op == OP_FDIV
        || op == OP_SQRT
        || op == OP_FMA
        || op == OP_FMIN
        || op == OP_FMAX
        || op == OP_CEIL
        || op == OP_FLOOR
        || op == OP_TRUNC
        || op == OP_NEAREST
        || op == OP_FPROMOTE
        || op == OP_FDEMOTE
        || op == OP_FVDEMOTE
        || op == OP_FVPROMOTE_LOW
}

fn canonical_nan_bits(in ctx: Cx, row: u64, ty: u64) -> bool {
    let len = iw(in ctx, row, I_CONST_LEN);
    let const_at = iw(in ctx, row, I_CONST);
    let bits = lane_bits(ty);
    if bits == 32 {
        if len % 4 != 0 {
            return false;
        }
        for i in 0..len / 4 {
            let word = pw(in ctx, wrapping_add(const_at, i / 2));
            let lane = wrapping_shr_u64(word, wrapping_u32(wrapping_mul(i % 2, 32))) & 4294967295;
            if lane != 2143289344 {
                return false;
            }
        }
        return true;
    }
    if bits == 64 {
        if len % 8 != 0 {
            return false;
        }
        for i in 0..len / 8 {
            if pw(in ctx, wrapping_add(const_at, i)) != 9221120237041090560 {
                return false;
            }
        }
        return true;
    }
    false
}

fn is_canonical_nan_const(in ctx: Cx, func: u64, v: u64) -> bool {
    let row = def_row(in ctx, func, v);
    if row == NONE {
        return false;
    }
    let ty = val(in ctx, func, v, 1);
    let fmt = iw(in ctx, row, I_FMT);
    let op = iw(in ctx, row, I_OP);
    if fmt == FMT_UNARY_IEEE32 {
        return iw(in ctx, row, I_IMM) == 2143289344;
    }
    if fmt == FMT_UNARY_IEEE64 {
        return iw(in ctx, row, I_IMM) == 9221120237041090560;
    }
    if fmt == FMT_UNARY && (op == OP_SPLAT || op == OP_SCALAR_TO_VECTOR) {
        return is_canonical_nan_const(in ctx, func, arg(in ctx, row, 0));
    }
    if fmt == FMT_UNARY_CONST && op == OP_VCONST {
        return canonical_nan_bits(in ctx, row, ty);
    }
    false
}

fn is_nan_test_of(in ctx: Cx, func: u64, cond_value: u64, tested: u64, want_nan: bool) -> bool {
    let mut row = def_row(in ctx, func, cond_value);
    if row == NONE {
        return false;
    }
    if iw(in ctx, row, I_FMT) == FMT_LOAD_NO_OFFSET && iw(in ctx, row, I_OP) == OP_BITCAST {
        row = def_row(in ctx, func, arg(in ctx, row, 0));
        if row == NONE {
            return false;
        }
    }
    if iw(in ctx, row, I_FMT) != FMT_FLOAT_COMPARE {
        return false;
    }
    let cond = iw(in ctx, row, I_COND);
    let mut is_nan = false;
    if cond == CC_UNORDERED || cond == CC_NOT_EQUAL {
        is_nan = true;
    } else if cond == CC_ORDERED || cond == CC_EQUAL {
        is_nan = false;
    } else {
        return false;
    }
    arg(in ctx, row, 0) == tested && arg(in ctx, row, 1) == tested && is_nan == want_nan
}

fn is_canonicalizer(in ctx: Cx, func: u64, row: u64) -> bool {
    let op = iw(in ctx, row, I_OP);
    if op != OP_SELECT && op != OP_SELECT_SPECTRE_GUARD && op != OP_BITSELECT {
        return false;
    }
    if nargs(in ctx, row) != 3 {
        return false;
    }
    let cond_value = arg(in ctx, row, 0);
    let true_value = arg(in ctx, row, 1);
    let false_value = arg(in ctx, row, 2);
    (
        is_nan_test_of(in ctx, func, cond_value, false_value, true)
            && is_canonical_nan_const(in ctx, func, true_value)
    )
        || (
            is_nan_test_of(in ctx, func, cond_value, true_value, false)
                && is_canonical_nan_const(in ctx, func, false_value)
        )
}

fn check_nan_escape(inout ctx: Cx, func: u64, fname: u64) {
    let value_count = fw(in ctx, func, F_NVALS);
    let first = fw(in ctx, func, F_INSTS);
    let n = fw(in ctx, func, F_NINSTS);
    let mut tainted = filled(value_count, 0);
    loop {
        let mut changed = false;
        for k in 0..n {
            let row = wrapping_add(first, k);
            let op = iw(in ctx, row, I_OP);
            let mut any_arg = false;
            for j in 0..nargs(in ctx, row) {
                if g(in tainted, arg(in ctx, row, j)) == 1 {
                    any_arg = true;
                }
            }
            let lib = libcall(in ctx, row);
            let nan_lib = lib != NONE
                && (is_fma_libcall(in ctx.names, lib) || is_rounding_libcall(in ctx.names, lib));
            let mut taint = false;
            if generates_nan(op) || nan_lib {
                taint = true;
            } else if is_canonicalizer(in ctx, func, row) {
                taint = false;
            } else {
                taint = any_arg && iw(in ctx, row, I_FLAGS) & IS_CALL == 0;
            }
            if taint {
                let results_at = iw(in ctx, row, I_RESULTS);
                for j in 0..iw(in ctx, row, wrapping_add(I_RESULTS, 1)) {
                    let result = pw(in ctx, wrapping_add(results_at, j));
                    if is_float(val(in ctx, func, result, 1)) && g(in tainted, result) == 0 {
                        st(inout tainted, result, 1);
                        changed = true;
                    }
                }
            }
            let mut dest_at = iw(in ctx, row, I_DESTS);
            for j in 0..iw(in ctx, row, wrapping_add(I_DESTS, 1)) {
                let blk = pw(in ctx, dest_at);
                let arg_count = pw(in ctx, wrapping_add(dest_at, 1));
                let param_start = block_row(in ctx, func, blk, 0);
                let param_count = block_row(in ctx, func, blk, 1);
                for q in 0..arg_count {
                    let kind = pw(
                        in ctx,
                        wrapping_add(dest_at, wrapping_add(2, wrapping_mul(q, 2)))
                    );
                    let v = pw(in ctx, wrapping_add(dest_at, wrapping_add(3, wrapping_mul(q, 2))));
                    if q < param_count && kind == BA_VALUE {
                        let param = pw(in ctx, wrapping_add(param_start, q));
                        if g(in tainted, v) == 1 && g(in tainted, param) == 0 {
                            st(inout tainted, param, 1);
                            changed = true;
                        }
                    }
                }
                dest_at = wrapping_add(dest_at, wrapping_add(2, wrapping_mul(arg_count, 2)));
            }
        }
        if !changed {
            break;
        }
    }
    for k in 0..n {
        let row = wrapping_add(first, k);
        let op = iw(in ctx, row, I_OP);
        let arg_count = nargs(in ctx, row);
        // The sink: how, and the range of candidate arguments.
        let mut sink: u64 = 0;
        let mut lo: u64 = 0;
        let mut hi: u64 = 0;
        if op == OP_STORE || op == OP_STACK_STORE || op == OP_ATOMIC_STORE {
            sink = 1;
            hi = 1;
        } else if op == OP_RETURN {
            sink = 2;
            hi = arg_count;
        } else if iw(in ctx, row, I_FLAGS) & IS_CALL != 0 {
            sink = 3;
            hi = arg_count;
        } else if op == OP_BITCAST {
            let result = pw(in ctx, iw(in ctx, row, I_RESULTS));
            if !is_float(val(in ctx, func, result, 1)) {
                sink = 4;
                hi = 1;
            }
        }
        if sink != 0 {
            let mut hit = NONE;
            for j in lo..hi {
                let v = arg(in ctx, row, j);
                if hit == NONE && g(in tainted, v) == 1 {
                    hit = v;
                }
            }
            if hit != NONE {
                let message_at = ctx.report.text.len();
                put(inout ctx.report.text, "float value v");
                putn(inout ctx.report.text, hit);
                put(inout ctx.report.text, " from NaN-producing arithmetic is ");
                if sink == 1 {
                    put(inout ctx.report.text, "stored to memory");
                } else if sink == 2 {
                    put(inout ctx.report.text, "returned");
                } else if sink == 3 {
                    put(inout ctx.report.text, "passed to a call");
                } else {
                    put(inout ctx.report.text, "bitcast to an integer");
                }
                put(
                    inout ctx.report.text,
                    " without NaN canonicalisation; x86-64 and AArch64 produce different default NaN bits"
                );
                raw_finding(inout ctx, fname, true, k, "detfloat.nan-escape", message_at);
            }
        }
    }
}

// `audit(function, policy)` minus `verify_function` (input), findings to
// `ctx.raw_findings` under function name `func_name`.
pub fn audit(
    inout ctx: Cx,
    func: u64,
    in policy: DetPolicy,
    in by_id: ChunkSeq[u64],
    func_name: u64
) {
    check_fma_and_calls(inout ctx, func, in policy, in by_id, func_name);
    check_reductions(inout ctx, func, policy.sequential, func_name);
    if !policy.canonicalizes {
        check_nan_escape(inout ctx, func, func_name);
    }
}
