// Module util of @vesper/backend-checks (see lib.ves): total sequence
// access and text output.

use @vesper/check-data::names::{Names};
use @vesper/check-data::util::{n32, push_decimal};

// `u64::MAX`: an absent index in every table.
pub const NONE: u64 = 18446744073709551615;

// `a / b`, and 0 when `b` is 0.
pub fn dv(a: u64, b: u64) -> u64 {
    if b == 0 {
        return 0;
    }
    handle Fail[RuntimeError] in {
        a / b
    } with {
        return q => q,
        raise(e, k) => 0,
    }
}

pub fn g(in seq: ChunkSeq[u64], i: u64) -> u64 {
    seq.try_get(i).unwrap_or(0)
}

pub fn st(inout seq: ChunkSeq[u64], i: u64, v: u64) {
    let ok = seq.try_set(i, v);
}

pub fn b8(in seq: ChunkSeq[u8], i: u64) -> u8 {
    seq.try_get(i).unwrap_or(0)
}

// A sequence of `n` copies of `v`.
pub fn filled(n: u64, v: u64) -> ChunkSeq[u64] {
    let mut seq: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](n);
    seq.resize(n, v);
    seq
}

// Grows a sym-indexed table to cover `i` (new rows are 0) and sets row `i`.
pub fn put_at(inout seq: ChunkSeq[u64], i: u64, v: u64) {
    if seq.len() <= i {
        seq.resize(wrapping_add(i, 1), 0);
    }
    let ok = seq.try_set(i, v);
}

pub fn put(inout out: ChunkSeq[u8], in text: Str) {
    out.extend(in text.as_bytes());
}

pub fn putn(inout out: ChunkSeq[u8], v: u64) {
    push_decimal(inout out, v);
}

pub fn puts(inout out: ChunkSeq[u8], in names: Names, sym: u64) {
    names.write(n32(sym), inout out);
}

// Whether `list[at..at + n]` holds `v`.
pub fn has(in list: ChunkSeq[u64], at: u64, n: u64, v: u64) -> bool {
    for k in 0..n {
        if g(in list, wrapping_add(at, k)) == v {
            return true;
        }
    }
    false
}

pub fn contains(in list: ChunkSeq[u64], v: u64) -> bool {
    has(in list, 0, list.len(), v)
}

// The byte order of two names (-1, 0, 1): `String`'s `Ord`.
pub fn cmp_names(in names: Names, a: u64, b: u64) -> i64 {
    if a == b {
        return 0;
    }
    let id_a = n32(a);
    let id_b = n32(b);
    let len_a = names.size(id_a);
    let len_b = names.size(id_b);
    let mut i: u64 = 0;
    loop {
        if i >= len_a || i >= len_b {
            break;
        }
        let byte_a = names.byte(id_a, i);
        let byte_b = names.byte(id_b, i);
        if byte_a < byte_b {
            return -1;
        }
        if byte_a > byte_b {
            return 1;
        }
        i = wrapping_add(i, 1);
    }
    if len_a < len_b {
        return -1;
    }
    if len_a > len_b {
        return 1;
    }
    0
}

// The row of `key` in `rows` (rows of `width` words, key first), or NONE.
pub fn find_row(in rows: ChunkSeq[u64], width: u64, key: u64) -> u64 {
    let n = dv(rows.len(), width);
    for row in 0..n {
        if g(in rows, wrapping_mul(row, width)) == key {
            return row;
        }
    }
    NONE
}

// Where a row keyed `key` goes in name-sorted `rows`.
pub fn sorted_slot(in names: Names, in rows: ChunkSeq[u64], width: u64, key: u64) -> u64 {
    let n = dv(rows.len(), width);
    for row in 0..n {
        if cmp_names(in names, key, g(in rows, wrapping_mul(row, width))) < 0 {
            return row;
        }
    }
    n
}

// Inserts a row (its words in `row`) at row index `at`.
pub fn insert_row(inout rows: ChunkSeq[u64], width: u64, at: u64, in row: ChunkSeq[u64]) {
    let old_len = rows.len();
    rows.resize(wrapping_add(old_len, width), 0);
    let start = wrapping_mul(at, width);
    let mut i = old_len;
    loop {
        if i <= start {
            break;
        }
        i = wrapping_sub(i, 1);
        st(inout rows, wrapping_add(i, width), g(in rows, i));
    }
    for k in 0..width {
        st(inout rows, wrapping_add(start, k), g(in row, k));
    }
}

// Inserts `name` into the name-sorted set `set` unless present.
pub fn set_insert(in names: Names, inout set: ChunkSeq[u64], name: u64) {
    if contains(in set, name) {
        return;
    }
    let mut row: ChunkSeq[u64] = ChunkSeq::new[u64]();
    row.push(name);
    let at = sorted_slot(in names, in set, 1, name);
    insert_row(inout set, 1, at, in row);
}

// Whether name `sym` starts with the bytes of `prefix`.
pub fn starts(in names: Names, sym: u64, in prefix: Str) -> bool {
    names.has_prefix(n32(sym), in prefix.as_bytes())
}

pub fn spells(in names: Names, sym: u64, in text: Str) -> bool {
    names.spells(n32(sym), in text.as_bytes())
}

// Interns the bytes `out[at..]` and truncates `out` back to `at`.
pub fn intern_tail(inout names: Names, inout out: ChunkSeq[u8], at: u64) -> u64 {
    let sym = names.intern(in out[at..out.len()]);
    out.truncate(at);
    widen_u64(sym)
}

pub fn intern_str(inout names: Names, in text: Str) -> u64 {
    widen_u64(names.intern(in text.as_bytes()))
}

pub fn dup(in seq: ChunkSeq[u64]) -> ChunkSeq[u64] {
    let mut out: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](seq.len());
    out.extend(in seq.as_slice());
    out
}
