// Module consttime of @vesper/backend-checks (see lib.ves): the
// constant-time SSA taint verifier of crates/vesper-vault/src/verifier.rs
// (`verify_constant_time`) over one emitted function's CLIF tables.
//
// Each value has two words: bit 0 secret, bits 1-3 the points-to set
// (1 untracked, 2 secret buffer, 4 a stack slot past 63), and a mask of the
// stack slots below 64 it may point into. `CtPolicy::secret_regions` is
// always empty in native_verifiers.rs, so alias regions are not read.

use self::input::{Cx, arg, block_row, fw, iw, nargs, pw, val};
use self::report::{raw_finding};
use self::util::{contains, filled, g, put, putn, puts, st};

const CAN_LOAD: u64 = 2;
const CAN_STORE: u64 = 4;
const CAN_TRAP: u64 = 8;
const F_INSTS: u64 = 33;
const F_NAME: u64 = 26;
const F_NBLOCKS: u64 = 32;
const F_NINSTS: u64 = 34;
const F_NVALS: u64 = 28;
const I_ARGS: u64 = 5;
const I_CALL: u64 = 15;
const I_CARGS: u64 = 16;
const I_DESTS: u64 = 21;
const I_ENT: u64 = 0;
const I_EXT: u64 = 19;
const I_FLAGS: u64 = 2;
const I_FMT: u64 = 3;
const I_OP: u64 = 1;
const I_OPNAME: u64 = 4;
const I_RESULTS: u64 = 7;
const I_SLOT: u64 = 9;
const IS_CALL: u64 = 1;
const X_DISPLAY: u64 = 3;
const BA_TRY_EXN: u64 = 2;
const BA_TRY_RET: u64 = 1;
const CALL_DIRECT: u64 = 1;
const CALL_INDIRECT: u64 = 2;
const FMT_DYNAMIC_STACK_LOAD: u64 = 7;
const FMT_DYNAMIC_STACK_STORE: u64 = 8;
const FMT_LOAD: u64 = 1;
const FMT_LOAD_NO_OFFSET: u64 = 2;
const FMT_STACK_LOAD: u64 = 5;
const FMT_STACK_STORE: u64 = 6;
const FMT_STORE: u64 = 3;
const FMT_STORE_NO_OFFSET: u64 = 4;
const OP_ATOMIC_CAS: u64 = 11;
const OP_ATOMIC_RMW: u64 = 10;
const OP_BRIF: u64 = 1;
const OP_BR_TABLE: u64 = 2;
const OP_SDIV: u64 = 4;
const OP_SREM: u64 = 6;
const OP_STACK_ADDR: u64 = 7;
const OP_STACK_LOAD: u64 = 8;
const OP_STACK_STORE: u64 = 9;
const OP_UDIV: u64 = 3;
const OP_UREM: u64 = 5;

const SECRET: u64 = 1;
const PTS_UNTRACKED: u64 = 1;
const PTS_SECRET_BUF: u64 = 2;
const PTS_HIGH_SLOT: u64 = 4;

struct Ct {
    func: u64,
    a: ChunkSeq[u64],
    s: ChunkSeq[u64],
    untracked: bool,
    secret_slots: u64,
    secret_high: bool,
}

fn pts(a: u64) -> u64 {
    a >> 1
}

fn secret(a: u64) -> bool {
    a & SECRET != 0
}

fn get_a(in ctx: Cx, in taint: Ct, v: u64) -> u64 {
    g(in taint.a, val(in ctx, taint.func, v, 0))
}

fn get_s(in ctx: Cx, in taint: Ct, v: u64) -> u64 {
    g(in taint.s, val(in ctx, taint.func, v, 0))
}

fn join_into(in ctx: Cx, inout taint: Ct, v: u64, a: u64, s: u64) -> bool {
    let resolved = val(in ctx, taint.func, v, 0);
    if resolved >= taint.a.len() {
        return false;
    }
    let old_a = g(in taint.a, resolved);
    let old_s = g(in taint.s, resolved);
    let new_a = old_a | a;
    let new_s = old_s | s;
    if new_a != old_a || new_s != old_s {
        st(inout taint.a, resolved, new_a);
        st(inout taint.s, resolved, new_s);
        return true;
    }
    false
}

fn points_to_secret_memory(in taint: Ct, a: u64, s: u64) -> bool {
    pts(a) & PTS_SECRET_BUF != 0
        || s & taint.secret_slots != 0
        || (pts(a) & PTS_HIGH_SLOT != 0 && taint.secret_high)
}

fn untracked(a: u64, s: u64) -> bool {
    pts(a) & PTS_UNTRACKED != 0 || (pts(a) == 0 && s == 0)
}

fn exposes(in ctx: Cx, in taint: Ct, v: u64) -> bool {
    let a = get_a(in ctx, in taint, v);
    let s = get_s(in ctx, in taint, v);
    secret(a) || points_to_secret_memory(in taint, a, s) || (taint.untracked && untracked(a, s))
}

fn record_store(inout taint: Ct, addr_a: u64, addr_s: u64, value_a: u64) -> bool {
    if !secret(value_a) {
        return false;
    }
    let was_untracked = taint.untracked;
    let old_slots = taint.secret_slots;
    let old_high = taint.secret_high;
    if untracked(addr_a, addr_s) {
        taint.untracked = true;
    }
    taint.secret_slots = taint.secret_slots | addr_s;
    if pts(addr_a) & PTS_HIGH_SLOT != 0 {
        taint.secret_high = true;
    }
    was_untracked != taint.untracked
        || old_slots != taint.secret_slots
        || old_high != taint.secret_high
}

fn any_exposes(in ctx: Cx, in taint: Ct, at: u64, n: u64) -> bool {
    for k in 0..n {
        if exposes(in ctx, in taint, pw(in ctx, wrapping_add(at, k))) {
            return true;
        }
    }
    false
}

fn record_callee_writes(in ctx: Cx, inout taint: Ct, at: u64, n: u64) -> bool {
    if !any_exposes(in ctx, in taint, at, n) {
        return false;
    }
    let mut changed = false;
    for k in 0..n {
        let v = pw(in ctx, wrapping_add(at, k));
        let addr_a = get_a(in ctx, in taint, v);
        let addr_s = get_s(in ctx, in taint, v);
        if record_store(inout taint, addr_a, addr_s, SECRET) {
            changed = true;
        }
    }
    changed
}

// `load_result`: secret when the address may reach secret memory.
fn load_secret(in taint: Ct, a: u64, s: u64) -> u64 {
    let mut is_secret = points_to_secret_memory(in taint, a, s);
    if untracked(a, s) && taint.untracked {
        is_secret = true;
    }
    if is_secret { SECRET } else { 0 }
}

fn slot_a(slot: u64) -> u64 {
    if slot < 64 { 0 } else { PTS_HIGH_SLOT << 1 }
}

fn slot_s(slot: u64) -> u64 {
    if slot < 64 {
        wrapping_shl_u64(1, wrapping_u32(slot))
    } else {
        0
    }
}

fn join_args(in ctx: Cx, in taint: Ct, row: u64) -> (u64, u64) {
    let mut a: u64 = 0;
    let mut s: u64 = 0;
    for k in 0..nargs(in ctx, row) {
        let v = arg(in ctx, row, k);
        a = a | get_a(in ctx, in taint, v);
        s = s | get_s(in ctx, in taint, v);
    }
    (a, s)
}

fn in_list(in ctx: Cx, in list: ChunkSeq[u64], row: u64) -> bool {
    let name = pw(in ctx, wrapping_add(iw(in ctx, row, I_EXT), X_DISPLAY));
    contains(in list, name)
}

// The abstract result (a, s) of one instruction and whether memory changed.
fn transfer(
    in ctx: Cx,
    inout taint: Ct,
    row: u64,
    in declassify: ChunkSeq[u64]
) -> (u64, u64, bool) {
    let op = iw(in ctx, row, I_OP);
    let fmt = iw(in ctx, row, I_FMT);
    let flags = iw(in ctx, row, I_FLAGS);
    if op == OP_STACK_ADDR && fmt == FMT_STACK_LOAD {
        let slot = iw(in ctx, row, I_SLOT);
        return (slot_a(slot), slot_s(slot), false);
    }
    if op == OP_STACK_LOAD && fmt == FMT_STACK_LOAD {
        let slot = iw(in ctx, row, I_SLOT);
        return (load_secret(in taint, slot_a(slot), slot_s(slot)), 0, false);
    }
    if op == OP_STACK_STORE && fmt == FMT_STACK_STORE {
        let slot = iw(in ctx, row, I_SLOT);
        let value_a = get_a(in ctx, in taint, arg(in ctx, row, 0));
        let memory_changed = record_store(inout taint, slot_a(slot), slot_s(slot), value_a);
        return (0, 0, memory_changed);
    }
    if (fmt == FMT_LOAD || fmt == FMT_LOAD_NO_OFFSET) && flags & CAN_LOAD != 0 {
        let v = arg(in ctx, row, 0);
        return (
            load_secret(in taint, get_a(in ctx, in taint, v), get_s(in ctx, in taint, v)),
            0,
            false
        );
    }
    if (fmt == FMT_STORE || fmt == FMT_STORE_NO_OFFSET) && flags & CAN_STORE != 0 {
        let value_a = get_a(in ctx, in taint, arg(in ctx, row, 0));
        let addr = arg(in ctx, row, 1);
        let memory_changed = record_store(
            inout taint,
            get_a(in ctx, in taint, addr),
            get_s(in ctx, in taint, addr),
            value_a
        );
        return (0, 0, memory_changed);
    }
    if op == OP_ATOMIC_RMW || op == OP_ATOMIC_CAS {
        let addr = arg(in ctx, row, 0);
        let addr_a = get_a(in ctx, in taint, addr);
        let addr_s = get_s(in ctx, in taint, addr);
        let mut value_a: u64 = 0;
        for k in 1..nargs(in ctx, row) {
            value_a = value_a | get_a(in ctx, in taint, arg(in ctx, row, k));
        }
        let memory_changed = record_store(inout taint, addr_a, addr_s, value_a);
        let result_a = load_secret(in taint, addr_a, addr_s) | (value_a & SECRET);
        return (result_a, 0, memory_changed);
    }
    if flags & IS_CALL != 0 {
        let kind = iw(in ctx, row, I_CALL);
        let call_args_at = iw(in ctx, row, I_CARGS);
        let call_arg_count = iw(in ctx, row, wrapping_add(I_CARGS, 1));
        if kind == CALL_DIRECT {
            if in_list(in ctx, in declassify, row) {
                return (0, 0, false);
            }
            let is_secret = any_exposes(in ctx, in taint, call_args_at, call_arg_count);
            let memory_changed = record_callee_writes(
                in ctx,
                inout taint,
                call_args_at,
                call_arg_count
            );
            if is_secret {
                return (SECRET, 0, memory_changed);
            }
            return (0, 0, memory_changed);
        }
        if kind == CALL_INDIRECT {
            let is_secret = any_exposes(in ctx, in taint, call_args_at, call_arg_count)
                || (nargs(in ctx, row) > 0 && secret(get_a(in ctx, in taint, arg(in ctx, row, 0))));
            let memory_changed = record_callee_writes(
                in ctx,
                inout taint,
                call_args_at,
                call_arg_count
            );
            if is_secret {
                return (SECRET, 0, memory_changed);
            }
            return (0, 0, memory_changed);
        }
    }
    let (a, s) = join_args(in ctx, in taint, row);
    (a, s, false)
}

fn fixpoint(in ctx: Cx, inout taint: Ct, in declassify: ChunkSeq[u64]) {
    let first = fw(in ctx, taint.func, F_INSTS);
    let n = fw(in ctx, taint.func, F_NINSTS);
    loop {
        let mut changed = false;
        for k in 0..n {
            let row = wrapping_add(first, k);
            let (result_a, result_s, memory_changed) = transfer(
                in ctx,
                inout taint,
                row,
                in declassify
            );
            if memory_changed {
                changed = true;
            }
            let results_at = iw(in ctx, row, I_RESULTS);
            for j in 0..iw(in ctx, row, wrapping_add(I_RESULTS, 1)) {
                if join_into(
                    in ctx,
                    inout taint,
                    pw(in ctx, wrapping_add(results_at, j)),
                    result_a,
                    result_s
                ) {
                    changed = true;
                }
            }
            let mut dest_at = iw(in ctx, row, I_DESTS);
            for j in 0..iw(in ctx, row, wrapping_add(I_DESTS, 1)) {
                let blk = pw(in ctx, dest_at);
                let arg_count = pw(in ctx, wrapping_add(dest_at, 1));
                let param_start = block_row(in ctx, taint.func, blk, 0);
                let param_count = block_row(in ctx, taint.func, blk, 1);
                for q in 0..arg_count {
                    let kind = pw(
                        in ctx,
                        wrapping_add(dest_at, wrapping_add(2, wrapping_mul(q, 2)))
                    );
                    let v = pw(in ctx, wrapping_add(dest_at, wrapping_add(3, wrapping_mul(q, 2))));
                    if q < param_count {
                        let param = pw(in ctx, wrapping_add(param_start, q));
                        let mut a: u64 = 0;
                        let mut s: u64 = 0;
                        if kind == BA_TRY_RET {
                            a = result_a;
                            s = result_s;
                        } else if kind != BA_TRY_EXN {
                            a = get_a(in ctx, in taint, v);
                            s = get_s(in ctx, in taint, v);
                        }
                        if join_into(in ctx, inout taint, param, a, s) {
                            changed = true;
                        }
                    }
                }
                dest_at = wrapping_add(dest_at, wrapping_add(2, wrapping_mul(arg_count, 2)));
            }
        }
        if !changed {
            break;
        }
    }
}

// One finding per (instruction, rule): `seen` holds rule codes per row.
fn report(
    inout ctx: Cx,
    inout seen: ChunkSeq[u64],
    inst_index: u64,
    rule: u64,
    func_name: u64,
    ent: u64,
    msg: u64
) {
    let bit = wrapping_shl_u64(1, wrapping_u32(rule));
    if g(in seen, inst_index) & bit != 0 {
        ctx.report.text.truncate(msg);
        return;
    }
    st(inout seen, inst_index, g(in seen, inst_index) | bit);
    if rule == 0 {
        raw_finding(inout ctx, func_name, true, ent, "secret-branch", msg);
    } else if rule == 1 {
        raw_finding(inout ctx, func_name, true, ent, "secret-branch-table", msg);
    } else if rule == 2 {
        raw_finding(inout ctx, func_name, true, ent, "variable-latency-div", msg);
    } else if rule == 3 {
        raw_finding(inout ctx, func_name, true, ent, "secret-load-address", msg);
    } else if rule == 4 {
        raw_finding(inout ctx, func_name, true, ent, "secret-store-address", msg);
    } else if rule == 5 {
        raw_finding(inout ctx, func_name, true, ent, "secret-call-unknown", msg);
    } else if rule == 6 {
        raw_finding(inout ctx, func_name, true, ent, "secret-call-target", msg);
    } else if rule == 7 {
        raw_finding(inout ctx, func_name, true, ent, "unsupported-secret-operand", msg);
    } else {
        raw_finding(inout ctx, func_name, true, ent, "secret-trap", msg);
    }
}

fn opname(inout ctx: Cx, row: u64) {
    let name = iw(in ctx, row, I_OPNAME);
    puts(inout ctx.report.text, in ctx.names, name);
}

fn any_secret(in ctx: Cx, in taint: Ct, row: u64) -> bool {
    for k in 0..nargs(in ctx, row) {
        if secret(get_a(in ctx, in taint, arg(in ctx, row, k))) {
            return true;
        }
    }
    false
}

fn check(inout ctx: Cx, in taint: Ct, in declassify: ChunkSeq[u64], in trusted: ChunkSeq[u64]) {
    let func_name = fw(in ctx, taint.func, F_NAME);
    let first = fw(in ctx, taint.func, F_INSTS);
    let n = fw(in ctx, taint.func, F_NINSTS);
    let mut seen = filled(n, 0);
    for k in 0..n {
        let row = wrapping_add(first, k);
        let op = iw(in ctx, row, I_OP);
        let fmt = iw(in ctx, row, I_FMT);
        let flags = iw(in ctx, row, I_FLAGS);
        let ent = iw(in ctx, row, I_ENT);
        if op == OP_BRIF {
            let v = arg(in ctx, row, 0);
            if secret(get_a(in ctx, in taint, v)) {
                let message_at = ctx.report.text.len();
                put(inout ctx.report.text, "brif on secret condition v");
                putn(inout ctx.report.text, v);
                report(inout ctx, inout seen, k, 0, func_name, ent, message_at);
            }
        } else if op == OP_BR_TABLE {
            let v = arg(in ctx, row, 0);
            if secret(get_a(in ctx, in taint, v)) {
                let message_at = ctx.report.text.len();
                put(inout ctx.report.text, "br_table on secret index v");
                putn(inout ctx.report.text, v);
                report(inout ctx, inout seen, k, 1, func_name, ent, message_at);
            }
        } else if op == OP_UDIV || op == OP_SDIV || op == OP_UREM || op == OP_SREM {
            for j in 0..nargs(in ctx, row) {
                let v = arg(in ctx, row, j);
                if secret(get_a(in ctx, in taint, v)) {
                    let message_at = ctx.report.text.len();
                    opname(inout ctx, row);
                    put(inout ctx.report.text, " has secret operand v");
                    putn(inout ctx.report.text, v);
                    report(inout ctx, inout seen, k, 2, func_name, ent, message_at);
                }
            }
        } else if op == OP_STACK_ADDR || op == OP_STACK_LOAD || op == OP_STACK_STORE {} else if (fmt
            == FMT_LOAD
            || fmt == FMT_LOAD_NO_OFFSET)
            && flags & CAN_LOAD != 0
        {
            let v = arg(in ctx, row, 0);
            if secret(get_a(in ctx, in taint, v)) {
                let message_at = ctx.report.text.len();
                opname(inout ctx, row);
                put(inout ctx.report.text, " address v");
                putn(inout ctx.report.text, v);
                put(inout ctx.report.text, " is secret-derived");
                report(inout ctx, inout seen, k, 3, func_name, ent, message_at);
            }
        } else if (fmt == FMT_STORE || fmt == FMT_STORE_NO_OFFSET) && flags & CAN_STORE != 0 {
            let v = arg(in ctx, row, 1);
            if secret(get_a(in ctx, in taint, v)) {
                let message_at = ctx.report.text.len();
                opname(inout ctx, row);
                put(inout ctx.report.text, " address v");
                putn(inout ctx.report.text, v);
                put(inout ctx.report.text, " is secret-derived");
                report(inout ctx, inout seen, k, 4, func_name, ent, message_at);
            }
        } else if op == OP_ATOMIC_RMW || op == OP_ATOMIC_CAS {
            let v = arg(in ctx, row, 0);
            if secret(get_a(in ctx, in taint, v)) {
                let message_at = ctx.report.text.len();
                opname(inout ctx, row);
                put(inout ctx.report.text, " address v");
                putn(inout ctx.report.text, v);
                put(inout ctx.report.text, " is secret-derived");
                report(inout ctx, inout seen, k, 4, func_name, ent, message_at);
            }
        } else if flags & IS_CALL != 0 {
            let kind = iw(in ctx, row, I_CALL);
            let call_args_at = iw(in ctx, row, I_CARGS);
            let call_arg_count = iw(in ctx, row, wrapping_add(I_CARGS, 1));
            if kind == CALL_DIRECT {
                let name = pw(in ctx, wrapping_add(iw(in ctx, row, I_EXT), X_DISPLAY));
                let is_trusted = contains(in declassify, name) || contains(in trusted, name);
                if !is_trusted {
                    for j in 0..call_arg_count {
                        let v = pw(in ctx, wrapping_add(call_args_at, j));
                        if exposes(in ctx, in taint, v) {
                            let message_at = ctx.report.text.len();
                            opname(inout ctx, row);
                            put(inout ctx.report.text, " ");
                            puts(inout ctx.report.text, in ctx.names, name);
                            put(inout ctx.report.text, " receives secret v");
                            putn(inout ctx.report.text, v);
                            put(
                                inout ctx.report.text,
                                " but is not a trusted constant-time callee"
                            );
                            report(inout ctx, inout seen, k, 5, func_name, ent, message_at);
                        }
                    }
                }
            } else if kind == CALL_INDIRECT {
                let target = arg(in ctx, row, 0);
                if secret(get_a(in ctx, in taint, target)) {
                    let message_at = ctx.report.text.len();
                    opname(inout ctx, row);
                    put(inout ctx.report.text, " target v");
                    putn(inout ctx.report.text, target);
                    put(inout ctx.report.text, " is secret");
                    report(inout ctx, inout seen, k, 6, func_name, ent, message_at);
                }
                for j in 0..call_arg_count {
                    let v = pw(in ctx, wrapping_add(call_args_at, j));
                    if exposes(in ctx, in taint, v) {
                        let message_at = ctx.report.text.len();
                        opname(inout ctx, row);
                        put(inout ctx.report.text, " passes secret v");
                        putn(inout ctx.report.text, v);
                        put(inout ctx.report.text, " to an unknown callee");
                        report(inout ctx, inout seen, k, 5, func_name, ent, message_at);
                    }
                }
            } else if any_secret(in ctx, in taint, row) {
                let message_at = ctx.report.text.len();
                opname(inout ctx, row);
                put(inout ctx.report.text, " is not modelled with secret operands");
                report(inout ctx, inout seen, k, 7, func_name, ent, message_at);
            }
        } else if flags & CAN_TRAP != 0 {
            for j in 0..nargs(in ctx, row) {
                let v = arg(in ctx, row, j);
                if secret(get_a(in ctx, in taint, v)) {
                    let message_at = ctx.report.text.len();
                    opname(inout ctx, row);
                    put(inout ctx.report.text, " may trap depending on secret v");
                    putn(inout ctx.report.text, v);
                    report(inout ctx, inout seen, k, 8, func_name, ent, message_at);
                }
            }
        } else if fmt == FMT_DYNAMIC_STACK_LOAD || fmt == FMT_DYNAMIC_STACK_STORE {
            if any_secret(in ctx, in taint, row) {
                let message_at = ctx.report.text.len();
                opname(inout ctx, row);
                put(inout ctx.report.text, " is not modelled with secret operands");
                report(inout ctx, inout seen, k, 7, func_name, ent, message_at);
            }
        } else if (flags & CAN_LOAD != 0 || flags & CAN_STORE != 0)
            && any_secret(in ctx, in taint, row)
        {
            let message_at = ctx.report.text.len();
            put(inout ctx.report.text, "memory operation ");
            opname(inout ctx, row);
            put(inout ctx.report.text, " is not modelled with secret operands");
            report(inout ctx, inout seen, k, 7, func_name, ent, message_at);
        }
    }
}

// `verify_constant_time(function, policy)`: `secret` and `pointers` are
// entry-parameter indices, `declassify` and `trusted` callee display names.
// Findings go to `ctx.raw_findings`.
pub fn verify_constant_time(
    inout ctx: Cx,
    func: u64,
    in secret_params: ChunkSeq[u64],
    in pointers: ChunkSeq[u64],
    in declassify: ChunkSeq[u64],
    in trusted: ChunkSeq[u64]
) {
    if fw(in ctx, func, F_NBLOCKS) == 0 {
        return;
    }
    let func_name = fw(in ctx, func, F_NAME);
    let param_start = block_row(in ctx, func, 0, 0);
    let param_count = block_row(in ctx, func, 0, 1);
    let mut bad = false;
    for which in 0..2 {
        let mut list_len = secret_params.len();
        if which == 1 {
            list_len = pointers.len();
        }
        for k in 0..list_len {
            let mut param_index = g(in secret_params, k);
            if which == 1 {
                param_index = g(in pointers, k);
            }
            if param_index >= param_count {
                let message_at = ctx.report.text.len();
                if which == 0 {
                    put(inout ctx.report.text, "secret_params");
                } else {
                    put(inout ctx.report.text, "secret_pointer_params");
                }
                put(inout ctx.report.text, " names parameter ");
                putn(inout ctx.report.text, param_index);
                put(inout ctx.report.text, ", but the entry block has ");
                putn(inout ctx.report.text, param_count);
                put(inout ctx.report.text, " parameters");
                raw_finding(inout ctx, func_name, false, 0, "invalid-policy", message_at);
                bad = true;
            }
        }
    }
    if bad {
        return;
    }
    let value_count = fw(in ctx, func, F_NVALS);
    let mut taint = Ct {
        func: func,
        a: filled(value_count, 0),
        s: filled(value_count, 0),
        untracked: false,
        secret_slots: 0,
        secret_high: false,
    };
    for k in 0..secret_params.len() {
        let resolved = val(
            in ctx,
            func,
            pw(in ctx, wrapping_add(param_start, g(in secret_params, k))),
            0
        );
        st(inout taint.a, resolved, g(in taint.a, resolved) | SECRET);
    }
    for k in 0..pointers.len() {
        let resolved = val(
            in ctx,
            func,
            pw(in ctx, wrapping_add(param_start, g(in pointers, k))),
            0
        );
        st(inout taint.a, resolved, g(in taint.a, resolved) | (PTS_SECRET_BUF << 1));
    }
    fixpoint(in ctx, inout taint, in declassify);
    check(inout ctx, in taint, in declassify, in trusted);
}
