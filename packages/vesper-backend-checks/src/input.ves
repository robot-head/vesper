// Module input of @vesper/backend-checks (see lib.ves): the decoder of the
// harness input (tests/common/backend_checks_input.rs) into flat tables.
//
// The input is little-endian u64 words in one `Str`: a string table (each
// string a byte length and its bytes padded to eight; string i is Names
// symbol i, 0 the empty string), then a word count and the words:
//
// - mode (0: `verify_emitted` under the policy; 1: the capability verifiers
//   of `verify_native_with_capabilities` under the policy derived over it),
//   the requested verifiers (bits: 1 const-time, 2 stack, 4 realtime,
//   8 detfloat), the file name, the source, `needs_nan_canonicalization`;
// - the world's functions in `world.functions` order: name, span start and
//   end, own and closure capability bits (1 ConstTime, 2 Realtime,
//   4 DetFloat, 8 ConstDenorm), "specialized into its callers"
//   (`not_emitted`), `is_declassify_gate`, the parameter names;
// - mode 1 only, `capability_policies`: const_time (function, secret
//   parameter indices, declassify callees, constant-time callees), realtime
//   functions (function, has budget, budget), reject_unbounded_loops,
//   det_float (function, allowed float calls, allow_fma);
// - the policy (`NativeVerifierPolicy`, maps in key order);
// - the object ISA: status (0, or 1 and its error), architecture (0 x86_64,
//   1 aarch64, 2 other) and its name;
// - the emitted functions (`EmittedFunction`s, see `read_fn`).
//
// Lists are a count then their words; strings are symbols.

use @vesper/check-data::names::{Names, names_new};
use @vesper/check-data::util::{n32};
use self::util::{g, filled, put_at, st};

pub struct Reader {
    pos: u64,
}

impl Reader {
    pub fn word(inout self, in bytes: Slice[u8]) -> u64 {
        let value = match bytes.try_read_u64_le(self.pos) {
            Option::Some(value) => value,
            Option::None => 0,
        };
        self.pos = wrapping_add(self.pos, 8);
        value
    }

    // A list: appends its words to `pool` and returns (at, n).
    pub fn list(inout self, in bytes: Slice[u8], inout pool: ChunkSeq[u64]) -> (u64, u64) {
        let n = self.word(in bytes);
        let at = pool.len();
        for i in 0..n {
            pool.push(self.word(in bytes));
        }
        (at, n)
    }
}

// Words per row of the tables below.
pub const WFW: u64 = 9;
pub const FW: u64 = 37;
pub const IW: u64 = 26;
pub const VW: u64 = 3;
pub const BW: u64 = 4;
pub const FDW: u64 = 13;
pub const RW: u64 = 7;

// World function rows (WFW).
pub const WF_NAME: u64 = 0;
pub const WF_START: u64 = 1;
pub const WF_END: u64 = 2;
pub const WF_OWN: u64 = 3;
pub const WF_CLOSURE: u64 = 4;
pub const WF_SPECIALIZED: u64 = 5;
pub const WF_GATE: u64 = 6;
pub const WF_PARAMS: u64 = 7;

// Emitted function rows (FW).
pub const F_KEY: u64 = 0;
pub const F_SOURCE: u64 = 1;
pub const F_SYMBOL: u64 = 2;
pub const F_ID: u64 = 3;
pub const F_OPTIMIZED: u64 = 4;
pub const F_INLINED: u64 = 5;
pub const F_CALLEES: u64 = 7;
pub const F_BOUND: u64 = 9;
pub const F_INST_ERR: u64 = 11;
pub const F_INST_MSG: u64 = 12;
pub const F_SRET: u64 = 13;
pub const F_SRET_MSG: u64 = 14;
pub const F_PARAMS: u64 = 15;
pub const F_VERIFY_ERR: u64 = 17;
pub const F_VERIFY_MSG: u64 = 18;
pub const F_COMPILE: u64 = 19;
pub const F_COMPILE_MSG: u64 = 20;
pub const F_CODE_LEN: u64 = 21;
pub const F_CODE_AT: u64 = 22;
pub const F_FRAME_SIZE: u64 = 23;
pub const F_LIBCALLS: u64 = 24;
pub const F_NAME: u64 = 26;
pub const F_VALS: u64 = 27;
pub const F_NVALS: u64 = 28;
pub const F_SLOTS: u64 = 29;
pub const F_BLOCKS: u64 = 31;
pub const F_NBLOCKS: u64 = 32;
pub const F_INSTS: u64 = 33;
pub const F_NINSTS: u64 = 34;
pub const F_NUM_INSTS: u64 = 35;
pub const F_ENTS: u64 = 36;

// Instruction rows (IW), in layout order.
pub const I_ENT: u64 = 0;
pub const I_OP: u64 = 1;
pub const I_FLAGS: u64 = 2;
pub const I_FMT: u64 = 3;
pub const I_OPNAME: u64 = 4;
pub const I_ARGS: u64 = 5;
pub const I_RESULTS: u64 = 7;
pub const I_SLOT: u64 = 9;
pub const I_IMM: u64 = 10;
pub const I_COND: u64 = 11;
pub const I_CONST_LEN: u64 = 12;
pub const I_CONST: u64 = 13;
pub const I_CALL: u64 = 15;
pub const I_CARGS: u64 = 16;
pub const I_SIG_FLOAT: u64 = 18;
pub const I_EXT: u64 = 19;
pub const I_DATA_EXT: u64 = 20;
pub const I_DESTS: u64 = 21;
pub const I_HAS_LOC: u64 = 23;
pub const I_LOC: u64 = 24;
pub const I_BLOCK: u64 = 25;

// Flag bits of I_FLAGS.
pub const IS_CALL: u64 = 1;
pub const CAN_LOAD: u64 = 2;
pub const CAN_STORE: u64 = 4;
pub const CAN_TRAP: u64 = 8;

// External name records in `pool` (six words).
pub const X_KIND: u64 = 0;
pub const X_NS: u64 = 1;
pub const X_INDEX: u64 = 2;
pub const X_DISPLAY: u64 = 3;
pub const X_S1: u64 = 4;
pub const X_S2: u64 = 5;
pub const EXT_USER: u64 = 0;
pub const EXT_TESTCASE: u64 = 1;
pub const EXT_LIBCALL: u64 = 2;
pub const EXT_KNOWN: u64 = 3;

// Verifier bits.
pub const V_CT: u64 = 1;
pub const V_STACK: u64 = 2;
pub const V_RT: u64 = 4;
pub const V_DF: u64 = 8;

// Capability bits.
pub const CAP_CT: u64 = 1;
pub const CAP_RT: u64 = 2;
pub const CAP_DF: u64 = 4;
pub const CAP_DENORM: u64 = 8;

// `NativeVerifierPolicy` as rows over its own list pool `list_pool`. Map rows are
// kept in key order (`BTreeMap`).
pub struct Policy {
    list_pool: ChunkSeq[u64],
    // key, secret (at, n), declassify (at, n), constant-time callees (at, n)
    const_time: ChunkSeq[u64],
    // key, budget
    stack_roots: ChunkSeq[u64],
    stack_ext_bounds: ChunkSeq[u64],
    // key, has budget, budget
    rt_roots: ChunkSeq[u64],
    rt_has_allowed: bool,
    rt_allowed: ChunkSeq[u64],
    // key, effects (at, n), frame bytes
    rt_symbols: ChunkSeq[u64],
    // key, effects (at, n)
    rt_effects: ChunkSeq[u64],
    // key, bound
    rt_loop_bounds: ChunkSeq[u64],
    rt_reject_unbounded: bool,
    rt_has_max_iters: bool,
    rt_max_iters: u64,
    df_has_functions: bool,
    df_functions: ChunkSeq[u64],
    df_allow_fma: bool,
    df_allowed_calls: ChunkSeq[u64],
    df_has_reduction: bool,
    df_reduction_order: u64,
}

// `NativeVerifierReport`, its text in `text`.
pub struct Report {
    pub text: ChunkSeq[u8],
    pub verifiers: u64,
    pub functions: u64,
    // (at, len) in text
    pub notes: ChunkSeq[u64],
    // FDW: verifier bit, function, has inst, inst, rule (at, len), message
    // (at, len), has span, start, end, has location, location
    pub findings: ChunkSeq[u64],
    pub has_stack: bool,
    // root, budget, has worst, worst, within, path (at, n in spool)
    pub sr: ChunkSeq[u64],
    pub spool: ChunkSeq[u64],
    // function, has inst, inst, rule (at, len), message (at, len)
    pub sf: ChunkSeq[u64],
}

pub fn report_new() -> Report {
    Report {
        text: ChunkSeq::new[u8](),
        verifiers: 0,
        functions: 0,
        notes: ChunkSeq::new[u64](),
        findings: ChunkSeq::new[u64](),
        has_stack: false,
        sr: ChunkSeq::new[u64](),
        spool: ChunkSeq::new[u64](),
        sf: ChunkSeq::new[u64](),
    }
}

pub struct Cx {
    names: Names,
    mode: u64,
    requested: u64,
    file: u64,
    source: u64,
    canonical_nan: bool,
    world_fns: ChunkSeq[u64],
    // symbol -> world function row + 1
    world_by_name: ChunkSeq[u64],
    pool: ChunkSeq[u64],
    // capability facts
    cap_const_time: ChunkSeq[u64],
    cap_realtime: ChunkSeq[u64],
    cap_reject_unbounded: bool,
    cap_det_float: ChunkSeq[u64],
    policy: Policy,
    isa_err: bool,
    arch: u64,
    arch_name: u64,
    fn_count: u64,
    fns: ChunkSeq[u64],
    vals: ChunkSeq[u64],
    blocks: ChunkSeq[u64],
    insts: ChunkSeq[u64],
    code: ChunkSeq[u64],
    report: Report,
    failed: bool,
    error_text: ChunkSeq[u8],
    // `Names` of native_verifiers.rs: func id -> symbol + 1, symbol ->
    // func id + 1, defined func ids; and key -> emitted function + 1.
    by_id: ChunkSeq[u64],
    by_name: ChunkSeq[u64],
    defined: ChunkSeq[u64],
    by_key: ChunkSeq[u64],
    // notes of the derived policy (mode 1), after the verifiers' own
    derived_notes: ChunkSeq[u64],
    // a verifier's own findings before `push` maps them to source (RW):
    // function, has inst, inst, rule (at, len), message (at, len) in report.text
    raw_findings: ChunkSeq[u64],
}

fn read_strings(inout reader: Reader, in bytes: Slice[u8], inout names: Names) {
    let count = reader.word(in bytes);
    for i in 0..count {
        let len = reader.word(in bytes);
        let start = reader.pos;
        let sym = names.intern(in bytes[start..wrapping_add(start, len)]);
        reader.pos = wrapping_add(start, wrapping_mul(wrapping_add(len, 7) / 8, 8));
    }
}

fn row2(inout rows: ChunkSeq[u64], inout reader: Reader, in bytes: Slice[u8]) {
    let n = reader.word(in bytes);
    for i in 0..n {
        rows.push(reader.word(in bytes));
        rows.push(reader.word(in bytes));
    }
}

fn read_policy(inout reader: Reader, in bytes: Slice[u8]) -> Policy {
    let mut policy = Policy {
        list_pool: ChunkSeq::new[u64](),
        const_time: ChunkSeq::new[u64](),
        stack_roots: ChunkSeq::new[u64](),
        stack_ext_bounds: ChunkSeq::new[u64](),
        rt_roots: ChunkSeq::new[u64](),
        rt_has_allowed: false,
        rt_allowed: ChunkSeq::new[u64](),
        rt_symbols: ChunkSeq::new[u64](),
        rt_effects: ChunkSeq::new[u64](),
        rt_loop_bounds: ChunkSeq::new[u64](),
        rt_reject_unbounded: true,
        rt_has_max_iters: false,
        rt_max_iters: 0,
        df_has_functions: false,
        df_functions: ChunkSeq::new[u64](),
        df_allow_fma: false,
        df_allowed_calls: ChunkSeq::new[u64](),
        df_has_reduction: false,
        df_reduction_order: 0,
    };
    let ct_count = reader.word(in bytes);
    for i in 0..ct_count {
        policy.const_time.push(reader.word(in bytes));
        for k in 0..3 {
            let (at, n) = reader.list(in bytes, inout policy.list_pool);
            policy.const_time.push(at);
            policy.const_time.push(n);
        }
    }
    row2(inout policy.stack_roots, inout reader, in bytes);
    row2(inout policy.stack_ext_bounds, inout reader, in bytes);
    let root_count = reader.word(in bytes);
    for i in 0..root_count {
        policy.rt_roots.push(reader.word(in bytes));
        policy.rt_roots.push(reader.word(in bytes));
        policy.rt_roots.push(reader.word(in bytes));
    }
    policy.rt_has_allowed = reader.word(in bytes) == 1;
    let (rt_allowed_at, rt_allowed_count) = reader.list(in bytes, inout policy.list_pool);
    for k in 0..rt_allowed_count {
        policy.rt_allowed.push(g(in policy.list_pool, wrapping_add(rt_allowed_at, k)));
    }
    let symbol_count = reader.word(in bytes);
    for i in 0..symbol_count {
        policy.rt_symbols.push(reader.word(in bytes));
        let (at, n) = reader.list(in bytes, inout policy.list_pool);
        policy.rt_symbols.push(at);
        policy.rt_symbols.push(n);
        policy.rt_symbols.push(reader.word(in bytes));
    }
    let effect_count = reader.word(in bytes);
    for i in 0..effect_count {
        policy.rt_effects.push(reader.word(in bytes));
        let (at, n) = reader.list(in bytes, inout policy.list_pool);
        policy.rt_effects.push(at);
        policy.rt_effects.push(n);
    }
    row2(inout policy.rt_loop_bounds, inout reader, in bytes);
    policy.rt_reject_unbounded = reader.word(in bytes) == 1;
    policy.rt_has_max_iters = reader.word(in bytes) == 1;
    policy.rt_max_iters = reader.word(in bytes);
    policy.df_has_functions = reader.word(in bytes) == 1;
    let (df_fn_at, df_fn_count) = reader.list(in bytes, inout policy.list_pool);
    for k in 0..df_fn_count {
        policy.df_functions.push(g(in policy.list_pool, wrapping_add(df_fn_at, k)));
    }
    policy.df_allow_fma = reader.word(in bytes) == 1;
    let (df_allowed_at, df_allowed_count) = reader.list(in bytes, inout policy.list_pool);
    for k in 0..df_allowed_count {
        policy.df_allowed_calls.push(g(in policy.list_pool, wrapping_add(df_allowed_at, k)));
    }
    policy.df_has_reduction = reader.word(in bytes) == 1;
    policy.df_reduction_order = reader.word(in bytes);
    policy
}

// An external name record: appended to `pool`, its index returned.
fn read_ext(inout reader: Reader, in bytes: Slice[u8], inout pool: ChunkSeq[u64]) -> u64 {
    let at = pool.len();
    for k in 0..6 {
        pool.push(reader.word(in bytes));
    }
    at
}

// One emitted function: its header row and its CLIF tables.
fn read_fn(inout ctx: Cx, inout reader: Reader, in bytes: Slice[u8]) {
    let base = ctx.fns.len();
    ctx.fns.resize(wrapping_add(base, FW), 0);
    st(inout ctx.fns, wrapping_add(base, F_KEY), reader.word(in bytes));
    st(inout ctx.fns, wrapping_add(base, F_SOURCE), reader.word(in bytes));
    st(inout ctx.fns, wrapping_add(base, F_SYMBOL), reader.word(in bytes));
    st(inout ctx.fns, wrapping_add(base, F_ID), reader.word(in bytes));
    st(inout ctx.fns, wrapping_add(base, F_OPTIMIZED), reader.word(in bytes));
    let (inlined_at, inlined_count) = reader.list(in bytes, inout ctx.pool);
    st(inout ctx.fns, wrapping_add(base, F_INLINED), inlined_at);
    st(inout ctx.fns, wrapping_add(base, wrapping_add(F_INLINED, 1)), inlined_count);
    let callee_count = reader.word(in bytes);
    st(inout ctx.fns, wrapping_add(base, F_CALLEES), ctx.pool.len());
    st(inout ctx.fns, wrapping_add(base, wrapping_add(F_CALLEES, 1)), callee_count);
    for k in 0..callee_count {
        ctx.pool.push(reader.word(in bytes));
        ctx.pool.push(reader.word(in bytes));
    }
    let (bound_at, bound_count) = reader.list(in bytes, inout ctx.pool);
    st(inout ctx.fns, wrapping_add(base, F_BOUND), bound_at);
    st(inout ctx.fns, wrapping_add(base, wrapping_add(F_BOUND, 1)), bound_count);
    let inst_err = reader.word(in bytes);
    st(inout ctx.fns, wrapping_add(base, F_INST_ERR), inst_err);
    if inst_err == 1 {
        st(inout ctx.fns, wrapping_add(base, F_INST_MSG), reader.word(in bytes));
    } else {
        st(inout ctx.fns, wrapping_add(base, F_SRET), reader.word(in bytes));
        st(inout ctx.fns, wrapping_add(base, F_SRET_MSG), reader.word(in bytes));
        let fn_param_count = reader.word(in bytes);
        st(inout ctx.fns, wrapping_add(base, F_PARAMS), ctx.pool.len());
        st(inout ctx.fns, wrapping_add(base, wrapping_add(F_PARAMS, 1)), fn_param_count);
        for k in 0..fn_param_count {
            ctx.pool.push(reader.word(in bytes));
            ctx.pool.push(reader.word(in bytes));
            ctx.pool.push(reader.word(in bytes));
        }
    }
    st(inout ctx.fns, wrapping_add(base, F_VERIFY_ERR), reader.word(in bytes));
    st(inout ctx.fns, wrapping_add(base, F_VERIFY_MSG), reader.word(in bytes));
    let status = reader.word(in bytes);
    st(inout ctx.fns, wrapping_add(base, F_COMPILE), status);
    if status == 0 {
        st(inout ctx.fns, wrapping_add(base, F_CODE_LEN), reader.word(in bytes));
        let (code_at, code_words) = reader.list(in bytes, inout ctx.code);
        st(inout ctx.fns, wrapping_add(base, F_CODE_AT), code_at);
        st(inout ctx.fns, wrapping_add(base, F_FRAME_SIZE), reader.word(in bytes));
        let (libcalls_at, libcall_count) = reader.list(in bytes, inout ctx.pool);
        st(inout ctx.fns, wrapping_add(base, F_LIBCALLS), libcalls_at);
        st(inout ctx.fns, wrapping_add(base, wrapping_add(F_LIBCALLS, 1)), libcall_count);
    } else if status == 1 {
        st(inout ctx.fns, wrapping_add(base, F_COMPILE_MSG), reader.word(in bytes));
    }
    // CLIF
    st(inout ctx.fns, wrapping_add(base, F_NAME), reader.word(in bytes));
    let value_count = reader.word(in bytes);
    st(inout ctx.fns, wrapping_add(base, F_VALS), ctx.vals.len() / VW);
    st(inout ctx.fns, wrapping_add(base, F_NVALS), value_count);
    for k in 0..value_count {
        ctx.vals.push(reader.word(in bytes));
        ctx.vals.push(reader.word(in bytes));
        ctx.vals.push(reader.word(in bytes));
    }
    let (slots_at, slot_count) = reader.list(in bytes, inout ctx.pool);
    st(inout ctx.fns, wrapping_add(base, F_SLOTS), slots_at);
    st(inout ctx.fns, wrapping_add(base, wrapping_add(F_SLOTS, 1)), slot_count);
    let block_count = reader.word(in bytes);
    let block_base = ctx.blocks.len() / BW;
    let inst_base = ctx.insts.len() / IW;
    st(inout ctx.fns, wrapping_add(base, F_BLOCKS), block_base);
    st(inout ctx.fns, wrapping_add(base, F_NBLOCKS), block_count);
    st(inout ctx.fns, wrapping_add(base, F_INSTS), inst_base);
    for blk in 0..block_count {
        let (block_param_at, block_param_count) = reader.list(in bytes, inout ctx.pool);
        let block_inst_count = reader.word(in bytes);
        ctx.blocks.push(block_param_at);
        ctx.blocks.push(block_param_count);
        ctx.blocks.push(ctx.insts.len() / IW);
        ctx.blocks.push(block_inst_count);
        for k in 0..block_inst_count {
            let row = ctx.insts.len();
            ctx.insts.resize(wrapping_add(row, IW), 0);
            st(inout ctx.insts, wrapping_add(row, I_ENT), reader.word(in bytes));
            st(inout ctx.insts, wrapping_add(row, I_OP), reader.word(in bytes));
            st(inout ctx.insts, wrapping_add(row, I_FLAGS), reader.word(in bytes));
            st(inout ctx.insts, wrapping_add(row, I_FMT), reader.word(in bytes));
            st(inout ctx.insts, wrapping_add(row, I_OPNAME), reader.word(in bytes));
            let (args_at, arg_count) = reader.list(in bytes, inout ctx.pool);
            st(inout ctx.insts, wrapping_add(row, I_ARGS), args_at);
            st(inout ctx.insts, wrapping_add(row, wrapping_add(I_ARGS, 1)), arg_count);
            let (results_at, result_count) = reader.list(in bytes, inout ctx.pool);
            st(inout ctx.insts, wrapping_add(row, I_RESULTS), results_at);
            st(inout ctx.insts, wrapping_add(row, wrapping_add(I_RESULTS, 1)), result_count);
            st(inout ctx.insts, wrapping_add(row, I_SLOT), reader.word(in bytes));
            st(inout ctx.insts, wrapping_add(row, I_IMM), reader.word(in bytes));
            st(inout ctx.insts, wrapping_add(row, I_COND), reader.word(in bytes));
            st(inout ctx.insts, wrapping_add(row, I_CONST_LEN), reader.word(in bytes));
            let (const_at, const_words) = reader.list(in bytes, inout ctx.pool);
            st(inout ctx.insts, wrapping_add(row, I_CONST), const_at);
            st(inout ctx.insts, wrapping_add(row, wrapping_add(I_CONST, 1)), const_words);
            let call_kind = reader.word(in bytes);
            st(inout ctx.insts, wrapping_add(row, I_CALL), call_kind);
            if call_kind != 0 {
                let (call_args_at, call_arg_count) = reader.list(in bytes, inout ctx.pool);
                st(inout ctx.insts, wrapping_add(row, I_CARGS), call_args_at);
                st(inout ctx.insts, wrapping_add(row, wrapping_add(I_CARGS, 1)), call_arg_count);
                st(inout ctx.insts, wrapping_add(row, I_SIG_FLOAT), reader.word(in bytes));
                if call_kind == 1 {
                    let ext_at = read_ext(inout reader, in bytes, inout ctx.pool);
                    st(inout ctx.insts, wrapping_add(row, I_EXT), ext_at);
                }
            }
            if reader.word(in bytes) == 1 {
                let ext_at = read_ext(inout reader, in bytes, inout ctx.pool);
                st(inout ctx.insts, wrapping_add(row, I_DATA_EXT), wrapping_add(ext_at, 1));
            }
            let dest_count = reader.word(in bytes);
            st(inout ctx.insts, wrapping_add(row, I_DESTS), ctx.pool.len());
            st(inout ctx.insts, wrapping_add(row, wrapping_add(I_DESTS, 1)), dest_count);
            for d in 0..dest_count {
                ctx.pool.push(reader.word(in bytes));
                let block_arg_count = reader.word(in bytes);
                ctx.pool.push(block_arg_count);
                for k2 in 0..block_arg_count {
                    ctx.pool.push(reader.word(in bytes));
                    ctx.pool.push(reader.word(in bytes));
                }
            }
            st(inout ctx.insts, wrapping_add(row, I_HAS_LOC), reader.word(in bytes));
            st(inout ctx.insts, wrapping_add(row, I_LOC), reader.word(in bytes));
            st(inout ctx.insts, wrapping_add(row, I_BLOCK), blk);
        }
    }
    let inst_count = wrapping_sub(ctx.insts.len() / IW, inst_base);
    st(inout ctx.fns, wrapping_add(base, F_NINSTS), inst_count);
    let entity_count = reader.word(in bytes);
    st(inout ctx.fns, wrapping_add(base, F_NUM_INSTS), entity_count);
    // entity -> layout row + 1 (global row)
    let entity_map = ctx.pool.len();
    ctx.pool.resize(wrapping_add(entity_map, entity_count), 0);
    for k in 0..inst_count {
        let row = wrapping_add(inst_base, k);
        let ent = g(in ctx.insts, wrapping_add(wrapping_mul(row, IW), I_ENT));
        if ent < entity_count {
            st(inout ctx.pool, wrapping_add(entity_map, ent), wrapping_add(row, 1));
        }
    }
    st(inout ctx.fns, wrapping_add(base, F_ENTS), entity_map);
}

pub fn read_input(in bytes: Slice[u8]) -> Cx {
    let mut reader = Reader { pos: 0 };
    let mut names = names_new();
    read_strings(inout reader, in bytes, inout names);
    let word_count = reader.word(in bytes);
    let mode = reader.word(in bytes);
    let requested = reader.word(in bytes);
    let file = reader.word(in bytes);
    let source = reader.word(in bytes);
    let canonical_nan = reader.word(in bytes) == 1;
    let mut ctx = Cx {
        names: names,
        mode: mode,
        requested: requested,
        file: file,
        source: source,
        canonical_nan: canonical_nan,
        world_fns: ChunkSeq::new[u64](),
        world_by_name: ChunkSeq::new[u64](),
        pool: ChunkSeq::new[u64](),
        cap_const_time: ChunkSeq::new[u64](),
        cap_realtime: ChunkSeq::new[u64](),
        cap_reject_unbounded: false,
        cap_det_float: ChunkSeq::new[u64](),
        policy: read_policy_placeholder(),
        isa_err: false,
        arch: 0,
        arch_name: 0,
        fn_count: 0,
        fns: ChunkSeq::new[u64](),
        vals: ChunkSeq::new[u64](),
        blocks: ChunkSeq::new[u64](),
        insts: ChunkSeq::new[u64](),
        code: ChunkSeq::new[u64](),
        report: report_new(),
        failed: false,
        error_text: ChunkSeq::new[u8](),
        by_id: ChunkSeq::new[u64](),
        by_name: ChunkSeq::new[u64](),
        defined: ChunkSeq::new[u64](),
        by_key: ChunkSeq::new[u64](),
        derived_notes: ChunkSeq::new[u64](),
        raw_findings: ChunkSeq::new[u64](),
    };
    let world_fn_count = reader.word(in bytes);
    for i in 0..world_fn_count {
        let name = reader.word(in bytes);
        ctx.world_fns.push(name);
        for k in 0..6 {
            ctx.world_fns.push(reader.word(in bytes));
        }
        let (param_at, param_count) = reader.list(in bytes, inout ctx.pool);
        ctx.world_fns.push(param_at);
        ctx.world_fns.push(param_count);
        put_at(inout ctx.world_by_name, name, wrapping_add(i, 1));
    }
    if mode == 1 {
        let ct_count = reader.word(in bytes);
        for i in 0..ct_count {
            ctx.cap_const_time.push(reader.word(in bytes));
            for k in 0..3 {
                let (at, n) = reader.list(in bytes, inout ctx.pool);
                ctx.cap_const_time.push(at);
                ctx.cap_const_time.push(n);
            }
        }
        let rt_count = reader.word(in bytes);
        for i in 0..rt_count {
            ctx.cap_realtime.push(reader.word(in bytes));
            ctx.cap_realtime.push(reader.word(in bytes));
            ctx.cap_realtime.push(reader.word(in bytes));
        }
        ctx.cap_reject_unbounded = reader.word(in bytes) == 1;
        let df_count = reader.word(in bytes);
        for i in 0..df_count {
            ctx.cap_det_float.push(reader.word(in bytes));
            let (at, n) = reader.list(in bytes, inout ctx.pool);
            ctx.cap_det_float.push(at);
            ctx.cap_det_float.push(n);
            ctx.cap_det_float.push(reader.word(in bytes));
        }
    }
    ctx.policy = read_policy(inout reader, in bytes);
    ctx.isa_err = reader.word(in bytes) == 1;
    ctx.arch = reader.word(in bytes);
    ctx.arch_name = reader.word(in bytes);
    let fn_count = reader.word(in bytes);
    ctx.fn_count = fn_count;
    for i in 0..fn_count {
        read_fn(inout ctx, inout reader, in bytes);
    }
    ctx
}

fn read_policy_placeholder() -> Policy {
    Policy {
        list_pool: ChunkSeq::new[u64](),
        const_time: ChunkSeq::new[u64](),
        stack_roots: ChunkSeq::new[u64](),
        stack_ext_bounds: ChunkSeq::new[u64](),
        rt_roots: ChunkSeq::new[u64](),
        rt_has_allowed: false,
        rt_allowed: ChunkSeq::new[u64](),
        rt_symbols: ChunkSeq::new[u64](),
        rt_effects: ChunkSeq::new[u64](),
        rt_loop_bounds: ChunkSeq::new[u64](),
        rt_reject_unbounded: true,
        rt_has_max_iters: false,
        rt_max_iters: 0,
        df_has_functions: false,
        df_functions: ChunkSeq::new[u64](),
        df_allow_fma: false,
        df_allowed_calls: ChunkSeq::new[u64](),
        df_has_reduction: false,
        df_reduction_order: 0,
    }
}

// ----- accessors -------------------------------------------------------------

pub fn fw(in ctx: Cx, func: u64, field: u64) -> u64 {
    g(in ctx.fns, wrapping_add(wrapping_mul(func, FW), field))
}

pub fn iw(in ctx: Cx, row: u64, field: u64) -> u64 {
    g(in ctx.insts, wrapping_add(wrapping_mul(row, IW), field))
}

pub fn pw(in ctx: Cx, i: u64) -> u64 {
    g(in ctx.pool, i)
}

pub fn wfw(in ctx: Cx, row: u64, field: u64) -> u64 {
    g(in ctx.world_fns, wrapping_add(wrapping_mul(row, WFW), field))
}

// The world function named `sym` (row), or NONE.
pub fn world_fn(in ctx: Cx, sym: u64) -> u64 {
    let entry = g(in ctx.world_by_name, sym);
    if entry == 0 {
        18446744073709551615
    } else {
        wrapping_sub(entry, 1)
    }
}

// Value `v` of function `func`: the alias-resolved value, the type word and the
// defining instruction entity + 1.
pub fn val(in ctx: Cx, func: u64, v: u64, field: u64) -> u64 {
    g(in ctx.vals, wrapping_add(wrapping_mul(wrapping_add(fw(in ctx, func, F_VALS), v), VW), field))
}

// The global layout row of entity `ent` of function `func`, or NONE.
pub fn ent_row(in ctx: Cx, func: u64, ent: u64) -> u64 {
    if ent >= fw(in ctx, func, F_NUM_INSTS) {
        return 18446744073709551615;
    }
    let entry = g(in ctx.pool, wrapping_add(fw(in ctx, func, F_ENTS), ent));
    if entry == 0 {
        18446744073709551615
    } else {
        wrapping_sub(entry, 1)
    }
}

// The i-th argument of instruction row `row`.
pub fn arg(in ctx: Cx, row: u64, i: u64) -> u64 {
    g(in ctx.pool, wrapping_add(iw(in ctx, row, I_ARGS), i))
}

pub fn nargs(in ctx: Cx, row: u64) -> u64 {
    iw(in ctx, row, wrapping_add(I_ARGS, 1))
}

pub fn block_row(in ctx: Cx, func: u64, blk: u64, field: u64) -> u64 {
    g(
        in ctx.blocks,
        wrapping_add(wrapping_mul(wrapping_add(fw(in ctx, func, F_BLOCKS), blk), BW), field)
    )
}
