// Module input of @vesper/backend-checks (see lib.ves): the decoder of the
// harness input (tests/common/backend_checks_input.rs) into flat tables.
//
// The input is little-endian u64 words in one `Str`: a string table (each
// string a byte length and its bytes padded to eight; string i is Names
// symbol i, 0 the empty string), then a word count and the words:
//
// - mode (0: `verify_emitted` under the policy; 1: the capability verifiers
//   of `verify_native_with_capabilities` under the policy derived over it),
//   the requested verifiers (bits: 1 const-time, 2 stack, 4 realtime,
//   8 detfloat), the file name, the source, `needs_nan_canonicalization`;
// - the world's functions in `world.functions` order: name, span start and
//   end, own and closure capability bits (1 ConstTime, 2 Realtime,
//   4 DetFloat, 8 ConstDenorm), "specialized into its callers"
//   (`not_emitted`), `is_declassify_gate`, the parameter names;
// - mode 1 only, `capability_policies`: const_time (function, secret
//   parameter indices, declassify callees, constant-time callees), realtime
//   functions (function, has budget, budget), reject_unbounded_loops,
//   det_float (function, allowed float calls, allow_fma);
// - the policy (`NativeVerifierPolicy`, maps in key order);
// - the object ISA: status (0, or 1 and its error), architecture (0 x86_64,
//   1 aarch64, 2 other) and its name;
// - the emitted functions (`EmittedFunction`s, see `read_fn`).
//
// Lists are a count then their words; strings are symbols.

use @vesper/check-data::names::{
    Names,
    names_new
};
use @vesper/check-data::util::{
    n32
};
use self::util::{
    g,
    filled,
    put_at,
    st
};

pub struct Reader {
    pos: u64,
}

impl Reader {
    pub fn word(inout self, in b: Slice[u8]) -> u64 {
        let x = match b.try_read_u64_le(self.pos) {
            Option::Some(x) => x,
            Option::None => 0,
        };
        self.pos = wrapping_add(self.pos, 8);
        x
    }

    // A list: appends its words to `pool` and returns (at, n).
    pub fn list(inout self, in b: Slice[u8], inout pool: ChunkSeq[u64]) -> (u64, u64) {
        let n = self.word(in b);
        let at = pool.len();
        for i in 0..n {
            pool.push(self.word(in b));
        }
        (at, n)
    }
}

// Words per row of the tables below.
pub const WFW: u64 = 9;
pub const FW: u64 = 37;
pub const IW: u64 = 26;
pub const VW: u64 = 3;
pub const BW: u64 = 4;
pub const FDW: u64 = 13;
pub const RW: u64 = 7;

// World function rows (WFW).
pub const WF_NAME: u64 = 0;
pub const WF_START: u64 = 1;
pub const WF_END: u64 = 2;
pub const WF_OWN: u64 = 3;
pub const WF_CLOSURE: u64 = 4;
pub const WF_SPECIALIZED: u64 = 5;
pub const WF_GATE: u64 = 6;
pub const WF_PARAMS: u64 = 7;

// Emitted function rows (FW).
pub const F_KEY: u64 = 0;
pub const F_SOURCE: u64 = 1;
pub const F_SYMBOL: u64 = 2;
pub const F_ID: u64 = 3;
pub const F_OPTIMIZED: u64 = 4;
pub const F_INLINED: u64 = 5;
pub const F_CALLEES: u64 = 7;
pub const F_BOUND: u64 = 9;
pub const F_INST_ERR: u64 = 11;
pub const F_INST_MSG: u64 = 12;
pub const F_SRET: u64 = 13;
pub const F_SRET_MSG: u64 = 14;
pub const F_PARAMS: u64 = 15;
pub const F_VERIFY_ERR: u64 = 17;
pub const F_VERIFY_MSG: u64 = 18;
pub const F_COMPILE: u64 = 19;
pub const F_COMPILE_MSG: u64 = 20;
pub const F_CODE_LEN: u64 = 21;
pub const F_CODE_AT: u64 = 22;
pub const F_FRAME_SIZE: u64 = 23;
pub const F_LIBCALLS: u64 = 24;
pub const F_NAME: u64 = 26;
pub const F_VALS: u64 = 27;
pub const F_NVALS: u64 = 28;
pub const F_SLOTS: u64 = 29;
pub const F_BLOCKS: u64 = 31;
pub const F_NBLOCKS: u64 = 32;
pub const F_INSTS: u64 = 33;
pub const F_NINSTS: u64 = 34;
pub const F_NUM_INSTS: u64 = 35;
pub const F_ENTS: u64 = 36;

// Instruction rows (IW), in layout order.
pub const I_ENT: u64 = 0;
pub const I_OP: u64 = 1;
pub const I_FLAGS: u64 = 2;
pub const I_FMT: u64 = 3;
pub const I_OPNAME: u64 = 4;
pub const I_ARGS: u64 = 5;
pub const I_RESULTS: u64 = 7;
pub const I_SLOT: u64 = 9;
pub const I_IMM: u64 = 10;
pub const I_COND: u64 = 11;
pub const I_CONST_LEN: u64 = 12;
pub const I_CONST: u64 = 13;
pub const I_CALL: u64 = 15;
pub const I_CARGS: u64 = 16;
pub const I_SIG_FLOAT: u64 = 18;
pub const I_EXT: u64 = 19;
pub const I_DATA_EXT: u64 = 20;
pub const I_DESTS: u64 = 21;
pub const I_HAS_LOC: u64 = 23;
pub const I_LOC: u64 = 24;
pub const I_BLOCK: u64 = 25;

// Flag bits of I_FLAGS.
pub const IS_CALL: u64 = 1;
pub const CAN_LOAD: u64 = 2;
pub const CAN_STORE: u64 = 4;
pub const CAN_TRAP: u64 = 8;

// External name records in `pool` (six words).
pub const X_KIND: u64 = 0;
pub const X_NS: u64 = 1;
pub const X_INDEX: u64 = 2;
pub const X_DISPLAY: u64 = 3;
pub const X_S1: u64 = 4;
pub const X_S2: u64 = 5;
pub const EXT_USER: u64 = 0;
pub const EXT_TESTCASE: u64 = 1;
pub const EXT_LIBCALL: u64 = 2;
pub const EXT_KNOWN: u64 = 3;

// Verifier bits.
pub const V_CT: u64 = 1;
pub const V_STACK: u64 = 2;
pub const V_RT: u64 = 4;
pub const V_DF: u64 = 8;

// Capability bits.
pub const CAP_CT: u64 = 1;
pub const CAP_RT: u64 = 2;
pub const CAP_DF: u64 = 4;
pub const CAP_DENORM: u64 = 8;

// `NativeVerifierPolicy` as rows over its own list pool `pp`. Map rows are
// kept in key order (`BTreeMap`).
pub struct Policy {
    pp: ChunkSeq[u64],
    // key, secret (at, n), declassify (at, n), constant-time callees (at, n)
    ct: ChunkSeq[u64],
    // key, budget
    sroots: ChunkSeq[u64],
    sext: ChunkSeq[u64],
    // key, has budget, budget
    rroots: ChunkSeq[u64],
    rallowed_has: bool,
    rallowed: ChunkSeq[u64],
    // key, effects (at, n), frame bytes
    rsym: ChunkSeq[u64],
    // key, effects (at, n)
    reff: ChunkSeq[u64],
    // key, bound
    rloop: ChunkSeq[u64],
    rreject: bool,
    rhas_max: bool,
    rmax: u64,
    dfun_has: bool,
    dfun: ChunkSeq[u64],
    dfma: bool,
    dallowed: ChunkSeq[u64],
    dred_has: bool,
    dred: u64,
}

// `NativeVerifierReport`, its text in `tx`.
pub struct Report {
    pub tx: ChunkSeq[u8],
    pub verifiers: u64,
    pub functions: u64,
    // (at, len) in tx
    pub notes: ChunkSeq[u64],
    // FDW: verifier bit, function, has inst, inst, rule (at, len), message
    // (at, len), has span, start, end, has location, location
    pub fd: ChunkSeq[u64],
    pub has_stack: bool,
    // root, budget, has worst, worst, within, path (at, n in spool)
    pub sr: ChunkSeq[u64],
    pub spool: ChunkSeq[u64],
    // function, has inst, inst, rule (at, len), message (at, len)
    pub sf: ChunkSeq[u64],
}

pub fn report_new() -> Report {
    Report {
        tx: ChunkSeq::new[u8](),
        verifiers: 0,
        functions: 0,
        notes: ChunkSeq::new[u64](),
        fd: ChunkSeq::new[u64](),
        has_stack: false,
        sr: ChunkSeq::new[u64](),
        spool: ChunkSeq::new[u64](),
        sf: ChunkSeq::new[u64](),
    }
}

pub struct Cx {
    nm: Names,
    mode: u64,
    requested: u64,
    file: u64,
    source: u64,
    nan: bool,
    wf: ChunkSeq[u64],
    // symbol -> world function row + 1
    wf_by: ChunkSeq[u64],
    pool: ChunkSeq[u64],
    // capability facts
    cct: ChunkSeq[u64],
    crt: ChunkSeq[u64],
    crt_reject: bool,
    cdf: ChunkSeq[u64],
    p: Policy,
    isa_err: bool,
    arch: u64,
    arch_name: u64,
    nfns: u64,
    fns: ChunkSeq[u64],
    vals: ChunkSeq[u64],
    blocks: ChunkSeq[u64],
    insts: ChunkSeq[u64],
    code: ChunkSeq[u64],
    r: Report,
    err: bool,
    emsg: ChunkSeq[u8],
    // `Names` of native_verifiers.rs: func id -> symbol + 1, symbol ->
    // func id + 1, defined func ids; and key -> emitted function + 1.
    by_id: ChunkSeq[u64],
    by_name: ChunkSeq[u64],
    defined: ChunkSeq[u64],
    by_key: ChunkSeq[u64],
    // notes of the derived policy (mode 1), after the verifiers' own
    dnotes: ChunkSeq[u64],
    // a verifier's own findings before `push` maps them to source (RW):
    // function, has inst, inst, rule (at, len), message (at, len) in r.tx
    raw: ChunkSeq[u64],
}

fn read_strings(inout r: Reader, in b: Slice[u8], inout nm: Names) {
    let count = r.word(in b);
    for i in 0..count {
        let len = r.word(in b);
        let start = r.pos;
        let s = nm.intern(in b[start..wrapping_add(start, len)]);
        r.pos = wrapping_add(start, wrapping_mul(wrapping_add(len, 7) / 8, 8));
    }
}

fn row2(inout rows: ChunkSeq[u64], inout r: Reader, in b: Slice[u8]) {
    let n = r.word(in b);
    for i in 0..n {
        rows.push(r.word(in b));
        rows.push(r.word(in b));
    }
}

fn read_policy(inout r: Reader, in b: Slice[u8]) -> Policy {
    let mut p = Policy {
        pp: ChunkSeq::new[u64](),
        ct: ChunkSeq::new[u64](),
        sroots: ChunkSeq::new[u64](),
        sext: ChunkSeq::new[u64](),
        rroots: ChunkSeq::new[u64](),
        rallowed_has: false,
        rallowed: ChunkSeq::new[u64](),
        rsym: ChunkSeq::new[u64](),
        reff: ChunkSeq::new[u64](),
        rloop: ChunkSeq::new[u64](),
        rreject: true,
        rhas_max: false,
        rmax: 0,
        dfun_has: false,
        dfun: ChunkSeq::new[u64](),
        dfma: false,
        dallowed: ChunkSeq::new[u64](),
        dred_has: false,
        dred: 0,
    };
    let nct = r.word(in b);
    for i in 0..nct {
        p.ct.push(r.word(in b));
        for k in 0..3 {
            let (at, n) = r.list(in b, inout p.pp);
            p.ct.push(at);
            p.ct.push(n);
        }
    }
    row2(inout p.sroots, inout r, in b);
    row2(inout p.sext, inout r, in b);
    let nroots = r.word(in b);
    for i in 0..nroots {
        p.rroots.push(r.word(in b));
        p.rroots.push(r.word(in b));
        p.rroots.push(r.word(in b));
    }
    p.rallowed_has = r.word(in b) == 1;
    let (aat, an) = r.list(in b, inout p.pp);
    for k in 0..an {
        p.rallowed.push(g(in p.pp, wrapping_add(aat, k)));
    }
    let nsym = r.word(in b);
    for i in 0..nsym {
        p.rsym.push(r.word(in b));
        let (at, n) = r.list(in b, inout p.pp);
        p.rsym.push(at);
        p.rsym.push(n);
        p.rsym.push(r.word(in b));
    }
    let neff = r.word(in b);
    for i in 0..neff {
        p.reff.push(r.word(in b));
        let (at, n) = r.list(in b, inout p.pp);
        p.reff.push(at);
        p.reff.push(n);
    }
    row2(inout p.rloop, inout r, in b);
    p.rreject = r.word(in b) == 1;
    p.rhas_max = r.word(in b) == 1;
    p.rmax = r.word(in b);
    p.dfun_has = r.word(in b) == 1;
    let (fat, fnn) = r.list(in b, inout p.pp);
    for k in 0..fnn {
        p.dfun.push(g(in p.pp, wrapping_add(fat, k)));
    }
    p.dfma = r.word(in b) == 1;
    let (dat, dn) = r.list(in b, inout p.pp);
    for k in 0..dn {
        p.dallowed.push(g(in p.pp, wrapping_add(dat, k)));
    }
    p.dred_has = r.word(in b) == 1;
    p.dred = r.word(in b);
    p
}

// An external name record: appended to `pool`, its index returned.
fn read_ext(inout r: Reader, in b: Slice[u8], inout pool: ChunkSeq[u64]) -> u64 {
    let at = pool.len();
    for k in 0..6 {
        pool.push(r.word(in b));
    }
    at
}

// One emitted function: its header row and its CLIF tables.
fn read_fn(inout c: Cx, inout r: Reader, in b: Slice[u8]) {
    let base = c.fns.len();
    c.fns.resize(wrapping_add(base, FW), 0);
    st(inout c.fns, wrapping_add(base, F_KEY), r.word(in b));
    st(inout c.fns, wrapping_add(base, F_SOURCE), r.word(in b));
    st(inout c.fns, wrapping_add(base, F_SYMBOL), r.word(in b));
    st(inout c.fns, wrapping_add(base, F_ID), r.word(in b));
    st(inout c.fns, wrapping_add(base, F_OPTIMIZED), r.word(in b));
    let (ia, inn) = r.list(in b, inout c.pool);
    st(inout c.fns, wrapping_add(base, F_INLINED), ia);
    st(inout c.fns, wrapping_add(base, wrapping_add(F_INLINED, 1)), inn);
    let ncal = r.word(in b);
    st(inout c.fns, wrapping_add(base, F_CALLEES), c.pool.len());
    st(inout c.fns, wrapping_add(base, wrapping_add(F_CALLEES, 1)), ncal);
    for k in 0..ncal {
        c.pool.push(r.word(in b));
        c.pool.push(r.word(in b));
    }
    let (ba, bn) = r.list(in b, inout c.pool);
    st(inout c.fns, wrapping_add(base, F_BOUND), ba);
    st(inout c.fns, wrapping_add(base, wrapping_add(F_BOUND, 1)), bn);
    let inst_err = r.word(in b);
    st(inout c.fns, wrapping_add(base, F_INST_ERR), inst_err);
    if inst_err == 1 {
        st(inout c.fns, wrapping_add(base, F_INST_MSG), r.word(in b));
    } else {
        st(inout c.fns, wrapping_add(base, F_SRET), r.word(in b));
        st(inout c.fns, wrapping_add(base, F_SRET_MSG), r.word(in b));
        let np = r.word(in b);
        st(inout c.fns, wrapping_add(base, F_PARAMS), c.pool.len());
        st(inout c.fns, wrapping_add(base, wrapping_add(F_PARAMS, 1)), np);
        for k in 0..np {
            c.pool.push(r.word(in b));
            c.pool.push(r.word(in b));
            c.pool.push(r.word(in b));
        }
    }
    st(inout c.fns, wrapping_add(base, F_VERIFY_ERR), r.word(in b));
    st(inout c.fns, wrapping_add(base, F_VERIFY_MSG), r.word(in b));
    let status = r.word(in b);
    st(inout c.fns, wrapping_add(base, F_COMPILE), status);
    if status == 0 {
        st(inout c.fns, wrapping_add(base, F_CODE_LEN), r.word(in b));
        let (ca, cn) = r.list(in b, inout c.code);
        st(inout c.fns, wrapping_add(base, F_CODE_AT), ca);
        st(inout c.fns, wrapping_add(base, F_FRAME_SIZE), r.word(in b));
        let (la, ln) = r.list(in b, inout c.pool);
        st(inout c.fns, wrapping_add(base, F_LIBCALLS), la);
        st(inout c.fns, wrapping_add(base, wrapping_add(F_LIBCALLS, 1)), ln);
    } else if status == 1 {
        st(inout c.fns, wrapping_add(base, F_COMPILE_MSG), r.word(in b));
    }
    // CLIF
    st(inout c.fns, wrapping_add(base, F_NAME), r.word(in b));
    let nv = r.word(in b);
    st(inout c.fns, wrapping_add(base, F_VALS), c.vals.len() / VW);
    st(inout c.fns, wrapping_add(base, F_NVALS), nv);
    for k in 0..nv {
        c.vals.push(r.word(in b));
        c.vals.push(r.word(in b));
        c.vals.push(r.word(in b));
    }
    let (sa, sn) = r.list(in b, inout c.pool);
    st(inout c.fns, wrapping_add(base, F_SLOTS), sa);
    st(inout c.fns, wrapping_add(base, wrapping_add(F_SLOTS, 1)), sn);
    let nb = r.word(in b);
    let block_base = c.blocks.len() / BW;
    let inst_base = c.insts.len() / IW;
    st(inout c.fns, wrapping_add(base, F_BLOCKS), block_base);
    st(inout c.fns, wrapping_add(base, F_NBLOCKS), nb);
    st(inout c.fns, wrapping_add(base, F_INSTS), inst_base);
    for blk in 0..nb {
        let (pa, pn) = r.list(in b, inout c.pool);
        let ni = r.word(in b);
        c.blocks.push(pa);
        c.blocks.push(pn);
        c.blocks.push(c.insts.len() / IW);
        c.blocks.push(ni);
        for k in 0..ni {
            let row = c.insts.len();
            c.insts.resize(wrapping_add(row, IW), 0);
            st(inout c.insts, wrapping_add(row, I_ENT), r.word(in b));
            st(inout c.insts, wrapping_add(row, I_OP), r.word(in b));
            st(inout c.insts, wrapping_add(row, I_FLAGS), r.word(in b));
            st(inout c.insts, wrapping_add(row, I_FMT), r.word(in b));
            st(inout c.insts, wrapping_add(row, I_OPNAME), r.word(in b));
            let (aa, an) = r.list(in b, inout c.pool);
            st(inout c.insts, wrapping_add(row, I_ARGS), aa);
            st(inout c.insts, wrapping_add(row, wrapping_add(I_ARGS, 1)), an);
            let (ra, rn) = r.list(in b, inout c.pool);
            st(inout c.insts, wrapping_add(row, I_RESULTS), ra);
            st(inout c.insts, wrapping_add(row, wrapping_add(I_RESULTS, 1)), rn);
            st(inout c.insts, wrapping_add(row, I_SLOT), r.word(in b));
            st(inout c.insts, wrapping_add(row, I_IMM), r.word(in b));
            st(inout c.insts, wrapping_add(row, I_COND), r.word(in b));
            st(inout c.insts, wrapping_add(row, I_CONST_LEN), r.word(in b));
            let (ka, kn) = r.list(in b, inout c.pool);
            st(inout c.insts, wrapping_add(row, I_CONST), ka);
            st(inout c.insts, wrapping_add(row, wrapping_add(I_CONST, 1)), kn);
            let call = r.word(in b);
            st(inout c.insts, wrapping_add(row, I_CALL), call);
            if call != 0 {
                let (xa, xn) = r.list(in b, inout c.pool);
                st(inout c.insts, wrapping_add(row, I_CARGS), xa);
                st(inout c.insts, wrapping_add(row, wrapping_add(I_CARGS, 1)), xn);
                st(inout c.insts, wrapping_add(row, I_SIG_FLOAT), r.word(in b));
                if call == 1 {
                    let e = read_ext(inout r, in b, inout c.pool);
                    st(inout c.insts, wrapping_add(row, I_EXT), e);
                }
            }
            if r.word(in b) == 1 {
                let e = read_ext(inout r, in b, inout c.pool);
                st(inout c.insts, wrapping_add(row, I_DATA_EXT), wrapping_add(e, 1));
            }
            let nd = r.word(in b);
            st(inout c.insts, wrapping_add(row, I_DESTS), c.pool.len());
            st(inout c.insts, wrapping_add(row, wrapping_add(I_DESTS, 1)), nd);
            for d in 0..nd {
                c.pool.push(r.word(in b));
                let na = r.word(in b);
                c.pool.push(na);
                for k2 in 0..na {
                    c.pool.push(r.word(in b));
                    c.pool.push(r.word(in b));
                }
            }
            st(inout c.insts, wrapping_add(row, I_HAS_LOC), r.word(in b));
            st(inout c.insts, wrapping_add(row, I_LOC), r.word(in b));
            st(inout c.insts, wrapping_add(row, I_BLOCK), blk);
        }
    }
    let ninsts = wrapping_sub(c.insts.len() / IW, inst_base);
    st(inout c.fns, wrapping_add(base, F_NINSTS), ninsts);
    let num = r.word(in b);
    st(inout c.fns, wrapping_add(base, F_NUM_INSTS), num);
    // entity -> layout row + 1 (global row)
    let ents = c.pool.len();
    c.pool.resize(wrapping_add(ents, num), 0);
    for k in 0..ninsts {
        let row = wrapping_add(inst_base, k);
        let ent = g(in c.insts, wrapping_add(wrapping_mul(row, IW), I_ENT));
        if ent < num {
            st(inout c.pool, wrapping_add(ents, ent), wrapping_add(row, 1));
        }
    }
    st(inout c.fns, wrapping_add(base, F_ENTS), ents);
}

pub fn read_input(in b: Slice[u8]) -> Cx {
    let mut r = Reader {
        pos: 0
    };
    let mut nm = names_new();
    read_strings(inout r, in b, inout nm);
    let words = r.word(in b);
    let mode = r.word(in b);
    let requested = r.word(in b);
    let file = r.word(in b);
    let source = r.word(in b);
    let nan = r.word(in b) == 1;
    let mut c = Cx {
        nm: nm,
        mode: mode,
        requested: requested,
        file: file,
        source: source,
        nan: nan,
        wf: ChunkSeq::new[u64](),
        wf_by: ChunkSeq::new[u64](),
        pool: ChunkSeq::new[u64](),
        cct: ChunkSeq::new[u64](),
        crt: ChunkSeq::new[u64](),
        crt_reject: false,
        cdf: ChunkSeq::new[u64](),
        p: read_policy_placeholder(),
        isa_err: false,
        arch: 0,
        arch_name: 0,
        nfns: 0,
        fns: ChunkSeq::new[u64](),
        vals: ChunkSeq::new[u64](),
        blocks: ChunkSeq::new[u64](),
        insts: ChunkSeq::new[u64](),
        code: ChunkSeq::new[u64](),
        r: report_new(),
        err: false,
        emsg: ChunkSeq::new[u8](),
        by_id: ChunkSeq::new[u64](),
        by_name: ChunkSeq::new[u64](),
        defined: ChunkSeq::new[u64](),
        by_key: ChunkSeq::new[u64](),
        dnotes: ChunkSeq::new[u64](),
        raw: ChunkSeq::new[u64](),
    };
    let nwf = r.word(in b);
    for i in 0..nwf {
        let name = r.word(in b);
        c.wf.push(name);
        for k in 0..6 {
            c.wf.push(r.word(in b));
        }
        let (pa, pn) = r.list(in b, inout c.pool);
        c.wf.push(pa);
        c.wf.push(pn);
        put_at(inout c.wf_by, name, wrapping_add(i, 1));
    }
    if mode == 1 {
        let nct = r.word(in b);
        for i in 0..nct {
            c.cct.push(r.word(in b));
            for k in 0..3 {
                let (at, n) = r.list(in b, inout c.pool);
                c.cct.push(at);
                c.cct.push(n);
            }
        }
        let nrt = r.word(in b);
        for i in 0..nrt {
            c.crt.push(r.word(in b));
            c.crt.push(r.word(in b));
            c.crt.push(r.word(in b));
        }
        c.crt_reject = r.word(in b) == 1;
        let ndf = r.word(in b);
        for i in 0..ndf {
            c.cdf.push(r.word(in b));
            let (at, n) = r.list(in b, inout c.pool);
            c.cdf.push(at);
            c.cdf.push(n);
            c.cdf.push(r.word(in b));
        }
    }
    c.p = read_policy(inout r, in b);
    c.isa_err = r.word(in b) == 1;
    c.arch = r.word(in b);
    c.arch_name = r.word(in b);
    let nf = r.word(in b);
    c.nfns = nf;
    for i in 0..nf {
        read_fn(inout c, inout r, in b);
    }
    c
}

fn read_policy_placeholder() -> Policy {
    Policy {
        pp: ChunkSeq::new[u64](),
        ct: ChunkSeq::new[u64](),
        sroots: ChunkSeq::new[u64](),
        sext: ChunkSeq::new[u64](),
        rroots: ChunkSeq::new[u64](),
        rallowed_has: false,
        rallowed: ChunkSeq::new[u64](),
        rsym: ChunkSeq::new[u64](),
        reff: ChunkSeq::new[u64](),
        rloop: ChunkSeq::new[u64](),
        rreject: true,
        rhas_max: false,
        rmax: 0,
        dfun_has: false,
        dfun: ChunkSeq::new[u64](),
        dfma: false,
        dallowed: ChunkSeq::new[u64](),
        dred_has: false,
        dred: 0,
    }
}

// ----- accessors -------------------------------------------------------------

pub fn fw(in c: Cx, f: u64, field: u64) -> u64 {
    g(in c.fns, wrapping_add(wrapping_mul(f, FW), field))
}

pub fn iw(in c: Cx, row: u64, field: u64) -> u64 {
    g(in c.insts, wrapping_add(wrapping_mul(row, IW), field))
}

pub fn pw(in c: Cx, i: u64) -> u64 {
    g(in c.pool, i)
}

pub fn wfw(in c: Cx, row: u64, field: u64) -> u64 {
    g(in c.wf, wrapping_add(wrapping_mul(row, WFW), field))
}

// The world function named `s` (row), or NONE.
pub fn world_fn(in c: Cx, s: u64) -> u64 {
    let x = g(in c.wf_by, s);
    if x == 0 {
        18446744073709551615
    } else {
        wrapping_sub(x, 1)
    }
}

// Value `v` of function `f`: the alias-resolved value, the type word and the
// defining instruction entity + 1.
pub fn val(in c: Cx, f: u64, v: u64, field: u64) -> u64 {
    g(in c.vals, wrapping_add(wrapping_mul(wrapping_add(fw(in c, f, F_VALS), v), VW), field))
}

// The global layout row of entity `ent` of function `f`, or NONE.
pub fn ent_row(in c: Cx, f: u64, ent: u64) -> u64 {
    if ent >= fw(in c, f, F_NUM_INSTS) {
        return 18446744073709551615;
    }
    let x = g(in c.pool, wrapping_add(fw(in c, f, F_ENTS), ent));
    if x == 0 {
        18446744073709551615
    } else {
        wrapping_sub(x, 1)
    }
}

// The i-th argument of instruction row `row`.
pub fn arg(in c: Cx, row: u64, i: u64) -> u64 {
    g(in c.pool, wrapping_add(iw(in c, row, I_ARGS), i))
}

pub fn nargs(in c: Cx, row: u64) -> u64 {
    iw(in c, row, wrapping_add(I_ARGS, 1))
}

pub fn block_row(in c: Cx, f: u64, blk: u64, field: u64) -> u64 {
    g(in c.blocks, wrapping_add(wrapping_mul(wrapping_add(fw(in c, f, F_BLOCKS), blk), BW), field))
}
