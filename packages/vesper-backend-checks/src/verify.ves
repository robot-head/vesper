// Module verify of @vesper/backend-checks (see lib.ves): src/native_verifiers.rs
// over the decoded input: `Names`, `verify_emitted` (findings mapped to
// source spans and instruction locations), `capability_verifiers`,
// `derive_policy` (`policy_from_capabilities`), and the verification half
// of `verify_native_with_capabilities`.

use self::consttime::{verify_constant_time};
use self::detfloat::{DetPolicy, audit};
use self::input::{Cx, ent_row, fw, iw, pw, wfw, world_fn};
use self::realtime::{verify};
use self::report::{dnote, note};
use self::stack::{measure_emitted};
use self::stack_bound::{StackPol, analyze_stack, pol_new};
use self::util::{
    contains, dup, filled, find_row, g, has, insert_row, intern_str, put, put_at, putn, puts,
    set_insert, sorted_slot, spells, st, starts
};

const CAP_CT: u64 = 1;
const CAP_DENORM: u64 = 8;
const CAP_DF: u64 = 4;
const CAP_RT: u64 = 2;
const FDW: u64 = 13;
const F_BOUND: u64 = 9;
const F_CALLEES: u64 = 7;
const F_ID: u64 = 3;
const F_INSTS: u64 = 33;
const F_INST_ERR: u64 = 11;
const F_INST_MSG: u64 = 12;
const F_KEY: u64 = 0;
const F_NINSTS: u64 = 34;
const F_PARAMS: u64 = 15;
const F_SOURCE: u64 = 1;
const F_SRET: u64 = 13;
const F_SRET_MSG: u64 = 14;
const F_SYMBOL: u64 = 2;
const F_VERIFY_ERR: u64 = 17;
const F_VERIFY_MSG: u64 = 18;
const I_HAS_LOC: u64 = 23;
const I_LOC: u64 = 24;
const RW: u64 = 7;
const V_CT: u64 = 1;
const V_DF: u64 = 8;
const V_RT: u64 = 4;
const V_STACK: u64 = 2;
const WF_CLOSURE: u64 = 4;
const WF_END: u64 = 2;
const WF_GATE: u64 = 6;
const WF_NAME: u64 = 0;
const WF_OWN: u64 = 3;
const WF_PARAMS: u64 = 7;
const WF_SPECIALIZED: u64 = 5;
const WF_START: u64 = 1;
const NONE: u64 = 18446744073709551615;

// ----- Names -------------------------------------------------------------------

pub fn build_names(inout ctx: Cx) {
    for i in 0..ctx.fn_count {
        let id = fw(in ctx, i, F_ID);
        put_at(inout ctx.by_id, id, wrapping_add(fw(in ctx, i, F_KEY), 1));
        put_at(inout ctx.defined, id, 1);
    }
    for i in 0..ctx.fn_count {
        let callees_at = fw(in ctx, i, F_CALLEES);
        for k in 0..fw(in ctx, i, wrapping_add(F_CALLEES, 1)) {
            let id = pw(in ctx, wrapping_add(callees_at, wrapping_mul(k, 2)));
            if g(in ctx.by_id, id) == 0 {
                put_at(
                    inout ctx.by_id,
                    id,
                    wrapping_add(
                        pw(in ctx, wrapping_add(callees_at, wrapping_add(wrapping_mul(k, 2), 1))),
                        1
                    )
                );
            }
        }
    }
    for id in 0..ctx.by_id.len() {
        let entry = g(in ctx.by_id, id);
        if entry != 0 {
            put_at(inout ctx.by_name, wrapping_sub(entry, 1), wrapping_add(id, 1));
        }
    }
    for i in 0..ctx.fn_count {
        let sym = fw(in ctx, i, F_SYMBOL);
        if g(in ctx.by_name, sym) == 0 {
            put_at(inout ctx.by_name, sym, wrapping_add(fw(in ctx, i, F_ID), 1));
        }
        put_at(inout ctx.by_key, fw(in ctx, i, F_KEY), wrapping_add(i, 1));
    }
}

fn by_key(in ctx: Cx, key: u64) -> u64 {
    let entry = g(in ctx.by_key, key);
    if entry == 0 {
        NONE
    } else {
        wrapping_sub(entry, 1)
    }
}

// `Names::source`: `u0:N` of a known func id -> its name.
fn names_source(in ctx: Cx, name: u64) -> u64 {
    if !starts(in ctx.names, name, "u0:") {
        return name;
    }
    let name_id = wrapping_u32(name);
    let len = ctx.names.size(name_id);
    let mut i: u64 = 3;
    if i < len && ctx.names.byte(name_id, i) == 43 {
        i = 4;
    }
    if i >= len {
        return name;
    }
    let mut func_id: u64 = 0;
    loop {
        if i >= len {
            break;
        }
        let digit = widen_u64(ctx.names.byte(name_id, i));
        if digit < 48 || digit > 57 {
            return name;
        }
        func_id = wrapping_add(wrapping_mul(func_id, 10), wrapping_sub(digit, 48));
        if func_id > 4294967295 {
            return name;
        }
        i = wrapping_add(i, 1);
    }
    let s = g(in ctx.by_id, func_id);
    if s == 0 { name } else { wrapping_sub(s, 1) }
}

// `Names::user`: `u0:<id>` of a name, or NONE.
fn names_user(inout ctx: Cx, name: u64) -> u64 {
    let id = g(in ctx.by_name, name);
    if id == 0 {
        return NONE;
    }
    let at = ctx.report.text.len();
    put(inout ctx.report.text, "u0:");
    putn(inout ctx.report.text, wrapping_sub(id, 1));
    let sym = ctx.names.intern(in ctx.report.text[at..ctx.report.text.len()]);
    ctx.report.text.truncate(at);
    widen_u64(sym)
}

// ----- findings ------------------------------------------------------------------

fn push(
    inout ctx: Cx,
    verifier: u64,
    raw_function: u64,
    has_inst: bool,
    inst: u64,
    rule_at: u64,
    rule_len: u64,
    msg_at: u64,
    msg_len: u64
) {
    let function = names_source(in ctx, raw_function);
    let func = by_key(in ctx, function);
    let mut source = function;
    if func != NONE {
        source = fw(in ctx, func, F_SOURCE);
    }
    let world_row = world_fn(in ctx, source);
    let mut has_loc = false;
    let mut loc: u64 = 0;
    if func != NONE && has_inst {
        let mut row = NONE;
        if verifier == V_CT || verifier == V_STACK {
            row = ent_row(in ctx, func, inst);
        } else if inst < fw(in ctx, func, F_NINSTS) {
            row = wrapping_add(fw(in ctx, func, F_INSTS), inst);
        }
        if row != NONE && iw(in ctx, row, I_HAS_LOC) == 1 {
            has_loc = true;
            loc = iw(in ctx, row, I_LOC);
        }
    }
    ctx.report.findings.push(verifier);
    ctx.report.findings.push(function);
    if has_inst {
        ctx.report.findings.push(1);
    } else {
        ctx.report.findings.push(0);
    }
    ctx.report.findings.push(inst);
    ctx.report.findings.push(rule_at);
    ctx.report.findings.push(rule_len);
    ctx.report.findings.push(msg_at);
    ctx.report.findings.push(msg_len);
    if world_row == NONE {
        ctx.report.findings.push(0);
        ctx.report.findings.push(0);
        ctx.report.findings.push(0);
    } else {
        ctx.report.findings.push(1);
        ctx.report.findings.push(wfw(in ctx, world_row, WF_START));
        ctx.report.findings.push(wfw(in ctx, world_row, WF_END));
    }
    if has_loc {
        ctx.report.findings.push(1);
    } else {
        ctx.report.findings.push(0);
    }
    ctx.report.findings.push(loc);
}

// Pushes the raw findings of one verifier (function override: `key`, or
// NONE to keep each finding's own).
fn push_raw(inout ctx: Cx, verifier: u64, key: u64) {
    let n = ctx.raw_findings.len() / RW;
    for k in 0..n {
        let base = wrapping_mul(k, RW);
        let mut function = g(in ctx.raw_findings, base);
        if key != NONE {
            function = key;
        }
        push(
            inout ctx,
            verifier,
            function,
            g(in ctx.raw_findings, wrapping_add(base, 1)) == 1,
            g(in ctx.raw_findings, wrapping_add(base, 2)),
            g(in ctx.raw_findings, wrapping_add(base, 3)),
            g(in ctx.raw_findings, wrapping_add(base, 4)),
            g(in ctx.raw_findings, wrapping_add(base, 5)),
            g(in ctx.raw_findings, wrapping_add(base, 6))
        );
    }
    ctx.raw_findings.truncate(0);
}

fn err_sym(inout ctx: Cx, in head: Str, sym: u64, in tail: Str) {
    put(inout ctx.error_text, head);
    puts(inout ctx.error_text, in ctx.names, sym);
    put(inout ctx.error_text, tail);
    ctx.failed = true;
}

// ----- the verifiers -----------------------------------------------------------

// `resolve_list`: `u0:N` names of a policy list, or an error.
fn resolve(inout ctx: Cx, at: u64, n: u64, in what: Str, inout out: ChunkSeq[u64]) -> bool {
    for k in 0..n {
        let name = g(in ctx.policy.list_pool, wrapping_add(at, k));
        let user_name = names_user(inout ctx, name);
        if user_name == NONE {
            put(inout ctx.error_text, "verifier policy: ");
            put(inout ctx.error_text, what);
            put(inout ctx.error_text, " names unknown function '");
            puts(inout ctx.error_text, in ctx.names, name);
            put(inout ctx.error_text, "'");
            ctx.failed = true;
            return false;
        }
        out.push(user_name);
    }
    true
}

fn run_const_time(inout ctx: Cx) {
    if ctx.policy.const_time.len() == 0 {
        let message_at = ctx.report.text.len();
        put(
            inout ctx.report.text,
            "const-time: the policy has no const_time entries; nothing was checked"
        );
        note(inout ctx, message_at);
    }
    for e in 0..ctx.policy.const_time.len() / 7 {
        let base = wrapping_mul(e, 7);
        let name = g(in ctx.policy.const_time, base);
        let func = by_key(in ctx, name);
        if func == NONE {
            err_sym(
                inout ctx,
                "verifier policy: const_time names '",
                name,
                "', which was not emitted"
            );
            return;
        }
        if fw(in ctx, func, F_INST_ERR) == 1 {
            puts(inout ctx.error_text, in ctx.names, fw(in ctx, func, F_INST_MSG));
            ctx.failed = true;
            return;
        }
        let sret_code = fw(in ctx, func, F_SRET);
        if sret_code == 2 {
            puts(inout ctx.error_text, in ctx.names, fw(in ctx, func, F_SRET_MSG));
            ctx.failed = true;
            return;
        }
        let mut secret: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let mut pointers: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let secret_at = g(in ctx.policy.const_time, wrapping_add(base, 1));
        let secret_count = g(in ctx.policy.const_time, wrapping_add(base, 2));
        let param_at = fw(in ctx, func, F_PARAMS);
        let param_count = fw(in ctx, func, wrapping_add(F_PARAMS, 1));
        for k in 0..secret_count {
            let want = g(in ctx.policy.list_pool, wrapping_add(secret_at, k));
            let mut index = NONE;
            for q in 0..param_count {
                if index == NONE && pw(in ctx, wrapping_add(param_at, wrapping_mul(q, 3))) == want {
                    index = q;
                }
            }
            if index == NONE {
                put(inout ctx.error_text, "verifier policy: '");
                puts(inout ctx.error_text, in ctx.names, name);
                put(inout ctx.error_text, "' has no parameter '");
                puts(inout ctx.error_text, in ctx.names, want);
                put(inout ctx.error_text, "'");
                ctx.failed = true;
                return;
            }
            let code = pw(in ctx, wrapping_add(param_at, wrapping_add(wrapping_mul(index, 3), 1)));
            if code == 2 {
                puts(
                    inout ctx.error_text,
                    in ctx.names,
                    pw(in ctx, wrapping_add(param_at, wrapping_add(wrapping_mul(index, 3), 2)))
                );
                ctx.failed = true;
                return;
            }
            if code == 1 {
                pointers.push(wrapping_add(index, sret_code));
            } else {
                secret.push(wrapping_add(index, sret_code));
            }
        }
        let declassify_at = g(in ctx.policy.const_time, wrapping_add(base, 3));
        let declassify_count = g(in ctx.policy.const_time, wrapping_add(base, 4));
        let trusted_at = g(in ctx.policy.const_time, wrapping_add(base, 5));
        let trusted_count = g(in ctx.policy.const_time, wrapping_add(base, 6));
        let callees_at = fw(in ctx, func, F_CALLEES);
        let callee_count = fw(in ctx, func, wrapping_add(F_CALLEES, 1));
        for k in 0..wrapping_add(declassify_count, trusted_count) {
            let mut callee: u64 = 0;
            if k < declassify_count {
                callee = g(in ctx.policy.list_pool, wrapping_add(declassify_at, k));
            } else {
                callee = g(
                    in ctx.policy.list_pool,
                    wrapping_add(trusted_at, wrapping_sub(k, declassify_count))
                );
            }
            let id = g(in ctx.by_name, callee);
            let mut called = false;
            if id != 0 {
                for q in 0..callee_count {
                    if pw(in ctx, wrapping_add(callees_at, wrapping_mul(q, 2)))
                        == wrapping_sub(id, 1)
                    {
                        called = true;
                    }
                }
            }
            if !called && id != 0 {
                let message_at = ctx.report.text.len();
                put(inout ctx.report.text, "const-time: '");
                puts(inout ctx.report.text, in ctx.names, name);
                put(inout ctx.report.text, "' does not call '");
                puts(inout ctx.report.text, in ctx.names, callee);
                put(
                    inout ctx.report.text,
                    "' in the emitted code (inlined or unused); its body is checked as part of '"
                );
                puts(inout ctx.report.text, in ctx.names, name);
                put(inout ctx.report.text, "'. Build with --no-opt to keep the call");
                note(inout ctx, message_at);
            }
        }
        let mut declassify: ChunkSeq[u64] = ChunkSeq::new[u64]();
        declassify.push(intern_str(inout ctx.names, "%vesper_ct_declassify"));
        if !resolve(inout ctx, declassify_at, declassify_count, "declassify", inout declassify) {
            return;
        }
        let mut trusted: ChunkSeq[u64] = ChunkSeq::new[u64]();
        if !resolve(inout ctx, trusted_at, trusted_count, "constant_time_callees", inout trusted) {
            return;
        }
        verify_constant_time(inout ctx, func, in secret, in pointers, in declassify, in trusted);
        push_raw(inout ctx, V_CT, NONE);
    }
}

fn run_stack(inout ctx: Cx) {
    if ctx.policy.stack_roots.len() == 0 {
        let message_at = ctx.report.text.len();
        put(
            inout ctx.report.text,
            "stack: the policy has no stack roots; only recursion and unbounded calls are reported"
        );
        note(inout ctx, message_at);
    }
    let mut graph = measure_emitted(inout ctx);
    if ctx.failed {
        return;
    }
    for i in 0..graph.names.len() {
        let source_name = names_source(in ctx, g(in graph.names, i));
        st(inout graph.names, i, source_name);
    }
    for e in 0..graph.external.len() / 4 {
        let name_at = wrapping_add(wrapping_mul(e, 4), 1);
        let source_name = names_source(in ctx, g(in graph.external, name_at));
        st(inout graph.external, name_at, source_name);
    }
    for k in 0..ctx.policy.stack_roots.len() / 2 {
        let root = g(in ctx.policy.stack_roots, wrapping_mul(k, 2));
        if by_key(in ctx, root) == NONE {
            err_sym(inout ctx, "verifier policy: stack root '", root, "' was not emitted");
            return;
        }
    }
    let mut stack_policy = pol_new();
    stack_policy.roots.extend(in ctx.policy.stack_roots.as_slice());
    stack_policy.external_bounds.extend(in ctx.policy.stack_ext_bounds.as_slice());
    analyze_stack(in ctx.names, in graph, in stack_policy, inout ctx.report);
    for k in 0..ctx.report.sf.len() / 7 {
        let b = wrapping_mul(k, 7);
        push(
            inout ctx,
            V_STACK,
            g(in ctx.report.sf, b),
            g(in ctx.report.sf, wrapping_add(b, 1)) == 1,
            g(in ctx.report.sf, wrapping_add(b, 2)),
            g(in ctx.report.sf, wrapping_add(b, 3)),
            g(in ctx.report.sf, wrapping_add(b, 4)),
            g(in ctx.report.sf, wrapping_add(b, 5)),
            g(in ctx.report.sf, wrapping_add(b, 6))
        );
    }
}

fn run_realtime(inout ctx: Cx) {
    if ctx.policy.rt_roots.len() == 0 {
        let message_at = ctx.report.text.len();
        put(
            inout ctx.report.text,
            "realtime: the policy has no realtime roots; nothing was checked"
        );
        note(inout ctx, message_at);
    }
    let by_id = dup(in ctx.by_id);
    let by_name = dup(in ctx.by_name);
    let defined = dup(in ctx.defined);
    verify(inout ctx, in by_id, in by_name, in defined);
    if ctx.failed {
        return;
    }
    push_raw(inout ctx, V_RT, NONE);
}

fn run_detfloat(inout ctx: Cx) {
    let mut det_policy = DetPolicy {
        allow_fma: ctx.policy.df_allow_fma,
        allowed: dup(in ctx.policy.df_allowed_calls),
        canonicalizes: ctx.canonical_nan,
        sequential: false,
    };
    if ctx.policy.df_has_reduction {
        if spells(in ctx.names, ctx.policy.df_reduction_order, "sequential") {
            det_policy.sequential = true;
        } else if !spells(in ctx.names, ctx.policy.df_reduction_order, "pairwise") {
            err_sym(
                inout ctx,
                "verifier policy: det_float.reduction_order must be pairwise or sequential, not '",
                ctx.policy.df_reduction_order,
                "'"
            );
            return;
        }
    }
    let mut selected: ChunkSeq[u64] = ChunkSeq::new[u64]();
    if ctx.policy.df_has_functions {
        for k in 0..ctx.policy.df_functions.len() {
            let name = g(in ctx.policy.df_functions, k);
            let func = by_key(in ctx, name);
            if func == NONE {
                err_sym(
                    inout ctx,
                    "verifier policy: det_float names '",
                    name,
                    "', which was not emitted"
                );
                return;
            }
            selected.push(func);
        }
    } else {
        for i in 0..ctx.fn_count {
            selected.push(i);
        }
    }
    for k in 0..selected.len() {
        det_policy.allowed.push(fw(in ctx, g(in selected, k), F_KEY));
    }
    let by_id = dup(in ctx.by_id);
    for k in 0..selected.len() {
        let func = g(in selected, k);
        let key = fw(in ctx, func, F_KEY);
        if fw(in ctx, func, F_VERIFY_ERR) == 1 {
            err_sym(inout ctx, "detfloat verifier on '", key, "': invalid Cranelift IR: ");
            puts(inout ctx.error_text, in ctx.names, fw(in ctx, func, F_VERIFY_MSG));
            return;
        }
        audit(inout ctx, func, in det_policy, in by_id, key);
        push_raw(inout ctx, V_DF, key);
    }
}

// `verify_emitted` with the verifiers in `mask` under `ctx.policy`.
pub fn verify_emitted(inout ctx: Cx, mask: u64) {
    ctx.report.verifiers = mask;
    ctx.report.functions = ctx.fn_count;
    if mask & V_CT != 0 {
        run_const_time(inout ctx);
        if ctx.failed {
            return;
        }
    }
    if mask & V_STACK != 0 {
        run_stack(inout ctx);
        if ctx.failed {
            return;
        }
    }
    if mask & V_RT != 0 {
        run_realtime(inout ctx);
        if ctx.failed {
            return;
        }
    }
    if mask & V_DF != 0 {
        run_detfloat(inout ctx);
    }
}

// ----- capability policies -------------------------------------------------------

fn cap_verifier(cap: u64) -> u64 {
    if cap == CAP_CT {
        return V_CT;
    }
    if cap == CAP_RT {
        return V_RT;
    }
    if cap == CAP_DF {
        return V_DF;
    }
    0
}

pub fn capability_verifiers(in ctx: Cx) -> u64 {
    let mut verifiers: u64 = 0;
    for i in 0..ctx.world_fns.len() / 9 {
        let caps = wfw(in ctx, i, WF_OWN) | wfw(in ctx, i, WF_CLOSURE);
        if caps & CAP_CT != 0 {
            verifiers = verifiers | V_CT;
        }
        if caps & CAP_RT != 0 {
            verifiers = verifiers | V_RT;
        }
        if caps & CAP_DF != 0 {
            verifiers = verifiers | V_DF;
        }
    }
    verifiers
}

fn not_emitted(inout ctx: Cx, name: u64) {
    let world_row = world_fn(in ctx, name);
    if world_row != NONE && wfw(in ctx, world_row, WF_SPECIALIZED) == 1 {
        put(inout ctx.report.text, "'");
        puts(inout ctx.report.text, in ctx.names, name);
        put(
            inout ctx.report.text,
            "' is specialized into its callers (its row has non-capability effects other than Fail, or it returns a function value, or a function-value argument is not a top-level function); its code is checked only inside callers that carry the same capability"
        );
    } else {
        put(inout ctx.report.text, "'");
        puts(inout ctx.report.text, in ctx.names, name);
        put(inout ctx.report.text, "' is not reachable from the entry and was not compiled");
    }
}

fn instances(in ctx: Cx, name: u64, inout out: ChunkSeq[u64]) {
    out.truncate(0);
    for i in 0..ctx.fn_count {
        if fw(in ctx, i, F_SOURCE) == name {
            out.push(i);
        }
    }
}

// `keep_emitted`: the emitted instance keys of the names in `list`, in name
// order, appended to `ctx.policy.list_pool`; returns (at, n).
fn keep_emitted(inout ctx: Cx, in list: ChunkSeq[u64]) -> (u64, u64) {
    let mut set: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for k in 0..list.len() {
        let name = g(in list, k);
        for i in 0..ctx.fn_count {
            if fw(in ctx, i, F_SOURCE) == name {
                set_insert(in ctx.names, inout set, fw(in ctx, i, F_KEY));
            }
        }
    }
    let at = ctx.policy.list_pool.len();
    ctx.policy.list_pool.extend(in set.as_slice());
    (at, set.len())
}

fn has_key(in ctx: Cx, in rows: ChunkSeq[u64], width: u64, key: u64) -> bool {
    find_row(in rows, width, key) != NONE
}

fn insert_sorted(inout ctx: Cx, which: u64, in row: ChunkSeq[u64]) {
    if which == 0 {
        let at = sorted_slot(in ctx.names, in ctx.policy.const_time, 7, g(in row, 0));
        insert_row(inout ctx.policy.const_time, 7, at, in row);
    } else if which == 1 {
        let at = sorted_slot(in ctx.names, in ctx.policy.rt_roots, 3, g(in row, 0));
        insert_row(inout ctx.policy.rt_roots, 3, at, in row);
    } else {
        let at = sorted_slot(in ctx.names, in ctx.policy.rt_effects, 3, g(in row, 0));
        insert_row(inout ctx.policy.rt_effects, 3, at, in row);
    }
}

// `realtime.roots.entry(key).or_insert(budget)` and
// `realtime.effects.entry(key).or_insert(["Realtime"])`.
fn realtime_root(inout ctx: Cx, key: u64, has_budget: u64, budget: u64, realtime_sym: u64) {
    if !has_key(in ctx, in ctx.policy.rt_roots, 3, key) {
        let mut row: ChunkSeq[u64] = ChunkSeq::new[u64]();
        row.push(key);
        row.push(has_budget);
        row.push(budget);
        insert_sorted(inout ctx, 1, in row);
    }
    if !has_key(in ctx, in ctx.policy.rt_effects, 3, key) {
        let at = ctx.policy.list_pool.len();
        ctx.policy.list_pool.push(realtime_sym);
        let mut row: ChunkSeq[u64] = ChunkSeq::new[u64]();
        row.push(key);
        row.push(at);
        row.push(1);
        insert_sorted(inout ctx, 2, in row);
    }
}

fn verifier_name(inout out: ChunkSeq[u8], verifier: u64) {
    if verifier == V_CT {
        put(inout out, "const-time");
    } else if verifier == V_STACK {
        put(inout out, "stack");
    } else if verifier == V_RT {
        put(inout out, "realtime");
    } else {
        put(inout out, "detfloat");
    }
}

// `derive_policy(world, functions, base, explicit_det_float_all)` into `ctx.policy`.
pub fn derive_policy(inout ctx: Cx, explicit_all: bool) {
    let explicit = explicit_all && !ctx.policy.df_has_functions;
    let mut emitted: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for e in 0..ctx.cap_const_time.len() / 7 {
        let base = wrapping_mul(e, 7);
        let function = g(in ctx.cap_const_time, base);
        let world_row = world_fn(in ctx, function);
        if world_row == NONE {
            err_sym(inout ctx, "capability policy names unknown function '", function, "'");
            return;
        }
        instances(in ctx, function, inout emitted);
        if emitted.len() == 0 {
            let message_at = ctx.report.text.len();
            put(inout ctx.report.text, "const-time: ");
            not_emitted(inout ctx, function);
            dnote(inout ctx, message_at);
            continue;
        }
        let mut secret: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let cap_secret_at = g(in ctx.cap_const_time, wrapping_add(base, 1));
        let cap_secret_count = g(in ctx.cap_const_time, wrapping_add(base, 2));
        let world_param_at = wfw(in ctx, world_row, WF_PARAMS);
        let world_param_count = wfw(in ctx, world_row, wrapping_add(WF_PARAMS, 1));
        for k in 0..cap_secret_count {
            let param_index = pw(in ctx, wrapping_add(cap_secret_at, k));
            if param_index >= world_param_count {
                put(inout ctx.error_text, "capability policy: '");
                puts(inout ctx.error_text, in ctx.names, function);
                put(inout ctx.error_text, "' has no parameter ");
                putn(inout ctx.error_text, param_index);
                ctx.failed = true;
                return;
            }
            secret.push(pw(in ctx, wrapping_add(world_param_at, param_index)));
        }
        for q in 0..emitted.len() {
            let func = g(in emitted, q);
            let key = fw(in ctx, func, F_KEY);
            if has_key(in ctx, in ctx.policy.const_time, 7, key)
                || (key != function && has_key(in ctx, in ctx.policy.const_time, 7, function))
            {
                continue;
            }
            let mut declassify: ChunkSeq[u64] = ChunkSeq::new[u64]();
            let mut trusted: ChunkSeq[u64] = ChunkSeq::new[u64]();
            let cap_declassify_at = g(in ctx.cap_const_time, wrapping_add(base, 3));
            for k in 0..g(in ctx.cap_const_time, wrapping_add(base, 4)) {
                declassify.push(pw(in ctx, wrapping_add(cap_declassify_at, k)));
            }
            let cap_trusted_at = g(in ctx.cap_const_time, wrapping_add(base, 5));
            for k in 0..g(in ctx.cap_const_time, wrapping_add(base, 6)) {
                trusted.push(pw(in ctx, wrapping_add(cap_trusted_at, k)));
            }
            let bound_at = fw(in ctx, func, F_BOUND);
            for k in 0..fw(in ctx, func, wrapping_add(F_BOUND, 1)) {
                let bound = pw(in ctx, wrapping_add(bound_at, k));
                let bound_row = world_fn(in ctx, bound);
                if bound_row != NONE && wfw(in ctx, bound_row, WF_OWN) & CAP_CT != 0 {
                    if wfw(in ctx, bound_row, WF_GATE) == 1 {
                        declassify.push(bound);
                    } else {
                        trusted.push(bound);
                    }
                }
            }
            let secret_at = ctx.policy.list_pool.len();
            ctx.policy.list_pool.extend(in secret.as_slice());
            let (declassify_at, declassify_count) = keep_emitted(inout ctx, in declassify);
            let (trusted_at, trusted_count) = keep_emitted(inout ctx, in trusted);
            let mut row: ChunkSeq[u64] = ChunkSeq::new[u64]();
            row.push(key);
            row.push(secret_at);
            row.push(secret.len());
            row.push(declassify_at);
            row.push(declassify_count);
            row.push(trusted_at);
            row.push(trusted_count);
            insert_sorted(inout ctx, 0, in row);
        }
    }
    let realtime_sym = intern_str(inout ctx.names, "Realtime");
    for e in 0..ctx.cap_realtime.len() / 3 {
        let base = wrapping_mul(e, 3);
        let function = g(in ctx.cap_realtime, base);
        instances(in ctx, function, inout emitted);
        if emitted.len() == 0 {
            let message_at = ctx.report.text.len();
            put(inout ctx.report.text, "realtime: ");
            not_emitted(inout ctx, function);
            dnote(inout ctx, message_at);
            continue;
        }
        for q in 0..emitted.len() {
            let key = fw(in ctx, g(in emitted, q), F_KEY);
            realtime_root(
                inout ctx,
                key,
                g(in ctx.cap_realtime, wrapping_add(base, 1)),
                g(in ctx.cap_realtime, wrapping_add(base, 2)),
                realtime_sym
            );
        }
    }
    if ctx.cap_reject_unbounded {
        ctx.policy.rt_reject_unbounded = true;
    }
    let mut det_functions: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for e in 0..ctx.cap_det_float.len() / 4 {
        let base = wrapping_mul(e, 4);
        let function = g(in ctx.cap_det_float, base);
        instances(in ctx, function, inout emitted);
        if emitted.len() == 0 {
            let message_at = ctx.report.text.len();
            put(inout ctx.report.text, "detfloat: ");
            not_emitted(inout ctx, function);
            dnote(inout ctx, message_at);
            continue;
        }
        for q in 0..emitted.len() {
            det_functions.push(fw(in ctx, g(in emitted, q), F_KEY));
        }
        let mut allowed: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let cap_allowed_at = g(in ctx.cap_det_float, wrapping_add(base, 1));
        for k in 0..g(in ctx.cap_det_float, wrapping_add(base, 2)) {
            allowed.push(pw(in ctx, wrapping_add(cap_allowed_at, k)));
        }
        let (allowed_at, allowed_count) = keep_emitted(inout ctx, in allowed);
        for k in 0..allowed_count {
            let callee = g(in ctx.policy.list_pool, wrapping_add(allowed_at, k));
            if !contains(in ctx.policy.df_allowed_calls, callee) {
                ctx.policy.df_allowed_calls.push(callee);
            }
        }
        if g(in ctx.cap_det_float, wrapping_add(base, 3)) == 1 {
            ctx.policy.df_allow_fma = true;
        }
    }
    // Capability closures.
    for world_index in 0..ctx.world_fns.len() / 9 {
        let name = wfw(in ctx, world_index, WF_NAME);
        let own = wfw(in ctx, world_index, WF_OWN);
        let closure = wfw(in ctx, world_index, WF_CLOSURE);
        for cap_bit in 0..4 {
            let cap = wrapping_shl_u64(1, cap_bit);
            if closure & cap != 0 && cap != CAP_DENORM && own & cap == 0 {
                instances(in ctx, name, inout emitted);
                if emitted.len() == 0 {
                    let message_at = ctx.report.text.len();
                    verifier_name(inout ctx.report.text, cap_verifier(cap));
                    put(inout ctx.report.text, ": a closure in ");
                    not_emitted(inout ctx, name);
                    dnote(inout ctx, message_at);
                } else if cap == CAP_CT {
                    let message_at = ctx.report.text.len();
                    put(
                        inout ctx.report.text,
                        "an eff [ConstTime] closure is specialized into this function, which is not ConstTime; the backend cannot tell which of its values are secret. Move the closure body into a named ConstTime function"
                    );
                    let message_len = wrapping_sub(ctx.report.text.len(), message_at);
                    let rule_at = ctx.report.text.len();
                    put(inout ctx.report.text, "capability.closure-unsupported");
                    ctx.report.findings.push(V_CT);
                    ctx.report.findings.push(name);
                    ctx.report.findings.push(0);
                    ctx.report.findings.push(0);
                    ctx.report.findings.push(rule_at);
                    ctx.report.findings.push(wrapping_sub(ctx.report.text.len(), rule_at));
                    ctx.report.findings.push(message_at);
                    ctx.report.findings.push(message_len);
                    ctx.report.findings.push(1);
                    ctx.report.findings.push(wfw(in ctx, world_index, WF_START));
                    ctx.report.findings.push(wfw(in ctx, world_index, WF_END));
                    ctx.report.findings.push(0);
                    ctx.report.findings.push(0);
                } else if cap == CAP_RT {
                    let message_at = ctx.report.text.len();
                    put(inout ctx.report.text, "realtime: '");
                    puts(inout ctx.report.text, in ctx.names, name);
                    put(
                        inout ctx.report.text,
                        "' contains an eff [Realtime] closure and is checked as a realtime root as a whole"
                    );
                    dnote(inout ctx, message_at);
                    for q in 0..emitted.len() {
                        let key = fw(in ctx, g(in emitted, q), F_KEY);
                        realtime_root(inout ctx, key, 0, 0, realtime_sym);
                    }
                } else {
                    let message_at = ctx.report.text.len();
                    put(inout ctx.report.text, "detfloat: '");
                    puts(inout ctx.report.text, in ctx.names, name);
                    put(
                        inout ctx.report.text,
                        "' contains an eff [DetFloat] closure and is audited as a whole"
                    );
                    dnote(inout ctx, message_at);
                    for q in 0..emitted.len() {
                        det_functions.push(fw(in ctx, g(in emitted, q), F_KEY));
                    }
                }
            }
        }
    }
    if det_functions.len() > 0 && !explicit {
        ctx.policy.df_has_functions = true;
        for k in 0..det_functions.len() {
            let func = g(in det_functions, k);
            if !contains(in ctx.policy.df_functions, func) {
                ctx.policy.df_functions.push(func);
            }
        }
    }
}

// The run the input asks for (mode 0 or 1). The report is in `ctx.report`, or
// `ctx.failed` is set with `ctx.error_text`.
pub fn run(inout ctx: Cx) {
    build_names(inout ctx);
    if ctx.mode == 0 {
        verify_emitted(inout ctx, ctx.requested);
        return;
    }
    let mask = ctx.requested | capability_verifiers(in ctx);
    if mask == 0 {
        ctx.report.verifiers = 0;
        ctx.report.functions = 0;
        return;
    }
    derive_policy(inout ctx, ctx.requested & V_DF != 0);
    if ctx.failed {
        return;
    }
    verify_emitted(inout ctx, mask);
    if ctx.failed {
        return;
    }
    ctx.report.notes.extend(in ctx.derived_notes.as_slice());
}
