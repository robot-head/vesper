// Module stack of @vesper/backend-checks (see lib.ves): the stack verifier's
// measurement of the emitted code (`measure_emitted` in
// src/native_verifiers.rs) on Silicon's prologue decoders
// (crates/vesper-silicon/src/prologue.rs: `measure_x86_64`,
// `measure_aarch64`) and call sites (stack.rs `call_sites`).
//
// The machine code is input: Cranelift compiles each function with the
// object ISA (the shim's job once SH4 lane 1 lends a module), and this
// module decodes its prologue.

use self::input::{Cx, fw, iw, pw};
use self::stack_bound::{StackGraph, graph_new};
use self::util::{filled, g, put, putn, puts, st};

const EXT_KNOWN: u64 = 3;
const EXT_LIBCALL: u64 = 2;
const EXT_TESTCASE: u64 = 1;
const EXT_USER: u64 = 0;
const F_CODE_AT: u64 = 22;
const F_CODE_LEN: u64 = 21;
const F_COMPILE: u64 = 19;
const F_COMPILE_MSG: u64 = 20;
const F_FRAME_SIZE: u64 = 23;
const F_ID: u64 = 3;
const F_INSTS: u64 = 33;
const F_KEY: u64 = 0;
const F_LIBCALLS: u64 = 24;
const F_NINSTS: u64 = 34;
const I_DATA_EXT: u64 = 20;
const I_ENT: u64 = 0;
const I_FMT: u64 = 3;
const X_INDEX: u64 = 2;
const X_KIND: u64 = 0;
const X_NS: u64 = 1;
const X_S1: u64 = 4;
const X_S2: u64 = 5;
const FMT_CALL: u64 = 9;
const FMT_CALL_INDIRECT: u64 = 10;
const FMT_TRY_CALL: u64 = 11;
const FMT_TRY_CALL_INDIRECT: u64 = 12;
const NONE: u64 = 18446744073709551615;

const U32_MAX: u64 = 4294967295;

fn sat32(a: u64, b: u64) -> u64 {
    let sum = wrapping_add(a, b);
    if sum > U32_MAX { U32_MAX } else { sum }
}

// Byte `i` of function `f`'s code (0 past the end).
fn byte(in ctx: Cx, at: u64, len: u64, i: u64) -> u64 {
    if i >= len {
        return 256;
    }
    wrapping_shr_u64(g(in ctx.code, wrapping_add(at, i / 8)), wrapping_u32(wrapping_mul(i % 8, 8)))
        & 255
}

// `MeasuredPrologue` as (call push, frame record, clobber push, sp sub).
pub struct Measured {
    call_push: u64,
    frame_record: u64,
    clobber: u64,
    sp_sub: u64,
}

// `modrm_rsp_disp(code[i..])`: the length of a ModRM + SIB addressing
// `[rsp + disp]`, or 0.
fn modrm_rsp_disp(in ctx: Cx, at: u64, len: u64, i: u64) -> u64 {
    let modrm = byte(in ctx, at, len, i);
    if modrm == 256 {
        return 0;
    }
    let sib = byte(in ctx, at, len, wrapping_add(i, 1));
    if modrm & 7 != 4 || sib != 36 {
        return 0;
    }
    let rest = wrapping_sub(len, i);
    let mod_bits = modrm >> 6;
    if mod_bits == 0 {
        return 2;
    }
    if mod_bits == 1 {
        if rest >= 3 {
            return 3;
        }
        return 0;
    }
    if mod_bits == 2 {
        if rest >= 6 {
            return 6;
        }
        return 0;
    }
    0
}

// `x64_clobber_store_len(code[i..])`, or 0.
fn clobber_store_len(in ctx: Cx, at: u64, len: u64, i: u64) -> u64 {
    let b0 = byte(in ctx, at, len, i);
    if b0 == 72 || b0 == 76 {
        if byte(in ctx, at, len, wrapping_add(i, 1)) != 137 {
            return 0;
        }
        let disp_len = modrm_rsp_disp(in ctx, at, len, wrapping_add(i, 2));
        if disp_len == 0 {
            return 0;
        }
        return wrapping_add(2, disp_len);
    }
    if b0 == 243 {
        let mut prefix_len: u64 = 1;
        if byte(in ctx, at, len, wrapping_add(i, 1)) == 68 {
            prefix_len = 2;
        }
        if byte(in ctx, at, len, wrapping_add(i, prefix_len)) != 15
            || byte(in ctx, at, len, wrapping_add(i, wrapping_add(prefix_len, 1))) != 127 {
            return 0;
        }
        let disp_len = modrm_rsp_disp(
            in ctx,
            at,
            len,
            wrapping_add(i, wrapping_add(prefix_len, 2))
        );
        if disp_len == 0 {
            return 0;
        }
        return wrapping_add(wrapping_add(prefix_len, 2), disp_len);
    }
    0
}

pub fn measure_x86_64(in ctx: Cx, at: u64, len: u64) -> Measured {
    let mut measured = Measured {
        call_push: 8,
        frame_record: 0,
        clobber: 0,
        sp_sub: 0,
    };
    let mut i: u64 = 0;
    loop {
        let b0 = byte(in ctx, at, len, i);
        let b1 = byte(in ctx, at, len, wrapping_add(i, 1));
        let b2 = byte(in ctx, at, len, wrapping_add(i, 2));
        let b3 = byte(in ctx, at, len, wrapping_add(i, 3));
        let rest = if i < len { wrapping_sub(len, i) } else { 0 };
        if b0 == 243 && b1 == 15 && b2 == 30 && b3 == 250 {
            i = wrapping_add(i, 4);
        } else if b0 == 85 {
            measured.frame_record = sat32(measured.frame_record, 8);
            i = wrapping_add(i, 1);
        } else if b0 == 72 && b1 == 137 && b2 == 229 {
            i = wrapping_add(i, 3);
        } else if rest >= 4 && b0 == 72 && b1 == 131 && b2 == 236 {
            if b3 >= 128 {
                break;
            }
            measured.sp_sub = sat32(measured.sp_sub, b3);
            i = wrapping_add(i, 4);
        } else if rest >= 7 && b0 == 72 && b1 == 129 && b2 == 236 {
            let imm = b3 | (byte(in ctx, at, len, wrapping_add(i, 4)) << 8) | (
                byte(in ctx, at, len, wrapping_add(i, 5)) << 16
            ) | (byte(in ctx, at, len, wrapping_add(i, 6)) << 24);
            if imm >= 2147483648 {
                break;
            }
            measured.sp_sub = sat32(measured.sp_sub, imm);
            i = wrapping_add(i, 7);
        } else {
            let store_len = clobber_store_len(in ctx, at, len, i);
            if store_len == 0 {
                break;
            }
            i = wrapping_add(i, store_len);
        }
    }
    measured
}

// The word at byte `i` (little endian).
fn word32(in ctx: Cx, at: u64, len: u64, i: u64) -> u64 {
    byte(in ctx, at, len, i) | (byte(in ctx, at, len, wrapping_add(i, 1)) << 8) | (
        byte(in ctx, at, len, wrapping_add(i, 2)) << 16
    ) | (byte(in ctx, at, len, wrapping_add(i, 3)) << 24)
}

pub fn measure_aarch64(in ctx: Cx, at: u64, len: u64) -> Measured {
    let mut measured = Measured {
        call_push: 0,
        frame_record: 0,
        clobber: 0,
        sp_sub: 0,
    };
    let mut has_x16 = false;
    let mut x16: u64 = 0;
    let word_count = len / 4;
    for k in 0..word_count {
        let insn = word32(in ctx, at, len, wrapping_mul(k, 4));
        let rn = (insn >> 5) & 31;
        if insn == 3573752639 || insn == 3573752703 || insn & 4294967103 == 3573752863 {
            // bti / paciasp / autiasp: no stack
        } else if insn == 2847898621 {
            measured.frame_record = sat32(measured.frame_record, 16);
        } else if insn == 2432697341 {
            // mov fp, sp
        } else if insn & 4290772992 == 2843738112 || insn & 4290772992 == 1837105152 {
            if rn != 31 {
                break;
            }
            let imm7 = (insn >> 15) & 127;
            if imm7 & 64 == 0 {
                break;
            }
            measured.clobber = sat32(measured.clobber, wrapping_mul(wrapping_sub(128, imm7), 8));
        } else if insn & 4292873216 == 4160752640 || insn & 4292873216 == 4227861504 {
            if rn != 31 {
                break;
            }
            let imm9 = (insn >> 12) & 511;
            if imm9 & 256 == 0 {
                break;
            }
            measured.clobber = sat32(measured.clobber, wrapping_sub(512, imm9));
        } else if insn & 4286578688 == 3506438144 && rn == 31 && insn & 31 == 31 {
            let imm12 = (insn >> 10) & 4095;
            let mut shift: u64 = 0;
            if (insn >> 22) & 1 == 1 {
                shift = 12;
            }
            measured.sp_sub = sat32(measured.sp_sub, imm12 << shift);
        } else if insn & 2139095071 == 1384120336 {
            let hw = (insn >> 21) & 3;
            has_x16 = true;
            x16 = wrapping_shl_u64((insn >> 5) & 65535, wrapping_u32(wrapping_mul(hw, 16)));
        } else if insn & 2139095071 == 1920991248 {
            let hw = (insn >> 21) & 3;
            if !has_x16 {
                break;
            }
            let mask = wrapping_shl_u64(65535, wrapping_u32(wrapping_mul(hw, 16)))
                ^ 18446744073709551615;
            x16 = (x16 & mask) | wrapping_shl_u64(
                (insn >> 5) & 65535,
                wrapping_u32(wrapping_mul(hw, 16))
            );
        } else if insn == 3408946175 {
            if !has_x16 {
                break;
            }
            has_x16 = false;
            if x16 > U32_MAX {
                break;
            }
            measured.sp_sub = sat32(measured.sp_sub, x16);
        } else {
            break;
        }
    }
    measured
}

// The silicon symbol of an external name record (`symbol_of_external`),
// interned.
fn symbol(inout ctx: Cx, ext_at: u64) -> u64 {
    let kind = pw(in ctx, wrapping_add(ext_at, X_KIND));
    let at = ctx.report.text.len();
    if kind == EXT_USER {
        put(inout ctx.report.text, "u");
        putn(inout ctx.report.text, pw(in ctx, wrapping_add(ext_at, X_NS)));
        put(inout ctx.report.text, ":");
        putn(inout ctx.report.text, pw(in ctx, wrapping_add(ext_at, X_INDEX)));
    } else if kind == EXT_TESTCASE {
        let name_id = wrapping_u32(pw(in ctx, wrapping_add(ext_at, X_S1)));
        let len = ctx.names.size(name_id);
        let mut from: u64 = 0;
        if len > 0 && ctx.names.byte(name_id, 0) == 37 {
            from = 1;
        }
        for k in from..len {
            ctx.report.text.push(ctx.names.byte(name_id, k));
        }
    } else if kind == EXT_LIBCALL {
        put(inout ctx.report.text, "libcall:");
        puts(inout ctx.report.text, in ctx.names, pw(in ctx, wrapping_add(ext_at, X_S1)));
    } else {
        put(inout ctx.report.text, "known:");
        puts(inout ctx.report.text, in ctx.names, pw(in ctx, wrapping_add(ext_at, X_S1)));
    }
    let sym = ctx.names.intern(in ctx.report.text[at..ctx.report.text.len()]);
    ctx.report.text.truncate(at);
    widen_u64(sym)
}

fn err_key(inout ctx: Cx, func: u64) {
    puts(inout ctx.error_text, in ctx.names, fw(in ctx, func, F_KEY));
}

// `measure_emitted`: the contract call graph of the emitted functions with
// frame bytes from the decoded prologues, names `u0:<func_id>` (graph ids
// are positions). Sets `ctx.failed` on failure.
pub fn measure_emitted(inout ctx: Cx) -> StackGraph {
    let mut graph = graph_new();
    if ctx.isa_err {
        puts(inout ctx.error_text, in ctx.names, ctx.arch_name);
        ctx.failed = true;
        return graph;
    }
    if ctx.arch > 1 {
        put(inout ctx.error_text, "stack verifier supports x86_64 and aarch64, not ");
        puts(inout ctx.error_text, in ctx.names, ctx.arch_name);
        ctx.failed = true;
        return graph;
    }
    // func id -> position + 1
    let mut pos_by_id: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for i in 0..ctx.fn_count {
        let id = fw(in ctx, i, F_ID);
        if pos_by_id.len() <= id {
            pos_by_id.resize(wrapping_add(id, 1), 0);
        }
        st(inout pos_by_id, id, wrapping_add(i, 1));
    }
    let mut edges = filled(0, 0);
    for i in 0..ctx.fn_count {
        let status = fw(in ctx, i, F_COMPILE);
        if status != 0 {
            put(inout ctx.error_text, "stack verifier: compiling '");
            err_key(inout ctx, i);
            put(inout ctx.error_text, "': ");
            puts(inout ctx.error_text, in ctx.names, fw(in ctx, i, F_COMPILE_MSG));
            ctx.failed = true;
            return graph;
        }
        let at = fw(in ctx, i, F_CODE_AT);
        let len = fw(in ctx, i, F_CODE_LEN);
        let mut measured = Measured {
            call_push: 0,
            frame_record: 0,
            clobber: 0,
            sp_sub: 0,
        };
        if ctx.arch == 0 {
            measured = measure_x86_64(in ctx, at, len);
        } else {
            measured = measure_aarch64(in ctx, at, len);
        }
        let total = wrapping_add(
            wrapping_add(measured.call_push, measured.frame_record),
            wrapping_add(measured.clobber, measured.sp_sub)
        );
        let minimum = wrapping_add(
            wrapping_add(fw(in ctx, i, F_FRAME_SIZE), measured.frame_record),
            measured.call_push
        );
        if total > U32_MAX || minimum > U32_MAX {
            put(inout ctx.error_text, "stack verifier: frame of '");
            err_key(inout ctx, i);
            put(inout ctx.error_text, "' overflows");
            ctx.failed = true;
            return graph;
        }
        if total < minimum {
            put(inout ctx.error_text, "stack verifier: measured ");
            putn(inout ctx.error_text, total);
            put(inout ctx.error_text, " stack bytes for '");
            err_key(inout ctx, i);
            put(inout ctx.error_text, "' but its frame layout needs at least ");
            putn(inout ctx.error_text, minimum);
            ctx.failed = true;
            return graph;
        }
        let name_at = ctx.report.text.len();
        put(inout ctx.report.text, "u0:");
        putn(inout ctx.report.text, fw(in ctx, i, F_ID));
        let name = ctx.names.intern(in ctx.report.text[name_at..ctx.report.text.len()]);
        ctx.report.text.truncate(name_at);
        graph.names.push(widen_u64(name));
        graph.frames.push(total);
        let first = fw(in ctx, i, F_INSTS);
        for k in 0..fw(in ctx, i, F_NINSTS) {
            let row = wrapping_add(first, k);
            let fmt = iw(in ctx, row, I_FMT);
            let ent = iw(in ctx, row, I_ENT);
            if fmt == FMT_CALL || fmt == FMT_TRY_CALL {
                let ext_at = wrapping_sub(iw(in ctx, row, I_DATA_EXT), 1);
                let kind = pw(in ctx, wrapping_add(ext_at, X_KIND));
                let mut callee = NONE;
                if kind == EXT_USER && pw(in ctx, wrapping_add(ext_at, X_NS)) == 0 {
                    let id = pw(in ctx, wrapping_add(ext_at, X_INDEX));
                    if g(in pos_by_id, id) != 0 {
                        callee = wrapping_sub(g(in pos_by_id, id), 1);
                    }
                }
                if callee != NONE {
                    let edge_key = wrapping_add(wrapping_mul(i, 4294967296), callee);
                    let mut seen = false;
                    for e in 0..edges.len() {
                        if g(in edges, e) == edge_key {
                            seen = true;
                        }
                    }
                    if !seen {
                        edges.push(edge_key);
                        graph.calls.push(i);
                        graph.calls.push(callee);
                    }
                } else {
                    let sym = symbol(inout ctx, ext_at);
                    graph.external.push(i);
                    graph.external.push(sym);
                    graph.external.push(1);
                    graph.external.push(ent);
                }
            } else if fmt == FMT_CALL_INDIRECT || fmt == FMT_TRY_CALL_INDIRECT {
                graph.indirect.push(i);
                graph.indirect.push(ent);
            }
        }
        let libcalls_at = fw(in ctx, i, F_LIBCALLS);
        for k in 0..fw(in ctx, i, wrapping_add(F_LIBCALLS, 1)) {
            graph.external.push(i);
            graph.external.push(pw(in ctx, wrapping_add(libcalls_at, k)));
            graph.external.push(0);
            graph.external.push(0);
        }
    }
    graph
}
