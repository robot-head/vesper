// @vesper/backend-checks: the checks that run on emitted code, in Vesper
// (self-hosting wave SH4 lane 17, #1291). Part 1 is src/native_verifiers.rs:
// the Stage-5 verifiers over the Cranelift functions native lowering emits.
//
// - input.ves: the decoder of tests/common/backend_checks_input.rs's input:
//   the emitted functions as CLIF tables, world and capability facts, the
//   policy and the source.
// - consttime.ves: Vault's constant-time taint verifier.
// - stack.ves: the stack verifier's prologue measurement and call graph.
// - stack_bound.ves: the shared worst-case stack analysis and its render
//   (SH4 lane 16 builds its eBPF-origin checks on it).
// - realtime.ves: Resonance's CLIF call graph; the confinement verifier
//   itself is @vesper/resonance's port.
// - detfloat.ves: Kinetic's DetFloat audit.
// - verify.ves: `verify_emitted`, the capability policies and the
//   verification half of `verify_native_with_capabilities`.
// - lib.ves: `render` and the entries.
//
// Rust stays the default build; tests/self_host_backend_checks.rs runs both
// over the verifier tests and compares the reports byte for byte.

use @vesper/check-data::{pack_text};
use @vesper/check-data::names::{Names};
use self::input::{Cx, read_input};
use self::stack_bound::{render};
use self::verify::{run};
use self::util::{b8, g, put, putn, puts};

const FDW: u64 = 13;
const V_CT: u64 = 1;
const V_DF: u64 = 8;
const V_RT: u64 = 4;
const V_STACK: u64 = 2;

fn src_len(in ctx: Cx) -> u64 {
    ctx.names.size(wrapping_u32(ctx.source))
}

fn src(in ctx: Cx, i: u64) -> u8 {
    ctx.names.byte(wrapping_u32(ctx.source), i)
}

fn verifier_name(inout out: ChunkSeq[u8], verifier: u64) {
    if verifier == V_CT {
        put(inout out, "const-time");
    } else if verifier == V_STACK {
        put(inout out, "stack");
    } else if verifier == V_RT {
        put(inout out, "realtime");
    } else {
        put(inout out, "detfloat");
    }
}

fn text(inout out: ChunkSeq[u8], in report_text: ChunkSeq[u8], at: u64, len: u64) {
    for i in at..wrapping_add(at, len) {
        let byte = match report_text.try_get(i) {
            Option::Some(byte) => byte,
            Option::None => 0,
        };
        out.push(byte);
    }
}

fn is_continuation(b: u8) -> bool {
    b >= 128 && b < 192
}

// `file:line:col: ` of byte `offset` (back to a char boundary).
fn at(in ctx: Cx, inout out: ChunkSeq[u8], offset: u64) {
    let source_len = src_len(in ctx);
    let mut start = offset;
    if start > source_len {
        start = source_len;
    }
    loop {
        if start == 0 || start == source_len || !is_continuation(src(in ctx, start)) {
            break;
        }
        start = wrapping_sub(start, 1);
    }
    let mut line: u64 = 1;
    let mut col: u64 = 0;
    for i in 0..start {
        let b = src(in ctx, i);
        if b == 10 {
            line = wrapping_add(line, 1);
            col = 0;
        } else if !is_continuation(b) {
            col = wrapping_add(col, 1);
        }
    }
    puts(inout out, in ctx.names, ctx.file);
    put(inout out, ":");
    putn(inout out, line);
    put(inout out, ":");
    putn(inout out, wrapping_add(col, 1));
    put(inout out, ": ");
}

fn is_space(b: u8) -> bool {
    b == 32 || (b >= 9 && b <= 13)
}

// The span start past leading whitespace and `//` comment lines.
fn item_start(in ctx: Cx, span_start: u64, span_end: u64) -> u64 {
    let source_len = src_len(in ctx);
    let mut start = span_start;
    if start > source_len {
        start = source_len;
    }
    let mut end = span_end;
    if end > source_len {
        end = source_len;
    }
    if end < start {
        end = start;
    }
    loop {
        // `source.get(start..end)` fails off char boundaries.
        if (start < source_len && is_continuation(src(in ctx, start)))
            || (end < source_len && is_continuation(src(in ctx, end)))
        {
            break;
        }
        let mut trimmed = start;
        loop {
            if trimmed >= end || !is_space(src(in ctx, trimmed)) {
                break;
            }
            trimmed = wrapping_add(trimmed, 1);
        }
        if wrapping_add(trimmed, 1) < end
            && src(in ctx, trimmed) == 47
            && src(in ctx, wrapping_add(trimmed, 1)) == 47
        {
            let mut line_end = trimmed;
            loop {
                if line_end >= end || src(in ctx, line_end) == 10 {
                    break;
                }
                line_end = wrapping_add(line_end, 1);
            }
            if line_end < end {
                start = wrapping_add(line_end, 1);
            } else {
                start = end;
            }
        } else {
            start = trimmed;
            break;
        }
    }
    start
}

// `native_verifiers::render`.
fn render_report(in ctx: Cx, inout out: ChunkSeq[u8]) {
    for k in 0..ctx.report.notes.len() / 2 {
        put(inout out, "note: ");
        text(
            inout out,
            in ctx.report.text,
            g(in ctx.report.notes, wrapping_mul(k, 2)),
            g(in ctx.report.notes, wrapping_add(wrapping_mul(k, 2), 1))
        );
        put(inout out, "\n");
    }
    if ctx.report.has_stack {
        render(in ctx.names, in ctx.report, inout out);
    }
    for k in 0..ctx.report.findings.len() / FDW {
        let row = wrapping_mul(k, FDW);
        if g(in ctx.report.findings, wrapping_add(row, 11)) == 1 {
            at(in ctx, inout out, g(in ctx.report.findings, wrapping_add(row, 12)));
        } else if g(in ctx.report.findings, wrapping_add(row, 8)) == 1 {
            let item_at = item_start(
                in ctx,
                g(in ctx.report.findings, wrapping_add(row, 9)),
                g(in ctx.report.findings, wrapping_add(row, 10))
            );
            at(in ctx, inout out, item_at);
        }
        put(inout out, "error[");
        verifier_name(inout out, g(in ctx.report.findings, row));
        put(inout out, "/");
        text(
            inout out,
            in ctx.report.text,
            g(in ctx.report.findings, wrapping_add(row, 4)),
            g(in ctx.report.findings, wrapping_add(row, 5))
        );
        put(inout out, "]: ");
        puts(inout out, in ctx.names, g(in ctx.report.findings, wrapping_add(row, 1)));
        if g(in ctx.report.findings, wrapping_add(row, 2)) == 1 {
            put(inout out, " (inst ");
            putn(inout out, g(in ctx.report.findings, wrapping_add(row, 3)));
            put(inout out, ")");
        }
        put(inout out, ": ");
        text(
            inout out,
            in ctx.report.text,
            g(in ctx.report.findings, wrapping_add(row, 6)),
            g(in ctx.report.findings, wrapping_add(row, 7))
        );
        put(inout out, "\n");
    }
}

fn opt(inout out: ChunkSeq[u8], has: bool, v: u64) {
    if has {
        putn(inout out, v);
    } else {
        put(inout out, "-");
    }
}

// The report as tests/common/backend_checks_input.rs `dump` prints it.
fn dump(in ctx: Cx, inout out: ChunkSeq[u8]) {
    render_report(in ctx, inout out);
    put(inout out, "--\nverifiers ");
    let mut first = true;
    for bit in 0..4 {
        let verifier = wrapping_shl_u64(1, bit);
        if ctx.report.verifiers & verifier != 0 {
            if !first {
                put(inout out, ",");
            }
            first = false;
            verifier_name(inout out, verifier);
        }
    }
    put(inout out, "\nfunctions ");
    putn(inout out, ctx.report.functions);
    put(inout out, "\n");
    for k in 0..ctx.report.notes.len() / 2 {
        put(inout out, "note ");
        text(
            inout out,
            in ctx.report.text,
            g(in ctx.report.notes, wrapping_mul(k, 2)),
            g(in ctx.report.notes, wrapping_add(wrapping_mul(k, 2), 1))
        );
        put(inout out, "\n");
    }
    for k in 0..ctx.report.findings.len() / FDW {
        let row = wrapping_mul(k, FDW);
        put(inout out, "finding ");
        verifier_name(inout out, g(in ctx.report.findings, row));
        put(inout out, " ");
        puts(inout out, in ctx.names, g(in ctx.report.findings, wrapping_add(row, 1)));
        put(inout out, " ");
        opt(
            inout out,
            g(in ctx.report.findings, wrapping_add(row, 2)) == 1,
            g(in ctx.report.findings, wrapping_add(row, 3))
        );
        put(inout out, " ");
        text(
            inout out,
            in ctx.report.text,
            g(in ctx.report.findings, wrapping_add(row, 4)),
            g(in ctx.report.findings, wrapping_add(row, 5))
        );
        put(inout out, " ");
        if g(in ctx.report.findings, wrapping_add(row, 8)) == 1 {
            putn(inout out, g(in ctx.report.findings, wrapping_add(row, 9)));
            put(inout out, "..");
            putn(inout out, g(in ctx.report.findings, wrapping_add(row, 10)));
        } else {
            put(inout out, "-");
        }
        put(inout out, " ");
        opt(
            inout out,
            g(in ctx.report.findings, wrapping_add(row, 11)) == 1,
            g(in ctx.report.findings, wrapping_add(row, 12))
        );
        put(inout out, " ");
        text(
            inout out,
            in ctx.report.text,
            g(in ctx.report.findings, wrapping_add(row, 6)),
            g(in ctx.report.findings, wrapping_add(row, 7))
        );
        put(inout out, "\n");
    }
    if ctx.report.has_stack {
        for k in 0..ctx.report.sr.len() / 7 {
            let row = wrapping_mul(k, 7);
            put(inout out, "root ");
            puts(inout out, in ctx.names, g(in ctx.report.sr, row));
            put(inout out, " ");
            putn(inout out, g(in ctx.report.sr, wrapping_add(row, 1)));
            put(inout out, " ");
            opt(
                inout out,
                g(in ctx.report.sr, wrapping_add(row, 2)) == 1,
                g(in ctx.report.sr, wrapping_add(row, 3))
            );
            put(inout out, " ");
            putn(inout out, g(in ctx.report.sr, wrapping_add(row, 4)));
            put(inout out, " ");
            let path_at = g(in ctx.report.sr, wrapping_add(row, 5));
            for q in 0..g(in ctx.report.sr, wrapping_add(row, 6)) {
                if q > 0 {
                    put(inout out, " -> ");
                }
                puts(inout out, in ctx.names, g(in ctx.report.spool, wrapping_add(path_at, q)));
            }
            put(inout out, "\n");
        }
        for k in 0..ctx.report.sf.len() / 7 {
            let row = wrapping_mul(k, 7);
            put(inout out, "stack ");
            puts(inout out, in ctx.names, g(in ctx.report.sf, row));
            put(inout out, " ");
            opt(
                inout out,
                g(in ctx.report.sf, wrapping_add(row, 1)) == 1,
                g(in ctx.report.sf, wrapping_add(row, 2))
            );
            put(inout out, " ");
            text(
                inout out,
                in ctx.report.text,
                g(in ctx.report.sf, wrapping_add(row, 3)),
                g(in ctx.report.sf, wrapping_add(row, 4))
            );
            put(inout out, " ");
            text(
                inout out,
                in ctx.report.text,
                g(in ctx.report.sf, wrapping_add(row, 5)),
                g(in ctx.report.sf, wrapping_add(row, 6))
            );
            put(inout out, "\n");
        }
    }
}

// The verification run of the input: the dump of the report, or
// `error <message>` (packed by `pack_text`).
pub fn backend_verify(in input: Str) -> ChunkSeq[u64] {
    let mut ctx = read_input(in input.as_bytes());
    run(inout ctx);
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    if ctx.failed {
        put(inout out, "error ");
        out.extend(in ctx.error_text.as_slice());
        put(inout out, "\n");
    } else {
        dump(in ctx, inout out);
    }
    pack_text(in out)
}

// The run without the text: the finding count (timing).
pub fn backend_verify_count(in input: Str) -> u64 {
    let mut ctx = read_input(in input.as_bytes());
    run(inout ctx);
    if ctx.failed {
        return 18446744073709551615;
    }
    wrapping_add(ctx.report.findings.len() / FDW, ctx.report.notes.len())
}

// Decoding only: the baseline the timing subtracts.
pub fn backend_verify_decode(in input: Str) -> u64 {
    let ctx = read_input(in input.as_bytes());
    wrapping_add(ctx.insts.len(), ctx.fn_count)
}

fn w_bytes(inout out: ChunkSeq[u64], in bytes: ChunkSeq[u8], at: u64, n: u64) {
    out.push(n);
    let mut i: u64 = 0;
    loop {
        if i >= n {
            break;
        }
        let mut word: u64 = 0;
        let mut shift: u64 = 0;
        loop {
            if shift >= 64 || i >= n {
                break;
            }
            let byte = wrapping_u64(b8(in bytes, wrapping_add(at, i)));
            word = word | wrapping_shl_u64(byte, wrapping_u32(shift));
            shift = wrapping_add(shift, 8);
            i = wrapping_add(i, 1);
        }
        out.push(word);
    }
}

fn w_name(inout out: ChunkSeq[u64], in names: Names, sym: u64) {
    let id = wrapping_u32(sym);
    let n = names.size(id);
    out.push(n);
    let mut i: u64 = 0;
    loop {
        if i >= n {
            break;
        }
        let mut word: u64 = 0;
        let mut shift: u64 = 0;
        loop {
            if shift >= 64 || i >= n {
                break;
            }
            let byte = wrapping_u64(names.byte(id, i));
            word = word | wrapping_shl_u64(byte, wrapping_u32(shift));
            shift = wrapping_add(shift, 8);
            i = wrapping_add(i, 1);
        }
        out.push(word);
    }
}

// Structured report words for `vesper-hybrid`'s `codegen_swap::verifiers`
// (#1291), matching `tests/common/backend_checks_input.rs::decode_report`.
pub fn backend_verify_report_bytes(in bytes: Slice[u8]) -> ChunkSeq[u64] {
    let mut ctx = read_input(in bytes);
    run(inout ctx);
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    if ctx.failed {
        out.push(1);
        w_bytes(inout out, in ctx.error_text, 0, ctx.error_text.len());
        return out;
    }
    out.push(0);
    out.push(ctx.report.verifiers);
    out.push(ctx.report.functions);
    let note_count = ctx.report.notes.len() / 2;
    out.push(note_count);
    for k in 0..note_count {
        let note_row = wrapping_mul(k, 2);
        w_bytes(
            inout out,
            in ctx.report.text,
            g(in ctx.report.notes, note_row),
            g(in ctx.report.notes, wrapping_add(note_row, 1))
        );
    }
    let finding_count = ctx.report.findings.len() / FDW;
    out.push(finding_count);
    for k in 0..finding_count {
        let base = wrapping_mul(k, FDW);
        out.push(g(in ctx.report.findings, base));
        w_name(inout out, in ctx.names, g(in ctx.report.findings, wrapping_add(base, 1)));
        out.push(g(in ctx.report.findings, wrapping_add(base, 2)));
        out.push(g(in ctx.report.findings, wrapping_add(base, 3)));
        w_bytes(
            inout out,
            in ctx.report.text,
            g(in ctx.report.findings, wrapping_add(base, 4)),
            g(in ctx.report.findings, wrapping_add(base, 5))
        );
        w_bytes(
            inout out,
            in ctx.report.text,
            g(in ctx.report.findings, wrapping_add(base, 6)),
            g(in ctx.report.findings, wrapping_add(base, 7))
        );
        out.push(g(in ctx.report.findings, wrapping_add(base, 8)));
        out.push(g(in ctx.report.findings, wrapping_add(base, 9)));
        out.push(g(in ctx.report.findings, wrapping_add(base, 10)));
        out.push(g(in ctx.report.findings, wrapping_add(base, 11)));
        out.push(g(in ctx.report.findings, wrapping_add(base, 12)));
    }
    if ctx.report.has_stack {
        out.push(1);
        let root_count = ctx.report.sr.len() / 7;
        out.push(root_count);
        for k in 0..root_count {
            let base = wrapping_mul(k, 7);
            w_name(inout out, in ctx.names, g(in ctx.report.sr, base));
            out.push(g(in ctx.report.sr, wrapping_add(base, 1)));
            out.push(g(in ctx.report.sr, wrapping_add(base, 2)));
            out.push(g(in ctx.report.sr, wrapping_add(base, 3)));
            out.push(g(in ctx.report.sr, wrapping_add(base, 4)));
            let path_at = g(in ctx.report.sr, wrapping_add(base, 5));
            let path_len = g(in ctx.report.sr, wrapping_add(base, 6));
            out.push(path_len);
            for q in 0..path_len {
                w_name(inout out, in ctx.names, g(in ctx.report.spool, wrapping_add(path_at, q)));
            }
        }
        let stack_finding_count = ctx.report.sf.len() / 7;
        out.push(stack_finding_count);
        for k in 0..stack_finding_count {
            let base = wrapping_mul(k, 7);
            w_name(inout out, in ctx.names, g(in ctx.report.sf, base));
            out.push(g(in ctx.report.sf, wrapping_add(base, 1)));
            out.push(g(in ctx.report.sf, wrapping_add(base, 2)));
            w_bytes(
                inout out,
                in ctx.report.text,
                g(in ctx.report.sf, wrapping_add(base, 3)),
                g(in ctx.report.sf, wrapping_add(base, 4))
            );
            w_bytes(
                inout out,
                in ctx.report.text,
                g(in ctx.report.sf, wrapping_add(base, 5)),
                g(in ctx.report.sf, wrapping_add(base, 6))
            );
        }
    } else {
        out.push(0);
    }
    out
}

pub fn backend_verify_report(in input: Str) -> ChunkSeq[u64] {
    backend_verify_report_bytes(in input.as_bytes())
}
