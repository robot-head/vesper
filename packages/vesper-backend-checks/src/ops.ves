// Module ops of @vesper/backend-checks (see lib.ves): the Cranelift opcodes
// and instruction formats the verifiers tell apart, numbered as `OPS` and
// `format_code` in tests/common/backend_checks_input.rs (0: any other).

pub const OP_BRIF: u64 = 1;
pub const OP_BR_TABLE: u64 = 2;
pub const OP_UDIV: u64 = 3;
pub const OP_SDIV: u64 = 4;
pub const OP_UREM: u64 = 5;
pub const OP_SREM: u64 = 6;
pub const OP_STACK_ADDR: u64 = 7;
pub const OP_STACK_LOAD: u64 = 8;
pub const OP_STACK_STORE: u64 = 9;
pub const OP_ATOMIC_RMW: u64 = 10;
pub const OP_ATOMIC_CAS: u64 = 11;
pub const OP_FMA: u64 = 12;
pub const OP_FADD: u64 = 13;
pub const OP_FSUB: u64 = 14;
pub const OP_FMUL: u64 = 15;
pub const OP_FDIV: u64 = 16;
pub const OP_SQRT: u64 = 17;
pub const OP_FMIN: u64 = 18;
pub const OP_FMAX: u64 = 19;
pub const OP_CEIL: u64 = 20;
pub const OP_FLOOR: u64 = 21;
pub const OP_TRUNC: u64 = 22;
pub const OP_NEAREST: u64 = 23;
pub const OP_FPROMOTE: u64 = 24;
pub const OP_FDEMOTE: u64 = 25;
pub const OP_FVDEMOTE: u64 = 26;
pub const OP_FVPROMOTE_LOW: u64 = 27;
pub const OP_EXTRACTLANE: u64 = 28;
pub const OP_SELECT: u64 = 29;
pub const OP_SELECT_SPECTRE_GUARD: u64 = 30;
pub const OP_BITSELECT: u64 = 31;
pub const OP_SPLAT: u64 = 32;
pub const OP_SCALAR_TO_VECTOR: u64 = 33;
pub const OP_VCONST: u64 = 34;
pub const OP_BITCAST: u64 = 35;
pub const OP_STORE: u64 = 36;
pub const OP_ATOMIC_STORE: u64 = 37;
pub const OP_RETURN: u64 = 38;

pub const FMT_LOAD: u64 = 1;
pub const FMT_LOAD_NO_OFFSET: u64 = 2;
pub const FMT_STORE: u64 = 3;
pub const FMT_STORE_NO_OFFSET: u64 = 4;
pub const FMT_STACK_LOAD: u64 = 5;
pub const FMT_STACK_STORE: u64 = 6;
pub const FMT_DYNAMIC_STACK_LOAD: u64 = 7;
pub const FMT_DYNAMIC_STACK_STORE: u64 = 8;
pub const FMT_CALL: u64 = 9;
pub const FMT_CALL_INDIRECT: u64 = 10;
pub const FMT_TRY_CALL: u64 = 11;
pub const FMT_TRY_CALL_INDIRECT: u64 = 12;
pub const FMT_BINARY_IMM8: u64 = 13;
pub const FMT_BINARY: u64 = 14;
pub const FMT_UNARY_IEEE32: u64 = 15;
pub const FMT_UNARY_IEEE64: u64 = 16;
pub const FMT_UNARY: u64 = 17;
pub const FMT_UNARY_CONST: u64 = 18;
pub const FMT_FLOAT_COMPARE: u64 = 19;

// `analyze_call` kinds (I_CALL).
pub const CALL_NONE: u64 = 0;
pub const CALL_DIRECT: u64 = 1;
pub const CALL_INDIRECT: u64 = 2;

// Block argument kinds of branch destinations.
pub const BA_VALUE: u64 = 0;
pub const BA_TRY_RET: u64 = 1;
pub const BA_TRY_EXN: u64 = 2;

// `FloatCC` codes (I_COND).
pub const CC_UNORDERED: u64 = 1;
pub const CC_NOT_EQUAL: u64 = 2;
pub const CC_ORDERED: u64 = 3;
pub const CC_EQUAL: u64 = 4;
