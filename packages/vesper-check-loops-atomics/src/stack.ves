// The single stack-bound report of `src/stack_bound.rs` (self-hosting wave
// SH2 lane 10, #1182): the graph check, Silicon's shared analysis
// (`vesper_silicon::stack::analyze_stack`: Tarjan's SCCs, then the longest
// path in reverse topological order), the eBPF kernel rules
// (`vesper_ebpf::callgraph::check_stack`, 512 bytes and 8 frames) with the
// cross-check of the two analyzers, and `render`.
//
// Function names, external symbols and policy keys are symbols. Rust's
// `BTreeSet<Succ>` of one function's successors (functions by id, then
// bounded externals by symbol text) is a sorted run of one key array.

use @vesper/check-data::names::{Names};
use @vesper/check-data::input::{Reader};
use @vesper/check-data::util::{put_text_words};
use self::out::{put, put_u64};

const NONE32: u32 = 4294967295;
const NONE64: u64 = 18446744073709551615;
const BPF_MAX_STACK_BYTES: u64 = 512;
const MAX_CALL_FRAMES: u64 = 8;

pub copy struct StackFn {
    id: u32,
    name: u32,
    frame: u32,
}

pub copy struct Site {
    caller: u32,
    // the symbol of an external call (NONE32 for an indirect one)
    symbol: u32,
    // the instruction, NONE64 when unknown
    inst: u64,
}

pub copy struct Pair {
    key: u32,
    value: u32,
}

pub struct Graph {
    ebpf: bool,
    fns: ChunkSeq[StackFn],
    calls: ChunkSeq[u64],
    indirect: ChunkSeq[Site],
    external: ChunkSeq[Site],
    // policy
    roots: ChunkSeq[Pair],
    bounds: ChunkSeq[Pair],
    // indirect_targets: caller symbol -> targets[ta..ta+tn]
    target_rows: ChunkSeq[Site],
    targets: ChunkSeq[u32],
}

fn opt(word: u64) -> u64 {
    if word == 0 {
        NONE64
    } else {
        wrapping_sub(word, 1)
    }
}

fn sym(in nmap: ChunkSeq[u32], name_id: u64) -> u32 {
    match nmap.try_get(name_id) {
        Option::Some(s) => s,
        Option::None => NONE32,
    }
}

// The graph and policy: origin, n functions (id, name, frame bytes),
// calls, indirect sites (caller, inst + 1 or 0), external calls (caller,
// symbol, inst + 1 or 0), roots (name, budget), external bounds (symbol,
// bytes), indirect targets (caller, k, k targets).
pub fn read_graph(inout reader: Reader, in bytes: Slice[u8], in nmap: ChunkSeq[u32]) -> Graph {
    let mut graph = Graph {
        ebpf: reader.word(in bytes) != 0,
        fns: ChunkSeq::new[StackFn](),
        calls: ChunkSeq::new[u64](),
        indirect: ChunkSeq::new[Site](),
        external: ChunkSeq::new[Site](),
        roots: ChunkSeq::new[Pair](),
        bounds: ChunkSeq::new[Pair](),
        target_rows: ChunkSeq::new[Site](),
        targets: ChunkSeq::new[u32]()
    };
    let n = reader.word(in bytes);
    graph.fns.reserve(n);
    for i in 0..n {
        let id = wrapping_u32(reader.word(in bytes));
        let name = sym(in nmap, reader.word(in bytes));
        let frame = wrapping_u32(reader.word(in bytes));
        graph.fns.push(StackFn { id: id, name: name, frame: frame });
    }
    let n = reader.word(in bytes);
    graph.calls.reserve(wrapping_mul(n, 2));
    for i in 0..n {
        let caller = reader.word(in bytes);
        let callee = reader.word(in bytes);
        graph.calls.push(caller);
        graph.calls.push(callee);
    }
    let n = reader.word(in bytes);
    graph.indirect.reserve(n);
    for i in 0..n {
        let caller = wrapping_u32(reader.word(in bytes));
        let inst = opt(reader.word(in bytes));
        graph.indirect.push(Site { caller: caller, symbol: NONE32, inst: inst });
    }
    let n = reader.word(in bytes);
    graph.external.reserve(n);
    for i in 0..n {
        let caller = wrapping_u32(reader.word(in bytes));
        let symbol = sym(in nmap, reader.word(in bytes));
        let inst = opt(reader.word(in bytes));
        graph.external.push(Site { caller: caller, symbol: symbol, inst: inst });
    }
    let n = reader.word(in bytes);
    for i in 0..n {
        let key = sym(in nmap, reader.word(in bytes));
        let value = wrapping_u32(reader.word(in bytes));
        graph.roots.push(Pair { key: key, value: value });
    }
    let n = reader.word(in bytes);
    for i in 0..n {
        let key = sym(in nmap, reader.word(in bytes));
        let value = wrapping_u32(reader.word(in bytes));
        graph.bounds.push(Pair { key: key, value: value });
    }
    let n = reader.word(in bytes);
    for i in 0..n {
        let caller = sym(in nmap, reader.word(in bytes));
        let target_count = reader.word(in bytes);
        let target_start = graph.targets.len();
        for j in 0..target_count {
            graph.targets.push(sym(in nmap, reader.word(in bytes)));
        }
        graph
            .target_rows
            .push(Site { caller: caller, symbol: wrapping_u32(target_count), inst: target_start });
    }
    graph
}

fn u64_at(in seq: ChunkSeq[u64], i: u64) -> u64 {
    match seq.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

fn u32_at(in seq: ChunkSeq[u32], i: u64) -> u32 {
    match seq.try_get(i) {
        Option::Some(v) => v,
        Option::None => NONE32,
    }
}

fn set64(inout seq: ChunkSeq[u64], i: u64, value: u64) {
    let ok = seq.try_set(i, value);
}

fn set32(inout seq: ChunkSeq[u32], i: u64, value: u32) {
    let ok = seq.try_set(i, value);
}

// Heap sort of `seq` ascending.
pub fn sort_u64(inout seq: ChunkSeq[u64]) {
    let n = seq.len();
    if n < 2 {
        return;
    }
    let mut start = n / 2;
    loop {
        if start == 0 {
            break;
        }
        start = wrapping_sub(start, 1);
        sift(inout seq, start, n);
    }
    let mut end = n;
    loop {
        if end <= 1 {
            break;
        }
        end = wrapping_sub(end, 1);
        let top = u64_at(in seq, 0);
        set64(inout seq, 0, u64_at(in seq, end));
        set64(inout seq, end, top);
        sift(inout seq, 0, end);
    }
}

fn sift(inout seq: ChunkSeq[u64], root: u64, n: u64) {
    let mut at = root;
    loop {
        let child = wrapping_add(wrapping_mul(at, 2), 1);
        if child >= n {
            return;
        }
        let mut larger = child;
        if wrapping_add(child, 1) < n
            && u64_at(in seq, wrapping_add(child, 1)) > u64_at(in seq, child) {
            larger = wrapping_add(child, 1);
        }
        if u64_at(in seq, larger) <= u64_at(in seq, at) {
            return;
        }
        let saved = u64_at(in seq, at);
        set64(inout seq, at, u64_at(in seq, larger));
        set64(inout seq, larger, saved);
        at = larger;
    }
}

// Byte order of two names (`String`'s `Ord`): -1, 0 or 1.
fn cmp_names(in names: Names, a: u32, b: u32) -> i64 {
    let len_a = names.size(a);
    let len_b = names.size(b);
    let n = if len_a < len_b { len_a } else { len_b };
    for i in 0..n {
        let byte_a = names.byte(a, i);
        let byte_b = names.byte(b, i);
        if byte_a < byte_b {
            return -1;
        }
        if byte_a > byte_b {
            return 1;
        }
    }
    if len_a < len_b {
        -1
    } else if len_a > len_b {
        1
    } else {
        0
    }
}

impl Graph {
    fn function(in self, i: u64) -> StackFn {
        match self.fns.try_get(i) {
            Option::Some(f) => f,
            Option::None => StackFn { id: NONE32, name: NONE32, frame: 0 },
        }
    }

    fn name(in self, id: u64) -> u32 {
        self.function(id).name
    }

    // `policy.external_bounds.get(symbol)`: bytes, NONE64 when absent.
    fn bound(in self, symbol: u32) -> u64 {
        for i in 0..self.bounds.len() {
            let pair = match self.bounds.try_get(i) {
                Option::Some(pair) => pair,
                Option::None => Pair { key: NONE32, value: 0 },
            };
            if pair.key == symbol {
                return widen_u64(pair.value);
            }
        }
        NONE64
    }

    // `by_name.get(name)`: the last function with that name (a `HashMap`
    // collected in order keeps the last), NONE64 when absent.
    fn by_name(in self, name: u32) -> u64 {
        let mut i = self.fns.len();
        loop {
            if i == 0 {
                return NONE64;
            }
            i = wrapping_sub(i, 1);
            if self.function(i).name == name {
                return i;
            }
        }
    }

    fn first_named(in self, name: u32) -> u64 {
        for i in 0..self.fns.len() {
            if self.function(i).name == name {
                return i;
            }
        }
        NONE64
    }

    // The target row of `caller` in `indirect_targets`, NONE64 when absent.
    fn target_row(in self, caller: u32) -> u64 {
        for i in 0..self.target_rows.len() {
            let row = match self.target_rows.try_get(i) {
                Option::Some(row) => row,
                Option::None => Site { caller: NONE32, symbol: 0, inst: 0 },
            };
            if row.caller == caller {
                return i;
            }
        }
        NONE64
    }
}

// A finding of the report, written as one line (`finding F inst I rule: `,
// then the caller writes the message and a newline), with its row.
fn finding(inout rep: Report, in names: Names, function: u32, inst: u64, in rule: Str) {
    let line_at = rep.findings.len();
    put(inout rep.findings, "finding ");
    names.write(function, inout rep.findings);
    put(inout rep.findings, " inst ");
    if inst == NONE64 {
        put(inout rep.findings, "-");
    } else {
        put_u64(inout rep.findings, inst);
    }
    rep.findings.push(32);
    let rule_at = rep.findings.len();
    put(inout rep.findings, rule);
    put(inout rep.findings, ": ");
    rep.rows.push(
        FindingRow {
            function: function,
            inst: inst,
            line_at: line_at,
            rule_at: rule_at,
            message_at: rep.findings.len()
        }
    );
}

fn write_path(inout output: ChunkSeq[u8], in names: Names, in path: ChunkSeq[u32]) {
    for i in 0..path.len() {
        if i > 0 {
            put(inout output, " -> ");
        }
        names.write(u32_at(in path, i), inout output);
    }
}

pub copy struct RootRow {
    root: u32,
    budget: u32,
    // NONE64 when unbounded
    worst: u64,
    path_start: u32,
    path_count: u32,
    within: bool,
}

// A finding's place in `Report.findings`: its line starts at `line_at`, its rule
// at `rule_at`, its message at `message_at`, and the message ends before
// the line's newline. `inst` is NONE64 for none.
pub copy struct FindingRow {
    function: u32,
    inst: u64,
    line_at: u64,
    rule_at: u64,
    message_at: u64,
}

pub struct Report {
    findings: ChunkSeq[u8],
    rows: ChunkSeq[FindingRow],
    roots: ChunkSeq[RootRow],
    paths: ChunkSeq[u32],
}

// Tarjan's algorithm, iterative (`tarjan`): the SCCs in reverse
// topological order, each sorted, as `members[starts[k]..starts[k+1]]`.
fn tarjan(
    n: u64,
    in adj_start: ChunkSeq[u64],
    in adj: ChunkSeq[u32],
    inout members: ChunkSeq[u32],
    inout starts: ChunkSeq[u64]
) {
    let mut index: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](n);
    index.resize(n, NONE64);
    let mut low: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](n);
    low.resize(n, 0);
    let mut on_stack: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](n);
    on_stack.resize(n, 0);
    let mut stack: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](n);
    let mut next_index: u64 = 0;
    // work items: vertex and child position, two words each
    let mut work: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](wrapping_mul(n, 2));
    for start in 0..n {
        if u64_at(in index, start) != NONE64 {
            continue;
        }
        work.push(start);
        work.push(0);
        loop {
            let len = work.len();
            if len == 0 {
                break;
            }
            let v = u64_at(in work, wrapping_sub(len, 2));
            let child = u64_at(in work, wrapping_sub(len, 1));
            if child == 0 && u64_at(in index, v) == NONE64 {
                set64(inout index, v, next_index);
                set64(inout low, v, next_index);
                next_index = wrapping_add(next_index, 1);
                stack.push(v);
                set64(inout on_stack, v, 1);
            }
            let edge_start = u64_at(in adj_start, v);
            let degree = wrapping_sub(u64_at(in adj_start, wrapping_add(v, 1)), edge_start);
            if child < degree {
                let w = widen_u64(u32_at(in adj, wrapping_add(edge_start, child)));
                set64(inout work, wrapping_sub(len, 1), wrapping_add(child, 1));
                if u64_at(in index, w) == NONE64 {
                    work.push(w);
                    work.push(0);
                } else if u64_at(in on_stack, w) != 0 {
                    let w_index = u64_at(in index, w);
                    if w_index < u64_at(in low, v) {
                        set64(inout low, v, w_index);
                    }
                }
                continue;
            }
            let child_word = work.pop();
            let vertex_word = work.pop();
            let len = work.len();
            if len > 0 {
                let parent = u64_at(in work, wrapping_sub(len, 2));
                if u64_at(in low, v) < u64_at(in low, parent) {
                    set64(inout low, parent, u64_at(in low, v));
                }
            }
            if u64_at(in low, v) == u64_at(in index, v) {
                // The SCC is popped straight into `members` and sorted
                // there: insertion sort while it is small (most SCCs are
                // one vertex), heap sort over a copy beyond that.
                let scc_start = members.len();
                starts.push(scc_start);
                loop {
                    let w = match stack.pop() {
                        Option::Some(w) => w,
                        Option::None => break,
                    };
                    set64(inout on_stack, w, 0);
                    members.push(wrapping_u32(w));
                    if w == v {
                        break;
                    }
                }
                let scc_end = members.len();
                if wrapping_sub(scc_end, scc_start) <= 16 {
                    for i in wrapping_add(scc_start, 1)..scc_end {
                        let key = u32_at(in members, i);
                        let mut j = i;
                        loop {
                            if j == scc_start {
                                break;
                            }
                            let prev_key = u32_at(in members, wrapping_sub(j, 1));
                            if prev_key <= key {
                                break;
                            }
                            set32(inout members, j, prev_key);
                            j = wrapping_sub(j, 1);
                        }
                        set32(inout members, j, key);
                    }
                } else {
                    let mut scc: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](
                        wrapping_sub(scc_end, scc_start)
                    );
                    for i in scc_start..scc_end {
                        scc.push(widen_u64(u32_at(in members, i)));
                    }
                    sort_u64(inout scc);
                    for i in 0..scc.len() {
                        set32(
                            inout members,
                            wrapping_add(scc_start, i),
                            wrapping_u32(u64_at(in scc, i))
                        );
                    }
                }
            }
        }
    }
    starts.push(members.len());
}

// `analyze_stack`, then the eBPF rules: the report lines.
pub fn report(inout output: ChunkSeq[u8], in names: Names, in graph: Graph) -> Report {
    let n = graph.fns.len();
    let mut rep = Report {
        findings: ChunkSeq::with_capacity[u8](512),
        rows: ChunkSeq::with_capacity[FindingRow](8),
        roots: ChunkSeq::with_capacity[RootRow](graph.roots.len()),
        paths: ChunkSeq::with_capacity[u32](wrapping_mul(graph.roots.len(), 8))
    };
    let mut unbounded_here: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](n);
    unbounded_here.resize(n, 0);
    // Function successors as (caller << 32 | callee), bounded ones as
    // (caller << 32 | symbol) in a second array, each sorted and unique.
    let mut fn_edges: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](
        wrapping_add(wrapping_div_pairs(graph.calls.len()), graph.targets.len())
    );
    let mut bounded: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](
        wrapping_add(graph.external.len(), graph.targets.len())
    );
    for i in 0..wrapping_div_pairs(graph.calls.len()) {
        let caller = u64_at(in graph.calls, wrapping_mul(i, 2));
        let callee = u64_at(in graph.calls, wrapping_add(wrapping_mul(i, 2), 1));
        fn_edges.push(wrapping_shl_u64(caller, 32) | callee);
    }
    for i in 0..graph.external.len() {
        let site = match graph.external.try_get(i) {
            Option::Some(site) => site,
            Option::None => Site { caller: 0, symbol: NONE32, inst: NONE64 },
        };
        let caller_id = widen_u64(site.caller);
        if graph.bound(site.symbol) != NONE64 {
            bounded.push(wrapping_shl_u64(caller_id, 32) | widen_u64(site.symbol));
        } else {
            set64(inout unbounded_here, caller_id, 1);
            finding(
                inout rep,
                in names,
                graph.name(caller_id),
                site.inst,
                "silicon.stack.unbounded_external_call"
            );
            put(inout rep.findings, "call to `");
            names.write(site.symbol, inout rep.findings);
            put(
                inout rep.findings,
                "` has no declared stack bound; list it in StackPolicy::external_bounds\n"
            );
        }
    }
    for i in 0..graph.indirect.len() {
        let site = match graph.indirect.try_get(i) {
            Option::Some(site) => site,
            Option::None => Site { caller: 0, symbol: NONE32, inst: NONE64 },
        };
        let caller_id = widen_u64(site.caller);
        let caller = graph.name(caller_id);
        // `to_silicon` gives an unknown instruction 0.
        let inst = if site.inst == NONE64 { 0 } else { site.inst };
        let row = graph.target_row(caller);
        if row == NONE64 {
            set64(inout unbounded_here, caller_id, 1);
            finding(inout rep, in names, caller, inst, "silicon.stack.unresolved_indirect_call");
            put(inout rep.findings, "indirect call without a policy-listed target set\n");
        } else {
            let target_set = match graph.target_rows.try_get(row) {
                Option::Some(target_set) => target_set,
                Option::None => Site { caller: NONE32, symbol: 0, inst: 0 },
            };
            for j in 0..widen_u64(target_set.symbol) {
                let target = u32_at(in graph.targets, wrapping_add(target_set.inst, j));
                let id = graph.by_name(target);
                if id != NONE64 {
                    fn_edges.push(wrapping_shl_u64(caller_id, 32) | id);
                } else if graph.bound(target) != NONE64 {
                    bounded.push(wrapping_shl_u64(caller_id, 32) | widen_u64(target));
                } else {
                    set64(inout unbounded_here, caller_id, 1);
                    finding(
                        inout rep,
                        in names,
                        caller,
                        inst,
                        "silicon.stack.unknown_indirect_target"
                    );
                    put(inout rep.findings, "indirect target `");
                    names.write(target, inout rep.findings);
                    put(inout rep.findings, "` is neither defined nor bounded\n");
                }
            }
        }
    }
    sort_u64(inout fn_edges);
    // Adjacency: unique callees of each caller, ascending.
    let mut adj_start: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](wrapping_add(n, 1));
    let mut adj: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](fn_edges.len());
    let mut edge_at: u64 = 0;
    for v in 0..n {
        adj_start.push(adj.len());
        loop {
            if edge_at >= fn_edges.len() {
                break;
            }
            let edge = u64_at(in fn_edges, edge_at);
            if wrapping_shr_u64(edge, 32) != v {
                break;
            }
            let callee = wrapping_u32(edge & 4294967295);
            let adj_len = adj.len();
            if adj_len == u64_at(in adj_start, v)
                || u32_at(in adj, wrapping_sub(adj_len, 1)) != callee {
                adj.push(callee);
            }
            edge_at = wrapping_add(edge_at, 1);
        }
    }
    adj_start.push(adj.len());
    // Bounded successors of each caller, unique, by symbol text.
    let mut bounded_start: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](wrapping_add(n, 1));
    let mut bounded_syms: ChunkSeq[u32] = ChunkSeq::new[u32]();
    sort_u64(inout bounded);
    let mut edge_at: u64 = 0;
    for v in 0..n {
        let sym_start = bounded_syms.len();
        bounded_start.push(sym_start);
        loop {
            if edge_at >= bounded.len() {
                break;
            }
            let edge = u64_at(in bounded, edge_at);
            if wrapping_shr_u64(edge, 32) != v {
                break;
            }
            let symbol = wrapping_u32(edge & 4294967295);
            // insert in text order, skipping duplicates
            let mut at = bounded_syms.len();
            let mut dup = false;
            loop {
                if at == sym_start {
                    break;
                }
                let order = cmp_names(
                    in names,
                    u32_at(in bounded_syms, wrapping_sub(at, 1)),
                    symbol
                );
                if order == 0 {
                    dup = true;
                    break;
                }
                if order < 0 {
                    break;
                }
                at = wrapping_sub(at, 1);
            }
            if !dup {
                bounded_syms.push(symbol);
                let mut j = wrapping_sub(bounded_syms.len(), 1);
                loop {
                    if j <= at {
                        break;
                    }
                    set32(inout bounded_syms, j, u32_at(in bounded_syms, wrapping_sub(j, 1)));
                    j = wrapping_sub(j, 1);
                }
                set32(inout bounded_syms, at, symbol);
            }
            edge_at = wrapping_add(edge_at, 1);
        }
    }
    bounded_start.push(bounded_syms.len());
    let mut members: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](n);
    let mut starts: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](wrapping_add(n, 1));
    tarjan(n, in adj_start, in adj, inout members, inout starts);
    let sccs = wrapping_sub(starts.len(), 1);
    let mut cyclic: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](n);
    cyclic.resize(n, 0);
    for scc in 0..sccs {
        let scc_start = u64_at(in starts, scc);
        let scc_end = u64_at(in starts, wrapping_add(scc, 1));
        let first = widen_u64(u32_at(in members, scc_start));
        let mut cycle = wrapping_sub(scc_end, scc_start) > 1;
        if !cycle {
            for j in u64_at(in adj_start, first)..u64_at(in adj_start, wrapping_add(first, 1)) {
                if widen_u64(u32_at(in adj, j)) == first {
                    cycle = true;
                }
            }
        }
        if cycle {
            for j in scc_start..scc_end {
                set64(inout cyclic, widen_u64(u32_at(in members, j)), 1);
            }
            finding(inout rep, in names, graph.name(first), NONE64, "silicon.stack.recursion");
            put(inout rep.findings, "recursive call cycle among {");
            for j in scc_start..scc_end {
                if j > scc_start {
                    put(inout rep.findings, ", ");
                }
                names.write(graph.name(widen_u64(u32_at(in members, j))), inout rep.findings);
            }
            put(inout rep.findings, "}\n");
        }
    }
    // Longest path in reverse topological order. NONE64 = unbounded.
    // best: a function id, or 2^32 + k for the k-th bounded symbol slot.
    let mut depth: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](n);
    depth.resize(n, NONE64);
    let mut best: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](n);
    best.resize(n, NONE64);
    for scc in 0..sccs {
        for j in u64_at(in starts, scc)..u64_at(in starts, wrapping_add(scc, 1)) {
            let v = widen_u64(u32_at(in members, j));
            if u64_at(in cyclic, v) != 0 || u64_at(in unbounded_here, v) != 0 {
                continue;
            }
            let mut deepest: u64 = 0;
            let mut pick = NONE64;
            let mut ok = true;
            for q in u64_at(in adj_start, v)..u64_at(in adj_start, wrapping_add(v, 1)) {
                let id = widen_u64(u32_at(in adj, q));
                let succ_depth = u64_at(in depth, id);
                if succ_depth == NONE64 {
                    ok = false;
                    break;
                }
                if pick == NONE64 || succ_depth > deepest {
                    deepest = succ_depth;
                    pick = id;
                }
            }
            if ok {
                for q in u64_at(in bounded_start, v)..u64_at(in bounded_start, wrapping_add(v, 1)) {
                    let succ_depth = graph.bound(u32_at(in bounded_syms, q));
                    if pick == NONE64 || succ_depth > deepest {
                        deepest = succ_depth;
                        pick = wrapping_add(4294967296, q);
                    }
                }
                set64(inout depth, v, wrapping_add(widen_u64(graph.function(v).frame), deepest));
                set64(inout best, v, pick);
            }
        }
    }
    for i in 0..graph.roots.len() {
        let root = match graph.roots.try_get(i) {
            Option::Some(p) => p,
            Option::None => Pair { key: NONE32, value: 0 },
        };
        let id = graph.by_name(root.key);
        let path_start = wrapping_u32(rep.paths.len());
        if id == NONE64 {
            finding(inout rep, in names, root.key, NONE64, "silicon.stack.unknown_root");
            put(inout rep.findings, "stack root is not a function of this program\n");
            rep.roots.push(
                RootRow {
                    root: root.key,
                    budget: root.value,
                    worst: NONE64,
                    path_start: path_start,
                    path_count: 0,
                    within: false
                }
            );
            continue;
        }
        let worst = u64_at(in depth, id);
        if worst != NONE64 {
            let mut cur = id;
            loop {
                if cur == NONE64 {
                    break;
                }
                if cur >= 4294967296 {
                    rep.paths.push(u32_at(in bounded_syms, wrapping_sub(cur, 4294967296)));
                    break;
                }
                rep.paths.push(graph.name(cur));
                cur = u64_at(in best, cur);
            }
        }
        let path_count = wrapping_sub(wrapping_u32(rep.paths.len()), path_start);
        let within = worst != NONE64 && worst <= widen_u64(root.value);
        if worst != NONE64 && !within {
            finding(inout rep, in names, root.key, NONE64, "silicon.stack.budget_exceeded");
            put(inout rep.findings, "worst-case stack ");
            put_u64(inout rep.findings, worst);
            put(inout rep.findings, " bytes exceeds @stack_limit(");
            put_u64(inout rep.findings, widen_u64(root.value));
            put(inout rep.findings, ") along ");
            for j in 0..widen_u64(path_count) {
                if j > 0 {
                    put(inout rep.findings, " -> ");
                }
                names.write(
                    u32_at(in rep.paths, wrapping_add(widen_u64(path_start), j)),
                    inout rep.findings
                );
            }
            rep.findings.push(10);
        } else if worst == NONE64 {
            finding(inout rep, in names, root.key, NONE64, "silicon.stack.budget_exceeded");
            put(
                inout rep.findings,
                "worst-case stack depth is unbounded (recursion or unresolved call reachable)\n"
            );
        }
        rep.roots.push(
            RootRow {
                root: root.key,
                budget: root.value,
                worst: worst,
                path_start: path_start,
                path_count: path_count,
                within: within
            }
        );
    }
    if graph.ebpf {
        ebpf_rules(in names, in graph, in adj_start, in adj, inout rep);
    }
    rep
}

fn wrapping_div_pairs(n: u64) -> u64 {
    n / 2
}

fn write_ids(inout output: ChunkSeq[u8], in path: ChunkSeq[u64]) {
    output.push(91);
    for i in 0..path.len() {
        if i > 0 {
            put(inout output, ", ");
        }
        put(inout output, "FnId(");
        put_u64(inout output, u64_at(in path, i));
        output.push(41);
    }
    output.push(93);
}

fn write_id_names(
    inout output: ChunkSeq[u8],
    in names: Names,
    in graph: Graph,
    in path: ChunkSeq[u64]
) {
    for i in 0..path.len() {
        if i > 0 {
            put(inout output, " -> ");
        }
        let id = u64_at(in path, i);
        if id < graph.fns.len() {
            names.write(graph.name(id), inout output);
        } else {
            put(inout output, "<unknown>");
        }
    }
}

// `vesper_ebpf::callgraph::check_stack` from `root` with the kernel's
// limits, and the finding it gives against the shared analysis.
fn ebpf_rules(
    in names: Names,
    in graph: Graph,
    in adj_start: ChunkSeq[u64],
    in adj: ChunkSeq[u32],
    inout rep: Report
) {
    for i in 0..rep.roots.len() {
        let root = match rep.roots.try_get(i) {
            Option::Some(r) => r,
            Option::None => RootRow {
                root: NONE32,
                budget: 0,
                worst: NONE64,
                path_start: 0,
                path_count: 0,
                within: false
            },
        };
        let root_index = graph.first_named(root.root);
        if root_index == NONE64 {
            continue;
        }
        let root_id = widen_u64(graph.function(root_index).id);
        // 0 ok (bytes), 1 exceeded, 2 too deep, 3 recursion, 4 indirect
        let mut status: u64 = 0;
        let mut bytes: u64 = 0;
        let mut path: ChunkSeq[u64] = ChunkSeq::new[u64]();
        if graph.indirect.len() > 0 {
            status = 4;
            bytes = match graph.indirect.try_get(0) {
                Option::Some(site) => widen_u64(site.caller),
                Option::None => 0,
            };
        } else {
            // explicit-stack DFS over paths: entries are (path start in
            // `paths`, path length, bytes)
            let mut paths: ChunkSeq[u64] = ChunkSeq::new[u64]();
            let mut stack: ChunkSeq[u64] = ChunkSeq::new[u64]();
            let mut worst: u64 = 0;
            paths.push(root_id);
            stack.push(0);
            stack.push(1);
            stack.push(widen_u64(graph.function(root_id).frame));
            loop {
                let len = stack.len();
                if len == 0 {
                    break;
                }
                let path_bytes = u64_at(in stack, wrapping_sub(len, 1));
                let path_len = u64_at(in stack, wrapping_sub(len, 2));
                let path_start = u64_at(in stack, wrapping_sub(len, 3));
                let popped_bytes = stack.pop();
                let popped_len = stack.pop();
                let popped_start = stack.pop();
                if path_bytes > BPF_MAX_STACK_BYTES {
                    status = 1;
                    bytes = path_bytes;
                    for j in 0..path_len {
                        path.push(u64_at(in paths, wrapping_add(path_start, j)));
                    }
                    break;
                }
                if path_len > MAX_CALL_FRAMES {
                    status = 2;
                    for j in 0..path_len {
                        path.push(u64_at(in paths, wrapping_add(path_start, j)));
                    }
                    break;
                }
                if path_bytes > worst {
                    worst = path_bytes;
                }
                let last = u64_at(in paths, wrapping_add(path_start, wrapping_sub(path_len, 1)));
                let mut recursion = false;
                for q in u64_at(in adj_start, last)..u64_at(in adj_start, wrapping_add(last, 1)) {
                    let callee = widen_u64(u32_at(in adj, q));
                    let mut seen = false;
                    for j in 0..path_len {
                        if u64_at(in paths, wrapping_add(path_start, j)) == callee {
                            seen = true;
                        }
                    }
                    if seen {
                        status = 3;
                        for j in 0..path_len {
                            path.push(u64_at(in paths, wrapping_add(path_start, j)));
                        }
                        path.push(callee);
                        recursion = true;
                        break;
                    }
                    let start = paths.len();
                    for j in 0..path_len {
                        paths.push(u64_at(in paths, wrapping_add(path_start, j)));
                    }
                    paths.push(callee);
                    let mut next_bytes = wrapping_add(
                        path_bytes,
                        widen_u64(graph.function(callee).frame)
                    );
                    if next_bytes < path_bytes {
                        next_bytes = 4294967295;
                    }
                    if next_bytes > 4294967295 {
                        next_bytes = 4294967295;
                    }
                    stack.push(start);
                    stack.push(wrapping_add(path_len, 1));
                    stack.push(next_bytes);
                }
                if recursion {
                    break;
                }
            }
            if status == 0 {
                bytes = worst;
            }
        }
        if status == 0 {
            if root.worst != bytes {
                finding(inout rep, in names, root.root, NONE64, "stack.analyzers_disagree");
                put(inout rep.findings, "the shared analysis gives ");
                if root.worst == NONE64 {
                    put(inout rep.findings, "None");
                } else {
                    put(inout rep.findings, "Some(");
                    put_u64(inout rep.findings, root.worst);
                    put(inout rep.findings, ")");
                }
                put(inout rep.findings, " bytes but the eBPF analysis gives ");
                put_u64(inout rep.findings, bytes);
                rep.findings.push(10);
            }
        } else {
            finding(inout rep, in names, root.root, NONE64, "ebpf.stack.kernel_limit");
            if status == 1 {
                put_u64(inout rep.findings, bytes);
                put(inout rep.findings, " bytes exceed the kernel's 512 byte limit along ");
                write_id_names(inout rep.findings, in names, in graph, in path);
            } else if status == 2 {
                put(inout rep.findings, "more than 8 call frames along ");
                write_id_names(inout rep.findings, in names, in graph, in path);
            } else if status == 3 {
                put(inout rep.findings, "recursion along ");
                write_ids(inout rep.findings, in path);
            } else {
                put(inout rep.findings, "indirect call in FnId(");
                put_u64(inout rep.findings, bytes);
                put(inout rep.findings, ")");
            }
            rep.findings.push(10);
        }
    }
}

// `StackGraph::validate`: the error text, or nothing.
pub fn validate(inout output: ChunkSeq[u8], in names: Names, in graph: Graph) -> bool {
    for i in 0..graph.fns.len() {
        let func = graph.function(i);
        if widen_u64(func.id) != i {
            put(inout output, "error: stack graph ids must be dense: function `");
            names.write(func.name, inout output);
            put(inout output, "` has id ");
            put_u64(inout output, widen_u64(func.id));
            put(inout output, " at position ");
            put_u64(inout output, i);
            output.push(10);
            return false;
        }
    }
    let n = graph.fns.len();
    let mut bad = NONE64;
    for i in 0..graph.calls.len() {
        let fn_id = u64_at(in graph.calls, i);
        if fn_id >= n {
            bad = fn_id;
            break;
        }
    }
    if bad == NONE64 {
        for i in 0..graph.indirect.len() {
            let fn_id = match graph.indirect.try_get(i) {
                Option::Some(site) => widen_u64(site.caller),
                Option::None => 0,
            };
            if fn_id >= n {
                bad = fn_id;
                break;
            }
        }
    }
    if bad == NONE64 {
        for i in 0..graph.external.len() {
            let fn_id = match graph.external.try_get(i) {
                Option::Some(site) => widen_u64(site.caller),
                Option::None => 0,
            };
            if fn_id >= n {
                bad = fn_id;
                break;
            }
        }
    }
    if bad != NONE64 {
        put(inout output, "error: stack graph names unknown function id ");
        put_u64(inout output, bad);
        output.push(10);
        return false;
    }
    true
}

// The whole result: `stack_bound_report`'s roots and findings, then
// `render`.
pub fn write_report(inout output: ChunkSeq[u8], in names: Names, in graph: Graph) {
    if !validate(inout output, in names, in graph) {
        return;
    }
    let rep = report(inout output, in names, in graph);
    for i in 0..rep.roots.len() {
        let root_row = match rep.roots.try_get(i) {
            Option::Some(root_row) => root_row,
            Option::None => RootRow {
                root: NONE32,
                budget: 0,
                worst: NONE64,
                path_start: 0,
                path_count: 0,
                within: false
            },
        };
        put(inout output, "root ");
        names.write(root_row.root, inout output);
        put(inout output, " budget ");
        put_u64(inout output, widen_u64(root_row.budget));
        put(inout output, " worst ");
        if root_row.worst == NONE64 {
            put(inout output, "-");
        } else {
            put_u64(inout output, root_row.worst);
        }
        if root_row.within {
            put(inout output, " within 1 path ");
        } else {
            put(inout output, " within 0 path ");
        }
        for j in 0..widen_u64(root_row.path_count) {
            if j > 0 {
                output.push(44);
            }
            names.write(
                u32_at(in rep.paths, wrapping_add(widen_u64(root_row.path_start), j)),
                inout output
            );
        }
        output.push(10);
    }
    output.extend(in rep.findings.as_slice());
    let mut accepted = rep.findings.len() == 0;
    for i in 0..rep.roots.len() {
        let root_row = match rep.roots.try_get(i) {
            Option::Some(root_row) => root_row,
            Option::None => RootRow {
                root: NONE32,
                budget: 0,
                worst: NONE64,
                path_start: 0,
                path_count: 0,
                within: false
            },
        };
        if !root_row.within {
            accepted = false;
        }
        // render
        put(inout output, "stack ");
        names.write(root_row.root, inout output);
        put(inout output, ": worst case ");
        if root_row.worst == NONE64 {
            put(inout output, "unbounded");
        } else {
            put_u64(inout output, root_row.worst);
            put(inout output, " bytes");
        }
        put(inout output, " of ");
        put_u64(inout output, widen_u64(root_row.budget));
        put(inout output, " byte budget (");
        if root_row.within {
            put(inout output, "ok");
        } else {
            put(inout output, "exceeded");
        }
        put(inout output, ") via ");
        if root_row.path_count == 0 {
            put(inout output, "-");
        } else {
            for j in 0..widen_u64(root_row.path_count) {
                if j > 0 {
                    put(inout output, " -> ");
                }
                names.write(
                    u32_at(in rep.paths, wrapping_add(widen_u64(root_row.path_start), j)),
                    inout output
                );
            }
        }
        output.push(10);
    }
    if accepted {
        put(inout output, "accepted\n");
    } else {
        put(inout output, "rejected\n");
    }
}

// Bytes `start..end` of `text` as words: the byte length, then the bytes eight
// per word, little-endian (`Words::text` in tests/common/check_words.rs).
fn put_bytes(inout output: ChunkSeq[u64], in text: ChunkSeq[u8], start: u64, end: u64) {
    if start < end && end <= text.len() {
        put_text_words(inout output, in text[start..end]);
    } else {
        output.push(0);
    }
}

fn put_name(inout output: ChunkSeq[u64], in names: Names, symbol: u32) {
    names.put_words(symbol, inout output);
}

// The report as words, for the hybrid swap of `stack_bound_report`
// (`decode_stack_report` in tests/common/stack_words.rs): 1 and the error
// for a malformed graph; otherwise 0, the roots (name, budget, worst case
// plus one or 0 for unbounded, within budget, then the worst path's
// names), then the findings (function, instruction plus one or 0, rule,
// message).
pub fn report_words(inout output: ChunkSeq[u64], in names: Names, in graph: Graph) {
    let mut text: ChunkSeq[u8] = ChunkSeq::new[u8]();
    if !validate(inout text, in names, in graph) {
        // `error: <message>\n`
        output.push(1);
        put_bytes(inout output, in text, 7, wrapping_sub(text.len(), 1));
        return;
    }
    let rep = report(inout text, in names, in graph);
    // About a word per eight bytes of findings text, plus a few per row,
    // root and path step.
    output.reserve(
        wrapping_add(
            wrapping_add(rep.findings.len() >> 3, wrapping_mul(rep.rows.len(), 8)),
            wrapping_add(wrapping_mul(rep.roots.len(), 8), wrapping_mul(rep.paths.len(), 3))
        )
    );
    output.push(0);
    output.push(rep.roots.len());
    for i in 0..rep.roots.len() {
        let root_row = match rep.roots.try_get(i) {
            Option::Some(root_row) => root_row,
            Option::None => RootRow {
                root: NONE32,
                budget: 0,
                worst: NONE64,
                path_start: 0,
                path_count: 0,
                within: false
            },
        };
        put_name(inout output, in names, root_row.root);
        output.push(widen_u64(root_row.budget));
        if root_row.worst == NONE64 {
            output.push(0);
        } else {
            output.push(wrapping_add(root_row.worst, 1));
        }
        if root_row.within {
            output.push(1);
        } else {
            output.push(0);
        }
        output.push(widen_u64(root_row.path_count));
        for j in 0..widen_u64(root_row.path_count) {
            put_name(
                inout output,
                in names,
                u32_at(in rep.paths, wrapping_add(widen_u64(root_row.path_start), j))
            );
        }
    }
    let n = rep.rows.len();
    output.push(n);
    for i in 0..n {
        let finding_row = match rep.rows.try_get(i) {
            Option::Some(finding_row) => finding_row,
            Option::None => FindingRow {
                function: NONE32,
                inst: NONE64,
                line_at: 0,
                rule_at: 0,
                message_at: 0
            },
        };
        // The line ends with a newline before the next finding's line.
        let end = match rep.rows.try_get(wrapping_add(i, 1)) {
            Option::Some(next) => wrapping_sub(next.line_at, 1),
            Option::None => wrapping_sub(rep.findings.len(), 1),
        };
        put_name(inout output, in names, finding_row.function);
        if finding_row.inst == NONE64 {
            output.push(0);
        } else {
            output.push(wrapping_add(finding_row.inst, 1));
        }
        // The rule ends two bytes before the message (`: `).
        put_bytes(
            inout output,
            in rep.findings,
            finding_row.rule_at,
            wrapping_sub(finding_row.message_at, 2)
        );
        put_bytes(inout output, in rep.findings, finding_row.message_at, end);
    }
}
