// @vesper/check-loops-atomics: the loop, try/Option, atomics and stack
// bound checks of the compiler in Vesper (self-hosting wave SH2 lane 10,
// #1182), on the checker data of @vesper/check-data.
//
// - control.ves: where `break`, `continue` and `return` may jump, which
//   iterables a `for` takes, and `?` on `Option` (`src/loops/check.rs`,
//   `src/loops/try_option.rs`: E0213, E0200).
// - atomics.ves: the atomic and worker preludes a module needs, the
//   operation, order and worker rules, and the private cell on Place IR
//   (`src/atomics.rs`: E0820-E0824).
// - stack.ves: the single stack-bound report (`src/stack_bound.rs` with
//   the shared Silicon analysis and the eBPF kernel rules), and `render`.
// - ast.ves: function bodies as flat expression and pattern tables.
//
// Each entry takes the harness input (tests/common/check_harness.rs plus
// the task words of tests/self_host_check_loops_atomics.rs) and returns
// its diagnostics or report as text packed by `pack_text`. Rust stays the
// default checker.

use @vesper/check-data::{pack_text};
use @vesper/check-data::input::{NamesCtx, Reader, read_ctx, read_names_ctx};
use self::ast::{exprs_new, read_fns};
use self::control::{check_bodies, control_new};
use self::atomics::{
    any_atomic_name, atomics_new, check_program, check_world, needs_prelude, needs_workers,
    read_items, read_ir, syms_new
};
use self::stack::{read_graph, report_words, write_report};
use self::out::{put};

// Task "control": the world's functions (n function records). Returns the
// E0213 and E0200 diagnostics of the control rules, in walk order.
pub fn check_loops_control(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mut reader = Reader { pos: 0 };
    let mut ctx = read_ctx(inout reader, in bytes);
    let mut exprs = exprs_new();
    read_fns(inout reader, in bytes, inout exprs, in ctx.nmap, in ctx.tmap);
    let mut control = control_new(inout ctx.names);
    let mut output = ChunkSeq::new[u8]();
    check_bodies(inout output, inout control, in exprs, in ctx.types, in ctx.world);
    pack_text(in output)
}

// Task "atomics": the two prelude flags of the world, its functions, the
// module's items and the Place IR. Returns `needs_prelude` and
// `needs_workers` of the module, then the diagnostics of `check_world`
// and `check_program`.
pub fn check_atomics(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mut reader = Reader { pos: 0 };
    let mut ctx = read_ctx(inout reader, in bytes);
    let atomic = reader.word(in bytes) != 0;
    let workers = reader.word(in bytes) != 0;
    let before_syms = ctx.names.len();
    let syms = syms_new(inout ctx.names);
    let maybe_prelude = any_atomic_name(in ctx.names, in syms, before_syms);
    let maybe_workers = widen_u64(syms.parallel_for) < before_syms;
    if !atomic && !workers && !maybe_prelude && !maybe_workers {
        let mut output = ChunkSeq::new[u8]();
        put(inout output, "prelude 0 workers 0\n");
        return pack_text(in output);
    }
    let mut exprs = exprs_new();
    read_fns(inout reader, in bytes, inout exprs, in ctx.nmap, in ctx.tmap);
    let mut prelude_needed = false;
    let mut workers_needed = false;
    if maybe_prelude || maybe_workers {
        let items = read_items(inout reader, in bytes, in ctx.nmap, in ctx.tmap, exprs_new());
        if maybe_prelude {
            prelude_needed = needs_prelude(in ctx.names, in ctx.types, in items, in syms);
        }
        if maybe_workers {
            workers_needed = needs_workers(in items, in syms);
        }
    } else if atomic {
        let _items = read_items(inout reader, in bytes, in ctx.nmap, in ctx.tmap, exprs_new());
    }
    let mut output = ChunkSeq::new[u8]();
    put(inout output, "prelude ");
    if prelude_needed {
        output.push(49);
    } else {
        output.push(48);
    }
    put(inout output, " workers ");
    if workers_needed {
        output.push(49);
    } else {
        output.push(48);
    }
    output.push(10);
    let atomics = atomics_new(syms, atomic, workers);
    if atomic || workers {
        check_world(
            inout output,
            inout ctx.types,
            in ctx.names,
            in ctx.world,
            in exprs,
            in atomics
        );
    }
    if atomic {
        let ir = read_ir(inout reader, in bytes, in ctx.nmap, in ctx.tmap);
        check_program(inout output, in ctx.names, in ctx.types, in ir, in atomics);
    }
    pack_text(in output)
}

// Task "stack": one call graph and its policy. Returns the report's roots
// and findings, then `render`, then whether it is accepted.
pub fn check_stack_bound(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mut reader = Reader { pos: 0 };
    let ctx = stack_ctx(inout reader, in bytes);
    let graph = read_graph(inout reader, in bytes, in ctx.nmap);
    let mut output = ChunkSeq::new[u8]();
    write_report(inout output, in ctx.names, in graph);
    pack_text(in output)
}

// The names of a stack-bound input. Its types and world are empty, so
// only the names are read, into a table sized for them; another input
// goes through `read_ctx`.
fn stack_ctx(inout reader: Reader, in bytes: Slice[u8]) -> NamesCtx {
    let ctx = read_names_ctx(inout reader, in bytes);
    if ctx.ok {
        return ctx;
    }
    let full = read_ctx(inout reader, in bytes);
    NamesCtx { names: full.names, nmap: full.nmap, ok: true }
}

// The hybrid task (crates/vesper-hybrid/modules/stack_bound): the names,
// types and world of the harness input (an empty world) and one call
// graph with its policy; the report as words (`report_words`).
pub fn stack_bound_words(in input: Slice[u8]) -> ChunkSeq[u64] {
    let mut reader = Reader { pos: 0 };
    let ctx = stack_ctx(inout reader, in input);
    let graph = read_graph(inout reader, in input, in ctx.nmap);
    let mut output: ChunkSeq[u64] = ChunkSeq::new[u64]();
    report_words(inout output, in ctx.names, in graph);
    output
}

// `stack_bound_words` from the harness's `Str` input.
pub fn check_stack_words(in input: Str) -> ChunkSeq[u64] {
    stack_bound_words(in input.as_bytes())
}
