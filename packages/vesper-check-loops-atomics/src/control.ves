// The control-target rules of `src/loops/check.rs` and the `?`-on-Option
// rule of `src/loops/try_option.rs` (self-hosting wave SH2 lane 10,
// #1182): where `break`, `continue` and `return` may jump, which ranges a
// `for` takes, and which functions may use `?` on an `Option` (E0213,
// E0200).
//
// The Rust checker keeps a stack of `ControlFrame`s while it types a body:
// a function or closure body (the `return` target, which a closure starts
// afresh), a `loop` or `for` body (the `break` and `continue` target), the
// handled body of a `handle` or `region` block, and a handler clause. The
// frames depend only on where an expression sits, so this module walks
// the body with the same stack and reports what the checker reports. The
// rules that need the checker's environment (moves on a back edge E0312,
// linear bindings a jump drops E0302, merges E0309, inout loans and linear
// handler state E0402) stay with the core typing port (SH2 lane 7).

use @vesper/check-data::types::{Types, TyKind};
use @vesper/check-data::names::{Names};
use @vesper/check-data::world::{World};
use self::ast::{Exprs, ExprRow};
use self::out::{line};

const NONE32: u32 = 4294967295;

const E_CLOSURE: u8 = 14;
const E_HANDLE: u8 = 15;
const E_LOOP: u8 = 16;
const E_FOR: u8 = 17;
const E_RANGE: u8 = 18;
const E_BREAK: u8 = 19;
const E_CONTINUE: u8 = 20;
const E_RETURN: u8 = 21;
const E_TRY: u8 = 7;
const E_BLOCK: u8 = 4;

// `ControlFrame`.
const F_FN: u8 = 0;
const F_LOOP: u8 = 1;
const F_FOR: u8 = 2;
const F_BODY: u8 = 3;
const F_REGION: u8 = 4;
const F_CLAUSE: u8 = 5;

pub struct Control {
    frames: ChunkSeq[u8],
    // The expected result type of each frame (NONE32 except `F_FN`).
    expected: ChunkSeq[u32],
    option_name: u32,
    never_name: u32,
}

pub fn control_new(inout names: Names) -> Control {
    Control {
        frames: ChunkSeq::new[u8](),
        expected: ChunkSeq::new[u32](),
        option_name: names.intern(in "Option".as_bytes()),
        never_name: names.intern(in "Never".as_bytes())
    }
}

impl Control {
    fn push(inout self, frame: u8, ty: u32) {
        self.frames.push(frame);
        self.expected.push(ty);
    }

    fn pop(inout self) {
        let popped_frame = self.frames.pop();
        let popped_ty = self.expected.pop();
    }

    fn frame(in self, i: u64) -> u8 {
        self.frames.try_get(i).unwrap_or(F_FN)
    }

    fn last(in self) -> u8 {
        let n = self.frames.len();
        if n == 0 {
            return 255;
        }
        self.frame(wrapping_sub(n, 1))
    }

    fn inside_loop(in self) -> bool {
        for i in 0..self.frames.len() {
            let frame_kind = self.frame(i);
            if frame_kind == F_LOOP || frame_kind == F_FOR {
                return true;
            }
        }
        false
    }

    // The expected type of the innermost function frame, NONE32 if none.
    fn function_result(in self) -> u32 {
        let mut i = self.frames.len();
        loop {
            if i == 0 {
                return NONE32;
            }
            i = wrapping_sub(i, 1);
            if self.frame(i) == F_FN {
                return self.expected.try_get(i).unwrap_or(NONE32);
            }
        }
    }
}

fn is_option(in types: Types, option_name: u32, ty: u32) -> bool {
    if ty == NONE32 {
        return false;
    }
    let node = types.node(ty);
    node.kind == TyKind::Named && node.name == option_name && node.n == 1
}

// The jump message of a `break` (or `continue`) whose innermost frame is
// not a loop (`break_expr`, `continue_expr`).
fn jump_error(inout output: ChunkSeq[u8], in control: Control, is_break: bool, row: ExprRow) {
    let target = control.last();
    let inside = control.inside_loop();
    let message = if (target == F_BODY || target == F_REGION) && inside {
        if is_break {
            "'break' cannot leave a handled body; return a value from the body instead"
        } else {
            "'continue' cannot leave a handled body"
        }
    } else if target == F_CLAUSE && inside {
        if is_break {
            "'break' cannot leave a handler clause"
        } else {
            "'continue' cannot leave a handler clause"
        }
    } else if target == F_FN && inside {
        if is_break {
            "'break' cannot leave a closure"
        } else {
            "'continue' cannot leave a closure"
        }
    } else if is_break {
        "'break' outside of a loop"
    } else {
        "'continue' outside of a loop"
    };
    line(inout output, "E0213", row.start, row.end, message);
}

fn visit_kids(
    inout output: ChunkSeq[u8],
    inout control: Control,
    in exprs: Exprs,
    in types: Types,
    in world: World,
    expr: u32
) {
    for i in 0..exprs.kid_count(expr) {
        visit(inout output, inout control, in exprs, in types, in world, exprs.kid(expr, i));
    }
}

// Visits `expr` as the checker types it, with the frames `control`.
pub fn visit(
    inout output: ChunkSeq[u8],
    inout control: Control,
    in exprs: Exprs,
    in types: Types,
    in world: World,
    expr: u32
) {
    let row = exprs.row(expr);
    let kind = row.kind;
    if kind == E_LOOP {
        control.push(F_LOOP, NONE32);
        visit_kids(inout output, inout control, in exprs, in types, in world, expr);
        control.pop();
    } else if kind == E_FOR {
        let iter = exprs.kid(expr, 0);
        let iter_row = exprs.row(iter);
        if iter_row.kind != E_RANGE {
            // Which iterables a `for` takes is a typed rule (E0213 with the
            // iterable's type, SH3 lane 4, #1243), so it moves with core
            // typing; the checker leaves the body of a rejected `for`
            // unchecked.
            visit(inout output, inout control, in exprs, in types, in world, iter);
            return;
        }
        visit_kids(inout output, inout control, in exprs, in types, in world, iter);
        control.push(F_FOR, NONE32);
        visit(inout output, inout control, in exprs, in types, in world, exprs.kid(expr, 1));
        control.pop();
    } else if kind == E_RANGE {
        line(
            inout output,
            "E0213",
            row.start,
            row.end,
            "a range is only supported as the iterable of a 'for' loop"
        );
        visit_kids(inout output, inout control, in exprs, in types, in world, expr);
    } else if kind == E_BREAK {
        let last = control.last();
        if last == F_LOOP || last == F_FOR {
            if row.flag != 0 && last == F_FOR {
                let break_value = exprs.row(exprs.kid(expr, 0));
                line(
                    inout output,
                    "E0213",
                    break_value.start,
                    break_value.end,
                    "'break' in a 'for' loop takes no value"
                );
            }
        } else {
            jump_error(inout output, in control, true, row);
        }
        visit_kids(inout output, inout control, in exprs, in types, in world, expr);
    } else if kind == E_CONTINUE {
        let last = control.last();
        if last != F_LOOP && last != F_FOR {
            jump_error(inout output, in control, false, row);
        }
    } else if kind == E_RETURN {
        let mut i = control.frames.len();
        let mut message = "'return' outside of a function";
        let mut ok = false;
        loop {
            if i == 0 {
                break;
            }
            i = wrapping_sub(i, 1);
            let frame_kind = control.frame(i);
            if frame_kind == F_REGION {
                message = "'return' cannot leave a region block";
                break;
            }
            if frame_kind == F_CLAUSE {
                message = "'return' cannot leave a handler clause";
                break;
            }
            if frame_kind == F_FN {
                ok = true;
                break;
            }
        }
        if !ok {
            line(inout output, "E0213", row.start, row.end, message);
        }
        visit_kids(inout output, inout control, in exprs, in types, in world, expr);
    } else if kind == E_CLOSURE {
        // A closure body starts a fresh stack (`enter_function`).
        let mut inner = Control {
            frames: ChunkSeq::new[u8](),
            expected: ChunkSeq::new[u32](),
            option_name: control.option_name,
            never_name: control.never_name
        };
        inner.push(F_FN, row.expected);
        visit_kids(inout output, inout inner, in exprs, in types, in world, expr);
    } else if kind == E_HANDLE && row.unchecked {
        // `Checker::handle` returned before the handler (E0400, E0797 or a
        // capability effect): nothing inside it is checked.
    } else if kind == E_HANDLE {
        let mut i: u64 = 0;
        if (row.flag & 1) != 0 {
            visit(inout output, inout control, in exprs, in types, in world, exprs.kid(expr, 0));
            i = 1;
        }
        if (row.flag & 2) != 0 {
            control.push(F_REGION, NONE32);
        } else {
            control.push(F_BODY, NONE32);
        }
        visit(inout output, inout control, in exprs, in types, in world, exprs.kid(expr, i));
        control.pop();
        for j in wrapping_add(i, 1)..exprs.kid_count(expr) {
            let clause = exprs.kid(expr, j);
            // A clause for an undeclared operation is skipped (E0405).
            if !exprs.row(clause).unchecked {
                control.push(F_CLAUSE, NONE32);
                visit(inout output, inout control, in exprs, in types, in world, clause);
                control.pop();
            }
        }
    } else if kind == E_BLOCK {
        // The checker stops a block at a statement of type `Never`: what
        // follows is not checked.
        let n = exprs.kid_count(expr);
        let statements = if row.flag != 0 { wrapping_sub(n, 1) } else { n };
        for i in 0..n {
            let stmt = exprs.kid(expr, i);
            visit(inout output, inout control, in exprs, in types, in world, stmt);
            let stmt_row = exprs.row(stmt);
            if i < statements && !stmt_row.is_let {
                let ty = world.expr_type(stmt_row.start, stmt_row.end);
                if ty != NONE32 {
                    let ty_node = types.node(ty);
                    if ty_node.kind == TyKind::Named && ty_node.name == control.never_name {
                        return;
                    }
                }
            }
        }
    } else if kind == E_TRY {
        let operand = exprs.kid(expr, 0);
        visit(inout output, inout control, in exprs, in types, in world, operand);
        let operand_row = exprs.row(operand);
        let ty = world.expr_type(operand_row.start, operand_row.end);
        if is_option(in types, control.option_name, ty) {
            let expected = control.function_result();
            let fine = expected != NONE32
                && (is_option(in types, control.option_name, expected)
                    || types.kind(expected) == TyKind::Infer);
            if !fine {
                line(
                    inout output,
                    "E0200",
                    row.start,
                    row.end,
                    "'?' on Option[T] requires a function returning Option"
                );
            }
        }
    } else {
        visit_kids(inout output, inout control, in exprs, in types, in world, expr);
    }
}

// Every function body of `exprs` from a fresh function frame (`enter_function`
// with the declared result).
pub fn check_bodies(
    inout output: ChunkSeq[u8],
    inout control: Control,
    in exprs: Exprs,
    in types: Types,
    in world: World
) {
    for i in 0..exprs.fn_count() {
        let func = exprs.function(i);
        if func.body != NONE32 {
            control.frames.clear();
            control.expected.clear();
            control.push(F_FN, func.result);
            visit(inout output, inout control, in exprs, in types, in world, func.body);
        }
    }
}
