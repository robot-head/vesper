// Diagnostics as text lines, the form every differential of this package
// compares: `code start end message`, then `  help: text` when there is
// help. The harness renders Rust's `Diagnostic`s the same way.

pub fn put(inout output: ChunkSeq[u8], in text: Str) {
    output.extend(in text.as_bytes());
}

pub fn put_u64(inout output: ChunkSeq[u8], value: u64) {
    if value >= 10 {
        put_u64(inout output, value / 10);
    }
    output.push(wrapping_u8(wrapping_add(value % 10, 48)));
}

// Starts a diagnostic line; the caller writes the message, then calls
// `end_line` (or `help`).
pub fn open(inout output: ChunkSeq[u8], in code: Str, start: u64, end: u64) {
    put(inout output, code);
    output.push(32);
    put_u64(inout output, start);
    output.push(32);
    put_u64(inout output, end);
    output.push(32);
}

pub fn end_line(inout output: ChunkSeq[u8]) {
    output.push(10);
}

pub fn help(inout output: ChunkSeq[u8], in text: Str) {
    output.push(10);
    put(inout output, "  help: ");
    put(inout output, text);
    output.push(10);
}

// A whole diagnostic with a fixed message and no help.
pub fn line(inout output: ChunkSeq[u8], in code: Str, start: u64, end: u64, in message: Str) {
    open(inout output, code, start, end);
    put(inout output, message);
    output.push(10);
}
