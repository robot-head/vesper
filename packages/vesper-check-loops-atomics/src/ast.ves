// The function bodies a check reads, as flat tables (self-hosting wave SH2
// lane 10, #1182). The harness writes each `ast::Expr` in pre-order
// (tests/self_host_check_loops_atomics.rs, `AstEnc`); this decoder keeps
// one row per expression and one per pattern, children as ranges of one
// shared pool, and types as ids of the check-data arena, so a walk is a
// loop over indices instead of a `Box` tree.

use @vesper/check-data::input::{Reader};

const NONE32: u32 = 4294967295;

// `ExprKind`, in the harness's numbering.
pub const E_LIT: u8 = 0;
pub const E_NAME: u8 = 1;
pub const E_TUPLE: u8 = 2;
pub const E_STRUCT: u8 = 3;
pub const E_BLOCK: u8 = 4;
pub const E_CALL: u8 = 5;
pub const E_FIELD: u8 = 6;
pub const E_TRY: u8 = 7;
pub const E_UNARY: u8 = 8;
pub const E_INDEX: u8 = 9;
pub const E_BINARY: u8 = 10;
pub const E_ASSIGN: u8 = 11;
pub const E_IF: u8 = 12;
pub const E_MATCH: u8 = 13;
pub const E_CLOSURE: u8 = 14;
pub const E_HANDLE: u8 = 15;
pub const E_LOOP: u8 = 16;
pub const E_FOR: u8 = 17;
pub const E_RANGE: u8 = 18;
pub const E_BREAK: u8 = 19;
pub const E_CONTINUE: u8 = 20;
pub const E_RETURN: u8 = 21;

// `PatternKind`.
pub const P_WILD: u8 = 0;
pub const P_BIND: u8 = 1;
pub const P_LIT: u8 = 2;
pub const P_TUPLE: u8 = 3;
pub const P_CTOR: u8 = 4;

// One expression. Children are `kids[kid_start..kid_start+kid_count]` in
// the order the Rust walks visit them (a block's statement values then its
// tail; a call's callee then its arguments; a handle's state, body, return
// clause and operation clauses; a `for`'s iterable then its body).
pub copy struct ExprRow {
    kind: u8,
    // Range: inclusive. Handle: 1 = has state, 2 = region block.
    // Break, Return: has a value. If: has an else. Block: has a tail.
    flag: u8,
    // The `Pass` of the call argument this expression is (0 otherwise).
    pass: u8,
    // 1 when this expression is the value of a `let`.
    is_let: bool,
    // Whether this expression is a match arm's body (its `pat` is the
    // arm's pattern).
    is_arm_body: bool,
    start: u64,
    end: u64,
    // Name, Struct, Field, Call (none): the name symbol.
    name: u32,
    // Closure: its result type as written.
    ty: u32,
    // Closure: the result its function frame expects (the written one, or
    // the expected function type's result when it is `Infer`).
    expected: u32,
    // Handle: the checker returns before checking it. Operation clause
    // body: the checker skips the clause (an undeclared operation).
    unchecked: bool,
    // Let value: the `let` type.
    let_ty: u32,
    // Let value: the `let` pattern. Match arm body: the arm pattern.
    // For: the loop pattern.
    pat: u32,
    kid_start: u32,
    kid_count: u32,
    // Call: its explicit type arguments; Closure: its parameter types
    // (`tys[ty_start..ty_start+ty_count]`).
    ty_start: u32,
    ty_count: u32,
}

pub copy struct PatRow {
    kind: u8,
    start: u64,
    end: u64,
    name: u32,
    kid_start: u32,
    kid_count: u32,
}

// A function's signature and body (`ast::Function`).
pub copy struct FnRow {
    name: u32,
    generics: u32,
    // `atomics::worker_row`: the row holds only stateless capabilities
    worker_row: bool,
    // params: param_passes and param_types[param_start..param_start+param_count]
    param_start: u32,
    param_count: u32,
    result: u32,
    // NONE32 without a body.
    body: u32,
}

pub struct Exprs {
    rows: ChunkSeq[ExprRow],
    kids: ChunkSeq[u32],
    tys: ChunkSeq[u32],
    pats: ChunkSeq[PatRow],
    pat_kids: ChunkSeq[u32],
    fns: ChunkSeq[FnRow],
    param_passes: ChunkSeq[u8],
    param_types: ChunkSeq[u32],
    // The children read so far of the nodes being read: each node's run
    // starts at the length it found, and moves to `kids` or `pat_kids`
    // when the node is done (no sequence per node).
    stack: ChunkSeq[u32],
}

pub fn exprs_new() -> Exprs {
    Exprs {
        rows: ChunkSeq::new[ExprRow](),
        kids: ChunkSeq::new[u32](),
        tys: ChunkSeq::new[u32](),
        pats: ChunkSeq::new[PatRow](),
        pat_kids: ChunkSeq::new[u32](),
        fns: ChunkSeq::new[FnRow](),
        param_passes: ChunkSeq::new[u8](),
        param_types: ChunkSeq::new[u32](),
        stack: ChunkSeq::with_capacity[u32](64)
    }
}

fn at32(in seq: ChunkSeq[u32], i: u64) -> u32 {
    match seq.try_get(i) {
        Option::Some(v) => v,
        Option::None => NONE32,
    }
}

fn empty_row() -> ExprRow {
    ExprRow {
        kind: E_LIT,
        flag: 0,
        pass: 0,
        is_let: false,
        is_arm_body: false,
        start: 0,
        end: 0,
        name: NONE32,
        ty: NONE32,
        expected: NONE32,
        unchecked: false,
        let_ty: NONE32,
        pat: NONE32,
        kid_start: 0,
        kid_count: 0,
        ty_start: 0,
        ty_count: 0
    }
}

impl Exprs {
    pub fn row(in self, expr: u32) -> ExprRow {
        match self.rows.try_get(widen_u64(expr)) {
            Option::Some(r) => r,
            Option::None => empty_row(),
        }
    }

    pub fn kind(in self, expr: u32) -> u8 {
        self.row(expr).kind
    }

    // Child `i` of `expr` (NONE32 past the end).
    pub fn kid(in self, expr: u32, i: u64) -> u32 {
        let row = self.row(expr);
        if i >= widen_u64(row.kid_count) {
            return NONE32;
        }
        at32(in self.kids, wrapping_add(widen_u64(row.kid_start), i))
    }

    // One past the last row of `expr`'s subtree: rows are written in
    // pre-order and nothing else writes rows while a subtree is read, so
    // the subtree is the run `expr..subtree_end(expr)`.
    pub fn subtree_end(in self, expr: u32) -> u32 {
        let mut at = expr;
        loop {
            let row = self.row(at);
            if row.kid_count == 0 {
                return wrapping_add(at, 1);
            }
            at = self.kid(at, wrapping_sub(widen_u64(row.kid_count), 1));
        }
    }

    pub fn kid_count(in self, expr: u32) -> u64 {
        widen_u64(self.row(expr).kid_count)
    }

    pub fn ty_at(in self, expr: u32, i: u64) -> u32 {
        let row = self.row(expr);
        at32(in self.tys, wrapping_add(widen_u64(row.ty_start), i))
    }

    pub fn pat(in self, pattern: u32) -> PatRow {
        match self.pats.try_get(widen_u64(pattern)) {
            Option::Some(r) => r,
            Option::None => PatRow {
                kind: P_WILD,
                start: 0,
                end: 0,
                name: NONE32,
                kid_start: 0,
                kid_count: 0
            },
        }
    }

    pub fn pat_kid(in self, pattern: u32, i: u64) -> u32 {
        let row = self.pat(pattern);
        at32(in self.pat_kids, wrapping_add(widen_u64(row.kid_start), i))
    }

    pub fn fn_count(in self) -> u64 {
        self.fns.len()
    }

    pub fn function(in self, i: u64) -> FnRow {
        match self.fns.try_get(i) {
            Option::Some(f) => f,
            Option::None => FnRow {
                name: NONE32,
                generics: 0,
                worker_row: true,
                param_start: 0,
                param_count: 0,
                result: NONE32,
                body: NONE32
            },
        }
    }

    pub fn param_pass(in self, func: FnRow, i: u64) -> u8 {
        match self.param_passes.try_get(wrapping_add(widen_u64(func.param_start), i)) {
            Option::Some(pass) => pass,
            Option::None => 0,
        }
    }

    pub fn param_type(in self, func: FnRow, i: u64) -> u32 {
        at32(in self.param_types, wrapping_add(widen_u64(func.param_start), i))
    }

    fn set(inout self, expr: u32, row: ExprRow) {
        let ok = self.rows.try_set(widen_u64(expr), row);
    }

    // Moves the children `stack[mark..]` of a pattern to `pat_kids`;
    // returns where they start.
    fn finish_pat_kids(inout self, mark: u64) -> u32 {
        let start = wrapping_u32(self.pat_kids.len());
        let end = self.stack.len();
        for i in mark..end {
            self.pat_kids.push(at32(in self.stack, i));
        }
        self.stack.truncate(mark);
        start
    }
}

fn sym(in nmap: ChunkSeq[u32], name_id: u64) -> u32 {
    at32(in nmap, name_id)
}

// One pattern, in pre-order: kind, start, end, then Bind: name; Tuple: n,
// patterns; Constructor: name, n, (field name, pattern) pairs.
pub fn read_pat(
    inout reader: Reader,
    in bytes: Slice[u8],
    inout exprs: Exprs,
    in nmap: ChunkSeq[u32],
    in tmap: ChunkSeq[u32]
) -> u32 {
    let kind = wrapping_u8(reader.word(in bytes));
    let start = reader.word(in bytes);
    let end = reader.word(in bytes);
    let id = wrapping_u32(exprs.pats.len());
    exprs.pats.push(
        PatRow { kind: kind, start: start, end: end, name: NONE32, kid_start: 0, kid_count: 0 }
    );
    let mut name = NONE32;
    let mark = exprs.stack.len();
    if kind == P_BIND {
        name = sym(in nmap, reader.word(in bytes));
    } else if kind == P_TUPLE {
        let n = reader.word(in bytes);
        for i in 0..n {
            let kid = read_pat(inout reader, in bytes, inout exprs, in nmap, in tmap);
            exprs.stack.push(kid);
        }
    } else if kind == P_CTOR {
        name = sym(in nmap, reader.word(in bytes));
        let n = reader.word(in bytes);
        for i in 0..n {
            let field = reader.word(in bytes);
            let kid = read_pat(inout reader, in bytes, inout exprs, in nmap, in tmap);
            exprs.stack.push(kid);
        }
    }
    let kid_count = wrapping_u32(wrapping_sub(exprs.stack.len(), mark));
    let kid_start = exprs.finish_pat_kids(mark);
    let ok = exprs.pats.try_set(
        widen_u64(id),
        PatRow {
            kind: kind,
            start: start,
            end: end,
            name: name,
            kid_start: kid_start,
            kid_count: kid_count
        }
    );
    id
}

fn read_types_into(
    inout reader: Reader,
    in bytes: Slice[u8],
    inout exprs: Exprs,
    in tmap: ChunkSeq[u32],
    n: u64
) -> u32 {
    let start = wrapping_u32(exprs.tys.len());
    for i in 0..n {
        exprs.tys.push(at32(in tmap, reader.word(in bytes)));
    }
    start
}

// What a parent knows of a child expression before reading it: the
// argument's `Pass`, a `let` value's type and pattern, a match arm's
// pattern, and an operation clause the checker skips.
pub copy struct Up {
    pass: u8,
    is_let: bool,
    is_arm_body: bool,
    unchecked: bool,
    let_ty: u32,
    pat: u32,
}

pub fn up_none() -> Up {
    Up { pass: 0, is_let: false, is_arm_body: false, unchecked: false, let_ty: NONE32, pat: NONE32 }
}

// One expression in pre-order: kind, start, end, then the kind's words
// (see `AstEnc::expr` in the harness).
pub fn read_expr(
    inout reader: Reader,
    in bytes: Slice[u8],
    inout exprs: Exprs,
    in nmap: ChunkSeq[u32],
    in tmap: ChunkSeq[u32],
    up: Up
) -> u32 {
    let kind = wrapping_u8(reader.word(in bytes));
    let start = reader.word(in bytes);
    let end = reader.word(in bytes);
    let id = wrapping_u32(exprs.rows.len());
    let mut row = empty_row();
    row.kind = kind;
    row.start = start;
    row.end = end;
    row.pass = up.pass;
    row.is_let = up.is_let;
    row.is_arm_body = up.is_arm_body;
    row.unchecked = up.unchecked;
    row.let_ty = up.let_ty;
    row.pat = up.pat;
    exprs.rows.push(row);
    let mark = exprs.stack.len();
    if kind == E_NAME {
        row.name = sym(in nmap, reader.word(in bytes));
    } else if kind == E_TUPLE {
        let n = reader.word(in bytes);
        for i in 0..n {
            let kid = read_expr(inout reader, in bytes, inout exprs, in nmap, in tmap, up_none());
            exprs.stack.push(kid);
        }
    } else if kind == E_STRUCT {
        row.name = sym(in nmap, reader.word(in bytes));
        let n = reader.word(in bytes);
        for i in 0..n {
            let kid = read_expr(inout reader, in bytes, inout exprs, in nmap, in tmap, up_none());
            exprs.stack.push(kid);
        }
    } else if kind == E_BLOCK {
        let n = reader.word(in bytes);
        for i in 0..n {
            let tag = reader.word(in bytes);
            if tag == 0 {
                let pattern = read_pat(inout reader, in bytes, inout exprs, in nmap, in tmap);
                let let_ty = at32(in tmap, reader.word(in bytes));
                let mut kid_up = up_none();
                kid_up.is_let = true;
                kid_up.pat = pattern;
                kid_up.let_ty = let_ty;
                let let_value = read_expr(
                    inout reader,
                    in bytes,
                    inout exprs,
                    in nmap,
                    in tmap,
                    kid_up
                );
                exprs.stack.push(let_value);
            } else {
                let kid = read_expr(
                    inout reader,
                    in bytes,
                    inout exprs,
                    in nmap,
                    in tmap,
                    up_none()
                );
                exprs.stack.push(kid);
            }
        }
        if reader.word(in bytes) != 0 {
            row.flag = 1;
            let kid = read_expr(inout reader, in bytes, inout exprs, in nmap, in tmap, up_none());
            exprs.stack.push(kid);
        }
    } else if kind == E_CALL {
        let kid = read_expr(inout reader, in bytes, inout exprs, in nmap, in tmap, up_none());
        exprs.stack.push(kid);
        let ty_count = reader.word(in bytes);
        row.ty_start = read_types_into(inout reader, in bytes, inout exprs, in tmap, ty_count);
        row.ty_count = wrapping_u32(ty_count);
        let n = reader.word(in bytes);
        for i in 0..n {
            let mut kid_up = up_none();
            kid_up.pass = wrapping_u8(reader.word(in bytes));
            let arg = read_expr(inout reader, in bytes, inout exprs, in nmap, in tmap, kid_up);
            exprs.stack.push(arg);
        }
    } else if kind == E_FIELD {
        let kid = read_expr(inout reader, in bytes, inout exprs, in nmap, in tmap, up_none());
        exprs.stack.push(kid);
        row.name = sym(in nmap, reader.word(in bytes));
    } else if kind == E_TRY || kind == E_UNARY || kind == E_LOOP {
        let kid = read_expr(inout reader, in bytes, inout exprs, in nmap, in tmap, up_none());
        exprs.stack.push(kid);
    } else if kind == E_INDEX || kind == E_BINARY || kind == E_ASSIGN {
        let kid = read_expr(inout reader, in bytes, inout exprs, in nmap, in tmap, up_none());
        exprs.stack.push(kid);
        let kid = read_expr(inout reader, in bytes, inout exprs, in nmap, in tmap, up_none());
        exprs.stack.push(kid);
    } else if kind == E_IF {
        let kid = read_expr(inout reader, in bytes, inout exprs, in nmap, in tmap, up_none());
        exprs.stack.push(kid);
        let kid = read_expr(inout reader, in bytes, inout exprs, in nmap, in tmap, up_none());
        exprs.stack.push(kid);
        if reader.word(in bytes) != 0 {
            row.flag = 1;
            let kid = read_expr(inout reader, in bytes, inout exprs, in nmap, in tmap, up_none());
            exprs.stack.push(kid);
        }
    } else if kind == E_MATCH {
        let kid = read_expr(inout reader, in bytes, inout exprs, in nmap, in tmap, up_none());
        exprs.stack.push(kid);
        let n = reader.word(in bytes);
        for i in 0..n {
            let mut kid_up = up_none();
            kid_up.pat = read_pat(inout reader, in bytes, inout exprs, in nmap, in tmap);
            kid_up.is_arm_body = true;
            let arm_body = read_expr(inout reader, in bytes, inout exprs, in nmap, in tmap, kid_up);
            exprs.stack.push(arm_body);
        }
    } else if kind == E_CLOSURE {
        let n = reader.word(in bytes);
        row.ty_start = read_types_into(inout reader, in bytes, inout exprs, in tmap, n);
        row.ty_count = wrapping_u32(n);
        row.ty = at32(in tmap, reader.word(in bytes));
        row.expected = at32(in tmap, reader.word(in bytes));
        let kid = read_expr(inout reader, in bytes, inout exprs, in nmap, in tmap, up_none());
        exprs.stack.push(kid);
    } else if kind == E_HANDLE {
        let flags = reader.word(in bytes);
        row.flag = wrapping_u8(flags & 3);
        row.unchecked = up.unchecked || (flags & 4) != 0;
        if (row.flag & 1) != 0 {
            let kid = read_expr(inout reader, in bytes, inout exprs, in nmap, in tmap, up_none());
            exprs.stack.push(kid);
        }
        let kid = read_expr(inout reader, in bytes, inout exprs, in nmap, in tmap, up_none());
        exprs.stack.push(kid);
        let kid = read_expr(inout reader, in bytes, inout exprs, in nmap, in tmap, up_none());
        exprs.stack.push(kid);
        let n = reader.word(in bytes);
        for i in 0..n {
            let mut kid_up = up_none();
            kid_up.unchecked = reader.word(in bytes) == 0;
            let clause = read_expr(inout reader, in bytes, inout exprs, in nmap, in tmap, kid_up);
            exprs.stack.push(clause);
        }
    } else if kind == E_FOR {
        // A `let` or arm pattern from the parent wins over the loop's
        // own (the parent wrote its pattern last).
        let pattern = read_pat(inout reader, in bytes, inout exprs, in nmap, in tmap);
        if up.pat == NONE32 {
            row.pat = pattern;
        }
        let kid = read_expr(inout reader, in bytes, inout exprs, in nmap, in tmap, up_none());
        exprs.stack.push(kid);
        let kid = read_expr(inout reader, in bytes, inout exprs, in nmap, in tmap, up_none());
        exprs.stack.push(kid);
    } else if kind == E_RANGE {
        row.flag = wrapping_u8(reader.word(in bytes));
        let kid = read_expr(inout reader, in bytes, inout exprs, in nmap, in tmap, up_none());
        exprs.stack.push(kid);
        let kid = read_expr(inout reader, in bytes, inout exprs, in nmap, in tmap, up_none());
        exprs.stack.push(kid);
    } else if kind == E_BREAK || kind == E_RETURN {
        if reader.word(in bytes) != 0 {
            row.flag = 1;
            let kid = read_expr(inout reader, in bytes, inout exprs, in nmap, in tmap, up_none());
            exprs.stack.push(kid);
        }
    }
    // Nothing else writes this node's row (the fields a parent knows come
    // in `up`), so the local row, with its children, is the whole row.
    let end_kids = exprs.stack.len();
    row.kid_start = wrapping_u32(exprs.kids.len());
    row.kid_count = wrapping_u32(wrapping_sub(end_kids, mark));
    for i in mark..end_kids {
        let kid = at32(in exprs.stack, i);
        exprs.kids.push(kid);
    }
    exprs.stack.truncate(mark);
    exprs.set(id, row);
    id
}

// A function record: name, generics, pure row, n, n (pass, type) pairs,
// result, has body, body.
pub fn read_fn(
    inout reader: Reader,
    in bytes: Slice[u8],
    inout exprs: Exprs,
    in nmap: ChunkSeq[u32],
    in tmap: ChunkSeq[u32]
) -> FnRow {
    let name = sym(in nmap, reader.word(in bytes));
    let generics = wrapping_u32(reader.word(in bytes));
    let worker_row = reader.word(in bytes) != 0;
    let param_count = reader.word(in bytes);
    let param_start = wrapping_u32(exprs.param_passes.len());
    for i in 0..param_count {
        exprs.param_passes.push(wrapping_u8(reader.word(in bytes)));
        exprs.param_types.push(at32(in tmap, reader.word(in bytes)));
    }
    let result = at32(in tmap, reader.word(in bytes));
    let body = if reader.word(in bytes) != 0 {
        read_expr(inout reader, in bytes, inout exprs, in nmap, in tmap, up_none())
    } else {
        NONE32
    };
    FnRow {
        name: name,
        generics: generics,
        worker_row: worker_row,
        param_start: param_start,
        param_count: wrapping_u32(param_count),
        result: result,
        body: body
    }
}

// `n` function records, kept in `exprs.fns`.
pub fn read_fns(
    inout reader: Reader,
    in bytes: Slice[u8],
    inout exprs: Exprs,
    in nmap: ChunkSeq[u32],
    in tmap: ChunkSeq[u32]
) {
    let n = reader.word(in bytes);
    // An expression takes at least three words (kind, start, end), so a
    // ninth of the words left is a fair first size for the tables.
    let left = if reader.pos < bytes.len() {
        wrapping_sub(bytes.len(), reader.pos) >> 3
    } else {
        0
    };
    exprs.rows.reserve(left / 9);
    exprs.kids.reserve(left / 9);
    exprs.fns.reserve(n);
    for i in 0..n {
        let func = read_fn(inout reader, in bytes, inout exprs, in nmap, in tmap);
        exprs.fns.push(func);
    }
}
