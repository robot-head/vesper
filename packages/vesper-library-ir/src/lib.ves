// @vesper/library-ir: the IR pipeline `vesper build --lib` runs on a
// library's first lowering (src/native_export.rs `library_program`) in
// Vesper, for the Stage 2 bootstrap switch (slice 3, #2659, #2662).
//
// The input is a stage word (`LibraryStage`: where the pipeline stops), the
// optimize flag, then @vesper/codegen-calls' calls input of the first
// lowering: @vesper/check-data's names, types and world, @vesper/place-ir's
// program section and the calls section. The steps, in Rust's order:
//
// - widths.ves: `lower_bit_builtin_calls` and `refine_wide_tuples`.
// - optimized: `ir_opt::optimize` through the native policy
//   (@vesper/ir-opt-policy's screen, @vesper/ir-opt's memory forwarding),
//   then tokens.ves (`ir::thread_tokens`); unoptimized: `fip_reuse_pass`.
// - optimized: the inliner under `Budget::for_program` (inline.ves, over
//   @vesper/ir-inline), with the world's facts from facts.ves.
// - `fip::elaborate_non_fip_drops`.
// - optimized: bounds hoisting (@vesper/bounds-hoist's `hoist_program`).
//
// `@fip` reuse and drop elaboration do nothing in a world without the
// `Box` prelude; a world with it is refused until they are ported. The
// output is a status word (`Status`), then, when it is `Status::Ok`, the program as
// `put_program` words (names, types, program section), which
// tests/common/ir_words.rs `decode_program` reads back.

use @vesper/check-data::input::{Ctx, Reader, put_world, read_ctx};
use @vesper/check-data::util::{stage2_heap_mark, stage2_heap_reset, stage2_heap_swap};
use @vesper/place-ir::{
    Program, put_names, put_program, put_program_section, put_types, read_program
};
use @vesper/codegen-calls::data::{Calls, put_calls, read_calls};
use @vesper/ir-opt::view::{type_classes};
use @vesper/ir-opt::forward::{forward_program_kept};
use @vesper/ir-opt-policy::screen::{screen_program};
use @vesper/bounds-hoist::pass::{hoist_program, hoist_until};
use self::widths::{lower_bit_builtin_calls, refine_wide_tuples};
use self::tokens::{thread_tokens, thread_tokens_until};
use self::inline::{inline_input_words, inline_program};

// `LibraryStage`, in order: each stage includes the ones before it.
pub enum Stage: _ {
    Widths = 0,
    Optimize = 1,
    Inline = 2,
    Drops = 3,
    Hoist = 4,
}

// The output's status word. 1 to 3 are @vesper/ir-opt's: a read lacks
// state evidence, egglog would refuse a block, a `slot_key` error.
pub enum Status: _ {
    Ok = 0,
    // The world has the `Box` prelude: `@fip` reuse and drop elaboration
    // are not ported yet.
    FipActive = 16,
    // The inliner's output does not list the program's functions in order.
    InlineMismatch = 17,
}

// @vesper/ir-opt's status for a program it optimized.
const OPT_OK: u8 = 0;

// The harness's entry (crates/vesper-codegen-swap-test/tests/self_host_library_ir.rs
// passes a `Str`).
pub fn library_ir_text(in input: Str) -> ChunkSeq[u64] {
    library_ir_words(in input.as_bytes())
}

fn refused(status: u64) -> ChunkSeq[u64] {
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    out.push(status);
    out
}

pub fn library_ir_words(in b: Slice[u8]) -> ChunkSeq[u64] {
    let mut r = Reader { pos: 0 };
    let stage = r.word(in b);
    let optimize = r.word(in b) != 0;
    let mut c = read_ctx(inout r, in b);
    let mut p = read_program(inout r, in b, in c);
    let calls = read_calls(inout r, in b, in c);
    let status = run(inout c, inout p, in calls, stage, optimize);
    if status != Status::Ok {
        return refused(status);
    }
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    out.push(Status::Ok);
    put_program(in p, in c.types, in c.names, inout out);
    out
}

// The bytes of one word of a calls input.
const WORD_BYTES: u64 = 8;

// The calls input of the program the walk defines a library's instances
// from (`native_export::library_walk_program`, slice 3f of #2659): the
// whole pipeline (`Stage::Hoist`) over `input`, the calls input of the
// first lowering, written back as a calls input (check-data's names,
// types and world, the place-ir program section, the calls section) for
// @vesper/native-lib. The status word, then the input's bytes when it is
// `Status::Ok`.
pub fn library_walk_calls_input(in input: Slice[u8], optimize: bool) -> (u64, ChunkSeq[u8]) {
    // Stage 2's self-built heap frees nothing by itself, and each pass
    // leaves its temporaries behind: a big library's pipeline outgrew the
    // 4 GiB memory (#2735). Between passes the state is written into a
    // hole reserved here and read back past it, which drops every
    // temporary before (`compact`).
    let size = wrapping_add(wrapping_mul(input.len(), HOLE_INPUT_FACTOR), HOLE_SLACK_BYTES);
    let mut reserved: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let hole_end = if stage2_heap_mark() != 0 {
        reserved.reserve(size);
        stage2_heap_mark()
    } else {
        0
    };
    let hole_start = if hole_end != 0 {
        wrapping_sub(hole_end, size)
    } else {
        0
    };
    let mut r = Reader { pos: 0 };
    let mut c = read_ctx(inout r, in input);
    let mut p = read_program(inout r, in input, in c);
    let mut calls = read_calls(inout r, in input, in c);
    let status = run_optimize(inout c, inout p, in calls, Stage::Hoist, optimize);
    if status != Status::Ok {
        return (status, ChunkSeq::new[u8]());
    }
    let _ = compact(inout c, inout p, inout calls, hole_start, hole_end);
    let status = run_inline(inout c, inout p, in calls, Stage::Hoist, optimize);
    if status != Status::Ok {
        return (status, ChunkSeq::new[u8]());
    }
    let _ = compact(inout c, inout p, inout calls, hole_start, hole_end);
    // Token threading and bounds hoisting go function by function, with
    // the state compacted whenever the heap outgrows the budget. A
    // compaction that did not fit ends the budget: the rest runs as it
    // would with no hole.
    if optimize {
        let mut limit = budget_mark(hole_end);
        let n = p.fn_count();
        let mut next: u64 = 0;
        loop {
            next = thread_tokens_until(inout p, in c.names, next, limit);
            if next >= n || limit == 0 {
                break;
            }
            let compaction = compact(inout c, inout p, inout calls, hole_start, hole_end);
            if compaction != Compaction::Done {
                limit = 0;
            }
        }
        if limit != 0 {
            let compaction = compact(inout c, inout p, inout calls, hole_start, hole_end);
            if compaction != Compaction::Done {
                limit = 0;
            }
        }
        let n = p.fn_count();
        let mut next: u64 = 0;
        loop {
            let (after, versioned) = hoist_until(inout p, inout c, next, limit);
            next = after;
            if next >= n || limit == 0 {
                break;
            }
            let compaction = compact(inout c, inout p, inout calls, hole_start, hole_end);
            if compaction != Compaction::Done {
                limit = 0;
            }
        }
    }
    (Status::Ok, calls_input_bytes(in c, in p, in calls))
}

// The calls input of `c`, `p` and `calls`: check-data's names, types and
// world, the place-ir program section and the calls section, as bytes.
fn calls_input_bytes(in c: Ctx, in p: Program, in calls: Calls) -> ChunkSeq[u8] {
    let o = calls_input_words(in c, in p, in calls);
    let mut out: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](wrapping_mul(o.len(), WORD_BYTES));
    words_into(in o, inout out);
    out
}

fn calls_input_words(in c: Ctx, in p: Program, in calls: Calls) -> ChunkSeq[u64] {
    let mut o: ChunkSeq[u64] = ChunkSeq::new[u64]();
    put_names(inout o, in c.names);
    put_types(inout o, in c.types);
    put_world(in c.world, inout o);
    put_program_section(in p, inout o);
    put_calls(in calls, in c.types, inout o);
    o
}

// Appends `o`'s words to `out`, little-endian.
fn words_into(in o: ChunkSeq[u64], inout out: ChunkSeq[u8]) {
    for i in 0..o.len() {
        let v = o.try_get(i).unwrap_or(0);
        for k in 0..WORD_BYTES {
            out.push(wrapping_u8(
                wrapping_shr_u64(v, wrapping_u32(wrapping_mul(k, BYTE_BITS))) & BYTE_MASK
            ));
        }
    }
}

const BYTE_BITS: u64 = 8;
const BYTE_MASK: u64 = 255;

// The hole's size: the input's bytes this many times over, plus the slack,
// for the pipeline's state as the passes grow it (the inliner most).
const HOLE_INPUT_FACTOR: u64 = 8;
const HOLE_SLACK_BYTES: u64 = 67108864;

// Heap a pass may use past the hole before the state is compacted.
const COMPACT_BUDGET_BYTES: u64 = 1073741824;

// The heap mark past which a pass stops for `compact` (0: never, when
// there is no hole).
fn budget_mark(hole_end: u64) -> u64 {
    if hole_end == 0 {
        0
    } else {
        wrapping_add(hole_end, COMPACT_BUDGET_BYTES)
    }
}

// What `compact` did.
pub enum Compaction: _ {
    Done = 0,
    NoHole = 1,
    // The encoding is bigger than the hole.
    TooBig = 2,
    // The copy ran past the hole's end.
    Overran = 3,
}

// The state replaced by its own calls input read back, written into the hole
// (`hole_start`..`hole_end`, which `library_walk_calls_input` reserves; no
// hole outside Stage 2's self-built heap) after the heap is reset to the
// hole's end, so every temporary since the hole was reserved is freed
// (`Compaction::Done`). The state is left as it is when there is no hole
// or its encoding does not fit, and the answer says why. Only one bulk copy runs inside the hole:
// Stage 2 frees nothing a function with an `inout` parameter allocates,
// so an element-by-element copy there would run past it.
fn compact(
    inout c: Ctx,
    inout p: Program,
    inout calls: Calls,
    hole_start: u64,
    hole_end: u64
) -> u64 {
    if hole_end == 0 {
        return Compaction::NoHole;
    }
    let bytes = calls_input_bytes(in c, in p, in calls);
    let size = bytes.len();
    if wrapping_add(size, HOLE_SLACK_BYTES) > wrapping_sub(hole_end, hole_start) {
        return Compaction::TooBig;
    }
    let outside = stage2_heap_swap(hole_start);
    let mut kept: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](size);
    kept.extend(in bytes.as_slice());
    let kept_end = stage2_heap_mark();
    let _ = stage2_heap_swap(outside);
    if kept_end > hole_end {
        return Compaction::Overran;
    }
    stage2_heap_reset(hole_end);
    let mut r = Reader { pos: 0 };
    c = read_ctx(inout r, in kept.as_slice());
    p = read_program(inout r, in kept.as_slice(), in c);
    calls = read_calls(inout r, in kept.as_slice(), in c);
    Compaction::Done
}

// The pipeline through `stage` over the first lowering `p`: the status.
fn run(inout c: Ctx, inout p: Program, in calls: Calls, stage: u64, optimize: bool) -> u64 {
    let status = run_optimize(inout c, inout p, in calls, stage, optimize);
    if status != Status::Ok {
        return status;
    }
    let status = run_inline(inout c, inout p, in calls, stage, optimize);
    if status != Status::Ok {
        return status;
    }
    run_rethread(inout c, inout p, stage, optimize);
    run_hoist(inout c, inout p, stage, optimize);
    Status::Ok
}

// `run` up to the inliner: widths, then the optimizer and token threading.
fn run_optimize(
    inout c: Ctx,
    inout p: Program,
    in calls: Calls,
    stage: u64,
    optimize: bool
) -> u64 {
    lower_bit_builtin_calls(inout p, in c.names, c.world.k, in calls);
    refine_wide_tuples(inout p, inout c.types, c.world.k);
    if stage >= Stage::Optimize {
        if c.world.box_active {
            return Status::FipActive;
        }
        if optimize {
            let cls = type_classes(in c.types, in c.names);
            let (keep, kept) = screen_program(in p, in c.names, in cls);
            if kept != 0 {
                let n = p.insts.len();
                let mut orig: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](n);
                for k in 0..n {
                    orig.push(k);
                }
                let (st, forwarded) = forward_program_kept(
                    inout p,
                    in c.names,
                    in cls,
                    inout orig,
                    in keep
                );
                if st != OPT_OK {
                    return widen_u64(st);
                }
            }
            thread_tokens(inout p, in c.names);
        }
    }
    Status::Ok
}

// `run`'s inliner, then token threading again (`run_rethread`).
fn run_inline(inout c: Ctx, inout p: Program, in calls: Calls, stage: u64, optimize: bool) -> u64 {
    if stage >= Stage::Inline && optimize {
        if !inline_program(inout p, inout c.names, inout c.types, in c.world, in calls) {
            return Status::InlineMismatch;
        }
    }
    Status::Ok
}

fn run_rethread(inout c: Ctx, inout p: Program, stage: u64, optimize: bool) {
    if stage >= Stage::Inline && optimize {
        thread_tokens(inout p, in c.names);
    }
}

// `run`'s bounds hoisting. `elaborate_non_fip_drops` adds nothing without
// the `Box` prelude.
fn run_hoist(inout c: Ctx, inout p: Program, stage: u64, optimize: bool) {
    if stage >= Stage::Hoist && optimize {
        let versioned = hoist_program(inout p, inout c);
    }
}

// The harness's view of the inliner's input (inline.ves `encode`): the
// pipeline through the optimizer, then `inline_input`'s bytes for the
// optimized program as `inline_input_words` packs them, after a status
// word.
pub fn library_inline_input_text(in input: Str) -> ChunkSeq[u64] {
    let b = input.as_bytes();
    let mut r = Reader { pos: 0 };
    let stage = r.word(in b);
    let optimize = r.word(in b) != 0;
    let mut c = read_ctx(inout r, in b);
    let mut p = read_program(inout r, in b, in c);
    let calls = read_calls(inout r, in b, in c);
    lower_bit_builtin_calls(inout p, in c.names, c.world.k, in calls);
    refine_wide_tuples(inout p, inout c.types, c.world.k);
    if c.world.box_active {
        return refused(Status::FipActive);
    }
    if optimize {
        let cls = type_classes(in c.types, in c.names);
        let (keep, kept) = screen_program(in p, in c.names, in cls);
        if kept != 0 {
            let n = p.insts.len();
            let mut orig: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](n);
            for k in 0..n {
                orig.push(k);
            }
            let (st, forwarded) = forward_program_kept(
                inout p,
                in c.names,
                in cls,
                inout orig,
                in keep
            );
            if st != OPT_OK {
                return refused(widen_u64(st));
            }
        }
        thread_tokens(inout p, in c.names);
    }
    let mut out = refused(Status::Ok);
    let words = inline_input_words(inout p, inout c.names, inout c.types, in c.world, in calls);
    out.extend(in words.as_slice());
    out
}
