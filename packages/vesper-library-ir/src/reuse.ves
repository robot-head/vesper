// `ir_opt::fip_reuse_pass` (src/ir_opt.rs) on the library's program:
// @vesper/ir-opt's reuse.ves pairs the allocations of each `@fip`
// function with the slots its patterns unpack, from the world's answers
// (`Facts`). tests/self_host_ir_opt.rs writes those facts in Rust
// (tests/common/ir_opt_words.rs `Facts::words`); here they are computed
// from the calls input:
//
// - a function is `@fip` by its calls row;
// - `fip::box_inner`, `fip::pattern_box_slots` over the place-ir
//   patterns, and `caller_slot_functions` from the calls section;
// - `slot_key`: a type with none of the function's generics keys by its
//   layout's size (@vesper/check-layout), any other by the type itself
//   (types are hash-consed, so the id is the `Display` text's identity).
//
// The `BoxReuse` payloads the pass makes become pool rows labeled with the
// `FipOp`'s `Debug` text (place-ir's `PoolKind::MakeFip`, which
// tests/common/ir_words.rs `decode_program` parses back).

use @vesper/check-data::util::{add, inc, n32, push_decimal, u32_at, u64_at, w};
use @vesper/check-data::names::{Names};
use @vesper/check-data::types::{TyKind, Types, default_type, substitute, vars_new};
use @vesper/check-data::world::{World, constructor};
use @vesper/check-data::input::{Reader};
use @vesper/check-layout::{Layouts, layout_of, layouts_new};
use @vesper/codegen-calls::data::{Calls};
use @vesper/place-ir::{FnRow, PoolRow, Program};
use @vesper/place-ir::codes::{Op, Pat};
use @vesper/ir-opt::reuse::{Facts, read_facts, reuse_new, reuse_program};
use self::facts::{pattern_end};

const NONE32: u32 = 4294967295;
const NO_CTOR: u64 = 18446744073709551615;
const CTOR_SPLIT: u64 = 4294967296;
// Words of a pattern before its kind's own words: kind, span start, end.
const PAT_HEAD: u64 = 3;
const COLON: u8 = 58;
const PATH_SEP_LEN: u64 = 2;
const WORD_BYTES: u64 = 8;

// The fact records (reuse.ves `F_*`; constants are not imported across
// packages yet).
const F_NONE: u64 = 0;
const F_BIND: u64 = 1;
const F_BIND_ERR: u64 = 2;
const F_NEED: u64 = 3;
const F_NEED_ERR: u64 = 4;

// place-ir's pool kind of a made `FipOp` (`POOL_MAKE_FIP`).
const POOL_MAKE_FIP: u64 = 10;
// Words per `BoxReuse` payload: bind dest, slot index, size.
const PAYLOAD_WORDS: u64 = 3;

// A slot key's kinds: by layout size, or by the (generic) type.
const KEY_SIZE: u64 = 0;
const KEY_TYPE: u64 = 1;

// The answers so far: keys in first-use order, and how many `slot_key`
// errors were met (their messages stay Rust's).
pub struct Keys {
    kind: ChunkSeq[u64],
    value: ChunkSeq[u64],
    errors: u64,
}

fn key_of(inout keys: Keys, kind: u64, value: u64) -> u64 {
    for i in 0..keys.kind.len() {
        if u64_at(in keys.kind, i) == kind && u64_at(in keys.value, i) == value {
            return i;
        }
    }
    keys.kind.push(kind);
    keys.value.push(value);
    wrapping_sub(keys.kind.len(), 1)
}

fn in_generics(in calls: Calls, fi: u32, sym: u32) -> bool {
    let info = calls.fn_info(fi);
    for k in 0..w(info.generic_count) {
        if calls.generic(add(w(info.generic_start), k)) == sym {
            return true;
        }
    }
    false
}

// `has_generic` of `slot_key`.
fn has_generic(in t: Types, in calls: Calls, fi: u32, ty: u32) -> bool {
    let n = t.node(ty);
    if n.kind == TyKind::Named {
        if in_generics(in calls, fi, n.name) {
            return true;
        }
        for i in 0..w(n.n) {
            if has_generic(in t, in calls, fi, t.arg(ty, i)) {
                return true;
            }
        }
        return false;
    }
    if n.kind == TyKind::Tuple {
        for i in 0..w(n.n) {
            if has_generic(in t, in calls, fi, t.arg(ty, i)) {
                return true;
            }
        }
        return false;
    }
    if n.kind == TyKind::Fn {
        for i in 0..w(n.n) {
            if has_generic(in t, in calls, fi, t.arg(ty, i)) {
                return true;
            }
        }
        return has_generic(in t, in calls, fi, n.r);
    }
    false
}

// `slot_key(world, generics, ty)`: (key, size), or (NONE, 0) on an error.
fn slot_key(
    inout t: Types,
    inout names: Names,
    in wd: World,
    in calls: Calls,
    inout ls: Layouts,
    inout keys: Keys,
    fi: u32,
    ty: u32
) -> (u64, u64) {
    let norm = default_type(inout t, ty);
    if has_generic(in t, in calls, fi, norm) {
        return (key_of(inout keys, KEY_TYPE, w(norm)), 0);
    }
    let lid = layout_of(inout ls, inout t, inout names, in wd, norm);
    if lid == NONE32 {
        return (NO_CTOR, 0);
    }
    let size = w(ls.node(lid).size);
    (key_of(inout keys, KEY_SIZE, size), size)
}

fn box_inner(in t: Types, in wd: World, ty: u32) -> u32 {
    let n = t.node(ty);
    if wd.box_active && n.kind == TyKind::Named && n.name == wd.k.box_ && w(n.n) == 1 {
        t.arg(ty, 0)
    } else {
        NONE32
    }
}

fn sub_sym(in names: Names, name: u32, lo: u64, hi: u64) -> u32 {
    let mut text: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for i in lo..hi {
        text.push(names.byte(name, i));
    }
    names.lookup(in text.as_slice())
}

fn find_colons(in names: Names, name: u32, from: u64) -> u64 {
    let n = names.size(name);
    let mut i = from;
    loop {
        if inc(i) >= n {
            return n;
        }
        if names.byte(name, i) == COLON && names.byte(name, inc(i)) == COLON {
            return i;
        }
        i = inc(i);
    }
    n
}

// `World::constructor(name)`.
fn ctor(in names: Names, in wd: World, name: u32) -> u64 {
    let n = names.size(name);
    let first = find_colons(in names, name, 0);
    if first >= n {
        return constructor(in wd, NONE32, name);
    }
    if find_colons(in names, name, add(first, PATH_SEP_LEN)) < n {
        return NO_CTOR;
    }
    let qual = sub_sym(in names, name, 0, first);
    let short = sub_sym(in names, name, add(first, PATH_SEP_LEN), n);
    if qual == NONE32 || short == NONE32 {
        return NO_CTOR;
    }
    constructor(in wd, qual, short)
}

fn is_box_pattern(in p: Program, in names: Names, in wd: World, at: u64) -> bool {
    if !wd.box_active || p.op(at) != Pat::Constructor {
        return false;
    }
    let body = add(at, PAT_HEAD);
    let name = n32(p.op(body));
    let boxed = names.spells(name, in "Box".as_bytes())
        || names.spells(name, in "Box::Box".as_bytes());
    boxed && p.op(add(body, 2)) == 1 && names.spells(n32(p.op(add(body, 3))), in "0".as_bytes())
}

// `fip::pattern_box_slots(pattern, ty)`: the inner type of every `Box`
// the pattern at `at` unpacks, in preorder.
fn box_slots(
    inout t: Types,
    in names: Names,
    in wd: World,
    in p: Program,
    at: u64,
    ty: u32,
    inout out: ChunkSeq[u32]
) {
    let kind = p.op(at);
    let body = add(at, PAT_HEAD);
    if kind == Pat::Tuple {
        let tn = t.node(ty);
        let n = p.op(body);
        let mut q = inc(body);
        for i in 0..n {
            if tn.kind == TyKind::Tuple && i < w(tn.n) {
                let a = t.arg(ty, i);
                box_slots(inout t, in names, in wd, in p, q, a, inout out);
            }
            q = pattern_end(in p, q);
        }
    } else if kind == Pat::Constructor {
        if is_box_pattern(in p, in names, in wd, at) {
            let inner = box_inner(in t, in wd, ty);
            out.push(inner);
            box_slots(inout t, in names, in wd, in p, add(body, 4), inner, inout out);
            return;
        }
        let found = ctor(in names, in wd, n32(p.op(body)));
        if found == NO_CTOR {
            return;
        }
        let adt = wd.adt(n32(found / CTOR_SPLIT));
        let variant = wd.variant(found % CTOR_SPLIT);
        let mut vars = vars_new();
        if t.node(ty).kind == TyKind::Named {
            vars = wd.vars_of(in t, adt, ty);
        }
        let n = p.op(add(body, 2));
        let mut q = add(body, 3);
        for i in 0..n {
            let fi = wd.find_field(variant, n32(p.op(q)));
            if fi != NONE32 {
                let ft = substitute(inout t, wd.field(w(fi)).ty, in vars);
                box_slots(inout t, in names, in wd, in p, inc(q), ft, inout out);
            }
            q = pattern_end(in p, inc(q));
        }
    }
}

// A `Box::new` or caller-slot call of type `ty`: nothing, a key or an
// error.
fn need(
    inout t: Types,
    inout names: Names,
    in wd: World,
    in calls: Calls,
    inout ls: Layouts,
    inout keys: Keys,
    fi: u32,
    ty: u32,
    inout body: ChunkSeq[u64]
) {
    let inner = box_inner(in t, in wd, ty);
    if inner == NONE32 {
        body.push(F_NONE);
        return;
    }
    let (k, size) = slot_key(
        inout t,
        inout names,
        in wd,
        in calls,
        inout ls,
        inout keys,
        fi,
        inner
    );
    if k == NO_CTOR {
        body.push(F_NEED_ERR);
        body.push(keys.errors);
        keys.errors = inc(keys.errors);
    } else {
        body.push(F_NEED);
        body.push(k);
    }
}

fn value_type(in p: Program, f: FnRow, v: u64) -> u32 {
    // header: np x (name, pass, k, k paths, type, start, end), result,
    // effects, nb x (name, mode), nc names, nv x (value, type), ...
    let np = p.op(f.ha);
    let mut at = inc(f.ha);
    for i in 0..np {
        let k = p.op(add(at, 2));
        at = add(add(at, 3), add(k, 3));
    }
    at = add(at, 2);
    let nb = p.op(at);
    at = add(inc(at), wrapping_mul(nb, 2));
    let nc = p.op(at);
    at = add(inc(at), nc);
    let nv = p.op(at);
    at = inc(at);
    for i in 0..nv {
        if p.op(at) == v {
            return n32(p.op(inc(at)));
        }
        at = add(at, 2);
    }
    NONE32
}

// `Facts::words` of tests/common/ir_opt_words.rs for `p`.
fn fact_words(
    in p: Program,
    inout names: Names,
    inout t: Types,
    in wd: World,
    in calls: Calls
) -> ChunkSeq[u64] {
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    if !wd.box_active {
        out.push(0);
        return out;
    }
    let mut keys = Keys { kind: ChunkSeq::new[u64](), value: ChunkSeq::new[u64](), errors: 0 };
    let mut ls = layouts_new();
    let mut body: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for fi in 0..p.fn_count() {
        let f = p.function(fi);
        let ci = calls.function(f.name);
        if ci == NONE32 || !calls.fn_info(ci).fip {
            body.push(0);
            continue;
        }
        body.push(1);
        let inner = box_inner(in t, in wd, calls.fn_info(ci).result);
        let mut ret: u64 = 0;
        if inner != NONE32 {
            let (k, size) = slot_key(
                inout t,
                inout names,
                in wd,
                in calls,
                inout ls,
                inout keys,
                ci,
                inner
            );
            if k != NO_CTOR {
                ret = inc(k);
            }
        }
        body.push(ret);
        let mut n: u64 = 0;
        for bi in 0..f.bc {
            n = add(n, p.block(add(f.b0, bi)).ic);
        }
        body.push(n);
        for bi in 0..f.bc {
            let bk = p.block(add(f.b0, bi));
            for i in bk.i0..add(bk.i0, bk.ic) {
                let inst = p.inst(i);
                if inst.op == Op::Bind {
                    let ty = value_type(in p, f, p.op(inst.a));
                    if ty == NONE32 {
                        body.push(F_NONE);
                        continue;
                    }
                    let mut slots: ChunkSeq[u32] = ChunkSeq::new[u32]();
                    box_slots(inout t, in names, in wd, in p, inc(inst.a), ty, inout slots);
                    let mut rec: ChunkSeq[u64] = ChunkSeq::new[u64]();
                    let mut failed = false;
                    for s in 0..slots.len() {
                        if !failed {
                            let (k, size) = slot_key(
                                inout t,
                                inout names,
                                in wd,
                                in calls,
                                inout ls,
                                inout keys,
                                ci,
                                u32_at(in slots, s)
                            );
                            if k == NO_CTOR {
                                failed = true;
                            } else {
                                rec.push(k);
                                rec.push(size);
                            }
                        }
                    }
                    if failed {
                        body.push(F_BIND_ERR);
                        body.push(keys.errors);
                        keys.errors = inc(keys.errors);
                    } else {
                        body.push(F_BIND);
                        body.push(slots.len());
                        body.extend(in rec.as_slice());
                    }
                } else if inst.op == Op::Fip
                    && names.spells(p.pool_row(p.op(inst.a)).label, in "BoxNew".as_bytes())
                {
                    need(
                        inout t,
                        inout names,
                        in wd,
                        in calls,
                        inout ls,
                        inout keys,
                        ci,
                        inst.ty,
                        inout body
                    );
                } else if inst.op == Op::Call && calls.uses_caller_slot_name(n32(p.op(inst.a))) {
                    need(
                        inout t,
                        inout names,
                        in wd,
                        in calls,
                        inout ls,
                        inout keys,
                        ci,
                        inst.ty,
                        inout body
                    );
                } else {
                    body.push(F_NONE);
                }
            }
        }
    }
    out.push(1);
    out.push(keys.kind.len());
    out.extend(in body.as_slice());
    out
}

// The facts of `p`, before any pass rewrites it (they are read by input
// instruction row).
pub fn reuse_facts(
    in p: Program,
    inout names: Names,
    inout t: Types,
    in wd: World,
    in calls: Calls
) -> Facts {
    let words = fact_words(in p, inout names, inout t, in wd, in calls);
    let mut bytes: ChunkSeq[u8] = ChunkSeq::new[u8]();
    bytes.resize(wrapping_mul(words.len(), WORD_BYTES), 0);
    for i in 0..words.len() {
        let ok = bytes.try_write_u64_le(wrapping_mul(i, WORD_BYTES), u64_at(in words, i));
    }
    let mut r = Reader { pos: 0 };
    read_facts(inout r, in bytes.as_slice(), in p)
}

// `fip_reuse_pass` over `p` (instruction `k` came from input row
// `orig[k]`, whose facts are `facts`): the pass's status (0, or
// reuse.ves `S_FIP_ERROR`).
pub fn fip_reuse(
    inout p: Program,
    inout names: Names,
    in cls: ChunkSeq[u8],
    in facts: Facts,
    in orig: ChunkSeq[u64]
) -> u64 {
    let base = p.pool.len();
    let mut out = reuse_new();
    reuse_program(inout p, in names, in cls, in facts, in orig, inout out);
    if out.status != 0 {
        return widen_u64(out.status);
    }
    let np = out.payloads.len() / PAYLOAD_WORDS;
    for k in 0..np {
        let at = wrapping_mul(k, PAYLOAD_WORDS);
        let mut text: ChunkSeq[u8] = ChunkSeq::new[u8]();
        text.extend(in "BoxReuse { bind_dest: ".as_bytes());
        push_decimal(inout text, u64_at(in out.payloads, at));
        text.extend(in ", slot_index: ".as_bytes());
        push_decimal(inout text, u64_at(in out.payloads, inc(at)));
        text.extend(in ", size: ".as_bytes());
        push_decimal(inout text, u64_at(in out.payloads, add(at, 2)));
        text.extend(in " }".as_bytes());
        let label = names.intern(in text.as_slice());
        let ok = p.pool.try_set(add(base, k), PoolRow { kind: POOL_MAKE_FIP, label: label });
    }
    0
}
