// `fip::elaborate_non_fip_drops` (src/fip.rs): the `Box` drops of every
// function that is not `@fip`, on @vesper/place-ir's tables.
//
// Per function, `elaborate_function` follows each slot (a parameter or a
// pattern binding, by name) and each owned temporary (a value whose type
// holds a `Box`) through the graph: blocks in topological order when the
// graph is acyclic, else in reverse postorder to a fixed point
// (`DROP_FIXPOINT_LIMIT` passes). A block's entry state joins its
// predecessors' exit states; what one incoming edge still owns is that
// edge's to drop. The plan fills the function's trailer tables
// (`box_drops_before_inst`, `box_drops_after_inst`,
// `box_drops_before_term`); an edge drop goes before its source's `Jump`,
// or into a block split onto a branch or match edge (`split_edge`).
//
// A slot state is kept flat (`St`): slots sorted by name text (the Rust
// `BTreeMap<String, _>`), their moved paths in push order, and the owned
// temporaries sorted by value id. A block's exit state is stored as words
// (`put_state`), whose equality is the Rust state's equality.
//
// A lent closure's body borrows its captures (`World::lent_closures`),
// which the calls input does not carry: a closure body with a `sink`
// parameter that holds a `Box` is refused (`DropStatus::LentClosure`).

use @vesper/check-data::util::{add, inc, n32, u32_at, u64_at, u8_at, w};
use @vesper/check-data::names::{Names};
use @vesper/check-data::types::{TyKind, TyPass, Types, substitute, vars_new};
use @vesper/check-data::world::{World, constructor, field_step};
use @vesper/codegen-calls::data::{Calls};
use @vesper/place-ir::{BlockRow, FnRow, InstRow, Program};
use @vesper/place-ir::codes::{Op, Pat, Tag, Term};
use self::facts::{FactNames, pattern_end, scrutinees, type_contains_box};

const NONE32: u32 = 4294967295;
const NONE64: u64 = 18446744073709551615;

// Passes over a graph before its slot states are taken as unsolved.
const DROP_FIXPOINT_LIMIT: u64 = 64;

// What `elaborate_drops` answers.
pub enum DropStatus: _ {
    Ok = 0,
    // A closure body's `sink` parameter holds a `Box`: it may be a lent
    // capture, which the input does not say.
    LentClosure = 18,
}

// `FipDrop`'s kinds (the trailer's words).
pub enum DropKind: _ {
    Value = 0,
    Place = 1,
    OtherFields = 2,
}

// The prefix of a nested closure body's name (`ir::nested_name`).
const CLOSURE_PREFIX: Str = "$closure_";
// A path component that is a segment loan (`seq::is_segment`) starts so.
const SEGMENT_OPEN: u8 = 91;
// The separator of a `Write` place's components.
const PLACE_DOT: u8 = 46;
// `::`, between a constructor's qualifier and its name.
const COLON: u8 = 58;
const PATH_SEP_LEN: u64 = 2;
// `World::constructor`'s answer for no constructor.
const NO_CTOR: u64 = 18446744073709551615;
const CTOR_SPLIT: u64 = 4294967296;
// Words of a pattern before its kind's own words: kind, span start, end.
const PAT_HEAD: u64 = 3;
// Words of one call argument: pass, value, root, path.
const ARG_WORDS: u64 = 4;
// Words of a block header before its incoming tokens: entry, count.
const HEAD_INCOMING: u64 = 2;
// Words of one incoming token: block, token.
const INCOMING_WORDS: u64 = 2;
// Words of one call slot in the trailer.
const CALL_SLOT_WORDS: u64 = 5;
// Words of one join slot's incoming entry.
const JOIN_IN_WORDS: u64 = 3;
// Words of a join slot before its incoming entries: value, slot, count.
const JOIN_HEAD: u64 = 3;

// ----- small sequences -----------------------------------------------------------

fn at32(in s: ChunkSeq[u32], i: u64) -> u32 {
    u32_at(in s, i)
}

fn has32(in s: ChunkSeq[u32], x: u32) -> bool {
    for i in 0..s.len() {
        if u32_at(in s, i) == x {
            return true;
        }
    }
    false
}

fn has64(in s: ChunkSeq[u64], x: u64) -> bool {
    for i in 0..s.len() {
        if u64_at(in s, i) == x {
            return true;
        }
    }
    false
}

// Byte order of two names' text (the order of Rust `String`s).
fn name_less(in names: Names, a: u32, b: u32) -> bool {
    let na = names.size(a);
    let nb = names.size(b);
    let mut i: u64 = 0;
    loop {
        if i >= na || i >= nb {
            return na < nb;
        }
        let x = names.byte(a, i);
        let y = names.byte(b, i);
        if x != y {
            return x < y;
        }
        i = inc(i);
    }
    false
}

// The symbol of a decimal index (a tuple field's name).
fn decimal_sym(inout names: Names, i: u64) -> u32 {
    let mut digits: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut x = i;
    loop {
        digits.push(wrapping_u8(add(x % 10, 48)));
        x = x / 10;
        if x == 0 {
            break;
        }
    }
    let mut text: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let n = digits.len();
    for k in 0..n {
        text.push(u8_at(in digits, wrapping_sub(wrapping_sub(n, 1), k)));
    }
    names.intern(in text.as_slice())
}

// ----- paths -----------------------------------------------------------------------

// A path: `Cx.ar[a..a+n]`, component symbols.
pub copy struct PRef {
    a: u64,
    n: u64,
}

fn comp(in ar: ChunkSeq[u32], p: PRef, i: u64) -> u32 {
    u32_at(in ar, add(p.a, i))
}

fn path_eq(in ar: ChunkSeq[u32], x: PRef, y: PRef) -> bool {
    if x.n != y.n {
        return false;
    }
    for i in 0..x.n {
        if comp(in ar, x, i) != comp(in ar, y, i) {
            return false;
        }
    }
    true
}

// `path.starts_with(prefix)`.
fn starts_with(in ar: ChunkSeq[u32], path: PRef, prefix: PRef) -> bool {
    if prefix.n > path.n {
        return false;
    }
    for i in 0..prefix.n {
        if comp(in ar, path, i) != comp(in ar, prefix, i) {
            return false;
        }
    }
    true
}

fn pref_at(in s: ChunkSeq[PRef], i: u64) -> PRef {
    match s.try_get(i) {
        Option::Some(x) => x,
        Option::None => PRef { a: 0, n: 0 },
    }
}

// `path_is_covered`: some path of `set` is a prefix of `path`.
fn covered(in ar: ChunkSeq[u32], path: PRef, in set: ChunkSeq[PRef]) -> bool {
    for i in 0..set.len() {
        if starts_with(in ar, path, pref_at(in set, i)) {
            return true;
        }
    }
    false
}

fn contains_path(in ar: ChunkSeq[u32], in set: ChunkSeq[PRef], path: PRef) -> bool {
    for i in 0..set.len() {
        if path_eq(in ar, pref_at(in set, i), path) {
            return true;
        }
    }
    false
}

// A new path: `x` then `y`.
fn concat(inout ar: ChunkSeq[u32], x: PRef, y: PRef) -> PRef {
    let a = ar.len();
    for i in 0..x.n {
        let c = comp(in ar, x, i);
        ar.push(c);
    }
    for i in 0..y.n {
        let c = comp(in ar, y, i);
        ar.push(c);
    }
    PRef { a: a, n: add(x.n, y.n) }
}

fn stack_path(inout ar: ChunkSeq[u32], in stack: ChunkSeq[u32]) -> PRef {
    let a = ar.len();
    for i in 0..stack.len() {
        ar.push(u32_at(in stack, i));
    }
    PRef { a: a, n: stack.len() }
}

// A place-ir path id's components, as a path.
fn program_path(inout ar: ChunkSeq[u32], in p: Program, id: u64) -> PRef {
    let row = p.path(id);
    let a = ar.len();
    for k in 0..row.n {
        ar.push(p.path_name(id, k));
    }
    PRef { a: a, n: row.n }
}

// ----- the world's questions ----------------------------------------------------------

pub struct Dx {
    // type id -> 0 not asked, 1 no `Box`, 2 holds one
    boxed: ChunkSeq[u8],
    fx: FactNames,
    never: u32,
}

const ASKED_NO: u8 = 1;
const ASKED_YES: u8 = 2;

fn holds_box(inout t: Types, in wd: World, inout dx: Dx, ty: u32) -> bool {
    if ty == NONE32 {
        return false;
    }
    let known = u8_at(in dx.boxed, w(ty));
    if known != 0 {
        return known == ASKED_YES;
    }
    let yes = type_contains_box(inout t, in wd, ty);
    loop {
        if dx.boxed.len() > w(ty) {
            break;
        }
        dx.boxed.push(0);
    }
    let mut answer = ASKED_NO;
    if yes {
        answer = ASKED_YES;
    }
    let ok = dx.boxed.try_set(w(ty), answer);
    yes
}

fn is_box_type(in t: Types, in wd: World, ty: u32) -> bool {
    let n = t.node(ty);
    wd.box_active && n.kind == TyKind::Named && n.name == wd.k.box_ && w(n.n) == 1
}

// `fip::box_inner`, or NONE32.
fn box_inner(in t: Types, in wd: World, ty: u32) -> u32 {
    if is_box_type(in t, in wd, ty) {
        t.arg(ty, 0)
    } else {
        NONE32
    }
}

fn is_never(in t: Types, in dx: Dx, ty: u32) -> bool {
    let n = t.node(ty);
    n.kind == TyKind::Named && n.name == dx.never
}

// `World::field(ty, path)`, or NONE32.
fn resolve(
    inout t: Types,
    inout names: Names,
    in wd: World,
    in ar: ChunkSeq[u32],
    ty: u32,
    path: PRef
) -> u32 {
    let mut at = ty;
    for i in 0..path.n {
        if at == NONE32 {
            return NONE32;
        }
        let c = comp(in ar, path, i);
        let segment = names.size(c) != 0 && names.byte(c, 0) == SEGMENT_OPEN;
        at = field_step(inout t, inout names, in wd, at, c, segment);
    }
    at
}

// The symbol spelled by bytes [lo, hi) of `name`, or NONE32.
fn sub_sym(in names: Names, name: u32, lo: u64, hi: u64) -> u32 {
    let mut text: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for i in lo..hi {
        text.push(names.byte(name, i));
    }
    names.lookup(in text.as_slice())
}

fn find_colons(in names: Names, name: u32, from: u64) -> u64 {
    let n = names.size(name);
    let mut i = from;
    loop {
        if inc(i) >= n {
            return n;
        }
        if names.byte(name, i) == COLON && names.byte(name, inc(i)) == COLON {
            return i;
        }
        i = inc(i);
    }
    n
}

// `World::constructor(name)`, packed as world.ves `constructor` returns it.
fn ctor(in names: Names, in wd: World, name: u32) -> u64 {
    let n = names.size(name);
    let first = find_colons(in names, name, 0);
    if first >= n {
        return constructor(in wd, NONE32, name);
    }
    if find_colons(in names, name, add(first, PATH_SEP_LEN)) < n {
        return NO_CTOR;
    }
    let qual = sub_sym(in names, name, 0, first);
    let short = sub_sym(in names, name, add(first, PATH_SEP_LEN), n);
    if qual == NONE32 || short == NONE32 {
        return NO_CTOR;
    }
    constructor(in wd, qual, short)
}

// `fip::is_box_pattern` of the constructor pattern at `at`.
fn is_box_pattern(in p: Program, in names: Names, in wd: World, at: u64) -> bool {
    if !wd.box_active || p.op(at) != Pat::Constructor {
        return false;
    }
    let body = add(at, PAT_HEAD);
    let name = n32(p.op(body));
    let boxed = names.spells(name, in "Box".as_bytes())
        || names.spells(name, in "Box::Box".as_bytes());
    boxed && p.op(add(body, 2)) == 1 && names.spells(n32(p.op(add(body, 3))), in "0".as_bytes())
}

// ----- slot states ------------------------------------------------------------------

// A function's slots and owned temporaries at one point.
pub struct St {
    // slots, sorted by name text
    sn: ChunkSeq[u32],
    st: ChunkSeq[u32],
    sp: ChunkSeq[u8],
    // the parameter whose projections the slot owns, + 1, or 0
    sj: ChunkSeq[u32],
    // moved paths, in push order, by slot name
    mo: ChunkSeq[u32],
    mv: ChunkSeq[PRef],
    // owned temporaries, sorted by value id
    vi: ChunkSeq[u32],
    vt: ChunkSeq[u32],
}

fn st_new() -> St {
    St {
        sn: ChunkSeq::new[u32](),
        st: ChunkSeq::new[u32](),
        sp: ChunkSeq::new[u8](),
        sj: ChunkSeq::new[u32](),
        mo: ChunkSeq::new[u32](),
        mv: ChunkSeq::new[PRef](),
        vi: ChunkSeq::new[u32](),
        vt: ChunkSeq::new[u32](),
    }
}

fn slot_of(in s: St, name: u32) -> u64 {
    for i in 0..s.sn.len() {
        if u32_at(in s.sn, i) == name {
            return i;
        }
    }
    NONE64
}

// The moved paths of slot `name`, in order.
fn moved_of(in s: St, name: u32) -> ChunkSeq[PRef] {
    let mut out: ChunkSeq[PRef] = ChunkSeq::new[PRef]();
    for i in 0..s.mo.len() {
        if u32_at(in s.mo, i) == name {
            out.push(pref_at(in s.mv, i));
        }
    }
    out
}

fn drop_moved(inout s: St, name: u32) {
    let mut mo: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut mv: ChunkSeq[PRef] = ChunkSeq::new[PRef]();
    for i in 0..s.mo.len() {
        if u32_at(in s.mo, i) != name {
            mo.push(u32_at(in s.mo, i));
            mv.push(pref_at(in s.mv, i));
        }
    }
    s.mo = mo;
    s.mv = mv;
}

// `slots.insert(name, state)` with no moved paths.
fn put_slot(inout s: St, in names: Names, name: u32, ty: u32, pass: u8, proj: u32) {
    let at = slot_of(in s, name);
    if at != NONE64 {
        let a = s.st.try_set(at, ty);
        let b = s.sp.try_set(at, pass);
        let c = s.sj.try_set(at, proj);
        drop_moved(inout s, name);
        return;
    }
    let n = s.sn.len();
    let mut pos = n;
    for i in 0..n {
        if pos == n && name_less(in names, name, u32_at(in s.sn, i)) {
            pos = i;
        }
    }
    s.sn.push(name);
    s.st.push(ty);
    s.sp.push(pass);
    s.sj.push(proj);
    let mut k = n;
    loop {
        if k <= pos {
            break;
        }
        let j = wrapping_sub(k, 1);
        let a = s.sn.try_set(k, u32_at(in s.sn, j));
        let b = s.st.try_set(k, u32_at(in s.st, j));
        let c = s.sp.try_set(k, u8_at(in s.sp, j));
        let d = s.sj.try_set(k, u32_at(in s.sj, j));
        k = j;
    }
    let a = s.sn.try_set(pos, name);
    let b = s.st.try_set(pos, ty);
    let c = s.sp.try_set(pos, pass);
    let d = s.sj.try_set(pos, proj);
}

// `slot.moved.push(path)` unless it is there.
fn mark_moved(inout s: St, in ar: ChunkSeq[u32], name: u32, path: PRef) {
    for i in 0..s.mo.len() {
        if u32_at(in s.mo, i) == name && path_eq(in ar, pref_at(in s.mv, i), path) {
            return;
        }
    }
    s.mo.push(name);
    s.mv.push(path);
}

fn value_at(in s: St, id: u32) -> u64 {
    for i in 0..s.vi.len() {
        if u32_at(in s.vi, i) == id {
            return i;
        }
    }
    NONE64
}

fn own(inout s: St, id: u32, ty: u32) {
    let at = value_at(in s, id);
    if at != NONE64 {
        let ok = s.vt.try_set(at, ty);
        return;
    }
    let n = s.vi.len();
    let mut pos = n;
    for i in 0..n {
        if pos == n && id < u32_at(in s.vi, i) {
            pos = i;
        }
    }
    s.vi.push(id);
    s.vt.push(ty);
    let mut k = n;
    loop {
        if k <= pos {
            break;
        }
        let j = wrapping_sub(k, 1);
        let a = s.vi.try_set(k, u32_at(in s.vi, j));
        let b = s.vt.try_set(k, u32_at(in s.vt, j));
        k = j;
    }
    let a = s.vi.try_set(pos, id);
    let b = s.vt.try_set(pos, ty);
}

// `owned_values.remove(id)`: its type, or NONE32 when it was not owned.
fn disown(inout s: St, id: u32) -> u32 {
    let at = value_at(in s, id);
    if at == NONE64 {
        return NONE32;
    }
    let ty = u32_at(in s.vt, at);
    let mut vi: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut vt: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..s.vi.len() {
        if i != at {
            vi.push(u32_at(in s.vi, i));
            vt.push(u32_at(in s.vt, i));
        }
    }
    s.vi = vi;
    s.vt = vt;
    ty
}

// The state as words: ns, ns x (name, ty, pass, proj, nm, nm x (len,
// components)), nv, nv x (value, ty).
fn put_state(in s: St, in ar: ChunkSeq[u32], inout o: ChunkSeq[u64]) {
    o.push(s.sn.len());
    for i in 0..s.sn.len() {
        let name = u32_at(in s.sn, i);
        o.push(w(name));
        o.push(w(u32_at(in s.st, i)));
        o.push(widen_u64(u8_at(in s.sp, i)));
        o.push(w(u32_at(in s.sj, i)));
        let moved = moved_of(in s, name);
        o.push(moved.len());
        for k in 0..moved.len() {
            let m = pref_at(in moved, k);
            o.push(m.n);
            for j in 0..m.n {
                o.push(w(comp(in ar, m, j)));
            }
        }
    }
    o.push(s.vi.len());
    for i in 0..s.vi.len() {
        o.push(w(u32_at(in s.vi, i)));
        o.push(w(u32_at(in s.vt, i)));
    }
}

// The state stored at words `ex[at..]`.
fn load_state(in ex: ChunkSeq[u64], at0: u64, inout ar: ChunkSeq[u32]) -> St {
    let mut s = st_new();
    let mut at = at0;
    let ns = u64_at(in ex, at);
    at = inc(at);
    for i in 0..ns {
        let name = n32(u64_at(in ex, at));
        s.sn.push(name);
        s.st.push(n32(u64_at(in ex, inc(at))));
        s.sp.push(wrapping_u8(u64_at(in ex, add(at, 2))));
        s.sj.push(n32(u64_at(in ex, add(at, 3))));
        let nm = u64_at(in ex, add(at, 4));
        at = add(at, 5);
        for k in 0..nm {
            let len = u64_at(in ex, at);
            at = inc(at);
            let a = ar.len();
            for j in 0..len {
                ar.push(n32(u64_at(in ex, add(at, j))));
            }
            at = add(at, len);
            s.mo.push(name);
            s.mv.push(PRef { a: a, n: len });
        }
    }
    let nv = u64_at(in ex, at);
    at = inc(at);
    for i in 0..nv {
        s.vi.push(n32(u64_at(in ex, at)));
        s.vt.push(n32(u64_at(in ex, inc(at))));
        at = add(at, 2);
    }
    s
}

// ----- the plan -----------------------------------------------------------------------

// The plan's tables.
pub enum Table: _ {
    BeforeInst = 0,
    AfterInst = 1,
    BeforeTerm = 2,
    Edge = 3,
}

// Drop records, in push order: the table, its key (block, or for an
// edge the source block), the instruction or the edge's target, and the
// drop.
pub struct Plan {
    table: ChunkSeq[u8],
    blk: ChunkSeq[u64],
    at: ChunkSeq[u64],
    kind: ChunkSeq[u8],
    val: ChunkSeq[u64],
    path: ChunkSeq[PRef],
    ty: ChunkSeq[u32],
    keep: ChunkSeq[u32],
    // per block: 1 when `before_inst` / `before_term` has its entry
    bi: ChunkSeq[u8],
    bt: ChunkSeq[u8],
}

fn plan_new() -> Plan {
    Plan {
        table: ChunkSeq::new[u8](),
        blk: ChunkSeq::new[u64](),
        at: ChunkSeq::new[u64](),
        kind: ChunkSeq::new[u8](),
        val: ChunkSeq::new[u64](),
        path: ChunkSeq::new[PRef](),
        ty: ChunkSeq::new[u32](),
        keep: ChunkSeq::new[u32](),
        bi: ChunkSeq::new[u8](),
        bt: ChunkSeq::new[u8](),
    }
}

fn set_entry(inout flags: ChunkSeq[u8], b: u64) {
    loop {
        if flags.len() > b {
            break;
        }
        flags.push(0);
    }
    let ok = flags.try_set(b, 1);
}

fn record(
    inout plan: Plan,
    table: u8,
    blk: u64,
    at: u64,
    kind: u8,
    val: u64,
    path: PRef,
    ty: u32,
    keep: u32
) {
    plan.table.push(table);
    plan.blk.push(blk);
    plan.at.push(at);
    plan.kind.push(kind);
    plan.val.push(val);
    plan.path.push(path);
    plan.ty.push(ty);
    plan.keep.push(keep);
    if table == Table::BeforeInst {
        set_entry(inout plan.bi, blk);
    } else if table == Table::BeforeTerm {
        set_entry(inout plan.bt, blk);
    }
}

fn no_path() -> PRef {
    PRef { a: 0, n: 0 }
}

fn drop_value(inout plan: Plan, table: u8, blk: u64, at: u64, v: u32, ty: u32) {
    record(inout plan, table, blk, at, DropKind::Value, w(v), no_path(), ty, 0);
}

fn drop_place(inout plan: Plan, table: u8, blk: u64, at: u64, root: u32, path: PRef, ty: u32) {
    record(inout plan, table, blk, at, DropKind::Place, w(root), path, ty, 0);
}

// ----- one function ---------------------------------------------------------------------

// A function's facts the elaboration reads.
pub struct Cx {
    fi: u64,
    f: FnRow,
    // path components
    ar: ChunkSeq[u32],
    // value id -> type, or NONE32
    vty: ChunkSeq[u32],
    // parameters: name, pass, type, projections pj[pa..pa+pn]
    pn_: ChunkSeq[u32],
    pp: ChunkSeq[u8],
    pt: ChunkSeq[u32],
    pa: ChunkSeq[u64],
    pc: ChunkSeq[u64],
    pj: ChunkSeq[PRef],
    ext: ChunkSeq[u32],
    // the graph: succ[sa[b]..sa[b]+sc[b]], pred likewise
    succ: ChunkSeq[u64],
    sa: ChunkSeq[u64],
    sc: ChunkSeq[u64],
    pred: ChunkSeq[u64],
    pra: ChunkSeq[u64],
    prc: ChunkSeq[u64],
    // live `Box` inputs: box value index per value (or NONE64), then a
    // bit per (block, box value)
    bix: ChunkSeq[u64],
    nbox: u64,
    live: ChunkSeq[u8],
    // borrowed match scrutinees, per value id
    borrowed: ChunkSeq[u8],
}

fn header_words(in p: Program, f: FnRow, inout cx: Cx) {
    let np = p.op(f.ha);
    let mut at = inc(f.ha);
    for i in 0..np {
        cx.pn_.push(n32(p.op(at)));
        cx.pp.push(wrapping_u8(p.op(inc(at))));
        let k = p.op(add(at, 2));
        cx.pa.push(cx.pj.len());
        cx.pc.push(k);
        for j in 0..k {
            let r = program_path(inout cx.ar, in p, p.op(add(add(at, 3), j)));
            cx.pj.push(r);
        }
        cx.pt.push(n32(p.op(add(add(at, 3), k))));
        at = add(add(at, 3), add(k, 3));
    }
    // result, effects
    at = add(at, 2);
    let nb = p.op(at);
    at = add(inc(at), wrapping_mul(nb, 2));
    let nc = p.op(at);
    at = inc(at);
    for i in 0..nc {
        cx.ext.push(n32(p.op(at)));
        at = inc(at);
    }
    let nv = p.op(at);
    at = inc(at);
    for i in 0..nv {
        let v = p.op(at);
        let ty = n32(p.op(inc(at)));
        loop {
            if cx.vty.len() > v {
                break;
            }
            cx.vty.push(NONE32);
        }
        let ok = cx.vty.try_set(v, ty);
        at = add(at, 2);
    }
}

fn value_type(in cx: Cx, v: u64) -> u32 {
    match cx.vty.try_get(v) {
        Option::Some(t) => t,
        Option::None => NONE32,
    }
}

// The successors of block `bk` in terminator order (with repeats).
fn targets(in p: Program, bk: BlockRow) -> ChunkSeq[u64] {
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    if bk.term == Term::Jump {
        out.push(p.op(bk.ta));
    } else if bk.term == Term::Branch {
        out.push(p.op(inc(bk.ta)));
        out.push(p.op(add(bk.ta, 2)));
    } else if bk.term == Term::Match {
        let n = p.op(inc(bk.ta));
        let mut at = add(bk.ta, 2);
        for i in 0..n {
            at = pattern_end(in p, at);
            out.push(p.op(at));
            at = inc(at);
        }
    }
    out
}

fn graph(in p: Program, inout cx: Cx) {
    let nb = cx.f.bc;
    let mut lists: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut ls: ChunkSeq[u64] = ChunkSeq::new[u64]();
    // per block: its distinct successors, in order
    for b in 0..nb {
        let ts = targets(in p, p.block(add(cx.f.b0, b)));
        cx.sa.push(cx.succ.len());
        let start = cx.succ.len();
        for i in 0..ts.len() {
            let t = u64_at(in ts, i);
            let mut seen = false;
            for k in start..cx.succ.len() {
                if u64_at(in cx.succ, k) == t {
                    seen = true;
                }
            }
            if !seen {
                cx.succ.push(t);
            }
        }
        cx.sc.push(wrapping_sub(cx.succ.len(), start));
    }
    // predecessors: for each target in source order
    for b in 0..nb {
        cx.pra.push(cx.pred.len());
        let start = cx.pred.len();
        for s in 0..nb {
            let a = u64_at(in cx.sa, s);
            for k in a..add(a, u64_at(in cx.sc, s)) {
                if u64_at(in cx.succ, k) == b {
                    cx.pred.push(s);
                }
            }
        }
        cx.prc.push(wrapping_sub(cx.pred.len(), start));
    }
}

fn succ_of(in cx: Cx, b: u64, k: u64) -> u64 {
    u64_at(in cx.succ, add(u64_at(in cx.sa, b), k))
}

fn succ_count(in cx: Cx, b: u64) -> u64 {
    u64_at(in cx.sc, b)
}

fn pred_of(in cx: Cx, b: u64, k: u64) -> u64 {
    u64_at(in cx.pred, add(u64_at(in cx.pra, b), k))
}

fn pred_count(in cx: Cx, b: u64) -> u64 {
    u64_at(in cx.prc, b)
}

// The values instruction `inst` reads (`ir_inline::operands`), in order.
fn operands(in p: Program, inst: InstRow) -> ChunkSeq[u64] {
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let a = inst.a;
    let op = inst.op;
    if op == Op::Handle {
        if p.op(a) != 0 {
            out.push(p.op(inc(a)));
        }
    } else if op == Op::Bind
        || op == Op::Exit
        || op == Op::Unary
        || op == Op::Project
        || op == Op::Try
    {
        let mut at = a;
        if op == Op::Unary {
            at = inc(a);
        }
        out.push(p.op(at));
    } else if op == Op::Write {
        out.push(p.op(add(a, 2)));
    } else if op == Op::Binary {
        out.push(p.op(inc(a)));
        out.push(p.op(add(a, 2)));
    } else if op == Op::Index {
        out.push(p.op(a));
        out.push(p.op(inc(a)));
    } else if op == Op::Tuple || op == Op::Vector {
        let mut at = a;
        if op == Op::Vector {
            at = inc(a);
        }
        let n = p.op(at);
        for i in 0..n {
            out.push(p.op(add(inc(at), i)));
        }
    } else if op == Op::Data {
        let n = p.op(inc(a));
        for i in 0..n {
            out.push(p.op(add(add(a, 3), wrapping_mul(i, 2))));
        }
    } else if op == Op::Call
        || op == Op::Tiled
        || op == Op::Seq
        || op == Op::Fip
        || op == Op::Indirect
    {
        let n = p.op(inc(a));
        for i in 0..n {
            out.push(p.op(add(add(a, 2), add(wrapping_mul(i, ARG_WORDS), 1))));
        }
        if op == Op::Indirect {
            out.push(p.op(a));
        }
    }
    out
}

// The values the terminator of `bk` reads.
fn term_operands(in p: Program, bk: BlockRow) -> ChunkSeq[u64] {
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    if bk.term == Term::Return || bk.term == Term::Branch || bk.term == Term::Match {
        out.push(p.op(bk.ta));
    } else if bk.term == Term::Jump {
        let n = p.op(inc(bk.ta));
        for i in 0..n {
            out.push(p.op(add(add(bk.ta, 2), i)));
        }
    }
    out
}

// The arguments of a call-like instruction passed `sink`.
fn sink_args(in p: Program, inst: InstRow) -> ChunkSeq[u64] {
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let n = p.op(inc(inst.a));
    for i in 0..n {
        let at = add(add(inst.a, 2), wrapping_mul(i, ARG_WORDS));
        if p.op(at) == widen_u64(TyPass::Sink) {
            out.push(p.op(inc(at)));
        }
    }
    out
}

fn box_index(in cx: Cx, v: u64) -> u64 {
    match cx.bix.try_get(v) {
        Option::Some(x) => x,
        Option::None => NONE64,
    }
}

fn live_in(in cx: Cx, b: u64, v: u64) -> bool {
    let k = box_index(in cx, v);
    if k == NONE64 {
        return false;
    }
    u8_at(in cx.live, add(wrapping_mul(b, cx.nbox), k)) != 0
}

fn live_out(in cx: Cx, b: u64, v: u64) -> bool {
    for k in 0..succ_count(in cx, b) {
        if live_in(in cx, succ_of(in cx, b, k), v) {
            return true;
        }
    }
    false
}

// `live_box_inputs`: the `Box` values defined in another block that each
// block needs on arrival.
fn live_inputs(inout t: Types, in wd: World, inout dx: Dx, in p: Program, inout cx: Cx) {
    let nb = cx.f.bc;
    // definitions: value -> block + 1
    let mut def: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for b in 0..nb {
        let bk = p.block(add(cx.f.b0, b));
        let ni = p.op(inc(bk.ha));
        let at = add(add(bk.ha, HEAD_INCOMING), wrapping_mul(ni, INCOMING_WORDS));
        let np = p.op(inc(at));
        for k in 0..np {
            let v = p.op(add(add(at, 2), k));
            grow(inout def, v);
            let ok = def.try_set(v, inc(b));
        }
        for i in bk.i0..add(bk.i0, bk.ic) {
            let v = w(p.inst(i).dest);
            grow(inout def, v);
            let ok = def.try_set(v, inc(b));
        }
    }
    for v in 0..cx.vty.len() {
        let ty = value_type(in cx, v);
        if holds_box(inout t, in wd, inout dx, ty) {
            grow(inout cx.bix, v);
            let ok = cx.bix.try_set(v, cx.nbox);
            cx.nbox = inc(cx.nbox);
        } else {
            grow(inout cx.bix, v);
            let ok = cx.bix.try_set(v, NONE64);
        }
    }
    cx.live.resize(wrapping_mul(nb, cx.nbox), 0);
    if cx.nbox == 0 {
        return;
    }
    for b in 0..nb {
        let bk = p.block(add(cx.f.b0, b));
        let mut ops: ChunkSeq[u64] = ChunkSeq::new[u64]();
        for i in bk.i0..add(bk.i0, bk.ic) {
            let vs = operands(in p, p.inst(i));
            ops.extend(in vs.as_slice());
        }
        let tv = term_operands(in p, bk);
        ops.extend(in tv.as_slice());
        for i in 0..ops.len() {
            let v = u64_at(in ops, i);
            let d = u64_at(in def, v);
            if d == 0 {
                continue;
            }
            let definition = wrapping_sub(d, 1);
            let k = box_index(in cx, v);
            if definition == b || k == NONE64 || live_in(in cx, b, v) {
                continue;
            }
            let mut pending: ChunkSeq[u64] = ChunkSeq::new[u64]();
            pending.push(b);
            loop {
                let at = match pending.pop() {
                    Option::Some(x) => x,
                    Option::None => break,
                };
                let bit = add(wrapping_mul(at, cx.nbox), k);
                if at != definition && u8_at(in cx.live, bit) == 0 {
                    let ok = cx.live.try_set(bit, 1);
                    for j in 0..pred_count(in cx, at) {
                        pending.push(pred_of(in cx, at, j));
                    }
                }
            }
        }
    }
}

fn grow(inout s: ChunkSeq[u64], i: u64) {
    loop {
        if s.len() > i {
            break;
        }
        s.push(0);
    }
}

// `remaining_box_paths(ty, moved)`, each prefixed by `base`.
fn remaining(
    inout t: Types,
    inout names: Names,
    in wd: World,
    inout dx: Dx,
    inout ar: ChunkSeq[u32],
    ty: u32,
    in moved: ChunkSeq[PRef],
    inout stack: ChunkSeq[u32],
    inout out: ChunkSeq[PRef]
) {
    let here = stack_path(inout ar, in stack);
    if covered(in ar, here, in moved) {
        return;
    }
    if !holds_box(inout t, in wd, inout dx, ty) {
        return;
    }
    if is_box_type(in t, in wd, ty) {
        out.push(here);
        return;
    }
    let n = t.node(ty);
    if n.kind == TyKind::Tuple {
        for i in 0..w(n.n) {
            let sym = decimal_sym(inout names, i);
            let a = t.arg(ty, i);
            stack.push(sym);
            remaining(
                inout t,
                inout names,
                in wd,
                inout dx,
                inout ar,
                a,
                in moved,
                inout stack,
                inout out
            );
            let last = stack.pop();
        }
    } else if n.kind == TyKind::Named {
        let ai = wd.lookup(n.name);
        let mut walked = false;
        if ai != NONE32 {
            let adt = wd.adt(ai);
            if !adt.is_enum && adt.vn == 1 {
                walked = true;
                let vars = wd.vars_of(in t, adt, ty);
                let v = wd.variant(w(adt.va));
                for fi in 0..w(v.fc) {
                    let f = wd.field(add(w(v.fa), fi));
                    let ft = substitute(inout t, f.ty, in vars);
                    stack.push(f.name);
                    remaining(
                        inout t,
                        inout names,
                        in wd,
                        inout dx,
                        inout ar,
                        ft,
                        in moved,
                        inout stack,
                        inout out
                    );
                    let last = stack.pop();
                }
            }
        }
        if !walked {
            out.push(here);
        }
    }
}

fn remaining_paths(
    inout t: Types,
    inout names: Names,
    in wd: World,
    inout dx: Dx,
    inout ar: ChunkSeq[u32],
    ty: u32,
    in moved: ChunkSeq[PRef]
) -> ChunkSeq[PRef] {
    let mut out: ChunkSeq[PRef] = ChunkSeq::new[PRef]();
    let mut stack: ChunkSeq[u32] = ChunkSeq::new[u32]();
    remaining(
        inout t,
        inout names,
        in wd,
        inout dx,
        inout ar,
        ty,
        in moved,
        inout stack,
        inout out
    );
    out
}

// `DropSlotState::owns_path` of slot `i`.
fn owns_path(in cx: Cx, in s: St, i: u64, path: PRef) -> bool {
    let j = u32_at(in s.sj, i);
    if j == 0 {
        return true;
    }
    let pi = wrapping_sub(w(j), 1);
    let a = u64_at(in cx.pa, pi);
    let c = u64_at(in cx.pc, pi);
    if c == 0 {
        return true;
    }
    for k in a..add(a, c) {
        if starts_with(in cx.ar, path, pref_at(in cx.pj, k)) {
            return true;
        }
    }
    false
}

// Whether slot `i` of `s` is one whose boxes the graph drops: `sink`,
// not an external capture, holding a `Box`.
fn droppable(inout t: Types, in wd: World, inout dx: Dx, in cx: Cx, in s: St, i: u64) -> bool {
    u8_at(in s.sp, i) == TyPass::Sink
        && !has32(in cx.ext, u32_at(in s.sn, i))
        && holds_box(inout t, in wd, inout dx, u32_at(in s.st, i))
}

// `owned_slot_drops`: recorded in `table` at (blk, at).
fn owned_slot_drops(
    inout t: Types,
    inout names: Names,
    in wd: World,
    inout dx: Dx,
    inout cx: Cx,
    in s: St,
    inout plan: Plan,
    table: u8,
    blk: u64,
    at: u64
) {
    for i in 0..s.sn.len() {
        if !droppable(inout t, in wd, inout dx, in cx, in s, i) {
            continue;
        }
        let name = u32_at(in s.sn, i);
        let ty = u32_at(in s.st, i);
        let moved = moved_of(in s, name);
        let rem = remaining_paths(inout t, inout names, in wd, inout dx, inout cx.ar, ty, in moved);
        for k in 0..rem.len() {
            let path = pref_at(in rem, k);
            if !owns_path(in cx, in s, i, path) {
                continue;
            }
            let drop_ty = resolve(inout t, inout names, in wd, in cx.ar, ty, path);
            if drop_ty != NONE32 && holds_box(inout t, in wd, inout dx, drop_ty) {
                drop_place(inout plan, table, blk, at, name, path, drop_ty);
            }
        }
    }
}

// `bind_drop_slots` of the pattern at `at` against `ty`.
fn bind_slots(
    inout t: Types,
    in names: Names,
    in wd: World,
    in p: Program,
    at: u64,
    ty: u32,
    inout s: St,
    pass: u8
) {
    let kind = p.op(at);
    let body = add(at, PAT_HEAD);
    if kind == Pat::Bind {
        put_slot(inout s, in names, n32(p.op(body)), ty, pass, 0);
    } else if kind == Pat::Tuple {
        let tn = t.node(ty);
        if tn.kind != TyKind::Tuple {
            return;
        }
        let n = p.op(body);
        let mut q = inc(body);
        for i in 0..n {
            if i < w(tn.n) {
                let a = t.arg(ty, i);
                bind_slots(inout t, in names, in wd, in p, q, a, inout s, pass);
            }
            q = pattern_end(in p, q);
        }
    } else if kind == Pat::Constructor {
        if is_box_pattern(in p, in names, in wd, at) {
            let inner = box_inner(in t, in wd, ty);
            bind_slots(inout t, in names, in wd, in p, add(body, 4), inner, inout s, pass);
            return;
        }
        let found = ctor(in names, in wd, n32(p.op(body)));
        if found == NO_CTOR {
            return;
        }
        let adt = wd.adt(n32(found / CTOR_SPLIT));
        let variant = wd.variant(found % CTOR_SPLIT);
        let mut vars = vars_new();
        if t.node(ty).kind == TyKind::Named {
            vars = wd.vars_of(in t, adt, ty);
        }
        let n = p.op(add(body, 2));
        let mut q = add(body, 3);
        for i in 0..n {
            let fname = n32(p.op(q));
            let fi = wd.find_field(variant, fname);
            if fi != NONE32 {
                let ft = substitute(inout t, wd.field(w(fi)).ty, in vars);
                bind_slots(inout t, in names, in wd, in p, inc(q), ft, inout s, pass);
            }
            q = pattern_end(in p, inc(q));
        }
    }
}

// `entry_slots`: the slots entering block `b` from `active` (exit states
// at `ex[xa[p]..]`), recording each incoming edge's drops.
fn entry_slots(
    inout t: Types,
    inout names: Names,
    in wd: World,
    inout dx: Dx,
    inout cx: Cx,
    b: u64,
    in active: ChunkSeq[u64],
    in ex: ChunkSeq[u64],
    in xa: ChunkSeq[u64],
    inout plan: Plan
) -> St {
    let mut s = st_new();
    if b == 0 && active.len() == 0 {
        for i in 0..cx.pn_.len() {
            let name = at32(in cx.pn_, i);
            put_slot(inout s, in names, name, at32(in cx.pt, i), u8_at(in cx.pp, i), n32(inc(i)));
        }
        return s;
    }
    if active.len() == 0 {
        return s;
    }
    let first = load_state(in ex, u64_at(in xa, u64_at(in active, 0)), inout cx.ar);
    if active.len() == 1 {
        let mut one = st_new();
        copy_slots(in first, inout one);
        return one;
    }
    for i in 0..first.sn.len() {
        let name = u32_at(in first.sn, i);
        let mut all = true;
        for k in 1..active.len() {
            let other = load_state(in ex, u64_at(in xa, u64_at(in active, k)), inout cx.ar);
            if slot_of(in other, name) == NONE64 {
                all = false;
            }
        }
        if !all {
            continue;
        }
        let mut union: ChunkSeq[PRef] = ChunkSeq::new[PRef]();
        for k in 0..active.len() {
            let other = load_state(in ex, u64_at(in xa, u64_at(in active, k)), inout cx.ar);
            let moved = moved_of(in other, name);
            for j in 0..moved.len() {
                let m = pref_at(in moved, j);
                if !contains_path(in cx.ar, in union, m) {
                    union.push(m);
                }
            }
        }
        put_slot(
            inout s,
            in names,
            name,
            u32_at(in first.st, i),
            u8_at(in first.sp, i),
            u32_at(in first.sj, i)
        );
        for j in 0..union.len() {
            s.mo.push(name);
            s.mv.push(pref_at(in union, j));
        }
    }
    for k in 0..active.len() {
        let pb = u64_at(in active, k);
        let ps = load_state(in ex, u64_at(in xa, pb), inout cx.ar);
        for i in 0..ps.sn.len() {
            if !droppable(inout t, in wd, inout dx, in cx, in ps, i) {
                continue;
            }
            let name = u32_at(in ps.sn, i);
            let ty = u32_at(in ps.st, i);
            let pm = moved_of(in ps, name);
            let rem = remaining_paths(
                inout t,
                inout names,
                in wd,
                inout dx,
                inout cx.ar,
                ty,
                in pm
            );
            let joined = slot_of(in s, name) != NONE64;
            let jm = moved_of(in s, name);
            for r in 0..rem.len() {
                let path = pref_at(in rem, r);
                if !owns_path(in cx, in ps, i, path) {
                    continue;
                }
                if joined && !covered(in cx.ar, path, in jm) {
                    continue;
                }
                let drop_ty = resolve(inout t, inout names, in wd, in cx.ar, ty, path);
                if drop_ty != NONE32 && holds_box(inout t, in wd, inout dx, drop_ty) {
                    drop_place(inout plan, Table::Edge, pb, b, name, path, drop_ty);
                }
            }
        }
    }
    s
}

fn copy_slots(in from: St, inout to: St) {
    to.sn.extend(in from.sn.as_slice());
    to.st.extend(in from.st.as_slice());
    to.sp.extend(in from.sp.as_slice());
    to.sj.extend(in from.sj.as_slice());
    to.mo.extend(in from.mo.as_slice());
    to.mv.extend(in from.mv.as_slice());
}

// Whether value `v` is read after instruction `k` of `bk`
// (`value_used_after_in_block`).
fn used_after(in p: Program, bk: BlockRow, k: u64, v: u64) -> bool {
    for i in add(bk.i0, inc(k))..add(bk.i0, bk.ic) {
        let vs = operands(in p, p.inst(i));
        if has64(in vs, v) {
            return true;
        }
    }
    let tv = term_operands(in p, bk);
    has64(in tv, v)
}

fn seq_get(in p: Program, in names: Names, inst: InstRow) -> bool {
    if inst.op != Op::Seq {
        return false;
    }
    let label = p.pool_row(p.op(inst.a)).label;
    names.spells(label, in "Get".as_bytes()) || names.spells(label, in "SliceGet".as_bytes())
}

// A `Write` place's components after its root, as a path; its root.
fn place_parts(inout names: Names, inout ar: ChunkSeq[u32], place: u32) -> (u32, PRef) {
    let n = names.size(place);
    let mut cuts: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for i in 0..n {
        if names.byte(place, i) == PLACE_DOT {
            cuts.push(i);
        }
    }
    cuts.push(n);
    let mut text: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut lo: u64 = 0;
    let mut root: u32 = 0;
    let a = ar.len();
    for k in 0..cuts.len() {
        let hi = u64_at(in cuts, k);
        text.clear();
        for i in lo..hi {
            text.push(names.byte(place, i));
        }
        let sym = names.intern(in text.as_slice());
        if k == 0 {
            root = sym;
        } else {
            ar.push(sym);
        }
        lo = inc(hi);
    }
    (root, PRef { a: a, n: wrapping_sub(cuts.len(), 1) })
}

// `block_drops`: block `b` from entry state `s`; whether it diverges.
fn block_drops(
    inout t: Types,
    inout names: Names,
    in wd: World,
    inout dx: Dx,
    inout cx: Cx,
    in p: Program,
    b: u64,
    inout s: St,
    inout plan: Plan
) -> bool {
    let bk = p.block(add(cx.f.b0, b));
    let ni = p.op(inc(bk.ha));
    let pat = add(add(bk.ha, HEAD_INCOMING), wrapping_mul(ni, INCOMING_WORDS));
    let np = p.op(inc(pat));
    for k in 0..np {
        let v = p.op(add(add(pat, 2), k));
        let ty = value_type(in cx, v);
        if holds_box(inout t, in wd, inout dx, ty) {
            own(inout s, n32(v), ty);
        }
    }
    let mut div = false;
    for idx in 0..bk.ic {
        let inst = p.inst(add(bk.i0, idx));
        let a = inst.a;
        if inst.op == Op::Exit {
            let gone = disown(inout s, n32(p.op(a)));
            set_entry(inout plan.bi, b);
            for i in 0..s.vi.len() {
                drop_value(
                    inout plan,
                    Table::BeforeInst,
                    b,
                    idx,
                    u32_at(in s.vi, i),
                    u32_at(in s.vt, i)
                );
            }
            s.vi.clear();
            s.vt.clear();
            owned_slot_drops(
                inout t,
                inout names,
                in wd,
                inout dx,
                inout cx,
                in s,
                inout plan,
                Table::BeforeInst,
                b,
                idx
            );
            div = true;
            break;
        }
        if is_never(in t, in dx, inst.ty) {
            div = true;
            break;
        }
        let dest = inst.dest;
        let boxed = holds_box(inout t, in wd, inout dx, inst.ty);
        let op = inst.op;
        if op == Op::Read {
            let root = n32(p.op(a));
            let pass = p.op(add(a, 2));
            let at = slot_of(in s, root);
            let sink_slot = at == NONE64 || u8_at(in s.sp, at) == TyPass::Sink;
            if pass == widen_u64(TyPass::Sink) && sink_slot {
                if at != NONE64 {
                    let path = program_path(inout cx.ar, in p, p.op(inc(a)));
                    let nproj = p.op(add(a, 3));
                    if nproj == 0 {
                        mark_moved(inout s, in cx.ar, root, path);
                    } else {
                        for k in 0..nproj {
                            let proj = program_path(inout cx.ar, in p, p.op(add(add(a, 4), k)));
                            let full = concat(inout cx.ar, path, proj);
                            mark_moved(inout s, in cx.ar, root, full);
                        }
                    }
                }
                if boxed {
                    own(inout s, dest, inst.ty);
                }
            }
        } else if op == Op::Bind {
            let v = p.op(a);
            let gone = disown(inout s, n32(v));
            let vty = value_type(in cx, v);
            let mut pass: u8 = TyPass::Sink;
            if u8_at(in cx.borrowed, v) != 0 {
                pass = TyPass::In;
            }
            bind_slots(inout t, in names, in wd, in p, inc(a), vty, inout s, pass);
        } else if op == Op::Write {
            let gone = disown(inout s, n32(p.op(add(a, 2))));
            let (root, path) = place_parts(inout names, inout cx.ar, n32(p.op(a)));
            let at = slot_of(in s, root);
            if at != NONE64 {
                let sty = u32_at(in s.st, at);
                if holds_box(inout t, in wd, inout dx, sty) {
                    let sub = resolve(inout t, inout names, in wd, in cx.ar, sty, path);
                    if sub != NONE32 && holds_box(inout t, in wd, inout dx, sub) {
                        let moved = moved_of(in s, root);
                        let mut sub_moved: ChunkSeq[PRef] = ChunkSeq::new[PRef]();
                        for k in 0..moved.len() {
                            let m = pref_at(in moved, k);
                            if starts_with(in cx.ar, path, m) {
                                sub_moved.push(no_path());
                            } else if starts_with(in cx.ar, m, path) {
                                sub_moved.push(PRef {
                                    a: add(m.a, path.n),
                                    n: wrapping_sub(m.n, path.n)
                                });
                            }
                        }
                        set_entry(inout plan.bi, b);
                        let rem = remaining_paths(
                            inout t,
                            inout names,
                            in wd,
                            inout dx,
                            inout cx.ar,
                            sub,
                            in sub_moved
                        );
                        for k in 0..rem.len() {
                            let full = concat(inout cx.ar, path, pref_at(in rem, k));
                            if !owns_path(in cx, in s, at, full) {
                                continue;
                            }
                            let drop_ty = resolve(inout t, inout names, in wd, in cx.ar, sty, full);
                            if drop_ty != NONE32 && holds_box(inout t, in wd, inout dx, drop_ty) {
                                drop_place(
                                    inout plan,
                                    Table::BeforeInst,
                                    b,
                                    idx,
                                    root,
                                    full,
                                    drop_ty
                                );
                            }
                        }
                    }
                }
                // slot.moved.retain(|m| !m.starts_with(&path))
                let mut mo: ChunkSeq[u32] = ChunkSeq::new[u32]();
                let mut mv: ChunkSeq[PRef] = ChunkSeq::new[PRef]();
                for k in 0..s.mo.len() {
                    let m = pref_at(in s.mv, k);
                    if u32_at(in s.mo, k) != root || !starts_with(in cx.ar, m, path) {
                        mo.push(u32_at(in s.mo, k));
                        mv.push(m);
                    }
                }
                s.mo = mo;
                s.mv = mv;
            }
        } else if op == Op::Tuple || op == Op::Data {
            let vs = operands(in p, inst);
            for k in 0..vs.len() {
                let gone = disown(inout s, n32(u64_at(in vs, k)));
            }
            if boxed {
                own(inout s, dest, inst.ty);
            }
        } else if op == Op::Project {
            let base = n32(p.op(a));
            let base_ty = disown(inout s, base);
            if base_ty != NONE32 && holds_box(inout t, in wd, inout dx, base_ty) {
                record(
                    inout plan,
                    Table::AfterInst,
                    b,
                    idx,
                    DropKind::OtherFields,
                    w(base),
                    no_path(),
                    base_ty,
                    n32(p.op(inc(a)))
                );
            }
            if boxed {
                own(inout s, dest, inst.ty);
            }
        } else if seq_get(in p, in names, inst) {
            // A sequence element read in place is lent, never owned.
        } else if op == Op::Call
            || op == Op::Tiled
            || op == Op::Seq
            || op == Op::Fip
            || op == Op::Indirect
        {
            if op == Op::Indirect {
                let gone = disown(inout s, n32(p.op(a)));
            }
            let sinks = sink_args(in p, inst);
            for k in 0..sinks.len() {
                let gone = disown(inout s, n32(u64_at(in sinks, k)));
            }
            if boxed {
                own(inout s, dest, inst.ty);
            }
        } else if op == Op::Try {
            let gone = disown(inout s, n32(p.op(a)));
            if boxed {
                own(inout s, dest, inst.ty);
            }
        } else if op == Op::Loop {} else if op == Op::Closure || op == Op::Handle {
            // pool, aliases (n, pairs), moves (n, (root, path) pairs)
            let mut at = inc(a);
            if op == Op::Handle {
                at = add(a, 3);
            }
            let na = p.op(at);
            at = add(inc(at), wrapping_mul(na, 2));
            let nm = p.op(at);
            at = inc(at);
            for k in 0..nm {
                let root = n32(p.op(at));
                let path = program_path(inout cx.ar, in p, p.op(inc(at)));
                if slot_of(in s, root) != NONE64 {
                    mark_moved(inout s, in cx.ar, root, path);
                }
                at = add(at, 2);
            }
            if op == Op::Handle && p.op(a) != 0 {
                let gone = disown(inout s, n32(p.op(inc(a))));
            }
            if boxed {
                own(inout s, dest, inst.ty);
            }
        } else {
            // Const, Unit, Unary, Binary, Index, Vector
            if boxed {
                own(inout s, dest, inst.ty);
            }
        }
        // dead temporaries
        let mut k: u64 = 0;
        loop {
            if k >= s.vi.len() {
                break;
            }
            let v = w(u32_at(in s.vi, k));
            if !live_out(in cx, b, v) && !used_after(in p, bk, idx, v) {
                let ty = disown(inout s, n32(v));
                drop_value(inout plan, Table::AfterInst, b, idx, n32(v), ty);
            } else {
                k = inc(k);
            }
        }
    }
    if div {
        return true;
    }
    if bk.term == Term::Return {
        let gone = disown(inout s, n32(p.op(bk.ta)));
        set_entry(inout plan.bt, b);
        for i in 0..s.vi.len() {
            drop_value(inout plan, Table::BeforeTerm, b, 0, u32_at(in s.vi, i), u32_at(in s.vt, i));
        }
        s.vi.clear();
        s.vt.clear();
        owned_slot_drops(
            inout t,
            inout names,
            in wd,
            inout dx,
            inout cx,
            in s,
            inout plan,
            Table::BeforeTerm,
            b,
            0
        );
    } else if bk.term == Term::Jump {
        let n = p.op(inc(bk.ta));
        for i in 0..n {
            let gone = disown(inout s, n32(p.op(add(add(bk.ta, 2), i))));
        }
    } else if bk.term == Term::Match {
        let gone = disown(inout s, n32(p.op(bk.ta)));
    } else if bk.term != Term::Branch {
        return true;
    }
    let mut k: u64 = 0;
    loop {
        if k >= s.vi.len() {
            break;
        }
        let v = w(u32_at(in s.vi, k));
        if live_out(in cx, b, v) {
            k = inc(k);
        } else {
            let ty = disown(inout s, n32(v));
            drop_value(inout plan, Table::BeforeTerm, b, 0, n32(v), ty);
        }
    }
    false
}

// Whether the jump of block `pb` to `b` passes a `Never` value.
fn never_edge(in t: Types, in dx: Dx, in p: Program, in cx: Cx, pb: u64, b: u64) -> bool {
    let bk = p.block(add(cx.f.b0, pb));
    if bk.term != Term::Jump || p.op(bk.ta) != b {
        return false;
    }
    let n = p.op(inc(bk.ta));
    for i in 0..n {
        let v = p.op(add(add(bk.ta, 2), i));
        let ty = value_type(in cx, v);
        if ty != NONE32 && is_never(in t, in dx, ty) {
            return true;
        }
    }
    false
}

fn flag_at(in s: ChunkSeq[u8], i: u64) -> bool {
    u8_at(in s, i) != 0
}

fn set_flag(inout s: ChunkSeq[u8], i: u64, x: bool) {
    let mut v: u8 = 0;
    if x {
        v = 1;
    }
    let ok = s.try_set(i, v);
}

// `elaborate_owned`: the plan, or false when the slot states reach no
// fixed point (or the entry block has a predecessor).
fn elaborate_owned(
    inout t: Types,
    inout names: Names,
    in wd: World,
    inout dx: Dx,
    inout cx: Cx,
    in p: Program,
    inout plan: Plan
) -> bool {
    let nb = cx.f.bc;
    if nb == 0 {
        return true;
    }
    graph(in p, inout cx);
    if pred_count(in cx, 0) != 0 {
        return false;
    }
    let mut reachable: ChunkSeq[u8] = ChunkSeq::new[u8]();
    reachable.resize(nb, 0);
    let mut stack: ChunkSeq[u64] = ChunkSeq::new[u64]();
    stack.push(0);
    loop {
        let b = match stack.pop() {
            Option::Some(x) => x,
            Option::None => break,
        };
        if flag_at(in reachable, b) {
            continue;
        }
        set_flag(inout reachable, b, true);
        for k in 0..succ_count(in cx, b) {
            stack.push(succ_of(in cx, b, k));
        }
    }
    // Kahn's order
    let mut indegree: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for b in 0..nb {
        indegree.push(pred_count(in cx, b));
    }
    let mut order: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for b in 0..nb {
        if u64_at(in indegree, b) == 0 {
            order.push(b);
        }
    }
    let mut head: u64 = 0;
    loop {
        if head >= order.len() {
            break;
        }
        let b = u64_at(in order, head);
        head = inc(head);
        for k in 0..succ_count(in cx, b) {
            let s = succ_of(in cx, b, k);
            let d = wrapping_sub(u64_at(in indegree, s), 1);
            let ok = indegree.try_set(s, d);
            if d == 0 {
                order.push(s);
            }
        }
    }
    let acyclic = order.len() == nb;
    if !acyclic {
        // reverse postorder from the entry block
        let mut visited: ChunkSeq[u8] = ChunkSeq::new[u8]();
        visited.resize(nb, 0);
        let mut post: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let mut sb: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let mut sn: ChunkSeq[u64] = ChunkSeq::new[u64]();
        sb.push(0);
        sn.push(0);
        set_flag(inout visited, 0, true);
        loop {
            let b = match sb.pop() {
                Option::Some(x) => x,
                Option::None => break,
            };
            let next = match sn.pop() {
                Option::Some(x) => x,
                Option::None => 0,
            };
            if next < succ_count(in cx, b) {
                let s = succ_of(in cx, b, next);
                sb.push(b);
                sn.push(inc(next));
                if !flag_at(in visited, s) {
                    set_flag(inout visited, s, true);
                    sb.push(s);
                    sn.push(0);
                }
            } else {
                post.push(b);
            }
        }
        order.clear();
        let n = post.len();
        for k in 0..n {
            order.push(u64_at(in post, wrapping_sub(wrapping_sub(n, 1), k)));
        }
    }
    live_inputs(inout t, in wd, inout dx, in p, inout cx);
    let mut have: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut diverged: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut words: ChunkSeq[u64] = ChunkSeq::new[u64]();
    // per block: its exit state's words, at ex[xa..xa+xn]
    let mut ex: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut xa: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut xn: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for b in 0..nb {
        have.push(0);
        diverged.push(0);
        xa.push(0);
        xn.push(0);
    }
    for pass in 0..DROP_FIXPOINT_LIMIT {
        plan = plan_new();
        let mut changed = false;
        for oi in 0..order.len() {
            let b = u64_at(in order, oi);
            if !flag_at(in reachable, b) {
                continue;
            }
            let mut visited: ChunkSeq[u64] = ChunkSeq::new[u64]();
            for k in 0..pred_count(in cx, b) {
                let pb = pred_of(in cx, b, k);
                if flag_at(in reachable, pb) && !flag_at(in diverged, pb) && flag_at(in have, pb) {
                    visited.push(pb);
                }
            }
            let mut live_preds: ChunkSeq[u64] = ChunkSeq::new[u64]();
            for k in 0..visited.len() {
                let pb = u64_at(in visited, k);
                if !never_edge(in t, in dx, in p, in cx, pb, b) {
                    live_preds.push(pb);
                }
            }
            let mut active = live_preds;
            if active.len() == 0 {
                active = visited;
            }
            let mut s = entry_slots(
                inout t,
                inout names,
                in wd,
                inout dx,
                inout cx,
                b,
                in active,
                in ex,
                in xa,
                inout plan
            );
            if active.len() != 0 {
                let first = load_state(in ex, u64_at(in xa, u64_at(in active, 0)), inout cx.ar);
                for i in 0..first.vi.len() {
                    let id = u32_at(in first.vi, i);
                    if !live_in(in cx, b, w(id)) {
                        continue;
                    }
                    let mut all = true;
                    for k in 1..active.len() {
                        let other = load_state(
                            in ex,
                            u64_at(in xa, u64_at(in active, k)),
                            inout cx.ar
                        );
                        if value_at(in other, id) == NONE64 {
                            all = false;
                        }
                    }
                    if all {
                        own(inout s, id, u32_at(in first.vt, i));
                    }
                }
            }
            for k in 0..active.len() {
                let pb = u64_at(in active, k);
                let other = load_state(in ex, u64_at(in xa, pb), inout cx.ar);
                for i in 0..other.vi.len() {
                    let id = u32_at(in other.vi, i);
                    if value_at(in s, id) == NONE64 {
                        drop_value(inout plan, Table::Edge, pb, b, id, u32_at(in other.vt, i));
                    }
                }
            }
            let div = block_drops(
                inout t,
                inout names,
                in wd,
                inout dx,
                inout cx,
                in p,
                b,
                inout s,
                inout plan
            );
            words.clear();
            put_state(in s, in cx.ar, inout words);
            let mut same = flag_at(in have, b)
                && flag_at(in diverged, b) == div
                && u64_at(in xn, b) == words.len();
            if same {
                let base = u64_at(in xa, b);
                for k in 0..words.len() {
                    if u64_at(in ex, add(base, k)) != u64_at(in words, k) {
                        same = false;
                    }
                }
            }
            if !same {
                changed = true;
            }
            set_flag(inout diverged, b, div);
            set_flag(inout have, b, true);
            let ok = xa.try_set(b, ex.len());
            let ok2 = xn.try_set(b, words.len());
            ex.extend(in words.as_slice());
        }
        if !changed || acyclic {
            return true;
        }
    }
    false
}

// ----- writing the plan -------------------------------------------------------------------

fn put_drop(inout p: Program, in plan: Plan, in ar: ChunkSeq[u32], k: u64) {
    let kind = u8_at(in plan.kind, k);
    p.put(widen_u64(kind), Tag::Raw);
    if kind == DropKind::Place {
        p.put(u64_at(in plan.val, k), Tag::Name);
        let path = pref_at(in plan.path, k);
        let mut comps: ChunkSeq[u32] = ChunkSeq::new[u32]();
        for i in 0..path.n {
            comps.push(comp(in ar, path, i));
        }
        let id = p.add_path(in comps);
        p.put(id, Tag::Path);
        p.put(w(u32_at(in plan.ty, k)), Tag::Type);
    } else {
        p.put(u64_at(in plan.val, k), Tag::Value);
        p.put(w(u32_at(in plan.ty, k)), Tag::Type);
        if kind == DropKind::OtherFields {
            p.put(w(u32_at(in plan.keep, k)), Tag::Name);
        }
    }
}

// An instruction table (`before_inst` or `after_inst`): blocks with an
// entry ascending, each with its (instruction, drop) records in order.
fn put_inst_table(inout p: Program, in plan: Plan, in ar: ChunkSeq[u32], table: u8, nb: u64) {
    let mut blocks: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for b in 0..nb {
        let mut entry = false;
        if table == Table::BeforeInst && flag_at(in plan.bi, b) {
            entry = true;
        }
        for k in 0..plan.table.len() {
            if u8_at(in plan.table, k) == table && u64_at(in plan.blk, k) == b {
                entry = true;
            }
        }
        if entry {
            blocks.push(b);
        }
    }
    p.put(blocks.len(), Tag::Raw);
    for i in 0..blocks.len() {
        let b = u64_at(in blocks, i);
        p.put(b, Tag::Block);
        let mut count: u64 = 0;
        for k in 0..plan.table.len() {
            if u8_at(in plan.table, k) == table && u64_at(in plan.blk, k) == b {
                count = inc(count);
            }
        }
        p.put(count, Tag::Raw);
        for k in 0..plan.table.len() {
            if u8_at(in plan.table, k) == table && u64_at(in plan.blk, k) == b {
                p.put(u64_at(in plan.at, k), Tag::Raw);
                put_drop(inout p, in plan, in ar, k);
            }
        }
    }
}

fn put_term_table(inout p: Program, in plan: Plan, in ar: ChunkSeq[u32], nb: u64) {
    let mut blocks: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for b in 0..nb {
        let mut entry = flag_at(in plan.bt, b);
        for k in 0..plan.table.len() {
            if u8_at(in plan.table, k) == Table::BeforeTerm && u64_at(in plan.blk, k) == b {
                entry = true;
            }
        }
        if entry {
            blocks.push(b);
        }
    }
    p.put(blocks.len(), Tag::Raw);
    for i in 0..blocks.len() {
        let b = u64_at(in blocks, i);
        p.put(b, Tag::Block);
        let mut count: u64 = 0;
        for k in 0..plan.table.len() {
            if u8_at(in plan.table, k) == Table::BeforeTerm && u64_at(in plan.blk, k) == b {
                count = inc(count);
            }
        }
        p.put(count, Tag::Raw);
        for k in 0..plan.table.len() {
            if u8_at(in plan.table, k) == Table::BeforeTerm && u64_at(in plan.blk, k) == b {
                put_drop(inout p, in plan, in ar, k);
            }
        }
    }
}

// The trailer words up to the drop tables (call and join slots); whether
// a join slot targets block `s` is asked through `joins`.
fn trailer_drops_at(in p: Program, f: FnRow, inout joins: ChunkSeq[u64]) -> u64 {
    let mut at = f.ta;
    let n = p.op(at);
    at = add(inc(at), wrapping_mul(n, CALL_SLOT_WORDS));
    let nj = p.op(at);
    at = inc(at);
    for i in 0..nj {
        joins.push(p.op(at));
        let k = p.op(inc(at));
        at = add(at, 2);
        for j in 0..k {
            let m = p.op(add(at, 2));
            at = add(at, add(JOIN_HEAD, wrapping_mul(m, JOIN_IN_WORDS)));
        }
    }
    at
}

// Moves function `fi`'s block rows to the end of the table (once), so
// blocks can be appended to it.
fn own_blocks(inout p: Program, fi: u64) {
    let f = p.function(fi);
    if add(f.b0, f.bc) == p.blocks.len() {
        return;
    }
    let b0 = p.blocks.len();
    for b in 0..f.bc {
        let row = p.block(add(f.b0, b));
        p.blocks.push(row);
    }
    let mut nf = f;
    nf.b0 = b0;
    let ok = p.fns.try_set(fi, nf);
}

// `split_edge`: a new empty block on the edge `from -> to` of a branch or
// match, jumping to `to`.
fn split_edge(inout p: Program, fi: u64, from: u64, to: u64) -> u64 {
    own_blocks(inout p, fi);
    let f = p.function(fi);
    let at = f.bc;
    let fb = p.block(add(f.b0, from));
    let ni = p.op(inc(fb.ha));
    let token = p.op(add(add(fb.ha, HEAD_INCOMING), wrapping_mul(ni, INCOMING_WORDS)));
    let ha = p.ops.len();
    p.put(token, Tag::Raw);
    p.put(1, Tag::Raw);
    p.put(from, Tag::Block);
    p.put(token, Tag::Raw);
    p.put(token, Tag::Raw);
    p.put(0, Tag::Raw);
    let hn = wrapping_sub(p.ops.len(), ha);
    let ta = p.ops.len();
    p.put(to, Tag::Block);
    p.put(0, Tag::Raw);
    let tn = wrapping_sub(p.ops.len(), ta);
    p.blocks.push(BlockRow {
        ha: ha,
        hn: hn,
        i0: p.insts.len(),
        ic: 0,
        term: Term::Jump,
        ta: ta,
        tn: tn
    });
    let mut nf = f;
    nf.bc = inc(f.bc);
    let ok = p.fns.try_set(fi, nf);
    // retarget the edge
    if fb.term == Term::Branch {
        for k in 1..3 {
            let x = add(fb.ta, k);
            if p.op(x) == to {
                let ok2 = p.ops.try_set(x, at);
            }
        }
    } else if fb.term == Term::Match {
        let n = p.op(inc(fb.ta));
        let mut x = add(fb.ta, 2);
        for i in 0..n {
            x = pattern_end(in p, x);
            if p.op(x) == to {
                let ok3 = p.ops.try_set(x, at);
            }
            x = inc(x);
        }
    }
    let tb = p.block(add(f.b0, to));
    let tni = p.op(inc(tb.ha));
    for k in 0..tni {
        let x = add(add(tb.ha, HEAD_INCOMING), wrapping_mul(k, INCOMING_WORDS));
        if p.op(x) == from {
            let ok4 = p.ops.try_set(x, at);
        }
    }
    at
}

// Rewrites function `fi`'s drop tables from `plan` (an empty plan clears
// them), placing its edge drops.
fn write_plan(inout p: Program, fi: u64, inout plan: Plan, in ar: ChunkSeq[u32]) {
    // edges, by (source, target), each placed once
    let n = plan.table.len();
    let mut es: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut et: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for k in 0..n {
        if u8_at(in plan.table, k) != Table::Edge {
            continue;
        }
        let pb = u64_at(in plan.blk, k);
        let sb = u64_at(in plan.at, k);
        let mut seen = false;
        for j in 0..es.len() {
            if u64_at(in es, j) == pb && u64_at(in et, j) == sb {
                seen = true;
            }
        }
        if !seen {
            es.push(pb);
            et.push(sb);
        }
    }
    let ne = es.len();
    let mut done: ChunkSeq[u8] = ChunkSeq::new[u8]();
    done.resize(ne, 0);
    for step in 0..ne {
        let mut best = ne;
        for j in 0..ne {
            if flag_at(in done, j) {
                continue;
            }
            let pj = u64_at(in es, j);
            let sj = u64_at(in et, j);
            if best == ne
                || pj < u64_at(in es, best)
                || (pj == u64_at(in es, best) && sj < u64_at(in et, best))
            {
                best = j;
            }
        }
        set_flag(inout done, best, true);
        let pb = u64_at(in es, best);
        let sb = u64_at(in et, best);
        let f = p.function(fi);
        let mut at = pb;
        if p.block(add(f.b0, pb)).term != Term::Jump {
            at = split_edge(inout p, fi, pb, sb);
        }
        for k in 0..n {
            if u8_at(in plan.table, k) == Table::Edge
                && u64_at(in plan.blk, k) == pb
                && u64_at(in plan.at, k) == sb
            {
                let kind = u8_at(in plan.kind, k);
                let val = u64_at(in plan.val, k);
                let path = pref_at(in plan.path, k);
                let ty = u32_at(in plan.ty, k);
                let keep = u32_at(in plan.keep, k);
                record(inout plan, Table::BeforeTerm, at, 0, kind, val, path, ty, keep);
            }
        }
    }
    let f = p.function(fi);
    let mut joins: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let rest = trailer_drops_at(in p, f, inout joins);
    let ta = p.ops.len();
    for x in f.ta..rest {
        let word = p.op(x);
        let tag = p.tag(x);
        p.put(word, tag);
    }
    let nb = f.bc;
    put_inst_table(inout p, in plan, in ar, Table::BeforeInst, nb);
    put_inst_table(inout p, in plan, in ar, Table::AfterInst, nb);
    put_term_table(inout p, in plan, in ar, nb);
    let mut nf = p.function(fi);
    nf.ta = ta;
    nf.tn = wrapping_sub(p.ops.len(), ta);
    let ok = p.fns.try_set(fi, nf);
}

fn cx_new(fi: u64, f: FnRow) -> Cx {
    Cx {
        fi: fi,
        f: f,
        ar: ChunkSeq::new[u32](),
        vty: ChunkSeq::new[u32](),
        pn_: ChunkSeq::new[u32](),
        pp: ChunkSeq::new[u8](),
        pt: ChunkSeq::new[u32](),
        pa: ChunkSeq::new[u64](),
        pc: ChunkSeq::new[u64](),
        pj: ChunkSeq::new[PRef](),
        ext: ChunkSeq::new[u32](),
        succ: ChunkSeq::new[u64](),
        sa: ChunkSeq::new[u64](),
        sc: ChunkSeq::new[u64](),
        pred: ChunkSeq::new[u64](),
        pra: ChunkSeq::new[u64](),
        prc: ChunkSeq::new[u64](),
        bix: ChunkSeq::new[u64](),
        nbox: 0,
        live: ChunkSeq::new[u8](),
        borrowed: ChunkSeq::new[u8](),
    }
}

// Whether `f` is a closure body whose `sink` parameter holds a `Box`.
fn lent_risk(inout t: Types, in names: Names, in wd: World, inout dx: Dx, in cx: Cx) -> bool {
    if !names.has_prefix(cx.f.name, in CLOSURE_PREFIX.as_bytes()) {
        return false;
    }
    for i in 0..cx.pn_.len() {
        if u8_at(in cx.pp, i) == TyPass::Sink
            && holds_box(inout t, in wd, inout dx, at32(in cx.pt, i))
        {
            return true;
        }
    }
    false
}

// `fip::elaborate_non_fip_drops` over `p` (a world with the `Box`
// prelude): the status.
pub fn elaborate_drops(
    inout p: Program,
    inout names: Names,
    inout t: Types,
    in wd: World,
    in calls: Calls,
    fx: FactNames
) -> u64 {
    if !wd.box_active {
        return DropStatus::Ok;
    }
    let mut dx = Dx {
        boxed: ChunkSeq::new[u8](),
        fx: fx,
        never: wd.k.never,
    };
    let nf = p.fn_count();
    // check every function first: a refusal leaves `p` unchanged
    for fi in 0..nf {
        let f = p.function(fi);
        let mut cx = cx_new(fi, f);
        header_words(in p, f, inout cx);
        if lent_risk(inout t, in names, in wd, inout dx, in cx) {
            return DropStatus::LentClosure;
        }
    }
    for fi in 0..nf {
        let f = p.function(fi);
        let at = calls.function(f.name);
        if at != NONE32 && calls.fn_info(at).fip {
            continue;
        }
        let mut cx = cx_new(fi, f);
        header_words(in p, f, inout cx);
        cx.borrowed = scrutinees(in p, fx, f, true);
        let mut plan = plan_new();
        let solved = elaborate_owned(
            inout t,
            inout names,
            in wd,
            inout dx,
            inout cx,
            in p,
            inout plan
        );
        let mut joins: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let rest = trailer_drops_at(in p, f, inout joins);
        let mut placeable = true;
        for k in 0..plan.table.len() {
            if u8_at(in plan.table, k) == Table::Edge {
                let pb = u64_at(in plan.blk, k);
                let sb = u64_at(in plan.at, k);
                if p.block(add(f.b0, pb)).term != Term::Jump && has64(in joins, sb) {
                    placeable = false;
                }
            }
        }
        if !solved || !placeable {
            plan = plan_new();
        }
        write_plan(inout p, fi, inout plan, in cx.ar);
    }
    DropStatus::Ok
}
