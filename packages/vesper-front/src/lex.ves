fn field(info: u64, at: u32) -> u8 {
    wrapping_u8(wrapping_shr_u64(info, at))
}

// The byte `i` (0-7) of the word `w`.
fn byte_of(w: u64, i: u32) -> u8 {
    wrapping_u8(wrapping_shr_u64(w, wrapping_mul(i, 8)))
}

// The punctuation token at `at` whose byte info is `info` and whose next
// byte is `d`: (kind, end).
fn punct(at: u64, info: u64, d: u8) -> (u8, u64) {
    if d == field(info, 16) {
        (field(info, 24), add(at, 2))
    } else if d == field(info, 32) {
        (field(info, 40), add(at, 2))
    } else {
        (field(info, 8), inc(at))
    }
}

// `.`, `..` or `..=` at `at`, with the next two bytes `d` and `e`: (kind,
// end).
fn dots(at: u64, d: u8, e: u8) -> (u8, u64) {
    if d != 46 {
        (42, inc(at))
    } else if e == 61 {
        (76, add(at, 3))
    } else {
        (75, add(at, 2))
    }
}

// SWAR byte classes over a word of eight source bytes. `bytes_ge(y, lo)` is
// bit 7 of each byte of `y` (each byte at least 0x80, so no borrow crosses
// a byte) whose low seven bits are at least the byte `lo`.
fn bytes_ge(y: u64, lo: u64) -> u64 {
    wrapping_sub(y, wrapping_mul(lo, 72340172838076673)) & 9259542123273814144
}

// Bit 7 of each byte of `y` (`w | 0x80..80`) in `lo..=hi`.
fn bytes_in(y: u64, lo: u64, hi: u64) -> u64 {
    bytes_ge(y, lo) & (bytes_ge(y, inc(hi)) ^ 9259542123273814144)
}

// Bit 7 of each byte of `w` that cannot continue an identifier
// (`[A-Za-z0-9_]`).
fn non_ident(w: u64) -> u64 {
    let high: u64 = 9259542123273814144;
    let y = w | high;
    // A-Z folded onto a-z; `_` becomes 0x7f and digits stay.
    let z = y | 2314885530818453536;
    let ident = bytes_in(z, 97, 122) | bytes_in(y, 48, 57) | bytes_in(y, 95, 95);
    // Bytes from 0x80 continue no identifier.
    (ident & (w ^ high)) ^ high
}

// Bit 7 of each byte of `w` that is not whitespace (`[ \t\r\n\x0C]`).
fn non_space(w: u64) -> u64 {
    let high: u64 = 9259542123273814144;
    let y = w | high;
    let space = bytes_in(y, 9, 10) | bytes_in(y, 12, 13) | bytes_in(y, 32, 32);
    (space & (w ^ high)) ^ high
}

// The end of the run that starts at `at`, whose first eight bytes `w` have
// the non-member bits `non`: within the word, else by the byte-class scan
// `lo`/`hi` from `at + 8`.
fn run_from(in b: Slice[u8], at: u64, non: u64, lo: u64, hi: u64) -> u64 {
    if non != 0 {
        return add(at, widen_u64(trailing_zeros_u64(non) >> 3));
    }
    run_end(in b, add(at, 8), lo, hi)
}

// The first `min(len, 8)` bytes of the word `w`, zero above.
fn prefix_word(w: u64, len: u64) -> u64 {
    if len >= 8 {
        w
    } else {
        w & wrapping_sub(shl(1, narrow(shl(len, 3))), 1)
    }
}

// A lower-case identifier or keyword at `at`: (kind, end).
fn lower(in b: Slice[u8], at: u64, w: u64) -> (u8, u64) {
    let i = run_from(in b, at, non_ident(w), digit_class(), ident_class_hi());
    let len = wrapping_sub(i, at);
    (keyword(len, prefix_word(w, len)), i)
}

// The token at `at` (below the input length) for the classes the lexer
// loop does not read itself (`lex_tokens`): (kind, end). `w` holds the
// eight bytes from `at` (zero past the end) and `info` is the first byte's
// `BYTE_INFO`.
fn next_token_rest(in b: Slice[u8], at: u64, w: u64, info: u64) -> (u8, u64) {
    let n = b.len();
    let class = wrapping_u8(info);
    if class == 4 {
        return (k_upper(), run_from(in b, at, non_ident(w), digit_class(), ident_class_hi()));
    }
    if class == 8 {
        return dots(at, byte_of(w, 1), byte_of(w, 2));
    }
    if class == 5 {
        return number(in b, at);
    }
    if class == 2 {
        let d = byte_of(w, 1);
        if d == 47 {
            let from = add(at, 2);
            return match b[from..n].find_byte(10) {
                Option::Some(j) => (k_comment(), add(from, j)),
                Option::None => (k_comment(), n),
            };
        }
        if d == 42 {
            return block_comment(in b, at);
        }
        return punct(at, info, d);
    }
    if class == 6 {
        return string(in b, at);
    }
    let e = add(at, char_len(wrapping_u8(w)));
    (
        k_error(),
        if e > n {
            n
        } else {
            e
        }
    )
}

fn push_token(inout t: Tokens, kind: u8, start: u64) {
    t.kind.push(kind);
    t.start.push(narrow(start));
}

// The end of token `i`: the start of the next one (tokens cover the source
// without gaps), and for the last (Eof) its start.
pub fn token_end(in t: Tokens, i: u64) -> u64 {
    match t.start.try_get(inc(i)) {
        Option::Some(e) => widen_u64(e),
        Option::None => w32(in t.start, i),
    }
}

// The contextual word (words.ves) of an identifier token, else 0.
pub fn token_word(in t: Tokens, i: u64) -> u8 {
    wrapping_u8(u32_at(in t.sym, i) >> 24)
}

// The symbol (from 1) of an identifier token, else 0.
pub fn token_sym(in t: Tokens, i: u64) -> u32 {
    u32_at(in t.sym, i) & 16777215
}

// The hash of the identifier `b[s..e]` whose first bytes are the word `w`,
// eight bytes per step (multiplicative, so the slot is its top bits).
fn ident_hash(in b: Slice[u8], s: u64, e: u64, w: u64) -> u64 {
    let k: u64 = 11400714819323198485;
    let mut h = wrapping_mul(w ^ wrapping_sub(e, s), k);
    let mut i = add(s, 8);
    loop {
        if i >= e {
            break;
        }
        h = wrapping_mul(h ^ word_at(in b, i, wrapping_sub(e, i)) ^ (h >> 31), k);
        i = add(i, 8);
    }
    h
}

// Whether `b[s1..s1 + n]` and `b[s2..s2 + n]` hold the same bytes, eight
// at a time.
fn same_bytes(in b: Slice[u8], s1: u64, s2: u64, n: u64) -> bool {
    let mut i: u64 = 0;
    loop {
        if i >= n {
            return true;
        }
        let m = wrapping_sub(n, i);
        if word_at(in b, add(s1, i), m) != word_at(in b, add(s2, i), m) {
            return false;
        }
        i = add(i, 8);
    }
}

// The slot table holds two words per slot: a tag word, symbol (bits 0-31,
// from 1; 0 for a free slot), contextual word (bits 32-39), length capped
// at 255 (bits 40-47) and the hash's low 16 bits (bits 48-63), then the
// symbol's first eight bytes (`word_at`). Its size is a power of two at
// least twice the symbol count; `slot_shift` is 64 minus its log2.
fn tag_key(h: u64, n: u64) -> u64 {
    let len = if n > 255 {
        255
    } else {
        n
    };
    len | shl(h & 65535, 8)
}

// Puts the slot (`tag`, `w`) at the first free slot of hash `h`.
fn slot_insert(inout t: Tokens, h: u64, tag: u64, w: u64) {
    let mask = wrapping_sub(t.slots.len() >> 1, 1);
    let mut i = wrapping_shr_u64(h, narrow(t.slot_shift));
    loop {
        let j = shl(i, 1);
        if u64_at(in t.slots, j) == 0 {
            t.slots.try_set(j, tag);
            t.slots.try_set(inc(j), w);
            return;
        }
        i = inc(i) & mask;
    }
}

// Doubles the slot table and reinserts every symbol.
fn slots_grow(inout t: Tokens) {
    let old = t.slots.len();
    let mut moved = ChunkSeq::with_capacity[u64](old);
    moved.extend(in t.slots.as_slice());
    t.slots.clear();
    t.slots.resize(shl(old, 1), 0);
    t.slot_shift = wrapping_sub(t.slot_shift, 1);
    let mut j: u64 = 0;
    loop {
        if j >= old {
            break;
        }
        let tag = u64_at(in moved, j);
        if tag != 0 {
            let sym = widen_u64(wrapping_u32(tag));
            let h = u64_at(in t.sym_hash, wrapping_sub(sym, 1));
            slot_insert(inout t, h, tag, u64_at(in moved, inc(j)));
        }
        j = add(j, 2);
    }
}

// The slot tag of the identifier `b[s..e]` (first bytes `w`), interning it
// on first sight; its low 32 bits are the symbol and bits 32-39 the
// contextual word. Lookups that hit stay in this loop; the rest is
// `intern_long` and `intern_new`.
fn intern(inout t: Tokens, in b: Slice[u8], s: u64, e: u64, kind: u8, w: u64) -> u64 {
    let n = wrapping_sub(e, s);
    let h = if n <= 8 {
        wrapping_mul(w ^ n, 11400714819323198485)
    } else {
        ident_hash(in b, s, e, w)
    };
    let key = tag_key(h, n);
    let mask = wrapping_sub(t.slots.len() >> 1, 1);
    let mut i = wrapping_shr_u64(h, narrow(t.slot_shift));
    loop {
        let j = shl(i, 1);
        let tag = u64_at(in t.slots, j);
        if tag == 0 {
            return intern_new(inout t, in b, s, e, kind, w, h, j);
        }
        if tag >> 40 == key && u64_at(in t.slots, inc(j)) == w {
            if n <= 8 || same_symbol(in t, in b, tag, s, n) {
                return tag;
            }
        }
        i = inc(i) & mask;
    }
}

// Whether the symbol of `tag` is spelled `b[s..s + n]`, for `n > 8` whose
// first eight bytes already match.
fn same_symbol(in t: Tokens, in b: Slice[u8], tag: u64, s: u64, n: u64) -> bool {
    let k = widen_u64(wrapping_sub(wrapping_u32(tag), 1));
    let ks = w32(in t.sym_start, k);
    wrapping_sub(w32(in t.sym_end, k), ks) == n
        && same_bytes(in b, add(ks, 8), add(s, 8), wrapping_sub(n, 8))
}

// Interns `b[s..e]` (first bytes `w`, hash `h`) as a new symbol in the free
// slot at word `j` and returns its tag.
fn intern_new(inout t: Tokens, in b: Slice[u8], s: u64, e: u64, kind: u8, w: u64, h: u64, j: u64)
    -> u64 {
    let n = wrapping_sub(e, s);
    let fresh = inc(t.sym_start.len());
    t.sym_start.push(narrow(s));
    t.sym_end.push(narrow(e));
    t.sym_hash.push(h);
    let word = if kind == k_lower() {
        lower_word(in b, s, n, w)
    } else if kind == k_upper() {
        upper_word(n, w)
    } else {
        0
    };
    let tag = fresh | shl(widen_u64(word), 32) | shl(tag_key(h, n), 40);
    t.slots.try_set(j, tag);
    t.slots.try_set(inc(j), w);
    if shl(t.sym_start.len(), 2) > t.slots.len() {
        slots_grow(inout t);
    }
    tag
}

pub fn tokens_new(len: u64) -> Tokens {
    let mut slots = ChunkSeq::new[u64]();
    slots.resize(512, 0);
    let cap = inc(len >> 2);
    Tokens {
        kind: ChunkSeq::with_capacity[u8](cap),
        start: ChunkSeq::with_capacity[u32](cap),
        sym: ChunkSeq::with_capacity[u32](cap),
        slots: slots,
        slot_shift: 56,
        sym_start: ChunkSeq::new[u32](),
        sym_end: ChunkSeq::new[u32](),
        sym_hash: ChunkSeq::new[u64](),
        limited: false,
        limit_kind: 0,
        rejected: false
    }
}

// Logical limits of `LexLimits::default()`.
pub fn max_source_bytes() -> u64 {
    1048576
}

pub fn max_tokens() -> u64 {
    65536
}

pub fn max_diagnostics() -> u64 {
    128
}

// `lex_with_limits(source, LexLimits::default())` for a source within the
// byte budget. A token or diagnostic overflow ends the stream with one
// opaque Error tail and E0003 and sets `limited`.
pub fn lex_raw(in b: Slice[u8], inout d: Diags) -> Tokens {
    lex_tokens(in b, inout d, false, max_tokens(), max_diagnostics())
}

// `lex_raw` with each identifier's contextual word and symbol.
pub fn lex(in b: Slice[u8], inout d: Diags) -> Tokens {
    lex_tokens(in b, inout d, true, max_tokens(), max_diagnostics())
}

// Hard ceilings of `LexLimits` (`HARD_SOURCE_BYTES`, `HARD_TOKENS`,
// `HARD_DIAGNOSTICS`).
pub fn hard_source_bytes() -> u64 {
    8388608
}

pub fn hard_tokens() -> u64 {
    262144
}

pub fn hard_diagnostics() -> u64 {
    1024
}

// The preflight of `lex_with_limits`: 0 when the limits and the source
// size pass, else the E0003 message of the `LexLimit` error (retained 0
// bytes) in `m` and 1.
pub fn lex_preflight(
    inout m: ChunkSeq[u8],
    n: u64,
    max_source_bytes: u64,
    max_tok: u64,
    max_diag: u64
) -> u64 {
    if max_source_bytes > hard_source_bytes() {
        limit_message_observed(inout m, 4, hard_source_bytes(), max_source_bytes, 0);
        return 1;
    }
    if max_tok > hard_tokens() || max_tok < 1 {
        limit_message_observed(inout m, 4, hard_tokens(), max_tok, 0);
        return 1;
    }
    if max_diag > hard_diagnostics() || max_diag < 1 {
        limit_message_observed(inout m, 4, hard_diagnostics(), max_diag, 0);
        return 1;
    }
    if n > max_source_bytes {
        limit_message_observed(inout m, 0, max_source_bytes, n, 0);
        return 1;
    }
    0
}

// `lex_with_limits(source, LexLimits { .. })` with each identifier's
// contextual word and symbol, as `lex`. When the preflight fails (`Err`
// in Rust) the table has no rows, `rejected` is set and `d` gets one E0003
// at 0..0 whose message is the `LexLimit` (retained 0 bytes).
pub fn lex_with_limits(
    in b: Slice[u8],
    inout d: Diags,
    max_source_bytes: u64,
    max_tok: u64,
    max_diag: u64
) -> Tokens {
    let mut m = ChunkSeq::new[u8]();
    if lex_preflight(inout m, b.len(), max_source_bytes, max_tok, max_diag) != 0 {
        diag_push(inout d, 3, 0, 0, in m.as_slice());
        let mut t = tokens_new(0);
        t.rejected = true;
        return t;
    }
    lex_tokens(in b, inout d, true, max_tok, max_diag)
}

// Identifier kinds that get a symbol: Upper, Lower and the keywords the
// parser also takes as names (`self`, `state`, `linear`, `with`).
fn named_kind(k: u8) -> bool {
    // Bits 3 (Upper), 4 (Lower), 16 (linear), 22 (self), 24 (state) and 25
    // (with).
    k < 32 && (wrapping_shr_u64(54591512, widen_u32(k)) & 1) != 0
}

fn lex_tokens(in b: Slice[u8], inout d: Diags, classify: bool, max_tok: u64, max_diag: u64)
    -> Tokens {
    let n = b.len();
    let mut t = tokens_new(n);
    let mut at: u64 = 0;
    loop {
        if at >= n {
            break;
        }
        // The next token. The common kinds (identifiers, punctuation and
        // whitespace) are read here, the rest by `next_token_rest`.
        let w = word_at(in b, at, 8);
        let info = BYTE_INFO[w & 255];
        let class = wrapping_u8(info);
        let (kind, end) = if class == 3 {
            lower(in b, at, w)
        } else if class == 7 {
            punct(at, info, byte_of(w, 1))
        } else if class == 1 {
            (k_whitespace(), run_from(in b, at, non_space(w), space_class(), 0))
        } else {
            next_token_rest(in b, at, w, info)
        };
        if t.kind.len() >= max_tok {
            let last = wrapping_sub(t.kind.len(), 1);
            // The tail's end is the Eof's start, `n`.
            t.kind.try_set(last, k_error());
            if classify {
                t.sym.try_set(last, 0);
            }
            let mut m = ChunkSeq::new[u8]();
            limit_message(inout m, 1, max_tok, n);
            diag_push_limit(inout d, 3, at, at, in m.as_slice(), max_diag);
            t.limited = true;
            t.limit_kind = 1;
            break;
        }
        if kind == k_error() {
            if d.code.len() >= max_diag {
                let mut m = ChunkSeq::new[u8]();
                limit_message(inout m, 2, max_diag, n);
                diag_push_limit(inout d, 3, at, at, in m.as_slice(), max_diag);
                push_token(inout t, k_error(), at);
                if classify {
                    t.sym.push(0);
                }
                t.limited = true;
                t.limit_kind = 2;
                break;
            }
            diag_push(inout d, 1, at, end, in "invalid token or unterminated comment".as_bytes());
        }
        push_token(inout t, kind, at);
        if classify {
            if named_kind(kind) {
                let len = wrapping_sub(end, at);
                let tag = intern(inout t, in b, at, end, kind, prefix_word(w, len));
                t.sym.push(wrapping_u32((tag & 16777215) | shl((tag >> 32) & 255, 24)));
            } else {
                t.sym.push(0);
            }
        }
        at = end;
    }
    push_token(inout t, k_eof(), n);
    if classify {
        t.sym.push(0);
    }
    t
}

// Trivia kinds: whitespace, line and block comments.
pub fn trivia_kind(k: u8) -> bool {
    k <= 2
}
