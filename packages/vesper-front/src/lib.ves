// @vesper/front: the self-hosted front end v2 (self-hosting wave SH0 lane 7,
// #1129). A lexer over `Str` into a token table and a lossless CST parser
// into node and token tables, with the token kinds, node kinds, text ranges
// and diagnostics (codes, messages and spans) of `vesper_syntax::parser::parse`
// (crates/vesper-syntax). tests/self_host_front_v2.rs checks them against
// the Rust parser on every `.ves` file of the repository, the parser test
// corpus and a fuzzed corpus.
//
// The frozen Stage 1 front end in packages/vesper-compiler is unchanged:
// it reads `source_byte(i)` and folds its CST into a digest (bootstrap/
// stage1.lock). This package is the front end the self-hosted compiler
// will read, beside the Rust one, which stays the default.
//
// Layout of the result of `parse_tables` (one u64 per field):
//   [tokens, nodes, diagnostics]
//   tokens rows:      kind, start, end, parent node   (CST leaf order)
//   node rows:        kind, parent (node count for the root), start, end
//                     (preorder)
//   diagnostic rows:  code (1, 2 or 3 for E000n), start, end, message
//                     length, then the message bytes, one per word

use self::lex::{
    lex,
    lex_raw,
    lex_with_limits,
    max_source_bytes,
    max_diagnostics
};
use self::diag::{
    diags_new,
    diag_push,
    limit_message_observed
};
use self::parse::{
    parse_tokens,
    hard_depth
};
use self::recover::{
    editor_limits,
    parse_recovery_tables
};
use self::tree::{
    tree_new,
    build_tree,
    report
};
use self::util::{
    byte,
    inc,
    shl,
    u8_at,
    w32
};

// The token table of one source: parallel rows.
pub struct Tokens {
    // Kind of each token (discriminant of `TokenKind`).
    kind: ChunkSeq[u8],
    // Start of each token; a token ends where the next starts (lex.ves
    // `token_end`).
    start: ChunkSeq[u32],
    // Interned symbol of an identifier (from 1, bits 0-23) and its
    // contextual word (words.ves, bits 24-31), else 0 (`token_sym`,
    // `token_word`). Filled by `lex`, empty after `lex_raw`.
    sym: ChunkSeq[u32],
    // The interner: open addressing over two-word slots (lex.ves
    // `tag_key`), 64 minus the log2 of the slot count, and each symbol's
    // first spelling and hash.
    slots: ChunkSeq[u64],
    slot_shift: u64,
    sym_start: ChunkSeq[u32],
    sym_end: ChunkSeq[u32],
    sym_hash: ChunkSeq[u64],
    // The lexer stopped at a token or diagnostic limit, and which (1 Tokens,
    // 2 Diagnostics).
    limited: bool,
    limit_kind: u8,
    // `lex_with_limits` refused the limits or the source size (no rows).
    rejected: bool
}

// Diagnostics, in order.
pub struct Diags {
    code: ChunkSeq[u8],
    start: ChunkSeq[u32],
    end: ChunkSeq[u32],
    // Start of each message in `text`.
    at: ChunkSeq[u32],
    text: ChunkSeq[u8]
}

// The CST: nodes in preorder and tokens in text order, each with its
// parent node.
pub struct Tree {
    node_kind: ChunkSeq[u8],
    node_parent: ChunkSeq[u32],
    node_start: ChunkSeq[u32],
    node_end: ChunkSeq[u32],
    leaf_token: ChunkSeq[u32],
    leaf_parent: ChunkSeq[u32]
}

// Parser state (crates/vesper-syntax/src/parser.rs `Parser`, batch mode).
pub struct P {
    t: Tokens,
    d: Diags,
    // Source bytes (the `}` check of block-like statements).
    src: ChunkSeq[u8],
    // Indices of the non-trivia tokens, and for each token the number of
    // non-trivia tokens before it.
    sig: ChunkSeq[u32],
    rank: ChunkSeq[u32],
    ntok: u64,
    pos: u64,
    // CST builder events: a token index, a node start (2^31 + kind) or a
    // node finish (2^32 - 1).
    ev: ChunkSeq[u32],
    no_struct: bool,
    // Scoped name sets (`row_names`, `bound_values`): a live count per
    // symbol and an undo trail.
    rows: ChunkSeq[u32],
    rows_trail: ChunkSeq[u32],
    vals: ChunkSeq[u32],
    vals_trail: ChunkSeq[u32],
    // Scratch stack of symbols: pattern bindings, parameter names and row
    // generics, popped by whoever pushed them.
    binds: ChunkSeq[u32],
    // Spans of the trait bounds read by the latest `generics` call that no
    // declaration has taken yet (`pending_bounds`), as start/end pairs.
    pending: ChunkSeq[u32],
    depth: u64,
    // Scalar elements of the type `ty` read last (`type_leaves`).
    leaves: u64,
    halted: bool,
    // `ParseLimits::max_diagnostics` and `max_depth`.
    max_diag: u64,
    max_depth: u64,
    // Editor mode (`Parser::editor`, recovery.ves): BLOCK, ERROR_NODE and
    // INCOMPLETE nodes, statement recovery and recovery sites.
    editor: bool,
    site_limit: u64,
    site_exhausted: bool,
    // The limit that halted the parser: 0 none, 2 Diagnostics, 3 Depth.
    halt_kind: u64,
    // Sites, four words each: start, end, kind (`SiteKind` order: 0
    // MissingMember, 1 MissingDelimiter, 2 Unexpected, 3 OpaqueLexical, 4
    // OpaqueMacro) and the token of the receiver root plus 1, else 0.
    sites: ChunkSeq[u32],
    // The first function header note (`HeaderNote`): start, body start,
    // clean, nongeneric and the number of row names, then the symbols of
    // the row names and the bound values in `hdr_syms`. Empty when none.
    hdr: ChunkSeq[u64],
    hdr_syms: ChunkSeq[u32],
    // Start of the span of the last declaration (`item_span`).
    item_start: u64,
    // Token weight of the or-pattern bodies copied so far
    // (`Parser::expansion`, `OR_PATTERN_EXPANSION`).
    expansion: u64
}

// What the parser keeps of a parsed expression: its kind (parse.ves
// `x_*`), span, height (the Rust parser's `expr_heights`), the symbol of a
// one-segment name, whether it names a tiled column accessor, for a
// place path (a name and fields) its number of nodes, else 0, its scalar
// elements through tuples and block tails (`expr_leaves`), and whether it
// is built from literals and names by operators only (`pure_operand`).
pub copy struct Ex {
    k: u8,
    start: u32,
    end: u32,
    h: u32,
    sym: u32,
    tiled: bool,
    path: u32,
    leaves: u64,
    pure: bool,
    // For a lower-case name and the fields read from it, the name's token
    // plus 1 (the root of a recovery `Receiver`), else 0.
    rcv: u32
}

// Parses `source` (`vesper_syntax::parser::parse`) into the token, node and
// diagnostic tables described above.
pub fn parse_tables(in source: Str) -> ChunkSeq[u64] {
    let b = source.as_bytes();
    let n = b.len();
    let mut tree = tree_new();
    if n > max_source_bytes() {
        // `parse`'s fallback: one Error token over the longest UTF-8 prefix
        // within the byte budget, and E0003.
        let mut retained = max_source_bytes();
        loop {
            let c = byte(in b, retained);
            if retained == 0 || c < 128 || c >= 192 {
                break;
            }
            retained = wrapping_sub(retained, 1);
        }
        let mut d = diags_new();
        let mut m = ChunkSeq::new[u8]();
        limit_message_observed(inout m, 0, max_source_bytes(), n, retained);
        diag_push(inout d, 3, retained, retained, in m.as_slice());
        return report_oversized(retained, in d);
    }
    let mut d = diags_new();
    let t = lex(in b, inout d);
    let p = parse_tokens(in b, t, d, max_diagnostics(), hard_depth());
    build_tree(inout tree, in p);
    report(in tree, in p)
}

// `parse_with_limits(source, ParseLimits { max_source_bytes, max_tokens,
// max_diagnostics, max_depth: HARD_PARSE_DEPTH })` as the tables of
// `parse_tables`. When Rust returns `Err(LexLimit)` (limits out of range or
// an oversized source) the tables have no tokens or nodes and one E0003
// at 0..0 whose message is that `LexLimit`.
pub fn parse_tables_with_limits(
    in source: Str,
    max_source_bytes: u64,
    max_tokens: u64,
    max_diagnostics: u64
) -> ChunkSeq[u64] {
    let b = source.as_bytes();
    let mut d = diags_new();
    let t = lex_with_limits(in b, inout d, max_source_bytes, max_tokens, max_diagnostics);
    if t.rejected {
        return report_rejected(in d);
    }
    let p = parse_tokens(in b, t, d, max_diagnostics, hard_depth());
    let mut tree = tree_new();
    build_tree(inout tree, in p);
    report(in tree, in p)
}

// `parse_tables_with_limits` with the token limit in the low 32 bits of
// `counts` and the diagnostic limit in the high 32 bits: the host entry of
// tests/self_host_front_v2.rs, whose native calls take at most three words.
pub fn parse_tables_with_packed_limits(in source: Str, max_source_bytes: u64, counts: u64)
    -> ChunkSeq[u64] {
    parse_tables_with_limits(in source, max_source_bytes, counts & 4294967295, counts >> 32)
}

// The tables of a refused parse: no tokens or nodes, the diagnostics of `d`.
fn report_rejected(in d: Diags) -> ChunkSeq[u64] {
    let mut out = ChunkSeq::new[u64]();
    out.push(0);
    out.push(0);
    out.push(d.code.len());
    for i in 0..d.code.len() {
        let at = w32(in d.at, i);
        let end = if inc(i) < d.code.len() {
            w32(in d.at, inc(i))
        } else {
            d.text.len()
        };
        out.push(widen_u64(u8_at(in d.code, i)));
        out.push(w32(in d.start, i));
        out.push(w32(in d.end, i));
        out.push(wrapping_sub(end, at));
        for j in at..end {
            out.push(widen_u64(u8_at(in d.text, j)));
        }
    }
    out
}

fn report_oversized(retained: u64, in d: Diags) -> ChunkSeq[u64] {
    let mut out = ChunkSeq::new[u64]();
    let leaves: u64 = if retained == 0 {
        0
    } else {
        1
    };
    out.push(leaves);
    out.push(1);
    out.push(1);
    if retained != 0 {
        out.push(69);
        out.push(0);
        out.push(retained);
        out.push(0);
    }
    out.push(200);
    out.push(1);
    out.push(0);
    out.push(retained);
    out.push(3);
    out.push(retained);
    out.push(retained);
    out.push(d.text.len());
    for i in 0..d.text.len() {
        out
            .push(
            match d.text.try_get(i) {
                Option::Some(c) => widen_u64(c),
                Option::None => 0,
            }
        );
    }
    out
}

// `vesper_syntax::parser::parse_recovery(source, limits)` (recover.ves) as
// rows: a status word, 0 when the parse succeeded, else the
// `recovery::Error` (recover.ves) and nothing more. On success: the
// declaration and site counts, the rows of `parse_tables`, then for each
// declaration 12 words (kind in `DeclarationKind` order, name, span,
// header, body and body green spans as start/end pairs, u64::MAX pairs
// when absent, and the status: 0 complete, 1 recovered, 2 opaque), then
// for each site its start, end, kind (`SiteKind` order), owner and the
// receiver's projection count (u64::MAX for none) followed by the root and
// each projection as start/end pairs. `limits` is `Limits::default()` with
// the nonzero fields of `a` and `b` (recover.ves `editor_limits`).
pub fn parse_editor_tables(in source: Str, a: u64, b: u64) -> ChunkSeq[u64] {
    let lim = editor_limits(a, b);
    parse_recovery_tables(in source, in lim)
}

// `parse_editor_tables` under the default limits, for benchmarks: the
// status word, or the number of result words.
pub fn parse_editor_count(in source: Str) -> u64 {
    let rows = parse_editor_tables(in source, 0, 0);
    match rows.try_get(0) {
        Option::Some(0) => rows.len(),
        Option::Some(code) => code,
        Option::None => 0,
    }
}

// Parses `source` and returns tokens * 2^32 + nodes, for benchmarks: the
// same work as `parse_tables` without building the result rows.
pub fn parse_counts(in source: Str) -> u64 {
    let b = source.as_bytes();
    if b.len() > max_source_bytes() {
        return 0;
    }
    let mut d = diags_new();
    let t = lex(in b, inout d);
    let p = parse_tokens(in b, t, d, max_diagnostics(), hard_depth());
    let mut tree = tree_new();
    build_tree(inout tree, in p);
    wrapping_add(shl(p.t.kind.len(), 32), tree.node_kind.len())
}

// Lexes `source` only and returns the token count, for benchmarks.
pub fn lex_count(in source: Str) -> u64 {
    let b = source.as_bytes();
    if b.len() > max_source_bytes() {
        return 0;
    }
    let mut d = diags_new();
    let t = lex(in b, inout d);
    t.kind.len()
}

// Lexes `source` without classifying identifiers (no contextual words or
// symbols) and returns the token count, for benchmarks.
pub fn lex_raw_count(in source: Str) -> u64 {
    let b = source.as_bytes();
    if b.len() > max_source_bytes() {
        return 0;
    }
    let mut d = diags_new();
    let t = lex_raw(in b, inout d);
    t.kind.len()
}

test {
    use self::lex::{
        token_end,
        token_sym,
        token_word
    };
    use self::util::u64_at;
    use self::words::{
        w_TiledSeq,
        w_test_case,
        w_underscore
    };

    // @case empty(in "", 1)
    // @case identifiers_and_space(in "foo foo", 4)
    // @case nested_comment(in "/* a /* b */ c */", 2)
    // @case comment_and_newline(in "// comment\nx", 4)
    // @case integer_range(in "1..2", 4)
    // @case floating_exponent(in "12.5e-2", 2)
    // @case string_with_escape(in "\"a\\nb\"", 2)
    // @case declaration(in "fn main() -> i64 { 0 }", 16)
    fn test_lex_counts(in source: Str, expected: u64) -> bool {
        lex_count(in source) == expected && lex_raw_count(in source) == expected
    }

    // @case first_occurrence(0, 9, w_test_case(), true)
    // @case repeated_symbol(2, 19, w_test_case(), true)
    // @case underscore(4, 21, w_underscore(), false)
    // @case tiled_type(6, 30, w_TiledSeq(), false)
    // @case keyword(8, 33, 0, false)
    fn test_contextual_tags(index: u64, end: u64, word: u8, repeats: bool) -> bool {
        let mut diagnostics = diags_new();
        let tokens = lex(in "test_case test_case _ TiledSeq fn".as_bytes(), inout diagnostics);
        let first = token_sym(in tokens, 0);
        let current = token_sym(in tokens, index);
        let same_symbol = first != 0 && current == first;
        diagnostics
            .code
            .len()
            == 0
            && same_symbol
            == repeats
            && token_word(in tokens, index)
            == word
            && token_end(in tokens, index)
            == end
    }

    // @case empty(in "", 0)
    // @case trivia_only(in " // comment\n", 0)
    // @case simple_function(in "fn f() -> i64 { 3 }", 0)
    // @case nested_expression(in "fn f() -> i64 { (1 + 2) * 3 }", 0)
    // The lexer reports the bad token and the parser reports the missing declaration.
    // @case unterminated_comment(in "/* unfinished", 2)
    fn test_batch_tables(in source: Str, diagnostics: u64) -> bool {
        let rows = parse_tables(in source);
        let leaves = u64_at(in rows, 0);
        let nodes = u64_at(in rows, 1);
        if nodes == 0 || rows.try_get(2) != Option::Some(diagnostics) {
            return false;
        }
        let root = wrapping_add(3, leaves << 2);
        let root_parent = u64_at(in rows, wrapping_add(root, 1));
        let root_start = u64_at(in rows, wrapping_add(root, 2));
        let root_end = u64_at(in rows, wrapping_add(root, 3));
        if root_parent != nodes || root_start != 0 || root_end != source.len() {
            return false;
        }
        let mut position: u64 = 0;
        for i in 0..leaves {
            let row = wrapping_add(3, i << 2);
            let start = u64_at(in rows, wrapping_add(row, 1));
            let end = u64_at(in rows, wrapping_add(row, 2));
            let parent = u64_at(in rows, wrapping_add(row, 3));
            if start != position || end < start || parent >= nodes {
                return false;
            }
            position = end;
        }
        position == source.len() && (parse_counts(in source) & 4294967295) == nodes
    }

    // @case exactly_at_byte_limit(in "fn f() {}", 9, 20, 2, false)
    // @case exceeds_byte_limit(in "fn f() {}", 8, 20, 2, true)
    // @case bad_configuration(in "", 8388609, 20, 2, true)
    fn test_batch_limits(in source: Str, bytes: u64, tokens: u64, diags: u64, rejected: bool)
        -> bool {
        let direct = parse_tables_with_limits(in source, bytes, tokens, diags);
        let packed = parse_tables_with_packed_limits(in source, bytes, tokens | (diags << 32));
        if direct.len() != packed.len() {
            return false;
        }
        for i in 0..direct.len() {
            if direct.try_get(i) != packed.try_get(i) {
                return false;
            }
        }
        if rejected {
            let empty = direct
                .try_get(0)
                == Option::Some(0)
                && direct
                .try_get(1)
                == Option::Some(0);
            empty && direct.try_get(2) == Option::Some(1) && direct.try_get(3) == Option::Some(3)
        } else {
            direct.try_get(2) == Option::Some(0) && u64_at(in direct, 1) > 0
        }
    }

    // @case empty(in "", 0, 0, 0, 0)
    // @case two_declarations(in "fn first() {}\nfn second() {}", 0, 0, 0, 2)
    // @case recover_before_next(in "fn first() { let = 1; }\nfn second() {}", 0, 0, 0, 2)
    // @case token_budget(in "fn first() {}", 0, 4294967296, 11, 0)
    // @case work_budget(in "fn first() {}", 0, 1, 17, 0)
    // @case invalid_limits(in "", 255, 0, 1, 0)
    fn test_editor_tables(in source: Str, a: u64, b: u64, code: u64, declarations: u64) -> bool {
        let rows = parse_editor_tables(in source, a, b);
        if rows.try_get(0) != Option::Some(code) {
            return false;
        }
        if code == 0 {
            rows.try_get(1) == Option::Some(declarations) && rows.len() > 3
        } else {
            rows.len() == 1
        }
    }
}
