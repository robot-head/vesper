// The Debug name of kind `k`, which `expected {k:?}, found {:?}` prints.
pub fn kind_name(k: u8) -> String {
    match k {
        0 => "Whitespace",
        1 => "Comment",
        2 => "BlockComment",
        3 => "Upper",
        4 => "Lower",
        5 => "Float",
        6 => "Int",
        7 => "String",
        8 => "Struct",
        9 => "Enum",
        10 => "Effect",
        11 => "Impl",
        12 => "Fn",
        13 => "Let",
        14 => "Copy",
        15 => "Affine",
        16 => "Linear",
        17 => "Mod",
        18 => "Eff",
        19 => "In",
        20 => "Inout",
        21 => "Sink",
        22 => "SelfKw",
        23 => "Handle",
        24 => "State",
        25 => "With",
        26 => "Return",
        27 => "Match",
        28 => "If",
        29 => "Else",
        30 => "True",
        31 => "False",
        32 => "LParen",
        33 => "RParen",
        34 => "LBrace",
        35 => "RBrace",
        36 => "LBracket",
        37 => "RBracket",
        38 => "Comma",
        39 => "Semi",
        40 => "Colon",
        41 => "ColonColon",
        42 => "Dot",
        43 => "Question",
        44 => "At",
        45 => "AtAt",
        46 => "Arrow",
        47 => "FatArrow",
        48 => "Eq",
        49 => "PlusEq",
        50 => "StarEq",
        51 => "SlashEq",
        52 => "PercentEq",
        53 => "MinusEq",
        54 => "Plus",
        55 => "Minus",
        56 => "Star",
        57 => "Slash",
        58 => "Percent",
        59 => "EqEq",
        60 => "Ne",
        61 => "Lt",
        62 => "Le",
        63 => "Gt",
        64 => "Ge",
        65 => "And",
        66 => "Or",
        67 => "Bang",
        68 => "Pipe",
        69 => "Error",
        70 => "Eof",
        71 => "Dollar",
        72 => "Tilde",
        73 => "PipeEq",
        74 => "AmpEq",
        75 => "DotDot",
        76 => "DotDotEq",
        77 => "Amp",
        78 => "Caret",
        79 => "Shl",
        80 => "Shr",
        _ => "Error",
    }
}
