// Keywords and contextual words, by spelling. `keyword` gives the token kind
// of a lower-case identifier (crates/vesper-syntax/src/lexer.rs `#[token]`
// rules); `lower_word` and `upper_word` give the parser's contextual-word
// number of an identifier token (0 for none), so the parser compares
// numbers instead of text (`Parser::at_word` and the name checks of
// crates/vesper-syntax/src/parser.rs).

use self::util::{
    add,
    byte
};

fn is(in b: Slice[u8], s: u64, in w: Slice[u8]) -> bool {
    for i in 0..w.len() {
        let c = match w.try_get(i) {
            Option::Some(c) => c,
            Option::None => 0,
        };
        if byte(in b, add(s, i)) != c {
            return false;
        }
    }
    true
}

pub fn w_use() -> u8 {
    1
}

pub fn w_model() -> u8 {
    2
}

pub fn w_pub() -> u8 {
    3
}

pub fn w_fip() -> u8 {
    4
}

pub fn w_trait() -> u8 {
    5
}

pub fn w_tiled() -> u8 {
    6
}

pub fn w_wire() -> u8 {
    7
}

pub fn w_for() -> u8 {
    8
}

pub fn w_where() -> u8 {
    9
}

pub fn w_as() -> u8 {
    10
}

pub fn w_type() -> u8 {
    11
}

pub fn w_dim() -> u8 {
    12
}

pub fn w_dyn() -> u8 {
    13
}

pub fn w_hot() -> u8 {
    14
}

pub fn w_cold() -> u8 {
    15
}

pub fn w_mut() -> u8 {
    16
}

pub fn w_region() -> u8 {
    17
}

pub fn w_loop() -> u8 {
    18
}

pub fn w_break() -> u8 {
    19
}

pub fn w_continue() -> u8 {
    20
}

pub fn w_underscore() -> u8 {
    21
}

pub fn w_load_tile_vec() -> u8 {
    22
}

pub fn w_col_get() -> u8 {
    23
}

pub fn w_col_set() -> u8 {
    24
}

pub fn w_super() -> u8 {
    25
}

pub fn w_const() -> u8 {
    26
}

pub fn w_test() -> u8 {
    27
}

pub fn w_test_case() -> u8 {
    28
}

pub fn w_TiledSeq() -> u8 {
    50
}

// Builtin scalar names (`is_scalar_name` without `Unit` and `Never`):
// 30..=42, and 43 `u128` and 44 `i128`.
pub fn is_primitive_word(w: u8) -> bool {
    w >= 30 && w <= 44
}

// The kind of the lower-case identifier `b[s..s + n]` whose first bytes
// are the word `w` (`word_at`): a keyword or Lower (4).
pub fn keyword(n: u64, w: u64) -> u8 {
    if n <= 6 {
        keyword_word(w)
    } else {
        4
    }
}

// The contextual word of the Lower token `b[s..s + n]` whose first bytes
// are the word `w`.
pub fn lower_word(in b: Slice[u8], s: u64, n: u64, w: u64) -> u8 {
    if n <= 8 {
        lower_word_of(w)
    } else if n == 9 && is(in b, s, in "test_case".as_bytes()) {
        28
    } else if n == 13 && is(in b, s, in "load_tile_vec".as_bytes()) {
        22
    } else {
        0
    }
}

// The contextual word of the Upper token `b[s..s + n]` whose first bytes
// are the word `w`.
pub fn upper_word(n: u64, w: u64) -> u8 {
    if n == 8 {
        upper_word_of(w)
    } else {
        0
    }
}

// Keywords by a perfect hash of their word: slot `(w * 16476191191221802671) >> 59` holds
// the keyword's word (bits 0-55) and kind (bits 56-63), or 0.
const KEYWORDS: [u64; 32] = [
    // copy
    1008806318568402787,
    // handle
    1657436179088171368,
    // inout
    1441152380945002089,
    0,
    0,
    // eff
    1297036692689413733,
    // match
    1945555487369224557,
    // true
    2161727822840033908,
    0,
    0,
    0,
    // impl
    792633536236514665,
    // if
    2017612633062008425,
    // state
    1729382692654511219,
    // let
    936748722500691308,
    // effect
    720703910631073381,
    // affine
    1080975435458045537,
    // else
    2089670228801973349,
    0,
    // in
    1369094286720659049,
    // with
    1801439852700658039,
    // return
    1873618882862015858,
    // sink
    1513209476598884723,
    // self
    1585267070552794483,
    0,
    // linear
    1153047267245975916,
    // mod
    1224979098651357037,
    0,
    // false
    2233785850903945574,
    // struct
    576588722824442995,
    // fn
    864691128455163494,
    // enum
    648518348177763941,
];

// The kind of a lower-case identifier of at most six bytes whose bytes
// are the little-endian word `w` (`word_at`): a keyword or Lower (4).
pub fn keyword_word(w: u64) -> u8 {
    let e = KEYWORDS[(wrapping_mul(w, 16476191191221802671) >> 59) & 31];
    if (e & 72057594037927935) == w {
        wrapping_u8(e >> 56)
    } else {
        4
    }
}

// The contextual word of a Lower token of at most eight bytes, by word.
pub fn lower_word_of(w: u64) -> u8 {
    match w {
        // _
        95 => 21,
        // i8
        14441 => 35,
        // u8
        14453 => 30,
        // as
        29537 => 10,
        // f32
        3289958 => 40,
        // i32
        3289961 => 37,
        // u32
        3289973 => 32,
        // f64
        3421798 => 41,
        // i64
        3421801 => 38,
        // u64
        3421813 => 33,
        // i16
        3551593 => 36,
        // u16
        3551605 => 31,
        // pub
        6452592 => 3,
        // use
        6648693 => 1,
        // dim
        7170404 => 12,
        // dyn
        7240036 => 13,
        // fip
        7367014 => 4,
        // for
        7499622 => 8,
        // hot
        7630696 => 14,
        // mut
        7632237 => 16,
        // i128
        942813545 => 44,
        // u128
        942813557 => 43,
        // cold
        1684828003 => 15,
        // type
        1701869940 => 11,
        // wire
        1701996919 => 7,
        // bool
        1819242338 => 42,
        // loop
        1886351212 => 18,
        // test
        1953719668 => 27,
        // tiled
        431198333300 => 6,
        // where
        435710945399 => 9,
        // isize
        435845428073 => 39,
        // usize
        435845428085 => 34,
        // break
        461195539042 => 19,
        // model
        465557548909 => 2,
        // super
        491328140659 => 25,
        // trait
        499984200308 => 5,
        // const
        500152823651 => 26,
        // region
        121424788809074 => 17,
        // col_get
        32762591955414883 => 23,
        // col_set
        32762643495022435 => 24,
        // continue
        7310870969309884259 => 20,
        _ => 0,
    }
}

// The contextual word of an Upper token of at most eight bytes, by word.
pub fn upper_word_of(w: u64) -> u8 {
    match w {
        // TiledSeq
        8171028789597071700 => 50,
        _ => 0,
    }
}
