// Stage 2 expression type-checker: populates `World.expr_types` (sorted by
// `(start, end)`) for `@vesper/place-ir-lower::ast::Ast` using
// `@vesper/check-data` and `@vesper/check-core-typing`.

use @vesper/wasm-backend::tables::{stage2_heap_mark, stage2_heap_reset, stage2_heap_swap};
use @vesper/check-core-typing::relations::{infer};
use @vesper/check-data::input::{Ctx};
use @vesper/check-data::names::{Names, names_new};
use @vesper/check-data::types::{
    EffNode, TyKind, TyMode, TyPass, Types, Vars, types_new, default_type, substitute,
    substitute_row, vars_new
};
use @vesper/check-data::util::{n32, u32_at, u64_at, w};
use @vesper/check-data::world::{
    Known, SpanRow, World, bounds_new, constructor, field_step, mode_of, world_new
};
use @vesper/place-ir::codes::{Lit, Pat};
use @vesper/wasm-backend::ir::{CallRow, Pair};
use @vesper/place-ir-lower::ast::{Ast, Ef, Eop, Ex, FnR, Hd, Pm, Pt};
use self::facts::{loop_breaks, loop_never_breaks, loop_plain_breaks};
use self::sugar_policy::{
    POLICY_BAD_METADATA, POLICY_OK, PolicyFailure, PolicyInputs, PolicySpan, caller_supplied,
    captured_value_fault, contains, diagnose_policy_fault, effect_failure, empty_inputs,
    failure_row, has_policy_at, primitive_failure, resolved_place_failure, resolved_span
};

const NONE32: u32 = 4294967295;
const NONE64: u64 = 18446744073709551615;

const X_LITERAL: u8 = 1;
const X_NAME: u8 = 2;
const X_TUPLE: u8 = 3;
const X_STRUCT: u8 = 4;
const X_FIELD: u8 = 5;
const X_INDEX: u8 = 6;
const X_UNARY: u8 = 7;
const X_BINARY: u8 = 8;
const X_ASSIGN: u8 = 9;
const X_BLOCK: u8 = 10;
const X_CALL: u8 = 11;
const X_TRY: u8 = 12;
const X_IF: u8 = 13;
const X_MATCH: u8 = 14;
const X_LOOP: u8 = 15;
const X_FOR: u8 = 16;
const X_RANGE: u8 = 17;
const X_BREAK: u8 = 18;
const X_CONTINUE: u8 = 19;
const X_RETURN: u8 = 20;
const X_HANDLE: u8 = 22;

copy struct Binding {
    name: u32,
    ty: u32,
    pass: u8,
    // The pattern of an open binding (a literal-initialized `let` or a
    // `for` over a literal range, typed from its uses as in
    // src/integer_widths/literal_typing.rs), or NONE64.
    open: u64,
}

// One kind a use of an open binding settled to, or the hint it gives.
copy struct LitUse {
    pid: u64,
    ty: u32,
}

// How many probe runs may refine the hints (`PROBE_ROUNDS`).
const LITERAL_PROBE_ROUNDS: u64 = 4;
// The literal-typing rows reserved before the functions are checked.
const LITERAL_RESERVE: u64 = 1024;

struct Tc {
    names: Names,
    types: Types,
    world: World,
    env: ChunkSeq[Binding],
    marks: ChunkSeq[u64],
    spans: ChunkSeq[SpanRow],
    infer_ty: u32,
    ret_ty: u32,
    unit_ty: u32,
    bool_ty: u32,
    i64_ty: u32,
    u64_ty: u32,
    f64_ty: u32,
    str_ty: u32,
    never_ty: u32,
    calls: ChunkSeq[CallRow],
    pairs: ChunkSeq[Pair],
    scratch1: ChunkSeq[u32],
    sugar: PolicyInputs,
    sugar_violation: u64,
    sugar_checked_calls: ChunkSeq[bool],
    sugar_ambient_row: u32,
    sugar_handler_row: u32,
    sugar_generic_start: u64,
    sugar_generic_count: u64,
    lit_open: ChunkSeq[u64],
    lit_uses: ChunkSeq[LitUse],
    lit_hints: ChunkSeq[LitUse],
    lit_probe: bool,
    lit_mismatch: bool,
    lit_peak: u64,
}

fn tc_new(sink names: Names, sink types: Types, sink world: World, sink sugar: PolicyInputs) -> Tc {
    let empty = ChunkSeq::new[u32]();
    let empty_p = ChunkSeq::new[u8]();
    let mut t = types;
    let infer_ty = t.mk_with(TyKind::Infer, 0, 0, in empty, in empty_p, 0, 0, 0);
    // Rust's `Type::unit()`, `Tuple([])`: the type of a block without a tail,
    // an `if` without `else`, assignments, loops and unit-valued methods.
    let unit_ty = t.unit;
    let bool_ty = t.named0(world.k.bool_);
    let i64_ty = t.named0(world.k.i64_);
    let u64_ty = t.named0(world.k.u64_);
    let f64_ty = t.named0(world.k.f64_);
    let str_ty = t.named0(world.k.str_);
    let never_ty = t.named0(world.k.never);
    let empty_row = t.empty_row;
    Tc {
        names: names,
        types: t,
        world: world,
        env: ChunkSeq::new[Binding](),
        marks: ChunkSeq::new[u64](),
        spans: ChunkSeq::new[SpanRow](),
        infer_ty: infer_ty,
        ret_ty: infer_ty,
        unit_ty: unit_ty,
        bool_ty: bool_ty,
        i64_ty: i64_ty,
        u64_ty: u64_ty,
        f64_ty: f64_ty,
        str_ty: str_ty,
        never_ty: never_ty,
        calls: ChunkSeq::new[CallRow](),
        pairs: ChunkSeq::new[Pair](),
        scratch1: ChunkSeq::new[u32](),
        sugar: sugar,
        sugar_violation: POLICY_OK,
        sugar_checked_calls: ChunkSeq::new[bool](),
        sugar_ambient_row: empty_row,
        sugar_handler_row: empty_row,
        sugar_generic_start: 0,
        sugar_generic_count: 0,
        lit_open: ChunkSeq::new[u64](),
        lit_uses: ChunkSeq::new[LitUse](),
        lit_hints: ChunkSeq::new[LitUse](),
        lit_probe: false,
        lit_mismatch: false,
        lit_peak: 0
    }
}

fn named1(inout tc: Tc, name: u32, a0: u32) -> u32 {
    tc.scratch1.clear();
    tc.scratch1.push(a0);
    tc.types.named(name, in tc.scratch1)
}

fn push_scope(inout tc: Tc) {
    tc.marks.push(tc.env.len());
}

fn pop_scope(inout tc: Tc) {
    if tc.marks.len() > 0 {
        let top = wrapping_sub(tc.marks.len(), 1);
        match tc.marks.try_get(top) {
            Option::Some(n) => tc.env.truncate(n),
            Option::None => {},
        }
        tc.marks.truncate(top);
    }
}

fn bind_var(inout tc: Tc, name: u32, ty: u32) {
    tc.env.push(Binding { name: name, ty: ty, pass: TyPass::Sink, open: NONE64 });
}

// The open pattern of the binding `name` reads, or NONE64.
fn open_pid(in tc: Tc, name: u32) -> u64 {
    let mut i = tc.env.len();
    loop {
        if i == 0 {
            break;
        }
        i = wrapping_sub(i, 1);
        match tc.env.try_get(i) {
            Option::Some(b) => {
                if b.name == name {
                    return b.open;
                }
            },
            Option::None => {},
        }
    }
    NONE64
}

// Marks the binding just bound by pattern `pid` open.
fn open_last(inout tc: Tc, pid: u64) {
    if tc.env.len() == 0 {
        return;
    }
    let top = wrapping_sub(tc.env.len(), 1);
    match tc.env.try_get(top) {
        Option::Some(b) => {
            let _ = tc.env
                .try_set(top, Binding { name: b.name, ty: b.ty, pass: b.pass, open: pid });
            tc.lit_open.push(pid);
        },
        Option::None => {},
    }
}

// The kind the hints give the open pattern `pid`, or NONE32.
fn lit_hint(in tc: Tc, pid: u64) -> u32 {
    for i in 0..tc.lit_hints.len() {
        match tc.lit_hints.try_get(i) {
            Option::Some(h) => {
                if h.pid == pid {
                    return h.ty;
                }
            },
            Option::None => {},
        }
    }
    NONE32
}

fn is_int_ty(in tc: Tc, ty: u32) -> bool {
    tc.types.kind(ty) == TyKind::Named && tc.world.k.is_integer(tc.types.name(ty))
}

// In a probe run, a use of an open binding that settled to `ty`.
fn note_lit_use(inout tc: Tc, pid: u64, ty: u32) {
    if is_int_ty(in tc, ty) && ty != tc.i64_ty {
        tc.lit_uses.push(LitUse { pid: pid, ty: ty });
    }
}

// Adds a hint for each open binding whose uses settled to exactly one kind
// other than the default (`settled_kinds`); whether any was added.
fn settle_lit_hints(inout tc: Tc) -> bool {
    let mut added = false;
    for i in 0..tc.lit_uses.len() {
        let u = match tc.lit_uses.try_get(i) {
            Option::Some(v) => v,
            Option::None => continue,
        };
        if lit_hint(in tc, u.pid) != NONE32 {
            continue;
        }
        let mut one = true;
        let mut first = true;
        for j in 0..tc.lit_uses.len() {
            match tc.lit_uses.try_get(j) {
                Option::Some(o) => {
                    if o.pid == u.pid {
                        if j < i {
                            first = false;
                        }
                        if o.ty != u.ty {
                            one = false;
                        }
                    }
                },
                Option::None => {},
            }
        }
        if one && first {
            tc.lit_hints.push(LitUse { pid: u.pid, ty: u.ty });
            added = true;
        }
    }
    added
}

fn lookup_var(in tc: Tc, name: u32) -> u32 {
    let mut i = tc.env.len();
    loop {
        if i == 0 {
            break;
        }
        i = wrapping_sub(i, 1);
        match tc.env.try_get(i) {
            Option::Some(b) => {
                if b.name == name {
                    return b.ty;
                }
            },
            Option::None => {},
        }
    }
    NONE32
}

fn find_fn(in a: Ast, name: u32) -> Option[FnR] {
    if w(name) < a.fn_by_key.len() {
        let idx = u32_at(in a.fn_by_key, w(name));
        if idx != 0 {
            return a.fns.try_get(wrapping_sub(w(idx), 1));
        }
    }
    Option::None
}

fn find_eop(in a: Ast, inout names: Names, cname: u32) -> Option[(Ef, Eop)] {
    let (ename, opname) = split_last_colon(inout names, cname);
    find_effect_method(in a, ename, opname)
}

fn find_effect_method(in a: Ast, ename: u32, opname: u32) -> Option[(Ef, Eop)] {
    if ename == NONE32 || w(ename) >= a.eff_by_name.len() {
        return Option::None;
    }
    let idx = u32_at(in a.eff_by_name, w(ename));
    if idx == 0 {
        return Option::None;
    }
    match a.effs.try_get(wrapping_sub(w(idx), 1)) {
        Option::Some(ef) => {
            for oi in 0..ef.op_count {
                match a.eops.try_get(wrapping_add(ef.op_start, oi)) {
                    Option::Some(op) => {
                        if op.name == opname {
                            return Option::Some((ef, op));
                        }
                    },
                    Option::None => {},
                }
            }
            Option::None
        },
        Option::None => Option::None,
    }
}

fn record_span(inout tc: Tc, s0: u64, s1: u64, ty: u32) {
    if s0 == 0 && s1 == 0 {
        return;
    }
    let dt = default_type(inout tc.types, ty);
    tc.spans.push(SpanRow { start: s0, end: s1, ty: dt });
}

fn split_last_colon(inout names: Names, sym: u32) -> (u32, u32) {
    let n = names.size(sym);
    let mut split: u64 = NONE64;
    let mut i: u64 = 0;
    loop {
        if wrapping_add(i, 1) >= n {
            break;
        }
        if names.byte(sym, i) == 58 && names.byte(sym, wrapping_add(i, 1)) == 58 {
            split = i;
        }
        i = wrapping_add(i, 1);
    }
    if split == NONE64 {
        return (NONE32, sym);
    }
    let mut qb = ChunkSeq::new[u8]();
    qb.reserve(split);
    for k in 0..split {
        qb.push(names.byte(sym, k));
    }
    let mut sb = ChunkSeq::new[u8]();
    let s0 = wrapping_add(split, 2);
    sb.reserve(wrapping_sub(n, s0));
    for k in s0..n {
        sb.push(names.byte(sym, k));
    }
    (names.intern(in qb.as_slice()), names.intern(in sb.as_slice()))
}

fn ctor_info(inout tc: Tc, cname: u32, dt: u32) -> (u32, u64, Vars) {
    let (q_from_name, short) = split_last_colon(inout tc.names, cname);
    let qual = if q_from_name != NONE32 {
        q_from_name
    } else if tc.types.kind(dt) == TyKind::Named {
        tc.types.name(dt)
    } else {
        NONE32
    };
    let mut res = constructor(in tc.world, qual, short);
    if res == NONE64 && qual != NONE32 {
        res = constructor(in tc.world, NONE32, short);
    }
    if res == NONE64 {
        return (NONE32, 0, vars_new());
    }
    let mut vars = vars_new();
    let adt = n32(wrapping_shr_u64(res, 32));
    let vi = res & 4294967295;
    let a = tc.world.adt(adt);
    if tc.types.kind(dt) == TyKind::Named && tc.types.name(dt) == a.name {
        let ar = tc.types.arity(dt);
        for gi in 0..w(a.gn) {
            if gi < ar {
                let gn = tc.world.generic(wrapping_add(w(a.ga), gi));
                vars.set(gn.name, tc.types.arg(dt, gi));
            }
        }
    }
    (adt, vi, vars)
}

fn bind_pat(inout tc: Tc, in a: Ast, pid: u64, ty: u32) {
    let p = match a.pts.try_get(pid) {
        Option::Some(v) => v,
        Option::None => return,
    };
    if p.kind == Pat::Bind {
        // The binding's type, for the linearity pass (linear.ves).
        record_span(inout tc, p.s0, p.s1, ty);
        bind_var(inout tc, n32(p.a), ty);
        return;
    }
    if p.kind == Pat::Tuple {
        let dt = default_type(inout tc.types, ty);
        for i in 0..p.n {
            let sub = u64_at(in a.pxs, wrapping_add(p.b, i));
            let et = if tc.types.kind(dt) == TyKind::Tuple && i < tc.types.arity(dt) {
                tc.types.arg(dt, i)
            } else {
                tc.infer_ty
            };
            bind_pat(inout tc, in a, sub, et);
        }
        return;
    }
    if p.kind == Pat::Constructor {
        let dt = default_type(inout tc.types, ty);
        let (adt, vi, vars) = ctor_info(inout tc, n32(p.a), dt);
        if adt != NONE32 {
            let v = tc.world.variant(vi);
            for i in 0..p.n {
                let fnm = n32(u64_at(in a.pxs, wrapping_add(p.b, wrapping_mul(i, 2))));
                let sub = u64_at(in a.pxs, wrapping_add(p.b, wrapping_add(wrapping_mul(i, 2), 1)));
                let mut fty = tc.infer_ty;
                for fj in 0..w(v.fc) {
                    let f = tc.world.field(wrapping_add(w(v.fa), fj));
                    if (p.c != 0 && f.name == fnm) || (p.c == 0 && fj == i) {
                        fty = substitute(inout tc.types, f.ty, in vars);
                        break;
                    }
                }
                bind_pat(inout tc, in a, sub, fty);
            }
        }
    }
}

fn is_op(in tc: Tc, sym: u32, in lit: Str) -> bool {
    let b = lit.as_bytes();
    if tc.names.size(sym) != b.len() {
        return false;
    }
    for i in 0..b.len() {
        let c = match b.try_get(i) {
            Option::Some(v) => v,
            Option::None => 0,
        };
        if tc.names.byte(sym, i) != c {
            return false;
        }
    }
    true
}

fn sym_slice_eq(in names: Names, sym: u32, start: u64, in lit: Str) -> bool {
    let b = lit.as_bytes();
    let n = names.size(sym);
    if start > n || wrapping_sub(n, start) != b.len() {
        return false;
    }
    for i in 0..b.len() {
        let c = match b.try_get(i) {
            Option::Some(v) => v,
            Option::None => 0,
        };
        if names.byte(sym, wrapping_add(start, i)) != c {
            return false;
        }
    }
    true
}

fn conv_prefix_len(in names: Names, sym: u32) -> u64 {
    if names.has_prefix(sym, in "widen_".as_bytes()) {
        6
    } else if names.has_prefix(sym, in "narrow_".as_bytes()) {
        7
    } else if names.has_prefix(sym, in "wrapping_".as_bytes()) {
        9
    } else if names.has_prefix(sym, in NEAREST_PREFIX.as_bytes()) {
        NEAREST_PREFIX_LEN
    } else {
        0
    }
}

// The float conversions and bit reinterpretations (#2375): `nearest_<f>`
// rounds to the float kind `f`, `to_bits_<f>` gives `f`'s bits and
// `from_bits_<f>` reads them.
const NEAREST_PREFIX: Str = "nearest_";
const NEAREST_PREFIX_LEN: u64 = 8;

// The operand type of `to_bits_<f>` (`f`) or `from_bits_<f>` (`f`'s bits),
// or `NONE32`: an unsuffixed literal operand takes it (`bits_call`).
fn bits_operand_type(inout tc: Tc, sym: u32) -> u32 {
    let k = tc.world.k;
    let ksym = if is_op(in tc, sym, in "to_bits_f32") {
        k.f32_
    } else if is_op(in tc, sym, in "to_bits_f64") {
        k.f64_
    } else if is_op(in tc, sym, in "from_bits_f32") {
        k.u32_
    } else if is_op(in tc, sym, in "from_bits_f64") {
        k.u64_
    } else {
        return NONE32;
    };
    tc.types.named0(ksym)
}

// The result type of `to_bits_<f>` or `from_bits_<f>`, or `NONE32`.
fn bits_target_type(inout tc: Tc, sym: u32) -> u32 {
    let k = tc.world.k;
    let ksym = if is_op(in tc, sym, in "to_bits_f32") {
        k.u32_
    } else if is_op(in tc, sym, in "to_bits_f64") {
        k.u64_
    } else if is_op(in tc, sym, in "from_bits_f32") {
        k.f32_
    } else if is_op(in tc, sym, in "from_bits_f64") {
        k.f64_
    } else {
        return NONE32;
    };
    tc.types.named0(ksym)
}

/// Returns the target scalar type for `widen_*`, `narrow_*`, or `wrapping_<int_kind>`,
/// or `NONE32` if `sym` is not an integer-width conversion builtin.
fn conv_target_type(inout tc: Tc, sym: u32) -> u32 {
    let bits_ty = bits_target_type(inout tc, sym);
    if bits_ty != NONE32 {
        return bits_ty;
    }
    let off = conv_prefix_len(in tc.names, sym);
    if off == 0 {
        return NONE32;
    }
    let k = tc.world.k;
    let ks = sym_slice_eq(in tc.names, sym, off, in "u64");
    if ks {
        return tc.u64_ty;
    }
    if sym_slice_eq(in tc.names, sym, off, in "i64") {
        return tc.i64_ty;
    }
    let ksym = if sym_slice_eq(in tc.names, sym, off, in "u8") {
        k.u8_
    } else if sym_slice_eq(in tc.names, sym, off, in "u16") {
        k.u16_
    } else if sym_slice_eq(in tc.names, sym, off, in "u32") {
        k.u32_
    } else if sym_slice_eq(in tc.names, sym, off, in "usize") {
        k.usize_
    } else if sym_slice_eq(in tc.names, sym, off, in "u128") {
        k.u128_
    } else if sym_slice_eq(in tc.names, sym, off, in "i8") {
        k.i8_
    } else if sym_slice_eq(in tc.names, sym, off, in "i16") {
        k.i16_
    } else if sym_slice_eq(in tc.names, sym, off, in "i32") {
        k.i32_
    } else if sym_slice_eq(in tc.names, sym, off, in "isize") {
        k.isize_
    } else if sym_slice_eq(in tc.names, sym, off, in "i128") {
        k.i128_
    } else if sym_slice_eq(in tc.names, sym, off, in "f32") {
        k.f32_
    } else if sym_slice_eq(in tc.names, sym, off, in "f64") {
        k.f64_
    } else {
        NONE32
    };
    if ksym != NONE32 {
        tc.types.named0(ksym)
    } else {
        NONE32
    }
}

fn is_same_int_op(in tc: Tc, sym: u32) -> bool {
    is_op(in tc, sym, in "wrapping_add")
        || is_op(in tc, sym, in "wrapping_sub")
        || is_op(in tc, sym, in "wrapping_mul")
        || is_op(in tc, sym, in "wrapping_div")
        || is_op(in tc, sym, in "wrapping_rem")
        || is_op(in tc, sym, in "wrapping_shl_u64")
        || is_op(in tc, sym, in "wrapping_shr_u64")
        || is_op(in tc, sym, in "shr")
        || is_op(in tc, sym, in "shl")
        || is_op(in tc, sym, in "rotate_left")
        || is_op(in tc, sym, in "rotate_right")
        || is_op(in tc, sym, in "inc")
        || is_op(in tc, sym, in "dec")
        || is_op(in tc, sym, in "add")
        || is_op(in tc, sym, in "sub")
        || is_op(in tc, sym, in "mul")
        || is_op(in tc, sym, in "div")
        || is_op(in tc, sym, in "rem")
        || is_op(in tc, sym, in "min_u64")
        || is_op(in tc, sym, in "max_u64")
        || is_op(in tc, sym, in "bit_and")
        || is_op(in tc, sym, in "bit_or")
        || is_op(in tc, sym, in "bit_xor")
        || is_op(in tc, sym, in "bit_shl")
        || is_op(in tc, sym, in "bit_shr")
}

fn join_method_sym(inout names: Names, tname: u32, mname: u32) -> u32 {
    let mut buf = ChunkSeq::new[u8]();
    buf.reserve(wrapping_add(wrapping_add(names.size(tname), names.size(mname)), 2));
    for i in 0..names.size(tname) {
        buf.push(names.byte(tname, i));
    }
    buf.push(58);
    buf.push(58);
    for i in 0..names.size(mname) {
        buf.push(names.byte(mname, i));
    }
    names.intern(in buf.as_slice())
}

fn sugar_operation_span(inout tc: Tc, e: Ex) -> Option[PolicySpan] {
    match resolved_span(in tc.sugar, e.s0, e.s1) {
        Option::Some(span) => Option::Some(span),
        Option::None => {
            if has_policy_at(in tc.sugar, e.s0) || has_policy_at(in tc.sugar, e.s1) {
                // A malformed span cannot establish that the operation was
                // outside its expansion or inside a caller hole.
                note_sugar_violation(inout tc, POLICY_BAD_METADATA);
            }
            Option::None
        },
    }
}

fn sugar_applies(inout tc: Tc, e: Ex) -> bool {
    if tc.sugar.policies.regions.len() == 0 {
        return false;
    }
    let operation = match sugar_operation_span(inout tc, e) {
        Option::Some(span) => span,
        Option::None => return false,
    };
    for i in 0..tc.sugar.policies.regions.len() {
        match tc.sugar.policies.regions.try_get(i) {
            Option::Some(region) => {
                if contains(region.span, operation)
                    && !caller_supplied(in tc.sugar.policies, region, operation)
                {
                    return true;
                }
            },
            Option::None => {},
        }
    }
    false
}

// An unnamed operation with no explicit type arguments takes its
// instance from the innermost matching handler, then the function row.
fn effect_with_name(in types: Types, row: u32, name: u32) -> Option[EffNode] {
    let effects = types.row(row);
    let mut i = w(effects.n);
    loop {
        if i == 0 {
            break;
        }
        i = wrapping_sub(i, 1);
        let effect = types.effect_at(wrapping_add(w(effects.a), i));
        if effect.name == name {
            return Option::Some(effect);
        }
    }
    Option::None
}

fn effect_with_label(in types: Types, row: u32, label: u32) -> Option[EffNode] {
    let effects = types.row(row);
    let mut i = w(effects.n);
    loop {
        if i == 0 {
            break;
        }
        i = wrapping_sub(i, 1);
        let effect = types.effect_at(wrapping_add(w(effects.a), i));
        if effect.label == label {
            return Option::Some(effect);
        }
    }
    Option::None
}

fn contextual_effect(in tc: Tc, name: u32) -> Option[EffNode] {
    match effect_with_name(in tc.types, tc.sugar_handler_row, name) {
        Option::Some(effect) => Option::Some(effect),
        Option::None => effect_with_name(in tc.types, tc.sugar_ambient_row, name),
    }
}

fn push_effect_args(in types: Types, effect: EffNode, inout args: ChunkSeq[u32]) {
    for i in 0..w(effect.n) {
        args.push(u32_at(in types.items, wrapping_add(w(effect.a), i)));
    }
}

// Only the handled body has the new capability in scope. A row id is
// restored on exit so there is no separately allocated lexical stack.
fn policy_handler_row(inout tc: Tc, in a: Ast, handler: Hd) -> u32 {
    let previous = tc.sugar_handler_row;
    if tc.sugar.policies.regions.len() == 0 {
        return previous;
    }
    let row = tc.types.row(previous);
    let mut effects = ChunkSeq::new[EffNode]();
    let mut args = ChunkSeq::new[u32]();
    for i in 0..w(row.n) {
        let effect = tc.types.effect_at(wrapping_add(w(row.a), i));
        let start = n32(args.len());
        push_effect_args(in tc.types, effect, inout args);
        effects.push(EffNode { label: effect.label, name: effect.name, a: start, n: effect.n });
    }
    let start = n32(args.len());
    for i in 0..handler.arg_ty_count {
        args.push(n32(u64_at(in a.xs, wrapping_add(handler.arg_ty_start, i))));
    }
    effects.push(EffNode {
        label: handler.label,
        name: handler.eff_name,
        a: start,
        n: n32(handler.arg_ty_count)
    });
    tc.types.mk_row(in effects, in args, 0)
}

fn check_sugar_effect_operation(
    inout tc: Tc,
    in a: Ast,
    ef: Ef,
    op: Eop,
    e: Ex,
    ce: Ex,
    context: Option[EffNode],
    label: u32
) -> u32 {
    check_sugar_call_access(inout tc, in a, op.param_start, op.param_count, false, e, ce);
    let mut generics = ChunkSeq::new[u32]();
    let mut inferred = vars_new();
    for i in 0..ef.generic_count {
        let name = a.egen(wrapping_add(ef.generic_start, i));
        generics.push(name);
        if i < e.m {
            inferred.set(name, n32(u64_at(in a.xs, wrapping_add(e.c, i))));
        } else {
            match context {
                Option::Some(effect) => {
                    if i < w(effect.n) {
                        inferred.set(name, u32_at(in tc.types.items, wrapping_add(w(effect.a), i)));
                    }
                },
                Option::None => {},
            }
        }
    }
    for i in 0..e.n {
        let param = if i < op.param_count {
            a.param(wrapping_add(op.param_start, i)).ty
        } else {
            tc.infer_ty
        };
        let wanted = substitute(inout tc.types, param, in inferred);
        let actual = check_expr(inout tc, in a, call_arg_expr(in a, e, i), wanted);
        infer(inout tc.types, tc.world.k, param, actual, in generics, inout inferred);
    }
    let mut args = ChunkSeq::new[u32]();
    for i in 0..generics.len() {
        let ty = inferred.get(u32_at(in generics, i));
        args.push(
            if ty == NONE32 {
                tc.infer_ty
            } else {
                default_type(inout tc.types, ty)
            }
        );
    }
    let mut effects = ChunkSeq::new[EffNode]();
    effects.push(EffNode { label: label, name: ef.name, a: 0, n: n32(args.len()) });
    let row = tc.types.mk_row(in effects, in args, 0);
    check_sugar_call_row(inout tc, e, row);
    let result = substitute(inout tc.types, op.result, in inferred);
    record_span(inout tc, ce.s0, ce.s1, result);
    record_span(inout tc, e.s0, e.s1, result);
    result
}

fn check_direct_effect(inout tc: Tc, in a: Ast, ef: Ef, op: Eop, e: Ex, ce: Ex) -> u32 {
    let context = if e.m == 0 {
        contextual_effect(in tc, ef.name)
    } else {
        Option::None
    };
    check_sugar_effect_operation(inout tc, in a, ef, op, e, ce, context, 0)
}

fn check_labeled_sugar_effect(inout tc: Tc, in a: Ast, e: Ex, ce: Ex) -> Option[u32] {
    let receiver = a.ex(ce.a);
    if receiver.kind != X_NAME
        || lookup_var(in tc, n32(receiver.a)) != NONE32
        || !sugar_applies(inout tc, e)
    {
        return Option::None;
    }
    let label = wrapping_add(n32(receiver.a), 1);
    let active = effect_with_label(in tc.types, tc.sugar_handler_row, label);
    let (effect, handled) = match active {
        Option::Some(effect) => (effect, true),
        Option::None => match effect_with_label(in tc.types, tc.sugar_ambient_row, label) {
            Option::Some(effect) => (effect, false),
            Option::None => return Option::None,
        },
    };
    let (ef, op) = match find_effect_method(in a, effect.name, n32(ce.b)) {
        Option::Some(operation) => operation,
        Option::None => return Option::None,
    };
    // An active handler's lexical alias names a fresh capability, not a
    // user-spellable label. Its nominal effect can still be authorized
    // by an unlabeled declaration. This marker is only used in the audit.
    let actual_label = if handled {
        wrapping_add(tc.names.intern(in "$stage2_handled_cap".as_bytes()), 1)
    } else {
        label
    };
    Option::Some(check_sugar_effect_operation(
        inout tc,
        in a,
        ef,
        op,
        e,
        ce,
        Option::Some(effect),
        actual_label
    ))
}

// These lexically resolved primitives do not have package signatures.
fn check_sugar_named_sequence(inout tc: Tc, in a: Ast, e: Ex, ce: Ex) -> Option[u32] {
    let name = n32(ce.a);
    if lookup_var(in tc, name) != NONE32 {
        return Option::None;
    }
    let swap = is_op(in tc, name, in "swap");
    let replace = is_op(in tc, name, in "replace");
    let finish = is_op(in tc, name, in "ChunkSeq::finish");
    if !(swap || replace || finish) {
        return Option::None;
    }
    let arguments: u64 = if finish { 1 } else { 2 };
    if e.n != arguments {
        note_sugar_violation(inout tc, POLICY_BAD_METADATA);
        return Option::Some(tc.infer_ty);
    }
    let site = sugar_operation_span(inout tc, e);
    let first = call_arg_expr(in a, e, 0);
    let first_ty = check_expr(inout tc, in a, first, tc.infer_ty);
    let first_pass = if finish { TyPass::Sink } else { TyPass::Inout };
    match site {
        Option::Some(site) => check_sugar_resolved_place(inout tc, in a, site, first, first_pass),
        Option::None => {},
    }
    if finish {
        let runtime = tc.names.intern(in "RuntimeError".as_bytes());
        let ty = tc.types.named0(runtime);
        let row = failure_row(inout tc.names, inout tc.types, ty);
        check_sugar_call_row(inout tc, e, row);
    } else {
        let second = call_arg_expr(in a, e, 1);
        let second_ty = check_expr(inout tc, in a, second, first_ty);
        let pass = if swap {
            TyPass::Inout
        } else {
            // replace takes the new value by value, not by an explicit
            // sink if it is known to be Copy.
            let bounds = bounds_new();
            if tc.types.kind(second_ty) != TyKind::Infer
                && mode_of(inout tc.types, in tc.names, in tc.world, second_ty, in bounds)
                    == TyMode::Copy
            {
                TyPass::In
            } else {
                TyPass::Sink
            }
        };
        match site {
            Option::Some(site) => check_sugar_resolved_place(inout tc, in a, site, second, pass),
            Option::None => {},
        }
    }
    let result = if replace { first_ty } else { tc.unit_ty };
    record_span(inout tc, ce.s0, ce.s1, result);
    record_span(inout tc, e.s0, e.s1, result);
    Option::Some(result)
}

fn note_sugar_violation(inout tc: Tc, violation: u64) {
    if tc.sugar_violation == POLICY_OK {
        tc.sugar_violation = violation;
    }
}

fn check_sugar_call_row(inout tc: Tc, e: Ex, actual: u32) {
    if tc.sugar.policies.regions.len() == 0 {
        return;
    }
    let site = match sugar_operation_span(inout tc, e) {
        Option::Some(site) => site,
        Option::None => return,
    };
    let denied = effect_failure(in tc.names, in tc.types, in tc.sugar, site, actual);
    note_sugar_violation(inout tc, denied);
}

fn check_sugar_resolved_place(inout tc: Tc, in a: Ast, site: PolicySpan, place: u64, mode: u8) {
    let denied = resolved_place_failure(in tc.sugar, in a, site, place, mode);
    note_sugar_violation(inout tc, denied);
}

fn check_sugar_call_access(
    inout tc: Tc,
    in a: Ast,
    param_start: u64,
    param_count: u64,
    recv: bool,
    e: Ex,
    ce: Ex
) {
    if tc.sugar.policies.regions.len() == 0 {
        return;
    }
    let site = match sugar_operation_span(inout tc, e) {
        Option::Some(site) => site,
        Option::None => return,
    };
    let offset: u64 = if recv { 1 } else { 0 };
    if recv {
        match a.pms.try_get(param_start) {
            Option::Some(pm) => check_sugar_resolved_place(inout tc, in a, site, ce.a, pm.pass),
            Option::None => {},
        }
    }
    for i in 0..e.n {
        let p = wrapping_add(i, offset);
        if p >= param_count {
            break;
        }
        match a.pms.try_get(wrapping_add(param_start, p)) {
            Option::Some(pm) => check_sugar_resolved_place(
                inout tc,
                in a,
                site,
                call_arg_expr(in a, e, i),
                pm.pass
            ),
            Option::None => {},
        }
    }
}

// A lexical callable is not a package-level function, but its resolved
// function type still specifies the actual row and parameter passes.
// A call of a local function value: the callee reads as the function and
// the call has its signature's result (`apply` of a value callee).
fn check_value_call(inout tc: Tc, in a: Ast, callable: u32, e: Ex) -> u32 {
    let signature = tc.types.node(callable);
    let _ct = check_expr(inout tc, in a, e.a, callable);
    for i in 0..e.n {
        let want = if i < w(signature.n) {
            tc.types.arg(callable, i)
        } else {
            tc.infer_ty
        };
        let _actual = check_expr(inout tc, in a, call_arg_expr(in a, e, i), want);
    }
    record_span(inout tc, e.s0, e.s1, signature.r);
    signature.r
}

fn check_sugar_value_call(inout tc: Tc, in a: Ast, callable: u32, e: Ex, ce: Ex) -> u32 {
    let signature = tc.types.node(callable);
    check_sugar_call_row(inout tc, e, signature.r2);
    let site = sugar_operation_span(inout tc, e);
    for i in 0..e.n {
        let arg = call_arg_expr(in a, e, i);
        let want = if i < w(signature.n) {
            let mode = tc.types.param_pass(callable, i);
            match site {
                Option::Some(site) => check_sugar_resolved_place(inout tc, in a, site, arg, mode),
                Option::None => {},
            }
            tc.types.arg(callable, i)
        } else {
            tc.infer_ty
        };
        let _actual = check_expr(inout tc, in a, arg, want);
    }
    record_span(inout tc, ce.s0, ce.s1, callable);
    record_span(inout tc, e.s0, e.s1, signature.r);
    signature.r
}

// Rust's `apply`: a generic callee's arguments are first inferred from the
// type its context expects of the result, then from its arguments.
fn check_fn_call(
    inout tc: Tc,
    in a: Ast,
    f: FnR,
    receiver_ty: u32,
    e: Ex,
    ce: Ex,
    expected: u32
) -> u32 {
    check_sugar_call_access(
        inout tc,
        in a,
        f.param_start,
        f.param_count,
        receiver_ty != NONE32,
        e,
        ce
    );
    if f.generic_count == 0 {
        check_sugar_call_row(inout tc, e, f.effects);
        let p_off: u64 = if receiver_ty != NONE32 { 1 } else { 0 };
        for ai in 0..e.n {
            let av = u64_at(in a.xs, wrapping_add(e.b, wrapping_add(wrapping_mul(ai, 2), 1)));
            let pi = wrapping_add(ai, p_off);
            let pt = if pi < f.param_count {
                match a.pms.try_get(wrapping_add(f.param_start, pi)) {
                    Option::Some(pm) => pm.ty,
                    Option::None => tc.infer_ty,
                }
            } else {
                tc.infer_ty
            };
            let _at = check_expr(inout tc, in a, av, pt);
            constrain_literals(inout tc, in a, av, pt);
        }
        record_span(inout tc, ce.s0, ce.s1, f.result);
        record_span(inout tc, e.s0, e.s1, f.result);
        return f.result;
    }
    let mut vars = vars_new();
    let mut gnames = ChunkSeq::new[u32]();
    for gi in 0..f.generic_count {
        match a.gens.try_get(wrapping_add(f.generic_start, gi)) {
            Option::Some(gn) => {
                gnames.push(gn.name);
                if gi < e.m {
                    let ta = n32(u64_at(in a.xs, wrapping_add(e.c, gi)));
                    vars.set(gn.name, ta);
                }
            },
            Option::None => {},
        }
    }
    if e.m == 0 && tc.types.kind(expected) != TyKind::Infer {
        infer(inout tc.types, tc.world.k, f.result, expected, in gnames, inout vars);
    }
    let has_recv = receiver_ty != NONE32;
    let mut p_off: u64 = 0;
    if has_recv && f.param_count > 0 {
        match a.pms.try_get(f.param_start) {
            Option::Some(pm0) => {
                if f.generic_count > 0 && e.m == 0 {
                    infer(inout tc.types, tc.world.k, pm0.ty, receiver_ty, in gnames, inout vars);
                }
            },
            Option::None => {},
        }
        p_off = 1;
    }
    for ai in 0..e.n {
        let av = u64_at(in a.xs, wrapping_add(e.b, wrapping_add(wrapping_mul(ai, 2), 1)));
        let pi = wrapping_add(ai, p_off);
        let mut pt = tc.infer_ty;
        if pi < f.param_count {
            match a.pms.try_get(wrapping_add(f.param_start, pi)) {
                Option::Some(pm) => {
                    pt = substitute(inout tc.types, pm.ty, in vars);
                    let at = check_expr(inout tc, in a, av, pt);
                    if f.generic_count > 0 && e.m == 0 {
                        infer(inout tc.types, tc.world.k, pm.ty, at, in gnames, inout vars);
                    }
                    let target = substitute(inout tc.types, pm.ty, in vars);
                    constrain_literals(inout tc, in a, av, target);
                },
                Option::None => {
                    let _at = check_expr(inout tc, in a, av, pt);
                },
            }
        } else {
            let _at = check_expr(inout tc, in a, av, pt);
        }
    }
    if f.generic_count > 0 {
        let v0 = tc.pairs.len();
        let mut vn: u64 = 0;
        for gi in 0..gnames.len() {
            let gn = u32_at(in gnames, gi);
            let vty = vars.get(gn);
            if vty != NONE32 {
                tc.pairs.push(Pair { name: gn, ty: vty });
                vn = wrapping_add(vn, 1);
            }
        }
        if vn > 0 {
            tc.calls.push(CallRow { s0: e.s0, s1: e.s1, v0: v0, vn: vn });
        }
    }
    if tc.sugar.policies.regions.len() != 0 {
        let call_row = substitute_row(inout tc.types, f.effects, in vars);
        check_sugar_call_row(inout tc, e, call_row);
    }
    let rty = substitute(inout tc.types, f.result, in vars);
    record_span(inout tc, ce.s0, ce.s1, rty);
    record_span(inout tc, e.s0, e.s1, rty);
    rty
}

const CALL_ARG_STRIDE: u64 = 2;

fn call_arg_expr(in a: Ast, e: Ex, ai: u64) -> u64 {
    u64_at(in a.xs, wrapping_add(e.b, wrapping_add(wrapping_mul(ai, CALL_ARG_STRIDE), 1)))
}

// Rust's `constrain_literals`: the integer literals of `eid` (through
// tuples) take their kinds from `target`, the type their context settled.
fn constrain_literals(inout tc: Tc, in a: Ast, eid: u64, target: u32) {
    let e = match a.exs.try_get(eid) {
        Option::Some(v) => v,
        Option::None => return,
    };
    if e.kind == X_TUPLE {
        let dt = default_type(inout tc.types, target);
        if tc.types.kind(dt) == TyKind::Tuple && tc.types.arity(dt) == e.n {
            for i in 0..e.n {
                let sub = u64_at(in a.xs, wrapping_add(e.a, i));
                constrain_literals(inout tc, in a, sub, tc.types.arg(dt, i));
            }
        }
    } else if is_int_ty(in tc, target)
        && !tc.lit_probe
        && e.kind == X_LITERAL
        && (e.a == Lit::Int || e.a == Lit::WideInt)
    {
        retype_span(inout tc, e.s0, e.s1, target);
    }
}

// Replaces the type recorded last at `s0..s1`.
fn retype_span(inout tc: Tc, s0: u64, s1: u64, ty: u32) {
    let mut i = tc.spans.len();
    loop {
        if i == 0 {
            return;
        }
        i = wrapping_sub(i, 1);
        match tc.spans.try_get(i) {
            Option::Some(r) => {
                if r.start == s0 && r.end == s1 {
                    let _ = tc.spans.try_set(i, SpanRow { start: s0, end: s1, ty: ty });
                    return;
                }
            },
            Option::None => return,
        }
    }
}

// Whether `e` assigns a whole open binding in a probe run.
fn assigns_open(in tc: Tc, in a: Ast, e: Ex) -> bool {
    if !tc.lit_probe || tc.names.has_prefix(n32(e.a), in "[]".as_bytes()) {
        return false;
    }
    match a.exs.try_get(e.b) {
        Option::Some(t) => t.kind == X_NAME && open_pid(in tc, n32(t.a)) != NONE64,
        Option::None => false,
    }
}

fn is_int_lit_expr(in tc: Tc, in a: Ast, eid: u64) -> bool {
    match a.exs.try_get(eid) {
        Option::Some(ex) => {
            if ex.kind == X_LITERAL {
                ex.a == Lit::Int || ex.a == Lit::WideInt
            } else if ex.kind == X_UNARY && is_op(in tc, n32(ex.a), in "-") {
                is_int_lit_expr(in tc, in a, ex.b)
            } else if ex.kind == X_NAME {
                // In a probe run an open binding reads as a literal.
                tc.lit_probe && open_pid(in tc, n32(ex.a)) != NONE64
            } else {
                false
            }
        },
        Option::None => false,
    }
}

// Whether `eid` is an integer literal tree or a (negated) float literal:
// on the left of a binary operator it takes the right operand's type, so
// `0.5 == x` compares as `x`'s float kind.
fn is_num_lit_expr(in tc: Tc, in a: Ast, eid: u64) -> bool {
    if is_int_lit_expr(in tc, in a, eid) {
        return true;
    }
    match a.exs.try_get(eid) {
        Option::Some(ex) => {
            if ex.kind == X_LITERAL {
                ex.a == Lit::Float
            } else if ex.kind == X_UNARY && is_op(in tc, n32(ex.a), in "-") {
                is_num_lit_expr(in tc, in a, ex.b)
            } else {
                false
            }
        },
        Option::None => false,
    }
}

fn check_sugar_try(inout tc: Tc, in a: Ast, e: Ex, expected: u32) -> u32 {
    let result = tc.names.intern(in "Result".as_bytes());
    let target = if tc.types.kind(expected) == TyKind::Infer {
        tc.infer_ty
    } else {
        let mut args = ChunkSeq::new[u32]();
        args.push(expected);
        args.push(tc.infer_ty);
        tc.types.named(result, in args)
    };
    let operand = check_owned_expr(inout tc, in a, e.a, target);
    let name = tc.types.name(operand);
    let argc = tc.types.arity(operand);
    if name == result && argc == 2 {
        let err = tc.types.arg(operand, 1);
        let actual = failure_row(inout tc.names, inout tc.types, err);
        check_sugar_call_row(inout tc, e, actual);
        let ok = tc.types.arg(operand, 0);
        if tc.types.kind(ok) == TyKind::Infer {
            tc.unit_ty
        } else {
            ok
        }
    } else if argc == 1
        && tc.names.spells(name, in "Option".as_bytes())
        && tc.names.spells(tc.types.name(tc.ret_ty), in "Option".as_bytes())
    {
        // Option propagation returns to the enclosing function; only
        // Result propagation performs a Fail effect.
        tc.types.arg(operand, 0)
    } else {
        note_sugar_violation(inout tc, POLICY_BAD_METADATA);
        expected
    }
}

fn certify_sugar_call(inout tc: Tc, id: u64) {
    if id < tc.sugar_checked_calls.len() {
        let _ = tc.sugar_checked_calls.try_set(id, true);
    }
}

fn total_named_builtin(in tc: Tc, name: u32, conv: u32, argc: u64) -> bool {
    if argc == 0 {
        return is_op(in tc, name, in "ChunkSeq::new") || is_op(in tc, name, in "String::new");
    }
    if argc == 1 {
        return conv != NONE32
            || is_op(in tc, name, in "inc32")
            || is_op(in tc, name, in "ChunkSeq::with_capacity")
            || is_op(in tc, name, in "String::from_utf8");
    }
    if argc != 2 {
        return false;
    }
    is_op(in tc, name, in "wrapping_add")
        || is_op(in tc, name, in "wrapping_sub")
        || is_op(in tc, name, in "wrapping_mul")
        || is_op(in tc, name, in "wrapping_shl_u64")
        || is_op(in tc, name, in "wrapping_shr_u64")
        || is_op(in tc, name, in "wrapping_shl")
        || is_op(in tc, name, in "wrapping_shr")
        || is_op(in tc, name, in "rotate_left")
        || is_op(in tc, name, in "rotate_right")
        || is_op(in tc, name, in "min_u64")
        || is_op(in tc, name, in "max_u64")
        || is_op(in tc, name, in "bit_and")
        || is_op(in tc, name, in "bit_or")
        || is_op(in tc, name, in "bit_xor")
        || is_op(in tc, name, in "bit_shl")
        || is_op(in tc, name, in "bit_shr")
}

// Where the syntax consumes a value, a captured Copy value is a read
// and a non-Copy value is a sink. The call/sequence paths separately
// choose their resolved borrow modes and must not use this wrapper.
fn check_owned_expr(inout tc: Tc, in a: Ast, id: u64, expected: u32) -> u32 {
    let ty = check_expr(inout tc, in a, id, expected);
    check_value_place(inout tc, in a, id, ty, true);
    ty
}

fn check_value_place(inout tc: Tc, in a: Ast, id: u64, ty: u32, owned: bool) {
    if tc.sugar.policies.regions.len() == 0 || id == NONE64 {
        return;
    }
    let e = a.ex(id);
    if e.kind != X_NAME && e.kind != X_FIELD && e.kind != X_INDEX {
        return;
    }
    if e.kind == X_INDEX {
        let index = a.ex(e.b);
        if index.kind == X_RANGE
            || (index.kind == X_BINARY && is_op(in tc, n32(index.a), in ".."))
        {
            // A slice view remains a borrow even as a let initializer.
            return;
        }
    }
    let site = match sugar_operation_span(inout tc, e) {
        Option::Some(site) => site,
        Option::None => return,
    };
    if !owned {
        let fault = captured_value_fault(in tc.sugar.policies, site, TyPass::In);
        note_sugar_violation(inout tc, fault);
        return;
    }
    let moving = captured_value_fault(in tc.sugar.policies, site, TyPass::Sink);
    if moving == POLICY_OK {
        return;
    }
    let mut bounds = bounds_new();
    for i in 0..tc.sugar_generic_count {
        let generic = a.generic(wrapping_add(tc.sugar_generic_start, i));
        if !generic.is_row {
            bounds.set(generic.name, generic.bound);
        }
    }
    let fault = if tc.types.kind(ty) != TyKind::Infer
        && mode_of(inout tc.types, in tc.names, in tc.world, ty, in bounds) == TyMode::Copy
    {
        captured_value_fault(in tc.sugar.policies, site, TyPass::In)
    } else {
        moving
    };
    note_sugar_violation(inout tc, fault);
}

fn borrowed_match_place(in tc: Tc, in a: Ast, id: u64) -> bool {
    let mut e = a.ex(id);
    loop {
        if e.kind != X_FIELD {
            break;
        }
        e = a.ex(e.a);
    }
    if e.kind != X_NAME {
        return false;
    }
    let name = n32(e.a);
    let mut i = tc.env.len();
    loop {
        if i == 0 {
            break;
        }
        i = wrapping_sub(i, 1);
        match tc.env.try_get(i) {
            Option::Some(binding) => {
                if binding.name == name {
                    return binding.pass != TyPass::Sink;
                }
            },
            Option::None => {},
        }
    }
    false
}

fn check_expr(inout tc: Tc, in a: Ast, eid: u64, expected: u32) -> u32 {
    if eid == NONE64 {
        return tc.unit_ty;
    }
    let e = match a.exs.try_get(eid) {
        Option::Some(v) => v,
        Option::None => return tc.unit_ty,
    };
    let ty = if e.kind == X_LITERAL {
        if e.a == Lit::Bool {
            tc.bool_ty
        } else if e.a == Lit::Float {
            // An unsuffixed float literal checked as an `f32` is an `f32`
            // (the nearest one to its `f64` value).
            if expected == tc.types.named0(tc.world.k.f32_) {
                expected
            } else {
                tc.f64_ty
            }
        } else if e.a == Lit::String {
            // A string literal is a `String`, except as static text: a `Str`
            // where a `-> Str` function expects one (`static_text`).
            if expected == tc.str_ty && tc.ret_ty == tc.str_ty {
                tc.str_ty
            } else {
                tc.types.named0(tc.world.k.string)
            }
        } else if tc.types.kind(expected) == TyKind::Named
            && tc.world.k.is_integer(tc.types.name(expected))
        {
            expected
        } else if e.a == Lit::WideInt {
            tc.types.named0(tc.world.k.u128_)
        } else if e.a == Lit::Int && e.b > 9223372036854775807 && e.c == 0 {
            tc.u64_ty
        } else {
            tc.i64_ty
        }
    } else if e.kind == X_NAME {
        let nm = n32(e.a);
        let lv = lookup_var(in tc, nm);
        if lv != NONE32 {
            let pid = open_pid(in tc, nm);
            let goal = is_int_ty(in tc, expected);
            if tc.lit_probe && pid != NONE64 && is_int_ty(in tc, lv) {
                // A use of an open binding reads as a literal (`literal_use`).
                let t = if goal { expected } else { lv };
                note_lit_use(inout tc, pid, t);
                t
            } else {
                if goal && lv != expected && is_int_ty(in tc, lv) {
                    tc.lit_mismatch = true;
                }
                lv
            }
        } else {
            let dt = default_type(inout tc.types, expected);
            let (adt, _vi, _vars) = ctor_info(inout tc, nm, dt);
            if adt != NONE32 {
                if tc.types.kind(dt) == TyKind::Named {
                    dt
                } else {
                    tc.types.named0(tc.world.adt(adt).name)
                }
            } else {
                expected
            }
        }
    } else if e.kind == X_TUPLE {
        let mut elems = ChunkSeq::new[u32]();
        elems.reserve(e.n);
        let dt = default_type(inout tc.types, expected);
        for i in 0..e.n {
            let sub = u64_at(in a.xs, wrapping_add(e.a, i));
            // Rust's goal for an element: the expected element type only
            // when it is a float or a tuple; integer literals settle later
            // (`constrain_literals`).
            let exp_i = if tc.types.kind(dt) == TyKind::Tuple && i < tc.types.arity(dt) {
                let et = tc.types.arg(dt, i);
                let float = tc.types.kind(et) == TyKind::Named
                    && (tc.types.name(et) == tc.world.k.f64_
                        || tc.types.name(et) == tc.world.k.f32_);
                if float || tc.types.kind(et) == TyKind::Tuple {
                    et
                } else {
                    tc.infer_ty
                }
            } else {
                tc.infer_ty
            };
            elems.push(check_owned_expr(inout tc, in a, sub, exp_i));
        }
        tc.types.tuple(in elems)
    } else if e.kind == X_STRUCT {
        let nm = n32(e.a);
        let dt = default_type(inout tc.types, expected);
        let (adt, vi, vars) = ctor_info(inout tc, nm, dt);
        for i in 0..e.n {
            let fnm = n32(u64_at(in a.xs, wrapping_add(e.b, wrapping_mul(i, 2))));
            let sub = u64_at(in a.xs, wrapping_add(e.b, wrapping_add(wrapping_mul(i, 2), 1)));
            let mut fty = tc.infer_ty;
            if adt != NONE32 {
                let v = tc.world.variant(vi);
                for fj in 0..w(v.fc) {
                    let f = tc.world.field(wrapping_add(w(v.fa), fj));
                    if f.name == fnm {
                        fty = substitute(inout tc.types, f.ty, in vars);
                        break;
                    }
                }
            }
            let _t = check_owned_expr(inout tc, in a, sub, fty);
        }
        if adt != NONE32
            && tc.types.kind(dt) == TyKind::Named
            && tc.types.name(dt) == tc.world.adt(adt).name
        {
            dt
        } else if adt != NONE32 {
            tc.types.named0(tc.world.adt(adt).name)
        } else {
            tc.types.named0(nm)
        }
    } else if e.kind == X_FIELD {
        let bt = check_expr(inout tc, in a, e.a, tc.infer_ty);
        let ft = field_step(inout tc.types, inout tc.names, in tc.world, bt, n32(e.b), false);
        if ft == NONE32 { expected } else { ft }
    } else if e.kind == X_INDEX {
        let bt = check_expr(inout tc, in a, e.a, tc.infer_ty);
        // A sequence or slice element index is a `u64` (`seq_index`).
        let seq_base = tc.types.kind(bt) == TyKind::Named
            && (tc.types.name(bt) == tc.world.k.chunk_seq || tc.types.name(bt) == tc.world.k.slice);
        let range_index = match a.exs.try_get(e.b) {
            Option::Some(ix) => ix.kind == X_RANGE,
            Option::None => false,
        };
        let index_goal = if seq_base || range_index {
            tc.u64_ty
        } else {
            tc.infer_ty
        };
        let _it = check_expr(inout tc, in a, e.b, index_goal);
        let is_rng = match a.exs.try_get(e.b) {
            Option::Some(ix) => ix.kind == X_RANGE
                || (ix.kind == X_BINARY && tc.names.spells(n32(ix.a), in "..".as_bytes())),
            Option::None => false,
        };
        if is_rng && tc.types.arity(bt) > 0 {
            let sl_nm = tc.names.intern(in "Slice".as_bytes());
            named1(inout tc, sl_nm, tc.types.arg(bt, 0))
        } else if tc.types.arity(bt) > 0 {
            tc.types.arg(bt, 0)
        } else if is_rng && (bt == tc.str_ty || bt == tc.types.named0(tc.world.k.string)) {
            tc.str_ty
        } else {
            expected
        }
    } else if e.kind == X_UNARY {
        let op = n32(e.a);
        if is_op(in tc, op, in "!") {
            check_expr(inout tc, in a, e.b, expected)
        } else {
            let conv_t = conv_target_type(inout tc, op);
            if conv_t != NONE32 {
                let _t = check_expr(inout tc, in a, e.b, tc.infer_ty);
                conv_t
            } else {
                check_expr(inout tc, in a, e.b, expected)
            }
        }
    } else if e.kind == X_BINARY {
        let op = n32(e.a);
        if is_op(in tc, op, in "&&") || is_op(in tc, op, in "||") {
            let _lt = check_expr(inout tc, in a, e.b, tc.bool_ty);
            let _rt = check_expr(inout tc, in a, e.c, tc.bool_ty);
            tc.bool_ty
        } else if is_op(in tc, op, in "==")
            || is_op(in tc, op, in "!=")
            || is_op(in tc, op, in "<")
            || is_op(in tc, op, in ">")
            || is_op(in tc, op, in "<=")
            || is_op(in tc, op, in ">=")
        {
            if is_num_lit_expr(in tc, in a, e.b) && !is_num_lit_expr(in tc, in a, e.c) {
                let rt = check_expr(inout tc, in a, e.c, tc.infer_ty);
                let _lt = check_expr(inout tc, in a, e.b, rt);
            } else {
                let lt = check_expr(inout tc, in a, e.b, tc.infer_ty);
                let _rt = check_expr(inout tc, in a, e.c, lt);
            }
            tc.bool_ty
        } else if tc.types.kind(expected) == TyKind::Infer
            && !is_op(in tc, op, in "<<")
            && !is_op(in tc, op, in ">>")
            && is_num_lit_expr(in tc, in a, e.b)
            && !is_num_lit_expr(in tc, in a, e.c)
        {
            let rt = check_expr(inout tc, in a, e.c, expected);
            let lt = check_expr(inout tc, in a, e.b, rt);
            if tc.types.kind(rt) == TyKind::Infer {
                lt
            } else {
                rt
            }
        } else if is_op(in tc, op, in "<<") || is_op(in tc, op, in ">>") {
            // A shift amount takes no kind from its operand: an unsuffixed
            // literal amount is a `u32` (`shift_amount`).
            let lt = check_expr(inout tc, in a, e.b, expected);
            let amount_goal = if is_int_lit_expr(in tc, in a, e.c) {
                tc.types.named0(tc.world.k.u32_)
            } else {
                tc.infer_ty
            };
            let _rt = check_expr(inout tc, in a, e.c, amount_goal);
            lt
        } else {
            let lt = check_expr(inout tc, in a, e.b, expected);
            let rt = check_expr(inout tc, in a, e.c, lt);
            if tc.types.kind(lt) == TyKind::Infer {
                rt
            } else {
                lt
            }
        }
    } else if e.kind == X_ASSIGN && assigns_open(in tc, in a, e) {
        // In a probe run, a value assigned to an open binding is one of its
        // uses, typed from its own operands (`literal_assignment`).
        let pid = match a.exs.try_get(e.b) {
            Option::Some(t) => open_pid(in tc, n32(t.a)),
            Option::None => NONE64,
        };
        let _lt = check_expr(inout tc, in a, e.b, tc.infer_ty);
        let rt = check_owned_expr(inout tc, in a, e.c, tc.infer_ty);
        note_lit_use(inout tc, pid, rt);
        tc.unit_ty
    } else if e.kind == X_ASSIGN {
        let op = n32(e.a);
        let lt = check_expr(inout tc, in a, e.b, tc.infer_ty);
        let rhs_exp = if tc.names.has_prefix(op, in "[]".as_bytes()) {
            let et = if tc.types.kind(lt) == TyKind::Tuple && tc.types.arity(lt) > 0 {
                tc.types.arg(lt, 0)
            } else {
                tc.infer_ty
            };
            tc.scratch1.clear();
            tc.scratch1.push(tc.u64_ty);
            tc.scratch1.push(et);
            tc.types.tuple(in tc.scratch1)
        } else {
            lt
        };
        let rt = check_owned_expr(inout tc, in a, e.c, rhs_exp);
        if is_int_ty(in tc, rhs_exp) && is_int_ty(in tc, rt) && rt != rhs_exp {
            tc.lit_mismatch = true;
        }
        tc.unit_ty
    } else if e.kind == X_BLOCK {
        push_scope(inout tc);
        for i in 0..e.n {
            let is_let = u64_at(in a.xs, wrapping_add(e.a, wrapping_mul(i, 3)));
            let pt = u64_at(in a.xs, wrapping_add(e.a, wrapping_add(wrapping_mul(i, 3), 1)));
            let val = u64_at(in a.xs, wrapping_add(e.a, wrapping_add(wrapping_mul(i, 3), 2)));
            let mut exp = tc.infer_ty;
            let mut plain = false;
            if is_let != 0 {
                match a.pts.try_get(pt) {
                    Option::Some(pv) => {
                        if pv.kind != Pat::Literal && pv.kind != Pat::Constructor && pv.c > 0 {
                            let ann = n32(wrapping_sub(pv.c, 1));
                            if tc.types.kind(ann) != TyKind::Infer {
                                exp = ann;
                            }
                        }
                        plain = pv.kind == Pat::Bind;
                    },
                    Option::None => {},
                }
            }
            // An unannotated binding of a literal takes the kind its uses
            // gave it (`literal_annotation`), or is open.
            let hint = if plain && tc.types.kind(exp) == TyKind::Infer {
                lit_hint(in tc, pt)
            } else {
                NONE32
            };
            let open = plain
                && hint == NONE32
                && tc.types.kind(exp) == TyKind::Infer
                && is_int_lit_expr(in tc, in a, val);
            if hint != NONE32 {
                exp = hint;
            }
            let vt = check_owned_expr(inout tc, in a, val, exp);
            if is_let != 0 {
                // An annotated binding has its annotation's type
                // (`refine_annotation`), whatever its literals settled to.
                let bound = if tc.types.kind(exp) == TyKind::Infer {
                    vt
                } else {
                    exp
                };
                bind_pat(inout tc, in a, pt, bound);
                if open && is_int_ty(in tc, bound) {
                    open_last(inout tc, pt);
                }
            }
        }
        let tail_ty = if e.b == NONE64 {
            tc.unit_ty
        } else {
            check_owned_expr(inout tc, in a, e.b, expected)
        };
        pop_scope(inout tc);
        tail_ty
    } else if e.kind == X_TRY && sugar_applies(inout tc, e) {
        check_sugar_try(inout tc, in a, e, expected)
    } else if e.kind == X_IF {
        let _ct = check_owned_expr(inout tc, in a, e.a, tc.bool_ty);
        let tt = check_owned_expr(inout tc, in a, e.b, expected);
        if e.c == NONE64 {
            tc.unit_ty
        } else {
            let exp_e = if tt == tc.never_ty { expected } else { tt };
            let et = check_owned_expr(inout tc, in a, e.c, exp_e);
            let result = if tt == tc.never_ty || tc.types.kind(tt) == TyKind::Infer {
                et
            } else {
                tt
            };
            constrain_literals(inout tc, in a, e.b, result);
            constrain_literals(inout tc, in a, e.c, result);
            result
        }
    } else if e.kind == X_MATCH {
        let vt = check_expr(inout tc, in a, e.a, tc.infer_ty);
        if tc.sugar.policies.regions.len() != 0 {
            let borrowed = borrowed_match_place(in tc, in a, e.a);
            check_value_place(inout tc, in a, e.a, vt, !borrowed);
        }
        let mut res = expected;
        for i in 0..e.n {
            let pt = u64_at(in a.xs, wrapping_add(e.b, wrapping_mul(i, 2)));
            let body = u64_at(in a.xs, wrapping_add(e.b, wrapping_add(wrapping_mul(i, 2), 1)));
            push_scope(inout tc);
            bind_pat(inout tc, in a, pt, vt);
            let exp_b = if res == tc.never_ty { expected } else { res };
            let bt = check_owned_expr(inout tc, in a, body, exp_b);
            if (tc.types.kind(res) == TyKind::Infer || res == tc.never_ty) && bt != tc.never_ty {
                res = bt;
            }
            pop_scope(inout tc);
        }
        res
    } else if e.kind == X_LOOP {
        let _bt = check_expr(inout tc, in a, e.a, tc.unit_ty);
        // Rust's loop type: the join of its `break` values, `Unit` for
        // plain `break`s and `Never` without any.
        let breaks = loop_breaks(in a, e.a);
        if breaks == loop_never_breaks() {
            tc.never_ty
        } else if breaks == loop_plain_breaks() {
            tc.unit_ty
        } else {
            expected
        }
    } else if e.kind == X_FOR {
        // A `for` over a range of literals takes its binding's hinted kind
        // (`literal_element`), or its binding is open.
        let literal_range = match a.exs.try_get(e.b) {
            Option::Some(r) => r.kind == X_RANGE
                && is_int_lit_expr(in tc, in a, r.a)
                && is_int_lit_expr(in tc, in a, r.b),
            Option::None => false,
        };
        let plain = match a.pts.try_get(e.a) {
            Option::Some(p) => p.kind == Pat::Bind,
            Option::None => false,
        };
        let hint = if literal_range && plain {
            lit_hint(in tc, e.a)
        } else {
            NONE32
        };
        let goal = if hint == NONE32 { tc.infer_ty } else { hint };
        let it = check_expr(inout tc, in a, e.b, goal);
        let ranged = match a.exs.try_get(e.b) {
            Option::Some(ix) => ix.kind == X_RANGE,
            Option::None => false,
        };
        // Over a fixed array (a tuple), a `ChunkSeq` or a `Slice`, the
        // pattern binds an element (#2703).
        let sequence = tc.types.kind(it) == TyKind::Named
            && tc.types.arity(it) == 1
            && (tc.types.name(it) == tc.world.k.chunk_seq || tc.types.name(it) == tc.world.k.slice);
        let elem = if ranged {
            it
        } else if (tc.types.kind(it) == TyKind::Tuple && tc.types.arity(it) > 0) || sequence {
            default_type(inout tc.types, tc.types.arg(it, 0))
        } else {
            it
        };
        push_scope(inout tc);
        bind_pat(inout tc, in a, e.a, elem);
        if literal_range && plain && hint == NONE32 && is_int_ty(in tc, it) {
            open_last(inout tc, e.a);
        }
        let _bt = check_expr(inout tc, in a, e.c, tc.unit_ty);
        pop_scope(inout tc);
        tc.unit_ty
    } else if e.kind == X_RANGE {
        // A `for` range of unsuffixed literals defaults like a literal; an
        // unsuffixed start takes the end's kind (`for_expr`). Elsewhere a
        // range bounds a view, in `u64`.
        let integer_goal = tc.types.kind(expected) == TyKind::Named
            && tc.world.k.is_integer(tc.types.name(expected));
        if !integer_goal
            && is_int_lit_expr(in tc, in a, e.a)
            && !is_int_lit_expr(in tc, in a, e.b)
        {
            let en = check_expr(inout tc, in a, e.b, tc.infer_ty);
            check_expr(inout tc, in a, e.a, en)
        } else {
            let goal = if integer_goal { expected } else { tc.infer_ty };
            let st = check_expr(inout tc, in a, e.a, goal);
            let _en = check_expr(inout tc, in a, e.b, st);
            st
        }
    } else if e.kind == X_BREAK {
        if e.a != NONE64 {
            let _vt = check_owned_expr(inout tc, in a, e.a, tc.infer_ty);
        }
        tc.never_ty
    } else if e.kind == X_RETURN {
        if e.a != NONE64 {
            let _vt = check_owned_expr(inout tc, in a, e.a, tc.ret_ty);
        }
        tc.never_ty
    } else if e.kind == X_CONTINUE {
        tc.never_ty
    } else if e.kind == X_HANDLE {
        match a.hds.try_get(e.a) {
            Option::Some(h) => {
                if h.has_state {
                    let st = check_owned_expr(inout tc, in a, h.state_expr, tc.infer_ty);
                    bind_pat(inout tc, in a, h.state_pattern, st);
                }
                let outer_handler_row = tc.sugar_handler_row;
                tc.sugar_handler_row = policy_handler_row(inout tc, in a, h);
                let bt = check_owned_expr(inout tc, in a, h.body, expected);
                tc.sugar_handler_row = outer_handler_row;
                let mut rt = expected;
                match a.cls.try_get(h.return_clause) {
                    Option::Some(rc) => {
                        push_scope(inout tc);
                        if rc.pattern_count > 0 {
                            bind_pat(inout tc, in a, u64_at(in a.xs, rc.pattern_start), bt);
                        }
                        rt = check_owned_expr(inout tc, in a, rc.body, expected);
                        pop_scope(inout tc);
                    },
                    Option::None => {},
                }
                for oi in 0..h.op_count {
                    match a.cls.try_get(wrapping_add(h.return_clause, wrapping_add(oi, 1))) {
                        Option::Some(oc) => {
                            push_scope(inout tc);
                            for pi in 0..oc.pattern_count {
                                let pty = if pi == 0 && h.arg_ty_count > 0 {
                                    n32(u64_at(in a.xs, h.arg_ty_start))
                                } else {
                                    tc.infer_ty
                                };
                                bind_pat(
                                    inout tc,
                                    in a,
                                    u64_at(in a.xs, wrapping_add(oc.pattern_start, pi)),
                                    pty
                                );
                            }
                            let _ot = check_owned_expr(inout tc, in a, oc.body, rt);
                            pop_scope(inout tc);
                        },
                        Option::None => {},
                    }
                }
                rt
            },
            Option::None => expected,
        }
    } else if e.kind == X_CALL {
        match a.exs.try_get(e.a) {
            Option::Some(ce) => {
                if ce.kind == X_NAME {
                    let cname = n32(ce.a);
                    if tc.sugar.policies.regions.len() != 0 {
                        let callable = lookup_var(in tc, cname);
                        if callable != NONE32
                            && tc.types.kind(callable) == TyKind::Fn
                            && sugar_applies(inout tc, e)
                        {
                            certify_sugar_call(inout tc, eid);
                            return check_sugar_value_call(inout tc, in a, callable, e, ce);
                        }
                    }
                    let authored = sugar_applies(inout tc, e);
                    let fn_opt = if authored && lookup_var(in tc, cname) != NONE32 {
                        Option::None
                    } else {
                        match find_fn(in a, cname) {
                            Option::Some(f) => Option::Some(f),
                            Option::None => {
                                if authored {
                                    Option::None
                                } else {
                                    let (qf, sf) = split_last_colon(inout tc.names, cname);
                                    if qf != NONE32 {
                                        find_fn(in a, sf)
                                    } else {
                                        Option::None
                                    }
                                }
                            },
                        }
                    };
                    match fn_opt {
                        Option::Some(f) => {
                            certify_sugar_call(inout tc, eid);
                            return check_fn_call(inout tc, in a, f, NONE32, e, ce, expected);
                        },
                        Option::None => {
                            let local = lookup_var(in tc, cname);
                            if local != NONE32 && tc.types.kind(local) == TyKind::Fn {
                                return check_value_call(inout tc, in a, local, e);
                            }
                            if authored && lookup_var(in tc, cname) == NONE32 {
                                match find_eop(in a, inout tc.names, cname) {
                                    Option::Some((ef, op)) => {
                                        certify_sugar_call(inout tc, eid);
                                        return check_direct_effect(inout tc, in a, ef, op, e, ce);
                                    },
                                    Option::None => {},
                                }
                                match check_sugar_named_sequence(inout tc, in a, e, ce) {
                                    Option::Some(result) => {
                                        certify_sugar_call(inout tc, eid);
                                        return result;
                                    },
                                    Option::None => {},
                                }
                            }
                            let conv_ty = conv_target_type(inout tc, cname);
                            let same_int = is_same_int_op(in tc, cname);
                            let is_builtin = conv_ty != NONE32
                                || is_op(in tc, cname, in "inc32")
                                || same_int;
                            let dt = if is_builtin {
                                tc.infer_ty
                            } else {
                                default_type(inout tc.types, expected)
                            };
                            let (adt, vi, vars0) = if is_builtin {
                                (NONE32, 0, vars_new())
                            } else {
                                ctor_info(inout tc, cname, dt)
                            };
                            if authored
                                && lookup_var(in tc, cname) == NONE32
                                && (adt != NONE32
                                    || total_named_builtin(in tc, cname, conv_ty, e.n))
                            {
                                certify_sugar_call(inout tc, eid);
                            }
                            let mut vars = vars0;
                            let mut gnames = ChunkSeq::new[u32]();
                            if adt != NONE32 {
                                let ad = tc.world.adt(adt);
                                for gi in 0..w(ad.gn) {
                                    let gn = tc.world.generic(wrapping_add(w(ad.ga), gi));
                                    gnames.push(gn.name);
                                    if gi < e.m {
                                        let ta = n32(u64_at(in a.xs, wrapping_add(e.c, gi)));
                                        vars.set(gn.name, ta);
                                    }
                                }
                            }
                            let mut arg0_ty = tc.infer_ty;
                            let is_rot = is_op(in tc, cname, in "rotate_left")
                                || is_op(in tc, cname, in "rotate_right");
                            let reverse_same_int = adt == NONE32
                                && same_int
                                && !is_rot
                                && e.n == CALL_ARG_STRIDE
                                && tc.types.kind(expected) == TyKind::Infer
                                && is_int_lit_expr(in tc, in a, call_arg_expr(in a, e, 0))
                                && !is_int_lit_expr(in tc, in a, call_arg_expr(in a, e, 1));
                            if reverse_same_int {
                                let av1 = call_arg_expr(in a, e, 1);
                                let at1 = check_expr(inout tc, in a, av1, tc.infer_ty);
                                let av0 = call_arg_expr(in a, e, 0);
                                arg0_ty = check_expr(inout tc, in a, av0, at1);
                            } else {
                                for ai in 0..e.n {
                                    let av = call_arg_expr(in a, e, ai);
                                    let mut pt = tc.infer_ty;
                                    let mut fty_raw = tc.infer_ty;
                                    if adt == NONE32 && same_int {
                                        if is_rot && ai == 1 {
                                            pt = tc.types.named0(tc.world.k.u32_);
                                        } else if ai == 0 {
                                            pt = expected;
                                        } else if tc.types.kind(arg0_ty) != TyKind::Infer {
                                            pt = arg0_ty;
                                        } else {
                                            pt = expected;
                                        }
                                    }
                                    if adt == NONE32 && !same_int {
                                        let bits_pt = bits_operand_type(inout tc, cname);
                                        if bits_pt != NONE32 {
                                            pt = bits_pt;
                                        }
                                    }
                                    if adt != NONE32 {
                                        let v = tc.world.variant(vi);
                                        if ai < w(v.fc) {
                                            let f = tc.world.field(wrapping_add(w(v.fa), ai));
                                            fty_raw = f.ty;
                                            pt = substitute(inout tc.types, f.ty, in vars);
                                        }
                                    }
                                    let at = check_expr(inout tc, in a, av, pt);
                                    if ai == 0 {
                                        arg0_ty = at;
                                    }
                                    if adt != NONE32 && gnames.len() > 0 {
                                        infer(
                                            inout tc.types,
                                            tc.world.k,
                                            fty_raw,
                                            at,
                                            in gnames,
                                            inout vars
                                        );
                                    }
                                }
                            }
                            let rty = if adt != NONE32 {
                                let ad = tc.world.adt(adt);
                                let aname = ad.name;
                                if tc.types.kind(dt) == TyKind::Named
                                    && tc.types.name(dt) == aname
                                {
                                    dt
                                } else if gnames.len() > 0 {
                                    tc.scratch1.clear();
                                    for gi in 0..gnames.len() {
                                        let gnm = u32_at(in gnames, gi);
                                        let v = vars.get(gnm);
                                        if v != NONE32 {
                                            tc.scratch1.push(v);
                                        } else {
                                            tc.scratch1.push(tc.infer_ty);
                                        }
                                    }
                                    tc.types.named(aname, in tc.scratch1)
                                } else {
                                    tc.types.named0(aname)
                                }
                            } else if (is_op(in tc, cname, in "ChunkSeq::new")
                                || is_op(in tc, cname, in "ChunkSeq::with_capacity"))
                                && e.m > 0
                            {
                                let cs_nm = tc.names.intern(in "ChunkSeq".as_bytes());
                                named1(inout tc, cs_nm, n32(u64_at(in a.xs, e.c)))
                            } else if is_op(in tc, cname, in "String::new") {
                                tc.types.named0(tc.names.intern(in "String".as_bytes()))
                            } else if is_op(in tc, cname, in "String::from_utf8") {
                                let st = tc.types.named0(tc.names.intern(in "String".as_bytes()));
                                let opt_nm = tc.names.intern(in "Option".as_bytes());
                                named1(inout tc, opt_nm, st)
                            } else if conv_ty != NONE32 {
                                conv_ty
                            } else if is_op(in tc, cname, in "inc32") {
                                tc.types.named0(tc.world.k.u32_)
                            } else if same_int {
                                if tc.types.kind(arg0_ty) != TyKind::Infer {
                                    arg0_ty
                                } else if tc.types.kind(expected) != TyKind::Infer {
                                    expected
                                } else {
                                    tc.u64_ty
                                }
                            } else {
                                match find_eop(in a, inout tc.names, cname) {
                                    Option::Some((_, op)) => op.result,
                                    Option::None => expected,
                                }
                            };
                            record_span(inout tc, ce.s0, ce.s1, rty);
                            record_span(inout tc, e.s0, e.s1, rty);
                            return rty;
                        },
                    }
                } else if ce.kind == X_FIELD {
                    match check_labeled_sugar_effect(inout tc, in a, e, ce) {
                        Option::Some(result) => {
                            certify_sugar_call(inout tc, eid);
                            return result;
                        },
                        Option::None => {},
                    }
                    let bt = check_expr(inout tc, in a, ce.a, tc.infer_ty);
                    let mname = n32(ce.b);
                    let tname = tc.types.name(bt);
                    let cname = join_method_sym(inout tc.names, tname, mname);
                    match find_fn(in a, cname) {
                        Option::Some(f) => {
                            certify_sugar_call(inout tc, eid);
                            return check_fn_call(inout tc, in a, f, bt, e, ce, expected);
                        },
                        Option::None => {
                            if sugar_applies(inout tc, e) {
                                let callable = field_step(
                                    inout tc.types,
                                    inout tc.names,
                                    in tc.world,
                                    bt,
                                    mname,
                                    false
                                );
                                if callable != NONE32 && tc.types.kind(callable) == TyKind::Fn {
                                    certify_sugar_call(inout tc, eid);
                                    return check_sugar_value_call(inout tc, in a, callable, e, ce);
                                }
                            }
                            for ai in 0..e.n {
                                let av = u64_at(
                                    in a.xs,
                                    wrapping_add(e.b, wrapping_add(wrapping_mul(ai, 2), 1))
                                );
                                let mut pt = tc.infer_ty;
                                if tc.types.arity(bt) > 0 {
                                    if (is_op(in tc, mname, in "push")
                                        || is_op(in tc, mname, in "fill"))
                                        && ai == 0
                                    {
                                        pt = tc.types.arg(bt, 0);
                                    } else if (is_op(in tc, mname, in "try_set")
                                        || is_op(in tc, mname, in "set"))
                                        && ai == 1
                                    {
                                        pt = tc.types.arg(bt, 0);
                                    }
                                }
                                let _at = check_expr(inout tc, in a, av, pt);
                            }
                            let rty = if is_op(in tc, mname, in "len") {
                                tc.u64_ty
                            } else if is_op(in tc, mname, in "is_empty")
                                || is_op(in tc, mname, in "try_set")
                                || is_op(in tc, mname, in "set")
                                || is_op(in tc, mname, in "try_fill")
                                || is_op(in tc, mname, in "push_char")
                            {
                                tc.bool_ty
                            } else if is_op(in tc, mname, in "push")
                                || is_op(in tc, mname, in "clear")
                                || is_op(in tc, mname, in "extend")
                                || is_op(in tc, mname, in "resize")
                                || is_op(in tc, mname, in "truncate")
                                || is_op(in tc, mname, in "reserve")
                                || is_op(in tc, mname, in "fill")
                                || is_op(in tc, mname, in "fill_range")
                                || is_op(in tc, mname, in "swap")
                                || is_op(in tc, mname, in "push_str")
                            {
                                tc.unit_ty
                            } else if is_op(in tc, mname, in "as_str")
                                || is_op(in tc, mname, in "sub_str")
                            {
                                tc.str_ty
                            } else if is_op(in tc, mname, in "as_bytes") {
                                let u8t = tc.types.named0(tc.world.k.u8_);
                                let sl_nm = tc.names.intern(in "Slice".as_bytes());
                                named1(inout tc, sl_nm, u8t)
                            } else if (is_op(in tc, mname, in "as_slice")
                                || is_op(in tc, mname, in "sub_slice"))
                                && tc.types.arity(bt) > 0
                            {
                                let a0 = tc.types.arg(bt, 0);
                                let sl_nm = tc.names.intern(in "Slice".as_bytes());
                                named1(inout tc, sl_nm, a0)
                            } else if (is_op(in tc, mname, in "get_or")
                                || is_op(in tc, mname, in "replace"))
                                && tc.types.arity(bt) > 0
                            {
                                tc.types.arg(bt, 0)
                            } else if is_op(in tc, mname, in "byte_at") {
                                tc.types.named0(tc.world.k.u8_)
                            } else if is_op(in tc, mname, in "cmp")
                                && tc.names.spells(tname, in "Slice".as_bytes())
                            {
                                // `Slice[u8]::cmp`: `Ordering as i32` (#1996).
                                tc.types.named0(tc.world.k.i32_)
                            } else if is_op(in tc, mname, in "try_byte_at") {
                                let u8t = tc.types.named0(tc.world.k.u8_);
                                let opt_nm = tc.names.intern(in "Option".as_bytes());
                                named1(inout tc, opt_nm, u8t)
                            } else if is_op(in tc, mname, in "get")
                                && (tname == tc.world.k.chunk_seq || tname == tc.world.k.slice)
                                && tc.types.arity(bt) > 0
                            {
                                // A sequence or slice element (`SeqOp::Get`).
                                tc.types.arg(bt, 0)
                            } else if (is_op(in tc, mname, in "try_get")
                                || is_op(in tc, mname, in "try_get_mut")
                                || is_op(in tc, mname, in "get")
                                || is_op(in tc, mname, in "pop")
                                || is_op(in tc, mname, in "last"))
                                && tc.types.arity(bt) > 0
                            {
                                let a0 = tc.types.arg(bt, 0);
                                let opt_nm = tc.names.intern(in "Option".as_bytes());
                                named1(inout tc, opt_nm, a0)
                            } else if is_op(in tc, mname, in "try_read_u64_le")
                                || is_op(in tc, mname, in "try_read_u64_be")
                                || is_op(in tc, mname, in "find_byte")
                                || is_op(in tc, mname, in "find_either")
                                || is_op(in tc, mname, in "find_not_in")
                            {
                                let opt_nm = tc.names.intern(in "Option".as_bytes());
                                named1(inout tc, opt_nm, tc.u64_ty)
                            } else if is_op(in tc, mname, in "try_read_u32_le")
                                || is_op(in tc, mname, in "try_read_u32_be")
                            {
                                let u32t = tc.types.named0(tc.world.k.u32_);
                                let opt_nm = tc.names.intern(in "Option".as_bytes());
                                named1(inout tc, opt_nm, u32t)
                            } else if is_op(in tc, mname, in "try_read_u16_le")
                                || is_op(in tc, mname, in "try_read_u16_be")
                            {
                                let u16t = tc.types.named0(tc.names.intern(in "u16".as_bytes()));
                                let opt_nm = tc.names.intern(in "Option".as_bytes());
                                named1(inout tc, opt_nm, u16t)
                            } else if is_op(in tc, mname, in "try_write_u16_le")
                                || is_op(in tc, mname, in "try_write_u16_be")
                                || is_op(in tc, mname, in "try_write_u32_le")
                                || is_op(in tc, mname, in "try_write_u32_be")
                                || is_op(in tc, mname, in "try_write_u64_le")
                                || is_op(in tc, mname, in "try_write_u64_be")
                            {
                                tc.bool_ty
                            } else {
                                match find_eop(in a, inout tc.names, cname) {
                                    Option::Some((_, op)) => op.result,
                                    Option::None => expected,
                                }
                            };
                            record_span(inout tc, ce.s0, ce.s1, rty);
                            record_span(inout tc, e.s0, e.s1, rty);
                            return rty;
                        },
                    }
                } else if sugar_applies(inout tc, e) {
                    let callable = check_expr(inout tc, in a, e.a, tc.infer_ty);
                    if tc.types.kind(callable) == TyKind::Fn {
                        certify_sugar_call(inout tc, eid);
                        return check_sugar_value_call(inout tc, in a, callable, e, ce);
                    }
                    note_sugar_violation(inout tc, POLICY_BAD_METADATA);
                }
            },
            Option::None => {},
        }
        for ai in 0..e.n {
            let av = u64_at(in a.xs, wrapping_add(e.b, wrapping_add(wrapping_mul(ai, 2), 1)));
            let _at = check_expr(inout tc, in a, av, tc.infer_ty);
        }
        expected
    } else {
        expected
    };
    record_span(inout tc, e.s0, e.s1, ty);
    ty
}

fn span_lt(in a: SpanRow, in b: SpanRow) -> bool {
    a.start < b.start || (a.start == b.start && a.end < b.end)
}

fn span_swap(inout s: Slice[SpanRow], i: u64, j: u64) eff [Fail[RuntimeError]] {
    let a = s[i];
    let b = s[j];
    let _ok1 = s.try_set(i, b);
    let _ok2 = s.try_set(j, a);
}

fn span_sift(inout s: Slice[SpanRow], start: u64, end: u64) eff [Fail[RuntimeError]] {
    let mut root = start;
    loop {
        let left = wrapping_add(wrapping_mul(root, 2), 1);
        if left >= end {
            break;
        }
        let mut child = left;
        let right = wrapping_add(left, 1);
        if right < end && span_lt(in s[left], in s[right]) {
            child = right;
        }
        if !span_lt(in s[root], in s[child]) {
            break;
        }
        span_swap(inout s, root, child);
        root = child;
    }
}

fn sort_spans_slice(inout s: Slice[SpanRow]) eff [Fail[RuntimeError]] {
    let n = s.len();
    if n <= 1 {
        return;
    }
    let mut start = n / 2;
    loop {
        if start == 0 {
            break;
        }
        start = wrapping_sub(start, 1);
        span_sift(inout s, start, n);
    }
    let mut end = n;
    loop {
        if end <= 1 {
            break;
        }
        end = wrapping_sub(end, 1);
        span_swap(inout s, 0, end);
        span_sift(inout s, 0, end);
    }
}

pub fn sort_spans(inout spans: ChunkSeq[SpanRow]) {
    handle Fail[RuntimeError] in {
        sort_spans_slice(inout spans.as_slice_mut());
    } with {
        return _v => {},
        raise(e, _k) => match e {
            _ => {},
        },
    };
}

fn call_lt(in a: CallRow, in b: CallRow) -> bool {
    a.s0 < b.s0 || (a.s0 == b.s0 && a.s1 < b.s1)
}

fn call_swap(inout s: Slice[CallRow], i: u64, j: u64) eff [Fail[RuntimeError]] {
    let a = s[i];
    let b = s[j];
    let _ok1 = s.try_set(i, b);
    let _ok2 = s.try_set(j, a);
}

fn call_sift(inout s: Slice[CallRow], start: u64, end: u64) eff [Fail[RuntimeError]] {
    let mut root = start;
    loop {
        let left = wrapping_add(wrapping_mul(root, 2), 1);
        if left >= end {
            break;
        }
        let mut child = left;
        let right = wrapping_add(left, 1);
        if right < end && call_lt(in s[left], in s[right]) {
            child = right;
        }
        if !call_lt(in s[root], in s[child]) {
            break;
        }
        call_swap(inout s, root, child);
        root = child;
    }
}

fn sort_calls_slice(inout s: Slice[CallRow]) eff [Fail[RuntimeError]] {
    let n = s.len();
    if n <= 1 {
        return;
    }
    let mut start = n / 2;
    loop {
        if start == 0 {
            break;
        }
        start = wrapping_sub(start, 1);
        call_sift(inout s, start, n);
    }
    let mut end = n;
    loop {
        if end <= 1 {
            break;
        }
        end = wrapping_sub(end, 1);
        call_swap(inout s, 0, end);
        call_sift(inout s, 0, end);
    }
}

fn sort_calls(inout calls: ChunkSeq[CallRow]) {
    handle Fail[RuntimeError] in {
        sort_calls_slice(inout calls.as_slice_mut());
    } with {
        return _v => {},
        raise(e, _k) => match e {
            _ => {},
        },
    };
}

fn check_fn_body(inout tc: Tc, in a: Ast, f: FnR) {
    push_scope(inout tc);
    for pi in 0..f.param_count {
        match a.pms.try_get(wrapping_add(f.param_start, pi)) {
            Option::Some(pm) => tc.env
                .push(Binding { name: pm.name, ty: pm.ty, pass: pm.pass, open: NONE64 }),
            Option::None => {},
        }
    }
    tc.ret_ty = f.result;
    tc.sugar_ambient_row = f.effects;
    tc.sugar_generic_start = f.generic_start;
    tc.sugar_generic_count = f.generic_count;
    let _rt = check_owned_expr(inout tc, in a, f.body, f.result);
    pop_scope(inout tc);
    let peak = max_u64(max_u64(tc.lit_open.len(), tc.lit_uses.len()), tc.lit_hints.len());
    tc.lit_peak = max_u64(tc.lit_peak, peak);
}

fn max_u64(x: u64, y: u64) -> u64 {
    if x > y { x } else { y }
}

// Forgets what a run of the function recorded past the marks.
fn undo_fn_run(inout tc: Tc, n_spans: u64, n_calls: u64, n_pairs: u64) {
    tc.spans.truncate(n_spans);
    tc.calls.truncate(n_calls);
    tc.pairs.truncate(n_pairs);
    tc.lit_open.clear();
    tc.lit_uses.clear();
}

// Checks `f`, then, when it has open bindings and an integer use of the
// wrong kind (where Rust's checker fails), types those bindings from their
// uses and checks it again (`function_with_literal_typing`).
fn check_fn_with_literal_typing(
    inout tc: Tc,
    in a: Ast,
    f: FnR,
    n_spans: u64,
    n_calls: u64,
    n_pairs: u64
) {
    tc.lit_open.clear();
    tc.lit_uses.clear();
    tc.lit_hints.clear();
    tc.lit_probe = false;
    tc.lit_mismatch = false;
    let violation = tc.sugar_violation;
    check_fn_body(inout tc, in a, f);
    if tc.lit_open.len() == 0 || !tc.lit_mismatch {
        return;
    }
    for _round in 0..LITERAL_PROBE_ROUNDS {
        undo_fn_run(inout tc, n_spans, n_calls, n_pairs);
        tc.lit_probe = true;
        tc.sugar_violation = violation;
        check_fn_body(inout tc, in a, f);
        if !settle_lit_hints(inout tc) {
            break;
        }
    }
    tc.lit_probe = false;
    undo_fn_run(inout tc, n_spans, n_calls, n_pairs);
    tc.sugar_violation = violation;
    check_fn_body(inout tc, in a, f);
    tc.lit_hints.clear();
}

fn dummy_tc(k: Known) -> Tc {
    let mut dn = names_new();
    let dt = types_new(inout dn);
    let dw = world_new(k);
    let empty_row = dt.empty_row;
    Tc {
        names: dn,
        types: dt,
        world: dw,
        env: ChunkSeq::new[Binding](),
        marks: ChunkSeq::new[u64](),
        spans: ChunkSeq::new[SpanRow](),
        infer_ty: 0,
        ret_ty: 0,
        unit_ty: 0,
        bool_ty: 0,
        i64_ty: 0,
        u64_ty: 0,
        f64_ty: 0,
        str_ty: 0,
        never_ty: 0,
        calls: ChunkSeq::new[CallRow](),
        pairs: ChunkSeq::new[Pair](),
        scratch1: ChunkSeq::new[u32](),
        sugar: empty_inputs(),
        sugar_violation: POLICY_OK,
        sugar_checked_calls: ChunkSeq::new[bool](),
        sugar_ambient_row: empty_row,
        sugar_handler_row: empty_row,
        sugar_generic_start: 0,
        sugar_generic_count: 0,
        lit_open: ChunkSeq::new[u64](),
        lit_uses: ChunkSeq::new[LitUse](),
        lit_hints: ChunkSeq::new[LitUse](),
        lit_probe: false,
        lit_mismatch: false,
        lit_peak: 0,
    }
}

fn rebuild_tc(
    sink old_tc: Tc,
    m: u64,
    tc_perm: u64,
    tc_perm_end: u64,
    n_spans: u64,
    n_calls: u64,
    n_pairs: u64,
    n_nodes: u64,
    n_rows: u64,
    n_effs: u64
) -> (Tc, u64) {
    let Tc {
        names: tc_names,
        types: tc_types,
        world: tc_world,
        env: tc_env,
        marks: tc_marks,
        spans: tc_spans_in,
        infer_ty: tc_infer,
        ret_ty: tc_ret,
        unit_ty: tc_unit,
        bool_ty: tc_bool,
        i64_ty: tc_i64,
        u64_ty: tc_u64,
        f64_ty: tc_f64,
        str_ty: tc_str,
        never_ty: tc_never,
        calls: tc_calls_in,
        pairs: tc_pairs_in,
        scratch1: tc_scratch1,
        sugar: tc_sugar,
        sugar_violation: tc_sugar_violation,
        sugar_checked_calls: tc_sugar_checked_calls,
        sugar_ambient_row: tc_sugar_ambient_row,
        sugar_handler_row: tc_sugar_handler_row,
        sugar_generic_start: tc_sugar_generic_start,
        sugar_generic_count: tc_sugar_generic_count,
        lit_open: tc_lit_open,
        lit_uses: tc_lit_uses,
        lit_hints: tc_lit_hints,
        lit_probe: tc_lit_probe,
        lit_mismatch: tc_lit_mismatch,
        lit_peak: tc_lit_peak,
    } = old_tc;
    let mut tc_spans = tc_spans_in;
    let mut tc_calls = tc_calls_in;
    let mut tc_pairs = tc_pairs_in;
    let s_rb = stage2_heap_swap(tc_perm);
    let mut new_spans = ChunkSeq::new[SpanRow]();
    let sn = wrapping_sub(tc_spans.len(), n_spans);
    for si in n_spans..tc_spans.len() {
        match tc_spans.try_get(si) {
            Option::Some(r) => new_spans.push(SpanRow { start: r.start, end: r.end, ty: r.ty }),
            Option::None => {},
        }
    }
    for _ in 0..sn {
        let _ = tc_spans.pop();
    }
    for si in 0..new_spans.len() {
        match new_spans.try_get(si) {
            Option::Some(r) => tc_spans.push(SpanRow { start: r.start, end: r.end, ty: r.ty }),
            Option::None => {},
        }
    }
    let mut new_calls = ChunkSeq::new[CallRow]();
    let cn = wrapping_sub(tc_calls.len(), n_calls);
    for ci in n_calls..tc_calls.len() {
        match tc_calls.try_get(ci) {
            Option::Some(r) => new_calls.push(CallRow { s0: r.s0, s1: r.s1, v0: r.v0, vn: r.vn }),
            Option::None => {},
        }
    }
    for _ in 0..cn {
        let _ = tc_calls.pop();
    }
    for ci in 0..new_calls.len() {
        match new_calls.try_get(ci) {
            Option::Some(r) => tc_calls.push(CallRow { s0: r.s0, s1: r.s1, v0: r.v0, vn: r.vn }),
            Option::None => {},
        }
    }
    let mut new_pairs = ChunkSeq::new[Pair]();
    let pn = wrapping_sub(tc_pairs.len(), n_pairs);
    for pi in n_pairs..tc_pairs.len() {
        match tc_pairs.try_get(pi) {
            Option::Some(r) => new_pairs.push(Pair { name: r.name, ty: r.ty }),
            Option::None => {},
        }
    }
    for _ in 0..pn {
        let _ = tc_pairs.pop();
    }
    for pi in 0..new_pairs.len() {
        match new_pairs.try_get(pi) {
            Option::Some(r) => tc_pairs.push(Pair { name: r.name, ty: r.ty }),
            Option::None => {},
        }
    }
    let fresh_names = tc_names.clone_in_heap();
    let fresh_types = tc_types.clone_tail_in_heap(n_nodes, n_rows, n_effs);
    let fresh_tc = Tc {
        names: fresh_names,
        types: fresh_types,
        world: tc_world,
        env: tc_env,
        marks: tc_marks,
        spans: tc_spans,
        infer_ty: tc_infer,
        ret_ty: tc_ret,
        unit_ty: tc_unit,
        bool_ty: tc_bool,
        i64_ty: tc_i64,
        u64_ty: tc_u64,
        f64_ty: tc_f64,
        str_ty: tc_str,
        never_ty: tc_never,
        calls: tc_calls,
        pairs: tc_pairs,
        scratch1: tc_scratch1,
        sugar: tc_sugar,
        sugar_violation: tc_sugar_violation,
        sugar_checked_calls: tc_sugar_checked_calls,
        sugar_ambient_row: tc_sugar_ambient_row,
        sugar_handler_row: tc_sugar_handler_row,
        sugar_generic_start: tc_sugar_generic_start,
        sugar_generic_count: tc_sugar_generic_count,
        lit_open: tc_lit_open,
        lit_uses: tc_lit_uses,
        lit_hints: tc_lit_hints,
        lit_probe: tc_lit_probe,
        lit_mismatch: tc_lit_mismatch,
        lit_peak: tc_lit_peak,
    };
    let next_perm = stage2_heap_swap(s_rb);
    if next_perm < tc_perm_end {
        stage2_heap_reset(m);
    } else if next_perm > s_rb {
        let _ = stage2_heap_swap(next_perm);
    }
    (fresh_tc, next_perm)
}

pub fn typecheck_ast(
    in a: Ast,
    sink names: Names,
    sink types: Types,
    sink world: World,
    sink sugar: PolicyInputs
) -> (Names, Types, World, ChunkSeq[CallRow], ChunkSeq[Pair], Option[PolicyFailure]) {
    let mut tc = tc_new(sink names, sink types, sink world, sink sugar);
    if tc.sugar.policies.regions.len() != 0 {
        tc.sugar_checked_calls.resize(a.exs.len(), false);
    }
    let mut max_spans = 262144;
    let mut max_calls = 131072;
    let mut max_pairs = 131072;
    tc.spans.reserve(max_spans);
    tc.calls.reserve(max_calls);
    tc.pairs.reserve(max_pairs);
    tc.env.reserve(1024);
    tc.marks.reserve(256);
    tc.scratch1.reserve(1024);
    let mut max_lit = LITERAL_RESERVE;
    tc.lit_open.reserve(max_lit);
    tc.lit_uses.reserve(max_lit);
    tc.lit_hints.reserve(max_lit);
    let mut max_names = wrapping_add(tc.names.len(), 16384);
    let mut max_text = wrapping_add(tc.names.text_len(), 262144);
    tc.names.reserve_names(max_names, max_text);
    let mut max_nodes = wrapping_add(tc.types.nodes.len(), 16384);
    let mut max_items = wrapping_add(tc.types.items_len(), 32768);
    let mut max_rows = wrapping_add(tc.types.rows.len(), 8192);
    let mut max_effs = wrapping_add(tc.types.effs_len(), 16384);
    tc.types.reserve_types(max_nodes, max_items, max_rows, max_effs);
    let n_env = tc.env.len();
    let n_marks = tc.marks.len();
    let mut tc_perm_buf = ChunkSeq::new[u8]();
    tc_perm_buf.reserve(167772160);
    let tc_perm_end = stage2_heap_mark();
    let mut tc_perm = wrapping_sub(tc_perm_end, 167772160);
    let mut m = tc_perm_end;
    tc.env.reserve(512);
    tc.marks.reserve(64);
    tc.scratch1.reserve(64);
    for fi in 0..a.fns.len() {
        let f = match a.fns.try_get(fi) {
            Option::Some(v) => v,
            Option::None => continue,
        };
        if !f.has_body || f.body == NONE64 {
            continue;
        }
        let n_mask = tc.names.mask_val();
        let n_tmask = tc.types.t_mask();
        let n_rmask = tc.types.r_mask();
        let n_spans = tc.spans.len();
        let n_calls = tc.calls.len();
        let n_pairs = tc.pairs.len();
        let n_nodes = tc.types.nodes.len();
        let n_rows = tc.types.rows.len();
        let n_effs = tc.types.effs_len();
        check_fn_with_literal_typing(inout tc, in a, f, n_spans, n_calls, n_pairs);
        tc.scratch1.clear();
        if tc.names.mask_val() == n_mask
            && tc.names.len() < max_names
            && tc.names.text_len() < max_text
            && tc.types.t_mask() == n_tmask
            && tc.types.r_mask() == n_rmask
            && tc.types.nodes.len() < max_nodes
            && tc.types.items_len() < max_items
            && tc.types.rows.len() < max_rows
            && tc.types.effs_len() < max_effs
            && tc.env.len() == n_env
            && tc.marks.len() == n_marks
            && tc.scratch1.len() == 0
            && tc.lit_peak <= max_lit
            && tc.spans.len() < max_spans
            && tc.calls.len() < max_calls
            && tc.pairs.len() < max_pairs
            && tc_perm < tc_perm_end
        {
            let mut dtc = dummy_tc(tc.world.k);
            swap(inout tc, inout dtc);
            let (ntc, next_perm) = rebuild_tc(
                dtc,
                m,
                tc_perm,
                tc_perm_end,
                n_spans,
                n_calls,
                n_pairs,
                n_nodes,
                n_rows,
                n_effs
            );
            let mut mtc = ntc;
            tc_perm = next_perm;
            swap(inout tc, inout mtc);
            if tc_perm >= tc_perm_end {
                tc_perm = tc_perm_end;
                m = stage2_heap_mark();
            }
        } else {
            let s_pre = if tc_perm < tc_perm_end {
                stage2_heap_swap(tc_perm)
            } else {
                0
            };
            if tc.lit_peak > max_lit {
                max_lit = wrapping_add(tc.lit_peak, LITERAL_RESERVE);
                tc.lit_open.reserve(max_lit);
                tc.lit_uses.reserve(max_lit);
                tc.lit_hints.reserve(max_lit);
            }
            max_spans = wrapping_add(tc.spans.len(), 131072);
            max_calls = wrapping_add(tc.calls.len(), 65536);
            max_pairs = wrapping_add(tc.pairs.len(), 65536);
            tc.spans.reserve(max_spans);
            tc.calls.reserve(max_calls);
            tc.pairs.reserve(max_pairs);
            max_names = wrapping_add(tc.names.len(), 16384);
            max_text = wrapping_add(tc.names.text_len(), 262144);
            tc.names.reserve_names(max_names, max_text);
            max_nodes = wrapping_add(tc.types.nodes.len(), 16384);
            max_items = wrapping_add(tc.types.items_len(), 32768);
            max_rows = wrapping_add(tc.types.rows.len(), 8192);
            max_effs = wrapping_add(tc.types.effs_len(), 16384);
            tc.types.reserve_types(max_nodes, max_items, max_rows, max_effs);
            if tc_perm < tc_perm_end {
                tc_perm = stage2_heap_swap(s_pre);
                if tc_perm > s_pre {
                    let _ = stage2_heap_swap(tc_perm);
                }
            }
            m = stage2_heap_mark();
        }
    }
    let _ = stage2_heap_swap(m);
    sort_spans(inout tc.spans);
    sort_calls(inout tc.calls);
    tc.world.expr_types = tc.spans;
    let mut context = Ctx {
        names: tc.names,
        types: tc.types,
        world: tc.world,
        tmap: ChunkSeq::new[u32](),
        nmap: ChunkSeq::new[u32]()
    };
    let fault = if tc.sugar_violation != POLICY_OK {
        tc.sugar_violation
    } else {
        primitive_failure(inout context, in a, in tc.sugar, in tc.sugar_checked_calls)
    };
    let violation = diagnose_policy_fault(in tc.sugar, fault);
    (context.names, context.types, context.world, tc.calls, tc.pairs, violation)
}
