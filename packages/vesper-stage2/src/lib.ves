// @vesper/stage2: pure-Vesper Stage 2 compiler driver (#1397).

use @vesper/check-data::input::{Ctx};
use @vesper/check-data::names::{Names};
use @vesper/check-data::types::{TyPass, Types};
use @vesper/check-data::util::{
    add, inc, n32, push_decimal, stage2_heap_mark, stage2_heap_reset, stage2_heap_swap, u32_at,
    u64_at, w
};
use @vesper/check-data::world::{World, set_by_symbol};
use @vesper/place-ir::{Program};
use @vesper/place-ir-lower::ast::{Ast as IrAst};
use @vesper/check-names-packages::{
    AssembledModule, assemble_next_bytes, assembly_begin_bytes, assembly_metadata
};
use @vesper/place-ir-lower::lower::{L, l_new, lower_all};
use @vesper/wasm-backend::{compile_with_facts, compile_with_facts_diag};
use @vesper/wit-component::comp::encode as wit_encode;
use @vesper/wit-component::wit::parse as parse_wit;
use @vesper/wasm-backend::err::{WErr, format_werr, werr};
use @vesper/wasm-backend::ir::{add_eff_decl, add_fn_sig, empty_facts, push_hop, set_expr_handler};
use @vesper/place-ir::codes::{Op, Pat, PoolKind};
use @vesper-std/env::{arg, arg_count, var};
use @vesper-std/fs::{IoError, write_path};
use self::ast_lower::{build_ir_ast_for_entry};
use self::collect::{collect_program};
use self::loader::{load_package_graph_bytes};
use self::native::{compile_x86_64_elf};
use self::typecheck::{typecheck_ast};

const OUTPUT_WRITE_FAILED: u64 = 4;
const NATIVE_UNSUPPORTED: u64 = 7;
const ASCII_ONE: u8 = 49;

/// Load, assemble, and collect declarations of a Loom package from `root_dir`
/// via `@vesper-std/fs`, returning `(module_count, fn_count, adt_count, diagnostic_bytes)`.
pub fn stage2_collect_dir(in root_dir: Str) -> (u64, u64, u64, u64) eff [Ffi[StdFs]] {
    let encoded = match load_package_graph_bytes(in root_dir.as_bytes()) {
        Option::Some(b) => b,
        Option::None => {
            return (0, 0, 0, 0);
        },
    };
    let mut a = assembly_begin_bytes(in encoded.as_slice());
    let mut mods = ChunkSeq::new[AssembledModule]();
    loop {
        match assemble_next_bytes(inout a, in encoded.as_slice()) {
            Option::Some(m) => {
                mods.push(sink m);
            },
            Option::None => break,
        }
    }
    let mod_count = mods.len();
    let meta = assembly_metadata(sink a);
    let collected = collect_program(in mods);
    (mod_count, collected.fns.len(), collected.world.adts.len(), meta.diagnostics.len())
}

fn prog_fn_params(in prog: Program, in by_sym: ChunkSeq[u32], sym: u32) -> ChunkSeq[u32] {
    let mut out = ChunkSeq::new[u32]();
    let idx = u32_at(in by_sym, w(sym));
    if idx == 0 {
        return out;
    }
    match prog.fns.try_get(wrapping_sub(w(idx), 1)) {
        Option::Some(row) => {
            let mut at = row.ha;
            let np = u64_at(in prog.ops, at);
            at = inc(at);
            for _i in 0..np {
                out.push(n32(u64_at(in prog.ops, at)));
                let k = u64_at(in prog.ops, add(at, 2));
                at = add(at, add(6, k));
            }
        },
        Option::None => {},
    }
    out
}

fn push_dec(inout out: ChunkSeq[u8], v: u64) {
    if v >= 10 {
        push_dec(inout out, v / 10);
    }
    out.push(wrapping_u8(wrapping_add(48, v % 10)));
}

fn nested_sym(inout c: Ctx, in prefix: Str, s0: u64, s1: u64) -> u32 {
    let mut b = ChunkSeq::new[u8]();
    b.extend(in prefix.as_bytes());
    push_dec(inout b, s0);
    b.push(95);
    push_dec(inout b, s1);
    c.names.intern(in b.as_slice())
}

fn write_sidecar(in out_wasm: Str, in suffix: Str, in data: Slice[u8]) eff [Ffi[StdFs]] {
    let mut p = ChunkSeq::new[u8]();
    p.extend(in out_wasm.as_bytes());
    p.extend(in suffix.as_bytes());
    let _ = handle Fail[IoError] in {
        write_path(in p.as_slice(), in data);
        0
    } with {
        return v => v,
        raise(_e, _k) => 0,
    };
}

// Mark mutable element-view `match x.try_get_mut(i)` scrutinees with `TyPass::Inout`
// on their `Op::Seq(MakeSeq, "TryGet")` receiver operand, matching Rust's
// `wasm_element_views` without altering `@vesper/place-ir-lower` differential output.
fn mark_mut_element_views(inout l: L) {
    let mut vs0 = ChunkSeq::new[u64]();
    let mut vs1 = ChunkSeq::new[u64]();
    vs0.reserve(512);
    vs1.reserve(512);
    let m_v = stage2_heap_mark();
    let mut grew = false;
    let ex_len = l.ast.exs.len();
    for ii in 0..ex_len {
        let e = l.ast.ex(ii);
        if e.kind == 14 && e.a < ex_len {
            let sc = l.ast.ex(e.a);
            if sc.kind == 11 && sc.n == 1 && sc.a < ex_len {
                let ce = l.ast.ex(sc.a);
                if ce.kind == 5 && l.ctx.names.spells(n32(ce.b), in "try_get_mut".as_bytes()) {
                    if vs0.len() >= 512 {
                        grew = true;
                    }
                    vs0.push(sc.s0);
                    vs1.push(sc.s1);
                }
            }
        }
    }
    if vs0.len() == 0 {
        if !grew {
            stage2_heap_reset(m_v);
        }
        return;
    }
    for ii in 0..l.program.insts.len() {
        let inst = match l.program.insts.try_get(ii) {
            Option::Some(v) => v,
            Option::None => continue,
        };
        if inst.op != Op::Seq || inst.n < 3 {
            continue;
        }
        let pid = u64_at(in l.program.ops, inst.a);
        let pr = l.program.pool_row(pid);
        if pr.kind == PoolKind::MakeSeq && l.ctx.names.spells(pr.label, in "TryGet".as_bytes()) {
            for vi in 0..vs0.len() {
                if u64_at(in vs0, vi) == inst.s0 && u64_at(in vs1, vi) == inst.s1 {
                    let _ok = l.program.ops.try_set(add(inst.a, 2), widen_u64(TyPass::Inout));
                    break;
                }
            }
        }
    }
    if !grew {
        stage2_heap_reset(m_v);
    }
}

fn write_stage(want_syms: bool, in out_wasm: Str, in stage: Str, inout log: ChunkSeq[u8]) eff [
    Ffi[StdFs]
] {
    if !want_syms {
        return;
    }
    log.extend(in stage.as_bytes());
    log.extend(in " (heap=".as_bytes());
    push_decimal(inout log, stage2_heap_mark() >> 20);
    log.extend(in " MiB)\n".as_bytes());
    write_sidecar(in out_wasm, in ".stage", in log.as_slice());
}

fn write_err_header(in out_wasm: Str, in stage: Str, in detail: Slice[u8]) eff [Ffi[StdFs]] {
    let mut msg = ChunkSeq::new[u8]();
    msg.extend(in "stage2 error (stage=".as_bytes());
    msg.extend(in stage.as_bytes());
    msg.extend(in ", heap_mib=".as_bytes());
    push_decimal(inout msg, stage2_heap_mark() >> 20);
    msg.extend(in "): ".as_bytes());
    msg.extend(in detail);
    msg.push(10);
    write_sidecar(in out_wasm, in ".err.txt", in msg.as_slice());
}

fn move_front_to_perm(
    sink ir_ast0: IrAst,
    sink names0: Names,
    sink types0: Types,
    sink world0: World,
    front_perm: u64,
    m_front: u64
) -> (IrAst, Names, Types, World, u64, bool) {
    if m_front == 0 || front_perm >= m_front {
        return (ir_ast0, names0, types0, world0, 0, false);
    }
    let s_front = stage2_heap_swap(front_perm);
    let ir_c = ir_ast0.deep_clone_in_heap();
    let names_c = names0.deep_clone_in_heap();
    let types_c = types0.deep_clone_in_heap();
    let world_c = world0.deep_clone_in_heap();
    let front_after = stage2_heap_mark();
    let _ = stage2_heap_swap(s_front);
    let used = wrapping_sub(front_after, front_perm);
    if front_after < m_front {
        (ir_c, names_c, types_c, world_c, used, true)
    } else {
        (ir_ast0, names0, types0, world0, used, false)
    }
}

/// Compile a Loom package from `root_dir` to a core Wasm module at `out_wasm`
/// with no Rust compiler calls. Returns `(ok_flag_or_code, core_len_or_site)`.
pub fn stage2_compile_dir(
    in root_dir: Str,
    in out_wasm: Str,
    in entry_name: Str
) -> (u64, u64) eff [Ffi[StdFs]] {
    stage2_compile_dir_impl(in root_dir, in out_wasm, in entry_name, false, false)
}

fn write_native_object(
    in low: L,
    entry: u32,
    in entry_name: Str,
    in output: Str
) -> (u64, u64) eff [Ffi[StdFs]] {
    let bytes = compile_x86_64_elf(in low, entry, in entry_name.as_bytes());
    if bytes.len() == 0 {
        write_err_header(
            in output,
            in "native_backend",
            in "unsupported x86-64 ELF entry".as_bytes()
        );
        return (NATIVE_UNSUPPORTED, 0);
    }
    let wrote = handle Fail[IoError] in {
        write_path(in output.as_bytes(), in bytes.as_slice());
        true
    } with {
        return v => v,
        raise(_e, _k) => false,
    };
    if !wrote {
        write_err_header(in output, in "write_object", in output.as_bytes());
        return (OUTPUT_WRITE_FAILED, 0);
    }
    (0, bytes.len())
}

fn stage2_compile_dir_impl(
    in root_dir: Str,
    in out_wasm: Str,
    in entry_name: Str,
    want_syms: bool,
    native_elf: bool
) -> (u64, u64) eff [Ffi[StdFs]] {
    let mut stage_log = ChunkSeq::new[u8]();
    stage_log.reserve(4096);
    write_stage(want_syms, in out_wasm, in "load_package_graph", inout stage_log);
    let encoded = match load_package_graph_bytes(in root_dir.as_bytes()) {
        Option::Some(b) => b,
        Option::None => {
            let mut d = ChunkSeq::new[u8]();
            d.extend(in "load_package_graph_bytes returned None for root_dir=".as_bytes());
            d.extend(in root_dir.as_bytes());
            write_err_header(in out_wasm, in "load_package_graph", in d.as_slice());
            return (1, 1);
        },
    };
    write_stage(want_syms, in out_wasm, in "assembly_begin", inout stage_log);
    let has_front_perm = stage2_heap_mark() != 0;
    let mut front_perm_buf = ChunkSeq::new[u8]();
    let front_perm_end = if has_front_perm {
        front_perm_buf.reserve(268435456);
        stage2_heap_mark()
    } else {
        0
    };
    let front_perm = if has_front_perm {
        wrapping_sub(front_perm_end, 268435456)
    } else {
        0
    };
    let m_front = front_perm_end;
    let mut a = assembly_begin_bytes(in encoded.as_slice());
    write_stage(want_syms, in out_wasm, in "assemble_next", inout stage_log);
    let mut mods = ChunkSeq::new[AssembledModule]();
    loop {
        match assemble_next_bytes(inout a, in encoded.as_slice()) {
            Option::Some(m) => {
                mods.push(sink m);
            },
            Option::None => break,
        }
    }
    let meta = assembly_metadata(sink a);
    if meta.diagnostics.len() > 0 {
        write_err_header(in out_wasm, in "assembly", in meta.diagnostics.as_slice());
        return (2, meta.diagnostics.len());
    }
    write_stage(want_syms, in out_wasm, in "collect_program", inout stage_log);
    let collected = collect_program(in mods);
    write_stage(want_syms, in out_wasm, in "build_ir_ast", inout stage_log);
    let (ir_ast0, names0_in, types0_in, world0_in) = build_ir_ast_for_entry(
        sink collected,
        in mods,
        in entry_name
    );
    write_stage(want_syms, in out_wasm, in "front_clone", inout stage_log);
    let (ir_ast, names0, types0, world0, front_used, front_ok) = move_front_to_perm(
        sink ir_ast0,
        sink names0_in,
        sink types0_in,
        sink world0_in,
        front_perm,
        m_front
    );
    if want_syms && m_front != 0 {
        stage_log.extend(in "front_used=".as_bytes());
        push_decimal(inout stage_log, front_used >> 20);
        stage_log.extend(in " MiB\n".as_bytes());
    }
    if front_ok {
        stage2_heap_reset(m_front);
        write_stage(want_syms, in out_wasm, in "typecheck_ast (front_reset=ok)", inout stage_log);
    } else if m_front != 0 {
        write_stage(
            want_syms,
            in out_wasm,
            in "typecheck_ast (front_reset=OVERFLOW)",
            inout stage_log
        );
    } else {
        write_stage(want_syms, in out_wasm, in "typecheck_ast", inout stage_log);
    }
    let (names, types, world, call_rows, call_pairs) = typecheck_ast(
        in ir_ast,
        sink names0,
        sink types0,
        sink world0,
        native_elf
    );
    let mut c = Ctx {
        names: names,
        types: types,
        world: world,
        tmap: ChunkSeq::new[u32](),
        nmap: ChunkSeq::new[u32]()
    };
    let entry_sym = c.names.intern(in entry_name.as_bytes());
    let mut facts = empty_facts(entry_sym, 65535, 65536, 50000000);
    facts.calls = call_rows;
    facts.pairs = call_pairs;
    write_stage(want_syms, in out_wasm, in "lower_all", inout stage_log);
    let mut low = l_new(sink c, sink ir_ast);
    lower_all(inout low);
    if native_elf {
        write_stage(want_syms, in out_wasm, in "native_backend", inout stage_log);
        return write_native_object(in low, entry_sym, in entry_name, in out_wasm);
    }
    mark_mut_element_views(inout low);
    for fi in 0..low.ast.fns.len() {
        match low.ast.fns.try_get(fi) {
            Option::Some(f) => {
                let mut gnames = ChunkSeq::new[u32]();
                let mut grows = ChunkSeq::new[bool]();
                for gi in 0..f.generic_count {
                    match low.ast.gens.try_get(wrapping_add(f.generic_start, gi)) {
                        Option::Some(g) => {
                            gnames.push(g.name);
                            grows.push(g.is_row);
                        },
                        Option::None => {},
                    }
                }
                let mut pnames = ChunkSeq::new[u32]();
                let mut ppasses = ChunkSeq::new[u8]();
                let mut ptys = ChunkSeq::new[u32]();
                for pi in 0..f.param_count {
                    match low.ast.pms.try_get(wrapping_add(f.param_start, pi)) {
                        Option::Some(pm) => {
                            pnames.push(pm.name);
                            ppasses.push(pm.pass);
                            ptys.push(pm.ty);
                        },
                        Option::None => {},
                    }
                }
                add_fn_sig(
                    inout facts,
                    in low.ctx,
                    f.name,
                    in gnames,
                    in grows,
                    in pnames,
                    in ppasses,
                    in ptys,
                    f.result,
                    f.effects
                );
            },
            Option::None => {},
        }
    }
    for ei in 0..low.ast.effs.len() {
        match low.ast.effs.try_get(ei) {
            Option::Some(ef) => {
                let mut gnames = ChunkSeq::new[u32]();
                for gi in 0..ef.generic_count {
                    match low.ast.egens.try_get(wrapping_add(ef.generic_start, gi)) {
                        Option::Some(g) => gnames.push(g),
                        Option::None => {},
                    }
                }
                let mut op_names = ChunkSeq::new[u32]();
                let mut op_pa = ChunkSeq::new[u64]();
                let mut op_pn = ChunkSeq::new[u64]();
                let mut pnames = ChunkSeq::new[u32]();
                let mut ppasses = ChunkSeq::new[u8]();
                let mut ptys = ChunkSeq::new[u32]();
                let mut op_results = ChunkSeq::new[u32]();
                for oi in 0..ef.op_count {
                    match low.ast.eops.try_get(wrapping_add(ef.op_start, oi)) {
                        Option::Some(op) => {
                            op_names.push(op.name);
                            op_pa.push(pnames.len());
                            op_pn.push(op.param_count);
                            op_results.push(op.result);
                            for pi in 0..op.param_count {
                                match low.ast.pms.try_get(wrapping_add(op.param_start, pi)) {
                                    Option::Some(pm) => {
                                        pnames.push(pm.name);
                                        ppasses.push(pm.pass);
                                        ptys.push(pm.ty);
                                    },
                                    Option::None => {},
                                }
                            }
                        },
                        Option::None => {},
                    }
                }
                add_eff_decl(
                    inout facts,
                    ef.name,
                    ef.linear,
                    in gnames,
                    in op_names,
                    in op_pa,
                    in op_pn,
                    in pnames,
                    in ppasses,
                    in ptys,
                    in op_results
                );
            },
            Option::None => {},
        }
    }
    let mut c2 = low.ctx;
    let prog = low.program;
    let mut fn_by_sym = ChunkSeq::new[u32]();
    for fi in 0..prog.fns.len() {
        match prog.fns.try_get(fi) {
            Option::Some(row) => set_by_symbol(inout fn_by_sym, row.name, n32(inc(fi))),
            Option::None => {},
        }
    }
    for hi in 0..low.ast.hds.len() {
        match low.ast.hds.try_get(hi) {
            Option::Some(h) => {
                let h0 = facts.hops.len();
                push_hop(inout facts, widen_u64(h.label));
                push_hop(inout facts, widen_u64(h.eff_name));
                push_hop(inout facts, h.arg_ty_count);
                for ti in 0..h.arg_ty_count {
                    let ta = match low.ast.xs.try_get(wrapping_add(h.arg_ty_start, ti)) {
                        Option::Some(v) => v,
                        Option::None => 0,
                    };
                    push_hop(inout facts, ta);
                }
                push_hop(inout facts, if h.has_state { 1 } else { 0 });
                let bx = low.ast.ex(h.body);
                let body_fn = nested_sym(inout c2, in "$handler_body_", bx.s0, bx.s1);
                push_hop(inout facts, widen_u64(body_fn));
                let rc = low.ast.clause(h.return_clause);
                let rx = low.ast.ex(rc.body);
                let ret_fn = nested_sym(inout c2, in "$handler_clause_", rx.s0, rx.s1);
                push_hop(inout facts, widen_u64(ret_fn));
                push_hop(inout facts, rc.pattern_count);
                let mut r_binds: u64 = if h.has_state { 1 } else { 0 };
                for pi in 0..rc.pattern_count {
                    let pid = match low.ast.xs.try_get(wrapping_add(rc.pattern_start, pi)) {
                        Option::Some(v) => v,
                        Option::None => 0,
                    };
                    let pt = low.ast.pt(pid);
                    if pt.kind == Pat::Bind {
                        push_hop(inout facts, 1);
                        push_hop(inout facts, pt.s0);
                        push_hop(inout facts, pt.s1);
                        push_hop(inout facts, pt.a);
                        r_binds = inc(r_binds);
                    } else {
                        push_hop(inout facts, 0);
                        push_hop(inout facts, pt.s0);
                        push_hop(inout facts, pt.s1);
                    }
                }
                let r_ps = prog_fn_params(in prog, in fn_by_sym, ret_fn);
                let r_nfree = if r_ps.len() > r_binds {
                    wrapping_sub(r_ps.len(), r_binds)
                } else {
                    0
                };
                push_hop(inout facts, r_nfree);
                for fi in 0..r_nfree {
                    push_hop(inout facts, widen_u64(u32_at(in r_ps, fi)));
                }
                push_hop(inout facts, h.op_count);
                for oi in 0..h.op_count {
                    let oc = low.ast.clause(wrapping_add(h.return_clause, wrapping_add(oi, 1)));
                    push_hop(inout facts, widen_u64(oc.name));
                    let ox = low.ast.ex(oc.body);
                    let op_fn = nested_sym(inout c2, in "$handler_clause_", ox.s0, ox.s1);
                    push_hop(inout facts, widen_u64(op_fn));
                    push_hop(inout facts, oc.pattern_count);
                    let mut o_binds: u64 = if h.has_state { 1 } else { 0 };
                    for pi in 0..oc.pattern_count {
                        let pid = match low.ast.xs.try_get(wrapping_add(oc.pattern_start, pi)) {
                            Option::Some(v) => v,
                            Option::None => 0,
                        };
                        let pt = low.ast.pt(pid);
                        if pt.kind == Pat::Bind {
                            push_hop(inout facts, 1);
                            push_hop(inout facts, pt.s0);
                            push_hop(inout facts, pt.s1);
                            push_hop(inout facts, pt.a);
                            o_binds = inc(o_binds);
                        } else {
                            push_hop(inout facts, 0);
                            push_hop(inout facts, pt.s0);
                            push_hop(inout facts, pt.s1);
                        }
                    }
                    let o_ps = prog_fn_params(in prog, in fn_by_sym, op_fn);
                    let o_nfree = if o_ps.len() > o_binds {
                        wrapping_sub(o_ps.len(), o_binds)
                    } else {
                        0
                    };
                    push_hop(inout facts, o_nfree);
                    for fi in 0..o_nfree {
                        push_hop(inout facts, widen_u64(u32_at(in o_ps, fi)));
                    }
                }
                let b_ps = prog_fn_params(in prog, in fn_by_sym, body_fn);
                let b_non = if h.has_state { 1 } else { 0 };
                let b_nfree = if b_ps.len() > b_non {
                    wrapping_sub(b_ps.len(), b_non)
                } else {
                    0
                };
                let mut h_free = ChunkSeq::new[u32]();
                for fi in 0..b_nfree {
                    h_free.push(u32_at(in b_ps, fi));
                }
                set_expr_handler(inout facts, h.pool, h0, in h_free);
            },
            Option::None => {},
        }
    }
    write_stage(want_syms, in out_wasm, in "compile_with_facts", inout stage_log);
    let dbg_names = c2.names.snapshot_text();
    let (ok, err_w, core, wit, syms_out) = handle Fail[WErr] in {
        let (core0, wit0, _fns, _handlers, syms0) = compile_with_facts_diag(
            sink c2,
            sink prog,
            sink facts,
            want_syms
        );
        (true, werr(0, 0, 0), core0, wit0, syms0)
    } with {
        return v => v,
        raise(err, _k) => (
            false,
            err,
            ChunkSeq::new[u8](),
            ChunkSeq::new[u8](),
            ChunkSeq::new[u8]()
        ),
    };
    if !ok {
        let mut diag_out = ChunkSeq::new[u8]();
        format_werr(in err_w, in dbg_names, 0, inout diag_out);
        write_err_header(in out_wasm, in "wasm_backend", in diag_out.as_slice());
        return (3, err_w.site);
    }
    if want_syms {
        write_sidecar(in out_wasm, in ".syms", in syms_out.as_slice());
    }
    write_stage(want_syms, in out_wasm, in "wit_component", inout stage_log);
    let parsed_wit = parse_wit(in wit.as_slice());
    if parsed_wit.err != 0 {
        let mut d = ChunkSeq::new[u8]();
        d.extend(in "wit parse error code ".as_bytes());
        push_dec(inout d, parsed_wit.err);
        write_err_header(in out_wasm, in "wit_parse", in d.as_slice());
        return (5, parsed_wit.err);
    }
    let mut component = ChunkSeq::new[u8]();
    let enc_err = wit_encode(in core.as_slice(), in parsed_wit, inout component);
    if enc_err != 0 {
        let mut d = ChunkSeq::new[u8]();
        d.extend(in "wit_component encode declined code ".as_bytes());
        push_dec(inout d, enc_err);
        write_err_header(in out_wasm, in "wit_component", in d.as_slice());
        return (6, enc_err);
    }
    let clen = component.len();
    let wrote = handle Fail[IoError] in {
        write_path(in out_wasm.as_bytes(), in component.as_slice());
        true
    } with {
        return v => v,
        raise(_e, _k) => false,
    };
    if !wrote {
        let mut d = ChunkSeq::new[u8]();
        d.extend(in "IoError writing ".as_bytes());
        d.extend(in out_wasm.as_bytes());
        write_err_header(in out_wasm, in "write_wasm", in d.as_slice());
        return (OUTPUT_WRITE_FAILED, 0);
    }
    (0, clen)
}

/// CLI entry point for standalone Stage 2 Wasm execution (`vwasm stage2.wasm -- <pkg_dir> <out_wasm> [entry]`).
/// `VESPER_STAGE2_X86_64_ELF=1` requests a SysV x86-64 object for the entry.
pub fn main() -> u64 eff [Ffi[StdEnv], Ffi[StdFs]] {
    let n = arg_count();
    if n < 3 {
        return 10;
    }
    let root_dir = match arg(1) {
        Option::Some(s) => s,
        Option::None => {
            return 11;
        },
    };
    let out_wasm = match arg(2) {
        Option::Some(s) => s,
        Option::None => {
            return 12;
        },
    };
    let want_syms = match var(in "VESPER_STAGE2_SYMS") {
        Option::Some(v) => v.as_bytes().len() > 0,
        Option::None => false,
    };
    let native_elf = match var(in "VESPER_STAGE2_X86_64_ELF") {
        Option::Some(value) => value.as_bytes().len() == 1
            && value.as_bytes().try_get(0).unwrap_or(0) == ASCII_ONE,
        Option::None => false,
    };
    let (code, val) = if n >= 4 {
        match arg(3) {
            Option::Some(s) => stage2_compile_dir_impl(
                in root_dir.as_str(),
                in out_wasm.as_str(),
                in s.as_str(),
                want_syms,
                native_elf
            ),
            Option::None => stage2_compile_dir_impl(
                in root_dir.as_str(),
                in out_wasm.as_str(),
                in "main",
                want_syms,
                native_elf
            ),
        }
    } else {
        stage2_compile_dir_impl(
            in root_dir.as_str(),
            in out_wasm.as_str(),
            in "main",
            want_syms,
            native_elf
        )
    };
    if code == 0 {
        0
    } else {
        wrapping_add(wrapping_mul(code, 1000000), val)
    }
}
