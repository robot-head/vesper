use @vesper/check-data::types::{TyKind, TyPass};
use @vesper/check-data::util::{add, inc, n32, u32_at, w};
use @vesper/check-data::world::{set_by_symbol};
use @vesper/hybrid-native-backend::elf::{x86_text_object};
use @vesper/hybrid-native-backend::scalar::{
    ADD, AND, BLOCK_LABEL, BLOCK_RETURN, BRANCH_BLOCK, CALL, CALL_ARGUMENT, COMPARE, COMPARE_BYTE,
    COMPARE_DWORD, COMPARE_IMMEDIATE, COMPARE_WORD, CONSTANT, EQUAL, HEADER_WORDS, JUMP_LABEL,
    MAX_ARGUMENTS, MUL, NOT_EQUAL, NO_VALUE, NOT, OR, RECORD_WORDS, RETURN_VALUE, SIGNED_GREATER,
    SIGNED_GREATER_EQUAL, SIGNED_LESS, SIGNED_LESS_EQUAL, SIGN_EXTEND, STACK_LOAD, STACK_SLOT,
    STACK_STORE_QWORD, SUB, TRUNCATE, UNSIGNED_GREATER, UNSIGNED_GREATER_EQUAL, UNSIGNED_LESS,
    UNSIGNED_LESS_EQUAL, XOR, encode_block
};
use @vesper/hybrid-native-backend::x86_64::{
    ALL_REGISTER_BITS, BYTE_BITS, DWORD_BITS, QWORD_BITS, WORD_BITS
};
use @vesper/place-ir::{BlockRow, FnRow, InstRow, Lit, Op, Pat, Tag, Term};
use @vesper/place-ir-lower::ast::{FnR};
use @vesper/place-ir-lower::lower::{L};

const LITERAL_WORDS: u64 = 3;
const BINARY_WORDS: u64 = 3;
const UNARY_WORDS: u64 = 2;
const PLAIN_READ_WORDS: u64 = 4;
const LITERAL_LOW: u64 = 1;
const LITERAL_HIGH: u64 = 2;
const BINARY_LHS: u64 = 1;
const BINARY_RHS: u64 = 2;
const UNARY_VALUE: u64 = 1;
const READ_PATH: u64 = 1;
const READ_PASS: u64 = 2;
const READ_PROJECTIONS: u64 = 3;
const BIND_PATTERN: u64 = 1;
const PATTERN_HEADER_WORDS: u64 = 3;
const BIND_NAME: u64 = BIND_PATTERN + PATTERN_HEADER_WORDS;
const WRITE_WORDS: u64 = 3;
const WRITE_OPERATOR: u64 = 1;
const WRITE_VALUE: u64 = 2;
const EXIT_WORDS: u64 = 2;
const EXIT_OWNER: u64 = 1;
const RANGE_CURSOR_READ_DISTANCE: u64 = 2;
const RANGE_CURSOR_PREFIX: Str = "$loop";
const BLOCK_HEADER_WORDS: u64 = 4;
const BLOCK_INCOMING_COUNT: u64 = 1;
const BLOCK_INCOMING_WORDS: u64 = 2;
const BRANCH_WORDS: u64 = 3;
const BRANCH_TRUE: u64 = 1;
const BRANCH_FALSE: u64 = 2;
const MATCH_ARM_COUNT: u64 = 1;
const MATCH_FIRST_ARM: u64 = 2;
const DIRECT_MATCH_ARM_LIMIT: u64 = 2;
const ALL_BOOL_PATTERNS: u64 = 3;
const JUMP_ARGUMENT_COUNT: u64 = 1;
const JUMP_ARGUMENT: u64 = 2;
const HOME_BYTES: u64 = QWORD_BITS / BYTE_BITS;
const HOME_SLOT: u64 = 0;
const SCALAR_RESULTS: u64 = 1;
const CALL_COUNT: u64 = 1;
const CALL_ARGUMENTS: u64 = 2;
const ARGUMENT_WORDS: u64 = 4;
const ARGUMENT_VALUE: u64 = 1;
const ARGUMENT_PATH: u64 = 3;
// A supported function has no parameter projections, bounds, or captures.
const PARAMETER_WORDS: u64 = 6;
const VALUE_TYPES_COUNT: u64 = 4;
const VALUE_TYPE_WORDS: u64 = 2;
const WRAPPING_CONVERSION_PREFIX: Str = "wrapping_";
const WIDEN_CONVERSION_PREFIX: Str = "widen_";

enum ScalarKind: _ {
    Unsupported = 0,
    U64 = 1,
    I64 = 2,
    Bool = 3,
    Unit = 4,
    U8 = 5,
    I8 = 6,
    U16 = 7,
    I16 = 8,
    U32 = 9,
    I32 = 10,
    Usize = 11,
    Isize = 12,
}

struct CallGraph {
    indices: ChunkSeq[u64],
    pending: ChunkSeq[u64],
}

impl CallGraph {
    fn discover(inout self, index: u64) -> u64 {
        let existing = self.indices.try_get(index).unwrap_or(NO_VALUE);
        if existing != NO_VALUE {
            return existing;
        }
        let id = self.pending.len();
        if !self.indices.try_set(index, id) {
            return NO_VALUE;
        }
        self.pending.push(index);
        id
    }
}

copy struct Value {
    owner: u64,
    home: u64,
    live: u64,
    block: u64,
    machine: u64,
}

struct Function {
    arguments: u64,
    result: u8,
    words: ChunkSeq[u64],
    values: ChunkSeq[Value],
    kinds: ChunkSeq[u8],
    labels: ChunkSeq[u64],
    blocks: ChunkSeq[u64],
    next_label: u64,
    bindings: ChunkSeq[u32],
    mutable_slots: ChunkSeq[u32],
    mutable_bytes: u64,
    home_bytes: u64,
}

fn value_new(owner: u64) -> Value {
    Value { owner: owner, home: NO_VALUE, live: 0, block: NO_VALUE, machine: NO_VALUE }
}

fn block_bit(block: u64) -> u64 {
    wrapping_shl_u64(1, wrapping_u32(block))
}

impl Function {
    fn kind(in self, id: u64) -> u8 {
        self.kinds.try_get(id).unwrap_or(ScalarKind::Unsupported)
    }

    fn label(in self, block: u64) -> u64 {
        self.labels.try_get(block).unwrap_or(NO_VALUE)
    }

    fn mutable_offset(in self, name: u32) -> u64 {
        // Keep mutable cells after the packed, live-range-based SSA homes.
        let slot = u32_at(in self.mutable_slots, w(name));
        if slot == 0 {
            NO_VALUE
        } else {
            add(self.home_bytes, wrapping_mul(wrapping_sub(w(slot), 1), HOME_BYTES))
        }
    }

    fn record(inout self, op: u64, lhs: u64, rhs: u64, extra: u64) -> u64 {
        let value = add(
            self.arguments,
            wrapping_sub(self.words.len(), HEADER_WORDS) / RECORD_WORDS
        );
        self.words.push(op);
        self.words.push(lhs);
        self.words.push(rhs);
        self.words.push(extra);
        value
    }

    fn home(inout self, id: u64, block: u64) -> bool {
        let mut value = self.values.try_get(id).unwrap_or(value_new(NO_VALUE));
        if value.owner == NO_VALUE {
            return false;
        }
        if value.home == NO_VALUE {
            value.home = self.home_bytes;
            self.home_bytes = add(self.home_bytes, HOME_BYTES);
        }
        value.live = value.live | block_bit(block);
        self.values.try_set(id, value)
    }

    fn use_in(inout self, id: u64, block: u64) -> bool {
        let v = self.values.try_get(id).unwrap_or(value_new(NO_VALUE));
        v.owner == block || self.home(id, block)
    }

    fn define(inout self, id: u64, block: u64, machine: u64) -> bool {
        let mut value = self.values.try_get(id).unwrap_or(value_new(NO_VALUE));
        value.block = block;
        value.machine = machine;
        if value.home != NO_VALUE {
            let _ = self.record(STACK_STORE_QWORD, machine, HOME_SLOT, value.home);
        }
        self.values.try_set(id, value)
    }

    fn read(inout self, id: u64, block: u64) -> u64 {
        let mut value = self.values.try_get(id).unwrap_or(value_new(NO_VALUE));
        if value.block == block {
            return value.machine;
        }
        if value.home == NO_VALUE {
            return NO_VALUE;
        }
        value.machine = self.record(STACK_LOAD, HOME_SLOT, value.home, QWORD_BITS);
        value.block = block;
        let _ = self.values.try_set(id, value);
        value.machine
    }
}

fn lower_operator(in low: L, symbol: u32) -> u64 {
    if low.ctx.names.spells(symbol, in "wrapping_add".as_bytes()) {
        ADD
    } else if low.ctx.names.spells(symbol, in "wrapping_sub".as_bytes()) {
        SUB
    } else if low.ctx.names.spells(symbol, in "wrapping_mul".as_bytes()) {
        MUL
    } else if low.ctx.names.spells(symbol, in "&".as_bytes()) {
        AND
    } else if low.ctx.names.spells(symbol, in "|".as_bytes()) {
        OR
    } else if low.ctx.names.spells(symbol, in "^".as_bytes()) {
        XOR
    } else {
        NO_VALUE
    }
}

fn integer_comparison(in low: L, symbol: u32, kind: u8) -> u64 {
    let signed = is_signed(kind);
    if low.ctx.names.spells(symbol, in "==".as_bytes()) {
        EQUAL
    } else if low.ctx.names.spells(symbol, in "!=".as_bytes()) {
        NOT_EQUAL
    } else if !is_integer(kind) {
        NO_VALUE
    } else if low.ctx.names.spells(symbol, in "<".as_bytes()) {
        if signed { SIGNED_LESS } else { UNSIGNED_LESS }
    } else if low.ctx.names.spells(symbol, in "<=".as_bytes()) {
        if signed {
            SIGNED_LESS_EQUAL
        } else {
            UNSIGNED_LESS_EQUAL
        }
    } else if low.ctx.names.spells(symbol, in ">".as_bytes()) {
        if signed {
            SIGNED_GREATER
        } else {
            UNSIGNED_GREATER
        }
    } else if low.ctx.names.spells(symbol, in ">=".as_bytes()) {
        if signed {
            SIGNED_GREATER_EQUAL
        } else {
            UNSIGNED_GREATER_EQUAL
        }
    } else {
        NO_VALUE
    }
}

fn is_integer(kind: u8) -> bool {
    kind != ScalarKind::Bool && abi_width(kind) != 0
}

fn is_signed(kind: u8) -> bool {
    kind == ScalarKind::I8
        || kind == ScalarKind::I16
        || kind == ScalarKind::I32
        || kind == ScalarKind::I64
        || kind == ScalarKind::Isize
}

fn abi_width(kind: u8) -> u64 {
    match kind {
        ScalarKind::Bool | ScalarKind::U8 | ScalarKind::I8 => BYTE_BITS,
        ScalarKind::U16 | ScalarKind::I16 => WORD_BITS,
        ScalarKind::U32 | ScalarKind::I32 => DWORD_BITS,
        ScalarKind::U64 | ScalarKind::I64 | ScalarKind::Usize | ScalarKind::Isize => QWORD_BITS,
        _ => 0,
    }
}

fn scalar_kind(in low: L, ty: u32) -> u8 {
    if ty == low.ctx.types.unit {
        return ScalarKind::Unit;
    }
    let node = low.ctx.types.node(ty);
    if node.kind != TyKind::Named || node.n != 0 {
        return ScalarKind::Unsupported;
    }
    let k = low.ctx.world.k;
    if node.name == k.u64_ {
        ScalarKind::U64
    } else if node.name == k.i64_ {
        ScalarKind::I64
    } else if node.name == k.bool_ {
        ScalarKind::Bool
    } else if node.name == k.unit {
        ScalarKind::Unit
    } else if node.name == k.u8_ {
        ScalarKind::U8
    } else if node.name == k.i8_ {
        ScalarKind::I8
    } else if node.name == k.u16_ {
        ScalarKind::U16
    } else if node.name == k.i16_ {
        ScalarKind::I16
    } else if node.name == k.u32_ {
        ScalarKind::U32
    } else if node.name == k.i32_ {
        ScalarKind::I32
    } else if node.name == k.usize_ {
        ScalarKind::Usize
    } else if node.name == k.isize_ {
        ScalarKind::Isize
    } else {
        ScalarKind::Unsupported
    }
}

fn sysv_signature(in low: L, f: FnR) -> bool {
    if !f.has_body
        || f.generic_count != 0
        || f.ext_count != 0
        || f.param_count > MAX_ARGUMENTS
        || abi_width(scalar_kind(in low, f.result)) == 0
        || f.effects != low.ctx.types.empty_row
    {
        return false;
    }
    for index in 0..f.param_count {
        let p = low.ast.param(add(f.param_start, index));
        if p.proj_count != 0
            || p.pass == TyPass::Inout
            || abi_width(scalar_kind(in low, p.ty)) == 0
        {
            return false;
        }
    }
    true
}

fn argument_value(in low: L, f: FnR, root: u32) -> u64 {
    for index in 0..f.param_count {
        if low.ast.param(add(f.param_start, index)).name == root {
            return index;
        }
    }
    NO_VALUE
}

fn place_value(in low: L, f: FnR, root: u32, in m: Function) -> u64 {
    let binding = u32_at(in m.bindings, w(root));
    if binding == 0 {
        argument_value(in low, f, root)
    } else {
        add(m.arguments, wrapping_sub(w(binding), 1))
    }
}

fn collect_binding(in low: L, inst: InstRow, inout m: Function) -> bool {
    let pattern = low.program.op(add(inst.a, BIND_PATTERN));
    if pattern == Pat::Wild {
        return inst.n == BIND_NAME;
    }
    if pattern != Pat::Bind || inst.n != inc(BIND_NAME) {
        return false;
    }
    // Place IR gives shadowed bindings distinct names. A binding with no
    // writes can reuse its initial SSA value.
    let name = n32(low.program.op(add(inst.a, BIND_NAME)));
    if u32_at(in m.bindings, w(name)) != 0 {
        return false;
    }
    set_by_symbol(inout m.bindings, name, n32(inc(low.program.op(inst.a))));
    true
}

fn collect_mutable_slots(in low: L, row: FnRow, inout m: Function) -> bool {
    let mut count: u32 = 0;
    for layout in 0..m.blocks.len() {
        let block = m.blocks.try_get(layout).unwrap_or(0);
        let b = low.program.block(add(row.b0, block));
        for index in b.i0..add(b.i0, b.ic) {
            let inst = low.program.inst(index);
            if inst.op != Op::Write {
                continue;
            }
            let name = n32(low.program.op(inst.a));
            let op = n32(low.program.op(add(inst.a, WRITE_OPERATOR)));
            if inst.n != WRITE_WORDS
                || inst.fallible != 0
                || !low.ctx.names.spells(op, in "=".as_bytes())
                || u32_at(in m.bindings, w(name)) == 0
            {
                return false;
            }
            if u32_at(in m.mutable_slots, w(name)) == 0 {
                count = wrapping_add(count, 1);
                set_by_symbol(inout m.mutable_slots, name, count);
            }
        }
    }
    m.mutable_bytes = wrapping_mul(w(count), HOME_BYTES);
    true
}

fn lower_local_store(in low: L, inst: InstRow, block: u64, inout m: Function) -> bool {
    let at = inst.a;
    if inst.op == Op::Bind {
        let pattern = low.program.op(add(at, BIND_PATTERN));
        if pattern == Pat::Wild || pattern == Pat::Literal {
            // Planning confirms that literal binds belong to match arms.
            return m.kind(low.program.op(at)) != ScalarKind::Unsupported;
        }
    }
    let name_at = if inst.op == Op::Bind {
        add(at, BIND_NAME)
    } else {
        at
    };
    let name = n32(low.program.op(name_at));
    let offset = m.mutable_offset(name);
    let source_at = if inst.op == Op::Bind {
        at
    } else {
        add(at, WRITE_VALUE)
    };
    let source = low.program.op(source_at);
    let kind = m.kind(source);
    if offset == NO_VALUE {
        return inst.op == Op::Bind && kind != ScalarKind::Unsupported;
    }
    let initial = u32_at(in m.bindings, w(name));
    if initial == 0
        || kind == ScalarKind::Unsupported
        || kind == ScalarKind::Unit
        || kind != m.kind(wrapping_sub(w(initial), 1))
    {
        return false;
    }
    let value = m.read(add(m.arguments, source), block);
    if value == NO_VALUE {
        return false;
    }
    let _ = m.record(STACK_STORE_QWORD, value, HOME_SLOT, offset);
    true
}

fn call_arity(in low: L, inst: InstRow) -> u64 {
    let count = low.program.op(add(inst.a, CALL_COUNT));
    if count > MAX_ARGUMENTS {
        return NO_VALUE;
    }
    let type_args = add(CALL_ARGUMENTS, wrapping_mul(count, ARGUMENT_WORDS));
    let capability = inc(type_args);
    if inst.n != inc(capability)
        || low.program.op(add(inst.a, type_args)) != 0
        || low.program.op(add(inst.a, capability)) != 0
    {
        return NO_VALUE;
    }
    count
}

fn call_argument(at: u64, index: u64) -> u64 {
    add(add(at, CALL_ARGUMENTS), wrapping_mul(index, ARGUMENT_WORDS))
}

fn lower_call(
    in low: L,
    inst: InstRow,
    block: u64,
    inout m: Function,
    inout graph: CallGraph
) -> u64 {
    let index = low.ast.fn_index(n32(low.program.op(inst.a)));
    let count = call_arity(in low, inst);
    if count == NO_VALUE || index >= low.ast.fns.len() {
        return NO_VALUE;
    }
    let callee = low.ast.function(index);
    if count != callee.param_count
        || !sysv_signature(in low, callee)
        || scalar_kind(in low, inst.ty) != scalar_kind(in low, callee.result)
    {
        return NO_VALUE;
    }
    let mut args = ChunkSeq::new[u64]();
    for i in 0..count {
        let at = call_argument(inst.a, i);
        let operand = low.program.op(add(at, ARGUMENT_VALUE));
        let param = low.ast.param(add(callee.param_start, i));
        if low.program.op(at) == TyPass::Inout
            || low.program.path(low.program.op(add(at, ARGUMENT_PATH))).n != 0
            || m.kind(operand) != scalar_kind(in low, param.ty)
        {
            return NO_VALUE;
        }
        let value = m.read(add(m.arguments, operand), block);
        if value == NO_VALUE {
            return NO_VALUE;
        }
        args.push(value);
    }
    let target = graph.discover(index);
    if target == NO_VALUE {
        return NO_VALUE;
    }
    // Operand loads must precede the contiguous call argument records.
    for i in 0..count {
        let _ = m.record(CALL_ARGUMENT, args.try_get(i).unwrap_or(NO_VALUE), 0, 0);
    }
    m.record(CALL, target, count, 0)
}

fn block_parameter(in low: L, b: BlockRow) -> u64 {
    let incoming = low.program.op(add(b.ha, BLOCK_INCOMING_COUNT));
    let first = add(BLOCK_HEADER_WORDS, wrapping_mul(incoming, BLOCK_INCOMING_WORDS));
    if b.hn == inc(first) {
        low.program.op(add(b.ha, first))
    } else {
        NO_VALUE
    }
}

fn match_target_word(in low: L, pattern: u64, end: u64) -> u64 {
    if pattern >= end {
        return NO_VALUE;
    }
    let extra = match low.program.op(pattern) {
        Pat::Wild => 0,
        Pat::Bind => 1,
        Pat::Literal => LITERAL_WORDS,
        _ => return NO_VALUE,
    };
    let target = add(add(pattern, PATTERN_HEADER_WORDS), extra);
    if target >= end || low.program.tag(target) != Tag::Block {
        NO_VALUE
    } else {
        target
    }
}

fn is_match_literal_binding(in low: L, row: FnRow, b: BlockRow, index: u64, inst: InstRow) -> bool {
    if index != b.i0
        || inst.n != add(BIND_NAME, LITERAL_WORDS)
        || low.program.op(add(inst.a, BIND_PATTERN)) != Pat::Literal
    {
        return false;
    }
    let count = add(b.ha, BLOCK_INCOMING_COUNT);
    if low.program.op(count) != 1 {
        return false;
    }
    let pred = low.program.block(add(row.b0, low.program.op(inc(count))));
    pred.term == Term::Match && low.program.op(pred.ta) == low.program.op(inst.a)
}

fn queue_block(inout labels: ChunkSeq[u64], inout pending: ChunkSeq[u64], target: u64) -> bool {
    if target >= labels.len() {
        return false;
    }
    if labels.try_get(target).unwrap_or(NO_VALUE) == NO_VALUE {
        let _ = labels.try_set(target, 0);
        pending.push(target);
    }
    true
}

// A `break` or `continue` can be followed by synthetic blocks with no
// reachable predecessor. Assign labels only to reachable blocks, keeping
// their original layout order so the encoder can retain fallthroughs.
fn plan_blocks(in low: L, row: FnRow, inout m: Function) -> bool {
    m.labels.resize(row.bc, NO_VALUE);
    let mut pending = ChunkSeq::new[u64]();
    if !queue_block(inout m.labels, inout pending, 0) {
        return false;
    }
    let mut index: u64 = 0;
    loop {
        let block = match pending.try_get(index) {
            Option::Some(found) => found,
            Option::None => break,
        };
        let b = low.program.block(add(row.b0, block));
        if b.term == Term::Jump {
            if !queue_block(inout m.labels, inout pending, low.program.op(b.ta)) {
                return false;
            }
        } else if b.term == Term::Branch {
            let yes = low.program.op(add(b.ta, BRANCH_TRUE));
            let no = low.program.op(add(b.ta, BRANCH_FALSE));
            if !queue_block(inout m.labels, inout pending, yes)
                || !queue_block(inout m.labels, inout pending, no)
            {
                return false;
            }
        } else if b.term == Term::Match {
            let count = low.program.op(add(b.ta, MATCH_ARM_COUNT));
            let end = add(b.ta, b.tn);
            let mut pattern = add(b.ta, MATCH_FIRST_ARM);
            for arm in 0..count {
                let target = match_target_word(in low, pattern, end);
                if target == NO_VALUE
                    || !queue_block(inout m.labels, inout pending, low.program.op(target))
                {
                    return false;
                }
                if low.program.op(pattern) != Pat::Literal {
                    break;
                }
                pattern = inc(target);
            }
        }
        index = inc(index);
    }
    for block in 0..row.bc {
        if m.label(block) != NO_VALUE {
            let _ = m.labels.try_set(block, m.blocks.len());
            m.blocks.push(block);
        }
    }
    m.next_label = m.blocks.len();
    true
}

fn plan_types(in low: L, row: FnRow, inout m: Function) -> bool {
    // After the parameters come the result, effects, bound count and capture
    // count, then the table of (value ID, type ID) pairs.
    let after_parameters = inc(add(row.ha, wrapping_mul(m.arguments, PARAMETER_WORDS)));
    let count_at = add(after_parameters, VALUE_TYPES_COUNT);
    let end = add(row.ha, row.hn);
    if count_at >= end {
        return false;
    }
    let first = inc(count_at);
    let count = low.program.op(count_at);
    if count > wrapping_sub(end, first) / VALUE_TYPE_WORDS {
        return false;
    }
    m.kinds.resize(wrapping_sub(m.values.len(), m.arguments), ScalarKind::Unsupported);
    for i in 0..count {
        let at = add(first, wrapping_mul(i, VALUE_TYPE_WORDS));
        let ty_at = inc(at);
        if low.program.tag(at) != Tag::Value || low.program.tag(ty_at) != Tag::Type {
            return false;
        }
        let kind = scalar_kind(in low, n32(low.program.op(ty_at)));
        if !m.kinds.try_set(low.program.op(at), kind) {
            return false;
        }
    }
    true
}

// Walk backward from each use to its definition. Jump operands are read
// before the destination parameter is written, so those two lifetimes may
// share a home at the edge. A block in both sets keeps distinct homes.
fn home_liveness(in predecessors: ChunkSeq[u64], v: Value) -> u64 {
    let mut live = block_bit(v.owner);
    let mut pending = v.live & ~live;
    loop {
        if pending == 0 {
            return live;
        }
        let block = w(trailing_zeros_u64(pending));
        let bit = block_bit(block);
        live = live | bit;
        pending = (pending | predecessors.try_get(block).unwrap_or(0)) & ~live;
    }
}

fn pack_homes(in low: L, row: FnRow, inout m: Function) {
    // Each bit denotes a block. Large functions retain the initial unique slots.
    if m.home_bytes == 0 || row.bc > QWORD_BITS {
        return;
    }
    let mut predecessors = ChunkSeq::new[u64]();
    for block in 0..row.bc {
        let b = low.program.block(add(row.b0, block));
        let count_at = add(b.ha, BLOCK_INCOMING_COUNT);
        let mut mask: u64 = 0;
        for edge in 0..low.program.op(count_at) {
            let source = add(inc(count_at), wrapping_mul(edge, BLOCK_INCOMING_WORDS));
            let pred = low.program.op(source);
            if m.label(pred) != NO_VALUE {
                mask = mask | block_bit(pred);
            }
        }
        predecessors.push(mask);
    }
    let mut occupied = ChunkSeq::new[u64]();
    for id in 0..m.values.len() {
        let mut value = m.values.try_get(id).unwrap_or(value_new(NO_VALUE));
        if value.home == NO_VALUE {
            continue;
        }
        let live = home_liveness(in predecessors, value);
        let mut cell: u64 = 0;
        loop {
            match occupied.try_get(cell) {
                Option::Some(other) => {
                    if (live & other) == 0 {
                        let _ = occupied.try_set(cell, live | other);
                        break;
                    }
                },
                Option::None => {
                    occupied.push(live);
                    break;
                },
            }
            cell = inc(cell);
        }
        value.home = wrapping_mul(cell, HOME_BYTES);
        let _ = m.values.try_set(id, value);
    }
    m.home_bytes = wrapping_mul(occupied.len(), HOME_BYTES);
}

// Stack homes hold branch results and the values read outside their defining block.
fn plan_homes(in low: L, f: FnR, row: FnRow, inout m: Function) -> bool {
    let mut value_count: u64 = 0;
    let mut has_writes = false;
    for block in 0..row.bc {
        let b = low.program.block(add(row.b0, block));
        let reachable = m.label(block) != NO_VALUE;
        let param = block_parameter(in low, b);
        if param != NO_VALUE && param >= value_count {
            value_count = inc(param);
        }
        for index in b.i0..add(b.i0, b.ic) {
            let inst = low.program.inst(index);
            let dest = w(inst.dest);
            if dest >= value_count {
                value_count = inc(dest);
            }
            if reachable {
                if inst.op == Op::Bind
                    && !is_match_literal_binding(in low, row, b, index, inst)
                    && !collect_binding(in low, inst, inout m)
                {
                    return false;
                }
                has_writes = has_writes || inst.op == Op::Write;
            }
        }
    }
    m.values.resize(add(f.param_count, value_count), value_new(NO_VALUE));
    if !plan_types(in low, row, inout m)
        || (has_writes && !collect_mutable_slots(in low, row, inout m))
    {
        return false;
    }
    if m.blocks.len() == 1 {
        return block_parameter(in low, low.program.block(row.b0)) == NO_VALUE;
    }
    for arg in 0..f.param_count {
        let _ = m.values.try_set(arg, value_new(0));
    }
    for layout in 0..m.blocks.len() {
        let block = m.blocks.try_get(layout).unwrap_or(0);
        let b = low.program.block(add(row.b0, block));
        let param = block_parameter(in low, b);
        if param != NO_VALUE {
            let id = add(f.param_count, param);
            if !m.values.try_set(id, value_new(block))
                || (m.kind(param) != ScalarKind::Unit && !m.home(id, block))
            {
                return false;
            }
        }
        for index in b.i0..add(b.i0, b.ic) {
            let inst = low.program.inst(index);
            if !m.values.try_set(add(f.param_count, w(inst.dest)), value_new(block)) {
                return false;
            }
        }
    }
    for layout in 0..m.blocks.len() {
        let block = m.blocks.try_get(layout).unwrap_or(0);
        let b = low.program.block(add(row.b0, block));
        for index in b.i0..add(b.i0, b.ic) {
            let inst = low.program.inst(index);
            let at = inst.a;
            if inst.op == Op::Read {
                let name = n32(low.program.op(at));
                let value = place_value(in low, f, name, in m);
                if m.mutable_offset(name) == NO_VALUE && !m.use_in(value, block) {
                    return false;
                }
            } else if inst.op == Op::Write {
                if !m.use_in(add(f.param_count, low.program.op(add(at, WRITE_VALUE))), block) {
                    return false;
                }
            } else if inst.op == Op::Bind && inst.n == inc(BIND_NAME) {
                let name = n32(low.program.op(add(at, BIND_NAME)));
                if m.mutable_offset(name) != NO_VALUE
                    && !m.use_in(add(f.param_count, low.program.op(at)), block)
                {
                    return false;
                }
            } else if inst.op == Op::Binary {
                let lhs = add(f.param_count, low.program.op(add(at, BINARY_LHS)));
                let rhs = add(f.param_count, low.program.op(add(at, BINARY_RHS)));
                if !m.use_in(lhs, block) || !m.use_in(rhs, block) {
                    return false;
                }
            } else if inst.op == Op::Unary {
                if !m.use_in(add(f.param_count, low.program.op(add(at, UNARY_VALUE))), block) {
                    return false;
                }
            } else if inst.op == Op::Exit {
                if !m.use_in(add(f.param_count, low.program.op(at)), block) {
                    return false;
                }
            } else if inst.op == Op::Call {
                let count = call_arity(in low, inst);
                if count == NO_VALUE {
                    return false;
                }
                for i in 0..count {
                    let argument = add(call_argument(at, i), ARGUMENT_VALUE);
                    if !m.use_in(add(f.param_count, low.program.op(argument)), block) {
                        return false;
                    }
                }
            }
        }
        if b.term == Term::Branch || b.term == Term::Return || b.term == Term::Match {
            let source = add(f.param_count, low.program.op(b.ta));
            if !m.use_in(source, block) {
                return false;
            }
            if b.term == Term::Match
                && low.program.op(add(b.ta, MATCH_ARM_COUNT)) > DIRECT_MATCH_ARM_LIMIT
                && low.program.op(add(b.ta, MATCH_FIRST_ARM)) == Pat::Literal
                && !m.home(source, block)
            {
                return false;
            }
        } else if b.term == Term::Jump && b.tn == inc(JUMP_ARGUMENT) {
            let id = low.program.op(add(b.ta, JUMP_ARGUMENT));
            if m.kind(id) != ScalarKind::Unit && !m.use_in(add(f.param_count, id), block) {
                return false;
            }
        }
    }
    pack_homes(in low, row, inout m);
    true
}

fn literal_bits(in low: L, at: u64, kind: u8) -> Option[u64] {
    let literal = low.program.op(at);
    let bits = low.program.op(add(at, LITERAL_LOW));
    let high = low.program.op(add(at, LITERAL_HIGH));
    if kind == ScalarKind::Bool && literal == Lit::Bool && bits <= 1 && high == 0 {
        return Option::Some(bits);
    }
    if !is_integer(kind) || literal != Lit::Int {
        return Option::None;
    }
    let width = abi_width(kind);
    let mask = wrapping_shr_u64(ALL_REGISTER_BITS, wrapping_u32(wrapping_sub(QWORD_BITS, width)));
    let upper_mask = mask ^ ALL_REGISTER_BITS;
    let sign = wrapping_shl_u64(1, wrapping_u32(wrapping_sub(width, 1)));
    let fill = if is_signed(kind) && (bits & sign) != 0 {
        ALL_REGISTER_BITS
    } else {
        0
    };
    if high != fill || (bits & upper_mask) != (fill & upper_mask) {
        return Option::None;
    }
    Option::Some(bits & mask)
}

fn lower_literal(in low: L, at: u64, kind: u8, inout m: Function) -> u64 {
    match literal_bits(in low, at, kind) {
        Option::Some(bits) => m.record(CONSTANT, bits, 0, 0),
        Option::None => NO_VALUE,
    }
}

fn conversion_spells(in low: L, op: u32, target: u32, in prefix: Slice[u8]) -> bool {
    let count = low.ctx.names.size(target);
    if low.ctx.names.size(op) != add(prefix.len(), count)
        || !low.ctx.names.has_prefix(op, in prefix)
    {
        return false;
    }
    for i in 0..count {
        if low.ctx.names.byte(op, add(prefix.len(), i)) != low.ctx.names.byte(target, i) {
            return false;
        }
    }
    true
}

fn lower_unary(in low: L, inst: InstRow, kind: u8, block: u64, inout m: Function) -> u64 {
    let at = inst.a;
    let symbol = n32(low.program.op(at));
    let operand = low.program.op(add(at, UNARY_VALUE));
    let operand_kind = m.kind(operand);
    let value = m.read(add(m.arguments, operand), block);
    if value == NO_VALUE {
        return NO_VALUE;
    }
    if kind == ScalarKind::Bool
        && operand_kind == ScalarKind::Bool
        && low.ctx.names.spells(symbol, in "!".as_bytes())
    {
        return m.record(COMPARE_IMMEDIATE, value, 0, EQUAL);
    } else if is_integer(kind)
        && kind == operand_kind
        && low.ctx.names.spells(symbol, in "~".as_bytes())
    {
        return m.record(NOT, value, 0, abi_width(kind));
    }
    if !is_integer(operand_kind) || !is_integer(kind) {
        return NO_VALUE;
    }
    let from = abi_width(operand_kind);
    let to = abi_width(kind);
    let signed = is_signed(operand_kind);
    let target = low.ctx.types.node(inst.ty).name;
    let lossless = if signed == is_signed(kind) {
        from <= to
    } else {
        !signed && from < to
    };
    if !conversion_spells(in low, symbol, target, in WRAPPING_CONVERSION_PREFIX.as_bytes())
        && !(lossless
            && conversion_spells(in low, symbol, target, in WIDEN_CONVERSION_PREFIX.as_bytes()))
    {
        return NO_VALUE;
    }
    if to < from {
        m.record(TRUNCATE, value, from, to)
    } else if to > from && signed {
        m.record(SIGN_EXTEND, value, from, to)
    } else {
        value
    }
}

// A range latch reads the compiler-generated cursor, adds one, writes it
// back, and jumps to the header. Its predecessor guards the increment even
// for an inclusive range at the integer maximum.
fn range_increment(in low: L, b: BlockRow, index: u64, inst: InstRow) -> bool {
    let write_index = inc(index);
    if b.term != Term::Jump
        || b.tn != JUMP_ARGUMENT
        || inst.s0 != inst.s1
        || index < add(b.i0, RANGE_CURSOR_READ_DISTANCE)
        || inc(write_index) != add(b.i0, b.ic)
        || !low.ctx.names.spells(n32(low.program.op(inst.a)), in "+".as_bytes())
    {
        return false;
    }
    let read = low.program.inst(wrapping_sub(index, RANGE_CURSOR_READ_DISTANCE));
    let one = low.program.inst(wrapping_sub(index, 1));
    let write = low.program.inst(write_index);
    let cursor = low.program.op(read.a);
    read.op == Op::Read
        && one.op == Op::Const
        && one.n == LITERAL_WORDS
        && write.op == Op::Write
        && write.n == WRITE_WORDS
        && low.ctx.names.has_prefix(n32(cursor), in RANGE_CURSOR_PREFIX.as_bytes())
        && low.program.op(write.a) == cursor
        && low.program.op(add(write.a, WRITE_VALUE)) == w(inst.dest)
        && low.program.op(add(inst.a, BINARY_LHS)) == w(read.dest)
        && low.program.op(add(inst.a, BINARY_RHS)) == w(one.dest)
        && low.program.op(one.a) == Lit::Int
        && low.program.op(add(one.a, LITERAL_LOW)) == 1
        && low.program.op(add(one.a, LITERAL_HIGH)) == 0
}

fn comparison_operation(kind: u8) -> u64 {
    match abi_width(kind) {
        BYTE_BITS => if kind == ScalarKind::Bool {
            COMPARE
        } else {
            COMPARE_BYTE
        },
        WORD_BITS => COMPARE_WORD,
        DWORD_BITS => COMPARE_DWORD,
        _ => COMPARE,
    }
}

fn lower_binary(
    in low: L,
    at: u64,
    kind: u8,
    block: u64,
    range_step: bool,
    inout m: Function
) -> u64 {
    let symbol = n32(low.program.op(at));
    let left = low.program.op(add(at, BINARY_LHS));
    let right = low.program.op(add(at, BINARY_RHS));
    let operand_kind = m.kind(left);
    if operand_kind == ScalarKind::Unsupported || operand_kind != m.kind(right) {
        return NO_VALUE;
    }
    let lhs = m.read(add(m.arguments, left), block);
    let rhs = m.read(add(m.arguments, right), block);
    if lhs == NO_VALUE || rhs == NO_VALUE {
        return NO_VALUE;
    }
    if kind == ScalarKind::Bool {
        let compare = integer_comparison(in low, symbol, operand_kind);
        if compare != NO_VALUE {
            return m.record(comparison_operation(operand_kind), lhs, rhs, compare);
        }
    } else if is_integer(kind) && kind == operand_kind {
        let op = if range_step {
            ADD
        } else {
            lower_operator(in low, symbol)
        };
        if op != NO_VALUE {
            return m.record(op, lhs, rhs, abi_width(kind));
        }
    }
    NO_VALUE
}

fn lower_block(
    in low: L,
    f: FnR,
    b: BlockRow,
    block: u64,
    inout m: Function,
    inout graph: CallGraph
) -> bool {
    for index in b.i0..add(b.i0, b.ic) {
        let inst = low.program.inst(index);
        let at = inst.a;
        if inst.op == Op::Bind || inst.op == Op::Write {
            if !lower_local_store(in low, inst, block, inout m) {
                return false;
            }
            continue;
        }
        if (inst.op == Op::Unit || inst.op == Op::Loop) && inst.n == 0 {
            continue;
        }
        if inst.op == Op::Exit
            && b.term == Term::Unreachable
            && inc(index) == add(b.i0, b.ic)
            && inst.n == EXIT_WORDS
            && n32(low.program.op(add(at, EXIT_OWNER))) == f.name
        {
            continue;
        }
        let kind = scalar_kind(in low, inst.ty);
        if inst.fallible != 0 || kind == ScalarKind::Unsupported || kind == ScalarKind::Unit {
            return false;
        }
        let value = if inst.op == Op::Const && inst.n == LITERAL_WORDS {
            lower_literal(in low, at, kind, inout m)
        } else if inst.op == Op::Read
            && inst.n == PLAIN_READ_WORDS
            && low.program.path(low.program.op(add(at, READ_PATH))).n == 0
            && low.program.op(add(at, READ_PASS)) != TyPass::Inout
            && low.program.op(add(at, READ_PROJECTIONS)) == 0
        {
            let name = n32(low.program.op(at));
            let source = place_value(in low, f, name, in m);
            if source == NO_VALUE {
                return false;
            }
            let source_kind = if source < m.arguments {
                scalar_kind(in low, low.ast.param(add(f.param_start, source)).ty)
            } else {
                m.kind(wrapping_sub(source, m.arguments))
            };
            if source_kind != kind {
                return false;
            }
            let offset = m.mutable_offset(name);
            if offset == NO_VALUE {
                m.read(source, block)
            } else {
                m.record(STACK_LOAD, HOME_SLOT, offset, QWORD_BITS)
            }
        } else if inst.op == Op::Unary && inst.n == UNARY_WORDS {
            lower_unary(in low, inst, kind, block, inout m)
        } else if inst.op == Op::Binary && inst.n == BINARY_WORDS {
            lower_binary(in low, at, kind, block, range_increment(in low, b, index, inst), inout m)
        } else if inst.op == Op::Call {
            lower_call(in low, inst, block, inout m, inout graph)
        } else {
            return false;
        };
        if value == NO_VALUE || !m.define(add(f.param_count, w(inst.dest)), block, value) {
            return false;
        }
    }
    true
}

fn lower_return(result: u64, block: u64, inout m: Function) -> bool {
    if m.kind(result) != m.result {
        return false;
    }
    let value = m.read(add(m.arguments, result), block);
    if value == NO_VALUE {
        return false;
    }
    if m.blocks.len() == 1 {
        return m.words.try_set(RETURN_VALUE, value);
    }
    let _ = m.record(BLOCK_RETURN, value, 0, 0);
    true
}

fn lower_match(in low: L, row: FnRow, b: BlockRow, block: u64, inout m: Function) -> bool {
    let id = low.program.op(b.ta);
    let kind = m.kind(id);
    if abi_width(kind) == 0 {
        return false;
    }
    let source = add(m.arguments, id);
    let end = add(b.ta, b.tn);
    let count = low.program.op(add(b.ta, MATCH_ARM_COUNT));
    let mut seen_bools: u64 = 0;
    let mut pattern = add(b.ta, MATCH_FIRST_ARM);
    for arm in 0..count {
        let target = match_target_word(in low, pattern, end);
        if target == NO_VALUE {
            return false;
        }
        let target_block = low.program.op(target);
        let label = m.label(target_block);
        if label == 0
            || label == NO_VALUE
            || block_parameter(in low, low.program.block(add(row.b0, target_block))) != NO_VALUE
        {
            return false;
        }
        if low.program.op(pattern) != Pat::Literal {
            let _ = m.record(JUMP_LABEL, label, 0, 0);
            return true;
        }
        let bits = match literal_bits(in low, add(pattern, PATTERN_HEADER_WORDS), kind) {
            Option::Some(bits) => bits,
            Option::None => return false,
        };
        if kind == ScalarKind::Bool {
            seen_bools = seen_bools | block_bit(bits);
            if seen_bools == ALL_BOOL_PATTERNS {
                let _ = m.record(JUMP_LABEL, label, 0, 0);
                return true;
            }
        }
        if inc(arm) == count {
            return false;
        }
        let value = if arm == 0 {
            m.read(source, block)
        } else {
            // Each test is a machine block. Reload the scrutinee from its
            // home so no register value crosses the synthetic edges.
            let home = m.values.try_get(source).unwrap_or(value_new(NO_VALUE)).home;
            if home == NO_VALUE {
                return false;
            }
            m.record(STACK_LOAD, HOME_SLOT, home, QWORD_BITS)
        };
        if value == NO_VALUE {
            return false;
        }
        let constant = m.record(CONSTANT, bits, 0, 0);
        let condition = m.record(comparison_operation(kind), value, constant, NOT_EQUAL);
        let next_test = m.next_label;
        m.next_label = inc(next_test);
        let _ = m.record(BRANCH_BLOCK, condition, label, 0);
        let _ = m.record(JUMP_LABEL, next_test, 0, 0);
        let _ = m.record(BLOCK_LABEL, next_test, 0, SCALAR_RESULTS);
        pattern = inc(target);
    }
    false
}

fn lower_terminator(in low: L, row: FnRow, b: BlockRow, block: u64, inout m: Function) -> bool {
    if b.term == Term::Return && b.tn == 1 {
        return lower_return(low.program.op(b.ta), block, inout m);
    } else if b.term == Term::Unreachable && b.ic != 0 {
        // The block lowerer verifies the exit belongs to this function.
        let last = low.program.inst(wrapping_sub(add(b.i0, b.ic), 1));
        return last.op == Op::Exit && lower_return(low.program.op(last.a), block, inout m);
    } else if b.term == Term::Jump {
        let target = low.program.op(b.ta);
        let label = m.label(target);
        if label == 0 || label == NO_VALUE {
            return false;
        }
        let param = block_parameter(in low, low.program.block(add(row.b0, target)));
        let count = low.program.op(add(b.ta, JUMP_ARGUMENT_COUNT));
        if param == NO_VALUE {
            if count != 0 || b.tn != JUMP_ARGUMENT {
                return false;
            }
        } else {
            if count != 1 || b.tn != inc(JUMP_ARGUMENT) {
                return false;
            }
            let argument = low.program.op(add(b.ta, JUMP_ARGUMENT));
            let kind = m.kind(param);
            if kind == ScalarKind::Unsupported || kind != m.kind(argument) {
                return false;
            }
            if kind == ScalarKind::Unit {
                let _ = m.record(JUMP_LABEL, label, 0, 0);
                return true;
            }
            let source = add(m.arguments, argument);
            let home = m.values
                .try_get(add(m.arguments, param))
                .unwrap_or(value_new(NO_VALUE))
                .home;
            if home == NO_VALUE {
                return false;
            }
            if m.values.try_get(source).unwrap_or(value_new(NO_VALUE)).home != home {
                let value = m.read(source, block);
                if value == NO_VALUE {
                    return false;
                }
                let _ = m.record(STACK_STORE_QWORD, value, HOME_SLOT, home);
            }
        }
        let _ = m.record(JUMP_LABEL, label, 0, 0);
    } else if b.term == Term::Branch && b.tn == BRANCH_WORDS {
        let id = low.program.op(b.ta);
        if m.kind(id) != ScalarKind::Bool {
            return false;
        }
        let condition = m.read(add(m.arguments, id), block);
        let yes = low.program.op(add(b.ta, BRANCH_TRUE));
        let no = low.program.op(add(b.ta, BRANCH_FALSE));
        let yes_label = m.label(yes);
        let no_label = m.label(no);
        if condition == NO_VALUE
            || yes_label == 0
            || no_label == 0
            || yes_label == NO_VALUE
            || no_label == NO_VALUE
            || block_parameter(in low, low.program.block(add(row.b0, yes))) != NO_VALUE
            || block_parameter(in low, low.program.block(add(row.b0, no))) != NO_VALUE
        {
            return false;
        }
        let _ = m.record(BRANCH_BLOCK, condition, no_label, 0);
        let _ = m.record(JUMP_LABEL, yes_label, 0, 0);
    } else if b.term == Term::Match {
        return lower_match(in low, row, b, block, inout m);
    } else {
        return false;
    }
    true
}

fn lower_function(
    in low: L,
    f: FnR,
    row: FnRow,
    inout graph: CallGraph,
    inout calls: ChunkSeq[u64]
) -> ChunkSeq[u8] {
    if row.bc == 0 {
        return ChunkSeq::new[u8]();
    }
    let mut m = Function {
        arguments: f.param_count,
        result: scalar_kind(in low, f.result),
        words: ChunkSeq::new[u64](),
        values: ChunkSeq::new[Value](),
        kinds: ChunkSeq::new[u8](),
        labels: ChunkSeq::new[u64](),
        blocks: ChunkSeq::new[u64](),
        next_label: 0,
        bindings: ChunkSeq::new[u32](),
        mutable_slots: ChunkSeq::new[u32](),
        mutable_bytes: 0,
        home_bytes: 0
    };
    if !plan_blocks(in low, row, inout m) || !plan_homes(in low, f, row, inout m) {
        return ChunkSeq::new[u8]();
    }
    m.words.push(f.param_count);
    m.words.push(NO_VALUE);
    let frame_bytes = add(m.home_bytes, m.mutable_bytes);
    if frame_bytes != 0 {
        let _ = m.record(STACK_SLOT, frame_bytes, HOME_BYTES, 0);
    }
    for layout in 0..m.blocks.len() {
        let block = m.blocks.try_get(layout).unwrap_or(0);
        if m.blocks.len() > 1 {
            let home = if block == 0 && frame_bytes != 0 {
                inc(HOME_SLOT)
            } else {
                0
            };
            let _ = m.record(BLOCK_LABEL, layout, home, SCALAR_RESULTS);
        }
        if block == 0 {
            for arg in 0..f.param_count {
                let param = low.ast.param(add(f.param_start, arg));
                // Machine values carry narrow scalars in their low bits.
                // SysV leaves the unused argument bits unspecified.
                let width = abi_width(scalar_kind(in low, param.ty));
                let value = if width < QWORD_BITS {
                    m.record(TRUNCATE, arg, QWORD_BITS, width)
                } else {
                    arg
                };
                if !m.define(arg, block, value) {
                    return ChunkSeq::new[u8]();
                }
            }
        }
        let b = low.program.block(add(row.b0, block));
        if !lower_block(in low, f, b, block, inout m, inout graph)
            || !lower_terminator(in low, row, b, block, inout m)
        {
            return ChunkSeq::new[u8]();
        }
    }
    encode_block(in m.words.as_slice(), true, inout calls)
}

// Emit the entry and its reachable effect-free SysV functions, exporting only
// the requested entry. Keep the object private until every definition passes.
pub fn compile_x86_64_elf(in low: L, entry: u32, in name: Slice[u8]) -> ChunkSeq[u8] {
    let entry_index = low.ast.fn_index(entry);
    if entry_index >= low.ast.fns.len() || !sysv_signature(in low, low.ast.function(entry_index)) {
        return ChunkSeq::new[u8]();
    }
    let mut rows = ChunkSeq::new[u64]();
    rows.resize(low.ast.fns.len(), NO_VALUE);
    for row_index in 0..low.program.fns.len() {
        let row = low.program.function(row_index);
        let index = low.ast.fn_index(row.name);
        let _ = rows.try_set(index, row_index);
    }
    let mut graph = CallGraph { indices: ChunkSeq::new[u64](), pending: ChunkSeq::new[u64]() };
    graph.indices.resize(low.ast.fns.len(), NO_VALUE);
    let _ = graph.discover(entry_index);
    let mut object = x86_text_object();
    let mut symbol: u64 = 0;
    loop {
        let index = match graph.pending.try_get(symbol) {
            Option::Some(next) => next,
            Option::None => return object.write(),
        };
        let row_index = rows.try_get(index).unwrap_or(NO_VALUE);
        if row_index == NO_VALUE {
            return ChunkSeq::new[u8]();
        }
        let f = low.ast.function(index);
        let row = low.program.function(row_index);
        let mut calls = ChunkSeq::new[u64]();
        let code = lower_function(in low, f, row, inout graph, inout calls);
        let mut spelling = ChunkSeq::new[u8]();
        if symbol == 0 {
            spelling.extend(in name);
        } else {
            for i in 0..low.ctx.names.size(f.name) {
                spelling.push(low.ctx.names.byte(f.name, i));
            }
        }
        if !object.add_function(
            in code.as_slice(),
            in spelling.as_slice(),
            in calls.as_slice(),
            symbol == 0
        ) {
            return ChunkSeq::new[u8]();
        }
        symbol = inc(symbol);
    }
}
