    MUL, NEG, NOT_EQUAL, NO_VALUE, NOT, OR, RECORD_WORDS, RETURN_VALUE, Record, SAR, SAR_REGISTER,
    SHL, SHL_REGISTER, SHR, SHR_REGISTER, SIGNED_DIV, SIGNED_GREATER, SIGNED_GREATER_EQUAL,
    SIGNED_LESS, SIGNED_LESS_EQUAL, SIGNED_REM, SIGN_EXTEND, STACK_LOAD, STACK_SLOT,
    STACK_STORE_QWORD, SUB, TRUNCATE, UNSIGNED_DIV, UNSIGNED_GREATER, UNSIGNED_GREATER_EQUAL,
    UNSIGNED_LESS, UNSIGNED_LESS_EQUAL, UNSIGNED_REM, XMM_ARGUMENTS, XOR, encode_block, read_record
};
