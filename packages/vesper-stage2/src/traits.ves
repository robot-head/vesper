// Stage 2's trait frontend: the static evidence elaboration and the
// monomorphization of src/pact_frontend.rs and src/pact_frontend/mono.rs
// for a package whose traits and canonical conformances are its own.
//
// As in Rust, it runs in two checking passes (lib.ves `stage2_lower_dir`):
//
// 1. Collect (collect.ves) lowers each trait method to a bodiless stub
//    `bound$Trait$method[Self]` and each conformance method to a generated
//    function `impl$Trait.<self key>$method` (`generated_name`). The
//    checker (typecheck.ves) resolves a method or `Trait::method` call on
//    a concrete receiver to the generated function of the conformance for
//    its type, and one on a bounded parameter to the bound's stub. It
//    records both (`TraitCall`) and every call of a generic function with
//    its type arguments (`GenCall`).
// 2. `mono_plan` starts from every unbounded function, as `Mono` does:
//    each call of a bounded function at concrete type arguments names an
//    instance `f$mono$<keys>`, whose body is the original's with the type
//    arguments substituted and whose stub calls name the conformance
//    selected for the concrete type. Collect and lowering then run again
//    with the instances in place of the bounded originals and the stubs,
//    and with every trait call an ordinary call of the function it
//    selected (`Rename`, applied by ast_lower.ves), so the second check
//    sees only ordinary calls, as Rust's `check_core` of pass 2 does.
//
// Named models and `use model` scopes select instance evidence
// (`Mono::evidence`), and boxed `dyn` calls go through vtable stubs.
// Coherence and associated types are not part of it yet; the Rust
// frontend has accepted every package Stage 2 lowers here.

use @vesper/check-data::names::{Names};
use @vesper/check-data::types::{TyKind, Types, Vars, substitute, vars_new};
use @vesper/check-data::util::{copy_seq, n32, u32_at, u64_at, w};
use @vesper/check-data::world::{set_by_symbol};
use @vesper/place-ir-lower::ast::{Ast as IrAst, FnR};
use @vesper/wasm-backend::ir::{Pair};

const NONE32: u32 = 4294967295;
const NONE64: u64 = 18446744073709551615;
// The low word of a span: its position in the module.
const LOW32: u64 = 4294967295;
// The byte `Mono::instance` joins instance key segments with.
const KEY_JOIN: u8 = 46;
// `$`, which joins the parts of generated names.
const DOLLAR: u8 = 36;
// src/fip.rs `BOX_TYPE`, crates/vesper-core/src/ast.rs `DYN_TYPE` and
// src/dyn_trait.rs `VTABLE_STUB`.
const BOX_TYPE: Str = "Box";
const DYN_TYPE: Str = "dyn";
const VTABLE_STUB: Str = "vtable$";

// A trait: its method names are `methods[m0..m0+mn]`, their stubs
// `stubs[m0..m0+mn]`.
pub copy struct TraitRow {
    name: u32,
    m0: u32,
    mn: u32,
}

// A canonical conformance `impl[gens] Trait for self_ty`: its generics'
// names are `conf_gens[g0..g0+gn]`; its methods `cf_method[f0..f0+fnn]`
// are generated as `cf_fn[f0..f0+fnn]`.
pub copy struct ConfRow {
    trait_name: u32,
    // A named model's name (`model Name: Trait for T`), or NONE32 for the
    // canonical conformance.
    model: u32,
    self_ty: u32,
    g0: u32,
    gn: u32,
    f0: u32,
    fnn: u32,
}

// A `use model` (`ModelUse`) in module `mod_idx`: model `model` selected
// from the end of the statement `end` within scope `s0..s1`.
pub copy struct ModelUseRow {
    mod_idx: u32,
    model: u32,
    start: u64,
    end: u64,
    s0: u64,
    s1: u64,
}

// One trait bound `param: trait_name` of function `owner`.
pub copy struct BoundRow {
    owner: u32,
    param: u32,
    trait_name: u32,
}

pub struct TraitInfo {
    active: bool,
    traits: ChunkSeq[TraitRow],
    methods: ChunkSeq[u32],
    stubs: ChunkSeq[u32],
    confs: ChunkSeq[ConfRow],
    conf_gens: ChunkSeq[u32],
    cf_method: ChunkSeq[u32],
    cf_fn: ChunkSeq[u32],
    bounds: ChunkSeq[BoundRow],
    // By function symbol: 1 when the function has trait bounds.
    bounded: ChunkSeq[u32],
    // By function symbol: 1 for a stub.
    is_stub: ChunkSeq[u32],
    muses: ChunkSeq[ModelUseRow],
}

pub fn trait_info_new(active: bool) -> TraitInfo {
    TraitInfo {
        active: active,
        traits: ChunkSeq::new[TraitRow](),
        methods: ChunkSeq::new[u32](),
        stubs: ChunkSeq::new[u32](),
        confs: ChunkSeq::new[ConfRow](),
        conf_gens: ChunkSeq::new[u32](),
        cf_method: ChunkSeq::new[u32](),
        cf_fn: ChunkSeq::new[u32](),
        bounds: ChunkSeq::new[BoundRow](),
        bounded: ChunkSeq::new[u32](),
        is_stub: ChunkSeq::new[u32](),
        muses: ChunkSeq::new[ModelUseRow]()
    }
}

pub fn is_bounded(in tr: TraitInfo, sym: u32) -> bool {
    u32_at(in tr.bounded, w(sym)) != 0
}

pub fn is_stub(in tr: TraitInfo, sym: u32) -> bool {
    u32_at(in tr.is_stub, w(sym)) != 0
}

pub fn mark_bounded(inout tr: TraitInfo, sym: u32) {
    set_by_symbol(inout tr.bounded, sym, 1);
}

pub fn mark_stub(inout tr: TraitInfo, sym: u32) {
    set_by_symbol(inout tr.is_stub, sym, 1);
}

fn trait_at(in tr: TraitInfo, i: u64) -> TraitRow {
    match tr.traits.try_get(i) {
        Option::Some(t) => t,
        Option::None => TraitRow { name: NONE32, m0: 0, mn: 0 },
    }
}

fn conf_at(in tr: TraitInfo, i: u64) -> ConfRow {
    match tr.confs.try_get(i) {
        Option::Some(c) => c,
        Option::None => ConfRow {
            trait_name: NONE32,
            model: NONE32,
            self_ty: NONE32,
            g0: 0,
            gn: 0,
            f0: 0,
            fnn: 0
        },
    }
}

// The index of trait `name`, or NONE64.
pub fn trait_index(in tr: TraitInfo, name: u32) -> u64 {
    for i in 0..tr.traits.len() {
        if trait_at(in tr, i).name == name {
            return i;
        }
    }
    NONE64
}

// The stub of method `method` of trait `name`, or NONE32.
pub fn stub_of(in tr: TraitInfo, name: u32, method: u32) -> u32 {
    let ti = trait_index(in tr, name);
    if ti == NONE64 {
        return NONE32;
    }
    let t = trait_at(in tr, ti);
    for k in 0..w(t.mn) {
        let mi = wrapping_add(w(t.m0), k);
        if u32_at(in tr.methods, mi) == method {
            return u32_at(in tr.stubs, mi);
        }
    }
    NONE32
}

// The trait whose method `stub` is, or NONE32.
pub fn stub_trait(in tr: TraitInfo, stub: u32) -> u32 {
    for ti in 0..tr.traits.len() {
        let t = trait_at(in tr, ti);
        for k in 0..w(t.mn) {
            if u32_at(in tr.stubs, wrapping_add(w(t.m0), k)) == stub {
                return t.name;
            }
        }
    }
    NONE32
}

// The stub that a call of `method` on parameter `param` of function
// `owner` selects through one of the function's bounds, or NONE32.
pub fn bound_stub(in tr: TraitInfo, owner: u32, param: u32, method: u32) -> u32 {
    for i in 0..tr.bounds.len() {
        match tr.bounds.try_get(i) {
            Option::Some(b) => {
                if b.owner == owner && b.param == param {
                    let s = stub_of(in tr, b.trait_name, method);
                    if s != NONE32 {
                        return s;
                    }
                }
            },
            Option::None => {},
        }
    }
    NONE32
}

// Whether `ty` is an instance of `pat`, whose names `gens` are variables;
// binds them in `vars`.
pub fn ty_bind(
    inout types: Types,
    pat: u32,
    ty: u32,
    in gens: ChunkSeq[u32],
    g0: u64,
    gn: u64,
    inout vars: Vars
) -> bool {
    let pk = types.kind(pat);
    if pk == TyKind::Named && types.arity(pat) == 0 {
        let pn = types.name(pat);
        for i in 0..gn {
            match gens.try_get(wrapping_add(g0, i)) {
                Option::Some(g) => {
                    if g == pn {
                        let had = vars.get(pn);
                        if had != NONE32 {
                            return had == ty;
                        }
                        vars.set(pn, ty);
                        return true;
                    }
                },
                Option::None => {},
            }
        }
    }
    if pat == ty {
        return true;
    }
    if pk != types.kind(ty) || types.arity(pat) != types.arity(ty) {
        return false;
    }
    if pk == TyKind::Named && types.name(pat) != types.name(ty) {
        return false;
    }
    if pk != TyKind::Named && pk != TyKind::Tuple {
        return false;
    }
    for i in 0..types.arity(pat) {
        let pa = types.arg(pat, i);
        let ta = types.arg(ty, i);
        if !ty_bind(inout types, pa, ta, in gens, g0, gn, inout vars) {
            return false;
        }
    }
    true
}

// The generated function of conformance `ci` for `method`, or NONE32.
pub fn conf_fn(in tr: TraitInfo, ci: u64, method: u32) -> u32 {
    let c = conf_at(in tr, ci);
    for k in 0..w(c.fnn) {
        let fi = wrapping_add(w(c.f0), k);
        if u32_at(in tr.cf_method, fi) == method {
            return u32_at(in tr.cf_fn, fi);
        }
    }
    NONE32
}

// Whether conformance `ci` is of trait `trait_name` (any when NONE32),
// implements `method` (any when NONE32) and covers `recv`.
fn conf_covers(
    in tr: TraitInfo,
    inout types: Types,
    ci: u64,
    trait_name: u32,
    method: u32,
    recv: u32
) -> bool {
    let c = conf_at(in tr, ci);
    if trait_name != NONE32 && c.trait_name != trait_name {
        return false;
    }
    if method != NONE32 && conf_fn(in tr, ci, method) == NONE32 {
        return false;
    }
    if c.gn == 0 {
        return c.self_ty == recv;
    }
    let mut vars = vars_new();
    ty_bind(inout types, c.self_ty, recv, in tr.conf_gens, w(c.g0), w(c.gn), inout vars)
}

// The conformance whose generated function implements `method` for
// receiver type `recv` (of trait `trait_name`, or of any trait when it is
// NONE32): (the function, the conformance index), or (NONE32, NONE64).
// The canonical conformance wins; a named model counts only for typing
// (`select_conf` picks one where a `use model` is in scope).
pub fn resolve_conf(
    in tr: TraitInfo,
    inout types: Types,
    trait_name: u32,
    method: u32,
    recv: u32
) -> (u32, u64) {
    for pass in 0..2 {
        for ci in 0..tr.confs.len() {
            let canonical = conf_at(in tr, ci).model == NONE32;
            if canonical != (pass == 0) {
                continue;
            }
            if conf_covers(in tr, inout types, ci, trait_name, method, recv) {
                return (conf_fn(in tr, ci, method), ci);
            }
        }
    }
    (NONE32, NONE64)
}

// The conformance for `recv: trait_name` (implementing `method` unless
// NONE32) at span `span`: a named model a `use model` in scope there
// selects (the innermost first, as `scopes_at` orders them), else the
// canonical one; NONE64 when none covers it.
pub fn select_conf(
    in tr: TraitInfo,
    inout types: Types,
    trait_name: u32,
    method: u32,
    recv: u32,
    span: u64
) -> u64 {
    let mod_idx = n32(span >> 32);
    let pos = span & LOW32;
    let mut best = NONE64;
    let mut best_use = NONE64;
    for ui in 0..tr.muses.len() {
        let u = match tr.muses.try_get(ui) {
            Option::Some(v) => v,
            Option::None => continue,
        };
        if u.mod_idx != mod_idx || pos < u.s0 || pos >= u.s1 || u.end > pos {
            continue;
        }
        for ci in 0..tr.confs.len() {
            if conf_at(in tr, ci).model != u.model {
                continue;
            }
            if !conf_covers(in tr, inout types, ci, trait_name, method, recv) {
                continue;
            }
            let inner = match tr.muses.try_get(best_use) {
                Option::Some(b) => u.s0 > b.s0
                    || (u.s0 == b.s0 && (u.s1 < b.s1 || (u.s1 == b.s1 && u.start > b.start))),
                Option::None => true,
            };
            if inner {
                best = ci;
                best_use = ui;
            }
        }
    }
    if best != NONE64 {
        return best;
    }
    for ci in 0..tr.confs.len() {
        if conf_at(in tr, ci).model == NONE32
            && conf_covers(in tr, inout types, ci, trait_name, method, recv)
        {
            return ci;
        }
    }
    NONE64
}

// `key_segment`: the injective encoding of a type in generated names.
pub fn key_segment(in types: Types, in names: Names, ty: u32, inout out: ChunkSeq[u8]) {
    let k = types.kind(ty);
    let n = types.arity(ty);
    if k == TyKind::Named {
        names.write(types.name(ty), inout out);
        if n > 0 {
            out.extend(in "-0-".as_bytes());
            for i in 0..n {
                if i > 0 {
                    out.extend(in "-1-".as_bytes());
                }
                key_segment(in types, in names, types.arg(ty, i), inout out);
            }
            out.extend(in "-2".as_bytes());
        }
        return;
    }
    if k == TyKind::Tuple {
        if n == 0 {
            out.extend(in "Unit".as_bytes());
            return;
        }
        out.extend(in "3-0-".as_bytes());
        for i in 0..n {
            if i > 0 {
                out.extend(in "-1-".as_bytes());
            }
            key_segment(in types, in names, types.arg(ty, i), inout out);
        }
        out.extend(in "-2".as_bytes());
        return;
    }
    out.extend(in "5".as_bytes());
}

// `generated_name`: `impl$<Trait>.<self key>$<method>`.
pub fn generated_name(
    inout names: Names,
    in types: Types,
    trait_name: u32,
    self_ty: u32,
    method: u32
) -> u32 {
    let mut buf = ChunkSeq::new[u8]();
    buf.extend(in "impl$".as_bytes());
    names.write(trait_name, inout buf);
    buf.push(KEY_JOIN);
    key_segment(in types, in names, self_ty, inout buf);
    buf.push(DOLLAR);
    names.write(method, inout buf);
    names.intern(in buf.as_slice())
}

// The stub of a trait method: `bound$<Trait>$<method>`.
pub fn stub_name(inout names: Names, trait_name: u32, method: u32) -> u32 {
    let mut buf = ChunkSeq::new[u8]();
    buf.extend(in "bound$".as_bytes());
    names.write(trait_name, inout buf);
    buf.push(DOLLAR);
    names.write(method, inout buf);
    names.intern(in buf.as_slice())
}

// ---------------------------------------------------------------------------
// What the first check records

// A trait call at `s0..s1` in function `caller`: resolved to `target` (a
// generated function, or the stub of a bound when `stub`) for receiver
// type `recv`.
pub copy struct TraitCall {
    s0: u64,
    s1: u64,
    caller: u32,
    target: u32,
    recv: u32,
    stub: bool,
    // On a boxed object `Box[dyn trait_name]`: the call goes through the
    // object's vtable stub `vtable$Trait$method`.
    boxed: bool,
    trait_name: u32,
    method: u32,
}

// A boxed-object coercion (§7.3) in function `caller`: a `Box::new` call
// typed `Box[object]` whose value has the concrete type `self_ty`.
pub copy struct BoxCo {
    caller: u32,
    self_ty: u32,
    object: u32,
}

// A call at `s0..s1` in function `caller` of generic function `callee`,
// with type arguments `pairs[v0..v0+vn]`.
pub copy struct GenCall {
    s0: u64,
    s1: u64,
    caller: u32,
    callee: u32,
    v0: u64,
    vn: u64,
}

pub struct TraitCalls {
    calls: ChunkSeq[TraitCall],
    gcalls: ChunkSeq[GenCall],
    pairs: ChunkSeq[Pair],
    cos: ChunkSeq[BoxCo],
}

pub fn trait_calls_new() -> TraitCalls {
    TraitCalls {
        calls: ChunkSeq::new[TraitCall](),
        gcalls: ChunkSeq::new[GenCall](),
        pairs: ChunkSeq::new[Pair](),
        cos: ChunkSeq::new[BoxCo]()
    }
}

// The trait `T` of a boxed object type `Box[dyn T[args]]`, or NONE32.
pub fn boxed_trait(inout names: Names, in types: Types, ty: u32) -> u32 {
    let object = boxed_object(inout names, in types, ty);
    if object == NONE32 {
        return NONE32;
    }
    let inner = types.arg(object, 0);
    if types.kind(inner) != TyKind::Named {
        return NONE32;
    }
    types.name(inner)
}

// The object type `dyn T[args]` of a boxed object type, or NONE32.
pub fn boxed_object(inout names: Names, in types: Types, ty: u32) -> u32 {
    if types.kind(ty) != TyKind::Named || types.arity(ty) != 1 {
        return NONE32;
    }
    if types.name(ty) != names.intern(in BOX_TYPE.as_bytes()) {
        return NONE32;
    }
    let object = types.arg(ty, 0);
    if types.kind(object) != TyKind::Named || types.arity(object) != 1 {
        return NONE32;
    }
    if types.name(object) != names.intern(in DYN_TYPE.as_bytes()) {
        return NONE32;
    }
    object
}

// Whether `ty` is an object type `dyn T[args]`.
pub fn is_object(inout names: Names, in types: Types, ty: u32) -> bool {
    types.kind(ty) == TyKind::Named
        && types.arity(ty) == 1
        && types.name(ty) == names.intern(in DYN_TYPE.as_bytes())
}

// The vtable stub of a trait method, `vtable$<Trait>$<method>`
// (src/dyn_trait.rs `stub_name`).
pub fn vtable_stub_name(inout names: Names, trait_name: u32, method: u32) -> u32 {
    let mut buf = ChunkSeq::new[u8]();
    vtable_stub_text(inout names, trait_name, method, inout buf);
    names.intern(in buf.as_slice())
}

fn vtable_stub_text(inout names: Names, trait_name: u32, method: u32, inout buf: ChunkSeq[u8]) {
    buf.extend(in VTABLE_STUB.as_bytes());
    names.write(trait_name, inout buf);
    buf.push(DOLLAR);
    names.write(method, inout buf);
}

// ---------------------------------------------------------------------------
// The monomorphization plan

// An instance `name` of `origin` at type arguments `pairs[v0..v0+vn]`.
pub copy struct Inst {
    origin: u32,
    name: u32,
    v0: u64,
    vn: u64,
    // The conformance discharging each bound of `origin` (in `bounds`
    // order): `evs[e0..e0+en]`.
    e0: u64,
    en: u64,
}

// In the body of instance `ctx` (0: an original function), the call at
// the original span `s0..s1` calls `target`; a method call passes its
// receiver first, as `pass0`. `inst` when `target` is an instance (its
// type arguments are dropped).
pub copy struct Rename {
    ctx: u32,
    s0: u64,
    s1: u64,
    target: u32,
    pass0: u8,
    inst: bool,
}

// A vtable slot function `name` (`Elaborator::dyn_thunk`): method
// `method` of `trait_name` for `self_ty`, whose body calls `target`.
pub copy struct Thunk {
    name: u32,
    trait_name: u32,
    method: u32,
    self_ty: u32,
    target: u32,
}

// The vtable of `self_ty` as `object` (src/dyn_trait.rs `VTable`): its
// slot functions are `thunks[t0..t0+tn]`.
pub copy struct VTab {
    object: u32,
    self_ty: u32,
    t0: u64,
    tn: u64,
}

pub struct MonoPlan {
    active: bool,
    insts: ChunkSeq[Inst],
    pairs: ChunkSeq[Pair],
    renames: ChunkSeq[Rename],
    evs: ChunkSeq[u64],
    // By function symbol: 1 for the bounded originals and the stubs the
    // second pass leaves out.
    dropped: ChunkSeq[u32],
    // The traits used as boxed objects, whose vtable stubs the second
    // pass declares.
    boxed: ChunkSeq[u32],
    thunks: ChunkSeq[Thunk],
    vtabs: ChunkSeq[VTab],
}

pub fn mono_plan_new() -> MonoPlan {
    MonoPlan {
        active: false,
        insts: ChunkSeq::new[Inst](),
        pairs: ChunkSeq::new[Pair](),
        renames: ChunkSeq::new[Rename](),
        evs: ChunkSeq::new[u64](),
        dropped: ChunkSeq::new[u32](),
        boxed: ChunkSeq::new[u32](),
        thunks: ChunkSeq::new[Thunk](),
        vtabs: ChunkSeq::new[VTab]()
    }
}

// A copy of `plan` in fresh heap, for moving it past the first pass's
// scratch (lib.ves `front_with_traits`).
pub fn copy_plan(in plan: MonoPlan) -> MonoPlan {
    MonoPlan {
        active: plan.active,
        insts: copy_seq[Inst](in plan.insts),
        pairs: copy_seq[Pair](in plan.pairs),
        renames: copy_seq[Rename](in plan.renames),
        evs: copy_seq[u64](in plan.evs),
        dropped: copy_seq[u32](in plan.dropped),
        boxed: copy_seq[u32](in plan.boxed),
        thunks: copy_seq[Thunk](in plan.thunks),
        vtabs: copy_seq[VTab](in plan.vtabs)
    }
}

pub fn copy_dyn_out(in d: DynOut) -> DynOut {
    DynOut {
        stubs: copy_seq[u32](in d.stubs),
        vtabs: copy_seq[VTab](in d.vtabs),
        slots: copy_seq[u32](in d.slots)
    }
}

pub fn thunk_at(in plan: MonoPlan, i: u64) -> Thunk {
    match plan.thunks.try_get(i) {
        Option::Some(v) => v,
        Option::None => Thunk {
            name: NONE32,
            trait_name: NONE32,
            method: NONE32,
            self_ty: NONE32,
            target: NONE32
        },
    }
}

fn mark_boxed(inout plan: MonoPlan, trait_name: u32) {
    for i in 0..plan.boxed.len() {
        if u32_at(in plan.boxed, i) == trait_name {
            return;
        }
    }
    plan.boxed.push(trait_name);
}

// The `dyn` metadata of the calls input (src/dyn_trait.rs `DynObjects`):
// the vtable stubs and the vtables, each method its slot function.
pub struct DynOut {
    stubs: ChunkSeq[u32],
    vtabs: ChunkSeq[VTab],
    slots: ChunkSeq[u32],
}

pub fn dyn_out_new() -> DynOut {
    DynOut {
        stubs: ChunkSeq::new[u32](),
        vtabs: ChunkSeq::new[VTab](),
        slots: ChunkSeq::new[u32]()
    }
}

// `plan`'s vtable stubs (every method of each boxed trait) and vtables.
pub fn dyn_out(in plan: MonoPlan, in tr: TraitInfo, inout names: Names) -> DynOut {
    let mut out = dyn_out_new();
    for bi in 0..plan.boxed.len() {
        let t = trait_at(in tr, trait_index(in tr, u32_at(in plan.boxed, bi)));
        for k in 0..w(t.mn) {
            let m = u32_at(in tr.methods, wrapping_add(w(t.m0), k));
            out.stubs.push(vtable_stub_name(inout names, t.name, m));
        }
    }
    for vi in 0..plan.vtabs.len() {
        match plan.vtabs.try_get(vi) {
            Option::Some(v) => out.vtabs.push(v),
            Option::None => {},
        }
    }
    for ti in 0..plan.thunks.len() {
        out.slots.push(thunk_at(in plan, ti).name);
    }
    out
}

pub fn is_dropped(in plan: MonoPlan, sym: u32) -> bool {
    u32_at(in plan.dropped, w(sym)) != 0
}

pub fn inst_at(in plan: MonoPlan, i: u64) -> Inst {
    match plan.insts.try_get(i) {
        Option::Some(v) => v,
        Option::None => Inst { origin: NONE32, name: NONE32, v0: 0, vn: 0, e0: 0, en: 0 },
    }
}

// The type arguments of instance `ctx` (1-based) as substitution vars.
pub fn inst_vars(in plan: MonoPlan, ctx: u32) -> Vars {
    let mut vars = vars_new();
    if ctx == 0 {
        return vars;
    }
    let inst = inst_at(in plan, wrapping_sub(w(ctx), 1));
    for i in 0..inst.vn {
        match plan.pairs.try_get(wrapping_add(inst.v0, i)) {
            Option::Some(p) => vars.set(p.name, p.ty),
            Option::None => {},
        }
    }
    vars
}

fn rename_lt(in a: Rename, ctx: u32, s0: u64, s1: u64) -> bool {
    if a.ctx != ctx {
        return a.ctx < ctx;
    }
    if a.s0 != s0 {
        return a.s0 < s0;
    }
    a.s1 < s1
}

// The rename of the call at original span `s0..s1` in instance `ctx`.
pub fn find_rename(in plan: MonoPlan, ctx: u32, s0: u64, s1: u64) -> Option[Rename] {
    let mut lo: u64 = 0;
    let mut hi = plan.renames.len();
    loop {
        if lo >= hi {
            break;
        }
        let mid = wrapping_add(lo, wrapping_sub(hi, lo) / 2);
        let r = match plan.renames.try_get(mid) {
            Option::Some(v) => v,
            Option::None => return Option::None,
        };
        if rename_lt(in r, ctx, s0, s1) {
            lo = wrapping_add(mid, 1);
        } else {
            hi = mid;
        }
    }
    match plan.renames.try_get(lo) {
        Option::Some(r) => {
            if r.ctx == ctx && r.s0 == s0 && r.s1 == s1 {
                Option::Some(r)
            } else {
                Option::None
            }
        },
        Option::None => Option::None,
    }
}

fn fn_of(in a: IrAst, sym: u32) -> Option[FnR] {
    let i = u32_at(in a.fn_by_key, w(sym));
    if i == 0 {
        return Option::None;
    }
    a.fns.try_get(wrapping_sub(w(i), 1))
}

fn first_pass(in a: IrAst, sym: u32) -> u8 {
    match fn_of(in a, sym) {
        Option::Some(f) => {
            if f.param_count == 0 {
                return 0;
            }
            match a.pms.try_get(f.param_start) {
                Option::Some(p) => p.pass,
                Option::None => 0,
            }
        },
        Option::None => 0,
    }
}

// Whether `ty` mentions one of the generic parameters of `f`.
fn mentions_generic(in a: IrAst, in types: Types, in f: FnR, ty: u32) -> bool {
    let k = types.kind(ty);
    if k == TyKind::Named && types.arity(ty) == 0 {
        let nm = types.name(ty);
        for gi in 0..f.generic_count {
            match a.gens.try_get(wrapping_add(f.generic_start, gi)) {
                Option::Some(g) => {
                    if g.name == nm {
                        return true;
                    }
                },
                Option::None => {},
            }
        }
        return false;
    }
    if k == TyKind::Infer {
        return true;
    }
    if k == TyKind::Named || k == TyKind::Tuple {
        for i in 0..types.arity(ty) {
            if mentions_generic(in a, in types, in f, types.arg(ty, i)) {
                return true;
            }
        }
    }
    false
}

struct Planner {
    plan: MonoPlan,
    // Worklist of instance contexts still to visit (1-based instance ids).
    work: ChunkSeq[u32],
    // By caller symbol: the first trait call (index + 1) and the next one.
    tc_head: ChunkSeq[u32],
    tc_next: ChunkSeq[u64],
    gc_head: ChunkSeq[u32],
    gc_next: ChunkSeq[u64],
}

fn push_rename(inout p: Planner, ctx: u32, s0: u64, s1: u64, target: u32, pass0: u8, inst: bool) {
    p.plan
        .renames
        .push(Rename { ctx: ctx, s0: s0, s1: s1, target: target, pass0: pass0, inst: inst });
}

// `Mono::instance`: the instance of `origin` at `vars` (in the order of
// its generics), made on first use.
fn instance(
    inout p: Planner,
    in a: IrAst,
    in tr: TraitInfo,
    inout names: Names,
    in types: Types,
    origin: u32,
    in vars: Vars,
    in evs: ChunkSeq[u64]
) -> u32 {
    let f = match fn_of(in a, origin) {
        Option::Some(v) => v,
        Option::None => return origin,
    };
    let mut args = ChunkSeq::new[Pair]();
    for gi in 0..f.generic_count {
        match a.gens.try_get(wrapping_add(f.generic_start, gi)) {
            Option::Some(g) => {
                let t = vars.get(g.name);
                if t != NONE32 {
                    args.push(Pair { name: g.name, ty: t });
                }
            },
            Option::None => {},
        }
    }
    for ii in 0..p.plan.insts.len() {
        let inst = inst_at(in p.plan, ii);
        if inst.origin != origin || inst.vn != args.len() || inst.en != evs.len() {
            continue;
        }
        let mut same = true;
        for k in 0..evs.len() {
            if u64_at(in evs, k) != u64_at(in p.plan.evs, wrapping_add(inst.e0, k)) {
                same = false;
            }
        }
        for k in 0..args.len() {
            let x = match args.try_get(k) {
                Option::Some(v) => v.ty,
                Option::None => NONE32,
            };
            let y = match p.plan.pairs.try_get(wrapping_add(inst.v0, k)) {
                Option::Some(v) => v.ty,
                Option::None => NONE32,
            };
            if x != y {
                same = false;
            }
        }
        if same {
            return inst.name;
        }
    }
    let mut buf = ChunkSeq::new[u8]();
    names.write(origin, inout buf);
    buf.extend(in "$mono$".as_bytes());
    for k in 0..args.len() {
        if k > 0 {
            buf.push(KEY_JOIN);
        }
        match args.try_get(k) {
            Option::Some(v) => key_segment(in types, in names, v.ty, inout buf),
            Option::None => {},
        }
    }
    // A named model in the evidence names the instance apart.
    for k in 0..evs.len() {
        let model = conf_at(in tr, u64_at(in evs, k)).model;
        if model != NONE32 {
            buf.push(DOLLAR);
            names.write(model, inout buf);
        }
    }
    let mut name = names.intern(in buf.as_slice());
    for ii in 0..p.plan.insts.len() {
        if inst_at(in p.plan, ii).name == name {
            buf.push(DOLLAR);
            push_dec(inout buf, p.plan.insts.len());
            name = names.intern(in buf.as_slice());
            break;
        }
    }
    let v0 = p.plan.pairs.len();
    for k in 0..args.len() {
        match args.try_get(k) {
            Option::Some(v) => p.plan.pairs.push(v),
            Option::None => {},
        }
    }
    let e0 = p.plan.evs.len();
    for k in 0..evs.len() {
        p.plan.evs.push(u64_at(in evs, k));
    }
    p.plan
        .insts
        .push(Inst { origin: origin, name: name, v0: v0, vn: args.len(), e0: e0, en: evs.len() });
    p.work.push(n32(p.plan.insts.len()));
    name
}

fn push_dec(inout out: ChunkSeq[u8], v: u64) {
    let mut digits = ChunkSeq::new[u8]();
    let mut x = v;
    loop {
        digits.push(wrapping_add(48, wrapping_u8(x % 10)));
        x = x / 10;
        if x == 0 {
            break;
        }
    }
    let n = digits.len();
    for i in 0..n {
        match digits.try_get(wrapping_sub(wrapping_sub(n, 1), i)) {
            Option::Some(d) => out.push(d),
            Option::None => {},
        }
    }
}

// `Mono::evidence`: the conformance discharging `ty: trait_name` in
// instance context `ctx`: the evidence of the matching bound of the
// instance's origin, else the one selected at `span` (under its `use
// model` scopes); NONE64 when none does.
fn evidence(
    in p: Planner,
    in tr: TraitInfo,
    inout types: Types,
    ctx: u32,
    trait_name: u32,
    ty: u32,
    span: u64
) -> u64 {
    if ctx != 0 {
        let inst = inst_at(in p.plan, wrapping_sub(w(ctx), 1));
        let vars = inst_vars(in p.plan, ctx);
        let mut bi: u64 = 0;
        for i in 0..tr.bounds.len() {
            let b = match tr.bounds.try_get(i) {
                Option::Some(v) => v,
                Option::None => continue,
            };
            if b.owner != inst.origin {
                continue;
            }
            if b.trait_name == trait_name && vars.get(b.param) == ty && bi < inst.en {
                return u64_at(in p.plan.evs, wrapping_add(inst.e0, bi));
            }
            bi = wrapping_add(bi, 1);
        }
    }
    select_conf(in tr, inout types, trait_name, NONE32, ty, span)
}

// `Mono::callee_evidence`: the evidence of each bound of `callee` (in
// `bounds` order) at `cvars`, stopping at the first undischarged one.
fn callee_evidence(
    in p: Planner,
    in tr: TraitInfo,
    inout types: Types,
    ctx: u32,
    callee: u32,
    in cvars: Vars,
    span: u64
) -> ChunkSeq[u64] {
    let mut out = ChunkSeq::new[u64]();
    for i in 0..tr.bounds.len() {
        let b = match tr.bounds.try_get(i) {
            Option::Some(v) => v,
            Option::None => continue,
        };
        if b.owner != callee {
            continue;
        }
        let ev = evidence(in p, in tr, inout types, ctx, b.trait_name, cvars.get(b.param), span);
        if ev == NONE64 {
            break;
        }
        out.push(ev);
    }
    out
}

// Visits the calls of function `fsym` in instance context `ctx` under
// `vars`.
fn visit(
    inout p: Planner,
    in a: IrAst,
    in tr: TraitInfo,
    in out: TraitCalls,
    inout names: Names,
    inout types: Types,
    ctx: u32,
    fsym: u32,
    in vars: Vars
) {
    let f = match fn_of(in a, fsym) {
        Option::Some(v) => v,
        Option::None => return,
    };
    let mut cur = u32_at(in p.tc_head, w(fsym));
    loop {
        if cur == 0 {
            break;
        }
        let ci = wrapping_sub(w(cur), 1);
        cur = n32(u64_at(in p.tc_next, ci));
        let c = match out.calls.try_get(ci) {
            Option::Some(v) => v,
            Option::None => continue,
        };
        if c.boxed {
            let stub = vtable_stub_name(inout names, c.trait_name, c.method);
            mark_boxed(inout p.plan, c.trait_name);
            push_rename(inout p, ctx, c.s0, c.s1, stub, first_pass(in a, c.target), false);
        } else if c.stub {
            let recv = substitute(inout types, c.recv, in vars);
            if mentions_generic(in a, in types, in f, recv) {
                continue;
            }
            let conf = evidence(in p, in tr, inout types, ctx, c.trait_name, recv, c.s0);
            let target = conf_fn(in tr, conf, c.method);
            if target == NONE32 {
                continue;
            }
            let cr = conf_at(in tr, conf);
            if cr.gn > 0 && is_bounded(in tr, target) {
                let mut hv = vars_new();
                let _ok = ty_bind(
                    inout types,
                    cr.self_ty,
                    recv,
                    in tr.conf_gens,
                    w(cr.g0),
                    w(cr.gn),
                    inout hv
                );
                let evs = callee_evidence(in p, in tr, inout types, ctx, target, in hv, c.s0);
                let name = instance(
                    inout p,
                    in a,
                    in tr,
                    inout names,
                    in types,
                    target,
                    in hv,
                    in evs
                );
                push_rename(inout p, ctx, c.s0, c.s1, name, first_pass(in a, target), true);
            } else {
                push_rename(inout p, ctx, c.s0, c.s1, target, first_pass(in a, target), false);
            }
        } else if !is_bounded(in tr, c.target) {
            push_rename(inout p, ctx, c.s0, c.s1, c.target, first_pass(in a, c.target), false);
        }
    }
    let mut gcur = u32_at(in p.gc_head, w(fsym));
    loop {
        if gcur == 0 {
            break;
        }
        let gi = wrapping_sub(w(gcur), 1);
        gcur = n32(u64_at(in p.gc_next, gi));
        let g = match out.gcalls.try_get(gi) {
            Option::Some(v) => v,
            Option::None => continue,
        };
        if !is_bounded(in tr, g.callee) || is_stub(in tr, g.callee) {
            continue;
        }
        let callee = match fn_of(in a, g.callee) {
            Option::Some(v) => v,
            Option::None => continue,
        };
        let mut args = vars_new();
        let mut closed = true;
        for k in 0..g.vn {
            match out.pairs.try_get(wrapping_add(g.v0, k)) {
                Option::Some(pr) => {
                    let t = substitute(inout types, pr.ty, in vars);
                    // A type argument the first check left open (the
                    // callee's own parameter) names no instance.
                    if mentions_generic(in a, in types, in f, t)
                        || mentions_generic(in a, in types, in callee, t)
                    {
                        closed = false;
                    }
                    args.set(pr.name, t);
                },
                Option::None => {},
            }
        }
        if !closed {
            continue;
        }
        let evs = callee_evidence(in p, in tr, inout types, ctx, g.callee, in args, g.s0);
        let name = instance(inout p, in a, in tr, inout names, in types, g.callee, in args, in evs);
        push_rename(inout p, ctx, g.s0, g.s1, name, first_pass(in a, g.callee), true);
    }
    for ci in 0..out.cos.len() {
        let co = match out.cos.try_get(ci) {
            Option::Some(v) => v,
            Option::None => continue,
        };
        if co.caller != fsym {
            continue;
        }
        let ty = substitute(inout types, co.self_ty, in vars);
        let object = substitute(inout types, co.object, in vars);
        if mentions_generic(in a, in types, in f, ty)
            || mentions_generic(in a, in types, in f, object)
        {
            continue;
        }
        dyn_vtable(inout p, in a, in tr, inout names, inout types, object, ty);
    }
}

// `Mono::dyn_vtable`: the vtable of `ty` as `object`, with a slot
// function per trait method calling the conformance's generated function
// (or its instance), made once per (object, type).
fn dyn_vtable(
    inout p: Planner,
    in a: IrAst,
    in tr: TraitInfo,
    inout names: Names,
    inout types: Types,
    object: u32,
    ty: u32
) {
    for vi in 0..p.plan.vtabs.len() {
        match p.plan.vtabs.try_get(vi) {
            Option::Some(v) => {
                if v.object == object && v.self_ty == ty {
                    return;
                }
            },
            Option::None => {},
        }
    }
    let inner = types.arg(object, 0);
    let trait_name = types.name(inner);
    let ti = trait_index(in tr, trait_name);
    if ti == NONE64 {
        return;
    }
    mark_boxed(inout p.plan, trait_name);
    let t = trait_at(in tr, ti);
    let t0 = p.plan.thunks.len();
    for k in 0..w(t.mn) {
        let m = u32_at(in tr.methods, wrapping_add(w(t.m0), k));
        let (generated, conf) = resolve_conf(in tr, inout types, trait_name, m, ty);
        if generated == NONE32 {
            return;
        }
        let cr = conf_at(in tr, conf);
        let target = if cr.gn > 0 && is_bounded(in tr, generated) {
            let mut hv = vars_new();
            let _ok = ty_bind(
                inout types,
                cr.self_ty,
                ty,
                in tr.conf_gens,
                w(cr.g0),
                w(cr.gn),
                inout hv
            );
            let evs = callee_evidence(in p, in tr, inout types, 0, generated, in hv, 0);
            instance(inout p, in a, in tr, inout names, in types, generated, in hv, in evs)
        } else {
            generated
        };
        let mut buf = ChunkSeq::new[u8]();
        vtable_stub_text(inout names, trait_name, m, inout buf);
        buf.push(DOLLAR);
        key_segment(in types, in names, ty, inout buf);
        let mut name = names.intern(in buf.as_slice());
        for j in 0..p.plan.thunks.len() {
            if thunk_at(in p.plan, j).name == name {
                buf.push(DOLLAR);
                push_dec(inout buf, p.plan.thunks.len());
                name = names.intern(in buf.as_slice());
                break;
            }
        }
        p.plan.thunks.push(Thunk {
            name: name,
            trait_name: trait_name,
            method: m,
            self_ty: ty,
            target: target
        });
    }
    let tn = wrapping_sub(p.plan.thunks.len(), t0);
    p.plan.vtabs.push(VTab { object: object, self_ty: ty, t0: t0, tn: tn });
}

fn sort_renames(inout rs: ChunkSeq[Rename]) {
    // Insertion sort: the renames of a package number in the hundreds.
    let n = rs.len();
    for i in 1..n {
        let x = match rs.try_get(i) {
            Option::Some(v) => v,
            Option::None => continue,
        };
        let mut j = i;
        loop {
            if j == 0 {
                break;
            }
            let y = match rs.try_get(wrapping_sub(j, 1)) {
                Option::Some(v) => v,
                Option::None => break,
            };
            if !rename_lt(in x, y.ctx, y.s0, y.s1) {
                break;
            }
            let _ = rs.try_set(j, y);
            j = wrapping_sub(j, 1);
        }
        let _ = rs.try_set(j, x);
    }
}

// `Elaborator::monomorphize`'s instances and the calls the second pass
// rewrites, from the first check of `a`.
pub fn mono_plan(
    in a: IrAst,
    in tr: TraitInfo,
    in out: TraitCalls,
    inout names: Names,
    inout types: Types
) -> MonoPlan {
    let mut plan = mono_plan_new();
    plan.active = true;
    let mut p = Planner {
        plan: plan,
        work: ChunkSeq::new[u32](),
        tc_head: ChunkSeq::new[u32](),
        tc_next: ChunkSeq::new[u64](),
        gc_head: ChunkSeq::new[u32](),
        gc_next: ChunkSeq::new[u64]()
    };
    for ci in 0..out.calls.len() {
        match out.calls.try_get(ci) {
            Option::Some(c) => {
                p.tc_next.push(widen_u64(u32_at(in p.tc_head, w(c.caller))));
                set_by_symbol(inout p.tc_head, c.caller, n32(wrapping_add(ci, 1)));
            },
            Option::None => p.tc_next.push(0),
        }
    }
    for gi in 0..out.gcalls.len() {
        match out.gcalls.try_get(gi) {
            Option::Some(g) => {
                p.gc_next.push(widen_u64(u32_at(in p.gc_head, w(g.caller))));
                set_by_symbol(inout p.gc_head, g.caller, n32(wrapping_add(gi, 1)));
            },
            Option::None => p.gc_next.push(0),
        }
    }
    let empty = vars_new();
    for fi in 0..a.fns.len() {
        let f = match a.fns.try_get(fi) {
            Option::Some(v) => v,
            Option::None => continue,
        };
        if !f.has_body || is_bounded(in tr, f.name) || is_stub(in tr, f.name) {
            continue;
        }
        visit(inout p, in a, in tr, in out, inout names, inout types, 0, f.name, in empty);
    }
    let mut wi: u64 = 0;
    loop {
        if wi >= p.work.len() {
            break;
        }
        let ctx = u32_at(in p.work, wi);
        wi = wrapping_add(wi, 1);
        let inst = inst_at(in p.plan, wrapping_sub(w(ctx), 1));
        let vars = inst_vars(in p.plan, ctx);
        visit(inout p, in a, in tr, in out, inout names, inout types, ctx, inst.origin, in vars);
    }
    let Planner { plan: done, work: _w, tc_head: _a, tc_next: _b, gc_head: _c, gc_next: _d } = p;
    let mut result = done;
    for fi in 0..a.fns.len() {
        match a.fns.try_get(fi) {
            Option::Some(f) => {
                if is_bounded(in tr, f.name) || is_stub(in tr, f.name) {
                    set_by_symbol(inout result.dropped, f.name, 1);
                }
            },
            Option::None => {},
        }
    }
    sort_renames(inout result.renames);
    result
}
