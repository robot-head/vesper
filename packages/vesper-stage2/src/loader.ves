// Pure-Vesper Loom package graph loader over `@vesper-std/fs`, encoding
// the package graph into the word stream expected by
// `@vesper/check-names-packages::assembly_begin`.

use @vesper-std/fs::{
    IoError,
    kind_dir,
    kind_file,
    read_path
};
use @vesper-std/fs::walk::{
    Entries,
    entry_count,
    entry_join,
    entry_kind,
    entry_path,
    list_dir_path
};

fn put_u64(inout o: ChunkSeq[u8], v: u64) {
    for k in 0..8 {
        o.push(wrapping_u8(wrapping_shr_u64(v, wrapping_u32(wrapping_mul(k, 8))) & 255));
    }
}

fn put_str(inout o: ChunkSeq[u8], in s: Slice[u8]) {
    put_u64(inout o, s.len());
    o.extend(in s);
    let rem = s.len() & 7;
    if rem != 0 {
        let pad = wrapping_sub(8, rem);
        for _i in 0..pad {
            o.push(0);
        }
    }
}

fn join_path(in dir: Slice[u8], in rel: Slice[u8]) -> ChunkSeq[u8] {
    let mut out = ChunkSeq::new[u8]();
    if dir.len() == 0 || (dir.len() == 1 && byte_at(in dir, 0) == 46) {
        out.extend(in rel);
        return out;
    }
    out.extend(in dir);
    let last = byte_at(in dir, wrapping_sub(dir.len(), 1));
    if last != 47 && last != 92 {
        out.push(47);
    }
    out.extend(in rel);
    out
}

fn byte_at(in s: Slice[u8], i: u64) -> u8 {
    match s.try_get(i) {
        Option::Some(b) => b,
        Option::None => 0,
    }
}

fn eq_bytes(in a: Slice[u8], in b: Slice[u8]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for i in 0..a.len() {
        if byte_at(in a, i) != byte_at(in b, i) {
            return false;
        }
    }
    true
}

fn try_read_file(in path: Slice[u8]) -> Option[ChunkSeq[u8]] eff [Ffi[StdFs]] {
    handle Fail[IoError] in {
        let bytes = read_path(in path);
        Option::Some(bytes)
    } with {
        return v => v,
        raise(_e, _k) => Option::None,
    }
}

fn trim_range(in s: Slice[u8], start: u64, end0: u64) -> (u64, u64) {
    let mut a = start;
    let mut z = end0;
    if z > a && byte_at(in s, wrapping_sub(z, 1)) == 13 {
        z = wrapping_sub(z, 1);
    }
    loop {
        if a >= z {
            break;
        }
        let b = byte_at(in s, a);
        if b == 32 || b == 9 {
            a = wrapping_add(a, 1);
        } else {
            break;
        }
    }
    loop {
        if z <= a {
            break;
        }
        let b = byte_at(in s, wrapping_sub(z, 1));
        if b == 32 || b == 9 {
            z = wrapping_sub(z, 1);
        } else {
            break;
        }
    }
    (a, z)
}

fn find_byte(in s: Slice[u8], from: u64, end0: u64, target: u8) -> u64 {
    for i in from..end0 {
        if byte_at(in s, i) == target {
            return i;
        }
    }
    end0
}

// Parse `"..."` starting at or after `from` within `..end0`.
fn parse_quoted(in s: Slice[u8], from: u64, end0: u64) -> (u64, u64, bool) {
    let q1 = find_byte(in s, from, end0, 34);
    if q1 >= end0 {
        return (0, 0, false);
    }
    let a = wrapping_add(q1, 1);
    let q2 = find_byte(in s, a, end0, 34);
    if q2 >= end0 {
        return (0, 0, false);
    }
    (a, q2, true)
}

fn normalize_dir(in base: Slice[u8], in rel: Slice[u8]) -> ChunkSeq[u8] {
    let joined = if rel.len() > 0 && byte_at(in rel, 0) == 47 {
        let mut c = ChunkSeq::new[u8]();
        c.extend(in rel);
        c
    } else {
        join_path(in base, in rel)
    };
    let s = joined.as_slice();
    let abs = s.len() > 0 && byte_at(in s, 0) == 47;
    let mut segs = ChunkSeq::new[ChunkSeq[u8]]();
    let mut i: u64 = 0;
    loop {
        if i >= s.len() {
            break;
        }
        let next = find_byte(in s, i, s.len(), 47);
        let seg = s[i..next];
        if seg.len() > 0 && !eq_bytes(in seg, in ".".as_bytes()) {
            if eq_bytes(in seg, in "..".as_bytes()) {
                if segs.len() > 0 {
                    segs.truncate(wrapping_sub(segs.len(), 1));
                }
            } else {
                let mut cp = ChunkSeq::new[u8]();
                cp.extend(in seg);
                segs.push(sink cp);
            }
        }
        i = wrapping_add(next, 1);
    }
    let mut out = ChunkSeq::new[u8]();
    if abs {
        out.push(47);
    }
    for k in 0..segs.len() {
        if k > 0 {
            out.push(47);
        }
        match segs.try_get(k) {
            Option::Some(seg) => out.extend(in seg.as_slice()),
            Option::None => {},
        }
    }
    if out.len() == 0 {
        out.push(46);
    }
    out
}

struct DepSpec {
    name: ChunkSeq[u8],
    path: ChunkSeq[u8],
}

struct Manifest {
    name: ChunkSeq[u8],
    deps: ChunkSeq[DepSpec],
}

fn parse_manifest(in text: Slice[u8]) -> Manifest {
    let mut pkg_name = ChunkSeq::new[u8]();
    let mut deps = ChunkSeq::new[DepSpec]();
    let mut sec: u8 = 0;
    let mut pos: u64 = 0;
    loop {
        if pos >= text.len() {
            break;
        }
        let nl = find_byte(in text, pos, text.len(), 10);
        let (la, lz) = trim_range(in text, pos, nl);
        pos = wrapping_add(nl, 1);
        if la >= lz || byte_at(in text, la) == 35 {
            continue;
        }
        if byte_at(in text, la) == 91 {
            let line = text[la..lz];
            if eq_bytes(in line, in "[package]".as_bytes()) {
                sec = 1;
            } else if eq_bytes(in line, in "[dependencies]".as_bytes()) {
                sec = 2;
            } else {
                sec = 0;
            }
            continue;
        }
        if sec == 1 {
            let eq = find_byte(in text, la, lz, 61);
            if eq < lz {
                let (ka, kz) = trim_range(in text, la, eq);
                if eq_bytes(in text[ka..kz], in "name".as_bytes()) {
                    let (a, z, ok) = parse_quoted(in text, wrapping_add(eq, 1), lz);
                    if ok {
                        pkg_name.clear();
                        pkg_name.extend(in text[a..z]);
                    }
                }
            }
        } else if sec == 2 {
            let eq = find_byte(in text, la, lz, 61);
            if eq < lz {
                let (rka, rkz) = trim_range(in text, la, eq);
                let (ka, kz, kok) = parse_quoted(in text, rka, rkz);
                let (da, dz) = if kok {
                    (ka, kz)
                } else {
                    (rka, rkz)
                };
                let mut p_idx = wrapping_add(eq, 1);
                let mut found_path = false;
                let mut pa: u64 = 0;
                let mut pz: u64 = 0;
                loop {
                    if p_idx >= lz {
                        break;
                    }
                    if wrapping_add(p_idx, 4) <= lz
                        && eq_bytes(in text[p_idx..wrapping_add(p_idx, 4)], in "path".as_bytes()) {
                        let peq = find_byte(in text, wrapping_add(p_idx, 4), lz, 61);
                        if peq < lz {
                            let (qa, qz, qok) = parse_quoted(in text, wrapping_add(peq, 1), lz);
                            if qok {
                                pa = qa;
                                pz = qz;
                                found_path = true;
                                break;
                            }
                        }
                    }
                    p_idx = wrapping_add(p_idx, 1);
                }
                if found_path {
                    let mut dn = ChunkSeq::new[u8]();
                    dn.extend(in text[da..dz]);
                    let mut dp = ChunkSeq::new[u8]();
                    dp.extend(in text[pa..pz]);
                    deps
                        .push(
                            sink DepSpec {
                                name: dn,
                                path: dp
                            }
                        );
                }
            }
        }
    }
    Manifest {
        name: pkg_name,
        deps: deps
    }
}

fn is_ident_byte(b: u8) -> bool {
    (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57) || b == 95
}

// Scan top-level `mod <ident>;` or `pub mod <ident>;` declarations.
fn push_unique_name(inout out: ChunkSeq[ChunkSeq[u8]], in slice: Slice[u8]) {
    for i in 0..out.len() {
        match out.try_get(i) {
            Option::Some(existing) => {
                if eq_bytes(in existing.as_slice(), in slice) {
                    return;
                }
            },
            Option::None => {},
        }
    }
    let mut name = ChunkSeq::new[u8]();
    name.extend(in slice);
    out.push(sink name);
}

fn scan_mods(in src: Slice[u8], include_super: bool)
    -> (ChunkSeq[ChunkSeq[u8]], ChunkSeq[ChunkSeq[u8]]) {
    let mut self_out = ChunkSeq::new[ChunkSeq[u8]]();
    let mut super_out = ChunkSeq::new[ChunkSeq[u8]]();
    let mut pos: u64 = 0;
    loop {
        if pos >= src.len() {
            break;
        }
        let nl = find_byte(in src, pos, src.len(), 10);
        let (la0, lz) = trim_range(in src, pos, nl);
        let mut la = la0;
        pos = wrapping_add(nl, 1);
        if wrapping_sub(lz, la) >= 4
            && eq_bytes(in src[la..wrapping_add(la, 4)], in "pub ".as_bytes()) {
            let (na, _nz) = trim_range(in src, wrapping_add(la, 4), lz);
            la = na;
        }
        if wrapping_sub(lz, la) >= 4
            && eq_bytes(in src[la..wrapping_add(la, 4)], in "mod ".as_bytes()) {
            let (ra, rz) = trim_range(in src, wrapping_add(la, 4), lz);
            let mut end = ra;
            loop {
                if end >= rz || !is_ident_byte(byte_at(in src, end)) {
                    break;
                }
                end = wrapping_add(end, 1);
            }
            if end > ra {
                let (aa, az) = trim_range(in src, end, rz);
                if aa < az && byte_at(in src, aa) == 59 {
                    push_unique_name(inout self_out, in src[ra..end]);
                }
            }
        } else if wrapping_sub(lz, la) >= 4
            && eq_bytes(in src[la..wrapping_add(la, 4)], in "use ".as_bytes()) {
            let (ra0, rz) = trim_range(in src, wrapping_add(la, 4), lz);
            if wrapping_sub(rz, ra0) >= 6
                && eq_bytes(in src[ra0..wrapping_add(ra0, 6)], in "self::".as_bytes()) {
                let ra = wrapping_add(ra0, 6);
                let mut end = ra;
                loop {
                    if end >= rz || !is_ident_byte(byte_at(in src, end)) {
                        break;
                    }
                    end = wrapping_add(end, 1);
                }
                if end > ra {
                    if include_super {
                        push_unique_name(inout super_out, in src[ra..end]);
                    } else {
                        push_unique_name(inout self_out, in src[ra..end]);
                    }
                }
            } else if include_super
                && wrapping_sub(rz, ra0) >= 7
                && eq_bytes(in src[ra0..wrapping_add(ra0, 7)], in "super::".as_bytes()) {
                let ra = wrapping_add(ra0, 7);
                let mut end = ra;
                loop {
                    if end >= rz || !is_ident_byte(byte_at(in src, end)) {
                        break;
                    }
                    end = wrapping_add(end, 1);
                }
                if end > ra {
                    push_unique_name(inout super_out, in src[ra..end]);
                }
            }
        }
    }
    (self_out, super_out)
}

struct PkgNode {
    name: ChunkSeq[u8],
    dir: ChunkSeq[u8],
    dep_names: ChunkSeq[ChunkSeq[u8]],
    dep_indices: ChunkSeq[u64],
}

struct FileEntry {
    display: ChunkSeq[u8],
    base: u64,
}

struct ModEntry {
    pkg: u64,
    segs: ChunkSeq[ChunkSeq[u8]],
    file: u64,
    text: ChunkSeq[u8],
}

fn find_pkg_by_dir(in pkgs: ChunkSeq[PkgNode], in dir: Slice[u8]) -> Option[u64] {
    for i in 0..pkgs.len() {
        match pkgs.try_get(i) {
            Option::Some(p) => {
                if eq_bytes(in p.dir.as_slice(), in dir) {
                    return Option::Some(i);
                }
            },
            Option::None => {},
        }
    }
    Option::None
}

fn load_pkg_graph(in root_dir: Slice[u8], inout pkgs: ChunkSeq[PkgNode])
    -> Option[u64] eff [Ffi[StdFs]] {
    let norm = normalize_dir(in ".".as_bytes(), in root_dir);
    match find_pkg_by_dir(in pkgs, in norm.as_slice()) {
        Option::Some(idx) => {
            return Option::Some(idx);
        },
        Option::None => {},
    }
    let mpath = join_path(in norm.as_slice(), in "Loom.toml".as_bytes());
    let mbytes = match try_read_file(in mpath.as_slice()) {
        Option::Some(b) => b,
        Option::None => {
            return Option::None;
        },
    };
    let manifest = parse_manifest(in mbytes.as_slice());
    let mut name_copy = ChunkSeq::new[u8]();
    name_copy.extend(in manifest.name.as_slice());
    let mut dir_copy = ChunkSeq::new[u8]();
    dir_copy.extend(in norm.as_slice());
    let idx = pkgs.len();
    pkgs
        .push(
            sink PkgNode {
                name: manifest.name,
                dir: norm,
                dep_names: ChunkSeq::new[ChunkSeq[u8]](),
                dep_indices: ChunkSeq::new[u64]()
            }
        );
    let mut dep_names = ChunkSeq::new[ChunkSeq[u8]]();
    let mut dep_indices = ChunkSeq::new[u64]();
    for i in 0..manifest.deps.len() {
        match manifest.deps.try_get(i) {
            Option::Some(d) => {
                let ddir = normalize_dir(in dir_copy.as_slice(), in d.path.as_slice());
                match load_pkg_graph(in ddir.as_slice(), inout pkgs) {
                    Option::Some(di) => {
                        let mut dn = ChunkSeq::new[u8]();
                        dn.extend(in d.name.as_slice());
                        dep_names.push(sink dn);
                        dep_indices.push(di);
                    },
                    Option::None => {},
                }
            },
            Option::None => {},
        }
    }
    let _ = pkgs
        .try_set(
            idx,
            sink PkgNode {
                name: name_copy,
                dir: dir_copy,
                dep_names: dep_names,
                dep_indices: dep_indices
            }
        );
    Option::Some(idx)
}

fn has_file(in files: ChunkSeq[FileEntry], in fpath: Slice[u8]) -> bool {
    for i in 0..files.len() {
        match files.try_get(i) {
            Option::Some(f) => {
                if eq_bytes(in f.display.as_slice(), in fpath) {
                    return true;
                }
            },
            Option::None => {},
        }
    }
    false
}

fn same_seg(in a: ChunkSeq[u8], in b: ChunkSeq[u8]) -> bool {
    eq_bytes(in a.as_slice(), in b.as_slice())
}

fn has_mod(in mods: ChunkSeq[ModEntry], pkg_idx: u64, in segs: ChunkSeq[ChunkSeq[u8]]) -> bool {
    for i in 0..mods.len() {
        match mods.try_get(i) {
            Option::Some(m) => {
                if m.pkg == pkg_idx && m.segs.len() == segs.len() {
                    let mut same = true;
                    for j in 0..segs.len() {
                        let ok = match m.segs.try_get(j) {
                            Option::Some(va) => match segs.try_get(j) {
                                Option::Some(vb) => same_seg(in va, in vb),
                                Option::None => false,
                            },
                            Option::None => false,
                        };
                        if !ok {
                            same = false;
                            break;
                        }
                    }
                    if same {
                        return true;
                    }
                }
            },
            Option::None => {},
        }
    }
    false
}

fn collect_mod_files(
    pkg_idx: u64,
    in src_dir: Slice[u8],
    in segs: ChunkSeq[ChunkSeq[u8]],
    in fpath: Slice[u8],
    sink text: ChunkSeq[u8],
    inout base_off: u64,
    inout files: ChunkSeq[FileEntry],
    inout mods: ChunkSeq[ModEntry]
) eff [Ffi[StdFs]] {
    if has_file(in files, in fpath) || has_mod(in mods, pkg_idx, in segs) {
        return;
    }
    let fidx = files.len();
    let mut disp = ChunkSeq::new[u8]();
    disp.extend(in fpath);
    let len = text.len();
    files
        .push(
            sink FileEntry {
                display: disp,
                base: base_off
            }
        );
    base_off = wrapping_add(base_off, wrapping_add(len, 1));
    let (sub_names, super_names) = scan_mods(in text.as_slice(), segs.len() > 0);
    let mut seg_copy = ChunkSeq::new[ChunkSeq[u8]]();
    for i in 0..segs.len() {
        match segs.try_get(i) {
            Option::Some(s) => {
                let mut sc = ChunkSeq::new[u8]();
                sc.extend(in s.as_slice());
                seg_copy.push(sink sc);
            },
            Option::None => {},
        }
    }
    mods
        .push(
            sink ModEntry {
                pkg: pkg_idx,
                segs: seg_copy,
                file: fidx,
                text: text
            }
        );
    for i in 0..sub_names.len() {
        match sub_names.try_get(i) {
            Option::Some(sub) => {
                let mut rel1 = ChunkSeq::new[u8]();
                rel1.extend(in sub.as_slice());
                rel1.extend(in ".ves".as_bytes());
                let p1 = join_path(in src_dir, in rel1.as_slice());
                let mut next_segs = ChunkSeq::new[ChunkSeq[u8]]();
                for j in 0..segs.len() {
                    match segs.try_get(j) {
                        Option::Some(s) => {
                            let mut sc = ChunkSeq::new[u8]();
                            sc.extend(in s.as_slice());
                            next_segs.push(sink sc);
                        },
                        Option::None => {},
                    }
                }
                let mut sn = ChunkSeq::new[u8]();
                sn.extend(in sub.as_slice());
                next_segs.push(sink sn);
                if !has_file(in files, in p1.as_slice())
                    && !has_mod(in mods, pkg_idx, in next_segs) {
                    match try_read_file(in p1.as_slice()) {
                        Option::Some(sub_text) => {
                            collect_mod_files(
                                pkg_idx,
                                in src_dir,
                                in next_segs,
                                in p1.as_slice(),
                                sink sub_text,
                                inout base_off,
                                inout files,
                                inout mods
                            );
                        },
                        Option::None => {
                            let sub_dir = join_path(in src_dir, in sub.as_slice());
                            let p2 = join_path(in sub_dir.as_slice(), in "mod.ves".as_bytes());
                            match try_read_file(in p2.as_slice()) {
                                Option::Some(sub_text) => {
                                    collect_mod_files(
                                        pkg_idx,
                                        in sub_dir.as_slice(),
                                        in next_segs,
                                        in p2.as_slice(),
                                        sink sub_text,
                                        inout base_off,
                                        inout files,
                                        inout mods
                                    );
                                },
                                Option::None => {},
                            }
                        },
                    }
                }
            },
            Option::None => {},
        }
    }
    for i in 0..super_names.len() {
        match super_names.try_get(i) {
            Option::Some(sup) => {
                let mut rel1 = ChunkSeq::new[u8]();
                rel1.extend(in sup.as_slice());
                rel1.extend(in ".ves".as_bytes());
                let p1 = join_path(in src_dir, in rel1.as_slice());
                let mut next_segs = ChunkSeq::new[ChunkSeq[u8]]();
                let keep = wrapping_sub(segs.len(), 1);
                for j in 0..keep {
                    match segs.try_get(j) {
                        Option::Some(s) => {
                            let mut sc = ChunkSeq::new[u8]();
                            sc.extend(in s.as_slice());
                            next_segs.push(sink sc);
                        },
                        Option::None => {},
                    }
                }
                let mut sn = ChunkSeq::new[u8]();
                sn.extend(in sup.as_slice());
                next_segs.push(sink sn);
                if !has_file(in files, in p1.as_slice())
                    && !has_mod(in mods, pkg_idx, in next_segs) {
                    match try_read_file(in p1.as_slice()) {
                        Option::Some(sub_text) => {
                            collect_mod_files(
                                pkg_idx,
                                in src_dir,
                                in next_segs,
                                in p1.as_slice(),
                                sink sub_text,
                                inout base_off,
                                inout files,
                                inout mods
                            );
                        },
                        Option::None => {},
                    }
                }
            },
            Option::None => {},
        }
    }
}

fn pkg_src_dir(in pkg_dir: Slice[u8]) -> ChunkSeq[u8] eff [Ffi[StdFs]] {
    let wasi_dir = join_path(in pkg_dir, in "src-wasip2".as_bytes());
    let wasi_lib = join_path(in wasi_dir.as_slice(), in "lib.ves".as_bytes());
    match try_read_file(in wasi_lib.as_slice()) {
        Option::Some(_) => wasi_dir,
        Option::None => join_path(in pkg_dir, in "src".as_bytes()),
    }
}

fn find_pkg_by_name(in pkgs: ChunkSeq[PkgNode], in nm: Slice[u8]) -> u64 {
    for i in 0..pkgs.len() {
        match pkgs.try_get(i) {
            Option::Some(p) => {
                if eq_bytes(in p.name.as_slice(), in nm) {
                    return i;
                }
            },
            Option::None => {},
        }
    }
    pkgs.len()
}

fn scan_pkg_submods(
    in src: Slice[u8],
    in pkgs: ChunkSeq[PkgNode],
    inout base_off: u64,
    inout files: ChunkSeq[FileEntry],
    inout mods: ChunkSeq[ModEntry]
) eff [Ffi[StdFs]] {
    let mut pos: u64 = 0;
    loop {
        if pos >= src.len() {
            break;
        }
        let nl = find_byte(in src, pos, src.len(), 10);
        let (la0, lz) = trim_range(in src, pos, nl);
        let mut la = la0;
        pos = wrapping_add(nl, 1);
        if wrapping_sub(lz, la) >= 4
            && eq_bytes(in src[la..wrapping_add(la, 4)], in "pub ".as_bytes()) {
            let (na, _nz) = trim_range(in src, wrapping_add(la, 4), lz);
            la = na;
        }
        if wrapping_sub(lz, la) >= 4
            && eq_bytes(in src[la..wrapping_add(la, 4)], in "use ".as_bytes()) {
            let (ra, rz) = trim_range(in src, wrapping_add(la, 4), lz);
            if ra < rz && byte_at(in src, ra) == 64 {
                let mut cc1 = ra;
                loop {
                    if wrapping_add(cc1, 1) >= rz {
                        cc1 = rz;
                        break;
                    }
                    if byte_at(in src, cc1) == 58 && byte_at(in src, wrapping_add(cc1, 1)) == 58 {
                        break;
                    }
                    cc1 = wrapping_add(cc1, 1);
                }
                if cc1 < rz {
                    let pi = find_pkg_by_name(in pkgs, in src[ra..cc1]);
                    if pi < pkgs.len() {
                        let m0 = wrapping_add(cc1, 2);
                        let mut m1 = m0;
                        loop {
                            if m1 >= rz || !is_ident_byte(byte_at(in src, m1)) {
                                break;
                            }
                            m1 = wrapping_add(m1, 1);
                        }
                        if m1 > m0
                            && wrapping_add(m1, 1) < rz
                            && byte_at(in src, m1) == 58
                            && byte_at(in src, wrapping_add(m1, 1)) == 58 {
                            let sdir = match pkgs.try_get(pi) {
                                Option::Some(p) => pkg_src_dir(in p.dir.as_slice()),
                                Option::None => ChunkSeq::new[u8](),
                            };
                            let mut rel = ChunkSeq::new[u8]();
                            rel.extend(in src[m0..m1]);
                            rel.extend(in ".ves".as_bytes());
                            let fpath = join_path(in sdir.as_slice(), in rel.as_slice());
                            if !has_file(in files, in fpath.as_slice()) {
                                match try_read_file(in fpath.as_slice()) {
                                    Option::Some(sub_text) => {
                                        let mut segs = ChunkSeq::new[ChunkSeq[u8]]();
                                        let mut sn = ChunkSeq::new[u8]();
                                        sn.extend(in src[m0..m1]);
                                        segs.push(sink sn);
                                        collect_mod_files(
                                            pi,
                                            in sdir.as_slice(),
                                            in segs,
                                            in fpath.as_slice(),
                                            sink sub_text,
                                            inout base_off,
                                            inout files,
                                            inout mods
                                        );
                                    },
                                    Option::None => {},
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

/// Load a Loom package graph from `root_dir` via `@vesper-std/fs` and
/// encode it in the `@vesper/check-names-packages::assembly_begin` format.
fn slice_eq_lit(in a: Slice[u8], in b: Str) -> bool {
    let bs = b.as_bytes();
    if a.len() != bs.len() {
        return false;
    }
    for i in 0..a.len() {
        if byte_at(in a, i) != byte_at(in bs, i) {
            return false;
        }
    }
    true
}

fn ends_with_ves(in a: Slice[u8]) -> bool {
    let n = a.len();
    n > 4
        && byte_at(in a, wrapping_sub(n, 4)) == 46
        && byte_at(in a, wrapping_sub(n, 3)) == 118
        && byte_at(in a, wrapping_sub(n, 2)) == 101
        && byte_at(in a, wrapping_sub(n, 1)) == 115
}

fn try_list_dir(in dir: Slice[u8]) -> Option[Entries] eff [Ffi[StdFs]] {
    handle Fail[IoError] in {
        Option::Some(list_dir_path(in dir))
    } with {
        return v => v,
        raise(_e, _k) => Option::None,
    }
}

fn scan_dir_mods(
    pkg_idx: u64,
    in dir: Slice[u8],
    in segs: ChunkSeq[ChunkSeq[u8]],
    inout base_off: u64,
    inout files: ChunkSeq[FileEntry],
    inout mods: ChunkSeq[ModEntry]
) eff [Ffi[StdFs]] {
    let entries = match try_list_dir(in dir) {
        Option::Some(e) => e,
        Option::None => return,
    };
    let n = entry_count(in entries);
    for i in 0..n {
        let nm = match entry_path(in entries, i) {
            Option::Some(s) => s,
            Option::None => continue,
        };
        let nb = nm.as_bytes();
        let k = entry_kind(in entries, i);
        if k == kind_file() {
            if !ends_with_ves(in nb)
                || slice_eq_lit(in nb, in "lib.ves")
                || slice_eq_lit(in nb, in "main.ves")
                || slice_eq_lit(in nb, in "mod.ves") {
                continue;
            }
            let p1 = entry_join(in dir, in entries, i);
            let mut next_segs = ChunkSeq::new[ChunkSeq[u8]]();
            for j in 0..segs.len() {
                match segs.try_get(j) {
                    Option::Some(s) => {
                        let mut sc = ChunkSeq::new[u8]();
                        sc.extend(in s.as_slice());
                        next_segs.push(sink sc);
                    },
                    Option::None => {},
                }
            }
            let mut sn = ChunkSeq::new[u8]();
            sn.extend(in nb[0..wrapping_sub(nb.len(), 4)]);
            next_segs.push(sink sn);
            if !has_file(in files, in p1.as_slice()) && !has_mod(in mods, pkg_idx, in next_segs) {
                match try_read_file(in p1.as_slice()) {
                    Option::Some(sub_text) => {
                        collect_mod_files(
                            pkg_idx,
                            in dir,
                            in next_segs,
                            in p1.as_slice(),
                            sink sub_text,
                            inout base_off,
                            inout files,
                            inout mods
                        );
                    },
                    Option::None => {},
                }
            }
        } else if k == kind_dir() {
            let sub_dir = entry_join(in dir, in entries, i);
            let mut next_segs = ChunkSeq::new[ChunkSeq[u8]]();
            for j in 0..segs.len() {
                match segs.try_get(j) {
                    Option::Some(s) => {
                        let mut sc = ChunkSeq::new[u8]();
                        sc.extend(in s.as_slice());
                        next_segs.push(sink sc);
                    },
                    Option::None => {},
                }
            }
            let mut sn = ChunkSeq::new[u8]();
            sn.extend(in nb);
            next_segs.push(sink sn);
            let p2 = join_path(in sub_dir.as_slice(), in "mod.ves".as_bytes());
            if !has_file(in files, in p2.as_slice()) && !has_mod(in mods, pkg_idx, in next_segs) {
                match try_read_file(in p2.as_slice()) {
                    Option::Some(sub_text) => {
                        collect_mod_files(
                            pkg_idx,
                            in sub_dir.as_slice(),
                            in next_segs,
                            in p2.as_slice(),
                            sink sub_text,
                            inout base_off,
                            inout files,
                            inout mods
                        );
                    },
                    Option::None => {},
                }
            }
            scan_dir_mods(
                pkg_idx,
                in sub_dir.as_slice(),
                in next_segs,
                inout base_off,
                inout files,
                inout mods
            );
        }
    }
}

pub fn load_package_graph_bytes(in root_dir: Slice[u8]) -> Option[ChunkSeq[u8]] eff [Ffi[StdFs]] {
    let mut pkgs = ChunkSeq::new[PkgNode]();
    match load_pkg_graph(in root_dir, inout pkgs) {
        Option::Some(_) => {},
        Option::None => {
            return Option::None;
        },
    }
    let mut files = ChunkSeq::new[FileEntry]();
    let mut mods = ChunkSeq::new[ModEntry]();
    let mut base_off: u64 = 0;
    for pi in 0..pkgs.len() {
        let dir = match pkgs.try_get(pi) {
            Option::Some(p) => {
                let mut d = ChunkSeq::new[u8]();
                d.extend(in p.dir.as_slice());
                d
            },
            Option::None => ChunkSeq::new[u8](),
        };
        let src_dir = pkg_src_dir(in dir.as_slice());
        let lib_p = join_path(in src_dir.as_slice(), in "lib.ves".as_bytes());
        let main_p = join_path(in src_dir.as_slice(), in "main.ves".as_bytes());
        let root_segs = ChunkSeq::new[ChunkSeq[u8]]();
        match try_read_file(in lib_p.as_slice()) {
            Option::Some(t) => {
                collect_mod_files(
                    pi,
                    in src_dir.as_slice(),
                    in root_segs,
                    in lib_p.as_slice(),
                    sink t,
                    inout base_off,
                    inout files,
                    inout mods
                );
            },
            Option::None => {
                match try_read_file(in main_p.as_slice()) {
                    Option::Some(t) => {
                        collect_mod_files(
                            pi,
                            in src_dir.as_slice(),
                            in root_segs,
                            in main_p.as_slice(),
                            sink t,
                            inout base_off,
                            inout files,
                            inout mods
                        );
                    },
                    Option::None => {},
                }
            },
        }
        scan_dir_mods(
            pi,
            in src_dir.as_slice(),
            in root_segs,
            inout base_off,
            inout files,
            inout mods
        );
    }
    let mut scan_idx: u64 = 0;
    loop {
        if scan_idx >= mods.len() {
            break;
        }
        let mtext = match mods.try_get(scan_idx) {
            Option::Some(m) => {
                let mut c = ChunkSeq::new[u8]();
                c.extend(in m.text.as_slice());
                c
            },
            Option::None => ChunkSeq::new[u8](),
        };
        scan_pkg_submods(in mtext.as_slice(), in pkgs, inout base_off, inout files, inout mods);
        scan_idx = wrapping_add(scan_idx, 1);
    }
    let mut sp_segs = ChunkSeq::new[ChunkSeq[u8]]();
    let mut sp_seg = ChunkSeq::new[u8]();
    sp_seg.extend(in "intrinsics".as_bytes());
    sp_segs.push(sink sp_seg);
    let mut sp_src = ChunkSeq::new[u8]();
    sp_src.extend(in "impl String { fn new() -> String { \"\" } ".as_bytes());
    sp_src
        .extend(
            in "fn with_capacity(n: u64) -> String { let mut s = String::new(); s.reserve(n); s } "
                .as_bytes()
        );
    sp_src
        .extend(
            in "fn utf8_byte(in bytes: Slice[u8], i: u64) -> u32 { match bytes.try_get(i) { Option::Some(b) => widen_u32(b), Option::None => 0 } } "
                .as_bytes()
        );
    sp_src
        .extend(
            in "fn utf8_width(in bytes: Slice[u8], i: u64) -> u64 { let b0 = String::utf8_byte(in bytes, i); let b1 = String::utf8_byte(in bytes, wrapping_add(i, 1)); let c2 = (String::utf8_byte(in bytes, wrapping_add(i, 2)) & 192) == 128; let c3 = (String::utf8_byte(in bytes, wrapping_add(i, 3)) & 192) == 128; if b0 < 128 { 1 } else if b0 < 194 { 0 } else if b0 < 224 { if (b1 & 192) == 128 { 2 } else { 0 } } else if b0 < 240 { let lo: u32 = if b0 == 224 { 160 } else { 128 }; let hi: u32 = if b0 == 237 { 159 } else { 191 }; if b1 >= lo && b1 <= hi && c2 { 3 } else { 0 } } else if b0 < 245 { let lo: u32 = if b0 == 240 { 144 } else { 128 }; let hi: u32 = if b0 == 244 { 143 } else { 191 }; if b1 >= lo && b1 <= hi && c2 && c3 { 4 } else { 0 } } else { 0 } } "
                .as_bytes()
        );
    sp_src
        .extend(
            in "fn utf8_decode(in bytes: Slice[u8], i: u64, w: u64) -> u32 { let b0 = String::utf8_byte(in bytes, i); let c1 = String::utf8_byte(in bytes, wrapping_add(i, 1)) & 63; let c2 = String::utf8_byte(in bytes, wrapping_add(i, 2)) & 63; let c3 = String::utf8_byte(in bytes, wrapping_add(i, 3)) & 63; if w == 1 { b0 } else if w == 2 { wrapping_mul(b0 & 31, 64) | c1 } else if w == 3 { wrapping_mul(b0 & 15, 4096) | wrapping_mul(c1, 64) | c2 } else { wrapping_mul(b0 & 7, 262144) | wrapping_mul(c1, 4096) | wrapping_mul(c2, 64) | c3 } } "
                .as_bytes()
        );
    sp_src
        .extend(
            in "fn from_utf8(in bytes: Slice[u8]) -> Option[String] { let n = bytes.len(); let mut out = String::with_capacity(n); let mut i: u64 = 0; let mut valid = true; loop { if i >= n { break; } let w = String::utf8_width(in bytes, i); if w == 0 || w > wrapping_sub(n, i) { valid = false; break; } out.push_char(String::utf8_decode(in bytes, i, w)); i = wrapping_add(i, w); } if valid { Option::Some(out) } else { Option::None } } } "
                .as_bytes()
        );
    sp_src
        .extend(
            in "pub fn checked_add_u64(a: u64, b: u64) -> Option[u64] { if b > wrapping_sub(18446744073709551615, a) { Option::None } else { Option::Some(wrapping_add(a, b)) } } "
                .as_bytes()
        );
    sp_src
        .extend(
            in "pub fn checked_sub_u64(a: u64, b: u64) -> Option[u64] { if b > a { Option::None } else { Option::Some(wrapping_sub(a, b)) } } "
                .as_bytes()
        );
    sp_src
        .extend(
            in "pub fn checked_mul_u64(a: u64, b: u64) -> Option[u64] { if a == 0 || b == 0 { Option::Some(0) } else if a > 18446744073709551615 / b { Option::None } else { Option::Some(wrapping_mul(a, b)) } } "
                .as_bytes()
        );
    sp_src
        .extend(
            in "pub fn checked_add_u128(a: u128, b: u128) -> Option[u128] { let s = wrapping_add(a, b); if s < a { Option::None } else { Option::Some(s) } } "
                .as_bytes()
        );
    sp_src
        .extend(
            in "pub fn checked_mul_u128(a: u128, b: u128) -> Option[u128] { if a == 0 || b == 0 { Option::Some(0) } else { let p = wrapping_mul(a, b); if p / a != b { Option::None } else { Option::Some(p) } } } "
                .as_bytes()
        );
    sp_src.extend(in "pub fn wrapping_neg_i64(x: i64) -> i64 { wrapping_sub(0, x) } ".as_bytes());
    sp_src
        .extend(
            in "pub fn wrapping_shl_u64(x: u64, n: u32) -> u64 { x << widen_u64(n & 63) } "
                .as_bytes()
        );
    sp_src
        .extend(
            in "pub fn wrapping_shr_u64(x: u64, n: u32) -> u64 { x >> widen_u64(n & 63) } "
                .as_bytes()
        );
    sp_src
        .extend(in "pub fn wrapping_shl_u32(x: u32, n: u32) -> u32 { x << (n & 31) } ".as_bytes());
    sp_src
        .extend(in "pub fn wrapping_shr_u32(x: u32, n: u32) -> u32 { x >> (n & 31) } ".as_bytes());
    sp_src
        .extend(
            in "pub fn trailing_zeros_u64(x: u64) -> u32 { if x == 0 { 64 } else { let mut v = x; let mut c: u32 = 0; loop { if (v & 1) != 0 { break; } v = wrapping_shr_u64(v, 1); c = wrapping_add(c, 1); } c } }"
                .as_bytes()
        );
    collect_mod_files(
        0,
        in "".as_bytes(),
        in sp_segs,
        in "$string_prelude.ves".as_bytes(),
        sink sp_src,
        inout base_off,
        inout files,
        inout mods
    );
    let mut out = ChunkSeq::new[u8]();
    put_u64(inout out, pkgs.len());
    for pi in 0..pkgs.len() {
        match pkgs.try_get(pi) {
            Option::Some(p) => {
                put_str(inout out, in p.name.as_slice());
                put_u64(inout out, p.dep_names.len());
                for di in 0..p.dep_names.len() {
                    let idx = match p.dep_indices.try_get(di) {
                        Option::Some(v) => v,
                        Option::None => 0,
                    };
                    match p.dep_names.try_get(di) {
                        Option::Some(n) => put_str(inout out, in n.as_slice()),
                        Option::None => put_str(inout out, in "".as_bytes()),
                    }
                    put_u64(inout out, idx);
                }
                // optional dependencies count = 0
                put_u64(inout out, 0);
            },
            Option::None => {},
        }
    }
    put_u64(inout out, files.len());
    for fi in 0..files.len() {
        match files.try_get(fi) {
            Option::Some(f) => {
                put_str(inout out, in f.display.as_slice());
                put_u64(inout out, f.base);
            },
            Option::None => {},
        }
    }
    put_u64(inout out, mods.len());
    for mi in 0..mods.len() {
        match mods.try_get(mi) {
            Option::Some(m) => {
                put_u64(inout out, m.pkg);
                put_u64(inout out, m.segs.len());
                for si in 0..m.segs.len() {
                    match m.segs.try_get(si) {
                        Option::Some(s) => put_str(inout out, in s.as_slice()),
                        Option::None => put_str(inout out, in "".as_bytes()),
                    }
                }
                put_u64(inout out, m.file);
                put_str(inout out, in m.text.as_slice());
            },
            Option::None => {},
        }
    }
    Option::Some(out)
}
