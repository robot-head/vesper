// Pure-Vesper Loom package graph loader over `@vesper-std/fs`, encoding
// the package graph into the word stream expected by
// `@vesper/check-names-packages::assembly_begin`.

use @vesper/check-data::util::{stage2_heap_mark, stage2_heap_reset};
use @vesper/check-names-packages::{resolve_sugar_imports_bytes};
use @vesper/sugar::driver::{
    PackageSugarBinding, PackageSugarDefinition, expand_bootstrap_module, inspect_module_sugars,
    may_declare_sugar, plan_bootstrap_sugars
};

use @vesper-std/fs::{IoError, kind_dir, kind_file, kind_symlink, read_path};
use @vesper-std/fs::walk::{Entries, entry_count, entry_join, entry_kind, entry_path, list_dir_path};

fn put_u64(inout o: ChunkSeq[u8], v: u64) {
    for k in 0..8 {
        o.push(wrapping_u8(wrapping_shr_u64(v, wrapping_u32(wrapping_mul(k, 8))) & 255));
    }
}

fn put_str(inout o: ChunkSeq[u8], in s: Slice[u8]) {
    put_u64(inout o, s.len());
    o.extend(in s);
    let rem = s.len() & 7;
    if rem != 0 {
        let pad = wrapping_sub(8, rem);
        for _i in 0..pad {
            o.push(0);
        }
    }
}

fn join_path(in dir: Slice[u8], in rel: Slice[u8]) -> ChunkSeq[u8] {
    let mut out = ChunkSeq::new[u8]();
    if dir.len() == 0 || (dir.len() == 1 && byte_at(in dir, 0) == 46) {
        out.extend(in rel);
        return out;
    }
    out.extend(in dir);
    let last = byte_at(in dir, wrapping_sub(dir.len(), 1));
    if last != 47 && last != 92 {
        out.push(47);
    }
    out.extend(in rel);
    out
}

fn byte_at(in s: Slice[u8], i: u64) -> u8 {
    match s.try_get(i) {
        Option::Some(b) => b,
        Option::None => 0,
    }
}

fn eq_bytes(in a: Slice[u8], in b: Slice[u8]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for i in 0..a.len() {
        if byte_at(in a, i) != byte_at(in b, i) {
            return false;
        }
    }
    true
}

fn contains_word(in source: Slice[u8], in word: Str) -> bool {
    let bytes = word.as_bytes();
    for start in 0..source.len() {
        let end = wrapping_add(start, bytes.len());
        if end > source.len() {
            break;
        }
        if (start == 0 || !is_ident_byte(byte_at(in source, wrapping_sub(start, 1))))
            && (end == source.len() || !is_ident_byte(byte_at(in source, end)))
            && eq_bytes(in source[start..end], in bytes)
        {
            return true;
        }
    }
    false
}

fn try_read_file(in path: Slice[u8]) -> Option[ChunkSeq[u8]] eff [Ffi[StdFs]] {
    handle Fail[IoError] in {
        let bytes = read_path(in path);
        Option::Some(bytes)
    } with {
        return v => v,
        raise(_e, _k) => Option::None,
    }
}

fn trim_range(in s: Slice[u8], start: u64, end0: u64) -> (u64, u64) {
    let mut a = start;
    let mut z = end0;
    if z > a && byte_at(in s, wrapping_sub(z, 1)) == 13 {
        z = wrapping_sub(z, 1);
    }
    loop {
        if a >= z {
            break;
        }
        let b = byte_at(in s, a);
        if b == 32 || b == 9 {
            a = wrapping_add(a, 1);
        } else {
            break;
        }
    }
    loop {
        if z <= a {
            break;
        }
        let b = byte_at(in s, wrapping_sub(z, 1));
        if b == 32 || b == 9 {
            z = wrapping_sub(z, 1);
        } else {
            break;
        }
    }
    (a, z)
}

fn find_byte(in s: Slice[u8], from: u64, end0: u64, target: u8) -> u64 {
    for i in from..end0 {
        if byte_at(in s, i) == target {
            return i;
        }
    }
    end0
}

// Parse `"..."` starting at or after `from` within `..end0`.
fn parse_quoted(in s: Slice[u8], from: u64, end0: u64) -> (u64, u64, bool) {
    let q1 = find_byte(in s, from, end0, 34);
    if q1 >= end0 {
        return (0, 0, false);
    }
    let a = wrapping_add(q1, 1);
    let q2 = find_byte(in s, a, end0, 34);
    if q2 >= end0 {
        return (0, 0, false);
    }
    (a, q2, true)
}

fn normalize_dir(in base: Slice[u8], in rel: Slice[u8]) -> ChunkSeq[u8] {
    let joined = if rel.len() > 0 && byte_at(in rel, 0) == 47 {
        let mut c = ChunkSeq::new[u8]();
        c.extend(in rel);
        c
    } else {
        join_path(in base, in rel)
    };
    let s = joined.as_slice();
    let abs = s.len() > 0 && byte_at(in s, 0) == 47;
    let mut segs = ChunkSeq::new[ChunkSeq[u8]]();
    let mut i: u64 = 0;
    loop {
        if i >= s.len() {
            break;
        }
        let next = find_byte(in s, i, s.len(), 47);
        let seg = s[i..next];
        if seg.len() > 0 && !eq_bytes(in seg, in ".".as_bytes()) {
            if eq_bytes(in seg, in "..".as_bytes()) {
                if segs.len() > 0 {
                    segs.truncate(wrapping_sub(segs.len(), 1));
                }
            } else {
                let mut cp = ChunkSeq::new[u8]();
                cp.extend(in seg);
                segs.push(sink cp);
            }
        }
        i = wrapping_add(next, 1);
    }
    let mut out = ChunkSeq::new[u8]();
    if abs {
        out.push(47);
    }
    for k in 0..segs.len() {
        if k > 0 {
            out.push(47);
        }
        match segs.try_get(k) {
            Option::Some(seg) => out.extend(in seg.as_slice()),
            Option::None => {},
        }
    }
    if out.len() == 0 {
        out.push(46);
    }
    out
}

struct DepSpec {
    name: ChunkSeq[u8],
    path: ChunkSeq[u8],
}

struct Manifest {
    name: ChunkSeq[u8],
    deps: ChunkSeq[DepSpec],
    // `[package] vsys`: the `.vsys` files the package names (§16.3).
    vsys: ChunkSeq[ChunkSeq[u8]],
}

fn parse_manifest(in text: Slice[u8]) -> Manifest {
    let mut pkg_name = ChunkSeq::new[u8]();
    let mut deps = ChunkSeq::new[DepSpec]();
    let mut vsys = ChunkSeq::new[ChunkSeq[u8]]();
    let mut sec: u8 = 0;
    let mut pos: u64 = 0;
    loop {
        if pos >= text.len() {
            break;
        }
        let nl = find_byte(in text, pos, text.len(), 10);
        let (la, lz) = trim_range(in text, pos, nl);
        pos = wrapping_add(nl, 1);
        if la >= lz || byte_at(in text, la) == 35 {
            continue;
        }
        if byte_at(in text, la) == 91 {
            let line = text[la..lz];
            if eq_bytes(in line, in "[package]".as_bytes()) {
                sec = 1;
            } else if eq_bytes(in line, in "[dependencies]".as_bytes()) {
                sec = 2;
            } else {
                sec = 0;
            }
            continue;
        }
        if sec == 1 {
            let eq = find_byte(in text, la, lz, 61);
            if eq < lz {
                let (ka, kz) = trim_range(in text, la, eq);
                if eq_bytes(in text[ka..kz], in "name".as_bytes()) {
                    let (a, z, ok) = parse_quoted(in text, wrapping_add(eq, 1), lz);
                    if ok {
                        pkg_name.clear();
                        pkg_name.extend(in text[a..z]);
                    }
                } else if eq_bytes(in text[ka..kz], in "vsys".as_bytes()) {
                    // A one-line list of quoted paths.
                    let mut q = wrapping_add(eq, 1);
                    loop {
                        let (a, z, ok) = parse_quoted(in text, q, lz);
                        if !ok {
                            break;
                        }
                        let mut v = ChunkSeq::new[u8]();
                        v.extend(in text[a..z]);
                        vsys.push(sink v);
                        q = wrapping_add(z, 1);
                    }
                }
            }
        } else if sec == 2 {
            let eq = find_byte(in text, la, lz, 61);
            if eq < lz {
                let (rka, rkz) = trim_range(in text, la, eq);
                let (ka, kz, kok) = parse_quoted(in text, rka, rkz);
                let (da, dz) = if kok { (ka, kz) } else { (rka, rkz) };
                let mut p_idx = wrapping_add(eq, 1);
                let mut found_path = false;
                let mut pa: u64 = 0;
                let mut pz: u64 = 0;
                loop {
                    if p_idx >= lz {
                        break;
                    }
                    if wrapping_add(p_idx, 4) <= lz
                        && eq_bytes(in text[p_idx..wrapping_add(p_idx, 4)], in "path".as_bytes())
                    {
                        let peq = find_byte(in text, wrapping_add(p_idx, 4), lz, 61);
                        if peq < lz {
                            let (qa, qz, qok) = parse_quoted(in text, wrapping_add(peq, 1), lz);
                            if qok {
                                pa = qa;
                                pz = qz;
                                found_path = true;
                                break;
                            }
                        }
                    }
                    p_idx = wrapping_add(p_idx, 1);
                }
                if found_path {
                    let mut dn = ChunkSeq::new[u8]();
                    dn.extend(in text[da..dz]);
                    let mut dp = ChunkSeq::new[u8]();
                    dp.extend(in text[pa..pz]);
                    deps.push(sink DepSpec { name: dn, path: dp });
                }
            }
        }
    }
    Manifest { name: pkg_name, deps: deps, vsys: vsys }
}

fn is_ident_byte(b: u8) -> bool {
    (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57) || b == 95
}

// Scan top-level `mod <ident>;` or `pub mod <ident>;` declarations.
fn push_unique_name(inout out: ChunkSeq[ChunkSeq[u8]], in slice: Slice[u8]) {
    for i in 0..out.len() {
        match out.try_get(i) {
            Option::Some(existing) => {
                if eq_bytes(in existing.as_slice(), in slice) {
                    return;
                }
            },
            Option::None => {},
        }
    }
    let mut name = ChunkSeq::new[u8]();
    name.extend(in slice);
    out.push(sink name);
}

fn scan_mods(
    in src: Slice[u8],
    include_super: bool
) -> (ChunkSeq[ChunkSeq[u8]], ChunkSeq[ChunkSeq[u8]]) {
    let mut self_out = ChunkSeq::new[ChunkSeq[u8]]();
    let mut super_out = ChunkSeq::new[ChunkSeq[u8]]();
    let mut pos: u64 = 0;
    loop {
        if pos >= src.len() {
            break;
        }
        let nl = find_byte(in src, pos, src.len(), 10);
        let (la0, lz) = trim_range(in src, pos, nl);
        let mut la = la0;
        pos = wrapping_add(nl, 1);
        if wrapping_sub(lz, la) >= 4
            && eq_bytes(in src[la..wrapping_add(la, 4)], in "pub ".as_bytes())
        {
            let (na, _nz) = trim_range(in src, wrapping_add(la, 4), lz);
            la = na;
        }
        if wrapping_sub(lz, la) >= 4
            && eq_bytes(in src[la..wrapping_add(la, 4)], in "mod ".as_bytes())
        {
            let (ra, rz) = trim_range(in src, wrapping_add(la, 4), lz);
            let mut end = ra;
            loop {
                if end >= rz || !is_ident_byte(byte_at(in src, end)) {
                    break;
                }
                end = wrapping_add(end, 1);
            }
            if end > ra {
                let (aa, az) = trim_range(in src, end, rz);
                if aa < az && byte_at(in src, aa) == 59 {
                    push_unique_name(inout self_out, in src[ra..end]);
                }
            }
        } else if wrapping_sub(lz, la) >= 4
            && eq_bytes(in src[la..wrapping_add(la, 4)], in "use ".as_bytes())
        {
            let (ra0, rz) = trim_range(in src, wrapping_add(la, 4), lz);
            if wrapping_sub(rz, ra0) >= 6
                && eq_bytes(in src[ra0..wrapping_add(ra0, 6)], in "self::".as_bytes())
            {
                let ra = wrapping_add(ra0, 6);
                let mut end = ra;
                loop {
                    if end >= rz || !is_ident_byte(byte_at(in src, end)) {
                        break;
                    }
                    end = wrapping_add(end, 1);
                }
                if end > ra {
                    if include_super {
                        push_unique_name(inout super_out, in src[ra..end]);
                    } else {
                        push_unique_name(inout self_out, in src[ra..end]);
                    }
                }
            } else if include_super
                && wrapping_sub(rz, ra0) >= 7
                && eq_bytes(in src[ra0..wrapping_add(ra0, 7)], in "super::".as_bytes())
            {
                let ra = wrapping_add(ra0, 7);
                let mut end = ra;
                loop {
                    if end >= rz || !is_ident_byte(byte_at(in src, end)) {
                        break;
                    }
                    end = wrapping_add(end, 1);
                }
                if end > ra {
                    push_unique_name(inout super_out, in src[ra..end]);
                }
            }
        }
    }
    (self_out, super_out)
}

struct PkgNode {
    name: ChunkSeq[u8],
    dir: ChunkSeq[u8],
    dep_names: ChunkSeq[ChunkSeq[u8]],
    dep_indices: ChunkSeq[u64],
    // The type names the package's `.vsys` libraries declare.
    vsys_types: ChunkSeq[ChunkSeq[u8]],
    // The `.vsys` files the manifest names (`[package] vsys`), joined to
    // the package directory, with `@TARGET@`, `@OS@` and `@ARCH@` kept.
    vsys_paths: ChunkSeq[ChunkSeq[u8]],
}

// `path` with `@TARGET@`, `@OS@` and `@ARCH@` replaced for wasm32-wasip2,
// the one target Stage 2 builds for (Rust `expand_vsys_path`).
fn expand_vsys_path_wasip2(in path: Slice[u8]) -> ChunkSeq[u8] {
    let mut out = ChunkSeq::new[u8]();
    let mut i: u64 = 0;
    loop {
        if i >= path.len() {
            break;
        }
        let rest = path[i..path.len()];
        if starts_with(in rest, in "@TARGET@".as_bytes()) {
            out.extend(in "wasm32-wasip2".as_bytes());
            i = wrapping_add(i, 8);
        } else if starts_with(in rest, in "@OS@".as_bytes()) {
            out.extend(in "wasip2".as_bytes());
            i = wrapping_add(i, 4);
        } else if starts_with(in rest, in "@ARCH@".as_bytes()) {
            out.extend(in "wasm32".as_bytes());
            i = wrapping_add(i, 6);
        } else {
            out.push(byte_at(in path, i));
            i = wrapping_add(i, 1);
        }
    }
    out
}

fn starts_with(in s: Slice[u8], in p: Slice[u8]) -> bool {
    if s.len() < p.len() {
        return false;
    }
    eq_bytes(in s[0..p.len()], in p)
}

// The type names a `.vsys` library declares: its `extern type`s, `wire
// struct`s and `enum`s (Rust `PackageVsys::type_names`). A word scan that
// skips `//` comments and string literals.
fn scan_vsys_types(in src: Slice[u8], inout out: ChunkSeq[ChunkSeq[u8]]) {
    let n = src.len();
    let mut i: u64 = 0;
    // 0: none, 1: saw `extern`, 2: saw `wire`, 3: next word is a name.
    let mut st: u8 = 0;
    loop {
        if i >= n {
            break;
        }
        let b = byte_at(in src, i);
        if b == 47 && byte_at(in src, wrapping_add(i, 1)) == 47 {
            i = find_byte(in src, i, n, 10);
            continue;
        }
        if b == 34 {
            i = wrapping_add(find_byte(in src, wrapping_add(i, 1), n, 34), 1);
            st = 0;
            continue;
        }
        if !is_ident_byte(b) {
            i = wrapping_add(i, 1);
            continue;
        }
        let a = i;
        loop {
            if i >= n || !is_ident_byte(byte_at(in src, i)) {
                break;
            }
            i = wrapping_add(i, 1);
        }
        let word = src[a..i];
        if st == 3 {
            push_unique_name(inout out, in word);
            st = 0;
        } else if eq_bytes(in word, in "extern".as_bytes()) {
            st = 1;
        } else if eq_bytes(in word, in "wire".as_bytes()) {
            st = 2;
        } else if st == 1 && eq_bytes(in word, in "type".as_bytes()) {
            st = 3;
        } else if st == 2 && eq_bytes(in word, in "struct".as_bytes()) {
            st = 3;
        } else if eq_bytes(in word, in "enum".as_bytes()) {
            st = 3;
        } else {
            st = 0;
        }
    }
}

struct FileEntry {
    display: ChunkSeq[u8],
    base: u64,
}

struct ModEntry {
    pkg: u64,
    segs: ChunkSeq[ChunkSeq[u8]],
    file: u64,
    text: ChunkSeq[u8],
}

fn find_pkg_by_dir(in pkgs: ChunkSeq[PkgNode], in dir: Slice[u8]) -> Option[u64] {
    for i in 0..pkgs.len() {
        match pkgs.try_get(i) {
            Option::Some(p) => {
                if eq_bytes(in p.dir.as_slice(), in dir) {
                    return Option::Some(i);
                }
            },
            Option::None => {},
        }
    }
    Option::None
}

fn load_pkg_graph(
    in root_dir: Slice[u8],
    inout pkgs: ChunkSeq[PkgNode]
) -> Option[u64] eff [Ffi[StdFs]] {
    let norm = normalize_dir(in ".".as_bytes(), in root_dir);
    match find_pkg_by_dir(in pkgs, in norm.as_slice()) {
        Option::Some(idx) => {
            return Option::Some(idx);
        },
        Option::None => {},
    }
    let mpath = join_path(in norm.as_slice(), in "Loom.toml".as_bytes());
    let mbytes = match try_read_file(in mpath.as_slice()) {
        Option::Some(b) => b,
        Option::None => {
            return Option::None;
        },
    };
    let manifest = parse_manifest(in mbytes.as_slice());
    let mut vsys_paths = ChunkSeq::new[ChunkSeq[u8]]();
    let mut vsys_types = ChunkSeq::new[ChunkSeq[u8]]();
    for vi in 0..manifest.vsys.len() {
        match manifest.vsys.try_get(vi) {
            Option::Some(v) => {
                vsys_paths.push(join_path(in norm.as_slice(), in v.as_slice()));
                let rel = expand_vsys_path_wasip2(in v.as_slice());
                let vpath = join_path(in norm.as_slice(), in rel.as_slice());
                match try_read_file(in vpath.as_slice()) {
                    Option::Some(t) => scan_vsys_types(in t.as_slice(), inout vsys_types),
                    Option::None => {},
                }
            },
            Option::None => {},
        }
    }
    let mut name_copy = ChunkSeq::new[u8]();
    name_copy.extend(in manifest.name.as_slice());
    let mut dir_copy = ChunkSeq::new[u8]();
    dir_copy.extend(in norm.as_slice());
    let idx = pkgs.len();
    pkgs.push(
        sink PkgNode {
            name: manifest.name,
            dir: norm,
            dep_names: ChunkSeq::new[ChunkSeq[u8]](),
            dep_indices: ChunkSeq::new[u64](),
            vsys_types: ChunkSeq::new[ChunkSeq[u8]](),
            vsys_paths: ChunkSeq::new[ChunkSeq[u8]]()
        }
    );
    let mut dep_names = ChunkSeq::new[ChunkSeq[u8]]();
    let mut dep_indices = ChunkSeq::new[u64]();
    for i in 0..manifest.deps.len() {
        match manifest.deps.try_get(i) {
            Option::Some(d) => {
                let ddir = normalize_dir(in dir_copy.as_slice(), in d.path.as_slice());
                match load_pkg_graph(in ddir.as_slice(), inout pkgs) {
                    Option::Some(di) => {
                        let mut dn = ChunkSeq::new[u8]();
                        dn.extend(in d.name.as_slice());
                        dep_names.push(sink dn);
                        dep_indices.push(di);
                    },
                    Option::None => {},
                }
            },
            Option::None => {},
        }
    }
    let _ = pkgs.try_set(
        idx,
        sink PkgNode {
            name: name_copy,
            dir: dir_copy,
            dep_names: dep_names,
            dep_indices: dep_indices,
            vsys_types: vsys_types,
            vsys_paths: vsys_paths
        }
    );
    Option::Some(idx)
}

fn has_file(in files: ChunkSeq[FileEntry], in fpath: Slice[u8]) -> bool {
    for i in 0..files.len() {
        match files.try_get(i) {
            Option::Some(f) => {
                if eq_bytes(in f.display.as_slice(), in fpath) {
                    return true;
                }
            },
            Option::None => {},
        }
    }
    false
}

fn same_seg(in a: ChunkSeq[u8], in b: ChunkSeq[u8]) -> bool {
    eq_bytes(in a.as_slice(), in b.as_slice())
}

fn has_mod(in mods: ChunkSeq[ModEntry], pkg_idx: u64, in segs: ChunkSeq[ChunkSeq[u8]]) -> bool {
    for i in 0..mods.len() {
        match mods.try_get(i) {
            Option::Some(m) => {
                if m.pkg == pkg_idx && m.segs.len() == segs.len() {
                    let mut same = true;
                    for j in 0..segs.len() {
                        let ok = match m.segs.try_get(j) {
                            Option::Some(va) => match segs.try_get(j) {
                                Option::Some(vb) => same_seg(in va, in vb),
                                Option::None => false,
                            },
                            Option::None => false,
                        };
                        if !ok {
                            same = false;
                            break;
                        }
                    }
                    if same {
                        return true;
                    }
                }
            },
            Option::None => {},
        }
    }
    false
}

// ---------------------------------------------------------------- include_str

// The module text with every `include_str("path")` call replaced by a
// string literal holding the package file at `path`, as
// `packages::expand_includes` (src/packages.rs) expands it: `None` when
// there is no call to expand. A call that the Rust loader rejects (a path
// that leaves the package, a missing file) stays as it is, so the checker
// reports the unknown `include_str`.
fn expand_includes(
    in pkg_dir: Slice[u8],
    in s: Slice[u8]
) -> Option[ChunkSeq[u8]] eff [Ffi[StdFs]] {
    let n = s.len();
    let mut out = ChunkSeq::new[u8]();
    let mut copied: u64 = 0;
    let mut i: u64 = 0;
    loop {
        if i >= n {
            break;
        }
        let c = byte_at(in s, i);
        let d = byte_at(in s, wrapping_add(i, 1));
        if c == 47 && d == 47 {
            i = find_byte(in s, i, n, 10);
        } else if c == 47 && d == 42 {
            i = block_comment_end(in s, i);
        } else if c == 34 {
            i = string_literal_end(in s, i);
        } else if is_ident_byte(c)
            && (i == 0 || !is_ident_byte(byte_at(in s, wrapping_sub(i, 1))))
        {
            let start = i;
            loop {
                if i >= n || !is_ident_byte(byte_at(in s, i)) {
                    break;
                }
                i = wrapping_add(i, 1);
            }
            if eq_bytes(in s[start..i], in "include_str".as_bytes())
                && !after_dot_or_colon(in s, start)
            {
                let mut end = i;
                match include_call(in pkg_dir, in s, inout end) {
                    Option::Some(literal) => {
                        out.extend(in s[copied..start]);
                        out.extend(in literal.as_slice());
                        // A call over several lines keeps its line breaks
                        // after the literal, so later lines keep their numbers.
                        for k in start..end {
                            if byte_at(in s, k) == 10 {
                                out.push(10);
                            }
                        }
                        i = end;
                        copied = end;
                    },
                    Option::None => {},
                }
            }
        } else {
            i = wrapping_add(i, 1);
        }
    }
    if copied == 0 {
        return Option::None;
    }
    out.extend(in s[copied..n]);
    Option::Some(out)
}

fn is_space_byte(b: u8) -> bool {
    b == 32 || b == 9 || b == 13 || b == 10
}

fn skip_spaces(in s: Slice[u8], from: u64) -> u64 {
    let mut i = from;
    loop {
        if i >= s.len() || !is_space_byte(byte_at(in s, i)) {
            return i;
        }
        i = wrapping_add(i, 1);
    }
}

// Whether the last bytes before `at` that are not whitespace are `.` or
// `::`, a method or path whose last name is `include_str` (a field value's
// single `:` is not).
fn after_dot_or_colon(in s: Slice[u8], at: u64) -> bool {
    let mut i = at;
    loop {
        if i == 0 {
            return false;
        }
        i = wrapping_sub(i, 1);
        let b = byte_at(in s, i);
        if !is_space_byte(b) {
            return b == 46 || (b == 58 && i > 0 && byte_at(in s, wrapping_sub(i, 1)) == 58);
        }
    }
}

// One past the closing quote of the string literal opening at `s[start]`.
fn string_literal_end(in s: Slice[u8], start: u64) -> u64 {
    let n = s.len();
    let mut i = wrapping_add(start, 1);
    loop {
        if i >= n {
            return n;
        }
        let b = byte_at(in s, i);
        if b == 34 {
            return wrapping_add(i, 1);
        }
        i = wrapping_add(i, if b == 92 { 2 } else { 1 });
    }
}

// The literal for the call whose name ends at `end`, which moves one past
// its `)`: `None` when it is not a call with a string literal, or when the
// Rust loader would reject it.
fn include_call(
    in pkg_dir: Slice[u8],
    in s: Slice[u8],
    inout end: u64
) -> Option[ChunkSeq[u8]] eff [Ffi[StdFs]] {
    let mut j = skip_spaces(in s, end);
    if byte_at(in s, j) != 40 || j >= s.len() {
        return Option::None;
    }
    j = skip_spaces(in s, wrapping_add(j, 1));
    if byte_at(in s, j) != 34 || j >= s.len() {
        return Option::None;
    }
    let literal_end = string_literal_end(in s, j);
    let path = match include_path(in s[j..literal_end]) {
        Option::Some(p) => p,
        Option::None => return Option::None,
    };
    j = skip_spaces(in s, literal_end);
    if byte_at(in s, j) != 41 || j >= s.len() {
        return Option::None;
    }
    let file = join_path(in pkg_dir, in path.as_slice());
    let contents = match try_read_file(in file.as_slice()) {
        Option::Some(c) => c,
        Option::None => return Option::None,
    };
    end = wrapping_add(j, 1);
    Option::Some(json_string(in contents.as_slice()))
}

// The path of an `include_str` literal (with its quotes), whose only escapes
// are `\\` and `\"`: `None` unless it is `/`-separated names, none of them
// empty, `.` or `..`, and none with `\`, `:` or a NUL byte.
fn include_path(in lit: Slice[u8]) -> Option[ChunkSeq[u8]] {
    let n = lit.len();
    if n < 2 || byte_at(in lit, 0) != 34 || byte_at(in lit, wrapping_sub(n, 1)) != 34 {
        return Option::None;
    }
    let mut path = ChunkSeq::new[u8]();
    let mut i: u64 = 1;
    let last = wrapping_sub(n, 1);
    loop {
        if i >= last {
            break;
        }
        let b = byte_at(in lit, i);
        if b == 92 {
            let e = byte_at(in lit, wrapping_add(i, 1));
            if wrapping_add(i, 1) >= last || (e != 92 && e != 34) {
                return Option::None;
            }
            path.push(e);
            i = wrapping_add(i, 2);
        } else {
            path.push(b);
            i = wrapping_add(i, 1);
        }
    }
    if !path_is_hermetic(in path.as_slice()) {
        return Option::None;
    }
    Option::Some(path)
}

// Whether `p` is `/`-separated names, none empty, `.` or `..`, and none
// holding `\`, `:` or NUL: a file inside the package.
fn path_is_hermetic(in p: Slice[u8]) -> bool {
    let mut name_start: u64 = 0;
    for k in 0..wrapping_add(p.len(), 1) {
        let at_end = k == p.len();
        let b = byte_at(in p, k);
        if at_end || b == 47 {
            let len = wrapping_sub(k, name_start);
            let dot = len == 1 && byte_at(in p, name_start) == 46;
            let dots = len == 2
                && byte_at(in p, name_start) == 46
                && byte_at(in p, wrapping_add(name_start, 1)) == 46;
            if len == 0 || dot || dots {
                return false;
            }
            name_start = wrapping_add(k, 1);
        } else if b == 92 || b == 58 || b == 0 {
            return false;
        }
    }
    true
}

// `bytes` as a string literal, escaped as `serde_json::to_string` escapes it.
fn json_string(in bytes: Slice[u8]) -> ChunkSeq[u8] {
    let hex = "0123456789abcdef".as_bytes();
    let mut out = ChunkSeq::new[u8]();
    out.push(34);
    for i in 0..bytes.len() {
        let b = byte_at(in bytes, i);
        if b == 34 || b == 92 {
            out.push(92);
            out.push(b);
        } else if b == 10 {
            out.extend(in "\\n".as_bytes());
        } else if b == 13 {
            out.extend(in "\\r".as_bytes());
        } else if b == 9 {
            out.extend(in "\\t".as_bytes());
        } else if b == 8 {
            out.extend(in "\\b".as_bytes());
        } else if b == 12 {
            out.extend(in "\\f".as_bytes());
        } else if b < 32 {
            out.extend(in "\\u00".as_bytes());
            out.push(byte_at(in hex, widen_u64(b >> 4)));
            out.push(byte_at(in hex, widen_u64(b & 15)));
        } else {
            out.push(b);
        }
    }
    out.push(34);
    out
}

fn collect_mod_files(
    pkg_idx: u64,
    in pkg_dir: Slice[u8],
    in src_dir: Slice[u8],
    in segs: ChunkSeq[ChunkSeq[u8]],
    in fpath: Slice[u8],
    sink text: ChunkSeq[u8],
    inout base_off: u64,
    inout files: ChunkSeq[FileEntry],
    inout mods: ChunkSeq[ModEntry]
) eff [Ffi[StdFs]] {
    if has_file(in files, in fpath) || has_mod(in mods, pkg_idx, in segs) {
        return;
    }
    let expanded = expand_includes(in pkg_dir, in text.as_slice());
    let text = match expanded {
        Option::Some(t) => t,
        Option::None => text,
    };
    let fidx = files.len();
    let mut disp = ChunkSeq::new[u8]();
    disp.extend(in fpath);
    let len = text.len();
    files.push(sink FileEntry { display: disp, base: base_off });
    base_off = wrapping_add(base_off, wrapping_add(len, 1));
    let (sub_names, super_names) = scan_mods(in text.as_slice(), segs.len() > 0);
    let mut seg_copy = ChunkSeq::new[ChunkSeq[u8]]();
    for i in 0..segs.len() {
        match segs.try_get(i) {
            Option::Some(s) => {
                let mut sc = ChunkSeq::new[u8]();
                sc.extend(in s.as_slice());
                seg_copy.push(sink sc);
            },
            Option::None => {},
        }
    }
    mods.push(sink ModEntry { pkg: pkg_idx, segs: seg_copy, file: fidx, text: text });
    for i in 0..sub_names.len() {
        match sub_names.try_get(i) {
            Option::Some(sub) => {
                let mut rel1 = ChunkSeq::new[u8]();
                rel1.extend(in sub.as_slice());
                rel1.extend(in ".ves".as_bytes());
                let p1 = join_path(in src_dir, in rel1.as_slice());
                let mut next_segs = ChunkSeq::new[ChunkSeq[u8]]();
                for j in 0..segs.len() {
                    match segs.try_get(j) {
                        Option::Some(s) => {
                            let mut sc = ChunkSeq::new[u8]();
                            sc.extend(in s.as_slice());
                            next_segs.push(sink sc);
                        },
                        Option::None => {},
                    }
                }
                let mut sn = ChunkSeq::new[u8]();
                sn.extend(in sub.as_slice());
                next_segs.push(sink sn);
                if !has_file(in files, in p1.as_slice())
                    && !has_mod(in mods, pkg_idx, in next_segs)
                {
                    match try_read_file(in p1.as_slice()) {
                        Option::Some(sub_text) => {
                            collect_mod_files(
                                pkg_idx,
                                in pkg_dir,
                                in src_dir,
                                in next_segs,
                                in p1.as_slice(),
                                sink sub_text,
                                inout base_off,
                                inout files,
                                inout mods
                            );
                        },
                        Option::None => {
                            let sub_dir = join_path(in src_dir, in sub.as_slice());
                            let p2 = join_path(in sub_dir.as_slice(), in "mod.ves".as_bytes());
                            match try_read_file(in p2.as_slice()) {
                                Option::Some(sub_text) => {
                                    collect_mod_files(
                                        pkg_idx,
                                        in pkg_dir,
                                        in sub_dir.as_slice(),
                                        in next_segs,
                                        in p2.as_slice(),
                                        sink sub_text,
                                        inout base_off,
                                        inout files,
                                        inout mods
                                    );
                                },
                                Option::None => {},
                            }
                        },
                    }
                }
            },
            Option::None => {},
        }
    }
    for i in 0..super_names.len() {
        match super_names.try_get(i) {
            Option::Some(sup) => {
                let mut rel1 = ChunkSeq::new[u8]();
                rel1.extend(in sup.as_slice());
                rel1.extend(in ".ves".as_bytes());
                let p1 = join_path(in src_dir, in rel1.as_slice());
                let mut next_segs = ChunkSeq::new[ChunkSeq[u8]]();
                let keep = wrapping_sub(segs.len(), 1);
                for j in 0..keep {
                    match segs.try_get(j) {
                        Option::Some(s) => {
                            let mut sc = ChunkSeq::new[u8]();
                            sc.extend(in s.as_slice());
                            next_segs.push(sink sc);
                        },
                        Option::None => {},
                    }
                }
                let mut sn = ChunkSeq::new[u8]();
                sn.extend(in sup.as_slice());
                next_segs.push(sink sn);
                if !has_file(in files, in p1.as_slice())
                    && !has_mod(in mods, pkg_idx, in next_segs)
                {
                    match try_read_file(in p1.as_slice()) {
                        Option::Some(sub_text) => {
                            collect_mod_files(
                                pkg_idx,
                                in pkg_dir,
                                in src_dir,
                                in next_segs,
                                in p1.as_slice(),
                                sink sub_text,
                                inout base_off,
                                inout files,
                                inout mods
                            );
                        },
                        Option::None => {},
                    }
                }
            },
            Option::None => {},
        }
    }
}

fn pkg_src_dir(in pkg_dir: Slice[u8]) -> ChunkSeq[u8] eff [Ffi[StdFs]] {
    let wasi_dir = join_path(in pkg_dir, in "src-wasip2".as_bytes());
    let wasi_lib = join_path(in wasi_dir.as_slice(), in "lib.ves".as_bytes());
    match try_read_file(in wasi_lib.as_slice()) {
        Option::Some(_) => wasi_dir,
        Option::None => join_path(in pkg_dir, in "src".as_bytes()),
    }
}

fn find_pkg_by_name(in pkgs: ChunkSeq[PkgNode], in nm: Slice[u8]) -> u64 {
    for i in 0..pkgs.len() {
        match pkgs.try_get(i) {
            Option::Some(p) => {
                if eq_bytes(in p.name.as_slice(), in nm) {
                    return i;
                }
            },
            Option::None => {},
        }
    }
    pkgs.len()
}

fn scan_pkg_submods(
    in src: Slice[u8],
    in pkgs: ChunkSeq[PkgNode],
    inout base_off: u64,
    inout files: ChunkSeq[FileEntry],
    inout mods: ChunkSeq[ModEntry]
) eff [Ffi[StdFs]] {
    let mut pos: u64 = 0;
    loop {
        if pos >= src.len() {
            break;
        }
        let nl = find_byte(in src, pos, src.len(), 10);
        let (la0, lz) = trim_range(in src, pos, nl);
        let mut la = la0;
        pos = wrapping_add(nl, 1);
        if wrapping_sub(lz, la) >= 4
            && eq_bytes(in src[la..wrapping_add(la, 4)], in "pub ".as_bytes())
        {
            let (na, _nz) = trim_range(in src, wrapping_add(la, 4), lz);
            la = na;
        }
        if wrapping_sub(lz, la) >= 4
            && eq_bytes(in src[la..wrapping_add(la, 4)], in "use ".as_bytes())
        {
            let (ra, rz) = trim_range(in src, wrapping_add(la, 4), lz);
            if ra < rz && byte_at(in src, ra) == 64 {
                let mut cc1 = ra;
                loop {
                    if wrapping_add(cc1, 1) >= rz {
                        cc1 = rz;
                        break;
                    }
                    if byte_at(in src, cc1) == 58 && byte_at(in src, wrapping_add(cc1, 1)) == 58 {
                        break;
                    }
                    cc1 = wrapping_add(cc1, 1);
                }
                if cc1 < rz {
                    let pi = find_pkg_by_name(in pkgs, in src[ra..cc1]);
                    if pi < pkgs.len() {
                        let m0 = wrapping_add(cc1, 2);
                        let mut m1 = m0;
                        loop {
                            if m1 >= rz || !is_ident_byte(byte_at(in src, m1)) {
                                break;
                            }
                            m1 = wrapping_add(m1, 1);
                        }
                        if m1 > m0
                            && wrapping_add(m1, 1) < rz
                            && byte_at(in src, m1) == 58
                            && byte_at(in src, wrapping_add(m1, 1)) == 58
                        {
                            let pdir = match pkgs.try_get(pi) {
                                Option::Some(p) => {
                                    let mut d = ChunkSeq::new[u8]();
                                    d.extend(in p.dir.as_slice());
                                    d
                                },
                                Option::None => ChunkSeq::new[u8](),
                            };
                            let sdir = pkg_src_dir(in pdir.as_slice());
                            let mut rel = ChunkSeq::new[u8]();
                            rel.extend(in src[m0..m1]);
                            rel.extend(in ".ves".as_bytes());
                            let fpath = join_path(in sdir.as_slice(), in rel.as_slice());
                            if !has_file(in files, in fpath.as_slice()) {
                                match try_read_file(in fpath.as_slice()) {
                                    Option::Some(sub_text) => {
                                        let mut segs = ChunkSeq::new[ChunkSeq[u8]]();
                                        let mut sn = ChunkSeq::new[u8]();
                                        sn.extend(in src[m0..m1]);
                                        segs.push(sink sn);
                                        collect_mod_files(
                                            pi,
                                            in pdir.as_slice(),
                                            in sdir.as_slice(),
                                            in segs,
                                            in fpath.as_slice(),
                                            sink sub_text,
                                            inout base_off,
                                            inout files,
                                            inout mods
                                        );
                                    },
                                    Option::None => {},
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

/// Load a Loom package graph from `root_dir` via `@vesper-std/fs` and
/// encode it in the `@vesper/check-names-packages::assembly_begin` format.
fn slice_eq_lit(in a: Slice[u8], in b: Str) -> bool {
    let bs = b.as_bytes();
    if a.len() != bs.len() {
        return false;
    }
    for i in 0..a.len() {
        if byte_at(in a, i) != byte_at(in bs, i) {
            return false;
        }
    }
    true
}

fn ends_with_ves(in a: Slice[u8]) -> bool {
    let n = a.len();
    n > 4
        && byte_at(in a, wrapping_sub(n, 4)) == 46
        && byte_at(in a, wrapping_sub(n, 3)) == 118
        && byte_at(in a, wrapping_sub(n, 2)) == 101
        && byte_at(in a, wrapping_sub(n, 1)) == 115
}

fn try_list_dir(in dir: Slice[u8]) -> Option[Entries] eff [Ffi[StdFs]] {
    handle Fail[IoError] in {
        Option::Some(list_dir_path(in dir))
    } with {
        return v => v,
        raise(_e, _k) => Option::None,
    }
}

fn push_dec(inout out: ChunkSeq[u8], v: u64) {
    if v >= 10 {
        push_dec(inout out, v / 10);
    }
    out.push(wrapping_u8(wrapping_add(48, v % 10)));
}

fn kind_name_of(kind_idx: u64) -> Str {
    if kind_idx == 0 {
        "u8"
    } else if kind_idx == 1 {
        "u16"
    } else if kind_idx == 2 {
        "u32"
    } else if kind_idx == 3 {
        "u64"
    } else if kind_idx == 4 {
        "usize"
    } else if kind_idx == 5 {
        "u128"
    } else if kind_idx == 6 {
        "i8"
    } else if kind_idx == 7 {
        "i16"
    } else if kind_idx == 8 {
        "i32"
    } else if kind_idx == 9 {
        "i64"
    } else if kind_idx == 10 {
        "isize"
    } else {
        "i128"
    }
}

fn kind_bits_of(kind_idx: u64) -> u64 {
    let k = kind_idx % 6;
    if k == 0 {
        8
    } else if k == 1 {
        16
    } else if k == 2 {
        32
    } else if k == 5 {
        128
    } else {
        64
    }
}

fn kind_is_signed(kind_idx: u64) -> bool {
    kind_idx >= 6
}

fn kind_unsigned_name(kind_idx: u64) -> Str {
    kind_name_of(kind_idx % 6)
}

fn kind_max_str(kind_idx: u64) -> Str {
    if kind_idx == 0 {
        "255"
    } else if kind_idx == 1 {
        "65535"
    } else if kind_idx == 2 {
        "4294967295"
    } else if kind_idx == 6 {
        "127"
    } else if kind_idx == 7 {
        "32767"
    } else if kind_idx == 8 {
        "2147483647"
    } else {
        "9223372036854775807"
    }
}

fn kind_min_str(kind_idx: u64) -> Str {
    if kind_idx == 6 {
        "-128"
    } else if kind_idx == 7 {
        "-32768"
    } else {
        "-2147483648"
    }
}

fn parse_kind_suffix(in s: Slice[u8], start: u64) -> u64 {
    for i in 0..12 {
        if eq_bytes(in s[start..s.len()], in kind_name_of(i).as_bytes()) {
            return i;
        }
    }
    99
}

fn match_intrinsic_token(in tok: Slice[u8]) -> u64 {
    if eq_bytes(in tok, in "mul_wide".as_bytes()) {
        return 108;
    }
    let (fam, plen) = if tok.len() > 14 && eq_bytes(in tok[0..14], in "leading_zeros_".as_bytes()) {
        (0, 14)
    } else if tok.len() > 15 && eq_bytes(in tok[0..15], in "trailing_zeros_".as_bytes()) {
        (1, 15)
    } else if tok.len() > 11 && eq_bytes(in tok[0..11], in "count_ones_".as_bytes()) {
        (2, 11)
    } else if tok.len() > 13 && eq_bytes(in tok[0..13], in "wrapping_neg_".as_bytes()) {
        (3, 13)
    } else if tok.len() > 13 && eq_bytes(in tok[0..13], in "wrapping_shl_".as_bytes()) {
        (4, 13)
    } else if tok.len() > 13 && eq_bytes(in tok[0..13], in "wrapping_shr_".as_bytes()) {
        (5, 13)
    } else if tok.len() > 12 && eq_bytes(in tok[0..12], in "checked_add_".as_bytes()) {
        (6, 12)
    } else if tok.len() > 12 && eq_bytes(in tok[0..12], in "checked_sub_".as_bytes()) {
        (7, 12)
    } else if tok.len() > 12 && eq_bytes(in tok[0..12], in "checked_mul_".as_bytes()) {
        (8, 12)
    } else {
        (99, 0)
    };
    if fam >= 9 {
        return 999;
    }
    let ki = parse_kind_suffix(in tok, plen);
    if ki >= 12 {
        return 999;
    }
    wrapping_add(wrapping_mul(fam, 12), ki)
}

fn next_code_byte(in src: Slice[u8], pos0: u64) -> (u64, u64) {
    let n = src.len();
    let b = byte_at(in src, pos0);
    if b == 47 && wrapping_add(pos0, 1) < n && byte_at(in src, wrapping_add(pos0, 1)) == 47 {
        let nl = find_byte(in src, pos0, n, 10);
        return (nl, 1);
    }
    if b == 34 {
        let mut p = wrapping_add(pos0, 1);
        loop {
            if p >= n {
                break;
            }
            let c = byte_at(in src, p);
            p = wrapping_add(p, 1);
            if c == 92 && p < n {
                p = wrapping_add(p, 1);
            } else if c == 34 {
                break;
            }
        }
        return (p, 1);
    }
    (pos0, 0)
}

fn push_swar(inout out: ChunkSeq[u8], in suf: Str) {
    out.extend(in "let v1".as_bytes());
    out.extend(in suf.as_bytes());
    out.extend(in " = wrapping_sub(v0".as_bytes());
    out.extend(in suf.as_bytes());
    out.extend(in ", (v0".as_bytes());
    out.extend(in suf.as_bytes());
    out.extend(in " >> 1) & 6148914691236517205); ".as_bytes());
    out.extend(in "let v2".as_bytes());
    out.extend(in suf.as_bytes());
    out.extend(in " = wrapping_add(v1".as_bytes());
    out.extend(in suf.as_bytes());
    out.extend(in " & 3689348814741910323, (v1".as_bytes());
    out.extend(in suf.as_bytes());
    out.extend(in " >> 2) & 3689348814741910323); ".as_bytes());
    out.extend(in "let v3".as_bytes());
    out.extend(in suf.as_bytes());
    out.extend(in " = wrapping_add(v2".as_bytes());
    out.extend(in suf.as_bytes());
    out.extend(in ", v2".as_bytes());
    out.extend(in suf.as_bytes());
    out.extend(in " >> 4) & 1085102592571150095; ".as_bytes());
    out.extend(in "let c".as_bytes());
    out.extend(in suf.as_bytes());
    out.extend(in ": u32 = wrapping_u32(wrapping_mul(v3".as_bytes());
    out.extend(in suf.as_bytes());
    out.extend(in ", 72340172838076673) >> 56); ".as_bytes());
}

fn push_popcount(inout out: ChunkSeq[u8], kind_idx: u64, in bits_expr: Str) {
    let wide = kind_bits_of(kind_idx) == 128;
    if wide {
        out.extend(in "let w: u128 = ".as_bytes());
        out.extend(in bits_expr.as_bytes());
        out.extend(in "; let v0lo: u64 = wrapping_u64(w); ".as_bytes());
        push_swar(inout out, in "lo");
        out.extend(in "let v0hi: u64 = wrapping_u64(w >> 64); ".as_bytes());
        push_swar(inout out, in "hi");
        out.extend(in "let c: u32 = wrapping_add(clo, chi); ".as_bytes());
    } else {
        out.extend(in "let v0: u64 = widen_u64(".as_bytes());
        out.extend(in bits_expr.as_bytes());
        out.extend(in "); ".as_bytes());
        push_swar(inout out, in "");
    }
}

fn push_pattern_let(inout out: ChunkSeq[u8], ki: u64) {
    let un = kind_unsigned_name(ki);
    out.extend(in "let pat: ".as_bytes());
    out.extend(in un.as_bytes());
    if kind_is_signed(ki) {
        out.extend(in " = wrapping_".as_bytes());
        out.extend(in un.as_bytes());
        out.extend(in "(x); ".as_bytes());
    } else {
        out.extend(in " = x; ".as_bytes());
    }
}

fn emit_bit_intrinsic(inout out: ChunkSeq[u8], fam: u64, ki: u64) {
    let k = kind_name_of(ki);
    let un = kind_unsigned_name(ki);
    let bits = kind_bits_of(ki);
    let signed = kind_is_signed(ki);
    out.extend(in "pub fn ".as_bytes());
    if fam == 0 {
        out.extend(in "leading_zeros_".as_bytes());
    } else if fam == 1 {
        out.extend(in "trailing_zeros_".as_bytes());
    } else if fam == 2 {
        out.extend(in "count_ones_".as_bytes());
    } else if fam == 3 {
        out.extend(in "wrapping_neg_".as_bytes());
    } else if fam == 4 {
        out.extend(in "wrapping_shl_".as_bytes());
    } else {
        out.extend(in "wrapping_shr_".as_bytes());
    }
    out.extend(in k.as_bytes());
    if fam == 4 || fam == 5 {
        out.extend(in "(x: ".as_bytes());
        out.extend(in k.as_bytes());
        out.extend(in ", n: u32) -> ".as_bytes());
        out.extend(in k.as_bytes());
    } else if fam == 3 {
        out.extend(in "(x: ".as_bytes());
        out.extend(in k.as_bytes());
        out.extend(in ") -> ".as_bytes());
        out.extend(in k.as_bytes());
    } else {
        out.extend(in "(x: ".as_bytes());
        out.extend(in k.as_bytes());
        out.extend(in ") -> u32".as_bytes());
    }
    out.extend(in " { ".as_bytes());
    if fam == 0 {
        push_pattern_let(inout out, ki);
        out.extend(in "let mut lp: ".as_bytes());
        out.extend(in un.as_bytes());
        out.extend(in " = pat; ".as_bytes());
        let mut s: u64 = 1;
        loop {
            if s >= bits {
                break;
            }
            out.extend(in "lp = lp | (lp >> ".as_bytes());
            push_dec(inout out, s);
            out.extend(in "); ".as_bytes());
            s = wrapping_mul(s, 2);
        }
        push_popcount(inout out, ki, in "lp");
        out.extend(in "let width: u32 = ".as_bytes());
        push_dec(inout out, bits);
        out.extend(in "; wrapping_sub(width, c)".as_bytes());
    } else if fam == 1 {
        push_pattern_let(inout out, ki);
        push_popcount(inout out, ki, in "~pat & wrapping_sub(pat, 1)");
        out.extend(in "c".as_bytes());
    } else if fam == 2 {
        push_pattern_let(inout out, ki);
        push_popcount(inout out, ki, in "pat");
        out.extend(in "c".as_bytes());
    } else if fam == 3 {
        out.extend(in "let zero: ".as_bytes());
        out.extend(in k.as_bytes());
        out.extend(in " = 0; wrapping_sub(zero, x)".as_bytes());
    } else if fam == 4 {
        out.extend(in "let one: ".as_bytes());
        out.extend(in k.as_bytes());
        out.extend(in " = 1; wrapping_mul(x, rotate_left(one, n))".as_bytes());
    } else {
        out.extend(in "let s: u32 = n & ".as_bytes());
        push_dec(inout out, wrapping_sub(bits, 1));
        out.extend(in "; if s == 0 { x } else { ".as_bytes());
        push_pattern_let(inout out, ki);
        out.extend(in "let one: ".as_bytes());
        out.extend(in un.as_bytes());
        out.extend(in " = 1; let keep: ".as_bytes());
        out.extend(in un.as_bytes());
        out.extend(in " = wrapping_sub(rotate_right(one, s), one); let r: ".as_bytes());
        out.extend(in un.as_bytes());
        out.extend(in " = rotate_right(pat, s) & keep; ".as_bytes());
        if signed {
            out.extend(in "let zero: ".as_bytes());
            out.extend(in k.as_bytes());
            out.extend(in " = 0; if x < zero { wrapping_".as_bytes());
            out.extend(in k.as_bytes());
            out.extend(in "(r | ~keep) } else { wrapping_".as_bytes());
            out.extend(in k.as_bytes());
            out.extend(in "(r) }".as_bytes());
        } else {
            out.extend(in "r".as_bytes());
        }
        out.extend(in " }".as_bytes());
    }
    out.extend(in " } ".as_bytes());
}

fn emit_checked_intrinsic(inout out: ChunkSeq[u8], fam: u64, ki: u64) {
    let k = kind_name_of(ki);
    let bits = kind_bits_of(ki);
    let signed = kind_is_signed(ki);
    out.extend(in "pub fn ".as_bytes());
    if fam == 6 {
        out.extend(in "checked_add_".as_bytes());
    } else if fam == 7 {
        out.extend(in "checked_sub_".as_bytes());
    } else {
        out.extend(in "checked_mul_".as_bytes());
    }
    out.extend(in k.as_bytes());
    out.extend(in "(a: ".as_bytes());
    out.extend(in k.as_bytes());
    out.extend(in ", b: ".as_bytes());
    out.extend(in k.as_bytes());
    out.extend(in ") -> Option[".as_bytes());
    out.extend(in k.as_bytes());
    out.extend(in "] { ".as_bytes());
    if fam == 6 && !signed {
        out.extend(in "let s: ".as_bytes());
        out.extend(in k.as_bytes());
        out.extend(
            in " = wrapping_add(a, b); if s < a { Option::None } else { Option::Some(s) }"
                .as_bytes()
        );
    } else if fam == 7 && !signed {
        out.extend(
            in "if b > a { Option::None } else { Option::Some(wrapping_sub(a, b)) }".as_bytes()
        );
    } else if (fam == 6 || fam == 7) && signed {
        out.extend(in "let zero: ".as_bytes());
        out.extend(in k.as_bytes());
        out.extend(in " = 0; let s: ".as_bytes());
        out.extend(in k.as_bytes());
        if fam == 6 {
            out.extend(
                in " = wrapping_add(a, b); if (a < zero) == (b < zero) && (s < zero) != (a < zero) { Option::None } else { Option::Some(s) }"
                    .as_bytes()
            );
        } else {
            out.extend(
                in " = wrapping_sub(a, b); if (a < zero) != (b < zero) && (s < zero) != (a < zero) { Option::None } else { Option::Some(s) }"
                    .as_bytes()
            );
        }
    } else if !signed && bits <= 32 {
        out.extend(in "let p: u64 = wrapping_mul(widen_u64(a), widen_u64(b)); if p > ".as_bytes());
        out.extend(in kind_max_str(ki).as_bytes());
        out.extend(in " { Option::None } else { Option::Some(wrapping_".as_bytes());
        out.extend(in k.as_bytes());
        out.extend(in "(p)) }".as_bytes());
    } else if signed && bits <= 32 {
        out.extend(in "let p: i64 = wrapping_mul(widen_i64(a), widen_i64(b)); if p < ".as_bytes());
        out.extend(in kind_min_str(ki).as_bytes());
        out.extend(in " || p > ".as_bytes());
        out.extend(in kind_max_str(ki).as_bytes());
        out.extend(in " { Option::None } else { Option::Some(wrapping_".as_bytes());
        out.extend(in k.as_bytes());
        out.extend(in "(p)) }".as_bytes());
    } else if !signed && bits == 128 {
        out.extend(in "let zero: ".as_bytes());
        out.extend(in k.as_bytes());
        out.extend(in " = 0; if a == zero { Option::Some(zero) } else { let p: ".as_bytes());
        out.extend(in k.as_bytes());
        out.extend(
            in " = wrapping_mul(a, b); if p / a != b { Option::None } else { Option::Some(p) } }"
                .as_bytes()
        );
    } else if signed && bits == 128 {
        out.extend(
            in "let zero: i128 = 0; let uzero: u128 = 0; let ua: u128 = if a < zero { wrapping_u128(wrapping_sub(zero, a)) } else { wrapping_u128(a) }; let ub: u128 = if b < zero { wrapping_u128(wrapping_sub(zero, b)) } else { wrapping_u128(b) }; if ua == uzero { Option::Some(zero) } else { let p: u128 = wrapping_mul(ua, ub); let one: u128 = 1; let limit: u128 = rotate_right(one, 1); if p / ua != ub { Option::None } else if (a < zero) != (b < zero) { if p > limit { Option::None } else { Option::Some(wrapping_i128(wrapping_sub(uzero, p))) } } else if p >= limit { Option::None } else { Option::Some(wrapping_i128(p)) } }"
                .as_bytes()
        );
    } else if !signed {
        out.extend(
            in "let (lo, hi) = mul_wide(wrapping_u64(a), wrapping_u64(b)); if hi != 0 { Option::None } else { Option::Some(wrapping_"
                .as_bytes()
        );
        out.extend(in k.as_bytes());
        out.extend(in "(lo)) }".as_bytes());
    } else {
        out.extend(in "let zero: ".as_bytes());
        out.extend(in k.as_bytes());
        out.extend(
            in " = 0; let ua: u64 = if a < zero { wrapping_u64(wrapping_sub(zero, a)) } else { wrapping_u64(a) }; let ub: u64 = if b < zero { wrapping_u64(wrapping_sub(zero, b)) } else { wrapping_u64(b) }; let (lo, hi) = mul_wide(ua, ub); let limit: u64 = 9223372036854775807; if hi != 0 { Option::None } else if (a < zero) != (b < zero) { if lo > wrapping_add(limit, 1) { Option::None } else { Option::Some(wrapping_"
                .as_bytes()
        );
        out.extend(in k.as_bytes());
        out.extend(
            in "(wrapping_sub(0, lo))) } } else if lo > limit { Option::None } else { Option::Some(wrapping_"
                .as_bytes()
        );
        out.extend(in k.as_bytes());
        out.extend(in "(lo)) }".as_bytes());
    }
    out.extend(in " } ".as_bytes());
}

fn scan_mod_intrinsics(in src: Slice[u8], inout need: ChunkSeq[bool], inout skip: ChunkSeq[bool]) {
    let n = src.len();
    let mut pos: u64 = 0;
    let mut prev_was_fn = false;
    loop {
        if pos >= n {
            break;
        }
        let (next_p, skipped) = next_code_byte(in src, pos);
        if skipped != 0 {
            pos = next_p;
            continue;
        }
        let b = byte_at(in src, pos);
        if is_ident_byte(b) {
            let start = pos;
            loop {
                if pos >= n || !is_ident_byte(byte_at(in src, pos)) {
                    break;
                }
                pos = wrapping_add(pos, 1);
            }
            let slot = match_intrinsic_token(in src[start..pos]);
            if slot < 109 {
                if prev_was_fn {
                    let _ = skip.try_set(slot, true);
                } else {
                    let _ = need.try_set(slot, true);
                }
            }
            prev_was_fn = eq_bytes(in src[start..pos], in "fn".as_bytes());
            continue;
        }
        if b != 32 && b != 9 && b != 10 && b != 13 {
            prev_was_fn = false;
        }
        pos = wrapping_add(pos, 1);
    }
}

fn append_extra_intrinsics(in mods: ChunkSeq[ModEntry], inout out: ChunkSeq[u8]) {
    let mut need = ChunkSeq::new[bool]();
    let mut skip = ChunkSeq::new[bool]();
    for _i in 0..109 {
        need.push(false);
        skip.push(false);
    }
    // Pre-mark the 11 functions of preludes/intrinsics.ves (always in `$string_prelude.ves`).
    // fam 6 (checked_add): u64=3 (75), u128=5 (77); fam 7 (checked_sub): u64=3 (87)
    // fam 8 (checked_mul): u64=3 (99), u128=5 (101)
    // fam 3 (wrapping_neg): i64=9 (45)
    // fam 4 (wrapping_shl): u32=2 (50), u64=3 (51)
    // fam 5 (wrapping_shr): u32=2 (62), u64=3 (63)
    // fam 1 (trailing_zeros): u64=3 (15)
    let _ = skip.try_set(15, true);
    let _ = skip.try_set(45, true);
    let _ = skip.try_set(50, true);
    let _ = skip.try_set(51, true);
    let _ = skip.try_set(62, true);
    let _ = skip.try_set(63, true);
    let _ = skip.try_set(75, true);
    let _ = skip.try_set(77, true);
    let _ = skip.try_set(87, true);
    let _ = skip.try_set(99, true);
    let _ = skip.try_set(101, true);

    for mi in 0..mods.len() {
        match mods.try_get(mi) {
            Option::Some(m) => scan_mod_intrinsics(in m.text.as_slice(), inout need, inout skip),
            Option::None => {},
        }
    }
    // 64-bit `checked_mul_k` (usize=100, i64=105, isize=106) calls `mul_wide`.
    let need_mul_usize = match need.try_get(100) {
        Option::Some(v) => v,
        Option::None => false,
    };
    let need_mul_i64 = match need.try_get(105) {
        Option::Some(v) => v,
        Option::None => false,
    };
    let need_mul_isize = match need.try_get(106) {
        Option::Some(v) => v,
        Option::None => false,
    };
    if need_mul_usize || need_mul_i64 || need_mul_isize {
        let _ = need.try_set(108, true);
    }
    let need_mw = match need.try_get(108) {
        Option::Some(v) => v,
        Option::None => false,
    };
    let skip_mw = match skip.try_get(108) {
        Option::Some(v) => v,
        Option::None => false,
    };
    if need_mw && !skip_mw {
        out.extend(
            in "pub fn mul_wide(a: u64, b: u64) -> (u64, u64) { let m: u64 = 4294967295; let a0 = a & m; let a1 = a >> 32; let b0 = b & m; let b1 = b >> 32; let p00 = wrapping_mul(a0, b0); let p01 = wrapping_mul(a0, b1); let p10 = wrapping_mul(a1, b0); let p11 = wrapping_mul(a1, b1); let mid = wrapping_add(wrapping_add(p00 >> 32, p01 & m), p10 & m); let hi = wrapping_add(wrapping_add(wrapping_add(p11, p01 >> 32), p10 >> 32), mid >> 32); (wrapping_mul(a, b), hi) } "
                .as_bytes()
        );
    }
    for slot in 0..108 {
        let want = match need.try_get(slot) {
            Option::Some(v) => v,
            Option::None => false,
        };
        let already = match skip.try_get(slot) {
            Option::Some(v) => v,
            Option::None => false,
        };
        if want && !already {
            let fam = slot / 12;
            let ki = slot % 12;
            if fam < 6 {
                emit_bit_intrinsic(inout out, fam, ki);
            } else {
                emit_checked_intrinsic(inout out, fam, ki);
            }
        }
    }
}

// Which of the option prelude's methods `tok` names: 0 `is_some`, 1
// `is_none`, 2 `unwrap_or`, 3 `or`, or 4 for none of them.
fn option_method_slot(in tok: Slice[u8]) -> u64 {
    if eq_bytes(in tok, in "is_some".as_bytes()) {
        return 0;
    }
    if eq_bytes(in tok, in "is_none".as_bytes()) {
        return 1;
    }
    if eq_bytes(in tok, in "unwrap_or".as_bytes()) {
        return 2;
    }
    if eq_bytes(in tok, in "or".as_bytes()) {
        return 3;
    }
    4
}

// Where `/*` at `pos` ends, past the `*/` that closes it (or at the end
// of `src`). Block comments nest, as in the lexer.
fn block_comment_end(in src: Slice[u8], pos: u64) -> u64 {
    let n = src.len();
    let mut depth: u64 = 1;
    let mut p = wrapping_add(pos, 2);
    loop {
        if wrapping_add(p, 1) >= n {
            return n;
        }
        let c = byte_at(in src, p);
        let d = byte_at(in src, wrapping_add(p, 1));
        if c == 47 && d == 42 {
            depth = wrapping_add(depth, 1);
            p = wrapping_add(p, 2);
        } else if c == 42 && d == 47 {
            depth = wrapping_sub(depth, 1);
            p = wrapping_add(p, 2);
            if depth == 0 {
                return p;
            }
        } else {
            p = wrapping_add(p, 1);
        }
    }
}

// Scans the code of `src`, not its comments or string literals, for the
// option prelude's methods: `used[k]` when a `.` and the method's name
// follow each other, `defined[k]` when `src` has an `impl` block for
// `Option` that defines it.
fn scan_option_methods(
    in src: Slice[u8],
    inout used: ChunkSeq[bool],
    inout defined: ChunkSeq[bool]
) {
    let n = src.len();
    let mut pos: u64 = 0;
    let mut after_dot = false;
    let mut after_fn = false;
    // 0: no `impl` header; 1: in one, before its type; 2: its type is
    // `Option`; 3: its type is another.
    let mut header: u64 = 0;
    let mut brackets: u64 = 0;
    let mut depth: u64 = 0;
    // The brace depth of the `Option` impl body being scanned, or 0.
    let mut option_body: u64 = 0;
    loop {
        if pos >= n {
            break;
        }
        let (next_p, skipped) = next_code_byte(in src, pos);
        if skipped != 0 {
            // A string literal ends a `.` or `fn` run; a line comment is
            // trivia between tokens, like whitespace.
            if byte_at(in src, pos) == 34 {
                after_dot = false;
                after_fn = false;
            }
            pos = next_p;
            continue;
        }
        let b = byte_at(in src, pos);
        if b == 47 && wrapping_add(pos, 1) < n && byte_at(in src, wrapping_add(pos, 1)) == 42 {
            pos = block_comment_end(in src, pos);
            continue;
        }
        if is_ident_byte(b) {
            let start = pos;
            loop {
                if pos >= n || !is_ident_byte(byte_at(in src, pos)) {
                    break;
                }
                pos = wrapping_add(pos, 1);
            }
            let tok = src[start..pos];
            let slot = option_method_slot(in tok);
            if slot < 4 && after_dot {
                let _ = used.try_set(slot, true);
            }
            if slot < 4 && after_fn && option_body != 0 && depth == option_body {
                let _ = defined.try_set(slot, true);
            }
            if eq_bytes(in tok, in "impl".as_bytes()) {
                header = 1;
                brackets = 0;
            } else if header == 1 && brackets == 0 {
                header = if eq_bytes(in tok, in "Option".as_bytes()) {
                    2
                } else {
                    3
                };
            }
            after_fn = eq_bytes(in tok, in "fn".as_bytes());
            after_dot = false;
            continue;
        }
        pos = wrapping_add(pos, 1);
        if b == 32 || b == 9 || b == 10 || b == 13 {
            continue;
        }
        after_dot = b == 46;
        after_fn = false;
        if b == 91 {
            brackets = wrapping_add(brackets, 1);
        } else if b == 93 && brackets > 0 {
            brackets = wrapping_sub(brackets, 1);
        } else if b == 123 {
            depth = wrapping_add(depth, 1);
            if header == 2 {
                option_body = depth;
            }
            header = 0;
        } else if b == 125 && depth > 0 {
            if depth == option_body {
                option_body = 0;
            }
            depth = wrapping_sub(depth, 1);
        } else if b == 59 {
            header = 0;
        }
    }
}

// The Rust checker's option prelude (src/option_methods.rs): an
// `impl Option[T]` block with the methods no module defines itself, added
// when a module calls one of those.
// `preludes/str_chars.ves` (`Str::next_char`), when a module calls
// `next_char` and none defines it: the part of the string prelude the
// Rust loader adds for it (`strings::needs_prelude`).
fn append_str_chars(in mods: ChunkSeq[ModEntry], inout out: ChunkSeq[u8]) {
    let mut used = false;
    for mi in 0..mods.len() {
        match mods.try_get(mi) {
            Option::Some(m) => {
                if contains_word(in m.text.as_slice(), "fn next_char") {
                    return;
                }
                used = used || contains_word(in m.text.as_slice(), "next_char");
            },
            Option::None => {},
        }
    }
    if used {
        out.extend(in include_str("preludes/str_chars.ves").as_bytes());
    }
}

fn append_option_methods(in mods: ChunkSeq[ModEntry], inout out: ChunkSeq[u8]) {
    let mut used = ChunkSeq::new[bool]();
    let mut defined = ChunkSeq::new[bool]();
    for _k in 0..4 {
        used.push(false);
        defined.push(false);
    }
    for mi in 0..mods.len() {
        match mods.try_get(mi) {
            Option::Some(m) => scan_option_methods(in m.text.as_slice(), inout used, inout defined),
            Option::None => {},
        }
    }
    let mut wanted = false;
    for k in 0..4 {
        let u = match used.try_get(k) {
            Option::Some(v) => v,
            Option::None => false,
        };
        let d = match defined.try_get(k) {
            Option::Some(v) => v,
            Option::None => false,
        };
        wanted = wanted || (u && !d);
    }
    if !wanted {
        return;
    }
    out.extend(in "impl [T: mod copy] Option[T] { ".as_bytes());
    for k in 0..4 {
        let d = match defined.try_get(k) {
            Option::Some(v) => v,
            Option::None => true,
        };
        if d {
            continue;
        }
        if k == 0 {
            out.extend(
                in "fn is_some(self) -> bool { match self { Option::Some(_) => true, Option::None => false } } "
                    .as_bytes()
            );
        } else if k == 1 {
            out.extend(
                in "fn is_none(self) -> bool { match self { Option::Some(_) => false, Option::None => true } } "
                    .as_bytes()
            );
        } else if k == 2 {
            out.extend(
                in "fn unwrap_or(self, fallback: T) -> T { match self { Option::Some(x) => x, Option::None => fallback } } "
                    .as_bytes()
            );
        } else {
            out.extend(
                in "fn or(self, other: Option[T]) -> Option[T] { match self { Option::Some(x) => Option::Some(x), Option::None => other } } "
                    .as_bytes()
            );
        }
    }
    out.extend(in "} ".as_bytes());
}

fn scan_dir_mods(
    pkg_idx: u64,
    in pkg_dir: Slice[u8],
    in dir: Slice[u8],
    in segs: ChunkSeq[ChunkSeq[u8]],
    inout base_off: u64,
    inout files: ChunkSeq[FileEntry],
    inout mods: ChunkSeq[ModEntry]
) eff [Ffi[StdFs]] {
    let entries = match try_list_dir(in dir) {
        Option::Some(e) => e,
        Option::None => return,
    };
    let n = entry_count(in entries);
    for i in 0..n {
        let nm = match entry_path(in entries, i) {
            Option::Some(s) => s,
            Option::None => continue,
        };
        let nb = nm.as_bytes();
        let k = entry_kind(in entries, i);
        let is_file_candidate = (k == kind_file() || k == kind_symlink())
            && ends_with_ves(in nb)
            && !slice_eq_lit(in nb, in "lib.ves")
            && !slice_eq_lit(in nb, in "main.ves")
            && !slice_eq_lit(in nb, in "mod.ves");
        let mut is_dir = k == kind_dir();
        if is_file_candidate {
            let p1 = entry_join(in dir, in entries, i);
            let mut next_segs = ChunkSeq::new[ChunkSeq[u8]]();
            for j in 0..segs.len() {
                match segs.try_get(j) {
                    Option::Some(s) => {
                        let mut sc = ChunkSeq::new[u8]();
                        sc.extend(in s.as_slice());
                        next_segs.push(sink sc);
                    },
                    Option::None => {},
                }
            }
            let mut sn = ChunkSeq::new[u8]();
            sn.extend(in nb[0..wrapping_sub(nb.len(), 4)]);
            next_segs.push(sink sn);
            if !has_file(in files, in p1.as_slice()) && !has_mod(in mods, pkg_idx, in next_segs) {
                match try_read_file(in p1.as_slice()) {
                    Option::Some(sub_text) => {
                        collect_mod_files(
                            pkg_idx,
                            in pkg_dir,
                            in dir,
                            in next_segs,
                            in p1.as_slice(),
                            sink sub_text,
                            inout base_off,
                            inout files,
                            inout mods
                        );
                    },
                    Option::None => {
                        if k == kind_symlink() {
                            is_dir = true;
                        }
                    },
                }
            }
        } else if k == kind_symlink() && !ends_with_ves(in nb) {
            is_dir = true;
        }
        if is_dir {
            let sub_dir = entry_join(in dir, in entries, i);
            let mut next_segs = ChunkSeq::new[ChunkSeq[u8]]();
            for j in 0..segs.len() {
                match segs.try_get(j) {
                    Option::Some(s) => {
                        let mut sc = ChunkSeq::new[u8]();
                        sc.extend(in s.as_slice());
                        next_segs.push(sink sc);
                    },
                    Option::None => {},
                }
            }
            let mut sn = ChunkSeq::new[u8]();
            sn.extend(in nb);
            next_segs.push(sink sn);
            let p2 = join_path(in sub_dir.as_slice(), in "mod.ves".as_bytes());
            if !has_file(in files, in p2.as_slice()) && !has_mod(in mods, pkg_idx, in next_segs) {
                match try_read_file(in p2.as_slice()) {
                    Option::Some(sub_text) => {
                        collect_mod_files(
                            pkg_idx,
                            in pkg_dir,
                            in sub_dir.as_slice(),
                            in next_segs,
                            in p2.as_slice(),
                            sink sub_text,
                            inout base_off,
                            inout files,
                            inout mods
                        );
                    },
                    Option::None => {},
                }
            }
            scan_dir_mods(
                pkg_idx,
                in pkg_dir,
                in sub_dir.as_slice(),
                in next_segs,
                inout base_off,
                inout files,
                inout mods
            );
        }
    }
}

// The `.vsys` files the manifests of the package graph at `root_dir` name
// (Rust `Assembled::vsys`), in load order, joined to their package
// directories with `@TARGET@`, `@OS@` and `@ARCH@` kept; None when the graph
// does not load.
pub fn package_graph_vsys_paths(
    in root_dir: Slice[u8]
) -> Option[ChunkSeq[ChunkSeq[u8]]] eff [Ffi[StdFs]] {
    let mut pkgs = ChunkSeq::new[PkgNode]();
    match load_pkg_graph(in root_dir, inout pkgs) {
        Option::Some(_) => {},
        Option::None => {
            return Option::None;
        },
    }
    let mut out = ChunkSeq::new[ChunkSeq[u8]]();
    for pi in 0..pkgs.len() {
        match pkgs.try_get(pi) {
            Option::Some(p) => {
                for vi in 0..p.vsys_paths.len() {
                    match p.vsys_paths.try_get(vi) {
                        Option::Some(v) => {
                            let mut copy = ChunkSeq::new[u8]();
                            copy.extend(in v.as_slice());
                            out.push(sink copy);
                        },
                        Option::None => {},
                    }
                }
            },
            Option::None => {},
        }
    }
    Option::Some(out)
}

pub fn load_package_graph_bytes(in root_dir: Slice[u8]) -> Option[ChunkSeq[u8]] eff [Ffi[StdFs]] {
    let mut pkgs = ChunkSeq::new[PkgNode]();
    match load_pkg_graph(in root_dir, inout pkgs) {
        Option::Some(_) => {},
        Option::None => {
            return Option::None;
        },
    }
    let mut files = ChunkSeq::new[FileEntry]();
    let mut mods = ChunkSeq::new[ModEntry]();
    let mut base_off: u64 = 0;
    for pi in 0..pkgs.len() {
        let dir = match pkgs.try_get(pi) {
            Option::Some(p) => {
                let mut d = ChunkSeq::new[u8]();
                d.extend(in p.dir.as_slice());
                d
            },
            Option::None => ChunkSeq::new[u8](),
        };
        let src_dir = pkg_src_dir(in dir.as_slice());
        let lib_p = join_path(in src_dir.as_slice(), in "lib.ves".as_bytes());
        let main_p = join_path(in src_dir.as_slice(), in "main.ves".as_bytes());
        let root_segs = ChunkSeq::new[ChunkSeq[u8]]();
        match try_read_file(in lib_p.as_slice()) {
            Option::Some(t) => {
                collect_mod_files(
                    pi,
                    in dir.as_slice(),
                    in src_dir.as_slice(),
                    in root_segs,
                    in lib_p.as_slice(),
                    sink t,
                    inout base_off,
                    inout files,
                    inout mods
                );
            },
            Option::None => {
                match try_read_file(in main_p.as_slice()) {
                    Option::Some(t) => {
                        collect_mod_files(
                            pi,
                            in dir.as_slice(),
                            in src_dir.as_slice(),
                            in root_segs,
                            in main_p.as_slice(),
                            sink t,
                            inout base_off,
                            inout files,
                            inout mods
                        );
                    },
                    Option::None => {},
                }
            },
        }
        scan_dir_mods(
            pi,
            in dir.as_slice(),
            in src_dir.as_slice(),
            in root_segs,
            inout base_off,
            inout files,
            inout mods
        );
    }
    let mut scan_idx: u64 = 0;
    loop {
        if scan_idx >= mods.len() {
            break;
        }
        let mtext = match mods.try_get(scan_idx) {
            Option::Some(m) => {
                let mut c = ChunkSeq::new[u8]();
                c.extend(in m.text.as_slice());
                c
            },
            Option::None => ChunkSeq::new[u8](),
        };
        scan_pkg_submods(in mtext.as_slice(), in pkgs, inout base_off, inout files, inout mods);
        scan_idx = wrapping_add(scan_idx, 1);
    }
    let mut sp_segs = ChunkSeq::new[ChunkSeq[u8]]();
    let mut sp_seg = ChunkSeq::new[u8]();
    sp_seg.extend(in "intrinsics".as_bytes());
    sp_segs.push(sink sp_seg);
    let mut sp_src = ChunkSeq::new[u8]();
    sp_src.extend(in include_str("preludes/string.ves").as_bytes());
    sp_src.extend(in include_str("preludes/intrinsics.ves").as_bytes());
    append_option_methods(in mods, inout sp_src);
    append_str_chars(in mods, inout sp_src);
    append_extra_intrinsics(in mods, inout sp_src);
    collect_mod_files(
        0,
        in "".as_bytes(),
        in "".as_bytes(),
        in sp_segs,
        in "$string_prelude.ves".as_bytes(),
        sink sp_src,
        inout base_off,
        inout files,
        inout mods
    );
    prepare_sugar_graph(in pkgs, inout files, inout mods)
}

copy struct BootstrapDeclarationRange {
    module_index: u64,
    start: u64,
    end: u64,
}

const BOOTSTRAP_SOURCE_MAP_WORDS: u64 = 5;

copy struct BootstrapSourceSegment {
    file: u64,
    generated_start: u64,
    generated_end: u64,
    source_start: u64,
    source_end: u64,
    copied: u64,
}

fn copy_bootstrap_mappings(
    file: u64,
    in mappings: ChunkSeq[u64],
    inout output: ChunkSeq[BootstrapSourceSegment]
) {
    for segment in 0..(mappings.len() / BOOTSTRAP_SOURCE_MAP_WORDS) {
        let row = wrapping_mul(segment, BOOTSTRAP_SOURCE_MAP_WORDS);
        output.push(BootstrapSourceSegment {
            file: file,
            generated_start: mappings.try_get(row).unwrap_or(0),
            generated_end: mappings.try_get(wrapping_add(row, 1)).unwrap_or(0),
            source_start: mappings.try_get(wrapping_add(row, 2)).unwrap_or(0),
            source_end: mappings.try_get(wrapping_add(row, 3)).unwrap_or(0),
            copied: mappings.try_get(wrapping_add(row, 4)).unwrap_or(0)
        });
    }
}

fn has_bootstrap_sugar_candidate(in source: ChunkSeq[u8]) -> bool {
    if !contains_word(in source.as_slice(), in "sugar") {
        return false;
    }
    let scratch = stage2_heap_mark();
    let possible = may_declare_sugar(in source);
    if scratch != 0 {
        stage2_heap_reset(scratch);
    }
    possible
}

// Headroom for package paths, file rows and source mappings beyond the
// module text. An encoded graph exceeding the reserve keeps its scratch.
const SUGAR_GRAPH_RESERVE_SLACK_BYTES: u64 = 16777216;

fn prepare_sugar_graph(
    in pkgs: ChunkSeq[PkgNode],
    inout files: ChunkSeq[FileEntry],
    inout mods: ChunkSeq[ModEntry]
) -> Option[ChunkSeq[u8]] {
    let mut possible_sugar = false;
    let mut source_bytes: u64 = 0;
    for module in 0..mods.len() {
        match mods.try_get(module) {
            Option::Some(source) => {
                source_bytes = wrapping_add(source_bytes, source.text.len());
                if !possible_sugar {
                    possible_sugar = has_bootstrap_sugar_candidate(in source.text);
                }
            },
            Option::None => {},
        }
    }
    if !possible_sugar || stage2_heap_mark() == 0 {
        return prepare_sugar_graph_in_scratch(in pkgs, inout files, inout mods, possible_sugar);
    }
    // The self-built compiler cannot free its temporary surface trees
    // and import tables individually. Reserve the result before the
    // pass, then keep only the encoded graph.
    let reserve = wrapping_add(wrapping_mul(source_bytes, 2), SUGAR_GRAPH_RESERVE_SLACK_BYTES);
    let mut kept = ChunkSeq::new[u8]();
    kept.reserve(reserve);
    let scratch_start = stage2_heap_mark();
    let encoded = match prepare_sugar_graph_in_scratch(in pkgs, inout files, inout mods, true) {
        Option::Some(encoded) => encoded,
        Option::None => {
            stage2_heap_reset(scratch_start);
            return Option::None;
        },
    };
    if encoded.len() > reserve {
        return Option::Some(encoded);
    }
    kept.extend(in encoded.as_slice());
    // The caller only returns the graph, not the scratch-backed modules.
    stage2_heap_reset(scratch_start);
    Option::Some(kept)
}

fn prepare_sugar_graph_in_scratch(
    in pkgs: ChunkSeq[PkgNode],
    inout files: ChunkSeq[FileEntry],
    inout mods: ChunkSeq[ModEntry],
    possible_sugar: bool
) -> Option[ChunkSeq[u8]] {
    let mut catalogue = ChunkSeq::new[PackageSugarDefinition]();
    let mut public = ChunkSeq::new[bool]();
    let mut imports = ChunkSeq::new[ChunkSeq[u8]]();
    let mut surface_modules = ChunkSeq::new[bool]();
    let mut shadowed_modules = ChunkSeq::new[bool]();
    let mut declaration_spans = ChunkSeq::new[BootstrapDeclarationRange]();
    let mut source_segments = ChunkSeq::new[BootstrapSourceSegment]();
    if possible_sugar {
        for module in 0..mods.len() {
            let mut import_text = ChunkSeq::new[u8]();
            let mut has_surface_sugar = false;
            let mut shadows_prelude = false;
            match mods.try_get(module) {
                Option::Some(source) => {
                    if contains_word(in source.text.as_slice(), in "sugar")
                        || contains_word(in source.text.as_slice(), in "use")
                        || contains_word(in source.text.as_slice(), in "Option")
                    {
                        match inspect_module_sugars(in source.text, false) {
                            Option::Some(surface) => {
                                has_surface_sugar = surface.has_sugar;
                                shadows_prelude = surface.shadows_bootstrap_prelude;
                                for i in 0..surface.declarations.len() {
                                    match surface.declarations.try_get(i) {
                                        Option::Some(row) => {
                                            let mut name = ChunkSeq::new[u8]();
                                            name.extend(
                                                in source.text[row.name_start..row.name_end]
                                            );
                                            let mut declaration = ChunkSeq::new[u8]();
                                            declaration.extend(
                                                in source
                                                    .text[
                                                        row.declaration_start..row.declaration_end
                                                    ]
                                            );
                                            public.push(row.public);
                                            declaration_spans.push(BootstrapDeclarationRange {
                                                module_index: module,
                                                start: row.declaration_start,
                                                end: row.declaration_end
                                            });
                                            catalogue.push(
                                                sink PackageSugarDefinition {
                                                    module_index: module,
                                                    name: name,
                                                    declaration: declaration
                                                }
                                            );
                                        },
                                        Option::None => {},
                                    }
                                }
                                for i in 0..surface.imports.len() {
                                    match surface.imports.try_get(i) {
                                        Option::Some(row) => {
                                            import_text.extend(in source.text[row.start..row.end]);
                                            import_text.push(10);
                                        },
                                        Option::None => {},
                                    }
                                }
                            },
                            Option::None => {},
                        }
                    }
                },
                Option::None => {},
            }
            imports.push(sink import_text);
            surface_modules.push(has_surface_sugar);
            shadowed_modules.push(shadows_prelude);
        }
        if catalogue.len() != 0 {
            let index = encode_package_graph(
                in pkgs,
                in files,
                in mods,
                true,
                in imports,
                in catalogue,
                in public,
                in source_segments
            );
            let resolved = resolve_sugar_imports_bytes(in index.as_slice());
            let mut bindings = ChunkSeq::new[PackageSugarBinding]();
            let empty = ChunkSeq::new[bool]();
            let mut imported = empty;
            for _module in 0..mods.len() {
                imported.push(false);
            }
            for i in 0..resolved.len() {
                match resolved.try_get(i) {
                    Option::Some(edge) => {
                        let author = widen_u64(edge.definition_module);
                        let caller = widen_u64(edge.caller_module);
                        if shadowed_modules.try_get(caller) == Option::Some(true)
                            || shadowed_modules.try_get(author) == Option::Some(true)
                        {
                            return Option::None;
                        }
                        let mut definition_index = catalogue.len();
                        // The last row of a repeated definition is the
                        // ordinary resolver's choice; expansion rejects
                        // duplicate rules in the defining module itself.
                        for j in 0..catalogue.len() {
                            match catalogue.try_get(j) {
                                Option::Some(definition) => {
                                    if definition.module_index == author
                                        && eq_bytes(
                                            in definition.name.as_slice(),
                                            in edge.definition_name.as_bytes()
                                        )
                                    {
                                        definition_index = j;
                                    }
                                },
                                Option::None => {},
                            }
                        }
                        if definition_index < catalogue.len() {
                            let mut alias = ChunkSeq::new[u8]();
                            alias.extend(in edge.local_name.as_bytes());
                            bindings.push(
                                sink PackageSugarBinding {
                                    module_index: caller,
                                    alias: alias,
                                    definition: definition_index
                                }
                            );
                            imported.try_set(caller, true);
                        }
                    },
                    Option::None => {},
                }
            }
            for module in 0..mods.len() {
                if surface_modules.try_get(module) == Option::Some(true)
                    && imported.try_get(module) == Option::Some(true)
                {
                    let plan = match plan_bootstrap_sugars(
                        module,
                        mods.len(),
                        in catalogue,
                        in bindings
                    ) {
                        Option::Some(plan) => plan,
                        Option::None => return Option::None,
                    };
                    match mods.try_get_mut(module) {
                        Option::Some(source) => {
                            match expand_bootstrap_module(in source.text, in plan) {
                                Result::Ok(expanded) => {
                                    copy_bootstrap_mappings(
                                        source.file,
                                        in expanded.mappings,
                                        inout source_segments
                                    );
                                    source.text = expanded.source;
                                },
                                Result::Err(_) => return Option::None,
                            }
                        },
                        Option::None => return Option::None,
                    }
                }
            }
            // A declaration-only dependency still has ordinary functions.
            // Remove its sugar declarations in place before the core parse,
            // preserving every original byte offset and line break.
            for index in 0..declaration_spans.len() {
                let row = match declaration_spans.try_get(index) {
                    Option::Some(row) => row,
                    Option::None => continue,
                };
                if surface_modules.try_get(row.module_index) == Option::Some(true)
                    && imported.try_get(row.module_index) == Option::Some(true)
                {
                    continue;
                }
                match mods.try_get_mut(row.module_index) {
                    Option::Some(source) => {
                        for position in row.start..row.end {
                            if source.text.try_get(position) != Option::Some(10)
                                && source.text.try_get(position) != Option::Some(13)
                            {
                                source.text.try_set(position, 32);
                            }
                        }
                    },
                    Option::None => {},
                }
            }
            // File bases must follow the executable text, not overlap when
            // a new template is longer than the original source.
            let mut next_base: u64 = 0;
            for module in 0..mods.len() {
                match mods.try_get(module) {
                    Option::Some(source) => {
                        match files.try_get_mut(source.file) {
                            Option::Some(file) => file.base = next_base,
                            Option::None => {},
                        }
                        next_base = wrapping_add(next_base, wrapping_add(source.text.len(), 1));
                    },
                    Option::None => {},
                }
            }
        }
    }
    Option::Some(encode_package_graph(
        in pkgs,
        in files,
        in mods,
        false,
        in imports,
        in catalogue,
        in public,
        in source_segments
    ))
}

fn encode_package_graph(
    in pkgs: ChunkSeq[PkgNode],
    in files: ChunkSeq[FileEntry],
    in mods: ChunkSeq[ModEntry],
    import_only: bool,
    in import_texts: ChunkSeq[ChunkSeq[u8]],
    in catalogue: ChunkSeq[PackageSugarDefinition],
    in public: ChunkSeq[bool],
    in source_segments: ChunkSeq[BootstrapSourceSegment]
) -> ChunkSeq[u8] {
    let mut out = ChunkSeq::new[u8]();
    put_u64(inout out, pkgs.len());
    for pi in 0..pkgs.len() {
        match pkgs.try_get(pi) {
            Option::Some(p) => {
                put_str(inout out, in p.name.as_slice());
                put_u64(inout out, p.dep_names.len());
                for di in 0..p.dep_names.len() {
                    let idx = match p.dep_indices.try_get(di) {
                        Option::Some(v) => v,
                        Option::None => 0,
                    };
                    match p.dep_names.try_get(di) {
                        Option::Some(n) => put_str(inout out, in n.as_slice()),
                        Option::None => put_str(inout out, in "".as_bytes()),
                    }
                    put_u64(inout out, idx);
                }
                // optional dependencies count = 0
                put_u64(inout out, 0);
            },
            Option::None => {},
        }
    }
    put_u64(inout out, files.len());
    for fi in 0..files.len() {
        match files.try_get(fi) {
            Option::Some(f) => {
                put_str(inout out, in f.display.as_slice());
                put_u64(inout out, f.base);
            },
            Option::None => {},
        }
    }
    put_u64(inout out, mods.len());
    for mi in 0..mods.len() {
        match mods.try_get(mi) {
            Option::Some(m) => {
                put_u64(inout out, m.pkg);
                put_u64(inout out, m.segs.len());
                for si in 0..m.segs.len() {
                    match m.segs.try_get(si) {
                        Option::Some(s) => put_str(inout out, in s.as_slice()),
                        Option::None => put_str(inout out, in "".as_bytes()),
                    }
                }
                put_u64(inout out, m.file);
                if import_only {
                    match import_texts.try_get(mi) {
                        Option::Some(imports) => put_str(inout out, in imports.as_slice()),
                        Option::None => put_str(inout out, in "".as_bytes()),
                    }
                } else {
                    put_str(inout out, in m.text.as_slice());
                }
            },
            Option::None => {},
        }
    }
    // The foreign types every package's `.vsys` libraries declare.
    let mut nforeign: u64 = 0;
    for pi in 0..pkgs.len() {
        match pkgs.try_get(pi) {
            Option::Some(p) => nforeign = wrapping_add(nforeign, p.vsys_types.len()),
            Option::None => {},
        }
    }
    put_u64(inout out, nforeign);
    for pi in 0..pkgs.len() {
        match pkgs.try_get(pi) {
            Option::Some(p) => {
                for ti in 0..p.vsys_types.len() {
                    match p.vsys_types.try_get(ti) {
                        Option::Some(t) => {
                            put_u64(inout out, pi);
                            put_str(inout out, in t.as_slice());
                        },
                        Option::None => {},
                    }
                }
            },
            Option::None => {},
        }
    }
    if catalogue.len() != 0 {
        put_u64(inout out, catalogue.len());
        for i in 0..catalogue.len() {
            match catalogue.try_get(i) {
                Option::Some(definition) => {
                    put_u64(inout out, definition.module_index);
                    put_str(inout out, in definition.name.as_slice());
                    put_u64(
                        inout out,
                        if public.try_get(i) == Option::Some(true) {
                            1
                        } else {
                            0
                        }
                    );
                },
                Option::None => {},
            }
        }
    }
    if source_segments.len() != 0 {
        put_u64(inout out, source_segments.len());
        for i in 0..source_segments.len() {
            match source_segments.try_get(i) {
                Option::Some(row) => {
                    put_u64(inout out, row.file);
                    put_u64(inout out, row.generated_start);
                    put_u64(inout out, row.generated_end);
                    put_u64(inout out, row.source_start);
                    put_u64(inout out, row.source_end);
                    put_u64(inout out, row.copied);
                },
                Option::None => {},
            }
        }
    }
    out
}

test {
    use @vesper/check-names-packages::{
        assembly_begin_bytes, assemble_next_bytes, assembly_metadata, assembly_parse_errors
    };
    use @vesper/ast::{lit_at};

    fn fixture_bytes(in text: Str) -> ChunkSeq[u8] {
        let mut source = ChunkSeq::new[u8]();
        source.extend(in text.as_bytes());
        source
    }

    fn fixture_package(in name: Str) -> PkgNode {
        PkgNode {
            name: fixture_bytes(in name),
            dir: ChunkSeq::new[u8](),
            dep_names: ChunkSeq::new[ChunkSeq[u8]](),
            dep_indices: ChunkSeq::new[u64](),
            vsys_types: ChunkSeq::new[ChunkSeq[u8]](),
            vsys_paths: ChunkSeq::new[ChunkSeq[u8]]()
        }
    }

    fn fixture_graph(in declaration: Str, shadow_intrinsic: bool) -> Option[ChunkSeq[u8]] {
        fixture_graph_calling(
            in if shadow_intrinsic {
                "use @fixture/dep::word as renamed; pub fn main() -> u64 { let wrapping_shr_u64: u64 = 0; renamed{ from 0x2a00; width 8 } }"
            } else {
                "use @fixture/dep::word as renamed; pub fn main() -> u64 { renamed{ from 0x2a00; width 8 } }"
            },
            in declaration
        )
    }

    fn fixture_graph_calling(in caller_text: Str, in declaration: Str) -> Option[ChunkSeq[u8]] {
        let mut pkgs = ChunkSeq::new[PkgNode]();
        let mut caller = fixture_package(in "@fixture/caller");
        caller.dep_names.push(sink fixture_bytes(in "@fixture/dep"));
        caller.dep_indices.push(1);
        pkgs.push(sink caller);
        pkgs.push(sink fixture_package(in "@fixture/dep"));
        let mut files = ChunkSeq::new[FileEntry]();
        files.push(sink FileEntry { display: fixture_bytes(in "caller.ves"), base: 0 });
        files.push(sink FileEntry { display: fixture_bytes(in "dependency.ves"), base: 128 });
        let mut mods = ChunkSeq::new[ModEntry]();
        mods.push(
            sink ModEntry {
                pkg: 0,
                file: 0,
                segs: ChunkSeq::new[ChunkSeq[u8]](),
                text: fixture_bytes(in caller_text)
            }
        );
        mods.push(
            sink ModEntry {
                pkg: 1,
                file: 1,
                segs: ChunkSeq::new[ChunkSeq[u8]](),
                text: fixture_bytes(in declaration)
            }
        );
        prepare_sugar_graph(in pkgs, inout files, inout mods)
    }

    fn test_imported_scalar_tag_reaches_stage2_assembly() -> bool {
        let bytes = match fixture_graph(
            in "pub sugar word: tag { rule (word{ from $n:expr; width $w:expr }) => { { let out: u64 = $n; let width: u64 = $w; let answer = wrapping_shr_u64(out, wrapping_u32(width)); if answer == 42 { answer } else { 0 } } } }",
            false
        ) {
            Option::Some(bytes) => bytes,
            Option::None => return false,
        };
        let mut assembly = assembly_begin_bytes(in bytes.as_slice());
        let parse_clean = assembly_parse_errors(in assembly) == 0;
        let first = assemble_next_bytes(inout assembly, in bytes.as_slice());
        let second = assemble_next_bytes(inout assembly, in bytes.as_slice());
        let meta = assembly_metadata(sink assembly);
        if !parse_clean || meta.diagnostics.len() != 0 {
            return false;
        }
        match (first, second) {
            (Option::Some(caller), Option::Some(_)) => {
                for i in 0..caller.ast.lits.len() {
                    if lit_at(in caller.ast, wrapping_u32(i)).bits == 42 {
                        return true;
                    }
                }
                false
            },
            _ => false,
        }
    }

    fn test_imported_scalar_tag_keeps_its_precedence() -> bool {
        let bytes = match fixture_graph_calling(
            in "use @fixture/dep::yes as renamed; pub fn main() -> bool { renamed{} && false }",
            in "pub sugar yes: tag { rule (yes{}) => { true || false } }"
        ) {
            Option::Some(bytes) => bytes,
            Option::None => return false,
        };
        // The expanded caller without spaces: `(true||false)&&false`.
        let space: u8 = 32;
        let mut packed = ChunkSeq::new[u8]();
        for i in 0..bytes.len() {
            let byte = bytes.try_get(i).unwrap_or(0);
            if byte != space {
                packed.push(byte);
            }
        }
        let grouped = "(true||false)&&false".as_bytes();
        let text = packed.as_slice();
        for start in 0..text.len() {
            let end = wrapping_add(start, grouped.len());
            if end <= text.len() && eq_bytes(in text[start..end], in grouped) {
                return true;
            }
        }
        false
    }

    fn test_bootstrap_rejects_a_definition_site_free_helper() -> bool {
        match fixture_graph(
            in "fn hidden(n: u64) -> u64 { n } pub sugar word: tag { rule (word{ from $n:expr; width $w:expr }) => { { let out: u64 = $n; let width: u64 = $w; hidden(out) } } }",
            false
        ) {
            Option::None => true,
            Option::Some(_) => false,
        }
    }

    fn test_bootstrap_rejects_intrinsics_shadowed_by_caller() -> bool {
        match fixture_graph(
            in "pub sugar word: tag { rule (word{ from $n:expr; width $w:expr }) => { { let out: u64 = $n; let width: u64 = $w; wrapping_shr_u64(out, wrapping_u32(width)) } } }",
            true
        ) {
            Option::None => true,
            Option::Some(_) => false,
        }
    }

    fn test_sugar_preflight_ignores_comments_strings_and_package_names() -> bool {
        let ordinary = "use @vesper/sugar::driver::{plan_bootstrap_sugars}; /* nested /* sugar hidden: tag {} */ comment */ fn text() -> Str { \"sugar hidden: tag {}\" }";
        let declaration = "@lean_notation pub sugar /* trivia */ tag_name : tag {}";
        !has_bootstrap_sugar_candidate(in fixture_bytes(in ordinary))
            && has_bootstrap_sugar_candidate(in fixture_bytes(in declaration))
    }

    // Which of `is_some`, `is_none`, `unwrap_or` and `or` `src` calls and
    // which it defines, each as four decimal digits, 1 for yes.
    fn option_scan(in src: Slice[u8]) -> (u64, u64) {
        let mut used = ChunkSeq::new[bool]();
        let mut defined = ChunkSeq::new[bool]();
        for _k in 0..4 {
            used.push(false);
            defined.push(false);
        }
        scan_option_methods(in src, inout used, inout defined);
        let mut u: u64 = 0;
        let mut d: u64 = 0;
        for k in 0..4 {
            u = wrapping_mul(u, 10);
            d = wrapping_mul(d, 10);
            if used.try_get(k).unwrap_or(false) {
                u = wrapping_add(u, 1);
            }
            if defined.try_get(k).unwrap_or(false) {
                d = wrapping_add(d, 1);
            }
        }
        (u, d)
    }

    fn test_option_calls_with_trivia_count() -> bool {
        let (a, _) = option_scan(in "x.unwrap_or(0)".as_bytes());
        let (b, _) = option_scan(in "x.unwrap_or (0) + y\n    .is_some()".as_bytes());
        let (c, _) = option_scan(in "x.or/* fallback */(y)".as_bytes());
        a == 10 && b == 1010 && c == 1
    }

    fn test_option_names_in_strings_and_comments_do_not() -> bool {
        let (a, _) = option_scan(in "let s = \"x.unwrap_or(0)\"; // y.is_some()\n".as_bytes());
        let (b, _) = option_scan(in "/* x.or(y) */ or(x)".as_bytes());
        a == 0 && b == 0
    }

    fn test_only_an_option_impl_defines() -> bool {
        let (u, d) = option_scan(
            in "impl [T: mod copy] Option[T] { fn unwrap_or(self, d: T) -> T { d } } fn f() { o.or(p) }"
                .as_bytes()
        );
        let (_, other) = option_scan(in "impl Foo { fn or(self) -> bool { true } }".as_bytes());
        u == 1 && d == 10 && other == 0
    }

    fn test_comments_between_tokens_are_trivia() -> bool {
        let (u, d) = option_scan(
            in "impl [T: mod copy] Option[T] { fn // c\n unwrap_or(self, d: T) -> T { d } } fn f() { o.unwrap_or(0) }"
                .as_bytes()
        );
        let (nested, _) = option_scan(in "/* a /* b */ \" */ fn f() { o.unwrap_or(0) }".as_bytes());
        u == 10 && d == 10 && nested == 10
    }
}
