// Stage 2 declaration collector: translates `@vesper/check-names-packages`
// (`AssembledModule` `@vesper/ast::Ast`s) into `@vesper/check-data`
// (`Names`, `Types`, `World`) and Stage 2 function signatures.

use @vesper/ast::{
    AdtNode, Ast, EffectDeclNode, EffectNode, EffectsNode, FieldNode, FnNode, GenericNode, ImplNode,
    ItemNode, ParamNode, TypeNode as AstTypeNode, VariantNode, list_at, list_len, none as ast_none
};
use @vesper/check-data::names::{Names, names_new};
use @vesper/check-data::types::{EffNode, TyKind, Types, types_new};
use @vesper/check-data::util::{inc32, n32, u32_at, u64_at, u8_at, w};

const NONE32: u32 = 4294967295;
// A `vcl_decls.ves` row: words split by a space; a parameter word starts
// with its pass letter.
const ROW_SEPARATOR: u8 = 32;
const ROW_PASS_INOUT: u8 = 111;
const ROW_PASS_SINK: u8 = 115;
// `ParamInfo.pass` (`TyPass`): in or plain, inout, sink.
const PASS_IN: u8 = 0;
const PASS_INOUT: u8 = 1;
const PASS_SINK: u8 = 2;
// `]`, closing a `CSlice[..]` or `Option[..]` type argument.
const TY_ARG_CLOSE_BYTES: u64 = 1;
use @vesper/check-data::world::{
    Adt, EffectRow, Field, Generic, Known, Variant, World, known_new, set_by_symbol, world_new
};
use @vesper/check-names-packages::{AssembledModule};
use @vesper-std/arena::{idx_from_raw};
use @vesper-std/intern::{symbol_from_id};
use self::vcl_decls::{vcl_decl, vcl_decl_count};

pub copy struct FnInfo {
    name: u32,
    fip: bool,
    ga: u32,
    gn: u32,
    pa: u32,
    pn: u32,
    result: u32,
    effects: u32,
    mod_idx: u32,
    body: u32,
}

pub copy struct ParamInfo {
    name: u32,
    pass: u8,
    ty: u32,
}

pub copy struct EffOpInfo {
    name: u32,
    pa: u32,
    pn: u32,
    result: u32,
}

pub copy struct EffDeclInfo {
    name: u32,
    linear: bool,
    ga: u32,
    gn: u32,
    oa: u32,
    on: u32,
}

pub struct CollectedProgram {
    names: Names,
    types: Types,
    world: World,
    fns: ChunkSeq[FnInfo],
    params: ChunkSeq[ParamInfo],
    fn_generics: ChunkSeq[Generic],
    eff_decls: ChunkSeq[EffDeclInfo],
    eff_ops: ChunkSeq[EffOpInfo],
    eff_gens: ChunkSeq[Generic],
}

fn mod_asts_mention(in mods: ChunkSeq[AssembledModule], in name: Str) -> bool {
    for mi in 0..mods.len() {
        let hit = match mods.try_get(mi) {
            Option::Some(m) => match m.ast.names.lookup(in name) {
                Option::Some(_) => true,
                Option::None => false,
            },
            Option::None => false,
        };
        if hit {
            return true;
        }
    }
    false
}

pub fn translate_sym(
    in ast: Ast,
    sym_id: u32,
    inout names: Names,
    inout cache: ChunkSeq[u32],
    inout tmp: String
) -> u32 {
    if sym_id == ast_none() {
        return ast_none();
    }
    let idx = w(sym_id);
    loop {
        if cache.len() > idx {
            break;
        }
        cache.push(ast_none());
    }
    let cached = u32_at(in cache, idx);
    if cached != ast_none() {
        return cached;
    }
    tmp.clear();
    ast.names.resolve_into(symbol_from_id(sym_id), inout tmp);
    let out = names.intern(in tmp.as_bytes());
    cache.try_set(idx, out);
    out
}

fn is_ffi_sym(in names: Names, sym: u32) -> bool {
    names.size(sym) == 3
        && names.byte(sym, 0) == 70
        && names.byte(sym, 1) == 102
        && names.byte(sym, 2) == 105
}

fn join_dollar(inout names: Names, a: u32, b: u32) -> u32 {
    let mut buf = ChunkSeq::new[u8]();
    for i in 0..names.size(a) {
        buf.push(names.byte(a, i));
    }
    buf.push(36);
    for i in 0..names.size(b) {
        buf.push(names.byte(b, i));
    }
    names.intern(in buf.as_slice())
}

pub fn lower_effects(
    in ast: Ast,
    effs_id: u32,
    inout names: Names,
    inout types: Types,
    inout cache: ChunkSeq[u32],
    inout tmp: String
) -> u32 {
    if effs_id == ast_none() {
        let es = ChunkSeq::new[EffNode]();
        let args = ChunkSeq::new[u32]();
        return types.mk_row(in es, in args, 0);
    }
    let en = match ast.effects.get(idx_from_raw[EffectsNode](effs_id)) {
        Option::Some(v) => v,
        Option::None => {
            let es = ChunkSeq::new[EffNode]();
            let args = ChunkSeq::new[u32]();
            return types.mk_row(in es, in args, 0);
        },
    };
    let n = list_len(in ast, en.instances);
    let mut es = ChunkSeq::new[EffNode]();
    let mut args = ChunkSeq::new[u32]();
    for i in 0..n {
        let eid = list_at(in ast, en.instances, i);
        match ast.effect_nodes.get(idx_from_raw[EffectNode](eid)) {
            Option::Some(e) => {
                let lbl = if e.label == ast_none() {
                    0
                } else {
                    inc32(translate_sym(in ast, e.label, inout names, inout cache, inout tmp))
                };
                let mut nm = translate_sym(in ast, e.name, inout names, inout cache, inout tmp);
                let mut ac = list_len(in ast, e.args);
                let a0 = n32(args.len());
                if is_ffi_sym(in names, nm) && ac == 1 {
                    let aty = lower_ty(
                        in ast,
                        list_at(in ast, e.args, 0),
                        inout names,
                        inout types,
                        inout cache,
                        inout tmp
                    );
                    if types.kind(aty) == TyKind::Named {
                        nm = join_dollar(inout names, nm, types.name(aty));
                        ac = 0;
                    } else {
                        args.push(aty);
                    }
                } else {
                    for j in 0..ac {
                        let aty = lower_ty(
                            in ast,
                            list_at(in ast, e.args, j),
                            inout names,
                            inout types,
                            inout cache,
                            inout tmp
                        );
                        args.push(aty);
                    }
                }
                es.push(EffNode { label: lbl, name: nm, a: a0, n: n32(ac) });
            },
            Option::None => {},
        }
    }
    let tail = if en.tail == ast_none() {
        0
    } else {
        inc32(translate_sym(in ast, en.tail, inout names, inout cache, inout tmp))
    };
    types.mk_row(in es, in args, tail)
}

pub fn lower_ty(
    in ast: Ast,
    ty_id: u32,
    inout names: Names,
    inout types: Types,
    inout cache: ChunkSeq[u32],
    inout tmp: String
) -> u32 {
    if ty_id == ast_none() {
        return types.named0(names.intern(in "()".as_bytes()));
    }
    let node = match ast.types.get(idx_from_raw[AstTypeNode](ty_id)) {
        Option::Some(v) => v,
        Option::None => {
            return types.named0(names.intern(in "()".as_bytes()));
        },
    };
    if node.kind == 1 {
        let nm = translate_sym(in ast, node.a, inout names, inout cache, inout tmp);
        let n = list_len(in ast, node.b);
        if n == 0 {
            return types.named0(nm);
        }
        let mut args = ChunkSeq::new[u32]();
        for i in 0..n {
            args.push(lower_ty(
                in ast,
                list_at(in ast, node.b, i),
                inout names,
                inout types,
                inout cache,
                inout tmp
            ));
        }
        return types.named(nm, in args);
    }
    if node.kind == 2 {
        let n = list_len(in ast, node.a);
        let mut args = ChunkSeq::new[u32]();
        for i in 0..n {
            args.push(lower_ty(
                in ast,
                list_at(in ast, node.a, i),
                inout names,
                inout types,
                inout cache,
                inout tmp
            ));
        }
        return types.tuple(in args);
    }
    if node.kind == 3 {
        let n = list_len(in ast, node.a) / 2;
        let mut args = ChunkSeq::new[u32]();
        let mut passes = ChunkSeq::new[u8]();
        for i in 0..n {
            let p = wrapping_u8(list_at(in ast, node.a, wrapping_mul(i, 2)));
            let pt = lower_ty(
                in ast,
                list_at(in ast, node.a, wrapping_add(wrapping_mul(i, 2), 1)),
                inout names,
                inout types,
                inout cache,
                inout tmp
            );
            passes.push(p);
            args.push(pt);
        }
        let res = lower_ty(in ast, node.b, inout names, inout types, inout cache, inout tmp);
        let row = lower_effects(in ast, node.c, inout names, inout types, inout cache, inout tmp);
        return types.mk_with(TyKind::Fn, wrapping_u8(node.d), 0, in args, in passes, res, row, 0);
    }
    if node.kind == 4 {
        let row = lower_effects(in ast, node.a, inout names, inout types, inout cache, inout tmp);
        return types.row_type(row);
    }
    let empty = ChunkSeq::new[u32]();
    let empty_p = ChunkSeq::new[u8]();
    types.mk_with(TyKind::Infer, 0, 0, in empty, in empty_p, 0, 0, 0)
}

fn collect_generics_into(
    in ast: Ast,
    list_id: u32,
    inout names: Names,
    inout cache: ChunkSeq[u32],
    inout tmp: String,
    inout dst: ChunkSeq[Generic]
) -> (u32, u32) {
    let ga = n32(dst.len());
    let gn = n32(list_len(in ast, list_id));
    for i in 0..w(gn) {
        let gid = list_at(in ast, list_id, i);
        match ast.generics.get(idx_from_raw[GenericNode](gid)) {
            Option::Some(g) => {
                let nm = translate_sym(in ast, g.name, inout names, inout cache, inout tmp);
                dst.push(Generic { name: nm, bound: g.bound, row: g.row });
            },
            Option::None => {},
        }
    }
    (ga, gn)
}

fn sub_self_ty(inout types: Types, self_name: u32, self_ty: u32, ty: u32) -> u32 {
    if self_ty == NONE32 {
        return ty;
    }
    let k = types.kind(ty);
    if k == TyKind::Named && types.name(ty) == self_name && types.arity(ty) == 0 {
        return self_ty;
    }
    let n = types.arity(ty);
    if n == 0 {
        return ty;
    }
    if k == TyKind::Named {
        let mut args = ChunkSeq::new[u32]();
        for i in 0..n {
            args.push(sub_self_ty(inout types, self_name, self_ty, types.arg(ty, i)));
        }
        return types.named(types.name(ty), in args);
    }
    if k == TyKind::Tuple {
        let mut args = ChunkSeq::new[u32]();
        for i in 0..n {
            args.push(sub_self_ty(inout types, self_name, self_ty, types.arg(ty, i)));
        }
        return types.tuple(in args);
    }
    ty
}

fn join_method_name(inout names: Names, tname: u32, mname: u32) -> u32 {
    let mut buf = ChunkSeq::new[u8]();
    for i in 0..names.size(tname) {
        buf.push(names.byte(tname, i));
    }
    buf.push(58);
    buf.push(58);
    for i in 0..names.size(mname) {
        buf.push(names.byte(mname, i));
    }
    names.intern(in buf.as_slice())
}

fn collect_fn_into(
    in ast: Ast,
    fn_node: FnNode,
    fname: u32,
    impl_generics: u32,
    self_name: u32,
    self_ty: u32,
    mod_idx: u32,
    inout names: Names,
    inout types: Types,
    inout cache: ChunkSeq[u32],
    inout tmp: String,
    inout fn_generics: ChunkSeq[Generic],
    inout params: ChunkSeq[ParamInfo],
    inout fns: ChunkSeq[FnInfo]
) {
    let ga = n32(fn_generics.len());
    let (_iga, ign) = if impl_generics == ast_none() {
        (0, 0)
    } else {
        collect_generics_into(
            in ast,
            impl_generics,
            inout names,
            inout cache,
            inout tmp,
            inout fn_generics
        )
    };
    let (_fga, fgn) = collect_generics_into(
        in ast,
        fn_node.generics,
        inout names,
        inout cache,
        inout tmp,
        inout fn_generics
    );
    let gn = wrapping_add(ign, fgn);
    let pa = n32(params.len());
    let pn = n32(list_len(in ast, fn_node.params));
    for pi in 0..w(pn) {
        let pid = list_at(in ast, fn_node.params, pi);
        let p = match ast.params.get(idx_from_raw[ParamNode](pid)) {
            Option::Some(pv) => pv,
            Option::None => continue,
        };
        let pname = translate_sym(in ast, p.name, inout names, inout cache, inout tmp);
        let pty = if p.ty == ast_none() && self_ty != NONE32 {
            self_ty
        } else {
            let raw_pty = lower_ty(in ast, p.ty, inout names, inout types, inout cache, inout tmp);
            let sub_pty = sub_self_ty(inout types, self_name, self_ty, raw_pty);
            if self_ty != NONE32
                && types.kind(sub_pty) == TyKind::Infer
                && names.spells(pname, in "self".as_bytes())
            {
                self_ty
            } else {
                sub_pty
            }
        };
        params.push(ParamInfo { name: pname, pass: p.pass, ty: pty });
    }
    let raw_res = lower_ty(
        in ast,
        fn_node.result,
        inout names,
        inout types,
        inout cache,
        inout tmp
    );
    let res = sub_self_ty(inout types, self_name, self_ty, raw_res);
    let effs = lower_effects(
        in ast,
        fn_node.effects,
        inout names,
        inout types,
        inout cache,
        inout tmp
    );
    fns.push(FnInfo {
        name: fname,
        fip: fn_node.fip,
        ga: ga,
        gn: gn,
        pa: pa,
        pn: pn,
        result: res,
        effects: effs,
        mod_idx: mod_idx,
        body: fn_node.body
    });
}

fn add_ffi_op(
    inout names: Names,
    inout params: ChunkSeq[ParamInfo],
    inout eff_ops: ChunkSeq[EffOpInfo],
    in op_name: Str,
    in p_passes: ChunkSeq[u8],
    in p_tys: ChunkSeq[u32],
    result_ty: u32
) {
    let pa = n32(params.len());
    let pn = n32(p_tys.len());
    for i in 0..p_tys.len() {
        let pass = match p_passes.try_get(i) {
            Option::Some(v) => v,
            Option::None => 0,
        };
        let ty = match p_tys.try_get(i) {
            Option::Some(v) => v,
            Option::None => 0,
        };
        params.push(ParamInfo { name: names.intern(in "a".as_bytes()), pass: pass, ty: ty });
    }
    eff_ops.push(EffOpInfo {
        name: names.intern(in op_name.as_bytes()),
        pa: pa,
        pn: pn,
        result: result_ty
    });
}

fn row_byte(in s: Slice[u8], i: u64) -> u8 {
    match s.try_get(i) {
        Option::Some(b) => b,
        Option::None => 0,
    }
}

fn row_is(in a: Slice[u8], in b: Str) -> bool {
    let bb = b.as_bytes();
    if a.len() != bb.len() {
        return false;
    }
    for i in 0..a.len() {
        if row_byte(in a, i) != row_byte(in bb, i) {
            return false;
        }
    }
    true
}

fn row_starts(in a: Slice[u8], in p: Str) -> bool {
    let pb = p.as_bytes();
    if a.len() < pb.len() {
        return false;
    }
    row_is(in a[0..pb.len()], in p)
}

// The type of a `cranelift.vsys` type text: a scalar, `Unit`,
// `CSlice[T]` (a `Slice[T]`), `Option[T]` or a handle type.
fn vcl_decl_ty(
    inout names: Names,
    inout types: Types,
    k: Known,
    opt_sym: u32,
    in t: Slice[u8]
) -> u32 {
    if row_is(in t, in "u8") {
        return types.named0(k.u8_);
    }
    if row_is(in t, in "u32") {
        return types.named0(k.u32_);
    }
    if row_is(in t, in "u64") {
        return types.named0(k.u64_);
    }
    if row_is(in t, in "i32") {
        return types.named0(k.i32_);
    }
    if row_is(in t, in "i64") {
        return types.named0(k.i64_);
    }
    if row_is(in t, in "bool") {
        return types.named0(k.bool_);
    }
    if row_is(in t, in "Unit") {
        return types.unit;
    }
    let slice_open = "CSlice[";
    let option_open = "Option[";
    let close = wrapping_sub(t.len(), TY_ARG_CLOSE_BYTES);
    if row_starts(in t, in slice_open) {
        let elem = vcl_decl_ty(
            inout names,
            inout types,
            k,
            opt_sym,
            in t[slice_open.as_bytes().len()..close]
        );
        let mut args = ChunkSeq::new[u32]();
        args.push(elem);
        return types.named(names.intern(in "Slice".as_bytes()), in args);
    }
    if row_starts(in t, in option_open) {
        let inner = vcl_decl_ty(
            inout names,
            inout types,
            k,
            opt_sym,
            in t[option_open.as_bytes().len()..close]
        );
        let mut args = ChunkSeq::new[u32]();
        args.push(inner);
        return types.named(opt_sym, in args);
    }
    types.named0(names.intern(in t))
}

// The `Ffi$Cranelift` operations of `cranelift.vsys`, one per
// `vcl_decls.ves` row, from `eff_ops.len()` on.
fn add_vcl_ops(
    inout names: Names,
    inout types: Types,
    inout params: ChunkSeq[ParamInfo],
    inout eff_ops: ChunkSeq[EffOpInfo],
    k: Known,
    opt_sym: u32
) {
    for i in 0..vcl_decl_count() {
        let row_text = vcl_decl(i);
        let row = row_text.as_bytes();
        let mut starts = ChunkSeq::new[u64]();
        let mut ends = ChunkSeq::new[u64]();
        let mut a: u64 = 0;
        for j in 0..row.len() {
            if row_byte(in row, j) == ROW_SEPARATOR {
                starts.push(a);
                ends.push(j);
                a = wrapping_add(j, 1);
            }
        }
        starts.push(a);
        ends.push(row.len());
        let last = wrapping_sub(starts.len(), 1);
        let mut passes = ChunkSeq::new[u8]();
        let mut tys = ChunkSeq::new[u32]();
        for wi in 1..last {
            let ws = u64_at(in starts, wi);
            let p = row_byte(in row, ws);
            passes.push(
                if p == ROW_PASS_INOUT {
                    PASS_INOUT
                } else if p == ROW_PASS_SINK {
                    PASS_SINK
                } else {
                    PASS_IN
                }
            );
            tys.push(vcl_decl_ty(
                inout names,
                inout types,
                k,
                opt_sym,
                in row[wrapping_add(ws, 1)..u64_at(in ends, wi)]
            ));
        }
        let result = vcl_decl_ty(
            inout names,
            inout types,
            k,
            opt_sym,
            in row[u64_at(in starts, last)..row.len()]
        );
        let pa = n32(params.len());
        for pi in 0..tys.len() {
            params.push(ParamInfo {
                name: names.intern(in "a".as_bytes()),
                pass: u8_at(in passes, pi),
                ty: u32_at(in tys, pi)
            });
        }
        eff_ops.push(EffOpInfo {
            name: names.intern(in row[0..u64_at(in ends, 0)]),
            pa: pa,
            pn: n32(tys.len()),
            result: result
        });
    }
}

pub fn collect_program(in mods: ChunkSeq[AssembledModule]) -> CollectedProgram {
    let mut names = names_new();
    let mut types = types_new(inout names);
    let known = known_new(inout names);
    let mut world = world_new(known);
    let mut fns = ChunkSeq::new[FnInfo]();
    let mut params = ChunkSeq::new[ParamInfo]();
    let mut fn_generics = ChunkSeq::new[Generic]();
    let mut eff_decls = ChunkSeq::new[EffDeclInfo]();
    let mut eff_ops = ChunkSeq::new[EffOpInfo]();
    let mut eff_gens = ChunkSeq::new[Generic]();
    let mut tmp = String::new();
    for mi in 0..mods.len() {
        match mods.try_get(mi) {
            Option::Some(m) => {
                let mut cache = ChunkSeq::new[u32]();
                let ic = m.ast.m_items.len();
                for ii in 0..ic {
                    let item_id = u32_at(in m.ast.m_items, ii);
                    let item = match m.ast.items.get(idx_from_raw[ItemNode](item_id)) {
                        Option::Some(v) => v,
                        Option::None => continue,
                    };
                    if item.kind == 1 {
                        let a = match m.ast.adts.get(idx_from_raw[AdtNode](item.node)) {
                            Option::Some(v) => v,
                            Option::None => continue,
                        };
                        let aname = translate_sym(
                            in m.ast,
                            a.name,
                            inout names,
                            inout cache,
                            inout tmp
                        );
                        let (ga, gn) = collect_generics_into(
                            in m.ast,
                            a.generics,
                            inout names,
                            inout cache,
                            inout tmp,
                            inout world.generics
                        );
                        let va = n32(world.variants.len());
                        let vn = n32(list_len(in m.ast, a.variants));
                        for vi in 0..w(vn) {
                            let vid = list_at(in m.ast, a.variants, vi);
                            let v = match m.ast.variants.get(idx_from_raw[VariantNode](vid)) {
                                Option::Some(vv) => vv,
                                Option::None => continue,
                            };
                            let vname = translate_sym(
                                in m.ast,
                                v.name,
                                inout names,
                                inout cache,
                                inout tmp
                            );
                            let fa = n32(world.fields.len());
                            let fc = n32(list_len(in m.ast, v.fields));
                            for fi in 0..w(fc) {
                                let fid = list_at(in m.ast, v.fields, fi);
                                let f = match m.ast.fields.get(idx_from_raw[FieldNode](fid)) {
                                    Option::Some(fv) => fv,
                                    Option::None => continue,
                                };
                                let fname = translate_sym(
                                    in m.ast,
                                    f.name,
                                    inout names,
                                    inout cache,
                                    inout tmp
                                );
                                let fty = lower_ty(
                                    in m.ast,
                                    f.ty,
                                    inout names,
                                    inout types,
                                    inout cache,
                                    inout tmp
                                );
                                let mod_val: u8 = if f.modality >= 3 {
                                    0
                                } else {
                                    wrapping_u8(wrapping_add(widen_u64(f.modality), 1))
                                };
                                world
                                    .fields
                                    .push(Field { name: fname, ty: fty, modality: mod_val });
                            }
                            world
                                .variants
                                .push(Variant { name: vname, fa: fa, fc: fc, named: v.named });
                        }
                        let adt_idx = n32(world.adts.len());
                        let tile_val: u32 = if a.tiled { inc32(a.tile_width) } else { 0 };
                        world.adts.push(Adt {
                            name: aname,
                            mode: a.mode,
                            ga: ga,
                            gn: gn,
                            va: va,
                            vn: vn,
                            is_enum: a.is_enum,
                            tile: tile_val,
                            span_zero: a.start == 0 && a.end == 0
                        });
                        set_by_symbol(inout world.by_name, aname, inc32(adt_idx));
                    } else if item.kind == 2 {
                        let fn_node = match m.ast.fns.get(idx_from_raw[FnNode](item.node)) {
                            Option::Some(v) => v,
                            Option::None => continue,
                        };
                        let fname = translate_sym(
                            in m.ast,
                            fn_node.name,
                            inout names,
                            inout cache,
                            inout tmp
                        );
                        collect_fn_into(
                            in m.ast,
                            fn_node,
                            fname,
                            ast_none(),
                            0,
                            NONE32,
                            n32(mi),
                            inout names,
                            inout types,
                            inout cache,
                            inout tmp,
                            inout fn_generics,
                            inout params,
                            inout fns
                        );
                    } else if item.kind == 3 {
                        let ed = match m.ast
                            .effect_decls
                            .get(idx_from_raw[EffectDeclNode](item.node))
                        {
                            Option::Some(v) => v,
                            Option::None => continue,
                        };
                        let ename = translate_sym(
                            in m.ast,
                            ed.name,
                            inout names,
                            inout cache,
                            inout tmp
                        );
                        let eidx = n32(world.effects.len());
                        world.effects.push(EffectRow { name: ename, linear: ed.linear });
                        set_by_symbol(inout world.effect_by_name, ename, inc32(eidx));
                        let (ega, egn) = collect_generics_into(
                            in m.ast,
                            ed.generics,
                            inout names,
                            inout cache,
                            inout tmp,
                            inout eff_gens
                        );
                        let eoa = n32(eff_ops.len());
                        let eon = n32(list_len(in m.ast, ed.ops));
                        for oi in 0..w(eon) {
                            let oid = list_at(in m.ast, ed.ops, oi);
                            let op_fn = match m.ast.fns.get(idx_from_raw[FnNode](oid)) {
                                Option::Some(ov) => ov,
                                Option::None => continue,
                            };
                            let oname = translate_sym(
                                in m.ast,
                                op_fn.name,
                                inout names,
                                inout cache,
                                inout tmp
                            );
                            let opa = n32(params.len());
                            let opn = n32(list_len(in m.ast, op_fn.params));
                            for pi in 0..w(opn) {
                                let pid = list_at(in m.ast, op_fn.params, pi);
                                let p = match m.ast.params.get(idx_from_raw[ParamNode](pid)) {
                                    Option::Some(pv) => pv,
                                    Option::None => continue,
                                };
                                let pname = translate_sym(
                                    in m.ast,
                                    p.name,
                                    inout names,
                                    inout cache,
                                    inout tmp
                                );
                                let pty = lower_ty(
                                    in m.ast,
                                    p.ty,
                                    inout names,
                                    inout types,
                                    inout cache,
                                    inout tmp
                                );
                                params.push(ParamInfo { name: pname, pass: p.pass, ty: pty });
                            }
                            let ores = lower_ty(
                                in m.ast,
                                op_fn.result,
                                inout names,
                                inout types,
                                inout cache,
                                inout tmp
                            );
                            eff_ops.push(EffOpInfo { name: oname, pa: opa, pn: opn, result: ores });
                        }
                        eff_decls.push(EffDeclInfo {
                            name: ename,
                            linear: ed.linear,
                            ga: ega,
                            gn: egn,
                            oa: eoa,
                            on: eon
                        });
                    } else if item.kind == 4 {
                        let im = match m.ast.impls.get(idx_from_raw[ImplNode](item.node)) {
                            Option::Some(v) => v,
                            Option::None => continue,
                        };
                        let self_ty = lower_ty(
                            in m.ast,
                            im.ty,
                            inout names,
                            inout types,
                            inout cache,
                            inout tmp
                        );
                        if types.kind(self_ty) == TyKind::Named {
                            let tname = types.name(self_ty);
                            let self_name = names.intern(in "Self".as_bytes());
                            let mc = list_len(in m.ast, im.methods);
                            for mi2 in 0..mc {
                                let fid = list_at(in m.ast, im.methods, mi2);
                                let fn_node = match m.ast.fns.get(idx_from_raw[FnNode](fid)) {
                                    Option::Some(v) => v,
                                    Option::None => continue,
                                };
                                let mname = translate_sym(
                                    in m.ast,
                                    fn_node.name,
                                    inout names,
                                    inout cache,
                                    inout tmp
                                );
                                let cname = join_method_name(inout names, tname, mname);
                                collect_fn_into(
                                    in m.ast,
                                    fn_node,
                                    cname,
                                    im.generics,
                                    self_name,
                                    self_ty,
                                    n32(mi),
                                    inout names,
                                    inout types,
                                    inout cache,
                                    inout tmp,
                                    inout fn_generics,
                                    inout params,
                                    inout fns
                                );
                            }
                        }
                    }
                }
            },
            Option::None => {},
        }
    }
    let opt_sym = names.intern(in "Option".as_bytes());
    let has_opt = match world.by_name.try_get(w(opt_sym)) {
        Option::Some(v) => v != 0,
        Option::None => false,
    };
    if !has_opt {
        let t_gen = names.intern(in "T".as_bytes());
        let oga = n32(world.generics.len());
        world.generics.push(Generic { name: t_gen, bound: 0, row: false });
        let ofa = n32(world.fields.len());
        world.fields.push(Field {
            name: names.intern(in "0".as_bytes()),
            ty: types.named0(t_gen),
            modality: 0
        });
        // Rust's prelude order (`enum Option[T] { None, Some(T) }`), which
        // vesper-port-abi hard-codes: objects Stage 2 builds share Rust's
        // tags (#2290).
        let ova = n32(world.variants.len());
        world.variants.push(Variant {
            name: names.intern(in "None".as_bytes()),
            fa: 0,
            fc: 0,
            named: false
        });
        world.variants.push(Variant {
            name: names.intern(in "Some".as_bytes()),
            fa: ofa,
            fc: 1,
            named: false
        });
        let oidx = n32(world.adts.len());
        world.adts.push(Adt {
            name: opt_sym,
            mode: 0,
            ga: oga,
            gn: 1,
            va: ova,
            vn: 2,
            is_enum: true,
            tile: 0,
            span_zero: false
        });
        set_by_symbol(inout world.by_name, opt_sym, inc32(oidx));
    }
    let has_res_name = names.lookup(in "Result".as_bytes()) != NONE32
        || mod_asts_mention(in mods, in "Result");
    if has_res_name {
        let res_sym = names.intern(in "Result".as_bytes());
        let has_res = match world.by_name.try_get(w(res_sym)) {
            Option::Some(v) => v != 0,
            Option::None => false,
        };
        if !has_res {
            let t_gen = names.intern(in "T".as_bytes());
            let e_gen = names.intern(in "E".as_bytes());
            let rga = n32(world.generics.len());
            world.generics.push(Generic { name: t_gen, bound: 0, row: false });
            world.generics.push(Generic { name: e_gen, bound: 0, row: false });
            let f0 = n32(world.fields.len());
            world.fields.push(Field {
                name: names.intern(in "0".as_bytes()),
                ty: types.named0(t_gen),
                modality: 0
            });
            let f1 = n32(world.fields.len());
            world.fields.push(Field {
                name: names.intern(in "0".as_bytes()),
                ty: types.named0(e_gen),
                modality: 0
            });
            let rva = n32(world.variants.len());
            world.variants.push(Variant {
                name: names.intern(in "Ok".as_bytes()),
                fa: f0,
                fc: 1,
                named: false
            });
            world.variants.push(Variant {
                name: names.intern(in "Err".as_bytes()),
                fa: f1,
                fc: 1,
                named: false
            });
            let res_idx = n32(world.adts.len());
            world.adts.push(Adt {
                name: res_sym,
                mode: 0,
                ga: rga,
                gn: 2,
                va: rva,
                vn: 2,
                is_enum: true,
                tile: 0,
                span_zero: false
            });
            set_by_symbol(inout world.by_name, res_sym, inc32(res_idx));
        }
    }
    let re_sym = names.intern(in "RuntimeError".as_bytes());
    let has_re = match world.by_name.try_get(w(re_sym)) {
        Option::Some(v) => v != 0,
        Option::None => false,
    };
    if !has_re {
        // Rust's prelude: `copy enum RuntimeError { DivisionByZero,
        // IndexOutOfBounds }` (#2290).
        let rva = n32(world.variants.len());
        world.variants.push(Variant {
            name: names.intern(in "DivisionByZero".as_bytes()),
            fa: 0,
            fc: 0,
            named: false
        });
        world.variants.push(Variant {
            name: names.intern(in "IndexOutOfBounds".as_bytes()),
            fa: 0,
            fc: 0,
            named: false
        });
        let ridx = n32(world.adts.len());
        world.adts.push(Adt {
            name: re_sym,
            mode: 0,
            ga: 0,
            gn: 0,
            va: rva,
            vn: 2,
            is_enum: true,
            tile: 0,
            span_zero: false
        });
        set_by_symbol(inout world.by_name, re_sym, inc32(ridx));
    }
    let ao_sym = names.intern(in "ArithOverflow".as_bytes());
    let has_ao = match world.by_name.try_get(w(ao_sym)) {
        Option::Some(v) => v != 0,
        Option::None => false,
    };
    if !has_ao {
        // Rust's prelude: `copy struct ArithOverflow {}`, the error checked
        // arithmetic raises (#2290).
        let ava = n32(world.variants.len());
        world.variants.push(Variant { name: ao_sym, fa: 0, fc: 0, named: true });
        let aidx = n32(world.adts.len());
        world.adts.push(Adt {
            name: ao_sym,
            mode: 0,
            ga: 0,
            gn: 0,
            va: ava,
            vn: 1,
            is_enum: false,
            tile: 0,
            span_zero: false
        });
        set_by_symbol(inout world.by_name, ao_sym, inc32(aidx));
    }
    let fail_sym = names.intern(in "Fail".as_bytes());
    let has_fail = match world.effect_by_name.try_get(w(fail_sym)) {
        Option::Some(v) => v != 0,
        Option::None => false,
    };
    if !has_fail {
        let eidx = n32(world.effects.len());
        world.effects.push(EffectRow { name: fail_sym, linear: false });
        set_by_symbol(inout world.effect_by_name, fail_sym, inc32(eidx));
        let e_gen = names.intern(in "E".as_bytes());
        let ega = n32(eff_gens.len());
        eff_gens.push(Generic { name: e_gen, bound: 0, row: false });
        let opa = n32(params.len());
        params.push(ParamInfo {
            name: names.intern(in "e".as_bytes()),
            pass: 2,
            ty: types.named0(e_gen)
        });
        let eoa = n32(eff_ops.len());
        eff_ops.push(EffOpInfo {
            name: names.intern(in "raise".as_bytes()),
            pa: opa,
            pn: 1,
            result: types.named0(world.k.never)
        });
        eff_decls
            .push(EffDeclInfo { name: fail_sym, linear: false, ga: ega, gn: 1, oa: eoa, on: 1 });
    }
    let u64_t = types.named0(world.k.u64_);
    let i64_t = types.named0(world.k.i64_);
    let u8_t = types.named0(world.k.u8_);
    let bool_t = types.named0(world.k.bool_);
    let unit_t = types.unit;
    let mut sl_args = ChunkSeq::new[u32]();
    sl_args.push(u8_t);
    let slice_u8_t = types.named(names.intern(in "Slice".as_bytes()), in sl_args);
    let fs_file_t = types.named0(names.intern(in "FsFile".as_bytes()));
    let fs_dir_t = types.named0(names.intern(in "FsDir".as_bytes()));
    let fs_meta_t = types.named0(names.intern(in "FsMeta".as_bytes()));
    let mut of_args = ChunkSeq::new[u32]();
    of_args.push(fs_file_t);
    let opt_fs_file_t = types.named(opt_sym, in of_args);
    let mut od_args = ChunkSeq::new[u32]();
    od_args.push(fs_dir_t);
    let opt_fs_dir_t = types.named(opt_sym, in od_args);

    let env_sym = names.intern(in "Ffi$StdEnv".as_bytes());
    let env_oa = n32(eff_ops.len());
    let mut p0 = ChunkSeq::new[u8]();
    let mut t0 = ChunkSeq::new[u32]();
    add_ffi_op(
        inout names,
        inout params,
        inout eff_ops,
        in "vstd_env_arg_count",
        in p0,
        in t0,
        u64_t
    );
    add_ffi_op(
        inout names,
        inout params,
        inout eff_ops,
        in "vstd_env_var_count",
        in p0,
        in t0,
        u64_t
    );
    let mut p_u64_s = ChunkSeq::new[u8]();
    p_u64_s.push(0);
    p_u64_s.push(1);
    let mut t_u64_s = ChunkSeq::new[u32]();
    t_u64_s.push(u64_t);
    t_u64_s.push(slice_u8_t);
    add_ffi_op(
        inout names,
        inout params,
        inout eff_ops,
        in "vstd_env_arg",
        in p_u64_s,
        in t_u64_s,
        i64_t
    );
    add_ffi_op(
        inout names,
        inout params,
        inout eff_ops,
        in "vstd_env_var_at",
        in p_u64_s,
        in t_u64_s,
        i64_t
    );
    let mut p_s_s = ChunkSeq::new[u8]();
    p_s_s.push(0);
    p_s_s.push(1);
    let mut t_s_s = ChunkSeq::new[u32]();
    t_s_s.push(slice_u8_t);
    t_s_s.push(slice_u8_t);
    add_ffi_op(
        inout names,
        inout params,
        inout eff_ops,
        in "vstd_env_var",
        in p_s_s,
        in t_s_s,
        i64_t
    );
    let mut p_s_u = ChunkSeq::new[u8]();
    p_s_u.push(1);
    p_s_u.push(1);
    let mut t_s_u = ChunkSeq::new[u32]();
    t_s_u.push(slice_u8_t);
    t_s_u.push(u64_t);
    add_ffi_op(
        inout names,
        inout params,
        inout eff_ops,
        in "vstd_env_current_dir",
        in p_s_u,
        in t_s_u,
        i64_t
    );
    eff_decls.push(EffDeclInfo { name: env_sym, linear: false, ga: 0, gn: 0, oa: env_oa, on: 6 });

    let fs_sym = names.intern(in "Ffi$StdFs".as_bytes());
    let fs_oa = n32(eff_ops.len());
    add_ffi_op(inout names, inout params, inout eff_ops, in "vstd_fs_unique", in p0, in t0, u64_t);
    let mut p_s = ChunkSeq::new[u8]();
    p_s.push(0);
    let mut t_s = ChunkSeq::new[u32]();
    t_s.push(slice_u8_t);
    add_ffi_op(
        inout names,
        inout params,
        inout eff_ops,
        in "vstd_fs_parent_len",
        in p_s,
        in t_s,
        u64_t
    );
    let mut p_f = ChunkSeq::new[u8]();
    p_f.push(0);
    let mut t_f = ChunkSeq::new[u32]();
    t_f.push(fs_file_t);
    add_ffi_op(
        inout names,
        inout params,
        inout eff_ops,
        in "vstd_fs_file_len",
        in p_f,
        in t_f,
        u64_t
    );
    let mut p_fs = ChunkSeq::new[u8]();
    p_fs.push(2);
    add_ffi_op(
        inout names,
        inout params,
        inout eff_ops,
        in "vstd_fs_close",
        in p_fs,
        in t_f,
        unit_t
    );
    let mut p_open = ChunkSeq::new[u8]();
    p_open.push(0);
    p_open.push(0);
    p_open.push(1);
    let mut t_open = ChunkSeq::new[u32]();
    t_open.push(slice_u8_t);
    t_open.push(u64_t);
    t_open.push(u64_t);
    add_ffi_op(
        inout names,
        inout params,
        inout eff_ops,
        in "vstd_fs_open",
        in p_open,
        in t_open,
        opt_fs_file_t
    );
    let mut p_read = ChunkSeq::new[u8]();
    p_read.push(1);
    p_read.push(1);
    p_read.push(1);
    let mut t_read = ChunkSeq::new[u32]();
    t_read.push(fs_file_t);
    t_read.push(slice_u8_t);
    t_read.push(u64_t);
    add_ffi_op(
        inout names,
        inout params,
        inout eff_ops,
        in "vstd_fs_read",
        in p_read,
        in t_read,
        i64_t
    );
    let mut p_write = ChunkSeq::new[u8]();
    p_write.push(1);
    p_write.push(0);
    p_write.push(1);
    add_ffi_op(
        inout names,
        inout params,
        inout eff_ops,
        in "vstd_fs_write",
        in p_write,
        in t_read,
        u64_t
    );
    let mut p_sync = ChunkSeq::new[u8]();
    p_sync.push(1);
    p_sync.push(1);
    let mut t_sync = ChunkSeq::new[u32]();
    t_sync.push(fs_file_t);
    t_sync.push(u64_t);
    add_ffi_op(
        inout names,
        inout params,
        inout eff_ops,
        in "vstd_fs_sync",
        in p_sync,
        in t_sync,
        u64_t
    );
    let mut p_ren = ChunkSeq::new[u8]();
    p_ren.push(0);
    p_ren.push(0);
    p_ren.push(1);
    let mut t_ren = ChunkSeq::new[u32]();
    t_ren.push(slice_u8_t);
    t_ren.push(slice_u8_t);
    t_ren.push(u64_t);
    add_ffi_op(
        inout names,
        inout params,
        inout eff_ops,
        in "vstd_fs_rename",
        in p_ren,
        in t_ren,
        u64_t
    );
    let mut p_rm = ChunkSeq::new[u8]();
    p_rm.push(0);
    p_rm.push(1);
    let mut t_rm = ChunkSeq::new[u32]();
    t_rm.push(slice_u8_t);
    t_rm.push(u64_t);
    add_ffi_op(
        inout names,
        inout params,
        inout eff_ops,
        in "vstd_fs_remove_file",
        in p_rm,
        in t_rm,
        u64_t
    );
    add_ffi_op(
        inout names,
        inout params,
        inout eff_ops,
        in "vstd_fs_sync_dir",
        in p_rm,
        in t_rm,
        u64_t
    );
    let mut t_dir = ChunkSeq::new[u32]();
    t_dir.push(slice_u8_t);
    t_dir.push(bool_t);
    t_dir.push(u64_t);
    add_ffi_op(
        inout names,
        inout params,
        inout eff_ops,
        in "vstd_fs_remove_dir",
        in p_ren,
        in t_dir,
        u64_t
    );
    add_ffi_op(
        inout names,
        inout params,
        inout eff_ops,
        in "vstd_fs_create_dir",
        in p_ren,
        in t_dir,
        u64_t
    );
    let mut p_meta = ChunkSeq::new[u8]();
    p_meta.push(0);
    p_meta.push(0);
    p_meta.push(1);
    p_meta.push(1);
    let mut t_meta = ChunkSeq::new[u32]();
    t_meta.push(slice_u8_t);
    t_meta.push(bool_t);
    t_meta.push(fs_meta_t);
    t_meta.push(u64_t);
    add_ffi_op(
        inout names,
        inout params,
        inout eff_ops,
        in "vstd_fs_metadata",
        in p_meta,
        in t_meta,
        u64_t
    );
    add_ffi_op(
        inout names,
        inout params,
        inout eff_ops,
        in "vstd_fs_read_dir",
        in p_rm,
        in t_rm,
        opt_fs_dir_t
    );
    let mut t_dn = ChunkSeq::new[u32]();
    t_dn.push(fs_dir_t);
    t_dn.push(slice_u8_t);
    t_dn.push(types.named0(world.k.u32_));
    add_ffi_op(
        inout names,
        inout params,
        inout eff_ops,
        in "vstd_fs_dir_next",
        in p_read,
        in t_dn,
        i64_t
    );
    let mut t_dc = ChunkSeq::new[u32]();
    t_dc.push(fs_dir_t);
    add_ffi_op(
        inout names,
        inout params,
        inout eff_ops,
        in "vstd_fs_dir_close",
        in p_fs,
        in t_dc,
        unit_t
    );
    eff_decls.push(EffDeclInfo { name: fs_sym, linear: false, ga: 0, gn: 0, oa: fs_oa, on: 17 });

    // Only a program that names the library declares it, so every other
    // program collects as before.
    if mod_asts_mention(in mods, in "Cranelift") {
        let vcl_sym = names.intern(in "Ffi$Cranelift".as_bytes());
        let vcl_oa = n32(eff_ops.len());
        add_vcl_ops(inout names, inout types, inout params, inout eff_ops, world.k, opt_sym);
        eff_decls.push(EffDeclInfo {
            name: vcl_sym,
            linear: false,
            ga: 0,
            gn: 0,
            oa: vcl_oa,
            on: n32(vcl_decl_count())
        });
    }
    CollectedProgram {
        names: names,
        types: types,
        world: world,
        fns: fns,
        params: params,
        fn_generics: fn_generics,
        eff_decls: eff_decls,
        eff_ops: eff_ops,
        eff_gens: eff_gens
    }
}
