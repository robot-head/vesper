// The intrinsics that `$string_prelude.ves` (src/loader.ves) always has.
pub fn checked_add_u64(a: u64, b: u64) -> Option[u64] {
    if b > wrapping_sub(18446744073709551615, a) {
        Option::None
    } else {
        Option::Some(wrapping_add(a, b))
    }
}
pub fn checked_sub_u64(a: u64, b: u64) -> Option[u64] {
    if b > a {
        Option::None
    } else {
        Option::Some(wrapping_sub(a, b))
    }
}
pub fn checked_mul_u64(a: u64, b: u64) -> Option[u64] {
    if a == 0 || b == 0 {
        Option::Some(0)
    } else if a > 18446744073709551615 / b {
        Option::None
    } else {
        Option::Some(wrapping_mul(a, b))
    }
}
pub fn checked_add_u128(a: u128, b: u128) -> Option[u128] {
    let s = wrapping_add(a, b);
    if s < a {
        Option::None
    } else {
        Option::Some(s)
    }
}
pub fn checked_mul_u128(a: u128, b: u128) -> Option[u128] {
    if a == 0 || b == 0 {
        Option::Some(0)
    } else {
        let p = wrapping_mul(a, b);
        if p / a != b {
            Option::None
        } else {
            Option::Some(p)
        }
    }
}
pub fn wrapping_neg_i64(x: i64) -> i64 {
    wrapping_sub(0, x)
}
pub fn wrapping_shl_u64(x: u64, n: u32) -> u64 {
    x << widen_u64(n & 63)
}
pub fn wrapping_shr_u64(x: u64, n: u32) -> u64 {
    x >> widen_u64(n & 63)
}
pub fn wrapping_shl_u32(x: u32, n: u32) -> u32 {
    x << (n & 31)
}
pub fn wrapping_shr_u32(x: u32, n: u32) -> u32 {
    x >> (n & 31)
}
pub fn trailing_zeros_u64(x: u64) -> u32 {
    if x == 0 {
        64
    } else {
        let mut v = x;
        let mut c: u32 = 0;
        loop {
            if (v & 1) != 0 {
                break;
            }
            v = wrapping_shr_u64(v, 1);
            c = wrapping_add(c, 1);
        }
        c
    }
}
