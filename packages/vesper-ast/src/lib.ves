// @vesper/ast: the surface AST in Vesper (self-hosting wave SH1 lane 9,
// #1152). The node kinds, fields and spans of `vesper_core::ast` (the
// `Module` that `vesper_syntax::parser::parse` returns), with names
// interned through @vesper-std/intern and nodes in typed arenas from
// @vesper-std/arena, and the lowering from the front end v2 tables
// (@vesper/front) to it.
//
// Until borrowed `Box` matching lands (SH1 lane 6) the tree is an index
// graph: a node names its children by arena index, and a list of children
// is a `ListRef` into one shared pool of words. Read the tree through the
// accessors below, not the raw fields, so the representation can move to
// `Box` children later. `NONE` (u32::MAX) is an absent optional child or
// name. Names, operators and string literal values are `Symbol` ids of
// `Ast.names`.
//
// tests/self_host_ast.rs checks the canonical dump (dump.ves) of this AST
// against the same dump of the Rust AST on every `.ves` file of the
// repository, the parser test corpus and a fuzzed corpus.

use @vesper-std/arena::{
    Arena,
    Idx,
    arena_new,
    idx_from_raw
};
use @vesper-std/intern::{
    Interner,
    interner_new,
    symbol_from_id
};
use self::lower::{
    lower_source
};
use self::dump::{
    dump_ast
};

// An absent child, name or optional value.
pub fn none() -> u32 {
    4294967295
}

// A run of words in `Ast.pool`: `len` words from `first`. Lists of pairs
// (struct fields, match arms, constructor fields, function type
// parameters) hold two words per element.
pub copy struct ListRef {
    first: u32,
    len: u32
}

// A literal (`Literal`). Kinds: 1 Int (`bits` is the magnitude, `neg` its
// sign; `vesper_core` keeps an i128 within -(2^64 - 1)..=2^64 - 1), 2 Float
// (`bits` is the f64 bit pattern), 3 Bool (`bits` 0 or 1), 4 String (`bits`
// is the symbol of the decoded value).
pub copy struct Lit {
    kind: u8,
    neg: bool,
    bits: u64
}

// An expression (`Expr`): its `ExprKind` number, span and up to five
// fields, by kind:
//   1 Literal  a = Lit
//   2 Name     a = name
//   3 Tuple    a = list of Expr
//   4 Struct   a = name, b = list of (name, Expr)
//   5 Block    a = list of Stmt, b = tail Expr or NONE
//   6 Call     a = callee, b = list of Type, c = list of Arg
//   7 Field    a = Expr, b = name
//   8 Index    a, b = Expr
//   9 Try      a = Expr
//  10 Unary    a = operator, b = Expr
//  11 Binary   a = operator, b, c = Expr
//  12 Assign   a = operator, b, c = Expr
//  13 If       a = condition, b = then, c = otherwise or NONE
//  14 Match    a = value, b = list of (Pattern, Expr)
//  15 Closure  a = list of Param, b = mode (3 for none) + 256 * infer_effects,
//              c = result Type, d = Effects, e = body
//  16 Handle   a = Effect, b = state Pattern or NONE, c = state Expr,
//              d = body, e = list of Clause (the return clause, then ops)
//  17 Loop     a = body
//  18 For      a = Pattern, b = iter, c = body
//  19 Range    a = start, b = end, c = inclusive (0 or 1)
//  20 Break    a = value or NONE
//  21 Return   a = value or NONE
//  22 Continue
pub copy struct ExprNode {
    kind: u8,
    start: u32,
    end: u32,
    a: u32,
    b: u32,
    c: u32,
    d: u32,
    e: u32
}

// A pattern (`Pattern`): 1 Wild, 2 Bind (a = name), 3 Literal (a = Lit),
// 4 Tuple (a = list of Pattern), 5 Constructor (a = name, b = list of
// (name, Pattern), c = named).
pub copy struct PatNode {
    kind: u8,
    start: u32,
    end: u32,
    a: u32,
    b: u32,
    c: u32
}

// A type (`Type`): 1 Named (a = name, b = list of Type), 2 Tuple (a = list
// of Type), 3 Function (a = list of (pass, Type), b = result Type,
// c = Effects, d = mode), 4 Row (a = Effects), 5 Infer, 6 IntLiteral (never
// built by the parser).
//
// Modes are 0 Copy, 1 Affine, 2 Linear (3 for an absent `Option[Mode]`);
// passes are 0 In, 1 Inout, 2 Sink.
pub copy struct TypeNode {
    kind: u8,
    a: u32,
    b: u32,
    c: u32,
    d: u32
}

// `Statement`: kind 1 Let (pat, ty, value, mutable) or 2 Expr (value).
pub copy struct StmtNode {
    kind: u8,
    pat: u32,
    ty: u32,
    value: u32,
    mutable: bool
}

pub copy struct ArgNode {
    pass: u8,
    explicit: bool,
    expr: u32
}

// `Clause`: a handler clause (`pats` is a list of Pattern).
pub copy struct ClauseNode {
    name: u32,
    pats: u32,
    body: u32
}

// `Param`: `projections` is a list of lists of names.
pub copy struct ParamNode {
    name: u32,
    pass: u8,
    projections: u32,
    ty: u32,
    start: u32,
    end: u32
}

// `Effects`: `instances` is a list of Effect, `tail` a name or NONE.
pub copy struct EffectsNode {
    instances: u32,
    tail: u32
}

// `Effect`: `label` a name or NONE, `args` a list of Type.
pub copy struct EffectNode {
    label: u32,
    name: u32,
    args: u32
}

pub copy struct GenericNode {
    name: u32,
    bound: u8,
    row: bool
}

// `Field`: `modality` a mode or 3, `temperature` 0 none, 1 Hot, 2 Cold.
pub copy struct FieldNode {
    name: u32,
    ty: u32,
    modality: u8,
    temperature: u8
}

pub copy struct VariantNode {
    name: u32,
    fields: u32,
    named: bool
}

// `Adt`: `tiled` says whether `tile_width` is present (`Some`); a
// separate flag, because every `u32` is a valid width.
pub copy struct AdtNode {
    name: u32,
    mode: u8,
    generics: u32,
    variants: u32,
    is_enum: bool,
    tiled: bool,
    tile_width: u32,
    start: u32,
    end: u32
}

// `Function`: `body` is an Expr or NONE.
pub copy struct FnNode {
    name: u32,
    fip: bool,
    generics: u32,
    params: u32,
    result: u32,
    effects: u32,
    body: u32,
    start: u32,
    end: u32
}

pub copy struct EffectDeclNode {
    name: u32,
    linear: bool,
    generics: u32,
    ops: u32,
    start: u32,
    end: u32
}

pub copy struct ImplNode {
    ty: u32,
    generics: u32,
    methods: u32
}

pub copy struct TraitNode {
    name: u32,
    public: bool,
    generics: u32,
    assoc: u32,
    methods: u32,
    start: u32,
    end: u32
}

pub copy struct AssocDeclNode {
    name: u32,
    bound: u8,
    start: u32,
    end: u32
}

// `TraitRef`: `package` a name or NONE.
pub copy struct TraitRefNode {
    package: u32,
    name: u32,
    args: u32,
    start: u32,
    end: u32
}

pub copy struct WhereNode {
    ty: u32,
    trait_ref: u32,
    start: u32,
    end: u32
}

pub copy struct AssocBindNode {
    name: u32,
    ty: u32,
    start: u32,
    end: u32
}

// `Conformance`: `model` is NONE for `ConformanceKind::Canonical`, else the
// model's name (with `public`).
pub copy struct ConfNode {
    model: u32,
    public: bool,
    generics: u32,
    trait_ref: u32,
    self_ty: u32,
    wheres: u32,
    assoc: u32,
    methods: u32,
    start: u32,
    end: u32
}

// `Item`: kind 1 Adt, 2 Function, 3 Effect, 4 Impl, 5 Trait,
// 6 Conformance; `node` indexes the arena of that kind.
pub copy struct ItemNode {
    kind: u8,
    node: u32
}

pub copy struct ModelUseNode {
    model: u32,
    start: u32,
    end: u32,
    scope_start: u32,
    scope_end: u32
}

pub copy struct BoundNode {
    param: u32,
    trait_ref: u32,
    start: u32,
    end: u32,
    owner: u32
}

// `UseDecl`: `package` a name or NONE, `path` a list of names, `names` a
// list of UseName.
pub copy struct UseNode {
    package: u32,
    supers: u32,
    path: u32,
    names: u32,
    public: bool,
    start: u32,
    end: u32
}

pub copy struct UseNameNode {
    name: u32,
    alias: u32,
    start: u32,
    end: u32
}

// A whole module (`vesper_core::ast::Module`) and the arenas its nodes
// live in.
pub struct Ast {
    names: Interner,
    lits: Arena[Lit],
    exprs: Arena[ExprNode],
    pats: Arena[PatNode],
    types: Arena[TypeNode],
    stmts: Arena[StmtNode],
    args: Arena[ArgNode],
    clauses: Arena[ClauseNode],
    params: Arena[ParamNode],
    effects: Arena[EffectsNode],
    effect_nodes: Arena[EffectNode],
    generics: Arena[GenericNode],
    fields: Arena[FieldNode],
    variants: Arena[VariantNode],
    adts: Arena[AdtNode],
    fns: Arena[FnNode],
    effect_decls: Arena[EffectDeclNode],
    impls: Arena[ImplNode],
    traits: Arena[TraitNode],
    assoc_decls: Arena[AssocDeclNode],
    trait_refs: Arena[TraitRefNode],
    wheres: Arena[WhereNode],
    assoc_binds: Arena[AssocBindNode],
    confs: Arena[ConfNode],
    items: Arena[ItemNode],
    model_uses: Arena[ModelUseNode],
    bounds: Arena[BoundNode],
    uses: Arena[UseNode],
    use_names: Arena[UseNameNode],
    lists: Arena[ListRef],
    pool: ChunkSeq[u32],
    // The module's top-level lists, in source order: Item, ModelUse,
    // trait bound (BoundNode), UseDecl and public item names.
    m_items: ChunkSeq[u32],
    m_model_uses: ChunkSeq[u32],
    m_bounds: ChunkSeq[u32],
    m_uses: ChunkSeq[u32],
    m_public: ChunkSeq[u32]
}

pub fn ast_new() -> Ast {
    let mut lists = arena_new[ListRef]();
    // List 0 is the empty list.
    lists
        .alloc(
        ListRef {
            first: 0,
            len: 0
        }
    );
    Ast {
        names: interner_new(),
        lits: arena_new[Lit](),
        exprs: arena_new[ExprNode](),
        pats: arena_new[PatNode](),
        types: arena_new[TypeNode](),
        stmts: arena_new[StmtNode](),
        args: arena_new[ArgNode](),
        clauses: arena_new[ClauseNode](),
        params: arena_new[ParamNode](),
        effects: arena_new[EffectsNode](),
        effect_nodes: arena_new[EffectNode](),
        generics: arena_new[GenericNode](),
        fields: arena_new[FieldNode](),
        variants: arena_new[VariantNode](),
        adts: arena_new[AdtNode](),
        fns: arena_new[FnNode](),
        effect_decls: arena_new[EffectDeclNode](),
        impls: arena_new[ImplNode](),
        traits: arena_new[TraitNode](),
        assoc_decls: arena_new[AssocDeclNode](),
        trait_refs: arena_new[TraitRefNode](),
        wheres: arena_new[WhereNode](),
        assoc_binds: arena_new[AssocBindNode](),
        confs: arena_new[ConfNode](),
        items: arena_new[ItemNode](),
        model_uses: arena_new[ModelUseNode](),
        bounds: arena_new[BoundNode](),
        uses: arena_new[UseNode](),
        use_names: arena_new[UseNameNode](),
        lists: lists,
        pool: ChunkSeq::new[u32](),
        m_items: ChunkSeq::new[u32](),
        m_model_uses: ChunkSeq::new[u32](),
        m_bounds: ChunkSeq::new[u32](),
        m_uses: ChunkSeq::new[u32](),
        m_public: ChunkSeq::new[u32]()
    }
}

// ---------------------------------------------------------------- accessors

pub fn list_len(in a: Ast, list: u32) -> u64 {
    match a.lists.get(idx_from_raw[ListRef](list)) {
        Option::Some(r) => widen_u64(r.len),
        Option::None => 0,
    }
}

// Word `i` of `list`.
pub fn list_at(in a: Ast, list: u32, i: u64) -> u32 {
    match a.lists.get(idx_from_raw[ListRef](list)) {
        Option::Some(r) => match a.pool.try_get(wrapping_add(widen_u64(r.first), i)) {
            Option::Some(v) => v,
            Option::None => none(),
        },
        Option::None => none(),
    }
}

pub fn expr_at(in a: Ast, i: u32) -> ExprNode {
    a
        .exprs
        .get_or(
        idx_from_raw[ExprNode](i),
        ExprNode {
            kind: 0,
            start: 0,
            end: 0,
            a: 0,
            b: 0,
            c: 0,
            d: 0,
            e: 0
        }
    )
}

pub fn pat_at(in a: Ast, i: u32) -> PatNode {
    a
        .pats
        .get_or(
        idx_from_raw[PatNode](i),
        PatNode {
            kind: 0,
            start: 0,
            end: 0,
            a: 0,
            b: 0,
            c: 0
        }
    )
}

pub fn type_at(in a: Ast, i: u32) -> TypeNode {
    a
        .types
        .get_or(
        idx_from_raw[TypeNode](i),
        TypeNode {
            kind: 0,
            a: 0,
            b: 0,
            c: 0,
            d: 0
        }
    )
}

pub fn lit_at(in a: Ast, i: u32) -> Lit {
    a
        .lits
        .get_or(
        idx_from_raw[Lit](i),
        Lit {
            kind: 0,
            neg: false,
            bits: 0
        }
    )
}

// The name of a Named type, else `none()` (`Type::name`'s "").
pub fn type_name(in a: Ast, t: u32) -> u32 {
    let n = type_at(in a, t);
    if n.kind == 1 {
        n.a
    } else {
        none()
    }
}

// ---------------------------------------------------------------- entries

// The canonical dump of the AST of `source` (`vesper_syntax::parser::parse`
// then `tests/self_host_ast.rs`'s dumper), packed little-endian eight
// bytes per word after two header words: the dump's byte length and the
// number of tokens the lowering consumed out of step with the front end's
// CST (0 unless the two disagree).
pub fn ast_dump(in source: Str) -> ChunkSeq[u64] {
    let l = lower_source(in source);
    let mut text = ChunkSeq::new[u8]();
    dump_ast(in l.ast, inout text);
    let n = text.len();
    let mut out = ChunkSeq::with_capacity[u64](wrapping_add(n >> 3, 3));
    out.push(n);
    out.push(l.desync);
    let mut w: u64 = 0;
    let mut k: u32 = 0;
    for i in 0..n {
        let b = match text.try_get(i) {
            Option::Some(v) => widen_u64(v),
            Option::None => 0,
        };
        w = w | wrapping_shl_u64(b, wrapping_mul(k, 8));
        k = wrapping_add(k, 1);
        if k == 8 {
            out.push(w);
            w = 0;
            k = 0;
        }
    }
    if k != 0 {
        out.push(w);
    }
    out
}

// Parses `source` to an AST and returns the number of expression, pattern
// and type nodes, for benchmarks.
pub fn ast_count(in source: Str) -> u64 {
    let l = lower_source(in source);
    wrapping_add(wrapping_add(l.ast.exprs.len(), l.ast.pats.len()), l.ast.types.len())
}

// Parses `source` to an AST and returns its row counts, for the memory
// report: the 29 arenas in field order, then the pool, the five module
// lists, the interned symbols and the interned text's bytes.
pub fn ast_rows(in source: Str) -> ChunkSeq[u64] {
    let l = lower_source(in source);
    let a = l.ast;
    let mut r = ChunkSeq::new[u64]();
    r.push(a.lits.len());
    r.push(a.exprs.len());
    r.push(a.pats.len());
    r.push(a.types.len());
    r.push(a.stmts.len());
    r.push(a.args.len());
    r.push(a.clauses.len());
    r.push(a.params.len());
    r.push(a.effects.len());
    r.push(a.effect_nodes.len());
    r.push(a.generics.len());
    r.push(a.fields.len());
    r.push(a.variants.len());
    r.push(a.adts.len());
    r.push(a.fns.len());
    r.push(a.effect_decls.len());
    r.push(a.impls.len());
    r.push(a.traits.len());
    r.push(a.assoc_decls.len());
    r.push(a.trait_refs.len());
    r.push(a.wheres.len());
    r.push(a.assoc_binds.len());
    r.push(a.confs.len());
    r.push(a.items.len());
    r.push(a.model_uses.len());
    r.push(a.bounds.len());
    r.push(a.uses.len());
    r.push(a.use_names.len());
    r.push(a.lists.len());
    r.push(a.pool.len());
    r.push(a.m_items.len());
    r.push(a.m_model_uses.len());
    r.push(a.m_bounds.len());
    r.push(a.m_uses.len());
    r.push(a.m_public.len());
    let n = a.names.len();
    r.push(n);
    let mut text: u64 = 0;
    if n > 0 {
        let (_, end) = a.names.span(symbol_from_id(wrapping_u32(wrapping_sub(n, 1))));
        text = end;
    }
    r.push(text);
    r
}
