// The checker AST crossing (front-end wiring slice 3, #1910): an `Ast`
// rebuilt from the `ast` section of the `parse_words` stream
// (crates/vesper-hybrid/modules/parse/src/lib.ves documents the layout).
// The Rust side writes that section for any `vesper_core::ast::Module`
// the checker holds (tests/common/ast_words.rs), so a Vesper port can run
// on a module a Rust pass rewrote, not only on the parse of a source.
// The words arrive as little-endian bytes, as every harness input does.

use self::{
    Ast, ast_new, Lit, ExprNode, PatNode, TypeNode, StmtNode, ArgNode, ClauseNode, ParamNode,
    EffectsNode, EffectNode, GenericNode, FieldNode, VariantNode, AdtNode, FnNode, EffectDeclNode,
    ImplNode, TraitNode, AssocDeclNode, TraitRefNode, WhereNode, AssocBindNode, ConfNode, ItemNode,
    ModelUseNode, BoundNode, UseNode, UseNameNode, ListRef
};
use self::dump::{dump_ast};

pub struct WordReader {
    pos: u64,
}

// A reader at the start of the stream.
pub fn word_reader() -> WordReader {
    WordReader { pos: 0 }
}

impl WordReader {
    pub fn word(inout self, in b: Slice[u8]) -> u64 {
        let x = match b.try_read_u64_le(self.pos) {
            Option::Some(x) => x,
            Option::None => 0,
        };
        self.pos = wrapping_add(self.pos, 8);
        x
    }
}

fn read_u32s(inout r: WordReader, in b: Slice[u8], inout s: ChunkSeq[u32]) {
    let n = r.word(in b);
    s.reserve(n);
    for i in 0..n {
        s.push(wrapping_u32(r.word(in b)));
    }
}

// The interned names: their count n, n + 1 text offsets, the text's byte
// length, then the text eight bytes per word. Symbol i is the i-th name.
fn read_names(inout r: WordReader, inout a: Ast, in b: Slice[u8]) {
    let n = r.word(in b);
    let starts = r.pos;
    r.pos = wrapping_add(starts, wrapping_mul(wrapping_add(n, 1), 8));
    let len = r.word(in b);
    let text = r.pos;
    for i in 0..n {
        let x = match b.try_read_u64_le(wrapping_add(starts, wrapping_mul(i, 8))) {
            Option::Some(v) => v,
            Option::None => 0,
        };
        let y = match b.try_read_u64_le(wrapping_add(starts, wrapping_mul(wrapping_add(i, 1), 8))) {
            Option::Some(v) => v,
            Option::None => 0,
        };
        let from = wrapping_add(text, x);
        let to = wrapping_add(text, y);
        if from <= to && to <= b.len() {
            match String::from_utf8(in b[from..to]) {
                Option::Some(t) => {
                    let _ = a.names.intern(in t.as_str());
                },
                Option::None => {
                    let _ = a.names.intern(in "");
                },
            }
        } else {
            let _ = a.names.intern(in "");
        }
    }
    r.pos = wrapping_add(text, wrapping_mul(wrapping_add(len, 7) / 8, 8));
}

fn read_lits(inout r: WordReader, inout a: Ast, in b: Slice[u8]) {
    let n = r.word(in b);
    for i in 0..n {
        let kind_ = wrapping_u8(r.word(in b));
        let neg_ = r.word(in b) != 0;
        let bits_ = r.word(in b);
        let hi_ = r.word(in b);
        let _ = a.lits.alloc(Lit { kind: kind_, neg: neg_, bits: bits_, hi: hi_ });
    }
}

fn read_exprs(inout r: WordReader, inout a: Ast, in b: Slice[u8]) {
    let n = r.word(in b);
    for i in 0..n {
        let kind_ = wrapping_u8(r.word(in b));
        let start_ = wrapping_u32(r.word(in b));
        let end_ = wrapping_u32(r.word(in b));
        let a_ = wrapping_u32(r.word(in b));
        let b_ = wrapping_u32(r.word(in b));
        let c_ = wrapping_u32(r.word(in b));
        let d_ = wrapping_u32(r.word(in b));
        let e_ = wrapping_u32(r.word(in b));
        let _ = a.exprs.alloc(ExprNode {
            kind: kind_,
            start: start_,
            end: end_,
            a: a_,
            b: b_,
            c: c_,
            d: d_,
            e: e_
        });
    }
}

fn read_pats(inout r: WordReader, inout a: Ast, in b: Slice[u8]) {
    let n = r.word(in b);
    for i in 0..n {
        let kind_ = wrapping_u8(r.word(in b));
        let start_ = wrapping_u32(r.word(in b));
        let end_ = wrapping_u32(r.word(in b));
        let a_ = wrapping_u32(r.word(in b));
        let b_ = wrapping_u32(r.word(in b));
        let c_ = wrapping_u32(r.word(in b));
        let _ = a.pats
            .alloc(PatNode { kind: kind_, start: start_, end: end_, a: a_, b: b_, c: c_ });
    }
}

fn read_types(inout r: WordReader, inout a: Ast, in b: Slice[u8]) {
    let n = r.word(in b);
    for i in 0..n {
        let kind_ = wrapping_u8(r.word(in b));
        let a_ = wrapping_u32(r.word(in b));
        let b_ = wrapping_u32(r.word(in b));
        let c_ = wrapping_u32(r.word(in b));
        let d_ = wrapping_u32(r.word(in b));
        let _ = a.types.alloc(TypeNode { kind: kind_, a: a_, b: b_, c: c_, d: d_ });
    }
}

fn read_stmts(inout r: WordReader, inout a: Ast, in b: Slice[u8]) {
    let n = r.word(in b);
    for i in 0..n {
        let kind_ = wrapping_u8(r.word(in b));
        let pat_ = wrapping_u32(r.word(in b));
        let ty_ = wrapping_u32(r.word(in b));
        let value_ = wrapping_u32(r.word(in b));
        let mutable_ = r.word(in b) != 0;
        let _ = a.stmts
            .alloc(StmtNode { kind: kind_, pat: pat_, ty: ty_, value: value_, mutable: mutable_ });
    }
}

fn read_args(inout r: WordReader, inout a: Ast, in b: Slice[u8]) {
    let n = r.word(in b);
    for i in 0..n {
        let pass_ = wrapping_u8(r.word(in b));
        let explicit_ = r.word(in b) != 0;
        let expr_ = wrapping_u32(r.word(in b));
        let _ = a.args.alloc(ArgNode { pass: pass_, explicit: explicit_, expr: expr_ });
    }
}

fn read_clauses(inout r: WordReader, inout a: Ast, in b: Slice[u8]) {
    let n = r.word(in b);
    for i in 0..n {
        let name_ = wrapping_u32(r.word(in b));
        let pats_ = wrapping_u32(r.word(in b));
        let body_ = wrapping_u32(r.word(in b));
        let _ = a.clauses.alloc(ClauseNode { name: name_, pats: pats_, body: body_ });
    }
}

fn read_params(inout r: WordReader, inout a: Ast, in b: Slice[u8]) {
    let n = r.word(in b);
    for i in 0..n {
        let name_ = wrapping_u32(r.word(in b));
        let pass_ = wrapping_u8(r.word(in b));
        let projections_ = wrapping_u32(r.word(in b));
        let ty_ = wrapping_u32(r.word(in b));
        let start_ = wrapping_u32(r.word(in b));
        let end_ = wrapping_u32(r.word(in b));
        let _ = a.params.alloc(ParamNode {
            name: name_,
            pass: pass_,
            projections: projections_,
            ty: ty_,
            start: start_,
            end: end_
        });
    }
}

fn read_effects(inout r: WordReader, inout a: Ast, in b: Slice[u8]) {
    let n = r.word(in b);
    for i in 0..n {
        let instances_ = wrapping_u32(r.word(in b));
        let tail_ = wrapping_u32(r.word(in b));
        let _ = a.effects.alloc(EffectsNode { instances: instances_, tail: tail_ });
    }
}

fn read_effect_nodes(inout r: WordReader, inout a: Ast, in b: Slice[u8]) {
    let n = r.word(in b);
    for i in 0..n {
        let label_ = wrapping_u32(r.word(in b));
        let name_ = wrapping_u32(r.word(in b));
        let args_ = wrapping_u32(r.word(in b));
        let _ = a.effect_nodes.alloc(EffectNode { label: label_, name: name_, args: args_ });
    }
}

fn read_generics(inout r: WordReader, inout a: Ast, in b: Slice[u8]) {
    let n = r.word(in b);
    for i in 0..n {
        let name_ = wrapping_u32(r.word(in b));
        let bound_ = wrapping_u8(r.word(in b));
        let row_ = r.word(in b) != 0;
        let _ = a.generics.alloc(GenericNode { name: name_, bound: bound_, row: row_ });
    }
}

fn read_fields(inout r: WordReader, inout a: Ast, in b: Slice[u8]) {
    let n = r.word(in b);
    for i in 0..n {
        let name_ = wrapping_u32(r.word(in b));
        let ty_ = wrapping_u32(r.word(in b));
        let modality_ = wrapping_u8(r.word(in b));
        let temperature_ = wrapping_u8(r.word(in b));
        let _ = a.fields.alloc(FieldNode {
            name: name_,
            ty: ty_,
            modality: modality_,
            temperature: temperature_
        });
