    let n = r.word(in b);
    for i in 0..n {
        let name_ = wrapping_u32(r.word(in b));
        let fip_ = r.word(in b) != 0;
        let generics_ = wrapping_u32(r.word(in b));
        let params_ = wrapping_u32(r.word(in b));
        let result_ = wrapping_u32(r.word(in b));
        let effects_ = wrapping_u32(r.word(in b));
        let body_ = wrapping_u32(r.word(in b));
        let start_ = wrapping_u32(r.word(in b));
        let end_ = wrapping_u32(r.word(in b));
        let _ = a.fns.alloc(FnNode {
            name: name_,
            fip: fip_,
            generics: generics_,
            params: params_,
            result: result_,
            effects: effects_,
            body: body_,
            start: start_,
            end: end_
        });
    }
}

