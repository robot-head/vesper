}

fn read_variants(inout r: WordReader, inout a: Ast, in b: Slice[u8]) {
    let n = r.word(in b);
    for i in 0..n {
        let name_ = wrapping_u32(r.word(in b));
        let fields_ = wrapping_u32(r.word(in b));
        let named_ = r.word(in b) != 0;
        let _ = a.variants.alloc(VariantNode { name: name_, fields: fields_, named: named_ });
    }
}

fn read_adts(inout r: WordReader, inout a: Ast, in b: Slice[u8]) {
    let n = r.word(in b);
    for i in 0..n {
        let name_ = wrapping_u32(r.word(in b));
        let mode_ = wrapping_u8(r.word(in b));
        let generics_ = wrapping_u32(r.word(in b));
        let variants_ = wrapping_u32(r.word(in b));
        let is_enum_ = r.word(in b) != 0;
        let tiled_ = r.word(in b) != 0;
        let tile_width_ = wrapping_u32(r.word(in b));
        let start_ = wrapping_u32(r.word(in b));
        let end_ = wrapping_u32(r.word(in b));
        let _ = a.adts.alloc(AdtNode {
            name: name_,
            mode: mode_,
            generics: generics_,
            variants: variants_,
            is_enum: is_enum_,
            tiled: tiled_,
            tile_width: tile_width_,
            start: start_,
            end: end_
        });
    }
}

