fn read_confs(inout r: WordReader, inout a: Ast, in b: Slice[u8]) {
    let n = r.word(in b);
    for i in 0..n {
        let model_ = wrapping_u32(r.word(in b));
        let public_ = r.word(in b) != 0;
        let generics_ = wrapping_u32(r.word(in b));
        let trait_ref_ = wrapping_u32(r.word(in b));
        let self_ty_ = wrapping_u32(r.word(in b));
        let wheres_ = wrapping_u32(r.word(in b));
        let assoc_ = wrapping_u32(r.word(in b));
        let methods_ = wrapping_u32(r.word(in b));
        let start_ = wrapping_u32(r.word(in b));
        let end_ = wrapping_u32(r.word(in b));
        let _ = a.confs.alloc(ConfNode {
            model: model_,
            public: public_,
            generics: generics_,
            trait_ref: trait_ref_,
            self_ty: self_ty_,
            wheres: wheres_,
            assoc: assoc_,
            methods: methods_,
            start: start_,
            end: end_
        });
    }
}

