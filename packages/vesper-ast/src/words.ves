        let start_ = wrapping_u32(r.word(in b));
        let end_ = wrapping_u32(r.word(in b));
        let a_ = wrapping_u32(r.word(in b));
        let b_ = wrapping_u32(r.word(in b));
        let c_ = wrapping_u32(r.word(in b));
        let _ = a
            .pats
            .alloc(
