    let n = r.word(in b);
    for i in 0..n {
        let kind_ = wrapping_u8(r.word(in b));
        let node_ = wrapping_u32(r.word(in b));
        let _ = a.items.alloc(ItemNode { kind: kind_, node: node_ });
    }
}

fn read_model_uses(inout r: WordReader, inout a: Ast, in b: Slice[u8]) {
    let n = r.word(in b);
    for i in 0..n {
        let model_ = wrapping_u32(r.word(in b));
        let start_ = wrapping_u32(r.word(in b));
        let end_ = wrapping_u32(r.word(in b));
        let scope_start_ = wrapping_u32(r.word(in b));
        let scope_end_ = wrapping_u32(r.word(in b));
        let _ = a.model_uses.alloc(ModelUseNode {
            model: model_,
            start: start_,
            end: end_,
            scope_start: scope_start_,
            scope_end: scope_end_
        });
    }
}

fn read_bounds(inout r: WordReader, inout a: Ast, in b: Slice[u8]) {
    let n = r.word(in b);
    for i in 0..n {
        let param_ = wrapping_u32(r.word(in b));
        let trait_ref_ = wrapping_u32(r.word(in b));
        let start_ = wrapping_u32(r.word(in b));
        let end_ = wrapping_u32(r.word(in b));
        let owner_ = wrapping_u32(r.word(in b));
        let _ = a.bounds.alloc(BoundNode {
            param: param_,
            trait_ref: trait_ref_,
            start: start_,
            end: end_,
            owner: owner_
        });
    }
}

fn read_uses(inout r: WordReader, inout a: Ast, in b: Slice[u8]) {
    let n = r.word(in b);
    for i in 0..n {
        let package_ = wrapping_u32(r.word(in b));
        let supers_ = wrapping_u32(r.word(in b));
        let path_ = wrapping_u32(r.word(in b));
        let names_ = wrapping_u32(r.word(in b));
        let public_ = r.word(in b) != 0;
        let start_ = wrapping_u32(r.word(in b));
        let end_ = wrapping_u32(r.word(in b));
        let _ = a.uses.alloc(UseNode {
            package: package_,
            supers: supers_,
            path: path_,
            names: names_,
            public: public_,
            start: start_,
            end: end_
        });
    }
}

fn read_use_names(inout r: WordReader, inout a: Ast, in b: Slice[u8]) {
    let n = r.word(in b);
    for i in 0..n {
        let name_ = wrapping_u32(r.word(in b));
        let alias_ = wrapping_u32(r.word(in b));
        let start_ = wrapping_u32(r.word(in b));
        let end_ = wrapping_u32(r.word(in b));
        let _ = a.use_names
            .alloc(UseNameNode { name: name_, alias: alias_, start: start_, end: end_ });
    }
}

fn read_lists(inout r: WordReader, inout a: Ast, in b: Slice[u8]) {
    let n = r.word(in b);
    // The stream holds every list, the empty list 0 too.
    a.lists.clear();
    for i in 0..n {
        let first_ = wrapping_u32(r.word(in b));
        let len_ = wrapping_u32(r.word(in b));
        let _ = a.lists.alloc(ListRef { first: first_, len: len_ });
    }
}

// The `Ast` of an `ast` section starting at byte `r.pos` of `b`; `r` is
// left after it.
pub fn read_ast_words(inout r: WordReader, in b: Slice[u8]) -> Ast {
    let mut a = ast_new();
    read_names(inout r, inout a, in b);
    read_lits(inout r, inout a, in b);
    read_exprs(inout r, inout a, in b);
    read_pats(inout r, inout a, in b);
    read_types(inout r, inout a, in b);
    read_stmts(inout r, inout a, in b);
    read_args(inout r, inout a, in b);
    read_clauses(inout r, inout a, in b);
    read_params(inout r, inout a, in b);
    read_effects(inout r, inout a, in b);
    read_effect_nodes(inout r, inout a, in b);
    read_generics(inout r, inout a, in b);
    read_fields(inout r, inout a, in b);
    read_variants(inout r, inout a, in b);
    read_adts(inout r, inout a, in b);
    read_fns(inout r, inout a, in b);
    read_effect_decls(inout r, inout a, in b);
    read_impls(inout r, inout a, in b);
    read_traits(inout r, inout a, in b);
    read_assoc_decls(inout r, inout a, in b);
    read_trait_refs(inout r, inout a, in b);
    read_wheres(inout r, inout a, in b);
    read_assoc_binds(inout r, inout a, in b);
    read_confs(inout r, inout a, in b);
    read_items(inout r, inout a, in b);
    read_model_uses(inout r, inout a, in b);
    read_bounds(inout r, inout a, in b);
    read_uses(inout r, inout a, in b);
    read_use_names(inout r, inout a, in b);
    read_lists(inout r, inout a, in b);
    read_u32s(inout r, in b, inout a.pool);
    read_u32s(inout r, in b, inout a.m_items);
    read_u32s(inout r, in b, inout a.m_model_uses);
    read_u32s(inout r, in b, inout a.m_bounds);
    read_u32s(inout r, in b, inout a.m_uses);
    read_u32s(inout r, in b, inout a.m_public);
    a
}

// The harness entry: the canonical dump (dump.ves) of the `Ast` that the
// `ast` section in `input` holds, in `ast_dump`'s format (the dump's byte
// length, 0 desyncs, then the dump eight bytes per word).
pub fn words_dump(in input: Str) -> ChunkSeq[u64] {
    let b = input.as_bytes();
    let mut r = WordReader { pos: 0 };
    let a = read_ast_words(inout r, in b);
    let mut text = ChunkSeq::new[u8]();
    dump_ast(in a, inout text);
    let n = text.len();
    let mut out = ChunkSeq::with_capacity[u64](wrapping_add(n >> 3, 3));
    out.push(n);
    out.push(0);
    let mut w: u64 = 0;
    let mut k: u32 = 0;
    for i in 0..n {
        let c = match text.try_get(i) {
            Option::Some(v) => widen_u64(v),
            Option::None => 0,
        };
        w = w | wrapping_shl_u64(c, wrapping_mul(k, 8));
        k = wrapping_add(k, 1);
        if k == 8 {
            out.push(w);
            w = 0;
            k = 0;
        }
    }
    if k != 0 {
        out.push(w);
    }
    out
}

// The number of expression, pattern and type rows the `ast` section in
// `input` decodes to, for benchmarks.
pub fn words_count(in input: Str) -> u64 {
    let b = input.as_bytes();
    let mut r = WordReader { pos: 0 };
    let a = read_ast_words(inout r, in b);
    wrapping_add(wrapping_add(a.exprs.len(), a.pats.len()), a.types.len())
}

// The writer: the `ast` section of the `parse_words` stream for an `Ast`,
// the inverse of `read_ast_words` (crates/vesper-hybrid/modules/parse
// writes it after the parse; the checker swaps write the module a Vesper
// pass lowered, #1976).

fn bw(b: bool) -> u64 {
    if b { 1 } else { 0 }
}

fn w(x: u32) -> u64 {
    widen_u64(x)
}

fn u32_at(in s: ChunkSeq[u32], i: u64) -> u32 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

// Bytes `from..to` of `b`, eight per word, little-endian.
fn pack(inout o: ChunkSeq[u64], in b: Slice[u8], from: u64, to: u64) {
    let mut acc: u64 = 0;
    let mut k: u32 = 0;
    for i in from..to {
        let c = match b.try_get(i) {
            Option::Some(v) => widen_u64(v),
            Option::None => 0,
        };
        acc = acc | wrapping_shl_u64(c, wrapping_mul(k, 8));
        k = wrapping_add(k, 1);
        if k == 8 {
            o.push(acc);
            acc = 0;
            k = 0;
        }
    }
    if k != 0 {
        o.push(acc);
    }
}

fn put_u32s(inout o: ChunkSeq[u64], in s: ChunkSeq[u32]) {
    let n = s.len();
    o.push(n);
    for i in 0..n {
        o.push(w(u32_at(in s, i)));
    }
}

pub fn put_ast_words(inout o: ChunkSeq[u64], in a: Ast) {
    // Names.
    let nsyms = a.names.len();
    o.push(nsyms);
    for i in 0..wrapping_add(nsyms, 1) {
        o.push(match a.names.starts.try_get(i) {
            Option::Some(v) => v,
            Option::None => 0,
        });
    }
    let text = a.names.text.as_bytes();
    o.push(text.len());
    pack(inout o, in text, 0, text.len());
    put_exprs_and_pats(inout o, in a);
    put_decls(inout o, in a);
    put_items(inout o, in a);
    put_u32s(inout o, in a.pool);
    put_u32s(inout o, in a.m_items);
    put_u32s(inout o, in a.m_model_uses);
    put_u32s(inout o, in a.m_bounds);
    put_u32s(inout o, in a.m_uses);
    put_u32s(inout o, in a.m_public);
}

fn put_exprs_and_pats(inout o: ChunkSeq[u64], in a: Ast) {
    o.push(a.lits.len());
    for k in 0..a.lits.len() {
        match a.lits.at(k) {
            Option::Some(r) => {
                o.push(widen_u64(r.kind));
                o.push(bw(r.neg));
                o.push(r.bits);
                o.push(r.hi);
            },
            Option::None => {},
        }
    }
    o.push(a.exprs.len());
    for k in 0..a.exprs.len() {
        match a.exprs.at(k) {
            Option::Some(r) => {
                o.push(widen_u64(r.kind));
                o.push(w(r.start));
                o.push(w(r.end));
                o.push(w(r.a));
                o.push(w(r.b));
                o.push(w(r.c));
                o.push(w(r.d));
                o.push(w(r.e));
            },
            Option::None => {},
        }
    }
    o.push(a.pats.len());
    for k in 0..a.pats.len() {
        match a.pats.at(k) {
            Option::Some(r) => {
                o.push(widen_u64(r.kind));
                o.push(w(r.start));
                o.push(w(r.end));
                o.push(w(r.a));
                o.push(w(r.b));
                o.push(w(r.c));
            },
            Option::None => {},
        }
    }
    o.push(a.types.len());
    for k in 0..a.types.len() {
        match a.types.at(k) {
            Option::Some(r) => {
                o.push(widen_u64(r.kind));
                o.push(w(r.a));
                o.push(w(r.b));
                o.push(w(r.c));
                o.push(w(r.d));
            },
            Option::None => {},
        }
    }
    o.push(a.stmts.len());
    for k in 0..a.stmts.len() {
        match a.stmts.at(k) {
            Option::Some(r) => {
                o.push(widen_u64(r.kind));
                o.push(w(r.pat));
                o.push(w(r.ty));
                o.push(w(r.value));
                o.push(bw(r.mutable));
            },
            Option::None => {},
        }
    }
    o.push(a.args.len());
    for k in 0..a.args.len() {
        match a.args.at(k) {
            Option::Some(r) => {
                o.push(widen_u64(r.pass));
                o.push(bw(r.explicit));
                o.push(w(r.expr));
            },
            Option::None => {},
        }
    }
    o.push(a.clauses.len());
    for k in 0..a.clauses.len() {
        match a.clauses.at(k) {
            Option::Some(r) => {
                o.push(w(r.name));
                o.push(w(r.pats));
                o.push(w(r.body));
            },
            Option::None => {},
        }
    }
    o.push(a.params.len());
    for k in 0..a.params.len() {
        match a.params.at(k) {
            Option::Some(r) => {
                o.push(w(r.name));
                o.push(widen_u64(r.pass));
                o.push(w(r.projections));
                o.push(w(r.ty));
                o.push(w(r.start));
                o.push(w(r.end));
            },
            Option::None => {},
        }
    }
    o.push(a.effects.len());
    for k in 0..a.effects.len() {
        match a.effects.at(k) {
            Option::Some(r) => {
                o.push(w(r.instances));
                o.push(w(r.tail));
            },
            Option::None => {},
        }
    }
    o.push(a.effect_nodes.len());
    for k in 0..a.effect_nodes.len() {
        match a.effect_nodes.at(k) {
            Option::Some(r) => {
                o.push(w(r.label));
                o.push(w(r.name));
                o.push(w(r.args));
            },
            Option::None => {},
        }
    }
}

fn put_decls(inout o: ChunkSeq[u64], in a: Ast) {
    o.push(a.generics.len());
    for k in 0..a.generics.len() {
        match a.generics.at(k) {
            Option::Some(r) => {
                o.push(w(r.name));
                o.push(widen_u64(r.bound));
                o.push(bw(r.row));
            },
            Option::None => {},
        }
    }
    o.push(a.fields.len());
    for k in 0..a.fields.len() {
        match a.fields.at(k) {
            Option::Some(r) => {
                o.push(w(r.name));
                o.push(w(r.ty));
                o.push(widen_u64(r.modality));
                o.push(widen_u64(r.temperature));
            },
            Option::None => {},
        }
    }
    o.push(a.variants.len());
    for k in 0..a.variants.len() {
        match a.variants.at(k) {
            Option::Some(r) => {
                o.push(w(r.name));
                o.push(w(r.fields));
                o.push(bw(r.named));
            },
            Option::None => {},
        }
    }
    o.push(a.adts.len());
    for k in 0..a.adts.len() {
        match a.adts.at(k) {
            Option::Some(r) => {
                o.push(w(r.name));
                o.push(widen_u64(r.mode));
                o.push(w(r.generics));
                o.push(w(r.variants));
                o.push(bw(r.is_enum));
                o.push(bw(r.tiled));
                o.push(w(r.tile_width));
                o.push(w(r.start));
                o.push(w(r.end));
            },
            Option::None => {},
        }
    }
    o.push(a.fns.len());
    for k in 0..a.fns.len() {
        match a.fns.at(k) {
            Option::Some(r) => {
                o.push(w(r.name));
                o.push(bw(r.fip));
                o.push(w(r.generics));
                o.push(w(r.params));
                o.push(w(r.result));
                o.push(w(r.effects));
                o.push(w(r.body));
                o.push(w(r.start));
                o.push(w(r.end));
            },
            Option::None => {},
        }
    }
    o.push(a.effect_decls.len());
    for k in 0..a.effect_decls.len() {
        match a.effect_decls.at(k) {
            Option::Some(r) => {
                o.push(w(r.name));
                o.push(bw(r.linear));
                o.push(w(r.generics));
                o.push(w(r.ops));
                o.push(w(r.start));
                o.push(w(r.end));
            },
            Option::None => {},
        }
    }
    o.push(a.impls.len());
    for k in 0..a.impls.len() {
        match a.impls.at(k) {
            Option::Some(r) => {
                o.push(w(r.ty));
                o.push(w(r.generics));
                o.push(w(r.methods));
            },
            Option::None => {},
        }
    }
    o.push(a.traits.len());
    for k in 0..a.traits.len() {
        match a.traits.at(k) {
            Option::Some(r) => {
                o.push(w(r.name));
                o.push(bw(r.public));
                o.push(w(r.generics));
                o.push(w(r.assoc));
                o.push(w(r.methods));
                o.push(w(r.start));
                o.push(w(r.end));
            },
            Option::None => {},
        }
    }
    o.push(a.assoc_decls.len());
    for k in 0..a.assoc_decls.len() {
        match a.assoc_decls.at(k) {
            Option::Some(r) => {
                o.push(w(r.name));
                o.push(widen_u64(r.bound));
                o.push(w(r.start));
                o.push(w(r.end));
            },
            Option::None => {},
        }
    }
    o.push(a.trait_refs.len());
    for k in 0..a.trait_refs.len() {
        match a.trait_refs.at(k) {
            Option::Some(r) => {
                o.push(w(r.package));
                o.push(w(r.name));
                o.push(w(r.args));
                o.push(w(r.start));
                o.push(w(r.end));
            },
            Option::None => {},
        }
    }
    o.push(a.wheres.len());
    for k in 0..a.wheres.len() {
        match a.wheres.at(k) {
            Option::Some(r) => {
                o.push(w(r.ty));
                o.push(w(r.trait_ref));
                o.push(w(r.start));
                o.push(w(r.end));
            },
            Option::None => {},
        }
    }
    o.push(a.assoc_binds.len());
    for k in 0..a.assoc_binds.len() {
        match a.assoc_binds.at(k) {
            Option::Some(r) => {
                o.push(w(r.name));
                o.push(w(r.ty));
                o.push(w(r.start));
                o.push(w(r.end));
            },
            Option::None => {},
        }
    }
    o.push(a.confs.len());
    for k in 0..a.confs.len() {
        match a.confs.at(k) {
            Option::Some(r) => {
                o.push(w(r.model));
                o.push(bw(r.public));
                o.push(w(r.generics));
                o.push(w(r.trait_ref));
                o.push(w(r.self_ty));
                o.push(w(r.wheres));
                o.push(w(r.assoc));
                o.push(w(r.methods));
                o.push(w(r.start));
                o.push(w(r.end));
            },
            Option::None => {},
        }
    }
}

fn put_items(inout o: ChunkSeq[u64], in a: Ast) {
    o.push(a.items.len());
    for k in 0..a.items.len() {
        match a.items.at(k) {
            Option::Some(r) => {
                o.push(widen_u64(r.kind));
                o.push(w(r.node));
            },
            Option::None => {},
        }
    }
    o.push(a.model_uses.len());
    for k in 0..a.model_uses.len() {
        match a.model_uses.at(k) {
            Option::Some(r) => {
                o.push(w(r.model));
                o.push(w(r.start));
                o.push(w(r.end));
                o.push(w(r.scope_start));
                o.push(w(r.scope_end));
            },
            Option::None => {},
        }
    }
    o.push(a.bounds.len());
    for k in 0..a.bounds.len() {
        match a.bounds.at(k) {
            Option::Some(r) => {
                o.push(w(r.param));
                o.push(w(r.trait_ref));
                o.push(w(r.start));
                o.push(w(r.end));
                o.push(w(r.owner));
            },
            Option::None => {},
        }
    }
    o.push(a.uses.len());
    for k in 0..a.uses.len() {
        match a.uses.at(k) {
            Option::Some(r) => {
                o.push(w(r.package));
                o.push(w(r.supers));
                o.push(w(r.path));
                o.push(w(r.names));
                o.push(bw(r.public));
                o.push(w(r.start));
                o.push(w(r.end));
            },
            Option::None => {},
        }
    }
    o.push(a.use_names.len());
    for k in 0..a.use_names.len() {
        match a.use_names.at(k) {
            Option::Some(r) => {
                o.push(w(r.name));
                o.push(w(r.alias));
                o.push(w(r.start));
                o.push(w(r.end));
            },
            Option::None => {},
        }
    }
    o.push(a.lists.len());
    for k in 0..a.lists.len() {
        match a.lists.at(k) {
            Option::Some(r) => {
                o.push(w(r.first));
                o.push(w(r.len));
            },
            Option::None => {},
        }
    }
}
