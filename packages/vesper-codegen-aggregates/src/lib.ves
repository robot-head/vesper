// @vesper/codegen-aggregates: native lowering of aggregates, patterns,
// equality, drops and fip (self-hosting SH4 lane 8, #1282).
//
// Part 1 ports the decisions of the native optimize path that read the IR
// and decide, before any emission (src/native_aggregates.rs):
//
// - `split_words` and `plain_data` / `drop_free`: per-type facts over
//   @vesper/check-layout's layouts;
// - `split_locals`: the copy-struct locals kept as word variables (#1090);
// - `plan`: where each constructed aggregate is built (#990, #1022),
//   with the window rule of `drop_unsafe_places`;
// - `split_sources`: the reads that lend their storage to a split `let`;
// - the drop decisions of src/fip.rs: what each type owns (`needs_drop`,
//   `may_need_drop`, `elem_needs_drop`, `type_contains_box`) and whether
//   it gets a drop or equality helper (`type_is_recursive`), and per graph
//   `seq_drop_plan`, `replace_drops` and `temporary_drops`;
// - `scalar_enums` (#1330): the small enum values and locals kept as
//   words (`scalar_plan`), and the graph it rewrites with them
//   (`rewrite_scalar_enums`, entry `scalar_enum_rewrite`).
//
// The input is @vesper/place-ir's (names, types, world, program section)
// and then the `World` facts check-data does not carry
// (tests/self_host_codegen_aggregates.rs `facts`). `aggregate_decisions`
// prints the decisions of every graph the way
// src/native_aggregate_decisions.rs does.
//
// Tables are dense and indexed by value id, block, local or symbol; a
// Rust map of the decision functions is one of these tables here.

use @vesper/place-ir::codes::{Lit, Op, Pat, Tag, Term};
use @vesper/check-data::pack_text;
use @vesper/check-data::util::{add, inc, n32, push_decimal, push_signed, u32_at, u64_at, u8_at, w};
use @vesper/check-data::names::{Names};
use @vesper/check-data::types::{Types, default_type, substitute, TyKind, TyPass};
use @vesper/check-data::world::{SpanRow, World, find_span, set_by_symbol, vector_words};
use @vesper/check-data::input::{Ctx, Reader, read_ctx};
use @vesper/check-layout::{Layouts, layout_of, layouts_new};
use @vesper/place-ir::{BlockRow, FnRow, InstRow, Program, put_program, read_program};

const NONE32: u32 = 4294967295;
const NONE32_64: u64 = 4294967295;
const NO_ADT: u32 = 4294967295;

const L_SCALAR: u8 = 0;
const L_PRODUCT: u8 = 1;
const L_ENUM: u8 = 2;

// Function facts, by symbol.
const FN_DEFINED: u32 = 1;
const FN_QUIET: u32 = 2;
const FN_FIP: u32 = 4;

// Symbol flags of the graph being planned.
const S_PARAM: u32 = 1;
const S_CAPTURE: u32 = 2;
const S_SINK: u32 = 4;
const S_INOUT: u32 = 8;

// Home kinds (`Home`).
const H_NONE: u8 = 0;
const H_RESULT: u8 = 1;
const H_FIELD: u8 = 2;
const H_PLACE: u8 = 3;

// `native_aggregates::MAX_DEPTH`: joins a value may pass through.
const MAX_DEPTH: u64 = 64;
// `native_aggregates::MAX_SPLIT_WORDS`.
const MAX_SPLIT_WORDS: u64 = 16;
// `native_aggregates::LOOP_WEIGHT`.
const LOOP_WEIGHT: u64 = 8;
// Layout cache entries: 0 not computed, 1 refused, else layout id + 2.
const LC_UNKNOWN: u32 = 0;
const LC_REFUSED: u32 = 1;
const LC_BASE: u32 = 2;

// ----- small helpers ----------------------------------------------------------

fn set32(inout seq: ChunkSeq[u32], i: u64, value: u32) {
    let ok = seq.try_set(i, value);
}

fn set64(inout seq: ChunkSeq[u64], i: u64, value: u64) {
    let ok = seq.try_set(i, value);
}

fn set8(inout seq: ChunkSeq[u8], i: u64, value: u8) {
    let ok = seq.try_set(i, value);
}

fn filled32(n: u64, fill: u32) -> ChunkSeq[u32] {
    let mut seq: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](n);
    seq.resize(n, fill);
    seq
}

fn filled64(n: u64, fill: u64) -> ChunkSeq[u64] {
    let mut seq: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](n);
    seq.resize(n, fill);
    seq
}

fn filled8(n: u64, fill: u8) -> ChunkSeq[u8] {
    let mut seq: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](n);
    seq.resize(n, fill);
    seq
}

fn put(inout o: ChunkSeq[u8], in text: Str) {
    o.extend(in text.as_bytes());
}

fn min64(a: u64, b: u64) -> u64 {
    if a < b { a } else { b }
}

// ----- the World facts after the program section ------------------------------

pub struct Env {
    ls: Layouts,
    // type id -> `LC_*` entry
    lcache: ChunkSeq[u32],
    // symbol -> `FN_*` bits
    fns: ChunkSeq[u32],
    // `world.element_views` spans, sorted
    views: ChunkSeq[SpanRow],
    // the free names of each program function's closure and handler bodies:
    // free[free_a[f]..free_a[f]+free_n[f]]
    free_a: ChunkSeq[u64],
    free_n: ChunkSeq[u64],
    free: ChunkSeq[u32],
    // each program function's closure instructions, in instruction order:
    // closures cl_a[f]..cl_a[f]+cl_n[f] of (lent, used names
    // cu[cua[k]..cua[k]+cun[k]])
    cl_a: ChunkSeq[u64],
    cl_n: ChunkSeq[u64],
    cl_lent: ChunkSeq[u8],
    cua: ChunkSeq[u64],
    cun: ChunkSeq[u64],
    cu: ChunkSeq[u32],
    s_eq: u32,
    s_box_box: u32,
    s_new: u32,
    s_with_capacity: u32,
    s_i128: u32,
    s_u128: u32,
    s_div: u32,
    s_rem: u32,
    s_shl: u32,
    s_shr: u32,
    s_try_get: u32,
    s_hoisted_try_get: u32,
    // decimal tuple field names "0", "1", ...
    digits: ChunkSeq[u32],
    // by ADT index: 0 not computed, 1 no wide integer, 2 wide
    wide: ChunkSeq[u8],
    // the ABI facts of `scalar_enums`, per program function: whether its
    // result travels as the words of its enum shape, and for its calls
    // cflag[ca[f]..] in instruction order, whether the callee returns the
    // words of the call's result shape
    ret: ChunkSeq[u8],
    ca: ChunkSeq[u64],
    cflag: ChunkSeq[u8],
}

fn read_text(inout reader: Reader, in bytes: Slice[u8], inout names: Names) -> u32 {
    let len = reader.word(in bytes);
    let start = reader.pos;
    let name = names.intern(in bytes[start..wrapping_add(start, len)]);
    reader.pos = wrapping_add(start, wrapping_mul(wrapping_add(len, 7) / 8, 8));
    name
}

fn read_env(inout reader: Reader, in bytes: Slice[u8], inout names: Names, functions: u64) -> Env {
    let mut e = Env {
        ls: layouts_new(),
        lcache: ChunkSeq::new[u32](),
        fns: ChunkSeq::new[u32](),
        views: ChunkSeq::new[SpanRow](),
        free_a: ChunkSeq::new[u64](),
        free_n: ChunkSeq::new[u64](),
        free: ChunkSeq::new[u32](),
        cl_a: ChunkSeq::new[u64](),
        cl_n: ChunkSeq::new[u64](),
        cl_lent: ChunkSeq::new[u8](),
        cua: ChunkSeq::new[u64](),
        cun: ChunkSeq::new[u64](),
        cu: ChunkSeq::new[u32](),
        s_eq: names.intern(in "=".as_bytes()),
        s_box_box: names.intern(in "Box::Box".as_bytes()),
        s_new: names.intern(in "New".as_bytes()),
        s_with_capacity: names.intern(in "WithCapacity".as_bytes()),
        s_i128: names.intern(in "i128".as_bytes()),
        s_u128: names.intern(in "u128".as_bytes()),
        s_div: names.intern(in "/".as_bytes()),
        s_rem: names.intern(in "%".as_bytes()),
        s_shl: names.intern(in "<<".as_bytes()),
        s_shr: names.intern(in ">>".as_bytes()),
        s_try_get: names.intern(in "TryGet".as_bytes()),
        s_hoisted_try_get: names.intern(in "Hoisted(TryGet)".as_bytes()),
        digits: ChunkSeq::new[u32](),
        wide: ChunkSeq::new[u8](),
        ret: ChunkSeq::new[u8](),
        ca: ChunkSeq::new[u64](),
        cflag: ChunkSeq::new[u8](),
    };
    let fn_count = reader.word(in bytes);
    for i in 0..fn_count {
        let name = read_text(inout reader, in bytes, inout names);
        let quiet = reader.word(in bytes);
        let fip = reader.word(in bytes);
        let mut bits = FN_DEFINED;
        if quiet != 0 {
            bits = bits | FN_QUIET;
        }
        if fip != 0 {
            bits = bits | FN_FIP;
        }
        set_by_symbol(inout e.fns, name, bits);
    }
    let view_count = reader.word(in bytes);
    for i in 0..view_count {
        let start = reader.word(in bytes);
        let end = reader.word(in bytes);
        e.views.push(SpanRow { start: start, end: end, ty: 0 });
    }
    for f in 0..functions {
        e.free_a.push(e.free.len());
        let n = reader.word(in bytes);
        e.free_n.push(n);
        for i in 0..n {
            let name = read_text(inout reader, in bytes, inout names);
            e.free.push(name);
        }
    }
    for f in 0..functions {
        e.cl_a.push(e.cl_lent.len());
        let n = reader.word(in bytes);
        e.cl_n.push(n);
        for k in 0..n {
            let lent: u8 = if reader.word(in bytes) != 0 { 1 } else { 0 };
            e.cl_lent.push(lent);
            e.cua.push(e.cu.len());
            let used_count = reader.word(in bytes);
            e.cun.push(used_count);
            for i in 0..used_count {
                let name = read_text(inout reader, in bytes, inout names);
                e.cu.push(name);
            }
        }
    }
    for f in 0..functions {
        let ret: u8 = if reader.word(in bytes) != 0 { 1 } else { 0 };
        e.ret.push(ret);
        e.ca.push(e.cflag.len());
        let n = reader.word(in bytes);
        for k in 0..n {
            let returns_words: u8 = if reader.word(in bytes) != 0 { 1 } else { 0 };
            e.cflag.push(returns_words);
        }
    }
    e
}

impl Env {
    fn fn_bits(in self, s: u32) -> u32 {
        u32_at(in self.fns, w(s))
    }

    fn is_view(in self, start: u64, end: u64) -> bool {
        find_span(in self.views, start, end) < self.views.len()
    }

    fn digit(inout self, inout names: Names, i: u64) -> u32 {
        loop {
            if self.digits.len() > i {
                break;
            }
            let mut text: ChunkSeq[u8] = ChunkSeq::new[u8]();
            push_decimal(inout text, self.digits.len());
            let name = names.intern(in text.as_slice());
            self.digits.push(name);
        }
        u32_at(in self.digits, i)
    }
}

// ----- types and layouts --------------------------------------------------------

// `Layout::of(world, ty)`: the layout id, or NONE32 when it is refused.
// Layouts are cached by type id, so each type is built once.
fn lay(inout e: Env, inout c: Ctx, ty: u32) -> u32 {
    if ty == NONE32 {
        return NONE32;
    }
    let cached = u32_at(in e.lcache, w(ty));
    if cached == LC_REFUSED {
        return NONE32;
    }
    if cached != LC_UNKNOWN {
        return wrapping_sub(cached, LC_BASE);
    }
    let layout = layout_of(inout e.ls, inout c.types, inout c.names, in c.world, ty);
    let entry = if layout == NONE32 {
        LC_REFUSED
    } else {
        wrapping_add(layout, LC_BASE)
    };
    set_by_symbol(inout e.lcache, ty, entry);
    layout
}

fn aggregate(inout e: Env, inout c: Ctx, ty: u32) -> bool {
    let layout = lay(inout e, inout c, ty);
    layout != NONE32 && e.ls.aggregate(layout)
}

fn named0(in c: Ctx, ty: u32, name: u32) -> bool {
    let node = c.types.node(ty);
    node.kind == TyKind::Named && node.n == 0 && node.name == name
}

// `strings::is_text`: `String` or `Str`.
fn is_text(in c: Ctx, ty: u32) -> bool {
    named0(in c, ty, c.world.k.string) || named0(in c, ty, c.world.k.str_)
}

// `numeric::is_integer_name`.
fn integer_name(in e: Env, in c: Ctx, name: u32) -> bool {
    c.world.k.is_integer(name) || name == e.s_i128 || name == e.s_u128
}

// `numeric::is_scalar_name`.
fn scalar_name(in e: Env, in c: Ctx, name: u32) -> bool {
    c.world.k.is_scalar(name) || name == e.s_i128 || name == e.s_u128
}

// The walk of `drop_free` (`plain` false) and `plain_data` (`plain` true)
// over layout `layout`.
fn plain_walk(in e: Env, in c: Ctx, layout: u32, plain: bool) -> bool {
    let node = e.ls.node(layout);
    if is_text(in c, node.ty) {
        return false;
    }
    if node.kind == L_SCALAR {
        let name = c.types.name(node.ty);
        if plain && name == c.world.k.f32_ {
            return false;
        }
        return scalar_name(in e, in c, name) || node.ty == c.types.unit;
    }
    if node.kind == L_PRODUCT {
        for i in 0..w(node.n) {
            let field = e.ls.lfield(add(w(node.a), i));
            if !plain_walk(in e, in c, field.layout, plain) {
                return false;
            }
        }
        return true;
    }
    for variant_index in 0..w(node.n) {
        let variant = e.ls.lvariant(add(w(node.a), variant_index));
        for i in 0..w(variant.fc) {
            let field = e.ls.lfield(add(w(variant.fa), i));
            if !plain_walk(in e, in c, field.layout, plain) {
                return false;
            }
        }
    }
    true
}

// `native_aggregates::drop_free`.
fn drop_free(inout e: Env, inout c: Ctx, ty: u32) -> bool {
    let layout = lay(inout e, inout c, ty);
    layout != NONE32 && plain_walk(in e, in c, layout, false)
}

// `native_aggregates::plain_data`.
fn plain_data(inout e: Env, inout c: Ctx, ty: u32) -> bool {
    let layout = lay(inout e, inout c, ty);
    layout != NONE32 && plain_walk(in e, in c, layout, true)
}

// ----- drop facts per type (src/fip.rs, src/native.rs) --------------------------

// `fip::is_box_type`: the built-in `Box[T]` (no handle drop plan runs here).
pub fn is_box(in c: Ctx, ty: u32) -> bool {
    let node = c.types.node(ty);
    c.world.box_active && node.kind == TyKind::Named && node.name == c.world.k.box_ && node.n == 1
}

fn arg_of(in c: Ctx, ty: u32, i: u64) -> u32 {
    c.types.arg(ty, i)
}

fn on_stack(in seen: ChunkSeq[u32], item: u32) -> bool {
    for i in 0..seen.len() {
        if u32_at(in seen, i) == item {
            return true;
        }
    }
    false
}

fn pop32(inout seen: ChunkSeq[u32]) {
    let n = seen.len();
    if n > 0 {
        seen.truncate(wrapping_sub(n, 1));
    }
}

// `dyn_trait::is_dyn_generic`: a name that starts with `__dyn__`.
fn dyn_generic_name(in c: Ctx, name: u32) -> bool {
    let size = c.names.size(name);
    if size < 7 {
        return false;
    }
    // "__dyn__"
    c.names.byte(name, 0) == 95
        && c.names.byte(name, 1) == 95
        && c.names.byte(name, 2) == 100
        && c.names.byte(name, 3) == 121
        && c.names.byte(name, 4) == 110
        && c.names.byte(name, 5) == 95
        && c.names.byte(name, 6) == 95
}

// `fip::drop_visit`: `needs_drop` (`unknown` false) and `may_need_drop`
// (`unknown` true). `seen` holds the (defaulted) types on the walk.
fn drop_visit(inout c: Ctx, ty0: u32, inout seen: ChunkSeq[u32], unknown: bool) -> bool {
    let ty = default_type(inout c.types, ty0);
    let node = c.types.node(ty);
    let known = c.world.k;
    if node.kind == TyKind::Named {
        if (node.name == known.chunk_seq && node.n == 1)
            || (node.name == known.string && node.n == 0)
        {
            return true;
        }
        if (node.name == known.dyn_ && node.n == 1)
            || (node.n == 0 && dyn_generic_name(in c, node.name))
        {
            return true;
        }
        if is_box(in c, ty)
            || (node.name == known.slice && node.n == 1)
            || (node.name == known.tiled_seq && (node.n == 1 || node.n == 2))
            || node.name == known.region_box
            || node.name == known.watermark
        {
            return false;
        }
        let adt_index = c.world.lookup(node.name);
        if adt_index == NO_ADT {
            return unknown
                && !(c.world.k.is_scalar(node.name) || is_wide_name(in c, node.name))
                && node.name != known.never
                && !is_text(in c, ty)
                && vector_words(in c.types, in c.names, known, ty) == 0;
        }
        let adt = c.world.adt(adt_index);
        if w(adt.gn) != w(node.n) {
            return unknown;
        }
        if on_stack(in seen, ty) {
            return false;
        }
        seen.push(ty);
        let vars = c.world.vars_of(in c.types, adt, ty);
        let mut found = false;
        for vi in 0..w(adt.vn) {
            let variant = c.world.variant(add(w(adt.va), vi));
            for fi in 0..w(variant.fc) {
                if !found {
                    let field = c.world.field(add(w(variant.fa), fi));
                    let field_ty = substitute(inout c.types, field.ty, in vars);
                    found = drop_visit(inout c, field_ty, inout seen, unknown);
                }
            }
        }
        pop32(inout seen);
        return found;
    }
    if node.kind == TyKind::Tuple {
        for i in 0..w(node.n) {
            if drop_visit(inout c, arg_of(in c, ty, i), inout seen, unknown) {
                return true;
            }
        }
        return false;
    }
    node.kind == TyKind::Infer && unknown
}

fn is_wide_name(in c: Ctx, name: u32) -> bool {
    let size = c.names.size(name);
    size == 4
        && (c.names.byte(name, 0) == 105 || c.names.byte(name, 0) == 117)
        && c.names.byte(name, 1) == 49
        && c.names.byte(name, 2) == 50
        && c.names.byte(name, 3) == 56
}

// `fip::needs_drop`.
fn needs_drop(inout c: Ctx, ty: u32) -> bool {
    let mut seen: ChunkSeq[u32] = ChunkSeq::new[u32]();
    drop_visit(inout c, ty, inout seen, false)
}

// `fip::may_need_drop`.
fn may_need_drop(inout c: Ctx, ty: u32) -> bool {
    let mut seen: ChunkSeq[u32] = ChunkSeq::new[u32]();
    drop_visit(inout c, ty, inout seen, true)
}

// `fip::type_contains_box`: `seen` holds the ADT names on the walk.
fn box_visit(inout c: Ctx, ty: u32, inout seen: ChunkSeq[u32]) -> bool {
    if is_box(in c, ty) {
        return true;
    }
    let node = c.types.node(ty);
    if node.kind == TyKind::Tuple {
        for i in 0..w(node.n) {
            if box_visit(inout c, arg_of(in c, ty, i), inout seen) {
                return true;
            }
        }
        return false;
    }
    if node.kind != TyKind::Named {
        return false;
    }
    for i in 0..w(node.n) {
        if box_visit(inout c, arg_of(in c, ty, i), inout seen) {
            return true;
        }
    }
    let adt_index = c.world.lookup(node.name);
    if adt_index == NO_ADT || on_stack(in seen, node.name) {
        return false;
    }
    seen.push(node.name);
    let adt = c.world.adt(adt_index);
    let vars = c.world.vars_of(in c.types, adt, ty);
    let mut found = false;
    for vi in 0..w(adt.vn) {
        let variant = c.world.variant(add(w(adt.va), vi));
        for fi in 0..w(variant.fc) {
            if !found {
                let field = c.world.field(add(w(variant.fa), fi));
                let field_ty = substitute(inout c.types, field.ty, in vars);
                found = box_visit(inout c, field_ty, inout seen);
            }
        }
    }
    pop32(inout seen);
    found
}

pub fn contains_box(inout c: Ctx, ty: u32) -> bool {
    let mut seen: ChunkSeq[u32] = ChunkSeq::new[u32]();
    box_visit(inout c, ty, inout seen)
}

// `fip::elem_needs_drop`.
fn elem_needs_drop(inout c: Ctx, ty: u32) -> bool {
    if needs_drop(inout c, ty) {
        return true;
    }
    let defaulted = default_type(inout c.types, ty);
    contains_box(inout c, defaulted)
}

// `native::type_is_recursive`: the drop and equality helpers.
fn recursive_visit(inout c: Ctx, ty0: u32, inout seen: ChunkSeq[u32]) -> bool {
    let ty = default_type(inout c.types, ty0);
    if is_box(in c, ty) {
        return recursive_visit(inout c, arg_of(in c, ty, 0), inout seen);
    }
    let node = c.types.node(ty);
    if node.kind == TyKind::Tuple {
        for i in 0..w(node.n) {
            if recursive_visit(inout c, arg_of(in c, ty, i), inout seen) {
                return true;
            }
        }
        return false;
    }
    if node.kind != TyKind::Named {
        return false;
    }
    let adt_index = c.world.lookup(node.name);
    if adt_index == NO_ADT {
        return false;
    }
    if on_stack(in seen, ty) {
        return true;
    }
    seen.push(ty);
    let adt = c.world.adt(adt_index);
    let vars = c.world.vars_of(in c.types, adt, ty);
    let mut found = false;
    for vi in 0..w(adt.vn) {
        let variant = c.world.variant(add(w(adt.va), vi));
        for fi in 0..w(variant.fc) {
            if !found {
                let field = c.world.field(add(w(variant.fa), fi));
                let field_ty = substitute(inout c.types, field.ty, in vars);
                found = recursive_visit(inout c, field_ty, inout seen);
            }
        }
    }
    pop32(inout seen);
    found
}

pub fn type_is_recursive(inout c: Ctx, ty: u32) -> bool {
    let mut seen: ChunkSeq[u32] = ChunkSeq::new[u32]();
    recursive_visit(inout c, ty, inout seen)
}

// The drop facts of `ty` as five digits (`needs_drop`, `may_need_drop`,
// `elem_needs_drop`, `type_contains_box` of the defaulted type,
// `type_is_recursive`), or false when all are 0.
fn drop_facts(inout c: Ctx, ty: u32, inout o: ChunkSeq[u8]) -> bool {
    let defaulted = default_type(inout c.types, ty);
    let nd = needs_drop(inout c, defaulted);
    let mnd = may_need_drop(inout c, defaulted);
    let en = elem_needs_drop(inout c, defaulted);
    let cb = contains_box(inout c, defaulted);
    let rec = type_is_recursive(inout c, defaulted);
    if !(nd || mnd || en || cb || rec) {
        return false;
    }
    put_flag(inout o, " nd=", nd);
    put_flag(inout o, " mnd=", mnd);
    put_flag(inout o, " en=", en);
    put_flag(inout o, " cb=", cb);
    put_flag(inout o, " rec=", rec);
    true
}

fn put_flag(inout o: ChunkSeq[u8], in label: Str, flag: bool) {
    put(inout o, label);
    if flag {
        o.push(49);
    } else {
        o.push(48);
    }
}

// `fip::mentions_box` without the `active` test.
fn mentions_box(in c: Ctx, ty: u32, depth: u64) -> bool {
    if depth > 256 {
        return false;
    }
    let node = c.types.node(ty);
    if node.kind == TyKind::Named {
        if node.name == c.world.k.box_ {
            return true;
        }
        for i in 0..w(node.n) {
            if mentions_box(in c, u32_at(in c.types.items, add(w(node.a), i)), inc(depth)) {
                return true;
            }
        }
        return false;
    }
    if node.kind == TyKind::Tuple {
        for i in 0..w(node.n) {
            if mentions_box(in c, u32_at(in c.types.items, add(w(node.a), i)), inc(depth)) {
                return true;
            }
        }
        return false;
    }
    if node.kind == TyKind::Fn {
        for i in 0..w(node.n) {
            if mentions_box(in c, u32_at(in c.types.items, add(w(node.a), i)), inc(depth)) {
                return true;
            }
        }
        if mentions_box(in c, node.r, inc(depth)) {
            return true;
        }
        return row_mentions_box(in c, node.r2, depth);
    }
    if node.kind == TyKind::Row {
        return row_mentions_box(in c, node.r2, depth);
    }
    false
}

fn row_mentions_box(in c: Ctx, row_id: u32, depth: u64) -> bool {
    let row = c.types.row(row_id);
    for i in 0..w(row.n) {
        let effect = c.types.effect_at(add(w(row.a), i));
        for j in 0..w(effect.n) {
            if mentions_box(in c, u32_at(in c.types.items, add(w(effect.a), j)), inc(depth)) {
                return true;
            }
        }
    }
    false
}

// Whether `ty` mentions `i128` or `u128`, through type arguments, tuple
// and function components and ADT fields. @vesper/check-layout has no
// 16-byte scalars yet (gap 1 of the report), so a graph that mentions one
// is reported `wide` and left to Rust; the scan over-approximates (it
// walks every field of every ADT named, whatever its arguments).
fn mentions_wide(inout e: Env, in c: Ctx, ty: u32, depth: u64) -> bool {
    if depth > 256 || ty == NONE32 {
        return false;
    }
    let node = c.types.node(ty);
    if node.kind == TyKind::Named {
        if node.name == e.s_i128 || node.name == e.s_u128 {
            return true;
        }
        for i in 0..w(node.n) {
            if mentions_wide(
                inout e,
                in c,
                u32_at(in c.types.items, add(w(node.a), i)),
                inc(depth)
            ) {
                return true;
            }
        }
        let adt_index = c.world.lookup(node.name);
        if adt_index == NO_ADT {
            return false;
        }
        let memo = u8_at(in e.wide, w(adt_index));
        if memo != 0 {
            return memo == 2;
        }
        // Mark it first, so a recursive ADT ends the walk.
        loop {
            if e.wide.len() > w(adt_index) {
                break;
            }
            e.wide.push(0);
        }
        set8(inout e.wide, w(adt_index), 1);
        let adt = c.world.adt(adt_index);
        let mut found = false;
        for variant_index in 0..w(adt.vn) {
            let variant = c.world.variant(add(w(adt.va), variant_index));
            for i in 0..w(variant.fc) {
                let field = c.world.field(add(w(variant.fa), i));
                if !found && mentions_wide(inout e, in c, field.ty, inc(depth)) {
                    found = true;
                }
            }
        }
        if found {
            set8(inout e.wide, w(adt_index), 2);
        }
        return found;
    }
    if node.kind == TyKind::Tuple || node.kind == TyKind::Fn {
        for i in 0..w(node.n) {
            if mentions_wide(
                inout e,
                in c,
                u32_at(in c.types.items, add(w(node.a), i)),
                inc(depth)
            ) {
                return true;
            }
        }
        if node.kind == TyKind::Fn {
            return mentions_wide(inout e, in c, node.r, inc(depth));
        }
    }
    false
}

// Whether graph `g` mentions a wide integer in a value or local type.
fn graph_wide(inout e: Env, in c: Ctx, in g: G) -> bool {
    for v in 0..g.nv {
        if mentions_wide(inout e, in c, u32_at(in g.vty, v), 0) {
            return true;
        }
    }
    for i in 0..g.lty.len() {
        if mentions_wide(inout e, in c, u32_at(in g.lty, i), 0) {
            return true;
        }
    }
    false
}

// The leaves `split_words` collects: path syms[a..a+n], byte offset.
pub struct Leaves {
    pa: ChunkSeq[u64],
    pn: ChunkSeq[u64],
    offset: ChunkSeq[u64],
    syms: ChunkSeq[u32],
    stack: ChunkSeq[u32],
}

fn leaves_new() -> Leaves {
    Leaves {
        pa: ChunkSeq::new[u64](),
        pn: ChunkSeq::new[u64](),
        offset: ChunkSeq::new[u64](),
        syms: ChunkSeq::new[u32](),
        stack: ChunkSeq::new[u32](),
    }
}

// `split_words`' `product`: a struct or tuple the split may enter.
fn product_type(in c: Ctx, ty: u32) -> bool {
    let node = c.types.node(ty);
    let known = c.world.k;
    let shaped = node.kind == TyKind::Tuple
        || (node.kind == TyKind::Named && c.world.lookup(node.name) != NO_ADT);
    shaped
        && !(node.kind == TyKind::Named && node.name == known.slice && node.n == 1)
        && !(node.kind == TyKind::Named && node.name == known.dyn_ && node.n == 1)
        && !is_text(in c, ty)
        && vector_words(in c.types, in c.names, known, ty) == 0
}

fn split_walk(inout e: Env, inout c: Ctx, layout: u32, base: i64, inout out: Leaves) -> bool {
    let node = e.ls.node(layout);
    if node.kind == L_SCALAR {
        let ty = default_type(inout c.types, node.ty);
        let ty_node = c.types.node(ty);
        let known = c.world.k;
        let word = ty_node.kind == TyKind::Named
            && ty_node.n == 0
            && (integer_name(in e, in c, ty_node.name)
                || ty_node.name == known.f32_
                || ty_node.name == known.f64_
                || ty_node.name == known.bool_);
        if word {
            out.pa.push(out.syms.len());
            out.pn.push(out.stack.len());
            for i in 0..out.stack.len() {
                let sym = u32_at(in out.stack, i);
                out.syms.push(sym);
            }
            out.offset.push(wrapping_u64(base));
        }
        return word;
    }
    if node.kind == L_PRODUCT {
        if !product_type(in c, node.ty) {
            return false;
        }
        for i in 0..w(node.n) {
            let field = e.ls.lfield(add(w(node.a), i));
            out.stack.push(field.name);
            let ok = split_walk(
                inout e,
                inout c,
                field.layout,
                wrapping_add(base, widen_i64(field.offset)),
                inout out
            );
            let depth = wrapping_sub(out.stack.len(), 1);
            out.stack.truncate(depth);
            if !ok {
                return false;
            }
        }
        return true;
    }
    false
}

// `split_words`: the scalar words of `ty` into `out` (which starts
// empty), or false when `ty` may not be split.
fn split_words(inout e: Env, inout c: Ctx, ty: u32, inout out: Leaves) -> bool {
    let layout = lay(inout e, inout c, ty);
    if layout == NONE32 {
        return false;
    }
    let node = e.ls.node(layout);
    if node.kind != L_PRODUCT {
        return false;
    }
    split_walk(inout e, inout c, layout, 0, inout out)
        && out.pa.len() > 0
        && out.pa.len() <= MAX_SPLIT_WORDS
}

// The symbol after the last "::" of `name` (`name.rsplit("::").next()`).
fn short_name(inout names: Names, name: u32) -> u32 {
    let n = names.size(name);
    let mut cut: u64 = 0;
    let mut i: u64 = 1;
    loop {
        if i >= n {
            break;
        }
        if names.byte(name, i) == 58 && names.byte(name, wrapping_sub(i, 1)) == 58 {
            cut = inc(i);
        }
        i = inc(i);
    }
    if cut == 0 {
        return name;
    }
    let mut text: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for j in cut..n {
        text.push(names.byte(name, j));
    }
    names.intern(in text.as_slice())
}

// A field of a layout: its type (defaulted) and offset; `ty` NONE32 when
// there is none.
pub copy struct FieldAt {
    ty: u32,
    offset: i32,
}

const NO_FIELD: FieldAt = FieldAt { ty: NONE32, offset: 0 };

// `field_type` / `field_home`: field `field` of `ty`, of variant `variant`
// (NONE32 for none) for an enum.
fn field_at(inout e: Env, inout c: Ctx, ty: u32, variant: u32, field: u32) -> FieldAt {
    let layout = lay(inout e, inout c, ty);
    if layout == NONE32 {
        return NO_FIELD;
    }
    let node = e.ls.node(layout);
    let mut field_start: u64 = 0;
    let mut field_count: u64 = 0;
    if node.kind == L_PRODUCT {
        field_start = w(node.a);
        field_count = w(node.n);
    } else if node.kind == L_ENUM && variant != NONE32 {
        let short = short_name(inout c.names, variant);
        let mut found = false;
        for variant_index in 0..w(node.n) {
            let layout_variant = e.ls.lvariant(add(w(node.a), variant_index));
            if !found && layout_variant.name == short {
                field_start = w(layout_variant.fa);
                field_count = w(layout_variant.fc);
                found = true;
            }
        }
        if !found {
            return NO_FIELD;
        }
    } else {
        return NO_FIELD;
    }
    for i in 0..field_count {
        let layout_field = e.ls.lfield(add(field_start, i));
        if layout_field.name == field {
            let field_ty = default_type(inout c.types, layout_field.ty);
            return FieldAt { ty: field_ty, offset: layout_field.offset };
        }
    }
    NO_FIELD
}

// ----- one graph's tables -----------------------------------------------------

pub copy struct Home {
    kind: u8,
    // field: parent value; place: place symbol
    a: u64,
    // field: offset (two's complement); place: block
    b: u64,
    // field: parent type; place: instruction index
    c: u64,
}

const NO_HOME: Home = Home { kind: H_NONE, a: 0, b: 0, c: 0 };

fn same_home(x: Home, y: Home) -> bool {
    x.kind == y.kind && x.a == y.a && x.b == y.b && x.c == y.c
}

pub struct G {
    fi: u64,
    name: u32,
    b0: u64,
    nb: u64,
    // global index of the graph's first instruction
    i0: u64,
    ni: u64,
    result: u32,
    nested: bool,
    nv: u64,
    // by value id
    vty: ChunkSeq[u32],
    uses: ChunkSeq[u32],
    def_b: ChunkSeq[u32],
    def_i: ChunkSeq[u32],
    param_b: ChunkSeq[u32],
    // by graph instruction: its operand values opv[oa..oa+on]
    oa: ChunkSeq[u64],
    on: ChunkSeq[u64],
    opv: ChunkSeq[u32],
    // by block: its terminator operands tv[ta..ta+tn], params, preds
    ta: ChunkSeq[u64],
    tn: ChunkSeq[u64],
    tv: ChunkSeq[u32],
    pa: ChunkSeq[u64],
    pn: ChunkSeq[u64],
    params: ChunkSeq[u32],
    qa: ChunkSeq[u64],
    qn: ChunkSeq[u64],
    preds: ChunkSeq[u32],
    only_jumps: ChunkSeq[u8],
    cyclic: ChunkSeq[u8],
    // locals, in name order
    lsym: ChunkSeq[u32],
    lty: ChunkSeq[u32],
    mentions: ChunkSeq[u64],
    split: ChunkSeq[u8],
    // homes, by value id
    hk: ChunkSeq[u8],
    ha: ChunkSeq[u64],
    hb: ChunkSeq[u64],
    hc: ChunkSeq[u64],
}

// Symbol-indexed tables shared by every graph; each graph resets the
// entries it set.
pub struct Syms {
    // local index + 1
    local: ChunkSeq[u32],
    // `S_*` bits
    flags: ChunkSeq[u32],
    touched: ChunkSeq[u32],
}

fn syms_new() -> Syms {
    Syms {
        local: ChunkSeq::new[u32](),
        flags: ChunkSeq::new[u32](),
        touched: ChunkSeq::new[u32](),
    }
}

impl Syms {
    fn local_of(in self, sym: u32) -> u64 {
        let entry = u32_at(in self.local, w(sym));
        if entry == 0 {
            NONE32_64
        } else {
            w(wrapping_sub(entry, 1))
        }
    }

    fn has(in self, sym: u32, bit: u32) -> bool {
        (u32_at(in self.flags, w(sym)) & bit) != 0
    }

    fn set_local(inout self, sym: u32, i: u64) {
        set_by_symbol(inout self.local, sym, wrapping_add(n32(i), 1));
        self.touched.push(sym);
    }

    fn flag(inout self, sym: u32, bit: u32) {
        let old = u32_at(in self.flags, w(sym));
        set_by_symbol(inout self.flags, sym, old | bit);
        self.touched.push(sym);
    }

    fn reset(inout self) {
        for i in 0..self.touched.len() {
            let sym = u32_at(in self.touched, i);
            set32(inout self.local, w(sym), 0);
            set32(inout self.flags, w(sym), 0);
        }
        self.touched.clear();
    }
}

impl G {
    fn value_type(in self, v: u32) -> u32 {
        if w(v) >= self.nv {
            NONE32
        } else {
            u32_at(in self.vty, w(v))
        }
    }

    fn uses_of(in self, v: u32) -> u32 {
        u32_at(in self.uses, w(v))
    }

    fn def_block(in self, v: u32) -> u32 {
        if w(v) >= self.nv {
            NONE32
        } else {
            u32_at(in self.def_b, w(v))
        }
    }

    fn param_block(in self, v: u32) -> u32 {
        if w(v) >= self.nv {
            NONE32
        } else {
            u32_at(in self.param_b, w(v))
        }
    }

    // Whether graph instruction `k` reads value `v` (`ir_inline::operands`).
    fn reads(in self, k: u64, v: u32) -> bool {
        let start = u64_at(in self.oa, k);
        let n = u64_at(in self.on, k);
        for i in 0..n {
            if u32_at(in self.opv, add(start, i)) == v {
                return true;
            }
        }
        false
    }

    fn home(in self, v: u32) -> Home {
        Home {
            kind: u8_at(in self.hk, w(v)),
            a: u64_at(in self.ha, w(v)),
            b: u64_at(in self.hb, w(v)),
            c: u64_at(in self.hc, w(v))
        }
    }

    fn set_home(inout self, v: u32, home: Home) {
        set8(inout self.hk, w(v), home.kind);
        set64(inout self.ha, w(v), home.a);
        set64(inout self.hb, w(v), home.b);
        set64(inout self.hc, w(v), home.c);
    }

    fn home_count(in self) -> u64 {
        let mut n: u64 = 0;
        for v in 0..self.nv {
            if u8_at(in self.hk, v) != H_NONE {
                n = inc(n);
            }
        }
        n
    }

    fn param(in self, b: u64, position: u64) -> u32 {
        if position >= u64_at(in self.pn, b) {
            NONE32
        } else {
            u32_at(in self.params, add(u64_at(in self.pa, b), position))
        }
    }

    fn is_local(in self, in syms: Syms, sym: u32) -> bool {
        syms.local_of(sym) != NONE32_64
    }

    fn split_local(in self, in syms: Syms, sym: u32) -> bool {
        let li = syms.local_of(sym);
        li != NONE32_64 && u8_at(in self.split, li) != 0
    }
}

// ----- reading a graph --------------------------------------------------------

// The end of the pattern at word `pattern`.
fn pattern_end(in p: Program, pattern: u64) -> u64 {
    let kind = p.op(pattern);
    let body = add(pattern, 3);
    if kind == Pat::Bind {
        return inc(body);
    }
    if kind == Pat::Literal {
        return add(body, 3);
    }
    if kind == Pat::Tuple {
        let n = p.op(body);
        let mut at = inc(body);
        for i in 0..n {
            at = pattern_end(in p, at);
        }
        return at;
    }
    if kind == Pat::Constructor {
        let n = p.op(add(body, 2));
        let mut at = add(body, 3);
        for i in 0..n {
            at = pattern_end(in p, inc(at));
        }
        return at;
    }
    body
}

// The names the pattern at word `pattern` binds, appended to `out`.
fn pattern_binds(in p: Program, pattern: u64, inout out: ChunkSeq[u32]) {
    let kind = p.op(pattern);
    let body = add(pattern, 3);
    if kind == Pat::Bind {
        out.push(n32(p.op(body)));
    } else if kind == Pat::Tuple {
        let n = p.op(body);
        let mut at = inc(body);
        for i in 0..n {
            pattern_binds(in p, at, inout out);
            at = pattern_end(in p, at);
        }
    } else if kind == Pat::Constructor {
        let n = p.op(add(body, 2));
        let mut at = add(body, 3);
        for i in 0..n {
            pattern_binds(in p, inc(at), inout out);
            at = pattern_end(in p, inc(at));
        }
    }
}

// The operand word positions of an instruction's argument list at `list_at`
// (count, then 4 words per argument: pass, value, place root, path).
fn arg_count(in p: Program, list_at: u64) -> u64 {
    p.op(list_at)
}

fn arg_word(list_at: u64, j: u64, slot: u64) -> u64 {
    add(add(inc(list_at), wrapping_mul(j, 4)), slot)
}

// Where an instruction's argument list starts, or NONE when it has none.
fn args_at(op: u8, operands: u64) -> u64 {
    if op == Op::Call || op == Op::Indirect || op == Op::Tiled || op == Op::Seq || op == Op::Fip {
        inc(operands)
    } else {
        18446744073709551615
    }
}

// `ir_inline::operands` of the instruction at global index `ii`.
fn push_operands(in p: Program, ii: u64, inout out: ChunkSeq[u32]) {
    let inst = p.inst(ii);
    let operands = inst.a;
    let op = inst.op;
    if op == Op::Handle {
        if p.op(operands) != 0 {
            out.push(n32(p.op(inc(operands))));
        }
    } else if op == Op::Bind || op == Op::Exit || op == Op::Project || op == Op::Try {
        out.push(n32(p.op(operands)));
    } else if op == Op::Write {
        out.push(n32(p.op(add(operands, 2))));
    } else if op == Op::Unary {
        out.push(n32(p.op(inc(operands))));
    } else if op == Op::Binary {
        out.push(n32(p.op(inc(operands))));
        out.push(n32(p.op(add(operands, 2))));
    } else if op == Op::Index {
        out.push(n32(p.op(operands)));
        out.push(n32(p.op(inc(operands))));
    } else if op == Op::Tuple {
        let n = p.op(operands);
        for i in 0..n {
            out.push(n32(p.op(add(inc(operands), i))));
        }
    } else if op == Op::Vector {
        let n = p.op(inc(operands));
        for i in 0..n {
            out.push(n32(p.op(add(add(operands, 2), i))));
        }
    } else if op == Op::Data {
        let n = p.op(inc(operands));
        for i in 0..n {
            out.push(n32(p.op(add(add(operands, 3), wrapping_mul(i, 2)))));
        }
    } else if op == Op::Call || op == Op::Tiled || op == Op::Seq || op == Op::Fip {
        let at = inc(operands);
        for j in 0..arg_count(in p, at) {
            out.push(n32(p.op(arg_word(at, j, 1))));
        }
    } else if op == Op::Indirect {
        let at = inc(operands);
        for j in 0..arg_count(in p, at) {
            out.push(n32(p.op(arg_word(at, j, 1))));
        }
        out.push(n32(p.op(operands)));
    }
}

// The block's parameter values: after the entry token, the incoming
// tokens and the outgoing token.
fn block_params_at(in p: Program, header_at: u64) -> u64 {
    let incoming_count = p.op(inc(header_at));
    add(add(header_at, 2), add(wrapping_mul(incoming_count, 2), 1))
}

fn successors(in p: Program, bi: u64, inout out: ChunkSeq[u32]) {
    let blk = p.block(bi);
    let term_at = blk.ta;
    if blk.term == Term::Jump {
        out.push(n32(p.op(term_at)));
    } else if blk.term == Term::Branch {
        out.push(n32(p.op(inc(term_at))));
        out.push(n32(p.op(add(term_at, 2))));
    } else if blk.term == Term::Match {
        let n = p.op(inc(term_at));
        let mut at = add(term_at, 2);
        for i in 0..n {
            at = pattern_end(in p, at);
            out.push(n32(p.op(at)));
            at = inc(at);
        }
    }
}

// The graph of function `fi`, with its locals in `syms`.
fn graph_of(in p: Program, inout c: Ctx, inout syms: Syms, fi: u64) -> G {
    let func = p.function(fi);
    let first = p.block(func.b0);
    let last = p.block(add(func.b0, wrapping_sub(func.bc, 1)));
    let i0 = first.i0;
    let ni = if func.bc == 0 {
        0
    } else {
        wrapping_sub(add(last.i0, last.ic), i0)
    };
    // The header: params, result, effects, bounds, captures, values,
    // locals (ir_words.rs).
    let mut at = func.ha;
    let param_count = p.op(at);
    at = inc(at);
    for i in 0..param_count {
        syms.flag(n32(p.op(at)), S_PARAM);
        if p.op(inc(at)) == TyPass::Sink {
            syms.flag(n32(p.op(at)), S_SINK);
        } else if p.op(inc(at)) == TyPass::Inout {
            syms.flag(n32(p.op(at)), S_INOUT);
        }
        let k = p.op(add(at, 2));
        at = add(at, add(6, k));
    }
    let result = default_type(inout c.types, n32(p.op(at)));
    at = add(at, 2);
    let nbounds = p.op(at);
    at = add(inc(at), wrapping_mul(nbounds, 2));
    let ncap = p.op(at);
    at = inc(at);
    for i in 0..ncap {
        syms.flag(n32(p.op(at)), S_CAPTURE);
        at = inc(at);
    }
    let nvals = p.op(at);
    let values_at = inc(at);
    at = add(values_at, wrapping_mul(nvals, 2));
    let nlocals = p.op(at);
    let locals_at = inc(at);
    // The largest value id.
    let mut top: u64 = 0;
    for i in 0..nvals {
        let v = p.op(add(values_at, wrapping_mul(i, 2)));
        if v > top {
            top = v;
        }
    }
    let mut ops: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut oa: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](ni);
    let mut on: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](ni);
    for k in 0..ni {
        let ii = add(i0, k);
        let start = ops.len();
        push_operands(in p, ii, inout ops);
        oa.push(start);
        on.push(wrapping_sub(ops.len(), start));
        let dest = w(p.inst(ii).dest);
        if dest > top {
            top = dest;
        }
    }
    for i in 0..ops.len() {
        let v = w(u32_at(in ops, i));
        if v > top {
            top = v;
        }
    }
    let mut tv: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut ta: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut tn: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut params: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut pa: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut pn: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for b in 0..func.bc {
        let blk = p.block(add(func.b0, b));
        let start = tv.len();
        let term_at = blk.ta;
        if blk.term == Term::Return || blk.term == Term::Branch || blk.term == Term::Match {
            tv.push(n32(p.op(term_at)));
        } else if blk.term == Term::Jump {
            let n = p.op(inc(term_at));
            for i in 0..n {
                tv.push(n32(p.op(add(add(term_at, 2), i))));
            }
        }
        ta.push(start);
        tn.push(wrapping_sub(tv.len(), start));
        let params_at = block_params_at(in p, blk.ha);
        let n = p.op(params_at);
        pa.push(params.len());
        pn.push(n);
        for i in 0..n {
            let v = p.op(add(inc(params_at), i));
            params.push(n32(v));
            if v > top {
                top = v;
            }
        }
    }
    for i in 0..tv.len() {
        let v = w(u32_at(in tv, i));
        if v > top {
            top = v;
        }
    }
    let nv = inc(top);
    let mut g = G {
        fi: fi,
        name: func.name,
        b0: func.b0,
        nb: func.bc,
        i0: i0,
        ni: ni,
        result: result,
        nested: false,
        nv: nv,
        vty: filled32(nv, NONE32),
        uses: filled32(nv, 0),
        def_b: filled32(nv, NONE32),
        def_i: filled32(nv, NONE32),
        param_b: filled32(nv, NONE32),
        oa: oa,
        on: on,
        opv: ops,
        ta: ta,
        tn: tn,
        tv: tv,
        pa: pa,
        pn: pn,
        params: params,
        qa: ChunkSeq::new[u64](),
        qn: ChunkSeq::new[u64](),
        preds: ChunkSeq::new[u32](),
        only_jumps: filled8(func.bc, 1),
        cyclic: filled8(func.bc, 0),
        lsym: ChunkSeq::new[u32](),
        lty: ChunkSeq::new[u32](),
        mentions: filled64(nlocals, 0),
        split: filled8(nlocals, 0),
        hk: filled8(nv, H_NONE),
        ha: filled64(nv, 0),
        hb: filled64(nv, 0),
        hc: filled64(nv, 0),
    };
    for i in 0..nvals {
        let v = p.op(add(values_at, wrapping_mul(i, 2)));
        let value_ty = n32(p.op(add(inc(values_at), wrapping_mul(i, 2))));
        set32(inout g.vty, v, value_ty);
    }
    for i in 0..nlocals {
        let sym = n32(p.op(add(locals_at, wrapping_mul(i, 2))));
        g.lsym.push(sym);
        g.lty.push(n32(p.op(add(inc(locals_at), wrapping_mul(i, 2)))));
        syms.set_local(sym, i);
    }
    for i in 0..g.opv.len() {
        let v = w(u32_at(in g.opv, i));
        set32(inout g.uses, v, wrapping_add(u32_at(in g.uses, v), 1));
    }
    for i in 0..g.tv.len() {
        let v = w(u32_at(in g.tv, i));
        set32(inout g.uses, v, wrapping_add(u32_at(in g.uses, v), 1));
    }
    // Definitions and block parameters.
    for b in 0..func.bc {
        let blk = p.block(add(func.b0, b));
        for k in 0..blk.ic {
            let dest = w(p.inst(add(blk.i0, k)).dest);
            set32(inout g.def_b, dest, n32(b));
            set32(inout g.def_i, dest, n32(k));
        }
        for k in 0..u64_at(in g.pn, b) {
            let v = w(g.param(b, k));
            set32(inout g.param_b, v, n32(b));
        }
    }
    // Predecessors, in block order (an edge per target occurrence).
    let mut succ: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut succ_start: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut count: ChunkSeq[u64] = filled64(func.bc, 0);
    for b in 0..func.bc {
        succ_start.push(succ.len());
        let before = succ.len();
        successors(in p, add(func.b0, b), inout succ);
        let jump = p.block(add(func.b0, b)).term == Term::Jump;
        for i in before..succ.len() {
            let target = w(u32_at(in succ, i));
            set64(inout count, target, inc(u64_at(in count, target)));
            if !jump {
                set8(inout g.only_jumps, target, 0);
            }
        }
    }
    succ_start.push(succ.len());
    let mut fill: ChunkSeq[u64] = filled64(func.bc, 0);
    let mut total: u64 = 0;
    for b in 0..func.bc {
        g.qa.push(total);
        g.qn.push(u64_at(in count, b));
        total = add(total, u64_at(in count, b));
    }
    g.preds.resize(total, 0);
    for b in 0..func.bc {
        for i in u64_at(in succ_start, b)..u64_at(in succ_start, inc(b)) {
            let target = w(u32_at(in succ, i));
            let pred_slot = add(u64_at(in g.qa, target), u64_at(in fill, target));
            set32(inout g.preds, pred_slot, n32(b));
            set64(inout fill, target, inc(u64_at(in fill, target)));
        }
    }
    // Blocks on a cycle: a block reachable from one of its successors.
    let mut seen: ChunkSeq[u8] = filled8(func.bc, 0);
    let mut stack: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for b in 0..func.bc {
        for i in 0..func.bc {
            set8(inout seen, i, 0);
        }
        stack.clear();
        for i in u64_at(in succ_start, b)..u64_at(in succ_start, inc(b)) {
            stack.push(u32_at(in succ, i));
        }
        let mut on_cycle = false;
        loop {
            let n = stack.len();
            if n == 0 || on_cycle {
                break;
            }
            let reached = w(u32_at(in stack, wrapping_sub(n, 1)));
            stack.truncate(wrapping_sub(n, 1));
            if reached == b {
                on_cycle = true;
            } else if u8_at(in seen, reached) == 0 {
                set8(inout seen, reached, 1);
                for i in u64_at(in succ_start, reached)..u64_at(in succ_start, inc(reached)) {
                    stack.push(u32_at(in succ, i));
                }
            }
        }
        if on_cycle {
            set8(inout g.cyclic, b, 1);
        }
    }
    g
}

// ----- names of places -------------------------------------------------------

// The components of the dotted place name `place` (`place.split('.')`).
fn place_parts(inout names: Names, place: u32, inout out: ChunkSeq[u32]) {
    let n = names.size(place);
    let mut text: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for i in 0..n {
        let byte = names.byte(place, i);
        if byte == 46 {
            let part = names.intern(in text.as_slice());
            out.push(part);
            text.clear();
        } else {
            text.push(byte);
        }
    }
    let part = names.intern(in text.as_slice());
    out.push(part);
}

fn place_root(inout names: Names, place: u32) -> u32 {
    let mut parts: ChunkSeq[u32] = ChunkSeq::new[u32]();
    place_parts(inout names, place, inout parts);
    u32_at(in parts, 0)
}

fn has_dot(in names: Names, place: u32) -> bool {
    for i in 0..names.size(place) {
        if names.byte(place, i) == 46 {
            return true;
        }
    }
    false
}

// ----- plan --------------------------------------------------------------------

// The defaulted type of value `v`, or NONE32.
fn vtype(in g: G, inout c: Ctx, v: u32) -> u32 {
    let ty = g.value_type(v);
    if ty == NONE32 {
        NONE32
    } else {
        default_type(inout c.types, ty)
    }
}

// `Graph::candidate` of the instruction at global index `ii`.
fn candidate(in p: Program, in e: Env, ii: u64) -> bool {
    let inst = p.inst(ii);
    if inst.op == Op::Data || inst.op == Op::Tuple {
        return true;
    }
    inst.op == Op::Call && (e.fn_bits(n32(p.op(inst.a))) & FN_DEFINED) != 0
}

// `Graph::candidate` of the definition of value `v`.
fn def_candidate(in p: Program, in e: Env, in g: G, v: u32) -> bool {
    let block = g.def_block(v);
    if block == NONE32 {
        return false;
    }
    let blk = p.block(add(g.b0, w(block)));
    candidate(in p, in e, add(blk.i0, w(u32_at(in g.def_i, w(v)))))
}

// `Graph::place_type`.
fn place_type(inout e: Env, inout c: Ctx, in g: G, in syms: Syms, place: u32) -> u32 {
    let mut parts: ChunkSeq[u32] = ChunkSeq::new[u32]();
    place_parts(inout c.names, place, inout parts);
    let li = syms.local_of(u32_at(in parts, 0));
    if li == NONE32_64 {
        return NONE32;
    }
    let mut ty = default_type(inout c.types, u32_at(in g.lty, li));
    for i in 1..parts.len() {
        let layout = lay(inout e, inout c, ty);
        if layout == NONE32 || e.ls.node(layout).kind != L_PRODUCT {
            return NONE32;
        }
        let field_index = e.ls.field_named(layout, u32_at(in parts, i));
        if field_index == NONE32 {
            return NONE32;
        }
        ty = default_type(inout c.types, e.ls.lfield(w(field_index)).ty);
    }
    ty
}

// `Graph::pass_through`: the graph instruction index and value of the one
// `Read` of the local the `let` at instruction `at` of block `b` binds
// with pattern word `q`; `found` false when there is none.
pub copy struct Through {
    found: bool,
    k: u64,
    read: u32,
}

const NO_THROUGH: Through = Through { found: false, k: 0, read: 0 };

fn pass_through(
    inout e: Env,
    inout c: Ctx,
    in p: Program,
    in g: G,
    in syms: Syms,
    b: u64,
    at: u64,
    pattern: u64
) -> Through {
    if p.op(pattern) != Pat::Bind {
        return NO_THROUGH;
    }
    let name = n32(p.op(add(pattern, 3)));
    let li = syms.local_of(name);
    if li == NONE32_64
        || u64_at(in g.mentions, li) != 2
        || u8_at(in g.split, li) != 0
        || syms.has(name, S_PARAM)
        || syms.has(name, S_CAPTURE)
    {
        return NO_THROUGH;
    }
    let local_ty = default_type(inout c.types, u32_at(in g.lty, li));
    if !drop_free(inout e, inout c, local_ty) {
        return NO_THROUGH;
    }
    let blk = p.block(add(g.b0, b));
    for k in inc(at)..blk.ic {
        let inst = p.inst(add(blk.i0, k));
        if inst.op == Op::Read
            && n32(p.op(inst.a)) == name
            && p.op(inc(inst.a)) == 0
            && p.op(add(inst.a, 2)) == TyPass::Sink
        {
            return Through { found: true, k: k, read: inst.dest };
        }
    }
    NO_THROUGH
}

fn field_home(parent: u32, ty: u32, offset: i32) -> Home {
    Home { kind: H_FIELD, a: w(parent), b: wrapping_u64(widen_i64(offset)), c: w(ty) }
}

// `Graph::consumer_home`: the home of value `id` of type `own` from its
// single consumer at or after instruction `start` of block `b`.
fn consumer_home(
    inout e: Env,
    inout c: Ctx,
    in p: Program,
    in g: G,
    in syms: Syms,
    b: u64,
    start: u64,
    id: u32,
    own: u32,
    depth: u64
) -> Home {
    let blk = p.block(add(g.b0, b));
    let base = wrapping_sub(blk.i0, g.i0);
    let mut k = start;
    let mut found = false;
    loop {
        if k >= blk.ic {
            break;
        }
        if g.reads(add(base, k), id) {
            found = true;
            break;
        }
        k = inc(k);
    }
    if found {
        let inst = p.inst(add(blk.i0, k));
        let operands = inst.a;
        if inst.op == Op::Data {
            let n = p.op(inc(operands));
            for j in 0..n {
                if n32(p.op(add(add(operands, 3), wrapping_mul(j, 2)))) == id {
                    let fname = n32(p.op(add(add(operands, 2), wrapping_mul(j, 2))));
                    let inst_ty = default_type(inout c.types, inst.ty);
                    let field = field_at(inout e, inout c, inst_ty, n32(p.op(operands)), fname);
                    if field.ty == NONE32 || field.ty != own {
                        return NO_HOME;
                    }
                    return field_home(inst.dest, inst_ty, field.offset);
                }
            }
            return NO_HOME;
        }
        if inst.op == Op::Tuple {
            let n = p.op(operands);
            for j in 0..n {
                if n32(p.op(add(inc(operands), j))) == id {
                    let fname = e.digit(inout c.names, j);
                    let inst_ty = default_type(inout c.types, inst.ty);
                    let field = field_at(inout e, inout c, inst_ty, NONE32, fname);
                    if field.ty == NONE32 || field.ty != own {
                        return NO_HOME;
                    }
                    return field_home(inst.dest, inst_ty, field.offset);
                }
            }
            return NO_HOME;
        }
        if inst.op == Op::Exit {
            if n32(p.op(operands)) == id && n32(p.op(inc(operands))) == g.name && own == g.result {
                return Home { kind: H_RESULT, a: 0, b: 0, c: 0 };
            }
            return NO_HOME;
        }
        if inst.op == Op::Bind {
            if n32(p.op(operands)) != id {
                return NO_HOME;
            }
            let through = pass_through(inout e, inout c, in p, in g, in syms, b, k, inc(operands));
            if !through.found {
                return NO_HOME;
            }
            if vtype(in g, inout c, through.read) != own || g.uses_of(through.read) != 1 {
                return NO_HOME;
            }
            return consumer_home(
                inout e,
                inout c,
                in p,
                in g,
                in syms,
                b,
                inc(through.k),
                through.read,
                own,
                inc(depth)
            );
        }
        if inst.op == Op::Write {
            let place = n32(p.op(operands));
            if n32(p.op(inc(operands))) != e.s_eq || n32(p.op(add(operands, 2))) != id {
                return NO_HOME;
            }
            if place_type(inout e, inout c, in g, in syms, place) != own {
                return NO_HOME;
            }
            if !drop_free(inout e, inout c, own) {
                return NO_HOME;
            }
            let root = place_root(inout c.names, place);
            if g.split_local(in syms, root) {
                return NO_HOME;
            }
            return Home { kind: H_PLACE, a: w(place), b: b, c: k };
        }
        return NO_HOME;
    }
    let term_at = blk.ta;
    if blk.term == Term::Return {
        if n32(p.op(term_at)) == id && own == g.result {
            return Home { kind: H_RESULT, a: 0, b: 0, c: 0 };
        }
        return NO_HOME;
    }
    if blk.term == Term::Jump {
        let target = p.op(term_at);
        let n = p.op(inc(term_at));
        let mut count: u64 = 0;
        let mut first: u64 = 0;
        for i in 0..n {
            if n32(p.op(add(add(term_at, 2), i))) == id {
                if count == 0 {
                    first = i;
                }
                count = inc(count);
            }
        }
        if count == 1 {
            return param_home(
                inout e,
                inout c,
                in p,
                in g,
                in syms,
                target,
                first,
                own,
                inc(depth)
            );
        }
    }
    NO_HOME
}

// `Graph::param_home`.
fn param_home(
    inout e: Env,
    inout c: Ctx,
    in p: Program,
    in g: G,
    in syms: Syms,
    target: u64,
    param_index: u64,
    own: u32,
    depth: u64
) -> Home {
    if depth > MAX_DEPTH {
        return NO_HOME;
    }
    let pv = g.param(target, param_index);
    if pv == NONE32 {
        return NO_HOME;
    }
    if g.uses_of(pv) != 1 || vtype(in g, inout c, pv) != own {
        return NO_HOME;
    }
    let mut built: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut through: ChunkSeq[u32] = ChunkSeq::new[u32]();
    if !sources(inout e, inout c, in p, in g, pv, depth, inout built, inout through) {
        return NO_HOME;
    }
    consumer_home(inout e, inout c, in p, in g, in syms, target, 0, pv, own, depth)
}

// `Graph::sources`: appends the constructors and calls whose values reach
// block parameter `pv`, and the parameters they pass through; false when
// some value reaching `pv` cannot be built in its home.
fn sources(
    inout e: Env,
    inout c: Ctx,
    in p: Program,
    in g: G,
    pv: u32,
    depth: u64,
    inout built: ChunkSeq[u32],
    inout through: ChunkSeq[u32]
) -> bool {
    if depth > MAX_DEPTH {
        return false;
    }
    let target = g.param_block(pv);
    if target == NONE32 {
        return false;
    }
    let target_block = w(target);
    let mut param_index: u64 = 0;
    let mut seen = false;
    for i in 0..u64_at(in g.pn, target_block) {
        if !seen && g.param(target_block, i) == pv {
            param_index = i;
            seen = true;
        }
    }
    if u8_at(in g.cyclic, target_block) != 0 || u8_at(in g.only_jumps, target_block) == 0 {
        return false;
    }
    let own = vtype(in g, inout c, pv);
    if own == NONE32 {
        return false;
    }
    let pred_count = u64_at(in g.qn, target_block);
    if pred_count == 0 {
        return false;
    }
    through.push(pv);
    for i in 0..pred_count {
        let pred = w(u32_at(in g.preds, add(u64_at(in g.qa, target_block), i)));
        let blk = p.block(add(g.b0, pred));
        if blk.term != Term::Jump {
            return false;
        }
        if param_index >= p.op(inc(blk.ta)) {
            return false;
        }
        let arg_value = n32(p.op(add(add(blk.ta, 2), param_index)));
        let arg_ty = vtype(in g, inout c, arg_value);
        if arg_ty != NONE32 && named0(in c, arg_ty, c.world.k.never) {
            continue;
        }
        if g.uses_of(arg_value) != 1 || arg_ty != own {
            return false;
        }
        let def_block = g.def_block(arg_value);
        if def_block != NONE32 {
            if w(def_block) == pred && def_candidate(in p, in e, in g, arg_value) {
                built.push(arg_value);
            } else {
                return false;
            }
        } else if w(g.param_block(arg_value)) == pred {
            if !sources(
                inout e,
                inout c,
                in p,
                in g,
                arg_value,
                inc(depth),
                inout built,
                inout through
            ) {
                return false;
            }
        } else {
            return false;
        }
    }
    true
}

// `Graph::observable` of a place rooted at `root`.
fn observable(in g: G, in syms: Syms, root: u32) -> bool {
    g.nested || !g.is_local(in syms, root) || syms.has(root, S_CAPTURE) || syms.has(root, S_PARAM)
}

// `Graph::quiet`.
fn quiet(in e: Env, callee: u32, obs: bool) -> bool {
    let bits = e.fn_bits(callee);
    (bits & FN_DEFINED) != 0 && (!obs || (bits & FN_QUIET) != 0)
}

// `Graph::scalar_local`.
fn scalar_local(inout e: Env, inout c: Ctx, in g: G, in syms: Syms, name: u32) -> bool {
    let li = syms.local_of(name);
    if li == NONE32_64 {
        return false;
    }
    let raw = u32_at(in g.lty, li);
    let ty = default_type(inout c.types, raw);
    let layout = lay(inout e, inout c, ty);
    layout != NONE32 && !e.ls.aggregate(layout) && c.types.kind(raw) != TyKind::Fn
}

fn value_aggregate(inout e: Env, inout c: Ctx, in g: G, v: u32) -> bool {
    let ty = vtype(in g, inout c, v);
    ty != NONE32 && aggregate(inout e, inout c, ty)
}

// `window_ok`'s `fresh`.
fn fresh(
    inout e: Env,
    inout c: Ctx,
    in p: Program,
    in g: G,
    in members: ChunkSeq[u8],
    v: u32
) -> bool {
    u8_at(in members, w(v)) != 0
        || !value_aggregate(inout e, inout c, in g, v)
        || def_candidate(in p, in e, in g, v)
}

// `window_ok`'s `scalar_args` of the argument list at word `at`.
fn scalar_args(inout e: Env, inout c: Ctx, in p: Program, in g: G, at: u64) -> bool {
    for j in 0..arg_count(in p, at) {
        if p.op(arg_word(at, j, 2)) != 0 || p.op(arg_word(at, j, 0)) == TyPass::Inout {
            return false;
        }
        if value_aggregate(inout e, inout c, in g, n32(p.op(arg_word(at, j, 1)))) {
            return false;
        }
    }
    true
}

// `ir::state_action` of a unary or binary instruction.
fn arith_action(in e: Env, in p: Program, ii: u64) -> bool {
    let inst = p.inst(ii);
    if inst.fallible != 0 {
        return true;
    }
    if inst.op == Op::Binary {
        let operator = n32(p.op(inst.a));
        return operator == e.s_div
            || operator == e.s_rem
            || operator == e.s_shl
            || operator == e.s_shr;
    }
    false
}

// `window_ok`: 0 when the window of the write at (`write_block`, `write_inst`) keeps the
// rule, 1 for a break, 2 for a member call that may fault visibly (its
// value in `call`).
fn window_ok(
    inout e: Env,
    inout c: Ctx,
    in p: Program,
    in g: G,
    in syms: Syms,
    place: u32,
    write_block: u64,
    write_inst: u64,
    in members: ChunkSeq[u8],
    inout call: u32
) -> u8 {
    let root = place_root(inout c.names, place);
    let obs = observable(in g, in syms, root);
    let mut has_range: ChunkSeq[u8] = filled8(g.nb, 0);
    let mut range_from: ChunkSeq[u64] = filled64(g.nb, 0);
    let mut range_to: ChunkSeq[u64] = filled64(g.nb, 0);
    for v in 0..g.nv {
        if u8_at(in members, v) == 0 {
            continue;
        }
        let id = n32(v);
        let def_block = g.def_block(id);
        if def_block != NONE32 {
            let b = w(def_block);
            let i = w(u32_at(in g.def_i, v));
            let len = p.block(add(g.b0, b)).ic;
            let end = if b == write_block { write_inst } else { len };
            if u8_at(in has_range, b) == 0 {
                set8(inout has_range, b, 1);
                set64(inout range_from, b, i);
                set64(inout range_to, b, end);
            } else {
                set64(inout range_from, b, min64(u64_at(in range_from, b), i));
            }
        } else {
            let param_block = g.param_block(id);
            if param_block != NONE32 {
                let b = w(param_block);
                let len = p.block(add(g.b0, b)).ic;
                let end = if b == write_block { write_inst } else { len };
                set8(inout has_range, b, 1);
                set64(inout range_from, b, 0);
                set64(inout range_to, b, end);
            }
        }
    }
    if u8_at(in has_range, write_block) == 0 {
        return 1;
    }
    for b in 0..g.nb {
        if u8_at(in has_range, b) == 0 {
            continue;
        }
        let blk = p.block(add(g.b0, b));
        for k in u64_at(in range_from, b)..u64_at(in range_to, b) {
            let ii = add(blk.i0, k);
            let inst = p.inst(ii);
            let operands = inst.a;
            let op = inst.op;
            let mut ok = false;
            if op == Op::Const || op == Op::Unit {
                ok = true;
            } else if op == Op::Bind {
                ok = u8_at(in members, p.op(operands)) != 0;
            } else if op == Op::Read {
                ok = u8_at(in members, w(inst.dest)) != 0
                    || (p.op(inc(operands)) == 0
                        && scalar_local(inout e, inout c, in g, in syms, n32(p.op(operands))));
            } else if op == Op::Data {
                ok = true;
                for j in 0..p.op(inc(operands)) {
                    if !fresh(
                        inout e,
                        inout c,
                        in p,
                        in g,
                        in members,
                        n32(p.op(add(add(operands, 3), wrapping_mul(j, 2))))
                    ) {
                        ok = false;
                    }
                }
            } else if op == Op::Tuple {
                ok = true;
                for j in 0..p.op(operands) {
                    if !fresh(
                        inout e,
                        inout c,
                        in p,
                        in g,
                        in members,
                        n32(p.op(add(inc(operands), j)))
                    ) {
                        ok = false;
                    }
                }
            } else if op == Op::Call {
                let callee = n32(p.op(operands));
                let fine = quiet(in e, callee, obs)
                    && scalar_args(inout e, inout c, in p, in g, inc(operands));
                if u8_at(in members, w(inst.dest)) != 0 {
                    if !fine {
                        call = inst.dest;
                        return 2;
                    }
                    ok = true;
                } else {
                    ok = fine;
                }
            } else if op == Op::Binary || op == Op::Unary {
                ok = !obs || !arith_action(in e, in p, ii);
            }
            if !ok {
                return 1;
            }
        }
    }
    0
}

// Symbol order: byte-wise, shorter first on a common prefix (Rust `str`).
fn sym_less(in names: Names, x: u32, y: u32) -> bool {
    let nx = names.size(x);
    let ny = names.size(y);
    for i in 0..min64(nx, ny) {
        let a = names.byte(x, i);
        let b = names.byte(y, i);
        if a != b {
            return a < b;
        }
    }
    nx < ny
}

// (place, block, index) of a `Write` home group.
pub copy struct Group {
    place: u32,
    b: u64,
    i: u64,
}

fn group_less(in names: Names, x: Group, y: Group) -> bool {
    if x.place != y.place {
        return sym_less(in names, x.place, y.place);
    }
    x.b < y.b || (x.b == y.b && x.i < y.i)
}

// One pass of `drop_unsafe_places`; true when it should run again.
fn drop_unsafe_once(inout e: Env, inout c: Ctx, in p: Program, inout g: G, in syms: Syms) -> bool {
    let mut retry = false;
    let mut groups: ChunkSeq[Group] = ChunkSeq::new[Group]();
    for v in 0..g.nv {
        let home = g.home(n32(v));
        if home.kind != H_PLACE {
            continue;
        }
        let new_group = Group { place: n32(home.a), b: home.b, i: home.c };
        let mut dup = false;
        for j in 0..groups.len() {
            match groups.try_get(j) {
                Option::Some(entry) => {
                    if entry.place == new_group.place
                        && entry.b == new_group.b
                        && entry.i == new_group.i
                    {
                        dup = true;
                    }
                },
                Option::None => {}
            }
        }
        if dup {
            continue;
        }
        // Insert in (place, at) order.
        let mut at = groups.len();
        for j in 0..groups.len() {
            match groups.try_get(j) {
                Option::Some(entry) => {
                    if at == groups.len() && group_less(in c.names, new_group, entry) {
                        at = j;
                    }
                },
                Option::None => {}
            }
        }
        groups.push(new_group);
        let mut j = wrapping_sub(groups.len(), 1);
        loop {
            if j <= at {
                break;
            }
            let prev = groups.try_get(wrapping_sub(j, 1)).unwrap_or(new_group);
            let ok = groups.try_set(j, prev);
            j = wrapping_sub(j, 1);
        }
        let ok = groups.try_set(at, new_group);
    }
    for gi in 0..groups.len() {
        let group = match groups.try_get(gi) {
            Option::Some(entry) => entry,
            Option::None => Group { place: 0, b: 0, i: 0 },
        };
        let mut members: ChunkSeq[u8] = filled8(g.nv, 0);
        for v in 0..g.nv {
            let home = g.home(n32(v));
            if home.kind == H_PLACE && home.b == group.b && home.c == group.i {
                set8(inout members, v, 1);
            }
        }
        loop {
            let mut more = false;
            for v in 0..g.nv {
                if u8_at(in members, v) != 0 {
                    continue;
                }
                let home = g.home(n32(v));
                if home.kind == H_FIELD && u8_at(in members, home.a) != 0 {
                    set8(inout members, v, 1);
                    more = true;
                }
            }
            if !more {
                break;
            }
        }
        let mut call: u32 = 0;
        let verdict = window_ok(
            inout e,
            inout c,
            in p,
            in g,
            in syms,
            group.place,
            group.b,
            group.i,
            in members,
            inout call
        );
        if verdict == 0 {
            continue;
        }
        let call_home = g.home(call);
        if verdict == 2
            && call_home.kind != H_NONE
            && !(call_home.kind == H_PLACE && call_home.b == group.b && call_home.c == group.i)
        {
            for v in 0..g.nv {
                if same_home(g.home(n32(v)), call_home) {
                    g.set_home(n32(v), NO_HOME);
                }
            }
            retry = true;
        } else {
            for v in 0..g.nv {
                let home = g.home(n32(v));
                if home.kind == H_PLACE && home.b == group.b && home.c == group.i {
                    g.set_home(n32(v), NO_HOME);
                }
            }
        }
    }
    retry
}

// `in_place`: whether `home` lies inside the destination of a write.
fn in_place(in g: G, home: Home) -> bool {
    let mut cur = home;
    let n = g.home_count();
    for i in 0..inc(n) {
        if cur.kind == H_PLACE {
            return true;
        }
        if cur.kind == H_RESULT {
            return false;
        }
        if cur.kind == H_FIELD {
            let parent = g.home(n32(cur.a));
            if parent.kind == H_NONE {
                return false;
            }
            cur = parent;
        } else {
            return false;
        }
    }
    true
}

// `Graph::mentions`: how often each local is named.
fn count_mentions(inout c: Ctx, in p: Program, inout g: G, in syms: Syms) {
    let mut bound: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut names: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for k in 0..g.ni {
        let inst = p.inst(add(g.i0, k));
        let operands = inst.a;
        let op = inst.op;
        names.clear();
        if op == Op::Read {
            names.push(n32(p.op(operands)));
        } else if op == Op::Write {
            names.push(place_root(inout c.names, n32(p.op(operands))));
        } else if op == Op::Bind {
            bound.clear();
            pattern_binds(in p, inc(operands), inout bound);
            // A set: each bound name once.
            for i in 0..bound.len() {
                let bound_name = u32_at(in bound, i);
                let mut dup = false;
                for j in 0..i {
                    if u32_at(in bound, j) == bound_name {
                        dup = true;
                    }
                }
                if !dup {
                    names.push(bound_name);
                }
            }
        } else if args_at(op, operands) != 18446744073709551615 {
            let at = args_at(op, operands);
            for j in 0..arg_count(in p, at) {
                let root = p.op(arg_word(at, j, 2));
                if root != 0 {
                    names.push(n32(wrapping_sub(root, 1)));
                }
            }
        } else if op == Op::Closure || op == Op::Handle {
            let mut at = if op == Op::Handle {
                add(operands, 3)
            } else {
                inc(operands)
            };
            let capture_count = p.op(at);
            for j in 0..capture_count {
                names.push(n32(p.op(add(inc(at), wrapping_mul(j, 2)))));
                names.push(n32(p.op(add(add(at, 2), wrapping_mul(j, 2)))));
            }
            if op == Op::Closure {
                at = add(inc(at), wrapping_mul(capture_count, 2));
                let nm = p.op(at);
                for j in 0..nm {
                    names.push(n32(p.op(add(inc(at), wrapping_mul(j, 2)))));
                }
            }
        }
        for i in 0..names.len() {
            let li = syms.local_of(u32_at(in names, i));
            if li != NONE32_64 {
                set64(inout g.mentions, li, inc(u64_at(in g.mentions, li)));
            }
        }
    }
}

// `native_aggregates::plan`.
fn plan(inout e: Env, inout c: Ctx, in p: Program, inout g: G, in syms: Syms) {
    if c.world.box_active {
        for v in 0..g.nv {
            let value_ty = u32_at(in g.vty, v);
            if value_ty != NONE32 && mentions_box(in c, value_ty, 0) {
                return;
            }
        }
        for i in 0..g.lty.len() {
            if mentions_box(in c, u32_at(in g.lty, i), 0) {
                return;
            }
        }
    }
    count_mentions(inout c, in p, inout g, in syms);
    for b in 0..g.nb {
        let blk = p.block(add(g.b0, b));
        let base = wrapping_sub(blk.i0, g.i0);
        for at in 0..blk.ic {
            let ii = add(blk.i0, at);
            let inst = p.inst(ii);
            let own = default_type(inout c.types, inst.ty);
            if !candidate(in p, in e, ii)
                || g.uses_of(inst.dest) != 1
                || !aggregate(inout e, inout c, own)
            {
                continue;
            }
            // A value passed to a block parameter gets the parameter's home.
            let mut jumps = false;
            if blk.term == Term::Jump {
                let term_start = u64_at(in g.ta, b);
                for i in 0..u64_at(in g.tn, b) {
                    if u32_at(in g.tv, add(term_start, i)) == inst.dest {
                        jumps = true;
                    }
                }
                for later in inc(at)..blk.ic {
                    if g.reads(add(base, later), inst.dest) {
                        jumps = false;
                    }
                }
            }
            if jumps {
                continue;
            }
            let home = consumer_home(
                inout e,
                inout c,
                in p,
                in g,
                in syms,
                b,
                inc(at),
                inst.dest,
                own,
                0
            );
            if home.kind != H_NONE {
                g.set_home(inst.dest, home);
            }
        }
    }
    // A block parameter shares the home of the values that reach it.
    for b in 0..g.nb {
        for k in 0..u64_at(in g.pn, b) {
            let pv = g.param(b, k);
            let own = vtype(in g, inout c, pv);
            if own == NONE32 || !aggregate(inout e, inout c, own) {
                continue;
            }
            let home = param_home(inout e, inout c, in p, in g, in syms, b, k, own, 0);
            if home.kind == H_NONE {
                continue;
            }
            let mut built: ChunkSeq[u32] = ChunkSeq::new[u32]();
            let mut through: ChunkSeq[u32] = ChunkSeq::new[u32]();
            if sources(inout e, inout c, in p, in g, pv, 0, inout built, inout through) {
                for i in 0..built.len() {
                    g.set_home(u32_at(in built, i), home);
                }
                for i in 0..through.len() {
                    g.set_home(u32_at(in through, i), home);
                }
            }
        }
    }
    // The read of a pass-through local shares the home of its value.
    for b in 0..g.nb {
        let blk = p.block(add(g.b0, b));
        for at in 0..blk.ic {
            let inst = p.inst(add(blk.i0, at));
            if inst.op != Op::Bind {
                continue;
            }
            let home = g.home(n32(p.op(inst.a)));
            if home.kind == H_NONE {
                continue;
            }
            let through = pass_through(inout e, inout c, in p, in g, in syms, b, at, inc(inst.a));
            if through.found {
                g.set_home(through.read, home);
            }
        }
    }
    loop {
        if !drop_unsafe_once(inout e, inout c, in p, inout g, in syms) {
            break;
        }
    }
    // A single-use aggregate read of a split local stores its words into
    // the result or a field of a later constructor.
    for b in 0..g.nb {
        let blk = p.block(add(g.b0, b));
        for at in 0..blk.ic {
            let inst = p.inst(add(blk.i0, at));
            if inst.op != Op::Read {
                continue;
            }
            let own = default_type(inout c.types, inst.ty);
            if !g.split_local(in syms, n32(p.op(inst.a)))
                || g.uses_of(inst.dest) != 1
                || !aggregate(inout e, inout c, own)
            {
                continue;
            }
            let home = consumer_home(
                inout e,
                inout c,
                in p,
                in g,
                in syms,
                b,
                inc(at),
                inst.dest,
                own,
                0
            );
            if home.kind == H_RESULT || (home.kind == H_FIELD && !in_place(in g, home)) {
                g.set_home(inst.dest, home);
            }
        }
    }
}

// ----- split_locals ----------------------------------------------------------

// The reads of each local, in instruction order: a linked list per local
// of paths rs[ra..ra+rn].
pub struct Reads {
    head: ChunkSeq[u64],
    tail: ChunkSeq[u64],
    next: ChunkSeq[u64],
    ra: ChunkSeq[u64],
    rn: ChunkSeq[u64],
    rs: ChunkSeq[u32],
}

const END: u64 = 18446744073709551615;

fn reads_new(n: u64) -> Reads {
    Reads {
        head: filled64(n, END),
        tail: filled64(n, END),
        next: ChunkSeq::new[u64](),
        ra: ChunkSeq::new[u64](),
        rn: ChunkSeq::new[u64](),
        rs: ChunkSeq::new[u32](),
    }
}

impl Reads {
    fn add(inout self, li: u64, in path: ChunkSeq[u32], from: u64) {
        let id = self.ra.len();
        self.ra.push(self.rs.len());
        self.rn.push(wrapping_sub(path.len(), from));
        for i in from..path.len() {
            self.rs.push(u32_at(in path, i));
        }
        self.next.push(END);
        let last = u64_at(in self.tail, li);
        if last == END {
            set64(inout self.head, li, id);
        } else {
            set64(inout self.next, last, id);
        }
        set64(inout self.tail, li, id);
    }
}

// Whether path xs[xa..xa+xn] starts with ys[ya..ya+yn].
fn starts_with(
    in xs: ChunkSeq[u32],
    xa: u64,
    xn: u64,
    in ys: ChunkSeq[u32],
    ya: u64,
    yn: u64
) -> bool {
    if yn > xn {
        return false;
    }
    for i in 0..yn {
        if u32_at(in xs, add(xa, i)) != u32_at(in ys, add(ya, i)) {
            return false;
        }
    }
    true
}

// Each candidate's leaves: the local's range of `leaf_*` entries.
pub struct Cands {
    // by local: leaf range, or count 0 for a local that is no candidate
    la: ChunkSeq[u64],
    ln: ChunkSeq[u64],
    leaves: Leaves,
}

fn live_words(in cs: Cands, in reads: Reads, li: u64) -> u64 {
    let mut n: u64 = 0;
    for i in 0..u64_at(in cs.ln, li) {
        let leaf = add(u64_at(in cs.la, li), i);
        let xa = u64_at(in cs.leaves.pa, leaf);
        let xn = u64_at(in cs.leaves.pn, leaf);
        let mut read = u64_at(in reads.head, li);
        let mut hit = false;
        loop {
            if read == END || hit {
                break;
            }
            let ya = u64_at(in reads.ra, read);
            let yn = u64_at(in reads.rn, read);
            if starts_with(in cs.leaves.syms, xa, xn, in reads.rs, ya, yn)
                || starts_with(in reads.rs, ya, yn, in cs.leaves.syms, xa, xn)
            {
                hit = true;
            }
            read = u64_at(in reads.next, read);
        }
        if hit {
            n = inc(n);
        }
    }
    n
}

fn words_under(in cs: Cands, li: u64, in path: ChunkSeq[u32], pa: u64, pn: u64) -> u64 {
    let mut n: u64 = 0;
    for i in 0..u64_at(in cs.ln, li) {
        let leaf = add(u64_at(in cs.la, li), i);
        if starts_with(
            in cs.leaves.syms,
            u64_at(in cs.leaves.pa, leaf),
            u64_at(in cs.leaves.pn, leaf),
            in path,
            pa,
            pn
        ) {
            n = inc(n);
        }
    }
    n
}

fn mark_memory(in syms: Syms, inout memory: ChunkSeq[u8], sym: u32) {
    let li = syms.local_of(sym);
    if li != NONE32_64 {
        set8(inout memory, li, 1);
    }
}

// `native_aggregates::split_locals` into `g.split`; returns the reads of
// each local (the split locals' paths are printed from them).
fn split_locals(inout e: Env, inout c: Ctx, in p: Program, inout g: G, in syms: Syms) -> Reads {
    let nl = g.lsym.len();
    let mut memory: ChunkSeq[u8] = filled8(nl, 0);
    let mut fields: ChunkSeq[u8] = filled8(nl, 0);
    let mut reads = reads_new(nl);
    let mut path: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut has_closure = false;
    for k in 0..g.ni {
        let inst = p.inst(add(g.i0, k));
        let operands = inst.a;
        let op = inst.op;
        if op == Op::Read {
            let li = syms.local_of(n32(p.op(operands)));
            let path_row = p.path(p.op(inc(operands)));
            if li != NONE32_64 {
                path.clear();
                for i in 0..path_row.n {
                    path.push(p.path_name(p.op(inc(operands)), i));
                }
                reads.add(li, in path, 0);
                if path_row.n > 0 {
                    set8(inout fields, li, 1);
                }
            }
        } else if op == Op::Write {
            path.clear();
            place_parts(inout c.names, n32(p.op(operands)), inout path);
            let li = syms.local_of(u32_at(in path, 0));
            if li != NONE32_64 {
                if path.len() > 1 {
                    set8(inout fields, li, 1);
                }
                if n32(p.op(inc(operands))) != e.s_eq {
                    reads.add(li, in path, 1);
                }
            }
        } else if op == Op::Call || op == Op::Indirect {
            let at = inc(operands);
            for j in 0..arg_count(in p, at) {
                let root = p.op(arg_word(at, j, 2));
                if p.op(arg_word(at, j, 0)) == TyPass::Inout && root != 0 {
                    mark_memory(in syms, inout memory, n32(wrapping_sub(root, 1)));
                }
            }
        } else if op == Op::Seq || op == Op::Fip || op == Op::Tiled {
            let at = inc(operands);
            for j in 0..arg_count(in p, at) {
                let root = p.op(arg_word(at, j, 2));
                if root != 0 {
                    mark_memory(in syms, inout memory, n32(wrapping_sub(root, 1)));
                }
            }
        } else if op == Op::Closure || op == Op::Handle {
            has_closure = true;
            let mut at = if op == Op::Handle {
                add(operands, 3)
            } else {
                inc(operands)
            };
            let capture_count = p.op(at);
            for j in 0..capture_count {
                mark_memory(in syms, inout memory, n32(p.op(add(inc(at), wrapping_mul(j, 2)))));
                mark_memory(in syms, inout memory, n32(p.op(add(add(at, 2), wrapping_mul(j, 2)))));
            }
            at = add(inc(at), wrapping_mul(capture_count, 2));
            let nm = p.op(at);
            for j in 0..nm {
                mark_memory(in syms, inout memory, n32(p.op(add(inc(at), wrapping_mul(j, 2)))));
            }
        }
    }
    if has_closure {
        let free_start = u64_at(in e.free_a, g.fi);
        for i in 0..u64_at(in e.free_n, g.fi) {
            mark_memory(in syms, inout memory, u32_at(in e.free, add(free_start, i)));
        }
    }
    // An element view's binding names the element in its buffer.
    if e.views.len() > 0 {
        let mut views: ChunkSeq[u8] = filled8(g.nv, 0);
        for k in 0..g.ni {
            let inst = p.inst(add(g.i0, k));
            if inst.op == Op::Seq && e.is_view(inst.s0, inst.s1) {
                set8(inout views, w(inst.dest), 1);
            }
        }
        let mut bound: ChunkSeq[u32] = ChunkSeq::new[u32]();
        for k in 0..g.ni {
            let inst = p.inst(add(g.i0, k));
            if inst.op == Op::Bind && u8_at(in views, p.op(inst.a)) != 0 {
                bound.clear();
                pattern_binds(in p, inc(inst.a), inout bound);
                for i in 0..bound.len() {
                    mark_memory(in syms, inout memory, u32_at(in bound, i));
                }
            }
        }
    }
    let mut cs = Cands {
        la: filled64(nl, 0),
        ln: filled64(nl, 0),
        leaves: leaves_new(),
    };
    for li in 0..nl {
        let sym = u32_at(in g.lsym, li);
        if u8_at(in memory, li) != 0
            || u8_at(in fields, li) == 0
            || syms.has(sym, S_PARAM)
            || syms.has(sym, S_CAPTURE)
        {
            continue;
        }
        let local_ty = default_type(inout c.types, u32_at(in g.lty, li));
        let mut local_leaves = leaves_new();
        if split_words(inout e, inout c, local_ty, inout local_leaves) {
            set64(inout cs.la, li, cs.leaves.pa.len());
            set64(inout cs.ln, li, local_leaves.pa.len());
            for i in 0..local_leaves.pa.len() {
                cs.leaves.pa.push(add(cs.leaves.syms.len(), 0));
                cs.leaves.pn.push(u64_at(in local_leaves.pn, i));
                cs.leaves.offset.push(u64_at(in local_leaves.offset, i));
                let leaf_start = u64_at(in local_leaves.pa, i);
                for j in 0..u64_at(in local_leaves.pn, i) {
                    cs.leaves.syms.push(u32_at(in local_leaves.syms, add(leaf_start, j)));
                }
            }
        }
    }
    // Elements read by `try_get`.
    let mut elements: ChunkSeq[u8] = filled8(g.nv, 0);
    for k in 0..g.ni {
        let inst = p.inst(add(g.i0, k));
        if inst.op == Op::Seq {
            let label = p.pool_row(p.op(inst.a)).label;
            if label == e.s_try_get || label == e.s_hoisted_try_get {
                set8(inout elements, w(inst.dest), 1);
            }
        }
    }
    let mut in_memory: ChunkSeq[u64] = filled64(nl, 0);
    let mut split: ChunkSeq[u64] = filled64(nl, 0);
    let mut bound: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for b in 0..g.nb {
        let blk = p.block(add(g.b0, b));
        let base = wrapping_sub(blk.i0, g.i0);
        let weight = if u8_at(in g.cyclic, b) != 0 {
            LOOP_WEIGHT
        } else {
            1
        };
        for at in 0..blk.ic {
            let inst = p.inst(add(blk.i0, at));
            let operands = inst.a;
            if inst.op == Op::Read {
                let li = syms.local_of(n32(p.op(operands)));
                if li == NONE32_64 || u64_at(in cs.ln, li) == 0 {
                    continue;
                }
                let own = default_type(inout c.types, inst.ty);
                if !aggregate(inout e, inout c, own) {
                    set64(inout in_memory, li, add(u64_at(in in_memory, li), weight));
                    continue;
                }
                let mut found = false;
                let mut placed = false;
                for later in inc(at)..blk.ic {
                    if !found && g.reads(add(base, later), inst.dest) {
                        found = true;
                        let consumer = p.inst(add(blk.i0, later));
                        if consumer.op == Op::Data
                            || consumer.op == Op::Tuple
                            || consumer.op == Op::Exit
                        {
                            placed = true;
                        } else if consumer.op == Op::Bind {
                            let pattern = inc(consumer.a);
                            if p.op(pattern) == Pat::Bind {
                                let bound_local = syms.local_of(n32(p.op(add(pattern, 3))));
                                placed = bound_local != NONE32_64
                                    && u64_at(in cs.ln, bound_local) != 0;
                            }
                        }
                    }
                }
                if !found {
                    placed = blk.term == Term::Return && n32(p.op(blk.ta)) == inst.dest;
                }
                if !placed {
                    let path_id = p.op(inc(operands));
                    let path_row = p.path(path_id);
                    path.clear();
                    for i in 0..path_row.n {
                        path.push(p.path_name(path_id, i));
                    }
                    let n = words_under(in cs, li, in path, 0, path.len());
                    set64(inout split, li, add(u64_at(in split, li), wrapping_mul(weight, n)));
                }
            } else if inst.op == Op::Write {
                let place = n32(p.op(operands));
                let root = place_root(inout c.names, place);
                let li = syms.local_of(root);
                if li != NONE32_64 && u64_at(in cs.ln, li) != 0 && has_dot(in c.names, place) {
                    set64(inout in_memory, li, add(u64_at(in in_memory, li), weight));
                }
            } else if inst.op == Op::Bind {
                bound.clear();
                pattern_binds(in p, inc(operands), inout bound);
                let element = u8_at(in elements, p.op(operands)) != 0;
                for i in 0..bound.len() {
                    let bound_name = u32_at(in bound, i);
                    let mut dup = false;
                    for j in 0..i {
                        if u32_at(in bound, j) == bound_name {
                            dup = true;
                        }
                    }
                    if dup {
                        continue;
                    }
                    let li = syms.local_of(bound_name);
                    if li == NONE32_64 || u64_at(in cs.ln, li) == 0 {
                        continue;
                    }
                    let live = live_words(in cs, in reads, li);
                    set64(inout split, li, add(u64_at(in split, li), wrapping_mul(weight, live)));
                    if element {
                        let n = u64_at(in cs.ln, li);
                        set64(
                            inout in_memory,
                            li,
                            add(u64_at(in in_memory, li), wrapping_mul(weight, n))
                        );
                    }
                }
            }
        }
    }
    for li in 0..nl {
        if u64_at(in cs.ln, li) != 0 && u64_at(in split, li) <= u64_at(in in_memory, li) {
            set8(inout g.split, li, 1);
        }
    }
    reads
}

// ----- the decisions as text ---------------------------------------------------

// ----- the drop plans of a graph (src/fip.rs) -----------------------------------

// `fip::SeqDrop`, by local index (0: not planned).
const SD_NONE: u8 = 0;
const SD_SEQ: u8 = 1;
const SD_STR: u8 = 2;
const SD_OWNED: u8 = 3;
const SD_FIELDS: u8 = 4;

// `seq::holds_sequence`: field types are not substituted.
fn holds_visit(inout c: Ctx, ty: u32, inout seen: ChunkSeq[u32]) -> bool {
    let node = c.types.node(ty);
    let known = c.world.k;
    if node.kind == TyKind::Tuple {
        for i in 0..w(node.n) {
            if holds_visit(inout c, arg_of(in c, ty, i), inout seen) {
                return true;
            }
        }
        return false;
    }
    if node.kind != TyKind::Named {
        return false;
    }
    if (node.name == known.chunk_seq || node.name == known.slice) && node.n == 1 {
        return true;
    }
    for i in 0..w(node.n) {
        if holds_visit(inout c, arg_of(in c, ty, i), inout seen) {
            return true;
        }
    }
    let adt_index = c.world.lookup(node.name);
    if adt_index == NO_ADT || on_stack(in seen, node.name) {
        return false;
    }
    seen.push(node.name);
    let adt = c.world.adt(adt_index);
    let mut found = false;
    for vi in 0..w(adt.vn) {
        let variant = c.world.variant(add(w(adt.va), vi));
        for fi in 0..w(variant.fc) {
            if !found {
                let field = c.world.field(add(w(variant.fa), fi));
                found = holds_visit(inout c, field.ty, inout seen);
            }
        }
    }
    pop32(inout seen);
    found
}

fn holds_sequence(inout c: Ctx, ty: u32) -> bool {
    let mut seen: ChunkSeq[u32] = ChunkSeq::new[u32]();
    holds_visit(inout c, ty, inout seen)
}

// `fip::is_box_pattern` of the pattern at word `pattern`.
fn box_pattern(inout e: Env, inout c: Ctx, in p: Program, pattern: u64) -> bool {
    if !c.world.box_active || p.op(pattern) != Pat::Constructor {
        return false;
    }
    let body = add(pattern, 3);
    let name = n32(p.op(body));
    if name != c.world.k.box_ && name != e.s_box_box {
        return false;
    }
    p.op(add(body, 2)) == 1 && n32(p.op(add(body, 3))) == e.digit(inout c.names, 0)
}

// `pattern_has_box` of `seq_drop_plan`.
fn pattern_has_box(inout e: Env, inout c: Ctx, in p: Program, pattern: u64) -> bool {
    if box_pattern(inout e, inout c, in p, pattern) {
        return true;
    }
    let kind = p.op(pattern);
    let body = add(pattern, 3);
    if kind == Pat::Tuple {
        let n = p.op(body);
        let mut at = inc(body);
        for i in 0..n {
            if pattern_has_box(inout e, inout c, in p, at) {
                return true;
            }
            at = pattern_end(in p, at);
        }
    } else if kind == Pat::Constructor {
        let n = p.op(add(body, 2));
        let mut at = add(body, 3);
        for i in 0..n {
            if pattern_has_box(inout e, inout c, in p, inc(at)) {
                return true;
            }
            at = pattern_end(in p, inc(at));
        }
    }
    false
}

// The graph instruction that defines each value, or NONE32_64.
fn def_insts(in p: Program, in g: G) -> ChunkSeq[u64] {
    let mut out = filled64(g.nv, NONE32_64);
    for k in 0..g.ni {
        let dest = w(p.inst(add(g.i0, k)).dest);
        if dest < g.nv {
            set64(inout out, dest, k);
        }
    }
    out
}

fn def_op(in p: Program, in g: G, in defs: ChunkSeq[u64], v: u32) -> u8 {
    if w(v) >= defs.len() {
        return 255;
    }
    let k = u64_at(in defs, w(v));
    if k == NONE32_64 {
        255
    } else {
        p.inst(add(g.i0, k)).op
    }
}

// The pass word of a `Read` at operand word `operands`.
fn read_pass(in p: Program, operands: u64) -> u64 {
    p.op(add(operands, 2))
}

fn mark_sym(in syms: Syms, inout set: ChunkSeq[u8], sym: u32) {
    let li = syms.local_of(sym);
    if li != NONE32_64 {
        set8(inout set, li, 1);
    }
}

fn mark_bound(in p: Program, in syms: Syms, inout set: ChunkSeq[u8], pattern: u64) {
    let mut names: ChunkSeq[u32] = ChunkSeq::new[u32]();
    pattern_binds(in p, pattern, inout names);
    for i in 0..names.len() {
        mark_sym(in syms, inout set, u32_at(in names, i));
    }
}

// `fip::borrowed_scrutinees`, by value id.
fn borrowed_scrutinees(in e: Env, in p: Program, in g: G, in syms: Syms) -> ChunkSeq[u8] {
    let mut matched = filled8(g.nv, 0);
    for b in 0..g.nb {
        let blk = p.block(add(g.b0, b));
        if blk.term == Term::Match {
            let v = p.op(blk.ta);
            if v < g.nv {
                set8(inout matched, v, 1);
            }
        }
    }
    // Names by local index: the non-`sink` parameters, then what a
    // borrowed match binds.
    let nl = g.lsym.len();
    let mut names = filled8(nl, 0);
    for li in 0..nl {
        let sym = u32_at(in g.lsym, li);
        if syms.has(sym, S_PARAM) && !syms.has(sym, S_SINK) {
            set8(inout names, li, 1);
        }
    }
    let mut out = filled8(g.nv, 0);
    loop {
        let mut grew = false;
        for k in 0..g.ni {
            let inst = p.inst(add(g.i0, k));
            let dest = w(inst.dest);
            let operands = inst.a;
            if inst.op == Op::Read {
                let li = syms.local_of(n32(p.op(operands)));
                if dest < g.nv
                    && u8_at(in matched, dest) != 0
                    && li != NONE32_64
                    && u8_at(in names, li) != 0
                    && u8_at(in out, dest) == 0
                {
                    set8(inout out, dest, 1);
                    grew = true;
                }
            } else if inst.op == Op::Seq {
                let label = p.pool_row(p.op(operands)).label;
                if dest < g.nv
                    && u8_at(in matched, dest) != 0
                    && u8_at(in out, dest) == 0
                    && (label == e.s_try_get || label == e.s_hoisted_try_get)
                {
                    set8(inout out, dest, 1);
                    grew = true;
                }
            } else if inst.op == Op::Bind {
                let v = p.op(operands);
                if v < g.nv && u8_at(in out, v) != 0 {
                    let mut bound: ChunkSeq[u32] = ChunkSeq::new[u32]();
                    pattern_binds(in p, inc(operands), inout bound);
                    for i in 0..bound.len() {
                        let li = syms.local_of(u32_at(in bound, i));
                        if li != NONE32_64 && u8_at(in names, li) == 0 {
                            set8(inout names, li, 1);
                            grew = true;
                        }
                    }
                }
            }
        }
        if !grew {
            break;
        }
    }
    out
}

fn plan_kind(in plan: ChunkSeq[u8], in syms: Syms, sym: u32) -> u8 {
    let li = syms.local_of(sym);
    if li == NONE32_64 {
        SD_NONE
    } else {
        u8_at(in plan, li)
    }
}

fn owned_or_fields(kind: u8) -> bool {
    kind == SD_OWNED || kind == SD_FIELDS
}

// `fip::seq_drop_plan`, by local index.
//
// TODO(#1282): @vesper/codegen-seq (#1295) ports this and
// `borrowed_scrutinees` too; once both PRs merge, depend on its copy.
fn seq_drop_plan(
    inout e: Env,
    inout c: Ctx,
    in p: Program,
    in g: G,
    in syms: Syms
) -> ChunkSeq[u8] {
    let nl = g.lsym.len();
    let mut plan = filled8(nl, SD_NONE);
    if (e.fn_bits(g.name) & FN_FIP) != 0 {
        return plan;
    }
    let known = c.world.k;
    let mut any = false;
    for li in 0..nl {
        let sym = u32_at(in g.lsym, li);
        let ty = u32_at(in g.lty, li);
        let node = c.types.node(ty);
        let param = syms.has(sym, S_PARAM);
        let mut kind = SD_NONE;
        if node.kind == TyKind::Named && node.name == known.chunk_seq && node.n == 1 {
            kind = SD_SEQ;
        } else if node.kind == TyKind::Named && node.name == known.string && node.n == 0 {
            kind = SD_STR;
        } else if param && needs_drop(inout c, ty) {
            kind = SD_OWNED;
        } else if node.kind == TyKind::Named
            && c.world.lookup(node.name) != NO_ADT
            && !param
            && (holds_sequence(inout c, ty) || needs_drop(inout c, ty))
        {
            kind = SD_FIELDS;
        }
        if kind == SD_NONE || syms.has(sym, S_CAPTURE) || (param && !syms.has(sym, S_SINK)) {
            continue;
        }
        set8(inout plan, li, kind);
        any = true;
    }
    if !any {
        return plan;
    }
    let mut refused = filled8(nl, 0);
    let borrowed = borrowed_scrutinees(in e, in p, in g, in syms);
    let defs = def_insts(in p, in g);
    let mut closure: u64 = u64_at(in e.cl_a, g.fi);
    let mut parts: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for ki in 0..g.ni {
        let inst = p.inst(add(g.i0, ki));
        let operands = inst.a;
        let op = inst.op;
        if op == Op::Read && read_pass(in p, operands) == TyPass::Sink {
            let root = n32(p.op(operands));
            let root_plan = plan_kind(in plan, in syms, root);
            let path_row = p.path(p.op(inc(operands)));
            if (path_row.n > 0 && may_need_drop(inout c, inst.ty) && !owned_or_fields(root_plan))
                || root_plan == SD_STR
            {
                mark_sym(in syms, inout refused, root);
            }
        } else if op == Op::Write {
            let place = n32(p.op(operands));
            let root = place_root(inout c.names, place);
            let root_plan = plan_kind(in plan, in syms, root);
            if (has_dot(in c.names, place) && !owned_or_fields(root_plan))
                || n32(p.op(inc(operands))) != e.s_eq
                || (root_plan == SD_STR && syms.has(root, S_PARAM))
            {
                mark_sym(in syms, inout refused, root);
            }
        } else if op == Op::Bind {
            let v = n32(p.op(operands));
            let pattern = inc(operands);
            let def_opcode = def_op(in p, in g, in defs, v);
            let borrow_read = def_opcode == Op::Read
                && read_pass(in p, p.inst(add(g.i0, u64_at(in defs, w(v)))).a) != TyPass::Sink;
            if borrow_read
                || (w(v) < g.nv && u8_at(in borrowed, w(v)) != 0)
                || (p.op(pattern) != Pat::Bind && pattern_has_box(inout e, inout c, in p, pattern))
            {
                mark_bound(in p, in syms, inout refused, pattern);
            }
        } else if op == Op::Closure {
            let ci = closure;
            closure = inc(closure);
            if u8_at(in e.cl_lent, ci) != 0 {
                continue;
            }
            let at = inc(operands);
            let capture_count = p.op(at);
            let used_start = u64_at(in e.cua, ci);
            let used_count = u64_at(in e.cun, ci);
            for j in 0..capture_count {
                let name = n32(p.op(add(inc(at), wrapping_mul(j, 2))));
                let slot = n32(p.op(add(add(at, 2), wrapping_mul(j, 2))));
                let mut used = false;
                for i in 0..used_count {
                    if u32_at(in e.cu, add(used_start, i)) == name {
                        used = true;
                    }
                }
                if used {
                    mark_sym(in syms, inout refused, name);
                    mark_sym(in syms, inout refused, slot);
                }
            }
            let mt = add(inc(at), wrapping_mul(capture_count, 2));
            for j in 0..p.op(mt) {
                mark_sym(in syms, inout refused, n32(p.op(add(inc(mt), wrapping_mul(j, 2)))));
            }
        } else if op == Op::Handle {
            let at = add(operands, 3);
            let capture_count = p.op(at);
            for j in 0..capture_count {
                let slot = n32(p.op(add(add(at, 2), wrapping_mul(j, 2))));
                if plan_kind(in plan, in syms, slot) == SD_STR {
                    mark_sym(in syms, inout refused, slot);
                }
            }
            let mt = add(inc(at), wrapping_mul(capture_count, 2));
            for j in 0..p.op(mt) {
                mark_sym(in syms, inout refused, n32(p.op(add(inc(mt), wrapping_mul(j, 2)))));
            }
        }
    }
    // A match arm binds through its pattern, not a `let`.
    for b in 0..g.nb {
        let blk = p.block(add(g.b0, b));
        if blk.term == Term::Match {
            let n = p.op(inc(blk.ta));
            let mut at = add(blk.ta, 2);
            for i in 0..n {
                mark_bound(in p, in syms, inout refused, at);
                at = inc(pattern_end(in p, at));
            }
        }
    }
    for li in 0..nl {
        if u8_at(in refused, li) != 0 {
            set8(inout plan, li, SD_NONE);
        }
    }
    plan
}

// The local indices a closure (lent or not) or handler leaves out of
// `replace_drops`' candidates.
fn closure_refusals(
    inout e: Env,
    in p: Program,
    in syms: Syms,
    ii: u64,
    ci: u64,
    inout out: ChunkSeq[u8]
) {
    let inst = p.inst(ii);
    let operands = inst.a;
    let at = if inst.op == Op::Handle {
        add(operands, 3)
    } else {
        inc(operands)
    };
    let capture_count = p.op(at);
    let lent = inst.op == Op::Closure && u8_at(in e.cl_lent, ci) != 0;
    if lent {
        return;
    }
    let used_start = u64_at(in e.cua, ci);
    let used_count = u64_at(in e.cun, ci);
    for j in 0..capture_count {
        let name = n32(p.op(add(inc(at), wrapping_mul(j, 2))));
        let slot = n32(p.op(add(add(at, 2), wrapping_mul(j, 2))));
        let mut used = inst.op == Op::Handle;
        if !used {
            for i in 0..used_count {
                if u32_at(in e.cu, add(used_start, i)) == name {
                    used = true;
                }
            }
        }
        if used {
            mark_sym(in syms, inout out, name);
            mark_sym(in syms, inout out, slot);
        }
    }
    let mt = add(inc(at), wrapping_mul(capture_count, 2));
    for j in 0..p.op(mt) {
        mark_sym(in syms, inout out, n32(p.op(add(inc(mt), wrapping_mul(j, 2)))));
    }
}

// Whether instruction `ii` takes part in `replace_drops`' dataflow (a read
// of a field that owns nothing moves nothing out).
fn replace_moves(inout c: Ctx, in p: Program, ii: u64) -> bool {
    let inst = p.inst(ii);
    if inst.op == Op::Read
        && read_pass(in p, inst.a) == TyPass::Sink
        && p.path(p.op(inc(inst.a))).n > 0
    {
        return may_need_drop(inout c, inst.ty);
    }
    true
}

// One instruction's effect on the maybe-moved candidates (by candidate
// index, `cidx` by local index).
fn replace_step(
    inout c: Ctx,
    in p: Program,
    in e: Env,
    in syms: Syms,
    in cidx: ChunkSeq[u64],
    ii: u64,
    inout state: ChunkSeq[u8],
    base: u64
) {
    let inst = p.inst(ii);
    let operands = inst.a;
    if inst.op == Op::Read && read_pass(in p, operands) == TyPass::Sink {
        let li = syms.local_of(n32(p.op(operands)));
        if li != NONE32_64 && u64_at(in cidx, li) != NONE32_64 {
            set8(inout state, add(base, u64_at(in cidx, li)), 1);
        }
    } else if inst.op == Op::Write {
        let place = n32(p.op(operands));
        if n32(p.op(inc(operands))) == e.s_eq && !has_dot(in c.names, place) {
            let li = syms.local_of(place);
            if li != NONE32_64 && u64_at(in cidx, li) != NONE32_64 {
                set8(inout state, add(base, u64_at(in cidx, li)), 0);
            }
        }
    } else if inst.op == Op::Bind {
        let mut names: ChunkSeq[u32] = ChunkSeq::new[u32]();
        pattern_binds(in p, inc(operands), inout names);
        for i in 0..names.len() {
            let li = syms.local_of(u32_at(in names, i));
            if li != NONE32_64 && u64_at(in cidx, li) != NONE32_64 {
                set8(inout state, add(base, u64_at(in cidx, li)), 0);
            }
        }
    }
}

// `fip::replace_drops` of a top-level graph: the (block, index) of every
// write that frees what it replaces, as 1 by graph instruction.
fn replace_drops(
    inout e: Env,
    inout c: Ctx,
    in p: Program,
    in g: G,
    in syms: Syms
) -> ChunkSeq[u8] {
    let mut out = filled8(g.ni, 0);
    if (e.fn_bits(g.name) & FN_FIP) != 0 {
        return out;
    }
    let nl = g.lsym.len();
    let mut borrowed = filled8(nl, 0);
    let mut cand = filled8(nl, 0);
    let mut any = false;
    for li in 0..nl {
        let sym = u32_at(in g.lsym, li);
        if syms.has(sym, S_CAPTURE) || !may_need_drop(inout c, u32_at(in g.lty, li)) {
            continue;
        }
        if syms.has(sym, S_PARAM) {
            if syms.has(sym, S_SINK) {
                set8(inout cand, li, 1);
                any = true;
            } else if syms.has(sym, S_INOUT) {
                set8(inout borrowed, li, 1);
                any = true;
            }
        } else {
            set8(inout cand, li, 1);
            any = true;
        }
    }
    let mut refused = filled8(nl, 0);
    let mut closure: u64 = u64_at(in e.cl_a, g.fi);
    for k in 0..g.ni {
        let ii = add(g.i0, k);
        let op = p.inst(ii).op;
        if op == Op::Closure || op == Op::Handle {
            let ci = closure;
            if op == Op::Closure {
                closure = inc(closure);
            }
            closure_refusals(inout e, in p, in syms, ii, ci, inout refused);
        }
    }
    let mut cand_count: u64 = 0;
    let mut cidx = filled64(nl, NONE32_64);
    let mut any_borrowed = false;
    for li in 0..nl {
        if u8_at(in refused, li) != 0 {
            set8(inout cand, li, 0);
        }
        if u8_at(in cand, li) != 0 {
            set64(inout cidx, li, cand_count);
            cand_count = inc(cand_count);
        }
        if u8_at(in borrowed, li) != 0 {
            any_borrowed = true;
        }
    }
    if cand_count == 0 && !any_borrowed {
        return out;
    }
    let nb = g.nb;
    let width = if cand_count == 0 { 1 } else { cand_count };
    // exit states, nb x width, and whether each was computed
    let mut exit = filled8(wrapping_mul(nb, width), 0);
    let mut known = filled8(nb, 0);
    let mut state = filled8(width, 0);
    loop {
        let mut changed = false;
        for b in 0..nb {
            replace_entry(in g, in exit, in known, b, width, inout state);
            let blk = p.block(add(g.b0, b));
            for i in 0..blk.ic {
                let ii = add(blk.i0, i);
                if replace_moves(inout c, in p, ii) {
                    replace_step(inout c, in p, in e, in syms, in cidx, ii, inout state, 0);
                }
            }
            let base = wrapping_mul(b, width);
            let mut same = u8_at(in known, b) != 0;
            for j in 0..width {
                if u8_at(in exit, add(base, j)) != u8_at(in state, j) {
                    same = false;
                }
            }
            if !same {
                for j in 0..width {
                    set8(inout exit, add(base, j), u8_at(in state, j));
                }
                set8(inout known, b, 1);
                changed = true;
            }
        }
        if !changed {
            break;
        }
    }
    for b in 0..nb {
        replace_entry(in g, in exit, in known, b, width, inout state);
        let blk = p.block(add(g.b0, b));
        for i in 0..blk.ic {
            let ii = add(blk.i0, i);
            let inst = p.inst(ii);
            if inst.op == Op::Write && n32(p.op(inc(inst.a))) == e.s_eq {
                let root = place_root(inout c.names, n32(p.op(inst.a)));
                let li = syms.local_of(root);
                if li != NONE32_64 {
                    let ci = u64_at(in cidx, li);
                    if u8_at(in borrowed, li) != 0
                        || (ci != NONE32_64 && u8_at(in state, ci) == 0)
                    {
                        set8(inout out, wrapping_sub(ii, g.i0), 1);
                    }
                }
            }
            if replace_moves(inout c, in p, ii) {
                replace_step(inout c, in p, in e, in syms, in cidx, ii, inout state, 0);
            }
        }
    }
    out
}

// The union of the computed exit states of block `b`'s predecessors.
fn replace_entry(
    in g: G,
    in exit: ChunkSeq[u8],
    in known: ChunkSeq[u8],
    b: u64,
    width: u64,
    inout state: ChunkSeq[u8]
) {
    for j in 0..width {
        set8(inout state, j, 0);
    }
    let pred_start = u64_at(in g.qa, b);
    for i in 0..u64_at(in g.qn, b) {
        let pred = w(u32_at(in g.preds, add(pred_start, i)));
        if u8_at(in known, pred) != 0 {
            let base = wrapping_mul(pred, width);
            for j in 0..width {
                if u8_at(in exit, add(base, j)) != 0 {
                    set8(inout state, j, 1);
                }
            }
        }
    }
}

// ----- `fip::temporary_drops` ---------------------------------------------------

const AT_ENTRY: u64 = 18446744073709551615;

// Per value: the call borrows (block, index), jumps (target, k) and other uses.
pub struct Uses {
    // linked lists over the entries below, by value
    bh: ChunkSeq[u64],
    jh: ChunkSeq[u64],
    other: ChunkSeq[u8],
    eb: ChunkSeq[u64],
    ei: ChunkSeq[u64],
    ev: ChunkSeq[u64],
    ej: ChunkSeq[u8],
    enext: ChunkSeq[u64],
}

fn uses_new(nv: u64) -> Uses {
    Uses {
        bh: filled64(nv, NONE32_64),
        jh: filled64(nv, NONE32_64),
        other: filled8(nv, 0),
        eb: ChunkSeq::new[u64](),
        ei: ChunkSeq::new[u64](),
        ev: ChunkSeq::new[u64](),
        ej: ChunkSeq::new[u8](),
        enext: ChunkSeq::new[u64](),
    }
}

impl Uses {
    fn add_borrow(inout self, v: u64, b: u64, i: u64) {
        let entry = self.eb.len();
        self.eb.push(b);
        self.ei.push(i);
        self.ev.push(v);
        self.ej.push(0);
        self.enext.push(u64_at(in self.bh, v));
        set64(inout self.bh, v, entry);
    }

    fn add_jump(inout self, v: u64, b: u64, k: u64) {
        let entry = self.eb.len();
        self.eb.push(b);
        self.ei.push(k);
        self.ev.push(v);
        self.ej.push(1);
        self.enext.push(u64_at(in self.jh, v));
        set64(inout self.jh, v, entry);
    }

    fn count(in self, head: u64) -> u64 {
        let mut n: u64 = 0;
        let mut entry = head;
        loop {
            if entry == NONE32_64 {
                break;
            }
            n = inc(n);
            entry = u64_at(in self.enext, entry);
        }
        n
    }
}

fn sole_jump(in uses: Uses, v: u64) -> bool {
    u8_at(in uses.other, v) == 0
        && u64_at(in uses.bh, v) == NONE32_64
        && uses.count(u64_at(in uses.jh, v)) == 1
}

// Whether the defaulted type is a scalar name with no arguments.
fn scalar_result(inout e: Env, inout c: Ctx, ty: u32) -> bool {
    let defaulted = default_type(inout c.types, ty);
    let node = c.types.node(defaulted);
    node.kind == TyKind::Named
        && node.n == 0
        && (scalar_name(in e, in c, node.name) || node.name == c.world.k.bool_)
}

// `fip::temporary_drops`: each owned temporary as (block, index, value),
// where it is dropped after instruction `index` of `block`, or at the
// block's entry (`AT_ENTRY`).
fn temporary_drops(
    inout e: Env,
    inout c: Ctx,
    in p: Program,
    in g: G,
    in syms: Syms,
    in plan: ChunkSeq[u8],
    inout drop_blocks: ChunkSeq[u64],
    inout drop_insts: ChunkSeq[u64],
    inout drop_values: ChunkSeq[u32]
) {
    let nv = g.nv;
    let nl = g.lsym.len();
    let borrowed = borrowed_scrutinees(in e, in p, in g, in syms);
    let defs = def_insts(in p, in g);
    // Locals bound to a borrow own nothing; neither do the names a
    // borrowed match binds.
    let mut borrow_bound = filled8(nl, 0);
    for k in 0..g.ni {
        let inst = p.inst(add(g.i0, k));
        if inst.op != Op::Bind {
            continue;
        }
        let v = n32(p.op(inst.a));
        let pattern = inc(inst.a);
        if p.op(pattern) == Pat::Bind
            && def_op(in p, in g, in defs, v) == Op::Read
            && read_pass(in p, p.inst(add(g.i0, u64_at(in defs, w(v)))).a) != TyPass::Sink
        {
            mark_sym(in syms, inout borrow_bound, n32(p.op(add(pattern, 3))));
        }
        if w(v) < nv && u8_at(in borrowed, w(v)) != 0 {
            mark_bound(in p, in syms, inout borrow_bound, pattern);
        }
    }
    // The fip call slots (the trailer's first table).
    let func = p.function(g.fi);
    let mut slot = filled8(nv, 0);
    if func.tn > 0 {
        let slot_count = p.op(func.ta);
        for i in 0..slot_count {
            let v = p.op(add(inc(func.ta), wrapping_mul(i, 5)));
            if v < nv {
                set8(inout slot, v, 1);
            }
        }
    }
    let mut uses = uses_new(nv);
    let mut def_b = filled64(nv, NONE32_64);
    let mut def_i = filled64(nv, NONE32_64);
    let mut produced = filled8(nv, 0);
    let mut ops: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut borrows: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for b in 0..g.nb {
        for k in 0..u64_at(in g.pn, b) {
            let pv = w(g.param(b, k));
            if pv < nv {
                set64(inout def_b, pv, b);
                set64(inout def_i, pv, AT_ENTRY);
            }
        }
        let blk = p.block(add(g.b0, b));
        for i in 0..blk.ic {
            let ii = add(blk.i0, i);
            let inst = p.inst(ii);
            let dest = w(inst.dest);
            let operands = inst.a;
            if dest < nv {
                set64(inout def_b, dest, b);
                set64(inout def_i, dest, i);
            }
            let mut owned = false;
            if inst.op == Op::Call || inst.op == Op::Indirect {
                owned = dest >= nv || u8_at(in slot, dest) == 0;
            } else if inst.op == Op::Seq {
                let label = p.pool_row(p.op(operands)).label;
                owned = label == e.s_new || label == e.s_with_capacity;
            } else if inst.op == Op::Read && read_pass(in p, operands) == TyPass::Sink {
                let root = n32(p.op(operands));
                let root_plan = plan_kind(in plan, in syms, root);
                let path_empty = p.path(p.op(inc(operands))).n == 0;
                if path_empty || owned_or_fields(root_plan) {
                    if root_plan == SD_SEQ || root_plan == SD_OWNED || root_plan == SD_FIELDS {
                        owned = true;
                    } else if root_plan == SD_NONE {
                        let li = syms.local_of(root);
                        owned = li != NONE32_64
                            && named0(in c, u32_at(in g.lty, li), c.world.k.string)
                            && !syms.has(root, S_PARAM)
                            && u8_at(in borrow_bound, li) == 0;
                    }
                }
            }
            if owned && dest < nv {
                set8(inout produced, dest, 1);
            }
            borrows.clear();
            if inst.op == Op::Call || inst.op == Op::Indirect {
                let at = inc(operands);
                for j in 0..arg_count(in p, at) {
                    if p.op(arg_word(at, j, 0)) != TyPass::Sink && p.op(arg_word(at, j, 2)) == 0 {
                        borrows.push(n32(p.op(arg_word(at, j, 1))));
                    }
                }
            } else if inst.op == Op::Seq && scalar_result(inout e, inout c, inst.ty) {
                let at = inc(operands);
                for j in 0..arg_count(in p, at) {
                    if p.op(arg_word(at, j, 0)) == 0 && p.op(arg_word(at, j, 2)) == 0 {
                        borrows.push(n32(p.op(arg_word(at, j, 1))));
                    }
                }
            }
            ops.clear();
            push_operands(in p, ii, inout ops);
            let mut taken = filled8(ops.len(), 0);
            for x in 0..borrows.len() {
                let v = u32_at(in borrows, x);
                let mut found = false;
                for y in 0..ops.len() {
                    if !found && u8_at(in taken, y) == 0 && u32_at(in ops, y) == v {
                        set8(inout taken, y, 1);
                        found = true;
                    }
                }
            }
            for x in 0..borrows.len() {
                let v = w(u32_at(in borrows, x));
                if v < nv {
                    uses.add_borrow(v, b, i);
                }
            }
            for y in 0..ops.len() {
                let v = w(u32_at(in ops, y));
                if u8_at(in taken, y) == 0 && v < nv {
                    set8(inout uses.other, v, 1);
                }
            }
        }
        if blk.term == Term::Jump {
            let target = p.op(blk.ta);
            let n = p.op(inc(blk.ta));
            for k in 0..n {
                let v = p.op(add(add(blk.ta, 2), k));
                if v < nv {
                    uses.add_jump(v, target, k);
                }
            }
        } else {
            let ta = u64_at(in g.ta, b);
            for k in 0..u64_at(in g.tn, b) {
                let v = w(u32_at(in g.tv, add(ta, k)));
                if v < nv {
                    set8(inout uses.other, v, 1);
                }
            }
        }
    }
    // Block parameters that receive only owned values used nowhere else:
    // per parameter slot (pa[b] + k), its senders and whether all qualify.
    let param_count = g.params.len();
    loop {
        let mut senders = filled64(param_count, 0);
        let mut bad = filled8(param_count, 0);
        for entry in 0..uses.eb.len() {
            if u8_at(in uses.ej, entry) == 0 {
                continue;
            }
            let b = u64_at(in uses.eb, entry);
            let k = u64_at(in uses.ei, entry);
            if b >= g.nb || k >= u64_at(in g.pn, b) {
                continue;
            }
            let at = add(u64_at(in g.pa, b), k);
            let v = u64_at(in uses.ev, entry);
            set64(inout senders, at, inc(u64_at(in senders, at)));
            if u8_at(in produced, v) == 0 || !sole_jump(in uses, v) {
                set8(inout bad, at, 1);
            }
        }
        let mut grew = false;
        for b in 0..g.nb {
            for k in 0..u64_at(in g.pn, b) {
                let at = add(u64_at(in g.pa, b), k);
                let pv = w(g.param(b, k));
                if pv >= nv || u8_at(in produced, pv) != 0 {
                    continue;
                }
                if u64_at(in senders, at) > 0 && u8_at(in bad, at) == 0 {
                    set8(inout produced, pv, 1);
                    grew = true;
                }
            }
        }
        if !grew {
            break;
        }
    }
    // A value forwarded to an owned parameter is dropped there instead.
    let mut forwarded = filled8(nv, 0);
    for v in 0..nv {
        let mut entry = u64_at(in uses.jh, v);
        loop {
            if entry == NONE32_64 {
                break;
            }
            let target_block = u64_at(in uses.eb, entry);
            let pv = if target_block < g.nb {
                w(g.param(target_block, u64_at(in uses.ei, entry)))
            } else {
                NONE32_64
            };
            if pv < nv && u8_at(in produced, pv) != 0 {
                set8(inout forwarded, v, 1);
            }
            entry = u64_at(in uses.enext, entry);
        }
    }
    for v in 0..nv {
        if u8_at(in produced, v) == 0 || u8_at(in forwarded, v) != 0 {
            continue;
        }
        let b = u64_at(in def_b, v);
        let i = u64_at(in def_i, v);
        if b == NONE32_64 || u8_at(in uses.other, v) != 0 || u64_at(in uses.jh, v) != NONE32_64 {
            continue;
        }
        let mut ok = true;
        let mut last = i;
        let mut any = false;
        let mut entry = u64_at(in uses.bh, v);
        loop {
            if entry == NONE32_64 {
                break;
            }
            let use_block = u64_at(in uses.eb, entry);
            let use_inst = u64_at(in uses.ei, entry);
            if use_block != b || (i != AT_ENTRY && use_inst <= i) {
                ok = false;
            }
            if !any || use_inst > last {
                last = use_inst;
            }
            any = true;
            entry = u64_at(in uses.enext, entry);
        }
        if !ok {
            continue;
        }
        drop_blocks.push(b);
        drop_insts.push(last);
        drop_values.push(n32(v));
    }
}

fn put_seq_drop(inout o: ChunkSeq[u8], kind: u8) {
    if kind == SD_SEQ {
        put(inout o, "seq");
    } else if kind == SD_STR {
        put(inout o, "str");
    } else if kind == SD_OWNED {
        put(inout o, "owned");
    } else {
        put(inout o, "fields");
    }
}

fn put_path(inout o: ChunkSeq[u8], in names: Names, in syms: ChunkSeq[u32], start: u64, n: u64) {
    if n == 0 {
        o.push(45);
        return;
    }
    for i in 0..n {
        if i > 0 {
            o.push(46);
        }
        names.write(u32_at(in syms, add(start, i)), inout o);
    }
}

fn put_value(inout o: ChunkSeq[u8], v: u64) {
    o.push(118);
    push_decimal(inout o, v);
}

// One graph's decisions (src/native_aggregate_decisions.rs
// `function_decisions`).
// ----- small enums as words (`native_aggregates::scalar_enums`, #1330) ------------

// `native_aggregates::MAX_ENUM_WORDS`: the most words a scalar enum may
// have, its tag included.
const MAX_ENUM_WORDS: u64 = 4;
// Shape cache entries, by type id: 0 not computed, 1 no shape, else the
// shape id + 2.
const SC_UNKNOWN: u32 = 0;
const SC_NONE: u32 = 1;
const SC_BASE: u32 = 2;
// A use of a value: an instruction (by graph index) or a block's
// terminator.
const U_INST: u8 = 0;
const U_TERM: u8 = 1;

// The `EnumShape`s met so far, interned by content, so that two values
// have the same shape exactly when their shape ids are equal. Shape `k`
// has the word types wt[wa[k]..wa[k]+wn[k]] (the tag's `u64` left out:
// every shape starts with it) and the variants vr[va[k]..va[k]+vn[k]];
// a variant has its short name and the fields ff[fa[v]..fa[v]+fn[v]],
// each a field name, its word and its byte offset.
pub struct Shapes {
    cache: ChunkSeq[u32],
    wa: ChunkSeq[u64],
    wn: ChunkSeq[u64],
    wt: ChunkSeq[u32],
    va: ChunkSeq[u64],
    vn: ChunkSeq[u64],
    vname: ChunkSeq[u32],
    fa: ChunkSeq[u64],
    fnum: ChunkSeq[u64],
    fname: ChunkSeq[u32],
    fword: ChunkSeq[u64],
    foff: ChunkSeq[i32],
}

fn shapes_new() -> Shapes {
    Shapes {
        cache: ChunkSeq::new[u32](),
        wa: ChunkSeq::new[u64](),
        wn: ChunkSeq::new[u64](),
        wt: ChunkSeq::new[u32](),
        va: ChunkSeq::new[u64](),
        vn: ChunkSeq::new[u64](),
        vname: ChunkSeq::new[u32](),
        fa: ChunkSeq::new[u64](),
        fnum: ChunkSeq::new[u64](),
        fname: ChunkSeq::new[u32](),
        fword: ChunkSeq::new[u64](),
        foff: ChunkSeq::new[i32](),
    }
}

fn i32_at(in seq: ChunkSeq[i32], i: u64) -> i32 {
    seq.try_get(i).unwrap_or(0)
}

impl Shapes {
    fn words(in self, shape: u64) -> u64 {
        inc(u64_at(in self.wn, shape))
    }

    // The variant of shape `shape` named `short`, or NONE32_64.
    fn variant(in self, shape: u64, short: u32) -> u64 {
        let first = u64_at(in self.va, shape);
        for i in 0..u64_at(in self.vn, shape) {
            if u32_at(in self.vname, add(first, i)) == short {
                return add(first, i);
            }
        }
        NONE32_64
    }

    // The word of field `name` of variant `variant`, or NONE32_64.
    fn field_word(in self, variant: u64, name: u32) -> u64 {
        let first = u64_at(in self.fa, variant);
        for i in 0..u64_at(in self.fnum, variant) {
            if u32_at(in self.fname, add(first, i)) == name {
                return u64_at(in self.fword, add(first, i));
            }
        }
        NONE32_64
    }

    // The field of variant `variant` on word `word`, or NONE32_64.
    fn word_field(in self, variant: u64, word: u64) -> u64 {
        let first = u64_at(in self.fa, variant);
        for i in 0..u64_at(in self.fnum, variant) {
            if u64_at(in self.fword, add(first, i)) == word {
                return add(first, i);
            }
        }
        NONE32_64
    }

    // Whether shapes `x` and `y` (the candidate, the last one) are equal.
    fn same(in self, x: u64, y: u64) -> bool {
        if u64_at(in self.wn, x) != u64_at(in self.wn, y)
            || u64_at(in self.vn, x) != u64_at(in self.vn, y)
        {
            return false;
        }
        for i in 0..u64_at(in self.wn, x) {
            if u32_at(in self.wt, add(u64_at(in self.wa, x), i))
                != u32_at(in self.wt, add(u64_at(in self.wa, y), i))
            {
                return false;
            }
        }
        for i in 0..u64_at(in self.vn, x) {
            let vx = add(u64_at(in self.va, x), i);
            let vy = add(u64_at(in self.va, y), i);
            if u32_at(in self.vname, vx) != u32_at(in self.vname, vy)
                || u64_at(in self.fnum, vx) != u64_at(in self.fnum, vy)
            {
                return false;
            }
            for j in 0..u64_at(in self.fnum, vx) {
                let fx = add(u64_at(in self.fa, vx), j);
                let fy = add(u64_at(in self.fa, vy), j);
                if u32_at(in self.fname, fx) != u32_at(in self.fname, fy)
                    || u64_at(in self.fword, fx) != u64_at(in self.fword, fy)
                    || i32_at(in self.foff, fx) != i32_at(in self.foff, fy)
                {
                    return false;
                }
            }
        }
        true
    }

    // Drops the shape being built (the last one) and its rows.
    fn pop_last(inout self) {
        let last = wrapping_sub(self.wa.len(), 1);
        self.wt.truncate(u64_at(in self.wa, last));
        let first_variant = u64_at(in self.va, last);
        if first_variant < self.vname.len() {
            self.fname.truncate(u64_at(in self.fa, first_variant));
            self.fword.truncate(u64_at(in self.fa, first_variant));
            self.foff.truncate(u64_at(in self.fa, first_variant));
        }
        self.vname.truncate(first_variant);
        self.fa.truncate(first_variant);
        self.fnum.truncate(first_variant);
        self.wa.truncate(last);
        self.wn.truncate(last);
        self.va.truncate(last);
        self.vn.truncate(last);
    }
}

// `native_aggregates::word_type`: one integer or `bool` word.
fn word_type(in e: Env, in c: Ctx, ty: u32) -> bool {
    let node = c.types.node(ty);
    if node.kind != TyKind::Named || node.n != 0 {
        return false;
    }
    (c.world.k.is_integer(node.name) && node.name != e.s_i128 && node.name != e.s_u128)
        || node.name == c.world.k.bool_
}

// `native_aggregates::enum_shape` of `ty`, defaulted: the shape id, or
// NONE32_64.
fn enum_shape(inout e: Env, inout c: Ctx, inout sh: Shapes, ty0: u32) -> u64 {
    if ty0 == NONE32 {
        return NONE32_64;
    }
    let ty = default_type(inout c.types, ty0);
    let cached = u32_at(in sh.cache, w(ty));
    if cached == SC_NONE {
        return NONE32_64;
    }
    if cached != SC_UNKNOWN {
        return w(wrapping_sub(cached, SC_BASE));
    }
    let shape = shape_build(inout e, inout c, inout sh, ty);
    let entry = if shape == NONE32_64 {
        SC_NONE
    } else {
        wrapping_add(n32(shape), SC_BASE)
    };
    set_by_symbol(inout sh.cache, ty, entry);
    shape
}

fn shape_build(inout e: Env, inout c: Ctx, inout sh: Shapes, ty: u32) -> u64 {
    if c.world.box_active && mentions_box(in c, ty, 0) {
        return NONE32_64;
    }
    let layout = lay(inout e, inout c, ty);
    if layout == NONE32 {
        return NONE32_64;
    }
    let node = e.ls.node(layout);
    if node.kind != L_ENUM {
        return NONE32_64;
    }
    let shape = sh.wa.len();
    sh.wa.push(sh.wt.len());
    sh.wn.push(0);
    sh.va.push(sh.vname.len());
    sh.vn.push(w(node.n));
    let mut words: u64 = 1;
    for variant_index in 0..w(node.n) {
        let variant = e.ls.lvariant(add(w(node.a), variant_index));
        sh.vname.push(variant.name);
        sh.fa.push(sh.fname.len());
        sh.fnum.push(w(variant.fc));
        for i in 0..w(variant.fc) {
            let field = e.ls.lfield(add(w(variant.fa), i));
            let field_ty = default_type(inout c.types, field.ty);
            if !word_type(in e, in c, field_ty) {
                sh.pop_last();
                return NONE32_64;
            }
            sh.wt.push(field_ty);
            sh.fname.push(field.name);
            sh.fword.push(words);
            sh.foff.push(field.offset);
            words = inc(words);
        }
    }
    set64(inout sh.wn, shape, wrapping_sub(words, 1));
    if words > MAX_ENUM_WORDS {
        sh.pop_last();
        return NONE32_64;
    }
    for existing in 0..shape {
        if sh.same(existing, shape) {
            sh.pop_last();
            return existing;
        }
    }
    shape
}

// Whether the pattern at word `pattern` is a constructor whose fields only bind
// or ignore fields of variant `name` of shape `shape` (`word_fields`).
fn word_fields(inout c: Ctx, in p: Program, in sh: Shapes, shape: u64, pattern: u64) -> bool {
    let body = add(pattern, 3);
    let short = short_name(inout c.names, n32(p.op(body)));
    let variant = sh.variant(shape, short);
    if variant == NONE32_64 {
        return false;
    }
    let n = p.op(add(body, 2));
    let mut at = add(body, 3);
    for i in 0..n {
        let field = n32(p.op(at));
        let sub = inc(at);
        let kind = p.op(sub);
        if sh.field_word(variant, field) == NONE32_64 || (kind != Pat::Bind && kind != Pat::Wild) {
            return false;
        }
        at = pattern_end(in p, sub);
    }
    true
}

// Whether the label of the `Seq` operation in pool row `pool` spells
// `text`, or starts with it when `prefix`.
fn label_is(in p: Program, in names: Names, pool: u64, in text: Str, prefix: bool) -> bool {
    let label = p.pool_row(pool).label;
    let text_bytes = text.as_bytes();
    let n = names.size(label);
    if n < text_bytes.len() || (!prefix && n != text_bytes.len()) {
        return false;
    }
    for i in 0..text_bytes.len() {
        if names.byte(label, i) != u8_at_slice(in text_bytes, i) {
            return false;
        }
    }
    true
}

fn u8_at_slice(in slice: Slice[u8], i: u64) -> u8 {
    slice.try_get(i).unwrap_or(0)
}

// Whether the label of pool row `pool` contains `text`.
fn label_has(in p: Program, in names: Names, pool: u64, in text: Str) -> bool {
    let label = p.pool_row(pool).label;
    let text_bytes = text.as_bytes();
    let n = names.size(label);
    if n < text_bytes.len() {
        return false;
    }
    for start in 0..inc(wrapping_sub(n, text_bytes.len())) {
        let mut all = true;
        for i in 0..text_bytes.len() {
            if all && names.byte(label, add(start, i)) != u8_at_slice(in text_bytes, i) {
                all = false;
            }
        }
        if all {
            return true;
        }
    }
    false
}

// `seq_option_op`: a `Seq` operation that returns a two-word scalar
// `Option[T]` (`Pop`, `Last`, a total wide read, a byte scan).
fn seq_option_op(in p: Program, in names: Names, in sh: Shapes, shape: u64, pool: u64) -> bool {
    let kind = p.pool_row(pool).kind;
    if sh.words(shape) != 2 || (kind != 0 && kind != 7) {
        return false;
    }
    if label_is(in p, in names, pool, "Pop", false)
        || label_is(in p, in names, pool, "Last", false)
    {
        return true;
    }
    if label_is(in p, in names, pool, "Wide(", true)
        || label_is(in p, in names, pool, "Hoisted(Wide(", true)
    {
        return label_has(in p, in names, pool, "write: false")
            && label_has(in p, in names, pool, "total: true");
    }
    label_is(in p, in names, pool, "SumBe16", false)
        || label_is(in p, in names, pool, "BytesEq", false)
        || label_is(in p, in names, pool, "BytesCmp", false)
        || label_is(in p, in names, pool, "FindByte", false)
        || label_is(in p, in names, pool, "FindEither", false)
        || label_is(in p, in names, pool, "FindNotIn", false)
        || label_is(in p, in names, pool, "EqIgnoreAsciiCase", false)
        || label_is(in p, in names, pool, "ExtendAsciiLowercase", false)
        || label_is(in p, in names, pool, "MakeAsciiLowercase {", true)
}

fn ban(in syms: Syms, inout banned: ChunkSeq[u8], sym: u32) {
    let li = syms.local_of(sym);
    if li != NONE32_64 {
        set8(inout banned, li, 1);
    }
}

// The places of an argument list at `at` (its roots), banned.
fn ban_args(in p: Program, in syms: Syms, inout banned: ChunkSeq[u8], at: u64) {
    for j in 0..arg_count(in p, at) {
        let root = p.op(arg_word(at, j, 2));
        if root != 0 {
            ban(in syms, inout banned, n32(wrapping_sub(root, 1)));
        }
    }
}

// The local `sym` names, as its shape + 1 in `cl` (0 when it is not kept
// as words).
fn local_shape(in syms: Syms, in cl: ChunkSeq[u64], sym: u32) -> u64 {
    let li = syms.local_of(sym);
    if li == NONE32_64 {
        0
    } else {
        u64_at(in cl, li)
    }
}

// The decisions of `native_aggregates::scalar_enums` for one graph: the
// shape (+ 1, 0 for none) of each value and local kept as words, and the
// values of each value's words, ws[wa[v]..wa[v]+words]. Word values from
// `first` up to `next` are fresh. `ok` is false when the graph keeps none.
pub struct Plan {
    ok: bool,
    cv: ChunkSeq[u64],
    cl: ChunkSeq[u64],
    wa: ChunkSeq[u64],
    ws: ChunkSeq[u64],
    first: u64,
    next: u64,
}

fn plan_none() -> Plan {
    Plan {
        ok: false,
        cv: ChunkSeq::new[u64](),
        cl: ChunkSeq::new[u64](),
        wa: ChunkSeq::new[u64](),
        ws: ChunkSeq::new[u64](),
        first: 0,
        next: 0,
    }
}

// Whether the type of any value or local of `g` mentions `Box`.
fn mentions_box_anywhere(inout c: Ctx, in g: G) -> bool {
    for v in 0..g.nv {
        let ty = u32_at(in g.vty, v);
        if ty != NONE32 {
            let defaulted = default_type(inout c.types, ty);
            if mentions_box(in c, defaulted, 0) {
                return true;
            }
        }
    }
    for li in 0..g.lsym.len() {
        let defaulted = default_type(inout c.types, u32_at(in g.lty, li));
        if mentions_box(in c, defaulted, 0) {
            return true;
        }
    }
    false
}

// Marks the locals of `g` that an instruction, or the graph's free list,
// keeps in memory.
fn memory_locals(inout c: Ctx, in e: Env, in p: Program, in g: G, in syms: Syms) -> ChunkSeq[u8] {
    let nl = g.lsym.len();
    let mut banned: ChunkSeq[u8] = filled8(nl, 0);
    let mut bound: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for k in 0..g.ni {
        let inst = p.inst(add(g.i0, k));
        let operands = inst.a;
        let op = inst.op;
        if op == Op::Read {
            if p.op(inc(operands)) != 0 || p.op(add(operands, 3)) != 0 {
                ban(in syms, inout banned, n32(p.op(operands)));
            }
        } else if op == Op::Write {
            ban(in syms, inout banned, place_root(inout c.names, n32(p.op(operands))));
        } else if op == Op::Bind {
            if p.op(inc(operands)) != Pat::Bind {
                bound.clear();
                pattern_binds(in p, inc(operands), inout bound);
                for i in 0..bound.len() {
                    ban(in syms, inout banned, u32_at(in bound, i));
                }
            }
        } else if op == Op::Call
            || op == Op::Indirect
            || op == Op::Seq
            || op == Op::Fip
            || op == Op::Tiled
        {
            ban_args(in p, in syms, inout banned, inc(operands));
        } else if op == Op::Closure || op == Op::Handle {
            let mut at = if op == Op::Handle {
                add(operands, 3)
            } else {
                inc(operands)
            };
            let capture_count = p.op(at);
            for j in 0..capture_count {
                ban(in syms, inout banned, n32(p.op(add(inc(at), wrapping_mul(j, 2)))));
                ban(in syms, inout banned, n32(p.op(add(add(at, 2), wrapping_mul(j, 2)))));
            }
            at = add(inc(at), wrapping_mul(capture_count, 2));
            let nm = p.op(at);
            for j in 0..nm {
                ban(in syms, inout banned, n32(p.op(add(inc(at), wrapping_mul(j, 2)))));
            }
        }
    }
    let free_start = u64_at(in e.free_a, g.fi);
    for i in 0..u64_at(in e.free_n, g.fi) {
        ban(in syms, inout banned, u32_at(in e.free, add(free_start, i)));
    }
    banned
}

// The call facts by graph instruction: 1 when the callee returns the words
// of its result's shape.
fn call_flags(in e: Env, in p: Program, in g: G) -> ChunkSeq[u8] {
    let mut call_ok: ChunkSeq[u8] = filled8(g.ni, 0);
    let mut calls = u64_at(in e.ca, g.fi);
    for k in 0..g.ni {
        if p.inst(add(g.i0, k)).op == Op::Call {
            set8(inout call_ok, k, u8_at(in e.cflag, calls));
            calls = inc(calls);
        }
    }
    call_ok
}

// The uses of each value of a graph, as `(kind, at)` pairs in
// `start[v]..start[v] + count[v]`: kind `U_INST` with an instruction index,
// or `U_TERM` with a block index.
struct ValueUses {
    start: ChunkSeq[u64],
    count: ChunkSeq[u64],
    kind: ChunkSeq[u8],
    at: ChunkSeq[u64],
}

fn value_uses(in g: G) -> ValueUses {
    let mut use_count: ChunkSeq[u64] = filled64(g.nv, 0);
    for i in 0..g.opv.len() {
        let v = w(u32_at(in g.opv, i));
        set64(inout use_count, v, inc(u64_at(in use_count, v)));
    }
    for i in 0..g.tv.len() {
        let v = w(u32_at(in g.tv, i));
        set64(inout use_count, v, inc(u64_at(in use_count, v)));
    }
    let mut use_start: ChunkSeq[u64] = filled64(g.nv, 0);
    let mut total: u64 = 0;
    for v in 0..g.nv {
        set64(inout use_start, v, total);
        total = add(total, u64_at(in use_count, v));
    }
    let mut ukind: ChunkSeq[u8] = filled8(total, 0);
    let mut uat: ChunkSeq[u64] = filled64(total, 0);
    let mut fill: ChunkSeq[u64] = filled64(g.nv, 0);
    for k in 0..g.ni {
        let op_start = u64_at(in g.oa, k);
        for i in 0..u64_at(in g.on, k) {
            let v = w(u32_at(in g.opv, add(op_start, i)));
            let at = add(u64_at(in use_start, v), u64_at(in fill, v));
            set8(inout ukind, at, U_INST);
            set64(inout uat, at, k);
            set64(inout fill, v, inc(u64_at(in fill, v)));
        }
    }
    for b in 0..g.nb {
        let term_start = u64_at(in g.ta, b);
        for i in 0..u64_at(in g.tn, b) {
            let v = w(u32_at(in g.tv, add(term_start, i)));
            let at = add(u64_at(in use_start, v), u64_at(in fill, v));
            set8(inout ukind, at, U_TERM);
            set64(inout uat, at, b);
            set64(inout fill, v, inc(u64_at(in fill, v)));
        }
    }
    ValueUses {
        start: use_start,
        count: use_count,
        kind: ukind,
        at: uat,
    }
}

// Clears the shape of every value whose definition or uses cannot be split
// into words, and of every local such a value is bound from or read into,
// until nothing changes.
fn drop_unsplittable(
    inout c: Ctx,
    in p: Program,
    in g: G,
    in syms: Syms,
    in sh: Shapes,
    inout cv: ChunkSeq[u64],
    inout cl: ChunkSeq[u64],
    in call_ok: ChunkSeq[u8],
    in uses: ValueUses,
    ret: u64
) {
    let mut drop_values: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut drop_locals: ChunkSeq[u64] = ChunkSeq::new[u64]();
    loop {
        drop_values.clear();
        drop_locals.clear();
        for v in 0..g.nv {
            let shape1 = u64_at(in cv, v);
            if shape1 == 0 {
                continue;
            }
            let shape = wrapping_sub(shape1, 1);
            let ok = value_def_ok(
                inout c,
                in p,
                in g,
                in syms,
                in sh,
                in cv,
                in cl,
                in call_ok,
                n32(v),
                shape
            )
                && value_uses_ok(
                    inout c,
                    in p,
                    in g,
                    in syms,
                    in sh,
                    in cv,
                    in cl,
                    in uses.kind,
                    in uses.at,
                    u64_at(in uses.start, v),
                    u64_at(in uses.count, v),
                    n32(v),
                    shape,
                    ret
                );
            if !ok {
                drop_values.push(n32(v));
            }
        }
        for k in 0..g.ni {
            let inst = p.inst(add(g.i0, k));
            let operands = inst.a;
            if inst.op == Op::Bind && p.op(inc(operands)) == Pat::Bind {
                let li = syms.local_of(n32(p.op(add(operands, 4))));
                if li != NONE32_64 && u64_at(in cl, li) != 0 && u64_at(in cv, p.op(operands)) == 0 {
                    drop_locals.push(li);
                }
            } else if inst.op == Op::Read {
                let li = syms.local_of(n32(p.op(operands)));
                if li != NONE32_64 && u64_at(in cl, li) != 0 && u64_at(in cv, w(inst.dest)) == 0 {
                    drop_locals.push(li);
                }
            }
        }
        if drop_values.len() == 0 && drop_locals.len() == 0 {
            break;
        }
        for i in 0..drop_values.len() {
            set64(inout cv, w(u32_at(in drop_values, i)), 0);
        }
        for i in 0..drop_locals.len() {
            set64(inout cl, u64_at(in drop_locals, i), 0);
        }
    }
}

// Whether the kept values are worth their words: only a value that some
// `match` or field binding takes apart, or the returned shape, is.
fn worth_words(in p: Program, in g: G, in cv: ChunkSeq[u64], in uses: ValueUses, ret: u64) -> bool {
    let mut taken_apart = false;
    let mut kept = false;
    for v in 0..g.nv {
        if u64_at(in cv, v) == 0 {
            continue;
        }
        kept = true;
        let first_use = u64_at(in uses.start, v);
        for i in 0..u64_at(in uses.count, v) {
            let at = add(first_use, i);
            let user = u64_at(in uses.at, at);
            if u8_at(in uses.kind, at) == U_INST {
                let inst = p.inst(add(g.i0, user));
                if inst.op == Op::Bind && p.op(inc(inst.a)) == Pat::Constructor {
                    taken_apart = true;
                }
            } else if p.block(add(g.b0, user)).term == Term::Match {
                taken_apart = true;
            }
        }
    }
    kept && (taken_apart || ret != 0)
}

// The first value id after every id `g` uses: its typed values, block
// parameters and instruction results. Fresh word values start here.
fn first_fresh_value(in p: Program, in g: G) -> u64 {
    let mut next: u64 = 0;
    let mut seen = false;
    for v in 0..g.nv {
        if u32_at(in g.vty, v) != NONE32 {
            next = v;
            seen = true;
        }
    }
    for b in 0..g.nb {
        for k in 0..u64_at(in g.pn, b) {
            let value = w(g.param(b, k));
            if !seen || value > next {
                next = value;
                seen = true;
            }
        }
    }
    for k in 0..g.ni {
        let value = w(p.inst(add(g.i0, k)).dest);
        if !seen || value > next {
            next = value;
            seen = true;
        }
    }
    if seen {
        next = inc(next);
    }
    next
}

// `native_aggregates::scalar_enums`: which values and locals of graph `g`
// are kept as words, and their word values (`Plan`).
fn scalar_plan(
    inout e: Env,
    inout c: Ctx,
    in p: Program,
    in g: G,
    in syms: Syms,
    inout sh: Shapes
) -> Plan {
    let func = p.function(g.fi);
    // Graphs with fip slots or `Box` drops keep the old lowering.
    for i in 0..func.tn {
        if p.op(add(func.ta, i)) != 0 {
            return plan_none();
        }
    }
    // Shapes of values (shape + 1, 0 for none).
    let mut cv: ChunkSeq[u64] = filled64(g.nv, 0);
    let mut any = false;
    for v in 0..g.nv {
        let value_ty = u32_at(in g.vty, v);
        if value_ty != NONE32 {
            let shape = enum_shape(inout e, inout c, inout sh, value_ty);
            if shape != NONE32_64 {
                set64(inout cv, v, inc(shape));
                any = true;
            }
        }
    }
    if !any {
        return plan_none();
    }
    if c.world.box_active && mentions_box_anywhere(inout c, in g) {
        return plan_none();
    }
    let nl = g.lsym.len();
    let mut cl: ChunkSeq[u64] = filled64(nl, 0);
    for li in 0..nl {
        let sym = u32_at(in g.lsym, li);
        if !syms.has(sym, S_PARAM) && !syms.has(sym, S_CAPTURE) {
            let shape = enum_shape(inout e, inout c, inout sh, u32_at(in g.lty, li));
            if shape != NONE32_64 {
                set64(inout cl, li, inc(shape));
            }
        }
    }
    let banned = memory_locals(inout c, in e, in p, in g, in syms);
    let call_ok = call_flags(in e, in p, in g);
    for li in 0..nl {
        if u8_at(in banned, li) != 0 {
            set64(inout cl, li, 0);
        }
    }
    let uses = value_uses(in g);
    // The shape the graph returns as words (shape + 1, 0 for none).
    let mut ret: u64 = 0;
    if u8_at(in e.ret, g.fi) != 0 {
        let shape = enum_shape(inout e, inout c, inout sh, g.result);
        if shape != NONE32_64 {
            ret = inc(shape);
        }
    }
    drop_unsplittable(
        inout c,
        in p,
        in g,
        in syms,
        in sh,
        inout cv,
        inout cl,
        in call_ok,
        in uses,
        ret
    );
    if !worth_words(in p, in g, in cv, in uses, ret) {
        return plan_none();
    }
    // The words of each value: a constructor's field values, else fresh
    // values after the graph's largest id.
    let mut next = first_fresh_value(in p, in g);
    let first = next;
    let mut wa: ChunkSeq[u64] = filled64(g.nv, 0);
    let mut ws: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for v in 0..g.nv {
        let shape1 = u64_at(in cv, v);
        if shape1 == 0 {
            continue;
        }
        let shape = wrapping_sub(shape1, 1);
        set64(inout wa, v, ws.len());
        let mut variant = NONE32_64;
        let mut data: u64 = 0;
        let def_block = u32_at(in g.def_b, v);
        if def_block != NONE32 {
            let ii = add(g.i0, def_index(in p, in g, n32(v)));
            let inst = p.inst(ii);
            if inst.op == Op::Data {
                let short = short_name(inout c.names, n32(p.op(inst.a)));
                variant = sh.variant(shape, short);
                data = inst.a;
            }
        }
        for word in 0..sh.words(shape) {
            let mut id = NONE32_64;
            if variant != NONE32_64 {
                let field = sh.word_field(variant, word);
                if field != NONE32_64 {
                    let name = u32_at(in sh.fname, field);
                    let n = p.op(inc(data));
                    for j in 0..n {
                        if id == NONE32_64
                            && n32(p.op(add(add(data, 2), wrapping_mul(j, 2)))) == name
                        {
                            id = p.op(add(add(data, 3), wrapping_mul(j, 2)));
                        }
                    }
                }
            }
            if id == NONE32_64 {
                id = next;
                next = inc(next);
            }
            ws.push(id);
        }
    }
    Plan {
        ok: true,
        cv: cv,
        cl: cl,
        wa: wa,
        ws: ws,
        first: first,
        next: next,
    }
}

// The decisions of `scalar_plan` (a top-level graph, with `returns` and
// `call_words` from the facts) as the `enum`, `enumlocal`, `enumcall` and
// `enumret` lines of src/native_aggregate_decisions.rs; nothing when the
// graph keeps its enums in memory.
fn put_scalar_enums(
    inout c: Ctx,
    in p: Program,
    in g: G,
    in sh: Shapes,
    in plan: Plan,
    inout o: ChunkSeq[u8]
) {
    if !plan.ok {
        return;
    }
    for v in 0..g.nv {
        let shape1 = u64_at(in plan.cv, v);
        if shape1 == 0 {
            continue;
        }
        let shape = wrapping_sub(shape1, 1);
        put(inout o, "enum v");
        push_decimal(inout o, v);
        let words_start = u64_at(in plan.wa, v);
        for word in 0..sh.words(shape) {
            put(inout o, " v");
            push_decimal(inout o, u64_at(in plan.ws, add(words_start, word)));
        }
        o.push(10);
    }
    for li in 0..g.lsym.len() {
        if u64_at(in plan.cl, li) != 0 {
            put(inout o, "enumlocal ");
            c.names.write(u32_at(in g.lsym, li), inout o);
            o.push(10);
        }
    }
    // A value is defined once in SSA, but an inlined graph can repeat a
    // call's destination: each value once, as Rust's map has it.
    let mut called: ChunkSeq[u8] = filled8(g.nv, 0);
    for k in 0..g.ni {
        let inst = p.inst(add(g.i0, k));
        if (inst.op == Op::Call || inst.op == Op::Seq) && u64_at(in plan.cv, w(inst.dest)) != 0 {
            set8(inout called, w(inst.dest), 1);
        }
    }
    for v in 0..g.nv {
        if u8_at(in called, v) != 0 {
            put(inout o, "enumcall v");
            push_decimal(inout o, v);
            o.push(10);
        }
    }
    let mut returned: ChunkSeq[u8] = filled8(g.nv, 0);
    for b in 0..g.nb {
        if p.block(add(g.b0, b)).term == Term::Return && u64_at(in g.tn, b) == 1 {
            let v = w(u32_at(in g.tv, u64_at(in g.ta, b)));
            if u64_at(in plan.cv, v) != 0 {
                set8(inout returned, v, 1);
            }
        }
    }
    for v in 0..g.nv {
        if u8_at(in returned, v) != 0 {
            put(inout o, "enumret v");
            push_decimal(inout o, v);
            o.push(10);
        }
    }
}

// The graph index of the instruction defining `v` (which has one).
fn def_index(in p: Program, in g: G, v: u32) -> u64 {
    let b = w(u32_at(in g.def_b, w(v)));
    let blk = p.block(add(g.b0, b));
    add(wrapping_sub(blk.i0, g.i0), w(u32_at(in g.def_i, w(v))))
}

// The index of `v` among the parameters of block `b`.
fn param_index(in g: G, b: u64, v: u32) -> u64 {
    for k in 0..u64_at(in g.pn, b) {
        if g.param(b, k) == v {
            return k;
        }
    }
    NONE32_64
}

// Whether `v`'s definition keeps shape `shape` (`def_ok`).
fn value_def_ok(
    inout c: Ctx,
    in p: Program,
    in g: G,
    in syms: Syms,
    in sh: Shapes,
    in cv: ChunkSeq[u64],
    in cl: ChunkSeq[u64],
    in call_ok: ChunkSeq[u8],
    v: u32,
    shape: u64
) -> bool {
    let shape1 = inc(shape);
    if u32_at(in g.def_b, w(v)) != NONE32 {
        let def_inst = def_index(in p, in g, v);
        let inst = p.inst(add(g.i0, def_inst));
        let operands = inst.a;
        if inst.op == Op::Data {
            let short = short_name(inout c.names, n32(p.op(operands)));
            let variant = sh.variant(shape, short);
            if variant == NONE32_64 {
                return false;
            }
            let n = p.op(inc(operands));
            if u64_at(in sh.fnum, variant) != n {
                return false;
            }
            let first_field = u64_at(in sh.fa, variant);
            for i in 0..u64_at(in sh.fnum, variant) {
                let name = u32_at(in sh.fname, add(first_field, i));
                let mut found = false;
                for j in 0..n {
                    if n32(p.op(add(add(operands, 2), wrapping_mul(j, 2)))) == name {
                        found = true;
                    }
                }
                if !found {
                    return false;
                }
            }
            return true;
        }
        if inst.op == Op::Read {
            return local_shape(in syms, in cl, n32(p.op(operands))) == shape1;
        }
        if inst.op == Op::Call {
            // `capability` is the last operand word of a call.
            let at = inc(operands);
            let nargs = arg_count(in p, at);
            let types_at = add(inc(at), wrapping_mul(nargs, 4));
            let type_count = p.op(types_at);
            let cap = p.op(add(inc(types_at), type_count));
            return cap == 0 && u8_at(in call_ok, def_inst) != 0;
        }
        if inst.op == Op::Seq {
            return seq_option_op(in p, in c.names, in sh, shape, p.op(operands));
        }
        return false;
    }
    let b = u32_at(in g.param_b, w(v));
    if b == NONE32 {
        return false;
    }
    let pos = param_index(in g, w(b), v);
    let pred_start = u64_at(in g.qa, w(b));
    let pred_count = u64_at(in g.qn, w(b));
    if pred_count == 0 {
        return false;
    }
    for i in 0..pred_count {
        let pred = w(u32_at(in g.preds, add(pred_start, i)));
        if p.block(add(g.b0, pred)).term != Term::Jump {
            return false;
        }
        // A jump's terminator operands are its arguments.
        if pos >= u64_at(in g.tn, pred) {
            return false;
        }
        let arg = w(u32_at(in g.tv, add(u64_at(in g.ta, pred), pos)));
        if u64_at(in cv, arg) != shape1 {
            return false;
        }
    }
    true
}

// Whether every use of `v` keeps shape `shape` (`uses_ok`).
fn value_uses_ok(
    inout c: Ctx,
    in p: Program,
    in g: G,
    in syms: Syms,
    in sh: Shapes,
    in cv: ChunkSeq[u64],
    in cl: ChunkSeq[u64],
    in ukind: ChunkSeq[u8],
    in uat: ChunkSeq[u64],
    first_use: u64,
    use_count: u64,
    v: u32,
    shape: u64,
    ret: u64
) -> bool {
    let shape1 = inc(shape);
    for i in 0..use_count {
        let at = add(first_use, i);
        let user = u64_at(in uat, at);
        if u8_at(in ukind, at) == U_INST {
            let inst = p.inst(add(g.i0, user));
            if inst.op != Op::Bind {
                return false;
            }
            let pattern = inc(inst.a);
            let kind = p.op(pattern);
            if kind == Pat::Bind {
                if local_shape(in syms, in cl, n32(p.op(add(pattern, 3)))) != shape1 {
                    return false;
                }
            } else if kind == Pat::Constructor {
                if !word_fields(inout c, in p, in sh, shape, pattern) {
                    return false;
                }
            } else if kind != Pat::Wild {
                return false;
            }
        } else {
            let blk = p.block(add(g.b0, user));
            let term_at = blk.ta;
            if blk.term == Term::Jump {
                let target = p.op(term_at);
                let n = p.op(inc(term_at));
                let param_count = u64_at(in g.pn, target);
                for j in 0..n {
                    if j < param_count && n32(p.op(add(add(term_at, 2), j))) == v {
                        if u64_at(in cv, w(g.param(target, j))) != shape1 {
                            return false;
                        }
                    }
                }
            } else if blk.term == Term::Match {
                let n = p.op(inc(term_at));
                let mut pattern = add(term_at, 2);
                for j in 0..n {
                    let kind = p.op(pattern);
                    if kind == Pat::Constructor {
                        if !word_fields(inout c, in p, in sh, shape, pattern) {
                            return false;
                        }
                    } else if kind != Pat::Wild {
                        return false;
                    }
                    pattern = inc(pattern_end(in p, pattern));
                }
            } else if blk.term == Term::Return {
                if ret != shape1 {
                    return false;
                }
            } else {
                return false;
            }
        }
    }
    true
}

fn function_decisions(
    inout e: Env,
    inout c: Ctx,
    in p: Program,
    inout syms: Syms,
    fi: u64,
    inout sh: Shapes,
    inout o: ChunkSeq[u8]
) {
    let mut g = graph_of(in p, inout c, inout syms, fi);
    put(inout o, "fn ");
    c.names.write(g.name, inout o);
    o.push(10);
    if graph_wide(inout e, in c, in g) {
        put(inout o, "wide\n");
        syms.reset();
        return;
    }
    for li in 0..g.lsym.len() {
        let local_ty = default_type(inout c.types, u32_at(in g.lty, li));
        let pd = plain_data(inout e, inout c, local_ty);
        let mut leaves = leaves_new();
        let sw = split_words(inout e, inout c, local_ty, inout leaves);
        put(inout o, "local ");
        c.names.write(u32_at(in g.lsym, li), inout o);
        if pd {
            put(inout o, " pd=1 sw=");
        } else {
            put(inout o, " pd=0 sw=");
        }
        if sw {
            push_decimal(inout o, leaves.pa.len());
        } else {
            o.push(45);
        }
        o.push(10);
        let mut facts: ChunkSeq[u8] = ChunkSeq::new[u8]();
        if drop_facts(inout c, local_ty, inout facts) {
            put(inout o, "drops ");
            c.names.write(u32_at(in g.lsym, li), inout o);
            o.extend(in facts.as_slice());
            o.push(10);
        }
    }
    for v in 0..g.nv {
        let value_ty = u32_at(in g.vty, v);
        if value_ty == NONE32 {
            continue;
        }
        let mut facts: ChunkSeq[u8] = ChunkSeq::new[u8]();
        if drop_facts(inout c, value_ty, inout facts) {
            put(inout o, "vdrops v");
            push_decimal(inout o, v);
            o.extend(in facts.as_slice());
            o.push(10);
        }
    }
    let seq_drops = seq_drop_plan(inout e, inout c, in p, in g, in syms);
    for li in 0..g.lsym.len() {
        let drop_kind = u8_at(in seq_drops, li);
        if drop_kind != SD_NONE {
            put(inout o, "seqdrop ");
            c.names.write(u32_at(in g.lsym, li), inout o);
            o.push(32);
            put_seq_drop(inout o, drop_kind);
            o.push(10);
        }
    }
    let replaced = replace_drops(inout e, inout c, in p, in g, in syms);
    for b in 0..g.nb {
        let blk = p.block(add(g.b0, b));
        for i in 0..blk.ic {
            if u8_at(in replaced, add(wrapping_sub(blk.i0, g.i0), i)) != 0 {
                put(inout o, "replace ");
                push_decimal(inout o, b);
                o.push(32);
                push_decimal(inout o, i);
                o.push(10);
            }
        }
    }
    let mut temp_blocks: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut temp_insts: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut temp_values: ChunkSeq[u32] = ChunkSeq::new[u32]();
    temporary_drops(
        inout e,
        inout c,
        in p,
        in g,
        in syms,
        in seq_drops,
        inout temp_blocks,
        inout temp_insts,
        inout temp_values
    );
    for temp in 0..temp_blocks.len() {
        put(inout o, "temp ");
        push_decimal(inout o, u64_at(in temp_blocks, temp));
        o.push(32);
        let i = u64_at(in temp_insts, temp);
        if i == AT_ENTRY {
            put(inout o, "entry");
        } else {
            push_decimal(inout o, i);
        }
        put(inout o, " v");
        push_decimal(inout o, w(u32_at(in temp_values, temp)));
        o.push(10);
    }
    let reads = split_locals(inout e, inout c, in p, inout g, in syms);
    for li in 0..g.lsym.len() {
        if u8_at(in g.split, li) == 0 {
            continue;
        }
        put(inout o, "split ");
        c.names.write(u32_at(in g.lsym, li), inout o);
        let mut read = u64_at(in reads.head, li);
        loop {
            if read == END {
                break;
            }
            o.push(32);
            put_path(
                inout o,
                in c.names,
                in reads.rs,
                u64_at(in reads.ra, read),
                u64_at(in reads.rn, read)
            );
            read = u64_at(in reads.next, read);
        }
        o.push(10);
    }
    plan(inout e, inout c, in p, inout g, in syms);
    for v in 0..g.nv {
        let home = g.home(n32(v));
        if home.kind == H_NONE {
            continue;
        }
        put(inout o, "home ");
        put_value(inout o, v);
        if home.kind == H_RESULT {
            put(inout o, " result");
        } else if home.kind == H_FIELD {
            put(inout o, " field ");
            put_value(inout o, home.a);
            o.push(32);
            push_signed(inout o, wrapping_i64(home.b));
        } else {
            put(inout o, " place ");
            c.names.write(n32(home.a), inout o);
            o.push(32);
            push_decimal(inout o, home.b);
            o.push(32);
            push_decimal(inout o, home.c);
        }
        o.push(10);
    }
    // `split_sources`.
    for b in 0..g.nb {
        let blk = p.block(add(g.b0, b));
        for at in 1..blk.ic {
            let first = p.inst(add(blk.i0, wrapping_sub(at, 1)));
            let second = p.inst(add(blk.i0, at));
            if first.op != Op::Read || second.op != Op::Bind {
                continue;
            }
            let value = n32(p.op(second.a));
            let pattern = inc(second.a);
            if value != first.dest || g.uses_of(value) != 1 || p.op(pattern) != Pat::Bind {
                continue;
            }
            let bound_name = n32(p.op(add(pattern, 3)));
            if g.split_local(in syms, bound_name) {
                put(inout o, "source ");
                put_value(inout o, w(value));
                o.push(32);
                c.names.write(bound_name, inout o);
                o.push(10);
            }
        }
    }
    let plan = scalar_plan(inout e, inout c, in p, in g, in syms, inout sh);
    put_scalar_enums(inout c, in p, in g, in sh, in plan, inout o);
    syms.reset();
}

// The harness entry (tests/self_host_codegen_aggregates.rs): the decisions
// of every graph the native optimize path plans, packed by `pack_text`.
pub fn aggregate_decisions(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mut reader = Reader { pos: 0 };
    let mut c = read_ctx(inout reader, in bytes);
    let p = read_program(inout reader, in bytes, in c);
    let mut e = read_env(inout reader, in bytes, inout c.names, p.fn_count());
    let mut syms = syms_new();
    let mut sh = shapes_new();
    let mut o: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for fi in 0..p.fn_count() {
        let name = p.function(fi).name;
        if (e.fn_bits(name) & FN_FIP) != 0 {
            continue;
        }
        function_decisions(inout e, inout c, in p, inout syms, fi, inout sh, inout o);
    }
    pack_text(in o)
}

// ----- the scalar-enum rewrite ------------------------------------------------
//
// The graph `native_aggregates::scalar_enums` returns, made on the
// @vesper/place-ir tables: a constructor of a kept value becomes the
// constants of its tag and unused words, a read of a kept local reads its
// `$wordN` locals, a binding binds the words, block parameters and jump
// arguments carry the words, and a `match` tests the tag word with literal
// arms. The tables only grow: the function row points at a new header and
// new blocks; an instruction that stays keeps its row's operand words.

fn copy_word(inout p: Program, i: u64) {
    let word = p.op(i);
    let tag = p.tag(i);
    p.put(word, tag);
}

// The word of a header's value count (`values_at` of @vesper/bounds-hoist).
fn values_word(in p: Program, ha: u64) -> u64 {
    let mut at = ha;
    let np = p.op(at);
    at = inc(at);
    for i in 0..np {
        let k = p.op(add(at, 2));
        at = add(add(at, 6), k);
    }
    at = add(at, 2);
    let nb = p.op(at);
    at = add(inc(at), wrapping_mul(nb, 2));
    let nc = p.op(at);
    add(inc(at), nc)
}

// The local `{n}$word{word}`.
fn word_local(inout names: Names, base: u32, word: u64) -> u32 {
    let mut text: ChunkSeq[u8] = ChunkSeq::new[u8]();
    names.write(base, inout text);
    put(inout text, "$word");
    push_decimal(inout text, word);
    names.intern(in text.as_slice())
}

// The type of word `word` of shape `shape` (`t_u64` for the tag).
fn word_ty(in sh: Shapes, shape: u64, word: u64, t_u64: u32) -> u32 {
    if word == 0 {
        t_u64
    } else {
        u32_at(in sh.wt, add(u64_at(in sh.wa, shape), wrapping_sub(word, 1)))
    }
}

// The tag of variant `name` (a constructor's name symbol) of shape `shape`, or
// NONE32_64.
fn variant_tag(inout c: Ctx, in sh: Shapes, shape: u64, name: u32) -> u64 {
    let short = short_name(inout c.names, name);
    let variant = sh.variant(shape, short);
    if variant == NONE32_64 {
        NONE32_64
    } else {
        wrapping_sub(variant, u64_at(in sh.va, shape))
    }
}

// A new instruction row of `inst`'s token over the operands from `a`.
fn derived_row(inst: InstRow, dest: u64, ty: u32, op: u8, a: u64, n: u64, span: bool) -> InstRow {
    InstRow {
        dest: n32(dest),
        ty: ty,
        s0: if span { inst.s0 } else { 0 },
        s1: if span { inst.s1 } else { 0 },
        has_token: inst.has_token,
        tin: inst.tin,
        tout: inst.tout,
        fallible: 0,
        op: op,
        a: a,
        n: n
    }
}

// The word of value `v`, or `v` itself when it is not kept as words.
fn push_expanded(inout p: Program, in sh: Shapes, in plan: Plan, v: u64, inout n: u64) {
    let shape1 = u64_at(in plan.cv, v);
    if shape1 == 0 {
        p.put(v, Tag::Value);
        n = inc(n);
        return;
    }
    let shape = wrapping_sub(shape1, 1);
    let words_start = u64_at(in plan.wa, v);
    for word in 0..sh.words(shape) {
        p.put(u64_at(in plan.ws, add(words_start, word)), Tag::Value);
        n = inc(n);
    }
}

// The rewritten instructions of the instruction at program row `ii`.
fn rewrite_inst(
    inout c: Ctx,
    inout p: Program,
    in sh: Shapes,
    in plan: Plan,
    ii: u64,
    t_u64: u32,
    t_unit: u32,
    inout fresh: ChunkSeq[u64],
    inout next: u64,
    inout rows: ChunkSeq[InstRow]
) {
    let inst = p.inst(ii);
    let operands = inst.a;
    let dest = w(inst.dest);
    let dest_shape1 = u64_at(in plan.cv, dest);
    if inst.op == Op::Data && dest_shape1 != 0 {
        let shape = wrapping_sub(dest_shape1, 1);
        let tag = variant_tag(inout c, in sh, shape, n32(p.op(operands)));
        let variant = add(u64_at(in sh.va, shape), tag);
        let words_start = u64_at(in plan.wa, dest);
        for word in 0..sh.words(shape) {
            let id = u64_at(in plan.ws, add(words_start, word));
            let ty = word_ty(in sh, shape, word, t_u64);
            let mut lit = Lit::Int;
            let mut lo: u64 = 0;
            if word == 0 {
                lo = tag;
            } else if sh.word_field(variant, word) != NONE32_64 {
                continue;
            } else if c.types.node(ty).name == c.world.k.bool_ {
                lit = Lit::Bool;
            }
            let at = p.ops.len();
            p.put(lit, Tag::Raw);
            p.put(lo, Tag::Raw);
            p.put(0, Tag::Raw);
            rows.push(derived_row(inst, id, ty, Op::Const, at, 3, false));
        }
        return;
    }
    if inst.op == Op::Read && dest_shape1 != 0 {
        let shape = wrapping_sub(dest_shape1, 1);
        let root = n32(p.op(operands));
        let pass = p.op(add(operands, 2));
        let words_start = u64_at(in plan.wa, dest);
        for word in 0..sh.words(shape) {
            let id = u64_at(in plan.ws, add(words_start, word));
            let ty = word_ty(in sh, shape, word, t_u64);
            let local = word_local(inout c.names, root, word);
            let at = p.ops.len();
            p.put(w(local), Tag::Name);
            p.put(0, Tag::Path);
            p.put(pass, Tag::Raw);
            p.put(0, Tag::Raw);
            rows.push(derived_row(inst, id, ty, Op::Read, at, 4, true));
        }
        return;
    }
    if inst.op == Op::Bind && u64_at(in plan.cv, p.op(operands)) != 0 {
        let value = p.op(operands);
        let shape = wrapping_sub(u64_at(in plan.cv, value), 1);
        let words_start = u64_at(in plan.wa, value);
        let pattern = inc(operands);
        // The bindings: (name, value, span start, end).
        let mut bind_names: ChunkSeq[u32] = ChunkSeq::new[u32]();
        let mut bind_values: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let mut span_starts: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let mut span_ends: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let kind = p.op(pattern);
        if kind == Pat::Bind {
            let bound_name = n32(p.op(add(pattern, 3)));
            for word in 0..sh.words(shape) {
                bind_names.push(word_local(inout c.names, bound_name, word));
                bind_values.push(u64_at(in plan.ws, add(words_start, word)));
                span_starts.push(p.op(inc(pattern)));
                span_ends.push(p.op(add(pattern, 2)));
            }
        } else if kind == Pat::Constructor {
            let tag = variant_tag(inout c, in sh, shape, n32(p.op(add(pattern, 3))));
            let variant = add(u64_at(in sh.va, shape), tag);
            let field_count = p.op(add(pattern, 5));
            let mut at = add(pattern, 6);
            for j in 0..field_count {
                let field = n32(p.op(at));
                let sub = inc(at);
                if p.op(sub) == Pat::Bind {
                    let word = sh.field_word(variant, field);
                    if word != NONE32_64 {
                        bind_names.push(n32(p.op(add(sub, 3))));
                        bind_values.push(u64_at(in plan.ws, add(words_start, word)));
                        span_starts.push(p.op(inc(sub)));
                        span_ends.push(p.op(add(sub, 2)));
                    }
                }
                at = pattern_end(in p, sub);
            }
        }
        if bind_names.len() == 0 {
            rows.push(derived_row(inst, dest, inst.ty, Op::Unit, p.ops.len(), 0, false));
            return;
        }
        for j in 0..bind_names.len() {
            let bind_dest = if j == 0 {
                dest
            } else {
                let fresh_id = next;
                next = inc(next);
                fresh.push(fresh_id);
                fresh_id
            };
            let at = p.ops.len();
            p.put(u64_at(in bind_values, j), Tag::Value);
            p.put(Pat::Bind, Tag::Raw);
            p.put(u64_at(in span_starts, j), Tag::Raw);
            p.put(u64_at(in span_ends, j), Tag::Raw);
            p.put(w(u32_at(in bind_names, j)), Tag::Name);
            rows.push(derived_row(inst, bind_dest, inst.ty, Op::Bind, at, 5, true));
        }
        return;
    }
    rows.push(inst);
}

// The rewrite of graph `g` by `plan` (`scalar_enums`' new `FunctionIr`).
fn rewrite_scalar_enums(
    inout c: Ctx,
    inout p: Program,
    in g: G,
    in syms: Syms,
    in sh: Shapes,
    in plan: Plan
) {
    if !plan.ok {
        return;
    }
    let func = p.function(g.fi);
    let s_u64 = c.names.intern(in "u64".as_bytes());
    let t_u64 = c.types.named0(s_u64);
    let none: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let t_unit = c.types.tuple(in none);
    let mut next = plan.next;
    let mut fresh: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut blocks: ChunkSeq[BlockRow] = ChunkSeq::new[BlockRow]();
    let mut rows: ChunkSeq[InstRow] = ChunkSeq::new[InstRow]();
    for b in 0..func.bc {
        let block = p.block(add(func.b0, b));
        rows.clear();
        for i in 0..block.ic {
            rewrite_inst(
                inout c,
                inout p,
                in sh,
                in plan,
                add(block.i0, i),
                t_u64,
                t_unit,
                inout fresh,
                inout next,
                inout rows
            );
        }
        let i0 = p.insts.len();
        for i in 0..rows.len() {
            let row = match rows.try_get(i) {
                Option::Some(x) => x,
                Option::None => p.inst(0),
            };
            p.insts.push(row);
        }
        // The header: tokens as they are, then the parameters' words.
        let ha = p.ops.len();
        let incoming_count = p.op(inc(block.ha));
        let params_at = add(add(block.ha, 2), wrapping_mul(incoming_count, 2));
        for word_at in block.ha..inc(params_at) {
            copy_word(inout p, word_at);
        }
        let param_words_at = p.ops.len();
        p.put(0, Tag::Raw);
        let mut param_words: u64 = 0;
        for j in 0..p.op(inc(params_at)) {
            let v = p.op(add(add(params_at, 2), j));
            push_expanded(inout p, in sh, in plan, v, inout param_words);
        }
        let ok = p.ops.try_set(param_words_at, param_words);
        let hn = wrapping_sub(p.ops.len(), ha);
        let mut ta = block.ta;
        let mut tn = block.tn;
        if block.term == Term::Jump {
            ta = p.ops.len();
            copy_word(inout p, block.ta);
            let arg_words_at = p.ops.len();
            p.put(0, Tag::Raw);
            let mut arg_words: u64 = 0;
            for j in 0..p.op(inc(block.ta)) {
                let v = p.op(add(add(block.ta, 2), j));
                push_expanded(inout p, in sh, in plan, v, inout arg_words);
            }
            let ok2 = p.ops.try_set(arg_words_at, arg_words);
            tn = wrapping_sub(p.ops.len(), ta);
        } else if block.term == Term::Match && u64_at(in plan.cv, p.op(block.ta)) != 0 {
            let v = p.op(block.ta);
            let shape = wrapping_sub(u64_at(in plan.cv, v), 1);
            let arms = p.op(inc(block.ta));
            ta = p.ops.len();
            p.put(u64_at(in plan.ws, u64_at(in plan.wa, v)), Tag::Value);
            p.put(arms, Tag::Raw);
            let mut pattern = add(block.ta, 2);
            for j in 0..arms {
                let s0 = p.op(inc(pattern));
                let s1 = p.op(add(pattern, 2));
                if p.op(pattern) == Pat::Constructor && inc(j) != arms {
                    let mut tag = variant_tag(inout c, in sh, shape, n32(p.op(add(pattern, 3))));
                    if tag == NONE32_64 {
                        tag = 0;
                    }
                    p.put(Pat::Literal, Tag::Raw);
                    p.put(s0, Tag::Raw);
                    p.put(s1, Tag::Raw);
                    p.put(Lit::Int, Tag::Raw);
                    p.put(tag, Tag::Raw);
                    p.put(0, Tag::Raw);
                } else {
                    p.put(Pat::Wild, Tag::Raw);
                    p.put(s0, Tag::Raw);
                    p.put(s1, Tag::Raw);
                }
                pattern = pattern_end(in p, pattern);
                copy_word(inout p, pattern);
                pattern = inc(pattern);
            }
            tn = wrapping_sub(p.ops.len(), ta);
        }
        blocks.push(BlockRow {
            ha: ha,
            hn: hn,
            i0: i0,
            ic: rows.len(),
            term: block.term,
            ta: ta,
            tn: tn
        });
    }
    let b0 = p.blocks.len();
    for i in 0..blocks.len() {
        let row = match blocks.try_get(i) {
            Option::Some(x) => x,
            Option::None => p.block(0),
        };
        p.blocks.push(row);
    }
    // The header: as it was up to the value table, which gains the fresh
    // words and bindings; the kept locals become their `$wordN` locals.
    let values_at = values_word(in p, func.ha);
    let ha = p.ops.len();
    for word_at in func.ha..values_at {
        copy_word(inout p, word_at);
    }
    let value_count = p.op(values_at);
    let mut nfresh: u64 = 0;
    for v in 0..g.nv {
        let shape1 = u64_at(in plan.cv, v);
        if shape1 != 0 {
            let shape = wrapping_sub(shape1, 1);
            for word in 0..sh.words(shape) {
                if u64_at(in plan.ws, add(u64_at(in plan.wa, v), word)) >= plan.first {
                    nfresh = inc(nfresh);
                }
            }
        }
    }
    p.put(add(add(value_count, nfresh), fresh.len()), Tag::Raw);
    for i in 0..wrapping_mul(value_count, 2) {
        copy_word(inout p, add(inc(values_at), i));
    }
    for v in 0..g.nv {
        let shape1 = u64_at(in plan.cv, v);
        if shape1 != 0 {
            let shape = wrapping_sub(shape1, 1);
            for word in 0..sh.words(shape) {
                let id = u64_at(in plan.ws, add(u64_at(in plan.wa, v), word));
                if id >= plan.first {
                    p.put(id, Tag::Value);
                    p.put(w(word_ty(in sh, shape, word, t_u64)), Tag::Type);
                }
            }
        }
    }
    for i in 0..fresh.len() {
        p.put(u64_at(in fresh, i), Tag::Value);
        p.put(w(t_unit), Tag::Type);
    }
    let locals_at = add(inc(values_at), wrapping_mul(value_count, 2));
    let nl = p.op(locals_at);
    let nl_at = p.ops.len();
    p.put(0, Tag::Raw);
    let mut count: u64 = 0;
    for i in 0..nl {
        let at = add(inc(locals_at), wrapping_mul(i, 2));
        let li = syms.local_of(n32(p.op(at)));
        if li != NONE32_64 && u64_at(in plan.cl, li) != 0 {
            continue;
        }
        copy_word(inout p, at);
        copy_word(inout p, inc(at));
        count = inc(count);
    }
    for li in 0..g.lsym.len() {
        let shape1 = u64_at(in plan.cl, li);
        if shape1 != 0 {
            let shape = wrapping_sub(shape1, 1);
            for word in 0..sh.words(shape) {
                let local = word_local(inout c.names, u32_at(in g.lsym, li), word);
                p.put(w(local), Tag::Name);
                p.put(w(word_ty(in sh, shape, word, t_u64)), Tag::Type);
                count = inc(count);
            }
        }
    }
    let ok = p.ops.try_set(nl_at, count);
    let hn = wrapping_sub(p.ops.len(), ha);
    let ok2 = p.fns.try_set(
        g.fi,
        FnRow { name: func.name, ha: ha, hn: hn, b0: b0, bc: func.bc, ta: func.ta, tn: func.tn }
    );
}

// The harness entry of the rewrite (tests/self_host_codegen_aggregates.rs):
// the indices of the graphs left to Rust (wide integers), then the program
// with every other graph rewritten by `rewrite_scalar_enums`, written by
// `put_program`.
pub fn scalar_enum_rewrite(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mut reader = Reader { pos: 0 };
    let mut c = read_ctx(inout reader, in bytes);
    let mut p = read_program(inout reader, in bytes, in c);
    let mut e = read_env(inout reader, in bytes, inout c.names, p.fn_count());
    let mut syms = syms_new();
    let mut sh = shapes_new();
    let mut wide: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for fi in 0..p.fn_count() {
        let name = p.function(fi).name;
        if (e.fn_bits(name) & FN_FIP) != 0 {
            continue;
        }
        let g = graph_of(in p, inout c, inout syms, fi);
        if graph_wide(inout e, in c, in g) {
            wide.push(fi);
        } else {
            let plan = scalar_plan(inout e, inout c, in p, in g, in syms, inout sh);
            rewrite_scalar_enums(inout c, inout p, in g, in syms, in sh, in plan);
        }
        syms.reset();
    }
    let mut o: ChunkSeq[u64] = ChunkSeq::new[u64]();
    o.push(wide.len());
    for i in 0..wide.len() {
        o.push(u64_at(in wide, i));
    }
    put_program(in p, in c.types, in c.names, inout o);
    o
}

// ----- the scalar-enum words of a program (the native walk's body hook) -------

// What `scalar_enum_words` kept as words in each rewritten graph: for
// program function `f`, value id `v` < `nv[f]` has its words
// `words[start[base[f] + v] - 1..][..count[base[f] + v]]` (start 0: kept
// in memory), and the graph returns its result as `ret[f]` words (0 for a
// result in memory or no rewrite).
pub struct EnumWords {
    base: ChunkSeq[u64],
    nv: ChunkSeq[u64],
    start: ChunkSeq[u64],
    count: ChunkSeq[u64],
    words: ChunkSeq[u64],
    ret: ChunkSeq[u64],
}

impl EnumWords {
    // The number of words value `v` of function `fi` is kept as, 0 when it
    // is not.
    pub fn count(in self, fi: u64, v: u64) -> u64 {
        if fi >= self.nv.len() || v >= u64_at(in self.nv, fi) {
            return 0;
        }
        u64_at(in self.count, add(u64_at(in self.base, fi), v))
    }

    // The `k`-th word value of value `v` of function `fi` (`count` > k).
    pub fn word(in self, fi: u64, v: u64, k: u64) -> u64 {
        let at = add(u64_at(in self.base, fi), v);
        u64_at(in self.words, add(wrapping_sub(u64_at(in self.start, at), 1), k))
    }

    // How many words function `fi` returns its result as (0: in memory).
    pub fn returns(in self, fi: u64) -> u64 {
        u64_at(in self.ret, fi)
    }
}

// No graph rewritten (an input without the facts, or the unoptimized path).
pub fn enum_words_none() -> EnumWords {
    EnumWords {
        base: ChunkSeq::new[u64](),
        nv: ChunkSeq::new[u64](),
        start: ChunkSeq::new[u64](),
        count: ChunkSeq::new[u64](),
        words: ChunkSeq::new[u64](),
        ret: ChunkSeq::new[u64](),
    }
}

// `scalar_enum_rewrite` in place (`Codegen::ir_graph_at`'s top-level
// `scalar_enums` on the optimize path): reads the facts that follow the
// program in `bytes` at `reader`, rewrites every graph that keeps small
// enums as words (all but `fip` functions and graphs with wide integers)
// and answers which values it kept and as which words.
pub fn scalar_enum_words(
    inout c: Ctx,
    inout p: Program,
    inout reader: Reader,
    in bytes: Slice[u8]
) -> EnumWords {
    let mut e = read_env(inout reader, in bytes, inout c.names, p.fn_count());
    let mut syms = syms_new();
    let mut sh = shapes_new();
    let mut out = enum_words_none();
    for fi in 0..p.fn_count() {
        out.base.push(out.start.len());
        let name = p.function(fi).name;
        if (e.fn_bits(name) & FN_FIP) != 0 {
            out.nv.push(0);
            out.ret.push(0);
            continue;
        }
        let g = graph_of(in p, inout c, inout syms, fi);
        if graph_wide(inout e, in c, in g) {
            out.nv.push(0);
            out.ret.push(0);
            syms.reset();
            continue;
        }
        let plan = scalar_plan(inout e, inout c, in p, in g, in syms, inout sh);
        if !plan.ok {
            out.nv.push(0);
            out.ret.push(0);
            syms.reset();
            continue;
        }
        out.nv.push(g.nv);
        for v in 0..g.nv {
            let shape1 = u64_at(in plan.cv, v);
            if shape1 == 0 {
                out.start.push(0);
                out.count.push(0);
            } else {
                let n = sh.words(wrapping_sub(shape1, 1));
                out.start.push(inc(out.words.len()));
                out.count.push(n);
                let at = u64_at(in plan.wa, v);
                for k in 0..n {
                    out.words.push(u64_at(in plan.ws, add(at, k)));
                }
            }
        }
        let mut ret: u64 = 0;
        if u8_at(in e.ret, fi) != 0 {
            let shape = enum_shape(inout e, inout c, inout sh, g.result);
            if shape != NONE32_64 {
                ret = sh.words(shape);
            }
        }
        out.ret.push(ret);
        rewrite_scalar_enums(inout c, inout p, in g, in syms, in sh, in plan);
        syms.reset();
    }
    out
}
