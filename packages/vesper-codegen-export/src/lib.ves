// @vesper/codegen-export: the export ABI of `vesper build --lib` in Vesper
// (self-hosting wave SH4 lane 12, #1286). It ports src/native_export.rs
// and src/native_export/**.
//
// Part 1 is the Rust binding generator (src/native_export/binding.rs,
// binding_v2.rs, binding_v4.rs): from a library interface and the binding
// options it writes the binding text byte for byte as Rust does.
//
// - iface.ves: the `LibraryInterface` tables and the type predicates.
// - text.ves: text building and sorted string sets.
// - binding.ves: the v1 generator and the shared pieces.
// - binding_v2.ves: the v2 and v3 generator.
// - binding_v4.ves: the v4 additions (trees, sequence views, lent handles).
// - handoff.ves: the planner's answer as the binding generator's input
//   (#2270), so plan, interface file and binding chain in Vesper.
//
// `binding_text` is the harness entry (tests/self_host_codegen_export.rs,
// whose words.rs is the Rust half of the input).

use @vesper/check-data::pack_text;
use @vesper/check-data::input::Reader;
use @vesper/check-data::util::{put_text_words};
use self::handoff::{binding_input_of_plan};
use self::iface::{Iface, read_iface};
use self::binding::{Gen, binding_v1, gen_new};
use self::binding_v2::{binding_v2};
use self::directives::{parse_directives};
use self::json::{interface_json};
use self::plan::{plan_bytes, plan_words};
use self::text::{TEXT_CAPACITY, WORD_BYTES, WORD_ROUND_UP};

// `rust_binding(interface, options)`.
pub fn rust_binding(sink i: Iface) -> ChunkSeq[u8] {
    let g = gen_new(i);
    let mut out = ChunkSeq::with_capacity[u8](TEXT_CAPACITY);
    if g.i.is_v2() {
        binding_v2(in g, inout out);
    } else {
        binding_v1(in g, inout out);
    }
    out
}

// Harness entry: the binding text of the encoded interface and options.
pub fn binding_text(in input: Str) -> ChunkSeq[u64] {
    let i = read_iface(in input.as_bytes());
    let out = rust_binding(i);
    pack_text(in out)
}

// Harness entry: `plan_with` of the encoded inputs (plan.ves).
pub fn export_plan(in input: Str) -> ChunkSeq[u64] {
    plan_words(in input)
}

// Harness entry: `interface_json` of the encoded interface (json.ves).
pub fn interface_text(in input: Str) -> ChunkSeq[u64] {
    let i = read_iface(in input.as_bytes());
    let out = interface_json(in i);
    pack_text(in out)
}

// `interface_json` of the encoded interface's bytes (the hybrid's
// `interface_json` hook).
pub fn interface_text_bytes(in input: Slice[u8]) -> ChunkSeq[u8] {
    let i = read_iface(in input);
    interface_json(in i)
}

// `plan_with` of the encoded inputs' bytes, as words (the hybrid's
// `plan` hook).
pub fn export_plan_bytes(in input: Slice[u8]) -> ChunkSeq[u64] {
    plan_bytes(in input)
}

// Harness entry: `Directives::parse` of the encoded source and target, as
// a dump (directives.ves).
pub fn directives_dump(in input: Str) -> ChunkSeq[u64] {
    parse_directives(in input)
}

// Harness entry: the binding generator's input for a planner answer
// (handoff.ves). `input` is a types-path flag word, the types path (a
// length word and its bytes, zero padded), then the answer's words. The
// result is 1 and the input's bytes as `put_text_words` words, or 0 when
// the planner refused.
pub fn plan_binding_input(in input: Str) -> ChunkSeq[u64] {
    let b = input.as_bytes();
    let mut r = Reader { pos: 0 };
    let has_types_path = r.word(in b) != 0;
    let len = r.word(in b);
    let start = r.pos;
    let end = wrapping_add(start, len);
    r.pos = wrapping_add(
        start,
        wrapping_mul(wrapping_add(len, WORD_ROUND_UP) / WORD_BYTES, WORD_BYTES)
    );
    let mut answer = ChunkSeq::new[u64]();
    loop {
        if r.pos >= b.len() {
            break;
        }
        answer.push(r.word(in b));
    }
    let mut out = ChunkSeq::new[u64]();
    match binding_input_of_plan(in answer, has_types_path, in b[start..end]) {
        Option::Some(bytes) => {
            out.push(1);
            put_text_words(inout out, in bytes.as_slice());
        },
        Option::None => out.push(0),
    }
    out
}

// The interface file and the binding text of a planner answer, with the
// optional types path, or None when the planner refused: `vesper build
// --lib`'s `--interface` and `--rust-binding` outputs, in Vesper from the
// plan on.
pub fn export_files_of_plan(
    in answer: ChunkSeq[u64],
    has_types_path: bool,
    in types_path: Slice[u8]
) -> Option[(ChunkSeq[u8], ChunkSeq[u8])] {
    match binding_input_of_plan(in answer, has_types_path, in types_path) {
        Option::Some(bytes) => {
            let json = interface_json(in read_iface(in bytes.as_slice()));
            let binding = rust_binding(read_iface(in bytes.as_slice()));
            Option::Some((json, binding))
        },
        Option::None => Option::None,
    }
}
