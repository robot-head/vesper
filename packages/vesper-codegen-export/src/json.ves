// The interface file (src/native_export.rs `interface_json`): the library
// interface as `serde_json::to_string_pretty` writes it, with a trailing
// newline. Fields come in the Rust structs' order, and the optional ones
// are left out as their `skip_serializing_if` says.

use @vesper/check-data::util::{
    inc,
    u32_at,
    u8_at,
    w
};
use self::iface::{
    Iface,
    TyNode
};

const K_SCALAR: u8 = 0;
const K_TUPLE: u8 = 1;
const K_NAMED: u8 = 2;
const K_SEQ: u8 = 3;
const K_SLICE: u8 = 4;
const K_BOX: u8 = 5;
const K_STR: u8 = 6;
const K_OBJECT: u8 = 7;
const K_EXTERN: u8 = 8;

const P_IN: u8 = 1;
const P_INOUT: u8 = 2;
const P_SINK: u8 = 3;
const P_OTHER: u8 = 4;

const M_REPR_C: u8 = 1;
const M_CONVERTED: u8 = 2;

// A pretty JSON writer: each open object or array remembers whether it
// has an entry yet.
struct Json {
    out: ChunkSeq[u8],
    // per open container: 1 while it is empty
    empty: ChunkSeq[u8],
}

fn hex(d: u8) -> u8 {
    if d < 10 {
        wrapping_add(d, 48)
    } else {
        wrapping_add(d, 87)
    }
}

impl Json {
    fn raw(inout self, in s: Str) {
        let b = s.as_bytes();
        for i in 0..b.len() {
            let c = match b.try_get(i) {
                Option::Some(c) => c,
                Option::None => 0,
            };
            self.out.push(c);
        }
    }

    fn newline(inout self) {
        self.out.push(10);
        let depth = self.empty.len();
        for i in 0..depth {
            self.out.push(32);
            self.out.push(32);
        }
    }

    // One byte of a JSON string, escaped as serde_json does.
    fn esc(inout self, c: u8) {
        if c == 34 {
            self.raw("\\\"");
        } else if c == 92 {
            self.raw("\\\\");
        } else if c == 10 {
            self.raw("\\n");
        } else if c == 13 {
            self.raw("\\r");
        } else if c == 9 {
            self.raw("\\t");
        } else if c == 8 {
            self.raw("\\b");
        } else if c == 12 {
            self.raw("\\f");
        } else if c < 32 {
            self.raw("\\u00");
            self.out.push(hex(c / 16));
            self.out.push(hex(c % 16));
        } else {
            self.out.push(c);
        }
    }

    fn sym(inout self, in i: Iface, s: u32) {
        self.out.push(34);
        let n = i.names.size(s);
        for k in 0..n {
            self.esc(i.names.byte(s, k));
        }
        self.out.push(34);
    }

    fn text(inout self, in s: Str) {
        self.out.push(34);
        let b = s.as_bytes();
        for k in 0..b.len() {
            let c = match b.try_get(k) {
                Option::Some(c) => c,
                Option::None => 0,
            };
            self.esc(c);
        }
        self.out.push(34);
    }

    fn num(inout self, v: u64) {
        if v >= 10 {
            self.num(v / 10);
        }
        self.out.push(wrapping_u8(wrapping_add(v % 10, 48)));
    }

    fn boolean(inout self, b: bool) {
        if b {
            self.raw("true");
        } else {
            self.raw("false");
        }
    }

    fn open(inout self, c: u8) {
        self.out.push(c);
        self.empty.push(1);
    }

    fn close(inout self, c: u8) {
        let n = self.empty.len();
        let was = u8_at(in self.empty, wrapping_sub(n, 1));
        self.empty.truncate(wrapping_sub(n, 1));
        if was == 0 {
            self.newline();
        }
        self.out.push(c);
    }

    // The separator before the next entry of the innermost container.
    fn next(inout self) {
        let n = self.empty.len();
        let last = wrapping_sub(n, 1);
        if u8_at(in self.empty, last) == 0 {
            self.out.push(44);
        }
        let ok = self.empty.try_set(last, 0);
        self.newline();
    }

    fn key(inout self, in k: Str) {
        self.next();
        self.text(k);
        self.raw(": ");
    }

    fn key_sym(inout self, in i: Iface, s: u32) {
        self.next();
        self.sym(in i, s);
        self.raw(": ");
    }

    fn ty(inout self, in i: Iface, t: u32) {
        let n = i.node(t);
        self.open(123);
        self.key("kind");
        if n.kind == K_SCALAR {
            self.text("scalar");
            self.key("name");
            self.sym(in i, n.name);
        } else if n.kind == K_TUPLE {
            self.text("tuple");
            self.key("items");
            self.types(in i, n);
        } else if n.kind == K_NAMED {
            self.text("named");
            self.key("name");
            self.sym(in i, n.name);
            self.key("args");
            self.types(in i, n);
        } else if n.kind == K_SEQ {
            self.text("seq");
            self.key("elem");
            self.ty(in i, i.kid(t, 0));
        } else if n.kind == K_SLICE {
            self.text("slice");
            self.key("elem");
            self.ty(in i, i.kid(t, 0));
        } else if n.kind == K_BOX {
            self.text("box");
            self.key("inner");
            self.ty(in i, i.kid(t, 0));
        } else if n.kind == K_STR {
            self.text("str");
            self.key("owned");
            self.boolean(n.owned);
        } else if n.kind == K_OBJECT {
            self.text("object");
            self.key("name");
            self.sym(in i, n.name);
        } else {
            self.text("extern");
            self.key("name");
            self.sym(in i, n.name);
        }
        self.close(125);
    }

    // The parts of `n` as an array.
    fn types(inout self, in i: Iface, n: TyNode) {
        self.open(91);
        for k in 0..n.n {
            self.next();
            self.ty(in i, u32_at(in i.kids, wrapping_add(n.a, k)));
        }
        self.close(93);
    }

    fn decls(inout self, in i: Iface) {
        self.open(123);
        for di in 0..i.decls.len() {
            let d = i.decl(di);
            self.key_sym(in i, d.name);
            self.open(123);
            self.key("name");
            self.sym(in i, d.name);
            self.key("enum");
            self.boolean(d.is_enum);
            self.key("words");
            self.num(d.words);
            self.key("variants");
            self.open(91);
            for v in 0..d.vn {
                let vr = i.var(wrapping_add(d.v0, v));
                self.next();
                self.open(123);
                self.key("name");
                self.sym(in i, vr.name);
                self.key("fields");
                self.open(91);
                for f in 0..vr.fc {
                    let fr = i.field(wrapping_add(vr.f0, f));
                    self.next();
                    self.open(123);
                    self.key("name");
                    self.sym(in i, fr.name);
                    self.key("ty");
                    self.ty(in i, fr.ty);
                    self.key("offset");
                    self.num(fr.offset);
                    self.close(125);
                }
                self.close(93);
                self.close(125);
            }
            self.close(93);
            if d.is_handle {
                self.key("handle");
                self.boolean(true);
            }
            if d.linear {
                self.key("linear");
                self.boolean(true);
            }
            if d.drop != 0 {
                self.key("drop_symbol");
                self.sym(in i, wrapping_sub(d.drop, 1));
            }
            if d.owns_sequence {
                self.key("owns_sequence");
                self.boolean(true);
            }
            if d.mirror == M_REPR_C {
                self.key("mirror");
                self.open(123);
                self.key("kind");
                self.text("repr_c");
                self.close(125);
            } else if d.mirror == M_CONVERTED {
                self.key("mirror");
                self.open(123);
                self.key("kind");
                self.text("converted");
                self.key("reason");
                self.sym(in i, wrapping_sub(d.reason, 1));
                self.close(125);
            }
            self.close(125);
        }
        self.close(125);
    }

    fn functions(inout self, in i: Iface) {
        self.open(91);
        for fi in 0..i.fns.len() {
            let f = i.func(fi);
            self.next();
            self.open(123);
            self.key("name");
            self.sym(in i, f.name);
            self.key("symbol");
            self.sym(in i, f.symbol);
            self.key("params");
            self.open(91);
            for k in 0..f.pn {
                let p = i.param(wrapping_add(f.p0, k));
                self.next();
                self.open(123);
                self.key("name");
                self.sym(in i, p.name);
                self.key("ty");
                self.ty(in i, p.ty);
                self.key("pointer");
                self.boolean(p.pointer);
                if p.raw != 0 {
                    self.key("pass");
                    if p.raw == P_IN {
                        self.text("in");
                    } else if p.raw == P_INOUT {
                        self.text("inout");
                    } else if p.raw == P_SINK {
                        self.text("sink");
                    } else {
                        self.sym(in i, wrapping_sub(p.other, 1));
                    }
                }
                if p.in_place {
                    self.key("in_place");
                    self.boolean(true);
                }
                self.close(125);
            }
            self.close(93);
            self.key("result");
            self.ty(in i, f.result);
            self.key("result_words");
            self.num(f.result_words);
            self.key("result_pointer");
            self.boolean(f.result_pointer);
            self.key("errors");
            self.open(91);
            for k in 0..f.en {
                self.next();
                self.ty(in i, i.err(wrapping_add(f.e0, k)));
            }
            self.close(93);
            if f.fail != 0 {
                self.key("fail_record_words");
                self.num(wrapping_sub(f.fail, 1));
            }
            if f.instance_of != 0 {
                self.key("instance_of");
                self.sym(in i, wrapping_sub(f.instance_of, 1));
            }
            if f.ln > 0 {
                self.key("foreign");
                self.open(91);
                for k in 0..f.ln {
                    self.next();
                    self.sym(in i, i.fn_lib(wrapping_add(f.l0, k)));
                }
                self.close(93);
            }
            if f.result_in_place {
                self.key("result_in_place");
                self.boolean(true);
            }
            self.close(125);
        }
        self.close(93);
    }

    fn foreign(inout self, in i: Iface) {
        self.open(91);
        for li in 0..i.libs.len() {
            let l = i.lib(li);
            self.next();
            self.open(123);
            self.key("name");
            self.sym(in i, l.name);
            self.key("handler");
            self.sym(in i, l.handler);
            self.key("symbols");
            self.open(91);
            for k in 0..l.sn {
                self.next();
                self.sym(in i, i.lib_sym(wrapping_add(l.s0, k)));
            }
            self.close(93);
            if l.rust_path != 0 {
                self.key("rust_path");
                self.sym(in i, wrapping_sub(l.rust_path, 1));
            }
            self.close(125);
        }
        self.close(93);
    }
}

// `interface_json(interface)`.
pub fn interface_json(in i: Iface) -> ChunkSeq[u8] {
    let mut j = Json {
        out: ChunkSeq::with_capacity[u8](65536),
        empty: ChunkSeq::new[u8](),
    };
    j.open(123);
    j.key("abi");
    j.sym(in i, i.abi);
    j.key("library");
    j.sym(in i, i.library);
    j.key("types");
    j.decls(in i);
    j.key("functions");
    j.functions(in i);
    if i.runtime {
        j.key("runtime");
        j.open(123);
        j.key("seq_new");
        j.sym(in i, i.seq_new);
        j.key("seq_free");
        j.sym(in i, i.seq_free);
        j.key("live_allocations");
        j.sym(in i, i.live);
        if i.box_new != 0 {
            j.key("box_new");
            j.sym(in i, wrapping_sub(i.box_new, 1));
        }
        j.close(125);
    }
    if i.libs.len() > 0 {
        j.key("foreign");
        j.foreign(in i);
    }
    if i.option_mirrors {
        j.key("option_mirrors");
        j.boolean(true);
    }
    j.close(125);
    j.out.push(10);
    j.out
}
