// The extend and trivial-arithmetic folds of src/native_clif_opt.rs in
// Vesper (#2362 part 3): fold_narrow_extends and
// fold_trivial_arith_and_bool_extends.

use @vesper/clif::{Func, u32_at, w};
use @vesper/clif::codes::{
    CC_EQ, CC_NE, NONE, OP_BAND, OP_BAND_IMM, OP_BNOT, OP_BOR, OP_BOR_IMM, OP_BRIF, OP_BXOR,
    OP_BXOR_IMM, OP_IADD, OP_IADD_IMM, OP_ICMP, OP_ICMP_IMM, OP_ICONST, OP_IMUL, OP_IMUL_IMM,
    OP_INEG, OP_IREDUCE, OP_ISHL, OP_ISHL_IMM, OP_ISUB, OP_SELECT, OP_SEXTEND, OP_SSHR, OP_SSHR_IMM,
    OP_UEXTEND, OP_USHR, OP_USHR_IMM, TY_I16, TY_I32, TY_I64, TY_I8
};
use super::{Konst, layout_insts, none, some, type_bits, low_bits};
use super::branches::{constant, eval_icmp, sext};

// `fold_narrow_extends` stops after this many rounds.
const MAX_NARROW_ROUNDS: u64 = 10;
// `fold_trivial_arith_and_bool_extends` stops after this many rounds.
const MAX_TRIVIAL_ROUNDS: u64 = 3;
// The depth the trivial folds ask `constant` from.
const FOLD_CONST_DEPTH: u64 = 1;
// `is_bool_i8` gives up below this depth.
const MAX_BOOL_DEPTH: u64 = 4;

const BITS_8: u64 = 8;
const BITS_16: u64 = 16;
const BITS_32: u64 = 32;
const BITS_64: u64 = 64;

// Every bit of a word.
const ALL_ONES: u64 = 18446744073709551615;
// The sign bit of an i64.
const SIGN_BIT: u64 = 9223372036854775808;

// A `select`'s arguments.
const SELECT_COND_ARG: u64 = 0;
const SELECT_THEN_ARG: u64 = 1;
const SELECT_ELSE_ARG: u64 = 2;

fn is_int_scalar(ty: u64) -> bool {
    ty == TY_I8 || ty == TY_I16 || ty == TY_I32 || ty == TY_I64
}

// The mask of an integer scalar type (`mask_for`).
fn mask_of(ty: u64) -> u64 {
    let bits = type_bits(ty);
    if bits == BITS_64 {
        ALL_ONES
    } else {
        low_bits(ALL_ONES, bits)
    }
}

// `x` sign-extended from `bits` (8, 16, 32 or 64) bits.
fn sext_from(x: u64, bits: u64) -> u64 {
    if bits == BITS_64 { x } else { sext(x, bits) }
}

// `x >> s` as an i64.
fn ashr(x: u64, s: u64) -> u64 {
    let sh = wrapping_u32(s);
    if x & SIGN_BIT != 0 {
        wrapping_shr_u64(x ^ ALL_ONES, sh) ^ ALL_ONES
    } else {
        wrapping_shr_u64(x, sh)
    }
}

fn is_konst(k: Konst, v: u64) -> bool {
    k.some && k.v == v
}

// The instruction defining `v` as its first result, or NONE.
fn first_def(in f: Func, v: u32) -> u32 {
    let d = f.def_inst(v);
    if d == NONE || f.def_num(v) != 0 {
        return NONE;
    }
    d
}

// `layout.remove_inst`, `clear_results`, then `change_to_alias(dest, to)`.
fn alias_away(inout f: Func, inst: u32, dest: u32, to: u32) {
    f.detach_results(inst);
    f.remove_inst(inst);
    f.alias(dest, to);
}

// An iconst of `ty` holding `c` masked to it, just before `at`.
fn iconst_before(inout f: Func, at: u32, ty: u64, c: u64) -> u32 {
    let none_args = ChunkSeq::new[u32]();
    let none_dests = ChunkSeq::new[u32]();
    let i = f.ins_before(at, OP_ICONST, ty, 0, c, 0, 0, in none_args, in none_dests);
    f.result(i, 0)
}

// ----- fold_narrow_extends ---------------------------------------------------

// `narrow_operand`: a value of `dst_ty` an extend widened (`is_val`), or
// an iconst's immediate; `ok` false for anything else.
copy struct Narrow {
    ok: bool,
    is_val: bool,
    v: u32,
    c: u64,
}

fn no_narrow() -> Narrow {
    Narrow { ok: false, is_val: false, v: NONE, c: 0 }
}

fn narrow_operand(in f: Func, v0: u32, dst_ty: u64) -> Narrow {
    let v = f.resolve(v0);
    let d = first_def(in f, v);
    if d == NONE {
        return no_narrow();
    }
    let op = f.op(d);
    if op == OP_UEXTEND || op == OP_SEXTEND {
        let inner = f.resolve(f.arg(d, 0));
        if f.value_type(inner) == dst_ty {
            return Narrow { ok: true, is_val: true, v: inner, c: 0 };
        }
        return no_narrow();
    }
    if op == OP_ICONST {
        return Narrow { ok: true, is_val: false, v: NONE, c: f.inst(w(d)).imm };
    }
    no_narrow()
}

// An immediate shift amount below the width of `ty`.
fn shift_in_range(n: Narrow, ty: u64) -> bool {
    n.ok && !n.is_val && n.c < type_bits(ty)
}

fn materialize(inout f: Func, at: u32, n: Narrow, ty: u64) -> u32 {
    if n.is_val {
        return n.v;
    }
    iconst_before(inout f, at, ty, n.c & mask_of(ty))
}

fn is_narrow_binary(op: u64) -> bool {
    op == OP_BAND
        || op == OP_BOR
        || op == OP_BXOR
        || op == OP_IADD
        || op == OP_ISUB
        || op == OP_IMUL
        || op == OP_ISHL
}

// `fold_narrow_extends`: `ireduce`, `uextend` and `sextend` of constants
// fold, chains of them collapse, and `ireduce` of shifts and binary
// operations over widened narrow values is done at the narrow width.
pub fn fold_narrow_extends(inout f: Func) {
    for _ in 0..MAX_NARROW_ROUNDS {
        let mut changed = false;
        let all = layout_insts(in f);
        for q in 0..all.len() {
            let inst = u32_at(in all, q);
            let opcode = f.op(inst);
            if opcode != OP_IREDUCE && opcode != OP_UEXTEND && opcode != OP_SEXTEND {
                continue;
            }
            let dest = f.result(inst, 0);
            let dst_ty = f.value_type(dest);
            if !is_int_scalar(dst_ty) {
                continue;
            }
            let src = f.resolve(f.arg(inst, 0));
            let src_ty = f.value_type(src);
            if !is_int_scalar(src_ty) {
                continue;
            }
            let def = first_def(in f, src);
            if def == NONE {
                continue;
            }
            let inner_op = f.op(def);
            if inner_op == OP_ICONST {
                let imm = f.inst(w(def)).imm;
                let v = if opcode == OP_IREDUCE {
                    imm & mask_of(dst_ty)
                } else if opcode == OP_UEXTEND {
                    imm & mask_of(src_ty)
                } else {
                    sext_from(imm, type_bits(src_ty)) & mask_of(dst_ty)
                };
                f.replace_iconst(inst, dst_ty, v);
                changed = true;
                continue;
            }
            if inner_op == OP_UEXTEND || inner_op == OP_SEXTEND || inner_op == OP_IREDUCE {
                let inner = f.resolve(f.arg(def, 0));
                let inner_ty = f.value_type(inner);
                let inner_bits = type_bits(inner_ty);
                if opcode == OP_IREDUCE && inner_op != OP_IREDUCE {
                    if inner_ty == dst_ty {
                        alias_away(inout f, inst, dest, inner);
                        changed = true;
                    } else if inner_bits < type_bits(dst_ty) {
                        f.set_unary(inst, inner_op, inner);
                        changed = true;
                    } else if inner_op == OP_SEXTEND && is_int_scalar(inner_ty) {
                        f.set_unary(inst, OP_IREDUCE, inner);
                        changed = true;
                    }
                } else if opcode == OP_SEXTEND && inner_op == OP_UEXTEND {
                    if inner_bits < type_bits(src_ty) {
                        f.set_unary(inst, OP_UEXTEND, inner);
                        changed = true;
                    }
                } else if opcode == inner_op && is_int_scalar(inner_ty) {
                    f.set_unary(inst, opcode, inner);
                    changed = true;
                }
                continue;
            }
            if opcode != OP_IREDUCE {
                continue;
            }
            if inner_op == OP_USHR || inner_op == OP_SSHR {
                let a = f.resolve(f.arg(def, 0));
                let ad = first_def(in f, a);
                if ad == NONE {
                    continue;
                }
                let want = if inner_op == OP_USHR {
                    OP_UEXTEND
                } else {
                    OP_SEXTEND
                };
                if f.op(ad) != want {
                    continue;
                }
                let va = f.resolve(f.arg(ad, 0));
                if f.value_type(va) != dst_ty {
                    continue;
                }
                let nb = narrow_operand(in f, f.arg(def, 1), dst_ty);
                if !shift_in_range(nb, dst_ty) {
                    continue;
                }
                let vb = iconst_before(inout f, inst, TY_I32, nb.c);
                f.set_binary(inst, inner_op, va, vb);
                changed = true;
            } else if is_narrow_binary(inner_op) {
                let na = narrow_operand(in f, f.arg(def, 0), dst_ty);
                let nb = narrow_operand(in f, f.arg(def, 1), dst_ty);
                if !na.ok || !nb.ok {
                    continue;
                }
                if inner_op == OP_ISHL && !shift_in_range(nb, dst_ty) {
                    continue;
                }
                let va = materialize(inout f, inst, na, dst_ty);
                let b_ty = if inner_op == OP_ISHL { TY_I32 } else { dst_ty };
                let vb = materialize(inout f, inst, nb, b_ty);
                f.set_binary(inst, inner_op, va, vb);
                changed = true;
            }
        }
        if !changed {
            break;
        }
    }
}

// ----- fold_trivial_arith_and_bool_extends -----------------------------------

// `eval_binary_int`: `op` on `a` and `b` as values of type `ty`.
fn eval_binary_int(op: u64, ty: u64, a: u64, b: u64) -> Konst {
    let bits = type_bits(ty);
    if bits != BITS_8 && bits != BITS_16 && bits != BITS_32 && bits != BITS_64 {
        return none();
    }
    let mask = if bits == BITS_64 {
        ALL_ONES
    } else {
        low_bits(ALL_ONES, bits)
    };
    let ua = a & mask;
    let ub = b & mask;
    let sa = sext_from(ua, bits);
    let sh = b & wrapping_sub(bits, 1);
    if op == OP_IADD {
        return some(wrapping_add(ua, ub) & mask);
    }
    if op == OP_ISUB {
        return some(wrapping_sub(ua, ub) & mask);
    }
    if op == OP_IMUL {
        return some(wrapping_mul(ua, ub) & mask);
    }
    if op == OP_BAND {
        return some(ua & ub);
    }
    if op == OP_BOR {
        return some(ua | ub);
    }
    if op == OP_BXOR {
        return some(ua ^ ub);
    }
    if op == OP_ISHL {
        return some(wrapping_shl_u64(ua, wrapping_u32(sh)) & mask);
    }
    if op == OP_USHR {
        return some(wrapping_shr_u64(ua, wrapping_u32(sh)) & mask);
    }
    if op == OP_SSHR {
        return some(ashr(sa, sh) & mask);
    }
    none()
}

// The binary opcode of a `BinaryImm64` one, or 0.
fn binary_of_imm(op: u64) -> u64 {
    if op == OP_IADD_IMM {
        OP_IADD
    } else if op == OP_IMUL_IMM {
        OP_IMUL
    } else if op == OP_BAND_IMM {
        OP_BAND
    } else if op == OP_BOR_IMM {
        OP_BOR
    } else if op == OP_BXOR_IMM {
        OP_BXOR
    } else if op == OP_ISHL_IMM {
        OP_ISHL
    } else if op == OP_USHR_IMM {
        OP_USHR
    } else if op == OP_SSHR_IMM {
        OP_SSHR
    } else {
        0
    }
}

fn is_trivial_binary(op: u64) -> bool {
    op == OP_IADD
        || op == OP_ISUB
        || op == OP_IMUL
        || op == OP_BAND
        || op == OP_BOR
        || op == OP_BXOR
        || op == OP_ISHL
        || op == OP_USHR
        || op == OP_SSHR
}

fn is_cmp_value(in f: Func, v: u32) -> bool {
    let d = first_def(in f, v);
    if d == NONE {
        return false;
    }
    let op = f.op(d);
    op == OP_ICMP || op == OP_ICMP_IMM
}

// `is_bool_i8`: an i8 that is 0 or 1.
fn is_bool_i8(in f: Func, v0: u32, depth: u64) -> bool {
    if depth > MAX_BOOL_DEPTH {
        return false;
    }
    let v = f.resolve(v0);
    if f.value_type(v) != TY_I8 {
        return false;
    }
    let d = first_def(in f, v);
    if d == NONE {
        return false;
    }
    let op = f.op(d);
    if op == OP_ICMP || op == OP_ICMP_IMM {
        return true;
    }
    if op == OP_ICONST {
        let imm = f.inst(w(d)).imm;
        return imm == 0 || imm == 1;
    }
    if op == OP_BAND || op == OP_BOR || op == OP_BXOR {
        let next = wrapping_add(depth, 1);
        return is_bool_i8(in f, f.arg(d, 0), next) && is_bool_i8(in f, f.arg(d, 1), next);
    }
    false
}

// `unwrap_ext`: the value a `uextend` or `sextend` widened, or NONE.
fn unwrap_ext(in f: Func, v0: u32) -> u32 {
    let v = f.resolve(v0);
    let d = first_def(in f, v);
    if d == NONE {
        return NONE;
    }
    let op = f.op(d);
    if op != OP_UEXTEND && op != OP_SEXTEND {
        return NONE;
    }
    f.resolve(f.arg(d, 0))
}

// The value a trivial binary operation is, or NONE (`alias_to`).
fn binary_alias(in f: Func, op: u64, ty: u64, lhs: u32, rhs: u32, lc: Konst, rc: Konst) -> u32 {
    let all_ones = mask_of(ty);
    if op == OP_IADD || op == OP_BOR || op == OP_BXOR {
        if is_konst(rc, 0) {
            return lhs;
        }
        if is_konst(lc, 0) {
            return rhs;
        }
        if lhs == rhs && op == OP_BOR {
            return lhs;
        }
        return NONE;
    }
    if op == OP_ISUB || op == OP_ISHL || op == OP_USHR || op == OP_SSHR {
        return if is_konst(rc, 0) { lhs } else { NONE };
    }
    if op == OP_IMUL {
        if is_konst(rc, 1) {
            return lhs;
        }
        if is_konst(lc, 1) {
            return rhs;
        }
        return NONE;
    }
    if op == OP_BAND {
        if is_konst(rc, all_ones)
            || lhs == rhs
            || (ty == TY_I8 && is_konst(rc, 1) && is_bool_i8(in f, lhs, 0))
        {
            return lhs;
        }
        if is_konst(lc, all_ones) || (ty == TY_I8 && is_konst(lc, 1) && is_bool_i8(in f, rhs, 0)) {
            return rhs;
        }
    }
    NONE
}

// `fold_trivial_arith_and_bool_extends`: identity, constant and
// same-operand integer operations, `select`, and zero comparisons or
// branches on `uextend`/`sextend` of narrower values fold.
pub fn fold_trivial_arith_and_bool_extends(inout f: Func) {
    for _ in 0..MAX_TRIVIAL_ROUNDS {
        let mut changed = false;
        let all = layout_insts(in f);
        for q in 0..all.len() {
            let inst = u32_at(in all, q);
            let op = f.op(inst);
            let row = f.inst(w(inst));
            if op == OP_BNOT || op == OP_INEG {
                let arg = f.resolve(f.arg(inst, 0));
                let dest = f.result(inst, 0);
                let ty = f.value_type(dest);
                if !is_int_scalar(ty) {
                    continue;
                }
                let mask = mask_of(ty);
                let a = constant(in f, arg, FOLD_CONST_DEPTH);
                if a.some {
                    let ua = a.v & mask;
                    let res = if op == OP_BNOT {
                        (ua ^ ALL_ONES) & mask
                    } else {
                        wrapping_sub(0, ua) & mask
                    };
                    f.replace_iconst(inst, ty, res);
                    changed = true;
                } else {
                    let d = first_def(in f, arg);
                    if d != NONE && f.op(d) == op {
                        let inner = f.resolve(f.arg(d, 0));
                        alias_away(inout f, inst, dest, inner);
                        changed = true;
                    }
                }
            } else if binary_of_imm(op) != 0 {
                let bin_op = binary_of_imm(op);
                let arg = f.resolve(f.arg(inst, 0));
                let dest = f.result(inst, 0);
                let ty = f.value_type(dest);
                if !is_int_scalar(ty) {
                    continue;
                }
                let a = constant(in f, arg, FOLD_CONST_DEPTH);
                if a.some {
                    let folded = eval_binary_int(bin_op, ty, a.v, row.imm);
                    if folded.some {
                        f.replace_iconst(inst, ty, folded.v);
                        changed = true;
                        continue;
                    }
                }
                let all_ones = mask_of(ty);
                let imm_bits = row.imm & all_ones;
                let is_identity = if op == OP_IMUL_IMM {
                    imm_bits == 1
                } else if op == OP_BAND_IMM {
                    imm_bits == all_ones
                } else {
                    imm_bits == 0
                };
                if is_identity {
                    alias_away(inout f, inst, dest, arg);
                    changed = true;
                } else if (op == OP_IMUL_IMM || op == OP_BAND_IMM) && imm_bits == 0 {
                    f.replace_iconst(inst, ty, 0);
                    changed = true;
                } else if op == OP_BOR_IMM && imm_bits == all_ones {
                    f.replace_iconst(inst, ty, all_ones);
                    changed = true;
                }
            } else if is_trivial_binary(op) {
                let lhs = f.resolve(f.arg(inst, 0));
                let rhs = f.resolve(f.arg(inst, 1));
                let dest = f.result(inst, 0);
                let ty = f.value_type(dest);
                if !is_int_scalar(ty) {
                    continue;
                }
                let lc = constant(in f, lhs, FOLD_CONST_DEPTH);
                let rc = constant(in f, rhs, FOLD_CONST_DEPTH);
                if lc.some && rc.some {
                    let folded = eval_binary_int(op, ty, lc.v, rc.v);
                    if folded.some {
                        f.replace_iconst(inst, ty, folded.v);
                        changed = true;
                        continue;
                    }
                }
                let all_ones = mask_of(ty);
                let target = binary_alias(in f, op, ty, lhs, rhs, lc, rc);
                if target != NONE {
                    alias_away(inout f, inst, dest, target);
                    changed = true;
                } else if ((op == OP_IMUL || op == OP_BAND) && (is_konst(lc, 0) || is_konst(rc, 0)))
                    || (lhs == rhs && (op == OP_ISUB || op == OP_BXOR))
                {
                    f.replace_iconst(inst, ty, 0);
                    changed = true;
                } else if op == OP_BOR && (is_konst(lc, all_ones) || is_konst(rc, all_ones)) {
                    f.replace_iconst(inst, ty, all_ones);
                    changed = true;
                }
            } else if op == OP_SELECT {
                let cond = f.resolve(f.arg(inst, SELECT_COND_ARG));
                let t = f.resolve(f.arg(inst, SELECT_THEN_ARG));
                let e = f.resolve(f.arg(inst, SELECT_ELSE_ARG));
                let dest = f.result(inst, 0);
                let cond_is_cmp = is_cmp_value(in f, cond);
                let tc = constant(in f, t, FOLD_CONST_DEPTH);
                let fc = constant(in f, e, FOLD_CONST_DEPTH);
                let dest_ty = f.value_type(dest);
                let cc = constant(in f, cond, FOLD_CONST_DEPTH);
                let one_zero = is_konst(tc, 1) && is_konst(fc, 0);
                let target = if t == e {
                    t
                } else if cc.some {
                    if cc.v != 0 { t } else { e }
                } else if cond_is_cmp && dest_ty == TY_I8 && one_zero {
                    cond
                } else {
                    NONE
                };
                if target != NONE {
                    alias_away(inout f, inst, dest, target);
                    changed = true;
                } else if cond_is_cmp
                    && (dest_ty == TY_I16 || dest_ty == TY_I32 || dest_ty == TY_I64)
                    && one_zero
                {
                    f.set_unary(inst, OP_UEXTEND, cond);
                    changed = true;
                } else if cond_is_cmp && dest_ty == TY_I8 && is_konst(tc, 0) && is_konst(fc, 1) {
                    f.replace_icmp_imm(inst, CC_EQ, cond, 0);
                    changed = true;
                }
            } else if op == OP_ICMP {
                let lhs = f.resolve(f.arg(inst, 0));
                let rhs = f.resolve(f.arg(inst, 1));
                let ty = f.value_type(lhs);
                let mut res = none();
                if lhs == rhs {
                    res = eval_icmp(row.cond, ty, 0, 0);
                } else {
                    let a = constant(in f, lhs, FOLD_CONST_DEPTH);
                    let b = constant(in f, rhs, FOLD_CONST_DEPTH);
                    if a.some && b.some {
                        res = eval_icmp(row.cond, ty, a.v, b.v);
                    }
                }
                if res.some {
                    f.replace_iconst(inst, TY_I8, res.v);
                    changed = true;
                }
            } else if op == OP_ICMP_IMM {
                let arg = f.resolve(f.arg(inst, 0));
                let ty = f.value_type(arg);
                let a = constant(in f, arg, FOLD_CONST_DEPTH);
                if a.some {
                    let res = eval_icmp(row.cond, ty, a.v, row.imm);
                    if res.some {
                        f.replace_iconst(inst, TY_I8, res.v);
                        changed = true;
                        continue;
                    }
                }
                if row.imm != 0 || (row.cond != CC_EQ && row.cond != CC_NE) {
                    continue;
                }
                let inner = unwrap_ext(in f, arg);
                if inner == NONE {
                    continue;
                }
                let dest = f.result(inst, 0);
                if row.cond == CC_NE
                    && is_cmp_value(in f, inner)
                    && f.value_type(inner) == f.value_type(dest)
                {
                    alias_away(inout f, inst, dest, inner);
                } else {
                    f.replace_icmp_imm(inst, row.cond, inner, row.imm);
                }
                changed = true;
            } else if op == OP_BRIF {
                let inner = unwrap_ext(in f, f.arg(inst, 0));
                if inner != NONE {
                    let mut args = ChunkSeq::new[u32]();
                    args.push(inner);
                    f.set_args(inst, in args);
                    changed = true;
                }
            }
        }
        if !changed {
            break;
        }
    }
}
