// @vesper/native-clif-opt: src/native_clif_opt.rs (the CLIF peepholes of
// the native optimize path) in Vesper (#2362), step by step.
//
// `native_clif_opt::STEPS` is the flattened sequence `run` applies. The
// entry takes one step's code and one function in the words of
// tests/common/clif_words.rs, runs that step on @vesper/clif tables and
// answers with the edit script that `clif_words::apply` replays on the
// Rust function. A step not ported yet answers `NOT_PORTED`, and the
// caller runs Rust's.
//
// Part 1: remove_unreachable, float_constants, fold_constant_branches,
// shrink_unused_slots. Part 2: merge_blocks, remove_constant_params.
// branches.ves (#2423): the branch-threading steps. folds.ves (#2423):
// canonicalize_imm_ops, fold_load_store_offsets, cse_dom_pure. Part 3:
// extends.ves, fold_narrow_extends and fold_trivial_arith_and_bool_extends;
// slots.ves, split_join_slots and promote_slots. Part 4: vector.ves,
// vector_registers; cleanup.ves, remove_dead and sink_slot_inits.

use self::extends::{fold_narrow_extends, fold_trivial_arith_and_bool_extends};
use self::vector::{vector_registers};
use self::cleanup::{remove_dead, sink_slot_inits};
use self::slots::{promote_slots, split_join_slots};
use self::folds::{canonicalize_imm_ops, cse_dom_pure, fold_load_store_offsets};
use self::branches::{
    propagate_branch_conditions, sink_compares, thread_branches, thread_constant_param_jumps,
    thread_decided_branches
};
use @vesper/clif::{Func, inc, n32, read_func, u32_at, w};
use @vesper/clif::codes::{
    CC_EQ, CC_NE, F_STACK_SLOT, NONE, OP_BAND, OP_BITCAST, OP_BOR, OP_BRIF, OP_BXOR, OP_F32CONST,
    OP_F64CONST, OP_FADD, OP_FMUL, OP_ICMP_IMM, OP_ICONST, OP_IREDUCE, OP_JUMP, OP_UEXTEND, TY_F128,
    TY_F16, TY_F32, TY_F64, TY_I128, TY_I16, TY_I32, TY_I64, TY_I8
};

// Step codes (the test maps `STEPS` names to them). 0 is a step not
// ported yet.
pub const STEP_REMOVE_UNREACHABLE: u64 = 1;
pub const STEP_FLOAT_CONSTANTS: u64 = 2;
pub const STEP_FOLD_CONSTANT_BRANCHES: u64 = 3;
pub const STEP_SHRINK_UNUSED_SLOTS: u64 = 4;
pub const STEP_MERGE_BLOCKS: u64 = 5;
pub const STEP_REMOVE_CONSTANT_PARAMS: u64 = 6;
pub const STEP_FOLD_NARROW_EXTENDS: u64 = 7;
pub const STEP_FOLD_TRIVIAL_ARITH_AND_BOOL_EXTENDS: u64 = 8;
pub const STEP_SPLIT_JOIN_SLOTS: u64 = 9;
pub const STEP_PROMOTE_SLOTS: u64 = 10;
pub const STEP_VECTOR_REGISTERS: u64 = 11;
pub const STEP_REMOVE_DEAD: u64 = 12;
pub const STEP_SINK_SLOT_INITS: u64 = 13;
// 32 up: the branch-threading steps of #2423 (branches.ves).
pub const STEP_SINK_COMPARES: u64 = 32;
pub const STEP_THREAD_BRANCHES: u64 = 33;
pub const STEP_THREAD_DECIDED_BRANCHES: u64 = 34;
pub const STEP_THREAD_CONSTANT_PARAM_JUMPS: u64 = 35;
pub const STEP_PROPAGATE_BRANCH_CONDITIONS: u64 = 36;
// The fold steps of #2423 (folds.ves).
pub const STEP_CANONICALIZE_IMM_OPS: u64 = 37;
pub const STEP_FOLD_LOAD_STORE_OFFSETS: u64 = 38;
pub const STEP_CSE_DOM_PURE: u64 = 39;

// The answer's first word.
pub const PORTED: u64 = 1;
pub const NOT_PORTED: u64 = 0;

// The bytes of the step word ahead of the function words.
const STEP_BYTES: u64 = 8;

// `remove_constant_params` stops after this many rounds.
const MAX_CONST_PARAM_ROUNDS: u64 = 16;

// `constant_with` gives up past this depth.
const MAX_CONST_DEPTH: u64 = 8;

// Bit widths of the scalar types.
const BITS_8: u64 = 8;
const BITS_16: u64 = 16;
const BITS_32: u64 = 32;
const BITS_64: u64 = 64;
const BITS_128: u64 = 128;
// The shift amounts of an i64 (`1i64 << bits` wraps modulo 64).
const SHIFT_MASK: u64 = 63;

// IEEE NaN tests: every exponent bit set and a nonzero fraction.
const F64_EXP: u64 = 9218868437227405312;
const F64_FRAC: u64 = 4503599627370495;
const F32_EXP: u64 = 2139095040;
const F32_FRAC: u64 = 8388607;

// The bit width of a type code; 0 when the tables do not name it.
pub fn type_bits(ty: u64) -> u64 {
    if ty == TY_I8 {
        BITS_8
    } else if ty == TY_I16 || ty == TY_F16 {
        BITS_16
    } else if ty == TY_I32 || ty == TY_F32 {
        BITS_32
    } else if ty == TY_I64 || ty == TY_F64 {
        BITS_64
    } else if ty == TY_I128 || ty == TY_F128 {
        BITS_128
    } else {
        0
    }
}

// `x & ((1i64 << bits) - 1)`, the shift wrapping as Rust's release build's.
pub fn low_bits(x: u64, bits: u64) -> u64 {
    x & wrapping_sub(wrapping_shl_u64(1, wrapping_u32(bits & SHIFT_MASK)), 1)
}

// An optional constant: `some` false is `None`.
pub copy struct Konst {
    some: bool,
    v: u64,
}

pub fn none() -> Konst {
    Konst { some: false, v: 0 }
}

pub fn some(v: u64) -> Konst {
    Konst { some: true, v: v }
}

// `constant` (`constant_with` with nothing known).
fn constant(in f: Func, v0: u32, depth: u64) -> Konst {
    if depth > MAX_CONST_DEPTH {
        return none();
    }
    let v = f.resolve(v0);
    let i = f.def_inst(v);
    if i == NONE {
        return none();
    }
    let bits = type_bits(f.value_type(v));
    let narrow = bits != 0 && bits < BITS_64;
    let op = f.op(i);
    let row = f.inst(w(i));
    if op == OP_ICONST {
        return some(
            if narrow {
                low_bits(row.imm, bits)
            } else {
                row.imm
            }
        );
    }
    let next = wrapping_add(depth, 1);
    if op == OP_UEXTEND || op == OP_IREDUCE {
        let a = constant(in f, f.arg(i, 0), next);
        if !a.some {
            return a;
        }
        return some(if narrow { low_bits(a.v, bits) } else { a.v });
    }
    if op == OP_ICMP_IMM {
        let arg = f.arg(i, 0);
        let a = constant(in f, arg, next);
        if !a.some {
            return a;
        }
        let arg_bits = type_bits(f.value_type(f.resolve(arg)));
        let b = if arg_bits == BITS_64 {
            row.imm
        } else {
            low_bits(row.imm, arg_bits)
        };
        if row.cond == CC_EQ {
            return some(if a.v == b { 1 } else { 0 });
        }
        if row.cond == CC_NE {
            return some(if a.v != b { 1 } else { 0 });
        }
        return none();
    }
    if op == OP_BAND || op == OP_BOR || op == OP_BXOR {
        let a = constant(in f, f.arg(i, 0), next);
        if !a.some {
            return a;
        }
        let b = constant(in f, f.arg(i, 1), next);
        if !b.some {
            return b;
        }
        return some(
            if op == OP_BAND {
                a.v & b.v
            } else if op == OP_BOR {
                a.v | b.v
            } else {
                a.v ^ b.v
            }
        );
    }
    none()
}

// Every instruction in layout order (`insts`).
pub fn layout_insts(in f: Func) -> ChunkSeq[u32] {
    let mut out = ChunkSeq::new[u32]();
    let mut b = f.first_block();
    loop {
        if b == NONE {
            break;
        }
        let mut i = f.first_inst(b);
        loop {
            if i == NONE {
                break;
            }
            out.push(i);
            i = f.next_inst(i);
        }
        b = f.next_block(b);
    }
    out
}

// `remove_unreachable`: blocks the entry block does not reach through the
// destinations of block terminators lose their instructions, then leave
// the layout.
pub fn remove_unreachable(inout f: Func) {
    let mut seen = ChunkSeq::new[u8]();
    seen.resize(f.nblocks(), 0);
    let mut work = ChunkSeq::new[u32]();
    let entry = f.first_block();
    if entry != NONE {
        let ok = seen.try_set(w(entry), 1);
        work.push(entry);
    }
    loop {
        let b = match work.pop() {
            Option::Some(b) => b,
            Option::None => break,
        };
        let last = f.last_inst(b);
        if last == NONE {
            continue;
        }
        for k in 0..f.ndests(last) {
            let d = f.dest_block(last, k);
            if d != NONE && seen.try_get(w(d)).unwrap_or(1) == 0 {
                let ok = seen.try_set(w(d), 1);
                work.push(d);
            }
        }
    }
    let mut blocks = ChunkSeq::new[u32]();
    let mut b = f.first_block();
    loop {
        if b == NONE {
            break;
        }
        blocks.push(b);
        b = f.next_block(b);
    }
    for k in 0..blocks.len() {
        let b = u32_at(in blocks, k);
        if seen.try_get(w(b)).unwrap_or(0) != 0 {
            continue;
        }
        loop {
            let i = f.first_inst(b);
            if i == NONE {
                break;
            }
            f.remove_inst(i);
        }
        f.remove_block_edit(b);
    }
}

// `fold_constant_branches`: a `brif` on a constant becomes a jump to the
// destination it takes, with that destination's arguments.
fn fold_constant_branches(inout f: Func) {
    let all = layout_insts(in f);
    for k in 0..all.len() {
        let i = u32_at(in all, k);
        if f.op(i) != OP_BRIF {
            continue;
        }
        let c = constant(in f, f.arg(i, 0), 0);
        if !c.some {
            continue;
        }
        let d: u64 = if c.v == 0 { 1 } else { 0 };
        let to = f.dest_block(i, d);
        let mut args = ChunkSeq::new[u32]();
        for a in 0..f.dest_nargs(i, d) {
            args.push(f.dest_arg(i, d, a));
        }
        f.replace_jump(i, to, in args);
    }
}

fn is_nan_bits(ty: u64, bits: u64) -> bool {
    if ty == TY_F64 {
        (bits & F64_EXP) == F64_EXP && (bits & F64_FRAC) != 0
    } else {
        (bits & F32_EXP) == F32_EXP && (bits & F32_FRAC) != 0
    }
}

// Whether `v` is result 0 of an `f64const` or `f32const` that is no NaN.
fn non_nan_float_const(in f: Func, v: u32) -> bool {
    let i = f.def_inst(v);
    if i == NONE || f.def_num(v) != 0 {
        return false;
    }
    let row = f.inst(w(i));
    if row.op == OP_F64CONST {
        return !is_nan_bits(TY_F64, row.imm);
    }
    if row.op == OP_F32CONST {
        return !is_nan_bits(TY_F32, row.imm);
    }
    false
}

// `float_constants`: a float `bitcast` of an integer constant becomes the
// float constant, then `fadd`/`fmul` put a constant left operand right.
fn float_constants(inout f: Func) {
    let all = layout_insts(in f);
    for k in 0..all.len() {
        let i = u32_at(in all, k);
        if f.op(i) != OP_BITCAST {
            continue;
        }
        let ty = f.value_type(f.result(i, 0));
        if ty != TY_F64 && ty != TY_F32 {
            continue;
        }
        let c = constant(in f, f.arg(i, 0), 0);
        if !c.some {
            continue;
        }
        let bits = if ty == TY_F64 {
            c.v
        } else {
            low_bits(c.v, BITS_32)
        };
        f.replace_fconst(i, ty, bits);
    }
    for k in 0..all.len() {
        let i = u32_at(in all, k);
        let op = f.op(i);
        if op != OP_FADD && op != OP_FMUL {
            continue;
        }
        let lhs = f.arg(i, 0);
        let rhs = f.arg(i, 1);
        if non_nan_float_const(in f, lhs) && !non_nan_float_const(in f, rhs) {
            let mut swapped = ChunkSeq::new[u32]();
            swapped.push(rhs);
            swapped.push(lhs);
            f.set_args(i, in swapped);
        }
    }
}

// `shrink_unused_slots`: sized slots no `stack_load`, `stack_store` or
// `stack_addr` in the layout names get size 0.
fn shrink_unused_slots(inout f: Func) {
    let mut used = ChunkSeq::new[u8]();
    used.resize(f.nslots(), 0);
    let all = layout_insts(in f);
    for k in 0..all.len() {
        let row = f.inst(w(u32_at(in all, k)));
        if (row.eff & F_STACK_SLOT) != 0 {
            let ok = used.try_set(row.imm, 1);
        }
    }
    for s in 0..f.nslots() {
        if used.try_get(s).unwrap_or(1) == 0 && f.slot(s).size != 0 {
            f.set_slot_size(s, 0);
        }
    }
}

// Every block in layout order.
pub fn layout_blocks(in f: Func) -> ChunkSeq[u32] {
    let mut out = ChunkSeq::new[u32]();
    let mut b = f.first_block();
    loop {
        if b == NONE {
            break;
        }
        out.push(b);
        b = f.next_block(b);
    }
    out
}

// How many destinations of instructions in the layout name each block.
fn pred_counts(in f: Func) -> ChunkSeq[u32] {
    let mut preds = ChunkSeq::new[u32]();
    preds.resize(f.nblocks(), 0);
    let all = layout_insts(in f);
    for k in 0..all.len() {
        let i = u32_at(in all, k);
        for d in 0..f.ndests(i) {
            let b = w(f.dest_block(i, d));
            let n = u32_at(in preds, b);
            let ok = preds.try_set(b, wrapping_add(n, 1));
        }
    }
    preds
}

// The parameters of `b`.
pub fn params_of(in f: Func, b: u32) -> ChunkSeq[u32] {
    let mut out = ChunkSeq::new[u32]();
    for k in 0..f.nparams(b) {
        out.push(f.param(b, k));
    }
    out
}

// `merge_blocks`: a block reached only by a `jump` from one other block
// joins that block. The predecessor counts are the ones before any merge.
fn merge_blocks(inout f: Func) {
    let preds = pred_counts(in f);
    let entry = f.first_block();
    let blocks = layout_blocks(in f);
    for q in 0..blocks.len() {
        let a = u32_at(in blocks, q);
        if !f.blk(w(a)).placed {
            continue;
        }
        loop {
            let last = f.last_inst(a);
            if last == NONE || f.op(last) != OP_JUMP {
                break;
            }
            let b = f.dest_block(last, 0);
            if b == a || b == entry || u32_at(in preds, w(b)) != 1 {
                break;
            }
            let mut args = ChunkSeq::new[u32]();
            let mut values = true;
            for k in 0..f.dest_nargs(last, 0) {
                let v = f.dest_arg(last, 0, k);
                if v == NONE {
                    values = false;
                }
                args.push(v);
            }
            if !values {
                break;
            }
            let params = params_of(in f, b);
            f.remove_inst(last);
            let n = if params.len() < args.len() {
                params.len()
            } else {
                args.len()
            };
            let mut j = n;
            loop {
                if j == 0 {
                    break;
                }
                j = wrapping_sub(j, 1);
                let p = u32_at(in params, j);
                f.remove_param(p);
                f.alias(p, u32_at(in args, j));
            }
            let mut moved = ChunkSeq::new[u32]();
            let mut i = f.first_inst(b);
            loop {
                if i == NONE {
                    break;
                }
                moved.push(i);
                i = f.next_inst(i);
            }
            for k in 0..moved.len() {
                f.move_to_bottom(u32_at(in moved, k), a);
            }
            f.remove_block_edit(b);
        }
    }
}

fn is_int_type(ty: u64) -> bool {
    ty == TY_I8 || ty == TY_I16 || ty == TY_I32 || ty == TY_I64
}

// The incoming edges of every block, as (instruction, destination) pairs
// in layout order: block `b`'s are `at[b]..at[b + 1]` of `inst`/`dest`.
pub struct Edges {
    at: ChunkSeq[u64],
    inst: ChunkSeq[u32],
    dest: ChunkSeq[u64],
}

pub fn edges_of(in f: Func) -> Edges {
    let nb = f.nblocks();
    let all = layout_insts(in f);
    let mut at = ChunkSeq::new[u64]();
    at.resize(inc(nb), 0);
    for k in 0..all.len() {
        let i = u32_at(in all, k);
        for d in 0..f.ndests(i) {
            let b = inc(w(f.dest_block(i, d)));
            let ok = at.try_set(b, inc(at.try_get(b).unwrap_or(0)));
        }
    }
    for b in 0..nb {
        let sum = wrapping_add(at.try_get(b).unwrap_or(0), at.try_get(inc(b)).unwrap_or(0));
        let ok = at.try_set(inc(b), sum);
    }
    let total = at.try_get(nb).unwrap_or(0);
    let mut fill = ChunkSeq::new[u64]();
    fill.extend(in at.as_slice());
    let mut e = Edges { at: at, inst: ChunkSeq::new[u32](), dest: ChunkSeq::new[u64]() };
    e.inst.resize(total, NONE);
    e.dest.resize(total, 0);
    for k in 0..all.len() {
        let i = u32_at(in all, k);
        for d in 0..f.ndests(i) {
            let b = w(f.dest_block(i, d));
            let slot = fill.try_get(b).unwrap_or(0);
            let ok = e.inst.try_set(slot, i);
            let ok2 = e.dest.try_set(slot, d);
            let ok3 = fill.try_set(b, inc(slot));
        }
    }
    e
}

// `remove_constant_params`: a block parameter that receives one value on
// every edge (or itself, around a loop), or one integer constant, becomes
// an alias of that value or of a new `iconst` at the top of its block.
fn remove_constant_params(inout f: Func) {
    let entry = f.first_block();
    for _ in 0..MAX_CONST_PARAM_ROUNDS {
        let e = edges_of(in f);
        let mut changed = false;
        let blocks = layout_blocks(in f);
        for q in 0..blocks.len() {
            let block = u32_at(in blocks, q);
            if block == entry {
                continue;
            }
            let lo = e.at.try_get(w(block)).unwrap_or(0);
            let hi = e.at.try_get(inc(w(block))).unwrap_or(0);
            if lo == hi {
                continue;
            }
            let params = params_of(in f, block);
            let mut i = params.len();
            loop {
                if i == 0 {
                    break;
                }
                i = wrapping_sub(i, 1);
                let p = u32_at(in params, i);
                let p_ty = f.value_type(p);
                let mut only_val = NONE;
                let mut only_const = none();
                let mut saw_non_self = false;
                let mut same_val = true;
                let mut same_const = is_int_type(p_ty);
                for x in lo..hi {
                    let inst = u32_at(in e.inst, x);
                    let k = e.dest.try_get(x).unwrap_or(0);
                    let a = if i < f.dest_nargs(inst, k) {
                        f.dest_arg(inst, k, i)
                    } else {
                        NONE
                    };
                    if a == NONE {
                        same_val = false;
                        same_const = false;
                    } else {
                        let v = f.resolve(a);
                        if v == p {
                            continue;
                        }
                        saw_non_self = true;
                        if only_val == NONE {
                            only_val = v;
                        } else if only_val != v {
                            same_val = false;
                        }
                        if same_const {
                            let c = constant(in f, v, 1);
                            if !c.some {
                                same_const = false;
                            } else if !only_const.some {
                                only_const = c;
                            } else if only_const.v != c.v {
                                same_const = false;
                            }
                        }
                    }
                    if !same_val && !same_const {
                        break;
                    }
                }
                if !saw_non_self || (!same_val && !same_const) {
                    continue;
                }
                let mut replacement = only_val;
                if !same_val {
                    let first = f.first_inst(block);
                    if !only_const.some || first == NONE {
                        continue;
                    }
                    let none_args = ChunkSeq::new[u32]();
                    let none_dests = ChunkSeq::new[u32]();
                    let made = f.ins_before(
                        first,
                        OP_ICONST,
                        p_ty,
                        0,
                        only_const.v,
                        0,
                        0,
                        in none_args,
                        in none_dests
                    );
                    replacement = f.result(made, 0);
                }
                for x in lo..hi {
                    let inst = u32_at(in e.inst, x);
                    let k = e.dest.try_get(x).unwrap_or(0);
                    f.remove_dest_arg(inst, k, i);
                }
                f.remove_param(p);
                f.alias(p, replacement);
                changed = true;
            }
        }
        if !changed {
            return;
        }
    }
}

// One step on one function: the step code, then the function's words.
// Answers `PORTED` and the edit script, or `NOT_PORTED`.
pub fn clif_opt_words(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let step = bytes.try_read_u64_le(0).unwrap_or(NOT_PORTED);
    let mut out = ChunkSeq::new[u64]();
    let ported = step == STEP_REMOVE_UNREACHABLE
        || step == STEP_FLOAT_CONSTANTS
        || step == STEP_FOLD_CONSTANT_BRANCHES
        || step == STEP_SHRINK_UNUSED_SLOTS
        || step == STEP_MERGE_BLOCKS
        || step == STEP_REMOVE_CONSTANT_PARAMS
        || step == STEP_FOLD_NARROW_EXTENDS
        || step == STEP_FOLD_TRIVIAL_ARITH_AND_BOOL_EXTENDS
        || step == STEP_SPLIT_JOIN_SLOTS
        || step == STEP_PROMOTE_SLOTS
        || step == STEP_VECTOR_REGISTERS
        || step == STEP_REMOVE_DEAD
        || step == STEP_SINK_SLOT_INITS
        || step == STEP_SINK_COMPARES
        || step == STEP_THREAD_BRANCHES
        || step == STEP_THREAD_DECIDED_BRANCHES
        || step == STEP_THREAD_CONSTANT_PARAM_JUMPS
        || step == STEP_PROPAGATE_BRANCH_CONDITIONS
        || step == STEP_CANONICALIZE_IMM_OPS
        || step == STEP_FOLD_LOAD_STORE_OFFSETS
        || step == STEP_CSE_DOM_PURE;
    if !ported || bytes.len() < STEP_BYTES {
        out.push(NOT_PORTED);
        return out;
    }
    let start = STEP_BYTES;
    let end = bytes.len();
    let mut f = read_func(in bytes[start..end]);
    if step == STEP_REMOVE_UNREACHABLE {
        remove_unreachable(inout f);
    } else if step == STEP_FLOAT_CONSTANTS {
        float_constants(inout f);
    } else if step == STEP_FOLD_CONSTANT_BRANCHES {
        fold_constant_branches(inout f);
    } else if step == STEP_SHRINK_UNUSED_SLOTS {
        shrink_unused_slots(inout f);
    } else if step == STEP_MERGE_BLOCKS {
        merge_blocks(inout f);
    } else if step == STEP_FOLD_NARROW_EXTENDS {
        fold_narrow_extends(inout f);
    } else if step == STEP_FOLD_TRIVIAL_ARITH_AND_BOOL_EXTENDS {
        fold_trivial_arith_and_bool_extends(inout f);
    } else if step == STEP_SPLIT_JOIN_SLOTS {
        split_join_slots(inout f);
    } else if step == STEP_PROMOTE_SLOTS {
        promote_slots(inout f);
    } else if step == STEP_VECTOR_REGISTERS {
        vector_registers(inout f);
    } else if step == STEP_REMOVE_DEAD {
        remove_dead(inout f);
    } else if step == STEP_SINK_SLOT_INITS {
        sink_slot_inits(inout f);
    } else if step == STEP_SINK_COMPARES {
        sink_compares(inout f);
    } else if step == STEP_THREAD_BRANCHES {
        thread_branches(inout f);
    } else if step == STEP_THREAD_DECIDED_BRANCHES {
        thread_decided_branches(inout f);
    } else if step == STEP_THREAD_CONSTANT_PARAM_JUMPS {
        thread_constant_param_jumps(inout f);
    } else if step == STEP_PROPAGATE_BRANCH_CONDITIONS {
        propagate_branch_conditions(inout f);
    } else if step == STEP_CANONICALIZE_IMM_OPS {
        canonicalize_imm_ops(inout f);
    } else if step == STEP_FOLD_LOAD_STORE_OFFSETS {
        fold_load_store_offsets(inout f);
    } else if step == STEP_CSE_DOM_PURE {
        cse_dom_pure(inout f);
    } else {
        remove_constant_params(inout f);
    }
    out.push(PORTED);
    let script = f.script();
    out.extend(in script.as_slice());
    out
}
