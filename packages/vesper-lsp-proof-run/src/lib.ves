// @vesper/lsp-proof-run: the proof-lens runner of src/lsp/proof_lens.rs
// (`run`, `run_stages`, `ensure_olean`, `compile`, `bitvec_check`,
// `child_output`, `Cache`, `Stage`), part 8 of #1828. A job (as
// `proof_lens::job_words` lays it out) is read from a file; the runner
// starts Lean through its launcher, compiles the obligation modules into a
// private staging directory (reusing `.olean` files from the content-keyed
// cache), falls back to a `bv_decide` search when `omega` fails, replays
// every theorem through one `vesper proof-audit` run and interprets its
// JSON report. The outcome rows (`proof_lens::outcome_rows`) are written to
// a file.
//
// Modules:
// - json.ves: serde_json's `from_slice` into a value, and its strings.
// - text.ves: lossy UTF-8, trimming, `first_error`, error displays.
// - numbers.ves: serde_json's "number out of range" check (as in @vesper/lsp).

use @vesper-std/fs::{
    IoError, already_exists, read, write, rename, create_dir, create_dir_all, remove_dir_all,
    metadata, kind_dir, create_dir_mode, set_permissions, copy
};
use @vesper-std/process::{
    ExitStatus, ProcCommand, command_path, arg, arg_bytes, env, env_clear, cwd, stdio, spawn,
    wait_timeout, kill_tree, stdout, stderr, release, success, id, stdin_stream, stdout_stream,
    stderr_stream, capture, null, process_group, capture_limit
};
use @vesper-std/env::{var_bytes, os, os_windows};
use @vesper-std/hash::blake3::{blake3, digest_bytes};
use @vesper-std/bytes::ascii::{
    BACKSLASH, CARRIAGE_RETURN, COLON, DIGIT_NINE, DIGIT_ZERO, HASH, HYPHEN, LOWER_A, LOWER_F,
    LOWER_X, NEWLINE, PLUS, QUOTE, SEMICOLON, SLASH, TAB, UPPER_A, UPPER_F
};
use self::json::{
    Doc, parse, failed, root, field, str_is, put_str_of, is_true, u64_or_zero, items, item, kind,
    put, put_u64, put_error, put_string, STRING, ARRAY, NONE, HEX_LETTER_BASE, HEX_UPPER_LETTER_BASE
};
use self::text::{
    byte, put_bytes, lossy, trimmed, contains, find, trim, first_error, bounded, put_escaped,
    put_hex, put_io_error, put_status
};

const MAX_CAPTURE: u64 = 8388608;
// A job word, a little-endian u64.
const WORD_BYTES: u64 = 8;
// A model's cache key (a BLAKE3 digest).
const KEY_BYTES: u64 = 32;
// `0o700`, and the group and other bits `0o077` that make a directory
// reachable by others.
const PRIVATE_DIR_MODE: u32 = 448;
const GROUP_OTHER_BITS: u32 = 63;
const MILLIS_PER_SECOND: u64 = 1000;
// The `--print-prefix` timeout, and the slack the auditor gets past the
// job's timeout.
const PREFIX_TIMEOUT_SECONDS: u64 = 30;
const AUDIT_TIMEOUT_SLACK_SECONDS: u64 = 5;
// `Stage::new`'s tries at a fresh directory name.
const MAX_STAGE_ATTEMPTS: u64 = 64;
// A counterexample: the ` = ` between a name and its value, and at most
// `MAX_PARAMS` values (proof_model.rs).
const VALUE_SEPARATOR_BYTES: u64 = 3;
const MAX_PARAMS: u64 = 16;
// `Kind::code` of a parameter (proof_model.rs): i64 and bool.
const KIND_I64: u64 = 3;
const KIND_BOOL: u64 = 4;
// `0x`, and the sign bit of an i64 parameter's low 64 bits.
const HEX_PREFIX_BYTES: u64 = 2;
const I64_SIGN_BIT: u64 = 9223372036854775808;
// `proof_run`'s result.
const RUN_DONE: u64 = 0;
const RUN_BAD_JOB: u64 = 1;
const RUN_WRITE_FAILED: u64 = 2;

fn inc(x: u64) -> u64 {
    wrapping_add(x, 1)
}

fn g64(in values: ChunkSeq[u64], i: u64) -> u64 {
    match values.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

// ------------------------------------------------------------ the job

copy struct Rd {
    pos: u64
}

fn word(in bytes: Slice[u8], inout reader: Rd) -> u64 {
    let value = match bytes.try_read_u64_le(reader.pos) {
        Option::Some(value) => value,
        Option::None => 0,
    };
    reader.pos = wrapping_add(reader.pos, WORD_BYTES);
    value
}

// A length-prefixed string of the job: its offset and length.
fn text_at(in bytes: Slice[u8], inout reader: Rd, inout spans: ChunkSeq[u64]) {
    let len = word(in bytes, inout reader);
    spans.push(reader.pos);
    spans.push(len);
    reader.pos = wrapping_add(reader.pos, len);
}

fn copy_out(in bytes: Slice[u8], at: u64, len: u64) -> ChunkSeq[u8] {
    let mut out = ChunkSeq::with_capacity[u8](len);
    for i in at..wrapping_add(at, len) {
        out.push(byte(in bytes, i));
    }
    out
}

fn str_of(in bytes: Slice[u8]) -> String {
    match String::from_utf8(in bytes) {
        Option::Some(s) => s,
        Option::None => String::new(),
    }
}

// The decoded job. Strings are byte buffers; the models' strings live in
// `pool` (see `Model`).
struct Job {
    launcher: ChunkSeq[u8],
    has_auditor: bool,
    auditor: ChunkSeq[u8],
    has_cache: bool,
    cache: ChunkSeq[u8],
    timeout: u64,
    has_extraction: bool,
    extraction: ChunkSeq[u8],
    // Functions (offset, length into `names`).
    functions: ChunkSeq[u64],
    names: ChunkSeq[u8],
    models: ChunkSeq[Model],
    pool: ChunkSeq[u8],
    // Parameter names (offset, length into `pool`) and kinds.
    params: ChunkSeq[u64],
    kinds: ChunkSeq[u64]
}

// A model: offsets and lengths into the job's `pool` of its function,
// module name, theorem, exact and bit-vector modules and 32-byte key, and
// its parameters `param_start..param_start+param_count` of the job's `params` and `kinds`.
copy struct Model {
    function: u64,
    function_len: u64,
    module: u64,
    module_len: u64,
    theorem: u64,
    theorem_len: u64,
    exact: u64,
    exact_len: u64,
    bitvec: u64,
    bitvec_len: u64,
    key: u64,
    param_start: u64,
    param_count: u64
}

fn take(in bytes: Slice[u8], inout reader: Rd) -> ChunkSeq[u8] {
    let len = word(in bytes, inout reader);
    let out = copy_out(in bytes, reader.pos, len);
    reader.pos = wrapping_add(reader.pos, len);
    out
}

// A length-prefixed string into `pool`; its offset (the length is `pool`'s
// growth).
fn pooled(in bytes: Slice[u8], inout reader: Rd, inout pool: ChunkSeq[u8]) -> u64 {
    let at = pool.len();
    let len = word(in bytes, inout reader);
    for i in reader.pos..wrapping_add(reader.pos, len) {
        pool.push(byte(in bytes, i));
    }
    reader.pos = wrapping_add(reader.pos, len);
    at
}

fn read_job(in bytes: Slice[u8]) -> Job {
    let mut reader = Rd { pos: 0 };
    let launcher = take(in bytes, inout reader);
    let has_auditor = word(in bytes, inout reader) != 0;
    let auditor = if has_auditor {
        take(in bytes, inout reader)
    } else {
        ChunkSeq::new[u8]()
    };
    let has_cache = word(in bytes, inout reader) != 0;
    let cache = if has_cache {
        take(in bytes, inout reader)
    } else {
        ChunkSeq::new[u8]()
    };
    let timeout = word(in bytes, inout reader);
    let has_extraction = word(in bytes, inout reader) != 0;
    let mut extraction = ChunkSeq::new[u8]();
    let mut functions = ChunkSeq::new[u64]();
    let mut names = ChunkSeq::new[u8]();
    if has_extraction {
        extraction = take(in bytes, inout reader);
        let function_count = word(in bytes, inout reader);
        for i in 0..function_count {
            let func_name = take(in bytes, inout reader);
            functions.push(names.len());
            functions.push(func_name.len());
            put_bytes(inout names, in func_name.as_slice());
        }
    }
    let mut models = ChunkSeq::new[Model]();
    let mut pool = ChunkSeq::new[u8]();
    let mut params = ChunkSeq::new[u64]();
    let mut kinds = ChunkSeq::new[u64]();
    let model_count = word(in bytes, inout reader);
    for i in 0..model_count {
        let function = pooled(in bytes, inout reader, inout pool);
        let module = pooled(in bytes, inout reader, inout pool);
        let theorem = pooled(in bytes, inout reader, inout pool);
        let exact = pooled(in bytes, inout reader, inout pool);
        let bitvec = pooled(in bytes, inout reader, inout pool);
        let key = pool.len();
        for k in reader.pos..wrapping_add(reader.pos, KEY_BYTES) {
            pool.push(byte(in bytes, k));
        }
        reader.pos = wrapping_add(reader.pos, KEY_BYTES);
        let param_start = kinds.len();
        let param_count = word(in bytes, inout reader);
        for j in 0..param_count {
            let at = pooled(in bytes, inout reader, inout pool);
            params.push(at);
            params.push(wrapping_sub(pool.len(), at));
            kinds.push(word(in bytes, inout reader));
        }
        models.push(Model {
            function: function,
            function_len: wrapping_sub(module, function),
            module: module,
            module_len: wrapping_sub(theorem, module),
            theorem: theorem,
            theorem_len: wrapping_sub(exact, theorem),
            exact: exact,
            exact_len: wrapping_sub(bitvec, exact),
            bitvec: bitvec,
            bitvec_len: wrapping_sub(key, bitvec),
            key: key,
            param_start: param_start,
            param_count: param_count
        });
    }
    Job {
        launcher: launcher,
        has_auditor: has_auditor,
        auditor: auditor,
        has_cache: has_cache,
        cache: cache,
        timeout: timeout,
        has_extraction: has_extraction,
        extraction: extraction,
        functions: functions,
        names: names,
        models: models,
        pool: pool,
        params: params,
        kinds: kinds
    }
}

fn part(in job: Job, at: u64, len: u64) -> ChunkSeq[u8] {
    copy_out(in job.pool.as_slice(), at, len)
}

fn model_at(in job: Job, i: u64) -> Model {
    match job.models.try_get(i) {
        Option::Some(model) => model,
        Option::None => Model {
            function: 0,
            function_len: 0,
            module: 0,
            module_len: 0,
            theorem: 0,
            theorem_len: 0,
            exact: 0,
            exact_len: 0,
            bitvec: 0,
            bitvec_len: 0,
            key: 0,
            param_start: 0,
            param_count: 0
        },
    }
}

fn function_name(in job: Job, i: u64) -> ChunkSeq[u8] {
    let at = g64(in job.functions, wrapping_mul(i, 2));
    copy_out(in job.names.as_slice(), at, g64(in job.functions, inc(wrapping_mul(i, 2))))
}

fn nfunctions(in job: Job) -> u64 {
    job.functions.len() / 2
}

// ------------------------------------------------------------ files

fn ok_unit() -> Result[bool, IoError] {
    Result::Ok(true)
}

fn err_unit(error: IoError) -> Result[bool, IoError] {
    Result::Err(error)
}

fn f_write(in path: ChunkSeq[u8], in data: Slice[u8]) -> Result[bool, IoError] eff [Ffi[StdFs]] {
    let path_str = str_of(in path.as_slice());
    handle Fail[IoError] in {
        write(in path_str, in data);
        ok_unit()
    } with {
        return value => value,
        raise(e, resume) => err_unit(e),
    }
}

fn read_ok(sink data: ChunkSeq[u8]) -> Result[ChunkSeq[u8], IoError] {
    Result::Ok(data)
}

fn read_err(error: IoError) -> Result[ChunkSeq[u8], IoError] {
    Result::Err(error)
}

fn f_read(in path: ChunkSeq[u8]) -> Result[ChunkSeq[u8], IoError] eff [Ffi[StdFs]] {
    let path_str = str_of(in path.as_slice());
    handle Fail[IoError] in {
        read_ok(read(in path_str))
    } with {
        return value => value,
        raise(e, resume) => read_err(e),
    }
}

fn f_rename(in from: ChunkSeq[u8], in to: ChunkSeq[u8]) -> bool eff [Ffi[StdFs]] {
    let from_str = str_of(in from.as_slice());
    let to_str = str_of(in to.as_slice());
    let result = handle Fail[IoError] in {
        rename(in from_str, in to_str);
        ok_unit()
    } with {
        return value => value,
        raise(e, resume) => err_unit(e),
    };
    match result {
        Result::Ok(_) => true,
        Result::Err(_) => false,
    }
}

fn f_remove_all(in path: ChunkSeq[u8]) eff [Ffi[StdFs]] {
    let path_str = str_of(in path.as_slice());
    let result = handle Fail[IoError] in {
        remove_dir_all(in path_str);
        ok_unit()
    } with {
        return value => value,
        raise(e, resume) => err_unit(e),
    };
}

fn f_create_all(in path: ChunkSeq[u8]) -> bool eff [Ffi[StdFs]] {
    let path_str = str_of(in path.as_slice());
    let result = handle Fail[IoError] in {
        create_dir_all(in path_str);
        ok_unit()
    } with {
        return value => value,
        raise(e, resume) => err_unit(e),
    };
    match result {
        Result::Ok(_) => true,
        Result::Err(_) => false,
    }
}

// `private_dir`: a new directory, mode 0o700 on Unix.
fn private_dir(in path: ChunkSeq[u8]) -> Result[bool, IoError] eff [Ffi[StdFs]] {
    let path_str = str_of(in path.as_slice());
    handle Fail[IoError] in {
        create_dir_mode(in path_str, PRIVATE_DIR_MODE);
        ok_unit()
    } with {
        return value => value,
        raise(e, resume) => err_unit(e),
    }
}

// `Cache::open`'s Unix mode check: a directory others can reach is made
// private, and an error says why it is not.
fn make_private(in path: ChunkSeq[u8]) -> bool eff [Ffi[StdFs]] {
    if os() == os_windows() {
        return true;
    }
    let path_str = str_of(in path.as_slice());
    let result = handle Fail[IoError] in {
        let file_meta = metadata(in path_str);
        if (file_meta.mode & GROUP_OTHER_BITS) != 0 {
            set_permissions(in path_str, PRIVATE_DIR_MODE);
        }
        ok_unit()
    } with {
        return value => value,
        raise(e, resume) => err_unit(e),
    };
    match result {
        Result::Ok(_) => true,
        Result::Err(_) => false,
    }
}

fn is_dir(in path: ChunkSeq[u8]) -> bool eff [Ffi[StdFs]] {
    let path_str = str_of(in path.as_slice());
    let result = handle Fail[IoError] in {
        let file_meta = metadata(in path_str);
        if file_meta.kind == kind_dir() {
            ok_unit()
        } else {
            err_unit(IoError { kind: 0, os: 0 })
        }
    } with {
        return value => value,
        raise(e, resume) => err_unit(e),
    };
    match result {
        Result::Ok(_) => true,
        Result::Err(_) => false,
    }
}

// `fs::copy`.
fn f_copy(in from: ChunkSeq[u8], in to: ChunkSeq[u8]) -> bool eff [Ffi[StdFs]] {
    let from_str = str_of(in from.as_slice());
    let to_str = str_of(in to.as_slice());
    let result = handle Fail[IoError] in {
        let _ = copy(in from_str, in to_str);
        ok_unit()
    } with {
        return value => value,
        raise(e, resume) => err_unit(e),
    };
    match result {
        Result::Ok(_) => true,
        Result::Err(_) => false,
    }
}

// `Path::join` of a relative `name`.
fn join(in base: ChunkSeq[u8], in name: Str) -> ChunkSeq[u8] {
    let mut out = ChunkSeq::new[u8]();
    put_bytes(inout out, in base.as_slice());
    let sep: u8 = if os() == os_windows() {
        BACKSLASH
    } else {
        SLASH
    };
    let len = out.len();
    if len > 0 {
        let last = byte(in out.as_slice(), wrapping_sub(len, 1));
        if last != SLASH && !(last == BACKSLASH && sep == BACKSLASH) {
            out.push(sep);
        }
    }
    put(inout out, in name);
    out
}

fn join_bytes(in base: ChunkSeq[u8], in name: ChunkSeq[u8]) -> ChunkSeq[u8] {
    let name_str = str_of(in name.as_slice());
    join(in base, in name_str)
}

fn with_ext(in name: ChunkSeq[u8], in ext: Str) -> ChunkSeq[u8] {
    let mut out = ChunkSeq::new[u8]();
    put_bytes(inout out, in name.as_slice());
    put(inout out, in ext);
    out
}

// ------------------------------------------------------------ children

// A child's end: END_SUCCESS (`text` is its stdout), END_FAILURE (stdout,
// then stderr after a newline, or the exit status) or END_ERROR (`text` is
// the message).
const END_SUCCESS: u8 = 0;
const END_FAILURE: u8 = 1;
const END_ERROR: u8 = 2;

struct Ran {
    outcome: u8,
    text: ChunkSeq[u8]
}

fn ran(outcome: u8, sink text: ChunkSeq[u8]) -> Ran {
    Ran { outcome: outcome, text: text }
}

// `child_output`: run with stdin null, both streams captured (8 MiB each)
// in its own process group, killed with its tree past `seconds`.
fn child_output(sink command: ProcCommand, seconds: u64) -> Ran eff [Ffi[StdProcess]] {
    let mut command = command;
    stdio(inout command, stdin_stream(), null());
    stdio(inout command, stdout_stream(), capture());
    stdio(inout command, stderr_stream(), capture());
    process_group(inout command);
    capture_limit(inout command, MAX_CAPTURE);
    let mut process = match spawn(command) {
        Result::Ok(process) => process,
        Result::Err(e) => {
            let mut message = ChunkSeq::new[u8]();
            put(inout message, in "start process: ");
            put_io_error(inout message, e);
            return ran(END_ERROR, message);
        }
    };
    let status = match wait_timeout(inout process, wrapping_mul(seconds, MILLIS_PER_SECOND)) {
        Result::Ok(Option::Some(s)) => s,
        Result::Ok(Option::None) => {
            let _ = kill_tree(inout process);
            release(process);
            let mut message = ChunkSeq::new[u8]();
            put(inout message, in "process exceeded ");
            put_u64(inout message, seconds);
            put(inout message, in " seconds");
            return ran(END_ERROR, message);
        }
        Result::Err(e) => {
            release(process);
            let mut message = ChunkSeq::new[u8]();
            put_io_error(inout message, e);
            return ran(END_ERROR, message);
        }
    };
    let stdout_bytes = stdout(in process);
    let stderr_bytes = stderr(in process);
    release(process);
    if success(status) {
        return ran(END_SUCCESS, lossy(in stdout_bytes.as_slice()));
    }
    let mut text = lossy(in stdout_bytes.as_slice());
    if stderr_bytes.len() > 0 {
        text.push(NEWLINE);
        let stderr_text = lossy(in stderr_bytes.as_slice());
        put_bytes(inout text, in stderr_text.as_slice());
    }
    let trimmed_text = trimmed(in text.as_slice());
    if trimmed_text.len() == 0 {
        text.clear();
        put_status(inout text, status);
    }
    ran(END_FAILURE, text)
}

// `child`: success's output, or the error (a failure's first error line).
fn child(sink command: ProcCommand, seconds: u64) -> Ran eff [Ffi[StdProcess]] {
    let output = child_output(command, seconds);
    if output.outcome == END_FAILURE {
        return ran(END_FAILURE, first_error(in output.text.as_slice()));
    }
    output
}

// ------------------------------------------------------------ statuses

const PROVED: u8 = 0;
const CHECKED_NATIVE: u8 = 1;
const REFUTED: u8 = 2;
const FAILED: u8 = 3;

// A `ProofStatus`: its kind, the detail or counterexample (a failure's stage)
// in `detail`, and the failure reason in `reason`.
struct Status {
    code: u8,
    detail: ChunkSeq[u8],
    reason: ChunkSeq[u8]
}

fn status1(code: u8, in text: Str) -> Status {
    let mut detail = ChunkSeq::new[u8]();
    put(inout detail, in text);
    Status { code: code, detail: detail, reason: ChunkSeq::new[u8]() }
}

fn failed_status(in stage: Str, in reason: Slice[u8]) -> Status {
    let mut stage_text = ChunkSeq::new[u8]();
    put(inout stage_text, in stage);
    let mut reason_text = ChunkSeq::new[u8]();
    put_bytes(inout reason_text, in reason);
    Status { code: FAILED, detail: stage_text, reason: reason_text }
}

// `status_row`.
fn put_status_row(inout out: ChunkSeq[u8], in status: Status) {
    if status.code == PROVED {
        put(inout out, in "proved\t");
    } else if status.code == CHECKED_NATIVE {
        put(inout out, in "checked_native\t");
    } else if status.code == REFUTED {
        put(inout out, in "refuted\t");
    } else {
        put(inout out, in "failed\t");
        put_bytes(inout out, in status.detail.as_slice());
        out.push(TAB);
        put_escaped(inout out, in status.reason.as_slice());
        return;
    }
    put_escaped(inout out, in status.detail.as_slice());
}

// ------------------------------------------------------------ the run

struct St {
    ext_rows: ChunkSeq[u8],
    sem_rows: ChunkSeq[u8],
    reused: u64,
    compiled: u64,
    pid: u64,
    next_serial: u64,
    prefix: ChunkSeq[u8],
    lean_binary: ChunkSeq[u8],
    lean_version: ChunkSeq[u8],
    has_cache: bool,
    cache: ChunkSeq[u8],
    has_stage: bool,
    stage: ChunkSeq[u8],
    // The failing stage and reason of `run_stages`, and of a compile.
    fail_stage: ChunkSeq[u8],
    reason: ChunkSeq[u8]
}

fn ext_row(inout runner: St, in function: Slice[u8], in status: Status) {
    put(inout runner.ext_rows, in "E\t");
    put_bytes(inout runner.ext_rows, in function);
    runner.ext_rows.push(TAB);
    put_status_row(inout runner.ext_rows, in status);
    runner.ext_rows.push(NEWLINE);
}

fn sem_row(inout runner: St, in job: Job, model: Model, in status: Status) {
    put(inout runner.sem_rows, in "S\t");
    let function = part(in job, model.function, model.function_len);
    put_bytes(inout runner.sem_rows, in function.as_slice());
    runner.sem_rows.push(TAB);
    let key = part(in job, model.key, KEY_BYTES);
    put_hex(inout runner.sem_rows, in key.as_slice());
    runner.sem_rows.push(TAB);
    put_status_row(inout runner.sem_rows, in status);
    runner.sem_rows.push(NEWLINE);
}

fn stop(inout runner: St, in stage: Str, in reason: Slice[u8]) -> bool {
    runner.fail_stage.clear();
    put(inout runner.fail_stage, in stage);
    runner.reason.clear();
    put_bytes(inout runner.reason, in reason);
    false
}

fn stop_s(inout runner: St, in stage: Str, in reason: Str) -> bool {
    stop(inout runner, in stage, in reason.as_bytes())
}

fn stop_io(inout runner: St, in stage: Str, in prefix: Str, error: IoError) -> bool {
    let mut message = ChunkSeq::new[u8]();
    put(inout message, in prefix);
    put_io_error(inout message, error);
    stop(inout runner, in stage, in message.as_slice())
}

// `lean_command`: the Lean binary in `dir` with only `LEAN_PATH` and
// `LEAN_ABORT_ON_PANIC` set.
fn lean_command(in runner: St, in dir: ChunkSeq[u8]) -> ProcCommand eff [Ffi[StdProcess]] {
    let mut command = command_path(in runner.lean_binary.as_slice());
    env_clear(inout command);
    let mut search = ChunkSeq::new[u8]();
    put_bytes(inout search, in dir.as_slice());
    search.push(
        if os() == os_windows() {
            SEMICOLON
        } else {
            COLON
        }
    );
    let lib = join(in runner.prefix, in "lib/lean");
    put_bytes(inout search, in lib.as_slice());
    let search_str = str_of(in search.as_slice());
    env(inout command, in "LEAN_PATH", in search_str);
    env(inout command, in "LEAN_ABORT_ON_PANIC", in "1");
    let dir_str = str_of(in dir.as_slice());
    cwd(inout command, in dir_str);
    command
}

// `compile`: `<module>.lean` into `<module>.olean` in the stage. On a
// failure the reason is in `runner.reason`.
fn compile(inout runner: St, in module: ChunkSeq[u8], timeout: u64) -> bool eff [Ffi[StdProcess]] {
    if bad_search(in runner, in runner.stage) {
        runner.reason.clear();
        put_join_paths_error(inout runner.reason);
        return false;
    }
    let mut command = lean_command(in runner, in runner.stage);
    arg(inout command, in "-j1");
    arg(inout command, in "-M1024");
    arg(inout command, in "-o");
    let olean = with_ext(in module, in ".olean");
    arg_bytes(inout command, in olean.as_slice());
    let lean = with_ext(in module, in ".lean");
    arg_bytes(inout command, in lean.as_slice());
    let output = child(command, timeout);
    if output.outcome == END_SUCCESS {
        return true;
    }
    runner.reason.clear();
    put_bytes(inout runner.reason, in output.text.as_slice());
    false
}

// `ensure_olean`: `<module>.olean` for `text` in the stage, from the cache
// or compiled. On a failure the reason is in `runner.reason`.
fn ensure_olean(
    inout runner: St,
    in module: ChunkSeq[u8],
    in text: ChunkSeq[u8],
    timeout: u64
) -> bool eff [Ffi[StdProcess], Ffi[StdFs]] {
    let mut keyed = ChunkSeq::new[u8]();
    put_bytes(inout keyed, in runner.lean_version.as_slice());
    keyed.push(0);
    put_bytes(inout keyed, in module.as_slice());
    keyed.push(0);
    put_bytes(inout keyed, in text.as_slice());
    let mut digest = ChunkSeq::new[u8]();
    digest_bytes(blake3(in keyed.as_slice()), inout digest);
    let mut key = ChunkSeq::new[u8]();
    put_hex(inout key, in digest.as_slice());
    let olean_name = with_ext(in module, in ".olean");
    let olean = join_bytes(in runner.stage, in olean_name);
    if runner.has_cache && cache_fetch(in runner, in key, in module, in text, in olean) {
        runner.reused = inc(runner.reused);
        return true;
    }
    let lean_name = with_ext(in module, in ".lean");
    let source = join_bytes(in runner.stage, in lean_name);
    match f_write(in source, in text.as_slice()) {
        Result::Ok(_) => {},
        Result::Err(e) => {
            runner.reason.clear();
            put_io_error(inout runner.reason, e);
            return false;
        }
    }
    if !compile(inout runner, in module, timeout) {
        return false;
    }
    runner.compiled = inc(runner.compiled);
    if runner.has_cache {
        cache_store(inout runner, in key, in module, in text, in olean);
    }
    true
}

// ------------------------------------------------------------ the cache

fn cache_fetch(
    in runner: St,
    in key: ChunkSeq[u8],
    in module: ChunkSeq[u8],
    in text: ChunkSeq[u8],
    in into: ChunkSeq[u8]
) -> bool eff [Ffi[StdFs]] {
    let dir = join_bytes(in runner.cache, in key);
    let lean = join_bytes(in dir, in with_ext(in module, in ".lean"));
    let same = match f_read(in lean) {
        Result::Ok(source) => same_bytes(in source.as_slice(), in text.as_slice()),
        Result::Err(_) => false,
    };
    if !same {
        return false;
    }
    let olean = join_bytes(in dir, in with_ext(in module, in ".olean"));
    f_copy(in olean, in into)
}

fn same_bytes(in left: Slice[u8], in right: Slice[u8]) -> bool {
    if left.len() != right.len() {
        return false;
    }
    for i in 0..left.len() {
        if byte(in left, i) != byte(in right, i) {
            return false;
        }
    }
    true
}

fn cache_store(
    inout runner: St,
    in key: ChunkSeq[u8],
    in module: ChunkSeq[u8],
    in text: ChunkSeq[u8],
    in olean: ChunkSeq[u8]
) eff [Ffi[StdFs]] {
    let dir = join_bytes(in runner.cache, in key);
    let mut temp_name = ChunkSeq::new[u8]();
    put(inout temp_name, in ".tmp-");
    put_bytes(inout temp_name, in key.as_slice());
    temp_name.push(HYPHEN);
    put_u64(inout temp_name, runner.pid);
    temp_name.push(HYPHEN);
    put_u64(inout temp_name, runner.next_serial);
    runner.next_serial = inc(runner.next_serial);
    let temp = join_bytes(in runner.cache, in temp_name);
    let mut written = match private_dir(in temp) {
        Result::Ok(_) => true,
        Result::Err(_) => false,
    };
    if written {
        let lean = join_bytes(in temp, in with_ext(in module, in ".lean"));
        written = match f_write(in lean, in text.as_slice()) {
            Result::Ok(_) => true,
            Result::Err(_) => false,
        };
    }
    if written {
        let to = join_bytes(in temp, in with_ext(in module, in ".olean"));
        written = f_copy(in olean, in to);
    }
    if !written || !f_rename(in temp, in dir) {
        f_remove_all(in temp);
    }
}

// `Cache::outcome`: a cached `refuted` or `checked_native` outcome of the
// model keyed `key` under this Lean version.
fn cache_outcome(in runner: St, in key: ChunkSeq[u8], inout out: Status) -> bool eff [Ffi[StdFs]] {
    let dir = join_bytes(in runner.cache, in key);
    let path = join(in dir, in "outcome.json");
    let data = match f_read(in path) {
        Result::Ok(bytes) => bytes,
        Result::Err(_) => return false,
    };
    // `read_to_string`: the file must be UTF-8.
    match String::from_utf8(in data.as_slice()) {
        Option::Some(_) => {},
        Option::None => return false,
    }
    let doc = parse(in data.as_slice());
    if failed(in doc) {
        return false;
    }
    let root_id = root(in doc);
    if !str_is(in doc, field(in doc, root_id, in "lean"), in runner.lean_version.as_slice()) {
        return false;
    }
    let status_id = field(in doc, root_id, in "status");
    let mut detail = ChunkSeq::new[u8]();
    if str_is(in doc, status_id, in "refuted".as_bytes()) {
        let value_id = field(in doc, root_id, in "counterexample");
        if kind(in doc, value_id) == STRING {
            put_str_of(inout detail, in doc, value_id);
        }
        out = Status { code: REFUTED, detail: detail, reason: ChunkSeq::new[u8]() };
        return true;
    }
    if str_is(in doc, status_id, in "checked_native".as_bytes()) {
        let value_id = field(in doc, root_id, in "detail");
        if kind(in doc, value_id) == STRING {
            put_str_of(inout detail, in doc, value_id);
        }
        out = Status { code: CHECKED_NATIVE, detail: detail, reason: ChunkSeq::new[u8]() };
        return true;
    }
    false
}

// `Cache::record_outcome`: keep a refutation or a native check.
fn cache_record(inout runner: St, in key: ChunkSeq[u8], in status: Status) eff [Ffi[StdFs]] {
    let mut record = ChunkSeq::new[u8]();
    if status.code == REFUTED {
        put(inout record, in "{\"counterexample\":");
        put_string(inout record, in status.detail.as_slice());
        put(inout record, in ",\"lean\":");
        put_string(inout record, in runner.lean_version.as_slice());
        put(inout record, in ",\"status\":\"refuted\"}");
    } else if status.code == CHECKED_NATIVE {
        put(inout record, in "{\"detail\":");
        put_string(inout record, in status.detail.as_slice());
        put(inout record, in ",\"lean\":");
        put_string(inout record, in runner.lean_version.as_slice());
        put(inout record, in ",\"status\":\"checked_native\"}");
    } else {
        return;
    }
    let dir = join_bytes(in runner.cache, in key);
    if !is_dir(in dir) {
        match private_dir(in dir) {
            Result::Ok(_) => {},
            Result::Err(_) => return,
        }
    }
    let mut temp_name = ChunkSeq::new[u8]();
    put(inout temp_name, in ".outcome-");
    put_u64(inout temp_name, runner.pid);
    let temp = join_bytes(in dir, in temp_name);
    match f_write(in temp, in record.as_slice()) {
        Result::Ok(_) => {
            let to = join(in dir, in "outcome.json");
            let _ = f_rename(in temp, in to);
        },
        Result::Err(_) => {},
    }
}

// ------------------------------------------------------------ bv_decide

// `env::join_paths` refuses a segment holding the separator.
fn bad_search(in runner: St, in dir: ChunkSeq[u8]) -> bool {
    let sep: u8 = if os() == os_windows() { QUOTE } else { COLON };
    let lib = join(in runner.prefix, in "lib/lean");
    has(in dir.as_slice(), sep) || has(in lib.as_slice(), sep)
}

fn has(in bytes: Slice[u8], needle: u8) -> bool {
    for i in 0..bytes.len() {
        if byte(in bytes, i) == needle {
            return true;
        }
    }
    false
}

fn put_join_paths_error(inout out: ChunkSeq[u8]) {
    if os() == os_windows() {
        put(inout out, in "path segment contains `\"`");
    } else {
        put(inout out, in "path segment contains separator `:`");
    }
}

// `bitvec_check`: the `bv_decide` rendering of a model `omega` did not
// prove.
fn bitvec_check(
    inout runner: St,
    in job: Job,
    model: Model,
    in omega: ChunkSeq[u8],
    timeout: u64
) -> Status eff [Ffi[StdProcess], Ffi[StdFs]] {
    let name = part(in job, model.module, model.module_len);
    let module = with_ext(in name, in "_bv");
    let lean_name = with_ext(in module, in ".lean");
    let path = join_bytes(in runner.stage, in lean_name);
    let text = part(in job, model.bitvec, model.bitvec_len);
    match f_write(in path, in text.as_slice()) {
        Result::Ok(_) => {},
        Result::Err(e) => {
            let mut reason_text = ChunkSeq::new[u8]();
            put_io_error(inout reason_text, e);
            return failed_status(in "io", in reason_text.as_slice());
        }
    }
    if bad_search(in runner, in runner.stage) {
        let mut reason_text = ChunkSeq::new[u8]();
        put_join_paths_error(inout reason_text);
        return failed_status(in "io", in reason_text.as_slice());
    }
    let mut command = lean_command(in runner, in runner.stage);
    arg(inout command, in "-j1");
    arg(inout command, in "-M1024");
    arg_bytes(inout command, in lean_name.as_slice());
    let output = child_output(command, timeout);
    if output.outcome == END_SUCCESS {
        return status1(
            CHECKED_NATIVE,
            in "bv_decide found no counterexample (native LRAT check through Lean.ofReduceBool; not replayed by the kernel auditor); omega did not prove it"
        );
    }
    if output.outcome == END_FAILURE {
        let mut cex = ChunkSeq::new[u8]();
        if counterexample(in job, model, in output.text.as_slice(), inout cex) {
            return Status { code: REFUTED, detail: cex, reason: ChunkSeq::new[u8]() };
        }
        let mut reason = ChunkSeq::new[u8]();
        put(inout reason, in "omega: ");
        let omega_error = first_error(in omega.as_slice());
        put_bytes(inout reason, in omega_error.as_slice());
        put(inout reason, in "; bv_decide: ");
        let bv_error = first_error(in output.text.as_slice());
        put_bytes(inout reason, in bv_error.as_slice());
        let bounded_reason = bounded(in reason.as_slice());
        return failed_status(in "prove", in bounded_reason.as_slice());
    }
    let bounded_reason = bounded(in output.text.as_slice());
    failed_status(in "prove", in bounded_reason.as_slice())
}

// The parameter of `model` named `text[name_start..name_end]`, or NONE.
fn param_of(in job: Job, model: Model, in text: Slice[u8], name_start: u64, name_end: u64) -> u64 {
    for i in 0..model.param_count {
        let param_index = wrapping_add(model.param_start, i);
        let at = g64(in job.params, wrapping_mul(param_index, 2));
        let len = g64(in job.params, inc(wrapping_mul(param_index, 2)));
        if len == wrapping_sub(name_end, name_start) {
            let mut same = true;
            for j in 0..len {
                if byte(in job.pool.as_slice(), wrapping_add(at, j))
                    != byte(in text, wrapping_add(name_start, j)) {
                    same = false;
                    break;
                }
            }
            if same {
                return param_index;
            }
        }
    }
    NONE
}

// `Model::counterexample`: the assignment after "found a counterexample",
// as source values, at most 16 of them.
fn counterexample(in job: Job, model: Model, in text: Slice[u8], inout out: ChunkSeq[u8]) -> bool {
    let start = find(in text, 0, text.len(), in "found a counterexample".as_bytes());
    if start == NONE {
        return false;
    }
    let mut count: u64 = 0;
    let mut line_start = start;
    let mut first = true;
    loop {
        if line_start >= text.len() {
            break;
        }
        // One `lines()` line.
        let mut line_end = line_start;
        loop {
            if line_end >= text.len() || byte(in text, line_end) == NEWLINE {
                break;
            }
            line_end = inc(line_end);
        }
        let next = inc(line_end);
        let mut content_end = line_end;
        if line_end < text.len()
            && content_end > line_start
            && byte(in text, wrapping_sub(content_end, 1)) == CARRIAGE_RETURN {
            content_end = wrapping_sub(content_end, 1);
        }
        if first {
            first = false;
            line_start = next;
            continue;
        }
        let eq_at = find(in text, line_start, content_end, in " = ".as_bytes());
        if eq_at == NONE {
            if count == 0 {
                line_start = next;
                continue;
            }
            break;
        }
        let mut name_start = line_start;
        let mut name_end = eq_at;
        trim(in text, inout name_start, inout name_end);
        let param_index = param_of(in job, model, in text, name_start, name_end);
        if param_index != NONE {
            let mut value_start = wrapping_add(eq_at, VALUE_SEPARATOR_BYTES);
            let mut value_end = content_end;
            trim(in text, inout value_start, inout value_end);
            if count > 0 {
                put(inout out, in ", ");
            }
            for i in name_start..name_end {
                out.push(byte(in text, i));
            }
            put(inout out, in " = ");
            render_value(
                inout out,
                in text,
                value_start,
                value_end,
                g64(in job.kinds, param_index)
            );
            count = inc(count);
            if count >= MAX_PARAMS {
                break;
            }
        }
        line_start = next;
    }
    count > 0
}

fn digit_of(c: u8, hex: bool) -> u64 {
    if c >= DIGIT_ZERO && c <= DIGIT_NINE {
        return widen_u64(wrapping_sub(c, DIGIT_ZERO));
    }
    if hex && c >= LOWER_A && c <= LOWER_F {
        return widen_u64(wrapping_sub(c, HEX_LETTER_BASE));
    }
    if hex && c >= UPPER_A && c <= UPPER_F {
        return widen_u64(wrapping_sub(c, HEX_UPPER_LETTER_BASE));
    }
    NONE
}

fn put_u128(inout out: ChunkSeq[u8], value: u128) {
    if value >= 10 {
        put_u128(inout out, value / 10);
    }
    out.push(wrapping_u8(wrapping_add(value % 10, widen_u128(DIGIT_ZERO))));
}

// `render_value`: a bool as written; else the digits before `#` (hex
// after `0x`) as a u128, an i64 parameter as its low 64 bits signed; the
// text itself when it does not parse.
fn render_value(inout out: ChunkSeq[u8], in text: Slice[u8], start: u64, end: u64, kind_code: u64) {
    if kind_code != KIND_BOOL {
        let mut digits_end = start;
        loop {
            if digits_end >= end || byte(in text, digits_end) == HASH {
                break;
            }
            digits_end = inc(digits_end);
        }
        let mut i = start;
        let hex = wrapping_sub(digits_end, start) >= HEX_PREFIX_BYTES
            && byte(in text, start) == DIGIT_ZERO
            && byte(in text, inc(start)) == LOWER_X;
        if hex {
            i = wrapping_add(start, HEX_PREFIX_BYTES);
        }
        if i < digits_end && byte(in text, i) == PLUS {
            i = inc(i);
        }
        let base: u128 = if hex { 16 } else { 10 };
        let mut value: u128 = 0;
        let mut ok = i < digits_end;
        for j in i..digits_end {
            if ok {
                let digit = digit_of(byte(in text, j), hex);
                if digit == NONE {
                    ok = false;
                } else {
                    match checked_mul_u128(value, base) {
                        Option::Some(scaled) => match checked_add_u128(scaled, widen_u128(digit)) {
                            Option::Some(sum) => {
                                value = sum;
                            },
                            Option::None => {
                                ok = false;
                            },
                        },
                        Option::None => {
                            ok = false;
                        },
                    }
                }
            }
        }
        if ok {
            if kind_code == KIND_I64 {
                let bits = wrapping_u64(value);
                if bits >= I64_SIGN_BIT {
                    out.push(HYPHEN);
                    put_u64(inout out, wrapping_sub(0, bits));
                } else {
                    put_u64(inout out, bits);
                }
            } else {
                put_u128(inout out, value);
            }
            return;
        }
    }
    for i in start..end {
        out.push(byte(in text, i));
    }
}

// ------------------------------------------------------------ the stages

fn copy_bytes(in bytes: ChunkSeq[u8]) -> ChunkSeq[u8] {
    copy_out(in bytes.as_slice(), 0, bytes.len())
}

// `env::temp_dir()`.
fn temp_dir() -> ChunkSeq[u8] eff [Ffi[StdEnv]] {
    let mut out = ChunkSeq::new[u8]();
    if os() == os_windows() {
        for var_index in 0..3 {
            let var_value = if var_index == 0 {
                var_bytes(in "TMP")
            } else if var_index == 1 {
                var_bytes(in "TEMP")
            } else {
                var_bytes(in "USERPROFILE")
            };
            match var_value {
                Option::Some(dir) => {
                    put_bytes(inout out, in dir.as_slice());
                    out.push(BACKSLASH);
                    return out;
                },
                Option::None => {},
            }
        }
        put(inout out, in "C:\\Windows\\");
        return out;
    }
    match var_bytes(in "TMPDIR") {
        Option::Some(dir) => {
            put_bytes(inout out, in dir.as_slice());
        },
        Option::None => {
            put(inout out, in "/tmp");
        },
    }
    out
}

// `Stage::new`: a private staging directory.
fn make_stage(inout runner: St) -> bool eff [Ffi[StdFs], Ffi[StdEnv]] {
    let base = temp_dir();
    for attempt in 0..MAX_STAGE_ATTEMPTS {
        let mut name = ChunkSeq::new[u8]();
        put(inout name, in "vesper-lens-proof-");
        put_u64(inout name, runner.pid);
        name.push(HYPHEN);
        put_u64(inout name, runner.next_serial);
        runner.next_serial = inc(runner.next_serial);
        let path = join_bytes(in base, in name);
        match private_dir(in path) {
            Result::Ok(_) => {
                runner.stage = path;
                runner.has_stage = true;
                return true;
            },
            Result::Err(e) => {
                if e.kind != already_exists() {
                    return stop_io(
                        inout runner,
                        in "io",
                        in "private proof staging directory: ",
                        e
                    );
                }
            },
        }
    }
    stop_s(inout runner, in "io", in "cannot allocate a private proof staging directory")
}

// Theorems queued for the one kernel audit: per audited module its name
// (offset, length into `names`) and its theorems.
struct Audit {
    modules: ChunkSeq[u64],
    theorems: ChunkSeq[u64],
    names: ChunkSeq[u8]
}

fn add_name(inout audit: Audit, in name: Slice[u8], is_module: bool) {
    let at = audit.names.len();
    put_bytes(inout audit.names, in name);
    if is_module {
        audit.modules.push(at);
        audit.modules.push(name.len());
    } else {
        audit.theorems.push(at);
        audit.theorems.push(name.len());
    }
}

fn audit_name(in audit: Audit, in list: ChunkSeq[u64], i: u64) -> ChunkSeq[u8] {
    copy_out(
        in audit.names.as_slice(),
        g64(in list, wrapping_mul(i, 2)),
        g64(in list, inc(wrapping_mul(i, 2)))
    )
}

fn audited(in audit: Audit, in module: Slice[u8]) -> bool {
    for i in 0..audit.modules.len() / 2 {
        let name = audit_name(in audit, in audit.modules, i);
        if same_bytes(in name.as_slice(), in module) {
            return true;
        }
    }
    false
}

fn obligation(i: u64) -> ChunkSeq[u8] {
    let mut name = ChunkSeq::new[u8]();
    put(inout name, in "VesperLens.obligation_");
    put_u64(inout name, i);
    name
}

// The report's theorem named `name`: whether it is listed, its string
// axioms (", "-joined into `list`), how many, and whether all are standard.
fn axioms_of(
    in doc: Doc,
    in name: Slice[u8],
    inout list: ChunkSeq[u8],
    inout count: u64,
    inout standard: bool
) -> bool {
    let theorems = field(in doc, root(in doc), in "theorems");
    for i in 0..items(in doc, theorems) {
        let theorem = item(in doc, theorems, i);
        if str_is(in doc, field(in doc, theorem, in "name"), in name) {
            let axioms = field(in doc, theorem, in "axioms");
            for j in 0..items(in doc, axioms) {
                let axiom = item(in doc, axioms, j);
                if kind(in doc, axiom) == STRING {
                    if count > 0 {
                        put(inout list, in ", ");
                    }
                    count = inc(count);
                    let allowed = str_is(in doc, axiom, in "propext".as_bytes())
                        || str_is(in doc, axiom, in "Quot.sound".as_bytes())
                        || str_is(in doc, axiom, in "Classical.choice".as_bytes());
                    if !allowed {
                        standard = false;
                    }
                    put_str_of(inout list, in doc, axiom);
                }
            }
            return true;
        }
    }
    false
}

// `run_stages`; false with the failing stage and reason in `runner`.
fn run_stages(
    inout runner: St,
    in job: Job
) -> bool eff [Ffi[StdProcess], Ffi[StdFs], Ffi[StdEnv]] {
    let timeout = job.timeout;
    if !job.has_auditor {
        return stop_s(inout runner, in "toolchain", in "the vesper proof auditor is unavailable");
    }
    let mut command = command_path(in job.launcher.as_slice());
    arg(inout command, in "--print-prefix");
    let output = child(command, PREFIX_TIMEOUT_SECONDS);
    if output.outcome != END_SUCCESS {
        return stop(inout runner, in "toolchain", in output.text.as_slice());
    }
    runner.prefix = trimmed(in output.text.as_slice());
    let bin_dir = join(in runner.prefix, in "bin");
    runner.lean_binary = if os() == os_windows() {
        join(in bin_dir, in "lean.exe")
    } else {
        join(in bin_dir, in "lean")
    };
    let mut command = command_path(in runner.lean_binary.as_slice());
    arg(inout command, in "--version");
    let output = child(command, timeout);
    if output.outcome != END_SUCCESS {
        return stop(inout runner, in "toolchain", in output.text.as_slice());
    }
    runner.lean_version = trimmed(in output.text.as_slice());
    if !contains(
        in runner.lean_version.as_slice(),
        0,
        runner.lean_version.len(),
        in "version 4.35.0,".as_bytes()
    ) {
        return stop_s(inout runner, in "toolchain", in "proof lenses require Lean 4.35.0");
    }
    // `Cache::open`.
    runner.cache = copy_bytes(in job.cache);
    runner.has_cache = job.has_cache && f_create_all(in job.cache) && make_private(in job.cache);
    if !make_stage(inout runner) {
        return false;
    }
    let mut audit = Audit {
        modules: ChunkSeq::new[u64](),
        theorems: ChunkSeq::new[u64](),
        names: ChunkSeq::new[u8]()
    };

    if job.has_extraction {
        let mut name = ChunkSeq::new[u8]();
        put(inout name, in "VesperLensObligation");
        if ensure_olean(inout runner, in name, in job.extraction, timeout) {
            add_name(inout audit, in name.as_slice(), true);
            for i in 0..nfunctions(in job) {
                let theorem_name = obligation(i);
                add_name(inout audit, in theorem_name.as_slice(), false);
            }
        } else {
            let bounded_reason = bounded(in runner.reason.as_slice());
            let status = failed_status(in "compile", in bounded_reason.as_slice());
            for i in 0..nfunctions(in job) {
                let function = function_name(in job, i);
                ext_row(inout runner, in function.as_slice(), in status);
            }
        }
    }

    for model_index in 0..job.models.len() {
        let model = model_at(in job, model_index);
        let raw = part(in job, model.key, 32);
        let mut key = ChunkSeq::new[u8]();
        put_hex(inout key, in raw.as_slice());
        let mut cached = status1(PROVED, in "");
        if runner.has_cache && cache_outcome(in runner, in key, inout cached) {
            sem_row(inout runner, in job, model, in cached);
        } else {
            let module = part(in job, model.module, model.module_len);
            let exact = part(in job, model.exact, model.exact_len);
            if ensure_olean(inout runner, in module, in exact, timeout) {
                add_name(inout audit, in module.as_slice(), true);
                let theorem_name = part(in job, model.theorem, model.theorem_len);
                add_name(inout audit, in theorem_name.as_slice(), false);
            } else {
                let omega = copy_bytes(in runner.reason);
                let status = bitvec_check(inout runner, in job, model, in omega, timeout);
                if runner.has_cache {
                    cache_record(inout runner, in key, in status);
                }
                sem_row(inout runner, in job, model, in status);
            }
        }
    }
    if audit.modules.len() == 0 {
        return true;
    }

    // One aggregate module and one kernel replay for every theorem.
    let mut imports = ChunkSeq::new[u8]();
    for i in 0..audit.modules.len() / 2 {
        put(inout imports, in "import ");
        let module_name = audit_name(in audit, in audit.modules, i);
        put_bytes(inout imports, in module_name.as_slice());
        imports.push(10);
    }
    let path = join(in runner.stage, in "VesperLensRun.lean");
    match f_write(in path, in imports.as_slice()) {
        Result::Ok(_) => {},
        Result::Err(e) => return stop_io(inout runner, in "io", in "", e),
    }
    let mut run = ChunkSeq::new[u8]();
    put(inout run, in "VesperLensRun");
    if !compile(inout runner, in run, timeout) {
        let reason = copy_bytes(in runner.reason);
        return stop(inout runner, in "compile", in reason.as_slice());
    }
    let mut command = command_path(in job.auditor.as_slice());
    arg(inout command, in "proof-audit");
    arg(inout command, in "VesperLensRun");
    arg(inout command, in "--root");
    arg_bytes(inout command, in runner.stage.as_slice());
    for i in 0..audit.theorems.len() / 2 {
        arg(inout command, in "--theorem");
        let theorem_name = audit_name(in audit, in audit.theorems, i);
        arg_bytes(inout command, in theorem_name.as_slice());
    }
    arg(inout command, in "--allow-axiom");
    arg(inout command, in "propext");
    arg(inout command, in "--allow-axiom");
    arg(inout command, in "Quot.sound");
    arg(inout command, in "--allow-axiom");
    arg(inout command, in "Classical.choice");
    arg(inout command, in "--json");
    arg(inout command, in "--timeout");
    let mut timeout_arg = ChunkSeq::new[u8]();
    put_u64(inout timeout_arg, timeout);
    arg_bytes(inout command, in timeout_arg.as_slice());
    arg(inout command, in "--lean");
    arg_bytes(inout command, in runner.lean_binary.as_slice());
    let output = child(command, wrapping_add(timeout, AUDIT_TIMEOUT_SLACK_SECONDS));
    if output.outcome != END_SUCCESS {
        return stop(inout runner, in "kernel", in output.text.as_slice());
    }
    let doc = parse(in output.text.as_slice());
    if failed(in doc) {
        let mut message = ChunkSeq::new[u8]();
        put(inout message, in "audit report: ");
        put_error(inout message, in doc, in output.text.as_slice());
        return stop(inout runner, in "kernel", in message.as_slice());
    }
    let root_id = root(in doc);
    if !is_true(in doc, field(in doc, root_id, in "kernel_replayed")) {
        return stop_s(inout runner, in "kernel", in "the audit did not replay the kernel");
    }
    let checked = u64_or_zero(in doc, field(in doc, root_id, in "checked_constants"));
    if job.has_extraction && audited(in audit, in "VesperLensObligation".as_bytes()) {
        for i in 0..nfunctions(in job) {
            let theorem_name = obligation(i);
            let mut list = ChunkSeq::new[u8]();
            let mut axiom_count: u64 = 0;
            let mut standard = true;
            let found = axioms_of(
                in doc,
                in theorem_name.as_slice(),
                inout list,
                inout axiom_count,
                inout standard
            );
            let status = if found && axiom_count == 0 {
                let mut detail = ChunkSeq::new[u8]();
                put(inout detail, in "kernel replayed ");
                put_u64(inout detail, checked);
                put(inout detail, in " constants with an empty axiom policy");
                Status { code: PROVED, detail: detail, reason: ChunkSeq::new[u8]() }
            } else {
                failed_status(
                    in "kernel",
                    in "the obligation failed the empty-axiom kernel audit".as_bytes()
                )
            };
            let function = function_name(in job, i);
            ext_row(inout runner, in function.as_slice(), in status);
        }
    }
    for model_index in 0..job.models.len() {
        let model = model_at(in job, model_index);
        let module = part(in job, model.module, model.module_len);
        if audited(in audit, in module.as_slice()) {
            let theorem_name = part(in job, model.theorem, model.theorem_len);
            let mut list = ChunkSeq::new[u8]();
            let mut axiom_count: u64 = 0;
            let mut standard = true;
            let found = axioms_of(
                in doc,
                in theorem_name.as_slice(),
                inout list,
                inout axiom_count,
                inout standard
            );
            let status = if found && standard {
                let mut detail = ChunkSeq::new[u8]();
                put(inout detail, in "omega proof replayed by the kernel; axioms: ");
                if axiom_count == 0 {
                    put(inout detail, in "none");
                } else {
                    put_bytes(inout detail, in list.as_slice());
                }
                Status { code: PROVED, detail: detail, reason: ChunkSeq::new[u8]() }
            } else {
                failed_status(
                    in "kernel",
                    in "the theorem uses a forbidden axiom or was not replayed".as_bytes()
                )
            };
            sem_row(inout runner, in job, model, in status);
        }
    }
    true
}

// ------------------------------------------------------------ the entry

fn new_st(pid: u64) -> St {
    St {
        ext_rows: ChunkSeq::new[u8](),
        sem_rows: ChunkSeq::new[u8](),
        reused: 0,
        compiled: 0,
        pid: pid,
        next_serial: 0,
        prefix: ChunkSeq::new[u8](),
        lean_binary: ChunkSeq::new[u8](),
        lean_version: ChunkSeq::new[u8](),
        has_cache: false,
        cache: ChunkSeq::new[u8](),
        has_stage: false,
        stage: ChunkSeq::new[u8](),
        fail_stage: ChunkSeq::new[u8](),
        reason: ChunkSeq::new[u8]()
    }
}

// `run`'s `fail_all`: every function and model failed at the stage.
fn fail_all(inout runner: St, in job: Job) {
    runner.ext_rows.clear();
    runner.sem_rows.clear();
    let stage = copy_bytes(in runner.fail_stage);
    let reason = bounded(in runner.reason.as_slice());
    let status = Status { code: FAILED, detail: stage, reason: reason };
    for i in 0..nfunctions(in job) {
        let function = function_name(in job, i);
        ext_row(inout runner, in function.as_slice(), in status);
    }
    for model_index in 0..job.models.len() {
        let model = model_at(in job, model_index);
        sem_row(inout runner, in job, model, in status);
    }
}

// Run the job in the file `job_path` (`proof_lens::job_words`) and write
// its outcome rows (`proof_lens::outcome_rows`) to `out_path`: 0, or 1 when
// the job cannot be read, 2 when the rows cannot be written.
pub fn proof_run(
    in job_path: Str,
    in out_path: Str
) -> u64 eff [Ffi[StdFs], Ffi[StdProcess], Ffi[StdEnv]] {
    let mut job_file = ChunkSeq::new[u8]();
    put(inout job_file, in job_path);
    let data = match f_read(in job_file) {
        Result::Ok(bytes) => bytes,
        Result::Err(_) => return RUN_BAD_JOB,
    };
    let job = read_job(in data.as_slice());
    let mut runner = new_st(id());
    let ok = run_stages(inout runner, in job);
    if runner.has_stage {
        f_remove_all(in runner.stage);
    }
    if !ok {
        fail_all(inout runner, in job);
    }
    let mut out = ChunkSeq::new[u8]();
    put_bytes(inout out, in runner.ext_rows.as_slice());
    put_bytes(inout out, in runner.sem_rows.as_slice());
    put(inout out, in "R\t");
    put_u64(inout out, runner.reused);
    out.push(TAB);
    put_u64(inout out, runner.compiled);
    out.push(NEWLINE);
    let mut out_file = ChunkSeq::new[u8]();
    put(inout out_file, in out_path);
    match f_write(in out_file, in out.as_slice()) {
        Result::Ok(_) => RUN_DONE,
        Result::Err(_) => RUN_WRITE_FAILED,
    }
}

// How many obligations a job (`proof_lens::job_words`) holds: its
// extraction functions and semantic models. Pure; the Stage 2 package
// probe calls it.
pub fn job_obligations(in job: Slice[u8]) -> u64 {
    let parsed_job = read_job(in job);
    wrapping_add(nfunctions(in parsed_job), parsed_job.models.len())
}
