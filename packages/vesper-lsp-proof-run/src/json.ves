// The JSON the runner reads and writes: serde_json's `from_slice` into a
// `Value` (de.rs and read.rs of serde_json 1.0, `SliceRead`), with its
// error messages and positions, and its compact string writer.
//
// A parsed document is a node table. Node kinds: NULL, BOOL (`a` is 0 or
// 1), NUMBER (`a` is 1 for a u64 and `b` its value), STRING (`a`, `b`:
// offset and length of the decoded bytes in `pool`), ARRAY (`a`, `b`:
// offset and count of its element ids in `kids`) and OBJECT (`a`, `b`:
// offset and count of its key and value id pairs in `kids`; keys are
// STRING nodes).

use @vesper-std/bytes::ascii::{
    BACKSLASH, BACKSPACE, CARRIAGE_RETURN, CLOSE_BRACE, CLOSE_BRACKET, COLON, COMMA, DIGIT_NINE,
    DIGIT_ONE, DIGIT_ZERO, DOT, FORM_FEED, HYPHEN, LOWER_A, LOWER_B, LOWER_E, LOWER_F, LOWER_N,
    LOWER_R, LOWER_T, LOWER_U, NEWLINE, OPEN_BRACE, OPEN_BRACKET, PLUS, QUOTE, SLASH, SPACE, TAB,
    UPPER_A, UPPER_E, UPPER_F
};
use self::numbers::{number_out_of_range, U64_MAX_TENTH, U64_MAX_LAST_DIGIT};

pub const NULL: u8 = 0;
pub const BOOL: u8 = 1;
pub const NUMBER: u8 = 2;
pub const STRING: u8 = 3;
pub const ARRAY: u8 = 4;
pub const OBJECT: u8 = 5;

pub const NONE: u64 = 18446744073709551615;

// Added to a nibble of 10 to 15 to give `a` to `f` (`'a' - 10`), and to
// give `A` to `F` (`'A' - 10`).
pub const HEX_LETTER_BASE: u8 = 87;
pub const HEX_UPPER_LETTER_BASE: u8 = 55;
// The hex digits of a `\u` escape.
const HEX_ESCAPE_DIGITS: u64 = 4;
// UTF-16 surrogates: the leading (high) and trailing (low) ranges, the bits
// each carries, and the first code point a pair encodes.
const HIGH_SURROGATE_FIRST: u64 = 55296;
const HIGH_SURROGATE_LAST: u64 = 56319;
const LOW_SURROGATE_FIRST: u64 = 56320;
const LOW_SURROGATE_LAST: u64 = 57343;
const SURROGATE_BITS: u32 = 10;
const SUPPLEMENTARY_FIRST: u64 = 65536;
// serde_json's recursion limit (`remaining_depth`).
const MAX_DEPTH: u64 = 128;

// serde_json's error codes, in its `ErrorCode` order.
const E_NONE: u8 = 0;
const EOF_LIST: u8 = 1;
const EOF_OBJECT: u8 = 2;
const EOF_STRING: u8 = 3;
const EOF_VALUE: u8 = 4;
const EXPECTED_COLON: u8 = 5;
const EXPECTED_LIST: u8 = 6;
const EXPECTED_OBJECT: u8 = 7;
const EXPECTED_IDENT: u8 = 8;
const EXPECTED_VALUE: u8 = 9;
const INVALID_ESCAPE: u8 = 10;
const INVALID_NUMBER: u8 = 11;
const OUT_OF_RANGE: u8 = 12;
const CONTROL: u8 = 13;
const KEY_STRING: u8 = 14;
const LONE_SURROGATE: u8 = 15;
const TRAILING_COMMA: u8 = 16;
const TRAILING_CHARS: u8 = 17;
const END_OF_HEX: u8 = 18;
const RECURSION: u8 = 19;

pub struct Doc {
    kind: ChunkSeq[u8],
    a: ChunkSeq[u64],
    b: ChunkSeq[u64],
    kids: ChunkSeq[u64],
    pool: ChunkSeq[u8],
    // The error (E_NONE: none) and the byte index its position is of.
    error_code: u8,
    error_at: u64
}

struct P {
    pos: u64,
    depth: u64
}

fn byte(in bytes: Slice[u8], i: u64) -> u8 {
    match bytes.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

fn g64(in values: ChunkSeq[u64], i: u64) -> u64 {
    match values.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

fn g8(in values: ChunkSeq[u8], i: u64) -> u8 {
    match values.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

fn min64(a: u64, b: u64) -> u64 {
    if a < b { a } else { b }
}

// `error`: at the index after the last byte read.
fn fail(inout doc: Doc, code: u8, at: u64) -> u64 {
    if doc.error_code == E_NONE {
        doc.error_code = code;
        doc.error_at = at;
    }
    NONE
}

// `peek_error`: at the index after the peeked byte.
fn peek_fail(inout doc: Doc, in text: Slice[u8], cursor: P, code: u8) -> u64 {
    fail(inout doc, code, min64(text.len(), wrapping_add(cursor.pos, 1)))
}

fn node(inout doc: Doc, kind: u8, a: u64, b: u64) -> u64 {
    doc.kind.push(kind);
    doc.a.push(a);
    doc.b.push(b);
    wrapping_sub(doc.kind.len(), 1)
}

fn whitespace(in text: Slice[u8], inout cursor: P) -> bool {
    loop {
        if cursor.pos >= text.len() {
            return false;
        }
        let c = byte(in text, cursor.pos);
        if c == SPACE || c == NEWLINE || c == TAB || c == CARRIAGE_RETURN {
            cursor.pos = wrapping_add(cursor.pos, 1);
        } else {
            return true;
        }
    }
}

fn ident(inout doc: Doc, in text: Slice[u8], inout cursor: P, in rest: Str) -> bool {
    let expected = rest.as_bytes();
    for k in 0..expected.len() {
        if cursor.pos >= text.len() {
            let _ = fail(inout doc, EOF_VALUE, cursor.pos);
            return false;
        }
        let c = byte(in text, cursor.pos);
        cursor.pos = wrapping_add(cursor.pos, 1);
        if c != byte(in expected, k) {
            let _ = fail(inout doc, EXPECTED_IDENT, cursor.pos);
            return false;
        }
    }
    true
}

fn is_digit(c: u8) -> bool {
    c >= DIGIT_ZERO && c <= DIGIT_NINE
}

// `parse_any_number` after an optional `-` (already eaten).
fn number(inout doc: Doc, in text: Slice[u8], inout cursor: P, positive: bool, start: u64) -> u64 {
    if cursor.pos >= text.len() {
        return fail(inout doc, EOF_VALUE, cursor.pos);
    }
    let c = byte(in text, cursor.pos);
    cursor.pos = wrapping_add(cursor.pos, 1);
    let mut float = false;
    let mut significand: u64 = 0;
    if c == DIGIT_ZERO {
        if is_digit(byte(in text, cursor.pos)) {
            return peek_fail(inout doc, in text, cursor, INVALID_NUMBER);
        }
    } else if c >= DIGIT_ONE && c <= DIGIT_NINE {
        significand = widen_u64(wrapping_sub(c, DIGIT_ZERO));
        loop {
            let digit_byte = byte(in text, cursor.pos);
            if !is_digit(digit_byte) {
                break;
            }
            let digit = widen_u64(wrapping_sub(digit_byte, DIGIT_ZERO));
            if significand > U64_MAX_TENTH
                || (significand == U64_MAX_TENTH && digit > U64_MAX_LAST_DIGIT) {
                float = true;
            } else {
                significand = wrapping_add(wrapping_mul(significand, 10), digit);
            }
            cursor.pos = wrapping_add(cursor.pos, 1);
        }
    } else {
        return fail(inout doc, INVALID_NUMBER, cursor.pos);
    }
    if byte(in text, cursor.pos) == DOT {
        float = true;
        cursor.pos = wrapping_add(cursor.pos, 1);
        let mut frac_len: u64 = 0;
        loop {
            if !is_digit(byte(in text, cursor.pos)) {
                break;
            }
            cursor.pos = wrapping_add(cursor.pos, 1);
            frac_len = wrapping_add(frac_len, 1);
        }
        if frac_len == 0 {
            if cursor.pos < text.len() {
                return peek_fail(inout doc, in text, cursor, INVALID_NUMBER);
            }
            return peek_fail(inout doc, in text, cursor, EOF_VALUE);
        }
    }
    let exp_marker = byte(in text, cursor.pos);
    if exp_marker == LOWER_E || exp_marker == UPPER_E {
        float = true;
        cursor.pos = wrapping_add(cursor.pos, 1);
        let exp_sign = byte(in text, cursor.pos);
        if exp_sign == PLUS || exp_sign == HYPHEN {
            cursor.pos = wrapping_add(cursor.pos, 1);
        }
        if cursor.pos >= text.len() {
            return fail(inout doc, EOF_VALUE, cursor.pos);
        }
        let digit_byte = byte(in text, cursor.pos);
        cursor.pos = wrapping_add(cursor.pos, 1);
        if !is_digit(digit_byte) {
            return fail(inout doc, INVALID_NUMBER, cursor.pos);
        }
        loop {
            if !is_digit(byte(in text, cursor.pos)) {
                break;
            }
            cursor.pos = wrapping_add(cursor.pos, 1);
        }
    }
    if float && number_out_of_range(in text[start..cursor.pos]) {
        return fail(inout doc, OUT_OF_RANGE, cursor.pos);
    }
    // A negative or fractional number is not a u64.
    let is_u64 = positive && !float;
    node(inout doc, NUMBER, if is_u64 { 1 } else { 0 }, significand)
}

fn hex_digit(c: u8) -> u64 {
    if c >= DIGIT_ZERO && c <= DIGIT_NINE {
        widen_u64(wrapping_sub(c, DIGIT_ZERO))
    } else if c >= LOWER_A && c <= LOWER_F {
        widen_u64(wrapping_sub(c, HEX_LETTER_BASE))
    } else if c >= UPPER_A && c <= UPPER_F {
        widen_u64(wrapping_sub(c, HEX_UPPER_LETTER_BASE))
    } else {
        NONE
    }
}

// `decode_hex_escape` of `SliceRead`: NONE on an error.
fn hex4(inout doc: Doc, in text: Slice[u8], inout cursor: P) -> u64 {
    if wrapping_add(cursor.pos, HEX_ESCAPE_DIGITS) > text.len() {
        cursor.pos = text.len();
        return fail(inout doc, EOF_STRING, cursor.pos);
    }
    let mut value: u64 = 0;
    let mut bad = false;
    for k in 0..HEX_ESCAPE_DIGITS {
        let digit = hex_digit(byte(in text, wrapping_add(cursor.pos, k)));
        if digit == NONE {
            bad = true;
        }
        value = wrapping_add(wrapping_mul(value, 16), digit);
    }
    cursor.pos = wrapping_add(cursor.pos, HEX_ESCAPE_DIGITS);
    if bad {
        return fail(inout doc, INVALID_ESCAPE, cursor.pos);
    }
    value
}

fn push_code(inout out: ChunkSeq[u8], code_point: u64) {
    if code_point < 128 {
        out.push(wrapping_u8(code_point));
    } else if code_point < 2048 {
        out.push(wrapping_u8(wrapping_add(192, code_point >> 6)));
        out.push(wrapping_u8(wrapping_add(128, code_point & 63)));
    } else if code_point < 65536 {
        out.push(wrapping_u8(wrapping_add(224, code_point >> 12)));
        out.push(wrapping_u8(wrapping_add(128, (code_point >> 6) & 63)));
        out.push(wrapping_u8(wrapping_add(128, code_point & 63)));
    } else {
        out.push(wrapping_u8(wrapping_add(240, code_point >> 18)));
        out.push(wrapping_u8(wrapping_add(128, (code_point >> 12) & 63)));
        out.push(wrapping_u8(wrapping_add(128, (code_point >> 6) & 63)));
        out.push(wrapping_u8(wrapping_add(128, code_point & 63)));
    }
}

// `parse_str` (validating) after the opening quote: a STRING node.
fn string(inout doc: Doc, in text: Slice[u8], inout cursor: P) -> u64 {
    let start = doc.pool.len();
    loop {
        if cursor.pos >= text.len() {
            return fail(inout doc, EOF_STRING, cursor.pos);
        }
        let c = byte(in text, cursor.pos);
        cursor.pos = wrapping_add(cursor.pos, 1);
        if c == QUOTE {
            break;
        }
        if c < SPACE {
            return fail(inout doc, CONTROL, cursor.pos);
        }
        if c != BACKSLASH {
            doc.pool.push(c);
            continue;
        }
        if cursor.pos >= text.len() {
            return fail(inout doc, EOF_STRING, cursor.pos);
        }
        let escape = byte(in text, cursor.pos);
        cursor.pos = wrapping_add(cursor.pos, 1);
        if escape == QUOTE || escape == BACKSLASH || escape == SLASH {
            doc.pool.push(escape);
        } else if escape == LOWER_B {
            doc.pool.push(BACKSPACE);
        } else if escape == LOWER_F {
            doc.pool.push(FORM_FEED);
        } else if escape == LOWER_N {
            doc.pool.push(NEWLINE);
        } else if escape == LOWER_R {
            doc.pool.push(CARRIAGE_RETURN);
        } else if escape == LOWER_T {
            doc.pool.push(TAB);
        } else if escape == LOWER_U {
            let code_unit = hex4(inout doc, in text, inout cursor);
            if code_unit == NONE {
                return NONE;
            }
            if code_unit >= LOW_SURROGATE_FIRST && code_unit <= LOW_SURROGATE_LAST {
                return fail(inout doc, LONE_SURROGATE, cursor.pos);
            }
            if code_unit < HIGH_SURROGATE_FIRST || code_unit > HIGH_SURROGATE_LAST {
                push_code(inout doc.pool, code_unit);
                continue;
            }
            // A leading surrogate: a trailing one must follow.
            if cursor.pos >= text.len() {
                return fail(inout doc, EOF_STRING, cursor.pos);
            }
            if byte(in text, cursor.pos) != BACKSLASH {
                cursor.pos = wrapping_add(cursor.pos, 1);
                return fail(inout doc, END_OF_HEX, cursor.pos);
            }
            cursor.pos = wrapping_add(cursor.pos, 1);
            if cursor.pos >= text.len() {
                return fail(inout doc, EOF_STRING, cursor.pos);
            }
            if byte(in text, cursor.pos) != LOWER_U {
                cursor.pos = wrapping_add(cursor.pos, 1);
                return fail(inout doc, END_OF_HEX, cursor.pos);
            }
            cursor.pos = wrapping_add(cursor.pos, 1);
            let low_unit = hex4(inout doc, in text, inout cursor);
            if low_unit == NONE {
                return NONE;
            }
            if low_unit < LOW_SURROGATE_FIRST || low_unit > LOW_SURROGATE_LAST {
                return fail(inout doc, LONE_SURROGATE, cursor.pos);
            }
            let code_point = wrapping_add(
                wrapping_shl_u64(wrapping_sub(code_unit, HIGH_SURROGATE_FIRST), SURROGATE_BITS)
                    | wrapping_sub(low_unit, LOW_SURROGATE_FIRST),
                SUPPLEMENTARY_FIRST
            );
            push_code(inout doc.pool, code_point);
        } else {
            return fail(inout doc, INVALID_ESCAPE, cursor.pos);
        }
    }
    node(inout doc, STRING, start, wrapping_sub(doc.pool.len(), start))
}

// `deserialize_any` into a `Value`.
fn value(inout doc: Doc, in text: Slice[u8], inout cursor: P) -> u64 {
    if !whitespace(in text, inout cursor) {
        return peek_fail(inout doc, in text, cursor, EOF_VALUE);
    }
    let c = byte(in text, cursor.pos);
    if c == LOWER_N {
        cursor.pos = wrapping_add(cursor.pos, 1);
        if !ident(inout doc, in text, inout cursor, in "ull") {
            return NONE;
        }
        return node(inout doc, NULL, 0, 0);
    }
    if c == LOWER_T {
        cursor.pos = wrapping_add(cursor.pos, 1);
        if !ident(inout doc, in text, inout cursor, in "rue") {
            return NONE;
        }
        return node(inout doc, BOOL, 1, 0);
    }
    if c == LOWER_F {
        cursor.pos = wrapping_add(cursor.pos, 1);
        if !ident(inout doc, in text, inout cursor, in "alse") {
            return NONE;
        }
        return node(inout doc, BOOL, 0, 0);
    }
    if c == HYPHEN {
        let start = cursor.pos;
        cursor.pos = wrapping_add(cursor.pos, 1);
        return number(inout doc, in text, inout cursor, false, start);
    }
    if is_digit(c) {
        return number(inout doc, in text, inout cursor, true, cursor.pos);
    }
    if c == QUOTE {
        cursor.pos = wrapping_add(cursor.pos, 1);
        return string(inout doc, in text, inout cursor);
    }
    if c == OPEN_BRACKET || c == OPEN_BRACE {
        if wrapping_add(cursor.depth, 1) >= MAX_DEPTH {
            return peek_fail(inout doc, in text, cursor, RECURSION);
        }
        cursor.depth = wrapping_add(cursor.depth, 1);
        cursor.pos = wrapping_add(cursor.pos, 1);
        let container = if c == OPEN_BRACKET {
            array(inout doc, in text, inout cursor)
        } else {
            object(inout doc, in text, inout cursor)
        };
        cursor.depth = wrapping_sub(cursor.depth, 1);
        return container;
    }
    peek_fail(inout doc, in text, cursor, EXPECTED_VALUE)
}

// The elements of an array after its `[` (`SeqAccess`, then `end_seq`).
fn array(inout doc: Doc, in text: Slice[u8], inout cursor: P) -> u64 {
    let mut items = ChunkSeq::new[u64]();
    let mut first = true;
    loop {
        if !whitespace(in text, inout cursor) {
            return peek_fail(inout doc, in text, cursor, EOF_LIST);
        }
        let c = byte(in text, cursor.pos);
        if c == CLOSE_BRACKET {
            break;
        }
        if first {
            first = false;
        } else if c == COMMA {
            cursor.pos = wrapping_add(cursor.pos, 1);
            if !whitespace(in text, inout cursor) {
                return peek_fail(inout doc, in text, cursor, EOF_VALUE);
            }
            if byte(in text, cursor.pos) == CLOSE_BRACKET {
                return peek_fail(inout doc, in text, cursor, TRAILING_COMMA);
            }
        } else {
            return peek_fail(inout doc, in text, cursor, EXPECTED_LIST);
        }
        let element = value(inout doc, in text, inout cursor);
        if element == NONE {
            return NONE;
        }
        items.push(element);
    }
    cursor.pos = wrapping_add(cursor.pos, 1);
    let at = doc.kids.len();
    for k in 0..items.len() {
        doc.kids.push(g64(in items, k));
    }
    node(inout doc, ARRAY, at, items.len())
}

// The entries of an object after its `{` (`MapAccess`, then `end_map`).
fn object(inout doc: Doc, in text: Slice[u8], inout cursor: P) -> u64 {
    let mut items = ChunkSeq::new[u64]();
    let mut first = true;
    loop {
        if !whitespace(in text, inout cursor) {
            return peek_fail(inout doc, in text, cursor, EOF_OBJECT);
        }
        let c = byte(in text, cursor.pos);
        if c == CLOSE_BRACE {
            break;
        }
        if first {
            first = false;
            if c != QUOTE {
                return peek_fail(inout doc, in text, cursor, KEY_STRING);
            }
        } else if c == COMMA {
            cursor.pos = wrapping_add(cursor.pos, 1);
            if !whitespace(in text, inout cursor) {
                return peek_fail(inout doc, in text, cursor, EOF_VALUE);
            }
            let next_byte = byte(in text, cursor.pos);
            if next_byte == CLOSE_BRACE {
                return peek_fail(inout doc, in text, cursor, TRAILING_COMMA);
            }
            if next_byte != QUOTE {
                return peek_fail(inout doc, in text, cursor, KEY_STRING);
            }
        } else {
            return peek_fail(inout doc, in text, cursor, EXPECTED_OBJECT);
        }
        cursor.pos = wrapping_add(cursor.pos, 1);
        let key = string(inout doc, in text, inout cursor);
        if key == NONE {
            return NONE;
        }
        if !whitespace(in text, inout cursor) {
            return peek_fail(inout doc, in text, cursor, EOF_OBJECT);
        }
        if byte(in text, cursor.pos) != COLON {
            return peek_fail(inout doc, in text, cursor, EXPECTED_COLON);
        }
        cursor.pos = wrapping_add(cursor.pos, 1);
        let value_id = value(inout doc, in text, inout cursor);
        if value_id == NONE {
            return NONE;
        }
        items.push(key);
        items.push(value_id);
    }
    cursor.pos = wrapping_add(cursor.pos, 1);
    let at = doc.kids.len();
    for k in 0..items.len() {
        doc.kids.push(g64(in items, k));
    }
    node(inout doc, OBJECT, at, items.len() / 2)
}

// `serde_json::from_slice::<Value>`: the document; its root is the last
// node, or `error_code` is set.
pub fn parse(in text: Slice[u8]) -> Doc {
    let mut doc = Doc {
        kind: ChunkSeq::new[u8](),
        a: ChunkSeq::new[u64](),
        b: ChunkSeq::new[u64](),
        kids: ChunkSeq::new[u64](),
        pool: ChunkSeq::new[u8](),
        error_code: E_NONE,
        error_at: 0
    };
    let mut cursor = P { pos: 0, depth: 0 };
    let root = value(inout doc, in text, inout cursor);
    if root != NONE && whitespace(in text, inout cursor) {
        let _ = peek_fail(inout doc, in text, cursor, TRAILING_CHARS);
    }
    doc
}

pub fn failed(in doc: Doc) -> bool {
    doc.error_code != E_NONE
}

pub fn root(in doc: Doc) -> u64 {
    wrapping_sub(doc.kind.len(), 1)
}

pub fn kind(in doc: Doc, node_id: u64) -> u8 {
    if node_id == NONE {
        return NULL;
    }
    g8(in doc.kind, node_id)
}

// `value[key]`: the last entry named `key` of an object, or NONE.
pub fn field(in doc: Doc, node_id: u64, in key: Str) -> u64 {
    if kind(in doc, node_id) != OBJECT {
        return NONE;
    }
    let key_bytes = key.as_bytes();
    let at = g64(in doc.a, node_id);
    let mut found = NONE;
    for entry in 0..g64(in doc.b, node_id) {
        let key_id = g64(in doc.kids, wrapping_add(at, wrapping_mul(entry, 2)));
        if str_is(in doc, key_id, in key_bytes) {
            found = g64(in doc.kids, wrapping_add(at, inc(wrapping_mul(entry, 2))));
        }
    }
    found
}

fn inc(x: u64) -> u64 {
    wrapping_add(x, 1)
}

// Whether `node_id` is a string equal to `expected`.
pub fn str_is(in doc: Doc, node_id: u64, in expected: Slice[u8]) -> bool {
    if kind(in doc, node_id) != STRING {
        return false;
    }
    let at = g64(in doc.a, node_id);
    let len = g64(in doc.b, node_id);
    if len != expected.len() {
        return false;
    }
    for i in 0..len {
        if g8(in doc.pool, wrapping_add(at, i)) != byte(in expected, i) {
            return false;
        }
    }
    true
}

pub fn put_str_of(inout out: ChunkSeq[u8], in doc: Doc, node_id: u64) {
    let at = g64(in doc.a, node_id);
    for i in 0..g64(in doc.b, node_id) {
        out.push(g8(in doc.pool, wrapping_add(at, i)));
    }
}

pub fn is_true(in doc: Doc, node_id: u64) -> bool {
    kind(in doc, node_id) == BOOL && g64(in doc.a, node_id) == 1
}

// `as_u64`, or 0.
pub fn u64_or_zero(in doc: Doc, node_id: u64) -> u64 {
    if kind(in doc, node_id) == NUMBER && g64(in doc.a, node_id) == 1 {
        g64(in doc.b, node_id)
    } else {
        0
    }
}

// The items of an array (`as_array`): count, and the id of item `i`.
pub fn items(in doc: Doc, node_id: u64) -> u64 {
    if kind(in doc, node_id) != ARRAY {
        return 0;
    }
    g64(in doc.b, node_id)
}

pub fn item(in doc: Doc, node_id: u64, i: u64) -> u64 {
    g64(in doc.kids, wrapping_add(g64(in doc.a, node_id), i))
}

pub fn put(inout out: ChunkSeq[u8], in text: Str) {
    let bytes = text.as_bytes();
    for i in 0..bytes.len() {
        out.push(byte(in bytes, i));
    }
}

pub fn put_u64(inout out: ChunkSeq[u8], n: u64) {
    if n >= 10 {
        put_u64(inout out, n / 10);
    }
    out.push(wrapping_u8(wrapping_add(widen_u64(DIGIT_ZERO), n % 10)));
}

// The error as serde_json's `Display` writes it: the message, then
// ` at line L column C`.
pub fn put_error(inout out: ChunkSeq[u8], in doc: Doc, in text: Slice[u8]) {
    let code = doc.error_code;
    if code == EOF_LIST {
        put(inout out, in "EOF while parsing a list");
    } else if code == EOF_OBJECT {
        put(inout out, in "EOF while parsing an object");
    } else if code == EOF_STRING {
        put(inout out, in "EOF while parsing a string");
    } else if code == EOF_VALUE {
        put(inout out, in "EOF while parsing a value");
    } else if code == EXPECTED_COLON {
        put(inout out, in "expected `:`");
    } else if code == EXPECTED_LIST {
        put(inout out, in "expected `,` or `]`");
    } else if code == EXPECTED_OBJECT {
        put(inout out, in "expected `,` or `}`");
    } else if code == EXPECTED_IDENT {
        put(inout out, in "expected ident");
    } else if code == EXPECTED_VALUE {
        put(inout out, in "expected value");
    } else if code == INVALID_ESCAPE {
        put(inout out, in "invalid escape");
    } else if code == INVALID_NUMBER {
        put(inout out, in "invalid number");
    } else if code == OUT_OF_RANGE {
        put(inout out, in "number out of range");
    } else if code == CONTROL {
        put(inout out, in "control character (\\u0000-\\u001F) found while parsing a string");
    } else if code == KEY_STRING {
        put(inout out, in "key must be a string");
    } else if code == LONE_SURROGATE {
        put(inout out, in "lone leading surrogate in hex escape");
    } else if code == TRAILING_COMMA {
        put(inout out, in "trailing comma");
    } else if code == TRAILING_CHARS {
        put(inout out, in "trailing characters");
    } else if code == END_OF_HEX {
        put(inout out, in "unexpected end of hex escape");
    } else {
        put(inout out, in "recursion limit exceeded");
    }
    // `position_of_index`.
    let error_at = doc.error_at;
    let mut line: u64 = 1;
    let mut line_start: u64 = 0;
    for k in 0..error_at {
        if byte(in text, k) == NEWLINE {
            line = inc(line);
            line_start = inc(k);
        }
    }
    put(inout out, in " at line ");
    put_u64(inout out, line);
    put(inout out, in " column ");
    put_u64(inout out, wrapping_sub(error_at, line_start));
}

fn hex(c: u8) -> u8 {
    if c < 10 {
        wrapping_add(DIGIT_ZERO, c)
    } else {
        wrapping_add(HEX_LETTER_BASE, c)
    }
}

// A JSON string with serde_json's escapes.
pub fn put_string(inout out: ChunkSeq[u8], in bytes: Slice[u8]) {
    out.push(QUOTE);
    for i in 0..bytes.len() {
        let c = byte(in bytes, i);
        if c == QUOTE || c == BACKSLASH {
            out.push(BACKSLASH);
            out.push(c);
        } else if c < SPACE {
            out.push(BACKSLASH);
            if c == BACKSPACE {
                out.push(LOWER_B);
            } else if c == FORM_FEED {
                out.push(LOWER_F);
            } else if c == NEWLINE {
                out.push(LOWER_N);
            } else if c == CARRIAGE_RETURN {
                out.push(LOWER_R);
            } else if c == TAB {
                out.push(LOWER_T);
            } else {
                put(inout out, in "u00");
                out.push(hex(c >> 4));
                out.push(hex(c & 15));
            }
        } else {
            out.push(c);
        }
    }
    out.push(QUOTE);
}
