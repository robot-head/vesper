// Text helpers with std's behaviour: `String::from_utf8_lossy`,
// `str::trim`, `str::lines`, `first_error` and `bounded` of
// src/lsp/proof_lens.rs, and the `Display` of `io::Error` and
// `ExitStatus` on Unix.

use @vesper-std/fs::{IoError, program_not_found};
use @vesper-std/process::ExitStatus;
use @vesper-std/bytes::ascii::{
    BACKSLASH, CARRIAGE_RETURN, CLOSE_PAREN, DIGIT_ZERO, HYPHEN, NEWLINE, TAB
};
use self::json::{put, put_u64, NONE, HEX_LETTER_BASE};

// U+FFFD REPLACEMENT CHARACTER in UTF-8.
const REPLACEMENT_FIRST: u8 = 239;
const REPLACEMENT_SECOND: u8 = 191;
const REPLACEMENT_THIRD: u8 = 189;
// A UTF-8 continuation byte is `0b10xx_xxxx`: these top two bits, `0b10`.
const UTF8_CONTINUATION_MASK: u8 = 192;
const UTF8_CONTINUATION: u8 = 128;
// `first_error` keeps at most this many scalars of its line.
const MAX_ERROR_CHARS: u64 = 400;
// `bounded` keeps at most this many bytes.
const MAX_BOUNDED_BYTES: u64 = 2048;

pub fn byte(in bytes: Slice[u8], i: u64) -> u8 {
    match bytes.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

fn inc(x: u64) -> u64 {
    wrapping_add(x, 1)
}

pub fn put_bytes(inout out: ChunkSeq[u8], in bytes: Slice[u8]) {
    for i in 0..bytes.len() {
        out.push(byte(in bytes, i));
    }
}

fn in_range(in bytes: Slice[u8], i: u64, lo: u8, hi: u8) -> bool {
    i < bytes.len() && byte(in bytes, i) >= lo && byte(in bytes, i) <= hi
}

// `String::from_utf8_lossy`: each maximal invalid subpart becomes U+FFFD.
pub fn lossy(in bytes: Slice[u8]) -> ChunkSeq[u8] {
    let mut out = ChunkSeq::with_capacity[u8](bytes.len());
    let mut i: u64 = 0;
    loop {
        if i >= bytes.len() {
            break;
        }
        let c = byte(in bytes, i);
        if c < 128 {
            out.push(c);
            i = inc(i);
            continue;
        }
        // The sequence length and the range of the second byte.
        let mut seq_len: u64 = 0;
        let mut lo: u8 = 128;
        let mut hi: u8 = 191;
        if c >= 194 && c <= 223 {
            seq_len = 2;
        } else if c == 224 {
            seq_len = 3;
            lo = 160;
        } else if (c >= 225 && c <= 236) || c == 238 || c == 239 {
            seq_len = 3;
        } else if c == 237 {
            seq_len = 3;
            hi = 159;
        } else if c == 240 {
            seq_len = 4;
            lo = 144;
        } else if c >= 241 && c <= 243 {
            seq_len = 4;
        } else if c == 244 {
            seq_len = 4;
            hi = 143;
        }
        if seq_len == 0 {
            put_replacement(inout out);
            i = inc(i);
            continue;
        }
        let mut valid_len: u64 = 1;
        if in_range(in bytes, inc(i), lo, hi) {
            valid_len = 2;
            loop {
                if valid_len >= seq_len
                    || !in_range(in bytes, wrapping_add(i, valid_len), 128, 191)
                {
                    break;
                }
                valid_len = inc(valid_len);
            }
        }
        if valid_len == seq_len {
            for k in 0..seq_len {
                out.push(byte(in bytes, wrapping_add(i, k)));
            }
        } else {
            put_replacement(inout out);
        }
        i = wrapping_add(i, valid_len);
    }
    out
}

fn put_replacement(inout out: ChunkSeq[u8]) {
    out.push(REPLACEMENT_FIRST);
    out.push(REPLACEMENT_SECOND);
    out.push(REPLACEMENT_THIRD);
}

// The scalar value starting at `i` of valid UTF-8 and its length.
fn decode(in bytes: Slice[u8], i: u64, inout len: u64) -> u64 {
    let lead = widen_u64(byte(in bytes, i));
    if lead < 128 {
        len = 1;
        return lead;
    }
    let x1 = widen_u64(byte(in bytes, inc(i))) & 63;
    if lead < 224 {
        len = 2;
        return wrapping_shl_u64(lead & 31, 6) | x1;
    }
    let x2 = widen_u64(byte(in bytes, wrapping_add(i, 2))) & 63;
    if lead < 240 {
        len = 3;
        return wrapping_shl_u64(lead & 15, 12) | wrapping_shl_u64(x1, 6) | x2;
    }
    let x3 = widen_u64(byte(in bytes, wrapping_add(i, 3))) & 63;
    len = 4;
    wrapping_shl_u64(lead & 7, 18) | wrapping_shl_u64(x1, 12) | wrapping_shl_u64(x2, 6) | x3
}

// `char::is_whitespace` (Unicode `White_Space`).
fn white(c: u64) -> bool {
    (c >= 9 && c <= 13)
        || c == 32
        || c == 133
        || c == 160
        || c == 5760
        || (c >= 8192 && c <= 8202)
        || c == 8232
        || c == 8233
        || c == 8239
        || c == 8287
        || c == 12288
}

// `str::trim` of valid UTF-8 `bytes`: the start and end of the trimmed text.
// Narrow `bytes[start..end]` to its `str::trim`.
pub fn trim(in bytes: Slice[u8], inout start: u64, inout end: u64) {
    let limit = end;
    loop {
        if start >= limit {
            break;
        }
        let mut len: u64 = 0;
        let scalar = decode(in bytes, start, inout len);
        if !white(scalar) {
            break;
        }
        start = wrapping_add(start, len);
    }
    loop {
        if end <= start {
            break;
        }
        // The start of the last scalar before `end`.
        let mut last_start = wrapping_sub(end, 1);
        loop {
            if last_start <= start
                || (byte(in bytes, last_start) & UTF8_CONTINUATION_MASK) != UTF8_CONTINUATION
            {
                break;
            }
            last_start = wrapping_sub(last_start, 1);
        }
        let mut len: u64 = 0;
        let scalar = decode(in bytes, last_start, inout len);
        if !white(scalar) {
            break;
        }
        end = last_start;
    }
}

pub fn trimmed(in bytes: Slice[u8]) -> ChunkSeq[u8] {
    let mut start: u64 = 0;
    let mut end = bytes.len();
    trim(in bytes, inout start, inout end);
    let mut out = ChunkSeq::new[u8]();
    for i in start..end {
        out.push(byte(in bytes, i));
    }
    out
}

pub fn contains(in hay: Slice[u8], start: u64, end: u64, in needle: Slice[u8]) -> bool {
    find(in hay, start, end, in needle) != NONE
}

// The first index of `needle` in `hay[start..end]`, or `u64::MAX`.
pub fn find(in hay: Slice[u8], start: u64, end: u64, in needle: Slice[u8]) -> u64 {
    if needle.len() == 0 {
        return start;
    }
    if end < start || wrapping_sub(end, start) < needle.len() {
        return NONE;
    }
    let last = wrapping_sub(end, needle.len());
    let mut i = start;
    loop {
        if i > last {
            return NONE;
        }
        let mut k: u64 = 0;
        loop {
            if k >= needle.len() || byte(in hay, wrapping_add(i, k)) != byte(in needle, k) {
                break;
            }
            k = inc(k);
        }
        if k == needle.len() {
            return i;
        }
        i = inc(i);
    }
}

// `first_error`: the first line holding "error", else the first non-blank
// line, else nothing; at most 400 scalars of it. `bytes` is valid UTF-8.
pub fn first_error(in bytes: Slice[u8]) -> ChunkSeq[u8] {
    let mut pick_start: u64 = 0;
    let mut pick_end: u64 = 0;
    let mut found = false;
    let mut nonblank_start: u64 = 0;
    let mut nonblank_end: u64 = 0;
    let mut have_nonblank = false;
    let mut line_start: u64 = 0;
    loop {
        if line_start >= bytes.len() {
            break;
        }
        // One `lines()` line: up to the next `\n`, without a final `\r`.
        let mut line_end = line_start;
        loop {
            if line_end >= bytes.len() || byte(in bytes, line_end) == NEWLINE {
                break;
            }
            line_end = inc(line_end);
        }
        let next_line = inc(line_end);
        let mut content_end = line_end;
        if content_end > line_start
            && byte(in bytes, wrapping_sub(content_end, 1)) == CARRIAGE_RETURN
        {
            content_end = wrapping_sub(content_end, 1);
        }
        if contains(in bytes, line_start, content_end, in "error".as_bytes()) {
            pick_start = line_start;
            pick_end = content_end;
            found = true;
            break;
        }
        if !have_nonblank {
            let mut trim_start = line_start;
            let mut trim_end = content_end;
            trim(in bytes, inout trim_start, inout trim_end);
            if trim_end > trim_start {
                nonblank_start = line_start;
                nonblank_end = content_end;
                have_nonblank = true;
            }
        }
        line_start = next_line;
    }
    if !found && have_nonblank {
        pick_start = nonblank_start;
        pick_end = nonblank_end;
    }
    let mut out = ChunkSeq::new[u8]();
    let mut scalar_count: u64 = 0;
    for k in pick_start..pick_end {
        let c = byte(in bytes, k);
        if (c & UTF8_CONTINUATION_MASK) != UTF8_CONTINUATION {
            if scalar_count >= MAX_ERROR_CHARS {
                break;
            }
            scalar_count = inc(scalar_count);
        }
        out.push(c);
    }
    out
}

// `bounded`: at most 2048 bytes, cut at a char boundary.
pub fn bounded(in bytes: Slice[u8]) -> ChunkSeq[u8] {
    let mut end = bytes.len();
    if end > MAX_BOUNDED_BYTES {
        end = MAX_BOUNDED_BYTES;
        loop {
            if end == 0 || (byte(in bytes, end) & UTF8_CONTINUATION_MASK) != UTF8_CONTINUATION {
                break;
            }
            end = wrapping_sub(end, 1);
        }
    }
    let mut out = ChunkSeq::new[u8]();
    for k in 0..end {
        out.push(byte(in bytes, k));
    }
    out
}

// `escaped` of the outcome rows: `\\`, tab, CR and LF escaped.
pub fn put_escaped(inout out: ChunkSeq[u8], in bytes: Slice[u8]) {
    for i in 0..bytes.len() {
        let c = byte(in bytes, i);
        if c == BACKSLASH {
            put(inout out, in "\\\\");
        } else if c == TAB {
            put(inout out, in "\\t");
        } else if c == CARRIAGE_RETURN {
            put(inout out, in "\\r");
        } else if c == NEWLINE {
            put(inout out, in "\\n");
        } else {
            out.push(c);
        }
    }
}

pub fn put_hex(inout out: ChunkSeq[u8], in bytes: Slice[u8]) {
    for i in 0..bytes.len() {
        let c = byte(in bytes, i);
        out.push(hex_digit(c >> 4));
        out.push(hex_digit(c & 15));
    }
}

fn hex_digit(c: u8) -> u8 {
    if c < 10 {
        wrapping_add(DIGIT_ZERO, c)
    } else {
        wrapping_add(HEX_LETTER_BASE, c)
    }
}

// `strerror` for the codes a run can meet (Linux numbering).
fn put_strerror(inout out: ChunkSeq[u8], errno: u32) -> bool {
    if errno == 1 {
        put(inout out, in "Operation not permitted");
    } else if errno == 2 {
        put(inout out, in "No such file or directory");
    } else if errno == 5 {
        put(inout out, in "Input/output error");
    } else if errno == 7 {
        put(inout out, in "Argument list too long");
    } else if errno == 8 {
        put(inout out, in "Exec format error");
    } else if errno == 12 {
        put(inout out, in "Cannot allocate memory");
    } else if errno == 13 {
        put(inout out, in "Permission denied");
    } else if errno == 17 {
        put(inout out, in "File exists");
    } else if errno == 20 {
        put(inout out, in "Not a directory");
    } else if errno == 21 {
        put(inout out, in "Is a directory");
    } else if errno == 26 {
        put(inout out, in "Text file busy");
    } else if errno == 28 {
        put(inout out, in "No space left on device");
    } else if errno == 30 {
        put(inout out, in "Read-only file system");
    } else if errno == 36 {
        put(inout out, in "File name too long");
    } else if errno == 39 {
        put(inout out, in "Directory not empty");
    } else {
        return false;
    }
    true
}

// `io::Error`'s `Display`: the OS message and `(os error N)`, or the kind.
pub fn put_io_error(inout out: ChunkSeq[u8], error: IoError) {
    if error.os != 0 {
        if !put_strerror(inout out, error.os) {
            put(inout out, in "Unknown error ");
            put_u64(inout out, widen_u64(error.os));
        }
        put(inout out, in " (os error ");
        put_u64(inout out, widen_u64(error.os));
        out.push(CLOSE_PAREN);
        return;
    }
    let kind = error.kind;
    if kind == 1 {
        put(inout out, in "entity not found");
    } else if kind == 2 {
        put(inout out, in "permission denied");
    } else if kind == 3 {
        put(inout out, in "entity already exists");
    } else if kind == 4 {
        put(inout out, in "not a directory");
    } else if kind == 5 {
        put(inout out, in "is a directory");
    } else if kind == 6 {
        put(inout out, in "directory not empty");
    } else if kind == 7 {
        put(inout out, in "invalid input parameter");
    } else if kind == 8 {
        put(inout out, in "operation interrupted");
    } else if kind == 9 {
        put(inout out, in "unexpected end of file");
    } else if kind == 10 {
        put(inout out, in "write zero");
    } else if kind == 11 {
        put(inout out, in "unsupported");
    } else if kind == 12 {
        put(inout out, in "out of memory");
    } else if kind == program_not_found() {
        put(inout out, in "program not found");
    } else {
        put(inout out, in "other error");
    }
}

fn signal_name(inout out: ChunkSeq[u8], signal: u32) -> bool {
    if signal == 1 {
        put(inout out, in "SIGHUP");
    } else if signal == 2 {
        put(inout out, in "SIGINT");
    } else if signal == 3 {
        put(inout out, in "SIGQUIT");
    } else if signal == 4 {
        put(inout out, in "SIGILL");
    } else if signal == 5 {
        put(inout out, in "SIGTRAP");
    } else if signal == 6 {
        put(inout out, in "SIGABRT");
    } else if signal == 7 {
        put(inout out, in "SIGBUS");
    } else if signal == 8 {
        put(inout out, in "SIGFPE");
    } else if signal == 9 {
        put(inout out, in "SIGKILL");
    } else if signal == 10 {
        put(inout out, in "SIGUSR1");
    } else if signal == 11 {
        put(inout out, in "SIGSEGV");
    } else if signal == 12 {
        put(inout out, in "SIGUSR2");
    } else if signal == 13 {
        put(inout out, in "SIGPIPE");
    } else if signal == 14 {
        put(inout out, in "SIGALRM");
    } else if signal == 15 {
        put(inout out, in "SIGTERM");
    } else if signal == 16 {
        put(inout out, in "SIGSTKFLT");
    } else if signal == 17 {
        put(inout out, in "SIGCHLD");
    } else if signal == 18 {
        put(inout out, in "SIGCONT");
    } else if signal == 19 {
        put(inout out, in "SIGSTOP");
    } else if signal == 20 {
        put(inout out, in "SIGTSTP");
    } else if signal == 21 {
        put(inout out, in "SIGTTIN");
    } else if signal == 22 {
        put(inout out, in "SIGTTOU");
    } else if signal == 23 {
        put(inout out, in "SIGURG");
    } else if signal == 24 {
        put(inout out, in "SIGXCPU");
    } else if signal == 25 {
        put(inout out, in "SIGXFSZ");
    } else if signal == 26 {
        put(inout out, in "SIGVTALRM");
    } else if signal == 27 {
        put(inout out, in "SIGPROF");
    } else if signal == 28 {
        put(inout out, in "SIGWINCH");
    } else if signal == 29 {
        put(inout out, in "SIGIO");
    } else if signal == 30 {
        put(inout out, in "SIGPWR");
    } else if signal == 31 {
        put(inout out, in "SIGSYS");
    } else {
        return false;
    }
    true
}

// `ExitStatus`'s `Display` on Unix.
pub fn put_status(inout out: ChunkSeq[u8], status: ExitStatus) {
    if status.exited {
        put(inout out, in "exit status: ");
        if status.code < 0 {
            out.push(HYPHEN);
            put_u64(inout out, wrapping_u64(wrapping_sub(0, status.code)));
        } else {
            put_u64(inout out, wrapping_u64(status.code));
        }
        return;
    }
    put(inout out, in "signal: ");
    put_u64(inout out, widen_u64(status.signal));
    let mut name = ChunkSeq::new[u8]();
    if signal_name(inout name, status.signal) {
        put(inout out, in " (");
        put_bytes(inout out, in name.as_slice());
        out.push(CLOSE_PAREN);
    }
}
