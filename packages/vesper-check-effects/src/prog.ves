// The program the capability rules walk: the world's functions with their
// bodies, its effect declarations and its call instantiations, decoded from
// the task words of tests/self_host_check_effects.rs (`encode_task`).
//
// Bodies are an index graph, laid out like @vesper/ast's: an expression
// names its children by index into `exprs`, a list of children is a run of
// words in `pool`. Names are symbols of the context's `Names` and types are
// ids of its `Types`. NONE32 is an absent child.
//
// Expression kinds and fields (`a`..`e`):
//   1 Literal  a = literal kind
//   2 Name     a = name
//   3 Tuple    a, b = list of Expr
//   4 Struct   a = name, b, c = list of (name, Expr)
//   5 Block    a, b = list of Stmt (kind 1 let / 2 expr, pat, type, value),
//              c = tail or NONE
//   6 Call     a = callee, b, c = list of (pass, Expr)
//   7 Field    a = base, b = name
//   8 Index    a, b
//   9 Try      a
//  10 Unary    a = operator, b
//  11 Binary   a = operator, b, c
//  12 Assign   a = operator, b = place, c = value
//  13 If       a = condition, b = then, c = otherwise or NONE
//  14 Match    a = value, b, c = list of (Pattern, Expr)
//  15 Closure  a, b = list of Param (name, pass, type), c = result type,
//              d = effect row type, e = body
//  16 Handle   a = effect name, b = state Pattern or NONE, c = state Expr or
//              NONE, d = body, e = pool index of the clause count, then the
//              clauses (name, pats first, pats len, body): return first
//  17 Loop     a = body
//  18 For      a = Pattern, b = iter, c = body
//  19 Range    a = start, b = end
//  20 Break    a = value or NONE
//  21 Return   a = value or NONE
//  22 Continue
//
// Pattern kinds: 1 Wild, 2 Bind (a = name), 3 Literal, 4 Tuple (a, b = list
// of Pattern), 5 Constructor (a = name, b, c = list of (name, Pattern)).

use @vesper/check-data::util::{add, inc, inc32, n32, u32_at, w};
use @vesper/check-data::input::{Ctx, Reader};
use @vesper/check-data::world::{set_by_symbol};
use self::kinds::{
    ClauseWord, EXPR_ASSIGN, EXPR_BINARY, EXPR_BLOCK, EXPR_CLOSURE, EXPR_FIELD, EXPR_HANDLE,
    EXPR_NAME, EXPR_STRUCT, EXPR_UNARY, PAIR_WORDS, PAT_BIND, PAT_CONSTRUCTOR, ParamWord, StmtWord
};

pub const NONE32: u32 = 4294967295;

pub copy struct ExprNode {
    kind: u8,
    start: u64,
    end: u64,
    a: u32,
    b: u32,
    c: u32,
    d: u32,
    e: u32,
}

pub copy struct PatNode {
    kind: u8,
    start: u64,
    end: u64,
    a: u32,
    b: u32,
    c: u32,
}

// A function (`world.functions`, in key order) or an effect operation.
// `row` is the declared effect row (a `Type::Row` id), `carried` the row
// `float_math::carried_effects` gives it.
pub copy struct Fun {
    key: u32,
    name: u32,
    start: u64,
    end: u64,
    result: u32,
    row: u32,
    carried: u32,
    body: u32,
    param_start: u32,
    param_count: u32,
}

pub copy struct ParamRow {
    name: u32,
    pass: u8,
    ty: u32,
}

// An effect declaration: generics are `gens[gen_start..gen_start+gen_count]`
// (names), operations `ops[op_start..op_start+op_count]`.
pub copy struct EffDecl {
    name: u32,
    linear: bool,
    start: u64,
    end: u64,
    gen_start: u32,
    gen_count: u32,
    op_start: u32,
    op_count: u32,
}

// `world.calls`: the generic instantiation of a call span, as pairs
// (name, type) in `call_vars[var_start..var_start+2*var_count]`.
pub copy struct CallRow {
    start: u64,
    end: u64,
    var_start: u32,
    var_count: u32,
}

pub struct Prog {
    exprs: ChunkSeq[ExprNode],
    pats: ChunkSeq[PatNode],
    pool: ChunkSeq[u32],
    funs: ChunkSeq[Fun],
    params: ChunkSeq[ParamRow],
    // symbol of a function key -> function index + 1
    fun_by_key: ChunkSeq[u32],
    effs: ChunkSeq[EffDecl],
    gens: ChunkSeq[u32],
    ops: ChunkSeq[Fun],
    // symbol -> effect declaration index + 1
    eff_by_name: ChunkSeq[u32],
    calls: ChunkSeq[CallRow],
    call_vars: ChunkSeq[u32],
}

pub fn no_expr() -> ExprNode {
    ExprNode { kind: 0, start: 0, end: 0, a: NONE32, b: NONE32, c: NONE32, d: NONE32, e: NONE32 }
}

pub fn no_fun() -> Fun {
    Fun {
        key: 0,
        name: 0,
        start: 0,
        end: 0,
        result: 0,
        row: 0,
        carried: 0,
        body: NONE32,
        param_start: 0,
        param_count: 0
    }
}

impl Prog {
    pub fn expr(in self, expr_id: u32) -> ExprNode {
        match self.exprs.try_get(w(expr_id)) {
            Option::Some(node) => node,
            Option::None => no_expr(),
        }
    }

    pub fn pat(in self, pat_id: u32) -> PatNode {
        match self.pats.try_get(w(pat_id)) {
            Option::Some(node) => node,
            Option::None => PatNode { kind: 0, start: 0, end: 0, a: NONE32, b: NONE32, c: NONE32 },
        }
    }

    pub fn at(in self, i: u64) -> u32 {
        u32_at(in self.pool, i)
    }

    pub fn fun(in self, i: u32) -> Fun {
        match self.funs.try_get(w(i)) {
            Option::Some(f) => f,
            Option::None => no_fun(),
        }
    }

    pub fn op(in self, i: u64) -> Fun {
        match self.ops.try_get(i) {
            Option::Some(f) => f,
            Option::None => no_fun(),
        }
    }

    pub fn param(in self, i: u64) -> ParamRow {
        match self.params.try_get(i) {
            Option::Some(p) => p,
            Option::None => ParamRow { name: 0, pass: 0, ty: 0 },
        }
    }

    // `world.functions.get(key)`: a function index, or NONE32.
    pub fn lookup(in self, key: u32) -> u32 {
        if key == NONE32 {
            return NONE32;
        }
        let entry = u32_at(in self.fun_by_key, w(key));
        if entry == 0 {
            NONE32
        } else {
            wrapping_sub(entry, 1)
        }
    }

    pub fn decl(in self, i: u32) -> EffDecl {
        match self.effs.try_get(w(i)) {
            Option::Some(d) => d,
            Option::None => EffDecl {
                name: 0,
                linear: false,
                start: 0,
                end: 0,
                gen_start: 0,
                gen_count: 0,
                op_start: 0,
                op_count: 0
            },
        }
    }

    // `world.effects.get(name)`: a declaration index, or NONE32.
    pub fn decl_of(in self, name: u32) -> u32 {
        if name == NONE32 {
            return NONE32;
        }
        let entry = u32_at(in self.eff_by_name, w(name));
        if entry == 0 {
            NONE32
        } else {
            wrapping_sub(entry, 1)
        }
    }

    // The operation `op` of declaration `decl_id` (`d.ops.iter().find(..)`), as
    // an index into `ops`, or NONE32.
    pub fn find_op(in self, decl_id: u32, op: u32) -> u32 {
        if decl_id == NONE32 {
            return NONE32;
        }
        let decl = self.decl(decl_id);
        for i in 0..w(decl.op_count) {
            let candidate = self.op(add(w(decl.op_start), i));
            if candidate.name == op {
                return n32(add(w(decl.op_start), i));
            }
        }
        NONE32
    }

    // The index of the `world.calls` row of span (start, end), or NONE32.
    pub fn call(in self, start: u64, end: u64) -> u32 {
        let mut lo: u64 = 0;
        let mut hi = self.calls.len();
        loop {
            if lo >= hi {
                break;
            }
            let mid = wrapping_add(lo, wrapping_sub(hi, lo) / 2);
            let row = self.call_row(mid);
            if row.start < start || (row.start == start && row.end < end) {
                lo = inc(mid);
            } else {
                hi = mid;
            }
        }
        let row = self.call_row(lo);
        if lo < self.calls.len() && row.start == start && row.end == end {
            n32(lo)
        } else {
            NONE32
        }
    }

    pub fn call_row(in self, i: u64) -> CallRow {
        match self.calls.try_get(i) {
            Option::Some(row) => row,
            Option::None => CallRow { start: 0, end: 0, var_start: 0, var_count: 0 },
        }
    }
}

fn read_fun(
    inout reader: Reader,
    in bytes: Slice[u8],
    in ctx: Ctx,
    inout params: ChunkSeq[ParamRow]
) -> Fun {
    let key = u32_at(in ctx.nmap, reader.word(in bytes));
    let name = u32_at(in ctx.nmap, reader.word(in bytes));
    let start = reader.word(in bytes);
    let end = reader.word(in bytes);
    let result = u32_at(in ctx.tmap, reader.word(in bytes));
    let row = u32_at(in ctx.tmap, reader.word(in bytes));
    let carried = u32_at(in ctx.tmap, reader.word(in bytes));
    let body = n32(reader.word(in bytes));
    let param_count = reader.word(in bytes);
    let param_start = n32(params.len());
    for i in 0..param_count {
        let param_name = u32_at(in ctx.nmap, reader.word(in bytes));
        let pass = wrapping_u8(reader.word(in bytes));
        let ty = u32_at(in ctx.tmap, reader.word(in bytes));
        params.push(ParamRow { name: param_name, pass: pass, ty: ty });
    }
    Fun {
        key: key,
        name: name,
        start: start,
        end: end,
        result: result,
        row: row,
        carried: carried,
        body: body,
        param_start: param_start,
        param_count: n32(param_count)
    }
}

// Maps an encoded name index to its symbol, keeping NONE32.
fn sym_or_none(in ctx: Ctx, index: u64) -> u32 {
    if index == widen_u64(NONE32) {
        NONE32
    } else {
        u32_at(in ctx.nmap, index)
    }
}

fn ty_or_none(in ctx: Ctx, index: u64) -> u32 {
    if index == widen_u64(NONE32) {
        NONE32
    } else {
        u32_at(in ctx.tmap, index)
    }
}

fn map_sym(inout pool: ChunkSeq[u32], in ctx: Ctx, at: u64) {
    let raw = u32_at(in pool, at);
    let ok = pool.try_set(at, sym_or_none(in ctx, w(raw)));
}

fn map_ty(inout pool: ChunkSeq[u32], in ctx: Ctx, at: u64) {
    let raw = u32_at(in pool, at);
    let ok = pool.try_set(at, ty_or_none(in ctx, w(raw)));
}

// Decodes the task words; `reader` is at the first of them.
pub fn read_prog(inout reader: Reader, in bytes: Slice[u8], in ctx: Ctx) -> Prog {
    let expr_count = reader.word(in bytes);
    let mut exprs: ChunkSeq[ExprNode] = ChunkSeq::with_capacity[ExprNode](expr_count);
    for i in 0..expr_count {
        let kind = wrapping_u8(reader.word(in bytes));
        let start = reader.word(in bytes);
        let end = reader.word(in bytes);
        let mut a = reader.word(in bytes);
        let mut bb = reader.word(in bytes);
        let mut cc = reader.word(in bytes);
        let mut d = reader.word(in bytes);
        let e = reader.word(in bytes);
        // Names and types in the fields become symbols and type ids.
        if kind == EXPR_NAME
            || kind == EXPR_STRUCT
            || kind == EXPR_UNARY
            || kind == EXPR_BINARY
            || kind == EXPR_ASSIGN
            || kind == EXPR_HANDLE {
            a = widen_u64(sym_or_none(in ctx, a));
        }
        if kind == EXPR_FIELD {
            bb = widen_u64(sym_or_none(in ctx, bb));
        }
        if kind == EXPR_CLOSURE {
            cc = widen_u64(ty_or_none(in ctx, cc));
            d = widen_u64(ty_or_none(in ctx, d));
        }
        exprs.push(ExprNode {
            kind: kind,
            start: start,
            end: end,
            a: n32(a),
            b: n32(bb),
            c: n32(cc),
            d: n32(d),
            e: n32(e)
        });
    }
    let pat_count = reader.word(in bytes);
    let mut pats: ChunkSeq[PatNode] = ChunkSeq::with_capacity[PatNode](pat_count);
    for i in 0..pat_count {
        let kind = wrapping_u8(reader.word(in bytes));
        let start = reader.word(in bytes);
        let end = reader.word(in bytes);
        let mut a = reader.word(in bytes);
        let pb = reader.word(in bytes);
        let pc = reader.word(in bytes);
        if kind == PAT_BIND || kind == PAT_CONSTRUCTOR {
            a = widen_u64(sym_or_none(in ctx, a));
        }
        pats.push(PatNode {
            kind: kind,
            start: start,
            end: end,
            a: n32(a),
            b: n32(pb),
            c: n32(pc)
        });
    }
    // The pool holds expression and pattern indices and passes, and the
    // names and types of the lists that have them, which are mapped to
    // symbols and type ids below (each list belongs to one node).
    let pool_len = reader.word(in bytes);
    let mut pool: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](pool_len);
    for i in 0..pool_len {
        pool.push(n32(reader.word(in bytes)));
    }
    for i in 0..exprs.len() {
        let node = match exprs.try_get(i) {
            Option::Some(node) => node,
            Option::None => no_expr(),
        };
        if node.kind == EXPR_STRUCT {
            for j in 0..w(node.c) {
                map_sym(inout pool, in ctx, add(w(node.b), wrapping_mul(j, PAIR_WORDS)));
            }
        } else if node.kind == EXPR_BLOCK {
            for j in 0..w(node.b) {
                map_ty(
                    inout pool,
                    in ctx,
                    add(w(node.a), add(wrapping_mul(j, StmtWord::Words), StmtWord::Type))
                );
            }
        } else if node.kind == EXPR_CLOSURE {
            for j in 0..w(node.b) {
                let at = add(w(node.a), wrapping_mul(j, ParamWord::Words));
                map_sym(inout pool, in ctx, at);
                map_ty(inout pool, in ctx, add(at, ParamWord::Type));
            }
        } else if node.kind == EXPR_HANDLE {
            let clause_count = w(u32_at(in pool, w(node.e)));
            for j in 0..clause_count {
                map_sym(
                    inout pool,
                    in ctx,
                    add(inc(w(node.e)), wrapping_mul(j, ClauseWord::Words))
                );
            }
        }
    }
    for i in 0..pats.len() {
        let pat = match pats.try_get(i) {
            Option::Some(pat) => pat,
            Option::None => PatNode { kind: 0, start: 0, end: 0, a: 0, b: 0, c: 0 },
        };
        if pat.kind == PAT_CONSTRUCTOR {
            for j in 0..w(pat.c) {
                map_sym(inout pool, in ctx, add(w(pat.b), wrapping_mul(j, PAIR_WORDS)));
            }
        }
    }
    let mut params: ChunkSeq[ParamRow] = ChunkSeq::new[ParamRow]();
    let fun_count = reader.word(in bytes);
    let mut funs: ChunkSeq[Fun] = ChunkSeq::with_capacity[Fun](fun_count);
    let mut fun_by_key: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..fun_count {
        let func = read_fun(inout reader, in bytes, in ctx, inout params);
        set_by_symbol(inout fun_by_key, func.key, inc32(n32(funs.len())));
        funs.push(func);
    }
    let decl_count = reader.word(in bytes);
    let mut effs: ChunkSeq[EffDecl] = ChunkSeq::new[EffDecl]();
    let mut gens: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut ops: ChunkSeq[Fun] = ChunkSeq::new[Fun]();
    let mut eff_by_name: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..decl_count {
        let name = u32_at(in ctx.nmap, reader.word(in bytes));
        let linear = reader.word(in bytes) != 0;
        let start = reader.word(in bytes);
        let end = reader.word(in bytes);
        let gen_count = reader.word(in bytes);
        let gen_start = n32(gens.len());
        for j in 0..gen_count {
            gens.push(u32_at(in ctx.nmap, reader.word(in bytes)));
        }
        let op_count = reader.word(in bytes);
        let op_start = n32(ops.len());
        for j in 0..op_count {
            let op = read_fun(inout reader, in bytes, in ctx, inout params);
            ops.push(op);
        }
        set_by_symbol(inout eff_by_name, name, inc32(n32(effs.len())));
        effs.push(EffDecl {
            name: name,
            linear: linear,
            start: start,
            end: end,
            gen_start: gen_start,
            gen_count: n32(gen_count),
            op_start: op_start,
            op_count: n32(op_count)
        });
    }
    let call_count = reader.word(in bytes);
    let mut calls: ChunkSeq[CallRow] = ChunkSeq::with_capacity[CallRow](call_count);
    let mut call_vars: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..call_count {
        let start = reader.word(in bytes);
        let end = reader.word(in bytes);
        let var_count = reader.word(in bytes);
        let var_start = n32(call_vars.len());
        for j in 0..var_count {
            call_vars.push(u32_at(in ctx.nmap, reader.word(in bytes)));
            call_vars.push(u32_at(in ctx.tmap, reader.word(in bytes)));
        }
        calls.push(CallRow {
            start: start,
            end: end,
            var_start: var_start,
            var_count: n32(var_count)
        });
    }
    Prog {
        exprs: exprs,
        pats: pats,
        pool: pool,
        funs: funs,
        params: params,
        fun_by_key: fun_by_key,
        effs: effs,
        gens: gens,
        ops: ops,
        eff_by_name: eff_by_name,
        calls: calls,
        call_vars: call_vars
    }
}
