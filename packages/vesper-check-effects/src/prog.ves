// The program the capability rules walk: the world's functions with their
// bodies, its effect declarations and its call instantiations, decoded from
// the task words of tests/self_host_check_effects.rs (`encode_task`).
//
// Bodies are an index graph, laid out like @vesper/ast's: an expression
// names its children by index into `exprs`, a list of children is a run of
// words in `pool`. Names are symbols of the context's `Names` and types are
// ids of its `Types`. NONE32 is an absent child.
//
// Expression kinds and fields (`a`..`e`):
//   1 Literal  a = literal kind
//   2 Name     a = name
//   3 Tuple    a, b = list of Expr
//   4 Struct   a = name, b, c = list of (name, Expr)
//   5 Block    a, b = list of Stmt (kind 1 let / 2 expr, pat, type, value),
//              c = tail or NONE
//   6 Call     a = callee, b, c = list of (pass, Expr)
//   7 Field    a = base, b = name
//   8 Index    a, b
//   9 Try      a
//  10 Unary    a = operator, b
//  11 Binary   a = operator, b, c
//  12 Assign   a = operator, b = place, c = value
//  13 If       a = condition, b = then, c = otherwise or NONE
//  14 Match    a = value, b, c = list of (Pattern, Expr)
//  15 Closure  a, b = list of Param (name, pass, type), c = result type,
//              d = effect row type, e = body
//  16 Handle   a = effect name, b = state Pattern or NONE, c = state Expr or
//              NONE, d = body, e = pool index of the clause count, then the
//              clauses (name, pats first, pats len, body): return first
//  17 Loop     a = body
//  18 For      a = Pattern, b = iter, c = body
//  19 Range    a = start, b = end
//  20 Break    a = value or NONE
//  21 Return   a = value or NONE
//  22 Continue
//
// Pattern kinds: 1 Wild, 2 Bind (a = name), 3 Literal, 4 Tuple (a, b = list
// of Pattern), 5 Constructor (a = name, b, c = list of (name, Pattern)).

use @vesper/check-data::util::{
    add,
    inc,
    inc32,
    n32,
    u32_at,
    w
};
use @vesper/check-data::input::{
    Ctx,
    Reader
};
use @vesper/check-data::world::{
    set_by_symbol
};

const NONE32: u32 = 4294967295;

pub copy struct ExprNode {
    kind: u8,
    start: u64,
    end: u64,
    a: u32,
    b: u32,
    c: u32,
    d: u32,
    e: u32,
}

pub copy struct PatNode {
    kind: u8,
    start: u64,
    end: u64,
    a: u32,
    b: u32,
    c: u32,
}

// A function (`world.functions`, in key order) or an effect operation.
// `row` is the declared effect row (a `Type::Row` id), `carried` the row
// `float_math::carried_effects` gives it.
pub copy struct Fun {
    key: u32,
    name: u32,
    start: u64,
    end: u64,
    result: u32,
    row: u32,
    carried: u32,
    body: u32,
    pa: u32,
    pn: u32,
}

pub copy struct ParamRow {
    name: u32,
    pass: u8,
    ty: u32,
}

// An effect declaration: generics are `gens[ga..ga+gn]` (names), operations
// `ops[oa..oa+on]`.
pub copy struct EffDecl {
    name: u32,
    linear: bool,
    start: u64,
    end: u64,
    ga: u32,
    gn: u32,
    oa: u32,
    on: u32,
}

// `world.calls`: the generic instantiation of a call span, as pairs
// (name, type) in `call_vars[va..va+2*vn]`.
pub copy struct CallRow {
    start: u64,
    end: u64,
    va: u32,
    vn: u32,
}

pub struct Prog {
    exprs: ChunkSeq[ExprNode],
    pats: ChunkSeq[PatNode],
    pool: ChunkSeq[u32],
    funs: ChunkSeq[Fun],
    params: ChunkSeq[ParamRow],
    // symbol of a function key -> function index + 1
    fun_by_key: ChunkSeq[u32],
    effs: ChunkSeq[EffDecl],
    gens: ChunkSeq[u32],
    ops: ChunkSeq[Fun],
    // symbol -> effect declaration index + 1
    eff_by_name: ChunkSeq[u32],
    calls: ChunkSeq[CallRow],
    call_vars: ChunkSeq[u32],
}

pub fn no_expr() -> ExprNode {
    ExprNode {
        kind: 0,
        start: 0,
        end: 0,
        a: NONE32,
        b: NONE32,
        c: NONE32,
        d: NONE32,
        e: NONE32
    }
}

pub fn no_fun() -> Fun {
    Fun {
        key: 0,
        name: 0,
        start: 0,
        end: 0,
        result: 0,
        row: 0,
        carried: 0,
        body: NONE32,
        pa: 0,
        pn: 0
    }
}

impl Prog {
    pub fn expr(in self, e: u32) -> ExprNode {
        match self.exprs.try_get(w(e)) {
            Option::Some(x) => x,
            Option::None => no_expr(),
        }
    }

    pub fn pat(in self, p: u32) -> PatNode {
        match self.pats.try_get(w(p)) {
            Option::Some(x) => x,
            Option::None => PatNode {
                kind: 0,
                start: 0,
                end: 0,
                a: NONE32,
                b: NONE32,
                c: NONE32
            },
        }
    }

    pub fn at(in self, i: u64) -> u32 {
        u32_at(in self.pool, i)
    }

    pub fn fun(in self, i: u32) -> Fun {
        match self.funs.try_get(w(i)) {
            Option::Some(f) => f,
            Option::None => no_fun(),
        }
    }

    pub fn op(in self, i: u64) -> Fun {
        match self.ops.try_get(i) {
            Option::Some(f) => f,
            Option::None => no_fun(),
        }
    }

    pub fn param(in self, i: u64) -> ParamRow {
        match self.params.try_get(i) {
            Option::Some(p) => p,
            Option::None => ParamRow {
                name: 0,
                pass: 0,
                ty: 0
            },
        }
    }

    // `world.functions.get(key)`: a function index, or NONE32.
    pub fn lookup(in self, key: u32) -> u32 {
        if key == NONE32 {
            return NONE32;
        }
        let x = u32_at(in self.fun_by_key, w(key));
        if x == 0 {
            NONE32
        } else {
            wrapping_sub(x, 1)
        }
    }

    pub fn decl(in self, i: u32) -> EffDecl {
        match self.effs.try_get(w(i)) {
            Option::Some(d) => d,
            Option::None => EffDecl {
                name: 0,
                linear: false,
                start: 0,
                end: 0,
                ga: 0,
                gn: 0,
                oa: 0,
                on: 0
            },
        }
    }

    // `world.effects.get(name)`: a declaration index, or NONE32.
    pub fn decl_of(in self, name: u32) -> u32 {
        if name == NONE32 {
            return NONE32;
        }
        let x = u32_at(in self.eff_by_name, w(name));
        if x == 0 {
            NONE32
        } else {
            wrapping_sub(x, 1)
        }
    }

    // The operation `op` of declaration `d` (`d.ops.iter().find(..)`), as
    // an index into `ops`, or NONE32.
    pub fn find_op(in self, d: u32, op: u32) -> u32 {
        if d == NONE32 {
            return NONE32;
        }
        let x = self.decl(d);
        for i in 0..w(x.on) {
            let f = self.op(add(w(x.oa), i));
            if f.name == op {
                return n32(add(w(x.oa), i));
            }
        }
        NONE32
    }

    // The index of the `world.calls` row of span (start, end), or NONE32.
    pub fn call(in self, start: u64, end: u64) -> u32 {
        let mut lo: u64 = 0;
        let mut hi = self.calls.len();
        loop {
            if lo >= hi {
                break;
            }
            let mid = wrapping_add(lo, wrapping_sub(hi, lo) / 2);
            let r = self.call_row(mid);
            if r.start < start || (r.start == start && r.end < end) {
                lo = inc(mid);
            } else {
                hi = mid;
            }
        }
        let r = self.call_row(lo);
        if lo < self.calls.len() && r.start == start && r.end == end {
            n32(lo)
        } else {
            NONE32
        }
    }

    pub fn call_row(in self, i: u64) -> CallRow {
        match self.calls.try_get(i) {
            Option::Some(r) => r,
            Option::None => CallRow {
                start: 0,
                end: 0,
                va: 0,
                vn: 0
            },
        }
    }
}

fn read_fun(inout r: Reader, in b: Slice[u8], in c: Ctx, inout params: ChunkSeq[ParamRow]) -> Fun {
    let key = u32_at(in c.nmap, r.word(in b));
    let name = u32_at(in c.nmap, r.word(in b));
    let start = r.word(in b);
    let end = r.word(in b);
    let result = u32_at(in c.tmap, r.word(in b));
    let row = u32_at(in c.tmap, r.word(in b));
    let carried = u32_at(in c.tmap, r.word(in b));
    let body = n32(r.word(in b));
    let pn = r.word(in b);
    let pa = n32(params.len());
    for i in 0..pn {
        let pname = u32_at(in c.nmap, r.word(in b));
        let pass = wrapping_u8(r.word(in b));
        let ty = u32_at(in c.tmap, r.word(in b));
        params
            .push(
                ParamRow {
                    name: pname,
                    pass: pass,
                    ty: ty
                }
            );
    }
    Fun {
        key: key,
        name: name,
        start: start,
        end: end,
        result: result,
        row: row,
        carried: carried,
        body: body,
        pa: pa,
        pn: n32(pn)
    }
}

// Maps an encoded name index to its symbol, keeping NONE32.
fn sym_or_none(in c: Ctx, x: u64) -> u32 {
    if x == 4294967295 {
        NONE32
    } else {
        u32_at(in c.nmap, x)
    }
}

fn ty_or_none(in c: Ctx, x: u64) -> u32 {
    if x == 4294967295 {
        NONE32
    } else {
        u32_at(in c.tmap, x)
    }
}

fn map_sym(inout pool: ChunkSeq[u32], in c: Ctx, at: u64) {
    let x = u32_at(in pool, at);
    let ok = pool.try_set(at, sym_or_none(in c, w(x)));
}

fn map_ty(inout pool: ChunkSeq[u32], in c: Ctx, at: u64) {
    let x = u32_at(in pool, at);
    let ok = pool.try_set(at, ty_or_none(in c, w(x)));
}

// Decodes the task words; `r` is at the first of them.
pub fn read_prog(inout r: Reader, in b: Slice[u8], in c: Ctx) -> Prog {
    let ne = r.word(in b);
    let mut exprs: ChunkSeq[ExprNode] = ChunkSeq::with_capacity[ExprNode](ne);
    for i in 0..ne {
        let kind = wrapping_u8(r.word(in b));
        let start = r.word(in b);
        let end = r.word(in b);
        let mut a = r.word(in b);
        let mut bb = r.word(in b);
        let mut cc = r.word(in b);
        let mut d = r.word(in b);
        let e = r.word(in b);
        // Names and types in the fields become symbols and type ids.
        if kind == 2 || kind == 4 || kind == 10 || kind == 11 || kind == 12 || kind == 16 {
            a = widen_u64(sym_or_none(in c, a));
        }
        if kind == 7 {
            bb = widen_u64(sym_or_none(in c, bb));
        }
        if kind == 15 {
            cc = widen_u64(ty_or_none(in c, cc));
            d = widen_u64(ty_or_none(in c, d));
        }
        exprs
            .push(
                ExprNode {
                    kind: kind,
                    start: start,
                    end: end,
                    a: n32(a),
                    b: n32(bb),
                    c: n32(cc),
                    d: n32(d),
                    e: n32(e)
                }
            );
    }
    let np = r.word(in b);
    let mut pats: ChunkSeq[PatNode] = ChunkSeq::with_capacity[PatNode](np);
    for i in 0..np {
        let kind = wrapping_u8(r.word(in b));
        let start = r.word(in b);
        let end = r.word(in b);
        let mut a = r.word(in b);
        let pb = r.word(in b);
        let pc = r.word(in b);
        if kind == 2 || kind == 5 {
            a = widen_u64(sym_or_none(in c, a));
        }
        pats
            .push(
                PatNode {
                    kind: kind,
                    start: start,
                    end: end,
                    a: n32(a),
                    b: n32(pb),
                    c: n32(pc)
                }
            );
    }
    // The pool holds expression and pattern indices and passes, and the
    // names and types of the lists that have them, which are mapped to
    // symbols and type ids below (each list belongs to one node).
    let nl = r.word(in b);
    let mut pool: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](nl);
    for i in 0..nl {
        pool.push(n32(r.word(in b)));
    }
    for i in 0..exprs.len() {
        let x = match exprs.try_get(i) {
            Option::Some(x) => x,
            Option::None => no_expr(),
        };
        if x.kind == 4 {
            for j in 0..w(x.c) {
                map_sym(inout pool, in c, add(w(x.b), wrapping_mul(j, 2)));
            }
        } else if x.kind == 5 {
            for j in 0..w(x.b) {
                map_ty(inout pool, in c, add(w(x.a), add(wrapping_mul(j, 4), 2)));
            }
        } else if x.kind == 15 {
            for j in 0..w(x.b) {
                let at = add(w(x.a), wrapping_mul(j, 3));
                map_sym(inout pool, in c, at);
                map_ty(inout pool, in c, add(at, 2));
            }
        } else if x.kind == 16 {
            let n = w(u32_at(in pool, w(x.e)));
            for j in 0..n {
                map_sym(inout pool, in c, add(inc(w(x.e)), wrapping_mul(j, 4)));
            }
        }
    }
    for i in 0..pats.len() {
        let p = match pats.try_get(i) {
            Option::Some(p) => p,
            Option::None => PatNode {
                kind: 0,
                start: 0,
                end: 0,
                a: 0,
                b: 0,
                c: 0
            },
        };
        if p.kind == 5 {
            for j in 0..w(p.c) {
                map_sym(inout pool, in c, add(w(p.b), wrapping_mul(j, 2)));
            }
        }
    }
    let mut params: ChunkSeq[ParamRow] = ChunkSeq::new[ParamRow]();
    let nf = r.word(in b);
    let mut funs: ChunkSeq[Fun] = ChunkSeq::with_capacity[Fun](nf);
    let mut fun_by_key: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..nf {
        let f = read_fun(inout r, in b, in c, inout params);
        set_by_symbol(inout fun_by_key, f.key, inc32(n32(funs.len())));
        funs.push(f);
    }
    let nd = r.word(in b);
    let mut effs: ChunkSeq[EffDecl] = ChunkSeq::new[EffDecl]();
    let mut gens: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut ops: ChunkSeq[Fun] = ChunkSeq::new[Fun]();
    let mut eff_by_name: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..nd {
        let name = u32_at(in c.nmap, r.word(in b));
        let linear = r.word(in b) != 0;
        let start = r.word(in b);
        let end = r.word(in b);
        let gn = r.word(in b);
        let ga = n32(gens.len());
        for j in 0..gn {
            gens.push(u32_at(in c.nmap, r.word(in b)));
        }
        let on = r.word(in b);
        let oa = n32(ops.len());
        for j in 0..on {
            let f = read_fun(inout r, in b, in c, inout params);
            ops.push(f);
        }
        set_by_symbol(inout eff_by_name, name, inc32(n32(effs.len())));
        effs
            .push(
                EffDecl {
                    name: name,
                    linear: linear,
                    start: start,
                    end: end,
                    ga: ga,
                    gn: n32(gn),
                    oa: oa,
                    on: n32(on)
                }
            );
    }
    let nc = r.word(in b);
    let mut calls: ChunkSeq[CallRow] = ChunkSeq::with_capacity[CallRow](nc);
    let mut call_vars: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..nc {
        let start = r.word(in b);
        let end = r.word(in b);
        let vn = r.word(in b);
        let va = n32(call_vars.len());
        for j in 0..vn {
            call_vars.push(u32_at(in c.nmap, r.word(in b)));
            call_vars.push(u32_at(in c.tmap, r.word(in b)));
        }
        calls
            .push(
                CallRow {
                    start: start,
                    end: end,
                    va: va,
                    vn: n32(vn)
                }
            );
    }
    Prog {
        exprs: exprs,
        pats: pats,
        pool: pool,
        funs: funs,
        params: params,
        fun_by_key: fun_by_key,
        effs: effs,
        gens: gens,
        ops: ops,
        eff_by_name: eff_by_name,
        calls: calls,
        call_vars: call_vars
    }
}
