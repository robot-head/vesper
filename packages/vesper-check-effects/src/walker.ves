// `capability_effects::Walker`: one walk of a function body under a set of
// capabilities, function by function as in src/capability_effects.rs.
//
// The census design replaces the Rust maps: scopes are one stack of
// `Local` rows with scope marks (a lookup scans from the top, so a later
// binding shadows an earlier one exactly as a `BTreeMap` insert replaces
// it), facts are sorted key sets (keys.ves), and the realtime call graph is
// a flat list of edges between interned node names, which a loop walk
// truncates where the Rust walk restores a clone.
//
// Capabilities are bits in `BTreeSet<Capability>` order: 1 ConstTime,
// 2 Realtime, 4 DetFloat, 8 ConstDenorm.

use @vesper/check-data::util::{add, inc, n32, push_decimal, u32_at, w};
use @vesper/check-data::input::{Ctx};
use @vesper/check-data::types::{EffNode, Vars, display, substitute, vars_new, TyKind, TyPass};
use @vesper/check-data::world::{constructor, field_step};
use @vesper-std/bytes::ascii::{
    COLON, DIGIT_NINE, DIGIT_ONE, DIGIT_ZERO, EQUALS, LOWER_E, LOWER_F, LOWER_U, LOWER_Z,
    OPEN_BRACKET, PLUS, UNDERSCORE
};
use self::codes::{
    CODE_LEN, E_CALLEE_LACKS_CAPS, E_DF_DENORM, E_DF_HOST_OP, E_DF_REMAINDER, E_RTBUS_OUTSIDE_RT,
    E_RT_FORBIDDEN_EFFECT, E_RT_OPEN_ROW, E_RT_RESUMABLE_HANDLER, E_SECRET_BRANCH, E_SECRET_INDEX,
    E_SECRET_LATENCY, E_SECRET_PAYLOAD, E_SECRET_RESULT, E_SECRET_TO_PUBLIC, E_UNCHECKED_FN_VALUE,
    E_UNRESOLVED_CALLEE
};
use self::keys::{HIGH_UNIT, Keys, Sums, keys_new, pair, sums_new};
use self::kinds::{
    ClauseWord, EXPR_ASSIGN, EXPR_BINARY, EXPR_BLOCK, EXPR_BREAK, EXPR_CALL, EXPR_CLOSURE,
    EXPR_CONTINUE, EXPR_FIELD, EXPR_FOR, EXPR_HANDLE, EXPR_IF, EXPR_INDEX, EXPR_LITERAL, EXPR_LOOP,
    EXPR_MATCH, EXPR_NAME, EXPR_RANGE, EXPR_RETURN, EXPR_STRUCT, EXPR_TRY, EXPR_TUPLE, EXPR_UNARY,
    PAIR_WORDS, PAT_BIND, PAT_CONSTRUCTOR, PAT_LITERAL, PAT_TUPLE, PAT_WILD, ParamWord,
    STATE_PAIR_LEN, STMT_LET, StmtWord
};
use self::prog::{ExprNode, Fun, NONE32, PatNode, Prog};

pub const CT: u8 = 1;
pub const RT: u8 = 2;
pub const DF: u8 = 4;
pub const CD: u8 = 8;
pub const ALL_CAPS: u8 = CT | RT | DF | CD;

// `coerce`: the capabilities of a value with no function type.
const CAPS_NONE: u8 = 16;

// `secret_type` answers by type id.
const MEMO_UNKNOWN: u8 = 0;
const MEMO_PUBLIC: u8 = 1;
const MEMO_SECRET: u8 = 2;

// `World::constructor`: no constructor of that name.
pub const NO_CTOR: u64 = 18446744073709551615;

// The `::` between path segments.
const PATH_SEP_LEN: u64 = 2;

// The bytes of the integer and float kind names that are not in
// @vesper-std/bytes::ascii (`isize`, `u16`, `i32`, `u64`, `f32`, ...).
const LOWER_I: u8 = 105;
const LOWER_S: u8 = 115;
const DIGIT_TWO: u8 = 50;
const DIGIT_THREE: u8 = 51;
const DIGIT_FOUR: u8 = 52;
const DIGIT_SIX: u8 = 54;
const DIGIT_EIGHT: u8 = 56;

// The lengths of a kind name after its `u`, `i` or `f`, plus that letter:
// `size`, `8`, `16`/`32`/`64` and `128`.
const SIZE_KIND_LEN: u64 = 5;
const BYTE_KIND_LEN: u64 = 2;
const WORD_KIND_LEN: u64 = 3;
const WIDE_KIND_LEN: u64 = 4;

// The length of `declassify`.
const DECLASSIFY_LEN: u64 = 10;

// `Walker::handler`: the rounds of its taint fixpoint, as in Rust.
const HANDLER_ROUNDS: u64 = 4;

// The callee kinds of `Walker::resolve`.
const C_CONSTRUCTOR: u8 = 1;
const C_INTRINSIC: u8 = 2;
const C_FUNCTION: u8 = 3;
const C_EFFECT_OP: u8 = 4;
const C_VALUE: u8 = 5;
const C_UNKNOWN: u8 = 6;

// Well-known symbols, interned once per input.
pub copy struct Syms {
    const_time: u32,
    realtime: u32,
    det_float: u32,
    const_denorm: u32,
    rtbus: u32,
    secret: u32,
    sec_u8: u32,
    sec_u32: u32,
    sec_u64: u32,
    sec_mask: u32,
    unit: u32,
    never: u32,
    f32_: u32,
    f64_: u32,
    indirect: u32,
    and_and: u32,
    or_or: u32,
    div: u32,
    rem: u32,
    eq: u32,
    ne: u32,
    lt: u32,
    le: u32,
    gt: u32,
    ge: u32,
    assign: u32,
}

fn sym(inout ctx: Ctx, in text: Str) -> u32 {
    ctx.names.intern(in text.as_bytes())
}

pub fn syms_new(inout ctx: Ctx) -> Syms {
    Syms {
        const_time: sym(inout ctx, "ConstTime"),
        realtime: sym(inout ctx, "Realtime"),
        det_float: sym(inout ctx, "DetFloat"),
        const_denorm: sym(inout ctx, "ConstDenorm"),
        rtbus: sym(inout ctx, "RtBus"),
        secret: sym(inout ctx, "Secret"),
        sec_u8: sym(inout ctx, "SecU8"),
        sec_u32: sym(inout ctx, "SecU32"),
        sec_u64: sym(inout ctx, "SecU64"),
        sec_mask: sym(inout ctx, "SecMask64"),
        unit: sym(inout ctx, "Unit"),
        never: sym(inout ctx, "Never"),
        f32_: sym(inout ctx, "f32"),
        f64_: sym(inout ctx, "f64"),
        indirect: sym(inout ctx, "$indirect"),
        and_and: sym(inout ctx, "&&"),
        or_or: sym(inout ctx, "||"),
        div: sym(inout ctx, "/"),
        rem: sym(inout ctx, "%"),
        eq: sym(inout ctx, "=="),
        ne: sym(inout ctx, "!="),
        lt: sym(inout ctx, "<"),
        le: sym(inout ctx, "<="),
        gt: sym(inout ctx, ">"),
        ge: sym(inout ctx, ">="),
        assign: sym(inout ctx, "=")
    }
}

// A binding of the walk (`Local`). `resume_eff` is NONE32 unless the binding is
// a handler's continuation for operation (`resume_eff`, `resume_op`).
pub copy struct Local {
    name: u32,
    tainted: bool,
    lexical: bool,
    public: bool,
    ty: u32,
    resume_eff: u32,
    resume_op: u32,
    result_taint: bool,
    takes_state: bool,
}

// A diagnostic over `Walk.text`: code [code_start, message_start), message
// [message_start, help_start), help [help_start, help_end).
pub copy struct DRow {
    start: u64,
    end: u64,
    code_start: u64,
    message_start: u64,
    help_start: u64,
    help_end: u64,
}

// An edge of the realtime call graph: node -> callee at a call span.
pub copy struct Edge {
    node: u32,
    callee: u32,
    start: u64,
    end: u64,
}

pub copy struct Ret {
    ty: u32,
    tainted: bool,
}

pub copy struct Callee {
    kind: u8,
    // C_FUNCTION: function index; C_EFFECT_OP: operation index.
    index: u32,
    // C_EFFECT_OP: declaration index.
    decl: u32,
    // C_VALUE: the callee's type (NONE32 for none) and lexical flag.
    ty: u32,
    lexical: bool,
}

pub struct Walk {
    syms: Syms,
    fun_index: u32,
    caps: u8,
    // Whether diagnostics are written (not while summarising).
    emit: bool,
    summaries: Sums,
    found: Sums,
    locals: ChunkSeq[Local],
    marks: ChunkSeq[u64],
    text: ChunkSeq[u8],
    rows: ChunkSeq[DRow],
    direct_callees: ChunkSeq[u32],
    node: u32,
    nodes: ChunkSeq[u32],
    edges: ChunkSeq[Edge],
    indirect: Keys,
    breaks: ChunkSeq[bool],
    returns: ChunkSeq[Ret],
    // secret_type answers by type id: 0 unknown, 1 public, 2 secret.
    secret_memo: ChunkSeq[u8],
    seen: ChunkSeq[u32],
    scratch: ChunkSeq[u8],
}

pub fn walk_new(syms: Syms) -> Walk {
    Walk {
        syms: syms,
        fun_index: 0,
        caps: 0,
        emit: false,
        summaries: sums_new(),
        found: sums_new(),
        locals: ChunkSeq::new[Local](),
        marks: ChunkSeq::new[u64](),
        text: ChunkSeq::new[u8](),
        rows: ChunkSeq::new[DRow](),
        direct_callees: ChunkSeq::new[u32](),
        node: NONE32,
        nodes: ChunkSeq::new[u32](),
        edges: ChunkSeq::new[Edge](),
        indirect: keys_new(),
        breaks: ChunkSeq::new[bool](),
        returns: ChunkSeq::new[Ret](),
        secret_memo: ChunkSeq::new[u8](),
        seen: ChunkSeq::new[u32](),
        scratch: ChunkSeq::new[u8]()
    }
}

fn no_local() -> Local {
    Local {
        name: NONE32,
        tainted: false,
        lexical: false,
        public: false,
        ty: NONE32,
        resume_eff: NONE32,
        resume_op: NONE32,
        result_taint: false,
        takes_state: false
    }
}

fn plain(name: u32, tainted: bool, ty: u32) -> Local {
    Local {
        name: name,
        tainted: tainted,
        lexical: false,
        public: false,
        ty: ty,
        resume_eff: NONE32,
        resume_op: NONE32,
        result_taint: false,
        takes_state: false
    }
}

fn bool_at(in flags: ChunkSeq[bool], i: u64) -> bool {
    match flags.try_get(i) {
        Option::Some(flag) => flag,
        Option::None => false,
    }
}

// ------------------------------------------------------------ type helpers

// The capability bits of effect row type `row` (`capabilities`).
pub fn caps_of(in ctx: Ctx, syms: Syms, row: u32) -> u8 {
    let ty_node = ctx.types.node(row);
    let row_node = ctx.types.row(ty_node.r2);
    let mut out: u8 = 0;
    for i in 0..w(row_node.n) {
        let effect = ctx.types.effect_at(add(w(row_node.a), i));
        if effect.name == syms.const_time {
            out = out | CT;
        } else if effect.name == syms.realtime {
            out = out | RT;
        } else if effect.name == syms.det_float {
            out = out | DF;
        } else if effect.name == syms.const_denorm {
            out = out | CD;
        }
    }
    out
}

fn row_tail(in ctx: Ctx, row: u32) -> u32 {
    let ty_node = ctx.types.node(row);
    ctx.types.row(ty_node.r2).tail
}

fn row_len(in ctx: Ctx, row: u32) -> u64 {
    let ty_node = ctx.types.node(row);
    w(ctx.types.row(ty_node.r2).n)
}

fn row_effect(in ctx: Ctx, row: u32, i: u64) -> EffNode {
    let ty_node = ctx.types.node(row);
    let row_node = ctx.types.row(ty_node.r2);
    ctx.types.effect_at(add(w(row_node.a), i))
}

fn is_secret_name(syms: Syms, name: u32) -> bool {
    name == syms.secret
        || name == syms.sec_u8
        || name == syms.sec_u32
        || name == syms.sec_u64
        || name == syms.sec_mask
}

// `REALTIME_FORBIDDEN`.
pub fn forbidden(in ctx: Ctx, name: u32) -> bool {
    ctx.names.spells(name, in "Alloc".as_bytes())
        || ctx.names.spells(name, in "Async".as_bytes())
        || ctx.names.spells(name, in "Net".as_bytes())
        || ctx.names.spells(name, in "Storage".as_bytes())
        || ctx.names.spells(name, in "Scope".as_bytes())
        || ctx.names.spells(name, in "Mutex".as_bytes())
        || ctx.names.spells(name, in "Lock".as_bytes())
        || ctx.names.spells(name, in "Block".as_bytes())
        || ctx.names.spells(name, in "Blocking".as_bytes())
        || ctx.names.spells(name, in "Ffi".as_bytes())
        || ctx.names.spells(name, in "Io".as_bytes())
        || ctx.names.spells(name, in "Sleep".as_bytes())
}

fn secret_visit(in ctx: Ctx, syms: Syms, ty: u32, inout seen: ChunkSeq[u32]) -> bool {
    let ty_node = ctx.types.node(ty);
    if ty_node.kind == TyKind::Named {
        if is_secret_name(syms, ty_node.name) && ctx.world.lookup(ty_node.name) != NONE32 {
            return true;
        }
        for i in 0..w(ty_node.n) {
            if secret_visit(in ctx, syms, ctx.types.arg(ty, i), inout seen) {
                return true;
            }
        }
        let adt_index = ctx.world.lookup(ty_node.name);
        if adt_index == NONE32 {
            return false;
        }
        for i in 0..seen.len() {
            if u32_at(in seen, i) == ty_node.name {
                return false;
            }
        }
        seen.push(ty_node.name);
        let adt = ctx.world.adt(adt_index);
        let mut found = false;
        for j in 0..w(adt.vn) {
            let variant = ctx.world.variant(add(w(adt.va), j));
            for field_index in 0..w(variant.fc) {
                if !found
                    && secret_visit(
                        in ctx,
                        syms,
                        ctx.world.field(add(w(variant.fa), field_index)).ty,
                        inout seen
                    ) {
                    found = true;
                }
            }
        }
        // `seen.remove(n)`: the name is the last one pushed.
        let last = wrapping_sub(seen.len(), 1);
        seen.truncate(last);
        return found;
    }
    if ty_node.kind == TyKind::Tuple {
        for i in 0..w(ty_node.n) {
            if secret_visit(in ctx, syms, ctx.types.arg(ty, i), inout seen) {
                return true;
            }
        }
    }
    false
}

// `Walker::secret_type`, memoised by type id.
pub fn secret_type(in ctx: Ctx, inout walk: Walk, ty: u32) -> bool {
    if ty == NONE32 {
        return false;
    }
    let memo = match walk.secret_memo.try_get(w(ty)) {
        Option::Some(cached) => cached,
        Option::None => MEMO_UNKNOWN,
    };
    if memo != MEMO_UNKNOWN {
        return memo == MEMO_SECRET;
    }
    walk.seen.clear();
    let is_secret = secret_visit(in ctx, walk.syms, ty, inout walk.seen);
    loop {
        if walk.secret_memo.len() > w(ty) {
            break;
        }
        walk.secret_memo.push(MEMO_UNKNOWN);
    }
    let ok = walk.secret_memo.try_set(w(ty), if is_secret { MEMO_SECRET } else { MEMO_PUBLIC });
    is_secret
}

fn carries_no_information(in ctx: Ctx, syms: Syms, ty: u32) -> bool {
    let ty_node = ctx.types.node(ty);
    if ty_node.kind == TyKind::Tuple && ty_node.n == 0 {
        return true;
    }
    let name = ctx.types.name(ty);
    name == syms.unit || name == syms.never
}

fn mentions_float(in ctx: Ctx, syms: Syms, ty: u32) -> bool {
    let ty_node = ctx.types.node(ty);
    if ty_node.kind == TyKind::Named {
        if ty_node.name == syms.f32_ || ty_node.name == syms.f64_ {
            return true;
        }
        for i in 0..w(ty_node.n) {
            if mentions_float(in ctx, syms, ctx.types.arg(ty, i)) {
                return true;
            }
        }
        return false;
    }
    if ty_node.kind == TyKind::Tuple {
        for i in 0..w(ty_node.n) {
            if mentions_float(in ctx, syms, ctx.types.arg(ty, i)) {
                return true;
            }
        }
        return false;
    }
    if ty_node.kind == TyKind::Fn {
        for i in 0..w(ty_node.n) {
            if mentions_float(in ctx, syms, ctx.types.arg(ty, i)) {
                return true;
            }
        }
        return mentions_float(in ctx, syms, ty_node.r);
    }
    false
}

fn is_float_type(in ctx: Ctx, syms: Syms, ty: u32) -> bool {
    if ty == NONE32 {
        return false;
    }
    let name = ctx.types.name(ty);
    name == syms.f32_ || name == syms.f64_
}

// ------------------------------------------------------------ name helpers

fn find_colons(in ctx: Ctx, name: u32, from: u64) -> u64 {
    let n = ctx.names.size(name);
    let mut i = from;
    loop {
        if inc(i) >= n {
            return n;
        }
        if ctx.names.byte(name, i) == COLON && ctx.names.byte(name, inc(i)) == COLON {
            return i;
        }
        i = inc(i);
    }
}

// The symbol of bytes [lo, hi) of `name`, or NONE32 when no name spells it.
fn sub_sym(in ctx: Ctx, inout walk: Walk, name: u32, lo: u64, hi: u64) -> u32 {
    walk.scratch.clear();
    for i in lo..hi {
        walk.scratch.push(ctx.names.byte(name, i));
    }
    ctx.names.lookup(in walk.scratch.as_slice())
}

// `World::constructor(name)`, packed as world.ves `constructor` returns it.
pub fn ctor(in ctx: Ctx, inout walk: Walk, name: u32) -> u64 {
    let none: u64 = NO_CTOR;
    let n = ctx.names.size(name);
    let first_sep = find_colons(in ctx, name, 0);
    if first_sep >= n {
        return constructor(in ctx.world, NONE32, name);
    }
    if find_colons(in ctx, name, add(first_sep, PATH_SEP_LEN)) < n {
        return none;
    }
    let qualifier = sub_sym(in ctx, inout walk, name, 0, first_sep);
    let short = sub_sym(in ctx, inout walk, name, add(first_sep, PATH_SEP_LEN), n);
    if qualifier == NONE32 || short == NONE32 {
        return none;
    }
    constructor(in ctx.world, qualifier, short)
}

fn name_starts(in ctx: Ctx, name: u32, in prefix: Str) -> bool {
    ctx.names.has_prefix(name, in prefix.as_bytes())
}

// The rest of `name` after `prefix`, if it names an integer kind.
fn int_kind_after(in ctx: Ctx, name: u32, skip: u64) -> bool {
    let n = ctx.names.size(name);
    let rest = wrapping_sub(n, skip);
    let first_byte = ctx.names.byte(name, skip);
    if rest == SIZE_KIND_LEN {
        // usize, isize
        return (first_byte == LOWER_U || first_byte == LOWER_I)
            && ctx.names.byte(name, add(skip, 1)) == LOWER_S
            && ctx.names.byte(name, add(skip, 2)) == LOWER_I
            && ctx.names.byte(name, add(skip, 3)) == LOWER_Z
            && ctx.names.byte(name, add(skip, 4)) == LOWER_E;
    }
    if first_byte != LOWER_U && first_byte != LOWER_I {
        return false;
    }
    if rest == BYTE_KIND_LEN {
        return ctx.names.byte(name, add(skip, 1)) == DIGIT_EIGHT;
    }
    if rest == WORD_KIND_LEN {
        let digit1 = ctx.names.byte(name, add(skip, 1));
        let digit2 = ctx.names.byte(name, add(skip, 2));
        return (digit1 == DIGIT_ONE && digit2 == DIGIT_SIX)
            || (digit1 == DIGIT_THREE && digit2 == DIGIT_TWO)
            || (digit1 == DIGIT_SIX && digit2 == DIGIT_FOUR);
    }
    if rest == WIDE_KIND_LEN {
        // i128, u128
        return ctx.names.byte(name, add(skip, 1)) == DIGIT_ONE
            && ctx.names.byte(name, add(skip, 2)) == DIGIT_TWO
            && ctx.names.byte(name, add(skip, 3)) == DIGIT_EIGHT;
    }
    false
}

fn float_kind_after(in ctx: Ctx, name: u32, skip: u64) -> bool {
    let n = ctx.names.size(name);
    if wrapping_sub(n, skip) != WORD_KIND_LEN || ctx.names.byte(name, skip) != LOWER_F {
        return false;
    }
    let digit1 = ctx.names.byte(name, add(skip, 1));
    let digit2 = ctx.names.byte(name, add(skip, 2));
    (digit1 == DIGIT_THREE && digit2 == DIGIT_TWO) || (digit1 == DIGIT_SIX && digit2 == DIGIT_FOUR)
}

fn prefixed_int(in ctx: Ctx, name: u32, in prefix: Str) -> bool {
    name_starts(in ctx, name, prefix) && int_kind_after(in ctx, name, prefix.len())
}

fn prefixed_float(in ctx: Ctx, name: u32, in prefix: Str) -> bool {
    name_starts(in ctx, name, prefix) && float_kind_after(in ctx, name, prefix.len())
}

// `numeric::wrapping_intrinsic(name).is_some()`.
fn wrapping_intrinsic(in ctx: Ctx, name: u32) -> bool {
    ctx.names.spells(name, in "wrapping_add".as_bytes())
        || ctx.names.spells(name, in "wrapping_sub".as_bytes())
        || ctx.names.spells(name, in "wrapping_mul".as_bytes())
}

// `bit_intrinsic`, `numeric::conversion`, `numeric::rotate_intrinsic` or
// `numeric::float::is_float_intrinsic` knows `name`.
// One `||` chain of 24 terms makes `vesper fmt` stop at DepthLimit, so the
// names are checked in two halves.
fn other_intrinsic(in ctx: Ctx, name: u32) -> bool {
    bit_or_int_intrinsic(in ctx, name) || float_intrinsic(in ctx, name)
}

fn bit_or_int_intrinsic(in ctx: Ctx, name: u32) -> bool {
    ctx.names.spells(name, in "bit_and".as_bytes())
        || ctx.names.spells(name, in "bit_or".as_bytes())
        || ctx.names.spells(name, in "bit_xor".as_bytes())
        || ctx.names.spells(name, in "bit_shl".as_bytes())
        || ctx.names.spells(name, in "bit_shr".as_bytes())
        || prefixed_int(in ctx, name, "widen_")
        || prefixed_int(in ctx, name, "narrow_")
        || prefixed_int(in ctx, name, "wrapping_")
        || ctx.names.spells(name, in "rotate_left".as_bytes())
        || ctx.names.spells(name, in "rotate_right".as_bytes())
}

fn float_intrinsic(in ctx: Ctx, name: u32) -> bool {
    ctx.names.spells(name, in "sqrt".as_bytes())
        || ctx.names.spells(name, in "abs".as_bytes())
        || ctx.names.spells(name, in "floor".as_bytes())
        || ctx.names.spells(name, in "ceil".as_bytes())
        || ctx.names.spells(name, in "round".as_bytes())
        || ctx.names.spells(name, in "trunc".as_bytes())
        || ctx.names.spells(name, in "min".as_bytes())
        || ctx.names.spells(name, in "max".as_bytes())
        || ctx.names.spells(name, in "fma".as_bytes())
        || prefixed_float(in ctx, name, "widen_")
        || prefixed_float(in ctx, name, "nearest_")
        || prefixed_int(in ctx, name, "saturating_")
        || prefixed_float(in ctx, name, "to_bits_")
        || prefixed_float(in ctx, name, "from_bits_")
}

// `is_declassify_gate`: the last path segment is `declassify` or starts
// with `declassify_`.
pub fn is_declassify_gate(in ctx: Ctx, name: u32) -> bool {
    let n = ctx.names.size(name);
    let mut seg_start: u64 = 0;
    let mut i: u64 = 0;
    loop {
        if inc(i) >= n {
            break;
        }
        if ctx.names.byte(name, i) == COLON && ctx.names.byte(name, inc(i)) == COLON {
            seg_start = add(i, PATH_SEP_LEN);
            i = add(i, PATH_SEP_LEN);
        } else {
            i = inc(i);
        }
    }
    let word = "declassify".as_bytes();
    let len = wrapping_sub(n, seg_start);
    if len < DECLASSIFY_LEN {
        return false;
    }
    for j in 0..DECLASSIFY_LEN {
        let expected = match word.try_get(j) {
            Option::Some(byte) => byte,
            Option::None => 0,
        };
        if ctx.names.byte(name, add(seg_start, j)) != expected {
            return false;
        }
    }
    len == DECLASSIFY_LEN || ctx.names.byte(name, add(seg_start, DECLASSIFY_LEN)) == UNDERSCORE
}

// ------------------------------------------------------------ text

fn put(inout walk: Walk, in text: Str) {
    walk.text.extend(in text.as_bytes());
}

fn put_name(in ctx: Ctx, inout walk: Walk, name: u32) {
    ctx.names.write(name, inout walk.text);
}

fn put_ty(in ctx: Ctx, inout walk: Walk, ty: u32) {
    display(in ctx.types, in ctx.names, ty, inout walk.text);
}

fn put_caps(inout walk: Walk, caps: u8) {
    let mut first = true;
    if caps & CT != 0 {
        put(inout walk, "ConstTime");
        first = false;
    }
    if caps & RT != 0 {
        if !first {
            put(inout walk, ", ");
        }
        put(inout walk, "Realtime");
        first = false;
    }
    if caps & DF != 0 {
        if !first {
            put(inout walk, ", ");
        }
        put(inout walk, "DetFloat");
        first = false;
    }
    if caps & CD != 0 {
        if !first {
            put(inout walk, ", ");
        }
        put(inout walk, "ConstDenorm");
    }
}

fn fname(in prog: Prog, in walk: Walk) -> u32 {
    prog.fun(walk.fun_index).name
}

// Starts a diagnostic: writes the code and returns its text start; the
// caller writes the message and calls `finish`.
fn begin(inout walk: Walk, in code: Str) -> u64 {
    let code_start = walk.text.len();
    put(inout walk, code);
    code_start
}

fn finish(inout walk: Walk, code_start: u64, in help: Str, start: u64, end: u64) {
    let help_start = walk.text.len();
    put(inout walk, help);
    walk.rows.push(DRow {
        start: start,
        end: end,
        code_start: code_start,
        message_start: add(code_start, CODE_LEN),
        help_start: help_start,
        help_end: walk.text.len()
    });
}

// " (in '<function>')"
fn put_in_fn(in ctx: Ctx, in prog: Prog, inout walk: Walk) {
    put(inout walk, " (in '");
    put_name(in ctx, inout walk, fname(in prog, in walk));
    put(inout walk, "')");
}

// ------------------------------------------------------------ scopes

pub fn open_scope(inout walk: Walk) {
    walk.marks.push(walk.locals.len());
}

pub fn close_scope(inout walk: Walk) {
    let last = wrapping_sub(walk.marks.len(), 1);
    let mark = match walk.marks.try_get(last) {
        Option::Some(mark) => mark,
        Option::None => 0,
    };
    walk.marks.truncate(last);
    walk.locals.truncate(mark);
}

pub fn bind(inout walk: Walk, binding: Local) {
    walk.locals.push(binding);
}

// The innermost binding of `name`, as an index into `locals`, or NONE32.
pub fn local(in walk: Walk, name: u32) -> u32 {
    let mut i = walk.locals.len();
    loop {
        if i == 0 {
            return NONE32;
        }
        i = wrapping_sub(i, 1);
        match walk.locals.try_get(i) {
            Option::Some(binding) => {
                if binding.name == name {
                    return n32(i);
                }
            },
            Option::None => {},
        }
    }
}

pub fn local_at(in walk: Walk, i: u32) -> Local {
    match walk.locals.try_get(w(i)) {
        Option::Some(binding) => binding,
        Option::None => no_local(),
    }
}

fn set_local(inout walk: Walk, i: u32, binding: Local) {
    let ok = walk.locals.try_set(w(i), binding);
}

fn add_node(inout walk: Walk, node: u32) {
    for i in 0..walk.nodes.len() {
        if u32_at(in walk.nodes, i) == node {
            return;
        }
    }
    walk.nodes.push(node);
}

fn edge(inout walk: Walk, callee: u32, start: u64, end: u64) {
    if walk.node != NONE32 {
        walk.edges.push(Edge { node: walk.node, callee: callee, start: start, end: end });
    }
}

fn has(in walk: Walk, cap: u8) -> bool {
    walk.caps & cap != 0
}

// A node name `<prefix><start>` ("$closure@12"), interned.
fn node_name(inout ctx: Ctx, inout walk: Walk, in prefix: Str, start: u64) -> u32 {
    walk.scratch.clear();
    walk.scratch.extend(in prefix.as_bytes());
    push_decimal(inout walk.scratch, start);
    ctx.names.intern(in walk.scratch.as_slice())
}

// ------------------------------------------------------------ the walk

// `Walker::new`: binds the parameters of function `fun_index`.
pub fn start(
    inout ctx: Ctx,
    in prog: Prog,
    inout walk: Walk,
    fun_index: u32,
    caps: u8,
    infer: bool
) {
    walk.fun_index = fun_index;
    walk.caps = caps;
    walk.found.clear();
    walk.locals.clear();
    walk.marks.clear();
    walk.marks.push(0);
    walk.direct_callees.clear();
    walk.node = NONE32;
    walk.indirect.clear();
    walk.breaks.clear();
    walk.returns.clear();
    let func = prog.fun(fun_index);
    if has(in walk, RT) {
        walk.node = func.name;
        add_node(inout walk, func.name);
    }
    for i in 0..w(func.param_count) {
        let param = prog.param(add(w(func.param_start), i));
        let secret = secret_type(in ctx, inout walk, param.ty);
        let inferred = infer && walk.summaries.inferred.has(pair(func.name, n32(i)));
        bind(
            inout walk,
            Local {
                name: param.name,
                tainted: secret || inferred,
                lexical: false,
                public: !secret,
                ty: param.ty,
                resume_eff: NONE32,
                resume_op: NONE32,
                result_taint: false,
                takes_state: false
            }
        );
    }
}

fn denorm_conflict(in ctx: Ctx, inout walk: Walk, closure: bool, name: u32, start: u64, end: u64) {
    if !walk.emit {
        return;
    }
    let code_start = begin(inout walk, E_DF_DENORM);
    if closure {
        put(inout walk, "closure");
    } else {
        put(inout walk, "function '");
        put_name(in ctx, inout walk, name);
        put(inout walk, "'");
    }
    put(
        inout walk,
        " combines DetFloat and ConstDenorm: flushing subnormals to zero changes IEEE 754 results, so it cannot be bit deterministic"
    );
    finish(
        inout walk,
        code_start,
        "keep bit-deterministic float code out of ConstDenorm scopes",
        start,
        end
    );
}

// `Walker::function_rules`.
fn function_rules(in ctx: Ctx, in prog: Prog, inout walk: Walk, func: Fun) {
    if has(in walk, DF) && has(in walk, CD) {
        denorm_conflict(in ctx, inout walk, false, func.name, func.start, func.end);
    }
    if !has(in walk, RT) || !walk.emit {
        return;
    }
    for i in 0..row_len(in ctx, func.row) {
        let effect = row_effect(in ctx, func.row, i);
        if forbidden(in ctx, effect.name) {
            let code_start = begin(inout walk, E_RT_FORBIDDEN_EFFECT);
            put(inout walk, "eff [Realtime] function '");
            put_name(in ctx, inout walk, func.name);
            put(inout walk, "' carries '");
            put_name(in ctx, inout walk, effect.name);
            put(inout walk, "', which may allocate, block or suspend");
            finish(
                inout walk,
                code_start,
                "realtime rows exclude Alloc, Async, Net, Storage, Scope, locks, Ffi and blocking I/O",
                func.start,
                func.end
            );
        }
    }
    let tail = row_tail(in ctx, func.row);
    if tail != 0 {
        let code_start = begin(inout walk, E_RT_OPEN_ROW);
        put(inout walk, "eff [Realtime] function '");
        put_name(in ctx, inout walk, func.name);
        put(inout walk, "' has an open effect row '");
        put_name(in ctx, inout walk, wrapping_sub(tail, 1));
        put(inout walk, "', which may admit blocking effects");
        finish(
            inout walk,
            code_start,
            "list the realtime function's effects explicitly",
            func.start,
            func.end
        );
    }
}

// `Walker::function_body`: the signature rules and the body; whether the
// result is secret-derived.
pub fn function_body(inout ctx: Ctx, in prog: Prog, inout walk: Walk) -> bool {
    let func = prog.fun(walk.fun_index);
    function_rules(in ctx, in prog, inout walk, func);
    if func.body == NONE32 {
        return false;
    }
    walk.returns.push(Ret { ty: func.result, tainted: false });
    let tainted = expr(inout ctx, in prog, inout walk, func.body);
    let returned = pop_return(inout walk);
    coerce(inout ctx, in prog, inout walk, func.body, func.result);
    tainted || returned
}

fn pop_return(inout walk: Walk) -> bool {
    let last = wrapping_sub(walk.returns.len(), 1);
    let tainted = match walk.returns.try_get(last) {
        Option::Some(ret) => ret.tainted,
        Option::None => false,
    };
    walk.returns.truncate(last);
    tainted
}

// `Walker::ty`: the checked type of expression `expr_id`, or NONE32.
pub fn ty_of(inout ctx: Ctx, in prog: Prog, in walk: Walk, expr_id: u32) -> u32 {
    let node = prog.expr(expr_id);
    let checked = ctx.world.expr_type(node.start, node.end);
    if checked != NONE32 && checked != ctx.types.infer {
        return checked;
    }
    if node.kind == EXPR_NAME {
        let local_index = local(in walk, node.a);
        if local_index == NONE32 {
            return NONE32;
        }
        return local_at(in walk, local_index).ty;
    }
    if node.kind == EXPR_FIELD {
        let base_ty = ty_of(inout ctx, in prog, in walk, node.a);
        if base_ty == NONE32 {
            return NONE32;
        }
        let is_index_step = ctx.names.size(node.b) > 0 && ctx.names.byte(node.b, 0) == OPEN_BRACKET;
        return field_one(inout ctx, base_ty, node.b, is_index_step);
    }
    NONE32
}

fn field_one(inout ctx: Ctx, ty: u32, name: u32, is_index_step: bool) -> u32 {
    field_step(inout ctx.types, inout ctx.names, in ctx.world, ty, name, is_index_step)
}

fn taint_snapshot(in walk: Walk, inout out: ChunkSeq[bool]) {
    out.clear();
    for i in 0..walk.locals.len() {
        out.push(local_at(in walk, n32(i)).tainted);
    }
}

fn same_bools(in a: ChunkSeq[bool], in b: ChunkSeq[bool]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for i in 0..a.len() {
        if bool_at(in a, i) != bool_at(in b, i) {
            return false;
        }
    }
    true
}

// `Walker::loop_body` for `loop { body }` (`pat` NONE32) or the body of a
// `for` whose pattern binds with taint `bound` and type `element`: walks to
// a taint fixpoint, keeping only the last walk's findings. Returns whether
// a `break` value is secret-derived.
fn loop_body(
    inout ctx: Ctx,
    in prog: Prog,
    inout walk: Walk,
    body: u32,
    pat: u32,
    bound: bool,
    element: u32
) -> bool {
    let row_count = walk.rows.len();
    let text_len = walk.text.len();
    let direct_count = walk.direct_callees.len();
    let edge_count = walk.edges.len();
    let node_count = walk.nodes.len();
    let mut before: ChunkSeq[bool] = ChunkSeq::new[bool]();
    let mut after: ChunkSeq[bool] = ChunkSeq::new[bool]();
    loop {
        taint_snapshot(in walk, inout before);
        walk.breaks.push(false);
        open_scope(inout walk);
        if pat != NONE32 {
            bind_pattern(inout ctx, in prog, inout walk, pat, bound, element);
        }
        let body_taint = expr(inout ctx, in prog, inout walk, body);
        close_scope(inout walk);
        let last = wrapping_sub(walk.breaks.len(), 1);
        let broke = bool_at(in walk.breaks, last);
        walk.breaks.truncate(last);
        taint_snapshot(in walk, inout after);
        if same_bools(in before, in after) {
            return broke;
        }
        walk.rows.truncate(row_count);
        walk.text.truncate(text_len);
        walk.direct_callees.truncate(direct_count);
        walk.edges.truncate(edge_count);
        walk.nodes.truncate(node_count);
    }
}

fn bind_names(inout walk: Walk, in prog: Prog, pat: u32, tainted: bool, ty: u32) {
    let pat_node = prog.pat(pat);
    if pat_node.kind == PAT_BIND {
        bind(inout walk, plain(pat_node.a, tainted, ty));
    } else if pat_node.kind == PAT_TUPLE {
        for i in 0..w(pat_node.b) {
            bind_names(inout walk, in prog, prog.at(add(w(pat_node.a), i)), tainted, ty);
        }
    } else if pat_node.kind == PAT_CONSTRUCTOR {
        for i in 0..w(pat_node.c) {
            bind_names(
                inout walk,
                in prog,
                prog.at(add(w(pat_node.b), inc(wrapping_mul(i, PAIR_WORDS)))),
                tainted,
                ty
            );
        }
    }
}

// `Walker::bind_pattern`; `scrutinee_ty` is NONE32 for none.
pub fn bind_pattern(
    inout ctx: Ctx,
    in prog: Prog,
    inout walk: Walk,
    pat: u32,
    tainted: bool,
    scrutinee_ty: u32
) {
    if scrutinee_ty != NONE32 {
        secret_access_pattern(inout ctx, in prog, inout walk, pat, scrutinee_ty);
    }
    let whole = prog.pat(pat).kind == PAT_BIND;
    bind_names(inout walk, in prog, pat, tainted, if whole { scrutinee_ty } else { NONE32 });
}

// Whether `name` is a decimal number (`str::parse::<usize>` succeeds).
fn is_index(in ctx: Ctx, name: u32) -> bool {
    let n = ctx.names.size(name);
    if n == 0 {
        return false;
    }
    let mut digits_start: u64 = 0;
    if ctx.names.byte(name, 0) == PLUS {
        digits_start = 1;
        if n == 1 {
            return false;
        }
    }
    for i in digits_start..n {
        let byte = ctx.names.byte(name, i);
        if byte < DIGIT_ZERO || byte > DIGIT_NINE {
            return false;
        }
    }
    true
}

// `Walker::secret_access_pattern`: outside ConstTime, destructuring a
// secret exposes its payload.
fn secret_access_pattern(inout ctx: Ctx, in prog: Prog, inout walk: Walk, pat: u32, ty: u32) {
    if has(in walk, CT) || !secret_type(in ctx, inout walk, ty) {
        return;
    }
    let pat_node = prog.pat(pat);
    let ty_node = ctx.types.node(ty);
    if pat_node.kind == PAT_TUPLE && ty_node.kind == TyKind::Tuple {
        for i in 0..w(pat_node.b) {
            if i >= w(ty_node.n) {
                break;
            }
            let sub_pat = prog.at(add(w(pat_node.a), i));
            let sub_ty = ctx.types.arg(ty, i);
            secret_access_pattern(inout ctx, in prog, inout walk, sub_pat, sub_ty);
        }
    } else if pat_node.kind == PAT_CONSTRUCTOR && ty_node.kind == TyKind::Named {
        let ctor_key = ctor(in ctx, inout walk, pat_node.a);
        if ctor_key != NO_CTOR {
            let adt = ctx.world.adt(n32(ctor_key / HIGH_UNIT));
            let variant = ctx.world.variant(ctor_key % HIGH_UNIT);
            let vars = ctx.world.vars_of(in ctx.types, adt, ty);
            for i in 0..w(pat_node.c) {
                let field = prog.at(add(w(pat_node.b), wrapping_mul(i, PAIR_WORDS)));
                let sub_pat = prog.at(add(w(pat_node.b), inc(wrapping_mul(i, PAIR_WORDS))));
                let mut field_index = ctx.world.find_field(variant, field);
                if field_index == NONE32 && i < w(variant.fc) && is_index(in ctx, field) {
                    field_index = n32(add(w(variant.fa), i));
                }
                if field_index != NONE32 {
                    let field_ty = substitute(
                        inout ctx.types,
                        ctx.world.field(w(field_index)).ty,
                        in vars
                    );
                    secret_access_pattern(inout ctx, in prog, inout walk, sub_pat, field_ty);
                }
            }
        }
    }
    if pat_node.kind == PAT_CONSTRUCTOR {
        let ctor_key = ctor(in ctx, inout walk, pat_node.a);
        if ctor_key != NO_CTOR {
            let adt = ctx.world.adt(n32(ctor_key / HIGH_UNIT));
            if is_secret_name(walk.syms, adt.name) && walk.emit {
                let code_start = begin(inout walk, E_SECRET_PAYLOAD);
                put(inout walk, "the payload of secret '");
                put_ty(in ctx, inout walk, ty);
                put(inout walk, "' can only be read inside eff [ConstTime]");
                put_in_fn(in ctx, in prog, inout walk);
                finish(
                    inout walk,
                    code_start,
                    "move the computation into an eff [ConstTime] function",
                    pat_node.start,
                    pat_node.end
                );
            }
        }
    }
}

fn refutable_pat(in ctx: Ctx, in prog: Prog, inout walk: Walk, pat: u32) -> bool {
    let pat_node = prog.pat(pat);
    if pat_node.kind == PAT_WILD || pat_node.kind == PAT_BIND {
        return false;
    }
    if pat_node.kind == PAT_LITERAL {
        return true;
    }
    if pat_node.kind == PAT_TUPLE {
        for i in 0..w(pat_node.b) {
            if refutable_pat(in ctx, in prog, inout walk, prog.at(add(w(pat_node.a), i))) {
                return true;
            }
        }
        return false;
    }
    let ctor_key = ctor(in ctx, inout walk, pat_node.a);
    if ctor_key == NO_CTOR {
        return true;
    }
    if ctx.world.adt(n32(ctor_key / HIGH_UNIT)).vn != 1 {
        return true;
    }
    for i in 0..w(pat_node.c) {
        if refutable_pat(
            in ctx,
            in prog,
            inout walk,
            prog.at(add(w(pat_node.b), inc(wrapping_mul(i, PAIR_WORDS))))
        ) {
            return true;
        }
    }
    false
}

// `Walker::refutable`: whether a match over the arms at pool[first..]
// branches at run time.
fn refutable(in ctx: Ctx, in prog: Prog, inout walk: Walk, first: u32, arm_count: u32) -> bool {
    if arm_count != 1 {
        return true;
    }
    refutable_pat(in ctx, in prog, inout walk, prog.at(w(first)))
}

fn branch_on_secret(
    in ctx: Ctx,
    in prog: Prog,
    inout walk: Walk,
    in what: Str,
    start: u64,
    end: u64
) {
    if !walk.emit {
        return;
    }
    let code_start = begin(inout walk, E_SECRET_BRANCH);
    put(inout walk, "eff [ConstTime] ");
    put(inout walk, what);
    put(inout walk, " depends on a secret value");
    put_in_fn(in ctx, in prog, inout walk);
    finish(
        inout walk,
        code_start,
        "select with constant-time arithmetic and declassify only the final verdict",
        start,
        end
    );
}

fn tail_span(in prog: Prog, expr_id: u32) -> ExprNode {
    let node = prog.expr(expr_id);
    if node.kind == EXPR_BLOCK && node.c != NONE32 {
        return tail_span(in prog, node.c);
    }
    node
}

fn place_root(in prog: Prog, expr_id: u32) -> u32 {
    let node = prog.expr(expr_id);
    if node.kind == EXPR_NAME {
        return node.a;
    }
    if node.kind == EXPR_FIELD {
        return place_root(in prog, node.a);
    }
    NONE32
}

// `generic_vars(generics, ty)` for an ADT: its generics bound to the
// arguments of a `Named` type.
fn adt_vars(in ctx: Ctx, ctor_key: u64, ty: u32) -> Vars {
    if ty == NONE32 || ctx.types.kind(ty) != TyKind::Named {
        return vars_new();
    }
    let adt = ctx.world.adt(n32(ctor_key / HIGH_UNIT));
    ctx.world.vars_of(in ctx.types, adt, ty)
}

// `world.calls.get(span)` as a substitution.
fn call_vars(in prog: Prog, start: u64, end: u64, inout vars: Vars) {
    let call_index = prog.call(start, end);
    if call_index == NONE32 {
        return;
    }
    let row = prog.call_row(w(call_index));
    for i in 0..w(row.var_count) {
        let at = add(w(row.var_start), wrapping_mul(i, PAIR_WORDS));
        vars.set(u32_at(in prog.call_vars, at), u32_at(in prog.call_vars, inc(at)));
    }
}

// `Walker::expr`: walks `expr_id`; whether its value is secret-derived.
pub fn expr(inout ctx: Ctx, in prog: Prog, inout walk: Walk, expr_id: u32) -> bool {
    let const_time = has(in walk, CT);
    let expr_ty = ty_of(inout ctx, in prog, in walk, expr_id);
    let typed_secret = expr_ty != NONE32 && secret_type(in ctx, inout walk, expr_ty);
    let node = prog.expr(expr_id);
    let kind = node.kind;
    let tainted = if kind == EXPR_LITERAL || kind == EXPR_CONTINUE {
        false
    } else if kind == EXPR_NAME {
        let local_index = local(in walk, node.a);
        if local_index == NONE32 {
            let fun_index = prog.lookup(node.a);
            if fun_index != NONE32 {
                walk.found.addr_taken.insert(widen_u64(node.a));
                if caps_of(in ctx, walk.syms, prog.fun(fun_index).row) & RT != 0 {
                    walk.indirect.insert(widen_u64(node.a));
                }
            }
            false
        } else {
            local_at(in walk, local_index).tainted
        }
    } else if kind == EXPR_TUPLE {
        let mut taint = false;
        for i in 0..w(node.b) {
            let item_taint = expr(inout ctx, in prog, inout walk, prog.at(add(w(node.a), i)));
            taint = item_taint || taint;
        }
        taint
    } else if kind == EXPR_STRUCT {
        struct_literal(inout ctx, in prog, inout walk, expr_id, node)
    } else if kind == EXPR_BLOCK {
        block(inout ctx, in prog, inout walk, node)
    } else if kind == EXPR_CALL {
        call(inout ctx, in prog, inout walk, expr_id, node)
    } else if kind == EXPR_FIELD {
        let taint = expr(inout ctx, in prog, inout walk, node.a);
        if !const_time && walk.emit {
            let base_ty = ty_of(inout ctx, in prog, in walk, node.a);
            if base_ty != NONE32 && ctx.types.kind(base_ty) == TyKind::Named {
                let ty_name = ctx.types.name(base_ty);
                if is_secret_name(walk.syms, ty_name) && ctx.world.lookup(ty_name) != NONE32 {
                    let code_start = begin(inout walk, E_SECRET_PAYLOAD);
                    put(inout walk, "the payload of secret '");
                    put_ty(in ctx, inout walk, base_ty);
                    put(inout walk, "' can only be read inside eff [ConstTime]");
                    put_in_fn(in ctx, in prog, inout walk);
                    finish(
                        inout walk,
                        code_start,
                        "move the computation into an eff [ConstTime] function",
                        node.start,
                        node.end
                    );
                }
            }
        }
        taint
    } else if kind == EXPR_INDEX {
        let base_taint = expr(inout ctx, in prog, inout walk, node.a);
        let index_taint = expr(inout ctx, in prog, inout walk, node.b);
        if const_time && index_taint && walk.emit {
            let index_node = prog.expr(node.b);
            let code_start = begin(inout walk, E_SECRET_INDEX);
            put(inout walk, "eff [ConstTime] index depends on a secret value");
            put_in_fn(in ctx, in prog, inout walk);
            finish(
                inout walk,
                code_start,
                "secret-indexed loads leak through the cache; select over all elements instead",
                index_node.start,
                index_node.end
            );
        }
        base_taint || index_taint
    } else if kind == EXPR_TRY {
        let taint = expr(inout ctx, in prog, inout walk, node.a);
        if const_time && taint {
            branch_on_secret(in ctx, in prog, inout walk, "'?' propagation", node.start, node.end);
        }
        taint
    } else if kind == EXPR_UNARY {
        let taint = expr(inout ctx, in prog, inout walk, node.b);
        if const_time && taint && ctx.world.may_overflow(node.start, node.end) && walk.emit {
            let code_start = begin(inout walk, E_SECRET_LATENCY);
            put(inout walk, "eff [ConstTime] checked '");
            put_name(in ctx, inout walk, node.a);
            put(inout walk, "' on a secret value may abort depending on the secret");
            put_in_fn(in ctx, in prog, inout walk);
            finish(
                inout walk,
                code_start,
                "use wrapping_sub(0, x) on secrets",
                node.start,
                node.end
            );
        }
        taint
    } else if kind == EXPR_BINARY {
        let left_taint = expr(inout ctx, in prog, inout walk, node.b);
        let right_taint = expr(inout ctx, in prog, inout walk, node.c);
        let taint = left_taint || right_taint;
        binary(inout ctx, in prog, inout walk, node, node.a, node.b, node.c, left_taint, taint);
        taint
    } else if kind == EXPR_ASSIGN {
        assign(inout ctx, in prog, inout walk, node)
    } else if kind == EXPR_IF {
        let cond = expr(inout ctx, in prog, inout walk, node.a);
        if const_time && cond {
            let cond_node = prog.expr(node.a);
            branch_on_secret(
                in ctx,
                in prog,
                inout walk,
                "'if' condition",
                cond_node.start,
                cond_node.end
            );
        }
        open_scope(inout walk);
        let then_taint = expr(inout ctx, in prog, inout walk, node.b);
        close_scope(inout walk);
        let mut else_taint = false;
        if node.c != NONE32 {
            open_scope(inout walk);
            else_taint = expr(inout ctx, in prog, inout walk, node.c);
            close_scope(inout walk);
        }
        cond || then_taint || else_taint
    } else if kind == EXPR_MATCH {
        let scrutinee_taint = expr(inout ctx, in prog, inout walk, node.a);
        if const_time && scrutinee_taint && refutable(in ctx, in prog, inout walk, node.b, node.c) {
            let scrutinee_node = prog.expr(node.a);
            branch_on_secret(
                in ctx,
                in prog,
                inout walk,
                "'match' scrutinee",
                scrutinee_node.start,
                scrutinee_node.end
            );
        }
        let scrutinee_ty = ty_of(inout ctx, in prog, in walk, node.a);
        let mut taint = scrutinee_taint;
        for i in 0..w(node.c) {
            let at = add(w(node.b), wrapping_mul(i, PAIR_WORDS));
            open_scope(inout walk);
            bind_pattern(
                inout ctx,
                in prog,
                inout walk,
                prog.at(at),
                scrutinee_taint,
                scrutinee_ty
            );
            let arm_taint = expr(inout ctx, in prog, inout walk, prog.at(inc(at)));
            close_scope(inout walk);
            taint = taint || arm_taint;
        }
        taint
    } else if kind == EXPR_CLOSURE {
        closure(inout ctx, in prog, inout walk, expr_id, node)
    } else if kind == EXPR_HANDLE {
        handler(inout ctx, in prog, inout walk, node)
    } else if kind == EXPR_LOOP {
        loop_body(inout ctx, in prog, inout walk, node.a, NONE32, false, NONE32)
    } else if kind == EXPR_FOR {
        let bound = expr(inout ctx, in prog, inout walk, node.b);
        if const_time && bound {
            let iter_node = prog.expr(node.b);
            branch_on_secret(
                in ctx,
                in prog,
                inout walk,
                "'for' range bound",
                iter_node.start,
                iter_node.end
            );
        }
        let iter_node = prog.expr(node.b);
        let element = if iter_node.kind == EXPR_RANGE {
            ty_of(inout ctx, in prog, in walk, iter_node.a)
        } else {
            NONE32
        };
        let broke = loop_body(inout ctx, in prog, inout walk, node.c, node.a, bound, element);
        false
    } else if kind == EXPR_RANGE {
        let start_taint = expr(inout ctx, in prog, inout walk, node.a);
        let end_taint = expr(inout ctx, in prog, inout walk, node.b);
        start_taint || end_taint
    } else if kind == EXPR_BREAK {
        let taint = node.a != NONE32 && expr(inout ctx, in prog, inout walk, node.a);
        let n = walk.breaks.len();
        if n > 0 {
            let last = wrapping_sub(n, 1);
            let ok = walk.breaks.try_set(last, bool_at(in walk.breaks, last) || taint);
        }
        false
    } else if kind == EXPR_RETURN {
        if node.a != NONE32 {
            let taint = expr(inout ctx, in prog, inout walk, node.a);
            let n = walk.returns.len();
            if n > 0 {
                let last = wrapping_sub(n, 1);
                let ret = match walk.returns.try_get(last) {
                    Option::Some(ret) => ret,
                    Option::None => Ret { ty: NONE32, tainted: false },
                };
                coerce(inout ctx, in prog, inout walk, node.a, ret.ty);
                let ok = walk.returns
                    .try_set(last, Ret { ty: ret.ty, tainted: ret.tainted || taint });
            }
        }
        false
    } else {
        false
    };
    tainted || typed_secret
}

fn struct_literal(
    inout ctx: Ctx,
    in prog: Prog,
    inout walk: Walk,
    expr_id: u32,
    node: ExprNode
) -> bool {
    let ctor_key = ctor(in ctx, inout walk, node.a);
    let mut taint = false;
    for i in 0..w(node.c) {
        let field = prog.at(add(w(node.b), wrapping_mul(i, PAIR_WORDS)));
        let value = prog.at(add(w(node.b), inc(wrapping_mul(i, PAIR_WORDS))));
        let value_taint = expr(inout ctx, in prog, inout walk, value);
        taint = taint || value_taint;
        if ctor_key != NO_CTOR {
            let variant = ctx.world.variant(ctor_key % HIGH_UNIT);
            let field_index = ctx.world.find_field(variant, field);
            if field_index != NONE32 {
                let expr_ty = ty_of(inout ctx, in prog, in walk, expr_id);
                let vars = adt_vars(in ctx, ctor_key, expr_ty);
                let field_ty = substitute(
                    inout ctx.types,
                    ctx.world.field(w(field_index)).ty,
                    in vars
                );
                coerce(inout ctx, in prog, inout walk, value, field_ty);
            }
        }
    }
    taint
}

fn block(inout ctx: Ctx, in prog: Prog, inout walk: Walk, node: ExprNode) -> bool {
    open_scope(inout walk);
    for i in 0..w(node.b) {
        let stmt_at = add(w(node.a), wrapping_mul(i, StmtWord::Words));
        let kind = prog.at(stmt_at);
        let value = prog.at(add(stmt_at, StmtWord::Value));
        if kind == STMT_LET {
            let pat = prog.at(inc(stmt_at));
            let ty = prog.at(add(stmt_at, StmtWord::Type));
            let taint = expr(inout ctx, in prog, inout walk, value);
            let declared = ty != ctx.types.infer;
            if declared {
                coerce(inout ctx, in prog, inout walk, value, ty);
            }
            let lexical = prog.expr(value).kind == EXPR_CLOSURE;
            let scrutinee_ty = if declared {
                ty
            } else {
                ty_of(inout ctx, in prog, in walk, value)
            };
            bind_pattern(inout ctx, in prog, inout walk, pat, taint, scrutinee_ty);
            let pat_node = prog.pat(pat);
            if lexical && pat_node.kind == PAT_BIND {
                bind(
                    inout walk,
                    Local {
                        name: pat_node.a,
                        tainted: taint,
                        lexical: true,
                        public: false,
                        ty: scrutinee_ty,
                        resume_eff: NONE32,
                        resume_op: NONE32,
                        result_taint: false,
                        takes_state: false
                    }
                );
            }
        } else {
            let taint = expr(inout ctx, in prog, inout walk, value);
        }
    }
    let taint = node.c != NONE32 && expr(inout ctx, in prog, inout walk, node.c);
    close_scope(inout walk);
    taint
}

fn assign(inout ctx: Ctx, in prog: Prog, inout walk: Walk, node: ExprNode) -> bool {
    let place_taint = expr(inout ctx, in prog, inout walk, node.b);
    let value_taint = expr(inout ctx, in prog, inout walk, node.c);
    let target = ty_of(inout ctx, in prog, in walk, node.b);
    if target != NONE32 {
        coerce(inout ctx, in prog, inout walk, node.c, target);
    }
    let place_node = prog.expr(node.b);
    if place_node.kind == EXPR_NAME && prog.expr(node.c).kind != EXPR_CLOSURE {
        let local_index = local(in walk, place_node.a);
        if local_index != NONE32 {
            let mut binding = local_at(in walk, local_index);
            binding.lexical = false;
            set_local(inout walk, local_index, binding);
        }
    }
    if node.a != walk.syms.assign {
        // `op.trim_end_matches('=')`
        let n = ctx.names.size(node.a);
        let mut end = n;
        loop {
            if end == 0 || ctx.names.byte(node.a, wrapping_sub(end, 1)) != EQUALS {
                break;
            }
            end = wrapping_sub(end, 1);
        }
        walk.scratch.clear();
        for i in 0..end {
            walk.scratch.push(ctx.names.byte(node.a, i));
        }
        let op = ctx.names.intern(in walk.scratch.as_slice());
        binary(
            inout ctx,
            in prog,
            inout walk,
            node,
            op,
            node.b,
            node.c,
            place_taint,
            place_taint || value_taint
        );
    }
    if value_taint {
        let root = place_root(in prog, node.b);
        if root != NONE32 {
            secret_into_place(inout ctx, in prog, inout walk, root, node.start, node.end);
        }
    }
    false
}

// `Walker::binary` at `node` with operator `op` over `lhs` and `rhs`.
fn binary(
    inout ctx: Ctx,
    in prog: Prog,
    inout walk: Walk,
    node: ExprNode,
    op: u32,
    lhs: u32,
    rhs: u32,
    lhs_taint: bool,
    tainted: bool
) {
    let const_time = has(in walk, CT);
    let syms = walk.syms;
    if const_time && lhs_taint && (op == syms.and_and || op == syms.or_or) {
        let lhs_node = prog.expr(lhs);
        branch_on_secret(
            in ctx,
            in prog,
            inout walk,
            "short-circuit operand",
            lhs_node.start,
            lhs_node.end
        );
    }
    if const_time && tainted && (op == syms.div || op == syms.rem) {
        if walk.emit {
            let code_start = begin(inout walk, E_SECRET_LATENCY);
            put(inout walk, "eff [ConstTime] '");
            put_name(in ctx, inout walk, op);
            put(inout walk, "' on a secret value has data-dependent latency");
            put_in_fn(in ctx, in prog, inout walk);
            finish(
                inout walk,
                code_start,
                "secret division and remainder are variable time; restructure without them",
                node.start,
                node.end
            );
        }
    } else if const_time
        && tainted
        && (
            ctx.world.may_overflow(node.start, node.end)
                || ctx.world.is_partial(node.start, node.end)
        ) {
        if walk.emit {
            let code_start = begin(inout walk, E_SECRET_LATENCY);
            put(inout walk, "eff [ConstTime] checked '");
            put_name(in ctx, inout walk, op);
            put(inout walk, "' on a secret value may abort depending on the secret");
            put_in_fn(in ctx, in prog, inout walk);
            finish(
                inout walk,
                code_start,
                "use wrapping_add, wrapping_sub or wrapping_mul on secrets",
                node.start,
                node.end
            );
        }
    }
    let compare = op == syms.eq
        || op == syms.ne
        || op == syms.lt
        || op == syms.le
        || op == syms.gt
        || op == syms.ge;
    if compare && walk.emit {
        let lhs_ty = ty_of(inout ctx, in prog, in walk, lhs);
        let mut secret_operand = lhs_ty != NONE32 && secret_type(in ctx, inout walk, lhs_ty);
        if !secret_operand {
            let rhs_ty = ty_of(inout ctx, in prog, in walk, rhs);
            secret_operand = rhs_ty != NONE32 && secret_type(in ctx, inout walk, rhs_ty);
        }
        if secret_operand {
            let code_start = begin(inout walk, E_SECRET_PAYLOAD);
            put(inout walk, "secret values cannot be compared with '");
            put_name(in ctx, inout walk, op);
            put(inout walk, "'");
            put_in_fn(in ctx, in prog, inout walk);
            finish(
                inout walk,
                code_start,
                "secret types omit Eq and Ord; compare payloads inside eff [ConstTime] and declassify the verdict",
                node.start,
                node.end
            );
        }
    }
    if has(in walk, DF) && op == syms.rem && walk.emit {
        let lhs_ty = ty_of(inout ctx, in prog, in walk, lhs);
        let rhs_ty = ty_of(inout ctx, in prog, in walk, rhs);
        if is_float_type(in ctx, syms, lhs_ty) || is_float_type(in ctx, syms, rhs_ty) {
            let code_start = begin(inout walk, E_DF_REMAINDER);
            put(
                inout walk,
                "eff [DetFloat] float remainder is not a correctly rounded basic operation"
            );
            put_in_fn(in ctx, in prog, inout walk);
            finish(
                inout walk,
                code_start,
                "only + - * / and comparisons are bit deterministic across targets",
                node.start,
                node.end
            );
        }
    }
}

fn closure(inout ctx: Ctx, in prog: Prog, inout walk: Walk, expr_id: u32, node: ExprNode) -> bool {
    let outer_caps = walk.caps;
    let own_caps = caps_of(in ctx, walk.syms, node.d);
    walk.caps = walk.caps | own_caps;
    let both = DF | CD;
    if walk.caps & both == both && outer_caps & both != both {
        denorm_conflict(in ctx, inout walk, true, 0, node.start, node.end);
    }
    if has(in walk, RT) && walk.emit {
        let tail = row_tail(in ctx, node.d);
        if tail != 0 {
            let code_start = begin(inout walk, E_RT_OPEN_ROW);
            put(inout walk, "eff [Realtime] closure has an open effect row '");
            put_name(in ctx, inout walk, wrapping_sub(tail, 1));
            put(inout walk, "', which may admit blocking effects");
            finish(
                inout walk,
                code_start,
                "list the closure's effects explicitly",
                node.start,
                node.end
            );
        }
        for i in 0..row_len(in ctx, node.d) {
            let effect = row_effect(in ctx, node.d, i);
            if forbidden(in ctx, effect.name) {
                let code_start = begin(inout walk, E_RT_FORBIDDEN_EFFECT);
                put(inout walk, "eff [Realtime] closure carries '");
                put_name(in ctx, inout walk, effect.name);
                put(inout walk, "', which may allocate, block or suspend");
                finish(
                    inout walk,
                    code_start,
                    "realtime rows exclude Alloc, Async, Net, Storage, Scope, locks, Ffi and blocking I/O",
                    node.start,
                    node.end
                );
            }
        }
    }
    let outer_node = walk.node;
    if has(in walk, RT) {
        let graph_node = if outer_node != NONE32 {
            outer_node
        } else {
            node_name(inout ctx, inout walk, "$closure@", node.start)
        };
        add_node(inout walk, graph_node);
        walk.indirect.insert(widen_u64(graph_node));
        walk.node = graph_node;
    }
    walk.returns.push(Ret { ty: node.c, tainted: false });
    open_scope(inout walk);
    for i in 0..w(node.b) {
        let at = add(w(node.a), wrapping_mul(i, ParamWord::Words));
        let name = prog.at(at);
        let ty = prog.at(add(at, ParamWord::Type));
        let secret = secret_type(in ctx, inout walk, ty);
        bind(inout walk, plain(name, secret, ty));
    }
    let body_taint = expr(inout ctx, in prog, inout walk, node.e);
    close_scope(inout walk);
    let returned = pop_return(inout walk);
    let taint = body_taint || returned;
    if has(in walk, CT) && taint && walk.emit {
        let expr_ty = ty_of(inout ctx, in prog, in walk, expr_id);
        let declared_ty = if expr_ty != NONE32 && ctx.types.kind(expr_ty) == TyKind::Fn {
            ctx.types.node(expr_ty).r
        } else if node.c != ctx.types.infer {
            node.c
        } else {
            NONE32
        };
        if declared_ty == NONE32
            || (
                !secret_type(in ctx, inout walk, declared_ty)
                    && !carries_no_information(in ctx, walk.syms, declared_ty)
            ) {
            let tail_node = tail_span(in prog, node.e);
            let code_start = begin(inout walk, E_SECRET_RESULT);
            put(inout walk, "eff [ConstTime] closure returns a secret-derived value as non-secret");
            finish(
                inout walk,
                code_start,
                "wrap the result in a secret type or pass it through an explicit declassify gate",
                tail_node.start,
                tail_node.end
            );
        }
    }
    walk.node = outer_node;
    walk.caps = outer_caps;
    false
}

// The clause j of the handler whose clauses start at pool[at]: (name,
// pats first, pats len, body).
fn clause_at(in prog: Prog, at: u32, j: u64) -> u64 {
    add(inc(w(at)), wrapping_mul(j, ClauseWord::Words))
}

fn handler(inout ctx: Ctx, in prog: Prog, inout walk: Walk, node: ExprNode) -> bool {
    let effect_name = node.a;
    if has(in walk, RT) && walk.emit {
        if forbidden(in ctx, effect_name) {
            let code_start = begin(inout walk, E_RT_FORBIDDEN_EFFECT);
            put(inout walk, "eff [Realtime] body handles '");
            put_name(in ctx, inout walk, effect_name);
            put(inout walk, "', which may allocate, block or suspend");
            finish(
                inout walk,
                code_start,
                "move this handler outside the realtime callback",
                node.start,
                node.end
            );
        } else {
            let decl_index = prog.decl_of(effect_name);
            if decl_index != NONE32 && prog.decl(decl_index).linear {
                let code_start = begin(inout walk, E_RT_RESUMABLE_HANDLER);
                put(inout walk, "eff [Realtime] body installs a resumable handler for '");
                put_name(in ctx, inout walk, effect_name);
                put(inout walk, "'; its continuation may need a suspended fiber stack");
                finish(
                    inout walk,
                    code_start,
                    "realtime bodies may only handle abortive effects such as Fail",
                    node.start,
                    node.end
                );
            }
        }
    }
    let has_state = node.b != NONE32;
    let mut state_taint = has_state && expr(inout ctx, in prog, inout walk, node.c);
    open_scope(inout walk);
    let body_taint = expr(inout ctx, in prog, inout walk, node.d);
    close_scope(inout walk);
    let clauses = w(prog.at(w(node.e)));
    let ret_clause = clause_at(in prog, node.e, 0);
    let ret_first = prog.at(inc(ret_clause));
    let ret_len = prog.at(add(ret_clause, ClauseWord::PatsLen));
    let ret_body = prog.at(add(ret_clause, ClauseWord::Body));
    let mut resume_result = false;
    let mut taint = body_taint;
    for round in 0..HANDLER_ROUNDS {
        let ops_taint = op_clauses(
            inout ctx,
            in prog,
            inout walk,
            node,
            has_state,
            state_taint,
            resume_result
        );
        let state_before = state_taint;
        if has_state && ops_taint {
            state_taint = true;
        }
        let final_state = has_state && state_taint;
        open_scope(inout walk);
        let mut pair_bound = false;
        if has_state && ret_len == STATE_PAIR_LEN {
            bind_pattern(inout ctx, in prog, inout walk, prog.at(w(ret_first)), body_taint, NONE32);
            bind_pattern(
                inout ctx,
                in prog,
                inout walk,
                prog.at(inc(w(ret_first))),
                final_state,
                NONE32
            );
            pair_bound = true;
        } else if has_state && ret_len == 1 {
            let pat_node = prog.pat(prog.at(w(ret_first)));
            if pat_node.kind == PAT_TUPLE && pat_node.b == STATE_PAIR_LEN {
                bind_pattern(
                    inout ctx,
                    in prog,
                    inout walk,
                    prog.at(w(pat_node.a)),
                    body_taint,
                    NONE32
                );
                bind_pattern(
                    inout ctx,
                    in prog,
                    inout walk,
                    prog.at(inc(w(pat_node.a))),
                    final_state,
                    NONE32
                );
                pair_bound = true;
            }
        }
        if !pair_bound {
            for i in 0..w(ret_len) {
                bind_pattern(
                    inout ctx,
                    in prog,
                    inout walk,
                    prog.at(add(w(ret_first), i)),
                    body_taint || final_state,
                    NONE32
                );
            }
        }
        let ret_taint = expr(inout ctx, in prog, inout walk, ret_body);
        close_scope(inout walk);
        taint = body_taint || ops_taint || ret_taint;
        if taint == resume_result && state_taint == state_before {
            break;
        }
        resume_result = resume_result || taint;
    }
    taint
}

fn op_clauses(
    inout ctx: Ctx,
    in prog: Prog,
    inout walk: Walk,
    node: ExprNode,
    has_state: bool,
    state_taint: bool,
    resume_result: bool
) -> bool {
    let effect_name = node.a;
    let is_bus = effect_name == walk.syms.rtbus;
    let outer_caps = walk.caps;
    let outer_node = walk.node;
    if is_bus {
        walk.caps = walk.caps | RT;
        let bus_node = node_name(inout ctx, inout walk, "$rtbus@", node.start);
        add_node(inout walk, bus_node);
        walk.node = bus_node;
    }
    let clause_count = w(prog.at(w(node.e)));
    let decl_index = prog.decl_of(effect_name);
    let mut taint = false;
    for j in 1..clause_count {
        let clause = clause_at(in prog, node.e, j);
        let op_name = prog.at(clause);
        let pats_at = prog.at(inc(clause));
        let pat_count = w(prog.at(add(clause, ClauseWord::PatsLen)));
        let body = prog.at(add(clause, ClauseWord::Body));
        open_scope(inout walk);
        for i in 0..pat_count {
            let pat = prog.at(add(w(pats_at), i));
            if inc(i) == pat_count {
                let pat_node = prog.pat(pat);
                if pat_node.kind == PAT_BIND {
                    bind(
                        inout walk,
                        Local {
                            name: pat_node.a,
                            tainted: false,
                            lexical: true,
                            public: false,
                            ty: NONE32,
                            resume_eff: effect_name,
                            resume_op: op_name,
                            result_taint: resume_result,
                            takes_state: has_state
                        }
                    );
                }
            } else {
                // Operation arguments are secret only when their declared
                // type is; state carries its own taint.
                let op_index = prog.find_op(decl_index, op_name);
                let mut secret = false;
                if op_index != NONE32 {
                    let op = prog.op(w(op_index));
                    if i < w(op.param_count) {
                        secret = secret_type(
                            in ctx,
                            inout walk,
                            prog.param(add(w(op.param_start), i)).ty
                        );
                    }
                }
                bind_pattern(
                    inout ctx,
                    in prog,
                    inout walk,
                    pat,
                    secret || (has_state && state_taint),
                    NONE32
                );
            }
        }
        let body_taint = expr(inout ctx, in prog, inout walk, body);
        close_scope(inout walk);
        taint = taint || body_taint;
    }
    walk.caps = outer_caps;
    walk.node = outer_node;
    taint
}

fn callee(kind: u8, index: u32, decl: u32, ty: u32, lexical: bool) -> Callee {
    Callee { kind: kind, index: index, decl: decl, ty: ty, lexical: lexical }
}

// `Walker::resolve`.
fn resolve(inout ctx: Ctx, in prog: Prog, inout walk: Walk, expr_id: u32) -> Callee {
    let node = prog.expr(expr_id);
    if node.kind == EXPR_NAME {
        let name = node.a;
        let local_index = local(in walk, name);
        if local_index != NONE32 {
            let ty = ty_of(inout ctx, in prog, in walk, expr_id);
            return callee(C_VALUE, NONE32, NONE32, ty, local_at(in walk, local_index).lexical);
        }
        if ctor(in ctx, inout walk, name) != NO_CTOR {
            return callee(C_CONSTRUCTOR, NONE32, NONE32, NONE32, false);
        }
        if wrapping_intrinsic(in ctx, name) {
            return callee(C_INTRINSIC, NONE32, NONE32, NONE32, false);
        }
        let fun_index = prog.lookup(name);
        if fun_index != NONE32 {
            return callee(C_FUNCTION, fun_index, NONE32, NONE32, false);
        }
        if other_intrinsic(in ctx, name) {
            return callee(C_INTRINSIC, NONE32, NONE32, NONE32, false);
        }
        let size = ctx.names.size(name);
        let colons = find_colons(in ctx, name, 0);
        if colons < size {
            let effect_name = sub_sym(in ctx, inout walk, name, 0, colons);
            let op_name = sub_sym(in ctx, inout walk, name, add(colons, PATH_SEP_LEN), size);
            let decl_index = prog.decl_of(effect_name);
            let op_index = prog.find_op(decl_index, op_name);
            if op_index != NONE32 {
                return callee(C_EFFECT_OP, op_index, decl_index, NONE32, false);
            }
        }
        return callee(C_UNKNOWN, NONE32, NONE32, NONE32, false);
    }
    if node.kind == EXPR_FIELD {
        let base_node = prog.expr(node.a);
        if base_node.kind == EXPR_NAME && local(in walk, base_node.a) == NONE32 {
            let func = prog.fun(walk.fun_index);
            for i in 0..row_len(in ctx, func.row) {
                let effect = row_effect(in ctx, func.row, i);
                if effect.label != 0 && wrapping_sub(effect.label, 1) == base_node.a {
                    let decl_index = prog.decl_of(effect.name);
                    let op_index = prog.find_op(decl_index, node.b);
                    if op_index != NONE32 {
                        return callee(C_EFFECT_OP, op_index, decl_index, NONE32, false);
                    }
                    break;
                }
            }
        }
        let base_ty = ty_of(inout ctx, in prog, in walk, node.a);
        if base_ty != NONE32 && ctx.types.kind(base_ty) == TyKind::Named {
            walk.scratch.clear();
            ctx.names.write(ctx.types.name(base_ty), inout walk.scratch);
            walk.scratch.push(COLON);
            walk.scratch.push(COLON);
            ctx.names.write(node.b, inout walk.scratch);
            let key = ctx.names.lookup(in walk.scratch.as_slice());
            let fun_index = prog.lookup(key);
            if fun_index != NONE32 {
                return callee(C_FUNCTION, fun_index, NONE32, NONE32, false);
            }
        }
        let callee_ty = ty_of(inout ctx, in prog, in walk, expr_id);
        if callee_ty != NONE32 && ctx.types.kind(callee_ty) == TyKind::Fn {
            return callee(C_VALUE, NONE32, NONE32, callee_ty, false);
        }
        return callee(C_UNKNOWN, NONE32, NONE32, NONE32, false);
    }
    let ty = ty_of(inout ctx, in prog, in walk, expr_id);
    callee(C_VALUE, NONE32, NONE32, ty, false)
}

// `Walker::secret_into_place`.
fn secret_into_place(
    inout ctx: Ctx,
    in prog: Prog,
    inout walk: Walk,
    root: u32,
    start: u64,
    end: u64
) {
    let const_time = has(in walk, CT);
    let local_index = local(in walk, root);
    let public = local_index != NONE32 && local_at(in walk, local_index).public;
    let func = prog.fun(walk.fun_index);
    let mut param_inout = false;
    let mut param_index = NONE32;
    for i in 0..w(func.param_count) {
        let param = prog.param(add(w(func.param_start), i));
        if param.name == root {
            if param.pass == TyPass::Inout {
                param_inout = true;
            }
            if param_index == NONE32 {
                param_index = n32(i);
            }
        }
    }
    let named = prog.lookup(func.name) != NONE32
        && !walk.summaries.addr_taken.has(widen_u64(func.name));
    if const_time && public && param_inout && named && param_index != NONE32 {
        walk.found.outputs.insert(pair(func.name, param_index));
    } else if const_time && public && param_inout && walk.emit {
        let code_start = begin(inout walk, E_SECRET_TO_PUBLIC);
        put(
            inout walk,
            "eff [ConstTime] writes a secret-derived value into public inout parameter '"
        );
        put_name(in ctx, inout walk, root);
        put(inout walk, "'");
        finish(
            inout walk,
            code_start,
            "give the parameter a secret type or declassify explicitly",
            start,
            end
        );
    }
    if local_index != NONE32 {
        let mut binding = local_at(in walk, local_index);
        binding.tainted = true;
        set_local(inout walk, local_index, binding);
    }
}

// `Walker::call` at call node `node` (expression `expr_id`).
fn call(inout ctx: Ctx, in prog: Prog, inout walk: Walk, expr_id: u32, node: ExprNode) -> bool {
    let callee_node = prog.expr(node.a);
    let callee_taint = if callee_node.kind == EXPR_FIELD {
        expr(inout ctx, in prog, inout walk, callee_node.a)
    } else if callee_node.kind == EXPR_NAME {
        let local_index = local(in walk, callee_node.a);
        local_index != NONE32 && local_at(in walk, local_index).tainted
    } else {
        expr(inout ctx, in prog, inout walk, node.a)
    };
    let resolved = resolve(inout ctx, in prog, inout walk, node.a);
    let receiver = callee_node.kind == EXPR_FIELD && resolved.kind == C_FUNCTION;
    let arg_count = w(node.c);
    let mut taints: ChunkSeq[bool] = ChunkSeq::with_capacity[bool](arg_count);
    let mut any_arg = false;
    for i in 0..arg_count {
        let taint = expr(inout ctx, in prog, inout walk, arg_expr(in prog, node, i));
        taints.push(taint);
        any_arg = any_arg || taint;
    }
    let any = callee_taint && receiver || any_arg;
    if resolved.kind == C_CONSTRUCTOR {
        return any;
    }
    if resolved.kind == C_INTRINSIC {
        if any && has(in walk, CT) && ctx.world.may_overflow(node.start, node.end) && walk.emit {
            let code_start = begin(inout walk, E_SECRET_LATENCY);
            put(
                inout walk,
                "eff [ConstTime] checked conversion of a secret value may abort depending on the secret"
            );
            put_in_fn(in ctx, in prog, inout walk);
            finish(
                inout walk,
                code_start,
                "use wrapping_k conversions on secrets",
                node.start,
                node.end
            );
        }
        return any;
    }
    if resolved.kind == C_FUNCTION {
        return call_function(
            inout ctx,
            in prog,
            inout walk,
            node,
            callee_node,
            resolved.index,
            receiver,
            callee_taint,
            in taints,
            any
        );
    }
    if resolved.kind == C_EFFECT_OP {
        effect_op(inout ctx, in prog, inout walk, node, resolved.decl, resolved.index, in taints);
        let decl_name = prog.decl(resolved.decl).name;
        let op_name = prog.op(w(resolved.index)).name;
        return any || walk.summaries.resumed.has(pair(decl_name, op_name));
    }
    if resolved.kind == C_VALUE {
        return call_value(
            inout ctx,
            in prog,
            inout walk,
            node,
            callee_node,
            resolved.ty,
            resolved.lexical,
            in taints,
            any
        );
    }
    if walk.caps != 0 && walk.emit {
        let code_start = begin(inout walk, E_UNRESOLVED_CALLEE);
        put(inout walk, "eff [");
        put_caps(inout walk, walk.caps);
        put(inout walk, "] body calls a callee that cannot be resolved statically");
        finish(
            inout walk,
            code_start,
            "call a named function carrying the capability",
            node.start,
            node.end
        );
    }
    any
}

fn arg_expr(in prog: Prog, node: ExprNode, i: u64) -> u32 {
    prog.at(add(w(node.b), inc(wrapping_mul(i, PAIR_WORDS))))
}

fn call_function(
    inout ctx: Ctx,
    in prog: Prog,
    inout walk: Walk,
    node: ExprNode,
    callee_node: ExprNode,
    fun_index: u32,
    receiver: bool,
    callee_taint: bool,
    in taints: ChunkSeq[bool],
    any: bool
) -> bool {
    let func = prog.fun(fun_index);
    walk.direct_callees.push(func.name);
    edge(inout walk, func.name, node.start, node.end);
    require_carried(in ctx, in prog, inout walk, func.name, func.carried, node.start, node.end);
    let mut vars = vars_new();
    call_vars(in prog, node.start, node.end, inout vars);
    let callee_ct = caps_of(in ctx, walk.syms, func.row) & CT != 0;
    // The flows: the receiver (when the callee is a method), then the
    // arguments, against the substituted parameter types.
    let shift: u64 = if receiver { 1 } else { 0 };
    let flows = add(w(node.c), shift);
    for param_index in 0..flows {
        if param_index >= w(func.param_count) {
            break;
        }
        let (taint, arg) = if receiver && param_index == 0 {
            (callee_taint, callee_node.a)
        } else {
            let j = wrapping_sub(param_index, shift);
            (bool_at(in taints, j), arg_expr(in prog, node, j))
        };
        let param_ty = substitute(
            inout ctx.types,
            prog.param(add(w(func.param_start), param_index)).ty,
            in vars
        );
        coerce(inout ctx, in prog, inout walk, arg, param_ty);
        if taint && has(in walk, CT) && !secret_type(in ctx, inout walk, param_ty) {
            if callee_ct {
                walk.found.inferred.insert(pair(func.name, n32(param_index)));
            } else if walk.emit {
                let arg_node = prog.expr(arg);
                let code_start = begin(inout walk, E_SECRET_TO_PUBLIC);
                put(
                    inout walk,
                    "eff [ConstTime] passes a secret-derived value to public parameter '"
                );
                put_ty(in ctx, inout walk, param_ty);
                put(inout walk, "' of '");
                put_name(in ctx, inout walk, func.name);
                put(inout walk, "'");
                finish(
                    inout walk,
                    code_start,
                    "give the parameter a secret type, or declassify explicitly",
                    arg_node.start,
                    arg_node.end
                );
            }
        }
    }
    // `inout` arguments the callee writes secrets into are secret after.
    let lo = walk.summaries.outputs.lower(pair(func.name, 0));
    let hi = walk.summaries.outputs.lower(pair(inc32_(func.name), 0));
    for key_index in lo..hi {
        let param_index = walk.summaries.outputs.get(key_index) % HIGH_UNIT;
        if param_index < flows {
            let arg = if receiver && param_index == 0 {
                callee_node.a
            } else {
                arg_expr(in prog, node, wrapping_sub(param_index, shift))
            };
            let root = place_root(in prog, arg);
            if root != NONE32 {
                let arg_node = prog.expr(arg);
                secret_into_place(
                    inout ctx,
                    in prog,
                    inout walk,
                    root,
                    arg_node.start,
                    arg_node.end
                );
            }
        }
    }
    if is_declassify_gate(in ctx, func.name) && callee_ct {
        false
    } else {
        any
    }
}

fn inc32_(value: u32) -> u32 {
    wrapping_add(value, 1)
}

fn call_value(
    inout ctx: Ctx,
    in prog: Prog,
    inout walk: Walk,
    node: ExprNode,
    callee_node: ExprNode,
    ty: u32,
    lexical: bool,
    in taints: ChunkSeq[bool],
    any: bool
) -> bool {
    let is_fn = ty != NONE32 && ctx.types.kind(ty) == TyKind::Fn;
    if callee_node.kind == EXPR_NAME {
        let local_index = local(in walk, callee_node.a);
        if local_index != NONE32 {
            let binding = local_at(in walk, local_index);
            if binding.resume_eff != NONE32 {
                // A continuation: resuming with a secret makes the perform
                // sites secret; the call returns the handled result.
                let mut n = taints.len();
                if binding.takes_state && n > 1 {
                    n = wrapping_sub(n, 1);
                }
                let mut secret = false;
                for i in 0..n {
                    secret = secret || bool_at(in taints, i);
                }
                if secret {
                    walk.found.resumed.insert(pair(binding.resume_eff, binding.resume_op));
                }
                if is_fn {
                    for i in 0..w(node.c) {
                        if i >= ctx.types.arity(ty) {
                            break;
                        }
                        coerce(
                            inout ctx,
                            in prog,
                            inout walk,
                            arg_expr(in prog, node, i),
                            ctx.types.arg(ty, i)
                        );
                    }
                }
                return any || binding.result_taint;
            }
        }
    }
    if !lexical {
        edge(inout walk, walk.syms.indirect, node.start, node.end);
    }
    if walk.caps != 0 && !lexical {
        if is_fn {
            let row = ctx.types.node(ty).r2;
            let name = if callee_node.kind == EXPR_NAME {
                callee_node.a
            } else {
                NONE32
            };
            require_carried_row(in ctx, in prog, inout walk, name, row, node.start, node.end);
            if has(in walk, RT) && ctx.types.row(row).tail != 0 && walk.emit {
                let code_start = begin(inout walk, E_RT_OPEN_ROW);
                put(inout walk, "eff [Realtime] calls '");
                put_callee_name(in ctx, inout walk, name);
                put(inout walk, "' through an open effect row");
                finish(
                    inout walk,
                    code_start,
                    "list the function value's effects explicitly",
                    node.start,
                    node.end
                );
            }
        } else if walk.emit {
            let code_start = begin(inout walk, E_UNRESOLVED_CALLEE);
            put(inout walk, "eff [");
            put_caps(inout walk, walk.caps);
            put(inout walk, "] body calls a value whose capabilities cannot be determined");
            finish(
                inout walk,
                code_start,
                "call a named function carrying the capability",
                node.start,
                node.end
            );
        }
    }
    if is_fn {
        for i in 0..w(node.c) {
            if i >= ctx.types.arity(ty) {
                break;
            }
            let arg = arg_expr(in prog, node, i);
            let param_ty = ctx.types.arg(ty, i);
            coerce(inout ctx, in prog, inout walk, arg, param_ty);
            if bool_at(in taints, i)
                && has(in walk, CT)
                && !lexical
                && !secret_type(in ctx, inout walk, param_ty)
                && walk.emit {
                let arg_node = prog.expr(arg);
                let code_start = begin(inout walk, E_SECRET_TO_PUBLIC);
                put(
                    inout walk,
                    "eff [ConstTime] passes a secret-derived value to public parameter '"
                );
                put_ty(in ctx, inout walk, param_ty);
                put(inout walk, "' of a function value");
                finish(
                    inout walk,
                    code_start,
                    "give the parameter a secret type, or declassify explicitly",
                    arg_node.start,
                    arg_node.end
                );
            }
        }
    }
    any
}

fn put_callee_name(in ctx: Ctx, inout walk: Walk, name: u32) {
    if name == NONE32 {
        put(inout walk, "function value");
    } else {
        put_name(in ctx, inout walk, name);
    }
}

// `Walker::effect_op` at call node `node` of operation `op_index` of
// declaration `decl_index`.
fn effect_op(
    inout ctx: Ctx,
    in prog: Prog,
    inout walk: Walk,
    node: ExprNode,
    decl_index: u32,
    op_index: u32,
    in taints: ChunkSeq[bool]
) {
    let decl = prog.decl(decl_index);
    let op = prog.op(w(op_index));
    if decl.name == walk.syms.rtbus && !has(in walk, RT) && walk.emit {
        let code_start = begin(inout walk, E_RTBUS_OUTSIDE_RT);
        put(inout walk, "'RtBus::");
        put_name(in ctx, inout walk, op.name);
        put(inout walk, "' is performed outside eff [Realtime] code");
        put_in_fn(in ctx, in prog, inout walk);
        finish(
            inout walk,
            code_start,
            "the realtime bus is only available to eff [Realtime] callbacks",
            node.start,
            node.end
        );
    }
    if has(in walk, RT) && forbidden(in ctx, decl.name) && walk.emit {
        let code_start = begin(inout walk, E_RT_FORBIDDEN_EFFECT);
        put(inout walk, "eff [Realtime] body performs '");
        put_name(in ctx, inout walk, decl.name);
        put(inout walk, "::");
        put_name(in ctx, inout walk, op.name);
        put(inout walk, "', which may allocate, block or suspend");
        finish(
            inout walk,
            code_start,
            "realtime rows exclude Alloc, Async, Net, Storage, Scope, locks, Ffi and blocking I/O",
            node.start,
            node.end
        );
    }
    if has(in walk, DF) && caps_of(in ctx, walk.syms, op.row) & DF == 0 && walk.emit {
        let mut has_float = mentions_float(in ctx, walk.syms, op.result);
        for i in 0..w(op.param_count) {
            if mentions_float(in ctx, walk.syms, prog.param(add(w(op.param_start), i)).ty) {
                has_float = true;
            }
        }
        if has_float {
            let code_start = begin(inout walk, E_DF_HOST_OP);
            put(inout walk, "eff [DetFloat] calls host-implemented float operation '");
            put_name(in ctx, inout walk, decl.name);
            put(inout walk, "::");
            put_name(in ctx, inout walk, op.name);
            put(inout walk, "', whose rounding is platform dependent");
            finish(
                inout walk,
                code_start,
                "compute the value with DetFloat functions built from + - * /",
                node.start,
                node.end
            );
        }
    }
    if has(in walk, CT) && walk.emit {
        // The effect's generics from the active row, then from the call.
        let mut vars = vars_new();
        let func = prog.fun(walk.fun_index);
        for i in 0..row_len(in ctx, func.row) {
            let effect = row_effect(in ctx, func.row, i);
            if effect.name == decl.name && effect.n == decl.gen_count {
                for j in 0..w(decl.gen_count) {
                    let gen_name = u32_at(in prog.gens, add(w(decl.gen_start), j));
                    vars.set(gen_name, u32_at(in ctx.types.items, add(w(effect.a), j)));
                }
                break;
            }
        }
        call_vars(in prog, node.start, node.end, inout vars);
        for i in 0..w(node.c) {
            if i >= w(op.param_count) {
                break;
            }
            if bool_at(in taints, i) {
                let param_ty = substitute(
                    inout ctx.types,
                    prog.param(add(w(op.param_start), i)).ty,
                    in vars
                );
                if !secret_type(in ctx, inout walk, param_ty) {
                    let arg_node = prog.expr(arg_expr(in prog, node, i));
                    let code_start = begin(inout walk, E_SECRET_TO_PUBLIC);
                    put(
                        inout walk,
                        "eff [ConstTime] passes a secret-derived value to effect operation '"
                    );
                    put_name(in ctx, inout walk, decl.name);
                    put(inout walk, "::");
                    put_name(in ctx, inout walk, op.name);
                    put(inout walk, "'");
                    finish(
                        inout walk,
                        code_start,
                        "handlers are not checked as constant time; pass only secret-typed values",
                        arg_node.start,
                        arg_node.end
                    );
                }
            }
        }
    }
}

// `Walker::require_carried` with the row of effect-row type `row`.
fn require_carried(
    in ctx: Ctx,
    in prog: Prog,
    inout walk: Walk,
    name: u32,
    row: u32,
    start: u64,
    end: u64
) {
    require_caps(in ctx, in prog, inout walk, name, caps_of(in ctx, walk.syms, row), start, end);
}

// The same with a row id (a function type's `r2`).
fn require_carried_row(
    in ctx: Ctx,
    in prog: Prog,
    inout walk: Walk,
    name: u32,
    row: u32,
    start: u64,
    end: u64
) {
    let row_node = ctx.types.row(row);
    let mut carried: u8 = 0;
    for i in 0..w(row_node.n) {
        let effect = ctx.types.effect_at(add(w(row_node.a), i));
        if effect.name == walk.syms.const_time {
            carried = carried | CT;
        } else if effect.name == walk.syms.realtime {
            carried = carried | RT;
        } else if effect.name == walk.syms.det_float {
            carried = carried | DF;
        } else if effect.name == walk.syms.const_denorm {
            carried = carried | CD;
        }
    }
    require_caps(in ctx, in prog, inout walk, name, carried, start, end);
}

fn require_caps(
    in ctx: Ctx,
    in prog: Prog,
    inout walk: Walk,
    name: u32,
    carried: u8,
    start: u64,
    end: u64
) {
    let missing = walk.caps & (carried ^ ALL_CAPS);
    if missing != 0 && walk.emit {
        let code_start = begin(inout walk, E_CALLEE_LACKS_CAPS);
        put(inout walk, "eff [");
        put_caps(inout walk, walk.caps);
        put(inout walk, "] body calls '");
        put_callee_name(in ctx, inout walk, name);
        put(inout walk, "', which does not carry ");
        put_caps(inout walk, missing);
        finish(
            inout walk,
            code_start,
            "a capability body may only call functions that carry the same capability",
            start,
            end
        );
    }
}

fn row_caps(in ctx: Ctx, syms: Syms, row: u32) -> u8 {
    let row_node = ctx.types.row(row);
    let mut out: u8 = 0;
    for i in 0..w(row_node.n) {
        let effect = ctx.types.effect_at(add(w(row_node.a), i));
        if effect.name == syms.const_time {
            out = out | CT;
        } else if effect.name == syms.realtime {
            out = out | RT;
        } else if effect.name == syms.det_float {
            out = out | DF;
        } else if effect.name == syms.const_denorm {
            out = out | CD;
        }
    }
    out
}

// `Walker::coerce`: `value` flows into a position of type `target`.
pub fn coerce(inout ctx: Ctx, in prog: Prog, inout walk: Walk, value: u32, target: u32) {
    if target == NONE32 || ctx.types.kind(target) != TyKind::Fn {
        return;
    }
    let required = row_caps(in ctx, walk.syms, ctx.types.node(target).r2);
    if required == 0 {
        return;
    }
    let value_node = prog.expr(value);
    if value_node.kind == EXPR_BLOCK && value_node.c != NONE32 {
        coerce(inout ctx, in prog, inout walk, value_node.c, target);
        return;
    }
    if value_node.kind == EXPR_IF {
        coerce(inout ctx, in prog, inout walk, value_node.b, target);
        if value_node.c != NONE32 {
            coerce(inout ctx, in prog, inout walk, value_node.c, target);
        }
        return;
    }
    if value_node.kind == EXPR_MATCH {
        for i in 0..w(value_node.c) {
            coerce(
                inout ctx,
                in prog,
                inout walk,
                prog.at(add(w(value_node.b), inc(wrapping_mul(i, PAIR_WORDS)))),
                target
            );
        }
        return;
    }
    if value_node.kind == EXPR_CLOSURE {
        let own_caps = caps_of(in ctx, walk.syms, value_node.d);
        let missing = required & (own_caps ^ ALL_CAPS) & (walk.caps ^ ALL_CAPS);
        if missing != 0 {
            coerce_error(inout walk, missing, value_node.start, value_node.end);
        }
        return;
    }
    // `actual`: 16 marks none.
    let mut actual: u8 = CAPS_NONE;
    let mut lexical = false;
    let local_index = if value_node.kind == EXPR_NAME {
        local(in walk, value_node.a)
    } else {
        NONE32
    };
    if value_node.kind == EXPR_NAME && local_index == NONE32 {
        let fun_index = prog.lookup(value_node.a);
        if fun_index != NONE32 {
            actual = caps_of(in ctx, walk.syms, prog.fun(fun_index).row);
        }
    } else {
        let value_ty = ty_of(inout ctx, in prog, in walk, value);
        if value_ty != NONE32 && ctx.types.kind(value_ty) == TyKind::Fn {
            actual = row_caps(in ctx, walk.syms, ctx.types.node(value_ty).r2);
        }
        lexical = local_index != NONE32 && local_at(in walk, local_index).lexical;
    }
    let have = if actual == CAPS_NONE { 0 } else { actual };
    let mut missing = required & (have ^ ALL_CAPS);
    if lexical {
        missing = missing & (walk.caps ^ ALL_CAPS);
    }
    if missing != 0 {
        coerce_error(inout walk, missing, value_node.start, value_node.end);
    }
}

fn coerce_error(inout walk: Walk, missing: u8, start: u64, end: u64) {
    if !walk.emit {
        return;
    }
    let code_start = begin(inout walk, E_UNCHECKED_FN_VALUE);
    put(inout walk, "this function value is not checked under ");
    put_caps(inout walk, missing);
    put(inout walk, ", which its expected type requires");
    finish(
        inout walk,
        code_start,
        "declare the capability on the closure (|..| -> T eff [..] { .. }) or pass a function carrying it",
        start,
        end
    );
}
