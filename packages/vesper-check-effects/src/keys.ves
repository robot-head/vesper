// Sorted sets of u64 keys: the interprocedural facts (`Summaries`) and the
// small sets the rules keep. A fact keyed by a name and an index is
// symbol * 2^32 + index, so a name's facts are one run of the set.

use @vesper/check-data::util::{
    inc,
    u64_at
};

pub struct Keys {
    v: ChunkSeq[u64],
}

pub fn keys_new() -> Keys {
    Keys {
        v: ChunkSeq::new[u64]()
    }
}

pub fn pair(a: u32, b: u32) -> u64 {
    wrapping_add(wrapping_mul(widen_u64(a), 4294967296), widen_u64(b))
}

impl Keys {
    pub fn len(in self) -> u64 {
        self.v.len()
    }

    pub fn get(in self, i: u64) -> u64 {
        u64_at(in self.v, i)
    }

    // The first index whose key is >= k.
    pub fn lower(in self, k: u64) -> u64 {
        let mut lo: u64 = 0;
        let mut hi = self.v.len();
        loop {
            if lo >= hi {
                break;
            }
            let mid = wrapping_add(lo, wrapping_sub(hi, lo) / 2);
            if u64_at(in self.v, mid) < k {
                lo = inc(mid);
            } else {
                hi = mid;
            }
        }
        lo
    }

    pub fn has(in self, k: u64) -> bool {
        let i = self.lower(k);
        i < self.v.len() && u64_at(in self.v, i) == k
    }

    pub fn insert(inout self, k: u64) {
        let i = self.lower(k);
        if i < self.v.len() && u64_at(in self.v, i) == k {
            return;
        }
        self.v.push(k);
        let mut j = wrapping_sub(self.v.len(), 1);
        loop {
            if j <= i {
                break;
            }
            let prev = u64_at(in self.v, wrapping_sub(j, 1));
            let ok = self.v.try_set(j, prev);
            j = wrapping_sub(j, 1);
        }
        let ok = self.v.try_set(i, k);
    }

    pub fn clear(inout self) {
        self.v.clear();
    }

    pub fn same(in self, in o: Keys) -> bool {
        if self.v.len() != o.v.len() {
            return false;
        }
        for i in 0..self.v.len() {
            if u64_at(in self.v, i) != u64_at(in o.v, i) {
                return false;
            }
        }
        true
    }

    pub fn merge(inout self, in o: Keys) {
        for i in 0..o.v.len() {
            self.insert(u64_at(in o.v, i));
        }
    }

    pub fn assign(inout self, in o: Keys) {
        self.v.clear();
        for i in 0..o.v.len() {
            self.v.push(u64_at(in o.v, i));
        }
    }
}

// `Summaries`: secret-parameter inference, inferred inout outputs, secret
// resumes and address-taken functions.
pub struct Sums {
    inferred: Keys,
    outputs: Keys,
    resumed: Keys,
    addr: Keys,
}

pub fn sums_new() -> Sums {
    Sums {
        inferred: keys_new(),
        outputs: keys_new(),
        resumed: keys_new(),
        addr: keys_new()
    }
}

impl Sums {
    pub fn clear(inout self) {
        self.inferred.clear();
        self.outputs.clear();
        self.resumed.clear();
        self.addr.clear();
    }

    pub fn merge(inout self, in o: Sums) {
        self.inferred.merge(in o.inferred);
        self.outputs.merge(in o.outputs);
        self.resumed.merge(in o.resumed);
        self.addr.merge(in o.addr);
    }

    pub fn assign(inout self, in o: Sums) {
        self.inferred.assign(in o.inferred);
        self.outputs.assign(in o.outputs);
        self.resumed.assign(in o.resumed);
        self.addr.assign(in o.addr);
    }

    pub fn same(in self, in o: Sums) -> bool {
        self
            .inferred
            .same(in o.inferred)
            && self
            .outputs
            .same(in o.outputs)
            && self
            .resumed
            .same(in o.resumed)
            && self
            .addr
            .same(in o.addr)
    }
}
