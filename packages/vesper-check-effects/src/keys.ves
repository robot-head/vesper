// Sorted sets of u64 keys: the interprocedural facts (`Summaries`) and the
// small sets the rules keep. A fact keyed by a name and an index is
// symbol * 2^32 + index, so a name's facts are one run of the set.

use @vesper/check-data::util::{inc, u64_at};

pub struct Keys {
    sorted: ChunkSeq[u64],
}

pub fn keys_new() -> Keys {
    Keys { sorted: ChunkSeq::new[u64]() }
}

pub fn pair(high: u32, low: u32) -> u64 {
    wrapping_add(wrapping_mul(widen_u64(high), 4294967296), widen_u64(low))
}

impl Keys {
    pub fn len(in self) -> u64 {
        self.sorted.len()
    }

    pub fn get(in self, i: u64) -> u64 {
        u64_at(in self.sorted, i)
    }

    // The first index whose key is >= k.
    pub fn lower(in self, key: u64) -> u64 {
        let mut lo: u64 = 0;
        let mut hi = self.sorted.len();
        loop {
            if lo >= hi {
                break;
            }
            let mid = wrapping_add(lo, wrapping_sub(hi, lo) / 2);
            if u64_at(in self.sorted, mid) < key {
                lo = inc(mid);
            } else {
                hi = mid;
            }
        }
        lo
    }

    pub fn has(in self, key: u64) -> bool {
        let i = self.lower(key);
        i < self.sorted.len() && u64_at(in self.sorted, i) == key
    }

    pub fn insert(inout self, key: u64) {
        let i = self.lower(key);
        if i < self.sorted.len() && u64_at(in self.sorted, i) == key {
            return;
        }
        self.sorted.push(key);
        let mut j = wrapping_sub(self.sorted.len(), 1);
        loop {
            if j <= i {
                break;
            }
            let prev = u64_at(in self.sorted, wrapping_sub(j, 1));
            let ok = self.sorted.try_set(j, prev);
            j = wrapping_sub(j, 1);
        }
        let ok = self.sorted.try_set(i, key);
    }

    pub fn clear(inout self) {
        self.sorted.clear();
    }

    pub fn same(in self, in other: Keys) -> bool {
        if self.sorted.len() != other.sorted.len() {
            return false;
        }
        for i in 0..self.sorted.len() {
            if u64_at(in self.sorted, i) != u64_at(in other.sorted, i) {
                return false;
            }
        }
        true
    }

    pub fn merge(inout self, in other: Keys) {
        for i in 0..other.sorted.len() {
            self.insert(u64_at(in other.sorted, i));
        }
    }

    pub fn assign(inout self, in other: Keys) {
        self.sorted.clear();
        for i in 0..other.sorted.len() {
            self.sorted.push(u64_at(in other.sorted, i));
        }
    }
}

// `Summaries`: secret-parameter inference, inferred inout outputs, secret
// resumes and address-taken functions.
pub struct Sums {
    inferred: Keys,
    outputs: Keys,
    resumed: Keys,
    addr_taken: Keys,
}

pub fn sums_new() -> Sums {
    Sums { inferred: keys_new(), outputs: keys_new(), resumed: keys_new(), addr_taken: keys_new() }
}

impl Sums {
    pub fn clear(inout self) {
        self.inferred.clear();
        self.outputs.clear();
        self.resumed.clear();
        self.addr_taken.clear();
    }

    pub fn merge(inout self, in other: Sums) {
        self.inferred.merge(in other.inferred);
        self.outputs.merge(in other.outputs);
        self.resumed.merge(in other.resumed);
        self.addr_taken.merge(in other.addr_taken);
    }

    pub fn assign(inout self, in other: Sums) {
        self.inferred.assign(in other.inferred);
        self.outputs.assign(in other.outputs);
        self.resumed.assign(in other.resumed);
        self.addr_taken.assign(in other.addr_taken);
    }

    pub fn same(in self, in other: Sums) -> bool {
        self.inferred.same(in other.inferred)
            && self.outputs.same(in other.outputs)
            && self.resumed.same(in other.resumed)
            && self.addr_taken.same(in other.addr_taken)
    }
}
