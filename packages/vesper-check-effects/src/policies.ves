// `capability_effects::capability_policies`: extracts Stage 5 verifier
// policy inputs (`ConstTimeInput`, `RealtimeInput`, `DetFloatInput`,
// `ConstDenormInput`) from an accepted world (#1864, part of #1180).

use @vesper/check-data::util::{add, inc, n32, u32_at, w};
use @vesper/check-data::input::{Ctx};
use self::keys::{pair};
use self::prog::{Prog};
use self::walker::{Walk, caps_of, expr, is_declassify_gate, secret_type, start};
use self::check::{cmp_names, push_u32_le, summarise};

const NONE32: u32 = 4294967295;
const CT: u8 = 1;
const RT: u8 = 2;
const DF: u8 = 4;
const CD: u8 = 8;

copy struct RtFunRow {
    name: u32,
    start: u64,
    end: u64,
    row: u32,
}

fn push_name(in ctx: Ctx, inout out: ChunkSeq[u8], name: u32) {
    push_u32_le(inout out, ctx.names.size(name));
    ctx.names.write(name, inout out);
}

fn has_u32(in values: ChunkSeq[u32], value: u32) -> bool {
    for i in 0..values.len() {
        if u32_at(in values, i) == value {
            return true;
        }
    }
    false
}

// Collect sorted, deduplicated direct callee names from `walk.direct_callees`.
fn sorted_callees(in ctx: Ctx, in walk: Walk) -> ChunkSeq[u32] {
    let mut out = ChunkSeq::new[u32]();
    for i in 0..walk.direct_callees.len() {
        let callee = u32_at(in walk.direct_callees, i);
        if !has_u32(in out, callee) {
            out.push(callee);
        }
    }
    // Insertion sort by byte order (matches Rust BTreeSet<String>).
    let n = out.len();
    for i in 1..n {
        let key = u32_at(in out, i);
        let mut j = i;
        loop {
            if j == 0 {
                break;
            }
            let prev = u32_at(in out, wrapping_sub(j, 1));
            if cmp_names(in ctx, prev, key) <= 0 {
                break;
            }
            let _ok = out.try_set(j, prev);
            j = wrapping_sub(j, 1);
        }
        let _ok = out.try_set(j, key);
    }
    out
}

fn push_name_list(in ctx: Ctx, inout out: ChunkSeq[u8], in names: ChunkSeq[u32]) {
    push_u32_le(inout out, names.len());
    for i in 0..names.len() {
        push_name(in ctx, inout out, u32_at(in names, i));
    }
}

fn push_u32_list(inout out: ChunkSeq[u8], in values: ChunkSeq[u32]) {
    push_u32_le(inout out, values.len());
    for i in 0..values.len() {
        push_u32_le(inout out, w(u32_at(in values, i)));
    }
}

pub fn build_policies_bin(
    inout ctx: Ctx,
    in prog: Prog,
    inout walk: Walk,
    inout out: ChunkSeq[u8]
) {
    summarise(inout ctx, in prog, inout walk);
    walk.emit = false;
    let mut ct_buf = ChunkSeq::new[u8]();
    let mut ct_count: u64 = 0;
    let mut rt_funs = ChunkSeq::new[RtFunRow]();
    let mut rt_calls_buf = ChunkSeq::new[u8]();
    let mut rt_calls_count: u64 = 0;
    let mut rt_called = ChunkSeq::new[u32]();
    let mut df_buf = ChunkSeq::new[u8]();
    let mut df_count: u64 = 0;
    let mut cd_buf = ChunkSeq::new[u8]();
    let mut cd_count: u64 = 0;

    for i in 0..prog.funs.len() {
        let func = prog.fun(n32(i));
        let caps = caps_of(in ctx, walk.syms, func.row);
        if caps == 0 {
            continue;
        }
        start(inout ctx, in prog, inout walk, n32(i), caps, true);
        if func.body != NONE32 {
            let _t = expr(inout ctx, in prog, inout walk, func.body);
        }
        let callees = sorted_callees(in ctx, in walk);

        if (caps & CT) != 0 {
            ct_count = inc(ct_count);
            push_name(in ctx, inout ct_buf, func.name);
            push_u32_le(inout ct_buf, func.start);
            push_u32_le(inout ct_buf, func.end);
            let mut secret_params = ChunkSeq::new[u32]();
            let mut inferred_params = ChunkSeq::new[u32]();
            for param_index in 0..w(func.param_count) {
                let param = prog.param(add(w(func.param_start), param_index));
                let is_secret = secret_type(in ctx, inout walk, param.ty);
                let is_inferred = walk.summaries.inferred.has(pair(func.name, n32(param_index)));
                if is_secret || is_inferred {
                    secret_params.push(n32(param_index));
                }
                if !is_secret && is_inferred {
                    inferred_params.push(n32(param_index));
                }
            }
            push_u32_list(inout ct_buf, in secret_params);
            push_u32_list(inout ct_buf, in inferred_params);
            let secret_result: u8 = if secret_type(in ctx, inout walk, func.result) {
                1
            } else {
                0
            };
            let is_gate: u8 = if is_declassify_gate(in ctx, func.name) {
                1
            } else {
                0
            };
            ct_buf.push(secret_result);
            ct_buf.push(is_gate);
            let mut ct_callees = ChunkSeq::new[u32]();
            let mut declassify_callees = ChunkSeq::new[u32]();
            for j in 0..callees.len() {
                let callee = u32_at(in callees, j);
                if is_declassify_gate(in ctx, callee) {
                    declassify_callees.push(callee);
                } else {
                    ct_callees.push(callee);
                }
            }
            push_name_list(in ctx, inout ct_buf, in ct_callees);
            push_name_list(in ctx, inout ct_buf, in declassify_callees);
        }

        if (caps & RT) != 0 {
            for j in 0..callees.len() {
                let callee = u32_at(in callees, j);
                rt_calls_count = inc(rt_calls_count);
                push_name(in ctx, inout rt_calls_buf, func.name);
                push_name(in ctx, inout rt_calls_buf, callee);
                if !has_u32(in rt_called, callee) {
                    rt_called.push(callee);
                }
            }
            rt_funs.push(
                RtFunRow {
                    name: func.name,
                    start: func.start,
                    end: func.end,
                    row: func.row,
                }
            );
        }

        if (caps & CD) != 0 {
            cd_count = inc(cd_count);
            push_name(in ctx, inout cd_buf, func.name);
            push_u32_le(inout cd_buf, func.start);
            push_u32_le(inout cd_buf, func.end);
        }

        if (caps & DF) != 0 {
            df_count = inc(df_count);
            push_name(in ctx, inout df_buf, func.name);
            push_u32_le(inout df_buf, func.start);
            push_u32_le(inout df_buf, func.end);
            push_name_list(in ctx, inout df_buf, in callees);
        }
    }

    push_u32_le(inout out, ct_count);
    out.extend(in ct_buf.as_slice());

    push_u32_le(inout out, rt_funs.len());
    for i in 0..rt_funs.len() {
        match rt_funs.try_get(i) {
            Option::Some(rt_fun) => {
                push_name(in ctx, inout out, rt_fun.name);
                push_u32_le(inout out, rt_fun.start);
                push_u32_le(inout out, rt_fun.end);
                let is_root: u8 = if !has_u32(in rt_called, rt_fun.name) {
                    1
                } else {
                    0
                };
                out.push(is_root);
                let ty_node = ctx.types.node(rt_fun.row);
                let row_node = ctx.types.row(ty_node.r2);
                push_u32_le(inout out, w(row_node.n));
                for ei in 0..w(row_node.n) {
                    let eff = ctx.types.effect_at(add(w(row_node.a), ei));
                    push_name(in ctx, inout out, eff.name);
                }
            },
            Option::None => {},
        }
    }
    push_u32_le(inout out, rt_calls_count);
    out.extend(in rt_calls_buf.as_slice());

    push_u32_le(inout out, df_count);
    out.extend(in df_buf.as_slice());

    push_u32_le(inout out, cd_count);
    out.extend(in cd_buf.as_slice());
}
