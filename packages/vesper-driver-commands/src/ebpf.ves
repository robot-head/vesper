// `vesper ebpf` (`src/ebpf_commands.rs`): CLI subcommand/flag parsing and
// error formatting here; @vesper/ebpf-check reads the ELF, hex or raw
// program, verifies it, bounds its stack and renders the report. Only the
// optional kernel load (`bpf(2)`) still runs in Rust, through
// `@vesper/driver-engines::ebpf_load` (#1996).
use @vesper/driver-engines::{ebpf_load};
use @vesper/driver::{Args, args_count, arg_start, arg_end, eq};
use @vesper/ebpf-check::{check};
use @vesper-std/env::{os, os_windows};
use @vesper-std/fs::{IoError, error_text, read_path, arch, arch_x86_64, arch_aarch64};
use super::{PrintFailed, arg, byte_at, print, fail, stdout_stream};

const BPF_MAX_STACK_BYTES: u64 = 512;
// `sizeof(bpf_user_pt_regs_t)` (`verifier::PT_REGS_SIZE`): the kprobe
// context of the host architecture, 0 where its layout is unknown.
const PT_REGS_X86_64: i64 = 168;
const PT_REGS_AARCH64: i64 = 272;
const PT_REGS_UNKNOWN: i64 = 0;

// The program file's bytes, or `io::Error`'s text.
struct ProgramRead {
    ok: bool,
    bytes: ChunkSeq[u8],
    error: ChunkSeq[u8]
}

fn read_program(in path: Slice[u8]) -> ProgramRead eff [Ffi[StdFs]] {
    handle Fail[IoError] in {
        read_path(in path)
    } with {
        return v => ProgramRead { ok: true, bytes: v, error: ChunkSeq::new[u8]() },
        raise(e, _) => ProgramRead { ok: false, bytes: ChunkSeq::new[u8](), error: error_text(e) },
    }
}

fn pt_regs_size() -> i64 eff [Ffi[StdFs]] {
    let host = arch();
    if host == arch_x86_64() {
        PT_REGS_X86_64
    } else if host == arch_aarch64() {
        PT_REGS_AARCH64
    } else {
        PT_REGS_UNKNOWN
    }
}

// `ebpf_check_impl`: the report on stdout, then the kernel load.
fn ebpf_check(
    in path: Slice[u8],
    load: bool,
    disassemble: bool,
    budget: u64
) -> ChunkSeq[u8] eff [Ffi[StdFs], Ffi[StdEnv], Ffi[HybridCommands], Fail[PrintFailed]] {
    let read = read_program(in path);
    if !read.ok {
        let mut err: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](path.len());
        err.extend(in path);
        err.extend(in ": ".as_bytes());
        err.extend(in read.error.as_slice());
        return err;
    }
    let checked = check(
        in path,
        in read.bytes.as_slice(),
        disassemble,
        budget,
        pt_regs_size(),
        os() == os_windows()
    );
    print(stdout_stream(), in checked.out.as_slice());
    if checked.error.len() != 0 || !load {
        return checked.error;
    }
    ebpf_load(in path)
}

pub fn run_ebpf(
    in args: Args
) -> i64 eff [Ffi[StdFs], Ffi[StdEnv], Ffi[HybridCommands], Fail[PrintFailed]] {
    let n = args_count(in args);
    if n <= 1 {
        print_help();
        return 0;
    }
    let sub_buf = arg(in args, 1);
    let sub = sub_buf.as_slice();
    if eq(in sub, in "-h") || eq(in sub, in "--help") {
        print_help();
        return 0;
    }
    if !eq(in sub, in "check") {
        let mut err: ChunkSeq[u8] = ChunkSeq::new[u8]();
        err.extend(in "unknown ebpf subcommand '".as_bytes());
        err.extend(in sub);
        err.extend(in "'; see vesper ebpf --help".as_bytes());
        return fail(in err.as_slice());
    }
    let mut has_input = false;
    let mut input: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut load = false;
    let mut disassemble = false;
    let mut budget: u64 = BPF_MAX_STACK_BYTES;
    let mut i: u64 = 2;
    loop {
        if i >= n {
            break;
        }
        let arg_buf = arg(in args, i);
        let arg_text = arg_buf.as_slice();
        if eq(in arg_text, in "-h") || eq(in arg_text, in "--help") {
            print_help();
            return 0;
        } else if eq(in arg_text, in "--load") {
            load = true;
        } else if eq(in arg_text, in "--disassemble") {
            disassemble = true;
        } else if eq(in arg_text, in "--stack-budget") {
            i = wrapping_add(i, 1);
            if i >= n {
                return fail(in "--stack-budget requires a byte count".as_bytes());
            }
            let value_buf = arg(in args, i);
            match parse_u64_decimal(in value_buf.as_slice()) {
                Option::Some(parsed) => budget = parsed,
                Option::None => return fail(in "--stack-budget requires a byte count".as_bytes()),
            }
        } else if arg_text.len() != 0 && byte_at(in arg_text, 0) == 45 {
            let mut err: ChunkSeq[u8] = ChunkSeq::new[u8]();
            err.extend(in "unknown ebpf check option '".as_bytes());
            err.extend(in arg_text);
            err.push(39);
            return fail(in err.as_slice());
        } else {
            if has_input {
                return fail(in "only one program is supported".as_bytes());
            }
            has_input = true;
            input.extend(in arg_text);
        }
        i = wrapping_add(i, 1);
    }
    if !has_input {
        return fail(in "missing program; see vesper ebpf --help".as_bytes());
    }
    let err = ebpf_check(in input.as_slice(), load, disassemble, budget);
    if err.len() == 0 {
        return 0;
    }
    fail(in err.as_slice())
}

fn print_help() eff [Ffi[StdFs], Fail[PrintFailed]] {
    print(
        stdout_stream(),
        in "Usage: vesper ebpf check <object.o | program.bin | program.hex> [--load] [--stack-budget <bytes>]\n\nRun the Vesper eBPF pre-flight verifier and report typed findings.\n\nOptions:\n  --load                 Also load into the kernel where bpf() is permitted (Linux)\n  --stack-budget <bytes> Root stack budget for the stack-bound report (default 512)\n  --disassemble          Print the instructions\n"
            .as_bytes()
    );
}

fn parse_u64_decimal(in digits: Slice[u8]) -> Option[u64] {
    if digits.len() == 0 {
        return Option::None;
    }
    let mut acc: u64 = 0;
    for i in 0..digits.len() {
        let byte = byte_at(in digits, i);
        if byte < 48 || byte > 57 {
            return Option::None;
        }
        let digit = wrapping_sub(widen_u64(byte), 48);
        if acc > 429496729 || (acc == 429496729 && digit > 5) {
            return Option::None;
        }
        acc = wrapping_add(wrapping_mul(acc, 10), digit);
    }
    Option::Some(acc)
}
