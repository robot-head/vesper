// `vesper verify`: CLI option parsing, validation, and `--help` in Vesper,
// delegating Lean formatter-model / extraction verification (`src/verify_commands.rs`)
// to `HybridCommands::hc_verify_run`. (`vesper verify --refute` continues to dispatch
// to `vesper-refute` in `lib.ves`.)
use @vesper/driver::{Args, args_count, eq};
use super::{PrintFailed, arg, byte_at, print, fail, stdout_stream};
use super::proof_audit::{name_valid, forbidden_axiom};

fn print_verify_help() eff [Ffi[StdFs], Fail[PrintFailed]] {
    print(
        stdout_stream(),
        in "Usage: vesper verify SOURCE --format [--json | --emit-lean] [--lean PATH] [--timeout SECONDS]\n       vesper verify SOURCE --extract [--proofs FILE.lean] [--theorem Name ...] [--contract-proof Function=Theorem --contract-witness Function=Theorem ...] [--allow-axiom Name ...] [--olean-store DIR|default] [--json | --emit-lean] [--lean PATH] [--timeout SECONDS]\n\n--format: Kernel-check a formatter document-algebra comment-conservation model with Lean 4.35.0.\n--extract: Extract a Lean 4 proof model from checked .ves source, compile and replay through the Lean 4.35.0 kernel, and audit axioms (sorryAx is always forbidden). Total fuel companions are noncomputable; original recursive executable definitions and their callers are omitted and listed in JSON.\n--proofs joins an explicit Lean proof script containing theorem proofs for the extracted model.\n--theorem selects theorem names to audit (default: theorems discovered in --proofs, or an internal model-compilation witness).\n--contract-proof binds an emitted function contract to a theorem; when used, every emitted contract must be covered. Each binding requires --contract-witness for the generated existential input precondition. This checks model partial correctness and inhabited input preconditions, not termination or native-code correspondence. Explicit contract admission permits only the three standard Lean axioms.\n--allow-axiom permits named axioms such as propext, Quot.sound, or Classical.choice.\n--olean-store stores audited .olean artifacts and compares cache hits with a fresh compilation in a Loom CAS directory (`default` is ~/.vesper/store).\n--emit-lean prints the generated Lean source only after compilation and kernel replay.\n--timeout bounds each Lean process (1 to 300 seconds; default 30).\nThe selected Lean toolchain and artifact parser remain trusted.\n"
            .as_bytes()
    );
}

fn has_flag_before_sep(in args: Args, n: u64, in flag: Str) -> bool {
    let mut i: u64 = 1;
    loop {
        if i >= n {
            return false;
        }
        let arg_buf = arg(in args, i);
        let arg_text = arg_buf.as_slice();
        if eq(in arg_text, in "--") {
            return false;
        }
        if eq(in arg_text, in flag) {
            return true;
        }
        i = wrapping_add(i, 1);
    }
    false
}

fn has_help_before_sep(in args: Args, n: u64) -> bool {
    let mut i: u64 = 1;
    loop {
        if i >= n {
            return false;
        }
        let arg_buf = arg(in args, i);
        let arg_text = arg_buf.as_slice();
        if eq(in arg_text, in "--") {
            return false;
        }
        if eq(in arg_text, in "--help") || eq(in arg_text, in "-h") {
            return true;
        }
        i = wrapping_add(i, 1);
    }
    false
}

fn fail_verify(
    has_json: bool,
    has_extract: bool,
    in message: Slice[u8]
) -> i64 eff [Ffi[StdFs], Ffi[HybridCommands], Fail[PrintFailed]] {
    if has_json {
        HybridCommands::hc_verify_json_err(has_extract, in message);
    }
    let mut full: ChunkSeq[u8] = ChunkSeq::new[u8]();
    if has_extract {
        full.extend(in "Lean extraction verification failed: ".as_bytes());
    } else {
        full.extend(in "formatter model verification failed: ".as_bytes());
    }
    full.extend(in message);
    fail(in full.as_slice())
}

fn parse_timeout_1_to_300(in text: Slice[u8]) -> bool {
    if text.len() == 0 {
        return false;
    }
    let mut seconds: u64 = 0;
    for i in 0..text.len() {
        let byte = byte_at(in text, i);
        if byte < 48 || byte > 57 {
            return false;
        }
        if seconds > 300 {
            return false;
        }
        seconds = wrapping_add(wrapping_mul(seconds, 10), widen_u64(wrapping_sub(byte, 48)));
    }
    seconds >= 1 && seconds <= 300
}

fn contains_dot(in text: Slice[u8]) -> bool {
    for i in 0..text.len() {
        if byte_at(in text, i) == 46 {
            return true;
        }
    }
    false
}

fn allowed_contract_axiom(in name: Slice[u8]) -> bool {
    eq(in name, in "propext") || eq(in name, in "Classical.choice") || eq(in name, in "Quot.sound")
}

fn pack_args(in args: Args, n: u64) -> ChunkSeq[u8] {
    let mut packed: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut i: u64 = 1;
    loop {
        if i >= n {
            break;
        }
        let arg_buf = arg(in args, i);
        packed.extend(in arg_buf.as_slice());
        packed.push(0);
        i = wrapping_add(i, 1);
    }
    packed
}

fn run_packed(
    in args: Args,
    n: u64
) -> i64 eff [Ffi[StdFs], Ffi[HybridCommands], Fail[PrintFailed]] {
    let packed = pack_args(in args, n);
    let err_len = HybridCommands::hc_verify_run(in packed.as_slice());
    if err_len == 0 {
        return 0;
    }
    let mut err: ChunkSeq[u8] = ChunkSeq::new[u8]();
    err.resize(err_len, 0);
    let actual = HybridCommands::hc_verify_err(inout err.as_slice_mut());
    if actual > err.len() {
        err.resize(actual, 0);
        let _got = HybridCommands::hc_verify_err(inout err.as_slice_mut());
    } else {
        err.truncate(actual);
    }
    fail(in err.as_slice())
}

pub fn run_verify(in args: Args) -> i64 eff [Ffi[StdFs], Ffi[HybridCommands], Fail[PrintFailed]] {
    let n = args_count(in args);
    if has_help_before_sep(in args, n) {
        print_verify_help();
        return 0;
    }
    let has_json = has_flag_before_sep(in args, n, in "--json");
    let has_extract = has_flag_before_sep(in args, n, in "--extract");
    let arg_count = wrapping_sub(n, 1);
    let mut total_bytes: u64 = 0;
    for k in 1..n {
        let arg_buf = arg(in args, k);
        total_bytes = wrapping_add(total_bytes, arg_buf.as_slice().len());
    }
    if arg_count > 300 || total_bytes > 32768 {
        return fail_verify(
            has_json,
            has_extract,
            in "verification argument limit exceeded".as_bytes()
        );
    }
    let mut has_source = false;
    let mut format = false;
    let mut extract = false;
    let mut has_proofs = false;
    let mut has_theorem = false;
    let mut has_contract = false;
    let mut has_disallowed_contract_axiom = false;
    let mut has_allowed_axiom = false;
    let mut has_olean_store = false;
    let mut json = false;
    let mut emit_lean = false;
    let mut has_lean = false;
    let mut has_timeout = false;
    let mut positional = false;
    let mut i: u64 = 1;
    loop {
        if i >= n {
            break;
        }
        let arg_buf = arg(in args, i);
        let arg_text = arg_buf.as_slice();
        if !positional {
            if eq(in arg_text, in "--format") {
                if format {
                    return fail_verify(has_json, has_extract, in "duplicate --format".as_bytes());
                }
                format = true;
                i = wrapping_add(i, 1);
                continue;
            }
            if eq(in arg_text, in "--extract") {
                if extract {
                    return fail_verify(has_json, has_extract, in "duplicate --extract".as_bytes());
                }
                extract = true;
                i = wrapping_add(i, 1);
                continue;
            }
            if eq(in arg_text, in "--proofs") {
                if has_proofs {
                    return fail_verify(has_json, has_extract, in "duplicate --proofs".as_bytes());
                }
                i = wrapping_add(i, 1);
                if i >= n {
                    return fail_verify(
                        has_json,
                        has_extract,
                        in "--proofs requires a path".as_bytes()
                    );
                }
                let proofs_buf = arg(in args, i);
                if proofs_buf.as_slice().len() > 4096 {
                    return fail_verify(
                        has_json,
                        has_extract,
                        in "invalid --proofs path".as_bytes()
                    );
                }
                has_proofs = true;
                i = wrapping_add(i, 1);
                continue;
            }
            if eq(in arg_text, in "--theorem") {
                i = wrapping_add(i, 1);
                if i >= n {
                    return fail_verify(
                        has_json,
                        has_extract,
                        in "--theorem requires a name".as_bytes()
                    );
                }
                let name_buf = arg(in args, i);
                let lean_name = name_buf.as_slice();
                if !name_valid(in lean_name) {
                    let mut err: ChunkSeq[u8] = ChunkSeq::new[u8]();
                    err.extend(in "invalid theorem name '".as_bytes());
                    err.extend(in lean_name);
                    err.push(39);
                    return fail_verify(has_json, has_extract, in err.as_slice());
                }
                has_theorem = true;
                i = wrapping_add(i, 1);
                continue;
            }
            if eq(in arg_text, in "--contract-proof") || eq(in arg_text, in "--contract-witness") {
                i = wrapping_add(i, 1);
                if i >= n {
                    let mut err: ChunkSeq[u8] = ChunkSeq::new[u8]();
                    err.extend(in arg_text);
                    err.extend(in " requires Function=Theorem".as_bytes());
                    return fail_verify(has_json, has_extract, in err.as_slice());
                }
                let binding_buf = arg(in args, i);
                let binding = binding_buf.as_slice();
                let mut eq_idx: u64 = binding.len();
                for j in 0..binding.len() {
                    if byte_at(in binding, j) == 61 {
                        eq_idx = j;
                        break;
                    }
                }
                if eq_idx == binding.len() {
                    let mut err: ChunkSeq[u8] = ChunkSeq::new[u8]();
                    err.extend(in arg_text);
                    err.extend(in " requires Function=Theorem".as_bytes());
                    return fail_verify(has_json, has_extract, in err.as_slice());
                }
                let func = binding[0..eq_idx];
                let theorem_name = binding[wrapping_add(eq_idx, 1)..binding.len()];
                if !name_valid(in func) || contains_dot(in func) || !name_valid(in theorem_name) {
                    return fail_verify(
                        has_json,
                        has_extract,
                        in "invalid contract proof binding".as_bytes()
                    );
                }
                has_contract = true;
                i = wrapping_add(i, 1);
                continue;
            }
            if eq(in arg_text, in "--allow-axiom") {
                i = wrapping_add(i, 1);
                if i >= n {
                    return fail_verify(
                        has_json,
                        has_extract,
                        in "--allow-axiom requires a name".as_bytes()
                    );
                }
                let name_buf = arg(in args, i);
                let lean_name = name_buf.as_slice();
                if !name_valid(in lean_name) {
                    let mut err: ChunkSeq[u8] = ChunkSeq::new[u8]();
                    err.extend(in "invalid axiom name '".as_bytes());
                    err.extend(in lean_name);
                    err.push(39);
                    return fail_verify(has_json, has_extract, in err.as_slice());
                }
                if forbidden_axiom(in lean_name) {
                    let mut err: ChunkSeq[u8] = ChunkSeq::new[u8]();
                    err.extend(in lean_name);
                    err.extend(in " cannot be allowed by the audit policy".as_bytes());
                    return fail_verify(has_json, has_extract, in err.as_slice());
                }
                if !allowed_contract_axiom(in lean_name) {
                    has_disallowed_contract_axiom = true;
                }
                has_allowed_axiom = true;
                i = wrapping_add(i, 1);
                continue;
            }
            if eq(in arg_text, in "--olean-store") {
                if has_olean_store {
                    return fail_verify(
                        has_json,
                        has_extract,
                        in "duplicate --olean-store".as_bytes()
                    );
                }
                i = wrapping_add(i, 1);
                if i >= n {
                    return fail_verify(
                        has_json,
                        has_extract,
                        in "--olean-store requires a path".as_bytes()
                    );
                }
                let store_buf = arg(in args, i);
                let store_path = store_buf.as_slice();
                if store_path.len() == 0 || store_path.len() > 4096 {
                    return fail_verify(
                        has_json,
                        has_extract,
                        in "invalid --olean-store path".as_bytes()
                    );
                }
                has_olean_store = true;
                i = wrapping_add(i, 1);
                continue;
            }
            if eq(in arg_text, in "--json") {
                json = true;
                i = wrapping_add(i, 1);
                continue;
            }
            if eq(in arg_text, in "--emit-lean") {
                emit_lean = true;
                i = wrapping_add(i, 1);
                continue;
            }
            if eq(in arg_text, in "--lean") {
                if has_lean {
                    return fail_verify(has_json, has_extract, in "duplicate --lean".as_bytes());
                }
                i = wrapping_add(i, 1);
                if i >= n {
                    return fail_verify(
                        has_json,
                        has_extract,
                        in "--lean requires a path".as_bytes()
                    );
                }
                let lean_buf = arg(in args, i);
                let lean_path = lean_buf.as_slice();
                if lean_path.len() == 0 || lean_path.len() > 4096 {
                    return fail_verify(
                        has_json,
                        has_extract,
                        in "invalid Lean executable path".as_bytes()
                    );
                }
                has_lean = true;
                i = wrapping_add(i, 1);
                continue;
            }
            if eq(in arg_text, in "--timeout") {
                if has_timeout {
                    return fail_verify(has_json, has_extract, in "duplicate --timeout".as_bytes());
                }
                i = wrapping_add(i, 1);
                if i >= n {
                    return fail_verify(
                        has_json,
                        has_extract,
                        in "--timeout requires seconds".as_bytes()
                    );
                }
                let timeout_buf = arg(in args, i);
                if !parse_timeout_1_to_300(in timeout_buf.as_slice()) {
                    return fail_verify(
                        has_json,
                        has_extract,
                        in "--timeout must be between 1 and 300 seconds".as_bytes()
                    );
                }
                has_timeout = true;
                i = wrapping_add(i, 1);
                continue;
            }
            if eq(in arg_text, in "--") {
                positional = true;
                i = wrapping_add(i, 1);
                continue;
            }
            if arg_text.len() != 0 && byte_at(in arg_text, 0) == 45 {
                return fail_verify(
                    has_json,
                    has_extract,
                    in "unknown verification option".as_bytes()
                );
            }
        }
        if arg_text.len() > 4096 || has_source {
            return fail_verify(
                has_json,
                has_extract,
                in "verify accepts one bounded source path".as_bytes()
            );
        }
        has_source = true;
        i = wrapping_add(i, 1);
    }
    if format && extract {
        return fail_verify(
            has_json,
            has_extract,
            in "--format and --extract cannot be combined".as_bytes()
        );
    }
    if !format && !extract {
        return fail_verify(
            has_json,
            has_extract,
            in "--format or --extract is required; see vesper verify --help".as_bytes()
        );
    }
    if format
        && (has_proofs || has_theorem || has_contract || has_allowed_axiom || has_olean_store) {
        return fail_verify(
            has_json,
            has_extract,
            in "--proofs, --theorem, --contract-proof, --contract-witness, --allow-axiom, and --olean-store require --extract"
                .as_bytes()
        );
    }
    if has_contract && has_disallowed_contract_axiom {
        return fail_verify(
            has_json,
            has_extract,
            in "explicit contract admission only permits propext, Classical.choice, and Quot.sound"
                .as_bytes()
        );
    }
    if json && emit_lean {
        return fail_verify(
            has_json,
            has_extract,
            in "--json and --emit-lean cannot be combined".as_bytes()
        );
    }
    if !has_source {
        return fail_verify(has_json, has_extract, in "verify requires a source file".as_bytes());
    }
    run_packed(in args, n)
}
