// @vesper/driver-commands: the `vesper` CLI's routing beyond the compile
// path, in Vesper (self-hosting SH5 lane 13, #1336). The hybrid compiler's
// driver (crates/vesper-hybrid/modules/driver) hands every command that is
// not `check`, `run`, `jit`, `build` or `emit` to `run` below, which either
// finishes it and returns the exit code, or returns `delegate()` so that
// the Rust CLI runs it.
//
// Part 1 is everything in front of the command layers: no arguments,
// `--help`/`-h`, `--version`/`-V`, the unknown-command error, and the tool
// dispatch of src/tool_commands.rs (`vesper <tool>` runs `vesper-<tool>`
// beside the executable or on `PATH`, with the same arguments, streams and
// exit status). The compiler's own commands (`COMPILER_COMMANDS` in
// src/main.rs) are handed back; docs/parallel-results/
// self-host-cli-commands.md lists each with its lane or blocker.
use @vesper/driver::{Args, args_count, arg_start, arg_end, eq};
use @vesper-std/env::{var_bytes, current_exe_bytes, os, os_linux, os_macos, os_windows};
use @vesper-std/process::{command_path, arg_bytes as proc_arg, spawn, wait, release};
use @vesper-std/fs::{
    IoError, error_text, write_stdout, write_stderr, is_executable_path, canonicalize_path, arch,
    arch_x86_64, arch_aarch64, arch_wasm32, not_found, symlink_metadata, symlink_metadata_path,
    kind_dir, kind_file, Opened, read_nofollow_limit, same_file, create_staged, remove_staged,
    rename_path, process_id
};
use @vesper-std/fs::walk::{Entries, entry_count, entry_start, entry_end, entry_kind, list_dir_path};
use @vesper/fmt::{
    FmtFail, format, format_recovery, recovery_ok, recovery_error, recovery_output,
    recovery_changed, recovery_edits, fail_code, fail_offset
};
use self::graph::{run_graph};
use self::forge::{run_forge};
use self::ebpf::{run_ebpf};
use self::test::{run_test};
use self::doc::{run_doc};
use self::lint::{run_lint};
use self::proof_audit::{run_proof_audit};
use self::verify::{run_verify};
use self::lsp::{run_lsp};

enum Ascii: _ {
    LineFeed = 10,
    DoubleQuote = 34,
    RightParen = 41,
    Dash = 45,
    Dot = 46,
    Slash = 47,
    Digit0 = 48,
    Digit9 = 57,
    Colon = 58,
    Question = 63,
    Semicolon = 59,
    UpperA = 65,
    UpperZ = 90,
    Backslash = 92,
    Underscore = 95,
    LowerA = 97,
    LowerZ = 122,
    NonAsciiStart = 128,
}

const ERROR_TEXT_INITIAL_BYTES: u64 = 128;
const SIGNAL_EXIT_BASE: i64 = 128;
// The status of a Rust program whose `main` panicked.
const PANIC_EXIT: i64 = 101;

// `run`'s result when the Rust CLI should run the command instead (the
// driver's `delegate()`).
pub fn delegate() -> i64 {
    -1
}

pub fn stdout_stream() -> u32 {
    1
}

fn stderr_stream() -> u32 {
    2
}

// The CLI's version (`env!("CARGO_PKG_VERSION")` of the workspace).
fn cli_version() -> Str {
    "0.1.0"
}

// ---------------------------------------------------------------------------
// Dispatch.

// The exit code of the command in `args` (every argument after the
// program name), or `delegate()`.
pub fn run(
    in args: Args
) -> i64 eff [Ffi[StdFs], Ffi[StdEnv], Ffi[StdProcess], Ffi[Blake3], Ffi[HybridCommands]] {
    handle Fail[PrintFailed] in {
        route(in args)
    } with {
        return v => v,
        raise(failure, _) => print_panic(failure),
    }
}

fn route(
    in args: Args
) -> i64 eff [
    Ffi[StdFs],
    Ffi[StdEnv],
    Ffi[StdProcess],
    Ffi[Blake3],
    Ffi[HybridCommands],
    Fail[PrintFailed]
] {
    let n = args_count(in args);
    if n == 0 {
        print(stdout_stream(), in cli_help().as_bytes());
        return 0;
    }
    let command = arg(in args, 0);
    let command_name = command.as_slice();
    // A command with a byte outside ASCII is never a tool's, and the Rust
    // CLI decides what it is (it panics on one that is not UTF-8).
    if !ascii(in command_name) {
        return delegate();
    }
    // `tool_commands::dispatch` leaves options and the compiler's own
    // commands to the CLI.
    if byte_at(in command_name, 0) == Ascii::Dash {
        if eq(in command_name, in "--help") || eq(in command_name, in "-h") {
            print(stdout_stream(), in cli_help().as_bytes());
            return 0;
        }
        if eq(in command_name, in "--version") || eq(in command_name, in "-V") {
            return version();
        }
        return unknown_command(in command_name);
    }
    if eq(in command_name, in "fmt") {
        return fmt(in args);
    }
    if eq(in command_name, in "graph") {
        return run_graph(in args);
    }
    if eq(in command_name, in "forge") {
        return run_forge(in args);
    }
    if eq(in command_name, in "ebpf") {
        return run_ebpf(in args);
    }
    if eq(in command_name, in "test") {
        return run_test(in args);
    }
    if eq(in command_name, in "doc") {
        return run_doc(in args);
    }
    if eq(in command_name, in "lint") {
        return run_lint(in args);
    }
    if eq(in command_name, in "proof-audit") {
        return run_proof_audit(in args);
    }
    if eq(in command_name, in "verify") {
        if has_arg(in args, in "--refute") {
            let found = locate(in "refute".as_bytes());
            if found.len() == 0 {
                return missing(in "refute".as_bytes());
            }
            return run_tool(in found.as_slice(), in args);
        }
        return run_verify(in args);
    }
    if eq(in command_name, in "lsp") {
        return run_lsp(in args);
    }
    if compiler_command(in command_name) {
        return delegate();
    }
    if !tool(in command_name) {
        // Unknown commands keep the compiler's error unless a tool exists.
        if !tool_name(in command_name) {
            return unknown_command(in command_name);
        }
        let found = locate(in command_name);
        if found.len() == 0 {
            return unknown_command(in command_name);
        }
        return run_tool(in found.as_slice(), in args);
    }
    let found = locate(in command_name);
    if found.len() == 0 {
        return missing(in command_name);
    }
    run_tool(in found.as_slice(), in args)
}

// Whether every byte of `text` is ASCII.
fn ascii(in text: Slice[u8]) -> bool {
    for i in 0..text.len() {
        if byte_at(in text, i) >= Ascii::NonAsciiStart {
            return false;
        }
    }
    true
}

// `COMPILER_COMMANDS` of src/main.rs: the commands the compiler binary runs
// itself (the compile commands never reach `run`).
fn compiler_command(in command: Slice[u8]) -> bool {
    eq(in command, in "build")
        || eq(in command, in "check")
        || eq(in command, in "doc")
        || eq(in command, in "ebpf")
        || eq(in command, in "emit")
        || eq(in command, in "fmt")
        || eq(in command, in "forge")
        || eq(in command, in "graph")
        || eq(in command, in "jit")
        || eq(in command, in "lint")
        || eq(in command, in "lsp")
        || eq(in command, in "proof-audit")
        || eq(in command, in "run")
        || eq(in command, in "test")
        || eq(in command, in "verify")
}

// `tool_commands::TOOLS`: subcommands served by `vesper-<name>` binaries.
fn tool(in command: Slice[u8]) -> bool {
    eq(in command, in "attest")
        || eq(in command, in "audit")
        || eq(in command, in "bench")
        || eq(in command, in "cas")
        || eq(in command, in "fuzz")
        || eq(in command, in "grammar")
        || eq(in command, in "highlight")
        || eq(in command, in "json")
        || eq(in command, in "migrate")
        || eq(in command, in "publish")
        || eq(in command, in "replay")
        || eq(in command, in "resolve")
        || eq(in command, in "sbom")
        || eq(in command, in "semver")
        || eq(in command, in "shot")
        || eq(in command, in "simd")
        || eq(in command, in "top")
        || eq(in command, in "traceparent")
}

// A name an external `vesper-<name>` may have: nonempty ASCII letters,
// digits, `-` and `_`.
fn tool_name(in name: Slice[u8]) -> bool {
    if name.len() == 0 {
        return false;
    }
    for i in 0..name.len() {
        let byte = byte_at(in name, i);
        let allowed = (byte >= Ascii::Digit0 && byte <= Ascii::Digit9)
            || ascii_letter(byte)
            || byte == Ascii::Dash
            || byte == Ascii::Underscore;
        if !allowed {
            return false;
        }
    }
    true
}

// ---------------------------------------------------------------------------
// Shared helpers.

pub fn arg(in args: Args, i: u64) -> ChunkSeq[u8] {
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let start = arg_start(in args, i);
    let end = arg_end(in args, i);
    out.extend(in args.bytes[start..end]);
    out
}

pub fn byte_at(in bytes: Slice[u8], i: u64) -> u8 {
    match bytes.try_get(i) {
        Option::Some(byte) => byte,
        Option::None => 0,
    }
}

// A failed write to a standard stream: Rust's `print!`/`eprint!` panics
// (`failed printing to stdout: <e>`), which ends the CLI with status 101.
pub copy struct PrintFailed {
    pub stream: u32,
    pub error: IoError,
}

// `print!("{}", String::from_utf8_lossy(text))` on stdout, or `eprint!` on
// stderr: the bytes go straight to the stream (Rust's stdout flushes every
// line, and every text printed here ends one), and a failed write raises
// `PrintFailed`, which `run` turns into Rust's panic.
pub fn print(stream: u32, in text: Slice[u8]) eff [Ffi[StdFs], Fail[PrintFailed]] {
    if utf8(in text) {
        write_stream(stream, in text);
    } else {
        let fixed = lossy(in text);
        write_stream(stream, in fixed.as_slice());
    }
}

fn write_stream(stream: u32, in text: Slice[u8]) eff [Ffi[StdFs], Fail[PrintFailed]] {
    handle Fail[IoError] in {
        if stream == stderr_stream() {
            write_stderr(in text);
        } else {
            write_stdout(in text);
        }
    } with {
        return v => v,
        raise(e, _) => Fail::raise(PrintFailed { stream: stream, error: e }),
    }
}

// `String::from_utf8_lossy`: each maximal ill-formed subpart of `bytes`
// becomes U+FFFD (as `Utf8Chunks` splits it).
pub fn lossy(in bytes: Slice[u8]) -> ChunkSeq[u8] {
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut i: u64 = 0;
    loop {
        if i >= bytes.len() {
            break;
        }
        let lead = byte_at(in bytes, i);
        if lead < Ascii::NonAsciiStart {
            out.push(lead);
            i = wrapping_add(i, 1);
            continue;
        }
        let mut cont_count: u64 = 0;
        let mut lo: u8 = 128;
        let mut hi: u8 = 191;
        if lead >= 194 && lead <= 223 {
            cont_count = 1;
        } else if lead == 224 {
            cont_count = 2;
            lo = 160;
        } else if (lead >= 225 && lead <= 236) || lead == 238 || lead == 239 {
            cont_count = 2;
        } else if lead == 237 {
            cont_count = 2;
            hi = 159;
        } else if lead == 240 {
            cont_count = 3;
            lo = 144;
        } else if lead >= 241 && lead <= 243 {
            cont_count = 3;
        } else if lead == 244 {
            cont_count = 3;
            hi = 143;
        }
        // The bytes of the longest valid prefix of a sequence.
        let mut prefix_len: u64 = 1;
        if cont_count != 0 {
            loop {
                if prefix_len > cont_count {
                    break;
                }
                let cont_at = wrapping_add(i, prefix_len);
                if cont_at >= bytes.len() {
                    break;
                }
                let cont_byte = byte_at(in bytes, cont_at);
                let in_range = if prefix_len == 1 {
                    cont_byte >= lo && cont_byte <= hi
                } else {
                    cont_byte >= 128 && cont_byte <= 191
                };
                if !in_range {
                    break;
                }
                prefix_len = wrapping_add(prefix_len, 1);
            }
        }
        if cont_count != 0 && prefix_len == wrapping_add(cont_count, 1) {
            out.extend(in bytes[i..wrapping_add(i, prefix_len)]);
        } else {
            out.push(239);
            out.push(191);
            out.push(189);
        }
        i = wrapping_add(i, prefix_len);
    }
    out
}

// Rust's panic for a failed `print!`, as the CLI's panic hook writes it,
// and the status a panicking `main` exits with. A failed write of the
// message itself is ignored, as the hook ignores it.
fn print_panic(failure: PrintFailed) -> i64 eff [Ffi[StdFs]] {
    let mut message: ChunkSeq[u8] = ChunkSeq::new[u8]();
    message.extend(
        in "thread 'vesper' panicked at library/std/src/io/stdio.rs:\nfailed printing to "
            .as_bytes()
    );
    if failure.stream == stderr_stream() {
        message.extend(in "stderr: ".as_bytes());
    } else {
        message.extend(in "stdout: ".as_bytes());
    }
    let detail = error_text(failure.error);
    message.extend(in detail.as_slice());
    message.extend(
        in "\nnote: run with `RUST_BACKTRACE=1` environment variable to display a backtrace\n"
            .as_bytes()
    );
    handle Fail[IoError] in {
        write_stderr(in message.as_slice());
    } with {
        return v => v,
        raise(_, _) => (),
    }
    PANIC_EXIT
}

// `vesper: <message>` on stderr (`main`'s `Err` arm); exit code 1.
pub fn fail(in message: Slice[u8]) -> i64 eff [Ffi[StdFs], Fail[PrintFailed]] {
    let mut line: ChunkSeq[u8] = ChunkSeq::new[u8]();
    line.extend(in "vesper: ".as_bytes());
    line.extend(in message);
    line.push(Ascii::LineFeed);
    print(stderr_stream(), in line.as_slice());
    1
}

// `unknown command '<command>'; see --help` (the end of `cli()`).
fn unknown_command(in command: Slice[u8]) -> i64 eff [Ffi[StdFs], Fail[PrintFailed]] {
    let mut message: ChunkSeq[u8] = ChunkSeq::new[u8]();
    message.extend(in "unknown command '".as_bytes());
    message.extend(in command);
    message.extend(in "'; see --help".as_bytes());
    fail(in message.as_slice())
}

// The host's copy-out protocol: whether `buf` had to grow (call again);
// otherwise `buf` is cut to the length. `none` is set for a negative
// length (no text).
fn grown(host_len: i64, inout buf: ChunkSeq[u8], inout none: bool) -> bool {
    if host_len < 0 {
        buf.truncate(0);
        none = true;
        return false;
    }
    let len = wrapping_u64(host_len);
    if len > buf.len() {
        buf.resize(len, 0);
        return true;
    }
    buf.truncate(len);
    false
}

// Rust's `Display` of the `io::Error` with this error word (the kind in
// the low byte, the OS error in the high half): @vesper-std/fs's text.
pub fn io_error_text(word: u64) -> ChunkSeq[u8] eff [Ffi[StdFs]] {
    error_text(IoError {
        kind: wrapping_u32(word & 255),
        os: wrapping_u32(word >> 32),
    })
}

// ---------------------------------------------------------------------------
// `--version` (`format_version_banner` in src/main.rs).

fn version() -> i64 eff [Ffi[StdFs], Fail[PrintFailed]] {
    let mut banner: ChunkSeq[u8] = ChunkSeq::new[u8]();
    banner.extend(in "  \\\\    //   vesper ".as_bytes());
    banner.extend(in cli_version().as_bytes());
    banner.extend(in " (stage3-ddc)\n   \\\\  //    target: ".as_bytes());
    banner.extend(in arch_name().as_bytes());
    banner.push(Ascii::Dash);
    banner.extend(in os_name().as_bytes());
    banner.extend(
        in " (cranelift + lean4)\n    \\\\||/    modes: copy <= affine <= linear | 0 sorryAx\n     \\/\n"
            .as_bytes()
    );
    print(stdout_stream(), in banner.as_slice());
    0
}

// `std::env::consts::ARCH` and `OS` of the host.
fn arch_name() -> Str {
    let host_arch = arch();
    if host_arch == arch_x86_64() {
        "x86_64"
    } else if host_arch == arch_aarch64() {
        "aarch64"
    } else if host_arch == arch_wasm32() {
        "wasm32"
    } else {
        ""
    }
}

fn os_name() -> Str {
    let host_os = os();
    if host_os == os_linux() {
        "linux"
    } else if host_os == os_macos() {
        "macos"
    } else if host_os == os_windows() {
        "windows"
    } else {
        "wasi"
    }
}

// The help of the CLI (`HELP` in src/main.rs; the CLI tests compare the
// two byte for byte).
fn cli_help() -> Str {
    "Vesper — modal ownership and lexical effects\n\nUsage: vesper <command> [FILE|DIR] [options]   (most commands take one .ves file; check/run/jit/build/emit also take a package directory with a Loom.toml; see vesper <command> --help)\n\nCommands:\n  forge   Check and expand explicit source Expr macros (forge --help)\n  grammar Validate canonical protocol bytes and Arrow IPC\n  verify  Kernel-check formatter document models (--format), or refute a contract (--refute)\n  fuzz    Crucible fuzzing of a source function (fuzz --help)\n  migrate Lift C/Rust signatures into .ves/.vsys (migrate --help)\n  replay  Verify and replay a Chrono .vchrono bundle (replay --help)\n  ebpf    Pre-flight verify an eBPF program (ebpf check --help)\n  fmt     Format supported source without changing tokens/comments\n  highlight  Chroma semantic highlighting: --html, --ansi, --json, --css (highlight --help)\n  shot    Render an SVG or 1x-4x PNG code card (shot --help)\n  lint    Analyze checked source and validate supported fixes\n  doc     Generate checked API docs, heatmaps and a search bundle (doc --help)\n  test    Run unit tests, or run doctests with --doc\n  bench   Measure finite scalar source kernels (bench --help)\n  check   Check types, effects, ownership, and places\n  run     Execute with the one-shot effect stack machine\n  jit     Execute native code with Cranelift\n  build   Compile and link a native executable (-o <path>), or a C-ABI library (--lib)\n  emit    Emit cst, hir, ir, clif, object, lean, or interface (--emit <kind>)\n  resolve Resolve or validate a locked local Loom catalog\n  graph   Inspect a solution snapshot (see graph --help)\n  sbom    Emit a CycloneDX snapshot inventory (see sbom --help)\n  audit   Audit declared dependencies against local policies (see audit --help)\n  top     Inspect Pulse fiber telemetry and linear obligations (top --help)\n  publish Run offline release gates and publish to a local CAS (publish --help)\n  json    Validate bounded JSON documents (see json --help)\n  traceparent  Validate W3C TraceContext v00 (see traceparent --help)\n  simd    Run the native byte scanner (see simd --help)\n  proof-audit  Kernel-replay local Lean artifacts (see proof-audit --help)\n  attest  Verify and import configured-key signed artifacts (see attest --help)\n  cas     Ingest, verify and materialize local content (see cas --help)\n  semver  Compare baseline and candidate interface JSON files\n  lsp     Serve incremental diagnostics over stdio\n\nOptions:\n  -o <path>       Output file (stdout for textual output by default)\n  --emit <kind>   Output format (default: ir)\n  --package <id>  Interface namespace (@org/name or std/name)\n  --entry <name>  Entry function (default: main)\n  --include-tests  check/run/jit: enable test-only declarations\n  --fuel <steps>  Evaluation step limit (default: 10000000)\n  --target <triple>  Object/executable target (default: host)\n  --target-features <list>  With --target: CPU features to use, as Rust's names (ssse3,avx2,...; cargo's CARGO_CFG_TARGET_FEATURE)\n  --linker <path>    Linker for build (default: cc)\n  --link-search <dir>  build: a directory the linker searches for .vsys libraries (repeatable)\n  --codegen verified  build: direct verified code generator (scalar subset, no Cranelift)\n  --no-opt       Disable equality saturation (both optimizers)\n  --no-ast-opt   run/jit/emit: disable only the AST optimizer\n  --no-ir-opt    run/jit/emit: disable only the IR optimizer\n  --verify=<list>    Run Stage-5 verifiers on emitted Cranelift (const-time,stack,realtime,detfloat,all)\n  --verify-<name>    One verifier (--verify-const-time, --verify-stack, ...)\n  --verify-policy <file>  Verifier policy JSON (vesper.native-verifiers/1)\n  --lib          build: a C-ABI library object (--lib-name, --interface, --rust-binding, --rust-types, --instance f[T])\n  --tee          build: write the TDX RTMR / CCA REM measurement of the executable\n  --json         Machine-readable diagnostics\n  -h, --help     Show help\n  -V, --version  Show version\n"
}

// ---------------------------------------------------------------------------
// Tool dispatch (src/tool_commands.rs).

// `binary_name`: `vesper-<tool>` plus the host's executable suffix.
fn binary_name(in subcommand: Slice[u8]) -> ChunkSeq[u8] eff [Ffi[StdEnv]] {
    let mut name: ChunkSeq[u8] = ChunkSeq::new[u8]();
    name.extend(in "vesper-".as_bytes());
    name.extend(in subcommand);
    if os() == os_windows() {
        name.extend(in ".exe".as_bytes());
    }
    name
}

fn is_separator(byte: u8, windows: bool) -> bool {
    byte == Ascii::Slash || (windows && byte == Ascii::Backslash)
}

// `Path::join` of a relative `name`: an empty directory gives the name,
// and a separator is added unless the directory ends with one.
pub fn join(in dir: Slice[u8], in name: Slice[u8], windows: bool) -> ChunkSeq[u8] {
    let mut path: ChunkSeq[u8] = ChunkSeq::new[u8]();
    path.extend(in dir);
    // `PathBuf::push` adds no separator after an ordinary bare drive (`C:`):
    // `C:vesper-x.exe` is relative to drive C's current directory, not its
    // root. A verbatim drive (`\\?\C:`) is not `is_drive()` and does get `\`.
    if windows && bare_drive(in dir) {
        path.extend(in name);
        return path;
    }
    if dir.len() != 0 && !is_separator(byte_at(in dir, wrapping_sub(dir.len(), 1)), windows) {
        if windows {
            path.push(Ascii::Backslash);
        } else {
            path.push(Ascii::Slash);
        }
    }
    path.extend(in name);
    path
}

// Whether `dir` is an ordinary Windows drive prefix and nothing else: `X:`
// (`Prefix::Disk`, with `X` an ASCII letter; the only prefix `is_drive()` accepts).
fn bare_drive(in dir: Slice[u8]) -> bool {
    dir.len() == 2 && ascii_letter(byte_at(in dir, 0)) && byte_at(in dir, 1) == Ascii::Colon
}

fn ascii_letter(byte: u8) -> bool {
    (byte >= Ascii::UpperA && byte <= Ascii::UpperZ)
        || (byte >= Ascii::LowerA && byte <= Ascii::LowerZ)
}

fn same(in a: Slice[u8], in b: Slice[u8]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for i in 0..a.len() {
        if byte_at(in a, i) != byte_at(in b, i) {
            return false;
        }
    }
    true
}

// `is_executable`: a regular file (following links), with an execute bit
// on Unix.
fn executable(in path: Slice[u8]) -> bool eff [Ffi[StdFs]] {
    is_executable_path(in path)
}

// `Path::parent` of the executable's path: everything before its last
// component, without the separators (and `.` components) before that;
// none for a root or an empty path.
fn parent(in path: Slice[u8], windows: bool, inout none: bool) -> ChunkSeq[u8] {
    let root = root_len(in path, windows);
    let verbatim = windows && starts_verbatim(in path);
    let mut end = trim_back(in path, path.len(), root, windows, verbatim);
    if end <= root {
        none = true;
        return ChunkSeq::new[u8]();
    }
    loop {
        if end <= root || is_sep(byte_at(in path, wrapping_sub(end, 1)), windows, verbatim) {
            break;
        }
        end = wrapping_sub(end, 1);
    }
    end = trim_back(in path, end, root, windows, verbatim);
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    out.extend(in path[0..end]);
    out
}

fn is_sep(byte: u8, windows: bool, verbatim: bool) -> bool {
    if verbatim {
        byte == Ascii::Backslash
    } else {
        is_separator(byte, windows)
    }
}

// `path[..end]` without trailing separators and `.` components, keeping the
// first `root` bytes.
fn trim_back(in path: Slice[u8], end: u64, root: u64, windows: bool, verbatim: bool) -> u64 {
    let mut trimmed_end = end;
    loop {
        if trimmed_end <= root {
            break;
        }
        let last = byte_at(in path, wrapping_sub(trimmed_end, 1));
        if is_sep(last, windows, verbatim) {
            trimmed_end = wrapping_sub(trimmed_end, 1);
        } else if !verbatim
            && last == Ascii::Dot
            && (wrapping_sub(trimmed_end, 1) == root
                || is_sep(byte_at(in path, wrapping_sub(trimmed_end, 2)), windows, verbatim))
        {
            // A `.` component, unless it is the path's first (`./x` keeps it).
            if wrapping_sub(trimmed_end, 1) == 0 {
                break;
            }
            trimmed_end = wrapping_sub(trimmed_end, 1);
        } else {
            break;
        }
    }
    trimmed_end
}

fn starts_verbatim(in path: Slice[u8]) -> bool {
    path.len() >= 4
        && byte_at(in path, 0) == Ascii::Backslash
        && byte_at(in path, 1) == Ascii::Backslash
        && byte_at(in path, 2) == Ascii::Question
        && byte_at(in path, 3) == Ascii::Backslash
}

// The bytes of the prefix and root of `path`: `/` on Unix; `X:`, `X:\`,
// `\\?\X:\` or `\` on Windows.
fn root_len(in path: Slice[u8], windows: bool) -> u64 {
    if !windows {
        if path.len() != 0 && byte_at(in path, 0) == Ascii::Slash {
            return 1;
        }
        return 0;
    }
    let mut n: u64 = 0;
    if starts_verbatim(in path) {
        n = 4;
        if path.len() >= 6
            && ascii_letter(byte_at(in path, 4))
            && byte_at(in path, 5) == Ascii::Colon
        {
            n = 6;
        }
        if n < path.len() && byte_at(in path, n) == Ascii::Backslash {
            n = wrapping_add(n, 1);
        }
        return n;
    }
    if path.len() >= 2 && ascii_letter(byte_at(in path, 0)) && byte_at(in path, 1) == Ascii::Colon {
        n = 2;
    }
    if n < path.len() && is_separator(byte_at(in path, n), true) {
        n = wrapping_add(n, 1);
    }
    n
}

// The directory of `env::current_exe()` (`canonical`: of its canonical
// path), and whether there is none.
fn exe_parent_dir(canonical: bool, inout none: bool) -> ChunkSeq[u8] eff [Ffi[StdFs], Ffi[StdEnv]] {
    let windows = os() == os_windows();
    let exe = handle Fail[IoError] in {
        let exe_path = current_exe_bytes();
        if canonical {
            Option::Some(canonicalize_path(in exe_path.as_slice()))
        } else {
            Option::Some(exe_path)
        }
    } with {
        return v => v,
        raise(_, _) => Option::None,
    };
    match exe {
        Option::Some(exe_path) => parent(in exe_path.as_slice(), windows, inout none),
        Option::None => {
            none = true;
            ChunkSeq::new[u8]()
        },
    }
}

// The candidates in one directory beside the executable: Cargo puts the
// tools beside `vesper`, Bazel at `<bin>/crates/vesper-tools/bin/`.
fn in_exe_dir(
    in dir: Slice[u8],
    in name: Slice[u8],
    windows: bool
) -> ChunkSeq[u8] eff [Ffi[StdFs]] {
    let direct = join(in dir, in name, windows);
    if executable(in direct.as_slice()) {
        return direct;
    }
    let tools = join(in dir, in "../crates/vesper-tools/bin".as_bytes(), windows);
    let bazel = join(in tools.as_slice(), in name, windows);
    if executable(in bazel.as_slice()) {
        return bazel;
    }
    ChunkSeq::new[u8]()
}

// `env::split_paths` of one entry boundary: Unix splits on `:`; Windows
// on `;` outside double quotes, and drops the quotes.
fn path_entries(in path: Slice[u8], windows: bool) -> ChunkSeq[u64] {
    // Each entry as (start, end) into `path`; quotes are stripped later.
    let mut spans: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut start: u64 = 0;
    let mut quoted = false;
    for i in 0..path.len() {
        let byte = byte_at(in path, i);
        if windows && byte == Ascii::DoubleQuote {
            quoted = !quoted;
        } else if (!windows && byte == Ascii::Colon)
            || (windows && !quoted && byte == Ascii::Semicolon)
        {
            spans.push(start);
            spans.push(i);
            start = wrapping_add(i, 1);
        }
    }
    spans.push(start);
    spans.push(path.len());
    spans
}

fn span_at(in spans: Slice[u64], i: u64) -> u64 {
    match spans.try_get(i) {
        Option::Some(offset) => offset,
        Option::None => 0,
    }
}

// `locate`: the tool's executable, or empty when there is none.
fn locate(in subcommand: Slice[u8]) -> ChunkSeq[u8] eff [Ffi[StdFs], Ffi[StdEnv]] {
    let windows = os() == os_windows();
    let name = binary_name(in subcommand);
    let mut no_exe = false;
    let exe_dir = exe_parent_dir(false, inout no_exe);
    if !no_exe {
        let found = in_exe_dir(in exe_dir.as_slice(), in name.as_slice(), windows);
        if found.len() != 0 {
            return found;
        }
        // A symlinked `vesper` (an install prefix, a Bazel runfiles tree)
        // also finds tools beside its target.
        let mut no_canonical = false;
        let canonical = exe_parent_dir(true, inout no_canonical);
        if !no_canonical && !same(in canonical.as_slice(), in exe_dir.as_slice()) {
            let found = in_exe_dir(in canonical.as_slice(), in name.as_slice(), windows);
            if found.len() != 0 {
                return found;
            }
        }
    }
    let path = match var_bytes(in "PATH") {
        Option::Some(path_value) => path_value,
        Option::None => return ChunkSeq::new[u8](),
    };
    let spans = path_entries(in path.as_slice(), windows);
    let count = spans.len() / 2;
    for k in 0..count {
        let span_start = span_at(in spans.as_slice(), wrapping_mul(k, 2));
        let span_end = span_at(in spans.as_slice(), wrapping_add(wrapping_mul(k, 2), 1));
        let mut dir: ChunkSeq[u8] = ChunkSeq::new[u8]();
        for i in span_start..span_end {
            let byte = byte_at(in path.as_slice(), i);
            if !(windows && byte == Ascii::DoubleQuote) {
                dir.push(byte);
            }
        }
        let candidate = join(in dir.as_slice(), in name.as_slice(), windows);
        if executable(in candidate.as_slice()) {
            return candidate;
        }
    }
    ChunkSeq::new[u8]()
}

fn has_arg(in args: Args, in needle: Str) -> bool {
    let n = args_count(in args);
    for i in 1..n {
        let arg_buf = arg(in args, i);
        if eq(in arg_buf.as_slice(), in needle) {
            return true;
        }
    }
    false
}

// `missing`: a known tool whose binary is not there.
fn missing(in subcommand: Slice[u8]) -> i64 eff [Ffi[StdFs], Fail[PrintFailed]] {
    let mut message: ChunkSeq[u8] = ChunkSeq::new[u8]();
    message.extend(in "`vesper ".as_bytes());
    message.extend(in subcommand);
    message.extend(in "` is provided by the `vesper-".as_bytes());
    message.extend(in subcommand);
    message.extend(
        in "` tool, which was not found next to the vesper executable or on PATH; build it with `cargo build -p vesper-tools` (or `bazel build //crates/vesper-tools:all`) and install it beside vesper"
            .as_bytes()
    );
    fail(in message.as_slice())
}

// `run` and `exit_code`: the tool with the arguments after the command,
// inheriting the standard streams; its exit code, 128 plus the signal that
// killed it, or 1.
fn run_tool(
    in binary: Slice[u8],
    in args: Args
) -> i64 eff [Ffi[StdFs], Ffi[StdProcess], Fail[PrintFailed]] {
    let mut command = command_path(in binary);
    let n = args_count(in args);
    for i in 1..n {
        let arg_buf = arg(in args, i);
        proc_arg(inout command, in arg_buf.as_slice());
    }
    let mut child = match spawn(command) {
        Result::Ok(child) => child,
        Result::Err(e) => return spawn_failed(in binary, e),
    };
    let waited = wait(inout child);
    release(child);
    match waited {
        Result::Ok(status) => {
            if status.exited {
                status.code
            } else if status.signal != 0 {
                wrapping_add(SIGNAL_EXIT_BASE, widen_i64(status.signal))
            } else {
                1
            }
        },
        Result::Err(e) => spawn_failed(in binary, e),
    }
}

// `measure_tee` of src/main.rs for `vesper build --tee` (hd_step group 1,
// #1896): `vesper-tee measure <path>` with the CLI's standard streams; 0,
// or 1 once its error is printed.
pub fn measure_tee(in path: Slice[u8]) -> i64 eff [Ffi[StdFs], Ffi[StdEnv], Ffi[StdProcess]] {
    handle Fail[PrintFailed] in {
        tee_measure(in path)
    } with {
        return v => v,
        raise(failure, _) => print_panic(failure),
    }
}

fn tee_measure(
    in path: Slice[u8]
) -> i64 eff [Ffi[StdFs], Ffi[StdEnv], Ffi[StdProcess], Fail[PrintFailed]] {
    let binary = locate(in "tee".as_bytes());
    if binary.len() == 0 {
        return missing(in "tee".as_bytes());
    }
    let mut command = command_path(in binary.as_slice());
    proc_arg(inout command, in "measure".as_bytes());
    proc_arg(inout command, in path);
    let mut child = match spawn(command) {
        Result::Ok(child) => child,
        Result::Err(e) => return spawn_failed(in binary.as_slice(), e),
    };
    let waited = wait(inout child);
    release(child);
    let code = match waited {
        Result::Ok(status) => {
            if status.exited {
                status.code
            } else if status.signal != 0 {
                wrapping_add(SIGNAL_EXIT_BASE, widen_i64(status.signal))
            } else {
                1
            }
        },
        Result::Err(e) => return spawn_failed(in binary.as_slice(), e),
    };
    if code == 0 {
        return 0;
    }
    let mut message: ChunkSeq[u8] = ChunkSeq::new[u8]();
    message.extend(in "vesper-tee could not measure ".as_bytes());
    message.extend(in path);
    message.extend(in " (exit ".as_bytes());
    if code < 0 {
        message.push(Ascii::Dash);
        push_decimal(inout message, wrapping_sub(0, wrapping_u64(code)));
    } else {
        push_decimal(inout message, wrapping_u64(code));
    }
    message.push(Ascii::RightParen);
    fail(in message.as_slice())
}

// `{binary}: {e}`.
fn spawn_failed(in binary: Slice[u8], e: IoError) -> i64 eff [Ffi[StdFs], Fail[PrintFailed]] {
    let mut message: ChunkSeq[u8] = ChunkSeq::new[u8]();
    message.extend(in binary);
    message.extend(in ": ".as_bytes());
    if e.kind == not_found() && e.os == 0 {
        message.extend(in "program not found".as_bytes());
    } else {
        let word = widen_u64(e.kind) | (widen_u64(e.os) << 32);
        let detail = io_error_text(word);
        message.extend(in detail.as_slice());
    }
    fail(in message.as_slice())
}

// ---------------------------------------------------------------------------
// `vesper fmt` (src/fmt_commands.rs, part 2 of #1336, part 3b of #1996):
// the options, the single-file and workspace runs, the directory walk, one
// file's bounded no-follow read, the checked atomic replace, the status
// lines and the JSON reports are here. The formatter is @vesper/fmt
// (`fmt_commands::format_text` with `Limits::default()`).

const FMT_MAX_WALK_ENTRIES: u64 = 200000;
const FMT_STATS: u64 = 5;
// `MAX_BYTES`: the largest input.
const FMT_MAX_BYTES: u64 = 262144;

// `format_one` statuses.
fn fmt_unchanged() -> u32 {
    0
}

fn fmt_formatted() -> u32 {
    1
}

fn fmt_needs_format() -> u32 {
    2
}

fn fmt_error() -> u32 {
    3
}

// `format_one` stats slots.
fn stat_changed() -> u64 {
    0
}

fn stat_input_bytes() -> u64 {
    1
}

fn stat_output_bytes() -> u64 {
    2
}

fn stat_has_edits() -> u64 {
    3
}

fn stat_edits() -> u64 {
    4
}

fn fmt_help() -> Str {
    "Usage: vesper fmt [PATH...] [--recovery] [--check] [--json]\n\nWith no PATH the current directory is formatted. Directories are walked for .ves files in sorted\norder without following symlinks, skipping hidden, target/ and bazel-* directories.\nFormat supported Vesper source and expression macros with a canonical 100-column ribbon.\nRecovery mode formats only complete functions and preserves damaged or opaque source bytes.\nCheck mode never writes and exits nonzero when formatting is needed.\nInputs are bounded to 256 KiB regular UTF-8 files without final symlinks.\nDefault mode rejects invalid/incomplete source; failures always leave input unchanged.\nToken/string/comment bytes are preserved; indivisible leaves may exceed 100 columns.\n"
}

// A list of paths in one byte arena: path `i` is `bytes[start(i)..ends[i]]`.
struct Paths {
    bytes: ChunkSeq[u8],
    ends: ChunkSeq[u64],
}

fn paths_new() -> Paths {
    Paths {
        bytes: ChunkSeq::new[u8](),
        ends: ChunkSeq::new[u64](),
    }
}

fn paths_push(inout paths: Paths, in path: Slice[u8]) {
    paths.bytes.extend(in path);
    paths.ends.push(paths.bytes.len());
}

fn paths_start(in paths: Paths, i: u64) -> u64 {
    if i == 0 {
        0
    } else {
        span_at(in paths.ends.as_slice(), wrapping_sub(i, 1))
    }
}

fn paths_get(in paths: Paths, i: u64) -> ChunkSeq[u8] {
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let start = paths_start(in paths, i);
    let end = span_at(in paths.ends.as_slice(), i);
    out.extend(in paths.bytes[start..end]);
    out
}

// Remove and return the last path.
fn paths_pop(inout paths: Paths) -> ChunkSeq[u8] {
    let n = paths.ends.len();
    let last = paths_get(in paths, wrapping_sub(n, 1));
    let start = paths_start(in paths, wrapping_sub(n, 1));
    paths.bytes.truncate(start);
    paths.ends.truncate(wrapping_sub(n, 1));
    last
}

// Rust's `str::from_utf8`: whether `bytes` is well-formed UTF-8 (no overlong
// forms, surrogates or code points past U+10FFFF).
fn utf8(in bytes: Slice[u8]) -> bool {
    let mut i: u64 = 0;
    loop {
        if i >= bytes.len() {
            break;
        }
        let lead = byte_at(in bytes, i);
        if lead < Ascii::NonAsciiStart {
            i = wrapping_add(i, 1);
        } else {
            let mut cont_count: u64 = 0;
            let mut lo: u8 = 128;
            let mut hi: u8 = 191;
            if lead >= 194 && lead <= 223 {
                cont_count = 1;
            } else if lead == 224 {
                cont_count = 2;
                lo = 160;
            } else if lead >= 225 && lead <= 236 {
                cont_count = 2;
            } else if lead == 237 {
                cont_count = 2;
                hi = 159;
            } else if lead == 238 || lead == 239 {
                cont_count = 2;
            } else if lead == 240 {
                cont_count = 3;
                lo = 144;
            } else if lead >= 241 && lead <= 243 {
                cont_count = 3;
            } else if lead == 244 {
                cont_count = 3;
                hi = 143;
            } else {
                return false;
            }
            if wrapping_add(i, cont_count) >= bytes.len() {
                return false;
            }
            let first_cont = byte_at(in bytes, wrapping_add(i, 1));
            if first_cont < lo || first_cont > hi {
                return false;
            }
            for k in 2..wrapping_add(cont_count, 1) {
                let cont_byte = byte_at(in bytes, wrapping_add(i, k));
                if cont_byte < 128 || cont_byte > 191 {
                    return false;
                }
            }
            i = wrapping_add(i, wrapping_add(cont_count, 1));
        }
    }
    true
}

fn push_decimal(inout out: ChunkSeq[u8], value: u64) {
    if value >= 10 {
        push_decimal(inout out, value / 10);
    }
    out.push(wrapping_u8(wrapping_add(value % 10, 48)));
}

fn hex_digit(nibble: u8) -> u8 {
    if nibble < 10 {
        wrapping_add(nibble, 48)
    } else {
        wrapping_add(nibble, 87)
    }
}

// A JSON string as serde_json writes it: `"` and `\` escaped, the control
// bytes as `\b \f \n \r \t` or `\u00xx`, everything else as is.
pub fn json_string(inout out: ChunkSeq[u8], in text: Slice[u8]) {
    out.push(Ascii::DoubleQuote);
    for i in 0..text.len() {
        let byte = byte_at(in text, i);
        if byte == Ascii::DoubleQuote || byte == Ascii::Backslash {
            out.push(Ascii::Backslash);
            out.push(byte);
        } else if byte < 32 {
            out.push(Ascii::Backslash);
            if byte == 8 {
                out.push(98);
            } else if byte == 12 {
                out.push(102);
            } else if byte == 10 {
                out.push(110);
            } else if byte == 13 {
                out.push(114);
            } else if byte == 9 {
                out.push(116);
            } else {
                out.extend(in "u00".as_bytes());
                out.push(hex_digit(byte >> 4));
                out.push(hex_digit(byte & 15));
            }
        } else {
            out.push(byte);
        }
    }
    out.push(Ascii::DoubleQuote);
}

// `"key":` (after a `,` unless it is the object's first key).
pub fn json_key(inout out: ChunkSeq[u8], in key: Str, first: bool) {
    if !first {
        out.push(44);
    }
    json_string(inout out, in key.as_bytes());
    out.push(Ascii::Colon);
}

fn json_bool(inout out: ChunkSeq[u8], value: bool) {
    if value {
        out.extend(in "true".as_bytes());
    } else {
        out.extend(in "false".as_bytes());
    }
}

fn status_name(status: u32) -> Str {
    if status == fmt_formatted() {
        "formatted"
    } else if status == fmt_needs_format() {
        "needs_format"
    } else if status == fmt_error() {
        "error"
    } else {
        "unchanged"
    }
}

fn mode_name(recovery: bool) -> Str {
    if recovery { "recovery" } else { "source" }
}

// One file's `format_file` report (its keys sorted, as serde_json's map
// writes them); `path` replaces `schema_version` in a workspace entry.
fn file_report(
    inout out: ChunkSeq[u8],
    status: u32,
    in stats: Slice[u64],
    check: bool,
    recovery: bool,
    in path: Slice[u8],
    entry: bool
) {
    out.push(123);
    json_key(inout out, in "changed", true);
    json_bool(inout out, span_at(in stats, stat_changed()) != 0);
    json_key(inout out, in "check", false);
    json_bool(inout out, check);
    if span_at(in stats, stat_has_edits()) != 0 {
        json_key(inout out, in "edits", false);
        push_decimal(inout out, span_at(in stats, stat_edits()));
    }
    json_key(inout out, in "input_bytes", false);
    push_decimal(inout out, span_at(in stats, stat_input_bytes()));
    json_key(inout out, in "mode", false);
    json_string(inout out, in mode_name(recovery).as_bytes());
    json_key(inout out, in "output_bytes", false);
    push_decimal(inout out, span_at(in stats, stat_output_bytes()));
    if entry {
        json_key(inout out, in "path", false);
        json_string(inout out, in path);
    } else {
        json_key(inout out, in "schema_version", false);
        out.push(49);
    }
    json_key(inout out, in "status", false);
    json_string(inout out, in status_name(status).as_bytes());
    json_key(inout out, in "width", false);
    out.extend(in "100".as_bytes());
    out.push(125);
}

// `fs::symlink_metadata(path).is_ok_and(|m| m.is_dir())`; `path` is UTF-8.
fn is_dir(in path: Slice[u8]) -> bool eff [Ffi[StdFs]] {
    let text = match String::from_utf8(in path) {
        Option::Some(decoded) => decoded,
        Option::None => return false,
    };
    handle Fail[IoError] in {
        symlink_metadata(in text.as_str()).kind == kind_dir()
    } with {
        return v => v,
        raise(_e, _k) => false,
    }
}

fn io_word(e: IoError) -> u64 {
    widen_u64(e.kind) | (widen_u64(e.os) << 32)
}

// A directory listing, or the error word of the read that failed.
struct Listed {
    entries: Entries,
    error_word: u64,
}

// Directory `dir`'s names and kinds (not following symbolic links) into
// `out`, in the OS's order, reading at most `budget` entries: one more sets
// `over` and stops, so the walk's limit holds while the listing is read,
// as in Rust. 0, or the error word of a directory that cannot be read.
fn list_bounded(
    in dir: Slice[u8],
    budget: u64,
    inout out: Entries,
    inout over: bool
) -> u64 eff [Ffi[StdFs]] {
    // The error comes back in the handled value: a clause's assignment to
    // an outer local changes only the clause's copy (#2038).
    let result = handle Fail[IoError] in {
        Listed {
            entries: list_dir_path(in dir),
            error_word: 0,
        }
    } with {
        return v => v,
        raise(e, _k) => Listed {
            entries: Entries {
                bytes: ChunkSeq::new[u8](),
                ends: ChunkSeq::new[u64](),
                kinds: ChunkSeq::new[u32](),
            },
            error_word: io_word(e),
        },
    };
    if result.error_word != 0 {
        return result.error_word;
    }
    let listed = result.entries;
    if listed.ends.len() > budget {
        over = true;
        return 0;
    }
    out.bytes.extend(in listed.bytes.as_slice());
    out.ends.extend(in listed.ends.as_slice());
    out.kinds.extend(in listed.kinds.as_slice());
    0
}

// Whether name `left` sorts before name `right` (bytewise, as `OsString` does).
fn name_before(in entries: Entries, left: u64, right: u64) -> bool {
    let left_start = entry_start(in entries, left);
    let left_end = entry_end(in entries, left);
    let right_start = entry_start(in entries, right);
    let right_end = entry_end(in entries, right);
    let left_len = wrapping_sub(left_end, left_start);
    let right_len = wrapping_sub(right_end, right_start);
    let common_len = if left_len < right_len {
        left_len
    } else {
        right_len
    };
    for i in 0..common_len {
        let left_byte = byte_at(in entries.bytes.as_slice(), wrapping_add(left_start, i));
        let right_byte = byte_at(in entries.bytes.as_slice(), wrapping_add(right_start, i));
        if left_byte != right_byte {
            return left_byte < right_byte;
        }
    }
    left_len < right_len
}

// The entry order of `entries` sorted by name: a stable bottom-up merge sort of
// indices.
fn sorted_order(in entries: Entries) -> ChunkSeq[u64] {
    let n = entries.ends.len();
    let mut order: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut merged: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for i in 0..n {
        order.push(i);
        merged.push(i);
    }
    let mut width: u64 = 1;
    loop {
        if width >= n {
            break;
        }
        let mut lo: u64 = 0;
        loop {
            if lo >= n {
                break;
            }
            let mid = min_u64(wrapping_add(lo, width), n);
            let hi = min_u64(wrapping_add(mid, width), n);
            let mut i = lo;
            let mut j = mid;
            for k in lo..hi {
                let left_entry = span_at(in order.as_slice(), i);
                let right_entry = span_at(in order.as_slice(), j);
                let take_left = if i >= mid {
                    false
                } else if j >= hi {
                    true
                } else {
                    !name_before(in entries, right_entry, left_entry)
                };
                if take_left {
                    set64(inout merged.as_slice_mut(), k, left_entry);
                    i = wrapping_add(i, 1);
                } else {
                    set64(inout merged.as_slice_mut(), k, right_entry);
                    j = wrapping_add(j, 1);
                }
            }
            lo = hi;
        }
        for k in 0..n {
            set64(inout order.as_slice_mut(), k, span_at(in merged.as_slice(), k));
        }
        width = wrapping_add(width, width);
    }
    order
}

fn set64(inout slots: Slice[u64], i: u64, value: u64) {
    slots.try_set(i, value);
}

fn min_u64(x: u64, y: u64) -> u64 {
    if x < y { x } else { y }
}

// Whether `name` holds U+FFFD: on Windows the host lists names lossily, so
// such a name may not be the file's real (unpaired-surrogate) name.
fn replacement_char(in name: Slice[u8]) -> bool {
    if name.len() < 3 {
        return false;
    }
    for i in 0..wrapping_sub(name.len(), 2) {
        if byte_at(in name, i) == 239
            && byte_at(in name, wrapping_add(i, 1)) == 191
            && byte_at(in name, wrapping_add(i, 2)) == 189
        {
            return true;
        }
    }
    false
}

// `Path::extension() == Some("ves")` of a file name.
fn ves_name(in name: Slice[u8]) -> bool {
    let n = name.len();
    if n < 5 {
        return false;
    }
    let dot_at = wrapping_sub(n, 4);
    byte_at(in name, dot_at) == 46
        && byte_at(in name, wrapping_add(dot_at, 1)) == 118
        && byte_at(in name, wrapping_add(dot_at, 2)) == 101
        && byte_at(in name, wrapping_add(dot_at, 3)) == 115
}

fn starts_with(in bytes: Slice[u8], in prefix: Str) -> bool {
    let prefix_bytes = prefix.as_bytes();
    if bytes.len() < prefix_bytes.len() {
        return false;
    }
    for i in 0..prefix_bytes.len() {
        if byte_at(in bytes, i) != byte_at(in prefix_bytes, i) {
            return false;
        }
    }
    true
}

// `skipped_dir`: hidden, `target` and `bazel-*` directories.
fn skipped_dir(in name: Slice[u8]) -> bool {
    byte_at(in name, 0) == 46 || eq(in name, in "target") || starts_with(in name, in "bazel-")
}

// `walk`: the `.ves` files below `root` in sorted order, appended to
// `files`; symbolic links are never followed. `walk_ok()`; `walk_failed()`
// with `err` set when a directory cannot be read or the walk visits too
// many entries; or `walk_delegate()` when a Windows name may have been
// listed lossily, so the Rust CLI, which keeps the `OsString`, must run.
fn walk(
    in root: Slice[u8],
    inout files: Paths,
    inout visited: u64,
    inout err: ChunkSeq[u8]
) -> u32 eff [Ffi[StdFs], Ffi[StdEnv]] {
    let windows = os() == os_windows();
    let mut pending = paths_new();
    paths_push(inout pending, in root);
    loop {
        if pending.ends.len() == 0 {
            break;
        }
        let dir = paths_pop(inout pending);
        let mut entries = Entries {
            bytes: ChunkSeq::new[u8](),
            ends: ChunkSeq::new[u64](),
            kinds: ChunkSeq::new[u32](),
        };
        let mut over = false;
        let budget = wrapping_sub(FMT_MAX_WALK_ENTRIES, visited);
        let word = list_bounded(in dir.as_slice(), budget, inout entries, inout over);
        if word != 0 {
            err.extend(in dir.as_slice());
            err.extend(in ": ".as_bytes());
            let detail = io_error_text(word);
            err.extend(in detail.as_slice());
            return walk_failed();
        }
        if over {
            err.extend(
                in "fmt visited more than 200000 directory entries; pass narrower paths".as_bytes()
            );
            return walk_failed();
        }
        let count = entry_count(in entries);
        visited = wrapping_add(visited, count);
        let order = sorted_order(in entries);
        let mut subdirs = paths_new();
        for k in 0..count {
            let entry_index = span_at(in order.as_slice(), k);
            let name_start = entry_start(in entries, entry_index);
            let name_end = entry_end(in entries, entry_index);
            let mut name: ChunkSeq[u8] = ChunkSeq::new[u8]();
            name.extend(in entries.bytes[name_start..name_end]);
            if windows && replacement_char(in name.as_slice()) {
                return walk_delegate();
            }
            let kind = entry_kind(in entries, entry_index);
            if kind == kind_dir() {
                if !skipped_dir(in name.as_slice()) {
                    let child_path = join(in dir.as_slice(), in name.as_slice(), windows);
                    paths_push(inout subdirs, in child_path.as_slice());
                }
            } else if kind == kind_file() && ves_name(in name.as_slice()) {
                let child_path = join(in dir.as_slice(), in name.as_slice(), windows);
                paths_push(inout files, in child_path.as_slice());
            }
        }
        let subdir_count = subdirs.ends.len();
        for j in 0..subdir_count {
            let child_path = paths_get(in subdirs, wrapping_sub(wrapping_sub(subdir_count, 1), j));
            paths_push(inout pending, in child_path.as_slice());
        }
    }
    walk_ok()
}

fn walk_ok() -> u32 {
    0
}

fn walk_failed() -> u32 {
    1
}

fn walk_delegate() -> u32 {
    2
}

// Why one file could not be formatted: `code` picks the message
// (`fmt_message`); code `FMT_IO` carries the OS error `io_error`.
copy struct FmtStop {
    code: u32,
    io_error: IoError,
    // Code `FMT_FORMATTER`: the formatter's error (`fail_code`), its
    // syntax offset, and whether it formatted in recovery mode.
    fmt: u64,
    offset: u64,
    recovery: bool,
}

const FMT_IO: u32 = 0;
const FMT_NOT_FILE_NOFOLLOW: u32 = 1;
const FMT_NOT_FILE: u32 = 2;
const FMT_TOO_BIG: u32 = 3;
const FMT_NOT_UTF8: u32 = 4;
const FMT_CHANGED: u32 = 5;
const FMT_FORMATTER: u32 = 6;
const FMT_OK: u32 = 7;

// What one file's run did: its status and stats, or why it stopped.
copy struct FmtDone {
    status: u32,
    stop: FmtStop,
    changed: bool,
    input_bytes: u64,
    output_bytes: u64,
    has_edits: bool,
    edits: u64,
}

fn fmt_stop(code: u32) -> FmtStop {
    FmtStop { code: code, io_error: IoError { kind: 0, os: 0 }, fmt: 0, offset: 0, recovery: false }
}

fn fmt_io(e: IoError) -> FmtStop {
    FmtStop { code: FMT_IO, io_error: e, fmt: 0, offset: 0, recovery: false }
}

// `fmt_commands::open_input`: the regular UTF-8 file at `path`, read
// without following a final symbolic link, at most 256 KiB.
fn fmt_open(in path: Slice[u8]) -> Opened eff [Ffi[StdFs], Fail[FmtStop]] {
    let kind = handle Fail[IoError] in {
        symlink_metadata_path(in path).kind
    } with {
        return v => v,
        raise(e, _) => Fail::raise(fmt_io(e)),
    };
    if kind != kind_file() {
        return Fail::raise(fmt_stop(FMT_NOT_FILE_NOFOLLOW));
    }
    let opened = handle Fail[IoError] in {
        read_nofollow_limit(in path, wrapping_add(FMT_MAX_BYTES, 1))
    } with {
        return v => v,
        raise(e, _) => Fail::raise(fmt_io(e)),
    };
    if !opened.id.regular {
        return Fail::raise(fmt_stop(FMT_NOT_FILE));
    }
    if opened.id.size > FMT_MAX_BYTES || opened.bytes.len() > FMT_MAX_BYTES {
        return Fail::raise(fmt_stop(FMT_TOO_BIG));
    }
    match String::from_utf8(in opened.bytes.as_slice()) {
        Option::Some(_) => {},
        Option::None => return Fail::raise(fmt_stop(FMT_NOT_UTF8)),
    }
    opened
}

// `Limits::default()` of vesper_fmt.
const FMT_LIMIT_INPUT: u64 = 1048576;
const FMT_LIMIT_OUTPUT: u64 = 4194304;
const FMT_LIMIT_TOKENS: u64 = 131072;
const FMT_LIMIT_NODES: u64 = 1000000;
const FMT_LIMIT_DEPTH: u64 = 24;
const FMT_LIMIT_WORK: u64 = 536870912;

// `recovery_edits`' words per edit: start, end and replacement length.
const RECOVERY_EDIT_WORDS: u64 = 3;

// One formatter run (`fmt_commands::format_text`): the output, whether it
// changed and recovery mode's edit count, or the error (`ok` false).
struct FmtRun {
    ok: bool,
    fail: FmtFail,
    output: ChunkSeq[u8],
    changed: bool,
    edits: u64,
}

fn fmt_run_failed(f: FmtFail) -> FmtRun {
    FmtRun { ok: false, fail: f, output: ChunkSeq::new[u8](), changed: false, edits: 0 }
}

fn fmt_run(in text: Str, recovery: bool) -> FmtRun {
    if recovery {
        let r = format_recovery(
            in text,
            FMT_LIMIT_INPUT,
            FMT_LIMIT_OUTPUT,
            FMT_LIMIT_TOKENS,
            FMT_LIMIT_NODES,
            FMT_LIMIT_DEPTH,
            FMT_LIMIT_WORK
        );
        if !recovery_ok(in r) {
            return fmt_run_failed(recovery_error(in r));
        }
        let edits = recovery_edits(in r);
        return FmtRun {
            ok: true,
            fail: FmtFail { code: 0, offset: 0 },
            output: recovery_output(in r),
            changed: recovery_changed(in r),
            edits: edits.len() / RECOVERY_EDIT_WORDS,
        };
    }
    handle Fail[FmtFail] in {
        let output = format(
            in text,
            FMT_LIMIT_INPUT,
            FMT_LIMIT_OUTPUT,
            FMT_LIMIT_TOKENS,
            FMT_LIMIT_NODES,
            FMT_LIMIT_DEPTH,
            FMT_LIMIT_WORK
        );
        let changed = !eq(in output.as_slice(), in text);
        FmtRun {
            ok: true,
            fail: FmtFail { code: 0, offset: 0 },
            output: output,
            changed: changed,
            edits: 0
        }
    } with {
        return v => v,
        raise(e, _) => fmt_run_failed(e),
    }
}

// `FmtFail::code`: the index of the vesper_fmt `Error` variant
// (crates/vesper-fmt/vesper/src/lib.ves `E_*`).
const FMT_E_INPUT: u64 = 0;
const FMT_E_OUTPUT: u64 = 1;
const FMT_E_TOKEN: u64 = 2;
const FMT_E_NODE: u64 = 3;
const FMT_E_DEPTH: u64 = 4;
const FMT_E_WORK: u64 = 5;
const FMT_E_OVERFLOW: u64 = 6;
const FMT_E_ALLOCATION: u64 = 7;
const FMT_E_INVALID_DOC: u64 = 8;
const FMT_E_SYNTAX: u64 = 9;
const FMT_E_MACRO: u64 = 10;
const FMT_E_CONSERVATION: u64 = 11;
const FMT_E_IDEMPOTENT: u64 = 12;

// The `Debug` text of a vesper_fmt `Error`.
fn fmt_error_name(inout out: ChunkSeq[u8], code: u64, offset: u64) {
    let name = if code == FMT_E_INPUT {
        "InputLimit"
    } else if code == FMT_E_OUTPUT {
        "OutputLimit"
    } else if code == FMT_E_TOKEN {
        "TokenLimit"
    } else if code == FMT_E_NODE {
        "NodeLimit"
    } else if code == FMT_E_DEPTH {
        "DepthLimit"
    } else if code == FMT_E_WORK {
        "WorkLimit"
    } else if code == FMT_E_OVERFLOW {
        "Overflow"
    } else if code == FMT_E_ALLOCATION {
        "Allocation"
    } else if code == FMT_E_INVALID_DOC {
        "InvalidDoc"
    } else if code == FMT_E_SYNTAX {
        "Syntax { offset: "
    } else if code == FMT_E_MACRO {
        "OpaqueMacro"
    } else if code == FMT_E_CONSERVATION {
        "Conservation"
    } else {
        "NotIdempotent"
    };
    out.extend(in name.as_bytes());
    if code == FMT_E_SYNTAX {
        push_decimal(inout out, offset);
        out.extend(in " }".as_bytes());
    }
}

// `fmt_commands::replace`'s staging path: `.vesper-fmt-<pid>-<next>` in
// the file's parent directory (`.` when it has none), as `Path::join`
// writes it.
fn fmt_stage(in path: Slice[u8], next: u64) -> ChunkSeq[u8] eff [Ffi[StdFs], Ffi[StdEnv]] {
    let windows = os() == os_windows();
    let mut none = false;
    let mut out = parent(in path, windows, inout none);
    if out.len() == 0 {
        out.push(Ascii::Dot);
    }
    let n = out.len();
    let last = byte_at(in out.as_slice(), wrapping_sub(n, 1));
    let drive_only = windows && n == 2 && byte_at(in out.as_slice(), 1) == Ascii::Colon;
    if !is_separator(last, windows) && !drive_only {
        if windows {
            out.push(Ascii::Backslash);
        } else {
            out.push(Ascii::Slash);
        }
    }
    out.extend(in ".vesper-fmt-".as_bytes());
    push_decimal(inout out, widen_u64(process_id()));
    out.push(Ascii::Dash);
    push_decimal(inout out, next);
    out
}

// `replace_at_stage` after the staged file exists: read the input again,
// refuse a file that changed, and rename the stage over it.
fn fmt_commit(
    in path: Slice[u8],
    in stage: Slice[u8],
    in input: Opened
) -> FmtStop eff [Ffi[StdFs]] {
    handle Fail[FmtStop] in {
        let current = fmt_open(in path);
        if !same(in current.bytes.as_slice(), in input.bytes.as_slice())
            || !same_file(current.id, input.id)
        {
            return Fail::raise(fmt_stop(FMT_CHANGED));
        }
        handle Fail[IoError] in {
            rename_path(in stage, in path);
        } with {
            return v => v,
            raise(e, _) => Fail::raise(fmt_io(e)),
        }
        fmt_stop(FMT_OK)
    } with {
        return v => v,
        raise(e, _) => e,
    }
}

// `fmt_commands::replace`: stage `output` beside `path` (private, then
// with the input's permissions, flushed), check the input is unchanged
// and rename. A failure leaves `path` as it was and removes the stage.
fn fmt_replace(in path: Slice[u8], in input: Opened, in output: Slice[u8], next: u64) eff [
    Ffi[StdFs],
    Ffi[StdEnv],
    Fail[FmtStop]
] {
    let stage = fmt_stage(in path, next);
    handle Fail[IoError] in {
        create_staged(in stage.as_slice(), in output, input.id.perm);
    } with {
        return v => v,
        raise(e, _) => Fail::raise(fmt_io(e)),
    }
    let done = fmt_commit(in path, in stage.as_slice(), in input);
    if done.code != FMT_OK {
        remove_staged(in stage.as_slice());
        Fail::raise(done)
    }
}

// `fmt_commands::format_file` without its JSON: read, format, and replace
// unless checking.
fn fmt_steps(
    in path: Slice[u8],
    check: bool,
    recovery: bool,
    next: u64
) -> FmtDone eff [Ffi[StdFs], Ffi[StdEnv], Ffi[HybridCommands], Fail[FmtStop]] {
    let input = fmt_open(in path);
    let text = match String::from_utf8(in input.bytes.as_slice()) {
        Option::Some(t) => t,
        Option::None => return Fail::raise(fmt_stop(FMT_NOT_UTF8)),
    };
    let run = fmt_run(in text.as_str(), recovery);
    if !run.ok {
        return Fail::raise(FmtStop {
            code: FMT_FORMATTER,
            io_error: IoError { kind: 0, os: 0 },
            fmt: fail_code(run.fail),
            offset: fail_offset(run.fail),
            recovery: recovery,
        });
    }
    let changed = run.changed;
    let status = if check && changed {
        fmt_needs_format()
    } else if changed {
        fmt_formatted()
    } else {
        fmt_unchanged()
    };
    let output = run.output;
    if changed && !check {
        fmt_replace(in path, in input, in output.as_slice(), next);
    }
    FmtDone {
        status: status,
        stop: fmt_stop(FMT_OK),
        changed: changed,
        input_bytes: input.bytes.len(),
        output_bytes: output.len(),
        has_edits: recovery,
        edits: run.edits,
    }
}

// The error text of a stopped file, as `format_file`'s `Err` reads.
fn fmt_message(inout out: ChunkSeq[u8], stop: FmtStop) eff [Ffi[StdFs], Ffi[HybridCommands]] {
    let code = stop.code;
    if code == FMT_IO {
        let detail = error_text(stop.io_error);
        out.extend(in detail.as_slice());
    } else if code == FMT_NOT_FILE_NOFOLLOW {
        out.extend(in "fmt requires a regular file without final symlinks".as_bytes());
    } else if code == FMT_NOT_FILE {
        out.extend(in "fmt requires a regular file".as_bytes());
    } else if code == FMT_TOO_BIG {
        out.extend(in "fmt input exceeds 256 KiB".as_bytes());
    } else if code == FMT_NOT_UTF8 {
        out.extend(in "fmt input must be UTF-8".as_bytes());
    } else if code == FMT_CHANGED {
        out.extend(in "fmt input changed during formatting; retry".as_bytes());
    } else if stop.recovery {
        out.extend(in "cannot format recovery source: ".as_bytes());
        fmt_error_name(inout out, stop.fmt, stop.offset);
    } else {
        out.extend(in "cannot format source: ".as_bytes());
        fmt_error_name(inout out, stop.fmt, stop.offset);
    }
}

// One file: its status, with `stats` (`stat_*` slots) or the error in
// `err`. `next` numbers the staging file.
fn format_one(
    in path: Slice[u8],
    check: bool,
    recovery: bool,
    inout stats: ChunkSeq[u64],
    inout err: ChunkSeq[u8],
    next: u64
) -> u32 eff [Ffi[StdFs], Ffi[StdEnv], Ffi[HybridCommands]] {
    let done = handle Fail[FmtStop] in {
        fmt_steps(in path, check, recovery, next)
    } with {
        return v => v,
        raise(e, _) => FmtDone {
            status: fmt_error(),
            stop: e,
            changed: false,
            input_bytes: 0,
            output_bytes: 0,
            has_edits: false,
            edits: 0,
        },
    };
    stats.truncate(0);
    let mut changed: u64 = 0;
    if done.changed {
        changed = 1;
    }
    let mut has_edits: u64 = 0;
    if done.has_edits {
        has_edits = 1;
    }
    stats.push(changed);
    stats.push(done.input_bytes);
    stats.push(done.output_bytes);
    stats.push(has_edits);
    stats.push(done.edits);
    err.truncate(0);
    if done.status == fmt_error() {
        fmt_message(inout err, done.stop);
    }
    done.status
}

// `{"error":...,"schema_version":1,"status":"error"}` and `vesper: <error>`.
fn fmt_failed(in error: Slice[u8], json: bool) -> i64 eff [Ffi[StdFs], Fail[PrintFailed]] {
    if json {
        let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
        out.push(123);
        json_key(inout out, in "error", true);
        json_string(inout out, in error);
        json_key(inout out, in "schema_version", false);
        out.push(49);
        json_key(inout out, in "status", false);
        json_string(inout out, in "error".as_bytes());
        out.push(125);
        out.push(Ascii::LineFeed);
        print(stdout_stream(), in out.as_slice());
    }
    fail(in error)
}

fn line(inout out: ChunkSeq[u8], in text: Slice[u8]) {
    out.extend(in text);
    out.push(Ascii::LineFeed);
}

// `fmt_commands::run`.
fn fmt(in args: Args) -> i64 eff [Ffi[StdFs], Ffi[StdEnv], Ffi[HybridCommands], Fail[PrintFailed]] {
    let n = args_count(in args);
    // The Rust CLI panics on an argument that is not UTF-8.
    for i in 1..n {
        let arg_buf = arg(in args, i);
        if !utf8(in arg_buf.as_slice()) {
            return delegate();
        }
    }
    let mut json = false;
    let mut help = false;
    for i in 1..n {
        let arg_buf = arg(in args, i);
        if eq(in arg_buf.as_slice(), in "--") {
            break;
        }
        if eq(in arg_buf.as_slice(), in "--help") || eq(in arg_buf.as_slice(), in "-h") {
            help = true;
        }
        if eq(in arg_buf.as_slice(), in "--json") {
            json = true;
        }
    }
    if help {
        print(stdout_stream(), in fmt_help().as_bytes());
        return 0;
    }
    // `execute`.
    let mut paths = paths_new();
    let mut check = false;
    let mut recovery = false;
    let mut positional = false;
    for i in 1..n {
        let arg_buf = arg(in args, i);
        let arg_text = arg_buf.as_slice();
        let mut taken = false;
        if !positional {
            if eq(in arg_text, in "--check") {
                check = true;
                taken = true;
            } else if eq(in arg_text, in "--json") {
                taken = true;
            } else if eq(in arg_text, in "--recovery") {
                recovery = true;
                taken = true;
            } else if eq(in arg_text, in "--") {
                positional = true;
                taken = true;
            } else if byte_at(in arg_text, 0) == Ascii::Dash && arg_text.len() != 0 {
                let mut message: ChunkSeq[u8] = ChunkSeq::new[u8]();
                message.extend(in "unknown fmt option '".as_bytes());
                message.extend(in arg_text);
                message.push(39);
                return fmt_failed(in message.as_slice(), json);
            }
        }
        if !taken {
            paths_push(inout paths, in arg_text);
        }
    }
    let mut stats: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut err: ChunkSeq[u8] = ChunkSeq::new[u8]();
    // One explicit non-directory path keeps the single-file report schema.
    if paths.ends.len() == 1 {
        let only = paths_get(in paths, 0);
        if !is_dir(in only.as_slice()) {
            let status = format_one(in only.as_slice(), check, recovery, inout stats, inout err, 0);
            if status == fmt_error() {
                return fmt_failed(in err.as_slice(), json);
            }
            let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
            if json {
                let none: ChunkSeq[u8] = ChunkSeq::new[u8]();
                file_report(
                    inout out,
                    status,
                    in stats.as_slice(),
                    check,
                    recovery,
                    in none.as_slice(),
                    false
                );
                out.push(Ascii::LineFeed);
            } else {
                out.extend(in "fmt: ".as_bytes());
                out.extend(in status_name(status).as_bytes());
                out.push(Ascii::LineFeed);
            }
            print(stdout_stream(), in out.as_slice());
            if status == fmt_needs_format() {
                return fail(in "source is not canonically formatted".as_bytes());
            }
            return 0;
        }
    }
    if paths.ends.len() == 0 {
        paths_push(inout paths, in ".".as_bytes());
    }
    let mut files = paths_new();
    let mut visited: u64 = 0;
    for i in 0..paths.ends.len() {
        let path = paths_get(in paths, i);
        if is_dir(in path.as_slice()) {
            let mut err: ChunkSeq[u8] = ChunkSeq::new[u8]();
            let walked = walk(in path.as_slice(), inout files, inout visited, inout err);
            if walked == walk_delegate() {
                return delegate();
            }
            if walked == walk_failed() {
                return fmt_failed(in err.as_slice(), json);
            }
        } else {
            paths_push(inout files, in path.as_slice());
        }
    }
    let mut changed: u64 = 0;
    let mut needs: u64 = 0;
    let mut failed: u64 = 0;
    let mut lines: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut reports: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let count = files.ends.len();
    for i in 0..count {
        let file = paths_get(in files, i);
        let shown = file.as_slice();
        let status = format_one(in shown, check, recovery, inout stats, inout err, i);
        if i != 0 {
            reports.push(44);
        }
        if status == fmt_error() {
            failed = wrapping_add(failed, 1);
            lines.extend(in "fmt: error ".as_bytes());
            lines.extend(in shown);
            lines.extend(in ": ".as_bytes());
            line(inout lines, in err.as_slice());
            reports.push(123);
            json_key(inout reports, in "error", true);
            json_string(inout reports, in err.as_slice());
            json_key(inout reports, in "path", false);
            json_string(inout reports, in shown);
            json_key(inout reports, in "status", false);
            json_string(inout reports, in "error".as_bytes());
            reports.push(125);
        } else {
            if status == fmt_needs_format() {
                needs = wrapping_add(needs, 1);
            } else if status == fmt_formatted() {
                changed = wrapping_add(changed, 1);
            }
            if status != fmt_unchanged() {
                lines.extend(in "fmt: ".as_bytes());
                lines.extend(in status_name(status).as_bytes());
                lines.push(32);
                line(inout lines, in shown);
            }
            file_report(
                inout reports,
                status,
                in stats.as_slice(),
                check,
                recovery,
                in shown,
                true
            );
        }
    }
    let mut overall = fmt_unchanged();
    if failed > 0 {
        overall = fmt_error();
    } else if needs > 0 {
        overall = fmt_needs_format();
    } else if changed > 0 {
        overall = fmt_formatted();
    }
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    if json {
        out.push(123);
        json_key(inout out, in "check", true);
        json_bool(inout out, check);
        json_key(inout out, in "errors", false);
        push_decimal(inout out, failed);
        json_key(inout out, in "file_count", false);
        push_decimal(inout out, count);
        json_key(inout out, in "files", false);
        out.push(91);
        out.extend(in reports.as_slice());
        out.push(93);
        json_key(inout out, in "formatted", false);
        push_decimal(inout out, changed);
        json_key(inout out, in "mode", false);
        json_string(inout out, in mode_name(recovery).as_bytes());
        json_key(inout out, in "needs_format", false);
        push_decimal(inout out, needs);
        json_key(inout out, in "schema_version", false);
        out.push(49);
        json_key(inout out, in "status", false);
        json_string(inout out, in status_name(overall).as_bytes());
        json_key(inout out, in "width", false);
        out.extend(in "100".as_bytes());
        out.push(125);
        out.push(Ascii::LineFeed);
    } else {
        out.extend(in lines.as_slice());
        out.extend(in "fmt: ".as_bytes());
        out.extend(in status_name(overall).as_bytes());
        out.extend(in " (".as_bytes());
        push_decimal(inout out, count);
        out.extend(in " files, ".as_bytes());
        push_decimal(inout out, changed);
        out.extend(in " formatted, ".as_bytes());
        push_decimal(inout out, needs);
        out.extend(in " need formatting, ".as_bytes());
        push_decimal(inout out, failed);
        out.extend(in " errors)\n".as_bytes());
    }
    print(stdout_stream(), in out.as_slice());
    if failed > 0 {
        let mut message: ChunkSeq[u8] = ChunkSeq::new[u8]();
        push_decimal(inout message, failed);
        message.extend(in " file(s) could not be formatted".as_bytes());
        return fail(in message.as_slice());
    }
    if needs > 0 {
        return fail(in "source is not canonically formatted".as_bytes());
    }
    0
}
