// `vesper graph` (`src/package_graph.rs`): CLI option parsing and `--help`
// here, then the Loom.lock read; @vesper/loom-calculus reads the JSON,
// validates the snapshot, projects it and renders the text, JSON or DOT
// report (`graph_run`, #1996).
use @vesper/driver::{Args, args_count, eq};
use @vesper-std/fs::{IoError, error_text, read_path};
use @vesper/loom-calculus::lock_graph::{GRAPH_OK, GRAPH_BAD_LOCKFILE, graph_focus_error, graph_run};
use super::{PrintFailed, arg, byte_at, print, fail, stdout_stream};

// The Loom.lock bytes, or `io::Error`'s text.
struct LockRead {
    ok: bool,
    bytes: ChunkSeq[u8],
    error: ChunkSeq[u8]
}

fn read_lock(in path: Slice[u8]) -> LockRead eff [Ffi[StdFs]] {
    handle Fail[IoError] in {
        read_path(in path)
    } with {
        return v => LockRead { ok: true, bytes: v, error: ChunkSeq::new[u8]() },
        raise(e, _) => LockRead { ok: false, bytes: ChunkSeq::new[u8](), error: error_text(e) },
    }
}

pub fn run_graph(in args: Args) -> i64 eff [Ffi[StdFs], Fail[PrintFailed]] {
    let n = args_count(in args);
    let mut has_input = false;
    let mut input: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut has_focus = false;
    let mut focus: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut invert = false;
    let mut json = false;
    let mut dot = false;
    let mut i: u64 = 1;
    loop {
        if i >= n {
            break;
        }
        let arg_buf = arg(in args, i);
        let arg_text = arg_buf.as_slice();
        if eq(in arg_text, in "--help") || eq(in arg_text, in "-h") {
            print(
                stdout_stream(),
                in "Usage: vesper graph [Loom.lock] [--package @org/name] [--invert] [--json|--dot]\n\nInspect declared snapshot metadata without resolving, executing or modifying files.\n--package selects a reachable package and its dependency closure.\n--invert follows dependents instead, and reverses drawn arrows.\n--json emits the versioned inspection report; --dot emits Graphviz DOT.\n"
                    .as_bytes()
            );
            return 0;
        } else if eq(in arg_text, in "--package") {
            if has_focus {
                return fail(in "--package may only be specified once".as_bytes());
            }
            i = wrapping_add(i, 1);
            if i >= n {
                return fail(in "--package requires a package name".as_bytes());
            }
            let value_buf = arg(in args, i);
            has_focus = true;
            focus.extend(in value_buf.as_slice());
        } else if eq(in arg_text, in "--invert") {
            invert = true;
        } else if eq(in arg_text, in "--json") {
            json = true;
        } else if eq(in arg_text, in "--dot") {
            dot = true;
        } else if arg_text.len() != 0 && byte_at(in arg_text, 0) == 45 {
            let mut err: ChunkSeq[u8] = ChunkSeq::new[u8]();
            err.extend(in "unknown graph option '".as_bytes());
            err.extend(in arg_text);
            err.push(39);
            return fail(in err.as_slice());
        } else {
            if has_input {
                return fail(in "graph accepts one solution snapshot".as_bytes());
            }
            has_input = true;
            input.extend(in arg_text);
        }
        i = wrapping_add(i, 1);
    }
    if !has_input {
        input.extend(in "Loom.lock".as_bytes());
    }
    if has_focus {
        let bad = graph_focus_error(in focus.as_slice());
        if bad.len() != 0 {
            return fail(in bad.as_slice());
        }
    }
    if json && dot {
        return fail(in "--json and --dot cannot be combined".as_bytes());
    }
    let lock = read_lock(in input.as_slice());
    if !lock.ok {
        let mut err: ChunkSeq[u8] = ChunkSeq::new[u8]();
        err.extend(in input.as_slice());
        err.extend(in ": ".as_bytes());
        err.extend(in lock.error.as_slice());
        return fail(in err.as_slice());
    }
    let run = graph_run(
        in lock.bytes.as_slice(),
        has_focus,
        in focus.as_slice(),
        invert,
        json,
        dot
    );
    if run.out.len() != 0 {
        print(stdout_stream(), in run.out.as_slice());
    }
    if run.status == GRAPH_OK {
        return 0;
    }
    let mut err: ChunkSeq[u8] = ChunkSeq::new[u8]();
    if run.status == GRAPH_BAD_LOCKFILE {
        err.extend(in input.as_slice());
        err.extend(in ": invalid lockfile: ".as_bytes());
    }
    err.extend(in run.err.as_slice());
    fail(in err.as_slice())
}
