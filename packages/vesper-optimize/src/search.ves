// The bounded proof producer of src/optimize/certificate.rs
// (`propose_rewrite`) on `@vesper/egraph`: the source's shallow terms, the
// proof-carrying union forest (`Builder`), constant folding of the prefix,
// the budgeted equality-saturation search (`run_graph` with its
// `BoundedScheduler`, `RecordingApplier` and hook), extraction, and the
// replay of the recorded applications into proofs (`explain_records`).
//
// Every charge is Rust's, in Rust's order, with Rust's vector capacities
// (`grow` and `reserve` over a capacity counter beside each sequence) and
// its `size_of` values, so a proposal spends the same budget. The one
// accepted difference is the e-graph's search order: `@vesper/egraph`
// visits classes in id order where egg uses its hash order, which can pick
// another term of equal cost.
//
// Errors are codes as in witness.ves: 0 is success, otherwise the
// `WitnessError` variant's position plus one.

use @vesper/egraph::graph::{EGraph, egraph_new};
use @vesper/egraph::rules::{Rules};
use @vesper/egraph::run::{Matches, apply_one, guard_holds, matches_new, search_rule};
use @vesper/egraph::extract::{Extracted, extractor};
use @vesper/egraph::{math_arity, math_rules};
use self::budget::{Budget, limit, metadata, reserve, valid_limits, work};
use self::input::{ProofRow, TermRow, Tree, TypeRow};
use self::witness::{Bound, Ops, bind_source, bound_new, build_candidate, fits, wrap};

const NONE: u32 = 4294967295;

const E_INVALID_LIMITS: u8 = 1;
const E_LIMIT: u8 = 2;
const E_UNSUPPORTED_AST: u8 = 4;
const E_INVALID_INTRINSIC_ORIGIN: u8 = 9;
const E_INVALID_TERM_INDEX: u8 = 11;
const E_NON_TOPOLOGICAL_TERM: u8 = 12;
const E_UNKNOWN_RULE: u8 = 15;
const E_INVALID_SUBSTITUTION: u8 = 16;
const E_INVALID_RULE_INSTANCE: u8 = 17;
const E_INVALID_EQUALITY: u8 = 19;
const E_UNKNOWN_VARIABLE: u8 = 8;

// certificate.rs's caps.
const RAW_NODES: u64 = 2048;
const MATCHES: u64 = 128;
const RECORDS: u64 = 4096;
const ITERATIONS: u64 = 8;
const RULE_COUNT: u64 = 18;
const APPLICATION_NODES: u64 = 8;

// Rust's `size_of` values (64-bit targets).
const S_TERM: u64 = 48;
const S_EQUALITY: u64 = 36;
const S_TERM_ID: u64 = 4;
const S_OPTION_ID: u64 = 8;
const S_RANK: u64 = 1;
const S_BOOL: u64 = 1;
const S_RECORD: u64 = 16;
const S_MATH: u64 = 16;
const S_PROPOSAL: u64 = 400;

const T_CONST: u8 = 0;
const T_INPUT: u8 = 1;
const T_CHECKED: u8 = 2;
const T_WRAPPING: u8 = 3;

const P_REFL: u8 = 0;
const P_RULE: u8 = 1;
const P_CONGRUENCE: u8 = 2;
const P_SYMMETRY: u8 = 3;
const P_TRANSITIVITY: u8 = 4;

const OP_ADD: u8 = 0;
const OP_SUB: u8 = 1;
const OP_MUL: u8 = 2;

// `src/optimize.rs`'s `Math` language (`@vesper/egraph`'s lib.ves).
const M_NUM: u32 = 0;
const M_INPUT: u32 = 7;

// The outcome of `propose`.
pub const O_CANDIDATE: u8 = 0;
pub const O_BARRIER: u8 = 1;
pub const O_UNCHANGED: u8 = 2;

// ---------------------------------------------------------------- helpers

// Entry `i` of an id table, or NONE past its end.
fn id_at(in ids: ChunkSeq[u32], i: u64) -> u32 {
    ids.try_get(i).unwrap_or(NONE)
}

fn u8_at(in values: ChunkSeq[u8], i: u64) -> u8 {
    values.try_get(i).unwrap_or(0)
}

fn no_term() -> TermRow {
    TermRow { kind: 255, tag: 255, op: 0, value: 0, a: 0, b: 0 }
}

fn no_proof() -> ProofRow {
    ProofRow {
        from: NONE,
        to: NONE,
        tag: 255,
        rule: 0,
        b0: 0,
        b1: 0,
        b2: 0,
        len: 0,
        has_guard: false,
        guard: 0,
        p0: 0,
        p1: 0
    }
}

fn term_get(in terms: ChunkSeq[TermRow], i: u32) -> TermRow {
    match terms.try_get(widen_u64(i)) {
        Option::Some(v) => v,
        Option::None => no_term(),
    }
}

fn proof_get(in proofs: ChunkSeq[ProofRow], i: u32) -> ProofRow {
    match proofs.try_get(widen_u64(i)) {
        Option::Some(v) => v,
        Option::None => no_proof(),
    }
}

fn const_term(kind: u8, value: i128) -> TermRow {
    TermRow { kind: kind, tag: T_CONST, op: 0, value: value, a: 0, b: 0 }
}

fn input_term(kind: u8, id: u32) -> TermRow {
    let zero: i128 = 0;
    TermRow { kind: kind, tag: T_INPUT, op: 0, value: zero, a: id, b: 0 }
}

fn op_term(kind: u8, tag: u8, op: u8, a: u32, b: u32) -> TermRow {
    let zero: i128 = 0;
    TermRow { kind: kind, tag: tag, op: op, value: zero, a: a, b: b }
}

fn is_binary(term: TermRow) -> bool {
    term.tag == T_CHECKED || term.tag == T_WRAPPING
}

fn is_leaf(term: TermRow) -> bool {
    term.tag == T_CONST || term.tag == T_INPUT
}

fn same_term(x: TermRow, y: TermRow) -> bool {
    if x.kind != y.kind || x.tag != y.tag {
        return false;
    }
    if x.tag == T_CONST {
        x.value == y.value
    } else if x.tag == T_INPUT {
        x.a == y.a
    } else {
        x.op == y.op && x.a == y.a && x.b == y.b
    }
}

fn same_operator(x: TermRow, y: TermRow) -> bool {
    is_binary(x) && x.tag == y.tag && x.op == y.op
}

fn proof_row(from: u32, to: u32, tag: u8, p0: u32, p1: u32) -> ProofRow {
    ProofRow {
        from: from,
        to: to,
        tag: tag,
        rule: 0,
        b0: 0,
        b1: 0,
        b2: 0,
        len: 0,
        has_guard: false,
        guard: 0,
        p0: p0,
        p1: p1
    }
}

fn rule_row(
    from: u32,
    to: u32,
    rule: u32,
    b0: u32,
    b1: u32,
    b2: u32,
    len: u32,
    guard: u32
) -> ProofRow {
    ProofRow {
        from: from,
        to: to,
        tag: P_RULE,
        rule: rule,
        b0: b0,
        b1: b1,
        b2: b2,
        len: len,
        has_guard: guard != NONE,
        guard: if guard == NONE { 0 } else { guard },
        p0: 0,
        p1: 0
    }
}

fn add_or(a: u64, b: u64, inout out: u64) -> u8 {
    match checked_add_u64(a, b) {
        Option::Some(v) => {
            out = v;
            0
        }
        Option::None => E_LIMIT,
    }
}

fn mul_or(a: u64, b: u64, inout out: u64) -> u8 {
    match checked_mul_u64(a, b) {
        Option::Some(v) => {
            out = v;
            0
        }
        Option::None => E_LIMIT,
    }
}

fn add_to(inout total: u64, amount: u64) -> u8 {
    match checked_add_u64(total, amount) {
        Option::Some(v) => {
            total = v;
            0
        }
        Option::None => E_LIMIT,
    }
}

fn mul_to(inout total: u64, factor: u64) -> u8 {
    match checked_mul_u64(total, factor) {
        Option::Some(v) => {
            total = v;
            0
        }
        Option::None => E_LIMIT,
    }
}

fn min(a: u64, b: u64) -> u64 {
    if a < b { a } else { b }
}

fn max(a: u64, b: u64) -> u64 {
    if a > b { a } else { b }
}

// certificate.rs's `grow`: room for one more element of a vector of `len`
// elements and capacity `cap`, growing geometrically up to `most`.
fn grow(inout budget: Budget, len: u64, inout cap: u64, most: u64, size: u64) -> u8 {
    if len < cap {
        return 0;
    }
    let mut target: u64 = 0;
    if cap == 0 {
        target = min(most, 4);
    } else {
        let mut doubled: u64 = 0;
        let e = mul_or(cap, 2, inout doubled);
        if e != 0 {
            return e;
        }
        target = min(doubled, most);
    }
    if target <= len {
        return E_LIMIT;
    }
    reserve(inout budget, len, inout cap, wrapping_sub(target, len), size)
}

// certificate.rs's `initialized`: a fresh vector of `count` elements.
fn initialized(inout budget: Budget, count: u64, size: u64) -> u8 {
    let mut cap: u64 = 0;
    let e = reserve(inout budget, 0, inout cap, count, size);
    if e != 0 {
        return e;
    }
    work(inout budget, count)
}

// ---------------------------------------------------------------- builder

// certificate.rs's `Builder`: canonical shallow terms and a proof-carrying
// union forest. `edge` and `leaf` hold NONE for `None`.
pub struct Builder {
    kind: u8,
    max_terms: u64,
    max_proofs: u64,
    terms: ChunkSeq[TermRow],
    terms_cap: u64,
    proofs: ChunkSeq[ProofRow],
    proofs_cap: u64,
    parent: ChunkSeq[u32],
    parent_cap: u64,
    edge: ChunkSeq[u32],
    edge_cap: u64,
    rank: ChunkSeq[u8],
    rank_cap: u64,
    leaf: ChunkSeq[u32],
    leaf_cap: u64
}

pub fn builder_new(kind: u8, in limits: Budget) -> Builder {
    Builder {
        kind: kind,
        max_terms: limits.max_terms,
        max_proofs: limits.max_proofs,
        terms: ChunkSeq::new[TermRow](),
        terms_cap: 0,
        proofs: ChunkSeq::new[ProofRow](),
        proofs_cap: 0,
        parent: ChunkSeq::new[u32](),
        parent_cap: 0,
        edge: ChunkSeq::new[u32](),
        edge_cap: 0,
        rank: ChunkSeq::new[u8](),
        rank_cap: 0,
        leaf: ChunkSeq::new[u32](),
        leaf_cap: 0
    }
}

fn intern(inout builder: Builder, node: TermRow, inout budget: Budget, inout id: u32) -> u8 {
    let n = builder.terms.len();
    let e = work(inout budget, wrapping_add(n, 1));
    if e != 0 {
        return e;
    }
    for i in 0..n {
        if same_term(term_get(in builder.terms, wrapping_u32(i)), node) {
            id = wrapping_u32(i);
            return 0;
        }
    }
    if n >= builder.max_terms {
        return E_LIMIT;
    }
    if is_binary(node) && (widen_u64(node.a) >= n || widen_u64(node.b) >= n) {
        return E_NON_TOPOLOGICAL_TERM;
    }
    let most = builder.max_terms;
    let e = grow(inout budget, n, inout builder.terms_cap, most, S_TERM);
    if e != 0 {
        return e;
    }
    let e = grow(inout budget, n, inout builder.parent_cap, most, S_TERM_ID);
    if e != 0 {
        return e;
    }
    let e = grow(inout budget, n, inout builder.edge_cap, most, S_OPTION_ID);
    if e != 0 {
        return e;
    }
    let e = grow(inout budget, n, inout builder.rank_cap, most, S_RANK);
    if e != 0 {
        return e;
    }
    let e = grow(inout budget, n, inout builder.leaf_cap, most, S_OPTION_ID);
    if e != 0 {
        return e;
    }
    id = wrapping_u32(n);
    builder.terms.push(node);
    builder.parent.push(id);
    builder.edge.push(NONE);
    builder.rank.push(0);
    if is_leaf(node) {
        builder.leaf.push(id);
    } else {
        builder.leaf.push(NONE);
    }
    0
}

fn proof(inout builder: Builder, step: ProofRow, inout budget: Budget, inout id: u32) -> u8 {
    let e = work(inout budget, 1);
    if e != 0 {
        return e;
    }
    let n = builder.proofs.len();
    if n >= builder.max_proofs {
        return E_LIMIT;
    }
    let most = builder.max_proofs;
    let e = grow(inout budget, n, inout builder.proofs_cap, most, S_EQUALITY);
    if e != 0 {
        return e;
    }
    id = wrapping_u32(n);
    builder.proofs.push(step);
    0
}

fn reflexive(inout builder: Builder, term: u32, inout budget: Budget, inout id: u32) -> u8 {
    proof(inout builder, proof_row(term, term, P_REFL, 0, 0), inout budget, inout id)
}

fn reverse(inout builder: Builder, proof_id: u32, inout budget: Budget, inout id: u32) -> u8 {
    let original = proof_get(in builder.proofs, proof_id);
    proof(
        inout builder,
        proof_row(original.to, original.from, P_SYMMETRY, proof_id, 0),
        inout budget,
        inout id
    )
}

fn transitive(
    inout builder: Builder,
    first: u32,
    second: u32,
    inout budget: Budget,
    inout id: u32
) -> u8 {
    let first_row = proof_get(in builder.proofs, first);
    let second_row = proof_get(in builder.proofs, second);
    if first_row.to != second_row.from {
        return E_INVALID_EQUALITY;
    }
    proof(
        inout builder,
        proof_row(first_row.from, second_row.to, P_TRANSITIVITY, first, second),
        inout budget,
        inout id
    )
}

fn root(in builder: Builder, start: u32, inout budget: Budget, inout out: u32) -> u8 {
    let mut id = start;
    for i in 0..wrapping_add(builder.parent.len(), 1) {
        let e = work(inout budget, 1);
        if e != 0 {
            return e;
        }
        if widen_u64(id) >= builder.parent.len() {
            return E_INVALID_TERM_INDEX;
        }
        let next = id_at(in builder.parent, widen_u64(id));
        if next == id {
            out = id;
            return 0;
        }
        id = next;
    }
    E_INVALID_EQUALITY
}

// `path`: the ordered proof from a term to its root, NONE when the term is
// its own root.
fn path(inout builder: Builder, start: u32, inout budget: Budget, inout out: u32) -> u8 {
    let mut id = start;
    let mut path_proof: u32 = NONE;
    for i in 0..wrapping_add(builder.parent.len(), 1) {
        let e = work(inout budget, 1);
        if e != 0 {
            return e;
        }
        let next = id_at(in builder.parent, widen_u64(id));
        if next == id {
            out = path_proof;
            return 0;
        }
        let edge = id_at(in builder.edge, widen_u64(id));
        if edge == NONE {
            return E_INVALID_EQUALITY;
        }
        if path_proof == NONE {
            path_proof = edge;
        } else {
            let mut combined: u32 = 0;
            let e = transitive(inout builder, path_proof, edge, inout budget, inout combined);
            if e != 0 {
                return e;
            }
            path_proof = combined;
        }
        id = next;
    }
    E_INVALID_EQUALITY
}

fn equality(
    inout builder: Builder,
    from: u32,
    to: u32,
    inout budget: Budget,
    inout out: u32
) -> u8 {
    let mut root_from: u32 = 0;
    let e = root(in builder, from, inout budget, inout root_from);
    if e != 0 {
        return e;
    }
    let mut root_to: u32 = 0;
    let e = root(in builder, to, inout budget, inout root_to);
    if e != 0 {
        return e;
    }
    if root_from != root_to {
        return E_INVALID_EQUALITY;
    }
    let mut path_from: u32 = NONE;
    let e = path(inout builder, from, inout budget, inout path_from);
    if e != 0 {
        return e;
    }
    let mut path_to: u32 = NONE;
    let e = path(inout builder, to, inout budget, inout path_to);
    if e != 0 {
        return e;
    }
    if path_from != NONE && path_to != NONE {
        let mut reversed: u32 = 0;
        let e = reverse(inout builder, path_to, inout budget, inout reversed);
        if e != 0 {
            return e;
        }
        return transitive(inout builder, path_from, reversed, inout budget, inout out);
    }
    if path_from != NONE {
        out = path_from;
        return 0;
    }
    if path_to != NONE {
        return reverse(inout builder, path_to, inout budget, inout out);
    }
    reflexive(inout builder, from, inout budget, inout out)
}

fn join(inout builder: Builder, proof_id: u32, inout budget: Budget, inout changed: bool) -> u8 {
    let step = proof_get(in builder.proofs, proof_id);
    let mut root_from: u32 = 0;
    let e = root(in builder, step.from, inout budget, inout root_from);
    if e != 0 {
        return e;
    }
    let mut root_to: u32 = 0;
    let e = root(in builder, step.to, inout budget, inout root_to);
    if e != 0 {
        return e;
    }
    if root_from == root_to {
        changed = false;
        return 0;
    }
    let mut edge = proof_id;
    let mut path_from: u32 = NONE;
    let e = path(inout builder, step.from, inout budget, inout path_from);
    if e != 0 {
        return e;
    }
    if path_from != NONE {
        let mut reversed: u32 = 0;
        let e = reverse(inout builder, path_from, inout budget, inout reversed);
        if e != 0 {
            return e;
        }
        let mut combined: u32 = 0;
        let e = transitive(inout builder, reversed, edge, inout budget, inout combined);
        if e != 0 {
            return e;
        }
        edge = combined;
    }
    let mut path_to: u32 = NONE;
    let e = path(inout builder, step.to, inout budget, inout path_to);
    if e != 0 {
        return e;
    }
    if path_to != NONE {
        let mut combined: u32 = 0;
        let e = transitive(inout builder, edge, path_to, inout budget, inout combined);
        if e != 0 {
            return e;
        }
        edge = combined;
    }
    let rank_from = u8_at(in builder.rank, widen_u64(root_from));
    let rank_to = u8_at(in builder.rank, widen_u64(root_to));
    let mut child = root_from;
    let mut parent = root_to;
    if rank_from <= rank_to {
        if rank_from == rank_to {
            if rank_to == 255 {
                return E_LIMIT;
            }
            builder.rank.try_set(widen_u64(root_to), wrapping_add(rank_to, 1));
        }
    } else {
        child = root_to;
        parent = root_from;
        let mut reversed: u32 = 0;
        let e = reverse(inout builder, edge, inout budget, inout reversed);
        if e != 0 {
            return e;
        }
        edge = reversed;
    }
    builder.parent.try_set(widen_u64(child), parent);
    builder.edge.try_set(widen_u64(child), edge);
    if id_at(in builder.leaf, widen_u64(parent)) == NONE {
        let leaf = id_at(in builder.leaf, widen_u64(child));
        builder.leaf.try_set(widen_u64(parent), leaf);
    }
    changed = true;
    0
}

// `guard`: 0 when the erased term has no proven leaf (`None`), 1 when it is
// a leaf itself (`Some(None)`), 2 with `out` its equality to a leaf.
fn guard(
    inout builder: Builder,
    term: u32,
    inout budget: Budget,
    inout kind: u8,
    inout out: u32
) -> u8 {
    if is_leaf(term_get(in builder.terms, term)) {
        kind = 1;
        return 0;
    }
    let mut term_root: u32 = 0;
    let e = root(in builder, term, inout budget, inout term_root);
    if e != 0 {
        return e;
    }
    let leaf = id_at(in builder.leaf, widen_u64(term_root));
    if leaf == NONE {
        kind = 0;
        return 0;
    }
    kind = 2;
    equality(inout builder, term, leaf, inout budget, inout out)
}

fn congruence(inout builder: Builder, inout budget: Budget, inout any: bool) -> u8 {
    any = false;
    loop {
        let count = builder.terms.len();
        let mut pair_count: u64 = 0;
        let e = mul_or(count, count, inout pair_count);
        if e != 0 {
            return e;
        }
        let e = work(inout budget, pair_count);
        if e != 0 {
            return e;
        }
        let mut changed = false;
        for index in 0..count {
            let term = term_get(in builder.terms, wrapping_u32(index));
            if !is_binary(term) {
                continue;
            }
            for other in 0..index {
                let other_term = term_get(in builder.terms, wrapping_u32(other));
                if !same_operator(term, other_term) {
                    continue;
                }
                let mut term_root: u32 = 0;
                let e = root(in builder, wrapping_u32(index), inout budget, inout term_root);
                if e != 0 {
                    return e;
                }
                let mut other_root: u32 = 0;
                let e = root(in builder, wrapping_u32(other), inout budget, inout other_root);
                if e != 0 {
                    return e;
                }
                if term_root == other_root {
                    continue;
                }
                let e = root(in builder, term.a, inout budget, inout term_root);
                if e != 0 {
                    return e;
                }
                let e = root(in builder, other_term.a, inout budget, inout other_root);
                if e != 0 {
                    return e;
                }
                if term_root != other_root {
                    continue;
                }
                let e = root(in builder, term.b, inout budget, inout term_root);
                if e != 0 {
                    return e;
                }
                let e = root(in builder, other_term.b, inout budget, inout other_root);
                if e != 0 {
                    return e;
                }
                if term_root != other_root {
                    continue;
                }
                let mut first: u32 = 0;
                let e = equality(inout builder, term.a, other_term.a, inout budget, inout first);
                if e != 0 {
                    return e;
                }
                let mut second: u32 = 0;
                let e = equality(inout builder, term.b, other_term.b, inout budget, inout second);
                if e != 0 {
                    return e;
                }
                let mut proof_id: u32 = 0;
                let e = proof(
                    inout builder,
                    proof_row(
                        wrapping_u32(index),
                        wrapping_u32(other),
                        P_CONGRUENCE,
                        first,
                        second
                    ),
                    inout budget,
                    inout proof_id
                );
                if e != 0 {
                    return e;
                }
                let mut joined = false;
                let e = join(inout builder, proof_id, inout budget, inout joined);
                if e != 0 {
                    return e;
                }
                if joined {
                    changed = true;
                }
            }
        }
        if changed {
            any = true;
        } else {
            return 0;
        }
    }
}

// `IntegerKind::checked` and `wrapping` on two constants of the kind; false
// when the checked result overflows.
fn fold_value(kind: u8, wrapping: bool, op: u8, x: i128, y: i128, inout out: i128) -> bool {
    if wrapping {
        let raw = if op == OP_ADD {
            wrapping_add(x, y)
        } else if op == OP_SUB {
            wrapping_sub(x, y)
        } else {
            wrapping_mul(x, y)
        };
        out = wrap(kind, raw);
        return true;
    }
    let exact = if op == OP_ADD {
        checked_add_i128(x, y)
    } else if op == OP_SUB {
        checked_sub_i128(x, y)
    } else {
        checked_mul_i128(x, y)
    };
    match exact {
        Option::Some(v) => {
            if fits(kind, v) {
                out = v;
                true
            } else {
                false
            }
        }
        Option::None => false,
    }
}

fn fold_prefix(
    inout builder: Builder,
    count: u64,
    top: u32,
    inout budget: Budget,
    inout out: u32
) -> u8 {
    let e = initialized(inout budget, count, S_TERM_ID);
    if e != 0 {
        return e;
    }
    let mut mapped: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](count);
    mapped.resize(count, 0);
    for index in 0..count {
        let e = work(inout budget, 1);
        if e != 0 {
            return e;
        }
        let original = term_get(in builder.terms, wrapping_u32(index));
        if !is_binary(original) {
            mapped.try_set(index, wrapping_u32(index));
            continue;
        }
        let mapped_left = id_at(in mapped, widen_u64(original.a));
        let mapped_right = id_at(in mapped, widen_u64(original.b));
        let mut rebuilt: u32 = 0;
        let e = intern(
            inout builder,
            op_term(original.kind, original.tag, original.op, mapped_left, mapped_right),
            inout budget,
            inout rebuilt
        );
        if e != 0 {
            return e;
        }
        if widen_u64(rebuilt) != index {
            let mut first: u32 = 0;
            let e = equality(inout builder, original.a, mapped_left, inout budget, inout first);
            if e != 0 {
                return e;
            }
            let mut second: u32 = 0;
            let e = equality(inout builder, original.b, mapped_right, inout budget, inout second);
            if e != 0 {
                return e;
            }
            let mut proof_id: u32 = 0;
            let e = proof(
                inout builder,
                proof_row(wrapping_u32(index), rebuilt, P_CONGRUENCE, first, second),
                inout budget,
                inout proof_id
            );
            if e != 0 {
                return e;
            }
            let mut joined = false;
            let e = join(inout builder, proof_id, inout budget, inout joined);
            if e != 0 {
                return e;
            }
        }
        let left_term = term_get(in builder.terms, mapped_left);
        let right_term = term_get(in builder.terms, mapped_right);
        let mut value: i128 = 0;
        let wrapping = original.tag == T_WRAPPING;
        let folded = left_term.tag == T_CONST
            && right_term.tag == T_CONST
            && fold_value(
                builder.kind,
                wrapping,
                original.op,
                left_term.value,
                right_term.value,
                inout value
            );
        if folded {
            let mut output: u32 = 0;
            let e = intern(
                inout builder,
                const_term(builder.kind, value),
                inout budget,
                inout output
            );
            if e != 0 {
                return e;
            }
            let base: u32 = if wrapping { 22 } else { 19 };
            let rule = wrapping_add(base, widen_u32(original.op));
            let mut proof_id: u32 = 0;
            let e = proof(
                inout builder,
                rule_row(rebuilt, output, rule, mapped_left, mapped_right, 0, 2, NONE),
                inout budget,
                inout proof_id
            );
            if e != 0 {
                return e;
            }
            let mut joined = false;
            let e = join(inout builder, proof_id, inout budget, inout joined);
            if e != 0 {
                return e;
            }
            mapped.try_set(index, output);
        } else {
            mapped.try_set(index, rebuilt);
        }
    }
    out = id_at(in mapped, widen_u64(top));
    0
}

fn checked_op(
    inout builder: Builder,
    op: u8,
    x: u32,
    y: u32,
    inout budget: Budget,
    inout id: u32
) -> u8 {
    let kind = builder.kind;
    intern(inout builder, op_term(kind, T_CHECKED, op, x, y), inout budget, inout id)
}

fn wrapping_op(
    inout builder: Builder,
    op: u8,
    x: u32,
    y: u32,
    inout budget: Budget,
    inout id: u32
) -> u8 {
    let kind = builder.kind;
    intern(inout builder, op_term(kind, T_WRAPPING, op, x, y), inout budget, inout id)
}

// `instance`: the two sides of rule `rule` at bindings x, y, z, and the
// term it erases (NONE when it erases none).
fn instance(
    inout builder: Builder,
    rule: u32,
    x: u32,
    y: u32,
    z: u32,
    inout budget: Budget,
    inout left: u32,
    inout right: u32,
    inout erased: u32
) -> u8 {
    let kind = builder.kind;
    let mut zero: u32 = 0;
    let e = intern(inout builder, const_term(kind, 0), inout budget, inout zero);
    if e != 0 {
        return e;
    }
    let mut one: u32 = 0;
    let e = intern(inout builder, const_term(kind, 1), inout budget, inout one);
    if e != 0 {
        return e;
    }
    erased = NONE;
    if rule >= 1 && rule <= 8 {
        let op = if rule <= 2 {
            OP_ADD
        } else if rule == 3 || rule == 8 {
            OP_SUB
        } else {
            OP_MUL
        };
        let mut lhs_left = x;
        let mut lhs_right = zero;
        if rule == 2 || rule == 7 {
            lhs_left = zero;
            lhs_right = x;
        } else if rule == 4 {
            lhs_right = one;
        } else if rule == 5 {
            lhs_left = one;
            lhs_right = x;
        } else if rule == 8 {
            lhs_right = x;
        }
        let e = checked_op(inout builder, op, lhs_left, lhs_right, inout budget, inout left);
        if e != 0 {
            return e;
        }
        if rule >= 6 {
            right = zero;
            erased = x;
        } else {
            right = x;
        }
        return 0;
    }
    if rule >= 9 && rule <= 11 {
        let op = if rule == 9 {
            OP_ADD
        } else if rule == 10 {
            OP_SUB
        } else {
            OP_MUL
        };
        let operand = if rule == 11 { one } else { zero };
        right = x;
        return wrapping_op(inout builder, op, x, operand, inout budget, inout left);
    }
    if rule == 12 || rule == 13 {
        let op = if rule == 12 { OP_ADD } else { OP_MUL };
        let e = wrapping_op(inout builder, op, x, y, inout budget, inout left);
        if e != 0 {
            return e;
        }
        return wrapping_op(inout builder, op, y, x, inout budget, inout right);
    }
    if rule == 14 || rule == 15 {
        let op = if rule == 14 { OP_ADD } else { OP_MUL };
        let mut xy: u32 = 0;
        let e = wrapping_op(inout builder, op, x, y, inout budget, inout xy);
        if e != 0 {
            return e;
        }
        let mut yz: u32 = 0;
        let e = wrapping_op(inout builder, op, y, z, inout budget, inout yz);
        if e != 0 {
            return e;
        }
        let e = wrapping_op(inout builder, op, xy, z, inout budget, inout left);
        if e != 0 {
            return e;
        }
        return wrapping_op(inout builder, op, x, yz, inout budget, inout right);
    }
    if rule == 16 {
        let mut sum: u32 = 0;
        let e = wrapping_op(inout builder, OP_ADD, x, y, inout budget, inout sum);
        if e != 0 {
            return e;
        }
        right = x;
        erased = y;
        return wrapping_op(inout builder, OP_SUB, sum, y, inout budget, inout left);
    }
    if rule == 17 || rule == 18 {
        let op = if rule == 17 { OP_MUL } else { OP_SUB };
        let operand = if rule == 17 { zero } else { x };
        right = zero;
        erased = x;
        return wrapping_op(inout builder, op, x, operand, inout budget, inout left);
    }
    E_UNKNOWN_RULE
}

fn rule_arity(rule: u32) -> u32 {
    if rule == 12 || rule == 13 || rule == 16 {
        2
    } else if rule == 14 || rule == 15 {
        3
    } else {
        1
    }
}

// ---------------------------------------------------------------- search

// A recorded application (`Record`): the rule (1-based) and the classes of
// its variables.
copy struct Rec {
    rule: u32,
    b0: u32,
    b1: u32,
    b2: u32,
    len: u32
}

// certificate.rs's `Capture`, less its error (every error returns at once:
// after one, egg's run changes nothing more and its result is that error).
struct Capture {
    records: ChunkSeq[Rec],
    records_cap: u64,
    node_capacity: u64
}

// `Capture::nodes`: prepaid graph storage for `required` nodes.
fn capture_nodes(inout capture: Capture, required: u64, inout budget: Budget) -> u8 {
    if required > RAW_NODES {
        return E_LIMIT;
    }
    if required <= capture.node_capacity {
        return 0;
    }
    let mut doubled: u64 = 0;
    let e = mul_or(capture.node_capacity, 2, inout doubled);
    if e != 0 {
        return e;
    }
    let target = min(max(required, doubled), RAW_NODES);
    let mut nodes: u64 = 0;
    let e = mul_or(target, 512, inout nodes);
    if e != 0 {
        return e;
    }
    let mut squared: u64 = 0;
    let e = mul_or(target, target, inout squared);
    if e != 0 {
        return e;
    }
    let mut cleanup: u64 = 0;
    let e = mul_or(squared, 128, inout cleanup);
    if e != 0 {
        return e;
    }
    let mut total: u64 = 0;
    let e = add_or(nodes, cleanup, inout total);
    if e != 0 {
        return e;
    }
    let e = metadata(inout budget, total);
    if e != 0 {
        return e;
    }
    capture.node_capacity = target;
    0
}

// The concrete nodes of each rule's left side (egg's compacted
// `PatternAst`): its length, and up to two (operator, constant) pairs,
// constant -1 for an operator node.
copy struct Lhs {
    len: u64,
    pair_count: u64,
    op0: u32,
    const0: i64,
    op1: u32,
    const1: i64
}

fn lhs(len: u64, op0: u32, const0: i64, op1: u32, const1: i64) -> Lhs {
    Lhs {
        len: len,
        pair_count: if op1 == NONE { 1 } else { 2 },
        op0: op0,
        const0: const0,
        op1: op1,
        const1: const1
    }
}

// rules 1-18 (`optimize::rules()`).
fn lhs_of(rule_index: u64) -> Lhs {
    let add: u32 = 1;
    let sub: u32 = 2;
    let mul: u32 = 3;
    let wadd: u32 = 4;
    let wsub: u32 = 5;
    let wmul: u32 = 6;
    let num: u32 = M_NUM;
    if rule_index == 0 || rule_index == 1 {
        lhs(3, add, -1, num, 0)
    } else if rule_index == 2 {
        lhs(3, sub, -1, num, 0)
    } else if rule_index == 3 || rule_index == 4 {
        lhs(3, mul, -1, num, 1)
    } else if rule_index == 5 || rule_index == 6 {
        lhs(3, mul, -1, num, 0)
    } else if rule_index == 7 {
        lhs(2, sub, -1, NONE, 0)
    } else if rule_index == 8 {
        lhs(3, wadd, -1, num, 0)
    } else if rule_index == 9 {
        lhs(3, wsub, -1, num, 0)
    } else if rule_index == 10 {
        lhs(3, wmul, -1, num, 1)
    } else if rule_index == 11 {
        lhs(3, wadd, -1, NONE, 0)
    } else if rule_index == 12 {
        lhs(3, wmul, -1, NONE, 0)
    } else if rule_index == 13 {
        lhs(5, wadd, -1, wadd, -1)
    } else if rule_index == 14 {
        lhs(5, wmul, -1, wmul, -1)
    } else if rule_index == 15 {
        lhs(4, wsub, -1, wadd, -1)
    } else if rule_index == 16 {
        lhs(3, wmul, -1, num, 0)
    } else {
        lhs(2, wsub, -1, NONE, 0)
    }
}

// The raw nodes an egg pattern node matches (`Language::matches`: the same
// operator, and the same constant for `Num`).
fn count_matching(in graph: EGraph, op: u32, constant: i64) -> u64 {
    let mut n: u64 = 0;
    for k in 0..graph.raw_len() {
        let id = wrapping_u32(k);
        if graph.raw_op(id) == op && (op != M_NUM || graph.raw_data(id) == constant) {
            n = wrapping_add(n, 1);
        }
    }
    n
}

// `BoundedScheduler::search_rewrite` for rule `rule_index`.
fn schedule(
    in graph: EGraph,
    in rules: Rules,
    rule_index: u64,
    inout matches: Matches,
    inout budget: Budget
) -> u8 {
    let pattern = lhs_of(rule_index);
    let raw = graph.raw_len();
    let mut scan: u64 = 0;
    let e = mul_or(raw, 2, inout scan);
    if e != 0 {
        return e;
    }
    let e = add_to(inout scan, pattern.len);
    if e != 0 {
        return e;
    }
    let e = work(inout budget, scan);
    if e != 0 {
        return e;
    }
    let mut combinations = count_matching(in graph, pattern.op0, pattern.const0);
    if pattern.pair_count == 2 {
        let second = count_matching(in graph, pattern.op1, pattern.const1);
        let e = mul_to(inout combinations, second);
        if e != 0 {
            return e;
        }
    }
    if combinations == 0 {
        return 0;
    }
    let mut cost: u64 = 0;
    let e = mul_or(raw, combinations, inout cost);
    if e != 0 {
        return e;
    }
    let e = mul_to(inout cost, 8);
    if e != 0 {
        return e;
    }
    let e = add_to(inout cost, 32);
    if e != 0 {
        return e;
    }
    let e = work(inout budget, cost);
    if e != 0 {
        return e;
    }
    let mut scratch: u64 = 0;
    let e = add_or(raw, combinations, inout scratch);
    if e != 0 {
        return e;
    }
    let e = mul_to(inout scratch, 512);
    if e != 0 {
        return e;
    }
    let e = metadata(inout budget, scratch);
    if e != 0 {
        return e;
    }
    let found = search_rule(in graph, in rules, rule_index, MATCHES, inout matches);
    if found >= MATCHES {
        return E_LIMIT;
    }
    0
}

// `RecordingApplier::apply_one` for match `match_index` of rule
// `rule_index`; `applied` is set when the rule's union merged two classes.
fn apply(
    inout graph: EGraph,
    in rules: Rules,
    rule_index: u64,
    in matches: Matches,
    match_index: u64,
    inout ids: ChunkSeq[u32],
    inout capture: Capture,
    inout budget: Budget,
    inout applied: bool
) -> u8 {
    applied = false;
    let raw = graph.raw_len();
    let mut cost: u64 = 0;
    let e = mul_or(raw, 4, inout cost);
    if e != 0 {
        return e;
    }
    let e = add_to(inout cost, 32);
    if e != 0 {
        return e;
    }
    let e = work(inout budget, cost);
    if e != 0 {
        return e;
    }
    if wrapping_add(raw, APPLICATION_NODES) > RAW_NODES || capture.records.len() >= RECORDS {
        return E_LIMIT;
    }
    let e = capture_nodes(inout capture, wrapping_add(raw, APPLICATION_NODES), inout budget);
    if e != 0 {
        return e;
    }
    let e = grow(inout budget, capture.records.len(), inout capture.records_cap, RECORDS, S_RECORD);
    if e != 0 {
        return e;
    }
    let mut bytes: u64 = 0;
    let e = mul_or(raw, 128, inout bytes);
    if e != 0 {
        return e;
    }
    let e = add_to(inout bytes, 256);
    if e != 0 {
        return e;
    }
    let e = metadata(inout budget, bytes);
    if e != 0 {
        return e;
    }
    if !guard_holds(in graph, in rules, rule_index, in matches, match_index) {
        return 0;
    }
    if apply_one(inout graph, in rules, rule_index, in matches, match_index, inout ids) {
        let rule = wrapping_u32(wrapping_add(rule_index, 1));
        let arity = rule_arity(rule);
        let b1 = if arity >= 2 {
            matches.val(match_index, 1)
        } else {
            0
        };
        let b2 = if arity >= 3 {
            matches.val(match_index, 2)
        } else {
            0
        };
        capture
            .records
            .push(Rec { rule: rule, b0: matches.val(match_index, 0), b1: b1, b2: b2, len: arity });
        applied = true;
    }
    0
}

// `root_has_leaf`: the root class holds a constant of the kind or one of
// the variables.
fn root_has_leaf(in graph: EGraph, top: u32, kind: u8, vars: u64) -> bool {
    let root_class = graph.find(top);
    let first_node = graph.class_start(root_class);
    for k in first_node..wrapping_add(first_node, graph.class_len(root_class)) {
        let op = graph.node_op(k);
        let data = graph.node_data(k);
        if op == M_NUM && fits(kind, widen_i128(data)) {
            return true;
        }
        if op == M_INPUT && data >= 0 && wrapping_u64(data) < vars {
            return true;
        }
    }
    false
}

const STOP_SATURATED: u8 = 1;
const STOP_LIMIT: u8 = 2;
const STOP_HOOK: u8 = 4;

// egg's `Runner::run` with certificate.rs's scheduler, applier and hook;
// `stop` is how it stopped.
fn run_search(
    inout graph: EGraph,
    in rules: Rules,
    top: u32,
    kind: u8,
    vars: u64,
    inout capture: Capture,
    inout budget: Budget,
    inout stop: u8
) -> u8 {
    graph.rebuild();
    let mut ids: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut iterations: u64 = 0;
    loop {
        if graph.memo_len() > RAW_NODES || iterations >= ITERATIONS {
            stop = STOP_LIMIT;
            return 0;
        }
        let nodes_before = graph.memo_len();
        let classes_before = graph.class_count();
        // The hook.
        let e = work(inout budget, graph.raw_len());
        if e != 0 {
            return e;
        }
        if root_has_leaf(in graph, top, kind, vars) {
            graph.rebuild();
            stop = STOP_HOOK;
            return 0;
        }
        let mut matches = matches_new();
        for rule_index in 0..rules.count() {
            matches.mark();
            let e = schedule(in graph, in rules, rule_index, inout matches, inout budget);
            if e != 0 {
                return e;
            }
        }
        matches.mark();
        let mut any = false;
        let mut over = false;
        for rule_index in 0..rules.count() {
            let (lo, hi) = matches.range(rule_index);
            for match_index in lo..hi {
                let mut applied = false;
                let e = apply(
                    inout graph,
                    in rules,
                    rule_index,
                    in matches,
                    match_index,
                    inout ids,
                    inout capture,
                    inout budget,
                    inout applied
                );
                if e != 0 {
                    return e;
                }
                if applied {
                    any = true;
                }
            }
            if graph.memo_len() > RAW_NODES {
                over = true;
                break;
            }
        }
        graph.rebuild();
        if over {
            stop = STOP_LIMIT;
            return 0;
        }
        if !any && graph.memo_len() == nodes_before && graph.class_count() == classes_before {
            stop = STOP_SATURATED;
            return 0;
        }
        iterations = wrapping_add(iterations, 1);
    }
}

// One `Math` node of an expression list: operator, data, two children.
copy struct MathNode {
    op: u32,
    data: i64,
    child0: u32,
    child1: u32
}

fn math_op(term: TermRow) -> u32 {
    let base: u32 = if term.tag == T_WRAPPING { 4 } else { 1 };
    wrapping_add(base, widen_u32(term.op))
}

// `encode_graph`: the reachable terms below `top` as a `RecExpr`; false
// (with no error) when a reachable constant is outside `i64`.
fn encode_graph(
    in terms: ChunkSeq[TermRow],
    top: u32,
    inout budget: Budget,
    inout nodes: ChunkSeq[MathNode],
    inout ok: bool
) -> u8 {
    let n = terms.len();
    let e = initialized(inout budget, n, S_BOOL);
    if e != 0 {
        return e;
    }
    let mut reachable: ChunkSeq[bool] = ChunkSeq::with_capacity[bool](n);
    reachable.resize(n, false);
    reachable.try_set(widen_u64(top), true);
    let i64_min: i128 = -9223372036854775808;
    let i64_max: i128 = 9223372036854775807;
    for j in 0..n {
        let index = wrapping_sub(wrapping_sub(n, 1), j);
        let e = work(inout budget, 1);
        if e != 0 {
            return e;
        }
        let live = reachable.try_get(index).unwrap_or(false);
        if !live {
            continue;
        }
        let term = term_get(in terms, wrapping_u32(index));
        if term.tag == T_CONST && (term.value < i64_min || term.value > i64_max) {
            ok = false;
            return 0;
        }
        if is_binary(term) {
            if widen_u64(term.a) >= index || widen_u64(term.b) >= index {
                return E_NON_TOPOLOGICAL_TERM;
            }
            reachable.try_set(widen_u64(term.a), true);
            reachable.try_set(widen_u64(term.b), true);
        }
    }
    let e = initialized(inout budget, n, S_OPTION_ID);
    if e != 0 {
        return e;
    }
    let mut map: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](n);
    map.resize(n, NONE);
    let mut cap: u64 = 0;
    nodes.clear();
    for i in 0..n {
        let live = reachable.try_get(i).unwrap_or(false);
        if !live {
            continue;
        }
        let e = work(inout budget, 1);
        if e != 0 {
            return e;
        }
        if nodes.len() >= RAW_NODES {
            return E_LIMIT;
        }
        let term = term_get(in terms, wrapping_u32(i));
        let mut node = MathNode { op: M_NUM, data: 0, child0: 0, child1: 0 };
        if term.tag == T_CONST {
            node.data = wrapping_i64(term.value);
        } else if term.tag == T_INPUT {
            node.op = M_INPUT;
            node.data = widen_i64(term.a);
        } else {
            let left_id = id_at(in map, widen_u64(term.a));
            let right_id = id_at(in map, widen_u64(term.b));
            if left_id == NONE || right_id == NONE {
                return E_INVALID_TERM_INDEX;
            }
            node.op = math_op(term);
            node.child0 = left_id;
            node.child1 = right_id;
        }
        let e = grow(inout budget, nodes.len(), inout cap, RAW_NODES, S_MATH);
        if e != 0 {
            return e;
        }
        map.try_set(i, wrapping_u32(nodes.len()));
        nodes.push(node);
    }
    ok = true;
    0
}

// `translate_math`: interns each node of an expression list (children
// first), giving each node's term.
fn translate(
    inout builder: Builder,
    in nodes: ChunkSeq[MathNode],
    vars: u64,
    inout budget: Budget,
    inout map: ChunkSeq[u32]
) -> u8 {
    let mut cap: u64 = 0;
    let e = reserve(inout budget, 0, inout cap, nodes.len(), S_TERM_ID);
    if e != 0 {
        return e;
    }
    map.clear();
    let kind = builder.kind;
    for i in 0..nodes.len() {
        let e = work(inout budget, 1);
        if e != 0 {
            return e;
        }
        let node = match nodes.try_get(i) {
            Option::Some(v) => v,
            Option::None => return E_INVALID_TERM_INDEX,
        };
        let binary = node.op != M_NUM && node.op != M_INPUT;
        if binary && (widen_u64(node.child0) >= i || widen_u64(node.child1) >= i) {
            return E_NON_TOPOLOGICAL_TERM;
        }
        let term = if node.op == M_NUM {
            const_term(kind, widen_i128(node.data))
        } else if node.op == M_INPUT {
            if wrapping_u64(node.data) >= vars {
                return E_UNKNOWN_VARIABLE;
            }
            input_term(kind, wrapping_u32(node.data))
        } else {
            let left_id = id_at(in map, widen_u64(node.child0));
            let right_id = id_at(in map, widen_u64(node.child1));
            let tag = if node.op >= 4 { T_WRAPPING } else { T_CHECKED };
            let base: u32 = if node.op >= 4 { 4 } else { 1 };
            op_term(kind, tag, wrapping_u8(wrapping_sub(node.op, base)), left_id, right_id)
        };
        let mut id: u32 = 0;
        let e = intern(inout builder, term, inout budget, inout id);
        if e != 0 {
            return e;
        }
        map.push(id);
    }
    0
}

fn explain_records(
    inout builder: Builder,
    in raw_map: ChunkSeq[u32],
    in records: ChunkSeq[Rec],
    from: u32,
    to: u32,
    inout budget: Budget,
    inout out: u32
) -> u8 {
    let n = records.len();
    let e = initialized(inout budget, n, S_BOOL);
    if e != 0 {
        return e;
    }
    let mut processed: ChunkSeq[bool] = ChunkSeq::with_capacity[bool](n);
    processed.resize(n, false);
    loop {
        let mut changed = false;
        let e = congruence(inout builder, inout budget, inout changed);
        if e != 0 {
            return e;
        }
        let mut root_from: u32 = 0;
        let e = root(in builder, from, inout budget, inout root_from);
        if e != 0 {
            return e;
        }
        let mut root_to: u32 = 0;
        let e = root(in builder, to, inout budget, inout root_to);
        if e != 0 {
            return e;
        }
        if root_from == root_to {
            return equality(inout builder, from, to, inout budget, inout out);
        }
        for i in 0..n {
            let e = work(inout budget, 1);
            if e != 0 {
                return e;
            }
            let done = processed.try_get(i).unwrap_or(true);
            if done {
                continue;
            }
            let record = match records.try_get(i) {
                Option::Some(v) => v,
                Option::None => return E_INVALID_SUBSTITUTION,
            };
            if record.len != rule_arity(record.rule) {
                return E_INVALID_SUBSTITUTION;
            }
            let mut x: u32 = 0;
            let mut y: u32 = 0;
            let mut z: u32 = 0;
            if record.len >= 1 {
                if widen_u64(record.b0) >= raw_map.len() {
                    return E_INVALID_SUBSTITUTION;
                }
                x = id_at(in raw_map, widen_u64(record.b0));
            }
            if record.len >= 2 {
                if widen_u64(record.b1) >= raw_map.len() {
                    return E_INVALID_SUBSTITUTION;
                }
                y = id_at(in raw_map, widen_u64(record.b1));
            }
            if record.len >= 3 {
                if widen_u64(record.b2) >= raw_map.len() {
                    return E_INVALID_SUBSTITUTION;
                }
                z = id_at(in raw_map, widen_u64(record.b2));
            }
            let before = builder.terms.len();
            let mut left: u32 = 0;
            let mut right: u32 = 0;
            let mut erased: u32 = NONE;
            let e = instance(
                inout builder,
                record.rule,
                x,
                y,
                z,
                inout budget,
                inout left,
                inout right,
                inout erased
            );
            if e != 0 {
                return e;
            }
            if builder.terms.len() != before {
                changed = true;
            }
            let e = root(in builder, left, inout budget, inout root_from);
            if e != 0 {
                return e;
            }
            let e = root(in builder, right, inout budget, inout root_to);
            if e != 0 {
                return e;
            }
            if root_from == root_to {
                processed.try_set(i, true);
                continue;
            }
            let mut guard_proof: u32 = NONE;
            if erased != NONE {
                let mut guard_kind: u8 = 0;
                let mut leaf_proof: u32 = 0;
                let e = guard(
                    inout builder,
                    erased,
                    inout budget,
                    inout guard_kind,
                    inout leaf_proof
                );
                if e != 0 {
                    return e;
                }
                if guard_kind == 0 {
                    continue;
                }
                if guard_kind == 2 {
                    guard_proof = leaf_proof;
                }
            }
            let mut proof_id: u32 = 0;
            let e = proof(
                inout builder,
                rule_row(left, right, record.rule, x, y, z, record.len, guard_proof),
                inout budget,
                inout proof_id
            );
            if e != 0 {
                return e;
            }
            let mut joined = false;
            let e = join(inout builder, proof_id, inout budget, inout joined);
            if e != 0 {
                return e;
            }
            if joined {
                changed = true;
            }
            processed.try_set(i, true);
        }
        if !changed {
            return E_INVALID_EQUALITY;
        }
    }
}

// `run_graph` and the translation of its result: the best term of the
// folded root's class, proven equal to it. `best` is the folded root when
// the search keeps it.
fn search(
    inout builder: Builder,
    in nodes: ChunkSeq[MathNode],
    folded: u32,
    vars: u64,
    inout budget: Budget,
    inout best: u32
) -> u8 {
    let e = metadata(inout budget, wrapping_mul(wrapping_add(RULE_COUNT, ITERATIONS), 512));
    if e != 0 {
        return e;
    }
    let e = work(inout budget, nodes.len());
    if e != 0 {
        return e;
    }
    let mut capture = Capture { records: ChunkSeq::new[Rec](), records_cap: 0, node_capacity: 0 };
    let e = capture_nodes(inout capture, max(nodes.len(), 4), inout budget);
    if e != 0 {
        return e;
    }
    let rules = math_rules();
    if rules.count() != RULE_COUNT {
        return E_UNKNOWN_RULE;
    }
    let arity = math_arity();
    let mut graph = egraph_new(in arity);
    let mut ids: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](nodes.len());
    let mut last: u32 = 0;
    for i in 0..nodes.len() {
        let node = match nodes.try_get(i) {
            Option::Some(v) => v,
            Option::None => return E_INVALID_TERM_INDEX,
        };
        let node_arity = graph.arity_of(node.op);
        let child0 = if node_arity >= 1 {
            id_at(in ids, widen_u64(node.child0))
        } else {
            0
        };
        let child1 = if node_arity >= 2 {
            id_at(in ids, widen_u64(node.child1))
        } else {
            0
        };
        let id = graph.add_uncanonical(node.op, node.data, child0, child1);
        ids.push(id);
        last = id;
    }
    let top = graph.find(last);
    let kind = builder.kind;
    let mut stop: u8 = 0;
    let e = run_search(
        inout graph,
        in rules,
        top,
        kind,
        vars,
        inout capture,
        inout budget,
        inout stop
    );
    if e != 0 {
        return e;
    }
    let raw = graph.raw_len();
    let e = work(inout budget, raw);
    if e != 0 {
        return e;
    }
    // `normal_completion`.
    if raw > RAW_NODES {
        return E_LIMIT;
    }
    let complete = stop == STOP_SATURATED
        || stop == STOP_HOOK && root_has_leaf(in graph, top, kind, vars);
    if !complete {
        return E_LIMIT;
    }
    let mut squared: u64 = 0;
    let e = mul_or(raw, raw, inout squared);
    if e != 0 {
        return e;
    }
    let e = mul_to(inout squared, 8);
    if e != 0 {
        return e;
    }
    let e = work(inout budget, squared);
    if e != 0 {
        return e;
    }
    let mut extraction = extractor(in graph);
    let cost = extraction.cost_of(in graph, top);
    if cost == 0 || cost > budget.max_output_nodes {
        return E_LIMIT;
    }
    if !extraction.find_best(in graph, top) {
        return E_LIMIT;
    }
    if extraction.len() > budget.max_terms {
        return E_LIMIT;
    }
    let mut extracted: ChunkSeq[MathNode] = ChunkSeq::with_capacity[MathNode](extraction.len());
    for i in 0..extraction.len() {
        extracted.push(
            MathNode {
                op: extraction.op_at(i),
                data: extraction.data_at(i),
                child0: extraction.child_at(i, 0),
                child1: extraction.child_at(i, 1)
            }
        );
    }
    let mut best_map: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let e = translate(inout builder, in extracted, vars, inout budget, inout best_map);
    if e != 0 {
        return e;
    }
    if best_map.len() == 0 {
        return E_INVALID_TERM_INDEX;
    }
    best = id_at(in best_map, wrapping_sub(best_map.len(), 1));
    if best != folded {
        let mut graph_nodes: ChunkSeq[MathNode] = ChunkSeq::with_capacity[MathNode](raw);
        for k in 0..raw {
            let id = wrapping_u32(k);
            graph_nodes.push(
                MathNode {
                    op: graph.raw_op(id),
                    data: graph.raw_data(id),
                    child0: graph.raw_child(id, 0),
                    child1: graph.raw_child(id, 1)
                }
            );
        }
        let mut raw_map: ChunkSeq[u32] = ChunkSeq::new[u32]();
        let e = translate(inout builder, in graph_nodes, vars, inout budget, inout raw_map);
        if e != 0 {
            return e;
        }
        let mut proof_id: u32 = 0;
        let e = explain_records(
            inout builder,
            in raw_map,
            in capture.records,
            folded,
            best,
            inout budget,
            inout proof_id
        );
        if e != 0 {
            return e;
        }
    }
    0
}

// ---------------------------------------------------------------- propose

// The proposal of `propose`: the certificate (the builder's terms and
// proofs, with their capacities) and the candidate expression in the tree.
pub struct Proposal {
    outcome: u8,
    input: u32,
    output: u32,
    conclusion: u32,
    candidate: u32
}

pub fn proposal_new() -> Proposal {
    Proposal { outcome: O_UNCHANGED, input: 0, output: 0, conclusion: 0, candidate: 0 }
}

fn is_barrier(code: u8) -> bool {
    code >= E_UNSUPPORTED_AST && code <= E_INVALID_INTRINSIC_ORIGIN
}

// `propose_rewrite`: a fresh budget of the limits in `budget`, the source
// expression `top` of `tree`. Returns an error code (`Err`), else 0 with the
// outcome in `proposal`; for a candidate, `builder` holds the certificate,
// `budget` the spent budget and the candidate is built into `tree`.
pub fn propose(
    inout tree: Tree,
    in ops: Ops,
    in types: ChunkSeq[TypeRow],
    top: u32,
    inout budget: Budget,
    inout builder: Builder,
    inout proposal: Proposal
) -> u8 {
    budget.work = 0;
    budget.metadata = 0;
    budget.names = 0;
    if valid_limits(in budget) != 0 {
        return E_INVALID_LIMITS;
    }
    let mut bound = bound_new();
    let e = bind_source(in tree, in ops, in types, top, inout budget, inout bound);
    if is_barrier(e) {
        proposal.outcome = O_BARRIER;
        return 0;
    }
    if e != 0 {
        return e;
    }
    builder = builder_new(bound.kind, in budget);
    let vars = bound.names.len();
    let n = bound.terms.len();
    let mut cap: u64 = 0;
    let e = reserve(inout budget, 0, inout cap, n, S_TERM_ID);
    if e != 0 {
        return e;
    }
    let mut source_map: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](n);
    for i in 0..n {
        let e = work(inout budget, 1);
        if e != 0 {
            return e;
        }
        let mut term = term_get(in bound.terms, wrapping_u32(i));
        if is_binary(term) {
            if widen_u64(term.a) >= i || widen_u64(term.b) >= i {
                return E_NON_TOPOLOGICAL_TERM;
            }
            term.a = id_at(in source_map, widen_u64(term.a));
            term.b = id_at(in source_map, widen_u64(term.b));
        }
        let mut id: u32 = 0;
        let e = intern(inout builder, term, inout budget, inout id);
        if e != 0 {
            return e;
        }
        source_map.push(id);
    }
    if widen_u64(bound.root) >= source_map.len() {
        return E_INVALID_TERM_INDEX;
    }
    let input = id_at(in source_map, widen_u64(bound.root));
    let count = builder.terms.len();
    let mut folded: u32 = 0;
    let e = fold_prefix(inout builder, count, input, inout budget, inout folded);
    if e != 0 {
        return e;
    }
    let mut nodes: ChunkSeq[MathNode] = ChunkSeq::new[MathNode]();
    let mut searchable = false;
    let e = encode_graph(in builder.terms, folded, inout budget, inout nodes, inout searchable);
    if e != 0 {
        return e;
    }
    let mut output = folded;
    if searchable {
        let e = search(inout builder, in nodes, folded, vars, inout budget, inout output);
        if e != 0 {
            return e;
        }
    }
    if output == input {
        proposal.outcome = O_UNCHANGED;
        return 0;
    }
    let mut conclusion: u32 = 0;
    let e = equality(inout builder, input, output, inout budget, inout conclusion);
    if e != 0 {
        return e;
    }
    let mut candidate: u32 = 0;
    let e = build_candidate(
        inout tree,
        in ops,
        in bound,
        in builder.terms,
        output,
        inout budget,
        inout candidate
    );
    if e != 0 {
        return e;
    }
    let e = metadata(inout budget, S_PROPOSAL);
    if e != 0 {
        return e;
    }
    proposal.outcome = O_CANDIDATE;
    proposal.input = input;
    proposal.output = output;
    proposal.conclusion = conclusion;
    proposal.candidate = candidate;
    0
}
