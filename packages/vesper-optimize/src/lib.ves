// @vesper/optimize: the AST arithmetic optimizer of src/optimize.rs in
// Vesper (self-hosting wave SH3, lane 10, #1249). Rust stays the default
// optimizer; this is a non-default port with a differential
// (tests/self_host_optimize.rs).
//
// - budget.ves: `WitnessBudget` and the Rust vector capacities it charges.
// - input.ves: the decoded expressions (an `@vesper/ast` `Ast`), the
//   expression types and a certificate.
// - witness.ves: the certificate checker and the candidate builder of
//   src/optimize/witness.rs.
//
// - search.ves: the proof producer of src/optimize/certificate.rs
//   (`propose_rewrite`) on `@vesper/egraph`.

use @vesper/ast::{ArgNode, expr_at, list_at, list_len, lit_at, none};
use @vesper-std/arena::{idx_from_raw};
use @vesper-std/intern::{symbol_from_id};
use self::budget::{Budget, valid_limits};
use self::input::{
    Cert, Reader, Tree, TypeRow, cert_new, mapped, read_cert, read_exprs, read_names,
    read_names_text, read_types, tree_new
};
use self::search::{Builder, Proposal, builder_new, proposal_new, propose};
use self::input::{ProofRow, TermRow};
use self::witness::{
    Bound, Ops, bind_source, bound_new, build_candidate, ops_new, rust_sizes, scratch_new, verify
};

fn put(inout output: ChunkSeq[u8], in text: Str) {
    output.extend(in text.as_bytes());
}

fn put_u128(inout output: ChunkSeq[u8], value: u128) {
    if value >= 10 {
        put_u128(inout output, value / 10);
    }
    output.push(wrapping_u8(wrapping_add(value % 10, 48)));
}

fn put_u64(inout output: ChunkSeq[u8], value: u64) {
    if value >= 10 {
        put_u64(inout output, value / 10);
    }
    output.push(wrapping_u8(wrapping_add(value % 10, 48)));
}

fn put_sym(inout output: ChunkSeq[u8], in tree: Tree, sym: u32) {
    if sym == none() {
        put(inout output, "<none>");
        return;
    }
    let (start, end) = tree.ast.names.span(symbol_from_id(sym));
    for i in start..end {
        match tree.ast.names.text_byte(i) {
            Option::Some(byte) => output.push(byte),
            Option::None => {}
        }
    }
}

fn put_span(inout output: ChunkSeq[u8], start: u32, end: u32) {
    output.push(64);
    put_u64(inout output, widen_u64(start));
    output.push(58);
    put_u64(inout output, widen_u64(end));
}

// The candidate dump the differential compares (the Rust side writes the
// same text from a Rust `Expr`).
pub fn dump_expr(inout output: ChunkSeq[u8], in tree: Tree, expr: u32) {
    let node = expr_at(in tree.ast, expr);
    if node.kind == 1 {
        let lit = lit_at(in tree.ast, node.a);
        if lit.kind != 1 {
            put(inout output, "lit");
        } else {
            if lit.neg && (lit.bits != 0 || lit.hi != 0) {
                output.push(45);
            }
            if lit.hi == 0 {
                put_u64(inout output, lit.bits);
            } else {
                put_u128(
                    inout output,
                    wrapping_shl_u128(widen_u128(lit.hi), 64) | widen_u128(lit.bits)
                );
            }
        }
        put_span(inout output, node.start, node.end);
    } else if node.kind == 2 {
        put_sym(inout output, in tree, node.a);
        put_span(inout output, node.start, node.end);
    } else if node.kind == 11 {
        output.push(40);
        put_sym(inout output, in tree, node.a);
        put_span(inout output, node.start, node.end);
        output.push(32);
        dump_expr(inout output, in tree, node.b);
        output.push(32);
        dump_expr(inout output, in tree, node.c);
        output.push(41);
    } else if node.kind == 6 {
        put(inout output, "(call");
        put_span(inout output, node.start, node.end);
        output.push(32);
        dump_expr(inout output, in tree, node.a);
        put(inout output, " [");
        put_u64(inout output, list_len(in tree.ast, node.b));
        output.push(93);
        for i in 0..list_len(in tree.ast, node.c) {
            let arg = tree.ast.args.get_or(
                idx_from_raw[ArgNode](list_at(in tree.ast, node.c, i)),
                ArgNode { pass: 255, explicit: false, expr: none() }
            );
            output.push(32);
            put_u64(inout output, widen_u64(arg.pass));
            if arg.explicit {
                output.push(33);
            }
            output.push(58);
            dump_expr(inout output, in tree, arg.expr);
        }
        output.push(41);
    } else {
        output.push(63);
        put_u64(inout output, widen_u64(node.kind));
        put_span(inout output, node.start, node.end);
    }
}

pub fn pack_text(in text: ChunkSeq[u8]) -> ChunkSeq[u64] {
    let n = text.len();
    let mut out = ChunkSeq::with_capacity[u64](wrapping_add(n >> 3, 2));
    out.push(n);
    let mut word: u64 = 0;
    let mut byte_count: u32 = 0;
    for i in 0..n {
        let byte = match text.try_get(i) {
            Option::Some(v) => widen_u64(v),
            Option::None => 0,
        };
        word = word | wrapping_shl_u64(byte, wrapping_mul(byte_count, 8));
        byte_count = wrapping_add(byte_count, 1);
        if byte_count == 8 {
            out.push(word);
            word = 0;
            byte_count = 0;
        }
    }
    if byte_count != 0 {
        out.push(word);
    }
    out
}

fn read_budget(inout reader: Reader, in bytes: Slice[u8]) -> Budget {
    Budget {
        max_terms: reader.word(in bytes),
        max_proofs: reader.word(in bytes),
        max_input_nodes: reader.word(in bytes),
        max_output_nodes: reader.word(in bytes),
        max_depth: reader.word(in bytes),
        max_variables: reader.word(in bytes),
        max_name_bytes: reader.word(in bytes),
        max_metadata_bytes: reader.word(in bytes),
        max_work: reader.word(in bytes),
        work: reader.word(in bytes),
        metadata: reader.word(in bytes),
        names: reader.word(in bytes)
    }
}

// Task "verify": a count of cases, each self-contained: the limits and
// spent counters, names, types, expressions, the source and candidate
// expressions, the certificate, and whether to build the candidate too.
// Per case it writes `R code work metadata names` (`verify_spent`'s
// result and counters; code 0 is `Ok`) and, when asked, `B code dump`:
// `build_candidate` of the certificate's output on a fresh budget.
pub fn optimize_verify(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    run_cases(in bytes, in input, false, true)
}

// `optimize_verify` over a split input: the words with the names' lengths
// only, and the names' text (`read_names_text`). The hybrid module's entry.
pub fn optimize_verify_split(in input: Slice[u8], in names: Str) -> ChunkSeq[u64] {
    run_cases(in input, in names, true, true)
}

// The same cases decoded only, with every result line `R 0 0 0 0`: the
// decode cost, which the speed test subtracts.
pub fn optimize_decode(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    run_cases(in bytes, in input, false, false)
}

// The names of one case: in the words (`text` is the whole input), or in
// `text` alone when the input is split. There every case's names follow
// the previous case's, and `text_offset` carries the offset across cases.
fn names_of(
    inout reader: Reader,
    in bytes: Slice[u8],
    in text: Str,
    split: bool,
    inout text_offset: u64,
    inout tree: Tree
) {
    if split {
        read_names_text(inout reader, in bytes, in text, inout text_offset, inout tree);
    } else {
        read_names(inout reader, in text, inout tree);
    }
}

fn run_cases(in bytes: Slice[u8], in text: Str, split: bool, check: bool) -> ChunkSeq[u64] {
    let mut reader = Reader { pos: 0 };
    let mut output = ChunkSeq::new[u8]();
    let mut map = ChunkSeq::new[u32]();
    let mut types = ChunkSeq::new[TypeRow]();
    let mut cert = cert_new();
    let mut scratch = scratch_new();
    let cases = reader.word(in bytes);
    let mut text_offset: u64 = 0;
    for k in 0..cases {
        let mut budget = read_budget(inout reader, in bytes);
        let mut tree = tree_new();
        names_of(inout reader, in bytes, in text, split, inout text_offset, inout tree);
        read_types(inout reader, in bytes, inout types);
        read_exprs(inout reader, in bytes, inout tree, inout map);
        let source = mapped(in map, reader.word(in bytes));
        let candidate = mapped(in map, reader.word(in bytes));
        read_cert(inout reader, in bytes, inout cert);
        let build = reader.word(in bytes) != 0;
        let ops = ops_new(inout tree);
        let fresh = budget;
        let mut code = valid_limits(in budget);
        if !check {
            budget.work = 0;
            budget.metadata = 0;
            budget.names = 0;
        } else if code == 0 {
            code = verify(
                inout tree,
                in ops,
                in types,
                source,
                candidate,
                in cert,
                inout budget,
                inout scratch
            );
        }
        put(inout output, "R ");
        put_u64(inout output, widen_u64(code));
        output.push(32);
        put_u64(inout output, budget.work);
        output.push(32);
        put_u64(inout output, budget.metadata);
        output.push(32);
        put_u64(inout output, budget.names);
        output.push(10);
        if build && check {
            let mut build_budget = fresh;
            build_budget.work = 0;
            build_budget.metadata = 0;
            build_budget.names = 0;
            let mut bound = bound_new();
            let mut code = bind_source(
                in tree,
                in ops,
                in types,
                source,
                inout build_budget,
                inout bound
            );
            let mut built = none();
            if code == 0 {
                code = build_candidate(
                    inout tree,
                    in ops,
                    in bound,
                    in cert.terms,
                    cert.output,
                    inout build_budget,
                    inout built
                );
            }
            put(inout output, "B ");
            put_u64(inout output, widen_u64(code));
            if code == 0 {
                output.push(32);
                dump_expr(inout output, in tree, built);
            }
            output.push(10);
        }
    }
    pack_text(in output)
}

// The Rust `size_of` values the checker charges with (the input is unused).
pub fn optimize_sizes(in input: Str) -> ChunkSeq[u64] {
    rust_sizes()
}

fn put_i128(inout output: ChunkSeq[u8], value: i128) {
    if value < 0 {
        output.push(45);
        put_u64(inout output, wrapping_u64(wrapping_neg_i128(value)));
    } else {
        put_u64(inout output, wrapping_u64(value));
    }
}

fn put_term(inout output: ChunkSeq[u8], term: TermRow) {
    output.push(32);
    put_u64(inout output, widen_u64(term.kind));
    output.push(58);
    put_u64(inout output, widen_u64(term.tag));
    output.push(58);
    put_u64(inout output, widen_u64(term.op));
    output.push(58);
    put_i128(inout output, term.value);
    output.push(58);
    put_u64(inout output, widen_u64(term.a));
    output.push(58);
    put_u64(inout output, widen_u64(term.b));
}

fn put_proof(inout output: ChunkSeq[u8], step: ProofRow) {
    output.push(32);
    put_u64(inout output, widen_u64(step.from));
    output.push(58);
    put_u64(inout output, widen_u64(step.to));
    output.push(58);
    put_u64(inout output, widen_u64(step.tag));
    output.push(58);
    put_u64(inout output, widen_u64(step.rule));
    output.push(58);
    put_u64(inout output, widen_u64(step.b0));
    output.push(58);
    put_u64(inout output, widen_u64(step.b1));
    output.push(58);
    put_u64(inout output, widen_u64(step.b2));
    output.push(58);
    put_u64(inout output, widen_u64(step.len));
    output.push(58);
    if step.has_guard {
        put_u64(inout output, wrapping_add(widen_u64(step.guard), 1));
    } else {
        output.push(48);
    }
    output.push(58);
    put_u64(inout output, widen_u64(step.p0));
    output.push(58);
    put_u64(inout output, widen_u64(step.p1));
}

// Task "propose": a count of cases, each the limits (and three unused
// spent words), names, types, expressions and the source expression. Per
// case it writes `propose_rewrite`'s outcome: `P B` (barrier), `P U`
// (unchanged), `P E code` (an error), or `P C work metadata names
// terms_cap proofs_cap input output conclusion` followed by the candidate
// (`C dump`), the certificate's terms (`T`, each `kind:tag:op:value:a:b`)
// and proofs (`Q`, each `from:to:tag:rule:b0:b1:b2:len:guard:p0:p1`,
// guard 0 for none, else the proof plus one).
pub fn optimize_propose(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    propose_cases(in bytes, in input, false, 0)
}

// `optimize_propose` over a split input (see `optimize_verify_split`).
pub fn optimize_propose_split(in input: Slice[u8], in names: Str) -> ChunkSeq[u64] {
    propose_cases(in input, in names, true, 0)
}

// The same cases for the speed test: `optimize_propose_quiet` proposes but
// writes only `P` per case (Rust's side builds the proposal and prints
// nothing), and `optimize_propose_decode` only decodes (its cost is
// subtracted).
pub fn optimize_propose_quiet(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    propose_cases(in bytes, in input, false, 1)
}

pub fn optimize_propose_decode(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    propose_cases(in bytes, in input, false, 2)
}

// `mode` 0 writes each proposal, 1 proposes and writes `P`, 2 decodes and
// writes `P`.
fn propose_cases(in bytes: Slice[u8], in text: Str, split: bool, mode: u8) -> ChunkSeq[u64] {
    let mut reader = Reader { pos: 0 };
    let mut output = ChunkSeq::new[u8]();
    let mut map = ChunkSeq::new[u32]();
    let mut types = ChunkSeq::new[TypeRow]();
    let cases = reader.word(in bytes);
    let mut text_offset: u64 = 0;
    for k in 0..cases {
        let mut budget = read_budget(inout reader, in bytes);
        let mut tree = tree_new();
        names_of(inout reader, in bytes, in text, split, inout text_offset, inout tree);
        read_types(inout reader, in bytes, inout types);
        read_exprs(inout reader, in bytes, inout tree, inout map);
        let source = mapped(in map, reader.word(in bytes));
        if mode == 2 {
            put(inout output, "P\n");
            continue;
        }
        let ops = ops_new(inout tree);
        let mut builder = builder_new(0, in budget);
        let mut proposal = proposal_new();
        let code = propose(
            inout tree,
            in ops,
            in types,
            source,
            inout budget,
            inout builder,
            inout proposal
        );
        if mode == 1 {
            put(inout output, "P\n");
            continue;
        }
        put(inout output, "P ");
        if code != 0 {
            put(inout output, "E ");
            put_u64(inout output, widen_u64(code));
            output.push(10);
            continue;
        }
        if proposal.outcome == 1 {
            put(inout output, "B\n");
            continue;
        }
        if proposal.outcome == 2 {
            put(inout output, "U\n");
            continue;
        }
        put(inout output, "C ");
        put_u64(inout output, budget.work);
        output.push(32);
        put_u64(inout output, budget.metadata);
        output.push(32);
        put_u64(inout output, budget.names);
        output.push(32);
        put_u64(inout output, builder.terms_cap);
        output.push(32);
        put_u64(inout output, builder.proofs_cap);
        output.push(32);
        put_u64(inout output, widen_u64(proposal.input));
        output.push(32);
        put_u64(inout output, widen_u64(proposal.output));
        output.push(32);
        put_u64(inout output, widen_u64(proposal.conclusion));
        put(inout output, "\nC ");
        dump_expr(inout output, in tree, proposal.candidate);
        put(inout output, "\nT");
        for i in 0..builder.terms.len() {
            match builder.terms.try_get(i) {
                Option::Some(row) => put_term(inout output, row),
                Option::None => {}
            }
        }
        put(inout output, "\nQ");
        for i in 0..builder.proofs.len() {
            match builder.proofs.try_get(i) {
                Option::Some(row) => put_proof(inout output, row),
                Option::None => {}
            }
        }
        output.push(10);
    }
    pack_text(in output)
}
