// @vesper/optimize: the AST arithmetic optimizer of src/optimize.rs in
// Vesper (self-hosting wave SH3, lane 10, #1249). Rust stays the default
// optimizer; this is a non-default port with a differential
// (tests/self_host_optimize.rs).
//
// - budget.ves: `WitnessBudget` and the Rust vector capacities it charges.
// - input.ves: the decoded expressions (an `@vesper/ast` `Ast`), the
//   expression types and a certificate.
// - witness.ves: the certificate checker and the candidate builder of
//   src/optimize/witness.rs.
//
// - search.ves: the proof producer of src/optimize/certificate.rs
//   (`propose_rewrite`) on `@vesper/egraph`.

use @vesper/ast::{
    ArgNode,
    expr_at,
    list_at,
    list_len,
    lit_at,
    none
};
use @vesper-std/arena::{
    idx_from_raw
};
use @vesper-std/intern::{
    symbol_from_id
};
use self::budget::{
    Budget,
    valid_limits
};
use self::input::{
    Cert,
    Reader,
    Tree,
    TypeRow,
    cert_new,
    mapped,
    read_cert,
    read_exprs,
    read_names,
    read_names_text,
    read_types,
    tree_new
};
use self::search::{
    Builder,
    Proposal,
    builder_new,
    proposal_new,
    propose
};
use self::input::{
    ProofRow,
    TermRow
};
use self::witness::{
    Bound,
    Ops,
    bind_source,
    bound_new,
    build_candidate,
    ops_new,
    rust_sizes,
    scratch_new,
    verify
};

fn put(inout o: ChunkSeq[u8], in s: Str) {
    o.extend(in s.as_bytes());
}

fn put_u128(inout o: ChunkSeq[u8], v: u128) {
    if v >= 10 {
        put_u128(inout o, v / 10);
    }
    o.push(wrapping_u8(wrapping_add(v % 10, 48)));
}

fn put_u64(inout o: ChunkSeq[u8], v: u64) {
    if v >= 10 {
        put_u64(inout o, v / 10);
    }
    o.push(wrapping_u8(wrapping_add(v % 10, 48)));
}

fn put_sym(inout o: ChunkSeq[u8], in t: Tree, sym: u32) {
    if sym == none() {
        put(inout o, "<none>");
        return;
    }
    let (a, z) = t.ast.names.span(symbol_from_id(sym));
    for i in a..z {
        match t.ast.names.text_byte(i) {
            Option::Some(c) => o.push(c),
            Option::None => {}
        }
    }
}

fn put_span(inout o: ChunkSeq[u8], start: u32, end: u32) {
    o.push(64);
    put_u64(inout o, widen_u64(start));
    o.push(58);
    put_u64(inout o, widen_u64(end));
}

// The candidate dump the differential compares (the Rust side writes the
// same text from a Rust `Expr`).
pub fn dump_expr(inout o: ChunkSeq[u8], in t: Tree, e: u32) {
    let x = expr_at(in t.ast, e);
    if x.kind == 1 {
        let l = lit_at(in t.ast, x.a);
        if l.kind != 1 {
            put(inout o, "lit");
        } else {
            if l.neg && (l.bits != 0 || l.hi != 0) {
                o.push(45);
            }
            if l.hi == 0 {
                put_u64(inout o, l.bits);
            } else {
                put_u128(inout o, wrapping_shl_u128(widen_u128(l.hi), 64) | widen_u128(l.bits));
            }
        }
        put_span(inout o, x.start, x.end);
    } else if x.kind == 2 {
        put_sym(inout o, in t, x.a);
        put_span(inout o, x.start, x.end);
    } else if x.kind == 11 {
        o.push(40);
        put_sym(inout o, in t, x.a);
        put_span(inout o, x.start, x.end);
        o.push(32);
        dump_expr(inout o, in t, x.b);
        o.push(32);
        dump_expr(inout o, in t, x.c);
        o.push(41);
    } else if x.kind == 6 {
        put(inout o, "(call");
        put_span(inout o, x.start, x.end);
        o.push(32);
        dump_expr(inout o, in t, x.a);
        put(inout o, " [");
        put_u64(inout o, list_len(in t.ast, x.b));
        o.push(93);
        for i in 0..list_len(in t.ast, x.c) {
            let a = t
                .ast
                .args
                .get_or(
                    idx_from_raw[ArgNode](list_at(in t.ast, x.c, i)),
                    ArgNode {
                        pass: 255,
                        explicit: false,
                        expr: none()
                    }
                );
            o.push(32);
            put_u64(inout o, widen_u64(a.pass));
            if a.explicit {
                o.push(33);
            }
            o.push(58);
            dump_expr(inout o, in t, a.expr);
        }
        o.push(41);
    } else {
        o.push(63);
        put_u64(inout o, widen_u64(x.kind));
        put_span(inout o, x.start, x.end);
    }
}

pub fn pack_text(in text: ChunkSeq[u8]) -> ChunkSeq[u64] {
    let n = text.len();
    let mut out = ChunkSeq::with_capacity[u64](wrapping_add(n >> 3, 2));
    out.push(n);
    let mut x: u64 = 0;
    let mut k: u32 = 0;
    for i in 0..n {
        let c = match text.try_get(i) {
            Option::Some(v) => widen_u64(v),
            Option::None => 0,
        };
        x = x | wrapping_shl_u64(c, wrapping_mul(k, 8));
        k = wrapping_add(k, 1);
        if k == 8 {
            out.push(x);
            x = 0;
            k = 0;
        }
    }
    if k != 0 {
        out.push(x);
    }
    out
}

fn read_budget(inout r: Reader, in b: Slice[u8]) -> Budget {
    Budget {
        max_terms: r.word(in b),
        max_proofs: r.word(in b),
        max_input_nodes: r.word(in b),
        max_output_nodes: r.word(in b),
        max_depth: r.word(in b),
        max_variables: r.word(in b),
        max_name_bytes: r.word(in b),
        max_metadata_bytes: r.word(in b),
        max_work: r.word(in b),
        work: r.word(in b),
        metadata: r.word(in b),
        names: r.word(in b)
    }
}

// Task "verify": a count of cases, each self-contained: the limits and
// spent counters, names, types, expressions, the source and candidate
// expressions, the certificate, and whether to build the candidate too.
// Per case it writes `R code work metadata names` (`verify_spent`'s
// result and counters; code 0 is `Ok`) and, when asked, `B code dump`:
// `build_candidate` of the certificate's output on a fresh budget.
pub fn optimize_verify(in input: Str) -> ChunkSeq[u64] {
    let b = input.as_bytes();
    run_cases(in b, in input, false, true)
}

// `optimize_verify` over a split input: the words with the names' lengths
// only, and the names' text (`read_names_text`). The hybrid module's entry.
pub fn optimize_verify_split(in input: Slice[u8], in names: Str) -> ChunkSeq[u64] {
    run_cases(in input, in names, true, true)
}

// The same cases decoded only, with every result line `R 0 0 0 0`: the
// decode cost, which the speed test subtracts.
pub fn optimize_decode(in input: Str) -> ChunkSeq[u64] {
    let b = input.as_bytes();
    run_cases(in b, in input, false, false)
}

// The names of one case: in the words (`text` is the whole input), or in
// `text` alone when the input is split. There every case's names follow
// the previous case's, and `at` carries the offset across cases.
fn names_of(
    inout r: Reader,
    in b: Slice[u8],
    in text: Str,
    split: bool,
    inout at: u64,
    inout t: Tree
) {
    if split {
        read_names_text(inout r, in b, in text, inout at, inout t);
    } else {
        read_names(inout r, in text, inout t);
    }
}

fn run_cases(in b: Slice[u8], in text: Str, split: bool, check: bool) -> ChunkSeq[u64] {
    let mut r = Reader {
        pos: 0
    };
    let mut o = ChunkSeq::new[u8]();
    let mut map = ChunkSeq::new[u32]();
    let mut types = ChunkSeq::new[TypeRow]();
    let mut cert = cert_new();
    let mut scratch = scratch_new();
    let cases = r.word(in b);
    let mut at: u64 = 0;
    for k in 0..cases {
        let mut budget = read_budget(inout r, in b);
        let mut t = tree_new();
        names_of(inout r, in b, in text, split, inout at, inout t);
        read_types(inout r, in b, inout types);
        read_exprs(inout r, in b, inout t, inout map);
        let source = mapped(in map, r.word(in b));
        let candidate = mapped(in map, r.word(in b));
        read_cert(inout r, in b, inout cert);
        let build = r.word(in b) != 0;
        let ops = ops_new(inout t);
        let fresh = budget;
        let mut code = valid_limits(in budget);
        if !check {
            budget.work = 0;
            budget.metadata = 0;
            budget.names = 0;
        } else if code == 0 {
            code = verify(
                inout t,
                in ops,
                in types,
                source,
                candidate,
                in cert,
                inout budget,
                inout scratch
            );
        }
        put(inout o, "R ");
        put_u64(inout o, widen_u64(code));
        o.push(32);
        put_u64(inout o, budget.work);
        o.push(32);
        put_u64(inout o, budget.metadata);
        o.push(32);
        put_u64(inout o, budget.names);
        o.push(10);
        if build && check {
            let mut nb = fresh;
            nb.work = 0;
            nb.metadata = 0;
            nb.names = 0;
            let mut bound = bound_new();
            let mut code = bind_source(in t, in ops, in types, source, inout nb, inout bound);
            let mut out = none();
            if code == 0 {
                code = build_candidate(
                    inout t,
                    in ops,
                    in bound,
                    in cert.terms,
                    cert.output,
                    inout nb,
                    inout out
                );
            }
            put(inout o, "B ");
            put_u64(inout o, widen_u64(code));
            if code == 0 {
                o.push(32);
                dump_expr(inout o, in t, out);
            }
            o.push(10);
        }
    }
    pack_text(in o)
}

// The Rust `size_of` values the checker charges with (the input is unused).
pub fn optimize_sizes(in input: Str) -> ChunkSeq[u64] {
    rust_sizes()
}

fn put_i128(inout o: ChunkSeq[u8], v: i128) {
    if v < 0 {
        o.push(45);
        put_u64(inout o, wrapping_u64(wrapping_neg_i128(v)));
    } else {
        put_u64(inout o, wrapping_u64(v));
    }
}

fn put_term(inout o: ChunkSeq[u8], t: TermRow) {
    o.push(32);
    put_u64(inout o, widen_u64(t.kind));
    o.push(58);
    put_u64(inout o, widen_u64(t.tag));
    o.push(58);
    put_u64(inout o, widen_u64(t.op));
    o.push(58);
    put_i128(inout o, t.value);
    o.push(58);
    put_u64(inout o, widen_u64(t.a));
    o.push(58);
    put_u64(inout o, widen_u64(t.b));
}

fn put_proof(inout o: ChunkSeq[u8], p: ProofRow) {
    o.push(32);
    put_u64(inout o, widen_u64(p.from));
    o.push(58);
    put_u64(inout o, widen_u64(p.to));
    o.push(58);
    put_u64(inout o, widen_u64(p.tag));
    o.push(58);
    put_u64(inout o, widen_u64(p.rule));
    o.push(58);
    put_u64(inout o, widen_u64(p.b0));
    o.push(58);
    put_u64(inout o, widen_u64(p.b1));
    o.push(58);
    put_u64(inout o, widen_u64(p.b2));
    o.push(58);
    put_u64(inout o, widen_u64(p.len));
    o.push(58);
    if p.has_guard {
        put_u64(inout o, wrapping_add(widen_u64(p.guard), 1));
    } else {
        o.push(48);
    }
    o.push(58);
    put_u64(inout o, widen_u64(p.p0));
    o.push(58);
    put_u64(inout o, widen_u64(p.p1));
}

// Task "propose": a count of cases, each the limits (and three unused
// spent words), names, types, expressions and the source expression. Per
// case it writes `propose_rewrite`'s outcome: `P B` (barrier), `P U`
// (unchanged), `P E code` (an error), or `P C work metadata names
// terms_cap proofs_cap input output conclusion` followed by the candidate
// (`C dump`), the certificate's terms (`T`, each `kind:tag:op:value:a:b`)
// and proofs (`Q`, each `from:to:tag:rule:b0:b1:b2:len:guard:p0:p1`,
// guard 0 for none, else the proof plus one).
pub fn optimize_propose(in input: Str) -> ChunkSeq[u64] {
    let b = input.as_bytes();
    propose_cases(in b, in input, false, 0)
}

// `optimize_propose` over a split input (see `optimize_verify_split`).
pub fn optimize_propose_split(in input: Slice[u8], in names: Str) -> ChunkSeq[u64] {
    propose_cases(in input, in names, true, 0)
}

// The same cases for the speed test: `optimize_propose_quiet` proposes but
// writes only `P` per case (Rust's side builds the proposal and prints
// nothing), and `optimize_propose_decode` only decodes (its cost is
// subtracted).
pub fn optimize_propose_quiet(in input: Str) -> ChunkSeq[u64] {
    let b = input.as_bytes();
    propose_cases(in b, in input, false, 1)
}

pub fn optimize_propose_decode(in input: Str) -> ChunkSeq[u64] {
    let b = input.as_bytes();
    propose_cases(in b, in input, false, 2)
}

// `mode` 0 writes each proposal, 1 proposes and writes `P`, 2 decodes and
// writes `P`.
fn propose_cases(in b: Slice[u8], in text: Str, split: bool, mode: u8) -> ChunkSeq[u64] {
    let mut r = Reader {
        pos: 0
    };
    let mut o = ChunkSeq::new[u8]();
    let mut map = ChunkSeq::new[u32]();
    let mut types = ChunkSeq::new[TypeRow]();
    let cases = r.word(in b);
    let mut at: u64 = 0;
    for k in 0..cases {
        let mut budget = read_budget(inout r, in b);
        let mut t = tree_new();
        names_of(inout r, in b, in text, split, inout at, inout t);
        read_types(inout r, in b, inout types);
        read_exprs(inout r, in b, inout t, inout map);
        let source = mapped(in map, r.word(in b));
        if mode == 2 {
            put(inout o, "P\n");
            continue;
        }
        let ops = ops_new(inout t);
        let mut d = builder_new(0, in budget);
        let mut p = proposal_new();
        let code = propose(inout t, in ops, in types, source, inout budget, inout d, inout p);
        if mode == 1 {
            put(inout o, "P\n");
            continue;
        }
        put(inout o, "P ");
        if code != 0 {
            put(inout o, "E ");
            put_u64(inout o, widen_u64(code));
            o.push(10);
            continue;
        }
        if p.outcome == 1 {
            put(inout o, "B\n");
            continue;
        }
        if p.outcome == 2 {
            put(inout o, "U\n");
            continue;
        }
        put(inout o, "C ");
        put_u64(inout o, budget.work);
        o.push(32);
        put_u64(inout o, budget.metadata);
        o.push(32);
        put_u64(inout o, budget.names);
        o.push(32);
        put_u64(inout o, d.terms_cap);
        o.push(32);
        put_u64(inout o, d.proofs_cap);
        o.push(32);
        put_u64(inout o, widen_u64(p.input));
        o.push(32);
        put_u64(inout o, widen_u64(p.output));
        o.push(32);
        put_u64(inout o, widen_u64(p.conclusion));
        put(inout o, "\nC ");
        dump_expr(inout o, in t, p.candidate);
        put(inout o, "\nT");
        for i in 0..d.terms.len() {
            match d.terms.try_get(i) {
                Option::Some(x) => put_term(inout o, x),
                Option::None => {}
            }
        }
        put(inout o, "\nQ");
        for i in 0..d.proofs.len() {
            match d.proofs.try_get(i) {
                Option::Some(x) => put_proof(inout o, x),
                Option::None => {}
            }
        }
        o.push(10);
    }
    pack_text(in o)
}
