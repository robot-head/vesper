// The bounded certificate checker of src/optimize/witness.rs over
// `@vesper/ast` expressions (self-hosting SH3 lane 10, #1249):
// `bind_source`, `validate_terms`, `compare_input`, `compare_output`,
// `build_candidate`, `check_rule` and `verify_with_budget`, with the same
// checks in the same order and the same budget charges, so a certificate is
// accepted or refused for the same reason and spends the same budget.
//
// Errors are codes: 0 is success, otherwise the `WitnessError` variant's
// position plus one (the constants below). Rust's `size_of` values of the
// vectors it charges for are the `S_*` constants (64-bit targets); the
// differential checks the ones it can name against Rust's.

use @vesper/ast::{ArgNode, ExprNode, Lit, list_at, list_len, expr_at, lit_at, none};
use @vesper-std/arena::{idx_from_raw};
use @vesper-std/intern::{symbol_from_id};
use self::budget::{Budget, limit, metadata, names, reserve, work, work_units};
use self::input::{
    Cert, ProofRow, TermRow, Tree, TypeRow, add_binary, add_call2, add_int, add_name, cap_at,
    type_code
};

const E_LIMIT: u8 = 2;
const E_UNSUPPORTED_AST: u8 = 4;
const E_MISSING_TYPE: u8 = 5;
const E_TYPE_MISMATCH: u8 = 6;
const E_CONSTANT_OUT_OF_RANGE: u8 = 7;
const E_UNKNOWN_VARIABLE: u8 = 8;
const E_INVALID_INTRINSIC_ORIGIN: u8 = 9;
const E_UNSUPPORTED_VERSION: u8 = 10;
const E_INVALID_TERM_INDEX: u8 = 11;
const E_NON_TOPOLOGICAL_TERM: u8 = 12;
const E_INVALID_PROOF_INDEX: u8 = 13;
const E_NON_TOPOLOGICAL_PROOF: u8 = 14;
const E_UNKNOWN_RULE: u8 = 15;
const E_INVALID_SUBSTITUTION: u8 = 16;
const E_INVALID_RULE_INSTANCE: u8 = 17;
const E_UNPROVEN_TOTALITY: u8 = 18;
const E_INVALID_EQUALITY: u8 = 19;
const E_INPUT_MISMATCH: u8 = 20;
const E_OUTPUT_MISMATCH: u8 = 21;

// `size_of` of the Rust types whose vectors the checker charges for.
const S_TERM: u64 = 48;
const S_EQUALITY: u64 = 36;
const S_EXPR: u64 = 240;
const S_ARG: u64 = 256;
const S_TYPE: u64 = 96;
const S_SOURCE_FRAME: u64 = 16;
const S_TERM_ID: u64 = 4;
const S_STR_REF: u64 = 16;
const S_ORIGIN: u64 = 16;
const S_SHAPE: u64 = 32;
const S_INPUT_PAIR: u64 = 8;
const S_OUTPUT_FRAME: u64 = 24;
const S_BUILD_FRAME: u64 = 8;
const S_BOOL: u64 = 1;

// Expression kinds (@vesper/ast lib.ves).
const X_LITERAL: u8 = 1;
const X_NAME: u8 = 2;
const X_CALL: u8 = 6;
const X_BINARY: u8 = 11;

// Term tags (input.ves `TermRow`).
const T_CONST: u8 = 0;
const T_INPUT: u8 = 1;
const T_CHECKED: u8 = 2;
const T_WRAPPING: u8 = 3;

// `IntOp`.
const OP_ADD: u8 = 0;
const OP_SUB: u8 = 1;
const OP_MUL: u8 = 2;

// `IntegerKind` positions of the four closed kinds.
const K_U8: u8 = 0;
const K_U32: u8 = 1;
const K_U64: u8 = 2;
const K_I64: u8 = 3;

// Type codes (input.ves `TypeRow`).
const C_INT_LITERAL: u8 = 5;

// The length of every `wrapping_*` intrinsic name.
const WRAPPING_NAME_LEN: u64 = 12;

// The symbols of the operator and intrinsic names a check compares
// against (interned once per tree).
pub copy struct Ops {
    add: u32,
    sub: u32,
    mul: u32,
    wadd: u32,
    wsub: u32,
    wmul: u32
}

pub fn ops_new(inout tree: Tree) -> Ops {
    Ops {
        add: tree.ast.names.intern(in "+").id(),
        sub: tree.ast.names.intern(in "-").id(),
        mul: tree.ast.names.intern(in "*").id(),
        wadd: tree.ast.names.intern(in "wrapping_add").id(),
        wsub: tree.ast.names.intern(in "wrapping_sub").id(),
        wmul: tree.ast.names.intern(in "wrapping_mul").id()
    }
}

// An intrinsic origin: the operation and the source callee expression.
pub copy struct Origin {
    op: u8,
    callee: u32
}

// `BoundSource`. `keys` and `consts` mirror `terms` for the interning
// search (`term_key`), and `stack` and `values` are `bind_source`'s work
// stacks, kept here so that a reused `Bound` reuses their buffers.
pub struct Bound {
    kind: u8,
    terms: ChunkSeq[TermRow],
    keys: ChunkSeq[u64],
    consts: ChunkSeq[i128],
    stack: ChunkSeq[Frame],
    values: ChunkSeq[u32],
    terms_cap: u64,
    root: u32,
    names: ChunkSeq[u32],
    names_cap: u64,
    origins: ChunkSeq[Origin],
    origins_cap: u64,
    start: u32,
    end: u32
}

pub fn bound_new() -> Bound {
    Bound {
        kind: 0,
        terms: ChunkSeq::new[TermRow](),
        keys: ChunkSeq::new[u64](),
        consts: ChunkSeq::new[i128](),
        stack: ChunkSeq::new[Frame](),
        values: ChunkSeq::new[u32](),
        terms_cap: 0,
        root: 0,
        names: ChunkSeq::new[u32](),
        names_cap: 0,
        origins: ChunkSeq::new[Origin](),
        origins_cap: 0,
        start: 0,
        end: 0
    }
}

// A `compare_input` stack entry: a source term and a certificate term.
pub copy struct Pair {
    left: u32,
    right: u32
}

// A `compare_output` stack entry: an expression, a term and its depth.
pub copy struct OutFrame {
    expr: u32,
    id: u32,
    depth: u64
}

pub copy struct Shape {
    depth: u64,
    nodes: u64,
    names: u64,
    bytes: u64
}

// ---------------------------------------------------------------- helpers

fn sym_len(in tree: Tree, sym: u32) -> u64 {
    tree.ast.names.symbol_len(symbol_from_id(sym))
}

fn closed_kind(code: u8) -> u8 {
    if code >= 1 && code <= 4 {
        wrapping_sub(code, 1)
    } else {
        255
    }
}

fn checked_op(in ops: Ops, sym: u32) -> u8 {
    if sym == ops.add {
        OP_ADD
    } else if sym == ops.sub {
        OP_SUB
    } else if sym == ops.mul {
        OP_MUL
    } else {
        255
    }
}

fn wrapping_op(in ops: Ops, sym: u32) -> u8 {
    if sym == ops.wadd {
        OP_ADD
    } else if sym == ops.wsub {
        OP_SUB
    } else if sym == ops.wmul {
        OP_MUL
    } else {
        255
    }
}

// `op_name(op, wrapping).len()`.
fn op_name_len(wrapping: bool) -> u64 {
    if wrapping { WRAPPING_NAME_LEN } else { 1 }
}

// `IntegerKind::fits` for the four closed kinds.
pub fn fits(kind: u8, value: i128) -> bool {
    let u64_max: i128 = 18446744073709551615;
    let i64_min: i128 = -9223372036854775808;
    if kind == K_U8 {
        value >= 0 && value <= 255
    } else if kind == K_U32 {
        value >= 0 && value <= 4294967295
    } else if kind == K_U64 {
        value >= 0 && value <= u64_max
    } else if kind == K_I64 {
        value >= i64_min && value <= 9223372036854775807
    } else {
        false
    }
}

// `IntegerKind::wrap` for the four closed kinds.
pub fn wrap(kind: u8, value: i128) -> i128 {
    if kind == K_U8 {
        widen_i128(wrapping_u64(value) & 255)
    } else if kind == K_U32 {
        widen_i128(wrapping_u64(value) & 4294967295)
    } else if kind == K_U64 {
        widen_i128(wrapping_u64(value))
    } else {
        widen_i128(wrapping_i64(value))
    }
}

fn int_value(in tree: Tree, expr: ExprNode) -> i128 {
    let lit = lit_at(in tree.ast, expr.a);
    // The 128-bit magnitude `hi`:`bits` (2^127 wraps to `i128::MIN`).
    let magnitude = wrapping_shl_i128(widen_i128(wrapping_i64(lit.hi)), 64) | widen_i128(lit.bits);
    if lit.neg {
        wrapping_neg_i128(magnitude)
    } else {
        magnitude
    }
}

fn is_int_literal(in tree: Tree, expr: ExprNode) -> bool {
    expr.kind == X_LITERAL && lit_at(in tree.ast, expr.a).kind == 1
}

fn term_at(in terms: ChunkSeq[TermRow], id: u32) -> TermRow {
    match terms.try_get(widen_u64(id)) {
        Option::Some(v) => v,
        Option::None => TermRow { kind: 255, tag: 255, op: 0, value: 0, a: 0, b: 0 },
    }
}

fn in_range(in terms: ChunkSeq[TermRow], id: u32) -> bool {
    widen_u64(id) < terms.len()
}

fn is_binary(term: TermRow) -> bool {
    term.tag == T_CHECKED || term.tag == T_WRAPPING
}

fn same_node(x: TermRow, y: TermRow) -> bool {
    if x.tag != y.tag {
        return false;
    }
    if x.tag == T_CONST {
        x.value == y.value
    } else if x.tag == T_INPUT {
        x.a == y.a
    } else {
        x.op == y.op && x.a == y.a && x.b == y.b
    }
}

fn same_term(x: TermRow, y: TermRow) -> bool {
    x.kind == y.kind && same_node(x, y)
}

fn arg_at(in tree: Tree, list: u32, i: u64) -> ArgNode {
    tree.ast.args.get_or(
        idx_from_raw[ArgNode](list_at(in tree.ast, list, i)),
        ArgNode { pass: 255, explicit: false, expr: none() }
    )
}

// `call_parts`: the operation, the callee and the two argument
// expressions of a `wrapping_*` call.
fn call_parts(
    in tree: Tree,
    in ops: Ops,
    expr: ExprNode,
    inout op: u8,
    inout args: (u32, u32)
) -> u8 {
    if expr.kind != X_CALL {
        return E_UNSUPPORTED_AST;
    }
    let callee = expr_at(in tree.ast, expr.a);
    if callee.kind != X_NAME {
        return E_INVALID_INTRINSIC_ORIGIN;
    }
    let wrap_op = wrapping_op(in ops, callee.a);
    if wrap_op == 255 {
        return E_UNSUPPORTED_AST;
    }
    if list_len(in tree.ast, expr.b) != 0 || list_len(in tree.ast, expr.c) != 2 {
        return E_UNSUPPORTED_AST;
    }
    let first_arg = arg_at(in tree, expr.c, 0);
    let second_arg = arg_at(in tree, expr.c, 1);
    if first_arg.pass != 0 || first_arg.explicit || second_arg.pass != 0 || second_arg.explicit {
        return E_UNSUPPORTED_AST;
    }
    op = wrap_op;
    args = (first_arg.expr, second_arg.expr);
    0
}

fn source_type(in tree: Tree, in types: ChunkSeq[TypeRow], expr: ExprNode, kind: u8) -> u8 {
    let code = type_code(in types, expr.start, expr.end);
    if code == 0 {
        return E_MISSING_TYPE;
    }
    if closed_kind(code) == kind || (is_int_literal(in tree, expr) && code == C_INT_LITERAL) {
        0
    } else {
        E_TYPE_MISMATCH
    }
}

// A bound term's identity apart from its kind (every bound term has the
// source's kind) and a constant's value: the tag, the operation and the
// children (term ids and variable indices stay below 2^30).
fn term_key(term: TermRow) -> u64 {
    (widen_u64(term.tag) << 62)
        | (widen_u64(term.op) << 60)
        | (widen_u64(term.a) << 30)
        | widen_u64(term.b)
}

fn const_at(in consts: ChunkSeq[i128], i: u64) -> i128 {
    match consts.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

// `intern`: a linear search, one unit of work per compared term. The
// search runs over the `keys` column, and the units are charged at once
// (`work_units`), which spends and refuses exactly as one charge per
// compared term does.
fn intern_term(inout bound: Bound, term: TermRow, inout budget: Budget, inout id: u32) -> u8 {
    let key = term_key(term);
    let constant = term.tag == T_CONST;
    let n = bound.keys.len();
    let mut found = n;
    let mut i: u64 = 0;
    for stored_key in bound.keys {
        if stored_key == key && (!constant || const_at(in bound.consts, i) == term.value) {
            found = i;
            break;
        }
        i = wrapping_add(i, 1);
    }
    let compared = if found < n { wrapping_add(found, 1) } else { n };
    let e = work_units(inout budget, compared);
    if e != 0 {
        return e;
    }
    if found < n {
        id = wrapping_u32(found);
        return 0;
    }
    let e = limit(wrapping_add(n, 1), budget.max_terms);
    if e != 0 {
        return e;
    }
    let e = reserve(inout budget, n, inout bound.terms_cap, 1, S_TERM);
    if e != 0 {
        return e;
    }
    id = wrapping_u32(n);
    bound.terms.push(term);
    bound.keys.push(key);
    bound.consts.push(term.value);
    0
}

fn binary_term(kind: u8, wrapping: bool, op: u8, left: u32, right: u32) -> TermRow {
    TermRow {
        kind: kind,
        tag: if wrapping { T_WRAPPING } else { T_CHECKED },
        op: op,
        value: 0,
        a: left,
        b: right
    }
}

// A `bind_source` frame: `Enter(expression, depth)` or
// `Finish(op, wrapping)`.
pub copy struct Frame {
    finish: bool,
    expr: u32,
    depth: u64,
    op: u8,
    wrapping: bool
}

fn enter(expr: u32, depth: u64) -> Frame {
    Frame { finish: false, expr: expr, depth: depth, op: 0, wrapping: false }
}

fn finish(op: u8, wrapping: bool) -> Frame {
    Frame { finish: true, expr: 0, depth: 0, op: op, wrapping: wrapping }
}

// ---------------------------------------------------------------- bind

// `bind_source`: the source expression `root` as shallow terms.
pub fn bind_source(
    in tree: Tree,
    in ops: Ops,
    in types: ChunkSeq[TypeRow],
    root: u32,
    inout budget: Budget,
    inout bound: Bound
) -> u8 {
    let source = expr_at(in tree.ast, root);
    let code = type_code(in types, source.start, source.end);
    if code == 0 {
        return E_MISSING_TYPE;
    }
    let kind = closed_kind(code);
    if kind == 255 {
        return E_TYPE_MISMATCH;
    }
    bound.kind = kind;
    bound.terms.clear();
    bound.keys.clear();
    bound.consts.clear();
    bound.stack.clear();
    bound.values.clear();
    bound.terms_cap = 0;
    bound.root = 0;
    bound.names.clear();
    bound.names_cap = 0;
    bound.origins.clear();
    bound.origins_cap = 0;
    bound.start = source.start;
    bound.end = source.end;
    let mut stack_cap: u64 = 0;
    let mut values_cap: u64 = 0;
    let e = reserve(inout budget, 0, inout stack_cap, 1, S_SOURCE_FRAME);
    if e != 0 {
        return e;
    }
    bound.stack.push(enter(root, 1));
    let mut nodes: u64 = 0;
    loop {
        let frame = match bound.stack.pop() {
            Option::Some(f) => f,
            Option::None => break,
        };
        let e = work(inout budget, 1);
        if e != 0 {
            return e;
        }
        let mut term = TermRow { kind: kind, tag: 0, op: 0, value: 0, a: 0, b: 0 };
        if frame.finish {
            let right = match bound.values.pop() {
                Option::Some(v) => v,
                Option::None => return E_UNSUPPORTED_AST,
            };
            let left = match bound.values.pop() {
                Option::Some(v) => v,
                Option::None => return E_UNSUPPORTED_AST,
            };
            term = binary_term(kind, frame.wrapping, frame.op, left, right);
        } else {
            let expr = expr_at(in tree.ast, frame.expr);
            nodes = wrapping_add(nodes, 1);
            let e = limit(nodes, budget.max_input_nodes);
            if e != 0 {
                return e;
            }
            let e = limit(frame.depth, budget.max_depth);
            if e != 0 {
                return e;
            }
            let e = source_type(in tree, in types, expr, kind);
            if e != 0 {
                return e;
            }
            let deeper = wrapping_add(frame.depth, 1);
            if is_int_literal(in tree, expr) {
                let value = int_value(in tree, expr);
                if !fits(kind, value) {
                    return E_CONSTANT_OUT_OF_RANGE;
                }
                term.value = value;
            } else if expr.kind == X_NAME {
                let len = sym_len(in tree, expr.a);
                let e = names(inout budget, len);
                if e != 0 {
                    return e;
                }
                let mut found = none();
                for i in 0..bound.names.len() {
                    let previous = match bound.names.try_get(i) {
                        Option::Some(v) => v,
                        Option::None => none(),
                    };
                    let e = work(inout budget, wrapping_add(sym_len(in tree, previous), len));
                    if e != 0 {
                        return e;
                    }
                    if previous == expr.a {
                        found = wrapping_u32(i);
                        break;
                    }
                }
                if found == none() {
                    let e = limit(wrapping_add(bound.names.len(), 1), budget.max_variables);
                    if e != 0 {
                        return e;
                    }
                    let e = reserve(
                        inout budget,
                        bound.names.len(),
                        inout bound.names_cap,
                        1,
                        S_STR_REF
                    );
                    if e != 0 {
                        return e;
                    }
                    found = wrapping_u32(bound.names.len());
                    bound.names.push(expr.a);
                }
                term.tag = T_INPUT;
                term.a = found;
            } else if expr.kind == X_BINARY {
                let op = checked_op(in ops, expr.a);
                if op == 255 {
                    return E_UNSUPPORTED_AST;
                }
                let e = reserve(
                    inout budget,
                    bound.stack.len(),
                    inout stack_cap,
                    3,
                    S_SOURCE_FRAME
                );
                if e != 0 {
                    return e;
                }
                bound.stack.push(finish(op, false));
                bound.stack.push(enter(expr.c, deeper));
                bound.stack.push(enter(expr.b, deeper));
                continue;
            } else if expr.kind == X_CALL {
                let mut op: u8 = 0;
                let mut args: (u32, u32) = (0, 0);
                let e = call_parts(in tree, in ops, expr, inout op, inout args);
                if e != 0 {
                    return e;
                }
                let callee = expr_at(in tree.ast, expr.a);
                if type_code(in types, callee.start, callee.end) != 0 {
                    return E_INVALID_INTRINSIC_ORIGIN;
                }
                nodes = wrapping_add(nodes, 1);
                let e = limit(nodes, budget.max_input_nodes);
                if e != 0 {
                    return e;
                }
                let e = limit(deeper, budget.max_depth);
                if e != 0 {
                    return e;
                }
                let e = names(inout budget, WRAPPING_NAME_LEN);
                if e != 0 {
                    return e;
                }
                let e = reserve(
                    inout budget,
                    bound.origins.len(),
                    inout bound.origins_cap,
                    1,
                    S_ORIGIN
                );
                if e != 0 {
                    return e;
                }
                bound.origins.push(Origin { op: op, callee: expr.a });
                let e = reserve(
                    inout budget,
                    bound.stack.len(),
                    inout stack_cap,
                    3,
                    S_SOURCE_FRAME
                );
                if e != 0 {
                    return e;
                }
                let (left, right) = args;
                bound.stack.push(finish(op, true));
                bound.stack.push(enter(right, deeper));
                bound.stack.push(enter(left, deeper));
                continue;
            } else {
                return E_UNSUPPORTED_AST;
            }
        }
        let mut id: u32 = 0;
        let e = intern_term(inout bound, term, inout budget, inout id);
        if e != 0 {
            return e;
        }
        let e = reserve(inout budget, bound.values.len(), inout values_cap, 1, S_TERM_ID);
        if e != 0 {
            return e;
        }
        bound.values.push(id);
    }
    if bound.values.len() != 1 {
        return E_UNSUPPORTED_AST;
    }
    bound.root = match bound.values.try_get(0) {
        Option::Some(v) => v,
        Option::None => 0,
    };
    0
}

fn bound_name(in bound: Bound, var: u32) -> u32 {
    match bound.names.try_get(widen_u64(var)) {
        Option::Some(v) => v,
        Option::None => none(),
    }
}

fn bound_origin(in bound: Bound, op: u8) -> u32 {
    for i in 0..bound.origins.len() {
        match bound.origins.try_get(i) {
            Option::Some(origin) => {
                if origin.op == op {
                    return origin.callee;
                }
            }
            Option::None => {}
        }
    }
    none()
}

// ---------------------------------------------------------------- terms

fn saturating_add(a: u64, b: u64) -> u64 {
    if a > wrapping_sub(18446744073709551615, b) {
        18446744073709551615
    } else {
        wrapping_add(a, b)
    }
}

// `count * size` for one of the `S_*` sizes (even, below 2^16), or `OVERFLOW`,
// which no such product equals (it is odd).
const OVERFLOW: u64 = 18446744073709551615;

fn bytes_of(count: u64, size: u64) -> u64 {
    if count < 281474976710656 {
        wrapping_mul(count, size)
    } else {
        match checked_mul_u64(count, size) {
            Option::Some(v) => v,
            Option::None => OVERFLOW,
        }
    }
}

fn capped_sum(a: u64, b: u64, cap: u64) -> u64 {
    let sum = saturating_add(a, b);
    let ceiling = saturating_add(cap, 1);
    if sum < ceiling { sum } else { ceiling }
}

// `validate_terms`: every term of the source's kind, in range and
// topological, with the shape of its expanded expression.
pub fn validate_terms(
    in tree: Tree,
    in bound: Bound,
    in terms: ChunkSeq[TermRow],
    inout budget: Budget,
    inout shapes: ChunkSeq[Shape]
) -> u8 {
    shapes.clear();
    let n = terms.len();
    if n == 0 {
        return E_INVALID_TERM_INDEX;
    }
    let e = limit(n, budget.max_terms);
    if e != 0 {
        return e;
    }
    let bytes = bytes_of(n, S_TERM);
    if bytes == OVERFLOW {
        return E_LIMIT;
    }
    let e = metadata(inout budget, bytes);
    if e != 0 {
        return e;
    }
    let mut shapes_cap: u64 = 0;
    let e = reserve(inout budget, 0, inout shapes_cap, n, S_SHAPE);
    if e != 0 {
        return e;
    }
    let mut id: u64 = 0;
    for current in terms {
        let e = work(inout budget, 8);
        if e != 0 {
            return e;
        }
        if current.kind != bound.kind {
            return E_TYPE_MISMATCH;
        }
        let shape = if current.tag == T_CONST {
            if !fits(current.kind, current.value) {
                return E_CONSTANT_OUT_OF_RANGE;
            }
            Shape { depth: 1, nodes: 1, names: 0, bytes: 0 }
        } else if current.tag == T_INPUT {
            let name = bound_name(in bound, current.a);
            if name == none() {
                return E_UNKNOWN_VARIABLE;
            }
            let len = sym_len(in tree, name);
            Shape { depth: 1, nodes: 1, names: len, bytes: len }
        } else if is_binary(current) {
            let wrapping = current.tag == T_WRAPPING;
            if !in_range(in terms, current.a) {
                return E_INVALID_TERM_INDEX;
            }
            if widen_u64(current.a) >= id {
                return E_NON_TOPOLOGICAL_TERM;
            }
            if !in_range(in terms, current.b) {
                return E_INVALID_TERM_INDEX;
            }
            if widen_u64(current.b) >= id {
                return E_NON_TOPOLOGICAL_TERM;
            }
            let left_shape = shape_at(in shapes, current.a);
            let right_shape = shape_at(in shapes, current.b);
            let mut depth = left_shape.depth;
            if right_shape.depth > depth {
                depth = right_shape.depth;
            }
            depth = wrapping_add(depth, 1);
            let e = limit(depth, budget.max_depth);
            if e != 0 {
                return e;
            }
            let wrap_count: u64 = if wrapping { 1 } else { 0 };
            let nodes = capped_sum(
                wrapping_add(wrap_count, 1),
                capped_sum(left_shape.nodes, right_shape.nodes, budget.max_output_nodes),
                budget.max_output_nodes
            );
            let names = capped_sum(
                wrapping_mul(wrap_count, WRAPPING_NAME_LEN),
                capped_sum(left_shape.names, right_shape.names, budget.max_name_bytes),
                budget.max_name_bytes
            );
            let overhead = wrapping_add(
                wrapping_add(wrapping_mul(8, S_EXPR), wrapping_mul(2, S_ARG)),
                op_name_len(wrapping)
            );
            let bytes = capped_sum(
                overhead,
                capped_sum(left_shape.bytes, right_shape.bytes, budget.max_metadata_bytes),
                budget.max_metadata_bytes
            );
            Shape { depth: depth, nodes: nodes, names: names, bytes: bytes }
        } else {
            return E_UNSUPPORTED_AST;
        };
        shapes.push(shape);
        id = wrapping_add(id, 1);
    }
    0
}

fn shape_at(in shapes: ChunkSeq[Shape], id: u32) -> Shape {
    match shapes.try_get(widen_u64(id)) {
        Option::Some(v) => v,
        Option::None => Shape { depth: 0, nodes: 0, names: 0, bytes: 0 },
    }
}

// `compare_input`: the certificate's input expands to the bound source.
pub fn compare_input(
    in bound: Bound,
    in terms: ChunkSeq[TermRow],
    input: u32,
    inout budget: Budget,
    inout stack: ChunkSeq[Pair]
) -> u8 {
    stack.clear();
    let mut cap: u64 = 0;
    let e = reserve(inout budget, 0, inout cap, 1, S_INPUT_PAIR);
    if e != 0 {
        return e;
    }
    stack.push(Pair { left: bound.root, right: input });
    let mut nodes: u64 = 0;
    loop {
        let (left, right) = match stack.pop() {
            Option::Some(pair) => (pair.left, pair.right),
            Option::None => break,
        };
        let e = work(inout budget, 1);
        if e != 0 {
            return e;
        }
        if !in_range(in bound.terms, left) || !in_range(in terms, right) {
            return E_INVALID_TERM_INDEX;
        }
        let source_term = term_at(in bound.terms, left);
        let cert_term = term_at(in terms, right);
        if source_term.kind != cert_term.kind {
            return E_INPUT_MISMATCH;
        }
        nodes = wrapping_add(nodes, 1);
        if is_binary(source_term) && is_binary(cert_term) {
            if source_term.tag != cert_term.tag || source_term.op != cert_term.op {
                return E_INPUT_MISMATCH;
            }
            if source_term.tag == T_WRAPPING {
                nodes = wrapping_add(nodes, 1);
            }
            let e = reserve(inout budget, stack.len(), inout cap, 2, S_INPUT_PAIR);
            if e != 0 {
                return e;
            }
            stack.push(Pair { left: source_term.b, right: cert_term.b });
            stack.push(Pair { left: source_term.a, right: cert_term.a });
        } else if !same_node(source_term, cert_term) {
            return E_INPUT_MISMATCH;
        }
        let e = limit(nodes, budget.max_input_nodes);
        if e != 0 {
            return e;
        }
    }
    0
}

fn out_frame(expr: u32, id: u32, depth: u64) -> OutFrame {
    OutFrame { expr: expr, id: id, depth: depth }
}

// `Expr == Expr` for a callee: both `Name`s here (`call_parts` passed).
fn same_callee(in tree: Tree, left_id: u32, right_id: u32) -> bool {
    let left = expr_at(in tree.ast, left_id);
    let right = expr_at(in tree.ast, right_id);
    left.kind == right.kind
        && left.start == right.start
        && left.end == right.end
        && left.a == right.a
}

// `compare_output`: the candidate is exactly the certificate's output
// expanded, every value at the source span, every intrinsic callee one of
// the source's.
pub fn compare_output(
    in tree: Tree,
    in ops: Ops,
    in bound: Bound,
    candidate: u32,
    in terms: ChunkSeq[TermRow],
    output: u32,
    inout budget: Budget,
    inout stack: ChunkSeq[OutFrame]
) -> u8 {
    let root = expr_at(in tree.ast, candidate);
    if root.start != bound.start || root.end != bound.end {
        return E_OUTPUT_MISMATCH;
    }
    stack.clear();
    let mut cap: u64 = 0;
    let e = reserve(inout budget, 0, inout cap, 1, S_OUTPUT_FRAME);
    if e != 0 {
        return e;
    }
    stack.push(out_frame(candidate, output, 1));
    let mut nodes: u64 = 0;
    loop {
        let (expr_id, id, depth) = match stack.pop() {
            Option::Some(f) => (f.expr, f.id, f.depth),
            Option::None => break,
        };
        let e = work(inout budget, 1);
        if e != 0 {
            return e;
        }
        nodes = wrapping_add(nodes, 1);
        let e = limit(depth, budget.max_depth);
        if e != 0 {
            return e;
        }
        let expr = expr_at(in tree.ast, expr_id);
        if expr.start != bound.start || expr.end != bound.end {
            return E_OUTPUT_MISMATCH;
        }
        let e = metadata(inout budget, S_EXPR);
        if e != 0 {
            return e;
        }
        if !in_range(in terms, id) {
            return E_INVALID_TERM_INDEX;
        }
        let current = term_at(in terms, id);
        let deeper = wrapping_add(depth, 1);
        if is_int_literal(in tree, expr)
            && current.tag == T_CONST
            && int_value(in tree, expr) == current.value {} else if expr.kind == X_NAME
            && current.tag == T_INPUT {
            let e = metadata(inout budget, cap_at(in tree.primary_cap, expr_id));
            if e != 0 {
                return e;
            }
            let expected = bound_name(in bound, current.a);
            if expected == none() {
                return E_UNKNOWN_VARIABLE;
            }
            let e = names(inout budget, sym_len(in tree, expr.a));
            if e != 0 {
                return e;
            }
            let e = work(inout budget, sym_len(in tree, expected));
            if e != 0 {
                return e;
            }
            if expr.a != expected {
                return E_OUTPUT_MISMATCH;
            }
        } else if expr.kind == X_BINARY && current.tag == T_CHECKED {
            let e = metadata(inout budget, cap_at(in tree.primary_cap, expr_id));
            if e != 0 {
                return e;
            }
            if checked_op(in ops, expr.a) != current.op {
                return E_OUTPUT_MISMATCH;
            }
            let e = reserve(inout budget, stack.len(), inout cap, 2, S_OUTPUT_FRAME);
            if e != 0 {
                return e;
            }
            stack.push(out_frame(expr.c, current.b, deeper));
            stack.push(out_frame(expr.b, current.a, deeper));
        } else if expr.kind == X_CALL && current.tag == T_WRAPPING {
            let e = metadata(inout budget, S_EXPR);
            if e != 0 {
                return e;
            }
            let types_bytes = bytes_of(cap_at(in tree.primary_cap, expr_id), S_TYPE);
            if types_bytes == OVERFLOW {
                return E_LIMIT;
            }
            let e = metadata(inout budget, types_bytes);
            if e != 0 {
                return e;
            }
            let args_bytes = bytes_of(cap_at(in tree.args_cap, expr_id), S_ARG);
            if args_bytes == OVERFLOW {
                return E_LIMIT;
            }
            let e = metadata(inout budget, args_bytes);
            if e != 0 {
                return e;
            }
            let callee = expr_at(in tree.ast, expr.a);
            if callee.kind == X_NAME {
                let e = metadata(inout budget, cap_at(in tree.primary_cap, expr.a));
                if e != 0 {
                    return e;
                }
            }
            let mut op: u8 = 0;
            let mut args: (u32, u32) = (0, 0);
            if call_parts(in tree, in ops, expr, inout op, inout args) != 0 {
                return E_OUTPUT_MISMATCH;
            }
            if op != current.op {
                return E_OUTPUT_MISMATCH;
            }
            nodes = wrapping_add(nodes, 1);
            let e = limit(deeper, budget.max_depth);
            if e != 0 {
                return e;
            }
            let e = names(inout budget, WRAPPING_NAME_LEN);
            if e != 0 {
                return e;
            }
            let mut found = false;
            for i in 0..bound.origins.len() {
                let e = work(inout budget, wrapping_add(1, WRAPPING_NAME_LEN));
                if e != 0 {
                    return e;
                }
                match bound.origins.try_get(i) {
                    Option::Some(origin) => {
                        if origin.op == op && same_callee(in tree, origin.callee, expr.a) {
                            found = true;
                            break;
                        }
                    }
                    Option::None => {}
                }
            }
            if !found {
                return E_INVALID_INTRINSIC_ORIGIN;
            }
            let e = reserve(inout budget, stack.len(), inout cap, 2, S_OUTPUT_FRAME);
            if e != 0 {
                return e;
            }
            let (left, right) = args;
            stack.push(out_frame(right, current.b, deeper));
            stack.push(out_frame(left, current.a, deeper));
        } else {
            return E_OUTPUT_MISMATCH;
        }
        let e = limit(nodes, budget.max_output_nodes);
        if e != 0 {
            return e;
        }
    }
    0
}

// ---------------------------------------------------------------- build

fn build_expr(
    inout tree: Tree,
    in ops: Ops,
    in bound: Bound,
    in terms: ChunkSeq[TermRow],
    id: u32
) -> u32 {
    let current = term_at(in terms, id);
    if current.tag == T_CONST {
        return add_int(inout tree, current.value, bound.start, bound.end);
    }
    if current.tag == T_INPUT {
        let name = bound_name(in bound, current.a);
        let len = sym_len(in tree, name);
        return add_name(inout tree, name, len, bound.start, bound.end);
    }
    let left = build_expr(inout tree, in ops, in bound, in terms, current.a);
    let right = build_expr(inout tree, in ops, in bound, in terms, current.b);
    if current.tag == T_WRAPPING {
        let original = expr_at(in tree.ast, bound_origin(in bound, current.op));
        let len = sym_len(in tree, original.a);
        let callee = add_name(inout tree, original.a, len, original.start, original.end);
        add_call2(inout tree, callee, left, right, bound.start, bound.end)
    } else {
        let op = if current.op == OP_ADD {
            ops.add
        } else if current.op == OP_SUB {
            ops.sub
        } else {
            ops.mul
        };
        add_binary(inout tree, op, 1, left, right, bound.start, bound.end)
    }
}

// `build_candidate`: the expression of term `root`, at the source span,
// with every intrinsic callee copied from the source. `out` is its index.
pub fn build_candidate(
    inout tree: Tree,
    in ops: Ops,
    in bound: Bound,
    in terms: ChunkSeq[TermRow],
    root: u32,
    inout budget: Budget,
    inout out: u32
) -> u8 {
    let mut shapes = ChunkSeq::new[Shape]();
    let e = validate_terms(in tree, in bound, in terms, inout budget, inout shapes);
    if e != 0 {
        return e;
    }
    if widen_u64(root) >= shapes.len() {
        return E_INVALID_TERM_INDEX;
    }
    let shape = shape_at(in shapes, root);
    let e = limit(shape.nodes, budget.max_output_nodes);
    if e != 0 {
        return e;
    }
    let e = limit(shape.names, budget.max_name_bytes);
    if e != 0 {
        return e;
    }
    let e = names(inout budget, shape.names);
    if e != 0 {
        return e;
    }
    let e = metadata(inout budget, shape.bytes);
    if e != 0 {
        return e;
    }
    let e = work(inout budget, wrapping_mul(shape.nodes, 8));
    if e != 0 {
        return e;
    }
    let n = terms.len();
    let mut origins_cap: u64 = 0;
    let e = reserve(inout budget, 0, inout origins_cap, n, S_BOOL);
    if e != 0 {
        return e;
    }
    let mut reach = ChunkSeq::new[bool]();
    reach.resize(n, false);
    reach.try_set(widen_u64(root), true);
    let mut id = n;
    loop {
        if id == 0 {
            break;
        }
        id = wrapping_sub(id, 1);
        let e = work(inout budget, 1);
        if e != 0 {
            return e;
        }
        let marked = match reach.try_get(id) {
            Option::Some(v) => v,
            Option::None => false,
        };
        if !marked {
            continue;
        }
        let current = term_at(in terms, wrapping_u32(id));
        if is_binary(current) {
            let wrapping = current.tag == T_WRAPPING;
            if wrapping {
                let e = work(inout budget, bound.origins.len());
                if e != 0 {
                    return e;
                }
                if bound_origin(in bound, current.op) == none() {
                    return E_INVALID_INTRINSIC_ORIGIN;
                }
            }
            reach.try_set(widen_u64(current.a), true);
            reach.try_set(widen_u64(current.b), true);
        }
    }
    let scans = match checked_mul_u64(shape.nodes, bound.origins.len()) {
        Option::Some(v) => v,
        Option::None => return E_LIMIT,
    };
    let e = work(inout budget, scans);
    if e != 0 {
        return e;
    }
    let mut stack_cap: u64 = 0;
    let e = reserve(
        inout budget,
        0,
        inout stack_cap,
        wrapping_add(wrapping_mul(shape.nodes, 2), 1),
        S_BUILD_FRAME
    );
    if e != 0 {
        return e;
    }
    let mut values_cap: u64 = 0;
    let e = reserve(inout budget, 0, inout values_cap, shape.nodes, S_EXPR);
    if e != 0 {
        return e;
    }
    out = build_expr(inout tree, in ops, in bound, in terms, root);
    0
}

// ---------------------------------------------------------------- rules

fn proof_at(in proofs: ChunkSeq[ProofRow], id: u32) -> ProofRow {
    match proofs.try_get(widen_u64(id)) {
        Option::Some(v) => v,
        Option::None => ProofRow {
            from: 0,
            to: 0,
            tag: 255,
            rule: 0,
            b0: 0,
            b1: 0,
            b2: 0,
            len: 0,
            has_guard: false,
            guard: 0,
            p0: 0,
            p1: 0
        },
    }
}

// `prior`: an earlier proof step.
fn prior(in proofs: ChunkSeq[ProofRow], id: u32, current: u64) -> u8 {
    if widen_u64(id) >= proofs.len() {
        return E_INVALID_PROOF_INDEX;
    }
    if widen_u64(id) >= current {
        return E_NON_TOPOLOGICAL_PROOF;
    }
    0
}

fn constant(in terms: ChunkSeq[TermRow], id: u32, value: i128) -> bool {
    let term = term_at(in terms, id);
    term.tag == T_CONST && term.value == value
}

fn application(
    in terms: ChunkSeq[TermRow],
    id: u32,
    wrapping: bool,
    op: u8,
    left: u32,
    right: u32
) -> bool {
    let term = term_at(in terms, id);
    let tag = if wrapping { T_WRAPPING } else { T_CHECKED };
    term.tag == tag && term.op == op && term.a == left && term.b == right
}

fn total_leaf(in terms: ChunkSeq[TermRow], id: u32) -> bool {
    let term = term_at(in terms, id);
    term.tag == T_CONST || term.tag == T_INPUT
}

fn rule_arity(rule: u32) -> u32 {
    if (rule >= 1 && rule <= 11) || rule == 17 || rule == 18 {
        1
    } else if rule == 12 || rule == 13 || rule == 16 || (rule >= 19 && rule <= 24) {
        2
    } else if rule == 14 || rule == 15 {
        3
    } else {
        0
    }
}

// `check_rule`: one rule instance, its substitution and its totality
// guard.
fn check_rule(
    in terms: ChunkSeq[TermRow],
    in proofs: ChunkSeq[ProofRow],
    index: u64,
    step: ProofRow
) -> u8 {
    let rule = step.rule;
    let arity = rule_arity(rule);
    if arity == 0 {
        return E_UNKNOWN_RULE;
    }
    if step.len != arity || (arity < 2 && step.b1 != 0) || (arity < 3 && step.b2 != 0) {
        return E_INVALID_SUBSTITUTION;
    }
    if !in_range(in terms, step.b0) {
        return E_INVALID_TERM_INDEX;
    }
    if arity >= 2 && !in_range(in terms, step.b1) {
        return E_INVALID_TERM_INDEX;
    }
    if arity >= 3 && !in_range(in terms, step.b2) {
        return E_INVALID_TERM_INDEX;
    }
    let x = step.b0;
    let y = step.b1;
    let z = step.b2;
    let guarded = (rule >= 6 && rule <= 8) || rule == 17 || rule == 18 || rule == 16;
    if guarded {
        let erased = if rule == 16 { y } else { x };
        if step.has_guard {
            let e = prior(in proofs, step.guard, index);
            if e != 0 {
                return e;
            }
            let premise = proof_at(in proofs, step.guard);
            if !(
                (premise.from == erased && total_leaf(in terms, premise.to))
                    || (premise.to == erased && total_leaf(in terms, premise.from))
            ) {
                return E_UNPROVEN_TOTALITY;
            }
        } else if !total_leaf(in terms, erased) {
            return E_UNPROVEN_TOTALITY;
        }
    } else if step.has_guard {
        return E_INVALID_RULE_INSTANCE;
    }
    let from = step.from;
    let to = step.to;
    let source = term_at(in terms, from);
    let target = term_at(in terms, to);
    let valid = if rule == 1
        || rule == 3
        || rule == 4
        || rule == 6
        || rule == 9
        || rule == 10
        || rule == 11
        || rule == 17 {
        let wrapping = rule >= 9;
        let op = if rule == 1 || rule == 9 {
            OP_ADD
        } else if rule == 3 || rule == 10 {
            OP_SUB
        } else {
            OP_MUL
        };
        let identity: i128 = if rule == 4 || rule == 11 { 1 } else { 0 };
        let lhs = is_binary(source)
            && source.a == x
            && constant(in terms, source.b, identity)
            && application(in terms, from, wrapping, op, source.a, source.b);
        let rhs = if rule == 6 || rule == 17 {
            constant(in terms, to, 0)
        } else {
            to == x
        };
        lhs && rhs
    } else if rule == 2 || rule == 5 || rule == 7 {
        let op = if rule == 2 { OP_ADD } else { OP_MUL };
        let identity: i128 = if rule == 5 { 1 } else { 0 };
        let lhs = is_binary(source)
            && source.b == x
            && constant(in terms, source.a, identity)
            && application(in terms, from, false, op, source.a, source.b);
        let rhs = if rule == 7 {
            constant(in terms, to, 0)
        } else {
            to == x
        };
        lhs && rhs
    } else if rule == 8 || rule == 18 {
        application(in terms, from, rule == 18, OP_SUB, x, x) && constant(in terms, to, 0)
    } else if rule == 12 || rule == 13 {
        let op = if rule == 12 { OP_ADD } else { OP_MUL };
        application(in terms, from, true, op, x, y) && application(in terms, to, true, op, y, x)
    } else if rule == 14 || rule == 15 {
        let op = if rule == 14 { OP_ADD } else { OP_MUL };
        is_binary(source)
            && is_binary(target)
            && source.b == z
            && target.a == x
            && application(in terms, from, true, op, source.a, z)
            && application(in terms, source.a, true, op, x, y)
            && application(in terms, to, true, op, x, target.b)
            && application(in terms, target.b, true, op, y, z)
    } else if rule == 16 {
        is_binary(source)
            && source.b == y
            && application(in terms, from, true, OP_SUB, source.a, y)
            && application(in terms, source.a, true, OP_ADD, x, y)
            && to == x
    } else {
        let op_index = wrapping_sub(rule, 19) % 3;
        let op = if op_index == 0 {
            OP_ADD
        } else if op_index == 1 {
            OP_SUB
        } else {
            OP_MUL
        };
        let x_term = term_at(in terms, x);
        let y_term = term_at(in terms, y);
        if x_term.tag != T_CONST || y_term.tag != T_CONST || target.tag != T_CONST {
            return E_INVALID_RULE_INSTANCE;
        }
        let x_value = x_term.value;
        let y_value = y_term.value;
        let wrapping = rule >= 22;
        let mut ok = false;
        let mut expected: i128 = 0;
        if wrapping {
            let raw = if op == OP_ADD {
                wrapping_add(x_value, y_value)
            } else if op == OP_SUB {
                wrapping_sub(x_value, y_value)
            } else {
                wrapping_mul(x_value, y_value)
            };
            expected = wrap(source.kind, raw);
            ok = true;
        } else {
            let exact = if op == OP_ADD {
                checked_add_i128(x_value, y_value)
            } else if op == OP_SUB {
                checked_sub_i128(x_value, y_value)
            } else {
                checked_mul_i128(x_value, y_value)
            };
            match exact {
                Option::Some(v) => {
                    if fits(source.kind, v) {
                        expected = v;
                        ok = true;
                    }
                }
                Option::None => {}
            }
        }
        application(in terms, from, wrapping, op, x, y) && ok && expected == target.value
    };
    if valid { 0 } else { E_INVALID_RULE_INSTANCE }
}

// ---------------------------------------------------------------- verify

// The work buffers of `verify`, which a caller checking many certificates
// keeps across them (cleared by each use), so their sequences are
// allocated once.
pub struct Scratch {
    bound: Bound,
    shapes: ChunkSeq[Shape],
    pairs: ChunkSeq[Pair],
    frames: ChunkSeq[OutFrame]
}

pub fn scratch_new() -> Scratch {
    Scratch {
        bound: bound_new(),
        shapes: ChunkSeq::new[Shape](),
        pairs: ChunkSeq::new[Pair](),
        frames: ChunkSeq::new[OutFrame]()
    }
}

// `verify_with_budget`: the certificate proves the source equal to the
// candidate, under `budget` (continued from the producer).
pub fn verify(
    inout tree: Tree,
    in ops: Ops,
    in types: ChunkSeq[TypeRow],
    source: u32,
    candidate: u32,
    in cert: Cert,
    inout budget: Budget,
    inout scratch: Scratch
) -> u8 {
    if cert.schema_version != 1 || cert.arithmetic_version != 1 {
        return E_UNSUPPORTED_VERSION;
    }
    let e = limit(cert.terms.len(), budget.max_terms);
    if e != 0 {
        return e;
    }
    let e = limit(cert.proofs.len(), budget.max_proofs);
    if e != 0 {
        return e;
    }
    let proofs_bytes = bytes_of(cert.proofs_cap, S_EQUALITY);
    if proofs_bytes == OVERFLOW {
        return E_LIMIT;
    }
    let e = metadata(inout budget, proofs_bytes);
    if e != 0 {
        return e;
    }
    let terms_bytes = bytes_of(cert.terms_cap, S_TERM);
    if terms_bytes == OVERFLOW {
        return E_LIMIT;
    }
    let e = metadata(inout budget, terms_bytes);
    if e != 0 {
        return e;
    }
    let e = bind_source(in tree, in ops, in types, source, inout budget, inout scratch.bound);
    if e != 0 {
        return e;
    }
    let e = validate_terms(
        in tree,
        in scratch.bound,
        in cert.terms,
        inout budget,
        inout scratch.shapes
    );
    if e != 0 {
        return e;
    }
    if !in_range(in cert.terms, cert.input) || !in_range(in cert.terms, cert.output) {
        return E_INVALID_TERM_INDEX;
    }
    let e = compare_input(
        in scratch.bound,
        in cert.terms,
        cert.input,
        inout budget,
        inout scratch.pairs
    );
    if e != 0 {
        return e;
    }
    for index in 0..cert.proofs.len() {
        let e = work(inout budget, 64);
        if e != 0 {
            return e;
        }
        let step = proof_at(in cert.proofs, wrapping_u32(index));
        if !in_range(in cert.terms, step.from) || !in_range(in cert.terms, step.to) {
            return E_INVALID_TERM_INDEX;
        }
        let from = term_at(in cert.terms, step.from);
        let to = term_at(in cert.terms, step.to);
        if step.tag == 0 {
            if !same_term(from, to) {
                return E_INVALID_EQUALITY;
            }
        } else if step.tag == 1 {
            let e = check_rule(in cert.terms, in cert.proofs, index, step);
            if e != 0 {
                return e;
            }
        } else if step.tag == 2 {
            if !is_binary(from) || !is_binary(to) {
                return E_INVALID_EQUALITY;
            }
            if from.tag != to.tag || from.op != to.op {
                return E_INVALID_EQUALITY;
            }
            let e = prior(in cert.proofs, step.p0, index);
            if e != 0 {
                return e;
            }
            let first = proof_at(in cert.proofs, step.p0);
            if first.from != from.a || first.to != to.a {
                return E_INVALID_EQUALITY;
            }
            let e = prior(in cert.proofs, step.p1, index);
            if e != 0 {
                return e;
            }
            let second = proof_at(in cert.proofs, step.p1);
            if second.from != from.b || second.to != to.b {
                return E_INVALID_EQUALITY;
            }
        } else if step.tag == 3 {
            let e = prior(in cert.proofs, step.p0, index);
            if e != 0 {
                return e;
            }
            let first = proof_at(in cert.proofs, step.p0);
            if first.from != step.to || first.to != step.from {
                return E_INVALID_EQUALITY;
            }
        } else {
            let e = prior(in cert.proofs, step.p0, index);
            if e != 0 {
                return e;
            }
            let e = prior(in cert.proofs, step.p1, index);
            if e != 0 {
                return e;
            }
            let first = proof_at(in cert.proofs, step.p0);
            let second = proof_at(in cert.proofs, step.p1);
            if first.from != step.from || second.to != step.to || first.to != second.from {
                return E_INVALID_EQUALITY;
            }
        }
    }
    if widen_u64(cert.conclusion) >= cert.proofs.len() {
        return E_INVALID_PROOF_INDEX;
    }
    let conclusion = proof_at(in cert.proofs, cert.conclusion);
    if conclusion.from != cert.input || conclusion.to != cert.output {
        return E_INVALID_EQUALITY;
    }
    let shape = shape_at(in scratch.shapes, cert.output);
    let e = limit(shape.nodes, budget.max_output_nodes);
    if e != 0 {
        return e;
    }
    let e = limit(shape.names, budget.max_name_bytes);
    if e != 0 {
        return e;
    }
    let e = metadata(inout budget, saturating_add(shape.bytes, S_EXPR));
    if e != 0 {
        return e;
    }
    compare_output(
        in tree,
        in ops,
        in scratch.bound,
        candidate,
        in cert.terms,
        cert.output,
        inout budget,
        inout scratch.frames
    )
}

// The `size_of` constants the differential compares with Rust's: `Term`,
// `Equality`, `Expr`, `Arg` and `Type`.
pub fn rust_sizes() -> ChunkSeq[u64] {
    let mut sizes = ChunkSeq::new[u64]();
    sizes.push(S_TERM);
    sizes.push(S_EQUALITY);
    sizes.push(S_EXPR);
    sizes.push(S_ARG);
    sizes.push(S_TYPE);
    sizes
}
