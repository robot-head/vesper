// The decoded inputs of the checker: the expressions, the expression types
// and a certificate, as tests/self_host_optimize.rs (and later the hybrid
// build's `optimize` module) encodes them, little-endian u64 words in one
// `Str`.
//
// Expressions live in an `@vesper/ast` `Ast` (ExprNode, Lit, ArgNode and
// lists), with two side columns for what the Rust checker charges and an
// AST does not keep: the capacity of a `Name` or `Binary` string (a `Call`'s
// type-argument capacity) and a `Call`'s argument capacity.

use @vesper/ast::{Ast, ArgNode, ExprNode, ListRef, Lit, TypeNode, ast_new, none};
use @vesper-std/arena::{idx_from_raw};
use @vesper-std/intern::{Symbol};

pub struct Reader {
    pos: u64
}

impl Reader {
    pub fn word(inout self, in bytes: Slice[u8]) -> u64 {
        let value = bytes.try_read_u64_le(self.pos).unwrap_or(0);
        self.pos = wrapping_add(self.pos, 8);
        value
    }

    pub fn word32(inout self, in bytes: Slice[u8]) -> u32 {
        wrapping_u32(self.word(in bytes))
    }
}

// The expressions of one case.
pub struct Tree {
    ast: Ast,
    // Per expression: the `Name`/`Binary` string capacity, or a `Call`'s
    // type-argument vector capacity.
    primary_cap: ChunkSeq[u64],
    // Per expression: a `Call`'s argument vector capacity.
    args_cap: ChunkSeq[u64],
    // Input name index -> symbol.
    symbols: ChunkSeq[u32]
}

// One `TypeMap` entry, reduced to what the checker asks: codes 1-4 are
// `u8`, `u32`, `u64`, `i64` (`IntegerKind` 0-3 plus one), 5 is
// `Type::IntLiteral`, 6 any other type.
pub copy struct TypeRow {
    start: u32,
    end: u32,
    code: u8
}

// A certificate term (`Term`): `kind` is the `IntegerKind` position, `tag`
// 0 Const (`value`), 1 InputVar (`a`), 2 Checked and 3 Wrapping (`op` 0 Add,
// 1 Sub, 2 Mul; children `a`, `b`). Unused fields are zero.
pub copy struct TermRow {
    kind: u8,
    tag: u8,
    op: u8,
    value: i128,
    a: u32,
    b: u32
}

// A proof step (`Equality`): `tag` 0 Refl, 1 Rule (`rule`, bindings
// `b0`-`b2`, `len`, `guard` when `has_guard`), 2 Congruence (`p0`, `p1`),
// 3 Symmetry (`p0`), 4 Transitivity (`p0`, `p1`).
pub copy struct ProofRow {
    from: u32,
    to: u32,
    tag: u8,
    rule: u32,
    b0: u32,
    b1: u32,
    b2: u32,
    len: u32,
    has_guard: bool,
    guard: u32,
    p0: u32,
    p1: u32
}

// `RewriteCertificate`, with the capacities of its two vectors.
pub struct Cert {
    schema_version: u64,
    arithmetic_version: u64,
    terms_cap: u64,
    proofs_cap: u64,
    input: u32,
    output: u32,
    conclusion: u32,
    terms: ChunkSeq[TermRow],
    proofs: ChunkSeq[ProofRow]
}

pub fn cap_at(in caps: ChunkSeq[u64], i: u32) -> u64 {
    caps.try_get(widen_u64(i)).unwrap_or(0)
}

fn push_list(inout ast: Ast, in words: ChunkSeq[u32]) -> u32 {
    let n = words.len();
    if n == 0 {
        return 0;
    }
    let first = wrapping_u32(ast.pool.len());
    for i in 0..n {
        match words.try_get(i) {
            Option::Some(v) => ast.pool.push(v),
            Option::None => {}
        }
    }
    let list = ast.lists.alloc(ListRef { first: first, len: wrapping_u32(n) });
    list.raw()
}

fn node(kind: u8, start: u32, end: u32, a: u32, b: u32, c: u32) -> ExprNode {
    ExprNode { kind: kind, start: start, end: end, a: a, b: b, c: c, d: 0, e: 0 }
}

// Appends an expression to the tree with its two capacities; returns its
// index.
pub fn add_expr(inout tree: Tree, expr: ExprNode, primary_cap: u64, args_cap: u64) -> u32 {
    let id = tree.ast.exprs.alloc(expr);
    tree.primary_cap.push(primary_cap);
    tree.args_cap.push(args_cap);
    id.raw()
}

// An integer literal node of `value` (in the AST's sign and magnitude
// form).
pub fn add_int(inout tree: Tree, value: i128, start: u32, end: u32) -> u32 {
    let neg = value < 0;
    // `i128::MIN` negates to itself; its magnitude 2^127 is that bit pattern.
    let magnitude = wrapping_u128(if neg { wrapping_neg_i128(value) } else { value });
    let lit = tree.ast.lits.alloc(
        Lit { kind: 1, neg: neg, bits: wrapping_u64(magnitude), hi: wrapping_u64(magnitude >> 64) }
    );
    add_expr(inout tree, node(1, start, end, lit.raw(), 0, 0), 0, 0)
}

pub fn add_name(inout tree: Tree, sym: u32, len: u64, start: u32, end: u32) -> u32 {
    add_expr(inout tree, node(2, start, end, sym, 0, 0), len, 0)
}

pub fn add_binary(
    inout tree: Tree,
    op: u32,
    cap: u64,
    left: u32,
    right: u32,
    start: u32,
    end: u32
) -> u32 {
    add_expr(inout tree, node(11, start, end, op, left, right), cap, 0)
}

// A two-argument call `callee(in left, in right)` with no type arguments.
pub fn add_call2(
    inout tree: Tree,
    callee: u32,
    left: u32,
    right: u32,
    start: u32,
    end: u32
) -> u32 {
    let left_arg = tree.ast.args.alloc(ArgNode { pass: 0, explicit: false, expr: left });
    let right_arg = tree.ast.args.alloc(ArgNode { pass: 0, explicit: false, expr: right });
    let mut words = ChunkSeq::new[u32]();
    words.push(left_arg.raw());
    words.push(right_arg.raw());
    let args = push_list(inout tree.ast, in words);
    add_expr(inout tree, node(6, start, end, callee, 0, args), 0, 2)
}

pub fn tree_new() -> Tree {
    Tree {
        ast: ast_new(),
        primary_cap: ChunkSeq::new[u64](),
        args_cap: ChunkSeq::new[u64](),
        symbols: ChunkSeq::new[u32]()
    }
}

pub fn sym_of(in tree: Tree, name_index: u64) -> u32 {
    match tree.symbols.try_get(name_index) {
        Option::Some(v) => v,
        Option::None => none(),
    }
}

// Names: a count, then each name's byte length and bytes, padded to words.
pub fn read_names(inout reader: Reader, in input: Str, inout tree: Tree) {
    let bytes = input.as_bytes();
    tree.symbols.clear();
    let count = reader.word(in bytes);
    for i in 0..count {
        let len = reader.word(in bytes);
        let start = reader.pos;
        let sym = tree.ast.names.intern(in input[start..wrapping_add(start, len)]);
        tree.symbols.push(sym.id());
        reader.pos = wrapping_add(start, wrapping_mul(wrapping_add(len, 7) / 8, 8));
    }
}

// The names of a split input (the hybrid module's, whose words are not
// UTF-8 and so cannot be a `Str`): the count, then each name's byte length;
// the names themselves follow one another in `text`.
pub fn read_names_text(
    inout reader: Reader,
    in bytes: Slice[u8],
    in text: Str,
    inout text_offset: u64,
    inout tree: Tree
) {
    tree.symbols.clear();
    let count = reader.word(in bytes);
    for i in 0..count {
        let len = reader.word(in bytes);
        let end = wrapping_add(text_offset, len);
        let sym = tree.ast.names.intern(in text[text_offset..end]);
        tree.symbols.push(sym.id());
        text_offset = end;
    }
}

// Expressions, children first: kind, start, end, then by kind
//   1 Literal: literal kind (1 Int), sign, magnitude
//   2 Name: name, string capacity
//   6 Call: callee, type count, type capacity, argument count, argument
//     capacity, then per argument pass, explicit, expression
//  11 Binary: operator name, string capacity, left, right
// and nothing for every other kind. Expression words are input indices,
// read through `map` (input index -> tree index).
pub fn read_exprs(
    inout reader: Reader,
    in bytes: Slice[u8],
    inout tree: Tree,
    inout map: ChunkSeq[u32]
) {
    map.clear();
    let count = reader.word(in bytes);
    for i in 0..count {
        let kind = wrapping_u8(reader.word(in bytes));
        let start = reader.word32(in bytes);
        let end = reader.word32(in bytes);
        let id = if kind == 1 {
            let lit_kind = wrapping_u8(reader.word(in bytes));
            let neg = reader.word(in bytes) != 0;
            let bits = reader.word(in bytes);
            let hi = reader.word(in bytes);
            let lit = tree.ast.lits.alloc(Lit { kind: lit_kind, neg: neg, bits: bits, hi: hi });
            add_expr(inout tree, node(1, start, end, lit.raw(), 0, 0), 0, 0)
        } else if kind == 2 {
            let sym = sym_of(in tree, reader.word(in bytes));
            let cap = reader.word(in bytes);
            add_expr(inout tree, node(2, start, end, sym, 0, 0), cap, 0)
        } else if kind == 6 {
            let callee = mapped(in map, reader.word(in bytes));
            let type_count = reader.word(in bytes);
            let types_cap = reader.word(in bytes);
            let arg_count = reader.word(in bytes);
            let args_cap = reader.word(in bytes);
            let mut type_words = ChunkSeq::new[u32]();
            for j in 0..type_count {
                let ty = tree.ast.types.alloc(TypeNode { kind: 5, a: 0, b: 0, c: 0, d: 0 });
                type_words.push(ty.raw());
            }
            let types = push_list(inout tree.ast, in type_words);
            let mut arg_words = ChunkSeq::new[u32]();
            for j in 0..arg_count {
                let pass = wrapping_u8(reader.word(in bytes));
                let explicit = reader.word(in bytes) != 0;
                let arg_expr = mapped(in map, reader.word(in bytes));
                let arg = tree.ast
                    .args
                    .alloc(ArgNode { pass: pass, explicit: explicit, expr: arg_expr });
                arg_words.push(arg.raw());
            }
            let args = push_list(inout tree.ast, in arg_words);
            add_expr(inout tree, node(6, start, end, callee, types, args), types_cap, args_cap)
        } else if kind == 11 {
            let op = sym_of(in tree, reader.word(in bytes));
            let cap = reader.word(in bytes);
            let left = mapped(in map, reader.word(in bytes));
            let right = mapped(in map, reader.word(in bytes));
            add_expr(inout tree, node(11, start, end, op, left, right), cap, 0)
        } else {
            add_expr(inout tree, node(kind, start, end, none(), none(), none()), 0, 0)
        };
        map.push(id);
    }
}

pub fn mapped(in map: ChunkSeq[u32], index: u64) -> u32 {
    match map.try_get(index) {
        Option::Some(v) => v,
        Option::None => none(),
    }
}

// Types: a count, then (start, end, code) rows in `TypeMap` order.
pub fn read_types(inout reader: Reader, in bytes: Slice[u8], inout types: ChunkSeq[TypeRow]) {
    types.clear();
    let count = reader.word(in bytes);
    for i in 0..count {
        let start = reader.word32(in bytes);
        let end = reader.word32(in bytes);
        let code = wrapping_u8(reader.word(in bytes));
        types.push(TypeRow { start: start, end: end, code: code });
    }
}

// The code of the type at span `start..end`, or 0 when the map has none.
pub fn type_code(in types: ChunkSeq[TypeRow], start: u32, end: u32) -> u8 {
    let mut lo: u64 = 0;
    let mut hi = types.len();
    loop {
        if lo >= hi {
            return 0;
        }
        let mid = wrapping_add(lo, (wrapping_sub(hi, lo)) >> 1);
        let row = match types.try_get(mid) {
            Option::Some(v) => v,
            Option::None => return 0,
        };
        if row.start == start && row.end == end {
            return row.code;
        }
        if row.start < start || (row.start == start && row.end < end) {
            lo = wrapping_add(mid, 1);
        } else {
            hi = mid;
        }
    }
}

fn wide(lo: u64, hi: u64) -> i128 {
    wrapping_shl_i128(widen_i128(wrapping_i64(hi)), 64) | widen_i128(lo)
}

// The certificate: versions, the two capacities, input, output,
// conclusion; the terms (kind, tag, then Const low and high words, an
// InputVar's variable, or an operation's op and children; five words
// each); the proofs (from, to, tag and six words each).
pub fn read_cert(inout reader: Reader, in bytes: Slice[u8], inout cert: Cert) {
    cert.schema_version = reader.word(in bytes);
    cert.arithmetic_version = reader.word(in bytes);
    cert.terms_cap = reader.word(in bytes);
    cert.proofs_cap = reader.word(in bytes);
    cert.input = reader.word32(in bytes);
    cert.output = reader.word32(in bytes);
    cert.conclusion = reader.word32(in bytes);
    cert.terms.clear();
    let term_count = reader.word(in bytes);
    for i in 0..term_count {
        let kind = wrapping_u8(reader.word(in bytes));
        let tag = wrapping_u8(reader.word(in bytes));
        let w1 = reader.word(in bytes);
        let w2 = reader.word(in bytes);
        let w3 = reader.word(in bytes);
        let row = if tag == 0 {
            TermRow { kind: kind, tag: 0, op: 0, value: wide(w1, w2), a: 0, b: 0 }
        } else if tag == 1 {
            TermRow { kind: kind, tag: 1, op: 0, value: 0, a: wrapping_u32(w1), b: 0 }
        } else {
            TermRow {
                kind: kind,
                tag: tag,
                op: wrapping_u8(w1),
                value: 0,
                a: wrapping_u32(w2),
                b: wrapping_u32(w3)
            }
        };
        cert.terms.push(row);
    }
    cert.proofs.clear();
    let proof_count = reader.word(in bytes);
    for i in 0..proof_count {
        let from = reader.word32(in bytes);
        let to = reader.word32(in bytes);
        let tag = wrapping_u8(reader.word(in bytes));
        let w1 = reader.word32(in bytes);
        let w2 = reader.word32(in bytes);
        let w3 = reader.word32(in bytes);
        let w4 = reader.word32(in bytes);
        let w5 = reader.word32(in bytes);
        let w6 = reader.word(in bytes);
        let row = if tag == 1 {
            ProofRow {
                from: from,
                to: to,
                tag: 1,
                rule: w1,
                b0: w2,
                b1: w3,
                b2: w4,
                len: w5,
                has_guard: w6 != 0,
                guard: wrapping_u32(wrapping_sub(w6, 1)),
                p0: 0,
                p1: 0
            }
        } else {
            ProofRow {
                from: from,
                to: to,
                tag: tag,
                rule: 0,
                b0: 0,
                b1: 0,
                b2: 0,
                len: 0,
                has_guard: false,
                guard: 0,
                p0: w1,
                p1: w2
            }
        };
        cert.proofs.push(row);
    }
}

pub fn cert_new() -> Cert {
    Cert {
        schema_version: 0,
        arithmetic_version: 0,
        terms_cap: 0,
        proofs_cap: 0,
        input: 0,
        output: 0,
        conclusion: 0,
        terms: ChunkSeq::new[TermRow](),
        proofs: ChunkSeq::new[ProofRow]()
    }
}
