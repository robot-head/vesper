// The cumulative attempt budget of src/optimize/witness.rs (`WitnessBudget`)
// and the vector capacities it charges for.
//
// The Rust checker charges `metadata` for every vector growth by the
// capacity `Vec::try_reserve_exact` asks for, so the Vesper checker keeps a
// model of each Rust vector's capacity next to the sequence that plays its
// part (`reserve`). Every function returns an error code: 0 is success,
// otherwise the `WitnessError` variant's position plus one (witness.ves).

// `WitnessError::Limit`.
const E_LIMIT: u8 = 2;

// `WitnessLimits` and the spent counters, in field order.
pub copy struct Budget {
    max_terms: u64,
    max_proofs: u64,
    max_input_nodes: u64,
    max_output_nodes: u64,
    max_depth: u64,
    max_variables: u64,
    max_name_bytes: u64,
    max_metadata_bytes: u64,
    max_work: u64,
    work: u64,
    metadata: u64,
    names: u64
}

// `add(a, b)?`: `Limit` on overflow.
pub fn add_or(a: u64, b: u64, inout out: u64) -> u8 {
    match checked_add_u64(a, b) {
        Option::Some(v) => {
            out = v;
            0
        }
        Option::None => E_LIMIT,
    }
}

// `mul(a, b)?`: `Limit` on overflow.
pub fn mul_or(a: u64, b: u64, inout out: u64) -> u8 {
    match checked_mul_u64(a, b) {
        Option::Some(v) => {
            out = v;
            0
        }
        Option::None => E_LIMIT,
    }
}

// `limit(value, max)`.
pub fn limit(value: u64, max: u64) -> u8 {
    if value > max {
        E_LIMIT
    } else {
        0
    }
}

// `WitnessBudget::work`: `checked_add(work, amount)` over `max_work` is
// `Limit`. Written as a comparison against the room left, which neither
// overflows nor builds an `Option`: when `work <= max_work`, the sum fits
// exactly when `amount <= max_work - work`, and when `work > max_work` every
// charge fails.
pub fn work(inout b: Budget, amount: u64) -> u8 {
    let w = b.work;
    let m = b.max_work;
    if w > m || amount > wrapping_sub(m, w) {
        return E_LIMIT;
    }
    b.work = wrapping_add(w, amount);
    0
}

// `count` calls of `work(b, 1)` that stop at the first refusal: the counter
// ends where those calls leave it (at `max_work` when one refuses after
// others passed, unchanged when the first refuses).
pub fn work_units(inout b: Budget, count: u64) -> u8 {
    if count == 0 {
        return 0;
    }
    let w = b.work;
    let m = b.max_work;
    if w >= m {
        return E_LIMIT;
    }
    if count > wrapping_sub(m, w) {
        b.work = m;
        return E_LIMIT;
    }
    b.work = wrapping_add(w, count);
    0
}

// `WitnessBudget::metadata`: the bytes count as work too.
pub fn metadata(inout b: Budget, amount: u64) -> u8 {
    let x = b.metadata;
    let m = b.max_metadata_bytes;
    if x > m || amount > wrapping_sub(m, x) {
        return E_LIMIT;
    }
    let e = work(inout b, amount);
    if e != 0 {
        return e;
    }
    b.metadata = wrapping_add(x, amount);
    0
}

// `WitnessBudget::names`: the bytes count as work too.
pub fn names(inout b: Budget, amount: u64) -> u8 {
    let x = b.names;
    let m = b.max_name_bytes;
    if x > m || amount > wrapping_sub(m, x) {
        return E_LIMIT;
    }
    let e = work(inout b, amount);
    if e != 0 {
        return e;
    }
    b.names = wrapping_add(x, amount);
    0
}

// `WitnessBudget::reserve(values, additional)` for a Rust vector of `len`
// elements of `size` bytes and capacity `cap`: a growth asks for the larger
// of the requirement, twice the capacity and one element, and charges its
// bytes before it happens. `cap` becomes the new capacity.
pub fn reserve(inout b: Budget, len: u64, inout cap: u64, additional: u64, size: u64) -> u8 {
    // The common case, room left, is small enough to inline.
    if additional <= cap && len <= wrapping_sub(cap, additional) {
        0
    } else {
        grow(inout b, len, inout cap, additional, size)
    }
}

// `reserve` when the vector grows.
fn grow(inout b: Budget, len: u64, inout cap: u64, additional: u64, size: u64) -> u8 {
    // Below these bounds no step overflows (the bytes stay under 2^50), so
    // the plain operations give the checked ones' values.
    if len >= SMALL || additional >= SMALL || cap >= SMALL || size >= SMALL_SIZE {
        return grow_checked(inout b, len, inout cap, additional, size);
    }
    let required = wrapping_add(len, additional);
    if required <= cap {
        return 0;
    }
    let doubled = wrapping_add(cap, cap);
    let mut capacity = required;
    if doubled > capacity {
        capacity = doubled;
    }
    if capacity < 1 {
        capacity = 1;
    }
    let e = metadata(inout b, wrapping_mul(capacity, size));
    if e != 0 {
        return e;
    }
    cap = capacity;
    0
}

const SMALL: u64 = 4294967296;
const SMALL_SIZE: u64 = 65536;

// `grow` with every step checked.
fn grow_checked(inout b: Budget, len: u64, inout cap: u64, additional: u64, size: u64) -> u8 {
    let required = match checked_add_u64(len, additional) {
        Option::Some(v) => v,
        Option::None => return E_LIMIT,
    };
    if required <= cap {
        return 0;
    }
    let doubled = match checked_mul_u64(cap, 2) {
        Option::Some(v) => v,
        Option::None => return E_LIMIT,
    };
    let mut capacity = required;
    if doubled > capacity {
        capacity = doubled;
    }
    if capacity < 1 {
        capacity = 1;
    }
    let bytes = match checked_mul_u64(capacity, size) {
        Option::Some(v) => v,
        Option::None => return E_LIMIT,
    };
    let e = metadata(inout b, bytes);
    if e != 0 {
        return e;
    }
    cap = capacity;
    0
}

// `WitnessBudget::new`: every limit in 1..=HARD, else `InvalidLimits` (1).
pub fn valid_limits(in b: Budget) -> u8 {
    let ok = b.max_terms >= 1
        && b.max_terms <= 16384
        && b.max_proofs >= 1
        && b.max_proofs <= 32768
        && b.max_input_nodes >= 1
        && b.max_input_nodes <= 2048
        && b.max_output_nodes >= 1
        && b.max_output_nodes <= 4096
        && b.max_depth >= 1
        && b.max_depth <= 128
        && b.max_variables >= 1
        && b.max_variables <= 512
        && b.max_name_bytes >= 1
        && b.max_name_bytes <= 65536
        && b.max_metadata_bytes >= 1
        && b.max_metadata_bytes <= 16777216
        && b.max_work >= 1
        && b.max_work <= 8000000;
    if ok {
        0
    } else {
        1
    }
}
