// The e-graph: egg 0.10's `EGraph` (no analysis, no explanations) as flat
// tables. Ids are u32. An e-node is an operator, one i64 of data (a
// constant, a variable number, a place) and up to two children; an
// operator's arity is fixed by the language table the graph is made with.
//
// egg's data structures and the order they are touched are kept wherever
// they decide a result:
//
// - `r_*` is egg's `nodes`: the original (uncanonical) e-node of every id,
//   append-only. An id is made only for a new e-class, so a class's e-nodes
//   are exactly the original e-nodes of its ids, canonicalized.
// - The union-find makes the class with more parents the root (egg's
//   `perform_union`; ties keep the first argument).
// - Parent lists are kept in egg's order: `concat_vecs` always appends the
//   smaller list (the second, after the swap), and a union pushes the
//   absorbed class's parents onto `pending`, which is a stack.
// - The hash-cons (`memo`) keeps stale keys, as egg's `HashMap` does, so its
//   size is egg's `total_size()`, which the node limit reads.
// - `rebuild` is `process_unions` then `rebuild_classes`: every class's
//   e-nodes canonicalized, sorted by egg's derived `Ord` (operator, data,
//   children) and deduplicated.
//
// What is not kept is the iteration order of egg's `classes` hash map:
// here classes are visited in ascending id order. See the README.

use self::util::{
    at32,
    at8,
    ati,
    at64,
    filled32,
    inc,
    mix,
    n32,
    w
};

const NONE: u32 = 4294967295;

pub struct EGraph {
    // The language: the arity (0, 1 or 2) of each operator.
    arity: ChunkSeq[u8],
    // egg's `nodes`: the original e-node of each id.
    r_op: ChunkSeq[u32],
    r_data: ChunkSeq[i64],
    r_c0: ChunkSeq[u32],
    r_c1: ChunkSeq[u32],
    // Union-find parents.
    parent: ChunkSeq[u32],
    // Per class root: its parent list (length, first and last cell) and
    // whether it holds a leaf (an arity-0 e-node).
    plen: ChunkSeq[u32],
    phead: ChunkSeq[u32],
    ptail: ChunkSeq[u32],
    leaf: ChunkSeq[u8],
    // Parent list cells.
    cell_val: ChunkSeq[u32],
    cell_next: ChunkSeq[u32],
    // The hash-cons: canonical e-node keys and the id each maps to.
    m_op: ChunkSeq[u32],
    m_data: ChunkSeq[i64],
    m_c0: ChunkSeq[u32],
    m_c1: ChunkSeq[u32],
    m_id: ChunkSeq[u32],
    m_hash: ChunkSeq[u64],
    // 0 is empty, otherwise key index + 1.
    slots: ChunkSeq[u32],
    mask: u64,
    pending: ChunkSeq[u32],
    classes: u64,
    clean: bool,
    // The rebuilt view: class `c`'s sorted e-nodes are
    // n_*[cstart[c] .. cstart[c] + clen[c]]; `live` is the class roots in
    // ascending order.
    cstart: ChunkSeq[u32],
    clen: ChunkSeq[u32],
    n_op: ChunkSeq[u32],
    n_data: ChunkSeq[i64],
    n_c0: ChunkSeq[u32],
    n_c1: ChunkSeq[u32],
    live: ChunkSeq[u32]
}

// An empty e-graph over operators with the given arities.
pub fn egraph_new(in arity: ChunkSeq[u8]) -> EGraph {
    let mut a: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](arity.len());
    for i in 0..arity.len() {
        a.push(at8(in arity, i));
    }
    EGraph {
        arity: a,
        r_op: ChunkSeq::new[u32](),
        r_data: ChunkSeq::new[i64](),
        r_c0: ChunkSeq::new[u32](),
        r_c1: ChunkSeq::new[u32](),
        parent: ChunkSeq::new[u32](),
        plen: ChunkSeq::new[u32](),
        phead: ChunkSeq::new[u32](),
        ptail: ChunkSeq::new[u32](),
        leaf: ChunkSeq::new[u8](),
        cell_val: ChunkSeq::new[u32](),
        cell_next: ChunkSeq::new[u32](),
        m_op: ChunkSeq::new[u32](),
        m_data: ChunkSeq::new[i64](),
        m_c0: ChunkSeq::new[u32](),
        m_c1: ChunkSeq::new[u32](),
        m_id: ChunkSeq::new[u32](),
        m_hash: ChunkSeq::new[u64](),
        slots: filled32(64, 0),
        mask: 63,
        pending: ChunkSeq::new[u32](),
        classes: 0,
        clean: true,
        cstart: ChunkSeq::new[u32](),
        clen: ChunkSeq::new[u32](),
        n_op: ChunkSeq::new[u32](),
        n_data: ChunkSeq::new[i64](),
        n_c0: ChunkSeq::new[u32](),
        n_c1: ChunkSeq::new[u32](),
        live: ChunkSeq::new[u32]()
    }
}

// The sort keys of `rebuild_classes`: class root and operator, data, and
// both children, for every id.
struct Keys {
    hi: ChunkSeq[u64],
    data: ChunkSeq[i64],
    lo: ChunkSeq[u64]
}

fn key_less(in k: Keys, a: u32, b: u32) -> bool {
    let x = at64(in k.hi, w(a));
    let y = at64(in k.hi, w(b));
    if x != y {
        return x < y;
    }
    let p = ati(in k.data, w(a));
    let q = ati(in k.data, w(b));
    if p != q {
        return p < q;
    }
    at64(in k.lo, w(a)) < at64(in k.lo, w(b))
}

fn key_same(in k: Keys, a: u32, b: u32) -> bool {
    at64(in k.hi, w(a))
        == at64(in k.hi, w(b))
        && ati(in k.data, w(a))
        == ati(in k.data, w(b))
        && at64(in k.lo, w(a))
        == at64(in k.lo, w(b))
}

// A stable bottom-up merge sort of `idx` by `k`.
fn sort_ids(inout idx: ChunkSeq[u32], in k: Keys) {
    let n = idx.len();
    let mut tmp: ChunkSeq[u32] = filled32(n, 0);
    let mut width: u64 = 1;
    loop {
        if width >= n {
            break;
        }
        let mut lo: u64 = 0;
        loop {
            if lo >= n {
                break;
            }
            let mut mid = wrapping_add(lo, width);
            if mid > n {
                mid = n;
            }
            let mut hi = wrapping_add(mid, width);
            if hi > n {
                hi = n;
            }
            let mut i = lo;
            let mut j = mid;
            let mut o = lo;
            loop {
                if o >= hi {
                    break;
                }
                let take_left = if i >= mid {
                    false
                } else if j >= hi {
                    true
                } else {
                    !key_less(in k, at32(in idx, j), at32(in idx, i))
                };
                if take_left {
                    tmp.try_set(o, at32(in idx, i));
                    i = inc(i);
                } else {
                    tmp.try_set(o, at32(in idx, j));
                    j = inc(j);
                }
                o = inc(o);
            }
            lo = hi;
        }
        for x in 0..n {
            idx.try_set(x, at32(in tmp, x));
        }
        width = wrapping_mul(width, 2);
    }
}

impl EGraph {
    pub fn arity_of(in self, op: u32) -> u8 {
        at8(in self.arity, w(op))
    }

    // The number of ids (egg's `nodes().len()`).
    pub fn raw_len(in self) -> u64 {
        self.r_op.len()
    }

    // egg's `total_size()`: hash-cons entries, stale ones included.
    pub fn memo_len(in self) -> u64 {
        self.m_id.len()
    }

    // egg's `number_of_classes()`.
    pub fn class_count(in self) -> u64 {
        self.classes
    }

    pub fn is_clean(in self) -> bool {
        self.clean
    }

    pub fn raw_op(in self, id: u32) -> u32 {
        at32(in self.r_op, w(id))
    }

    pub fn raw_data(in self, id: u32) -> i64 {
        ati(in self.r_data, w(id))
    }

    pub fn raw_child(in self, id: u32, i: u64) -> u32 {
        if i == 0 {
            at32(in self.r_c0, w(id))
        } else {
            at32(in self.r_c1, w(id))
        }
    }

    pub fn find(in self, id: u32) -> u32 {
        let mut x = id;
        loop {
            let p = at32(in self.parent, w(x));
            if p == x {
                return x;
            }
            x = p;
        }
    }

    // `find` with path halving (egg's `find_mut`).
    pub fn find_mut(inout self, id: u32) -> u32 {
        let mut x = id;
        loop {
            let p = at32(in self.parent, w(x));
            if p == x {
                return x;
            }
            let g = at32(in self.parent, w(p));
            self.parent.try_set(w(x), g);
            x = g;
        }
    }

    // Whether the class of `id` holds a leaf. Valid in a dirty graph: a
    // union keeps the flag of both classes.
    pub fn has_leaf(in self, id: u32) -> bool {
        let r = self.find(id);
        at8(in self.leaf, w(r)) != 0
    }

    fn slot_of(in self, h: u64, op: u32, data: i64, c0: u32, c1: u32) -> (u64, u32) {
        let mut at = h & self.mask;
        loop {
            let s = at32(in self.slots, at);
            if s == 0 {
                return (at, NONE);
            }
            let k = w(wrapping_sub(s, 1));
            if at64(in self.m_hash, k)
                == h
                && at32(in self.m_op, k)
                == op
                && ati(in self.m_data, k)
                == data
                && at32(in self.m_c0, k)
                == c0
                && at32(in self.m_c1, k)
                == c1 {
                return (at, n32(k));
            }
            at = inc(at) & self.mask;
        }
    }

    fn memo_grow(inout self) {
        let cap = wrapping_mul(wrapping_add(self.mask, 1), 2);
        let mask = wrapping_sub(cap, 1);
        let mut slots = filled32(cap, 0);
        for k in 0..self.m_hash.len() {
            let mut at = at64(in self.m_hash, k) & mask;
            loop {
                if at32(in slots, at) == 0 {
                    break;
                }
                at = inc(at) & mask;
            }
            slots.try_set(at, n32(inc(k)));
        }
        self.slots = slots;
        self.mask = mask;
    }

    // The id the hash-cons maps a canonical e-node to, or NONE.
    pub fn memo_get(in self, op: u32, data: i64, c0: u32, c1: u32) -> u32 {
        let h = mix(op, data, c0, c1);
        let (_at, k) = self.slot_of(h, op, data, c0, c1);
        if k == NONE {
            NONE
        } else {
            at32(in self.m_id, w(k))
        }
    }

    // egg's `memo.insert`: maps the key to `id` and returns the id it
    // mapped to before, or NONE.
    fn memo_insert(inout self, op: u32, data: i64, c0: u32, c1: u32, id: u32) -> u32 {
        let h = mix(op, data, c0, c1);
        let (at, k) = self.slot_of(h, op, data, c0, c1);
        if k != NONE {
            let old = at32(in self.m_id, w(k));
            self.m_id.try_set(w(k), id);
            return old;
        }
        let next = self.m_id.len();
        self.m_op.push(op);
        self.m_data.push(data);
        self.m_c0.push(c0);
        self.m_c1.push(c1);
        self.m_id.push(id);
        self.m_hash.push(h);
        self.slots.try_set(at, n32(inc(next)));
        if wrapping_mul(inc(next), 2) > self.mask {
            self.memo_grow();
        }
        NONE
    }

    fn push_parent(inout self, root: u32, id: u32) {
        let cell = n32(self.cell_val.len());
        self.cell_val.push(id);
        self.cell_next.push(NONE);
        let r = w(root);
        let tail = at32(in self.ptail, r);
        if tail == NONE {
            self.phead.try_set(r, cell);
        } else {
            self.cell_next.try_set(w(tail), cell);
        }
        self.ptail.try_set(r, cell);
        self.plen.try_set(r, wrapping_add(at32(in self.plen, r), 1));
    }

    fn make_class(inout self, op: u32, data: i64, c0: u32, c1: u32, o0: u32, o1: u32) -> u32 {
        let id = n32(self.r_op.len());
        self.parent.push(id);
        self.r_op.push(op);
        self.r_data.push(data);
        self.r_c0.push(o0);
        self.r_c1.push(o1);
        self.plen.push(0);
        self.phead.push(NONE);
        self.ptail.push(NONE);
        let a = self.arity_of(op);
        if a == 0 {
            self.leaf.push(1);
        } else {
            self.leaf.push(0);
        }
        self.cstart.push(0);
        self.clen.push(0);
        if a >= 1 {
            self.push_parent(c0, id);
        }
        if a >= 2 {
            self.push_parent(c1, id);
        }
        self.pending.push(id);
        self.memo_insert(op, data, c0, c1, id);
        self.classes = inc(self.classes);
        self.clean = false;
        id
    }

    // egg's `add_uncanonical`: the existing id of an equal e-node (which
    // may not be canonical), or a new class.
    pub fn add_uncanonical(inout self, op: u32, data: i64, o0: u32, o1: u32) -> u32 {
        let a = self.arity_of(op);
        let c0 = if a >= 1 {
            self.find(o0)
        } else {
            0
        };
        let c1 = if a >= 2 {
            self.find(o1)
        } else {
            0
        };
        let existing = self.memo_get(op, data, c0, c1);
        if existing != NONE {
            return existing;
        }
        self.make_class(op, data, c0, c1, o0, o1)
    }

    // egg's `add`: the canonical class of the e-node.
    pub fn add(inout self, op: u32, data: i64, c0: u32, c1: u32) -> u32 {
        let id = self.add_uncanonical(op, data, c0, c1);
        self.find(id)
    }

    // The canonical class of an e-node already in the graph, or NONE (egg's
    // `lookup`).
    pub fn lookup(in self, op: u32, data: i64, c0: u32, c1: u32) -> u32 {
        let a = self.arity_of(op);
        let k0 = if a >= 1 {
            self.find(c0)
        } else {
            0
        };
        let k1 = if a >= 2 {
            self.find(c1)
        } else {
            0
        };
        let id = self.memo_get(op, data, k0, k1);
        if id == NONE {
            NONE
        } else {
            self.find(id)
        }
    }

    // egg's `union` (`perform_union`): whether two classes were merged.
    pub fn union(inout self, a: u32, b: u32) -> bool {
        self.clean = false;
        let mut x = self.find_mut(a);
        let mut y = self.find_mut(b);
        if x == y {
            return false;
        }
        if at32(in self.plen, w(x)) < at32(in self.plen, w(y)) {
            let t = x;
            x = y;
            y = t;
        }
        self.parent.try_set(w(y), x);
        // pending.extend(class2.parents)
        let mut c = at32(in self.phead, w(y));
        loop {
            if c == NONE {
                break;
            }
            self.pending.push(at32(in self.cell_val, w(c)));
            c = at32(in self.cell_next, w(c));
        }
        // concat_vecs(class1.parents, class2.parents): class 1 is the longer.
        let h2 = at32(in self.phead, w(y));
        if h2 != NONE {
            let t1 = at32(in self.ptail, w(x));
            if t1 == NONE {
                self.phead.try_set(w(x), h2);
            } else {
                self.cell_next.try_set(w(t1), h2);
            }
            self.ptail.try_set(w(x), at32(in self.ptail, w(y)));
        }
        self.plen.try_set(w(x), wrapping_add(at32(in self.plen, w(x)), at32(in self.plen, w(y))));
        if at8(in self.leaf, w(y)) != 0 {
            self.leaf.try_set(w(x), 1);
        }
        self.classes = wrapping_sub(self.classes, 1);
        true
    }

    fn process_unions(inout self) -> u64 {
        let mut n: u64 = 0;
        loop {
            let id = match self.pending.pop() {
                Option::Some(x) => x,
                Option::None => break,
            };
            let op = self.raw_op(id);
            let a = self.arity_of(op);
            let c0 = if a >= 1 {
                let r = self.raw_child(id, 0);
                self.find_mut(r)
            } else {
                0
            };
            let c1 = if a >= 2 {
                let r = self.raw_child(id, 1);
                self.find_mut(r)
            } else {
                0
            };
            let d = self.raw_data(id);
            let old = self.memo_insert(op, d, c0, c1, id);
            if old != NONE {
                if self.union(old, id) {
                    n = inc(n);
                }
            }
        }
        n
    }

    fn rebuild_classes(inout self) {
        let n = self.raw_len();
        let mut keys = Keys {
            hi: ChunkSeq::with_capacity[u64](n),
            data: ChunkSeq::with_capacity[i64](n),
            lo: ChunkSeq::with_capacity[u64](n)
        };
        let mut idx: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](n);
        for k in 0..n {
            let id = n32(k);
            let r = self.find_mut(id);
            let op = self.raw_op(id);
            let a = self.arity_of(op);
            let c0 = if a >= 1 {
                let x = self.raw_child(id, 0);
                self.find_mut(x)
            } else {
                0
            };
            let c1 = if a >= 2 {
                let x = self.raw_child(id, 1);
                self.find_mut(x)
            } else {
                0
            };
            keys.hi.push(wrapping_shl_u64(w(r), 32) | w(op));
            let d = self.raw_data(id);
            keys.data.push(d);
            keys.lo.push(wrapping_shl_u64(w(c0), 32) | w(c1));
            idx.push(id);
        }
        sort_ids(inout idx, in keys);
        self.n_op.clear();
        self.n_data.clear();
        self.n_c0.clear();
        self.n_c1.clear();
        self.live.clear();
        let mut prev: u32 = NONE;
        let mut prev_root: u32 = NONE;
        for i in 0..n {
            let id = at32(in idx, i);
            if prev != NONE && key_same(in keys, prev, id) {
                continue;
            }
            prev = id;
            let hi = at64(in keys.hi, w(id));
            let root = n32(hi >> 32);
            if root != prev_root {
                prev_root = root;
                self.live.push(root);
                self.cstart.try_set(w(root), n32(self.n_op.len()));
                self.clen.try_set(w(root), 0);
            }
            let lo = at64(in keys.lo, w(id));
            self.n_op.push(n32(hi & 4294967295));
            self.n_data.push(ati(in keys.data, w(id)));
            self.n_c0.push(n32(lo >> 32));
            self.n_c1.push(n32(lo & 4294967295));
            self.clen.try_set(w(root), wrapping_add(at32(in self.clen, w(root)), 1));
        }
    }

    // egg's `rebuild`: restores congruence and the sorted class view.
    // Returns the number of unions congruence made.
    pub fn rebuild(inout self) -> u64 {
        let n = self.process_unions();
        self.rebuild_classes();
        self.clean = true;
        n
    }

    // The rebuilt view (valid when clean).
    pub fn live_count(in self) -> u64 {
        self.live.len()
    }

    pub fn live_at(in self, i: u64) -> u32 {
        at32(in self.live, i)
    }

    pub fn class_start(in self, root: u32) -> u64 {
        w(at32(in self.cstart, w(root)))
    }

    pub fn class_len(in self, root: u32) -> u64 {
        w(at32(in self.clen, w(root)))
    }

    pub fn node_op(in self, k: u64) -> u32 {
        at32(in self.n_op, k)
    }

    pub fn node_data(in self, k: u64) -> i64 {
        ati(in self.n_data, k)
    }

    pub fn node_child(in self, k: u64, i: u64) -> u32 {
        if i == 0 {
            at32(in self.n_c0, k)
        } else {
            at32(in self.n_c1, k)
        }
    }
}
