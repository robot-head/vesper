// The e-graph: egg 0.10's `EGraph` (no analysis, no explanations) as flat
// tables. Ids are u32. An e-node is an operator, one i64 of data (a
// constant, a variable number, a place) and up to two children; an
// operator's arity is fixed by the language table the graph is made with.
//
// egg's data structures and the order they are touched are kept wherever
// they decide a result:
//
// - `orig_*` is egg's `nodes`: the original (uncanonical) e-node of every id,
//   append-only. An id is made only for a new e-class, so a class's e-nodes
//   are exactly the original e-nodes of its ids, canonicalized.
// - The union-find makes the class with more parents the root (egg's
//   `perform_union`; ties keep the first argument).
// - Parent lists are kept in egg's order: `concat_vecs` always appends the
//   smaller list (the second, after the swap), and a union pushes the
//   absorbed class's parents onto `pending`, which is a stack.
// - The hash-cons (`memo`) keeps stale keys, as egg's `HashMap` does, so its
//   size is egg's `total_size()`, which the node limit reads.
// - `rebuild` is `process_unions` then `rebuild_classes`: every class's
//   e-nodes canonicalized, sorted by egg's derived `Ord` (operator, data,
//   children) and deduplicated.
//
// What is not kept is the iteration order of egg's `classes` hash map:
// here classes are visited in ascending id order. See the README.

use self::util::{filled_u32, i64_at, mix, u32_at, u64_at, u8_at};

const NONE: u32 = 4294967295;

pub struct EGraph {
    // The language: the arity (0, 1 or 2) of each operator.
    op_arity: ChunkSeq[u8],
    // egg's `nodes`: the original e-node of each id.
    orig_op: ChunkSeq[u32],
    orig_data: ChunkSeq[i64],
    orig_child0: ChunkSeq[u32],
    orig_child1: ChunkSeq[u32],
    // Union-find parents.
    parent: ChunkSeq[u32],
    // Per class root: its parent list (length, first and last cell) and
    // whether it holds a leaf (an arity-0 e-node).
    parent_len: ChunkSeq[u32],
    parent_head: ChunkSeq[u32],
    parent_tail: ChunkSeq[u32],
    holds_leaf: ChunkSeq[u8],
    // Parent list cells.
    cell_parent: ChunkSeq[u32],
    cell_next: ChunkSeq[u32],
    // The hash-cons: canonical e-node keys and the id each maps to.
    memo_op: ChunkSeq[u32],
    memo_data: ChunkSeq[i64],
    memo_child0: ChunkSeq[u32],
    memo_child1: ChunkSeq[u32],
    memo_id: ChunkSeq[u32],
    memo_hash: ChunkSeq[u64],
    // 0 is empty, otherwise key index + 1.
    slots: ChunkSeq[u32],
    slot_mask: u64,
    pending: ChunkSeq[u32],
    classes: u64,
    clean: bool,
    // The rebuilt view: class `c`'s sorted e-nodes are
    // sorted_*[class_starts[c] .. class_starts[c] + class_lens[c]]; `live_roots`
    // is the class roots in ascending order.
    class_starts: ChunkSeq[u32],
    class_lens: ChunkSeq[u32],
    sorted_op: ChunkSeq[u32],
    sorted_data: ChunkSeq[i64],
    sorted_child0: ChunkSeq[u32],
    sorted_child1: ChunkSeq[u32],
    live_roots: ChunkSeq[u32]
}

// An empty e-graph over operators with the given arities.
pub fn egraph_new(in arities: ChunkSeq[u8]) -> EGraph {
    let mut op_arity: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](arities.len());
    for i in 0..arities.len() {
        op_arity.push(u8_at(in arities, i));
    }
    EGraph {
        op_arity: op_arity,
        orig_op: ChunkSeq::new[u32](),
        orig_data: ChunkSeq::new[i64](),
        orig_child0: ChunkSeq::new[u32](),
        orig_child1: ChunkSeq::new[u32](),
        parent: ChunkSeq::new[u32](),
        parent_len: ChunkSeq::new[u32](),
        parent_head: ChunkSeq::new[u32](),
        parent_tail: ChunkSeq::new[u32](),
        holds_leaf: ChunkSeq::new[u8](),
        cell_parent: ChunkSeq::new[u32](),
        cell_next: ChunkSeq::new[u32](),
        memo_op: ChunkSeq::new[u32](),
        memo_data: ChunkSeq::new[i64](),
        memo_child0: ChunkSeq::new[u32](),
        memo_child1: ChunkSeq::new[u32](),
        memo_id: ChunkSeq::new[u32](),
        memo_hash: ChunkSeq::new[u64](),
        slots: filled_u32(64, 0),
        slot_mask: 63,
        pending: ChunkSeq::new[u32](),
        classes: 0,
        clean: true,
        class_starts: ChunkSeq::new[u32](),
        class_lens: ChunkSeq::new[u32](),
        sorted_op: ChunkSeq::new[u32](),
        sorted_data: ChunkSeq::new[i64](),
        sorted_child0: ChunkSeq::new[u32](),
        sorted_child1: ChunkSeq::new[u32](),
        live_roots: ChunkSeq::new[u32]()
    }
}

// The sort keys of `rebuild_classes`: class root and operator, data, and
// both children, for every id.
struct Keys {
    root_op: ChunkSeq[u64],
    data: ChunkSeq[i64],
    children: ChunkSeq[u64]
}

fn key_less(in keys: Keys, id_a: u32, id_b: u32) -> bool {
    let root_op_a = u64_at(in keys.root_op, widen_u64(id_a));
    let root_op_b = u64_at(in keys.root_op, widen_u64(id_b));
    if root_op_a != root_op_b {
        return root_op_a < root_op_b;
    }
    let data_a = i64_at(in keys.data, widen_u64(id_a));
    let data_b = i64_at(in keys.data, widen_u64(id_b));
    if data_a != data_b {
        return data_a < data_b;
    }
    u64_at(in keys.children, widen_u64(id_a)) < u64_at(in keys.children, widen_u64(id_b))
}

fn key_same(in keys: Keys, id_a: u32, id_b: u32) -> bool {
    u64_at(in keys.root_op, widen_u64(id_a)) == u64_at(in keys.root_op, widen_u64(id_b))
        && i64_at(in keys.data, widen_u64(id_a)) == i64_at(in keys.data, widen_u64(id_b))
        && u64_at(in keys.children, widen_u64(id_a)) == u64_at(in keys.children, widen_u64(id_b))
}

// A stable bottom-up merge sort of `ids` by `keys`.
fn sort_ids(inout ids: ChunkSeq[u32], in keys: Keys) {
    let len = ids.len();
    let mut merged: ChunkSeq[u32] = filled_u32(len, 0);
    let mut width: u64 = 1;
    loop {
        if width >= len {
            break;
        }
        let mut lo: u64 = 0;
        loop {
            if lo >= len {
                break;
            }
            let mut mid = wrapping_add(lo, width);
            if mid > len {
                mid = len;
            }
            let mut hi = wrapping_add(mid, width);
            if hi > len {
                hi = len;
            }
            let mut left = lo;
            let mut right = mid;
            let mut out = lo;
            loop {
                if out >= hi {
                    break;
                }
                let take_left = if left >= mid {
                    false
                } else if right >= hi {
                    true
                } else {
                    !key_less(in keys, u32_at(in ids, right), u32_at(in ids, left))
                };
                if take_left {
                    merged.try_set(out, u32_at(in ids, left));
                    left = wrapping_add(left, 1);
                } else {
                    merged.try_set(out, u32_at(in ids, right));
                    right = wrapping_add(right, 1);
                }
                out = wrapping_add(out, 1);
            }
            lo = hi;
        }
        for index in 0..len {
            ids.try_set(index, u32_at(in merged, index));
        }
        width = wrapping_mul(width, 2);
    }
}

impl EGraph {
    pub fn arity_of(in self, op: u32) -> u8 {
        u8_at(in self.op_arity, widen_u64(op))
    }

    // The number of ids (egg's `nodes().len()`).
    pub fn raw_len(in self) -> u64 {
        self.orig_op.len()
    }

    // egg's `total_size()`: hash-cons entries, stale ones included.
    pub fn memo_len(in self) -> u64 {
        self.memo_id.len()
    }

    // egg's `number_of_classes()`.
    pub fn class_count(in self) -> u64 {
        self.classes
    }

    pub fn is_clean(in self) -> bool {
        self.clean
    }

    pub fn raw_op(in self, id: u32) -> u32 {
        u32_at(in self.orig_op, widen_u64(id))
    }

    pub fn raw_data(in self, id: u32) -> i64 {
        i64_at(in self.orig_data, widen_u64(id))
    }

    pub fn raw_child(in self, id: u32, child_index: u64) -> u32 {
        if child_index == 0 {
            u32_at(in self.orig_child0, widen_u64(id))
        } else {
            u32_at(in self.orig_child1, widen_u64(id))
        }
    }

    pub fn find(in self, id: u32) -> u32 {
        let mut node = id;
        loop {
            let parent = u32_at(in self.parent, widen_u64(node));
            if parent == node {
                return node;
            }
            node = parent;
        }
    }

    // `find` with path halving (egg's `find_mut`).
    pub fn find_mut(inout self, id: u32) -> u32 {
        let mut node = id;
        loop {
            let parent = u32_at(in self.parent, widen_u64(node));
            if parent == node {
                return node;
            }
            let grandparent = u32_at(in self.parent, widen_u64(parent));
            self.parent.try_set(widen_u64(node), grandparent);
            node = grandparent;
        }
    }

    // Whether the class of `id` holds a leaf. Valid in a dirty graph: a
    // union keeps the flag of both classes.
    pub fn has_leaf(in self, id: u32) -> bool {
        let root = self.find(id);
        u8_at(in self.holds_leaf, widen_u64(root)) != 0
    }

    fn slot_of(in self, hash: u64, op: u32, data: i64, child0: u32, child1: u32) -> (u64, u32) {
        let mut at = hash & self.slot_mask;
        loop {
            let slot = u32_at(in self.slots, at);
            if slot == 0 {
                return (at, NONE);
            }
            let key = widen_u64(wrapping_sub(slot, 1));
            if u64_at(in self.memo_hash, key) == hash
                && u32_at(in self.memo_op, key) == op
                && i64_at(in self.memo_data, key) == data
                && u32_at(in self.memo_child0, key) == child0
                && u32_at(in self.memo_child1, key) == child1 {
                return (at, wrapping_u32(key));
            }
            at = wrapping_add(at, 1) & self.slot_mask;
        }
    }

    fn memo_grow(inout self) {
        let cap = wrapping_mul(wrapping_add(self.slot_mask, 1), 2);
        let mask = wrapping_sub(cap, 1);
        let mut slots = filled_u32(cap, 0);
        for key in 0..self.memo_hash.len() {
            let mut at = u64_at(in self.memo_hash, key) & mask;
            loop {
                if u32_at(in slots, at) == 0 {
                    break;
                }
                at = wrapping_add(at, 1) & mask;
            }
            slots.try_set(at, wrapping_u32(wrapping_add(key, 1)));
        }
        self.slots = slots;
        self.slot_mask = mask;
    }

    // The id the hash-cons maps a canonical e-node to, or NONE.
    pub fn memo_get(in self, op: u32, data: i64, child0: u32, child1: u32) -> u32 {
        let hash = mix(op, data, child0, child1);
        let (_at, key) = self.slot_of(hash, op, data, child0, child1);
        if key == NONE {
            NONE
        } else {
            u32_at(in self.memo_id, widen_u64(key))
        }
    }

    // egg's `memo.insert`: maps the key to `id` and returns the id it
    // mapped to before, or NONE.
    fn memo_insert(inout self, op: u32, data: i64, child0: u32, child1: u32, id: u32) -> u32 {
        let hash = mix(op, data, child0, child1);
        let (at, key) = self.slot_of(hash, op, data, child0, child1);
        if key != NONE {
            let old_id = u32_at(in self.memo_id, widen_u64(key));
            self.memo_id.try_set(widen_u64(key), id);
            return old_id;
        }
        let key_count = self.memo_id.len();
        self.memo_op.push(op);
        self.memo_data.push(data);
        self.memo_child0.push(child0);
        self.memo_child1.push(child1);
        self.memo_id.push(id);
        self.memo_hash.push(hash);
        self.slots.try_set(at, wrapping_u32(wrapping_add(key_count, 1)));
        if wrapping_mul(wrapping_add(key_count, 1), 2) > self.slot_mask {
            self.memo_grow();
        }
        NONE
    }

    fn push_parent(inout self, root: u32, id: u32) {
        let cell = wrapping_u32(self.cell_parent.len());
        self.cell_parent.push(id);
        self.cell_next.push(NONE);
        let root_index = widen_u64(root);
        let tail = u32_at(in self.parent_tail, root_index);
        if tail == NONE {
            self.parent_head.try_set(root_index, cell);
        } else {
            self.cell_next.try_set(widen_u64(tail), cell);
        }
        self.parent_tail.try_set(root_index, cell);
        self.parent_len
            .try_set(root_index, wrapping_add(u32_at(in self.parent_len, root_index), 1));
    }

    fn make_class(
        inout self,
        op: u32,
        data: i64,
        child0: u32,
        child1: u32,
        orig_child0: u32,
        orig_child1: u32
    ) -> u32 {
        let id = wrapping_u32(self.orig_op.len());
        self.parent.push(id);
        self.orig_op.push(op);
        self.orig_data.push(data);
        self.orig_child0.push(orig_child0);
        self.orig_child1.push(orig_child1);
        self.parent_len.push(0);
        self.parent_head.push(NONE);
        self.parent_tail.push(NONE);
        let arity = self.arity_of(op);
        if arity == 0 {
            self.holds_leaf.push(1);
        } else {
            self.holds_leaf.push(0);
        }
        self.class_starts.push(0);
        self.class_lens.push(0);
        if arity >= 1 {
            self.push_parent(child0, id);
        }
        if arity >= 2 {
            self.push_parent(child1, id);
        }
        self.pending.push(id);
        self.memo_insert(op, data, child0, child1, id);
        self.classes = wrapping_add(self.classes, 1);
        self.clean = false;
        id
    }

    // egg's `add_uncanonical`: the existing id of an equal e-node (which
    // may not be canonical), or a new class.
    pub fn add_uncanonical(
        inout self,
        op: u32,
        data: i64,
        orig_child0: u32,
        orig_child1: u32
    ) -> u32 {
        let arity = self.arity_of(op);
        let child0 = if arity >= 1 {
            self.find(orig_child0)
        } else {
            0
        };
        let child1 = if arity >= 2 {
            self.find(orig_child1)
        } else {
            0
        };
        let existing = self.memo_get(op, data, child0, child1);
        if existing != NONE {
            return existing;
        }
        self.make_class(op, data, child0, child1, orig_child0, orig_child1)
    }

    // egg's `add`: the canonical class of the e-node.
    pub fn add(inout self, op: u32, data: i64, child0: u32, child1: u32) -> u32 {
        let id = self.add_uncanonical(op, data, child0, child1);
        self.find(id)
    }

    // The canonical class of an e-node already in the graph, or NONE (egg's
    // `lookup`).
    pub fn lookup(in self, op: u32, data: i64, child0: u32, child1: u32) -> u32 {
        let arity = self.arity_of(op);
        let class0 = if arity >= 1 { self.find(child0) } else { 0 };
        let class1 = if arity >= 2 { self.find(child1) } else { 0 };
        let id = self.memo_get(op, data, class0, class1);
        if id == NONE { NONE } else { self.find(id) }
    }

    // egg's `union` (`perform_union`): whether two classes were merged.
    pub fn union(inout self, first: u32, second: u32) -> bool {
        self.clean = false;
        let mut kept = self.find_mut(first);
        let mut absorbed = self.find_mut(second);
        if kept == absorbed {
            return false;
        }
        if u32_at(in self.parent_len, widen_u64(kept))
            < u32_at(in self.parent_len, widen_u64(absorbed)) {
            let swap = kept;
            kept = absorbed;
            absorbed = swap;
        }
        self.parent.try_set(widen_u64(absorbed), kept);
        // pending.extend(class2.parents)
        let mut cell = u32_at(in self.parent_head, widen_u64(absorbed));
        loop {
            if cell == NONE {
                break;
            }
            self.pending.push(u32_at(in self.cell_parent, widen_u64(cell)));
            cell = u32_at(in self.cell_next, widen_u64(cell));
        }
        // concat_vecs(class1.parents, class2.parents): class 1 is the longer.
        let absorbed_head = u32_at(in self.parent_head, widen_u64(absorbed));
        if absorbed_head != NONE {
            let kept_tail = u32_at(in self.parent_tail, widen_u64(kept));
            if kept_tail == NONE {
                self.parent_head.try_set(widen_u64(kept), absorbed_head);
            } else {
                self.cell_next.try_set(widen_u64(kept_tail), absorbed_head);
            }
            self.parent_tail
                .try_set(widen_u64(kept), u32_at(in self.parent_tail, widen_u64(absorbed)));
        }
        self.parent_len.try_set(
            widen_u64(kept),
            wrapping_add(
                u32_at(in self.parent_len, widen_u64(kept)),
                u32_at(in self.parent_len, widen_u64(absorbed))
            )
        );
        if u8_at(in self.holds_leaf, widen_u64(absorbed)) != 0 {
            self.holds_leaf.try_set(widen_u64(kept), 1);
        }
        self.classes = wrapping_sub(self.classes, 1);
        true
    }

    fn process_unions(inout self) -> u64 {
        let mut unions: u64 = 0;
        loop {
            let id = match self.pending.pop() {
                Option::Some(pending_id) => pending_id,
                Option::None => break,
            };
            let op = self.raw_op(id);
            let arity = self.arity_of(op);
            let child0 = if arity >= 1 {
                let raw = self.raw_child(id, 0);
                self.find_mut(raw)
            } else {
                0
            };
            let child1 = if arity >= 2 {
                let raw = self.raw_child(id, 1);
                self.find_mut(raw)
            } else {
                0
            };
            let data = self.raw_data(id);
            let old_id = self.memo_insert(op, data, child0, child1, id);
            if old_id != NONE {
                if self.union(old_id, id) {
                    unions = wrapping_add(unions, 1);
                }
            }
        }
        unions
    }

    fn rebuild_classes(inout self) {
        let id_count = self.raw_len();
        let mut keys = Keys {
            root_op: ChunkSeq::with_capacity[u64](id_count),
            data: ChunkSeq::with_capacity[i64](id_count),
            children: ChunkSeq::with_capacity[u64](id_count)
        };
        let mut order: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](id_count);
        for index in 0..id_count {
            let id = wrapping_u32(index);
            let class_root = self.find_mut(id);
            let op = self.raw_op(id);
            let arity = self.arity_of(op);
            let child0 = if arity >= 1 {
                let raw = self.raw_child(id, 0);
                self.find_mut(raw)
            } else {
                0
            };
            let child1 = if arity >= 2 {
                let raw = self.raw_child(id, 1);
                self.find_mut(raw)
            } else {
                0
            };
            keys.root_op.push(wrapping_shl_u64(widen_u64(class_root), 32) | widen_u64(op));
            let data = self.raw_data(id);
            keys.data.push(data);
            keys.children.push(wrapping_shl_u64(widen_u64(child0), 32) | widen_u64(child1));
            order.push(id);
        }
        sort_ids(inout order, in keys);
        self.sorted_op.clear();
        self.sorted_data.clear();
        self.sorted_child0.clear();
        self.sorted_child1.clear();
        self.live_roots.clear();
        let mut prev_id: u32 = NONE;
        let mut prev_root: u32 = NONE;
        for i in 0..id_count {
            let id = u32_at(in order, i);
            if prev_id != NONE && key_same(in keys, prev_id, id) {
                continue;
            }
            prev_id = id;
            let root_op = u64_at(in keys.root_op, widen_u64(id));
            let root = wrapping_u32(root_op >> 32);
            if root != prev_root {
                prev_root = root;
                self.live_roots.push(root);
                self.class_starts.try_set(widen_u64(root), wrapping_u32(self.sorted_op.len()));
                self.class_lens.try_set(widen_u64(root), 0);
            }
            let children = u64_at(in keys.children, widen_u64(id));
            self.sorted_op.push(wrapping_u32(root_op & 4294967295));
            self.sorted_data.push(i64_at(in keys.data, widen_u64(id)));
            self.sorted_child0.push(wrapping_u32(children >> 32));
            self.sorted_child1.push(wrapping_u32(children & 4294967295));
            self.class_lens.try_set(
                widen_u64(root),
                wrapping_add(u32_at(in self.class_lens, widen_u64(root)), 1)
            );
        }
    }

    // egg's `rebuild`: restores congruence and the sorted class view.
    // Returns the number of unions congruence made.
    pub fn rebuild(inout self) -> u64 {
        let unions = self.process_unions();
        self.rebuild_classes();
        self.clean = true;
        unions
    }

    // The rebuilt view (valid when clean).
    pub fn live_count(in self) -> u64 {
        self.live_roots.len()
    }

    pub fn live_at(in self, index: u64) -> u32 {
        u32_at(in self.live_roots, index)
    }

    pub fn class_start(in self, root: u32) -> u64 {
        widen_u64(u32_at(in self.class_starts, widen_u64(root)))
    }

    pub fn class_len(in self, root: u32) -> u64 {
        widen_u64(u32_at(in self.class_lens, widen_u64(root)))
    }

    pub fn node_op(in self, node: u64) -> u32 {
        u32_at(in self.sorted_op, node)
    }

    pub fn node_data(in self, node: u64) -> i64 {
        i64_at(in self.sorted_data, node)
    }

    pub fn node_child(in self, node: u64, child_index: u64) -> u32 {
        if child_index == 0 {
            u32_at(in self.sorted_child0, node)
        } else {
            u32_at(in self.sorted_child1, node)
        }
    }
}
