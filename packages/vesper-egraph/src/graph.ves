// The e-graph: egg 0.10's `EGraph` (no analysis, no explanations) as flat
// tables. Ids are u32. An e-node is an operator, one i64 of data (a
// constant, a variable number, a place) and up to two children; an
// operator's arity is fixed by the language table the graph is made with.
//
// egg's data structures and the order they are touched are kept wherever
// they decide a result:
//
// - `r_*` is egg's `nodes`: the original (uncanonical) e-node of every id,
//   append-only. An id is made only for a new e-class, so a class's e-nodes
//   are exactly the original e-nodes of its ids, canonicalized.
// - The union-find makes the class with more parents the root (egg's
//   `perform_union`; ties keep the first argument).
// - Parent lists are kept in egg's order: `concat_vecs` always appends the
//   smaller list (the second, after the swap), and a union pushes the
//   absorbed class's parents onto `pending`, which is a stack.
// - The hash-cons (`memo`) keeps stale keys, as egg's `HashMap` does, so its
//   size is egg's `total_size()`, which the node limit reads.
// - `rebuild` is `process_unions` then `rebuild_classes`: every class's
//   e-nodes canonicalized, sorted by egg's derived `Ord` (operator, data,
//   children) and deduplicated.
//
// What is not kept is the iteration order of egg's `classes` hash map:
// here classes are visited in ascending id order. See the README.

use self::util::{filled_u32, i64_at, mix, u32_at, u64_at, u8_at};

const NONE: u32 = 4294967295;

pub struct EGraph {
    // The language: the arity (0, 1 or 2) of each operator.
    arity: ChunkSeq[u8],
    // egg's `nodes`: the original e-node of each id.
    r_op: ChunkSeq[u32],
    r_data: ChunkSeq[i64],
    r_c0: ChunkSeq[u32],
    r_c1: ChunkSeq[u32],
    // Union-find parents.
    parent: ChunkSeq[u32],
    // Per class root: its parent list (length, first and last cell) and
    // whether it holds a leaf (an arity-0 e-node).
    plen: ChunkSeq[u32],
    phead: ChunkSeq[u32],
    ptail: ChunkSeq[u32],
    leaf: ChunkSeq[u8],
    // Parent list cells.
    cell_val: ChunkSeq[u32],
    cell_next: ChunkSeq[u32],
    // The hash-cons: canonical e-node keys and the id each maps to.
    m_op: ChunkSeq[u32],
    m_data: ChunkSeq[i64],
    m_c0: ChunkSeq[u32],
    m_c1: ChunkSeq[u32],
    m_id: ChunkSeq[u32],
    m_hash: ChunkSeq[u64],
    // 0 is empty, otherwise key index + 1.
    slots: ChunkSeq[u32],
    mask: u64,
    pending: ChunkSeq[u32],
    classes: u64,
    clean: bool,
    // The rebuilt view: class `c`'s sorted e-nodes are
    // n_*[cstart[c] .. cstart[c] + clen[c]]; `live` is the class roots in
    // ascending order.
    cstart: ChunkSeq[u32],
    clen: ChunkSeq[u32],
    n_op: ChunkSeq[u32],
    n_data: ChunkSeq[i64],
    n_c0: ChunkSeq[u32],
    n_c1: ChunkSeq[u32],
    live: ChunkSeq[u32]
}

// An empty e-graph over operators with the given arities.
pub fn egraph_new(in arity: ChunkSeq[u8]) -> EGraph {
    let mut arities: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](arity.len());
    for i in 0..arity.len() {
        arities.push(u8_at(in arity, i));
    }
    EGraph {
        arity: arities,
        r_op: ChunkSeq::new[u32](),
        r_data: ChunkSeq::new[i64](),
        r_c0: ChunkSeq::new[u32](),
        r_c1: ChunkSeq::new[u32](),
        parent: ChunkSeq::new[u32](),
        plen: ChunkSeq::new[u32](),
        phead: ChunkSeq::new[u32](),
        ptail: ChunkSeq::new[u32](),
        leaf: ChunkSeq::new[u8](),
        cell_val: ChunkSeq::new[u32](),
        cell_next: ChunkSeq::new[u32](),
        m_op: ChunkSeq::new[u32](),
        m_data: ChunkSeq::new[i64](),
        m_c0: ChunkSeq::new[u32](),
        m_c1: ChunkSeq::new[u32](),
        m_id: ChunkSeq::new[u32](),
        m_hash: ChunkSeq::new[u64](),
        slots: filled_u32(64, 0),
        mask: 63,
        pending: ChunkSeq::new[u32](),
        classes: 0,
        clean: true,
        cstart: ChunkSeq::new[u32](),
        clen: ChunkSeq::new[u32](),
        n_op: ChunkSeq::new[u32](),
        n_data: ChunkSeq::new[i64](),
        n_c0: ChunkSeq::new[u32](),
        n_c1: ChunkSeq::new[u32](),
        live: ChunkSeq::new[u32]()
    }
}

// The sort keys of `rebuild_classes`: class root and operator, data, and
// both children, for every id.
struct Keys {
    hi: ChunkSeq[u64],
    data: ChunkSeq[i64],
    lo: ChunkSeq[u64]
}

fn key_less(in keys: Keys, a: u32, b: u32) -> bool {
    let hi_a = u64_at(in keys.hi, widen_u64(a));
    let hi_b = u64_at(in keys.hi, widen_u64(b));
    if hi_a != hi_b {
        return hi_a < hi_b;
    }
    let data_a = i64_at(in keys.data, widen_u64(a));
    let data_b = i64_at(in keys.data, widen_u64(b));
    if data_a != data_b {
        return data_a < data_b;
    }
    u64_at(in keys.lo, widen_u64(a)) < u64_at(in keys.lo, widen_u64(b))
}

fn key_same(in keys: Keys, a: u32, b: u32) -> bool {
    u64_at(in keys.hi, widen_u64(a)) == u64_at(in keys.hi, widen_u64(b))
        && i64_at(in keys.data, widen_u64(a)) == i64_at(in keys.data, widen_u64(b))
        && u64_at(in keys.lo, widen_u64(a)) == u64_at(in keys.lo, widen_u64(b))
}

// A stable bottom-up merge sort of `idx` by `keys`.
fn sort_ids(inout idx: ChunkSeq[u32], in keys: Keys) {
    let len = idx.len();
    let mut merged: ChunkSeq[u32] = filled_u32(len, 0);
    let mut width: u64 = 1;
    loop {
        if width >= len {
            break;
        }
        let mut lo: u64 = 0;
        loop {
            if lo >= len {
                break;
            }
            let mut mid = wrapping_add(lo, width);
            if mid > len {
                mid = len;
            }
            let mut hi = wrapping_add(mid, width);
            if hi > len {
                hi = len;
            }
            let mut left = lo;
            let mut right = mid;
            let mut out = lo;
            loop {
                if out >= hi {
                    break;
                }
                let take_left = if left >= mid {
                    false
                } else if right >= hi {
                    true
                } else {
                    !key_less(in keys, u32_at(in idx, right), u32_at(in idx, left))
                };
                if take_left {
                    merged.try_set(out, u32_at(in idx, left));
                    left = wrapping_add(left, 1);
                } else {
                    merged.try_set(out, u32_at(in idx, right));
                    right = wrapping_add(right, 1);
                }
                out = wrapping_add(out, 1);
            }
            lo = hi;
        }
        for index in 0..len {
            idx.try_set(index, u32_at(in merged, index));
        }
        width = wrapping_mul(width, 2);
    }
}

impl EGraph {
    pub fn arity_of(in self, op: u32) -> u8 {
        u8_at(in self.arity, widen_u64(op))
    }

    // The number of ids (egg's `nodes().len()`).
    pub fn raw_len(in self) -> u64 {
        self.r_op.len()
    }

    // egg's `total_size()`: hash-cons entries, stale ones included.
    pub fn memo_len(in self) -> u64 {
        self.m_id.len()
    }

    // egg's `number_of_classes()`.
    pub fn class_count(in self) -> u64 {
        self.classes
    }

    pub fn is_clean(in self) -> bool {
        self.clean
    }

    pub fn raw_op(in self, id: u32) -> u32 {
        u32_at(in self.r_op, widen_u64(id))
    }

    pub fn raw_data(in self, id: u32) -> i64 {
        i64_at(in self.r_data, widen_u64(id))
    }

    pub fn raw_child(in self, id: u32, i: u64) -> u32 {
        if i == 0 {
            u32_at(in self.r_c0, widen_u64(id))
        } else {
            u32_at(in self.r_c1, widen_u64(id))
        }
    }

    pub fn find(in self, id: u32) -> u32 {
        let mut node = id;
        loop {
            let parent = u32_at(in self.parent, widen_u64(node));
            if parent == node {
                return node;
            }
            node = parent;
        }
    }

    // `find` with path halving (egg's `find_mut`).
    pub fn find_mut(inout self, id: u32) -> u32 {
        let mut node = id;
        loop {
            let parent = u32_at(in self.parent, widen_u64(node));
            if parent == node {
                return node;
            }
            let grandparent = u32_at(in self.parent, widen_u64(parent));
            self.parent.try_set(widen_u64(node), grandparent);
            node = grandparent;
        }
    }

    // Whether the class of `id` holds a leaf. Valid in a dirty graph: a
    // union keeps the flag of both classes.
    pub fn has_leaf(in self, id: u32) -> bool {
        let root = self.find(id);
        u8_at(in self.leaf, widen_u64(root)) != 0
    }

    fn slot_of(in self, hash: u64, op: u32, data: i64, c0: u32, c1: u32) -> (u64, u32) {
        let mut at = hash & self.mask;
        loop {
            let slot = u32_at(in self.slots, at);
            if slot == 0 {
                return (at, NONE);
            }
            let key = widen_u64(wrapping_sub(slot, 1));
            if u64_at(in self.m_hash, key) == hash
                && u32_at(in self.m_op, key) == op
                && i64_at(in self.m_data, key) == data
                && u32_at(in self.m_c0, key) == c0
                && u32_at(in self.m_c1, key) == c1 {
                return (at, wrapping_u32(key));
            }
            at = wrapping_add(at, 1) & self.mask;
        }
    }

    fn memo_grow(inout self) {
        let cap = wrapping_mul(wrapping_add(self.mask, 1), 2);
        let mask = wrapping_sub(cap, 1);
        let mut slots = filled_u32(cap, 0);
        for key in 0..self.m_hash.len() {
            let mut at = u64_at(in self.m_hash, key) & mask;
            loop {
                if u32_at(in slots, at) == 0 {
                    break;
                }
                at = wrapping_add(at, 1) & mask;
            }
            slots.try_set(at, wrapping_u32(wrapping_add(key, 1)));
        }
        self.slots = slots;
        self.mask = mask;
    }

    // The id the hash-cons maps a canonical e-node to, or NONE.
    pub fn memo_get(in self, op: u32, data: i64, c0: u32, c1: u32) -> u32 {
        let hash = mix(op, data, c0, c1);
        let (_at, key) = self.slot_of(hash, op, data, c0, c1);
        if key == NONE {
            NONE
        } else {
            u32_at(in self.m_id, widen_u64(key))
        }
    }

    // egg's `memo.insert`: maps the key to `id` and returns the id it
    // mapped to before, or NONE.
    fn memo_insert(inout self, op: u32, data: i64, c0: u32, c1: u32, id: u32) -> u32 {
        let hash = mix(op, data, c0, c1);
        let (at, key) = self.slot_of(hash, op, data, c0, c1);
        if key != NONE {
            let old_id = u32_at(in self.m_id, widen_u64(key));
            self.m_id.try_set(widen_u64(key), id);
            return old_id;
        }
        let key_count = self.m_id.len();
        self.m_op.push(op);
        self.m_data.push(data);
        self.m_c0.push(c0);
        self.m_c1.push(c1);
        self.m_id.push(id);
        self.m_hash.push(hash);
        self.slots.try_set(at, wrapping_u32(wrapping_add(key_count, 1)));
        if wrapping_mul(wrapping_add(key_count, 1), 2) > self.mask {
            self.memo_grow();
        }
        NONE
    }

    fn push_parent(inout self, root: u32, id: u32) {
        let cell = wrapping_u32(self.cell_val.len());
        self.cell_val.push(id);
        self.cell_next.push(NONE);
        let root_index = widen_u64(root);
        let tail = u32_at(in self.ptail, root_index);
        if tail == NONE {
            self.phead.try_set(root_index, cell);
        } else {
            self.cell_next.try_set(widen_u64(tail), cell);
        }
        self.ptail.try_set(root_index, cell);
        self.plen.try_set(root_index, wrapping_add(u32_at(in self.plen, root_index), 1));
    }

    fn make_class(inout self, op: u32, data: i64, c0: u32, c1: u32, o0: u32, o1: u32) -> u32 {
        let id = wrapping_u32(self.r_op.len());
        self.parent.push(id);
        self.r_op.push(op);
        self.r_data.push(data);
        self.r_c0.push(o0);
        self.r_c1.push(o1);
        self.plen.push(0);
        self.phead.push(NONE);
        self.ptail.push(NONE);
        let arity = self.arity_of(op);
        if arity == 0 {
            self.leaf.push(1);
        } else {
            self.leaf.push(0);
        }
        self.cstart.push(0);
        self.clen.push(0);
        if arity >= 1 {
            self.push_parent(c0, id);
        }
        if arity >= 2 {
            self.push_parent(c1, id);
        }
        self.pending.push(id);
        self.memo_insert(op, data, c0, c1, id);
        self.classes = wrapping_add(self.classes, 1);
        self.clean = false;
        id
    }

    // egg's `add_uncanonical`: the existing id of an equal e-node (which
    // may not be canonical), or a new class.
    pub fn add_uncanonical(inout self, op: u32, data: i64, o0: u32, o1: u32) -> u32 {
        let arity = self.arity_of(op);
        let c0 = if arity >= 1 { self.find(o0) } else { 0 };
        let c1 = if arity >= 2 { self.find(o1) } else { 0 };
        let existing = self.memo_get(op, data, c0, c1);
        if existing != NONE {
            return existing;
        }
        self.make_class(op, data, c0, c1, o0, o1)
    }

    // egg's `add`: the canonical class of the e-node.
    pub fn add(inout self, op: u32, data: i64, c0: u32, c1: u32) -> u32 {
        let id = self.add_uncanonical(op, data, c0, c1);
        self.find(id)
    }

    // The canonical class of an e-node already in the graph, or NONE (egg's
    // `lookup`).
    pub fn lookup(in self, op: u32, data: i64, c0: u32, c1: u32) -> u32 {
        let arity = self.arity_of(op);
        let class0 = if arity >= 1 { self.find(c0) } else { 0 };
        let class1 = if arity >= 2 { self.find(c1) } else { 0 };
        let id = self.memo_get(op, data, class0, class1);
        if id == NONE { NONE } else { self.find(id) }
    }

    // egg's `union` (`perform_union`): whether two classes were merged.
    pub fn union(inout self, a: u32, b: u32) -> bool {
        self.clean = false;
        let mut kept = self.find_mut(a);
        let mut absorbed = self.find_mut(b);
        if kept == absorbed {
            return false;
        }
        if u32_at(in self.plen, widen_u64(kept)) < u32_at(in self.plen, widen_u64(absorbed)) {
            let swap = kept;
            kept = absorbed;
            absorbed = swap;
        }
        self.parent.try_set(widen_u64(absorbed), kept);
        // pending.extend(class2.parents)
        let mut cell = u32_at(in self.phead, widen_u64(absorbed));
        loop {
            if cell == NONE {
                break;
            }
            self.pending.push(u32_at(in self.cell_val, widen_u64(cell)));
            cell = u32_at(in self.cell_next, widen_u64(cell));
        }
        // concat_vecs(class1.parents, class2.parents): class 1 is the longer.
        let absorbed_head = u32_at(in self.phead, widen_u64(absorbed));
        if absorbed_head != NONE {
            let kept_tail = u32_at(in self.ptail, widen_u64(kept));
            if kept_tail == NONE {
                self.phead.try_set(widen_u64(kept), absorbed_head);
            } else {
                self.cell_next.try_set(widen_u64(kept_tail), absorbed_head);
            }
            self.ptail.try_set(widen_u64(kept), u32_at(in self.ptail, widen_u64(absorbed)));
        }
        self.plen.try_set(
            widen_u64(kept),
            wrapping_add(
                u32_at(in self.plen, widen_u64(kept)),
                u32_at(in self.plen, widen_u64(absorbed))
            )
        );
        if u8_at(in self.leaf, widen_u64(absorbed)) != 0 {
            self.leaf.try_set(widen_u64(kept), 1);
        }
        self.classes = wrapping_sub(self.classes, 1);
        true
    }

    fn process_unions(inout self) -> u64 {
        let mut unions: u64 = 0;
        loop {
            let id = match self.pending.pop() {
                Option::Some(pending_id) => pending_id,
                Option::None => break,
            };
            let op = self.raw_op(id);
            let arity = self.arity_of(op);
            let c0 = if arity >= 1 {
                let raw = self.raw_child(id, 0);
                self.find_mut(raw)
            } else {
                0
            };
            let c1 = if arity >= 2 {
                let raw = self.raw_child(id, 1);
                self.find_mut(raw)
            } else {
                0
            };
            let data = self.raw_data(id);
            let old_id = self.memo_insert(op, data, c0, c1, id);
            if old_id != NONE {
                if self.union(old_id, id) {
                    unions = wrapping_add(unions, 1);
                }
            }
        }
        unions
    }

    fn rebuild_classes(inout self) {
        let id_count = self.raw_len();
        let mut keys = Keys {
            hi: ChunkSeq::with_capacity[u64](id_count),
            data: ChunkSeq::with_capacity[i64](id_count),
            lo: ChunkSeq::with_capacity[u64](id_count)
        };
        let mut order: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](id_count);
        for index in 0..id_count {
            let id = wrapping_u32(index);
            let class_root = self.find_mut(id);
            let op = self.raw_op(id);
            let arity = self.arity_of(op);
            let c0 = if arity >= 1 {
                let raw = self.raw_child(id, 0);
                self.find_mut(raw)
            } else {
                0
            };
            let c1 = if arity >= 2 {
                let raw = self.raw_child(id, 1);
                self.find_mut(raw)
            } else {
                0
            };
            keys.hi.push(wrapping_shl_u64(widen_u64(class_root), 32) | widen_u64(op));
            let data = self.raw_data(id);
            keys.data.push(data);
            keys.lo.push(wrapping_shl_u64(widen_u64(c0), 32) | widen_u64(c1));
            order.push(id);
        }
        sort_ids(inout order, in keys);
        self.n_op.clear();
        self.n_data.clear();
        self.n_c0.clear();
        self.n_c1.clear();
        self.live.clear();
        let mut prev: u32 = NONE;
        let mut prev_root: u32 = NONE;
        for i in 0..id_count {
            let id = u32_at(in order, i);
            if prev != NONE && key_same(in keys, prev, id) {
                continue;
            }
            prev = id;
            let hi = u64_at(in keys.hi, widen_u64(id));
            let root = wrapping_u32(hi >> 32);
            if root != prev_root {
                prev_root = root;
                self.live.push(root);
                self.cstart.try_set(widen_u64(root), wrapping_u32(self.n_op.len()));
                self.clen.try_set(widen_u64(root), 0);
            }
            let lo = u64_at(in keys.lo, widen_u64(id));
            self.n_op.push(wrapping_u32(hi & 4294967295));
            self.n_data.push(i64_at(in keys.data, widen_u64(id)));
            self.n_c0.push(wrapping_u32(lo >> 32));
            self.n_c1.push(wrapping_u32(lo & 4294967295));
            self.clen
                .try_set(widen_u64(root), wrapping_add(u32_at(in self.clen, widen_u64(root)), 1));
        }
    }

    // egg's `rebuild`: restores congruence and the sorted class view.
    // Returns the number of unions congruence made.
    pub fn rebuild(inout self) -> u64 {
        let unions = self.process_unions();
        self.rebuild_classes();
        self.clean = true;
        unions
    }

    // The rebuilt view (valid when clean).
    pub fn live_count(in self) -> u64 {
        self.live.len()
    }

    pub fn live_at(in self, i: u64) -> u32 {
        u32_at(in self.live, i)
    }

    pub fn class_start(in self, root: u32) -> u64 {
        widen_u64(u32_at(in self.cstart, widen_u64(root)))
    }

    pub fn class_len(in self, root: u32) -> u64 {
        widen_u64(u32_at(in self.clen, widen_u64(root)))
    }

    pub fn node_op(in self, k: u64) -> u32 {
        u32_at(in self.n_op, k)
    }

    pub fn node_data(in self, k: u64) -> i64 {
        i64_at(in self.n_data, k)
    }

    pub fn node_child(in self, k: u64, i: u64) -> u32 {
        if i == 0 {
            u32_at(in self.n_c0, k)
        } else {
            u32_at(in self.n_c1, k)
        }
    }
}
