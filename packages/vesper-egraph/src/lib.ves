// @vesper/egraph: an e-graph in Vesper for the compiler's two equality
// saturation passes (self-hosting wave SH3, lane 8, #1247; gap S7 of the
// self-hosting plan). `src/optimize.rs` runs egg 0.10 on pure integer
// expressions and `src/ir_opt.rs` runs egglog 3 on memory observations;
// both rule sets are small, so this package is the part of egg and egglog
// they use, not a general egglog. Rust stays the default; nothing here
// replaces Rust code yet (SH3 lanes 9 and 10 swap the passes onto it).
//
// - graph.ves: hash-consed e-nodes, union-find, rebuild (egg's `EGraph`).
// - rules.ves: patterns, the e-matching compiler, guards, the relation.
// - run.ves: search and apply, egg's `Runner` and egglog's `(run n)`.
// - extract.ves: `AstSize` extraction (egg's `Extractor`).
//
// The entries below are the differential's tasks
// (tests/self_host_egraph.rs).

use self::util::{fold, u32_at};
use self::graph::{EGraph, egraph_new};
use self::rules::{Rules, rules_new};
use self::run::{Config, Records, records_new, run_egg, run_rounds};
use self::extract::{Extracted, extractor};

const NONE: u32 = 4294967295;
const G_NONE: u8 = 0;
const G_TOTAL: u8 = 1;
const G_REL: u8 = 2;

// ------------------------------------------------------------------ input

struct Reader {
    pos: u64
}

impl Reader {
    fn word(inout self, in bytes: Slice[u8]) -> u64 {
        let value = match bytes.try_read_u64_le(self.pos) {
            Option::Some(value) => value,
            Option::None => 0,
        };
        self.pos = wrapping_add(self.pos, 8);
        value
    }
}

// ------------------------------------------------------------------ optimize

// `src/optimize.rs`'s language, in egg's variant order (which is the
// derived `Ord` the class e-nodes sort by).
pub const M_NUM: u32 = 0;
pub const M_ADD: u32 = 1;
pub const M_SUB: u32 = 2;
pub const M_MUL: u32 = 3;
pub const M_WADD: u32 = 4;
pub const M_WSUB: u32 = 5;
pub const M_WMUL: u32 = 6;
pub const M_INPUT: u32 = 7;

pub fn math_arity() -> ChunkSeq[u8] {
    let mut arities: ChunkSeq[u8] = ChunkSeq::new[u8]();
    arities.push(0);
    arities.push(2);
    arities.push(2);
    arities.push(2);
    arities.push(2);
    arities.push(2);
    arities.push(2);
    arities.push(0);
    arities
}

// (op ?x c)
fn op_var_const(inout rules: Rules, op: u32, constant: i64) -> (u32, u32) {
    rules.begin();
    let var = rules.var(0);
    let num = rules.node(M_NUM, constant, 0, 0);
    rules.node(op, 0, var, num);
    rules.end()
}

// (op c ?x)
fn op_const_var(inout rules: Rules, op: u32, constant: i64) -> (u32, u32) {
    rules.begin();
    let num = rules.node(M_NUM, constant, 0, 0);
    let var = rules.var(0);
    rules.node(op, 0, num, var);
    rules.end()
}

fn just_var(inout rules: Rules, var: u32) -> (u32, u32) {
    rules.begin();
    rules.var(var);
    rules.end()
}

fn just_const(inout rules: Rules, constant: i64) -> (u32, u32) {
    rules.begin();
    rules.node(M_NUM, constant, 0, 0);
    rules.end()
}

// (op ?a ?b)
fn op_vars(inout rules: Rules, op: u32, left_var: u32, right_var: u32) -> (u32, u32) {
    rules.begin();
    let left = rules.var(left_var);
    let right = rules.var(right_var);
    rules.node(op, 0, left, right);
    rules.end()
}

// (op (op ?x ?y) ?z) and (op ?x (op ?y ?z))
fn assoc_left(inout rules: Rules, op: u32) -> (u32, u32) {
    rules.begin();
    let var_x = rules.var(0);
    let var_y = rules.var(1);
    let inner = rules.node(op, 0, var_x, var_y);
    let var_z = rules.var(2);
    rules.node(op, 0, inner, var_z);
    rules.end()
}

fn assoc_right(inout rules: Rules, op: u32) -> (u32, u32) {
    rules.begin();
    let var_x = rules.var(0);
    let var_y = rules.var(1);
    let var_z = rules.var(2);
    let inner = rules.node(op, 0, var_y, var_z);
    rules.node(op, 0, var_x, inner);
    rules.end()
}

// The 18 rules of `optimize::rules()`, in its order.
pub fn math_rules() -> Rules {
    let arity = math_arity();
    let mut rules = rules_new(in arity);
    // add-zero, zero-add, sub-zero, mul-one, one-mul
    let lhs = op_var_const(inout rules, M_ADD, 0);
    let rhs = just_var(inout rules, 0);
    rules.rule(lhs, rhs, G_NONE, 0, 0);
    let lhs = op_const_var(inout rules, M_ADD, 0);
    let rhs = just_var(inout rules, 0);
    rules.rule(lhs, rhs, G_NONE, 0, 0);
    let lhs = op_var_const(inout rules, M_SUB, 0);
    let rhs = just_var(inout rules, 0);
    rules.rule(lhs, rhs, G_NONE, 0, 0);
    let lhs = op_var_const(inout rules, M_MUL, 1);
    let rhs = just_var(inout rules, 0);
    rules.rule(lhs, rhs, G_NONE, 0, 0);
    let lhs = op_const_var(inout rules, M_MUL, 1);
    let rhs = just_var(inout rules, 0);
    rules.rule(lhs, rhs, G_NONE, 0, 0);
    // mul-zero, zero-mul, self-sub: only total subterms
    let lhs = op_var_const(inout rules, M_MUL, 0);
    let zero = just_const(inout rules, 0);
    rules.rule(lhs, zero, G_TOTAL, 0, 0);
    let lhs = op_const_var(inout rules, M_MUL, 0);
    let zero = just_const(inout rules, 0);
    rules.rule(lhs, zero, G_TOTAL, 0, 0);
    let lhs = op_vars(inout rules, M_SUB, 0, 0);
    let zero = just_const(inout rules, 0);
    rules.rule(lhs, zero, G_TOTAL, 0, 0);
    // wadd-zero, wsub-zero, wmul-one
    let lhs = op_var_const(inout rules, M_WADD, 0);
    let rhs = just_var(inout rules, 0);
    rules.rule(lhs, rhs, G_NONE, 0, 0);
    let lhs = op_var_const(inout rules, M_WSUB, 0);
    let rhs = just_var(inout rules, 0);
    rules.rule(lhs, rhs, G_NONE, 0, 0);
    let lhs = op_var_const(inout rules, M_WMUL, 1);
    let rhs = just_var(inout rules, 0);
    rules.rule(lhs, rhs, G_NONE, 0, 0);
    // wadd-comm, wmul-comm
    let lhs = op_vars(inout rules, M_WADD, 0, 1);
    let rhs = op_vars(inout rules, M_WADD, 1, 0);
    rules.rule(lhs, rhs, G_NONE, 0, 0);
    let lhs = op_vars(inout rules, M_WMUL, 0, 1);
    let rhs = op_vars(inout rules, M_WMUL, 1, 0);
    rules.rule(lhs, rhs, G_NONE, 0, 0);
    // wadd-assoc, wmul-assoc
    let lhs = assoc_left(inout rules, M_WADD);
    let rhs = assoc_right(inout rules, M_WADD);
    rules.rule(lhs, rhs, G_NONE, 0, 0);
    let lhs = assoc_left(inout rules, M_WMUL);
    let rhs = assoc_right(inout rules, M_WMUL);
    rules.rule(lhs, rhs, G_NONE, 0, 0);
    // wadd-cancel: (wrapping_sub (wrapping_add ?x ?y) ?y) => ?x if total(?y)
    rules.begin();
    let var_x = rules.var(0);
    let var_y = rules.var(1);
    let sum = rules.node(M_WADD, 0, var_x, var_y);
    let var_y_again = rules.var(1);
    rules.node(M_WSUB, 0, sum, var_y_again);
    let lhs = rules.end();
    let rhs = just_var(inout rules, 0);
    rules.rule(lhs, rhs, G_TOTAL, 1, 0);
    // wmul-zero, wself-sub
    let lhs = op_var_const(inout rules, M_WMUL, 0);
    let zero = just_const(inout rules, 0);
    rules.rule(lhs, zero, G_TOTAL, 0, 0);
    let lhs = op_vars(inout rules, M_WSUB, 0, 0);
    let zero = just_const(inout rules, 0);
    rules.rule(lhs, zero, G_TOTAL, 0, 0);
    rules
}

fn push_u32s(inout out: ChunkSeq[u64], in records: Records) {
    for i in 0..records.word_count() {
        out.push(widen_u64(records.word(i)));
    }
}

// Task "math": `optimize`'s search (certificate.rs `run_graph` without the
// witness budget) on each expression.
// Input: case count, rule-checking constants (iteration limit, node limit,
// match limit, id cap, reserve, record cap), then per case: kind range
// (lo, hi as i64), variable count, node count, and the nodes (op, data,
// child, child), children first, root last.
// Output per case: stop, iterations, ids, hash-cons size, classes, a digest
// of every id's original e-node, record words then the records, the root's
// cost, and the best expression's nodes (op, data, child, child).
pub fn egraph_math(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mut reader = Reader { pos: 0 };
    let rules = math_rules();
    let arity = math_arity();
    let cases = reader.word(in bytes);
    let iter_limit = reader.word(in bytes);
    let node_limit = reader.word(in bytes);
    let match_limit = reader.word(in bytes);
    let raw_cap = reader.word(in bytes);
    let reserve = reader.word(in bytes);
    let record_cap = reader.word(in bytes);
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for case in 0..cases {
        let lo = wrapping_i64(reader.word(in bytes));
        let hi = wrapping_i64(reader.word(in bytes));
        let vars = wrapping_i64(reader.word(in bytes));
        let node_count = reader.word(in bytes);
        let mut graph = egraph_new(in arity);
        let mut ids: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](node_count);
        let mut root: u32 = 0;
        for node in 0..node_count {
            let op = wrapping_u32(reader.word(in bytes));
            let data = wrapping_i64(reader.word(in bytes));
            let child0_index = reader.word(in bytes);
            let child1_index = reader.word(in bytes);
            let child0 = u32_at(in ids, child0_index);
            let child1 = u32_at(in ids, child1_index);
            let node_arity = graph.arity_of(op);
            let arg0 = if node_arity >= 1 { child0 } else { 0 };
            let arg1 = if node_arity >= 2 { child1 } else { 0 };
            // egg's add_expr: add_uncanonical per node, root found last.
            let id = graph.add_uncanonical(op, data, arg0, arg1);
            ids.push(id);
            root = id;
        }
        root = graph.find(root);
        let config = Config {
            iter_limit: iter_limit,
            node_limit: node_limit,
            match_limit: match_limit,
            raw_cap: raw_cap,
            reserve: reserve,
            record_cap: record_cap,
            hook: true,
            const_op: M_NUM,
            input_op: M_INPUT,
            lo: lo,
            hi: hi,
            vars: vars
        };
        let mut records = records_new();
        let (stop, iters) = run_egg(inout graph, in rules, config, root, inout records);
        out.push(widen_u64(stop));
        out.push(iters);
        out.push(graph.raw_len());
        out.push(graph.memo_len());
        out.push(graph.class_count());
        let mut digest: u64 = 14695981039346656037;
        for k in 0..graph.raw_len() {
            let id = wrapping_u32(k);
            digest = fold(digest, widen_u64(graph.raw_op(id)));
            digest = fold(digest, wrapping_u64(graph.raw_data(id)));
            digest = fold(digest, widen_u64(graph.raw_child(id, 0)));
            digest = fold(digest, widen_u64(graph.raw_child(id, 1)));
        }
        out.push(digest);
        out.push(records.word_count());
        push_u32s(inout out, in records);
        if stop == 5 {
            out.push(0);
            out.push(0);
        } else {
            let mut extracted = extractor(in graph);
            out.push(extracted.cost_of(in graph, root));
            if extracted.find_best(in graph, root) {
                out.push(extracted.len());
                for node in 0..extracted.len() {
                    out.push(widen_u64(extracted.op_at(node)));
                    out.push(wrapping_u64(extracted.data_at(node)));
                    out.push(widen_u64(extracted.child_at(node, 0)));
                    out.push(widen_u64(extracted.child_at(node, 1)));
                }
            } else {
                out.push(0);
            }
        }
    }
    out
}

// ------------------------------------------------------------------ ir_opt

// `src/ir_opt.rs`'s memory-observation terms. egglog's `(Write S i64 V)`,
// `(Barrier S i64)` and `(Read S i64)` keep their i64 as e-node data.
pub const V_REF: u32 = 0;
pub const V_START: u32 = 1;
pub const V_WRITE: u32 = 2;
pub const V_BARRIER: u32 = 3;
pub const V_READ: u32 = 4;

pub fn memory_arity() -> ChunkSeq[u8] {
    let mut arities: ChunkSeq[u8] = ChunkSeq::new[u8]();
    arities.push(0);
    arities.push(0);
    arities.push(2);
    arities.push(1);
    arities.push(1);
    arities
}

// ir_opt's `RULES`:
//   (rewrite (Read (Write s p v) p) v)
//   (rule ((= r (Read (Write s p v) q)) (disjoint p q)) ((union r (Read s q))))
pub fn memory_rules() -> Rules {
    let arity = memory_arity();
    let mut rules = rules_new(in arity);
    // Read binds p (data 0); the Write's data must equal it.
    rules.begin();
    let state = rules.var(0);
    let value = rules.var(1);
    let write = rules.dnode(V_WRITE, 0, state, value);
    rules.dnode(V_READ, 0, write, 0);
    let lhs = rules.end();
    let rhs = just_var(inout rules, 1);
    rules.rule(lhs, rhs, G_NONE, 0, 0);
    // Read binds q (data 0), Write binds p (data 1); disjoint(p, q).
    rules.begin();
    let state = rules.var(0);
    let value = rules.var(1);
    let write = rules.dnode(V_WRITE, 1, state, value);
    rules.dnode(V_READ, 0, write, 0);
    let lhs = rules.end();
    rules.begin();
    let state_again = rules.var(0);
    rules.dnode(V_READ, 0, state_again, 0);
    let rhs = rules.end();
    rules.rule(lhs, rhs, G_REL, 1, 0);
    rules
}

// State terms by token, grown on demand.
fn set_token(inout states: ChunkSeq[u32], token: u64, id: u32) -> bool {
    if token >= 16777216 {
        return false;
    }
    if states.len() <= token {
        states.resize(wrapping_add(token, 1), NONE);
    }
    if u32_at(in states, token) != NONE {
        return false;
    }
    states.try_set(token, id);
    true
}

// Task "memory": ir_opt's per-block equality saturation.
// Input: rounds, block count, then per block: pair count and the
// disjoint pairs, step count and steps (1 read: dest, input token, place;
// 2 write: output, input, place, value; 3 barrier: output, input, dest),
// the entry token, query count and queries (dest, candidate count,
// candidates).
// Output per block: 1 if the program is ill-formed (egglog would refuse
// it: an undefined or redefined state), else 0 and per query the first
// candidate in the read's class, or u32::MAX.
pub fn egraph_memory(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mut reader = Reader { pos: 0 };
    let arity = memory_arity();
    let rounds = reader.word(in bytes);
    let blocks = reader.word(in bytes);
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for block in 0..blocks {
        let mut rules = memory_rules();
        let mut graph = egraph_new(in arity);
        let mut tokens: ChunkSeq[u32] = ChunkSeq::new[u32]();
        let mut ill_formed = false;
        let pairs = reader.word(in bytes);
        for i in 0..pairs {
            let first_place = wrapping_i64(reader.word(in bytes));
            let second_place = wrapping_i64(reader.word(in bytes));
            rules.rel_add(first_place, second_place);
        }
        let entry = reader.word(in bytes);
        let start = graph.add(V_START, wrapping_i64(entry), 0, 0);
        if !set_token(inout tokens, entry, start) {
            ill_formed = true;
        }
        let steps = reader.word(in bytes);
        for i in 0..steps {
            let kind = reader.word(in bytes);
            if kind == 1 {
                let dest = wrapping_i64(reader.word(in bytes));
                let token = reader.word(in bytes);
                let place = wrapping_i64(reader.word(in bytes));
                let state = if token < tokens.len() {
                    u32_at(in tokens, token)
                } else {
                    NONE
                };
                if state == NONE {
                    ill_formed = true;
                } else {
                    let value = graph.add(V_REF, dest, 0, 0);
                    let read = graph.add(V_READ, place, state, 0);
                    graph.union(value, read);
                }
            } else {
                let output = reader.word(in bytes);
                let token = reader.word(in bytes);
                let place = wrapping_i64(reader.word(in bytes));
                let state = if token < tokens.len() {
                    u32_at(in tokens, token)
                } else {
                    NONE
                };
                if kind == 2 {
                    let value = wrapping_i64(reader.word(in bytes));
                    if state == NONE {
                        ill_formed = true;
                    } else {
                        let value_ref = graph.add(V_REF, value, 0, 0);
                        let written = graph.add(V_WRITE, place, state, value_ref);
                        if !set_token(inout tokens, output, written) {
                            ill_formed = true;
                        }
                    }
                } else if state == NONE {
                    ill_formed = true;
                } else {
                    let written = graph.add(V_BARRIER, place, state, 0);
                    if !set_token(inout tokens, output, written) {
                        ill_formed = true;
                    }
                }
            }
        }
        let queries = reader.word(in bytes);
        if !ill_formed {
            run_rounds(inout graph, in rules, rounds);
        }
        if ill_formed {
            out.push(1);
        } else {
            out.push(0);
        }
        for query in 0..queries {
            let dest = wrapping_i64(reader.word(in bytes));
            let candidates = reader.word(in bytes);
            let root = graph.lookup(V_REF, dest, 0, 0);
            let mut found: u32 = NONE;
            for candidate_index in 0..candidates {
                let candidate = reader.word(in bytes);
                if found == NONE && !ill_formed && root != NONE {
                    let written = graph.lookup(V_REF, wrapping_i64(candidate), 0, 0);
                    if written != NONE && written == root {
                        found = wrapping_u32(candidate);
                    }
                }
            }
            if !ill_formed {
                out.push(widen_u64(found));
            }
        }
    }
    out
}
