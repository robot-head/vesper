// Search, application and the two saturation drivers.
//
// `run_egg` is egg 0.10's `Runner::run` as `src/optimize/certificate.rs`
// configures it: every rule searched on the rebuilt graph (a cap on matches
// per rule, as its `BoundedScheduler` has), then every rule's matches
// applied in rule order (each one instantiates the right side and unions it
// with the matched class, egg's default `apply_matches`), then a rebuild.
// The hook stops the run when the root class holds a leaf of the wanted
// kind (certificate.rs's `root_has_leaf`), the limits are egg's iteration
// and node limits, and the cap checks are the `RecordingApplier`'s. Every
// successful union is recorded with the bindings of the rule's class
// variables, which is what certificate.rs replays into proofs.
//
// `run_rounds` is egglog's `(run n)` over rules without limits: each round
// searches every rule on the rebuilt graph, applies the matches, and
// rebuilds; it stops early when a round changes nothing.

use self::util::{filled_u32, i64_at, u32_at, u64_at};
use self::graph::{EGraph};
use self::rules::{Rules};

const NONE: u32 = 4294967295;

const P_VAR: u8 = 0;
const D_VAR: u8 = 1;
const I_BIND: u32 = 1;
const B_CONST: u32 = 0;
const B_BIND: u32 = 1;
const G_TOTAL: u8 = 1;
const G_REL: u8 = 2;

// Why a run stopped.
pub const STOP_SATURATED: u8 = 1;
pub const STOP_ITERATIONS: u8 = 2;
pub const STOP_NODES: u8 = 3;
// The hook found a leaf in the root class.
pub const STOP_HOOK: u8 = 4;
// A cap was hit: matches of one rule, ids or records.
pub const STOP_FAILED: u8 = 5;

// The limits and the hook of `run_egg`.
pub copy struct Config {
    iter_limit: u64,
    node_limit: u64,
    // A rule's search fails once it reaches this many matches.
    match_limit: u64,
    // An application fails when the ids plus `reserve` pass `raw_cap`, or
    // when `record_cap` records exist.
    raw_cap: u64,
    reserve: u64,
    record_cap: u64,
    // The hook: stop when the root class holds a constant `const_op` with
    // data in lo..=hi, or a variable `input_op` with data below `vars`.
    hook: bool,
    const_op: u32,
    input_op: u32,
    lo: i64,
    hi: i64,
    vars: i64
}

// The matches of one search pass: for each rule a range of matches; for
// each match its class, its class variables and its data variables.
pub struct Matches {
    rule_start: ChunkSeq[u64],
    eclass: ChunkSeq[u32],
    vals: ChunkSeq[u32],
    val_start: ChunkSeq[u64],
    dvals: ChunkSeq[i64],
    dval_start: ChunkSeq[u64]
}

pub fn matches_new() -> Matches {
    Matches {
        rule_start: ChunkSeq::new[u64](),
        eclass: ChunkSeq::new[u32](),
        vals: ChunkSeq::new[u32](),
        val_start: ChunkSeq::new[u64](),
        dvals: ChunkSeq::new[i64](),
        dval_start: ChunkSeq::new[u64]()
    }
}

// For a driver outside this module (`@vesper/optimize`'s budgeted search).
impl Matches {
    // Starts the next rule's range.
    pub fn mark(inout self) {
        self.rule_start.push(self.eclass.len());
    }

    // The matches of rule `rule`, after `mark` was called for it and the next.
    pub fn range(in self, rule: u64) -> (u64, u64) {
        (u64_at(in self.rule_start, rule), u64_at(in self.rule_start, wrapping_add(rule, 1)))
    }

    // Class variable `var` of match `match_index`.
    pub fn val(in self, match_index: u64, var: u64) -> u32 {
        u32_at(in self.vals, wrapping_add(u64_at(in self.val_start, match_index), var))
    }
}

// The applications that unioned something: rule, number of bindings, then
// the bindings (the class of each class variable, as matched).
pub struct Records {
    words: ChunkSeq[u32],
    count: u64
}

pub fn records_new() -> Records {
    Records { words: ChunkSeq::new[u32](), count: 0 }
}

impl Records {
    pub fn len(in self) -> u64 {
        self.count
    }

    pub fn word_count(in self) -> u64 {
        self.words.len()
    }

    pub fn word(in self, i: u64) -> u32 {
        u32_at(in self.words, i)
    }
}

// The search state of one program run: registers and data registers.
struct Machine {
    regs: ChunkSeq[u32],
    dregs: ChunkSeq[i64],
    left: u64
}

// egg's `Machine::run` from instruction `pc` of rule `rule`'s program. Returns
// false once the match limit is reached.
fn run_from(
    in graph: EGraph,
    in rules: Rules,
    rule: u64,
    pc: u64,
    end: u64,
    inout machine: Machine,
    inout out: Matches
) -> bool {
    if pc >= end {
        // yield: one substitution
        out.eclass.push(u32_at(in machine.regs, 0));
        out.val_start.push(out.vals.len());
        out.dval_start.push(out.dvals.len());
        for var in 0..rules.nvars_of(rule) {
            out.vals.push(u32_at(in machine.regs, rules.var_reg(rule, var)));
        }
        for data_var in 0..rules.ndvars_of(rule) {
            out.dvals.push(i64_at(in machine.dregs, data_var));
        }
        machine.left = wrapping_sub(machine.left, 1);
        return machine.left != 0;
    }
    let kind = rules.instr(pc, 0);
    let in_reg = widen_u64(rules.instr(pc, 1));
    let out_reg = widen_u64(rules.instr(pc, 2));
    if kind == I_BIND {
        let op = rules.instr(pc, 3);
        let dmode = rules.instr(pc, 4);
        let data_index = widen_u64(rules.instr(pc, 5));
        let data = rules.instr_data(pc);
        let class = graph.find(u32_at(in machine.regs, in_reg));
        let start = graph.class_start(class);
        let class_len = graph.class_len(class);
        let arity = widen_u64(graph.arity_of(op));
        for node in start..wrapping_add(start, class_len) {
            if graph.node_op(node) != op {
                continue;
            }
            let node_data = graph.node_data(node);
            if dmode == B_CONST {
                if node_data != data {
                    continue;
                }
            } else if dmode == B_BIND {
                machine.dregs.try_set(data_index, node_data);
            } else if i64_at(in machine.dregs, data_index) != node_data {
                continue;
            }
            for child in 0..arity {
                machine.regs.try_set(wrapping_add(out_reg, child), graph.node_child(node, child));
            }
            if !run_from(
                in graph,
                in rules,
                rule,
                wrapping_add(pc, 1),
                end,
                inout machine,
                inout out
            ) {
                return false;
            }
        }
        return true;
    }
    // Compare
    if graph.find(u32_at(in machine.regs, in_reg)) != graph.find(u32_at(in machine.regs, out_reg)) {
        return true;
    }
    run_from(in graph, in rules, rule, wrapping_add(pc, 1), end, inout machine, inout out)
}

// Searches rule `rule` over every class in ascending id order, appending at
// most `limit` matches. Returns the number found.
pub fn search_rule(
    in graph: EGraph,
    in rules: Rules,
    rule: u64,
    limit: u64,
    inout out: Matches
) -> u64 {
    let (start, prog_len) = rules.prog(rule);
    let end = wrapping_add(start, prog_len);
    let mut machine = Machine {
        regs: filled_u32(rules.nregs_of(rule), 0),
        dregs: ChunkSeq::with_capacity[i64](rules.ndvars_of(rule)),
        left: limit
    };
    machine.dregs.resize(rules.ndvars_of(rule), 0);
    let before = out.eclass.len();
    if limit == 0 {
        return 0;
    }
    for live_index in 0..graph.live_count() {
        machine.regs.try_set(0, graph.live_at(live_index));
        if !run_from(in graph, in rules, rule, start, end, inout machine, inout out) {
            break;
        }
    }
    wrapping_sub(out.eclass.len(), before)
}

// Searches every rule; false when one reached `limit` matches.
fn search_all(in graph: EGraph, in rules: Rules, limit: u64, inout out: Matches) -> bool {
    let mut ok = true;
    for rule in 0..rules.count() {
        out.rule_start.push(out.eclass.len());
        let found = search_rule(in graph, in rules, rule, limit, inout out);
        if found >= limit {
            ok = false;
        }
    }
    out.rule_start.push(out.eclass.len());
    ok
}

// Instantiates the right side of rule `rule` for match `match_index` (egg's
// `apply_pat`) and unions it with the matched class. Returns whether the
// union merged two classes.
pub fn apply_one(
    inout graph: EGraph,
    in rules: Rules,
    rule: u64,
    in matches: Matches,
    match_index: u64,
    inout ids: ChunkSeq[u32]
) -> bool {
    let vals_start = u64_at(in matches.val_start, match_index);
    let dvals_start = u64_at(in matches.dval_start, match_index);
    let (start, rhs_len) = rules.rhs(rule);
    ids.clear();
    let mut last: u32 = 0;
    for node in start..wrapping_add(start, rhs_len) {
        let (kind, operand, dmode, dval, c0, c1) = rules.pnode(node);
        let id = if kind == P_VAR {
            u32_at(in matches.vals, wrapping_add(vals_start, widen_u64(operand)))
        } else {
            let data = if dmode == D_VAR {
                i64_at(in matches.dvals, wrapping_add(dvals_start, wrapping_u64(dval)))
            } else {
                dval
            };
            let arity = graph.arity_of(operand);
            let child0 = if arity >= 1 {
                u32_at(in ids, wrapping_sub(widen_u64(c0), start))
            } else {
                0
            };
            let child1 = if arity >= 2 {
                u32_at(in ids, wrapping_sub(widen_u64(c1), start))
            } else {
                0
            };
            graph.add(operand, data, child0, child1)
        };
        ids.push(id);
        last = id;
    }
    let class = u32_at(in matches.eclass, match_index);
    graph.union(class, last)
}

pub fn guard_holds(
    in graph: EGraph,
    in rules: Rules,
    rule: u64,
    in matches: Matches,
    match_index: u64
) -> bool {
    let (kind, g0, g1) = rules.guard_of(rule);
    if kind == G_TOTAL {
        let class = u32_at(
            in matches.vals,
            wrapping_add(u64_at(in matches.val_start, match_index), widen_u64(g0))
        );
        return graph.has_leaf(class);
    }
    if kind == G_REL {
        let dvals_start = u64_at(in matches.dval_start, match_index);
        let first = i64_at(in matches.dvals, wrapping_add(dvals_start, widen_u64(g0)));
        let second = i64_at(in matches.dvals, wrapping_add(dvals_start, widen_u64(g1)));
        return rules.rel_has(first, second);
    }
    true
}

fn root_has_leaf(in graph: EGraph, root: u32, config: Config) -> bool {
    let root_class = graph.find(root);
    let start = graph.class_start(root_class);
    for k in start..wrapping_add(start, graph.class_len(root_class)) {
        let op = graph.node_op(k);
        let data = graph.node_data(k);
        if op == config.const_op && data >= config.lo && data <= config.hi {
            return true;
        }
        if op == config.input_op && data >= 0 && data < config.vars {
            return true;
        }
    }
    false
}

// One iteration of egg's `Runner::run_one`; 0 to go on, else a STOP_*.
fn run_one(
    inout graph: EGraph,
    in rules: Rules,
    config: Config,
    root: u32,
    done: u64,
    inout records: Records
) -> u8 {
    if graph.memo_len() > config.node_limit {
        return STOP_NODES;
    }
    if done >= config.iter_limit {
        return STOP_ITERATIONS;
    }
    let nodes_before = graph.memo_len();
    let classes_before = graph.class_count();
    if config.hook && root_has_leaf(in graph, root, config) {
        return STOP_HOOK;
    }
    let mut matches = matches_new();
    if !search_all(in graph, in rules, config.match_limit, inout matches) {
        return STOP_FAILED;
    }
    let mut applied: u64 = 0;
    let mut stop: u8 = 0;
    let mut ids: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for rule in 0..rules.count() {
        let first_match = u64_at(in matches.rule_start, rule);
        let end_match = u64_at(in matches.rule_start, wrapping_add(rule, 1));
        for match_index in first_match..end_match {
            // The RecordingApplier's caps come before the rule's condition.
            if wrapping_add(graph.raw_len(), config.reserve) > config.raw_cap
                || records.count >= config.record_cap {
                return STOP_FAILED;
            }
            if !guard_holds(in graph, in rules, rule, in matches, match_index) {
                continue;
            }
            if apply_one(inout graph, in rules, rule, in matches, match_index, inout ids) {
                applied = wrapping_add(applied, 1);
                records.words.push(wrapping_u32(rule));
                let var_count = rules.nvars_of(rule);
                records.words.push(wrapping_u32(var_count));
                let vals_start = u64_at(in matches.val_start, match_index);
                for var in 0..var_count {
                    records.words.push(u32_at(in matches.vals, wrapping_add(vals_start, var)));
                }
                records.count = wrapping_add(records.count, 1);
            }
        }
        if graph.memo_len() > config.node_limit {
            stop = STOP_NODES;
            break;
        }
    }
    graph.rebuild();
    if stop != 0 {
        return stop;
    }
    if applied == 0 && graph.memo_len() == nodes_before && graph.class_count() == classes_before {
        return STOP_SATURATED;
    }
    0
}

// egg's `Runner::run` from a graph holding the root's expression. Returns
// why it stopped and how many iterations ran (egg's `iterations.len()`).
pub fn run_egg(
    inout graph: EGraph,
    in rules: Rules,
    config: Config,
    root: u32,
    inout records: Records
) -> (u8, u64) {
    graph.rebuild();
    let mut iters: u64 = 0;
    loop {
        let stop = run_one(inout graph, in rules, config, root, iters, inout records);
        iters = wrapping_add(iters, 1);
        if stop != 0 {
            return (stop, iters);
        }
        if graph.memo_len() > config.node_limit {
            return (STOP_NODES, iters);
        }
        if iters >= config.iter_limit {
            return (STOP_ITERATIONS, iters);
        }
    }
}

// egglog's `(run n)`: at most `rounds` rounds of search, apply and
// rebuild. Returns the number of rounds that changed the graph.
pub fn run_rounds(inout graph: EGraph, in rules: Rules, rounds: u64) -> u64 {
    graph.rebuild();
    let mut ids: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut changed: u64 = 0;
    for round in 0..rounds {
        let nodes_before = graph.raw_len();
        let mut matches = matches_new();
        search_all(in graph, in rules, 18446744073709551615, inout matches);
        let mut unions: u64 = 0;
        for rule in 0..rules.count() {
            let first_match = u64_at(in matches.rule_start, rule);
            let end_match = u64_at(in matches.rule_start, wrapping_add(rule, 1));
            for match_index in first_match..end_match {
                if !guard_holds(in graph, in rules, rule, in matches, match_index) {
                    continue;
                }
                if apply_one(inout graph, in rules, rule, in matches, match_index, inout ids) {
                    unions = wrapping_add(unions, 1);
                }
            }
        }
        unions = wrapping_add(unions, graph.rebuild());
        if unions == 0 && graph.raw_len() == nodes_before {
            break;
        }
        changed = wrapping_add(changed, 1);
    }
    changed
}
