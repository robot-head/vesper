// Extraction: egg 0.10's `Extractor` with `AstSize` (an e-node costs one
// plus its children's costs).
//
// `find_costs` passes over the classes until no cost changes. A class takes
// the first e-node of least cost among those whose children all have
// costs, in its sorted order (egg's `min_by`), and a later pass replaces it
// only with a strictly cheaper one. Classes are passed over in ascending id
// order (egg: hash-map order), so when two e-nodes of one class tie, the
// choice can differ from egg's; the cost never does.
//
// `find_best` builds the expression as egg's `build_recexpr` does: a stack
// that starts with the root's children, last child first, each class
// emitted once all its children are, and the root last.

use self::util::{filled_u32, i64_at, u32_at, u64_at};
use self::graph::{EGraph};

const NONE: u32 = 4294967295;
const NO_COST: u64 = 18446744073709551615;

pub struct Extracted {
    // Per class root: its cost and the index of its best e-node in the
    // graph's rebuilt view.
    cost: ChunkSeq[u64],
    best: ChunkSeq[u32],
    // The expression of the last `find_best`: e-nodes, children first,
    // children as indices into these lists.
    op: ChunkSeq[u32],
    data: ChunkSeq[i64],
    c0: ChunkSeq[u32],
    c1: ChunkSeq[u32]
}

fn node_cost(in graph: EGraph, in cost: ChunkSeq[u64], k: u64) -> u64 {
    let arity = widen_u64(graph.arity_of(graph.node_op(k)));
    let mut sum: u64 = 1;
    for j in 0..arity {
        let child_cost = u64_at(in cost, widen_u64(graph.find(graph.node_child(k, j))));
        if child_cost == NO_COST {
            return NO_COST;
        }
        // saturating_add
        let total = wrapping_add(sum, child_cost);
        sum = if total < sum { NO_COST } else { total };
    }
    sum
}

// egg's `Extractor::new(egraph, AstSize)` on a rebuilt graph.
pub fn extractor(in graph: EGraph) -> Extracted {
    let id_count = graph.raw_len();
    let mut cost: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](id_count);
    cost.resize(id_count, NO_COST);
    let mut best = filled_u32(id_count, NONE);
    loop {
        let mut changed = false;
        for live_index in 0..graph.live_count() {
            let class = graph.live_at(live_index);
            let start = graph.class_start(class);
            let mut min_cost = NO_COST;
            let mut best_node: u32 = NONE;
            for k in start..wrapping_add(start, graph.class_len(class)) {
                let candidate = node_cost(in graph, in cost, k);
                if candidate != NO_COST && (best_node == NONE || candidate < min_cost) {
                    min_cost = candidate;
                    best_node = wrapping_u32(k);
                }
            }
            if best_node != NONE {
                let old_cost = u64_at(in cost, widen_u64(class));
                if old_cost == NO_COST || min_cost < old_cost {
                    cost.try_set(widen_u64(class), min_cost);
                    best.try_set(widen_u64(class), best_node);
                    changed = true;
                }
            }
        }
        if !changed {
            break;
        }
    }
    Extracted {
        cost: cost,
        best: best,
        op: ChunkSeq::new[u32](),
        data: ChunkSeq::new[i64](),
        c0: ChunkSeq::new[u32](),
        c1: ChunkSeq::new[u32]()
    }
}

impl Extracted {
    // The cost of a class, or u64::MAX when it has none.
    pub fn cost_of(in self, in graph: EGraph, id: u32) -> u64 {
        u64_at(in self.cost, widen_u64(graph.find(id)))
    }

    pub fn len(in self) -> u64 {
        self.op.len()
    }

    pub fn op_at(in self, i: u64) -> u32 {
        u32_at(in self.op, i)
    }

    pub fn data_at(in self, i: u64) -> i64 {
        i64_at(in self.data, i)
    }

    pub fn child_at(in self, i: u64, j: u64) -> u32 {
        if j == 0 {
            u32_at(in self.c0, i)
        } else {
            u32_at(in self.c1, i)
        }
    }

    fn emit(inout self, in graph: EGraph, node: u64, in ids: ChunkSeq[u32]) -> u32 {
        let op = graph.node_op(node);
        let arity = graph.arity_of(op);
        let child0 = if arity >= 1 {
            u32_at(in ids, widen_u64(graph.find(graph.node_child(node, 0))))
        } else {
            0
        };
        let child1 = if arity >= 2 {
            u32_at(in ids, widen_u64(graph.find(graph.node_child(node, 1))))
        } else {
            0
        };
        let id = wrapping_u32(self.op.len());
        self.op.push(op);
        self.data.push(graph.node_data(node));
        self.c0.push(child0);
        self.c1.push(child1);
        id
    }

    // egg's `find_best`: builds the best expression of `root`'s class into
    // this extractor's expression lists. False if the class has no cost.
    pub fn find_best(inout self, in graph: EGraph, root: u32) -> bool {
        self.op.clear();
        self.data.clear();
        self.c0.clear();
        self.c1.clear();
        let root_class = graph.find(root);
        let root_node = u32_at(in self.best, widen_u64(root_class));
        if root_node == NONE {
            return false;
        }
        let mut ids = filled_u32(graph.raw_len(), NONE);
        let mut todo: ChunkSeq[u32] = ChunkSeq::new[u32]();
        let root_arity = widen_u64(graph.arity_of(graph.node_op(widen_u64(root_node))));
        for j in 0..root_arity {
            todo.push(graph.find(graph.node_child(widen_u64(root_node), j)));
        }
        loop {
            let pending = todo.len();
            if pending == 0 {
                break;
            }
            let class = u32_at(in todo, wrapping_sub(pending, 1));
            if u32_at(in ids, widen_u64(class)) != NONE {
                todo.truncate(wrapping_sub(pending, 1));
                continue;
            }
            let node = widen_u64(u32_at(in self.best, widen_u64(class)));
            let arity = widen_u64(graph.arity_of(graph.node_op(node)));
            let mut children_done = true;
            for j in 0..arity {
                let child = graph.find(graph.node_child(node, j));
                if u32_at(in ids, widen_u64(child)) == NONE {
                    children_done = false;
                    todo.push(child);
                }
            }
            if children_done {
                let emitted = self.emit(in graph, node, in ids);
                ids.try_set(widen_u64(class), emitted);
                todo.truncate(wrapping_sub(pending, 1));
            }
        }
        self.emit(in graph, widen_u64(root_node), in ids);
        true
    }
}
