// Rewrite rules: patterns, their compiled e-matching programs, guards and
// the relation table guards read.
//
// A pattern is egg's `PatternAst`: a list of pattern nodes, children before
// parents, root last. A node is a class variable (`?x`) or an e-node whose
// data is a constant, or a data variable (`p` in egglog's
// `(Read (Write s p v) q)`): its first occurrence binds it, later ones
// compare, and a right-hand side uses its value.
//
// The left side compiles with egg's `machine::Compiler`: one `Bind` per
// e-node (registers for its children), a `Compare` for each repeated class
// variable. Bind iterates a class's e-nodes in sorted order, so the order of
// the substitutions is egg's.
//
// Guards are egg's conditions on a match: `total(?x)` (the class of `?x`
// holds a leaf, so dropping it cannot drop a failure) and `rel(a, b)` (the
// relation table holds the pair of data variables, egglog's
// `(disjoint p q)`).

use self::util::{filled_u32, i64_at, mix, u32_at, u8_at};

const NONE: u32 = 4294967295;

// Pattern node kinds.
const P_VAR: u8 = 0;
const P_NODE: u8 = 1;
// Data modes of a pattern e-node.
pub const D_CONST: u8 = 0;
pub const D_VAR: u8 = 1;
// Instruction kinds (six words each: kind, i, out, op, data mode, data
// index; data constants in `code_data`).
const I_BIND: u32 = 1;
const I_COMPARE: u32 = 2;
// Data modes of a compiled Bind.
const B_CONST: u32 = 0;
const B_BIND: u32 = 1;
const B_SAME: u32 = 2;
// Guards.
pub const G_NONE: u8 = 0;
pub const G_TOTAL: u8 = 1;
pub const G_REL: u8 = 2;

pub struct Rules {
    // Pattern nodes of every side of every rule; children are absolute
    // node indices.
    p_kind: ChunkSeq[u8],
    p_a: ChunkSeq[u32],
    p_dmode: ChunkSeq[u8],
    p_dval: ChunkSeq[i64],
    p_c0: ChunkSeq[u32],
    p_c1: ChunkSeq[u32],
    // Operator arities (the e-graph's language).
    arity: ChunkSeq[u8],
    // Per rule.
    lhs_start: ChunkSeq[u32],
    lhs_len: ChunkSeq[u32],
    rhs_start: ChunkSeq[u32],
    rhs_len: ChunkSeq[u32],
    guard: ChunkSeq[u8],
    g0: ChunkSeq[u32],
    g1: ChunkSeq[u32],
    nvars: ChunkSeq[u32],
    ndvars: ChunkSeq[u32],
    // Compiled left sides: code[prog_start[r] ..] (six words per
    // instruction), the register of each class variable
    // (vreg[vreg_start[r] + v]) and the registers each program uses.
    prog_start: ChunkSeq[u32],
    prog_len: ChunkSeq[u32],
    code: ChunkSeq[u32],
    code_data: ChunkSeq[i64],
    vreg_start: ChunkSeq[u32],
    vreg: ChunkSeq[u32],
    nregs: ChunkSeq[u32],
    // The side being built starts here.
    side: u32,
    // The relation: pairs of data values, hashed.
    rel_a: ChunkSeq[i64],
    rel_b: ChunkSeq[i64],
    rel_slots: ChunkSeq[u32],
    rel_mask: u64
}

pub fn rules_new(in arity: ChunkSeq[u8]) -> Rules {
    let mut arities: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](arity.len());
    for i in 0..arity.len() {
        arities.push(u8_at(in arity, i));
    }
    Rules {
        p_kind: ChunkSeq::new[u8](),
        p_a: ChunkSeq::new[u32](),
        p_dmode: ChunkSeq::new[u8](),
        p_dval: ChunkSeq::new[i64](),
        p_c0: ChunkSeq::new[u32](),
        p_c1: ChunkSeq::new[u32](),
        arity: arities,
        lhs_start: ChunkSeq::new[u32](),
        lhs_len: ChunkSeq::new[u32](),
        rhs_start: ChunkSeq::new[u32](),
        rhs_len: ChunkSeq::new[u32](),
        guard: ChunkSeq::new[u8](),
        g0: ChunkSeq::new[u32](),
        g1: ChunkSeq::new[u32](),
        nvars: ChunkSeq::new[u32](),
        ndvars: ChunkSeq::new[u32](),
        prog_start: ChunkSeq::new[u32](),
        prog_len: ChunkSeq::new[u32](),
        code: ChunkSeq::new[u32](),
        code_data: ChunkSeq::new[i64](),
        vreg_start: ChunkSeq::new[u32](),
        vreg: ChunkSeq::new[u32](),
        nregs: ChunkSeq::new[u32](),
        side: 0,
        rel_a: ChunkSeq::new[i64](),
        rel_b: ChunkSeq::new[i64](),
        rel_slots: filled_u32(64, 0),
        rel_mask: 63
    }
}

impl Rules {
    pub fn count(in self) -> u64 {
        self.lhs_start.len()
    }

    // ------------------------------------------------------------ building

    fn push_node(
        inout self,
        kind: u8,
        operand: u32,
        dmode: u8,
        dval: i64,
        c0: u32,
        c1: u32
    ) -> u32 {
        let id = wrapping_u32(self.p_kind.len());
        self.p_kind.push(kind);
        self.p_a.push(operand);
        self.p_dmode.push(dmode);
        self.p_dval.push(dval);
        self.p_c0.push(c0);
        self.p_c1.push(c1);
        id
    }

    // Starts a pattern (a rule's left or right side).
    pub fn begin(inout self) {
        self.side = wrapping_u32(self.p_kind.len());
    }

    // Ends the pattern begun last; returns its (start, length).
    pub fn end(inout self) -> (u32, u32) {
        let start = self.side;
        (start, wrapping_sub(wrapping_u32(self.p_kind.len()), start))
    }

    // Class variable `var_index` (0 is `?x`, 1 `?y`, ...).
    pub fn var(inout self, var_index: u32) -> u32 {
        self.push_node(P_VAR, var_index, D_CONST, 0, 0, 0)
    }

    // An e-node with constant data.
    pub fn node(inout self, op: u32, data: i64, c0: u32, c1: u32) -> u32 {
        self.push_node(P_NODE, op, D_CONST, data, c0, c1)
    }

    // An e-node whose data is data variable `data_var`.
    pub fn dnode(inout self, op: u32, data_var: u32, c0: u32, c1: u32) -> u32 {
        self.push_node(P_NODE, op, D_VAR, widen_i64(data_var), c0, c1)
    }

    // Adds rule `lhs => rhs if guard(g0, g1)` and compiles its left side.
    pub fn rule(inout self, lhs: (u32, u32), rhs: (u32, u32), guard: u8, g0: u32, g1: u32) {
        let (lhs_first, lhs_count) = lhs;
        let (rhs_first, rhs_count) = rhs;
        self.lhs_start.push(lhs_first);
        self.lhs_len.push(lhs_count);
        self.rhs_start.push(rhs_first);
        self.rhs_len.push(rhs_count);
        self.guard.push(guard);
        self.g0.push(g0);
        self.g1.push(g1);
        let mut var_count: u32 = 0;
        let mut data_var_count: u32 = 0;
        for offset in 0..widen_u64(lhs_count) {
            let node = wrapping_add(widen_u64(lhs_first), offset);
            let operand = u32_at(in self.p_a, node);
            if u8_at(in self.p_kind, node) == P_VAR {
                if operand >= var_count {
                    var_count = wrapping_add(operand, 1);
                }
            } else if u8_at(in self.p_dmode, node) == D_VAR {
                let data_var = wrapping_u32(i64_at(in self.p_dval, node));
                if data_var >= data_var_count {
                    data_var_count = wrapping_add(data_var, 1);
                }
            }
        }
        self.nvars.push(var_count);
        self.ndvars.push(data_var_count);
        self.compile(lhs_first, lhs_count, var_count, data_var_count);
    }

    // ------------------------------------------------------------ relation

    fn rel_find(in self, first: i64, second: i64) -> (u64, bool) {
        let hash = mix(
            0,
            first,
            wrapping_u32(wrapping_u64(second)),
            wrapping_u32(wrapping_u64(second) >> 32)
        );
        let mut at = hash & self.rel_mask;
        loop {
            let slot = u32_at(in self.rel_slots, at);
            if slot == 0 {
                return (at, false);
            }
            let key = widen_u64(wrapping_sub(slot, 1));
            if i64_at(in self.rel_a, key) == first && i64_at(in self.rel_b, key) == second {
                return (at, true);
            }
            at = wrapping_add(at, 1) & self.rel_mask;
        }
    }

    pub fn rel_has(in self, first: i64, second: i64) -> bool {
        let (_at, found) = self.rel_find(first, second);
        found
    }

    // Adds (a, b) to the relation.
    pub fn rel_add(inout self, first: i64, second: i64) {
        let (at, found) = self.rel_find(first, second);
        if found {
            return;
        }
        let key = self.rel_a.len();
        self.rel_a.push(first);
        self.rel_b.push(second);
        self.rel_slots.try_set(at, wrapping_u32(wrapping_add(key, 1)));
        if wrapping_mul(wrapping_add(key, 1), 2) > self.rel_mask {
            let cap = wrapping_mul(wrapping_add(self.rel_mask, 1), 2);
            let mask = wrapping_sub(cap, 1);
            let mut slots = filled_u32(cap, 0);
            for entry in 0..self.rel_a.len() {
                let entry_first = i64_at(in self.rel_a, entry);
                let entry_second = i64_at(in self.rel_b, entry);
                let hash = mix(
                    0,
                    entry_first,
                    wrapping_u32(wrapping_u64(entry_second)),
                    wrapping_u32(wrapping_u64(entry_second) >> 32)
                );
                let mut probe = hash & mask;
                loop {
                    if u32_at(in slots, probe) == 0 {
                        break;
                    }
                    probe = wrapping_add(probe, 1) & mask;
                }
                slots.try_set(probe, wrapping_u32(wrapping_add(entry, 1)));
            }
            self.rel_slots = slots;
            self.rel_mask = mask;
        }
    }

    // ------------------------------------------------------------ compiler

    // The number of distinct class variables under pattern node `node` not yet
    // bound, and the subtree's e-node count (egg's `free_vars` and
    // `subtree_size`).
    fn free_and_size(
        in self,
        node: u32,
        in bound: ChunkSeq[u32],
        inout seen: ChunkSeq[u8]
    ) -> (u64, u64) {
        if u8_at(in self.p_kind, widen_u64(node)) == P_VAR {
            let var = widen_u64(u32_at(in self.p_a, widen_u64(node)));
            if u8_at(in seen, var) != 0 {
                return (0, 0);
            }
            seen.try_set(var, 1);
            if u32_at(in bound, var) == NONE {
                return (1, 0);
            }
            return (0, 0);
        }
        let arity = u8_at(in self.arity, widen_u64(u32_at(in self.p_a, widen_u64(node))));
        let mut free: u64 = 0;
        let mut size: u64 = 1;
        if arity >= 1 {
            let (child_free, child_size) = self.free_and_size(
                u32_at(in self.p_c0, widen_u64(node)),
                in bound,
                inout seen
            );
            free = wrapping_add(free, child_free);
            size = wrapping_add(size, child_size);
        }
        if arity >= 2 {
            let (child_free, child_size) = self.free_and_size(
                u32_at(in self.p_c1, widen_u64(node)),
                in bound,
                inout seen
            );
            free = wrapping_add(free, child_free);
            size = wrapping_add(size, child_size);
        }
        (free, size)
    }

    fn emit(
        inout self,
        kind: u32,
        reg: u32,
        out: u32,
        op: u32,
        dmode: u32,
        data_index: u32,
        data: i64
    ) {
        self.code.push(kind);
        self.code.push(reg);
        self.code.push(out);
        self.code.push(op);
        self.code.push(dmode);
        self.code.push(data_index);
        self.code_data.push(data);
    }

    // egg's `Compiler::compile` for one pattern (no multi-patterns). The
    // next pattern node to bind is the one egg's `next` picks (all
    // variables bound first, then fewest free variables, then largest);
    // egg breaks ties by hash order, here the last added wins. No rule of
    // either optimizer has two pending nodes at once.
    fn compile(inout self, start: u32, node_count: u32, var_count: u32, data_var_count: u32) {
        let first = wrapping_u32(self.code.len() / 6);
        let mut bound = filled_u32(widen_u64(var_count), NONE);
        let mut dbound: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](widen_u64(data_var_count));
        dbound.resize(widen_u64(data_var_count), 0);
        let mut todo_node: ChunkSeq[u32] = ChunkSeq::new[u32]();
        let mut todo_reg: ChunkSeq[u32] = ChunkSeq::new[u32]();
        let root = wrapping_sub(wrapping_add(start, node_count), 1);
        let mut next_out: u32 = 1;
        // add_todo(root, reg 0)
        if u8_at(in self.p_kind, widen_u64(root)) == P_VAR {
            bound.try_set(widen_u64(u32_at(in self.p_a, widen_u64(root))), 0);
        } else {
            todo_node.push(root);
            todo_reg.push(0);
        }
        loop {
            let pending = todo_node.len();
            if pending == 0 {
                break;
            }
            // pick max (ground, n_free, -size)
            let mut best: u64 = 0;
            let mut best_ground = false;
            let mut best_free: u64 = 0;
            let mut best_size: u64 = 0;
            for candidate in 0..pending {
                let mut seen: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](widen_u64(var_count));
                seen.resize(widen_u64(var_count), 0);
                let (free, size) = self.free_and_size(
                    u32_at(in todo_node, candidate),
                    in bound,
                    inout seen
                );
                let ground = free == 0;
                let better = if candidate == 0 {
                    true
                } else if ground != best_ground {
                    ground
                } else if free != best_free {
                    free > best_free
                } else {
                    size <= best_size
                };
                if better {
                    best = candidate;
                    best_ground = ground;
                    best_free = free;
                    best_size = size;
                }
            }
            let node = u32_at(in todo_node, best);
            let reg = u32_at(in todo_reg, best);
            let last = wrapping_sub(pending, 1);
            todo_node.try_set(best, u32_at(in todo_node, last));
            todo_reg.try_set(best, u32_at(in todo_reg, last));
            todo_node.truncate(last);
            todo_reg.truncate(last);
            let op = u32_at(in self.p_a, widen_u64(node));
            let arity = u8_at(in self.arity, widen_u64(op));
            let out = next_out;
            next_out = wrapping_add(next_out, widen_u32(arity));
            let mut dmode = B_CONST;
            let mut data_index: u32 = 0;
            let data = i64_at(in self.p_dval, widen_u64(node));
            if u8_at(in self.p_dmode, widen_u64(node)) == D_VAR {
                data_index = wrapping_u32(data);
                if u8_at(in dbound, widen_u64(data_index)) == 0 {
                    dmode = B_BIND;
                    dbound.try_set(widen_u64(data_index), 1);
                } else {
                    dmode = B_SAME;
                }
            }
            self.emit(I_BIND, reg, out, op, dmode, data_index, data);
            for child_slot in 0..widen_u64(arity) {
                let child = if child_slot == 0 {
                    u32_at(in self.p_c0, widen_u64(node))
                } else {
                    u32_at(in self.p_c1, widen_u64(node))
                };
                let child_reg = wrapping_add(out, wrapping_u32(child_slot));
                if u8_at(in self.p_kind, widen_u64(child)) == P_VAR {
                    let var = widen_u64(u32_at(in self.p_a, widen_u64(child)));
                    let bound_reg = u32_at(in bound, var);
                    if bound_reg == NONE {
                        bound.try_set(var, child_reg);
                    } else {
                        self.emit(I_COMPARE, child_reg, bound_reg, 0, 0, 0, 0);
                    }
                } else {
                    todo_node.push(child);
                    todo_reg.push(child_reg);
                }
            }
        }
        let count = wrapping_sub(wrapping_u32(self.code.len() / 6), first);
        self.prog_start.push(first);
        self.prog_len.push(count);
        self.vreg_start.push(wrapping_u32(self.vreg.len()));
        for var in 0..widen_u64(var_count) {
            self.vreg.push(u32_at(in bound, var));
        }
        self.nregs.push(next_out);
    }

    // ------------------------------------------------------------ reads

    pub fn nvars_of(in self, rule: u64) -> u64 {
        widen_u64(u32_at(in self.nvars, rule))
    }

    pub fn ndvars_of(in self, rule: u64) -> u64 {
        widen_u64(u32_at(in self.ndvars, rule))
    }

    pub fn nregs_of(in self, rule: u64) -> u64 {
        widen_u64(u32_at(in self.nregs, rule))
    }

    pub fn var_reg(in self, rule: u64, var: u64) -> u64 {
        widen_u64(u32_at(
            in self.vreg,
            wrapping_add(widen_u64(u32_at(in self.vreg_start, rule)), var)
        ))
    }

    pub fn prog(in self, rule: u64) -> (u64, u64) {
        (widen_u64(u32_at(in self.prog_start, rule)), widen_u64(u32_at(in self.prog_len, rule)))
    }

    pub fn instr(in self, pc: u64, field: u64) -> u32 {
        u32_at(in self.code, wrapping_add(wrapping_mul(pc, 6), field))
    }

    pub fn instr_data(in self, pc: u64) -> i64 {
        i64_at(in self.code_data, pc)
    }

    pub fn rhs(in self, rule: u64) -> (u64, u64) {
        (widen_u64(u32_at(in self.rhs_start, rule)), widen_u64(u32_at(in self.rhs_len, rule)))
    }

    pub fn guard_of(in self, rule: u64) -> (u8, u32, u32) {
        (u8_at(in self.guard, rule), u32_at(in self.g0, rule), u32_at(in self.g1, rule))
    }

    pub fn pnode(in self, node: u64) -> (u8, u32, u8, i64, u32, u32) {
        (
            u8_at(in self.p_kind, node),
            u32_at(in self.p_a, node),
            u8_at(in self.p_dmode, node),
            i64_at(in self.p_dval, node),
            u32_at(in self.p_c0, node),
            u32_at(in self.p_c1, node)
        )
    }
}
