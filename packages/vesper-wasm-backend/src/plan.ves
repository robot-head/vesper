// The uniform value layout (src/wasm_backend/layout.rs) and the static
// plan (src/wasm_backend/analysis.rs): which function instances the entry
// reaches, under which type arguments, and what each call targets.
//
// Strings the Rust code keys maps by (instance keys such as `f<T=i64>`,
// evidence keys such as `$effect:Fail`) are interned symbols here; a
// table indexed by symbol stands for each `BTreeMap<String, _>`, and the
// few maps the Rust code iterates in key order are sorted by the names'
// bytes (`cmp_syms`), as `String`'s `Ord` is.

use @vesper/place-ir::{program_new};
use @vesper/place-ir::codes::{Op, Pat, Term};
use @vesper/check-data::util::{
    add, inc, n32, stage2_heap_mark, stage2_heap_reset, stage2_heap_swap, u32_at, u64_at, w
};
use @vesper/check-data::names::{Names, names_new};
use @vesper/check-data::types::{
    TyKind, TyPass, Types, Vars, default_type, display, substitute, types_new, vars_new
};
use @vesper/check-data::world::{Adt, Known, Variant, World, set_by_symbol, world_new};
use @vesper/check-data::input::{Ctx};
use self::err::{WErr, werr, werr_syms};
use self::ir::{EffInst, ExprFactKind, Facts, FnInfo, Ir, Sig, empty_facts, ir_new, pattern_end};

const NONE32: u32 = 4294967295;
const NONE64: u64 = 18446744073709551615;
const NO_ADT: u32 = 4294967295;
// err.ves kinds and constructs (constants cannot be imported yet).
const K_UNSUPPORTED: u8 = 0;
const K_ENTRY: u8 = 1;
const K_LIMIT: u8 = 2;
const K_INVALID: u8 = 3;
const K_NOT_PORTED: u8 = 5;
const U_PROJECTION: u8 = 4;
const U_GENERIC_EFFECT_INSTANCE: u8 = 6;
const U_INOUT_EFFECT_ARGUMENT: u8 = 8;
const U_FIRST_CLASS_CONTINUATION: u8 = 9;
const U_EXTERNAL_FUNCTION: u8 = 11;
const U_INTEGER_WIDTH: u8 = 14;
const U_FLOAT32: u8 = 15;

// Shapes (`layout::Shape`) and scalars (`layout::Scalar`).
pub const SH_SCALAR: u8 = 0;
pub const SH_TUPLE: u8 = 1;
pub const SH_STRUCT: u8 = 2;
pub const SH_ENUM: u8 = 3;
pub const SH_STR: u8 = 4;
pub const SH_OPAQUE: u8 = 5;
pub const SH_FUNCTION: u8 = 6;
pub const SC_I64: u8 = 0;
pub const SC_U64: u8 = 1;
pub const SC_U32: u8 = 2;
pub const SC_U8: u8 = 3;
pub const SC_BOOL: u8 = 4;
pub const SC_F64: u8 = 5;
pub const SC_UNIT: u8 = 6;
pub const SC_NEVER: u8 = 7;
pub const SC_U16: u8 = 8;
pub const SC_I32: u8 = 9;
pub const SC_I16: u8 = 10;
pub const SC_I8: u8 = 11;

// Clause modes (`analysis::HandlerMode`). A clause that resumes other
// than in tail position runs on a WasmFX continuation or in CPS, which
// the port does not lower yet.
pub const M_ABORT: u8 = 0;
pub const M_TAIL: u8 = 1;
pub const M_OTHER: u8 = 2;

// Roles (`analysis::Role`).
pub const R_ORDINARY: u8 = 0;
pub const R_HANDLER_BODY: u8 = 1;
pub const R_RETURN_CLAUSE: u8 = 2;
pub const R_OP_CLAUSE: u8 = 3;

// Symbols the backend compares against, interned once.
pub copy struct Syms {
    i64_: u32,
    u64_: u32,
    u32_: u32,
    u8_: u32,
    bool_: u32,
    f64_: u32,
    f32_: u32,
    unit: u32,
    never: u32,
    string: u32,
    i128_: u32,
    u128_: u32,
    fail: u32,
    raise: u32,
    result: u32,
    overflow: u32,
    runtime_error: u32,
    index_oob: u32,
    div_zero: u32,
    stdout: u32,
    clock: u32,
    trace: u32,
    // the `.vsys` libraries of @vesper-std/env and @vesper-std/fs
    // (`ffi_lowering::effect_name`), lowered over WASI (src/host.ves)
    ffi_env: u32,
    ffi_fs: u32,
    ffi_proc: u32,
    eq: u32,
    empty: u32,
    chunkseq: u32,
    slice: u32,
    str_: u32,
    some: u32,
    none: u32,
}

pub fn syms_new(inout n: Names) -> Syms {
    Syms {
        i64_: n.intern(in "i64".as_bytes()),
        u64_: n.intern(in "u64".as_bytes()),
        u32_: n.intern(in "u32".as_bytes()),
        u8_: n.intern(in "u8".as_bytes()),
        bool_: n.intern(in "bool".as_bytes()),
        f64_: n.intern(in "f64".as_bytes()),
        f32_: n.intern(in "f32".as_bytes()),
        unit: n.intern(in "Unit".as_bytes()),
        never: n.intern(in "Never".as_bytes()),
        string: n.intern(in "String".as_bytes()),
        i128_: n.intern(in "i128".as_bytes()),
        u128_: n.intern(in "u128".as_bytes()),
        fail: n.intern(in "Fail".as_bytes()),
        raise: n.intern(in "raise".as_bytes()),
        result: n.intern(in "Result".as_bytes()),
        overflow: n.intern(in "ArithOverflow".as_bytes()),
        runtime_error: n.intern(in "RuntimeError".as_bytes()),
        index_oob: n.intern(in "IndexOutOfBounds".as_bytes()),
        div_zero: n.intern(in "DivisionByZero".as_bytes()),
        stdout: n.intern(in "Stdout".as_bytes()),
        clock: n.intern(in "Clock".as_bytes()),
        trace: n.intern(in "Trace".as_bytes()),
        ffi_env: n.intern(in "Ffi$StdEnv".as_bytes()),
        ffi_fs: n.intern(in "Ffi$StdFs".as_bytes()),
        ffi_proc: n.intern(in "Ffi$StdProcess".as_bytes()),
        eq: n.intern(in "=".as_bytes()),
        empty: n.intern(in "".as_bytes()),
        chunkseq: n.intern(in "ChunkSeq".as_bytes()),
        slice: n.intern(in "Slice".as_bytes()),
        str_: n.intern(in "Str".as_bytes()),
        some: n.intern(in "Some".as_bytes()),
        none: n.intern(in "None".as_bytes()),
    }
}

// The checker data and the backend's inputs.
pub struct Cx {
    names: Names,
    types: Types,
    world: World,
    k: Known,
    f: Facts,
    ir: Ir,
    s: Syms,
}

pub fn cx_new(sink c: Ctx, sink f: Facts, sink ir: Ir) -> Cx {
    let Ctx { names, types, world, tmap, nmap } = c;
    let mut names = names;
    let s = syms_new(inout names);
    let k = world.k;
    Cx {
        names: names,
        types: types,
        world: world,
        k: k,
        f: f,
        ir: ir,
        s: s,
    }
}

// Byte order of two names (`String`'s `Ord`): -1, 0 or 1.
pub fn cmp_syms(in names: Names, a: u32, b: u32) -> i64 {
    if a == b {
        return 0;
    }
    let (a0, a1) = (names.start(a), names.end(a));
    let (b0, b1) = (names.start(b), names.end(b));
    let la = wrapping_sub(a1, a0);
    let lb = wrapping_sub(b1, b0);
    let n = if la < lb {
        la
    } else {
        lb
    };
    for i in 0..n {
        let x = names.byte(a, i);
        let y = names.byte(b, i);
        if x < y {
            return -1;
        }
        if x > y {
            return 1;
        }
    }
    if la < lb {
        -1
    } else if la > lb {
        1
    } else {
        0
    }
}

// Inserts symbol `x` into the byte-sorted set `set` (no duplicates).
pub fn sorted_insert(in names: Names, inout set: ChunkSeq[u32], x: u32) {
    let mut at = set.len();
    for i in 0..set.len() {
        let c = cmp_syms(in names, u32_at(in set, i), x);
        if c == 0 {
            return;
        }
        if c > 0 {
            at = i;
            break;
        }
    }
    set.push(x);
    let mut i = wrapping_sub(set.len(), 1);
    loop {
        if i <= at {
            break;
        }
        let prev = u32_at(in set, wrapping_sub(i, 1));
        let ok = set.try_set(i, prev);
        i = wrapping_sub(i, 1);
    }
    let ok = set.try_set(at, x);
}

pub fn contains32(in set: ChunkSeq[u32], x: u32) -> bool {
    for i in 0..set.len() {
        if u32_at(in set, i) == x {
            return true;
        }
    }
    false
}

// ----- layout ------------------------------------------------------------------

// `layout::shape` of a type: the kind, the scalar, and for an ADT its
// index (fields are read through `variant_field`).
pub copy struct Shape {
    kind: u8,
    scalar: u8,
    adt: u32,
    // the defaulted type the shape is of
    ty: u32,
}

fn shape_of(kind: u8, scalar: u8, adt: u32, ty: u32) -> Shape {
    Shape { kind: kind, scalar: scalar, adt: adt, ty: ty }
}

impl Cx {
    pub fn default_ty(inout self, t: u32) -> u32 {
        default_type(inout self.types, t)
    }

    pub fn subst(inout self, t: u32, in vars: Vars) -> u32 {
        substitute(inout self.types, t, in vars)
    }

    // `numeric::is_integer_name`.
    pub fn is_integer_name(in self, n: u32) -> bool {
        self.k.is_integer(n) || n == self.s.i128_ || n == self.s.u128_
    }

    pub fn is_scalar_name(in self, n: u32) -> bool {
        self.k.is_scalar(n) || n == self.s.i128_ || n == self.s.u128_
    }

    pub fn shape(inout self, t: u32) -> Shape eff [Fail[WErr]] {
        let ty = default_type(inout self.types, t);
        let node = self.types.node(ty);
        if node.kind == TyKind::Named {
            let n = node.name;
            let s = self.s;
            if n == s.i64_ || n == self.k.isize_ {
                return shape_of(SH_SCALAR, SC_I64, NO_ADT, ty);
            }
            if n == s.u64_ || n == self.k.usize_ {
                return shape_of(SH_SCALAR, SC_U64, NO_ADT, ty);
            }
            if n == s.u32_ {
                return shape_of(SH_SCALAR, SC_U32, NO_ADT, ty);
            }
            if n == s.u8_ {
                return shape_of(SH_SCALAR, SC_U8, NO_ADT, ty);
            }
            if n == self.k.u16_ {
                return shape_of(SH_SCALAR, SC_U16, NO_ADT, ty);
            }
            if n == self.k.i32_ {
                return shape_of(SH_SCALAR, SC_I32, NO_ADT, ty);
            }
            if n == self.k.i16_ {
                return shape_of(SH_SCALAR, SC_I16, NO_ADT, ty);
            }
            if n == self.k.i8_ {
                return shape_of(SH_SCALAR, SC_I8, NO_ADT, ty);
            }
            if n == s.bool_ {
                return shape_of(SH_SCALAR, SC_BOOL, NO_ADT, ty);
            }
            if n == s.f64_ {
                return shape_of(SH_SCALAR, SC_F64, NO_ADT, ty);
            }
            if n == s.unit {
                return shape_of(SH_SCALAR, SC_UNIT, NO_ADT, ty);
            }
            if n == s.never {
                return shape_of(SH_SCALAR, SC_NEVER, NO_ADT, ty);
            }
            if n == s.string {
                return shape_of(SH_STR, 0, NO_ADT, ty);
            }
            if n == s.f32_ {
                Fail::raise(werr(K_UNSUPPORTED, U_FLOAT32, 10));
            }
            if n == s.u128_ || n == s.i128_ {
                // the tuple (low word, high word): src/wide.ves
                let u = self.types.named0(s.u64_);
                let mut e = ChunkSeq::new[u32]();
                e.push(u);
                e.push(u);
                let tt = self.types.tuple(in e);
                return shape_of(SH_TUPLE, 0, NO_ADT, tt);
            }
            if self.is_integer_name(n) {
                Fail::raise(werr_syms(K_UNSUPPORTED, U_INTEGER_WIDTH, 11, 0, n));
            }
            let a = self.world.lookup(n);
            if a == NO_ADT {
                return shape_of(SH_OPAQUE, 0, NO_ADT, ty);
            }
            let adt = self.world.adt(a);
            if adt.is_enum {
                return shape_of(SH_ENUM, 0, a, ty);
            }
            return shape_of(SH_STRUCT, 0, a, ty);
        }
        if node.kind == TyKind::Tuple {
            if node.n == 0 {
                return shape_of(SH_SCALAR, SC_UNIT, NO_ADT, ty);
            }
            return shape_of(SH_TUPLE, 0, NO_ADT, ty);
        }
        if node.kind == TyKind::Fn {
            return shape_of(SH_FUNCTION, 0, NO_ADT, ty);
        }
        if node.kind == TyKind::Lit {
            return shape_of(SH_SCALAR, SC_I64, NO_ADT, ty);
        }
        shape_of(SH_OPAQUE, 0, NO_ADT, ty)
    }

    // The number of variants of an ADT shape (a struct has its one, or
    // none).
    pub fn variant_count(in self, sh: Shape) -> u64 {
        w(self.world.adt(sh.adt).vn)
    }

    pub fn variant(in self, sh: Shape, v: u64) -> Variant {
        let a = self.world.adt(sh.adt);
        self.world.variant(add(w(a.va), v))
    }

    // Field `i` of variant `v` of ADT shape `sh`: its name and its type
    // under the shape's arguments (substituted, not defaulted).
    pub fn variant_field(inout self, sh: Shape, v: u64, i: u64) -> (u32, u32) {
        let a = self.world.adt(sh.adt);
        let var = self.world.variant(add(w(a.va), v));
        let f = self.world.field(add(w(var.fa), i));
        let vars = self.world.vars_of(in self.types, a, sh.ty);
        let t = substitute(inout self.types, f.ty, in vars);
        (f.name, t)
    }

    // The number of fields of variant `v` (a struct's only variant is 0;
    // a struct without variants has none).
    pub fn field_count(in self, sh: Shape, v: u64) -> u64 {
        let a = self.world.adt(sh.adt);
        if v >= w(a.vn) {
            return 0;
        }
        w(self.world.variant(add(w(a.va), v)).fc)
    }

    // Element `i` of a tuple type.
    pub fn tuple_elem(in self, ty: u32, i: u64) -> u32 {
        self.types.arg(ty, i)
    }

    pub fn arity(in self, ty: u32) -> u64 {
        self.types.arity(ty)
    }

    // `layout::field`: the byte offset and type of field `name` of a tuple
    // or struct value.
    pub fn field(inout self, ty: u32, name: u32) -> (u64, u32) eff [Fail[WErr]] {
        let sh = self.shape(ty);
        if sh.kind == SH_TUPLE {
            let i = self.decimal(name);
            if i == 18446744073709551615 {
                Fail::raise(werr(K_INVALID, 0, 20));
            }
            if i >= self.types.arity(sh.ty) {
                Fail::raise(werr(K_INVALID, 0, 21));
            }
            return (wrapping_mul(8, i), self.types.arg(sh.ty, i));
        }
        if sh.kind == SH_STRUCT {
            let n = self.field_count(sh, 0);
            for i in 0..n {
                let (fname, fty) = self.variant_field(sh, 0, i);
                if fname == name {
                    return (wrapping_mul(8, i), fty);
                }
            }
            Fail::raise(werr(K_INVALID, 0, 22));
        }
        Fail::raise(werr(K_UNSUPPORTED, U_PROJECTION, 23));
        (0, 0)
    }

    // The value of decimal name `s` (`str::parse::<usize>`), or u64::MAX.
    pub fn decimal(in self, s: u32) -> u64 {
        let n = self.names.size(s);
        if n == 0 {
            return 18446744073709551615;
        }
        let mut v: u64 = 0;
        for i in 0..n {
            let c = self.names.byte(s, i);
            if c < 48 || c > 57 {
                return 18446744073709551615;
            }
            v = wrapping_add(wrapping_mul(v, 10), widen_u64(wrapping_sub(c, 48)));
        }
        v
    }

    // `layout::slots`: the slot count of a struct or tuple block.
    pub fn slots(inout self, ty: u32) -> u64 eff [Fail[WErr]] {
        let sh = self.shape(ty);
        if sh.kind == SH_TUPLE {
            return self.types.arity(sh.ty);
        }
        if sh.kind == SH_STRUCT {
            return self.field_count(sh, 0);
        }
        Fail::raise(werr(K_INVALID, 0, 24));
        0
    }

    // `layout::variant`: (index, is_enum) of `constructor` in the enum
    // or struct `ty`, and the shape whose variant `index` it is.
    pub fn variant_of(
        inout self,
        ty: u32,
        constructor: u32
    ) -> (u64, bool, Shape) eff [Fail[WErr]] {
        let short = self.short_name(constructor);
        let sh = self.shape(ty);
        if sh.kind == SH_ENUM {
            let n = self.variant_count(sh);
            for i in 0..n {
                let v = self.variant(sh, i);
                if self.names_equal(v.name, short) {
                    return (i, true, sh);
                }
            }
            Fail::raise(werr(K_INVALID, 0, 25));
        }
        if sh.kind == SH_STRUCT {
            return (0, false, sh);
        }
        Fail::raise(werr(K_INVALID, 0, 26));
        (0, false, sh)
    }

    pub fn names_equal(in self, a: u32, b: u32) -> bool {
        cmp_syms(in self.names, a, b) == 0
    }

    // The part of `name` after its last `::` (`rsplit("::").next()`).
    pub fn short_name(inout self, name: u32) -> u32 {
        let n = self.names.size(name);
        let mut cut: u64 = 0;
        let mut i: u64 = 0;
        loop {
            if inc(i) >= n {
                break;
            }
            if self.names.byte(name, i) == 58 && self.names.byte(name, inc(i)) == 58 {
                cut = add(i, 2);
            }
            i = inc(i);
        }
        if cut == 0 {
            return name;
        }
        let mut text = ChunkSeq::new[u8]();
        for k in cut..n {
            text.push(self.names.byte(name, k));
        }
        self.intern(in text)
    }

    // The index of field `name` in variant `v` of shape `sh`, or NONE.
    pub fn field_index(inout self, sh: Shape, v: u64, name: u32) -> u64 {
        let n = self.field_count(sh, v);
        let a = self.world.adt(sh.adt);
        let var = self.world.variant(add(w(a.va), v));
        for i in 0..n {
            let f = self.world.field(add(w(var.fa), i));
            if f.name == name {
                return i;
            }
        }
        18446744073709551615
    }

    // The function's signature in the world: a sig index + 1, or 0.
    pub fn fn_sig(in self, name: u32) -> u64 {
        self.f.fn_sig_of(name)
    }

    pub fn sig(in self, name: u32) -> Sig {
        let s = self.f.fn_sig_of(name);
        if s == 0 {
            return self.f.sig(18446744073709551615);
        }
        self.f.sig(wrapping_sub(s, 1))
    }

    // Appends the `Display` of type `t` to `out`.
    pub fn show(in self, t: u32, inout out: ChunkSeq[u8]) {
        display(in self.types, in self.names, t, inout out);
    }

    pub fn write_name(in self, s: u32, inout out: ChunkSeq[u8]) {
        self.names.write(s, inout out);
    }

    pub fn intern(inout self, in text: ChunkSeq[u8]) -> u32 {
        let hit = self.names.lookup(in text.as_slice());
        if hit != NONE32 {
            return hit;
        }
        self.names.intern(in text.as_slice())
    }

    // `mentions_generic` of analysis.rs.
    pub fn mentions_generic(in self, t: u32) -> bool {
        let n = self.types.node(t);
        if n.kind == TyKind::Named {
            if n.n == 0
                && self.world.lookup(n.name) == NO_ADT
                && !self.is_scalar_name(n.name)
                && n.name != self.s.string {
                return true;
            }
            for i in 0..w(n.n) {
                if self.mentions_generic(self.types.arg(t, i)) {
                    return true;
                }
            }
            return false;
        }
        if n.kind == TyKind::Tuple {
            for i in 0..w(n.n) {
                if self.mentions_generic(self.types.arg(t, i)) {
                    return true;
                }
            }
            return false;
        }
        n.kind != TyKind::Lit
    }
}

// ----- vars ------------------------------------------------------------------

// Type arguments of an instance in name order (`analysis::Vars`, a
// `BTreeMap<String, Type>`): `keys[i] -> vals[i]`.
pub struct TVars {
    keys: ChunkSeq[u32],
    vals: ChunkSeq[u32],
}

pub fn tvars_new() -> TVars {
    TVars { keys: ChunkSeq::new[u32](), vals: ChunkSeq::new[u32]() }
}

impl TVars {
    pub fn len(in self) -> u64 {
        self.keys.len()
    }

    pub fn key(in self, i: u64) -> u32 {
        u32_at(in self.keys, i)
    }

    pub fn val(in self, i: u64) -> u32 {
        u32_at(in self.vals, i)
    }

    pub fn get(in self, k: u32) -> u32 {
        for i in 0..self.keys.len() {
            if u32_at(in self.keys, i) == k {
                return u32_at(in self.vals, i);
            }
        }
        NONE32
    }

    // `insert`, keeping name order.
    pub fn set(inout self, in names: Names, k: u32, v: u32) {
        for i in 0..self.keys.len() {
            if u32_at(in self.keys, i) == k {
                let ok = self.vals.try_set(i, v);
                return;
            }
        }
        let mut at = self.keys.len();
        for i in 0..self.keys.len() {
            if cmp_syms(in names, u32_at(in self.keys, i), k) > 0 {
                at = i;
                break;
            }
        }
        self.keys.push(k);
        self.vals.push(v);
        let mut i = wrapping_sub(self.keys.len(), 1);
        loop {
            if i <= at {
                break;
            }
            let pk = u32_at(in self.keys, wrapping_sub(i, 1));
            let pv = u32_at(in self.vals, wrapping_sub(i, 1));
            let ok = self.keys.try_set(i, pk);
            let ok2 = self.vals.try_set(i, pv);
            i = wrapping_sub(i, 1);
        }
        let ok = self.keys.try_set(at, k);
        let ok2 = self.vals.try_set(at, v);
    }

    // check-data's `Vars` for `substitute`.
    pub fn vars(in self) -> Vars {
        let mut v = vars_new();
        for i in 0..self.keys.len() {
            v.set(u32_at(in self.keys, i), u32_at(in self.vals, i));
        }
        v
    }

    pub fn dup(in self) -> TVars {
        let mut out = tvars_new();
        for i in 0..self.keys.len() {
            out.keys.push(u32_at(in self.keys, i));
            out.vals.push(u32_at(in self.vals, i));
        }
        out
    }
}

// ----- plan ------------------------------------------------------------------

// One reachable function instance (`analysis::Instance` and its role).
pub copy struct Inst {
    key: u32,
    base: u32,
    // the IR function: index into `Ir`'s functions
    fi: u64,
    // type arguments: vkeys/vvals[v0..v0+vn]
    v0: u64,
    vn: u64,
    role: u8,
    handler: u64,
    op: u64,
    // calls[c0..c0+cn]: this instance's direct calls
    c0: u64,
    cn: u64,
    // labels[l0..l0+ln]
    l0: u64,
    ln: u64,
}

pub copy struct CallTarget {
    dest: u64,
    callee: u32,
}

pub struct Plan {
    insts: ChunkSeq[Inst],
    vkeys: ChunkSeq[u32],
    vvals: ChunkSeq[u32],
    // key symbol -> inst index + 1
    by_key: ChunkSeq[u32],
    calls: ChunkSeq[CallTarget],
    labels: ChunkSeq[u32],
    // every dynamic evidence key, in byte order
    keys: ChunkSeq[u32],
    max_arity: u64,
    // host capabilities, sorted: 0 Stdout, 1 Clock, 2 Trace, 3 the
    // StdEnv library, 4 the StdFs library, 5 the StdProcess library
    // (`host::HOST_ENV`, `HOST_FS`, `HOST_PROC`)
    host: ChunkSeq[u8],
    handlers: ChunkSeq[Handler],
    clauses: ChunkSeq[HClause],
    // the handlers' and clauses' side words (types, names, keys)
    hw: ChunkSeq[u32],
}

// A queued instance (BFS of `analysis::plan`).
copy struct Queued {
    key: u32,
    base: u32,
    v0: u64,
    vn: u64,
    role: u8,
    handler: u64,
    op: u64,
    l0: u64,
    ln: u64,
}

impl Plan {
    pub fn inst(in self, i: u64) -> Inst {
        match self.insts.try_get(i) {
            Option::Some(x) => x,
            Option::None => Inst {
                key: 0,
                base: 0,
                fi: 0,
                v0: 0,
                vn: 0,
                role: 0,
                handler: 0,
                op: 0,
                c0: 0,
                cn: 0,
                l0: 0,
                ln: 0
            },
        }
    }

    // The instance of key `k`: an index + 1, or 0.
    pub fn find(in self, k: u32) -> u64 {
        w(u32_at(in self.by_key, w(k)))
    }

    pub fn vars(in self, i: Inst) -> TVars {
        let mut out = tvars_new();
        for k in 0..i.vn {
            out.keys.push(u32_at(in self.vkeys, add(i.v0, k)));
            out.vals.push(u32_at(in self.vvals, add(i.v0, k)));
        }
        out
    }

    // The callee key of call `dest` in instance `i`, or NONE32.
    pub fn callee(in self, i: Inst, dest: u64) -> u32 {
        for k in 0..i.cn {
            match self.calls.try_get(add(i.c0, k)) {
                Option::Some(c) => {
                    if c.dest == dest {
                        return c.callee;
                    }
                },
                Option::None => {},
            }
        }
        NONE32
    }

    pub fn has_label(in self, i: Inst, l: u32) -> bool {
        for k in 0..i.ln {
            if u32_at(in self.labels, add(i.l0, k)) == l {
                return true;
            }
        }
        false
    }
}

// `instance_name(base, vars)`: `base`, or `base<k=T,...>`.
pub fn instance_name(inout cx: Cx, base: u32, in vars: TVars) -> u32 {
    if vars.len() == 0 {
        return base;
    }
    let mut text = ChunkSeq::new[u8]();
    cx.write_name(base, inout text);
    text.push(60);
    for i in 0..vars.len() {
        if i > 0 {
            text.push(44);
        }
        cx.write_name(vars.key(i), inout text);
        text.push(61);
        cx.show(vars.val(i), inout text);
    }
    text.push(62);
    cx.intern(in text)
}

// `call_vars`: the type arguments of the call at span (s0, s1) to
// `callee` with explicit types `explicit` inside an instance with `outer`
// arguments, when all are concrete (else none).
fn call_vars(
    inout cx: Cx,
    callee: u32,
    s0: u64,
    s1: u64,
    in explicit: ChunkSeq[u32],
    in outer: TVars
) -> TVars {
    let mut out = tvars_new();
    let fs = cx.fn_sig(callee);
    if fs == 0 {
        return out;
    }
    let sig = cx.f.sig(wrapping_sub(fs, 1));
    let mut all_rows = true;
    for g in 0..sig.gn {
        if !cx.f.gen(add(sig.g0, g)).row {
            all_rows = false;
        }
    }
    if all_rows {
        return out;
    }
    let ov = outer.vars();
    let mut vars = tvars_new();
    let ci = cx.f.call_at(s0, s1);
    if ci < cx.f.calls.len() {
        let c = cx.f.call(ci);
        for k in 0..c.vn {
            let p = cx.f.pair(add(c.v0, k));
            let t = cx.subst(p.ty, in ov);
            vars.set(in cx.names, p.name, t);
        }
    }
    let n = if sig.gn < explicit.len() {
        sig.gn
    } else {
        explicit.len()
    };
    for g in 0..n {
        let gr = cx.f.gen(add(sig.g0, g));
        if !gr.row && vars.get(gr.name) == NONE32 {
            let t = cx.subst(u32_at(in explicit, g), in ov);
            vars.set(in cx.names, gr.name, t);
        }
    }
    for g in 0..sig.gn {
        let gr = cx.f.gen(add(sig.g0, g));
        if gr.row {
            continue;
        }
        let t = vars.get(gr.name);
        if t == NONE32 || cx.mentions_generic(t) {
            return tvars_new();
        }
        let d = cx.default_ty(t);
        out.set(in cx.names, gr.name, d);
    }
    out
}

// The labels a function's own effect row binds (`eff [l: E]`).
fn row_labels(in cx: Cx, inout out: ChunkSeq[u32], base: u32) {
    let fs = cx.fn_sig(base);
    if fs == 0 {
        return;
    }
    let sig = cx.f.sig(wrapping_sub(fs, 1));
    for i in 0..sig.en {
        let e = cx.f.eff(add(sig.e0, i));
        if e.label != NONE32 && cx.names.byte(e.label, 0) != 36 {
            sorted_insert(in cx.names, inout out, e.label);
        }
    }
}

// `host::capabilities`: the host capabilities the entry declares.
fn capabilities(inout cx: Cx, inout out: ChunkSeq[u8], entry: u32) eff [Fail[WErr]] {
    let fs = cx.fn_sig(entry);
    if fs == 0 {
        Fail::raise(werr(K_ENTRY, 0, 30));
    }
    let sig = cx.f.sig(wrapping_sub(fs, 1));
    if sig.tail != NONE32 {
        Fail::raise(werr(K_ENTRY, 0, 31));
    }
    for i in 0..sig.en {
        let e = cx.f.eff(add(sig.e0, i));
        if cx.f.is_capability(e.name) {
            continue;
        }
        // The standard I/O libraries become WASI calls (src/host.ves).
        // StdProcess has no functions on WASI (@vesper-std/process's
        // src-wasip2 refuses every start itself), so it imports nothing.
        if e.name == cx.s.ffi_env || e.name == cx.s.ffi_fs || e.name == cx.s.ffi_proc {
            let code: u8 = if e.name == cx.s.ffi_env {
                3
            } else if e.name == cx.s.ffi_fs {
                4
            } else {
                5
            };
            let mut seen = false;
            for k in 0..out.len() {
                match out.try_get(k) {
                    Option::Some(x) => {
                        if x == code {
                            seen = true;
                        }
                    },
                    Option::None => {},
                }
            }
            if !seen {
                out.push(code);
            }
            continue;
        }
        if e.name == cx.s.stdout || e.name == cx.s.clock || e.name == cx.s.trace {
            // The WASI host frames are lowered in part 2 of the port.
            Fail::raise(werr(K_NOT_PORTED, 0, 32));
        }
        Fail::raise(werr(K_ENTRY, 0, 33));
    }
}

// The names of `ir` function `fi`'s first `n` parameters equal
// `caps[c0..c0+n]` (`check_prefix`).
fn check_prefix(in cx: Cx, fi: u64, in caps: ChunkSeq[u32]) eff [Fail[WErr]] {
    let f = cx.ir.info(fi);
    if f.pn < caps.len() {
        Fail::raise(werr(K_INVALID, 0, 34));
    }
    for i in 0..caps.len() {
        if cx.ir.param(add(f.p0, i)).name != u32_at(in caps, i) {
            Fail::raise(werr(K_INVALID, 0, 35));
        }
    }
}

// The alias of `name` in an instruction's alias pairs `ops[a..a+2n]`
// (closure and handler `aliases`), or NONE32.
pub fn alias_of(in cx: Cx, a: u64, n: u64, name: u32) -> u32 {
    for i in 0..n {
        let at = add(a, wrapping_mul(i, 2));
        if n32(cx.ir.word(at)) == name {
            return n32(cx.ir.word(inc(at)));
        }
    }
    NONE32
}

// `analysis::captures`: the free names (`free[f0..f0+fc]`, sorted) that
// alias a visible local of the enclosing function.
pub fn captures(in cx: Cx, f0: u64, fc: u64, a: u64, n: u64, outer: FnInfo) -> ChunkSeq[u32] {
    let mut out = ChunkSeq::new[u32]();
    for i in 0..fc {
        let name = cx.f.free_at(add(f0, i));
        let s = alias_of(in cx, a, n, name);
        if s != NONE32 && cx.ir.has_local(outer, s) {
            out.push(name);
        }
    }
    out
}

// The closure facts of a `closure` instruction at `ops[at]`: its nested
// function name, and the aliases' range (ops index, pair count).
pub fn closure_operands(in cx: Cx, at: u64) -> (u64, u64, u64) {
    // pool index, aliases n, n pairs, moves n, n pairs
    let pool = cx.ir.word(at);
    let n = cx.ir.word(inc(at));
    (pool, add(at, 2), n)
}

pub fn empty_plan() -> Plan {
    Plan {
        insts: ChunkSeq::new[Inst](),
        vkeys: ChunkSeq::new[u32](),
        vvals: ChunkSeq::new[u32](),
        by_key: ChunkSeq::new[u32](),
        calls: ChunkSeq::new[CallTarget](),
        labels: ChunkSeq::new[u32](),
        keys: ChunkSeq::new[u32](),
        max_arity: 0,
        host: ChunkSeq::new[u8](),
        handlers: ChunkSeq::new[Handler](),
        clauses: ChunkSeq::new[HClause](),
        hw: ChunkSeq::new[u32](),
    }
}

pub fn plan(inout cx: Cx) -> Plan eff [Fail[WErr]] {
    let entry = cx.f.entry;
    let mut p_insts = ChunkSeq::new[Inst]();
    let mut p_vkeys = ChunkSeq::new[u32]();
    let mut p_vvals = ChunkSeq::new[u32]();
    let mut p_by_key = ChunkSeq::new[u32]();
    let mut p_calls = ChunkSeq::new[CallTarget]();
    let mut p_labels = ChunkSeq::new[u32]();
    let mut p_keys = ChunkSeq::new[u32]();
    let mut p_max_arity: u64 = 0;
    let mut p_host = ChunkSeq::new[u8]();
    let mut p_handlers = ChunkSeq::new[Handler]();
    let mut p_clauses = ChunkSeq::new[HClause]();
    let mut p_hw = ChunkSeq::new[u32]();
    capabilities(inout cx, inout p_host, entry);
    let mut arity: u64 = 0;
    for d in 0..cx.f.decls.len() {
        let decl = cx.f.decl(d);
        for o in 0..decl.on {
            let sig = cx.f.sig(cx.f.op(add(decl.o0, o)).sig);
            if sig.pn > arity {
                arity = sig.pn;
            }
        }
    }
    if arity < 1 {
        arity = 1;
    }
    p_max_arity = arity;
    // the queue: rows, their vars and labels in side tables
    let mut queue = ChunkSeq::new[Queued]();
    let mut qkeys = ChunkSeq::new[u32]();
    let mut qvals = ChunkSeq::new[u32]();
    let mut qlabels = ChunkSeq::new[u32]();
    let mut l = ChunkSeq::new[u32]();
    row_labels(in cx, inout l, entry);
    let l0 = qlabels.len();
    for i in 0..l.len() {
        qlabels.push(u32_at(in l, i));
    }
    queue
        .push(
            Queued {
                key: entry,
                base: entry,
                v0: 0,
                vn: 0,
                role: R_ORDINARY,
                handler: 0,
                op: 0,
                l0: l0,
                ln: l.len()
            }
        );
    let mut seen = ChunkSeq::new[u32]();
    p_insts.reserve(8192);
    p_vkeys.reserve(32768);
    p_vvals.reserve(32768);
    p_by_key.reserve(262144);
    p_calls.reserve(262144);
    p_labels.reserve(16384);
    p_keys.reserve(8192);
    p_host.reserve(4096);
    p_handlers.reserve(2048);
    p_clauses.reserve(4096);
    p_hw.reserve(8192);
    queue.reserve(262144);
    qkeys.reserve(131072);
    qvals.reserve(131072);
    qlabels.reserve(131072);
    seen.reserve(262144);
    let max_names = add(cx.names.len(), 32768);
    let max_text = add(cx.names.text_len(), 524288);
    cx.names.reserve_names(max_names, max_text);
    let max_nodes = add(cx.types.nodes.len(), 16384);
    let max_items = add(cx.types.items_len(), 32768);
    let max_rows = add(cx.types.rows.len(), 8192);
    let max_effs = add(cx.types.effs_len(), 16384);
    cx.types.reserve_types(max_nodes, max_items, max_rows, max_effs);
    let mut scratch = ChunkSeq::new[u8]();
    scratch.reserve(33554432);
    let scratch_end = stage2_heap_mark();
    let scratch_base = wrapping_sub(scratch_end, 33554432);
    let mut perm = stage2_heap_swap(scratch_base);
    let mut scratch_mark = scratch_base;
    let mut head: u64 = 0;
    loop {
        if head >= queue.len() {
            break;
        }
        let q = match queue.try_get(head) {
            Option::Some(x) => x,
            Option::None => Queued {
                key: 0,
                base: 0,
                v0: 0,
                vn: 0,
                role: 0,
                handler: 0,
                op: 0,
                l0: 0,
                ln: 0
            },
        };
        head = inc(head);
        if u32_at(in seen, w(q.key)) != 0 {
            continue;
        }
        // m moved down for bisect2
        let n_mask = cx.names.mask_val();
        let n_tmask = cx.types.t_mask();
        let n_rmask = cx.types.r_mask();
        set_by_symbol(inout seen, q.key, 1);
        if p_insts.len() >= cx.f.max_functions {
            Fail::raise(werr(K_LIMIT, 0, 40));
        }
        let found = cx.ir.find(q.base);
        if found == 0 {
            Fail::raise(werr_syms(K_UNSUPPORTED, U_EXTERNAL_FUNCTION, 41, 0, q.base));
        }
        let fi = wrapping_sub(found, 1);
        let info = cx.ir.info(fi);
        let mut vars = tvars_new();
        for k in 0..q.vn {
            vars.keys.push(u32_at(in qkeys, add(q.v0, k)));
            vars.vals.push(u32_at(in qvals, add(q.v0, k)));
        }
        let v0 = p_vkeys.len();
        for k in 0..vars.len() {
            p_vkeys.push(vars.key(k));
            p_vvals.push(vars.val(k));
        }
        let pl0 = p_labels.len();
        for k in 0..q.ln {
            p_labels.push(u32_at(in qlabels, add(q.l0, k)));
        }
        let c0 = p_calls.len();
        let row = cx.ir.p.function(fi);
        for bi in 0..row.bc {
            let blk = cx.ir.p.block(add(row.b0, bi));
            for ii in 0..blk.ic {
                let ins = cx.ir.p.inst(add(blk.i0, ii));
                if ins.op == Op::Call {
                    let callee = n32(cx.ir.word(ins.a));
                    if cx.ir.find(callee) == 0 {
                        continue;
                    }
                    // callee, args (n, n x 4), types (n, ...), capability
                    let na = cx.ir.word(inc(ins.a));
                    let tat = add(add(ins.a, 2), wrapping_mul(na, 4));
                    let nt = cx.ir.word(tat);
                    let mut explicit = ChunkSeq::new[u32]();
                    for k in 0..nt {
                        explicit.push(n32(cx.ir.word(add(inc(tat), k))));
                    }
                    let cv = call_vars(inout cx, callee, ins.s0, ins.s1, in explicit, in vars);
                    let key = instance_name(inout cx, callee, in cv);
                    let s_pc = stage2_heap_swap(perm);
                    p_calls.push(CallTarget { dest: widen_u64(ins.dest), callee: key });
                    perm = stage2_heap_swap(s_pc);
                    let mut ls = ChunkSeq::new[u32]();
                    row_labels(in cx, inout ls, callee);
                    let qv0 = qkeys.len();
                    for k in 0..cv.len() {
                        qkeys.push(cv.key(k));
                        qvals.push(cv.val(k));
                    }
                    let ql0 = qlabels.len();
                    for k in 0..ls.len() {
                        qlabels.push(u32_at(in ls, k));
                    }
                    let s_q = stage2_heap_swap(perm);
                    queue
                        .push(
                            Queued {
                                key: key,
                                base: callee,
                                v0: qv0,
                                vn: cv.len(),
                                role: R_ORDINARY,
                                handler: 0,
                                op: 0,
                                l0: ql0,
                                ln: ls.len()
                            }
                        );
                    perm = stage2_heap_swap(s_q);
                } else if ins.op == Op::Closure {
                    let (pool, aa, an) = closure_operands(in cx, ins.a);
                    let fact = cx.f.expr(pool);
                    if fact.kind != ExprFactKind::Closure {
                        Fail::raise(werr(K_INVALID, 0, 42));
                    }
                    let caps = captures(in cx, fact.f0, fact.fc, aa, an, info);
                    let nf = cx.ir.find(fact.fn_);
                    if nf == 0 {
                        Fail::raise(werr(K_INVALID, 0, 43));
                    }
                    check_prefix(in cx, wrapping_sub(nf, 1), in caps);
                    let key = instance_name(inout cx, fact.fn_, in vars);
                    let qv0 = qkeys.len();
                    for k in 0..vars.len() {
                        qkeys.push(vars.key(k));
                        qvals.push(vars.val(k));
                    }
                    let ql0 = qlabels.len();
                    for k in 0..q.ln {
                        qlabels.push(u32_at(in qlabels, add(q.l0, k)));
                    }
                    let s_q = stage2_heap_swap(perm);
                    queue
                        .push(
                            Queued {
                                key: key,
                                base: fact.fn_,
                                v0: qv0,
                                vn: vars.len(),
                                role: R_ORDINARY,
                                handler: 0,
                                op: 0,
                                l0: ql0,
                                ln: q.ln
                            }
                        );
                    perm = stage2_heap_swap(s_q);
                } else if ins.op == Op::Read {
                    let root = n32(cx.ir.word(ins.a));
                    let path = cx.ir.word(inc(ins.a));
                    if path == 0 && !cx.ir.has_local(info, root) && cx.ir.find(root) != 0 {
                        let mut ls = ChunkSeq::new[u32]();
                        row_labels(in cx, inout ls, root);
                        let ql0 = qlabels.len();
                        for k in 0..ls.len() {
                            qlabels.push(u32_at(in ls, k));
                        }
                        let s_q = stage2_heap_swap(perm);
                        queue
                            .push(
                                Queued {
                                    key: root,
                                    base: root,
                                    v0: 0,
                                    vn: 0,
                                    role: R_ORDINARY,
                                    handler: 0,
                                    op: 0,
                                    l0: ql0,
                                    ln: ls.len()
                                }
                            );
                        perm = stage2_heap_swap(s_q);
                    }
                } else if ins.op == Op::Handle {
                    let id = p_handlers.len();
                    let s_h = stage2_heap_swap(perm);
                    let h = handler(
                        inout cx,
                        inout p_clauses,
                        inout p_hw,
                        q.key,
                        info,
                        in vars,
                        widen_u64(ins.dest),
                        ins.a
                    );
                    for r in 0..wrapping_add(2, h.cn) {
                        let (key, base, role, op) = if r == 0 {
                            (h.body, h.body_base, R_HANDLER_BODY, 0)
                        } else if r == 1 {
                            (h.ret, h.ret_base, R_RETURN_CLAUSE, 0)
                        } else {
                            let c = match p_clauses.try_get(add(h.c0, wrapping_sub(r, 2))) {
                                Option::Some(cc) => cc,
                                Option::None => clause0(),
                            };
                            (c.function, c.base, R_OP_CLAUSE, c.op)
                        };
                        let qv0 = qkeys.len();
                        for k in 0..vars.len() {
                            qkeys.push(vars.key(k));
                            qvals.push(vars.val(k));
                        }
                        let ql0 = qlabels.len();
                        for k in 0..q.ln {
                            qlabels.push(u32_at(in qlabels, add(q.l0, k)));
                        }
                        if r == 0 && h.label != NONE32 {
                            let mut seen_label = false;
                            for k in ql0..qlabels.len() {
                                if u32_at(in qlabels, k) == h.label {
                                    seen_label = true;
                                }
                            }
                            if !seen_label {
                                qlabels.push(h.label);
                            }
                        }
                        queue
                            .push(
                                Queued {
                                    key: key,
                                    base: base,
                                    v0: qv0,
                                    vn: vars.len(),
                                    role: role,
                                    handler: id,
                                    op: op,
                                    l0: ql0,
                                    ln: wrapping_sub(qlabels.len(), ql0)
                                }
                            );
                    }
                    for k in 0..h.en {
                        sorted_insert(in cx.names, inout p_keys, u32_at(in p_hw, add(h.e0, k)));
                    }
                    p_handlers.push(h);
                    perm = stage2_heap_swap(s_h);
                }
            }
        }
        let i = p_insts.len();
        let s_pi = stage2_heap_swap(perm);
        p_insts
            .push(
                Inst {
                    key: q.key,
                    base: q.base,
                    fi: fi,
                    v0: v0,
                    vn: vars.len(),
                    role: q.role,
                    handler: q.handler,
                    op: q.op,
                    c0: c0,
                    cn: wrapping_sub(p_calls.len(), c0),
                    l0: pl0,
                    ln: q.ln
                }
            );
        perm = stage2_heap_swap(s_pi);
        set_by_symbol(inout p_by_key, q.key, n32(inc(i)));
        if scratch_end != 0 && stage2_heap_mark() >= scratch_end {
            Fail::raise(werr(K_LIMIT, 96, stage2_heap_mark()));
        }
        if cx.names.mask_val() == n_mask
            && cx.names.len() < max_names
            && cx.names.text_len() < max_text
            && cx.types.t_mask() == n_tmask
            && cx.types.r_mask() == n_rmask
            && cx.types.nodes.len() < max_nodes
            && cx.types.items_len() < max_items
            && cx.types.rows.len() < max_rows
            && cx.types.effs_len() < max_effs
            && p_insts.len() <= 8000
            && p_vkeys.len() <= 32000
            && p_vvals.len() <= 32000
            && p_by_key.len() <= 260000
            && p_calls.len() <= 260000
            && p_labels.len() <= 16000
            && p_keys.len() <= 8000
            && p_host.len() <= 4000
            && p_handlers.len() <= 2000
            && p_clauses.len() <= 4000
            && p_hw.len() <= 8000
            && queue.len() <= 260000
            && qkeys.len() <= 130000
            && qvals.len() <= 130000
            && qlabels.len() <= 130000
            && seen.len() <= 260000 {
            let mut dcx = dummy_cx(cx.k, cx.s);
            swap(inout cx, inout dcx);
            let (fcx0, next_perm) = rebuild_cx(sink dcx, scratch_mark, perm);
            let mut fcx = fcx0;
            perm = next_perm;
            swap(inout cx, inout fcx);
        } else {
            scratch_mark = stage2_heap_mark();
        }
    }
    let _ = stage2_heap_swap(perm);
    Plan {
        insts: p_insts,
        vkeys: p_vkeys,
        vvals: p_vvals,
        by_key: p_by_key,
        calls: p_calls,
        labels: p_labels,
        keys: p_keys,
        max_arity: p_max_arity,
        host: p_host,
        handlers: p_handlers,
        clauses: p_clauses,
        hw: p_hw,
    }
}

fn dummy_cx(k: Known, s: Syms) -> Cx {
    let mut dn = names_new();
    let dt = types_new(inout dn);
    let dw = world_new(k);
    let df = empty_facts(0, 1, 1, 1);
    let di = ir_new(program_new());
    Cx {
        names: dn,
        types: dt,
        world: dw,
        k: k,
        f: df,
        ir: di,
        s: s,
    }
}

fn rebuild_cx(sink dcx: Cx, d_mark: u64, d_perm: u64) -> (Cx, u64) {
    let Cx {
        names,
        types,
        world,
        k,
        f,
        ir,
        s,
    } = dcx;
    stage2_heap_reset(d_mark);
    let s_rb = stage2_heap_swap(d_perm);
    let fresh = Cx {
        names: names.clone_in_heap(),
        types: types.clone_in_heap(),
        world: world,
        k: k,
        f: f,
        ir: ir,
        s: s,
    };
    let next_perm = stage2_heap_swap(s_rb);
    (fresh, next_perm)
}

// ----- handlers --------------------------------------------------------------

// One operation clause of a handler (`analysis::OpClause`).
pub copy struct HClause {
    // the operation's index in its effect, and its signature (facts)
    op: u64,
    sig: u64,
    // the clause instance and its IR function
    function: u32,
    base: u32,
    mode: u8,
    // the clause's patterns: hops[pats..], npats of them
    pats: u64,
    npats: u64,
    // the continuation's name, or NONE32
    resume: u32,
    // captures: hw[k0..k0+kn]
    k0: u64,
    kn: u64,
    // the operation's parameter types under the effect's arguments:
    // hw[t0..t0+n], n the signature's parameter count
    t0: u64,
}

// One `handle` expression (`analysis::Handler`).
pub copy struct Handler {
    // the instance containing it and the instruction's value
    site: u32,
    dest: u64,
    label: u32,
    ename: u32,
    // evidence keys, in install order: hw[e0..e0+en]
    e0: u64,
    en: u64,
    // the state's type, or NONE32
    state: u32,
    body: u32,
    body_base: u32,
    body_type: u32,
    ret: u32,
    ret_base: u32,
    // the return clause's first pattern: hops[ret_pat]
    ret_pat: u64,
    // the return clause's captures: hw[rk0..rk0+rkn]
    rk0: u64,
    rkn: u64,
    // clauses[c0..c0+cn]
    c0: u64,
    cn: u64,
    // alias pairs: ir words alias_at.., alias_n pairs
    alias_at: u64,
    alias_n: u64,
}

fn clause0() -> HClause {
    HClause {
        op: 0,
        sig: 0,
        function: 0,
        base: 0,
        mode: 0,
        pats: 0,
        npats: 0,
        resume: NONE32,
        k0: 0,
        kn: 0,
        t0: 0
    }
}

fn handler0() -> Handler {
    Handler {
        site: 0,
        dest: 0,
        label: NONE32,
        ename: 0,
        e0: 0,
        en: 0,
        state: NONE32,
        body: 0,
        body_base: 0,
        body_type: 0,
        ret: 0,
        ret_base: 0,
        ret_pat: 0,
        rk0: 0,
        rkn: 0,
        c0: 0,
        cn: 0,
        alias_at: 0,
        alias_n: 0
    }
}

impl Plan {
    pub fn handler(in self, i: u64) -> Handler {
        match self.handlers.try_get(i) {
            Option::Some(h) => h,
            Option::None => handler0(),
        }
    }

    pub fn clause(in self, i: u64) -> HClause {
        match self.clauses.try_get(i) {
            Option::Some(c) => c,
            Option::None => clause0(),
        }
    }

    // The handler of the `handle` instruction `dest` in instance `site`
    // (`handler_at`), or NONE64.
    pub fn handler_at(in self, site: u32, dest: u64) -> u64 {
        for i in 0..self.handlers.len() {
            let h = self.handler(i);
            if h.site == site && h.dest == dest {
                return i;
            }
        }
        NONE64
    }

    // The clause of operation `op` in handler `h`.
    pub fn clause_of(in self, h: u64, op: u64) -> HClause {
        let hd = self.handler(h);
        for k in 0..hd.cn {
            let c = self.clause(add(hd.c0, k));
            if c.op == op {
                return c;
            }
        }
        clause0()
    }

    pub fn word(in self, i: u64) -> u32 {
        u32_at(in self.hw, i)
    }
}

fn hop(in cx: Cx, i: u64) -> u64 {
    u64_at(in cx.f.hops, i)
}

// `analysis::captures` of the names `hops[at..at+n]`.
fn captures_h(in cx: Cx, at: u64, n: u64, aa: u64, an: u64, outer: FnInfo) -> ChunkSeq[u32] {
    let mut out = ChunkSeq::new[u32]();
    for i in 0..n {
        let name = n32(hop(in cx, add(at, i)));
        let s = alias_of(in cx, aa, an, name);
        if s != NONE32 && cx.ir.has_local(outer, s) {
            out.push(name);
        }
    }
    out
}

// Whether `t` is open (`numeric::open`): an inferred part, a row or a
// function type.
fn open_type(in cx: Cx, t: u32) -> bool {
    let n = cx.types.node(t);
    if n.kind == TyKind::Infer || n.kind == TyKind::Row || n.kind == TyKind::Fn {
        return true;
    }
    if n.kind == TyKind::Named || n.kind == TyKind::Tuple {
        for i in 0..w(n.n) {
            if open_type(in cx, cx.types.arg(t, i)) {
                return true;
            }
        }
    }
    false
}

// `numeric::instance_key(name, args)`: `$effect:E[T, ..]`, or NONE32
// when there are no arguments or one is open.
pub fn instance_key(inout cx: Cx, name: u32, in args: ChunkSeq[u32]) -> u32 {
    if args.len() == 0 {
        return NONE32;
    }
    for i in 0..args.len() {
        if open_type(in cx, u32_at(in args, i)) {
            return NONE32;
        }
    }
    let mut text = ChunkSeq::new[u8]();
    append_ascii(inout text, "$effect:");
    cx.write_name(name, inout text);
    text.push(91);
    for i in 0..args.len() {
        if i > 0 {
            text.push(44);
            text.push(32);
        }
        let d = cx.default_ty(u32_at(in args, i));
        cx.show(d, inout text);
    }
    text.push(93);
    cx.intern(in text)
}

// `$effect:E` or `$label:l`.
pub fn prefixed_key(inout cx: Cx, label: bool, name: u32) -> u32 {
    let mut text = ChunkSeq::new[u8]();
    if label {
        append_ascii(inout text, "$label:");
    } else {
        append_ascii(inout text, "$effect:");
    }
    cx.write_name(name, inout text);
    cx.intern(in text)
}

fn append_ascii(inout out: ChunkSeq[u8], in s: Str) {
    let b = s.as_bytes();
    for i in 0..b.len() {
        match b.try_get(i) {
            Option::Some(x) => out.push(x),
            Option::None => {},
        }
    }
}

// `analysis::handler`: the handler of the `handle` instruction with
// operands at ir word `a` and value `dest`, in instance `site` (IR
// function `outer` under `vars`). Pushes its clauses and side words.
fn handler(
    inout cx: Cx,
    inout p_clauses: ChunkSeq[HClause],
    inout p_hw: ChunkSeq[u32],
    site: u32,
    outer: FnInfo,
    in vars: TVars,
    dest: u64,
    a: u64
) -> Handler eff [Fail[WErr]] {
    if cx.f.stack_switching {
        // WasmFX handlers are lowered in a later part of the port.
        Fail::raise(werr(K_NOT_PORTED, 0, 44));
    }
    // has state, state value, pool, aliases (n, pairs), moves
    let has_state = cx.ir.word(a);
    let sv = cx.ir.word(inc(a));
    let pool = cx.ir.word(add(a, 2));
    let an = cx.ir.word(add(a, 3));
    let aa = add(a, 4);
    let fact = cx.f.expr(pool);
    if fact.kind != ExprFactKind::Handler {
        Fail::raise(werr(K_INVALID, 0, 45));
    }
    let ov = vars.vars();
    let mut h = fact.h0;
    let lw = hop(in cx, h);
    let label = if lw == 0 {
        NONE32
    } else {
        n32(wrapping_sub(lw, 1))
    };
    let ename = n32(hop(in cx, inc(h)));
    let na = hop(in cx, add(h, 2));
    let mut args = ChunkSeq::new[u32]();
    let mut generic = false;
    for i in 0..na {
        let t = cx.subst(n32(hop(in cx, add(add(h, 3), i))), in ov);
        if cx.mentions_generic(t) {
            generic = true;
        }
        args.push(t);
    }
    h = add(add(h, 3), na);
    if generic {
        Fail::raise(werr(K_UNSUPPORTED, U_GENERIC_EFFECT_INSTANCE, 46));
    }
    let di = cx.f.decl_of(ename);
    if di == 0 {
        Fail::raise(werr(K_INVALID, 0, 47));
    }
    let decl = cx.f.decl(wrapping_sub(di, 1));
    let mut dvars = tvars_new();
    for i in 0..decl.gn {
        if i < args.len() {
            dvars.set(in cx.names, u32_at(in cx.f.gsyms, add(decl.g0, i)), u32_at(in args, i));
        }
    }
    let dv = dvars.vars();
    let stateful = hop(in cx, h) != 0;
    let body_fn = n32(hop(in cx, inc(h)));
    let ret_fn = n32(hop(in cx, add(h, 2)));
    h = add(h, 3);
    let bf = cx.ir.find(body_fn);
    let rf = cx.ir.find(ret_fn);
    if bf == 0 || rf == 0 {
        Fail::raise(werr(K_INVALID, 0, 48));
    }
    let state = if stateful {
        if has_state == 0 {
            Fail::raise(werr(K_INVALID, 0, 49));
        }
        let t = cx.ir.value_type(outer, sv);
        if t == NONE32 {
            Fail::raise(werr(K_INVALID, 0, 50));
        }
        cx.subst(t, in ov)
    } else {
        NONE32
    };
    // the return clause: patterns, then free names
    let np = hop(in cx, h);
    let ret_pat = inc(h);
    let mut q = inc(h);
    for i in 0..np {
        q = pattern_end(in cx.f.hops, q, 0);
    }
    let nfree = hop(in cx, q);
    let rcaps = captures_h(in cx, inc(q), nfree, aa, an, outer);
    q = add(inc(q), nfree);
    check_prefix(in cx, wrapping_sub(rf, 1), in rcaps);
    let rk0 = p_hw.len();
    for i in 0..rcaps.len() {
        p_hw.push(u32_at(in rcaps, i));
    }
    let nc = hop(in cx, q);
    q = inc(q);
    let c0 = p_clauses.len();
    for k in 0..nc {
        let cname = n32(hop(in cx, q));
        let cfn = n32(hop(in cx, inc(q)));
        let npats = hop(in cx, add(q, 2));
        let pats = add(q, 3);
        let mut e = pats;
        let mut pat_at = ChunkSeq::new[u64]();
        for i in 0..npats {
            pat_at.push(e);
            e = pattern_end(in cx.f.hops, e, 0);
        }
        let cfree = hop(in cx, e);
        let free_at = inc(e);
        q = add(inc(e), cfree);
        let mut op = NONE64;
        for o in 0..decl.on {
            if cx.f.op(add(decl.o0, o)).name == cname {
                op = o;
                break;
            }
        }
        if op == NONE64 {
            Fail::raise(werr(K_INVALID, 0, 51));
        }
        let od = cx.f.op(add(decl.o0, op));
        let sig = cx.f.sig(od.sig);
        let cf = cx.ir.find(cfn);
        if cf == 0 {
            Fail::raise(werr(K_INVALID, 0, 52));
        }
        let n = sig.pn;
        let k_index = if stateful {
            inc(n)
        } else {
            n
        };
        let mut resume = NONE32;
        if k_index < npats {
            let at = u64_at(in pat_at, k_index);
            if hop(in cx, at) == Pat::Bind {
                resume = n32(hop(in cx, add(at, 3)));
            }
        }
        let caps = captures_h(in cx, free_at, cfree, aa, an, outer);
        check_prefix(in cx, wrapping_sub(cf, 1), in caps);
        let mode = clause_mode(in cx, wrapping_sub(cf, 1), resume);
        // An `inout` operation argument is a cell copied back when the
        // operation returns: only a clause that resumes in tail position
        // makes all its writes before that.
        for i in 0..n {
            if cx.f.param(add(sig.p0, i)).pass != TyPass::Inout {
                continue;
            }
            let bound = if i < npats {
                let kind = hop(in cx, u64_at(in pat_at, i));
                kind == Pat::Bind || kind == Pat::Wild
            } else {
                false
            };
            if mode != M_TAIL || !bound {
                Fail::raise(werr(K_UNSUPPORTED, U_INOUT_EFFECT_ARGUMENT, 53));
            }
        }
        if mode == M_OTHER {
            // A clause that resumes other than in tail position.
            Fail::raise(werr(K_NOT_PORTED, 0, 54));
        }
        let k0 = p_hw.len();
        for i in 0..caps.len() {
            p_hw.push(u32_at(in caps, i));
        }
        let t0 = p_hw.len();
        for i in 0..n {
            let t = cx.subst(cx.f.param(add(sig.p0, i)).ty, in dv);
            p_hw.push(t);
        }
        let function = instance_name(inout cx, cfn, in vars);
        p_clauses
            .push(
                HClause {
                    op: op,
                    sig: od.sig,
                    function: function,
                    base: cfn,
                    mode: mode,
                    pats: pats,
                    npats: npats,
                    resume: resume,
                    k0: k0,
                    kn: caps.len(),
                    t0: t0
                }
            );
    }
    if np == 0 {
        Fail::raise(werr(K_INVALID, 0, 55));
    }
    // `handler_keys`
    let e0 = p_hw.len();
    let by_name = prefixed_key(inout cx, false, ename);
    p_hw.push(by_name);
    let exact = instance_key(inout cx, ename, in args);
    if exact != NONE32 {
        p_hw.push(exact);
    }
    if label != NONE32 {
        let lk = prefixed_key(inout cx, true, label);
        p_hw.push(lk);
    }
    let en = wrapping_sub(p_hw.len(), e0);
    let body_type = cx.subst(cx.ir.info(wrapping_sub(bf, 1)).result, in ov);
    let body = instance_name(inout cx, body_fn, in vars);
    let ret = instance_name(inout cx, ret_fn, in vars);
    Handler {
        site: site,
        dest: dest,
        label: label,
        ename: ename,
        e0: e0,
        en: en,
        state: state,
        body: body,
        body_base: body_fn,
        body_type: body_type,
        ret: ret,
        ret_base: ret_fn,
        ret_pat: ret_pat,
        rk0: rk0,
        rkn: rcaps.len(),
        c0: c0,
        cn: wrapping_sub(p_clauses.len(), c0),
        alias_at: aa,
        alias_n: an
    }
}

// The values instruction `ins` reads (`analysis::operands`).
pub fn inst_operands(in cx: Cx, op: u8, a: u64) -> ChunkSeq[u64] {
    let mut out = ChunkSeq::new[u64]();
    if op == Op::Bind || op == Op::Exit || op == Op::Project || op == Op::Try {
        out.push(cx.ir.word(a));
    } else if op == Op::Write {
        out.push(cx.ir.word(add(a, 2)));
    } else if op == Op::Unary {
        out.push(cx.ir.word(inc(a)));
    } else if op == Op::Binary {
        out.push(cx.ir.word(inc(a)));
        out.push(cx.ir.word(add(a, 2)));
    } else if op == Op::Index {
        out.push(cx.ir.word(a));
        out.push(cx.ir.word(inc(a)));
    } else if op == Op::Tuple || op == Op::Vector {
        let at = if op == Op::Vector {
            inc(a)
        } else {
            a
        };
        let n = cx.ir.word(at);
        for k in 0..n {
            out.push(cx.ir.word(add(inc(at), k)));
        }
    } else if op == Op::Data {
        let n = cx.ir.word(inc(a));
        for k in 0..n {
            out.push(cx.ir.word(add(add(a, 3), wrapping_mul(2, k))));
        }
    } else if op == Op::Call
        || op == Op::Tiled
        || op == Op::Seq
        || op == Op::Fip
        || op == Op::Indirect {
        if op == Op::Indirect {
            out.push(cx.ir.word(a));
        }
        // callee/pool, then args: n, n x (pass, value, root, path)
        let n = cx.ir.word(inc(a));
        for k in 0..n {
            out.push(cx.ir.word(add(add(a, 3), wrapping_mul(4, k))));
        }
    } else if op == Op::Handle {
        if cx.ir.word(a) != 0 {
            out.push(cx.ir.word(inc(a)));
        }
    }
    out
}

fn contains64(in set: ChunkSeq[u64], x: u64) -> bool {
    for i in 0..set.len() {
        if u64_at(in set, i) == x {
            return true;
        }
    }
    false
}

// `flows_to_return`: whether `value`, defined last in block `b` of IR
// function `fi`, reaches a `Return` unchanged.
pub fn flows_to_return(in cx: Cx, fi: u64, b: u64, value: u64, depth: u64) -> bool {
    if depth > 64 {
        return false;
    }
    let row = cx.ir.p.function(fi);
    let blk = cx.ir.p.block(add(row.b0, b));
    if blk.term == Term::Return {
        return cx.ir.word(blk.ta) == value;
    }
    if blk.term != Term::Jump {
        return false;
    }
    let t = cx.ir.word(blk.ta);
    let n = cx.ir.word(inc(blk.ta));
    let mut pos = NONE64;
    let mut count: u64 = 0;
    for k in 0..n {
        if cx.ir.word(add(add(blk.ta, 2), k)) == value {
            if pos == NONE64 {
                pos = k;
            }
            count = inc(count);
        }
    }
    if pos == NONE64 || count != 1 {
        return false;
    }
    let target = cx.ir.p.block(add(row.b0, t));
    if target.ic != 0 {
        return false;
    }
    let (p0, pn) = cx.ir.block_params(fi, t);
    if pos >= pn {
        return false;
    }
    flows_to_return(in cx, fi, t, cx.ir.word(add(p0, pos)), inc(depth))
}

// The blocks a terminator can branch to other than by a jump (a branch's
// or a match's targets) include `b`.
fn branches_to(in cx: Cx, blk_term: u8, ta: u64, b: u64) -> bool {
    if blk_term == Term::Branch {
        return cx.ir.word(inc(ta)) == b || cx.ir.word(add(ta, 2)) == b;
    }
    if blk_term == Term::Match {
        let n = cx.ir.word(inc(ta));
        let mut at = add(ta, 2);
        for k in 0..n {
            at = pattern_end(in cx.ir.p.ops, at, 0);
            if cx.ir.word(at) == b {
                return true;
            }
            at = inc(at);
        }
    }
    false
}

// `resumed_value`: whether `value` returned from block `b` is (through
// join parameters fed only by jumps) a tail resumption result.
fn resumed_value(
    in cx: Cx,
    fi: u64,
    b: u64,
    value: u64,
    in tail: ChunkSeq[u64],
    depth: u64
) -> bool {
    if contains64(in tail, value) {
        return true;
    }
    if depth > 64 {
        return false;
    }
    let (p0, pn) = cx.ir.block_params(fi, b);
    let mut pos = NONE64;
    for k in 0..pn {
        if cx.ir.word(add(p0, k)) == value {
            pos = k;
            break;
        }
    }
    if pos == NONE64 {
        return false;
    }
    let row = cx.ir.p.function(fi);
    let mut any = false;
    for pi in 0..row.bc {
        let pred = cx.ir.p.block(add(row.b0, pi));
        if pred.term == Term::Jump && cx.ir.word(pred.ta) == b {
            any = true;
            let arg = cx.ir.word(add(add(pred.ta, 2), pos));
            if !resumed_value(in cx, fi, pi, arg, in tail, inc(depth)) {
                return false;
            }
        }
        if branches_to(in cx, pred.term, pred.ta, b) {
            return false;
        }
    }
    any
}

// `analysis::clause_mode` of the clause in IR function `fi` whose
// continuation is `resume` (NONE32: none).
fn clause_mode(in cx: Cx, fi: u64, resume: u32) -> u8 eff [Fail[WErr]] {
    if resume == NONE32 {
        return M_ABORT;
    }
    let row = cx.ir.p.function(fi);
    let mut reads = ChunkSeq::new[u64]();
    for bi in 0..row.bc {
        let blk = cx.ir.p.block(add(row.b0, bi));
        for ii in 0..blk.ic {
            let ins = cx.ir.p.inst(add(blk.i0, ii));
            if ins.op == Op::Read && n32(cx.ir.word(ins.a)) == resume {
                if cx.ir.word(inc(ins.a)) != 0 {
                    Fail::raise(werr(K_UNSUPPORTED, U_FIRST_CLASS_CONTINUATION, 56));
                }
                reads.push(widen_u64(ins.dest));
            }
        }
    }
    // Every read of the continuation must be the callee of an `Indirect`.
    let mut calls = ChunkSeq::new[u64]();
    for bi in 0..row.bc {
        let blk = cx.ir.p.block(add(row.b0, bi));
        for ii in 0..blk.ic {
            let ins = cx.ir.p.inst(add(blk.i0, ii));
            let a = ins.a;
            if ins.op == Op::Indirect && contains64(in reads, cx.ir.word(a)) {
                let n = cx.ir.word(inc(a));
                for k in 0..n {
                    if contains64(in reads, cx.ir.word(add(add(a, 3), wrapping_mul(4, k)))) {
                        Fail::raise(werr(K_UNSUPPORTED, U_FIRST_CLASS_CONTINUATION, 57));
                    }
                }
                calls.push(widen_u64(ins.dest));
            } else if ins.op == Op::Closure || ins.op == Op::Handle {
                // A closure or nested handler that names the continuation
                // captures it as a value.
                let (pool, pa, pn) = if ins.op == Op::Closure {
                    (cx.ir.word(a), add(a, 2), cx.ir.word(inc(a)))
                } else {
                    (cx.ir.word(add(a, 2)), add(a, 4), cx.ir.word(add(a, 3)))
                };
                let fact = cx.f.expr(pool);
                for i in 0..fact.fc {
                    let name = cx.f.free_at(add(fact.f0, i));
                    if name == resume || alias_of(in cx, pa, pn, name) == resume {
                        Fail::raise(werr(K_UNSUPPORTED, U_FIRST_CLASS_CONTINUATION, 58));
                    }
                }
            } else {
                let used = inst_operands(in cx, ins.op, a);
                for k in 0..used.len() {
                    if contains64(in reads, u64_at(in used, k)) {
                        Fail::raise(werr(K_UNSUPPORTED, U_FIRST_CLASS_CONTINUATION, 59));
                    }
                }
            }
        }
        let tv = term_operands(in cx, blk.term, blk.ta);
        for k in 0..tv.len() {
            if contains64(in reads, u64_at(in tv, k)) {
                Fail::raise(werr(K_UNSUPPORTED, U_FIRST_CLASS_CONTINUATION, 60));
            }
        }
    }
    if calls.len() == 0 {
        return M_ABORT;
    }
    // Tail-resumptive: each resumption result flows unchanged to a return,
    // and every return returns a resumption result.
    let mut tail = ChunkSeq::new[u64]();
    for bi in 0..row.bc {
        let blk = cx.ir.p.block(add(row.b0, bi));
        if blk.ic == 0 {
            continue;
        }
        let last = cx.ir.p.inst(add(blk.i0, wrapping_sub(blk.ic, 1)));
        let d = widen_u64(last.dest);
        if contains64(in calls, d)
            && flows_to_return(in cx, fi, bi, d, 0)
            && !contains64(in tail, d) {
            tail.push(d);
        }
    }
    let mut used_elsewhere = false;
    let mut returns_resumed = true;
    for bi in 0..row.bc {
        let blk = cx.ir.p.block(add(row.b0, bi));
        for ii in 0..blk.ic {
            let ins = cx.ir.p.inst(add(blk.i0, ii));
            let used = inst_operands(in cx, ins.op, ins.a);
            for k in 0..used.len() {
                if contains64(in calls, u64_at(in used, k)) {
                    used_elsewhere = true;
                }
            }
        }
        if blk.term == Term::Return {
            if !resumed_value(in cx, fi, bi, cx.ir.word(blk.ta), in tail, 0) {
                returns_resumed = false;
            }
        }
    }
    if tail.len() == calls.len() && !used_elsewhere && returns_resumed {
        M_TAIL
    } else {
        M_OTHER
    }
}

// `terminator_operands`.
fn term_operands(in cx: Cx, term: u8, ta: u64) -> ChunkSeq[u64] {
    let mut out = ChunkSeq::new[u64]();
    if term == Term::Return || term == Term::Branch || term == Term::Match {
        out.push(cx.ir.word(ta));
    } else if term == Term::Jump {
        let n = cx.ir.word(inc(ta));
        for k in 0..n {
            out.push(cx.ir.word(add(add(ta, 2), k)));
        }
    }
    out
}
