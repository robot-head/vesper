// The uniform value layout (src/wasm_backend/layout.rs) and the static
// plan (src/wasm_backend/analysis.rs): which function instances the entry
// reaches, under which type arguments, and what each call targets.
//
// Strings the Rust code keys maps by (instance keys such as `f<T=i64>`,
// evidence keys such as `$effect:Fail`) are interned symbols here; a
// table indexed by symbol stands for each `BTreeMap<String, _>`, and the
// few maps the Rust code iterates in key order are sorted by the names'
// bytes (`cmp_syms`), as `String`'s `Ord` is.

use @vesper/place-ir::{program_new};
use @vesper/place-ir::codes::{Op, Pat, Term};
use @vesper/check-data::util::{
    add, inc, n32, stage2_heap_mark, stage2_heap_reset, stage2_heap_swap, u32_at, u64_at, w
};
use @vesper/check-data::names::{Names, names_new};
use @vesper/check-data::types::{
    TyKind, TyPass, Types, Vars, default_type, display, substitute, types_new, vars_new
};
use @vesper/check-data::world::{Adt, Known, Variant, World, set_by_symbol, world_new};
use @vesper/check-data::input::{Ctx};
use self::err::{WErr, werr, werr_syms};
use self::ir::{EffInst, ExprFactKind, Facts, FnInfo, Ir, Sig, empty_facts, ir_new, pattern_end};

const NONE32: u32 = 4294967295;
const NONE64: u64 = 18446744073709551615;
const NO_ADT: u32 = 4294967295;
// err.ves kinds and constructs (constants cannot be imported yet).
const K_UNSUPPORTED: u8 = 0;
const K_ENTRY: u8 = 1;
const K_LIMIT: u8 = 2;
const K_INVALID: u8 = 3;
const K_NOT_PORTED: u8 = 5;
const U_PROJECTION: u8 = 4;
const U_GENERIC_EFFECT_INSTANCE: u8 = 6;
const U_INOUT_EFFECT_ARGUMENT: u8 = 8;
const U_FIRST_CLASS_CONTINUATION: u8 = 9;
const U_EXTERNAL_FUNCTION: u8 = 11;
const U_INTEGER_WIDTH: u8 = 14;

// Shapes (`layout::Shape`) and scalars (`layout::Scalar`).
pub const SH_SCALAR: u8 = 0;
pub const SH_TUPLE: u8 = 1;
pub const SH_STRUCT: u8 = 2;
pub const SH_ENUM: u8 = 3;
pub const SH_STR: u8 = 4;
pub const SH_OPAQUE: u8 = 5;
pub const SH_FUNCTION: u8 = 6;
pub const SC_I64: u8 = 0;
pub const SC_U64: u8 = 1;
pub const SC_U32: u8 = 2;
pub const SC_U8: u8 = 3;
pub const SC_BOOL: u8 = 4;
pub const SC_F64: u8 = 5;
pub const SC_UNIT: u8 = 6;
pub const SC_NEVER: u8 = 7;
pub const SC_U16: u8 = 8;
pub const SC_I32: u8 = 9;
pub const SC_I16: u8 = 10;
pub const SC_I8: u8 = 11;
// An `f32`: its binary32 bits in the low half of a word (src/floats.ves).
pub const SC_F32: u8 = 12;

// Clause modes (`analysis::HandlerMode`). A clause that resumes other
// than in tail position runs on a WasmFX continuation or in CPS, which
// the port does not lower yet.
pub const M_ABORT: u8 = 0;
pub const M_TAIL: u8 = 1;
pub const M_OTHER: u8 = 2;

// Roles (`analysis::Role`).
pub const R_ORDINARY: u8 = 0;
pub const R_HANDLER_BODY: u8 = 1;
pub const R_RETURN_CLAUSE: u8 = 2;
pub const R_OP_CLAUSE: u8 = 3;

// Symbols the backend compares against, interned once.
pub copy struct Syms {
    i64_: u32,
    u64_: u32,
    u32_: u32,
    u8_: u32,
    bool_: u32,
    f64_: u32,
    f32_: u32,
    unit: u32,
    never: u32,
    string: u32,
    i128_: u32,
    u128_: u32,
    fail: u32,
    raise: u32,
    result: u32,
    overflow: u32,
    runtime_error: u32,
    index_oob: u32,
    div_zero: u32,
    stdout: u32,
    clock: u32,
    trace: u32,
    // the `.vsys` libraries of @vesper-std/env and @vesper-std/fs
    // (`ffi_lowering::effect_name`), lowered over WASI (src/host.ves)
    ffi_env: u32,
    ffi_fs: u32,
    ffi_proc: u32,
    ffi_blake3: u32,
    // `Ffi[Cranelift]` (packages/vesper-cranelift): component imports
    // (src/vcl_host.ves)
    ffi_cranelift: u32,
    eq: u32,
    empty: u32,
    chunkseq: u32,
    slice: u32,
    str_: u32,
    some: u32,
    none: u32,
}

pub fn syms_new(inout n: Names) -> Syms {
    Syms {
        i64_: n.intern(in "i64".as_bytes()),
        u64_: n.intern(in "u64".as_bytes()),
        u32_: n.intern(in "u32".as_bytes()),
        u8_: n.intern(in "u8".as_bytes()),
        bool_: n.intern(in "bool".as_bytes()),
        f64_: n.intern(in "f64".as_bytes()),
        f32_: n.intern(in "f32".as_bytes()),
        unit: n.intern(in "Unit".as_bytes()),
        never: n.intern(in "Never".as_bytes()),
        string: n.intern(in "String".as_bytes()),
        i128_: n.intern(in "i128".as_bytes()),
        u128_: n.intern(in "u128".as_bytes()),
        fail: n.intern(in "Fail".as_bytes()),
        raise: n.intern(in "raise".as_bytes()),
        result: n.intern(in "Result".as_bytes()),
        overflow: n.intern(in "ArithOverflow".as_bytes()),
        runtime_error: n.intern(in "RuntimeError".as_bytes()),
        index_oob: n.intern(in "IndexOutOfBounds".as_bytes()),
        div_zero: n.intern(in "DivisionByZero".as_bytes()),
        stdout: n.intern(in "Stdout".as_bytes()),
        clock: n.intern(in "Clock".as_bytes()),
        trace: n.intern(in "Trace".as_bytes()),
        ffi_env: n.intern(in "Ffi$StdEnv".as_bytes()),
        ffi_fs: n.intern(in "Ffi$StdFs".as_bytes()),
        ffi_proc: n.intern(in "Ffi$StdProcess".as_bytes()),
        ffi_blake3: n.intern(in "Ffi$Blake3".as_bytes()),
        ffi_cranelift: n.intern(in "Ffi$Cranelift".as_bytes()),
        eq: n.intern(in "=".as_bytes()),
        empty: n.intern(in "".as_bytes()),
        chunkseq: n.intern(in "ChunkSeq".as_bytes()),
        slice: n.intern(in "Slice".as_bytes()),
        str_: n.intern(in "Str".as_bytes()),
        some: n.intern(in "Some".as_bytes()),
        none: n.intern(in "None".as_bytes()),
    }
}

// The checker data and the backend's inputs.
pub struct Cx {
    names: Names,
    types: Types,
    world: World,
    known: Known,
    facts: Facts,
    ir: Ir,
    syms: Syms,
}

pub fn cx_new(sink ctx: Ctx, sink facts: Facts, sink ir: Ir) -> Cx {
    let Ctx { names, types, world, tmap, nmap } = ctx;
    let mut names = names;
    let syms = syms_new(inout names);
    let known = world.k;
    Cx {
        names: names,
        types: types,
        world: world,
        known: known,
        facts: facts,
        ir: ir,
        syms: syms,
    }
}

// Byte order of two names (`String`'s `Ord`): -1, 0 or 1.
pub fn cmp_syms(in names: Names, lhs: u32, rhs: u32) -> i64 {
    if lhs == rhs {
        return 0;
    }
    let (lhs_start, lhs_end) = (names.start(lhs), names.end(lhs));
    let (rhs_start, rhs_end) = (names.start(rhs), names.end(rhs));
    let lhs_len = wrapping_sub(lhs_end, lhs_start);
    let rhs_len = wrapping_sub(rhs_end, rhs_start);
    let n = if lhs_len < rhs_len { lhs_len } else { rhs_len };
    for i in 0..n {
        let lhs_byte = names.byte(lhs, i);
        let rhs_byte = names.byte(rhs, i);
        if lhs_byte < rhs_byte {
            return -1;
        }
        if lhs_byte > rhs_byte {
            return 1;
        }
    }
    if lhs_len < rhs_len {
        -1
    } else if lhs_len > rhs_len {
        1
    } else {
        0
    }
}

// Inserts symbol `sym_id` into the byte-sorted set `set` (no duplicates).
pub fn sorted_insert(in names: Names, inout set: ChunkSeq[u32], sym_id: u32) {
    let mut pos = set.len();
    for i in 0..set.len() {
        let order = cmp_syms(in names, u32_at(in set, i), sym_id);
        if order == 0 {
            return;
        }
        if order > 0 {
            pos = i;
            break;
        }
    }
    set.push(sym_id);
    let mut i = wrapping_sub(set.len(), 1);
    loop {
        if i <= pos {
            break;
        }
        let prev = u32_at(in set, wrapping_sub(i, 1));
        let ok = set.try_set(i, prev);
        i = wrapping_sub(i, 1);
    }
    let ok = set.try_set(pos, sym_id);
}

pub fn contains32(in set: ChunkSeq[u32], value: u32) -> bool {
    for i in 0..set.len() {
        if u32_at(in set, i) == value {
            return true;
        }
    }
    false
}

// ----- layout ------------------------------------------------------------------

// `layout::shape` of a type: the kind, the scalar, and for an ADT its
// index (fields are read through `variant_field`).
pub copy struct Shape {
    kind: u8,
    scalar: u8,
    adt: u32,
    // the defaulted type the shape is of
    ty: u32,
}

fn shape_of(kind: u8, scalar: u8, adt: u32, ty: u32) -> Shape {
    Shape { kind: kind, scalar: scalar, adt: adt, ty: ty }
}

impl Cx {
    pub fn default_ty(inout self, ty: u32) -> u32 {
        default_type(inout self.types, ty)
    }

    pub fn subst(inout self, ty: u32, in vars: Vars) -> u32 {
        substitute(inout self.types, ty, in vars)
    }

    // `numeric::is_integer_name`.
    pub fn is_integer_name(in self, name: u32) -> bool {
        self.known.is_integer(name) || name == self.syms.i128_ || name == self.syms.u128_
    }

    pub fn is_scalar_name(in self, name: u32) -> bool {
        self.known.is_scalar(name) || name == self.syms.i128_ || name == self.syms.u128_
    }

    pub fn shape(inout self, raw_ty: u32) -> Shape eff [Fail[WErr]] {
        let ty = default_type(inout self.types, raw_ty);
        let node = self.types.node(ty);
        if node.kind == TyKind::Named {
            let name = node.name;
            let syms = self.syms;
            if name == syms.i64_ || name == self.known.isize_ {
                return shape_of(SH_SCALAR, SC_I64, NO_ADT, ty);
            }
            if name == syms.u64_ || name == self.known.usize_ {
                return shape_of(SH_SCALAR, SC_U64, NO_ADT, ty);
            }
            if name == syms.u32_ {
                return shape_of(SH_SCALAR, SC_U32, NO_ADT, ty);
            }
            if name == syms.u8_ {
                return shape_of(SH_SCALAR, SC_U8, NO_ADT, ty);
            }
            if name == self.known.u16_ {
                return shape_of(SH_SCALAR, SC_U16, NO_ADT, ty);
            }
            if name == self.known.i32_ {
                return shape_of(SH_SCALAR, SC_I32, NO_ADT, ty);
            }
            if name == self.known.i16_ {
                return shape_of(SH_SCALAR, SC_I16, NO_ADT, ty);
            }
            if name == self.known.i8_ {
                return shape_of(SH_SCALAR, SC_I8, NO_ADT, ty);
            }
            if name == syms.bool_ {
                return shape_of(SH_SCALAR, SC_BOOL, NO_ADT, ty);
            }
            if name == syms.f64_ {
                return shape_of(SH_SCALAR, SC_F64, NO_ADT, ty);
            }
            if name == syms.unit {
                return shape_of(SH_SCALAR, SC_UNIT, NO_ADT, ty);
            }
            if name == syms.never {
                return shape_of(SH_SCALAR, SC_NEVER, NO_ADT, ty);
            }
            if name == syms.string {
                return shape_of(SH_STR, 0, NO_ADT, ty);
            }
            if name == syms.f32_ {
                return shape_of(SH_SCALAR, SC_F32, NO_ADT, ty);
            }
            if name == syms.u128_ || name == syms.i128_ {
                // the tuple (low word, high word): src/wide.ves
                let u64_ty = self.types.named0(syms.u64_);
                let mut elems = ChunkSeq::new[u32]();
                elems.push(u64_ty);
                elems.push(u64_ty);
                let pair_ty = self.types.tuple(in elems);
                return shape_of(SH_TUPLE, 0, NO_ADT, pair_ty);
            }
            if self.is_integer_name(name) {
                Fail::raise(werr_syms(K_UNSUPPORTED, U_INTEGER_WIDTH, 11, 0, name));
            }
            let adt_index = self.world.lookup(name);
            if adt_index == NO_ADT {
                return shape_of(SH_OPAQUE, 0, NO_ADT, ty);
            }
            let adt = self.world.adt(adt_index);
            if adt.is_enum {
                return shape_of(SH_ENUM, 0, adt_index, ty);
            }
            return shape_of(SH_STRUCT, 0, adt_index, ty);
        }
        if node.kind == TyKind::Tuple {
            if node.n == 0 {
                return shape_of(SH_SCALAR, SC_UNIT, NO_ADT, ty);
            }
            return shape_of(SH_TUPLE, 0, NO_ADT, ty);
        }
        if node.kind == TyKind::Fn {
            return shape_of(SH_FUNCTION, 0, NO_ADT, ty);
        }
        if node.kind == TyKind::Lit {
            return shape_of(SH_SCALAR, SC_I64, NO_ADT, ty);
        }
        shape_of(SH_OPAQUE, 0, NO_ADT, ty)
    }

    // The number of variants of an ADT shape (a struct has its one, or
    // none).
    pub fn variant_count(in self, shape: Shape) -> u64 {
        w(self.world.adt(shape.adt).vn)
    }

    pub fn variant(in self, shape: Shape, variant_index: u64) -> Variant {
        let adt = self.world.adt(shape.adt);
        self.world.variant(add(w(adt.va), variant_index))
    }

    // Field `i` of variant `variant_index` of ADT shape `shape`: its name and its type
    // under the shape's arguments (substituted, not defaulted).
    pub fn variant_field(inout self, shape: Shape, variant_index: u64, i: u64) -> (u32, u32) {
        let adt = self.world.adt(shape.adt);
        let variant = self.world.variant(add(w(adt.va), variant_index));
        let field = self.world.field(add(w(variant.fa), i));
        let vars = self.world.vars_of(in self.types, adt, shape.ty);
        let field_ty = substitute(inout self.types, field.ty, in vars);
        (field.name, field_ty)
    }

    // The number of fields of variant `variant_index` (a struct's only variant is 0;
    // a struct without variants has none).
    pub fn field_count(in self, shape: Shape, variant_index: u64) -> u64 {
        let adt = self.world.adt(shape.adt);
        if variant_index >= w(adt.vn) {
            return 0;
        }
        w(self.world.variant(add(w(adt.va), variant_index)).fc)
    }

    // Element `i` of a tuple type.
    pub fn tuple_elem(in self, ty: u32, i: u64) -> u32 {
        self.types.arg(ty, i)
    }

    pub fn arity(in self, ty: u32) -> u64 {
        self.types.arity(ty)
    }

    // `layout::field`: the byte offset and type of field `name` of a tuple
    // or struct value.
    pub fn field(inout self, ty: u32, name: u32) -> (u64, u32) eff [Fail[WErr]] {
        let shape = self.shape(ty);
        if shape.kind == SH_TUPLE {
            let i = self.decimal(name);
            if i == 18446744073709551615 {
                Fail::raise(werr(K_INVALID, 0, 20));
            }
            if i >= self.types.arity(shape.ty) {
                Fail::raise(werr(K_INVALID, 0, 21));
            }
            return (wrapping_mul(8, i), self.types.arg(shape.ty, i));
        }
        if shape.kind == SH_STRUCT {
            let n = self.field_count(shape, 0);
            for i in 0..n {
                let (fname, fty) = self.variant_field(shape, 0, i);
                if fname == name {
                    return (wrapping_mul(8, i), fty);
                }
            }
            Fail::raise(werr(K_INVALID, 0, 22));
        }
        Fail::raise(werr(K_UNSUPPORTED, U_PROJECTION, 23));
        (0, 0)
    }

    // The value of decimal name `sym_id` (`str::parse::<usize>`), or u64::MAX.
    pub fn decimal(in self, sym_id: u32) -> u64 {
        let n = self.names.size(sym_id);
        if n == 0 {
            return 18446744073709551615;
        }
        let mut value: u64 = 0;
        for i in 0..n {
            let digit = self.names.byte(sym_id, i);
            if digit < 48 || digit > 57 {
                return 18446744073709551615;
            }
            value = wrapping_add(wrapping_mul(value, 10), widen_u64(wrapping_sub(digit, 48)));
        }
        value
    }

    // `layout::slots`: the slot count of a struct or tuple block.
    pub fn slots(inout self, ty: u32) -> u64 eff [Fail[WErr]] {
        let shape = self.shape(ty);
        if shape.kind == SH_TUPLE {
            return self.types.arity(shape.ty);
        }
        if shape.kind == SH_STRUCT {
            return self.field_count(shape, 0);
        }
        Fail::raise(werr(K_INVALID, 0, 24));
        0
    }

    // `layout::variant`: (index, is_enum) of `constructor` in the enum
    // or struct `ty`, and the shape whose variant `index` it is.
    pub fn variant_of(
        inout self,
        ty: u32,
        constructor: u32
    ) -> (u64, bool, Shape) eff [Fail[WErr]] {
        let short = self.short_name(constructor);
        let shape = self.shape(ty);
        if shape.kind == SH_ENUM {
            let n = self.variant_count(shape);
            for i in 0..n {
                let variant = self.variant(shape, i);
                if self.names_equal(variant.name, short) {
                    return (i, true, shape);
                }
            }
            Fail::raise(werr(K_INVALID, 0, 25));
        }
        if shape.kind == SH_STRUCT {
            return (0, false, shape);
        }
        Fail::raise(werr(K_INVALID, 0, 26));
        (0, false, shape)
    }

    pub fn names_equal(in self, lhs: u32, rhs: u32) -> bool {
        cmp_syms(in self.names, lhs, rhs) == 0
    }

    // The part of `name` after its last `::` (`rsplit("::").next()`).
    pub fn short_name(inout self, name: u32) -> u32 {
        let n = self.names.size(name);
        let mut cut: u64 = 0;
        let mut i: u64 = 0;
        loop {
            if inc(i) >= n {
                break;
            }
            if self.names.byte(name, i) == 58 && self.names.byte(name, inc(i)) == 58 {
                cut = add(i, 2);
            }
            i = inc(i);
        }
        if cut == 0 {
            return name;
        }
        let mut text = ChunkSeq::new[u8]();
        for pos in cut..n {
            text.push(self.names.byte(name, pos));
        }
        self.intern(in text)
    }

    // The index of field `name` in variant `variant_index` of shape `shape`, or NONE.
    pub fn field_index(inout self, shape: Shape, variant_index: u64, name: u32) -> u64 {
        let n = self.field_count(shape, variant_index);
        let adt = self.world.adt(shape.adt);
        let variant = self.world.variant(add(w(adt.va), variant_index));
        for i in 0..n {
            let field = self.world.field(add(w(variant.fa), i));
            if field.name == name {
                return i;
            }
        }
        18446744073709551615
    }

    // The function's signature in the world: a sig index + 1, or 0.
    pub fn fn_sig(in self, name: u32) -> u64 {
        self.facts.fn_sig_of(name)
    }

    pub fn sig(in self, name: u32) -> Sig {
        let sig_ref = self.facts.fn_sig_of(name);
        if sig_ref == 0 {
            return self.facts.sig(18446744073709551615);
        }
        self.facts.sig(wrapping_sub(sig_ref, 1))
    }

    // Appends the `Display` of type `ty` to `out`.
    pub fn show(in self, ty: u32, inout out: ChunkSeq[u8]) {
        display(in self.types, in self.names, ty, inout out);
    }

    pub fn write_name(in self, sym_id: u32, inout out: ChunkSeq[u8]) {
        self.names.write(sym_id, inout out);
    }

    pub fn intern(inout self, in text: ChunkSeq[u8]) -> u32 {
        let hit = self.names.lookup(in text.as_slice());
        if hit != NONE32 {
            return hit;
        }
        self.names.intern(in text.as_slice())
    }

    // `mentions_generic` of analysis.rs.
    pub fn mentions_generic(in self, ty: u32) -> bool {
        let node = self.types.node(ty);
        if node.kind == TyKind::Named {
            if node.n == 0
                && self.world.lookup(node.name) == NO_ADT
                && !self.is_scalar_name(node.name)
                && node.name != self.syms.string
            {
                return true;
            }
            for i in 0..w(node.n) {
                if self.mentions_generic(self.types.arg(ty, i)) {
                    return true;
                }
            }
            return false;
        }
        if node.kind == TyKind::Tuple {
            for i in 0..w(node.n) {
                if self.mentions_generic(self.types.arg(ty, i)) {
                    return true;
                }
            }
            return false;
        }
        node.kind != TyKind::Lit
    }
}

// ----- vars ------------------------------------------------------------------

// Type arguments of an instance in name order (`analysis::Vars`, a
// `BTreeMap<String, Type>`): `keys[i] -> vals[i]`.
pub struct TVars {
    keys: ChunkSeq[u32],
    vals: ChunkSeq[u32],
}

pub fn tvars_new() -> TVars {
    TVars { keys: ChunkSeq::new[u32](), vals: ChunkSeq::new[u32]() }
}

impl TVars {
    pub fn len(in self) -> u64 {
        self.keys.len()
    }

    pub fn key(in self, i: u64) -> u32 {
        u32_at(in self.keys, i)
    }

    pub fn val(in self, i: u64) -> u32 {
        u32_at(in self.vals, i)
    }

    pub fn get(in self, key: u32) -> u32 {
        for i in 0..self.keys.len() {
            if u32_at(in self.keys, i) == key {
                return u32_at(in self.vals, i);
            }
        }
        NONE32
    }

    // `insert`, keeping name order.
    pub fn set(inout self, in names: Names, key: u32, value: u32) {
        for i in 0..self.keys.len() {
            if u32_at(in self.keys, i) == key {
                let ok = self.vals.try_set(i, value);
                return;
            }
        }
        let mut pos = self.keys.len();
        for i in 0..self.keys.len() {
            if cmp_syms(in names, u32_at(in self.keys, i), key) > 0 {
                pos = i;
                break;
            }
        }
        self.keys.push(key);
        self.vals.push(value);
        let mut i = wrapping_sub(self.keys.len(), 1);
        loop {
            if i <= pos {
                break;
            }
            let prev_key = u32_at(in self.keys, wrapping_sub(i, 1));
            let prev_val = u32_at(in self.vals, wrapping_sub(i, 1));
            let ok = self.keys.try_set(i, prev_key);
            let ok2 = self.vals.try_set(i, prev_val);
            i = wrapping_sub(i, 1);
        }
        let ok = self.keys.try_set(pos, key);
        let ok2 = self.vals.try_set(pos, value);
    }

    // check-data's `Vars` for `substitute`.
    pub fn vars(in self) -> Vars {
        let mut out = vars_new();
        for i in 0..self.keys.len() {
            out.set(u32_at(in self.keys, i), u32_at(in self.vals, i));
        }
        out
    }

    pub fn dup(in self) -> TVars {
        let mut out = tvars_new();
        for i in 0..self.keys.len() {
            out.keys.push(u32_at(in self.keys, i));
            out.vals.push(u32_at(in self.vals, i));
        }
        out
    }
}

// ----- plan ------------------------------------------------------------------

// One reachable function instance (`analysis::Instance` and its role).
pub copy struct Inst {
    key: u32,
    base: u32,
    // the IR function: index into `Ir`'s functions
    fn_index: u64,
    // type arguments: vkeys/vvals[v0..v0+vn]
    v0: u64,
    vn: u64,
    role: u8,
    handler: u64,
    op: u64,
    // calls[c0..c0+cn]: this instance's direct calls
    c0: u64,
    cn: u64,
    // labels[l0..l0+ln]
    l0: u64,
    ln: u64,
}

pub copy struct CallTarget {
    dest: u64,
    callee: u32,
}

pub struct Plan {
    insts: ChunkSeq[Inst],
    vkeys: ChunkSeq[u32],
    vvals: ChunkSeq[u32],
    // key symbol -> inst index + 1
    by_key: ChunkSeq[u32],
    calls: ChunkSeq[CallTarget],
    labels: ChunkSeq[u32],
    // every dynamic evidence key, in byte order
    keys: ChunkSeq[u32],
    max_arity: u64,
    // host capabilities, sorted: 0 Stdout, 1 Clock, 2 Trace, 3 the
    // StdEnv library, 4 the StdFs library, 5 the StdProcess library
    // (`host::HOST_ENV`, `HOST_FS`, `HOST_PROC`)
    host: ChunkSeq[u8],
    handlers: ChunkSeq[Handler],
    clauses: ChunkSeq[HClause],
    // the handlers' and clauses' side words (types, names, keys)
    handler_words: ChunkSeq[u32],
}

// A queued instance (BFS of `analysis::plan`).
copy struct Queued {
    key: u32,
    base: u32,
    v0: u64,
    vn: u64,
    role: u8,
    handler: u64,
    op: u64,
    l0: u64,
    ln: u64,
}

impl Plan {
    pub fn inst(in self, i: u64) -> Inst {
        match self.insts.try_get(i) {
            Option::Some(x) => x,
            Option::None => Inst {
                key: 0,
                base: 0,
                fn_index: 0,
                v0: 0,
                vn: 0,
                role: 0,
                handler: 0,
                op: 0,
                c0: 0,
                cn: 0,
                l0: 0,
                ln: 0
            },
        }
    }

    // The instance of key `key`: an index + 1, or 0.
    pub fn find(in self, key: u32) -> u64 {
        w(u32_at(in self.by_key, w(key)))
    }

    pub fn vars(in self, inst: Inst) -> TVars {
        let mut out = tvars_new();
        for k in 0..inst.vn {
            out.keys.push(u32_at(in self.vkeys, add(inst.v0, k)));
            out.vals.push(u32_at(in self.vvals, add(inst.v0, k)));
        }
        out
    }

    // The callee key of call `dest` in instance `inst`, or NONE32.
    pub fn callee(in self, inst: Inst, dest: u64) -> u32 {
        for k in 0..inst.cn {
            match self.calls.try_get(add(inst.c0, k)) {
                Option::Some(call) => {
                    if call.dest == dest {
                        return call.callee;
                    }
                },
                Option::None => {},
            }
        }
        NONE32
    }

    pub fn has_label(in self, inst: Inst, label: u32) -> bool {
        for k in 0..inst.ln {
            if u32_at(in self.labels, add(inst.l0, k)) == label {
                return true;
            }
        }
        false
    }
}

// `instance_name(base, vars)`: `base`, or `base<k=T,...>`.
pub fn instance_name(inout ctx: Cx, base: u32, in vars: TVars) -> u32 {
    if vars.len() == 0 {
        return base;
    }
    let mut text = ChunkSeq::new[u8]();
    ctx.write_name(base, inout text);
    text.push(60);
    for i in 0..vars.len() {
        if i > 0 {
            text.push(44);
        }
        ctx.write_name(vars.key(i), inout text);
        text.push(61);
        ctx.show(vars.val(i), inout text);
    }
    text.push(62);
    ctx.intern(in text)
}

// `call_vars`: the type arguments of the call at span (s0, s1) to
// `callee` with explicit types `explicit` inside an instance with `outer`
// arguments, when all are concrete (else none).
fn call_vars(
    inout ctx: Cx,
    callee: u32,
    s0: u64,
    s1: u64,
    in explicit: ChunkSeq[u32],
    in outer: TVars
) -> TVars {
    let mut out = tvars_new();
    let sig_ref = ctx.fn_sig(callee);
    if sig_ref == 0 {
        return out;
    }
    let sig = ctx.facts.sig(wrapping_sub(sig_ref, 1));
    let mut all_rows = true;
    for gen_index in 0..sig.gen_count {
        if !ctx.facts.gen(add(sig.gen_start, gen_index)).row {
            all_rows = false;
        }
    }
    if all_rows {
        return out;
    }
    let outer_vars = outer.vars();
    let mut vars = tvars_new();
    let call_index = ctx.facts.call_at(s0, s1);
    if call_index < ctx.facts.calls.len() {
        let call = ctx.facts.call(call_index);
        for pair_index in 0..call.vn {
            let pair = ctx.facts.pair(add(call.v0, pair_index));
            let ty = ctx.subst(pair.ty, in outer_vars);
            vars.set(in ctx.names, pair.name, ty);
        }
    }
    let n = if sig.gen_count < explicit.len() {
        sig.gen_count
    } else {
        explicit.len()
    };
    for gen_index in 0..n {
        let generic = ctx.facts.gen(add(sig.gen_start, gen_index));
        if !generic.row && vars.get(generic.name) == NONE32 {
            let ty = ctx.subst(u32_at(in explicit, gen_index), in outer_vars);
            vars.set(in ctx.names, generic.name, ty);
        }
    }
    for gen_index in 0..sig.gen_count {
        let generic = ctx.facts.gen(add(sig.gen_start, gen_index));
        if generic.row {
            continue;
        }
        let ty = vars.get(generic.name);
        if ty == NONE32 || ctx.mentions_generic(ty) {
            return tvars_new();
        }
        let resolved = ctx.default_ty(ty);
        out.set(in ctx.names, generic.name, resolved);
    }
    out
}

// The labels a function's own effect row binds (`eff [l: E]`).
fn row_labels(in ctx: Cx, inout out: ChunkSeq[u32], base: u32) {
    let sig_ref = ctx.fn_sig(base);
    if sig_ref == 0 {
        return;
    }
    let sig = ctx.facts.sig(wrapping_sub(sig_ref, 1));
    for i in 0..sig.eff_count {
        let effect = ctx.facts.eff(add(sig.eff_start, i));
        if effect.label != NONE32 && ctx.names.byte(effect.label, 0) != 36 {
            sorted_insert(in ctx.names, inout out, effect.label);
        }
    }
}

// `host::capabilities`: the host capabilities the entry declares.
fn capabilities(inout ctx: Cx, inout out: ChunkSeq[u8], entry: u32) eff [Fail[WErr]] {
    let sig_ref = ctx.fn_sig(entry);
    if sig_ref == 0 {
        Fail::raise(werr(K_ENTRY, 0, 30));
    }
    let sig = ctx.facts.sig(wrapping_sub(sig_ref, 1));
    if sig.tail != NONE32 {
        Fail::raise(werr(K_ENTRY, 0, 31));
    }
    for i in 0..sig.eff_count {
        let effect = ctx.facts.eff(add(sig.eff_start, i));
        if ctx.facts.is_capability(effect.name) {
            continue;
        }
        // The standard I/O libraries become WASI calls (src/host.ves).
        // StdProcess has no functions on WASI (@vesper-std/process's
        // src-wasip2 refuses every start itself), so it imports nothing.
        // Cranelift calls are imports of `vesper:cranelift/vcl` (#2210).
        if effect.name == ctx.syms.ffi_env
            || effect.name == ctx.syms.ffi_fs
            || effect.name == ctx.syms.ffi_proc
            || effect.name == ctx.syms.ffi_cranelift
            || effect.name == ctx.syms.ffi_blake3
        {
            let code: u8 = if effect.name == ctx.syms.ffi_env {
                3
            } else if effect.name == ctx.syms.ffi_fs {
                4
            } else if effect.name == ctx.syms.ffi_proc {
                5
            } else if effect.name == ctx.syms.ffi_cranelift {
                6
            } else {
                7
            };
            let mut seen = false;
            for j in 0..out.len() {
                match out.try_get(j) {
                    Option::Some(host_code) => {
                        if host_code == code {
                            seen = true;
                        }
                    },
                    Option::None => {},
                }
            }
            if !seen {
                out.push(code);
            }
            continue;
        }
        if effect.name == ctx.syms.stdout
            || effect.name == ctx.syms.clock
            || effect.name == ctx.syms.trace
        {
            // The WASI host frames are lowered in part 2 of the port.
            Fail::raise(werr(K_NOT_PORTED, 0, 32));
        }
        Fail::raise(werr(K_ENTRY, 0, 33));
    }
}

// The names of `ir` function `fn_index`'s first `n` parameters equal
// `caps[c0..c0+n]` (`check_prefix`).
fn check_prefix(in ctx: Cx, fn_index: u64, in caps: ChunkSeq[u32]) eff [Fail[WErr]] {
    let info = ctx.ir.info(fn_index);
    if info.pn < caps.len() {
        Fail::raise(werr(K_INVALID, 0, 34));
    }
    for i in 0..caps.len() {
        if ctx.ir.param(add(info.p0, i)).name != u32_at(in caps, i) {
            Fail::raise(werr(K_INVALID, 0, 35));
        }
    }
}

// The alias of `name` in an instruction's alias pairs `ops[a..a+2n]`
// (closure and handler `aliases`), or NONE32.
pub fn alias_of(in ctx: Cx, pairs_at: u64, n: u64, name: u32) -> u32 {
    for i in 0..n {
        let pair_at = add(pairs_at, wrapping_mul(i, 2));
        if n32(ctx.ir.word(pair_at)) == name {
            return n32(ctx.ir.word(inc(pair_at)));
        }
    }
    NONE32
}

// `analysis::captures`: the free names (`free[f0..f0+fc]`, sorted) that
// alias a visible local of the enclosing function.
pub fn captures(
    in ctx: Cx,
    f0: u64,
    fc: u64,
    pairs_at: u64,
    n: u64,
    outer: FnInfo
) -> ChunkSeq[u32] {
    let mut out = ChunkSeq::new[u32]();
    for i in 0..fc {
        let name = ctx.facts.free_at(add(f0, i));
        let alias = alias_of(in ctx, pairs_at, n, name);
        if alias != NONE32 && ctx.ir.has_local(outer, alias) {
            out.push(name);
        }
    }
    out
}

// The closure facts of a `closure` instruction at `ops[at]`: its nested
// function name, and the aliases' range (ops index, pair count).
pub fn closure_operands(in ctx: Cx, at: u64) -> (u64, u64, u64) {
    // pool index, aliases n, n pairs, moves n, n pairs
    let pool = ctx.ir.word(at);
    let n = ctx.ir.word(inc(at));
    (pool, add(at, 2), n)
}

pub fn empty_plan() -> Plan {
    Plan {
        insts: ChunkSeq::new[Inst](),
        vkeys: ChunkSeq::new[u32](),
        vvals: ChunkSeq::new[u32](),
        by_key: ChunkSeq::new[u32](),
        calls: ChunkSeq::new[CallTarget](),
        labels: ChunkSeq::new[u32](),
        keys: ChunkSeq::new[u32](),
        max_arity: 0,
        host: ChunkSeq::new[u8](),
        handlers: ChunkSeq::new[Handler](),
        clauses: ChunkSeq::new[HClause](),
        handler_words: ChunkSeq::new[u32](),
    }
}

pub fn plan(inout ctx: Cx) -> Plan eff [Fail[WErr]] {
    let entry = ctx.facts.entry;
    let mut p_insts = ChunkSeq::new[Inst]();
    let mut p_vkeys = ChunkSeq::new[u32]();
    let mut p_vvals = ChunkSeq::new[u32]();
    let mut p_by_key = ChunkSeq::new[u32]();
    let mut p_calls = ChunkSeq::new[CallTarget]();
    let mut p_labels = ChunkSeq::new[u32]();
    let mut p_keys = ChunkSeq::new[u32]();
    let mut p_max_arity: u64 = 0;
    let mut p_host = ChunkSeq::new[u8]();
    let mut p_handlers = ChunkSeq::new[Handler]();
    let mut p_clauses = ChunkSeq::new[HClause]();
    let mut p_hw = ChunkSeq::new[u32]();
    capabilities(inout ctx, inout p_host, entry);
    let mut arity: u64 = 0;
    for decl_index in 0..ctx.facts.decls.len() {
        let decl = ctx.facts.decl(decl_index);
        for op_idx in 0..decl.op_count {
            let sig = ctx.facts.sig(ctx.facts.op(add(decl.op_start, op_idx)).sig);
            if sig.pn > arity {
                arity = sig.pn;
            }
        }
    }
    if arity < 1 {
        arity = 1;
    }
    p_max_arity = arity;
    // the queue: rows, their vars and labels in side tables
    let mut queue = ChunkSeq::new[Queued]();
    let mut qkeys = ChunkSeq::new[u32]();
    let mut qvals = ChunkSeq::new[u32]();
    let mut qlabels = ChunkSeq::new[u32]();
    let mut entry_labels = ChunkSeq::new[u32]();
    row_labels(in ctx, inout entry_labels, entry);
    let entry_label_start = qlabels.len();
    for i in 0..entry_labels.len() {
        qlabels.push(u32_at(in entry_labels, i));
    }
    queue.push(Queued {
        key: entry,
        base: entry,
        v0: 0,
        vn: 0,
        role: R_ORDINARY,
        handler: 0,
        op: 0,
        l0: entry_label_start,
        ln: entry_labels.len()
    });
    let mut seen = ChunkSeq::new[u32]();
    p_insts.reserve(8192);
    p_vkeys.reserve(32768);
    p_vvals.reserve(32768);
    p_by_key.reserve(262144);
    p_calls.reserve(262144);
    p_labels.reserve(16384);
    p_keys.reserve(8192);
    p_host.reserve(4096);
    p_handlers.reserve(2048);
    p_clauses.reserve(4096);
    p_hw.reserve(8192);
    queue.reserve(262144);
    qkeys.reserve(131072);
    qvals.reserve(131072);
    qlabels.reserve(131072);
    seen.reserve(262144);
    let max_names = add(ctx.names.len(), 32768);
    let max_text = add(ctx.names.text_len(), 524288);
    ctx.names.reserve_names(max_names, max_text);
    let max_nodes = add(ctx.types.nodes.len(), 16384);
    let max_items = add(ctx.types.items_len(), 32768);
    let max_rows = add(ctx.types.rows.len(), 8192);
    let max_effs = add(ctx.types.effs_len(), 16384);
    ctx.types.reserve_types(max_nodes, max_items, max_rows, max_effs);
    let mut scratch = ChunkSeq::new[u8]();
    scratch.reserve(33554432);
    let scratch_end = stage2_heap_mark();
    let scratch_base = wrapping_sub(scratch_end, 33554432);
    let mut perm = stage2_heap_swap(scratch_base);
    let mut scratch_mark = scratch_base;
    let mut head: u64 = 0;
    loop {
        if head >= queue.len() {
            break;
        }
        let queued = match queue.try_get(head) {
            Option::Some(item) => item,
            Option::None => Queued {
                key: 0,
                base: 0,
                v0: 0,
                vn: 0,
                role: 0,
                handler: 0,
                op: 0,
                l0: 0,
                ln: 0
            },
        };
        head = inc(head);
        if u32_at(in seen, w(queued.key)) != 0 {
            continue;
        }
        // m moved down for bisect2
        let n_mask = ctx.names.mask_val();
        let n_tmask = ctx.types.t_mask();
        let n_rmask = ctx.types.r_mask();
        let n_nodes = ctx.types.nodes.len();
        let n_rows = ctx.types.rows.len();
        let n_effs = ctx.types.effs_len();
        set_by_symbol(inout seen, queued.key, 1);
        if p_insts.len() >= ctx.facts.max_functions {
            Fail::raise(werr(K_LIMIT, 0, 40));
        }
        let found = ctx.ir.find(queued.base);
        if found == 0 {
            Fail::raise(werr_syms(K_UNSUPPORTED, U_EXTERNAL_FUNCTION, 41, 0, queued.base));
        }
        let fn_index = wrapping_sub(found, 1);
        let info = ctx.ir.info(fn_index);
        let mut vars = tvars_new();
        for k in 0..queued.vn {
            vars.keys.push(u32_at(in qkeys, add(queued.v0, k)));
            vars.vals.push(u32_at(in qvals, add(queued.v0, k)));
        }
        let var_start = p_vkeys.len();
        for k in 0..vars.len() {
            p_vkeys.push(vars.key(k));
            p_vvals.push(vars.val(k));
        }
        let label_start = p_labels.len();
        for k in 0..queued.ln {
            p_labels.push(u32_at(in qlabels, add(queued.l0, k)));
        }
        let call_start = p_calls.len();
        let row = ctx.ir.program.function(fn_index);
        for block_index in 0..row.bc {
            let blk = ctx.ir.program.block(add(row.b0, block_index));
            for inst_index in 0..blk.ic {
                let instr = ctx.ir.program.inst(add(blk.i0, inst_index));
                if instr.op == Op::Call {
                    let callee = n32(ctx.ir.word(instr.a));
                    if ctx.ir.find(callee) == 0 {
                        continue;
                    }
                    // callee, args (n, n x 4), types (n, ...), capability
                    let n_args = ctx.ir.word(inc(instr.a));
                    let types_at = add(add(instr.a, 2), wrapping_mul(n_args, 4));
                    let n_types = ctx.ir.word(types_at);
                    let mut explicit = ChunkSeq::new[u32]();
                    for k in 0..n_types {
                        explicit.push(n32(ctx.ir.word(add(inc(types_at), k))));
                    }
                    let callee_vars = call_vars(
                        inout ctx,
                        callee,
                        instr.s0,
                        instr.s1,
                        in explicit,
                        in vars
                    );
                    let key = instance_name(inout ctx, callee, in callee_vars);
                    let scratch_at_call = stage2_heap_swap(perm);
                    p_calls.push(CallTarget { dest: widen_u64(instr.dest), callee: key });
                    perm = stage2_heap_swap(scratch_at_call);
                    let mut labels = ChunkSeq::new[u32]();
                    row_labels(in ctx, inout labels, callee);
                    let queued_var_start = qkeys.len();
                    for k in 0..callee_vars.len() {
                        qkeys.push(callee_vars.key(k));
                        qvals.push(callee_vars.val(k));
                    }
                    let queued_label_start = qlabels.len();
                    for k in 0..labels.len() {
                        qlabels.push(u32_at(in labels, k));
                    }
                    let scratch_at_queue = stage2_heap_swap(perm);
                    queue.push(Queued {
                        key: key,
                        base: callee,
                        v0: queued_var_start,
                        vn: callee_vars.len(),
                        role: R_ORDINARY,
                        handler: 0,
                        op: 0,
                        l0: queued_label_start,
                        ln: labels.len()
                    });
                    perm = stage2_heap_swap(scratch_at_queue);
                } else if instr.op == Op::Closure {
                    let (pool, aliases_at, n_aliases) = closure_operands(in ctx, instr.a);
                    let fact = ctx.facts.expr(pool);
                    if fact.kind != ExprFactKind::Closure {
                        Fail::raise(werr(K_INVALID, 0, 42));
                    }
                    let caps = captures(
                        in ctx,
                        fact.free_start,
                        fact.free_count,
                        aliases_at,
                        n_aliases,
                        info
                    );
                    let nested_fn = ctx.ir.find(fact.fn_);
                    if nested_fn == 0 {
                        Fail::raise(werr(K_INVALID, 0, 43));
                    }
                    check_prefix(in ctx, wrapping_sub(nested_fn, 1), in caps);
                    let key = instance_name(inout ctx, fact.fn_, in vars);
                    let queued_var_start = qkeys.len();
                    for k in 0..vars.len() {
                        qkeys.push(vars.key(k));
                        qvals.push(vars.val(k));
                    }
                    let queued_label_start = qlabels.len();
                    for k in 0..queued.ln {
                        qlabels.push(u32_at(in qlabels, add(queued.l0, k)));
                    }
                    let scratch_at_queue = stage2_heap_swap(perm);
                    queue.push(Queued {
                        key: key,
                        base: fact.fn_,
                        v0: queued_var_start,
                        vn: vars.len(),
                        role: R_ORDINARY,
                        handler: 0,
                        op: 0,
                        l0: queued_label_start,
                        ln: queued.ln
                    });
                    perm = stage2_heap_swap(scratch_at_queue);
                } else if instr.op == Op::Read {
                    let root = n32(ctx.ir.word(instr.a));
                    let path = ctx.ir.word(inc(instr.a));
                    if path == 0 && !ctx.ir.has_local(info, root) && ctx.ir.find(root) != 0 {
                        let mut labels = ChunkSeq::new[u32]();
                        row_labels(in ctx, inout labels, root);
                        let queued_label_start = qlabels.len();
                        for k in 0..labels.len() {
                            qlabels.push(u32_at(in labels, k));
                        }
                        let scratch_at_queue = stage2_heap_swap(perm);
                        queue.push(Queued {
                            key: root,
                            base: root,
                            v0: 0,
                            vn: 0,
                            role: R_ORDINARY,
                            handler: 0,
                            op: 0,
                            l0: queued_label_start,
                            ln: labels.len()
                        });
                        perm = stage2_heap_swap(scratch_at_queue);
                    }
                } else if instr.op == Op::Handle {
                    let id = p_handlers.len();
                    let scratch_at_handler = stage2_heap_swap(perm);
                    let handler_row = handler(
                        inout ctx,
                        inout p_clauses,
                        inout p_hw,
                        queued.key,
                        info,
                        in vars,
                        widen_u64(instr.dest),
                        instr.a
                    );
                    for part in 0..wrapping_add(2, handler_row.clause_count) {
                        let (key, base, role, op) = if part == 0 {
                            (handler_row.body, handler_row.body_base, R_HANDLER_BODY, 0)
                        } else if part == 1 {
                            (handler_row.ret, handler_row.ret_base, R_RETURN_CLAUSE, 0)
                        } else {
                            let clause = match p_clauses
                                .try_get(add(handler_row.clause_start, wrapping_sub(part, 2)))
                            {
                                Option::Some(hit) => hit,
                                Option::None => clause0(),
                            };
                            (clause.function, clause.base, R_OP_CLAUSE, clause.op)
                        };
                        let queued_var_start = qkeys.len();
                        for k in 0..vars.len() {
                            qkeys.push(vars.key(k));
                            qvals.push(vars.val(k));
                        }
                        let queued_label_start = qlabels.len();
                        for k in 0..queued.ln {
                            qlabels.push(u32_at(in qlabels, add(queued.l0, k)));
                        }
                        if part == 0 && handler_row.label != NONE32 {
                            let mut seen_label = false;
                            for k in queued_label_start..qlabels.len() {
                                if u32_at(in qlabels, k) == handler_row.label {
                                    seen_label = true;
                                }
                            }
                            if !seen_label {
                                qlabels.push(handler_row.label);
                            }
                        }
                        queue.push(Queued {
                            key: key,
                            base: base,
                            v0: queued_var_start,
                            vn: vars.len(),
                            role: role,
                            handler: id,
                            op: op,
                            l0: queued_label_start,
                            ln: wrapping_sub(qlabels.len(), queued_label_start)
                        });
                    }
                    for k in 0..handler_row.en {
                        sorted_insert(
                            in ctx.names,
                            inout p_keys,
                            u32_at(in p_hw, add(handler_row.e0, k))
                        );
                    }
                    p_handlers.push(handler_row);
                    perm = stage2_heap_swap(scratch_at_handler);
                }
            }
        }
        let inst_index = p_insts.len();
        let scratch_at_inst = stage2_heap_swap(perm);
        p_insts.push(Inst {
            key: queued.key,
            base: queued.base,
            fn_index: fn_index,
            v0: var_start,
            vn: vars.len(),
            role: queued.role,
            handler: queued.handler,
            op: queued.op,
            c0: call_start,
            cn: wrapping_sub(p_calls.len(), call_start),
            l0: label_start,
            ln: queued.ln
        });
        perm = stage2_heap_swap(scratch_at_inst);
        set_by_symbol(inout p_by_key, queued.key, n32(inc(inst_index)));
        if scratch_end != 0 && stage2_heap_mark() >= scratch_end {
            Fail::raise(werr(K_LIMIT, 96, stage2_heap_mark()));
        }
        if ctx.names.mask_val() == n_mask
            && ctx.names.len() < max_names
            && ctx.names.text_len() < max_text
            && ctx.types.t_mask() == n_tmask
            && ctx.types.r_mask() == n_rmask
            && ctx.types.nodes.len() < max_nodes
            && ctx.types.items_len() < max_items
            && ctx.types.rows.len() < max_rows
            && ctx.types.effs_len() < max_effs
            && p_insts.len() <= 8000
            && p_vkeys.len() <= 32000
            && p_vvals.len() <= 32000
            && p_by_key.len() <= 260000
            && p_calls.len() <= 260000
            && p_labels.len() <= 16000
            && p_keys.len() <= 8000
            && p_host.len() <= 4000
            && p_handlers.len() <= 2000
            && p_clauses.len() <= 4000
            && p_hw.len() <= 8000
            && queue.len() <= 260000
            && qkeys.len() <= 130000
            && qvals.len() <= 130000
            && qlabels.len() <= 130000
            && seen.len() <= 260000
        {
            let mut old_cx = dummy_cx(ctx.known, ctx.syms);
            swap(inout ctx, inout old_cx);
            let (rebuilt, next_perm) = rebuild_cx(
                sink old_cx,
                scratch_mark,
                perm,
                n_nodes,
                n_rows,
                n_effs
            );
            let mut new_cx = rebuilt;
            perm = next_perm;
            swap(inout ctx, inout new_cx);
        } else {
            scratch_mark = stage2_heap_mark();
        }
    }
    let _ = stage2_heap_swap(perm);
    Plan {
        insts: p_insts,
        vkeys: p_vkeys,
        vvals: p_vvals,
        by_key: p_by_key,
        calls: p_calls,
        labels: p_labels,
        keys: p_keys,
        max_arity: p_max_arity,
        host: p_host,
        handlers: p_handlers,
        clauses: p_clauses,
        handler_words: p_hw,
    }
}

fn dummy_cx(known: Known, syms: Syms) -> Cx {
    let mut names = names_new();
    let types = types_new(inout names);
    let world = world_new(known);
    let facts = empty_facts(0, 1, 1, 1);
    let ir = ir_new(program_new());
    Cx {
        names: names,
        types: types,
        world: world,
        known: known,
        facts: facts,
        ir: ir,
        syms: syms,
    }
}

// Rewinds the planning scratch to `d_mark`. A sequence of structs keeps each
// element in its own heap block, so the type nodes, rows and effects this
// instance added (past `n_nodes`, `n_rows` and `n_effs`) live in scratch:
// they are copied into the kept region first, as Stage 2's `rebuild_tc` does.
fn rebuild_cx(
    sink old_cx: Cx,
    d_mark: u64,
    d_perm: u64,
    n_nodes: u64,
    n_rows: u64,
    n_effs: u64
) -> (Cx, u64) {
    let Cx {
        names,
        types,
        world,
        known,
        facts,
        ir,
        syms,
    } = old_cx;
    stage2_heap_reset(d_mark);
    let scratch_at_rebuild = stage2_heap_swap(d_perm);
    let fresh = Cx {
        names: names.clone_in_heap(),
        types: types.clone_tail_in_heap(n_nodes, n_rows, n_effs),
        world: world,
        known: known,
        facts: facts,
        ir: ir,
        syms: syms,
    };
    let next_perm = stage2_heap_swap(scratch_at_rebuild);
    (fresh, next_perm)
}

// ----- handlers --------------------------------------------------------------

// One operation clause of a handler (`analysis::OpClause`).
pub copy struct HClause {
    // the operation's index in its effect, and its signature (facts)
    op: u64,
    sig: u64,
    // the clause instance and its IR function
    function: u32,
    base: u32,
    mode: u8,
    // the clause's patterns: hops[pat_start..], pat_count of them
    pat_start: u64,
    pat_count: u64,
    // the continuation's name, or NONE32
    resume: u32,
    // captures: handler_words[cap_start..cap_start+cap_count]
    cap_start: u64,
    cap_count: u64,
    // the operation's parameter types under the effect's arguments:
    // handler_words[param_ty_start..param_ty_start+n], n the signature's parameter count
    param_ty_start: u64,
}

// One `handle` expression (`analysis::Handler`).
pub copy struct Handler {
    // the instance containing it and the instruction's value
    site: u32,
    dest: u64,
    label: u32,
    effect_name: u32,
    // evidence keys, in install order: handler_words[e0..e0+en]
    e0: u64,
    en: u64,
    // the state's type, or NONE32
    state: u32,
    body: u32,
    body_base: u32,
    body_type: u32,
    ret: u32,
    ret_base: u32,
    // the return clause's first pattern: hops[ret_pat]
    ret_pat: u64,
    // the return clause's captures: handler_words[ret_cap_start..ret_cap_start+ret_cap_count]
    ret_cap_start: u64,
    ret_cap_count: u64,
    // clauses[clause_start..clause_start+clause_count]
    clause_start: u64,
    clause_count: u64,
    // alias pairs: ir words alias_at.., alias_count pairs
    alias_at: u64,
    alias_count: u64,
}

fn clause0() -> HClause {
    HClause {
        op: 0,
        sig: 0,
        function: 0,
        base: 0,
        mode: 0,
        pat_start: 0,
        pat_count: 0,
        resume: NONE32,
        cap_start: 0,
        cap_count: 0,
        param_ty_start: 0
    }
}

fn handler0() -> Handler {
    Handler {
        site: 0,
        dest: 0,
        label: NONE32,
        effect_name: 0,
        e0: 0,
        en: 0,
        state: NONE32,
        body: 0,
        body_base: 0,
        body_type: 0,
        ret: 0,
        ret_base: 0,
        ret_pat: 0,
        ret_cap_start: 0,
        ret_cap_count: 0,
        clause_start: 0,
        clause_count: 0,
        alias_at: 0,
        alias_count: 0
    }
}

impl Plan {
    pub fn handler(in self, i: u64) -> Handler {
        match self.handlers.try_get(i) {
            Option::Some(h) => h,
            Option::None => handler0(),
        }
    }

    pub fn clause(in self, i: u64) -> HClause {
        match self.clauses.try_get(i) {
            Option::Some(c) => c,
            Option::None => clause0(),
        }
    }

    // The handler of the `handle` instruction `dest` in instance `site`
    // (`handler_at`), or NONE64.
    pub fn handler_at(in self, site: u32, dest: u64) -> u64 {
        for i in 0..self.handlers.len() {
            let handler_row = self.handler(i);
            if handler_row.site == site && handler_row.dest == dest {
                return i;
            }
        }
        NONE64
    }

    // The clause of operation `op` in handler `handler_index`.
    pub fn clause_of(in self, handler_index: u64, op: u64) -> HClause {
        let handler_row = self.handler(handler_index);
        for i in 0..handler_row.clause_count {
            let clause = self.clause(add(handler_row.clause_start, i));
            if clause.op == op {
                return clause;
            }
        }
        clause0()
    }

    pub fn word(in self, i: u64) -> u32 {
        u32_at(in self.handler_words, i)
    }
}

fn hop(in ctx: Cx, i: u64) -> u64 {
    u64_at(in ctx.facts.hops, i)
}

// `analysis::captures` of the names `hops[at..at+n]`.
fn captures_h(
    in ctx: Cx,
    names_at: u64,
    n: u64,
    aliases_at: u64,
    n_aliases: u64,
    outer: FnInfo
) -> ChunkSeq[u32] {
    let mut out = ChunkSeq::new[u32]();
    for i in 0..n {
        let name = n32(hop(in ctx, add(names_at, i)));
        let alias = alias_of(in ctx, aliases_at, n_aliases, name);
        if alias != NONE32 && ctx.ir.has_local(outer, alias) {
            out.push(name);
        }
    }
    out
}

// Whether `ty` is open (`numeric::open`): an inferred part, a row or a
// function type.
fn open_type(in ctx: Cx, ty: u32) -> bool {
    let node = ctx.types.node(ty);
    if node.kind == TyKind::Infer || node.kind == TyKind::Row || node.kind == TyKind::Fn {
        return true;
    }
    if node.kind == TyKind::Named || node.kind == TyKind::Tuple {
        for i in 0..w(node.n) {
            if open_type(in ctx, ctx.types.arg(ty, i)) {
                return true;
            }
        }
    }
    false
}

// `numeric::instance_key(name, args)`: `$effect:E[T, ..]`, or NONE32
// when there are no arguments or one is open.
pub fn instance_key(inout ctx: Cx, name: u32, in args: ChunkSeq[u32]) -> u32 {
    if args.len() == 0 {
        return NONE32;
    }
    for i in 0..args.len() {
        if open_type(in ctx, u32_at(in args, i)) {
            return NONE32;
        }
    }
    let mut text = ChunkSeq::new[u8]();
    append_ascii(inout text, "$effect:");
    ctx.write_name(name, inout text);
    text.push(91);
    for i in 0..args.len() {
        if i > 0 {
            text.push(44);
            text.push(32);
        }
        let resolved = ctx.default_ty(u32_at(in args, i));
        ctx.show(resolved, inout text);
    }
    text.push(93);
    ctx.intern(in text)
}

// `$effect:E` or `$label:l`.
pub fn prefixed_key(inout ctx: Cx, label: bool, name: u32) -> u32 {
    let mut text = ChunkSeq::new[u8]();
    if label {
        append_ascii(inout text, "$label:");
    } else {
        append_ascii(inout text, "$effect:");
    }
    ctx.write_name(name, inout text);
    ctx.intern(in text)
}

fn append_ascii(inout out: ChunkSeq[u8], in ascii: Str) {
    let bytes = ascii.as_bytes();
    for i in 0..bytes.len() {
        match bytes.try_get(i) {
            Option::Some(byte_val) => out.push(byte_val),
            Option::None => {},
        }
    }
}

// `analysis::handler`: the handler of the `handle` instruction with
// operands at ir word `operands_at` and value `dest`, in instance `site` (IR
// function `outer` under `vars`). Pushes its clauses and side words.
fn handler(
    inout ctx: Cx,
    inout p_clauses: ChunkSeq[HClause],
    inout p_hw: ChunkSeq[u32],
    site: u32,
    outer: FnInfo,
    in vars: TVars,
    dest: u64,
    operands_at: u64
) -> Handler eff [Fail[WErr]] {
    if ctx.facts.stack_switching {
        // WasmFX handlers are lowered in a later part of the port.
        Fail::raise(werr(K_NOT_PORTED, 0, 44));
    }
    // has state, state value, pool, aliases (n, pairs), moves
    let has_state = ctx.ir.word(operands_at);
    let state_val = ctx.ir.word(inc(operands_at));
    let pool = ctx.ir.word(add(operands_at, 2));
    let n_aliases = ctx.ir.word(add(operands_at, 3));
    let aliases_at = add(operands_at, 4);
    let fact = ctx.facts.expr(pool);
    if fact.kind != ExprFactKind::Handler {
        Fail::raise(werr(K_INVALID, 0, 45));
    }
    let outer_vars = vars.vars();
    let mut hop_pos = fact.hop_start;
    let label_word = hop(in ctx, hop_pos);
    let label = if label_word == 0 {
        NONE32
    } else {
        n32(wrapping_sub(label_word, 1))
    };
    let effect_name = n32(hop(in ctx, inc(hop_pos)));
    let n_args = hop(in ctx, add(hop_pos, 2));
    let mut args = ChunkSeq::new[u32]();
    let mut generic = false;
    for i in 0..n_args {
        let ty = ctx.subst(n32(hop(in ctx, add(add(hop_pos, 3), i))), in outer_vars);
        if ctx.mentions_generic(ty) {
            generic = true;
        }
        args.push(ty);
    }
    hop_pos = add(add(hop_pos, 3), n_args);
    if generic {
        Fail::raise(werr(K_UNSUPPORTED, U_GENERIC_EFFECT_INSTANCE, 46));
    }
    let decl_ref = ctx.facts.decl_of(effect_name);
    if decl_ref == 0 {
        Fail::raise(werr(K_INVALID, 0, 47));
    }
    let decl = ctx.facts.decl(wrapping_sub(decl_ref, 1));
    let mut dvars = tvars_new();
    for i in 0..decl.gen_count {
        if i < args.len() {
            dvars.set(
                in ctx.names,
                u32_at(in ctx.facts.gen_syms, add(decl.gen_start, i)),
                u32_at(in args, i)
            );
        }
    }
    let decl_vars = dvars.vars();
    let stateful = hop(in ctx, hop_pos) != 0;
    let body_fn = n32(hop(in ctx, inc(hop_pos)));
    let ret_fn = n32(hop(in ctx, add(hop_pos, 2)));
    hop_pos = add(hop_pos, 3);
    let body_found = ctx.ir.find(body_fn);
    let ret_found = ctx.ir.find(ret_fn);
    if body_found == 0 || ret_found == 0 {
        Fail::raise(werr(K_INVALID, 0, 48));
    }
    let state = if stateful {
        if has_state == 0 {
            Fail::raise(werr(K_INVALID, 0, 49));
        }
        let ty = ctx.ir.value_type(outer, state_val);
        if ty == NONE32 {
            Fail::raise(werr(K_INVALID, 0, 50));
        }
        ctx.subst(ty, in outer_vars)
    } else {
        NONE32
    };
    // the return clause: patterns, then free names
    let n_ret_pats = hop(in ctx, hop_pos);
    let ret_pat = inc(hop_pos);
    let mut clause_pos = inc(hop_pos);
    for i in 0..n_ret_pats {
        clause_pos = pattern_end(in ctx.facts.hops, clause_pos, 0);
    }
    let nfree = hop(in ctx, clause_pos);
    let ret_caps = captures_h(in ctx, inc(clause_pos), nfree, aliases_at, n_aliases, outer);
    clause_pos = add(inc(clause_pos), nfree);
    check_prefix(in ctx, wrapping_sub(ret_found, 1), in ret_caps);
    let ret_cap_start = p_hw.len();
    for i in 0..ret_caps.len() {
        p_hw.push(u32_at(in ret_caps, i));
    }
    let n_clauses = hop(in ctx, clause_pos);
    clause_pos = inc(clause_pos);
    let clause_start = p_clauses.len();
    for clause_index in 0..n_clauses {
        let clause_name = n32(hop(in ctx, clause_pos));
        let clause_fn = n32(hop(in ctx, inc(clause_pos)));
        let pat_count = hop(in ctx, add(clause_pos, 2));
        let pat_start = add(clause_pos, 3);
        let mut pat_pos = pat_start;
        let mut pat_at = ChunkSeq::new[u64]();
        for i in 0..pat_count {
            pat_at.push(pat_pos);
            pat_pos = pattern_end(in ctx.facts.hops, pat_pos, 0);
        }
        let clause_nfree = hop(in ctx, pat_pos);
        let free_at = inc(pat_pos);
        clause_pos = add(inc(pat_pos), clause_nfree);
        let mut op = NONE64;
        for candidate in 0..decl.op_count {
            if ctx.facts.op(add(decl.op_start, candidate)).name == clause_name {
                op = candidate;
                break;
            }
        }
        if op == NONE64 {
            Fail::raise(werr(K_INVALID, 0, 51));
        }
        let op_decl = ctx.facts.op(add(decl.op_start, op));
        let sig = ctx.facts.sig(op_decl.sig);
        let clause_found = ctx.ir.find(clause_fn);
        if clause_found == 0 {
            Fail::raise(werr(K_INVALID, 0, 52));
        }
        let n = sig.pn;
        let k_index = if stateful { inc(n) } else { n };
        let mut resume = NONE32;
        if k_index < pat_count {
            let at = u64_at(in pat_at, k_index);
            if hop(in ctx, at) == Pat::Bind {
                resume = n32(hop(in ctx, add(at, 3)));
            }
        }
        let caps = captures_h(in ctx, free_at, clause_nfree, aliases_at, n_aliases, outer);
        check_prefix(in ctx, wrapping_sub(clause_found, 1), in caps);
        let mode = clause_mode(in ctx, wrapping_sub(clause_found, 1), resume);
        // An `inout` operation argument is a cell copied back when the
        // operation returns: only a clause that resumes in tail position
        // makes all its writes before that.
        for i in 0..n {
            if ctx.facts.param(add(sig.p0, i)).pass != TyPass::Inout {
                continue;
            }
            let bound = if i < pat_count {
                let kind = hop(in ctx, u64_at(in pat_at, i));
                kind == Pat::Bind || kind == Pat::Wild
            } else {
                false
            };
            if mode != M_TAIL || !bound {
                Fail::raise(werr(K_UNSUPPORTED, U_INOUT_EFFECT_ARGUMENT, 53));
            }
        }
        if mode == M_OTHER {
            // A clause that resumes other than in tail position.
            Fail::raise(werr(K_NOT_PORTED, 0, 54));
        }
        let cap_start = p_hw.len();
        for i in 0..caps.len() {
            p_hw.push(u32_at(in caps, i));
        }
        let param_ty_start = p_hw.len();
        for i in 0..n {
            let ty = ctx.subst(ctx.facts.param(add(sig.p0, i)).ty, in decl_vars);
            p_hw.push(ty);
        }
        let function = instance_name(inout ctx, clause_fn, in vars);
        p_clauses.push(HClause {
            op: op,
            sig: op_decl.sig,
            function: function,
            base: clause_fn,
            mode: mode,
            pat_start: pat_start,
            pat_count: pat_count,
            resume: resume,
            cap_start: cap_start,
            cap_count: caps.len(),
            param_ty_start: param_ty_start
        });
    }
    if n_ret_pats == 0 {
        Fail::raise(werr(K_INVALID, 0, 55));
    }
    // `handler_keys`
    let key_start = p_hw.len();
    let by_name = prefixed_key(inout ctx, false, effect_name);
    p_hw.push(by_name);
    let exact = instance_key(inout ctx, effect_name, in args);
    if exact != NONE32 {
        p_hw.push(exact);
    }
    if label != NONE32 {
        let label_key = prefixed_key(inout ctx, true, label);
        p_hw.push(label_key);
    }
    let key_count = wrapping_sub(p_hw.len(), key_start);
    let body_type = ctx.subst(ctx.ir.info(wrapping_sub(body_found, 1)).result, in outer_vars);
    let body = instance_name(inout ctx, body_fn, in vars);
    let ret = instance_name(inout ctx, ret_fn, in vars);
    Handler {
        site: site,
        dest: dest,
        label: label,
        effect_name: effect_name,
        e0: key_start,
        en: key_count,
        state: state,
        body: body,
        body_base: body_fn,
        body_type: body_type,
        ret: ret,
        ret_base: ret_fn,
        ret_pat: ret_pat,
        ret_cap_start: ret_cap_start,
        ret_cap_count: ret_caps.len(),
        clause_start: clause_start,
        clause_count: wrapping_sub(p_clauses.len(), clause_start),
        alias_at: aliases_at,
        alias_count: n_aliases
    }
}

// The values instruction `ins` reads (`analysis::operands`).
pub fn inst_operands(in ctx: Cx, op: u8, args_at: u64) -> ChunkSeq[u64] {
    let mut out = ChunkSeq::new[u64]();
    if op == Op::Bind || op == Op::Exit || op == Op::Project || op == Op::Try {
        out.push(ctx.ir.word(args_at));
    } else if op == Op::Write {
        out.push(ctx.ir.word(add(args_at, 2)));
    } else if op == Op::Unary {
        out.push(ctx.ir.word(inc(args_at)));
    } else if op == Op::Binary {
        out.push(ctx.ir.word(inc(args_at)));
        out.push(ctx.ir.word(add(args_at, 2)));
    } else if op == Op::Index {
        out.push(ctx.ir.word(args_at));
        out.push(ctx.ir.word(inc(args_at)));
    } else if op == Op::Tuple || op == Op::Vector {
        let list_at = if op == Op::Vector {
            inc(args_at)
        } else {
            args_at
        };
        let n = ctx.ir.word(list_at);
        for i in 0..n {
            out.push(ctx.ir.word(add(inc(list_at), i)));
        }
    } else if op == Op::Data {
        let n = ctx.ir.word(inc(args_at));
        for i in 0..n {
            out.push(ctx.ir.word(add(add(args_at, 3), wrapping_mul(2, i))));
        }
    } else if op == Op::Call
        || op == Op::Tiled
        || op == Op::Seq
        || op == Op::Fip
        || op == Op::Indirect
    {
        if op == Op::Indirect {
            out.push(ctx.ir.word(args_at));
        }
        // callee/pool, then args: n, n x (pass, value, root, path)
        let n = ctx.ir.word(inc(args_at));
        for i in 0..n {
            out.push(ctx.ir.word(add(add(args_at, 3), wrapping_mul(4, i))));
        }
    } else if op == Op::Handle {
        if ctx.ir.word(args_at) != 0 {
            out.push(ctx.ir.word(inc(args_at)));
        }
    }
    out
}

fn contains64(in set: ChunkSeq[u64], value: u64) -> bool {
    for i in 0..set.len() {
        if u64_at(in set, i) == value {
            return true;
        }
    }
    false
}

// `flows_to_return`: whether `value`, defined last in block `block_index` of IR
// function `fn_index`, reaches a `Return` unchanged.
pub fn flows_to_return(
    in ctx: Cx,
    fn_index: u64,
    block_index: u64,
    value: u64,
    depth: u64
) -> bool {
    if depth > 64 {
        return false;
    }
    let row = ctx.ir.program.function(fn_index);
    let blk = ctx.ir.program.block(add(row.b0, block_index));
    if blk.term == Term::Return {
        return ctx.ir.word(blk.ta) == value;
    }
    if blk.term != Term::Jump {
        return false;
    }
    let target_index = ctx.ir.word(blk.ta);
    let n = ctx.ir.word(inc(blk.ta));
    let mut pos = NONE64;
    let mut count: u64 = 0;
    for i in 0..n {
        if ctx.ir.word(add(add(blk.ta, 2), i)) == value {
            if pos == NONE64 {
                pos = i;
            }
            count = inc(count);
        }
    }
    if pos == NONE64 || count != 1 {
        return false;
    }
    let target = ctx.ir.program.block(add(row.b0, target_index));
    if target.ic != 0 {
        return false;
    }
    let (param_at, param_count) = ctx.ir.block_params(fn_index, target_index);
    if pos >= param_count {
        return false;
    }
    flows_to_return(in ctx, fn_index, target_index, ctx.ir.word(add(param_at, pos)), inc(depth))
}

// The blocks a terminator can branch to other than by a jump (a branch's
// or a match's targets) include `block_index`.
fn branches_to(in ctx: Cx, blk_term: u8, term_args: u64, block_index: u64) -> bool {
    if blk_term == Term::Branch {
        return ctx.ir.word(inc(term_args)) == block_index
            || ctx.ir.word(add(term_args, 2)) == block_index;
    }
    if blk_term == Term::Match {
        let n = ctx.ir.word(inc(term_args));
        let mut pos = add(term_args, 2);
        for i in 0..n {
            pos = pattern_end(in ctx.ir.program.ops, pos, 0);
            if ctx.ir.word(pos) == block_index {
                return true;
            }
            pos = inc(pos);
        }
    }
    false
}

// `resumed_value`: whether `value` returned from block `block_index` is (through
// join parameters fed only by jumps) a tail resumption result.
fn resumed_value(
    in ctx: Cx,
    fn_index: u64,
    block_index: u64,
    value: u64,
    in tail: ChunkSeq[u64],
    depth: u64
) -> bool {
    if contains64(in tail, value) {
        return true;
    }
    if depth > 64 {
        return false;
    }
    let (param_at, param_count) = ctx.ir.block_params(fn_index, block_index);
    let mut pos = NONE64;
    for i in 0..param_count {
        if ctx.ir.word(add(param_at, i)) == value {
            pos = i;
            break;
        }
    }
    if pos == NONE64 {
        return false;
    }
    let row = ctx.ir.program.function(fn_index);
    let mut any = false;
    for pred_index in 0..row.bc {
        let pred = ctx.ir.program.block(add(row.b0, pred_index));
        if pred.term == Term::Jump && ctx.ir.word(pred.ta) == block_index {
            any = true;
            let arg = ctx.ir.word(add(add(pred.ta, 2), pos));
            if !resumed_value(in ctx, fn_index, pred_index, arg, in tail, inc(depth)) {
                return false;
            }
        }
        if branches_to(in ctx, pred.term, pred.ta, block_index) {
            return false;
        }
    }
    any
}

// `analysis::clause_mode` of the clause in IR function `fn_index` whose
// continuation is `resume` (NONE32: none).
fn clause_mode(in ctx: Cx, fn_index: u64, resume: u32) -> u8 eff [Fail[WErr]] {
    if resume == NONE32 {
        return M_ABORT;
    }
    let row = ctx.ir.program.function(fn_index);
    let mut reads = ChunkSeq::new[u64]();
    for block_index in 0..row.bc {
        let blk = ctx.ir.program.block(add(row.b0, block_index));
        for inst_index in 0..blk.ic {
            let instr = ctx.ir.program.inst(add(blk.i0, inst_index));
            if instr.op == Op::Read && n32(ctx.ir.word(instr.a)) == resume {
                if ctx.ir.word(inc(instr.a)) != 0 {
                    Fail::raise(werr(K_UNSUPPORTED, U_FIRST_CLASS_CONTINUATION, 56));
                }
                reads.push(widen_u64(instr.dest));
            }
        }
    }
    // Every read of the continuation must be the callee of an `Indirect`.
    let mut calls = ChunkSeq::new[u64]();
    for block_index in 0..row.bc {
        let blk = ctx.ir.program.block(add(row.b0, block_index));
        for inst_index in 0..blk.ic {
            let instr = ctx.ir.program.inst(add(blk.i0, inst_index));
            let args_at = instr.a;
            if instr.op == Op::Indirect && contains64(in reads, ctx.ir.word(args_at)) {
                let n = ctx.ir.word(inc(args_at));
                for k in 0..n {
                    if contains64(in reads, ctx.ir.word(add(add(args_at, 3), wrapping_mul(4, k)))) {
                        Fail::raise(werr(K_UNSUPPORTED, U_FIRST_CLASS_CONTINUATION, 57));
                    }
                }
                calls.push(widen_u64(instr.dest));
            } else if instr.op == Op::Closure || instr.op == Op::Handle {
                // A closure or nested handler that names the continuation
                // captures it as a value.
                let (pool, aliases_at, n_aliases) = if instr.op == Op::Closure {
                    (ctx.ir.word(args_at), add(args_at, 2), ctx.ir.word(inc(args_at)))
                } else {
                    (ctx.ir.word(add(args_at, 2)), add(args_at, 4), ctx.ir.word(add(args_at, 3)))
                };
                let fact = ctx.facts.expr(pool);
                for i in 0..fact.free_count {
                    let name = ctx.facts.free_at(add(fact.free_start, i));
                    if name == resume || alias_of(in ctx, aliases_at, n_aliases, name) == resume {
                        Fail::raise(werr(K_UNSUPPORTED, U_FIRST_CLASS_CONTINUATION, 58));
                    }
                }
            } else {
                let used = inst_operands(in ctx, instr.op, args_at);
                for k in 0..used.len() {
                    if contains64(in reads, u64_at(in used, k)) {
                        Fail::raise(werr(K_UNSUPPORTED, U_FIRST_CLASS_CONTINUATION, 59));
                    }
                }
            }
        }
        let term_vals = term_operands(in ctx, blk.term, blk.ta);
        for k in 0..term_vals.len() {
            if contains64(in reads, u64_at(in term_vals, k)) {
                Fail::raise(werr(K_UNSUPPORTED, U_FIRST_CLASS_CONTINUATION, 60));
            }
        }
    }
    if calls.len() == 0 {
        return M_ABORT;
    }
    // Tail-resumptive: each resumption result flows unchanged to a return,
    // and every return returns a resumption result.
    let mut tail = ChunkSeq::new[u64]();
    for block_index in 0..row.bc {
        let blk = ctx.ir.program.block(add(row.b0, block_index));
        if blk.ic == 0 {
            continue;
        }
        let last = ctx.ir.program.inst(add(blk.i0, wrapping_sub(blk.ic, 1)));
        let dest = widen_u64(last.dest);
        if contains64(in calls, dest)
            && flows_to_return(in ctx, fn_index, block_index, dest, 0)
            && !contains64(in tail, dest)
        {
            tail.push(dest);
        }
    }
    let mut used_elsewhere = false;
    let mut returns_resumed = true;
    for block_index in 0..row.bc {
        let blk = ctx.ir.program.block(add(row.b0, block_index));
        for inst_index in 0..blk.ic {
            let instr = ctx.ir.program.inst(add(blk.i0, inst_index));
            let used = inst_operands(in ctx, instr.op, instr.a);
            for k in 0..used.len() {
                if contains64(in calls, u64_at(in used, k)) {
                    used_elsewhere = true;
                }
            }
        }
        if blk.term == Term::Return {
            if !resumed_value(in ctx, fn_index, block_index, ctx.ir.word(blk.ta), in tail, 0) {
                returns_resumed = false;
            }
        }
    }
    if tail.len() == calls.len() && !used_elsewhere && returns_resumed {
        M_TAIL
    } else {
        M_OTHER
    }
}

// `terminator_operands`.
fn term_operands(in ctx: Cx, term: u8, term_args: u64) -> ChunkSeq[u64] {
    let mut out = ChunkSeq::new[u64]();
    if term == Term::Return || term == Term::Branch || term == Term::Match {
        out.push(ctx.ir.word(term_args));
    } else if term == Term::Jump {
        let n = ctx.ir.word(inc(term_args));
        for i in 0..n {
            out.push(ctx.ir.word(add(add(term_args, 2), i)));
        }
    }
    out
}
