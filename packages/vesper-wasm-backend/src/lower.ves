const R_HANDLER_BODY: u8 = 1;
// check-data type kinds
const K_NAMED: u8 = 1;
const K_TUPLE: u8 = 2;
const K_FN: u8 = 3;
// Pass
const P_INOUT: u8 = 1;
// IR opcodes and terminators (ir_words.rs)
const IR_CONST: u8 = 0;
const IR_UNIT: u8 = 1;
const IR_READ: u8 = 2;
const IR_BIND: u8 = 3;
const IR_WRITE: u8 = 4;
const IR_UNARY: u8 = 5;
const IR_BINARY: u8 = 6;
