const OP_I32_LOAD16_U: u8 = 47;
const OP_I64_LOAD8_U: u8 = 49;
const OP_I64_LOAD16_U: u8 = 51;
const OP_I64_LOAD32_U: u8 = 53;
const OP_I32_STORE: u8 = 54;
const OP_I64_STORE: u8 = 55;
const OP_F64_STORE: u8 = 57;
