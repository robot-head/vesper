// Place IR to core Wasm (src/wasm_backend/lower.rs), instruction for
// instruction: every function body here emits what the Rust `Emit` emits,
// allocating its locals in the same order, so the modules are byte-equal.
//
// Not ported yet (part 2 of #1289): lexical handlers (their dispatch,
// return, abort, resume and WasmFX functions), the WASI host frames and
// the evidence a callable binds at a call site; a program that needs one
// raises `K_NOT_PORTED`. Their absence also means the evidence key set is
// empty, so every operation finds no frame and traps, as in Rust.

use @vesper/check-data::util::{
    add,
    inc,
    n32,
    u32_at,
    u64_at,
    w
};
use @vesper/check-data::types::{
    Vars,
    vars_new
};
use self::enc::{
    Code,
    ValTy,
    code_new,
    function_bytes,
    vt
};
use self::err::{
    WErr,
    werr
};
use self::ir::{
    FnInfo,
    pattern_end
};
use self::module::{
    Builder,
    builder_new
};
use self::plan::{
    Cx,
    Inst,
    Plan,
    Shape,
    TVars,
    alias_of,
    captures,
    closure_operands,
    cmp_syms,
    contains32,
    instance_name,
    tvars_new
};

const VT_I32: u8 = 127;
const VT_I64: u8 = 126;
const VT_F64: u8 = 124;
const VT_REF_NULL: u8 = 99;
const VT_REF: u8 = 100;
const OP_UNREACHABLE: u8 = 0;
const OP_NOP: u8 = 1;
const OP_BLOCK: u8 = 2;
const OP_LOOP: u8 = 3;
const OP_IF: u8 = 4;
const OP_ELSE: u8 = 5;
