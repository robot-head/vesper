const SC_U64: u8 = 1;
const SC_U32: u8 = 2;
const SC_U8: u8 = 3;
const SC_BOOL: u8 = 4;
const SC_F64: u8 = 5;
const SC_UNIT: u8 = 6;
const SC_NEVER: u8 = 7;
