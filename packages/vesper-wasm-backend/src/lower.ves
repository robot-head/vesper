// IntegerKind of a scalar: 0 none, else the scalar + 1
const IK_NONE: u8 = 0;

// Handler frame slots: the dispatch slot, the state, the aborting
// operation, its arguments, then (`HFns`) the pending list, the evidence
// snapshot, the captures and the body's cells.
const F_DISPATCH: u64 = 0;
const F_STATE: u64 = 8;
const F_ABORT_OP: u64 = 16;
const F_ARGS: u64 = 24;

// Callable block slots.
const C_EVIDENCE: u64 = 8;
const C_CAPTURES: u64 = 16;
const MAX_BLOCKS: u64 = 4096;

// A named local of the function being emitted: its Wasm local and
// whether it holds a cell address.
copy struct NameSlot {
    name: u32,
    local: u32,
    cell: bool,
}

// One function body under construction (`Emit`).
pub struct Em {
    inst: Inst,
    info: FnInfo,
    code: Code,
    locals: ChunkSeq[ValTy],
    nparams: u32,
    names: ChunkSeq[NameSlot],
    // value id -> local + 1
    values: ChunkSeq[u32],
    generics: ChunkSeq[u32],
    vars: Vars,
    mark: u32,
    // The label targets of the open `block`/`loop` frames, innermost last,
    // when the body is structured (a cyclic block graph, `structured_body`).
    frames: ChunkSeq[u64],
    structured: bool,
    // value id -> (address local | stride << 32) + 1 of an element view
    // (`s[i]` read for `swap(inout s[i], ..)`)
    elems: ChunkSeq[u64],
    elem_names: ChunkSeq[u64],
    // An operation clause: its continuation's name (NONE32: none), the
    // values that read it, its handler and frame local (NONE: none).
    resume: u32,
    resume_reads: ChunkSeq[u64],
    clause_handler: u64,
    frame: u32,
}

// The functions and frame layout of one handler (`HandlerFns`).
copy struct HFns {
    dispatch_slot: u32,
    dispatch: u32,
    ret: u32,
    abort: u32,
    frame_size: u64,
    pending_offset: u64,
    env_offset: u64,
    body_offset: u64,
    // the captures' offsets, in name order: hcap_name/hcap_off[c0..c0+cn]
    c0: u64,
    cn: u64,
}

fn em_new(inst: Inst, info: FnInfo) -> Em {
    let mut c = code_new();
    c.bytes.reserve(256);
    let mut locals = ChunkSeq::new[ValTy]();
    locals.reserve(32);
    let mut names = ChunkSeq::new[NameSlot]();
    names.reserve(32);
    let mut values = ChunkSeq::new[u32]();
    values.reserve(64);
    Em {
        inst: inst,
        info: info,
        code: c,
        locals: locals,
        nparams: 0,
        names: names,
        values: values,
        generics: ChunkSeq::new[u32](),
        vars: vars_new(),
        mark: NONE32,
        frames: ChunkSeq::new[u64](),
        structured: false,
        elems: ChunkSeq::new[u64](),
        elem_names: ChunkSeq::new[u64](),
        resume: NONE32,
        resume_reads: ChunkSeq::new[u64](),
        clause_handler: NONE64,
        frame: NONE32,
    }
}

copy struct Pending {
    idx: u32,
    ty: u32,
}

// `row_label_bindings`: labels[i], sources[i], targets[t0[i]..t0[i]+tn[i]].
struct LabelBindings {
    labels: ChunkSeq[u32],
    sources: ChunkSeq[u32],
    t0: ChunkSeq[u64],
    tn: ChunkSeq[u64],
    targets: ChunkSeq[u32],
}

copy struct Cell {
    cell: u32,
    root: u32,
    path: u64,
}

pub struct L {
    cx: Cx,
    plan: Plan,
    b: Builder,
    // instance key -> function index + 1
    funcs: ChunkSeq[u32],
    heap: u32,
    abort: u32,
    cps: u32,
    tail_mark: u32,
    // the evidence globals, in key order (`env`)
    env_keys: ChunkSeq[u32],
    env_globals: ChunkSeq[u32],
    alloc: u32,
    dispatch_ty: u32,
    // type display -> `$eq` function + 1
    eq: ChunkSeq[u32],
    eq_pending: ChunkSeq[Pending],
    // function key -> trampoline slot + 1
    trampolines: ChunkSeq[u32],
    h_str_eq: u32,
    h_fmod: u32,
    h_seq_reserve: u32,
    h_bytes_eq: u32,
    h_utf8: u32,
    // the WASI imports and shims of the standard I/O libraries
    host: Host,
    // The program has `Op::Seq` operations, so a string may be a buffer
    // with a capacity (`seq`); Rust lowers none, and without them every
    // helper stays byte-equal to its.
    seqs: bool,
    // literal text -> address + 1
    strings: ChunkSeq[u64],
    // the static data of each constant table (`$table$NAME`) by callee, + 1
    tables: ChunkSeq[u64],
    wide_fns: ChunkSeq[u32],
    // type display -> `$copy` function + 1
    copies: ChunkSeq[u32],
    hfns: ChunkSeq[HFns],
    hcap_name: ChunkSeq[u32],
    hcap_off: ChunkSeq[u64],
    arity: u64,
    instructions: u64,
    max_instructions: u64,
    e: Em,
}

fn set32(inout table: ChunkSeq[u32], key: u32, value: u32) {
    let i = w(key);
    loop {
        if table.len() > i {
            break;
        }
        table.push(0);
    }
    let ok = table.try_set(i, value);
}

pub fn set64(inout table: ChunkSeq[u64], key: u32, value: u64) {
    let i = w(key);
    loop {
        if table.len() > i {
            break;
        }
        table.push(0);
    }
    let ok = table.try_set(i, value);
}

pub fn get32(in table: ChunkSeq[u32], key: u32) -> u32 {
    u32_at(in table, w(key))
}

pub fn i64s(n: u64) -> ChunkSeq[ValTy] {
    let mut tys = ChunkSeq::new[ValTy]();
    for i in 0..n {
        tys.push(vt(VT_I64));
    }
    tys
}

fn ik_unsigned(scalar: u8) -> bool {
    scalar == SC_U64 || scalar == SC_U32 || scalar == SC_U16 || scalar == SC_U8
}

fn ik_signed(scalar: u8) -> bool {
    scalar == SC_I64 || scalar == SC_I32 || scalar == SC_I16 || scalar == SC_I8
}

fn ik_bits(scalar: u8) -> u64 {
    if scalar == SC_U8 || scalar == SC_I8 {
        8
    } else if scalar == SC_U16 || scalar == SC_I16 {
        16
    } else if scalar == SC_U32 || scalar == SC_I32 {
        32
    } else {
        64
    }
}

fn ik_mask(scalar: u8) -> u64 {
    if scalar == SC_U8 {
        255
    } else if scalar == SC_U16 {
        65535
    } else if scalar == SC_U32 {
        4294967295
    } else {
        NONE64
    }
}

fn ik_min(scalar: u8) -> i64 {
    if scalar == SC_I8 {
        -128
    } else if scalar == SC_I16 {
        -32768
    } else if scalar == SC_I32 {
        -2147483648
    } else {
        I64_MIN
    }
}

fn ik_max(scalar: u8) -> i64 {
    if scalar == SC_I8 {
        127
    } else if scalar == SC_I16 {
        32767
    } else if scalar == SC_I32 {
        2147483647
    } else {
        9223372036854775807
    }
}

fn is_int(scalar: u8) -> bool {
    ik_unsigned(scalar) || ik_signed(scalar)
}

fn lo_mask(n: u64) -> u64 {
    n
}

pub fn lowerer_new(sink cx: Cx, sink plan: Plan, max_instructions: u64) -> L eff [Fail[WErr]] {
    let mut b = builder_new();
    // Imports precede every declared function.
    let host = host_new(inout b, in plan.host);
    let heap = b.global(0);
    b.set_heap_global(heap);
    let abort = b.global(0);
    let cps = b.global(0);
    let tail_mark = b.global(0);
    let mut env_keys = ChunkSeq::new[u32]();
    let mut env_globals = ChunkSeq::new[u32]();
    for i in 0..plan.keys.len() {
        env_keys.push(u32_at(in plan.keys, i));
        env_globals.push(b.global(0));
    }
    let alloc = b.declare(in i64s(1), in i64s(1));
    let arity = plan.max_arity;
    let dispatch_ty = b.func_type(in i64s(add(2, arity)), in i64s(1));
    if cx.f.stack_switching && plan.keys.len() != 0 {
        Fail::raise(werr(K_NOT_PORTED, 0, 100));
    }
    let mut seqs = false;
    for i in 0..cx.ir.p.pool.len() {
        if cx.ir.p.pool_row(i).kind == PoolKind::Seq {
            seqs = true;
        }
    }
    L {
        cx: cx,
        plan: plan,
        b: b,
        funcs: ChunkSeq::new[u32](),
        heap: heap,
        abort: abort,
        cps: cps,
        tail_mark: tail_mark,
        env_keys: env_keys,
        env_globals: env_globals,
        alloc: alloc,
        dispatch_ty: dispatch_ty,
        eq: ChunkSeq::new[u32](),
        eq_pending: ChunkSeq::new[Pending](),
        trampolines: ChunkSeq::new[u32](),
        h_str_eq: NONE32,
        h_fmod: NONE32,
        h_seq_reserve: NONE32,
        h_bytes_eq: NONE32,
        h_utf8: NONE32,
        host: host,
        seqs: seqs,
        strings: ChunkSeq::new[u64](),
        tables: ChunkSeq::new[u64](),
        wide_fns: ChunkSeq::new[u32](),
        copies: ChunkSeq::new[u32](),
        hfns: ChunkSeq::new[HFns](),
        hcap_name: ChunkSeq::new[u32](),
        hcap_off: ChunkSeq::new[u64](),
        arity: arity,
        instructions: 0,
        max_instructions: max_instructions,
        e: em_new(plan_inst0(), info0()),
    }
}

fn plan_inst0() -> Inst {
    Inst {
        key: 0,
        base: 0,
        fi: 0,
        v0: 0,
        vn: 0,
        role: 0,
        handler: 0,
        op: 0,
        c0: 0,
        cn: 0,
        l0: 0,
        ln: 0
    }
}

fn info0() -> FnInfo {
    FnInfo { name: 0, p0: 0, pn: 0, result: 0, effects: 0, l0: 0, ln: 0, v0: 0, vn: 0 }
}

// A body with one `(n, i64)` locals entry.
pub fn body_n(n: u64, in c: Code) -> ChunkSeq[u8] {
    let mut counts = ChunkSeq::new[u32]();
    let mut types = ChunkSeq::new[ValTy]();
    counts.push(wrapping_u32(n));
    types.push(vt(VT_I64));
    function_bytes(in counts, in types, in c)
}

// A body with one `(1, t)` entry per local.
pub fn body_each(in locals: ChunkSeq[ValTy], in c: Code) -> ChunkSeq[u8] {
    let mut counts = ChunkSeq::new[u32]();
    counts.reserve(locals.len());
    for i in 0..locals.len() {
        counts.push(1);
    }
    function_bytes(in counts, in locals, in c)
}

// Reachable blocks from 0 in a topological order (`topological`), or in
// reverse postorder when the graph is cyclic; the second result is false
// then.
fn topological(in l: L, fn_index: u64) -> (ChunkSeq[u64], bool) {
    let row = l.cx.ir.p.function(fn_index);
    let n = row.bc;
    let mut state = ChunkSeq::new[u8]();
    state.reserve(n);
    for i in 0..n {
        state.push(0);
    }
    let mut post = ChunkSeq::new[u64]();
    post.reserve(n);
    let mut acyclic = true;
    let mut stack_blocks = ChunkSeq::new[u64]();
    stack_blocks.reserve(n);
    let mut stack_succ = ChunkSeq::new[u64]();
    stack_succ.reserve(n);
    if n == 0 {
        return (post, false);
    }
    stack_blocks.push(0);
    stack_succ.push(0);
    let ok = state.try_set(0, 1);
    loop {
        if stack_blocks.len() == 0 {
            break;
        }
        let top = wrapping_sub(stack_blocks.len(), 1);
        let block = u64_at(in stack_blocks, top);
        let i = u64_at(in stack_succ, top);
        stack_blocks.truncate(top);
        stack_succ.truncate(top);
        let (s0, n_succ) = successors(in l, fn_index, block);
        if i < n_succ {
            stack_blocks.push(block);
            stack_succ.push(inc(i));
            let succ = successor(in l, fn_index, block, i);
            if succ >= n {
                return (post, false);
            }
            let succ_state = match state.try_get(succ) {
                Option::Some(value) => value,
                Option::None => 0,
            };
            if succ_state == 0 {
                let ok2 = state.try_set(succ, 1);
                stack_blocks.push(succ);
                stack_succ.push(0);
            } else if succ_state == 1 {
                // A back edge: the order is still a reverse postorder.
                acyclic = false;
            }
        } else {
            let ok3 = state.try_set(block, 2);
            post.push(block);
        }
    }
    let mut order = ChunkSeq::new[u64]();
    order.reserve(post.len());
    let mut remaining = post.len();
    loop {
        if remaining == 0 {
            break;
        }
        remaining = wrapping_sub(remaining, 1);
        order.push(u64_at(in post, remaining));
    }
    (order, acyclic)
}

// The reachable block graph of a cyclic body: reverse postorder, immediate
// dominators and loop headers (`structured_body`).
struct Cfg {
    order: ChunkSeq[u64],
    idom: ChunkSeq[u64],
    // block -> 1 when a back edge enters it
    header: ChunkSeq[u8],
}

// Immediate dominators by Cooper, Harvey and Kennedy's iteration over the
// reverse postorder `order`, and the loop headers.
fn cfg_of(in l: L, fn_index: u64, in order: ChunkSeq[u64]) -> Cfg {
    let row = l.cx.ir.p.function(fn_index);
    let n = row.bc;
    let mut pos = ChunkSeq::new[u64]();
    pos.reserve(n);
    let mut idom = ChunkSeq::new[u64]();
    idom.reserve(n);
    let mut header = ChunkSeq::new[u8]();
    header.reserve(n);
    for i in 0..n {
        pos.push(NONE64);
        idom.push(NONE64);
        header.push(0);
    }
    for rank in 0..order.len() {
        let ok = pos.try_set(u64_at(in order, rank), rank);
    }
    let mut edge_src = ChunkSeq::new[u64]();
    edge_src.reserve(n);
    let mut edge_dst = ChunkSeq::new[u64]();
    edge_dst.reserve(n);
    for rank in 0..order.len() {
        let block = u64_at(in order, rank);
        let (s0, n_succ) = successors(in l, fn_index, block);
        for i in 0..n_succ {
            let succ = successor(in l, fn_index, block, i);
            edge_src.push(block);
            edge_dst.push(succ);
            if u64_at(in pos, succ) <= rank {
                let ok = header.try_set(succ, 1);
            }
        }
    }
    let entry = u64_at(in order, 0);
    let ok = idom.try_set(entry, entry);
    let mut changed = true;
    loop {
        if !changed {
            break;
        }
        changed = false;
        for rank in 1..order.len() {
            let block = u64_at(in order, rank);
            let mut next = NONE64;
            for edge in 0..edge_src.len() {
                if u64_at(in edge_dst, edge) == block {
                    let pred = u64_at(in edge_src, edge);
                    if u64_at(in idom, pred) != NONE64 {
                        if next == NONE64 {
                            next = pred;
                        } else {
                            next = intersect(in idom, in pos, pred, next);
                        }
                    }
                }
            }
            if next != u64_at(in idom, block) {
                let ok2 = idom.try_set(block, next);
                changed = true;
            }
        }
    }
    Cfg { order: copy_u64s(in order), idom: idom, header: header }
}

// The nearest common dominator of `finger_a` and `finger_b`.
fn intersect(in idom: ChunkSeq[u64], in pos: ChunkSeq[u64], lhs: u64, rhs: u64) -> u64 {
    let mut finger_a = lhs;
    let mut finger_b = rhs;
    loop {
        if finger_a == finger_b {
            break;
        }
        loop {
            if u64_at(in pos, finger_a) <= u64_at(in pos, finger_b) {
                break;
            }
            finger_a = u64_at(in idom, finger_a);
        }
        loop {
            if u64_at(in pos, finger_b) <= u64_at(in pos, finger_a) {
                break;
            }
            finger_b = u64_at(in idom, finger_b);
        }
    }
    finger_a
}

fn copy_u64s(in src: ChunkSeq[u64]) -> ChunkSeq[u64] {
    let mut out = ChunkSeq::new[u64]();
    out.reserve(src.len());
    for i in 0..src.len() {
        out.push(u64_at(in src, i));
    }
    out
}

// The successor count of block `block_index` (and its first operand index).
fn successors(in l: L, fn_index: u64, block_index: u64) -> (u64, u64) {
    let row = l.cx.ir.p.function(fn_index);
    let blk = l.cx.ir.p.block(add(row.b0, block_index));
    if blk.term == Term::Jump {
        return (blk.ta, 1);
    }
    if blk.term == Term::Branch {
        return (blk.ta, 2);
    }
    if blk.term == Term::Match {
        return (blk.ta, l.cx.ir.word(inc(blk.ta)));
    }
    (blk.ta, 0)
}

// Successor `i` of block `block_index`, in `Terminator` order.
fn successor(in l: L, fn_index: u64, block_index: u64, i: u64) -> u64 {
    let row = l.cx.ir.p.function(fn_index);
    let blk = l.cx.ir.p.block(add(row.b0, block_index));
    if blk.term == Term::Jump {
        return l.cx.ir.word(blk.ta);
    }
    if blk.term == Term::Branch {
        return l.cx.ir.word(add(blk.ta, inc(i)));
    }
    // match: v, n, n x (pattern, block)
    let mut pos = add(blk.ta, 2);
    for k in 0..i {
        pos = inc(pattern_end(in l.cx.ir.p.ops, pos, 0));
    }
    l.cx.ir.word(pattern_end(in l.cx.ir.p.ops, pos, 0))
}

impl L {
    // ----- small helpers ---------------------------------------------------

    fn ir_info(in self, key: u32) -> FnInfo {
        let found = self.plan.find(key);
        if found != 0 {
            return self.cx.ir.info(self.plan.inst(wrapping_sub(found, 1)).fi);
        }
        let fn_ref = self.cx.ir.find(key);
        self.cx.ir.info(wrapping_sub(fn_ref, 1))
    }

    fn inst_of(in self, key: u32) -> Inst {
        let found = self.plan.find(key);
        self.plan.inst(wrapping_sub(found, 1))
    }

    pub fn func_of(in self, key: u32) -> u32 {
        wrapping_sub(get32(in self.funcs, key), 1)
    }

    fn has_func(in self, key: u32) -> bool {
        get32(in self.funcs, key) != 0
    }

    fn base_of(in self, key: u32) -> u32 {
        let found = self.plan.find(key);
        if found == 0 {
            key
        } else {
            self.plan.inst(wrapping_sub(found, 1)).base
        }
    }

    fn vars_of_key(in self, key: u32) -> TVars {
        let found = self.plan.find(key);
        if found == 0 {
            tvars_new()
        } else {
            self.plan.vars(self.plan.inst(wrapping_sub(found, 1)))
        }
    }

    fn role_of(in self, key: u32) -> u8 {
        let found = self.plan.find(key);
        if found == 0 {
            255
        } else {
            self.plan.inst(wrapping_sub(found, 1)).role
        }
    }

    fn type_key(inout self, ty: u32) -> u32 {
        let mut text = ChunkSeq::new[u8]();
        self.cx.show(ty, inout text);
        self.cx.intern(in text)
    }

    fn infer(in self) -> u32 {
        self.cx.types.infer
    }

    // ----- declarations ----------------------------------------------------

    pub fn declare_all(inout self) {
        for i in 0..self.plan.insts.len() {
            let inst = self.plan.inst(i);
            let n_params = self.signature(inst);
            let idx = self.b.declare(in i64s(n_params), in i64s(1));
            set32(inout self.funcs, inst.key, inc32(idx));
        }
        for i in 0..self.plan.handlers.len() {
            let handler_row = self.plan.handler(i);
            let dispatch = self.b.declare(in i64s(add(2, self.arity)), in i64s(1));
            let dispatch_slot = self.b.table_slot(dispatch);
            let ret = self.b.declare(in i64s(2), in i64s(1));
            let abort = self.b.declare(in i64s(1), in i64s(1));
            let pending_offset = add(F_ARGS, wrapping_mul(8, self.arity));
            let env_offset = add(pending_offset, 8);
            let mut offset = add(env_offset, wrapping_mul(8, self.env_globals.len()));
            // captures in first-use order get the offsets; the map is
            // iterated in name order
            let mut names = ChunkSeq::new[u32]();
            let mut offs = ChunkSeq::new[u64]();
            for k in 0..handler_row.rkn {
                let name = self.plan.word(add(handler_row.rk0, k));
                if !contains32(in names, name) {
                    names.push(name);
                    offs.push(offset);
                    offset = add(offset, 8);
                }
            }
            for clause_index in 0..handler_row.cn {
                let clause = self.plan.clause(add(handler_row.c0, clause_index));
                for k in 0..clause.kn {
                    let name = self.plan.word(add(clause.k0, k));
                    if !contains32(in names, name) {
                        names.push(name);
                        offs.push(offset);
                        offset = add(offset, 8);
                    }
                }
            }
            let c0 = self.hcap_name.len();
            for k in 0..names.len() {
                // insertion in name order
                let name = u32_at(in names, k);
                let cap_off = u64_at(in offs, k);
                let mut pos = self.hcap_name.len();
                for j in c0..self.hcap_name.len() {
                    if cmp_syms(in self.cx.names, u32_at(in self.hcap_name, j), name) > 0 {
                        pos = j;
                        break;
                    }
                }
                self.hcap_name.push(name);
                self.hcap_off.push(cap_off);
                let mut j = wrapping_sub(self.hcap_name.len(), 1);
                loop {
                    if j <= pos {
                        break;
                    }
                    let prev_name = u32_at(in self.hcap_name, wrapping_sub(j, 1));
                    let prev_off = u64_at(in self.hcap_off, wrapping_sub(j, 1));
                    let ok1 = self.hcap_name.try_set(j, prev_name);
                    let ok2 = self.hcap_off.try_set(j, prev_off);
                    j = wrapping_sub(j, 1);
                }
                let ok3 = self.hcap_name.try_set(pos, name);
                let ok4 = self.hcap_off.try_set(pos, cap_off);
            }
            let body_offset = offset;
            let body_inst = self.inst_of(handler_row.body);
            let body_params = self.cx.ir.info(body_inst.fi).pn;
            offset = add(offset, wrapping_mul(8, body_params));
            self.hfns.push(
                HFns {
                    dispatch_slot: dispatch_slot,
                    dispatch: dispatch,
                    ret: ret,
                    abort: abort,
                    frame_size: offset,
                    pending_offset: pending_offset,
                    env_offset: env_offset,
                    body_offset: body_offset,
                    c0: c0,
                    cn: names.len()
                }
            );
        }
    }

    pub fn define_init(inout self) {
        let alloc_body = alloc_code(self.heap);
        self.b.define(self.alloc, in body_n(2, in alloc_body));
    }

    pub fn define_finish(inout self) eff [Fail[WErr]] {
        for i in 0..self.plan.handlers.len() {
            self.define_dispatch(i);
            self.define_ret(i);
            self.define_abort(i);
        }
        self.flush_helpers();
    }

    pub fn define_all(inout self) eff [Fail[WErr]] {
        self.define_init();
        for i in 0..self.plan.insts.len() {
            let inst = self.plan.inst(i);
            let body = self.function(inst);
            let idx = self.func_of(inst.key);
            self.b.define(idx, in body);
        }
        self.define_finish();
    }

    // `signature`: the Wasm parameter count of an instance under its role
    // (an operation clause drops its continuation and, resuming in tail
    // position, takes its handler's frame).
    fn signature(in self, inst: Inst) -> u64 {
        let info = self.cx.ir.info(inst.fi);
        if inst.role != R_OP_CLAUSE {
            return info.pn;
        }
        let clause = self.plan.clause_of(inst.handler, inst.op);
        let mut n: u64 = 0;
        for i in 0..info.pn {
            if self.cx.ir.param(add(info.p0, i)).name != clause.resume {
                n = inc(n);
            }
        }
        if clause.mode == M_TAIL {
            n = inc(n);
        }
        n
    }

    fn hfn(in self, i: u64) -> HFns {
        match self.hfns.try_get(i) {
            Option::Some(row) => row,
            Option::None => HFns {
                dispatch_slot: 0,
                dispatch: 0,
                ret: 0,
                abort: 0,
                frame_size: 0,
                pending_offset: 0,
                env_offset: 0,
                body_offset: 0,
                c0: 0,
                cn: 0
            },
        }
    }

    // The frame offset of handler `i`'s capture `name`.
    fn capture_offset(in self, i: u64, name: u32) -> u64 eff [Fail[WErr]] {
        let hfns = self.hfn(i);
        for k in 0..hfns.cn {
            if u32_at(in self.hcap_name, add(hfns.c0, k)) == name {
                return u64_at(in self.hcap_off, add(hfns.c0, k));
            }
        }
        Fail::raise(werr(K_INVALID, 0, 250));
        0
    }

    // The evidence global of key `key`, or NONE32.
    fn env_global(in self, key: u32) -> u32 {
        if key == NONE32 {
            return NONE32;
        }
        for n in 0..self.env_keys.len() {
            if u32_at(in self.env_keys, n) == key {
                return u32_at(in self.env_globals, n);
            }
        }
        NONE32
    }

    fn flush_helpers(inout self) eff [Fail[WErr]] {
        loop {
            if self.eq_pending.len() == 0 {
                break;
            }
            let top = wrapping_sub(self.eq_pending.len(), 1);
            let pending = match self.eq_pending.try_get(top) {
                Option::Some(entry) => entry,
                Option::None => Pending { idx: 0, ty: 0 },
            };
            self.eq_pending.truncate(top);
            let body = self.eq_body(pending.ty);
            self.b.define(pending.idx, in body);
        }
    }

    // `indirect_type`: (env, args...) -> i64.
    fn indirect_type(inout self, arity: u64) -> u32 {
        self.b.func_type(in i64s(inc(arity)), in i64s(1))
    }

    // `trampoline`: the table slot of `$tramp(c, args...)` for `function`.
    fn trampoline(inout self, function: u32, ncaps: u64) -> u32 eff [Fail[WErr]] {
        let cached = get32(in self.trampolines, function);
        if cached != 0 {
            return wrapping_sub(cached, 1);
        }
        if !self.has_func(function) {
            Fail::raise(werr(K_INVALID, 0, 110));
        }
        let target = self.func_of(function);
        let total = self.ir_info(function).pn;
        if total < ncaps {
            Fail::raise(werr(K_INVALID, 0, 111));
        }
        let arity = wrapping_sub(total, ncaps);
        let ty = self.indirect_type(arity);
        let idx = self.b.declare_typed(ty);
        let nkeys = self.env_globals.len();
        let bindings = self.row_label_bindings(function, false);
        let n_labels = bindings.labels.len();
        let first = wrapping_u32(inc(arity));
        let ev = first;
        let caps = wrapping_add(first, 1);
        let env_tmp = wrapping_add(first, 2);
        let saved = wrapping_add(first, 3);
        let mut code = code_new();
        code.get(0);
        code.op(OP_I32_WRAP_I64);
        code.load(C_CAPTURES);
        code.set(caps);
        code.get(0);
        code.op(OP_I32_WRAP_I64);
        code.load(C_EVIDENCE);
        code.tee(ev);
        code.op(OP_I64_EQZ);
        if n_labels == 0 {
            code.open(OP_IF);
            tramp_operands(inout code, ncaps, arity, caps);
            code.return_call(target);
            code.op(OP_END);
        } else {
            code.op(OP_DROP);
        }
        for n in 0..nkeys {
            code.global_get(u32_at(in self.env_globals, n));
            code.set(wrapping_add(saved, wrapping_u32(n)));
        }
        code.get(ev);
        code.i64_const(0);
        code.op(OP_I64_NE);
        code.open(OP_IF);
        for n in 0..nkeys {
            code.get(ev);
            code.op(OP_I32_WRAP_I64);
            code.load(wrapping_mul(8, n));
            code.tee(env_tmp);
            code.i64_const(0);
            code.op(OP_I64_NE);
            code.open(OP_IF);
            code.get(env_tmp);
            code.global_set(u32_at(in self.env_globals, n));
            code.op(OP_END);
        }
        code.op(OP_END);
        let tmp = wrapping_add(saved, wrapping_u32(nkeys));
        for n in 0..n_labels {
            let source = u32_at(in bindings.sources, n);
            if source == NONE32 {
                Fail::raise(werr(K_INVALID, 0, 112));
            }
            code.global_get(source);
            code.set(wrapping_add(tmp, wrapping_u32(n)));
        }
        for n in 0..n_labels {
            for k in 0..u64_at(in bindings.tn, n) {
                code.get(wrapping_add(tmp, wrapping_u32(n)));
                code.global_set(u32_at(in bindings.targets, add(u64_at(in bindings.t0, n), k)));
            }
        }
        tramp_operands(inout code, ncaps, arity, caps);
        code.call(target);
        code.set(env_tmp);
        for n in 0..nkeys {
            code.get(wrapping_add(saved, wrapping_u32(n)));
            code.global_set(u32_at(in self.env_globals, n));
        }
        code.get(env_tmp);
        code.op(OP_END);
        let locals = add(add(3, nkeys), n_labels);
        self.b.define(idx, in body_n(locals, in code));
        let slot = self.b.table_slot(idx);
        set32(inout self.trampolines, function, inc32(slot));
        slot
    }

    // ----- helpers generated on first use ----------------------------------

    // `copy_fn`: `$copy<ty>(v, mark, delta)`.
    fn copy_fn(inout self, t: u32) -> u32 eff [Fail[WErr]] {
        let ty = self.cx.default_ty(t);
        let key = self.type_key(ty);
        let cached = get32(in self.copies, key);
        if cached != 0 {
            return wrapping_sub(cached, 1);
        }
        let idx = self.b.declare(in i64s(3), in i64s(1));
        set32(inout self.copies, key, inc32(idx));
        let v: u32 = 0;
        let markl: u32 = 1;
        let delta: u32 = 2;
        let n: u32 = 3;
        let x: u32 = 4;
        let mut c = code_new();
        c.get(v);
        c.get(markl);
        c.op(OP_I64_LT_U);
        c.open(OP_IF);
        c.get(v);
        c.op(OP_RETURN);
        c.op(OP_END);
        let sh = self.cx.shape(ty);
        if sh.kind == SH_STR {
            c.get(v);
            c.op(OP_I32_WRAP_I64);
            c.load(0);
            if self.seqs {
                c.u64_const(LOW32);
                c.op(OP_I64_AND);
            }
            c.i64_const(8);
            c.op(OP_I64_ADD);
            c.tee(x);
            c.call(self.alloc);
            c.tee(n);
            c.op(OP_I32_WRAP_I64);
            c.get(v);
            c.op(OP_I32_WRAP_I64);
            c.get(x);
            c.op(OP_I32_WRAP_I64);
            c.memory_copy();
            if self.seqs {
                // The copy holds the bytes only: capacity 0.
                c.get(n);
                c.op(OP_I32_WRAP_I64);
                c.get(x);
                c.i64_const(8);
                c.op(OP_I64_SUB);
                c.store(0);
            }
            c.get(n);
            c.get(delta);
            c.op(OP_I64_SUB);
        } else if sh.kind == SH_TUPLE {
            let mut ts = ChunkSeq::new[u32]();
            for i in 0..self.cx.arity(sh.ty) {
                ts.push(self.cx.tuple_elem(sh.ty, i));
            }
            self.copy_fields(inout c, in ts, 0);
            c.op(OP_UNREACHABLE);
        } else if sh.kind == SH_STRUCT {
            let mut ts = ChunkSeq::new[u32]();
            for i in 0..self.cx.field_count(sh, 0) {
                let (fname, fty) = self.cx.variant_field(sh, 0, i);
                ts.push(fty);
            }
            self.copy_fields(inout c, in ts, 0);
            c.op(OP_UNREACHABLE);
        } else if sh.kind == SH_ENUM {
            for vi in 0..self.cx.variant_count(sh) {
                c.get(v);
                c.op(OP_I32_WRAP_I64);
                c.load(0);
                c.u64_const(vi);
                c.op(OP_I64_EQ);
                c.open(OP_IF);
                let mut ts = ChunkSeq::new[u32]();
                for i in 0..self.cx.field_count(sh, vi) {
                    let (fname, fty) = self.cx.variant_field(sh, vi, i);
                    ts.push(fty);
                }
                self.copy_fields(inout c, in ts, 8);
                c.op(OP_END);
            }
            c.op(OP_UNREACHABLE);
        } else {
            Fail::raise(werr(K_INVALID, 0, 120));
        }
        c.op(OP_END);
        self.b.define(idx, in body_n(2, in c));
        idx
    }

    // The `fields` closure of `copy_fn`.
    fn copy_fields(inout self, inout c: Code, in field_tys: ChunkSeq[u32], base: u64) eff [
        Fail[WErr]
    ] {
        let v: u32 = 0;
        let markl: u32 = 1;
        let delta: u32 = 2;
        let n: u32 = 3;
        let x: u32 = 4;
        c.u64_const(wrapping_mul(8, add(field_tys.len(), base / 8)));
        c.call(self.alloc);
        c.set(n);
        if base > 0 {
            c.get(n);
            c.op(OP_I32_WRAP_I64);
            c.get(v);
            c.op(OP_I32_WRAP_I64);
            c.load(0);
            c.store(0);
        }
        for i in 0..field_tys.len() {
            let field_ty = u32_at(in field_tys, i);
            let offset = add(base, wrapping_mul(8, i));
            c.get(v);
            c.op(OP_I32_WRAP_I64);
            c.load(offset);
            c.set(x);
            let shape = self.cx.shape(field_ty);
            if shape.kind != SH_SCALAR {
                let copy_idx = self.copy_fn(field_ty);
                c.get(x);
                c.get(markl);
                c.get(delta);
                c.call(copy_idx);
                c.set(x);
            }
            c.get(n);
            c.op(OP_I32_WRAP_I64);
            c.get(x);
            c.store(offset);
        }
        c.get(n);
        c.get(delta);
        c.op(OP_I64_SUB);
        c.op(OP_RETURN);
    }

    // `Lowerer::reclaiming`.
    fn reclaiming(inout self, key: u32) -> bool {
        let i = self.plan.find(key);
        if i == 0 {
            return false;
        }
        let inst = self.plan.inst(wrapping_sub(i, 1));
        if inst.role != R_ORDINARY {
            return false;
        }
        let fs = self.cx.fn_sig(inst.base);
        if fs == 0 {
            return false;
        }
        let sig = self.cx.f.sig(wrapping_sub(fs, 1));
        if sig.tail != NONE32 {
            return false;
        }
        for k in 0..sig.pn {
            let pm = self.cx.f.param(add(sig.p0, k));
            if pm.pass == TyPass::Inout {
                return false;
            }
        }
        for k in 0..sig.en {
            let e = self.cx.f.eff(add(sig.e0, k));
            if e.name != self.cx.s.fail
                && !self.cx.f.is_capability(e.name)
                && !self.host_effect(e.name) {
                return false;
            }
        }
        true
    }

    // `eq_fn`: the structural-equality helper for `ty`.
    fn eq_fn(inout self, t: u32) -> u32 eff [Fail[WErr]] {
        let ty = self.cx.default_ty(t);
        let key = self.type_key(ty);
        let cached = get32(in self.eq, key);
        if cached != 0 {
            return wrapping_sub(cached, 1);
        }
        let sh = self.cx.shape(ty);
        if sh.kind == SH_OPAQUE || sh.kind == SH_FUNCTION {
            Fail::raise(werr(K_UNSUPPORTED, U_GENERIC_OPERATION, 130));
        }
        if sh.kind == SH_STR {
            return self.str_eq();
        }
        let idx = self.b.declare(in i64s(2), in i64s(1));
        set32(inout self.eq, key, inc32(idx));
        self.eq_pending.push(Pending { idx: idx, ty: ty });
        idx
    }

    fn eq_field(inout self, inout c: Code, off: u64, t: u32) eff [Fail[WErr]] {
        let f = self.eq_fn(t);
        c.get(0);
        c.op(OP_I32_WRAP_I64);
        c.load(off);
        c.get(1);
        c.op(OP_I32_WRAP_I64);
        c.load(off);
        c.call(f);
    }

    fn eq_body(inout self, ty: u32) -> ChunkSeq[u8] eff [Fail[WErr]] {
        let mut code = code_new();
        let a: u32 = 0;
        let b: u32 = 1;
        let tag: u32 = 2;
        let shape = self.cx.shape(ty);
        if shape.kind == SH_SCALAR && shape.scalar == SC_F64 {
            code.get(a);
            code.op(OP_F64_REINTERPRET_I64);
            code.get(b);
            code.op(OP_F64_REINTERPRET_I64);
            code.op(OP_F64_EQ);
            code.op(OP_I64_EXTEND_I32_U);
        } else if shape.kind == SH_SCALAR {
            code.get(a);
            code.get(b);
            code.op(OP_I64_EQ);
            code.op(OP_I64_EXTEND_I32_U);
        } else if shape.kind == SH_TUPLE {
            code.i64_const(1);
            for i in 0..self.cx.arity(shape.ty) {
                let t = self.cx.tuple_elem(shape.ty, i);
                self.eq_field(inout code, wrapping_mul(8, i), t);
                code.op(OP_I64_AND);
            }
        } else if shape.kind == SH_STRUCT {
            code.i64_const(1);
            for i in 0..self.cx.field_count(shape, 0) {
                let (fname, t) = self.cx.variant_field(shape, 0, i);
                self.eq_field(inout code, wrapping_mul(8, i), t);
                code.op(OP_I64_AND);
            }
        } else if shape.kind == SH_ENUM {
            code.get(a);
            code.op(OP_I32_WRAP_I64);
            code.load(0);
            code.tee(tag);
            code.get(b);
            code.op(OP_I32_WRAP_I64);
            code.load(0);
            code.op(OP_I64_NE);
            code.open(OP_IF);
            code.i64_const(0);
            code.op(OP_RETURN);
            code.op(OP_END);
            for vi in 0..self.cx.variant_count(shape) {
                code.get(tag);
                code.u64_const(vi);
                code.op(OP_I64_EQ);
                code.open(OP_IF);
                code.i64_const(1);
                for fi in 0..self.cx.field_count(shape, vi) {
                    let (fname, t) = self.cx.variant_field(shape, vi, fi);
                    self.eq_field(inout code, wrapping_mul(8, inc(fi)), t);
                    code.op(OP_I64_AND);
                }
                code.op(OP_RETURN);
                code.op(OP_END);
            }
            code.op(OP_UNREACHABLE);
        } else if shape.kind == SH_STR {
            let se = self.str_eq();
            code.get(a);
            code.get(b);
            code.call(se);
        } else {
            Fail::raise(werr(K_UNSUPPORTED, U_GENERIC_OPERATION, 131));
        }
        code.op(OP_END);
        body_n(1, in code)
    }

    // `string_literal`: the static address of literal `text`.
    fn string_literal(inout self, text: u32) -> u64 {
        let cached = u64_at(in self.strings, w(text));
        if cached != 0 {
            return wrapping_sub(cached, 1);
        }
        let n = self.cx.names.size(text);
        let mut bytes = ChunkSeq::new[u8]();
        for k in 0..8 {
            bytes.push(wrapping_u8(wrapping_shr_u64(n, wrapping_u32(wrapping_mul(k, 8))) & 255));
        }
        self.cx.write_name(text, inout bytes);
        let at = self.b.data(in bytes);
        set64(inout self.strings, text, inc(at));
        at
    }

    // `$str_eq(a, b)`.
    fn str_eq(inout self) -> u32 {
        if self.h_str_eq != NONE32 {
            return self.h_str_eq;
        }
        let idx = self.b.declare(in i64s(2), in i64s(1));
        self.h_str_eq = idx;
        let a: u32 = 0;
        let b: u32 = 1;
        let n: u32 = 2;
        let i: u32 = 3;
        let mut c = code_new();
        c.get(a);
        c.get(b);
        c.op(OP_I64_EQ);
        c.open(OP_IF);
        c.i64_const(1);
        c.op(OP_RETURN);
        c.op(OP_END);
        c.get(a);
        c.op(OP_I32_WRAP_I64);
        c.load(0);
        if self.seqs {
            c.u64_const(LOW32);
            c.op(OP_I64_AND);
        }
        c.tee(n);
        c.get(b);
        c.op(OP_I32_WRAP_I64);
        c.load(0);
        if self.seqs {
            c.u64_const(LOW32);
            c.op(OP_I64_AND);
        }
        c.op(OP_I64_NE);
        c.open(OP_IF);
        c.i64_const(0);
        c.op(OP_RETURN);
        c.op(OP_END);
        c.open(OP_LOOP);
        c.get(i);
        c.get(n);
        c.op(OP_I64_GE_U);
        c.open(OP_IF);
        c.i64_const(1);
        c.op(OP_RETURN);
        c.op(OP_END);
        for p in 0..2 {
            c.get(wrapping_u32(p));
            c.get(i);
            c.op(OP_I64_ADD);
            c.op(OP_I32_WRAP_I64);
            c.mem(OP_I64_LOAD8_U, 0, 8);
        }
        c.op(OP_I64_NE);
        c.open(OP_IF);
        c.i64_const(0);
        c.op(OP_RETURN);
        c.op(OP_END);
        c.get(i);
        c.i64_const(1);
        c.op(OP_I64_ADD);
        c.set(i);
        c.br(0);
        c.op(OP_END);
        c.op(OP_UNREACHABLE);
        c.op(OP_END);
        self.b.define(idx, in body_n(2, in c));
        idx
    }

    // `$fmod(x, y)`: musl's integer `fmod` on the bit patterns.
    fn fmod(inout self) -> u32 {
        if self.h_fmod != NONE32 {
            return self.h_fmod;
        }
        let idx = self.b.declare(in i64s(2), in i64s(1));
        self.h_fmod = idx;
        let mut c = code_new();
        fmod_code(inout c);
        self.b.define(idx, in body_n(6, in c));
        idx
    }

    // ----- function bodies -------------------------------------------------

    // `Emit::function`.
    pub fn function(inout self, inst: Inst) -> ChunkSeq[u8] eff [Fail[WErr]] {
        let info = self.cx.ir.info(inst.fi);
        self.e = em_new(inst, info);
        let vars = self.plan.vars(inst);
        self.e.vars = vars.vars();
        let fs = self.cx.fn_sig(inst.base);
        if fs != 0 {
            let sig = self.cx.f.sig(wrapping_sub(fs, 1));
            for g in 0..sig.gn {
                let generic = self.cx.f.gen(add(sig.g0, g));
                if vars.get(generic.name) == NONE32 {
                    self.e.generics.push(generic.name);
                }
            }
        }
        for v in 0..info.vn {
            self.e.values.push(0);
        }
        let mut mode: u8 = 255;
        if inst.role == R_OP_CLAUSE {
            let clause = self.plan.clause_of(inst.handler, inst.op);
            self.e.resume = clause.resume;
            self.e.clause_handler = inst.handler;
            mode = clause.mode;
        }
        let mut index: u32 = 0;
        for i in 0..info.pn {
            let param = self.cx.ir.param(add(info.p0, i));
            if param.name == self.e.resume {
                continue;
            }
            let cell = param.pass == TyPass::Inout || inst.role == R_HANDLER_BODY;
            self.e.names.push(NameSlot { name: param.name, local: index, cell: cell });
            index = wrapping_add(index, 1);
        }
        if mode == M_TAIL {
            self.e.frame = index;
            index = wrapping_add(index, 1);
        }
        self.e.nparams = index;
        if self.reclaiming(inst.key) {
            let mark = self.local();
            self.e.code.global_get(self.tail_mark);
            self.e.code.tee(mark);
            self.e.code.op(OP_I64_EQZ);
            self.e.code.open(OP_IF);
            self.e.code.global_get(self.heap);
            self.e.code.set(mark);
            self.e.code.op(OP_END);
            self.e.code.i64_const(0);
            self.e.code.global_set(self.tail_mark);
            self.e.mark = mark;
        }
        for i in 0..info.ln {
            let name = self.cx.ir.local(add(info.l0, i)).name;
            if self.slot_index(name) == NONE64 && name != self.e.resume {
                let slot = self.local();
                self.e.names.push(NameSlot { name: name, local: slot, cell: false });
            }
        }
        self.body();
        self.instructions = add(self.instructions, self.e.code.len());
        if self.instructions > self.max_instructions {
            Fail::raise(werr(K_LIMIT, 0, 140));
        }
        body_each(in self.e.locals, in self.e.code)
    }

    pub fn local(inout self) -> u32 {
        self.e.locals.push(vt(VT_I64));
        wrapping_sub(wrapping_add(self.e.nparams, wrapping_u32(self.e.locals.len())), 1)
    }

    fn slot_index(in self, name: u32) -> u64 {
        for i in 0..self.e.names.len() {
            match self.e.names.try_get(i) {
                Option::Some(s) => {
                    if s.name == name {
                        return i;
                    }
                },
                Option::None => {},
            }
        }
        NONE64
    }

    fn name_slot(in self, name: u32) -> NameSlot eff [Fail[WErr]] {
        let i = self.slot_index(name);
        if i == NONE64 {
            Fail::raise(werr(K_INVALID, 0, 141));
        }
        match self.e.names.try_get(i) {
            Option::Some(s) => s,
            Option::None => NameSlot { name: 0, local: 0, cell: false },
        }
    }

    pub fn value(in self, value_id: u64) -> u32 eff [Fail[WErr]] {
        let slot = u32_at(in self.e.values, value_id);
        if slot == 0 {
            Fail::raise(werr(K_INVALID, 0, 142));
        }
        wrapping_sub(slot, 1)
    }

    fn set_value(inout self, value_id: u64, local_idx: u32) {
        loop {
            if self.e.values.len() > value_id {
                break;
            }
            self.e.values.push(0);
        }
        let stored = self.e.values.try_set(value_id, inc32(local_idx));
    }

    pub fn dest(inout self, value_id: u64) -> u32 {
        let slot = u32_at(in self.e.values, value_id);
        if slot != 0 {
            return wrapping_sub(slot, 1);
        }
        let fresh = self.local();
        self.set_value(value_id, fresh);
        fresh
    }

    // `subst`: `raw_ty` under the instance's arguments, defaulted.
    fn subst(inout self, raw_ty: u32) -> u32 {
        let substituted = self.cx.subst(raw_ty, in self.e.vars);
        self.cx.default_ty(substituted)
    }

    fn vty(inout self, value_id: u64) -> u32 {
        let declared = self.cx.ir.value_type(self.e.info, value_id);
        let resolved = if declared == NONE32 {
            self.infer()
        } else {
            declared
        };
        self.subst(resolved)
    }

    fn local_type(inout self, name: u32) -> u32 {
        let declared = self.cx.ir.local_type(self.e.info, name);
        let resolved = if declared == NONE32 {
            self.infer()
        } else {
            declared
        };
        self.subst(resolved)
    }

    pub fn load(inout self, ptr: u32, off: u64) {
        self.e.code.get(ptr);
        self.e.code.op(OP_I32_WRAP_I64);
        self.e.code.load(off);
    }

    fn store(inout self, ptr: u32, off: u64, v: u32) {
        self.e.code.get(ptr);
        self.e.code.op(OP_I32_WRAP_I64);
        self.e.code.get(v);
        self.e.code.store(off);
    }

    pub fn alloc_block(inout self, bytes: u64) -> u32 {
        let block = self.local();
        self.e.code.u64_const(bytes);
        self.e.code.call(self.alloc);
        self.e.code.set(block);
        block
    }

    fn abort_check(inout self) {
        self.e.code.global_get(self.abort);
        self.e.code.i64_const(0);
        self.e.code.op(OP_I64_NE);
        self.e.code.open(OP_IF);
        self.e.code.i64_const(0);
        self.e.code.op(OP_RETURN);
        self.e.code.op(OP_END);
    }

    fn read_name(inout self, name: u32) -> u32 eff [Fail[WErr]] {
        let slot = self.name_slot(name);
        let out = self.local();
        if slot.cell {
            self.load(slot.local, 0);
        } else {
            self.e.code.get(slot.local);
        }
        self.e.code.set(out);
        out
    }

    fn write_name(inout self, name: u32, val: u32) eff [Fail[WErr]] {
        let slot = self.name_slot(name);
        if slot.cell {
            self.store(slot.local, 0, val);
        } else {
            self.e.code.get(val);
            self.e.code.set(slot.local);
        }
        let idx = self.slot_index(name);
        if idx != NONE64 && idx < self.e.elem_names.len() {
            let elem_entry = u64_at(in self.e.elem_names, idx);
            if elem_entry != 0 {
                let addr = wrapping_u32(wrapping_sub(elem_entry, 1) & LOW32);
                let stride = wrapping_shr_u64(wrapping_sub(elem_entry, 1), 32);
                let zero = self.const_local(0);
                self.elem_store(addr, zero, stride, val);
            }
        }
    }

    // `read_place` over path `path` (`segs`): (local, type).
    pub fn read_place(
        inout self,
        root: u32,
        in segs: ChunkSeq[u32]
    ) -> (u32, u32) eff [Fail[WErr]] {
        let mut cur = self.read_name(root);
        let mut ty = self.local_type(root);
        for i in 0..segs.len() {
            let (off, field_ty) = self.cx.field(ty, u32_at(in segs, i));
            let out = self.local();
            self.load(cur, off);
            self.e.code.set(out);
            cur = out;
            ty = field_ty;
        }
        (cur, ty)
    }

    pub fn write_place(inout self, root: u32, in segs: ChunkSeq[u32], val: u32) eff [Fail[WErr]] {
        if segs.len() == 0 {
            self.write_name(root, val);
            return;
        }
        let base = self.read_name(root);
        let ty = self.local_type(root);
        let updated = self.cow(base, ty, in segs, 0, val);
        self.write_name(root, updated);
    }

    fn cow(
        inout self,
        base: u32,
        ty: u32,
        in segs: ChunkSeq[u32],
        at: u64,
        v: u32
    ) -> u32 eff [Fail[WErr]] {
        let n = self.cx.slots(ty);
        let (off, fty) = self.cx.field(ty, u32_at(in segs, at));
        let dst = self.alloc_block(wrapping_mul(8, n));
        for i in 0..n {
            self.e.code.get(dst);
            self.e.code.op(OP_I32_WRAP_I64);
            self.load(base, wrapping_mul(8, i));
            self.e.code.store(wrapping_mul(8, i));
        }
        let inner = if inc(at) == segs.len() {
            v
        } else {
            let old = self.local();
            self.load(base, off);
            self.e.code.set(old);
            self.cow(old, fty, in segs, inc(at), v)
        };
        self.store(dst, off, inner);
        dst
    }

    // The names of path `i`.
    fn path_names(in self, i: u64) -> ChunkSeq[u32] {
        let mut out = ChunkSeq::new[u32]();
        let path_row = self.cx.ir.p.path(i);
        for k in 0..path_row.n {
            out.push(self.cx.ir.p.path_name(i, k));
        }
        out
    }

    // ----- the block graph ---------------------------------------------------

    fn body(inout self) eff [Fail[WErr]] {
        let fi = self.e.inst.fi;
        let row = self.cx.ir.p.function(fi);
        if row.bc > MAX_BLOCKS {
            Fail::raise(werr(K_LIMIT, 0, 150));
        }
        let mut loops = false;
        for bi in 0..row.bc {
            let blk = self.cx.ir.p.block(add(row.b0, bi));
            for ii in 0..blk.ic {
                let op = self.cx.ir.p.inst(add(blk.i0, ii)).op;
                if op == Op::Loop {
                    loops = true;
                }
            }
        }
        let (order, acyclic) = topological(in self, fi);
        if loops || !acyclic {
            for bi in 0..row.bc {
                let (p0, pn) = self.cx.ir.block_params(fi, bi);
                for k in 0..pn {
                    let param_val = self.cx.ir.word(add(p0, k));
                    let dest = self.dest(param_val);
                }
            }
            let cfg = cfg_of(in self, fi, in order);
            self.e.structured = true;
            self.do_tree(fi, u64_at(in order, 0), in cfg);
            self.e.code.op(OP_END);
            return;
        }
        let mut position = ChunkSeq::new[u64]();
        for i in 0..row.bc {
            position.push(NONE64);
        }
        for p in 0..order.len() {
            let ok = position.try_set(u64_at(in order, p), p);
        }
        for bi in 0..row.bc {
            let (p0, pn) = self.cx.ir.block_params(fi, bi);
            for k in 0..pn {
                let param_val = self.cx.ir.word(add(p0, k));
                let dest = self.dest(param_val);
            }
        }
        for k in 1..order.len() {
            self.e.code.open(OP_BLOCK);
        }
        for pos in 0..order.len() {
            if pos > 0 {
                self.e.code.op(OP_END);
            }
            let bi = u64_at(in order, pos);
            self.block_code(fi, bi, pos, in position);
        }
        self.e.code.op(OP_END);
    }

    // One block's instructions and its terminator (or its tail call).
    fn block_code(inout self, fi: u64, bi: u64, pos: u64, in position: ChunkSeq[u64]) eff [
        Fail[WErr]
    ] {
        let row = self.cx.ir.p.function(fi);
        let blk = self.cx.ir.p.block(add(row.b0, bi));
        let mut tail_call = false;
        if blk.ic > 0 {
            let last = self.cx.ir.p.inst(add(blk.i0, wrapping_sub(blk.ic, 1)));
            tail_call = self.tail_callable(add(blk.i0, wrapping_sub(blk.ic, 1)))
                && self.flows_to_return(fi, bi, widen_u64(last.dest), 0);
        }
        for ii in 0..blk.ic {
            let at = add(blk.i0, ii);
            if tail_call && inc(ii) == blk.ic {
                self.tail_call(at);
                continue;
            }
            if self.cx.ir.p.inst(at).op == Op::Loop {
                // The loop-header marker: the `loop` frame is the loop.
                continue;
            }
            self.instruction(at);
        }
        if tail_call {
            return;
        }
        self.terminator(fi, bi, pos, in position);
    }

    // `do_tree` of "Beyond Relooper" (Ramsey, ICFP 2022) for block `x`: a
    // `loop` frame when a back edge enters `x`, then `x` within a `block`
    // frame for each of its dominator-tree children.
    fn do_tree(inout self, fi: u64, x: u64, in cfg: Cfg) eff [Fail[WErr]] {
        let mut ys = ChunkSeq::new[u64]();
        let mut k = cfg.order.len();
        loop {
            if k == 0 {
                break;
            }
            k = wrapping_sub(k, 1);
            let y = u64_at(in cfg.order, k);
            if y != x && u64_at(in cfg.idom, y) == x {
                ys.push(y);
            }
        }
        let head = match cfg.header.try_get(x) {
            Option::Some(h) => h != 0,
            Option::None => false,
        };
        if head {
            self.e.code.open(OP_LOOP);
            self.e.frames.push(x);
            self.node_within(fi, x, in ys, 0, in cfg);
            self.e.frames.truncate(wrapping_sub(self.e.frames.len(), 1));
            self.e.code.op(OP_END);
            // Every path through the loop ends in a branch or a return.
            self.e.code.op(OP_UNREACHABLE);
        } else {
            self.node_within(fi, x, in ys, 0, in cfg);
        }
    }

    // `node_within`: the children `ys[k..]` (latest in reverse postorder
    // first) as `block` frames around `x`, each followed by its subtree.
    fn node_within(inout self, fi: u64, x: u64, in ys: ChunkSeq[u64], k: u64, in cfg: Cfg) eff [
        Fail[WErr]
    ] {
        if k >= ys.len() {
            let empty = ChunkSeq::new[u64]();
            self.block_code(fi, x, 0, in empty);
            return;
        }
        let y = u64_at(in ys, k);
        self.e.code.open(OP_BLOCK);
        self.e.frames.push(y);
        self.node_within(fi, x, in ys, inc(k), in cfg);
        self.e.frames.truncate(wrapping_sub(self.e.frames.len(), 1));
        self.e.code.op(OP_END);
        self.do_tree(fi, y, in cfg);
    }

    fn depth(in self, in position: ChunkSeq[u64], target: u64, pos: u64) -> u32 eff [Fail[WErr]] {
        if self.e.structured {
            // The innermost frame for `target`: a `loop` for a back edge,
            // the `block` that ends just before `target` otherwise.
            let n = self.e.frames.len();
            for i in 0..n {
                if u64_at(in self.e.frames, wrapping_sub(wrapping_sub(n, 1), i)) == target {
                    return wrapping_u32(i);
                }
            }
            Fail::raise(werr(K_INVALID, 0, 154));
        }
        let target_pos = u64_at(in position, target);
        if target_pos == NONE64 || target_pos <= pos {
            Fail::raise(werr(K_INVALID, 0, 153));
        }
        wrapping_u32(wrapping_sub(wrapping_sub(target_pos, pos), 1))
    }

    fn terminator(inout self, fi: u64, bi: u64, pos: u64, in position: ChunkSeq[u64]) eff [
        Fail[WErr]
    ] {
        let row = self.cx.ir.p.function(fi);
        let blk = self.cx.ir.p.block(add(row.b0, bi));
        let ta = blk.ta;
        if blk.term == Term::Return {
            let val = self.value(self.cx.ir.word(ta));
            self.e.code.get(val);
            self.e.code.op(OP_RETURN);
        } else if blk.term == Term::Jump {
            let target = self.cx.ir.word(ta);
            let n = self.cx.ir.word(inc(ta));
            let (p0, pn) = self.cx.ir.block_params(fi, target);
            let n_moved = if n < pn { n } else { pn };
            for k in 0..n_moved {
                let val = self.value(self.cx.ir.word(add(add(ta, 2), k)));
                let dst = self.dest(self.cx.ir.word(add(p0, k)));
                self.e.code.get(val);
                self.e.code.set(dst);
            }
            let label_depth = self.depth(in position, target, pos);
            self.e.code.br(label_depth);
        } else if blk.term == Term::Branch {
            let cond = self.value(self.cx.ir.word(ta));
            let depth_then = self.depth(in position, self.cx.ir.word(inc(ta)), pos);
            let depth_else = self.depth(in position, self.cx.ir.word(add(ta, 2)), pos);
            self.e.code.get(cond);
            self.e.code.op(OP_I32_WRAP_I64);
            self.e.code.br_if(depth_then);
            self.e.code.br(depth_else);
        } else if blk.term == Term::Match {
            let vid = self.cx.ir.word(ta);
            let scrutinee = self.value(vid);
            let ty = self.vty(vid);
            let n = self.cx.ir.word(inc(ta));
            let mut at = add(ta, 2);
            for k in 0..n {
                self.condition(at, scrutinee, ty);
                let end = pattern_end(in self.cx.ir.p.ops, at, 0);
                let label_depth = self.depth(in position, self.cx.ir.word(end), pos);
                self.e.code.br_if(label_depth);
                at = inc(end);
            }
            self.e.code.op(OP_UNREACHABLE);
        } else {
            self.e.code.op(OP_UNREACHABLE);
        }
    }

    // `flows_to_return`: `value`, defined last in block `block`, reaches a
    // `return` unchanged.
    fn flows_to_return(in self, fi: u64, block: u64, value: u64, depth: u64) -> bool {
        if depth > 64 {
            return false;
        }
        let row = self.cx.ir.p.function(fi);
        let blk = self.cx.ir.p.block(add(row.b0, block));
        if blk.term == Term::Return {
            return self.cx.ir.word(blk.ta) == value;
        }
        if blk.term != Term::Jump {
            return false;
        }
        let succ = self.cx.ir.word(blk.ta);
        let n = self.cx.ir.word(inc(blk.ta));
        let mut pos = NONE64;
        let mut count: u64 = 0;
        for k in 0..n {
            if self.cx.ir.word(add(add(blk.ta, 2), k)) == value {
                if pos == NONE64 {
                    pos = k;
                }
                count = inc(count);
            }
        }
        if pos == NONE64 || count != 1 {
            return false;
        }
        let target = self.cx.ir.p.block(add(row.b0, succ));
        if target.ic != 0 {
            return false;
        }
        let (p0, pn) = self.cx.ir.block_params(fi, succ);
        if pos >= pn {
            return false;
        }
        self.flows_to_return(fi, succ, self.cx.ir.word(add(p0, pos)), inc(depth))
    }

    // The callee key of call `dest`, or NONE32.
    fn callee_key(in self, dest: u64) -> u32 {
        self.plan.callee(self.e.inst, dest)
    }

    fn tail_callable(in self, at: u64) -> bool {
        let ins = self.cx.ir.p.inst(at);
        if ins.op != Op::Call {
            return false;
        }
        // An intercepted `Atomic` operation is no call (`atomic_call`).
        if self.seqs && self.has_prefix(n32(self.cx.ir.word(ins.a)), "Atomic::") {
            return false;
        }
        let key = self.callee_key(widen_u64(ins.dest));
        if key == NONE32 || !self.has_func(key) || self.role_of(key) != R_ORDINARY {
            return false;
        }
        let n_args = self.cx.ir.word(inc(ins.a));
        for k in 0..n_args {
            if self.cx.ir.word(add(add(ins.a, 2), wrapping_mul(k, 4))) == 1 {
                return false;
            }
        }
        let callee = n32(self.cx.ir.word(ins.a));
        let fs = self.cx.fn_sig(callee);
        if fs == 0 {
            return false;
        }
        let sig = self.cx.f.sig(wrapping_sub(fs, 1));
        for k in 0..sig.pn {
            if self.cx.f.param(add(sig.p0, k)).pass == TyPass::Inout {
                return false;
            }
        }
        for k in 0..sig.en {
            let e = self.cx.f.eff(add(sig.e0, k));
            if e.label != NONE32 && self.cx.names.byte(e.label, 0) != 36 {
                return false;
            }
        }
        true
    }

    fn tail_call(inout self, at: u64) eff [Fail[WErr]] {
        let ins = self.cx.ir.p.inst(at);
        let key = self.callee_key(widen_u64(ins.dest));
        if key == NONE32 {
            Fail::raise(werr(K_INVALID, 0, 160));
        }
        let (pp, pt) = self.params_of(key);
        let mut cells = ChunkSeq::new[Cell]();
        let vals = self.call_args(inc(ins.a), in pp, in pt, inout cells);
        self.reclaim_before_tail_call(in pt, in vals);
        for k in 0..vals.len() {
            self.e.code.get(u32_at(in vals, k));
        }
        if self.e.mark != NONE32 && self.reclaiming(key) {
            self.e.code.get(self.e.mark);
            self.e.code.global_set(self.tail_mark);
        }
        self.e.code.return_call(self.func_of(key));
    }

    fn reclaim_before_tail_call(inout self, in ptys: ChunkSeq[u32], in args: ChunkSeq[u32]) eff [
        Fail[WErr]
    ] {
        if self.e.mark == NONE32 {
            return;
        }
        let mark = self.e.mark;
        let mut copy_vals = ChunkSeq::new[u32]();
        let mut copy_fns = ChunkSeq::new[u32]();
        for i in 0..args.len() {
            if i >= ptys.len() {
                return;
            }
            let ty = u32_at(in ptys, i);
            let sh = self.cx.shape(ty);
            if sh.kind == SH_SCALAR {
                continue;
            }
            if (
                sh.kind == SH_STR
                    || sh.kind == SH_TUPLE
                    || sh.kind == SH_STRUCT
                    || sh.kind == SH_ENUM
            )
                && self.evacuable(ty) {
                let copy_idx = self.copy_fn(ty);
                copy_vals.push(u32_at(in args, i));
                copy_fns.push(copy_idx);
                continue;
            }
            return;
        }
        let start = self.local();
        let delta = self.local();
        let heap = self.heap;
        self.e.code.global_get(heap);
        self.e.code.get(mark);
        self.e.code.op(OP_I64_NE);
        self.e.code.open(OP_IF);
        self.e.code.global_get(heap);
        self.e.code.tee(start);
        self.e.code.get(mark);
        self.e.code.op(OP_I64_SUB);
        self.e.code.set(delta);
        for k in 0..copy_vals.len() {
            let val = u32_at(in copy_vals, k);
            self.e.code.get(val);
            self.e.code.get(mark);
            self.e.code.get(delta);
            self.e.code.call(u32_at(in copy_fns, k));
            self.e.code.set(val);
        }
        self.e.code.get(mark);
        self.e.code.op(OP_I32_WRAP_I64);
        self.e.code.get(start);
        self.e.code.op(OP_I32_WRAP_I64);
        self.e.code.global_get(heap);
        self.e.code.get(start);
        self.e.code.op(OP_I64_SUB);
        self.e.code.op(OP_I32_WRAP_I64);
        self.e.code.memory_copy();
        self.e.code.global_get(heap);
        self.e.code.get(delta);
        self.e.code.op(OP_I64_SUB);
        self.e.code.global_set(heap);
        self.e.code.op(OP_END);
    }

    // `evacuable`: no function values or unresolved generic parts.
    fn evacuable(inout self, raw_ty: u32) -> bool {
        let mut seen = ChunkSeq::new[u32]();
        self.evacuable_in(raw_ty, inout seen)
    }

    fn evacuable_in(inout self, raw_ty: u32, inout seen: ChunkSeq[u32]) -> bool {
        let ty = self.cx.default_ty(raw_ty);
        let key = self.type_key(ty);
        if contains32(in seen, key) {
            return true;
        }
        seen.push(key);
        let shape = handle Fail[WErr] in {
            self.cx.shape(ty)
        } with {
            return value => value,
            raise(e, resume) => Shape { kind: SH_OPAQUE, scalar: 0, adt: NONE32, ty: ty },
        };
        if shape.kind == SH_SCALAR || shape.kind == SH_STR {
            return true;
        }
        if shape.kind == SH_TUPLE {
            for i in 0..self.cx.arity(shape.ty) {
                if !self.evacuable_in(self.cx.tuple_elem(shape.ty, i), inout seen) {
                    return false;
                }
            }
            return true;
        }
        if shape.kind == SH_STRUCT || shape.kind == SH_ENUM {
            let n_variants = if shape.kind == SH_STRUCT {
                if self.cx.variant_count(shape) > 0 {
                    1
                } else {
                    0
                }
            } else {
                self.cx.variant_count(shape)
            };
            for vi in 0..n_variants {
                for fi in 0..self.cx.field_count(shape, vi) {
                    let (fname, fty) = self.cx.variant_field(shape, vi, fi);
                    if !self.evacuable_in(fty, inout seen) {
                        return false;
                    }
                }
            }
            return true;
        }
        false
    }

    // ----- patterns --------------------------------------------------------

    // Push an i32 truth value: does the pattern at `ops[at]` match the
    // value in local `val` of type `ty`?
    fn condition(inout self, at: u64, val: u32, ty: u32) eff [Fail[WErr]] {
        let kind = self.cx.ir.word(at);
        if kind == Pat::Wild || kind == Pat::Bind {
            self.e.code.i32_const(1);
        } else if kind == Pat::Literal {
            let shape = self.cx.shape(ty);
            self.e.code.get(val);
            let lit_kind = self.cx.ir.word(add(at, 3));
            let lo = self.cx.ir.word(add(at, 4));
            let hi = self.cx.ir.word(add(at, 5));
            if lit_kind == Lit::Float {
                self.e.code.op(OP_F64_REINTERPRET_I64);
                self.e.code.f64_const(lo);
                self.e.code.op(OP_F64_EQ);
            } else if lit_kind == Lit::String && self.seq_kind(ty) == SK_VIEW {
                // A `Str` view against the literal's bytes.
                self.e.code.op(OP_DROP);
                let (base, n) = self.parts(val, ty);
                let lit_addr = self.string_literal(n32(lo));
                let bytes_eq_idx = self.bytes_eq();
                self.e.code.get(base);
                self.e.code.get(n);
                self.e.code.u64_const(add(lit_addr, 8));
                self.e.code.u64_const(self.cx.names.size(n32(lo)));
                self.e.code.call(bytes_eq_idx);
                self.e.code.op(OP_I32_WRAP_I64);
            } else if lit_kind == Lit::String {
                let lit_addr = self.string_literal(n32(lo));
                let str_eq_idx = self.str_eq();
                self.e.code.u64_const(lit_addr);
                self.e.code.call(str_eq_idx);
                self.e.code.op(OP_I32_WRAP_I64);
            } else if self.is_u128(ty) {
                self.wide_lit_eq(val, lo, hi);
            } else {
                let bits = self.constant_bits(lit_kind, lo, hi, ty);
                self.e.code.i64_const(bits);
                self.e.code.op(OP_I64_EQ);
            }
        } else if kind == Pat::Tuple {
            let tuple_ty = self.cx.default_ty(ty);
            if self.cx.types.kind(tuple_ty) != TyKind::Tuple {
                Fail::raise(werr(K_INVALID, 0, 170));
            }
            self.e.code.i32_const(1);
            let n = self.cx.ir.word(add(at, 3));
            let n_elems = self.cx.arity(tuple_ty);
            let mut pat_at = add(at, 4);
            for i in 0..n {
                if i >= n_elems {
                    break;
                }
                let elem = self.local();
                self.load(val, wrapping_mul(8, i));
                self.e.code.set(elem);
                let elem_ty = self.cx.tuple_elem(tuple_ty, i);
                self.condition(pat_at, elem, elem_ty);
                self.e.code.op(OP_I32_AND);
                pat_at = pattern_end(in self.cx.ir.p.ops, pat_at, 0);
            }
        } else if kind == Pat::Constructor {
            let name = n32(self.cx.ir.word(add(at, 3)));
            let (index, is_enum, shape) = self.cx.variant_of(ty, name);
            if is_enum {
                self.load(val, 0);
                self.e.code.u64_const(index);
                self.e.code.op(OP_I64_EQ);
                self.e.code.open_result(OP_IF, vt(VT_I32));
            }
            self.e.code.i32_const(1);
            let n = self.cx.ir.word(add(at, 5));
            let mut pat_at = add(at, 6);
            for k in 0..n {
                let fname = n32(self.cx.ir.word(pat_at));
                let field_idx = self.cx.field_index(shape, index, fname);
                if field_idx == NONE64 {
                    Fail::raise(werr(K_INVALID, 0, 171));
                }
                let elem = self.local();
                self.load(val, wrapping_mul(8, add(field_idx, if is_enum { 1 } else { 0 })));
                self.e.code.set(elem);
                let (field_name, elem_ty) = self.cx.variant_field(shape, index, field_idx);
                self.condition(inc(pat_at), elem, elem_ty);
                self.e.code.op(OP_I32_AND);
                pat_at = pattern_end(in self.cx.ir.p.ops, inc(pat_at), 0);
            }
            if is_enum {
                self.e.code.op(OP_ELSE);
                self.e.code.i32_const(0);
                self.e.code.op(OP_END);
            }
        }
    }

    // Destructure local `val` of type `ty` into the names the pattern at
    // `ops[at]` binds.
    fn bind(inout self, at: u64, val: u32, ty: u32) eff [Fail[WErr]] {
        let kind = self.cx.ir.word(at);
        if kind == Pat::Bind {
            let bind_name = n32(self.cx.ir.word(add(at, 3)));
            let idx = self.slot_index(bind_name);
            if idx != NONE64 {
                set64(inout self.e.elem_names, wrapping_u32(idx), 0);
            }
            self.write_name(bind_name, val);
        } else if kind == Pat::Tuple {
            let tuple_ty = self.cx.default_ty(ty);
            if self.cx.types.kind(tuple_ty) != TyKind::Tuple {
                Fail::raise(werr(K_INVALID, 0, 172));
            }
            let n = self.cx.ir.word(add(at, 3));
            let n_elems = self.cx.arity(tuple_ty);
            let mut pat_at = add(at, 4);
            for i in 0..n {
                if i >= n_elems {
                    break;
                }
                let elem = self.local();
                self.load(val, wrapping_mul(8, i));
                self.e.code.set(elem);
                let elem_ty = self.cx.tuple_elem(tuple_ty, i);
                self.bind(pat_at, elem, elem_ty);
                pat_at = pattern_end(in self.cx.ir.p.ops, pat_at, 0);
            }
        } else if kind == Pat::Constructor {
            let name = n32(self.cx.ir.word(add(at, 3)));
            let (index, is_enum, shape) = self.cx.variant_of(ty, name);
            let n = self.cx.ir.word(add(at, 5));
            let mut pat_at = add(at, 6);
            for k in 0..n {
                let fname = n32(self.cx.ir.word(pat_at));
                let field_idx = self.cx.field_index(shape, index, fname);
                if field_idx == NONE64 {
                    Fail::raise(werr(K_INVALID, 0, 173));
                }
                let elem = self.local();
                self.load(val, wrapping_mul(8, add(field_idx, if is_enum { 1 } else { 0 })));
                self.e.code.set(elem);
                let (field_name, elem_ty) = self.cx.variant_field(shape, index, field_idx);
                self.bind(inc(pat_at), elem, elem_ty);
                pat_at = pattern_end(in self.cx.ir.p.ops, inc(pat_at), 0);
            }
        }
    }

    // `constant_bits` of literal (kind, lo, hi) at type `ty`.
    fn constant_bits(inout self, kind: u64, lo: u64, hi: u64, ty: u32) -> i64 eff [Fail[WErr]] {
        if kind == Lit::Int {
            if !self.fits(lo, hi, ty) {
                Fail::raise(werr(K_INVALID, 0, 180));
            }
            return wrapping_i64(lo);
        }
        if kind == Lit::Bool {
            return wrapping_i64(lo);
        }
        if kind == Lit::Float {
            return wrapping_i64(lo);
        }
        if kind == Lit::WideInt {
            Fail::raise(werr(K_INVALID, 0, 180));
        }
        Fail::raise(werr(K_UNSUPPORTED, U_STRING, 181));
        0
    }

    // `IntegerKind::from_type(ty).unwrap_or(default_for(n)).fits(n)` for
    // the i128 `hi:lo`.
    fn fits(in self, lo: u64, hi: u64, ty: u32) -> bool {
        let neg = hi > 9223372036854775807;
        let small_pos = hi == 0;
        let small_neg = hi == NONE64;
        let node = self.cx.types.node(ty);
        let mut name: u32 = NONE32;
        if node.kind == TyKind::Named {
            name = node.name;
        }
        let k = self.cx.k;
        let s = self.cx.s;
        if name == k.u8_ {
            return small_pos && lo <= 255;
        }
        if name == k.u16_ {
            return small_pos && lo <= 65535;
        }
        if name == k.u32_ {
            return small_pos && lo <= 4294967295;
        }
        if name == k.u64_ || name == k.usize_ {
            return small_pos;
        }
        if name == k.i8_ {
            return (small_pos && lo <= 127) || (small_neg && lo >= 18446744073709551488);
        }
        if name == k.i16_ {
            return (small_pos && lo <= 32767) || (small_neg && lo >= 18446744073709518848);
        }
        if name == k.i32_ {
            return (small_pos && lo <= 2147483647) || (small_neg && lo >= 18446744071562067968);
        }
        if name == s.i128_ {
            return true;
        }
        if name == s.u128_ {
            return !neg;
        }
        // i64, isize, or `default_for(n)`: u64 above i64::MAX, else i64
        if name == k.i64_ || name == k.isize_ {
            return (small_pos && lo <= 9223372036854775807)
                || (small_neg && lo >= 9223372036854775808);
        }
        if small_pos && lo > 9223372036854775807 {
            return true;
        }
        (small_pos && lo <= 9223372036854775807) || (small_neg && lo >= 9223372036854775808)
    }

    pub fn scalar_of(inout self, ty: u32) -> u8 eff [Fail[WErr]] {
        let sh = self.cx.shape(ty);
        if sh.kind != SH_SCALAR {
            Fail::raise(werr_syms(K_UNSUPPORTED, U_GENERIC_OPERATION, 182, self.e.inst.base, 0));
        }
        sh.scalar
    }

    // ----- instructions ----------------------------------------------------

    fn instruction(inout self, at: u64) eff [Fail[WErr]] {
        let ins = self.cx.ir.p.inst(at);
        let ty = self.subst(ins.ty);
        let operands = ins.a;
        let dest_val = widen_u64(ins.dest);
        let op = ins.op;
        if op == Op::Const {
            let lit_kind = self.cx.ir.word(operands);
            let lo = self.cx.ir.word(inc(operands));
            let hi = self.cx.ir.word(add(operands, 2));
            if lit_kind == Lit::String {
                let text = n32(lo);
                let addr = self.string_literal(text);
                let value = if self.seq_kind(ty) == SK_VIEW {
                    // A Str literal points past the static String header.
                    add(addr, 8) | wrapping_shl_u64(self.cx.names.size(text), 32)
                } else {
                    addr
                };
                let dest = self.dest(dest_val);
                self.e.code.u64_const(value);
                self.e.code.set(dest);
            } else if self.is_u128(ty) {
                self.wide_const(dest_val, lo, hi);
            } else {
                let bits = self.constant_bits(lit_kind, lo, hi, ty);
                let dest = self.dest(dest_val);
                self.e.code.i64_const(bits);
                self.e.code.set(dest);
            }
        } else if op == Op::Exit {
            // `return value` from this function (`Op::Exit`); one that
            // leaves an enclosing function from a handled body is not
            // lowered here yet.
            let row = self.cx.ir.p.function(self.e.inst.fi);
            if n32(self.cx.ir.word(inc(operands))) != row.name {
                Fail::raise(werr(K_UNSUPPORTED, U_OPERATION, 151));
            }
            let ret_val = self.value(self.cx.ir.word(operands));
            self.e.code.get(ret_val);
            self.e.code.op(OP_RETURN);
        } else if op == Op::Unit {
            let dest = self.dest(dest_val);
            self.e.code.i64_const(0);
            self.e.code.set(dest);
        } else if op == Op::Read {
            let root = n32(self.cx.ir.word(operands));
            let path = self.cx.ir.word(inc(operands));
            if root == self.e.resume {
                self.e.resume_reads.push(dest_val);
                return;
            }
            if self.slot_index(root) == NONE64 {
                if path == 0 && self.has_func(root) {
                    let slot = self.trampoline(root, 0);
                    let none = ChunkSeq::new[u32]();
                    let block = self.callable(slot, false, false, in none);
                    self.set_value(dest_val, block);
                    return;
                }
                if self.cx.fn_sig(root) != 0 {
                    Fail::raise(
                        werr_syms(K_UNSUPPORTED, U_FUNCTION_VALUE, 190, self.e.inst.key, root)
                    );
                }
                Fail::raise(werr_syms(K_INVALID, 0, 191, self.e.inst.key, root));
            }
            let segs = self.path_names(path);
            let (place_val, place_ty) = self.read_place(root, in segs);
            self.set_value(dest_val, place_val);
        } else if op == Op::Bind {
            let vid = self.cx.ir.word(operands);
            let val = self.value(vid);
            let val_ty = self.vty(vid);
            self.bind(inc(operands), val, val_ty);
            let elem_entry = if vid < self.e.elems.len() {
                u64_at(in self.e.elems, vid)
            } else {
                0
            };
            if elem_entry != 0
                && self.cx.ir.word(inc(operands)) == Pat::Constructor
                && self.cx.ir.word(add(operands, 6)) == 1
                && self.cx.ir.word(add(operands, 8)) == Pat::Bind {
                let bind_name = n32(self.cx.ir.word(add(operands, 11)));
                let idx = self.slot_index(bind_name);
                if idx != NONE64 {
                    set64(inout self.e.elem_names, wrapping_u32(idx), elem_entry);
                }
            }
            let dest = self.dest(dest_val);
            self.e.code.i64_const(0);
            self.e.code.set(dest);
        } else if op == Op::Write {
            let place = n32(self.cx.ir.word(operands));
            let op_sym = n32(self.cx.ir.word(inc(operands)));
            let vid = self.cx.ir.word(add(operands, 2));
            let (root, segs) = self.split_place(place);
            if root == NONE32 {
                Fail::raise(werr_syms(K_INVALID, 0, 192, self.e.inst.base, place));
            }
            let rhs = self.value(vid);
            if self.has_prefix(op_sym, "[]") {
                self.write_index_place(root, in segs, op_sym, rhs);
                let dest = self.dest(dest_val);
                self.e.code.i64_const(0);
                self.e.code.set(dest);
                return;
            }
            let updated = if op_sym == self.cx.s.eq {
                rhs
            } else {
                let base = self.strip_eq(op_sym, 0);
                if base == NONE32 {
                    Fail::raise(
                        werr_syms(K_UNSUPPORTED, U_OPERATION, 193, self.e.inst.base, op_sym)
                    );
                }
                let (old, place_ty) = self.read_place(root, in segs);
                let scalar = self.scalar_of(place_ty);
                self.binary(base, old, rhs, scalar, scalar)
            };
            self.write_place(root, in segs, updated);
            let dest = self.dest(dest_val);
            self.e.code.i64_const(0);
            self.e.code.set(dest);
        } else if op == Op::Unary {
            let op_sym = n32(self.cx.ir.word(operands));
            let vid = self.cx.ir.word(inc(operands));
            let operand = self.value(vid);
            let operand_ty = self.vty(vid);
            if self.wide_unary(dest_val, op_sym, operand, operand_ty, ty) {
                return;
            }
            let scalar = self.scalar_of(operand_ty);
            let dest = self.dest(dest_val);
            if self.is_op(op_sym, "!") && scalar == SC_BOOL {
                self.e.code.get(operand);
                self.e.code.op(OP_I64_EQZ);
                self.e.code.op(OP_I64_EXTEND_I32_U);
            } else if self.is_op(op_sym, "-") && scalar == SC_F64 {
                self.e.code.get(operand);
                self.e.code.op(OP_F64_REINTERPRET_I64);
                self.e.code.op(OP_F64_NEG);
                self.e.code.op(OP_I64_REINTERPRET_F64);
            } else if self.is_op(op_sym, "-") && ik_signed(scalar) {
                self.e.code.get(operand);
                self.e.code.i64_const(ik_min(scalar));
                self.e.code.op(OP_I64_EQ);
                self.e.code.open(OP_IF);
                self.raise_overflow();
                self.e.code.op(OP_END);
                self.e.code.i64_const(0);
                self.e.code.get(operand);
                self.e.code.op(OP_I64_SUB);
            } else if self.is_op(op_sym, "-") && ik_unsigned(scalar) {
                self.e.code.get(operand);
                self.e.code.op(OP_I64_EQZ);
                self.e.code.op(OP_I32_EQZ);
                self.e.code.open(OP_IF);
                self.raise_overflow();
                self.e.code.op(OP_END);
                self.e.code.i64_const(0);
            } else if self.conversion(op_sym, operand, scalar, ty) {
                // `widen_k`, `narrow_k` or `wrapping_k`: the value on the
                // stack.
            } else {
                Fail::raise(werr(K_UNSUPPORTED, U_OPERATION, 194));
            }
            self.e.code.set(dest);
        } else if op == Op::Binary {
            let op_sym = n32(self.cx.ir.word(operands));
            let lhs_id = self.cx.ir.word(inc(operands));
            let rhs_id = self.cx.ir.word(add(operands, 2));
            let lhs = self.value(lhs_id);
            let rhs = self.value(rhs_id);
            let lhs_ty = self.vty(lhs_id);
            let rhs_ty = self.vty(rhs_id);
            if self.wide_binary(dest_val, op_sym, lhs, rhs, lhs_ty, rhs_ty) {
                return;
            }
            let shape = self.cx.shape(lhs_ty);
            let is_aggregate = shape.kind == SH_TUPLE
                || shape.kind == SH_STRUCT
                || shape.kind == SH_ENUM
                || shape.kind == SH_STR;
            let is_ne = self.is_op(op_sym, "!=");
            let views = self.seq_kind(lhs_ty) == SK_VIEW || self.seq_kind(rhs_ty) == SK_VIEW;
            let result = if (self.is_op(op_sym, "==") || is_ne) && views {
                self.view_eq(lhs, lhs_ty, rhs, rhs_ty, is_ne)
            } else if (self.is_op(op_sym, "==") || is_ne) && is_aggregate {
                let eq_idx = self.eq_fn(lhs_ty);
                let dest = self.local();
                self.e.code.get(lhs);
                self.e.code.get(rhs);
                self.e.code.call(eq_idx);
                if is_ne {
                    self.e.code.op(OP_I64_EQZ);
                    self.e.code.op(OP_I64_EXTEND_I32_U);
                }
                self.e.code.set(dest);
                dest
            } else {
                let lhs_scalar = self.scalar_of(lhs_ty);
                let rhs_scalar = self.scalar_of(rhs_ty);
                self.binary(op_sym, lhs, rhs, lhs_scalar, rhs_scalar)
            };
            self.set_value(dest_val, result);
        } else if op == Op::Tuple {
            let n = self.cx.ir.word(operands);
            if n == 0 {
                let dest = self.dest(dest_val);
                self.e.code.i64_const(0);
                self.e.code.set(dest);
                return;
            }
            let block = self.alloc_block(wrapping_mul(8, n));
            for i in 0..n {
                let elem = self.value(self.cx.ir.word(add(inc(operands), i)));
                self.store(block, wrapping_mul(8, i), elem);
            }
            self.set_value(dest_val, block);
        } else if op == Op::Data {
            let name = n32(self.cx.ir.word(operands));
            let (index, is_enum, shape) = self.cx.variant_of(ty, name);
            let n_fields = self.cx.field_count(shape, index);
            let slots = add(n_fields, if is_enum { 1 } else { 0 });
            let block = if slots == 0 {
                let empty_block = self.local();
                self.e.code.i64_const(0);
                self.e.code.set(empty_block);
                empty_block
            } else {
                self.alloc_block(wrapping_mul(8, slots))
            };
            if is_enum {
                let tag = self.local();
                self.e.code.u64_const(index);
                self.e.code.set(tag);
                self.store(block, 0, tag);
            }
            let n = self.cx.ir.word(inc(operands));
            for k in 0..n {
                let fname = n32(self.cx.ir.word(add(add(operands, 2), wrapping_mul(k, 2))));
                let vid = self.cx.ir.word(add(add(operands, 3), wrapping_mul(k, 2)));
                let fi = self.cx.field_index(shape, index, fname);
                if fi == NONE64 {
                    Fail::raise(werr(K_INVALID, 0, 195));
                }
                let field_val = self.value(vid);
                self.store(block, wrapping_mul(8, add(fi, if is_enum { 1 } else { 0 })), field_val);
            }
            self.set_value(dest_val, block);
        } else if op == Op::Project {
            let base_id = self.cx.ir.word(operands);
            let fname = n32(self.cx.ir.word(inc(operands)));
            let base_val = self.value(base_id);
            let base_ty = self.vty(base_id);
            let (off, field_ty) = self.cx.field(base_ty, fname);
            let dest = self.dest(dest_val);
            self.load(base_val, off);
            self.e.code.set(dest);
        } else if op == Op::Index {
            let base_id = self.cx.ir.word(operands);
            let index_id = self.cx.ir.word(inc(operands));
            let base_ty = self.vty(base_id);
            if self.cx.types.kind(base_ty) != TyKind::Tuple {
                Fail::raise(werr(K_UNSUPPORTED, U_INDEX, 196));
            }
            let base_val = self.value(base_id);
            let index_val = self.value(index_id);
            let n = self.cx.arity(base_ty);
            self.e.code.get(index_val);
            self.e.code.u64_const(n);
            self.e.code.op(OP_I64_GE_U);
            self.e.code.open(OP_IF);
            let oob = self.cx.s.index_oob;
            self.raise_runtime_error(oob);
            self.e.code.op(OP_END);
            let dest = self.dest(dest_val);
            self.e.code.get(base_val);
            self.e.code.get(index_val);
            self.e.code.i64_const(3);
            self.e.code.op(OP_I64_SHL);
            self.e.code.op(OP_I64_ADD);
            self.e.code.op(OP_I32_WRAP_I64);
            self.e.code.load(0);
            self.e.code.set(dest);
        } else if op == Op::Call {
            self.call(at);
        } else if op == Op::Indirect {
            let callee = self.cx.ir.word(operands);
            let mut resumes = false;
            for k in 0..self.e.resume_reads.len() {
                if u64_at(in self.e.resume_reads, k) == callee {
                    resumes = true;
                }
            }
            if resumes {
                self.resume_call(dest_val, inc(operands));
            } else {
                self.indirect(at);
            }
        } else if op == Op::Try {
            let vid = self.cx.ir.word(operands);
            let result_val = self.value(vid);
            let result_ty = self.vty(vid);
            let node = self.cx.types.node(result_ty);
            if !(node.kind == TyKind::Named && node.name == self.cx.s.result && node.n == 2) {
                Fail::raise(werr(K_UNSUPPORTED, U_OPERATION, 197));
            }
            let err_ty = self.cx.types.arg(result_ty, 1);
            let dest = self.dest(dest_val);
            self.load(result_val, 0);
            self.e.code.op(OP_I64_EQZ);
            self.e.code.open(OP_IF);
            self.load(result_val, 8);
            self.e.code.set(dest);
            self.e.code.op(OP_ELSE);
            let err_val = self.local();
            self.load(result_val, 8);
            self.e.code.set(err_val);
            let mut inst = ChunkSeq::new[u32]();
            inst.push(err_ty);
            let mut args = ChunkSeq::new[u32]();
            args.push(err_val);
            let fail = self.cx.s.fail;
            let raise = self.cx.s.raise;
            let raised = self.perform(fail, raise, in inst, NONE32, in args);
            self.e.code.op(OP_UNREACHABLE);
            self.e.code.op(OP_END);
        } else if op == Op::Seq {
            self.seq(at, ty, dest_val);
        } else if op == Op::Fip {
            // `Box::new(v)` (and its `@fip` forms, `new_in_caller` and slot
            // reuse): a `Box[T]` is the one-field struct of the prelude, a
            // block holding `v`. The heap is a bump region that tail loops
            // evacuate, so a reused slot is a fresh block too and the
            // `box_drops` reclamation points need no code.
            if self.cx.ir.word(inc(operands)) != 1 {
                Fail::raise(werr(K_UNSUPPORTED, U_OPERATION, 245));
            }
            let v = self.seq_val(operands, 0);
            let block = self.alloc_block(8);
            self.store(block, 0, v);
            self.set_value(dest_val, block);
        } else if op == Op::Handle {
            let id = self.plan.handler_at(self.e.inst.key, dest_val);
            if id == NONE64 {
                Fail::raise(werr(K_INVALID, 0, 198));
            }
            let state_val = if self.cx.ir.word(operands) != 0 {
                self.cx.ir.word(inc(operands))
            } else {
                NONE64
            };
            let handled = self.handle(id, state_val);
            self.set_value(dest_val, handled);
        } else if op == Op::Closure {
            let (pool, aa, an) = closure_operands(in self.cx, operands);
            let fact = self.cx.f.expr(pool);
            let caps = captures(in self.cx, fact.f0, fact.fc, aa, an, self.e.info);
            let vars = self.plan.vars(self.e.inst);
            let function = instance_name(inout self.cx, fact.fn_, in vars);
            let slot = self.trampoline(function, caps.len());
            let mut values = ChunkSeq::new[u32]();
            for k in 0..caps.len() {
                let alias = alias_of(in self.cx, aa, an, u32_at(in caps, k));
                if alias == NONE32 {
                    Fail::raise(werr(K_INVALID, 0, 199));
                }
                values.push(self.read_name(alias));
            }
            let block = self.callable(slot, true, true, in values);
            self.set_value(dest_val, block);
        } else {
            Fail::raise(werr(K_UNSUPPORTED, U_OPERATION, 200));
        }
    }

    // `widen_k(x)`, `narrow_k(x)` (checked: `ArithOverflow` past `k`) and
    // `wrapping_k(x)` between the lowered integer kinds (#1506): push the
    // result, or false for another operator. Rust lowers none of them.
    fn conversion(inout self, opn: u32, operand: u32, from: u8, ty: u32) -> bool eff [Fail[WErr]] {
        let kind = if self.has_prefix(opn, "widen_") {
            0
        } else if self.has_prefix(opn, "narrow_") {
            1
        } else if self.has_prefix(opn, "wrapping_") {
            2
        } else {
            return false;
        };
        if !is_int(from) {
            return false;
        }
        let to = self.scalar_of(ty);
        if !is_int(to) {
            return false;
        }
        if kind == 1 && from != to {
            if ik_unsigned(to) {
                self.e.code.get(operand);
                self.e.code.u64_const(ik_mask(to));
                self.e.code.op(OP_I64_GT_U);
                if ik_signed(from) && to == SC_U64 {
                    self.e.code.op(OP_DROP);
                    self.e.code.get(operand);
                    self.e.code.i64_const(0);
                    self.e.code.op(OP_I64_LT_S);
                }
            } else if ik_signed(from) {
                self.e.code.get(operand);
                self.e.code.i64_const(ik_min(to));
                self.e.code.op(OP_I64_LT_S);
                self.e.code.get(operand);
                self.e.code.i64_const(ik_max(to));
                self.e.code.op(OP_I64_GT_S);
                self.e.code.op(OP_I32_OR);
            } else {
                self.e.code.get(operand);
                self.e.code.u64_const(wrapping_u64(ik_max(to)));
                self.e.code.op(OP_I64_GT_U);
            }
            self.e.code.open(OP_IF);
            self.raise_overflow();
            self.e.code.op(OP_END);
        }
        self.e.code.get(operand);
        if kind == 2 && (to == SC_U8 || to == SC_U16 || to == SC_U32) {
            self.e.code.u64_const(ik_mask(to));
            self.e.code.op(OP_I64_AND);
        } else if kind == 2 && (to == SC_I8 || to == SC_I16 || to == SC_I32) {
            let shift = wrapping_sub(64, ik_bits(to));
            self.e.code.u64_const(shift);
            self.e.code.op(OP_I64_SHL);
            self.e.code.u64_const(shift);
            self.e.code.op(OP_I64_SHR_S);
        }
        true
    }

    // An `Atomic[T]` operation (src/atomics.rs): the prelude bodies only
    // type the call and recurse, so every backend intercepts them. Wasm runs
    // one thread here: a plain access of `self.cell[0]`. `compare_exchange`
    // is refused. Rust lowers no atomic (its cell is a `ChunkSeq`).
    fn atomic_call(inout self, dest_val: u64, callee: u32, operands: u64) -> bool eff [Fail[WErr]] {
        if !self.has_prefix(callee, "Atomic::") {
            return false;
        }
        let mut atomic_idx: u64 = 0;
        let mut found = false;
        loop {
            if atomic_idx >= 9 {
                break;
            }
            let mut spelled = ChunkSeq::new[u8]();
            append_text(inout spelled, "Atomic::");
            append_text(inout spelled, atomic_op(atomic_idx));
            if self.cx.names.spells(callee, in spelled.as_slice()) {
                found = true;
                break;
            }
            atomic_idx = inc(atomic_idx);
        }
        if !found {
            if self.cx.names.spells(callee, in "Atomic::compare_exchange".as_bytes()) {
                Fail::raise(werr(K_UNSUPPORTED, U_OPERATION, 237));
            }
            return false;
        }
        let atomic = self.seq_val(operands, 0);
        let atomic_ty = self.seq_ty(operands, 0);
        let atomic_dty = self.cx.default_ty(atomic_ty);
        let cell_ty = self.cx.types.arg(atomic_dty, 0);
        let cell = self.local();
        self.load(atomic, 0);
        self.e.code.set(cell);
        // The cell's element type `T`.
        let stride = if cell_ty == NONE32 {
            8
        } else {
            let sh = self.cx.shape(cell_ty);
            if sh.kind == SH_SCALAR && sh.scalar == SC_U8 {
                1
            } else {
                8
            }
        };
        let scalar = if cell_ty == NONE32 {
            SC_U64
        } else {
            self.scalar_of(cell_ty)
        };
        let base = self.local();
        self.e.code.get(cell);
        self.e.code.i64_const(8);
        self.e.code.op(OP_I64_ADD);
        self.e.code.set(base);
        let zero = self.const_local(0);
        let old = self.elem_load(base, zero, stride);
        if atomic_idx == 0 || atomic_idx == 8 {
            self.set_value(dest_val, old);
            return true;
        }
        let operand = self.seq_val(operands, 1);
        let updated = if atomic_idx == 1 || atomic_idx == 2 {
            operand
        } else {
            let result = self.local();
            self.e.code.get(old);
            self.e.code.get(operand);
            self.e.code.op(
                if atomic_idx == 3 {
                    OP_I64_ADD
                } else if atomic_idx == 4 {
                    OP_I64_SUB
                } else if atomic_idx == 5 {
                    OP_I64_AND
                } else if atomic_idx == 6 {
                    OP_I64_OR
                } else {
                    OP_I64_XOR
                }
            );
            if (atomic_idx == 3 || atomic_idx == 4) && (scalar == SC_U8 || scalar == SC_U32) {
                self.e.code.u64_const(ik_mask(scalar));
                self.e.code.op(OP_I64_AND);
            }
            self.e.code.set(result);
            result
        };
        self.elem_store(base, zero, stride, updated);
        if atomic_idx == 1 {
            self.unit_into(dest_val);
        } else {
            self.set_value(dest_val, old);
        }
        true
    }

    fn has_prefix(in self, sym_id: u32, in text: Str) -> bool {
        let prefix = text.as_bytes();
        let n = prefix.len();
        if self.cx.names.size(sym_id) < n {
            return false;
        }
        for i in 0..n {
            let byte_val = match prefix.try_get(i) {
                Option::Some(byte_val) => byte_val,
                Option::None => 0,
            };
            if self.cx.names.byte(sym_id, i) != byte_val {
                return false;
            }
        }
        true
    }

    fn is_op(in self, sym_id: u32, in text: Str) -> bool {
        self.cx.names.spells(sym_id, in text.as_bytes())
    }

    // `place.split('.')`: the root (NONE32 when empty) and the path.
    fn split_place(inout self, place: u32) -> (u32, ChunkSeq[u32]) {
        let mut segs = ChunkSeq::new[u32]();
        let mut root: u32 = NONE32;
        let mut cur = ChunkSeq::new[u8]();
        let n = self.cx.names.size(place);
        let mut first = true;
        for i in 0..inc(n) {
            let byte_val = if i < n {
                self.cx.names.byte(place, i)
            } else {
                46
            };
            if byte_val == 46 {
                let seg = self.cx.intern(in cur);
                if first {
                    root = if cur.len() == 0 { NONE32 } else { seg };
                    first = false;
                } else {
                    segs.push(seg);
                }
                cur.clear();
            } else {
                cur.push(byte_val);
            }
        }
        (root, segs)
    }

    // `op[from..len-1]` when `op` ends with `'='`, or NONE32.
    pub fn strip_eq(inout self, opn: u32, from: u64) -> u32 {
        let n = self.cx.names.size(opn);
        if n <= from || self.cx.names.byte(opn, wrapping_sub(n, 1)) != 61 {
            return NONE32;
        }
        let mut stripped = ChunkSeq::new[u8]();
        for i in from..wrapping_sub(n, 1) {
            stripped.push(self.cx.names.byte(opn, i));
        }
        self.cx.intern(in stripped)
    }

    // `callable`: a callable block for table `slot`.
    fn callable(
        inout self,
        slot: u32,
        snapshot: bool,
        has_caps: bool,
        in values: ChunkSeq[u32]
    ) -> u32 {
        let block = self.alloc_block(24);
        let scratch = self.local();
        self.e.code.u64_const(widen_u64(slot));
        self.e.code.set(scratch);
        self.store(block, 0, scratch);
        let nkeys = self.env_globals.len();
        let ev = if snapshot && nkeys != 0 {
            let ev = self.alloc_block(wrapping_mul(8, nkeys));
            for n in 0..nkeys {
                self.e.code.global_get(u32_at(in self.env_globals, n));
                self.e.code.set(scratch);
                self.store(ev, wrapping_mul(8, n), scratch);
            }
            ev
        } else {
            let zero = self.local();
            self.e.code.i64_const(0);
            self.e.code.set(zero);
            zero
        };
        self.store(block, C_EVIDENCE, ev);
        let caps = if has_caps && values.len() != 0 {
            let caps = self.alloc_block(wrapping_mul(8, values.len()));
            for i in 0..values.len() {
                self.store(caps, wrapping_mul(8, i), u32_at(in values, i));
            }
            caps
        } else {
            let zero = self.local();
            self.e.code.i64_const(0);
            self.e.code.set(zero);
            zero
        };
        self.store(block, C_CAPTURES, caps);
        block
    }

    // `bind_evidence` with no evidence keys installed: the callable as is.
    fn bind_evidence(inout self, callee_val: u32, ty: u32) -> u32 eff [Fail[WErr]] {
        let fn_ty = self.cx.default_ty(ty);
        let node = self.cx.types.node(fn_ty);
        if node.kind != TyKind::Fn {
            return callee_val;
        }
        let nkeys = self.env_globals.len();
        // key index -> (exact global, fallback global), NONE32 when unset;
        // has[n] says whether a source was recorded
        let mut first = ChunkSeq::new[u32]();
        let mut fallback = ChunkSeq::new[u32]();
        let mut has = ChunkSeq::new[bool]();
        for n in 0..nkeys {
            first.push(NONE32);
            fallback.push(NONE32);
            has.push(false);
        }
        let row = self.cx.types.row(node.r2);
        if row.tail != 0 {
            for n in 0..nkeys {
                let ok1 = first.try_set(n, u32_at(in self.env_globals, n));
                let ok2 = has.try_set(n, true);
            }
        }
        for i in 0..w(row.n) {
            let eff_row = self.cx.types.effect_at(add(w(row.a), i));
            let mut generic = false;
            let mut args = ChunkSeq::new[u32]();
            for k in 0..w(eff_row.n) {
                let arg_ty = u32_at(in self.cx.types.items, add(w(eff_row.a), k));
                if self.type_mentions(arg_ty) {
                    generic = true;
                }
                args.push(arg_ty);
            }
            if generic {
                continue;
            }
            let label = if eff_row.label == 0 {
                NONE32
            } else {
                let label_sym = wrapping_sub(eff_row.label, 1);
                if self.has_prefix(label_sym, "$latent:") {
                    NONE32
                } else {
                    label_sym
                }
            };
            let exact = instance_key(inout self.cx, eff_row.name, in args);
            let (src_exact, src_fallback) = if label != NONE32 {
                let label_key = prefixed_key(inout self.cx, true, label);
                (self.env_global(label_key), NONE32)
            } else {
                let name_key = prefixed_key(inout self.cx, false, eff_row.name);
                (self.env_global(exact), self.env_global(name_key))
            };
            if src_exact == NONE32 && src_fallback == NONE32 {
                continue;
            }
            let eff_key = prefixed_key(inout self.cx, false, eff_row.name);
            let label_key2 = if label != NONE32 {
                prefixed_key(inout self.cx, true, label)
            } else {
                NONE32
            };
            for n in 0..nkeys {
                let key = u32_at(in self.env_keys, n);
                if key == eff_key
                    || (exact != NONE32 && key == exact)
                    || (label_key2 != NONE32 && key == label_key2) {
                    let ok1 = first.try_set(n, src_exact);
                    let ok2 = fallback.try_set(n, src_fallback);
                    let ok3 = has.try_set(n, true);
                }
            }
        }
        let mut any = false;
        for n in 0..nkeys {
            match has.try_get(n) {
                Option::Some(flag) => {
                    if flag {
                        any = true;
                    }
                },
                Option::None => {},
            }
        }
        if !any {
            return callee_val;
        }
        let old = self.local();
        let ev = self.alloc_block(wrapping_mul(8, nkeys));
        let scratch = self.local();
        self.load(callee_val, C_EVIDENCE);
        self.e.code.set(old);
        for n in 0..nkeys {
            self.e.code.get(old);
            self.e.code.op(OP_I64_EQZ);
            self.e.code.open_result(OP_IF, vt(VT_I64));
            self.e.code.i64_const(0);
            self.e.code.op(OP_ELSE);
            self.e.code.get(old);
            self.e.code.op(OP_I32_WRAP_I64);
            self.e.code.load(wrapping_mul(8, n));
            self.e.code.op(OP_END);
            self.e.code.set(scratch);
            let recorded = match has.try_get(n) {
                Option::Some(flag) => flag,
                Option::None => false,
            };
            if recorded {
                let first_src = u32_at(in first, n);
                let fallback_src = u32_at(in fallback, n);
                self.e.code.get(scratch);
                self.e.code.op(OP_I64_EQZ);
                self.e.code.open(OP_IF);
                if first_src != NONE32 && fallback_src != NONE32 {
                    self.e.code.global_get(first_src);
                    self.e.code.tee(scratch);
                    self.e.code.op(OP_I64_EQZ);
                    self.e.code.open(OP_IF);
                    self.e.code.global_get(fallback_src);
                    self.e.code.set(scratch);
                    self.e.code.op(OP_END);
                } else if first_src != NONE32 || fallback_src != NONE32 {
                    let src_global = if first_src != NONE32 {
                        first_src
                    } else {
                        fallback_src
                    };
                    self.e.code.global_get(src_global);
                    self.e.code.set(scratch);
                }
                self.e.code.op(OP_END);
            }
            self.store(ev, wrapping_mul(8, n), scratch);
        }
        let block = self.alloc_block(24);
        self.load(callee_val, 0);
        self.e.code.set(scratch);
        self.store(block, 0, scratch);
        self.load(callee_val, C_CAPTURES);
        self.e.code.set(scratch);
        self.store(block, C_CAPTURES, scratch);
        self.store(block, C_EVIDENCE, ev);
        block
    }

    // `params_of`: the passing modes and types of instance `callee`.
    fn params_of(inout self, callee: u32) -> (ChunkSeq[u8], ChunkSeq[u32]) {
        let vars = self.vars_of_key(callee).vars();
        let base = self.base_of(callee);
        let mut passes = ChunkSeq::new[u8]();
        let mut tys = ChunkSeq::new[u32]();
        let fs = self.cx.fn_sig(base);
        if fs != 0 {
            let sig = self.cx.f.sig(wrapping_sub(fs, 1));
            for k in 0..sig.pn {
                let param = self.cx.f.param(add(sig.p0, k));
                passes.push(param.pass);
                tys.push(self.cx.subst(param.ty, in vars));
            }
        }
        (passes, tys)
    }

    // `call_args` of the arguments at `ops[at]` (n, n x (pass, value,
    // root, path)): values, or cells for `inout` places.
    fn call_args(
        inout self,
        at: u64,
        in passes: ChunkSeq[u8],
        in tys: ChunkSeq[u32],
        inout cells: ChunkSeq[Cell]
    ) -> ChunkSeq[u32] eff [Fail[WErr]] {
        let mut out = ChunkSeq::new[u32]();
        let n = self.cx.ir.word(at);
        for i in 0..n {
            let arg_at = add(inc(at), wrapping_mul(i, 4));
            let pass = self.cx.ir.word(arg_at);
            let vid = self.cx.ir.word(inc(arg_at));
            let root = self.cx.ir.word(add(arg_at, 2));
            let path = self.cx.ir.word(add(arg_at, 3));
            let pinout = match passes.try_get(i) {
                Option::Some(mode) => mode == TyPass::Inout,
                Option::None => false,
            };
            if !(pass == 1 || pinout) {
                let arg_val = self.value(vid);
                if i < tys.len() {
                    // A `String` passed as a `Str` is its whole view.
                    let param_ty = u32_at(in tys, i);
                    let val = if self.seq_kind(param_ty) == SK_VIEW {
                        let arg_ty = self.vty(vid);
                        if self.seq_kind(arg_ty) == SK_BUF {
                            let (base, view_len) = self.parts(arg_val, arg_ty);
                            self.pack(base, view_len)
                        } else {
                            arg_val
                        }
                    } else {
                        arg_val
                    };
                    out.push(self.bind_evidence(val, param_ty));
                } else {
                    out.push(arg_val);
                }
                continue;
            }
            if root == 0 {
                // A temporary view (`inout s.as_slice_mut()`, `inout
                // s[a..b]`): its elements are written in place, so the cell
                // needs no writeback.
                let arg_ty = self.vty(vid);
                if self.seq_kind(arg_ty) != SK_VIEW {
                    Fail::raise(werr(K_INVALID, 0, 211));
                }
                let val = self.value(vid);
                let cell = self.alloc_block(8);
                self.store(cell, 0, val);
                out.push(cell);
                continue;
            }
            let root_sym = n32(wrapping_sub(root, 1));
            if path == 0 {
                let slot_idx = self.slot_index(root_sym);
                if slot_idx != NONE64 {
                    let slot = self.name_slot(root_sym);
                    if slot.cell {
                        out.push(slot.local);
                        continue;
                    }
                }
            }
            let segs = self.path_names(path);
            let (val, place_ty) = self.read_place(root_sym, in segs);
            let cell = self.alloc_block(8);
            self.store(cell, 0, val);
            out.push(cell);
            cells.push(Cell { cell: cell, root: root_sym, path: path });
        }
        out
    }

    fn writeback(inout self, in cells: ChunkSeq[Cell]) eff [Fail[WErr]] {
        for i in 0..cells.len() {
            match cells.try_get(i) {
                Option::Some(cell) => {
                    let val = self.local();
                    self.load(cell.cell, 0);
                    self.e.code.set(val);
                    let segs = self.path_names(cell.path);
                    self.write_place(cell.root, in segs, val);
                },
                Option::None => {},
            }
        }
    }

    fn call(inout self, at: u64) eff [Fail[WErr]] {
        let ins = self.cx.ir.p.inst(at);
        let operands = ins.a;
        let dest_val = widen_u64(ins.dest);
        let callee = n32(self.cx.ir.word(operands));
        if self.seqs && self.atomic_call(dest_val, callee, operands) {
            return;
        }
        if self.table_call(dest_val, callee) {
            return;
        }
        if self.cx.ir.find(callee) != 0 {
            if self.try_heap_intrinsic(callee, dest_val, operands) {
                return;
            }
            let key = self.callee_key(dest_val);
            if key == NONE32 {
                Fail::raise(werr_syms(K_INVALID, 0, 220, self.e.inst.base, callee));
            }
            self.direct_call(dest_val, key, inc(operands));
            return;
        }
        let (ename, opname) = self.split_op(callee);
        if ename != NONE32 && (ename == self.cx.s.ffi_env || ename == self.cx.s.ffi_fs) {
            self.host_call(dest_val, ename, opname, operands);
            return;
        }
        if ename == NONE32 || self.cx.f.decl_of(ename) == 0 {
            Fail::raise(
                werr_syms(K_UNSUPPORTED, U_EXTERNAL_FUNCTION, 221, self.e.inst.base, callee)
            );
        }
        let decl = self.cx.f.decl(wrapping_sub(self.cx.f.decl_of(ename), 1));
        let mut passes = ChunkSeq::new[u8]();
        let mut tys = ChunkSeq::new[u32]();
        for o in 0..decl.on {
            let op_decl = self.cx.f.op(add(decl.o0, o));
            if op_decl.name == opname {
                let sig = self.cx.f.sig(op_decl.sig);
                for k in 0..sig.pn {
                    passes.push(self.cx.f.param(add(sig.p0, k)).pass);
                    tys.push(self.infer());
                }
                break;
            }
        }
        let mut cells = ChunkSeq::new[Cell]();
        let vals = self.call_args(inc(operands), in passes, in tys, inout cells);
        let n_args = self.cx.ir.word(inc(operands));
        let targs_at = add(add(operands, 2), wrapping_mul(n_args, 4));
        let n_targs = self.cx.ir.word(targs_at);
        let mut types = ChunkSeq::new[u32]();
        for k in 0..n_targs {
            let targ = n32(self.cx.ir.word(add(inc(targs_at), k)));
            types.push(self.subst(targ));
        }
        let cap = self.cx.ir.word(add(inc(targs_at), n_targs));
        let label = if cap == 0 {
            NONE32
        } else {
            n32(wrapping_sub(cap, 1))
        };
        let result = self.perform_unchecked(ename, opname, in types, label, in vals);
        self.writeback(in cells);
        self.abort_check();
        self.set_value(dest_val, result);
    }

    // A call of a StdEnv or StdFs function: its shim (src/host.ves) on the
    // argument words, with handles, `FsMeta` and `Option` results built
    // here.
    fn host_call(inout self, dest_val: u64, ename: u32, opname: u32, operands: u64) eff [
        Fail[WErr]
    ] {
        let decl_id = self.cx.f.decl_of(ename);
        if decl_id == 0 {
            Fail::raise(werr(K_UNSUPPORTED, U_EXTERNAL_FUNCTION, 243));
        }
        let decl = self.cx.f.decl(wrapping_sub(decl_id, 1));
        let mut passes = ChunkSeq::new[u8]();
        let mut tys = ChunkSeq::new[u32]();
        let mut result = NONE32;
        for o in 0..decl.on {
            let op_decl = self.cx.f.op(add(decl.o0, o));
            if op_decl.name == opname {
                let sig = self.cx.f.sig(op_decl.sig);
                for host_op in 0..sig.pn {
                    let param = self.cx.f.param(add(sig.p0, host_op));
                    passes.push(param.pass);
                    tys.push(param.ty);
                }
                result = sig.result;
                break;
            }
        }
        if result == NONE32 {
            Fail::raise(werr(K_UNSUPPORTED, U_EXTERNAL_FUNCTION, 244));
        }
        let mut name = ChunkSeq::new[u8]();
        for i in 0..self.cx.names.size(opname) {
            name.push(self.cx.names.byte(opname, i));
        }
        let lib: u8 = if ename == self.cx.s.ffi_env { 3 } else { 4 };
        let host_op = op_index(in name.as_slice(), lib, in passes);
        let mut cells = ChunkSeq::new[Cell]();
        let vals = self.host_args(inc(operands), in passes, in tys, inout cells);
        let mut args = ChunkSeq::new[u32]();
        for i in 0..vals.len() {
            args.push(u32_at(in vals, i));
        }
        if takes_handle(host_op) {
            // An `FsFile` / `FsDir` is a one-field struct: its handle.
            let handle_ptr = u32_at(in vals, 0);
            let handle = self.local();
            let first_pass = match passes.try_get(0) {
                Option::Some(param) => param,
                Option::None => 0,
            };
            if first_pass == TyPass::Inout {
                self.load(handle_ptr, 0);
                self.e.code.set(handle);
                self.load(handle, 0);
            } else {
                self.load(handle_ptr, 0);
            }
            self.e.code.set(handle);
            let ok = args.try_set(0, handle);
        }
        let mut meta = NONE32;
        let mut fresh = NONE32;
        if takes_meta(host_op) {
            meta = u32_at(in vals, 2);
            let old = self.local();
            self.load(meta, 0);
            self.e.code.set(old);
            fresh = self.alloc_block(32);
            let scratch = self.local();
            for word_idx in 0..4 {
                self.load(old, wrapping_mul(word_idx, 8));
                self.e.code.set(scratch);
                self.store(fresh, wrapping_mul(word_idx, 8), scratch);
            }
            let ok = args.try_set(2, fresh);
        }
        for i in 0..args.len() {
            self.e.code.get(u32_at(in args, i));
        }
        let shim_idx = host_fn(inout self.b, inout self.host, host_op);
        let ret_val = self.local();
        self.e.code.call(shim_idx);
        self.e.code.set(ret_val);
        if meta != NONE32 {
            self.store(meta, 0, fresh);
        }
        self.writeback(in cells);
        if returns_handle(host_op) {
            let result_ty = self.subst(result);
            let (some, some_enum, some_shape) = self.cx.variant_of(result_ty, self.cx.s.some);
            let (none, none_enum, none_shape) = self.cx.variant_of(result_ty, self.cx.s.none);
            let some_box = self.alloc_block(8);
            self.store(some_box, 0, ret_val);
            let option_block = self.alloc_block(16);
            let tag = self.local();
            self.e.code.u64_const(some);
            self.e.code.u64_const(none);
            self.e.code.get(ret_val);
            self.e.code.i64_const(0);
            self.e.code.op(OP_I64_NE);
            self.e.code.op(OP_SELECT);
            self.e.code.set(tag);
            self.store(option_block, 0, tag);
            self.store(option_block, 8, some_box);
            let dest = self.dest(dest_val);
            self.e.code.get(option_block);
            self.e.code.set(dest);
        } else {
            self.set_value(dest_val, ret_val);
        }
    }

    // `call_args` for a foreign call, where an `inout` argument may be a
    // temporary view (`inout buf.as_slice_mut()`): it gets a cell of its
    // own, with nothing to write back (the shim writes through the view).
    fn host_args(
        inout self,
        at: u64,
        in passes: ChunkSeq[u8],
        in tys: ChunkSeq[u32],
        inout cells: ChunkSeq[Cell]
    ) -> ChunkSeq[u32] eff [Fail[WErr]] {
        let n = self.cx.ir.word(at);
        let mut temps = ChunkSeq::new[u32]();
        let mut any = false;
        for i in 0..n {
            let arg_at = add(inc(at), wrapping_mul(i, 4));
            let pinout = match passes.try_get(i) {
                Option::Some(mode) => mode == TyPass::Inout,
                Option::None => false,
            };
            let root = self.cx.ir.word(add(arg_at, 2));
            if (self.cx.ir.word(arg_at) == 1 || pinout) && root == 0 {
                let val = self.value(self.cx.ir.word(inc(arg_at)));
                let cell = self.alloc_block(8);
                self.store(cell, 0, val);
                temps.push(cell);
                any = true;
            } else {
                temps.push(NONE32);
            }
        }
        if !any {
            return self.call_args(at, in passes, in tys, inout cells);
        }
        // Lower each remaining argument on its own: a one-argument list
        // at a copy of its words is not available, so the place arguments
        // here are read and celled like `call_args` does.
        let mut out = ChunkSeq::new[u32]();
        for i in 0..n {
            let temp_cell = u32_at(in temps, i);
            if temp_cell != NONE32 {
                out.push(temp_cell);
                continue;
            }
            let arg_at = add(inc(at), wrapping_mul(i, 4));
            let pass = self.cx.ir.word(arg_at);
            let vid = self.cx.ir.word(inc(arg_at));
            let root = self.cx.ir.word(add(arg_at, 2));
            let path = self.cx.ir.word(add(arg_at, 3));
            let pinout = match passes.try_get(i) {
                Option::Some(mode) => mode == TyPass::Inout,
                Option::None => false,
            };
            if !(pass == 1 || pinout) {
                out.push(self.value(vid));
                continue;
            }
            let root_sym = n32(wrapping_sub(root, 1));
            if path == 0 {
                let slot_idx = self.slot_index(root_sym);
                if slot_idx != NONE64 {
                    let slot = self.name_slot(root_sym);
                    if slot.cell {
                        out.push(slot.local);
                        continue;
                    }
                }
            }
            let segs = self.path_names(path);
            let (val, place_ty) = self.read_place(root_sym, in segs);
            let cell = self.alloc_block(8);
            self.store(cell, 0, val);
            out.push(cell);
            cells.push(Cell { cell: cell, root: root_sym, path: path });
        }
        out
    }

    // `callee.split_once("::")`: (ename, op), or NONE32.
    fn split_op(inout self, name: u32) -> (u32, u32) {
        let n = self.cx.names.size(name);
        let mut i: u64 = 0;
        loop {
            if inc(i) >= n {
                break;
            }
            if self.cx.names.byte(name, i) == 58 && self.cx.names.byte(name, inc(i)) == 58 {
                let mut head = ChunkSeq::new[u8]();
                for k in 0..i {
                    head.push(self.cx.names.byte(name, k));
                }
                let mut tail = ChunkSeq::new[u8]();
                for k in add(i, 2)..n {
                    tail.push(self.cx.names.byte(name, k));
                }
                let head_sym = self.cx.intern(in head);
                let tail_sym = self.cx.intern(in tail);
                return (head_sym, tail_sym);
            }
            i = inc(i);
        }
        (NONE32, NONE32)
    }

    fn direct_call(inout self, dv: u64, callee: u32, args_at: u64) eff [Fail[WErr]] {
        let (passes, tys) = self.params_of(callee);
        let mut cells = ChunkSeq::new[Cell]();
        let vals = self.call_args(args_at, in passes, in tys, inout cells);
        let saved = self.bind_row_labels(callee);
        for k in 0..vals.len() {
            self.e.code.get(u32_at(in vals, k));
        }
        let d = self.dest(dv);
        self.e.code.call(self.func_of(callee));
        self.e.code.set(d);
        // saved: (global, local) pairs
        let mut k: u64 = 0;
        loop {
            if inc(k) >= saved.len() {
                break;
            }
            self.e.code.get(u32_at(in saved, inc(k)));
            self.e.code.global_set(u32_at(in saved, k));
            k = add(k, 2);
        }
        self.writeback(in cells);
        self.abort_check();
    }

    // `row_label_bindings`: for each label `l` of the callee's row
    // (`eff [l: E]`), the `$label:l` global (NONE32: none installs it)
    // and the globals `E` binds (`$effect:E`, `$label:l`, its instance
    // key); `emit_vars` also substitutes the emitting instance's arguments.
    fn row_label_bindings(inout self, callee: u32, emit_vars: bool) -> LabelBindings {
        let mut out = LabelBindings {
            labels: ChunkSeq::new[u32](),
            sources: ChunkSeq::new[u32](),
            t0: ChunkSeq::new[u64](),
            tn: ChunkSeq::new[u64](),
            targets: ChunkSeq::new[u32]()
        };
        let base = self.base_of(callee);
        let fs = self.cx.fn_sig(base);
        if fs == 0 {
            return out;
        }
        let vars = self.vars_of_key(callee).vars();
        let sig = self.cx.f.sig(wrapping_sub(fs, 1));
        for i in 0..sig.en {
            let eff_row = self.cx.f.eff(add(sig.e0, i));
            if eff_row.label == NONE32 || self.cx.names.byte(eff_row.label, 0) == 36 {
                continue;
            }
            let label_key = prefixed_key(inout self.cx, true, eff_row.label);
            let source = self.env_global(label_key);
            let mut args = ChunkSeq::new[u32]();
            for k in 0..eff_row.an {
                let raw_arg = self.cx.subst(self.cx.f.ty_at(add(eff_row.a0, k)), in vars);
                let arg_ty = if emit_vars {
                    self.subst(raw_arg)
                } else {
                    self.cx.default_ty(raw_arg)
                };
                args.push(arg_ty);
            }
            let eff_key = prefixed_key(inout self.cx, false, eff_row.name);
            let inst_key = instance_key(inout self.cx, eff_row.name, in args);
            out.labels.push(eff_row.label);
            out.sources.push(source);
            out.t0.push(out.targets.len());
            let eff_global = self.env_global(eff_key);
            if eff_global != NONE32 {
                out.targets.push(eff_global);
            }
            let label_global = self.env_global(label_key);
            if label_global != NONE32 {
                out.targets.push(label_global);
            }
            let inst_global = self.env_global(inst_key);
            if inst_global != NONE32 {
                out.targets.push(inst_global);
            }
            out.tn.push(
                wrapping_sub(out.targets.len(), u64_at(in out.t0, wrapping_sub(out.t0.len(), 1)))
            );
        }
        out
    }

    // `bind_row_labels`: rebinds the keys of the callee's labelled row
    // instances to the caller's handlers for the call; returns the saved
    // (global, local) pairs to restore after it.
    fn bind_row_labels(inout self, callee: u32) -> ChunkSeq[u32] eff [Fail[WErr]] {
        let bindings = self.row_label_bindings(callee, true);
        let mut sets = ChunkSeq::new[u32]();
        for i in 0..bindings.labels.len() {
            if !self.plan.has_label(self.e.inst, u32_at(in bindings.labels, i)) {
                Fail::raise(werr(K_UNSUPPORTED, U_LABELLED_EFFECT_ROW, 230));
            }
            let source = u32_at(in bindings.sources, i);
            if source == NONE32 {
                Fail::raise(werr(K_INVALID, 0, 231));
            }
            let val_local = self.local();
            self.e.code.global_get(source);
            self.e.code.set(val_local);
            for k in 0..u64_at(in bindings.tn, i) {
                sets.push(u32_at(in bindings.targets, add(u64_at(in bindings.t0, i), k)));
                sets.push(val_local);
            }
        }
        let mut saved = ChunkSeq::new[u32]();
        let mut k: u64 = 0;
        loop {
            if inc(k) >= sets.len() {
                break;
            }
            let global = u32_at(in sets, k);
            let val_local = u32_at(in sets, inc(k));
            let mut have = false;
            let mut j: u64 = 0;
            loop {
                if j >= saved.len() {
                    break;
                }
                if u32_at(in saved, j) == global {
                    have = true;
                }
                j = add(j, 2);
            }
            if !have {
                let old = self.local();
                self.e.code.global_get(global);
                self.e.code.set(old);
                saved.push(global);
                saved.push(old);
            }
            self.e.code.get(val_local);
            self.e.code.global_set(global);
            k = add(k, 2);
        }
        saved
    }

    fn indirect(inout self, at: u64) eff [Fail[WErr]] {
        let ins = self.cx.ir.p.inst(at);
        let operands = ins.a;
        let dest_val = widen_u64(ins.dest);
        let callee_id = self.cx.ir.word(operands);
        let callee = self.value(callee_id);
        let raw_ty = self.vty(callee_id);
        let fn_ty = self.cx.default_ty(raw_ty);
        let mut passes = ChunkSeq::new[u8]();
        let mut tys = ChunkSeq::new[u32]();
        if self.cx.types.kind(fn_ty) == TyKind::Fn {
            for k in 0..self.cx.arity(fn_ty) {
                passes.push(self.cx.types.param_pass(fn_ty, k));
                tys.push(self.cx.types.arg(fn_ty, k));
            }
        }
        let mut cells = ChunkSeq::new[Cell]();
        let vals = self.call_args(inc(operands), in passes, in tys, inout cells);
        let ty = self.indirect_type(vals.len());
        self.e.code.get(callee);
        for k in 0..vals.len() {
            self.e.code.get(u32_at(in vals, k));
        }
        let dest = self.dest(dest_val);
        self.load(callee, 0);
        self.e.code.op(OP_I32_WRAP_I64);
        self.e.code.call_indirect(ty);
        self.e.code.set(dest);
        self.writeback(in cells);
        self.abort_check();
    }

    // ----- handlers ----------------------------------------------------------

    fn hop(in self, i: u64) -> u64 {
        u64_at(in self.cx.f.hops, i)
    }

    // `expect_params`: `pushed` values for `key`'s parameters.
    fn expect_params(in self, key: u32, pushed: u64) eff [Fail[WErr]] {
        let i = self.plan.find(key);
        if i == 0 {
            Fail::raise(werr(K_INVALID, 0, 251));
        }
        if self.signature(self.plan.inst(wrapping_sub(i, 1))) != pushed {
            Fail::raise(werr(K_INVALID, 0, 252));
        }
    }

    // `flatten`: push the flattened parameters pattern `hops[at]` binds in
    // `value` (a local of type `ty`), allocating temporaries.
    fn flatten(
        inout self,
        inout c: Code,
        inout locals: ChunkSeq[ValTy],
        nparams: u32,
        at: u64,
        value: u32,
        ty: u32,
        inout count: u64
    ) eff [Fail[WErr]] {
        let kind = self.hop(at);
        if kind == Pat::Bind {
            c.get(value);
            count = inc(count);
        } else if kind == Pat::Tuple {
            let tuple_ty = self.cx.default_ty(ty);
            if self.cx.types.kind(tuple_ty) != TyKind::Tuple {
                return;
            }
            let n = self.hop(add(at, 3));
            let n_elems = self.cx.arity(tuple_ty);
            let mut pat_at = add(at, 4);
            for i in 0..n {
                if i >= n_elems {
                    break;
                }
                let tmp = wrapping_add(nparams, wrapping_u32(locals.len()));
                locals.push(vt(VT_I64));
                c.get(value);
                c.op(OP_I32_WRAP_I64);
                c.load(wrapping_mul(8, i));
                c.set(tmp);
                let elem_ty = self.cx.tuple_elem(tuple_ty, i);
                self.flatten(inout c, inout locals, nparams, pat_at, tmp, elem_ty, inout count);
                pat_at = pattern_end(in self.cx.f.hops, pat_at, 0);
            }
        } else if kind == Pat::Constructor {
            let name = n32(self.hop(add(at, 3)));
            let (index, is_enum, shape) = self.cx.variant_of(ty, name);
            let n = self.hop(add(at, 5));
            let mut pat_at = add(at, 6);
            for k in 0..n {
                let fname = n32(self.hop(pat_at));
                let field_idx = self.cx.field_index(shape, index, fname);
                if field_idx != NONE64 {
                    let tmp = wrapping_add(nparams, wrapping_u32(locals.len()));
                    locals.push(vt(VT_I64));
                    c.get(value);
                    c.op(OP_I32_WRAP_I64);
                    let slot = if is_enum { inc(field_idx) } else { field_idx };
                    c.load(wrapping_mul(8, slot));
                    c.set(tmp);
                    let (field_name, elem_ty) = self.cx.variant_field(shape, index, field_idx);
                    self.flatten(
                        inout c,
                        inout locals,
                        nparams,
                        inc(pat_at),
                        tmp,
                        elem_ty,
                        inout count
                    );
                }
                pat_at = pattern_end(in self.cx.f.hops, inc(pat_at), 0);
            }
        }
    }

    // `capture_values`: push handler `i`'s captures `hw[k0..k0+kn]` from
    // its frame.
    fn capture_values(in self, inout c: Code, i: u64, k0: u64, kn: u64, frame: u32) eff [
        Fail[WErr]
    ] {
        for k in 0..kn {
            let off = self.capture_offset(i, self.plan.word(add(k0, k)));
            c.get(frame);
            c.op(OP_I32_WRAP_I64);
            c.load(off);
        }
    }

    fn save_env(in self, inout c: Code, first: u32) {
        for n in 0..self.env_globals.len() {
            c.global_get(u32_at(in self.env_globals, n));
            c.set(wrapping_add(first, wrapping_u32(n)));
        }
    }

    fn restore_env_locals(in self, inout c: Code, first: u32) {
        for n in 0..self.env_globals.len() {
            c.get(wrapping_add(first, wrapping_u32(n)));
            c.global_set(u32_at(in self.env_globals, n));
        }
    }

    // `restore_env_frame`: env := handler `i`'s frame snapshot.
    fn restore_env_frame(in self, inout c: Code, frame: u32, i: u64) {
        let base = self.hfn(i).env_offset;
        for n in 0..self.env_globals.len() {
            c.get(frame);
            c.op(OP_I32_WRAP_I64);
            c.load(add(base, wrapping_mul(8, n)));
            c.global_set(u32_at(in self.env_globals, n));
        }
    }

    // `call_clause`: push clause `clause`'s captures, flattened arguments
    // (locals args0..) and state, then `hidden`, and call it.
    fn call_clause(
        inout self,
        inout c: Code,
        inout locals: ChunkSeq[ValTy],
        nparams: u32,
        i: u64,
        clause: HClause,
        frame: u32,
        args0: u32,
        in hidden: ChunkSeq[u32]
    ) eff [Fail[WErr]] {
        let handler_row = self.plan.handler(i);
        self.capture_values(inout c, i, clause.k0, clause.kn, frame);
        let mut count = clause.kn;
        let n = self.cx.f.sig(clause.sig).pn;
        let mut pat_at = clause.pats;
        for j in 0..clause.npats {
            if j >= n {
                break;
            }
            let arg_ty = self.plan.word(add(clause.t0, j));
            self.flatten(
                inout c,
                inout locals,
                nparams,
                pat_at,
                wrapping_add(args0, wrapping_u32(j)),
                arg_ty,
                inout count
            );
            pat_at = pattern_end(in self.cx.f.hops, pat_at, 0);
        }
        if handler_row.state != NONE32 && n < clause.npats {
            let state_tmp = wrapping_add(nparams, wrapping_u32(locals.len()));
            locals.push(vt(VT_I64));
            c.get(frame);
            c.op(OP_I32_WRAP_I64);
            c.load(F_STATE);
            c.set(state_tmp);
            self.flatten(
                inout c,
                inout locals,
                nparams,
                pat_at,
                state_tmp,
                handler_row.state,
                inout count
            );
        }
        for k in 0..hidden.len() {
            c.get(u32_at(in hidden, k));
            count = inc(count);
        }
        self.expect_params(clause.function, count);
        c.call(self.func_of(clause.function));
    }

    // `$ret_i(frame, r)`: the return clause.
    fn define_ret(inout self, i: u64) eff [Fail[WErr]] {
        let handler_row = self.plan.handler(i);
        let frame: u32 = 0;
        let result_param: u32 = 1;
        let mut c = code_new();
        let mut locals = ChunkSeq::new[ValTy]();
        self.capture_values(inout c, i, handler_row.rk0, handler_row.rkn, frame);
        let mut count = handler_row.rkn;
        let mut value = result_param;
        let mut ty = handler_row.body_type;
        if handler_row.state != NONE32 {
            let pair = wrapping_add(2, wrapping_u32(locals.len()));
            locals.push(vt(VT_I64));
            c.i64_const(16);
            c.call(self.alloc);
            c.tee(pair);
            c.op(OP_I32_WRAP_I64);
            c.get(result_param);
            c.store(0);
            c.get(pair);
            c.op(OP_I32_WRAP_I64);
            c.get(frame);
            c.op(OP_I32_WRAP_I64);
            c.load(F_STATE);
            c.store(8);
            let mut parts = ChunkSeq::new[u32]();
            parts.push(handler_row.body_type);
            parts.push(handler_row.state);
            value = pair;
            ty = self.cx.types.tuple(in parts);
        }
        self.flatten(inout c, inout locals, 2, handler_row.ret_pat, value, ty, inout count);
        self.expect_params(handler_row.ret, count);
        c.call(self.func_of(handler_row.ret));
        c.op(OP_END);
        let idx = self.hfn(i).ret;
        self.b.define(idx, in body_each(in locals, in c));
    }

    // `$dispatch_i(frame, op, a0..)`: perform an operation on this handler.
    fn define_dispatch(inout self, i: u64) eff [Fail[WErr]] {
        let handler_row = self.plan.handler(i);
        let frame: u32 = 0;
        let op: u32 = 1;
        let nparams = wrapping_u32(add(2, self.arity));
        let mut locals = i64s(self.env_globals.len());
        let env_save = nparams;
        let mut c = code_new();
        for k in 0..handler_row.cn {
            let clause = self.plan.clause(add(handler_row.c0, k));
            c.get(op);
            c.u64_const(clause.op);
            c.op(OP_I64_EQ);
            c.open(OP_IF);
            if clause.mode == M_ABORT {
                c.get(frame);
                c.op(OP_I32_WRAP_I64);
                c.get(op);
                c.store(F_ABORT_OP);
                for j in 0..self.arity {
                    c.get(frame);
                    c.op(OP_I32_WRAP_I64);
                    c.get(wrapping_add(2, wrapping_u32(j)));
                    c.store(add(F_ARGS, wrapping_mul(8, j)));
                }
                c.get(frame);
                c.global_set(self.abort);
                c.i64_const(0);
                c.op(OP_RETURN);
            } else {
                self.save_env(inout c, env_save);
                self.restore_env_frame(inout c, frame, i);
                let mut hidden = ChunkSeq::new[u32]();
                hidden.push(frame);
                self.call_clause(inout c, inout locals, nparams, i, clause, frame, 2, in hidden);
                self.restore_env_locals(inout c, env_save);
                c.op(OP_RETURN);
            }
            c.op(OP_END);
        }
        c.op(OP_UNREACHABLE);
        c.op(OP_END);
        let idx = self.hfn(i).dispatch;
        self.b.define(idx, in body_each(in locals, in c));
    }

    // `$abort_i(frame)`: run the aborting clause recorded in the frame.
    fn define_abort(inout self, i: u64) eff [Fail[WErr]] {
        let handler_row = self.plan.handler(i);
        let frame: u32 = 0;
        let nparams: u32 = 1;
        let mut locals = i64s(self.arity);
        let mut c = code_new();
        for j in 0..self.arity {
            c.get(frame);
            c.op(OP_I32_WRAP_I64);
            c.load(add(F_ARGS, wrapping_mul(8, j)));
            c.set(wrapping_add(1, wrapping_u32(j)));
        }
        for k in 0..handler_row.cn {
            let clause = self.plan.clause(add(handler_row.c0, k));
            if clause.mode != M_ABORT {
                continue;
            }
            c.get(frame);
            c.op(OP_I32_WRAP_I64);
            c.load(F_ABORT_OP);
            c.u64_const(clause.op);
            c.op(OP_I64_EQ);
            c.open(OP_IF);
            let hidden = ChunkSeq::new[u32]();
            self.call_clause(inout c, inout locals, nparams, i, clause, frame, 1, in hidden);
            c.op(OP_RETURN);
            c.op(OP_END);
        }
        c.op(OP_UNREACHABLE);
        c.op(OP_END);
        let idx = self.hfn(i).abort;
        self.b.define(idx, in body_each(in locals, in c));
    }

    // `handle`: install handler `id` around its body (state value `state_val`,
    // NONE64: none) and return the handler's output.
    fn handle(inout self, id: u64, state_val: u64) -> u32 eff [Fail[WErr]] {
        let handler_row = self.plan.handler(id);
        let hfns = self.hfn(id);
        let frame = self.alloc_block(hfns.frame_size);
        let scratch = self.local();
        self.e.code.u64_const(widen_u64(hfns.dispatch_slot));
        self.e.code.set(scratch);
        self.store(frame, F_DISPATCH, scratch);
        self.e.code.get(frame);
        self.e.code.op(OP_I32_WRAP_I64);
        self.e.code.i64_const(0);
        self.e.code.store(hfns.pending_offset);
        if state_val != NONE64 {
            let state = self.value(state_val);
            self.store(frame, F_STATE, state);
        }
        for n in 0..self.env_globals.len() {
            self.e.code.get(frame);
            self.e.code.op(OP_I32_WRAP_I64);
            self.e.code.global_get(u32_at(in self.env_globals, n));
            self.e.code.store(add(hfns.env_offset, wrapping_mul(8, n)));
        }
        for k in 0..hfns.cn {
            let name = u32_at(in self.hcap_name, add(hfns.c0, k));
            let off = u64_at(in self.hcap_off, add(hfns.c0, k));
            let slot = alias_of(in self.cx, handler_row.alias_at, handler_row.alias_n, name);
            if slot == NONE32 {
                Fail::raise(werr(K_INVALID, 0, 259));
            }
            let val = self.read_name(slot);
            self.store(frame, off, val);
        }
        // Body captures are cells.
        let info = self.ir_info(handler_row.body);
        let mut body_args = ChunkSeq::new[u32]();
        let mut cells = ChunkSeq::new[u32]();
        let mut cell_slots = ChunkSeq::new[u32]();
        for k in 0..info.pn {
            let pname = self.cx.ir.param(add(info.p0, k)).name;
            let slot = alias_of(in self.cx, handler_row.alias_at, handler_row.alias_n, pname);
            if slot == NONE32 {
                Fail::raise(werr(K_INVALID, 0, 254));
            }
            let slot_idx = self.slot_index(slot);
            if slot_idx != NONE64 {
                let cell_slot = self.name_slot(slot);
                if cell_slot.cell {
                    body_args.push(cell_slot.local);
                    continue;
                }
            }
            let val = self.read_name(slot);
            let cell = self.alloc_block(8);
            self.store(cell, 0, val);
            body_args.push(cell);
            cells.push(cell);
            cell_slots.push(slot);
        }
        let out = self.local();
        for k in 0..handler_row.en {
            let env_g = self.env_global(self.plan.word(add(handler_row.e0, k)));
            self.e.code.get(frame);
            self.e.code.global_set(env_g);
        }
        let body_result = self.local();
        for k in 0..body_args.len() {
            self.e.code.get(u32_at(in body_args, k));
        }
        self.e.code.call(self.func_of(handler_row.body));
        self.e.code.set(body_result);
        let base = hfns.env_offset;
        for n in 0..self.env_globals.len() {
            self.e.code.get(frame);
            self.e.code.op(OP_I32_WRAP_I64);
            self.e.code.load(add(base, wrapping_mul(8, n)));
            self.e.code.global_set(u32_at(in self.env_globals, n));
        }
        for k in 0..cells.len() {
            let val = self.local();
            self.load(u32_at(in cells, k), 0);
            self.e.code.set(val);
            self.write_name(u32_at(in cell_slots, k), val);
        }
        self.e.code.global_get(self.abort);
        self.e.code.get(frame);
        self.e.code.op(OP_I64_EQ);
        self.e.code.open_result(OP_IF, vt(VT_I64));
        self.e.code.i64_const(0);
        self.e.code.global_set(self.abort);
        self.e.code.get(frame);
        self.e.code.call(hfns.abort);
        self.e.code.op(OP_ELSE);
        self.e.code.global_get(self.abort);
        self.e.code.i64_const(0);
        self.e.code.op(OP_I64_NE);
        self.e.code.open(OP_IF);
        self.e.code.i64_const(0);
        self.e.code.op(OP_RETURN);
        self.e.code.op(OP_END);
        self.e.code.get(frame);
        self.e.code.get(body_result);
        self.e.code.call(hfns.ret);
        self.e.code.op(OP_END);
        self.e.code.set(out);
        self.abort_check();
        out
    }

    // `resume_call` of a tail-resumptive clause: the resumed value is the
    // clause's result (a stateful handler also takes the new state).
    fn resume_call(inout self, dest_val: u64, args_at: u64) eff [Fail[WErr]] {
        let handler_id = self.e.clause_handler;
        if handler_id == NONE64 {
            Fail::raise(werr(K_INVALID, 0, 255));
        }
        let frame = self.e.frame;
        if frame == NONE32 {
            Fail::raise(werr(K_INVALID, 0, 256));
        }
        let stateful = self.plan.handler(handler_id).state != NONE32;
        let n = self.cx.ir.word(args_at);
        if n == 0 {
            Fail::raise(werr(K_INVALID, 0, 257));
        }
        let resumed = self.value(self.cx.ir.word(add(args_at, 2)));
        if stateful {
            if n < 2 {
                Fail::raise(werr(K_INVALID, 0, 258));
            }
            let state = self.value(self.cx.ir.word(add(args_at, 6)));
            self.store(frame, F_STATE, state);
        }
        self.set_value(dest_val, resumed);
    }

    // ----- operations ------------------------------------------------------

    fn perform(
        inout self,
        ename: u32,
        opname: u32,
        in instance: ChunkSeq[u32],
        label: u32,
        in args: ChunkSeq[u32]
    ) -> u32 eff [Fail[WErr]] {
        let result = self.perform_unchecked(ename, opname, in instance, label, in args);
        self.abort_check();
        result
    }

    // `type_mentions(t, generics)`.
    fn type_mentions(in self, t: u32) -> bool {
        let node = self.cx.types.node(t);
        if node.kind == TyKind::Named {
            if contains32(in self.e.generics, node.name) {
                return true;
            }
        } else if node.kind != TyKind::Tuple {
            return false;
        }
        for i in 0..w(node.n) {
            if self.type_mentions(self.cx.types.arg(t, i)) {
                return true;
            }
        }
        false
    }

    // `perform_unchecked` with no evidence keys installed: no frame, so
    // the operation traps.
    fn perform_unchecked(
        inout self,
        ename: u32,
        opname: u32,
        in instance: ChunkSeq[u32],
        label: u32,
        in args: ChunkSeq[u32]
    ) -> u32 eff [Fail[WErr]] {
        let decl_id = self.cx.f.decl_of(ename);
        if decl_id == 0 {
            Fail::raise(werr(K_INVALID, 0, 240));
        }
        let decl = self.cx.f.decl(wrapping_sub(decl_id, 1));
        let mut index = NONE64;
        for o in 0..decl.on {
            if self.cx.f.op(add(decl.o0, o)).name == opname {
                index = o;
                break;
            }
        }
        if index == NONE64 {
            Fail::raise(werr(K_INVALID, 0, 241));
        }
        if args.len() > self.arity {
            Fail::raise(werr(K_INVALID, 0, 242));
        }
        let frame = self.local();
        if label != NONE32 {
            if !self.plan.has_label(self.e.inst, label) {
                Fail::raise(werr(K_UNSUPPORTED, U_LABELLED_EFFECT_ROW, 243));
            }
            let key = prefixed_key(inout self.cx, true, label);
            let env_g = self.env_global(key);
            if env_g == NONE32 {
                Fail::raise(werr(K_INVALID, 0, 244));
            }
            self.e.code.global_get(env_g);
            self.e.code.set(frame);
        } else {
            for i in 0..instance.len() {
                if self.type_mentions(u32_at(in instance, i)) {
                    Fail::raise(werr(K_UNSUPPORTED, U_GENERIC_EFFECT_INSTANCE, 245));
                }
            }
            let exact_key = instance_key(inout self.cx, ename, in instance);
            let exact = self.env_global(exact_key);
            let name_key = prefixed_key(inout self.cx, false, ename);
            let by_name = self.env_global(name_key);
            if exact != NONE32 && by_name != NONE32 {
                self.e.code.global_get(exact);
                self.e.code.tee(frame);
                self.e.code.op(OP_I64_EQZ);
                self.e.code.open(OP_IF);
                self.e.code.global_get(by_name);
                self.e.code.set(frame);
                self.e.code.op(OP_END);
            } else if exact != NONE32 || by_name != NONE32 {
                let env_g = if exact != NONE32 { exact } else { by_name };
                self.e.code.global_get(env_g);
                self.e.code.set(frame);
            } else {
                self.e.code.i64_const(0);
                self.e.code.set(frame);
            }
        }
        self.e.code.get(frame);
        self.e.code.op(OP_I64_EQZ);
        self.e.code.open(OP_IF);
        self.e.code.op(OP_UNREACHABLE);
        self.e.code.op(OP_END);
        self.e.code.get(frame);
        self.e.code.u64_const(index);
        for j in 0..self.arity {
            if j < args.len() {
                self.e.code.get(u32_at(in args, j));
            } else {
                self.e.code.i64_const(0);
            }
        }
        let result = self.local();
        self.load(frame, 0);
        self.e.code.op(OP_I32_WRAP_I64);
        self.e.code.call_indirect(self.dispatch_ty);
        self.e.code.set(result);
        result
    }

    fn raise_overflow(inout self) eff [Fail[WErr]] {
        let err_val = self.local();
        self.e.code.i64_const(0);
        self.e.code.set(err_val);
        let overflow_sym = self.cx.s.overflow;
        let err_ty = self.cx.types.named0(overflow_sym);
        let mut inst = ChunkSeq::new[u32]();
        inst.push(err_ty);
        let mut args = ChunkSeq::new[u32]();
        args.push(err_val);
        let fail = self.cx.s.fail;
        let raise = self.cx.s.raise;
        let raised = self.perform(fail, raise, in inst, NONE32, in args);
        self.e.code.op(OP_UNREACHABLE);
    }

    pub fn raise_runtime_error(inout self, variant: u32) eff [Fail[WErr]] {
        let rt_sym = self.cx.s.runtime_error;
        let ty = self.cx.types.named0(rt_sym);
        let (index, is_enum, shape) = self.cx.variant_of(ty, variant);
        let err_block = self.alloc_block(8);
        let tag = self.local();
        self.e.code.u64_const(index);
        self.e.code.set(tag);
        self.store(err_block, 0, tag);
        let mut inst = ChunkSeq::new[u32]();
        inst.push(ty);
        let mut args = ChunkSeq::new[u32]();
        args.push(err_block);
        let fail = self.cx.s.fail;
        let raise = self.cx.s.raise;
        let raised = self.perform(fail, raise, in inst, NONE32, in args);
        self.e.code.op(OP_UNREACHABLE);
    }

    // `binary`: `vesper.arith.checked/1` binary operators.
    pub fn binary(
        inout self,
        op_sym: u32,
        lhs: u32,
        rhs: u32,
        lhs_scalar: u8,
        rhs_scalar: u8
    ) -> u32 eff [Fail[WErr]] {
        let result = self.local();
        if lhs_scalar == SC_F64 || rhs_scalar == SC_F64 {
            if self.is_op(op_sym, "%") {
                let fmod_idx = self.fmod();
                self.e.code.get(lhs);
                self.e.code.get(rhs);
                self.e.code.call(fmod_idx);
                self.e.code.set(result);
                return result;
            }
            let mut wasm_op: u8 = 0;
            let mut cmp = false;
            if self.is_op(op_sym, "+") {
                wasm_op = OP_F64_ADD;
            } else if self.is_op(op_sym, "-") {
                wasm_op = OP_F64_SUB;
            } else if self.is_op(op_sym, "*") {
                wasm_op = OP_F64_MUL;
            } else if self.is_op(op_sym, "/") {
                wasm_op = OP_F64_DIV;
            } else if self.is_op(op_sym, "==") {
                wasm_op = OP_F64_EQ;
                cmp = true;
            } else if self.is_op(op_sym, "!=") {
                wasm_op = OP_F64_NE;
                cmp = true;
            } else if self.is_op(op_sym, "<") {
                wasm_op = OP_F64_LT;
                cmp = true;
            } else if self.is_op(op_sym, "<=") {
                wasm_op = OP_F64_LE;
                cmp = true;
            } else if self.is_op(op_sym, ">") {
                wasm_op = OP_F64_GT;
                cmp = true;
            } else if self.is_op(op_sym, ">=") {
                wasm_op = OP_F64_GE;
                cmp = true;
            } else {
                Fail::raise(werr(K_UNSUPPORTED, U_OPERATION, 250));
            }
            self.e.code.get(lhs);
            self.e.code.op(OP_F64_REINTERPRET_I64);
            self.e.code.get(rhs);
            self.e.code.op(OP_F64_REINTERPRET_I64);
            self.e.code.op(wasm_op);
            if cmp {
                self.e.code.op(OP_I64_EXTEND_I32_U);
            } else {
                self.e.code.op(OP_I64_REINTERPRET_F64);
            }
            self.e.code.set(result);
            return result;
        }
        if lhs_scalar == SC_BOOL || lhs_scalar == SC_UNIT {
            let wasm_op = if self.is_op(op_sym, "==") {
                OP_I64_EQ
            } else if self.is_op(op_sym, "!=") {
                OP_I64_NE
            } else {
                Fail::raise(werr(K_UNSUPPORTED, U_OPERATION, 251));
                0
            };
            self.e.code.get(lhs);
            self.e.code.get(rhs);
            self.e.code.op(wasm_op);
            self.e.code.op(OP_I64_EXTEND_I32_U);
            self.e.code.set(result);
            return result;
        }
        if !is_int(lhs_scalar) || !is_int(rhs_scalar) {
            Fail::raise(werr(K_UNSUPPORTED, U_OPERATION, 252));
        }
        let kind = if ik_unsigned(lhs_scalar) {
            lhs_scalar
        } else {
            rhs_scalar
        };
        let signed = ik_signed(kind);
        if self.is_op(op_sym, "==") {
            self.cmp(lhs, rhs, OP_I64_EQ);
        } else if self.is_op(op_sym, "!=") {
            self.cmp(lhs, rhs, OP_I64_NE);
        } else if self.is_op(op_sym, "<") {
            self.cmp(lhs, rhs, if signed { OP_I64_LT_S } else { OP_I64_LT_U });
        } else if self.is_op(op_sym, "<=") {
            self.cmp(lhs, rhs, if signed { OP_I64_LE_S } else { OP_I64_LE_U });
        } else if self.is_op(op_sym, ">") {
            self.cmp(lhs, rhs, if signed { OP_I64_GT_S } else { OP_I64_GT_U });
        } else if self.is_op(op_sym, ">=") {
            self.cmp(lhs, rhs, if signed { OP_I64_GE_S } else { OP_I64_GE_U });
        } else if self.is_op(op_sym, "wrapping_add")
            || self.is_op(op_sym, "wrapping_sub")
            || self.is_op(op_sym, "wrapping_mul") {
            let wasm_op = if self.is_op(op_sym, "wrapping_add") {
                OP_I64_ADD
            } else if self.is_op(op_sym, "wrapping_sub") {
                OP_I64_SUB
            } else {
                OP_I64_MUL
            };
            self.e.code.get(lhs);
            self.e.code.get(rhs);
            self.e.code.op(wasm_op);
            if kind == SC_U8 || kind == SC_U16 || kind == SC_U32 {
                self.e.code.u64_const(ik_mask(kind));
                self.e.code.op(OP_I64_AND);
            } else if kind == SC_I8 || kind == SC_I16 || kind == SC_I32 {
                let shift = wrapping_sub(64, ik_bits(kind));
                self.e.code.u64_const(shift);
                self.e.code.op(OP_I64_SHL);
                self.e.code.u64_const(shift);
                self.e.code.op(OP_I64_SHR_S);
            }
        } else if self.is_op(op_sym, "+") || self.is_op(op_sym, "-") || self.is_op(op_sym, "*") {
            self.overflow_check(op_sym, kind, lhs, rhs);
            let wasm_op = if self.is_op(op_sym, "+") {
                OP_I64_ADD
            } else if self.is_op(op_sym, "-") {
                OP_I64_SUB
            } else {
                OP_I64_MUL
            };
            self.e.code.get(lhs);
            self.e.code.get(rhs);
            self.e.code.op(wasm_op);
        } else if self.is_op(op_sym, "/") || self.is_op(op_sym, "%") {
            let div = self.is_op(op_sym, "/");
            self.e.code.get(rhs);
            self.e.code.op(OP_I64_EQZ);
            self.e.code.open(OP_IF);
            let div_zero = self.cx.s.div_zero;
            self.raise_runtime_error(div_zero);
            self.e.code.op(OP_END);
            if signed && div {
                self.e.code.get(lhs);
                self.e.code.i64_const(ik_min(kind));
                self.e.code.op(OP_I64_EQ);
                self.e.code.get(rhs);
                self.e.code.i64_const(-1);
                self.e.code.op(OP_I64_EQ);
                self.e.code.op(OP_I32_AND);
                self.e.code.open(OP_IF);
                self.raise_overflow();
                self.e.code.op(OP_END);
            }
            self.e.code.get(lhs);
            self.e.code.get(rhs);
            if signed && !div {
                self.e.code.op(OP_I64_REM_S);
            } else if div && signed {
                self.e.code.op(OP_I64_DIV_S);
            } else if div {
                self.e.code.op(OP_I64_DIV_U);
            } else {
                self.e.code.op(OP_I64_REM_U);
            }
        } else if self.is_op(op_sym, "&") || self.is_op(op_sym, "|") || self.is_op(op_sym, "^") {
            let wasm_op = if self.is_op(op_sym, "&") {
                OP_I64_AND
            } else if self.is_op(op_sym, "|") {
                OP_I64_OR
            } else {
                OP_I64_XOR
            };
            self.e.code.get(lhs);
            self.e.code.get(rhs);
            self.e.code.op(wasm_op);
        } else if self.is_op(op_sym, "<<") || self.is_op(op_sym, ">>") {
            // The amount must be in 0..bits of the left operand's kind (a
            // negative amount compares as a huge unsigned one), else
            // Fail[ArithOverflow]; `<<` drops the bits shifted out.
            let bits = ik_bits(lhs_scalar);
            self.e.code.get(rhs);
            self.e.code.u64_const(bits);
            self.e.code.op(OP_I64_GE_U);
            self.e.code.open(OP_IF);
            self.raise_overflow();
            self.e.code.op(OP_END);
            self.e.code.get(lhs);
            self.e.code.get(rhs);
            if self.is_op(op_sym, "<<") {
                self.e.code.op(OP_I64_SHL);
                if lhs_scalar == SC_U8 || lhs_scalar == SC_U16 || lhs_scalar == SC_U32 {
                    self.e.code.u64_const(ik_mask(lhs_scalar));
                    self.e.code.op(OP_I64_AND);
                } else if lhs_scalar == SC_I8 || lhs_scalar == SC_I16 || lhs_scalar == SC_I32 {
                    let shift = wrapping_sub(64, bits);
                    self.e.code.u64_const(shift);
                    self.e.code.op(OP_I64_SHL);
                    self.e.code.u64_const(shift);
                    self.e.code.op(OP_I64_SHR_S);
                }
            } else if ik_signed(lhs_scalar) {
                self.e.code.op(OP_I64_SHR_S);
            } else {
                self.e.code.op(OP_I64_SHR_U);
            }
        } else if self.is_op(op_sym, "rotate_left") || self.is_op(op_sym, "rotate_right") {
            let left = self.is_op(op_sym, "rotate_left");
            if lhs_scalar != SC_U64 && lhs_scalar != SC_I64 {
                let bits = ik_bits(lhs_scalar);
                let low = wrapping_sub(bits, 1);
                let mask = wrapping_shr_u64(NONE64, wrapping_u32(wrapping_sub(64, bits)));
                let amount = self.local();
                let masked = self.local();
                self.e.code.get(rhs);
                self.e.code.u64_const(low);
                self.e.code.op(OP_I64_AND);
                self.e.code.set(amount);
                self.e.code.get(lhs);
                self.e.code.u64_const(mask);
                self.e.code.op(OP_I64_AND);
                self.e.code.set(masked);
                self.e.code.get(masked);
                self.e.code.get(amount);
                self.e.code.op(if left { OP_I64_SHL } else { OP_I64_SHR_U });
                self.e.code.get(masked);
                self.e.code.u64_const(bits);
                self.e.code.get(amount);
                self.e.code.op(OP_I64_SUB);
                self.e.code.op(if left { OP_I64_SHR_U } else { OP_I64_SHL });
                self.e.code.op(OP_I64_OR);
                if ik_unsigned(lhs_scalar) {
                    self.e.code.u64_const(mask);
                    self.e.code.op(OP_I64_AND);
                } else {
                    let shift = wrapping_sub(64, bits);
                    self.e.code.u64_const(shift);
                    self.e.code.op(OP_I64_SHL);
                    self.e.code.u64_const(shift);
                    self.e.code.op(OP_I64_SHR_S);
                }
            } else {
                self.e.code.get(lhs);
                self.e.code.get(rhs);
                self.e.code.op(if left { OP_I64_ROTL } else { OP_I64_ROTR });
            }
        } else {
            Fail::raise(werr(K_UNSUPPORTED, U_OPERATION, 253));
        }
        self.e.code.set(result);
        result
    }

    fn cmp(inout self, lhs: u32, rhs: u32, wasm_op: u8) {
        self.e.code.get(lhs);
        self.e.code.get(rhs);
        self.e.code.op(wasm_op);
        self.e.code.op(OP_I64_EXTEND_I32_U);
    }

    fn overflow_check(inout self, op_sym: u32, kind: u8, lhs: u32, rhs: u32) eff [Fail[WErr]] {
        let add_ = self.is_op(op_sym, "+");
        let sub_ = self.is_op(op_sym, "-");
        let mul_ = self.is_op(op_sym, "*");
        if (add_ || mul_) && (kind == SC_U8 || kind == SC_U16 || kind == SC_U32) {
            self.e.code.get(lhs);
            self.e.code.get(rhs);
            self.e.code.op(if add_ { OP_I64_ADD } else { OP_I64_MUL });
            self.e.code.u64_const(ik_mask(kind));
            self.e.code.op(OP_I64_GT_U);
        } else if (add_ || sub_ || mul_) && (kind == SC_I8 || kind == SC_I16 || kind == SC_I32) {
            let wide_result = self.local();
            self.e.code.get(lhs);
            self.e.code.get(rhs);
            self.e.code.op(
                if add_ {
                    OP_I64_ADD
                } else if sub_ {
                    OP_I64_SUB
                } else {
                    OP_I64_MUL
                }
            );
            self.e.code.tee(wide_result);
            self.e.code.i64_const(ik_min(kind));
            self.e.code.op(OP_I64_LT_S);
            self.e.code.get(wide_result);
            self.e.code.i64_const(ik_max(kind));
            self.e.code.op(OP_I64_GT_S);
            self.e.code.op(OP_I32_OR);
        } else if sub_ && ik_unsigned(kind) {
            self.e.code.get(lhs);
            self.e.code.get(rhs);
            self.e.code.op(OP_I64_LT_U);
        } else if add_ && kind == SC_U64 {
            self.e.code.get(lhs);
            self.e.code.get(rhs);
            self.e.code.op(OP_I64_ADD);
            self.e.code.get(lhs);
            self.e.code.op(OP_I64_LT_U);
        } else if mul_ && kind == SC_U64 {
            self.e.code.get(lhs);
            self.e.code.op(OP_I64_EQZ);
            self.e.code.open_result(OP_IF, vt(VT_I32));
            self.e.code.i32_const(0);
            self.e.code.op(OP_ELSE);
            self.e.code.get(lhs);
            self.e.code.get(rhs);
            self.e.code.op(OP_I64_MUL);
            self.e.code.get(lhs);
            self.e.code.op(OP_I64_DIV_U);
            self.e.code.get(rhs);
            self.e.code.op(OP_I64_NE);
            self.e.code.op(OP_END);
        } else if (add_ || sub_) && kind == SC_I64 {
            let wide_result = self.local();
            self.e.code.get(lhs);
            self.e.code.get(rhs);
            self.e.code.op(if add_ { OP_I64_ADD } else { OP_I64_SUB });
            self.e.code.set(wide_result);
            self.e.code.get(lhs);
            self.e.code.get(wide_result);
            self.e.code.op(OP_I64_XOR);
            if add_ {
                self.e.code.get(rhs);
                self.e.code.get(wide_result);
            } else {
                self.e.code.get(lhs);
                self.e.code.get(rhs);
            }
            self.e.code.op(OP_I64_XOR);
            self.e.code.op(OP_I64_AND);
            self.e.code.i64_const(0);
            self.e.code.op(OP_I64_LT_S);
        } else if mul_ && kind == SC_I64 {
            self.e.code.get(lhs);
            self.e.code.i64_const(-1);
            self.e.code.op(OP_I64_EQ);
            self.e.code.open_result(OP_IF, vt(VT_I32));
            self.e.code.get(rhs);
            self.e.code.i64_const(I64_MIN);
            self.e.code.op(OP_I64_EQ);
            self.e.code.op(OP_ELSE);
            self.e.code.get(lhs);
            self.e.code.op(OP_I64_EQZ);
            self.e.code.open_result(OP_IF, vt(VT_I32));
            self.e.code.i32_const(0);
            self.e.code.op(OP_ELSE);
            self.e.code.get(lhs);
            self.e.code.get(rhs);
            self.e.code.op(OP_I64_MUL);
            self.e.code.get(lhs);
            self.e.code.op(OP_I64_DIV_S);
            self.e.code.get(rhs);
            self.e.code.op(OP_I64_NE);
            self.e.code.op(OP_END);
            self.e.code.op(OP_END);
        } else {
            Fail::raise(werr(K_INVALID, 0, 254));
        }
        self.e.code.open(OP_IF);
        self.raise_overflow();
        self.e.code.op(OP_END);
    }

    // ----- sequences, slices and strings (#1506) ---------------------------
    //
    // A `ChunkSeq[T]` or a `String` is a pointer to a buffer: one word
    // `len | cap << 32`, then the elements, one byte each for `u8` and for a
    // string and eight bytes otherwise. A string literal is a static buffer
    // with cap 0 (Rust's layout), so the first write copies it. A `Slice[T]`
    // or `Str` view is `addr | len << 32`. A buffer has one owner (a
    // `ChunkSeq` moves), so writes happen in place; a buffer that grows
    // moves, and its new address is written back to the receiver's place.
    // Rust (src/wasm_backend) lowers no `Op::Seq`.

    fn seq_code(in self, pool: u64) -> u8 {
        let label = self.cx.ir.p.pool_row(pool).label;
        if self.cx.names.spells(label, in "New".as_bytes()) {
            return 1;
        }
        if self.cx.names.spells(label, in "WithCapacity".as_bytes()) {
            return 2;
        }
        if self.cx.names.spells(label, in "Resize".as_bytes()) {
            return 35;
        }
        if self.cx.names.spells(label, in "FindByte".as_bytes()) {
            return 36;
        }
        if self.cx.names.spells(label, in "FindEither".as_bytes()) {
            return 37;
        }
        if self.cx.names.spells(label, in "FindNotIn".as_bytes()) {
            return 38;
        }
        if self.cx.names.spells(label, in "Len".as_bytes()) {
            return 3;
        }
        if self.cx.names.spells(label, in "Push".as_bytes()) {
            return 4;
        }
        if self.cx.names.spells(label, in "Pop".as_bytes()) {
            return 5;
        }
        if self.cx.names.spells(label, in "Get".as_bytes()) {
            return 6;
        }
        if self.cx.names.spells(label, in "Set".as_bytes()) {
            return 7;
        }
        if self.cx.names.spells(label, in "TryGet".as_bytes()) {
            return 8;
        }
        if self.cx.names.spells(label, in "Last".as_bytes()) {
            return 9;
        }
        if self.cx.names.spells(label, in "TrySet".as_bytes()) {
            return 10;
        }
        if self.cx.names.spells(label, in "Clear".as_bytes()) {
            return 11;
        }
        if self.cx.names.spells(label, in "Truncate".as_bytes()) {
            return 12;
        }
        if self.cx.names.spells(label, in "Reserve".as_bytes()) {
            return 13;
        }
        if self.cx.names.spells(label, in "Extend".as_bytes()) {
            return 14;
        }
        if self.cx.names.spells(label, in "Finish".as_bytes()) {
            return 15;
        }
        if self.cx.names.spells(label, in "AsSlice".as_bytes()) {
            return 16;
        }
        if self.cx.names.spells(label, in "SubSlice".as_bytes()) {
            return 17;
        }
        if self.cx.names.spells(label, in "SliceLen".as_bytes()) {
            return 18;
        }
        if self.cx.names.spells(label, in "SliceGet".as_bytes()) {
            return 19;
        }
        if self.cx.names.spells(label, in "SliceSet".as_bytes()) {
            return 20;
        }
        if self.cx.names.spells(label, in "Swap".as_bytes()) {
            return 21;
        }
        if self.cx.names.spells(label, in "Replace".as_bytes()) {
            return 22;
        }
        if self.cx.names.spells(label, in "BytesEq".as_bytes()) {
            return 23;
        }
        if self.cx.names.spells(label, in "Fill".as_bytes()) {
            return 24;
        }
        if self.cx.names.spells(label, in "Str(Len)".as_bytes()) {
            return 25;
        }
        if self.cx.names.spells(label, in "Str(ByteAt)".as_bytes()) {
            return 26;
        }
        if self.cx.names.spells(label, in "Str(TryByteAt)".as_bytes()) {
            return 27;
        }
        if self.cx.names.spells(label, in "Str(AsStr)".as_bytes()) {
            return 28;
        }
        if self.cx.names.spells(label, in "Str(AsBytes)".as_bytes()) {
            return 29;
        }
        if self.cx.names.spells(label, in "Str(SubStr)".as_bytes()) {
            return 30;
        }
        if self.cx.names.spells(label, in "Str(PushStr)".as_bytes()) {
            return 31;
        }
        if self.cx.names.spells(label, in "Str(PushChar)".as_bytes()) {
            return 32;
        }
        if self.cx.names.spells(label, in "Str(Clear)".as_bytes()) {
            return 33;
        }
        if self.cx.names.spells(label, in "Str(Reserve)".as_bytes()) {
            return 34;
        }
        if self.cx.names.spells(label, in "FillRange { total: false }".as_bytes()) {
            return wrapping_u8(SQ_FILL_RANGE);
        }
        if self.cx.names.spells(label, in "FillRange { total: true }".as_bytes()) {
            return wrapping_u8(SQ_TRY_FILL);
        }
        for k in 0..24 {
            let mut spelled = ChunkSeq::new[u8]();
            append_text(inout spelled, "Wide(Wide { bytes: ");
            let bytes = wide_bytes(k);
            spelled.push(wrapping_add(48, wrapping_u8(bytes)));
            append_text(inout spelled, ", big: ");
            append_bool(inout spelled, (k & 4) != 0);
            append_text(inout spelled, ", write: ");
            append_bool(inout spelled, (k & 2) != 0);
            append_text(inout spelled, ", total: ");
            append_bool(inout spelled, (k & 1) != 0);
            append_text(inout spelled, " })");
            if self.cx.names.spells(label, in spelled.as_slice()) {
                return wrapping_u8(add(SQ_WIDE, k));
            }
        }
        0
    }

    // SK_BUF for `ChunkSeq` and `String`, SK_VIEW for `Slice` and `Str`.
    fn seq_kind(inout self, t: u32) -> u8 {
        let resolved = self.cx.default_ty(t);
        let node = self.cx.types.node(resolved);
        if node.kind != TyKind::Named {
            return SK_OTHER;
        }
        let syms = self.cx.s;
        if node.name == syms.string || node.name == syms.chunkseq {
            return SK_BUF;
        }
        if node.name == syms.str_ || node.name == syms.slice {
            return SK_VIEW;
        }
        SK_OTHER
    }

    // The element width in bytes of a sequence, slice or string type.
    fn stride(inout self, t: u32) -> u64 eff [Fail[WErr]] {
        let resolved = self.cx.default_ty(t);
        let node = self.cx.types.node(resolved);
        let syms = self.cx.s;
        if node.name == syms.string || node.name == syms.str_ {
            return 1;
        }
        if node.n == 0 {
            Fail::raise(werr(K_INVALID, 0, 230));
        }
        let elem_ty = self.cx.types.arg(resolved, 0);
        let shape = self.cx.shape(elem_ty);
        if shape.kind == SH_SCALAR && shape.scalar == SC_U8 {
            1
        } else {
            8
        }
    }

    // The words of Seq argument `k` at `ops[q0]`: its ops index.
    fn seq_arg(in self, a: u64, k: u64) -> u64 {
        add(add(a, 2), wrapping_mul(k, 4))
    }

    fn seq_val(in self, a: u64, k: u64) -> u32 eff [Fail[WErr]] {
        self.value(self.cx.ir.word(inc(self.seq_arg(a, k))))
    }

    fn seq_ty(inout self, a: u64, k: u64) -> u32 {
        self.vty(self.cx.ir.word(inc(self.seq_arg(a, k))))
    }

    // (address, length) of buffer or view `buf` of type `buf_ty`.
    fn parts(inout self, buf: u32, buf_ty: u32) -> (u32, u32) eff [Fail[WErr]] {
        let kind = self.seq_kind(buf_ty);
        let addr = self.local();
        let n = self.local();
        if kind == SK_BUF {
            self.e.code.get(buf);
            self.e.code.i64_const(8);
            self.e.code.op(OP_I64_ADD);
            self.e.code.set(addr);
            self.load(buf, 0);
            self.e.code.u64_const(LOW32);
            self.e.code.op(OP_I64_AND);
            self.e.code.set(n);
        } else if kind == SK_VIEW {
            self.e.code.get(buf);
            self.e.code.u64_const(LOW32);
            self.e.code.op(OP_I64_AND);
            self.e.code.set(addr);
            self.e.code.get(buf);
            self.e.code.i64_const(32);
            self.e.code.op(OP_I64_SHR_U);
            self.e.code.set(n);
        } else {
            Fail::raise(werr(K_UNSUPPORTED, U_OPERATION, 231));
        }
        (addr, n)
    }

    // The view `a | n << 32`.
    fn pack(inout self, a: u32, n: u32) -> u32 {
        let d = self.local();
        self.e.code.get(a);
        self.e.code.get(n);
        self.e.code.i64_const(32);
        self.e.code.op(OP_I64_SHL);
        self.e.code.op(OP_I64_OR);
        self.e.code.set(d);
        d
    }

    // Push the i32 address `a + i * stride`.
    fn elem_addr(inout self, a: u32, i: u32, stride: u64) {
        self.e.code.get(a);
        self.e.code.get(i);
        if stride == 8 {
            self.e.code.i64_const(3);
            self.e.code.op(OP_I64_SHL);
        }
        self.e.code.op(OP_I64_ADD);
        self.e.code.op(OP_I32_WRAP_I64);
    }

    fn elem_load(inout self, a: u32, i: u32, stride: u64) -> u32 {
        let d = self.local();
        self.elem_addr(a, i, stride);
        if stride == 1 {
            self.e.code.mem(OP_I64_LOAD8_U, 0, 0);
        } else {
            self.e.code.load(0);
        }
        self.e.code.set(d);
        d
    }

    fn elem_store(inout self, a: u32, i: u32, stride: u64, v: u32) {
        self.elem_addr(a, i, stride);
        self.e.code.get(v);
        if stride == 1 {
            self.e.code.mem(OP_I64_STORE8, 0, 0);
        } else {
            self.e.code.store(0);
        }
    }

    // Store v into each element of [lo, hi). The caller checks the bounds.
    fn fill_elems(inout self, base: u32, lo: u32, hi: u32, stride: u64, v: u32) {
        let i = self.local();
        self.e.code.get(lo);
        self.e.code.set(i);
        self.e.code.open(OP_BLOCK);
        self.e.code.open(OP_LOOP);
        self.e.code.get(i);
        self.e.code.get(hi);
        self.e.code.op(OP_I64_GE_U);
        self.e.code.br_if(1);
        self.elem_store(base, i, stride, v);
        self.e.code.get(i);
        self.e.code.i64_const(1);
        self.e.code.op(OP_I64_ADD);
        self.e.code.set(i);
        self.e.code.br(0);
        self.e.code.op(OP_END);
        self.e.code.op(OP_END);
    }

    // Raise `IndexOutOfBounds` unless `i < n`.
    fn check_index(inout self, i: u32, n: u32) eff [Fail[WErr]] {
        self.e.code.get(i);
        self.e.code.get(n);
        self.e.code.op(OP_I64_GE_U);
        self.e.code.open(OP_IF);
        let oob = self.cx.s.index_oob;
        self.raise_runtime_error(oob);
        self.e.code.op(OP_END);
    }

    // Trap (a view fault) unless `lo <= hi <= n`.
    fn check_interval(inout self, lo: u32, hi: u32, n: u32) {
        self.e.code.get(lo);
        self.e.code.get(hi);
        self.e.code.op(OP_I64_GT_U);
        self.e.code.get(hi);
        self.e.code.get(n);
        self.e.code.op(OP_I64_GT_U);
        self.e.code.op(OP_I32_OR);
        self.e.code.open(OP_IF);
        self.e.code.op(OP_UNREACHABLE);
        self.e.code.op(OP_END);
    }

    // An `Option[T]` (type `ty`) into `dst`: `Some(v)`, or `None` when `v`
    // is NONE32.
    fn option_into(inout self, dst: u32, ty: u32, v: u32) eff [Fail[WErr]] {
        let syms = self.cx.s;
        let name = if v == NONE32 { syms.none } else { syms.some };
        let (index, is_enum, shape) = self.cx.variant_of(ty, name);
        let block = self.alloc_block(if v == NONE32 { 8 } else { 16 });
        let tag = self.local();
        self.e.code.u64_const(index);
        self.e.code.set(tag);
        self.store(block, 0, tag);
        if v != NONE32 {
            self.store(block, 8, v);
        }
        self.e.code.get(block);
        self.e.code.set(dst);
    }

    // Write `val` to the place of Seq argument `k` (an element view, or the
    // receiver's root and path).
    fn write_arg(inout self, a: u64, k: u64, val: u32) eff [Fail[WErr]] {
        let arg_at = self.seq_arg(a, k);
        let vid = self.cx.ir.word(inc(arg_at));
        let elem_entry = u64_at(in self.e.elems, vid);
        if elem_entry != 0 {
            let addr = wrapping_u32(wrapping_sub(elem_entry, 1) & LOW32);
            let stride = wrapping_shr_u64(wrapping_sub(elem_entry, 1), 32);
            let zero = self.local();
            self.e.code.i64_const(0);
            self.e.code.set(zero);
            self.elem_store(addr, zero, stride, val);
            return;
        }
        let root = self.cx.ir.word(add(arg_at, 2));
        if root == 0 {
            Fail::raise(werr(K_INVALID, 0, 232));
        }
        let segs = self.path_names(self.cx.ir.word(add(arg_at, 3)));
        self.write_place(n32(wrapping_sub(root, 1)), in segs, val);
    }

    // The receiver buffer `buf` (Seq argument 0) with room for `need`
    // elements, a copy of it when it is static or too small; a copy is
    // written back to the receiver's place.
    fn room(inout self, a: u64, buf: u32, need: u32, stride: u64) -> u32 eff [Fail[WErr]] {
        let reserve_fn = self.seq_reserve();
        let grown = self.local();
        self.e.code.get(buf);
        self.e.code.get(need);
        self.e.code.u64_const(stride);
        self.e.code.call(reserve_fn);
        self.e.code.set(grown);
        self.e.code.get(grown);
        self.e.code.get(buf);
        self.e.code.op(OP_I64_NE);
        self.e.code.open(OP_IF);
        self.write_arg(a, 0, grown);
        self.e.code.op(OP_END);
        grown
    }

    // Add `delta` to the length of buffer `buf` (its capacity has room).
    fn bump_len(inout self, buf: u32, delta: u32) {
        self.e.code.get(buf);
        self.e.code.op(OP_I32_WRAP_I64);
        self.load(buf, 0);
        self.e.code.get(delta);
        self.e.code.op(OP_I64_ADD);
        self.e.code.store(0);
    }

    // Set the length of buffer `buf` to `n`, keeping its capacity.
    fn set_len(inout self, buf: u32, n: u32) {
        self.e.code.get(buf);
        self.e.code.op(OP_I32_WRAP_I64);
        self.load(buf, 0);
        self.e.code.u64_const(HIGH32);
        self.e.code.op(OP_I64_AND);
        self.e.code.get(n);
        self.e.code.op(OP_I64_OR);
        self.e.code.store(0);
    }

    fn add_locals(inout self, lhs: u32, rhs: u32) -> u32 {
        let sum = self.local();
        self.e.code.get(lhs);
        self.e.code.get(rhs);
        self.e.code.op(OP_I64_ADD);
        self.e.code.set(sum);
        sum
    }

    fn const_local(inout self, bits: u64) -> u32 {
        let local_idx = self.local();
        self.e.code.u64_const(bits);
        self.e.code.set(local_idx);
        local_idx
    }

    // Append the `n` elements at `src` to the receiver buffer `buf`.
    fn append_elems(inout self, a: u64, buf: u32, src: u32, n: u32, stride: u64) eff [Fail[WErr]] {
        let buf_ty = self.seq_ty(a, 0);
        let (buf_addr, len) = self.parts(buf, buf_ty);
        let need = self.add_locals(len, n);
        let grown = self.room(a, buf, need, stride);
        let grown_addr = self.local();
        self.e.code.get(grown);
        self.e.code.i64_const(8);
        self.e.code.op(OP_I64_ADD);
        self.e.code.set(grown_addr);
        self.elem_addr(grown_addr, len, stride);
        self.e.code.get(src);
        self.e.code.op(OP_I32_WRAP_I64);
        self.e.code.get(n);
        if stride == 8 {
            self.e.code.i64_const(3);
            self.e.code.op(OP_I64_SHL);
        }
        self.e.code.op(OP_I32_WRAP_I64);
        self.e.code.memory_copy();
        self.bump_len(grown, n);
    }

    fn unit_into(inout self, dest_val: u64) {
        let dest = self.dest(dest_val);
        self.e.code.i64_const(0);
        self.e.code.set(dest);
    }

    // `==` (`!=` when `is_ne`) of byte views or strings, one a view.
    fn view_eq(
        inout self,
        lhs: u32,
        lhs_ty: u32,
        rhs: u32,
        rhs_ty: u32,
        is_ne: bool
    ) -> u32 eff [Fail[WErr]] {
        if self.stride(lhs_ty) != 1 || self.stride(rhs_ty) != 1 {
            Fail::raise(werr(K_UNSUPPORTED, U_GENERIC_OPERATION, 235));
        }
        let (lhs_addr, lhs_len) = self.parts(lhs, lhs_ty);
        let (rhs_addr, rhs_len) = self.parts(rhs, rhs_ty);
        let bytes_eq_idx = self.bytes_eq();
        let result = self.local();
        self.e.code.get(lhs_addr);
        self.e.code.get(lhs_len);
        self.e.code.get(rhs_addr);
        self.e.code.get(rhs_len);
        self.e.code.call(bytes_eq_idx);
        if is_ne {
            self.e.code.op(OP_I64_EQZ);
            self.e.code.op(OP_I64_EXTEND_I32_U);
        }
        self.e.code.set(result);
        result
    }

    fn seq(inout self, at: u64, ty: u32, dest_val: u64) eff [Fail[WErr]] {
        let ins = self.cx.ir.p.inst(at);
        let a = ins.a;
        let code = self.seq_code(self.cx.ir.word(a));
        let seq_op = widen_u64(code);
        if seq_op == 0 {
            Fail::raise(werr(K_UNSUPPORTED, U_OPERATION, 233));
        }
        if seq_op == SQ_NEW || seq_op == SQ_WITH_CAPACITY {
            let stride = self.stride(ty);
            let cap = if seq_op == SQ_NEW {
                self.const_local(0)
            } else {
                self.seq_val(a, 0)
            };
            let dest = self.dest(dest_val);
            self.e.code.get(cap);
            self.e.code.u64_const(stride);
            self.e.code.op(OP_I64_MUL);
            self.e.code.i64_const(8);
            self.e.code.op(OP_I64_ADD);
            self.e.code.call(self.alloc);
            self.e.code.set(dest);
            self.e.code.get(dest);
            self.e.code.op(OP_I32_WRAP_I64);
            self.e.code.get(cap);
            self.e.code.i64_const(32);
            self.e.code.op(OP_I64_SHL);
            self.e.code.store(0);
            return;
        }
        if seq_op == SQ_SWAP || seq_op == SQ_REPLACE {
            let first = self.seq_val(a, 0);
            let second = self.seq_val(a, 1);
            self.write_arg(a, 0, second);
            if seq_op == SQ_SWAP {
                self.write_arg(a, 1, first);
                self.unit_into(dest_val);
            } else {
                self.set_value(dest_val, first);
            }
            return;
        }
        let recv_ty = self.seq_ty(a, 0);
        let recv = self.seq_val(a, 0);
        let recv_dty = self.cx.default_ty(recv_ty);
        let recv_name = self.cx.types.node(recv_dty).name;
        if seq_op == SQ_SUB_SLICE
            && (recv_name == self.cx.s.string || recv_name == self.cx.s.str_) {
            self.sub_str(a, recv, recv_ty, dest_val);
            return;
        }
        let stride = self.stride(recv_ty);
        if seq_op >= SQ_WIDE {
            self.wide(a, wrapping_sub(seq_op, SQ_WIDE), recv, recv_ty, ty, dest_val);
            return;
        }
        let (base, n) = self.parts(recv, recv_ty);
        if seq_op >= 36 && seq_op <= 38 {
            self.find_scan(a, seq_op, base, n, recv_ty, ty, dest_val);
        } else if seq_op == SQ_LEN || seq_op == SQ_SLICE_LEN || seq_op == SQ_STR_LEN {
            self.set_value(dest_val, n);
        } else if seq_op == SQ_PUSH {
            let val = self.seq_val(a, 1);
            let one = self.const_local(1);
            let need = self.add_locals(n, one);
            let grown = self.room(a, recv, need, stride);
            let grown_addr = self.local();
            self.e.code.get(grown);
            self.e.code.i64_const(8);
            self.e.code.op(OP_I64_ADD);
            self.e.code.set(grown_addr);
            self.elem_store(grown_addr, n, stride, val);
            self.bump_len(grown, one);
            self.unit_into(dest_val);
        } else if seq_op == SQ_POP || seq_op == SQ_LAST {
            let dest = self.dest(dest_val);
            self.e.code.get(n);
            self.e.code.op(OP_I64_EQZ);
            self.e.code.open(OP_IF);
            self.option_into(dest, ty, NONE32);
            self.e.code.op(OP_ELSE);
            let last = self.local();
            self.e.code.get(n);
            self.e.code.i64_const(1);
            self.e.code.op(OP_I64_SUB);
            self.e.code.set(last);
            let val = self.elem_load(base, last, stride);
            if seq_op == SQ_POP {
                self.set_len(recv, last);
            }
            self.option_into(dest, ty, val);
            self.e.code.op(OP_END);
        } else if seq_op == SQ_GET || seq_op == SQ_SLICE_GET || seq_op == SQ_STR_BYTE_AT {
            let index = self.seq_val(a, 1);
            self.check_index(index, n);
            let val = self.elem_load(base, index, stride);
            // An element view (`swap(inout s[i], ..)`) writes here.
            let addr = self.local();
            self.elem_addr(base, index, stride);
            self.e.code.op(OP_I64_EXTEND_I32_U);
            self.e.code.set(addr);
            set64(
                inout self.e.elems,
                wrapping_u32(dest_val),
                inc(widen_u64(addr) | wrapping_shl_u64(stride, 32))
            );
            self.set_value(dest_val, val);
        } else if seq_op == SQ_SET || seq_op == SQ_SLICE_SET {
            let index = self.seq_val(a, 1);
            let val = self.seq_val(a, 2);
            self.check_index(index, n);
            self.elem_store(base, index, stride, val);
            self.unit_into(dest_val);
        } else if seq_op == SQ_TRY_GET || seq_op == SQ_STR_TRY_BYTE_AT {
            let index = self.seq_val(a, 1);
            let dest = self.dest(dest_val);
            let view = seq_op == SQ_TRY_GET
                && self.cx.ir.word(self.seq_arg(a, 0)) == widen_u64(TyPass::Inout);
            let addr = if view { self.local() } else { 0 };
            self.e.code.get(index);
            self.e.code.get(n);
            self.e.code.op(OP_I64_LT_U);
            self.e.code.open(OP_IF);
            if view {
                self.elem_addr(base, index, stride);
                self.e.code.op(OP_I64_EXTEND_I32_U);
                self.e.code.set(addr);
                set64(
                    inout self.e.elems,
                    wrapping_u32(dest_val),
                    inc(widen_u64(addr) | wrapping_shl_u64(stride, 32))
                );
            }
            let val = self.elem_load(base, index, stride);
            self.option_into(dest, ty, val);
            self.e.code.op(OP_ELSE);
            self.option_into(dest, ty, NONE32);
            self.e.code.op(OP_END);
        } else if seq_op == SQ_TRY_SET {
            let index = self.seq_val(a, 1);
            let val = self.seq_val(a, 2);
            let dest = self.dest(dest_val);
            self.e.code.get(index);
            self.e.code.get(n);
            self.e.code.op(OP_I64_LT_U);
            self.e.code.open(OP_IF);
            self.elem_store(base, index, stride, val);
            self.e.code.op(OP_END);
            self.e.code.get(index);
            self.e.code.get(n);
            self.e.code.op(OP_I64_LT_U);
            self.e.code.op(OP_I64_EXTEND_I32_U);
            self.e.code.set(dest);
        } else if seq_op == SQ_CLEAR || seq_op == SQ_STR_CLEAR {
            // A static string is copied first, so the literal stays.
            let grown = self.room(a, recv, n, stride);
            let zero = self.const_local(0);
            self.set_len(grown, zero);
            self.unit_into(dest_val);
        } else if seq_op == SQ_TRUNCATE {
            let amount = self.seq_val(a, 1);
            self.e.code.get(amount);
            self.e.code.get(n);
            self.e.code.op(OP_I64_LT_U);
            self.e.code.open(OP_IF);
            self.set_len(recv, amount);
            self.e.code.op(OP_END);
            self.unit_into(dest_val);
        } else if seq_op == SQ_RESERVE || seq_op == SQ_STR_RESERVE {
            let amount = self.seq_val(a, 1);
            let need = self.add_locals(n, amount);
            let grown = self.room(a, recv, need, stride);
            self.unit_into(dest_val);
        } else if seq_op == SQ_EXTEND || seq_op == SQ_STR_PUSH_STR {
            let other = self.seq_val(a, 1);
            let other_ty = self.seq_ty(a, 1);
            let (other_addr, other_len) = self.parts(other, other_ty);
            self.append_elems(a, recv, other_addr, other_len, stride);
            self.unit_into(dest_val);
        } else if seq_op == SQ_FINISH {
            self.e.code.get(n);
            self.e.code.op(OP_I64_EQZ);
            self.e.code.op(OP_I32_EQZ);
            self.e.code.open(OP_IF);
            let oob = self.cx.s.index_oob;
            self.raise_runtime_error(oob);
            self.e.code.op(OP_END);
            self.unit_into(dest_val);
        } else if seq_op == SQ_AS_SLICE || seq_op == SQ_STR_AS_STR || seq_op == SQ_STR_AS_BYTES {
            let val = self.pack(base, n);
            self.set_value(dest_val, val);
        } else if seq_op == SQ_SUB_SLICE {
            let lo = self.seq_val(a, 1);
            let hi = self.seq_val(a, 2);
            self.check_interval(lo, hi, n);
            let start = self.local();
            self.elem_addr(base, lo, stride);
            self.e.code.op(OP_I64_EXTEND_I32_U);
            self.e.code.set(start);
            let len = self.local();
            self.e.code.get(hi);
            self.e.code.get(lo);
            self.e.code.op(OP_I64_SUB);
            self.e.code.set(len);
            let val = self.pack(start, len);
            self.set_value(dest_val, val);
        } else if seq_op == SQ_STR_SUB_STR {
            self.sub_str(a, recv, recv_ty, dest_val);
        } else if seq_op == SQ_BYTES_EQ {
            let other = self.seq_val(a, 1);
            let other_ty = self.seq_ty(a, 1);
            let (other_addr2, other_len2) = self.parts(other, other_ty);
            let helper_idx = self.bytes_eq();
            let dest = self.dest(dest_val);
            self.e.code.get(base);
            self.e.code.get(n);
            self.e.code.get(other_addr2);
            self.e.code.get(other_len2);
            self.e.code.call(helper_idx);
            self.e.code.set(dest);
        } else if seq_op == SQ_RESIZE {
            // `resize(k, v)`: grow to k filling with v, or truncate.
            let amount = self.seq_val(a, 1);
            let val = self.seq_val(a, 2);
            let grown = self.room(a, recv, amount, stride);
            let grown_addr = self.local();
            self.e.code.get(grown);
            self.e.code.i64_const(8);
            self.e.code.op(OP_I64_ADD);
            self.e.code.set(grown_addr);
            self.fill_elems(grown_addr, n, amount, stride, val);
            self.set_len(grown, amount);
            self.unit_into(dest_val);
        } else if seq_op == SQ_FILL {
            let val = self.seq_val(a, 1);
            let zero = self.const_local(0);
            self.fill_elems(base, zero, n, stride, val);
            self.unit_into(dest_val);
        } else if seq_op == SQ_FILL_RANGE || seq_op == SQ_TRY_FILL {
            let lo = self.seq_val(a, 1);
            let hi = self.seq_val(a, 2);
            let val = self.seq_val(a, 3);
            self.e.code.get(lo);
            self.e.code.get(hi);
            self.e.code.op(OP_I64_LE_U);
            self.e.code.get(hi);
            self.e.code.get(n);
            self.e.code.op(OP_I64_LE_U);
            self.e.code.op(OP_I32_AND);
            if seq_op == SQ_TRY_FILL {
                let dest = self.dest(dest_val);
                self.e.code.op(OP_I64_EXTEND_I32_U);
                self.e.code.tee(dest);
                self.e.code.op(OP_I32_WRAP_I64);
            }
            self.e.code.open(OP_IF);
            self.fill_elems(base, lo, hi, stride, val);
            if seq_op == SQ_FILL_RANGE {
                self.e.code.op(OP_ELSE);
                let oob = self.cx.s.index_oob;
                self.raise_runtime_error(oob);
            }
            self.e.code.op(OP_END);
            if seq_op == SQ_FILL_RANGE {
                self.unit_into(dest_val);
            }
        } else if seq_op == SQ_STR_PUSH_CHAR {
            let ch = self.seq_val(a, 1);
            let dest = self.dest(dest_val);
            // A scalar value: below 0x110000 and not a surrogate.
            self.e.code.get(ch);
            self.e.code.u64_const(1114112);
            self.e.code.op(OP_I64_LT_U);
            self.e.code.get(ch);
            self.e.code.u64_const(4294965248);
            self.e.code.op(OP_I64_AND);
            self.e.code.u64_const(55296);
            self.e.code.op(OP_I64_NE);
            self.e.code.op(OP_I32_AND);
            self.e.code.op(OP_I64_EXTEND_I32_U);
            self.e.code.tee(dest);
            self.e.code.op(OP_I32_WRAP_I64);
            self.e.code.open(OP_IF);
            let four = self.const_local(4);
            let need = self.add_locals(n, four);
            let grown = self.room(a, recv, need, 1);
            let helper_idx = self.utf8();
            let width = self.local();
            self.e.code.get(ch);
            self.e.code.get(grown);
            self.e.code.i64_const(8);
            self.e.code.op(OP_I64_ADD);
            self.e.code.get(n);
            self.e.code.op(OP_I64_ADD);
            self.e.code.call(helper_idx);
            self.e.code.set(width);
            self.bump_len(grown, width);
            self.e.code.op(OP_END);
        } else {
            Fail::raise(werr(K_UNSUPPORTED, U_OPERATION, 234));
        }
    }

    // `s[lo..hi]` of a string: a view on char boundaries, or a fault.
    fn sub_str(inout self, a: u64, recv: u32, recv_ty: u32, dest_val: u64) eff [Fail[WErr]] {
        let (base, n) = self.parts(recv, recv_ty);
        let lo = self.seq_val(a, 1);
        let hi = self.seq_val(a, 2);
        self.check_interval(lo, hi, n);
        for k in 0..2 {
            let bound = if k == 0 { lo } else { hi };
            // A boundary unless a continuation byte `0b10xx_xxxx` is there.
            self.e.code.get(bound);
            self.e.code.get(n);
            self.e.code.op(OP_I64_LT_U);
            self.e.code.open(OP_IF);
            let byte_val = self.elem_load(base, bound, 1);
            self.e.code.get(byte_val);
            self.e.code.i64_const(192);
            self.e.code.op(OP_I64_AND);
            self.e.code.i64_const(128);
            self.e.code.op(OP_I64_EQ);
            self.e.code.open(OP_IF);
            self.e.code.op(OP_UNREACHABLE);
            self.e.code.op(OP_END);
            self.e.code.op(OP_END);
        }
        let start = self.add_locals(base, lo);
        let len = self.local();
        self.e.code.get(hi);
        self.e.code.get(lo);
        self.e.code.op(OP_I64_SUB);
        self.e.code.set(len);
        let view = self.pack(start, len);
        self.set_value(dest_val, view);
    }

    // `read_u32_le`, `try_write_u64_be` and the other fixed-width accesses
    // of a byte sequence or slice (`Wide`, variant `k` of `seq_code`).
    fn wide(inout self, a: u64, k: u64, recv: u32, recv_ty: u32, ty: u32, dest_val: u64) eff [
        Fail[WErr]
    ] {
        let bytes = wide_bytes(k);
        let big = (k & 4) != 0;
        let write = (k & 2) != 0;
        let total = (k & 1) != 0;
        let (base, n) = self.parts(recv, recv_ty);
        let at = self.seq_val(a, 1);
        // In bounds when `at <= n && n - at >= bytes`.
        let in_bounds = self.local();
        self.e.code.get(at);
        self.e.code.get(n);
        self.e.code.op(OP_I64_LE_U);
        self.e.code.get(n);
        self.e.code.get(at);
        self.e.code.op(OP_I64_SUB);
        self.e.code.u64_const(bytes);
        self.e.code.op(OP_I64_GE_U);
        self.e.code.op(OP_I32_AND);
        self.e.code.op(OP_I64_EXTEND_I32_U);
        self.e.code.set(in_bounds);
        let dest = self.dest(dest_val);
        if !total {
            self.e.code.get(in_bounds);
            self.e.code.op(OP_I64_EQZ);
            self.e.code.open(OP_IF);
            let oob = self.cx.s.index_oob;
            self.raise_runtime_error(oob);
            self.e.code.op(OP_END);
        }
        let addr = self.add_locals(base, at);
        if write {
            let val = self.seq_val(a, 2);
            self.e.code.get(in_bounds);
            self.e.code.op(OP_I32_WRAP_I64);
            self.e.code.open(OP_IF);
            for i in 0..bytes {
                // Byte `i` of the value, low first; `big` stores it at the
                // mirrored offset.
                self.e.code.get(addr);
                self.e.code.op(OP_I32_WRAP_I64);
                self.e.code.get(val);
                self.e.code.u64_const(wrapping_mul(i, 8));
                self.e.code.op(OP_I64_SHR_U);
                self.e.code.mem(
                    OP_I64_STORE8,
                    0,
                    if big {
                        wrapping_sub(wrapping_sub(bytes, 1), i)
                    } else {
                        i
                    }
                );
            }
            self.e.code.op(OP_END);
            if total {
                self.e.code.get(in_bounds);
                self.e.code.set(dest);
            } else {
                self.e.code.i64_const(0);
                self.e.code.set(dest);
            }
            return;
        }
        let val = self.local();
        self.e.code.i64_const(0);
        self.e.code.set(val);
        self.e.code.get(in_bounds);
        self.e.code.op(OP_I32_WRAP_I64);
        self.e.code.open(OP_IF);
        for i in 0..bytes {
            self.e.code.get(val);
            self.e.code.get(addr);
            self.e.code.op(OP_I32_WRAP_I64);
            self.e.code.mem(
                OP_I64_LOAD8_U,
                0,
                if big {
                    wrapping_sub(wrapping_sub(bytes, 1), i)
                } else {
                    i
                }
            );
            self.e.code.u64_const(wrapping_mul(i, 8));
            self.e.code.op(OP_I64_SHL);
            self.e.code.op(OP_I64_OR);
            self.e.code.set(val);
        }
        self.e.code.op(OP_END);
        if total {
            self.e.code.get(in_bounds);
            self.e.code.op(OP_I32_WRAP_I64);
            self.e.code.open(OP_IF);
            self.option_into(dest, ty, val);
            self.e.code.op(OP_ELSE);
            self.option_into(dest, ty, NONE32);
            self.e.code.op(OP_END);
        } else {
            self.e.code.get(val);
            self.e.code.set(dest);
        }
    }
}

fn inc32(x: u32) -> u32 {
    wrapping_add(x, 1)
}

// The `operands` closure of `trampoline`: captures, then arguments.
fn tramp_operands(inout c: Code, ncaps: u64, arity: u64, caps: u32) {
    for k in 0..ncaps {
        c.get(caps);
        c.op(OP_I32_WRAP_I64);
        c.load(wrapping_mul(8, k));
    }
    for k in 0..arity {
        c.get(wrapping_u32(inc(k)));
    }
}

// The width of `Wide` variant `k` (bit 0 total, 1 write, 2 big, then the
// width index): 2, 4 or 8 bytes.
fn wide_bytes(k: u64) -> u64 {
    let width_index = wrapping_shr_u64(k, 3);
    if width_index == 0 {
        2
    } else if width_index == 1 {
        4
    } else {
        8
    }
}

fn append_text(inout out: ChunkSeq[u8], in src: Str) {
    let bytes = src.as_bytes();
    for i in 0..bytes.len() {
        match bytes.try_get(i) {
            Option::Some(x) => out.push(x),
            Option::None => {},
        }
    }
}

fn append_bool(inout out: ChunkSeq[u8], flag: bool) {
    if flag {
        append_text(inout out, "true");
    } else {
        append_text(inout out, "false");
    }
}

// The `Atomic` operation `k` of `L::atomic_call`.
fn atomic_op(k: u64) -> String {
    if k == 0 {
        "load"
    } else if k == 1 {
        "store"
    } else if k == 2 {
        "swap"
    } else if k == 3 {
        "fetch_add"
    } else if k == 4 {
        "fetch_sub"
    } else if k == 5 {
        "fetch_and"
    } else if k == 6 {
        "fetch_or"
    } else if k == 7 {
        "fetch_xor"
    } else {
        "into_inner"
    }
}
