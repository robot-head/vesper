const OP_I64_STORE16: u8 = 61;
const OP_I64_STORE32: u8 = 62;
const OP_MEMORY_SIZE: u8 = 63;
const OP_MEMORY_GROW: u8 = 64;
const OP_I32_CONST: u8 = 65;
const OP_I64_CONST: u8 = 66;
const OP_F64_CONST: u8 = 68;
