// Place IR to core Wasm (src/wasm_backend/lower.rs), instruction for
// instruction: every function body here emits what the Rust `Emit` emits,
// allocating its locals in the same order, so the modules are byte-equal.
//
// Not ported yet (part 2 of #1289): lexical handlers (their dispatch,
// return, abort, resume and WasmFX functions), the WASI host frames and
// the evidence a callable binds at a call site; a program that needs one
// raises `K_NOT_PORTED`. Their absence also means the evidence key set is
// empty, so every operation finds no frame and traps, as in Rust.

use @vesper/place-ir::codes::{Lit, Op, Pat, PoolKind, Term};
use @vesper/check-data::util::{add, inc, n32, u32_at, u64_at, w};
use @vesper/check-data::types::{TyKind, TyPass, Vars, vars_new};
use self::enc::{Code, ValTy, code_new, function_bytes, vt};
use self::err::{WErr, werr, werr_syms};
use self::ir::{FnInfo, pattern_end};
use self::module::{Builder, builder_new};
use self::fmod::{fmod_code};
use self::host::{Host, host_new, host_fn, op_index, returns_handle, takes_handle, takes_meta};
use self::plan::{
    Cx, HClause, Handler, Inst, Plan, Shape, TVars, alias_of, captures, closure_operands, cmp_syms,
    contains32, instance_key, instance_name, prefixed_key, tvars_new
};
use self::tables::{alloc_code, stage2_heap_mark, stage2_heap_reset};

