const NONE64: u64 = 18446744073709551615;
const I64_MIN: i64 = -9223372036854775808;
// err.ves (constants cannot be imported yet)
const K_UNSUPPORTED: u8 = 0;
const K_ENTRY: u8 = 1;
const K_LIMIT: u8 = 2;
const K_INVALID: u8 = 3;
