// `f32` values and the float conversions in the port (`vesper.float.ieee754/1`,
// #2375). An `f32` lives in a word as its binary32 bits, zero-extended, so
// a `to_bits_f32` or `from_bits_f32` is the word itself, and storage,
// moves and copies are an integer's. Arithmetic reinterprets the low half
// as an `f32`, and an `f64` word as an `f64`. Lowered here: `f32` `+ - * /
// %`, negation and comparisons, `f32` literals, `widen_f32`, `widen_f64`,
// `nearest_f32` and `nearest_f64` (from either float kind or a 64-bit or
// narrower integer, rounding once to nearest, ties to even), and
// `to_bits_<f>`/`from_bits_<f>`. The math intrinsics, `saturating_k` and
// `narrow_k` of a float are still refused (they fall through to the
// unsupported sites).

use @vesper/check-data::types::{TyKind};
use self::enc::{Code};
use self::err::{WErr, werr};
use self::lower::{L};

// Consts do not cross modules: src/err.ves, src/lower.ves, src/plan.ves.
const K_UNSUPPORTED: u8 = 0;
const U_OPERATION: u8 = 13;
const E_F64_OPERATOR: u64 = 250;
const E_F32_OPERATOR: u64 = 260;
const SC_I64: u8 = 0;
const SC_U64: u8 = 1;
const SC_U32: u8 = 2;
const SC_U8: u8 = 3;
const SC_F64: u8 = 5;
const SC_U16: u8 = 8;
const SC_I32: u8 = 9;
const SC_I16: u8 = 10;
const SC_I8: u8 = 11;
const SC_F32: u8 = 12;
const OP_F32_EQ: u8 = 91;
const OP_F32_NE: u8 = 92;
const OP_F32_LT: u8 = 93;
const OP_F32_GT: u8 = 94;
const OP_F32_LE: u8 = 95;
const OP_F32_GE: u8 = 96;
const OP_F64_EQ: u8 = 97;
const OP_F64_NE: u8 = 98;
const OP_F64_LT: u8 = 99;
const OP_F64_GT: u8 = 100;
const OP_F64_LE: u8 = 101;
const OP_F64_GE: u8 = 102;
const OP_F32_ADD: u8 = 146;
const OP_F32_SUB: u8 = 147;
const OP_F32_MUL: u8 = 148;
const OP_F32_DIV: u8 = 149;
const OP_F64_ADD: u8 = 160;
const OP_F64_SUB: u8 = 161;
const OP_F64_MUL: u8 = 162;
const OP_F64_DIV: u8 = 163;
const OP_I32_WRAP_I64: u8 = 167;
const OP_I64_EXTEND_I32_U: u8 = 173;
const OP_F32_CONVERT_I64_S: u8 = 180;
const OP_F32_CONVERT_I64_U: u8 = 181;
const OP_F32_DEMOTE_F64: u8 = 182;
const OP_F64_CONVERT_I64_S: u8 = 185;
const OP_F64_CONVERT_I64_U: u8 = 186;
const OP_F64_PROMOTE_F32: u8 = 187;
const OP_I32_REINTERPRET_F32: u8 = 188;
const OP_I64_REINTERPRET_F64: u8 = 189;
const OP_F32_REINTERPRET_I32: u8 = 190;
const OP_F64_REINTERPRET_I64: u8 = 191;
const OP_I64_XOR: u8 = 133;
// The binary32 sign bit, in the low half of the word.
const F32_SIGN_BIT: u64 = 2147483648;

fn signed_word(scalar: u8) -> bool {
    scalar == SC_I64 || scalar == SC_I32 || scalar == SC_I16 || scalar == SC_I8
}

fn unsigned_word(scalar: u8) -> bool {
    scalar == SC_U64 || scalar == SC_U32 || scalar == SC_U16 || scalar == SC_U8
}

// `eq_fn`'s body for `f32` words in locals `lhs` and `rhs`: equal as floats
// (`-0.0 == 0.0`, a NaN equals nothing).
pub fn f32_eq_code(inout code: Code, lhs: u32, rhs: u32) {
    code.get(lhs);
    code.op(OP_I32_WRAP_I64);
    code.op(OP_F32_REINTERPRET_I32);
    code.get(rhs);
    code.op(OP_I32_WRAP_I64);
    code.op(OP_F32_REINTERPRET_I32);
    code.op(OP_F32_EQ);
    code.op(OP_I64_EXTEND_I32_U);
}

impl L {
    // Whether `ty` is `f32`.
    pub fn is_f32_ty(inout self, ty: u32) -> bool {
        let d = self.ctx.default_ty(ty);
        let node = self.ctx.types.node(d);
        node.kind == TyKind::Named && node.n == 0 && node.name == self.ctx.syms.f32_
    }

    // The word of the float literal with `f64` bits `bits` at type `ty`: an
    // `f32` literal is the nearest `f32` to its `f64` value (as Rust's
    // checker types an unsuffixed literal).
    pub fn float_literal_word(inout self, bits: u64, ty: u32) -> u64 {
        if self.is_f32_ty(ty) {
            widen_u64(to_bits_f32(nearest_f32(from_bits_f64(bits))))
        } else {
            bits
        }
    }

    // Push the `f32` in local `word`.
    fn push_f32(inout self, word: u32) {
        self.cur_fn.code.get(word);
        self.cur_fn.code.op(OP_I32_WRAP_I64);
        self.cur_fn.code.op(OP_F32_REINTERPRET_I32);
    }

    // The `f32` on the stack as a word.
    fn f32_word(inout self) {
        self.cur_fn.code.op(OP_I32_REINTERPRET_F32);
        self.cur_fn.code.op(OP_I64_EXTEND_I32_U);
    }

    // Push the word in local `value` (of scalar `from`) converted to the
    // float kind `to` (`SC_F32` or `SC_F64`), rounding once to nearest,
    // ties to even; false (nothing pushed) when `from` is no float or
    // integer word.
    fn push_to_float(inout self, value: u32, from: u8, to: u8) -> bool {
        let signed = signed_word(from);
        let unsigned = unsigned_word(from);
        if from == SC_F32 {
            self.push_f32(value);
            if to == SC_F64 {
                self.cur_fn.code.op(OP_F64_PROMOTE_F32);
            }
        } else if from == SC_F64 {
            self.cur_fn.code.get(value);
            self.cur_fn.code.op(OP_F64_REINTERPRET_I64);
            if to == SC_F32 {
                self.cur_fn.code.op(OP_F32_DEMOTE_F64);
            }
        } else if signed || unsigned {
            // Narrower integer words are sign- or zero-extended already.
            self.cur_fn.code.get(value);
            let op = if to == SC_F32 && signed {
                OP_F32_CONVERT_I64_S
            } else if to == SC_F32 {
                OP_F32_CONVERT_I64_U
            } else if signed {
                OP_F64_CONVERT_I64_S
            } else {
                OP_F64_CONVERT_I64_U
            };
            self.cur_fn.code.op(op);
        } else {
            return false;
        }
        if to == SC_F32 {
            self.f32_word();
        } else {
            self.cur_fn.code.op(OP_I64_REINTERPRET_F64);
        }
        true
    }

    // `widen_<f>(x)`, `nearest_<f>(x)`, `to_bits_<f>(x)` or
    // `from_bits_<f>(x)` of `operand` (scalar `from`) to `ty`: push the
    // result, or false for another operator (Place IR makes each float
    // intrinsic of one operand a unary operator).
    pub fn float_unary(
        inout self,
        op_sym: u32,
        operand: u32,
        from: u8,
        ty: u32
    ) -> bool eff [Fail[WErr]] {
        let bits_from = (self.is_op(op_sym, "to_bits_f32") && from == SC_F32)
            || (self.is_op(op_sym, "to_bits_f64") && from == SC_F64);
        // Stage 2 types an unsuffixed literal operand of `from_bits_<f>` at
        // its default integer kind; the checker has held it to `u32`/`u64`.
        let int_from = signed_word(from) || unsigned_word(from);
        let bits_to = (self.is_op(op_sym, "from_bits_f32") || self.is_op(op_sym, "from_bits_f64"))
            && int_from;
        if bits_from || bits_to {
            // The bits and the float share one word.
            self.cur_fn.code.get(operand);
            return true;
        }
        let to = if self.is_op(op_sym, "widen_f32") || self.is_op(op_sym, "nearest_f32") {
            SC_F32
        } else if self.is_op(op_sym, "widen_f64") || self.is_op(op_sym, "nearest_f64") {
            SC_F64
        } else {
            return false;
        };
        if self.scalar_of(ty) != to {
            return false;
        }
        self.push_to_float(operand, from, to)
    }

    // `-x` of the `f32` in `operand`: flip the sign bit.
    pub fn f32_neg(inout self, operand: u32) {
        self.cur_fn.code.get(operand);
        self.cur_fn.code.u64_const(F32_SIGN_BIT);
        self.cur_fn.code.op(OP_I64_XOR);
    }

    // `lhs op rhs` of two `f32` words into a new local.
    pub fn f32_binary(inout self, op_sym: u32, lhs: u32, rhs: u32) -> u32 eff [Fail[WErr]] {
        let result = self.local();
        if self.is_op(op_sym, "%") {
            // fmod is exact, so the `f64` remainder of the widened operands
            // is the `f32` remainder.
            let fmod_idx = self.fmod();
            self.push_f32(lhs);
            self.cur_fn.code.op(OP_F64_PROMOTE_F32);
            self.cur_fn.code.op(OP_I64_REINTERPRET_F64);
            self.push_f32(rhs);
            self.cur_fn.code.op(OP_F64_PROMOTE_F32);
            self.cur_fn.code.op(OP_I64_REINTERPRET_F64);
            self.cur_fn.code.call(fmod_idx);
            self.cur_fn.code.op(OP_F64_REINTERPRET_I64);
            self.cur_fn.code.op(OP_F32_DEMOTE_F64);
            self.f32_word();
            self.cur_fn.code.set(result);
            return result;
        }
        let mut wasm_op: u8 = 0;
        let mut cmp = false;
        if self.is_op(op_sym, "+") {
            wasm_op = OP_F32_ADD;
        } else if self.is_op(op_sym, "-") {
            wasm_op = OP_F32_SUB;
        } else if self.is_op(op_sym, "*") {
            wasm_op = OP_F32_MUL;
        } else if self.is_op(op_sym, "/") {
            wasm_op = OP_F32_DIV;
        } else if self.is_op(op_sym, "==") {
            wasm_op = OP_F32_EQ;
            cmp = true;
        } else if self.is_op(op_sym, "!=") {
            wasm_op = OP_F32_NE;
            cmp = true;
        } else if self.is_op(op_sym, "<") {
            wasm_op = OP_F32_LT;
            cmp = true;
        } else if self.is_op(op_sym, "<=") {
            wasm_op = OP_F32_LE;
            cmp = true;
        } else if self.is_op(op_sym, ">") {
            wasm_op = OP_F32_GT;
            cmp = true;
        } else if self.is_op(op_sym, ">=") {
            wasm_op = OP_F32_GE;
            cmp = true;
        } else {
            Fail::raise(werr(K_UNSUPPORTED, U_OPERATION, E_F32_OPERATOR));
        }
        self.push_f32(lhs);
        self.push_f32(rhs);
        self.cur_fn.code.op(wasm_op);
        if cmp {
            self.cur_fn.code.op(OP_I64_EXTEND_I32_U);
        } else {
            self.f32_word();
        }
        self.cur_fn.code.set(result);
        result
    }

    // `lhs op rhs` of two `f64` words into a new local.
    pub fn f64_binary(inout self, op_sym: u32, lhs: u32, rhs: u32) -> u32 eff [Fail[WErr]] {
        let result = self.local();
        if self.is_op(op_sym, "%") {
            let fmod_idx = self.fmod();
            self.cur_fn.code.get(lhs);
            self.cur_fn.code.get(rhs);
            self.cur_fn.code.call(fmod_idx);
            self.cur_fn.code.set(result);
            return result;
        }
        let mut wasm_op: u8 = 0;
        let mut cmp = false;
        if self.is_op(op_sym, "+") {
            wasm_op = OP_F64_ADD;
        } else if self.is_op(op_sym, "-") {
            wasm_op = OP_F64_SUB;
        } else if self.is_op(op_sym, "*") {
            wasm_op = OP_F64_MUL;
        } else if self.is_op(op_sym, "/") {
            wasm_op = OP_F64_DIV;
        } else if self.is_op(op_sym, "==") {
            wasm_op = OP_F64_EQ;
            cmp = true;
        } else if self.is_op(op_sym, "!=") {
            wasm_op = OP_F64_NE;
            cmp = true;
        } else if self.is_op(op_sym, "<") {
            wasm_op = OP_F64_LT;
            cmp = true;
        } else if self.is_op(op_sym, "<=") {
            wasm_op = OP_F64_LE;
            cmp = true;
        } else if self.is_op(op_sym, ">") {
            wasm_op = OP_F64_GT;
            cmp = true;
        } else if self.is_op(op_sym, ">=") {
            wasm_op = OP_F64_GE;
            cmp = true;
        } else {
            Fail::raise(werr(K_UNSUPPORTED, U_OPERATION, E_F64_OPERATOR));
        }
        self.cur_fn.code.get(lhs);
        self.cur_fn.code.op(OP_F64_REINTERPRET_I64);
        self.cur_fn.code.get(rhs);
        self.cur_fn.code.op(OP_F64_REINTERPRET_I64);
        self.cur_fn.code.op(wasm_op);
        if cmp {
            self.cur_fn.code.op(OP_I64_EXTEND_I32_U);
        } else {
            self.cur_fn.code.op(OP_I64_REINTERPRET_F64);
        }
        self.cur_fn.code.set(result);
        result
    }
}
