// Emit shared core Wasm helpers for sequence growth, byte equality and UTF-8.

use @vesper/check-data::util::{inc};
use self::enc::{code_new};
use self::lower::{L, body_n, i64s};

// Consts do not cross modules. See src/lower.ves.
const OP_UNREACHABLE: u8 = 0;
const OP_LOOP: u8 = 3;
const OP_IF: u8 = 4;
const OP_END: u8 = 11;
const OP_RETURN: u8 = 15;
const OP_I64_LOAD8_U: u8 = 49;
const OP_I64_STORE8: u8 = 60;
const OP_I64_NE: u8 = 82;
const OP_I64_LT_U: u8 = 84;
const OP_I64_LE_U: u8 = 88;
const OP_I64_GE_U: u8 = 90;
const OP_I64_ADD: u8 = 124;
const OP_I64_MUL: u8 = 126;
const OP_I64_AND: u8 = 131;
const OP_I64_OR: u8 = 132;
const OP_I64_SHL: u8 = 134;
const OP_I64_SHR_U: u8 = 136;
const OP_I32_WRAP_I64: u8 = 167;
const NONE32: u32 = 4294967295;
const LOW32: u64 = 4294967295;

impl L {
    // `$seq_reserve(p, need, stride) -> p`: buffer `p` when its capacity
    // holds `need` elements, else a copy with capacity
    // `max(need, 2 * cap, 4)`.
    pub fn seq_reserve(inout self) -> u32 {
        if self.h_seq_reserve != NONE32 {
            return self.h_seq_reserve;
        }
        let idx = self.b.declare(in i64s(3), in i64s(1));
        self.h_seq_reserve = idx;
        let p: u32 = 0;
        let need: u32 = 1;
        let stride: u32 = 2;
        let cap: u32 = 3;
        let len: u32 = 4;
        let new_cap: u32 = 5;
        let new_buf: u32 = 6;
        let mut code = code_new();
        code.get(p);
        code.op(OP_I32_WRAP_I64);
        code.load(0);
        code.tee(len);
        code.i64_const(32);
        code.op(OP_I64_SHR_U);
        code.set(cap);
        code.get(len);
        code.u64_const(LOW32);
        code.op(OP_I64_AND);
        code.set(len);
        code.get(need);
        code.get(cap);
        code.op(OP_I64_LE_U);
        code.open(OP_IF);
        code.get(p);
        code.op(OP_RETURN);
        code.op(OP_END);
        code.get(cap);
        code.i64_const(1);
        code.op(OP_I64_SHL);
        code.set(new_cap);
        code.get(new_cap);
        code.get(need);
        code.op(OP_I64_LT_U);
        code.open(OP_IF);
        code.get(need);
        code.set(new_cap);
        code.op(OP_END);
        code.get(new_cap);
        code.i64_const(4);
        code.op(OP_I64_LT_U);
        code.open(OP_IF);
        code.i64_const(4);
        code.set(new_cap);
        code.op(OP_END);
        code.get(new_cap);
        code.get(stride);
        code.op(OP_I64_MUL);
        code.i64_const(8);
        code.op(OP_I64_ADD);
        code.call(self.alloc);
        code.tee(new_buf);
        code.i64_const(8);
        code.op(OP_I64_ADD);
        code.op(OP_I32_WRAP_I64);
        code.get(p);
        code.i64_const(8);
        code.op(OP_I64_ADD);
        code.op(OP_I32_WRAP_I64);
        code.get(len);
        code.get(stride);
        code.op(OP_I64_MUL);
        code.op(OP_I32_WRAP_I64);
        code.memory_copy();
        code.get(new_buf);
        code.op(OP_I32_WRAP_I64);
        code.get(len);
        code.get(new_cap);
        code.i64_const(32);
        code.op(OP_I64_SHL);
        code.op(OP_I64_OR);
        code.store(0);
        code.get(new_buf);
        code.op(OP_END);
        self.b.define(idx, in body_n(4, in code));
        idx
    }

    // `$bytes_eq(a, n, b, m)`: the byte ranges are equal.
    pub fn bytes_eq(inout self) -> u32 {
        if self.h_bytes_eq != NONE32 {
            return self.h_bytes_eq;
        }
        let idx = self.b.declare(in i64s(4), in i64s(1));
        self.h_bytes_eq = idx;
        let i: u32 = 4;
        let mut code = code_new();
        code.get(1);
        code.get(3);
        code.op(OP_I64_NE);
        code.open(OP_IF);
        code.i64_const(0);
        code.op(OP_RETURN);
        code.op(OP_END);
        code.open(OP_LOOP);
        code.get(i);
        code.get(1);
        code.op(OP_I64_GE_U);
        code.open(OP_IF);
        code.i64_const(1);
        code.op(OP_RETURN);
        code.op(OP_END);
        code.get(0);
        code.get(i);
        code.op(OP_I64_ADD);
        code.op(OP_I32_WRAP_I64);
        code.mem(OP_I64_LOAD8_U, 0, 0);
        code.get(2);
        code.get(i);
        code.op(OP_I64_ADD);
        code.op(OP_I32_WRAP_I64);
        code.mem(OP_I64_LOAD8_U, 0, 0);
        code.op(OP_I64_NE);
        code.open(OP_IF);
        code.i64_const(0);
        code.op(OP_RETURN);
        code.op(OP_END);
        code.get(i);
        code.i64_const(1);
        code.op(OP_I64_ADD);
        code.set(i);
        code.br(0);
        code.op(OP_END);
        code.op(OP_UNREACHABLE);
        code.op(OP_END);
        self.b.define(idx, in body_n(1, in code));
        idx
    }

    // `$utf8(c, at) -> width`: the UTF-8 encoding of scalar value `c` at
    // address `at`.
    pub fn utf8(inout self) -> u32 {
        if self.h_utf8 != NONE32 {
            return self.h_utf8;
        }
        let idx = self.b.declare(in i64s(2), in i64s(1));
        self.h_utf8 = idx;
        let scalar: u32 = 0;
        let at: u32 = 1;
        let mut code = code_new();
        // One byte below 0x80.
        code.get(scalar);
        code.i64_const(128);
        code.op(OP_I64_LT_U);
        code.open(OP_IF);
        code.get(at);
        code.op(OP_I32_WRAP_I64);
        code.get(scalar);
        code.mem(OP_I64_STORE8, 0, 0);
        code.i64_const(1);
        code.op(OP_RETURN);
        code.op(OP_END);
        // Width w: 2 below 0x800, 3 below 0x10000, else 4. The lead byte
        // is `prefix | c >> 6(w-1)`, then `0x80 | (c >> 6k) & 63`.
        for width in 2..5 {
            let limit: u64 = if width == 2 {
                2048
            } else if width == 3 {
                65536
            } else {
                1114112
            };
            let prefix: i64 = if width == 2 {
                192
            } else if width == 3 {
                224
            } else {
                240
            };
            code.get(scalar);
            code.u64_const(limit);
            code.op(OP_I64_LT_U);
            code.open(OP_IF);
            code.get(at);
            code.op(OP_I32_WRAP_I64);
            code.get(scalar);
            code.u64_const(wrapping_mul(6, wrapping_sub(width, 1)));
            code.op(OP_I64_SHR_U);
            code.i64_const(prefix);
            code.op(OP_I64_OR);
            code.mem(OP_I64_STORE8, 0, 0);
            for byte_index in 1..width {
                code.get(at);
                code.op(OP_I32_WRAP_I64);
                code.get(scalar);
                code.u64_const(wrapping_mul(6, wrapping_sub(width, inc(byte_index))));
                code.op(OP_I64_SHR_U);
                code.i64_const(63);
                code.op(OP_I64_AND);
                code.i64_const(128);
                code.op(OP_I64_OR);
                code.mem(OP_I64_STORE8, 0, byte_index);
            }
            code.u64_const(width);
            code.op(OP_RETURN);
            code.op(OP_END);
        }
        code.op(OP_UNREACHABLE);
        code.op(OP_END);
        self.b.define(idx, in body_n(0, in code));
        idx
    }
}
