// Emit shared core Wasm helpers for sequence growth, byte equality and UTF-8.

use @vesper/check-data::util::{inc};
use self::enc::{code_new};
use self::lower::{L, body_n, i64s};

// Consts do not cross modules. See src/lower.ves.
const OP_UNREACHABLE: u8 = 0;
const OP_LOOP: u8 = 3;
const OP_IF: u8 = 4;
const OP_END: u8 = 11;
const OP_RETURN: u8 = 15;
const OP_I64_LOAD8_U: u8 = 49;
const OP_I64_STORE8: u8 = 60;
const OP_I64_NE: u8 = 82;
const OP_I64_LT_U: u8 = 84;
const OP_I64_LE_U: u8 = 88;
const OP_I64_GE_U: u8 = 90;
const OP_I64_ADD: u8 = 124;
const OP_I64_MUL: u8 = 126;
const OP_I64_AND: u8 = 131;
const OP_I64_OR: u8 = 132;
const OP_I64_SHL: u8 = 134;
const OP_I64_SHR_U: u8 = 136;
const OP_I32_WRAP_I64: u8 = 167;
const NONE32: u32 = 4294967295;
const LOW32: u64 = 4294967295;

impl L {
    // `$seq_reserve(p, need, stride) -> p`: buffer `p` when its capacity
    // holds `need` elements, else a copy with capacity
    // `max(need, 2 * cap, 4)`.
    pub fn seq_reserve(inout self) -> u32 {
        if self.h_seq_reserve != NONE32 {
            return self.h_seq_reserve;
        }
        let idx = self.b.declare(in i64s(3), in i64s(1));
        self.h_seq_reserve = idx;
        let p: u32 = 0;
        let need: u32 = 1;
        let stride: u32 = 2;
        let cap: u32 = 3;
        let len: u32 = 4;
        let nc: u32 = 5;
        let q: u32 = 6;
        let mut c = code_new();
        c.get(p);
        c.op(OP_I32_WRAP_I64);
        c.load(0);
        c.tee(len);
        c.i64_const(32);
        c.op(OP_I64_SHR_U);
        c.set(cap);
        c.get(len);
        c.u64_const(LOW32);
        c.op(OP_I64_AND);
        c.set(len);
        c.get(need);
        c.get(cap);
        c.op(OP_I64_LE_U);
        c.open(OP_IF);
        c.get(p);
        c.op(OP_RETURN);
        c.op(OP_END);
        c.get(cap);
        c.i64_const(1);
        c.op(OP_I64_SHL);
        c.set(nc);
        c.get(nc);
        c.get(need);
        c.op(OP_I64_LT_U);
        c.open(OP_IF);
        c.get(need);
        c.set(nc);
        c.op(OP_END);
        c.get(nc);
        c.i64_const(4);
        c.op(OP_I64_LT_U);
        c.open(OP_IF);
        c.i64_const(4);
        c.set(nc);
        c.op(OP_END);
        c.get(nc);
        c.get(stride);
        c.op(OP_I64_MUL);
        c.i64_const(8);
        c.op(OP_I64_ADD);
        c.call(self.alloc);
        c.tee(q);
        c.i64_const(8);
        c.op(OP_I64_ADD);
        c.op(OP_I32_WRAP_I64);
        c.get(p);
        c.i64_const(8);
        c.op(OP_I64_ADD);
        c.op(OP_I32_WRAP_I64);
        c.get(len);
        c.get(stride);
        c.op(OP_I64_MUL);
        c.op(OP_I32_WRAP_I64);
        c.memory_copy();
        c.get(q);
        c.op(OP_I32_WRAP_I64);
        c.get(len);
        c.get(nc);
        c.i64_const(32);
        c.op(OP_I64_SHL);
        c.op(OP_I64_OR);
        c.store(0);
        c.get(q);
        c.op(OP_END);
        self.b.define(idx, in body_n(4, in c));
        idx
    }

    // `$bytes_eq(a, n, b, m)`: the byte ranges are equal.
    pub fn bytes_eq(inout self) -> u32 {
        if self.h_bytes_eq != NONE32 {
            return self.h_bytes_eq;
        }
        let idx = self.b.declare(in i64s(4), in i64s(1));
        self.h_bytes_eq = idx;
        let i: u32 = 4;
        let mut c = code_new();
        c.get(1);
        c.get(3);
        c.op(OP_I64_NE);
        c.open(OP_IF);
        c.i64_const(0);
        c.op(OP_RETURN);
        c.op(OP_END);
        c.open(OP_LOOP);
        c.get(i);
        c.get(1);
        c.op(OP_I64_GE_U);
        c.open(OP_IF);
        c.i64_const(1);
        c.op(OP_RETURN);
        c.op(OP_END);
        c.get(0);
        c.get(i);
        c.op(OP_I64_ADD);
        c.op(OP_I32_WRAP_I64);
        c.mem(OP_I64_LOAD8_U, 0, 0);
        c.get(2);
        c.get(i);
        c.op(OP_I64_ADD);
        c.op(OP_I32_WRAP_I64);
        c.mem(OP_I64_LOAD8_U, 0, 0);
        c.op(OP_I64_NE);
        c.open(OP_IF);
        c.i64_const(0);
        c.op(OP_RETURN);
        c.op(OP_END);
        c.get(i);
        c.i64_const(1);
        c.op(OP_I64_ADD);
        c.set(i);
        c.br(0);
        c.op(OP_END);
        c.op(OP_UNREACHABLE);
        c.op(OP_END);
        self.b.define(idx, in body_n(1, in c));
        idx
    }

    // `$utf8(c, at) -> width`: the UTF-8 encoding of scalar value `c` at
    // address `at`.
    pub fn utf8(inout self) -> u32 {
        if self.h_utf8 != NONE32 {
            return self.h_utf8;
        }
        let idx = self.b.declare(in i64s(2), in i64s(1));
        self.h_utf8 = idx;
        let ch: u32 = 0;
        let at: u32 = 1;
        let mut c = code_new();
        // One byte below 0x80.
        c.get(ch);
        c.i64_const(128);
        c.op(OP_I64_LT_U);
        c.open(OP_IF);
        c.get(at);
        c.op(OP_I32_WRAP_I64);
        c.get(ch);
        c.mem(OP_I64_STORE8, 0, 0);
        c.i64_const(1);
        c.op(OP_RETURN);
        c.op(OP_END);
        // Width w: 2 below 0x800, 3 below 0x10000, else 4. The lead byte
        // is `prefix | c >> 6(w-1)`, then `0x80 | (c >> 6k) & 63`.
        for wd in 2..5 {
            let limit: u64 = if wd == 2 {
                2048
            } else if wd == 3 {
                65536
            } else {
                1114112
            };
            let prefix: i64 = if wd == 2 {
                192
            } else if wd == 3 {
                224
            } else {
                240
            };
            c.get(ch);
            c.u64_const(limit);
            c.op(OP_I64_LT_U);
            c.open(OP_IF);
            c.get(at);
            c.op(OP_I32_WRAP_I64);
            c.get(ch);
            c.u64_const(wrapping_mul(6, wrapping_sub(wd, 1)));
            c.op(OP_I64_SHR_U);
            c.i64_const(prefix);
            c.op(OP_I64_OR);
            c.mem(OP_I64_STORE8, 0, 0);
            for k in 1..wd {
                c.get(at);
                c.op(OP_I32_WRAP_I64);
                c.get(ch);
                c.u64_const(wrapping_mul(6, wrapping_sub(wd, inc(k))));
                c.op(OP_I64_SHR_U);
                c.i64_const(63);
                c.op(OP_I64_AND);
                c.i64_const(128);
                c.op(OP_I64_OR);
                c.mem(OP_I64_STORE8, 0, k);
            }
            c.u64_const(wd);
            c.op(OP_RETURN);
            c.op(OP_END);
        }
        c.op(OP_UNREACHABLE);
        c.op(OP_END);
        self.b.define(idx, in body_n(0, in c));
        idx
    }
}
