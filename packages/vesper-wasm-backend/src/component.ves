// The component boundary of src/wasm_backend/component.rs: the WIT world
// for the entry and the canonical-ABI export wrappers in the core module.
//
// Encoding the component itself (`component::encode`, wit-component and
// wit-parser) stays in Rust: the harness wraps this port's core module and
// WIT text with it.

use @vesper/check-data::types::{TyKind, TyPass};
use @vesper/check-data::util::{add, inc, w};
use self::enc::{Code, ValTy, code_new, function_bytes, vt};
use self::err::{WErr, werr};
use self::lower::{L, body_each, body_n, get32};
use self::host::{active, wit_imports};
use self::plan::{Shape};

const NONE32: u32 = 4294967295;
const K_UNSUPPORTED: u8 = 0;
const K_ENTRY: u8 = 1;
const K_INVALID: u8 = 3;
const U_EXPORT_TYPE: u8 = 12;

const SH_SCALAR: u8 = 0;
const SH_TUPLE: u8 = 1;
const SH_STRUCT: u8 = 2;
const SH_ENUM: u8 = 3;
const SH_STR: u8 = 4;
const SC_I64: u8 = 0;
const SC_U64: u8 = 1;
const SC_U32: u8 = 2;
const SC_U8: u8 = 3;
const SC_BOOL: u8 = 4;
const SC_F64: u8 = 5;
const SC_UNIT: u8 = 6;
const SC_NEVER: u8 = 7;

const VT_I32: u8 = 127;
const VT_I64: u8 = 126;
const VT_F64: u8 = 124;

const OP_UNREACHABLE: u8 = 0;
const OP_NOP: u8 = 1;
const OP_IF: u8 = 4;
const OP_END: u8 = 11;
const OP_DROP: u8 = 26;
const OP_SELECT: u8 = 27;
const OP_I32_LOAD: u8 = 40;
const OP_I64_LOAD: u8 = 41;
const OP_F64_LOAD: u8 = 43;
const OP_I32_LOAD8_U: u8 = 45;
const OP_I32_LOAD16_U: u8 = 47;
const OP_I64_STORE: u8 = 55;
const OP_I64_STORE8: u8 = 60;
const OP_I64_STORE16: u8 = 61;
const OP_I64_STORE32: u8 = 62;
const OP_I32_LT_U: u8 = 73;
const OP_I64_EQ: u8 = 81;
const OP_I64_NE: u8 = 82;
const OP_I64_GE_U: u8 = 90;
const OP_I32_ADD: u8 = 106;
const OP_I64_ADD: u8 = 124;
const OP_I64_AND: u8 = 131;
const OP_I32_WRAP_I64: u8 = 167;
const OP_I64_EXTEND_I32_U: u8 = 173;
const OP_I64_REINTERPRET_F64: u8 = 189;
const OP_F64_REINTERPRET_I64: u8 = 191;

const LOW32: i64 = 4294967295;

fn export_err(site: u64) -> WErr {
    werr(K_UNSUPPORTED, U_EXPORT_TYPE, site)
}

fn text(inout out: ChunkSeq[u8], in bytes: Slice[u8]) {
    for i in 0..bytes.len() {
        match bytes.try_get(i) {
            Option::Some(byte_val) => out.push(byte_val),
            Option::None => {},
        }
    }
}

fn is_digit(byte_val: u8) -> bool {
    byte_val >= 48 && byte_val <= 57
}

fn is_lower(byte_val: u8) -> bool {
    byte_val >= 97 && byte_val <= 122
}

fn is_upper(byte_val: u8) -> bool {
    byte_val >= 65 && byte_val <= 90
}

// Close the current word of `ident` into `out`, merging a word that
// starts with a digit into the one before it.
fn ident_word(inout out: ChunkSeq[u8], inout word: ChunkSeq[u8], inout merged: u64) {
    if word.len() == 0 {
        return;
    }
    let first = match word.try_get(0) {
        Option::Some(byte_val) => byte_val,
        Option::None => 0,
    };
    if is_digit(first) {
        if merged == 0 {
            out.push(110);
            merged = 1;
        }
    } else {
        if merged > 0 {
            out.push(45);
        }
        merged = add(merged, 1);
    }
    for i in 0..word.len() {
        match word.try_get(i) {
            Option::Some(byte_val) => out.push(byte_val),
            Option::None => {},
        }
    }
    word = ChunkSeq::new[u8]();
}

// `component::ident`: a WIT identifier (kebab-case) for a Vesper name.
pub fn ident(in name: Slice[u8], inout out: ChunkSeq[u8]) {
    let mut word = ChunkSeq::new[u8]();
    let mut merged: u64 = 0;
    let mut prev_lower = false;
    for i in 0..name.len() {
        let byte_val = match name.try_get(i) {
            Option::Some(byte_val) => byte_val,
            Option::None => 0,
        };
        let alnum = is_digit(byte_val) || is_lower(byte_val) || is_upper(byte_val);
        if !alnum {
            ident_word(inout out, inout word, inout merged);
            prev_lower = false;
            continue;
        }
        if is_upper(byte_val) && prev_lower && word.len() > 0 {
            ident_word(inout out, inout word, inout merged);
        }
        prev_lower = is_lower(byte_val) || is_digit(byte_val);
        if is_upper(byte_val) {
            word.push(wrapping_add(byte_val, 32));
        } else {
            word.push(byte_val);
        }
    }
    ident_word(inout out, inout word, inout merged);
    if merged == 0 {
        text(inout out, in "unnamed".as_bytes());
    }
}

fn ident_sym(in lowerer: L, sym_id: u32, inout out: ChunkSeq[u8]) {
    let mut name_bytes = ChunkSeq::new[u8]();
    lowerer.ctx.write_name(sym_id, inout name_bytes);
    ident(in name_bytes.as_slice(), inout out);
}

// `component::mangle`.
fn mangle(in lowerer: L, ty: u32, inout out: ChunkSeq[u8]) {
    let node = lowerer.ctx.types.node(ty);
    if node.kind == TyKind::Named {
        ident_sym(in lowerer, node.name, inout out);
        for i in 0..w(node.n) {
            out.push(45);
            mangle(in lowerer, lowerer.ctx.types.arg(ty, i), inout out);
        }
        return;
    }
    if node.kind == TyKind::Tuple {
        text(inout out, in "tuple".as_bytes());
        for i in 0..w(node.n) {
            out.push(45);
            mangle(in lowerer, lowerer.ctx.types.arg(ty, i), inout out);
        }
        return;
    }
    text(inout out, in "value".as_bytes());
}

// WIT type expressions and the named definitions they need
// (`component::Wit`): `defs` holds each definition as `  {d}\n`.
pub struct Wit {
    defs: ChunkSeq[u8],
    // type display -> mangled name symbol + 1
    names: ChunkSeq[u32],
    active: ChunkSeq[u32],
}

pub fn wit_new() -> Wit {
    Wit { defs: ChunkSeq::new[u8](), names: ChunkSeq::new[u32](), active: ChunkSeq::new[u32]() }
}

fn set32(inout table: ChunkSeq[u32], key: u32, value: u32) {
    let i = w(key);
    loop {
        if table.len() > i {
            break;
        }
        table.push(0);
    }
    let ok = table.try_set(i, value);
}

fn display_key(inout lowerer: L, ty: u32) -> u32 {
    let mut display = ChunkSeq::new[u8]();
    lowerer.ctx.show(ty, inout display);
    lowerer.ctx.intern(in display)
}

impl Wit {
    fn is_active(in self, key: u32) -> bool {
        for i in 0..self.active.len() {
            match self.active.try_get(i) {
                Option::Some(entry) => {
                    if entry == key {
                        return true;
                    }
                },
                Option::None => {},
            }
        }
        false
    }

    fn deactivate(inout self, key: u32) {
        let mut keep = ChunkSeq::new[u32]();
        for i in 0..self.active.len() {
            match self.active.try_get(i) {
                Option::Some(entry) => {
                    if entry != key {
                        keep.push(entry);
                    }
                },
                Option::None => {},
            }
        }
        self.active = keep;
    }

    fn def(inout self, in line: ChunkSeq[u8]) {
        text(inout self.defs, in "  ".as_bytes());
        for i in 0..line.len() {
            match line.try_get(i) {
                Option::Some(byte_val) => self.defs.push(byte_val),
                Option::None => {},
            }
        }
        self.defs.push(10);
    }

    // `Wit::ty`: the WIT type expression of `resolved`, written to `out`.
    pub fn ty(inout self, inout lowerer: L, raw_ty: u32, inout out: ChunkSeq[u8]) eff [Fail[WErr]] {
        let resolved = lowerer.ctx.default_ty(raw_ty);
        let key = display_key(inout lowerer, resolved);
        let named = get32(in self.names, key);
        if named != 0 {
            out.push(37);
            lowerer.ctx.write_name(wrapping_sub(named, 1), inout out);
            return;
        }
        if self.is_active(key) {
            Fail::raise(export_err(1));
        }
        self.active.push(key);
        if self.active.len() > 32 {
            Fail::raise(export_err(1));
        }
        let shape = lowerer.ctx.shape(resolved);
        if shape.kind == SH_SCALAR {
            let scalar = shape.scalar;
            if scalar == SC_I64 {
                text(inout out, in "s64".as_bytes());
            } else if scalar == SC_U64 {
                text(inout out, in "u64".as_bytes());
            } else if scalar == SC_U32 {
                text(inout out, in "u32".as_bytes());
            } else if scalar == SC_U8 {
                text(inout out, in "u8".as_bytes());
            } else if scalar == SC_BOOL {
                text(inout out, in "bool".as_bytes());
            } else if scalar == SC_F64 {
                text(inout out, in "f64".as_bytes());
            } else {
                Fail::raise(export_err(2));
            }
        } else if shape.kind == SH_STR {
            text(inout out, in "string".as_bytes());
        } else if shape.kind == SH_TUPLE {
            text(inout out, in "tuple<".as_bytes());
            let n = lowerer.ctx.arity(shape.ty);
            for i in 0..n {
                if i > 0 {
                    text(inout out, in ", ".as_bytes());
                }
                let elem_ty = lowerer.ctx.tuple_elem(shape.ty, i);
                self.ty(inout lowerer, elem_ty, inout out);
            }
            out.push(62);
        } else if shape.kind == SH_STRUCT {
            if lowerer.ctx.field_count(shape, 0) == 0 {
                Fail::raise(export_err(3));
            }
            let mut name = ChunkSeq::new[u8]();
            mangle(in lowerer, resolved, inout name);
            let mut body = ChunkSeq::new[u8]();
            self.fields(inout lowerer, shape, 0, inout body);
            let mut def_text = ChunkSeq::new[u8]();
            text(inout def_text, in "record %".as_bytes());
            text(inout def_text, in name.as_slice());
            text(inout def_text, in " { ".as_bytes());
            text(inout def_text, in body.as_slice());
            text(inout def_text, in " }".as_bytes());
            self.def(in def_text);
            let name_sym = lowerer.ctx.intern(in name);
            set32(inout self.names, key, inc32(name_sym));
            out.push(37);
            text(inout out, in name.as_slice());
        } else if shape.kind == SH_ENUM {
            let mut name = ChunkSeq::new[u8]();
            mangle(in lowerer, resolved, inout name);
            let mut cases = ChunkSeq::new[u8]();
            let n_variants = lowerer.ctx.variant_count(shape);
            for case_index in 0..n_variants {
                if case_index > 0 {
                    text(inout cases, in ", ".as_bytes());
                }
                let variant = lowerer.ctx.variant(shape, case_index);
                let mut case = ChunkSeq::new[u8]();
                ident_sym(in lowerer, variant.name, inout case);
                let n_fields = w(variant.fc);
                cases.push(37);
                text(inout cases, in case.as_slice());
                if n_fields == 0 {
                    continue;
                }
                if variant.named {
                    let mut rec = ChunkSeq::new[u8]();
                    text(inout rec, in name.as_slice());
                    rec.push(45);
                    text(inout rec, in case.as_slice());
                    let mut body = ChunkSeq::new[u8]();
                    self.fields(inout lowerer, shape, case_index, inout body);
                    let mut def_text = ChunkSeq::new[u8]();
                    text(inout def_text, in "record %".as_bytes());
                    text(inout def_text, in rec.as_slice());
                    text(inout def_text, in " { ".as_bytes());
                    text(inout def_text, in body.as_slice());
                    text(inout def_text, in " }".as_bytes());
                    self.def(in def_text);
                    text(inout cases, in "(%".as_bytes());
                    text(inout cases, in rec.as_slice());
                    cases.push(41);
                } else if n_fields == 1 {
                    let (_, field_ty) = lowerer.ctx.variant_field(shape, case_index, 0);
                    cases.push(40);
                    self.ty(inout lowerer, field_ty, inout cases);
                    cases.push(41);
                } else {
                    text(inout cases, in "(tuple<".as_bytes());
                    for i in 0..n_fields {
                        if i > 0 {
                            text(inout cases, in ", ".as_bytes());
                        }
                        let (_, field_ty) = lowerer.ctx.variant_field(shape, case_index, i);
                        self.ty(inout lowerer, field_ty, inout cases);
                    }
                    text(inout cases, in ">)".as_bytes());
                }
            }
            let mut def_text = ChunkSeq::new[u8]();
            text(inout def_text, in "variant %".as_bytes());
            text(inout def_text, in name.as_slice());
            text(inout def_text, in " { ".as_bytes());
            text(inout def_text, in cases.as_slice());
            text(inout def_text, in " }".as_bytes());
            self.def(in def_text);
            let name_sym = lowerer.ctx.intern(in name);
            set32(inout self.names, key, inc32(name_sym));
            out.push(37);
            text(inout out, in name.as_slice());
        } else {
            Fail::raise(export_err(4));
        }
        self.deactivate(key);
    }

    // `Wit::fields`: `%name: type, ...` of variant `variant` of `shape`.
    fn fields(
        inout self,
        inout lowerer: L,
        shape: Shape,
        variant: u64,
        inout out: ChunkSeq[u8]
    ) eff [Fail[WErr]] {
        let mut seen = ChunkSeq::new[u32]();
        let n = lowerer.ctx.field_count(shape, variant);
        for i in 0..n {
            let (fname, field_ty) = lowerer.ctx.variant_field(shape, variant, i);
            let mut field_ident = ChunkSeq::new[u8]();
            ident_sym(in lowerer, fname, inout field_ident);
            let field_sym = lowerer.ctx.intern(in field_ident);
            for j in 0..seen.len() {
                match seen.try_get(j) {
                    Option::Some(seen_sym) => {
                        if seen_sym == field_sym {
                            Fail::raise(export_err(5));
                        }
                    },
                    Option::None => {},
                }
            }
            seen.push(field_sym);
            if i > 0 {
                text(inout out, in ", ".as_bytes());
            }
            out.push(37);
            text(inout out, in field_ident.as_slice());
            text(inout out, in ": ".as_bytes());
            self.ty(inout lowerer, field_ty, inout out);
        }
    }
}

fn inc32(value: u32) -> u32 {
    wrapping_add(value, 1)
}

// ---- canonical ABI -------------------------------------------------------

fn align_to(value: u64, align: u64) -> u64 {
    wrapping_add(value, wrapping_sub(align, 1)) & (wrapping_sub(align, 1) ^ 18446744073709551615)
}

fn max64(lhs: u64, rhs: u64) -> u64 {
    if lhs > rhs { lhs } else { rhs }
}

// The member types of a tuple, of a struct or of variant `variant` of an enum.
fn members(inout lowerer: L, shape: Shape, variant: u64) -> ChunkSeq[u32] {
    let mut tys = ChunkSeq::new[u32]();
    if shape.kind == SH_TUPLE {
        for i in 0..lowerer.ctx.arity(shape.ty) {
            tys.push(lowerer.ctx.tuple_elem(shape.ty, i));
        }
        return tys;
    }
    let n = lowerer.ctx.field_count(shape, variant);
    for i in 0..n {
        let (_, ty) = lowerer.ctx.variant_field(shape, variant, i);
        tys.push(ty);
    }
    tys
}

fn t_at(in tys: ChunkSeq[u32], i: u64) -> u32 {
    match tys.try_get(i) {
        Option::Some(ty) => ty,
        Option::None => NONE32,
    }
}

fn o_at(in offsets: ChunkSeq[u64], i: u64) -> u64 {
    match offsets.try_get(i) {
        Option::Some(offset) => offset,
        Option::None => 0,
    }
}

// `discriminant`: (size, log2 alignment) of a variant's tag.
fn disc_of(cases: u64) -> (u64, u64) {
    if cases <= 256 {
        (1, 0)
    } else if cases <= 65536 {
        (2, 1)
    } else {
        (4, 2)
    }
}

// `size_align`: canonical (size, alignment) of the WIT image of `ty`.
fn size_align(inout lowerer: L, ty: u32) -> (u64, u64) eff [Fail[WErr]] {
    let shape = lowerer.ctx.shape(ty);
    if shape.kind == SH_SCALAR {
        let scalar = shape.scalar;
        if scalar == SC_BOOL || scalar == SC_U8 {
            return (1, 1);
        }
        if scalar == SC_U32 {
            return (4, 4);
        }
        if scalar == SC_I64 || scalar == SC_U64 || scalar == SC_F64 {
            return (8, 8);
        }
        Fail::raise(export_err(6));
    }
    if shape.kind == SH_STR {
        return (8, 4);
    }
    if shape.kind == SH_TUPLE || shape.kind == SH_STRUCT {
        let tys = members(inout lowerer, shape, 0);
        let (layout, _) = record(inout lowerer, in tys);
        return layout;
    }
    if shape.kind == SH_ENUM {
        let n_variants = lowerer.ctx.variant_count(shape);
        let (disc, _) = disc_of(n_variants);
        let mut size: u64 = 0;
        let mut align = disc;
        for case_index in 0..n_variants {
            let tys = members(inout lowerer, shape, case_index);
            let ((case_size, case_align), _) = record(inout lowerer, in tys);
            size = max64(size, case_size);
            align = max64(align, case_align);
        }
        let payload = align_to(disc, align);
        return (align_to(wrapping_add(payload, size), align), align);
    }
    Fail::raise(export_err(7));
    (0, 1)
}

// `record`: ((size, align), field offsets) of a record of `tys`.
fn record(inout lowerer: L, in tys: ChunkSeq[u32]) -> ((u64, u64), ChunkSeq[u64]) eff [Fail[WErr]] {
    let mut offset: u64 = 0;
    let mut align: u64 = 1;
    let mut offsets = ChunkSeq::new[u64]();
    for i in 0..tys.len() {
        let (member_size, member_align) = size_align(inout lowerer, t_at(in tys, i));
        offset = align_to(offset, member_align);
        offsets.push(offset);
        offset = wrapping_add(offset, member_size);
        align = max64(align, member_align);
    }
    ((align_to(offset, align), align), offsets)
}

fn flat_count(inout lowerer: L, ty: u32) -> u64 eff [Fail[WErr]] {
    let shape = lowerer.ctx.shape(ty);
    if shape.kind == SH_SCALAR {
        return 1;
    }
    if shape.kind == SH_STR {
        return 2;
    }
    if shape.kind == SH_TUPLE || shape.kind == SH_STRUCT {
        let tys = members(inout lowerer, shape, 0);
        let mut n: u64 = 0;
        for i in 0..tys.len() {
            n = wrapping_add(n, flat_count(inout lowerer, t_at(in tys, i)));
        }
        return n;
    }
    if shape.kind == SH_ENUM {
        let mut max_flat: u64 = 0;
        for case_index in 0..lowerer.ctx.variant_count(shape) {
            let tys = members(inout lowerer, shape, case_index);
            let mut n: u64 = 0;
            for i in 0..tys.len() {
                n = wrapping_add(n, flat_count(inout lowerer, t_at(in tys, i)));
            }
            max_flat = max64(max_flat, n);
        }
        return wrapping_add(1, max_flat);
    }
    Fail::raise(export_err(8));
    0
}

fn temp(inout locals: ChunkSeq[ValTy], nparams: u64) -> u32 {
    locals.push(vt(VT_I64));
    wrapping_u32(wrapping_sub(wrapping_add(nparams, locals.len()), 1))
}

fn load_field(inout code: Code, from: u32, slot: u64, to: u32) {
    code.get(from);
    code.op(OP_I32_WRAP_I64);
    code.mem(OP_I64_LOAD, 3, slot);
    code.set(to);
}

// `store`: stores of the uniform value in local `value` of type `ty` into the
// canonical layout at `base + offset`.
fn store(
    inout lowerer: L,
    inout code: Code,
    inout locals: ChunkSeq[ValTy],
    nparams: u64,
    base: u32,
    offset: u64,
    value: u32,
    ty: u32
) eff [Fail[WErr]] {
    let shape = lowerer.ctx.shape(ty);
    if shape.kind == SH_SCALAR {
        code.get(base);
        code.op(OP_I32_WRAP_I64);
        code.get(value);
        let scalar = shape.scalar;
        if scalar == SC_BOOL || scalar == SC_U8 {
            code.mem(OP_I64_STORE8, 0, offset);
        } else if scalar == SC_U32 {
            code.mem(OP_I64_STORE32, 2, offset);
        } else {
            code.mem(OP_I64_STORE, 3, offset);
        }
        return;
    }
    if shape.kind == SH_STR {
        code.get(base);
        code.op(OP_I32_WRAP_I64);
        code.get(value);
        code.i64_const(8);
        code.op(OP_I64_ADD);
        code.mem(OP_I64_STORE32, 2, offset);
        code.get(base);
        code.op(OP_I32_WRAP_I64);
        code.get(value);
        code.op(OP_I32_WRAP_I64);
        code.mem(OP_I64_LOAD, 3, 0);
        code.mem(OP_I64_STORE32, 2, wrapping_add(offset, 4));
        return;
    }
    if shape.kind == SH_TUPLE || shape.kind == SH_STRUCT {
        let tys = members(inout lowerer, shape, 0);
        let (_, offsets) = record(inout lowerer, in tys);
        for i in 0..tys.len() {
            let field_local = temp(inout locals, nparams);
            load_field(inout code, value, wrapping_mul(8, i), field_local);
            store(
                inout lowerer,
                inout code,
                inout locals,
                nparams,
                base,
                wrapping_add(offset, o_at(in offsets, i)),
                field_local,
                t_at(in tys, i)
            );
        }
        return;
    }
    if shape.kind == SH_ENUM {
        let (_, align) = size_align(inout lowerer, ty);
        let n_variants = lowerer.ctx.variant_count(shape);
        let (disc, disc_align) = disc_of(n_variants);
        let payload = align_to(disc, align);
        let tag = temp(inout locals, nparams);
        load_field(inout code, value, 0, tag);
        code.get(base);
        code.op(OP_I32_WRAP_I64);
        code.get(tag);
        if disc == 1 {
            code.mem(OP_I64_STORE8, disc_align, offset);
        } else if disc == 2 {
            code.mem(OP_I64_STORE16, disc_align, offset);
        } else {
            code.mem(OP_I64_STORE32, disc_align, offset);
        }
        for case_index in 0..n_variants {
            let tys = members(inout lowerer, shape, case_index);
            if tys.len() == 0 {
                continue;
            }
            let (_, offsets) = record(inout lowerer, in tys);
            code.get(tag);
            code.i64_const(wrapping_i64(case_index));
            code.op(OP_I64_EQ);
            code.open(OP_IF);
            for i in 0..tys.len() {
                let field_local = temp(inout locals, nparams);
                load_field(inout code, value, wrapping_mul(8, wrapping_add(i, 1)), field_local);
                let field_offset = wrapping_add(wrapping_add(offset, payload), o_at(in offsets, i));
                store(
                    inout lowerer,
                    inout code,
                    inout locals,
                    nparams,
                    base,
                    field_offset,
                    field_local,
                    t_at(in tys, i)
                );
            }
            code.op(OP_END);
        }
        return;
    }
    Fail::raise(export_err(9));
}

// `single_leaf`: the load (opcode, alignment) of the only flat value of a
// single-flat type, and its core type.
fn single_leaf(inout lowerer: L, ty: u32) -> (u8, u64, u8) eff [Fail[WErr]] {
    let shape = lowerer.ctx.shape(ty);
    if shape.kind == SH_SCALAR {
        let scalar = shape.scalar;
        if scalar == SC_BOOL || scalar == SC_U8 {
            return (OP_I32_LOAD8_U, 0, VT_I32);
        }
        if scalar == SC_U32 {
            return (OP_I32_LOAD, 2, VT_I32);
        }
        if scalar == SC_F64 {
            return (OP_F64_LOAD, 3, VT_F64);
        }
        return (OP_I64_LOAD, 3, VT_I64);
    }
    if shape.kind == SH_TUPLE && lowerer.ctx.arity(shape.ty) == 1 {
        return single_leaf(inout lowerer, lowerer.ctx.tuple_elem(shape.ty, 0));
    }
    if shape.kind == SH_STRUCT && lowerer.ctx.field_count(shape, 0) == 1 {
        let (_, field_ty) = lowerer.ctx.variant_field(shape, 0, 0);
        return single_leaf(inout lowerer, field_ty);
    }
    if shape.kind == SH_ENUM {
        let (disc_size, _) = disc_of(lowerer.ctx.variant_count(shape));
        if disc_size == 1 {
            return (OP_I32_LOAD8_U, 0, VT_I32);
        }
        if disc_size == 2 {
            return (OP_I32_LOAD16_U, 1, VT_I32);
        }
        return (OP_I32_LOAD, 2, VT_I32);
    }
    Fail::raise(werr(K_INVALID, 0, 10));
    (0, 0, 0)
}

// `core_scalar`: the core type of a scalar, or 0 for Unit and Never.
fn core_scalar(scalar: u8) -> u8 {
    if scalar == SC_I64 || scalar == SC_U64 {
        return VT_I64;
    }
    if scalar == SC_U32 || scalar == SC_U8 || scalar == SC_BOOL {
        return VT_I32;
    }
    if scalar == SC_F64 {
        return VT_F64;
    }
    0
}

fn k_at(in kinds: ChunkSeq[u8], i: u64) -> u8 {
    match kinds.try_get(i) {
        Option::Some(kind) => kind,
        Option::None => 0,
    }
}

// `flatten`: the flat core types of `ty` as a parameter.
fn flatten(inout lowerer: L, ty: u32, inout out: ChunkSeq[u8]) eff [Fail[WErr]] {
    let shape = lowerer.ctx.shape(ty);
    if shape.kind == SH_SCALAR {
        let kind = core_scalar(shape.scalar);
        if kind == 0 {
            Fail::raise(export_err(11));
        }
        out.push(kind);
        return;
    }
    if shape.kind == SH_STR {
        out.push(VT_I32);
        out.push(VT_I32);
        return;
    }
    if shape.kind == SH_TUPLE || shape.kind == SH_STRUCT {
        let tys = members(inout lowerer, shape, 0);
        for i in 0..tys.len() {
            flatten(inout lowerer, t_at(in tys, i), inout out);
        }
        return;
    }
    if shape.kind == SH_ENUM {
        out.push(VT_I32);
        let mut joined = ChunkSeq::new[u8]();
        for case_index in 0..lowerer.ctx.variant_count(shape) {
            let tys = members(inout lowerer, shape, case_index);
            let mut case = ChunkSeq::new[u8]();
            for i in 0..tys.len() {
                flatten(inout lowerer, t_at(in tys, i), inout case);
            }
            for i in 0..case.len() {
                let kind = k_at(in case, i);
                if i >= joined.len() {
                    joined.push(kind);
                } else if k_at(in joined, i) != kind {
                    let ok = joined.try_set(i, VT_I64);
                }
            }
        }
        for i in 0..joined.len() {
            out.push(k_at(in joined, i));
        }
        return;
    }
    Fail::raise(export_err(12));
}

fn has_string(inout lowerer: L, ty: u32) -> bool {
    let shape = handle Fail[WErr] in {
        lowerer.ctx.shape(ty)
    } with {
        return value => value,
        raise(e, resume) => Shape { kind: 255, scalar: 0, adt: NONE32, ty: 0 },
    };
    if shape.kind == SH_STR {
        return true;
    }
    if shape.kind == SH_TUPLE || shape.kind == SH_STRUCT {
        let tys = members(inout lowerer, shape, 0);
        for i in 0..tys.len() {
            if has_string(inout lowerer, t_at(in tys, i)) {
                return true;
            }
        }
        return false;
    }
    if shape.kind == SH_ENUM {
        for case_index in 0..lowerer.ctx.variant_count(shape) {
            let tys = members(inout lowerer, shape, case_index);
            for i in 0..tys.len() {
                if has_string(inout lowerer, t_at(in tys, i)) {
                    return true;
                }
            }
        }
    }
    false
}

fn new_block(
    inout lowerer: L,
    inout code: Code,
    inout locals: ChunkSeq[ValTy],
    nparams: u64,
    slots: u64
) -> u32 {
    let block = temp(inout locals, nparams);
    code.i64_const(wrapping_i64(wrapping_mul(8, slots)));
    code.call(lowerer.alloc);
    code.set(block);
    block
}

fn put(inout code: Code, block: u32, slot: u64, value: u32) {
    code.get(block);
    code.op(OP_I32_WRAP_I64);
    code.get(value);
    code.mem(OP_I64_STORE, 3, wrapping_mul(8, slot));
}

fn next_flat(in flat: ChunkSeq[u32], inout cursor: u64) -> u32 eff [Fail[WErr]] {
    let value = match flat.try_get(cursor) {
        Option::Some(value) => value,
        Option::None => {
            Fail::raise(werr(K_INVALID, 0, 13));
            0
        },
    };
    cursor = wrapping_add(cursor, 1);
    value
}

// `lift`: the uniform value of parameter type `ty` from the 64-bit flat
// values `flat[cursor..]`; returns its local.
fn lift(
    inout lowerer: L,
    inout code: Code,
    inout locals: ChunkSeq[ValTy],
    nparams: u64,
    ty: u32,
    in flat: ChunkSeq[u32],
    inout cursor: u64
) -> u32 eff [Fail[WErr]] {
    let shape = lowerer.ctx.shape(ty);
    if shape.kind == SH_SCALAR {
        let value = next_flat(in flat, inout cursor);
        let scalar = shape.scalar;
        if scalar == SC_U32 || scalar == SC_U8 || scalar == SC_BOOL {
            // A joined variant slot carries the i32 in its low bits.
            code.get(value);
            code.i64_const(LOW32);
            code.op(OP_I64_AND);
            code.set(value);
        }
        return value;
    }
    if shape.kind == SH_STR {
        let ptr = next_flat(in flat, inout cursor);
        let len = next_flat(in flat, inout cursor);
        let block = temp(inout locals, nparams);
        code.get(len);
        code.i64_const(LOW32);
        code.op(OP_I64_AND);
        code.tee(len);
        code.i64_const(8);
        code.op(OP_I64_ADD);
        code.call(lowerer.alloc);
        code.tee(block);
        code.op(OP_I32_WRAP_I64);
        code.get(len);
        code.mem(OP_I64_STORE, 3, 0);
        code.get(block);
        code.op(OP_I32_WRAP_I64);
        code.i32_const(8);
        code.op(OP_I32_ADD);
        code.get(ptr);
        code.op(OP_I32_WRAP_I64);
        code.get(len);
        code.op(OP_I32_WRAP_I64);
        code.memory_copy();
        return block;
    }
    if shape.kind == SH_TUPLE {
        let tys = members(inout lowerer, shape, 0);
        let block = new_block(inout lowerer, inout code, inout locals, nparams, tys.len());
        for i in 0..tys.len() {
            let elem = lift(
                inout lowerer,
                inout code,
                inout locals,
                nparams,
                t_at(in tys, i),
                in flat,
                inout cursor
            );
            put(inout code, block, i, elem);
        }
        return block;
    }
    if shape.kind == SH_STRUCT {
        let tys = members(inout lowerer, shape, 0);
        let mut block: u32 = 0;
        if tys.len() == 0 {
            block = temp(inout locals, nparams);
            code.i64_const(0);
            code.set(block);
        } else {
            block = new_block(inout lowerer, inout code, inout locals, nparams, tys.len());
        }
        for i in 0..tys.len() {
            let elem = lift(
                inout lowerer,
                inout code,
                inout locals,
                nparams,
                t_at(in tys, i),
                in flat,
                inout cursor
            );
            put(inout code, block, i, elem);
        }
        return block;
    }
    if shape.kind == SH_ENUM {
        let disc = next_flat(in flat, inout cursor);
        let n_variants = lowerer.ctx.variant_count(shape);
        let mut width: u64 = 0;
        for variant_index in 0..n_variants {
            let tys = members(inout lowerer, shape, variant_index);
            let mut case = ChunkSeq::new[u8]();
            for i in 0..tys.len() {
                flatten(inout lowerer, t_at(in tys, i), inout case);
            }
            width = max64(width, case.len());
        }
        let out = temp(inout locals, nparams);
        let start = cursor;
        code.get(disc);
        code.i64_const(wrapping_i64(n_variants));
        code.op(OP_I64_GE_U);
        code.open(OP_IF);
        code.op(OP_UNREACHABLE);
        code.op(OP_END);
        for case_index in 0..n_variants {
            code.get(disc);
            code.i64_const(wrapping_i64(case_index));
            code.op(OP_I64_EQ);
            code.open(OP_IF);
            let tys = members(inout lowerer, shape, case_index);
            let block = new_block(
                inout lowerer,
                inout code,
                inout locals,
                nparams,
                wrapping_add(1, tys.len())
            );
            let tag = temp(inout locals, nparams);
            code.i64_const(wrapping_i64(case_index));
            code.set(tag);
            put(inout code, block, 0, tag);
            let mut cur = start;
            for field_index in 0..tys.len() {
                let value = lift(
                    inout lowerer,
                    inout code,
                    inout locals,
                    nparams,
                    t_at(in tys, field_index),
                    in flat,
                    inout cur
                );
                put(inout code, block, wrapping_add(1, field_index), value);
            }
            code.get(block);
            code.set(out);
            code.op(OP_END);
        }
        cursor = wrapping_add(start, width);
        return out;
    }
    Fail::raise(export_err(14));
    0
}

fn vts(in kinds: ChunkSeq[u8]) -> ChunkSeq[ValTy] {
    let mut out = ChunkSeq::new[ValTy]();
    for i in 0..kinds.len() {
        out.push(vt(k_at(in kinds, i)));
    }
    out
}

// `export_realloc`: `cabi_realloc(old, old_size, align, new_size)`.
fn export_realloc(inout lowerer: L) {
    let mut param_tys = ChunkSeq::new[ValTy]();
    for _i in 0..4 {
        param_tys.push(vt(VT_I32));
    }
    let mut result_tys = ChunkSeq::new[ValTy]();
    result_tys.push(vt(VT_I32));
    let func = lowerer.builder.declare(in param_tys, in result_tys);
    let mut code = code_new();
    code.get(3);
    code.op(OP_I64_EXTEND_I32_U);
    code.call(lowerer.alloc);
    code.set(4);
    code.get(0);
    code.open(OP_IF);
    code.get(4);
    code.op(OP_I32_WRAP_I64);
    code.get(0);
    code.get(1);
    code.get(3);
    code.get(1);
    code.get(3);
    code.op(OP_I32_LT_U);
    code.op(OP_SELECT);
    code.memory_copy();
    code.op(OP_END);
    code.get(4);
    code.op(OP_I32_WRAP_I64);
    code.op(OP_END);
    lowerer.builder.define(func, in body_n(1, in code));
    lowerer.builder.export_func(in "cabi_realloc".as_bytes(), func);
}

// `component::exports`: add the export wrappers for the entry and return
// the WIT source.
pub fn exports(inout lowerer: L) -> ChunkSeq[u8] eff [Fail[WErr]] {
    let entry = lowerer.ctx.facts.entry;
    let plugin = lowerer.ctx.facts.plugin;
    let sig = lowerer.ctx.sig(entry);
    if sig.gen_count != 0 {
        Fail::raise(werr(K_ENTRY, 0, 20));
    }
    let mut wit = wit_new();
    let mut params = ChunkSeq::new[u8]();
    let mut core_params = ChunkSeq::new[u8]();
    let mut scalars = ChunkSeq::new[u8]();
    for i in 0..sig.pn {
        let param = lowerer.ctx.facts.param(add(sig.p0, i));
        if param.pass == TyPass::Inout {
            Fail::raise(werr(K_ENTRY, 0, 21));
        }
        if i > 0 {
            text(inout params, in ", ".as_bytes());
        }
        params.push(37);
        ident_sym(in lowerer, param.name, inout params);
        text(inout params, in ": ".as_bytes());
        wit.ty(inout lowerer, param.ty, inout params);
        handle Fail[WErr] in {
            flatten(inout lowerer, param.ty, inout core_params)
        } with {
            return value => value,
            raise(e, resume) => {
                if e.kind == K_UNSUPPORTED {
                    Fail::raise(werr(K_ENTRY, 0, 22));
                }
                Fail::raise(e);
            },
        };
        let param_shape = lowerer.ctx.shape(param.ty);
        if param_shape.kind == SH_SCALAR {
            scalars.push(param_shape.scalar);
        }
    }
    if core_params.len() > 16 {
        Fail::raise(werr(K_ENTRY, 0, 23));
    }
    if plugin && lowerer.plan.host.len() > 0 {
        Fail::raise(werr(K_ENTRY, 0, 24));
    }
    let result = lowerer.ctx.default_ty(sig.result);
    let shape = lowerer.ctx.shape(result);
    let unit = shape.kind == SH_SCALAR && (shape.scalar == SC_UNIT || shape.scalar == SC_NEVER);
    let mut wit_result = ChunkSeq::new[u8]();
    if !unit {
        wit.ty(inout lowerer, result, inout wit_result);
    }
    let mut flat: u64 = 0;
    if !unit {
        flat = flat_count(inout lowerer, result);
    }
    let mut core_result = ChunkSeq::new[u8]();
    if flat == 0 {} else if shape.kind == SH_SCALAR {
        core_result.push(core_scalar(shape.scalar));
    } else if flat == 1 {
        let (_, _, core_ty) = single_leaf(inout lowerer, result);
        core_result.push(core_ty);
    } else {
        core_result.push(VT_I32);
    }
    if plugin {
        let ok = scalars.len() == 2
            && k_at(in scalars, 0) == SC_U32
            && k_at(in scalars, 1) == SC_U64
            && shape.kind == SH_SCALAR
            && shape.scalar == SC_I64;
        if !ok {
            Fail::raise(werr(K_ENTRY, 0, 25));
        }
    }
    // Wrapper: canonical parameters -> uniform values -> entry -> result.
    let nparams = core_params.len();
    let mut locals = ChunkSeq::new[ValTy]();
    let mut code = code_new();
    // (No host capability frames: a program with one is not ported yet.)
    let mut flat_params = ChunkSeq::new[u32]();
    for i in 0..core_params.len() {
        let flat_local = temp(inout locals, nparams);
        code.get(wrapping_u32(i));
        let core_ty = k_at(in core_params, i);
        if core_ty == VT_I32 {
            code.op(OP_I64_EXTEND_I32_U);
        } else if core_ty == VT_F64 {
            code.op(OP_I64_REINTERPRET_F64);
        }
        code.set(flat_local);
        flat_params.push(flat_local);
    }
    let mut cursor: u64 = 0;
    let mut args = ChunkSeq::new[u32]();
    for i in 0..sig.pn {
        let param = lowerer.ctx.facts.param(add(sig.p0, i));
        args.push(lift(
            inout lowerer,
            inout code,
            inout locals,
            nparams,
            param.ty,
            in flat_params,
            inout cursor
        ));
    }
    for i in 0..args.len() {
        match args.try_get(i) {
            Option::Some(arg) => code.get(arg),
            Option::None => {},
        }
    }
    let ret_val = temp(inout locals, nparams);
    code.call(wrapping_sub(get32(in lowerer.funcs, entry), 1));
    code.set(ret_val);
    code.global_get(lowerer.abort);
    code.i64_const(0);
    code.op(OP_I64_NE);
    code.open(OP_IF);
    code.op(OP_UNREACHABLE);
    code.op(OP_END);
    if flat == 0 {} else if shape.kind == SH_SCALAR {
        code.get(ret_val);
        let core_ty = core_scalar(shape.scalar);
        if core_ty == VT_I32 {
            code.op(OP_I32_WRAP_I64);
        } else if core_ty == VT_F64 {
            code.op(OP_F64_REINTERPRET_I64);
        }
    } else {
        let (size, _) = size_align(inout lowerer, result);
        let area = temp(inout locals, nparams);
        code.i64_const(wrapping_i64(size));
        code.call(lowerer.alloc);
        code.set(area);
        store(inout lowerer, inout code, inout locals, nparams, area, 0, ret_val, result);
        code.get(area);
        code.op(OP_I32_WRAP_I64);
        if flat == 1 {
            let (op, align, _) = single_leaf(inout lowerer, result);
            code.mem(op, align, 0);
        }
    }
    code.op(OP_END);
    let wrapper = lowerer.builder.declare(in vts(in core_params), in vts(in core_result));
    lowerer.builder.define(wrapper, in body_each(in locals, in code));
    if plugin {
        lowerer.builder.export_func(in "run".as_bytes(), wrapper);
    } else {
        lowerer.builder.export_func(in "vesper:program/entry@0.1.0#main".as_bytes(), wrapper);
    }
    let mut src = ChunkSeq::new[u8]();
    text(inout src, in "package vesper:program@0.1.0;\n\n".as_bytes());
    if plugin {
        text(inout src, in "world plugin {\n".as_bytes());
        text(inout src, in wit.defs.as_slice());
        text(inout src, in "  export run: func(".as_bytes());
        text(inout src, in params.as_slice());
        src.push(41);
        if !unit {
            text(inout src, in " -> ".as_bytes());
            text(inout src, in wit_result.as_slice());
        }
        text(inout src, in ";\n}\n".as_bytes());
        return src;
    }
    let mut has_str = false;
    for i in 0..sig.pn {
        let param = lowerer.ctx.facts.param(add(sig.p0, i));
        if has_string(inout lowerer, param.ty) {
            has_str = true;
        }
    }
    // The WASI imports return lists through `cabi_realloc` too.
    if has_str || active(in lowerer.host) {
        export_realloc(inout lowerer);
    }
    let mut run = ChunkSeq::new[u8]();
    if sig.pn == 0 {
        // wasi:cli/run: run the entry and report success.
        let mut run_results = ChunkSeq::new[ValTy]();
        run_results.push(vt(VT_I32));
        let none = ChunkSeq::new[ValTy]();
        let run_fn = lowerer.builder.declare(in none, in run_results);
        let mut run_code = code_new();
        run_code.call(wrapper);
        if core_result.len() == 0 {
            run_code.op(OP_NOP);
        } else {
            run_code.op(OP_DROP);
        }
        run_code.i32_const(0);
        run_code.op(OP_END);
        let counts = ChunkSeq::new[u32]();
        let types = ChunkSeq::new[ValTy]();
        lowerer.builder.define(run_fn, in function_bytes(in counts, in types, in run_code));
        lowerer.builder.export_func(in "wasi:cli/run@0.2.0#run".as_bytes(), run_fn);
        text(inout run, in "  export wasi:cli/run@0.2.0;\n".as_bytes());
    }
    text(inout src, in "interface entry {\n".as_bytes());
    text(inout src, in wit.defs.as_slice());
    text(inout src, in "  main: func(".as_bytes());
    text(inout src, in params.as_slice());
    src.push(41);
    if !unit {
        text(inout src, in " -> ".as_bytes());
        text(inout src, in wit_result.as_slice());
    }
    text(inout src, in ";\n}\n\nworld program {\n".as_bytes());
    text(inout src, in wit_imports(in lowerer.host).as_bytes());
    text(inout src, in run.as_slice());
    text(inout src, in "  export entry;\n}\n".as_bytes());
    src
}
