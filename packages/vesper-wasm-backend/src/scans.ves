// The byte scans `find_byte`, `find_either` and `find_not_in` (`SeqOp`
// FindByte, FindEither, FindNotIn in src/seq.rs) on a byte sequence or
// slice: the index of the first matching byte as an `Option[u64]`, total.
// The lexer of @vesper/front uses all three.

use self::err::{WErr, werr};
use self::lower::{L};

// Consts do not cross modules: src/err.ves, src/lower.ves.
const K_UNSUPPORTED: u8 = 0;
// `seq_code`'s codes for `copy_within` / `try_copy_within`, after
// SQ_BYTES_CMP (43) in src/lower.ves.
const SQ_COPY_WITHIN: u64 = 44;
const SQ_TRY_COPY_WITHIN: u64 = 45;
const U_GENERIC_OPERATION: u8 = 5;
const OP_BLOCK: u8 = 2;
const OP_LOOP: u8 = 3;
const OP_IF: u8 = 4;
const OP_ELSE: u8 = 5;
const OP_END: u8 = 11;
const OP_SELECT: u8 = 27;
const OP_I64_EQZ: u8 = 80;
const OP_I64_EQ: u8 = 81;
const OP_I64_LT_U: u8 = 84;
const OP_I64_LE_U: u8 = 88;
const OP_I64_GE_U: u8 = 90;
const OP_I32_AND: u8 = 113;
const OP_I32_OR: u8 = 114;
const OP_I64_ADD: u8 = 124;
const OP_I64_SUB: u8 = 125;
const OP_I64_MUL: u8 = 126;
const OP_I64_AND: u8 = 131;
const OP_I64_SHL: u8 = 134;
const OP_I64_SHR_U: u8 = 136;
const OP_I32_WRAP_I64: u8 = 167;
const OP_I64_EXTEND_I32_U: u8 = 173;
const NONE32: u32 = 4294967295;
// `seq_code` of the three scans (src/lower.ves)
pub fn sq_find_byte() -> u64 {
    36
}

pub fn sq_find_not_in() -> u64 {
    38
}

impl L {
    // `code` over the bytes `base[0..n]` of the operand at `op_pos`, into `dest_val`.
    pub fn find_scan(
        inout self,
        op_pos: u64,
        code: u64,
        base: u32,
        n: u32,
        seq_ty: u32,
        ty: u32,
        dest_val: u64
    ) eff [Fail[WErr]] {
        if self.stride(seq_ty) != 1 {
            Fail::raise(werr(K_UNSUPPORTED, U_GENERIC_OPERATION, 247));
        }
        let arg1 = self.seq_val(op_pos, 1);
        let arg2 = if code == sq_find_byte() {
            NONE32
        } else {
            self.seq_val(op_pos, 2)
        };
        let arg3 = if code == sq_find_not_in() {
            self.seq_val(op_pos, 3)
        } else {
            NONE32
        };
        let dest = self.dest(dest_val);
        let i = self.const_local(0);
        self.cur_fn.code.open(OP_BLOCK);
        self.cur_fn.code.open(OP_LOOP);
        self.cur_fn.code.get(i);
        self.cur_fn.code.get(n);
        self.cur_fn.code.op(OP_I64_GE_U);
        self.cur_fn.code.open(OP_IF);
        self.option_into(dest, ty, NONE32);
        self.cur_fn.code.br(2);
        self.cur_fn.code.op(OP_END);
        let byte_val = self.elem_load(base, i, 1);
        if code == sq_find_byte() {
            self.cur_fn.code.get(byte_val);
            self.cur_fn.code.get(arg1);
            self.cur_fn.code.op(OP_I64_EQ);
        } else if code == sq_find_not_in() {
            // in the class: bit b of lo (b < 64), bit b - 64 of hi
            // (b < 128), else `high`; the scan stops outside it
            self.class_bit(arg1, byte_val);
            self.class_bit(arg2, byte_val);
            self.cur_fn.code.get(arg3);
            self.cur_fn.code.get(byte_val);
            self.cur_fn.code.i64_const(128);
            self.cur_fn.code.op(OP_I64_LT_U);
            self.cur_fn.code.op(OP_SELECT);
            self.cur_fn.code.get(byte_val);
            self.cur_fn.code.i64_const(64);
            self.cur_fn.code.op(OP_I64_LT_U);
            self.cur_fn.code.op(OP_SELECT);
            self.cur_fn.code.op(OP_I64_EQZ);
        } else {
            self.cur_fn.code.get(byte_val);
            self.cur_fn.code.get(arg1);
            self.cur_fn.code.op(OP_I64_EQ);
            self.cur_fn.code.get(byte_val);
            self.cur_fn.code.get(arg2);
            self.cur_fn.code.op(OP_I64_EQ);
            self.cur_fn.code.op(OP_I32_OR);
        }
        self.cur_fn.code.open(OP_IF);
        self.option_into(dest, ty, i);
        self.cur_fn.code.br(2);
        self.cur_fn.code.op(OP_END);
        self.cur_fn.code.get(i);
        self.cur_fn.code.i64_const(1);
        self.cur_fn.code.op(OP_I64_ADD);
        self.cur_fn.code.set(i);
        self.cur_fn.code.br(0);
        self.cur_fn.code.op(OP_END);
        self.cur_fn.code.op(OP_END);
    }

    // `(mask >> (b & 63)) & 1` on the stack.
    fn class_bit(inout self, mask: u32, byte_val: u32) {
        self.cur_fn.code.get(mask);
        self.cur_fn.code.get(byte_val);
        self.cur_fn.code.i64_const(63);
        self.cur_fn.code.op(OP_I64_AND);
        self.cur_fn.code.op(OP_I64_SHR_U);
        self.cur_fn.code.i64_const(1);
        self.cur_fn.code.op(OP_I64_AND);
    }

    // `fill_range` / `try_fill` (`SeqOp::FillRange`).
    pub fn fill_range_seq(
        inout self,
        base: u32,
        n: u32,
        stride: u64,
        lo: u32,
        hi: u32,
        val: u32,
        total: bool,
        dest_val: u64
    ) eff [Fail[WErr]] {
        self.cur_fn.code.get(lo);
        self.cur_fn.code.get(hi);
        self.cur_fn.code.op(OP_I64_LE_U);
        self.cur_fn.code.get(hi);
        self.cur_fn.code.get(n);
        self.cur_fn.code.op(OP_I64_LE_U);
        self.cur_fn.code.op(OP_I32_AND);
        if total {
            let dest = self.dest(dest_val);
            self.cur_fn.code.op(OP_I64_EXTEND_I32_U);
            self.cur_fn.code.tee(dest);
            self.cur_fn.code.op(OP_I32_WRAP_I64);
        }
        self.cur_fn.code.open(OP_IF);
        self.fill_elems(base, lo, hi, stride, val);
        if !total {
            self.cur_fn.code.op(OP_ELSE);
            let oob = self.ctx.syms.index_oob;
            self.raise_runtime_error(oob);
        }
        self.cur_fn.code.op(OP_END);
        if !total {
            self.unit_into(dest_val);
        }
    }

    // `copy_from` / `try_copy_from` (`SeqOp::CopyFrom`).
    pub fn copy_from_seq(
        inout self,
        base: u32,
        n: u32,
        stride: u64,
        at_idx: u32,
        src_addr: u32,
        src_len: u32,
        total: bool,
        dest_val: u64
    ) eff [Fail[WErr]] {
        self.cur_fn.code.get(at_idx);
        self.cur_fn.code.get(n);
        self.cur_fn.code.op(OP_I64_LE_U);
        self.cur_fn.code.get(src_len);
        self.cur_fn.code.get(n);
        self.cur_fn.code.get(at_idx);
        self.cur_fn.code.op(OP_I64_SUB);
        self.cur_fn.code.op(OP_I64_LE_U);
        self.cur_fn.code.op(OP_I32_AND);
        if total {
            let dest = self.dest(dest_val);
            self.cur_fn.code.op(OP_I64_EXTEND_I32_U);
            self.cur_fn.code.tee(dest);
            self.cur_fn.code.op(OP_I32_WRAP_I64);
        }
        self.cur_fn.code.open(OP_IF);
        self.elem_addr(base, at_idx, stride);
        self.cur_fn.code.get(src_addr);
        self.cur_fn.code.op(OP_I32_WRAP_I64);
        self.cur_fn.code.get(src_len);
        if stride == 8 {
            self.cur_fn.code.i64_const(3);
            self.cur_fn.code.op(OP_I64_SHL);
        } else if stride != 1 {
            self.cur_fn.code.u64_const(stride);
            self.cur_fn.code.op(OP_I64_MUL);
        }
        self.cur_fn.code.op(OP_I32_WRAP_I64);
        self.cur_fn.code.memory_copy();
        if !total {
            self.cur_fn.code.op(OP_ELSE);
            let oob = self.ctx.syms.index_oob;
            self.raise_runtime_error(oob);
        }
        self.cur_fn.code.op(OP_END);
        if !total {
            self.unit_into(dest_val);
        }
    }

    // `==` (`!=` when `is_ne`) of byte views or strings, one a view.
    pub fn view_eq(
        inout self,
        lhs: u32,
        lhs_ty: u32,
        rhs: u32,
        rhs_ty: u32,
        is_ne: bool
    ) -> u32 eff [Fail[WErr]] {
        if self.stride(lhs_ty) != 1 || self.stride(rhs_ty) != 1 {
            Fail::raise(werr(K_UNSUPPORTED, U_GENERIC_OPERATION, 235));
        }
        let (lhs_addr, lhs_len) = self.parts(lhs, lhs_ty);
        let (rhs_addr, rhs_len) = self.parts(rhs, rhs_ty);
        let bytes_eq_idx = self.bytes_eq();
        let result = self.local();
        self.cur_fn.code.get(lhs_addr);
        self.cur_fn.code.get(lhs_len);
        self.cur_fn.code.get(rhs_addr);
        self.cur_fn.code.get(rhs_len);
        self.cur_fn.code.call(bytes_eq_idx);
        if is_ne {
            self.cur_fn.code.op(OP_I64_EQZ);
            self.cur_fn.code.op(OP_I64_EXTEND_I32_U);
        }
        self.cur_fn.code.set(result);
        result
    }

    // `seq_code` of `SeqOp::CopyWithin`'s labels, 0 for any other.
    pub fn copy_within_code(in self, label: u32) -> u8 {
        if self.ctx.names.spells(label, in "CopyWithin { total: false }".as_bytes()) {
            wrapping_u8(SQ_COPY_WITHIN)
        } else if self.ctx.names.spells(label, in "CopyWithin { total: true }".as_bytes()) {
            wrapping_u8(SQ_TRY_COPY_WITHIN)
        } else {
            0
        }
    }

    // `copy_within` / `try_copy_within` (`SeqOp::CopyWithin`): the
    // elements `lo..hi` to `at_idx`, which may overlap (`memory.copy` is a
    // memmove), when `lo <= hi <= n` and `hi - lo <= n - at_idx`.
    pub fn copy_within_seq(
        inout self,
        args_at: u64,
        base: u32,
        n: u32,
        stride: u64,
        seq_op: u64,
        dest_val: u64
    ) eff [Fail[WErr]] {
        let lo = self.seq_val(args_at, 1);
        let hi = self.seq_val(args_at, 2);
        let at_idx = self.seq_val(args_at, 3);
        let total = seq_op == SQ_TRY_COPY_WITHIN;
        self.cur_fn.code.get(lo);
        self.cur_fn.code.get(hi);
        self.cur_fn.code.op(OP_I64_LE_U);
        self.cur_fn.code.get(hi);
        self.cur_fn.code.get(n);
        self.cur_fn.code.op(OP_I64_LE_U);
        self.cur_fn.code.op(OP_I32_AND);
        self.cur_fn.code.get(at_idx);
        self.cur_fn.code.get(n);
        self.cur_fn.code.op(OP_I64_LE_U);
        self.cur_fn.code.op(OP_I32_AND);
        // `hi - lo <= n - at_idx`, both sides in range once the rest hold
        self.cur_fn.code.get(hi);
        self.cur_fn.code.get(lo);
        self.cur_fn.code.op(OP_I64_SUB);
        self.cur_fn.code.get(n);
        self.cur_fn.code.get(at_idx);
        self.cur_fn.code.op(OP_I64_SUB);
        self.cur_fn.code.op(OP_I64_LE_U);
        self.cur_fn.code.op(OP_I32_AND);
        if total {
            let dest = self.dest(dest_val);
            self.cur_fn.code.op(OP_I64_EXTEND_I32_U);
            self.cur_fn.code.tee(dest);
            self.cur_fn.code.op(OP_I32_WRAP_I64);
        }
        self.cur_fn.code.open(OP_IF);
        self.elem_addr(base, at_idx, stride);
        self.elem_addr(base, lo, stride);
        self.cur_fn.code.get(hi);
        self.cur_fn.code.get(lo);
        self.cur_fn.code.op(OP_I64_SUB);
        if stride == 8 {
            self.cur_fn.code.i64_const(3);
            self.cur_fn.code.op(OP_I64_SHL);
        } else if stride != 1 {
            self.cur_fn.code.u64_const(stride);
            self.cur_fn.code.op(OP_I64_MUL);
        }
        self.cur_fn.code.op(OP_I32_WRAP_I64);
        self.cur_fn.code.memory_copy();
        if !total {
            self.cur_fn.code.op(OP_ELSE);
            let oob = self.ctx.syms.index_oob;
            self.raise_runtime_error(oob);
        }
        self.cur_fn.code.op(OP_END);
        if !total {
            self.unit_into(dest_val);
        }
    }
}

pub fn copy_within_op(seq_op: u64) -> bool {
    seq_op == SQ_COPY_WITHIN || seq_op == SQ_TRY_COPY_WITHIN
}
