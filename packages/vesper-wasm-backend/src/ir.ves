// The backend's inputs: the Place IR program (@vesper/place-ir) with a
// decoded header per function, and the wasm section the harness appends
// (tests/self_host_wasm_backend.rs `wasm_input`): the options, the world's
// function and effect signatures, the checker's call type arguments and
// the facts the backend reads from closure and handler expressions (the
// pool keeps those expressions on the Rust side).

use @vesper/place-ir::codes::{Lit, Pat};
use @vesper/check-data::util::{add, inc, n32, u32_at, u64_at, w};
use @vesper/check-data::world::{set_by_symbol};
use @vesper/check-data::input::{Ctx, Reader};
use @vesper/place-ir::{Program};

const NONE32: u32 = 4294967295;

pub const PAT_WILD: u64 = Pat::Wild;
pub const PAT_BIND: u64 = Pat::Bind;
pub const PAT_LITERAL: u64 = Pat::Literal;
pub const PAT_TUPLE: u64 = Pat::Tuple;
pub const PAT_CONSTRUCTOR: u64 = Pat::Constructor;
pub const LIT_STRING: u64 = Lit::String;

pub copy struct GenRow {
    name: u32,
    row: bool,
}

pub copy struct ParamRow {
    name: u32,
    pass: u8,
    ty: u32,
}

// An effect instance of a row: label (NONE32 when absent), name and
// arguments `arg_tys[arg_start..arg_start+arg_count]`.
pub copy struct EffInst {
    label: u32,
    name: u32,
    arg_start: u64,
    arg_count: u64,
}

// A function or operation signature.
pub copy struct Sig {
    gen_start: u64,
    gen_count: u64,
    p0: u64,
    pn: u64,
    result: u32,
    eff_start: u64,
    eff_count: u64,
    // the row's tail symbol, or NONE32
    tail: u32,
}

pub copy struct EffDecl {
    name: u32,
    linear: bool,
    // generic names: gen_syms[gen_start..gen_start+gen_count]
    gen_start: u64,
    gen_count: u64,
    // operations: ops[op_start..op_start+op_count]
    op_start: u64,
    op_count: u64,
}

pub copy struct OpDecl {
    name: u32,
    sig: u64,
}

// `world.calls[(s0, s1)]`: pairs[v0..v0+vn].
pub copy struct CallRow {
    s0: u64,
    s1: u64,
    v0: u64,
    vn: u64,
}

pub copy struct Pair {
    name: u32,
    ty: u32,
}

// Expression facts in the backend input's pool rows.
pub enum ExprFactKind: _ {
    None = 0,
    Closure = 1,
    Handler = 2,
}

// A closure records its nested function and free names. A handler records
// its free names and the handler data at `hops[hop_start..]` (see `read_handler`).
pub copy struct ExprFact {
    kind: u64,
    fn_: u32,
    free_start: u64,
    free_count: u64,
    hop_start: u64,
}

pub struct Facts {
    plugin: bool,
    stack_switching: bool,
    max_pages: u64,
    max_functions: u64,
    max_instructions: u64,
    entry: u32,
    trace_active: bool,
    caps: ChunkSeq[u32],
    sigs: ChunkSeq[Sig],
    gens: ChunkSeq[GenRow],
    params: ChunkSeq[ParamRow],
    effs: ChunkSeq[EffInst],
    arg_tys: ChunkSeq[u32],
    // symbol -> sig index + 1
    fn_sig: ChunkSeq[u32],
    decls: ChunkSeq[EffDecl],
    gen_syms: ChunkSeq[u32],
    ops: ChunkSeq[OpDecl],
    // symbol -> decl index + 1
    eff_by_sym: ChunkSeq[u32],
    calls: ChunkSeq[CallRow],
    pairs: ChunkSeq[Pair],
    exprs: ChunkSeq[ExprFact],
    free: ChunkSeq[u32],
    // handler facts and patterns, names as symbols (pattern format of
    // ir_words.rs)
    hops: ChunkSeq[u64],
}

fn sym(in ctx: Ctx, name_index: u64) -> u32 {
    u32_at(in ctx.nmap, name_index)
}

fn opt_sym(in ctx: Ctx, encoded: u64) -> u32 {
    if encoded == 0 {
        NONE32
    } else {
        u32_at(in ctx.nmap, wrapping_sub(encoded, 1))
    }
}

fn tid(in ctx: Ctx, type_index: u64) -> u32 {
    u32_at(in ctx.tmap, type_index)
}

fn read_eff(inout reader: Reader, in input: Slice[u8], in ctx: Ctx, inout facts: Facts) -> EffInst {
    let label = opt_sym(in ctx, reader.word(in input));
    let name = sym(in ctx, reader.word(in input));
    let arg_count = reader.word(in input);
    let arg_start = facts.arg_tys.len();
    for i in 0..arg_count {
        facts.arg_tys.push(tid(in ctx, reader.word(in input)));
    }
    EffInst { label: label, name: name, arg_start: arg_start, arg_count: arg_count }
}

fn read_sig(inout reader: Reader, in input: Slice[u8], in ctx: Ctx, inout facts: Facts) -> u64 {
    let gen_count = reader.word(in input);
    let gen_start = facts.gens.len();
    for i in 0..gen_count {
        let name = sym(in ctx, reader.word(in input));
        let row = reader.word(in input) != 0;
        facts.gens.push(GenRow { name: name, row: row });
    }
    let param_count = reader.word(in input);
    let param_start = facts.params.len();
    for i in 0..param_count {
        let name = sym(in ctx, reader.word(in input));
        let pass = wrapping_u8(reader.word(in input));
        let ty = tid(in ctx, reader.word(in input));
        facts.params.push(ParamRow { name: name, pass: pass, ty: ty });
    }
    let result = tid(in ctx, reader.word(in input));
    let eff_count = reader.word(in input);
    // instances first, into a scratch list: their arguments go to `arg_tys`
    let mut insts = ChunkSeq::new[EffInst]();
    for i in 0..eff_count {
        insts.push(read_eff(inout reader, in input, in ctx, inout facts));
    }
    let eff_start = facts.effs.len();
    for i in 0..eff_count {
        match insts.try_get(i) {
            Option::Some(inst) => facts.effs.push(inst),
            Option::None => {},
        }
    }
    let tail = opt_sym(in ctx, reader.word(in input));
    let sig_index = facts.sigs.len();
    facts.sigs.push(
        Sig {
            gen_start: gen_start,
            gen_count: gen_count,
            p0: param_start,
            pn: param_count,
            result: result,
            eff_start: eff_start,
            eff_count: eff_count,
            tail: tail
        }
    );
    sig_index
}

// A pattern copied into `hops` with its names as symbols.
fn copy_pattern(
    inout reader: Reader,
    in input: Slice[u8],
    in ctx: Ctx,
    inout facts: Facts,
    depth: u64
) {
    let kind = reader.word(in input);
    facts.hops.push(kind);
    facts.hops.push(reader.word(in input));
    facts.hops.push(reader.word(in input));
    if depth > 512 {
        return;
    }
    if kind == Pat::Bind {
        facts.hops.push(w(sym(in ctx, reader.word(in input))));
    } else if kind == Pat::Literal {
        let lit_kind = reader.word(in input);
        facts.hops.push(lit_kind);
        if lit_kind == Lit::String {
            facts.hops.push(w(sym(in ctx, reader.word(in input))));
        } else {
            facts.hops.push(reader.word(in input));
        }
        facts.hops.push(reader.word(in input));
    } else if kind == Pat::Tuple {
        let n = reader.word(in input);
        facts.hops.push(n);
        for i in 0..n {
            copy_pattern(inout reader, in input, in ctx, inout facts, inc(depth));
        }
    } else if kind == Pat::Constructor {
        facts.hops.push(w(sym(in ctx, reader.word(in input))));
        facts.hops.push(reader.word(in input));
        let n = reader.word(in input);
        facts.hops.push(n);
        for i in 0..n {
            facts.hops.push(w(sym(in ctx, reader.word(in input))));
            copy_pattern(inout reader, in input, in ctx, inout facts, inc(depth));
        }
    }
}

fn copy_names(inout reader: Reader, in input: Slice[u8], in ctx: Ctx, inout facts: Facts) {
    let n = reader.word(in input);
    facts.hops.push(n);
    for i in 0..n {
        facts.hops.push(w(sym(in ctx, reader.word(in input))));
    }
}

// A handler's facts into `hops`: the effect (label + 1 or 0, name, n,
// argument types), has state, body function, return function, the
// return clause's patterns (n, patterns) and free names (n, names), then
// n clauses of (name, function, patterns, free names).
fn read_handler(inout reader: Reader, in input: Slice[u8], in ctx: Ctx, inout facts: Facts) {
    let label = reader.word(in input);
    facts.hops.push(
        if label == 0 {
            0
        } else {
            inc(w(sym(in ctx, wrapping_sub(label, 1))))
        }
    );
    facts.hops.push(w(sym(in ctx, reader.word(in input))));
    let n_args = reader.word(in input);
    facts.hops.push(n_args);
    for i in 0..n_args {
        facts.hops.push(w(tid(in ctx, reader.word(in input))));
    }
    facts.hops.push(reader.word(in input));
    facts.hops.push(w(sym(in ctx, reader.word(in input))));
    facts.hops.push(w(sym(in ctx, reader.word(in input))));
    let n_patterns = reader.word(in input);
    facts.hops.push(n_patterns);
    for i in 0..n_patterns {
        copy_pattern(inout reader, in input, in ctx, inout facts, 0);
    }
    copy_names(inout reader, in input, in ctx, inout facts);
    let n_clauses = reader.word(in input);
    facts.hops.push(n_clauses);
    for clause in 0..n_clauses {
        facts.hops.push(w(sym(in ctx, reader.word(in input))));
        facts.hops.push(w(sym(in ctx, reader.word(in input))));
        let n = reader.word(in input);
        facts.hops.push(n);
        for i in 0..n {
            copy_pattern(inout reader, in input, in ctx, inout facts, 0);
        }
        copy_names(inout reader, in input, in ctx, inout facts);
    }
}

fn read_free(inout reader: Reader, in input: Slice[u8], in ctx: Ctx, inout facts: Facts) -> u64 {
    let n = reader.word(in input);
    for i in 0..n {
        facts.free.push(sym(in ctx, reader.word(in input)));
    }
    n
}

// The wasm section, after `read_program`; `pool` is the program's pool
// row count.
pub fn empty_facts(entry: u32, max_pages: u64, max_functions: u64, max_instructions: u64) -> Facts {
    Facts {
        plugin: false,
        stack_switching: false,
        max_pages: max_pages,
        max_functions: max_functions,
        max_instructions: max_instructions,
        entry: entry,
        trace_active: false,
        caps: ChunkSeq::new[u32](),
        sigs: ChunkSeq::new[Sig](),
        gens: ChunkSeq::new[GenRow](),
        params: ChunkSeq::new[ParamRow](),
        effs: ChunkSeq::new[EffInst](),
        arg_tys: ChunkSeq::new[u32](),
        fn_sig: ChunkSeq::new[u32](),
        decls: ChunkSeq::new[EffDecl](),
        gen_syms: ChunkSeq::new[u32](),
        ops: ChunkSeq::new[OpDecl](),
        eff_by_sym: ChunkSeq::new[u32](),
        calls: ChunkSeq::new[CallRow](),
        pairs: ChunkSeq::new[Pair](),
        exprs: ChunkSeq::new[ExprFact](),
        free: ChunkSeq::new[u32](),
        hops: ChunkSeq::new[u64]()
    }
}

pub fn add_fn_sig(
    inout facts: Facts,
    in ctx: Ctx,
    name: u32,
    in gnames: ChunkSeq[u32],
    in grows: ChunkSeq[bool],
    in pnames: ChunkSeq[u32],
    in ppasses: ChunkSeq[u8],
    in ptys: ChunkSeq[u32],
    result: u32,
    effects: u32
) {
    let gen_start = facts.gens.len();
    let gen_count = gnames.len();
    for i in 0..gen_count {
        let gen_name = u32_at(in gnames, i);
        let is_row = match grows.try_get(i) {
            Option::Some(flag) => flag,
            Option::None => false,
        };
        facts.gens.push(GenRow { name: gen_name, row: is_row });
    }
    let param_start = facts.params.len();
    let param_count = pnames.len();
    for i in 0..param_count {
        let param_name = u32_at(in pnames, i);
        let pass = match ppasses.try_get(i) {
            Option::Some(mode) => mode,
            Option::None => 0,
        };
        let ty = u32_at(in ptys, i);
        facts.params.push(ParamRow { name: param_name, pass: pass, ty: ty });
    }
    let eff_start = facts.effs.len();
    let row = ctx.types.row(effects);
    let eff_count = w(row.n);
    for i in 0..eff_count {
        let effect = ctx.types.effect_at(wrapping_add(w(row.a), i));
        let label = if effect.label == 0 {
            NONE32
        } else {
            wrapping_sub(effect.label, 1)
        };
        let arg_start = facts.arg_tys.len();
        for j in 0..w(effect.n) {
            facts.arg_tys.push(u32_at(in ctx.types.items, wrapping_add(w(effect.a), j)));
        }
        facts.effs.push(
            EffInst {
                label: label,
                name: effect.name,
                arg_start: arg_start,
                arg_count: w(effect.n)
            }
        );
    }
    let tail = if row.tail == 0 {
        NONE32
    } else {
        wrapping_sub(row.tail, 1)
    };
    let sig_index = facts.sigs.len();
    facts.sigs.push(
        Sig {
            gen_start: gen_start,
            gen_count: gen_count,
            p0: param_start,
            pn: param_count,
            result: result,
            eff_start: eff_start,
            eff_count: eff_count,
            tail: tail
        }
    );
    set_by_symbol(inout facts.fn_sig, name, n32(inc(sig_index)));
}

pub fn add_eff_decl(
    inout facts: Facts,
    name: u32,
    linear: bool,
    in gnames: ChunkSeq[u32],
    in op_names: ChunkSeq[u32],
    in op_pa: ChunkSeq[u64],
    in op_pn: ChunkSeq[u64],
    in pnames: ChunkSeq[u32],
    in ppasses: ChunkSeq[u8],
    in ptys: ChunkSeq[u32],
    in op_results: ChunkSeq[u32]
) {
    let gen_start = facts.gen_syms.len();
    let gen_count = gnames.len();
    for i in 0..gen_count {
        facts.gen_syms.push(u32_at(in gnames, i));
    }
    let op_start = facts.ops.len();
    let op_count = op_names.len();
    for op_idx in 0..op_count {
        let param_start = match op_pa.try_get(op_idx) {
            Option::Some(value) => value,
            Option::None => 0,
        };
        let param_count = match op_pn.try_get(op_idx) {
            Option::Some(value) => value,
            Option::None => 0,
        };
        let first_param = facts.params.len();
        for param_offset in 0..param_count {
            let param_index = wrapping_add(param_start, param_offset);
            let pass = match ppasses.try_get(param_index) {
                Option::Some(mode) => mode,
                Option::None => 0,
            };
            facts.params.push(
                ParamRow {
                    name: u32_at(in pnames, param_index),
                    pass: pass,
                    ty: u32_at(in ptys, param_index)
                }
            );
        }
        let sig_index = facts.sigs.len();
        facts.sigs.push(
            Sig {
                gen_start: 0,
                gen_count: 0,
                p0: first_param,
                pn: param_count,
                result: u32_at(in op_results, op_idx),
                eff_start: 0,
                eff_count: 0,
                tail: NONE32
            }
        );
        facts.ops.push(OpDecl { name: u32_at(in op_names, op_idx), sig: sig_index });
    }
    let decl_index = facts.decls.len();
    facts.decls.push(
        EffDecl {
            name: name,
            linear: linear,
            gen_start: gen_start,
            gen_count: gen_count,
            op_start: op_start,
            op_count: op_count
        }
    );
    set_by_symbol(inout facts.eff_by_sym, name, n32(inc(decl_index)));
}

pub fn push_hop(inout facts: Facts, word_val: u64) {
    facts.hops.push(word_val);
}

pub fn set_expr_handler(
    inout facts: Facts,
    pool: u64,
    hop_start: u64,
    in free_names: ChunkSeq[u32]
) {
    let free_start = facts.free.len();
    let free_count = free_names.len();
    for i in 0..free_count {
        facts.free.push(u32_at(in free_names, i));
    }
    loop {
        if facts.exprs.len() > pool {
            break;
        }
        facts.exprs.push(ExprFact { kind: 0, fn_: 0, free_start: 0, free_count: 0, hop_start: 0 });
    }
    facts.exprs.try_set(
        pool,
        ExprFact {
            kind: 2,
            fn_: 0,
            free_start: free_start,
            free_count: free_count,
            hop_start: hop_start
        }
    );
}

pub fn read_facts(inout reader: Reader, in input: Slice[u8], in ctx: Ctx, pool: u64) -> Facts {
    let mut f = Facts {
        plugin: false,
        stack_switching: false,
        max_pages: 0,
        max_functions: 0,
        max_instructions: 0,
        entry: 0,
        trace_active: false,
        caps: ChunkSeq::new[u32](),
        sigs: ChunkSeq::new[Sig](),
        gens: ChunkSeq::new[GenRow](),
        params: ChunkSeq::new[ParamRow](),
        effs: ChunkSeq::new[EffInst](),
        arg_tys: ChunkSeq::new[u32](),
        fn_sig: ChunkSeq::new[u32](),
        decls: ChunkSeq::new[EffDecl](),
        gen_syms: ChunkSeq::new[u32](),
        ops: ChunkSeq::new[OpDecl](),
        eff_by_sym: ChunkSeq::new[u32](),
        calls: ChunkSeq::new[CallRow](),
        pairs: ChunkSeq::new[Pair](),
        exprs: ChunkSeq::new[ExprFact](),
        free: ChunkSeq::new[u32](),
        hops: ChunkSeq::new[u64](),
    };
    f.plugin = reader.word(in input) == 1;
    f.stack_switching = reader.word(in input) != 0;
    f.max_pages = reader.word(in input);
    f.max_functions = reader.word(in input);
    f.max_instructions = reader.word(in input);
    f.entry = sym(in ctx, reader.word(in input));
    f.trace_active = reader.word(in input) != 0;
    let ncaps = reader.word(in input);
    for i in 0..ncaps {
        f.caps.push(sym(in ctx, reader.word(in input)));
    }
    let n_fns = reader.word(in input);
    for i in 0..n_fns {
        let name = sym(in ctx, reader.word(in input));
        let sig_index = read_sig(inout reader, in input, in ctx, inout f);
        set_by_symbol(inout f.fn_sig, name, n32(inc(sig_index)));
    }
    let n_effects = reader.word(in input);
    for i in 0..n_effects {
        let name = sym(in ctx, reader.word(in input));
        let linear = reader.word(in input) != 0;
        let gen_count = reader.word(in input);
        let gen_start = f.gen_syms.len();
        for k in 0..gen_count {
            f.gen_syms.push(sym(in ctx, reader.word(in input)));
        }
        let op_count = reader.word(in input);
        // signatures first (they append to the shared tables)
        let mut names = ChunkSeq::new[u32]();
        let mut sigs = ChunkSeq::new[u64]();
        for k in 0..op_count {
            names.push(sym(in ctx, reader.word(in input)));
            sigs.push(read_sig(inout reader, in input, in ctx, inout f));
        }
        let op_start = f.ops.len();
        for k in 0..op_count {
            f.ops.push(OpDecl { name: u32_at(in names, k), sig: u64_at(in sigs, k) });
        }
        let decl_index = f.decls.len();
        f.decls.push(
            EffDecl {
                name: name,
                linear: linear,
                gen_start: gen_start,
                gen_count: gen_count,
                op_start: op_start,
                op_count: op_count
            }
        );
        set_by_symbol(inout f.eff_by_sym, name, n32(inc(decl_index)));
    }
    let ncalls = reader.word(in input);
    for i in 0..ncalls {
        let s0 = reader.word(in input);
        let s1 = reader.word(in input);
        let n_pairs = reader.word(in input);
        let pair_start = f.pairs.len();
        for j in 0..n_pairs {
            let name = sym(in ctx, reader.word(in input));
            let ty = tid(in ctx, reader.word(in input));
            f.pairs.push(Pair { name: name, ty: ty });
        }
        f.calls.push(CallRow { s0: s0, s1: s1, v0: pair_start, vn: n_pairs });
    }
    for i in 0..pool {
        let kind = reader.word(in input);
        let mut fact = ExprFact {
            kind: kind,
            fn_: 0,
            free_start: f.free.len(),
            free_count: 0,
            hop_start: f.hops.len()
        };
        if kind == ExprFactKind::Closure {
            fact.fn_ = sym(in ctx, reader.word(in input));
            fact.free_start = f.free.len();
            fact.free_count = read_free(inout reader, in input, in ctx, inout f);
        } else if kind == ExprFactKind::Handler {
            fact.free_start = f.free.len();
            fact.free_count = read_free(inout reader, in input, in ctx, inout f);
            fact.hop_start = f.hops.len();
            read_handler(inout reader, in input, in ctx, inout f);
        }
        f.exprs.push(fact);
    }
    f
}

impl Facts {
    pub fn sig(in self, i: u64) -> Sig {
        match self.sigs.try_get(i) {
            Option::Some(s) => s,
            Option::None => Sig {
                gen_start: 0,
                gen_count: 0,
                p0: 0,
                pn: 0,
                result: 0,
                eff_start: 0,
                eff_count: 0,
                tail: NONE32
            },
        }
    }

    // `world.functions.get(name)`: a sig index + 1, or 0.
    pub fn fn_sig_of(in self, name: u32) -> u64 {
        w(u32_at(in self.fn_sig, w(name)))
    }

    pub fn gen(in self, i: u64) -> GenRow {
        match self.gens.try_get(i) {
            Option::Some(g) => g,
            Option::None => GenRow { name: 0, row: false },
        }
    }

    pub fn param(in self, i: u64) -> ParamRow {
        match self.params.try_get(i) {
            Option::Some(p) => p,
            Option::None => ParamRow { name: 0, pass: 0, ty: 0 },
        }
    }

    pub fn eff(in self, i: u64) -> EffInst {
        match self.effs.try_get(i) {
            Option::Some(e) => e,
            Option::None => EffInst { label: NONE32, name: 0, arg_start: 0, arg_count: 0 },
        }
    }

    pub fn ty_at(in self, i: u64) -> u32 {
        u32_at(in self.arg_tys, i)
    }

    // `world.effects.get(name)`: a decl index + 1, or 0.
    pub fn decl_of(in self, name: u32) -> u64 {
        w(u32_at(in self.eff_by_sym, w(name)))
    }

    pub fn decl(in self, i: u64) -> EffDecl {
        match self.decls.try_get(i) {
            Option::Some(d) => d,
            Option::None => EffDecl {
                name: 0,
                linear: false,
                gen_start: 0,
                gen_count: 0,
                op_start: 0,
                op_count: 0
            },
        }
    }

    pub fn op(in self, i: u64) -> OpDecl {
        match self.ops.try_get(i) {
            Option::Some(o) => o,
            Option::None => OpDecl { name: 0, sig: 0 },
        }
    }

    pub fn is_capability(in self, name: u32) -> bool {
        for i in 0..self.caps.len() {
            if u32_at(in self.caps, i) == name {
                return true;
            }
        }
        false
    }

    // The call row of span (s0, s1), or the row count.
    pub fn call_at(in self, s0: u64, s1: u64) -> u64 {
        let mut lo: u64 = 0;
        let mut hi = self.calls.len();
        loop {
            if lo >= hi {
                break;
            }
            let mid = wrapping_add(lo, wrapping_sub(hi, lo) / 2);
            let row = self.call(mid);
            if row.s0 < s0 || (row.s0 == s0 && row.s1 < s1) {
                lo = inc(mid);
            } else {
                hi = mid;
            }
        }
        let row = self.call(lo);
        if lo < self.calls.len() && row.s0 == s0 && row.s1 == s1 {
            lo
        } else {
            self.calls.len()
        }
    }

    pub fn call(in self, i: u64) -> CallRow {
        match self.calls.try_get(i) {
            Option::Some(c) => c,
            Option::None => CallRow { s0: 0, s1: 0, v0: 0, vn: 0 },
        }
    }

    pub fn pair(in self, i: u64) -> Pair {
        match self.pairs.try_get(i) {
            Option::Some(p) => p,
            Option::None => Pair { name: 0, ty: 0 },
        }
    }

    pub fn expr(in self, i: u64) -> ExprFact {
        match self.exprs.try_get(i) {
            Option::Some(e) => e,
            Option::None => ExprFact {
                kind: ExprFactKind::None,
                fn_: 0,
                free_start: 0,
                free_count: 0,
                hop_start: 0
            },
        }
    }

    pub fn free_at(in self, i: u64) -> u32 {
        u32_at(in self.free, i)
    }
}

// ----- function headers ---------------------------------------------------------

// A function's decoded header (ops of place-ir `FnRow.ha..`): params
// `fn_params[p0..]`, result, effects, locals `fn_locals[local_start..]` (in name order,
// as the Rust `BTreeMap` iterates), and the value types: `value_tys[value_start + id]`
// for value ids below `value_count` (NONE32 where a value has no type).
pub copy struct FnInfo {
    name: u32,
    p0: u64,
    pn: u64,
    result: u32,
    effects: u32,
    local_start: u64,
    local_count: u64,
    value_start: u64,
    value_count: u64,
}

pub copy struct IrParam {
    name: u32,
    pass: u8,
    ty: u32,
}

pub copy struct IrLocal {
    name: u32,
    ty: u32,
}

pub struct Ir {
    program: Program,
    fns: ChunkSeq[FnInfo],
    fn_params: ChunkSeq[IrParam],
    fn_locals: ChunkSeq[IrLocal],
    value_tys: ChunkSeq[u32],
    // symbol -> function index + 1
    by_name: ChunkSeq[u32],
}

fn op_at(in program: Program, i: u64) -> u64 {
    u64_at(in program.ops, i)
}

pub fn ir_new(sink program: Program) -> Ir {
    let mut ir = Ir {
        program: program,
        fns: ChunkSeq::new[FnInfo](),
        fn_params: ChunkSeq::new[IrParam](),
        fn_locals: ChunkSeq::new[IrLocal](),
        value_tys: ChunkSeq::new[u32](),
        by_name: ChunkSeq::new[u32](),
    };
    for fn_index in 0..ir.program.fns.len() {
        let row = ir.program.function(fn_index);
        let mut pos = row.ha;
        let n_params = op_at(in ir.program, pos);
        pos = inc(pos);
        let param_start = ir.fn_params.len();
        for i in 0..n_params {
            let name = n32(op_at(in ir.program, pos));
            let pass = wrapping_u8(op_at(in ir.program, inc(pos)));
            let n_paths = op_at(in ir.program, add(pos, 2));
            pos = add(pos, add(3, n_paths));
            let ty = n32(op_at(in ir.program, pos));
            pos = add(pos, 3);
            ir.fn_params.push(IrParam { name: name, pass: pass, ty: ty });
        }
        let result = n32(op_at(in ir.program, pos));
        let effects = n32(op_at(in ir.program, inc(pos)));
        pos = add(pos, 2);
        let n_bounds = op_at(in ir.program, pos);
        pos = add(pos, add(1, wrapping_mul(n_bounds, 2)));
        let n_names = op_at(in ir.program, pos);
        pos = add(pos, add(1, n_names));
        let n_values = op_at(in ir.program, pos);
        pos = inc(pos);
        // the largest value id fixes the table's size
        let mut top: u64 = 0;
        for i in 0..n_values {
            let value = op_at(in ir.program, add(pos, wrapping_mul(i, 2)));
            if inc(value) > top {
                top = inc(value);
            }
        }
        let value_start = ir.value_tys.len();
        for i in 0..top {
            ir.value_tys.push(NONE32);
        }
        for i in 0..n_values {
            let value = op_at(in ir.program, add(pos, wrapping_mul(i, 2)));
            let value_ty = n32(op_at(in ir.program, add(pos, inc(wrapping_mul(i, 2)))));
            let ok = ir.value_tys.try_set(add(value_start, value), value_ty);
        }
        pos = add(pos, wrapping_mul(n_values, 2));
        let n_locals = op_at(in ir.program, pos);
        pos = inc(pos);
        let local_start = ir.fn_locals.len();
        for i in 0..n_locals {
            ir.fn_locals.push(
                IrLocal {
                    name: n32(op_at(in ir.program, add(pos, wrapping_mul(i, 2)))),
                    ty: n32(op_at(in ir.program, add(pos, inc(wrapping_mul(i, 2)))))
                }
            );
        }
        ir.fns.push(
            FnInfo {
                name: row.name,
                p0: param_start,
                pn: n_params,
                result: result,
                effects: effects,
                local_start: local_start,
                local_count: n_locals,
                value_start: value_start,
                value_count: top
            }
        );
        set_by_symbol(inout ir.by_name, row.name, n32(inc(fn_index)));
    }
    ir
}

impl Ir {
    // The function named `name`: an index + 1, or 0.
    pub fn find(in self, name: u32) -> u64 {
        w(u32_at(in self.by_name, w(name)))
    }

    pub fn info(in self, i: u64) -> FnInfo {
        match self.fns.try_get(i) {
            Option::Some(f) => f,
            Option::None => FnInfo {
                name: 0,
                p0: 0,
                pn: 0,
                result: 0,
                effects: 0,
                local_start: 0,
                local_count: 0,
                value_start: 0,
                value_count: 0
            },
        }
    }

    pub fn param(in self, i: u64) -> IrParam {
        match self.fn_params.try_get(i) {
            Option::Some(p) => p,
            Option::None => IrParam { name: 0, pass: 0, ty: 0 },
        }
    }

    pub fn local(in self, i: u64) -> IrLocal {
        match self.fn_locals.try_get(i) {
            Option::Some(l) => l,
            Option::None => IrLocal { name: 0, ty: 0 },
        }
    }

    // The type of value `value` of function `func`, or NONE32.
    pub fn value_type(in self, func: FnInfo, value: u64) -> u32 {
        if value >= func.value_count {
            return NONE32;
        }
        u32_at(in self.value_tys, add(func.value_start, value))
    }

    // The type of local `name` of function `func`, or NONE32.
    pub fn local_type(in self, func: FnInfo, name: u32) -> u32 {
        for i in 0..func.local_count {
            let local = self.local(add(func.local_start, i));
            if local.name == name {
                return local.ty;
            }
        }
        NONE32
    }

    pub fn has_local(in self, func: FnInfo, name: u32) -> bool {
        for i in 0..func.local_count {
            if self.local(add(func.local_start, i)).name == name {
                return true;
            }
        }
        false
    }

    pub fn word(in self, i: u64) -> u64 {
        u64_at(in self.program.ops, i)
    }

    // Block `block_index` of function `fn_index`'s block parameters: (first op, count).
    pub fn block_params(in self, fn_index: u64, block_index: u64) -> (u64, u64) {
        let row = self.program.function(fn_index);
        let block = self.program.block(add(row.b0, block_index));
        // entry token, ni, ni x (block, token), outgoing token, np, values
        let ni = self.word(inc(block.ha));
        let outgoing_at = add(add(block.ha, 2), wrapping_mul(ni, 2));
        let np_at = inc(outgoing_at);
        (inc(np_at), self.word(np_at))
    }
}

// The index just past the pattern at `ops[at]` (ir_words.rs layout).
pub fn pattern_end(in ops: ChunkSeq[u64], at: u64, depth: u64) -> u64 {
    let kind = u64_at(in ops, at);
    let mut end = add(at, 3);
    if depth > 512 {
        return end;
    }
    if kind == Pat::Bind {
        end = inc(end);
    } else if kind == Pat::Literal {
        end = add(end, 3);
    } else if kind == Pat::Tuple {
        let n = u64_at(in ops, end);
        end = inc(end);
        for k in 0..n {
            end = pattern_end(in ops, end, inc(depth));
        }
    } else if kind == Pat::Constructor {
        let n = u64_at(in ops, add(end, 2));
        end = add(end, 3);
        for k in 0..n {
            end = pattern_end(in ops, inc(end), inc(depth));
        }
    }
    end
}
