// The `$fmod` helper body for @vesper/wasm-backend (split from lower.ves,
// which reached the parser's token limit).

use self::enc::{Code};

const OP_BLOCK: u8 = 2;
const OP_LOOP: u8 = 3;
const OP_IF: u8 = 4;
const OP_ELSE: u8 = 5;
const OP_END: u8 = 11;
const OP_RETURN: u8 = 15;
const OP_I64_EQZ: u8 = 80;
const OP_I64_EQ: u8 = 81;
const OP_I64_GT_S: u8 = 85;
const OP_I64_GT_U: u8 = 86;
const OP_I64_LE_S: u8 = 87;
const OP_I64_LE_U: u8 = 88;
const OP_I64_GE_S: u8 = 89;
const OP_I32_OR: u8 = 114;
const OP_I64_CLZ: u8 = 121;
const OP_I64_ADD: u8 = 124;
const OP_I64_SUB: u8 = 125;
const OP_I64_AND: u8 = 131;
const OP_I64_OR: u8 = 132;
const OP_I64_SHL: u8 = 134;
const OP_I64_SHR_U: u8 = 136;
const OP_F64_MUL: u8 = 162;
const OP_F64_DIV: u8 = 163;
const OP_I64_REINTERPRET_F64: u8 = 189;
const OP_F64_REINTERPRET_I64: u8 = 191;

// The `$fmod` body: musl's integer `fmod`, instruction for instruction as
// `Lowerer::fmod` in src/wasm_backend/lower.rs.
const FM_ABS: i64 = 9223372036854775807;
const FM_INF: i64 = 9218868437227405312;
const FM_MANT: i64 = 4503599627370495;
const FM_HIDDEN: i64 = 4503599627370496;

fn fmod_zero_times_x(inout code: Code) {
    code.f64_const(0);
    code.get(7);
    code.op(OP_F64_REINTERPRET_I64);
    code.op(OP_F64_MUL);
    code.op(OP_I64_REINTERPRET_F64);
    code.op(OP_RETURN);
}

fn fmod_exp(inout code: Code, bits_local: u32, exp_local: u32) {
    code.get(bits_local);
    code.i64_const(52);
    code.op(OP_I64_SHR_U);
    code.i64_const(2047);
    code.op(OP_I64_AND);
    code.set(exp_local);
}

fn fmod_shl1(inout code: Code, bits_local: u32) {
    code.get(bits_local);
    code.i64_const(1);
    code.op(OP_I64_SHL);
}

fn fmod_normalize(inout code: Code, bits_local: u32, exp_local: u32) {
    code.get(exp_local);
    code.op(OP_I64_EQZ);
    code.open(OP_IF);
    code.get(bits_local);
    code.i64_const(12);
    code.op(OP_I64_SHL);
    code.op(OP_I64_CLZ);
    code.set(6);
    code.i64_const(0);
    code.get(6);
    code.op(OP_I64_SUB);
    code.set(exp_local);
    code.get(bits_local);
    code.get(6);
    code.i64_const(1);
    code.op(OP_I64_ADD);
    code.op(OP_I64_SHL);
    code.set(bits_local);
    code.op(OP_ELSE);
    code.get(bits_local);
    code.i64_const(FM_MANT);
    code.op(OP_I64_AND);
    code.i64_const(FM_HIDDEN);
    code.op(OP_I64_OR);
    code.set(bits_local);
    code.op(OP_END);
}

fn fmod_step(inout code: Code) {
    code.get(0);
    code.get(1);
    code.op(OP_I64_SUB);
    code.tee(5);
    code.i64_const(0);
    code.op(OP_I64_GE_S);
    code.open(OP_IF);
    code.get(5);
    code.op(OP_I64_EQZ);
    code.open(OP_IF);
    fmod_zero_times_x(inout code);
    code.op(OP_END);
    code.get(5);
    code.set(0);
    code.op(OP_END);
}

pub fn fmod_code(inout code: Code) {
    code.get(0);
    code.set(7);
    fmod_exp(inout code, 0, 2);
    fmod_exp(inout code, 1, 3);
    code.get(0);
    code.i64_const(63);
    code.op(OP_I64_SHR_U);
    code.set(4);
    // y == ±0, y is NaN or x is not finite: NaN.
    fmod_shl1(inout code, 1);
    code.op(OP_I64_EQZ);
    code.get(1);
    code.i64_const(FM_ABS);
    code.op(OP_I64_AND);
    code.i64_const(FM_INF);
    code.op(OP_I64_GT_U);
    code.op(OP_I32_OR);
    code.get(2);
    code.i64_const(2047);
    code.op(OP_I64_EQ);
    code.op(OP_I32_OR);
    code.open(OP_IF);
    for _k in 0..2 {
        code.get(0);
        code.op(OP_F64_REINTERPRET_I64);
        code.get(1);
        code.op(OP_F64_REINTERPRET_I64);
        code.op(OP_F64_MUL);
    }
    code.op(OP_F64_DIV);
    code.op(OP_I64_REINTERPRET_F64);
    code.op(OP_RETURN);
    code.op(OP_END);
    // |x| <= |y|
    fmod_shl1(inout code, 0);
    fmod_shl1(inout code, 1);
    code.op(OP_I64_LE_U);
    code.open(OP_IF);
    fmod_shl1(inout code, 0);
    fmod_shl1(inout code, 1);
    code.op(OP_I64_EQ);
    code.open(OP_IF);
    fmod_zero_times_x(inout code);
    code.op(OP_END);
    code.get(0);
    code.op(OP_RETURN);
    code.op(OP_END);
    fmod_normalize(inout code, 0, 2);
    fmod_normalize(inout code, 1, 3);
    code.open(OP_BLOCK);
    code.open(OP_LOOP);
    code.get(2);
    code.get(3);
    code.op(OP_I64_LE_S);
    code.br_if(1);
    fmod_step(inout code);
    fmod_shl1(inout code, 0);
    code.set(0);
    code.get(2);
    code.i64_const(1);
    code.op(OP_I64_SUB);
    code.set(2);
    code.br(0);
    code.op(OP_END);
    code.op(OP_END);
    fmod_step(inout code);
    // Renormalize: shift the leading bit back to bit 52.
    code.get(0);
    code.op(OP_I64_CLZ);
    code.i64_const(11);
    code.op(OP_I64_SUB);
    code.set(6);
    code.get(0);
    code.get(6);
    code.op(OP_I64_SHL);
    code.set(0);
    code.get(2);
    code.get(6);
    code.op(OP_I64_SUB);
    code.set(2);
    code.get(2);
    code.i64_const(0);
    code.op(OP_I64_GT_S);
    code.open(OP_IF);
    code.get(0);
    code.i64_const(FM_HIDDEN);
    code.op(OP_I64_SUB);
    code.get(2);
    code.i64_const(52);
    code.op(OP_I64_SHL);
    code.op(OP_I64_OR);
    code.set(0);
    code.op(OP_ELSE);
    code.get(0);
    code.i64_const(1);
    code.get(2);
    code.op(OP_I64_SUB);
    code.op(OP_I64_SHR_U);
    code.set(0);
    code.op(OP_END);
    code.get(0);
    code.get(4);
    code.i64_const(63);
    code.op(OP_I64_SHL);
    code.op(OP_I64_OR);
    code.op(OP_END);
}
