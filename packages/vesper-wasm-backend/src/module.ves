// Core module assembly (src/wasm_backend/module.rs): type, import,
// function, table, memory, tag, global, export, element, code and data
// sections in the order the binary format requires, written byte for
// byte as wasm-encoder writes them.

use self::enc::{Code, ValTy, append, put_bytes, put_valtype, sleb, uleb, uleb_size, vt};
use self::err::{WErr, werr};

// `err::K_INVALID` (constants cannot be imported yet).
const K_INVALID: u8 = 3;
const NONE32: u32 = 4294967295;
// First byte of static data (string literals); the heap follows it
// (`module::DATA_START`).
pub const DATA_START: u64 = 16;
const PAGE_BYTES: u64 = 65536;

// Shared with enc.ves's instruction and value type encodings.
const VT_I64: u8 = 126;
const OP_I32_CONST: u8 = 65;
const OP_I64_CONST: u8 = 66;
const OP_END: u8 = 11;

const TYPE_FUNC: u8 = 96;
const TYPE_CONT: u8 = 93;
const TYPE_FUNCREF: u8 = 112;
const IMPORT_FUNC: u8 = 0;
const LIMITS_WITH_MAX: u8 = 1;
const TAG_EXCEPTION: u8 = 0;
const GLOBAL_MUTABLE: u8 = 1;
const ELEM_ACTIVE_EXPLICIT_TABLE: u8 = 2;
const ELEM_DECLARATIVE: u8 = 3;
const ELEM_KIND_FUNCREF: u8 = 0;
const DATA_ACTIVE_DEFAULT_MEMORY: u8 = 0;

const TD_FUNC: u8 = 0;
const TD_CONT: u8 = 1;

// Section ids.
const S_TYPE: u8 = 1;
const S_IMPORT: u8 = 2;
const S_FUNCTION: u8 = 3;
const S_TABLE: u8 = 4;
const S_MEMORY: u8 = 5;
const S_GLOBAL: u8 = 6;
const S_EXPORT: u8 = 7;
const S_ELEMENT: u8 = 9;
const S_CODE: u8 = 10;
const S_DATA: u8 = 11;
const S_TAG: u8 = 13;

// Export kinds.
pub const EXPORT_FUNC: u8 = 0;
pub const EXPORT_MEMORY: u8 = 2;

// A type definition: a function type (`vals[p0..p0+pn]` params, then
// `rn` results) or a continuation type over function type `func`.
pub copy struct TypeDef {
    kind: u8,
    p0: u64,
    pn: u64,
    rn: u64,
    func: u32,
}

pub copy struct ImportRow {
    // module and name: text[m0..m0+mn], text[n0..n0+nn]
    m0: u64,
    mn: u64,
    n0: u64,
    nn: u64,
    ty: u32,
}

pub copy struct FuncRow {
    ty: u32,
    // body bytes: bodies[b0..b0+bn]; `defined` once given
    b0: u64,
    bn: u64,
    defined: bool,
}

pub copy struct ExportRow {
    n0: u64,
    nn: u64,
    kind: u8,
    index: u32,
}

// An append-only builder: every index it returns stays valid.
pub struct Builder {
    imports: ChunkSeq[ImportRow],
    data: ChunkSeq[u8],
    heap_global: u32,
    types: ChunkSeq[TypeDef],
    vals: ChunkSeq[ValTy],
    funcs: ChunkSeq[FuncRow],
    bodies: ChunkSeq[u8],
    globals: ChunkSeq[i64],
    table: ChunkSeq[u32],
    declared: ChunkSeq[u32],
    tags: ChunkSeq[u32],
    exports: ChunkSeq[ExportRow],
    text: ChunkSeq[u8],
}

pub fn builder_new() -> Builder {
    Builder {
        imports: ChunkSeq::new[ImportRow](),
        data: ChunkSeq::new[u8](),
        heap_global: NONE32,
        types: ChunkSeq::new[TypeDef](),
        vals: ChunkSeq::new[ValTy](),
        funcs: ChunkSeq::new[FuncRow](),
        bodies: ChunkSeq::new[u8](),
        globals: ChunkSeq::new[i64](),
        table: ChunkSeq::new[u32](),
        declared: ChunkSeq::new[u32](),
        tags: ChunkSeq::new[u32](),
        exports: ChunkSeq::new[ExportRow](),
        text: ChunkSeq::new[u8](),
    }
}

fn val_at(in vals: ChunkSeq[ValTy], i: u64) -> ValTy {
    match vals.try_get(i) {
        Option::Some(val) => val,
        Option::None => vt(0),
    }
}

fn same_val(lhs: ValTy, rhs: ValTy) -> bool {
    lhs.kind == rhs.kind && lhs.index == rhs.index
}

fn byte_at(in bytes: ChunkSeq[u8], i: u64) -> u8 {
    match bytes.try_get(i) {
        Option::Some(byte_val) => byte_val,
        Option::None => 0,
    }
}

fn copy_range(inout out: ChunkSeq[u8], in src: ChunkSeq[u8], start: u64, n: u64) {
    for i in 0..n {
        out.push(byte_at(in src, wrapping_add(start, i)));
    }
}

// A section: its id, its size and its bytes.
fn section(inout out: ChunkSeq[u8], id: u8, in body: ChunkSeq[u8]) {
    out.push(id);
    uleb(inout out, body.len());
    append(inout out, in body);
}

impl Builder {
    fn type_def(in self, i: u64) -> TypeDef {
        match self.types.try_get(i) {
            Option::Some(def) => def,
            Option::None => TypeDef { kind: TD_FUNC, p0: 0, pn: 0, rn: 0, func: 0 },
        }
    }

    fn func_row(in self, i: u64) -> FuncRow {
        match self.funcs.try_get(i) {
            Option::Some(row) => row,
            Option::None => FuncRow { ty: 0, b0: 0, bn: 0, defined: false },
        }
    }

    // The index of function type (params, results), interned.
    pub fn func_type(inout self, in params: ChunkSeq[ValTy], in results: ChunkSeq[ValTy]) -> u32 {
        for i in 0..self.types.len() {
            let def = self.type_def(i);
            if def.kind == TD_FUNC && def.pn == params.len() && def.rn == results.len() {
                let mut same = true;
                for j in 0..def.pn {
                    if !same_val(
                        val_at(in self.vals, wrapping_add(def.p0, j)),
                        val_at(in params, j)
                    ) {
                        same = false;
                    }
                }
                for j in 0..def.rn {
                    let val_index = wrapping_add(wrapping_add(def.p0, def.pn), j);
                    if !same_val(val_at(in self.vals, val_index), val_at(in results, j)) {
                        same = false;
                    }
                }
                if same {
                    return wrapping_u32(i);
                }
            }
        }
        let first_val = self.vals.len();
        for j in 0..params.len() {
            self.vals.push(val_at(in params, j));
        }
        for j in 0..results.len() {
            self.vals.push(val_at(in results, j));
        }
        let i = self.types.len();
        self.types.push(
            TypeDef { kind: TD_FUNC, p0: first_val, pn: params.len(), rn: results.len(), func: 0 }
        );
        wrapping_u32(i)
    }

    // `n_params` parameters of type `param_kind` and `n_results` results of type `result_kind`.
    pub fn func_type_n(
        inout self,
        n_params: u64,
        param_kind: u8,
        n_results: u64,
        result_kind: u8
    ) -> u32 {
        let mut param_tys = ChunkSeq::new[ValTy]();
        for i in 0..n_params {
            param_tys.push(vt(param_kind));
        }
        let mut result_tys = ChunkSeq::new[ValTy]();
        for i in 0..n_results {
            result_tys.push(vt(result_kind));
        }
        self.func_type(in param_tys, in result_tys)
    }

    pub fn cont_type(inout self, func: u32) -> u32 {
        for i in 0..self.types.len() {
            let def = self.type_def(i);
            if def.kind == TD_CONT && def.func == func {
                return wrapping_u32(i);
            }
        }
        let i = self.types.len();
        self.types.push(TypeDef { kind: TD_CONT, p0: 0, pn: 0, rn: 0, func: func });
        wrapping_u32(i)
    }

    pub fn declare_typed(inout self, ty: u32) -> u32 {
        self.funcs.push(FuncRow { ty: ty, b0: 0, bn: 0, defined: false });
        wrapping_u32(wrapping_sub(wrapping_add(self.imports.len(), self.funcs.len()), 1))
    }

    pub fn declare(inout self, in params: ChunkSeq[ValTy], in results: ChunkSeq[ValTy]) -> u32 {
        let ty = self.func_type(in params, in results);
        self.declare_typed(ty)
    }

    // A function of `n` `i64` parameters returning one `i64`.
    pub fn declare_i64(inout self, n: u64) -> u32 {
        let ty = self.func_type_n(n, 126, 1, 126);
        self.declare_typed(ty)
    }

    fn put_text(inout self, in bytes: Slice[u8]) -> u64 {
        let start = self.text.len();
        for i in 0..bytes.len() {
            match bytes.try_get(i) {
                Option::Some(byte_val) => self.text.push(byte_val),
                Option::None => {},
            }
        }
        start
    }

    // Import a function; all imports precede every declared function.
    pub fn import(
        inout self,
        in module: Slice[u8],
        in name: Slice[u8],
        in params: ChunkSeq[ValTy],
        in results: ChunkSeq[ValTy]
    ) -> u32 eff [Fail[WErr]] {
        if self.funcs.len() != 0 {
            Fail::raise(werr(K_INVALID, 0, 1));
        }
        let ty = self.func_type(in params, in results);
        let module_at = self.put_text(in module);
        let name_at = self.put_text(in name);
        self.imports.push(
            ImportRow { m0: module_at, mn: module.len(), n0: name_at, nn: name.len(), ty: ty }
        );
        wrapping_u32(wrapping_sub(self.imports.len(), 1))
    }

    pub fn import_count(in self) -> u64 {
        self.imports.len()
    }

    pub fn define(inout self, index: u32, in body: ChunkSeq[u8]) {
        let i = wrapping_sub(widen_u64(index), self.imports.len());
        let old_row = self.func_row(i);
        let body_at = self.bodies.len();
        append(inout self.bodies, in body);
        let row = FuncRow { ty: old_row.ty, b0: body_at, bn: body.len(), defined: true };
        let ok = self.funcs.try_set(i, row);
    }

    pub fn function_count(in self) -> u64 {
        wrapping_add(self.imports.len(), self.funcs.len())
    }

    // Append 8-byte-aligned static bytes; returns their address.
    pub fn data(inout self, in bytes: ChunkSeq[u8]) -> u64 {
        let addr = wrapping_add(DATA_START, self.data.len());
        append(inout self.data, in bytes);
        loop {
            if (self.data.len() & 7) == 0 {
                break;
            }
            self.data.push(0);
        }
        addr
    }

    pub fn set_heap_global(inout self, heap_global: u32) {
        self.heap_global = heap_global;
    }

    pub fn heap_start(in self) -> u64 {
        wrapping_add(DATA_START, self.data.len())
    }

    // A mutable `i64` global with the given initial value.
    pub fn global(inout self, init: i64) -> u32 {
        self.globals.push(init);
        wrapping_u32(wrapping_sub(self.globals.len(), 1))
    }

    // Place `func` in the function table and return its slot.
    pub fn table_slot(inout self, func: u32) -> u32 {
        self.table.push(func);
        wrapping_u32(wrapping_sub(self.table.len(), 1))
    }

    // Declare `func` as a `ref.func` target.
    pub fn declare_ref(inout self, func: u32) {
        for i in 0..self.declared.len() {
            match self.declared.try_get(i) {
                Option::Some(entry) => {
                    if entry == func {
                        return;
                    }
                },
                Option::None => {},
            }
        }
        self.declared.push(func);
    }

    pub fn tag(inout self, func_type: u32) -> u32 {
        self.tags.push(func_type);
        wrapping_u32(wrapping_sub(self.tags.len(), 1))
    }

    pub fn export_func(inout self, in name: Slice[u8], func: u32) {
        let name_at = self.put_text(in name);
        self.exports
            .push(ExportRow { n0: name_at, nn: name.len(), kind: EXPORT_FUNC, index: func });
    }

    // The module's bytes (`Builder::finish`).
    pub fn finish(in self, max_pages: u32) -> ChunkSeq[u8] eff [Fail[WErr]] {
        let mut out = ChunkSeq::new[u8]();
        // "\0asm", version 1
        out.push(0);
        out.push(97);
        out.push(115);
        out.push(109);
        out.push(1);
        out.push(0);
        out.push(0);
        out.push(0);
        let mut body = ChunkSeq::new[u8]();
        uleb(inout body, self.types.len());
        for i in 0..self.types.len() {
            let def = self.type_def(i);
            if def.kind == TD_FUNC {
                body.push(TYPE_FUNC);
                uleb(inout body, def.pn);
                for j in 0..def.pn {
                    put_valtype(inout body, val_at(in self.vals, wrapping_add(def.p0, j)));
                }
                uleb(inout body, def.rn);
                for j in 0..def.rn {
                    put_valtype(
                        inout body,
                        val_at(in self.vals, wrapping_add(wrapping_add(def.p0, def.pn), j))
                    );
                }
            } else {
                // A continuation type carries its function type index.
                body.push(TYPE_CONT);
                sleb(inout body, wrapping_i64(widen_u64(def.func)));
            }
        }
        section(inout out, S_TYPE, in body);
        if self.imports.len() != 0 {
            body.clear();
            uleb(inout body, self.imports.len());
            for i in 0..self.imports.len() {
                match self.imports.try_get(i) {
                    Option::Some(import_row) => {
                        uleb(inout body, import_row.mn);
                        copy_range(inout body, in self.text, import_row.m0, import_row.mn);
                        uleb(inout body, import_row.nn);
                        copy_range(inout body, in self.text, import_row.n0, import_row.nn);
                        body.push(IMPORT_FUNC);
                        uleb(inout body, widen_u64(import_row.ty));
                    },
                    Option::None => {},
                }
            }
            section(inout out, S_IMPORT, in body);
        }
        body.clear();
        uleb(inout body, self.funcs.len());
        for i in 0..self.funcs.len() {
            uleb(inout body, widen_u64(self.func_row(i).ty));
        }
        section(inout out, S_FUNCTION, in body);
        body.clear();
        // one funcref table, min = max = the slot count
        uleb(inout body, 1);
        body.push(TYPE_FUNCREF);
        body.push(LIMITS_WITH_MAX);
        uleb(inout body, self.table.len());
        uleb(inout body, self.table.len());
        section(inout out, S_TABLE, in body);
        let heap_start = self.heap_start();
        let mut min_pages = wrapping_add(heap_start, wrapping_sub(PAGE_BYTES, 1)) / PAGE_BYTES;
        if min_pages == 0 {
            min_pages = 1;
        }
        if min_pages > widen_u64(max_pages) {
            Fail::raise(werr(K_INVALID, 0, 2));
        }
        body.clear();
        uleb(inout body, 1);
        body.push(LIMITS_WITH_MAX);
        uleb(inout body, min_pages);
        uleb(inout body, widen_u64(max_pages));
        section(inout out, S_MEMORY, in body);
        if self.tags.len() != 0 {
            body.clear();
            uleb(inout body, self.tags.len());
            for i in 0..self.tags.len() {
                body.push(TAG_EXCEPTION);
                match self.tags.try_get(i) {
                    Option::Some(tag_ty) => uleb(inout body, widen_u64(tag_ty)),
                    Option::None => {},
                }
            }
            section(inout out, S_TAG, in body);
        }
        body.clear();
        uleb(inout body, self.globals.len());
        for i in 0..self.globals.len() {
            let init = if wrapping_u32(i) == self.heap_global {
                wrapping_i64(heap_start)
            } else {
                match self.globals.try_get(i) {
                    Option::Some(value) => value,
                    Option::None => 0,
                }
            };
            body.push(VT_I64);
            body.push(GLOBAL_MUTABLE);
            body.push(OP_I64_CONST);
            sleb(inout body, init);
            body.push(OP_END);
        }
        section(inout out, S_GLOBAL, in body);
        body.clear();
        uleb(inout body, wrapping_add(self.exports.len(), 1));
        put_bytes(inout body, in "memory".as_bytes());
        body.push(EXPORT_MEMORY);
        uleb(inout body, 0);
        for i in 0..self.exports.len() {
            match self.exports.try_get(i) {
                Option::Some(export_row) => {
                    uleb(inout body, export_row.nn);
                    copy_range(inout body, in self.text, export_row.n0, export_row.nn);
                    body.push(export_row.kind);
                    uleb(inout body, widen_u64(export_row.index));
                },
                Option::None => {},
            }
        }
        section(inout out, S_EXPORT, in body);
        let mut segments: u64 = 0;
        body.clear();
        if self.table.len() != 0 {
            segments = wrapping_add(segments, 1);
            // Active segment with table index, offset expression and element kind.
            body.push(ELEM_ACTIVE_EXPLICIT_TABLE);
            uleb(inout body, 0);
            body.push(OP_I32_CONST);
            sleb(inout body, 0);
            body.push(OP_END);
            body.push(ELEM_KIND_FUNCREF);
            uleb(inout body, self.table.len());
            for i in 0..self.table.len() {
                match self.table.try_get(i) {
                    Option::Some(func) => uleb(inout body, widen_u64(func)),
                    Option::None => {},
                }
            }
        }
        if self.declared.len() != 0 {
            segments = wrapping_add(segments, 1);
            body.push(ELEM_DECLARATIVE);
            body.push(ELEM_KIND_FUNCREF);
            uleb(inout body, self.declared.len());
            for i in 0..self.declared.len() {
                match self.declared.try_get(i) {
                    Option::Some(func) => uleb(inout body, widen_u64(func)),
                    Option::None => {},
                }
            }
        }
        if segments != 0 {
            let mut elem_body = ChunkSeq::new[u8]();
            uleb(inout elem_body, segments);
            append(inout elem_body, in body);
            section(inout out, S_ELEMENT, in elem_body);
        }
        body.clear();
        uleb(inout body, self.funcs.len());
        for i in 0..self.funcs.len() {
            let row = self.func_row(i);
            if !row.defined {
                Fail::raise(werr(K_INVALID, 0, 3));
            }
            uleb(inout body, row.bn);
            copy_range(inout body, in self.bodies, row.b0, row.bn);
        }
        section(inout out, S_CODE, in body);
        if self.data.len() != 0 {
            body.clear();
            uleb(inout body, 1);
            body.push(DATA_ACTIVE_DEFAULT_MEMORY);
            body.push(OP_I32_CONST);
            sleb(inout body, wrapping_i64(DATA_START));
            body.push(OP_END);
            uleb(inout body, self.data.len());
            append(inout body, in self.data);
            section(inout out, S_DATA, in body);
        }
        out
    }
}
