// @vesper/wasm-backend: the Wasm backend of src/wasm_backend.rs in Vesper.
// Ported: the plan, layout, lowering, module encoder and the component
// boundary (WIT text and export wrappers). Not yet: handlers, WASI host
// frames, evidence binding (`K_NOT_PORTED`); wit-component stays in Rust.

use self::enc::{
    Code,
    code_new
};
use self::err::{
    WErr,
    werr
};
use self::module::{
    Builder,
    builder_new
};
use self::ir::{
    Facts,
    read_facts,
    ir_new
};
use self::plan::{
    Cx,
    Plan,
    cx_new,
    plan
};
use self::lower::{
    L,
    lowerer_new
};
use self::component::{
    exports
};
use @vesper/check-data::pack_text;
use @vesper/check-data::input::{
    Reader,
    read_ctx
};
use @vesper/place-ir::read_program;

const K_ENTRY: u8 = 1;
const K_LIMIT: u8 = 2;

// `wasm_backend::compile` up to the core module: the core bytes and the
// WIT text, or the error. Component encoding stays in Rust.
fn compile(in b: Slice[u8]) -> (ChunkSeq[u8], ChunkSeq[u8], u64, ChunkSeq[u64]) eff [Fail[WErr]] {
    let mut r = Reader {
        pos: 0
    };
    let c = read_ctx(inout r, in b);
    let p = read_program(inout r, in b, in c);
    let pool = p.pool.len();
    let f = read_facts(inout r, in b, in c, pool);
    if f.max_pages == 0 || f.max_pages > 65536 {
        Fail::raise(werr(K_LIMIT, 0, 1));
    }
    let max_pages = wrapping_u32(f.max_pages);
    let max_instructions = f.max_instructions;
    let ir = ir_new(p);
    let mut cx = cx_new(c, f, ir);
    if cx.fn_sig(cx.f.entry) == 0 {
        Fail::raise(werr(K_ENTRY, 0, 2));
    }
    let pl = plan(inout cx);
    let mut l = lowerer_new(cx, pl, max_instructions);
    l.declare_all();
    let wit = exports(inout l);
    l.define_all();
    let functions = l.b.function_count();
    let handlers = handler_report(in l);
    let core = l.b.finish(max_pages);
    (core, wit, functions, handlers)
}

// The artifact's `handlers` (`HandlerLowering`, in plan order): their count,
// then per handler the packed site instance and effect names, the clause
// count and each clause's operation index and mode (0 Abort, 1 Tail).
fn handler_report(in l: L) -> ChunkSeq[u64] {
    let mut out = ChunkSeq::new[u64]();
    out.push(l.plan.handlers.len());
    for i in 0..l.plan.handlers.len() {
        let h = l.plan.handler(i);
        let mut site = ChunkSeq::new[u8]();
        l.cx.write_name(h.site, inout site);
        push_all(inout out, in pack_text(in site));
        let mut effect = ChunkSeq::new[u8]();
        l.cx.write_name(h.ename, inout effect);
        push_all(inout out, in pack_text(in effect));
        out.push(h.cn);
        for k in 0..h.cn {
            let c = l.plan.clause(wrapping_add(h.c0, k));
            out.push(c.op);
            out.push(widen_u64(c.mode));
        }
    }
    out
}

fn push_all(inout out: ChunkSeq[u64], in a: ChunkSeq[u64]) {
    for i in 0..a.len() {
        match a.try_get(i) {
            Option::Some(x) => out.push(x),
            Option::None => {},
        }
    }
}

// The harness entry: `[0, function count, packed core, packed WIT,
// handler report]` on
// success, else `[1, kind, construct, site]`.
pub fn wasm_backend_compile(in input: Str) -> ChunkSeq[u64] {
    wasm_backend_compile_bytes(in input.as_bytes())
}

// The same over a byte slice (the hybrid module's entry, export ABI 4).
pub fn wasm_backend_compile_bytes(in input: Slice[u8]) -> ChunkSeq[u64] {
    handle Fail[WErr] in {
        let (core, wit, functions, handlers) = compile(in input);
        let mut out = ChunkSeq::new[u64]();
        out.push(0);
        out.push(functions);
        let a = pack_text(in core);
        for i in 0..a.len() {
            match a.try_get(i) {
                Option::Some(x) => out.push(x),
                Option::None => {},
            }
        }
        let t = pack_text(in wit);
        for i in 0..t.len() {
            match t.try_get(i) {
                Option::Some(x) => out.push(x),
                Option::None => {},
            }
        }
        push_all(inout out, in handlers);
        out
    } with {
        return value => value,
        raise(e, resume) => {
            let mut out = ChunkSeq::new[u64]();
            out.push(1);
            out.push(widen_u64(e.kind));
            out.push(widen_u64(e.construct));
            out.push(e.site);
            out
        },
    }
}
