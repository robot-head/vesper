// @vesper/wasm-backend: the Wasm backend of src/wasm_backend.rs in Vesper.
// Ported: the plan, layout, lowering, module encoder and the component
// boundary (WIT text and export wrappers). Not yet: handlers, WASI host
// frames, evidence binding (`K_NOT_PORTED`); wit-component stays in Rust.

use self::enc::{Code, code_new};
use self::err::{WErr, werr, werr_syms};
use @vesper/check-data::util::{push_decimal, w};
use self::module::{Builder, builder_new};
use self::ir::{Facts, read_facts, ir_new};
use self::plan::{Cx, Plan, cx_new, plan};
use self::lower::{L, lowerer_new};
use self::component::{exports};
use self::tables::{dummy_l, rebuild_l, stage2_heap_mark, stage2_heap_reset, stage2_heap_swap};
use @vesper/check-data::pack_text;
use @vesper/check-data::input::{Ctx, Reader, read_ctx};
use @vesper/place-ir::{Program, read_program};

const K_ENTRY: u8 = 1;
const K_LIMIT: u8 = 2;

// `wasm_backend::compile` up to the core module: the core bytes and the
// WIT text, or the error. Component encoding stays in Rust.
fn compile(
    in input: Slice[u8]
) -> (ChunkSeq[u8], ChunkSeq[u8], u64, ChunkSeq[u64]) eff [Fail[WErr]] {
    let mut reader = Reader { pos: 0 };
    let ctx = read_ctx(inout reader, in input);
    let program = read_program(inout reader, in input, in ctx);
    let pool = program.pool.len();
    let facts = read_facts(inout reader, in input, in ctx, pool);
    compile_with_facts(sink ctx, sink program, sink facts)
}

fn compile_diag(
    in input: Slice[u8],
    want_syms: bool
) -> (ChunkSeq[u8], ChunkSeq[u8], u64, ChunkSeq[u64], ChunkSeq[u8]) eff [Fail[WErr]] {
    let mut reader = Reader { pos: 0 };
    let ctx = read_ctx(inout reader, in input);
    let program = read_program(inout reader, in input, in ctx);
    let pool = program.pool.len();
    let facts = read_facts(inout reader, in input, in ctx, pool);
    compile_with_facts_diag(sink ctx, sink program, sink facts, want_syms)
}

fn append_sym_line(idx: u32, in label: Slice[u8], inout out: ChunkSeq[u8]) {
    if idx == 4294967295 {
        return;
    }
    push_decimal(inout out, w(idx));
    out.push(32);
    out.extend(in label);
    out.push(10);
}

fn append_fn_syms(in l: L, inout out: ChunkSeq[u8]) {
    for i in 0..l.b.import_count() {
        push_decimal(inout out, i);
        out.extend(in " wasi_import\n".as_bytes());
    }
    append_sym_line(l.alloc, in "__alloc".as_bytes(), inout out);
    append_sym_line(l.h_str_eq, in "__str_eq".as_bytes(), inout out);
    append_sym_line(l.h_fmod, in "__fmod".as_bytes(), inout out);
    append_sym_line(l.h_seq_reserve, in "__seq_reserve".as_bytes(), inout out);
    append_sym_line(l.h_bytes_eq, in "__bytes_eq".as_bytes(), inout out);
    append_sym_line(l.h_utf8, in "__utf8".as_bytes(), inout out);
    for i in 0..l.plan.insts.len() {
        let inst = l.plan.inst(i);
        let idx = l.func_of(inst.key);
        push_decimal(inout out, w(idx));
        out.push(32);
        l.cx.names.write(inst.key, inout out);
        out.push(10);
    }
}

fn compile_with_facts_core(
    sink ctx: Ctx,
    sink program: Program,
    sink facts: Facts,
    want_syms: bool,
    inout syms_out: ChunkSeq[u8]
) -> (ChunkSeq[u8], ChunkSeq[u8], u64, ChunkSeq[u64]) eff [Fail[WErr]] {
    if facts.max_pages == 0 || facts.max_pages > 65536 {
        Fail::raise(werr(K_LIMIT, 0, 1));
    }
    let max_pages = wrapping_u32(facts.max_pages);
    let max_instructions = facts.max_instructions;
    let ir = ir_new(program);
    let mut cx = cx_new(ctx, facts, ir);
    if cx.fn_sig(cx.f.entry) == 0 {
        Fail::raise(werr_syms(K_ENTRY, 0, 2, cx.f.entry, cx.f.entry));
    }
    let lowering_plan = plan(inout cx);
    let mut lowerer = lowerer_new(cx, lowering_plan, max_instructions);
    lowerer.declare_all();
    let wit = exports(inout lowerer);
    lowerer.define_init();
    let mut lim = lowerer.pre_reserve_define_all();
    let mut d_perm_buf = ChunkSeq::new[u8]();
    d_perm_buf.reserve(134217728);
    let d_perm_end = stage2_heap_mark();
    let mut d_perm = wrapping_sub(d_perm_end, 134217728);
    let mut d_mark = d_perm_end;
    for i in 0..lowerer.plan.insts.len() {
        let n_mask = lowerer.cx.names.mask_val();
        let n_tmask = lowerer.cx.types.t_mask();
        let n_rmask = lowerer.cx.types.r_mask();
        let n_eqp = lowerer.eq_pending.len();
        let n_btypes = lowerer.b.types.len();
        let n_bvals = lowerer.b.vals.len();
        let n_bfuncs = lowerer.b.funcs.len();
        let inst = lowerer.plan.inst(i);
        let body = lowerer.function(inst);
        let idx = lowerer.func_of(inst.key);
        let s_def = stage2_heap_swap(d_perm);
        lowerer.b.define(idx, in body);
        d_perm = stage2_heap_swap(s_def);
        if d_perm_end != 0 && d_perm >= d_perm_end {
            Fail::raise(werr_syms(K_LIMIT, 0, 93, inst.key, 0));
        }
        if lowerer.can_rewind_define(
            in lim,
            n_mask,
            n_tmask,
            n_rmask,
            n_eqp,
            n_btypes,
            n_bvals,
            n_bfuncs
        ) {
            let mut old_lowerer = dummy_l(lowerer.cx.k, lowerer.cx.s);
            swap(inout lowerer, inout old_lowerer);
            let (rebuilt, next_perm) = rebuild_l(old_lowerer, d_mark, d_perm);
            let mut new_lowerer = rebuilt;
            d_perm = next_perm;
            swap(inout lowerer, inout new_lowerer);
        } else {
            let s_pre = stage2_heap_swap(d_perm);
            lim = lowerer.pre_reserve_define_all();
            d_perm = stage2_heap_swap(s_pre);
            d_mark = stage2_heap_mark();
        }
    }
    let _ = stage2_heap_swap(d_mark);
    lowerer.define_finish();
    let functions = lowerer.b.function_count();
    let handlers = handler_report(in lowerer);
    if want_syms {
        append_fn_syms(in lowerer, inout syms_out);
    }
    let core = lowerer.b.finish(max_pages);
    (core, wit, functions, handlers)
}

pub fn compile_with_facts(
    sink ctx: Ctx,
    sink program: Program,
    sink facts: Facts
) -> (ChunkSeq[u8], ChunkSeq[u8], u64, ChunkSeq[u64]) eff [Fail[WErr]] {
    let mut dummy_syms = ChunkSeq::new[u8]();
    compile_with_facts_core(sink ctx, sink program, sink facts, false, inout dummy_syms)
}

pub fn compile_with_facts_diag(
    sink ctx: Ctx,
    sink program: Program,
    sink facts: Facts,
    want_syms: bool
) -> (ChunkSeq[u8], ChunkSeq[u8], u64, ChunkSeq[u64], ChunkSeq[u8]) eff [Fail[WErr]] {
    let mut syms_out = ChunkSeq::new[u8]();
    let (core, wit, functions, handlers) = compile_with_facts_core(
        sink ctx,
        sink program,
        sink facts,
        want_syms,
        inout syms_out
    );
    (core, wit, functions, handlers, syms_out)
}

// The artifact's `handlers` (`HandlerLowering`, in plan order): their count,
// then per handler the packed site instance and effect names, the clause
// count and each clause's operation index and mode (0 Abort, 1 Tail).
fn handler_report(in l: L) -> ChunkSeq[u64] {
    let mut out = ChunkSeq::new[u64]();
    out.push(l.plan.handlers.len());
    for i in 0..l.plan.handlers.len() {
        let handler_row = l.plan.handler(i);
        let mut site = ChunkSeq::new[u8]();
        l.cx.write_name(handler_row.site, inout site);
        push_all(inout out, in pack_text(in site));
        let mut effect = ChunkSeq::new[u8]();
        l.cx.write_name(handler_row.ename, inout effect);
        push_all(inout out, in pack_text(in effect));
        out.push(handler_row.cn);
        for clause_offset in 0..handler_row.cn {
            let clause = l.plan.clause(wrapping_add(handler_row.c0, clause_offset));
            out.push(clause.op);
            out.push(widen_u64(clause.mode));
        }
    }
    out
}

fn push_all(inout out: ChunkSeq[u64], in words: ChunkSeq[u64]) {
    for i in 0..words.len() {
        match words.try_get(i) {
            Option::Some(word_val) => out.push(word_val),
            Option::None => {},
        }
    }
}

// The harness entry: `[0, function count, packed core, packed WIT,
// handler report]` on
// success, else `[1, kind, construct, site]`.
pub fn wasm_backend_compile(in input: Str) -> ChunkSeq[u64] {
    wasm_backend_compile_bytes(in input.as_bytes())
}

// The same over a byte slice (the hybrid module's entry, export ABI 4).
pub fn wasm_backend_compile_bytes(in input: Slice[u8]) -> ChunkSeq[u64] {
    handle Fail[WErr] in {
        let (core, wit, functions, handlers) = compile(in input);
        let mut out = ChunkSeq::new[u64]();
        out.push(0);
        out.push(functions);
        let core_words = pack_text(in core);
        for i in 0..core_words.len() {
            match core_words.try_get(i) {
                Option::Some(word_val) => out.push(word_val),
                Option::None => {},
            }
        }
        let wit_words = pack_text(in wit);
        for i in 0..wit_words.len() {
            match wit_words.try_get(i) {
                Option::Some(word_val) => out.push(word_val),
                Option::None => {},
            }
        }
        push_all(inout out, in handlers);
        out
    } with {
        return value => value,
        raise(e, resume) => {
            let mut out = ChunkSeq::new[u64]();
            out.push(1);
            out.push(widen_u64(e.kind));
            out.push(widen_u64(e.construct));
            out.push(e.site);
            out
        },
    }
}

// `wasm_backend_compile_bytes` without the word packing (the Vesper
// driver's `vesper build --target wasm32-wasip2`, #1895): true with the
// core module and the WIT in `core` and `wit`, false on an error or a
// construct not ported yet.
pub fn wasm_backend_module(
    in input: Slice[u8],
    inout core: ChunkSeq[u8],
    inout wit: ChunkSeq[u8]
) -> bool {
    handle Fail[WErr] in {
        let (core_bytes, wit_bytes, functions, handlers) = compile(in input);
        core = core_bytes;
        wit = wit_bytes;
        true
    } with {
        return value => value,
        raise(e, resume) => false,
    }
}

pub fn wasm_backend_compile_diag(in input: Str) -> ChunkSeq[u64] {
    wasm_backend_compile_diag_bytes(in input.as_bytes())
}

pub fn wasm_backend_compile_diag_bytes(in input: Slice[u8]) -> ChunkSeq[u64] {
    handle Fail[WErr] in {
        let (core, wit, functions, handlers, syms_out) = compile_diag(in input, true);
        let mut out = ChunkSeq::new[u64]();
        out.push(0);
        out.push(functions);
        push_all(inout out, in pack_text(in syms_out));
        push_all(inout out, in pack_text(in core));
        push_all(inout out, in pack_text(in wit));
        push_all(inout out, in handlers);
        out
    } with {
        return value => value,
        raise(e, resume) => {
            let mut out = ChunkSeq::new[u64]();
            out.push(1);
            out.push(widen_u64(e.kind));
            out.push(widen_u64(e.construct));
            out.push(e.site);
            out
        },
    }
}
