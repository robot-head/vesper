// The standard I/O libraries over WASI 0.2 (rust-exit gap wave 1 lane 10,
// #1508): the wasm seed reads its sources and writes its outputs through
// @vesper-std/env and @vesper-std/fs, whose `.vsys` libraries `StdEnv`
// and `StdFs` the Bridge lowers to the effects `Ffi$StdEnv` and
// `Ffi$StdFs` (src/ffi_lowering.rs). The WASI environment surface is
// declared in env-wasip2.vsys. Here each operation becomes a
// generated function (a shim) over the WASI imports below, with the
// shim's semantics:
//
// - Arguments and environment come from `wasi:cli/environment`
//   (`get-arguments`, `get-environment`, `initial-cwd`). `vstd_env_os` is
//   0: wasm is no particular platform.
// - Paths resolve against the preopened directories
//   (`wasi:filesystem/preopens`): an absolute path against the preopen
//   with the longest name that is a whole-component prefix of it, a
//   relative path against the preopen named `.` (else the first). With no
//   such preopen a call fails with NotFound (ENOENT); a NUL byte is
//   InvalidInput.
// - Files and directory listings are slots of a static table (32 of them),
//   because the heap is reset under tail loops and a handle is a plain
//   `u64` that no evacuation follows. A file slot keeps the descriptor and
//   the position (`read` and `write` take offsets in WASI); append mode
//   writes at the size `stat` reports.
// - WASI `error-code`s become the shim's error words: the `IoKind` in the
//   low 8 bits and the Linux errno of the same condition in the high 32,
//   so a run agrees with a native Linux run.
// - Left out (they fail with Unsupported): `remove_dir` recursive and
//   `current_dir` when the host gives no initial directory.
//
// Every shim takes `i64` arguments in parameter order (an `inout`
// argument is its cell's address, a slice its packed view, an `FsFile` or
// `FsDir` its handle) and returns one `i64`. The call site (`lower.ves`
// `host_call`) builds the `Option` and struct values around it. Every
// address the canonical ABI hands back points into memory that
// `cabi_realloc` took from the heap.

use @vesper/check-data::util::{add, inc};
use self::enc::{Code, ValTy, code_new, function_bytes, vt};
use self::err::{WErr, werr};
use self::module::{Builder};
use self::vcl_host::{vcl_imports};

const VT_I32: u8 = 127;
const VT_I64: u8 = 126;
const OP_BLOCK: u8 = 2;
const OP_LOOP: u8 = 3;
const OP_IF: u8 = 4;
const OP_ELSE: u8 = 5;
const OP_END: u8 = 11;
const OP_RETURN: u8 = 15;
const OP_DROP: u8 = 26;
const OP_SELECT: u8 = 27;
const OP_I64_LOAD: u8 = 41;
const OP_I64_LOAD8_U: u8 = 49;
const OP_I64_LOAD32_U: u8 = 53;
const OP_I64_STORE: u8 = 55;
const OP_I64_STORE8: u8 = 60;
const OP_I32_EQZ: u8 = 69;
const OP_I64_EQZ: u8 = 80;
const OP_I64_EQ: u8 = 81;
const OP_I64_NE: u8 = 82;
const OP_I64_LT_S: u8 = 83;
const OP_I64_LT_U: u8 = 84;
const OP_I64_GT_U: u8 = 86;
const OP_I64_LE_U: u8 = 88;
const OP_I64_GE_U: u8 = 90;
const OP_I32_AND: u8 = 113;
const OP_I32_OR: u8 = 114;
const OP_I64_ADD: u8 = 124;
const OP_I64_SUB: u8 = 125;
const OP_I64_MUL: u8 = 126;
const OP_I64_AND: u8 = 131;
const OP_I64_OR: u8 = 132;
const OP_I64_SHL: u8 = 134;
const OP_I64_SHR_U: u8 = 136;
const OP_I32_WRAP_I64: u8 = 167;
const OP_I64_EXTEND_I32_U: u8 = 173;

const K_UNSUPPORTED: u8 = 0;
const U_EXTERNAL_FUNCTION: u8 = 11;
const NONE32: u32 = 4294967295;
const MASK32: u64 = 4294967295;

// `Plan.host` codes of the libraries. StdProcess (5), Blake3 (7) and
// HybridCommands (8, @vesper/driver-engines) have no functions on WASI and
// import nothing.
pub const HOST_ENV: u8 = 3;
pub const HOST_FS: u8 = 4;
pub const HOST_PROC: u8 = 5;
// `Ffi[Cranelift]`: imports of `vesper:cranelift/vcl` (src/vcl_host.ves).
pub const HOST_VCL: u8 = 6;
pub const HOST_BLAKE3: u8 = 7;
pub const HOST_HYBRID_COMMANDS: u8 = 8;

// The operations, by index (`op_index`).
pub const ENV_ARG_COUNT: u64 = 0;
pub const ENV_ARG: u64 = 1;
pub const ENV_VAR: u64 = 2;
pub const ENV_VAR_COUNT: u64 = 3;
pub const ENV_VAR_AT: u64 = 4;
pub const ENV_CURRENT_DIR: u64 = 5;
pub const ENV_OS: u64 = 6;
pub const FS_OPEN: u64 = 7;
pub const FS_FILE_LEN: u64 = 8;
pub const FS_READ: u64 = 9;
pub const FS_WRITE: u64 = 10;
pub const FS_SYNC: u64 = 11;
pub const FS_CLOSE: u64 = 12;
pub const FS_RENAME: u64 = 13;
pub const FS_REMOVE_FILE: u64 = 14;
pub const FS_REMOVE_DIR: u64 = 15;
pub const FS_CREATE_DIR: u64 = 16;
pub const FS_METADATA: u64 = 17;
pub const FS_SYNC_DIR: u64 = 18;
pub const FS_PARENT_LEN: u64 = 19;
pub const FS_UNIQUE: u64 = 20;
pub const FS_READ_DIR: u64 = 21;
pub const FS_DIR_NEXT: u64 = 22;
pub const FS_DIR_CLOSE: u64 = 23;
pub const FS_WRITE_STDOUT: u64 = 24;
pub const FS_WRITE_STDERR: u64 = 25;
const N_OPS: u64 = 26;

// Helper functions, after the operations in `Host.fns`.
const H_ERR: u64 = 26;
const H_PREOPENS: u64 = 27;
const H_RESOLVE: u64 = 28;
const H_SLOT: u64 = 29;
const H_COPYOUT: u64 = 30;
const H_KIND: u64 = 31;
const H_PATH_OP: u64 = 32;
const N_FNS: u64 = 35;

// The operation's `.vsys` name, its parameter count and the passing mode
// of each parameter (0 in, 1 inout, 2 sink: `P_*` of plan.ves), as the
// Bridge declares them; `op_index` checks a call against it.
fn op_name(op_code: u64) -> Str {
    if op_code == ENV_ARG_COUNT {
        "vstd_env_arg_count"
    } else if op_code == ENV_ARG {
        "vstd_env_arg"
    } else if op_code == ENV_VAR {
        "vstd_env_var"
    } else if op_code == ENV_VAR_COUNT {
        "vstd_env_var_count"
    } else if op_code == ENV_VAR_AT {
        "vstd_env_var_at"
    } else if op_code == ENV_CURRENT_DIR {
        "vstd_env_current_dir"
    } else if op_code == ENV_OS {
        "vstd_env_os"
    } else if op_code == FS_OPEN {
        "vstd_fs_open"
    } else if op_code == FS_FILE_LEN {
        "vstd_fs_file_len"
    } else if op_code == FS_READ {
        "vstd_fs_read"
    } else if op_code == FS_WRITE {
        "vstd_fs_write"
    } else if op_code == FS_SYNC {
        "vstd_fs_sync"
    } else if op_code == FS_CLOSE {
        "vstd_fs_close"
    } else if op_code == FS_RENAME {
        "vstd_fs_rename"
    } else if op_code == FS_REMOVE_FILE {
        "vstd_fs_remove_file"
    } else if op_code == FS_REMOVE_DIR {
        "vstd_fs_remove_dir"
    } else if op_code == FS_CREATE_DIR {
        "vstd_fs_create_dir"
    } else if op_code == FS_METADATA {
        "vstd_fs_metadata"
    } else if op_code == FS_SYNC_DIR {
        "vstd_fs_sync_dir"
    } else if op_code == FS_PARENT_LEN {
        "vstd_fs_parent_len"
    } else if op_code == FS_UNIQUE {
        "vstd_fs_unique"
    } else if op_code == FS_READ_DIR {
        "vstd_fs_read_dir"
    } else if op_code == FS_DIR_NEXT {
        "vstd_fs_dir_next"
    } else if op_code == FS_DIR_CLOSE {
        "vstd_fs_dir_close"
    } else if op_code == FS_WRITE_STDOUT {
        "vstd_fs_write_stdout"
    } else {
        "vstd_fs_write_stderr"
    }
}

// Passing modes, one character per parameter: `i` in, `o` inout, `s` sink.
fn op_passes(op_code: u64) -> Str {
    if op_code == ENV_ARG_COUNT
        || op_code == ENV_VAR_COUNT
        || op_code == ENV_OS
        || op_code == FS_UNIQUE
    {
        ""
    } else if op_code == ENV_ARG || op_code == ENV_VAR || op_code == ENV_VAR_AT {
        "io"
    } else if op_code == ENV_CURRENT_DIR {
        "oo"
    } else if op_code == FS_OPEN || op_code == FS_REMOVE_DIR || op_code == FS_CREATE_DIR {
        "iio"
    } else if op_code == FS_FILE_LEN || op_code == FS_PARENT_LEN {
        "i"
    } else if op_code == FS_READ || op_code == FS_DIR_NEXT {
        "ooo"
    } else if op_code == FS_WRITE {
        "oio"
    } else if op_code == FS_SYNC {
        "oo"
    } else if op_code == FS_CLOSE || op_code == FS_DIR_CLOSE {
        "s"
    } else if op_code == FS_RENAME {
        "iio"
    } else if op_code == FS_REMOVE_FILE
        || op_code == FS_SYNC_DIR
        || op_code == FS_READ_DIR
        || op_code == FS_WRITE_STDOUT
        || op_code == FS_WRITE_STDERR
    {
        "io"
    } else {
        // FS_METADATA
        "iioo"
    }
}

// Whether parameter 0 is a handle (`FsFile` or `FsDir`).
pub fn takes_handle(op_code: u64) -> bool {
    op_code == FS_FILE_LEN
        || op_code == FS_READ
        || op_code == FS_WRITE
        || op_code == FS_SYNC
        || op_code == FS_CLOSE
        || op_code == FS_DIR_NEXT
        || op_code == FS_DIR_CLOSE
}

// Whether the result is `Option[FsFile]` or `Option[FsDir]` (the shim
// returns the handle, 0 for `None`).
pub fn returns_handle(op_code: u64) -> bool {
    op_code == FS_OPEN || op_code == FS_READ_DIR
}

// Whether operation `op_code` takes an `inout FsMeta` (parameter 2, which the
// shim fills in place: the call site passes a fresh copy).
pub fn takes_meta(op_code: u64) -> bool {
    op_code == FS_METADATA
}

fn byte(in bytes: Slice[u8], i: u64) -> u8 {
    match bytes.try_get(i) {
        Option::Some(value) => value,
        Option::None => 0,
    }
}

// The operation `name` of library `lib` (`HOST_ENV` or `HOST_FS`) names,
// with the Bridge's slice-arity suffix (`$s`, `$s_s`) ignored, checked
// against `passes` (`P_*` codes); raises when it is not one.
pub fn op_index(in name: Slice[u8], lib: u8, in passes: ChunkSeq[u8]) -> u64 eff [Fail[WErr]] {
    let mut n = name.len();
    for i in 0..name.len() {
        match name.try_get(i) {
            Option::Some(ch) => {
                if ch == 36 {
                    n = i;
                    break;
                }
            },
            Option::None => {},
        }
    }
    let (lo, hi) = if lib == HOST_ENV {
        (0, FS_OPEN)
    } else {
        (FS_OPEN, N_OPS)
    };
    for op_code in lo..hi {
        let want = op_name(op_code).as_bytes();
        if want.len() != n {
            continue;
        }
        let mut same = true;
        for i in 0..n {
            if byte(in want, i) != byte(in name, i) {
                same = false;
                break;
            }
        }
        if !same {
            continue;
        }
        let want_passes = op_passes(op_code).as_bytes();
        if want_passes.len() != passes.len() {
            Fail::raise(werr(K_UNSUPPORTED, U_EXTERNAL_FUNCTION, 240));
        }
        for i in 0..want_passes.len() {
            let want = match want_passes.try_get(i) {
                Option::Some(pass_char) => if pass_char == 105 {
                    0
                } else if pass_char == 111 {
                    1
                } else {
                    2
                },
                Option::None => 0,
            };
            let have = match passes.try_get(i) {
                Option::Some(pass) => pass,
                Option::None => 9,
            };
            // A sink handle is passed like an in one.
            let ok = have == want || (want == 2 && have == 0) || (want == 0 && have == 2);
            if !ok {
                Fail::raise(werr(K_UNSUPPORTED, U_EXTERNAL_FUNCTION, 241));
            }
        }
        return op_code;
    }
    Fail::raise(werr(K_UNSUPPORTED, U_EXTERNAL_FUNCTION, 242))
}

// The WASI functions the shims call, as import indices (NONE32 when the
// library that needs them is absent), and the static areas.
pub struct Host {
    env: bool,
    fs: bool,
    // `Ffi[Cranelift]`, and the index of the first of its imports (the
    // others follow in `vcl.ves` row order).
    vcl: bool,
    i_vcl: u32,
    i_args: u32,
    i_environ: u32,
    i_cwd: u32,
    i_preopens: u32,
    i_open_at: u32,
    i_read: u32,
    i_write: u32,
    i_stat: u32,
    i_stat_at: u32,
    i_sync: u32,
    i_mkdir: u32,
    i_rmdir: u32,
    i_unlink: u32,
    i_rename: u32,
    i_readdir: u32,
    i_read_entry: u32,
    i_drop_desc: u32,
    i_drop_stream: u32,
    i_stdout: u32,
    i_stderr: u32,
    i_write_stream: u32,
    i_drop_out_stream: u32,
    // the canonical ABI's return area (112 bytes)
    ret_area: u64,
    // [0] preopens read, [8] the last resolved relative path (a view),
    // [16] the `vstd_fs_unique` counter, [24] the text "."
    misc: u64,
    // 37 `IoKind`s, then 37 errnos, by WASI `error-code`
    err_table: u64,
    // the preopen table: count, then 16 x (descriptor, name address,
    // name length)
    preopen_table: u64,
    names: u64,
    // NSLOT slots of SLOT bytes: a file is [descriptor + 1, position,
    // append]; a listing is [stream + 1, has a pending entry, its name
    // length, its kind, descriptor + 1, -] and the pending name at 48.
    slots: u64,
    // shim or helper function index + 1, by `ENV_*`/`FS_*`/`H_*`
    fns: ChunkSeq[u32],
}

const NSLOT: u64 = 32;
const SLOT: u64 = 304;
const NPRE: u64 = 16;
const NAMES: u64 = 1024;

pub fn host_none() -> Host {
    Host {
        env: false,
        fs: false,
        vcl: false,
        i_vcl: NONE32,
        i_args: NONE32,
        i_environ: NONE32,
        i_cwd: NONE32,
        i_preopens: NONE32,
        i_open_at: NONE32,
        i_read: NONE32,
        i_write: NONE32,
        i_stat: NONE32,
        i_stat_at: NONE32,
        i_sync: NONE32,
        i_mkdir: NONE32,
        i_rmdir: NONE32,
        i_unlink: NONE32,
        i_rename: NONE32,
        i_readdir: NONE32,
        i_read_entry: NONE32,
        i_drop_desc: NONE32,
        i_drop_stream: NONE32,
        i_stdout: NONE32,
        i_stderr: NONE32,
        i_write_stream: NONE32,
        i_drop_out_stream: NONE32,
        ret_area: 0,
        misc: 0,
        err_table: 0,
        preopen_table: 0,
        names: 0,
        slots: 0,
        fns: ChunkSeq::new[u32](),
    }
}

fn i32s(n: u64) -> ChunkSeq[ValTy] {
    let mut tys = ChunkSeq::new[ValTy]();
    for _i in 0..n {
        tys.push(vt(VT_I32));
    }
    tys
}

fn no_vals() -> ChunkSeq[ValTy] {
    ChunkSeq::new[ValTy]()
}

// module 0 `wasi:cli/environment`, 1 `wasi:filesystem/types`, 2 preopens
fn imp(
    inout builder: Builder,
    module: u8,
    in name: Str,
    in params: ChunkSeq[ValTy]
) -> u32 eff [Fail[WErr]] {
    let module_name = if module == 0 {
        "wasi:cli/environment@0.2.0"
    } else if module == 1 {
        "wasi:filesystem/types@0.2.0"
    } else if module == 2 {
        "wasi:filesystem/preopens@0.2.0"
    } else if module == 3 {
        "wasi:cli/stdout@0.2.0"
    } else if module == 4 {
        "wasi:cli/stderr@0.2.0"
    } else {
        "wasi:io/streams@0.2.0"
    };
    builder.import(in module_name.as_bytes(), in name.as_bytes(), in params, in no_vals())
}

fn imp_i32(inout builder: Builder, module: u8, in name: Str) -> u32 eff [Fail[WErr]] {
    let module_name = if module == 3 {
        "wasi:cli/stdout@0.2.0"
    } else {
        "wasi:cli/stderr@0.2.0"
    };
    builder.import(in module_name.as_bytes(), in name.as_bytes(), in no_vals(), in i32s(1))
}

// (i32 x n) with an `i64` at each position in `wide`.
fn sig(n: u64, wide_a: u64, wide_b: u64) -> ChunkSeq[ValTy] {
    let mut tys = ChunkSeq::new[ValTy]();
    for i in 0..n {
        if i == wide_a || i == wide_b {
            tys.push(vt(VT_I64));
        } else {
            tys.push(vt(VT_I32));
        }
    }
    tys
}

// The WASI kinds and errnos of `error-code` 0..36 (`access` .. `cross-device`).
fn error_table() -> ChunkSeq[u8] {
    // IoKind: 1 NotFound, 2 PermissionDenied, 3 AlreadyExists,
    // 4 NotADirectory, 5 IsADirectory, 6 DirectoryNotEmpty,
    // 7 InvalidInput, 8 Interrupted, 11 Unsupported, 12 OutOfMemory,
    // 13 Other (std::io::ErrorKind of each errno).
    let mut out = ChunkSeq::new[u8]();
    out.push(2);
    out.push(13);
    out.push(13);
    out.push(13);
    out.push(13);
    out.push(13);
    out.push(13);
    out.push(3);
    out.push(13);
    out.push(7);
    out.push(13);
    out.push(8);
    out.push(7);
    out.push(13);
    out.push(5);
    out.push(13);
    out.push(13);
    out.push(13);
    out.push(7);
    out.push(13);
    out.push(1);
    out.push(13);
    out.push(12);
    out.push(13);
    out.push(4);
    out.push(6);
    out.push(13);
    out.push(11);
    out.push(13);
    out.push(13);
    out.push(13);
    out.push(2);
    out.push(13);
    out.push(13);
    out.push(13);
    out.push(13);
    out.push(13);
    out.push(13);
    out.push(11);
    out.push(114);
    out.push(9);
    out.push(16);
    out.push(35);
    out.push(122);
    out.push(17);
    out.push(27);
    out.push(84);
    out.push(115);
    out.push(4);
    out.push(22);
    out.push(5);
    out.push(21);
    out.push(40);
    out.push(31);
    out.push(90);
    out.push(36);
    out.push(19);
    out.push(2);
    out.push(37);
    out.push(12);
    out.push(28);
    out.push(20);
    out.push(39);
    out.push(131);
    out.push(95);
    out.push(25);
    out.push(6);
    out.push(75);
    out.push(1);
    out.push(32);
    out.push(30);
    out.push(29);
    out.push(26);
    out.push(18);
    out
}

fn zeros(n: u64) -> ChunkSeq[u8] {
    let mut out = ChunkSeq::new[u8]();
    for _i in 0..n {
        out.push(0);
    }
    out
}

// Import what the libraries in `host` (`Plan.host` codes) need, before any
// function is declared, and reserve their static memory.
pub fn host_new(inout builder: Builder, in codes: ChunkSeq[u8]) -> Host eff [Fail[WErr]] {
    let mut host = host_none();
    for i in 0..codes.len() {
        match codes.try_get(i) {
            Option::Some(code) => {
                if code == HOST_ENV {
                    host.env = true;
                }
                if code == HOST_FS {
                    host.fs = true;
                }
                if code == HOST_VCL {
                    host.vcl = true;
                }
            },
            Option::None => {},
        }
    }
    if !host.env && !host.fs && !host.vcl {
        return host;
    }
    if host.vcl {
        host.i_vcl = vcl_imports(inout builder);
    }
    if host.env {
        host.i_args = imp(inout builder, 0, "get-arguments", in i32s(1));
        host.i_environ = imp(inout builder, 0, "get-environment", in i32s(1));
        host.i_cwd = imp(inout builder, 0, "initial-cwd", in i32s(1));
    }
    if host.fs {
        host.i_preopens = imp(inout builder, 2, "get-directories", in i32s(1));
        host.i_open_at = imp(inout builder, 1, "[method]descriptor.open-at", in i32s(7));
        host.i_read = imp(inout builder, 1, "[method]descriptor.read", in sig(4, 1, 2));
        host.i_write = imp(inout builder, 1, "[method]descriptor.write", in sig(5, 3, 9));
        host.i_stat = imp(inout builder, 1, "[method]descriptor.stat", in i32s(2));
        host.i_stat_at = imp(inout builder, 1, "[method]descriptor.stat-at", in i32s(5));
        host.i_sync = imp(inout builder, 1, "[method]descriptor.sync", in i32s(2));
        host.i_mkdir = imp(inout builder, 1, "[method]descriptor.create-directory-at", in i32s(4));
        host.i_rmdir = imp(inout builder, 1, "[method]descriptor.remove-directory-at", in i32s(4));
        host.i_unlink = imp(inout builder, 1, "[method]descriptor.unlink-file-at", in i32s(4));
        host.i_rename = imp(inout builder, 1, "[method]descriptor.rename-at", in i32s(7));
        host.i_readdir = imp(inout builder, 1, "[method]descriptor.read-directory", in i32s(2));
        host.i_read_entry = imp(
            inout builder,
            1,
            "[method]directory-entry-stream.read-directory-entry",
            in i32s(2)
        );
        host.i_drop_desc = imp(inout builder, 1, "[resource-drop]descriptor", in i32s(1));
        host.i_drop_stream = imp(
            inout builder,
            1,
            "[resource-drop]directory-entry-stream",
            in i32s(1)
        );
        host.i_stdout = imp_i32(inout builder, 3, "get-stdout");
        host.i_stderr = imp_i32(inout builder, 4, "get-stderr");
        host.i_write_stream = imp(
            inout builder,
            5,
            "[method]output-stream.blocking-write-and-flush",
            in i32s(4)
        );
        host.i_drop_out_stream = imp(inout builder, 5, "[resource-drop]output-stream", in i32s(1));
    }
    host.ret_area = builder.data(in zeros(112));
    if host.fs {
        let mut misc = zeros(32);
        let ok = misc.try_set(24, 46);
        host.misc = builder.data(in misc);
        host.err_table = builder.data(in error_table());
        host.preopen_table = builder.data(in zeros(add(8, wrapping_mul(NPRE, 24))));
        host.names = builder.data(in zeros(NAMES));
        host.slots = builder.data(in zeros(wrapping_mul(NSLOT, SLOT)));
    }
    for _i in 0..N_FNS {
        host.fns.push(0);
    }
    host
}

// The WIT world lines for the imported interfaces.
pub fn wit_imports(in host: Host) -> Str {
    if host.vcl {
        if host.env && host.fs {
            "  import wasi:cli/environment@0.2.0;\n  import wasi:cli/stdout@0.2.0;\n  import wasi:cli/stderr@0.2.0;\n  import wasi:filesystem/types@0.2.0;\n  import wasi:filesystem/preopens@0.2.0;\n  import vesper:cranelift/vcl@0.1.0;\n"
        } else if host.env {
            "  import wasi:cli/environment@0.2.0;\n  import vesper:cranelift/vcl@0.1.0;\n"
        } else if host.fs {
            "  import wasi:cli/stdout@0.2.0;\n  import wasi:cli/stderr@0.2.0;\n  import wasi:filesystem/types@0.2.0;\n  import wasi:filesystem/preopens@0.2.0;\n  import vesper:cranelift/vcl@0.1.0;\n"
        } else {
            "  import vesper:cranelift/vcl@0.1.0;\n"
        }
    } else if host.env && host.fs {
        "  import wasi:cli/environment@0.2.0;\n  import wasi:cli/stdout@0.2.0;\n  import wasi:cli/stderr@0.2.0;\n  import wasi:filesystem/types@0.2.0;\n  import wasi:filesystem/preopens@0.2.0;\n"
    } else if host.env {
        "  import wasi:cli/environment@0.2.0;\n"
    } else if host.fs {
        "  import wasi:cli/stdout@0.2.0;\n  import wasi:cli/stderr@0.2.0;\n  import wasi:filesystem/types@0.2.0;\n  import wasi:filesystem/preopens@0.2.0;\n"
    } else {
        ""
    }
}

pub fn active(in host: Host) -> bool {
    host.env || host.fs || host.vcl
}

// ----- a small assembler over `Code` (every local is an `i64`) -----------

struct A {
    code: Code,
    params: u32,
    next_local: u32,
}

fn asm(params: u64) -> A {
    A { code: code_new(), params: wrapping_u32(params), next_local: wrapping_u32(params) }
}

impl A {
    fn loc(inout self) -> u32 {
        let local = self.next_local;
        self.next_local = wrapping_add(self.next_local, 1);
        local
    }

    fn get(inout self, local: u32) {
        self.code.get(local);
    }

    fn set(inout self, local: u32) {
        self.code.set(local);
    }

    fn k(inout self, value: i64) {
        self.code.i64_const(value);
    }

    fn ku(inout self, value: u64) {
        self.code.u64_const(value);
    }

    fn op(inout self, opcode: u8) {
        self.code.op(opcode);
    }

    // local `local` = constant `value`
    fn setk(inout self, local: u32, value: i64) {
        self.code.i64_const(value);
        self.code.set(local);
    }

    // local `local` as an `i32` operand
    fn w32(inout self, local: u32) {
        self.code.get(local);
        self.code.op(OP_I32_WRAP_I64);
    }

    fn i32k(inout self, value: u64) {
        self.code.i32_const(wrapping_i64(value));
    }

    // an `i64` load of width `op` at `base + off` (a local base)
    fn ldw(inout self, base: u32, off: u64, op: u8) {
        self.w32(base);
        self.code.mem(
            op,
            if op == OP_I64_LOAD {
                3
            } else if op == OP_I64_LOAD32_U {
                2
            } else {
                0
            },
            off
        );
    }

    fn ld(inout self, base: u32, off: u64) {
        self.ldw(base, off, OP_I64_LOAD);
    }

    fn ld32(inout self, base: u32, off: u64) {
        self.ldw(base, off, OP_I64_LOAD32_U);
    }

    fn ld8(inout self, base: u32, off: u64) {
        self.ldw(base, off, OP_I64_LOAD8_U);
    }

    // loads at a static address
    fn lda(inout self, addr: u64, op: u8) {
        self.code.i32_const(0);
        self.code.mem(
            op,
            if op == OP_I64_LOAD {
                3
            } else if op == OP_I64_LOAD32_U {
                2
            } else {
                0
            },
            addr
        );
    }

    // store local `value` at `base + off`
    fn st(inout self, base: u32, off: u64, value: u32) {
        self.w32(base);
        self.code.get(value);
        self.code.mem(OP_I64_STORE, 3, off);
    }

    // store the `i64` on the stack top... at `base + off`: pushes the
    // address first, so the value is computed by `f` after it.
    fn st_begin(inout self, base: u32) {
        self.w32(base);
    }

    fn st_end(inout self, off: u64) {
        self.code.mem(OP_I64_STORE, 3, off);
    }

    fn st8_end(inout self, off: u64) {
        self.code.mem(OP_I64_STORE8, 0, off);
    }

    fn sta_begin(inout self) {
        self.code.i32_const(0);
    }

    // store constant `value` at `base + off`
    fn stk(inout self, base: u32, off: u64, value: i64) {
        self.w32(base);
        self.code.i64_const(value);
        self.code.mem(OP_I64_STORE, 3, off);
    }

    fn call(inout self, func: u32) {
        self.code.call(func);
    }

    fn open(inout self, opcode: u8) {
        self.code.open(opcode);
    }

    fn end(inout self) {
        self.code.op(OP_END);
    }

    fn br(inout self, depth: u32) {
        self.code.br(depth);
    }

    fn br_if(inout self, depth: u32) {
        self.code.br_if(depth);
    }

    // `return local x`
    fn ret(inout self, local: u32) {
        self.code.get(local);
        self.code.op(OP_RETURN);
    }

    fn retk(inout self, value: i64) {
        self.code.i64_const(value);
        self.code.op(OP_RETURN);
    }

    // x = x + local y / + constant
    fn addk(inout self, local: u32, delta: i64) {
        self.code.get(local);
        self.code.i64_const(delta);
        self.code.op(OP_I64_ADD);
        self.code.set(local);
    }

    // local x = view's address / length
    fn view_addr(inout self, view: u32, dest: u32) {
        self.code.get(view);
        self.code.u64_const(MASK32);
        self.code.op(OP_I64_AND);
        self.code.set(dest);
    }

    fn view_len(inout self, view: u32, dest: u32) {
        self.code.get(view);
        self.code.i64_const(32);
        self.code.op(OP_I64_SHR_U);
        self.code.set(dest);
    }

    // memory.copy(dst, src, n) of locals
    fn copy(inout self, dst: u32, src: u32, n: u32) {
        self.w32(dst);
        self.w32(src);
        self.w32(n);
        self.code.memory_copy();
    }

    fn body(in self) -> ChunkSeq[u8] {
        let mut counts = ChunkSeq::new[u32]();
        let mut types = ChunkSeq::new[ValTy]();
        let n = wrapping_sub(self.next_local, self.params);
        if n > 0 {
            counts.push(n);
            types.push(vt(VT_I64));
        }
        let mut code = code_new();
        code.extend(in self.code);
        code.op(OP_END);
        function_bytes(in counts, in types, in code)
    }
}

fn i64s(n: u64) -> ChunkSeq[ValTy] {
    let mut tys = ChunkSeq::new[ValTy]();
    for _i in 0..n {
        tys.push(vt(VT_I64));
    }
    tys
}

fn params_of(op_code: u64) -> u64 {
    if op_code == H_ERR || op_code == H_RESOLVE || op_code == H_KIND {
        1
    } else if op_code == H_PREOPENS || op_code == H_SLOT {
        0
    } else if op_code == H_COPYOUT {
        3
    } else if op_code >= H_PATH_OP {
        2
    } else {
        op_passes(op_code).len()
    }
}

// The function of shim or helper `op_code`, declared and defined on first use.
pub fn host_fn(inout builder: Builder, inout host: Host, op_code: u64) -> u32 eff [Fail[WErr]] {
    let cached = match host.fns.try_get(op_code) {
        Option::Some(entry) => entry,
        Option::None => 0,
    };
    if cached != 0 {
        return wrapping_sub(cached, 1);
    }
    let n_params = params_of(op_code);
    let func = builder.declare(in i64s(n_params), in i64s(1));
    let ok = host.fns.try_set(op_code, inc32(func));
    let mut body_asm = asm(n_params);
    emit(inout builder, inout host, inout body_asm, op_code);
    builder.define(func, in body_asm.body());
    func
}

fn inc32(x: u32) -> u32 {
    wrapping_add(x, 1)
}

// The body of `op_code`; it leaves the result on the stack (or returns).
fn emit(inout builder: Builder, inout host: Host, inout asm: A, op_code: u64) eff [Fail[WErr]] {
    if op_code == H_ERR {
        emit_err(inout asm, in host);
    } else if op_code == H_PREOPENS {
        emit_preopens(inout asm, in host);
    } else if op_code == H_RESOLVE {
        let preopens_fn = host_fn(inout builder, inout host, H_PREOPENS);
        emit_resolve(inout asm, in host, preopens_fn);
    } else if op_code == H_SLOT {
        emit_slot(inout asm, in host);
    } else if op_code == H_COPYOUT {
        emit_copyout(inout asm);
    } else if op_code == H_KIND {
        emit_kind(inout asm);
    } else if op_code >= H_PATH_OP {
        emit_path_op(inout builder, inout host, inout asm, op_code);
    } else if op_code < FS_OPEN {
        emit_env(inout builder, inout host, inout asm, op_code);
    } else {
        emit_fs(inout builder, inout host, inout asm, op_code);
    }
}

// H_ERR(code) -> the error word of WASI `error-code` `code`.
fn emit_err(inout asm: A, in host: Host) {
    asm.get(0);
    asm.k(37);
    asm.op(OP_I64_GE_U);
    asm.open(OP_IF);
    asm.retk(13);
    asm.end();
    asm.ldw(0, host.err_table, OP_I64_LOAD8_U);
    asm.ldw(0, add(host.err_table, 37), OP_I64_LOAD8_U);
    asm.k(32);
    asm.op(OP_I64_SHL);
    asm.op(OP_I64_OR);
}

// H_PREOPENS() -> 0: read the preopens into the table once.
fn emit_preopens(inout asm: A, in host: Host) {
    let list_addr = asm.loc();
    let list_len = asm.loc();
    let i = asm.loc();
    let count = asm.loc();
    let off = asm.loc();
    let entry = asm.loc();
    let name_len = asm.loc();
    let ptr = asm.loc();
    let name_at = asm.loc();
    let over = asm.loc();
    asm.setk(over, 0);
    asm.lda(host.misc, OP_I64_LOAD);
    asm.op(OP_I64_EQZ);
    asm.op(OP_I32_EQZ);
    asm.open(OP_IF);
    asm.retk(0);
    asm.end();
    asm.sta_begin();
    asm.k(1);
    asm.st_end(host.misc);
    asm.i32k(host.ret_area);
    asm.call(host.i_preopens);
    asm.lda(host.ret_area, OP_I64_LOAD32_U);
    asm.set(list_addr);
    asm.lda(add(host.ret_area, 4), OP_I64_LOAD32_U);
    asm.set(list_len);
    asm.setk(i, 0);
    asm.setk(count, 0);
    asm.setk(off, 0);
    asm.open(OP_BLOCK);
    asm.open(OP_LOOP);
    // i < list_len && count < NPRE
    asm.get(i);
    asm.get(list_len);
    asm.op(OP_I64_GE_U);
    asm.br_if(1);
    // More preopens than the table holds: a partial table could resolve
    // a path under the wrong directory, so every path fails instead.
    asm.get(count);
    asm.ku(NPRE);
    asm.op(OP_I64_GE_U);
    asm.open(OP_IF);
    asm.setk(over, 1);
    asm.br(2);
    asm.end();
    // entry = list_addr + 12 i
    asm.get(list_addr);
    asm.get(i);
    asm.k(12);
    asm.op(OP_I64_MUL);
    asm.op(OP_I64_ADD);
    asm.set(entry);
    asm.ld32(entry, 8);
    asm.set(name_len);
    // if off + name_len <= NAMES
    asm.get(off);
    asm.get(name_len);
    asm.op(OP_I64_ADD);
    asm.ku(NAMES);
    asm.op(OP_I64_LE_U);
    asm.open(OP_IF);
    // name_at = names + off; copy the name
    asm.get(off);
    asm.ku(host.names);
    asm.op(OP_I64_ADD);
    asm.set(name_at);
    asm.ld32(entry, 4);
    asm.set(ptr);
    asm.copy(name_at, ptr, name_len);
    // ptr = preopen_table + 8 + 24 count
    asm.get(count);
    asm.k(24);
    asm.op(OP_I64_MUL);
    asm.ku(add(host.preopen_table, 8));
    asm.op(OP_I64_ADD);
    asm.set(ptr);
    asm.st_begin(ptr);
    asm.ld32(entry, 0);
    asm.st_end(0);
    asm.st(ptr, 8, name_at);
    asm.st(ptr, 16, name_len);
    asm.get(off);
    asm.get(name_len);
    asm.op(OP_I64_ADD);
    asm.set(off);
    asm.addk(count, 1);
    asm.op(OP_ELSE);
    asm.setk(over, 1);
    asm.br(2);
    asm.end();
    asm.addk(i, 1);
    asm.br(0);
    asm.end();
    asm.end();
    // count, or -1 when the preopens did not fit
    asm.sta_begin();
    asm.k(-1);
    asm.get(count);
    asm.get(over);
    asm.op(OP_I64_EQZ);
    asm.op(OP_I32_EQZ);
    asm.op(OP_SELECT);
    asm.st_end(host.preopen_table);
    asm.k(0);
}

// H_RESOLVE(path view) -> the preopen's descriptor, -1 when none fits, -2
// for a NUL byte, -3 when the preopens overflowed the table; the relative path's view goes to misc[8].
fn emit_resolve(inout asm: A, in host: Host, preopens_fn: u32) {
    let path_addr = asm.loc();
    let path_len = asm.loc();
    let i = asm.loc();
    let count = asm.loc();
    let best = asm.loc();
    let best_len = asm.loc();
    let ptr = asm.loc();
    let name_addr = asm.loc();
    let name_len = asm.loc();
    let eq = asm.loc();
    asm.call(preopens_fn);
    asm.op(OP_DROP);
    asm.view_addr(0, path_addr);
    asm.view_len(0, path_len);
    // An empty path names nothing (ENOENT, as natively).
    asm.get(path_len);
    asm.op(OP_I64_EQZ);
    asm.open(OP_IF);
    asm.retk(-1);
    asm.end();
    // NUL check
    asm.setk(i, 0);
    asm.open(OP_BLOCK);
    asm.open(OP_LOOP);
    asm.get(i);
    asm.get(path_len);
    asm.op(OP_I64_GE_U);
    asm.br_if(1);
    asm.get(path_addr);
    asm.get(i);
    asm.op(OP_I64_ADD);
    asm.set(ptr);
    asm.ld8(ptr, 0);
    asm.op(OP_I64_EQZ);
    asm.open(OP_IF);
    asm.retk(-2);
    asm.end();
    asm.addk(i, 1);
    asm.br(0);
    asm.end();
    asm.end();
    asm.lda(host.preopen_table, OP_I64_LOAD);
    asm.set(count);
    asm.get(count);
    asm.k(-1);
    asm.op(OP_I64_EQ);
    asm.open(OP_IF);
    asm.retk(-3);
    asm.end();
    asm.setk(best, -1);
    asm.setk(best_len, 0);
    // absolute: path_len > 0 && byte 0 == '/'
    asm.get(path_len);
    asm.op(OP_I64_EQZ);
    asm.open(OP_IF);
    asm.k(0);
    asm.set(eq);
    asm.op(OP_ELSE);
    asm.ld8(path_addr, 0);
    asm.k(47);
    asm.op(OP_I64_EQ);
    asm.op(OP_I64_EXTEND_I32_U);
    asm.set(eq);
    asm.end();
    asm.get(eq);
    asm.op(OP_I64_EQZ);
    asm.op(OP_I32_EQZ);
    asm.open(OP_IF);
    absolute(
        inout asm,
        in host,
        path_addr,
        path_len,
        i,
        count,
        best,
        best_len,
        ptr,
        name_addr,
        name_len,
        eq
    );
    asm.op(OP_ELSE);
    relative(inout asm, in host, i, count, best, ptr, name_addr);
    asm.end();
    strip(inout asm, in host, path_addr, path_len, best);
}

fn absolute(
    inout asm: A,
    in host: Host,
    path_addr: u32,
    path_len: u32,
    i: u32,
    count: u32,
    best: u32,
    best_len: u32,
    ptr: u32,
    name_addr: u32,
    name_len: u32,
    eq: u32
) {
    asm.setk(i, 0);
    asm.open(OP_BLOCK);
    asm.open(OP_LOOP);
    asm.get(i);
    asm.get(count);
    asm.op(OP_I64_GE_U);
    asm.br_if(1);
    asm.get(i);
    asm.k(24);
    asm.op(OP_I64_MUL);
    asm.ku(add(host.preopen_table, 8));
    asm.op(OP_I64_ADD);
    asm.set(ptr);
    asm.ld(ptr, 8);
    asm.set(name_addr);
    asm.ld(ptr, 16);
    asm.set(name_len);
    // candidate: name_len <= path_len, a prefix, on a boundary, longer than best
    asm.get(name_len);
    asm.get(path_len);
    asm.op(OP_I64_LE_U);
    asm.open(OP_IF);
    prefix_eq(inout asm, path_addr, name_addr, name_len, eq);
    asm.get(eq);
    asm.op(OP_I64_EQZ);
    asm.op(OP_I32_EQZ);
    asm.open(OP_IF);
    // boundary: name_len == path_len || path_addr[name_len] == '/'
    //   || (name_len > 0 && name_addr[name_len-1] == '/')
    asm.get(name_len);
    asm.get(path_len);
    asm.op(OP_I64_EQ);
    asm.get(path_addr);
    asm.get(name_len);
    asm.op(OP_I64_ADD);
    asm.set(eq);
    asm.get(name_len);
    asm.get(path_len);
    asm.op(OP_I64_LT_U);
    asm.open_i32();
    asm.ld8(eq, 0);
    asm.k(47);
    asm.op(OP_I64_EQ);
    asm.op(OP_ELSE);
    asm.code.i32_const(0);
    asm.end();
    asm.op(OP_I32_OR);
    asm.get(name_addr);
    asm.get(name_len);
    asm.op(OP_I64_ADD);
    asm.k(1);
    asm.op(OP_I64_SUB);
    asm.set(eq);
    asm.get(name_len);
    asm.op(OP_I64_EQZ);
    asm.open_i32();
    asm.code.i32_const(0);
    asm.op(OP_ELSE);
    asm.ld8(eq, 0);
    asm.k(47);
    asm.op(OP_I64_EQ);
    asm.end();
    asm.op(OP_I32_OR);
    // && (best < 0 || name_len > best_len)
    asm.get(best);
    asm.k(0);
    asm.op(OP_I64_LT_S);
    asm.get(name_len);
    asm.get(best_len);
    asm.op(OP_I64_GT_U);
    asm.op(OP_I32_OR);
    asm.op(OP_I32_AND);
    asm.open(OP_IF);
    asm.ld(ptr, 0);
    asm.set(best);
    asm.get(name_len);
    asm.set(best_len);
    asm.end();
    asm.end();
    asm.end();
    asm.addk(i, 1);
    asm.br(0);
    asm.end();
    asm.end();
    asm.get(path_addr);
    asm.get(best_len);
    asm.op(OP_I64_ADD);
    asm.set(path_addr);
    asm.get(path_len);
    asm.get(best_len);
    asm.op(OP_I64_SUB);
    asm.set(path_len);
}

fn relative(inout asm: A, in host: Host, i: u32, count: u32, best: u32, slot: u32, name_addr: u32) {
    // relative: the preopen named ".", else the first
    asm.setk(i, 0);
    asm.open(OP_BLOCK);
    asm.open(OP_LOOP);
    asm.get(i);
    asm.get(count);
    asm.op(OP_I64_GE_U);
    asm.br_if(1);
    asm.get(i);
    asm.k(24);
    asm.op(OP_I64_MUL);
    asm.ku(add(host.preopen_table, 8));
    asm.op(OP_I64_ADD);
    asm.set(slot);
    asm.ld(slot, 16);
    asm.k(1);
    asm.op(OP_I64_EQ);
    asm.open(OP_IF);
    asm.ld(slot, 8);
    asm.set(name_addr);
    asm.ld8(name_addr, 0);
    asm.k(46);
    asm.op(OP_I64_EQ);
    asm.open(OP_IF);
    asm.ld(slot, 0);
    asm.set(best);
    asm.br(3);
    asm.end();
    asm.end();
    asm.addk(i, 1);
    asm.br(0);
    asm.end();
    asm.end();
    asm.get(best);
    asm.k(0);
    asm.op(OP_I64_LT_S);
    asm.get(count);
    asm.op(OP_I64_EQZ);
    asm.op(OP_I32_EQZ);
    asm.op(OP_I32_AND);
    asm.open(OP_IF);
    asm.lda(add(host.preopen_table, 8), OP_I64_LOAD);
    asm.set(best);
    asm.end();
}

fn strip(inout asm: A, in host: Host, path_addr: u32, path_len: u32, best: u32) {
    // strip leading "/" and "./"; "." alone is empty
    asm.open(OP_BLOCK);
    asm.open(OP_LOOP);
    asm.get(path_len);
    asm.op(OP_I64_EQZ);
    asm.br_if(1);
    asm.ld8(path_addr, 0);
    asm.k(47);
    asm.op(OP_I64_EQ);
    asm.open(OP_IF);
    asm.addk(path_addr, 1);
    asm.addk(path_len, -1);
    asm.br(1);
    asm.end();
    asm.ld8(path_addr, 0);
    asm.k(46);
    asm.op(OP_I64_NE);
    asm.br_if(1);
    asm.get(path_len);
    asm.k(1);
    asm.op(OP_I64_EQ);
    asm.open(OP_IF);
    asm.setk(path_len, 0);
    asm.br(2);
    asm.end();
    asm.ld8(path_addr, 1);
    asm.k(47);
    asm.op(OP_I64_NE);
    asm.br_if(1);
    asm.addk(path_addr, 2);
    asm.addk(path_len, -2);
    asm.br(0);
    asm.end();
    asm.end();
    asm.get(path_len);
    asm.op(OP_I64_EQZ);
    asm.open(OP_IF);
    asm.ku(add(host.misc, 24));
    asm.set(path_addr);
    asm.setk(path_len, 1);
    asm.end();
    asm.sta_begin();
    asm.get(path_len);
    asm.k(32);
    asm.op(OP_I64_SHL);
    asm.get(path_addr);
    asm.op(OP_I64_OR);
    asm.st_end(add(host.misc, 8));
    asm.get(best);
}

// eq = 1 when bytes x[0..n] == y[0..n] (locals), else 0.
fn prefix_eq(inout asm: A, x: u32, y: u32, n: u32, eq: u32) {
    let j = asm.loc();
    let lhs_at = asm.loc();
    let rhs_at = asm.loc();
    asm.setk(eq, 1);
    asm.setk(j, 0);
    asm.open(OP_BLOCK);
    asm.open(OP_LOOP);
    asm.get(j);
    asm.get(n);
    asm.op(OP_I64_GE_U);
    asm.br_if(1);
    asm.get(x);
    asm.get(j);
    asm.op(OP_I64_ADD);
    asm.set(lhs_at);
    asm.get(y);
    asm.get(j);
    asm.op(OP_I64_ADD);
    asm.set(rhs_at);
    asm.ld8(lhs_at, 0);
    asm.ld8(rhs_at, 0);
    asm.op(OP_I64_NE);
    asm.open(OP_IF);
    asm.setk(eq, 0);
    asm.br(2);
    asm.end();
    asm.addk(j, 1);
    asm.br(0);
    asm.end();
    asm.end();
}

impl A {
    // `if` with an `i32` result
    fn open_i32(inout self) {
        self.code.open_result(OP_IF, vt(VT_I32));
    }
}

// H_SLOT() -> a free slot's address, or 0.
fn emit_slot(inout asm: A, in host: Host) {
    let slot = asm.loc();
    let i = asm.loc();
    asm.setk(i, 0);
    asm.open(OP_BLOCK);
    asm.open(OP_LOOP);
    asm.get(i);
    asm.ku(NSLOT);
    asm.op(OP_I64_GE_U);
    asm.br_if(1);
    asm.get(i);
    asm.ku(SLOT);
    asm.op(OP_I64_MUL);
    asm.ku(host.slots);
    asm.op(OP_I64_ADD);
    asm.set(slot);
    asm.ld(slot, 0);
    asm.op(OP_I64_EQZ);
    asm.open(OP_IF);
    asm.ret(slot);
    asm.end();
    asm.addk(i, 1);
    asm.br(0);
    asm.end();
    asm.end();
    asm.k(0);
}

// H_COPYOUT(src, n, view) -> n: copy when it fits (the shim's `copy_out`).
fn emit_copyout(inout asm: A) {
    let dest_addr = asm.loc();
    asm.get(1);
    asm.get(2);
    asm.k(32);
    asm.op(OP_I64_SHR_U);
    asm.op(OP_I64_LE_U);
    asm.open(OP_IF);
    asm.view_addr(2, dest_addr);
    asm.copy(dest_addr, 0, 1);
    asm.end();
    asm.get(1);
}

// H_KIND(descriptor-type) -> the shim's kind: 1 file, 2 dir, 3 symlink,
// 4 other.
fn emit_kind(inout asm: A) {
    asm.k(1);
    asm.k(2);
    asm.k(3);
    asm.k(4);
    asm.get(0);
    asm.k(5);
    asm.op(OP_I64_EQ);
    asm.op(OP_SELECT);
    asm.get(0);
    asm.k(3);
    asm.op(OP_I64_EQ);
    asm.op(OP_SELECT);
    asm.get(0);
    asm.k(6);
    asm.op(OP_I64_EQ);
    asm.op(OP_SELECT);
}

// Store error word `word_val` (a local) through the `inout u64` cell `err`.
fn put_err(inout asm: A, err: u32, word_val: u32) {
    asm.st(err, 0, word_val);
}

fn put_errk(inout asm: A, err: u32, word_val: i64) {
    asm.stk(err, 0, word_val);
}

// Raise-free failure: store the error word on the stack top... the word
// of WASI code at static `addr` (one byte) through `err`.
fn put_wasi_err(inout builder: Builder, inout host: Host, inout asm: A, err: u32, addr: u64) eff [
    Fail[WErr]
] {
    let err_fn = host_fn(inout builder, inout host, H_ERR);
    asm.st_begin(err);
    asm.lda(addr, OP_I64_LOAD8_U);
    asm.call(err_fn);
    asm.st_end(0);
}

// The result discriminant at ret_area[0] is nonzero (`i32` on the stack).
fn failed(inout asm: A, in host: Host) {
    asm.lda(host.ret_area, OP_I64_LOAD8_U);
    asm.op(OP_I64_EQZ);
    asm.op(OP_I32_EQZ);
}

// `desc = H_RESOLVE(path)`; on -3, -2 or -1 store the error and return
// `fail`.
// Leaves the relative path in `rel_addr`, `rel_len`.
fn resolve(
    inout builder: Builder,
    inout host: Host,
    inout asm: A,
    path: u32,
    err: u32,
    fail: i64,
    desc: u32,
    rel_addr: u32,
    rel_len: u32
) eff [Fail[WErr]] {
    let resolve_fn = host_fn(inout builder, inout host, H_RESOLVE);
    asm.get(path);
    asm.call(resolve_fn);
    asm.set(desc);
    asm.get(desc);
    asm.k(-2);
    asm.op(OP_I64_EQ);
    asm.open(OP_IF);
    put_errk(inout asm, err, 7);
    asm.retk(fail);
    asm.end();
    asm.get(desc);
    asm.k(-3);
    asm.op(OP_I64_EQ);
    asm.open(OP_IF);
    // Unsupported | ENOTSUP << 32: too many preopens for the table
    put_errk(inout asm, err, 11 | (95 << 32));
    asm.retk(fail);
    asm.end();
    asm.get(desc);
    asm.k(0);
    asm.op(OP_I64_LT_S);
    asm.open(OP_IF);
    put_errk(inout asm, err, 1 | (2 << 32));
    asm.retk(fail);
    asm.end();
    let rel_view = asm.loc();
    asm.lda(add(host.misc, 8), OP_I64_LOAD);
    asm.set(rel_view);
    asm.view_addr(rel_view, rel_addr);
    asm.view_len(rel_view, rel_len);
}

// path ops `create-directory-at`, `remove-directory-at`, `unlink-file-at`
// as (path, err) -> status.
const P_MKDIR: u64 = 32;
const P_RMDIR: u64 = 33;
const P_UNLINK: u64 = 34;

fn emit_path_op(inout builder: Builder, inout host: Host, inout asm: A, op_code: u64) eff [
    Fail[WErr]
] {
    let desc = asm.loc();
    let rel_addr = asm.loc();
    let rel_len = asm.loc();
    resolve(inout builder, inout host, inout asm, 0, 1, 1, desc, rel_addr, rel_len);
    asm.w32(desc);
    asm.w32(rel_addr);
    asm.w32(rel_len);
    asm.i32k(host.ret_area);
    asm.call(
        if op_code == P_MKDIR {
            host.i_mkdir
        } else if op_code == P_RMDIR {
            host.i_rmdir
        } else {
            host.i_unlink
        }
    );
    failed(inout asm, in host);
    asm.open(OP_IF);
    put_wasi_err(inout builder, inout host, inout asm, 1, add(host.ret_area, 1));
    asm.retk(1);
    asm.end();
    put_errk(inout asm, 1, 0);
    asm.k(0);
}

fn emit_env(inout builder: Builder, inout host: Host, inout asm: A, op_code: u64) eff [Fail[WErr]] {
    if op_code == ENV_OS {
        asm.k(0);
        return;
    }
    let list_addr = asm.loc();
    let list_len = asm.loc();
    let entry = asm.loc();
    let copy = host_fn(inout builder, inout host, H_COPYOUT);
    if op_code == ENV_CURRENT_DIR {
        // (buf cell, err cell)
        asm.i32k(host.ret_area);
        asm.call(host.i_cwd);
        asm.lda(host.ret_area, OP_I64_LOAD8_U);
        asm.op(OP_I64_EQZ);
        asm.open(OP_IF);
        put_errk(inout asm, 1, 11);
        asm.retk(-1);
        asm.end();
        put_errk(inout asm, 1, 0);
        asm.lda(add(host.ret_area, 4), OP_I64_LOAD32_U);
        asm.lda(add(host.ret_area, 8), OP_I64_LOAD32_U);
        asm.ld(0, 0);
        asm.call(copy);
        return;
    }
    let args = op_code == ENV_ARG_COUNT || op_code == ENV_ARG;
    asm.i32k(host.ret_area);
    asm.call(if args { host.i_args } else { host.i_environ });
    asm.lda(host.ret_area, OP_I64_LOAD32_U);
    asm.set(list_addr);
    asm.lda(add(host.ret_area, 4), OP_I64_LOAD32_U);
    asm.set(list_len);
    if op_code == ENV_ARG_COUNT || op_code == ENV_VAR_COUNT {
        asm.get(list_len);
        return;
    }
    if op_code == ENV_ARG || op_code == ENV_VAR_AT {
        // (index, buf cell)
        asm.get(0);
        asm.get(list_len);
        asm.op(OP_I64_GE_U);
        asm.open(OP_IF);
        asm.retk(-1);
        asm.end();
        asm.get(list_addr);
        asm.get(0);
        asm.k(if args { 8 } else { 16 });
        asm.op(OP_I64_MUL);
        asm.op(OP_I64_ADD);
        asm.set(entry);
        if args {
            asm.ld32(entry, 0);
            asm.ld32(entry, 4);
            asm.ld(1, 0);
            asm.call(copy);
            return;
        }
        // "key=value"
        let total = asm.loc();
        let view = asm.loc();
        let dest = asm.loc();
        let src = asm.loc();
        let n = asm.loc();
        asm.ld32(entry, 4);
        asm.k(1);
        asm.op(OP_I64_ADD);
        asm.ld32(entry, 12);
        asm.op(OP_I64_ADD);
        asm.set(total);
        asm.ld(1, 0);
        asm.set(view);
        asm.get(total);
        asm.get(view);
        asm.k(32);
        asm.op(OP_I64_SHR_U);
        asm.op(OP_I64_LE_U);
        asm.open(OP_IF);
        asm.view_addr(view, dest);
        asm.ld32(entry, 0);
        asm.set(src);
        asm.ld32(entry, 4);
        asm.set(n);
        asm.copy(dest, src, n);
        asm.get(dest);
        asm.get(n);
        asm.op(OP_I64_ADD);
        asm.set(dest);
        asm.st_begin(dest);
        asm.k(61);
        asm.st8_end(0);
        asm.addk(dest, 1);
        asm.ld32(entry, 8);
        asm.set(src);
        asm.ld32(entry, 12);
        asm.set(n);
        asm.copy(dest, src, n);
        asm.end();
        asm.get(total);
        return;
    }
    // ENV_VAR (key view, buf cell): the first entry with that key
    let key_addr = asm.loc();
    let key_len = asm.loc();
    let i = asm.loc();
    let key_byte_at = asm.loc();
    let eq = asm.loc();
    let src = asm.loc();
    asm.view_addr(0, key_addr);
    asm.view_len(0, key_len);
    asm.get(key_len);
    asm.op(OP_I64_EQZ);
    asm.open(OP_IF);
    asm.retk(-1);
    asm.end();
    asm.setk(i, 0);
    asm.open(OP_BLOCK);
    asm.open(OP_LOOP);
    asm.get(i);
    asm.get(key_len);
    asm.op(OP_I64_GE_U);
    asm.br_if(1);
    asm.get(key_addr);
    asm.get(i);
    asm.op(OP_I64_ADD);
    asm.set(key_byte_at);
    asm.ld8(key_byte_at, 0);
    asm.k(61);
    asm.op(OP_I64_EQ);
    asm.ld8(key_byte_at, 0);
    asm.op(OP_I64_EQZ);
    asm.op(OP_I32_OR);
    asm.open(OP_IF);
    asm.retk(-1);
    asm.end();
    asm.addk(i, 1);
    asm.br(0);
    asm.end();
    asm.end();
    asm.setk(i, 0);
    asm.open(OP_BLOCK);
    asm.open(OP_LOOP);
    asm.get(i);
    asm.get(list_len);
    asm.op(OP_I64_GE_U);
    asm.br_if(1);
    asm.get(list_addr);
    asm.get(i);
    asm.k(16);
    asm.op(OP_I64_MUL);
    asm.op(OP_I64_ADD);
    asm.set(entry);
    asm.ld32(entry, 4);
    asm.get(key_len);
    asm.op(OP_I64_EQ);
    asm.open(OP_IF);
    asm.ld32(entry, 0);
    asm.set(src);
    prefix_eq(inout asm, src, key_addr, key_len, eq);
    asm.get(eq);
    asm.op(OP_I64_EQZ);
    asm.op(OP_I32_EQZ);
    asm.open(OP_IF);
    asm.ld32(entry, 8);
    asm.ld32(entry, 12);
    asm.ld(1, 0);
    asm.call(copy);
    asm.op(OP_RETURN);
    asm.end();
    asm.end();
    asm.addk(i, 1);
    asm.br(0);
    asm.end();
    asm.end();
    asm.k(-1);
}

// The descriptor of handle (slot) `slot` into local `desc`.
fn slot_desc(inout asm: A, slot: u32, off: u64, desc: u32) {
    asm.ld(slot, off);
    asm.k(1);
    asm.op(OP_I64_SUB);
    asm.set(desc);
}

fn emit_fs(inout builder: Builder, inout host: Host, inout asm: A, op_code: u64) eff [Fail[WErr]] {
    if op_code == FS_REMOVE_FILE || op_code == FS_REMOVE_DIR || op_code == FS_CREATE_DIR {
        let path: u32 = 0;
        let flag: u32 = 1;
        let err: u32 = if op_code == FS_REMOVE_FILE { 1 } else { 2 };
        if op_code == FS_REMOVE_DIR {
            asm.get(flag);
            asm.op(OP_I64_EQZ);
            asm.op(OP_I32_EQZ);
            asm.open(OP_IF);
            put_errk(inout asm, err, 11 | (95 << 32));
            asm.retk(1);
            asm.end();
        }
        if op_code == FS_CREATE_DIR {
            asm.get(flag);
            asm.op(OP_I64_EQZ);
            asm.op(OP_I32_EQZ);
            asm.open(OP_IF);
            create_dir_all(inout builder, inout host, inout asm);
            asm.end();
        }
        let path_op_fn = host_fn(
            inout builder,
            inout host,
            if op_code == FS_REMOVE_FILE {
                P_UNLINK
            } else if op_code == FS_REMOVE_DIR {
                P_RMDIR
            } else {
                P_MKDIR
            }
        );
        asm.get(path);
        asm.get(err);
        asm.call(path_op_fn);
        return;
    }
    if op_code == FS_PARENT_LEN {
        let path_addr = asm.loc();
        let i = asm.loc();
        let byte_ptr = asm.loc();
        asm.view_addr(0, path_addr);
        asm.view_len(0, i);
        asm.open(OP_BLOCK);
        asm.open(OP_LOOP);
        asm.get(i);
        asm.op(OP_I64_EQZ);
        asm.br_if(1);
        asm.get(path_addr);
        asm.get(i);
        asm.op(OP_I64_ADD);
        asm.k(1);
        asm.op(OP_I64_SUB);
        asm.set(byte_ptr);
        asm.ld8(byte_ptr, 0);
        asm.k(47);
        asm.op(OP_I64_EQ);
        asm.open(OP_IF);
        asm.ret(i);
        asm.end();
        asm.addk(i, -1);
        asm.br(0);
        asm.end();
        asm.end();
        asm.k(0);
        return;
    }
    if op_code == FS_UNIQUE {
        let counter = asm.loc();
        asm.lda(add(host.misc, 16), OP_I64_LOAD);
        asm.set(counter);
        asm.sta_begin();
        asm.get(counter);
        asm.k(1);
        asm.op(OP_I64_ADD);
        asm.st_end(add(host.misc, 16));
        asm.get(counter);
        asm.ku(MASK32);
        asm.op(OP_I64_AND);
        return;
    }
    let desc = asm.loc();
    let rel_addr = asm.loc();
    let rel_len = asm.loc();
    if op_code == FS_OPEN || op_code == FS_READ_DIR || op_code == FS_SYNC_DIR {
        // (path, mode, err) / (path, err)
        let err: u32 = if op_code == FS_OPEN { 2 } else { 1 };
        let open_flags = asm.loc();
        let desc_flags = asm.loc();
        let append_mode = asm.loc();
        asm.setk(append_mode, 0);
        asm.setk(open_flags, 2);
        asm.setk(desc_flags, 1);
        if op_code == FS_OPEN {
            // modes: 0 read, 1 truncate, 2 create new, 3 append
            asm.get(1);
            asm.k(3);
            asm.op(OP_I64_GT_U);
            asm.open(OP_IF);
            put_errk(inout asm, err, 7);
            asm.retk(0);
            asm.end();
            asm.setk(open_flags, 0);
            asm.get(1);
            asm.op(OP_I64_EQZ);
            asm.op(OP_I32_EQZ);
            asm.open(OP_IF);
            asm.setk(desc_flags, 2);
            asm.k(9);
            asm.k(5);
            asm.k(1);
            asm.get(1);
            asm.k(2);
            asm.op(OP_I64_EQ);
            asm.op(OP_SELECT);
            asm.get(1);
            asm.k(1);
            asm.op(OP_I64_EQ);
            asm.op(OP_SELECT);
            asm.set(open_flags);
            asm.get(1);
            asm.k(3);
            asm.op(OP_I64_EQ);
            asm.op(OP_I64_EXTEND_I32_U);
            asm.set(append_mode);
            asm.end();
        }
        let fail: i64 = if op_code == FS_SYNC_DIR { 1 } else { 0 };
        resolve(inout builder, inout host, inout asm, 0, err, fail, desc, rel_addr, rel_len);
        asm.w32(desc);
        asm.i32k(1);
        asm.w32(rel_addr);
        asm.w32(rel_len);
        asm.w32(open_flags);
        asm.w32(desc_flags);
        asm.i32k(host.ret_area);
        asm.call(host.i_open_at);
        failed(inout asm, in host);
        asm.open(OP_IF);
        put_wasi_err(inout builder, inout host, inout asm, err, add(host.ret_area, 4));
        asm.retk(fail);
        asm.end();
        let new_desc = asm.loc();
        asm.lda(add(host.ret_area, 4), OP_I64_LOAD32_U);
        asm.set(new_desc);
        if op_code == FS_SYNC_DIR {
            // Flush the directory entries (a rename into it), then release
            // the descriptor on both paths.
            asm.w32(new_desc);
            asm.i32k(host.ret_area);
            asm.call(host.i_sync);
            asm.w32(new_desc);
            asm.call(host.i_drop_desc);
            failed(inout asm, in host);
            asm.open(OP_IF);
            put_wasi_err(inout builder, inout host, inout asm, err, add(host.ret_area, 1));
            asm.retk(1);
            asm.end();
            put_errk(inout asm, err, 0);
            asm.k(0);
            return;
        }
        let stream = asm.loc();
        if op_code == FS_READ_DIR {
            asm.w32(new_desc);
            asm.i32k(host.ret_area);
            asm.call(host.i_readdir);
            failed(inout asm, in host);
            asm.open(OP_IF);
            put_wasi_err(inout builder, inout host, inout asm, err, add(host.ret_area, 4));
            asm.w32(new_desc);
            asm.call(host.i_drop_desc);
            asm.retk(0);
            asm.end();
            asm.lda(add(host.ret_area, 4), OP_I64_LOAD32_U);
            asm.set(stream);
        }
        let slot_addr = asm.loc();
        let slot = host_fn(inout builder, inout host, H_SLOT);
        asm.call(slot);
        asm.set(slot_addr);
        asm.get(slot_addr);
        asm.op(OP_I64_EQZ);
        asm.open(OP_IF);
        if op_code == FS_READ_DIR {
            asm.w32(stream);
            asm.call(host.i_drop_stream);
        }
        asm.w32(new_desc);
        asm.call(host.i_drop_desc);
        put_errk(inout asm, err, 13 | (24 << 32));
        asm.retk(0);
        asm.end();
        if op_code == FS_OPEN {
            asm.st_begin(slot_addr);
            asm.get(new_desc);
            asm.k(1);
            asm.op(OP_I64_ADD);
            asm.st_end(0);
            asm.stk(slot_addr, 8, 0);
            asm.st(slot_addr, 16, append_mode);
        } else {
            asm.st_begin(slot_addr);
            asm.get(stream);
            asm.k(1);
            asm.op(OP_I64_ADD);
            asm.st_end(0);
            asm.stk(slot_addr, 8, 0);
            asm.st_begin(slot_addr);
            asm.get(new_desc);
            asm.k(1);
            asm.op(OP_I64_ADD);
            asm.st_end(32);
        }
        put_errk(inout asm, err, 0);
        asm.get(slot_addr);
        return;
    }
    if op_code == FS_FILE_LEN {
        slot_desc(inout asm, 0, 0, desc);
        asm.w32(desc);
        asm.i32k(host.ret_area);
        asm.call(host.i_stat);
        failed(inout asm, in host);
        asm.open(OP_IF);
        asm.retk(0);
        asm.end();
        asm.lda(add(host.ret_area, 24), OP_I64_LOAD);
        return;
    }
    if op_code == FS_WRITE_STDOUT || op_code == FS_WRITE_STDERR {
        let addr = asm.loc();
        let len = asm.loc();
        let off = asm.loc();
        let chunk = asm.loc();
        let stream = asm.loc();
        asm.view_addr(0, addr);
        asm.view_len(0, len);
        asm.call(
            if op_code == FS_WRITE_STDOUT {
                host.i_stdout
            } else {
                host.i_stderr
            }
        );
        asm.op(OP_I64_EXTEND_I32_U);
        asm.set(stream);
        asm.setk(off, 0);
        asm.open(OP_BLOCK);
        asm.open(OP_LOOP);
        asm.get(off);
        asm.get(len);
        asm.op(OP_I64_GE_U);
        asm.br_if(1);
        asm.get(len);
        asm.get(off);
        asm.op(OP_I64_SUB);
        asm.set(chunk);
        asm.get(chunk);
        asm.k(4096);
        asm.op(OP_I64_GT_U);
        asm.open(OP_IF);
        asm.setk(chunk, 4096);
        asm.end();
        asm.w32(stream);
        asm.get(addr);
        asm.get(off);
        asm.op(OP_I64_ADD);
        asm.op(OP_I32_WRAP_I64);
        asm.w32(chunk);
        asm.i32k(host.ret_area);
        asm.call(host.i_write_stream);
        failed(inout asm, in host);
        asm.open(OP_IF);
        asm.w32(stream);
        asm.call(host.i_drop_out_stream);
        // IoKind::Other (12)
        put_errk(inout asm, 1, 12);
        asm.retk(0);
        asm.end();
        asm.get(off);
        asm.get(chunk);
        asm.op(OP_I64_ADD);
        asm.set(off);
        asm.br(0);
        asm.end();
        asm.end();
        asm.w32(stream);
        asm.call(host.i_drop_out_stream);
        put_errk(inout asm, 1, 0);
        asm.k(1);
        return;
    }
    if op_code == FS_CLOSE || op_code == FS_DIR_CLOSE {
        slot_desc(inout asm, 0, 0, desc);
        asm.w32(desc);
        asm.call(
            if op_code == FS_CLOSE {
                host.i_drop_desc
            } else {
                host.i_drop_stream
            }
        );
        if op_code == FS_DIR_CLOSE {
            slot_desc(inout asm, 0, 32, desc);
            asm.w32(desc);
            asm.call(host.i_drop_desc);
        }
        asm.stk(0, 0, 0);
        asm.k(0);
        return;
    }
    if op_code == FS_SYNC {
        slot_desc(inout asm, 0, 0, desc);
        asm.w32(desc);
        asm.i32k(host.ret_area);
        asm.call(host.i_sync);
        failed(inout asm, in host);
        asm.open(OP_IF);
        put_wasi_err(inout builder, inout host, inout asm, 1, add(host.ret_area, 1));
        asm.retk(1);
        asm.end();
        put_errk(inout asm, 1, 0);
        asm.k(0);
        return;
    }
    if op_code == FS_READ {
        // (file, buf cell, err cell)
        let buf_addr = asm.loc();
        let buf_len = asm.loc();
        let done = asm.loc();
        let read_addr = asm.loc();
        let read_len = asm.loc();
        let scratch = asm.loc();
        slot_desc(inout asm, 0, 0, desc);
        asm.ld(1, 0);
        asm.set(scratch);
        asm.view_addr(scratch, buf_addr);
        asm.view_len(scratch, buf_len);
        asm.setk(done, 0);
        asm.open(OP_BLOCK);
        asm.open(OP_LOOP);
        asm.get(done);
        asm.get(buf_len);
        asm.op(OP_I64_GE_U);
        asm.br_if(1);
        asm.w32(desc);
        asm.get(buf_len);
        asm.get(done);
        asm.op(OP_I64_SUB);
        asm.ld(0, 8);
        asm.i32k(host.ret_area);
        asm.call(host.i_read);
        failed(inout asm, in host);
        asm.open(OP_IF);
        put_wasi_err(inout builder, inout host, inout asm, 2, add(host.ret_area, 4));
        asm.ret(done);
        asm.end();
        asm.lda(add(host.ret_area, 4), OP_I64_LOAD32_U);
        asm.set(read_addr);
        asm.lda(add(host.ret_area, 8), OP_I64_LOAD32_U);
        asm.set(read_len);
        asm.get(read_len);
        asm.op(OP_I64_EQZ);
        asm.br_if(1);
        // read_len = min(read_len, buf_len - done)
        asm.get(read_len);
        asm.get(buf_len);
        asm.get(done);
        asm.op(OP_I64_SUB);
        asm.set(scratch);
        asm.get(scratch);
        asm.get(read_len);
        asm.get(scratch);
        asm.op(OP_I64_LT_U);
        asm.op(OP_SELECT);
        asm.set(read_len);
        asm.get(buf_addr);
        asm.get(done);
        asm.op(OP_I64_ADD);
        asm.set(scratch);
        asm.copy(scratch, read_addr, read_len);
        asm.get(done);
        asm.get(read_len);
        asm.op(OP_I64_ADD);
        asm.set(done);
        asm.st_begin(0);
        asm.ld(0, 8);
        asm.get(read_len);
        asm.op(OP_I64_ADD);
        asm.st_end(8);
        asm.br(0);
        asm.end();
        asm.end();
        put_errk(inout asm, 2, 0);
        asm.get(done);
        return;
    }
    if op_code == FS_WRITE {
        // (file, buf view, err cell)
        let buf_addr = asm.loc();
        let buf_len = asm.loc();
        let done = asm.loc();
        let off = asm.loc();
        let n = asm.loc();
        slot_desc(inout asm, 0, 0, desc);
        asm.view_addr(1, buf_addr);
        asm.view_len(1, buf_len);
        asm.ld(0, 8);
        asm.set(off);
        asm.ld(0, 16);
        asm.op(OP_I64_EQZ);
        asm.op(OP_I32_EQZ);
        asm.open(OP_IF);
        asm.w32(desc);
        asm.i32k(host.ret_area);
        asm.call(host.i_stat);
        failed(inout asm, in host);
        asm.open(OP_IF);
        put_wasi_err(inout builder, inout host, inout asm, 2, add(host.ret_area, 8));
        asm.retk(1);
        asm.end();
        asm.lda(add(host.ret_area, 24), OP_I64_LOAD);
        asm.set(off);
        asm.end();
        asm.setk(done, 0);
        asm.open(OP_BLOCK);
        asm.open(OP_LOOP);
        asm.get(done);
        asm.get(buf_len);
        asm.op(OP_I64_GE_U);
        asm.br_if(1);
        asm.w32(desc);
        asm.get(buf_addr);
        asm.get(done);
        asm.op(OP_I64_ADD);
        asm.op(OP_I32_WRAP_I64);
        asm.get(buf_len);
        asm.get(done);
        asm.op(OP_I64_SUB);
        asm.op(OP_I32_WRAP_I64);
        asm.get(off);
        asm.get(done);
        asm.op(OP_I64_ADD);
        asm.i32k(host.ret_area);
        asm.call(host.i_write);
        failed(inout asm, in host);
        asm.open(OP_IF);
        keep_pos(inout asm, off, done);
        put_wasi_err(inout builder, inout host, inout asm, 2, add(host.ret_area, 8));
        asm.retk(1);
        asm.end();
        asm.lda(add(host.ret_area, 8), OP_I64_LOAD);
        asm.set(n);
        asm.get(n);
        asm.op(OP_I64_EQZ);
        asm.open(OP_IF);
        keep_pos(inout asm, off, done);
        put_errk(inout asm, 2, 10);
        asm.retk(1);
        asm.end();
        asm.get(done);
        asm.get(n);
        asm.op(OP_I64_ADD);
        asm.set(done);
        asm.br(0);
        asm.end();
        asm.end();
        asm.st_begin(0);
        asm.get(off);
        asm.get(buf_len);
        asm.op(OP_I64_ADD);
        asm.st_end(8);
        put_errk(inout asm, 2, 0);
        asm.k(0);
        return;
    }
    if op_code == FS_RENAME {
        // (from, to, err)
        let to_desc = asm.loc();
        let to_rel_addr = asm.loc();
        let to_rel_len = asm.loc();
        resolve(inout builder, inout host, inout asm, 0, 2, 1, desc, rel_addr, rel_len);
        resolve(inout builder, inout host, inout asm, 1, 2, 1, to_desc, to_rel_addr, to_rel_len);
        asm.w32(desc);
        asm.w32(rel_addr);
        asm.w32(rel_len);
        asm.w32(to_desc);
        asm.w32(to_rel_addr);
        asm.w32(to_rel_len);
        asm.i32k(host.ret_area);
        asm.call(host.i_rename);
        failed(inout asm, in host);
        asm.open(OP_IF);
        put_wasi_err(inout builder, inout host, inout asm, 2, add(host.ret_area, 1));
        asm.retk(1);
        asm.end();
        put_errk(inout asm, 2, 0);
        asm.k(0);
        return;
    }
    if op_code == FS_METADATA {
        // (path, follow, meta block, err cell)
        let kind = host_fn(inout builder, inout host, H_KIND);
        resolve(inout builder, inout host, inout asm, 0, 3, 1, desc, rel_addr, rel_len);
        asm.w32(desc);
        asm.get(1);
        asm.op(OP_I64_EQZ);
        asm.op(OP_I32_EQZ);
        asm.w32(rel_addr);
        asm.w32(rel_len);
        asm.i32k(host.ret_area);
        asm.call(host.i_stat_at);
        failed(inout asm, in host);
        asm.open(OP_IF);
        put_wasi_err(inout builder, inout host, inout asm, 3, add(host.ret_area, 8));
        asm.retk(1);
        asm.end();
        asm.st_begin(2);
        asm.lda(add(host.ret_area, 24), OP_I64_LOAD);
        asm.st_end(0);
        asm.lda(add(host.ret_area, 56), OP_I64_LOAD8_U);
        asm.op(OP_I64_EQZ);
        asm.open(OP_IF);
        asm.stk(2, 8, 0);
        asm.stk(2, 16, 0);
        asm.op(OP_ELSE);
        asm.st_begin(2);
        asm.lda(add(host.ret_area, 64), OP_I64_LOAD);
        asm.st_end(8);
        asm.st_begin(2);
        asm.lda(add(host.ret_area, 72), OP_I64_LOAD32_U);
        asm.st_end(16);
        asm.end();
        asm.st_begin(2);
        asm.lda(add(host.ret_area, 8), OP_I64_LOAD8_U);
        asm.call(kind);
        asm.st_end(24);
        put_errk(inout asm, 3, 0);
        asm.k(0);
        return;
    }
    // FS_DIR_NEXT (dir, buf cell, kind cell)
    let kind = host_fn(inout builder, inout host, H_KIND);
    let name_len = asm.loc();
    let name_addr = asm.loc();
    let name_dst = asm.loc();
    let view = asm.loc();
    asm.ld(0, 8);
    asm.op(OP_I64_EQZ);
    asm.open(OP_IF);
    slot_desc(inout asm, 0, 0, desc);
    asm.w32(desc);
    asm.i32k(host.ret_area);
    asm.call(host.i_read_entry);
    failed(inout asm, in host);
    asm.open(OP_IF);
    asm.retk(-1);
    asm.end();
    asm.lda(add(host.ret_area, 4), OP_I64_LOAD8_U);
    asm.op(OP_I64_EQZ);
    asm.open(OP_IF);
    asm.retk(-1);
    asm.end();
    asm.lda(add(host.ret_area, 12), OP_I64_LOAD32_U);
    asm.set(name_addr);
    asm.lda(add(host.ret_area, 16), OP_I64_LOAD32_U);
    asm.set(name_len);
    asm.get(name_len);
    asm.ku(wrapping_sub(SLOT, 48));
    asm.op(OP_I64_GT_U);
    asm.open(OP_IF);
    asm.retk(-1);
    asm.end();
    asm.get(0);
    asm.k(48);
    asm.op(OP_I64_ADD);
    asm.set(name_dst);
    asm.copy(name_dst, name_addr, name_len);
    asm.st(0, 16, name_len);
    asm.st_begin(0);
    asm.lda(add(host.ret_area, 8), OP_I64_LOAD8_U);
    asm.call(kind);
    asm.st_end(24);
    asm.stk(0, 8, 1);
    asm.end();
    asm.ld(0, 16);
    asm.set(name_len);
    asm.ld(1, 0);
    asm.set(view);
    asm.get(name_len);
    asm.get(view);
    asm.k(32);
    asm.op(OP_I64_SHR_U);
    asm.op(OP_I64_LE_U);
    asm.open(OP_IF);
    asm.view_addr(view, name_dst);
    asm.get(0);
    asm.k(48);
    asm.op(OP_I64_ADD);
    asm.set(name_addr);
    asm.copy(name_dst, name_addr, name_len);
    asm.stk(0, 8, 0);
    asm.st_begin(2);
    asm.ld(0, 24);
    asm.st_end(0);
    asm.end();
    asm.get(name_len);
}

// `create_dir(path, true, err)`: create each prefix ending before a `/`
// and the whole path, accepting `exist` (create_dir_all). Returns from
// the shim.
// The file slot's position after a write that stopped early: the bytes
// already written still move it, as natively.
fn keep_pos(inout asm: A, off: u32, done: u32) {
    asm.st_begin(0);
    asm.get(off);
    asm.get(done);
    asm.op(OP_I64_ADD);
    asm.st_end(8);
}

fn create_dir_all(inout builder: Builder, inout host: Host, inout asm: A) eff [Fail[WErr]] {
    let desc = asm.loc();
    let rel_addr = asm.loc();
    let rel_len = asm.loc();
    let j = asm.loc();
    let byte_ptr = asm.loc();
    resolve(inout builder, inout host, inout asm, 0, 2, 1, desc, rel_addr, rel_len);
    asm.setk(j, 1);
    asm.open(OP_BLOCK);
    asm.open(OP_LOOP);
    asm.get(j);
    asm.get(rel_len);
    asm.op(OP_I64_GT_U);
    asm.br_if(1);
    asm.get(rel_addr);
    asm.get(j);
    asm.op(OP_I64_ADD);
    asm.set(byte_ptr);
    // j == rel_len || rel_addr[j] == '/'
    asm.get(j);
    asm.get(rel_len);
    asm.op(OP_I64_EQ);
    asm.open_i32();
    asm.code.i32_const(1);
    asm.op(OP_ELSE);
    asm.ld8(byte_ptr, 0);
    asm.k(47);
    asm.op(OP_I64_EQ);
    asm.end();
    asm.open(OP_IF);
    asm.w32(desc);
    asm.w32(rel_addr);
    asm.w32(j);
    asm.i32k(host.ret_area);
    asm.call(host.i_mkdir);
    failed(inout asm, in host);
    asm.open(OP_IF);
    asm.lda(add(host.ret_area, 1), OP_I64_LOAD8_U);
    asm.k(7);
    asm.op(OP_I64_NE);
    asm.open(OP_IF);
    put_wasi_err(inout builder, inout host, inout asm, 2, add(host.ret_area, 1));
    asm.retk(1);
    asm.end();
    // The whole path exists: fine only when it is a directory.
    asm.get(j);
    asm.get(rel_len);
    asm.op(OP_I64_EQ);
    asm.open(OP_IF);
    asm.w32(desc);
    asm.code.i32_const(1);
    asm.w32(rel_addr);
    asm.w32(rel_len);
    asm.i32k(host.ret_area);
    asm.call(host.i_stat_at);
    failed(inout asm, in host);
    asm.open(OP_IF);
    put_wasi_err(inout builder, inout host, inout asm, 2, add(host.ret_area, 8));
    asm.retk(1);
    asm.end();
    asm.lda(add(host.ret_area, 8), OP_I64_LOAD8_U);
    asm.k(3);
    asm.op(OP_I64_NE);
    asm.open(OP_IF);
    // AlreadyExists | EEXIST << 32
    put_errk(inout asm, 2, 73014444035);
    asm.retk(1);
    asm.end();
    asm.end();
    asm.end();
    asm.end();
    asm.addk(j, 1);
    asm.br(0);
    asm.end();
    asm.end();
    put_errk(inout asm, 2, 0);
    asm.retk(0);
}
