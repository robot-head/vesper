// Constant tables in the port: a use of a constant aggregate
// (`$table$NAME`, src/arrays.rs) as read-only static data.

use @vesper/check-data::names::{
    Names,
    names_new
};
pub use @vesper/check-data::util::{
    stage2_heap_mark,
    stage2_heap_reset,
    stage2_heap_swap
};
use @vesper/check-data::types::{
    TyKind,
    TyMode,
    types_new
};
use @vesper/check-data::world::{
    Bounds,
    Known,
    mode_of,
    world_new
};
use @vesper/place-ir::{
    program_new
};
use @vesper/place-ir::codes::{
    Lit,
    Op
};
use @vesper/check-data::util::{
    add,
    inc,
    n32,
    u64_at,
    u8_at,
    w
};
use self::err::{
    WErr,
    werr,
    werr_syms
};
use self::enc::{
    Code,
    OP_ELSE,
    OP_END,
    OP_I32_AND,
    OP_I32_EQ,
    OP_I32_OR,
    OP_I32_WRAP_I64,
    OP_I64_ADD,
    OP_I64_AND,
    OP_I64_EXTEND_I32_U,
    OP_I64_GE_U,
    OP_I64_GT_U,
    OP_I64_LE_U,
    OP_I64_LT_U,
    OP_I64_NE,
    OP_I64_OR,
    OP_I64_SHL,
    OP_I64_SHR_U,
    OP_I64_SUB,
    OP_IF,
    OP_LOOP,
    OP_RETURN,
    OP_SELECT,
    OP_UNREACHABLE,
    code_new
};
