// Enums on the optimize path (#2737). The Rust walk's optimize path keeps
// small enums as words (`aggregates::scalar_enums` in `ir_graph_at`), and
// @vesper/codegen-scalar plans a graph that way only from the facts after
// the program (`aggregate_facts`: the world's functions, element views and
// each graph's `scalar_enum_facts`). The calls input has no such facts, so
// on the optimize path a graph whose types hold an enum anywhere would be
// planned with its enums in memory: a different body from the walk's.
// Until native-lib makes those facts, such a graph has no body plan.
// A `try_get` fused with its block's `match` (`fused_try_gets`) is no
// enum in either plan: the walk keeps only its bounds check and element
// address, so its `Option` does not count.

use @vesper/check-data::util::{add, n32, u64_at, w};
use @vesper/check-data::input::{Ctx};
use @vesper/check-layout::{L_ENUM, L_PRODUCT, Layouts, layout_of};
use @vesper/codegen-scalar::body::{FUSED_READ_WORDS, fused_try_gets};
use @vesper/place-ir::{Program, Tag};

// No layout (`layout_of`'s refusal).
const NO_LAYOUT: u32 = 4294967295;

// Whether layout `l` is an enum or holds one in a field.
fn layout_enum(in ls: Layouts, l: u32) -> bool {
    let node = ls.node(l);
    if node.kind == L_ENUM {
        return true;
    }
    if node.kind == L_PRODUCT {
        for k in 0..widen_u64(node.n) {
            let field = ls.lfield(add(widen_u64(node.a), k));
            if layout_enum(in ls, field.layout) {
                return true;
            }
        }
    }
    false
}

// Whether type `ty` is or holds an enum. A type without a layout (an
// effect row) is not: the planner refuses a value of one itself.
fn type_enum(inout ls: Layouts, inout c: Ctx, ty: u32) -> bool {
    let l = layout_of(inout ls, inout c.types, inout c.names, in c.world, ty);
    l != NO_LAYOUT && layout_enum(in ls, l)
}

// Whether value id `v` is one of the fused reads `reads`.
fn fused(in reads: ChunkSeq[u64], v: u64) -> bool {
    let mut k: u64 = 0;
    loop {
        if k >= reads.len() {
            break;
        }
        if u64_at(in reads, k) == v {
            return true;
        }
        k = add(k, FUSED_READ_WORDS);
    }
    false
}

// Words `a..a+n` of `p`: whether a type among them is or holds an enum,
// past the type of a fused read's value (a `(value, type)` pair).
fn words_enum(
    inout ls: Layouts,
    inout c: Ctx,
    in p: Program,
    in reads: ChunkSeq[u64],
    a: u64,
    n: u64
) -> bool {
    for i in a..add(a, n) {
        let read_type = i > a
            && p.tag(wrapping_sub(i, 1)) == Tag::Value
            && fused(in reads, p.op(wrapping_sub(i, 1)));
        if p.tag(i) == Tag::Type && !read_type && type_enum(inout ls, inout c, n32(p.op(i))) {
            return true;
        }
    }
    false
}

// Whether graph `fi` of `p` names an enum type: in its header (the
// parameters, result, values and locals), an instruction's type or a
// call's type arguments.
pub fn graph_enums(inout ls: Layouts, inout c: Ctx, in p: Program, fi: u64) -> bool {
    let f = p.function(fi);
    let reads = fused_try_gets(inout c.names, in p, fi);
    if words_enum(inout ls, inout c, in p, in reads, f.ha, f.hn) {
        return true;
    }
    for bi in f.b0..add(f.b0, f.bc) {
        let block = p.block(bi);
        for ii in block.i0..add(block.i0, block.ic) {
            let inst = p.inst(ii);
            let read = fused(in reads, widen_u64(inst.dest));
            if (!read && type_enum(inout ls, inout c, inst.ty))
                || words_enum(inout ls, inout c, in p, in reads, inst.a, inst.n)
            {
                return true;
            }
        }
    }
    false
}
