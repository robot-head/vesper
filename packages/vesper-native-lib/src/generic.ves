// Generic instances (#2737, the native-lib half of #2715): an instance
// bound to type arguments is planned from its own program, as
// `codegen_swap::instance_program` lends it to the body hook. The program
// holds the instance's graph with every type substituted
// (`verified_codegen::mono::instantiate`), its bounds cleared, named by
// `mono::instance_name`, next to its direct callees' graphs as they are.
// @vesper/codegen-scalar plans that program, and the instance takes the
// plan of its own graph.
//
// The instances are found again in the walk's program (the calls input
// @vesper/library-ir writes back), in instance order, so their type
// arguments are that input's type ids. An instance bound to a function
// value or a `dyn` argument is planned here too, but the plain gate
// (`frame_plan`) keeps it from the body hook.

use @vesper/check-data::util::{add, inc, n32, u32_at, w};
use @vesper/check-data::names::{Names};
use @vesper/check-data::types::{TyKind, Types, Vars, display, substitute, substitute_row};
use @vesper/check-data::input::{Ctx, Reader, put_world, read_ctx};
use @vesper/place-ir::{Op, Program, Tag, put_names, put_types, read_program};
use @vesper/codegen-calls::data::{Calls, read_calls};
use @vesper/codegen-calls::instances::{IVars, cmp_names, discover_roots, program_facts, syms_new};
use @vesper/codegen-scalar::{codegen_scalar_body_plan_prefix};
use @vesper/check-layout::{layouts_new};
use super::enums::{graph_enums};

// The bytes of one input word.
const WORD_BYTES: u64 = 8;
// A body plan entry's function and word count, before its words.
const PLAN_HEADER_WORDS: u64 = 2;
// No plan for an instance (not generic, or the planner refused it).
pub const NO_INSTANCE_PLAN: u64 = 18446744073709551615;
// `mono::instance_name`'s punctuation: `name<K=T,U=V>`.
const LESS: u8 = 60;
const GREATER: u8 = 62;
const EQUALS: u8 = 61;
const COMMA: u8 = 44;
// A graph header's words (place-ir `header`): per parameter its name,
// pass and projection count, the projections, then its type and span;
// after the parameters the result and the effects, then the bounds'
// count and their (name, mode) pairs.
const PARAM_FIXED_WORDS: u64 = 6;
const PARAM_PATHS_AT: u64 = 2;
const BOUNDS_AFTER_PARAMS: u64 = 2;
const BOUND_WORDS: u64 = 2;

// The plans of the generic instances: `words` holds one codegen-scalar
// `[function, n, n words]` entry per planned instance, and `at[i]` is the
// start of instance `i`'s plan words (`NO_INSTANCE_PLAN` when it has
// none). `generic[i]` is 1 for an instance with type arguments, whose
// generic graph's plan must not be taken.
pub struct InstancePlans {
    pub words: ChunkSeq[u64],
    pub at: ChunkSeq[u64],
    pub generic: ChunkSeq[u64],
}

// The generic instances' plans over the walk's calls input `walk`, whose
// first library task's instances are the `count` declared ones.
pub fn instance_plans(in walk: Slice[u8], count: u64, optimize: bool) -> InstancePlans {
    let mut out = InstancePlans {
        words: ChunkSeq::new[u64](),
        at: ChunkSeq::new[u64](),
        generic: ChunkSeq::new[u64](),
    };
    out.at.resize(count, NO_INSTANCE_PLAN);
    out.generic.resize(count, 0);
    let mut r = Reader { pos: 0 };
    let mut c = read_ctx(inout r, in walk);
    let p = read_program(inout r, in walk, in c);
    let calls = read_calls(inout r, in walk, in c);
    let k = syms_new(inout c.names);
    let facts = program_facts(in c.names, in calls, in p);
    let mut first = calls.tasks.len();
    for ti in 0..calls.tasks.len() {
        if calls.task(ti).library {
            first = ti;
            break;
        }
    }
    if first == calls.tasks.len() {
        return out;
    }
    let mut roots: ChunkSeq[u32] = ChunkSeq::new[u32]();
    roots.push(calls.task(first).entry);
    let mut tj = inc(first);
    loop {
        if tj >= calls.tasks.len() || !calls.task(tj).more_roots {
            break;
        }
        roots.push(calls.task(tj).entry);
        tj = inc(tj);
    }
    let found = discover_roots(
        inout c.types,
        inout c.names,
        in c.world,
        in calls,
        in facts,
        k,
        in roots,
        false
    );
    if found.err.len() != 0 || found.insts.len() != count {
        // Not the declared instances: every generic one stays unplanned.
        for i in 0..found.insts.len() {
            if found.vars_of(found.inst(i)).len() != 0 {
                let ok = out.generic.try_set(i, 1);
            }
        }
        return out;
    }
    for i in 0..count {
        let inst = found.inst(i);
        let vars = found.vars_of(inst);
        if vars.len() == 0 {
            continue;
        }
        let ok = out.generic.try_set(i, 1);
        let fi = graph_index(in p, inst.name);
        if fi == p.fn_count() {
            continue;
        }
        let (input, row) = instance_input(inout c, in p, fi, in vars);
        if optimize && instance_enums(in input.as_slice(), row) {
            continue;
        }
        let plans = codegen_scalar_body_plan_prefix(in input.as_slice());
        let mut j: u64 = 0;
        loop {
            if add(j, PLAN_HEADER_WORDS) > plans.len() {
                break;
            }
            let function = u64_of(in plans, j);
            let n = u64_of(in plans, inc(j));
            let start = add(j, PLAN_HEADER_WORDS);
            if function == row {
                out.words.push(function);
                out.words.push(n);
                let ok = out.at.try_set(i, out.words.len());
                for x in start..add(start, n) {
                    out.words.push(u64_of(in plans, x));
                }
                break;
            }
            j = add(start, n);
        }
    }
    out
}

// Whether the instance's graph (row `row` of its program `input`) names
// an enum, which the optimize path waits on (enums.ves).
fn instance_enums(in input: Slice[u8], row: u64) -> bool {
    let mut r = Reader { pos: 0 };
    let mut c = read_ctx(inout r, in input);
    let p = read_program(inout r, in input, in c);
    let mut ls = layouts_new();
    graph_enums(inout ls, inout c, in p, row)
}

fn u64_of(in s: ChunkSeq[u64], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

// The program row of the graph named `name`, or the function count.
fn graph_index(in p: Program, name: u32) -> u64 {
    for fi in 0..p.fn_count() {
        if p.function(fi).name == name {
            return fi;
        }
    }
    p.fn_count()
}

// The direct callees of graph `fi` that the program has graphs for, in
// first-call order, without repeats (`instance_program`'s `functions`).
fn callees(in p: Program, fi: u64) -> ChunkSeq[u64] {
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let f = p.function(fi);
    for bi in f.b0..add(f.b0, f.bc) {
        let block = p.block(bi);
        for ii in block.i0..add(block.i0, block.ic) {
            let inst = p.inst(ii);
            if inst.op != Op::Call {
                continue;
            }
            let callee = graph_index(in p, n32(p.op(inst.a)));
            if callee == p.fn_count() {
                continue;
            }
            let mut seen = false;
            for j in 0..out.len() {
                if u64_of(in out, j) == callee {
                    seen = true;
                    break;
                }
            }
            if !seen {
                out.push(callee);
            }
        }
    }
    out
}

// `mono::instance_name`: `name<K=T,...>`, the arguments in key order.
fn instance_name(in c: Ctx, base: u32, in vars: IVars) -> ChunkSeq[u8] {
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    c.names.write(base, inout out);
    out.push(LESS);
    for i in 0..vars.len() {
        if i != 0 {
            out.push(COMMA);
        }
        c.names.write(vars.key(i), inout out);
        out.push(EQUALS);
        display(in c.types, in c.names, vars.ty(i), inout out);
    }
    out.push(GREATER);
    out
}

// A type of the instance's graph with the instance's arguments: a row
// type's effects substituted (`effects.instances` arguments), any other
// type as `ast::substitute` does.
fn subst(inout t: Types, ty: u32, in vars: Vars) -> u32 {
    let node = t.node(ty);
    if node.kind == TyKind::Row {
        let row = substitute_row(inout t, node.r2, in vars);
        return t.row_type(row);
    }
    substitute(inout t, ty, in vars)
}

// Words `a..a+n` of `p`, each type id substituted.
fn put_substituted(
    inout o: ChunkSeq[u64],
    inout t: Types,
    in p: Program,
    a: u64,
    n: u64,
    in vars: Vars
) {
    for i in a..add(a, n) {
        let x = p.op(i);
        if p.tag(i) == Tag::Type {
            o.push(w(subst(inout t, n32(x), in vars)));
        } else {
            o.push(x);
        }
    }
}

// Words `a..a+n` of `p` as they are.
fn put_plain(inout o: ChunkSeq[u64], in p: Program, a: u64, n: u64) {
    for i in a..add(a, n) {
        o.push(p.op(i));
    }
}

// Graph `fi` of `p` as program-section words (place-ir
// `put_program_section`'s per-function words) under the name `name`;
// with `vars` its header, instruction types and call type arguments
// substituted and its bounds cleared, as `mono::instantiate` makes it.
// The fip trailer stays as it is.
fn put_graph(
    inout o: ChunkSeq[u64],
    inout t: Types,
    in p: Program,
    fi: u64,
    name: u32,
    in vars: Vars,
    instance: bool
) {
    let f = p.function(fi);
    o.push(w(name));
    if instance {
        // The parameters, the result and the effects, then no bounds.
        let mut at = inc(f.ha);
        let np = p.op(f.ha);
        for _ in 0..np {
            at = add(add(at, PARAM_FIXED_WORDS), p.op(add(at, PARAM_PATHS_AT)));
        }
        let bounds = add(at, BOUNDS_AFTER_PARAMS);
        put_substituted(inout o, inout t, in p, f.ha, wrapping_sub(bounds, f.ha), in vars);
        o.push(0);
        let rest = add(inc(bounds), wrapping_mul(p.op(bounds), BOUND_WORDS));
        put_substituted(inout o, inout t, in p, rest, wrapping_sub(add(f.ha, f.hn), rest), in vars);
    } else {
        put_plain(inout o, in p, f.ha, f.hn);
    }
    o.push(f.bc);
    for bi in 0..f.bc {
        let bk = p.block(add(f.b0, bi));
        put_plain(inout o, in p, bk.ha, bk.hn);
        o.push(bk.ic);
        for kk in 0..bk.ic {
            let i = p.inst(add(bk.i0, kk));
            o.push(w(i.dest));
            o.push(
                if instance {
                    w(subst(inout t, i.ty, in vars))
                } else {
                    w(i.ty)
                }
            );
            o.push(i.s0);
            o.push(i.s1);
            o.push(i.has_token);
            o.push(i.tin);
            o.push(i.tout);
            o.push(i.fallible);
            o.push(widen_u64(i.op));
            if instance {
                put_substituted(inout o, inout t, in p, i.a, i.n, in vars);
            } else {
                put_plain(inout o, in p, i.a, i.n);
            }
        }
        o.push(widen_u64(bk.term));
        put_plain(inout o, in p, bk.ta, bk.tn);
    }
    put_plain(inout o, in p, f.ta, f.tn);
}

// The instance's program as a planner input, and the row of the
// instance's graph in it: the names (with the instance's), the types
// (with the substituted ones), the world, then the program section of the
// instance's graph and its callees' graphs, in name order (the
// `BTreeMap` of `instance_program`).
fn instance_input(inout c: Ctx, in p: Program, fi: u64, in vars: IVars) -> (ChunkSeq[u8], u64) {
    let text = instance_name(in c, p.function(fi).name, in vars);
    let name = c.names.intern(in text.as_slice());
    let subst_vars = vars.vars();
    let all = callees(in p, fi);
    // The callees by name, with the instance at its place among them.
    let mut rows: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for j in 0..all.len() {
        let x = u64_of(in all, j);
        let mut pos = rows.len();
        for q in 0..rows.len() {
            let y = p.function(u64_of(in rows, q)).name;
            if cmp_names(in c.names, p.function(x).name, y) < 0 {
                pos = q;
                break;
            }
        }
        rows.push(0);
        let mut m = wrapping_sub(rows.len(), 1);
        loop {
            if m <= pos {
                break;
            }
            let ok = rows.try_set(m, u64_of(in rows, wrapping_sub(m, 1)));
            m = wrapping_sub(m, 1);
        }
        let ok = rows.try_set(pos, x);
    }
    let mut row = rows.len();
    for q in 0..rows.len() {
        if cmp_names(in c.names, name, p.function(u64_of(in rows, q)).name) < 0 {
            row = q;
            break;
        }
    }
    let mut section: ChunkSeq[u64] = ChunkSeq::new[u64]();
    put_pool_and_paths(inout section, in p);
    section.push(inc(rows.len()));
    for q in 0..rows.len() {
        if q == row {
            put_graph(inout section, inout c.types, in p, fi, name, in subst_vars, true);
        }
        let x = u64_of(in rows, q);
        put_graph(inout section, inout c.types, in p, x, p.function(x).name, in subst_vars, false);
    }
    if row == rows.len() {
        put_graph(inout section, inout c.types, in p, fi, name, in subst_vars, true);
    }
    let mut o: ChunkSeq[u64] = ChunkSeq::new[u64]();
    put_names(inout o, in c.names);
    put_types(inout o, in c.types);
    put_world(in c.world, inout o);
    o.extend(in section.as_slice());
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    out.resize(wrapping_mul(o.len(), WORD_BYTES), 0);
    for i in 0..o.len() {
        let ok = out.try_write_u64_le(wrapping_mul(i, WORD_BYTES), u64_of(in o, i));
    }
    (out, row)
}

// `put_program_section`'s pool and path tables.
fn put_pool_and_paths(inout o: ChunkSeq[u64], in p: Program) {
    o.push(p.pool_count());
    for i in 0..p.pool_count() {
        let row = p.pool_row(i);
        o.push(row.kind);
        o.push(w(row.label));
    }
    o.push(p.path_count());
    for i in 0..p.path_count() {
        let row = p.path(i);
        o.push(row.n);
        for k in 0..row.n {
            o.push(w(p.path_name(i, k)));
        }
    }
}
