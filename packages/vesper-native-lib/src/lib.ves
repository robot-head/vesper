// @vesper/native-lib: a library's native object built in Vesper over
// @vesper/cranelift (bootstrap switch slice 2a of #1397, claim #2349).
//
// `vesper build --lib` (src/native_export.rs `compile_exports`) declares
// every function of the library, defines each one through the native walk
// (src/native.rs `define_instances_observed_with_trace`) and finishes the
// object. This package does the same steps itself: it creates the module,
// declares the functions, and for each definition builds the entry block
// (`append_block_params_for_function_params`), binds each parameter to a
// fresh variable of its value's type, emits the body from its
// @vesper/codegen-scalar body plan (`emit_body_words`), defines it, and
// finishes the object.
//
// Slice 2a-1 covers functions whose frames the body hook takes (plain
// scalar parameters and results, no failure record, sret, pointers or
// capabilities). Slice 2a-2a (declare.ves) makes the instances and their
// declarations in Vesper from the calls input; the request still names
// what the walk decides: each definition's flags and callees. Slice 3a
// plans each body (@vesper/codegen-scalar over the walk's program) and
// takes its status from the instance's ABI.
// Slice 2a-4 runs the CLIF passes of an optimized definition, and outlines
// its cold paths into helpers. Slice 3e defines every instance itself: it
// names each body's direct callees (@vesper/native-walk's call words over
// the walk's program), takes its flags from the library task and its row,
// and refuses an instance the body hook's plain gate would not hand over
// (@vesper/native-walk's `frame_plan` and `graph_plain`). Slice 3f makes
// the walk's program itself: @vesper/library-ir runs the library IR
// pipeline (widths, optimize, inline, drop elaboration, hoisting) on the
// first lowering and writes it back as a calls input, which the bodies
// are planned and the callees named from.
//
// Request (little-endian words; a string is its length, then its bytes):
//
//     triple, flags, module name, keep CLIF (0 or 1),
//     source locations (1 when instructions carry them),
//     n exports, each: instance key, symbol,
//     the calls input (a string: @vesper/codegen-calls' input, whose
//         first library task names the exports as its roots),
//     then the 128-bit export entries and the v2 section (exports.ves).
//
// Every instance is defined, in instance order.
//
// Slice 2a-2b (#2642) adds what `compile_exports` defines after the walk:
// the `define_wide_entry` adapters and a v2 library's runtime glue.
//
// Answer: 0, the object, the CLIF text of the definitions (empty unless
// kept); or 1 and the error.
use @vesper/cranelift::{
    Builder, FuncId, Module, SigId, append_block_params_for_function_params, apply_edits,
    arch_aarch64, arch_x86_64, block_param, builder_finalize, builder_free, builder_new,
    create_block, declare_var, def_var, define_with_cold_helpers, function_words, invalid,
    isa_triple_arch, module_clif, module_error_text, module_finish, module_free, module_keep_clif,
    module_new, new_error_text, object_bytes, outline_cold, seal_all_blocks, switch_to_block,
    ty_i64, value_type, words_shapes, words_simd, create_stack_slot, ins_stack_addr,
    module_pointer_type
};
use @vesper/codegen-scalar-emit::{HANDLED};
use @vesper/codegen-scalar-emit::body::{emit_body_words};
use @vesper/native-clif-opt::{STEP_MERGE_TAILS, is_ported, pass_steps, run_steps};
use @vesper/native-vectorize::{vectorize_script};
use @vesper/native-cold-outline::{outline_script};
use @vesper/codegen-scalar::{codegen_scalar_body_plan_prefix};
use @vesper/codegen-calls::data::{calls_input_round_trip};
use @vesper/check-data::input::{Reader as IrReader, read_ctx};
use @vesper/place-ir::{read_program};
use @vesper/native-walk::{native_walk_call_words_bytes};
use @vesper/native-walk::frame::{graph_plain};
use @vesper/library-ir::{Status as IrStatus, library_walk_calls_input};
use self::declare::{
    Declared, RESULT_BUFFER, RESULT_SRET, RESULT_WORDS, declare_library, declared_new, exports_new
};

// The answer's status words.
const OK: u64 = 0;
const FAILED: u64 = 1;
// A request flag word that is set.
pub const SET: u64 = 1;
// The bytes of one request or answer word.
const WORD_BYTES: u64 = 8;
// Decimal digits of a number in an error, from ASCII `0`.
const DECIMAL_BASE: u64 = 10;
const DIGIT_ZERO: u64 = 48;
// A callee the walk does not call directly (`codegen_swap::body::NO_CALLEE`).
pub const NO_CALLEE: u64 = 18446744073709551615;
// The function index bits of a callee word; the bits above it are the
// call's flags (`codegen_swap::body::FAIL_CALL`, `STATUS_CALL`), kept.
const CALLEE_INDEX_MASK: u64 = 4294967295;
// A function that returns in registers: no result pointer and no values
// built in it (`codegen_swap::body::NO_VALUE`).
const NO_VALUE: u64 = 18446744073709551615;
// A register result kept as words (`codegen_swap::body::NO_POINTER`), its
// word count above `RESULT_WORDS_SHIFT`.
const NO_POINTER: u64 = 4294967295;
const RESULT_WORDS_SHIFT: u32 = 32;
// A register result's local buffer (`frame` in src/native.rs): 8-byte
// words, 8-byte aligned.
const RESULT_WORD_BYTES: u64 = 8;
const RESULT_ALIGN_SHIFT: u32 = 3;
pub const MALFORMED: Str = "malformed native-lib request";
pub const UNKNOWN_FUNCTION: Str = "a definition names an unknown function";
const NOT_PLAIN: Str = "the body hook's plain gate refuses a definition: ";
const NO_WALK_PROGRAM: Str = "the library IR pipeline refused the program: status ";
const NO_CALL_WORDS: Str = "the walk's program has no call words for a definition: ";
const NO_BUILDER: Str = "the function builder could not be made";
const DECLINED_BODY: Str = "the body hook declined a definition: ";
const DEFINE_FAILED: Str = "defining a function failed";
const PASS_FAILED: Str = "a CLIF pass failed on a definition: ";
const STEP_NOT_PORTED: Str = "a native_clif_opt step is not ported";
// @vesper/native-walk's call words of a task the Rust compile refuses
// (calls.ves `REFUSED`).
const CALLS_REFUSED: u64 = 18446744073709551615;
// An instance's call words entry: its index and call count, before the
// words.
const CALL_HEADER_WORDS: u64 = 2;
// The function words carry no pointer type (`function_words`'s 0).
const NO_POINTER_TYPE: u32 = 0;
// A program function with no body plan.
const NO_PLAN: u64 = 18446744073709551615;
// A body plan entry's function and word count, before its words.
const PLAN_HEADER_WORDS: u64 = 2;
const NO_BODY_PLAN: Str = "no body plan for a definition: ";

pub struct Reader {
    pub pos: u64,
    pub bad: bool,
}

impl Reader {
    pub fn word(inout self, in req: Slice[u8]) -> u64 {
        match req.try_read_u64_le(self.pos) {
            Option::Some(v) => {
                self.pos = wrapping_add(self.pos, WORD_BYTES);
                v
            }
            Option::None => {
                self.bad = true;
                0
            }
        }
    }

    // The next string's bytes, copied.
    pub fn bytes(inout self, in req: Slice[u8]) -> ChunkSeq[u8] {
        let len = self.word(in req);
        let start = self.pos;
        let end = wrapping_add(start, len);
        let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
        if end < start || end > req.len() {
            self.bad = true;
            return out;
        }
        out.extend(in req[start..end]);
        self.pos = end;
        out
    }
}

fn push64(inout out: ChunkSeq[u8], value: u64) {
    let at = out.len();
    out.resize(wrapping_add(at, WORD_BYTES), 0);
    let ok = out.try_write_u64_le(at, value);
}

fn put_str(inout out: ChunkSeq[u8], in bytes: Slice[u8]) {
    push64(inout out, bytes.len());
    out.extend(in bytes);
}

fn failure(in message: Slice[u8]) -> ChunkSeq[u8] {
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    push64(inout out, FAILED);
    put_str(inout out, in message);
    out
}

pub fn at64(in s: ChunkSeq[u64], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => NO_CALLEE,
    }
}

// One definition: the entry block with the parameters bound to variables
// (as `define_instances_observed_with_trace` binds them for a plain
// frame), then the body. Empty on success, else the error.
// ` (<name>)`: instance `index`'s function name, after an error that
// names the definition by its index.
fn push_instance_name(inout err: ChunkSeq[u8], in d: Declared, index: u64) {
    let start = at64(in d.name_at, index);
    let next = wrapping_add(index, 1);
    let end = if next < d.name_at.len() {
        at64(in d.name_at, next)
    } else {
        d.names.len()
    };
    if start > end || end > d.names.len() {
        return;
    }
    err.extend(in NAME_OPEN.as_bytes());
    err.extend(in d.names[start..end]);
    err.extend(in NAME_CLOSE.as_bytes());
}

const NAME_OPEN: Str = " (";
const NAME_CLOSE: Str = ")";

fn define_one(
    inout m: Module,
    index: u64,
    locations: u64,
    in d: Declared,
    in plans: Plans,
    in calls: CallWords
) -> ChunkSeq[u8] eff [Ffi[Cranelift]] {
    let mut err: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let optimize = if d.optimize { SET } else { 0 };
    let const_time = at64(in d.const_time, index) == SET;
    if at64(in d.plain, index) != SET || !plans.graph_plain(index) {
        err.extend(in NOT_PLAIN.as_bytes());
        push_dec(inout err, index);
        push_instance_name(inout err, in d, index);
        return err;
    }
    let call_at = match calls.at.try_get(index) {
        Option::Some(v) => v,
        Option::None => NO_PLAN,
    };
    if call_at == NO_PLAN {
        err.extend(in NO_CALL_WORDS.as_bytes());
        push_dec(inout err, index);
        push_instance_name(inout err, in d, index);
        return err;
    }
    let nc = at64(in calls.words, call_at);
    let mut callees: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for j in 0..nc {
        let c = at64(in calls.words, wrapping_add(wrapping_add(call_at, 1), j));
        callees.push(
            if c == NO_CALLEE {
                NO_CALLEE
            } else {
                at64(in d.ids, c & CALLEE_INDEX_MASK) | (c & ~CALLEE_INDEX_MASK)
            }
        );
    }
    let id = at64(in d.ids, index);
    let sig = at64(in d.sigs, index);
    if id == NO_CALLEE || sig == NO_CALLEE {
        err.extend(in UNKNOWN_FUNCTION.as_bytes());
        return err;
    }
    let status = at64(in d.status, index);
    // The body plan of the instance's function (codegen-scalar's
    // `[function, n, n words]` entry); a function without one is the
    // walk's.
    let at = match plans.at.try_get(index) {
        Option::Some(v) => v,
        Option::None => NO_PLAN,
    };
    if at == NO_PLAN {
        err.extend(in NO_BODY_PLAN.as_bytes());
        push_dec(inout err, index);
        push_instance_name(inout err, in d, index);
        return err;
    }
    let plan_end = wrapping_add(at, at64(in plans.words, wrapping_sub(at, 1)));
    let sig_id = SigId { id: wrapping_u32(sig) };
    let mut b = match builder_new(in m, sig_id) {
        Option::Some(b) => b,
        Option::None => {
            err.extend(in NO_BUILDER.as_bytes());
            return err;
        }
    };
    let entry = create_block(inout b);
    let np = append_block_params_for_function_params(inout b, entry);
    switch_to_block(inout b, entry);
    // The result (`FramePlan::result`, as `define_instances_observed_with_trace`
    // makes it before binding the parameters): an aggregate's leading
    // pointer parameter, or a register result's local buffer.
    let kind = at64(in d.result_kind, index);
    let words = at64(in d.result_words, index);
    let mut first: u32 = 0;
    let mut result = NO_VALUE;
    if kind == RESULT_SRET {
        result = widen_u64(block_param(inout b, entry, 0).id);
        first = 1;
    } else if kind == RESULT_BUFFER {
        let size = wrapping_u32(wrapping_mul(words, RESULT_WORD_BYTES));
        let slot = create_stack_slot(inout b, size, RESULT_ALIGN_SHIFT);
        let buffer = ins_stack_addr(inout b, module_pointer_type(in m), slot, 0);
        result = widen_u64(buffer.id) | wrapping_shl_u64(words, RESULT_WORDS_SHIFT);
    } else if kind == RESULT_WORDS {
        result = NO_POINTER | wrapping_shl_u64(words, RESULT_WORDS_SHIFT);
    }
    let mut args: ChunkSeq[u64] = ChunkSeq::new[u64]();
    args.push(optimize);
    args.push(status);
    args.push(locations);
    args.push(widen_u64(wrapping_sub(np, first)));
    for k in first..np {
        let v = block_param(inout b, entry, k);
        let ty = value_type(inout b, v);
        let var = declare_var(inout b, ty);
        def_var(inout b, var, v);
        args.push(widen_u64(var.id));
    }
    args.push(nc);
    args.extend(in callees.as_slice());
    args.push(result);
    args.push(0);
    // No parameter has an address: every one is its block parameter
    // (`codegen_swap::body::NO_VALUE` per parameter, #2563).
    args.push(widen_u64(wrapping_sub(np, first)));
    for k in first..np {
        args.push(NO_VALUE);
    }
    // No slice parameter is read once at entry (#2653).
    args.push(0);
    args.extend(in plans.words[at..plan_end]);
    let answer = emit_body_words(args, inout b, inout m);
    if answer != HANDLED {
        builder_free(b);
        err.extend(in DECLINED_BODY.as_bytes());
        push_dec(inout err, index);
        push_instance_name(inout err, in d, index);
        return err;
    }
    // `define_instances_observed_with_trace` seals what the walk left
    // open before it finalizes.
    seal_all_blocks(inout b);
    if optimize == SET {
        let failed = optimize_function(inout b, in m);
        if failed.len() != 0 {
            builder_free(b);
            err.extend(in failed.as_slice());
            push_dec(inout err, index);
            push_instance_name(inout err, in d, index);
            return err;
        }
    }
    let func = FuncId { id: wrapping_u32(id) };
    // `native.rs` outlines the cold paths of a deferred (optimized)
    // definition unless it is constant-time, then defines it and its
    // helpers in outline order.
    if optimize == SET && !const_time {
        let words = function_words(inout b, 0, ty_i64().code);
        let script = outline_script(in words.as_slice());
        if words.len() == 0 || outline_cold(inout b, inout m, in script.as_slice()) == invalid() {
            builder_free(b);
            err.extend(in PASS_FAILED.as_bytes());
            push_dec(inout err, index);
            push_instance_name(inout err, in d, index);
            return err;
        }
    }
    if !define_with_cold_helpers(inout m, func, b) {
        let message = module_error_text(in m);
        err.extend(in message.as_slice());
        if err.len() == 0 {
            err.extend(in DEFINE_FAILED.as_bytes());
        }
    }
    err
}

// The CLIF passes of an optimized definition, as `native.rs` runs them
// before it defers the definition: `native_clif_opt::run` (its `STEPS` in
// Vesper, a fresh read of the function at `merge_tails`, whose
// instruction shapes must describe the function as it is), then
// `native_vectorize::run` on a target with SIMD. Empty on success, else
// the error.
fn optimize_function(inout b: Builder, in m: Module) -> ChunkSeq[u8] eff [Ffi[Cranelift]] {
    let mut err: ChunkSeq[u8] = ChunkSeq::new[u8]();
    if !builder_finalize(inout b) {
        err.extend(in PASS_FAILED.as_bytes());
        return err;
    }
    let steps = pass_steps();
    let mut k: u64 = 0;
    loop {
        if k >= steps.len() {
            break;
        }
        let mut segment: ChunkSeq[u64] = ChunkSeq::new[u64]();
        loop {
            if k >= steps.len() {
                break;
            }
            let step = at64(in steps, k);
            if !is_ported(step) {
                err.extend(in STEP_NOT_PORTED.as_bytes());
                return err;
            }
            if step == STEP_MERGE_TAILS && segment.len() != 0 {
                break;
            }
            segment.push(step);
            k = wrapping_add(k, 1);
        }
        let flags = if at64(in segment, 0) == STEP_MERGE_TAILS {
            words_shapes()
        } else {
            0
        };
        let words = function_words(inout b, flags, NO_POINTER_TYPE);
        let script = run_steps(in words.as_slice(), in segment.as_slice());
        if words.len() == 0 || !apply_edits(inout b, in script.as_slice()) {
            err.extend(in PASS_FAILED.as_bytes());
            return err;
        }
    }
    let arch = isa_triple_arch(in m);
    if arch == arch_x86_64() || arch == arch_aarch64() {
        let words = function_words(inout b, words_simd(), NO_POINTER_TYPE);
        let answer = vectorize_script(in words.as_slice());
        // The answer is the number of loops vectorized, then the script.
        let end = answer.len();
        let start = if end == 0 { 0 } else { 1 };
        if words.len() == 0 || !apply_edits(inout b, in answer[start..end]) {
            err.extend(in PASS_FAILED.as_bytes());
        }
    }
    err
}

// The body plans of the program the walk emits from (slice 3a of
// #2349): the words of @vesper/codegen-scalar's `[function, n, n words]`
// entries, and for each instance the start of its function's plan words
// (`NO_PLAN` when it has none).
pub struct Plans {
    words: ChunkSeq[u64],
    at: ChunkSeq[u64],
    // per instance: the graph half of the plain gate (`graph_plain` of its
    // function's graph; 0 when the program has no graph for it)
    graph: ChunkSeq[u64],
}

impl Plans {
    fn graph_plain(in self, index: u64) -> bool {
        at64(in self.graph, index) == SET
    }
}

// The direct callee words of each instance (@vesper/native-walk's
// `native_walk_call_words_bytes` over the walk's calls input, the first
// task's block): `words[at[i]]` is instance `i`'s call count, its words
// follow; `NO_PLAN` when the block names no entry for it.
pub struct CallWords {
    words: ChunkSeq[u64],
    at: ChunkSeq[u64],
}

fn call_words_of(in walk: Slice[u8], count: u64) -> CallWords {
    let words = native_walk_call_words_bytes(in walk);
    let mut at: ChunkSeq[u64] = ChunkSeq::new[u64]();
    at.resize(count, NO_PLAN);
    let n = at64(in words, 0);
    if words.len() == 0 || n == CALLS_REFUSED {
        return CallWords { words: words, at: at };
    }
    let mut k: u64 = 1;
    for _ in 0..n {
        if wrapping_add(k, CALL_HEADER_WORDS) > words.len() {
            break;
        }
        let index = at64(in words, k);
        let calls = at64(in words, wrapping_add(k, 1));
        let ok = at.try_set(index, wrapping_add(k, 1));
        k = wrapping_add(wrapping_add(k, CALL_HEADER_WORDS), calls);
    }
    CallWords { words: words, at: at }
}

fn plans_of(in program: Slice[u8], in d: Declared) -> Plans {
    let words = codegen_scalar_body_plan_prefix(in program);
    // per program function: the start of its plan words
    let mut by_row: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut k: u64 = 0;
    loop {
        if wrapping_add(k, PLAN_HEADER_WORDS) > words.len() {
            break;
        }
        let row = at64(in words, k);
        let n = at64(in words, wrapping_add(k, 1));
        loop {
            if by_row.len() > row {
                break;
            }
            by_row.push(NO_PLAN);
        }
        let start = wrapping_add(k, PLAN_HEADER_WORDS);
        let ok = by_row.try_set(row, start);
        k = wrapping_add(start, n);
    }
    let mut r = IrReader { pos: 0 };
    let c = read_ctx(inout r, in program);
    let p = read_program(inout r, in program, in c);
    let mut at: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut graph: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let count = d.name_at.len();
    for i in 0..count {
        let start = at64(in d.name_at, i);
        let end = if wrapping_add(i, 1) < count {
            at64(in d.name_at, wrapping_add(i, 1))
        } else {
            d.names.len()
        };
        let sym = c.names.lookup(in d.names[start..end]);
        let mut plan = NO_PLAN;
        let mut plain: u64 = 0;
        for j in 0..p.fn_count() {
            if p.function(j).name == sym {
                plan = match by_row.try_get(j) {
                    Option::Some(v) => v,
                    Option::None => NO_PLAN,
                };
                plain = if graph_plain(in p, j) { SET } else { 0 };
                break;
            }
        }
        at.push(plan);
        graph.push(plain);
    }
    Plans { words: words, at: at, graph: graph }
}

fn push_dec(inout out: ChunkSeq[u8], value: u64) {
    if value >= DECIMAL_BASE {
        push_dec(inout out, value / DECIMAL_BASE);
    }
    out.push(wrapping_u8(wrapping_add(value % DECIMAL_BASE, DIGIT_ZERO)));
}

// The library object of one request (see the top of this file).
pub fn library_object(in req: Slice[u8]) -> ChunkSeq[u8] eff [Ffi[Cranelift]] {
    let mut r = Reader { pos: 0, bad: false };
    let triple = r.bytes(in req);
    let flags = r.bytes(in req);
    let name = r.bytes(in req);
    let keep = r.word(in req) == SET;
    let locations = r.word(in req);
    if r.bad {
        return failure(in MALFORMED.as_bytes());
    }
    let mut m = match module_new(in triple.as_slice(), in flags.as_slice(), in name.as_slice()) {
        Option::Some(m) => m,
        Option::None => {
            let message = new_error_text();
            return failure(in message.as_slice());
        }
    };
    module_keep_clif(inout m, keep);
    let ne = r.word(in req);
    let mut exports = exports_new();
    for _ in 0..ne {
        let key = r.bytes(in req);
        let symbol = r.bytes(in req);
        exports.push(in key.as_slice(), in symbol.as_slice());
    }
    let calls = r.bytes(in req);
    if r.bad {
        module_free(m);
        return failure(in MALFORMED.as_bytes());
    }
    let mut d = declared_new();
    let declare_err = declare_library(inout m, in calls.as_slice(), in exports, inout d);
    if declare_err.len() != 0 {
        module_free(m);
        return failure(in declare_err.as_slice());
    }
    let (status, walk) = library_walk_calls_input(in calls.as_slice(), d.optimize);
    if status != IrStatus::Ok {
        module_free(m);
        let mut message: ChunkSeq[u8] = ChunkSeq::new[u8]();
        message.extend(in NO_WALK_PROGRAM.as_bytes());
        push_dec(inout message, status);
        return failure(in message.as_slice());
    }
    let plans = plans_of(in walk.as_slice(), in d);
    let count = d.ids.len();
    let callees = call_words_of(in walk.as_slice(), count);
    for index in 0..count {
        let err = define_one(inout m, index, locations, in d, in plans, in callees);
        if err.len() != 0 {
            module_free(m);
            return failure(in err.as_slice());
        }
    }
    // `compile_exports` after the walk: the 128-bit export entries, then
    // a v2 library's runtime glue.
    let err = self::exports::define_wide_entries(inout m, in req, inout r, in d, in exports);
    if err.len() != 0 {
        module_free(m);
        return failure(in err.as_slice());
    }
    let err = self::exports::define_v2_glue(inout m, in req, inout r);
    if err.len() != 0 {
        module_free(m);
        return failure(in err.as_slice());
    }
    let clif = module_clif(in m);
    match module_finish(m) {
        Option::Some(product) => {
            let object = object_bytes(product);
            let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
            push64(inout out, OK);
            put_str(inout out, in object.as_slice());
            put_str(inout out, in clif.as_slice());
            out
        }
        Option::None => {
            let message = new_error_text();
            failure(in message.as_slice())
        }
    }
}

// A calls input read and written back by @vesper/codegen-calls' writers
// (slice 3d of #2349): the differential's check that a calls input Vesper
// writes builds the same object as the Rust-encoded one.
pub fn calls_round_trip(in calls: Slice[u8]) -> ChunkSeq[u8] {
    calls_input_round_trip(in calls)
}
