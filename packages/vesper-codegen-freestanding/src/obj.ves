// Relocatable ELF64 objects: the reads the freestanding linker makes
// through the `object` crate (0.37, `read::elf`), and the writer of the
// one-section stub object (`object::write::elf`).
//
// Reader: what `object::File::parse` and the `ElfFile` accessors give the
// linker in src/freestanding/link.rs. Sections are every header but the
// null one, in index order; symbols are every `.symtab` entry but the null
// one; a section's relocations are its `SHT_REL`/`SHT_RELA` sections whose
// `sh_link` is the symbol table, chained in index order (`object`'s
// `RelocationSections`). Malformed input is an `Object` error; its message
// is ours, not the `object` crate's.

use self::util::{
    Span,
    add,
    rd16,
    rd32,
    rd64,
    rd8,
    push16,
    push32,
    push64,
    grow
};

// "no such row" (util.ves).
const NONE64: u64 = 18446744073709551615;

const SHT_PROGBITS: u32 = 1;
const SHT_SYMTAB: u32 = 2;
const SHT_STRTAB: u32 = 3;
const SHT_RELA: u32 = 4;
const SHT_NOBITS: u32 = 8;
const SHT_REL: u32 = 9;
const SHT_CREL: u32 = 1073741844;

const SHF_WRITE: u64 = 1;
const SHF_ALLOC: u64 = 2;
const SHF_EXECINSTR: u64 = 4;
const SHF_STRINGS: u64 = 32;
const SHF_INFO_LINK: u64 = 64;
const SHF_TLS: u64 = 1024;

const SHN_UNDEF: u16 = 0;
const SHN_LORESERVE: u16 = 65280;
const SHN_ABS: u16 = 65521;
const SHN_XINDEX: u16 = 65535;

const STT_SECTION: u8 = 3;
const STT_FILE: u8 = 4;

const ET_REL: u16 = 1;
const EHDR_BYTES: u64 = 64;
const SHDR_BYTES: u64 = 64;
const SYM_BYTES: u64 = 24;
const RELA_BYTES: u64 = 24;
const REL_BYTES: u64 = 16;
const ELF_ALIGN: u64 = 8;

// `object::SectionKind`, as far as the linker tells them apart.
const KIND_TEXT: u8 = 0;
const KIND_DATA: u8 = 1;
const KIND_RODATA: u8 = 2;
const KIND_BSS: u8 = 3;
const KIND_OTHER: u8 = 4;

// One section header. Offsets are absolute in the request.
pub copy struct Sec {
    name_at: u64,
    name_len: u64,
    sh_type: u32,
    flags: u64,
    data_at: u64,
    size: u64,
    link: u32,
    info: u32,
    align: u64,
    entsize: u64,
    // For a section: its first relocation section; for a relocation
    // section: the next one with the same target. 0 for none.
    rel: u64,
    // The data range is inside the object (`object`'s `data()` succeeds).
    data_ok: bool,
    name_ok: bool,
}

// One `.symtab` entry.
pub copy struct Sym {
    name_at: u64,
    name_len: u64,
    name_ok: bool,
    info: u8,
    shndx: u16,
    value: u64,
    size: u64,
}

// One parsed input object: its rows are `secs[sec0..sec0 + nsec]` (index 0,
// the null section, included) and `syms[sym0..sym0 + nsym]` (index 0
// included).
pub copy struct Obj {
    name: Span,
    base: u64,
    len: u64,
    e_type: u16,
    machine: u16,
    e_flags: u32,
    sec0: u64,
    nsec: u64,
    sym0: u64,
    nsym: u64,
    // Index of the symbol table section, 0 for none.
    symtab: u64,
}

fn o16(in b: Slice[u8], o: Obj, at: u64) -> Option[u16] {
    if add(at, 2) < at || add(at, 2) > o.len {
        return Option::None;
    }
    rd16(in b, add(o.base, at))
}

fn o32(in b: Slice[u8], o: Obj, at: u64) -> Option[u32] {
    if add(at, 4) < at || add(at, 4) > o.len {
        return Option::None;
    }
    rd32(in b, add(o.base, at))
}

fn o64(in b: Slice[u8], o: Obj, at: u64) -> Option[u64] {
    if add(at, 8) < at || add(at, 8) > o.len {
        return Option::None;
    }
    rd64(in b, add(o.base, at))
}

fn w16(x: Option[u16]) -> u64 {
    match x {
        Option::Some(v) => widen_u64(v),
        Option::None => NONE64,
    }
}

fn w32(x: Option[u32]) -> u64 {
    match x {
        Option::Some(v) => widen_u64(v),
        Option::None => NONE64,
    }
}

fn w64(x: Option[u64]) -> u64 {
    match x {
        Option::Some(v) => v,
        Option::None => NONE64,
    }
}

// `start..start + size` lies inside the object.
fn inside(o: Obj, start: u64, size: u64) -> bool {
    add(start, size) >= start && add(start, size) <= o.len
}

// The NUL-terminated string at `at` of the table `t` (absolute range
// `t_at..t_at + t_len`): `(absolute start, length)`, or `None` when `at` is
// outside the table or no NUL ends it.
fn c_string(in b: Slice[u8], t_at: u64, t_len: u64, at: u64) -> Option[Span] {
    if at >= t_len {
        return Option::None;
    }
    let start = add(t_at, at);
    let end = add(t_at, t_len);
    if end < start || end > b.len() {
        return Option::None;
    }
    match b[start..end].find_byte(0) {
        Option::Some(n) => Option::Some(
            Span {
                start: start,
                len: n
            }
        ),
        Option::None => Option::None,
    }
}

fn sec_kind(s: Sec) -> u8 {
    if s.sh_type == SHT_PROGBITS {
        if s.flags & SHF_ALLOC != 0 {
            if s.flags & SHF_EXECINSTR != 0 {
                return KIND_TEXT;
            }
            if s.flags & SHF_TLS != 0 {
                return KIND_OTHER;
            }
            if s.flags & SHF_WRITE != 0 {
                return KIND_DATA;
            }
            return KIND_RODATA;
        }
        return KIND_OTHER;
    }
    if s.sh_type == SHT_NOBITS {
        if s.flags & SHF_TLS != 0 {
            return KIND_OTHER;
        }
        return KIND_BSS;
    }
    KIND_OTHER
}

// Parses the object at `b[base..base + len]`, appending its rows. Returns
// false (with `err` set by the caller from `why`) on malformed input; `why`
// gets a short reason.
pub fn parse_object(
    in b: Slice[u8],
    name: Span,
    base: u64,
    len: u64,
    inout secs: ChunkSeq[Sec],
    inout syms: ChunkSeq[Sym],
    inout why: ChunkSeq[u8]
) -> Obj {
    let mut o = Obj {
        name: name,
        base: base,
        len: len,
        e_type: 0,
        machine: 0,
        e_flags: 0,
        sec0: secs.len(),
        nsec: 0,
        sym0: syms.len(),
        nsym: 0,
        symtab: 0
    };
    if len < EHDR_BYTES
        || rd8(in b, base) != 127
        || rd8(in b, add(base, 1)) != 69
        || rd8(in b, add(base, 2)) != 76
        || rd8(in b, add(base, 3)) != 70 {
        why.extend(in "not an ELF file".as_bytes());
        return o;
    }
    if rd8(in b, add(base, 4)) != 2
        || rd8(in b, add(base, 5)) != 1
        || rd8(in b, add(base, 6)) != 1 {
        why.extend(in "not a little-endian ELF64 file".as_bytes());
        return o;
    }
    o.e_type = wrapping_u16(w16(o16(in b, o, 16)));
    o.machine = wrapping_u16(w16(o16(in b, o, 18)));
    o.e_flags = wrapping_u32(w32(o32(in b, o, 48)));
    let shoff = w64(o64(in b, o, 40));
    let shentsize = w16(o16(in b, o, 58));
    let mut shnum = w16(o16(in b, o, 60));
    let mut shstrndx = w16(o16(in b, o, 62));
    if shoff == 0 {
        // No section headers: no sections and no symbols.
        return o;
    }
    if shentsize != SHDR_BYTES {
        why.extend(in "invalid section header size".as_bytes());
        return o;
    }
    if shnum == 0 {
        shnum = w64(o64(in b, o, add(shoff, 32)));
    }
    if shstrndx == widen_u64(SHN_XINDEX) {
        shstrndx = w32(o32(in b, o, add(shoff, 40)));
    }
    if shnum == NONE64
        || shstrndx == NONE64
        || shnum > o.len / SHDR_BYTES
        || !inside(o, shoff, wrapping_mul(shnum, SHDR_BYTES)) {
        why.extend(in "invalid section header table".as_bytes());
        return o;
    }
    for i in 0..shnum {
        let h = add(shoff, wrapping_mul(i, SHDR_BYTES));
        let sh_type = wrapping_u32(w32(o32(in b, o, add(h, 4))));
        let offset = w64(o64(in b, o, add(h, 24)));
        let size = w64(o64(in b, o, add(h, 32)));
        let data_ok = sh_type == SHT_NOBITS || inside(o, offset, size);
        secs
            .push(
                Sec {
                    name_at: widen_u64(wrapping_u32(w32(o32(in b, o, h)))),
                    name_len: 0,
                    sh_type: sh_type,
                    flags: w64(o64(in b, o, add(h, 8))),
                    data_at: add(base, offset),
                    size: size,
                    link: wrapping_u32(w32(o32(in b, o, add(h, 40)))),
                    info: wrapping_u32(w32(o32(in b, o, add(h, 44)))),
                    align: w64(o64(in b, o, add(h, 48))),
                    entsize: w64(o64(in b, o, add(h, 56))),
                    rel: 0,
                    data_ok: data_ok,
                    name_ok: false
                }
            );
    }
    o.nsec = shnum;
    // Section names.
    let mut str_at: u64 = 0;
    let mut str_len: u64 = 0;
    if shstrndx != 0 && shstrndx < shnum {
        let st = sec(in secs, o, shstrndx);
        if st.sh_type != SHT_NOBITS && st.data_ok {
            str_at = st.data_at;
            str_len = st.size;
        }
    }
    for i in 0..shnum {
        let mut s = sec(in secs, o, i);
        match c_string(in b, str_at, str_len, s.name_at) {
            Option::Some(n) => {
                s.name_at = n.start;
                s.name_len = n.len;
                s.name_ok = true;
            }
            Option::None => {
                s.name_ok = false;
            }
        }
        let ok = secs.try_set(add(o.sec0, i), s);
    }
    // The symbol table: the first SHT_SYMTAB section.
    for i in 1..shnum {
        if o.symtab == 0 && sec(in secs, o, i).sh_type == SHT_SYMTAB {
            o.symtab = i;
        }
    }
    if o.symtab != 0 {
        let st = sec(in secs, o, o.symtab);
        if !st.data_ok || st.size % SYM_BYTES != 0 {
            why.extend(in "invalid ELF symbol table data".as_bytes());
            return o;
        }
        let link = widen_u64(st.link);
        if link >= shnum {
            why.extend(in "invalid ELF string section index".as_bytes());
            return o;
        }
        let strs = sec(in secs, o, link);
        if !strs.data_ok {
            why.extend(in "invalid ELF string table data".as_bytes());
            return o;
        }
        let count = st.size / SYM_BYTES;
        for k in 0..count {
            let at = add(st.data_at, wrapping_mul(k, SYM_BYTES));
            let name_off = match rd32(in b, at) {
                Option::Some(v) => widen_u64(v),
                Option::None => 0,
            };
            let mut sym = Sym {
                name_at: 0,
                name_len: 0,
                name_ok: true,
                info: rd8(in b, add(at, 4)),
                shndx: match rd16(in b, add(at, 6)) {
                    Option::Some(v) => v,
                    Option::None => 0,
                },
                value: match rd64(in b, add(at, 8)) {
                    Option::Some(v) => v,
                    Option::None => 0,
                },
                size: match rd64(in b, add(at, 16)) {
                    Option::Some(v) => v,
                    Option::None => 0,
                }
            };
            match c_string(in b, strs.data_at, strs.size, name_off) {
                Option::Some(n) => {
                    sym.name_at = n.start;
                    sym.name_len = n.len;
                }
                Option::None => {
                    sym.name_ok = false;
                }
            }
            syms.push(sym);
        }
        o.nsym = count;
    }
    // Relocation chains (object's `RelocationSections::parse`), built from
    // the last section down so each chain runs in index order.
    let mut i = shnum;
    loop {
        if i <= 1 {
            break;
        }
        i = wrapping_sub(i, 1);
        let s = sec(in secs, o, i);
        if s.sh_type == SHT_REL || s.sh_type == SHT_RELA || s.sh_type == SHT_CREL {
            let info = widen_u64(s.info);
            if widen_u64(s.link) == o.symtab && info != 0 {
                if info >= shnum {
                    why.extend(in "invalid ELF sh_info for relocation section".as_bytes());
                    return o;
                }
                let mut t = sec(in secs, o, info);
                if t.sh_type == SHT_REL || t.sh_type == SHT_RELA || t.sh_type == SHT_CREL {
                    why.extend(in "unsupported ELF sh_info for relocation section".as_bytes());
                    return o;
                }
                let next = t.rel;
                t.rel = i;
                let ok1 = secs.try_set(add(o.sec0, info), t);
                let mut r = sec(in secs, o, i);
                r.rel = next;
                let ok2 = secs.try_set(add(o.sec0, i), r);
            }
        }
    }
    o
}

// Section `i` of `o`.
pub fn sec(in secs: ChunkSeq[Sec], o: Obj, i: u64) -> Sec {
    match secs.try_get(add(o.sec0, i)) {
        Option::Some(s) => s,
        Option::None => Sec {
            name_at: 0,
            name_len: 0,
            sh_type: 0,
            flags: 0,
            data_at: 0,
            size: 0,
            link: 0,
            info: 0,
            align: 0,
            entsize: 0,
            rel: 0,
            data_ok: false,
            name_ok: false
        },
    }
}

// Symbol `i` of `o`.
pub fn sym(in syms: ChunkSeq[Sym], o: Obj, i: u64) -> Sym {
    match syms.try_get(add(o.sym0, i)) {
        Option::Some(s) => s,
        Option::None => Sym {
            name_at: 0,
            name_len: 0,
            name_ok: false,
            info: 0,
            shndx: 0,
            value: 0,
            size: 0
        },
    }
}

pub fn is_relocatable(o: Obj) -> bool {
    o.e_type == ET_REL
}

// One relocation: `r_offset`, the symbol index, the type and the addend.
pub copy struct Rel {
    offset: u64,
    sym: u64,
    r_type: u32,
    addend: u64,
}

// The relocations of section `s` of the chain's relocation section `rs`:
// entry `k` (bounds-checked; `None` past the end).
pub fn rel_count(r: Sec) -> u64 {
    if !r.data_ok {
        return 0;
    }
    if r.sh_type == SHT_RELA {
        return r.size / RELA_BYTES;
    }
    if r.sh_type == SHT_REL {
        return r.size / REL_BYTES;
    }
    0
}

pub fn rel_at(in b: Slice[u8], r: Sec, k: u64) -> Rel {
    let size = if r.sh_type == SHT_RELA {
        RELA_BYTES
    } else {
        REL_BYTES
    };
    let at = add(r.data_at, wrapping_mul(k, size));
    let info = match rd64(in b, add(at, 8)) {
        Option::Some(v) => v,
        Option::None => 0,
    };
    let addend = if r.sh_type == SHT_RELA {
        match rd64(in b, add(at, 16)) {
            Option::Some(v) => v,
            Option::None => 0,
        }
    } else {
        0
    };
    Rel {
        offset: match rd64(in b, at) {
            Option::Some(v) => v,
            Option::None => 0,
        },
        sym: info >> 32,
        r_type: wrapping_u32(info & 4294967295),
        addend: addend
    }
}

// ----- the stub object writer -----------------------------------------------

// The string table `object::write::StringTable` writes: strings sorted
// by their reversed bytes, largest first (so a string that ends another
// follows it and shares its tail), each NUL-terminated after `base` bytes.
// `offsets[i]` is where string `i` (of `strs[starts[i]..starts[i]+lens[i]]`)
// lands.
pub fn string_table(
    in strs: ChunkSeq[u8],
    in starts: ChunkSeq[u64],
    in lens: ChunkSeq[u64],
    base: u64,
    inout data: ChunkSeq[u8],
    inout offsets: ChunkSeq[u64]
) {
    let n = starts.len();
    let mut order: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for i in 0..n {
        // Insertion sort; tables here hold a handful of strings.
        let mut pos = order.len();
        for j in 0..order.len() {
            let other = match order.try_get(j) {
                Option::Some(v) => v,
                Option::None => 0,
            };
            if rev_greater(in strs, in starts, in lens, i, other) {
                pos = j;
                break;
            }
        }
        order.push(0);
        let mut k = order.len();
        loop {
            if k <= add(pos, 1) {
                break;
            }
            k = wrapping_sub(k, 1);
            let prev = match order.try_get(wrapping_sub(k, 1)) {
                Option::Some(v) => v,
                Option::None => 0,
            };
            let ok = order.try_set(k, prev);
        }
        let ok = order.try_set(pos, i);
    }
    offsets.clear();
    offsets.resize(n, 0);
    let mut offset = base;
    let mut prev: u64 = NONE64;
    for k in 0..order.len() {
        let id = match order.try_get(k) {
            Option::Some(v) => v,
            Option::None => 0,
        };
        let s = at64(in starts, id);
        let l = at64(in lens, id);
        if prev != NONE64 && ends_with(in strs, at64(in starts, prev), at64(in lens, prev), s, l) {
            let ok = offsets.try_set(id, wrapping_sub(wrapping_sub(offset, l), 1));
        } else {
            let ok = offsets.try_set(id, offset);
            for c in 0..l {
                data
                    .push(
                        match strs.try_get(add(s, c)) {
                            Option::Some(v) => v,
                            Option::None => 0,
                        }
                    );
            }
            data.push(0);
            offset = add(offset, add(l, 1));
            prev = id;
        }
    }
}

fn at64(in s: ChunkSeq[u64], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

// Byte `pos` (1-based from the end) of string `id`, 0 past its start.
fn rev_byte(
    in strs: ChunkSeq[u8],
    in starts: ChunkSeq[u64],
    in lens: ChunkSeq[u64],
    id: u64,
    pos: u64
) -> u8 {
    let l = at64(in lens, id);
    if pos > l {
        return 0;
    }
    match strs.try_get(add(at64(in starts, id), wrapping_sub(l, pos))) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

// String `a` sorts before string `b`.
fn rev_greater(
    in strs: ChunkSeq[u8],
    in starts: ChunkSeq[u64],
    in lens: ChunkSeq[u64],
    a: u64,
    b: u64
) -> bool {
    let mut pos: u64 = 1;
    loop {
        let x = rev_byte(in strs, in starts, in lens, a, pos);
        let y = rev_byte(in strs, in starts, in lens, b, pos);
        if x != y {
            return x > y;
        }
        if x == 0 {
            return false;
        }
        pos = add(pos, 1);
    }
}

// `strs[ps..ps + pl]` ends with `strs[s..s + l]`.
fn ends_with(in strs: ChunkSeq[u8], ps: u64, pl: u64, s: u64, l: u64) -> bool {
    if l > pl {
        return false;
    }
    let off = add(ps, wrapping_sub(pl, l));
    for i in 0..l {
        if strs.try_get(add(off, i)) != strs.try_get(add(s, i)) {
            return false;
        }
    }
    true
}

fn pad_to(inout out: ChunkSeq[u8], align: u64) {
    if align > 1 {
        let len = out.len();
        let r = len % align;
        if r != 0 {
            let at = grow(inout out, wrapping_sub(align, r));
        }
    }
}

// The stub as `object::write` lays out a relocatable ELF64 object with one
// `.text.boot` section of `code` (aligned to `align`), its RELA relocations
// and global hidden symbols: the defined ones first (`defined[i]` names
// `names[def_starts[i]..]` at `def_values[i]`), then the undefined ones in
// the order the relocations first name them. Section indices: 1
// `.text.boot`, 2 `.rela.text.boot`, 3 `.symtab`, 4 `.strtab`,
// 5 `.shstrtab`.
pub fn write_stub_object(
    machine: u16,
    e_flags: u32,
    align: u64,
    in code: ChunkSeq[u8],
    in names: ChunkSeq[u8],
    in starts: ChunkSeq[u64],
    in lens: ChunkSeq[u64],
    defined: u64,
    in values: ChunkSeq[u64],
    in rel_offsets: ChunkSeq[u64],
    in rel_syms: ChunkSeq[u64],
    in rel_types: ChunkSeq[u32]
) -> ChunkSeq[u8] {
    let nsym = starts.len();
    let nrel = rel_offsets.len();
    // Offsets, as the writer reserves them.
    let text_off = align_to(EHDR_BYTES, align);
    let symtab_off = align_to(add(text_off, code.len()), ELF_ALIGN);
    let symtab_size = wrapping_mul(add(nsym, 1), SYM_BYTES);
    let mut strtab: ChunkSeq[u8] = ChunkSeq::new[u8]();
    strtab.push(0);
    let mut str_offsets: ChunkSeq[u64] = ChunkSeq::new[u64]();
    string_table(in names, in starts, in lens, 1, inout strtab, inout str_offsets);
    let strtab_off = add(symtab_off, symtab_size);
    let rela_off = align_to(add(strtab_off, strtab.len()), ELF_ALIGN);
    let rela_size = wrapping_mul(nrel, RELA_BYTES);
    // Section names, in the order the writer adds them.
    let mut sh_names: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut sh_starts: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut sh_lens: ChunkSeq[u64] = ChunkSeq::new[u64]();
    add_name(inout sh_names, inout sh_starts, inout sh_lens, in ".text.boot");
    add_name(inout sh_names, inout sh_starts, inout sh_lens, in ".rela.text.boot");
    add_name(inout sh_names, inout sh_starts, inout sh_lens, in ".symtab");
    add_name(inout sh_names, inout sh_starts, inout sh_lens, in ".strtab");
    add_name(inout sh_names, inout sh_starts, inout sh_lens, in ".shstrtab");
    let mut shstrtab: ChunkSeq[u8] = ChunkSeq::new[u8]();
    shstrtab.push(0);
    let mut sh_offsets: ChunkSeq[u64] = ChunkSeq::new[u64]();
    string_table(in sh_names, in sh_starts, in sh_lens, 1, inout shstrtab, inout sh_offsets);
    let shstrtab_off = add(rela_off, rela_size);
    let shoff = align_to(add(shstrtab_off, shstrtab.len()), ELF_ALIGN);
    let shnum: u64 = 6;

    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    // File header.
    out.push(127);
    out.push(69);
    out.push(76);
    out.push(70);
    out.push(2);
    out.push(1);
    out.push(1);
    let at = grow(inout out, 9);
    push16(inout out, ET_REL);
    push16(inout out, machine);
    push32(inout out, 1);
    push64(inout out, 0);
    push64(inout out, 0);
    push64(inout out, shoff);
    push32(inout out, e_flags);
    push16(inout out, 64);
    push16(inout out, 0);
    push16(inout out, 0);
    push16(inout out, 64);
    push16(inout out, wrapping_u16(shnum));
    push16(inout out, 5);
    // Section data.
    pad_to(inout out, align);
    out.extend(in code.as_slice());
    // Symbols: the null symbol, then every symbol (all global).
    pad_to(inout out, ELF_ALIGN);
    let z = grow(inout out, SYM_BYTES);
    for i in 0..nsym {
        push32(inout out, wrapping_u32(at64(in str_offsets, i)));
        if i < defined {
            // STB_GLOBAL, STT_FUNC; STV_HIDDEN; in `.text.boot`.
            out.push(18);
            out.push(2);
            push16(inout out, 1);
            push64(inout out, at64(in values, i));
        } else {
            // STB_GLOBAL, STT_NOTYPE; STV_HIDDEN; undefined.
            out.push(16);
            out.push(2);
            push16(inout out, 0);
            push64(inout out, 0);
        }
        push64(inout out, 0);
    }
    out.extend(in strtab.as_slice());
    pad_to(inout out, ELF_ALIGN);
    for k in 0..nrel {
        push64(inout out, at64(in rel_offsets, k));
        let r_type = match rel_types.try_get(k) {
            Option::Some(v) => widen_u64(v),
            Option::None => 0,
        };
        // Symbol indices start at 1 (after the null symbol).
        push64(inout out, wrapping_shl_u64(add(at64(in rel_syms, k), 1), 32) | r_type);
        push64(inout out, 0);
    }
    out.extend(in shstrtab.as_slice());
    pad_to(inout out, ELF_ALIGN);
    // Section headers.
    let n = grow(inout out, SHDR_BYTES);
    section_header(
        inout out,
        at64(in sh_offsets, 0),
        widen_u64(SHT_PROGBITS),
        SHF_ALLOC | SHF_EXECINSTR,
        text_off,
        code.len(),
        0,
        0,
        align,
        0
    );
    section_header(
        inout out,
        at64(in sh_offsets, 1),
        widen_u64(SHT_RELA),
        SHF_INFO_LINK,
        rela_off,
        rela_size,
        3,
        1,
        ELF_ALIGN,
        RELA_BYTES
    );
    section_header(
        inout out,
        at64(in sh_offsets, 2),
        widen_u64(SHT_SYMTAB),
        0,
        symtab_off,
        symtab_size,
        4,
        1,
        ELF_ALIGN,
        SYM_BYTES
    );
    section_header(
        inout out,
        at64(in sh_offsets, 3),
        widen_u64(SHT_STRTAB),
        0,
        strtab_off,
        strtab.len(),
        0,
        0,
        1,
        0
    );
    section_header(
        inout out,
        at64(in sh_offsets, 4),
        widen_u64(SHT_STRTAB),
        0,
        shstrtab_off,
        shstrtab.len(),
        0,
        0,
        1,
        0
    );
    out
}

fn add_name(
    inout strs: ChunkSeq[u8],
    inout starts: ChunkSeq[u64],
    inout lens: ChunkSeq[u64],
    in name: Str
) {
    starts.push(strs.len());
    let n = name.as_bytes();
    lens.push(n.len());
    strs.extend(in n);
}

fn align_to(v: u64, a: u64) -> u64 {
    if a <= 1 {
        return v;
    }
    let r = v % a;
    if r == 0 {
        v
    } else {
        add(v, wrapping_sub(a, r))
    }
}

pub fn section_header(
    inout out: ChunkSeq[u8],
    name: u64,
    kind: u64,
    flags: u64,
    off: u64,
    size: u64,
    link: u64,
    info: u64,
    align: u64,
    entsize: u64
) {
    push32(inout out, wrapping_u32(name));
    push32(inout out, wrapping_u32(kind));
    push64(inout out, flags);
    push64(inout out, 0);
    push64(inout out, off);
    push64(inout out, size);
    push32(inout out, wrapping_u32(link));
    push32(inout out, wrapping_u32(info));
    push64(inout out, align);
    push64(inout out, entsize);
}

// Output section of an input section in `link::link` (`classify`):
// OUT_TEXT..OUT_BSS (link.ves order), 4 to skip it, 5 for an allocated
// section the linker cannot place.
pub fn classify(s: Sec) -> u8 {
    if s.flags & SHF_ALLOC == 0 {
        return 4;
    }
    let k = sec_kind(s);
    if k == KIND_TEXT {
        0
    } else if k == KIND_RODATA {
        1
    } else if k == KIND_DATA {
        2
    } else if k == KIND_BSS {
        3
    } else if s.size == 0 {
        4
    } else {
        5
    }
}

pub fn is_nobits(s: Sec) -> bool {
    s.sh_type == SHT_NOBITS
}

// `SymbolSection::Section(_)`.
pub fn sym_in_section(s: Sym) -> bool {
    s.shndx != SHN_UNDEF && s.shndx < SHN_LORESERVE
}

pub fn sym_undefined(s: Sym) -> bool {
    s.shndx == SHN_UNDEF
}

// `SymbolSection::Absolute` (a file symbol is `None`).
pub fn sym_absolute(s: Sym) -> bool {
    s.shndx == SHN_ABS && (s.info & 15) != STT_FILE
}

pub fn sym_is_section(s: Sym) -> bool {
    (s.info & 15) == STT_SECTION
}

pub fn sym_global(s: Sym) -> bool {
    (s.info >> 4) != 0
}
