// Relocatable ELF64 objects: the reads the freestanding linker makes
// through the `object` crate (0.37, `read::elf`), and the writer of the
// one-section stub object (`object::write::elf`).
//
// Reader: what `object::File::parse` and the `ElfFile` accessors give the
// linker in src/freestanding/link.rs. Sections are every header but the
// null one, in index order; symbols are every `.symtab` entry but the null
// one; a section's relocations are its `SHT_REL`/`SHT_RELA` sections whose
// `sh_link` is the symbol table, chained in index order (`object`'s
// `RelocationSections`). Malformed input is an `Object` error; its message
// is ours, not the `object` crate's.

use self::codes::{Absent, Ehdr, Et, Ident, RelEnt, Shdr, Shf, Shn, Sht, Stb, Stt, Stv, SymEnt};
use self::util::{Span, add, rd16, rd32, rd64, rd8, push16, push32, push64, grow};

const ELF_ALIGN: u64 = 8;

// `object::SectionKind`, as far as the linker tells them apart.
enum Kind: _ {
    Text = 0,
    Data = 1,
    Rodata = 2,
    Bss = 3,
    Other = 4,
}

// One section header. Offsets are absolute in the request.
pub copy struct Sec {
    name_at: u64,
    name_len: u64,
    sh_type: u32,
    flags: u64,
    data_at: u64,
    size: u64,
    link: u32,
    info: u32,
    align: u64,
    entsize: u64,
    // For a section: its first relocation section; for a relocation
    // section: the next one with the same target. 0 for none.
    rel_chain: u64,
    // The data range is inside the object (`object`'s `data()` succeeds).
    data_ok: bool,
    name_ok: bool,
}

// One `.symtab` entry.
pub copy struct Sym {
    name_at: u64,
    name_len: u64,
    name_ok: bool,
    info: u8,
    shndx: u16,
    value: u64,
    size: u64,
}

// One parsed input object: its rows are
// `secs[sec_start..sec_start + sec_count]` (index 0, the null section,
// included) and `syms[sym_start..sym_start + sym_count]` (index 0 included).
pub copy struct Obj {
    name: Span,
    base: u64,
    len: u64,
    e_type: u16,
    machine: u16,
    e_flags: u32,
    sec_start: u64,
    sec_count: u64,
    sym_start: u64,
    sym_count: u64,
    // Index of the symbol table section, 0 for none.
    symtab: u64,
}

fn o16(in req: Slice[u8], obj: Obj, at: u64) -> Option[u16] {
    if add(at, 2) < at || add(at, 2) > obj.len {
        return Option::None;
    }
    rd16(in req, add(obj.base, at))
}

fn o32(in req: Slice[u8], obj: Obj, at: u64) -> Option[u32] {
    if add(at, 4) < at || add(at, 4) > obj.len {
        return Option::None;
    }
    rd32(in req, add(obj.base, at))
}

fn o64(in req: Slice[u8], obj: Obj, at: u64) -> Option[u64] {
    if add(at, 8) < at || add(at, 8) > obj.len {
        return Option::None;
    }
    rd64(in req, add(obj.base, at))
}

fn w16(value: Option[u16]) -> u64 {
    match value {
        Option::Some(v) => widen_u64(v),
        Option::None => Absent::Row,
    }
}

fn w32(value: Option[u32]) -> u64 {
    match value {
        Option::Some(v) => widen_u64(v),
        Option::None => Absent::Row,
    }
}

fn w64(value: Option[u64]) -> u64 {
    value.unwrap_or(Absent::Row)
}

// `start..start + size` lies inside the object.
fn inside(obj: Obj, start: u64, size: u64) -> bool {
    add(start, size) >= start && add(start, size) <= obj.len
}

// The NUL-terminated string at `at` of the string table (absolute range
// `table_at..table_at + table_len`): `(absolute start, length)`, or `None` when `at` is
// outside the table or no NUL ends it.
fn c_string(in req: Slice[u8], table_at: u64, table_len: u64, at: u64) -> Option[Span] {
    if at >= table_len {
        return Option::None;
    }
    let start = add(table_at, at);
    let end = add(table_at, table_len);
    if end < start || end > req.len() {
        return Option::None;
    }
    match req[start..end].find_byte(0) {
        Option::Some(n) => Option::Some(Span { start: start, len: n }),
        Option::None => Option::None,
    }
}

fn sec_kind(section: Sec) -> u8 {
    if section.sh_type == Sht::Progbits {
        if section.flags & Shf::Alloc != 0 {
            if section.flags & Shf::Execinstr != 0 {
                return Kind::Text;
            }
            if section.flags & Shf::Tls != 0 {
                return Kind::Other;
            }
            if section.flags & Shf::Write != 0 {
                return Kind::Data;
            }
            return Kind::Rodata;
        }
        return Kind::Other;
    }
    if section.sh_type == Sht::Nobits {
        if section.flags & Shf::Tls != 0 {
            return Kind::Other;
        }
        return Kind::Bss;
    }
    Kind::Other
}

// Parses the object at `req[base..base + len]`, appending its rows. Returns
// false (with `err` set by the caller from `why`) on malformed input; `why`
// gets a short reason.
pub fn parse_object(
    in req: Slice[u8],
    name: Span,
    base: u64,
    len: u64,
    inout secs: ChunkSeq[Sec],
    inout syms: ChunkSeq[Sym],
    inout why: ChunkSeq[u8]
) -> Obj {
    let mut obj = Obj {
        name: name,
        base: base,
        len: len,
        e_type: 0,
        machine: 0,
        e_flags: 0,
        sec_start: secs.len(),
        sec_count: 0,
        sym_start: syms.len(),
        sym_count: 0,
        symtab: 0
    };
    if len < Ehdr::Bytes
        || rd8(in req, base) != Ident::Mag0
        || rd8(in req, add(base, 1)) != Ident::Mag1
        || rd8(in req, add(base, 2)) != Ident::Mag2
        || rd8(in req, add(base, 3)) != Ident::Mag3
    {
        why.extend(in "not an ELF file".as_bytes());
        return obj;
    }
    if rd8(in req, add(base, Ehdr::Class)) != Ident::Class64
        || rd8(in req, add(base, Ehdr::Data)) != Ident::Data2Lsb
        || rd8(in req, add(base, Ehdr::Version)) != Ident::Current
    {
        why.extend(in "not a little-endian ELF64 file".as_bytes());
        return obj;
    }
    obj.e_type = wrapping_u16(w16(o16(in req, obj, Ehdr::Kind)));
    obj.machine = wrapping_u16(w16(o16(in req, obj, Ehdr::Machine)));
    obj.e_flags = wrapping_u32(w32(o32(in req, obj, Ehdr::Flags)));
    let shoff = w64(o64(in req, obj, Ehdr::Shoff));
    let shentsize = w16(o16(in req, obj, Ehdr::Shentsize));
    let mut shnum = w16(o16(in req, obj, Ehdr::Shnum));
    let mut shstrndx = w16(o16(in req, obj, Ehdr::Shstrndx));
    if shoff == 0 {
        // No section headers: no sections and no symbols.
        return obj;
    }
    if shentsize != Shdr::Bytes {
        why.extend(in "invalid section header size".as_bytes());
        return obj;
    }
    if shnum == 0 {
        shnum = w64(o64(in req, obj, add(shoff, Shdr::Size)));
    }
    if shstrndx == Shn::Xindex {
        shstrndx = w32(o32(in req, obj, add(shoff, Shdr::Link)));
    }
    if shnum == Absent::Row
        || shstrndx == Absent::Row
        || shnum > obj.len / Shdr::Bytes
        || !inside(obj, shoff, wrapping_mul(shnum, Shdr::Bytes))
    {
        why.extend(in "invalid section header table".as_bytes());
        return obj;
    }
    for i in 0..shnum {
        let header_at = add(shoff, wrapping_mul(i, Shdr::Bytes));
        let sh_type = wrapping_u32(w32(o32(in req, obj, add(header_at, Shdr::Kind))));
        let offset = w64(o64(in req, obj, add(header_at, Shdr::Offset)));
        let size = w64(o64(in req, obj, add(header_at, Shdr::Size)));
        let data_ok = sh_type == Sht::Nobits || inside(obj, offset, size);
        secs.push(Sec {
            name_at: widen_u64(wrapping_u32(w32(o32(in req, obj, header_at)))),
            name_len: 0,
            sh_type: sh_type,
            flags: w64(o64(in req, obj, add(header_at, Shdr::Flags))),
            data_at: add(base, offset),
            size: size,
            link: wrapping_u32(w32(o32(in req, obj, add(header_at, Shdr::Link)))),
            info: wrapping_u32(w32(o32(in req, obj, add(header_at, Shdr::Info)))),
            align: w64(o64(in req, obj, add(header_at, Shdr::Addralign))),
            entsize: w64(o64(in req, obj, add(header_at, Shdr::Entsize))),
            rel_chain: 0,
            data_ok: data_ok,
            name_ok: false
        });
    }
    obj.sec_count = shnum;
    // Section names.
    let mut str_at: u64 = 0;
    let mut str_len: u64 = 0;
    if shstrndx != 0 && shstrndx < shnum {
        let names_sec = sec(in secs, obj, shstrndx);
        if names_sec.sh_type != Sht::Nobits && names_sec.data_ok {
            str_at = names_sec.data_at;
            str_len = names_sec.size;
        }
    }
    for i in 0..shnum {
        let mut section = sec(in secs, obj, i);
        match c_string(in req, str_at, str_len, section.name_at) {
            Option::Some(name_span) => {
                section.name_at = name_span.start;
                section.name_len = name_span.len;
                section.name_ok = true;
            }
            Option::None => {
                section.name_ok = false;
            }
        }
        let ok = secs.try_set(add(obj.sec_start, i), section);
    }
    // The symbol table: the first SHT_SYMTAB section.
    for i in 1..shnum {
        if obj.symtab == 0 && sec(in secs, obj, i).sh_type == Sht::Symtab {
            obj.symtab = i;
        }
    }
    if obj.symtab != 0 {
        let symtab_sec = sec(in secs, obj, obj.symtab);
        if !symtab_sec.data_ok || symtab_sec.size % SymEnt::Bytes != 0 {
            why.extend(in "invalid ELF symbol table data".as_bytes());
            return obj;
        }
        let link = widen_u64(symtab_sec.link);
        if link >= shnum {
            why.extend(in "invalid ELF string section index".as_bytes());
            return obj;
        }
        let strtab = sec(in secs, obj, link);
        if !strtab.data_ok {
            why.extend(in "invalid ELF string table data".as_bytes());
            return obj;
        }
        let count = symtab_sec.size / SymEnt::Bytes;
        for k in 0..count {
            let entry_at = add(symtab_sec.data_at, wrapping_mul(k, SymEnt::Bytes));
            let name_off = match rd32(in req, entry_at) {
                Option::Some(v) => widen_u64(v),
                Option::None => 0,
            };
            let mut sym = Sym {
                name_at: 0,
                name_len: 0,
                name_ok: true,
                info: rd8(in req, add(entry_at, SymEnt::Info)),
                shndx: rd16(in req, add(entry_at, SymEnt::Shndx)).unwrap_or(0),
                value: rd64(in req, add(entry_at, SymEnt::Value)).unwrap_or(0),
                size: rd64(in req, add(entry_at, SymEnt::Size)).unwrap_or(0)
            };
            match c_string(in req, strtab.data_at, strtab.size, name_off) {
                Option::Some(name_span) => {
                    sym.name_at = name_span.start;
                    sym.name_len = name_span.len;
                }
                Option::None => {
                    sym.name_ok = false;
                }
            }
            syms.push(sym);
        }
        obj.sym_count = count;
    }
    // Relocation chains (object's `RelocationSections::parse`), built from
    // the last section down so each chain runs in index order.
    let mut i = shnum;
    loop {
        if i <= 1 {
            break;
        }
        i = wrapping_sub(i, 1);
        let section = sec(in secs, obj, i);
        if section.sh_type == Sht::Rel
            || section.sh_type == Sht::Rela
            || section.sh_type == Sht::Crel
        {
            let info = widen_u64(section.info);
            if widen_u64(section.link) == obj.symtab && info != 0 {
                if info >= shnum {
                    why.extend(in "invalid ELF sh_info for relocation section".as_bytes());
                    return obj;
                }
                let mut target_sec = sec(in secs, obj, info);
                if target_sec.sh_type == Sht::Rel
                    || target_sec.sh_type == Sht::Rela
                    || target_sec.sh_type == Sht::Crel
                {
                    why.extend(in "unsupported ELF sh_info for relocation section".as_bytes());
                    return obj;
                }
                let next = target_sec.rel_chain;
                target_sec.rel_chain = i;
                let ok1 = secs.try_set(add(obj.sec_start, info), target_sec);
                let mut rel_sec = sec(in secs, obj, i);
                rel_sec.rel_chain = next;
                let ok2 = secs.try_set(add(obj.sec_start, i), rel_sec);
            }
        }
    }
    obj
}

// Section `i` of `obj`.
pub fn sec(in secs: ChunkSeq[Sec], obj: Obj, i: u64) -> Sec {
    match secs.try_get(add(obj.sec_start, i)) {
        Option::Some(s) => s,
        Option::None => Sec {
            name_at: 0,
            name_len: 0,
            sh_type: 0,
            flags: 0,
            data_at: 0,
            size: 0,
            link: 0,
            info: 0,
            align: 0,
            entsize: 0,
            rel_chain: 0,
            data_ok: false,
            name_ok: false
        },
    }
}

// Symbol `i` of `obj`.
pub fn sym(in syms: ChunkSeq[Sym], obj: Obj, i: u64) -> Sym {
    match syms.try_get(add(obj.sym_start, i)) {
        Option::Some(s) => s,
        Option::None => Sym {
            name_at: 0,
            name_len: 0,
            name_ok: false,
            info: 0,
            shndx: 0,
            value: 0,
            size: 0
        },
    }
}

pub fn is_relocatable(obj: Obj) -> bool {
    obj.e_type == Et::Rel
}

// One relocation: `r_offset`, the symbol index, the type and the addend.
pub copy struct Rel {
    offset: u64,
    sym_index: u64,
    r_type: u32,
    addend: u64,
}

// The relocations of the chain's relocation section `rel_sec`: their count,
// and entry `index` (bounds-checked).
pub fn rel_count(rel_sec: Sec) -> u64 {
    if !rel_sec.data_ok {
        return 0;
    }
    if rel_sec.sh_type == Sht::Rela {
        return rel_sec.size / RelEnt::RelaBytes;
    }
    if rel_sec.sh_type == Sht::Rel {
        return rel_sec.size / RelEnt::RelBytes;
    }
    0
}

pub fn rel_at(in req: Slice[u8], rel_sec: Sec, index: u64) -> Rel {
    let size = if rel_sec.sh_type == Sht::Rela {
        RelEnt::RelaBytes
    } else {
        RelEnt::RelBytes
    };
    let at = add(rel_sec.data_at, wrapping_mul(index, size));
    let info = rd64(in req, add(at, RelEnt::Info)).unwrap_or(0);
    let addend = if rel_sec.sh_type == Sht::Rela {
        rd64(in req, add(at, RelEnt::Addend)).unwrap_or(0)
    } else {
        0
    };
    Rel {
        offset: rd64(in req, at).unwrap_or(0),
        sym_index: info >> 32,
        r_type: wrapping_u32(info & 4294967295),
        addend: addend
    }
}

// ----- the stub object writer -----------------------------------------------

// The string table `object::write::StringTable` writes: strings sorted
// by their reversed bytes, largest first (so a string that ends another
// follows it and shares its tail), each NUL-terminated after `base` bytes.
// `offsets[i]` is where string `i` (of `strs[starts[i]..starts[i]+lens[i]]`)
// lands.
pub fn string_table(
    in strs: ChunkSeq[u8],
    in starts: ChunkSeq[u64],
    in lens: ChunkSeq[u64],
    base: u64,
    inout data: ChunkSeq[u8],
    inout offsets: ChunkSeq[u64]
) {
    let n = starts.len();
    let mut order: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for i in 0..n {
        // Insertion sort; tables here hold a handful of strings.
        let mut pos = order.len();
        for j in 0..order.len() {
            let other = order.try_get(j).unwrap_or(0);
            if rev_greater(in strs, in starts, in lens, i, other) {
                pos = j;
                break;
            }
        }
        order.push(0);
        let mut slot = order.len();
        loop {
            if slot <= add(pos, 1) {
                break;
            }
            slot = wrapping_sub(slot, 1);
            let prev = order.try_get(wrapping_sub(slot, 1)).unwrap_or(0);
            let ok = order.try_set(slot, prev);
        }
        let ok = order.try_set(pos, i);
    }
    offsets.clear();
    offsets.resize(n, 0);
    let mut offset = base;
    let mut prev: u64 = Absent::Row;
    for k in 0..order.len() {
        let id = order.try_get(k).unwrap_or(0);
        let start = at64(in starts, id);
        let len = at64(in lens, id);
        if prev != Absent::Row
            && ends_with(in strs, at64(in starts, prev), at64(in lens, prev), start, len)
        {
            let ok = offsets.try_set(id, wrapping_sub(wrapping_sub(offset, len), 1));
        } else {
            let ok = offsets.try_set(id, offset);
            for byte_index in 0..len {
                data.push(strs.try_get(add(start, byte_index)).unwrap_or(0));
            }
            data.push(0);
            offset = add(offset, add(len, 1));
            prev = id;
        }
    }
}

fn at64(in values: ChunkSeq[u64], i: u64) -> u64 {
    values.try_get(i).unwrap_or(0)
}

// Byte `pos` (1-based from the end) of string `id`, 0 past its start.
fn rev_byte(
    in strs: ChunkSeq[u8],
    in starts: ChunkSeq[u64],
    in lens: ChunkSeq[u64],
    id: u64,
    pos: u64
) -> u8 {
    let len = at64(in lens, id);
    if pos > len {
        return 0;
    }
    strs.try_get(add(at64(in starts, id), wrapping_sub(len, pos))).unwrap_or(0)
}

// String `a` sorts before string `b`.
fn rev_greater(
    in strs: ChunkSeq[u8],
    in starts: ChunkSeq[u64],
    in lens: ChunkSeq[u64],
    a: u64,
    b: u64
) -> bool {
    let mut pos: u64 = 1;
    loop {
        let a_byte = rev_byte(in strs, in starts, in lens, a, pos);
        let b_byte = rev_byte(in strs, in starts, in lens, b, pos);
        if a_byte != b_byte {
            return a_byte > b_byte;
        }
        if a_byte == 0 {
            return false;
        }
        pos = add(pos, 1);
    }
}

// `strs[whole_start..whole_start + whole_len]` ends with
// `strs[suffix_start..suffix_start + suffix_len]`.
fn ends_with(
    in strs: ChunkSeq[u8],
    whole_start: u64,
    whole_len: u64,
    suffix_start: u64,
    suffix_len: u64
) -> bool {
    if suffix_len > whole_len {
        return false;
    }
    let tail_at = add(whole_start, wrapping_sub(whole_len, suffix_len));
    for i in 0..suffix_len {
        if strs.try_get(add(tail_at, i)) != strs.try_get(add(suffix_start, i)) {
            return false;
        }
    }
    true
}

fn pad_to(inout out: ChunkSeq[u8], align: u64) {
    if align > 1 {
        let len = out.len();
        let remainder = len % align;
        if remainder != 0 {
            let at = grow(inout out, wrapping_sub(align, remainder));
        }
    }
}

// The stub as `object::write` lays out a relocatable ELF64 object with one
// `.text.boot` section of `code` (aligned to `align`), its RELA relocations
// and global hidden symbols: the defined ones first (symbol `i < defined`
// names `names[starts[i]..]` at `values[i]`), then the undefined ones in
// the order the relocations first name them. Section indices: 1
// `.text.boot`, 2 `.rela.text.boot`, 3 `.symtab`, 4 `.strtab`,
// 5 `.shstrtab`.
pub fn write_stub_object(
    machine: u16,
    e_flags: u32,
    align: u64,
    in code: ChunkSeq[u8],
    in names: ChunkSeq[u8],
    in starts: ChunkSeq[u64],
    in lens: ChunkSeq[u64],
    defined: u64,
    in values: ChunkSeq[u64],
    in rel_offsets: ChunkSeq[u64],
    in rel_syms: ChunkSeq[u64],
    in rel_types: ChunkSeq[u32]
) -> ChunkSeq[u8] {
    let sym_count = starts.len();
    let reloc_count = rel_offsets.len();
    // Offsets, as the writer reserves them.
    let text_off = align_to(Ehdr::Bytes, align);
    let symtab_off = align_to(add(text_off, code.len()), ELF_ALIGN);
    let symtab_size = wrapping_mul(add(sym_count, 1), SymEnt::Bytes);
    let mut strtab: ChunkSeq[u8] = ChunkSeq::new[u8]();
    strtab.push(0);
    let mut str_offsets: ChunkSeq[u64] = ChunkSeq::new[u64]();
    string_table(in names, in starts, in lens, 1, inout strtab, inout str_offsets);
    let strtab_off = add(symtab_off, symtab_size);
    let rela_off = align_to(add(strtab_off, strtab.len()), ELF_ALIGN);
    let rela_size = wrapping_mul(reloc_count, RelEnt::RelaBytes);
    // Section names, in the order the writer adds them.
    let mut sh_names: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut sh_starts: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut sh_lens: ChunkSeq[u64] = ChunkSeq::new[u64]();
    add_name(inout sh_names, inout sh_starts, inout sh_lens, in ".text.boot");
    add_name(inout sh_names, inout sh_starts, inout sh_lens, in ".rela.text.boot");
    add_name(inout sh_names, inout sh_starts, inout sh_lens, in ".symtab");
    add_name(inout sh_names, inout sh_starts, inout sh_lens, in ".strtab");
    add_name(inout sh_names, inout sh_starts, inout sh_lens, in ".shstrtab");
    let mut shstrtab: ChunkSeq[u8] = ChunkSeq::new[u8]();
    shstrtab.push(0);
    let mut sh_offsets: ChunkSeq[u64] = ChunkSeq::new[u64]();
    string_table(in sh_names, in sh_starts, in sh_lens, 1, inout shstrtab, inout sh_offsets);
    let shstrtab_off = add(rela_off, rela_size);
    let shoff = align_to(add(shstrtab_off, shstrtab.len()), ELF_ALIGN);
    let shnum: u64 = 6;

    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    // File header.
    out.push(Ident::Mag0);
    out.push(Ident::Mag1);
    out.push(Ident::Mag2);
    out.push(Ident::Mag3);
    out.push(Ident::Class64);
    out.push(Ident::Data2Lsb);
    out.push(Ident::Current);
    let at = grow(inout out, 9);
    push16(inout out, Et::Rel);
    push16(inout out, machine);
    push32(inout out, Ident::Current);
    push64(inout out, 0);
    push64(inout out, 0);
    push64(inout out, shoff);
    push32(inout out, e_flags);
    push16(inout out, Ehdr::Bytes);
    push16(inout out, 0);
    push16(inout out, 0);
    push16(inout out, Shdr::Bytes);
    push16(inout out, wrapping_u16(shnum));
    // `.shstrtab` is the last header.
    push16(inout out, wrapping_u16(wrapping_sub(shnum, 1)));
    // Section data.
    pad_to(inout out, align);
    out.extend(in code.as_slice());
    // Symbols: the null symbol, then every symbol (all global).
    pad_to(inout out, ELF_ALIGN);
    let null_sym = grow(inout out, SymEnt::Bytes);
    for i in 0..sym_count {
        push32(inout out, wrapping_u32(at64(in str_offsets, i)));
        if i < defined {
            // STB_GLOBAL, STT_FUNC; STV_HIDDEN; in `.text.boot`.
            out.push((Stb::Global << Stb::Shift) | Stt::Func);
            out.push(Stv::Hidden);
            push16(inout out, 1);
            push64(inout out, at64(in values, i));
        } else {
            // STB_GLOBAL, STT_NOTYPE; STV_HIDDEN; undefined.
            out.push((Stb::Global << Stb::Shift) | Stt::Notype);
            out.push(Stv::Hidden);
            push16(inout out, 0);
            push64(inout out, 0);
        }
        push64(inout out, 0);
    }
    out.extend(in strtab.as_slice());
    pad_to(inout out, ELF_ALIGN);
    for k in 0..reloc_count {
        push64(inout out, at64(in rel_offsets, k));
        let r_type = match rel_types.try_get(k) {
            Option::Some(v) => widen_u64(v),
            Option::None => 0,
        };
        // Symbol indices start at 1 (after the null symbol).
        push64(inout out, wrapping_shl_u64(add(at64(in rel_syms, k), 1), 32) | r_type);
        push64(inout out, 0);
    }
    out.extend(in shstrtab.as_slice());
    pad_to(inout out, ELF_ALIGN);
    // Section headers.
    let null_header = grow(inout out, Shdr::Bytes);
    section_header(
        inout out,
        at64(in sh_offsets, 0),
        Sht::Progbits,
        Shf::Alloc | Shf::Execinstr,
        text_off,
        code.len(),
        0,
        0,
        align,
        0
    );
    section_header(
        inout out,
        at64(in sh_offsets, 1),
        Sht::Rela,
        Shf::InfoLink,
        rela_off,
        rela_size,
        3,
        1,
        ELF_ALIGN,
        RelEnt::RelaBytes
    );
    section_header(
        inout out,
        at64(in sh_offsets, 2),
        Sht::Symtab,
        0,
        symtab_off,
        symtab_size,
        4,
        1,
        ELF_ALIGN,
        SymEnt::Bytes
    );
    section_header(
        inout out,
        at64(in sh_offsets, 3),
        Sht::Strtab,
        0,
        strtab_off,
        strtab.len(),
        0,
        0,
        1,
        0
    );
    section_header(
        inout out,
        at64(in sh_offsets, 4),
        Sht::Strtab,
        0,
        shstrtab_off,
        shstrtab.len(),
        0,
        0,
        1,
        0
    );
    out
}

fn add_name(
    inout strs: ChunkSeq[u8],
    inout starts: ChunkSeq[u64],
    inout lens: ChunkSeq[u64],
    in name: Str
) {
    starts.push(strs.len());
    let bytes = name.as_bytes();
    lens.push(bytes.len());
    strs.extend(in bytes);
}

fn align_to(value: u64, align: u64) -> u64 {
    if align <= 1 {
        return value;
    }
    let remainder = value % align;
    if remainder == 0 {
        value
    } else {
        add(value, wrapping_sub(align, remainder))
    }
}

pub fn section_header(
    inout out: ChunkSeq[u8],
    name: u64,
    kind: u64,
    flags: u64,
    offset: u64,
    size: u64,
    link: u64,
    info: u64,
    align: u64,
    entsize: u64
) {
    push32(inout out, wrapping_u32(name));
    push32(inout out, wrapping_u32(kind));
    push64(inout out, flags);
    push64(inout out, 0);
    push64(inout out, offset);
    push64(inout out, size);
    push32(inout out, wrapping_u32(link));
    push32(inout out, wrapping_u32(info));
    push64(inout out, align);
    push64(inout out, entsize);
}

// Output section of an input section in `link::link` (`classify`):
// OUT_TEXT..OUT_BSS (link.ves order), 4 to skip it, 5 for an allocated
// section the linker cannot place.
pub fn classify(section: Sec) -> u8 {
    if section.flags & Shf::Alloc == 0 {
        return 4;
    }
    let kind = sec_kind(section);
    if kind == Kind::Text {
        0
    } else if kind == Kind::Rodata {
        1
    } else if kind == Kind::Data {
        2
    } else if kind == Kind::Bss {
        3
    } else if section.size == 0 {
        4
    } else {
        5
    }
}

pub fn is_nobits(section: Sec) -> bool {
    section.sh_type == Sht::Nobits
}

// `SymbolSection::Section(_)`.
pub fn sym_in_section(symbol: Sym) -> bool {
    symbol.shndx != Shn::Undef && symbol.shndx < Shn::Loreserve
}

pub fn sym_undefined(symbol: Sym) -> bool {
    symbol.shndx == Shn::Undef
}

// `SymbolSection::Absolute` (a file symbol is `None`).
pub fn sym_absolute(symbol: Sym) -> bool {
    symbol.shndx == Shn::Abs && (symbol.info & Stt::Mask) != Stt::File
}

pub fn sym_is_section(symbol: Sym) -> bool {
    (symbol.info & Stt::Mask) == Stt::Section
}

pub fn sym_global(symbol: Sym) -> bool {
    (symbol.info >> Stb::Shift) != Stb::Local
}
