// The static linker for freestanding images (src/freestanding/link.rs) and
// the trap-table fill of src/native_freestanding.rs (`resolve_traps`,
// `patch_trap_table`).
//
// Objects are parsed in place in the request (obj.ves); the pieces' bytes
// are copied into one buffer so relocations can patch them. Symbol names
// are copied into one name pool. The tables are small (one entry per
// function and data object of an image), so lookups are linear scans.

use self::codes::{Absent, Out, Page, RelType, RvOpcode};
use self::util::{
    Span, add, sub, max64, align_up, bytes_eq, fnv, text_eq, push64, put_str, push_hex, push_dec,
    rd32
};
use self::error::{
    fail_duplicate, fail_mismatch, fail_object, fail_object_in, fail_object_text, fail_range,
    fail_relocation, fail_section, fail_too_large, fail_unresolved
};
use self::obj::{
    Obj, Sec, Sym, Rel, classify, is_nobits, parse_object, is_relocatable, sec, sym, sym_absolute,
    sym_global, sym_in_section, sym_is_section, sym_undefined, rel_count, rel_at
};
use self::stub::{is_riscv, machine_of};
use self::script::{triple};
use self::elf::{OutSec, OutSeg, OutSym, Placement, pf_rw, pf_rx, write_executable};

// The four sections contributed by input objects precede the stack.
const OUTS: u64 = Out::Stack;

// The object index of linker-defined symbols.
const LINKER_OBJECT: u64 = Absent::Row;

// Layout alignments: .data starts a page (`Page::Bytes`), the other output sections and
// the stack 16 bytes, and .bss ends on the stub's eight-byte clear step.
const SECTION_ALIGN: u64 = 16;
const STACK_ALIGN: u64 = 16;
const BSS_STEP: u64 = 8;

enum TrapTable: _ {
    HeaderBytes = 8,
    EntryBytes = 24,
}

// Linker-defined symbols, in `BTreeMap` (name) order.
enum Defined: _ {
    BssEnd = 0,
    BssStart = 1,
    ImageEnd = 2,
    ImageStart = 3,
    StackBottom = 4,
    StackTop = 5,
}
const LINKER_SYMBOLS: u64 = 6;

fn linker_name(i: u64) -> Str {
    if i == Defined::BssEnd {
        "__bss_end"
    } else if i == Defined::BssStart {
        "__bss_start"
    } else if i == Defined::ImageEnd {
        "__image_end"
    } else if i == Defined::ImageStart {
        "__image_start"
    } else if i == Defined::StackBottom {
        "__stack_bottom"
    } else {
        "__stack_top"
    }
}

pub copy struct LinkOptions {
    target: u64,
    image_base: u64,
    ram_base: u64,
    ram_bytes: u64,
    stack_bytes: u64,
}

pub copy struct Piece {
    obj_index: u64,
    sec_index: u64,
    out_index: u8,
    boot: bool,
    align: u64,
    data_at: u64,
    data_len: u64,
    size: u64,
    address: u64,
}

// A symbol of the output (`LinkedSymbol`); its name is `names[name_at..]`.
pub copy struct Linked {
    obj_index: u64,
    hash: u64,
    name_at: u64,
    name_len: u64,
    address: u64,
    size: u64,
    global: bool,
}

// A trap-table entry to resolve: `function` of object `object` plus
// `offset` (native_freestanding.rs `TrapEntry`).
pub copy struct TrapEntry {
    object: Span,
    function: Span,
    offset: u64,
}

pub struct Linker {
    opts: LinkOptions,
    objs: ChunkSeq[Obj],
    secs: ChunkSeq[Sec],
    syms: ChunkSeq[Sym],
    pieces: ChunkSeq[Piece],
    // Piece of each section row (`secs` index), Absent::Row for none.
    piece_of: ChunkSeq[u64],
    piece_data: ChunkSeq[u8],
    names: ChunkSeq[u8],
    linked: ChunkSeq[Linked],
    // Global symbols: rows of `linked`.
    globals: ChunkSeq[u64],
    defined_values: ChunkSeq[u64],
    out_ranges: ChunkSeq[u64],
    entry: u64,
    stack_bottom: u64,
    stack_top: u64,
    elf: ChunkSeq[u8],
    placements: ChunkSeq[Placement],
    e_flags: u32,
}

fn piece_at(in pieces: ChunkSeq[Piece], i: u64) -> Piece {
    match pieces.try_get(i) {
        Option::Some(p) => p,
        Option::None => Piece {
            obj_index: 0,
            sec_index: 0,
            out_index: 0,
            boot: false,
            align: 1,
            data_at: 0,
            data_len: 0,
            size: 0,
            address: 0
        },
    }
}

fn obj_at(in objs: ChunkSeq[Obj], i: u64) -> Obj {
    match objs.try_get(i) {
        Option::Some(o) => o,
        Option::None => Obj {
            name: Span { start: 0, len: 0 },
            base: 0,
            len: 0,
            e_type: 0,
            machine: 0,
            e_flags: 0,
            sec_start: 0,
            sec_count: 0,
            sym_start: 0,
            sym_count: 0,
            symtab: 0
        },
    }
}

fn w_at(in words: ChunkSeq[u64], i: u64) -> u64 {
    words.try_get(i).unwrap_or(Absent::Row)
}

fn linked_at(in linked: ChunkSeq[Linked], i: u64) -> Linked {
    match linked.try_get(i) {
        Option::Some(v) => v,
        Option::None => Linked {
            obj_index: 0,
            hash: 0,
            name_at: 0,
            name_len: 0,
            address: 0,
            size: 0,
            global: false
        },
    }
}

pub fn linker_new(opts: LinkOptions) -> Linker {
    Linker {
        opts: opts,
        objs: ChunkSeq::new[Obj](),
        secs: ChunkSeq::new[Sec](),
        syms: ChunkSeq::new[Sym](),
        pieces: ChunkSeq::new[Piece](),
        piece_of: ChunkSeq::new[u64](),
        piece_data: ChunkSeq::new[u8](),
        names: ChunkSeq::new[u8](),
        linked: ChunkSeq::new[Linked](),
        globals: ChunkSeq::new[u64](),
        defined_values: ChunkSeq::new[u64](),
        out_ranges: ChunkSeq::new[u64](),
        entry: 0,
        stack_bottom: 0,
        stack_top: 0,
        elf: ChunkSeq::new[u8](),
        placements: ChunkSeq::new[Placement](),
        e_flags: 0
    }
}

impl Linker {
    // Adds input object `req[base..base + len]` named `req[name]`. False (and
    // `err` set) when it is malformed or not for the target.
    pub fn add_object(
        inout self,
        in req: Slice[u8],
        name: Span,
        base: u64,
        len: u64,
        inout err: ChunkSeq[u8]
    ) -> bool {
        let mut why: ChunkSeq[u8] = ChunkSeq::new[u8]();
        let obj = parse_object(
            in req,
            name,
            base,
            len,
            inout self.secs,
            inout self.syms,
            inout why
        );
        let obj_name = req[name.start..add(name.start, name.len)];
        if why.len() != 0 {
            let mut message: ChunkSeq[u8] = ChunkSeq::new[u8]();
            message.extend(in obj_name);
            message.extend(in ": ".as_bytes());
            message.extend(in why.as_slice());
            fail_object(inout err, in message);
            return false;
        }
        let machine = machine_of(self.opts.target);
        if !is_relocatable(obj) || obj.machine != machine {
            let mut message: ChunkSeq[u8] = ChunkSeq::new[u8]();
            message.extend(in obj_name);
            message.extend(in ": not a relocatable ELF object for ".as_bytes());
            message.extend(in triple(self.opts.target).as_bytes());
            fail_object(inout err, in message);
            return false;
        }
        if self.objs.len() == 0 {
            self.e_flags = obj.e_flags;
        } else if obj.e_flags != self.e_flags {
            let mut message: ChunkSeq[u8] = ChunkSeq::new[u8]();
            message.extend(in obj_name);
            message.extend(in ": e_flags ".as_bytes());
            push_hex(inout message, widen_u64(obj.e_flags));
            message.extend(in " differ from ".as_bytes());
            push_hex(inout message, widen_u64(self.e_flags));
            fail_object(inout err, in message);
            return false;
        }
        self.objs.push(obj);
        true
    }

    fn oname_at(in self, obj_index: u64) -> Span {
        obj_at(in self.objs, obj_index).name
    }

    // `link::link` after the objects are parsed.
    pub fn link(inout self, in req: Slice[u8], inout err: ChunkSeq[u8]) -> bool {
        self.piece_of.resize(self.secs.len(), Absent::Row);
        // Collect pieces.
        for obj_index in 0..self.objs.len() {
            let obj = obj_at(in self.objs, obj_index);
            let name_span = obj.name;
            for sec_index in 1..obj.sec_count {
                let section = sec(in self.secs, obj, sec_index);
                if !section.name_ok {
                    fail_object_in(
                        inout err,
                        in req[name_span.start..add(name_span.start, name_span.len)],
                        in "invalid section name"
                    );
                    return false;
                }
                let out_index = classify(section);
                if out_index == 4 {
                    continue;
                }
                if out_index == 5 {
                    fail_section(
                        inout err,
                        in req[name_span.start..add(name_span.start, name_span.len)],
                        in req[section.name_at..add(section.name_at, section.name_len)]
                    );
                    return false;
                }
                let data_at = self.piece_data.len();
                let mut data_len: u64 = 0;
                if out_index != Out::Bss {
                    if !section.data_ok {
                        fail_object_in(
                            inout err,
                            in req[name_span.start..add(name_span.start, name_span.len)],
                            in "invalid section data"
                        );
                        return false;
                    }
                    if !is_nobits(section) {
                        self.piece_data
                            .extend(in req[section.data_at..add(section.data_at, section.size)]);
                        data_len = section.size;
                    }
                }
                let ok = self.piece_of.try_set(add(obj.sec_start, sec_index), self.pieces.len());
                self.pieces.push(
                    Piece {
                        obj_index: obj_index,
                        sec_index: sec_index,
                        out_index: out_index,
                        boot: text_eq(in req, section.name_at, section.name_len, in ".text.boot"),
                        align: if section.align == 0 { 1 } else { section.align },
                        data_at: data_at,
                        data_len: data_len,
                        size: section.size,
                        address: 0
                    }
                );
            }
        }
        let mut boot_count: u64 = 0;
        for i in 0..self.pieces.len() {
            if piece_at(in self.pieces, i).boot {
                boot_count = add(boot_count, 1);
            }
        }
        if boot_count != 1 {
            fail_object_text(inout err, in "exactly one input must provide .text.boot");
            return false;
        }
        // Layout: boot first, then input order within each output section.
        let mut cursor = self.opts.image_base;
        for out_index in 0..OUTS {
            let align: u64 = if out_index == widen_u64(Out::Data) {
                Page::Bytes
            } else {
                SECTION_ALIGN
            };
            cursor = align_up(cursor, align);
            let start = cursor;
            for pass in 0..2 {
                for i in 0..self.pieces.len() {
                    let mut piece = piece_at(in self.pieces, i);
                    if widen_u64(piece.out_index) == out_index && (piece.boot == (pass == 0)) {
                        cursor = align_up(cursor, piece.align);
                        piece.address = cursor;
                        cursor = add(cursor, piece.size);
                        let ok = self.pieces.try_set(i, piece);
                    }
                }
            }
            if out_index == widen_u64(Out::Bss) {
                // The stub clears .bss eight bytes at a time.
                cursor = align_up(cursor, BSS_STEP);
            }
            self.out_ranges.push(start);
            self.out_ranges.push(cursor);
        }
        let bss_start = w_at(in self.out_ranges, 6);
        let bss_end = w_at(in self.out_ranges, 7);
        let data_end = w_at(in self.out_ranges, 5);
        self.stack_bottom = align_up(max64(bss_end, data_end), STACK_ALIGN);
        self.stack_top = add(self.stack_bottom, align_up(self.opts.stack_bytes, STACK_ALIGN));
        let ram_end = add(self.opts.ram_base, self.opts.ram_bytes);
        if self.opts.image_base < self.opts.ram_base || self.stack_top > ram_end {
            let needed = if self.stack_top > self.opts.ram_base {
                sub(self.stack_top, self.opts.ram_base)
            } else {
                0
            };
            fail_too_large(inout err, needed, self.opts.ram_bytes);
            return false;
        }
        self.defined_values.push(bss_end);
        self.defined_values.push(bss_start);
        self.defined_values.push(self.stack_top);
        self.defined_values.push(self.opts.image_base);
        self.defined_values.push(self.stack_bottom);
        self.defined_values.push(self.stack_top);
        // Symbols.
        for obj_index in 0..self.objs.len() {
            let obj = obj_at(in self.objs, obj_index);
            let name_span = obj.name;
            for sym_index in 1..obj.sym_count {
                let symbol = sym(in self.syms, obj, sym_index);
                if !sym_in_section(symbol) {
                    continue;
                }
                let piece_index = w_at(
                    in self.piece_of,
                    add(obj.sec_start, widen_u64(symbol.shndx))
                );
                if widen_u64(symbol.shndx) >= obj.sec_count || piece_index == Absent::Row {
                    continue;
                }
                if !symbol.name_ok {
                    fail_object_in(
                        inout err,
                        in req[name_span.start..add(name_span.start, name_span.len)],
                        in "invalid symbol name"
                    );
                    return false;
                }
                if symbol.name_len == 0 || sym_is_section(symbol) {
                    continue;
                }
                let address = add(piece_at(in self.pieces, piece_index).address, symbol.value);
                let global = sym_global(symbol);
                let name = req[symbol.name_at..add(symbol.name_at, symbol.name_len)];
                let hash = fnv(in name);
                if global
                    && (
                        self.is_linker_symbol(in name)
                            || self.global_hashed(in name, hash) != Absent::Row
                    ) {
                    fail_duplicate(inout err, in name);
                    return false;
                }
                let name_at = self.names.len();
                self.names.extend(in name);
                if global {
                    self.globals.push(self.linked.len());
                }
                self.linked.push(
                    Linked {
                        obj_index: obj_index,
                        hash: hash,
                        name_at: name_at,
                        name_len: symbol.name_len,
                        address: address,
                        size: symbol.size,
                        global: global
                    }
                );
            }
        }
        let start_row = self.global(in "_start".as_bytes());
        if start_row == Absent::Row {
            fail_unresolved(inout err, in "_start".as_bytes(), in "linker".as_bytes());
            return false;
        }
        self.entry = linked_at(in self.linked, start_row).address;
        // Relocations.
        for obj_index in 0..self.objs.len() {
            let obj = obj_at(in self.objs, obj_index);
            let name_span = obj.name;
            let obj_name = req[name_span.start..add(name_span.start, name_span.len)];
            for sec_index in 1..obj.sec_count {
                let piece_index = w_at(in self.piece_of, add(obj.sec_start, sec_index));
                if piece_index == Absent::Row {
                    continue;
                }
                let mut rel_sec_index = sec(in self.secs, obj, sec_index).rel_chain;
                loop {
                    if rel_sec_index == 0 {
                        break;
                    }
                    let rel_sec = sec(in self.secs, obj, rel_sec_index);
                    for rel_index in 0..rel_count(rel_sec) {
                        let rel = rel_at(in req, rel_sec, rel_index);
                        if !self.relocate(in req, obj_index, piece_index, rel, inout err) {
                            return false;
                        }
                    }
                    rel_sec_index = rel_sec.rel_chain;
                }
            }
        }
        self.write(in req);
        true
    }

    fn is_linker_symbol(in self, in name: Slice[u8]) -> bool {
        for i in 0..LINKER_SYMBOLS {
            if name_is(in name, in linker_name(i)) {
                return true;
            }
        }
        false
    }

    // Row of `linked` of the global `name`, Absent::Row for none.
    fn global(in self, in name: Slice[u8]) -> u64 {
        self.global_hashed(in name, fnv(in name))
    }

    fn global_hashed(in self, in name: Slice[u8], hash: u64) -> u64 {
        for i in 0..self.globals.len() {
            let row = w_at(in self.globals, i);
            let linked_sym = linked_at(in self.linked, row);
            if linked_sym.hash == hash
                && linked_sym.name_len == name.len()
                && bytes_eq(in self.names.as_slice(), linked_sym.name_at, in name, 0, name.len()) {
                return row;
            }
        }
        Absent::Row
    }

    fn defined_value(in self, in name: Slice[u8]) -> u64 {
        for i in 0..LINKER_SYMBOLS {
            if name_is(in name, in linker_name(i)) {
                return w_at(in self.defined_values, i);
            }
        }
        Absent::Row
    }

    fn relocate(
        inout self,
        in req: Slice[u8],
        obj_index: u64,
        piece_index: u64,
        rel: Rel,
        inout err: ChunkSeq[u8]
    ) -> bool {
        let obj = obj_at(in self.objs, obj_index);
        let name_span = obj.name;
        let obj_name = req[name_span.start..add(name_span.start, name_span.len)];
        if rel.r_type == RelType::RiscvRelax {
            return true;
        }
        if rel.sym_index == 0 {
            fail_relocation(inout err, in obj_name, rel.r_type);
            return false;
        }
        if rel.sym_index >= obj.sym_count {
            fail_object_in(inout err, in obj_name, in "invalid symbol index");
            return false;
        }
        let symbol = sym(in self.syms, obj, rel.sym_index);
        let name_len = if symbol.name_ok { symbol.name_len } else { 0 };
        let name = req[symbol.name_at..add(symbol.name_at, name_len)];
        let mut target: u64 = 0;
        if sym_in_section(symbol) {
            let target_piece = w_at(in self.piece_of, add(obj.sec_start, widen_u64(symbol.shndx)));
            if widen_u64(symbol.shndx) >= obj.sec_count || target_piece == Absent::Row {
                fail_object_in(inout err, in obj_name, in "relocation against an unloaded section");
                return false;
            }
            target = add(piece_at(in self.pieces, target_piece).address, symbol.value);
        } else if sym_undefined(symbol) {
            let global_row = self.global(in name);
            if global_row != Absent::Row {
                target = linked_at(in self.linked, global_row).address;
            } else {
                let defined_addr = self.defined_value(in name);
                if defined_addr == Absent::Row {
                    fail_unresolved(inout err, in name, in obj_name);
                    return false;
                }
                target = defined_addr;
            }
        } else if sym_absolute(symbol) {
            target = symbol.value;
        } else {
            let mut message: ChunkSeq[u8] = ChunkSeq::new[u8]();
            message.extend(in obj_name);
            message.extend(in ": unsupported symbol section for '".as_bytes());
            message.extend(in name);
            message.extend(in "'".as_bytes());
            fail_object(inout err, in message);
            return false;
        }
        let s_plus_a = add(target, rel.addend);
        let piece = piece_at(in self.pieces, piece_index);
        let place = add(piece.address, rel.offset);
        if piece.out_index == Out::Bss || rel.offset >= piece.data_len {
            fail_object_in(inout err, in obj_name, in "relocation offset out of section");
            return false;
        }
        let at = add(piece.data_at, rel.offset);
        let end = add(piece.data_at, piece.data_len);
        let riscv = is_riscv(self.opts.target);
        let r_type = rel.r_type;
        if (riscv && r_type == RelType::Riscv64) || (!riscv && r_type == RelType::Aarch64Abs64) {
            if add(at, 8) > end {
                fail_object_in(inout err, in obj_name, in "relocation runs past its section");
                return false;
            }
            let ok = self.piece_data.try_write_u64_le(at, s_plus_a);
        } else if riscv && (r_type == RelType::RiscvCall || r_type == RelType::RiscvCallPlt) {
            // auipc rX, hi ; jalr rY, lo(rX)
            let off = sub(s_plus_a, place);
            // -2^31 <= off < 2^31 - 0x800
            if add(off, 0x80000000) >= 0xfffff800 {
                fail_range(inout err, in obj_name, in name, r_type);
                return false;
            }
            if add(at, 8) > end {
                fail_object_in(inout err, in obj_name, in "relocation runs past its section");
                return false;
            }
            let auipc = self.read32(at);
            let jalr = self.read32(add(at, 4));
            if auipc & RvOpcode::Mask != RvOpcode::Auipc
                || jalr & RvOpcode::Mask != RvOpcode::Jalr {
                fail_object_in(
                    inout err,
                    in obj_name,
                    in "R_RISCV_CALL does not point at auipc+jalr"
                );
                return false;
            }
            let hi = wrapping_u32((add(off, 0x800) >> 12) & 0xfffff);
            let lo = wrapping_u32(off & 0xfff);
            let auipc_patched = (auipc & 0xfff) | (hi << 12);
            let jalr_patched = (jalr & 0xfffff) | (lo << 20);
            let ok1 = self.piece_data.try_write_u32_le(at, auipc_patched);
            let ok2 = self.piece_data.try_write_u32_le(add(at, 4), jalr_patched);
        } else if !riscv && (r_type == RelType::Aarch64Call26 || r_type == RelType::Aarch64Jump26) {
            let off = sub(s_plus_a, place);
            // off % 4 == 0 and -2^27 <= off < 2^27
            if off & 3 != 0 || add(off, 0x8000000) >= 0x10000000 {
                fail_range(inout err, in obj_name, in name, r_type);
                return false;
            }
            if add(at, 4) > end {
                fail_object_in(inout err, in obj_name, in "relocation runs past its section");
                return false;
            }
            let word = self.read32(at);
            let patched = (word & 0xfc000000) | (wrapping_u32(off >> 2) & 0x3ffffff);
            let ok = self.piece_data.try_write_u32_le(at, patched);
        } else {
            fail_relocation(inout err, in obj_name, r_type);
            return false;
        }
        true
    }

    fn read32(in self, at: u64) -> u32 {
        self.piece_data.try_read_u32_le(at).unwrap_or(0)
    }

    // The output sections, symbols and the executable.
    fn write(inout self, in req: Slice[u8]) {
        let mut data: ChunkSeq[u8] = ChunkSeq::new[u8]();
        let mut secs: ChunkSeq[OutSec] = ChunkSeq::new[OutSec]();
        for out_index in 0..OUTS {
            let start = w_at(in self.out_ranges, wrapping_mul(out_index, 2));
            let end = w_at(in self.out_ranges, add(wrapping_mul(out_index, 2), 1));
            let data_at = data.len();
            let bss = out_index == widen_u64(Out::Bss);
            if !bss {
                data.resize(add(data_at, sub(end, start)), 0);
                for i in 0..self.pieces.len() {
                    let piece = piece_at(in self.pieces, i);
                    if widen_u64(piece.out_index) == out_index {
                        let dest_at = add(data_at, sub(piece.address, start));
                        let ok = data.try_copy_from(
                            dest_at,
                            in self.piece_data[piece.data_at..add(piece.data_at, piece.data_len)]
                        );
                    }
                }
            }
            secs.push(
                OutSec {
                    name: out_index,
                    address: start,
                    data_at: data_at,
                    data_len: if bss { 0 } else { sub(end, start) },
                    mem_bytes: sub(end, start),
                    nobits: bss,
                    writable: out_index >= widen_u64(Out::Data),
                    executable: out_index == widen_u64(Out::Text)
                }
            );
        }
        secs.push(
            OutSec {
                name: Out::Stack,
                address: self.stack_bottom,
                data_at: data.len(),
                data_len: 0,
                mem_bytes: sub(self.stack_top, self.stack_bottom),
                nobits: true,
                writable: true,
                executable: false
            }
        );
        let mut segs: ChunkSeq[OutSeg] = ChunkSeq::new[OutSeg]();
        segs.push(OutSeg { first: Out::Text, end: Out::Data, flags: pf_rx() });
        segs.push(OutSeg { first: Out::Data, end: secs.len(), flags: pf_rw() });
        let mut out_syms: ChunkSeq[OutSym] = ChunkSeq::new[OutSym]();
        for i in 0..self.linked.len() {
            let linked_sym = linked_at(in self.linked, i);
            let section = section_of(in secs, linked_sym.address);
            out_syms.push(
                OutSym {
                    name_at: linked_sym.name_at,
                    name_len: linked_sym.name_len,
                    value: linked_sym.address,
                    size: linked_sym.size,
                    global: linked_sym.global,
                    function: section == Out::Text,
                    section: section
                }
            );
        }
        for i in 0..LINKER_SYMBOLS {
            let at = self.names.len();
            let name_bytes = linker_name(i).as_bytes();
            self.names.extend(in name_bytes);
            let value = w_at(in self.defined_values, i);
            out_syms.push(
                OutSym {
                    name_at: at,
                    name_len: name_bytes.len(),
                    value: value,
                    size: 0,
                    global: true,
                    function: false,
                    section: Absent::Row
                }
            );
            self.linked.push(
                Linked {
                    obj_index: LINKER_OBJECT,
                    hash: 0,
                    name_at: at,
                    name_len: name_bytes.len(),
                    address: value,
                    size: 0,
                    global: true
                }
            );
        }
        let machine = machine_of(self.opts.target);
        self.elf = write_executable(
            machine,
            self.e_flags,
            self.entry,
            in secs,
            in data,
            in segs,
            in self.names,
            in out_syms,
            inout self.placements
        );
    }

    // `resolve_traps` and `patch_trap_table`: the PC of each entry, written
    // into the linked image's trap table.
    pub fn patch_traps(
        inout self,
        in req: Slice[u8],
        in entries: ChunkSeq[TrapEntry],
        inout pcs: ChunkSeq[u64],
        inout err: ChunkSeq[u8]
    ) -> bool {
        for i in 0..entries.len() {
            let trap = match entries.try_get(i) {
                Option::Some(v) => v,
                Option::None => TrapEntry {
                    object: Span { start: 0, len: 0 },
                    function: Span { start: 0, len: 0 },
                    offset: 0
                },
            };
            let mut found = Absent::Row;
            for k in 0..self.linked.len() {
                let linked_sym = linked_at(in self.linked, k);
                if found == Absent::Row
                    && linked_sym.obj_index != LINKER_OBJECT
                    && linked_sym.name_len == trap.function.len {
                    let name_span = obj_at(in self.objs, linked_sym.obj_index).name;
                    if name_span.len == trap.object.len
                        && bytes_eq(
                            in req,
                            name_span.start,
                            in req,
                            trap.object.start,
                            name_span.len
                        )
                        && bytes_eq(
                            in self.names.as_slice(),
                            linked_sym.name_at,
                            in req,
                            trap.function.start,
                            linked_sym.name_len
                        ) {
                        found = k;
                    }
                }
            }
            if found == Absent::Row {
                fail_unresolved(
                    inout err,
                    in req[trap.function.start..add(trap.function.start, trap.function.len)],
                    in "trap table".as_bytes()
                );
                return false;
            }
            pcs.push(add(linked_at(in self.linked, found).address, trap.offset));
        }
        let mut table = Absent::Row;
        for k in 0..self.linked.len() {
            let linked_sym = linked_at(in self.linked, k);
            if table == Absent::Row
                && name_is(
                    in self.names[linked_sym.name_at..add(linked_sym.name_at, linked_sym.name_len)],
                    in "vesper_trap_table"
                ) {
                table = linked_sym.address;
            }
        }
        if table == Absent::Row {
            fail_unresolved(
                inout err,
                in "vesper_trap_table".as_bytes(),
                in "trap table".as_bytes()
            );
            return false;
        }
        let count_at = self.file_offset(table);
        if count_at == Absent::Row {
            self.not_loaded(table, inout err);
            return false;
        }
        let count = self.elf.try_read_u64_le(count_at).unwrap_or(0);
        if count != pcs.len() {
            let mut message: ChunkSeq[u8] = ChunkSeq::new[u8]();
            message.extend(in "trap table holds ".as_bytes());
            push_dec(inout message, count);
            message.extend(in " entries, image has ".as_bytes());
            push_dec(inout message, pcs.len());
            message.extend(in " trap sites".as_bytes());
            fail_object(inout err, in message);
            return false;
        }
        for i in 0..pcs.len() {
            let addr = add(
                table,
                add(TrapTable::HeaderBytes, wrapping_mul(i, TrapTable::EntryBytes))
            );
            let at = self.file_offset(addr);
            if at == Absent::Row {
                self.not_loaded(addr, inout err);
                return false;
            }
            let ok = self.elf.try_write_u64_le(at, w_at(in pcs, i));
        }
        true
    }

    fn not_loaded(in self, addr: u64, inout err: ChunkSeq[u8]) {
        let mut message: ChunkSeq[u8] = ChunkSeq::new[u8]();
        message.extend(in "trap table address ".as_bytes());
        push_hex(inout message, addr);
        message.extend(in " is not in a loaded segment".as_bytes());
        fail_object(inout err, in message);
    }

    fn file_offset(in self, addr: u64) -> u64 {
        for i in 0..self.placements.len() {
            let placement = match self.placements.try_get(i) {
                Option::Some(v) => v,
                Option::None => Placement { vaddr: 0, offset: 0, file_bytes: 0, mem_bytes: 0 },
            };
            if addr >= placement.vaddr
                && add(addr, 8) <= add(placement.vaddr, placement.file_bytes) {
                return add(placement.offset, sub(addr, placement.vaddr));
            }
        }
        Absent::Row
    }

    // The result words of a successful link (lib.ves `freestanding_link`).
    pub fn put_result(in self, in req: Slice[u8], in pcs: ChunkSeq[u64], inout out: ChunkSeq[u8]) {
        push64(inout out, self.entry);
        for k in 0..OUTS {
            let start = w_at(in self.out_ranges, wrapping_mul(k, 2));
            let end = w_at(in self.out_ranges, add(wrapping_mul(k, 2), 1));
            push64(inout out, start);
            push64(inout out, sub(end, start));
        }
        push64(inout out, self.stack_bottom);
        push64(inout out, self.stack_top);
        push64(inout out, self.stack_top);
        push64(inout out, self.placements.len());
        for i in 0..self.placements.len() {
            let placement = match self.placements.try_get(i) {
                Option::Some(v) => v,
                Option::None => Placement { vaddr: 0, offset: 0, file_bytes: 0, mem_bytes: 0 },
            };
            push64(inout out, placement.vaddr);
            push64(inout out, placement.offset);
            push64(inout out, placement.file_bytes);
            push64(inout out, placement.mem_bytes);
            let flags = if i == 0 { pf_rx() } else { pf_rw() };
            push64(inout out, widen_u64(flags));
        }
        push64(inout out, self.linked.len());
        for i in 0..self.linked.len() {
            let linked_sym = linked_at(in self.linked, i);
            if linked_sym.obj_index == LINKER_OBJECT {
                put_str(inout out, in "linker".as_bytes());
            } else {
                let name_span = obj_at(in self.objs, linked_sym.obj_index).name;
                put_str(inout out, in req[name_span.start..add(name_span.start, name_span.len)]);
            }
            put_str(
                inout out,
                in self.names[linked_sym.name_at..add(linked_sym.name_at, linked_sym.name_len)]
            );
            push64(inout out, linked_sym.address);
            push64(inout out, linked_sym.size);
            push64(inout out, if linked_sym.global { 1 } else { 0 });
        }
        push64(inout out, pcs.len());
        for i in 0..pcs.len() {
            push64(inout out, w_at(in pcs, i));
        }
        put_str(inout out, in self.elf.as_slice());
    }
}

// The output section holding `addr` (link.rs `section_of`), Absent::Row for none.
fn section_of(in secs: ChunkSeq[OutSec], addr: u64) -> u64 {
    for i in 0..secs.len() {
        let out_sec = match secs.try_get(i) {
            Option::Some(v) => v,
            Option::None => OutSec {
                name: 0,
                address: 0,
                data_at: 0,
                data_len: 0,
                mem_bytes: 0,
                nobits: true,
                writable: false,
                executable: false
            },
        };
        let size = if out_sec.mem_bytes == 0 {
            1
        } else {
            out_sec.mem_bytes
        };
        if addr >= out_sec.address && addr < add(out_sec.address, size) {
            return i;
        }
    }
    Absent::Row
}

fn name_is(in name: Slice[u8], in text: Str) -> bool {
    let text_bytes = text.as_bytes();
    name.len() == text_bytes.len() && bytes_eq(in name, 0, in text_bytes, 0, text_bytes.len())
}

// `checks::compare_code`: the bytes of `symbol` in the relocatable object
// `req[base..base + len]` equal `req[code]`.
pub fn compare_code(
    in req: Slice[u8],
    base: u64,
    len: u64,
    symbol: Span,
    code: Span,
    inout err: ChunkSeq[u8]
) {
    let mut secs: ChunkSeq[Sec] = ChunkSeq::new[Sec]();
    let mut syms: ChunkSeq[Sym] = ChunkSeq::new[Sym]();
    let mut why: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let obj = parse_object(in req, symbol, base, len, inout secs, inout syms, inout why);
    let symbol_name = req[symbol.start..add(symbol.start, symbol.len)];
    if why.len() != 0 {
        fail_object(inout err, in why);
        return;
    }
    let mut found = Absent::Row;
    for k in 1..obj.sym_count {
        let sym_entry = sym(in syms, obj, k);
        if found == Absent::Row
            && sym_entry.name_ok
            && sym_entry.name_len == symbol.len
            && bytes_eq(in req, sym_entry.name_at, in symbol_name, 0, symbol.len) {
            found = k;
        }
    }
    if found == Absent::Row {
        fail_mismatch(inout err, in symbol_name);
        return;
    }
    let sym_entry = sym(in syms, obj, found);
    if !sym_in_section(sym_entry) {
        fail_mismatch(inout err, in symbol_name);
        return;
    }
    if widen_u64(sym_entry.shndx) >= obj.sec_count {
        fail_object_text(inout err, in "invalid section index");
        return;
    }
    let section = sec(in secs, obj, widen_u64(sym_entry.shndx));
    if !section.data_ok {
        fail_object_text(inout err, in "invalid section data");
        return;
    }
    let data_len = if is_nobits(section) { 0 } else { section.size };
    let start = sym_entry.value;
    if add(start, code.len) < start || add(start, code.len) > data_len {
        fail_mismatch(inout err, in symbol_name);
        return;
    }
    if !bytes_eq(in req, add(section.data_at, start), in req, code.start, code.len)
        || sym_entry.size != code.len {
        fail_mismatch(inout err, in symbol_name);
    }
}
