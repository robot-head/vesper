// Little-endian ELF64 executables (src/freestanding/elf.rs):
// `write_executable` and `read_executable`.

use self::codes::{
    Absent,
    Ehdr,
    Et,
    Ident,
    Out,
    Page,
    Pf,
    Phdr,
    Pt,
    Shdr,
    Shf,
    Shn,
    Sht,
    Stb,
    Stt,
    SymEnt
};
use self::util::{add, sub, max64, grow, push16, push32, push64, put_str, rd8, rd16, rd32, rd64};
use self::obj::{section_header};

pub fn pf_rx() -> u32 {
    Pf::R | Pf::X
}

pub fn pf_rw() -> u32 {
    Pf::R | Pf::W
}

// Output section names (link.rs `OUT_NAMES` and `.stack`).
pub fn section_name(i: u64) -> Str {
    if i == Out::Text {
        ".text"
    } else if i == Out::Rodata {
        ".rodata"
    } else if i == Out::Data {
        ".data"
    } else if i == Out::Bss {
        ".bss"
    } else {
        ".stack"
    }
}

// One output section (`OutSection`): its data is `data[data_at..data_at +
// data_len]` (nothing when `nobits`).
pub copy struct OutSec {
    name: u64,
    address: u64,
    data_at: u64,
    data_len: u64,
    mem_bytes: u64,
    nobits: bool,
    writable: bool,
    executable: bool,
}

// One `PT_LOAD` over sections `first..end` (`OutSegment`).
pub copy struct OutSeg {
    first: u64,
    end: u64,
    flags: u32,
}

// A `.symtab` symbol (`OutSymbol`); its name is `names[name_at..name_at +
// name_len]`; `section` is an index into the section list or Absent::Row for an
// absolute symbol.
pub copy struct OutSym {
    name_at: u64,
    name_len: u64,
    value: u64,
    size: u64,
    global: bool,
    function: bool,
    section: u64,
}

// `(vaddr, file offset, file bytes, memory bytes)` of a written segment.
pub copy struct Placement {
    vaddr: u64,
    offset: u64,
    file_bytes: u64,
    mem_bytes: u64,
}

fn s_at(in secs: ChunkSeq[OutSec], i: u64) -> OutSec {
    match secs.try_get(i) {
        Option::Some(s) => s,
        Option::None => OutSec {
            name: 0,
            address: 0,
            data_at: 0,
            data_len: 0,
            mem_bytes: 0,
            nobits: true,
            writable: false,
            executable: false
        },
    }
}

fn append_name(inout t: ChunkSeq[u8], in s: Slice[u8]) -> u32 {
    let at = wrapping_u32(t.len());
    t.extend(in s);
    t.push(0);
    at
}

fn place(inout out: ChunkSeq[u8], in data: ChunkSeq[u8], align: u64) -> u64 {
    let len = out.len();
    if align <= 1 {
        out.extend(in data.as_slice());
        return len;
    }
    let at = if len % align == 0 {
        len
    } else {
        wrapping_mul(add(len / align, 1), align)
    };
    out.resize(at, 0);
    out.extend(in data.as_slice());
    at
}

// `elf::write_executable`. Returns the bytes; `placements` gets one row per
// segment.
pub fn write_executable(
    machine: u16,
    e_flags: u32,
    entry: u64,
    in secs: ChunkSeq[OutSec],
    in data: ChunkSeq[u8],
    in segs: ChunkSeq[OutSeg],
    in names: ChunkSeq[u8],
    in syms: ChunkSeq[OutSym],
    inout placements: ChunkSeq[Placement]
) -> ChunkSeq[u8] {
    let phnum = segs.len();
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    out.resize(add(Ehdr::Bytes, wrapping_mul(phnum, Phdr::Bytes)), 0);
    let mut file_offsets: ChunkSeq[u64] = ChunkSeq::new[u64]();
    file_offsets.resize(secs.len(), 0);
    for k in 0..phnum {
        let seg = match segs.try_get(k) {
            Option::Some(v) => v,
            Option::None => OutSeg {
                first: 0,
                end: 0,
                flags: 0
            },
        };
        let first = s_at(in secs, seg.first);
        let mut off = out.len();
        let want = first.address % Page::Bytes;
        if off % Page::Bytes != want {
            off = add(off, (add(want, sub(Page::Bytes, off % Page::Bytes))) % Page::Bytes);
        }
        out.resize(off, 0);
        let seg_base = first.address;
        let mut file_end = off;
        let mut mem_end = seg_base;
        for i in seg.first..seg.end {
            let s = s_at(in secs, i);
            let at = add(off, sub(s.address, seg_base));
            let ok = file_offsets.try_set(i, at);
            if !s.nobits {
                out.resize(at, 0);
                out.extend(in data[s.data_at..add(s.data_at, s.data_len)]);
                file_end = add(at, s.data_len);
            }
            mem_end = max64(mem_end, add(s.address, s.mem_bytes));
        }
        placements
            .push(
                Placement {
                    vaddr: seg_base,
                    offset: off,
                    file_bytes: sub(file_end, off),
                    mem_bytes: sub(mem_end, seg_base)
                }
            );
    }
    // String tables and symbols.
    let mut shstrtab: ChunkSeq[u8] = ChunkSeq::new[u8]();
    shstrtab.push(0);
    let mut sh_names: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..secs.len() {
        sh_names
            .push(append_name(inout shstrtab, in section_name(s_at(in secs, i).name).as_bytes()));
    }
    let symtab_name = append_name(inout shstrtab, in ".symtab".as_bytes());
    let strtab_name = append_name(inout shstrtab, in ".strtab".as_bytes());
    let shstrtab_name = append_name(inout shstrtab, in ".shstrtab".as_bytes());
    let mut strtab: ChunkSeq[u8] = ChunkSeq::new[u8]();
    strtab.push(0);
    let mut symtab: ChunkSeq[u8] = ChunkSeq::new[u8]();
    symtab.resize(SymEnt::Bytes, 0);
    let mut locals: u64 = 0;
    for pass in 0..2 {
        for i in 0..syms.len() {
            let s = match syms.try_get(i) {
                Option::Some(v) => v,
                Option::None => OutSym {
                    name_at: 0,
                    name_len: 0,
                    value: 0,
                    size: 0,
                    global: false,
                    function: false,
                    section: Absent::Row
                },
            };
            if s.global == (pass == 1) {
                if !s.global {
                    locals = add(locals, 1);
                }
                let name = append_name(
                    inout strtab,
                    in names[s.name_at..add(s.name_at, s.name_len)]
                );
                push32(inout symtab, name);
                let bind: u8 = if s.global {
                    Stb::Global
                } else {
                    Stb::Local
                };
                let kind: u8 = if s.function {
                    Stt::Func
                } else {
                    Stt::Notype
                };
                symtab.push((bind << Stb::Shift) | kind);
                symtab.push(0);
                let shndx: u16 = if s.section == Absent::Row {
                    Shn::Abs
                } else {
                    wrapping_u16(add(s.section, 1))
                };
                push16(inout symtab, shndx);
                push64(inout symtab, s.value);
                push64(inout symtab, s.size);
            }
        }
    }
    let first_global = add(1, locals);
    let symtab_off = place(inout out, in symtab, 8);
    let strtab_off = place(inout out, in strtab, 1);
    let shstrtab_off = place(inout out, in shstrtab, 1);
    let len = out.len();
    let shoff = if len % 8 == 0 {
        len
    } else {
        wrapping_mul(add(len / 8, 1), 8)
    };
    out.resize(shoff, 0);
    let shnum = add(secs.len(), 4);
    let z = grow(inout out, Shdr::Bytes);
    for i in 0..secs.len() {
        let s = s_at(in secs, i);
        let mut flags = Shf::Alloc;
        if s.writable {
            flags = flags | Shf::Write;
        }
        if s.executable {
            flags = flags | Shf::Execinstr;
        }
        let kind = if s.nobits {
            Sht::Nobits
        } else {
            Sht::Progbits
        };
        let name = match sh_names.try_get(i) {
            Option::Some(v) => widen_u64(v),
            Option::None => 0,
        };
        let off = match file_offsets.try_get(i) {
            Option::Some(v) => v,
            Option::None => 0,
        };
        header_at(inout out, name, kind, flags, s.address, off, s.mem_bytes, 0, 0, 8, 0);
    }
    let strtab_index = add(secs.len(), 2);
    header_at(
        inout out,
        widen_u64(symtab_name),
        Sht::Symtab,
        0,
        0,
        symtab_off,
        symtab.len(),
        strtab_index,
        first_global,
        8,
        SymEnt::Bytes
    );
    header_at(
        inout out,
        widen_u64(strtab_name),
        Sht::Strtab,
        0,
        0,
        strtab_off,
        strtab.len(),
        0,
        0,
        1,
        0
    );
    header_at(
        inout out,
        widen_u64(shstrtab_name),
        Sht::Strtab,
        0,
        0,
        shstrtab_off,
        shstrtab.len(),
        0,
        0,
        1,
        0
    );
    // ELF header.
    let mut h: ChunkSeq[u8] = ChunkSeq::new[u8]();
    h.push(Ident::Mag0);
    h.push(Ident::Mag1);
    h.push(Ident::Mag2);
    h.push(Ident::Mag3);
    h.push(Ident::Class64);
    h.push(Ident::Data2Lsb);
    h.push(Ident::Current);
    h.push(0);
    let pad = grow(inout h, 8);
    push16(inout h, Et::Exec);
    push16(inout h, machine);
    push32(inout h, Ident::Current);
    push64(inout h, entry);
    push64(inout h, Ehdr::Bytes);
    push64(inout h, shoff);
    push32(inout h, e_flags);
    push16(inout h, Ehdr::Bytes);
    push16(inout h, Phdr::Bytes);
    push16(inout h, wrapping_u16(phnum));
    push16(inout h, Shdr::Bytes);
    push16(inout h, wrapping_u16(shnum));
    push16(inout h, wrapping_u16(sub(shnum, 1)));
    let ok = out.try_copy_from(0, in h.as_slice());
    for k in 0..phnum {
        let seg = match segs.try_get(k) {
            Option::Some(v) => v,
            Option::None => OutSeg {
                first: 0,
                end: 0,
                flags: 0
            },
        };
        let p = match placements.try_get(k) {
            Option::Some(v) => v,
            Option::None => Placement {
                vaddr: 0,
                offset: 0,
                file_bytes: 0,
                mem_bytes: 0
            },
        };
        let mut ph: ChunkSeq[u8] = ChunkSeq::new[u8]();
        push32(inout ph, Pt::Load);
        push32(inout ph, seg.flags);
        push64(inout ph, p.offset);
        push64(inout ph, p.vaddr);
        push64(inout ph, p.vaddr);
        push64(inout ph, p.file_bytes);
        push64(inout ph, p.mem_bytes);
        push64(inout ph, Page::Bytes);
        let ok2 = out
            .try_copy_from(add(Ehdr::Bytes, wrapping_mul(k, Phdr::Bytes)), in ph.as_slice());
    }
    out
}

// A section header with an address (`elf::write_executable`'s
// `section_header`).
fn header_at(
    inout out: ChunkSeq[u8],
    name: u64,
    kind: u64,
    flags: u64,
    addr: u64,
    off: u64,
    size: u64,
    link: u64,
    info: u64,
    align: u64,
    entsize: u64
) {
    push32(inout out, wrapping_u32(name));
    push32(inout out, wrapping_u32(kind));
    push64(inout out, flags);
    push64(inout out, addr);
    push64(inout out, off);
    push64(inout out, size);
    push32(inout out, wrapping_u32(link));
    push32(inout out, wrapping_u32(info));
    push64(inout out, align);
    push64(inout out, entsize);
}

// ----- read_executable -----------------------------------------------------------

fn trunc(inout err: ChunkSeq[u8], at: u64) {
    err.clear();
    err.extend(in "truncated ELF at ".as_bytes());
    push_dec_into(inout err, at);
}

fn push_dec_into(inout out: ChunkSeq[u8], x: u64) {
    if x >= 10 {
        push_dec_into(inout out, x / 10);
    }
    out.push(wrapping_u8(add(x % 10, 48)));
}

fn set_err(inout err: ChunkSeq[u8], in msg: Str) {
    err.clear();
    err.extend(in msg.as_bytes());
}

fn r16(in b: Slice[u8], at: u64, inout err: ChunkSeq[u8]) -> u64 {
    match rd16(in b, at) {
        Option::Some(v) => widen_u64(v),
        Option::None => {
            if err.len() == 0 {
                trunc(inout err, at);
            }
            0
        }
    }
}

fn r32(in b: Slice[u8], at: u64, inout err: ChunkSeq[u8]) -> u64 {
    match rd32(in b, at) {
        Option::Some(v) => widen_u64(v),
        Option::None => {
            if err.len() == 0 {
                trunc(inout err, at);
            }
            0
        }
    }
}

fn r64(in b: Slice[u8], at: u64, inout err: ChunkSeq[u8]) -> u64 {
    match rd64(in b, at) {
        Option::Some(v) => v,
        Option::None => {
            if err.len() == 0 {
                trunc(inout err, at);
            }
            0
        }
    }
}

// `elf::read_executable` as result words: on success 0, entry, machine,
// e_type, the `PT_LOAD` count and per segment (vaddr, offset, file bytes,
// memory bytes, flags), then the symbol count and per symbol (name, value);
// on failure 1 and the message.
pub fn read_executable(in b: Slice[u8]) -> ChunkSeq[u8] {
    let mut err: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    read_into(in b, inout out, inout err);
    if err.len() != 0 {
        let mut e: ChunkSeq[u8] = ChunkSeq::new[u8]();
        push64(inout e, 1);
        put_str(inout e, in err.as_slice());
        return e;
    }
    let mut r: ChunkSeq[u8] = ChunkSeq::new[u8]();
    push64(inout r, 0);
    r.extend(in out.as_slice());
    r
}

fn read_into(in b: Slice[u8], inout out: ChunkSeq[u8], inout err: ChunkSeq[u8]) {
    if b.len() < Ehdr::Bytes
        || rd8(in b, 0) != Ident::Mag0
        || rd8(in b, 1) != Ident::Mag1
        || rd8(in b, 2) != Ident::Mag2
        || rd8(in b, 3) != Ident::Mag3 {
        set_err(inout err, in "not an ELF file");
        return;
    }
    if rd8(in b, Ehdr::Class) != Ident::Class64 || rd8(in b, Ehdr::Data) != Ident::Data2Lsb {
        set_err(inout err, in "not a little-endian ELF64 file");
        return;
    }
    let e_type = r16(in b, Ehdr::Kind, inout err);
    let machine = r16(in b, Ehdr::Machine, inout err);
    let entry = r64(in b, Ehdr::Entry, inout err);
    let phoff = r64(in b, Ehdr::Phoff, inout err);
    let shoff = r64(in b, Ehdr::Shoff, inout err);
    let phentsize = r16(in b, Ehdr::Phentsize, inout err);
    let phnum = r16(in b, Ehdr::Phnum, inout err);
    let shentsize = r16(in b, Ehdr::Shentsize, inout err);
    let shnum = r16(in b, Ehdr::Shnum, inout err);
    if err.len() != 0 {
        return;
    }
    if phnum > 0 && phentsize < Phdr::Bytes {
        set_err(inout err, in "bad program header size");
        return;
    }
    let mut segs: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut nseg: u64 = 0;
    for i in 0..phnum {
        let p = add(phoff, wrapping_mul(i, phentsize));
        if p < phoff {
            set_err(inout err, in "overflow");
            return;
        }
        if r32(in b, p, inout err) == widen_u64(Pt::Load) {
            let flags = r32(in b, add(p, Phdr::Flags), inout err);
            let offset = r64(in b, add(p, Phdr::Offset), inout err);
            let vaddr = r64(in b, add(p, Phdr::Vaddr), inout err);
            let filesz = r64(in b, add(p, Phdr::Filesz), inout err);
            let memsz = r64(in b, add(p, Phdr::Memsz), inout err);
            push64(inout segs, vaddr);
            push64(inout segs, offset);
            push64(inout segs, filesz);
            push64(inout segs, memsz);
            push64(inout segs, flags);
            nseg = add(nseg, 1);
        }
        if err.len() != 0 {
            return;
        }
    }
    if shnum > 0 && shentsize < Shdr::Bytes {
        set_err(inout err, in "bad section header size");
        return;
    }
    let mut syms: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut nsym: u64 = 0;
    for i in 0..shnum {
        let s = add(shoff, wrapping_mul(i, shentsize));
        let kind = r32(in b, add(s, Shdr::Kind), inout err);
        let offset = r64(in b, add(s, Shdr::Offset), inout err);
        let size = r64(in b, add(s, Shdr::Size), inout err);
        let link = r32(in b, add(s, Shdr::Link), inout err);
        let entsize = r64(in b, add(s, Shdr::Entsize), inout err);
        if err.len() != 0 {
            return;
        }
        if kind == Sht::Symtab {
            if entsize < SymEnt::Bytes {
                set_err(inout err, in "bad symbol size");
                return;
            }
            let t = add(shoff, wrapping_mul(link, shentsize));
            let str_off = r64(in b, add(t, Shdr::Offset), inout err);
            let str_size = r64(in b, add(t, Shdr::Size), inout err);
            if err.len() != 0 {
                return;
            }
            let str_end = add(str_off, str_size);
            if str_end < str_off || str_off > str_end || str_end > b.len() {
                set_err(inout err, in "truncated string table");
                return;
            }
            let count = size / entsize;
            for k in 0..count {
                let at = add(offset, wrapping_mul(k, entsize));
                let name_off = r32(in b, at, inout err);
                let value = r64(in b, add(at, SymEnt::Value), inout err);
                if err.len() != 0 {
                    return;
                }
                if name_off > sub(str_end, str_off) {
                    set_err(inout err, in "bad symbol name");
                    return;
                }
                let start = add(str_off, name_off);
                let mut end = start;
                loop {
                    if end >= str_end || rd8(in b, end) == 0 {
                        break;
                    }
                    end = add(end, 1);
                }
                if end > start {
                    put_str(inout syms, in b[start..end]);
                    push64(inout syms, value);
                    nsym = add(nsym, 1);
                }
            }
        }
    }
    push64(inout out, entry);
    push64(inout out, machine);
    push64(inout out, e_type);
    push64(inout out, nseg);
    out.extend(in segs.as_slice());
    push64(inout out, nsym);
    out.extend(in syms.as_slice());
}
