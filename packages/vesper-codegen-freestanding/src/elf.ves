// Little-endian ELF64 executables (src/freestanding/elf.rs):
// `write_executable` and `read_executable`.

use self::codes::{
    Absent, Ehdr, Et, Ident, Out, Page, Pf, Phdr, Pt, Shdr, Shf, Shn, Sht, Stb, Stt, SymEnt
};
use self::util::{add, sub, max64, grow, push16, push32, push64, put_str, rd8, rd16, rd32, rd64};
use self::obj::{section_header};

pub fn pf_rx() -> u32 {
    Pf::R | Pf::X
}

pub fn pf_rw() -> u32 {
    Pf::R | Pf::W
}

// Output section names (link.rs `OUT_NAMES` and `.stack`).
pub fn section_name(out_index: u64) -> Str {
    if out_index == Out::Text {
        ".text"
    } else if out_index == Out::Rodata {
        ".rodata"
    } else if out_index == Out::Data {
        ".data"
    } else if out_index == Out::Bss {
        ".bss"
    } else {
        ".stack"
    }
}

// One output section (`OutSection`): its data is `data[data_at..data_at +
// data_len]` (nothing when `nobits`).
pub copy struct OutSec {
    name: u64,
    address: u64,
    data_at: u64,
    data_len: u64,
    mem_bytes: u64,
    nobits: bool,
    writable: bool,
    executable: bool,
}

// One `PT_LOAD` over sections `first..end` (`OutSegment`).
pub copy struct OutSeg {
    first: u64,
    end: u64,
    flags: u32,
}

// A `.symtab` symbol (`OutSymbol`); its name is `names[name_at..name_at +
// name_len]`; `section` is an index into the section list or Absent::Row for an
// absolute symbol.
pub copy struct OutSym {
    name_at: u64,
    name_len: u64,
    value: u64,
    size: u64,
    global: bool,
    function: bool,
    section: u64,
}

// `(vaddr, file offset, file bytes, memory bytes)` of a written segment.
pub copy struct Placement {
    vaddr: u64,
    offset: u64,
    file_bytes: u64,
    mem_bytes: u64,
}

fn s_at(in secs: ChunkSeq[OutSec], i: u64) -> OutSec {
    match secs.try_get(i) {
        Option::Some(s) => s,
        Option::None => OutSec {
            name: 0,
            address: 0,
            data_at: 0,
            data_len: 0,
            mem_bytes: 0,
            nobits: true,
            writable: false,
            executable: false
        },
    }
}

fn append_name(inout table: ChunkSeq[u8], in name: Slice[u8]) -> u32 {
    let at = wrapping_u32(table.len());
    table.extend(in name);
    table.push(0);
    at
}

fn place(inout out: ChunkSeq[u8], in data: ChunkSeq[u8], align: u64) -> u64 {
    let len = out.len();
    if align <= 1 {
        out.extend(in data.as_slice());
        return len;
    }
    let at = if len % align == 0 {
        len
    } else {
        wrapping_mul(add(len / align, 1), align)
    };
    out.resize(at, 0);
    out.extend(in data.as_slice());
    at
}

// `elf::write_executable`. Returns the bytes; `placements` gets one row per
// segment.
pub fn write_executable(
    machine: u16,
    e_flags: u32,
    entry: u64,
    in secs: ChunkSeq[OutSec],
    in data: ChunkSeq[u8],
    in segs: ChunkSeq[OutSeg],
    in names: ChunkSeq[u8],
    in syms: ChunkSeq[OutSym],
    inout placements: ChunkSeq[Placement]
) -> ChunkSeq[u8] {
    let phnum = segs.len();
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    out.resize(add(Ehdr::Bytes, wrapping_mul(phnum, Phdr::Bytes)), 0);
    let mut file_offsets: ChunkSeq[u64] = ChunkSeq::new[u64]();
    file_offsets.resize(secs.len(), 0);
    for k in 0..phnum {
        let seg = match segs.try_get(k) {
            Option::Some(v) => v,
            Option::None => OutSeg { first: 0, end: 0, flags: 0 },
        };
        let first = s_at(in secs, seg.first);
        let mut off = out.len();
        let page_offset = first.address % Page::Bytes;
        if off % Page::Bytes != page_offset {
            off = add(off, (add(page_offset, sub(Page::Bytes, off % Page::Bytes))) % Page::Bytes);
        }
        out.resize(off, 0);
        let seg_base = first.address;
        let mut file_end = off;
        let mut mem_end = seg_base;
        for i in seg.first..seg.end {
            let out_sec = s_at(in secs, i);
            let at = add(off, sub(out_sec.address, seg_base));
            let ok = file_offsets.try_set(i, at);
            if !out_sec.nobits {
                out.resize(at, 0);
                out.extend(in data[out_sec.data_at..add(out_sec.data_at, out_sec.data_len)]);
                file_end = add(at, out_sec.data_len);
            }
            mem_end = max64(mem_end, add(out_sec.address, out_sec.mem_bytes));
        }
        placements.push(Placement {
            vaddr: seg_base,
            offset: off,
            file_bytes: sub(file_end, off),
            mem_bytes: sub(mem_end, seg_base)
        });
    }
    // String tables and symbols.
    let mut shstrtab: ChunkSeq[u8] = ChunkSeq::new[u8]();
    shstrtab.push(0);
    let mut sh_names: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..secs.len() {
        sh_names
            .push(append_name(inout shstrtab, in section_name(s_at(in secs, i).name).as_bytes()));
    }
    let symtab_name = append_name(inout shstrtab, in ".symtab".as_bytes());
    let strtab_name = append_name(inout shstrtab, in ".strtab".as_bytes());
    let shstrtab_name = append_name(inout shstrtab, in ".shstrtab".as_bytes());
    let mut strtab: ChunkSeq[u8] = ChunkSeq::new[u8]();
    strtab.push(0);
    let mut symtab: ChunkSeq[u8] = ChunkSeq::new[u8]();
    symtab.resize(SymEnt::Bytes, 0);
    let mut locals: u64 = 0;
    for pass in 0..2 {
        for i in 0..syms.len() {
            let symbol = match syms.try_get(i) {
                Option::Some(v) => v,
                Option::None => OutSym {
                    name_at: 0,
                    name_len: 0,
                    value: 0,
                    size: 0,
                    global: false,
                    function: false,
                    section: Absent::Row
                },
            };
            if symbol.global == (pass == 1) {
                if !symbol.global {
                    locals = add(locals, 1);
                }
                let name = append_name(
                    inout strtab,
                    in names[symbol.name_at..add(symbol.name_at, symbol.name_len)]
                );
                push32(inout symtab, name);
                let bind: u8 = if symbol.global {
                    Stb::Global
                } else {
                    Stb::Local
                };
                let kind: u8 = if symbol.function {
                    Stt::Func
                } else {
                    Stt::Notype
                };
                symtab.push((bind << Stb::Shift) | kind);
                symtab.push(0);
                let shndx: u16 = if symbol.section == Absent::Row {
                    Shn::Abs
                } else {
                    wrapping_u16(add(symbol.section, 1))
                };
                push16(inout symtab, shndx);
                push64(inout symtab, symbol.value);
                push64(inout symtab, symbol.size);
            }
        }
    }
    let first_global = add(1, locals);
    let symtab_off = place(inout out, in symtab, 8);
    let strtab_off = place(inout out, in strtab, 1);
    let shstrtab_off = place(inout out, in shstrtab, 1);
    let len = out.len();
    let shoff = if len % 8 == 0 {
        len
    } else {
        wrapping_mul(add(len / 8, 1), 8)
    };
    out.resize(shoff, 0);
    let shnum = add(secs.len(), 4);
    let null_header = grow(inout out, Shdr::Bytes);
    for i in 0..secs.len() {
        let out_sec = s_at(in secs, i);
        let mut flags = Shf::Alloc;
        if out_sec.writable {
            flags = flags | Shf::Write;
        }
        if out_sec.executable {
            flags = flags | Shf::Execinstr;
        }
        let kind = if out_sec.nobits {
            Sht::Nobits
        } else {
            Sht::Progbits
        };
        let name = match sh_names.try_get(i) {
            Option::Some(v) => widen_u64(v),
            Option::None => 0,
        };
        let off = file_offsets.try_get(i).unwrap_or(0);
        header_at(
            inout out,
            name,
            kind,
            flags,
            out_sec.address,
            off,
            out_sec.mem_bytes,
            0,
            0,
            8,
            0
        );
    }
    let strtab_index = add(secs.len(), 2);
    header_at(
        inout out,
        widen_u64(symtab_name),
        Sht::Symtab,
        0,
        0,
        symtab_off,
        symtab.len(),
        strtab_index,
        first_global,
        8,
        SymEnt::Bytes
    );
    header_at(
        inout out,
        widen_u64(strtab_name),
        Sht::Strtab,
        0,
        0,
        strtab_off,
        strtab.len(),
        0,
        0,
        1,
        0
    );
    header_at(
        inout out,
        widen_u64(shstrtab_name),
        Sht::Strtab,
        0,
        0,
        shstrtab_off,
        shstrtab.len(),
        0,
        0,
        1,
        0
    );
    // ELF header.
    let mut header: ChunkSeq[u8] = ChunkSeq::new[u8]();
    header.push(Ident::Mag0);
    header.push(Ident::Mag1);
    header.push(Ident::Mag2);
    header.push(Ident::Mag3);
    header.push(Ident::Class64);
    header.push(Ident::Data2Lsb);
    header.push(Ident::Current);
    header.push(0);
    let pad = grow(inout header, 8);
    push16(inout header, Et::Exec);
    push16(inout header, machine);
    push32(inout header, Ident::Current);
    push64(inout header, entry);
    push64(inout header, Ehdr::Bytes);
    push64(inout header, shoff);
    push32(inout header, e_flags);
    push16(inout header, Ehdr::Bytes);
    push16(inout header, Phdr::Bytes);
    push16(inout header, wrapping_u16(phnum));
    push16(inout header, Shdr::Bytes);
    push16(inout header, wrapping_u16(shnum));
    push16(inout header, wrapping_u16(sub(shnum, 1)));
    let ok = out.try_copy_from(0, in header.as_slice());
    for k in 0..phnum {
        let seg = match segs.try_get(k) {
            Option::Some(v) => v,
            Option::None => OutSeg { first: 0, end: 0, flags: 0 },
        };
        let placement = match placements.try_get(k) {
            Option::Some(v) => v,
            Option::None => Placement { vaddr: 0, offset: 0, file_bytes: 0, mem_bytes: 0 },
        };
        let mut phdr: ChunkSeq[u8] = ChunkSeq::new[u8]();
        push32(inout phdr, Pt::Load);
        push32(inout phdr, seg.flags);
        push64(inout phdr, placement.offset);
        push64(inout phdr, placement.vaddr);
        push64(inout phdr, placement.vaddr);
        push64(inout phdr, placement.file_bytes);
        push64(inout phdr, placement.mem_bytes);
        push64(inout phdr, Page::Bytes);
        let ok2 = out.try_copy_from(
            add(Ehdr::Bytes, wrapping_mul(k, Phdr::Bytes)),
            in phdr.as_slice()
        );
    }
    out
}

// A section header with an address (`elf::write_executable`'s
// `section_header`).
fn header_at(
    inout out: ChunkSeq[u8],
    name: u64,
    kind: u64,
    flags: u64,
    addr: u64,
    offset: u64,
    size: u64,
    link: u64,
    info: u64,
    align: u64,
    entsize: u64
) {
    push32(inout out, wrapping_u32(name));
    push32(inout out, wrapping_u32(kind));
    push64(inout out, flags);
    push64(inout out, addr);
    push64(inout out, offset);
    push64(inout out, size);
    push32(inout out, wrapping_u32(link));
    push32(inout out, wrapping_u32(info));
    push64(inout out, align);
    push64(inout out, entsize);
}

// ----- read_executable -----------------------------------------------------------

fn trunc(inout err: ChunkSeq[u8], at: u64) {
    err.clear();
    err.extend(in "truncated ELF at ".as_bytes());
    push_dec_into(inout err, at);
}

fn push_dec_into(inout out: ChunkSeq[u8], value: u64) {
    if value >= 10 {
        push_dec_into(inout out, value / 10);
    }
    out.push(wrapping_u8(add(value % 10, 48)));
}

fn set_err(inout err: ChunkSeq[u8], in msg: Str) {
    err.clear();
    err.extend(in msg.as_bytes());
}

fn r16(in elf: Slice[u8], at: u64, inout err: ChunkSeq[u8]) -> u64 {
    match rd16(in elf, at) {
        Option::Some(v) => widen_u64(v),
        Option::None => {
            if err.len() == 0 {
                trunc(inout err, at);
            }
            0
        }
    }
}

fn r32(in elf: Slice[u8], at: u64, inout err: ChunkSeq[u8]) -> u64 {
    match rd32(in elf, at) {
        Option::Some(v) => widen_u64(v),
        Option::None => {
            if err.len() == 0 {
                trunc(inout err, at);
            }
            0
        }
    }
}

fn r64(in elf: Slice[u8], at: u64, inout err: ChunkSeq[u8]) -> u64 {
    match rd64(in elf, at) {
        Option::Some(v) => v,
        Option::None => {
            if err.len() == 0 {
                trunc(inout err, at);
            }
            0
        }
    }
}

// `elf::read_executable` as result words: on success 0, entry, machine,
// e_type, the `PT_LOAD` count and per segment (vaddr, offset, file bytes,
// memory bytes, flags), then the symbol count and per symbol (name, value);
// on failure 1 and the message.
pub fn read_executable(in elf: Slice[u8]) -> ChunkSeq[u8] {
    let mut err: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    read_into(in elf, inout out, inout err);
    if err.len() != 0 {
        let mut failure: ChunkSeq[u8] = ChunkSeq::new[u8]();
        push64(inout failure, 1);
        put_str(inout failure, in err.as_slice());
        return failure;
    }
    let mut result: ChunkSeq[u8] = ChunkSeq::new[u8]();
    push64(inout result, 0);
    result.extend(in out.as_slice());
    result
}

fn read_into(in elf: Slice[u8], inout out: ChunkSeq[u8], inout err: ChunkSeq[u8]) {
    if elf.len() < Ehdr::Bytes
        || rd8(in elf, 0) != Ident::Mag0
        || rd8(in elf, 1) != Ident::Mag1
        || rd8(in elf, 2) != Ident::Mag2
        || rd8(in elf, 3) != Ident::Mag3 {
        set_err(inout err, in "not an ELF file");
        return;
    }
    if rd8(in elf, Ehdr::Class) != Ident::Class64 || rd8(in elf, Ehdr::Data) != Ident::Data2Lsb {
        set_err(inout err, in "not a little-endian ELF64 file");
        return;
    }
    let e_type = r16(in elf, Ehdr::Kind, inout err);
    let machine = r16(in elf, Ehdr::Machine, inout err);
    let entry = r64(in elf, Ehdr::Entry, inout err);
    let phoff = r64(in elf, Ehdr::Phoff, inout err);
    let shoff = r64(in elf, Ehdr::Shoff, inout err);
    let phentsize = r16(in elf, Ehdr::Phentsize, inout err);
    let phnum = r16(in elf, Ehdr::Phnum, inout err);
    let shentsize = r16(in elf, Ehdr::Shentsize, inout err);
    let shnum = r16(in elf, Ehdr::Shnum, inout err);
    if err.len() != 0 {
        return;
    }
    if phnum > 0 && phentsize < Phdr::Bytes {
        set_err(inout err, in "bad program header size");
        return;
    }
    let mut segs: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut seg_count: u64 = 0;
    for i in 0..phnum {
        let phdr_at = add(phoff, wrapping_mul(i, phentsize));
        if phdr_at < phoff {
            set_err(inout err, in "overflow");
            return;
        }
        if r32(in elf, phdr_at, inout err) == widen_u64(Pt::Load) {
            let flags = r32(in elf, add(phdr_at, Phdr::Flags), inout err);
            let offset = r64(in elf, add(phdr_at, Phdr::Offset), inout err);
            let vaddr = r64(in elf, add(phdr_at, Phdr::Vaddr), inout err);
            let filesz = r64(in elf, add(phdr_at, Phdr::Filesz), inout err);
            let memsz = r64(in elf, add(phdr_at, Phdr::Memsz), inout err);
            push64(inout segs, vaddr);
            push64(inout segs, offset);
            push64(inout segs, filesz);
            push64(inout segs, memsz);
            push64(inout segs, flags);
            seg_count = add(seg_count, 1);
        }
        if err.len() != 0 {
            return;
        }
    }
    if shnum > 0 && shentsize < Shdr::Bytes {
        set_err(inout err, in "bad section header size");
        return;
    }
    let mut syms: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut sym_count: u64 = 0;
    for i in 0..shnum {
        let shdr_at = add(shoff, wrapping_mul(i, shentsize));
        let kind = r32(in elf, add(shdr_at, Shdr::Kind), inout err);
        let offset = r64(in elf, add(shdr_at, Shdr::Offset), inout err);
        let size = r64(in elf, add(shdr_at, Shdr::Size), inout err);
        let link = r32(in elf, add(shdr_at, Shdr::Link), inout err);
        let entsize = r64(in elf, add(shdr_at, Shdr::Entsize), inout err);
        if err.len() != 0 {
            return;
        }
        if kind == Sht::Symtab {
            if entsize < SymEnt::Bytes {
                set_err(inout err, in "bad symbol size");
                return;
            }
            let link_hdr = add(shoff, wrapping_mul(link, shentsize));
            let str_off = r64(in elf, add(link_hdr, Shdr::Offset), inout err);
            let str_size = r64(in elf, add(link_hdr, Shdr::Size), inout err);
            if err.len() != 0 {
                return;
            }
            let str_end = add(str_off, str_size);
            if str_end < str_off || str_off > str_end || str_end > elf.len() {
                set_err(inout err, in "truncated string table");
                return;
            }
            let count = size / entsize;
            for k in 0..count {
                let at = add(offset, wrapping_mul(k, entsize));
                let name_off = r32(in elf, at, inout err);
                let value = r64(in elf, add(at, SymEnt::Value), inout err);
                if err.len() != 0 {
                    return;
                }
                if name_off > sub(str_end, str_off) {
                    set_err(inout err, in "bad symbol name");
                    return;
                }
                let start = add(str_off, name_off);
                let mut end = start;
                loop {
                    if end >= str_end || rd8(in elf, end) == 0 {
                        break;
                    }
                    end = add(end, 1);
                }
                if end > start {
                    put_str(inout syms, in elf[start..end]);
                    push64(inout syms, value);
                    sym_count = add(sym_count, 1);
                }
            }
        }
    }
    push64(inout out, entry);
    push64(inout out, machine);
    push64(inout out, e_type);
    push64(inout out, seg_count);
    out.extend(in segs.as_slice());
    push64(inout out, sym_count);
    out.extend(in syms.as_slice());
}
