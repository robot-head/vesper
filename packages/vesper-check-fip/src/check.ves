// The fip checks of src/fip.rs (`check_world` and what it calls:
// `caller_slot_functions`, `unsafe_non_fip_functions`, `FipChecker`, the
// `Box` predicates, `slots_match` and `slot_size_label`), transliterated
// function by function over the census data design: types are hash-consed
// ids, names are symbols, the AST is flat tables (ast.ves) and the path
// state is rows (state.ves).
//
// Each diagnostic is one line of `out`: code, span start, span end and the
// message, separated by single spaces. The fip checks attach no help or
// related labels.

use @vesper/check-data::util::{add, inc, inc32, n32, push_decimal, u32_at, u8_at, w};
use @vesper/check-data::names::{Names};
use @vesper/check-data::types::{
    Types, Vars, default_type, display, substitute, vars_new, TyKind, TyPass
};
use @vesper/check-data::world::{World, constructor, field_step};
use @vesper/check-data::input::{Ctx};
use self::ast::{Ast, ExprRow, FnRow, PatRow};
use self::layout::{Sizes, layout_size, sizes_new};
use self::state::{
    BindRow, Binds, FipState, Paths, SlotRow, copy_binds, copy_state, paths_new, state_new
};

const NONE32: u32 = 4294967295;
const NONE64: u64 = 18446744073709551615;
// `layout::NO_SIZE` (constants cannot be imported yet).
const NO_SIZE: u64 = 18446744073709551615;

const E_LITERAL: u8 = 1;
const E_NAME: u8 = 2;
const E_TUPLE: u8 = 3;
const E_STRUCT: u8 = 4;
const E_BLOCK: u8 = 5;
const E_CALL: u8 = 6;
const E_FIELD: u8 = 7;
const E_INDEX: u8 = 8;
const E_TRY: u8 = 9;
const E_UNARY: u8 = 10;
const E_BINARY: u8 = 11;
const E_ASSIGN: u8 = 12;
const E_IF: u8 = 13;
const E_MATCH: u8 = 14;
const E_CLOSURE: u8 = 15;
const E_HANDLE: u8 = 16;
const E_LOOP: u8 = 17;
const E_CONTINUE: u8 = 22;

const PT_WILD: u8 = 1;
const PT_BIND: u8 = 2;
const PT_TUPLE: u8 = 4;
const PT_CTOR: u8 = 5;

// Symbols the checks compare against, interned once.
pub copy struct Syms {
    box_: u32,
    box_box: u32,
    box_new: u32,
    box_new_in_caller: u32,
    alloc: u32,
    zero: u32,
    never: u32,
    string: u32,
    str_: u32,
    chunk_seq: u32,
    seq_new: u32,
    seq_with_capacity: u32,
    push: u32,
    extend: u32,
    extend_from_slice: u32,
    extend_ascii_lowercase: u32,
    resize: u32,
    extend_from_within: u32,
    try_extend_from_within: u32,
    extend_reversed: u32,
    push_str: u32,
    push_char: u32,
    reserve: u32,
}

fn syms_new(inout names: Names) -> Syms {
    Syms {
        box_: names.intern(in "Box".as_bytes()),
        box_box: names.intern(in "Box::Box".as_bytes()),
        box_new: names.intern(in "Box::new".as_bytes()),
        box_new_in_caller: names.intern(in "Box::new_in_caller".as_bytes()),
        alloc: names.intern(in "Alloc".as_bytes()),
        zero: names.intern(in "0".as_bytes()),
        never: names.intern(in "Never".as_bytes()),
        string: names.intern(in "String".as_bytes()),
        str_: names.intern(in "Str".as_bytes()),
        chunk_seq: names.intern(in "ChunkSeq".as_bytes()),
        seq_new: names.intern(in "ChunkSeq::new".as_bytes()),
        seq_with_capacity: names.intern(in "ChunkSeq::with_capacity".as_bytes()),
        push: names.intern(in "push".as_bytes()),
        extend: names.intern(in "extend".as_bytes()),
        extend_from_slice: names.intern(in "extend_from_slice".as_bytes()),
        extend_ascii_lowercase: names.intern(in "extend_ascii_lowercase".as_bytes()),
        resize: names.intern(in "resize".as_bytes()),
        extend_from_within: names.intern(in "extend_from_within".as_bytes()),
        try_extend_from_within: names.intern(in "try_extend_from_within".as_bytes()),
        extend_reversed: names.intern(in "extend_reversed".as_bytes()),
        push_str: names.intern(in "push_str".as_bytes()),
        push_char: names.intern(in "push_char".as_bytes()),
        reserve: names.intern(in "reserve".as_bytes()),
    }
}

pub struct Fip {
    ctx: Ctx,
    ast: Ast,
    syms: Syms,
    sizes: Sizes,
    paths: Paths,
    // per type id: 0 unknown, 1 no Box, 2 contains a Box
    box_memo: ChunkSeq[u8],
    // `type_contains_box`'s `seen` ADT names
    seen: ChunkSeq[u32],
    // tuple field names "0", "1", ...
    digits: ChunkSeq[u32],
    // per function: in `caller_slot_functions`, in `unsafe_non_fip`
    caller_slot: ChunkSeq[bool],
    unsafe_non_fip: ChunkSeq[bool],
    out: ChunkSeq[u8],
    count: u64,
}

pub fn fip_new(sink input_ctx: Ctx, sink ast: Ast) -> Fip {
    let mut ctx = input_ctx;
    let syms = syms_new(inout ctx.names);
    let fn_count = ast.fns.len();
    let mut caller_slot: ChunkSeq[bool] = ChunkSeq::with_capacity[bool](fn_count);
    caller_slot.resize(fn_count, false);
    let mut unsafe_non_fip: ChunkSeq[bool] = ChunkSeq::with_capacity[bool](fn_count);
    unsafe_non_fip.resize(fn_count, false);
    Fip {
        ctx: ctx,
        ast: ast,
        syms: syms,
        sizes: sizes_new(),
        paths: paths_new(),
        box_memo: ChunkSeq::new[u8](),
        seen: ChunkSeq::new[u32](),
        digits: ChunkSeq::new[u32](),
        caller_slot: caller_slot,
        unsafe_non_fip: unsafe_non_fip,
        out: ChunkSeq::new[u8](),
        count: 0
    }
}

fn put(inout out: ChunkSeq[u8], in text: Str) {
    out.extend(in text.as_bytes());
}

fn flag(in flags: ChunkSeq[bool], i: u32) -> bool {
    match flags.try_get(w(i)) {
        Option::Some(value) => value,
        Option::None => false,
    }
}

impl Fip {
    // ----- diagnostics -------------------------------------------------------

    // Starts a diagnostic line; the caller writes the message and `end_diag`.
    fn diag(inout self, in code: Str, start: u64, end: u64) {
        put(inout self.out, code);
        self.out.push(32);
        push_decimal(inout self.out, start);
        self.out.push(32);
        push_decimal(inout self.out, end);
        self.out.push(32);
    }

    fn end_diag(inout self) {
        self.out.push(10);
        self.count = inc(self.count);
    }

    fn simple(inout self, in code: Str, start: u64, end: u64, in message: Str) {
        self.diag(code, start, end);
        put(inout self.out, message);
        self.end_diag();
    }

    // `{prefix}'{name}'{suffix}`.
    fn named(
        inout self,
        in code: Str,
        start: u64,
        end: u64,
        in prefix: Str,
        name: u32,
        in suffix: Str
    ) {
        self.diag(code, start, end);
        put(inout self.out, prefix);
        self.out.push(39);
        self.ctx.names.write(name, inout self.out);
        self.out.push(39);
        put(inout self.out, suffix);
        self.end_diag();
    }

    // ----- names and types ---------------------------------------------------

    fn expr_type(in self, expr: ExprRow) -> u32 {
        let ty = self.ctx.world.expr_type(expr.start, expr.end);
        if ty == NONE32 {
            self.ctx.types.infer
        } else {
            ty
        }
    }

    // Whether the world has a type for the span (`world.types.get(..)`).
    fn has_type(in self, expr: ExprRow) -> bool {
        self.ctx.world.expr_type(expr.start, expr.end) != NONE32
    }

    fn type_name(in self, ty: u32) -> u32 {
        self.ctx.types.name(ty)
    }

    fn is_fn_type(in self, ty: u32) -> bool {
        self.ctx.types.kind(ty) == TyKind::Fn
    }

    fn is_never(in self, ty: u32) -> bool {
        let node = self.ctx.types.node(ty);
        node.kind == TyKind::Named && node.name == self.syms.never
    }

    // Whether `name` contains "::".
    fn has_path_sep(in self, name: u32) -> bool {
        let name_len = self.ctx.names.size(name);
        let mut i: u64 = 0;
        loop {
            if inc(i) >= name_len {
                break;
            }
            if self.ctx.names.byte(name, i) == 58 && self.ctx.names.byte(name, inc(i)) == 58 {
                return true;
            }
            i = inc(i);
        }
        false
    }

    // The symbol of the decimal name of `i` ("0", "1", ...).
    fn digit(inout self, i: u64) -> u32 {
        loop {
            if self.digits.len() > i {
                break;
            }
            let mut text: ChunkSeq[u8] = ChunkSeq::new[u8]();
            push_decimal(inout text, self.digits.len());
            let sym = self.ctx.names.intern(in text.as_slice());
            self.digits.push(sym);
        }
        u32_at(in self.digits, i)
    }

    // `format!("{}::{method}", ty.name())` as a symbol, or NONE32 when no
    // such name exists (so no function has it).
    fn method_name(in self, ty: u32, method: u32) -> u32 {
        let mut text: ChunkSeq[u8] = ChunkSeq::new[u8]();
        self.ctx.names.write(self.type_name(ty), inout text);
        text.push(58);
        text.push(58);
        self.ctx.names.write(method, inout text);
        self.ctx.names.lookup(in text.as_slice())
    }

    // `World::constructor(name)`: packed (adt, variant) or NONE64.
    fn ctor(in self, name: u32) -> u64 {
        let name_len = self.ctx.names.size(name);
        let mut sep_count: u64 = 0;
        let mut sep_at: u64 = 0;
        let mut i: u64 = 0;
        loop {
            if inc(i) >= name_len {
                break;
            }
            if self.ctx.names.byte(name, i) == 58 && self.ctx.names.byte(name, inc(i)) == 58 {
                sep_count = inc(sep_count);
                sep_at = i;
                i = add(i, 2);
            } else {
                i = inc(i);
            }
        }
        if sep_count == 0 {
            return constructor(in self.ctx.world, NONE32, name);
        }
        if sep_count > 1 {
            return NONE64;
        }
        let mut qualifier_text: ChunkSeq[u8] = ChunkSeq::new[u8]();
        let mut short_text: ChunkSeq[u8] = ChunkSeq::new[u8]();
        for j in 0..name_len {
            if j < sep_at {
                qualifier_text.push(self.ctx.names.byte(name, j));
            } else if j >= add(sep_at, 2) {
                short_text.push(self.ctx.names.byte(name, j));
            }
        }
        let qualifier = self.ctx.names.lookup(in qualifier_text.as_slice());
        let short_name = self.ctx.names.lookup(in short_text.as_slice());
        if qualifier == NONE32 || short_name == NONE32 {
            return NONE64;
        }
        constructor(in self.ctx.world, qualifier, short_name)
    }

    // Whether row type `row_ty` (`Type::Row(effects)`) has an instance named `name`.
    fn row_has(in self, row_ty: u32, name: u32) -> bool {
        let row = self.ctx.types.row(self.ctx.types.node(row_ty).r2);
        for i in 0..w(row.n) {
            if self.ctx.types.effect_at(add(w(row.a), i)).name == name {
                return true;
            }
        }
        false
    }

    fn fn_allocs(in self, func: FnRow) -> bool {
        self.row_has(func.effects, self.syms.alloc)
    }

    // ----- Box predicates ----------------------------------------------------

    // `is_box_type` (no `.vsys` handle plan is running in `check_world`).
    fn is_box(in self, ty: u32) -> bool {
        let node = self.ctx.types.node(ty);
        self.ctx.world.box_active
            && node.kind == TyKind::Named
            && node.name == self.syms.box_
            && node.n == 1
    }

    // `box_inner`, or NONE32.
    fn box_inner(in self, ty: u32) -> u32 {
        if self.is_box(ty) {
            self.ctx.types.arg(ty, 0)
        } else {
            NONE32
        }
    }

    fn is_box_pattern(in self, pat: PatRow) -> bool {
        if !self.ctx.world.box_active || pat.kind != PT_CTOR {
            return false;
        }
        if pat.a != self.syms.box_ && pat.a != self.syms.box_box {
            return false;
        }
        pat.c == 1 && self.ast.at(w(pat.b)) == self.syms.zero
    }

    fn pattern_has_box_pattern(in self, pat_id: u32) -> bool {
        let pat = self.ast.pat(pat_id);
        if self.is_box_pattern(pat) {
            return true;
        }
        if pat.kind == PT_TUPLE {
            for i in 0..w(pat.b) {
                if self.pattern_has_box_pattern(self.ast.at(add(w(pat.a), i))) {
                    return true;
                }
            }
        }
        if pat.kind == PT_CTOR {
            for i in 0..w(pat.c) {
                let field_pat = self.ast.at(add(add(w(pat.b), wrapping_mul(i, 2)), 1));
                if self.pattern_has_box_pattern(field_pat) {
                    return true;
                }
            }
        }
        false
    }

    // `type_contains_box`.
    fn contains_box(inout self, ty: u32) -> bool {
        let slot = w(ty);
        let cached = u8_at(in self.box_memo, slot);
        if cached != 0 {
            return cached == 2;
        }
        self.seen.clear();
        let found = self.box_visit(ty);
        if slot >= self.box_memo.len() {
            self.box_memo.resize(inc(slot), 0);
        }
        let ok = self.box_memo.try_set(slot, if found { 2 } else { 1 });
        found
    }

    fn box_visit(inout self, ty: u32) -> bool {
        if self.is_box(ty) {
            return true;
        }
        let node = self.ctx.types.node(ty);
        if node.kind == TyKind::Tuple {
            for i in 0..w(node.n) {
                if self.box_visit(self.ctx.types.arg(ty, i)) {
                    return true;
                }
            }
            return false;
        }
        if node.kind != TyKind::Named {
            return false;
        }
        for i in 0..w(node.n) {
            if self.box_visit(self.ctx.types.arg(ty, i)) {
                return true;
            }
        }
        let adt_index = self.ctx.world.lookup(node.name);
        if adt_index == NONE32 {
            return false;
        }
        for i in 0..self.seen.len() {
            if u32_at(in self.seen, i) == node.name {
                return false;
            }
        }
        self.seen.push(node.name);
        let adt = self.ctx.world.adt(adt_index);
        let vars = self.ctx.world.vars_of(in self.ctx.types, adt, ty);
        let mut found = false;
        for vi in 0..w(adt.vn) {
            let variant = self.ctx.world.variant(add(w(adt.va), vi));
            for fi in 0..w(variant.fc) {
                let field = self.ctx.world.field(add(w(variant.fa), fi));
                let field_ty = substitute(inout self.ctx.types, field.ty, in vars);
                if self.box_visit(field_ty) {
                    found = true;
                    break;
                }
            }
            if found {
                break;
            }
        }
        // `seen.remove(n)`: the name is the last one pushed.
        let last = wrapping_sub(self.seen.len(), 1);
        self.seen.truncate(last);
        found
    }

    // ----- slots ---------------------------------------------------------------

    fn is_generic(in self, func: FnRow, name: u32) -> bool {
        for i in 0..w(func.generic_count) {
            let generic = self.ast.generic(add(w(func.generic_start), i));
            if !generic.is_row && generic.name == name {
                return true;
            }
        }
        false
    }

    // `has_generic` of `slots_match` and `slot_key`.
    fn has_generic(in self, func: FnRow, ty: u32) -> bool {
        let node = self.ctx.types.node(ty);
        if node.kind == TyKind::Named {
            if self.is_generic(func, node.name) {
                return true;
            }
            for i in 0..w(node.n) {
                if self.has_generic(func, self.ctx.types.arg(ty, i)) {
                    return true;
                }
            }
            return false;
        }
        if node.kind == TyKind::Tuple {
            for i in 0..w(node.n) {
                if self.has_generic(func, self.ctx.types.arg(ty, i)) {
                    return true;
                }
            }
            return false;
        }
        if node.kind == TyKind::Fn {
            for i in 0..w(node.n) {
                if self.has_generic(func, self.ctx.types.arg(ty, i)) {
                    return true;
                }
            }
            return self.has_generic(func, node.r);
        }
        false
    }

    fn size_of(inout self, ty: u32) -> u64 {
        layout_size(
            inout self.sizes,
            inout self.ctx.types,
            in self.ctx.names,
            in self.ctx.world,
            ty
        )
    }

    // `slots_match(..).unwrap_or(false)`.
    fn slots_match(inout self, func: FnRow, a: u32, b: u32) -> bool {
        let a_norm = default_type(inout self.ctx.types, a);
        let b_norm = default_type(inout self.ctx.types, b);
        if !self.has_generic(func, a_norm) && !self.has_generic(func, b_norm) {
            let a_size = self.size_of(a_norm);
            if a_size == NO_SIZE {
                return false;
            }
            let b_size = self.size_of(b_norm);
            if b_size == NO_SIZE {
                return false;
            }
            a_size == b_size
        } else {
            a_norm == b_norm
        }
    }

    // Whether `slot_size_label` says "type ..." (else "size ...").
    fn label_is_type(inout self, func: FnRow, ty: u32) -> bool {
        let norm = default_type(inout self.ctx.types, ty);
        let node = self.ctx.types.node(norm);
        let mut mentions_generic = false;
        if node.kind == TyKind::Named {
            if self.is_generic(func, node.name) {
                mentions_generic = true;
            } else {
                for i in 0..w(node.n) {
                    if self.label_is_type(func, self.ctx.types.arg(norm, i)) {
                        mentions_generic = true;
                        break;
                    }
                }
            }
        }
        if mentions_generic {
            return true;
        }
        self.size_of(norm) == NO_SIZE
    }

    // `slot_size_label`, written to `out`.
    fn write_label(inout self, func: FnRow, ty: u32) {
        let norm = default_type(inout self.ctx.types, ty);
        if self.label_is_type(func, norm) {
            put(inout self.out, "type ");
            display(in self.ctx.types, in self.ctx.names, norm, inout self.out);
        } else {
            put(inout self.out, "size ");
            let size = self.size_of(norm);
            push_decimal(inout self.out, size);
        }
    }

    // ----- seq allocations ---------------------------------------------------

    // `seq::fip_allocation`: 0, or the operation (see `alloc_name`).
    fn fip_allocation(in self, callee: u32) -> u8 {
        let callee_expr = self.ast.expr(callee);
        if callee_expr.kind == E_NAME {
            if callee_expr.a == self.syms.seq_new {
                return 1;
            }
            if callee_expr.a == self.syms.seq_with_capacity {
                return 2;
            }
            return 0;
        }
        if callee_expr.kind != E_FIELD {
            return 0;
        }
        let base = self.ast.expr(callee_expr.a);
        if !self.has_type(base) {
            return 0;
        }
        let base_ty = self.expr_type(base);
        let node = self.ctx.types.node(base_ty);
        if node.kind != TyKind::Named {
            return 0;
        }
        let method = callee_expr.b;
        let syms = self.syms;
        if node.name == syms.string && node.n == 0 {
            if method == syms.push_str {
                return 10;
            }
            if method == syms.push_char {
                return 11;
            }
            if method == syms.reserve {
                return 12;
            }
            return 0;
        }
        if node.name == syms.str_ && node.n == 0 {
            return 0;
        }
        if node.name == syms.chunk_seq && node.n == 1 {
            if method == syms.push {
                return 3;
            }
            if method == syms.extend || method == syms.extend_from_slice {
                return 4;
            }
            if method == syms.extend_ascii_lowercase {
                return 5;
            }
            if method == syms.resize {
                return 6;
            }
            if method == syms.extend_from_within {
                return 7;
            }
            if method == syms.try_extend_from_within {
                return 8;
            }
            if method == syms.extend_reversed {
                return 9;
            }
        }
        0
    }

    fn alloc_name(inout self, op: u8) {
        match op {
            1 => put(inout self.out, "new"),
            2 => put(inout self.out, "with_capacity"),
            3 => put(inout self.out, "push"),
            4 => put(inout self.out, "extend"),
            5 => put(inout self.out, "extend_ascii_lowercase"),
            6 => put(inout self.out, "resize"),
            7 => put(inout self.out, "extend_from_within"),
            8 => put(inout self.out, "try_extend_from_within"),
            9 => put(inout self.out, "extend_reversed"),
            10 => put(inout self.out, "push_str"),
            11 => put(inout self.out, "push_char"),
            _ => put(inout self.out, "reserve"),
        }
    }

    // ----- visiting ------------------------------------------------------------

    // The children `regions::visit_expr` visits, in its order.
    fn children(in self, expr_id: u32, inout out: ChunkSeq[u32]) {
        let expr = self.ast.expr(expr_id);
        let kind = expr.kind;
        if kind == E_TUPLE || kind == E_STRUCT || kind >= E_LOOP {
            for i in 0..w(expr.b) {
                out.push(self.ast.at(add(w(expr.a), i)));
            }
        } else if kind == E_BLOCK {
            for i in 0..w(expr.b) {
                out.push(self.ast.at(add(add(w(expr.a), wrapping_mul(i, 3)), 2)));
            }
            if expr.c != 0 {
                out.push(wrapping_sub(expr.c, 1));
            }
        } else if kind == E_CALL {
            out.push(expr.a);
            for i in 0..w(expr.c) {
                out.push(self.ast.at(add(add(w(expr.b), wrapping_mul(i, 2)), 1)));
            }
        } else if kind == E_FIELD || kind == E_TRY || kind == E_UNARY || kind == E_CLOSURE {
            out.push(expr.a);
        } else if kind == E_INDEX || kind == E_BINARY || kind == E_ASSIGN {
            out.push(expr.a);
            out.push(expr.b);
        } else if kind == E_IF {
            out.push(expr.a);
            out.push(expr.b);
            if expr.c != 0 {
                out.push(wrapping_sub(expr.c, 1));
            }
        } else if kind == E_MATCH {
            out.push(expr.a);
            for i in 0..w(expr.c) {
                out.push(self.ast.at(add(add(w(expr.b), wrapping_mul(i, 2)), 1)));
            }
        } else if kind == E_HANDLE {
            if expr.b != 0 {
                out.push(expr.c);
            }
            out.push(expr.d);
            let mut at = w(expr.e);
            let clause_count = w(self.ast.at(at));
            at = inc(at);
            for i in 0..clause_count {
                out.push(self.ast.at(at));
                let pat_count = w(self.ast.at(inc(at)));
                at = add(at, add(pat_count, 2));
            }
        }
    }

    fn callee_is(in self, expr: ExprRow, name: u32) -> bool {
        if expr.kind != E_CALL {
            return false;
        }
        let callee = self.ast.expr(expr.a);
        callee.kind == E_NAME && callee.a == name
    }

    // `check_non_fip`: every `Box::new_in_caller` call, in visit order.
    fn check_non_fip(inout self, expr_id: u32) {
        let expr = self.ast.expr(expr_id);
        if self.callee_is(expr, self.syms.box_new_in_caller) {
            self.simple(
                "E0802",
                expr.start,
                expr.end,
                "Box::new_in_caller is only permitted inside @fip functions"
            );
        }
        let mut kids: ChunkSeq[u32] = ChunkSeq::new[u32]();
        self.children(expr_id, inout kids);
        for i in 0..kids.len() {
            self.check_non_fip(u32_at(in kids, i));
        }
    }

    fn mentions_new_in_caller(in self, expr_id: u32) -> bool {
        let expr = self.ast.expr(expr_id);
        if self.callee_is(expr, self.syms.box_new_in_caller) {
            return true;
        }
        let mut kids: ChunkSeq[u32] = ChunkSeq::new[u32]();
        self.children(expr_id, inout kids);
        for i in 0..kids.len() {
            if self.mentions_new_in_caller(u32_at(in kids, i)) {
                return true;
            }
        }
        false
    }

    // `tail_calls` of `caller_slot_functions`: whether a tail call names a
    // function already in the set.
    fn tail_calls_set(in self, expr_id: u32) -> bool {
        let expr = self.ast.expr(expr_id);
        if expr.kind == E_CALL {
            let callee = self.ast.expr(expr.a);
            if callee.kind == E_NAME {
                let fn_index = self.ast.fn_named(callee.a);
                return fn_index != NONE32 && flag(in self.caller_slot, fn_index);
            }
            return false;
        }
        if expr.kind == E_BLOCK {
            if expr.c != 0 {
                return self.tail_calls_set(wrapping_sub(expr.c, 1));
            }
            return false;
        }
        if expr.kind == E_IF {
            if self.tail_calls_set(expr.b) {
                return true;
            }
            if expr.c != 0 {
                return self.tail_calls_set(wrapping_sub(expr.c, 1));
            }
            return false;
        }
        if expr.kind == E_MATCH {
            for i in 0..w(expr.c) {
                if self.tail_calls_set(self.ast.at(add(add(w(expr.b), wrapping_mul(i, 2)), 1))) {
                    return true;
                }
            }
        }
        false
    }

    // `caller_slot_functions`.
    fn caller_slot_functions(inout self) {
        for i in 0..self.ast.fns.len() {
            let func = self.ast.func(n32(i));
            if func.fip && func.body != NONE32 && self.mentions_new_in_caller(func.body) {
                let ok = self.caller_slot.try_set(i, true);
            }
        }
        loop {
            let mut changed = false;
            for i in 0..self.ast.fns.len() {
                let func = self.ast.func(n32(i));
                if !func.fip || flag(in self.caller_slot, n32(i)) || !self.is_box(func.result) {
                    continue;
                }
                if func.body != NONE32 && self.tail_calls_set(func.body) {
                    let ok = self.caller_slot.try_set(i, true);
                    changed = true;
                }
            }
            if !changed {
                break;
            }
        }
    }

    // The unsafe test of `unsafe_non_fip_functions` over a body: true when
    // a node makes the function unsafe; the non-@fip callees are pushed.
    fn unsafe_visit(inout self, expr_id: u32, inout callees: ChunkSeq[u32]) -> bool {
        let expr = self.ast.expr(expr_id);
        if expr.kind == E_BLOCK {
            for i in 0..w(expr.b) {
                let stmt_pat = self.ast.at(add(w(expr.a), wrapping_mul(i, 3)));
                if stmt_pat != 0 && self.pattern_has_box_pattern(wrapping_sub(stmt_pat, 1)) {
                    return true;
                }
            }
        } else if expr.kind == E_MATCH {
            for i in 0..w(expr.c) {
                if self.pattern_has_box_pattern(self.ast.at(add(w(expr.b), wrapping_mul(i, 2)))) {
                    return true;
                }
            }
        } else if expr.kind == E_HANDLE {
            if expr.a == self.syms.alloc {
                return true;
            }
            if expr.b != 0 && self.pattern_has_box_pattern(wrapping_sub(expr.b, 1)) {
                return true;
            }
            let mut at = w(expr.e);
            let clause_count = w(self.ast.at(at));
            at = inc(at);
            for i in 0..clause_count {
                let pat_count = w(self.ast.at(inc(at)));
                for j in 0..pat_count {
                    if self.pattern_has_box_pattern(self.ast.at(add(add(at, 2), j))) {
                        return true;
                    }
                }
                at = add(at, add(pat_count, 2));
            }
        } else if expr.kind == E_CALL {
            if self.fip_allocation(expr.a) != 0 {
                return true;
            }
            let callee = self.ast.expr(expr.a);
            if callee.kind == E_NAME {
                let name = callee.a;
                if name == self.syms.box_new || name == self.syms.box_new_in_caller {
                    return true;
                }
                let fn_index = self.ast.fn_named(name);
                if fn_index != NONE32 && flag(in self.caller_slot, fn_index) {
                    return true;
                }
                if self.has_type(callee) && self.is_fn_type(self.expr_type(callee)) {
                    return true;
                }
                if fn_index != NONE32 {
                    if !self.ast.func(fn_index).fip {
                        callees.push(fn_index);
                    }
                } else if self.has_path_sep(name) {
                    let expr_ty = self.expr_type(expr);
                    if self.contains_box(expr_ty) {
                        return true;
                    }
                }
            } else if callee.kind == E_FIELD {
                let base = self.ast.expr(callee.a);
                let base_ty = self.expr_type(base);
                let method = self.method_name(base_ty, callee.b);
                let fn_index = self.ast.fn_named(method);
                if fn_index != NONE32 && flag(in self.caller_slot, fn_index) {
                    return true;
                }
                if fn_index != NONE32 {
                    if !self.ast.func(fn_index).fip {
                        callees.push(fn_index);
                    }
                } else {
                    return true;
                }
            } else {
                return true;
            }
        }
        let mut kids: ChunkSeq[u32] = ChunkSeq::new[u32]();
        self.children(expr_id, inout kids);
        for i in 0..kids.len() {
            if self.unsafe_visit(u32_at(in kids, i), inout callees) {
                return true;
            }
        }
        false
    }

    // `unsafe_non_fip_functions`. The fixpoint over call edges does not
    // depend on the order it visits callers in.
    fn unsafe_non_fip_functions(inout self) {
        let n = self.ast.fns.len();
        // edges: callers' callee runs, edge_at[i]..edge_at[i+1]
        let mut edges: ChunkSeq[u32] = ChunkSeq::new[u32]();
        let mut edge_at: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](inc(n));
        for i in 0..n {
            edge_at.push(n32(edges.len()));
            let func = self.ast.func(n32(i));
            if func.fip {
                continue;
            }
            let mut bad = self.fn_allocs(func)
                || self.contains_box(func.result)
                || func.body == NONE32;
            if !bad {
                for j in 0..w(func.param_count) {
                    let param = self.ast.param(add(w(func.param_start), j));
                    if param.pass == TyPass::Sink && self.contains_box(param.ty) {
                        bad = true;
                        break;
                    }
                }
            }
            if !bad {
                let mut callees: ChunkSeq[u32] = ChunkSeq::new[u32]();
                bad = self.unsafe_visit(func.body, inout callees);
                if !bad {
                    edges.extend(in callees.as_slice());
                }
            }
            if bad {
                let ok = self.unsafe_non_fip.try_set(i, true);
            }
        }
        edge_at.push(n32(edges.len()));
        loop {
            let mut changed = false;
            for i in 0..n {
                if flag(in self.unsafe_non_fip, n32(i)) {
                    continue;
                }
                let run_start = w(u32_at(in edge_at, i));
                let run_end = w(u32_at(in edge_at, inc(i)));
                for j in run_start..run_end {
                    if flag(in self.unsafe_non_fip, u32_at(in edges, j)) {
                        let ok = self.unsafe_non_fip.try_set(i, true);
                        changed = true;
                        break;
                    }
                }
            }
            if !changed {
                break;
            }
        }
    }

    // ----- places --------------------------------------------------------------

    // `Place::from_expr`: the root name, or NONE32; `path` gets the fields.
    fn place_of(in self, expr_id: u32, inout path: ChunkSeq[u32]) -> u32 {
        path.clear();
        let mut reversed: ChunkSeq[u32] = ChunkSeq::new[u32]();
        let mut cur = expr_id;
        loop {
            let expr = self.ast.expr(cur);
            if expr.kind == E_FIELD {
                reversed.push(expr.b);
                cur = expr.a;
            } else if expr.kind == E_NAME {
                let n = reversed.len();
                for i in 0..n {
                    path.push(u32_at(in reversed, wrapping_sub(wrapping_sub(n, 1), i)));
                }
                return expr.a;
            } else {
                return NONE32;
            }
        }
        NONE32
    }

    fn is_place(in self, expr_id: u32) -> bool {
        let mut path: ChunkSeq[u32] = ChunkSeq::new[u32]();
        self.place_of(expr_id, inout path) != NONE32
    }

    // `!remaining_box_paths(ty, moved).is_empty()`.
    fn has_remaining(inout self, ty: u32, in moved: ChunkSeq[u32]) -> bool {
        let mut path: ChunkSeq[u32] = ChunkSeq::new[u32]();
        self.remaining(ty, inout path, in moved)
    }

    fn remaining(inout self, ty: u32, inout path: ChunkSeq[u32], in moved: ChunkSeq[u32]) -> bool {
        for i in 0..moved.len() {
            if self.paths.is_prefix(u32_at(in moved, i), in path) {
                return false;
            }
        }
        if !self.contains_box(ty) {
            return false;
        }
        if self.is_box(ty) {
            return true;
        }
        let node = self.ctx.types.node(ty);
        if node.kind == TyKind::Tuple {
            for i in 0..w(node.n) {
                let index_name = self.digit(i);
                path.push(index_name);
                let has_box = self.remaining(self.ctx.types.arg(ty, i), inout path, in moved);
                let last = wrapping_sub(path.len(), 1);
                path.truncate(last);
                if has_box {
                    return true;
                }
            }
            return false;
        }
        if node.kind == TyKind::Named {
            let adt_index = self.ctx.world.lookup(node.name);
            if adt_index != NONE32 {
                let adt = self.ctx.world.adt(adt_index);
                if !adt.is_enum && adt.vn == 1 {
                    let vars = self.ctx.world.vars_of(in self.ctx.types, adt, ty);
                    let variant = self.ctx.world.variant(w(adt.va));
                    for fi in 0..w(variant.fc) {
                        let field = self.ctx.world.field(add(w(variant.fa), fi));
                        let field_ty = substitute(inout self.ctx.types, field.ty, in vars);
                        path.push(field.name);
                        let has_box = self.remaining(field_ty, inout path, in moved);
                        let last = wrapping_sub(path.len(), 1);
                        path.truncate(last);
                        if has_box {
                            return true;
                        }
                    }
                    return false;
                }
            }
            return true;
        }
        false
    }

    // E0806 for every binding of `names` (in order) that still owns a Box.
    fn report_undropped(inout self, in binds: Binds, in names: ChunkSeq[u32]) {
        for i in 0..names.len() {
            let name = u32_at(in names, i);
            let at = binds.find(name);
            if at == NONE64 {
                continue;
            }
            let row = binds.row(at);
            let moved = binds.moved_of(name);
            if self.has_remaining(row.ty, in moved) {
                self.named(
                    "E0806",
                    row.start,
                    row.end,
                    "@fip function cannot drop owned Box in ",
                    name,
                    " without unpacking or moving it"
                );
            }
        }
    }

    // The block-exit step of `Block` and match arms: report the bindings
    // bound since `outer`, then restore `outer`'s.
    fn close_scope(inout self, inout fip_state: FipState, in outer: Binds) {
        let locals = fip_state.binds.locals(in outer);
        if !fip_state.diverged {
            let snapshot = copy_binds(in fip_state.binds);
            self.report_undropped(in snapshot, in locals);
        }
        for i in 0..locals.len() {
            let name = u32_at(in locals, i);
            fip_state.binds.remove(name);
            fip_state.binds.restore(in self.ctx.names, in outer, name);
        }
    }

    // ----- the checker -----------------------------------------------------------

    // `FipChecker::bind_pattern`.
    fn bind_pattern(inout self, pat_id: u32, ty: u32, inout fip_state: FipState) {
        let pat = self.ast.pat(pat_id);
        if pat.kind == PT_WILD {
            if self.contains_box(ty) {
                self.simple(
                    "E0806",
                    pat.start,
                    pat.end,
                    "@fip function cannot discard Box value with '_' pattern"
                );
            }
            return;
        }
        if pat.kind == PT_BIND {
            if self.contains_box(ty) {
                fip_state.binds.insert(
                    in self.ctx.names,
                    BindRow { name: pat.a, ty: ty, start: pat.start, end: pat.end }
                );
            }
            return;
        }
        if pat.kind == PT_TUPLE {
            let node = self.ctx.types.node(ty);
            if node.kind == TyKind::Tuple {
                for i in 0..w(pat.b) {
                    if i >= w(node.n) {
                        break;
                    }
                    self.bind_pattern(
                        self.ast.at(add(w(pat.a), i)),
                        self.ctx.types.arg(ty, i),
                        inout fip_state
                    );
                }
            }
            return;
        }
        if pat.kind == PT_CTOR {
            if self.is_box_pattern(pat) {
                let mut inner = self.box_inner(ty);
                if inner == NONE32 {
                    inner = self.ctx.types.infer;
                }
                fip_state.slots.push(SlotRow { ty: inner, start: pat.start, end: pat.end });
                self.bind_pattern(self.ast.at(inc(w(pat.b))), inner, inout fip_state);
                return;
            }
            let ctor_key = self.ctor(pat.a);
            if ctor_key == NONE64 {
                return;
            }
            let adt = self.ctx.world.adt(n32(ctor_key >> 32));
            let variant = self.ctx.world.variant(ctor_key & 4294967295);
            let vars = if self.ctx.types.kind(ty) == TyKind::Named {
                self.ctx.world.vars_of(in self.ctx.types, adt, ty)
            } else {
                vars_new()
            };
            for i in 0..w(pat.c) {
                let at = add(w(pat.b), wrapping_mul(i, 2));
                let field_name = self.ast.at(at);
                let field_pat = self.ast.at(inc(at));
                let field_index = self.ctx.world.find_field(variant, field_name);
                if field_index != NONE32 {
                    let field_ty = substitute(
                        inout self.ctx.types,
                        self.ctx.world.field(w(field_index)).ty,
                        in vars
                    );
                    self.bind_pattern(field_pat, field_ty, inout fip_state);
                }
            }
        }
    }

    // `pop_matching_slot`.
    fn pop_matching_slot(
        inout self,
        func: FnRow,
        needed: u32,
        start: u64,
        end: u64,
        inout fip_state: FipState
    ) {
        for i in 0..fip_state.slots.len() {
            let slot = fip_state.slot(i);
            if self.slots_match(func, slot.ty, needed) {
                fip_state.remove_slot(i);
                return;
            }
        }
        self.diag("E0804", start, end);
        put(inout self.out, "@fip allocation requires a ReuseSlot with ");
        self.write_label(func, needed);
        if fip_state.slots.len() == 0 {
            put(inout self.out, " (none available)");
        } else {
            put(inout self.out, " (available: [");
            for i in 0..fip_state.slots.len() {
                if i > 0 {
                    put(inout self.out, ", ");
                }
                let slot = fip_state.slot(i);
                self.write_label(func, slot.ty);
            }
            put(inout self.out, "])");
        }
        self.end_diag();
    }

    // `consume_caller_slot`.
    fn consume_caller_slot(
        inout self,
        func: FnRow,
        produced: u32,
        start: u64,
        end: u64,
        inout fip_state: FipState
    ) {
        let ret_inner = self.box_inner(func.result);
        if ret_inner == NONE32 {
            self.simple(
                "E0807",
                start,
                end,
                "Box::new_in_caller requires @fip function to return Box[T]"
            );
            return;
        }
        if !self.slots_match(func, produced, ret_inner) {
            self.diag("E0807", start, end);
            put(inout self.out, "Box::new_in_caller type ");
            self.write_label(func, produced);
            put(inout self.out, " does not match function return slot ");
            self.write_label(func, ret_inner);
            self.end_diag();
        }
        if fip_state.caller_used {
            self.simple(
                "E0808",
                start,
                end,
                "caller ReuseSlot already consumed on this execution path"
            );
        }
        fip_state.caller_used = true;
    }

    fn slot_multisets_match(
        inout self,
        func: FnRow,
        in left: FipState,
        in right: FipState
    ) -> bool {
        if left.slots.len() != right.slots.len() {
            return false;
        }
        let mut used: ChunkSeq[bool] = ChunkSeq::with_capacity[bool](right.slots.len());
        used.resize(right.slots.len(), false);
        for i in 0..left.slots.len() {
            let slot_ty = left.slot(i).ty;
            let mut found = false;
            for j in 0..right.slots.len() {
                if !flag(in used, n32(j)) && self.slots_match(func, slot_ty, right.slot(j).ty) {
                    let ok = used.try_set(j, true);
                    found = true;
                    break;
                }
            }
            if !found {
                return false;
            }
        }
        true
    }

    // One branch of `merge_states`: the first live branch becomes `acc`;
    // each later live one is compared with it (its E0808/E0809 bits are
    // pushed to `flags`, reported after all branches as Rust does) and
    // intersects the moved paths.
    fn merge_step(
        inout self,
        func: FnRow,
        inout acc: FipState,
        inout have: bool,
        sink branch: FipState,
        inout flags: ChunkSeq[u8]
    ) {
        if branch.diverged {
            return;
        }
        if !have {
            acc = branch;
            have = true;
            return;
        }
        let mut bits: u8 = 0;
        if branch.caller_used != acc.caller_used {
            bits = bits | 1;
        }
        if !self.slot_multisets_match(func, in acc, in branch) {
            bits = bits | 2;
        }
        flags.push(bits);
        acc.binds.intersect(in branch.binds);
    }

    fn merge_report(inout self, start: u64, end: u64, in flags: ChunkSeq[u8]) {
        for i in 0..flags.len() {
            let bits = u8_at(in flags, i);
            if (bits & 1) != 0 {
                self.simple(
                    "E0808",
                    start,
                    end,
                    "all non-diverging paths of an @fip function must agree on consuming caller ReuseSlot"
                );
            }
            if (bits & 2) != 0 {
                self.simple(
                    "E0809",
                    start,
                    end,
                    "branches leave incompatible remaining Box ReuseSlots"
                );
            }
        }
    }

    // `merge_states(vec![a, b])`.
    fn merge2(
        inout self,
        func: FnRow,
        sink left: FipState,
        sink right: FipState,
        start: u64,
        end: u64
    ) -> FipState {
        let mut acc = state_new(true);
        let mut have = false;
        let mut flags: ChunkSeq[u8] = ChunkSeq::new[u8]();
        self.merge_step(func, inout acc, inout have, left, inout flags);
        self.merge_step(func, inout acc, inout have, right, inout flags);
        self.merge_report(start, end, in flags);
        if !have {
            return state_new(true);
        }
        acc
    }

    // `non_fip_call_uses_box`; `args` are the argument expressions (the
    // receiver first for a method).
    fn non_fip_call_uses_box(
        inout self,
        callee: FnRow,
        callee_index: u32,
        in args: ChunkSeq[u32],
        result: u32
    ) -> bool {
        if callee.fip {
            return false;
        }
        if self.contains_box(result)
            || self.contains_box(callee.result)
            || flag(in self.unsafe_non_fip, callee_index) {
            return true;
        }
        for i in 0..w(callee.param_count) {
            if i >= args.len() {
                break;
            }
            let param = self.ast.param(add(w(callee.param_start), i));
            if param.pass == TyPass::Sink {
                if self.contains_box(param.ty) {
                    return true;
                }
                let arg_ty = self.expr_type(self.ast.expr(u32_at(in args, i)));
                if self.contains_box(arg_ty) {
                    return true;
                }
            }
        }
        false
    }

    // The argument expressions of call `expr`.
    fn call_args(in self, expr: ExprRow, inout out: ChunkSeq[u32]) {
        for i in 0..w(expr.c) {
            out.push(self.ast.at(add(add(w(expr.b), wrapping_mul(i, 2)), 1)));
        }
    }

    fn arg_pass(in self, expr: ExprRow, i: u64) -> u8 {
        wrapping_u8(self.ast.at(add(w(expr.b), wrapping_mul(i, 2))))
    }

    // A call of a declared function `callee_index` (from `expr`, the call): its Alloc and
    // non-@fip checks, its arguments, and the caller-slot forwarding.
    // `receiver` is the receiver expression of a method call, or NONE32.
    fn check_known_call(
        inout self,
        func: FnRow,
        expr: ExprRow,
        callee_index: u32,
        name: u32,
        receiver: u32,
        inout fip_state: FipState,
        in_tail: bool
    ) {
        let callee = self.ast.func(callee_index);
        let expr_ty = self.expr_type(expr);
        if self.fn_allocs(callee) {
            self.named(
                "E0801",
                expr.start,
                expr.end,
                "@fip function cannot call ",
                name,
                " with 'Alloc' effect"
            );
        }
        let mut args: ChunkSeq[u32] = ChunkSeq::new[u32]();
        if receiver != NONE32 {
            args.push(receiver);
        }
        self.call_args(expr, inout args);
        if self.non_fip_call_uses_box(callee, callee_index, in args, expr_ty) {
            self.named(
                "E0801",
                expr.start,
                expr.end,
                "@fip function cannot call non-@fip function ",
                name,
                " that uses Box"
            );
        }
        let mut first_arg: u64 = 0;
        if receiver != NONE32 {
            first_arg = 1;
            let receiver_owned = callee.param_count > 0
                && self.ast.param(w(callee.param_start)).pass == TyPass::Sink;
            let base = self.ast.expr(receiver);
            let base_ty = self.expr_type(base);
            self.check_expr(func, receiver, inout fip_state, receiver_owned, false);
            if !receiver_owned && !self.is_place(receiver) && self.contains_box(base_ty) {
                self.simple(
                    "E0806",
                    base.start,
                    base.end,
                    "@fip function drops temporary Box passed as receiver by borrow"
                );
            }
        }
        // `args.iter().zip(params)` (after the receiver's parameter).
        for i in 0..w(expr.c) {
            let param_index = add(i, first_arg);
            if param_index >= w(callee.param_count) {
                break;
            }
            let arg = u32_at(in args, param_index);
            let param = self.ast.param(add(w(callee.param_start), param_index));
            let arg_owned = param.pass == TyPass::Sink;
            let arg_expr = self.ast.expr(arg);
            let arg_ty = self.expr_type(arg_expr);
            self.check_expr(func, arg, inout fip_state, arg_owned, false);
            if !arg_owned && !self.is_place(arg) && self.contains_box(arg_ty) {
                self.simple(
                    "E0806",
                    arg_expr.start,
                    arg_expr.end,
                    "@fip function drops temporary Box passed by borrow"
                );
            }
        }
        if flag(in self.caller_slot, callee_index) {
            let inner = self.box_inner(expr_ty);
            if inner != NONE32 {
                let mut can_forward = false;
                if in_tail && !fip_state.caller_used {
                    let ret_inner = self.box_inner(func.result);
                    if ret_inner != NONE32 {
                        can_forward = self.slots_match(func, inner, ret_inner);
                    }
                }
                if can_forward {
                    self.consume_caller_slot(func, inner, expr.start, expr.end, inout fip_state);
                } else {
                    self.pop_matching_slot(func, inner, expr.start, expr.end, inout fip_state);
                }
            }
        }
    }

    // Checks the arguments of call `expr`, each owned when `sink` is passed
    // (`all_owned` makes every argument owned).
    fn check_args(
        inout self,
        func: FnRow,
        expr: ExprRow,
        inout fip_state: FipState,
        all_owned: bool
    ) {
        for i in 0..w(expr.c) {
            let arg = self.ast.at(add(add(w(expr.b), wrapping_mul(i, 2)), 1));
            let owned = all_owned || self.arg_pass(expr, i) == TyPass::Sink;
            self.check_expr(func, arg, inout fip_state, owned, false);
        }
    }

    // `FipChecker::check_expr`.
    fn check_expr(
        inout self,
        func: FnRow,
        expr_id: u32,
        inout fip_state: FipState,
        owned: bool,
        in_tail: bool
    ) {
        if owned {
            let mut path: ChunkSeq[u32] = ChunkSeq::new[u32]();
            let root = self.place_of(expr_id, inout path);
            if root != NONE32 && fip_state.binds.has(root) {
                let path_id = self.paths.intern(in path);
                fip_state.binds.mark_moved(root, path_id);
                return;
            }
        }
        let expr = self.ast.expr(expr_id);
        let expr_ty = self.expr_type(expr);
        let kind = expr.kind;
        if kind == E_TUPLE || kind == E_STRUCT {
            for i in 0..w(expr.b) {
                self.check_expr(
                    func,
                    self.ast.at(add(w(expr.a), i)),
                    inout fip_state,
                    owned,
                    false
                );
            }
        } else if kind == E_FIELD || kind == E_UNARY || kind == E_TRY {
            self.check_expr(func, expr.a, inout fip_state, false, false);
        } else if kind == E_INDEX {
            self.check_expr(func, expr.a, inout fip_state, false, false);
            self.check_expr(func, expr.b, inout fip_state, true, false);
        } else if kind == E_ASSIGN {
            let mut path: ChunkSeq[u32] = ChunkSeq::new[u32]();
            let root = self.place_of(expr.a, inout path);
            if root != NONE32 {
                let at = fip_state.binds.find(root);
                if at != NONE64 {
                    let bind_ty = fip_state.binds.row(at).ty;
                    let mut place_ty = bind_ty;
                    for i in 0..path.len() {
                        if place_ty == NONE32 {
                            break;
                        }
                        let seg = u32_at(in path, i);
                        let is_index_step = self.ctx.names.has_prefix(seg, in "[".as_bytes());
                        place_ty = field_step(
                            inout self.ctx.types,
                            inout self.ctx.names,
                            in self.ctx.world,
                            place_ty,
                            seg,
                            is_index_step
                        );
                    }
                    if place_ty != NONE32 && self.contains_box(place_ty) {
                        let lhs = self.ast.expr(expr.a);
                        self.simple(
                            "E0806",
                            lhs.start,
                            lhs.end,
                            "@fip function cannot overwrite an owned Box without unpacking or moving it first"
                        );
                    }
                }
            }
            self.check_expr(func, expr.b, inout fip_state, true, false);
        } else if kind == E_BINARY {
            self.check_expr(func, expr.a, inout fip_state, true, false);
            if expr.c != 0 {
                let mut rhs_state = copy_state(in fip_state);
                self.check_expr(func, expr.b, inout rhs_state, true, false);
                let lhs_state = copy_state(in fip_state);
                fip_state = self.merge2(func, lhs_state, rhs_state, expr.start, expr.end);
            } else {
                self.check_expr(func, expr.b, inout fip_state, true, false);
            }
        } else if kind == E_BLOCK {
            let outer = copy_binds(in fip_state.binds);
            for i in 0..w(expr.b) {
                if fip_state.diverged {
                    break;
                }
                let at = add(w(expr.a), wrapping_mul(i, 3));
                let stmt_pat = self.ast.at(at);
                let value_id = self.ast.at(add(at, 2));
                let value_expr = self.ast.expr(value_id);
                if stmt_pat != 0 {
                    let inferred = self.expr_type(value_expr);
                    let val_ty = if inferred != self.ctx.types.infer {
                        inferred
                    } else {
                        self.ast.at(inc(at))
                    };
                    self.check_expr(func, value_id, inout fip_state, true, false);
                    if !fip_state.diverged {
                        self.bind_pattern(wrapping_sub(stmt_pat, 1), val_ty, inout fip_state);
                    }
                } else {
                    let stmt_ty = self.expr_type(value_expr);
                    self.check_expr(func, value_id, inout fip_state, true, false);
                    if self.contains_box(stmt_ty) {
                        self.simple(
                            "E0806",
                            value_expr.start,
                            value_expr.end,
                            "@fip function drops temporary Box value in statement"
                        );
                    }
                }
            }
            if !fip_state.diverged && expr.c != 0 {
                self.check_expr(func, wrapping_sub(expr.c, 1), inout fip_state, owned, in_tail);
            }
            self.close_scope(inout fip_state, in outer);
        } else if kind >= E_LOOP && kind <= E_CONTINUE {
            // Loops and early exits leave the FIP ownership model.
            self.simple(
                "E0806",
                expr.start,
                expr.end,
                "@fip function cannot use loop, for, break or return; write the iteration as tail recursion"
            );
            fip_state.diverged = true;
        } else if kind == E_IF {
            self.check_expr(func, expr.a, inout fip_state, true, false);
            let mut left = copy_state(in fip_state);
            self.check_expr(func, expr.b, inout left, owned, in_tail);
            let mut right = copy_state(in fip_state);
            if expr.c != 0 {
                self.check_expr(func, wrapping_sub(expr.c, 1), inout right, owned, in_tail);
            }
            fip_state = self.merge2(func, left, right, expr.start, expr.end);
        } else if kind == E_MATCH {
            self.check_match(func, expr, inout fip_state, owned, in_tail);
        } else if kind == E_CALL {
            if self.check_call(func, expr, inout fip_state, in_tail) {
                return;
            }
        } else if kind == E_HANDLE {
            if expr.a == self.syms.alloc {
                self.simple(
                    "E0801",
                    expr.start,
                    expr.end,
                    "@fip function cannot handle the 'Alloc' effect"
                );
            }
            if expr.b != 0 {
                let state_ty = self.expr_type(self.ast.expr(expr.c));
                self.check_expr(func, expr.c, inout fip_state, true, false);
                self.bind_pattern(wrapping_sub(expr.b, 1), state_ty, inout fip_state);
            }
            self.check_expr(func, expr.d, inout fip_state, owned, in_tail);
        }
        if self.is_never(expr_ty) {
            fip_state.diverged = true;
        }
    }

    fn check_match(
        inout self,
        func: FnRow,
        expr: ExprRow,
        inout fip_state: FipState,
        owned: bool,
        in_tail: bool
    ) {
        let scrutinee = self.ast.expr(expr.a);
        let scrutinee_ty = self.expr_type(scrutinee);
        // A match on a borrowed place binds `in` borrows: its boxes are the
        // caller's and supply no ReuseSlot.
        let mut path: ChunkSeq[u32] = ChunkSeq::new[u32]();
        let root = self.place_of(expr.a, inout path);
        if root != NONE32 {
            let mut borrowed = false;
            for i in 0..w(func.param_count) {
                let param = self.ast.param(add(w(func.param_start), i));
                if param.name == root && param.pass != TyPass::Sink {
                    borrowed = true;
                    break;
                }
            }
            if borrowed && self.contains_box(scrutinee_ty) {
                self.simple(
                    "E0806",
                    scrutinee.start,
                    scrutinee.end,
                    "@fip function cannot match a borrowed Box value; its boxes belong to the caller and supply no ReuseSlot (take it `sink`)"
                );
            }
        }
        self.check_expr(func, expr.a, inout fip_state, true, false);
        let mut acc = state_new(true);
        let mut have = false;
        let mut flags: ChunkSeq[u8] = ChunkSeq::new[u8]();
        for i in 0..w(expr.c) {
            let at = add(w(expr.b), wrapping_mul(i, 2));
            let mut arm = copy_state(in fip_state);
            let arm_outer = copy_binds(in arm.binds);
            self.bind_pattern(self.ast.at(at), scrutinee_ty, inout arm);
            self.check_expr(func, self.ast.at(inc(at)), inout arm, owned, in_tail);
            self.close_scope(inout arm, in arm_outer);
            self.merge_step(func, inout acc, inout have, arm, inout flags);
        }
        self.merge_report(expr.start, expr.end, in flags);
        if have {
            fip_state = acc;
        } else {
            fip_state = state_new(true);
        }
    }

    // The `Call` arm of `check_expr`; true when Rust returns early (before
    // the `Never` test).
    fn check_call(
        inout self,
        func: FnRow,
        expr: ExprRow,
        inout fip_state: FipState,
        in_tail: bool
    ) -> bool {
        let op = self.fip_allocation(expr.a);
        if op != 0 {
            self.diag("E0801", expr.start, expr.end);
            put(inout self.out, "@fip function cannot allocate through ChunkSeq::");
            self.alloc_name(op);
            self.end_diag();
        }
        let expr_ty = self.expr_type(expr);
        let callee = self.ast.expr(expr.a);
        if callee.kind == E_NAME {
            let name = callee.a;
            if name == self.syms.box_new {
                self.check_args(func, expr, inout fip_state, true);
                let inner = self.box_inner(expr_ty);
                if inner != NONE32 {
                    self.pop_matching_slot(func, inner, expr.start, expr.end, inout fip_state);
                }
                return true;
            }
            if name == self.syms.box_new_in_caller {
                self.check_args(func, expr, inout fip_state, true);
                let inner = self.box_inner(expr_ty);
                if inner != NONE32 {
                    self.consume_caller_slot(func, inner, expr.start, expr.end, inout fip_state);
                }
                return true;
            }
            if self.ctor(name) != NONE64 {
                self.check_args(func, expr, inout fip_state, true);
                return true;
            }
            if self.is_fn_type(self.expr_type(callee)) {
                self.check_args(func, expr, inout fip_state, false);
                self.simple(
                    "E0801",
                    expr.start,
                    expr.end,
                    "@fip function cannot perform indirect calls to unverified closures"
                );
                return true;
            }
            let callee_index = self.ast.fn_named(name);
            if callee_index != NONE32 {
                self.check_known_call(
                    func,
                    expr,
                    callee_index,
                    name,
                    NONE32,
                    inout fip_state,
                    in_tail
                );
                return true;
            }
            // A builtin vector, tiled or arithmetic intrinsic, or an effect op.
            if self.has_path_sep(name) && self.contains_box(expr_ty) {
                self.named(
                    "E0801",
                    expr.start,
                    expr.end,
                    "@fip function cannot call effect operation ",
                    name,
                    " producing Box"
                );
            }
            self.check_args(func, expr, inout fip_state, false);
            return true;
        }
        if callee.kind == E_FIELD {
            let base_ty = self.expr_type(self.ast.expr(callee.a));
            let method = self.method_name(base_ty, callee.b);
            let callee_index = self.ast.fn_named(method);
            if callee_index != NONE32 {
                self.check_known_call(
                    func,
                    expr,
                    callee_index,
                    method,
                    callee.a,
                    inout fip_state,
                    in_tail
                );
                return true;
            }
        }
        self.check_expr(func, expr.a, inout fip_state, false, false);
        self.check_args(func, expr, inout fip_state, true);
        self.simple(
            "E0801",
            expr.start,
            expr.end,
            "@fip function cannot perform indirect calls to unverified closures"
        );
        false
    }

    // `check_fip_fn`.
    fn check_fip_fn(inout self, func: FnRow) {
        if self.fn_allocs(func) {
            self.simple(
                "E0801",
                func.start,
                func.end,
                "@fip function cannot declare the 'Alloc' effect"
            );
        }
        if func.body == NONE32 {
            return;
        }
        let mut fip_state = state_new(false);
        for i in 0..w(func.param_count) {
            let param = self.ast.param(add(w(func.param_start), i));
            if param.pass == TyPass::Sink && self.contains_box(param.ty) {
                fip_state.binds.insert(
                    in self.ctx.names,
                    BindRow { name: param.name, ty: param.ty, start: param.start, end: param.end }
                );
            }
        }
        self.check_expr(func, func.body, inout fip_state, true, true);
        if !fip_state.diverged {
            for i in 0..fip_state.slots.len() {
                let slot = fip_state.slot(i);
                self.simple(
                    "E0805",
                    slot.start,
                    slot.end,
                    "@fip function leaves an unconsumed Box ReuseSlot (would drop/deallocate)"
                );
            }
            let mut bound_names: ChunkSeq[u32] = ChunkSeq::new[u32]();
            for i in 0..fip_state.binds.len() {
                bound_names.push(fip_state.binds.row(i).name);
            }
            let snapshot = copy_binds(in fip_state.binds);
            self.report_undropped(in snapshot, in bound_names);
        }
    }

    // `check_world`.
    pub fn check_world(inout self) {
        self.caller_slot_functions();
        self.unsafe_non_fip_functions();
        for i in 0..self.ast.fns.len() {
            let func = self.ast.func(n32(i));
            self.paths.reset();
            if func.fip {
                self.check_fip_fn(func);
            } else if func.body != NONE32 {
                self.check_non_fip(func.body);
            }
        }
    }
}
