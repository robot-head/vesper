// The size of `Layout::of` (src/layout.rs), which `slots_match`,
// `slot_size_label` and `slot_key` read: the fip checks need the byte size
// of a concrete type, or whether it has no layout. A copy of the size half
// of the census layout sample (docs/parallel-results/self-host-census.md),
// which matched Rust on every corpus type; SH2 lane 5 swaps the full
// layout module, and this file goes once that package can be imported.
//
// Sizes are memoized per (defaulted) type id: the type arena is
// hash-consed, so equal types share the entry.

use @vesper/check-data::util::{add, inc, n32, u32_at, u64_at, w};
use @vesper/check-data::names::{Names};
use @vesper/check-data::types::{Types, default_type, substitute, TyKind};
use @vesper/check-data::world::{World, vector_words};

const NONE32: u32 = 4294967295;

// No layout (`Layout::of` returned `Err`).
pub const NO_SIZE: u64 = 18446744073709551615;

pub struct Sizes {
    // type id -> 0 unknown, else size + 1 (NO_SIZE + 1 wraps to 0, so a
    // failure is kept in `failed`)
    memo: ChunkSeq[u64],
    failed: ChunkSeq[bool],
    seen: ChunkSeq[u32],
}

pub fn sizes_new() -> Sizes {
    Sizes { memo: ChunkSeq::new[u64](), failed: ChunkSeq::new[bool](), seen: ChunkSeq::new[u32]() }
}

fn fits_i32(value: i64) -> bool {
    value <= 2147483647 && value >= -2147483648
}

fn max_u64(a: u64, b: u64) -> u64 {
    if a > b { a } else { b }
}

// `Layout::of(world, ty).map(|l| l.size)`, or NO_SIZE.
pub fn layout_size(
    inout sizes: Sizes,
    inout types: Types,
    in names: Names,
    in world: World,
    ty: u32
) -> u64 {
    let defaulted = default_type(inout types, ty);
    let slot = w(defaulted);
    if slot < sizes.memo.len() {
        let cached = u64_at(in sizes.memo, slot);
        if cached != 0 {
            return wrapping_sub(cached, 1);
        }
        match sizes.failed.try_get(slot) {
            Option::Some(failed) => {
                if failed {
                    return NO_SIZE;
                }
            }
            Option::None => {}
        }
    }
    sizes.seen.clear();
    let size = build(inout sizes, inout types, in names, in world, defaulted, 0);
    if slot >= sizes.memo.len() {
        let new_len = inc(slot);
        sizes.memo.resize(new_len, 0);
        sizes.failed.resize(new_len, false);
    }
    if size == NO_SIZE {
        let ok = sizes.failed.try_set(slot, true);
    } else {
        let ok = sizes.memo.try_set(slot, inc(size));
    }
    size
}

fn build(
    inout sizes: Sizes,
    inout types: Types,
    in names: Names,
    in world: World,
    ty: u32,
    depth: u64
) -> u64 {
    let known = world.k;
    if depth > 128 {
        return NO_SIZE;
    }
    let node = types.node(ty);
    let name = if node.kind == TyKind::Named {
        node.name
    } else {
        0
    };
    let scalar = node.kind == TyKind::Lit
        || node.kind == TyKind::Fn
        || (node.kind == TyKind::Named && known.is_scalar(name))
        || (node.kind == TyKind::Named && (name == known.region_box || name == known.watermark))
        || (node.kind == TyKind::Named && name == known.tiled_seq && (node.n == 1 || node.n == 2))
        || (node.kind == TyKind::Named && name == known.chunk_seq && node.n == 1)
        || (world.box_active && node.kind == TyKind::Named && name == known.box_ && node.n == 1)
        || ty == types.unit;
    if scalar {
        return 8;
    }
    // A trait object is the pair `{data, vtable}`; a slice is the view
    // `{handle, start, len}`.
    if node.kind == TyKind::Named && name == known.dyn_ && node.n == 1 {
        return 16;
    }
    if node.kind == TyKind::Named && name == known.slice && node.n == 1 {
        return 24;
    }
    if node.kind == TyKind::Tuple {
        let mut offset: i64 = 0;
        for i in 0..w(node.n) {
            let field_ty = u32_at(in types.items, add(w(node.a), i));
            let field_size = build(
                inout sizes,
                inout types,
                in names,
                in world,
                field_ty,
                inc(depth)
            );
            if field_size == NO_SIZE {
                return NO_SIZE;
            }
            offset = wrapping_add(offset, widen_i64(wrapping_i32(n32(field_size))));
            if !fits_i32(offset) {
                return NO_SIZE;
            }
        }
        return max_u64(widen_u64(wrapping_u32(wrapping_i32(offset))), 8);
    }
    let words = vector_words(in types, in names, known, ty);
    if words != 0 {
        return wrapping_mul(w(words), 8);
    }
    if node.kind == TyKind::Named && node.n == 0 && (name == known.string || name == known.str_) {
        return 24;
    }
    if node.kind != TyKind::Named {
        return NO_SIZE;
    }
    let adt_index = world.lookup(name);
    if adt_index == NONE32 {
        return NO_SIZE;
    }
    let adt = world.adt(adt_index);
    if adt.gn != node.n {
        return NO_SIZE;
    }
    for i in 0..sizes.seen.len() {
        if u32_at(in sizes.seen, i) == ty {
            return NO_SIZE;
        }
    }
    sizes.seen.push(ty);
    let vars = world.vars_of(in types, adt, ty);
    let mut size: u64 = 8;
    for vi in 0..w(adt.vn) {
        let variant = world.variant(add(w(adt.va), vi));
        let mut offset: i64 = if adt.is_enum { 8 } else { 0 };
        for fi in 0..w(variant.fc) {
            let field = world.field(add(w(variant.fa), fi));
            let field_ty = substitute(inout types, field.ty, in vars);
            let field_size = build(
                inout sizes,
                inout types,
                in names,
                in world,
                field_ty,
                inc(depth)
            );
            if field_size == NO_SIZE {
                return NO_SIZE;
            }
            offset = wrapping_add(offset, widen_i64(wrapping_i32(n32(field_size))));
            if !fits_i32(offset) {
                return NO_SIZE;
            }
        }
        size = max_u64(size, widen_u64(wrapping_u32(wrapping_i32(offset))));
    }
    let last = wrapping_sub(sizes.seen.len(), 1);
    sizes.seen.truncate(last);
    size
}
