// The part of the surface AST the fip checks read: the bodies of the
// world's functions as flat node tables, decoded from the harness input
// (`FipEnc` in tests/self_host_check_fip.rs). A node names its children by
// index and a list of children is a run of `pool` words, as in @vesper/ast.
// Names are check-data symbols and types are check-data type ids.
//
// Expression kinds (`ExprKind`, numbered as in @vesper/ast):
//   1 Literal
//   2 Name     a = name
//   3 Tuple    pool[a..a+b] = items
//   4 Struct   pool[a..a+b] = field values
//   5 Block    pool[a..a+3b] = statements (pattern + 1 or 0, type, value),
//              c = tail + 1 or 0
//   6 Call     a = callee, pool[b..b+2c] = arguments (pass, expr)
//   7 Field    a = base, b = name
//   8 Index    a, b
//   9 Try      a
//  10 Unary    a
//  11 Binary   a, b; c = 1 for `&&` and `||`
//  12 Assign   a = place, b = value
//  13 If       a = condition, b = then, c = otherwise + 1 or 0
//  14 Match    a = value, pool[b..b+2c] = arms (pattern, body)
//  15 Closure  a = body
//  16 Handle   a = effect name, b = state pattern + 1 or 0, c = state
//              value, d = body, pool[e..] = clause count, then per clause
//              (the return clause first) body, pattern count, patterns
//  17 Loop, 18 For, 19 Range, 20 Break, 21 Return, 22 Continue:
//              pool[a..a+b] = `control_children`
//
// Pattern kinds: 1 Wild, 2 Bind (a = name), 3 Literal, 4 Tuple
// (pool[a..a+b]), 5 Constructor (a = name, pool[b..b+2c] = (field name,
// pattern)).

use @vesper/check-data::util::{add, n32, u32_at, w};
use @vesper/check-data::input::{Reader};

pub copy struct ExprRow {
    kind: u8,
    start: u64,
    end: u64,
    a: u32,
    b: u32,
    c: u32,
    d: u32,
    e: u32,
}

pub copy struct PatRow {
    kind: u8,
    start: u64,
    end: u64,
    a: u32,
    b: u32,
    c: u32,
}

// A function of `world.functions` (in name order).
pub copy struct FnRow {
    name: u32,
    fip: bool,
    start: u64,
    end: u64,
    // generics[generic_start..generic_start+generic_count],
    // params[param_start..param_start+param_count]
    generic_start: u32,
    generic_count: u32,
    param_start: u32,
    param_count: u32,
    result: u32,
    // `Type::Row(f.effects)`
    effects: u32,
    // body expression, or NONE32
    body: u32,
}

pub copy struct GenRow {
    name: u32,
    is_row: bool,
}

pub copy struct ParamRow {
    name: u32,
    pass: u8,
    ty: u32,
    start: u64,
    end: u64,
}

pub struct Ast {
    pool: ChunkSeq[u32],
    exprs: ChunkSeq[ExprRow],
    pats: ChunkSeq[PatRow],
    fns: ChunkSeq[FnRow],
    generics: ChunkSeq[GenRow],
    params: ChunkSeq[ParamRow],
    // symbol -> function index + 1
    fn_by_name: ChunkSeq[u32],
}

const NONE32: u32 = 4294967295;

const NO_EXPR: ExprRow = ExprRow { kind: 0, start: 0, end: 0, a: 0, b: 0, c: 0, d: 0, e: 0 };

const NO_PAT: PatRow = PatRow { kind: 0, start: 0, end: 0, a: 0, b: 0, c: 0 };

const NO_FN: FnRow = FnRow {
    name: 0,
    fip: false,
    start: 0,
    end: 0,
    generic_start: 0,
    generic_count: 0,
    param_start: 0,
    param_count: 0,
    result: 0,
    effects: 0,
    body: NONE32
};

impl Ast {
    pub fn expr(in self, expr_id: u32) -> ExprRow {
        match self.exprs.try_get(w(expr_id)) {
            Option::Some(row) => row,
            Option::None => NO_EXPR,
        }
    }

    pub fn pat(in self, pat_id: u32) -> PatRow {
        match self.pats.try_get(w(pat_id)) {
            Option::Some(row) => row,
            Option::None => NO_PAT,
        }
    }

    pub fn func(in self, fn_index: u32) -> FnRow {
        match self.fns.try_get(w(fn_index)) {
            Option::Some(row) => row,
            Option::None => NO_FN,
        }
    }

    pub fn generic(in self, i: u64) -> GenRow {
        match self.generics.try_get(i) {
            Option::Some(row) => row,
            Option::None => GenRow { name: 0, is_row: false },
        }
    }

    pub fn param(in self, i: u64) -> ParamRow {
        match self.params.try_get(i) {
            Option::Some(row) => row,
            Option::None => ParamRow { name: 0, pass: 0, ty: 0, start: 0, end: 0 },
        }
    }

    // Word `i` of the list pool.
    pub fn at(in self, i: u64) -> u32 {
        u32_at(in self.pool, i)
    }

    // `world.functions.get(name)`: the function index, or NONE32.
    pub fn fn_named(in self, name: u32) -> u32 {
        if name == NONE32 {
            return NONE32;
        }
        let entry = u32_at(in self.fn_by_name, w(name));
        if entry == 0 {
            NONE32
        } else {
            wrapping_sub(entry, 1)
        }
    }
}

fn set_index(inout table: ChunkSeq[u32], name: u32, value: u32) {
    loop {
        if table.len() > w(name) {
            break;
        }
        table.push(0);
    }
    let ok = table.try_set(w(name), value);
}

fn sym(in nmap: ChunkSeq[u32], index: u64) -> u32 {
    u32_at(in nmap, index)
}

fn ty(in tmap: ChunkSeq[u32], index: u64) -> u32 {
    u32_at(in tmap, index)
}

// An index + 1 word (0 for none) as an index or NONE32.
fn opt(word: u64) -> u32 {
    if word == 0 {
        NONE32
    } else {
        n32(wrapping_sub(word, 1))
    }
}

// Decodes the fip task section: the pool, the expressions, the patterns
// and the functions. Names in pool words are tagged by the node kind that
// owns them and mapped here, so the checker sees symbols and type ids.
pub fn read_ast(
    inout reader: Reader,
    in bytes: Slice[u8],
    in nmap: ChunkSeq[u32],
    in tmap: ChunkSeq[u32]
) -> Ast {
    let pool_len = reader.word(in bytes);
    let mut pool: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](pool_len);
    for i in 0..pool_len {
        // 0: an index; 1: a name; 2: a type.
        let tag = reader.word(in bytes);
        let value = reader.word(in bytes);
        if tag == 1 {
            pool.push(sym(in nmap, value));
        } else if tag == 2 {
            pool.push(ty(in tmap, value));
        } else {
            pool.push(n32(value));
        }
    }
    let expr_count = reader.word(in bytes);
    let mut exprs: ChunkSeq[ExprRow] = ChunkSeq::with_capacity[ExprRow](expr_count);
    for i in 0..expr_count {
        let kind = wrapping_u8(reader.word(in bytes));
        let start = reader.word(in bytes);
        let end = reader.word(in bytes);
        let mut a = n32(reader.word(in bytes));
        let bb = n32(reader.word(in bytes));
        let c = n32(reader.word(in bytes));
        let d = n32(reader.word(in bytes));
        let e = n32(reader.word(in bytes));
        // Name fields: Name a, Field b, Handle a.
        if kind == 2 || kind == 16 {
            a = sym(in nmap, w(a));
        }
        let mapped_b = if kind == 7 { sym(in nmap, w(bb)) } else { bb };
        exprs.push(
            ExprRow { kind: kind, start: start, end: end, a: a, b: mapped_b, c: c, d: d, e: e }
        );
    }
    let pat_count = reader.word(in bytes);
    let mut pats: ChunkSeq[PatRow] = ChunkSeq::with_capacity[PatRow](pat_count);
    for i in 0..pat_count {
        let kind = wrapping_u8(reader.word(in bytes));
        let start = reader.word(in bytes);
        let end = reader.word(in bytes);
        let mut a = n32(reader.word(in bytes));
        let bb = n32(reader.word(in bytes));
        let c = n32(reader.word(in bytes));
        if kind == 2 || kind == 5 {
            a = sym(in nmap, w(a));
        }
        pats.push(PatRow { kind: kind, start: start, end: end, a: a, b: bb, c: c });
    }
    let fn_count = reader.word(in bytes);
    let mut fns: ChunkSeq[FnRow] = ChunkSeq::with_capacity[FnRow](fn_count);
    let mut generics: ChunkSeq[GenRow] = ChunkSeq::new[GenRow]();
    let mut params: ChunkSeq[ParamRow] = ChunkSeq::new[ParamRow]();
    let mut fn_by_name: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..fn_count {
        let name = sym(in nmap, reader.word(in bytes));
        let fip = reader.word(in bytes) != 0;
        let start = reader.word(in bytes);
        let end = reader.word(in bytes);
        let generic_count = reader.word(in bytes);
        let generic_start = n32(generics.len());
        for j in 0..generic_count {
            let generic_name = sym(in nmap, reader.word(in bytes));
            let is_row = reader.word(in bytes) != 0;
            generics.push(GenRow { name: generic_name, is_row: is_row });
        }
        let param_count = reader.word(in bytes);
        let param_start = n32(params.len());
        for j in 0..param_count {
            let param_name = sym(in nmap, reader.word(in bytes));
            let pass = wrapping_u8(reader.word(in bytes));
            let param_ty = ty(in tmap, reader.word(in bytes));
            let param_span_start = reader.word(in bytes);
            let param_span_end = reader.word(in bytes);
            params.push(
                ParamRow {
                    name: param_name,
                    pass: pass,
                    ty: param_ty,
                    start: param_span_start,
                    end: param_span_end
                }
            );
        }
        let result = ty(in tmap, reader.word(in bytes));
        let effects = ty(in tmap, reader.word(in bytes));
        let body = opt(reader.word(in bytes));
        set_index(inout fn_by_name, name, wrapping_add(n32(i), 1));
        fns.push(
            FnRow {
                name: name,
                fip: fip,
                start: start,
                end: end,
                generic_start: generic_start,
                generic_count: n32(generic_count),
                param_start: param_start,
                param_count: n32(param_count),
                result: result,
                effects: effects,
                body: body
            }
        );
    }
    Ast {
        pool: pool,
        exprs: exprs,
        pats: pats,
        fns: fns,
        generics: generics,
        params: params,
        fn_by_name: fn_by_name
    }
}
