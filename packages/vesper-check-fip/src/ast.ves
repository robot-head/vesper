// The part of the surface AST the fip checks read: the bodies of the
// world's functions as flat node tables, decoded from the harness input
// (`FipEnc` in tests/self_host_check_fip.rs). A node names its children by
// index and a list of children is a run of `pool` words, as in @vesper/ast.
// Names are check-data symbols and types are check-data type ids.
//
// Expression kinds (`ExprKind`, numbered as in @vesper/ast):
//   1 Literal
//   2 Name     a = name
//   3 Tuple    pool[a..a+b] = items
//   4 Struct   pool[a..a+b] = field values
//   5 Block    pool[a..a+3b] = statements (pattern + 1 or 0, type, value),
//              c = tail + 1 or 0
//   6 Call     a = callee, pool[b..b+2c] = arguments (pass, expr)
//   7 Field    a = base, b = name
//   8 Index    a, b
//   9 Try      a
//  10 Unary    a
//  11 Binary   a, b; c = 1 for `&&` and `||`
//  12 Assign   a = place, b = value
//  13 If       a = condition, b = then, c = otherwise + 1 or 0
//  14 Match    a = value, pool[b..b+2c] = arms (pattern, body)
//  15 Closure  a = body
//  16 Handle   a = effect name, b = state pattern + 1 or 0, c = state
//              value, d = body, pool[e..] = clause count, then per clause
//              (the return clause first) body, pattern count, patterns
//  17 Loop, 18 For, 19 Range, 20 Break, 21 Return, 22 Continue:
//              pool[a..a+b] = `control_children`
//
// Pattern kinds: 1 Wild, 2 Bind (a = name), 3 Literal, 4 Tuple
// (pool[a..a+b]), 5 Constructor (a = name, pool[b..b+2c] = (field name,
// pattern)).

use @vesper/check-data::util::{
    add,
    n32,
    u32_at,
    w
};
use @vesper/check-data::input::{
    Reader
};

pub copy struct ExprRow {
    kind: u8,
    start: u64,
    end: u64,
    a: u32,
    b: u32,
    c: u32,
    d: u32,
    e: u32,
}

pub copy struct PatRow {
    kind: u8,
    start: u64,
    end: u64,
    a: u32,
    b: u32,
    c: u32,
}

// A function of `world.functions` (in name order).
pub copy struct FnRow {
    name: u32,
    fip: bool,
    start: u64,
    end: u64,
    // generics[ga..ga+gn], params[pa..pa+pn]
    ga: u32,
    gn: u32,
    pa: u32,
    pn: u32,
    result: u32,
    // `Type::Row(f.effects)`
    effects: u32,
    // body expression, or NONE32
    body: u32,
}

pub copy struct GenRow {
    name: u32,
    row: bool,
}

pub copy struct ParamRow {
    name: u32,
    pass: u8,
    ty: u32,
    start: u64,
    end: u64,
}

pub struct Ast {
    pool: ChunkSeq[u32],
    exprs: ChunkSeq[ExprRow],
    pats: ChunkSeq[PatRow],
    fns: ChunkSeq[FnRow],
    generics: ChunkSeq[GenRow],
    params: ChunkSeq[ParamRow],
    // symbol -> function index + 1
    fn_by_name: ChunkSeq[u32],
}

const NONE32: u32 = 4294967295;

const NO_EXPR: ExprRow = ExprRow {
    kind: 0,
    start: 0,
    end: 0,
    a: 0,
    b: 0,
    c: 0,
    d: 0,
    e: 0
};

const NO_PAT: PatRow = PatRow {
    kind: 0,
    start: 0,
    end: 0,
    a: 0,
    b: 0,
    c: 0
};

const NO_FN: FnRow = FnRow {
    name: 0,
    fip: false,
    start: 0,
    end: 0,
    ga: 0,
    gn: 0,
    pa: 0,
    pn: 0,
    result: 0,
    effects: 0,
    body: NONE32
};

impl Ast {
    pub fn expr(in self, e: u32) -> ExprRow {
        match self.exprs.try_get(w(e)) {
            Option::Some(x) => x,
            Option::None => NO_EXPR,
        }
    }

    pub fn pat(in self, p: u32) -> PatRow {
        match self.pats.try_get(w(p)) {
            Option::Some(x) => x,
            Option::None => NO_PAT,
        }
    }

    pub fn func(in self, f: u32) -> FnRow {
        match self.fns.try_get(w(f)) {
            Option::Some(x) => x,
            Option::None => NO_FN,
        }
    }

    pub fn generic(in self, i: u64) -> GenRow {
        match self.generics.try_get(i) {
            Option::Some(x) => x,
            Option::None => GenRow {
                name: 0,
                row: false
            },
        }
    }

    pub fn param(in self, i: u64) -> ParamRow {
        match self.params.try_get(i) {
            Option::Some(x) => x,
            Option::None => ParamRow {
                name: 0,
                pass: 0,
                ty: 0,
                start: 0,
                end: 0
            },
        }
    }

    // Word `i` of the list pool.
    pub fn at(in self, i: u64) -> u32 {
        u32_at(in self.pool, i)
    }

    // `world.functions.get(name)`: the function index, or NONE32.
    pub fn fn_named(in self, name: u32) -> u32 {
        if name == NONE32 {
            return NONE32;
        }
        let x = u32_at(in self.fn_by_name, w(name));
        if x == 0 {
            NONE32
        } else {
            wrapping_sub(x, 1)
        }
    }
}

fn set_index(inout table: ChunkSeq[u32], name: u32, v: u32) {
    loop {
        if table.len() > w(name) {
            break;
        }
        table.push(0);
    }
    let ok = table.try_set(w(name), v);
}

fn sym(in nmap: ChunkSeq[u32], x: u64) -> u32 {
    u32_at(in nmap, x)
}

fn ty(in tmap: ChunkSeq[u32], x: u64) -> u32 {
    u32_at(in tmap, x)
}

// An index + 1 word (0 for none) as an index or NONE32.
fn opt(x: u64) -> u32 {
    if x == 0 {
        NONE32
    } else {
        n32(wrapping_sub(x, 1))
    }
}

// Decodes the fip task section: the pool, the expressions, the patterns
// and the functions. Names in pool words are tagged by the node kind that
// owns them and mapped here, so the checker sees symbols and type ids.
pub fn read_ast(inout r: Reader, in b: Slice[u8], in nmap: ChunkSeq[u32], in tmap: ChunkSeq[u32])
    -> Ast {
    let pn = r.word(in b);
    let mut pool: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](pn);
    for i in 0..pn {
        // 0: an index; 1: a name; 2: a type.
        let tag = r.word(in b);
        let x = r.word(in b);
        if tag == 1 {
            pool.push(sym(in nmap, x));
        } else if tag == 2 {
            pool.push(ty(in tmap, x));
        } else {
            pool.push(n32(x));
        }
    }
    let en = r.word(in b);
    let mut exprs: ChunkSeq[ExprRow] = ChunkSeq::with_capacity[ExprRow](en);
    for i in 0..en {
        let kind = wrapping_u8(r.word(in b));
        let start = r.word(in b);
        let end = r.word(in b);
        let mut a = n32(r.word(in b));
        let bb = n32(r.word(in b));
        let c = n32(r.word(in b));
        let d = n32(r.word(in b));
        let e = n32(r.word(in b));
        // Name fields: Name a, Field b, Handle a.
        if kind == 2 || kind == 16 {
            a = sym(in nmap, w(a));
        }
        let b2 = if kind == 7 {
            sym(in nmap, w(bb))
        } else {
            bb
        };
        exprs
            .push(
                ExprRow {
                    kind: kind,
                    start: start,
                    end: end,
                    a: a,
                    b: b2,
                    c: c,
                    d: d,
                    e: e
                }
            );
    }
    let qn = r.word(in b);
    let mut pats: ChunkSeq[PatRow] = ChunkSeq::with_capacity[PatRow](qn);
    for i in 0..qn {
        let kind = wrapping_u8(r.word(in b));
        let start = r.word(in b);
        let end = r.word(in b);
        let mut a = n32(r.word(in b));
        let bb = n32(r.word(in b));
        let c = n32(r.word(in b));
        if kind == 2 || kind == 5 {
            a = sym(in nmap, w(a));
        }
        pats
            .push(
                PatRow {
                    kind: kind,
                    start: start,
                    end: end,
                    a: a,
                    b: bb,
                    c: c
                }
            );
    }
    let fnn = r.word(in b);
    let mut fns: ChunkSeq[FnRow] = ChunkSeq::with_capacity[FnRow](fnn);
    let mut generics: ChunkSeq[GenRow] = ChunkSeq::new[GenRow]();
    let mut params: ChunkSeq[ParamRow] = ChunkSeq::new[ParamRow]();
    let mut by_name: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..fnn {
        let name = sym(in nmap, r.word(in b));
        let fip = r.word(in b) != 0;
        let start = r.word(in b);
        let end = r.word(in b);
        let gn = r.word(in b);
        let ga = n32(generics.len());
        for j in 0..gn {
            let g = sym(in nmap, r.word(in b));
            let row = r.word(in b) != 0;
            generics
                .push(
                    GenRow {
                        name: g,
                        row: row
                    }
                );
        }
        let qn2 = r.word(in b);
        let pa = n32(params.len());
        for j in 0..qn2 {
            let pname = sym(in nmap, r.word(in b));
            let pass = wrapping_u8(r.word(in b));
            let pty = ty(in tmap, r.word(in b));
            let ps = r.word(in b);
            let pe = r.word(in b);
            params
                .push(
                    ParamRow {
                        name: pname,
                        pass: pass,
                        ty: pty,
                        start: ps,
                        end: pe
                    }
                );
        }
        let result = ty(in tmap, r.word(in b));
        let effects = ty(in tmap, r.word(in b));
        let body = opt(r.word(in b));
        set_index(inout by_name, name, wrapping_add(n32(i), 1));
        fns
            .push(
                FnRow {
                    name: name,
                    fip: fip,
                    start: start,
                    end: end,
                    ga: ga,
                    gn: n32(gn),
                    pa: pa,
                    pn: n32(qn2),
                    result: result,
                    effects: effects,
                    body: body
                }
            );
    }
    Ast {
        pool: pool,
        exprs: exprs,
        pats: pats,
        fns: fns,
        generics: generics,
        params: params,
        fn_by_name: by_name
    }
}
