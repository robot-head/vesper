// The built-in secret operations a module uses, as the checker's secret
// prelude generates them (`capability_effects::secret_prelude`): methods
// of the declared secret scalars and two free functions, the same Vesper
// text byte for byte.

use @vesper/ast::{
    Ast, AdtNode, FieldNode, FnNode, ImplNode, ItemNode, VariantNode, list_at, list_len, none,
    type_at, type_name
};
use @vesper-std/arena::{idx_from_raw};
use @vesper-std/intern::{Interner, interner_new, symbol_from_id};
use self::prelude::{Uses, used};

fn x_item(in a: Ast, i: u32) -> ItemNode {
    a.items.get_or(idx_from_raw[ItemNode](i), ItemNode { kind: 0, node: none() })
}

fn x_fn_name(in a: Ast, i: u32) -> u32 {
    a.fns
        .get_or(
            idx_from_raw[FnNode](i),
            FnNode {
                name: none(),
                fip: false,
                generics: 0,
                params: 0,
                result: none(),
                effects: none(),
                body: none(),
                start: 0,
                end: 0
            }
        )
        .name
}

fn text_of(in a: Ast, sym: u32) -> String {
    let mut t = String::new();
    if sym != none() {
        let ok = a.names.resolve_into(symbol_from_id(sym), inout t);
    }
    t
}

fn is(in a: Ast, sym: u32, in lit: Str) -> bool {
    sym != none() && a.names.symbol_eq(symbol_from_id(sym), in lit)
}

// `secret_scalar`: the field name of the declared `copy struct <name> {
// <field>: <payload> }`, or empty when there is none.
fn scalar_field(in a: Ast, in name: Str, in payload: Str) -> String {
    for i in 0..a.m_items.len() {
        let it = match a.m_items.try_get(i) {
            Option::Some(v) => x_item(in a, v),
            Option::None => ItemNode { kind: 0, node: none() },
        };
        if it.kind != 1 {
            continue;
        }
        let n = a.adts.get_or(
            idx_from_raw[AdtNode](it.node),
            AdtNode {
                name: none(),
                mode: 0,
                generics: 0,
                variants: 0,
                is_enum: false,
                tiled: false,
                tile_width: 0,
                start: 0,
                end: 0
            }
        );
        if !is(in a, n.name, name)
            || n.mode != 0
            || list_len(in a, n.generics) != 0
            || n.is_enum
            || list_len(in a, n.variants) != 1 {
            continue;
        }
        let v = a.variants.get_or(
            idx_from_raw[VariantNode](list_at(in a, n.variants, 0)),
            VariantNode { name: none(), fields: 0, named: false }
        );
        if !v.named || list_len(in a, v.fields) != 1 {
            continue;
        }
        let f = a.fields.get_or(
            idx_from_raw[FieldNode](list_at(in a, v.fields, 0)),
            FieldNode { name: none(), ty: none(), modality: 3, temperature: 0 }
        );
        if f.ty == none() {
            continue;
        }
        let t = type_at(in a, f.ty);
        if t.kind == 1 && is(in a, t.a, payload) && list_len(in a, t.b) == 0 {
            // The first such declaration (`find_map`).
            return text_of(in a, f.name);
        }
    }
    String::new()
}

// The names a module defines: its functions, and `T::m` for its `impl`
// methods.
fn defined_names(in a: Ast) -> Interner {
    let mut d = interner_new();
    for i in 0..a.m_items.len() {
        let it = match a.m_items.try_get(i) {
            Option::Some(v) => x_item(in a, v),
            Option::None => ItemNode { kind: 0, node: none() },
        };
        if it.kind == 2 {
            let t = text_of(in a, x_fn_name(in a, it.node));
            let s = d.intern(in t.as_str());
        } else if it.kind == 4 {
            let b = a.impls.get_or(
                idx_from_raw[ImplNode](it.node),
                ImplNode { ty: none(), generics: 0, methods: 0 }
            );
            let ty = type_name(in a, b.ty);
            for j in 0..list_len(in a, b.methods) {
                let mut key = text_of(in a, ty);
                key.push_str(in "::");
                let m = text_of(in a, x_fn_name(in a, list_at(in a, b.methods, j)));
                key.push_str(in m.as_str());
                let s = d.intern(in key.as_str());
            }
        }
    }
    d
}

struct Gen {
    out: String,
    defined: Interner
}

fn put(inout s: String, in t: Str) {
    s.push_str(in t);
}

fn put_num(inout s: String, v: u64) {
    if v >= 10 {
        put_num(inout s, v / 10);
    }
    s.push_char(wrapping_u32(wrapping_add(48, v % 10)));
}

// `emit`: the operation `name` (of `owner`, or free when `owner` is
// empty) when the module mentions it and does not define it.
fn emit(inout g: Gen, in u: Uses, in owner: Str, in name: Str, in text: String) {
    let mut full = String::new();
    if owner.as_bytes().len() > 0 {
        full.push_str(in owner);
        full.push_str(in "::");
    }
    full.push_str(in name);
    let d = match g.defined.lookup(in full.as_str()) {
        Option::Some(s) => true,
        Option::None => false,
    };
    if !used(in u, name) || d {
        return;
    }
    if owner.as_bytes().len() > 0 {
        put(inout g.out, "impl ");
        put(inout g.out, owner);
        put(inout g.out, " { ");
        put(inout g.out, text.as_str());
        put(inout g.out, " }\n");
    } else {
        put(inout g.out, text.as_str());
        put(inout g.out, "\n");
    }
}

fn op_name(i: u64) -> Str {
    if i == 0 {
        "bit_and"
    } else if i == 1 {
        "bit_or"
    } else if i == 2 {
        "bit_xor"
    } else if i == 3 {
        "wrapping_add"
    } else if i == 4 {
        "wrapping_sub"
    } else {
        "wrapping_mul"
    }
}

fn scalar_name(i: u64) -> Str {
    if i == 0 {
        "SecU8"
    } else if i == 1 {
        "SecU32"
    } else if i == 2 {
        "SecU64"
    } else {
        "SecMask64"
    }
}

fn payload_name(i: u64) -> Str {
    if i == 0 {
        "u8"
    } else if i == 1 {
        "u32"
    } else {
        "u64"
    }
}

// `SecMask64 { m: wrapping_sub(bit_shr(bit_or(x, wrapping_sub(0, x)), 63), 1) }`.
fn zero(inout s: String, in m: Str) {
    put(inout s, "SecMask64 { ");
    put(inout s, m);
    put(inout s, ": wrapping_sub(bit_shr(bit_or(x, wrapping_sub(0, x)), 63), 1) }");
}

// The operations of secret scalar `t` (field `f`); `mask` is the
// `SecMask64` field, empty when there is none.
fn scalar_ops(inout g: Gen, in u: Uses, in t: Str, in f: Str, is_mask: bool, in mask: Str) {
    let has_mask = mask.as_bytes().len() > 0;
    if f.as_bytes().len() == 0 {
        return;
    }
    let n_ops: u64 = if is_mask { 3 } else { 6 };
    for oi in 0..n_ops {
        let op = op_name(oi);
        let mut text = String::new();
        put(inout text, "fn ");
        put(inout text, op);
        put(inout text, "(self, other: ");
        put(inout text, t);
        put(inout text, ") -> ");
        put(inout text, t);
        put(inout text, " eff [ConstTime] { let ");
        put(inout text, t);
        put(inout text, " { ");
        put(inout text, f);
        put(inout text, ": a } = self; let ");
        put(inout text, t);
        put(inout text, " { ");
        put(inout text, f);
        put(inout text, ": b } = other; ");
        put(inout text, t);
        put(inout text, " { ");
        put(inout text, f);
        put(inout text, ": ");
        put(inout text, op);
        put(inout text, "(a, b) } }");
        emit(inout g, in u, t, op, in text);
    }
    if has_mask && !is_mask {
        let mut text = String::new();
        put(inout text, "fn ct_is_zero(self) -> SecMask64 eff [ConstTime] { let ");
        put(inout text, t);
        put(inout text, " { ");
        put(inout text, f);
        put(inout text, ": a } = self; let x: u64 = widen_u64(a); ");
        zero(inout text, mask);
        put(inout text, " }");
        emit(inout g, in u, t, "ct_is_zero", in text);
        let mut text2 = String::new();
        put(inout text2, "fn ct_eq(self, other: ");
        put(inout text2, t);
        put(inout text2, ") -> SecMask64 eff [ConstTime] { let ");
        put(inout text2, t);
        put(inout text2, " { ");
        put(inout text2, f);
        put(inout text2, ": a } = self; let ");
        put(inout text2, t);
        put(inout text2, " { ");
        put(inout text2, f);
        put(inout text2, ": b } = other; let x: u64 = widen_u64(bit_xor(a, b)); ");
        zero(inout text2, mask);
        put(inout text2, " }");
        emit(inout g, in u, t, "ct_eq", in text2);
    }
}

// The secret prelude's source for a module with uses `u`.
pub fn secret_source(in u: Uses, in a: Ast) -> String {
    let mut g = Gen { out: String::new(), defined: defined_names(in a) };
    let f0 = scalar_field(in a, "SecU8", "u8");
    let f1 = scalar_field(in a, "SecU32", "u32");
    let f2 = scalar_field(in a, "SecU64", "u64");
    let mask = scalar_field(in a, "SecMask64", "u64");
    let has_mask = mask.len() > 0;
    scalar_ops(inout g, in u, "SecU8", in f0.as_str(), false, in mask.as_str());
    scalar_ops(inout g, in u, "SecU32", in f1.as_str(), false, in mask.as_str());
    scalar_ops(inout g, in u, "SecU64", in f2.as_str(), false, in mask.as_str());
    scalar_ops(inout g, in u, "SecMask64", in mask.as_str(), true, in mask.as_str());
    if has_mask {
        let mut text = String::new();
        put(inout text, "fn ct_not(self) -> SecMask64 eff [ConstTime] { let SecMask64 { ");
        put(inout text, mask.as_str());
        put(inout text, ": a } = self; SecMask64 { ");
        put(inout text, mask.as_str());
        put(inout text, ": bit_xor(a, 18446744073709551615) } }");
        emit(inout g, in u, "SecMask64", "ct_not", in text);
        let mut text2 = String::new();
        put(inout text2, "fn declassify_bool(self) -> bool eff [ConstTime] { let SecMask64 { ");
        put(inout text2, mask.as_str());
        put(inout text2, ": a } = self; a != 0 }");
        emit(inout g, in u, "SecMask64", "declassify_bool", in text2);
        if f2.len() > 0 {
            let mut body = String::new();
            put(inout body, " { let SecMask64 { ");
            put(inout body, mask.as_str());
            put(inout body, ": k } = ");
            let mut rest = String::new();
            put(inout rest, "; let SecU64 { ");
            put(inout rest, f2.as_str());
            put(inout rest, ": x } = a; let SecU64 { ");
            put(inout rest, f2.as_str());
            put(inout rest, ": y } = b; SecU64 { ");
            put(inout rest, f2.as_str());
            put(inout rest, ": bit_xor(y, bit_and(k, bit_xor(x, y))) } }");
            let mut text3 = String::new();
            put(inout text3, "fn ct_select(self, a: SecU64, b: SecU64) -> SecU64 eff [ConstTime]");
            put(inout text3, body.as_str());
            put(inout text3, "self");
            put(inout text3, rest.as_str());
            emit(inout g, in u, "SecMask64", "ct_select", in text3);
            let mut text4 = String::new();
            put(
                inout text4,
                "fn ct_select(mask: SecMask64, a: SecU64, b: SecU64) -> SecU64 eff [ConstTime]"
            );
            put(inout text4, body.as_str());
            put(inout text4, "mask");
            put(inout text4, rest.as_str());
            emit(inout g, in u, "", "ct_select", in text4);
        }
    }
    if f2.len() > 0 {
        let mut sum = String::new();
        put(inout sum, "widen_u64(b0)");
        for i in 1..8 {
            let mut next = String::new();
            put(inout next, "bit_or(");
            put(inout next, sum.as_str());
            put(inout next, ", bit_shl(widen_u64(b");
            put_num(inout next, i);
            put(inout next, "), ");
            put_num(inout next, wrapping_mul(8, i));
            put(inout next, "))");
            sum = next;
        }
        let mut text = String::new();
        put(
            inout text,
            "fn load_sec_u64le(bytes: (u8, u8, u8, u8, u8, u8, u8, u8)) -> SecU64 eff [ConstTime] { let (b0, b1, b2, b3, b4, b5, b6, b7) = bytes; SecU64 { "
        );
        put(inout text, f2.as_str());
        put(inout text, ": ");
        put(inout text, sum.as_str());
        put(inout text, " } }");
        emit(inout g, in u, "", "load_sec_u64le", in text);
    }
    g.out
}
