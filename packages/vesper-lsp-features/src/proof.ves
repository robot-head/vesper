// `proof_model` (src/lsp/proof_model.rs) in Vesper: the per-function
// scalar model a proof lens states its theorem about. Each model is built
// from the checked function's tree (@vesper/ast), with the kinds the
// checker computed (`Checked::expression_types`, in @vesper/check-data's
// harness layout). lean.ves renders the two Lean modules.
//
// The checker's functions come in `World::functions` order: name, span and
// whether there is a body. Their trees are parsed from one text: the source,
// then each prelude the checker added (String, Atomic, ...). A function's
// `delta` is where its own text starts, so its expression spans are looked
// up where the checker recorded them.

use @vesper/ast::{
    Ast, ExprNode, PatNode, StmtNode, ArgNode, ParamNode, FnNode, ImplNode, ItemNode, TypeNode,
    EffectsNode, EffectNode, Lit, list_len, list_at, expr_at, pat_at, lit_at
};
use @vesper/ast::lower::{lower_source};
use @vesper/check-data::input::{Ctx, Reader as CtxReader, read_ctx};
use @vesper-std/arena::{idx_from_raw};
use @vesper-std/intern::{symbol_from_id};
use @vesper-std/hash::blake3::{blake3, digest_bytes};
use self::json::{pack};
use self::nav::{arg_at, fn_at, impl_at, item_at, param_at, put_name, put_u, stmt_at, w};
use self::proof_types::{
    Syms, syms, ty_at, effects_at, effect_at, kind_of_type, is_infer, display, param_type
};
use self::lean::{
    Tm, tm_new, tm_clear, term, int_term, kind_of, integer, kind_name, exact, bitvec, s, sb, K_U8,
    K_U32, K_U64, K_I64, K_BOOL, K_UNIT, K_NONE, TM_VAR, TM_BOOL, TM_UNIT, TM_ARITH, TM_DIV, TM_NEG,
    TM_NOT, TM_CMP, TM_AND, TM_OR, TM_ITE, TM_LET, OP_ADD, OP_SUB, OP_MUL, CMP_EQ, CMP_NE, CMP_LT,
    CMP_LE, CMP_GT, CMP_GE
};

const NONE: u32 = 4294967295;

const MAX_NODES: u64 = 4096;
const MAX_INLINE_DEPTH: u64 = 8;
const MAX_PARAMS: u64 = 16;
const MAX_MODELS: u64 = 256;

// @vesper/ast kinds.
const E_LIT: u8 = 1;
const E_NAME: u8 = 2;
const E_TUPLE: u8 = 3;
const E_STRUCT: u8 = 4;
const E_BLOCK: u8 = 5;
const E_CALL: u8 = 6;
const E_FIELD: u8 = 7;
const E_INDEX: u8 = 8;
const E_TRY: u8 = 9;
const E_UNARY: u8 = 10;
const E_BINARY: u8 = 11;
const E_ASSIGN: u8 = 12;
const E_IF: u8 = 13;
const E_MATCH: u8 = 14;
const E_CLOSURE: u8 = 15;
const E_HANDLE: u8 = 16;
const E_LOOP: u8 = 17;
const E_FOR: u8 = 18;
const E_RANGE: u8 = 19;
const E_BREAK: u8 = 20;
const E_RETURN: u8 = 21;
const E_CONTINUE: u8 = 22;
const LIT_INT: u8 = 1;
const LIT_BOOL: u8 = 3;
const P_BIND: u8 = 2;
const S_LET: u8 = 1;
const AT_NAMED: u8 = 1;
const AT_TUPLE: u8 = 2;
const AT_FUNCTION: u8 = 3;
const AT_ROW: u8 = 4;
const AT_INFER: u8 = 5;
const AT_INT_LITERAL: u8 = 6;
const ITEM_FUNCTION: u8 = 2;
const ITEM_IMPL: u8 = 4;

// Check-data type kinds (`TyKind`).
const CT_NAMED: u8 = 1;
const CT_TUPLE: u8 = 2;

// The checker's functions: name symbol, tree (`FnNode`, and the `impl`
// whose method it is, or NONE), text start and body flag.
struct Wt {
    sym: ChunkSeq[u32],
    node: ChunkSeq[u32],
    owner_impl: ChunkSeq[u32],
    delta: ChunkSeq[u64],
    body: ChunkSeq[u8],
    // Symbol id -> function index (NONE for other names).
    by_sym: ChunkSeq[u32]
}

fn g32(in column: ChunkSeq[u32], i: u64) -> u32 {
    column.try_get(i).unwrap_or(NONE)
}

fn g64(in column: ChunkSeq[u64], i: u64) -> u64 {
    column.try_get(i).unwrap_or(0)
}

fn g8(in column: ChunkSeq[u8], i: u64) -> u8 {
    column.try_get(i).unwrap_or(0)
}

// A lexical scope (`Scope`): bindings in order, each with its frame.
struct Sc {
    sym: ChunkSeq[u32],
    var: ChunkSeq[u32],
    frame: ChunkSeq[u32],
    frames: u64
}

fn sc_new() -> Sc {
    Sc {
        sym: ChunkSeq::new[u32](),
        var: ChunkSeq::new[u32](),
        frame: ChunkSeq::new[u32](),
        frames: 0
    }
}

fn sc_bind(inout scope: Sc, name: u32, var: u32) {
    if scope.frames == 0 {
        scope.frames = 1;
    }
    scope.sym.push(name);
    scope.var.push(var);
    scope.frame.push(wrapping_u32(wrapping_sub(scope.frames, 1)));
}

fn sc_push(inout scope: Sc) {
    scope.frames = wrapping_add(scope.frames, 1);
}

fn sc_pop(inout scope: Sc) {
    let top = wrapping_u32(wrapping_sub(scope.frames, 1));
    loop {
        let len = scope.sym.len();
        if len == 0 || g32(in scope.frame, wrapping_sub(len, 1)) != top {
            break;
        }
        let popped_sym = scope.sym.pop();
        let popped_var = scope.var.pop();
        let popped_frame = scope.frame.pop();
    }
    scope.frames = wrapping_sub(scope.frames, 1);
}

// The innermost binding of `name`: var << 32 | frame, or NONE64.
fn sc_lookup(in scope: Sc, name: u32) -> u64 {
    let mut i = scope.sym.len();
    loop {
        if i == 0 {
            return 18446744073709551615;
        }
        i = wrapping_sub(i, 1);
        if g32(in scope.sym, i) == name {
            return wrapping_shl_u64(widen_u64(g32(in scope.var, i)), 32)
                | widen_u64(g32(in scope.frame, i));
        }
    }
}

// The scope as a mark: its length and frame count.
fn sc_mark(in scope: Sc) -> u64 {
    wrapping_shl_u64(scope.sym.len(), 32) | scope.frames
}

fn sc_reset(inout scope: Sc, mark: u64) {
    let keep_len = wrapping_shr_u64(mark, 32);
    loop {
        if scope.sym.len() <= keep_len {
            break;
        }
        let popped_sym = scope.sym.pop();
        let popped_var = scope.var.pop();
        let popped_frame = scope.frame.pop();
    }
    scope.frames = mark & 4294967295;
}

// The builder (`Builder`): the model, its node count, the inlining stack,
// the text start of the function being walked, and the first error.
struct B {
    terms: Tm,
    nodes: u64,
    stack: ChunkSeq[u32],
    delta: u64,
    err: ChunkSeq[u8],
    failed: bool,
    // Check-data type id -> model kind + 1 (0 not yet computed).
    memo: ChunkSeq[u8],
    hash: bool
}

fn fail(inout builder: B) -> u32 {
    builder.failed = true;
    NONE
}

fn fail_s(inout builder: B, in message: Str) -> u32 {
    builder.err.clear();
    s(inout builder.err, in message);
    fail(inout builder)
}

// `unsupported(what)`.
fn unsupported(inout builder: B, in what: Str) -> u32 {
    builder.err.clear();
    s(inout builder.err, in what);
    s(inout builder.err, in " is outside the scalar model");
    fail(inout builder)
}

fn quoted(inout builder: B, in ast: Ast, in pre: Str, name: u32, in post: Str) -> u32 {
    builder.err.clear();
    s(inout builder.err, in pre);
    put_name(inout builder.err, in ast, name);
    s(inout builder.err, in post);
    fail(inout builder)
}

// The kind the checker gave expression `expr_id` (`Builder::kind_at`).
fn kind_at(inout builder: B, in ast: Ast, in ctx: Ctx, in symbols: Syms, expr_id: u32) -> u8 {
    let node = expr_at(in ast, expr_id);
    let ty = ctx.world.expr_type(
        wrapping_sub(widen_u64(node.start), builder.delta),
        wrapping_sub(widen_u64(node.end), builder.delta)
    );
    if ty == NONE {
        return K_NONE;
    }
    let cached = g8(in builder.memo, widen_u64(ty));
    if cached != 0 {
        return wrapping_sub(cached, 1);
    }
    let ty_node = ctx.types.node(ty);
    let mut kind = K_NONE;
    if ty_node.kind == CT_NAMED && ty_node.n == 0 {
        if ctx.names.spells(ty_node.name, in "u8".as_bytes()) {
            kind = K_U8;
        } else if ctx.names.spells(ty_node.name, in "u32".as_bytes()) {
            kind = K_U32;
        } else if ctx.names.spells(ty_node.name, in "u64".as_bytes()) {
            kind = K_U64;
        } else if ctx.names.spells(ty_node.name, in "i64".as_bytes()) {
            kind = K_I64;
        } else if ctx.names.spells(ty_node.name, in "bool".as_bytes())
            || ctx.names.spells(ty_node.name, in "Bool".as_bytes())
        {
            kind = K_BOOL;
        } else if ctx.names.spells(ty_node.name, in "Unit".as_bytes()) {
            kind = K_UNIT;
        }
    } else if ty_node.kind == CT_TUPLE && ty_node.n == 0 {
        kind = K_UNIT;
    }
    loop {
        if builder.memo.len() > widen_u64(ty) {
            break;
        }
        builder.memo.push(0);
    }
    let ok = builder.memo.try_set(widen_u64(ty), wrapping_add(kind, 1));
    kind
}

// ------------------------------------------------------------ builder

// A function's signature (`Builder::signature`): the parameter kinds, the
// result kind and the body, or the reason in `builder.err`.
struct Sig {
    ok: bool,
    kinds: ChunkSeq[u8],
    result: u8,
    body: u32
}

fn sig_fail(inout builder: B) -> Sig {
    builder.failed = true;
    Sig { ok: false, kinds: ChunkSeq::new[u8](), result: K_NONE, body: NONE }
}

fn signature(
    inout builder: B,
    in ast: Ast,
    in symbols: Syms,
    in fn_table: Wt,
    fn_index: u64
) -> Sig {
    let node = g32(in fn_table.node, fn_index);
    let impl_id = g32(in fn_table.owner_impl, fn_index);
    if node == NONE {
        builder.err.clear();
        s(inout builder.err, in "?no tree");
        return sig_fail(inout builder);
    }
    let fn_node = fn_at(in ast, node);
    let mut generics = list_len(in ast, fn_node.generics);
    if impl_id != NONE {
        generics = wrapping_add(generics, list_len(in ast, impl_at(in ast, impl_id).generics));
    }
    if generics > 0 {
        let _ = fail_s(inout builder, in "generic functions have no scalar model");
        return sig_fail(inout builder);
    }
    let param_count = list_len(in ast, fn_node.params);
    if param_count > MAX_PARAMS {
        let _ = fail_s(inout builder, in "too many parameters for a scalar model");
        return sig_fail(inout builder);
    }
    let effects = effects_at(in ast, fn_node.effects);
    for i in 0..list_len(in ast, effects.instances) {
        let instance = effect_at(in ast, list_at(in ast, effects.instances, i));
        let mut allowed = instance.name == symbols.y_fail && instance.name != NONE;
        if allowed {
            for j in 0..list_len(in ast, instance.args) {
                let arg_ty = ty_at(in ast, list_at(in ast, instance.args, j));
                let name = if arg_ty.kind == AT_NAMED {
                    arg_ty.a
                } else {
                    NONE
                };
                if name == NONE || (name != symbols.y_overflow && name != symbols.y_runtime) {
                    allowed = false;
                }
            }
        }
        if !allowed {
            let _ = quoted(
                inout builder,
                in ast,
                in "effect '",
                instance.name,
                in "' is outside the scalar model (only Fail[ArithOverflow] and Fail[RuntimeError])"
            );
            return sig_fail(inout builder);
        }
    }
    if effects.tail != NONE {
        let _ = fail_s(inout builder, in "open effect rows are outside the scalar model");
        return sig_fail(inout builder);
    }
    let mut kinds = ChunkSeq::new[u8]();
    for i in 0..param_count {
        let param = param_at(in ast, list_at(in ast, fn_node.params, i));
        if param.pass != 0 || list_len(in ast, param.projections) != 0 {
            let _ = quoted(
                inout builder,
                in ast,
                in "parameter '",
                param.name,
                in "' is not an in-mode scalar parameter"
            );
            return sig_fail(inout builder);
        }
        let ty = param_type(in ast, in symbols, param, impl_id);
        let kind = kind_of_type(in ast, in symbols, ty);
        if kind == K_NONE || kind == K_UNIT {
            builder.err.clear();
            s(inout builder.err, in "parameter '");
            put_name(inout builder.err, in ast, param.name);
            s(inout builder.err, in "' has type ");
            display(inout builder.err, in ast, in symbols, ty);
            s(inout builder.err, in " outside the scalar model");
            return sig_fail(inout builder);
        }
        kinds.push(kind);
    }
    let mut result = K_UNIT;
    if !is_infer(in ast, fn_node.result) {
        result = kind_of_type(in ast, in symbols, fn_node.result);
        if result == K_NONE {
            builder.err.clear();
            s(inout builder.err, in "result type ");
            display(inout builder.err, in ast, in symbols, fn_node.result);
            s(inout builder.err, in " is outside the scalar model");
            return sig_fail(inout builder);
        }
    }
    if fn_node.body == NONE {
        let _ = fail_s(inout builder, in "the function has no body");
        return sig_fail(inout builder);
    }
    Sig { ok: true, kinds: kinds, result: result, body: fn_node.body }
}

fn charge(inout builder: B) -> bool {
    builder.nodes = wrapping_add(builder.nodes, 1);
    if builder.nodes > MAX_NODES {
        let _ = fail_s(inout builder, in "the model exceeds the Lens node budget");
        return false;
    }
    true
}

// A new variable; a parameter keeps its sanitized name.
fn var(inout builder: B, in ast: Ast, name: u32, kind: u8, param: bool) -> u32 {
    let name_at = builder.terms.pool.len();
    if param {
        let mut raw = ChunkSeq::new[u8]();
        put_name(inout raw, in ast, name);
        sanitize(inout builder.terms.pool, in raw);
    }
    builder.terms.var_name_at.push(name_at);
    builder.terms.var_name_len.push(wrapping_sub(builder.terms.pool.len(), name_at));
    builder.terms.var_kind.push(kind);
    builder.terms.var_param.push(if param { 1 } else { 0 });
    wrapping_u32(wrapping_sub(builder.terms.var_kind.len(), 1))
}

// `sanitize`: every char that is not ASCII alphanumeric becomes `_`.
fn sanitize(inout out: ChunkSeq[u8], in raw: ChunkSeq[u8]) {
    for i in 0..raw.len() {
        let c = g8(in raw, i);
        if (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) {
            out.push(c);
        } else if c < 128 || c >= 192 {
            out.push(95);
        }
    }
}

fn is_int_literal(in ast: Ast, expr_id: u32) -> bool {
    let node = expr_at(in ast, expr_id);
    node.kind == E_LIT && lit_at(in ast, node.a).kind == LIT_INT
}

// Whether `(neg, hi:lo)` lies in `kind`'s range.
fn fits(kind: u8, neg: bool, hi: u64, lo: u64) -> bool {
    if hi != 0 {
        return false;
    }
    if neg && lo != 0 {
        return kind == K_I64 && lo <= 9223372036854775808;
    }
    if kind == K_U8 {
        lo <= 255
    } else if kind == K_U32 {
        lo <= 4294967295
    } else if kind == K_I64 {
        lo <= 9223372036854775807
    } else {
        true
    }
}

// A 128-bit magnitude in decimal.
fn put_u128(inout out: ChunkSeq[u8], hi: u64, lo: u64) {
    if hi == 0 {
        put_u(inout out, lo);
        return;
    }
    // Four 32-bit limbs, most significant first; divide by 10 repeatedly.
    let mut l0 = wrapping_shr_u64(hi, 32);
    let mut l1 = hi & 4294967295;
    let mut l2 = wrapping_shr_u64(lo, 32);
    let mut l3 = lo & 4294967295;
    let mut digits = ChunkSeq::new[u8]();
    loop {
        if l0 == 0 && l1 == 0 && l2 == 0 && l3 == 0 {
            break;
        }
        let mut carry: u64 = 0;
        let x0 = wrapping_add(wrapping_shl_u64(carry, 32), l0);
        l0 = x0 / 10;
        carry = x0 % 10;
        let x1 = wrapping_add(wrapping_shl_u64(carry, 32), l1);
        l1 = x1 / 10;
        carry = x1 % 10;
        let x2 = wrapping_add(wrapping_shl_u64(carry, 32), l2);
        l2 = x2 / 10;
        carry = x2 % 10;
        let x3 = wrapping_add(wrapping_shl_u64(carry, 32), l3);
        l3 = x3 / 10;
        carry = x3 % 10;
        digits.push(wrapping_add(wrapping_u8(carry), 48));
    }
    let mut i = digits.len();
    loop {
        if i == 0 {
            break;
        }
        i = wrapping_sub(i, 1);
        out.push(g8(in digits, i));
    }
}

fn unit(inout builder: B) -> u32 {
    term(inout builder.terms, TM_UNIT, 0, 0, 0, K_UNIT, 0, 0)
}

fn expr(
    inout builder: B,
    inout scope: Sc,
    in ast: Ast,
    in ctx: Ctx,
    in symbols: Syms,
    in fn_table: Wt,
    expr_id: u32,
    want: u8
) -> u32 {
    if !charge(inout builder) {
        return NONE;
    }
    let node = expr_at(in ast, expr_id);
    let expr_kind = node.kind;
    if expr_kind == E_LIT {
        let literal = lit_at(in ast, node.a);
        if literal.kind == LIT_INT {
            let mut kind = kind_at(inout builder, in ast, in ctx, in symbols, expr_id);
            if !integer(kind) {
                kind = if integer(want) { want } else { K_I64 };
            }
            if !fits(kind, literal.neg, literal.hi, literal.bits) {
                builder.err.clear();
                s(inout builder.err, in "literal ");
                if literal.neg && (literal.hi != 0 || literal.bits != 0) {
                    builder.err.push(45);
                }
                put_u128(inout builder.err, literal.hi, literal.bits);
                s(inout builder.err, in " does not fit ");
                s(inout builder.err, in kind_name(kind));
                return fail(inout builder);
            }
            return int_term(inout builder.terms, literal.neg, literal.bits, kind);
        }
        if literal.kind == LIT_BOOL {
            return term(
                inout builder.terms,
                TM_BOOL,
                0,
                0,
                0,
                K_BOOL,
                0,
                if literal.bits != 0 { 1 } else { 0 }
            );
        }
        return unsupported(inout builder, in "a non-integer literal");
    }
    if expr_kind == E_TUPLE && list_len(in ast, node.a) == 0 {
        return unit(inout builder);
    }
    if expr_kind == E_NAME {
        let binding = sc_lookup(in scope, node.a);
        if binding == 18446744073709551615 {
            return quoted(inout builder, in ast, in "'", node.a, in "' is not a scalar local");
        }
        return term(
            inout builder.terms,
            TM_VAR,
            wrapping_u32(wrapping_shr_u64(binding, 32)),
            0,
            0,
            K_NONE,
            0,
            0
        );
    }
    if expr_kind == E_BLOCK {
        sc_push(inout scope);
        let result = block(
            inout builder,
            inout scope,
            in ast,
            in ctx,
            in symbols,
            in fn_table,
            node.a,
            0,
            node.b,
            want
        );
        sc_pop(inout scope);
        return result;
    }
    if expr_kind == E_IF {
        let cond = expr(
            inout builder,
            inout scope,
            in ast,
            in ctx,
            in symbols,
            in fn_table,
            node.a,
            K_BOOL
        );
        if cond == NONE {
            return NONE;
        }
        let mark = sc_mark(in scope);
        let then_term = expr(
            inout builder,
            inout scope,
            in ast,
            in ctx,
            in symbols,
            in fn_table,
            node.b,
            want
        );
        sc_reset(inout scope, mark);
        if then_term == NONE {
            return NONE;
        }
        let mut other = NONE;
        let mut kind = K_UNIT;
        if node.c != NONE {
            kind = kind_of(in builder.terms, then_term);
            other = expr(
                inout builder,
                inout scope,
                in ast,
                in ctx,
                in symbols,
                in fn_table,
                node.c,
                kind
            );
            sc_reset(inout scope, mark);
            if other == NONE {
                return NONE;
            }
        } else {
            other = unit(inout builder);
        }
        return term(inout builder.terms, TM_ITE, cond, then_term, other, kind, 0, 0);
    }
    if expr_kind == E_UNARY {
        let operand = expr(
            inout builder,
            inout scope,
            in ast,
            in ctx,
            in symbols,
            in fn_table,
            node.b,
            want
        );
        if operand == NONE {
            return NONE;
        }
        let kind = kind_of(in builder.terms, operand);
        if node.a == symbols.y_not && node.a != NONE && kind == K_BOOL {
            return term(inout builder.terms, TM_NOT, operand, 0, 0, K_BOOL, 0, 0);
        }
        if node.a == symbols.y_minus && node.a != NONE && integer(kind) {
            return term(inout builder.terms, TM_NEG, operand, 0, 0, kind, 0, 0);
        }
        builder.err.clear();
        s(inout builder.err, in "unary '");
        put_name(inout builder.err, in ast, node.a);
        s(inout builder.err, in "' on ");
        s(inout builder.err, in kind_name(kind));
        s(inout builder.err, in " is outside the scalar model");
        return fail(inout builder);
    }
    if expr_kind == E_BINARY {
        return binary(
            inout builder,
            inout scope,
            in ast,
            in ctx,
            in symbols,
            in fn_table,
            node.a,
            node.b,
            node.c
        );
    }
    if expr_kind == E_CALL {
        return call(
            inout builder,
            inout scope,
            in ast,
            in ctx,
            in symbols,
            in fn_table,
            expr_id,
            node,
            want
        );
    }
    if expr_kind == E_ASSIGN {
        return unsupported(inout builder, in "an assignment outside a block statement position");
    }
    if expr_kind == E_MATCH {
        return unsupported(inout builder, in "a match expression");
    }
    if expr_kind == E_HANDLE {
        return unsupported(inout builder, in "a handler");
    }
    if expr_kind == E_CLOSURE {
        return unsupported(inout builder, in "a closure");
    }
    if expr_kind == E_LOOP || expr_kind == E_FOR || expr_kind == E_RANGE {
        return unsupported(inout builder, in "a loop");
    }
    if expr_kind == E_BREAK || expr_kind == E_CONTINUE || expr_kind == E_RETURN {
        return unsupported(inout builder, in "an early exit");
    }
    if expr_kind == E_STRUCT || expr_kind == E_TUPLE {
        return unsupported(inout builder, in "an aggregate value");
    }
    if expr_kind == E_FIELD || expr_kind == E_INDEX {
        return unsupported(inout builder, in "a projection");
    }
    unsupported(inout builder, in "'?'")
}

fn call(
    inout builder: B,
    inout scope: Sc,
    in ast: Ast,
    in ctx: Ctx,
    in symbols: Syms,
    in fn_table: Wt,
    expr_id: u32,
    node: ExprNode,
    want: u8
) -> u32 {
    let callee = expr_at(in ast, node.a);
    if callee.kind != E_NAME {
        return unsupported(inout builder, in "a call through a function value");
    }
    let name = callee.a;
    if list_len(in ast, node.b) != 0 || sc_lookup(in scope, name) != 18446744073709551615 {
        return unsupported(inout builder, in "a generic or local function call");
    }
    let arg_count = list_len(in ast, node.c);
    for i in 0..arg_count {
        let arg = arg_at(in ast, list_at(in ast, node.c, i));
        if arg.explicit && arg.pass != 0 {
            return unsupported(inout builder, in "an inout or sink argument");
        }
    }
    let mut text = ChunkSeq::new[u8]();
    put_name(inout text, in ast, name);
    if starts_with(in text, in "wrapping_") {
        let op = if rest_is(in text, 9, in "add") {
            OP_ADD
        } else if rest_is(in text, 9, in "sub") {
            OP_SUB
        } else if rest_is(in text, 9, in "mul") {
            OP_MUL
        } else {
            255
        };
        if op == 255 {
            builder.err.clear();
            s(inout builder.err, in "intrinsic '");
            sb(inout builder.err, in text);
            s(inout builder.err, in "' is outside the scalar model");
            return fail(inout builder);
        }
        if arg_count != 2 {
            return unsupported(inout builder, in "a wrapping call without two arguments");
        }
        let mut kind = kind_at(inout builder, in ast, in ctx, in symbols, expr_id);
        if !integer(kind) {
            kind = want;
        }
        let lhs_expr = arg_at(in ast, list_at(in ast, node.c, 0)).expr;
        let rhs_expr = arg_at(in ast, list_at(in ast, node.c, 1)).expr;
        let mut lhs = NONE;
        let mut rhs = NONE;
        let arith_kind = operands(
            inout builder,
            inout scope,
            in ast,
            in ctx,
            in symbols,
            in fn_table,
            lhs_expr,
            rhs_expr,
            kind,
            inout lhs,
            inout rhs
        );
        if arith_kind == K_NONE {
            return NONE;
        }
        return term(inout builder.terms, TM_ARITH, lhs, rhs, 0, arith_kind, op, 0);
    }
    inline(inout builder, inout scope, in ast, in ctx, in symbols, in fn_table, name, node.c)
}

fn starts_with(in text: ChunkSeq[u8], in prefix: Str) -> bool {
    let expected = prefix.as_bytes();
    if text.len() < expected.len() {
        return false;
    }
    for i in 0..expected.len() {
        let want = expected.try_get(i).unwrap_or(0);
        if g8(in text, i) != want {
            return false;
        }
    }
    true
}

fn rest_is(in text: ChunkSeq[u8], from: u64, in rest: Str) -> bool {
    let expected = rest.as_bytes();
    if wrapping_sub(text.len(), from) != expected.len() {
        return false;
    }
    for i in 0..expected.len() {
        let want = expected.try_get(i).unwrap_or(0);
        if g8(in text, wrapping_add(from, i)) != want {
            return false;
        }
    }
    true
}

// `Builder::operands`: two operands of one kind (K_NONE on error).
fn operands(
    inout builder: B,
    inout scope: Sc,
    in ast: Ast,
    in ctx: Ctx,
    in symbols: Syms,
    in fn_table: Wt,
    lhs_expr: u32,
    rhs_expr: u32,
    want: u8,
    inout lhs: u32,
    inout rhs: u32
) -> u8 {
    let mut hint = kind_at(inout builder, in ast, in ctx, in symbols, lhs_expr);
    if hint == K_NONE {
        hint = kind_at(inout builder, in ast, in ctx, in symbols, rhs_expr);
    }
    if !(integer(hint) || hint == K_BOOL) {
        hint = want;
    }
    if is_int_literal(in ast, lhs_expr) && !is_int_literal(in ast, rhs_expr) {
        rhs = expr(
            inout builder,
            inout scope,
            in ast,
            in ctx,
            in symbols,
            in fn_table,
            rhs_expr,
            hint
        );
        if rhs == NONE {
            return K_NONE;
        }
        let first_kind = kind_of(in builder.terms, rhs);
        lhs = expr(
            inout builder,
            inout scope,
            in ast,
            in ctx,
            in symbols,
            in fn_table,
            lhs_expr,
            first_kind
        );
    } else {
        lhs = expr(
            inout builder,
            inout scope,
            in ast,
            in ctx,
            in symbols,
            in fn_table,
            lhs_expr,
            hint
        );
        if lhs == NONE {
            return K_NONE;
        }
        let first_kind = kind_of(in builder.terms, lhs);
        rhs = expr(
            inout builder,
            inout scope,
            in ast,
            in ctx,
            in symbols,
            in fn_table,
            rhs_expr,
            first_kind
        );
    }
    if lhs == NONE || rhs == NONE {
        return K_NONE;
    }
    let lhs_kind = kind_of(in builder.terms, lhs);
    if lhs_kind != kind_of(in builder.terms, rhs) {
        let _ = fail_s(
            inout builder,
            in "operands of different kinds are outside the scalar model"
        );
        return K_NONE;
    }
    lhs_kind
}

fn op_outside(inout builder: B, in ast: Ast, op: u32, kind: u8) -> u32 {
    builder.err.clear();
    s(inout builder.err, in "'");
    put_name(inout builder.err, in ast, op);
    s(inout builder.err, in "' on ");
    s(inout builder.err, in kind_name(kind));
    s(inout builder.err, in " is outside the model");
    fail(inout builder)
}

fn is_op(op: u32, sym: u32) -> bool {
    op == sym && sym != NONE
}

fn binary(
    inout builder: B,
    inout scope: Sc,
    in ast: Ast,
    in ctx: Ctx,
    in symbols: Syms,
    in fn_table: Wt,
    op: u32,
    lhs_expr: u32,
    rhs_expr: u32
) -> u32 {
    if is_op(op, symbols.y_and) || is_op(op, symbols.y_or) {
        let lhs = expr(
            inout builder,
            inout scope,
            in ast,
            in ctx,
            in symbols,
            in fn_table,
            lhs_expr,
            K_BOOL
        );
        if lhs == NONE {
            return NONE;
        }
        let rhs = expr(
            inout builder,
            inout scope,
            in ast,
            in ctx,
            in symbols,
            in fn_table,
            rhs_expr,
            K_BOOL
        );
        if rhs == NONE {
            return NONE;
        }
        if kind_of(in builder.terms, lhs) != K_BOOL || kind_of(in builder.terms, rhs) != K_BOOL {
            return fail_s(inout builder, in "logical operands must be bool");
        }
        return term(
            inout builder.terms,
            if is_op(op, symbols.y_and) {
                TM_AND
            } else {
                TM_OR
            },
            lhs,
            rhs,
            0,
            K_BOOL,
            0,
            0
        );
    }
    let cmp = if is_op(op, symbols.y_eq) {
        CMP_EQ
    } else if is_op(op, symbols.y_ne) {
        CMP_NE
    } else if is_op(op, symbols.y_lt) {
        CMP_LT
    } else if is_op(op, symbols.y_le) {
        CMP_LE
    } else if is_op(op, symbols.y_gt) {
        CMP_GT
    } else if is_op(op, symbols.y_ge) {
        CMP_GE
    } else {
        255
    };
    if cmp != 255 {
        let mut lhs = NONE;
        let mut rhs = NONE;
        let kind = operands(
            inout builder,
            inout scope,
            in ast,
            in ctx,
            in symbols,
            in fn_table,
            lhs_expr,
            rhs_expr,
            K_NONE,
            inout lhs,
            inout rhs
        );
        if kind == K_NONE {
            return NONE;
        }
        if kind == K_UNIT || (kind == K_BOOL && cmp != CMP_EQ && cmp != CMP_NE) {
            return op_outside(inout builder, in ast, op, kind);
        }
        return term(inout builder.terms, TM_CMP, lhs, rhs, 0, kind, cmp, 0);
    }
    let arith = is_op(op, symbols.y_plus)
        || is_op(op, symbols.y_minus)
        || is_op(op, symbols.y_star);
    let div = is_op(op, symbols.y_slash) || is_op(op, symbols.y_percent);
    if arith || div {
        let mut lhs = NONE;
        let mut rhs = NONE;
        let kind = operands(
            inout builder,
            inout scope,
            in ast,
            in ctx,
            in symbols,
            in fn_table,
            lhs_expr,
            rhs_expr,
            K_NONE,
            inout lhs,
            inout rhs
        );
        if kind == K_NONE {
            return NONE;
        }
        if !integer(kind) {
            return op_outside(inout builder, in ast, op, kind);
        }
        if arith {
            let arith_op = if is_op(op, symbols.y_plus) {
                OP_ADD
            } else if is_op(op, symbols.y_minus) {
                OP_SUB
            } else {
                OP_MUL
            };
            return term(inout builder.terms, TM_ARITH, lhs, rhs, 0, kind, arith_op, 1);
        }
        return term(
            inout builder.terms,
            TM_DIV,
            lhs,
            rhs,
            0,
            kind,
            0,
            if is_op(op, symbols.y_percent) { 1 } else { 0 }
        );
    }
    quoted(inout builder, in ast, in "operator '", op, in "' is outside the scalar model")
}

fn block(
    inout builder: B,
    inout scope: Sc,
    in ast: Ast,
    in ctx: Ctx,
    in symbols: Syms,
    in fn_table: Wt,
    stmts: u32,
    i: u64,
    tail: u32,
    want: u8
) -> u32 {
    if i >= list_len(in ast, stmts) {
        if tail != NONE {
            return expr(
                inout builder,
                inout scope,
                in ast,
                in ctx,
                in symbols,
                in fn_table,
                tail,
                want
            );
        }
        return unit(inout builder);
    }
    let depth = wrapping_sub(scope.frames, 1);
    let stmt = stmt_at(in ast, list_at(in ast, stmts, i));
    let mut name = NONE;
    let mut value = NONE;
    if stmt.kind == S_LET {
        let pat = pat_at(in ast, stmt.pat);
        if pat.kind != P_BIND {
            return fail_s(inout builder, in "a destructuring let is outside the scalar model");
        }
        let mut declared = K_NONE;
        if !is_infer(in ast, stmt.ty) {
            declared = kind_of_type(in ast, in symbols, stmt.ty);
            if declared == K_NONE {
                return fail_s(inout builder, in "a let of non-scalar type");
            }
        }
        value = expr(
            inout builder,
            inout scope,
            in ast,
            in ctx,
            in symbols,
            in fn_table,
            stmt.value,
            declared
        );
        if value == NONE {
            return NONE;
        }
        name = pat.a;
    } else {
        let stmt_expr = expr_at(in ast, stmt.value);
        if stmt_expr.kind == E_ASSIGN {
            let target = expr_at(in ast, stmt_expr.b);
            if target.kind != E_NAME {
                return fail_s(inout builder, in "assignment to a projection is outside the model");
            }
            let found = sc_lookup(in scope, target.a);
            if found == 18446744073709551615 {
                return quoted(
                    inout builder,
                    in ast,
                    in "'",
                    target.a,
                    in "' is not a scalar local"
                );
            }
            let old_var = wrapping_u32(wrapping_shr_u64(found, 32));
            let frame = found & 4294967295;
            if frame != depth || var_is_param(in builder, old_var) {
                return quoted(
                    inout builder,
                    in ast,
                    in "assignment to '",
                    target.a,
                    in "' outside its own block is outside the model"
                );
            }
            let kind = var_kind_of(in builder, old_var);
            let rhs = expr(
                inout builder,
                inout scope,
                in ast,
                in ctx,
                in symbols,
                in fn_table,
                stmt_expr.c,
                kind
            );
            if rhs == NONE {
                return NONE;
            }
            let op = stmt_expr.a;
            if is_op(op, symbols.y_assign) {
                value = rhs;
            } else if is_op(op, symbols.y_add_assign)
                || is_op(op, symbols.y_sub_assign)
                || is_op(op, symbols.y_mul_assign)
            {
                let arith_op = if is_op(op, symbols.y_add_assign) {
                    OP_ADD
                } else if is_op(op, symbols.y_sub_assign) {
                    OP_SUB
                } else {
                    OP_MUL
                };
                let old_term = term(inout builder.terms, TM_VAR, old_var, 0, 0, K_NONE, 0, 0);
                value = term(inout builder.terms, TM_ARITH, old_term, rhs, 0, kind, arith_op, 1);
            } else if is_op(op, symbols.y_div_assign) || is_op(op, symbols.y_rem_assign) {
                let old_term = term(inout builder.terms, TM_VAR, old_var, 0, 0, K_NONE, 0, 0);
                value = term(
                    inout builder.terms,
                    TM_DIV,
                    old_term,
                    rhs,
                    0,
                    kind,
                    0,
                    if is_op(op, symbols.y_rem_assign) {
                        1
                    } else {
                        0
                    }
                );
            } else {
                return quoted(
                    inout builder,
                    in ast,
                    in "assignment '",
                    op,
                    in "' is outside the model"
                );
            }
            name = target.a;
        } else {
            value = expr(
                inout builder,
                inout scope,
                in ast,
                in ctx,
                in symbols,
                in fn_table,
                stmt.value,
                K_NONE
            );
            if value == NONE {
                return NONE;
            }
        }
    }
    let kind = kind_of(in builder.terms, value);
    let var_id = var(inout builder, in ast, NONE, kind, false);
    if name != NONE {
        sc_bind(inout scope, name, var_id);
    }
    let body = block(
        inout builder,
        inout scope,
        in ast,
        in ctx,
        in symbols,
        in fn_table,
        stmts,
        wrapping_add(i, 1),
        tail,
        want
    );
    if body == NONE {
        return NONE;
    }
    term(inout builder.terms, TM_LET, var_id, value, body, K_NONE, 0, 0)
}

fn var_is_param(in builder: B, var_id: u32) -> bool {
    g8(in builder.terms.var_param, widen_u64(var_id)) != 0
}

fn var_kind_of(in builder: B, var_id: u32) -> u8 {
    g8(in builder.terms.var_kind, widen_u64(var_id))
}

fn inline(
    inout builder: B,
    inout scope: Sc,
    in ast: Ast,
    in ctx: Ctx,
    in symbols: Syms,
    in fn_table: Wt,
    name: u32,
    args: u32
) -> u32 {
    let fn_index = widen_u64(g32(in fn_table.by_sym, widen_u64(name)));
    let known = fn_index != widen_u64(NONE);
    if known {
        for i in 0..builder.stack.len() {
            if widen_u64(g32(in builder.stack, i)) == fn_index {
                return quoted(
                    inout builder,
                    in ast,
                    in "recursive call to '",
                    name,
                    in "' is outside the model"
                );
            }
        }
    }
    if builder.stack.len() > MAX_INLINE_DEPTH {
        return fail_s(inout builder, in "calls nest too deeply for the model");
    }
    if !known {
        return quoted(
            inout builder,
            in ast,
            in "call to '",
            name,
            in "' is outside the scalar model"
        );
    }
    let sig = signature(inout builder, in ast, in symbols, in fn_table, fn_index);
    if !sig.ok {
        let mut reason = ChunkSeq::new[u8]();
        sb(inout reason, in builder.err);
        builder.err.clear();
        s(inout builder.err, in "callee '");
        put_name(inout builder.err, in ast, name);
        s(inout builder.err, in "': ");
        sb(inout builder.err, in reason);
        return NONE;
    }
    let param_count = sig.kinds.len();
    if list_len(in ast, args) != param_count {
        return quoted(inout builder, in ast, in "call to '", name, in "' has the wrong arity");
    }
    let mut values = ChunkSeq::new[u32]();
    for i in 0..param_count {
        let kind = g8(in sig.kinds, i);
        let arg = arg_at(in ast, list_at(in ast, args, i));
        let arg_value = expr(
            inout builder,
            inout scope,
            in ast,
            in ctx,
            in symbols,
            in fn_table,
            arg.expr,
            kind
        );
        if arg_value == NONE {
            return NONE;
        }
        if kind_of(in builder.terms, arg_value) != kind {
            return quoted(
                inout builder,
                in ast,
                in "argument to '",
                name,
                in "' has the wrong kind"
            );
        }
        values.push(arg_value);
    }
    // The callee sees only its parameters.
    let callee = fn_at(in ast, g32(in fn_table.node, fn_index));
    let mut inner = sc_new();
    let mut vars = ChunkSeq::new[u32]();
    for i in 0..param_count {
        let param = param_at(in ast, list_at(in ast, callee.params, i));
        let var_id = var(inout builder, in ast, NONE, g8(in sig.kinds, i), false);
        sc_bind(inout inner, param.name, var_id);
        vars.push(var_id);
    }
    builder.stack.push(wrapping_u32(fn_index));
    let saved = builder.delta;
    builder.delta = g64(in fn_table.delta, fn_index);
    let body = expr(
        inout builder,
        inout inner,
        in ast,
        in ctx,
        in symbols,
        in fn_table,
        sig.body,
        sig.result
    );
    builder.delta = saved;
    let _ = builder.stack.pop();
    if body == NONE {
        return NONE;
    }
    let mut result = body;
    let mut i = param_count;
    loop {
        if i == 0 {
            break;
        }
        i = wrapping_sub(i, 1);
        result = term(
            inout builder.terms,
            TM_LET,
            g32(in vars, i),
            g32(in values, i),
            result,
            K_NONE,
            0,
            0
        );
    }
    result
}

// `model`: the model of function `fn_index` into `out` (`O` exact, bitvec and
// key, each after a 0x1f) or its reason (`E`).
fn model(
    inout builder: B,
    inout out: ChunkSeq[u8],
    in ast: Ast,
    in ctx: Ctx,
    in symbols: Syms,
    in fn_table: Wt,
    fn_index: u64
) {
    tm_clear(inout builder.terms);
    builder.nodes = 0;
    builder.stack.clear();
    builder.stack.push(wrapping_u32(fn_index));
    builder.err.clear();
    builder.failed = false;
    builder.delta = g64(in fn_table.delta, fn_index);
    let sig = signature(inout builder, in ast, in symbols, in fn_table, fn_index);
    if !sig.ok {
        out.push(69);
        sb(inout out, in builder.err);
        return;
    }
    let fn_node = fn_at(in ast, g32(in fn_table.node, fn_index));
    let mut scope = sc_new();
    let param_count = sig.kinds.len();
    for i in 0..param_count {
        let param = param_at(in ast, list_at(in ast, fn_node.params, i));
        let var_id = var(inout builder, in ast, param.name, g8(in sig.kinds, i), true);
        sc_bind(inout scope, param.name, var_id);
    }
    let root = expr(
        inout builder,
        inout scope,
        in ast,
        in ctx,
        in symbols,
        in fn_table,
        sig.body,
        sig.result
    );
    if root == NONE {
        out.push(69);
        sb(inout out, in builder.err);
        return;
    }
    let mut exact_text = ChunkSeq::new[u8]();
    exact(inout exact_text, in builder.terms, root);
    let mut bitvec_text = ChunkSeq::new[u8]();
    bitvec(inout bitvec_text, in builder.terms, root, param_count);
    out.push(79);
    sb(inout out, in exact_text);
    out.push(31);
    sb(inout out, in bitvec_text);
    out.push(31);
    if !builder.hash {
        return;
    }
    let mut keyed = ChunkSeq::new[u8]();
    s(inout keyed, in "vesper.lens.model/1");
    keyed.push(0);
    sb(inout keyed, in exact_text);
    keyed.push(0);
    sb(inout keyed, in bitvec_text);
    let digest = blake3(in keyed.as_slice());
    let mut key = ChunkSeq::new[u8]();
    digest_bytes(digest, inout key);
    for i in 0..key.len() {
        let byte = g8(in key, i);
        out.push(hex_digit(byte >> 4));
        out.push(hex_digit(byte & 15));
    }
}

fn hex_digit(nibble: u8) -> u8 {
    if nibble < 10 {
        wrapping_add(nibble, 48)
    } else {
        wrapping_add(nibble, 87)
    }
}

// ------------------------------------------------------------ entry

copy struct Rd {
    pos: u64
}

fn word(in bytes: Slice[u8], inout reader: Rd) -> u64 {
    let value = bytes.try_read_u64_le(reader.pos).unwrap_or(0);
    reader.pos = wrapping_add(reader.pos, 8);
    value
}

// `proof_model::all` over the checker's facts, then the function table
// (per function: name offset and length in the names blob, span, text
// start, body flag), the text and names lengths, the text and the names.
// One record per modelled function, each `name 0x1f` then the model,
// records separated by 0x1e.
pub fn proof_models(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mut ctx_reader = CtxReader { pos: 0 };
    let ctx = read_ctx(inout ctx_reader, in bytes);
    let mut reader = Rd { pos: ctx_reader.pos };
    let fn_count = word(in bytes, inout reader);
    let mut name_offsets = ChunkSeq::new[u64]();
    let mut name_lens = ChunkSeq::new[u64]();
    let mut fn_starts = ChunkSeq::new[u64]();
    let mut fn_ends = ChunkSeq::new[u64]();
    let mut fn_table = Wt {
        sym: ChunkSeq::new[u32](),
        node: ChunkSeq::new[u32](),
        owner_impl: ChunkSeq::new[u32](),
        delta: ChunkSeq::new[u64](),
        body: ChunkSeq::new[u8](),
        by_sym: ChunkSeq::new[u32]()
    };
    for i in 0..fn_count {
        name_offsets.push(word(in bytes, inout reader));
        name_lens.push(word(in bytes, inout reader));
        fn_starts.push(word(in bytes, inout reader));
        fn_ends.push(word(in bytes, inout reader));
        fn_table.delta.push(word(in bytes, inout reader));
        fn_table.body.push(wrapping_u8(word(in bytes, inout reader)));
    }
    let text_len = word(in bytes, inout reader);
    let names_len = word(in bytes, inout reader);
    // The server keeps one parse per snapshot: `reps` rounds of every model
    // on it (the answer is the last round's).
    let reps = word(in bytes, inout reader);
    let mut b_hash: u64 = 0;
    // 1: the key is hashed here (portable BLAKE3); 0: the key is left to the
    // host, which hashes the renderings with the C BLAKE3 as
    // `@vesper-std/hash-sys` does in the hosted build.
    b_hash = word(in bytes, inout reader);
    let text = match String::from_utf8(in bytes[reader.pos..wrapping_add(reader.pos, text_len)]) {
        Option::Some(x) => x,
        Option::None => String::new(),
    };
    let names_at = wrapping_add(reader.pos, text_len);
    let lowered = lower_source(in text);
    let mut ast = lowered.ast;
    for i in 0..fn_count {
        let name_at = wrapping_add(names_at, g64(in name_offsets, i));
        let name = match String::from_utf8(
            in bytes[name_at..wrapping_add(name_at, g64(in name_lens, i))]
        ) {
            Option::Some(x) => x,
            Option::None => String::new(),
        };
        let symbol = ast.names.intern(in name);
        fn_table.sym.push(symbol.id());
    }
    for i in 0..ast.names.len() {
        fn_table.by_sym.push(NONE);
    }
    for i in 0..fn_count {
        let ok = fn_table.by_sym.try_set(widen_u64(g32(in fn_table.sym, i)), wrapping_u32(i));
    }
    // Every function tree: top-level functions and impl methods.
    let mut fn_nodes = ChunkSeq::new[u32]();
    let mut fn_impls = ChunkSeq::new[u32]();
    for i in 0..ast.m_items.len() {
        let item = item_at(in ast, g32(in ast.m_items, i));
        if item.kind == ITEM_FUNCTION {
            fn_nodes.push(item.node);
            fn_impls.push(NONE);
        } else if item.kind == ITEM_IMPL {
            let impl_node = impl_at(in ast, item.node);
            for j in 0..list_len(in ast, impl_node.methods) {
                fn_nodes.push(list_at(in ast, impl_node.methods, j));
                fn_impls.push(item.node);
            }
        }
    }
    for i in 0..fn_count {
        let mut node = NONE;
        let mut impl_id = NONE;
        for j in 0..fn_nodes.len() {
            let fn_node = fn_at(in ast, g32(in fn_nodes, j));
            if widen_u64(fn_node.start) == g64(in fn_starts, i)
                && widen_u64(fn_node.end) == g64(in fn_ends, i)
            {
                node = g32(in fn_nodes, j);
                impl_id = g32(in fn_impls, j);
                break;
            }
        }
        fn_table.node.push(node);
        fn_table.owner_impl.push(impl_id);
    }
    let symbols = syms(in ast);
    let mut builder = B {
        terms: tm_new(),
        nodes: 0,
        stack: ChunkSeq::new[u32](),
        delta: 0,
        err: ChunkSeq::new[u8](),
        failed: false,
        memo: ChunkSeq::new[u8](),
        hash: b_hash != 0
    };
    let mut out = ChunkSeq::new[u8]();
    for round in 0..reps {
        out.clear();
        all(
            inout builder,
            inout out,
            in ast,
            in ctx,
            in symbols,
            in fn_table,
            in bytes,
            names_at,
            in name_offsets,
            in name_lens,
            fn_count
        );
    }
    pack(in out.as_slice())
}

// `proof_model::all`: the first `MAX_MODELS` functions with a body.
fn all(
    inout builder: B,
    inout out: ChunkSeq[u8],
    in ast: Ast,
    in ctx: Ctx,
    in symbols: Syms,
    in fn_table: Wt,
    in bytes: Slice[u8],
    names_at: u64,
    in name_offsets: ChunkSeq[u64],
    in name_lens: ChunkSeq[u64],
    fn_count: u64
) {
    let mut count: u64 = 0;
    for i in 0..fn_count {
        if g8(in fn_table.body, i) == 0 {
            continue;
        }
        if count >= MAX_MODELS {
            break;
        }
        if count > 0 {
            out.push(30);
        }
        count = wrapping_add(count, 1);
        let name_at = wrapping_add(names_at, g64(in name_offsets, i));
        out.extend(in bytes[name_at..wrapping_add(name_at, g64(in name_lens, i))]);
        out.push(31);
        model(inout builder, inout out, in ast, in ctx, in symbols, in fn_table, i);
    }
}
