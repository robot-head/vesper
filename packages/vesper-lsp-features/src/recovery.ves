// The recovery gate of `vesper lsp` (src/tooling/recovery.rs `gate`) in
// Vesper, over the words `recovery::gate_words` writes for a recovery
// syntax snapshot: the limits, the source identity, the syntax diagnostic
// bound, and the declaration, site and token census that decides whether
// any complete component of a damaged document may be checked.
//
// The answer is the text `recovery::gate_answer` writes: `E <failure>`, or
// `B` (blocked) or `O <work left> <parser work>` (open), each followed by
// its unavailable spans as ` <reason>@<start>..<end>`.
use @vesper-std/hash::blake3::{blake3, digest_bytes};
use self::json::{byte, put, put_u64};

const DIGEST_BYTES: u64 = 32;
const WORD_BYTES: u64 = 8;

// `AnalysisLimits::validate`'s hard bounds, in field order.
const HARD_SOURCE_BYTES: u64 = 262144;
const HARD_AST_NODES: u64 = 8192;
const HARD_TYPE_NODES: u64 = 32768;
const HARD_DEPTH: u64 = 64;
const HARD_IDENTIFIER_BYTES: u64 = 1024;
const HARD_PRINTED_TYPE_BYTES: u64 = 8192;
const HARD_DIAGNOSTICS: u64 = 256;
const HARD_DIAGNOSTIC_BYTES: u64 = 262144;
const HARD_METADATA_BYTES: u64 = 2097152;
// `RecoveryLimits::validate`'s bounds.
const HARD_FUNCTIONS: u64 = 128;
const HARD_CONTEXT_ITEMS: u64 = 128;
const HARD_WORK: u64 = 33554432;
// `MAX_RELATED_LABELS_PER_DIAGNOSTIC` and the gate's original token limit.
const MAX_RELATED_LABELS: u64 = 8;
const MAX_TOKENS: u64 = 16384;

// The tags of `recovery::gate_tags`.
const KIND_FUNCTION: u64 = 0;
const KIND_STRUCT: u64 = 1;
const KIND_ENUM: u64 = 2;
const KIND_EFFECT: u64 = 3;
const STATUS_COMPLETE: u64 = 0;
const STATUS_RECOVERED: u64 = 1;
const STATUS_OPAQUE: u64 = 2;
const SITE_OPAQUE: u64 = 1;
const TOKEN_TRIVIA: u64 = 0;
const TOKEN_IDENTIFIER: u64 = 1;

// Words per declaration (kind, status, span, name flag, name span), per
// site (kind, owner flag, owner, span) and per token (class, range).
const DECLARATION_WORDS: u64 = 7;
const SITE_WORDS: u64 = 5;
const TOKEN_WORDS: u64 = 3;
// The word offsets inside those records.
const D_KIND: u64 = 0;
const D_STATUS: u64 = 1;
const D_START: u64 = 2;
const D_END: u64 = 3;
const D_HAS_NAME: u64 = 4;
const D_NAME_START: u64 = 5;
const D_NAME_END: u64 = 6;
const S_KIND: u64 = 0;
const S_HAS_OWNER: u64 = 1;
const S_OWNER: u64 = 2;
const S_START: u64 = 3;
const S_END: u64 = 4;
const T_CLASS: u64 = 0;
const T_START: u64 = 1;
const T_END: u64 = 2;
// An unavailable span in the gate's list: reason, start, end.
const UNAVAILABLE_WORDS: u64 = 3;
const U_REASON: u64 = 0;
const U_START: u64 = 1;
const U_END: u64 = 2;

// `UnavailableReason`, in its order; NO_REASON is "not blocked".
const DAMAGED_FUNCTION: u64 = 0;
const OPAQUE_CONTEXT: u64 = 1;
const INCOMPLETE_CONTEXT: u64 = 2;
const UNSUPPORTED_CONTEXT: u64 = 3;
const DUPLICATE_DECLARATION: u64 = 4;
const RESERVED_DECLARATION: u64 = 5;
const NO_REASON: u64 = 255;

// A UTF-8 continuation byte is `0b10xx_xxxx`.
const UTF8_CONTINUATION_MASK: u8 = 192;
const UTF8_CONTINUATION: u8 = 128;
const SPACE: u8 = 32;

fn reason_name(reason: u64) -> Str {
    if reason == DAMAGED_FUNCTION {
        "damaged_function"
    } else if reason == OPAQUE_CONTEXT {
        "opaque_context"
    } else if reason == INCOMPLETE_CONTEXT {
        "incomplete_context"
    } else if reason == UNSUPPORTED_CONTEXT {
        "unsupported_context"
    } else if reason == DUPLICATE_DECLARATION {
        "duplicate_declaration"
    } else {
        "reserved_declaration"
    }
}

fn at(in b: Slice[u8], pos: u64) -> u64 {
    b.try_read_u64_le(pos).unwrap_or(0)
}

fn next(in b: Slice[u8], inout pos: u64) -> u64 {
    let value = at(in b, pos);
    pos = wrapping_add(pos, WORD_BYTES);
    value
}

// Word `k` of the record of `words` words at index `i` of the list at `base`.
fn field(in b: Slice[u8], base: u64, words: u64, i: u64, k: u64) -> u64 {
    at(in b, wrapping_add(base, wrapping_mul(wrapping_add(wrapping_mul(i, words), k), WORD_BYTES)))
}

fn boundary(in b: Slice[u8], src_at: u64, src_len: u64, i: u64) -> bool {
    i == src_len
        || (i < src_len
            && (byte(in b, wrapping_add(src_at, i)) & UTF8_CONTINUATION_MASK) != UTF8_CONTINUATION)
}

// `source.get(start..end).is_some()`.
fn span_ok(in b: Slice[u8], src_at: u64, src_len: u64, start: u64, end: u64) -> bool {
    start <= end
        && end <= src_len
        && boundary(in b, src_at, src_len, start)
        && boundary(in b, src_at, src_len, end)
}

fn is_text(in b: Slice[u8], x: u64, len: u64, in s: Str) -> bool {
    let t = s.as_bytes();
    if t.len() != len {
        return false;
    }
    for i in 0..len {
        if byte(in b, wrapping_add(x, i)) != byte(in t, i) {
            return false;
        }
    }
    true
}

// `reserved`: the built-in type and effect names, the scalar names and the
// wrapping intrinsics.
fn reserved(in b: Slice[u8], x: u64, len: u64) -> bool {
    is_text(in b, x, len, in "Unit")
        || is_text(in b, x, len, in "Never")
        || is_text(in b, x, len, in "String")
        || is_text(in b, x, len, in "Option")
        || is_text(in b, x, len, in "Result")
        || is_text(in b, x, len, in "RuntimeError")
        || is_text(in b, x, len, in "ArithOverflow")
        || is_text(in b, x, len, in "Fail")
        || is_text(in b, x, len, in "bool")
        || is_text(in b, x, len, in "u8")
        || is_text(in b, x, len, in "u16")
        || is_text(in b, x, len, in "u32")
        || is_text(in b, x, len, in "u64")
        || is_text(in b, x, len, in "usize")
        || is_text(in b, x, len, in "u128")
        || is_text(in b, x, len, in "i8")
        || is_text(in b, x, len, in "i16")
        || is_text(in b, x, len, in "i32")
        || is_text(in b, x, len, in "i64")
        || is_text(in b, x, len, in "isize")
        || is_text(in b, x, len, in "i128")
        || is_text(in b, x, len, in "f32")
        || is_text(in b, x, len, in "f64")
        || is_text(in b, x, len, in "wrapping_add")
        || is_text(in b, x, len, in "wrapping_sub")
        || is_text(in b, x, len, in "wrapping_mul")
}

fn same(in b: Slice[u8], x: u64, y: u64, len: u64) -> bool {
    for i in 0..len {
        if byte(in b, wrapping_add(x, i)) != byte(in b, wrapping_add(y, i)) {
            return false;
        }
    }
    true
}

fn refuse(inout o: ChunkSeq[u8], in reason: Str) {
    o.truncate(0);
    put(inout o, in "E ");
    put(inout o, in reason);
}

// Takes `n` from `remaining`, or leaves it and answers false.
fn charge(inout remaining: u64, n: u64) -> bool {
    if n > remaining {
        return false;
    }
    remaining = wrapping_sub(remaining, n);
    true
}

fn charge_bytes(inout bytes: u64, n: u64, limit: u64) -> bool {
    bytes = wrapping_add(bytes, n);
    bytes <= limit
}

// `frontend::diagnostics_bounded` over the syntax diagnostics at `pos`,
// with no sugar origins. `pos` is left after the list either way.
fn diagnostics_bounded(
    in b: Slice[u8],
    inout pos: u64,
    src_at: u64,
    src_len: u64,
    max_diagnostics: u64,
    max_bytes: u64,
    diagnostic_size: u64,
    label_size: u64
) -> bool {
    let count = next(in b, inout pos);
    let mut ok = count <= max_diagnostics;
    let max_related = wrapping_mul(max_diagnostics, MAX_RELATED_LABELS);
    let mut related_count: u64 = 0;
    let mut bytes: u64 = 0;
    for d in 0..count {
        let code_len = next(in b, inout pos);
        let message_len = next(in b, inout pos);
        let start = next(in b, inout pos);
        let end = next(in b, inout pos);
        let related = next(in b, inout pos);
        related_count = wrapping_add(related_count, related);
        ok = ok
            && related <= MAX_RELATED_LABELS
            && related_count <= max_related
            && charge_bytes(inout bytes, diagnostic_size, max_bytes)
            && charge_bytes(inout bytes, code_len, max_bytes)
            && charge_bytes(inout bytes, message_len, max_bytes)
            && span_ok(in b, src_at, src_len, start, end)
            && charge_bytes(inout bytes, wrapping_mul(related, label_size), max_bytes);
        for l in 0..related {
            let label_start = next(in b, inout pos);
            let label_end = next(in b, inout pos);
            let label_len = next(in b, inout pos);
            ok = ok
                && charge_bytes(inout bytes, label_len, max_bytes)
                && span_ok(in b, src_at, src_len, label_start, label_end);
        }
        let has_help = next(in b, inout pos) == 1;
        let help_len = next(in b, inout pos);
        ok = ok && (!has_help || charge_bytes(inout bytes, help_len, max_bytes));
    }
    ok
}

fn valid_limit(value: u64, hard: u64) -> bool {
    value != 0 && value <= hard
}

fn push_unavailable(inout u: ChunkSeq[u64], reason: u64, start: u64, end: u64) {
    u.push(reason);
    u.push(start);
    u.push(end);
}

// The union of the opaque span so far (when `has`) with `start..end`.
fn widen(inout has: bool, inout lo: u64, inout hi: u64, start: u64, end: u64) {
    if has {
        if start < lo {
            lo = start;
        }
        if end > hi {
            hi = end;
        }
    } else {
        has = true;
        lo = start;
        hi = end;
    }
}

// One gate over the words after `rounds` (see `gate_words`).
pub fn recovery_gate(inout o: ChunkSeq[u8], inout u: ChunkSeq[u64], in b: Slice[u8], start: u64) {
    o.truncate(0);
    u.truncate(0);
    let mut pos = start;
    let max_source = next(in b, inout pos);
    let max_ast_nodes = next(in b, inout pos);
    let max_type_nodes = next(in b, inout pos);
    let max_depth = next(in b, inout pos);
    let max_identifier = next(in b, inout pos);
    let max_printed_type = next(in b, inout pos);
    let max_diagnostics = next(in b, inout pos);
    let max_diagnostic_bytes = next(in b, inout pos);
    let max_metadata = next(in b, inout pos);
    let max_functions = next(in b, inout pos);
    let max_context = next(in b, inout pos);
    let max_work = next(in b, inout pos);
    let diagnostic_size = next(in b, inout pos);
    let label_size = next(in b, inout pos);
    let src_len = at(in b, pos);
    let src_at = wrapping_add(pos, WORD_BYTES);
    pos = wrapping_add(src_at, src_len);
    let hash_at = pos;
    pos = wrapping_add(pos, DIGEST_BYTES);
    let host_hashed = at(in b, pos) == 1;
    let host_at = wrapping_add(pos, WORD_BYTES);
    pos = wrapping_add(host_at, DIGEST_BYTES);
    let diagnostic_count = at(in b, pos);
    let diagnostics_fit = diagnostics_bounded(
        in b,
        inout pos,
        src_at,
        src_len,
        max_diagnostics,
        max_diagnostic_bytes,
        diagnostic_size,
        label_size
    );
    let declarations = at(in b, pos);
    let decl_at = wrapping_add(pos, WORD_BYTES);
    pos = wrapping_add(
        decl_at,
        wrapping_mul(wrapping_mul(declarations, DECLARATION_WORDS), WORD_BYTES)
    );
    let sites = at(in b, pos);
    let site_at = wrapping_add(pos, WORD_BYTES);
    pos = wrapping_add(site_at, wrapping_mul(wrapping_mul(sites, SITE_WORDS), WORD_BYTES));
    let tokens = at(in b, pos);
    let token_at = wrapping_add(pos, WORD_BYTES);
    // `RecoveryLimits::validate`.
    if !(valid_limit(max_source, HARD_SOURCE_BYTES)
        && valid_limit(max_ast_nodes, HARD_AST_NODES)
        && valid_limit(max_type_nodes, HARD_TYPE_NODES)
        && valid_limit(max_depth, HARD_DEPTH)
        && valid_limit(max_identifier, HARD_IDENTIFIER_BYTES)
        && valid_limit(max_printed_type, HARD_PRINTED_TYPE_BYTES)
        && valid_limit(max_diagnostics, HARD_DIAGNOSTICS)
        && valid_limit(max_diagnostic_bytes, HARD_DIAGNOSTIC_BYTES)
        && valid_limit(max_metadata, HARD_METADATA_BYTES))
    {
        refuse(inout o, in "invalid_analysis_limits");
        return;
    }
    if !(valid_limit(max_functions, HARD_FUNCTIONS)
        && valid_limit(max_context, HARD_CONTEXT_ITEMS)
        && valid_limit(max_work, HARD_WORK))
    {
        refuse(inout o, in "invalid_recovery_limits");
        return;
    }
    if src_len > max_source {
        refuse(inout o, in "source_limit");
        return;
    }
    if diagnostic_count == 0 {
        refuse(inout o, in "syntax_complete_use_check_source");
        return;
    }
    let parser_work = max_work / 2;
    let work = "aggregate_work_limit";
    if parser_work == 0 {
        refuse(inout o, in work);
        return;
    }
    let mut remaining = wrapping_sub(max_work, parser_work);
    if !charge(inout remaining, src_len) {
        refuse(inout o, in work);
        return;
    }
    let mut digest: ChunkSeq[u8] = ChunkSeq::new();
    if host_hashed {
        digest.extend(in b[host_at..wrapping_add(host_at, DIGEST_BYTES)]);
    } else {
        digest_bytes(blake3(in b[src_at..wrapping_add(src_at, src_len)]), inout digest);
    }
    for i in 0..DIGEST_BYTES {
        if byte(in b, wrapping_add(hash_at, i)) != digest.try_get(i).unwrap_or(0) {
            refuse(inout o, in "recovery_source_mismatch");
            return;
        }
    }
    if !diagnostics_fit {
        refuse(inout o, in "syntax_diagnostic_limit");
        return;
    }
    if declarations > wrapping_add(max_functions, max_context) {
        refuse(inout o, in "declaration_limit");
        return;
    }
    let mut functions: u64 = 0;
    for i in 0..declarations {
        if field(in b, decl_at, DECLARATION_WORDS, i, D_KIND) == KIND_FUNCTION {
            functions = wrapping_add(functions, 1);
        }
    }
    if functions > max_functions || wrapping_sub(declarations, functions) > max_context {
        refuse(inout o, in "component_count_limit");
        return;
    }
    let mut blocked = NO_REASON;
    let mut has_opaque = false;
    let mut opaque_lo: u64 = 0;
    let mut opaque_hi: u64 = 0;
    // The names seen so far, as indices of their declarations.
    let mut names: ChunkSeq[u64] = ChunkSeq::new();
    let mut last: u64 = 0;
    for i in 0..declarations {
        if !charge(inout remaining, 1) {
            refuse(inout o, in work);
            return;
        }
        let kind = field(in b, decl_at, DECLARATION_WORDS, i, D_KIND);
        let status = field(in b, decl_at, DECLARATION_WORDS, i, D_STATUS);
        let d_start = field(in b, decl_at, DECLARATION_WORDS, i, D_START);
        let d_end = field(in b, decl_at, DECLARATION_WORDS, i, D_END);
        if d_start < last || !span_ok(in b, src_at, src_len, d_start, d_end) {
            refuse(inout o, in "recovery_source_mismatch");
            return;
        }
        last = d_end;
        if status == STATUS_OPAQUE {
            blocked = OPAQUE_CONTEXT;
        }
        let has_name = field(in b, decl_at, DECLARATION_WORDS, i, D_HAS_NAME) == 1;
        let n_start = field(in b, decl_at, DECLARATION_WORDS, i, D_NAME_START);
        let n_end = field(in b, decl_at, DECLARATION_WORDS, i, D_NAME_END);
        if has_name && span_ok(in b, src_at, src_len, n_start, n_end) {
            let n_len = wrapping_sub(n_end, n_start);
            if n_len > max_identifier {
                refuse(inout o, in "identifier_limit");
                return;
            }
            let n_at = wrapping_add(src_at, n_start);
            let mut seen = false;
            for k in 0..names.len() {
                let j = names.try_get(k).unwrap_or(0);
                let j_start = field(in b, decl_at, DECLARATION_WORDS, j, D_NAME_START);
                let j_end = field(in b, decl_at, DECLARATION_WORDS, j, D_NAME_END);
                if wrapping_sub(j_end, j_start) == n_len
                    && same(in b, wrapping_add(src_at, j_start), n_at, n_len)
                {
                    seen = true;
                    break;
                }
            }
            if seen {
                blocked = DUPLICATE_DECLARATION;
            } else {
                names.push(i);
            }
            if reserved(in b, n_at, n_len) {
                blocked = RESERVED_DECLARATION;
            }
        } else {
            blocked = OPAQUE_CONTEXT;
        }
        if kind == KIND_FUNCTION {
            if status != STATUS_COMPLETE {
                push_unavailable(inout u, DAMAGED_FUNCTION, d_start, d_end);
            }
        } else if kind == KIND_STRUCT || kind == KIND_ENUM || kind == KIND_EFFECT {
            if status != STATUS_COMPLETE {
                blocked = INCOMPLETE_CONTEXT;
            }
        } else {
            blocked = UNSUPPORTED_CONTEXT;
        }
    }
    for i in 0..sites {
        if !charge(inout remaining, 1) {
            refuse(inout o, in work);
            return;
        }
        let opaque = field(in b, site_at, SITE_WORDS, i, S_KIND) == SITE_OPAQUE;
        let has_owner = field(in b, site_at, SITE_WORDS, i, S_HAS_OWNER) == 1;
        let owner = field(in b, site_at, SITE_WORDS, i, S_OWNER);
        let owned = has_owner
            && owner < declarations
            && field(in b, decl_at, DECLARATION_WORDS, owner, D_KIND) == KIND_FUNCTION
            && field(in b, decl_at, DECLARATION_WORDS, owner, D_STATUS) == STATUS_RECOVERED;
        if opaque || !owned {
            blocked = OPAQUE_CONTEXT;
            widen(
                inout has_opaque,
                inout opaque_lo,
                inout opaque_hi,
                field(in b, site_at, SITE_WORDS, i, S_START),
                field(in b, site_at, SITE_WORDS, i, S_END)
            );
        }
    }
    // Original nontrivia coverage.
    let mut index: u64 = 0;
    for i in 0..tokens {
        if !charge(inout remaining, 1) {
            refuse(inout o, in work);
            return;
        }
        if wrapping_add(i, 1) > MAX_TOKENS {
            refuse(inout o, in "token_limit");
            return;
        }
        let class = field(in b, token_at, TOKEN_WORDS, i, T_CLASS);
        if class == TOKEN_TRIVIA {
            continue;
        }
        let t_start = field(in b, token_at, TOKEN_WORDS, i, T_START);
        let t_end = field(in b, token_at, TOKEN_WORDS, i, T_END);
        if class == TOKEN_IDENTIFIER && wrapping_sub(t_end, t_start) > max_identifier {
            refuse(inout o, in "identifier_limit");
            return;
        }
        loop {
            if index >= declarations
                || field(in b, decl_at, DECLARATION_WORDS, index, D_END) > t_start
            {
                break;
            }
            index = wrapping_add(index, 1);
        }
        if index >= declarations
            || t_start < field(in b, decl_at, DECLARATION_WORDS, index, D_START)
            || t_end > field(in b, decl_at, DECLARATION_WORDS, index, D_END)
        {
            blocked = OPAQUE_CONTEXT;
            widen(inout has_opaque, inout opaque_lo, inout opaque_hi, t_start, t_end);
        }
    }
    if blocked != NO_REASON {
        put(inout o, in "B");
        for i in 0..declarations {
            let kind = field(in b, decl_at, DECLARATION_WORDS, i, D_KIND);
            let status = field(in b, decl_at, DECLARATION_WORDS, i, D_STATUS);
            if kind != KIND_FUNCTION || status == STATUS_COMPLETE {
                push_unavailable(
                    inout u,
                    blocked,
                    field(in b, decl_at, DECLARATION_WORDS, i, D_START),
                    field(in b, decl_at, DECLARATION_WORDS, i, D_END)
                );
            }
        }
        if has_opaque {
            push_unavailable(inout u, OPAQUE_CONTEXT, opaque_lo, opaque_hi);
        }
        if u.len() == 0 {
            push_unavailable(inout u, blocked, 0, src_len);
        }
    } else {
        put(inout o, in "O ");
        put_u64(inout o, remaining);
        o.push(SPACE);
        put_u64(inout o, parser_work);
    }
    let mut k: u64 = 0;
    loop {
        if k >= u.len() {
            break;
        }
        o.push(SPACE);
        put(inout o, in reason_name(u.try_get(wrapping_add(k, U_REASON)).unwrap_or(0)));
        put(inout o, in "@");
        put_u64(inout o, u.try_get(wrapping_add(k, U_START)).unwrap_or(0));
        put(inout o, in "..");
        put_u64(inout o, u.try_get(wrapping_add(k, U_END)).unwrap_or(0));
        k = wrapping_add(k, UNAVAILABLE_WORDS);
    }
}
