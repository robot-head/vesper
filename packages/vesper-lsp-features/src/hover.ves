// `navigation::hover` (src/lsp/navigation.rs) in Vesper: the standard LSP
// plaintext hover over the lexical index (nav.ves) and the checker's
// facts.
//
// The facts arrive in @vesper/check-data's harness layout (names, types and
// the world section, whose expression types are `Checked::expression_types`),
// followed by the checker's function table (`World::functions` with
// `World::function_results`). Types the checker computed are printed from
// the check-data type table; types written in the source (a signature's
// parameters, generic bounds and effects) from the @vesper/ast tree, as
// `print_type` prints both from one `ast::Type`.

use @vesper/ast::{Ast, TypeNode, EffectsNode, EffectNode, GenericNode, list_len, list_at};
use @vesper/check-data::input::{Ctx};
use @vesper/check-data::world::{Bounds, bounds_new, mode_of};
use @vesper-std/arena::{idx_from_raw};
use self::json::{byte, put, put_bytes, put_string};
use self::nav::{
    Ix, ERR_NONE, ERR_TRAVERSAL, ERR_OUTPUT_BYTES, MAX_DEPTH, MAX_OUTPUT_BYTES, cursor, fn_at, hi,
    lo, n32, node_at, param_at, put_name, put_source_range, token_start, u32_at, u8_at, w
};
use @vesper/front::lex::{token_end};

const NONE: u32 = 4294967295;

// `navigation::Limits::default().max_type_work`.
pub const MAX_TYPE_WORK: u64 = 8192;

const TK_WHITESPACE: u8 = 0;
const TK_COMMENT: u8 = 1;

// AST type kinds (@vesper/ast `TypeNode`).
const AT_NAMED: u8 = 1;
const AT_TUPLE: u8 = 2;
const AT_FUNCTION: u8 = 3;
const AT_ROW: u8 = 4;
const AT_INFER: u8 = 5;

// Check-data type kinds (`TyKind`).
const CT_LIT: u8 = 0;
const CT_NAMED: u8 = 1;
const CT_TUPLE: u8 = 2;
const CT_FN: u8 = 3;
const CT_ROW: u8 = 4;

// The checker's facts: the check-data context and the function table,
// one row per `World::functions` entry in name order.
pub struct Facts {
    c: Ctx,
    // Name symbol, span, parameter rows `pa .. pa + pn`, and the
    // `function_results` type (NONE when the world has none).
    f_name: ChunkSeq[u32],
    f_start: ChunkSeq[u64],
    f_end: ChunkSeq[u64],
    f_pa: ChunkSeq[u64],
    f_pn: ChunkSeq[u64],
    f_result: ChunkSeq[u32],
    // Parameter rows: span, name symbol, type.
    p_start: ChunkSeq[u64],
    p_end: ChunkSeq[u64],
    p_name: ChunkSeq[u32],
    p_ty: ChunkSeq[u32]
}

pub fn facts_new(sink c: Ctx) -> Facts {
    Facts {
        c: c,
        f_name: ChunkSeq::new[u32](),
        f_start: ChunkSeq::new[u64](),
        f_end: ChunkSeq::new[u64](),
        f_pa: ChunkSeq::new[u64](),
        f_pn: ChunkSeq::new[u64](),
        f_result: ChunkSeq::new[u32](),
        p_start: ChunkSeq::new[u64](),
        p_end: ChunkSeq::new[u64](),
        p_name: ChunkSeq::new[u32](),
        p_ty: ChunkSeq::new[u32]()
    }
}

// Adds one function row; its parameters follow with `fact_param`.
pub fn fact_function(inout f: Facts, name: u32, start: u64, end: u64, result: u32) {
    f.f_name.push(name);
    f.f_start.push(start);
    f.f_end.push(end);
    f.f_pa.push(f.p_name.len());
    f.f_pn.push(0);
    f.f_result.push(result);
}

pub fn fact_param(inout f: Facts, start: u64, end: u64, name: u32, ty: u32) {
    f.p_start.push(start);
    f.p_end.push(end);
    f.p_name.push(name);
    f.p_ty.push(ty);
    let last = wrapping_sub(f.f_pn.len(), 1);
    let n = u64_at(in f.f_pn, last);
    let ok = f.f_pn.try_set(last, wrapping_add(n, 1));
}

fn u64_at(in s: ChunkSeq[u64], i: u64) -> u64 {
    s.try_get(i).unwrap_or(0)
}

// One hover's output text and work budget (`Text`, `Budget`).
struct Out {
    v: ChunkSeq[u8],
    left: u64,
    err: u64
}

fn stop(inout o: Out, code: u64) -> bool {
    if o.err == ERR_NONE {
        o.err = code;
    }
    false
}

// `Budget::charge` with `max_type_work` and `max_depth`.
fn charge(inout o: Out, depth: u64) -> bool {
    if o.left == 0 || depth > MAX_DEPTH {
        return stop(inout o, ERR_TRAVERSAL);
    }
    o.left = wrapping_sub(o.left, 1);
    true
}

// `text_write`: the whole piece fits under `max_output_bytes`, or nothing.
fn text(inout o: Out, in b: Slice[u8]) -> bool {
    if b.len() > wrapping_sub(MAX_OUTPUT_BYTES, o.v.len()) {
        return stop(inout o, ERR_OUTPUT_BYTES);
    }
    o.v.extend(in b);
    true
}

fn t(inout o: Out, in s: Str) -> bool {
    text(inout o, in s.as_bytes())
}

fn ast_name(inout o: Out, in a: Ast, sym: u32) -> bool {
    let mut b = ChunkSeq::new[u8]();
    put_name(inout b, in a, sym);
    text(inout o, in b.as_slice())
}

fn check_name(inout o: Out, in f: Facts, sym: u32) -> bool {
    let mut b = ChunkSeq::new[u8]();
    f.c.names.write(sym, inout b);
    text(inout o, in b.as_slice())
}

fn mode_name(m: u8) -> Str {
    if m == 0 {
        "copy"
    } else if m == 1 {
        "affine"
    } else {
        "linear"
    }
}

fn pass_name(p: u8) -> Str {
    if p == 0 {
        "in"
    } else if p == 1 {
        "inout"
    } else {
        "sink"
    }
}

// The check-data symbol spelled like AST name `sym`, or NONE.
fn check_symbol(in x: Ix, in f: Facts, sym: u32) -> u32 {
    let mut b = ChunkSeq::new[u8]();
    put_name(inout b, in x.ast, sym);
    f.c.names.lookup(in b.as_slice())
}

// ------------------------------------------------- checker types

// `print_type` of a checker type.
fn check_type(inout o: Out, in f: Facts, ty: u32, depth: u64) -> bool {
    if !charge(inout o, depth) {
        return false;
    }
    let n = f.c.types.node(ty);
    let d = wrapping_add(depth, 1);
    if n.kind == CT_LIT {
        if !t(inout o, in "integer literal ") {
            return false;
        }
        let mut b = ChunkSeq::new[u8]();
        if n.mode != 0 {
            b.push(45);
        }
        put_decimal(inout b, wrapping_u64(n.lit));
        text(inout o, in b.as_slice())
    } else if n.kind == CT_NAMED {
        if !check_name(inout o, in f, n.name) {
            return false;
        }
        if n.n == 0 {
            return true;
        }
        if !t(inout o, in "[") {
            return false;
        }
        for i in 0..w(n.n) {
            if i > 0 && !t(inout o, in ", ") {
                return false;
            }
            if !check_type(inout o, in f, f.c.types.arg(ty, i), d) {
                return false;
            }
        }
        t(inout o, in "]")
    } else if n.kind == CT_TUPLE {
        if !t(inout o, in "(") {
            return false;
        }
        for i in 0..w(n.n) {
            if i > 0 && !t(inout o, in ", ") {
                return false;
            }
            if !check_type(inout o, in f, f.c.types.arg(ty, i), d) {
                return false;
            }
        }
        t(inout o, in ")")
    } else if n.kind == CT_ROW {
        check_effects(inout o, in f, n.r2, d)
    } else if n.kind == CT_FN {
        if !t(inout o, in mode_name(n.mode)) || !t(inout o, in " fn(") {
            return false;
        }
        for i in 0..w(n.n) {
            if i > 0 && !t(inout o, in ", ") {
                return false;
            }
            if !t(inout o, in pass_name(f.c.types.param_pass(ty, i))) || !t(inout o, in " ") {
                return false;
            }
            if !check_type(inout o, in f, f.c.types.arg(ty, i), d) {
                return false;
            }
        }
        if !t(inout o, in ") -> ") {
            return false;
        }
        if !check_type(inout o, in f, n.r, d) {
            return false;
        }
        if !t(inout o, in " ") {
            return false;
        }
        check_effects(inout o, in f, n.r2, d)
    } else {
        t(inout o, in "_")
    }
}

fn put_decimal(inout b: ChunkSeq[u8], n: u64) {
    if n >= 10 {
        put_decimal(inout b, n / 10);
    }
    b.push(wrapping_u8(wrapping_add(n % 10, 48)));
}

// `print_effects` of a checker row.
fn check_effects(inout o: Out, in f: Facts, r: u32, depth: u64) -> bool {
    if !charge(inout o, depth) || !t(inout o, in "eff [") {
        return false;
    }
    let row = f.c.types.row(r);
    let d = wrapping_add(depth, 1);
    for i in 0..w(row.n) {
        if !charge(inout o, depth) {
            return false;
        }
        if i > 0 && !t(inout o, in ", ") {
            return false;
        }
        let e = f.c.types.effect_at(wrapping_add(w(row.a), i));
        if e.label != 0 {
            if !check_name(inout o, in f, wrapping_sub(e.label, 1)) || !t(inout o, in ": ") {
                return false;
            }
        }
        if !check_name(inout o, in f, e.name) {
            return false;
        }
        if e.n != 0 {
            if !t(inout o, in "[") {
                return false;
            }
            for j in 0..w(e.n) {
                if j > 0 && !t(inout o, in ", ") {
                    return false;
                }
                let arg = u32_at(in f.c.types.items, wrapping_add(w(e.a), j));
                if !check_type(inout o, in f, arg, d) {
                    return false;
                }
            }
            if !t(inout o, in "]") {
                return false;
            }
        }
    }
    if row.tail != 0 {
        if row.n != 0 && !t(inout o, in " | ") {
            return false;
        }
        if !check_name(inout o, in f, wrapping_sub(row.tail, 1)) {
            return false;
        }
    }
    t(inout o, in "]")
}

// ------------------------------------------------- source types

fn type_at(in a: Ast, i: u32) -> TypeNode {
    a.types.get_or(
        idx_from_raw[TypeNode](i),
        TypeNode { kind: AT_INFER, a: NONE, b: NONE, c: NONE, d: NONE }
    )
}

fn effects_at(in a: Ast, i: u32) -> EffectsNode {
    a.effects.get_or(idx_from_raw[EffectsNode](i), EffectsNode { instances: NONE, tail: NONE })
}

fn effect_at(in a: Ast, i: u32) -> EffectNode {
    a.effect_nodes
        .get_or(idx_from_raw[EffectNode](i), EffectNode { label: NONE, name: NONE, args: NONE })
}

fn generic_at(in a: Ast, i: u32) -> GenericNode {
    a.generics
        .get_or(idx_from_raw[GenericNode](i), GenericNode { name: NONE, bound: 0, row: false })
}

// `print_type` of a source type.
fn source_type(inout o: Out, in a: Ast, ty: u32, depth: u64) -> bool {
    if !charge(inout o, depth) {
        return false;
    }
    let n = type_at(in a, ty);
    let d = wrapping_add(depth, 1);
    if n.kind == AT_NAMED {
        if !ast_name(inout o, in a, n.a) {
            return false;
        }
        let k = list_len(in a, n.b);
        if k == 0 {
            return true;
        }
        if !t(inout o, in "[") {
            return false;
        }
        for i in 0..k {
            if i > 0 && !t(inout o, in ", ") {
                return false;
            }
            if !source_type(inout o, in a, list_at(in a, n.b, i), d) {
                return false;
            }
        }
        t(inout o, in "]")
    } else if n.kind == AT_TUPLE {
        if !t(inout o, in "(") {
            return false;
        }
        for i in 0..list_len(in a, n.a) {
            if i > 0 && !t(inout o, in ", ") {
                return false;
            }
            if !source_type(inout o, in a, list_at(in a, n.a, i), d) {
                return false;
            }
        }
        t(inout o, in ")")
    } else if n.kind == AT_ROW {
        source_effects(inout o, in a, n.a, d)
    } else if n.kind == AT_FUNCTION {
        if !t(inout o, in mode_name(wrapping_u8(n.d))) || !t(inout o, in " fn(") {
            return false;
        }
        // A list of (pass, Type) word pairs.
        let k = list_len(in a, n.a) >> 1;
        for i in 0..k {
            if i > 0 && !t(inout o, in ", ") {
                return false;
            }
            let at = wrapping_add(i, i);
            let pass = wrapping_u8(list_at(in a, n.a, at));
            if !t(inout o, in pass_name(pass)) || !t(inout o, in " ") {
                return false;
            }
            if !source_type(inout o, in a, list_at(in a, n.a, wrapping_add(at, 1)), d) {
                return false;
            }
        }
        if !t(inout o, in ") -> ") {
            return false;
        }
        if !source_type(inout o, in a, n.b, d) {
            return false;
        }
        if !t(inout o, in " ") {
            return false;
        }
        source_effects(inout o, in a, n.c, d)
    } else {
        t(inout o, in "_")
    }
}

// `print_effects` of source effects.
fn source_effects(inout o: Out, in a: Ast, e: u32, depth: u64) -> bool {
    if !charge(inout o, depth) || !t(inout o, in "eff [") {
        return false;
    }
    let row = effects_at(in a, e);
    let d = wrapping_add(depth, 1);
    let k = list_len(in a, row.instances);
    for i in 0..k {
        if !charge(inout o, depth) {
            return false;
        }
        if i > 0 && !t(inout o, in ", ") {
            return false;
        }
        let x = effect_at(in a, list_at(in a, row.instances, i));
        if x.label != NONE {
            if !ast_name(inout o, in a, x.label) || !t(inout o, in ": ") {
                return false;
            }
        }
        if !ast_name(inout o, in a, x.name) {
            return false;
        }
        let m = list_len(in a, x.args);
        if m != 0 {
            if !t(inout o, in "[") {
                return false;
            }
            for j in 0..m {
                if j > 0 && !t(inout o, in ", ") {
                    return false;
                }
                if !source_type(inout o, in a, list_at(in a, x.args, j), d) {
                    return false;
                }
            }
            if !t(inout o, in "]") {
                return false;
            }
        }
    }
    if row.tail != NONE {
        if k != 0 && !t(inout o, in " | ") {
            return false;
        }
        if !ast_name(inout o, in a, row.tail) {
            return false;
        }
    }
    t(inout o, in "]")
}

// ------------------------------------------------- modes

// `mode_work`: the cost of `World::mode`, charged before the checked
// operation runs. `seen` holds the recursion keys as words: name, the
// number of argument modes, then the modes.
fn mode_work(
    inout o: Out,
    inout f: Facts,
    ty: u32,
    in bounds: Bounds,
    inout seen: ChunkSeq[u32],
    depth: u64
) -> u8 {
    if !charge(inout o, depth) {
        return 255;
    }
    let n = f.c.types.node(ty);
    let d = wrapping_add(depth, 1);
    if n.kind == CT_FN {
        return n.mode;
    }
    if n.kind == CT_TUPLE {
        let mut m: u8 = 0;
        for i in 0..w(n.n) {
            let x = mode_work(inout o, inout f, f.c.types.arg(ty, i), in bounds, inout seen, d);
            if x == 255 {
                return 255;
            }
            m = join(m, x);
        }
        return m;
    }
    if n.kind != CT_NAMED {
        return 0;
    }
    let b = bounds.get(n.name);
    if b != 255 {
        return b;
    }
    let k = f.c.world.k;
    if k.is_scalar(n.name) {
        return 0;
    }
    if n.name == k.string {
        return 1;
    }
    let ai = f.c.world.lookup(n.name);
    if ai == NONE {
        return 2;
    }
    let adt = f.c.world.adt(ai);
    let mut modes = ChunkSeq::new[u8]();
    for i in 0..w(n.n) {
        let x = mode_work(inout o, inout f, f.c.types.arg(ty, i), in bounds, inout seen, d);
        if x == 255 {
            return 255;
        }
        modes.push(x);
    }
    if seen_has(in seen, n.name, in modes) {
        return adt.mode;
    }
    let old = seen.len();
    seen.push(n.name);
    seen.push(n32(modes.len()));
    for i in 0..modes.len() {
        seen.push(widen_u32(u8_at(in modes, i)));
    }
    let mut inner = bounds_new();
    let pairs = if w(adt.gn) < modes.len() {
        w(adt.gn)
    } else {
        modes.len()
    };
    for i in 0..pairs {
        let g = f.c.world.generic(wrapping_add(w(adt.ga), i));
        inner.set(g.name, u8_at(in modes, i));
    }
    let mut m = adt.mode;
    for v in 0..w(adt.vn) {
        let variant = f.c.world.variant(wrapping_add(w(adt.va), v));
        for j in 0..w(variant.fc) {
            let field = f.c.world.field(wrapping_add(w(variant.fa), j));
            let intrinsic = mode_work(inout o, inout f, field.ty, in inner, inout seen, d);
            if intrinsic == 255 {
                return 255;
            }
            m = join(
                m,
                if field.modality == 0 {
                    intrinsic
                } else {
                    wrapping_sub(field.modality, 1)
                }
            );
        }
    }
    seen.truncate(old);
    m
}

fn join(a: u8, b: u8) -> u8 {
    if a > b { a } else { b }
}

fn seen_has(in seen: ChunkSeq[u32], name: u32, in modes: ChunkSeq[u8]) -> bool {
    let mut i: u64 = 0;
    loop {
        if i >= seen.len() {
            return false;
        }
        let n = w(u32_at(in seen, wrapping_add(i, 1)));
        if u32_at(in seen, i) == name && n == modes.len() {
            let mut same = true;
            for j in 0..n {
                if u32_at(in seen, wrapping_add(wrapping_add(i, 2), j))
                    != widen_u32(u8_at(in modes, j)) {
                    same = false;
                    break;
                }
            }
            if same {
                return true;
            }
        }
        i = wrapping_add(i, wrapping_add(n, 2));
    }
}

// `checked_mode`: the generic bounds of function node `fnode`, the mode
// work, then `World::mode`. 255 when the budget ran out.
fn checked_mode(inout o: Out, inout f: Facts, in x: Ix, ty: u32, fnode: u32) -> u8 {
    let node = fn_at(in x.ast, fnode);
    let k = list_len(in x.ast, node.generics);
    let mut bounds = bounds_new();
    for i in 0..k {
        if !charge(inout o, 0) {
            return 255;
        }
    }
    for i in 0..k {
        let g = generic_at(in x.ast, list_at(in x.ast, node.generics, i));
        let s = check_symbol(in x, in f, g.name);
        if s != NONE {
            bounds.set(s, g.bound);
        }
    }
    let mut seen = ChunkSeq::new[u32]();
    if mode_work(inout o, inout f, ty, in bounds, inout seen, 0) == 255 {
        return 255;
    }
    mode_of(inout f.c.types, in f.c.names, in f.c.world, ty, in bounds)
}

// ------------------------------------------------- signature

// The checker's function row for function node `fnode` whose span equals
// the node's (`functions.get(name).filter(span == f.span)`), + 1, or 0.
fn world_function(in x: Ix, in f: Facts, fnode: u32) -> u64 {
    let node = fn_at(in x.ast, fnode);
    let s = check_symbol(in x, in f, node.name);
    if s == NONE {
        return 0;
    }
    for i in 0..f.f_name.len() {
        if u32_at(in f.f_name, i) == s {
            if u64_at(in f.f_start, i) == w(node.start) && u64_at(in f.f_end, i) == w(node.end) {
                return wrapping_add(i, 1);
            }
            return 0;
        }
    }
    0
}

fn selectors(inout o: Out, in a: Ast, projections: u32) -> bool {
    let k = list_len(in a, projections);
    if k == 0 {
        return true;
    }
    if !t(inout o, in ".{") {
        return false;
    }
    for i in 0..k {
        if i > 0 && !t(inout o, in ", ") {
            return false;
        }
        let path = list_at(in a, projections, i);
        for j in 0..list_len(in a, path) {
            if !charge(inout o, 0) {
                return false;
            }
            if j > 0 && !t(inout o, in ".") {
                return false;
            }
            if !ast_name(inout o, in a, list_at(in a, path, j)) {
                return false;
            }
        }
    }
    t(inout o, in "}")
}

fn signature(inout o: Out, in f: Facts, in x: Ix, fnode: u32) -> bool {
    let node = fn_at(in x.ast, fnode);
    if !t(inout o, in "fn ") || !ast_name(inout o, in x.ast, node.name) {
        return false;
    }
    let k = list_len(in x.ast, node.generics);
    if k != 0 {
        if !t(inout o, in "[") {
            return false;
        }
        for i in 0..k {
            if !charge(inout o, 0) {
                return false;
            }
            if i > 0 && !t(inout o, in ", ") {
                return false;
            }
            let g = generic_at(in x.ast, list_at(in x.ast, node.generics, i));
            if !ast_name(inout o, in x.ast, g.name) {
                return false;
            }
            if g.row {
                if !t(inout o, in ": eff") {
                    return false;
                }
            } else if !t(inout o, in ": mod ") || !t(inout o, in mode_name(g.bound)) {
                return false;
            }
        }
        if !t(inout o, in "]") {
            return false;
        }
    }
    if !t(inout o, in "(") {
        return false;
    }
    for i in 0..list_len(in x.ast, node.params) {
        if !charge(inout o, 0) {
            return false;
        }
        if i > 0 && !t(inout o, in ", ") {
            return false;
        }
        let p = param_at(in x.ast, list_at(in x.ast, node.params, i));
        if !t(inout o, in pass_name(p.pass)) || !t(inout o, in " ") {
            return false;
        }
        if !ast_name(inout o, in x.ast, p.name) || !selectors(inout o, in x.ast, p.projections) {
            return false;
        }
        if !t(inout o, in ": ") || !source_type(inout o, in x.ast, p.ty, 0) {
            return false;
        }
    }
    if !t(inout o, in ") -> ") {
        return false;
    }
    let row = world_function(in x, in f, fnode);
    let result = if row == 0 {
        NONE
    } else {
        u32_at(in f.f_result, wrapping_sub(row, 1))
    };
    let printed = if result != NONE {
        check_type(inout o, in f, result, 0)
    } else {
        source_type(inout o, in x.ast, node.result, 0)
    };
    if !printed || !t(inout o, in " ") {
        return false;
    }
    source_effects(inout o, in x.ast, node.effects, 0)
}

// `docs`: the `///` lines attached before byte `start`, each after a
// newline, in plain text.
fn docs(inout o: Out, in x: Ix, start: u64) -> bool {
    let b = x.src.as_bytes();
    // Pending lines as (start, end) words.
    let mut pending = ChunkSeq::new[u64]();
    for i in 0..x.t.kind.len() {
        let s = token_start(in x, i);
        if s >= start {
            break;
        }
        let e = token_end(in x.t, i);
        let k = u8_at(in x.t.kind, i);
        if k == TK_COMMENT
            && wrapping_sub(e, s) >= 3
            && byte(in b, s) == 47
            && byte(in b, wrapping_add(s, 1)) == 47
            && byte(in b, wrapping_add(s, 2)) == 47
            && !(wrapping_sub(e, s) >= 4 && byte(in b, wrapping_add(s, 3)) == 47) {
            let mut from = wrapping_add(s, 3);
            if from < e && byte(in b, from) == 32 {
                from = wrapping_add(from, 1);
            }
            pending.push(wrapping_shl_u64(from, 32) | e);
        } else if k == TK_WHITESPACE {
            let mut lines: u64 = 0;
            for j in s..e {
                if byte(in b, j) == 10 {
                    lines = wrapping_add(lines, 1);
                }
            }
            if lines > 1 {
                pending.clear();
            }
        } else {
            pending.clear();
        }
    }
    for i in 0..pending.len() {
        let v = u64_at(in pending, i);
        if !t(inout o, in "\n") || !text(inout o, in b[wrapping_shr_u64(v, 32)..(v & 4294967295)]) {
            return false;
        }
    }
    true
}

// ------------------------------------------------- hover

// The first declaration whose selection is `s..e`, or all ones.
fn declaration_at_target(in x: Ix, s: u64, e: u64) -> u64 {
    for i in 0..x.d_name.len() {
        if w(u32_at(in x.d_sel_start, i)) == s && w(u32_at(in x.d_sel_end, i)) == e {
            return i;
        }
    }
    18446744073709551615
}

// The answer to one hover request on `x` with facts `f`, appended to
// `out` as `R<json>`, `Rnull` or `E<error>` (`put_error` codes).
pub fn hover_answer(
    inout out: ChunkSeq[u8],
    inout x: Ix,
    inout f: Facts,
    line: u32,
    character: u32
) -> u64 {
    if x.err != ERR_NONE {
        return x.err;
    }
    let mut at: u64 = 0;
    if !cursor(inout x, line, character, inout at) {
        return x.err;
    }
    let mut o = Out { v: ChunkSeq::new[u8](), left: MAX_TYPE_WORK, err: ERR_NONE };
    let mut sel_start: u64 = 0;
    let mut sel_end: u64 = 0;
    let best = node_at(in x, at);
    if best != 0 {
        let i = wrapping_sub(best, 1);
        let ns = w(u32_at(in x.n_start, i));
        let ne = w(u32_at(in x.n_end, i));
        let fnode = u32_at(in x.n_fn, i);
        let param = u32_at(in x.n_param, i);
        let mut ty = f.c.world.expr_type(ns, ne);
        if ty == NONE && param != 0 {
            let p = param_at(in x.ast, wrapping_sub(param, 1));
            let row = world_function(in x, in f, fnode);
            if row != 0 {
                let r = wrapping_sub(row, 1);
                let pa = u64_at(in f.f_pa, r);
                let ps = check_symbol(in x, in f, p.name);
                for j in 0..u64_at(in f.f_pn, r) {
                    let q = wrapping_add(pa, j);
                    if u64_at(in f.p_start, q) == w(p.start)
                        && u64_at(in f.p_end, q) == w(p.end)
                        && u32_at(in f.p_name, q) == ps {
                        let pt = u32_at(in f.p_ty, q);
                        if f.c.types.node(pt).kind != 5 {
                            ty = pt;
                        }
                        break;
                    }
                }
            }
        }
        if ty == NONE {
            put(inout out, in "Rnull");
            return ERR_NONE;
        }
        if !t(inout o, in "type: ") || !check_type(inout o, in f, ty, 0) {
            return o.err;
        }
        let mode = checked_mode(inout o, inout f, in x, ty, fnode);
        if mode == 255 {
            return o.err;
        }
        if !t(inout o, in "\ntype mode: ")
            || !t(inout o, in mode_name(mode))
            || !t(inout o, in " (not current ownership or a live obligation)") {
            return o.err;
        }
        if param != 0 {
            let p = param_at(in x.ast, wrapping_sub(param, 1));
            if !t(inout o, in "\nparameter: ")
                || !t(inout o, in pass_name(p.pass))
                || !t(inout o, in " ")
                || !ast_name(inout o, in x.ast, p.name)
                || !selectors(inout o, in x.ast, p.projections) {
                return o.err;
            }
        }
        let ts = u32_at(in x.n_tstart, i);
        if ts != 0 {
            let target_s = w(wrapping_sub(ts, 1));
            let target_e = w(wrapping_sub(u32_at(in x.n_tend, i), 1));
            let d = declaration_at_target(in x, target_s, target_e);
            if d != 18446744073709551615 {
                let df = u32_at(in x.d_fn, d);
                if df != NONE {
                    if !t(inout o, in "\n") || !signature(inout o, in f, in x, df) {
                        return o.err;
                    }
                    if !docs(inout o, in x, w(u32_at(in x.d_start, d))) {
                        return o.err;
                    }
                }
            }
        }
        sel_start = ns;
        sel_end = ne;
    } else {
        let mut found: u64 = 18446744073709551615;
        for i in 0..x.d_name.len() {
            let s = w(u32_at(in x.d_sel_start, i));
            let e = w(u32_at(in x.d_sel_end, i));
            if s <= at && at < e {
                found = i;
                break;
            }
        }
        if found == 18446744073709551615 {
            put(inout out, in "Rnull");
            return ERR_NONE;
        }
        let df = u32_at(in x.d_fn, found);
        if df != NONE {
            if !signature(inout o, in f, in x, df) {
                return o.err;
            }
        } else {
            let name = u32_at(in x.d_name, found);
            if !ast_name(inout o, in x.ast, name) {
                return o.err;
            }
            let s = check_symbol(in x, in f, name);
            if s != NONE {
                let ai = f.c.world.lookup(s);
                if ai != NONE {
                    let adt = f.c.world.adt(ai);
                    if !t(inout o, in "\ndeclared mode: ") || !t(inout o, in mode_name(adt.mode)) {
                        return o.err;
                    }
                }
            }
        }
        if !docs(inout o, in x, w(u32_at(in x.d_start, found))) {
            return o.err;
        }
        sel_start = w(u32_at(in x.d_sel_start, found));
        sel_end = w(u32_at(in x.d_sel_end, found));
    }
    let mut v = ChunkSeq::new[u8]();
    put(inout v, in "{\"contents\":{\"kind\":\"plaintext\",\"value\":");
    put_string(inout v, in o.v.as_slice());
    put(inout v, in "},\"range\":");
    if !put_source_range(inout v, inout x, sel_start, sel_end) {
        return x.err;
    }
    v.push(125);
    if v.len() > MAX_OUTPUT_BYTES {
        return ERR_OUTPUT_BYTES;
    }
    out.push(82);
    put_bytes(inout out, in v.as_slice());
    ERR_NONE
}
