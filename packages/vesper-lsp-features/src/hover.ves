// `navigation::hover` (src/lsp/navigation.rs) in Vesper: the standard LSP
// plaintext hover over the lexical index (nav.ves) and the checker's
// facts.
//
// The facts arrive in @vesper/check-data's harness layout (names, types and
// the world section, whose expression types are `Checked::expression_types`),
// followed by the checker's function table (`World::functions` with
// `World::function_results`). Types the checker computed are printed from
// the check-data type table; types written in the source (a signature's
// parameters, generic bounds and effects) from the @vesper/ast tree, as
// `print_type` prints both from one `ast::Type`.

use @vesper/ast::{Ast, TypeNode, EffectsNode, EffectNode, GenericNode, list_len, list_at};
use @vesper/check-data::input::{Ctx};
use @vesper/check-data::world::{Bounds, bounds_new, mode_of};
use @vesper-std/arena::{idx_from_raw};
use self::json::{byte, put, put_bytes, put_string};
use self::nav::{
    Ix, ERR_NONE, ERR_TRAVERSAL, ERR_OUTPUT_BYTES, MAX_DEPTH, MAX_OUTPUT_BYTES, cursor, fn_at, hi,
    lo, n32, node_at, param_at, put_name, put_source_range, token_start, u32_at, u8_at, w
};
use @vesper/front::lex::{token_end};

const NONE: u32 = 4294967295;

// `navigation::Limits::default().max_type_work`.
pub const MAX_TYPE_WORK: u64 = 8192;

const TK_WHITESPACE: u8 = 0;
const TK_COMMENT: u8 = 1;

// AST type kinds (@vesper/ast `TypeNode`).
const AT_NAMED: u8 = 1;
const AT_TUPLE: u8 = 2;
const AT_FUNCTION: u8 = 3;
const AT_ROW: u8 = 4;
const AT_INFER: u8 = 5;

// Check-data type kinds (`TyKind`).
const CT_LIT: u8 = 0;
const CT_NAMED: u8 = 1;
const CT_TUPLE: u8 = 2;
const CT_FN: u8 = 3;
const CT_ROW: u8 = 4;

// The checker's facts: the check-data context and the function table,
// one row per `World::functions` entry in name order.
pub struct Facts {
    ctx: Ctx,
    // Name symbol, span, parameter rows
    // `fn_param_start .. fn_param_start + fn_param_count`, and the
    // `function_results` type (NONE when the world has none).
    fn_name: ChunkSeq[u32],
    fn_start: ChunkSeq[u64],
    fn_end: ChunkSeq[u64],
    fn_param_start: ChunkSeq[u64],
    fn_param_count: ChunkSeq[u64],
    fn_result: ChunkSeq[u32],
    // Parameter rows: span, name symbol, type.
    param_start: ChunkSeq[u64],
    param_end: ChunkSeq[u64],
    param_name: ChunkSeq[u32],
    param_ty: ChunkSeq[u32]
}

pub fn facts_new(sink ctx: Ctx) -> Facts {
    Facts {
        ctx: ctx,
        fn_name: ChunkSeq::new[u32](),
        fn_start: ChunkSeq::new[u64](),
        fn_end: ChunkSeq::new[u64](),
        fn_param_start: ChunkSeq::new[u64](),
        fn_param_count: ChunkSeq::new[u64](),
        fn_result: ChunkSeq::new[u32](),
        param_start: ChunkSeq::new[u64](),
        param_end: ChunkSeq::new[u64](),
        param_name: ChunkSeq::new[u32](),
        param_ty: ChunkSeq::new[u32]()
    }
}

// Adds one function row; its parameters follow with `fact_param`.
pub fn fact_function(inout facts: Facts, name: u32, start: u64, end: u64, result: u32) {
    facts.fn_name.push(name);
    facts.fn_start.push(start);
    facts.fn_end.push(end);
    facts.fn_param_start.push(facts.param_name.len());
    facts.fn_param_count.push(0);
    facts.fn_result.push(result);
}

pub fn fact_param(inout facts: Facts, start: u64, end: u64, name: u32, ty: u32) {
    facts.param_start.push(start);
    facts.param_end.push(end);
    facts.param_name.push(name);
    facts.param_ty.push(ty);
    let last = wrapping_sub(facts.fn_param_count.len(), 1);
    let n = u64_at(in facts.fn_param_count, last);
    let ok = facts.fn_param_count.try_set(last, wrapping_add(n, 1));
}

fn u64_at(in column: ChunkSeq[u64], i: u64) -> u64 {
    column.try_get(i).unwrap_or(0)
}

// One hover's output text and work budget (`Text`, `Budget`).
struct Out {
    text: ChunkSeq[u8],
    left: u64,
    err: u64
}

fn stop(inout out: Out, code: u64) -> bool {
    if out.err == ERR_NONE {
        out.err = code;
    }
    false
}

// `Budget::charge` with `max_type_work` and `max_depth`.
fn charge(inout out: Out, depth: u64) -> bool {
    if out.left == 0 || depth > MAX_DEPTH {
        return stop(inout out, ERR_TRAVERSAL);
    }
    out.left = wrapping_sub(out.left, 1);
    true
}

// `text_write`: the whole piece fits under `max_output_bytes`, or nothing.
fn text(inout out: Out, in bytes: Slice[u8]) -> bool {
    if bytes.len() > wrapping_sub(MAX_OUTPUT_BYTES, out.text.len()) {
        return stop(inout out, ERR_OUTPUT_BYTES);
    }
    out.text.extend(in bytes);
    true
}

fn t(inout out: Out, in s: Str) -> bool {
    text(inout out, in s.as_bytes())
}

fn ast_name(inout out: Out, in ast: Ast, sym: u32) -> bool {
    let mut name = ChunkSeq::new[u8]();
    put_name(inout name, in ast, sym);
    text(inout out, in name.as_slice())
}

fn check_name(inout out: Out, in facts: Facts, sym: u32) -> bool {
    let mut name = ChunkSeq::new[u8]();
    facts.ctx.names.write(sym, inout name);
    text(inout out, in name.as_slice())
}

fn mode_name(mode: u8) -> Str {
    if mode == 0 {
        "copy"
    } else if mode == 1 {
        "affine"
    } else {
        "linear"
    }
}

fn pass_name(pass: u8) -> Str {
    if pass == 0 {
        "in"
    } else if pass == 1 {
        "inout"
    } else {
        "sink"
    }
}

// The check-data symbol spelled like AST name `sym`, or NONE.
fn check_symbol(in index: Ix, in facts: Facts, sym: u32) -> u32 {
    let mut name = ChunkSeq::new[u8]();
    put_name(inout name, in index.ast, sym);
    facts.ctx.names.lookup(in name.as_slice())
}

// ------------------------------------------------- checker types

// `print_type` of a checker type.
fn check_type(inout out: Out, in facts: Facts, ty: u32, depth: u64) -> bool {
    if !charge(inout out, depth) {
        return false;
    }
    let node = facts.ctx.types.node(ty);
    let child_depth = wrapping_add(depth, 1);
    if node.kind == CT_LIT {
        if !t(inout out, in "integer literal ") {
            return false;
        }
        let mut digits = ChunkSeq::new[u8]();
        if node.mode != 0 {
            digits.push(45);
        }
        put_decimal(inout digits, wrapping_u64(node.lit));
        text(inout out, in digits.as_slice())
    } else if node.kind == CT_NAMED {
        if !check_name(inout out, in facts, node.name) {
            return false;
        }
        if node.n == 0 {
            return true;
        }
        if !t(inout out, in "[") {
            return false;
        }
        for i in 0..w(node.n) {
            if i > 0 && !t(inout out, in ", ") {
                return false;
            }
            if !check_type(inout out, in facts, facts.ctx.types.arg(ty, i), child_depth) {
                return false;
            }
        }
        t(inout out, in "]")
    } else if node.kind == CT_TUPLE {
        if !t(inout out, in "(") {
            return false;
        }
        for i in 0..w(node.n) {
            if i > 0 && !t(inout out, in ", ") {
                return false;
            }
            if !check_type(inout out, in facts, facts.ctx.types.arg(ty, i), child_depth) {
                return false;
            }
        }
        t(inout out, in ")")
    } else if node.kind == CT_ROW {
        check_effects(inout out, in facts, node.r2, child_depth)
    } else if node.kind == CT_FN {
        if !t(inout out, in mode_name(node.mode)) || !t(inout out, in " fn(") {
            return false;
        }
        for i in 0..w(node.n) {
            if i > 0 && !t(inout out, in ", ") {
                return false;
            }
            if !t(inout out, in pass_name(facts.ctx.types.param_pass(ty, i)))
                || !t(inout out, in " ")
            {
                return false;
            }
            if !check_type(inout out, in facts, facts.ctx.types.arg(ty, i), child_depth) {
                return false;
            }
        }
        if !t(inout out, in ") -> ") {
            return false;
        }
        if !check_type(inout out, in facts, node.r, child_depth) {
            return false;
        }
        if !t(inout out, in " ") {
            return false;
        }
        check_effects(inout out, in facts, node.r2, child_depth)
    } else {
        t(inout out, in "_")
    }
}

fn put_decimal(inout out: ChunkSeq[u8], n: u64) {
    if n >= 10 {
        put_decimal(inout out, n / 10);
    }
    out.push(wrapping_u8(wrapping_add(n % 10, 48)));
}

// `print_effects` of a checker row.
fn check_effects(inout out: Out, in facts: Facts, row_ty: u32, depth: u64) -> bool {
    if !charge(inout out, depth) || !t(inout out, in "eff [") {
        return false;
    }
    let row = facts.ctx.types.row(row_ty);
    let child_depth = wrapping_add(depth, 1);
    for i in 0..w(row.n) {
        if !charge(inout out, depth) {
            return false;
        }
        if i > 0 && !t(inout out, in ", ") {
            return false;
        }
        let entry = facts.ctx.types.effect_at(wrapping_add(w(row.a), i));
        if entry.label != 0 {
            if !check_name(inout out, in facts, wrapping_sub(entry.label, 1))
                || !t(inout out, in ": ")
            {
                return false;
            }
        }
        if !check_name(inout out, in facts, entry.name) {
            return false;
        }
        if entry.n != 0 {
            if !t(inout out, in "[") {
                return false;
            }
            for j in 0..w(entry.n) {
                if j > 0 && !t(inout out, in ", ") {
                    return false;
                }
                let arg = u32_at(in facts.ctx.types.items, wrapping_add(w(entry.a), j));
                if !check_type(inout out, in facts, arg, child_depth) {
                    return false;
                }
            }
            if !t(inout out, in "]") {
                return false;
            }
        }
    }
    if row.tail != 0 {
        if row.n != 0 && !t(inout out, in " | ") {
            return false;
        }
        if !check_name(inout out, in facts, wrapping_sub(row.tail, 1)) {
            return false;
        }
    }
    t(inout out, in "]")
}

// ------------------------------------------------- source types

fn type_at(in ast: Ast, i: u32) -> TypeNode {
    ast.types.get_or(
        idx_from_raw[TypeNode](i),
        TypeNode { kind: AT_INFER, a: NONE, b: NONE, c: NONE, d: NONE }
    )
}

fn effects_at(in ast: Ast, i: u32) -> EffectsNode {
    ast.effects.get_or(idx_from_raw[EffectsNode](i), EffectsNode { instances: NONE, tail: NONE })
}

fn effect_at(in ast: Ast, i: u32) -> EffectNode {
    ast.effect_nodes
        .get_or(idx_from_raw[EffectNode](i), EffectNode { label: NONE, name: NONE, args: NONE })
}

fn generic_at(in ast: Ast, i: u32) -> GenericNode {
    ast.generics
        .get_or(idx_from_raw[GenericNode](i), GenericNode { name: NONE, bound: 0, row: false })
}

// `print_type` of a source type.
fn source_type(inout out: Out, in ast: Ast, ty: u32, depth: u64) -> bool {
    if !charge(inout out, depth) {
        return false;
    }
    let node = type_at(in ast, ty);
    let child_depth = wrapping_add(depth, 1);
    if node.kind == AT_NAMED {
        if !ast_name(inout out, in ast, node.a) {
            return false;
        }
        let arg_count = list_len(in ast, node.b);
        if arg_count == 0 {
            return true;
        }
        if !t(inout out, in "[") {
            return false;
        }
        for i in 0..arg_count {
            if i > 0 && !t(inout out, in ", ") {
                return false;
            }
            if !source_type(inout out, in ast, list_at(in ast, node.b, i), child_depth) {
                return false;
            }
        }
        t(inout out, in "]")
    } else if node.kind == AT_TUPLE {
        if !t(inout out, in "(") {
            return false;
        }
        for i in 0..list_len(in ast, node.a) {
            if i > 0 && !t(inout out, in ", ") {
                return false;
            }
            if !source_type(inout out, in ast, list_at(in ast, node.a, i), child_depth) {
                return false;
            }
        }
        t(inout out, in ")")
    } else if node.kind == AT_ROW {
        source_effects(inout out, in ast, node.a, child_depth)
    } else if node.kind == AT_FUNCTION {
        if !t(inout out, in mode_name(wrapping_u8(node.d))) || !t(inout out, in " fn(") {
            return false;
        }
        // A list of (pass, Type) word pairs.
        let arg_count = list_len(in ast, node.a) >> 1;
        for i in 0..arg_count {
            if i > 0 && !t(inout out, in ", ") {
                return false;
            }
            let at = wrapping_add(i, i);
            let pass = wrapping_u8(list_at(in ast, node.a, at));
            if !t(inout out, in pass_name(pass)) || !t(inout out, in " ") {
                return false;
            }
            if !source_type(
                inout out,
                in ast,
                list_at(in ast, node.a, wrapping_add(at, 1)),
                child_depth
            ) {
                return false;
            }
        }
        if !t(inout out, in ") -> ") {
            return false;
        }
        if !source_type(inout out, in ast, node.b, child_depth) {
            return false;
        }
        if !t(inout out, in " ") {
            return false;
        }
        source_effects(inout out, in ast, node.c, child_depth)
    } else {
        t(inout out, in "_")
    }
}

// `print_effects` of source effects.
fn source_effects(inout out: Out, in ast: Ast, effects_node: u32, depth: u64) -> bool {
    if !charge(inout out, depth) || !t(inout out, in "eff [") {
        return false;
    }
    let row = effects_at(in ast, effects_node);
    let child_depth = wrapping_add(depth, 1);
    let instance_count = list_len(in ast, row.instances);
    for i in 0..instance_count {
        if !charge(inout out, depth) {
            return false;
        }
        if i > 0 && !t(inout out, in ", ") {
            return false;
        }
        let instance = effect_at(in ast, list_at(in ast, row.instances, i));
        if instance.label != NONE {
            if !ast_name(inout out, in ast, instance.label) || !t(inout out, in ": ") {
                return false;
            }
        }
        if !ast_name(inout out, in ast, instance.name) {
            return false;
        }
        let arg_count = list_len(in ast, instance.args);
        if arg_count != 0 {
            if !t(inout out, in "[") {
                return false;
            }
            for j in 0..arg_count {
                if j > 0 && !t(inout out, in ", ") {
                    return false;
                }
                if !source_type(inout out, in ast, list_at(in ast, instance.args, j), child_depth) {
                    return false;
                }
            }
            if !t(inout out, in "]") {
                return false;
            }
        }
    }
    if row.tail != NONE {
        if instance_count != 0 && !t(inout out, in " | ") {
            return false;
        }
        if !ast_name(inout out, in ast, row.tail) {
            return false;
        }
    }
    t(inout out, in "]")
}

// ------------------------------------------------- modes

// `mode_work`: the cost of `World::mode`, charged before the checked
// operation runs. `seen` holds the recursion keys as words: name, the
// number of argument modes, then the modes.
fn mode_work(
    inout out: Out,
    inout facts: Facts,
    ty: u32,
    in bounds: Bounds,
    inout seen: ChunkSeq[u32],
    depth: u64
) -> u8 {
    if !charge(inout out, depth) {
        return 255;
    }
    let node = facts.ctx.types.node(ty);
    let child_depth = wrapping_add(depth, 1);
    if node.kind == CT_FN {
        return node.mode;
    }
    if node.kind == CT_TUPLE {
        let mut mode: u8 = 0;
        for i in 0..w(node.n) {
            let arg_mode = mode_work(
                inout out,
                inout facts,
                facts.ctx.types.arg(ty, i),
                in bounds,
                inout seen,
                child_depth
            );
            if arg_mode == 255 {
                return 255;
            }
            mode = join(mode, arg_mode);
        }
        return mode;
    }
    if node.kind != CT_NAMED {
        return 0;
    }
    let bound_mode = bounds.get(node.name);
    if bound_mode != 255 {
        return bound_mode;
    }
    let known = facts.ctx.world.k;
    if known.is_scalar(node.name) {
        return 0;
    }
    if node.name == known.string {
        return 1;
    }
    let adt_index = facts.ctx.world.lookup(node.name);
    if adt_index == NONE {
        return 2;
    }
    let adt = facts.ctx.world.adt(adt_index);
    let mut modes = ChunkSeq::new[u8]();
    for i in 0..w(node.n) {
        let arg_mode = mode_work(
            inout out,
            inout facts,
            facts.ctx.types.arg(ty, i),
            in bounds,
            inout seen,
            child_depth
        );
        if arg_mode == 255 {
            return 255;
        }
        modes.push(arg_mode);
    }
    if seen_has(in seen, node.name, in modes) {
        return adt.mode;
    }
    let seen_len = seen.len();
    seen.push(node.name);
    seen.push(n32(modes.len()));
    for i in 0..modes.len() {
        seen.push(widen_u32(u8_at(in modes, i)));
    }
    let mut inner = bounds_new();
    let pairs = if w(adt.gn) < modes.len() {
        w(adt.gn)
    } else {
        modes.len()
    };
    for i in 0..pairs {
        let generic = facts.ctx.world.generic(wrapping_add(w(adt.ga), i));
        inner.set(generic.name, u8_at(in modes, i));
    }
    let mut mode = adt.mode;
    for variant_index in 0..w(adt.vn) {
        let variant = facts.ctx.world.variant(wrapping_add(w(adt.va), variant_index));
        for j in 0..w(variant.fc) {
            let field = facts.ctx.world.field(wrapping_add(w(variant.fa), j));
            let intrinsic = mode_work(
                inout out,
                inout facts,
                field.ty,
                in inner,
                inout seen,
                child_depth
            );
            if intrinsic == 255 {
                return 255;
            }
            mode = join(
                mode,
                if field.modality == 0 {
                    intrinsic
                } else {
                    wrapping_sub(field.modality, 1)
                }
            );
        }
    }
    seen.truncate(seen_len);
    mode
}

fn join(a: u8, b: u8) -> u8 {
    if a > b { a } else { b }
}

fn seen_has(in seen: ChunkSeq[u32], name: u32, in modes: ChunkSeq[u8]) -> bool {
    let mut i: u64 = 0;
    loop {
        if i >= seen.len() {
            return false;
        }
        let mode_count = w(u32_at(in seen, wrapping_add(i, 1)));
        if u32_at(in seen, i) == name && mode_count == modes.len() {
            let mut same = true;
            for j in 0..mode_count {
                if u32_at(in seen, wrapping_add(wrapping_add(i, 2), j))
                    != widen_u32(u8_at(in modes, j))
                {
                    same = false;
                    break;
                }
            }
            if same {
                return true;
            }
        }
        i = wrapping_add(i, wrapping_add(mode_count, 2));
    }
}

// `checked_mode`: the generic bounds of function node `fnode`, the mode
// work, then `World::mode`. 255 when the budget ran out.
fn checked_mode(inout out: Out, inout facts: Facts, in index: Ix, ty: u32, fnode: u32) -> u8 {
    let node = fn_at(in index.ast, fnode);
    let generic_count = list_len(in index.ast, node.generics);
    let mut bounds = bounds_new();
    for i in 0..generic_count {
        if !charge(inout out, 0) {
            return 255;
        }
    }
    for i in 0..generic_count {
        let generic = generic_at(in index.ast, list_at(in index.ast, node.generics, i));
        let check_sym = check_symbol(in index, in facts, generic.name);
        if check_sym != NONE {
            bounds.set(check_sym, generic.bound);
        }
    }
    let mut seen = ChunkSeq::new[u32]();
    if mode_work(inout out, inout facts, ty, in bounds, inout seen, 0) == 255 {
        return 255;
    }
    mode_of(inout facts.ctx.types, in facts.ctx.names, in facts.ctx.world, ty, in bounds)
}

// ------------------------------------------------- signature

// The checker's function row for function node `fnode` whose span equals
// the node's (`functions.get(name).filter(span == f.span)`), + 1, or 0.
fn world_function(in index: Ix, in facts: Facts, fnode: u32) -> u64 {
    let node = fn_at(in index.ast, fnode);
    let name_sym = check_symbol(in index, in facts, node.name);
    if name_sym == NONE {
        return 0;
    }
    for i in 0..facts.fn_name.len() {
        if u32_at(in facts.fn_name, i) == name_sym {
            if u64_at(in facts.fn_start, i) == w(node.start)
                && u64_at(in facts.fn_end, i) == w(node.end)
            {
                return wrapping_add(i, 1);
            }
            return 0;
        }
    }
    0
}

fn selectors(inout out: Out, in ast: Ast, projections: u32) -> bool {
    let path_count = list_len(in ast, projections);
    if path_count == 0 {
        return true;
    }
    if !t(inout out, in ".{") {
        return false;
    }
    for i in 0..path_count {
        if i > 0 && !t(inout out, in ", ") {
            return false;
        }
        let path = list_at(in ast, projections, i);
        for j in 0..list_len(in ast, path) {
            if !charge(inout out, 0) {
                return false;
            }
            if j > 0 && !t(inout out, in ".") {
                return false;
            }
            if !ast_name(inout out, in ast, list_at(in ast, path, j)) {
                return false;
            }
        }
    }
    t(inout out, in "}")
}

fn signature(inout out: Out, in facts: Facts, in index: Ix, fnode: u32) -> bool {
    let node = fn_at(in index.ast, fnode);
    if !t(inout out, in "fn ") || !ast_name(inout out, in index.ast, node.name) {
        return false;
    }
    let generic_count = list_len(in index.ast, node.generics);
    if generic_count != 0 {
        if !t(inout out, in "[") {
            return false;
        }
        for i in 0..generic_count {
            if !charge(inout out, 0) {
                return false;
            }
            if i > 0 && !t(inout out, in ", ") {
                return false;
            }
            let generic = generic_at(in index.ast, list_at(in index.ast, node.generics, i));
            if !ast_name(inout out, in index.ast, generic.name) {
                return false;
            }
            if generic.row {
                if !t(inout out, in ": eff") {
                    return false;
                }
            } else if !t(inout out, in ": mod ") || !t(inout out, in mode_name(generic.bound)) {
                return false;
            }
        }
        if !t(inout out, in "]") {
            return false;
        }
    }
    if !t(inout out, in "(") {
        return false;
    }
    for i in 0..list_len(in index.ast, node.params) {
        if !charge(inout out, 0) {
            return false;
        }
        if i > 0 && !t(inout out, in ", ") {
            return false;
        }
        let param = param_at(in index.ast, list_at(in index.ast, node.params, i));
        if !t(inout out, in pass_name(param.pass)) || !t(inout out, in " ") {
            return false;
        }
        if !ast_name(inout out, in index.ast, param.name)
            || !selectors(inout out, in index.ast, param.projections)
        {
            return false;
        }
        if !t(inout out, in ": ") || !source_type(inout out, in index.ast, param.ty, 0) {
            return false;
        }
    }
    if !t(inout out, in ") -> ") {
        return false;
    }
    let row = world_function(in index, in facts, fnode);
    let result = if row == 0 {
        NONE
    } else {
        u32_at(in facts.fn_result, wrapping_sub(row, 1))
    };
    let printed = if result != NONE {
        check_type(inout out, in facts, result, 0)
    } else {
        source_type(inout out, in index.ast, node.result, 0)
    };
    if !printed || !t(inout out, in " ") {
        return false;
    }
    source_effects(inout out, in index.ast, node.effects, 0)
}

// `docs`: the `///` lines attached before byte `start`, each after a
// newline, in plain text.
fn docs(inout out: Out, in index: Ix, start: u64) -> bool {
    let bytes = index.src.as_bytes();
    // Pending lines as (start, end) words.
    let mut pending = ChunkSeq::new[u64]();
    for i in 0..index.tokens.kind.len() {
        let tok_start = token_start(in index, i);
        if tok_start >= start {
            break;
        }
        let tok_end = token_end(in index.tokens, i);
        let kind = u8_at(in index.tokens.kind, i);
        if kind == TK_COMMENT
            && wrapping_sub(tok_end, tok_start) >= 3
            && byte(in bytes, tok_start) == 47
            && byte(in bytes, wrapping_add(tok_start, 1)) == 47
            && byte(in bytes, wrapping_add(tok_start, 2)) == 47
            && !(wrapping_sub(tok_end, tok_start) >= 4
                && byte(in bytes, wrapping_add(tok_start, 3)) == 47)
        {
            let mut from = wrapping_add(tok_start, 3);
            if from < tok_end && byte(in bytes, from) == 32 {
                from = wrapping_add(from, 1);
            }
            pending.push(wrapping_shl_u64(from, 32) | tok_end);
        } else if kind == TK_WHITESPACE {
            let mut lines: u64 = 0;
            for j in tok_start..tok_end {
                if byte(in bytes, j) == 10 {
                    lines = wrapping_add(lines, 1);
                }
            }
            if lines > 1 {
                pending.clear();
            }
        } else {
            pending.clear();
        }
    }
    for i in 0..pending.len() {
        let packed = u64_at(in pending, i);
        if !t(inout out, in "\n")
            || !text(inout out, in bytes[wrapping_shr_u64(packed, 32)..(packed & 4294967295)])
        {
            return false;
        }
    }
    true
}

// ------------------------------------------------- hover

// The first declaration whose selection is `s..e`, or all ones.
fn declaration_at_target(in index: Ix, s: u64, e: u64) -> u64 {
    for i in 0..index.decl_name.len() {
        if w(u32_at(in index.decl_sel_start, i)) == s && w(u32_at(in index.decl_sel_end, i)) == e {
            return i;
        }
    }
    18446744073709551615
}

// The answer to one hover request on `index` with facts `facts`, appended to
// `out` as `R<json>`, `Rnull` or `E<error>` (`put_error` codes).
pub fn hover_answer(
    inout out: ChunkSeq[u8],
    inout index: Ix,
    inout facts: Facts,
    line: u32,
    character: u32
) -> u64 {
    if index.err != ERR_NONE {
        return index.err;
    }
    let mut at: u64 = 0;
    if !cursor(inout index, line, character, inout at) {
        return index.err;
    }
    let mut hover = Out { text: ChunkSeq::new[u8](), left: MAX_TYPE_WORK, err: ERR_NONE };
    let mut sel_start: u64 = 0;
    let mut sel_end: u64 = 0;
    let best = node_at(in index, at);
    if best != 0 {
        let i = wrapping_sub(best, 1);
        let node_start = w(u32_at(in index.node_start, i));
        let node_end = w(u32_at(in index.node_end, i));
        let fnode = u32_at(in index.node_fn, i);
        let param = u32_at(in index.node_param, i);
        let mut ty = facts.ctx.world.expr_type(node_start, node_end);
        if ty == NONE && param != 0 {
            let param_node = param_at(in index.ast, wrapping_sub(param, 1));
            let row = world_function(in index, in facts, fnode);
            if row != 0 {
                let fn_row = wrapping_sub(row, 1);
                let first_param = u64_at(in facts.fn_param_start, fn_row);
                let param_sym = check_symbol(in index, in facts, param_node.name);
                for j in 0..u64_at(in facts.fn_param_count, fn_row) {
                    let param_row = wrapping_add(first_param, j);
                    if u64_at(in facts.param_start, param_row) == w(param_node.start)
                        && u64_at(in facts.param_end, param_row) == w(param_node.end)
                        && u32_at(in facts.param_name, param_row) == param_sym
                    {
                        let param_ty = u32_at(in facts.param_ty, param_row);
                        if facts.ctx.types.node(param_ty).kind != 5 {
                            ty = param_ty;
                        }
                        break;
                    }
                }
            }
        }
        if ty == NONE {
            put(inout out, in "Rnull");
            return ERR_NONE;
        }
        if !t(inout hover, in "type: ") || !check_type(inout hover, in facts, ty, 0) {
            return hover.err;
        }
        let mode = checked_mode(inout hover, inout facts, in index, ty, fnode);
        if mode == 255 {
            return hover.err;
        }
        if !t(inout hover, in "\ntype mode: ")
            || !t(inout hover, in mode_name(mode))
            || !t(inout hover, in " (not current ownership or a live obligation)")
        {
            return hover.err;
        }
        if param != 0 {
            let param_node = param_at(in index.ast, wrapping_sub(param, 1));
            if !t(inout hover, in "\nparameter: ")
                || !t(inout hover, in pass_name(param_node.pass))
                || !t(inout hover, in " ")
                || !ast_name(inout hover, in index.ast, param_node.name)
                || !selectors(inout hover, in index.ast, param_node.projections)
            {
                return hover.err;
            }
        }
        let target_tag = u32_at(in index.node_target_start, i);
        if target_tag != 0 {
            let target_start = w(wrapping_sub(target_tag, 1));
            let target_end = w(wrapping_sub(u32_at(in index.node_target_end, i), 1));
            let decl = declaration_at_target(in index, target_start, target_end);
            if decl != 18446744073709551615 {
                let decl_fn = u32_at(in index.decl_fn, decl);
                if decl_fn != NONE {
                    if !t(inout hover, in "\n")
                        || !signature(inout hover, in facts, in index, decl_fn)
                    {
                        return hover.err;
                    }
                    if !docs(inout hover, in index, w(u32_at(in index.decl_start, decl))) {
                        return hover.err;
                    }
                }
            }
        }
        sel_start = node_start;
        sel_end = node_end;
    } else {
        let mut found: u64 = 18446744073709551615;
        for i in 0..index.decl_name.len() {
            let start = w(u32_at(in index.decl_sel_start, i));
            let end = w(u32_at(in index.decl_sel_end, i));
            if start <= at && at < end {
                found = i;
                break;
            }
        }
        if found == 18446744073709551615 {
            put(inout out, in "Rnull");
            return ERR_NONE;
        }
        let decl_fn = u32_at(in index.decl_fn, found);
        if decl_fn != NONE {
            if !signature(inout hover, in facts, in index, decl_fn) {
                return hover.err;
            }
        } else {
            let name = u32_at(in index.decl_name, found);
            if !ast_name(inout hover, in index.ast, name) {
                return hover.err;
            }
            let name_sym = check_symbol(in index, in facts, name);
            if name_sym != NONE {
                let adt_index = facts.ctx.world.lookup(name_sym);
                if adt_index != NONE {
                    let adt = facts.ctx.world.adt(adt_index);
                    if !t(inout hover, in "\ndeclared mode: ")
                        || !t(inout hover, in mode_name(adt.mode))
                    {
                        return hover.err;
                    }
                }
            }
        }
        if !docs(inout hover, in index, w(u32_at(in index.decl_start, found))) {
            return hover.err;
        }
        sel_start = w(u32_at(in index.decl_sel_start, found));
        sel_end = w(u32_at(in index.decl_sel_end, found));
    }
    let mut result_json = ChunkSeq::new[u8]();
    put(inout result_json, in "{\"contents\":{\"kind\":\"plaintext\",\"value\":");
    put_string(inout result_json, in hover.text.as_slice());
    put(inout result_json, in "},\"range\":");
    if !put_source_range(inout result_json, inout index, sel_start, sel_end) {
        return index.err;
    }
    result_json.push(125);
    if result_json.len() > MAX_OUTPUT_BYTES {
        return ERR_OUTPUT_BYTES;
    }
    out.push(82);
    put_bytes(inout out, in result_json.as_slice());
    ERR_NONE
}
