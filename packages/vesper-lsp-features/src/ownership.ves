// The ownership facts behind Lens views (src/lsp/lens.rs: `facts`, the
// `Walker`, `live` and `resolve`) in Vesper: every binding of each checked
// function, whether it is a linear obligation its frame owns, and where it
// is consumed (inside which branch arms), and from those the obligations
// still live at a cursor (`View::outstanding`).
//
// Bindings are read from the source's tree (@vesper/ast). Types come from
// the checker's facts (@vesper/check-data's harness layout): annotations
// are interned into its type table, unannotated `let`s take the type the
// checker gave the value, and modes are `World::mode`. The callee table
// (each function's parameter passes, and each effect operation's) is the
// checker's `World::functions` and `World::effects`, as the harness lays
// it out.

use @vesper/ast::{
    Ast, ExprNode, PatNode, StmtNode, ArgNode, ParamNode, FnNode, ImplNode, ItemNode, TypeNode,
    EffectsNode, EffectNode, ClauseNode, list_len, list_at, expr_at, pat_at
};
use @vesper/ast::lower::{lower_source};
use @vesper/check-data::input::{Ctx, Reader as CtxReader, read_ctx};
use @vesper/check-data::types::{EffNode, Vars, vars_new, substitute, display as type_display};
use @vesper/check-data::world::{
    Adt, Generic, Variant, Field, Bounds, bounds_new, mode_of, constructor
};
use @vesper-std/intern::{symbol_from_id};
use self::json::{byte, pack, put, put_bytes, put_position, put_range, put_string, put_u64};
use self::nav::{
    arg_at, clause_at, fn_at, impl_at, item_at, param_at, put_name, put_span_error, stmt_at
};
use @vesper/span::{ByteSpan, Limits, Position, Range, line_table, offset, position, range};
use @vesper/span::Error as SpanError;
use self::proof_types::{ty_at, effects_at, effect_at};

const NONE: u32 = 4294967295;
const NONE64: u64 = 18446744073709551615;

// `MAX_WORK` and `MAX_BINDINGS` of lens.rs.
const MAX_WORK: u64 = 262144;
const MAX_BINDINGS: u64 = 4096;

// Why there are no facts (`Unavailable`).
const OK: u8 = 0;
const RESOURCE: u8 = 1;
const OPAQUE: u8 = 2;

// @vesper/ast kinds.
const E_LIT: u8 = 1;
const E_NAME: u8 = 2;
const E_TUPLE: u8 = 3;
const E_STRUCT: u8 = 4;
const E_BLOCK: u8 = 5;
const E_CALL: u8 = 6;
const E_FIELD: u8 = 7;
const E_INDEX: u8 = 8;
const E_TRY: u8 = 9;
const E_UNARY: u8 = 10;
const E_BINARY: u8 = 11;
const E_ASSIGN: u8 = 12;
const E_IF: u8 = 13;
const E_MATCH: u8 = 14;
const E_CLOSURE: u8 = 15;
const E_HANDLE: u8 = 16;

const P_BIND: u8 = 2;
const P_TUPLE: u8 = 4;
const P_CONSTRUCTOR: u8 = 5;

const S_LET: u8 = 1;

const AT_NAMED: u8 = 1;
const AT_TUPLE: u8 = 2;
const AT_FUNCTION: u8 = 3;
const AT_ROW: u8 = 4;
const AT_LITERAL: u8 = 6;

const ITEM_FUNCTION: u8 = 2;
const ITEM_IMPL: u8 = 4;

// Check-data type kinds (`TyKind`) and the linear mode.
const CT_NAMED: u8 = 1;
const CT_TUPLE: u8 = 2;
const CT_FN: u8 = 3;
const LINEAR: u8 = 2;

const PASS_SINK: u8 = 2;

fn g32(in column: ChunkSeq[u32], i: u64) -> u32 {
    column.try_get(i).unwrap_or(NONE)
}

fn g64(in column: ChunkSeq[u64], i: u64) -> u64 {
    column.try_get(i).unwrap_or(0)
}

fn g8(in column: ChunkSeq[u8], i: u64) -> u8 {
    column.try_get(i).unwrap_or(0)
}

fn w(value: u32) -> u64 {
    widen_u64(value)
}

fn inc(value: u64) -> u64 {
    wrapping_add(value, 1)
}

// ------------------------------------------------------------ callees

// `World::functions` and `World::effects` as the walker reads them: per
// function (by name symbol of the tree's interner) its parameter passes and
// whether its first parameter is `self`; per effect its operations.
struct Callees {
    // AST symbol -> function index + 1 (0: not a function).
    fn_by_sym: ChunkSeq[u32],
    fn_pass_start: ChunkSeq[u32],
    fn_pass_count: ChunkSeq[u32],
    fn_self: ChunkSeq[u8],
    // AST symbol -> effect index + 1.
    effect_by_sym: ChunkSeq[u32],
    effect_op_start: ChunkSeq[u32],
    effect_op_count: ChunkSeq[u32],
    op_sym: ChunkSeq[u32],
    op_pass_start: ChunkSeq[u32],
    op_pass_count: ChunkSeq[u32],
    passes: ChunkSeq[u8]
}

// ------------------------------------------------------------ the walker

// The facts of every function walked so far (`FunctionFacts`), and the
// walker's state for the current one (`Walker`).
struct Ow {
    // Per function: span and its bindings (bindings[fn_binding_start..+fn_binding_count]).
    fn_start: ChunkSeq[u64],
    fn_end: ChunkSeq[u64],
    fn_binding_start: ChunkSeq[u32],
    fn_binding_count: ChunkSeq[u32],
    // Per binding.
    binding_name: ChunkSeq[u32],
    binding_origin_start: ChunkSeq[u64],
    binding_origin_end: ChunkSeq[u64],
    binding_ty: ChunkSeq[u32],
    binding_linear: ChunkSeq[u8],
    binding_owned: ChunkSeq[u8],
    binding_scope_start: ChunkSeq[u64],
    binding_scope_end: ChunkSeq[u64],
    // First and last event + 1 (0: none).
    binding_first_event: ChunkSeq[u32],
    binding_last_event: ChunkSeq[u32],
    // Per event: span, next event of its binding + 1, and its enclosing
    // (arm, construct) pairs, 4 words each, at
    // branch_pool[event_branch_start..+4 * event_branch_count].
    event_start: ChunkSeq[u64],
    event_end: ChunkSeq[u64],
    event_next: ChunkSeq[u32],
    event_branch_start: ChunkSeq[u32],
    event_branch_count: ChunkSeq[u32],
    branch_pool: ChunkSeq[u64],
    // The current function: its first binding, scope stack of binding
    // indices with the start of each frame, and the branch stack.
    first: u64,
    scope: ChunkSeq[u32],
    marks: ChunkSeq[u64],
    branches: ChunkSeq[u64],
    work: u64,
    err: u8,
    // AST type index -> type id + 1; AST symbol -> check-data symbol + 1.
    tmap: ChunkSeq[u32],
    nmap: ChunkSeq[u32],
    buf: ChunkSeq[u8],
    // Per parse, kept across views like the checker's mode cache: type id
    // -> mode + 1, and AST symbol -> `World::constructor` + 2 (0: unknown).
    modes: ChunkSeq[u8],
    ctors: ChunkSeq[u64],
    // The query index (`index_facts`): per function its owned linear
    // bindings (lin_idx[lin_first..+lin_count]), and whether the function
    // spans are in order and disjoint but for shared ends.
    lin_first: ChunkSeq[u32],
    lin_count: ChunkSeq[u32],
    lin_idx: ChunkSeq[u32],
    sorted: bool
}

fn ow_new() -> Ow {
    Ow {
        fn_start: ChunkSeq::new[u64](),
        fn_end: ChunkSeq::new[u64](),
        fn_binding_start: ChunkSeq::new[u32](),
        fn_binding_count: ChunkSeq::new[u32](),
        binding_name: ChunkSeq::new[u32](),
        binding_origin_start: ChunkSeq::new[u64](),
        binding_origin_end: ChunkSeq::new[u64](),
        binding_ty: ChunkSeq::new[u32](),
        binding_linear: ChunkSeq::new[u8](),
        binding_owned: ChunkSeq::new[u8](),
        binding_scope_start: ChunkSeq::new[u64](),
        binding_scope_end: ChunkSeq::new[u64](),
        binding_first_event: ChunkSeq::new[u32](),
        binding_last_event: ChunkSeq::new[u32](),
        event_start: ChunkSeq::new[u64](),
        event_end: ChunkSeq::new[u64](),
        event_next: ChunkSeq::new[u32](),
        event_branch_start: ChunkSeq::new[u32](),
        event_branch_count: ChunkSeq::new[u32](),
        branch_pool: ChunkSeq::new[u64](),
        first: 0,
        scope: ChunkSeq::new[u32](),
        marks: ChunkSeq::new[u64](),
        branches: ChunkSeq::new[u64](),
        work: 0,
        err: OK,
        tmap: ChunkSeq::new[u32](),
        nmap: ChunkSeq::new[u32](),
        buf: ChunkSeq::new[u8](),
        modes: ChunkSeq::new[u8](),
        ctors: ChunkSeq::new[u64](),
        lin_first: ChunkSeq::new[u32](),
        lin_count: ChunkSeq::new[u32](),
        lin_idx: ChunkSeq::new[u32](),
        sorted: true
    }
}

fn ow_clear(inout walker: Ow) {
    walker.fn_start.clear();
    walker.fn_end.clear();
    walker.fn_binding_start.clear();
    walker.fn_binding_count.clear();
    walker.binding_name.clear();
    walker.binding_origin_start.clear();
    walker.binding_origin_end.clear();
    walker.binding_ty.clear();
    walker.binding_linear.clear();
    walker.binding_owned.clear();
    walker.binding_scope_start.clear();
    walker.binding_scope_end.clear();
    walker.binding_first_event.clear();
    walker.binding_last_event.clear();
    walker.event_start.clear();
    walker.event_end.clear();
    walker.event_next.clear();
    walker.event_branch_start.clear();
    walker.event_branch_count.clear();
    walker.branch_pool.clear();
    walker.first = 0;
    walker.scope.clear();
    walker.marks.clear();
    walker.branches.clear();
    walker.work = 0;
    walker.err = OK;
    walker.lin_first.clear();
    walker.lin_count.clear();
    walker.lin_idx.clear();
    walker.sorted = true;
}

fn table_get(in table: ChunkSeq[u32], i: u32) -> u32 {
    table.try_get(w(i)).unwrap_or(0)
}

fn table_set(inout table: ChunkSeq[u32], i: u32, value: u32) {
    loop {
        if table.len() > w(i) {
            break;
        }
        table.push(0);
    }
    let ok = table.try_set(w(i), value);
}

// ------------------------------------------------------------ types

// The check-data symbol of AST symbol `sym` (interned).
fn nsym(inout walker: Ow, inout ctx: Ctx, in ast: Ast, sym: u32) -> u32 {
    let mapped = table_get(in walker.nmap, sym);
    if mapped != 0 {
        return wrapping_sub(mapped, 1);
    }
    walker.buf.clear();
    put_name(inout walker.buf, in ast, sym);
    let interned = ctx.names.intern(in walker.buf.as_slice());
    table_set(inout walker.nmap, sym, wrapping_add(interned, 1));
    interned
}

// The type id of AST type `ast_ty` (`Type` as the checker's table holds it).
fn tid(inout walker: Ow, inout ctx: Ctx, in ast: Ast, ast_ty: u32) -> u32 {
    let mapped = table_get(in walker.tmap, ast_ty);
    if mapped != 0 {
        return wrapping_sub(mapped, 1);
    }
    let node = ty_at(in ast, ast_ty);
    let mut id: u32 = ctx.types.infer;
    if node.kind == AT_NAMED || node.kind == AT_TUPLE {
        let list = if node.kind == AT_NAMED {
            node.b
        } else {
            node.a
        };
        let len = list_len(in ast, list);
        let mut args = ChunkSeq::with_capacity[u32](len);
        for j in 0..len {
            let arg_id = tid(inout walker, inout ctx, in ast, list_at(in ast, list, j));
            args.push(arg_id);
        }
        if node.kind == AT_NAMED {
            let name = nsym(inout walker, inout ctx, in ast, node.a);
            id = ctx.types.named(name, in args);
        } else {
            id = ctx.types.tuple(in args);
        }
    } else if node.kind == AT_FUNCTION {
        let len = list_len(in ast, node.a) / 2;
        let mut items = ChunkSeq::with_capacity[u32](len);
        let mut passes = ChunkSeq::with_capacity[u8](len);
        for j in 0..len {
            let pass = list_at(in ast, node.a, wrapping_mul(j, 2));
            let arg_ty = list_at(in ast, node.a, inc(wrapping_mul(j, 2)));
            passes.push(wrapping_u8(pass));
            let arg_id = tid(inout walker, inout ctx, in ast, arg_ty);
            items.push(arg_id);
        }
        let result_id = tid(inout walker, inout ctx, in ast, node.b);
        let row = rid(inout walker, inout ctx, in ast, node.c);
        id = ctx.types
            .mk_with(CT_FN, wrapping_u8(node.d), 0, in items, in passes, result_id, row, 0);
    } else if node.kind == AT_ROW {
        let row = rid(inout walker, inout ctx, in ast, node.a);
        id = ctx.types.row_type(row);
    } else if node.kind == AT_LITERAL {
        id = ctx.types.literal(false, 0);
    }
    table_set(inout walker.tmap, ast_ty, wrapping_add(id, 1));
    id
}

// The row id of an AST `Effects` node.
fn rid(inout walker: Ow, inout ctx: Ctx, in ast: Ast, effects_id: u32) -> u32 {
    let effects = effects_at(in ast, effects_id);
    let instance_count = list_len(in ast, effects.instances);
    let mut entries = ChunkSeq::new[EffNode]();
    let mut args = ChunkSeq::new[u32]();
    for j in 0..instance_count {
        let instance = effect_at(in ast, list_at(in ast, effects.instances, j));
        let arg_start = wrapping_u32(args.len());
        let arg_count = list_len(in ast, instance.args);
        for arg_index in 0..arg_count {
            let arg_id = tid(
                inout walker,
                inout ctx,
                in ast,
                list_at(in ast, instance.args, arg_index)
            );
            args.push(arg_id);
        }
        let label = if instance.label == NONE {
            0
        } else {
            wrapping_add(nsym(inout walker, inout ctx, in ast, instance.label), 1)
        };
        let name = nsym(inout walker, inout ctx, in ast, instance.name);
        entries
            .push(EffNode { label: label, name: name, a: arg_start, n: wrapping_u32(arg_count) });
    }
    let tail = if effects.tail == NONE {
        0
    } else {
        wrapping_add(nsym(inout walker, inout ctx, in ast, effects.tail), 1)
    };
    ctx.types.mk_row(in entries, in args, tail)
}

// `mentions`: whether `ty` names `name` (a Named type, or inside Named,
// Tuple or Function types).
fn mentions(in ctx: Ctx, ty: u32, name: u32) -> bool {
    let node = ctx.types.node(ty);
    if node.kind == CT_NAMED || node.kind == CT_TUPLE {
        if node.kind == CT_NAMED && node.name == name {
            return true;
        }
        for i in 0..w(node.n) {
            if mentions(in ctx, ctx.types.arg(ty, i), name) {
                return true;
            }
        }
        return false;
    }
    if node.kind == CT_FN {
        for i in 0..w(node.n) {
            if mentions(in ctx, ctx.types.arg(ty, i), name) {
                return true;
            }
        }
        return mentions(in ctx, node.r, name);
    }
    false
}

fn is_linear(inout walker: Ow, inout ctx: Ctx, ty: u32) -> bool {
    if ty == ctx.types.infer {
        return false;
    }
    let known = g8(in walker.modes, w(ty));
    if known != 0 {
        return wrapping_sub(known, 1) == LINEAR;
    }
    let none = bounds_new();
    let mode = mode_of(inout ctx.types, in ctx.names, in ctx.world, ty, in none);
    loop {
        if walker.modes.len() > w(ty) {
            break;
        }
        walker.modes.push(0);
    }
    let ok = walker.modes.try_set(w(ty), wrapping_add(mode, 1));
    mode == LINEAR
}

// ------------------------------------------------------------ bindings

fn charge(inout walker: Ow) -> bool {
    walker.work = inc(walker.work);
    if walker.work > MAX_WORK
        || wrapping_sub(walker.binding_name.len(), walker.first) > MAX_BINDINGS
    {
        walker.err = RESOURCE;
        return false;
    }
    true
}

fn bind(
    inout walker: Ow,
    inout ctx: Ctx,
    name: u32,
    origin_start: u64,
    origin_end: u64,
    ty: u32,
    owned: bool,
    scope_start: u64,
    scope_end: u64
) -> bool {
    if !charge(inout walker) {
        return false;
    }
    let linear = is_linear(inout walker, inout ctx, ty);
    let index = wrapping_u32(walker.binding_name.len());
    walker.binding_name.push(name);
    walker.binding_origin_start.push(origin_start);
    walker.binding_origin_end.push(origin_end);
    walker.binding_ty.push(ty);
    walker.binding_linear.push(if linear { 1 } else { 0 });
    walker.binding_owned.push(if owned { 1 } else { 0 });
    walker.binding_scope_start.push(scope_start);
    walker.binding_scope_end.push(scope_end);
    walker.binding_first_event.push(0);
    walker.binding_last_event.push(0);
    walker.scope.push(index);
    true
}

// The innermost binding of `name` in scope, or NONE.
fn lookup(in walker: Ow, name: u32) -> u32 {
    let mut i = walker.scope.len();
    loop {
        if i == 0 {
            return NONE;
        }
        i = wrapping_sub(i, 1);
        let binding = g32(in walker.scope, i);
        if g32(in walker.binding_name, w(binding)) == name {
            return binding;
        }
    }
}

fn push_scope(inout walker: Ow) {
    walker.marks.push(walker.scope.len());
}

fn pop_scope(inout walker: Ow) {
    let mark = walker.marks.pop().unwrap_or(0);
    loop {
        if walker.scope.len() <= mark {
            break;
        }
        let _ = walker.scope.pop();
    }
}

fn record_use(inout walker: Ow, name: u32, start: u64, end: u64) {
    let binding = lookup(in walker, name);
    if binding == NONE {
        return;
    }
    let event = wrapping_u32(walker.event_start.len());
    walker.event_start.push(start);
    walker.event_end.push(end);
    walker.event_next.push(0);
    walker.event_branch_start.push(wrapping_u32(walker.branch_pool.len()));
    walker.event_branch_count.push(wrapping_u32(walker.branches.len() / 4));
    for i in 0..walker.branches.len() {
        walker.branch_pool.push(g64(in walker.branches, i));
    }
    let tail = g32(in walker.binding_last_event, w(binding));
    if tail == 0 {
        let ok = walker.binding_first_event.try_set(w(binding), wrapping_add(event, 1));
    } else {
        let ok = walker.event_next.try_set(w(wrapping_sub(tail, 1)), wrapping_add(event, 1));
    }
    let ok = walker.binding_last_event.try_set(w(binding), wrapping_add(event, 1));
}

// `ty_of`: a local's own type, else the checker's type of the expression.
fn ty_of(in walker: Ow, in ctx: Ctx, in ast: Ast, expr_id: u32) -> u32 {
    let node = expr_at(in ast, expr_id);
    if node.kind == E_NAME {
        let binding = lookup(in walker, node.a);
        if binding != NONE {
            return g32(in walker.binding_ty, w(binding));
        }
    }
    let ty = ctx.world.expr_type(w(node.start), w(node.end));
    if ty == NONE { ctx.types.infer } else { ty }
}

// The check-data symbol of AST name `sym`, if the checker has one.
fn csym(inout walker: Ow, in ctx: Ctx, in ast: Ast, sym: u32) -> u32 {
    walker.buf.clear();
    put_name(inout walker.buf, in ast, sym);
    ctx.names.lookup(in walker.buf.as_slice())
}

// `"::"` occurrences in name `sym`, and the end of the last one's qualifier.
fn path_parts(in ast: Ast, sym: u32, inout first: u64, inout last: u64) -> u64 {
    let (from, to) = ast.names.span(symbol_from_id(sym));
    let len = wrapping_sub(to, from);
    let mut count: u64 = 0;
    first = NONE64;
    last = NONE64;
    let mut i: u64 = 0;
    loop {
        if inc(i) >= len {
            break;
        }
        let cur_byte = ast.names.text_byte(wrapping_add(from, i)).unwrap_or(0);
        let next_byte = ast.names.text_byte(wrapping_add(from, inc(i))).unwrap_or(0);
        if cur_byte == 58 && next_byte == 58 {
            count = inc(count);
            if first == NONE64 {
                first = i;
            }
            last = i;
            i = wrapping_add(i, 2);
        } else {
            i = inc(i);
        }
    }
    count
}

// The bytes of name `sym` from `from` to `to` into `walker.buf`.
fn name_slice(inout walker: Ow, in ast: Ast, sym: u32, from: u64, to: u64) {
    let (start, end) = ast.names.span(symbol_from_id(sym));
    walker.buf.clear();
    let mut i = wrapping_add(start, from);
    let stop = if to == NONE64 {
        end
    } else {
        wrapping_add(start, to)
    };
    loop {
        if i >= stop {
            break;
        }
        match ast.names.text_byte(i) {
            Option::Some(v) => walker.buf.push(v),
            Option::None => {},
        }
        i = inc(i);
    }
}

// `World::constructor(name)`: (ADT, variant index) packed, or NONE64.
fn ctor(inout walker: Ow, in ctx: Ctx, in ast: Ast, name: u32) -> u64 {
    let known = g64(in walker.ctors, w(name));
    if known != 0 {
        return wrapping_sub(known, 2);
    }
    let found = ctor_find(inout walker, in ctx, in ast, name);
    loop {
        if walker.ctors.len() > w(name) {
            break;
        }
        walker.ctors.push(0);
    }
    let ok = walker.ctors.try_set(w(name), wrapping_add(found, 2));
    found
}

fn ctor_find(inout walker: Ow, in ctx: Ctx, in ast: Ast, name: u32) -> u64 {
    let mut first: u64 = 0;
    let mut last: u64 = 0;
    let count = path_parts(in ast, name, inout first, inout last);
    if count > 1 {
        return NONE64;
    }
    let mut qual = NONE;
    if count == 1 {
        name_slice(inout walker, in ast, name, 0, last);
        qual = ctx.names.lookup(in walker.buf.as_slice());
        if qual == NONE {
            return NONE64;
        }
        name_slice(inout walker, in ast, name, wrapping_add(last, 2), NONE64);
    } else {
        name_slice(inout walker, in ast, name, 0, NONE64);
    }
    let short = ctx.names.lookup(in walker.buf.as_slice());
    if short == NONE {
        return NONE64;
    }
    constructor(in ctx.world, qual, short)
}

// `constructor_fields`: the field names (check-data symbols) and types of
// constructor `name` for a scrutinee of type `ty`, into `names`/`types`.
fn constructor_fields(
    inout walker: Ow,
    inout ctx: Ctx,
    in ast: Ast,
    name: u32,
    ty: u32,
    inout names: ChunkSeq[u32],
    inout types: ChunkSeq[u32]
) {
    names.clear();
    types.clear();
    let found = ctor(inout walker, in ctx, in ast, name);
    if found == NONE64 {
        return;
    }
    let adt = ctx.world.adt(wrapping_u32(wrapping_shr_u64(found, 32)));
    let variant = ctx.world.variant(found & 4294967295);
    let mut params = ChunkSeq::new[u32]();
    for i in 0..w(adt.gn) {
        let generic = ctx.world.generic(wrapping_add(w(adt.ga), i));
        if !generic.row {
            params.push(generic.name);
        }
    }
    let mut vars = vars_new();
    let ty_node = ctx.types.node(ty);
    if ty_node.kind == CT_NAMED && ty_node.name == adt.name && w(ty_node.n) == params.len() {
        for i in 0..params.len() {
            vars.set(g32(in params, i), ctx.types.arg(ty, i));
        }
    }
    for i in 0..w(variant.fc) {
        let field = ctx.world.field(wrapping_add(w(variant.fa), i));
        let mut field_ty = field.ty;
        if vars.is_empty() && params.len() > 0 {
            // Unknown type arguments: never guess a mode for them.
            for j in 0..params.len() {
                if mentions(in ctx, field.ty, g32(in params, j)) {
                    field_ty = ctx.types.infer;
                    break;
                }
            }
        } else {
            field_ty = substitute(inout ctx.types, field.ty, in vars);
        }
        names.push(field.name);
        types.push(field_ty);
    }
}

// `field.parse::<usize>()` of name `sym`, or NONE64.
fn parse_index(in ast: Ast, sym: u32) -> u64 {
    let (from, to) = ast.names.span(symbol_from_id(sym));
    let mut i = from;
    if i < to {
        match ast.names.text_byte(i) {
            Option::Some(v) => {
                if v == 43 {
                    i = inc(i);
                }
            },
            Option::None => {},
        }
    }
    if i >= to {
        return NONE64;
    }
    let mut value: u64 = 0;
    loop {
        if i >= to {
            break;
        }
        let ch = ast.names.text_byte(i).unwrap_or(0);
        if ch < 48 || ch > 57 {
            return NONE64;
        }
        let digit = widen_u64(wrapping_sub(ch, 48));
        if value > 1844674407370955161 || (value == 1844674407370955161 && digit > 5) {
            return NONE64;
        }
        value = wrapping_add(wrapping_mul(value, 10), digit);
        i = inc(i);
    }
    value
}

fn pattern(
    inout walker: Ow,
    inout ctx: Ctx,
    in ast: Ast,
    pat_id: u32,
    ty: u32,
    scope_start: u64,
    scope_end: u64
) -> bool {
    if !charge(inout walker) {
        return false;
    }
    let node = pat_at(in ast, pat_id);
    if node.kind == P_BIND {
        return bind(
            inout walker,
            inout ctx,
            node.a,
            w(node.start),
            w(node.end),
            ty,
            true,
            scope_start,
            scope_end
        );
    }
    if node.kind == P_TUPLE {
        let ty_node = ctx.types.node(ty);
        for i in 0..list_len(in ast, node.a) {
            let mut sub_ty = ctx.types.infer;
            if ty_node.kind == CT_TUPLE && i < w(ty_node.n) {
                sub_ty = ctx.types.arg(ty, i);
            }
            if !pattern(
                inout walker,
                inout ctx,
                in ast,
                list_at(in ast, node.a, i),
                sub_ty,
                scope_start,
                scope_end
            ) {
                return false;
            }
        }
        return true;
    }
    if node.kind == P_CONSTRUCTOR {
        let mut fnames = ChunkSeq::new[u32]();
        let mut ftypes = ChunkSeq::new[u32]();
        constructor_fields(inout walker, inout ctx, in ast, node.a, ty, inout fnames, inout ftypes);
        let named = node.c != 0;
        let count = list_len(in ast, node.b) / 2;
        for i in 0..count {
            let field = list_at(in ast, node.b, wrapping_mul(i, 2));
            let sub = list_at(in ast, node.b, inc(wrapping_mul(i, 2)));
            let fsym = csym(inout walker, in ctx, in ast, field);
            let mut by_name = NONE64;
            if fsym != NONE {
                for j in 0..fnames.len() {
                    if g32(in fnames, j) == fsym {
                        by_name = j;
                        break;
                    }
                }
            }
            let mut at = NONE64;
            if named {
                at = by_name;
            } else {
                let index_field = parse_index(in ast, field);
                if index_field != NONE64 && index_field < ftypes.len() {
                    at = index_field;
                } else if by_name != NONE64 {
                    at = by_name;
                } else if i < ftypes.len() {
                    at = i;
                }
            }
            let sub_ty = if at == NONE64 {
                ctx.types.infer
            } else {
                g32(in ftypes, at)
            };
            if !pattern(inout walker, inout ctx, in ast, sub, sub_ty, scope_start, scope_end) {
                return false;
            }
        }
        return true;
    }
    true
}

// ------------------------------------------------------------ expressions

// `args_by_pass`: an explicit pass wins, else the parameter's, else
// `Sink`. `pass_start`/`pass_count` index `callees.passes`
// (pass_count 0: no parameters).
fn args(
    inout walker: Ow,
    inout ctx: Ctx,
    in ast: Ast,
    in callees: Callees,
    list: u32,
    pass_start: u64,
    pass_count: u64
) -> bool {
    for i in 0..list_len(in ast, list) {
        let arg = arg_at(in ast, list_at(in ast, list, i));
        let pass = if arg.explicit {
            arg.pass
        } else if i < pass_count {
            g8(in callees.passes, wrapping_add(pass_start, i))
        } else {
            PASS_SINK
        };
        if !expr(inout walker, inout ctx, in ast, in callees, arg.expr, pass == PASS_SINK) {
            return false;
        }
    }
    true
}

// `args_by_pass` with the passes of a function type.
fn args_of_type(
    inout walker: Ow,
    inout ctx: Ctx,
    in ast: Ast,
    in callees: Callees,
    list: u32,
    fty: u32
) -> bool {
    let fnode = ctx.types.node(fty);
    let param_count = if fnode.kind == CT_FN { w(fnode.n) } else { 0 };
    for i in 0..list_len(in ast, list) {
        let arg = arg_at(in ast, list_at(in ast, list, i));
        let pass = if arg.explicit {
            arg.pass
        } else if i < param_count {
            ctx.types.param_pass(fty, i)
        } else {
            PASS_SINK
        };
        if !expr(inout walker, inout ctx, in ast, in callees, arg.expr, pass == PASS_SINK) {
            return false;
        }
    }
    true
}

fn branch(
    inout walker: Ow,
    inout ctx: Ctx,
    in ast: Ast,
    in callees: Callees,
    arm: u32,
    construct_start: u64,
    construct_end: u64,
    consume: bool
) -> bool {
    let node = expr_at(in ast, arm);
    walker.branches.push(w(node.start));
    walker.branches.push(w(node.end));
    walker.branches.push(construct_start);
    walker.branches.push(construct_end);
    let ok = expr(inout walker, inout ctx, in ast, in callees, arm, consume);
    for i in 0..4 {
        let _ = walker.branches.pop();
    }
    ok
}

// The function of AST symbol `sym` (index), or NONE.
fn function(in callees: Callees, sym: u32) -> u32 {
    let entry = table_get(in callees.fn_by_sym, sym);
    if entry == 0 {
        NONE
    } else {
        wrapping_sub(entry, 1)
    }
}

// A call `callee(args)` (`ExprKind::Call`).
fn call(
    inout walker: Ow,
    inout ctx: Ctx,
    in ast: Ast,
    in callees: Callees,
    callee: u32,
    list: u32
) -> bool {
    let callee_node = expr_at(in ast, callee);
    if callee_node.kind == E_NAME && lookup(in walker, callee_node.a) == NONE {
        let name = callee_node.a;
        if ctor(inout walker, in ctx, in ast, name) != NONE64 {
            return args(inout walker, inout ctx, in ast, in callees, list, 0, 0);
        }
        let fn_index = function(in callees, name);
        if fn_index != NONE {
            return args(
                inout walker,
                inout ctx,
                in ast,
                in callees,
                list,
                w(g32(in callees.fn_pass_start, w(fn_index))),
                w(g32(in callees.fn_pass_count, w(fn_index)))
            );
        }
        // `Effect::op`: split at the first `::`.
        let mut first: u64 = 0;
        let mut last: u64 = 0;
        let count = path_parts(in ast, name, inout first, inout last);
        if count > 0 {
            name_slice(inout walker, in ast, name, 0, first);
            let effect = match ast.names.lookup_view(in walker.buf.as_slice()) {
                Option::Some(x) => table_get(in callees.effect_by_sym, x.id()),
                Option::None => 0,
            };
            if effect != 0 {
                name_slice(inout walker, in ast, name, wrapping_add(first, 2), NONE64);
                let op = match ast.names.lookup_view(in walker.buf.as_slice()) {
                    Option::Some(x) => x.id(),
                    Option::None => NONE,
                };
                let effect_index = w(wrapping_sub(effect, 1));
                let op_start = w(g32(in callees.effect_op_start, effect_index));
                for j in 0..w(g32(in callees.effect_op_count, effect_index)) {
                    let op_row = wrapping_add(op_start, j);
                    if op != NONE && g32(in callees.op_sym, op_row) == op {
                        return args(
                            inout walker,
                            inout ctx,
                            in ast,
                            in callees,
                            list,
                            w(g32(in callees.op_pass_start, op_row)),
                            w(g32(in callees.op_pass_count, op_row))
                        );
                    }
                }
            }
        }
        return args(inout walker, inout ctx, in ast, in callees, list, 0, 0);
    }
    if callee_node.kind == E_FIELD {
        let base = callee_node.a;
        let ty = ty_of(in walker, in ctx, in ast, base);
        // `{ty.name()}::{method}` in the tree's interner.
        walker.buf.clear();
        ctx.names.write(ctx.types.name(ty), inout walker.buf);
        walker.buf.push(58);
        walker.buf.push(58);
        put_name(inout walker.buf, in ast, callee_node.b);
        let fn_index = match ast.names.lookup_view(in walker.buf.as_slice()) {
            Option::Some(x) => function(in callees, x.id()),
            Option::None => NONE,
        };
        if fn_index != NONE && g8(in callees.fn_self, w(fn_index)) != 0 {
            let pass_start = w(g32(in callees.fn_pass_start, w(fn_index)));
            let pass_count = w(g32(in callees.fn_pass_count, w(fn_index)));
            if !expr(
                inout walker,
                inout ctx,
                in ast,
                in callees,
                base,
                g8(in callees.passes, pass_start) == PASS_SINK
            ) {
                return false;
            }
            return args(
                inout walker,
                inout ctx,
                in ast,
                in callees,
                list,
                inc(pass_start),
                wrapping_sub(pass_count, 1)
            );
        }
        if !expr(inout walker, inout ctx, in ast, in callees, base, false) {
            return false;
        }
        return args(inout walker, inout ctx, in ast, in callees, list, 0, 0);
    }
    // A function value: used owned, its arguments follow its type's passes.
    let fty = ty_of(in walker, in ctx, in ast, callee);
    if !expr(inout walker, inout ctx, in ast, in callees, callee, true) {
        return false;
    }
    args_of_type(inout walker, inout ctx, in ast, in callees, list, fty)
}

fn expr(
    inout walker: Ow,
    inout ctx: Ctx,
    in ast: Ast,
    in callees: Callees,
    expr_id: u32,
    consume: bool
) -> bool {
    if !charge(inout walker) {
        return false;
    }
    let node = expr_at(in ast, expr_id);
    let kind = node.kind;
    if kind == E_LIT {
        return true;
    }
    if kind == E_NAME {
        if consume {
            record_use(inout walker, node.a, w(node.start), w(node.end));
        }
        return true;
    }
    if kind == E_TUPLE {
        for i in 0..list_len(in ast, node.a) {
            if !expr(
                inout walker,
                inout ctx,
                in ast,
                in callees,
                list_at(in ast, node.a, i),
                true
            ) {
                return false;
            }
        }
        return true;
    }
    if kind == E_STRUCT {
        for i in 0..list_len(in ast, node.b) / 2 {
            let value_expr = list_at(in ast, node.b, inc(wrapping_mul(i, 2)));
            if !expr(inout walker, inout ctx, in ast, in callees, value_expr, true) {
                return false;
            }
        }
        return true;
    }
    if kind == E_BLOCK {
        push_scope(inout walker);
        for i in 0..list_len(in ast, node.a) {
            let stmt = stmt_at(in ast, list_at(in ast, node.a, i));
            if stmt.kind == S_LET {
                if !expr(inout walker, inout ctx, in ast, in callees, stmt.value, true) {
                    return false;
                }
                let ty_node = ty_at(in ast, stmt.ty);
                let ty = if stmt.ty == NONE || ty_node.kind == 5 {
                    ty_of(in walker, in ctx, in ast, stmt.value)
                } else {
                    tid(inout walker, inout ctx, in ast, stmt.ty)
                };
                if !pattern(
                    inout walker,
                    inout ctx,
                    in ast,
                    stmt.pat,
                    ty,
                    w(node.start),
                    w(node.end)
                ) {
                    return false;
                }
            } else {
                if !expr(inout walker, inout ctx, in ast, in callees, stmt.value, true) {
                    return false;
                }
            }
        }
        if node.b != NONE {
            if !expr(inout walker, inout ctx, in ast, in callees, node.b, consume) {
                return false;
            }
        }
        pop_scope(inout walker);
        return true;
    }
    if kind == E_CALL {
        return call(inout walker, inout ctx, in ast, in callees, node.a, node.c);
    }
    if kind == E_FIELD {
        return expr(inout walker, inout ctx, in ast, in callees, node.a, false);
    }
    if kind == E_INDEX {
        if !expr(inout walker, inout ctx, in ast, in callees, node.a, false) {
            return false;
        }
        return expr(inout walker, inout ctx, in ast, in callees, node.b, true);
    }
    if kind == E_TRY {
        return expr(inout walker, inout ctx, in ast, in callees, node.a, true);
    }
    if kind == E_UNARY {
        return expr(inout walker, inout ctx, in ast, in callees, node.b, false);
    }
    if kind == E_BINARY {
        if !expr(inout walker, inout ctx, in ast, in callees, node.b, false) {
            return false;
        }
        return expr(inout walker, inout ctx, in ast, in callees, node.c, false);
    }
    if kind == E_ASSIGN {
        if !expr(inout walker, inout ctx, in ast, in callees, node.b, false) {
            return false;
        }
        return expr(inout walker, inout ctx, in ast, in callees, node.c, true);
    }
    if kind == E_IF {
        if !expr(inout walker, inout ctx, in ast, in callees, node.a, false) {
            return false;
        }
        if !branch(
            inout walker,
            inout ctx,
            in ast,
            in callees,
            node.b,
            w(node.start),
            w(node.end),
            consume
        ) {
            return false;
        }
        if node.c != NONE {
            return branch(
                inout walker,
                inout ctx,
                in ast,
                in callees,
                node.c,
                w(node.start),
                w(node.end),
                consume
            );
        }
        return true;
    }
    if kind == E_MATCH {
        if !expr(inout walker, inout ctx, in ast, in callees, node.a, true) {
            return false;
        }
        let scrutinee = ty_of(in walker, in ctx, in ast, node.a);
        for i in 0..list_len(in ast, node.b) / 2 {
            let pat = list_at(in ast, node.b, wrapping_mul(i, 2));
            let body = list_at(in ast, node.b, inc(wrapping_mul(i, 2)));
            let body_node = expr_at(in ast, body);
            push_scope(inout walker);
            if !pattern(
                inout walker,
                inout ctx,
                in ast,
                pat,
                scrutinee,
                w(body_node.start),
                w(body_node.end)
            ) {
                return false;
            }
            if !branch(
                inout walker,
                inout ctx,
                in ast,
                in callees,
                body,
                w(node.start),
                w(node.end),
                consume
            ) {
                return false;
            }
            pop_scope(inout walker);
        }
        return true;
    }
    if kind == E_CLOSURE {
        let body_node = expr_at(in ast, node.e);
        push_scope(inout walker);
        for i in 0..list_len(in ast, node.a) {
            let param = param_at(in ast, list_at(in ast, node.a, i));
            // A closure parameter's span may run into its body.
            let param_start = w(param.start);
            let mut param_end = w(param.end);
            if param_end > w(body_node.start) {
                param_end = w(body_node.start);
            }
            if param_end < param_start {
                param_end = param_start;
            }
            let ty = tid(inout walker, inout ctx, in ast, param.ty);
            if !bind(
                inout walker,
                inout ctx,
                param.name,
                param_start,
                param_end,
                ty,
                param.pass == PASS_SINK,
                w(body_node.start),
                w(body_node.end)
            ) {
                return false;
            }
        }
        if !expr(inout walker, inout ctx, in ast, in callees, node.e, true) {
            return false;
        }
        pop_scope(inout walker);
        return true;
    }
    if kind == E_HANDLE {
        if node.b != NONE && node.c != NONE {
            if !expr(inout walker, inout ctx, in ast, in callees, node.c, true) {
                return false;
            }
        }
        if !expr(inout walker, inout ctx, in ast, in callees, node.d, true) {
            return false;
        }
        for i in 0..list_len(in ast, node.e) {
            let clause = clause_at(in ast, list_at(in ast, node.e, i));
            let body_node = expr_at(in ast, clause.body);
            push_scope(inout walker);
            for j in 0..list_len(in ast, clause.pats) {
                let infer = ctx.types.infer;
                if !pattern(
                    inout walker,
                    inout ctx,
                    in ast,
                    list_at(in ast, clause.pats, j),
                    infer,
                    w(body_node.start),
                    w(body_node.end)
                ) {
                    return false;
                }
            }
            if !branch(
                inout walker,
                inout ctx,
                in ast,
                in callees,
                clause.body,
                w(node.start),
                w(node.end),
                consume
            ) {
                return false;
            }
            pop_scope(inout walker);
        }
        return true;
    }
    // Loops, ranges and early exits: the ownership lens does not model
    // loop-carried state or early exits.
    walker.err = OPAQUE;
    false
}

// One function (`visit`): its parameters, then its body.
fn visit(
    inout walker: Ow,
    inout ctx: Ctx,
    in ast: Ast,
    in callees: Callees,
    fn_node: FnNode,
    owner: u32,
    self_sym: u32
) -> bool {
    if fn_node.body == NONE {
        return true;
    }
    let body = expr_at(in ast, fn_node.body);
    walker.first = walker.binding_name.len();
    walker.scope.clear();
    walker.marks.clear();
    walker.branches.clear();
    walker.fn_start.push(w(fn_node.start));
    walker.fn_end.push(w(fn_node.end));
    walker.fn_binding_start.push(wrapping_u32(walker.first));
    for i in 0..list_len(in ast, fn_node.params) {
        let param = param_at(in ast, list_at(in ast, fn_node.params, i));
        let param_ty_node = ty_at(in ast, param.ty);
        let ty = if param.name == self_sym
            && self_sym != NONE
            && (param.ty == NONE || param_ty_node.kind == 5)
        {
            if owner == NONE {
                ctx.types.infer
            } else {
                tid(inout walker, inout ctx, in ast, owner)
            }
        } else {
            tid(inout walker, inout ctx, in ast, param.ty)
        };
        if !bind(
            inout walker,
            inout ctx,
            param.name,
            w(param.start),
            w(param.end),
            ty,
            param.pass == PASS_SINK,
            w(body.start),
            w(body.end)
        ) {
            return false;
        }
    }
    if !expr(inout walker, inout ctx, in ast, in callees, fn_node.body, true) {
        return false;
    }
    walker
        .fn_binding_count
        .push(wrapping_u32(wrapping_sub(walker.binding_name.len(), walker.first)));
    true
}

// `facts`: every top-level function and impl method with a body.
fn facts(
    inout walker: Ow,
    inout ctx: Ctx,
    in ast: Ast,
    in callees: Callees,
    self_sym: u32
) -> bool {
    for i in 0..ast.m_items.len() {
        let item = item_at(in ast, g32(in ast.m_items, i));
        if item.kind == ITEM_FUNCTION {
            if !visit(
                inout walker,
                inout ctx,
                in ast,
                in callees,
                fn_at(in ast, item.node),
                NONE,
                self_sym
            ) {
                return false;
            }
        } else if item.kind == ITEM_IMPL {
            let impl_node = impl_at(in ast, item.node);
            for j in 0..list_len(in ast, impl_node.methods) {
                let fn_node = fn_at(in ast, list_at(in ast, impl_node.methods, j));
                if !visit(
                    inout walker,
                    inout ctx,
                    in ast,
                    in callees,
                    fn_node,
                    impl_node.ty,
                    self_sym
                ) {
                    return false;
                }
            }
        }
    }
    true
}

// ------------------------------------------------------------ queries

fn visible_at(in walker: Ow, binding: u64, at: u64) -> bool {
    g64(in walker.binding_origin_end, binding) <= at
        && at <= g64(in walker.binding_scope_end, binding)
}

// `consumed_before`: a consumption before `at` on the path through `at`.
fn consumed_before(in walker: Ow, binding: u64, at: u64) -> bool {
    let mut event = g32(in walker.binding_first_event, binding);
    loop {
        if event == 0 {
            return false;
        }
        let i = w(wrapping_sub(event, 1));
        if g64(in walker.event_end, i) <= at {
            let branch_start = w(g32(in walker.event_branch_start, i));
            let mut all = true;
            for j in 0..w(g32(in walker.event_branch_count, i)) {
                let branch_at = wrapping_add(branch_start, wrapping_mul(j, 4));
                let arm_s = g64(in walker.branch_pool, branch_at);
                let arm_e = g64(in walker.branch_pool, inc(branch_at));
                let con_e = g64(in walker.branch_pool, wrapping_add(branch_at, 3));
                if !((arm_s <= at && at <= arm_e) || con_e <= at) {
                    all = false;
                    break;
                }
            }
            if all {
                return true;
            }
        }
        event = g32(in walker.event_next, i);
    }
}

// `resolve`: the visible binding of `name` introduced last (ties: the
// later binding).
fn resolve(in walker: Ow, fn_index: u64, name: u32, at: u64) -> u64 {
    let first = w(g32(in walker.fn_binding_start, fn_index));
    let count = w(g32(in walker.fn_binding_count, fn_index));
    let mut best = NONE64;
    for j in 0..count {
        let binding = wrapping_add(first, j);
        if g32(in walker.binding_name, binding) == name && visible_at(in walker, binding, at) {
            if best == NONE64
                || g64(in walker.binding_origin_start, binding)
                    >= g64(in walker.binding_origin_start, best)
            {
                best = binding;
            }
        }
    }
    best
}

// `View::outstanding` (without repaired regions): the function containing
// `at` (the shortest; ties: the first), then its live linear bindings.
fn index_facts(inout walker: Ow) {
    for fn_index in 0..walker.fn_start.len() {
        if fn_index > 0
            && g64(in walker.fn_start, fn_index) < g64(in walker.fn_end, wrapping_sub(fn_index, 1))
        {
            walker.sorted = false;
        }
        if g64(in walker.fn_end, fn_index) < g64(in walker.fn_start, fn_index) {
            walker.sorted = false;
        }
        walker.lin_first.push(wrapping_u32(walker.lin_idx.len()));
        let first = w(g32(in walker.fn_binding_start, fn_index));
        let count = w(g32(in walker.fn_binding_count, fn_index));
        for j in 0..count {
            let binding = wrapping_add(first, j);
            if g8(in walker.binding_linear, binding) != 0
                && g8(in walker.binding_owned, binding) != 0
            {
                walker.lin_idx.push(wrapping_u32(binding));
            }
        }
        walker.lin_count.push(wrapping_u32(wrapping_sub(
            walker.lin_idx.len(),
            w(g32(in walker.lin_first, fn_index))
        )));
    }
}

// The function containing `at`: the shortest (ties: the first).
fn function_at(in walker: Ow, at: u64) -> u64 {
    let fn_count = walker.fn_start.len();
    if !walker.sorted {
        let mut found = NONE64;
        let mut len: u64 = 0;
        for i in 0..fn_count {
            let start = g64(in walker.fn_start, i);
            let end = g64(in walker.fn_end, i);
            if start <= at && at <= end {
                let span_len = wrapping_sub(end, start);
                if found == NONE64 || span_len < len {
                    found = i;
                    len = span_len;
                }
            }
        }
        return found;
    }
    // In order and disjoint but for shared ends: the last function starting
    // at or before `at`, or the one before it when that ends at `at`.
    let mut lo: u64 = 0;
    let mut hi = fn_count;
    loop {
        if lo >= hi {
            break;
        }
        let mid = wrapping_add(lo, wrapping_sub(hi, lo) >> 1);
        if g64(in walker.fn_start, mid) <= at {
            lo = inc(mid);
        } else {
            hi = mid;
        }
    }
    if lo == 0 {
        return NONE64;
    }
    let i = wrapping_sub(lo, 1);
    let mut found = NONE64;
    let mut len: u64 = 0;
    let from = if i > 0 { wrapping_sub(i, 1) } else { i };
    let mut j = from;
    loop {
        if j > i {
            break;
        }
        let start = g64(in walker.fn_start, j);
        let end = g64(in walker.fn_end, j);
        if start <= at && at <= end {
            let span_len = wrapping_sub(end, start);
            if found == NONE64 || span_len < len {
                found = j;
                len = span_len;
            }
        }
        j = inc(j);
    }
    found
}

// `View::outstanding` (without repaired regions): the function containing
// `at`, then its live linear bindings.
fn outstanding(inout out: ChunkSeq[u8], in walker: Ow, at: u64) {
    let fn_index = function_at(in walker, at);
    if fn_index == NONE64 {
        return;
    }
    let mut res = ChunkSeq::new[u64]();
    live(inout res, in walker, fn_index, at);
    for j in 0..res.len() {
        out.push(9);
        put_u64(inout out, g64(in walker.binding_origin_start, g64(in res, j)));
    }
}

// `live`: the owned linear bindings of function `fn_index` visible and not yet
// consumed at `at` that `at` still resolves their names to.
fn live(inout res: ChunkSeq[u64], in walker: Ow, fn_index: u64, at: u64) {
    let first = w(g32(in walker.lin_first, fn_index));
    let count = w(g32(in walker.lin_count, fn_index));
    for j in 0..count {
        let binding = w(g32(in walker.lin_idx, wrapping_add(first, j)));
        if !visible_at(in walker, binding, at) || consumed_before(in walker, binding, at) {
            continue;
        }
        let resolved = resolve(in walker, fn_index, g32(in walker.binding_name, binding), at);
        if resolved == NONE64
            || g64(in walker.binding_origin_start, resolved)
                != g64(in walker.binding_origin_start, binding)
            || g64(in walker.binding_origin_end, resolved)
                != g64(in walker.binding_origin_end, binding)
        {
            continue;
        }
        res.push(binding);
    }
}

// ------------------------------------------------------------ the dump

fn tab_u(inout out: ChunkSeq[u8], n: u64) {
    out.push(9);
    put_u64(inout out, n);
}

// `lens::facts_dump`: the facts, then the live linear bindings at each
// cursor.
fn dump(
    inout out: ChunkSeq[u8],
    in walker: Ow,
    in ctx: Ctx,
    in ast: Ast,
    in cursors: ChunkSeq[u64]
) {
    if dump_err(inout out, in walker) {
        return;
    }
    dump_facts(inout out, in walker, in ctx, in ast);
    for i in 0..cursors.len() {
        let at = g64(in cursors, i);
        out.push(79);
        tab_u(inout out, at);
        outstanding(inout out, in walker, at);
        out.push(10);
    }
}

// The `U` row of a walk that failed (`Unavailable`), if it failed.
fn dump_err(inout out: ChunkSeq[u8], in walker: Ow) -> bool {
    if walker.err == OK {
        return false;
    }
    if walker.err == RESOURCE {
        put(inout out, in "U\tlens_resource_limit\n");
    } else {
        put(inout out, in "U\topaque_declaration\n");
    }
    true
}

// `write_facts`: each function, its bindings and their events.
fn dump_facts(inout out: ChunkSeq[u8], in walker: Ow, in ctx: Ctx, in ast: Ast) {
    for fn_index in 0..walker.fn_start.len() {
        out.push(70);
        tab_u(inout out, g64(in walker.fn_start, fn_index));
        tab_u(inout out, g64(in walker.fn_end, fn_index));
        out.push(10);
        let first = w(g32(in walker.fn_binding_start, fn_index));
        for j in 0..w(g32(in walker.fn_binding_count, fn_index)) {
            let binding = wrapping_add(first, j);
            out.push(66);
            out.push(9);
            put_name(inout out, in ast, g32(in walker.binding_name, binding));
            tab_u(inout out, g64(in walker.binding_origin_start, binding));
            tab_u(inout out, g64(in walker.binding_origin_end, binding));
            tab_u(inout out, widen_u64(g8(in walker.binding_linear, binding)));
            tab_u(inout out, widen_u64(g8(in walker.binding_owned, binding)));
            tab_u(inout out, g64(in walker.binding_scope_start, binding));
            tab_u(inout out, g64(in walker.binding_scope_end, binding));
            out.push(9);
            type_display(in ctx.types, in ctx.names, g32(in walker.binding_ty, binding), inout out);
            out.push(10);
            let mut event = g32(in walker.binding_first_event, binding);
            loop {
                if event == 0 {
                    break;
                }
                let i = w(wrapping_sub(event, 1));
                out.push(69);
                tab_u(inout out, g64(in walker.event_start, i));
                tab_u(inout out, g64(in walker.event_end, i));
                let branch_start = w(g32(in walker.event_branch_start, i));
                for word_index in 0..wrapping_mul(w(g32(in walker.event_branch_count, i)), 4) {
                    tab_u(
                        inout out,
                        g64(in walker.branch_pool, wrapping_add(branch_start, word_index))
                    );
                }
                out.push(10);
                event = g32(in walker.event_next, i);
            }
        }
    }
}

// ------------------------------------------------------------ entry

copy struct Rd {
    pos: u64
}

fn word(in bytes: Slice[u8], inout reader: Rd) -> u64 {
    let x = bytes.try_read_u64_le(reader.pos).unwrap_or(0);
    reader.pos = wrapping_add(reader.pos, 8);
    x
}

// The interned AST symbol of names[off..off + len].
fn blob_sym(inout ast: Ast, in bytes: Slice[u8], names_at: u64, off: u64, len: u64) -> u32 {
    let name_at = wrapping_add(names_at, off);
    let name = match String::from_utf8(in bytes[name_at..wrapping_add(name_at, len)]) {
        Option::Some(x) => x,
        Option::None => String::new(),
    };
    ast.names.intern(in name).id()
}

// The callee sections: per function its name (offset and length in the
// names blob), parameter count, whether the first is `self` and each
// parameter's pass; per effect its name and operations (name, parameter
// count and passes).
fn read_callees(
    in bytes: Slice[u8],
    inout reader: Rd,
    inout callees: Callees,
    inout fn_name: ChunkSeq[u64],
    inout ef_name: ChunkSeq[u64],
    inout op_name: ChunkSeq[u64]
) {
    let fn_count = word(in bytes, inout reader);
    for i in 0..fn_count {
        fn_name.push(word(in bytes, inout reader));
        fn_name.push(word(in bytes, inout reader));
        let param_count = word(in bytes, inout reader);
        callees.fn_self.push(wrapping_u8(word(in bytes, inout reader)));
        callees.fn_pass_start.push(wrapping_u32(callees.passes.len()));
        callees.fn_pass_count.push(wrapping_u32(param_count));
        for j in 0..param_count {
            callees.passes.push(wrapping_u8(word(in bytes, inout reader)));
        }
    }
    let effect_count = word(in bytes, inout reader);
    for i in 0..effect_count {
        ef_name.push(word(in bytes, inout reader));
        ef_name.push(word(in bytes, inout reader));
        let op_count = word(in bytes, inout reader);
        callees.effect_op_start.push(wrapping_u32(callees.op_pass_start.len()));
        callees.effect_op_count.push(wrapping_u32(op_count));
        for j in 0..op_count {
            op_name.push(word(in bytes, inout reader));
            op_name.push(word(in bytes, inout reader));
            let param_count = word(in bytes, inout reader);
            callees.op_pass_start.push(wrapping_u32(callees.passes.len()));
            callees.op_pass_count.push(wrapping_u32(param_count));
            for q in 0..param_count {
                callees.passes.push(wrapping_u8(word(in bytes, inout reader)));
            }
        }
    }
}

fn callees_new() -> Callees {
    Callees {
        fn_by_sym: ChunkSeq::new[u32](),
        fn_pass_start: ChunkSeq::new[u32](),
        fn_pass_count: ChunkSeq::new[u32](),
        fn_self: ChunkSeq::new[u8](),
        effect_by_sym: ChunkSeq::new[u32](),
        effect_op_start: ChunkSeq::new[u32](),
        effect_op_count: ChunkSeq::new[u32](),
        op_sym: ChunkSeq::new[u32](),
        op_pass_start: ChunkSeq::new[u32](),
        op_pass_count: ChunkSeq::new[u32](),
        passes: ChunkSeq::new[u8]()
    }
}

// Interns the callee names into the tree's names and indexes them by
// symbol.
fn link_callees(
    inout ast: Ast,
    in bytes: Slice[u8],
    names_at: u64,
    inout callees: Callees,
    in fn_name: ChunkSeq[u64],
    in ef_name: ChunkSeq[u64],
    in op_name: ChunkSeq[u64]
) {
    let fn_count = fn_name.len() / 2;
    let effect_count = ef_name.len() / 2;
    let mut fsym = ChunkSeq::with_capacity[u32](fn_count);
    for i in 0..fn_count {
        let sym = blob_sym(
            inout ast,
            in bytes,
            names_at,
            g64(in fn_name, wrapping_mul(i, 2)),
            g64(in fn_name, inc(wrapping_mul(i, 2)))
        );
        fsym.push(sym);
    }
    let mut esym = ChunkSeq::with_capacity[u32](effect_count);
    for i in 0..effect_count {
        let sym = blob_sym(
            inout ast,
            in bytes,
            names_at,
            g64(in ef_name, wrapping_mul(i, 2)),
            g64(in ef_name, inc(wrapping_mul(i, 2)))
        );
        esym.push(sym);
    }
    for i in 0..op_name.len() / 2 {
        let sym = blob_sym(
            inout ast,
            in bytes,
            names_at,
            g64(in op_name, wrapping_mul(i, 2)),
            g64(in op_name, inc(wrapping_mul(i, 2)))
        );
        callees.op_sym.push(sym);
    }
    for i in 0..fn_count {
        table_set(inout callees.fn_by_sym, g32(in fsym, i), wrapping_u32(inc(i)));
    }
    for i in 0..effect_count {
        table_set(inout callees.effect_by_sym, g32(in esym, i), wrapping_u32(inc(i)));
    }
}

// The harness input: the checker's facts; the functions (name offset and
// length in the names blob, parameter count, whether the first is `self`,
// then each parameter's pass); the effects (name, operation count, then
// per operation its name, parameter count and passes); the cursors; the
// text and names lengths and the round count; then the source text and
// the names blob.
pub fn lens_facts(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mut ctx_reader = CtxReader { pos: 0 };
    let mut ctx = read_ctx(inout ctx_reader, in bytes);
    let mut reader = Rd { pos: ctx_reader.pos };
    let mut fn_name = ChunkSeq::new[u64]();
    let mut callees = callees_new();
    let mut ef_name = ChunkSeq::new[u64]();
    let mut op_name = ChunkSeq::new[u64]();
    read_callees(
        in bytes,
        inout reader,
        inout callees,
        inout fn_name,
        inout ef_name,
        inout op_name
    );
    let cursor_count = word(in bytes, inout reader);
    let mut cursors = ChunkSeq::with_capacity[u64](cursor_count);
    for i in 0..cursor_count {
        cursors.push(word(in bytes, inout reader));
    }
    let text_len = word(in bytes, inout reader);
    let names_len = word(in bytes, inout reader);
    let reps = word(in bytes, inout reader);
    let text = match String::from_utf8(in bytes[reader.pos..wrapping_add(reader.pos, text_len)]) {
        Option::Some(x) => x,
        Option::None => String::new(),
    };
    let names_at = wrapping_add(reader.pos, text_len);
    let mut out = ChunkSeq::new[u8]();
    let mut walker = ow_new();
    // The server keeps one parse per snapshot: `reps` rounds of the facts
    // and queries on one parse (the answer is the last round's).
    let lowered = lower_source(in text);
    let mut ast = lowered.ast;
    link_callees(inout ast, in bytes, names_at, inout callees, in fn_name, in ef_name, in op_name);
    let self_sym = match ast.names.lookup(in "self") {
        Option::Some(x) => x.id(),
        Option::None => NONE,
    };
    for round in 0..reps {
        out.clear();
        ow_clear(inout walker);
        let ok = facts(inout walker, inout ctx, in ast, in callees, self_sym);
        if ok {
            index_facts(inout walker);
        }
        dump(inout out, in walker, in ctx, in ast, in cursors);
    }
    pack(in out.as_slice())
}

// ------------------------------------------------------------ views

// A semantic-error or repaired Lens view (`View::from_text`): the editor
// guard's outcome on the text, the repaired regions and the checker's
// diagnostic spans, from the harness; the world's signatures for member
// completion; and the queries.
struct View {
    // 0: the Lens profile checked the text cleanly; 1: semantic errors;
    // 2, 3, 4: `RepairUnparsed`, `Resource`, `Guard`.
    status: u64,
    // Per region: kind (0 body, 1 header, 2 member), declaration start,
    // scope, cut.
    region_kind: ChunkSeq[u8],
    region_decl_start: ChunkSeq[u64],
    region_scope_start: ChunkSeq[u64],
    region_scope_end: ChunkSeq[u64],
    region_cut: ChunkSeq[u64],
    diag_start: ChunkSeq[u64],
    diag_end: ChunkSeq[u64]
}

// `World::functions`' signatures (`signature`, `CandidateMethod`) and the
// linear flag of each `World::effects` entry.
struct Sigs {
    // Per function: its name in the names blob; per parameter (pooled at
    // `Callees::fn_pass_start`) its name and type; the result type; its effect
    // instances (inst_*[inst_start..+inst_count]) and their arguments
    // (arg_ty[inst_arg_start..+inst_arg_count]).
    fn_name_at: ChunkSeq[u64],
    fn_name_len: ChunkSeq[u64],
    param_name_at: ChunkSeq[u64],
    param_name_len: ChunkSeq[u64],
    param_ty: ChunkSeq[u32],
    result_ty: ChunkSeq[u32],
    inst_start: ChunkSeq[u32],
    inst_count: ChunkSeq[u32],
    inst_name_at: ChunkSeq[u64],
    inst_name_len: ChunkSeq[u64],
    inst_sym: ChunkSeq[u32],
    inst_arg_start: ChunkSeq[u32],
    inst_arg_count: ChunkSeq[u32],
    arg_ty: ChunkSeq[u32],
    effect_linear: ChunkSeq[u8]
}

const BODY: u8 = 0;

// `View::function_at`: inside a damaged body the function holding the cut,
// read at the cut; elsewhere `function_at`. `at` is updated to the offset
// obligations are read at.
fn view_function_at(in walker: Ow, in view: View, inout at: u64) -> u64 {
    for i in 0..view.region_kind.len() {
        if g8(in view.region_kind, i) == BODY
            && g64(in view.region_scope_start, i) <= at
            && at <= g64(in view.region_scope_end, i)
        {
            let fn_index = region_function(in walker, in view, i);
            if fn_index == NONE64 {
                return NONE64;
            }
            let cut = g64(in view.region_cut, i);
            if cut < at {
                at = cut;
            }
            return fn_index;
        }
    }
    function_at(in walker, at)
}

// `View::region_function`: the shortest function (ties: the first) whose
// span holds the region's cut and starts inside its scope.
fn region_function(in walker: Ow, in view: View, i: u64) -> u64 {
    let cut = g64(in view.region_cut, i);
    let scope_start = g64(in view.region_scope_start, i);
    let mut found = NONE64;
    let mut len: u64 = 0;
    for j in 0..walker.fn_start.len() {
        let start = g64(in walker.fn_start, j);
        let end = g64(in walker.fn_end, j);
        if start <= cut && cut <= end && scope_start <= start {
            let span_len = wrapping_sub(end, start);
            if found == NONE64 || span_len < len {
                found = j;
                len = span_len;
            }
        }
    }
    found
}

// `View::outstanding` with regions.
fn view_live(inout res: ChunkSeq[u64], in walker: Ow, in view: View, query_at: u64) {
    let mut at = query_at;
    let fn_index = view_function_at(in walker, in view, inout at);
    if fn_index != NONE64 {
        live(inout res, in walker, fn_index, at);
    }
}

// `View::binding`: the binding `name` resolves to at `at`, and the offset
// it was read at (NONE64: none).
fn view_binding(in walker: Ow, in view: View, name: u32, inout at: u64) -> u64 {
    let fn_index = view_function_at(in walker, in view, inout at);
    if fn_index == NONE64 {
        return NONE64;
    }
    resolve(in walker, fn_index, name, at)
}

fn same_origin(in walker: Ow, lhs: u64, rhs: u64) -> bool {
    g64(in walker.binding_origin_start, lhs) == g64(in walker.binding_origin_start, rhs)
        && g64(in walker.binding_origin_end, lhs) == g64(in walker.binding_origin_end, rhs)
}

fn put_blob(inout out: ChunkSeq[u8], in bytes: Slice[u8], at: u64, len: u64) {
    put_bytes(inout out, in bytes[at..wrapping_add(at, len)]);
}

// `render_effect`: `Name`, or `Name[A, B]`.
fn render_effect(
    inout out: ChunkSeq[u8],
    in ctx: Ctx,
    in sigs: Sigs,
    in bytes: Slice[u8],
    names_at: u64,
    inst_index: u64
) {
    put_blob(
        inout out,
        in bytes,
        wrapping_add(names_at, g64(in sigs.inst_name_at, inst_index)),
        g64(in sigs.inst_name_len, inst_index)
    );
    let arg_count = w(g32(in sigs.inst_arg_count, inst_index));
    if arg_count == 0 {
        return;
    }
    out.push(91);
    let arg_start = w(g32(in sigs.inst_arg_start, inst_index));
    for j in 0..arg_count {
        if j > 0 {
            out.push(44);
            out.push(32);
        }
        type_display(
            in ctx.types,
            in ctx.names,
            g32(in sigs.arg_ty, wrapping_add(arg_start, j)),
            inout out
        );
    }
    out.push(93);
}

// `signature`: `fn name(params) -> Result eff [E, F]`.
fn signature(
    inout out: ChunkSeq[u8],
    in ctx: Ctx,
    in callees: Callees,
    in sigs: Sigs,
    in bytes: Slice[u8],
    names_at: u64,
    fn_index: u64
) {
    put(inout out, in "fn ");
    let name_at = wrapping_add(names_at, g64(in sigs.fn_name_at, fn_index));
    let len = g64(in sigs.fn_name_len, fn_index);
    // The name after its last `::`.
    let mut from: u64 = 0;
    let mut i: u64 = 0;
    loop {
        if inc(i) >= len {
            break;
        }
        if byte(in bytes, wrapping_add(name_at, i)) == 58
            && byte(in bytes, wrapping_add(name_at, inc(i))) == 58
        {
            from = wrapping_add(i, 2);
            i = wrapping_add(i, 2);
        } else {
            i = inc(i);
        }
    }
    put_blob(inout out, in bytes, wrapping_add(name_at, from), wrapping_sub(len, from));
    out.push(40);
    let pass_start = w(g32(in callees.fn_pass_start, fn_index));
    for j in 0..w(g32(in callees.fn_pass_count, fn_index)) {
        if j > 0 {
            out.push(44);
            out.push(32);
        }
        let param_index = wrapping_add(pass_start, j);
        let pass = g8(in callees.passes, param_index);
        if pass == 1 {
            put(inout out, in "inout ");
        } else if pass == PASS_SINK {
            put(inout out, in "sink ");
        }
        let param_name_at = wrapping_add(names_at, g64(in sigs.param_name_at, param_index));
        let param_name_len = g64(in sigs.param_name_len, param_index);
        put_blob(inout out, in bytes, param_name_at, param_name_len);
        let is_self = param_name_len == 4
            && byte(in bytes, param_name_at) == 115
            && byte(in bytes, inc(param_name_at)) == 101
            && byte(in bytes, wrapping_add(param_name_at, 2)) == 108
            && byte(in bytes, wrapping_add(param_name_at, 3)) == 102;
        if !is_self {
            out.push(58);
            out.push(32);
            type_display(in ctx.types, in ctx.names, g32(in sigs.param_ty, param_index), inout out);
        }
    }
    out.push(41);
    let mut result_text = ChunkSeq::new[u8]();
    type_display(in ctx.types, in ctx.names, g32(in sigs.result_ty, fn_index), inout result_text);
    let shown = result_text.as_slice();
    let infer = result_text.len() == 1 && byte(in shown, 0) == 95;
    let unit = (result_text.len() == 2 && byte(in shown, 0) == 40 && byte(in shown, 1) == 41)
        || (
            result_text.len() == 4
                && byte(in shown, 0) == 85
                && byte(in shown, 1) == 110
                && byte(in shown, 2) == 105
                && byte(in shown, 3) == 116
        );
    if !infer && !unit {
        put(inout out, in " -> ");
        put_bytes(inout out, in shown);
    }
    let inst_count = w(g32(in sigs.inst_count, fn_index));
    if inst_count > 0 {
        put(inout out, in " eff [");
        let inst_start = w(g32(in sigs.inst_start, fn_index));
        for j in 0..inst_count {
            if j > 0 {
                out.push(44);
                out.push(32);
            }
            let inst_index = wrapping_add(inst_start, j);
            put_blob(
                inout out,
                in bytes,
                wrapping_add(names_at, g64(in sigs.inst_name_at, inst_index)),
                g64(in sigs.inst_name_len, inst_index)
            );
        }
        out.push(93);
    }
}

fn put_pool(inout out: ChunkSeq[u8], in pool: ChunkSeq[u8], at: u64, len: u64) {
    for i in 0..len {
        out.push(g8(in pool, wrapping_add(at, i)));
    }
}

fn is_space(ch: u8) -> bool {
    ch == 32 || (ch >= 9 && ch <= 13)
}

fn same_bytes(in expected: Slice[u8], in bytes: Slice[u8], at: u64, len: u64) -> bool {
    if expected.len() != len {
        return false;
    }
    for i in 0..len {
        if byte(in expected, i) != byte(in bytes, wrapping_add(at, i)) {
            return false;
        }
    }
    true
}

// `ceiling_grants`: by the effect's name, or by its exact rendering
// (compared without white space).
fn grants(
    in ceil: ChunkSeq[u64],
    in bytes: Slice[u8],
    names_at: u64,
    in rendered: Slice[u8]
) -> bool {
    let mut canonical = ChunkSeq::new[u8]();
    let mut bracket = NONE64;
    for i in 0..rendered.len() {
        let ch = byte(in rendered, i);
        if !is_space(ch) {
            canonical.push(ch);
        }
        if ch == 91 && bracket == NONE64 {
            bracket = i;
        }
    }
    let entry_count = ceil.len() / 2;
    for j in 0..entry_count {
        let at = wrapping_add(names_at, g64(in ceil, wrapping_mul(j, 2)));
        let len = g64(in ceil, inc(wrapping_mul(j, 2)));
        if same_bytes(in canonical.as_slice(), in bytes, at, len) {
            return true;
        }
        if bracket != NONE64 && same_bytes(in rendered[0..bracket], in bytes, at, len) {
            return true;
        }
    }
    false
}

// Byte order of names[a..+al] and names[b..+bl]: -1, 0 or 1.
fn cmp_blob(in bytes: Slice[u8], a: u64, al: u64, b: u64, bl: u64) -> i64 {
    let common_len = if al < bl { al } else { bl };
    for i in 0..common_len {
        let lhs_byte = byte(in bytes, wrapping_add(a, i));
        let rhs_byte = byte(in bytes, wrapping_add(b, i));
        if lhs_byte < rhs_byte {
            return -1;
        }
        if lhs_byte > rhs_byte {
            return 1;
        }
    }
    if al < bl {
        -1
    } else if al > bl {
        1
    } else {
        0
    }
}

// `View::complete_member` and `rank_methods_within`, as `C` and `M` rows.
// Ranked member completions for a receiver (`View::complete_member`):
// the binding (NONE64: none), and per candidate its tier, label (in the
// input), detail and badge (pooled; badge length NONE64: none) in `order`.
struct Ranked {
    binding: u64,
    tier: ChunkSeq[u8],
    label_at: ChunkSeq[u64],
    label_len: ChunkSeq[u64],
    detail_at: ChunkSeq[u64],
    detail_len: ChunkSeq[u64],
    badge_len: ChunkSeq[u64],
    pool: ChunkSeq[u8],
    order: ChunkSeq[u64]
}

fn ranked_new() -> Ranked {
    Ranked {
        binding: NONE64,
        tier: ChunkSeq::new[u8](),
        label_at: ChunkSeq::new[u64](),
        label_len: ChunkSeq::new[u64](),
        detail_at: ChunkSeq::new[u64](),
        detail_len: ChunkSeq::new[u64](),
        badge_len: ChunkSeq::new[u64](),
        pool: ChunkSeq::new[u8](),
        order: ChunkSeq::new[u64]()
    }
}

fn put_tier(inout out: ChunkSeq[u8], tier: u8) {
    if tier == 0 {
        put(inout out, in "discharges_live_linear");
    } else if tier == 1 {
        put(inout out, in "valid_frame_compatible");
    } else if tier == 2 {
        put(inout out, in "blocked_by_frame");
    } else {
        put(inout out, in "exceeds_capability_ceiling");
    }
}

fn rank_members(
    inout ranked: Ranked,
    in walker: Ow,
    in view: View,
    in ctx: Ctx,
    in ast: Ast,
    in callees: Callees,
    in sigs: Sigs,
    in bytes: Slice[u8],
    names_at: u64,
    in ceil: ChunkSeq[u64],
    has_ceiling: bool,
    name: u32,
    query_at: u64
) {
    let mut at = query_at;
    let binding = view_binding(in walker, in view, name, inout at);
    ranked.binding = binding;
    if binding == NONE64 {
        return;
    }
    let mut prefix = ChunkSeq::new[u8]();
    let ty = g32(in walker.binding_ty, binding);
    ctx.names.write(ctx.types.name(ty), inout prefix);
    if prefix.len() == 0 {
        return;
    }
    prefix.push(58);
    prefix.push(58);
    let prefix_len = prefix.len();
    // The frame: `outstanding` at the offset the binding was read at.
    let mut live_bindings = ChunkSeq::new[u64]();
    view_live(inout live_bindings, in walker, in view, at);
    let mut receiver_live = false;
    let mut others = ChunkSeq::new[u64]();
    for j in 0..live_bindings.len() {
        let live_binding = g64(in live_bindings, j);
        if same_origin(in walker, live_binding, binding) {
            receiver_live = true;
        } else {
            others.push(live_binding);
        }
    }
    // Candidates: tier, label, detail and badge (pooled text).
    for fn_index in 0..sigs.fn_name_at.len() {
        let name_at = wrapping_add(names_at, g64(in sigs.fn_name_at, fn_index));
        let len = g64(in sigs.fn_name_len, fn_index);
        if len < prefix_len || g8(in callees.fn_self, fn_index) == 0 {
            continue;
        }
        if !same_bytes(in prefix.as_slice(), in bytes, name_at, prefix_len) {
            continue;
        }
        let sink = g8(in callees.passes, w(g32(in callees.fn_pass_start, fn_index))) == PASS_SINK;
        let start = ranked.pool.len();
        signature(inout ranked.pool, in ctx, in callees, in sigs, in bytes, names_at, fn_index);
        let detail_len = wrapping_sub(ranked.pool.len(), start);
        let inst_start = w(g32(in sigs.inst_start, fn_index));
        let inst_count = w(g32(in sigs.inst_count, fn_index));
        let mut tier: u8 = 1;
        let mut badged = false;
        if has_ceiling {
            let mut outside = ChunkSeq::new[u8]();
            let mut any = false;
            for j in 0..inst_count {
                let mut rendered = ChunkSeq::new[u8]();
                render_effect(
                    inout rendered,
                    in ctx,
                    in sigs,
                    in bytes,
                    names_at,
                    wrapping_add(inst_start, j)
                );
                if !grants(in ceil, in bytes, names_at, in rendered.as_slice()) {
                    if any {
                        outside.push(44);
                        outside.push(32);
                    }
                    put_bytes(inout outside, in rendered.as_slice());
                    any = true;
                }
            }
            if any {
                tier = 3;
                badged = true;
                put(inout ranked.pool, in "exceeds Loom.toml capability ceiling: ");
                put_bytes(inout ranked.pool, in outside.as_slice());
            }
        }
        if !badged {
            // The first abortable (non-linear) effect.
            let mut abortable = NONE64;
            for j in 0..inst_count {
                let inst_index = wrapping_add(inst_start, j);
                let effect_entry = table_get(
                    in callees.effect_by_sym,
                    g32(in sigs.inst_sym, inst_index)
                );
                if effect_entry != 0
                    && g8(in sigs.effect_linear, w(wrapping_sub(effect_entry, 1))) == 0
                {
                    abortable = inst_index;
                    break;
                }
            }
            let stranded_receiver = receiver_live && !sink;
            if abortable != NONE64 && (stranded_receiver || others.len() > 0) {
                tier = 2;
                badged = true;
                put(inout ranked.pool, in "blocked: abortable effect ");
                put_blob(
                    inout ranked.pool,
                    in bytes,
                    wrapping_add(names_at, g64(in sigs.inst_name_at, abortable)),
                    g64(in sigs.inst_name_len, abortable)
                );
                put(inout ranked.pool, in " while ");
                if stranded_receiver {
                    put(inout ranked.pool, in "the receiver");
                } else {
                    ranked.pool.push(39);
                    put_name(
                        inout ranked.pool,
                        in ast,
                        g32(in walker.binding_name, g64(in others, 0))
                    );
                    ranked.pool.push(39);
                }
                put(inout ranked.pool, in " is a live linear value");
            } else if receiver_live && sink {
                tier = 0;
                badged = true;
                put(inout ranked.pool, in "discharges linear obligation");
            }
        }
        ranked.tier.push(tier);
        ranked.label_at.push(wrapping_add(name_at, prefix_len));
        ranked.label_len.push(wrapping_sub(len, prefix_len));
        ranked.detail_at.push(start);
        ranked.detail_len.push(detail_len);
        ranked.badge_len.push(
            if badged {
                wrapping_sub(wrapping_sub(ranked.pool.len(), start), detail_len)
            } else {
                NONE64
            }
        );
    }
    // Stable order by tier, then label.
    for i in 0..ranked.tier.len() {
        let mut j = ranked.order.len();
        loop {
            if j == 0 {
                break;
            }
            let prev_row = g64(in ranked.order, wrapping_sub(j, 1));
            let prev_tier = g8(in ranked.tier, prev_row);
            let cur_tier = g8(in ranked.tier, i);
            let before = cur_tier < prev_tier
                || (
                    cur_tier == prev_tier
                        && cmp_blob(
                            in bytes,
                            g64(in ranked.label_at, i),
                            g64(in ranked.label_len, i),
                            g64(in ranked.label_at, prev_row),
                            g64(in ranked.label_len, prev_row)
                        )
                            < 0
                );
            if !before {
                break;
            }
            j = wrapping_sub(j, 1);
        }
        ranked.order.push(0);
        let mut slot = wrapping_sub(ranked.order.len(), 1);
        loop {
            if slot <= j {
                break;
            }
            let prev = g64(in ranked.order, wrapping_sub(slot, 1));
            let ok = ranked.order.try_set(slot, prev);
            slot = wrapping_sub(slot, 1);
        }
        let ok = ranked.order.try_set(j, i);
    }
}

// The `C` row of a `complete_member` query and its `M` rows.
fn complete_member(
    inout out: ChunkSeq[u8],
    in walker: Ow,
    in view: View,
    in ctx: Ctx,
    in ast: Ast,
    in callees: Callees,
    in sigs: Sigs,
    in bytes: Slice[u8],
    names_at: u64,
    in ceil: ChunkSeq[u64],
    has_ceiling: bool,
    name: u32,
    query_at: u64
) {
    put(inout out, in "C\t");
    put_name(inout out, in ast, name);
    tab_u(inout out, query_at);
    let mut ranked = ranked_new();
    rank_members(
        inout ranked,
        in walker,
        in view,
        in ctx,
        in ast,
        in callees,
        in sigs,
        in bytes,
        names_at,
        in ceil,
        has_ceiling,
        name,
        query_at
    );
    if ranked.binding == NONE64 {
        put(inout out, in "\t-\n");
        return;
    }
    tab_u(inout out, g64(in walker.binding_origin_start, ranked.binding));
    out.push(10);
    for rank in 0..ranked.order.len() {
        let i = g64(in ranked.order, rank);
        put(inout out, in "M\t");
        put_tier(inout out, g8(in ranked.tier, i));
        out.push(9);
        put_blob(inout out, in bytes, g64(in ranked.label_at, i), g64(in ranked.label_len, i));
        out.push(9);
        let detail_at = g64(in ranked.detail_at, i);
        let detail_len = g64(in ranked.detail_len, i);
        put_pool(inout out, in ranked.pool, detail_at, detail_len);
        out.push(9);
        let badge_len = g64(in ranked.badge_len, i);
        if badge_len == NONE64 {
            out.push(45);
        } else {
            let badge_at = wrapping_add(detail_at, detail_len);
            put_pool(inout out, in ranked.pool, badge_at, badge_len);
        }
        out.push(10);
    }
}

// `lens::view_dump`.
fn view_dump(
    inout out: ChunkSeq[u8],
    in walker: Ow,
    in view: View,
    in ctx: Ctx,
    in ast: Ast,
    in callees: Callees,
    in sigs: Sigs,
    in bytes: Slice[u8],
    names_at: u64,
    in queries: Queries
) {
    if view.status == 2 {
        put(inout out, in "U\trepaired_prefix_does_not_parse\n");
        return;
    }
    if view.status == 3 {
        put(inout out, in "U\tlens_resource_limit\n");
        return;
    }
    if view.status > 3 {
        put(inout out, in "U\teditor_guard_rejected\n");
        return;
    }
    if dump_err(inout out, in walker) {
        return;
    }
    put(inout out, in "S\t");
    if view.region_kind.len() > 0 {
        put(inout out, in "recovered_prefix");
    } else if view.status == 0 {
        put(inout out, in "lens_profile_checked");
    } else {
        put(inout out, in "semantic_error_partial");
    }
    // `absorbed`: diagnostics inside a region's declaration that end past
    // its cut.
    let mut absorbed: u64 = 0;
    for diag_index in 0..view.diag_start.len() {
        let diag_start = g64(in view.diag_start, diag_index);
        let diag_end = g64(in view.diag_end, diag_index);
        for i in 0..view.region_kind.len() {
            if g64(in view.region_decl_start, i) <= diag_start
                && diag_end > g64(in view.region_cut, i)
            {
                absorbed = inc(absorbed);
                break;
            }
        }
    }
    tab_u(inout out, absorbed);
    out.push(10);
    dump_facts(inout out, in walker, in ctx, in ast);
    let mut res = ChunkSeq::new[u64]();
    for i in 0..queries.cursors.len() {
        let at = g64(in queries.cursors, i);
        out.push(79);
        tab_u(inout out, at);
        res.clear();
        view_live(inout res, in walker, in view, at);
        for j in 0..res.len() {
            tab_u(inout out, g64(in walker.binding_origin_start, g64(in res, j)));
        }
        out.push(10);
    }
    // `poisoned`: the live bindings at each damaged body's cut.
    for i in 0..view.region_kind.len() {
        if g8(in view.region_kind, i) != BODY {
            continue;
        }
        let fn_index = region_function(in walker, in view, i);
        if fn_index == NONE64 {
            continue;
        }
        let cut = g64(in view.region_cut, i);
        out.push(80);
        tab_u(inout out, cut);
        res.clear();
        live(inout res, in walker, fn_index, cut);
        for j in 0..res.len() {
            tab_u(inout out, g64(in walker.binding_origin_start, g64(in res, j)));
        }
        out.push(10);
    }
    for i in 0..queries.binding_sym.len() {
        let name = g32(in queries.binding_sym, i);
        let query_at = g64(in queries.binding_at, i);
        put(inout out, in "R\t");
        put_name(inout out, in ast, name);
        tab_u(inout out, query_at);
        let mut at = query_at;
        let binding = view_binding(in walker, in view, name, inout at);
        if binding == NONE64 {
            put(inout out, in "\t-\n");
        } else {
            tab_u(inout out, g64(in walker.binding_origin_start, binding));
            tab_u(inout out, at);
            out.push(10);
        }
    }
    for i in 0..queries.member_sym.len() {
        complete_member(
            inout out,
            in walker,
            in view,
            in ctx,
            in ast,
            in callees,
            in sigs,
            in bytes,
            names_at,
            in queries.ceiling,
            queries.has_ceiling,
            g32(in queries.member_sym, i),
            g64(in queries.member_at, i)
        );
    }
}

// The queries of a view: cursors, `binding` and `complete_member`
// requests (names as AST symbols), and the capability ceiling (entries in
// the names blob).
struct Queries {
    cursors: ChunkSeq[u64],
    binding_sym: ChunkSeq[u32],
    binding_at: ChunkSeq[u64],
    member_sym: ChunkSeq[u32],
    member_at: ChunkSeq[u64],
    has_ceiling: bool,
    ceiling: ChunkSeq[u64]
}

// A view's decoded input: the checker's facts, callees and signatures, the
// view's basis and regions, its queries and its lowered text; `end` is the
// offset after the names blob.
struct Setup {
    ctx: Ctx,
    callees: Callees,
    sigs: Sigs,
    view: View,
    queries: Queries,
    ast: Ast,
    names_at: u64,
    end: u64,
    reps: u64,
    self_sym: u32
}

// `View` status of a checked snapshot's view (`View::checked`).
const CHECKED: u64 = 5;

fn ty_word(in ctx: Ctx, in bytes: Slice[u8], inout reader: Rd) -> u32 {
    g32(in ctx.tmap, word(in bytes, inout reader))
}

fn names_pair(in bytes: Slice[u8], inout reader: Rd, inout to: ChunkSeq[u64]) {
    to.push(word(in bytes, inout reader));
    to.push(word(in bytes, inout reader));
}

// Reads the harness input of a view (see `lens_view`).
fn view_setup(in bytes: Slice[u8]) -> Setup {
    let mut ctx_reader = CtxReader { pos: 0 };
    let mut ctx = read_ctx(inout ctx_reader, in bytes);
    let mut reader = Rd { pos: ctx_reader.pos };
    let mut fn_name = ChunkSeq::new[u64]();
    let mut callees = callees_new();
    let mut ef_name = ChunkSeq::new[u64]();
    let mut op_name = ChunkSeq::new[u64]();
    read_callees(
        in bytes,
        inout reader,
        inout callees,
        inout fn_name,
        inout ef_name,
        inout op_name
    );
    let fn_count = fn_name.len() / 2;
    let mut sigs = Sigs {
        fn_name_at: ChunkSeq::with_capacity[u64](fn_count),
        fn_name_len: ChunkSeq::with_capacity[u64](fn_count),
        param_name_at: ChunkSeq::new[u64](),
        param_name_len: ChunkSeq::new[u64](),
        param_ty: ChunkSeq::new[u32](),
        result_ty: ChunkSeq::with_capacity[u32](fn_count),
        inst_start: ChunkSeq::with_capacity[u32](fn_count),
        inst_count: ChunkSeq::with_capacity[u32](fn_count),
        inst_name_at: ChunkSeq::new[u64](),
        inst_name_len: ChunkSeq::new[u64](),
        inst_sym: ChunkSeq::new[u32](),
        inst_arg_start: ChunkSeq::new[u32](),
        inst_arg_count: ChunkSeq::new[u32](),
        arg_ty: ChunkSeq::new[u32](),
        effect_linear: ChunkSeq::new[u8]()
    };
    for fn_index in 0..fn_count {
        sigs.fn_name_at.push(g64(in fn_name, wrapping_mul(fn_index, 2)));
        sigs.fn_name_len.push(g64(in fn_name, inc(wrapping_mul(fn_index, 2))));
        for j in 0..w(g32(in callees.fn_pass_count, fn_index)) {
            sigs.param_name_at.push(word(in bytes, inout reader));
            sigs.param_name_len.push(word(in bytes, inout reader));
            sigs.param_ty.push(ty_word(in ctx, in bytes, inout reader));
        }
        sigs.result_ty.push(ty_word(in ctx, in bytes, inout reader));
        let inst_count = word(in bytes, inout reader);
        sigs.inst_start.push(wrapping_u32(sigs.inst_name_at.len()));
        sigs.inst_count.push(wrapping_u32(inst_count));
        for j in 0..inst_count {
            sigs.inst_name_at.push(word(in bytes, inout reader));
            sigs.inst_name_len.push(word(in bytes, inout reader));
            let arg_count = word(in bytes, inout reader);
            sigs.inst_arg_start.push(wrapping_u32(sigs.arg_ty.len()));
            sigs.inst_arg_count.push(wrapping_u32(arg_count));
            for arg_index in 0..arg_count {
                sigs.arg_ty.push(ty_word(in ctx, in bytes, inout reader));
            }
        }
    }
    for eff_index in 0..ef_name.len() / 2 {
        sigs.effect_linear.push(wrapping_u8(word(in bytes, inout reader)));
    }
    let mut view = View {
        status: word(in bytes, inout reader),
        region_kind: ChunkSeq::new[u8](),
        region_decl_start: ChunkSeq::new[u64](),
        region_scope_start: ChunkSeq::new[u64](),
        region_scope_end: ChunkSeq::new[u64](),
        region_cut: ChunkSeq::new[u64](),
        diag_start: ChunkSeq::new[u64](),
        diag_end: ChunkSeq::new[u64]()
    };
    let region_count = word(in bytes, inout reader);
    for i in 0..region_count {
        view.region_kind.push(wrapping_u8(word(in bytes, inout reader)));
        view.region_decl_start.push(word(in bytes, inout reader));
        view.region_scope_start.push(word(in bytes, inout reader));
        view.region_scope_end.push(word(in bytes, inout reader));
        view.region_cut.push(word(in bytes, inout reader));
    }
    let diag_count = word(in bytes, inout reader);
    for i in 0..diag_count {
        view.diag_start.push(word(in bytes, inout reader));
        view.diag_end.push(word(in bytes, inout reader));
    }
    let mut queries = Queries {
        cursors: ChunkSeq::new[u64](),
        binding_sym: ChunkSeq::new[u32](),
        binding_at: ChunkSeq::new[u64](),
        member_sym: ChunkSeq::new[u32](),
        member_at: ChunkSeq::new[u64](),
        has_ceiling: false,
        ceiling: ChunkSeq::new[u64]()
    };
    let cursor_count = word(in bytes, inout reader);
    for i in 0..cursor_count {
        queries.cursors.push(word(in bytes, inout reader));
    }
    let mut b_name = ChunkSeq::new[u64]();
    let binding_count = word(in bytes, inout reader);
    for i in 0..binding_count {
        names_pair(in bytes, inout reader, inout b_name);
        queries.binding_at.push(word(in bytes, inout reader));
    }
    let mut m_name = ChunkSeq::new[u64]();
    let member_count = word(in bytes, inout reader);
    for i in 0..member_count {
        names_pair(in bytes, inout reader, inout m_name);
        queries.member_at.push(word(in bytes, inout reader));
    }
    queries.has_ceiling = word(in bytes, inout reader) != 0;
    let ceiling_count = word(in bytes, inout reader);
    for i in 0..ceiling_count {
        names_pair(in bytes, inout reader, inout queries.ceiling);
    }
    let text_len = word(in bytes, inout reader);
    let names_len = word(in bytes, inout reader);
    let reps = word(in bytes, inout reader);
    let text = match String::from_utf8(in bytes[reader.pos..wrapping_add(reader.pos, text_len)]) {
        Option::Some(x) => x,
        Option::None => String::new(),
    };
    let names_at = wrapping_add(reader.pos, text_len);
    let lowered = lower_source(in text);
    let mut ast = lowered.ast;
    link_callees(inout ast, in bytes, names_at, inout callees, in fn_name, in ef_name, in op_name);
    for i in 0..sigs.inst_name_at.len() {
        let sym = blob_sym(
            inout ast,
            in bytes,
            names_at,
            g64(in sigs.inst_name_at, i),
            g64(in sigs.inst_name_len, i)
        );
        sigs.inst_sym.push(sym);
    }
    for i in 0..binding_count {
        let sym = blob_sym(
            inout ast,
            in bytes,
            names_at,
            g64(in b_name, wrapping_mul(i, 2)),
            g64(in b_name, inc(wrapping_mul(i, 2)))
        );
        queries.binding_sym.push(sym);
    }
    for i in 0..member_count {
        let sym = blob_sym(
            inout ast,
            in bytes,
            names_at,
            g64(in m_name, wrapping_mul(i, 2)),
            g64(in m_name, inc(wrapping_mul(i, 2)))
        );
        queries.member_sym.push(sym);
    }
    let self_sym = match ast.names.lookup(in "self") {
        Option::Some(x) => x.id(),
        Option::None => NONE,
    };
    Setup {
        ctx: ctx,
        callees: callees,
        sigs: sigs,
        view: view,
        queries: queries,
        ast: ast,
        names_at: names_at,
        end: wrapping_add(names_at, names_len),
        reps: reps,
        self_sym: self_sym
    }
}

// The view's facts, built again into `walker`.
fn setup_facts(inout walker: Ow, inout setup: Setup) {
    ow_clear(inout walker);
    if setup.view.status < 2 || setup.view.status == CHECKED {
        let ok = facts(
            inout walker,
            inout setup.ctx,
            in setup.ast,
            in setup.callees,
            setup.self_sym
        );
        if ok {
            index_facts(inout walker);
        }
    }
}

// The harness input of a view: the checker's facts on the view's text and
// the callee sections as for `lens_facts`; then per function its
// parameters' names and types, its result type and its effect instances
// (name, argument count and types), and per effect whether it is linear;
// the editor guard's outcome, the regions (kind, declaration start, scope,
// cut) and the checker's diagnostic spans; the cursors, the `binding` and
// `complete_member` requests (name, cursor) and the capability ceiling
// (present, entries); the text and names lengths and the round count; then
// the text and the names blob.
pub fn lens_view(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mut setup = view_setup(in bytes);
    let mut out = ChunkSeq::new[u8]();
    let mut walker = ow_new();
    for round in 0..setup.reps {
        out.clear();
        setup_facts(inout walker, inout setup);
        view_dump(
            inout out,
            in walker,
            in setup.view,
            in setup.ctx,
            in setup.ast,
            in setup.callees,
            in setup.sigs,
            in bytes,
            setup.names_at,
            in setup.queries
        );
    }
    pack(in out.as_slice())
}

// ------------------------------------------------------------ requests
//
// The Lens request layer of the server (`session/lens_requests.rs`):
// poison notices and Lens metadata, obligation-guided member completion,
// obligation hovers and linear-binding inlay hints, on the document text
// and its line index, against the document's view.

// The document a view answers for: its text and line table, the URI and
// the regions' names, depths, declaration ends and damage (in the input).
struct Doc {
    text: String,
    lines: ChunkSeq[u64],
    max_work: usize,
    uri_at: u64,
    uri_len: u64,
    region_name_at: ChunkSeq[u64],
    region_name_len: ChunkSeq[u64],
    region_depth: ChunkSeq[u64],
    region_decl_end: ChunkSeq[u64],
    region_damage_start: ChunkSeq[u64],
    region_damage_end: ChunkSeq[u64]
}

fn rq_pos_ok(p: Position) -> Result[Position, SpanError] {
    Result::Ok(p)
}

fn rq_pos_err(e: SpanError) -> Result[Position, SpanError] {
    Result::Err(e)
}

fn rq_position(in doc: Doc, at: u64) -> Result[Position, SpanError] {
    handle Fail[SpanError] in {
        rq_pos_ok(position(in doc.text, in doc.lines.as_slice(), doc.max_work, narrow_usize(at)))
    } with {
        return v => v,
        raise(err, resume) => rq_pos_err(err),
    }
}

fn rq_off_ok(v: usize) -> Result[usize, SpanError] {
    Result::Ok(v)
}

fn rq_off_err(e: SpanError) -> Result[usize, SpanError] {
    Result::Err(e)
}

fn rq_offset(in doc: Doc, p: Position) -> Result[usize, SpanError] {
    handle Fail[SpanError] in {
        rq_off_ok(offset(in doc.text, in doc.lines.as_slice(), doc.max_work, p))
    } with {
        return v => v,
        raise(err, resume) => rq_off_err(err),
    }
}

fn rq_range_ok(r: Range) -> Result[Range, SpanError] {
    Result::Ok(r)
}

fn rq_range_err(e: SpanError) -> Result[Range, SpanError] {
    Result::Err(e)
}

fn rq_range(in doc: Doc, s: u64, e: u64) -> Result[Range, SpanError] {
    handle Fail[SpanError] in {
        rq_range_ok(range(
            in doc.text,
            in doc.lines.as_slice(),
            doc.max_work,
            ByteSpan { start: narrow_usize(s), end: narrow_usize(e) }
        ))
    } with {
        return v => v,
        raise(err, resume) => rq_range_err(err),
    }
}

fn rq_lines_ok(sink v: ChunkSeq[u64]) -> Result[ChunkSeq[u64], SpanError] {
    Result::Ok(v)
}

fn rq_lines_err(e: SpanError) -> Result[ChunkSeq[u64], SpanError] {
    Result::Err(e)
}

fn rq_lines(in text: Str, in limits: Limits) -> Result[ChunkSeq[u64], SpanError] {
    handle Fail[SpanError] in {
        rq_lines_ok(line_table(in text, in limits, narrow_usize(16)))
    } with {
        return v => v,
        raise(err, resume) => rq_lines_err(err),
    }
}

// The 1-based line of `at`, or 0.
fn line_of(in doc: Doc, at: u64) -> u64 {
    match rq_position(in doc, at) {
        Result::Ok(p) => inc(widen_u64(p.line)),
        Result::Err(_) => 0,
    }
}

fn put_json_name(inout out: ChunkSeq[u8], in ast: Ast, name: u32) {
    let mut text = ChunkSeq::new[u8]();
    put_name(inout text, in ast, name);
    put_string(inout out, in text.as_slice());
}

fn put_json_type(inout out: ChunkSeq[u8], in ctx: Ctx, ty: u32) {
    let mut text = ChunkSeq::new[u8]();
    type_display(in ctx.types, in ctx.names, ty, inout text);
    put_string(inout out, in text.as_slice());
}

fn put_byte_range(inout out: ChunkSeq[u8], start: u64, end: u64) {
    put(inout out, in "{\"end\":");
    put_u64(inout out, end);
    put(inout out, in ",\"start\":");
    put_u64(inout out, start);
    out.push(125);
}

// `View::scope`.
fn put_scope(inout out: ChunkSeq[u8], in view: View) {
    if view.status == CHECKED {
        put(inout out, in "checked");
    } else if view.region_kind.len() > 0 {
        put(inout out, in "recovered_prefix");
    } else if view.status == 0 {
        put(inout out, in "lens_profile_checked");
    } else {
        put(inout out, in "semantic_error_partial");
    }
}

// Why the view is unavailable (`Unavailable::as_str`), or nothing.
fn put_reason(inout out: ChunkSeq[u8], in walker: Ow, in view: View) -> bool {
    if view.status == 2 {
        put(inout out, in "repaired_prefix_does_not_parse");
    } else if view.status == 3 {
        put(inout out, in "lens_resource_limit");
    } else if view.status == 4 {
        put(inout out, in "editor_guard_rejected");
    } else if walker.err == RESOURCE {
        put(inout out, in "lens_resource_limit");
    } else if walker.err != OK {
        put(inout out, in "opaque_declaration");
    } else {
        return false;
    }
    true
}

fn view_ok(in walker: Ow, in view: View) -> bool {
    (view.status < 2 || view.status == CHECKED) && walker.err == OK
}

// `lens_unavailable`, as a JSON-RPC error answer.
fn put_unavailable(
    inout out: ChunkSeq[u8],
    in walker: Ow,
    in view: View,
    in bytes: Slice[u8],
    in doc: Doc
) {
    put(inout out, in "{\"error\":{\"code\":-32003,\"data\":{\"kind\":\"lens\",\"reason\":\"");
    let any = put_reason(inout out, in walker, in view);
    put(inout out, in "\",\"status\":\"analysis_unavailable\",\"uri\":");
    put_string(inout out, in bytes[doc.uri_at..wrapping_add(doc.uri_at, doc.uri_len)]);
    put(inout out, in "},\"message\":\"Lens analysis is unavailable\"}}");
}

// `ServerError::params(e.to_string())`.
fn put_params_error(inout out: ChunkSeq[u8], e: SpanError) {
    put(inout out, in "{\"error\":{\"code\":-32602,\"data\":null,\"message\":\"");
    put_span_error(inout out, e);
    put(inout out, in "\"}}");
}

fn absorbed(in view: View) -> u64 {
    let mut n: u64 = 0;
    for i in 0..view.diag_start.len() {
        let diag_start = g64(in view.diag_start, i);
        let diag_end = g64(in view.diag_end, i);
        for j in 0..view.region_kind.len() {
            if g64(in view.region_decl_start, j) <= diag_start
                && diag_end > g64(in view.region_cut, j)
            {
                n = inc(n);
                break;
            }
        }
    }
    n
}

// `poison_of` (the `D` row): the notices, a tab, then the metadata.
fn poison(
    inout out: ChunkSeq[u8],
    in walker: Ow,
    in view: View,
    in ctx: Ctx,
    in ast: Ast,
    in bytes: Slice[u8],
    in doc: Doc
) {
    put(inout out, in "D\t");
    if !view_ok(in walker, in view) {
        put(inout out, in "[]\t{\"reason\":\"");
        let any = put_reason(inout out, in walker, in view);
        put(inout out, in "\",\"status\":\"unavailable\"}\n");
        return;
    }
    let mut meta = ChunkSeq::new[u8]();
    let mut n_diag: u64 = 0;
    let mut n_meta: u64 = 0;
    out.push(91);
    let mut res = ChunkSeq::new[u64]();
    for i in 0..view.region_kind.len() {
        if g8(in view.region_kind, i) != BODY {
            continue;
        }
        let fn_index = region_function(in walker, in view, i);
        if fn_index == NONE64 {
            continue;
        }
        let damage_start = g64(in doc.region_damage_start, i);
        let damage = match rq_range(in doc, damage_start, g64(in doc.region_damage_end, i)) {
            Result::Ok(r) => r,
            Result::Err(_) => continue,
        };
        let line = line_of(in doc, damage_start);
        let cut = g64(in view.region_cut, i);
        let fname = bytes[
            g64(in doc.region_name_at, i)..wrapping_add(
                g64(in doc.region_name_at, i),
                g64(in doc.region_name_len, i)
            )
        ];
        res.clear();
        live(inout res, in walker, fn_index, cut);
        for j in 0..res.len() {
            let binding = g64(in res, j);
            let origin_start = g64(in walker.binding_origin_start, binding);
            let origin_end = g64(in walker.binding_origin_end, binding);
            let origin = match rq_range(in doc, origin_start, origin_end) {
                Result::Ok(r) => r,
                Result::Err(_) => continue,
            };
            if n_diag > 0 {
                out.push(44);
            }
            n_diag = inc(n_diag);
            put(inout out, in "{\"code\":\"VESPER_POISONED_RECOVERY\",\"data\":{\"binding\":");
            put_json_name(inout out, in ast, g32(in walker.binding_name, binding));
            put(inout out, in ",\"function\":");
            put_string(inout out, in fname);
            put(inout out, in ",\"status\":\"poisoned_recovery\",\"type\":");
            put_json_type(inout out, in ctx, g32(in walker.binding_ty, binding));
            put(inout out, in "},\"message\":");
            let mut message = ChunkSeq::new[u8]();
            put(inout message, in "linear binding '");
            put_name(inout message, in ast, g32(in walker.binding_name, binding));
            put(inout message, in "' is poisoned by unfinished code on line ");
            put_u64(inout message, line);
            put(inout message, in "; its scope-exit leak checks are suppressed until '");
            put_bytes(inout message, in fname);
            put(inout message, in "' parses again");
            put_string(inout out, in message.as_slice());
            put(inout out, in ",\"range\":");
            put_range(inout out, origin);
            put(inout out, in ",\"relatedInformation\":[{\"location\":{\"range\":");
            put_range(inout out, damage);
            put(inout out, in ",\"uri\":");
            put_string(inout out, in bytes[doc.uri_at..wrapping_add(doc.uri_at, doc.uri_len)]);
            put(
                inout out,
                in "},\"message\":\"unfinished code (PoisonedRecovery region)\"}],\"severity\":3,\"source\":\"vesper\"}"
            );
            if n_meta > 0 {
                meta.push(44);
            }
            n_meta = inc(n_meta);
            put(inout meta, in "{\"binding\":");
            put_json_name(inout meta, in ast, g32(in walker.binding_name, binding));
            put(inout meta, in ",\"cut\":");
            put_u64(inout meta, cut);
            put(inout meta, in ",\"function\":");
            put_string(inout meta, in fname);
            put(inout meta, in ",\"origin\":");
            put_byte_range(inout meta, origin_start, origin_end);
            put(inout meta, in ",\"region\":");
            put_byte_range(inout meta, damage_start, g64(in doc.region_damage_end, i));
            meta.push(125);
        }
    }
    put(inout out, in "]\t{\"absorbed_scope_exit_diagnostics\":");
    put_u64(inout out, absorbed(in view));
    put(inout out, in ",\"poisoned\":[");
    put_bytes(inout out, in meta.as_slice());
    put(inout out, in "],\"regions\":[");
    for i in 0..view.region_kind.len() {
        if i > 0 {
            out.push(44);
        }
        put(inout out, in "{\"cut\":");
        put_u64(inout out, g64(in view.region_cut, i));
        put(inout out, in ",\"depth\":");
        put_u64(inout out, g64(in doc.region_depth, i));
        put(inout out, in ",\"function\":");
        put_string(
            inout out,
            in bytes[
                g64(in doc.region_name_at, i)..wrapping_add(
                    g64(in doc.region_name_at, i),
                    g64(in doc.region_name_len, i)
                )
            ]
        );
        put(inout out, in ",\"kind\":\"");
        let region_kind = g8(in view.region_kind, i);
        if region_kind == BODY {
            put(inout out, in "body");
        } else if region_kind == 1 {
            put(inout out, in "header");
        } else {
            put(inout out, in "member");
        }
        put(inout out, in "\",\"scope\":");
        put_byte_range(
            inout out,
            g64(in view.region_scope_start, i),
            g64(in view.region_scope_end, i)
        );
        put(inout out, in ",\"span\":");
        put_byte_range(
            inout out,
            g64(in view.region_decl_start, i),
            g64(in doc.region_decl_end, i)
        );
        out.push(125);
    }
    put(inout out, in "],\"scope\":\"");
    put_scope(inout out, in view);
    put(inout out, in "\",\"status\":\"available\"}\n");
}

fn ident(ch: u8) -> bool {
    (ch >= 48 && ch <= 57) || (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || ch == 95
}

// `member_receiver`: the receiver span `s..e` of `receiver.partial|`
// before `at`, or false.
fn member_receiver(in text: Slice[u8], at: u64, inout s: u64, inout e: u64) -> bool {
    let mut i = at;
    loop {
        if i == 0 || !ident(byte(in text, wrapping_sub(i, 1))) {
            break;
        }
        i = wrapping_sub(i, 1);
    }
    if i == 0 || byte(in text, wrapping_sub(i, 1)) != 46 {
        return false;
    }
    let end = wrapping_sub(i, 1);
    let mut start = end;
    loop {
        if start == 0 || !ident(byte(in text, wrapping_sub(start, 1))) {
            break;
        }
        start = wrapping_sub(start, 1);
    }
    if start >= text.len() {
        return false;
    }
    let first = byte(in text, start);
    if start == end || !((first >= 97 && first <= 122) || first == 95) {
        return false;
    }
    if start > 0 && byte(in text, wrapping_sub(start, 1)) == 46 {
        return false;
    }
    s = start;
    e = end;
    true
}

// `capability_ceiling`: null or the entries.
fn put_ceiling(inout out: ChunkSeq[u8], in queries: Queries, in bytes: Slice[u8], names_at: u64) {
    if !queries.has_ceiling {
        put(inout out, in "null");
        return;
    }
    out.push(91);
    for i in 0..queries.ceiling.len() / 2 {
        if i > 0 {
            out.push(44);
        }
        let at = wrapping_add(names_at, g64(in queries.ceiling, wrapping_mul(i, 2)));
        put_string(
            inout out,
            in bytes[at..wrapping_add(at, g64(in queries.ceiling, inc(wrapping_mul(i, 2))))]
        );
    }
    out.push(93);
}

// `completion_of` (a `C` row).
fn completion(
    inout out: ChunkSeq[u8],
    in setup: Setup,
    in walker: Ow,
    in bytes: Slice[u8],
    in doc: Doc,
    pos: Position
) {
    put(inout out, in "C\t");
    let at = match rq_offset(in doc, pos) {
        Result::Ok(x) => widen_u64(x),
        Result::Err(e) => {
            put_params_error(inout out, e);
            out.push(10);
            return;
        }
    };
    let empty = "{\"isIncomplete\":false,\"items\":[]}\n";
    let text_bytes = doc.text.as_bytes();
    let mut recv_start: u64 = 0;
    let mut recv_end: u64 = 0;
    if !member_receiver(in text_bytes, at, inout recv_start, inout recv_end) {
        put(inout out, in empty);
        return;
    }
    if !view_ok(in walker, in setup.view) {
        put_unavailable(inout out, in walker, in setup.view, in bytes, in doc);
        out.push(10);
        return;
    }
    let name = match String::from_utf8(in text_bytes[recv_start..recv_end]) {
        Option::Some(x) => x,
        Option::None => String::new(),
    };
    let sym = match setup.ast.names.lookup(in name) {
        Option::Some(x) => x.id(),
        Option::None => NONE,
    };
    if sym == NONE {
        put(inout out, in empty);
        return;
    }
    let mut ranked = ranked_new();
    rank_members(
        inout ranked,
        in walker,
        in setup.view,
        in setup.ctx,
        in setup.ast,
        in setup.callees,
        in setup.sigs,
        in bytes,
        setup.names_at,
        in setup.queries.ceiling,
        setup.queries.has_ceiling,
        sym,
        recv_start
    );
    if ranked.binding == NONE64 {
        put(inout out, in empty);
        return;
    }
    let mut live_bindings = ChunkSeq::new[u64]();
    view_live(inout live_bindings, in walker, in setup.view, recv_start);
    let mut live_recv = false;
    for j in 0..live_bindings.len() {
        if same_origin(in walker, g64(in live_bindings, j), ranked.binding) {
            live_recv = true;
        }
    }
    put(inout out, in "{\"isIncomplete\":false,\"items\":[");
    for rank in 0..ranked.order.len() {
        let i = g64(in ranked.order, rank);
        if rank > 0 {
            out.push(44);
        }
        let tier = g8(in ranked.tier, i);
        // `data.vesper` keys sort as capability_ceiling, receiver,
        // receiver_live_linear, receiver_type, scope, tier.
        put(inout out, in "{\"data\":{\"vesper\":{\"capability_ceiling\":");
        put_ceiling(inout out, in setup.queries, in bytes, setup.names_at);
        put(inout out, in ",\"receiver\":");
        put_string(inout out, in text_bytes[recv_start..recv_end]);
        put(inout out, in ",\"receiver_live_linear\":");
        if live_recv {
            put(inout out, in "true");
        } else {
            put(inout out, in "false");
        }
        put(inout out, in ",\"receiver_type\":");
        put_json_type(inout out, in setup.ctx, g32(in walker.binding_ty, ranked.binding));
        put(inout out, in ",\"scope\":\"");
        put_scope(inout out, in setup.view);
        put(inout out, in "\",\"tier\":\"");
        put_tier(inout out, tier);
        put(inout out, in "\"}},\"detail\":");
        let detail_at = g64(in ranked.detail_at, i);
        let detail_len = g64(in ranked.detail_len, i);
        let mut detail = ChunkSeq::new[u8]();
        put_pool(inout detail, in ranked.pool, detail_at, detail_len);
        put_string(inout out, in detail.as_slice());
        put(inout out, in ",\"kind\":2,\"label\":");
        let label_at = g64(in ranked.label_at, i);
        put_string(
            inout out,
            in bytes[label_at..wrapping_add(label_at, g64(in ranked.label_len, i))]
        );
        let badge_len = g64(in ranked.badge_len, i);
        if badge_len != NONE64 {
            put(inout out, in ",\"labelDetails\":{\"description\":");
            let mut badge = ChunkSeq::new[u8]();
            put_pool(inout badge, in ranked.pool, wrapping_add(detail_at, detail_len), badge_len);
            put_string(inout out, in badge.as_slice());
            out.push(125);
        }
        put(inout out, in ",\"sortText\":\"");
        out.push(wrapping_add(48, tier));
        let sort_index = rank % 10000;
        out.push(wrapping_u8(wrapping_add(48, sort_index / 1000)));
        out.push(wrapping_u8(wrapping_add(48, sort_index / 100 % 10)));
        out.push(wrapping_u8(wrapping_add(48, sort_index / 10 % 10)));
        out.push(wrapping_u8(wrapping_add(48, sort_index % 10)));
        out.push(34);
        if tier >= 2 {
            put(inout out, in ",\"tags\":[1]");
        }
        out.push(125);
    }
    put(inout out, in "]}\n");
}

fn same_name_bytes(in x: Slice[u8], in y: Slice[u8]) -> bool {
    if x.len() != y.len() {
        return false;
    }
    for i in 0..x.len() {
        if byte(in x, i) != byte(in y, i) {
            return false;
        }
    }
    true
}

// `consumers`: consuming calls for binding `binding`'s type, for hover text.
fn consumers(
    inout out: ChunkSeq[u8],
    in walker: Ow,
    in setup: Setup,
    in bytes: Slice[u8],
    binding: u64
) {
    let mut type_name = ChunkSeq::new[u8]();
    setup
        .ctx
        .names
        .write(setup.ctx.types.name(g32(in walker.binding_ty, binding)), inout type_name);
    let type_name_len = type_name.len();
    let mut n: u64 = 0;
    for fn_index in 0..setup.sigs.fn_name_at.len() {
        let name_at = wrapping_add(setup.names_at, g64(in setup.sigs.fn_name_at, fn_index));
        let len = g64(in setup.sigs.fn_name_len, fn_index);
        let name = bytes[name_at..wrapping_add(name_at, len)];
        let method = len >= wrapping_add(type_name_len, 2)
            && same_bytes(in type_name.as_slice(), in bytes, name_at, type_name_len)
            && byte(in bytes, wrapping_add(name_at, type_name_len)) == 58
            && byte(in bytes, inc(wrapping_add(name_at, type_name_len))) == 58;
        let pass_start = w(g32(in setup.callees.fn_pass_start, fn_index));
        let pass_count = w(g32(in setup.callees.fn_pass_count, fn_index));
        if method {
            if g8(in setup.callees.fn_self, fn_index) == 1
                && pass_count > 0
                && g8(in setup.callees.passes, pass_start) == PASS_SINK
            {
                if n > 0 {
                    put(inout out, in ", ");
                }
                n = inc(n);
                put_name(inout out, in setup.ast, g32(in walker.binding_name, binding));
                out.push(46);
                put_bytes(inout out, in name[wrapping_add(type_name_len, 2)..len]);
                put(inout out, in "()");
            }
        } else {
            let mut qualified = false;
            for i in 0..len {
                if byte(in name, i) == 58 && inc(i) < len && byte(in name, inc(i)) == 58 {
                    qualified = true;
                    break;
                }
            }
            if !qualified {
                let mut takes = false;
                for j in 0..pass_count {
                    let pass_index = wrapping_add(pass_start, j);
                    if g8(in setup.callees.passes, pass_index) == PASS_SINK {
                        let mut param_type_name = ChunkSeq::new[u8]();
                        setup.ctx.names.write(
                            setup.ctx.types.name(g32(in setup.sigs.param_ty, pass_index)),
                            inout param_type_name
                        );
                        if same_name_bytes(in param_type_name.as_slice(), in type_name.as_slice()) {
                            takes = true;
                            break;
                        }
                    }
                }
                if takes {
                    if n > 0 {
                        put(inout out, in ", ");
                    }
                    n = inc(n);
                    put_bytes(inout out, in name);
                    put(inout out, in "(..)");
                }
            }
        }
        if n >= 8 {
            break;
        }
    }
}

// `obligation_text_of` (an `H` row): the text as a JSON string, or null.
fn hover(
    inout out: ChunkSeq[u8],
    in setup: Setup,
    in walker: Ow,
    in bytes: Slice[u8],
    in doc: Doc,
    pos: Position
) {
    put(inout out, in "H\t");
    if !view_ok(in walker, in setup.view) {
        put(inout out, in "null\n");
        return;
    }
    let at = match rq_offset(in doc, pos) {
        Result::Ok(x) => widen_u64(x),
        Result::Err(_) => {
            put(inout out, in "null\n");
            return;
        }
    };
    let mut live_bindings = ChunkSeq::new[u64]();
    view_live(inout live_bindings, in walker, in setup.view, at);
    if live_bindings.len() == 0 {
        put(inout out, in "null\n");
        return;
    }
    let mut text = ChunkSeq::new[u8]();
    put(inout text, in "outstanding linear obligations here (");
    put_scope(inout text, in setup.view);
    put(inout text, in "):");
    for j in 0..live_bindings.len() {
        let binding = g64(in live_bindings, j);
        put(inout text, in "\n- ");
        put_name(inout text, in setup.ast, g32(in walker.binding_name, binding));
        put(inout text, in ": ");
        type_display(
            in setup.ctx.types,
            in setup.ctx.names,
            g32(in walker.binding_ty, binding),
            inout text
        );
        put(inout text, in " (introduced on line ");
        put_u64(inout text, line_of(in doc, g64(in walker.binding_origin_start, binding)));
        text.push(41);
        let mut consumer_text = ChunkSeq::new[u8]();
        consumers(inout consumer_text, in walker, in setup, in bytes, binding);
        if consumer_text.len() > 0 {
            put(inout text, in "; discharge with ");
            put_bytes(inout text, in consumer_text.as_slice());
        }
    }
    put_string(inout out, in text.as_slice());
    out.push(10);
}

// `Binding::first_consumption_after`: the start of the first event of `binding`
// starting at or after `at`, or NONE64.
fn first_consumption_after(in walker: Ow, binding: u64, at: u64) -> u64 {
    let mut best = NONE64;
    let mut event = g32(in walker.binding_first_event, binding);
    loop {
        if event == 0 {
            break;
        }
        let i = w(wrapping_sub(event, 1));
        let start = g64(in walker.event_start, i);
        if start >= at && (best == NONE64 || start < best) {
            best = start;
        }
        event = g32(in walker.event_next, i);
    }
    best
}

// `inlay_hints_of` (an `I` row).
fn inlays(
    inout out: ChunkSeq[u8],
    in setup: Setup,
    in walker: Ow,
    in bytes: Slice[u8],
    in doc: Doc,
    range_start: Position,
    range_end: Position
) {
    put(inout out, in "I\t");
    let start = match rq_offset(in doc, range_start) {
        Result::Ok(x) => widen_u64(x),
        Result::Err(e) => {
            put_params_error(inout out, e);
            out.push(10);
            return;
        }
    };
    let end = match rq_offset(in doc, range_end) {
        Result::Ok(x) => widen_u64(x),
        Result::Err(_) => doc.text.len(),
    };
    if !view_ok(in walker, in setup.view) {
        put_unavailable(inout out, in walker, in setup.view, in bytes, in doc);
        out.push(10);
        return;
    }
    // The poisoned origins.
    let mut poisoned_origins = ChunkSeq::new[u64]();
    let mut res = ChunkSeq::new[u64]();
    for i in 0..setup.view.region_kind.len() {
        if g8(in setup.view.region_kind, i) != BODY {
            continue;
        }
        let fn_index = region_function(in walker, in setup.view, i);
        if fn_index == NONE64 {
            continue;
        }
        res.clear();
        live(inout res, in walker, fn_index, g64(in setup.view.region_cut, i));
        for j in 0..res.len() {
            poisoned_origins.push(g64(in res, j));
        }
    }
    let mut hints = ChunkSeq::new[u8]();
    let mut hint_count: u64 = 0;
    for fn_index in 0..walker.fn_start.len() {
        let first = w(g32(in walker.fn_binding_start, fn_index));
        for j in 0..w(g32(in walker.fn_binding_count, fn_index)) {
            let binding = wrapping_add(first, j);
            if g8(in walker.binding_linear, binding) == 0
                || g8(in walker.binding_owned, binding) == 0
            {
                continue;
            }
            let origin_start = g64(in walker.binding_origin_start, binding);
            let origin_end = g64(in walker.binding_origin_end, binding);
            if origin_start < start || origin_end > end {
                continue;
            }
            let mut poisoned = false;
            for poison_index in 0..poisoned_origins.len() {
                if same_origin(in walker, g64(in poisoned_origins, poison_index), binding) {
                    poisoned = true;
                    break;
                }
            }
            let hint_pos = match rq_position(in doc, origin_end) {
                Result::Ok(poison_index) => poison_index,
                Result::Err(_) => {
                    put(
                        inout out,
                        in "{\"error\":{\"code\":-32603,\"data\":null,\"message\":\"binding span is invalid\"}}\n"
                    );
                    return;
                }
            };
            if hint_count > 0 {
                hints.push(44);
            }
            hint_count = inc(hint_count);
            put(inout hints, in "{\"data\":{\"vesper\":{\"binding\":");
            put_json_name(inout hints, in setup.ast, g32(in walker.binding_name, binding));
            put(inout hints, in ",\"scope\":\"");
            put_scope(inout hints, in setup.view);
            put(inout hints, in "\",\"type\":");
            put_json_type(inout hints, in setup.ctx, g32(in walker.binding_ty, binding));
            put(inout hints, in "}},\"label\":\"linear: ");
            if poisoned {
                put(inout hints, in "poisoned by unfinished code");
            } else {
                let cons = first_consumption_after(in walker, binding, origin_end);
                if cons != NONE64 {
                    put(inout hints, in "consumed on line ");
                    put_u64(inout hints, line_of(in doc, cons));
                } else {
                    put(inout hints, in "outstanding");
                }
            }
            put(inout hints, in "\",\"paddingLeft\":true,\"position\":");
            put_position(inout hints, hint_pos);
            hints.push(125);
            if hint_count >= 512 {
                break;
            }
        }
        if hint_count >= 512 {
            break;
        }
    }
    out.push(91);
    put_bytes(inout out, in hints.as_slice());
    put(inout out, in "]\n");
}

// The harness input of the request layer: a view's input as for
// `lens_view` (status 5: a checked snapshot's view), then the ten
// index-limit words; the URI and document lengths; per region its name
// length, depth, declaration end and damage span; the completion and
// hover positions (count, then line and UTF-16 character each) and the
// inlay-hint ranges (count, then four words each); then the URI, the
// document text and the region names. The answers (`requests_dump`) are
// built `reps` times on one view.
pub fn lens_requests(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mut setup = view_setup(in bytes);
    let mut reader = Rd { pos: setup.end };
    let limits = Limits {
        max_source_bytes: narrow_usize(word(in bytes, inout reader)),
        max_lines: narrow_usize(word(in bytes, inout reader)),
        max_metadata_bytes: narrow_usize(word(in bytes, inout reader)),
        max_work: narrow_usize(word(in bytes, inout reader)),
        max_edits: narrow_usize(word(in bytes, inout reader)),
        max_output_bytes: narrow_usize(word(in bytes, inout reader)),
        max_diagnostics: narrow_usize(word(in bytes, inout reader)),
        max_labels: narrow_usize(word(in bytes, inout reader)),
        max_fixes: narrow_usize(word(in bytes, inout reader)),
        max_text_bytes: narrow_usize(word(in bytes, inout reader))
    };
    let uri_len = word(in bytes, inout reader);
    let doc_len = word(in bytes, inout reader);
    let mut region_name_len = ChunkSeq::new[u64]();
    let mut region_depth = ChunkSeq::new[u64]();
    let mut region_decl_end = ChunkSeq::new[u64]();
    let mut region_damage_start = ChunkSeq::new[u64]();
    let mut region_damage_end = ChunkSeq::new[u64]();
    for i in 0..setup.view.region_kind.len() {
        region_name_len.push(word(in bytes, inout reader));
        region_depth.push(word(in bytes, inout reader));
        region_decl_end.push(word(in bytes, inout reader));
        region_damage_start.push(word(in bytes, inout reader));
        region_damage_end.push(word(in bytes, inout reader));
    }
    let mut completions = ChunkSeq::new[u64]();
    let completion_count = word(in bytes, inout reader);
    for i in 0..wrapping_mul(completion_count, 2) {
        completions.push(word(in bytes, inout reader));
    }
    let mut hovers = ChunkSeq::new[u64]();
    let hover_count = word(in bytes, inout reader);
    for i in 0..wrapping_mul(hover_count, 2) {
        hovers.push(word(in bytes, inout reader));
    }
    let mut inlay_ranges = ChunkSeq::new[u64]();
    let inlay_count = word(in bytes, inout reader);
    for i in 0..wrapping_mul(inlay_count, 4) {
        inlay_ranges.push(word(in bytes, inout reader));
    }
    let uri_at = reader.pos;
    let doc_at = wrapping_add(uri_at, uri_len);
    let text = match String::from_utf8(in bytes[doc_at..wrapping_add(doc_at, doc_len)]) {
        Option::Some(x) => x,
        Option::None => String::new(),
    };
    let mut region_name_at = ChunkSeq::new[u64]();
    let mut at = wrapping_add(doc_at, doc_len);
    for i in 0..region_name_len.len() {
        region_name_at.push(at);
        at = wrapping_add(at, g64(in region_name_len, i));
    }
    let mut out = ChunkSeq::new[u8]();
    let lines = match rq_lines(in text, in limits) {
        Result::Ok(x) => x,
        Result::Err(e) => {
            put(inout out, in "E\t");
            put_span_error(inout out, e);
            out.push(10);
            return pack(in out.as_slice());
        }
    };
    let doc = Doc {
        text: text,
        lines: lines,
        max_work: limits.max_work,
        uri_at: uri_at,
        uri_len: uri_len,
        region_name_at: region_name_at,
        region_name_len: region_name_len,
        region_depth: region_depth,
        region_decl_end: region_decl_end,
        region_damage_start: region_damage_start,
        region_damage_end: region_damage_end
    };
    let mut walker = ow_new();
    setup_facts(inout walker, inout setup);
    for round in 0..setup.reps {
        out.clear();
        poison(inout out, in walker, in setup.view, in setup.ctx, in setup.ast, in bytes, in doc);
        for i in 0..completion_count {
            let pos = Position {
                line: wrapping_u32(g64(in completions, wrapping_mul(i, 2))),
                character: wrapping_u32(g64(in completions, inc(wrapping_mul(i, 2))))
            };
            completion(inout out, in setup, in walker, in bytes, in doc, pos);
        }
        for i in 0..hover_count {
            let pos = Position {
                line: wrapping_u32(g64(in hovers, wrapping_mul(i, 2))),
                character: wrapping_u32(g64(in hovers, inc(wrapping_mul(i, 2))))
            };
            hover(inout out, in setup, in walker, in bytes, in doc, pos);
        }
        for i in 0..inlay_count {
            let word_at = wrapping_mul(i, 4);
            let range_start = Position {
                line: wrapping_u32(g64(in inlay_ranges, word_at)),
                character: wrapping_u32(g64(in inlay_ranges, inc(word_at)))
            };
            let range_end = Position {
                line: wrapping_u32(g64(in inlay_ranges, wrapping_add(word_at, 2))),
                character: wrapping_u32(g64(in inlay_ranges, wrapping_add(word_at, 3)))
            };
            inlays(inout out, in setup, in walker, in bytes, in doc, range_start, range_end);
        }
    }
    pack(in out.as_slice())
}
