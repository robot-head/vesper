// The Markdown half of `vesper_doc::links::analyze`
// (crates/vesper-doc/src/links.rs): code spans, link brackets and titles
// over the joined doc-comment lines, charged against links.ves's budget.

use @vesper/front::lex::{lex_with_limits, token_end};
use @vesper/front::diag::{diags_new};
use self::json::{byte};
use self::nav::{Ix, MAX_SOURCE_BYTES, u32_at, u8_at, w};
use self::links::{
    L_MAX_METADATA, L_MAX_REFERENCES, Link, NOT_FOUND, SIZE_DIAGNOSTIC, SIZE_LINE, SIZE_REFERENCE,
    SIZE_TOKEN, TK_COMMENT, TK_WHITESPACE, check_path, has_self_segment, link_fail, link_inventory,
    lmeta, local_path, lpush, lwork, u64_at
};

fn line_len(in link: Link, i: u64) -> u64 {
    u64_at(in link.line_len, i)
}

// Byte `at` of comment line `i` (0 past its end).
fn lb(in link: Link, in bytes: Slice[u8], i: u64, at: u64) -> u8 {
    if at >= line_len(in link, i) {
        return 0;
    }
    byte(in bytes, wrapping_add(u64_at(in link.line_start, i), at))
}

fn ascii_space(c: u8) -> bool {
    c == 32 || c == 9 || c == 10 || c == 12 || c == 13
}

// `run`: how many `c` bytes start at `at` of line `i`.
fn run(inout link: Link, in bytes: Slice[u8], i: u64, at: u64, c: u8, inout n: u64) -> bool {
    n = 0;
    loop {
        if wrapping_add(at, n) >= line_len(in link, i)
            || lb(in link, in bytes, i, wrapping_add(at, n)) != c {
            return true;
        }
        if !lwork(inout link, 1) {
            return false;
        }
        n = wrapping_add(n, 1);
    }
}

// Whether `bytes[s..e]` is empty after `str::trim` (Unicode White_Space).
fn blank(in bytes: Slice[u8], s: u64, e: u64) -> bool {
    let mut i = s;
    loop {
        if i >= e {
            return true;
        }
        let first = byte(in bytes, i);
        if first == 32 || (first >= 9 && first <= 13) {
            i = wrapping_add(i, 1);
        } else if first == 194 && wrapping_add(i, 1) < e {
            let second = byte(in bytes, wrapping_add(i, 1));
            if second == 133 || second == 160 {
                i = wrapping_add(i, 2);
            } else {
                return false;
            }
        } else if first == 225 && wrapping_add(i, 2) < e {
            if byte(in bytes, wrapping_add(i, 1)) == 154
                && byte(in bytes, wrapping_add(i, 2)) == 128 {
                i = wrapping_add(i, 3);
            } else {
                return false;
            }
        } else if first == 226 && wrapping_add(i, 2) < e {
            let second = byte(in bytes, wrapping_add(i, 1));
            let third = byte(in bytes, wrapping_add(i, 2));
            let space = (
                second == 128
                    && (
                        (third >= 128 && third <= 138)
                            || third == 168
                            || third == 169
                            || third == 175
                    )
            )
                || (second == 129 && third == 159);
            if space {
                i = wrapping_add(i, 3);
            } else {
                return false;
            }
        } else if first == 227 && wrapping_add(i, 2) < e {
            if byte(in bytes, wrapping_add(i, 1)) == 128
                && byte(in bytes, wrapping_add(i, 2)) == 128 {
                i = wrapping_add(i, 3);
            } else {
                return false;
            }
        } else {
            return false;
        }
    }
}

// Line `i` from byte `at` to its end is blank.
fn rest_blank(in link: Link, in bytes: Slice[u8], i: u64, at: u64) -> bool {
    let start = u64_at(in link.line_start, i);
    let len = line_len(in link, i);
    if at >= len {
        return true;
    }
    blank(in bytes, wrapping_add(start, at), wrapping_add(start, len))
}

// The ' '/'\t' indentation of line `i`.
fn indent(in link: Link, in bytes: Slice[u8], i: u64) -> u64 {
    let mut n: u64 = 0;
    loop {
        if n >= line_len(in link, i) {
            return n;
        }
        let ch = lb(in link, in bytes, i, n);
        if ch != 32 && ch != 9 {
            return n;
        }
        n = wrapping_add(n, 1);
    }
}

fn pack2(line: u64, at: u64) -> u64 {
    wrapping_shl_u64(line, 32) | at
}

fn line_of(packed: u64) -> u64 {
    wrapping_shr_u64(packed, 32)
}

fn at_of(packed: u64) -> u64 {
    packed & 4294967295
}

// `close_ticks`: the end of the run of `count` backticks closing the one
// at line `line`, byte `at`; NOT_FOUND when unclosed.
fn close_ticks(
    inout link: Link,
    in bytes: Slice[u8],
    line: u64,
    at: u64,
    count: u64,
    inout out: u64
) -> bool {
    out = NOT_FOUND;
    let n = link.line_start.len();
    for i in line..n {
        let len = line_len(in link, i);
        let mut pos = if i == line {
            wrapping_add(at, count)
        } else {
            0
        };
        loop {
            if pos >= len {
                break;
            }
            if !lwork(inout link, 1) {
                return false;
            }
            if lb(in link, in bytes, i, pos) == 96 {
                let mut tick_count: u64 = 0;
                if !run(inout link, in bytes, i, pos, 96, inout tick_count) {
                    return false;
                }
                if !lwork(inout link, tick_count) {
                    return false;
                }
                if tick_count == count {
                    out = pack2(i, wrapping_add(pos, tick_count));
                    return true;
                }
                pos = wrapping_add(pos, tick_count);
            } else {
                pos = wrapping_add(pos, 1);
            }
        }
    }
    true
}

// `balanced_end`: the line and byte after the `close` matching the `open`
// at line `line`, byte `start`; NOT_FOUND when unbalanced.
fn balanced_end(
    inout link: Link,
    in bytes: Slice[u8],
    line: u64,
    start: u64,
    open: u8,
    close: u8,
    inout out: u64
) -> bool {
    out = NOT_FOUND;
    let mut depth: u64 = 1;
    let mut quoting: u8 = 0;
    let mut angle = false;
    let mut started = false;
    let mut separated = false;
    let mut index = line;
    let mut at = wrapping_add(start, 1);
    let n = link.line_start.len();
    loop {
        if index >= n {
            return true;
        }
        let len = line_len(in link, index);
        if at >= len {
            if open == 40 && started && depth == 1 && quoting == 0 && !angle {
                separated = true;
            }
            index = wrapping_add(index, 1);
            at = 0;
            continue;
        }
        if !lwork(inout link, 1) {
            return false;
        }
        let ch = lb(in link, in bytes, index, at);
        if ch == 92 {
            at = wrapping_add(at, 2);
            if at > len {
                at = len;
            }
            continue;
        }
        if open == 91 && ch == 96 {
            let mut tick_count: u64 = 0;
            if !run(inout link, in bytes, index, at, 96, inout tick_count) {
                return false;
            }
            if !lwork(inout link, tick_count) {
                return false;
            }
            let mut end: u64 = 0;
            if !close_ticks(inout link, in bytes, index, at, tick_count, inout end) {
                return false;
            }
            if end != NOT_FOUND {
                index = line_of(end);
                at = at_of(end);
            } else {
                at = wrapping_add(at, tick_count);
            }
            continue;
        }
        if open == 40 {
            if quoting != 0 {
                if ch == quoting {
                    quoting = 0;
                }
                at = wrapping_add(at, 1);
                continue;
            }
            if angle {
                if ch == 62 {
                    angle = false;
                }
                at = wrapping_add(at, 1);
                continue;
            }
            if !started && ascii_space(ch) {
                at = wrapping_add(at, 1);
                continue;
            }
            if !started {
                started = true;
                if ch == 60 {
                    angle = true;
                    at = wrapping_add(at, 1);
                    continue;
                }
            } else if depth == 1 && ascii_space(ch) {
                separated = true;
            }
            if separated && depth == 1 && (ch == 39 || ch == 34) {
                quoting = ch;
                at = wrapping_add(at, 1);
                continue;
            }
        }
        if ch == open {
            depth = wrapping_add(depth, 1);
        } else if ch == close {
            depth = wrapping_sub(depth, 1);
            if depth == 0 {
                out = pack2(index, wrapping_add(at, 1));
                return true;
            }
        }
        at = wrapping_add(at, 1);
    }
}

// `next_markdown`: the first byte that is not ' ', '\t' or '\r' from
// line `line`, byte `start`, on that line or the next; NOT_FOUND.
fn next_markdown(
    inout link: Link,
    in bytes: Slice[u8],
    line: u64,
    start: u64,
    inout out: u64
) -> bool {
    out = NOT_FOUND;
    let n = link.line_start.len();
    let mut last = wrapping_add(line, 2);
    if last > n {
        last = n;
    }
    for i in line..last {
        let len = line_len(in link, i);
        let mut at = if i == line { start } else { 0 };
        loop {
            if at >= len {
                break;
            }
            let ch = lb(in link, in bytes, i, at);
            if ch != 32 && ch != 9 && ch != 13 {
                break;
            }
            if !lwork(inout link, 1) {
                return false;
            }
            at = wrapping_add(at, 1);
        }
        if at < len {
            out = pack2(i, at);
            return true;
        }
    }
    true
}

// `continued_definition_title`: the line after a reference definition's
// title that starts on line `line`, or NOT_FOUND.
fn continued_title(inout link: Link, in bytes: Slice[u8], line: u64, inout out: u64) -> bool {
    out = NOT_FOUND;
    let n = link.line_start.len();
    if line >= n {
        return true;
    }
    let indent_width = indent(in link, in bytes, line);
    if !lwork(inout link, wrapping_add(indent_width, 1)) {
        return false;
    }
    if indent_width >= line_len(in link, line) {
        return true;
    }
    let open = lb(in link, in bytes, line, indent_width);
    if open != 39 && open != 34 && open != 40 {
        return true;
    }
    let close = if open == 40 { 41 } else { open };
    let mut at = wrapping_add(indent_width, 1);
    let mut depth: u64 = 1;
    for i in line..n {
        if i != line {
            at = 0;
        }
        let len = line_len(in link, i);
        if rest_blank(in link, in bytes, i, 0) {
            return true;
        }
        loop {
            if at >= len {
                break;
            }
            if !lwork(inout link, 1) {
                return false;
            }
            let ch = lb(in link, in bytes, i, at);
            if ch == 92 {
                at = wrapping_add(at, 2);
                if at > len {
                    at = len;
                }
                continue;
            }
            if open == 40 && ch == open {
                depth = wrapping_add(depth, 1);
            }
            if ch == close {
                depth = wrapping_sub(depth, 1);
                if depth == 0 {
                    if !lwork(inout link, wrapping_sub(len, at)) {
                        return false;
                    }
                    if rest_blank(in link, in bytes, i, wrapping_add(at, 1)) {
                        out = wrapping_add(i, 1);
                    }
                    return true;
                }
            }
            at = wrapping_add(at, 1);
        }
    }
    true
}

// `occurrence` of the link text `bytes[s..e]` spanning source bytes
// `span_s..span_e`.
fn occurrence(
    inout link: Link,
    in bytes: Slice[u8],
    s: u64,
    e: u64,
    span_s: u64,
    span_e: u64
) -> bool {
    // `path`: strip one pair of backticks.
    let mut path_start = s;
    let mut path_end = e;
    if wrapping_sub(e, s) >= 2
        && byte(in bytes, s) == 96
        && byte(in bytes, wrapping_sub(e, 1)) == 96 {
        path_start = wrapping_add(s, 1);
        path_end = wrapping_sub(e, 1);
    } else if wrapping_sub(e, s) == 1 && byte(in bytes, s) == 96 {
        // "`" strips to "" from the front and has no suffix left: as-is.
    }
    // 1 local, 2 unsupported.
    let mut kind: u64 = 0;
    if local_path(in bytes, path_start, path_end) {
        if !check_path(inout link, in bytes, path_start, path_end) {
            return false;
        }
        kind = if has_self_segment(in bytes, path_start, path_end) {
            2
        } else {
            1
        };
    } else {
        let mut bracket = NOT_FOUND;
        for i in path_start..path_end {
            if byte(in bytes, i) == 91 {
                bracket = i;
                break;
            }
        }
        if (path_end > path_start && byte(in bytes, path_start) == 64)
            || (bracket != NOT_FOUND && local_path(in bytes, path_start, bracket)) {
            if !check_path(inout link, in bytes, path_start, path_end) {
                return false;
            }
            kind = 2;
        }
    }
    if kind == 0 {
        return true;
    }
    if wrapping_add(link.ref_start.len(), link.diagnostics) >= L_MAX_REFERENCES {
        return link_fail(inout link, 1);
    }
    let mut found = NOT_FOUND;
    let mut matches: u64 = 0;
    if kind == 1 {
        let path_len = wrapping_sub(path_end, path_start);
        for i in 0..link.path_at.len() {
            let target_len = u64_at(in link.path_len, i);
            if !lwork(inout link, wrapping_add(wrapping_add(path_len, target_len), 1)) {
                return false;
            }
            if target_len == path_len {
                let target_at = u64_at(in link.path_at, i);
                let mut same = true;
                for j in 0..path_len {
                    if u8_at(in link.paths, wrapping_add(target_at, j))
                        != byte(in bytes, wrapping_add(path_start, j)) {
                        same = false;
                        break;
                    }
                }
                if same {
                    found = i;
                    matches = wrapping_add(matches, 1);
                }
            }
        }
    }
    if matches == 1 {
        let target_len = u64_at(in link.path_len, found);
        // `copy_target`, `anchor`, the display string, then the push.
        if !lmeta(inout link, target_len) {
            return false;
        }
        if !lmeta(inout link, wrapping_mul(wrapping_add(32, wrapping_mul(target_len, 2)), 4)) {
            return false;
        }
        if !lmeta(inout link, wrapping_sub(e, s)) {
            return false;
        }
        let cap = lpush(inout link, link.ref_start.len(), link.ref_cap, SIZE_REFERENCE);
        if cap == NOT_FOUND {
            return false;
        }
        link.ref_cap = cap;
        link.ref_start.push(span_s);
        link.ref_end.push(span_e);
        link.ref_target.push(found);
        return true;
    }
    let (code, message) = if kind == 2 {
        (11, 37)
    } else if matches == 0 {
        (7, 33)
    } else {
        (9, 35)
    };
    if !lmeta(inout link, code) || !lmeta(inout link, message) {
        return false;
    }
    let cap = lpush(inout link, link.diagnostics, link.diag_cap, SIZE_DIAGNOSTIC);
    if cap == NOT_FOUND {
        return false;
    }
    link.diag_cap = cap;
    link.diagnostics = wrapping_add(link.diagnostics, 1);
    true
}

// `group`: the links of one run of comment lines.
fn group(inout link: Link, in bytes: Slice[u8]) -> bool {
    let n = link.line_start.len();
    let mut line: u64 = 0;
    let mut at: u64 = 0;
    let mut fence: u8 = 0;
    let mut fence_count: u64 = 0;
    loop {
        if line >= n {
            return true;
        }
        let len = line_len(in link, line);
        if at == 0 {
            let indent_width = indent(in link, in bytes, line);
            if !lwork(inout link, wrapping_add(indent_width, 1)) {
                return false;
            }
            let first: u8 = if indent_width < len {
                lb(in link, in bytes, line, indent_width)
            } else {
                0
            };
            if fence != 0 {
                if indent_width < len && first == fence {
                    let mut run_len: u64 = 0;
                    if !run(inout link, in bytes, line, indent_width, fence, inout run_len) {
                        return false;
                    }
                    if !lwork(
                        inout link,
                        wrapping_add(
                            run_len,
                            wrapping_sub(wrapping_sub(len, indent_width), run_len)
                        )
                    ) {
                        return false;
                    }
                    if run_len >= fence_count
                        && rest_blank(
                            in link,
                            in bytes,
                            line,
                            wrapping_add(indent_width, run_len)
                        ) {
                        fence = 0;
                    }
                }
                line = wrapping_add(line, 1);
                continue;
            }
            if indent_width < len && (first == 96 || first == 126) {
                let mut run_len: u64 = 0;
                if !run(inout link, in bytes, line, indent_width, first, inout run_len) {
                    return false;
                }
                if !lwork(inout link, run_len) {
                    return false;
                }
                if run_len >= 3 {
                    fence = first;
                    fence_count = run_len;
                    line = wrapping_add(line, 1);
                    continue;
                }
            }
        }
        if at >= len {
            line = wrapping_add(line, 1);
            at = 0;
            continue;
        }
        if !lwork(inout link, 1) {
            return false;
        }
        let ch = lb(in link, in bytes, line, at);
        if ch == 92 {
            at = wrapping_add(at, 2);
            if at > len {
                at = len;
            }
        } else if ch == 96 {
            let mut run_len: u64 = 0;
            if !run(inout link, in bytes, line, at, 96, inout run_len) {
                return false;
            }
            if !lwork(inout link, run_len) {
                return false;
            }
            let mut end: u64 = 0;
            if !close_ticks(inout link, in bytes, line, at, run_len, inout end) {
                return false;
            }
            if end != NOT_FOUND {
                line = line_of(end);
                at = at_of(end);
            } else {
                at = wrapping_add(at, run_len);
            }
        } else if ch == 91
            || (
                ch == 33
                    && wrapping_add(at, 1) < len
                    && lb(in link, in bytes, line, wrapping_add(at, 1)) == 91
            ) {
            let image = ch == 33;
            let start = if image { wrapping_add(at, 1) } else { at };
            let mut close: u64 = 0;
            if !balanced_end(inout link, in bytes, line, start, 91, 93, inout close) {
                return false;
            }
            if close == NOT_FOUND {
                line = n;
                continue;
            }
            let end_line = line_of(close);
            let end = at_of(close);
            let mut next: u64 = 0;
            if !next_markdown(inout link, in bytes, end_line, end, inout next) {
                return false;
            }
            let next_c = if next == NOT_FOUND {
                0
            } else {
                lb(in link, in bytes, line_of(next), at_of(next))
            };
            if next != NOT_FOUND && next_c == 40 {
                let mut link_end: u64 = 0;
                if !balanced_end(
                    inout link,
                    in bytes,
                    line_of(next),
                    at_of(next),
                    40,
                    41,
                    inout link_end
                ) {
                    return false;
                }
                if link_end != NOT_FOUND {
                    line = line_of(link_end);
                    at = at_of(link_end);
                } else {
                    line = n;
                }
            } else if next != NOT_FOUND && next_c == 91 {
                let mut link_end: u64 = 0;
                if !balanced_end(
                    inout link,
                    in bytes,
                    line_of(next),
                    at_of(next),
                    91,
                    93,
                    inout link_end
                ) {
                    return false;
                }
                if link_end != NOT_FOUND {
                    line = line_of(link_end);
                    at = at_of(link_end);
                    let mut url: u64 = 0;
                    if !next_markdown(inout link, in bytes, line, at, inout url) {
                        return false;
                    }
                    if url != NOT_FOUND && lb(in link, in bytes, line_of(url), at_of(url)) == 40 {
                        let mut url_end: u64 = 0;
                        if !balanced_end(
                            inout link,
                            in bytes,
                            line_of(url),
                            at_of(url),
                            40,
                            41,
                            inout url_end
                        ) {
                            return false;
                        }
                        if url_end != NOT_FOUND {
                            line = line_of(url_end);
                            at = at_of(url_end);
                        } else {
                            line = n;
                        }
                    }
                } else {
                    line = n;
                }
            } else if next != NOT_FOUND && line_of(next) == end_line && next_c == 58 {
                let mut title: u64 = 0;
                if !continued_title(inout link, in bytes, wrapping_add(end_line, 1), inout title) {
                    return false;
                }
                line = if title == NOT_FOUND {
                    wrapping_add(end_line, 1)
                } else {
                    title
                };
                at = 0;
            } else {
                if !image && end_line == line {
                    let line_start = u64_at(in link.line_start, line);
                    if !occurrence(
                        inout link,
                        in bytes,
                        wrapping_add(line_start, wrapping_add(start, 1)),
                        wrapping_add(line_start, wrapping_sub(end, 1)),
                        wrapping_add(line_start, start),
                        wrapping_add(line_start, end)
                    ) {
                        return false;
                    }
                }
                line = end_line;
                at = end;
            }
        } else {
            at = wrapping_add(at, 1);
        }
    }
}

// `links::analyze` of the source of `index` with the inventory's targets.
pub fn analyze(
    inout link: Link,
    in index: Ix,
    in target_paths: ChunkSeq[u8],
    in target_at: ChunkSeq[u64],
    in target_len: ChunkSeq[u64],
    in target_kinds: ChunkSeq[u8]
) -> bool {
    let len = index.src.len();
    if len > MAX_SOURCE_BYTES {
        return link_fail(inout link, 1);
    }
    if !lwork(inout link, wrapping_mul(wrapping_add(len, 1), 8)) {
        return false;
    }
    if !link_inventory(inout link, in target_paths, in target_at, in target_len, in target_kinds) {
        return false;
    }
    let mut max_tokens = L_MAX_METADATA / 4 / SIZE_TOKEN;
    if wrapping_add(len, 1) < max_tokens {
        max_tokens = wrapping_add(len, 1);
    }
    if max_tokens == 0 {
        max_tokens = 1;
    }
    if !lmeta(
        inout link,
        wrapping_add(wrapping_mul(wrapping_add(max_tokens, 1), SIZE_TOKEN), 1024)
    ) {
        return false;
    }
    let mut diags = diags_new();
    let bytes = index.src.as_bytes();
    let tokens = lex_with_limits(in bytes, inout diags, MAX_SOURCE_BYTES, max_tokens, 1);
    if tokens.rejected || tokens.limited {
        return link_fail(inout link, 1);
    }
    if diags.code.len() != 0 {
        return link_fail(inout link, 3);
    }
    for i in 0..tokens.kind.len() {
        if !lwork(inout link, 1) {
            return false;
        }
        let start = w(u32_at(in tokens.start, i));
        let end = token_end(in tokens, i);
        let kind = u8_at(in tokens.kind, i);
        let token_len = wrapping_sub(end, start);
        let is_doc = kind == TK_COMMENT
            && token_len >= 3
            && byte(in bytes, start) == 47
            && byte(in bytes, wrapping_add(start, 1)) == 47
            && (
                byte(in bytes, wrapping_add(start, 2)) == 33
                    || (
                        byte(in bytes, wrapping_add(start, 2)) == 47
                            && !(token_len >= 4 && byte(in bytes, wrapping_add(start, 3)) == 47)
                    )
            );
        if is_doc {
            let mut from = wrapping_add(start, 3);
            if from < end && byte(in bytes, from) == 32 {
                from = wrapping_add(from, 1);
            }
            let cap = lpush(inout link, link.line_start.len(), link.line_cap, SIZE_LINE);
            if cap == NOT_FOUND {
                return false;
            }
            link.line_cap = cap;
            link.line_start.push(from);
            link.line_len.push(wrapping_sub(end, from));
        } else if kind == TK_WHITESPACE && newlines(in bytes, start, end) <= 1 {
            if !lwork(inout link, token_len) {
                return false;
            }
        } else {
            if !group(inout link, in bytes) {
                return false;
            }
            link.line_start.clear();
            link.line_len.clear();
        }
    }
    group(inout link, in bytes)
}

fn newlines(in bytes: Slice[u8], s: u64, e: u64) -> u64 {
    let mut n: u64 = 0;
    for i in s..e {
        if byte(in bytes, i) == 10 {
            n = wrapping_add(n, 1);
        }
    }
    n
}
