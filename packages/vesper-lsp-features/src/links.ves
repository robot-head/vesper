// `vesper_doc::links::analyze` (crates/vesper-doc/src/links.rs) in Vesper:
// the local intra-doc references of the `///` and `//!` comments of a
// source, against the declaration inventory doc_links.ves collects. The
// link budget counts up, charge for charge with the Rust one, with the Rust
// `size_of` of each value it counts.

use @vesper/front::lex::{lex_with_limits, token_end};
use @vesper/front::diag::{diags_new};
use self::json::{byte};
use self::nav::{Ix, MAX_SOURCE_BYTES, u32_at, u8_at, w};

pub const NOT_FOUND: u64 = 18446744073709551615;

pub const SIZE_LINK_TARGET: u64 = 32;
pub const SIZE_LINE: u64 = 24;
pub const SIZE_REFERENCE: u64 = 96;
pub const SIZE_DIAGNOSTIC: u64 = 64;
pub const SIZE_TOKEN: u64 = 24;

// `LinkLimits::default()` with doc_links.rs's overrides.
const L_MAX_TARGETS: u64 = 1024;
pub const L_MAX_REFERENCES: u64 = 1024;
const L_MAX_PATH_BYTES: u64 = 1024;
const L_MAX_PATH_SEGMENTS: u64 = 8;
pub const L_MAX_METADATA: u64 = 1048576;
const L_MAX_WORK: u64 = 16777216;

// `TargetKind`, in its `Ord` order.
const T_METHOD: u8 = 2;
const T_OPERATION: u8 = 4;

pub const TK_WHITESPACE: u8 = 0;
pub const TK_COMMENT: u8 = 1;

pub fn u64_at(in column: ChunkSeq[u64], i: u64) -> u64 {
    column.try_get(i).unwrap_or(0)
}

pub fn ident_start(c: u8) -> bool {
    (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
}

pub fn ident_byte(c: u8) -> bool {
    ident_start(c) || (c >= 48 && c <= 57)
}

pub fn link_new() -> Link {
    Link {
        work: 0,
        metadata: 0,
        err: 0,
        paths: ChunkSeq::new[u8](),
        path_at: ChunkSeq::new[u64](),
        path_len: ChunkSeq::new[u64](),
        target_kind: ChunkSeq::new[u8](),
        ref_start: ChunkSeq::new[u64](),
        ref_end: ChunkSeq::new[u64](),
        ref_target: ChunkSeq::new[u64](),
        ref_cap: 0,
        diagnostics: 0,
        diag_cap: 0,
        line_start: ChunkSeq::new[u64](),
        line_len: ChunkSeq::new[u64](),
        line_cap: 0
    }
}

// ------------------------------------------------------------ analyze

// `vesper_doc::links` `Budget` (counts up) and the report the fallback
// reads: each reference's span and target, and how many diagnostics.
pub struct Link {
    work: u64,
    metadata: u64,
    // 0 none, 1 resource, 2 configuration, 3 another code.
    err: u64,
    // The sorted targets (`inventory`): path (offset, length) in `paths`.
    paths: ChunkSeq[u8],
    path_at: ChunkSeq[u64],
    path_len: ChunkSeq[u64],
    target_kind: ChunkSeq[u8],
    ref_start: ChunkSeq[u64],
    ref_end: ChunkSeq[u64],
    ref_target: ChunkSeq[u64],
    ref_cap: u64,
    diagnostics: u64,
    diag_cap: u64,
    // The comment lines of the current group: content start and length.
    line_start: ChunkSeq[u64],
    line_len: ChunkSeq[u64],
    line_cap: u64
}

pub fn link_fail(inout link: Link, code: u64) -> bool {
    if link.err == 0 {
        link.err = code;
    }
    false
}

pub fn lwork(inout link: Link, n: u64) -> bool {
    let next = wrapping_add(link.work, n);
    if next < link.work || next > L_MAX_WORK {
        return link_fail(inout link, 1);
    }
    link.work = next;
    true
}

pub fn lmeta(inout link: Link, n: u64) -> bool {
    let next = wrapping_add(link.metadata, n);
    if next < link.metadata || next > L_MAX_METADATA {
        return link_fail(inout link, 1);
    }
    link.metadata = next;
    lwork(inout link, n)
}

// `Budget::push` onto a vector of `len` values of `size` with capacity
// `cap` (grown by exactly one); returns the new capacity or NOT_FOUND.
pub fn lpush(inout link: Link, len: u64, cap: u64, size: u64) -> u64 {
    if !lmeta(inout link, size) {
        return NOT_FOUND;
    }
    if len == cap {
        if !lwork(inout link, wrapping_mul(len, size)) {
            return NOT_FOUND;
        }
        return wrapping_add(cap, 1);
    }
    cap
}

// The `::` segments of `bytes[s..e]` (`split("::").count()`).
fn segments(in bytes: Slice[u8], s: u64, e: u64) -> u64 {
    let mut n: u64 = 1;
    let mut i = s;
    loop {
        if wrapping_add(i, 1) >= e {
            break;
        }
        if byte(in bytes, i) == 58 && byte(in bytes, wrapping_add(i, 1)) == 58 {
            n = wrapping_add(n, 1);
            i = wrapping_add(i, 2);
        } else {
            i = wrapping_add(i, 1);
        }
    }
    n
}

// `local_path`: nonempty, and every `::` segment an identifier.
pub fn local_path(in bytes: Slice[u8], s: u64, e: u64) -> bool {
    if s >= e {
        return false;
    }
    let mut seg = s;
    let mut i = s;
    loop {
        if i >= e {
            break;
        }
        if wrapping_add(i, 1) < e
            && byte(in bytes, i) == 58
            && byte(in bytes, wrapping_add(i, 1)) == 58
        {
            if !ident_range(in bytes, seg, i) {
                return false;
            }
            i = wrapping_add(i, 2);
            seg = i;
        } else {
            i = wrapping_add(i, 1);
        }
    }
    ident_range(in bytes, seg, e)
}

fn ident_range(in bytes: Slice[u8], s: u64, e: u64) -> bool {
    if s >= e || !ident_start(byte(in bytes, s)) {
        return false;
    }
    for i in wrapping_add(s, 1)..e {
        if !ident_byte(byte(in bytes, i)) {
            return false;
        }
    }
    true
}

// Whether a `::` segment of `bytes[s..e]` is `Self`.
pub fn has_self_segment(in bytes: Slice[u8], s: u64, e: u64) -> bool {
    let mut seg = s;
    let mut i = s;
    loop {
        let at_sep = wrapping_add(i, 1) < e
            && byte(in bytes, i) == 58
            && byte(in bytes, wrapping_add(i, 1)) == 58;
        if i >= e || at_sep {
            if wrapping_sub(i, seg) == 4
                && byte(in bytes, seg) == 83
                && byte(in bytes, wrapping_add(seg, 1)) == 101
                && byte(in bytes, wrapping_add(seg, 2)) == 108
                && byte(in bytes, wrapping_add(seg, 3)) == 102
            {
                return true;
            }
            if i >= e {
                return false;
            }
            i = wrapping_add(i, 2);
            seg = i;
        } else {
            i = wrapping_add(i, 1);
        }
    }
}

pub fn check_path(inout link: Link, in bytes: Slice[u8], s: u64, e: u64) -> bool {
    if wrapping_sub(e, s) > L_MAX_PATH_BYTES || segments(in bytes, s, e) > L_MAX_PATH_SEGMENTS {
        return link_fail(inout link, 1);
    }
    true
}

// `inventory`: validates the targets, copies them, and sorts them.
pub fn link_inventory(
    inout link: Link,
    in target_paths: ChunkSeq[u8],
    in target_at: ChunkSeq[u64],
    in target_len: ChunkSeq[u64],
    in target_kinds: ChunkSeq[u8]
) -> bool {
    let n = target_at.len();
    if n > L_MAX_TARGETS {
        return link_fail(inout link, 1);
    }
    let path_bytes = target_paths.as_slice();
    let mut cap: u64 = 0;
    let mut longest: u64 = 0;
    for i in 0..n {
        let start = u64_at(in target_at, i);
        let len = u64_at(in target_len, i);
        if len > longest {
            longest = len;
        }
        let end = wrapping_add(start, len);
        if !lwork(inout link, wrapping_add(len, 1)) {
            return false;
        }
        // `target_valid`.
        if !check_path(inout link, in path_bytes, start, end) {
            return false;
        }
        let kind = u8_at(in target_kinds, i);
        let required: u64 = if kind == T_METHOD || kind == T_OPERATION {
            2
        } else {
            1
        };
        if !local_path(in path_bytes, start, end)
            || segments(in path_bytes, start, end) != required
            || has_self_segment(in path_bytes, start, end)
        {
            return link_fail(inout link, 3);
        }
        for j in 0..i {
            let other_start = u64_at(in target_at, j);
            let other_len = u64_at(in target_len, j);
            if !lwork(inout link, wrapping_add(wrapping_add(len, other_len), 1)) {
                return false;
            }
            if other_len == len
                && u8_at(in target_kinds, j) == kind
                && same_bytes(in path_bytes, start, other_start, len)
            {
                return link_fail(inout link, 3);
            }
        }
        // `copy_target`, then `Budget::push`.
        if !lmeta(inout link, len) {
            return false;
        }
        cap = lpush(inout link, i, cap, SIZE_LINK_TARGET);
        if cap == NOT_FOUND {
            return false;
        }
    }
    if !lwork(inout link, wrapping_mul(wrapping_mul(n, n), wrapping_add(longest, 1))) {
        return false;
    }
    // Sort (path bytes, then kind): an insertion sort of the indices.
    let mut order = ChunkSeq::new[u64]();
    for i in 0..n {
        let mut at = order.len();
        order.push(i);
        loop {
            if at == 0 {
                break;
            }
            let prev = u64_at(in order, wrapping_sub(at, 1));
            if !target_less(
                in target_paths,
                in target_at,
                in target_len,
                in target_kinds,
                i,
                prev
            ) {
                break;
            }
            let ok = order.try_set(at, prev);
            at = wrapping_sub(at, 1);
        }
        let ok = order.try_set(at, i);
    }
    for i in 0..n {
        let j = u64_at(in order, i);
        link.path_at.push(link.paths.len());
        link.path_len.push(u64_at(in target_len, j));
        let start = u64_at(in target_at, j);
        link.paths.extend(in path_bytes[start..wrapping_add(start, u64_at(in target_len, j))]);
        link.target_kind.push(u8_at(in target_kinds, j));
    }
    true
}

fn same_bytes(in bytes: Slice[u8], lhs_at: u64, rhs_at: u64, n: u64) -> bool {
    for i in 0..n {
        if byte(in bytes, wrapping_add(lhs_at, i)) != byte(in bytes, wrapping_add(rhs_at, i)) {
            return false;
        }
    }
    true
}

fn target_less(
    in target_paths: ChunkSeq[u8],
    in target_at: ChunkSeq[u64],
    in target_len: ChunkSeq[u64],
    in target_kinds: ChunkSeq[u8],
    lhs: u64,
    rhs: u64
) -> bool {
    let path_bytes = target_paths.as_slice();
    let (lhs_start, lhs_len) = (u64_at(in target_at, lhs), u64_at(in target_len, lhs));
    let (rhs_start, rhs_len) = (u64_at(in target_at, rhs), u64_at(in target_len, rhs));
    let common_len = if lhs_len < rhs_len { lhs_len } else { rhs_len };
    for i in 0..common_len {
        let lhs_byte = byte(in path_bytes, wrapping_add(lhs_start, i));
        let rhs_byte = byte(in path_bytes, wrapping_add(rhs_start, i));
        if lhs_byte != rhs_byte {
            return lhs_byte < rhs_byte;
        }
    }
    if lhs_len != rhs_len {
        return lhs_len < rhs_len;
    }
    u8_at(in target_kinds, lhs) < u8_at(in target_kinds, rhs)
}

