// The Lens session's request bookkeeping (crates/vesper-lsp/src/lens.rs
// `Debouncer`, `PendingRequests`, `CancelToken`) in Vesper: the per-document
// debounce of background proof runs and the table of requests that have
// not been answered yet.
//
// Tokens are numbered in creation order (a fresh token, or the one a
// request gets when it begins) and only ever go from live to cancelled.
// Times are nanoseconds from the caller's clock origin.

use self::json::{pack, put_u64};

const NONE: u64 = 18446744073709551615;
const MINUTE: u64 = 60000000000;
// `Debouncer::new` and `PendingRequests::new` table bounds.
const MAX_DEBOUNCE_ENTRIES: u64 = 4096;
const MAX_PENDING: u64 = 1024;
// Bytes per input word.
const WORD_BYTES: u64 = 8;

// Row bytes: query answers and token flags (`0` false or live, `1` true
// or cancelled), the ignored timer action, a done op, an op on a table
// not created yet, and the separators.
const B_FALSE: u8 = 48;
const B_TRUE: u8 = 49;
const B_IGNORE: u8 = 73;
const B_DONE: u8 = 46;
const B_NO_TABLE: u8 = 45;
const B_MINUS: u8 = 45;
const B_LEN_END: u8 = 58;
const B_COMMA: u8 = 44;
const B_NEWLINE: u8 = 10;

// Operation kinds (`lens_state_input` in tests/self_host_lsp_features.rs).
const D_NEW: u64 = 1;
const D_TOUCH: u64 = 2;
const D_TIMER: u64 = 3;
const D_STARTED: u64 = 4;
const D_IS_CURRENT: u64 = 5;
const D_FINISHED: u64 = 6;
const D_FORGET: u64 = 7;
const D_CANCEL_ALL: u64 = 8;
const D_LEN: u64 = 9;
const P_NEW: u64 = 10;
const P_BEGIN: u64 = 11;
const P_CANCEL: u64 = 12;
const P_FINISH: u64 = 13;
const P_IS_PENDING: u64 = 14;
const P_CANCEL_ALL: u64 = 15;
const P_LEN: u64 = 16;
const T_NEW: u64 = 17;
const T_CANCEL: u64 = 18;

copy struct Rd {
    pos: u64
}

fn word(in b: Slice[u8], inout r: Rd) -> u64 {
    let x = match b.try_read_u64_le(r.pos) {
        Option::Some(x) => x,
        Option::None => 0,
    };
    r.pos = wrapping_add(r.pos, WORD_BYTES);
    x
}

fn g64(in v: ChunkSeq[u64], i: u64) -> u64 {
    match v.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

fn bt(in b: Slice[u8], i: u64) -> u8 {
    match b.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

fn same(in b: Slice[u8], x: u64, y: u64, n: u64) -> bool {
    for i in 0..n {
        if bt(in b, wrapping_add(x, i)) != bt(in b, wrapping_add(y, i)) {
            return false;
        }
    }
    true
}

fn put(inout o: ChunkSeq[u8], in s: Str) {
    o.extend(in s.as_bytes());
}

fn put_bool(inout o: ChunkSeq[u8], v: bool) {
    if v {
        o.push(B_TRUE);
    } else {
        o.push(B_FALSE);
    }
}

// `CancelToken`s: one flag per token, `0` live or `1` cancelled.
fn cancel(inout tokens: ChunkSeq[u8], k: u64) {
    let _ = tokens.try_set(k, B_TRUE);
}

fn swap_out(inout v: ChunkSeq[u64], i: u64) {
    let last = wrapping_sub(v.len(), 1);
    let _ = v.try_set(i, g64(in v, last));
    v.truncate(last);
}

// `Debouncer`: one entry per tracked document, keyed by its URI.
struct Debouncer {
    delay: u64,
    max: u64,
    u_at: ChunkSeq[u64],
    u_len: ChunkSeq[u64],
    generation: ChunkSeq[u64],
    deadline: ChunkSeq[u64],
    armed: ChunkSeq[u64],
    fired: ChunkSeq[u64],
    // The running generation and its token, or NONE.
    run_gen: ChunkSeq[u64],
    run_tok: ChunkSeq[u64]
}

fn debouncer(delay: u64, max: u64) -> Debouncer {
    Debouncer {
        delay: delay,
        max: max,
        u_at: ChunkSeq::new[u64](),
        u_len: ChunkSeq::new[u64](),
        generation: ChunkSeq::new[u64](),
        deadline: ChunkSeq::new[u64](),
        armed: ChunkSeq::new[u64](),
        fired: ChunkSeq::new[u64](),
        run_gen: ChunkSeq::new[u64](),
        run_tok: ChunkSeq::new[u64]()
    }
}

fn entry(in d: Debouncer, in b: Slice[u8], at: u64, len: u64) -> u64 {
    for i in 0..d.u_at.len() {
        if g64(in d.u_len, i) == len && same(in b, g64(in d.u_at, i), at, len) {
            return i;
        }
    }
    NONE
}

fn remove(inout d: Debouncer, i: u64) {
    swap_out(inout d.u_at, i);
    swap_out(inout d.u_len, i);
    swap_out(inout d.generation, i);
    swap_out(inout d.deadline, i);
    swap_out(inout d.armed, i);
    swap_out(inout d.fired, i);
    swap_out(inout d.run_gen, i);
    swap_out(inout d.run_tok, i);
}

// A `TimerAction`: `A` and the delay, `I`, or `F` and the generation.
fn put_arm(inout o: ChunkSeq[u8], ns: u64) {
    put(inout o, in "A ");
    put_u64(inout o, ns);
}

fn put_fire(inout o: ChunkSeq[u8], generation: u64) {
    put(inout o, in "F ");
    put_u64(inout o, generation);
}

// `Debouncer::touch`: an edit at `now`.
fn touch(
    inout d: Debouncer,
    inout tokens: ChunkSeq[u8],
    inout o: ChunkSeq[u8],
    in b: Slice[u8],
    at: u64,
    len: u64,
    now: u64
) {
    let mut i = entry(in d, in b, at, len);
    if i == NONE {
        if d.u_at.len() >= d.max {
            o.push(B_IGNORE);
            return;
        }
        i = d.u_at.len();
        d.u_at.push(at);
        d.u_len.push(len);
        d.generation.push(0);
        d.deadline.push(now);
        d.armed.push(0);
        d.fired.push(0);
        d.run_gen.push(NONE);
        d.run_tok.push(NONE);
    }
    let _ = d.generation.try_set(i, wrapping_add(g64(in d.generation, i), 1));
    let _ = d.deadline.try_set(i, wrapping_add(now, d.delay));
    let _ = d.fired.try_set(i, 0);
    if g64(in d.run_gen, i) != NONE {
        cancel(inout tokens, g64(in d.run_tok, i));
        let _ = d.run_gen.try_set(i, NONE);
        let _ = d.run_tok.try_set(i, NONE);
    }
    if g64(in d.armed, i) == 1 {
        o.push(B_IGNORE);
    } else {
        let _ = d.armed.try_set(i, 1);
        put_arm(inout o, d.delay);
    }
}

// `Debouncer::timer`: the armed timer fired at `now`.
fn timer(inout d: Debouncer, inout o: ChunkSeq[u8], in b: Slice[u8], at: u64, len: u64, now: u64) {
    let i = entry(in d, in b, at, len);
    if i == NONE {
        o.push(B_IGNORE);
        return;
    }
    let _ = d.armed.try_set(i, 0);
    if g64(in d.fired, i) == 1 {
        o.push(B_IGNORE);
        return;
    }
    let deadline = g64(in d.deadline, i);
    if now < deadline {
        let _ = d.armed.try_set(i, 1);
        put_arm(inout o, wrapping_sub(deadline, now));
        return;
    }
    let _ = d.fired.try_set(i, 1);
    put_fire(inout o, g64(in d.generation, i));
}

// `Debouncer::started`: keep the token of the run for `generation`, or
// cancel it when that generation is no longer the newest.
fn started(
    inout d: Debouncer,
    inout tokens: ChunkSeq[u8],
    in b: Slice[u8],
    at: u64,
    len: u64,
    generation: u64,
    token: u64
) {
    let i = entry(in d, in b, at, len);
    if i == NONE || g64(in d.generation, i) != generation {
        cancel(inout tokens, token);
        return;
    }
    if g64(in d.run_gen, i) != NONE {
        cancel(inout tokens, g64(in d.run_tok, i));
    }
    let _ = d.run_gen.try_set(i, generation);
    let _ = d.run_tok.try_set(i, token);
}

fn is_current(in d: Debouncer, in b: Slice[u8], at: u64, len: u64, generation: u64) -> bool {
    let i = entry(in d, in b, at, len);
    i != NONE && g64(in d.generation, i) == generation
}

fn finished(inout d: Debouncer, in b: Slice[u8], at: u64, len: u64, generation: u64) {
    let i = entry(in d, in b, at, len);
    if i != NONE && g64(in d.run_gen, i) == generation {
        let _ = d.run_gen.try_set(i, NONE);
        let _ = d.run_tok.try_set(i, NONE);
    }
}

fn forget(inout d: Debouncer, inout tokens: ChunkSeq[u8], in b: Slice[u8], at: u64, len: u64) {
    let i = entry(in d, in b, at, len);
    if i == NONE {
        return;
    }
    if g64(in d.run_gen, i) != NONE {
        cancel(inout tokens, g64(in d.run_tok, i));
    }
    remove(inout d, i);
}

fn cancel_every_run(inout d: Debouncer, inout tokens: ChunkSeq[u8]) {
    for i in 0..d.u_at.len() {
        if g64(in d.run_gen, i) != NONE {
            cancel(inout tokens, g64(in d.run_tok, i));
        }
    }
    d.u_at.truncate(0);
    d.u_len.truncate(0);
    d.generation.truncate(0);
    d.deadline.truncate(0);
    d.armed.truncate(0);
    d.fired.truncate(0);
    d.run_gen.truncate(0);
    d.run_tok.truncate(0);
}

// `PendingRequests`: the unanswered requests in table order (removal
// swaps the last one in, as `Vec::swap_remove` does). An ID is an integer
// (kind 0, the i32 as a word) or a string (kind 1, its blob span).
struct Pending {
    max: u64,
    kind: ChunkSeq[u64],
    value: ChunkSeq[u64],
    s_at: ChunkSeq[u64],
    s_len: ChunkSeq[u64],
    token: ChunkSeq[u64]
}

fn pending(max: u64) -> Pending {
    Pending {
        max: max,
        kind: ChunkSeq::new[u64](),
        value: ChunkSeq::new[u64](),
        s_at: ChunkSeq::new[u64](),
        s_len: ChunkSeq::new[u64](),
        token: ChunkSeq::new[u64]()
    }
}

copy struct Id {
    kind: u64,
    value: u64,
    s_at: u64,
    s_len: u64
}

fn same_id(in p: Pending, in b: Slice[u8], i: u64, id: Id) -> bool {
    if g64(in p.kind, i) != id.kind {
        return false;
    }
    if id.kind == 0 {
        return g64(in p.value, i) == id.value;
    }
    g64(in p.s_len, i) == id.s_len && same(in b, g64(in p.s_at, i), id.s_at, id.s_len)
}

fn find_id(in p: Pending, in b: Slice[u8], id: Id) -> u64 {
    for i in 0..p.kind.len() {
        if same_id(in p, in b, i, id) {
            return i;
        }
    }
    NONE
}

fn take(inout p: Pending, i: u64) {
    swap_out(inout p.kind, i);
    swap_out(inout p.value, i);
    swap_out(inout p.s_at, i);
    swap_out(inout p.s_len, i);
    swap_out(inout p.token, i);
}

// `PendingRequests::begin`: `K` and the new token, or the error.
fn begin(
    inout p: Pending,
    inout tokens: ChunkSeq[u8],
    inout o: ChunkSeq[u8],
    in b: Slice[u8],
    id: Id
) {
    if find_id(in p, in b, id) != NONE {
        put(inout o, in "E request ID is already pending");
        return;
    }
    if p.kind.len() >= p.max {
        put(inout o, in "E too many pending requests");
        return;
    }
    let k = tokens.len();
    tokens.push(B_FALSE);
    p.kind.push(id.kind);
    p.value.push(id.value);
    p.s_at.push(id.s_at);
    p.s_len.push(id.s_len);
    p.token.push(k);
    put(inout o, in "K ");
    put_u64(inout o, k);
}

// The request at `i` for the job `token`.
fn pending_at(in p: Pending, in b: Slice[u8], id: Id, token: u64) -> u64 {
    for i in 0..p.kind.len() {
        if same_id(in p, in b, i, id) && g64(in p.token, i) == token {
            return i;
        }
    }
    NONE
}

fn put_id(inout o: ChunkSeq[u8], in b: Slice[u8], in p: Pending, i: u64) {
    if g64(in p.kind, i) == 0 {
        put(inout o, in "i");
        let v = wrapping_i64(g64(in p.value, i));
        if v < 0 {
            o.push(B_MINUS);
            put_u64(inout o, wrapping_sub(0, wrapping_u64(v)));
        } else {
            put_u64(inout o, wrapping_u64(v));
        }
    } else {
        let at = g64(in p.s_at, i);
        let len = g64(in p.s_len, i);
        put(inout o, in "s");
        put_u64(inout o, len);
        o.push(B_LEN_END);
        o.extend(in b[at..wrapping_add(at, len)]);
    }
}

// The harness input: the word count, the operation count, five words per
// operation (kind, three arguments, the length of its text), then the texts
// in order. The answers are built `rounds` times: a row per operation and
// then the cancelled flag of every token.
pub fn lens_state(in input: Str) -> ChunkSeq[u64] {
    let b = input.as_bytes();
    let mut r = Rd { pos: 0 };
    let words = word(in b, inout r);
    let rounds = word(in b, inout r);
    let n = word(in b, inout r);
    let ops_r = r;
    let ops_t = Rd { pos: wrapping_mul(words, WORD_BYTES) };
    let mut out = ChunkSeq::new[u8]();
    let mut tokens = ChunkSeq::new[u8]();
    let mut d = debouncer(0, 0);
    let mut p = pending(0);
    for round in 0..rounds {
        out.truncate(0);
        tokens.truncate(0);
        let mut has_d = false;
        let mut has_p = false;
        r = ops_r;
        let mut t = ops_t;
        for k in 0..n {
            let kind = word(in b, inout r);
            let x = word(in b, inout r);
            let y = word(in b, inout r);
            let z = word(in b, inout r);
            let s_len = word(in b, inout r);
            let s_at = t.pos;
            t.pos = wrapping_add(t.pos, s_len);
            let id = Id { kind: y, value: x, s_at: s_at, s_len: s_len };
            if kind == D_NEW {
                // A new debouncer: the old one is dropped, its runs untouched.
                d.u_at.truncate(0);
                d.u_len.truncate(0);
                d.generation.truncate(0);
                d.deadline.truncate(0);
                d.armed.truncate(0);
                d.fired.truncate(0);
                d.run_gen.truncate(0);
                d.run_tok.truncate(0);
                has_d = x <= MINUTE && y != 0 && y <= MAX_DEBOUNCE_ENTRIES;
                d.delay = x;
                d.max = y;
                if has_d {
                    out.push(B_DONE);
                } else {
                    put(inout out, in "E invalid lens limits");
                }
            } else if kind == P_NEW {
                p.kind.truncate(0);
                p.value.truncate(0);
                p.s_at.truncate(0);
                p.s_len.truncate(0);
                p.token.truncate(0);
                has_p = x != 0 && x <= MAX_PENDING;
                p.max = x;
                if has_p {
                    out.push(B_DONE);
                } else {
                    put(inout out, in "E invalid lens limits");
                }
            } else if kind == T_NEW {
                put_u64(inout out, tokens.len());
                tokens.push(B_FALSE);
            } else if kind == T_CANCEL {
                cancel(inout tokens, z);
                out.push(B_DONE);
            } else if kind <= D_LEN && !has_d {
                out.push(B_NO_TABLE);
            } else if kind >= P_BEGIN && kind <= P_LEN && !has_p {
                out.push(B_NO_TABLE);
            } else if kind == D_TOUCH {
                touch(inout d, inout tokens, inout out, in b, s_at, s_len, x);
            } else if kind == D_TIMER {
                timer(inout d, inout out, in b, s_at, s_len, x);
            } else if kind == D_STARTED {
                // `NONE`: the token made last.
                let token = if z == NONE {
                    wrapping_sub(tokens.len(), 1)
                } else {
                    z
                };
                started(inout d, inout tokens, in b, s_at, s_len, x, token);
                out.push(B_DONE);
            } else if kind == D_IS_CURRENT {
                put_bool(inout out, is_current(in d, in b, s_at, s_len, x));
            } else if kind == D_FINISHED {
                finished(inout d, in b, s_at, s_len, x);
                out.push(B_DONE);
            } else if kind == D_FORGET {
                forget(inout d, inout tokens, in b, s_at, s_len);
                out.push(B_DONE);
            } else if kind == D_CANCEL_ALL {
                cancel_every_run(inout d, inout tokens);
                out.push(B_DONE);
            } else if kind == D_LEN {
                put_u64(inout out, d.u_at.len());
            } else if kind == P_BEGIN {
                begin(inout p, inout tokens, inout out, in b, id);
            } else if kind == P_CANCEL {
                let i = find_id(in p, in b, id);
                if i != NONE {
                    cancel(inout tokens, g64(in p.token, i));
                    take(inout p, i);
                }
                put_bool(inout out, i != NONE);
            } else if kind == P_FINISH {
                let i = pending_at(in p, in b, id, z);
                if i != NONE {
                    take(inout p, i);
                }
                put_bool(inout out, i != NONE);
            } else if kind == P_IS_PENDING {
                put_bool(inout out, pending_at(in p, in b, id, z) != NONE);
            } else if kind == P_CANCEL_ALL {
                for i in 0..p.kind.len() {
                    if i > 0 {
                        out.push(B_COMMA);
                    }
                    put_id(inout out, in b, in p, i);
                    cancel(inout tokens, g64(in p.token, i));
                }
                p.kind.truncate(0);
                p.value.truncate(0);
                p.s_at.truncate(0);
                p.s_len.truncate(0);
                p.token.truncate(0);
            } else if kind == P_LEN {
                put_u64(inout out, p.kind.len());
            }
            out.push(B_NEWLINE);
        }
        put(inout out, in "T ");
        out.extend(in tokens.as_slice());
        out.push(B_NEWLINE);
    }
    pack(in out.as_slice())
}
