// The two Lean renderings of a proof-lens model (`Exact` and `BitVecs` in
// src/lsp/proof_model.rs), byte for byte, over the model terms proof.ves
// builds.

use self::nav::{put_u};

// Model kinds (`proof_model::Kind`).
pub const K_U8: u8 = 0;
pub const K_U32: u8 = 1;
pub const K_U64: u8 = 2;
pub const K_I64: u8 = 3;
pub const K_BOOL: u8 = 4;
pub const K_UNIT: u8 = 5;
pub const K_NONE: u8 = 255;

// Term kinds (`proof_model::Term`).
pub const TM_VAR: u8 = 1;
pub const TM_INT: u8 = 2;
pub const TM_BOOL: u8 = 3;
pub const TM_UNIT: u8 = 4;
pub const TM_ARITH: u8 = 5;
pub const TM_DIV: u8 = 6;
pub const TM_NEG: u8 = 7;
pub const TM_NOT: u8 = 8;
pub const TM_CMP: u8 = 9;
pub const TM_AND: u8 = 10;
pub const TM_OR: u8 = 11;
pub const TM_ITE: u8 = 12;
pub const TM_LET: u8 = 13;

// `Arith`: 0 Add, 1 Sub, 2 Mul. `Cmp`: 0 Eq, 1 Ne, 2 Lt, 3 Le, 4 Gt, 5 Ge.
pub const OP_ADD: u8 = 0;
pub const OP_SUB: u8 = 1;
pub const OP_MUL: u8 = 2;
pub const CMP_EQ: u8 = 0;
pub const CMP_NE: u8 = 1;
pub const CMP_LT: u8 = 2;
pub const CMP_LE: u8 = 3;
pub const CMP_GT: u8 = 4;
pub const CMP_GE: u8 = 5;

// The model's terms and variables. A term is a row: kind, up to three
// children (`a`, `b`, `c`; a variable index for Var and Let's `a`), its
// kind, operator and flag (Bool's value, Arith's `checked`, Div's `rem`),
// and an Int's value as sign and magnitude.
pub struct Tm {
    term_kind: ChunkSeq[u8],
    a: ChunkSeq[u32],
    b: ChunkSeq[u32],
    c: ChunkSeq[u32],
    kind: ChunkSeq[u8],
    op: ChunkSeq[u8],
    flag: ChunkSeq[u8],
    mag: ChunkSeq[u64],
    neg: ChunkSeq[u8],
    // Variables (`VarInfo`): sanitized name in `pool`, kind, parameter.
    var_name_at: ChunkSeq[u64],
    var_name_len: ChunkSeq[u64],
    var_kind: ChunkSeq[u8],
    var_param: ChunkSeq[u8],
    pool: ChunkSeq[u8]
}

pub fn tm_new() -> Tm {
    Tm {
        term_kind: ChunkSeq::new[u8](),
        a: ChunkSeq::new[u32](),
        b: ChunkSeq::new[u32](),
        c: ChunkSeq::new[u32](),
        kind: ChunkSeq::new[u8](),
        op: ChunkSeq::new[u8](),
        flag: ChunkSeq::new[u8](),
        mag: ChunkSeq::new[u64](),
        neg: ChunkSeq::new[u8](),
        var_name_at: ChunkSeq::new[u64](),
        var_name_len: ChunkSeq::new[u64](),
        var_kind: ChunkSeq::new[u8](),
        var_param: ChunkSeq::new[u8](),
        pool: ChunkSeq::new[u8]()
    }
}

pub fn tm_clear(inout terms: Tm) {
    terms.term_kind.clear();
    terms.a.clear();
    terms.b.clear();
    terms.c.clear();
    terms.kind.clear();
    terms.op.clear();
    terms.flag.clear();
    terms.mag.clear();
    terms.neg.clear();
    terms.var_name_at.clear();
    terms.var_name_len.clear();
    terms.var_kind.clear();
    terms.var_param.clear();
    terms.pool.clear();
}

pub fn term(
    inout terms: Tm,
    term_kind: u8,
    a: u32,
    b: u32,
    c: u32,
    kind: u8,
    op: u8,
    flag: u8
) -> u32 {
    terms.term_kind.push(term_kind);
    terms.a.push(a);
    terms.b.push(b);
    terms.c.push(c);
    terms.kind.push(kind);
    terms.op.push(op);
    terms.flag.push(flag);
    terms.mag.push(0);
    terms.neg.push(0);
    wrapping_u32(wrapping_sub(terms.term_kind.len(), 1))
}

pub fn int_term(inout terms: Tm, neg: bool, mag: u64, kind: u8) -> u32 {
    let term_id = term(inout terms, TM_INT, 0, 0, 0, kind, 0, 0);
    let ok = terms.mag.try_set(widen_u64(term_id), mag);
    let ok2 = terms.neg.try_set(widen_u64(term_id), if neg && mag != 0 { 1 } else { 0 });
    term_id
}

fn g8(in column: ChunkSeq[u8], i: u32) -> u8 {
    column.try_get(widen_u64(i)).unwrap_or(0)
}

fn g32(in column: ChunkSeq[u32], i: u32) -> u32 {
    column.try_get(widen_u64(i)).unwrap_or(0)
}

fn g64(in column: ChunkSeq[u64], i: u32) -> u64 {
    column.try_get(widen_u64(i)).unwrap_or(0)
}

pub fn tk(in terms: Tm, term_id: u32) -> u8 {
    g8(in terms.term_kind, term_id)
}

pub fn ta(in terms: Tm, term_id: u32) -> u32 {
    g32(in terms.a, term_id)
}

pub fn tb(in terms: Tm, term_id: u32) -> u32 {
    g32(in terms.b, term_id)
}

pub fn tc(in terms: Tm, term_id: u32) -> u32 {
    g32(in terms.c, term_id)
}

pub fn t_kind(in terms: Tm, term_id: u32) -> u8 {
    g8(in terms.kind, term_id)
}

pub fn t_op(in terms: Tm, term_id: u32) -> u8 {
    g8(in terms.op, term_id)
}

pub fn t_flag(in terms: Tm, term_id: u32) -> u8 {
    g8(in terms.flag, term_id)
}

pub fn t_mag(in terms: Tm, term_id: u32) -> u64 {
    g64(in terms.mag, term_id)
}

pub fn t_neg(in terms: Tm, term_id: u32) -> bool {
    g8(in terms.neg, term_id) != 0
}

pub fn var_kind(in terms: Tm, var_id: u32) -> u8 {
    g8(in terms.var_kind, var_id)
}

pub fn var_param(in terms: Tm, var_id: u32) -> bool {
    g8(in terms.var_param, var_id) != 0
}

pub fn var_count(in terms: Tm) -> u64 {
    terms.var_kind.len()
}

// `Builder::kind_of`.
pub fn kind_of(in terms: Tm, term_id: u32) -> u8 {
    let mut at = term_id;
    loop {
        let term_kind = tk(in terms, at);
        if term_kind == TM_LET {
            at = tc(in terms, at);
            continue;
        }
        if term_kind == TM_VAR {
            return var_kind(in terms, ta(in terms, at));
        }
        if term_kind == TM_BOOL
            || term_kind == TM_NOT
            || term_kind == TM_CMP
            || term_kind == TM_AND
            || term_kind == TM_OR {
            return K_BOOL;
        }
        if term_kind == TM_UNIT {
            return K_UNIT;
        }
        return t_kind(in terms, at);
    }
}

// ------------------------------------------------------------ kinds

pub fn integer(k: u8) -> bool {
    k == K_U8 || k == K_U32 || k == K_U64 || k == K_I64
}

pub fn width(k: u8) -> u64 {
    if k == K_U8 {
        8
    } else if k == K_U32 {
        32
    } else if k == K_U64 || k == K_I64 {
        64
    } else if k == K_BOOL {
        1
    } else {
        0
    }
}

pub fn kind_name(k: u8) -> Str {
    if k == K_U8 {
        "u8"
    } else if k == K_U32 {
        "u32"
    } else if k == K_U64 {
        "u64"
    } else if k == K_I64 {
        "i64"
    } else if k == K_BOOL {
        "bool"
    } else {
        "Unit"
    }
}

fn range_lo(k: u8) -> Str {
    if k == K_I64 {
        "-9223372036854775808"
    } else {
        "0"
    }
}

fn range_hi(k: u8) -> Str {
    if k == K_U8 {
        "255"
    } else if k == K_U32 {
        "4294967295"
    } else if k == K_U64 {
        "18446744073709551615"
    } else if k == K_I64 {
        "9223372036854775807"
    } else if k == K_BOOL {
        "1"
    } else {
        "0"
    }
}

// `1 << width` and half of it, as decimals.
fn modulus(kind: u8) -> Str {
    let bits = width(kind);
    if bits == 64 {
        "18446744073709551616"
    } else if bits == 32 {
        "4294967296"
    } else if bits == 8 {
        "256"
    } else if bits == 1 {
        "2"
    } else {
        "1"
    }
}

fn half(kind: u8) -> Str {
    let bits = width(kind);
    if bits == 64 {
        "9223372036854775808"
    } else if bits == 32 {
        "2147483648"
    } else if bits == 8 {
        "128"
    } else if bits == 1 {
        "1"
    } else {
        "0"
    }
}

// ------------------------------------------------------------ text

pub fn s(inout out: ChunkSeq[u8], in text: Str) {
    out.extend(in text.as_bytes());
}

pub fn sb(inout out: ChunkSeq[u8], in text: ChunkSeq[u8]) {
    out.extend(in text.as_slice());
}

fn is_text(in actual: ChunkSeq[u8], in expected: Str) -> bool {
    let expected_bytes = expected.as_bytes();
    if actual.len() != expected_bytes.len() {
        return false;
    }
    for i in 0..actual.len() {
        let got = actual.try_get(i).unwrap_or(0);
        let want = expected_bytes.try_get(i).unwrap_or(0);
        if got != want {
            return false;
        }
    }
    true
}

fn is_false(in text: ChunkSeq[u8]) -> bool {
    is_text(in text, in "False")
}

// An i128 value printed by `{}`: sign and magnitude.
pub fn put_int(inout out: ChunkSeq[u8], neg: bool, mag: u64) {
    if neg && mag != 0 {
        out.push(45);
    }
    put_u(inout out, mag);
}

// `bv_literal`: `(n.rem_euclid(1 << width)#width)`.
fn bv_literal(inout out: ChunkSeq[u8], neg: bool, mag: u64, w: u64) {
    let mut value: u64 = 0;
    if w >= 64 {
        value = if neg { wrapping_sub(0, mag) } else { mag };
    } else if w > 0 {
        let limit = wrapping_shl_u64(1, wrapping_u32(w));
        let residue = mag & wrapping_sub(limit, 1);
        value = if neg && residue != 0 {
            wrapping_sub(limit, residue)
        } else {
            residue
        };
    }
    s(inout out, in "(");
    put_u(inout out, value);
    s(inout out, in "#");
    put_u(inout out, w);
    s(inout out, in ")");
}

fn var_name(inout out: ChunkSeq[u8], in terms: Tm, var_id: u32) {
    s(inout out, in "«");
    if var_param(in terms, var_id) {
        let name_at = g64(in terms.var_name_at, var_id);
        let name_len = g64(in terms.var_name_len, var_id);
        for i in 0..name_len {
            match terms.pool.try_get(wrapping_add(name_at, i)) {
                Option::Some(c) => out.push(c),
                Option::None => {}
            }
        }
    } else {
        s(inout out, in "$v");
        put_u(inout out, widen_u64(var_id));
    }
    s(inout out, in "»");
}

fn range_prop(inout out: ChunkSeq[u8], in term_text: ChunkSeq[u8], kind: u8) {
    s(inout out, in "(");
    s(inout out, in range_lo(kind));
    s(inout out, in " : Int) ≤ ");
    sb(inout out, in term_text);
    s(inout out, in " ∧ ");
    sb(inout out, in term_text);
    s(inout out, in " ≤ ");
    s(inout out, in range_hi(kind));
}

// `any`: a disjunction of the parts that are not `False`.
struct Any {
    out: ChunkSeq[u8],
    first: ChunkSeq[u8],
    n: u64
}

fn any_new() -> Any {
    Any { out: ChunkSeq::new[u8](), first: ChunkSeq::new[u8](), n: 0 }
}

fn any_add(inout disjunction: Any, in part: ChunkSeq[u8]) {
    if is_false(in part) {
        return;
    }
    if disjunction.n == 0 {
        sb(inout disjunction.first, in part);
    } else {
        if disjunction.n == 1 {
            s(inout disjunction.out, in "(");
            sb(inout disjunction.out, in disjunction.first);
            s(inout disjunction.out, in ")");
        }
        s(inout disjunction.out, in " ∨ (");
        sb(inout disjunction.out, in part);
        s(inout disjunction.out, in ")");
    }
    disjunction.n = wrapping_add(disjunction.n, 1);
}

fn any_end(sink disjunction: Any) -> ChunkSeq[u8] {
    if disjunction.n == 0 {
        let mut text = ChunkSeq::new[u8]();
        s(inout text, in "False");
        text
    } else if disjunction.n == 1 {
        disjunction.first
    } else {
        disjunction.out
    }
}

// `both`: `condition ∧ (fault)`, or `False`.
fn both(in condition: ChunkSeq[u8], in fault: ChunkSeq[u8]) -> ChunkSeq[u8] {
    let mut out = ChunkSeq::new[u8]();
    if is_false(in fault) {
        s(inout out, in "False");
    } else {
        sb(inout out, in condition);
        s(inout out, in " ∧ (");
        sb(inout out, in fault);
        s(inout out, in ")");
    }
    out
}

fn not_of(in condition: ChunkSeq[u8]) -> ChunkSeq[u8] {
    let mut out = ChunkSeq::new[u8]();
    s(inout out, in "¬ ");
    sb(inout out, in condition);
    out
}

// ------------------------------------------------------------ Exact

struct Ex {
    temps: u64,
    // ` (b : Int)` per binder, and `    (d) →\n` per definition.
    binders: ChunkSeq[u8],
    binder_count: u64,
    defs: ChunkSeq[u8]
}

struct Vf {
    value: ChunkSeq[u8],
    fault: ChunkSeq[u8]
}

fn binder(inout ex: Ex, in name: ChunkSeq[u8]) {
    s(inout ex.binders, in " (");
    sb(inout ex.binders, in name);
    s(inout ex.binders, in " : Int)");
    ex.binder_count = wrapping_add(ex.binder_count, 1);
}

fn def(inout ex: Ex, in definition: ChunkSeq[u8]) {
    s(inout ex.defs, in "    (");
    sb(inout ex.defs, in definition);
    s(inout ex.defs, in ") →\n");
}

fn temp(inout ex: Ex) -> ChunkSeq[u8] {
    ex.temps = wrapping_add(ex.temps, 1);
    let mut name = ChunkSeq::new[u8]();
    s(inout name, in "«$t");
    put_u(inout name, ex.temps);
    s(inout name, in "»");
    binder(inout ex, in name);
    name
}

fn lit(in text: Str) -> ChunkSeq[u8] {
    let mut out = ChunkSeq::new[u8]();
    s(inout out, in text);
    out
}

fn cond(in value: ChunkSeq[u8]) -> ChunkSeq[u8] {
    let mut out = ChunkSeq::new[u8]();
    sb(inout out, in value);
    s(inout out, in " = 1");
    out
}

fn bool_def(inout ex: Ex, in prop: ChunkSeq[u8], in term_text: ChunkSeq[u8]) {
    let mut definition = ChunkSeq::new[u8]();
    s(inout definition, in "((");
    sb(inout definition, in prop);
    s(inout definition, in ") ∧ ");
    sb(inout definition, in term_text);
    s(inout definition, in " = 1) ∨ (¬ (");
    sb(inout definition, in prop);
    s(inout definition, in ") ∧ ");
    sb(inout definition, in term_text);
    s(inout definition, in " = 0)");
    def(inout ex, in definition);
}

fn emit(inout ex: Ex, in terms: Tm, term_id: u32) -> Vf {
    let term_kind = tk(in terms, term_id);
    if term_kind == TM_VAR {
        let mut var_text = ChunkSeq::new[u8]();
        var_name(inout var_text, in terms, ta(in terms, term_id));
        return Vf { value: var_text, fault: lit(in "False") };
    }
    if term_kind == TM_INT {
        let mut int_text = ChunkSeq::new[u8]();
        s(inout int_text, in "(");
        put_int(inout int_text, t_neg(in terms, term_id), t_mag(in terms, term_id));
        s(inout int_text, in " : Int)");
        return Vf { value: int_text, fault: lit(in "False") };
    }
    if term_kind == TM_BOOL {
        return Vf {
            value: lit(
                in if t_flag(in terms, term_id) != 0 {
                    "1"
                } else {
                    "0"
                }
            ),
            fault: lit(in "False")
        };
    }
    if term_kind == TM_UNIT {
        return Vf { value: lit(in "0"), fault: lit(in "False") };
    }
    let kind = t_kind(in terms, term_id);
    if term_kind == TM_ARITH {
        let lhs = emit(inout ex, in terms, ta(in terms, term_id));
        let rhs = emit(inout ex, in terms, tb(in terms, term_id));
        let op = t_op(in terms, term_id);
        let result = temp(inout ex);
        let mut exact_expr = ChunkSeq::new[u8]();
        sb(inout exact_expr, in lhs.value);
        s(
            inout exact_expr,
            in if op == OP_ADD {
                " + "
            } else if op == OP_SUB {
                " - "
            } else {
                " * "
            }
        );
        sb(inout exact_expr, in rhs.value);
        let mut definition = ChunkSeq::new[u8]();
        sb(inout definition, in result);
        s(inout definition, in " = ");
        let mut faults = any_new();
        any_add(inout faults, in lhs.fault);
        any_add(inout faults, in rhs.fault);
        if t_flag(in terms, term_id) != 0 {
            sb(inout definition, in exact_expr);
            def(inout ex, in definition);
            let mut over = ChunkSeq::new[u8]();
            s(inout over, in "¬ (");
            range_prop(inout over, in result, kind);
            s(inout over, in ")");
            any_add(inout faults, in over);
        } else {
            if kind == K_I64 {
                s(inout definition, in "((");
                sb(inout definition, in exact_expr);
                s(inout definition, in ") + ");
                s(inout definition, in half(kind));
                s(inout definition, in ") % ");
                s(inout definition, in modulus(kind));
                s(inout definition, in " - ");
                s(inout definition, in half(kind));
            } else {
                s(inout definition, in "(");
                sb(inout definition, in exact_expr);
                s(inout definition, in ") % ");
                s(inout definition, in modulus(kind));
            }
            def(inout ex, in definition);
        }
        return Vf { value: result, fault: any_end(faults) };
    }
    if term_kind == TM_DIV {
        let divisor = tb(in terms, term_id);
        let lhs = emit(inout ex, in terms, ta(in terms, term_id));
        let rhs = emit(inout ex, in terms, divisor);
        let result = temp(inout ex);
        let rem = t_flag(in terms, term_id) != 0;
        let mut faults = any_new();
        any_add(inout faults, in lhs.fault);
        any_add(inout faults, in rhs.fault);
        let mut div_zero = ChunkSeq::new[u8]();
        sb(inout div_zero, in rhs.value);
        s(inout div_zero, in " = 0");
        any_add(inout faults, in div_zero);
        if kind == K_I64 && !rem {
            let mut overflow = ChunkSeq::new[u8]();
            s(inout overflow, in "(");
            sb(inout overflow, in lhs.value);
            s(inout overflow, in " = (");
            s(inout overflow, in range_lo(kind));
            s(inout overflow, in " : Int) ∧ ");
            sb(inout overflow, in rhs.value);
            s(inout overflow, in " = -1)");
            any_add(inout faults, in overflow);
        }
        if tk(in terms, divisor) == TM_INT && t_mag(in terms, divisor) != 0 {
            let divisor_neg = t_neg(in terms, divisor);
            let divisor_mag = t_mag(in terms, divisor);
            let quotient = temp(inout ex);
            let mut definition = ChunkSeq::new[u8]();
            // `({x} ≥ 0 ∧ {q} = ...) ∨ ({x} < 0 ∧ {q} = ...)`
            s(inout definition, in "(");
            sb(inout definition, in lhs.value);
            s(inout definition, in " ≥ 0 ∧ ");
            sb(inout definition, in quotient);
            if !divisor_neg {
                s(inout definition, in " = ");
                sb(inout definition, in lhs.value);
                s(inout definition, in " / ");
                put_u(inout definition, divisor_mag);
                s(inout definition, in ") ∨ (");
                sb(inout definition, in lhs.value);
                s(inout definition, in " < 0 ∧ ");
                sb(inout definition, in quotient);
                s(inout definition, in " = -((-");
                sb(inout definition, in lhs.value);
                s(inout definition, in ") / ");
                put_u(inout definition, divisor_mag);
                s(inout definition, in "))");
            } else {
                s(inout definition, in " = -(");
                sb(inout definition, in lhs.value);
                s(inout definition, in " / ");
                put_u(inout definition, divisor_mag);
                s(inout definition, in ")) ∨ (");
                sb(inout definition, in lhs.value);
                s(inout definition, in " < 0 ∧ ");
                sb(inout definition, in quotient);
                s(inout definition, in " = (-");
                sb(inout definition, in lhs.value);
                s(inout definition, in ") / ");
                put_u(inout definition, divisor_mag);
                s(inout definition, in ")");
            }
            def(inout ex, in definition);
            let mut result_def = ChunkSeq::new[u8]();
            sb(inout result_def, in result);
            if rem {
                s(inout result_def, in " = ");
                sb(inout result_def, in lhs.value);
                s(inout result_def, in " - (");
                put_int(inout result_def, divisor_neg, divisor_mag);
                s(inout result_def, in " : Int) * ");
                sb(inout result_def, in quotient);
            } else {
                s(inout result_def, in " = ");
                sb(inout result_def, in quotient);
            }
            def(inout ex, in result_def);
        }
        return Vf { value: result, fault: any_end(faults) };
    }
    if term_kind == TM_NEG {
        let operand = emit(inout ex, in terms, ta(in terms, term_id));
        let result = temp(inout ex);
        let mut definition = ChunkSeq::new[u8]();
        sb(inout definition, in result);
        s(inout definition, in " = 0 - ");
        sb(inout definition, in operand.value);
        def(inout ex, in definition);
        let mut fault = ChunkSeq::new[u8]();
        sb(inout fault, in operand.value);
        if kind == K_I64 {
            s(inout fault, in " = (");
            s(inout fault, in range_lo(kind));
            s(inout fault, in " : Int)");
        } else {
            s(inout fault, in " ≠ 0");
        }
        let mut faults = any_new();
        any_add(inout faults, in operand.fault);
        any_add(inout faults, in fault);
        return Vf { value: result, fault: any_end(faults) };
    }
    if term_kind == TM_NOT {
        let operand = emit(inout ex, in terms, ta(in terms, term_id));
        let result = temp(inout ex);
        let mut definition = ChunkSeq::new[u8]();
        sb(inout definition, in result);
        s(inout definition, in " = 1 - ");
        sb(inout definition, in operand.value);
        def(inout ex, in definition);
        return Vf { value: result, fault: operand.fault };
    }
    if term_kind == TM_CMP {
        let lhs = emit(inout ex, in terms, ta(in terms, term_id));
        let rhs = emit(inout ex, in terms, tb(in terms, term_id));
        let op = t_op(in terms, term_id);
        let result = temp(inout ex);
        let mut prop = ChunkSeq::new[u8]();
        sb(inout prop, in lhs.value);
        s(
            inout prop,
            in if op == CMP_EQ {
                " = "
            } else if op == CMP_NE {
                " ≠ "
            } else if op == CMP_LT {
                " < "
            } else if op == CMP_LE {
                " ≤ "
            } else if op == CMP_GT {
                " > "
            } else {
                " ≥ "
            }
        );
        sb(inout prop, in rhs.value);
        bool_def(inout ex, in prop, in result);
        let mut faults = any_new();
        any_add(inout faults, in lhs.fault);
        any_add(inout faults, in rhs.fault);
        return Vf { value: result, fault: any_end(faults) };
    }
    if term_kind == TM_AND || term_kind == TM_OR {
        let and = term_kind == TM_AND;
        let lhs = emit(inout ex, in terms, ta(in terms, term_id));
        let rhs = emit(inout ex, in terms, tb(in terms, term_id));
        let result = temp(inout ex);
        let lhs_cond = cond(in lhs.value);
        let rhs_cond = cond(in rhs.value);
        let mut prop = ChunkSeq::new[u8]();
        sb(inout prop, in lhs_cond);
        s(inout prop, in if and { " ∧ " } else { " ∨ " });
        sb(inout prop, in rhs_cond);
        bool_def(inout ex, in prop, in result);
        let runs = if and {
            copy_bytes(in lhs_cond)
        } else {
            not_of(in lhs_cond)
        };
        let mut faults = any_new();
        any_add(inout faults, in lhs.fault);
        any_add(inout faults, in both(in runs, in rhs.fault));
        return Vf { value: result, fault: any_end(faults) };
    }
    if term_kind == TM_ITE {
        let cond_val = emit(inout ex, in terms, ta(in terms, term_id));
        let then_val = emit(inout ex, in terms, tb(in terms, term_id));
        let else_val = emit(inout ex, in terms, tc(in terms, term_id));
        let result = temp(inout ex);
        let cond_text = cond(in cond_val.value);
        let mut definition = ChunkSeq::new[u8]();
        s(inout definition, in "(");
        sb(inout definition, in cond_text);
        s(inout definition, in " ∧ ");
        sb(inout definition, in result);
        s(inout definition, in " = ");
        sb(inout definition, in then_val.value);
        s(inout definition, in ") ∨ (¬ ");
        sb(inout definition, in cond_text);
        s(inout definition, in " ∧ ");
        sb(inout definition, in result);
        s(inout definition, in " = ");
        sb(inout definition, in else_val.value);
        s(inout definition, in ")");
        def(inout ex, in definition);
        let mut faults = any_new();
        any_add(inout faults, in cond_val.fault);
        any_add(inout faults, in both(in cond_text, in then_val.fault));
        any_add(inout faults, in both(in not_of(in cond_text), in else_val.fault));
        return Vf { value: result, fault: any_end(faults) };
    }
    // Let
    let bound = emit(inout ex, in terms, tb(in terms, term_id));
    let mut name = ChunkSeq::new[u8]();
    var_name(inout name, in terms, ta(in terms, term_id));
    binder(inout ex, in name);
    let mut definition = ChunkSeq::new[u8]();
    sb(inout definition, in name);
    s(inout definition, in " = ");
    sb(inout definition, in bound.value);
    def(inout ex, in definition);
    let body = emit(inout ex, in terms, tc(in terms, term_id));
    let mut faults = any_new();
    any_add(inout faults, in bound.fault);
    any_add(inout faults, in body.fault);
    Vf { value: body.value, fault: any_end(faults) }
}

fn copy_bytes(in text: ChunkSeq[u8]) -> ChunkSeq[u8] {
    let mut out = ChunkSeq::new[u8]();
    sb(inout out, in text);
    out
}

// `Exact::render`.
pub fn exact(inout out: ChunkSeq[u8], in terms: Tm, root: u32) {
    let mut ex = Ex {
        temps: 0,
        binders: ChunkSeq::new[u8](),
        binder_count: 0,
        defs: ChunkSeq::new[u8]()
    };
    let mut ranges = ChunkSeq::new[u8]();
    for i in 0..var_count(in terms) {
        let var_id = wrapping_u32(i);
        if var_param(in terms, var_id) {
            let mut name = ChunkSeq::new[u8]();
            var_name(inout name, in terms, var_id);
            binder(inout ex, in name);
            s(inout ranges, in "    (");
            range_prop(inout ranges, in name, var_kind(in terms, var_id));
            s(inout ranges, in ") →\n");
        }
    }
    let result = emit(inout ex, in terms, root);
    s(inout out, in "theorem no_arith_fault :");
    if ex.binder_count > 0 {
        s(inout out, in " ∀");
        sb(inout out, in ex.binders);
        s(inout out, in ",");
    }
    s(inout out, in "\n");
    sb(inout out, in ranges);
    sb(inout out, in ex.defs);
    s(inout out, in "    ¬ (");
    sb(inout out, in result.fault);
    s(inout out, in ") := by\n  intros\n  ");
    s(
        inout out,
        in if is_false(in result.fault) {
            "simp"
        } else {
            "omega"
        }
    );
    s(inout out, in "\n");
}

// ------------------------------------------------------------ BitVecs

fn bv_value(inout out: ChunkSeq[u8], in terms: Tm, term_id: u32) {
    let term_kind = tk(in terms, term_id);
    if term_kind == TM_VAR {
        var_name(inout out, in terms, ta(in terms, term_id));
    } else if term_kind == TM_INT {
        bv_literal(
            inout out,
            t_neg(in terms, term_id),
            t_mag(in terms, term_id),
            width(t_kind(in terms, term_id))
        );
    } else if term_kind == TM_BOOL {
        s(
            inout out,
            in if t_flag(in terms, term_id) != 0 {
                "true"
            } else {
                "false"
            }
        );
    } else if term_kind == TM_UNIT {
        s(inout out, in "()");
    } else if term_kind == TM_ARITH {
        let op = t_op(in terms, term_id);
        s(inout out, in "(");
        bv_value(inout out, in terms, ta(in terms, term_id));
        s(
            inout out,
            in if op == OP_ADD {
                " + "
            } else if op == OP_SUB {
                " - "
            } else {
                " * "
            }
        );
        bv_value(inout out, in terms, tb(in terms, term_id));
        s(inout out, in ")");
    } else if term_kind == TM_DIV {
        let signed = t_kind(in terms, term_id) == K_I64;
        let rem = t_flag(in terms, term_id) != 0;
        s(
            inout out,
            in if signed && !rem {
                "(BitVec.sdiv "
            } else if signed {
                "(BitVec.srem "
            } else if !rem {
                "(BitVec.udiv "
            } else {
                "(BitVec.umod "
            }
        );
        bv_value(inout out, in terms, ta(in terms, term_id));
        s(inout out, in " ");
        bv_value(inout out, in terms, tb(in terms, term_id));
        s(inout out, in ")");
    } else if term_kind == TM_NEG {
        s(inout out, in "(-");
        bv_value(inout out, in terms, ta(in terms, term_id));
        s(inout out, in ")");
    } else if term_kind == TM_NOT {
        s(inout out, in "(!");
        bv_value(inout out, in terms, ta(in terms, term_id));
        s(inout out, in ")");
    } else if term_kind == TM_CMP {
        let mut lhs = ChunkSeq::new[u8]();
        bv_value(inout lhs, in terms, ta(in terms, term_id));
        let mut rhs = ChunkSeq::new[u8]();
        bv_value(inout rhs, in terms, tb(in terms, term_id));
        let op = t_op(in terms, term_id);
        let is_signed = t_kind(in terms, term_id) == K_I64;
        if op == CMP_EQ || op == CMP_NE {
            s(inout out, in "(");
            sb(inout out, in lhs);
            s(inout out, in if op == CMP_EQ { " == " } else { " != " });
            sb(inout out, in rhs);
            s(inout out, in ")");
        } else {
            let swap = op == CMP_GT || op == CMP_GE;
            let strict = op == CMP_LT || op == CMP_GT;
            s(
                inout out,
                in if is_signed && strict {
                    "(BitVec.slt "
                } else if is_signed {
                    "(BitVec.sle "
                } else if strict {
                    "(BitVec.ult "
                } else {
                    "(BitVec.ule "
                }
            );
            if swap {
                sb(inout out, in rhs);
                s(inout out, in " ");
                sb(inout out, in lhs);
            } else {
                sb(inout out, in lhs);
                s(inout out, in " ");
                sb(inout out, in rhs);
            }
            s(inout out, in ")");
        }
    } else if term_kind == TM_AND || term_kind == TM_OR {
        s(inout out, in "(");
        bv_value(inout out, in terms, ta(in terms, term_id));
        s(inout out, in if term_kind == TM_AND { " && " } else { " || " });
        bv_value(inout out, in terms, tb(in terms, term_id));
        s(inout out, in ")");
    } else if term_kind == TM_ITE {
        s(inout out, in "(bif ");
        bv_value(inout out, in terms, ta(in terms, term_id));
        s(inout out, in " then ");
        bv_value(inout out, in terms, tb(in terms, term_id));
        s(inout out, in " else ");
        bv_value(inout out, in terms, tc(in terms, term_id));
        s(inout out, in ")");
    } else {
        s(inout out, in "(let ");
        var_name(inout out, in terms, ta(in terms, term_id));
        s(inout out, in " := ");
        bv_value(inout out, in terms, tb(in terms, term_id));
        s(inout out, in "; ");
        bv_value(inout out, in terms, tc(in terms, term_id));
        s(inout out, in ")");
    }
}

fn extended(
    inout out: ChunkSeq[u8],
    in f: Str,
    n: u64,
    in x: ChunkSeq[u8],
    in y: ChunkSeq[u8],
    in op: Str
) {
    // `((BitVec.f n x OP BitVec.f n y) != BitVec.f n (x OP y))`
    s(inout out, in "((");
    s(inout out, in f);
    s(inout out, in " ");
    put_u(inout out, n);
    s(inout out, in " ");
    sb(inout out, in x);
    s(inout out, in op);
    s(inout out, in f);
    s(inout out, in " ");
    put_u(inout out, n);
    s(inout out, in " ");
    sb(inout out, in y);
    s(inout out, in ") != ");
    s(inout out, in f);
    s(inout out, in " ");
    put_u(inout out, n);
    s(inout out, in " (");
    sb(inout out, in x);
    s(inout out, in op);
    sb(inout out, in y);
    s(inout out, in "))");
}

fn bv_fault(inout out: ChunkSeq[u8], in terms: Tm, term_id: u32) {
    let term_kind = tk(in terms, term_id);
    if term_kind == TM_VAR || term_kind == TM_INT || term_kind == TM_BOOL || term_kind == TM_UNIT {
        s(inout out, in "false");
        return;
    }
    let kind = t_kind(in terms, term_id);
    let bits = width(kind);
    let signed = kind == K_I64;
    if term_kind == TM_ARITH {
        let checked = t_flag(in terms, term_id) != 0;
        if checked {
            s(inout out, in "(");
        }
        s(inout out, in "(");
        bv_fault(inout out, in terms, ta(in terms, term_id));
        s(inout out, in " || ");
        bv_fault(inout out, in terms, tb(in terms, term_id));
        s(inout out, in ")");
        if !checked {
            return;
        }
        let mut lhs = ChunkSeq::new[u8]();
        bv_value(inout lhs, in terms, ta(in terms, term_id));
        let mut rhs = ChunkSeq::new[u8]();
        bv_value(inout rhs, in terms, tb(in terms, term_id));
        s(inout out, in " || ");
        let op = t_op(in terms, term_id);
        if signed {
            let ext_width = if op == OP_MUL {
                wrapping_add(bits, bits)
            } else {
                wrapping_add(bits, 1)
            };
            extended(
                inout out,
                in "BitVec.signExtend",
                ext_width,
                in lhs,
                in rhs,
                in if op == OP_ADD {
                    " + "
                } else if op == OP_SUB {
                    " - "
                } else {
                    " * "
                }
            );
        } else if op == OP_ADD {
            s(inout out, in "(BitVec.ult (");
            sb(inout out, in lhs);
            s(inout out, in " + ");
            sb(inout out, in rhs);
            s(inout out, in ") ");
            sb(inout out, in lhs);
            s(inout out, in ")");
        } else if op == OP_SUB {
            s(inout out, in "(BitVec.ult ");
            sb(inout out, in lhs);
            s(inout out, in " ");
            sb(inout out, in rhs);
            s(inout out, in ")");
        } else {
            extended(
                inout out,
                in "BitVec.zeroExtend",
                wrapping_add(bits, bits),
                in lhs,
                in rhs,
                in " * "
            );
        }
        s(inout out, in ")");
        return;
    }
    if term_kind == TM_DIV {
        let mut lhs = ChunkSeq::new[u8]();
        bv_value(inout lhs, in terms, ta(in terms, term_id));
        let mut rhs = ChunkSeq::new[u8]();
        bv_value(inout rhs, in terms, tb(in terms, term_id));
        s(inout out, in "(");
        bv_fault(inout out, in terms, ta(in terms, term_id));
        s(inout out, in " || ");
        bv_fault(inout out, in terms, tb(in terms, term_id));
        s(inout out, in " || (");
        sb(inout out, in rhs);
        s(inout out, in " == 0#");
        put_u(inout out, bits);
        s(inout out, in ")");
        if signed && t_flag(in terms, term_id) == 0 {
            s(inout out, in " || (");
            sb(inout out, in lhs);
            s(inout out, in " == ");
            bv_literal(inout out, true, 9223372036854775808, bits);
            s(inout out, in " && ");
            sb(inout out, in rhs);
            s(inout out, in " == ");
            bv_literal(inout out, true, 1, bits);
            s(inout out, in ")");
        }
        s(inout out, in ")");
        return;
    }
    if term_kind == TM_NEG {
        let mut operand = ChunkSeq::new[u8]();
        bv_value(inout operand, in terms, ta(in terms, term_id));
        s(inout out, in "(");
        bv_fault(inout out, in terms, ta(in terms, term_id));
        s(inout out, in " || (");
        sb(inout out, in operand);
        if signed {
            s(inout out, in " == ");
            bv_literal(inout out, true, 9223372036854775808, bits);
        } else {
            s(inout out, in " != 0#");
            put_u(inout out, bits);
        }
        s(inout out, in "))");
        return;
    }
    if term_kind == TM_NOT {
        bv_fault(inout out, in terms, ta(in terms, term_id));
        return;
    }
    if term_kind == TM_CMP {
        s(inout out, in "(");
        bv_fault(inout out, in terms, ta(in terms, term_id));
        s(inout out, in " || ");
        bv_fault(inout out, in terms, tb(in terms, term_id));
        s(inout out, in ")");
        return;
    }
    if term_kind == TM_AND || term_kind == TM_OR {
        s(inout out, in "(");
        bv_fault(inout out, in terms, ta(in terms, term_id));
        s(
            inout out,
            in if term_kind == TM_AND {
                " || ("
            } else {
                " || (!"
            }
        );
        bv_value(inout out, in terms, ta(in terms, term_id));
        s(inout out, in " && ");
        bv_fault(inout out, in terms, tb(in terms, term_id));
        s(inout out, in "))");
        return;
    }
    if term_kind == TM_ITE {
        s(inout out, in "(");
        bv_fault(inout out, in terms, ta(in terms, term_id));
        s(inout out, in " || (bif ");
        bv_value(inout out, in terms, ta(in terms, term_id));
        s(inout out, in " then ");
        bv_fault(inout out, in terms, tb(in terms, term_id));
        s(inout out, in " else ");
        bv_fault(inout out, in terms, tc(in terms, term_id));
        s(inout out, in "))");
        return;
    }
    // Let
    s(inout out, in "(");
    bv_fault(inout out, in terms, tb(in terms, term_id));
    s(inout out, in " || (let ");
    var_name(inout out, in terms, ta(in terms, term_id));
    s(inout out, in " := ");
    bv_value(inout out, in terms, tb(in terms, term_id));
    s(inout out, in "; ");
    bv_fault(inout out, in terms, tc(in terms, term_id));
    s(inout out, in "))");
}

fn bv_type(inout out: ChunkSeq[u8], kind: u8) {
    if kind == K_BOOL {
        s(inout out, in "Bool");
    } else if kind == K_UNIT {
        s(inout out, in "Unit");
    } else {
        s(inout out, in "BitVec ");
        put_u(inout out, width(kind));
    }
}

// `BitVecs::render`; the parameters are the model's first `param_count` variables.
pub fn bitvec(inout out: ChunkSeq[u8], in terms: Tm, root: u32, param_count: u64) {
    let mut binders = ChunkSeq::new[u8]();
    let mut names = ChunkSeq::new[u8]();
    for i in 0..param_count {
        let var_id = wrapping_u32(i);
        s(inout binders, in " (");
        var_name(inout binders, in terms, var_id);
        s(inout binders, in " : ");
        bv_type(inout binders, var_kind(in terms, var_id));
        s(inout binders, in ")");
        if i > 0 {
            s(inout names, in " ");
        }
        var_name(inout names, in terms, var_id);
    }
    let mut fault = ChunkSeq::new[u8]();
    bv_fault(inout fault, in terms, root);
    s(inout out, in "def fault");
    sb(inout out, in binders);
    s(inout out, in " : Bool :=\n  ");
    sb(inout out, in fault);
    s(inout out, in "\ntheorem no_arith_fault_bv : ");
    if param_count > 0 {
        s(inout out, in "∀");
        sb(inout out, in binders);
        s(inout out, in ", ");
    }
    s(inout out, in "fault ");
    sb(inout out, in names);
    s(inout out, in " = false := by\n");
    if param_count > 0 {
        s(inout out, in "  intro ");
        sb(inout out, in names);
        s(inout out, in "\n");
    }
    s(inout out, in "  simp only [fault]\n");
    if !is_text(in fault, in "false") {
        s(inout out, in "  bv_decide\n");
    }
}
