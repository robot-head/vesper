// The source-type side of the proof-lens model (src/lsp/proof_model.rs):
// the names it compares against, the tree accessors, `Kind::of` of a source
// type and `Display`/`Debug` of `ast::Type` for its reasons.

use @vesper/ast::{Ast, TypeNode, EffectsNode, EffectNode, ParamNode, list_len, list_at};
use @vesper-std/arena::{idx_from_raw};
use self::nav::{impl_at, put_name};
use self::lean::{s, K_U8, K_U32, K_U64, K_I64, K_BOOL, K_UNIT, K_NONE};

const NONE: u32 = 4294967295;

const AT_NAMED: u8 = 1;
const AT_TUPLE: u8 = 2;
const AT_FUNCTION: u8 = 3;
const AT_ROW: u8 = 4;
const AT_INFER: u8 = 5;

// Symbols of the names the model compares against (NONE when the text
// never spells them).
pub struct Syms {
    y_u8: u32,
    y_u32: u32,
    y_u64: u32,
    y_i64: u32,
    y_bool: u32,
    y_bool2: u32,
    y_unit: u32,
    y_fail: u32,
    y_overflow: u32,
    y_runtime: u32,
    y_self_: u32,
    y_dyn: u32,
    y_not: u32,
    y_minus: u32,
    y_and: u32,
    y_or: u32,
    y_eq: u32,
    y_ne: u32,
    y_lt: u32,
    y_le: u32,
    y_gt: u32,
    y_ge: u32,
    y_plus: u32,
    y_star: u32,
    y_slash: u32,
    y_percent: u32,
    y_assign: u32,
    y_add_assign: u32,
    y_sub_assign: u32,
    y_mul_assign: u32,
    y_div_assign: u32,
    y_rem_assign: u32
}

pub fn sym(in ast: Ast, in text: Str) -> u32 {
    match ast.names.lookup(in text) {
        Option::Some(found) => found.id(),
        Option::None => NONE,
    }
}

pub fn syms(in ast: Ast) -> Syms {
    Syms {
        y_u8: sym(in ast, in "u8"),
        y_u32: sym(in ast, in "u32"),
        y_u64: sym(in ast, in "u64"),
        y_i64: sym(in ast, in "i64"),
        y_bool: sym(in ast, in "bool"),
        y_bool2: sym(in ast, in "Bool"),
        y_unit: sym(in ast, in "Unit"),
        y_fail: sym(in ast, in "Fail"),
        y_overflow: sym(in ast, in "ArithOverflow"),
        y_runtime: sym(in ast, in "RuntimeError"),
        y_self_: sym(in ast, in "self"),
        y_dyn: sym(in ast, in "dyn"),
        y_not: sym(in ast, in "!"),
        y_minus: sym(in ast, in "-"),
        y_and: sym(in ast, in "&&"),
        y_or: sym(in ast, in "||"),
        y_eq: sym(in ast, in "=="),
        y_ne: sym(in ast, in "!="),
        y_lt: sym(in ast, in "<"),
        y_le: sym(in ast, in "<="),
        y_gt: sym(in ast, in ">"),
        y_ge: sym(in ast, in ">="),
        y_plus: sym(in ast, in "+"),
        y_star: sym(in ast, in "*"),
        y_slash: sym(in ast, in "/"),
        y_percent: sym(in ast, in "%"),
        y_assign: sym(in ast, in "="),
        y_add_assign: sym(in ast, in "+="),
        y_sub_assign: sym(in ast, in "-="),
        y_mul_assign: sym(in ast, in "*="),
        y_div_assign: sym(in ast, in "/="),
        y_rem_assign: sym(in ast, in "%=")
    }
}

// ------------------------------------------------------------ trees

pub fn ty_at(in ast: Ast, i: u32) -> TypeNode {
    ast.types.get_or(
        idx_from_raw[TypeNode](i),
        TypeNode { kind: AT_INFER, a: NONE, b: NONE, c: NONE, d: NONE }
    )
}

pub fn effects_at(in ast: Ast, i: u32) -> EffectsNode {
    ast.effects.get_or(idx_from_raw[EffectsNode](i), EffectsNode { instances: NONE, tail: NONE })
}

pub fn effect_at(in ast: Ast, i: u32) -> EffectNode {
    ast.effect_nodes
        .get_or(idx_from_raw[EffectNode](i), EffectNode { label: NONE, name: NONE, args: NONE })
}

// `Kind::of` of a source type.
pub fn kind_of_type(in ast: Ast, in symbols: Syms, ty: u32) -> u8 {
    let node = ty_at(in ast, ty);
    if node.kind == AT_NAMED && list_len(in ast, node.b) == 0 {
        let name_sym = node.a;
        if name_sym == NONE {
            K_NONE
        } else if name_sym == symbols.y_u8 {
            K_U8
        } else if name_sym == symbols.y_u32 {
            K_U32
        } else if name_sym == symbols.y_u64 {
            K_U64
        } else if name_sym == symbols.y_i64 {
            K_I64
        } else if name_sym == symbols.y_bool || name_sym == symbols.y_bool2 {
            K_BOOL
        } else if name_sym == symbols.y_unit {
            K_UNIT
        } else {
            K_NONE
        }
    } else if node.kind == AT_TUPLE && list_len(in ast, node.a) == 0 {
        K_UNIT
    } else {
        K_NONE
    }
}

pub fn is_infer(in ast: Ast, ty: u32) -> bool {
    ty == NONE || ty_at(in ast, ty).kind == AT_INFER
}

// `Display for Type`.
pub fn display(inout out: ChunkSeq[u8], in ast: Ast, in symbols: Syms, ty: u32) {
    let node = ty_at(in ast, ty);
    if node.kind == AT_NAMED {
        let arg_count = list_len(in ast, node.b);
        if node.a == symbols.y_dyn && node.a != NONE && arg_count == 1 {
            s(inout out, in "dyn ");
            display(inout out, in ast, in symbols, list_at(in ast, node.b, 0));
            return;
        }
        put_name(inout out, in ast, node.a);
        if arg_count > 0 {
            s(inout out, in "[");
            for i in 0..arg_count {
                if i > 0 {
                    s(inout out, in ", ");
                }
                display(inout out, in ast, in symbols, list_at(in ast, node.b, i));
            }
            s(inout out, in "]");
        }
    } else if node.kind == AT_TUPLE {
        s(inout out, in "(");
        for i in 0..list_len(in ast, node.a) {
            if i > 0 {
                s(inout out, in ", ");
            }
            display(inout out, in ast, in symbols, list_at(in ast, node.a, i));
        }
        s(inout out, in ")");
    } else if node.kind == AT_FUNCTION {
        s(inout out, in "fn(");
        let arg_count = list_len(in ast, node.a) >> 1;
        for i in 0..arg_count {
            if i > 0 {
                s(inout out, in ", ");
            }
            display(
                inout out,
                in ast,
                in symbols,
                list_at(in ast, node.a, wrapping_add(wrapping_add(i, i), 1))
            );
        }
        s(inout out, in ") -> ");
        display(inout out, in ast, in symbols, node.b);
    } else if node.kind == AT_ROW {
        s(inout out, in "eff ");
        effects_debug(inout out, in ast, in symbols, node.a);
    } else {
        s(inout out, in "_");
    }
}

pub fn put_quoted(inout out: ChunkSeq[u8], in ast: Ast, name: u32) {
    s(inout out, in "\"");
    put_name(inout out, in ast, name);
    s(inout out, in "\"");
}

pub fn pass_debug(pass: u32) -> Str {
    if pass == 1 {
        "Inout"
    } else if pass == 2 {
        "Sink"
    } else {
        "In"
    }
}

pub fn mode_debug(mode: u32) -> Str {
    if mode == 1 {
        "Affine"
    } else if mode == 2 {
        "Linear"
    } else {
        "Copy"
    }
}

// `Debug for Type` (inside `eff {:?}`).
pub fn type_debug(inout out: ChunkSeq[u8], in ast: Ast, in symbols: Syms, ty: u32) {
    let node = ty_at(in ast, ty);
    if node.kind == AT_NAMED {
        s(inout out, in "Named(");
        put_quoted(inout out, in ast, node.a);
        s(inout out, in ", [");
        for i in 0..list_len(in ast, node.b) {
            if i > 0 {
                s(inout out, in ", ");
            }
            type_debug(inout out, in ast, in symbols, list_at(in ast, node.b, i));
        }
        s(inout out, in "])");
    } else if node.kind == AT_TUPLE {
        s(inout out, in "Tuple([");
        for i in 0..list_len(in ast, node.a) {
            if i > 0 {
                s(inout out, in ", ");
            }
            type_debug(inout out, in ast, in symbols, list_at(in ast, node.a, i));
        }
        s(inout out, in "])");
    } else if node.kind == AT_FUNCTION {
        s(inout out, in "Function { params: [");
        let param_count = list_len(in ast, node.a) >> 1;
        for i in 0..param_count {
            if i > 0 {
                s(inout out, in ", ");
            }
            let at = wrapping_add(i, i);
            s(inout out, in "(");
            s(inout out, in pass_debug(list_at(in ast, node.a, at)));
            s(inout out, in ", ");
            type_debug(inout out, in ast, in symbols, list_at(in ast, node.a, wrapping_add(at, 1)));
            s(inout out, in ")");
        }
        s(inout out, in "], result: ");
        type_debug(inout out, in ast, in symbols, node.b);
        s(inout out, in ", effects: ");
        effects_debug(inout out, in ast, in symbols, node.c);
        s(inout out, in ", mode: ");
        s(inout out, in mode_debug(node.d));
        s(inout out, in " }");
    } else if node.kind == AT_ROW {
        s(inout out, in "Row(");
        effects_debug(inout out, in ast, in symbols, node.a);
        s(inout out, in ")");
    } else {
        s(inout out, in "Infer");
    }
}

pub fn effects_debug(inout out: ChunkSeq[u8], in ast: Ast, in symbols: Syms, effects_id: u32) {
    let effects = effects_at(in ast, effects_id);
    s(inout out, in "Effects { instances: [");
    for i in 0..list_len(in ast, effects.instances) {
        if i > 0 {
            s(inout out, in ", ");
        }
        let instance = effect_at(in ast, list_at(in ast, effects.instances, i));
        s(inout out, in "Effect { label: ");
        if instance.label == NONE {
            s(inout out, in "None");
        } else {
            s(inout out, in "Some(");
            put_quoted(inout out, in ast, instance.label);
            s(inout out, in ")");
        }
        s(inout out, in ", name: ");
        put_quoted(inout out, in ast, instance.name);
        s(inout out, in ", args: [");
        for j in 0..list_len(in ast, instance.args) {
            if j > 0 {
                s(inout out, in ", ");
            }
            type_debug(inout out, in ast, in symbols, list_at(in ast, instance.args, j));
        }
        s(inout out, in "] }");
    }
    s(inout out, in "], tail: ");
    if effects.tail == NONE {
        s(inout out, in "None");
    } else {
        s(inout out, in "Some(");
        put_quoted(inout out, in ast, effects.tail);
        s(inout out, in ")");
    }
    s(inout out, in " }");
}

// A parameter's type as the world holds it: `self: _` of a method is the
// impl's type.
pub fn param_type(in ast: Ast, in symbols: Syms, param: ParamNode, impl_id: u32) -> u32 {
    if impl_id != NONE
        && param.name == symbols.y_self_
        && param.name != NONE
        && is_infer(in ast, param.ty)
    {
        impl_at(in ast, impl_id).ty
    } else {
        param.ty
    }
}
