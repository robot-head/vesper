// The source-type side of the proof-lens model (src/lsp/proof_model.rs):
// the names it compares against, the tree accessors, `Kind::of` of a source
// type and `Display`/`Debug` of `ast::Type` for its reasons.

use @vesper/ast::{Ast, TypeNode, EffectsNode, EffectNode, ParamNode, list_len, list_at};
use @vesper-std/arena::{idx_from_raw};
use self::nav::{impl_at, put_name};
use self::lean::{s, K_U8, K_U32, K_U64, K_I64, K_BOOL, K_UNIT, K_NONE};

const NONE: u32 = 4294967295;

const AT_NAMED: u8 = 1;
const AT_TUPLE: u8 = 2;
const AT_FUNCTION: u8 = 3;
const AT_ROW: u8 = 4;
const AT_INFER: u8 = 5;

// Symbols of the names the model compares against (NONE when the text
// never spells them).
pub struct Syms {
    y_u8: u32,
    y_u32: u32,
    y_u64: u32,
    y_i64: u32,
    y_bool: u32,
    y_bool2: u32,
    y_unit: u32,
    y_fail: u32,
    y_overflow: u32,
    y_runtime: u32,
    y_self_: u32,
    y_dyn: u32,
    y_not: u32,
    y_minus: u32,
    y_and: u32,
    y_or: u32,
    y_eq: u32,
    y_ne: u32,
    y_lt: u32,
    y_le: u32,
    y_gt: u32,
    y_ge: u32,
    y_plus: u32,
    y_star: u32,
    y_slash: u32,
    y_percent: u32,
    y_assign: u32,
    y_add_assign: u32,
    y_sub_assign: u32,
    y_mul_assign: u32,
    y_div_assign: u32,
    y_rem_assign: u32
}

pub fn sym(in a: Ast, in t: Str) -> u32 {
    match a.names.lookup(in t) {
        Option::Some(x) => x.id(),
        Option::None => NONE,
    }
}

pub fn syms(in a: Ast) -> Syms {
    Syms {
        y_u8: sym(in a, in "u8"),
        y_u32: sym(in a, in "u32"),
        y_u64: sym(in a, in "u64"),
        y_i64: sym(in a, in "i64"),
        y_bool: sym(in a, in "bool"),
        y_bool2: sym(in a, in "Bool"),
        y_unit: sym(in a, in "Unit"),
        y_fail: sym(in a, in "Fail"),
        y_overflow: sym(in a, in "ArithOverflow"),
        y_runtime: sym(in a, in "RuntimeError"),
        y_self_: sym(in a, in "self"),
        y_dyn: sym(in a, in "dyn"),
        y_not: sym(in a, in "!"),
        y_minus: sym(in a, in "-"),
        y_and: sym(in a, in "&&"),
        y_or: sym(in a, in "||"),
        y_eq: sym(in a, in "=="),
        y_ne: sym(in a, in "!="),
        y_lt: sym(in a, in "<"),
        y_le: sym(in a, in "<="),
        y_gt: sym(in a, in ">"),
        y_ge: sym(in a, in ">="),
        y_plus: sym(in a, in "+"),
        y_star: sym(in a, in "*"),
        y_slash: sym(in a, in "/"),
        y_percent: sym(in a, in "%"),
        y_assign: sym(in a, in "="),
        y_add_assign: sym(in a, in "+="),
        y_sub_assign: sym(in a, in "-="),
        y_mul_assign: sym(in a, in "*="),
        y_div_assign: sym(in a, in "/="),
        y_rem_assign: sym(in a, in "%=")
    }
}

// ------------------------------------------------------------ trees

pub fn ty_at(in a: Ast, i: u32) -> TypeNode {
    a
        .types
        .get_or(
            idx_from_raw[TypeNode](i),
            TypeNode {
                kind: AT_INFER,
                a: NONE,
                b: NONE,
                c: NONE,
                d: NONE
            }
        )
}

pub fn effects_at(in a: Ast, i: u32) -> EffectsNode {
    a
        .effects
        .get_or(
            idx_from_raw[EffectsNode](i),
            EffectsNode {
                instances: NONE,
                tail: NONE
            }
        )
}

pub fn effect_at(in a: Ast, i: u32) -> EffectNode {
    a
        .effect_nodes
        .get_or(
            idx_from_raw[EffectNode](i),
            EffectNode {
                label: NONE,
                name: NONE,
                args: NONE
            }
        )
}

// `Kind::of` of a source type.
pub fn kind_of_type(in a: Ast, in y: Syms, ty: u32) -> u8 {
    let n = ty_at(in a, ty);
    if n.kind == AT_NAMED && list_len(in a, n.b) == 0 {
        let x = n.a;
        if x == NONE {
            K_NONE
        } else if x == y.y_u8 {
            K_U8
        } else if x == y.y_u32 {
            K_U32
        } else if x == y.y_u64 {
            K_U64
        } else if x == y.y_i64 {
            K_I64
        } else if x == y.y_bool || x == y.y_bool2 {
            K_BOOL
        } else if x == y.y_unit {
            K_UNIT
        } else {
            K_NONE
        }
    } else if n.kind == AT_TUPLE && list_len(in a, n.a) == 0 {
        K_UNIT
    } else {
        K_NONE
    }
}

pub fn is_infer(in a: Ast, ty: u32) -> bool {
    ty == NONE || ty_at(in a, ty).kind == AT_INFER
}

// `Display for Type`.
pub fn display(inout o: ChunkSeq[u8], in a: Ast, in y: Syms, ty: u32) {
    let n = ty_at(in a, ty);
    if n.kind == AT_NAMED {
        let k = list_len(in a, n.b);
        if n.a == y.y_dyn && n.a != NONE && k == 1 {
            s(inout o, in "dyn ");
            display(inout o, in a, in y, list_at(in a, n.b, 0));
            return;
        }
        put_name(inout o, in a, n.a);
        if k > 0 {
            s(inout o, in "[");
            for i in 0..k {
                if i > 0 {
                    s(inout o, in ", ");
                }
                display(inout o, in a, in y, list_at(in a, n.b, i));
            }
            s(inout o, in "]");
        }
    } else if n.kind == AT_TUPLE {
        s(inout o, in "(");
        for i in 0..list_len(in a, n.a) {
            if i > 0 {
                s(inout o, in ", ");
            }
            display(inout o, in a, in y, list_at(in a, n.a, i));
        }
        s(inout o, in ")");
    } else if n.kind == AT_FUNCTION {
        s(inout o, in "fn(");
        let k = list_len(in a, n.a) >> 1;
        for i in 0..k {
            if i > 0 {
                s(inout o, in ", ");
            }
            display(inout o, in a, in y, list_at(in a, n.a, wrapping_add(wrapping_add(i, i), 1)));
        }
        s(inout o, in ") -> ");
        display(inout o, in a, in y, n.b);
    } else if n.kind == AT_ROW {
        s(inout o, in "eff ");
        effects_debug(inout o, in a, in y, n.a);
    } else {
        s(inout o, in "_");
    }
}

pub fn put_quoted(inout o: ChunkSeq[u8], in a: Ast, name: u32) {
    s(inout o, in "\"");
    put_name(inout o, in a, name);
    s(inout o, in "\"");
}

pub fn pass_debug(p: u32) -> Str {
    if p == 1 {
        "Inout"
    } else if p == 2 {
        "Sink"
    } else {
        "In"
    }
}

pub fn mode_debug(m: u32) -> Str {
    if m == 1 {
        "Affine"
    } else if m == 2 {
        "Linear"
    } else {
        "Copy"
    }
}

// `Debug for Type` (inside `eff {:?}`).
pub fn type_debug(inout o: ChunkSeq[u8], in a: Ast, in y: Syms, ty: u32) {
    let n = ty_at(in a, ty);
    if n.kind == AT_NAMED {
        s(inout o, in "Named(");
        put_quoted(inout o, in a, n.a);
        s(inout o, in ", [");
        for i in 0..list_len(in a, n.b) {
            if i > 0 {
                s(inout o, in ", ");
            }
            type_debug(inout o, in a, in y, list_at(in a, n.b, i));
        }
        s(inout o, in "])");
    } else if n.kind == AT_TUPLE {
        s(inout o, in "Tuple([");
        for i in 0..list_len(in a, n.a) {
            if i > 0 {
                s(inout o, in ", ");
            }
            type_debug(inout o, in a, in y, list_at(in a, n.a, i));
        }
        s(inout o, in "])");
    } else if n.kind == AT_FUNCTION {
        s(inout o, in "Function { params: [");
        let k = list_len(in a, n.a) >> 1;
        for i in 0..k {
            if i > 0 {
                s(inout o, in ", ");
            }
            let at = wrapping_add(i, i);
            s(inout o, in "(");
            s(inout o, in pass_debug(list_at(in a, n.a, at)));
            s(inout o, in ", ");
            type_debug(inout o, in a, in y, list_at(in a, n.a, wrapping_add(at, 1)));
            s(inout o, in ")");
        }
        s(inout o, in "], result: ");
        type_debug(inout o, in a, in y, n.b);
        s(inout o, in ", effects: ");
        effects_debug(inout o, in a, in y, n.c);
        s(inout o, in ", mode: ");
        s(inout o, in mode_debug(n.d));
        s(inout o, in " }");
    } else if n.kind == AT_ROW {
        s(inout o, in "Row(");
        effects_debug(inout o, in a, in y, n.a);
        s(inout o, in ")");
    } else {
        s(inout o, in "Infer");
    }
}

pub fn effects_debug(inout o: ChunkSeq[u8], in a: Ast, in y: Syms, e: u32) {
    let es = effects_at(in a, e);
    s(inout o, in "Effects { instances: [");
    for i in 0..list_len(in a, es.instances) {
        if i > 0 {
            s(inout o, in ", ");
        }
        let x = effect_at(in a, list_at(in a, es.instances, i));
        s(inout o, in "Effect { label: ");
        if x.label == NONE {
            s(inout o, in "None");
        } else {
            s(inout o, in "Some(");
            put_quoted(inout o, in a, x.label);
            s(inout o, in ")");
        }
        s(inout o, in ", name: ");
        put_quoted(inout o, in a, x.name);
        s(inout o, in ", args: [");
        for j in 0..list_len(in a, x.args) {
            if j > 0 {
                s(inout o, in ", ");
            }
            type_debug(inout o, in a, in y, list_at(in a, x.args, j));
        }
        s(inout o, in "] }");
    }
    s(inout o, in "], tail: ");
    if es.tail == NONE {
        s(inout o, in "None");
    } else {
        s(inout o, in "Some(");
        put_quoted(inout o, in a, es.tail);
        s(inout o, in ")");
    }
    s(inout o, in " }");
}

// A parameter's type as the world holds it: `self: _` of a method is the
// impl's type.
pub fn param_type(in a: Ast, in y: Syms, p: ParamNode, imp: u32) -> u32 {
    if imp != NONE && p.name == y.y_self_ && p.name != NONE && is_infer(in a, p.ty) {
        impl_at(in a, imp).ty
    } else {
        p.ty
    }
}
