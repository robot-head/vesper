// @vesper/lsp-features: the editor features of `vesper lsp` (src/lsp/**)
// in Vesper (self-hosting wave SH5 lane 17, #1340). Rust stays the
// default; tests/self_host_lsp_features.rs compares these entries with the
// Rust server.
//
// - nav.ves: navigation (src/lsp/navigation.rs): the lexical index,
//   document symbols, workspace symbols and definition.
// - doc_links.ves: the documentation-link fallback of definition.
// - hover.ves: hover (`navigation::hover`) over the checker's facts.
// - json.ves: serde_json's compact writer for those responses.
//
// Every entry takes the harness input (little-endian words, then text)
// and returns its answer packed by `pack`: `R` and the JSON-RPC result,
// `E` and the JSON-RPC error object the session sends, or `D` for a
// definition left to the documentation-link fallback (not ported yet).

use @vesper/span::{Limits};
use @vesper/span::Error as SpanError;
use self::json::{put, put_bytes, put_u64, put_string, pack};
use @vesper/check-data::input::{Ctx, Reader as CtxReader, read_ctx};
use self::doc_links::{DocFacts, WordReader, doc_facts_new, doc_target, read_doc_facts};
use self::proof::{proof_models};
use self::ownership::{lens_facts, lens_requests, lens_view};
use self::repair::{lens_repair};
use self::proof_lenses::{proof_lenses};
use self::lens_state::{lens_state};
use self::anvil::{anvil_actions};
use self::macro_preview::{macro_preview, tree_new};
use self::recovery::{recovery_gate};
use self::signature::{signature};
use self::hover::{Facts, facts_new, fact_function, fact_param, hover_answer};
use self::nav::{
    Ix, MAX_DOCUMENTS, MAX_OUTPUT_BYTES, MAX_QUERY_BYTES, MAX_SYMBOLS, MAX_URI_BYTES, ERR_NONE,
    ERR_DOCUMENTS_QUERY, ERR_OUTPUT_BYTES, ERR_SYMBOLS, ERR_URI_BYTES, ERR_POSITION,
    ERR_INVALID_SPAN, cursor, decl_count, decl_kind, decl_name, decl_name_len, decl_selection,
    decl_span, in_doc_comment, index_new, ix_contains, ix_err, ix_span_err, node_target, put_error,
    put_name_string, put_source_range, reindex
};

copy struct Reader {
    pos: u64
}

fn word(in bytes: Slice[u8], inout reader: Reader) -> u64 {
    let value = bytes.try_read_u64_le(reader.pos).unwrap_or(0);
    reader.pos = wrapping_add(reader.pos, 8);
    value
}

// The ten words of `vesper_span::Limits`, in field order.
fn read_index(in bytes: Slice[u8], inout reader: Reader) -> Limits {
    Limits {
        max_source_bytes: narrow_usize(word(in bytes, inout reader)),
        max_lines: narrow_usize(word(in bytes, inout reader)),
        max_metadata_bytes: narrow_usize(word(in bytes, inout reader)),
        max_work: narrow_usize(word(in bytes, inout reader)),
        max_edits: narrow_usize(word(in bytes, inout reader)),
        max_output_bytes: narrow_usize(word(in bytes, inout reader)),
        max_diagnostics: narrow_usize(word(in bytes, inout reader)),
        max_labels: narrow_usize(word(in bytes, inout reader)),
        max_fixes: narrow_usize(word(in bytes, inout reader)),
        max_text_bytes: narrow_usize(word(in bytes, inout reader))
    }
}

// The input text `off .. off + len` as a `String` (the harness writes only
// UTF-8 there).
fn text_at(in bytes: Slice[u8], off: u64, len: u64) -> String {
    match String::from_utf8(in bytes[off..wrapping_add(off, len)]) {
        Option::Some(text) => text,
        Option::None => String::new(),
    }
}

fn error(code: u64, e: SpanError) -> ChunkSeq[u64] {
    let mut out = ChunkSeq::new[u8]();
    out.push(69);
    put_error(inout out, code, e);
    pack(in out.as_slice())
}

fn plain_error(code: u64) -> ChunkSeq[u64] {
    error(code, SpanError::InvalidLimits)
}

fn uri_ok(in uri: Str) -> bool {
    uri.len() != 0 && uri.len() <= MAX_URI_BYTES
}

// One `document_symbols` value: `{"kind","name","range","selectionRange"}`,
// or with `legacy` the session's `SymbolInformation` form
// `{"kind","location":{"range","uri"},"name"}` (the full range).
fn symbol(inout out: ChunkSeq[u8], inout index: Ix, i: u64, in uri: Str, legacy: bool) -> bool {
    let (start, end) = decl_span(in index, i);
    put(inout out, in "{\"kind\":");
    put_u64(inout out, decl_kind(in index, i));
    if legacy {
        put(inout out, in ",\"location\":{\"range\":");
        if !put_source_range(inout out, inout index, start, end) {
            return false;
        }
        put(inout out, in ",\"uri\":");
        put_string(inout out, in uri.as_bytes());
        put(inout out, in "},\"name\":");
        put_name_string(inout out, in index, decl_name(in index, i));
        out.push(125);
        return true;
    }
    put(inout out, in ",\"name\":");
    put_name_string(inout out, in index, decl_name(in index, i));
    put(inout out, in ",\"range\":");
    if !put_source_range(inout out, inout index, start, end) {
        return false;
    }
    let (sel_start, sel_end) = decl_selection(in index, i);
    put(inout out, in ",\"selectionRange\":");
    if !put_source_range(inout out, inout index, sel_start, sel_end) {
        return false;
    }
    out.push(125);
    true
}

// The answer to one `textDocument/documentSymbol` request on `index`, in the
// hierarchical shape or the session's legacy `SymbolInformation` shape,
// appended to `out` as `R<json>` or `E<error>`.
fn symbols_answer(inout out: ChunkSeq[u8], inout index: Ix, in uri: Str, hierarchical: bool) {
    if ix_err(in index) != ERR_NONE {
        put_error_answer(inout out, ix_err(in index), ix_span_err(in index));
        return;
    }
    let mut remaining = MAX_OUTPUT_BYTES;
    let mut total: u64 = 2;
    let mut body = ChunkSeq::new[u8]();
    body.push(91);
    let mut symbol_json = ChunkSeq::new[u8]();
    for i in 0..decl_count(in index) {
        if decl_name_len(in index, i) > remaining {
            put_error_answer(inout out, ERR_OUTPUT_BYTES, SpanError::InvalidLimits);
            return;
        }
        symbol_json.clear();
        if !symbol(inout symbol_json, inout index, i, in uri, false) {
            put_error_answer(inout out, ix_err(in index), ix_span_err(in index));
            return;
        }
        let n = symbol_json.len();
        if n >= remaining {
            put_error_answer(inout out, ERR_OUTPUT_BYTES, SpanError::InvalidLimits);
            return;
        }
        remaining = wrapping_sub(remaining, wrapping_add(n, 1));
        if i > 0 {
            body.push(44);
            total = wrapping_add(total, 1);
        }
        total = wrapping_add(total, n);
        if hierarchical {
            put_bytes(inout body, in symbol_json.as_slice());
        } else {
            symbol_json.clear();
            if !symbol(inout symbol_json, inout index, i, in uri, true) {
                put_error_answer(inout out, ix_err(in index), ix_span_err(in index));
                return;
            }
            put_bytes(inout body, in symbol_json.as_slice());
        }
    }
    if total > MAX_OUTPUT_BYTES {
        put_error_answer(inout out, ERR_OUTPUT_BYTES, SpanError::InvalidLimits);
        return;
    }
    body.push(93);
    out.push(82);
    put_bytes(inout out, in body.as_slice());
}

// Task "symbols": the ten index-limit words, the shape (1 hierarchical, 0
// the legacy `SymbolInformation`), the URI length and the source length,
// then the URI and the source. `textDocument/documentSymbol`.
pub fn lsp_document_symbols(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mut reader = Reader { pos: 0 };
    let limits = read_index(in bytes, inout reader);
    let hierarchical = word(in bytes, inout reader) == 1;
    let uri_len = word(in bytes, inout reader);
    let src_len = word(in bytes, inout reader);
    let uri = text_at(in bytes, reader.pos, uri_len);
    let src = text_at(in bytes, wrapping_add(reader.pos, uri_len), src_len);
    let mut index = index_new(src, in limits);
    let mut out = ChunkSeq::new[u8]();
    symbols_answer(inout out, inout index, in uri, hierarchical);
    pack(in out.as_slice())
}

// Task "symbols kept": the "symbols" words with a repeat count `n` after
// the shape. `n` documentSymbol requests on one parse, the index rebuilt
// for each (the server keeps the parse in its snapshot and builds the
// index per request, as Rust does); the answers are joined by newlines.
pub fn lsp_document_symbols_kept(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mut reader = Reader { pos: 0 };
    let limits = read_index(in bytes, inout reader);
    let hierarchical = word(in bytes, inout reader) == 1;
    let n = word(in bytes, inout reader);
    let uri_len = word(in bytes, inout reader);
    let src_len = word(in bytes, inout reader);
    let uri = text_at(in bytes, reader.pos, uri_len);
    let src = text_at(in bytes, wrapping_add(reader.pos, uri_len), src_len);
    let mut index = index_new(src, in limits);
    let mut out = ChunkSeq::new[u8]();
    for i in 0..n {
        if i > 0 {
            out.push(10);
            if ix_err(in index) == ERR_NONE || ix_err(in index) == ERR_INVALID_SPAN {
                reindex(inout index);
            }
        }
        symbols_answer(inout out, inout index, in uri, hierarchical);
    }
    pack(in out.as_slice())
}

// The answer to one definition request on `index` (after the URI check),
// appended to `out`.
fn definition_answer(
    inout out: ChunkSeq[u8],
    inout index: Ix,
    in uri: Str,
    line: u32,
    character: u32,
    in facts: DocFacts,
    has_facts: bool
) {
    if ix_err(in index) != ERR_NONE {
        put_error_answer(inout out, ix_err(in index), ix_span_err(in index));
        return;
    }
    let mut at: u64 = 0;
    if !cursor(inout index, line, character, inout at) {
        put_error_answer(inout out, ix_err(in index), ix_span_err(in index));
        return;
    }
    let mut target = node_target(in index, at);
    if target == 0 {
        if !in_doc_comment(in index, at) {
            put(inout out, in "Rnull");
            return;
        }
        if !has_facts {
            out.push(68);
            return;
        }
        let mut err = ERR_NONE;
        target = doc_target(in index, in facts, at, inout err);
        if target == 18446744073709551615 {
            put_error_answer(inout out, err, ix_span_err(in index));
            return;
        }
        if target == 0 {
            put(inout out, in "Rnull");
            return;
        }
    }
    let span = wrapping_sub(target, 1);
    let mut location = ChunkSeq::new[u8]();
    put(inout location, in "{\"range\":");
    if !put_source_range(inout location, inout index, span >> 32, span & 4294967295) {
        put_error_answer(inout out, ix_err(in index), ix_span_err(in index));
        return;
    }
    put(inout location, in ",\"uri\":");
    put_string(inout location, in uri.as_bytes());
    location.push(125);
    if location.len() > MAX_OUTPUT_BYTES {
        put_error_answer(inout out, ERR_OUTPUT_BYTES, SpanError::InvalidLimits);
        return;
    }
    out.push(82);
    put_bytes(inout out, in location.as_slice());
}

fn put_error_answer(inout out: ChunkSeq[u8], code: u64, e: SpanError) {
    out.push(69);
    put_error(inout out, code, e);
}

// Task "definition": the ten index-limit words, the line and UTF-16
// character of the cursor, the URI length and the source length, then the
// URI and the source. `textDocument/definition`.
pub fn lsp_definition(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mut reader = Reader { pos: 0 };
    let limits = read_index(in bytes, inout reader);
    let line = wrapping_u32(word(in bytes, inout reader));
    let character = wrapping_u32(word(in bytes, inout reader));
    let uri_len = word(in bytes, inout reader);
    let src_len = word(in bytes, inout reader);
    let uri = text_at(in bytes, reader.pos, uri_len);
    let src = text_at(in bytes, wrapping_add(reader.pos, uri_len), src_len);
    if !uri_ok(in uri) {
        return plain_error(ERR_URI_BYTES);
    }
    let mut index = index_new(src, in limits);
    let mut out = ChunkSeq::new[u8]();
    let none = doc_facts_new();
    definition_answer(inout out, inout index, in uri, line, character, in none, false);
    pack(in out.as_slice())
}

// Task "definitions": `definition` for many cursors on one document whose
// parse is kept, as the server keeps its checked snapshot: the index is
// rebuilt (lexed and traversed) for every request, as Rust does. The input
// is the ten index-limit words, the URI length, the source length and the
// cursor count, then a line and a character per cursor, a word that is 1
// when the documentation-link facts follow (`read_doc_facts`), those facts,
// then the URI and the source. Without the facts a cursor left to the
// documentation-link fallback answers `D`. The answers are joined by
// newlines.
pub fn lsp_definitions(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mut reader = Reader { pos: 0 };
    let limits = read_index(in bytes, inout reader);
    let uri_len = word(in bytes, inout reader);
    let src_len = word(in bytes, inout reader);
    let n = word(in bytes, inout reader);
    let mut cursors = ChunkSeq::new[u64]();
    for i in 0..wrapping_add(n, n) {
        cursors.push(word(in bytes, inout reader));
    }
    // 1 when the documentation-link facts follow (doc_links.ves).
    let has_facts = word(in bytes, inout reader) == 1;
    let mut facts_reader = WordReader { pos: reader.pos };
    let facts = if has_facts {
        read_doc_facts(in bytes, inout facts_reader)
    } else {
        doc_facts_new()
    };
    reader.pos = facts_reader.pos;
    let uri = text_at(in bytes, reader.pos, uri_len);
    let src = text_at(in bytes, wrapping_add(reader.pos, uri_len), src_len);
    let mut out = ChunkSeq::new[u8]();
    let mut index = index_new(src, in limits);
    for i in 0..n {
        if i > 0 {
            out.push(10);
            if ix_err(in index) == ERR_NONE
                || ix_err(in index) == ERR_POSITION
                || ix_err(in index) == ERR_INVALID_SPAN
            {
                reindex(inout index);
            }
        }
        if !uri_ok(in uri) {
            put_error_answer(inout out, ERR_URI_BYTES, SpanError::InvalidLimits);
            continue;
        }
        let line = match cursors.try_get(wrapping_add(i, i)) {
            Option::Some(v) => wrapping_u32(v),
            Option::None => 0,
        };
        let character = match cursors.try_get(wrapping_add(wrapping_add(i, i), 1)) {
            Option::Some(v) => wrapping_u32(v),
            Option::None => 0,
        };
        definition_answer(inout out, inout index, in uri, line, character, in facts, has_facts);
    }
    pack(in out.as_slice())
}

// Task "workspace": the ten index-limit words, the query length and the
// document count, then per document its URI length and source length,
// then the query and each document's URI and source, in the store's
// order. `workspace/symbol`.
pub fn lsp_workspace_symbols(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mut reader = Reader { pos: 0 };
    let limits = read_index(in bytes, inout reader);
    let query_len = word(in bytes, inout reader);
    let docs = word(in bytes, inout reader);
    let mut lens = ChunkSeq::new[u64]();
    for i in 0..wrapping_add(docs, docs) {
        lens.push(word(in bytes, inout reader));
    }
    if docs > MAX_DOCUMENTS || query_len > MAX_QUERY_BYTES {
        return plain_error(ERR_DOCUMENTS_QUERY);
    }
    let query = bytes[reader.pos..wrapping_add(reader.pos, query_len)];
    let mut at = wrapping_add(reader.pos, query_len);
    let mut remaining = MAX_OUTPUT_BYTES;
    let mut total: u64 = 2;
    let mut count: u64 = 0;
    let mut out = ChunkSeq::new[u8]();
    out.push(82);
    out.push(91);
    for doc_index in 0..docs {
        let uri_len = lens.try_get(wrapping_add(doc_index, doc_index)).unwrap_or(0);
        let src_len = lens.try_get(wrapping_add(wrapping_add(doc_index, doc_index), 1))
            .unwrap_or(0);
        let uri = text_at(in bytes, at, uri_len);
        let src = text_at(in bytes, wrapping_add(at, uri_len), src_len);
        at = wrapping_add(wrapping_add(at, uri_len), src_len);
        if !uri_ok(in uri) {
            return plain_error(ERR_URI_BYTES);
        }
        let mut index = index_new(src, in limits);
        if ix_err(in index) != ERR_NONE {
            return error(ix_err(in index), ix_span_err(in index));
        }
        for i in 0..decl_count(in index) {
            if !ix_contains(in index, i, in query) {
                continue;
            }
            if count >= MAX_SYMBOLS {
                return plain_error(ERR_SYMBOLS);
            }
            if wrapping_add(decl_name_len(in index, i), uri.len()) > remaining {
                return plain_error(ERR_OUTPUT_BYTES);
            }
            let mut symbol_json = ChunkSeq::new[u8]();
            let (sel_start, sel_end) = decl_selection(in index, i);
            put(inout symbol_json, in "{\"kind\":");
            put_u64(inout symbol_json, decl_kind(in index, i));
            put(inout symbol_json, in ",\"location\":{\"range\":");
            if !put_source_range(inout symbol_json, inout index, sel_start, sel_end) {
                return error(ix_err(in index), ix_span_err(in index));
            }
            put(inout symbol_json, in ",\"uri\":");
            put_string(inout symbol_json, in uri.as_bytes());
            put(inout symbol_json, in "},\"name\":");
            put_name_string(inout symbol_json, in index, decl_name(in index, i));
            symbol_json.push(125);
            let n = symbol_json.len();
            if n >= remaining {
                return plain_error(ERR_OUTPUT_BYTES);
            }
            remaining = wrapping_sub(remaining, wrapping_add(n, 1));
            if count > 0 {
                out.push(44);
                total = wrapping_add(total, 1);
            }
            total = wrapping_add(total, n);
            put_bytes(inout out, in symbol_json.as_slice());
            count = wrapping_add(count, 1);
        }
    }
    if total > MAX_OUTPUT_BYTES {
        return plain_error(ERR_OUTPUT_BYTES);
    }
    out.push(93);
    pack(in out.as_slice())
}

// Task "hover": the checker's facts in @vesper/check-data's harness layout
// (names, types, the world section), then the ten index-limit words, the
// function table (count, then per function: name, start, end, whether
// `function_results` has it and that type, the parameter count and per
// parameter start, end, name and type), the cursor count and each cursor's
// line and UTF-16 character, the source length, and the source. One parse;
// the index is rebuilt per request, as the server's `Index::new` is. The
// answers (`R<json>`, `Rnull` or `E<error>`) are joined by newlines.
pub fn lsp_hovers(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mut ctx_reader = CtxReader { pos: 0 };
    let ctx = read_ctx(inout ctx_reader, in bytes);
    let mut reader = Reader { pos: ctx_reader.pos };
    let limits = read_index(in bytes, inout reader);
    let mut facts = facts_new(ctx);
    let fn_count = word(in bytes, inout reader);
    for i in 0..fn_count {
        let name = map_name(in facts, word(in bytes, inout reader));
        let start = word(in bytes, inout reader);
        let end = word(in bytes, inout reader);
        let has_result = word(in bytes, inout reader);
        let result = map_type(in facts, word(in bytes, inout reader));
        fact_function(
            inout facts,
            name,
            start,
            end,
            if has_result == 1 { result } else { 4294967295 }
        );
        let param_count = word(in bytes, inout reader);
        for j in 0..param_count {
            let param_start = word(in bytes, inout reader);
            let param_end = word(in bytes, inout reader);
            let param_name = map_name(in facts, word(in bytes, inout reader));
            let param_ty = map_type(in facts, word(in bytes, inout reader));
            fact_param(inout facts, param_start, param_end, param_name, param_ty);
        }
    }
    let n = word(in bytes, inout reader);
    let mut cursors = ChunkSeq::new[u64]();
    for i in 0..wrapping_add(n, n) {
        cursors.push(word(in bytes, inout reader));
    }
    let src_len = word(in bytes, inout reader);
    let src = text_at(in bytes, reader.pos, src_len);
    let mut out = ChunkSeq::new[u8]();
    let mut index = index_new(src, in limits);
    for i in 0..n {
        if i > 0 {
            out.push(10);
            if ix_err(in index) == ERR_NONE
                || ix_err(in index) == ERR_POSITION
                || ix_err(in index) == ERR_INVALID_SPAN
            {
                reindex(inout index);
            }
        }
        let line = match cursors.try_get(wrapping_add(i, i)) {
            Option::Some(v) => wrapping_u32(v),
            Option::None => 0,
        };
        let character = match cursors.try_get(wrapping_add(wrapping_add(i, i), 1)) {
            Option::Some(v) => wrapping_u32(v),
            Option::None => 0,
        };
        let code = hover_answer(inout out, inout index, inout facts, line, character);
        if code != ERR_NONE {
            put_error_answer(inout out, code, ix_span_err(in index));
        }
    }
    pack(in out.as_slice())
}

fn map_name(in facts: Facts, i: u64) -> u32 {
    facts.ctx.nmap.try_get(i).unwrap_or(4294967295)
}

fn map_type(in facts: Facts, i: u64) -> u32 {
    facts.ctx.tmap.try_get(i).unwrap_or(4294967295)
}

// `proof_model::all` (src/lsp/proof_model.rs): the proof-lens model of
// every checked function with a body (proof.ves).
pub fn lsp_proof_models(in input: Str) -> ChunkSeq[u64] {
    proof_models(in input)
}

// The ownership facts behind Lens views (src/lsp/lens.rs `facts`) and the
// live linear obligations at each cursor (`View::outstanding`;
// ownership.ves).
pub fn lsp_lens_facts(in input: Str) -> ChunkSeq[u64] {
    lens_facts(in input)
}

// The repaired view of syntax-damaged source (src/lsp/lens.rs `repair`;
// repair.ves).
pub fn lsp_lens_repair(in input: Str) -> ChunkSeq[u64] {
    lens_repair(in input)
}

// A Lens view of source with semantic errors, or of a repaired prefix:
// its live obligations read at the cut, the poisoned bindings, resolved
// names and ranked member completions (src/lsp/lens.rs `View::from_text`,
// `poisoned`, `binding`, `complete_member`, `signature`; ownership.ves).
pub fn lsp_lens_view(in input: Str) -> ChunkSeq[u64] {
    lens_view(in input)
}

// The Lens request layer on a document and its view: poison notices and
// Lens metadata, obligation-guided member completion, obligation hovers
// and linear-binding inlay hints (src/lsp/session/lens_requests.rs
// `poison_of`, `completion_of`, `obligation_text_of`, `inlay_hints_of`;
// ownership.ves).
pub fn lsp_lens_requests(in input: Str) -> ChunkSeq[u64] {
    lens_requests(in input)
}

// Proof code lenses, `vesper.proofAudit` command results and background
// `vesper/proofStatus` notifications over the bounded proof ledgers
// (src/lsp/session/lens_requests.rs `code_lenses_of`, `record_of`,
// `proof_result_of`, `proof_status_of`; proof_lenses.ves).
pub fn lsp_proof_lenses(in input: Str) -> ChunkSeq[u64] {
    proof_lenses(in input)
}

// The Lens session's request bookkeeping: the per-document debounce of
// background proof runs, the pending-request table and their cancel tokens
// (crates/vesper-lsp/src/lens.rs `Debouncer`, `PendingRequests`,
// `CancelToken`; lens_state.ves).
pub fn lsp_lens_state(in input: Str) -> ChunkSeq[u64] {
    lens_state(in input)
}

// Task "anvil": the Vesper Anvil code actions (anvil.ves). The input is
// the rounds, the function's line, whether failing arguments are given,
// the URI, source, function name and argument lengths, then those texts.
// The actions are computed `rounds` times; the result is their JSON array.
pub fn lsp_anvil_actions(in input: Str) -> ChunkSeq[u64] {
    let b = input.as_bytes();
    let mut r = Reader { pos: 0 };
    let rounds = word(in b, inout r);
    let fn_line = word(in b, inout r);
    let has_args = word(in b, inout r) == 1;
    let uri_len = word(in b, inout r);
    let src_len = word(in b, inout r);
    let name_len = word(in b, inout r);
    let args_len = word(in b, inout r);
    let uri_at = r.pos;
    let src_at = wrapping_add(uri_at, uri_len);
    let name_at = wrapping_add(src_at, src_len);
    let args_at = wrapping_add(name_at, name_len);
    let args_end = wrapping_add(args_at, args_len);
    let mut out = ChunkSeq::new[u8]();
    for k in 0..rounds {
        anvil_actions(
            inout out,
            in b[uri_at..src_at],
            in b[src_at..name_at],
            in b[name_at..args_at],
            fn_line,
            has_args,
            in b[args_at..args_end]
        );
    }
    pack(in out.as_slice())
}

// Task "macro preview": `vesper/macroPreview` (macro_preview.ves). The
// input is the words of `lsp::macro_preview::port_words`: the rounds,
// then one preview. The answer is computed `rounds` times; the result is
// `E <error>` or the rendered JSON value.
pub fn lsp_macro_preview(in input: Str) -> ChunkSeq[u64] {
    let b = input.as_bytes();
    let mut r = Reader { pos: 0 };
    let rounds = word(in b, inout r);
    let mut out = ChunkSeq::new[u8]();
    let mut tree = tree_new();
    for k in 0..rounds {
        macro_preview(inout out, inout tree, in b, r.pos);
    }
    pack(in out.as_slice())
}

// `recovery::gate_answer`: the recovery gate of a damaged document (#1828
// part 12a), `rounds` times over the words of `recovery::gate_words`.
pub fn lsp_recovery_gate(in input: Str) -> ChunkSeq[u64] {
    let b = input.as_bytes();
    let mut r = Reader { pos: 0 };
    let rounds = word(in b, inout r);
    let mut out = ChunkSeq::new[u8]();
    let mut unavailable = ChunkSeq::new[u64]();
    for k in 0..rounds {
        recovery_gate(inout out, inout unavailable, in b, r.pos);
    }
    pack(in out.as_slice())
}

// `database::signature_answer`: the checked signature snapshot (#1828 part
// 12b), `rounds` times over the words of `database::signature_words`.
pub fn lsp_signature(in input: Str) -> ChunkSeq[u64] {
    let b = input.as_bytes();
    let mut r = Reader { pos: 0 };
    let rounds = word(in b, inout r);
    let mut out = ChunkSeq::new[u8]();
    let mut headers = ChunkSeq::new[u8]();
    let mut keys = ChunkSeq::new[u64]();
    for k in 0..rounds {
        signature(inout out, inout headers, inout keys, in b, r.pos);
    }
    pack(in out.as_slice())
}
