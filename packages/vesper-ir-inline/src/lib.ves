// @vesper/ir-inline: the Place IR inliner of `src/ir_inline.rs` and
// `src/ir_inline/site.rs` (self-hosting SH3 lane 11, #1250).
//
// The whole pass runs here: literal constants, the call graph and its
// cycles (petgraph's Tarjan, node for node), the callee and caller rules,
// the cost model, site folding, partial inlining, the growth budgets and the
// splicing that later decisions read. What the pass asks of the world (a
// type's layout, whether it holds a sequence, a `Box` or a function, a
// function's `fip` flag and the checker's type arguments per call span)
// belongs to other ports; tests/common/inline_words.rs answers it as fact
// bits per type and per function.
//
// The program is decoded into flat pools: instructions, an operand pool, a
// pattern pool, block and function rows whose lists are ranges of an id
// pool. A list that grows (a caller's blocks, locals and values) is moved
// to the end of its pool the first time it grows while something else is
// there (a `ChunkSeq` of structs that own sequences cannot be indexed in
// place until element borrows land, SH2 lane 1).
//
// - `inline_report_words`: the `Report` and every function's size and cost
//   after inlining (`decode_report` in tests/common/inline_words.rs).
// - `inline_dump`: the inlined program as the canonical text `dump` writes.

use @vesper/check-data::util::{add, inc, inc32, n32, push_decimal, u32_at, u64_at, u8_at, w};
use @vesper/check-data::names::{Names, names_new};
use @vesper/check-data::input::{Reader};
use @vesper/check-data::types::{TyPass};

const NONE32: u32 = 4294967295;
const MAX64: u64 = 18446744073709551615;

// Type facts (tests/common/inline_words.rs `type_facts`).
const F_SCALAR: u64 = 1;
const F_AGGREGATE: u64 = 2;
const F_SEQUENCE: u64 = 4;
const F_SLICE: u64 = 8;
const F_BOX: u64 = 16;
const F_FUNCTION: u64 = 32;
const F_PLAIN: u64 = 64;
const F_NEVER: u64 = 128;

// Function facts.
const W_WORLD: u64 = 1;
const W_FIP: u64 = 2;
const W_GENERIC: u64 = 4;
const W_DYN: u64 = 8;
const W_SLOTS: u64 = 16;
const W_CAPTURES: u64 = 32;
const W_BORROWED_MATCH: u64 = 64;

// Instruction flags.
const I_FALLIBLE: u64 = 1;
const I_GENERIC_CALL: u64 = 2;

// Operations.
const O_CONST: u8 = 0;
const O_UNIT: u8 = 1;
const O_LOOP: u8 = 2;
const O_READ: u8 = 3;
const O_BIND: u8 = 4;
const O_WRITE: u8 = 5;
const O_UNARY: u8 = 6;
const O_BINARY: u8 = 7;
const O_INDEX: u8 = 8;
const O_PROJECT: u8 = 9;
const O_TRY: u8 = 10;
const O_TUPLE: u8 = 11;
const O_VECTOR: u8 = 12;
const O_DATA: u8 = 13;
const O_CALL: u8 = 14;
const O_TILED: u8 = 15;
const O_SEQ: u8 = 16;
const O_FIP: u8 = 17;
const O_INDIRECT: u8 = 18;
const O_EXIT: u8 = 19;
const O_HANDLE: u8 = 20;
const O_CLOSURE: u8 = 21;

// Terminators.
const T_RETURN: u8 = 0;
const T_JUMP: u8 = 1;
const T_BRANCH: u8 = 2;
const T_MATCH: u8 = 3;
const T_UNREACHABLE: u8 = 4;

// Pattern kinds.
const PK_WILD: u64 = 0;
const PK_BIND: u64 = 1;
const PK_TUPLE: u64 = 2;
const PK_CTOR: u64 = 3;
const PK_LIT: u64 = 4;

// Literal kinds.
const L_INT: u64 = 0;
const L_BOOL: u64 = 1;

// Refusal reasons (`REASONS` in tests/common/inline_words.rs).
const R_OK: u32 = 4294967295;
const R_RECURSIVE: u32 = 0;
const R_CALLER: u32 = 1;
const R_SIZE: u32 = 2;
const R_GROWTH: u32 = 3;
const R_NOT_WORLD: u32 = 4;
const R_FIP: u32 = 5;
const R_DYN: u32 = 6;
const R_GENERIC_HANDLER: u32 = 7;
const R_GENERIC_TYPES: u32 = 8;
const R_GENERIC_CALLS: u32 = 9;
const R_GENERIC_OPERATORS: u32 = 10;
const R_CAPTURES: u32 = 11;
const R_EFFECT_ROW: u32 = 12;
const R_SLOTS: u32 = 13;
const R_NEVER: u32 = 14;
const R_BORROWED_MATCH: u32 = 15;
const R_ENTRY: u32 = 16;
const R_BOX: u32 = 17;
const R_FUNCTION_TYPE: u32 = 18;
const R_SINK_SLICE: u32 = 19;
const R_CLOSURE: u32 = 20;
const R_TRY: u32 = 21;
const R_INDIRECT: u32 = 22;
const R_TILED: u32 = 23;
const R_FOREIGN_EXIT: u32 = 24;
const R_HANDLER_RETURN: u32 = 25;
const R_SITE_TYPES: u32 = 26;
const R_SITE_UNRECORDED: u32 = 27;
const R_SITE_SIGNATURE: u32 = 28;
const R_SITE_ROW: u32 = 29;
const R_SITE_GENERICS: u32 = 30;
const R_SITE_INOUT: u32 = 31;
const R_SITE_SEQUENCE: u32 = 32;
const R_SITE_FIELD: u32 = 33;
const R_SITE_REBIND: u32 = 34;
const R_SITE_COLD: u32 = 35;
const REASONS: u64 = 36;

// site.rs: smallest cold side worth a call, and what the call adds.
const MIN_COLD: u64 = 16;
const CALL_COST: u64 = 2;
// The fold's round bound.
const FOLD_ROUNDS: u64 = 32;

fn sub(lhs: u64, rhs: u64) -> u64 {
    wrapping_sub(lhs, rhs)
}

fn n8(value: u64) -> u8 {
    wrapping_u8(value)
}

// ----- tables -------------------------------------------------------------------

pub copy struct Inst {
    dest: u32,
    ty: u32,
    span_start: u64,
    span_end: u64,
    flags: u64,
    opaque: u32,
    op: u8,
    // operands: ops[ops_at..]
    ops_at: u32,
}

pub copy struct Blk {
    // block parameters: ids[param_start..param_start+param_count]
    param_start: u32,
    param_count: u32,
    // instruction ids: ids[inst_start..inst_start+inst_count]
    inst_start: u32,
    inst_count: u32,
    term: u8,
    // terminator operands: ops[term_at..]
    term_at: u32,
}

pub copy struct ParamRow {
    name: u32,
    pass: u64,
    ty: u32,
}

pub copy struct Fun {
    name: u32,
    flags: u64,
    result_ty: u32,
    row: u32,
    // parameters: params[param_start..param_start+param_count]
    param_start: u32,
    param_count: u32,
    // bound names: ids[bound_start..bound_start+bound_count]
    bound_start: u32,
    bound_count: u32,
    // locals: local_names/local_types[local_start..local_start+local_count]
    local_start: u32,
    local_count: u32,
    // value types, by id: value_types[value_start+id] is the type + 1 (0: none)
    value_start: u32,
    value_count: u32,
    // block ids: fun_block_ids[block_start..block_start+block_count]
    block_start: u32,
    block_count: u32,
}

// A generic call site's type arguments (`instance`).
pub copy struct Instance {
    callee: u32,
    span_start: u64,
    span_end: u64,
    has_types: bool,
    // substitution pairs: sub_from/sub_to[pair_start..pair_start+pair_count], sorted by `from`
    pair_start: u32,
    pair_count: u32,
    row: u32,
}

// What a site inlines: a program function, or an instance of a generic one.
pub copy struct Tgt {
    fun_index: u32,
    // instance index, or NONE32
    instance: u32,
}

// An open-addressing map from u64 keys to u32 values.
pub struct MapU {
    keys: ChunkSeq[u64],
    values: ChunkSeq[u32],
    used: ChunkSeq[u8],
    mask: u64,
    count: u64,
}

pub fn map_new(cap: u64) -> MapU {
    let mut keys: ChunkSeq[u64] = ChunkSeq::new[u64]();
    keys.resize(cap, 0);
    let mut values: ChunkSeq[u32] = ChunkSeq::new[u32]();
    values.resize(cap, 0);
    let mut used: ChunkSeq[u8] = ChunkSeq::new[u8]();
    used.resize(cap, 0);
    MapU { keys: keys, values: values, used: used, mask: sub(cap, 1), count: 0 }
}

fn hash64(key: u64) -> u64 {
    let mixed = wrapping_mul(key ^ (key >> 29), 11400714819323198485);
    mixed ^ (mixed >> 32)
}

impl MapU {
    pub fn get(in self, key: u64) -> u32 {
        let mut at = hash64(key) & self.mask;
        loop {
            if u8_at(in self.used, at) == 0 {
                return NONE32;
            }
            if u64_at(in self.keys, at) == key {
                return u32_at(in self.values, at);
            }
            at = inc(at) & self.mask;
        }
    }

    fn grow(inout self) {
        let cap = wrapping_mul(inc(self.mask), 2);
        let mut bigger = map_new(cap);
        for i in 0..inc(self.mask) {
            if u8_at(in self.used, i) != 0 {
                bigger.set(u64_at(in self.keys, i), u32_at(in self.values, i));
            }
        }
        self.keys = bigger.keys;
        self.values = bigger.values;
        self.used = bigger.used;
        self.mask = bigger.mask;
        self.count = bigger.count;
    }

    pub fn set(inout self, key: u64, value: u32) {
        let mut at = hash64(key) & self.mask;
        loop {
            if u8_at(in self.used, at) == 0 {
                break;
            }
            if u64_at(in self.keys, at) == key {
                let ok = self.values.try_set(at, value);
                return;
            }
            at = inc(at) & self.mask;
        }
        let ok1 = self.keys.try_set(at, key);
        let ok2 = self.values.try_set(at, value);
        let ok3 = self.used.try_set(at, 1);
        self.count = inc(self.count);
        if wrapping_mul(self.count, 2) > self.mask {
            self.grow();
        }
    }

    pub fn clear(inout self) {
        if self.count == 0 {
            return;
        }
        for i in 0..inc(self.mask) {
            let ok = self.used.try_set(i, 0);
        }
        self.count = 0;
    }
}

fn pair(high: u32, low: u32) -> u64 {
    wrapping_add(wrapping_mul(w(high), 4294967296), w(low))
}

fn set_u8(inout seq: ChunkSeq[u8], i: u64, value: u8) {
    let ok = seq.try_set(i, value);
}

fn set_u32(inout seq: ChunkSeq[u32], i: u64, value: u32) {
    let ok = seq.try_set(i, value);
}

fn set_u64(inout seq: ChunkSeq[u64], i: u64, value: u64) {
    let ok = seq.try_set(i, value);
}

fn zeros8(n: u64) -> ChunkSeq[u8] {
    let mut seq: ChunkSeq[u8] = ChunkSeq::new[u8]();
    seq.resize(n, 0);
    seq
}

fn fill32(n: u64, fill: u32) -> ChunkSeq[u32] {
    let mut seq: ChunkSeq[u32] = ChunkSeq::new[u32]();
    seq.resize(n, fill);
    seq
}

fn zeros64(n: u64) -> ChunkSeq[u64] {
    let mut seq: ChunkSeq[u64] = ChunkSeq::new[u64]();
    seq.resize(n, 0);
    seq
}

fn none32_at(in seq: ChunkSeq[u32], i: u64) -> u32 {
    match seq.try_get(i) {
        Option::Some(value) => value,
        Option::None => NONE32,
    }
}

// The program and everything the pass reads about it.
pub struct Prog {
    names: Names,
    // types: facts, kind (0 other, 1 named, 2 tuple, 3 function), name and
    // arguments type_args[type_arg_starts[t]..type_arg_starts[t]+type_arg_counts[t]]
    type_facts: ChunkSeq[u64],
    type_kinds: ChunkSeq[u8],
    type_names: ChunkSeq[u32],
    type_arg_starts: ChunkSeq[u32],
    type_arg_counts: ChunkSeq[u32],
    type_args: ChunkSeq[u32],
    // effect rows: row_words[row_starts[r]..]: count, (label + 1, name, args,
    // instance)*, tail + 1 (`instance` is the same index for equal instances)
    row_starts: ChunkSeq[u32],
    row_words: ChunkSeq[u64],
    unit_ty: u32,
    bind_opaque: u32,
    funs: ChunkSeq[Fun],
    // symbol -> function index
    fun_of: ChunkSeq[u32],
    params: ChunkSeq[ParamRow],
    ids: ChunkSeq[u32],
    local_names: ChunkSeq[u32],
    local_types: ChunkSeq[u32],
    value_types: ChunkSeq[u32],
    fun_block_ids: ChunkSeq[u32],
    block_rows: ChunkSeq[Blk],
    insts: ChunkSeq[Inst],
    ops: ChunkSeq[u64],
    patterns: ChunkSeq[u64],
    instances: ChunkSeq[Instance],
    sub_from: ChunkSeq[u32],
    sub_to: ChunkSeq[u32],
    // Budget
    small_callee: u64,
    single_site_callee: u64,
    caller_growth: u64,
    program_growth: u64,
    callee_growth: u64,
    caller_handles: u64,
    // well-known names
    fail_symbol: u32,
    capability_names: ChunkSeq[u32],
    // name -> short name (after the last `::`)
    short_names: MapU,
    // symbol -> input name index
    input_index: ChunkSeq[u32],
}

fn no_fun() -> Fun {
    Fun {
        name: 0,
        flags: 0,
        result_ty: 0,
        row: 0,
        param_start: 0,
        param_count: 0,
        bound_start: 0,
        bound_count: 0,
        local_start: 0,
        local_count: 0,
        value_start: 0,
        value_count: 0,
        block_start: 0,
        block_count: 0
    }
}

fn no_inst() -> Inst {
    Inst { dest: 0, ty: 0, span_start: 0, span_end: 0, flags: 0, opaque: 0, op: O_UNIT, ops_at: 0 }
}

fn no_blk() -> Blk {
    Blk {
        param_start: 0,
        param_count: 0,
        inst_start: 0,
        inst_count: 0,
        term: T_UNREACHABLE,
        term_at: 0
    }
}

impl Prog {
    pub fn fun(in self, fun_index: u32) -> Fun {
        match self.funs.try_get(w(fun_index)) {
            Option::Some(fun_row) => fun_row,
            Option::None => no_fun(),
        }
    }

    pub fn set_fun(inout self, fun_index: u32, fun_row: Fun) {
        let ok = self.funs.try_set(w(fun_index), fun_row);
    }

    pub fn inst(in self, inst_id: u32) -> Inst {
        match self.insts.try_get(w(inst_id)) {
            Option::Some(inst_row) => inst_row,
            Option::None => no_inst(),
        }
    }

    pub fn blk(in self, block_id: u32) -> Blk {
        match self.block_rows.try_get(w(block_id)) {
            Option::Some(blk_row) => blk_row,
            Option::None => no_blk(),
        }
    }

    pub fn param(in self, func: Fun, index: u64) -> ParamRow {
        match self.params.try_get(add(w(func.param_start), index)) {
            Option::Some(param_row) => param_row,
            Option::None => ParamRow { name: 0, pass: 0, ty: 0 },
        }
    }

    pub fn op(in self, i: u64) -> u64 {
        u64_at(in self.ops, i)
    }

    pub fn pat(in self, i: u64) -> u64 {
        u64_at(in self.patterns, i)
    }

    pub fn id(in self, i: u64) -> u32 {
        u32_at(in self.ids, i)
    }

    // Block `block` of function `func`, by id.
    pub fn block_id(in self, func: Fun, block: u64) -> u32 {
        u32_at(in self.fun_block_ids, add(w(func.block_start), block))
    }

    pub fn block(in self, func: Fun, block: u64) -> Blk {
        self.blk(self.block_id(func, block))
    }

    // Instruction `i` of block `block_row`.
    pub fn inst_of(in self, block_row: Blk, i: u64) -> Inst {
        self.inst(self.id(add(w(block_row.inst_start), i)))
    }

    pub fn fun_index(in self, name: u32) -> u32 {
        none32_at(in self.fun_of, w(name))
    }

    pub fn facts(in self, ty: u32) -> u64 {
        u64_at(in self.type_facts, w(ty))
    }

    pub fn has(in self, ty: u32, fact: u64) -> bool {
        (self.facts(ty) & fact) != 0
    }

    // A type of a target: an instance maps the callee's types.
    pub fn map(in self, instance_index: u32, ty: u32) -> u32 {
        if instance_index == NONE32 {
            return ty;
        }
        let instance = match self.instances.try_get(w(instance_index)) {
            Option::Some(instance) => instance,
            Option::None => return ty,
        };
        let mut lo = w(instance.pair_start);
        let mut hi = add(w(instance.pair_start), w(instance.pair_count));
        loop {
            if lo >= hi {
                return ty;
            }
            let mid = add(lo, hi) / 2;
            let from = u32_at(in self.sub_from, mid);
            if from == ty {
                return u32_at(in self.sub_to, mid);
            }
            if from < ty {
                lo = inc(mid);
            } else {
                hi = mid;
            }
        }
    }

    pub fn row_of(in self, target: Tgt) -> u32 {
        if target.instance != NONE32 {
            match self.instances.try_get(w(target.instance)) {
                Option::Some(instance) => return instance.row,
                Option::None => {},
            }
        }
        self.fun(target.fun_index).row
    }

    // The type of value `value` in function `func`, NONE32 when it has none.
    pub fn value_ty(in self, func: Fun, value: u64) -> u32 {
        if value >= w(func.value_count) {
            return NONE32;
        }
        let stored = u32_at(in self.value_types, add(w(func.value_start), value));
        if stored == 0 {
            NONE32
        } else {
            wrapping_sub(stored, 1)
        }
    }

    pub fn local_ty(in self, func: Fun, name: u32) -> u32 {
        for k in 0..w(func.local_count) {
            let at = add(w(func.local_start), k);
            if u32_at(in self.local_names, at) == name {
                return u32_at(in self.local_types, at);
            }
        }
        NONE32
    }

    pub fn row_count(in self, row: u32) -> u64 {
        u64_at(in self.row_words, w(u32_at(in self.row_starts, w(row))))
    }

    pub fn input_name(in self, symbol: u32) -> u64 {
        w(none32_at(in self.input_index, w(symbol)))
    }

    pub fn budget_off(in self) -> bool {
        self.small_callee == 0 && self.single_site_callee == 0
    }
}

// ----- growing lists ------------------------------------------------------------

fn push_block(inout prog: Prog, fun_index: u32, id: u32) {
    let mut func = prog.fun(fun_index);
    let end = add(w(func.block_start), w(func.block_count));
    if end != prog.fun_block_ids.len() {
        let start = prog.fun_block_ids.len();
        for k in 0..w(func.block_count) {
            let moved_id = u32_at(in prog.fun_block_ids, add(w(func.block_start), k));
            prog.fun_block_ids.push(moved_id);
        }
        func.block_start = n32(start);
    }
    prog.fun_block_ids.push(id);
    func.block_count = inc32(func.block_count);
    prog.set_fun(fun_index, func);
}

fn set_block(inout prog: Prog, fun_index: u32, block: u64, id: u32) {
    let func = prog.fun(fun_index);
    let ok = prog.fun_block_ids.try_set(add(w(func.block_start), block), id);
}

fn push_local(inout prog: Prog, fun_index: u32, name: u32, ty: u32) {
    let mut func = prog.fun(fun_index);
    let end = add(w(func.local_start), w(func.local_count));
    if end != prog.local_names.len() {
        let start = prog.local_names.len();
        for k in 0..w(func.local_count) {
            let moved_name = u32_at(in prog.local_names, add(w(func.local_start), k));
            let moved_ty = u32_at(in prog.local_types, add(w(func.local_start), k));
            prog.local_names.push(moved_name);
            prog.local_types.push(moved_ty);
        }
        func.local_start = n32(start);
    }
    prog.local_names.push(name);
    prog.local_types.push(ty);
    func.local_count = inc32(func.local_count);
    prog.set_fun(fun_index, func);
}

// `values.insert(v, ty)`.
fn set_value(inout prog: Prog, fun_index: u32, value: u64, ty: u32) {
    let mut func = prog.fun(fun_index);
    if value >= w(func.value_count) {
        let end = add(w(func.value_start), w(func.value_count));
        if end != prog.value_types.len() {
            let start = prog.value_types.len();
            for k in 0..w(func.value_count) {
                let moved_ty = u32_at(in prog.value_types, add(w(func.value_start), k));
                prog.value_types.push(moved_ty);
            }
            func.value_start = n32(start);
        }
        let mut n = w(func.value_count);
        loop {
            if n > value {
                break;
            }
            prog.value_types.push(0);
            n = inc(n);
        }
        func.value_count = n32(n);
        prog.set_fun(fun_index, func);
    }
    let ok = prog.value_types.try_set(add(w(func.value_start), value), inc32(ty));
}

// ----- decoding -----------------------------------------------------------------

fn sym(in symbols: ChunkSeq[u32], raw: u64) -> u32 {
    u32_at(in symbols, raw)
}

fn opt_sym(in symbols: ChunkSeq[u32], raw: u64) -> u64 {
    if raw == 0 {
        0
    } else {
        inc(w(u32_at(in symbols, sub(raw, 1))))
    }
}

fn read_path(
    inout reader: Reader,
    in bytes: Slice[u8],
    in symbols: ChunkSeq[u32],
    inout ops: ChunkSeq[u64]
) {
    let n = reader.word(in bytes);
    ops.push(n);
    for i in 0..n {
        ops.push(w(sym(in symbols, reader.word(in bytes))));
    }
}

fn read_literal(inout reader: Reader, in bytes: Slice[u8], inout out: ChunkSeq[u64]) {
    out.push(reader.word(in bytes));
    out.push(reader.word(in bytes));
    out.push(reader.word(in bytes));
}

// A pattern node: kind, start, stop, then Bind: name; Tuple: n, children;
// Constructor: name, named, n, (field, child)*; Literal: kind, lo, hi,
// opaque. Children are pool offsets.
fn read_pattern(
    inout reader: Reader,
    in bytes: Slice[u8],
    in symbols: ChunkSeq[u32],
    inout patterns: ChunkSeq[u64]
) -> u64 {
    let kind = reader.word(in bytes);
    let mut body: ChunkSeq[u64] = ChunkSeq::new[u64]();
    if kind == PK_BIND {
        body.push(w(sym(in symbols, reader.word(in bytes))));
    } else if kind == PK_TUPLE {
        let n = reader.word(in bytes);
        body.push(n);
        for i in 0..n {
            let child = read_pattern(inout reader, in bytes, in symbols, inout patterns);
            body.push(child);
        }
    } else if kind == PK_CTOR {
        body.push(w(sym(in symbols, reader.word(in bytes))));
        body.push(reader.word(in bytes));
        let n = reader.word(in bytes);
        body.push(n);
        for i in 0..n {
            body.push(w(sym(in symbols, reader.word(in bytes))));
            let child = read_pattern(inout reader, in bytes, in symbols, inout patterns);
            body.push(child);
        }
    } else if kind == PK_LIT {
        read_literal(inout reader, in bytes, inout body);
        body.push(reader.word(in bytes));
    }
    let span_start = reader.word(in bytes);
    let span_end = reader.word(in bytes);
    let at = patterns.len();
    patterns.push(kind);
    patterns.push(span_start);
    patterns.push(span_end);
    patterns.extend(in body.as_slice());
    at
}

fn read_args(
    inout reader: Reader,
    in bytes: Slice[u8],
    in symbols: ChunkSeq[u32],
    inout ops: ChunkSeq[u64]
) {
    let n = reader.word(in bytes);
    ops.push(n);
    for i in 0..n {
        ops.push(reader.word(in bytes));
        ops.push(reader.word(in bytes));
        let has_place = reader.word(in bytes);
        ops.push(has_place);
        if has_place != 0 {
            ops.push(w(sym(in symbols, reader.word(in bytes))));
            read_path(inout reader, in bytes, in symbols, inout ops);
        }
    }
}

fn read_op(
    inout reader: Reader,
    in bytes: Slice[u8],
    in symbols: ChunkSeq[u32],
    inout prog: Prog,
    op: u8
) {
    if op == O_CONST {
        read_literal(inout reader, in bytes, inout prog.ops);
    } else if op == O_READ {
        prog.ops.push(w(sym(in symbols, reader.word(in bytes))));
        read_path(inout reader, in bytes, in symbols, inout prog.ops);
    } else if op == O_BIND {
        prog.ops.push(reader.word(in bytes));
        let at = read_pattern(inout reader, in bytes, in symbols, inout prog.patterns);
        prog.ops.push(at);
    } else if op == O_WRITE {
        prog.ops.push(reader.word(in bytes));
        prog.ops.push(w(sym(in symbols, reader.word(in bytes))));
        read_path(inout reader, in bytes, in symbols, inout prog.ops);
    } else if op == O_UNARY || op == O_INDEX {
        prog.ops.push(reader.word(in bytes));
        prog.ops.push(reader.word(in bytes));
    } else if op == O_BINARY {
        prog.ops.push(reader.word(in bytes));
        prog.ops.push(reader.word(in bytes));
        prog.ops.push(reader.word(in bytes));
    } else if op == O_PROJECT || op == O_TRY {
        prog.ops.push(reader.word(in bytes));
    } else if op == O_TUPLE || op == O_VECTOR {
        let n = reader.word(in bytes);
        prog.ops.push(n);
        for i in 0..n {
            prog.ops.push(reader.word(in bytes));
        }
    } else if op == O_DATA {
        prog.ops.push(w(sym(in symbols, reader.word(in bytes))));
        let n = reader.word(in bytes);
        prog.ops.push(n);
        for i in 0..n {
            prog.ops.push(reader.word(in bytes));
        }
    } else if op == O_CALL {
        prog.ops.push(w(sym(in symbols, reader.word(in bytes))));
        prog.ops.push(reader.word(in bytes));
        read_args(inout reader, in bytes, in symbols, inout prog.ops);
    } else if op == O_TILED || op == O_SEQ || op == O_FIP {
        read_args(inout reader, in bytes, in symbols, inout prog.ops);
    } else if op == O_INDIRECT {
        prog.ops.push(reader.word(in bytes));
        read_args(inout reader, in bytes, in symbols, inout prog.ops);
    } else if op == O_EXIT {
        prog.ops.push(w(sym(in symbols, reader.word(in bytes))));
        prog.ops.push(reader.word(in bytes));
    } else if op == O_HANDLE {
        prog.ops.push(reader.word(in bytes));
        prog.ops.push(reader.word(in bytes));
        let pair_count = reader.word(in bytes);
        prog.ops.push(pair_count);
        for i in 0..pair_count {
            prog.ops.push(w(sym(in symbols, reader.word(in bytes))));
            prog.ops.push(w(sym(in symbols, reader.word(in bytes))));
        }
        let move_count = reader.word(in bytes);
        prog.ops.push(move_count);
        for i in 0..move_count {
            prog.ops.push(w(sym(in symbols, reader.word(in bytes))));
            read_path(inout reader, in bytes, in symbols, inout prog.ops);
        }
        let graph_count = reader.word(in bytes);
        prog.ops.push(graph_count);
        for i in 0..graph_count {
            prog.ops.push(w(sym(in symbols, reader.word(in bytes))));
        }
    }
}

fn read_terminator(
    inout reader: Reader,
    in bytes: Slice[u8],
    in symbols: ChunkSeq[u32],
    inout prog: Prog,
    term: u8
) {
    if term == T_RETURN {
        prog.ops.push(reader.word(in bytes));
    } else if term == T_JUMP {
        prog.ops.push(reader.word(in bytes));
        let n = reader.word(in bytes);
        prog.ops.push(n);
        for i in 0..n {
            prog.ops.push(reader.word(in bytes));
        }
    } else if term == T_BRANCH {
        prog.ops.push(reader.word(in bytes));
        prog.ops.push(reader.word(in bytes));
        prog.ops.push(reader.word(in bytes));
    } else if term == T_MATCH {
        prog.ops.push(reader.word(in bytes));
        let n = reader.word(in bytes);
        prog.ops.push(n);
        for i in 0..n {
            let at = read_pattern(inout reader, in bytes, in symbols, inout prog.patterns);
            prog.ops.push(at);
            prog.ops.push(reader.word(in bytes));
        }
    }
}

fn read_function(
    inout reader: Reader,
    in bytes: Slice[u8],
    in symbols: ChunkSeq[u32],
    inout prog: Prog
) {
    let name = sym(in symbols, reader.word(in bytes));
    let flags = reader.word(in bytes);
    let result_ty = n32(reader.word(in bytes));
    let row = n32(reader.word(in bytes));
    let param_start = n32(prog.params.len());
    let param_count = reader.word(in bytes);
    for i in 0..param_count {
        let param_name = sym(in symbols, reader.word(in bytes));
        let pass = reader.word(in bytes);
        let ty = n32(reader.word(in bytes));
        prog.params.push(ParamRow { name: param_name, pass: pass, ty: ty });
    }
    let bound_start = n32(prog.ids.len());
    let bound_count = reader.word(in bytes);
    for i in 0..bound_count {
        prog.ids.push(sym(in symbols, reader.word(in bytes)));
    }
    let local_start = n32(prog.local_names.len());
    let local_count = reader.word(in bytes);
    for i in 0..local_count {
        prog.local_names.push(sym(in symbols, reader.word(in bytes)));
        prog.local_types.push(n32(reader.word(in bytes)));
    }
    // Value types, dense by id.
    let value_start = prog.value_types.len();
    let typed_values = reader.word(in bytes);
    let mut value_count: u64 = 0;
    for i in 0..typed_values {
        let id = reader.word(in bytes);
        let ty = n32(reader.word(in bytes));
        loop {
            if value_count > id {
                break;
            }
            prog.value_types.push(0);
            value_count = inc(value_count);
        }
        let ok = prog.value_types.try_set(add(value_start, id), inc32(ty));
    }
    let block_start = n32(prog.fun_block_ids.len());
    let block_count = reader.word(in bytes);
    for block_index in 0..block_count {
        let block_param_start = n32(prog.ids.len());
        let block_param_count = reader.word(in bytes);
        for i in 0..block_param_count {
            prog.ids.push(n32(reader.word(in bytes)));
        }
        let inst_count = reader.word(in bytes);
        let mut inst_ids: ChunkSeq[u32] = ChunkSeq::new[u32]();
        for inst_index in 0..inst_count {
            let dest = n32(reader.word(in bytes));
            let ty = n32(reader.word(in bytes));
            let span_start = reader.word(in bytes);
            let span_end = reader.word(in bytes);
            let inst_flags = reader.word(in bytes);
            let opaque = n32(reader.word(in bytes));
            let op = n8(reader.word(in bytes));
            let ops_at = n32(prog.ops.len());
            read_op(inout reader, in bytes, in symbols, inout prog, op);
            inst_ids.push(n32(prog.insts.len()));
            prog.insts.push(Inst {
                dest: dest,
                ty: ty,
                span_start: span_start,
                span_end: span_end,
                flags: inst_flags,
                opaque: opaque,
                op: op,
                ops_at: ops_at
            });
        }
        let inst_start = n32(prog.ids.len());
        prog.ids.extend(in inst_ids.as_slice());
        let term = n8(reader.word(in bytes));
        let term_at = n32(prog.ops.len());
        read_terminator(inout reader, in bytes, in symbols, inout prog, term);
        prog.fun_block_ids.push(n32(prog.block_rows.len()));
        prog.block_rows.push(Blk {
            param_start: block_param_start,
            param_count: n32(block_param_count),
            inst_start: inst_start,
            inst_count: n32(inst_count),
            term: term,
            term_at: term_at
        });
    }
    let index = n32(prog.funs.len());
    prog.funs.push(Fun {
        name: name,
        flags: flags,
        result_ty: result_ty,
        row: row,
        param_start: param_start,
        param_count: n32(param_count),
        bound_start: bound_start,
        bound_count: n32(bound_count),
        local_start: local_start,
        local_count: n32(local_count),
        value_start: n32(value_start),
        value_count: n32(value_count),
        block_start: block_start,
        block_count: n32(block_count)
    });
    if w(name) >= prog.fun_of.len() {
        prog.fun_of.resize(inc(w(name)), NONE32);
    }
    let ok = prog.fun_of.try_set(w(name), index);
}

fn intern_text(inout names: Names, in text: Str) -> u32 {
    names.intern(in text.as_bytes())
}

pub fn read_input(in bytes: Slice[u8]) -> Prog {
    let mut reader = Reader { pos: 0 };
    let mut names = names_new();
    let mut symbols: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let name_count = reader.word(in bytes);
    for i in 0..name_count {
        let name_len = reader.word(in bytes);
        let name_start = reader.pos;
        let symbol = names.intern(in bytes[name_start..add(name_start, name_len)]);
        symbols.push(symbol);
        reader.pos = add(name_start, wrapping_mul(add(name_len, 7) / 8, 8));
    }
    let fail_symbol = intern_text(inout names, "Fail");
    let mut capability_names: ChunkSeq[u32] = ChunkSeq::new[u32]();
    capability_names.push(intern_text(inout names, "ConstTime"));
    capability_names.push(intern_text(inout names, "Realtime"));
    capability_names.push(intern_text(inout names, "DetFloat"));
    capability_names.push(intern_text(inout names, "ConstDenorm"));
    capability_names.push(intern_text(inout names, "Isa"));
    let mut prog = Prog {
        names: names,
        type_facts: ChunkSeq::new[u64](),
        type_kinds: ChunkSeq::new[u8](),
        type_names: ChunkSeq::new[u32](),
        type_arg_starts: ChunkSeq::new[u32](),
        type_arg_counts: ChunkSeq::new[u32](),
        type_args: ChunkSeq::new[u32](),
        row_starts: ChunkSeq::new[u32](),
        row_words: ChunkSeq::new[u64](),
        unit_ty: 0,
        bind_opaque: 0,
        funs: ChunkSeq::new[Fun](),
        fun_of: ChunkSeq::new[u32](),
        params: ChunkSeq::new[ParamRow](),
        ids: ChunkSeq::new[u32](),
        local_names: ChunkSeq::new[u32](),
        local_types: ChunkSeq::new[u32](),
        value_types: ChunkSeq::new[u32](),
        fun_block_ids: ChunkSeq::new[u32](),
        block_rows: ChunkSeq::new[Blk](),
        insts: ChunkSeq::new[Inst](),
        ops: ChunkSeq::new[u64](),
        patterns: ChunkSeq::new[u64](),
        instances: ChunkSeq::new[Instance](),
        sub_from: ChunkSeq::new[u32](),
        sub_to: ChunkSeq::new[u32](),
        small_callee: 0,
        single_site_callee: 0,
        caller_growth: 0,
        program_growth: 0,
        callee_growth: 0,
        caller_handles: 0,
        fail_symbol: fail_symbol,
        capability_names: capability_names,
        short_names: map_new(1024),
        input_index: ChunkSeq::new[u32](),
    };
    prog.input_index.resize(prog.names.len(), NONE32);
    for i in 0..symbols.len() {
        set_u32(inout prog.input_index, w(u32_at(in symbols, i)), n32(i));
    }
    let type_count = reader.word(in bytes);
    for i in 0..type_count {
        prog.type_facts.push(reader.word(in bytes));
        prog.type_kinds.push(n8(reader.word(in bytes)));
        prog.type_names.push(sym(in symbols, reader.word(in bytes)));
        let arg_count = reader.word(in bytes);
        prog.type_arg_starts.push(n32(prog.type_args.len()));
        prog.type_arg_counts.push(n32(arg_count));
        for k in 0..arg_count {
            prog.type_args.push(n32(reader.word(in bytes)));
        }
    }
    let row_count = reader.word(in bytes);
    for i in 0..row_count {
        prog.row_starts.push(n32(prog.row_words.len()));
        let label_count = reader.word(in bytes);
        prog.row_words.push(label_count);
        for k in 0..label_count {
            prog.row_words.push(opt_sym(in symbols, reader.word(in bytes)));
            prog.row_words.push(w(sym(in symbols, reader.word(in bytes))));
            prog.row_words.push(reader.word(in bytes));
            prog.row_words.push(reader.word(in bytes));
        }
        prog.row_words.push(opt_sym(in symbols, reader.word(in bytes)));
    }
    prog.unit_ty = n32(reader.word(in bytes));
    prog.bind_opaque = n32(reader.word(in bytes));
    prog.small_callee = reader.word(in bytes);
    prog.single_site_callee = reader.word(in bytes);
    prog.caller_growth = reader.word(in bytes);
    prog.program_growth = reader.word(in bytes);
    prog.callee_growth = reader.word(in bytes);
    prog.caller_handles = reader.word(in bytes);
    let fun_count = reader.word(in bytes);
    prog.fun_of.resize(prog.names.len(), NONE32);
    for i in 0..fun_count {
        read_function(inout reader, in bytes, in symbols, inout prog);
    }
    let instance_count = reader.word(in bytes);
    for i in 0..instance_count {
        let callee = sym(in symbols, reader.word(in bytes));
        let span_start = reader.word(in bytes);
        let span_end = reader.word(in bytes);
        let has_types = reader.word(in bytes) != 0;
        let pair_start = n32(prog.sub_from.len());
        let mut pair_count: u64 = 0;
        let mut row: u32 = 0;
        if has_types {
            pair_count = reader.word(in bytes);
            for k in 0..pair_count {
                prog.sub_from.push(n32(reader.word(in bytes)));
                prog.sub_to.push(n32(reader.word(in bytes)));
            }
            row = n32(reader.word(in bytes));
        }
        prog.instances.push(Instance {
            callee: callee,
            span_start: span_start,
            span_end: span_end,
            has_types: has_types,
            pair_start: pair_start,
            pair_count: n32(pair_count),
            row: row
        });
    }
    prog
}

// ----- operands -----------------------------------------------------------------

// The offset of the argument count of an operation with arguments.
fn args_at(op: u8, ops_at: u64) -> u64 {
    if op == O_CALL {
        add(ops_at, 2)
    } else if op == O_INDIRECT {
        inc(ops_at)
    } else {
        ops_at
    }
}

fn has_args(op: u8) -> bool {
    op == O_CALL || op == O_TILED || op == O_SEQ || op == O_FIP || op == O_INDIRECT
}

// The offset just past the argument at `arg_at`.
fn arg_end(in prog: Prog, arg_at: u64) -> u64 {
    if prog.op(add(arg_at, 2)) != 0 {
        add(add(arg_at, 5), prog.op(add(arg_at, 4)))
    } else {
        add(arg_at, 3)
    }
}

// The offset of the graph count of a handle at `ops_at`.
fn handle_graphs_at(in prog: Prog, ops_at: u64) -> u64 {
    let pair_count = prog.op(add(ops_at, 2));
    let mut at = add(add(ops_at, 3), wrapping_mul(pair_count, 2));
    let move_count = prog.op(at);
    at = inc(at);
    for i in 0..move_count {
        at = add(add(at, 2), prog.op(inc(at)));
    }
    at
}

// Successors of a terminator.
fn successors(in prog: Prog, block_row: Blk, inout out: ChunkSeq[u32]) {
    out.clear();
    let term_at = w(block_row.term_at);
    if block_row.term == T_JUMP {
        out.push(n32(prog.op(term_at)));
    } else if block_row.term == T_BRANCH {
        out.push(n32(prog.op(inc(term_at))));
        out.push(n32(prog.op(add(term_at, 2))));
    } else if block_row.term == T_MATCH {
        let arm_count = prog.op(inc(term_at));
        for i in 0..arm_count {
            out.push(n32(prog.op(add(add(term_at, 3), wrapping_mul(i, 2)))));
        }
    }
}

// Names a pattern binds (`pattern_binds`), appended to `out`.
fn pattern_binds(in prog: Prog, at: u64, inout out: ChunkSeq[u32]) {
    let kind = prog.pat(at);
    if kind == PK_BIND {
        out.push(n32(prog.pat(add(at, 3))));
    } else if kind == PK_TUPLE {
        let n = prog.pat(add(at, 3));
        for i in 0..n {
            pattern_binds(in prog, prog.pat(add(add(at, 4), i)), inout out);
        }
    } else if kind == PK_CTOR {
        let n = prog.pat(add(at, 5));
        for i in 0..n {
            pattern_binds(in prog, prog.pat(add(add(at, 7), wrapping_mul(i, 2))), inout out);
        }
    }
}

fn pattern_binds_any(in prog: Prog, at: u64) -> bool {
    let mut names: ChunkSeq[u32] = ChunkSeq::new[u32]();
    pattern_binds(in prog, at, inout names);
    names.len() > 0
}

// ----- names --------------------------------------------------------------------

fn name_byte(in prog: Prog, symbol: u32, i: u64) -> u8 {
    prog.names.byte(symbol, i)
}

// `arrays::is_const_function`: `const$NAME`, or a package's
// `{scope}__{package}__{module}__const$NAME`.
fn is_const_function(in prog: Prog, symbol: u32) -> bool {
    let size = prog.names.size(symbol);
    let marker = "const$".as_bytes();
    let marker_len = marker.len();
    if size < marker_len {
        return false;
    }
    let mut at: u64 = 0;
    loop {
        if add(at, marker_len) > size {
            return false;
        }
        let mut same = true;
        for j in 0..marker_len {
            let byte = match marker.try_get(j) {
                Option::Some(byte) => byte,
                Option::None => 0,
            };
            if name_byte(in prog, symbol, add(at, j)) != byte {
                same = false;
                break;
            }
        }
        if same {
            if at == 0 {
                return true;
            }
            if at >= 2
                && name_byte(in prog, symbol, sub(at, 1)) == 95
                && name_byte(in prog, symbol, sub(at, 2)) == 95
            {
                return true;
            }
        }
        at = inc(at);
    }
}

// The name after the last `::` (`site::short`), interned.
fn short(inout prog: Prog, symbol: u32) -> u32 {
    let cached = prog.short_names.get(w(symbol));
    if cached != NONE32 {
        return cached;
    }
    let size = prog.names.size(symbol);
    let mut from: u64 = 0;
    let mut i: u64 = 0;
    loop {
        if inc(i) >= size {
            break;
        }
        if name_byte(in prog, symbol, i) == 58 && name_byte(in prog, symbol, inc(i)) == 58 {
            from = add(i, 2);
        }
        i = inc(i);
    }
    let mut out = symbol;
    if from > 0 {
        let mut buf: ChunkSeq[u8] = ChunkSeq::new[u8]();
        for k in from..size {
            buf.push(name_byte(in prog, symbol, k));
        }
        out = prog.names.intern(in buf.as_slice());
    }
    prog.short_names.set(w(symbol), out);
    out
}

// `name$inlN`.
fn renamed(inout prog: Prog, symbol: u32, serial: u64) -> u32 {
    let mut buf: ChunkSeq[u8] = ChunkSeq::new[u8]();
    prog.names.write(symbol, inout buf);
    buf.extend(in "$inl".as_bytes());
    push_decimal(inout buf, serial);
    prog.names.intern(in buf.as_slice())
}

// ----- rows ---------------------------------------------------------------------

// The words of one effect instance in `row_words`.
const ROW_STRIDE: u64 = 4;

// `fail_row_only`: no tail, and only unlabeled one-argument `Fail`s.
fn fail_row_only(in prog: Prog, row: u32) -> bool {
    let row_at = w(u32_at(in prog.row_starts, w(row)));
    let label_count = u64_at(in prog.row_words, row_at);
    for i in 0..label_count {
        let entry = add(inc(row_at), wrapping_mul(i, ROW_STRIDE));
        if u64_at(in prog.row_words, entry) != 0
            || u64_at(in prog.row_words, inc(entry)) != w(prog.fail_symbol)
            || u64_at(in prog.row_words, add(entry, 2)) != 1
        {
            return false;
        }
    }
    u64_at(in prog.row_words, add(inc(row_at), wrapping_mul(label_count, ROW_STRIDE))) == 0
}

// A capability effect (`capability_effects::is_capability_effect`) in row `row`.
fn row_has_capability(in prog: Prog, row: u32) -> bool {
    let row_at = w(u32_at(in prog.row_starts, w(row)));
    let label_count = u64_at(in prog.row_words, row_at);
    for i in 0..label_count {
        let name = n32(u64_at(
            in prog.row_words,
            add(add(inc(row_at), wrapping_mul(i, ROW_STRIDE)), 1)
        ));
        for k in 0..prog.capability_names.len() {
            if u32_at(in prog.capability_names, k) == name {
                return true;
            }
        }
    }
    false
}

// ----- types --------------------------------------------------------------------

// `mentions_names`: a bare named type in `names`, or any function type.
fn mentions_names(in prog: Prog, ty: u32, in names: ChunkSeq[u32]) -> bool {
    let kind = u8_at(in prog.type_kinds, w(ty));
    let arg_start = w(u32_at(in prog.type_arg_starts, w(ty)));
    let arg_count = w(u32_at(in prog.type_arg_counts, w(ty)));
    if kind == 1 {
        if arg_count == 0 {
            let name = u32_at(in prog.type_names, w(ty));
            for k in 0..names.len() {
                if u32_at(in names, k) == name {
                    return true;
                }
            }
        }
        for k in 0..arg_count {
            if mentions_names(in prog, u32_at(in prog.type_args, add(arg_start, k)), in names) {
                return true;
            }
        }
        return false;
    }
    if kind == 2 {
        for k in 0..arg_count {
            if mentions_names(in prog, u32_at(in prog.type_args, add(arg_start, k)), in names) {
                return true;
            }
        }
        return false;
    }
    kind == 3
}

// The types of a target: parameters, values, locals and result.
fn any_type(
    in prog: Prog,
    target: Tgt,
    fact: u64,
    values: bool,
    locals: bool,
    params: bool,
    result: bool
) -> bool {
    let func = prog.fun(target.fun_index);
    if values {
        for v in 0..w(func.value_count) {
            let ty = prog.value_ty(func, v);
            if ty != NONE32 && prog.has(prog.map(target.instance, ty), fact) {
                return true;
            }
        }
    }
    if locals {
        for k in 0..w(func.local_count) {
            let ty = u32_at(in prog.local_types, add(w(func.local_start), k));
            if prog.has(prog.map(target.instance, ty), fact) {
                return true;
            }
        }
    }
    if params {
        for k in 0..w(func.param_count) {
            if prog.has(prog.map(target.instance, prog.param(func, k).ty), fact) {
                return true;
            }
        }
    }
    result && prog.has(prog.map(target.instance, func.result_ty), fact)
}

// ----- cost ---------------------------------------------------------------------

// What a site's known arguments decide in a callee (`site::Folded`).
pub struct Folded {
    // per block: reachable
    live: ChunkSeq[u8],
    // per block: the one successor a decided Branch or Match takes, or NONE32
    jumps: ChunkSeq[u32],
    // per value: determined by the arguments
    known: ChunkSeq[u8],
    jump_count: u64,
}

fn folded_none(block_count: u64) -> Folded {
    let mut live = zeros8(block_count);
    for k in 0..block_count {
        set_u8(inout live, k, 1);
    }
    Folded {
        live: live,
        jumps: fill32(block_count, NONE32),
        known: ChunkSeq::new[u8](),
        jump_count: 0
    }
}

impl Folded {
    // `Folded::decides`.
    pub fn decides(in self) -> bool {
        if self.jump_count > 0 {
            return true;
        }
        for k in 0..self.live.len() {
            if u8_at(in self.live, k) == 0 {
                return true;
            }
        }
        false
    }

    pub fn jump(in self, block: u64) -> u32 {
        none32_at(in self.jumps, block)
    }
}

// `Folded::successors`.
fn folded_successors(
    in prog: Prog,
    func: Fun,
    in folded: Folded,
    block: u64,
    inout out: ChunkSeq[u32]
) {
    let taken = folded.jump(block);
    if taken != NONE32 {
        out.clear();
        out.push(taken);
        return;
    }
    successors(in prog, prog.block(func, block), inout out);
}

// Free in `cost` (`cost_parts`).
fn free(in prog: Prog, target: Tgt, func: Fun, inst: Inst) -> bool {
    let ops_at = w(inst.ops_at);
    if inst.op == O_CONST || inst.op == O_UNIT || inst.op == O_LOOP {
        return true;
    }
    if inst.op == O_READ {
        return prog.op(inc(ops_at)) == 0;
    }
    if inst.op == O_DATA {
        return prog.op(inc(ops_at)) == 0 && prog.has(prog.map(target.instance, inst.ty), F_SCALAR);
    }
    if inst.op == O_BIND {
        let kind = prog.pat(prog.op(inc(ops_at)));
        if kind != PK_BIND && kind != PK_WILD {
            return false;
        }
        let ty = prog.value_ty(func, prog.op(ops_at));
        return ty != NONE32 && prog.has(prog.map(target.instance, ty), F_SCALAR);
    }
    false
}

// `Folded::cost_of`: the cost of the blocks `blocks` marks under `folded`.
fn cost_of(in prog: Prog, target: Tgt, in folded: Folded, in blocks: ChunkSeq[u8]) -> u64 {
    let func = prog.fun(target.fun_index);
    let mut total: u64 = 0;
    for block in 0..w(func.block_count) {
        if u8_at(in blocks, block) == 0 {
            continue;
        }
        let block_row = prog.block(func, block);
        let mut work: u64 = 0;
        for k in 0..w(block_row.inst_count) {
            let inst = prog.inst_of(block_row, k);
            if free(in prog, target, func, inst) {
                continue;
            }
            if u8_at(in folded.known, w(inst.dest)) != 0
                && (
                    inst.op == O_BINARY
                        || inst.op == O_UNARY
                        || inst.op == O_READ
                        || inst.op == O_DATA
                )
            {
                continue;
            }
            work = inc(work);
        }
        let jump = block_row.term == T_JUMP || folded.jump(block) != NONE32;
        total = add(total, work);
        if !(work == 0 && jump) {
            total = inc(total);
        }
    }
    total
}

fn folded_cost(in prog: Prog, target: Tgt, in folded: Folded) -> u64 {
    cost_of(in prog, target, in folded, in folded.live)
}

// `cost`.
fn cost(in prog: Prog, target: Tgt) -> u64 {
    let folded = folded_none(w(prog.fun(target.fun_index).block_count));
    folded_cost(in prog, target, in folded)
}

// `size`: instructions plus one per block.
fn size(in prog: Prog, fun_index: u32) -> u64 {
    let func = prog.fun(fun_index);
    let mut total: u64 = 0;
    for block in 0..w(func.block_count) {
        total = add(total, inc(w(prog.block(func, block).inst_count)));
    }
    total
}

// The handler graphs of function `fun_index` (`handler_graphs`), as names.
fn handler_graphs(in prog: Prog, fun_index: u32, inout out: ChunkSeq[u32]) {
    let func = prog.fun(fun_index);
    for block in 0..w(func.block_count) {
        let block_row = prog.block(func, block);
        for k in 0..w(block_row.inst_count) {
            let inst = prog.inst_of(block_row, k);
            if inst.op == O_HANDLE {
                let at = handle_graphs_at(in prog, w(inst.ops_at));
                let graph_count = prog.op(at);
                for j in 0..graph_count {
                    out.push(n32(prog.op(add(inc(at), j))));
                }
            }
        }
    }
}

fn own_handles(in prog: Prog, fun_index: u32) -> u64 {
    let func = prog.fun(fun_index);
    let mut n: u64 = 0;
    for block in 0..w(func.block_count) {
        let block_row = prog.block(func, block);
        for k in 0..w(block_row.inst_count) {
            if prog.inst_of(block_row, k).op == O_HANDLE {
                n = inc(n);
            }
        }
    }
    n
}

// `handles` (count = true) or the handler graphs' part of
// `cost_with_handlers` (count = false): over every graph `fun_index` holds,
// transitively, each once.
fn handler_sum(in prog: Prog, fun_index: u32, count: bool) -> u64 {
    let mut total: u64 = 0;
    if count {
        total = own_handles(in prog, fun_index);
    }
    let mut pending: ChunkSeq[u32] = ChunkSeq::new[u32]();
    handler_graphs(in prog, fun_index, inout pending);
    let mut seen = map_new(16);
    loop {
        let n = pending.len();
        if n == 0 {
            break;
        }
        let name = u32_at(in pending, sub(n, 1));
        pending.truncate(sub(n, 1));
        if seen.get(w(name)) != NONE32 {
            continue;
        }
        seen.set(w(name), 1);
        let graph_fun = prog.fun_index(name);
        if graph_fun == NONE32 {
            continue;
        }
        if count {
            total = add(total, own_handles(in prog, graph_fun));
        } else {
            total = add(total, cost(in prog, Tgt { fun_index: graph_fun, instance: NONE32 }));
        }
        handler_graphs(in prog, graph_fun, inout pending);
    }
    total
}

// ----- callee and caller rules ----------------------------------------------------

// `generic_body_ok`.
fn generic_body(in prog: Prog, func: Fun) -> u32 {
    for block in 0..w(func.block_count) {
        let block_row = prog.block(func, block);
        for k in 0..w(block_row.inst_count) {
            let inst = prog.inst_of(block_row, k);
            if inst.op == O_HANDLE {
                return R_GENERIC_HANDLER;
            }
            if inst.op == O_CALL && (prog.op(inc(w(inst.ops_at))) & 1) != 0 {
                return R_GENERIC_TYPES;
            }
            if (inst.op == O_CALL || inst.op == O_SEQ) && (inst.flags & I_GENERIC_CALL) != 0 {
                return R_GENERIC_CALLS;
            }
            if inst.op == O_UNARY
                || inst.op == O_BINARY
                || inst.op == O_INDEX
                || inst.op == O_PROJECT
            {
                return R_GENERIC_OPERATORS;
            }
        }
    }
    R_OK
}

// `inlinable`: callee properties that do not depend on the call site.
fn inlinable(in prog: Prog, fun_index: u32) -> u32 {
    let func = prog.fun(fun_index);
    let target = Tgt { fun_index: fun_index, instance: NONE32 };
    if (func.flags & W_WORLD) == 0 {
        return R_NOT_WORLD;
    }
    if (func.flags & W_FIP) != 0 {
        return R_FIP;
    }
    if (func.flags & W_DYN) != 0 {
        return R_DYN;
    }
    if (func.flags & W_GENERIC) != 0 {
        let why = generic_body(in prog, func);
        if why != R_OK {
            return why;
        }
    }
    if (func.flags & W_CAPTURES) != 0 {
        return R_CAPTURES;
    }
    if !fail_row_only(in prog, func.row) {
        return R_EFFECT_ROW;
    }
    if (func.flags & W_SLOTS) != 0 {
        return R_SLOTS;
    }
    if prog.has(func.result_ty, F_NEVER) {
        return R_NEVER;
    }
    if (func.flags & W_BORROWED_MATCH) != 0 {
        return R_BORROWED_MATCH;
    }
    if func.block_count == 0 || prog.block(func, 0).param_count != 0 {
        return R_ENTRY;
    }
    if any_type(in prog, target, F_BOX, true, true, true, true) {
        return R_BOX;
    }
    if any_type(in prog, target, F_FUNCTION, true, true, true, true) {
        return R_FUNCTION_TYPE;
    }
    for k in 0..w(func.param_count) {
        let param = prog.param(func, k);
        if param.pass == TyPass::Sink && prog.has(param.ty, F_SLICE) {
            return R_SINK_SLICE;
        }
    }
    for block in 0..w(func.block_count) {
        let block_row = prog.block(func, block);
        for k in 0..w(block_row.inst_count) {
            let inst = prog.inst_of(block_row, k);
            if inst.op == O_CLOSURE {
                return R_CLOSURE;
            }
            if inst.op == O_TRY {
                return R_TRY;
            }
            if inst.op == O_INDIRECT {
                return R_INDIRECT;
            }
            if inst.op == O_TILED || inst.op == O_FIP {
                return R_TILED;
            }
            if inst.op == O_EXIT && n32(prog.op(w(inst.ops_at))) != func.name {
                return R_FOREIGN_EXIT;
            }
        }
    }
    R_OK
}

// `caller_eligible`.
fn caller_eligible(in prog: Prog, fun_index: u32) -> bool {
    let func = prog.fun(fun_index);
    if (func.flags & W_WORLD) != 0 && (func.flags & W_FIP) != 0 {
        return false;
    }
    if (func.flags & W_SLOTS) != 0 || row_has_capability(in prog, func.row) {
        return false;
    }
    ! any_type(
        in prog,
        Tgt { fun_index: fun_index, instance: NONE32 },
        F_BOX,
        true,
        true,
        true,
        false
    )
}

// ----- literal constants ----------------------------------------------------------

// `fold_literal_constants`: calls of a constant function that returns one
// literal become that literal. Returns the uses replaced.
fn fold_literal_constants(inout prog: Prog) -> u64 {
    let fun_count = prog.funs.len();
    // function -> its literal instruction, or NONE32
    let mut literal = fill32(fun_count, NONE32);
    let mut any = false;
    for fun_index in 0..fun_count {
        let func = prog.fun(n32(fun_index));
        if func.param_count != 0
            || func.block_count != 1
            || !is_const_function(in prog, func.name)
        {
            continue;
        }
        let block_row = prog.block(func, 0);
        if block_row.inst_count != 1 || block_row.term != T_RETURN {
            continue;
        }
        let id = prog.id(w(block_row.inst_start));
        let inst = prog.inst(id);
        if w(inst.dest) == prog.op(w(block_row.term_at))
            && (inst.flags & I_FALLIBLE) == 0
            && inst.op == O_CONST
        {
            set_u32(inout literal, fun_index, id);
            any = true;
        }
    }
    if !any {
        return 0;
    }
    let mut folded: u64 = 0;
    for fun_index in 0..fun_count {
        if !caller_eligible(in prog, n32(fun_index)) {
            continue;
        }
        let func = prog.fun(n32(fun_index));
        for block in 0..w(func.block_count) {
            let block_row = prog.block(func, block);
            for k in 0..w(block_row.inst_count) {
                let id = prog.id(add(w(block_row.inst_start), k));
                let inst = prog.inst(id);
                if inst.op != O_CALL {
                    continue;
                }
                let ops_at = w(inst.ops_at);
                if prog.op(add(ops_at, 2)) != 0 {
                    continue;
                }
                let callee = prog.fun_index(n32(prog.op(ops_at)));
                if callee == NONE32 {
                    continue;
                }
                let lit_id = u32_at(in literal, w(callee));
                if lit_id == NONE32 {
                    continue;
                }
                let lit_inst = prog.inst(lit_id);
                let ok = prog.insts.try_set(
                    w(id),
                    Inst {
                        dest: inst.dest,
                        ty: inst.ty,
                        span_start: inst.span_start,
                        span_end: inst.span_end,
                        flags: inst.flags & I_GENERIC_CALL,
                        opaque: lit_inst.opaque,
                        op: O_CONST,
                        ops_at: lit_inst.ops_at
                    }
                );
                folded = inc(folded);
            }
        }
    }
    folded
}

// ----- the call graph ---------------------------------------------------------------

// petgraph's `DiGraphMap` as `inline` builds it: nodes in the order they
// first appear (as a node or an edge end), each node's distinct successors
// in the order their edges were first added.
pub struct Graph {
    // node position -> function index
    nodes: ChunkSeq[u32],
    // function index -> node position
    node_of: ChunkSeq[u32],
    // adjacency: per node a linked list of edges in insertion order, from
    // `first_edge` to `last_edge`; edge `e` goes to node `edge_to[e]` and is
    // followed by `edge_next[e]`
    first_edge: ChunkSeq[u32],
    last_edge: ChunkSeq[u32],
    edge_to: ChunkSeq[u32],
    edge_next: ChunkSeq[u32],
    // the (caller, callee) pairs already added
    edges: MapU,
    // 1 for a node with an edge to itself
    self_edge: ChunkSeq[u8],
}

fn graph_new(functions: u64) -> Graph {
    Graph {
        nodes: ChunkSeq::new[u32](),
        node_of: fill32(functions, NONE32),
        first_edge: ChunkSeq::new[u32](),
        last_edge: ChunkSeq::new[u32](),
        edge_to: ChunkSeq::new[u32](),
        edge_next: ChunkSeq::new[u32](),
        edges: map_new(1024),
        self_edge: ChunkSeq::new[u8]()
    }
}

impl Graph {
    // The node of function `fun_index`, added if it is new.
    fn node(inout self, fun_index: u32) -> u32 {
        let existing = u32_at(in self.node_of, w(fun_index));
        if existing != NONE32 {
            return existing;
        }
        let position = n32(self.nodes.len());
        self.nodes.push(fun_index);
        set_u32(inout self.node_of, w(fun_index), position);
        self.first_edge.push(NONE32);
        self.last_edge.push(NONE32);
        self.self_edge.push(0);
        position
    }

    // Adds the edge from function `caller` to function `callee` unless it is there.
    fn edge(inout self, caller: u32, callee: u32) {
        let from = self.node(caller);
        let key = pair(caller, callee);
        if self.edges.get(key) != NONE32 {
            return;
        }
        self.edges.set(key, 1);
        let to = self.node(callee);
        let edge_id = n32(self.edge_to.len());
        self.edge_to.push(to);
        self.edge_next.push(NONE32);
        let last = u32_at(in self.last_edge, w(from));
        if last == NONE32 {
            set_u32(inout self.first_edge, w(from), edge_id);
        } else {
            set_u32(inout self.edge_next, w(last), edge_id);
        }
        set_u32(inout self.last_edge, w(from), edge_id);
        if caller == callee {
            set_u8(inout self.self_edge, w(from), 1);
        }
    }
}

// petgraph's `TarjanScc` (Pearce's variant), components callees first.
pub struct Tarjan {
    visit_index: u64,
    // the next component number, counting down from MAX64
    next_component: u64,
    // per node: 0 unvisited, its visit index while open, then its component
    root: ChunkSeq[u64],
    stack: ChunkSeq[u32],
    // components: members component_nodes[component_starts[c]..component_starts[c+1]]
    component_starts: ChunkSeq[u32],
    component_nodes: ChunkSeq[u32],
}

impl Tarjan {
    fn root_of(in self, node: u32) -> u64 {
        u64_at(in self.root, w(node))
    }

    fn set_root(inout self, node: u32, root: u64) {
        set_u64(inout self.root, w(node), root);
    }

    fn components(in self) -> u64 {
        sub(self.component_starts.len(), 1)
    }

    // Closes the component rooted at `node`: it and the stacked nodes above its
    // root index, which are popped.
    fn close_component(inout self, node: u32) {
        let mut popped: u64 = 1;
        let component = self.next_component;
        let node_root = self.root_of(node);
        let mut start: u64 = 0;
        let mut depth = self.stack.len();
        loop {
            if depth == 0 {
                break;
            }
            let stacked = u32_at(in self.stack, sub(depth, 1));
            if node_root > self.root_of(stacked) {
                start = depth;
                break;
            }
            self.set_root(stacked, component);
            popped = inc(popped);
            depth = sub(depth, 1);
        }
        self.set_root(node, component);
        self.stack.push(node);
        self.component_starts.push(n32(self.component_nodes.len()));
        for j in start..self.stack.len() {
            self.component_nodes.push(u32_at(in self.stack, j));
        }
        self.stack.truncate(start);
        self.visit_index = sub(self.visit_index, popped);
        self.next_component = sub(self.next_component, 1);
    }
}

fn visit(in graph: Graph, inout scc: Tarjan, node: u32) {
    let mut local_root = true;
    scc.set_root(node, scc.visit_index);
    scc.visit_index = inc(scc.visit_index);
    let mut edge = u32_at(in graph.first_edge, w(node));
    loop {
        if edge == NONE32 {
            break;
        }
        let successor = u32_at(in graph.edge_to, w(edge));
        if scc.root_of(successor) == 0 {
            visit(in graph, inout scc, successor);
        }
        if scc.root_of(successor) < scc.root_of(node) {
            scc.set_root(node, scc.root_of(successor));
            local_root = false;
        }
        edge = u32_at(in graph.edge_next, w(edge));
    }
    if local_root {
        scc.close_component(node);
    } else {
        scc.stack.push(node);
    }
}

fn tarjan(in graph: Graph) -> Tarjan {
    let mut scc = Tarjan {
        visit_index: 1,
        next_component: MAX64,
        root: zeros64(graph.nodes.len()),
        stack: ChunkSeq::new[u32](),
        component_starts: ChunkSeq::new[u32](),
        component_nodes: ChunkSeq::new[u32](),
    };
    for node in 0..graph.nodes.len() {
        if u64_at(in scc.root, node) == 0 {
            visit(in graph, inout scc, n32(node));
        }
    }
    scc.component_starts.push(n32(scc.component_nodes.len()));
    scc
}

// ----- call sites ---------------------------------------------------------------------

// How each callee parameter is supplied (`Binding`): bound by value to a
// fresh local, or replaced by the caller's place (an operand-pool offset:
// root, path length, path).
pub struct Bindings {
    by_place: ChunkSeq[u8],
    arg_values: ChunkSeq[u32],
    place_at: ChunkSeq[u64],
}

fn bindings_new() -> Bindings {
    Bindings {
        by_place: ChunkSeq::new[u8](),
        arg_values: ChunkSeq::new[u32](),
        place_at: ChunkSeq::new[u64]()
    }
}

impl Bindings {
    fn push(inout self, by_place: bool, value: u32, place_at: u64) {
        self.by_place.push(if by_place { 1 } else { 0 });
        self.arg_values.push(value);
        self.place_at.push(place_at);
    }

    fn is_place(in self, k: u64) -> bool {
        u8_at(in self.by_place, k) != 0
    }
}

// `row_within`: callee `fun_index` with row `callee_row` may be inlined into a caller
// with row `caller_row`. Its row is empty or the caller's, or every instance of
// its row (unlabeled `Fail` only) is in the caller's row and the callee
// raises only by error type: no loop, no handler and no effect operation
// (a call of anything that is not a program function), since `Fail::raise`
// performs the innermost `Fail` in scope (#1502).
fn row_within(in prog: Prog, fun_index: u32, callee_row: u32, caller_row: u32) -> bool {
    if prog.row_count(callee_row) == 0 || callee_row == caller_row {
        return true;
    }
    if !fail_row_only(in prog, callee_row) || raises_untyped(in prog, fun_index) {
        return false;
    }
    let row_at = w(u32_at(in prog.row_starts, w(callee_row)));
    let caller_at = w(u32_at(in prog.row_starts, w(caller_row)));
    let caller_count = u64_at(in prog.row_words, caller_at);
    for i in 0..prog.row_count(callee_row) {
        let key = u64_at(in prog.row_words, add(inc(row_at), add(wrapping_mul(i, ROW_STRIDE), 3)));
        let mut found = false;
        for j in 0..caller_count {
            if u64_at(in prog.row_words, add(inc(caller_at), add(wrapping_mul(j, ROW_STRIDE), 3)))
                == key
            {
                found = true;
            }
        }
        if !found {
            return false;
        }
    }
    true
}

// Whether function `fun_index`'s body has a loop header, a handler or an effect
// operation.
fn raises_untyped(in prog: Prog, fun_index: u32) -> bool {
    let func = prog.fun(fun_index);
    for block in 0..w(func.block_count) {
        let block_row = prog.block(func, block);
        for k in 0..w(block_row.inst_count) {
            let inst = prog.inst_of(block_row, k);
            if inst.op == O_LOOP || inst.op == O_HANDLE {
                return true;
            }
            if inst.op == O_CALL && prog.fun_index(n32(prog.op(w(inst.ops_at)))) == NONE32 {
                return true;
            }
        }
    }
    false
}

// `site_bindings`: the bindings for a call, or why it stays a call.
fn site_bindings(
    in prog: Prog,
    caller_index: u32,
    target: Tgt,
    dest: u32,
    arg_list_at: u64,
    inout out: Bindings
) -> u32 {
    let caller = prog.fun(caller_index);
    let func = prog.fun(target.fun_index);
    let arg_count = prog.op(arg_list_at);
    if arg_count != w(func.param_count)
        || prog.value_ty(caller, w(dest)) != prog.map(target.instance, func.result_ty)
    {
        return R_SITE_SIGNATURE;
    }
    let row = prog.row_of(target);
    if !row_within(in prog, target.fun_index, row, caller.row) {
        return R_SITE_ROW;
    }
    if caller.bound_count != 0 {
        let mut generics: ChunkSeq[u32] = ChunkSeq::new[u32]();
        for k in 0..w(caller.bound_count) {
            generics.push(prog.id(add(w(caller.bound_start), k)));
        }
        for v in 0..w(func.value_count) {
            let callee_ty = prog.value_ty(func, v);
            if callee_ty != NONE32
                && mentions_names(in prog, prog.map(target.instance, callee_ty), in generics)
            {
                return R_SITE_GENERICS;
            }
        }
        for k in 0..w(func.local_count) {
            let callee_ty = u32_at(in prog.local_types, add(w(func.local_start), k));
            if mentions_names(in prog, prog.map(target.instance, callee_ty), in generics) {
                return R_SITE_GENERICS;
            }
        }
    }
    let mut at = inc(arg_list_at);
    for k in 0..arg_count {
        let value = n32(prog.op(at));
        let has_place = prog.op(add(at, 2)) != 0;
        let place_at = add(at, 3);
        let local = has_place && prog.local_ty(caller, n32(prog.op(place_at))) != NONE32;
        let param = prog.param(func, k);
        let ty = prog.map(target.instance, param.ty);
        let aggregate = prog.has(ty, F_AGGREGATE);
        let sequence = prog.has(ty, F_SEQUENCE);
        if prog.has(ty, F_SLICE) {
            let same = local
                && prog.op(inc(place_at)) == 0
                && prog.local_ty(caller, n32(prog.op(place_at))) == ty;
            out.push(same, value, place_at);
        } else if param.pass == TyPass::Inout {
            if !local {
                return R_SITE_INOUT;
            }
            out.push(true, value, place_at);
        } else if param.pass == TyPass::In && (aggregate || sequence) {
            if local {
                out.push(true, value, place_at);
            } else if !sequence {
                out.push(false, value, place_at);
            } else {
                return R_SITE_SEQUENCE;
            }
        } else {
            out.push(false, value, place_at);
        }
        at = arg_end(in prog, at);
    }
    if own_handles(in prog, target.fun_index) > 0 {
        for k in 0..arg_count {
            if out.is_place(k) && prog.op(inc(u64_at(in out.place_at, k))) != 0 {
                return R_SITE_FIELD;
            }
        }
    }
    // A borrowed parameter is replaced by the caller's place, so the callee
    // must never re-bind its name.
    let mut replaced: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for k in 0..arg_count {
        if out.is_place(k) {
            replaced.push(prog.param(func, k).name);
        }
    }
    if replaced.len() > 0 {
        let mut bound: ChunkSeq[u32] = ChunkSeq::new[u32]();
        for block in 0..w(func.block_count) {
            let block_row = prog.block(func, block);
            for k in 0..w(block_row.inst_count) {
                let inst = prog.inst_of(block_row, k);
                if inst.op == O_BIND {
                    pattern_binds(in prog, prog.op(inc(w(inst.ops_at))), inout bound);
                }
            }
            if block_row.term == T_MATCH {
                let term_at = w(block_row.term_at);
                let arms = prog.op(inc(term_at));
                for j in 0..arms {
                    pattern_binds(
                        in prog,
                        prog.op(add(add(term_at, 2), wrapping_mul(j, 2))),
                        inout bound
                    );
                }
            }
        }
        for j in 0..bound.len() {
            let bound_name = u32_at(in bound, j);
            for k in 0..replaced.len() {
                if u32_at(in replaced, k) == bound_name {
                    return R_SITE_REBIND;
                }
            }
        }
    }
    R_OK
}

// `partial_ok`: every by-value argument can be passed twice.
fn partial_ok(in prog: Prog, target: Tgt, in bindings: Bindings) -> bool {
    let func = prog.fun(target.fun_index);
    for k in 0..w(func.param_count) {
        if bindings.is_place(k) {
            continue;
        }
        let ty = prog.map(target.instance, prog.param(func, k).ty);
        if !prog.has(ty, F_SLICE) && !prog.has(ty, F_PLAIN) {
            return false;
        }
    }
    true
}

// ----- site folding (site.rs `fold`) ------------------------------------------------

// A value the site's arguments determine: 0 unknown, 1 an integer (lo, hi
// as an i128), 2 a bool (lo), 3 a nullary constructor (lo: its short name).
pub copy struct Kn {
    kind: u8,
    lo: u64,
    hi: u64,
}

fn unknown() -> Kn {
    Kn { kind: 0, lo: 0, hi: 0 }
}

fn kn_at(in seq: ChunkSeq[Kn], i: u64) -> Kn {
    match seq.try_get(i) {
        Option::Some(known) => known,
        Option::None => unknown(),
    }
}

fn kn_eq(left: Kn, right: Kn) -> bool {
    left.kind == right.kind && left.lo == right.lo && left.hi == right.hi
}

fn set_kn(inout seq: ChunkSeq[Kn], i: u64, known: Kn) {
    let ok = seq.try_set(i, known);
}

// `site::constant`.
fn constant(inout prog: Prog, target: Tgt, inst: Inst) -> Kn {
    let ops_at = w(inst.ops_at);
    if inst.op == O_CONST {
        let kind = prog.op(ops_at);
        if kind == L_INT {
            return Kn { kind: 1, lo: prog.op(inc(ops_at)), hi: prog.op(add(ops_at, 2)) };
        }
        if kind == L_BOOL {
            return Kn { kind: 2, lo: prog.op(inc(ops_at)), hi: 0 };
        }
        return unknown();
    }
    if inst.op == O_DATA
        && prog.op(inc(ops_at)) == 0
        && prog.has(prog.map(target.instance, inst.ty), F_PLAIN)
    {
        let short_name = short(inout prog, n32(prog.op(ops_at)));
        return Kn { kind: 3, lo: w(short_name), hi: 0 };
    }
    unknown()
}

// Signed 128-bit comparison: -1, 0 or 1.
fn cmp128(lhs: Kn, rhs: Kn) -> i64 {
    let lhs_high = lhs.hi ^ 9223372036854775808;
    let rhs_high = rhs.hi ^ 9223372036854775808;
    if lhs_high < rhs_high {
        return -1;
    }
    if lhs_high > rhs_high {
        return 1;
    }
    if lhs.lo < rhs.lo {
        return -1;
    }
    if lhs.lo > rhs.lo {
        return 1;
    }
    0
}

// `site::binary`: comparison codes 1 `==`, 2 `!=`, 3 `<`, 4 `<=`, 5 `>`,
// 6 `>=`.
fn binary(code: u64, lhs: Kn, rhs: Kn) -> Kn {
    let equality = code == 1 || code == 2;
    let mut order: i64 = 0;
    if lhs.kind == 1 && rhs.kind == 1 {
        order = cmp128(lhs, rhs);
    } else if lhs.kind == 2 && rhs.kind == 2 && equality {
        if lhs.lo < rhs.lo {
            order = -1;
        } else if lhs.lo > rhs.lo {
            order = 1;
        }
    } else if lhs.kind == 3 && rhs.kind == 3 && equality {
        if lhs.lo != rhs.lo {
            order = -1;
        }
    } else {
        return unknown();
    }
    let holds = if code == 1 {
        order == 0
    } else if code == 2 {
        order != 0
    } else if code == 3 {
        order < 0
    } else if code == 4 {
        order <= 0
    } else if code == 5 {
        order > 0
    } else if code == 6 {
        order >= 0
    } else {
        return unknown();
    };
    Kn { kind: 2, lo: if holds { 1 } else { 0 }, hi: 0 }
}

// `site::arm`: the arm a known value takes, NONE32 when undecided.
fn arm(inout prog: Prog, term_at: u64, known: Kn) -> u32 {
    let arm_count = prog.op(inc(term_at));
    for j in 0..arm_count {
        let at = prog.op(add(add(term_at, 2), wrapping_mul(j, 2)));
        let kind = prog.pat(at);
        let mut hit = false;
        if kind == PK_WILD || kind == PK_BIND {
            hit = true;
        } else if kind == PK_CTOR && known.kind == 3 {
            hit = w(short(inout prog, n32(prog.pat(add(at, 3))))) == known.lo;
        } else if kind == PK_LIT && prog.pat(add(at, 3)) == L_INT && known.kind == 1 {
            hit = prog.pat(add(at, 4)) == known.lo && prog.pat(add(at, 5)) == known.hi;
        } else if kind == PK_LIT && prog.pat(add(at, 3)) == L_BOOL && known.kind == 2 {
            hit = prog.pat(add(at, 4)) == known.lo;
        } else {
            return NONE32;
        }
        if hit {
            return n32(j);
        }
    }
    NONE32
}

// An association list from names to known values (locals of one fold).
pub struct Assoc {
    keys: ChunkSeq[u32],
    values: ChunkSeq[Kn],
}

fn assoc_new() -> Assoc {
    Assoc { keys: ChunkSeq::new[u32](), values: ChunkSeq::new[Kn]() }
}

impl Assoc {
    fn find(in self, key: u32) -> u64 {
        for i in 0..self.keys.len() {
            if u32_at(in self.keys, i) == key {
                return i;
            }
        }
        MAX64
    }

    fn get(in self, key: u32) -> Kn {
        let slot = self.find(key);
        if slot == MAX64 {
            return unknown();
        }
        kn_at(in self.values, slot)
    }

    fn set(inout self, key: u32, value: Kn) {
        let slot = self.find(key);
        if slot == MAX64 {
            self.keys.push(key);
            self.values.push(value);
        } else {
            let ok = self.values.try_set(slot, value);
        }
    }
}

// `stable_locals`: names bound once (or a parameter never re-bound), never
// written or lent `inout`; empty when the callee has a handle or closure.
fn stable_locals(in prog: Prog, func: Fun, inout out: ChunkSeq[u32]) {
    let mut slot_of = map_new(64);
    let mut distinct: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut counts: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut unstable = map_new(16);
    let mut bound: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for k in 0..w(func.param_count) {
        bound.push(prog.param(func, k).name);
    }
    for block in 0..w(func.block_count) {
        let block_row = prog.block(func, block);
        for k in 0..w(block_row.inst_count) {
            let inst = prog.inst_of(block_row, k);
            let ops_at = w(inst.ops_at);
            if inst.op == O_BIND {
                pattern_binds(in prog, prog.op(inc(ops_at)), inout bound);
            } else if inst.op == O_WRITE {
                unstable.set(prog.op(inc(ops_at)), 1);
            } else if has_args(inst.op) {
                let start = args_at(inst.op, ops_at);
                let arg_count = prog.op(start);
                let mut at = inc(start);
                for j in 0..arg_count {
                    if prog.op(inc(at)) == TyPass::Inout && prog.op(add(at, 2)) != 0 {
                        unstable.set(prog.op(add(at, 3)), 1);
                    }
                    at = arg_end(in prog, at);
                }
            } else if inst.op == O_HANDLE || inst.op == O_CLOSURE {
                out.clear();
                return;
            }
        }
        if block_row.term == T_MATCH {
            let term_at = w(block_row.term_at);
            let arms = prog.op(inc(term_at));
            for j in 0..arms {
                pattern_binds(
                    in prog,
                    prog.op(add(add(term_at, 2), wrapping_mul(j, 2))),
                    inout bound
                );
            }
        }
    }
    // Rust counts binds per name in a BTreeMap (parameters once each).
    for j in 0..bound.len() {
        let name = u32_at(in bound, j);
        let slot = slot_of.get(w(name));
        if slot == NONE32 {
            slot_of.set(w(name), n32(distinct.len()));
            distinct.push(name);
            counts.push(1);
        } else {
            set_u32(inout counts, w(slot), inc32(u32_at(in counts, w(slot))));
        }
    }
    out.clear();
    for j in 0..distinct.len() {
        let name = u32_at(in distinct, j);
        if u32_at(in counts, j) == 1 && unstable.get(w(name)) == NONE32 {
            out.push(name);
        }
    }
}

// One past the largest value id `func` defines or types (`splice`'s
// `next_value` / `callee_values`).
fn value_bound(in prog: Prog, func: Fun) -> u64 {
    let mut top: u64 = 0;
    let mut any = false;
    for v in 0..w(func.value_count) {
        if u32_at(in prog.value_types, add(w(func.value_start), v)) != 0 {
            top = v;
            any = true;
        }
    }
    for block in 0..w(func.block_count) {
        let block_row = prog.block(func, block);
        for k in 0..w(block_row.inst_count) {
            let defined = w(prog.inst_of(block_row, k).dest);
            if !any || defined > top {
                top = defined;
                any = true;
            }
        }
        for k in 0..w(block_row.param_count) {
            let defined = w(prog.id(add(w(block_row.param_start), k)));
            if !any || defined > top {
                top = defined;
                any = true;
            }
        }
    }
    if any { inc(top) } else { 0 }
}

// The seeds of a fold: the caller's constants passed by value to stable
// locals, by parameter name (`seeds`, filtered by `stable_locals`).
fn fold_seeds(
    inout prog: Prog,
    caller_index: u32,
    target: Tgt,
    in bindings: Bindings,
    in stable: ChunkSeq[u32]
) -> Assoc {
    let caller = prog.fun(caller_index);
    let func = prog.fun(target.fun_index);
    let mut kept = assoc_new();
    // defs of the wanted values, last definition wins
    let mut defs = map_new(16);
    for k in 0..w(func.param_count) {
        if !bindings.is_place(k) {
            defs.set(w(u32_at(in bindings.arg_values, k)), NONE32);
        }
    }
    for block in 0..w(caller.block_count) {
        let block_row = prog.block(caller, block);
        for k in 0..w(block_row.inst_count) {
            let id = prog.id(add(w(block_row.inst_start), k));
            let dest = w(prog.inst(id).dest);
            if defs_has(in defs, dest) {
                defs.set(dest, id);
            }
        }
    }
    let caller_target = Tgt { fun_index: caller_index, instance: NONE32 };
    let mut seeds = assoc_new();
    for k in 0..w(func.param_count) {
        if bindings.is_place(k) {
            continue;
        }
        let id = defs.get(w(u32_at(in bindings.arg_values, k)));
        if id == NONE32 {
            continue;
        }
        let known = constant(inout prog, caller_target, prog.inst(id));
        if known.kind != 0 {
            seeds.set(prog.param(func, k).name, known);
        }
    }
    for j in 0..seeds.keys.len() {
        let name = u32_at(in seeds.keys, j);
        if contains32(in stable, name) {
            kept.set(name, kn_at(in seeds.values, j));
        }
    }
    kept
}

fn contains32(in seq: ChunkSeq[u32], value: u32) -> bool {
    for k in 0..seq.len() {
        if u32_at(in seq, k) == value {
            return true;
        }
    }
    false
}

// One round of a fold: live blocks, decided terminators, known values and
// the jump arguments reaching each block.
pub struct Round {
    locals: Assoc,
    values: ChunkSeq[Kn],
    live: ChunkSeq[u8],
    jumps: ChunkSeq[u32],
    jump_count: u64,
    first_incoming: ChunkSeq[u32],
    last_incoming: ChunkSeq[u32],
    incoming_args: ChunkSeq[u64],
    next_incoming: ChunkSeq[u32],
}

// The value an instruction folds to, given the round so far.
fn eval_inst(
    inout prog: Prog,
    target: Tgt,
    inst: Inst,
    inout round: Round,
    in stable: ChunkSeq[u32]
) -> Kn {
    let ops_at = w(inst.ops_at);
    if inst.op == O_CONST || inst.op == O_DATA {
        return constant(inout prog, target, inst);
    }
    if inst.op == O_READ {
        if prog.op(inc(ops_at)) == 0 {
            return round.locals.get(n32(prog.op(ops_at)));
        }
        return unknown();
    }
    if inst.op == O_UNARY {
        if prog.op(ops_at) == 1 {
            let known = kn_at(in round.values, prog.op(inc(ops_at)));
            if known.kind == 2 {
                return Kn { kind: 2, lo: 1 ^ known.lo, hi: 0 };
            }
        }
        return unknown();
    }
    if inst.op == O_BINARY {
        if (inst.flags & I_FALLIBLE) == 0 {
            let lhs = kn_at(in round.values, prog.op(inc(ops_at)));
            let rhs = kn_at(in round.values, prog.op(add(ops_at, 2)));
            if lhs.kind != 0 && rhs.kind != 0 {
                return binary(prog.op(ops_at), lhs, rhs);
            }
        }
        return unknown();
    }
    if inst.op == O_BIND {
        let at = prog.op(inc(ops_at));
        if prog.pat(at) == PK_BIND {
            let name = n32(prog.pat(add(at, 3)));
            let known = kn_at(in round.values, prog.op(ops_at));
            if known.kind != 0 && contains32(in stable, name) {
                round.locals.set(name, known);
            }
        }
    }
    unknown()
}

fn decide(inout round: Round, block: u64, target: u32, inout succ: ChunkSeq[u32]) {
    set_u32(inout round.jumps, block, target);
    round.jump_count = inc(round.jump_count);
    succ.push(target);
}

// The successors a block's terminator leads to in this round.
fn eval_terminator(
    inout prog: Prog,
    block_row: Blk,
    block: u64,
    inout round: Round,
    inout succ: ChunkSeq[u32]
) {
    let term_at = w(block_row.term_at);
    if block_row.term == T_BRANCH {
        let known = kn_at(in round.values, prog.op(term_at));
        let yes = n32(prog.op(inc(term_at)));
        let no = n32(prog.op(add(term_at, 2)));
        if known.kind == 2 && known.lo == 1 {
            decide(inout round, block, yes, inout succ);
        } else if known.kind == 2 {
            decide(inout round, block, no, inout succ);
        } else {
            succ.push(yes);
            succ.push(no);
        }
    } else if block_row.term == T_MATCH {
        let known = kn_at(in round.values, prog.op(term_at));
        let mut taken = NONE32;
        if known.kind != 0 {
            taken = arm(inout prog, term_at, known);
            if taken != NONE32
                && pattern_binds_any(
                    in prog,
                    prog.op(add(add(term_at, 2), wrapping_mul(w(taken), 2)))
                )
            {
                taken = NONE32;
            }
        }
        if taken != NONE32 {
            let target = n32(prog.op(add(add(term_at, 3), wrapping_mul(w(taken), 2))));
            decide(inout round, block, target, inout succ);
        } else {
            successors(in prog, block_row, inout succ);
        }
    } else if block_row.term == T_JUMP {
        let target = prog.op(term_at);
        let edge = n32(round.incoming_args.len());
        round.incoming_args.push(inc(term_at));
        round.next_incoming.push(NONE32);
        let tail = u32_at(in round.last_incoming, target);
        if tail == NONE32 {
            set_u32(inout round.first_incoming, target, edge);
        } else {
            set_u32(inout round.next_incoming, w(tail), edge);
        }
        set_u32(inout round.last_incoming, target, edge);
        succ.push(n32(target));
    }
}

// Visits the live blocks once each, in discovery order.
fn fold_round(
    inout prog: Prog,
    target: Tgt,
    in kept: Assoc,
    in stable: ChunkSeq[u32],
    in params: ChunkSeq[Kn]
) -> Round {
    let block_count = w(prog.fun(target.fun_index).block_count);
    let mut round = Round {
        locals: assoc_new(),
        values: ChunkSeq::new[Kn](),
        live: zeros8(block_count),
        jumps: fill32(block_count, NONE32),
        jump_count: 0,
        first_incoming: fill32(block_count, NONE32),
        last_incoming: fill32(block_count, NONE32),
        incoming_args: ChunkSeq::new[u64](),
        next_incoming: ChunkSeq::new[u32]()
    };
    for j in 0..kept.keys.len() {
        round.locals.set(u32_at(in kept.keys, j), kn_at(in kept.values, j));
    }
    round.values.extend(in params.as_slice());
    set_u8(inout round.live, 0, 1);
    let mut work: ChunkSeq[u32] = ChunkSeq::new[u32]();
    work.push(0);
    let mut seen = zeros8(block_count);
    let mut succ: ChunkSeq[u32] = ChunkSeq::new[u32]();
    loop {
        let pending = work.len();
        if pending == 0 {
            break;
        }
        let block = w(u32_at(in work, sub(pending, 1)));
        work.truncate(sub(pending, 1));
        if u8_at(in seen, block) != 0 {
            continue;
        }
        set_u8(inout seen, block, 1);
        let block_row = prog.block(prog.fun(target.fun_index), block);
        let mut ends = false;
        for k in 0..w(block_row.inst_count) {
            let inst = prog.inst_of(block_row, k);
            if inst.op == O_EXIT {
                ends = true;
            }
        }
        for k in 0..w(block_row.inst_count) {
            let inst = prog.inst_of(block_row, k);
            let known = eval_inst(inout prog, target, inst, inout round, in stable);
            if known.kind != 0 {
                set_kn(inout round.values, w(inst.dest), known);
            }
            if inst.op == O_EXIT {
                break;
            }
        }
        succ.clear();
        if !ends {
            eval_terminator(inout prog, block_row, block, inout round, inout succ);
        }
        for j in 0..succ.len() {
            let successor = u32_at(in succ, j);
            set_u8(inout round.live, w(successor), 1);
            work.push(successor);
        }
    }
    round
}

// Block parameters: known when every live predecessor passes the same known
// value.
fn round_params(in prog: Prog, func: Fun, in round: Round, value_count: u64) -> ChunkSeq[Kn] {
    let mut next: ChunkSeq[Kn] = ChunkSeq::new[Kn]();
    next.resize(value_count, unknown());
    for block in 0..w(func.block_count) {
        let block_row = prog.block(func, block);
        if u8_at(in round.live, block) == 0 || block_row.param_count == 0 {
            continue;
        }
        let head = u32_at(in round.first_incoming, block);
        if head == NONE32 {
            continue;
        }
        for index in 0..w(block_row.param_count) {
            let mut agreed = unknown();
            let mut good = true;
            let mut edge = head;
            loop {
                if edge == NONE32 {
                    break;
                }
                let at = u64_at(in round.incoming_args, w(edge));
                let mut passed = unknown();
                if index < prog.op(at) {
                    passed = kn_at(in round.values, prog.op(add(inc(at), index)));
                }
                if passed.kind != 0 && (agreed.kind == 0 || kn_eq(agreed, passed)) {
                    agreed = passed;
                } else {
                    good = false;
                }
                edge = u32_at(in round.next_incoming, w(edge));
            }
            if good && agreed.kind != 0 {
                set_kn(inout next, w(prog.id(add(w(block_row.param_start), index))), agreed);
            }
        }
    }
    next
}

fn same_kns(in left: ChunkSeq[Kn], in right: ChunkSeq[Kn], n: u64) -> bool {
    for v in 0..n {
        if !kn_eq(kn_at(in left, v), kn_at(in right, v)) {
            return false;
        }
    }
    true
}

fn same_round(in left: Round, in right: Round, block_count: u64, value_count: u64) -> bool {
    for k in 0..block_count {
        if u8_at(in left.live, k) != u8_at(in right.live, k)
            || u32_at(in left.jumps, k) != u32_at(in right.jumps, k)
        {
            return false;
        }
    }
    same_kns(in left.values, in right.values, value_count)
}

// `site::fold`. `settled` is false when there is nothing to fold or the
// propagation did not settle (the result is then `folded_none`).
fn fold(
    inout prog: Prog,
    caller_index: u32,
    target: Tgt,
    in bindings: Bindings,
    inout settled: bool
) -> Folded {
    settled = false;
    let func = prog.fun(target.fun_index);
    let block_count = w(func.block_count);
    let mut wanted = false;
    for k in 0..w(func.param_count) {
        if !bindings.is_place(k) {
            wanted = true;
        }
    }
    if !wanted {
        return folded_none(block_count);
    }
    let mut stable: ChunkSeq[u32] = ChunkSeq::new[u32]();
    stable_locals(in prog, func, inout stable);
    let kept = fold_seeds(inout prog, caller_index, target, in bindings, in stable);
    if kept.keys.len() == 0 {
        return folded_none(block_count);
    }
    let value_count = value_bound(in prog, func);
    let mut params: ChunkSeq[Kn] = ChunkSeq::new[Kn]();
    params.resize(value_count, unknown());
    let mut prev = fold_round(inout prog, target, in kept, in stable, in params);
    params = round_params(in prog, func, in prev, value_count);
    for round in 1..FOLD_ROUNDS {
        let current = fold_round(inout prog, target, in kept, in stable, in params);
        let next = round_params(in prog, func, in current, value_count);
        if same_round(in current, in prev, block_count, value_count)
            && same_kns(in next, in params, value_count)
        {
            let mut known = zeros8(value_count);
            for v in 0..value_count {
                if kn_at(in current.values, v).kind != 0 {
                    set_u8(inout known, v, 1);
                }
            }
            settled = true;
            return Folded {
                live: current.live,
                jumps: current.jumps,
                known: known,
                jump_count: current.jump_count
            };
        }
        prev = current;
        params = next;
    }
    folded_none(block_count)
}

fn defs_has(in map: MapU, key: u64) -> bool {
    let mut at = hash64(key) & map.mask;
    loop {
        if u8_at(in map.used, at) == 0 {
            return false;
        }
        if u64_at(in map.keys, at) == key {
            return true;
        }
        at = inc(at) & map.mask;
    }
}

// ----- partial inlining (site.rs `split`) ------------------------------------------

pub struct Split {
    found: bool,
    branch_block: u32,
    cold_target: u32,
    hot_blocks: ChunkSeq[u8],
    hot_cost: u64,
    cold_cost: u64,
}

fn no_split() -> Split {
    Split {
        found: false,
        branch_block: 0,
        cold_target: 0,
        hot_blocks: ChunkSeq::new[u8](),
        hot_cost: 0,
        cold_cost: 0
    }
}

// `site::pure`: an instruction a head may run twice.
fn pure(in prog: Prog, target: Tgt, func: Fun, inst: Inst) -> bool {
    if (inst.flags & I_FALLIBLE) != 0 {
        return false;
    }
    if inst.op == O_CONST || inst.op == O_UNIT {
        return true;
    }
    if inst.op == O_READ
        || inst.op == O_BINARY
        || inst.op == O_UNARY
        || inst.op == O_PROJECT
        || inst.op == O_DATA
        || inst.op == O_TUPLE
    {
        return prog.has(prog.map(target.instance, inst.ty), F_PLAIN);
    }
    if inst.op == O_BIND {
        let ty = prog.value_ty(func, prog.op(w(inst.ops_at)));
        return ty != NONE32 && prog.has(prog.map(target.instance, ty), F_PLAIN);
    }
    false
}

// `site::reach`: blocks reachable from `from` under `folded`, without the edge
// cut_block -> cut_successor (cut_block NONE32: no cut).
fn reach(
    in prog: Prog,
    func: Fun,
    in folded: Folded,
    from: u32,
    cut_block: u32,
    cut_successor: u32
) -> ChunkSeq[u8] {
    let n = w(func.block_count);
    let mut seen = zeros8(n);
    let mut work: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut succ: ChunkSeq[u32] = ChunkSeq::new[u32]();
    work.push(from);
    loop {
        let pending = work.len();
        if pending == 0 {
            break;
        }
        let block = u32_at(in work, sub(pending, 1));
        work.truncate(sub(pending, 1));
        if u8_at(in seen, w(block)) != 0 || u8_at(in folded.live, w(block)) == 0 {
            continue;
        }
        set_u8(inout seen, w(block), 1);
        folded_successors(in prog, func, in folded, w(block), inout succ);
        for k in 0..succ.len() {
            let next = u32_at(in succ, k);
            if !(cut_block == block && cut_successor == next) {
                work.push(next);
            }
        }
    }
    seen
}

fn heavy(in prog: Prog, func: Fun, in blocks: ChunkSeq[u8]) -> bool {
    for block in 0..w(func.block_count) {
        if u8_at(in blocks, block) == 0 {
            continue;
        }
        let block_row = prog.block(func, block);
        for k in 0..w(block_row.inst_count) {
            let op = prog.inst_of(block_row, k).op;
            if op == O_LOOP || op == O_CALL || op == O_SEQ {
                return true;
            }
        }
    }
    false
}

// Marks each block of `func` whose instructions are all `pure`.
fn pure_blocks(in prog: Prog, target: Tgt, func: Fun) -> ChunkSeq[u8] {
    let n = w(func.block_count);
    let mut pure_block = zeros8(n);
    for block in 0..n {
        let block_row = prog.block(func, block);
        let mut all = true;
        for k in 0..w(block_row.inst_count) {
            if !pure(in prog, target, func, prog.inst_of(block_row, k)) {
                all = false;
                break;
            }
        }
        if all {
            set_u8(inout pure_block, block, 1);
        }
    }
    pure_block
}

// Marks the pure head of `func`: the live entry block when it is pure, then
// every live, pure block whose predecessors are all in the head.
fn pure_head(
    in prog: Prog,
    func: Fun,
    in folded: Folded,
    in pure_block: ChunkSeq[u8]
) -> ChunkSeq[u8] {
    let n = w(func.block_count);
    // Each folded edge, as parallel `pred_from -> pred_to` lists.
    let mut pred_from: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut pred_to: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut succ: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for block in 0..n {
        if u8_at(in folded.live, block) == 0 {
            continue;
        }
        folded_successors(in prog, func, in folded, block, inout succ);
        for k in 0..succ.len() {
            pred_from.push(n32(block));
            pred_to.push(u32_at(in succ, k));
        }
    }
    let mut head = zeros8(n);
    if u8_at(in pure_block, 0) != 0 && u8_at(in folded.live, 0) != 0 {
        set_u8(inout head, 0, 1);
    }
    let mut changed = true;
    loop {
        if !changed {
            break;
        }
        changed = false;
        for block in 1..n {
            if u8_at(in head, block) != 0
                || u8_at(in folded.live, block) == 0
                || u8_at(in pure_block, block) == 0
            {
                continue;
            }
            let mut any = false;
            let mut all = true;
            for edge in 0..pred_to.len() {
                if w(u32_at(in pred_to, edge)) == block {
                    any = true;
                    if u8_at(in head, w(u32_at(in pred_from, edge))) == 0 {
                        all = false;
                    }
                }
            }
            if any && all {
                set_u8(inout head, block, 1);
                changed = true;
            }
        }
    }
    head
}

// Inserts `target` into the ascending `targets`, unless it is already there.
fn insert_target(inout targets: ChunkSeq[u32], target: u32) {
    let mut at: u64 = 0;
    loop {
        if at >= targets.len() {
            break;
        }
        let existing = u32_at(in targets, at);
        if existing == target {
            return;
        }
        if existing > target {
            break;
        }
        at = inc(at);
    }
    targets.push(target);
    let mut k = sub(targets.len(), 1);
    loop {
        if k <= at {
            break;
        }
        set_u32(inout targets, k, u32_at(in targets, sub(k, 1)));
        k = sub(k, 1);
    }
    set_u32(inout targets, at, target);
}

// Fills `targets` with the distinct successors of `block_row`'s branch or match,
// and says whether `block_row` can be split there: a branch needs two different
// targets, and a match one target per arm.
fn split_targets(in prog: Prog, block_row: Blk, inout targets: ChunkSeq[u32]) -> bool {
    let term_at = w(block_row.term_at);
    targets.clear();
    if block_row.term == T_BRANCH {
        let yes = n32(prog.op(inc(term_at)));
        let no = n32(prog.op(add(term_at, 2)));
        targets.push(yes);
        targets.push(no);
        yes != no
    } else if block_row.term == T_MATCH {
        let arms = prog.op(inc(term_at));
        for j in 0..arms {
            insert_target(inout targets, n32(prog.op(add(add(term_at, 3), wrapping_mul(j, 2)))));
        }
        targets.len() == arms
    } else {
        false
    }
}

// `site::split`: the best partial inlining whose copy costs at most `budget`.
fn split(in prog: Prog, target: Tgt, in folded: Folded, budget: u64) -> Split {
    let func = prog.fun(target.fun_index);
    if own_handles(in prog, target.fun_index) > 0 {
        return no_split();
    }
    let pure_block = pure_blocks(in prog, target, func);
    let head = pure_head(in prog, func, in folded, in pure_block);
    let n = w(func.block_count);
    let mut best = no_split();
    let mut best_heavy = false;
    let mut targets: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for block in 0..n {
        if u8_at(in head, block) == 0 || folded.jump(block) != NONE32 {
            continue;
        }
        if !split_targets(in prog, prog.block(func, block), inout targets) {
            continue;
        }
        for k in 0..targets.len() {
            let cold = u32_at(in targets, k);
            if prog.block(func, w(cold)).param_count != 0 {
                continue;
            }
            let hot = reach(in prog, func, in folded, 0, n32(block), cold);
            if u8_at(in hot, w(cold)) != 0 {
                continue;
            }
            let from_cold = reach(in prog, func, in folded, cold, NONE32, NONE32);
            let mut cold_blocks = zeros8(n);
            for j in 0..n {
                if u8_at(in from_cold, j) != 0 && u8_at(in hot, j) == 0 {
                    set_u8(inout cold_blocks, j, 1);
                }
            }
            let hot_cost = add(cost_of(in prog, target, in folded, in hot), CALL_COST);
            let cold_cost = cost_of(in prog, target, in folded, in cold_blocks);
            if hot_cost > budget || cold_cost < MIN_COLD || cold_cost < hot_cost {
                continue;
            }
            let cold_heavier = heavy(in prog, func, in cold_blocks)
                && !heavy(in prog, func, in hot);
            let better = !best.found
                || (cold_heavier && !best_heavy)
                || (cold_heavier == best_heavy && hot_cost > best.hot_cost);
            if better {
                best_heavy = cold_heavier;
                best = Split {
                    found: true,
                    branch_block: n32(block),
                    cold_target: cold,
                    hot_blocks: hot,
                    hot_cost: hot_cost,
                    cold_cost: cold_cost
                };
            }
        }
    }
    best
}

// ----- splicing -------------------------------------------------------------------------

// How a callee's names, values and blocks map into the caller (`Rename`).
pub struct Rename {
    value_base: u64,
    block_base: u64,
    // callee local -> renamed local
    names: MapU,
    // borrowed parameter -> operand offset of the caller's place
    places: MapU,
}

// Writes root and path (root, n, names) of `root`.`path` (the path at
// operand offset `path_at`) renamed (`Rename::root`).
fn put_root(inout prog: Prog, in renaming: Rename, root: u64, path_at: u64) {
    let place = renaming.places.get(root);
    let path_len = prog.op(path_at);
    if place != NONE32 {
        let place_at = w(place);
        let place_len = prog.op(inc(place_at));
        prog.ops.push(prog.op(place_at));
        prog.ops.push(add(place_len, path_len));
        for k in 0..place_len {
            let segment = prog.op(add(add(place_at, 2), k));
            prog.ops.push(segment);
        }
    } else {
        let name = renaming.names.get(root);
        if name != NONE32 {
            prog.ops.push(w(name));
        } else {
            prog.ops.push(root);
        }
        prog.ops.push(path_len);
    }
    for k in 0..path_len {
        let segment = prog.op(add(inc(path_at), k));
        prog.ops.push(segment);
    }
}

// The root alone (`self.root(slot, &[]).0`).
fn renamed_root(in prog: Prog, in renaming: Rename, root: u64) -> u64 {
    let place = renaming.places.get(root);
    if place != NONE32 {
        return prog.op(w(place));
    }
    let name = renaming.names.get(root);
    if name != NONE32 { w(name) } else { root }
}

// A renamed copy of the pattern at `at` (`Rename::pattern`).
fn copy_pattern(inout prog: Prog, in renaming: Rename, at: u64) -> u64 {
    let kind = prog.pat(at);
    let mut body: ChunkSeq[u64] = ChunkSeq::new[u64]();
    if kind == PK_BIND {
        let name = prog.pat(add(at, 3));
        let new_name = renaming.names.get(name);
        body.push(
            if new_name != NONE32 {
                w(new_name)
            } else {
                name
            }
        );
    } else if kind == PK_TUPLE {
        let n = prog.pat(add(at, 3));
        body.push(n);
        for i in 0..n {
            let child = copy_pattern(inout prog, in renaming, prog.pat(add(add(at, 4), i)));
            body.push(child);
        }
    } else if kind == PK_CTOR {
        body.push(prog.pat(add(at, 3)));
        body.push(prog.pat(add(at, 4)));
        let n = prog.pat(add(at, 5));
        body.push(n);
        for i in 0..n {
            body.push(prog.pat(add(add(at, 6), wrapping_mul(i, 2))));
            let child = copy_pattern(
                inout prog,
                in renaming,
                prog.pat(add(add(at, 7), wrapping_mul(i, 2)))
            );
            body.push(child);
        }
    } else if kind == PK_LIT {
        for i in 0..4 {
            body.push(prog.pat(add(add(at, 3), i)));
        }
    }
    let out = prog.patterns.len();
    prog.patterns.push(kind);
    prog.patterns.push(prog.pat(inc(at)));
    prog.patterns.push(prog.pat(add(at, 2)));
    prog.patterns.extend(in body.as_slice());
    out
}

fn put_args(inout prog: Prog, in renaming: Rename, start: u64) {
    let n = prog.op(start);
    prog.ops.push(n);
    let mut at = inc(start);
    for k in 0..n {
        prog.ops.push(add(prog.op(at), renaming.value_base));
        prog.ops.push(prog.op(inc(at)));
        let has_place = prog.op(add(at, 2));
        prog.ops.push(has_place);
        if has_place != 0 {
            put_root(inout prog, in renaming, prog.op(add(at, 3)), add(at, 4));
        }
        at = arg_end(in prog, at);
    }
}

// The renamed operands of `inst` (`Rename::op`), as a new operand offset.
fn copy_op(inout prog: Prog, in renaming: Rename, inst: Inst) -> u32 {
    let ops_at = w(inst.ops_at);
    let op = inst.op;
    if op == O_CONST || op == O_UNIT || op == O_LOOP || op == O_CLOSURE {
        return inst.ops_at;
    }
    let out = n32(prog.ops.len());
    let value_base = renaming.value_base;
    if op == O_READ {
        put_root(inout prog, in renaming, prog.op(ops_at), inc(ops_at));
    } else if op == O_BIND {
        prog.ops.push(add(prog.op(ops_at), value_base));
        let at = copy_pattern(inout prog, in renaming, prog.op(inc(ops_at)));
        prog.ops.push(at);
    } else if op == O_WRITE {
        prog.ops.push(add(prog.op(ops_at), value_base));
        put_root(inout prog, in renaming, prog.op(inc(ops_at)), add(ops_at, 2));
    } else if op == O_UNARY {
        prog.ops.push(prog.op(ops_at));
        prog.ops.push(add(prog.op(inc(ops_at)), value_base));
    } else if op == O_INDEX {
        prog.ops.push(add(prog.op(ops_at), value_base));
        prog.ops.push(add(prog.op(inc(ops_at)), value_base));
    } else if op == O_BINARY {
        prog.ops.push(prog.op(ops_at));
        prog.ops.push(add(prog.op(inc(ops_at)), value_base));
        prog.ops.push(add(prog.op(add(ops_at, 2)), value_base));
    } else if op == O_PROJECT || op == O_TRY {
        prog.ops.push(add(prog.op(ops_at), value_base));
    } else if op == O_TUPLE || op == O_VECTOR {
        let n = prog.op(ops_at);
        prog.ops.push(n);
        for k in 0..n {
            prog.ops.push(add(prog.op(add(inc(ops_at), k)), value_base));
        }
    } else if op == O_DATA {
        prog.ops.push(prog.op(ops_at));
        let n = prog.op(inc(ops_at));
        prog.ops.push(n);
        for k in 0..n {
            prog.ops.push(add(prog.op(add(add(ops_at, 2), k)), value_base));
        }
    } else if op == O_CALL {
        prog.ops.push(prog.op(ops_at));
        prog.ops.push(prog.op(inc(ops_at)));
        put_args(inout prog, in renaming, add(ops_at, 2));
    } else if op == O_TILED || op == O_SEQ || op == O_FIP {
        put_args(inout prog, in renaming, ops_at);
    } else if op == O_INDIRECT {
        prog.ops.push(add(prog.op(ops_at), value_base));
        put_args(inout prog, in renaming, inc(ops_at));
    } else if op == O_EXIT {
        prog.ops.push(prog.op(ops_at));
        prog.ops.push(add(prog.op(inc(ops_at)), value_base));
    } else if op == O_HANDLE {
        let has_state = prog.op(ops_at);
        prog.ops.push(has_state);
        prog.ops.push(
            if has_state != 0 {
                add(prog.op(inc(ops_at)), value_base)
            } else {
                prog.op(inc(ops_at))
            }
        );
        let pair_count = prog.op(add(ops_at, 2));
        prog.ops.push(pair_count);
        let mut at = add(ops_at, 3);
        for k in 0..pair_count {
            prog.ops.push(prog.op(at));
            prog.ops.push(renamed_root(in prog, in renaming, prog.op(inc(at))));
            at = add(at, 2);
        }
        let move_count = prog.op(at);
        prog.ops.push(move_count);
        at = inc(at);
        for k in 0..move_count {
            put_root(inout prog, in renaming, prog.op(at), inc(at));
            at = add(add(at, 2), prog.op(inc(at)));
        }
        let graph_count = prog.op(at);
        prog.ops.push(graph_count);
        for k in 0..graph_count {
            prog.ops.push(prog.op(add(inc(at), k)));
        }
    }
    out
}

fn new_block(
    inout prog: Prog,
    in params: ChunkSeq[u32],
    in inst_ids: ChunkSeq[u32],
    term: u8,
    term_at: u32
) -> u32 {
    let param_start = n32(prog.ids.len());
    prog.ids.extend(in params.as_slice());
    let inst_start = n32(prog.ids.len());
    prog.ids.extend(in inst_ids.as_slice());
    let id = n32(prog.block_rows.len());
    prog.block_rows.push(Blk {
        param_start: param_start,
        param_count: n32(params.len()),
        inst_start: inst_start,
        inst_count: n32(inst_ids.len()),
        term: term,
        term_at: term_at
    });
    id
}

// `back(v)`: a jump to the continuation with `value`.
fn put_back(inout prog: Prog, continuation: u64, value: u64) -> u32 {
    let term_at = n32(prog.ops.len());
    prog.ops.push(continuation);
    prog.ops.push(1);
    prog.ops.push(value);
    term_at
}

fn new_inst(inout prog: Prog, inst: Inst) -> u32 {
    let id = n32(prog.insts.len());
    prog.insts.push(inst);
    id
}

// Replace the call at instruction `call_index` of caller block `block` with the
// target's body (`splice`). Returns the first block copied.
fn splice(
    inout prog: Prog,
    caller_index: u32,
    block: u64,
    call_index: u64,
    callee_target: Tgt,
    in bindings: Bindings,
    serial: u64,
    in folded: Folded,
    in split_plan: Split
) -> u64 {
    let callee = prog.fun(callee_target.fun_index);
    let next_value = value_bound(in prog, prog.fun(caller_index));
    let callee_values = value_bound(in prog, callee);
    let continuation = w(prog.fun(caller_index).block_count);
    let first = inc(continuation);
    let mut renaming = Rename {
        value_base: next_value,
        block_base: first,
        names: map_new(64),
        places: map_new(16)
    };
    for k in 0..w(callee.param_count) {
        if bindings.is_place(k) {
            renaming
                .places
                .set(w(prog.param(callee, k).name), n32(u64_at(in bindings.place_at, k)));
        }
    }
    for k in 0..w(callee.local_count) {
        let name = u32_at(in prog.local_names, add(w(callee.local_start), k));
        if renaming.places.get(w(name)) == NONE32 {
            let new_name = renamed(inout prog, name, serial);
            renaming.names.set(w(name), new_name);
        }
    }
    for k in 0..w(callee.local_count) {
        let name = u32_at(in prog.local_names, add(w(callee.local_start), k));
        let new_name = renaming.names.get(w(name));
        if new_name != NONE32 {
            let ty = prog.map(
                callee_target.instance,
                u32_at(in prog.local_types, add(w(callee.local_start), k))
            );
            push_local(inout prog, caller_index, new_name, ty);
        }
    }
    for value in 0..w(callee.value_count) {
        let callee_ty = prog.value_ty(callee, value);
        if callee_ty != NONE32 {
            let ty = prog.map(callee_target.instance, callee_ty);
            set_value(inout prog, caller_index, add(value, next_value), ty);
        }
    }
    let mut fresh = add(next_value, callee_values);
    // Split the caller's block at the call.
    let block_row = prog.block(prog.fun(caller_index), block);
    let call_id = prog.id(add(w(block_row.inst_start), call_index));
    let call = prog.inst(call_id);
    let mut prefix: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for k in 0..call_index {
        prefix.push(prog.id(add(w(block_row.inst_start), k)));
    }
    let mut rest: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for k in inc(call_index)..w(block_row.inst_count) {
        rest.push(prog.id(add(w(block_row.inst_start), k)));
    }
    for k in 0..w(callee.param_count) {
        if bindings.is_place(k) {
            continue;
        }
        let dest = fresh;
        fresh = inc(fresh);
        set_value(inout prog, caller_index, dest, prog.unit_ty);
        let name = renaming.names.get(w(prog.param(callee, k).name));
        let pattern_at = prog.patterns.len();
        prog.patterns.push(PK_BIND);
        prog.patterns.push(call.span_start);
        prog.patterns.push(call.span_end);
        prog.patterns.push(w(name));
        let ops_at = n32(prog.ops.len());
        prog.ops.push(w(u32_at(in bindings.arg_values, k)));
        prog.ops.push(pattern_at);
        let id = new_inst(
            inout prog,
            Inst {
                dest: n32(dest),
                ty: prog.unit_ty,
                span_start: call.span_start,
                span_end: call.span_end,
                flags: 0,
                opaque: prog.bind_opaque,
                op: O_BIND,
                ops_at: ops_at
            }
        );
        prefix.push(id);
    }
    let jump_term_at = n32(prog.ops.len());
    prog.ops.push(first);
    prog.ops.push(0);
    let empty: ChunkSeq[u32] = ChunkSeq::new[u32]();
    // The caller's block keeps its parameters.
    let mut own_params: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for k in 0..w(block_row.param_count) {
        own_params.push(prog.id(add(w(block_row.param_start), k)));
    }
    let prefix_block = new_block(inout prog, in own_params, in prefix, T_JUMP, jump_term_at);
    set_block(inout prog, caller_index, block, prefix_block);
    let mut cont_params: ChunkSeq[u32] = ChunkSeq::new[u32]();
    cont_params.push(call.dest);
    let cont_block = new_block(
        inout prog,
        in cont_params,
        in rest,
        block_row.term,
        block_row.term_at
    );
    push_block(inout prog, caller_index, cont_block);
    let cold_block = add(first, w(callee.block_count));
    let mut inst_ids: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut block_params: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for k in 0..w(callee.block_count) {
        let source = prog.block(callee, k);
        block_params.clear();
        for j in 0..w(source.param_count) {
            block_params.push(n32(add(w(prog.id(add(w(source.param_start), j))), next_value)));
        }
        let keep = if split_plan.found {
            u8_at(in split_plan.hot_blocks, k) != 0
        } else {
            u8_at(in folded.live, k) != 0
        };
        if !keep {
            let id = new_block(inout prog, in block_params, in empty, T_UNREACHABLE, 0);
            push_block(inout prog, caller_index, id);
            continue;
        }
        inst_ids.clear();
        let mut exit_term_at = NONE32;
        for j in 0..w(source.inst_count) {
            let source_inst = prog.inst_of(source, j);
            let ops_at = copy_op(inout prog, in renaming, source_inst);
            if source_inst.op == O_EXIT {
                // `return value`: the rest of this block is unreachable.
                let value = prog.op(inc(w(ops_at)));
                exit_term_at = put_back(inout prog, continuation, value);
                break;
            }
            let id = new_inst(
                inout prog,
                Inst {
                    dest: n32(add(w(source_inst.dest), next_value)),
                    ty: prog.map(callee_target.instance, source_inst.ty),
                    span_start: source_inst.span_start,
                    span_end: source_inst.span_end,
                    flags: source_inst.flags,
                    opaque: source_inst.opaque,
                    op: source_inst.op,
                    ops_at: ops_at
                }
            );
            inst_ids.push(id);
        }
        let mut term = T_JUMP;
        let mut term_at = exit_term_at;
        if term_at == NONE32 {
            let decided = folded.jump(k);
            if decided != NONE32 {
                term_at = n32(prog.ops.len());
                prog.ops.push(target(in split_plan, k, w(decided), first, cold_block));
                prog.ops.push(0);
            } else {
                let source_term_at = w(source.term_at);
                term_at = n32(prog.ops.len());
                if source.term == T_RETURN {
                    let value = add(prog.op(source_term_at), next_value);
                    term_at = put_back(inout prog, continuation, value);
                } else if source.term == T_JUMP {
                    prog.ops.push(target(
                        in split_plan,
                        k,
                        prog.op(source_term_at),
                        first,
                        cold_block
                    ));
                    let n = prog.op(inc(source_term_at));
                    prog.ops.push(n);
                    for j in 0..n {
                        prog.ops.push(add(prog.op(add(add(source_term_at, 2), j)), next_value));
                    }
                } else if source.term == T_BRANCH {
                    term = T_BRANCH;
                    prog.ops.push(add(prog.op(source_term_at), next_value));
                    prog.ops.push(target(
                        in split_plan,
                        k,
                        prog.op(inc(source_term_at)),
                        first,
                        cold_block
                    ));
                    prog.ops.push(target(
                        in split_plan,
                        k,
                        prog.op(add(source_term_at, 2)),
                        first,
                        cold_block
                    ));
                } else if source.term == T_MATCH {
                    term = T_MATCH;
                    let arms = prog.op(inc(source_term_at));
                    let mut words: ChunkSeq[u64] = ChunkSeq::new[u64]();
                    words.push(add(prog.op(source_term_at), next_value));
                    words.push(arms);
                    for j in 0..arms {
                        let pattern_at = copy_pattern(
                            inout prog,
                            in renaming,
                            prog.op(add(add(source_term_at, 2), wrapping_mul(j, 2)))
                        );
                        words.push(pattern_at);
                        words.push(target(
                            in split_plan,
                            k,
                            prog.op(add(add(source_term_at, 3), wrapping_mul(j, 2))),
                            first,
                            cold_block
                        ));
                    }
                    term_at = n32(prog.ops.len());
                    prog.ops.extend(in words.as_slice());
                } else {
                    term = T_UNREACHABLE;
                }
            }
        }
        let id = new_block(inout prog, in block_params, in inst_ids, term, term_at);
        push_block(inout prog, caller_index, id);
    }
    if split_plan.found {
        let dest = fresh;
        set_value(
            inout prog,
            caller_index,
            dest,
            prog.map(callee_target.instance, callee.result_ty)
        );
        let again = new_inst(
            inout prog,
            Inst {
                dest: n32(dest),
                ty: call.ty,
                span_start: call.span_start,
                span_end: call.span_end,
                flags: call.flags,
                opaque: call.opaque,
                op: call.op,
                ops_at: call.ops_at
            }
        );
        inst_ids.clear();
        inst_ids.push(again);
        let term_at = put_back(inout prog, continuation, dest);
        let id = new_block(inout prog, in empty, in inst_ids, T_JUMP, term_at);
        push_block(inout prog, caller_index, id);
    }
    first
}

// A callee block target in the copy (`target` in `splice`).
fn target(
    in split_plan: Split,
    from_block: u64,
    to_block: u64,
    first: u64,
    cold_block: u64
) -> u64 {
    if split_plan.found
        && w(split_plan.branch_block) == from_block
        && w(split_plan.cold_target) == to_block
    {
        cold_block
    } else {
        add(to_block, first)
    }
}

// ----- the report -----------------------------------------------------------------------

pub struct Report {
    sites: u64,
    added: u64,
    folded: u64,
    constants: u64,
    // per function
    callees: ChunkSeq[u64],
    partial: ChunkSeq[u64],
    growth: ChunkSeq[u64],
    grown: ChunkSeq[u8],
    // per function and reason
    refused: ChunkSeq[u64],
    // contents: per function a list of (callee, units)
    contents_head: ChunkSeq[u32],
    contents_callee: ChunkSeq[u32],
    contents_units: ChunkSeq[u64],
    contents_next: ChunkSeq[u32],
    contents_index: MapU,
    // inlined_into: per function a list of members
    into_head: ChunkSeq[u32],
    into_member: ChunkSeq[u32],
    into_next: ChunkSeq[u32],
    into_seen: MapU,
}

fn report_new(fun_count: u64) -> Report {
    Report {
        sites: 0,
        added: 0,
        folded: 0,
        constants: 0,
        callees: zeros64(fun_count),
        partial: zeros64(fun_count),
        growth: zeros64(fun_count),
        grown: zeros8(fun_count),
        refused: zeros64(wrapping_mul(fun_count, REASONS)),
        contents_head: fill32(fun_count, NONE32),
        contents_callee: ChunkSeq::new[u32](),
        contents_units: ChunkSeq::new[u64](),
        contents_next: ChunkSeq::new[u32](),
        contents_index: map_new(256),
        into_head: fill32(fun_count, NONE32),
        into_member: ChunkSeq::new[u32](),
        into_next: ChunkSeq::new[u32](),
        into_seen: map_new(256)
    }
}

impl Report {
    fn refuse(inout self, fun_index: u32, why: u32) {
        let at = add(wrapping_mul(w(fun_index), REASONS), w(why));
        set_u64(inout self.refused, at, inc(u64_at(in self.refused, at)));
    }

    fn grow(inout self, fun_index: u32, units: u64) {
        set_u64(inout self.growth, w(fun_index), add(u64_at(in self.growth, w(fun_index)), units));
        set_u8(inout self.grown, w(fun_index), 1);
    }

    fn hold(inout self, fun_index: u32, callee: u32, units: u64) {
        let pair_key = pair(fun_index, callee);
        let entry = self.contents_index.get(pair_key);
        if entry == NONE32 {
            let new_entry = n32(self.contents_callee.len());
            self.contents_callee.push(callee);
            self.contents_units.push(units);
            self.contents_next.push(u32_at(in self.contents_head, w(fun_index)));
            set_u32(inout self.contents_head, w(fun_index), new_entry);
            self.contents_index.set(pair_key, new_entry);
        } else {
            set_u64(
                inout self.contents_units,
                w(entry),
                add(u64_at(in self.contents_units, w(entry)), units)
            );
        }
    }

    fn into(inout self, fun_index: u32, member: u32) {
        let pair_key = pair(fun_index, member);
        if self.into_seen.get(pair_key) != NONE32 {
            return;
        }
        self.into_seen.set(pair_key, 1);
        let entry = n32(self.into_member.len());
        self.into_member.push(member);
        self.into_next.push(u32_at(in self.into_head, w(fun_index)));
        set_u32(inout self.into_head, w(fun_index), entry);
    }
}

// ----- the pass -------------------------------------------------------------------------

fn find_instance(in prog: Prog, callee: u32, span_start: u64, span_end: u64) -> u32 {
    for k in 0..prog.instances.len() {
        match prog.instances.try_get(k) {
            Option::Some(instance) => {
                if instance.callee == callee
                    && instance.span_start == span_start
                    && instance.span_end == span_end
                {
                    if instance.has_types {
                        return n32(k);
                    }
                    return NONE32;
                }
            },
            Option::None => {},
        }
    }
    NONE32
}

// `owns_sequence`: a local of the target, a by-value parameter included,
// whose type holds a sequence and is no slice view. Its copy would put the sequence's slot,
// frame and drop flags on every path of the caller (#1499).
fn owns_sequence(in prog: Prog, target: Tgt) -> bool {
    let func = prog.fun(target.fun_index);
    for k in 0..w(func.local_count) {
        let at = add(w(func.local_start), k);
        let ty = prog.map(target.instance, u32_at(in prog.local_types, at));
        if !prog.has(ty, F_SEQUENCE) || prog.has(ty, F_SLICE) {
            continue;
        }
        let name = u32_at(in prog.local_names, at);
        let mut owned = true;
        for j in 0..w(func.param_count) {
            let param = prog.param(func, j);
            if param.name == name {
                owned = param.pass == TyPass::Sink;
                break;
            }
        }
        if owned {
            return true;
        }
    }
    false
}

// `cold_block`: block `candidate` of function `fun_index` is on no cycle, and some path
// from the entry leaves the function without passing it.
fn cold_block(in prog: Prog, fun_index: u32, candidate: u64) -> bool {
    if candidate == 0 {
        return false;
    }
    let func = prog.fun(fun_index);
    let block_count = w(func.block_count);
    let mut succ: ChunkSeq[u32] = ChunkSeq::new[u32]();
    // On a cycle: `candidate` is reachable from its own successors.
    let mut seen = zeros8(block_count);
    let mut work: ChunkSeq[u32] = ChunkSeq::new[u32]();
    successors(in prog, prog.block(func, candidate), inout succ);
    for k in 0..succ.len() {
        work.push(u32_at(in succ, k));
    }
    loop {
        let block = match work.pop() {
            Option::Some(popped) => w(popped),
            Option::None => break,
        };
        if block >= block_count || u8_at(in seen, block) != 0 {
            continue;
        }
        if block == candidate {
            return false;
        }
        set_u8(inout seen, block, 1);
        successors(in prog, prog.block(func, block), inout succ);
        for j in 0..succ.len() {
            work.push(u32_at(in succ, j));
        }
    }
    // A path from the entry that avoids `candidate` and leaves the function.
    let mut seen_from_entry = zeros8(block_count);
    work.push(0);
    loop {
        let block = match work.pop() {
            Option::Some(popped) => w(popped),
            Option::None => break,
        };
        if block == candidate || block >= block_count || u8_at(in seen_from_entry, block) != 0 {
            continue;
        }
        set_u8(inout seen_from_entry, block, 1);
        let block_row = prog.block(func, block);
        if block_row.term == T_RETURN {
            return true;
        }
        for i in 0..w(block_row.inst_count) {
            let inst = prog.inst_of(block_row, i);
            if inst.op == O_EXIT && n32(prog.op(w(inst.ops_at))) == func.name {
                return true;
            }
        }
        successors(in prog, block_row, inout succ);
        for j in 0..succ.len() {
            work.push(u32_at(in succ, j));
        }
    }
    false
}

// `inline_into`: inline the eligible calls of caller `caller_index`.
fn inline_into(
    inout prog: Prog,
    caller_index: u32,
    in callee_why: ChunkSeq[u32],
    in sites: ChunkSeq[u64],
    inout serial: u64,
    inout report: Report
) {
    let mut added: u64 = 0;
    let mut handles_added: u64 = 0;
    // Blocks spliced in from a callee were already processed bottom-up.
    let mut spliced = zeros8(w(prog.fun(caller_index).block_count));
    let mut block: u64 = 0;
    loop {
        if block >= w(prog.fun(caller_index).block_count) {
            break;
        }
        if u8_at(in spliced, block) != 0 {
            block = inc(block);
            continue;
        }
        let mut call_index: u64 = 0;
        loop {
            let block_row = prog.block(prog.fun(caller_index), block);
            if call_index >= w(block_row.inst_count) {
                break;
            }
            let inst = prog.inst_of(block_row, call_index);
            if inst.op != O_CALL {
                call_index = inc(call_index);
                continue;
            }
            let ops_at = w(inst.ops_at);
            let callee = prog.fun_index(n32(prog.op(ops_at)));
            if callee == NONE32 {
                call_index = inc(call_index);
                continue;
            }
            let mut why = u32_at(in callee_why, w(callee));
            let mut target = Tgt { fun_index: callee, instance: NONE32 };
            let mut bindings = bindings_new();
            let mut folded = folded_none(0);
            let mut split_plan = no_split();
            let mut cost_here: u64 = 0;
            if why == R_OK && (prog.op(inc(ops_at)) != 0 || callee == caller_index) {
                why = R_SITE_TYPES;
            }
            if why == R_OK && (prog.fun(callee).flags & W_GENERIC) != 0 {
                target
                    .instance = find_instance(
                        in prog,
                        prog.fun(callee).name,
                        inst.span_start,
                        inst.span_end
                    );
                if target.instance == NONE32 {
                    why = R_SITE_UNRECORDED;
                }
            }
            if why == R_OK {
                why = site_bindings(
                    in prog,
                    caller_index,
                    target,
                    inst.dest,
                    add(ops_at, 2),
                    inout bindings
                );
            }
            if why == R_OK
                && owns_sequence(in prog, target)
                && cold_block(in prog, caller_index, block)
            {
                why = R_SITE_COLD;
            }
            if why == R_OK {
                let handlers = handler_sum(in prog, callee, false);
                let mut folded_ok = false;
                folded = fold(inout prog, caller_index, target, in bindings, inout folded_ok);
                let at_site = add(folded_cost(in prog, target, in folded), handlers);
                let single = u64_at(in sites, w(callee)) == 1;
                let fits = at_site <= prog.small_callee
                    || (single && at_site <= prog.single_site_callee);
                if fits {
                    cost_here = at_site;
                } else {
                    if handlers == 0 && partial_ok(in prog, target, in bindings) {
                        split_plan = split(in prog, target, in folded, prog.small_callee);
                    }
                    if split_plan.found {
                        cost_here = split_plan.hot_cost;
                    } else {
                        why = R_SIZE;
                    }
                }
            }
            if why == R_OK {
                // The copy also duplicates every body already inlined into
                // the callee: charge those callees' caps too.
                let cap = prog.callee_growth;
                let mut over_cap = add(u64_at(in report.growth, w(callee)), cost_here) > cap;
                let mut entry = u32_at(in report.contents_head, w(callee));
                loop {
                    if entry == NONE32 || over_cap {
                        break;
                    }
                    let key = u32_at(in report.contents_callee, w(entry));
                    if add(
                        u64_at(in report.growth, w(key)),
                        u64_at(in report.contents_units, w(entry))
                    )
                        > cap
                    {
                        over_cap = true;
                    }
                    entry = u32_at(in report.contents_next, w(entry));
                }
                if add(added, cost_here) > prog.caller_growth
                    || add(report.added, cost_here) > prog.program_growth
                    || over_cap
                    || add(handles_added, handler_sum(in prog, callee, true)) > prog.caller_handles
                {
                    why = R_GROWTH;
                }
            }
            if why != R_OK {
                report.refuse(callee, why);
                call_index = inc(call_index);
                continue;
            }
            serial = inc(serial);
            let first = splice(
                inout prog,
                caller_index,
                block,
                call_index,
                target,
                in bindings,
                serial,
                in folded,
                in split_plan
            );
            let total = w(prog.fun(caller_index).block_count);
            loop {
                if spliced.len() >= total {
                    break;
                }
                spliced.push(0);
            }
            for k in first..total {
                set_u8(inout spliced, k, 1);
            }
            added = add(added, cost_here);
            handles_added = add(handles_added, handler_sum(in prog, callee, true));
            report.added = add(report.added, cost_here);
            report.sites = inc(report.sites);
            // nested = contents[target], taken before the caller's update
            let mut nested_keys: ChunkSeq[u32] = ChunkSeq::new[u32]();
            let mut nested_units: ChunkSeq[u64] = ChunkSeq::new[u64]();
            let mut entry = u32_at(in report.contents_head, w(callee));
            loop {
                if entry == NONE32 {
                    break;
                }
                nested_keys.push(u32_at(in report.contents_callee, w(entry)));
                nested_units.push(u64_at(in report.contents_units, w(entry)));
                entry = u32_at(in report.contents_next, w(entry));
            }
            report.hold(caller_index, callee, cost_here);
            for k in 0..nested_keys.len() {
                report.hold(caller_index, u32_at(in nested_keys, k), u64_at(in nested_units, k));
            }
            report.grow(callee, cost_here);
            for k in 0..nested_keys.len() {
                report.grow(u32_at(in nested_keys, k), u64_at(in nested_units, k));
            }
            set_u64(inout report.callees, w(callee), inc(u64_at(in report.callees, w(callee))));
            if split_plan.found {
                set_u64(inout report.partial, w(callee), inc(u64_at(in report.partial, w(callee))));
            }
            if folded.decides() {
                report.folded = inc(report.folded);
            }
            let mut members: ChunkSeq[u32] = ChunkSeq::new[u32]();
            let mut member_entry = u32_at(in report.into_head, w(callee));
            loop {
                if member_entry == NONE32 {
                    break;
                }
                members.push(u32_at(in report.into_member, w(member_entry)));
                member_entry = u32_at(in report.into_next, w(member_entry));
            }
            report.into(caller_index, callee);
            for k in 0..members.len() {
                report.into(caller_index, u32_at(in members, k));
            }
            // The rest of this block moved to the continuation block, which
            // the outer loop reaches later.
            break;
        }
        block = inc(block);
    }
}

// `inline`: small, non-recursive direct calls, bottom-up over the call
// graph, within the budget.
pub fn inline(inout prog: Prog) -> Report {
    let fun_count = prog.funs.len();
    let mut report = report_new(fun_count);
    if prog.budget_off() {
        return report;
    }
    report.constants = fold_literal_constants(inout prog);
    let mut call_graph = graph_new(fun_count);
    let mut sites = zeros64(fun_count);
    let mut graphs: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for fun_index in 0..fun_count {
        let fun_id = n32(fun_index);
        let _ = call_graph.node(fun_id);
        let func = prog.fun(fun_id);
        for block in 0..w(func.block_count) {
            let block_row = prog.block(func, block);
            for k in 0..w(block_row.inst_count) {
                let inst = prog.inst_of(block_row, k);
                if inst.op != O_CALL {
                    continue;
                }
                let callee = prog.fun_index(n32(prog.op(w(inst.ops_at))));
                if callee != NONE32 {
                    call_graph.edge(fun_id, callee);
                    set_u64(inout sites, w(callee), inc(u64_at(in sites, w(callee))));
                }
            }
        }
        graphs.clear();
        handler_graphs(in prog, fun_id, inout graphs);
        for k in 0..graphs.len() {
            let nested = prog.fun_index(u32_at(in graphs, k));
            if nested != NONE32 {
                call_graph.edge(fun_id, nested);
            }
        }
    }
    let scc = tarjan(in call_graph);
    let mut recursive = zeros8(fun_count);
    let mut order: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for component in 0..scc.components() {
        let lo = w(u32_at(in scc.component_starts, component));
        let hi = w(u32_at(in scc.component_starts, inc(component)));
        let first = u32_at(in scc.component_nodes, lo);
        let cyclic = sub(hi, lo) > 1 || u8_at(in call_graph.self_edge, w(first)) != 0;
        for k in lo..hi {
            let member = u32_at(in call_graph.nodes, w(u32_at(in scc.component_nodes, k)));
            if cyclic {
                set_u8(inout recursive, w(member), 1);
            }
            order.push(member);
        }
    }
    // Functions that a `return` in another graph leaves.
    let mut exited = zeros8(fun_count);
    for fun_index in 0..fun_count {
        let func = prog.fun(n32(fun_index));
        for block in 0..w(func.block_count) {
            let block_row = prog.block(func, block);
            for k in 0..w(block_row.inst_count) {
                let inst = prog.inst_of(block_row, k);
                if inst.op == O_EXIT {
                    let owner = n32(prog.op(w(inst.ops_at)));
                    if owner != func.name {
                        let owner_index = prog.fun_index(owner);
                        if owner_index != NONE32 {
                            set_u8(inout exited, w(owner_index), 1);
                        }
                    }
                }
            }
        }
    }
    let mut callee_why = fill32(fun_count, R_OK);
    for fun_index in 0..fun_count {
        let why = if u8_at(in recursive, fun_index) != 0 {
            R_RECURSIVE
        } else if u8_at(in exited, fun_index) != 0 {
            R_HANDLER_RETURN
        } else {
            inlinable(in prog, n32(fun_index))
        };
        set_u32(inout callee_why, fun_index, why);
    }
    let mut serial: u64 = 0;
    for k in 0..order.len() {
        if report.added >= prog.program_growth {
            break;
        }
        let caller_index = u32_at(in order, k);
        if caller_eligible(in prog, caller_index) {
            inline_into(
                inout prog,
                caller_index,
                in callee_why,
                in sites,
                inout serial,
                inout report
            );
        } else {
            let func = prog.fun(caller_index);
            for block in 0..w(func.block_count) {
                let block_row = prog.block(func, block);
                for j in 0..w(block_row.inst_count) {
                    let inst = prog.inst_of(block_row, j);
                    if inst.op == O_CALL {
                        let callee = prog.fun_index(n32(prog.op(w(inst.ops_at))));
                        if callee != NONE32 {
                            report.refuse(callee, R_CALLER);
                        }
                    }
                }
            }
        }
    }
    report
}

// ----- output ---------------------------------------------------------------------------

// The report (`decode_report` in tests/common/inline_words.rs). Names are
// symbols, which equal input name indexes for every input name (the input
// names are interned first, in order, after the empty name).
fn put_report(in prog: Prog, in report: Report, inout out: ChunkSeq[u64]) {
    out.push(report.sites);
    out.push(report.added);
    out.push(report.folded);
    out.push(report.constants);
    let fun_count = prog.funs.len();
    let mut rows: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut count: u64 = 0;
    for fun_index in 0..fun_count {
        let n = u64_at(in report.callees, fun_index);
        if n > 0 {
            rows.push(prog.input_name(prog.fun(n32(fun_index)).name));
            rows.push(n);
            count = inc(count);
        }
    }
    out.push(count);
    out.extend(in rows.as_slice());
    rows.clear();
    count = 0;
    for fun_index in 0..fun_count {
        let head = u32_at(in report.into_head, fun_index);
        if head == NONE32 {
            continue;
        }
        count = inc(count);
        rows.push(prog.input_name(prog.fun(n32(fun_index)).name));
        let mut members: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let mut entry = head;
        loop {
            if entry == NONE32 {
                break;
            }
            members.push(prog.input_name(prog.fun(u32_at(in report.into_member, w(entry))).name));
            entry = u32_at(in report.into_next, w(entry));
        }
        rows.push(members.len());
        rows.extend(in members.as_slice());
    }
    out.push(count);
    out.extend(in rows.as_slice());
    rows.clear();
    count = 0;
    for fun_index in 0..fun_count {
        for reason in 0..REASONS {
            let n = u64_at(in report.refused, add(wrapping_mul(fun_index, REASONS), reason));
            if n > 0 {
                rows.push(prog.input_name(prog.fun(n32(fun_index)).name));
                rows.push(reason);
                rows.push(n);
                count = inc(count);
            }
        }
    }
    out.push(count);
    out.extend(in rows.as_slice());
    rows.clear();
    count = 0;
    for fun_index in 0..fun_count {
        let n = u64_at(in report.partial, fun_index);
        if n > 0 {
            rows.push(prog.input_name(prog.fun(n32(fun_index)).name));
            rows.push(n);
            count = inc(count);
        }
    }
    out.push(count);
    out.extend(in rows.as_slice());
    rows.clear();
    count = 0;
    for fun_index in 0..fun_count {
        if u8_at(in report.grown, fun_index) != 0 {
            rows.push(prog.input_name(prog.fun(n32(fun_index)).name));
            rows.push(u64_at(in report.growth, fun_index));
            count = inc(count);
        }
    }
    out.push(count);
    out.extend(in rows.as_slice());
    out.push(fun_count);
    for fun_index in 0..fun_count {
        let fun_id = n32(fun_index);
        out.push(prog.input_name(prog.fun(fun_id).name));
        out.push(size(in prog, fun_id));
        out.push(cost(in prog, Tgt { fun_index: fun_id, instance: NONE32 }));
    }
}

// ----- the canonical text (`dump` in tests/common/inline_words.rs) ----------------------

fn put(inout out: ChunkSeq[u8], in text: Str) {
    out.extend(in text.as_bytes());
}

fn put_name(in prog: Prog, inout out: ChunkSeq[u8], symbol: u64) {
    prog.names.write(n32(symbol), inout out);
}

// root.path from operand offset `at` (root, n, path*).
fn put_path(in prog: Prog, inout out: ChunkSeq[u8], at: u64) {
    put_name(in prog, inout out, prog.op(at));
    let n = prog.op(inc(at));
    for k in 0..n {
        out.push(46);
        put_name(in prog, inout out, prog.op(add(add(at, 2), k)));
    }
}

fn put_pattern(in prog: Prog, inout out: ChunkSeq[u8], at: u64) {
    let kind = prog.pat(at);
    if kind == PK_WILD {
        out.push(95);
    } else if kind == PK_BIND {
        put_name(in prog, inout out, prog.pat(add(at, 3)));
    } else if kind == PK_TUPLE {
        out.push(40);
        let n = prog.pat(add(at, 3));
        for i in 0..n {
            put_pattern(in prog, inout out, prog.pat(add(add(at, 4), i)));
            out.push(44);
        }
        out.push(41);
    } else if kind == PK_CTOR {
        put_name(in prog, inout out, prog.pat(add(at, 3)));
        if prog.pat(add(at, 4)) != 0 {
            out.push(33);
        }
        out.push(123);
        let n = prog.pat(add(at, 5));
        for i in 0..n {
            put_name(in prog, inout out, prog.pat(add(add(at, 6), wrapping_mul(i, 2))));
            out.push(58);
            put_pattern(in prog, inout out, prog.pat(add(add(at, 7), wrapping_mul(i, 2))));
            out.push(44);
        }
        out.push(125);
    } else if kind == PK_LIT {
        out.push(35);
        push_decimal(inout out, prog.pat(add(at, 6)));
    }
    out.push(64);
    push_decimal(inout out, prog.pat(inc(at)));
    out.push(45);
    push_decimal(inout out, prog.pat(add(at, 2)));
}

fn put_space_num(inout out: ChunkSeq[u8], value: u64) {
    out.push(32);
    push_decimal(inout out, value);
}

fn put_dump_args(in prog: Prog, inout out: ChunkSeq[u8], start: u64) {
    let n = prog.op(start);
    let mut at = inc(start);
    for k in 0..n {
        put_space_num(inout out, prog.op(at));
        out.push(58);
        push_decimal(inout out, prog.op(inc(at)));
        if prog.op(add(at, 2)) != 0 {
            out.push(61);
            put_path(in prog, inout out, add(at, 3));
        }
        at = arg_end(in prog, at);
    }
}

fn put_inst(in prog: Prog, inout out: ChunkSeq[u8], inst: Inst) {
    put_space_num(inout out, w(inst.dest));
    put_space_num(inout out, w(inst.ty));
    put_space_num(inout out, inst.span_start);
    out.push(45);
    push_decimal(inout out, inst.span_end);
    put_space_num(inout out, inst.flags & I_FALLIBLE);
    put(inout out, " #");
    push_decimal(inout out, w(inst.opaque));
    let ops_at = w(inst.ops_at);
    let op = inst.op;
    if op == O_READ {
        out.push(32);
        put_path(in prog, inout out, ops_at);
    } else if op == O_BIND {
        put_space_num(inout out, prog.op(ops_at));
        out.push(32);
        put_pattern(in prog, inout out, prog.op(inc(ops_at)));
    } else if op == O_WRITE {
        out.push(32);
        put_path(in prog, inout out, inc(ops_at));
        put_space_num(inout out, prog.op(ops_at));
    } else if op == O_UNARY {
        put_space_num(inout out, prog.op(inc(ops_at)));
    } else if op == O_PROJECT || op == O_TRY {
        put_space_num(inout out, prog.op(ops_at));
    } else if op == O_BINARY {
        put_space_num(inout out, prog.op(inc(ops_at)));
        put_space_num(inout out, prog.op(add(ops_at, 2)));
    } else if op == O_INDEX {
        put_space_num(inout out, prog.op(ops_at));
        put_space_num(inout out, prog.op(inc(ops_at)));
    } else if op == O_TUPLE || op == O_VECTOR {
        let n = prog.op(ops_at);
        for k in 0..n {
            put_space_num(inout out, prog.op(add(inc(ops_at), k)));
        }
    } else if op == O_DATA {
        let n = prog.op(inc(ops_at));
        for k in 0..n {
            put_space_num(inout out, prog.op(add(add(ops_at, 2), k)));
        }
    } else if op == O_CALL {
        out.push(32);
        put_name(in prog, inout out, prog.op(ops_at));
        put_dump_args(in prog, inout out, add(ops_at, 2));
    } else if op == O_TILED || op == O_SEQ || op == O_FIP {
        put_dump_args(in prog, inout out, ops_at);
    } else if op == O_INDIRECT {
        put_space_num(inout out, prog.op(ops_at));
        put_dump_args(in prog, inout out, inc(ops_at));
    } else if op == O_EXIT {
        put_space_num(inout out, prog.op(inc(ops_at)));
    } else if op == O_HANDLE {
        if prog.op(ops_at) != 0 {
            put(inout out, " state");
            put_space_num(inout out, prog.op(inc(ops_at)));
        }
        let pair_count = prog.op(add(ops_at, 2));
        let mut at = add(ops_at, 3);
        for k in 0..pair_count {
            out.push(32);
            put_name(in prog, inout out, prog.op(at));
            out.push(61);
            put_name(in prog, inout out, prog.op(inc(at)));
            at = add(at, 2);
        }
        let move_count = prog.op(at);
        at = inc(at);
        for k in 0..move_count {
            put(inout out, " move ");
            put_path(in prog, inout out, at);
            at = add(add(at, 2), prog.op(inc(at)));
        }
    }
    out.push(10);
}

fn put_term(in prog: Prog, inout out: ChunkSeq[u8], block_row: Blk) {
    let term_at = w(block_row.term_at);
    if block_row.term == T_RETURN {
        put(inout out, " return");
        put_space_num(inout out, prog.op(term_at));
    } else if block_row.term == T_JUMP {
        put(inout out, " jump");
        put_space_num(inout out, prog.op(term_at));
        let n = prog.op(inc(term_at));
        for k in 0..n {
            put_space_num(inout out, prog.op(add(add(term_at, 2), k)));
        }
    } else if block_row.term == T_BRANCH {
        put(inout out, " branch");
        put_space_num(inout out, prog.op(term_at));
        put_space_num(inout out, prog.op(inc(term_at)));
        put_space_num(inout out, prog.op(add(term_at, 2)));
    } else if block_row.term == T_MATCH {
        put(inout out, " match");
        put_space_num(inout out, prog.op(term_at));
        let n = prog.op(inc(term_at));
        for k in 0..n {
            out.push(32);
            put_pattern(in prog, inout out, prog.op(add(add(term_at, 2), wrapping_mul(k, 2))));
            put(inout out, "=>");
            push_decimal(inout out, prog.op(add(add(term_at, 3), wrapping_mul(k, 2))));
        }
    } else {
        put(inout out, " unreachable");
    }
    out.push(10);
}

// The program as `dump` writes it; locals in pool order (the harness sorts
// them by name).
fn put_dump(in prog: Prog, inout out: ChunkSeq[u8]) {
    for fun_index in 0..prog.funs.len() {
        let func = prog.fun(n32(fun_index));
        put(inout out, "fn ");
        put_name(in prog, inout out, w(func.name));
        put(inout out, " ->");
        put_space_num(inout out, w(func.result_ty));
        out.push(10);
        for k in 0..w(func.param_count) {
            let param = prog.param(func, k);
            put(inout out, "param ");
            put_name(in prog, inout out, w(param.name));
            put_space_num(inout out, param.pass);
            put_space_num(inout out, w(param.ty));
            out.push(10);
        }
        for k in 0..w(func.local_count) {
            put(inout out, "local ");
            put_name(
                in prog,
                inout out,
                w(u32_at(in prog.local_names, add(w(func.local_start), k)))
            );
            put_space_num(inout out, w(u32_at(in prog.local_types, add(w(func.local_start), k))));
            out.push(10);
        }
        for v in 0..w(func.value_count) {
            let ty = prog.value_ty(func, v);
            if ty != NONE32 {
                put(inout out, "value");
                put_space_num(inout out, v);
                put_space_num(inout out, w(ty));
                out.push(10);
            }
        }
        for block in 0..w(func.block_count) {
            let block_row = prog.block(func, block);
            put(inout out, "block");
            put_space_num(inout out, block);
            for k in 0..w(block_row.param_count) {
                put_space_num(inout out, w(prog.id(add(w(block_row.param_start), k))));
            }
            out.push(10);
            for k in 0..w(block_row.inst_count) {
                put_inst(in prog, inout out, prog.inst_of(block_row, k));
            }
            put_term(in prog, inout out, block_row);
        }
    }
}

// ----- program words ------------------------------------------------------------------
//
// The inlined program in the input's own encoding (`read_function`), so
// tests/common/inline_words.rs reads it back into an `ir::Program`: every
// name is a symbol of the package's name table, which comes first. Per function: name, locals (n, (name, type)*), value types
// (n, (value, type)*), blocks (n, per block: params, instructions,
// terminator). Each instruction is dest, type, span, flags, opaque, opcode
// and the operands `read_op` reads.

// A path at operand offset `at` (n, names); returns the offset after it.
fn put_path_words(in prog: Prog, inout out: ChunkSeq[u64], at: u64) -> u64 {
    let n = prog.op(at);
    out.push(n);
    for k in 0..n {
        out.push(prog.op(add(inc(at), k)));
    }
    add(inc(at), n)
}

fn put_pattern_words(in prog: Prog, inout out: ChunkSeq[u64], at: u64) {
    let kind = prog.pat(at);
    out.push(kind);
    if kind == PK_BIND {
        out.push(prog.pat(add(at, 3)));
    } else if kind == PK_TUPLE {
        let n = prog.pat(add(at, 3));
        out.push(n);
        for i in 0..n {
            put_pattern_words(in prog, inout out, prog.pat(add(add(at, 4), i)));
        }
    } else if kind == PK_CTOR {
        out.push(prog.pat(add(at, 3)));
        out.push(prog.pat(add(at, 4)));
        let n = prog.pat(add(at, 5));
        out.push(n);
        for i in 0..n {
            out.push(prog.pat(add(add(at, 6), wrapping_mul(i, 2))));
            put_pattern_words(in prog, inout out, prog.pat(add(add(at, 7), wrapping_mul(i, 2))));
        }
    } else if kind == PK_LIT {
        for k in 3..7 {
            out.push(prog.pat(add(at, k)));
        }
    }
    out.push(prog.pat(inc(at)));
    out.push(prog.pat(add(at, 2)));
}

fn put_args_words(in prog: Prog, inout out: ChunkSeq[u64], start: u64) {
    let n = prog.op(start);
    out.push(n);
    let mut at = inc(start);
    for k in 0..n {
        out.push(prog.op(at));
        out.push(prog.op(inc(at)));
        let has_place = prog.op(add(at, 2));
        out.push(has_place);
        if has_place != 0 {
            out.push(prog.op(add(at, 3)));
            let after = put_path_words(in prog, inout out, add(at, 4));
        }
        at = arg_end(in prog, at);
    }
}

// `count` operand words from offset `at`.
fn put_op_run(in prog: Prog, inout out: ChunkSeq[u64], at: u64, count: u64) {
    for k in 0..count {
        out.push(prog.op(add(at, k)));
    }
}

fn put_inst_words(in prog: Prog, inout out: ChunkSeq[u64], inst: Inst) {
    out.push(w(inst.dest));
    out.push(w(inst.ty));
    out.push(inst.span_start);
    out.push(inst.span_end);
    out.push(inst.flags);
    out.push(w(inst.opaque));
    out.push(widen_u64(inst.op));
    let ops_at = w(inst.ops_at);
    let op = inst.op;
    if op == O_CONST || op == O_BINARY {
        put_op_run(in prog, inout out, ops_at, 3);
    } else if op == O_READ {
        out.push(prog.op(ops_at));
        let after = put_path_words(in prog, inout out, inc(ops_at));
    } else if op == O_BIND {
        out.push(prog.op(ops_at));
        put_pattern_words(in prog, inout out, prog.op(inc(ops_at)));
    } else if op == O_WRITE {
        put_op_run(in prog, inout out, ops_at, 2);
        let after = put_path_words(in prog, inout out, add(ops_at, 2));
    } else if op == O_UNARY || op == O_INDEX {
        put_op_run(in prog, inout out, ops_at, 2);
    } else if op == O_PROJECT || op == O_TRY {
        out.push(prog.op(ops_at));
    } else if op == O_TUPLE || op == O_VECTOR {
        put_op_run(in prog, inout out, ops_at, inc(prog.op(ops_at)));
    } else if op == O_DATA {
        put_op_run(in prog, inout out, ops_at, add(prog.op(inc(ops_at)), 2));
    } else if op == O_CALL {
        put_op_run(in prog, inout out, ops_at, 2);
        put_args_words(in prog, inout out, add(ops_at, 2));
    } else if op == O_TILED || op == O_SEQ || op == O_FIP {
        put_args_words(in prog, inout out, ops_at);
    } else if op == O_INDIRECT {
        out.push(prog.op(ops_at));
        put_args_words(in prog, inout out, inc(ops_at));
    } else if op == O_EXIT {
        put_op_run(in prog, inout out, ops_at, 2);
    } else if op == O_HANDLE {
        let pair_count = prog.op(add(ops_at, 2));
        put_op_run(in prog, inout out, ops_at, add(3, wrapping_mul(pair_count, 2)));
        let mut at = add(add(ops_at, 3), wrapping_mul(pair_count, 2));
        let move_count = prog.op(at);
        out.push(move_count);
        at = inc(at);
        for k in 0..move_count {
            out.push(prog.op(at));
            at = put_path_words(in prog, inout out, inc(at));
        }
        put_op_run(in prog, inout out, at, inc(prog.op(at)));
    }
}

fn put_term_words(in prog: Prog, inout out: ChunkSeq[u64], block_row: Blk) {
    let term_at = w(block_row.term_at);
    out.push(widen_u64(block_row.term));
    if block_row.term == T_RETURN {
        out.push(prog.op(term_at));
    } else if block_row.term == T_JUMP {
        put_op_run(in prog, inout out, term_at, add(prog.op(inc(term_at)), 2));
    } else if block_row.term == T_BRANCH {
        put_op_run(in prog, inout out, term_at, 3);
    } else if block_row.term == T_MATCH {
        out.push(prog.op(term_at));
        let n = prog.op(inc(term_at));
        out.push(n);
        for k in 0..n {
            put_pattern_words(
                in prog,
                inout out,
                prog.op(add(add(term_at, 2), wrapping_mul(k, 2)))
            );
            out.push(prog.op(add(add(term_at, 3), wrapping_mul(k, 2))));
        }
    }
}

fn put_program_words(in prog: Prog, inout out: ChunkSeq[u64]) {
    // The name table first: every symbol's bytes, packed.
    let name_count = prog.names.len();
    out.push(name_count);
    let mut text: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for symbol in 0..name_count {
        text.clear();
        prog.names.write(n32(symbol), inout text);
        let packed = pack(in text);
        out.extend(in packed.as_slice());
    }
    out.push(prog.funs.len());
    for fun_index in 0..prog.funs.len() {
        let func = prog.fun(n32(fun_index));
        out.push(w(func.name));
        out.push(w(func.local_count));
        for k in 0..w(func.local_count) {
            out.push(w(u32_at(in prog.local_names, add(w(func.local_start), k))));
            out.push(w(u32_at(in prog.local_types, add(w(func.local_start), k))));
        }
        let mut value_words: ChunkSeq[u64] = ChunkSeq::new[u64]();
        for v in 0..w(func.value_count) {
            let ty = prog.value_ty(func, v);
            if ty != NONE32 {
                value_words.push(v);
                value_words.push(w(ty));
            }
        }
        out.push(value_words.len() / 2);
        out.extend(in value_words.as_slice());
        out.push(w(func.block_count));
        for block in 0..w(func.block_count) {
            let block_row = prog.block(func, block);
            out.push(w(block_row.param_count));
            for k in 0..w(block_row.param_count) {
                out.push(w(prog.id(add(w(block_row.param_start), k))));
            }
            out.push(w(block_row.inst_count));
            for k in 0..w(block_row.inst_count) {
                put_inst_words(in prog, inout out, prog.inst_of(block_row, k));
            }
            put_term_words(in prog, inout out, block_row);
        }
    }
}

// ----- entries --------------------------------------------------------------------------

// The text packed as words: a byte length, then the bytes eight per word.
fn pack(in text: ChunkSeq[u8]) -> ChunkSeq[u64] {
    let mut words: ChunkSeq[u64] = ChunkSeq::new[u64]();
    words.push(text.len());
    let mut word: u64 = 0;
    let mut shift: u64 = 0;
    for i in 0..text.len() {
        word = word | wrapping_shl_u64(widen_u64(u8_at(in text, i)), n32(shift));
        shift = add(shift, 8);
        if shift == 64 {
            words.push(word);
            word = 0;
            shift = 0;
        }
    }
    if shift > 0 {
        words.push(word);
    }
    words
}

// The hybrid's `inline` hook (crates/vesper-hybrid/modules/ir_inline): the
// inliner over `inline_input`'s bytes, returning what mode 3 returns.
pub fn inline_program_words(in bytes: Slice[u8]) -> ChunkSeq[u64] {
    let mut prog = read_input(in bytes);
    let report = inline(inout prog);
    let mut report_words: ChunkSeq[u64] = ChunkSeq::new[u64]();
    put_report(in prog, in report, inout report_words);
    let mut words: ChunkSeq[u64] = ChunkSeq::new[u64]();
    words.push(report_words.len());
    words.extend(in report_words.as_slice());
    put_program_words(in prog, inout words);
    words
}

// What `inline_entry` returns, by its first input word.
const MODE_REPORT: u64 = 0;
const MODE_DUMP: u64 = 1;
const MODE_INPUT: u64 = 2;
const MODE_PROGRAM: u64 = 3;

// The harness's one entry: the first word picks the result, the rest is
// the inliner's input.
// - 0: the report and every function's size and cost after inlining;
// - 1: the inlined program as text (`dump`);
// - 2: the input program as text, not inlined (the decoder's round trip);
// - 3: the report's length and words, then the inlined program as words
//   (`put_program_words`), which the hybrid's `inline` hook reads back.
pub fn inline_entry(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mode = match bytes.try_read_u64_le(0) {
        Option::Some(first_word) => first_word,
        Option::None => MODE_REPORT,
    };
    if mode == MODE_PROGRAM {
        return inline_program_words(in bytes[8..bytes.len()]);
    }
    let mut prog = read_input(in bytes[8..bytes.len()]);
    if mode == MODE_INPUT {
        let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
        put_dump(in prog, inout out);
        return pack(in out);
    }
    let report = inline(inout prog);
    if mode == MODE_DUMP {
        let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
        put_dump(in prog, inout out);
        return pack(in out);
    }
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    put_report(in prog, in report, inout out);
    out
}
