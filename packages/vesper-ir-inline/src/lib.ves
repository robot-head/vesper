// @vesper/ir-inline: the Place IR inliner of `src/ir_inline.rs` and
// `src/ir_inline/site.rs` (self-hosting SH3 lane 11, #1250).
//
// The whole pass runs here: literal constants, the call graph and its
// cycles (petgraph's Tarjan, node for node), the callee and caller rules,
// the cost model, site folding, partial inlining, the growth budgets and the
// splicing that later decisions read. What the pass asks of the world (a
// type's layout, whether it holds a sequence, a `Box` or a function, a
// function's `fip` flag and the checker's type arguments per call span)
// belongs to other ports; tests/common/inline_words.rs answers it as fact
// bits per type and per function.
//
// The program is decoded into flat pools: instructions, an operand pool, a
// pattern pool, block and function rows whose lists are ranges of an id
// pool. A list that grows (a caller's blocks, locals and values) is moved
// to the end of its pool the first time it grows while something else is
// there (a `ChunkSeq` of structs that own sequences cannot be indexed in
// place until element borrows land, SH2 lane 1).
//
// - `inline_report_words`: the `Report` and every function's size and cost
//   after inlining (`decode_report` in tests/common/inline_words.rs).
// - `inline_dump`: the inlined program as the canonical text `dump` writes.

use @vesper/check-data::util::{add, inc, inc32, n32, push_decimal, u32_at, u64_at, u8_at, w};
use @vesper/check-data::names::{Names, names_new};
use @vesper/check-data::input::{Reader};
use @vesper/check-data::types::{TyPass};

const NONE32: u32 = 4294967295;
const MAX64: u64 = 18446744073709551615;

// Type facts (tests/common/inline_words.rs `type_facts`).
const F_SCALAR: u64 = 1;
const F_AGGREGATE: u64 = 2;
const F_SEQUENCE: u64 = 4;
const F_SLICE: u64 = 8;
const F_BOX: u64 = 16;
const F_FUNCTION: u64 = 32;
const F_PLAIN: u64 = 64;
const F_NEVER: u64 = 128;

// Function facts.
const W_WORLD: u64 = 1;
const W_FIP: u64 = 2;
const W_GENERIC: u64 = 4;
const W_DYN: u64 = 8;
const W_SLOTS: u64 = 16;
const W_CAPTURES: u64 = 32;
const W_BORROWED_MATCH: u64 = 64;

// Instruction flags.
const I_FALLIBLE: u64 = 1;
const I_GENERIC_CALL: u64 = 2;

// Operations.
const O_CONST: u8 = 0;
const O_UNIT: u8 = 1;
const O_LOOP: u8 = 2;
const O_READ: u8 = 3;
const O_BIND: u8 = 4;
const O_WRITE: u8 = 5;
const O_UNARY: u8 = 6;
const O_BINARY: u8 = 7;
const O_INDEX: u8 = 8;
const O_PROJECT: u8 = 9;
const O_TRY: u8 = 10;
const O_TUPLE: u8 = 11;
const O_VECTOR: u8 = 12;
const O_DATA: u8 = 13;
const O_CALL: u8 = 14;
const O_TILED: u8 = 15;
const O_SEQ: u8 = 16;
const O_FIP: u8 = 17;
const O_INDIRECT: u8 = 18;
const O_EXIT: u8 = 19;
const O_HANDLE: u8 = 20;
const O_CLOSURE: u8 = 21;

// Terminators.
const T_RETURN: u8 = 0;
const T_JUMP: u8 = 1;
const T_BRANCH: u8 = 2;
const T_MATCH: u8 = 3;
const T_UNREACHABLE: u8 = 4;

// Pattern kinds.
const PK_WILD: u64 = 0;
const PK_BIND: u64 = 1;
const PK_TUPLE: u64 = 2;
const PK_CTOR: u64 = 3;
const PK_LIT: u64 = 4;

// Literal kinds.
const L_INT: u64 = 0;
const L_BOOL: u64 = 1;

// Refusal reasons (`REASONS` in tests/common/inline_words.rs).
const R_OK: u32 = 4294967295;
const R_RECURSIVE: u32 = 0;
const R_CALLER: u32 = 1;
const R_SIZE: u32 = 2;
const R_GROWTH: u32 = 3;
const R_NOT_WORLD: u32 = 4;
const R_FIP: u32 = 5;
const R_DYN: u32 = 6;
const R_GENERIC_HANDLER: u32 = 7;
const R_GENERIC_TYPES: u32 = 8;
const R_GENERIC_CALLS: u32 = 9;
const R_GENERIC_OPERATORS: u32 = 10;
const R_CAPTURES: u32 = 11;
const R_EFFECT_ROW: u32 = 12;
const R_SLOTS: u32 = 13;
const R_NEVER: u32 = 14;
const R_BORROWED_MATCH: u32 = 15;
const R_ENTRY: u32 = 16;
const R_BOX: u32 = 17;
const R_FUNCTION_TYPE: u32 = 18;
const R_SINK_SLICE: u32 = 19;
const R_CLOSURE: u32 = 20;
const R_TRY: u32 = 21;
const R_INDIRECT: u32 = 22;
const R_TILED: u32 = 23;
const R_FOREIGN_EXIT: u32 = 24;
const R_HANDLER_RETURN: u32 = 25;
const R_SITE_TYPES: u32 = 26;
const R_SITE_UNRECORDED: u32 = 27;
const R_SITE_SIGNATURE: u32 = 28;
const R_SITE_ROW: u32 = 29;
const R_SITE_GENERICS: u32 = 30;
const R_SITE_INOUT: u32 = 31;
const R_SITE_SEQUENCE: u32 = 32;
const R_SITE_FIELD: u32 = 33;
const R_SITE_REBIND: u32 = 34;
const R_SITE_COLD: u32 = 35;
const REASONS: u64 = 36;

// site.rs: smallest cold side worth a call, and what the call adds.
const MIN_COLD: u64 = 16;
const CALL_COST: u64 = 2;
// The fold's round bound.
const FOLD_ROUNDS: u64 = 32;

fn sub(a: u64, b: u64) -> u64 {
    wrapping_sub(a, b)
}

fn n8(x: u64) -> u8 {
    wrapping_u8(x)
}

// ----- tables -------------------------------------------------------------------

pub copy struct Inst {
    dest: u32,
    ty: u32,
    s0: u64,
    s1: u64,
    flags: u64,
    opq: u32,
    op: u8,
    // operands: ops[a..]
    a: u32,
}

pub copy struct Blk {
    // block parameters: ids[pa..pa+pn]
    pa: u32,
    pn: u32,
    // instruction ids: ids[ia..ia+ic]
    ia: u32,
    ic: u32,
    term: u8,
    // terminator operands: ops[ta..]
    ta: u32,
}

pub copy struct ParamRow {
    name: u32,
    pass: u64,
    ty: u32,
}

pub copy struct Fun {
    name: u32,
    flags: u64,
    result: u32,
    row: u32,
    // parameters: prm[pa..pa+pn]
    pa: u32,
    pn: u32,
    // bound names: ids[ba..ba+bn]
    ba: u32,
    bn: u32,
    // locals: loc_name/loc_ty[la..la+ln]
    la: u32,
    ln: u32,
    // value types, by id: val[va+id] is the type + 1 (0: none)
    va: u32,
    vn: u32,
    // block ids: fblk[fa..fa+fc]
    fa: u32,
    fc: u32,
}

// A generic call site's type arguments (`instance`).
pub copy struct Instance {
    callee: u32,
    s0: u64,
    s1: u64,
    has: bool,
    // substitution pairs: sub_from/sub_to[pa..pa+pn], sorted by `from`
    pa: u32,
    pn: u32,
    row: u32,
}

// What a site inlines: a program function, or an instance of a generic one.
pub copy struct Tgt {
    f: u32,
    // instance index, or NONE32
    inst: u32,
}

// An open-addressing map from u64 keys to u32 values.
pub struct MapU {
    keys: ChunkSeq[u64],
    vals: ChunkSeq[u32],
    used: ChunkSeq[u8],
    mask: u64,
    count: u64,
}

pub fn map_new(cap: u64) -> MapU {
    let mut keys: ChunkSeq[u64] = ChunkSeq::new[u64]();
    keys.resize(cap, 0);
    let mut vals: ChunkSeq[u32] = ChunkSeq::new[u32]();
    vals.resize(cap, 0);
    let mut used: ChunkSeq[u8] = ChunkSeq::new[u8]();
    used.resize(cap, 0);
    MapU { keys: keys, vals: vals, used: used, mask: sub(cap, 1), count: 0 }
}

fn hash64(key: u64) -> u64 {
    let mixed = wrapping_mul(key ^ (key >> 29), 11400714819323198485);
    mixed ^ (mixed >> 32)
}

impl MapU {
    pub fn get(in self, key: u64) -> u32 {
        let mut at = hash64(key) & self.mask;
        loop {
            if u8_at(in self.used, at) == 0 {
                return NONE32;
            }
            if u64_at(in self.keys, at) == key {
                return u32_at(in self.vals, at);
            }
            at = inc(at) & self.mask;
        }
    }

    fn grow(inout self) {
        let cap = wrapping_mul(inc(self.mask), 2);
        let mut bigger = map_new(cap);
        for i in 0..inc(self.mask) {
            if u8_at(in self.used, i) != 0 {
                bigger.set(u64_at(in self.keys, i), u32_at(in self.vals, i));
            }
        }
        self.keys = bigger.keys;
        self.vals = bigger.vals;
        self.used = bigger.used;
        self.mask = bigger.mask;
        self.count = bigger.count;
    }

    pub fn set(inout self, key: u64, value: u32) {
        let mut at = hash64(key) & self.mask;
        loop {
            if u8_at(in self.used, at) == 0 {
                break;
            }
            if u64_at(in self.keys, at) == key {
                let ok = self.vals.try_set(at, value);
                return;
            }
            at = inc(at) & self.mask;
        }
        let ok1 = self.keys.try_set(at, key);
        let ok2 = self.vals.try_set(at, value);
        let ok3 = self.used.try_set(at, 1);
        self.count = inc(self.count);
        if wrapping_mul(self.count, 2) > self.mask {
            self.grow();
        }
    }

    pub fn clear(inout self) {
        if self.count == 0 {
            return;
        }
        for i in 0..inc(self.mask) {
            let ok = self.used.try_set(i, 0);
        }
        self.count = 0;
    }
}

fn pair(high: u32, low: u32) -> u64 {
    wrapping_add(wrapping_mul(w(high), 4294967296), w(low))
}

fn set_u8(inout seq: ChunkSeq[u8], i: u64, value: u8) {
    let ok = seq.try_set(i, value);
}

fn set_u32(inout seq: ChunkSeq[u32], i: u64, value: u32) {
    let ok = seq.try_set(i, value);
}

fn set_u64(inout seq: ChunkSeq[u64], i: u64, value: u64) {
    let ok = seq.try_set(i, value);
}

fn zeros8(n: u64) -> ChunkSeq[u8] {
    let mut seq: ChunkSeq[u8] = ChunkSeq::new[u8]();
    seq.resize(n, 0);
    seq
}

fn fill32(n: u64, fill: u32) -> ChunkSeq[u32] {
    let mut seq: ChunkSeq[u32] = ChunkSeq::new[u32]();
    seq.resize(n, fill);
    seq
}

fn zeros64(n: u64) -> ChunkSeq[u64] {
    let mut seq: ChunkSeq[u64] = ChunkSeq::new[u64]();
    seq.resize(n, 0);
    seq
}

fn none32_at(in seq: ChunkSeq[u32], i: u64) -> u32 {
    match seq.try_get(i) {
        Option::Some(value) => value,
        Option::None => NONE32,
    }
}

// The program and everything the pass reads about it.
pub struct Prog {
    names: Names,
    // types: facts, kind (0 other, 1 named, 2 tuple, 3 function), name and
    // arguments targs[targa..targa+targn]
    tfacts: ChunkSeq[u64],
    tkind: ChunkSeq[u8],
    tname: ChunkSeq[u32],
    targa: ChunkSeq[u32],
    targn: ChunkSeq[u32],
    targs: ChunkSeq[u32],
    // effect rows: row_words[row_a[r]..]: count, (label + 1, name, args,
    // instance)*, tail + 1 (`instance` is the same index for equal instances)
    row_a: ChunkSeq[u32],
    row_words: ChunkSeq[u64],
    unit_ty: u32,
    bind_opq: u32,
    funs: ChunkSeq[Fun],
    // symbol -> function index
    fun_of: ChunkSeq[u32],
    prm: ChunkSeq[ParamRow],
    ids: ChunkSeq[u32],
    loc_name: ChunkSeq[u32],
    loc_ty: ChunkSeq[u32],
    val: ChunkSeq[u32],
    fblk: ChunkSeq[u32],
    blks: ChunkSeq[Blk],
    insts: ChunkSeq[Inst],
    ops: ChunkSeq[u64],
    pats: ChunkSeq[u64],
    instances: ChunkSeq[Instance],
    sub_from: ChunkSeq[u32],
    sub_to: ChunkSeq[u32],
    // Budget
    small_callee: u64,
    single_site_callee: u64,
    caller_growth: u64,
    program_growth: u64,
    callee_growth: u64,
    caller_handles: u64,
    // well-known names
    s_fail: u32,
    s_caps: ChunkSeq[u32],
    // name -> short name (after the last `::`)
    shorts: MapU,
    // symbol -> input name index
    input_index: ChunkSeq[u32],
}

fn no_fun() -> Fun {
    Fun {
        name: 0,
        flags: 0,
        result: 0,
        row: 0,
        pa: 0,
        pn: 0,
        ba: 0,
        bn: 0,
        la: 0,
        ln: 0,
        va: 0,
        vn: 0,
        fa: 0,
        fc: 0
    }
}

fn no_inst() -> Inst {
    Inst { dest: 0, ty: 0, s0: 0, s1: 0, flags: 0, opq: 0, op: O_UNIT, a: 0 }
}

fn no_blk() -> Blk {
    Blk { pa: 0, pn: 0, ia: 0, ic: 0, term: T_UNREACHABLE, ta: 0 }
}

impl Prog {
    pub fn fun(in self, f: u32) -> Fun {
        match self.funs.try_get(w(f)) {
            Option::Some(fun_row) => fun_row,
            Option::None => no_fun(),
        }
    }

    pub fn set_fun(inout self, f: u32, fun_row: Fun) {
        let ok = self.funs.try_set(w(f), fun_row);
    }

    pub fn inst(in self, i: u32) -> Inst {
        match self.insts.try_get(w(i)) {
            Option::Some(inst_row) => inst_row,
            Option::None => no_inst(),
        }
    }

    pub fn blk(in self, b: u32) -> Blk {
        match self.blks.try_get(w(b)) {
            Option::Some(blk_row) => blk_row,
            Option::None => no_blk(),
        }
    }

    pub fn param(in self, f: Fun, k: u64) -> ParamRow {
        match self.prm.try_get(add(w(f.pa), k)) {
            Option::Some(param_row) => param_row,
            Option::None => ParamRow { name: 0, pass: 0, ty: 0 },
        }
    }

    pub fn op(in self, i: u64) -> u64 {
        u64_at(in self.ops, i)
    }

    pub fn pat(in self, i: u64) -> u64 {
        u64_at(in self.pats, i)
    }

    pub fn id(in self, i: u64) -> u32 {
        u32_at(in self.ids, i)
    }

    // Block `k` of function `f`, by id.
    pub fn block_id(in self, f: Fun, k: u64) -> u32 {
        u32_at(in self.fblk, add(w(f.fa), k))
    }

    pub fn block(in self, f: Fun, k: u64) -> Blk {
        self.blk(self.block_id(f, k))
    }

    // Instruction `i` of block `b`.
    pub fn inst_of(in self, b: Blk, i: u64) -> Inst {
        self.inst(self.id(add(w(b.ia), i)))
    }

    pub fn fun_index(in self, name: u32) -> u32 {
        none32_at(in self.fun_of, w(name))
    }

    pub fn facts(in self, ty: u32) -> u64 {
        u64_at(in self.tfacts, w(ty))
    }

    pub fn has(in self, ty: u32, fact: u64) -> bool {
        (self.facts(ty) & fact) != 0
    }

    // A type of a target: an instance maps the callee's types.
    pub fn map(in self, inst: u32, ty: u32) -> u32 {
        if inst == NONE32 {
            return ty;
        }
        let instance = match self.instances.try_get(w(inst)) {
            Option::Some(instance) => instance,
            Option::None => return ty,
        };
        let mut lo = w(instance.pa);
        let mut hi = add(w(instance.pa), w(instance.pn));
        loop {
            if lo >= hi {
                return ty;
            }
            let mid = add(lo, hi) / 2;
            let from = u32_at(in self.sub_from, mid);
            if from == ty {
                return u32_at(in self.sub_to, mid);
            }
            if from < ty {
                lo = inc(mid);
            } else {
                hi = mid;
            }
        }
    }

    pub fn row_of(in self, g: Tgt) -> u32 {
        if g.inst != NONE32 {
            match self.instances.try_get(w(g.inst)) {
                Option::Some(instance) => return instance.row,
                Option::None => {},
            }
        }
        self.fun(g.f).row
    }

    // The type of value `value` in function `f`, NONE32 when it has none.
    pub fn value_ty(in self, f: Fun, value: u64) -> u32 {
        if value >= w(f.vn) {
            return NONE32;
        }
        let stored = u32_at(in self.val, add(w(f.va), value));
        if stored == 0 {
            NONE32
        } else {
            wrapping_sub(stored, 1)
        }
    }

    pub fn local_ty(in self, f: Fun, name: u32) -> u32 {
        for k in 0..w(f.ln) {
            let at = add(w(f.la), k);
            if u32_at(in self.loc_name, at) == name {
                return u32_at(in self.loc_ty, at);
            }
        }
        NONE32
    }

    pub fn row_count(in self, row: u32) -> u64 {
        u64_at(in self.row_words, w(u32_at(in self.row_a, w(row))))
    }

    pub fn input_name(in self, symbol: u32) -> u64 {
        w(none32_at(in self.input_index, w(symbol)))
    }

    pub fn budget_off(in self) -> bool {
        self.small_callee == 0 && self.single_site_callee == 0
    }
}

// ----- growing lists ------------------------------------------------------------

fn push_block(inout p: Prog, fi: u32, id: u32) {
    let mut f = p.fun(fi);
    let end = add(w(f.fa), w(f.fc));
    if end != p.fblk.len() {
        let start = p.fblk.len();
        for k in 0..w(f.fc) {
            let moved_id = u32_at(in p.fblk, add(w(f.fa), k));
            p.fblk.push(moved_id);
        }
        f.fa = n32(start);
    }
    p.fblk.push(id);
    f.fc = inc32(f.fc);
    p.set_fun(fi, f);
}

fn set_block(inout p: Prog, fi: u32, k: u64, id: u32) {
    let f = p.fun(fi);
    let ok = p.fblk.try_set(add(w(f.fa), k), id);
}

fn push_local(inout p: Prog, fi: u32, name: u32, ty: u32) {
    let mut f = p.fun(fi);
    let end = add(w(f.la), w(f.ln));
    if end != p.loc_name.len() {
        let start = p.loc_name.len();
        for k in 0..w(f.ln) {
            let moved_name = u32_at(in p.loc_name, add(w(f.la), k));
            let moved_ty = u32_at(in p.loc_ty, add(w(f.la), k));
            p.loc_name.push(moved_name);
            p.loc_ty.push(moved_ty);
        }
        f.la = n32(start);
    }
    p.loc_name.push(name);
    p.loc_ty.push(ty);
    f.ln = inc32(f.ln);
    p.set_fun(fi, f);
}

// `values.insert(v, ty)`.
fn set_value(inout p: Prog, fi: u32, value: u64, ty: u32) {
    let mut f = p.fun(fi);
    if value >= w(f.vn) {
        let end = add(w(f.va), w(f.vn));
        if end != p.val.len() {
            let start = p.val.len();
            for k in 0..w(f.vn) {
                let moved_ty = u32_at(in p.val, add(w(f.va), k));
                p.val.push(moved_ty);
            }
            f.va = n32(start);
        }
        let mut n = w(f.vn);
        loop {
            if n > value {
                break;
            }
            p.val.push(0);
            n = inc(n);
        }
        f.vn = n32(n);
        p.set_fun(fi, f);
    }
    let ok = p.val.try_set(add(w(f.va), value), inc32(ty));
}

// ----- decoding -----------------------------------------------------------------

fn sym(in nmap: ChunkSeq[u32], raw: u64) -> u32 {
    u32_at(in nmap, raw)
}

fn opt_sym(in nmap: ChunkSeq[u32], raw: u64) -> u64 {
    if raw == 0 {
        0
    } else {
        inc(w(u32_at(in nmap, sub(raw, 1))))
    }
}

fn read_path(inout r: Reader, in b: Slice[u8], in nmap: ChunkSeq[u32], inout ops: ChunkSeq[u64]) {
    let n = r.word(in b);
    ops.push(n);
    for i in 0..n {
        ops.push(w(sym(in nmap, r.word(in b))));
    }
}

fn read_literal(inout r: Reader, in b: Slice[u8], inout out: ChunkSeq[u64]) {
    out.push(r.word(in b));
    out.push(r.word(in b));
    out.push(r.word(in b));
}

// A pattern node: kind, start, stop, then Bind: name; Tuple: n, children;
// Constructor: name, named, n, (field, child)*; Literal: kind, lo, hi,
// opaque. Children are pool offsets.
fn read_pattern(
    inout r: Reader,
    in b: Slice[u8],
    in nmap: ChunkSeq[u32],
    inout pats: ChunkSeq[u64]
) -> u64 {
    let kind = r.word(in b);
    let mut body: ChunkSeq[u64] = ChunkSeq::new[u64]();
    if kind == PK_BIND {
        body.push(w(sym(in nmap, r.word(in b))));
    } else if kind == PK_TUPLE {
        let n = r.word(in b);
        body.push(n);
        for i in 0..n {
            let child = read_pattern(inout r, in b, in nmap, inout pats);
            body.push(child);
        }
    } else if kind == PK_CTOR {
        body.push(w(sym(in nmap, r.word(in b))));
        body.push(r.word(in b));
        let n = r.word(in b);
        body.push(n);
        for i in 0..n {
            body.push(w(sym(in nmap, r.word(in b))));
            let child = read_pattern(inout r, in b, in nmap, inout pats);
            body.push(child);
        }
    } else if kind == PK_LIT {
        read_literal(inout r, in b, inout body);
        body.push(r.word(in b));
    }
    let s0 = r.word(in b);
    let s1 = r.word(in b);
    let at = pats.len();
    pats.push(kind);
    pats.push(s0);
    pats.push(s1);
    pats.extend(in body.as_slice());
    at
}

fn read_args(inout r: Reader, in b: Slice[u8], in nmap: ChunkSeq[u32], inout ops: ChunkSeq[u64]) {
    let n = r.word(in b);
    ops.push(n);
    for i in 0..n {
        ops.push(r.word(in b));
        ops.push(r.word(in b));
        let has = r.word(in b);
        ops.push(has);
        if has != 0 {
            ops.push(w(sym(in nmap, r.word(in b))));
            read_path(inout r, in b, in nmap, inout ops);
        }
    }
}

fn read_op(inout r: Reader, in b: Slice[u8], in nmap: ChunkSeq[u32], inout p: Prog, op: u8) {
    if op == O_CONST {
        read_literal(inout r, in b, inout p.ops);
    } else if op == O_READ {
        p.ops.push(w(sym(in nmap, r.word(in b))));
        read_path(inout r, in b, in nmap, inout p.ops);
    } else if op == O_BIND {
        p.ops.push(r.word(in b));
        let at = read_pattern(inout r, in b, in nmap, inout p.pats);
        p.ops.push(at);
    } else if op == O_WRITE {
        p.ops.push(r.word(in b));
        p.ops.push(w(sym(in nmap, r.word(in b))));
        read_path(inout r, in b, in nmap, inout p.ops);
    } else if op == O_UNARY || op == O_INDEX {
        p.ops.push(r.word(in b));
        p.ops.push(r.word(in b));
    } else if op == O_BINARY {
        p.ops.push(r.word(in b));
        p.ops.push(r.word(in b));
        p.ops.push(r.word(in b));
    } else if op == O_PROJECT || op == O_TRY {
        p.ops.push(r.word(in b));
    } else if op == O_TUPLE || op == O_VECTOR {
        let n = r.word(in b);
        p.ops.push(n);
        for i in 0..n {
            p.ops.push(r.word(in b));
        }
    } else if op == O_DATA {
        p.ops.push(w(sym(in nmap, r.word(in b))));
        let n = r.word(in b);
        p.ops.push(n);
        for i in 0..n {
            p.ops.push(r.word(in b));
        }
    } else if op == O_CALL {
        p.ops.push(w(sym(in nmap, r.word(in b))));
        p.ops.push(r.word(in b));
        read_args(inout r, in b, in nmap, inout p.ops);
    } else if op == O_TILED || op == O_SEQ || op == O_FIP {
        read_args(inout r, in b, in nmap, inout p.ops);
    } else if op == O_INDIRECT {
        p.ops.push(r.word(in b));
        read_args(inout r, in b, in nmap, inout p.ops);
    } else if op == O_EXIT {
        p.ops.push(w(sym(in nmap, r.word(in b))));
        p.ops.push(r.word(in b));
    } else if op == O_HANDLE {
        p.ops.push(r.word(in b));
        p.ops.push(r.word(in b));
        let pair_count = r.word(in b);
        p.ops.push(pair_count);
        for i in 0..pair_count {
            p.ops.push(w(sym(in nmap, r.word(in b))));
            p.ops.push(w(sym(in nmap, r.word(in b))));
        }
        let move_count = r.word(in b);
        p.ops.push(move_count);
        for i in 0..move_count {
            p.ops.push(w(sym(in nmap, r.word(in b))));
            read_path(inout r, in b, in nmap, inout p.ops);
        }
        let graph_count = r.word(in b);
        p.ops.push(graph_count);
        for i in 0..graph_count {
            p.ops.push(w(sym(in nmap, r.word(in b))));
        }
    }
}

fn read_terminator(
    inout r: Reader,
    in b: Slice[u8],
    in nmap: ChunkSeq[u32],
    inout p: Prog,
    term: u8
) {
    if term == T_RETURN {
        p.ops.push(r.word(in b));
    } else if term == T_JUMP {
        p.ops.push(r.word(in b));
        let n = r.word(in b);
        p.ops.push(n);
        for i in 0..n {
            p.ops.push(r.word(in b));
        }
    } else if term == T_BRANCH {
        p.ops.push(r.word(in b));
        p.ops.push(r.word(in b));
        p.ops.push(r.word(in b));
    } else if term == T_MATCH {
        p.ops.push(r.word(in b));
        let n = r.word(in b);
        p.ops.push(n);
        for i in 0..n {
            let at = read_pattern(inout r, in b, in nmap, inout p.pats);
            p.ops.push(at);
            p.ops.push(r.word(in b));
        }
    }
}

fn read_function(inout r: Reader, in b: Slice[u8], in nmap: ChunkSeq[u32], inout p: Prog) {
    let name = sym(in nmap, r.word(in b));
    let flags = r.word(in b);
    let result = n32(r.word(in b));
    let row = n32(r.word(in b));
    let pa = n32(p.prm.len());
    let pn = r.word(in b);
    for i in 0..pn {
        let pname = sym(in nmap, r.word(in b));
        let pass = r.word(in b);
        let ty = n32(r.word(in b));
        p.prm.push(ParamRow { name: pname, pass: pass, ty: ty });
    }
    let ba = n32(p.ids.len());
    let bn = r.word(in b);
    for i in 0..bn {
        p.ids.push(sym(in nmap, r.word(in b)));
    }
    let la = n32(p.loc_name.len());
    let ln = r.word(in b);
    for i in 0..ln {
        p.loc_name.push(sym(in nmap, r.word(in b)));
        p.loc_ty.push(n32(r.word(in b)));
    }
    // Value types, dense by id.
    let va = p.val.len();
    let value_count = r.word(in b);
    let mut vn: u64 = 0;
    for i in 0..value_count {
        let id = r.word(in b);
        let ty = n32(r.word(in b));
        loop {
            if vn > id {
                break;
            }
            p.val.push(0);
            vn = inc(vn);
        }
        let ok = p.val.try_set(add(va, id), inc32(ty));
    }
    let fa = n32(p.fblk.len());
    let block_count = r.word(in b);
    for bi in 0..block_count {
        let param_start = n32(p.ids.len());
        let param_count = r.word(in b);
        for i in 0..param_count {
            p.ids.push(n32(r.word(in b)));
        }
        let ic = r.word(in b);
        let mut inst_ids: ChunkSeq[u32] = ChunkSeq::new[u32]();
        for ii in 0..ic {
            let dest = n32(r.word(in b));
            let ty = n32(r.word(in b));
            let s0 = r.word(in b);
            let s1 = r.word(in b);
            let iflags = r.word(in b);
            let opq = n32(r.word(in b));
            let op = n8(r.word(in b));
            let ops_at = n32(p.ops.len());
            read_op(inout r, in b, in nmap, inout p, op);
            inst_ids.push(n32(p.insts.len()));
            p.insts.push(
                Inst {
                    dest: dest,
                    ty: ty,
                    s0: s0,
                    s1: s1,
                    flags: iflags,
                    opq: opq,
                    op: op,
                    a: ops_at
                }
            );
        }
        let ia = n32(p.ids.len());
        p.ids.extend(in inst_ids.as_slice());
        let term = n8(r.word(in b));
        let ta = n32(p.ops.len());
        read_terminator(inout r, in b, in nmap, inout p, term);
        p.fblk.push(n32(p.blks.len()));
        p.blks.push(
            Blk { pa: param_start, pn: n32(param_count), ia: ia, ic: n32(ic), term: term, ta: ta }
        );
    }
    let index = n32(p.funs.len());
    p.funs.push(
        Fun {
            name: name,
            flags: flags,
            result: result,
            row: row,
            pa: pa,
            pn: n32(pn),
            ba: ba,
            bn: n32(bn),
            la: la,
            ln: n32(ln),
            va: n32(va),
            vn: n32(vn),
            fa: fa,
            fc: n32(block_count)
        }
    );
    if w(name) >= p.fun_of.len() {
        p.fun_of.resize(inc(w(name)), NONE32);
    }
    let ok = p.fun_of.try_set(w(name), index);
}

fn intern_text(inout names: Names, in text: Str) -> u32 {
    names.intern(in text.as_bytes())
}

pub fn read_input(in b: Slice[u8]) -> Prog {
    let mut r = Reader { pos: 0 };
    let mut names = names_new();
    let mut nmap: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let count = r.word(in b);
    for i in 0..count {
        let len = r.word(in b);
        let start = r.pos;
        let symbol = names.intern(in b[start..add(start, len)]);
        nmap.push(symbol);
        r.pos = add(start, wrapping_mul(add(len, 7) / 8, 8));
    }
    let s_fail = intern_text(inout names, "Fail");
    let mut caps: ChunkSeq[u32] = ChunkSeq::new[u32]();
    caps.push(intern_text(inout names, "ConstTime"));
    caps.push(intern_text(inout names, "Realtime"));
    caps.push(intern_text(inout names, "DetFloat"));
    caps.push(intern_text(inout names, "ConstDenorm"));
    caps.push(intern_text(inout names, "Isa"));
    let mut p = Prog {
        names: names,
        tfacts: ChunkSeq::new[u64](),
        tkind: ChunkSeq::new[u8](),
        tname: ChunkSeq::new[u32](),
        targa: ChunkSeq::new[u32](),
        targn: ChunkSeq::new[u32](),
        targs: ChunkSeq::new[u32](),
        row_a: ChunkSeq::new[u32](),
        row_words: ChunkSeq::new[u64](),
        unit_ty: 0,
        bind_opq: 0,
        funs: ChunkSeq::new[Fun](),
        fun_of: ChunkSeq::new[u32](),
        prm: ChunkSeq::new[ParamRow](),
        ids: ChunkSeq::new[u32](),
        loc_name: ChunkSeq::new[u32](),
        loc_ty: ChunkSeq::new[u32](),
        val: ChunkSeq::new[u32](),
        fblk: ChunkSeq::new[u32](),
        blks: ChunkSeq::new[Blk](),
        insts: ChunkSeq::new[Inst](),
        ops: ChunkSeq::new[u64](),
        pats: ChunkSeq::new[u64](),
        instances: ChunkSeq::new[Instance](),
        sub_from: ChunkSeq::new[u32](),
        sub_to: ChunkSeq::new[u32](),
        small_callee: 0,
        single_site_callee: 0,
        caller_growth: 0,
        program_growth: 0,
        callee_growth: 0,
        caller_handles: 0,
        s_fail: s_fail,
        s_caps: caps,
        shorts: map_new(1024),
        input_index: ChunkSeq::new[u32](),
    };
    p.input_index.resize(p.names.len(), NONE32);
    for i in 0..nmap.len() {
        set_u32(inout p.input_index, w(u32_at(in nmap, i)), n32(i));
    }
    let type_count = r.word(in b);
    for i in 0..type_count {
        p.tfacts.push(r.word(in b));
        p.tkind.push(n8(r.word(in b)));
        p.tname.push(sym(in nmap, r.word(in b)));
        let arg_count = r.word(in b);
        p.targa.push(n32(p.targs.len()));
        p.targn.push(n32(arg_count));
        for k in 0..arg_count {
            p.targs.push(n32(r.word(in b)));
        }
    }
    let nrows = r.word(in b);
    for i in 0..nrows {
        p.row_a.push(n32(p.row_words.len()));
        let label_count = r.word(in b);
        p.row_words.push(label_count);
        for k in 0..label_count {
            p.row_words.push(opt_sym(in nmap, r.word(in b)));
            p.row_words.push(w(sym(in nmap, r.word(in b))));
            p.row_words.push(r.word(in b));
            p.row_words.push(r.word(in b));
        }
        p.row_words.push(opt_sym(in nmap, r.word(in b)));
    }
    p.unit_ty = n32(r.word(in b));
    p.bind_opq = n32(r.word(in b));
    p.small_callee = r.word(in b);
    p.single_site_callee = r.word(in b);
    p.caller_growth = r.word(in b);
    p.program_growth = r.word(in b);
    p.callee_growth = r.word(in b);
    p.caller_handles = r.word(in b);
    let fun_count = r.word(in b);
    p.fun_of.resize(p.names.len(), NONE32);
    for i in 0..fun_count {
        read_function(inout r, in b, in nmap, inout p);
    }
    let instance_count = r.word(in b);
    for i in 0..instance_count {
        let callee = sym(in nmap, r.word(in b));
        let s0 = r.word(in b);
        let s1 = r.word(in b);
        let has = r.word(in b) != 0;
        let pa = n32(p.sub_from.len());
        let mut pn: u64 = 0;
        let mut row: u32 = 0;
        if has {
            pn = r.word(in b);
            for k in 0..pn {
                p.sub_from.push(n32(r.word(in b)));
                p.sub_to.push(n32(r.word(in b)));
            }
            row = n32(r.word(in b));
        }
        p.instances.push(
            Instance { callee: callee, s0: s0, s1: s1, has: has, pa: pa, pn: n32(pn), row: row }
        );
    }
    p
}

// ----- operands -----------------------------------------------------------------

// The offset of the argument count of an operation with arguments.
fn args_at(op: u8, ops_at: u64) -> u64 {
    if op == O_CALL {
        add(ops_at, 2)
    } else if op == O_INDIRECT {
        inc(ops_at)
    } else {
        ops_at
    }
}

fn has_args(op: u8) -> bool {
    op == O_CALL || op == O_TILED || op == O_SEQ || op == O_FIP || op == O_INDIRECT
}

// The offset just past the argument at `off`.
fn arg_end(in p: Prog, off: u64) -> u64 {
    if p.op(add(off, 2)) != 0 {
        add(add(off, 5), p.op(add(off, 4)))
    } else {
        add(off, 3)
    }
}

// The offset of the graph count of a handle at `ops_at`.
fn handle_graphs_at(in p: Prog, ops_at: u64) -> u64 {
    let pair_count = p.op(add(ops_at, 2));
    let mut at = add(add(ops_at, 3), wrapping_mul(pair_count, 2));
    let move_count = p.op(at);
    at = inc(at);
    for i in 0..move_count {
        at = add(add(at, 2), p.op(inc(at)));
    }
    at
}

// Successors of a terminator.
fn successors(in p: Prog, bk: Blk, inout out: ChunkSeq[u32]) {
    out.clear();
    let ta = w(bk.ta);
    if bk.term == T_JUMP {
        out.push(n32(p.op(ta)));
    } else if bk.term == T_BRANCH {
        out.push(n32(p.op(inc(ta))));
        out.push(n32(p.op(add(ta, 2))));
    } else if bk.term == T_MATCH {
        let arm_count = p.op(inc(ta));
        for i in 0..arm_count {
            out.push(n32(p.op(add(add(ta, 3), wrapping_mul(i, 2)))));
        }
    }
}

// Names a pattern binds (`pattern_binds`), appended to `out`.
fn pattern_binds(in p: Prog, at: u64, inout out: ChunkSeq[u32]) {
    let kind = p.pat(at);
    if kind == PK_BIND {
        out.push(n32(p.pat(add(at, 3))));
    } else if kind == PK_TUPLE {
        let n = p.pat(add(at, 3));
        for i in 0..n {
            pattern_binds(in p, p.pat(add(add(at, 4), i)), inout out);
        }
    } else if kind == PK_CTOR {
        let n = p.pat(add(at, 5));
        for i in 0..n {
            pattern_binds(in p, p.pat(add(add(at, 7), wrapping_mul(i, 2))), inout out);
        }
    }
}

fn pattern_binds_any(in p: Prog, at: u64) -> bool {
    let mut names: ChunkSeq[u32] = ChunkSeq::new[u32]();
    pattern_binds(in p, at, inout names);
    names.len() > 0
}

// ----- names --------------------------------------------------------------------

fn name_byte(in p: Prog, symbol: u32, i: u64) -> u8 {
    p.names.byte(symbol, i)
}

// `arrays::is_const_function`: `const$NAME`, or a package's
// `{scope}__{package}__{module}__const$NAME`.
fn is_const_function(in p: Prog, symbol: u32) -> bool {
    let size = p.names.size(symbol);
    let word = "const$".as_bytes();
    let word_len = word.len();
    if size < word_len {
        return false;
    }
    let mut at: u64 = 0;
    loop {
        if add(at, word_len) > size {
            return false;
        }
        let mut same = true;
        for j in 0..word_len {
            let byte = match word.try_get(j) {
                Option::Some(byte) => byte,
                Option::None => 0,
            };
            if name_byte(in p, symbol, add(at, j)) != byte {
                same = false;
                break;
            }
        }
        if same {
            if at == 0 {
                return true;
            }
            if at >= 2
                && name_byte(in p, symbol, sub(at, 1)) == 95
                && name_byte(in p, symbol, sub(at, 2)) == 95 {
                return true;
            }
        }
        at = inc(at);
    }
}

// The name after the last `::` (`site::short`), interned.
fn short(inout p: Prog, symbol: u32) -> u32 {
    let cached = p.shorts.get(w(symbol));
    if cached != NONE32 {
        return cached;
    }
    let size = p.names.size(symbol);
    let mut from: u64 = 0;
    let mut i: u64 = 0;
    loop {
        if inc(i) >= size {
            break;
        }
        if name_byte(in p, symbol, i) == 58 && name_byte(in p, symbol, inc(i)) == 58 {
            from = add(i, 2);
        }
        i = inc(i);
    }
    let mut out = symbol;
    if from > 0 {
        let mut buf: ChunkSeq[u8] = ChunkSeq::new[u8]();
        for k in from..size {
            buf.push(name_byte(in p, symbol, k));
        }
        out = p.names.intern(in buf.as_slice());
    }
    p.shorts.set(w(symbol), out);
    out
}

// `name$inlN`.
fn renamed(inout p: Prog, symbol: u32, serial: u64) -> u32 {
    let mut buf: ChunkSeq[u8] = ChunkSeq::new[u8]();
    p.names.write(symbol, inout buf);
    buf.extend(in "$inl".as_bytes());
    push_decimal(inout buf, serial);
    p.names.intern(in buf.as_slice())
}

// ----- rows ---------------------------------------------------------------------

// The words of one effect instance in `row_words`.
const ROW_STRIDE: u64 = 4;

// `fail_row_only`: no tail, and only unlabeled one-argument `Fail`s.
fn fail_row_only(in p: Prog, row: u32) -> bool {
    let row_at = w(u32_at(in p.row_a, w(row)));
    let label_count = u64_at(in p.row_words, row_at);
    for i in 0..label_count {
        let entry = add(inc(row_at), wrapping_mul(i, ROW_STRIDE));
        if u64_at(in p.row_words, entry) != 0
            || u64_at(in p.row_words, inc(entry)) != w(p.s_fail)
            || u64_at(in p.row_words, add(entry, 2)) != 1 {
            return false;
        }
    }
    u64_at(in p.row_words, add(inc(row_at), wrapping_mul(label_count, ROW_STRIDE))) == 0
}

// A capability effect (`capability_effects::is_capability_effect`) in row `row`.
fn row_has_capability(in p: Prog, row: u32) -> bool {
    let row_at = w(u32_at(in p.row_a, w(row)));
    let label_count = u64_at(in p.row_words, row_at);
    for i in 0..label_count {
        let name = n32(
            u64_at(in p.row_words, add(add(inc(row_at), wrapping_mul(i, ROW_STRIDE)), 1))
        );
        for k in 0..p.s_caps.len() {
            if u32_at(in p.s_caps, k) == name {
                return true;
            }
        }
    }
    false
}

// ----- types --------------------------------------------------------------------

// `mentions_names`: a bare named type in `names`, or any function type.
fn mentions_names(in p: Prog, ty: u32, in names: ChunkSeq[u32]) -> bool {
    let kind = u8_at(in p.tkind, w(ty));
    let arg_start = w(u32_at(in p.targa, w(ty)));
    let arg_count = w(u32_at(in p.targn, w(ty)));
    if kind == 1 {
        if arg_count == 0 {
            let name = u32_at(in p.tname, w(ty));
            for k in 0..names.len() {
                if u32_at(in names, k) == name {
                    return true;
                }
            }
        }
        for k in 0..arg_count {
            if mentions_names(in p, u32_at(in p.targs, add(arg_start, k)), in names) {
                return true;
            }
        }
        return false;
    }
    if kind == 2 {
        for k in 0..arg_count {
            if mentions_names(in p, u32_at(in p.targs, add(arg_start, k)), in names) {
                return true;
            }
        }
        return false;
    }
    kind == 3
}

// The types of a target: parameters, values, locals and result.
fn any_type(
    in p: Prog,
    g: Tgt,
    fact: u64,
    values: bool,
    locals: bool,
    params: bool,
    result: bool
) -> bool {
    let f = p.fun(g.f);
    if values {
        for v in 0..w(f.vn) {
            let ty = p.value_ty(f, v);
            if ty != NONE32 && p.has(p.map(g.inst, ty), fact) {
                return true;
            }
        }
    }
    if locals {
        for k in 0..w(f.ln) {
            let ty = u32_at(in p.loc_ty, add(w(f.la), k));
            if p.has(p.map(g.inst, ty), fact) {
                return true;
            }
        }
    }
    if params {
        for k in 0..w(f.pn) {
            if p.has(p.map(g.inst, p.param(f, k).ty), fact) {
                return true;
            }
        }
    }
    result && p.has(p.map(g.inst, f.result), fact)
}

// ----- cost ---------------------------------------------------------------------

// What a site's known arguments decide in a callee (`site::Folded`).
pub struct Folded {
    // per block: reachable
    live: ChunkSeq[u8],
    // per block: the one successor a decided Branch or Match takes, or NONE32
    jumps: ChunkSeq[u32],
    // per value: determined by the arguments
    known: ChunkSeq[u8],
    njumps: u64,
}

fn folded_none(blocks: u64) -> Folded {
    let mut live = zeros8(blocks);
    for k in 0..blocks {
        set_u8(inout live, k, 1);
    }
    Folded { live: live, jumps: fill32(blocks, NONE32), known: ChunkSeq::new[u8](), njumps: 0 }
}

impl Folded {
    // `Folded::decides`.
    pub fn decides(in self) -> bool {
        if self.njumps > 0 {
            return true;
        }
        for k in 0..self.live.len() {
            if u8_at(in self.live, k) == 0 {
                return true;
            }
        }
        false
    }

    pub fn jump(in self, b: u64) -> u32 {
        none32_at(in self.jumps, b)
    }
}

// `Folded::successors`.
fn folded_successors(in p: Prog, f: Fun, in fd: Folded, b: u64, inout out: ChunkSeq[u32]) {
    let taken = fd.jump(b);
    if taken != NONE32 {
        out.clear();
        out.push(taken);
        return;
    }
    successors(in p, p.block(f, b), inout out);
}

// Free in `cost` (`cost_parts`).
fn free(in p: Prog, g: Tgt, f: Fun, inst: Inst) -> bool {
    let ops_at = w(inst.a);
    if inst.op == O_CONST || inst.op == O_UNIT || inst.op == O_LOOP {
        return true;
    }
    if inst.op == O_READ {
        return p.op(inc(ops_at)) == 0;
    }
    if inst.op == O_DATA {
        return p.op(inc(ops_at)) == 0 && p.has(p.map(g.inst, inst.ty), F_SCALAR);
    }
    if inst.op == O_BIND {
        let kind = p.pat(p.op(inc(ops_at)));
        if kind != PK_BIND && kind != PK_WILD {
            return false;
        }
        let ty = p.value_ty(f, p.op(ops_at));
        return ty != NONE32 && p.has(p.map(g.inst, ty), F_SCALAR);
    }
    false
}

// `Folded::cost_of`: the cost of the blocks `blocks` marks under `fd`.
fn cost_of(in p: Prog, g: Tgt, in fd: Folded, in blocks: ChunkSeq[u8]) -> u64 {
    let f = p.fun(g.f);
    let mut total: u64 = 0;
    for b in 0..w(f.fc) {
        if u8_at(in blocks, b) == 0 {
            continue;
        }
        let bk = p.block(f, b);
        let mut work: u64 = 0;
        for k in 0..w(bk.ic) {
            let inst = p.inst_of(bk, k);
            if free(in p, g, f, inst) {
                continue;
            }
            if u8_at(in fd.known, w(inst.dest)) != 0
                && (
                    inst.op == O_BINARY
                        || inst.op == O_UNARY
                        || inst.op == O_READ
                        || inst.op == O_DATA
                ) {
                continue;
            }
            work = inc(work);
        }
        let jump = bk.term == T_JUMP || fd.jump(b) != NONE32;
        total = add(total, work);
        if !(work == 0 && jump) {
            total = inc(total);
        }
    }
    total
}

fn folded_cost(in p: Prog, g: Tgt, in fd: Folded) -> u64 {
    cost_of(in p, g, in fd, in fd.live)
}

// `cost`.
fn cost(in p: Prog, g: Tgt) -> u64 {
    let fd = folded_none(w(p.fun(g.f).fc));
    folded_cost(in p, g, in fd)
}

// `size`: instructions plus one per block.
fn size(in p: Prog, fi: u32) -> u64 {
    let f = p.fun(fi);
    let mut total: u64 = 0;
    for b in 0..w(f.fc) {
        total = add(total, inc(w(p.block(f, b).ic)));
    }
    total
}

// The handler graphs of function `fi` (`handler_graphs`), as names.
fn handler_graphs(in p: Prog, fi: u32, inout out: ChunkSeq[u32]) {
    let f = p.fun(fi);
    for b in 0..w(f.fc) {
        let bk = p.block(f, b);
        for k in 0..w(bk.ic) {
            let inst = p.inst_of(bk, k);
            if inst.op == O_HANDLE {
                let at = handle_graphs_at(in p, w(inst.a));
                let graph_count = p.op(at);
                for j in 0..graph_count {
                    out.push(n32(p.op(add(inc(at), j))));
                }
            }
        }
    }
}

fn own_handles(in p: Prog, fi: u32) -> u64 {
    let f = p.fun(fi);
    let mut n: u64 = 0;
    for b in 0..w(f.fc) {
        let bk = p.block(f, b);
        for k in 0..w(bk.ic) {
            if p.inst_of(bk, k).op == O_HANDLE {
                n = inc(n);
            }
        }
    }
    n
}

// `handles` (count = true) or the handler graphs' part of
// `cost_with_handlers` (count = false): over every graph `fi` holds,
// transitively, each once.
fn handler_sum(in p: Prog, fi: u32, count: bool) -> u64 {
    let mut total: u64 = 0;
    if count {
        total = own_handles(in p, fi);
    }
    let mut pending: ChunkSeq[u32] = ChunkSeq::new[u32]();
    handler_graphs(in p, fi, inout pending);
    let mut seen = map_new(16);
    loop {
        let n = pending.len();
        if n == 0 {
            break;
        }
        let name = u32_at(in pending, sub(n, 1));
        pending.truncate(sub(n, 1));
        if seen.get(w(name)) != NONE32 {
            continue;
        }
        seen.set(w(name), 1);
        let graph_fi = p.fun_index(name);
        if graph_fi == NONE32 {
            continue;
        }
        if count {
            total = add(total, own_handles(in p, graph_fi));
        } else {
            total = add(total, cost(in p, Tgt { f: graph_fi, inst: NONE32 }));
        }
        handler_graphs(in p, graph_fi, inout pending);
    }
    total
}

// ----- callee and caller rules ----------------------------------------------------

// `generic_body_ok`.
fn generic_body(in p: Prog, f: Fun) -> u32 {
    for b in 0..w(f.fc) {
        let bk = p.block(f, b);
        for k in 0..w(bk.ic) {
            let inst = p.inst_of(bk, k);
            if inst.op == O_HANDLE {
                return R_GENERIC_HANDLER;
            }
            if inst.op == O_CALL && (p.op(inc(w(inst.a))) & 1) != 0 {
                return R_GENERIC_TYPES;
            }
            if (inst.op == O_CALL || inst.op == O_SEQ) && (inst.flags & I_GENERIC_CALL) != 0 {
                return R_GENERIC_CALLS;
            }
            if inst.op == O_UNARY
                || inst.op == O_BINARY
                || inst.op == O_INDEX
                || inst.op == O_PROJECT {
                return R_GENERIC_OPERATORS;
            }
        }
    }
    R_OK
}

// `inlinable`: callee properties that do not depend on the call site.
fn inlinable(in p: Prog, fi: u32) -> u32 {
    let f = p.fun(fi);
    let g = Tgt { f: fi, inst: NONE32 };
    if (f.flags & W_WORLD) == 0 {
        return R_NOT_WORLD;
    }
    if (f.flags & W_FIP) != 0 {
        return R_FIP;
    }
    if (f.flags & W_DYN) != 0 {
        return R_DYN;
    }
    if (f.flags & W_GENERIC) != 0 {
        let why = generic_body(in p, f);
        if why != R_OK {
            return why;
        }
    }
    if (f.flags & W_CAPTURES) != 0 {
        return R_CAPTURES;
    }
    if !fail_row_only(in p, f.row) {
        return R_EFFECT_ROW;
    }
    if (f.flags & W_SLOTS) != 0 {
        return R_SLOTS;
    }
    if p.has(f.result, F_NEVER) {
        return R_NEVER;
    }
    if (f.flags & W_BORROWED_MATCH) != 0 {
        return R_BORROWED_MATCH;
    }
    if f.fc == 0 || p.block(f, 0).pn != 0 {
        return R_ENTRY;
    }
    if any_type(in p, g, F_BOX, true, true, true, true) {
        return R_BOX;
    }
    if any_type(in p, g, F_FUNCTION, true, true, true, true) {
        return R_FUNCTION_TYPE;
    }
    for k in 0..w(f.pn) {
        let param = p.param(f, k);
        if param.pass == TyPass::Sink && p.has(param.ty, F_SLICE) {
            return R_SINK_SLICE;
        }
    }
    for b in 0..w(f.fc) {
        let bk = p.block(f, b);
        for k in 0..w(bk.ic) {
            let inst = p.inst_of(bk, k);
            if inst.op == O_CLOSURE {
                return R_CLOSURE;
            }
            if inst.op == O_TRY {
                return R_TRY;
            }
            if inst.op == O_INDIRECT {
                return R_INDIRECT;
            }
            if inst.op == O_TILED || inst.op == O_FIP {
                return R_TILED;
            }
            if inst.op == O_EXIT && n32(p.op(w(inst.a))) != f.name {
                return R_FOREIGN_EXIT;
            }
        }
    }
    R_OK
}

// `caller_eligible`.
fn caller_eligible(in p: Prog, fi: u32) -> bool {
    let f = p.fun(fi);
    if (f.flags & W_WORLD) != 0 && (f.flags & W_FIP) != 0 {
        return false;
    }
    if (f.flags & W_SLOTS) != 0 || row_has_capability(in p, f.row) {
        return false;
    }
    ! any_type(in p, Tgt { f: fi, inst: NONE32 }, F_BOX, true, true, true, false)
}

// ----- literal constants ----------------------------------------------------------

// `fold_literal_constants`: calls of a constant function that returns one
// literal become that literal. Returns the uses replaced.
fn fold_literal_constants(inout p: Prog) -> u64 {
    let fun_count = p.funs.len();
    // function -> its literal instruction, or NONE32
    let mut literal = fill32(fun_count, NONE32);
    let mut any = false;
    for fi in 0..fun_count {
        let f = p.fun(n32(fi));
        if f.pn != 0 || f.fc != 1 || !is_const_function(in p, f.name) {
            continue;
        }
        let bk = p.block(f, 0);
        if bk.ic != 1 || bk.term != T_RETURN {
            continue;
        }
        let id = p.id(w(bk.ia));
        let inst = p.inst(id);
        if w(inst.dest) == p.op(w(bk.ta)) && (inst.flags & I_FALLIBLE) == 0 && inst.op == O_CONST {
            set_u32(inout literal, fi, id);
            any = true;
        }
    }
    if !any {
        return 0;
    }
    let mut folded: u64 = 0;
    for fi in 0..fun_count {
        if !caller_eligible(in p, n32(fi)) {
            continue;
        }
        let f = p.fun(n32(fi));
        for b in 0..w(f.fc) {
            let bk = p.block(f, b);
            for k in 0..w(bk.ic) {
                let id = p.id(add(w(bk.ia), k));
                let inst = p.inst(id);
                if inst.op != O_CALL {
                    continue;
                }
                let ops_at = w(inst.a);
                if p.op(add(ops_at, 2)) != 0 {
                    continue;
                }
                let callee = p.fun_index(n32(p.op(ops_at)));
                if callee == NONE32 {
                    continue;
                }
                let lit_id = u32_at(in literal, w(callee));
                if lit_id == NONE32 {
                    continue;
                }
                let lit_inst = p.inst(lit_id);
                let ok = p.insts.try_set(
                    w(id),
                    Inst {
                        dest: inst.dest,
                        ty: inst.ty,
                        s0: inst.s0,
                        s1: inst.s1,
                        flags: inst.flags & I_GENERIC_CALL,
                        opq: lit_inst.opq,
                        op: O_CONST,
                        a: lit_inst.a
                    }
                );
                folded = inc(folded);
            }
        }
    }
    folded
}

// ----- the call graph ---------------------------------------------------------------

// petgraph's `DiGraphMap` as `inline` builds it: nodes in the order they
// first appear (as a node or an edge end), each node's distinct successors
// in the order their edges were first added.
pub struct Graph {
    // node position -> function index
    nodes: ChunkSeq[u32],
    // function index -> node position
    node_of: ChunkSeq[u32],
    // adjacency: per node a linked list of edges in insertion order, from
    // `first_edge` to `last_edge`; edge `e` goes to node `edge_to[e]` and is
    // followed by `edge_next[e]`
    first_edge: ChunkSeq[u32],
    last_edge: ChunkSeq[u32],
    edge_to: ChunkSeq[u32],
    edge_next: ChunkSeq[u32],
    // the (caller, callee) pairs already added
    edges: MapU,
    // 1 for a node with an edge to itself
    self_edge: ChunkSeq[u8],
}

fn graph_new(functions: u64) -> Graph {
    Graph {
        nodes: ChunkSeq::new[u32](),
        node_of: fill32(functions, NONE32),
        first_edge: ChunkSeq::new[u32](),
        last_edge: ChunkSeq::new[u32](),
        edge_to: ChunkSeq::new[u32](),
        edge_next: ChunkSeq::new[u32](),
        edges: map_new(1024),
        self_edge: ChunkSeq::new[u8]()
    }
}

impl Graph {
    // The node of function `f`, added if it is new.
    fn node(inout self, f: u32) -> u32 {
        let existing = u32_at(in self.node_of, w(f));
        if existing != NONE32 {
            return existing;
        }
        let position = n32(self.nodes.len());
        self.nodes.push(f);
        set_u32(inout self.node_of, w(f), position);
        self.first_edge.push(NONE32);
        self.last_edge.push(NONE32);
        self.self_edge.push(0);
        position
    }

    // Adds the edge from function `caller` to function `callee` unless it is there.
    fn edge(inout self, caller: u32, callee: u32) {
        let from = self.node(caller);
        let key = pair(caller, callee);
        if self.edges.get(key) != NONE32 {
            return;
        }
        self.edges.set(key, 1);
        let to = self.node(callee);
        let edge_id = n32(self.edge_to.len());
        self.edge_to.push(to);
        self.edge_next.push(NONE32);
        let last = u32_at(in self.last_edge, w(from));
        if last == NONE32 {
            set_u32(inout self.first_edge, w(from), edge_id);
        } else {
            set_u32(inout self.edge_next, w(last), edge_id);
        }
        set_u32(inout self.last_edge, w(from), edge_id);
        if caller == callee {
            set_u8(inout self.self_edge, w(from), 1);
        }
    }
}

// petgraph's `TarjanScc` (Pearce's variant), components callees first.
pub struct Tarjan {
    index: u64,
    // the next component number, counting down from MAX64
    count: u64,
    // per node: 0 unvisited, its visit index while open, then its component
    root: ChunkSeq[u64],
    stack: ChunkSeq[u32],
    // components: members comp_nodes[comp_start[c]..comp_start[c+1]]
    comp_start: ChunkSeq[u32],
    comp_nodes: ChunkSeq[u32],
}

impl Tarjan {
    fn root_of(in self, node: u32) -> u64 {
        u64_at(in self.root, w(node))
    }

    fn set_root(inout self, node: u32, root: u64) {
        set_u64(inout self.root, w(node), root);
    }

    fn components(in self) -> u64 {
        sub(self.comp_start.len(), 1)
    }

    // Closes the component rooted at `node`: it and the stacked nodes above its
    // root index, which are popped.
    fn close_component(inout self, node: u32) {
        let mut popped: u64 = 1;
        let component = self.count;
        let v_root = self.root_of(node);
        let mut start: u64 = 0;
        let mut depth = self.stack.len();
        loop {
            if depth == 0 {
                break;
            }
            let stacked = u32_at(in self.stack, sub(depth, 1));
            if v_root > self.root_of(stacked) {
                start = depth;
                break;
            }
            self.set_root(stacked, component);
            popped = inc(popped);
            depth = sub(depth, 1);
        }
        self.set_root(node, component);
        self.stack.push(node);
        self.comp_start.push(n32(self.comp_nodes.len()));
        for j in start..self.stack.len() {
            self.comp_nodes.push(u32_at(in self.stack, j));
        }
        self.stack.truncate(start);
        self.index = sub(self.index, popped);
        self.count = sub(self.count, 1);
    }
}

fn visit(in graph: Graph, inout scc: Tarjan, node: u32) {
    let mut local_root = true;
    scc.set_root(node, scc.index);
    scc.index = inc(scc.index);
    let mut edge = u32_at(in graph.first_edge, w(node));
    loop {
        if edge == NONE32 {
            break;
        }
        let succ = u32_at(in graph.edge_to, w(edge));
        if scc.root_of(succ) == 0 {
            visit(in graph, inout scc, succ);
        }
        if scc.root_of(succ) < scc.root_of(node) {
            scc.set_root(node, scc.root_of(succ));
            local_root = false;
        }
        edge = u32_at(in graph.edge_next, w(edge));
    }
    if local_root {
        scc.close_component(node);
    } else {
        scc.stack.push(node);
    }
}

fn tarjan(in graph: Graph) -> Tarjan {
    let mut scc = Tarjan {
        index: 1,
        count: MAX64,
        root: zeros64(graph.nodes.len()),
        stack: ChunkSeq::new[u32](),
        comp_start: ChunkSeq::new[u32](),
        comp_nodes: ChunkSeq::new[u32](),
    };
    for node in 0..graph.nodes.len() {
        if u64_at(in scc.root, node) == 0 {
            visit(in graph, inout scc, n32(node));
        }
    }
    scc.comp_start.push(n32(scc.comp_nodes.len()));
    scc
}

// ----- call sites ---------------------------------------------------------------------

// How each callee parameter is supplied (`Binding`): bound by value to a
// fresh local, or replaced by the caller's place (an operand-pool offset:
// root, path length, path).
pub struct Bindings {
    place: ChunkSeq[u8],
    value: ChunkSeq[u32],
    at: ChunkSeq[u64],
}

fn bindings_new() -> Bindings {
    Bindings { place: ChunkSeq::new[u8](), value: ChunkSeq::new[u32](), at: ChunkSeq::new[u64]() }
}

impl Bindings {
    fn push(inout self, place: bool, value: u32, at: u64) {
        self.place.push(if place { 1 } else { 0 });
        self.value.push(value);
        self.at.push(at);
    }

    fn is_place(in self, k: u64) -> bool {
        u8_at(in self.place, k) != 0
    }
}

// `row_within`: callee `fi` with row `row` may be inlined into a caller
// with row `caller`. Its row is empty or the caller's, or every instance of
// its row (unlabeled `Fail` only) is in the caller's row and the callee
// raises only by error type: no loop, no handler and no effect operation
// (a call of anything that is not a program function), since `Fail::raise`
// performs the innermost `Fail` in scope (#1502).
fn row_within(in p: Prog, fi: u32, row: u32, caller: u32) -> bool {
    if p.row_count(row) == 0 || row == caller {
        return true;
    }
    if !fail_row_only(in p, row) || raises_untyped(in p, fi) {
        return false;
    }
    let row_at = w(u32_at(in p.row_a, w(row)));
    let caller_at = w(u32_at(in p.row_a, w(caller)));
    let caller_count = u64_at(in p.row_words, caller_at);
    for i in 0..p.row_count(row) {
        let key = u64_at(in p.row_words, add(inc(row_at), add(wrapping_mul(i, ROW_STRIDE), 3)));
        let mut found = false;
        for j in 0..caller_count {
            if u64_at(in p.row_words, add(inc(caller_at), add(wrapping_mul(j, ROW_STRIDE), 3)))
                == key {
                found = true;
            }
        }
        if !found {
            return false;
        }
    }
    true
}

// Whether function `fi`'s body has a loop header, a handler or an effect
// operation.
fn raises_untyped(in p: Prog, fi: u32) -> bool {
    let f = p.fun(fi);
    for b in 0..w(f.fc) {
        let bk = p.block(f, b);
        for k in 0..w(bk.ic) {
            let inst = p.inst_of(bk, k);
            if inst.op == O_LOOP || inst.op == O_HANDLE {
                return true;
            }
            if inst.op == O_CALL && p.fun_index(n32(p.op(w(inst.a)))) == NONE32 {
                return true;
            }
        }
    }
    false
}

// `site_bindings`: the bindings for a call, or why it stays a call.
fn site_bindings(
    in p: Prog,
    caller_index: u32,
    g: Tgt,
    dest: u32,
    args: u64,
    inout out: Bindings
) -> u32 {
    let caller = p.fun(caller_index);
    let f = p.fun(g.f);
    let arg_count = p.op(args);
    if arg_count != w(f.pn) || p.value_ty(caller, w(dest)) != p.map(g.inst, f.result) {
        return R_SITE_SIGNATURE;
    }
    let row = p.row_of(g);
    if !row_within(in p, g.f, row, caller.row) {
        return R_SITE_ROW;
    }
    if caller.bn != 0 {
        let mut generics: ChunkSeq[u32] = ChunkSeq::new[u32]();
        for k in 0..w(caller.bn) {
            generics.push(p.id(add(w(caller.ba), k)));
        }
        for v in 0..w(f.vn) {
            let callee_ty = p.value_ty(f, v);
            if callee_ty != NONE32 && mentions_names(in p, p.map(g.inst, callee_ty), in generics) {
                return R_SITE_GENERICS;
            }
        }
        for k in 0..w(f.ln) {
            let callee_ty = u32_at(in p.loc_ty, add(w(f.la), k));
            if mentions_names(in p, p.map(g.inst, callee_ty), in generics) {
                return R_SITE_GENERICS;
            }
        }
    }
    let mut at = inc(args);
    for k in 0..arg_count {
        let value = n32(p.op(at));
        let has = p.op(add(at, 2)) != 0;
        let place = add(at, 3);
        let local = has && p.local_ty(caller, n32(p.op(place))) != NONE32;
        let param = p.param(f, k);
        let ty = p.map(g.inst, param.ty);
        let aggregate = p.has(ty, F_AGGREGATE);
        let sequence = p.has(ty, F_SEQUENCE);
        if p.has(ty, F_SLICE) {
            let same = local && p.op(inc(place)) == 0 && p.local_ty(caller, n32(p.op(place))) == ty;
            out.push(same, value, place);
        } else if param.pass == TyPass::Inout {
            if !local {
                return R_SITE_INOUT;
            }
            out.push(true, value, place);
        } else if param.pass == TyPass::In && (aggregate || sequence) {
            if local {
                out.push(true, value, place);
            } else if !sequence {
                out.push(false, value, place);
            } else {
                return R_SITE_SEQUENCE;
            }
        } else {
            out.push(false, value, place);
        }
        at = arg_end(in p, at);
    }
    if own_handles(in p, g.f) > 0 {
        for k in 0..arg_count {
            if out.is_place(k) && p.op(inc(u64_at(in out.at, k))) != 0 {
                return R_SITE_FIELD;
            }
        }
    }
    // A borrowed parameter is replaced by the caller's place, so the callee
    // must never re-bind its name.
    let mut replaced: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for k in 0..arg_count {
        if out.is_place(k) {
            replaced.push(p.param(f, k).name);
        }
    }
    if replaced.len() > 0 {
        let mut bound: ChunkSeq[u32] = ChunkSeq::new[u32]();
        for b in 0..w(f.fc) {
            let bk = p.block(f, b);
            for k in 0..w(bk.ic) {
                let inst = p.inst_of(bk, k);
                if inst.op == O_BIND {
                    pattern_binds(in p, p.op(inc(w(inst.a))), inout bound);
                }
            }
            if bk.term == T_MATCH {
                let ta = w(bk.ta);
                let arms = p.op(inc(ta));
                for j in 0..arms {
                    pattern_binds(in p, p.op(add(add(ta, 2), wrapping_mul(j, 2))), inout bound);
                }
            }
        }
        for j in 0..bound.len() {
            let bound_name = u32_at(in bound, j);
            for k in 0..replaced.len() {
                if u32_at(in replaced, k) == bound_name {
                    return R_SITE_REBIND;
                }
            }
        }
    }
    R_OK
}

// `partial_ok`: every by-value argument can be passed twice.
fn partial_ok(in p: Prog, g: Tgt, in bs: Bindings) -> bool {
    let f = p.fun(g.f);
    for k in 0..w(f.pn) {
        if bs.is_place(k) {
            continue;
        }
        let ty = p.map(g.inst, p.param(f, k).ty);
        if !p.has(ty, F_SLICE) && !p.has(ty, F_PLAIN) {
            return false;
        }
    }
    true
}

// ----- site folding (site.rs `fold`) ------------------------------------------------

// A value the site's arguments determine: 0 unknown, 1 an integer (lo, hi
// as an i128), 2 a bool (lo), 3 a nullary constructor (lo: its short name).
pub copy struct Kn {
    k: u8,
    lo: u64,
    hi: u64,
}

fn unknown() -> Kn {
    Kn { k: 0, lo: 0, hi: 0 }
}

fn kn_at(in seq: ChunkSeq[Kn], i: u64) -> Kn {
    match seq.try_get(i) {
        Option::Some(known) => known,
        Option::None => unknown(),
    }
}

fn kn_eq(a: Kn, b: Kn) -> bool {
    a.k == b.k && a.lo == b.lo && a.hi == b.hi
}

fn set_kn(inout seq: ChunkSeq[Kn], i: u64, known: Kn) {
    let ok = seq.try_set(i, known);
}

// `site::constant`.
fn constant(inout p: Prog, g: Tgt, inst: Inst) -> Kn {
    let ops_at = w(inst.a);
    if inst.op == O_CONST {
        let kind = p.op(ops_at);
        if kind == L_INT {
            return Kn { k: 1, lo: p.op(inc(ops_at)), hi: p.op(add(ops_at, 2)) };
        }
        if kind == L_BOOL {
            return Kn { k: 2, lo: p.op(inc(ops_at)), hi: 0 };
        }
        return unknown();
    }
    if inst.op == O_DATA && p.op(inc(ops_at)) == 0 && p.has(p.map(g.inst, inst.ty), F_PLAIN) {
        let short_name = short(inout p, n32(p.op(ops_at)));
        return Kn { k: 3, lo: w(short_name), hi: 0 };
    }
    unknown()
}

// Signed 128-bit comparison: -1, 0 or 1.
fn cmp128(lhs: Kn, rhs: Kn) -> i64 {
    let lhs_high = lhs.hi ^ 9223372036854775808;
    let rhs_high = rhs.hi ^ 9223372036854775808;
    if lhs_high < rhs_high {
        return -1;
    }
    if lhs_high > rhs_high {
        return 1;
    }
    if lhs.lo < rhs.lo {
        return -1;
    }
    if lhs.lo > rhs.lo {
        return 1;
    }
    0
}

// `site::binary`: comparison codes 1 `==`, 2 `!=`, 3 `<`, 4 `<=`, 5 `>`,
// 6 `>=`.
fn binary(code: u64, lhs: Kn, rhs: Kn) -> Kn {
    let equality = code == 1 || code == 2;
    let mut order: i64 = 0;
    if lhs.k == 1 && rhs.k == 1 {
        order = cmp128(lhs, rhs);
    } else if lhs.k == 2 && rhs.k == 2 && equality {
        if lhs.lo < rhs.lo {
            order = -1;
        } else if lhs.lo > rhs.lo {
            order = 1;
        }
    } else if lhs.k == 3 && rhs.k == 3 && equality {
        if lhs.lo != rhs.lo {
            order = -1;
        }
    } else {
        return unknown();
    }
    let holds = if code == 1 {
        order == 0
    } else if code == 2 {
        order != 0
    } else if code == 3 {
        order < 0
    } else if code == 4 {
        order <= 0
    } else if code == 5 {
        order > 0
    } else if code == 6 {
        order >= 0
    } else {
        return unknown();
    };
    Kn { k: 2, lo: if holds { 1 } else { 0 }, hi: 0 }
}

// `site::arm`: the arm a known value takes, NONE32 when undecided.
fn arm(inout p: Prog, ta: u64, known: Kn) -> u32 {
    let arm_count = p.op(inc(ta));
    for j in 0..arm_count {
        let at = p.op(add(add(ta, 2), wrapping_mul(j, 2)));
        let kind = p.pat(at);
        let mut hit = false;
        if kind == PK_WILD || kind == PK_BIND {
            hit = true;
        } else if kind == PK_CTOR && known.k == 3 {
            hit = w(short(inout p, n32(p.pat(add(at, 3))))) == known.lo;
        } else if kind == PK_LIT && p.pat(add(at, 3)) == L_INT && known.k == 1 {
            hit = p.pat(add(at, 4)) == known.lo && p.pat(add(at, 5)) == known.hi;
        } else if kind == PK_LIT && p.pat(add(at, 3)) == L_BOOL && known.k == 2 {
            hit = p.pat(add(at, 4)) == known.lo;
        } else {
            return NONE32;
        }
        if hit {
            return n32(j);
        }
    }
    NONE32
}

// An association list from names to known values (locals of one fold).
pub struct Assoc {
    keys: ChunkSeq[u32],
    vals: ChunkSeq[Kn],
}

fn assoc_new() -> Assoc {
    Assoc { keys: ChunkSeq::new[u32](), vals: ChunkSeq::new[Kn]() }
}

impl Assoc {
    fn find(in self, key: u32) -> u64 {
        for i in 0..self.keys.len() {
            if u32_at(in self.keys, i) == key {
                return i;
            }
        }
        MAX64
    }

    fn get(in self, key: u32) -> Kn {
        let slot = self.find(key);
        if slot == MAX64 {
            return unknown();
        }
        kn_at(in self.vals, slot)
    }

    fn set(inout self, key: u32, value: Kn) {
        let slot = self.find(key);
        if slot == MAX64 {
            self.keys.push(key);
            self.vals.push(value);
        } else {
            let ok = self.vals.try_set(slot, value);
        }
    }
}

// `stable_locals`: names bound once (or a parameter never re-bound), never
// written or lent `inout`; empty when the callee has a handle or closure.
fn stable_locals(in p: Prog, f: Fun, inout out: ChunkSeq[u32]) {
    let mut names = map_new(64);
    let mut list: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut counts: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut unstable = map_new(16);
    let mut bound: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for k in 0..w(f.pn) {
        bound.push(p.param(f, k).name);
    }
    for b in 0..w(f.fc) {
        let bk = p.block(f, b);
        for k in 0..w(bk.ic) {
            let inst = p.inst_of(bk, k);
            let ops_at = w(inst.a);
            if inst.op == O_BIND {
                pattern_binds(in p, p.op(inc(ops_at)), inout bound);
            } else if inst.op == O_WRITE {
                unstable.set(p.op(inc(ops_at)), 1);
            } else if has_args(inst.op) {
                let start = args_at(inst.op, ops_at);
                let arg_count = p.op(start);
                let mut at = inc(start);
                for j in 0..arg_count {
                    if p.op(inc(at)) == TyPass::Inout && p.op(add(at, 2)) != 0 {
                        unstable.set(p.op(add(at, 3)), 1);
                    }
                    at = arg_end(in p, at);
                }
            } else if inst.op == O_HANDLE || inst.op == O_CLOSURE {
                out.clear();
                return;
            }
        }
        if bk.term == T_MATCH {
            let ta = w(bk.ta);
            let arms = p.op(inc(ta));
            for j in 0..arms {
                pattern_binds(in p, p.op(add(add(ta, 2), wrapping_mul(j, 2))), inout bound);
            }
        }
    }
    // Rust counts binds per name in a BTreeMap (parameters once each).
    for j in 0..bound.len() {
        let name = u32_at(in bound, j);
        let slot = names.get(w(name));
        if slot == NONE32 {
            names.set(w(name), n32(list.len()));
            list.push(name);
            counts.push(1);
        } else {
            set_u32(inout counts, w(slot), inc32(u32_at(in counts, w(slot))));
        }
    }
    out.clear();
    for j in 0..list.len() {
        let name = u32_at(in list, j);
        if u32_at(in counts, j) == 1 && unstable.get(w(name)) == NONE32 {
            out.push(name);
        }
    }
}

// One past the largest value id `f` defines or types (`splice`'s
// `next_value` / `callee_values`).
fn value_bound(in p: Prog, f: Fun) -> u64 {
    let mut top: u64 = 0;
    let mut any = false;
    for v in 0..w(f.vn) {
        if u32_at(in p.val, add(w(f.va), v)) != 0 {
            top = v;
            any = true;
        }
    }
    for b in 0..w(f.fc) {
        let bk = p.block(f, b);
        for k in 0..w(bk.ic) {
            let defined = w(p.inst_of(bk, k).dest);
            if !any || defined > top {
                top = defined;
                any = true;
            }
        }
        for k in 0..w(bk.pn) {
            let defined = w(p.id(add(w(bk.pa), k)));
            if !any || defined > top {
                top = defined;
                any = true;
            }
        }
    }
    if any { inc(top) } else { 0 }
}

// The seeds of a fold: the caller's constants passed by value to stable
// locals, by parameter name (`seeds`, filtered by `stable_locals`).
fn fold_seeds(
    inout p: Prog,
    caller_index: u32,
    g: Tgt,
    in bs: Bindings,
    in stable: ChunkSeq[u32]
) -> Assoc {
    let caller = p.fun(caller_index);
    let f = p.fun(g.f);
    let mut kept = assoc_new();
    // defs of the wanted values, last definition wins
    let mut defs = map_new(16);
    for k in 0..w(f.pn) {
        if !bs.is_place(k) {
            defs.set(w(u32_at(in bs.value, k)), NONE32);
        }
    }
    for b in 0..w(caller.fc) {
        let bk = p.block(caller, b);
        for k in 0..w(bk.ic) {
            let id = p.id(add(w(bk.ia), k));
            let dest = w(p.inst(id).dest);
            if defs_has(in defs, dest) {
                defs.set(dest, id);
            }
        }
    }
    let caller_tgt = Tgt { f: caller_index, inst: NONE32 };
    let mut seeds = assoc_new();
    for k in 0..w(f.pn) {
        if bs.is_place(k) {
            continue;
        }
        let id = defs.get(w(u32_at(in bs.value, k)));
        if id == NONE32 {
            continue;
        }
        let known = constant(inout p, caller_tgt, p.inst(id));
        if known.k != 0 {
            seeds.set(p.param(f, k).name, known);
        }
    }
    for j in 0..seeds.keys.len() {
        let name = u32_at(in seeds.keys, j);
        if contains32(in stable, name) {
            kept.set(name, kn_at(in seeds.vals, j));
        }
    }
    kept
}

fn contains32(in seq: ChunkSeq[u32], value: u32) -> bool {
    for k in 0..seq.len() {
        if u32_at(in seq, k) == value {
            return true;
        }
    }
    false
}

// One round of a fold: live blocks, decided terminators, known values and
// the jump arguments reaching each block.
pub struct Round {
    locals: Assoc,
    values: ChunkSeq[Kn],
    live: ChunkSeq[u8],
    jumps: ChunkSeq[u32],
    njumps: u64,
    in_head: ChunkSeq[u32],
    in_tail: ChunkSeq[u32],
    in_at: ChunkSeq[u64],
    in_next: ChunkSeq[u32],
}

// The value an instruction folds to, given the round so far.
fn eval_inst(inout p: Prog, g: Tgt, inst: Inst, inout st: Round, in stable: ChunkSeq[u32]) -> Kn {
    let ops_at = w(inst.a);
    if inst.op == O_CONST || inst.op == O_DATA {
        return constant(inout p, g, inst);
    }
    if inst.op == O_READ {
        if p.op(inc(ops_at)) == 0 {
            return st.locals.get(n32(p.op(ops_at)));
        }
        return unknown();
    }
    if inst.op == O_UNARY {
        if p.op(ops_at) == 1 {
            let known = kn_at(in st.values, p.op(inc(ops_at)));
            if known.k == 2 {
                return Kn { k: 2, lo: 1 ^ known.lo, hi: 0 };
            }
        }
        return unknown();
    }
    if inst.op == O_BINARY {
        if (inst.flags & I_FALLIBLE) == 0 {
            let lhs = kn_at(in st.values, p.op(inc(ops_at)));
            let rhs = kn_at(in st.values, p.op(add(ops_at, 2)));
            if lhs.k != 0 && rhs.k != 0 {
                return binary(p.op(ops_at), lhs, rhs);
            }
        }
        return unknown();
    }
    if inst.op == O_BIND {
        let at = p.op(inc(ops_at));
        if p.pat(at) == PK_BIND {
            let name = n32(p.pat(add(at, 3)));
            let known = kn_at(in st.values, p.op(ops_at));
            if known.k != 0 && contains32(in stable, name) {
                st.locals.set(name, known);
            }
        }
    }
    unknown()
}

fn decide(inout st: Round, b: u64, target: u32, inout succ: ChunkSeq[u32]) {
    set_u32(inout st.jumps, b, target);
    st.njumps = inc(st.njumps);
    succ.push(target);
}

// The successors a block's terminator leads to in this round.
fn eval_terminator(inout p: Prog, bk: Blk, b: u64, inout st: Round, inout succ: ChunkSeq[u32]) {
    let ta = w(bk.ta);
    if bk.term == T_BRANCH {
        let known = kn_at(in st.values, p.op(ta));
        let yes = n32(p.op(inc(ta)));
        let no = n32(p.op(add(ta, 2)));
        if known.k == 2 && known.lo == 1 {
            decide(inout st, b, yes, inout succ);
        } else if known.k == 2 {
            decide(inout st, b, no, inout succ);
        } else {
            succ.push(yes);
            succ.push(no);
        }
    } else if bk.term == T_MATCH {
        let known = kn_at(in st.values, p.op(ta));
        let mut taken = NONE32;
        if known.k != 0 {
            taken = arm(inout p, ta, known);
            if taken != NONE32
                && pattern_binds_any(in p, p.op(add(add(ta, 2), wrapping_mul(w(taken), 2)))) {
                taken = NONE32;
            }
        }
        if taken != NONE32 {
            let target = n32(p.op(add(add(ta, 3), wrapping_mul(w(taken), 2))));
            decide(inout st, b, target, inout succ);
        } else {
            successors(in p, bk, inout succ);
        }
    } else if bk.term == T_JUMP {
        let target = p.op(ta);
        let edge = n32(st.in_at.len());
        st.in_at.push(inc(ta));
        st.in_next.push(NONE32);
        let tail = u32_at(in st.in_tail, target);
        if tail == NONE32 {
            set_u32(inout st.in_head, target, edge);
        } else {
            set_u32(inout st.in_next, w(tail), edge);
        }
        set_u32(inout st.in_tail, target, edge);
        succ.push(n32(target));
    }
}

// Visits the live blocks once each, in discovery order.
fn fold_round(
    inout p: Prog,
    g: Tgt,
    in kept: Assoc,
    in stable: ChunkSeq[u32],
    in params: ChunkSeq[Kn]
) -> Round {
    let nblocks = w(p.fun(g.f).fc);
    let mut st = Round {
        locals: assoc_new(),
        values: ChunkSeq::new[Kn](),
        live: zeros8(nblocks),
        jumps: fill32(nblocks, NONE32),
        njumps: 0,
        in_head: fill32(nblocks, NONE32),
        in_tail: fill32(nblocks, NONE32),
        in_at: ChunkSeq::new[u64](),
        in_next: ChunkSeq::new[u32]()
    };
    for j in 0..kept.keys.len() {
        st.locals.set(u32_at(in kept.keys, j), kn_at(in kept.vals, j));
    }
    st.values.extend(in params.as_slice());
    set_u8(inout st.live, 0, 1);
    let mut work: ChunkSeq[u32] = ChunkSeq::new[u32]();
    work.push(0);
    let mut seen = zeros8(nblocks);
    let mut succ: ChunkSeq[u32] = ChunkSeq::new[u32]();
    loop {
        let pending = work.len();
        if pending == 0 {
            break;
        }
        let b = w(u32_at(in work, sub(pending, 1)));
        work.truncate(sub(pending, 1));
        if u8_at(in seen, b) != 0 {
            continue;
        }
        set_u8(inout seen, b, 1);
        let bk = p.block(p.fun(g.f), b);
        let mut ends = false;
        for k in 0..w(bk.ic) {
            let inst = p.inst_of(bk, k);
            if inst.op == O_EXIT {
                ends = true;
            }
        }
        for k in 0..w(bk.ic) {
            let inst = p.inst_of(bk, k);
            let known = eval_inst(inout p, g, inst, inout st, in stable);
            if known.k != 0 {
                set_kn(inout st.values, w(inst.dest), known);
            }
            if inst.op == O_EXIT {
                break;
            }
        }
        succ.clear();
        if !ends {
            eval_terminator(inout p, bk, b, inout st, inout succ);
        }
        for j in 0..succ.len() {
            let target = u32_at(in succ, j);
            set_u8(inout st.live, w(target), 1);
            work.push(target);
        }
    }
    st
}

// Block parameters: known when every live predecessor passes the same known
// value.
fn round_params(in p: Prog, f: Fun, in st: Round, nvalues: u64) -> ChunkSeq[Kn] {
    let mut next: ChunkSeq[Kn] = ChunkSeq::new[Kn]();
    next.resize(nvalues, unknown());
    for b in 0..w(f.fc) {
        let bk = p.block(f, b);
        if u8_at(in st.live, b) == 0 || bk.pn == 0 {
            continue;
        }
        let head = u32_at(in st.in_head, b);
        if head == NONE32 {
            continue;
        }
        for index in 0..w(bk.pn) {
            let mut agreed = unknown();
            let mut good = true;
            let mut edge = head;
            loop {
                if edge == NONE32 {
                    break;
                }
                let at = u64_at(in st.in_at, w(edge));
                let mut passed = unknown();
                if index < p.op(at) {
                    passed = kn_at(in st.values, p.op(add(inc(at), index)));
                }
                if passed.k != 0 && (agreed.k == 0 || kn_eq(agreed, passed)) {
                    agreed = passed;
                } else {
                    good = false;
                }
                edge = u32_at(in st.in_next, w(edge));
            }
            if good && agreed.k != 0 {
                set_kn(inout next, w(p.id(add(w(bk.pa), index))), agreed);
            }
        }
    }
    next
}

fn same_kns(in a: ChunkSeq[Kn], in b: ChunkSeq[Kn], n: u64) -> bool {
    for v in 0..n {
        if !kn_eq(kn_at(in a, v), kn_at(in b, v)) {
            return false;
        }
    }
    true
}

fn same_round(in a: Round, in b: Round, nblocks: u64, nvalues: u64) -> bool {
    for k in 0..nblocks {
        if u8_at(in a.live, k) != u8_at(in b.live, k)
            || u32_at(in a.jumps, k) != u32_at(in b.jumps, k) {
            return false;
        }
    }
    same_kns(in a.values, in b.values, nvalues)
}

// `site::fold`. `ok` is false when there is nothing to fold or the
// propagation did not settle (the result is then `folded_none`).
fn fold(inout p: Prog, caller_index: u32, g: Tgt, in bs: Bindings, inout ok: bool) -> Folded {
    ok = false;
    let f = p.fun(g.f);
    let nblocks = w(f.fc);
    let mut wanted = false;
    for k in 0..w(f.pn) {
        if !bs.is_place(k) {
            wanted = true;
        }
    }
    if !wanted {
        return folded_none(nblocks);
    }
    let mut stable: ChunkSeq[u32] = ChunkSeq::new[u32]();
    stable_locals(in p, f, inout stable);
    let kept = fold_seeds(inout p, caller_index, g, in bs, in stable);
    if kept.keys.len() == 0 {
        return folded_none(nblocks);
    }
    let nvalues = value_bound(in p, f);
    let mut params: ChunkSeq[Kn] = ChunkSeq::new[Kn]();
    params.resize(nvalues, unknown());
    let mut prev = fold_round(inout p, g, in kept, in stable, in params);
    params = round_params(in p, f, in prev, nvalues);
    for round in 1..FOLD_ROUNDS {
        let st = fold_round(inout p, g, in kept, in stable, in params);
        let next = round_params(in p, f, in st, nvalues);
        if same_round(in st, in prev, nblocks, nvalues) && same_kns(in next, in params, nvalues) {
            let mut known = zeros8(nvalues);
            for v in 0..nvalues {
                if kn_at(in st.values, v).k != 0 {
                    set_u8(inout known, v, 1);
                }
            }
            ok = true;
            return Folded { live: st.live, jumps: st.jumps, known: known, njumps: st.njumps };
        }
        prev = st;
        params = next;
    }
    folded_none(nblocks)
}

fn defs_has(in map: MapU, key: u64) -> bool {
    let mut at = hash64(key) & map.mask;
    loop {
        if u8_at(in map.used, at) == 0 {
            return false;
        }
        if u64_at(in map.keys, at) == key {
            return true;
        }
        at = inc(at) & map.mask;
    }
}

// ----- partial inlining (site.rs `split`) ------------------------------------------

pub struct Split {
    found: bool,
    block: u32,
    cold: u32,
    hot: ChunkSeq[u8],
    hot_cost: u64,
    cold_cost: u64,
}

fn no_split() -> Split {
    Split { found: false, block: 0, cold: 0, hot: ChunkSeq::new[u8](), hot_cost: 0, cold_cost: 0 }
}

// `site::pure`: an instruction a head may run twice.
fn pure(in p: Prog, g: Tgt, f: Fun, inst: Inst) -> bool {
    if (inst.flags & I_FALLIBLE) != 0 {
        return false;
    }
    if inst.op == O_CONST || inst.op == O_UNIT {
        return true;
    }
    if inst.op == O_READ
        || inst.op == O_BINARY
        || inst.op == O_UNARY
        || inst.op == O_PROJECT
        || inst.op == O_DATA
        || inst.op == O_TUPLE {
        return p.has(p.map(g.inst, inst.ty), F_PLAIN);
    }
    if inst.op == O_BIND {
        let ty = p.value_ty(f, p.op(w(inst.a)));
        return ty != NONE32 && p.has(p.map(g.inst, ty), F_PLAIN);
    }
    false
}

// `site::reach`: blocks reachable from `from` under `fd`, without the edge
// cut_b -> cut_s (cut_b NONE32: no cut).
fn reach(in p: Prog, f: Fun, in fd: Folded, from: u32, cut_b: u32, cut_s: u32) -> ChunkSeq[u8] {
    let n = w(f.fc);
    let mut seen = zeros8(n);
    let mut work: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut succ: ChunkSeq[u32] = ChunkSeq::new[u32]();
    work.push(from);
    loop {
        let pending = work.len();
        if pending == 0 {
            break;
        }
        let block = u32_at(in work, sub(pending, 1));
        work.truncate(sub(pending, 1));
        if u8_at(in seen, w(block)) != 0 || u8_at(in fd.live, w(block)) == 0 {
            continue;
        }
        set_u8(inout seen, w(block), 1);
        folded_successors(in p, f, in fd, w(block), inout succ);
        for k in 0..succ.len() {
            let next = u32_at(in succ, k);
            if !(cut_b == block && cut_s == next) {
                work.push(next);
            }
        }
    }
    seen
}

fn heavy(in p: Prog, f: Fun, in blocks: ChunkSeq[u8]) -> bool {
    for b in 0..w(f.fc) {
        if u8_at(in blocks, b) == 0 {
            continue;
        }
        let bk = p.block(f, b);
        for k in 0..w(bk.ic) {
            let op = p.inst_of(bk, k).op;
            if op == O_LOOP || op == O_CALL || op == O_SEQ {
                return true;
            }
        }
    }
    false
}

// Marks each block of `f` whose instructions are all `pure`.
fn pure_blocks(in p: Prog, g: Tgt, f: Fun) -> ChunkSeq[u8] {
    let n = w(f.fc);
    let mut pure_block = zeros8(n);
    for b in 0..n {
        let bk = p.block(f, b);
        let mut all = true;
        for k in 0..w(bk.ic) {
            if !pure(in p, g, f, p.inst_of(bk, k)) {
                all = false;
                break;
            }
        }
        if all {
            set_u8(inout pure_block, b, 1);
        }
    }
    pure_block
}

// Marks the pure head of `f`: the live entry block when it is pure, then
// every live, pure block whose predecessors are all in the head.
fn pure_head(in p: Prog, f: Fun, in fd: Folded, in pure_block: ChunkSeq[u8]) -> ChunkSeq[u8] {
    let n = w(f.fc);
    // Each folded edge, as parallel `pred_from -> pred_to` lists.
    let mut pred_from: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut pred_to: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut succ: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for b in 0..n {
        if u8_at(in fd.live, b) == 0 {
            continue;
        }
        folded_successors(in p, f, in fd, b, inout succ);
        for k in 0..succ.len() {
            pred_from.push(n32(b));
            pred_to.push(u32_at(in succ, k));
        }
    }
    let mut head = zeros8(n);
    if u8_at(in pure_block, 0) != 0 && u8_at(in fd.live, 0) != 0 {
        set_u8(inout head, 0, 1);
    }
    let mut changed = true;
    loop {
        if !changed {
            break;
        }
        changed = false;
        for b in 1..n {
            if u8_at(in head, b) != 0 || u8_at(in fd.live, b) == 0 || u8_at(in pure_block, b) == 0 {
                continue;
            }
            let mut any = false;
            let mut all = true;
            for edge in 0..pred_to.len() {
                if w(u32_at(in pred_to, edge)) == b {
                    any = true;
                    if u8_at(in head, w(u32_at(in pred_from, edge))) == 0 {
                        all = false;
                    }
                }
            }
            if any && all {
                set_u8(inout head, b, 1);
                changed = true;
            }
        }
    }
    head
}

// Inserts `target` into the ascending `targets`, unless it is already there.
fn insert_target(inout targets: ChunkSeq[u32], target: u32) {
    let mut at: u64 = 0;
    loop {
        if at >= targets.len() {
            break;
        }
        let existing = u32_at(in targets, at);
        if existing == target {
            return;
        }
        if existing > target {
            break;
        }
        at = inc(at);
    }
    targets.push(target);
    let mut k = sub(targets.len(), 1);
    loop {
        if k <= at {
            break;
        }
        set_u32(inout targets, k, u32_at(in targets, sub(k, 1)));
        k = sub(k, 1);
    }
    set_u32(inout targets, at, target);
}

// Fills `targets` with the distinct successors of `bk`'s branch or match,
// and says whether `bk` can be split there: a branch needs two different
// targets, and a match one target per arm.
fn split_targets(in p: Prog, bk: Blk, inout targets: ChunkSeq[u32]) -> bool {
    let ta = w(bk.ta);
    targets.clear();
    if bk.term == T_BRANCH {
        let yes = n32(p.op(inc(ta)));
        let no = n32(p.op(add(ta, 2)));
        targets.push(yes);
        targets.push(no);
        yes != no
    } else if bk.term == T_MATCH {
        let arms = p.op(inc(ta));
        for j in 0..arms {
            insert_target(inout targets, n32(p.op(add(add(ta, 3), wrapping_mul(j, 2)))));
        }
        targets.len() == arms
    } else {
        false
    }
}

// `site::split`: the best partial inlining whose copy costs at most `budget`.
fn split(in p: Prog, g: Tgt, in fd: Folded, budget: u64) -> Split {
    let f = p.fun(g.f);
    if own_handles(in p, g.f) > 0 {
        return no_split();
    }
    let pure_block = pure_blocks(in p, g, f);
    let head = pure_head(in p, f, in fd, in pure_block);
    let n = w(f.fc);
    let mut best = no_split();
    let mut best_heavy = false;
    let mut targets: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for b in 0..n {
        if u8_at(in head, b) == 0 || fd.jump(b) != NONE32 {
            continue;
        }
        if !split_targets(in p, p.block(f, b), inout targets) {
            continue;
        }
        for k in 0..targets.len() {
            let cold = u32_at(in targets, k);
            if p.block(f, w(cold)).pn != 0 {
                continue;
            }
            let hot = reach(in p, f, in fd, 0, n32(b), cold);
            if u8_at(in hot, w(cold)) != 0 {
                continue;
            }
            let from_cold = reach(in p, f, in fd, cold, NONE32, NONE32);
            let mut cold_blocks = zeros8(n);
            for j in 0..n {
                if u8_at(in from_cold, j) != 0 && u8_at(in hot, j) == 0 {
                    set_u8(inout cold_blocks, j, 1);
                }
            }
            let hot_cost = add(cost_of(in p, g, in fd, in hot), CALL_COST);
            let cold_cost = cost_of(in p, g, in fd, in cold_blocks);
            if hot_cost > budget || cold_cost < MIN_COLD || cold_cost < hot_cost {
                continue;
            }
            let cold_heavier = heavy(in p, f, in cold_blocks) && !heavy(in p, f, in hot);
            let better = !best.found
                || (cold_heavier && !best_heavy)
                || (cold_heavier == best_heavy && hot_cost > best.hot_cost);
            if better {
                best_heavy = cold_heavier;
                best = Split {
                    found: true,
                    block: n32(b),
                    cold: cold,
                    hot: hot,
                    hot_cost: hot_cost,
                    cold_cost: cold_cost
                };
            }
        }
    }
    best
}

// ----- splicing -------------------------------------------------------------------------

// How a callee's names, values and blocks map into the caller (`Rename`).
pub struct Rename {
    values: u64,
    blocks: u64,
    // callee local -> renamed local
    names: MapU,
    // borrowed parameter -> operand offset of the caller's place
    places: MapU,
}

// Writes root and path (root, n, names) of `root`.`path` (the path at
// operand offset `path_at`) renamed (`Rename::root`).
fn put_root(inout p: Prog, in rn: Rename, root: u64, path_at: u64) {
    let place = rn.places.get(root);
    let path_len = p.op(path_at);
    if place != NONE32 {
        let place_at = w(place);
        let place_len = p.op(inc(place_at));
        p.ops.push(p.op(place_at));
        p.ops.push(add(place_len, path_len));
        for k in 0..place_len {
            let segment = p.op(add(add(place_at, 2), k));
            p.ops.push(segment);
        }
    } else {
        let name = rn.names.get(root);
        if name != NONE32 {
            p.ops.push(w(name));
        } else {
            p.ops.push(root);
        }
        p.ops.push(path_len);
    }
    for k in 0..path_len {
        let segment = p.op(add(inc(path_at), k));
        p.ops.push(segment);
    }
}

// The root alone (`self.root(slot, &[]).0`).
fn renamed_root(in p: Prog, in rn: Rename, root: u64) -> u64 {
    let place = rn.places.get(root);
    if place != NONE32 {
        return p.op(w(place));
    }
    let name = rn.names.get(root);
    if name != NONE32 { w(name) } else { root }
}

// A renamed copy of the pattern at `at` (`Rename::pattern`).
fn copy_pattern(inout p: Prog, in rn: Rename, at: u64) -> u64 {
    let kind = p.pat(at);
    let mut body: ChunkSeq[u64] = ChunkSeq::new[u64]();
    if kind == PK_BIND {
        let name = p.pat(add(at, 3));
        let new_name = rn.names.get(name);
        body.push(
            if new_name != NONE32 {
                w(new_name)
            } else {
                name
            }
        );
    } else if kind == PK_TUPLE {
        let n = p.pat(add(at, 3));
        body.push(n);
        for i in 0..n {
            let child = copy_pattern(inout p, in rn, p.pat(add(add(at, 4), i)));
            body.push(child);
        }
    } else if kind == PK_CTOR {
        body.push(p.pat(add(at, 3)));
        body.push(p.pat(add(at, 4)));
        let n = p.pat(add(at, 5));
        body.push(n);
        for i in 0..n {
            body.push(p.pat(add(add(at, 6), wrapping_mul(i, 2))));
            let child = copy_pattern(inout p, in rn, p.pat(add(add(at, 7), wrapping_mul(i, 2))));
            body.push(child);
        }
    } else if kind == PK_LIT {
        for i in 0..4 {
            body.push(p.pat(add(add(at, 3), i)));
        }
    }
    let out = p.pats.len();
    p.pats.push(kind);
    p.pats.push(p.pat(inc(at)));
    p.pats.push(p.pat(add(at, 2)));
    p.pats.extend(in body.as_slice());
    out
}

fn put_args(inout p: Prog, in rn: Rename, start: u64) {
    let n = p.op(start);
    p.ops.push(n);
    let mut at = inc(start);
    for k in 0..n {
        p.ops.push(add(p.op(at), rn.values));
        p.ops.push(p.op(inc(at)));
        let has = p.op(add(at, 2));
        p.ops.push(has);
        if has != 0 {
            put_root(inout p, in rn, p.op(add(at, 3)), add(at, 4));
        }
        at = arg_end(in p, at);
    }
}

// The renamed operands of `inst` (`Rename::op`), as a new operand offset.
fn copy_op(inout p: Prog, in rn: Rename, inst: Inst) -> u32 {
    let ops_at = w(inst.a);
    let op = inst.op;
    if op == O_CONST || op == O_UNIT || op == O_LOOP || op == O_CLOSURE {
        return inst.a;
    }
    let out = n32(p.ops.len());
    let value_base = rn.values;
    if op == O_READ {
        put_root(inout p, in rn, p.op(ops_at), inc(ops_at));
    } else if op == O_BIND {
        p.ops.push(add(p.op(ops_at), value_base));
        let at = copy_pattern(inout p, in rn, p.op(inc(ops_at)));
        p.ops.push(at);
    } else if op == O_WRITE {
        p.ops.push(add(p.op(ops_at), value_base));
        put_root(inout p, in rn, p.op(inc(ops_at)), add(ops_at, 2));
    } else if op == O_UNARY {
        p.ops.push(p.op(ops_at));
        p.ops.push(add(p.op(inc(ops_at)), value_base));
    } else if op == O_INDEX {
        p.ops.push(add(p.op(ops_at), value_base));
        p.ops.push(add(p.op(inc(ops_at)), value_base));
    } else if op == O_BINARY {
        p.ops.push(p.op(ops_at));
        p.ops.push(add(p.op(inc(ops_at)), value_base));
        p.ops.push(add(p.op(add(ops_at, 2)), value_base));
    } else if op == O_PROJECT || op == O_TRY {
        p.ops.push(add(p.op(ops_at), value_base));
    } else if op == O_TUPLE || op == O_VECTOR {
        let n = p.op(ops_at);
        p.ops.push(n);
        for k in 0..n {
            p.ops.push(add(p.op(add(inc(ops_at), k)), value_base));
        }
    } else if op == O_DATA {
        p.ops.push(p.op(ops_at));
        let n = p.op(inc(ops_at));
        p.ops.push(n);
        for k in 0..n {
            p.ops.push(add(p.op(add(add(ops_at, 2), k)), value_base));
        }
    } else if op == O_CALL {
        p.ops.push(p.op(ops_at));
        p.ops.push(p.op(inc(ops_at)));
        put_args(inout p, in rn, add(ops_at, 2));
    } else if op == O_TILED || op == O_SEQ || op == O_FIP {
        put_args(inout p, in rn, ops_at);
    } else if op == O_INDIRECT {
        p.ops.push(add(p.op(ops_at), value_base));
        put_args(inout p, in rn, inc(ops_at));
    } else if op == O_EXIT {
        p.ops.push(p.op(ops_at));
        p.ops.push(add(p.op(inc(ops_at)), value_base));
    } else if op == O_HANDLE {
        let has = p.op(ops_at);
        p.ops.push(has);
        p.ops.push(
            if has != 0 {
                add(p.op(inc(ops_at)), value_base)
            } else {
                p.op(inc(ops_at))
            }
        );
        let pair_count = p.op(add(ops_at, 2));
        p.ops.push(pair_count);
        let mut at = add(ops_at, 3);
        for k in 0..pair_count {
            p.ops.push(p.op(at));
            p.ops.push(renamed_root(in p, in rn, p.op(inc(at))));
            at = add(at, 2);
        }
        let move_count = p.op(at);
        p.ops.push(move_count);
        at = inc(at);
        for k in 0..move_count {
            put_root(inout p, in rn, p.op(at), inc(at));
            at = add(add(at, 2), p.op(inc(at)));
        }
        let graph_count = p.op(at);
        p.ops.push(graph_count);
        for k in 0..graph_count {
            p.ops.push(p.op(add(inc(at), k)));
        }
    }
    out
}

fn new_block(
    inout p: Prog,
    in params: ChunkSeq[u32],
    in inst_ids: ChunkSeq[u32],
    term: u8,
    ta: u32
) -> u32 {
    let pa = n32(p.ids.len());
    p.ids.extend(in params.as_slice());
    let ia = n32(p.ids.len());
    p.ids.extend(in inst_ids.as_slice());
    let id = n32(p.blks.len());
    p.blks.push(
        Blk { pa: pa, pn: n32(params.len()), ia: ia, ic: n32(inst_ids.len()), term: term, ta: ta }
    );
    id
}

// `back(v)`: a jump to the continuation with `value`.
fn put_back(inout p: Prog, continuation: u64, value: u64) -> u32 {
    let ta = n32(p.ops.len());
    p.ops.push(continuation);
    p.ops.push(1);
    p.ops.push(value);
    ta
}

fn new_inst(inout p: Prog, inst: Inst) -> u32 {
    let id = n32(p.insts.len());
    p.insts.push(inst);
    id
}

// Replace the call at instruction `call_index` of caller block `b` with the
// target's body (`splice`). Returns the first block copied.
fn splice(
    inout p: Prog,
    caller_index: u32,
    b: u64,
    call_index: u64,
    g: Tgt,
    in bs: Bindings,
    serial: u64,
    in fd: Folded,
    in split_plan: Split
) -> u64 {
    let callee = p.fun(g.f);
    let next_value = value_bound(in p, p.fun(caller_index));
    let callee_values = value_bound(in p, callee);
    let continuation = w(p.fun(caller_index).fc);
    let first = inc(continuation);
    let mut rn = Rename {
        values: next_value,
        blocks: first,
        names: map_new(64),
        places: map_new(16)
    };
    for k in 0..w(callee.pn) {
        if bs.is_place(k) {
            rn.places.set(w(p.param(callee, k).name), n32(u64_at(in bs.at, k)));
        }
    }
    for k in 0..w(callee.ln) {
        let name = u32_at(in p.loc_name, add(w(callee.la), k));
        if rn.places.get(w(name)) == NONE32 {
            let new_name = renamed(inout p, name, serial);
            rn.names.set(w(name), new_name);
        }
    }
    for k in 0..w(callee.ln) {
        let name = u32_at(in p.loc_name, add(w(callee.la), k));
        let new_name = rn.names.get(w(name));
        if new_name != NONE32 {
            let ty = p.map(g.inst, u32_at(in p.loc_ty, add(w(callee.la), k)));
            push_local(inout p, caller_index, new_name, ty);
        }
    }
    for value in 0..w(callee.vn) {
        let callee_ty = p.value_ty(callee, value);
        if callee_ty != NONE32 {
            let ty = p.map(g.inst, callee_ty);
            set_value(inout p, caller_index, add(value, next_value), ty);
        }
    }
    let mut fresh = add(next_value, callee_values);
    // Split the caller's block at the call.
    let bk = p.block(p.fun(caller_index), b);
    let call_id = p.id(add(w(bk.ia), call_index));
    let call = p.inst(call_id);
    let mut prefix: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for k in 0..call_index {
        prefix.push(p.id(add(w(bk.ia), k)));
    }
    let mut rest: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for k in inc(call_index)..w(bk.ic) {
        rest.push(p.id(add(w(bk.ia), k)));
    }
    for k in 0..w(callee.pn) {
        if bs.is_place(k) {
            continue;
        }
        let dest = fresh;
        fresh = inc(fresh);
        set_value(inout p, caller_index, dest, p.unit_ty);
        let name = rn.names.get(w(p.param(callee, k).name));
        let pat = p.pats.len();
        p.pats.push(PK_BIND);
        p.pats.push(call.s0);
        p.pats.push(call.s1);
        p.pats.push(w(name));
        let ops_at = n32(p.ops.len());
        p.ops.push(w(u32_at(in bs.value, k)));
        p.ops.push(pat);
        let id = new_inst(
            inout p,
            Inst {
                dest: n32(dest),
                ty: p.unit_ty,
                s0: call.s0,
                s1: call.s1,
                flags: 0,
                opq: p.bind_opq,
                op: O_BIND,
                a: ops_at
            }
        );
        prefix.push(id);
    }
    let jump_ta = n32(p.ops.len());
    p.ops.push(first);
    p.ops.push(0);
    let empty: ChunkSeq[u32] = ChunkSeq::new[u32]();
    // The caller's block keeps its parameters.
    let mut own_params: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for k in 0..w(bk.pn) {
        own_params.push(p.id(add(w(bk.pa), k)));
    }
    let prefix_block = new_block(inout p, in own_params, in prefix, T_JUMP, jump_ta);
    set_block(inout p, caller_index, b, prefix_block);
    let mut cont_params: ChunkSeq[u32] = ChunkSeq::new[u32]();
    cont_params.push(call.dest);
    let cont_block = new_block(inout p, in cont_params, in rest, bk.term, bk.ta);
    push_block(inout p, caller_index, cont_block);
    let cold_block = add(first, w(callee.fc));
    let mut inst_ids: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut block_params: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for k in 0..w(callee.fc) {
        let source = p.block(callee, k);
        block_params.clear();
        for j in 0..w(source.pn) {
            block_params.push(n32(add(w(p.id(add(w(source.pa), j))), next_value)));
        }
        let keep = if split_plan.found {
            u8_at(in split_plan.hot, k) != 0
        } else {
            u8_at(in fd.live, k) != 0
        };
        if !keep {
            let id = new_block(inout p, in block_params, in empty, T_UNREACHABLE, 0);
            push_block(inout p, caller_index, id);
            continue;
        }
        inst_ids.clear();
        let mut exit_ta = NONE32;
        for j in 0..w(source.ic) {
            let source_inst = p.inst_of(source, j);
            let ops_at = copy_op(inout p, in rn, source_inst);
            if source_inst.op == O_EXIT {
                // `return value`: the rest of this block is unreachable.
                let value = p.op(inc(w(ops_at)));
                exit_ta = put_back(inout p, continuation, value);
                break;
            }
            let id = new_inst(
                inout p,
                Inst {
                    dest: n32(add(w(source_inst.dest), next_value)),
                    ty: p.map(g.inst, source_inst.ty),
                    s0: source_inst.s0,
                    s1: source_inst.s1,
                    flags: source_inst.flags,
                    opq: source_inst.opq,
                    op: source_inst.op,
                    a: ops_at
                }
            );
            inst_ids.push(id);
        }
        let mut term = T_JUMP;
        let mut ta = exit_ta;
        if ta == NONE32 {
            let decided = fd.jump(k);
            if decided != NONE32 {
                ta = n32(p.ops.len());
                p.ops.push(target(in split_plan, k, w(decided), first, cold_block));
                p.ops.push(0);
            } else {
                let source_ta = w(source.ta);
                ta = n32(p.ops.len());
                if source.term == T_RETURN {
                    let value = add(p.op(source_ta), next_value);
                    ta = put_back(inout p, continuation, value);
                } else if source.term == T_JUMP {
                    p.ops.push(target(in split_plan, k, p.op(source_ta), first, cold_block));
                    let n = p.op(inc(source_ta));
                    p.ops.push(n);
                    for j in 0..n {
                        p.ops.push(add(p.op(add(add(source_ta, 2), j)), next_value));
                    }
                } else if source.term == T_BRANCH {
                    term = T_BRANCH;
                    p.ops.push(add(p.op(source_ta), next_value));
                    p.ops.push(target(in split_plan, k, p.op(inc(source_ta)), first, cold_block));
                    p.ops.push(
                        target(in split_plan, k, p.op(add(source_ta, 2)), first, cold_block)
                    );
                } else if source.term == T_MATCH {
                    term = T_MATCH;
                    let arms = p.op(inc(source_ta));
                    let mut words: ChunkSeq[u64] = ChunkSeq::new[u64]();
                    words.push(add(p.op(source_ta), next_value));
                    words.push(arms);
                    for j in 0..arms {
                        let pat = copy_pattern(
                            inout p,
                            in rn,
                            p.op(add(add(source_ta, 2), wrapping_mul(j, 2)))
                        );
                        words.push(pat);
                        words.push(
                            target(
                                in split_plan,
                                k,
                                p.op(add(add(source_ta, 3), wrapping_mul(j, 2))),
                                first,
                                cold_block
                            )
                        );
                    }
                    ta = n32(p.ops.len());
                    p.ops.extend(in words.as_slice());
                } else {
                    term = T_UNREACHABLE;
                }
            }
        }
        let id = new_block(inout p, in block_params, in inst_ids, term, ta);
        push_block(inout p, caller_index, id);
    }
    if split_plan.found {
        let dest = fresh;
        set_value(inout p, caller_index, dest, p.map(g.inst, callee.result));
        let again = new_inst(
            inout p,
            Inst {
                dest: n32(dest),
                ty: call.ty,
                s0: call.s0,
                s1: call.s1,
                flags: call.flags,
                opq: call.opq,
                op: call.op,
                a: call.a
            }
        );
        inst_ids.clear();
        inst_ids.push(again);
        let ta = put_back(inout p, continuation, dest);
        let id = new_block(inout p, in empty, in inst_ids, T_JUMP, ta);
        push_block(inout p, caller_index, id);
    }
    first
}

// A callee block target in the copy (`target` in `splice`).
fn target(
    in split_plan: Split,
    from_block: u64,
    to_block: u64,
    first: u64,
    cold_block: u64
) -> u64 {
    if split_plan.found && w(split_plan.block) == from_block && w(split_plan.cold) == to_block {
        cold_block
    } else {
        add(to_block, first)
    }
}

// ----- the report -----------------------------------------------------------------------

pub struct Report {
    sites: u64,
    added: u64,
    folded: u64,
    constants: u64,
    // per function
    callees: ChunkSeq[u64],
    partial: ChunkSeq[u64],
    growth: ChunkSeq[u64],
    grown: ChunkSeq[u8],
    // per function and reason
    refused: ChunkSeq[u64],
    // contents: per function a list of (callee, units)
    c_head: ChunkSeq[u32],
    c_key: ChunkSeq[u32],
    c_units: ChunkSeq[u64],
    c_next: ChunkSeq[u32],
    c_map: MapU,
    // inlined_into: per function a list of members
    i_head: ChunkSeq[u32],
    i_member: ChunkSeq[u32],
    i_next: ChunkSeq[u32],
    i_map: MapU,
}

fn report_new(nf: u64) -> Report {
    Report {
        sites: 0,
        added: 0,
        folded: 0,
        constants: 0,
        callees: zeros64(nf),
        partial: zeros64(nf),
        growth: zeros64(nf),
        grown: zeros8(nf),
        refused: zeros64(wrapping_mul(nf, REASONS)),
        c_head: fill32(nf, NONE32),
        c_key: ChunkSeq::new[u32](),
        c_units: ChunkSeq::new[u64](),
        c_next: ChunkSeq::new[u32](),
        c_map: map_new(256),
        i_head: fill32(nf, NONE32),
        i_member: ChunkSeq::new[u32](),
        i_next: ChunkSeq::new[u32](),
        i_map: map_new(256)
    }
}

impl Report {
    fn refuse(inout self, f: u32, why: u32) {
        let at = add(wrapping_mul(w(f), REASONS), w(why));
        set_u64(inout self.refused, at, inc(u64_at(in self.refused, at)));
    }

    fn grow(inout self, f: u32, units: u64) {
        set_u64(inout self.growth, w(f), add(u64_at(in self.growth, w(f)), units));
        set_u8(inout self.grown, w(f), 1);
    }

    fn hold(inout self, f: u32, key: u32, units: u64) {
        let pair_key = pair(f, key);
        let entry = self.c_map.get(pair_key);
        if entry == NONE32 {
            let new_entry = n32(self.c_key.len());
            self.c_key.push(key);
            self.c_units.push(units);
            self.c_next.push(u32_at(in self.c_head, w(f)));
            set_u32(inout self.c_head, w(f), new_entry);
            self.c_map.set(pair_key, new_entry);
        } else {
            set_u64(inout self.c_units, w(entry), add(u64_at(in self.c_units, w(entry)), units));
        }
    }

    fn into(inout self, f: u32, member: u32) {
        let pair_key = pair(f, member);
        if self.i_map.get(pair_key) != NONE32 {
            return;
        }
        self.i_map.set(pair_key, 1);
        let entry = n32(self.i_member.len());
        self.i_member.push(member);
        self.i_next.push(u32_at(in self.i_head, w(f)));
        set_u32(inout self.i_head, w(f), entry);
    }
}

// ----- the pass -------------------------------------------------------------------------

fn find_instance(in p: Prog, callee: u32, s0: u64, s1: u64) -> u32 {
    for k in 0..p.instances.len() {
        match p.instances.try_get(k) {
            Option::Some(instance) => {
                if instance.callee == callee && instance.s0 == s0 && instance.s1 == s1 {
                    if instance.has {
                        return n32(k);
                    }
                    return NONE32;
                }
            },
            Option::None => {},
        }
    }
    NONE32
}

// `inline_into`: inline the eligible calls of caller `c`.
// `owns_sequence`: a local of the target, a by-value parameter included,
// whose type holds a sequence and is no slice view. Its copy would put the sequence's slot,
// frame and drop flags on every path of the caller (#1499).
fn owns_sequence(in p: Prog, g: Tgt) -> bool {
    let f = p.fun(g.f);
    for k in 0..w(f.ln) {
        let at = add(w(f.la), k);
        let ty = p.map(g.inst, u32_at(in p.loc_ty, at));
        if !p.has(ty, F_SEQUENCE) || p.has(ty, F_SLICE) {
            continue;
        }
        let name = u32_at(in p.loc_name, at);
        let mut owned = true;
        for j in 0..w(f.pn) {
            let param = p.param(f, j);
            if param.name == name {
                owned = param.pass == TyPass::Sink;
                break;
            }
        }
        if owned {
            return true;
        }
    }
    false
}

// `cold_block`: block `b` of function `fi` is on no cycle, and some path
// from the entry leaves the function without passing it.
fn cold_block(in p: Prog, fi: u32, b: u64) -> bool {
    if b == 0 {
        return false;
    }
    let f = p.fun(fi);
    let nblocks = w(f.fc);
    let mut succ: ChunkSeq[u32] = ChunkSeq::new[u32]();
    // On a cycle: `b` is reachable from its own successors.
    let mut seen = zeros8(nblocks);
    let mut work: ChunkSeq[u32] = ChunkSeq::new[u32]();
    successors(in p, p.block(f, b), inout succ);
    for k in 0..succ.len() {
        work.push(u32_at(in succ, k));
    }
    loop {
        let block = match work.pop() {
            Option::Some(popped) => w(popped),
            Option::None => break,
        };
        if block >= nblocks || u8_at(in seen, block) != 0 {
            continue;
        }
        if block == b {
            return false;
        }
        set_u8(inout seen, block, 1);
        successors(in p, p.block(f, block), inout succ);
        for j in 0..succ.len() {
            work.push(u32_at(in succ, j));
        }
    }
    // A path from the entry that avoids `b` and leaves the function.
    let mut seen_from_entry = zeros8(nblocks);
    work.push(0);
    loop {
        let block = match work.pop() {
            Option::Some(popped) => w(popped),
            Option::None => break,
        };
        if block == b || block >= nblocks || u8_at(in seen_from_entry, block) != 0 {
            continue;
        }
        set_u8(inout seen_from_entry, block, 1);
        let bk = p.block(f, block);
        if bk.term == T_RETURN {
            return true;
        }
        for i in 0..w(bk.ic) {
            let inst = p.inst_of(bk, i);
            if inst.op == O_EXIT && n32(p.op(w(inst.a))) == f.name {
                return true;
            }
        }
        successors(in p, bk, inout succ);
        for j in 0..succ.len() {
            work.push(u32_at(in succ, j));
        }
    }
    false
}

fn inline_into(
    inout p: Prog,
    caller_index: u32,
    in callee_why: ChunkSeq[u32],
    in sites: ChunkSeq[u64],
    inout serial: u64,
    inout rep: Report
) {
    let mut added: u64 = 0;
    let mut handles_added: u64 = 0;
    // Blocks spliced in from a callee were already processed bottom-up.
    let mut spliced = zeros8(w(p.fun(caller_index).fc));
    let mut b: u64 = 0;
    loop {
        if b >= w(p.fun(caller_index).fc) {
            break;
        }
        if u8_at(in spliced, b) != 0 {
            b = inc(b);
            continue;
        }
        let mut call_index: u64 = 0;
        loop {
            let bk = p.block(p.fun(caller_index), b);
            if call_index >= w(bk.ic) {
                break;
            }
            let inst = p.inst_of(bk, call_index);
            if inst.op != O_CALL {
                call_index = inc(call_index);
                continue;
            }
            let ops_at = w(inst.a);
            let fi = p.fun_index(n32(p.op(ops_at)));
            if fi == NONE32 {
                call_index = inc(call_index);
                continue;
            }
            let mut why = u32_at(in callee_why, w(fi));
            let mut g = Tgt { f: fi, inst: NONE32 };
            let mut bs = bindings_new();
            let mut fd = folded_none(0);
            let mut split_plan = no_split();
            let mut cost_here: u64 = 0;
            if why == R_OK && (p.op(inc(ops_at)) != 0 || fi == caller_index) {
                why = R_SITE_TYPES;
            }
            if why == R_OK && (p.fun(fi).flags & W_GENERIC) != 0 {
                g.inst = find_instance(in p, p.fun(fi).name, inst.s0, inst.s1);
                if g.inst == NONE32 {
                    why = R_SITE_UNRECORDED;
                }
            }
            if why == R_OK {
                why = site_bindings(in p, caller_index, g, inst.dest, add(ops_at, 2), inout bs);
            }
            if why == R_OK && owns_sequence(in p, g) && cold_block(in p, caller_index, b) {
                why = R_SITE_COLD;
            }
            if why == R_OK {
                let handlers = handler_sum(in p, fi, false);
                let mut folded_ok = false;
                fd = fold(inout p, caller_index, g, in bs, inout folded_ok);
                let at_site = add(folded_cost(in p, g, in fd), handlers);
                let single = u64_at(in sites, w(fi)) == 1;
                let fits = at_site <= p.small_callee || (single && at_site <= p.single_site_callee);
                if fits {
                    cost_here = at_site;
                } else {
                    if handlers == 0 && partial_ok(in p, g, in bs) {
                        split_plan = split(in p, g, in fd, p.small_callee);
                    }
                    if split_plan.found {
                        cost_here = split_plan.hot_cost;
                    } else {
                        why = R_SIZE;
                    }
                }
            }
            if why == R_OK {
                // The copy also duplicates every body already inlined into
                // the callee: charge those callees' caps too.
                let cap = p.callee_growth;
                let mut over_cap = add(u64_at(in rep.growth, w(fi)), cost_here) > cap;
                let mut entry = u32_at(in rep.c_head, w(fi));
                loop {
                    if entry == NONE32 || over_cap {
                        break;
                    }
                    let key = u32_at(in rep.c_key, w(entry));
                    if add(u64_at(in rep.growth, w(key)), u64_at(in rep.c_units, w(entry))) > cap {
                        over_cap = true;
                    }
                    entry = u32_at(in rep.c_next, w(entry));
                }
                if add(added, cost_here) > p.caller_growth
                    || add(rep.added, cost_here) > p.program_growth
                    || over_cap
                    || add(handles_added, handler_sum(in p, fi, true)) > p.caller_handles {
                    why = R_GROWTH;
                }
            }
            if why != R_OK {
                rep.refuse(fi, why);
                call_index = inc(call_index);
                continue;
            }
            serial = inc(serial);
            let first = splice(
                inout p,
                caller_index,
                b,
                call_index,
                g,
                in bs,
                serial,
                in fd,
                in split_plan
            );
            let total = w(p.fun(caller_index).fc);
            loop {
                if spliced.len() >= total {
                    break;
                }
                spliced.push(0);
            }
            for k in first..total {
                set_u8(inout spliced, k, 1);
            }
            added = add(added, cost_here);
            handles_added = add(handles_added, handler_sum(in p, fi, true));
            rep.added = add(rep.added, cost_here);
            rep.sites = inc(rep.sites);
            // nested = contents[target], taken before the caller's update
            let mut nested_keys: ChunkSeq[u32] = ChunkSeq::new[u32]();
            let mut nested_units: ChunkSeq[u64] = ChunkSeq::new[u64]();
            let mut entry = u32_at(in rep.c_head, w(fi));
            loop {
                if entry == NONE32 {
                    break;
                }
                nested_keys.push(u32_at(in rep.c_key, w(entry)));
                nested_units.push(u64_at(in rep.c_units, w(entry)));
                entry = u32_at(in rep.c_next, w(entry));
            }
            rep.hold(caller_index, fi, cost_here);
            for k in 0..nested_keys.len() {
                rep.hold(caller_index, u32_at(in nested_keys, k), u64_at(in nested_units, k));
            }
            rep.grow(fi, cost_here);
            for k in 0..nested_keys.len() {
                rep.grow(u32_at(in nested_keys, k), u64_at(in nested_units, k));
            }
            set_u64(inout rep.callees, w(fi), inc(u64_at(in rep.callees, w(fi))));
            if split_plan.found {
                set_u64(inout rep.partial, w(fi), inc(u64_at(in rep.partial, w(fi))));
            }
            if fd.decides() {
                rep.folded = inc(rep.folded);
            }
            let mut members: ChunkSeq[u32] = ChunkSeq::new[u32]();
            let mut member_entry = u32_at(in rep.i_head, w(fi));
            loop {
                if member_entry == NONE32 {
                    break;
                }
                members.push(u32_at(in rep.i_member, w(member_entry)));
                member_entry = u32_at(in rep.i_next, w(member_entry));
            }
            rep.into(caller_index, fi);
            for k in 0..members.len() {
                rep.into(caller_index, u32_at(in members, k));
            }
            // The rest of this block moved to the continuation block, which
            // the outer loop reaches later.
            break;
        }
        b = inc(b);
    }
}

// `inline`: small, non-recursive direct calls, bottom-up over the call
// graph, within the budget.
pub fn inline(inout p: Prog) -> Report {
    let fun_count = p.funs.len();
    let mut rep = report_new(fun_count);
    if p.budget_off() {
        return rep;
    }
    rep.constants = fold_literal_constants(inout p);
    let mut call_graph = graph_new(fun_count);
    let mut sites = zeros64(fun_count);
    let mut graphs: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for fi in 0..fun_count {
        let fun_id = n32(fi);
        let _ = call_graph.node(fun_id);
        let f = p.fun(fun_id);
        for b in 0..w(f.fc) {
            let bk = p.block(f, b);
            for k in 0..w(bk.ic) {
                let inst = p.inst_of(bk, k);
                if inst.op != O_CALL {
                    continue;
                }
                let callee = p.fun_index(n32(p.op(w(inst.a))));
                if callee != NONE32 {
                    call_graph.edge(fun_id, callee);
                    set_u64(inout sites, w(callee), inc(u64_at(in sites, w(callee))));
                }
            }
        }
        graphs.clear();
        handler_graphs(in p, fun_id, inout graphs);
        for k in 0..graphs.len() {
            let nested = p.fun_index(u32_at(in graphs, k));
            if nested != NONE32 {
                call_graph.edge(fun_id, nested);
            }
        }
    }
    let scc = tarjan(in call_graph);
    let mut recursive = zeros8(fun_count);
    let mut order: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for component in 0..scc.components() {
        let lo = w(u32_at(in scc.comp_start, component));
        let hi = w(u32_at(in scc.comp_start, inc(component)));
        let first = u32_at(in scc.comp_nodes, lo);
        let cyclic = sub(hi, lo) > 1 || u8_at(in call_graph.self_edge, w(first)) != 0;
        for k in lo..hi {
            let member = u32_at(in call_graph.nodes, w(u32_at(in scc.comp_nodes, k)));
            if cyclic {
                set_u8(inout recursive, w(member), 1);
            }
            order.push(member);
        }
    }
    // Functions that a `return` in another graph leaves.
    let mut exited = zeros8(fun_count);
    for fi in 0..fun_count {
        let f = p.fun(n32(fi));
        for b in 0..w(f.fc) {
            let bk = p.block(f, b);
            for k in 0..w(bk.ic) {
                let inst = p.inst_of(bk, k);
                if inst.op == O_EXIT {
                    let owner = n32(p.op(w(inst.a)));
                    if owner != f.name {
                        let owner_index = p.fun_index(owner);
                        if owner_index != NONE32 {
                            set_u8(inout exited, w(owner_index), 1);
                        }
                    }
                }
            }
        }
    }
    let mut callee_why = fill32(fun_count, R_OK);
    for fi in 0..fun_count {
        let why = if u8_at(in recursive, fi) != 0 {
            R_RECURSIVE
        } else if u8_at(in exited, fi) != 0 {
            R_HANDLER_RETURN
        } else {
            inlinable(in p, n32(fi))
        };
        set_u32(inout callee_why, fi, why);
    }
    let mut serial: u64 = 0;
    for k in 0..order.len() {
        if rep.added >= p.program_growth {
            break;
        }
        let caller_index = u32_at(in order, k);
        if caller_eligible(in p, caller_index) {
            inline_into(inout p, caller_index, in callee_why, in sites, inout serial, inout rep);
        } else {
            let f = p.fun(caller_index);
            for b in 0..w(f.fc) {
                let bk = p.block(f, b);
                for j in 0..w(bk.ic) {
                    let inst = p.inst_of(bk, j);
                    if inst.op == O_CALL {
                        let callee = p.fun_index(n32(p.op(w(inst.a))));
                        if callee != NONE32 {
                            rep.refuse(callee, R_CALLER);
                        }
                    }
                }
            }
        }
    }
    rep
}

// ----- output ---------------------------------------------------------------------------

// The report (`decode_report` in tests/common/inline_words.rs). Names are
// symbols, which equal input name indexes for every input name (the input
// names are interned first, in order, after the empty name).
fn put_report(in p: Prog, in rep: Report, inout o: ChunkSeq[u64]) {
    o.push(rep.sites);
    o.push(rep.added);
    o.push(rep.folded);
    o.push(rep.constants);
    let nf = p.funs.len();
    let mut rows: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut count: u64 = 0;
    for func in 0..nf {
        let n = u64_at(in rep.callees, func);
        if n > 0 {
            rows.push(p.input_name(p.fun(n32(func)).name));
            rows.push(n);
            count = inc(count);
        }
    }
    o.push(count);
    o.extend(in rows.as_slice());
    rows.clear();
    count = 0;
    for func in 0..nf {
        let head = u32_at(in rep.i_head, func);
        if head == NONE32 {
            continue;
        }
        count = inc(count);
        rows.push(p.input_name(p.fun(n32(func)).name));
        let mut members: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let mut entry = head;
        loop {
            if entry == NONE32 {
                break;
            }
            members.push(p.input_name(p.fun(u32_at(in rep.i_member, w(entry))).name));
            entry = u32_at(in rep.i_next, w(entry));
        }
        rows.push(members.len());
        rows.extend(in members.as_slice());
    }
    o.push(count);
    o.extend(in rows.as_slice());
    rows.clear();
    count = 0;
    for func in 0..nf {
        for reason in 0..REASONS {
            let n = u64_at(in rep.refused, add(wrapping_mul(func, REASONS), reason));
            if n > 0 {
                rows.push(p.input_name(p.fun(n32(func)).name));
                rows.push(reason);
                rows.push(n);
                count = inc(count);
            }
        }
    }
    o.push(count);
    o.extend(in rows.as_slice());
    rows.clear();
    count = 0;
    for func in 0..nf {
        let n = u64_at(in rep.partial, func);
        if n > 0 {
            rows.push(p.input_name(p.fun(n32(func)).name));
            rows.push(n);
            count = inc(count);
        }
    }
    o.push(count);
    o.extend(in rows.as_slice());
    rows.clear();
    count = 0;
    for func in 0..nf {
        if u8_at(in rep.grown, func) != 0 {
            rows.push(p.input_name(p.fun(n32(func)).name));
            rows.push(u64_at(in rep.growth, func));
            count = inc(count);
        }
    }
    o.push(count);
    o.extend(in rows.as_slice());
    o.push(nf);
    for func in 0..nf {
        let func_id = n32(func);
        o.push(p.input_name(p.fun(func_id).name));
        o.push(size(in p, func_id));
        o.push(cost(in p, Tgt { f: func_id, inst: NONE32 }));
    }
}

// ----- the canonical text (`dump` in tests/common/inline_words.rs) ----------------------

fn put(inout o: ChunkSeq[u8], in text: Str) {
    o.extend(in text.as_bytes());
}

fn put_name(in p: Prog, inout o: ChunkSeq[u8], symbol: u64) {
    p.names.write(n32(symbol), inout o);
}

// root.path from operand offset `at` (root, n, path*).
fn put_path(in p: Prog, inout o: ChunkSeq[u8], at: u64) {
    put_name(in p, inout o, p.op(at));
    let n = p.op(inc(at));
    for k in 0..n {
        o.push(46);
        put_name(in p, inout o, p.op(add(add(at, 2), k)));
    }
}

fn put_pattern(in p: Prog, inout o: ChunkSeq[u8], at: u64) {
    let kind = p.pat(at);
    if kind == PK_WILD {
        o.push(95);
    } else if kind == PK_BIND {
        put_name(in p, inout o, p.pat(add(at, 3)));
    } else if kind == PK_TUPLE {
        o.push(40);
        let n = p.pat(add(at, 3));
        for i in 0..n {
            put_pattern(in p, inout o, p.pat(add(add(at, 4), i)));
            o.push(44);
        }
        o.push(41);
    } else if kind == PK_CTOR {
        put_name(in p, inout o, p.pat(add(at, 3)));
        if p.pat(add(at, 4)) != 0 {
            o.push(33);
        }
        o.push(123);
        let n = p.pat(add(at, 5));
        for i in 0..n {
            put_name(in p, inout o, p.pat(add(add(at, 6), wrapping_mul(i, 2))));
            o.push(58);
            put_pattern(in p, inout o, p.pat(add(add(at, 7), wrapping_mul(i, 2))));
            o.push(44);
        }
        o.push(125);
    } else if kind == PK_LIT {
        o.push(35);
        push_decimal(inout o, p.pat(add(at, 6)));
    }
    o.push(64);
    push_decimal(inout o, p.pat(inc(at)));
    o.push(45);
    push_decimal(inout o, p.pat(add(at, 2)));
}

fn put_space_num(inout o: ChunkSeq[u8], value: u64) {
    o.push(32);
    push_decimal(inout o, value);
}

fn put_dump_args(in p: Prog, inout o: ChunkSeq[u8], start: u64) {
    let n = p.op(start);
    let mut at = inc(start);
    for k in 0..n {
        put_space_num(inout o, p.op(at));
        o.push(58);
        push_decimal(inout o, p.op(inc(at)));
        if p.op(add(at, 2)) != 0 {
            o.push(61);
            put_path(in p, inout o, add(at, 3));
        }
        at = arg_end(in p, at);
    }
}

fn put_inst(in p: Prog, inout o: ChunkSeq[u8], inst: Inst) {
    put_space_num(inout o, w(inst.dest));
    put_space_num(inout o, w(inst.ty));
    put_space_num(inout o, inst.s0);
    o.push(45);
    push_decimal(inout o, inst.s1);
    put_space_num(inout o, inst.flags & I_FALLIBLE);
    put(inout o, " #");
    push_decimal(inout o, w(inst.opq));
    let ops_at = w(inst.a);
    let op = inst.op;
    if op == O_READ {
        o.push(32);
        put_path(in p, inout o, ops_at);
    } else if op == O_BIND {
        put_space_num(inout o, p.op(ops_at));
        o.push(32);
        put_pattern(in p, inout o, p.op(inc(ops_at)));
    } else if op == O_WRITE {
        o.push(32);
        put_path(in p, inout o, inc(ops_at));
        put_space_num(inout o, p.op(ops_at));
    } else if op == O_UNARY {
        put_space_num(inout o, p.op(inc(ops_at)));
    } else if op == O_PROJECT || op == O_TRY {
        put_space_num(inout o, p.op(ops_at));
    } else if op == O_BINARY {
        put_space_num(inout o, p.op(inc(ops_at)));
        put_space_num(inout o, p.op(add(ops_at, 2)));
    } else if op == O_INDEX {
        put_space_num(inout o, p.op(ops_at));
        put_space_num(inout o, p.op(inc(ops_at)));
    } else if op == O_TUPLE || op == O_VECTOR {
        let n = p.op(ops_at);
        for k in 0..n {
            put_space_num(inout o, p.op(add(inc(ops_at), k)));
        }
    } else if op == O_DATA {
        let n = p.op(inc(ops_at));
        for k in 0..n {
            put_space_num(inout o, p.op(add(add(ops_at, 2), k)));
        }
    } else if op == O_CALL {
        o.push(32);
        put_name(in p, inout o, p.op(ops_at));
        put_dump_args(in p, inout o, add(ops_at, 2));
    } else if op == O_TILED || op == O_SEQ || op == O_FIP {
        put_dump_args(in p, inout o, ops_at);
    } else if op == O_INDIRECT {
        put_space_num(inout o, p.op(ops_at));
        put_dump_args(in p, inout o, inc(ops_at));
    } else if op == O_EXIT {
        put_space_num(inout o, p.op(inc(ops_at)));
    } else if op == O_HANDLE {
        if p.op(ops_at) != 0 {
            put(inout o, " state");
            put_space_num(inout o, p.op(inc(ops_at)));
        }
        let pair_count = p.op(add(ops_at, 2));
        let mut at = add(ops_at, 3);
        for k in 0..pair_count {
            o.push(32);
            put_name(in p, inout o, p.op(at));
            o.push(61);
            put_name(in p, inout o, p.op(inc(at)));
            at = add(at, 2);
        }
        let move_count = p.op(at);
        at = inc(at);
        for k in 0..move_count {
            put(inout o, " move ");
            put_path(in p, inout o, at);
            at = add(add(at, 2), p.op(inc(at)));
        }
    }
    o.push(10);
}

fn put_term(in p: Prog, inout o: ChunkSeq[u8], bk: Blk) {
    let ta = w(bk.ta);
    if bk.term == T_RETURN {
        put(inout o, " return");
        put_space_num(inout o, p.op(ta));
    } else if bk.term == T_JUMP {
        put(inout o, " jump");
        put_space_num(inout o, p.op(ta));
        let n = p.op(inc(ta));
        for k in 0..n {
            put_space_num(inout o, p.op(add(add(ta, 2), k)));
        }
    } else if bk.term == T_BRANCH {
        put(inout o, " branch");
        put_space_num(inout o, p.op(ta));
        put_space_num(inout o, p.op(inc(ta)));
        put_space_num(inout o, p.op(add(ta, 2)));
    } else if bk.term == T_MATCH {
        put(inout o, " match");
        put_space_num(inout o, p.op(ta));
        let n = p.op(inc(ta));
        for k in 0..n {
            o.push(32);
            put_pattern(in p, inout o, p.op(add(add(ta, 2), wrapping_mul(k, 2))));
            put(inout o, "=>");
            push_decimal(inout o, p.op(add(add(ta, 3), wrapping_mul(k, 2))));
        }
    } else {
        put(inout o, " unreachable");
    }
    o.push(10);
}

// The program as `dump` writes it; locals in pool order (the harness sorts
// them by name).
fn put_dump(in p: Prog, inout o: ChunkSeq[u8]) {
    for fi in 0..p.funs.len() {
        let f = p.fun(n32(fi));
        put(inout o, "fn ");
        put_name(in p, inout o, w(f.name));
        put(inout o, " ->");
        put_space_num(inout o, w(f.result));
        o.push(10);
        for k in 0..w(f.pn) {
            let param = p.param(f, k);
            put(inout o, "param ");
            put_name(in p, inout o, w(param.name));
            put_space_num(inout o, param.pass);
            put_space_num(inout o, w(param.ty));
            o.push(10);
        }
        for k in 0..w(f.ln) {
            put(inout o, "local ");
            put_name(in p, inout o, w(u32_at(in p.loc_name, add(w(f.la), k))));
            put_space_num(inout o, w(u32_at(in p.loc_ty, add(w(f.la), k))));
            o.push(10);
        }
        for v in 0..w(f.vn) {
            let ty = p.value_ty(f, v);
            if ty != NONE32 {
                put(inout o, "value");
                put_space_num(inout o, v);
                put_space_num(inout o, w(ty));
                o.push(10);
            }
        }
        for b in 0..w(f.fc) {
            let bk = p.block(f, b);
            put(inout o, "block");
            put_space_num(inout o, b);
            for k in 0..w(bk.pn) {
                put_space_num(inout o, w(p.id(add(w(bk.pa), k))));
            }
            o.push(10);
            for k in 0..w(bk.ic) {
                put_inst(in p, inout o, p.inst_of(bk, k));
            }
            put_term(in p, inout o, bk);
        }
    }
}

// ----- program words ------------------------------------------------------------------
//
// The inlined program in the input's own encoding (`read_function`), so
// tests/common/inline_words.rs reads it back into an `ir::Program`: every
// name is a symbol of the package's name table, which comes first. Per function: name, locals (n, (name, type)*), value types
// (n, (value, type)*), blocks (n, per block: params, instructions,
// terminator). Each instruction is dest, type, span, flags, opaque, opcode
// and the operands `read_op` reads.

// A path at operand offset `at` (n, names); returns the offset after it.
fn put_path_words(in p: Prog, inout o: ChunkSeq[u64], at: u64) -> u64 {
    let n = p.op(at);
    o.push(n);
    for k in 0..n {
        o.push(p.op(add(inc(at), k)));
    }
    add(inc(at), n)
}

fn put_pattern_words(in p: Prog, inout o: ChunkSeq[u64], at: u64) {
    let kind = p.pat(at);
    o.push(kind);
    if kind == PK_BIND {
        o.push(p.pat(add(at, 3)));
    } else if kind == PK_TUPLE {
        let n = p.pat(add(at, 3));
        o.push(n);
        for i in 0..n {
            put_pattern_words(in p, inout o, p.pat(add(add(at, 4), i)));
        }
    } else if kind == PK_CTOR {
        o.push(p.pat(add(at, 3)));
        o.push(p.pat(add(at, 4)));
        let n = p.pat(add(at, 5));
        o.push(n);
        for i in 0..n {
            o.push(p.pat(add(add(at, 6), wrapping_mul(i, 2))));
            put_pattern_words(in p, inout o, p.pat(add(add(at, 7), wrapping_mul(i, 2))));
        }
    } else if kind == PK_LIT {
        for k in 3..7 {
            o.push(p.pat(add(at, k)));
        }
    }
    o.push(p.pat(inc(at)));
    o.push(p.pat(add(at, 2)));
}

fn put_args_words(in p: Prog, inout o: ChunkSeq[u64], start: u64) {
    let n = p.op(start);
    o.push(n);
    let mut at = inc(start);
    for k in 0..n {
        o.push(p.op(at));
        o.push(p.op(inc(at)));
        let has = p.op(add(at, 2));
        o.push(has);
        if has != 0 {
            o.push(p.op(add(at, 3)));
            let after = put_path_words(in p, inout o, add(at, 4));
        }
        at = arg_end(in p, at);
    }
}

// `count` operand words from offset `at`.
fn put_op_run(in p: Prog, inout o: ChunkSeq[u64], at: u64, count: u64) {
    for k in 0..count {
        o.push(p.op(add(at, k)));
    }
}

fn put_inst_words(in p: Prog, inout o: ChunkSeq[u64], inst: Inst) {
    o.push(w(inst.dest));
    o.push(w(inst.ty));
    o.push(inst.s0);
    o.push(inst.s1);
    o.push(inst.flags);
    o.push(w(inst.opq));
    o.push(widen_u64(inst.op));
    let ops_at = w(inst.a);
    let op = inst.op;
    if op == O_CONST || op == O_BINARY {
        put_op_run(in p, inout o, ops_at, 3);
    } else if op == O_READ {
        o.push(p.op(ops_at));
        let after = put_path_words(in p, inout o, inc(ops_at));
    } else if op == O_BIND {
        o.push(p.op(ops_at));
        put_pattern_words(in p, inout o, p.op(inc(ops_at)));
    } else if op == O_WRITE {
        put_op_run(in p, inout o, ops_at, 2);
        let after = put_path_words(in p, inout o, add(ops_at, 2));
    } else if op == O_UNARY || op == O_INDEX {
        put_op_run(in p, inout o, ops_at, 2);
    } else if op == O_PROJECT || op == O_TRY {
        o.push(p.op(ops_at));
    } else if op == O_TUPLE || op == O_VECTOR {
        put_op_run(in p, inout o, ops_at, inc(p.op(ops_at)));
    } else if op == O_DATA {
        put_op_run(in p, inout o, ops_at, add(p.op(inc(ops_at)), 2));
    } else if op == O_CALL {
        put_op_run(in p, inout o, ops_at, 2);
        put_args_words(in p, inout o, add(ops_at, 2));
    } else if op == O_TILED || op == O_SEQ || op == O_FIP {
        put_args_words(in p, inout o, ops_at);
    } else if op == O_INDIRECT {
        o.push(p.op(ops_at));
        put_args_words(in p, inout o, inc(ops_at));
    } else if op == O_EXIT {
        put_op_run(in p, inout o, ops_at, 2);
    } else if op == O_HANDLE {
        let pair_count = p.op(add(ops_at, 2));
        put_op_run(in p, inout o, ops_at, add(3, wrapping_mul(pair_count, 2)));
        let mut at = add(add(ops_at, 3), wrapping_mul(pair_count, 2));
        let move_count = p.op(at);
        o.push(move_count);
        at = inc(at);
        for k in 0..move_count {
            o.push(p.op(at));
            at = put_path_words(in p, inout o, inc(at));
        }
        put_op_run(in p, inout o, at, inc(p.op(at)));
    }
}

fn put_term_words(in p: Prog, inout o: ChunkSeq[u64], bk: Blk) {
    let ta = w(bk.ta);
    o.push(widen_u64(bk.term));
    if bk.term == T_RETURN {
        o.push(p.op(ta));
    } else if bk.term == T_JUMP {
        put_op_run(in p, inout o, ta, add(p.op(inc(ta)), 2));
    } else if bk.term == T_BRANCH {
        put_op_run(in p, inout o, ta, 3);
    } else if bk.term == T_MATCH {
        o.push(p.op(ta));
        let n = p.op(inc(ta));
        o.push(n);
        for k in 0..n {
            put_pattern_words(in p, inout o, p.op(add(add(ta, 2), wrapping_mul(k, 2))));
            o.push(p.op(add(add(ta, 3), wrapping_mul(k, 2))));
        }
    }
}

fn put_program_words(in p: Prog, inout o: ChunkSeq[u64]) {
    // The name table first: every symbol's bytes, packed.
    let name_count = p.names.len();
    o.push(name_count);
    let mut text: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for symbol in 0..name_count {
        text.clear();
        p.names.write(n32(symbol), inout text);
        let packed = pack(in text);
        o.extend(in packed.as_slice());
    }
    o.push(p.funs.len());
    for fi in 0..p.funs.len() {
        let f = p.fun(n32(fi));
        o.push(w(f.name));
        o.push(w(f.ln));
        for k in 0..w(f.ln) {
            o.push(w(u32_at(in p.loc_name, add(w(f.la), k))));
            o.push(w(u32_at(in p.loc_ty, add(w(f.la), k))));
        }
        let mut vals: ChunkSeq[u64] = ChunkSeq::new[u64]();
        for v in 0..w(f.vn) {
            let ty = p.value_ty(f, v);
            if ty != NONE32 {
                vals.push(v);
                vals.push(w(ty));
            }
        }
        o.push(vals.len() / 2);
        o.extend(in vals.as_slice());
        o.push(w(f.fc));
        for b in 0..w(f.fc) {
            let bk = p.block(f, b);
            o.push(w(bk.pn));
            for k in 0..w(bk.pn) {
                o.push(w(p.id(add(w(bk.pa), k))));
            }
            o.push(w(bk.ic));
            for k in 0..w(bk.ic) {
                put_inst_words(in p, inout o, p.inst_of(bk, k));
            }
            put_term_words(in p, inout o, bk);
        }
    }
}

// ----- entries --------------------------------------------------------------------------

// The text packed as words: a byte length, then the bytes eight per word.
fn pack(in text: ChunkSeq[u8]) -> ChunkSeq[u64] {
    let mut words: ChunkSeq[u64] = ChunkSeq::new[u64]();
    words.push(text.len());
    let mut word: u64 = 0;
    let mut shift: u64 = 0;
    for i in 0..text.len() {
        word = word | wrapping_shl_u64(widen_u64(u8_at(in text, i)), n32(shift));
        shift = add(shift, 8);
        if shift == 64 {
            words.push(word);
            word = 0;
            shift = 0;
        }
    }
    if shift > 0 {
        words.push(word);
    }
    words
}

// The hybrid's `inline` hook (crates/vesper-hybrid/modules/ir_inline): the
// inliner over `inline_input`'s bytes, returning what mode 3 returns.
pub fn inline_program_words(in bytes: Slice[u8]) -> ChunkSeq[u64] {
    let mut p = read_input(in bytes);
    let rep = inline(inout p);
    let mut report_words: ChunkSeq[u64] = ChunkSeq::new[u64]();
    put_report(in p, in rep, inout report_words);
    let mut words: ChunkSeq[u64] = ChunkSeq::new[u64]();
    words.push(report_words.len());
    words.extend(in report_words.as_slice());
    put_program_words(in p, inout words);
    words
}

// What `inline_entry` returns, by its first input word.
const MODE_REPORT: u64 = 0;
const MODE_DUMP: u64 = 1;
const MODE_INPUT: u64 = 2;
const MODE_PROGRAM: u64 = 3;

// The harness's one entry: the first word picks the result, the rest is
// the inliner's input.
// - 0: the report and every function's size and cost after inlining;
// - 1: the inlined program as text (`dump`);
// - 2: the input program as text, not inlined (the decoder's round trip);
// - 3: the report's length and words, then the inlined program as words
//   (`put_program_words`), which the hybrid's `inline` hook reads back.
pub fn inline_entry(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mode = match bytes.try_read_u64_le(0) {
        Option::Some(first_word) => first_word,
        Option::None => MODE_REPORT,
    };
    if mode == MODE_PROGRAM {
        return inline_program_words(in bytes[8..bytes.len()]);
    }
    let mut p = read_input(in bytes[8..bytes.len()]);
    if mode == MODE_INPUT {
        let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
        put_dump(in p, inout out);
        return pack(in out);
    }
    let rep = inline(inout p);
    if mode == MODE_DUMP {
        let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
        put_dump(in p, inout out);
        return pack(in out);
    }
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    put_report(in p, in rep, inout out);
    out
}
