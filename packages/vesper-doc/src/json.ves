// `vesper_doc::to_json`: serde_json's `to_writer_pretty` into the bounded
// writer, then one newline.
//
// The input is the compact serialization of the same value
// (`serde_json::to_vec`), which differs from the pretty one only in the
// whitespace between tokens: strings and numbers are the same bytes. The
// pretty writer (serde_json's `PrettyFormatter`, two-space indent) puts each
// element of a non-empty array or object on its own line at the nesting
// depth, writes `": "` after a key, and writes an empty array or object as
// `[]` or `{}`. It has no depth limit, so neither has this rewrite.

const QUOTE: u8 = 34;
const BACKSLASH: u8 = 92;
const LBRACKET: u8 = 91;
const RBRACKET: u8 = 93;
const LBRACE: u8 = 123;
const RBRACE: u8 = 125;
const COMMA: u8 = 44;
const COLON: u8 = 58;
const SPACE: u8 = 32;
const NEWLINE: u8 = 10;

// Status words of `pretty`.
pub const PRETTY_OK: u64 = 0;
// The pretty text does not fit: serde_json's write error,
// "bounded JSON output: output byte budget exceeded".
pub const PRETTY_TEXT_OVER: u64 = 1;
// The text fits but its final newline does not:
// "output byte budget exceeded".
pub const PRETTY_NEWLINE_OVER: u64 = 2;

fn byte(in b: Slice[u8], i: u64) -> u8 {
    match b.try_get(i) {
        Option::Some(c) => c,
        Option::None => 0,
    }
}

fn line(inout out: ChunkSeq[u8], depth: u64) {
    out.push(NEWLINE);
    for _i in 0..depth {
        out.push(SPACE);
        out.push(SPACE);
    }
}

// Appends the pretty text of the compact JSON `b[from..to]`, and its final
// newline, to `out`. Returns a `PRETTY_*` status; on failure `out` holds
// part of the text. The budget is checked at every line break, so `out`
// never grows far past `max`.
pub fn pretty(in b: Slice[u8], from: u64, to: u64, max: u64, inout out: ChunkSeq[u8]) -> u64 {
    let base = out.len();
    let mut depth: u64 = 0;
    let mut i = from;
    loop {
        if i >= to {
            break;
        }
        let c = byte(in b, i);
        if c == QUOTE {
            // A string: copied through its closing quote, escapes and all.
            out.push(c);
            i = wrapping_add(i, 1);
            loop {
                if i >= to {
                    break;
                }
                let s = byte(in b, i);
                out.push(s);
                i = wrapping_add(i, 1);
                if s == BACKSLASH {
                    if i < to {
                        out.push(byte(in b, i));
                        i = wrapping_add(i, 1);
                    }
                } else if s == QUOTE {
                    break;
                }
            }
        } else if c == LBRACKET || c == LBRACE {
            let next = byte(in b, wrapping_add(i, 1));
            if next == RBRACKET || next == RBRACE {
                out.push(c);
                out.push(next);
                i = wrapping_add(i, 2);
            } else {
                out.push(c);
                depth = wrapping_add(depth, 1);
                line(inout out, depth);
                i = wrapping_add(i, 1);
            }
        } else if c == RBRACKET || c == RBRACE {
            depth = wrapping_sub(depth, 1);
            line(inout out, depth);
            out.push(c);
            i = wrapping_add(i, 1);
        } else if c == COMMA {
            out.push(c);
            line(inout out, depth);
            i = wrapping_add(i, 1);
        } else if c == COLON {
            out.push(c);
            out.push(SPACE);
            i = wrapping_add(i, 1);
        } else {
            out.push(c);
            i = wrapping_add(i, 1);
        }
        if wrapping_sub(out.len(), base) > max {
            return PRETTY_TEXT_OVER;
        }
    }
    if wrapping_sub(out.len(), base) >= max {
        return PRETTY_NEWLINE_OVER;
    }
    out.push(NEWLINE);
    PRETTY_OK
}
