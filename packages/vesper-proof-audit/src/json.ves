// JSON text as serde_json writes it: `to_vec` (compact) and
// `to_string_pretty` (two-space indent, `"key": value`, `[]` and `{}` for
// empty containers). Strings escape `"`, `\`, `\b`, `\f`, `\n`, `\r`,
// `\t` and the other control bytes as `\u00xx`; everything else, UTF-8
// included, is copied.
use self::strs::{
    BACKSLASH, BACKSPACE, CARRIAGE_RETURN, CLOSE_BRACE, CLOSE_BRACKET, COLON, COMMA, DIGIT_ZERO,
    FORM_FEED, HEX_LETTER_BASE, LOWER_B, LOWER_F, LOWER_N, LOWER_R, LOWER_T, LOWER_U, NEWLINE,
    OPEN_BRACE, OPEN_BRACKET, QUOTE, SPACE, TAB
};
pub struct Json {
    pub out: ChunkSeq[u8],
    pretty: bool,
    depth: u64,
    // Nothing written yet in the container just opened.
    fresh: bool,
    // A key was just written: its value follows with no separator.
    keyed: bool,
}

pub fn json_new(pretty: bool) -> Json {
    Json { out: ChunkSeq::new[u8](), pretty: pretty, depth: 0, fresh: true, keyed: false }
}

fn newline(inout j: Json) {
    j.out.push(NEWLINE);
    for _i in 0..j.depth {
        j.out.push(SPACE);
        j.out.push(SPACE);
    }
}

// What comes before an array element or an object key.
fn element(inout j: Json) {
    if j.keyed {
        j.keyed = false;
        return;
    }
    if j.depth == 0 {
        return;
    }
    if !j.fresh {
        j.out.push(COMMA);
    }
    if j.pretty {
        newline(inout j);
    }
    j.fresh = false;
}

pub fn begin_object(inout j: Json) {
    element(inout j);
    j.out.push(OPEN_BRACE);
    j.depth = wrapping_add(j.depth, 1);
    j.fresh = true;
}

pub fn end_object(inout j: Json) {
    j.depth = wrapping_sub(j.depth, 1);
    if !j.fresh && j.pretty {
        newline(inout j);
    }
    j.out.push(CLOSE_BRACE);
    j.fresh = false;
}

pub fn begin_array(inout j: Json) {
    element(inout j);
    j.out.push(OPEN_BRACKET);
    j.depth = wrapping_add(j.depth, 1);
    j.fresh = true;
}

pub fn end_array(inout j: Json) {
    j.depth = wrapping_sub(j.depth, 1);
    if !j.fresh && j.pretty {
        newline(inout j);
    }
    j.out.push(CLOSE_BRACKET);
    j.fresh = false;
}

pub fn key(inout j: Json, in k: Str) {
    element(inout j);
    put_string(inout j.out, in k.as_bytes());
    j.out.push(COLON);
    if j.pretty {
        j.out.push(SPACE);
    }
    j.keyed = true;
}

fn hex_digit(n: u8) -> u8 {
    if n < 10 {
        wrapping_add(n, DIGIT_ZERO)
    } else {
        wrapping_add(n, HEX_LETTER_BASE)
    }
}

// `s` as a JSON string, serde_json's escapes.
pub fn put_string(inout out: ChunkSeq[u8], in s: Slice[u8]) {
    out.push(QUOTE);
    for i in 0..s.len() {
        let b = s.try_get(i).unwrap_or(0);
        if b == QUOTE {
            out.push(BACKSLASH);
            out.push(QUOTE);
        } else if b == BACKSLASH {
            out.push(BACKSLASH);
            out.push(BACKSLASH);
        } else if b == NEWLINE {
            out.push(BACKSLASH);
            out.push(LOWER_N);
        } else if b == CARRIAGE_RETURN {
            out.push(BACKSLASH);
            out.push(LOWER_R);
        } else if b == TAB {
            out.push(BACKSLASH);
            out.push(LOWER_T);
        } else if b == BACKSPACE {
            out.push(BACKSLASH);
            out.push(LOWER_B);
        } else if b == FORM_FEED {
            out.push(BACKSLASH);
            out.push(LOWER_F);
        } else if b < SPACE {
            out.push(BACKSLASH);
            out.push(LOWER_U);
            out.push(DIGIT_ZERO);
            out.push(DIGIT_ZERO);
            out.push(hex_digit(b >> 4));
            out.push(hex_digit(b & 15));
        } else {
            out.push(b);
        }
    }
    out.push(QUOTE);
}

pub fn string(inout j: Json, in s: Slice[u8]) {
    element(inout j);
    put_string(inout j.out, in s);
}

pub fn put_u64(inout out: ChunkSeq[u8], n: u64) {
    if n == 0 {
        out.push(DIGIT_ZERO);
        return;
    }
    let mut digits: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut m = n;
    loop {
        if m == 0 {
            break;
        }
        digits.push(wrapping_add(wrapping_u8(m % 10), DIGIT_ZERO));
        m = m / 10;
    }
    let mut i = digits.len();
    loop {
        if i == 0 {
            break;
        }
        i = wrapping_sub(i, 1);
        out.push(digits.try_get(i).unwrap_or(DIGIT_ZERO));
    }
}

pub fn number(inout j: Json, n: u64) {
    element(inout j);
    put_u64(inout j.out, n);
}

pub fn boolean(inout j: Json, b: bool) {
    element(inout j);
    if b {
        j.out.extend(in "true".as_bytes());
    } else {
        j.out.extend(in "false".as_bytes());
    }
}

pub fn null(inout j: Json) {
    element(inout j);
    j.out.extend(in "null".as_bytes());
}

// `"k": "v"`.
pub fn field_string(inout j: Json, in k: Str, in v: Slice[u8]) {
    key(inout j, in k);
    string(inout j, in v);
}

pub fn field_u64(inout j: Json, in k: Str, n: u64) {
    key(inout j, in k);
    number(inout j, n);
}

pub fn field_bool(inout j: Json, in k: Str, b: bool) {
    key(inout j, in k);
    boolean(inout j, b);
}
