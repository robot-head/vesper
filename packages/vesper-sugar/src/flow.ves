// `sugar_expand::template::flow`: scope and control-flow analysis of a
// template skeleton, a transliteration of
// crates/vesper-syntax/src/sugar_expand/template/flow.rs and of
// `Rendered::hole` and `permission` in template.rs.
//
// The skeleton is parsed as the body of `fn template_body() {..}` by the
// core parser, else by the template-scopes profile (@vesper/ast
// `lower_source`, `lower_template_source`). The walk renames the
// template's own binders to fresh names and plans single evaluation of
// captured expressions; `emit` then applies those edits and substitutes
// the captured text.
//
// Rust's maps and vectors become tables: nodes (`nd_*`), usages, edits
// and declarations are rows, renaming texts live in one byte pool, and an
// environment entry names its fresh name by purpose and number.

use @vesper/ast::{
    Ast, ArgNode, ClauseNode, ConfNode, ExprNode, FnNode, ImplNode, ItemNode, ParamNode, PatNode,
    StmtNode, TraitNode, expr_at, list_at, list_len, none, pat_at
};
use @vesper/ast::lower::{lower_source, lower_template_source};
use @vesper-std/arena::{idx_from_raw};
use @vesper-std/intern::{symbol_from_id};
use @vesper/front::lex::{lex_raw, token_end, trivia_kind};
use @vesper/front::diag::{diags_new};
use @vesper/front::kinds::{
    k_colon, k_comma, k_eof, k_fat_arrow, k_inout, k_let, k_l_paren, k_r_paren, k_semi, k_sink
};
use self::template::{
    Caps, Sk, add, b8, cap_at, inc, push_decimal, push_range, sort_in, sub, text_is, value_at, w32,
    w64
};

const NONE: u64 = 18446744073709551615;
const PREFIX: Str = "fn template_body() {";
const PREFIX_LEN: u64 = 20;

// Edges.
const E_ALWAYS: u64 = 0;
const E_BRANCH: u64 = 1;
const E_CONDITIONAL: u64 = 2;
const E_REPEATED: u64 = 3;

// Fresh-name purposes.
const F_LOCAL: u64 = 0;
const F_PARAM: u64 = 1;
const F_ONCE: u64 = 2;

// Passes (`SugarPass`), 0 for none.
const S_IN: u64 = 1;
const S_INOUT: u64 = 2;
const S_OUT: u64 = 3;
const S_SINK: u64 = 4;

// Node rows: parent (or NONE), edge, start, end, statement start (or
// NONE), earlier effect.
const NW: u64 = 6;

pub struct Fx {
    failed: bool,
    msg: ChunkSeq[u8],
    // The parsed text (`source`) and its core tokens: rows of kind,
    // start, end.
    src: ChunkSeq[u8],
    tk: ChunkSeq[u64],
    // Spans of the CST's nested sugar and macro calls: start, end pairs.
    nested: ChunkSeq[u64],
    nodes: ChunkSeq[u64],
    // Usages of the walked function: rows of hole, slot, node.
    us: ChunkSeq[u64],
    // Per slot: written (1), and its memo (0 none, else the number of its
    // `once` name) and laziness.
    writes: ChunkSeq[u8],
    memo: ChunkSeq[u64],
    lazy: ChunkSeq[u8],
    // Renamings (`literals`): rows of start, end, text first, text length
    // in `pool`, in key order.
    lits: ChunkSeq[u64],
    pool: ChunkSeq[u8],
    // Declarations: rows of start, end (or NONE), hole, number, lazy.
    decls: ChunkSeq[u64],
    fresh: u64,
    mark: ChunkSeq[u8]
}

fn fail(inout f: Fx, in text: Slice[u8]) {
    if !f.failed {
        f.failed = true;
        f.msg.clear();
        f.msg.extend(in text);
    }
}

// ---------------------------------------------------------------- tokens

fn ntok(in f: Fx) -> u64 {
    f.tk.len() / 3
}

fn tok_k(in f: Fx, i: u64) -> u8 {
    wrapping_u8(w64(in f.tk, wrapping_mul(i, 3)))
}

fn tok_s(in f: Fx, i: u64) -> u64 {
    w64(in f.tk, inc(wrapping_mul(i, 3)))
}

fn tok_e(in f: Fx, i: u64) -> u64 {
    w64(in f.tk, add(wrapping_mul(i, 3), 2))
}

fn lex_rows(in text: ChunkSeq[u8]) -> ChunkSeq[u64] {
    let mut diags = diags_new();
    let raw = lex_raw(in text.as_slice(), inout diags);
    let mut out = ChunkSeq::new[u64]();
    for i in 0..raw.kind.len() {
        out.push(widen_u64(b8(in raw.kind, i)));
        out.push(w32(in raw.start, i));
        out.push(token_end(in raw, i));
    }
    out
}

// `tokens.partition_point(|t| t.span.end <= at)`.
fn tokens_before(in f: Fx, at: u64) -> u64 {
    let mut lo: u64 = 0;
    let mut hi = ntok(in f);
    loop {
        if lo >= hi {
            break;
        }
        let mid = add(lo, (sub(hi, lo)) >> 1);
        if tok_e(in f, mid) <= at {
            lo = inc(mid);
        } else {
            hi = mid;
        }
    }
    lo
}

// ---------------------------------------------------------------- names

pub fn name_len(in a: Ast, sym: u32) -> u64 {
    let (start, end) = a.names.span(symbol_from_id(sym));
    sub(end, start)
}

pub fn name_byte(in a: Ast, sym: u32, j: u64) -> u8 {
    let (start, _) = a.names.span(symbol_from_id(sym));
    match a.names.text_byte(add(start, j)) {
        Option::Some(byte) => byte,
        Option::None => 0,
    }
}

fn starts_with_mark(in f: Fx, in a: Ast, sym: u32) -> bool {
    if name_len(in a, sym) < f.mark.len() {
        return false;
    }
    for j in 0..f.mark.len() {
        if name_byte(in a, sym, j) != b8(in f.mark, j) {
            return false;
        }
    }
    true
}

pub fn name_is(in a: Ast, sym: u32, in text: Slice[u8]) -> bool {
    if name_len(in a, sym) != text.len() {
        return false;
    }
    for j in 0..text.len() {
        let byte = match text.try_get(j) {
            Option::Some(byte) => byte,
            Option::None => 0,
        };
        if name_byte(in a, sym, j) != byte {
            return false;
        }
    }
    true
}

// `self.slice(r) == name`: the skeleton text at the source range `s..e`.
fn slice_is(in f: Fx, in sk: Sk, start: u64, end: u64, in a: Ast, sym: u32) -> bool {
    if start < PREFIX_LEN || end < PREFIX_LEN || end < start {
        return name_len(in a, sym) == 0;
    }
    let rel_start = sub(start, PREFIX_LEN);
    let rel_end = sub(end, PREFIX_LEN);
    if rel_end > sk.src.len() {
        return name_len(in a, sym) == 0;
    }
    if sub(rel_end, rel_start) != name_len(in a, sym) {
        return false;
    }
    for j in 0..sub(rel_end, rel_start) {
        if b8(in sk.src, add(rel_start, j)) != name_byte(in a, sym, j) {
            return false;
        }
    }
    true
}

// The text of a fresh name: mark, purpose, number.
fn push_fresh(inout out: ChunkSeq[u8], in mark: ChunkSeq[u8], purpose: u64, n: u64) {
    out.extend(in mark.as_slice());
    if purpose == F_LOCAL {
        out.extend(in "local".as_bytes());
    } else if purpose == F_PARAM {
        out.extend(in "param".as_bytes());
    } else {
        out.extend(in "once".as_bytes());
    }
    push_decimal(inout out, n);
}

fn fresh(inout f: Fx) -> u64 {
    f.fresh = inc(f.fresh);
    f.fresh
}

fn push_name(inout out: ChunkSeq[u8], in a: Ast, sym: u32) {
    for j in 0..name_len(in a, sym) {
        out.push(name_byte(in a, sym, j));
    }
}

// `self.rename(r, text)`: a renaming of the skeleton's `s..e` (source
// offsets), replacing any earlier one of the same range.
fn rename(inout f: Fx, in sk: Sk, start: u64, end: u64, in text: ChunkSeq[u8]) {
    if start < PREFIX_LEN || end > add(PREFIX_LEN, sk.src.len()) {
        return;
    }
    let rel_start = sub(start, PREFIX_LEN);
    let rel_end = sub(end, PREFIX_LEN);
    let first = f.pool.len();
    f.pool.extend(in text.as_slice());
    let n = f.lits.len() >> 2;
    let mut at = n;
    for i in 0..n {
        let row_start = w64(in f.lits, i << 2);
        let row_end = w64(in f.lits, inc(i << 2));
        if row_start == rel_start && row_end == rel_end {
            f.lits.try_set(add(i << 2, 2), first);
            f.lits.try_set(add(i << 2, 3), text.len());
            return;
        }
        if row_start > rel_start || row_start == rel_start && row_end > rel_end {
            at = i;
            break;
        }
    }
    for k in 0..4 {
        f.lits.push(0);
    }
    let mut row = n;
    loop {
        if row <= at {
            break;
        }
        for k in 0..4 {
            f.lits.try_set(add(row << 2, k), w64(in f.lits, add(sub(row, 1) << 2, k)));
        }
        row = sub(row, 1);
    }
    f.lits.try_set(at << 2, rel_start);
    f.lits.try_set(inc(at << 2), rel_end);
    f.lits.try_set(add(at << 2, 2), first);
    f.lits.try_set(add(at << 2, 3), text.len());
}

// `self.slot(start)`: the slot whose marker starts at source offset
// `start`, or NONE.
fn slot_at(in f: Fx, in sk: Sk, start: u64) -> u64 {
    if start < PREFIX_LEN {
        return NONE;
    }
    let rel_start = sub(start, PREFIX_LEN);
    let n = sk.slots.len() / 3;
    let mut lo: u64 = 0;
    let mut hi = n;
    loop {
        if lo >= hi {
            return NONE;
        }
        let mid = add(lo, sub(hi, lo) >> 1);
        let slot_start = w64(in sk.slots, inc(wrapping_mul(mid, 3)));
        if slot_start == rel_start {
            return mid;
        }
        if slot_start < rel_start {
            lo = inc(mid);
        } else {
            hi = mid;
        }
    }
}

fn slot_hole(in sk: Sk, slot: u64) -> u64 {
    w64(in sk.slots, wrapping_mul(slot, 3))
}

fn hole_cap(in sk: Sk, hole: u64) -> u64 {
    w64(in sk.holes, hole << 2)
}

fn cap_pass(in c: Caps, cap: u64) -> u64 {
    cap_at(in c, cap, 2)
}

// `permission(hole)`: 0 for none, else the pass; `invalid` for a place
// whose pass does not parse.
fn permission(in c: Caps, in sk: Sk, hole: u64) -> u64 {
    let cap = hole_cap(in sk, hole);
    if sort_in(in c, cap, in "expr".as_bytes()) {
        return S_IN;
    }
    if sort_in(in c, cap, in "place".as_bytes()) {
        let pass = cap_pass(in c, cap);
        return if pass == 0 { S_IN } else { pass };
    }
    0
}

fn permits(floor: u64, requested: u64) -> bool {
    floor == requested
        || floor == S_INOUT && requested == S_IN
        || floor == S_SINK && (requested == S_IN || requested == S_INOUT)
}

fn pass_name(inout message: ChunkSeq[u8], pass: u64) {
    if pass == S_IN {
        message.extend(in "In".as_bytes());
    } else if pass == S_INOUT {
        message.extend(in "Inout".as_bytes());
    } else if pass == S_OUT {
        message.extend(in "Out".as_bytes());
    } else {
        message.extend(in "Sink".as_bytes());
    }
}

// ---------------------------------------------------------------- nodes

fn nd(in f: Fx, node: u64, field: u64) -> u64 {
    w64(in f.nodes, add(wrapping_mul(node, NW), field))
}

fn nd_set(inout f: Fx, node: u64, field: u64, value: u64) {
    f.nodes.try_set(add(wrapping_mul(node, NW), field), value);
}

fn push_node(inout f: Fx, parent: u64, edge: u64, start: u64, end: u64) -> u64 {
    let id = f.nodes.len() / NW;
    f.nodes.push(parent);
    f.nodes.push(edge);
    f.nodes.push(start);
    f.nodes.push(end);
    f.nodes.push(NONE);
    f.nodes.push(0);
    id
}

fn node_count(in f: Fx) -> u64 {
    f.nodes.len() / NW
}

fn is_nested(in f: Fx, start: u64, end: u64) -> bool {
    for i in 0..(f.nested.len() >> 1) {
        if w64(in f.nested, i << 1) == start && w64(in f.nested, inc(i << 1)) == end {
            return true;
        }
    }
    false
}

// ---------------------------------------------------------------- AST

pub fn stmt_of(in a: Ast, i: u32) -> StmtNode {
    a.stmts.get_or(
        idx_from_raw[StmtNode](i),
        StmtNode { kind: 0, pat: none(), ty: none(), value: none(), mutable: false }
    )
}

pub fn arg_of(in a: Ast, i: u32) -> ArgNode {
    a.args.get_or(idx_from_raw[ArgNode](i), ArgNode { pass: 0, explicit: false, expr: none() })
}

pub fn clause_of(in a: Ast, i: u32) -> ClauseNode {
    a.clauses
        .get_or(idx_from_raw[ClauseNode](i), ClauseNode { name: none(), pats: 0, body: none() })
}

pub fn param_of(in a: Ast, i: u32) -> ParamNode {
    a.params.get_or(
        idx_from_raw[ParamNode](i),
        ParamNode { name: none(), pass: 0, projections: 0, ty: none(), start: 0, end: 0 }
    )
}

pub fn fn_of(in a: Ast, i: u32) -> FnNode {
    a.fns.get_or(
        idx_from_raw[FnNode](i),
        FnNode {
            name: none(),
            fip: false,
            generics: 0,
            params: 0,
            result: none(),
            effects: none(),
            body: none(),
            start: 0,
            end: 0
        }
    )
}

pub fn es(in a: Ast, expr: u32) -> u64 {
    widen_u64(expr_at(in a, expr).start)
}

pub fn ee(in a: Ast, expr: u32) -> u64 {
    widen_u64(expr_at(in a, expr).end)
}

// `self.inert(e)`.
fn inert(in f: Fx, in a: Ast, expr: u32) -> bool {
    let expr_node = expr_at(in a, expr);
    if expr_node.kind == 1 {
        return true;
    }
    expr_node.kind == 2 && !starts_with_mark(in f, in a, expr_node.a)
}

// ---------------------------------------------------------------- environment

// Environment rows: old name (symbol), purpose, number.
fn env_push(inout env: ChunkSeq[u64], sym: u32, purpose: u64, num: u64) {
    env.push(widen_u64(sym));
    env.push(purpose);
    env.push(num);
}

fn env_len(in env: ChunkSeq[u64]) -> u64 {
    env.len() / 3
}

fn env_truncate(inout env: ChunkSeq[u64], n: u64) {
    env.truncate(wrapping_mul(n, 3));
}

// The newest entry of `sym`, or NONE.
fn env_find(in env: ChunkSeq[u64], sym: u32) -> u64 {
    let mut entry = env_len(in env);
    loop {
        if entry == 0 {
            return NONE;
        }
        entry = sub(entry, 1);
        if w64(in env, wrapping_mul(entry, 3)) == widen_u64(sym) {
            return entry;
        }
    }
}

// ---------------------------------------------------------------- patterns

// `self.shorthand(name, r)`.
fn shorthand(in f: Fx, in sk: Sk, in a: Ast, sym: u32, start: u64, end: u64) -> bool {
    if !slice_is(in f, in sk, start, end, in a, sym) {
        return false;
    }
    let mut tok = tokens_before(in f, start);
    loop {
        if tok == 0 {
            return true;
        }
        tok = sub(tok, 1);
        if !trivia_kind(tok_k(in f, tok)) {
            return tok_k(in f, tok) != k_colon();
        }
    }
}

// `self.pattern_using(p, env, shorthand, alternatives)`.
fn pattern_using(
    inout f: Fx,
    in sk: Sk,
    in a: Ast,
    pat: u32,
    inout env: ChunkSeq[u64],
    short: bool,
    in alts: ChunkSeq[u64]
) {
    let pat_node = pat_at(in a, pat);
    let start = widen_u64(pat_node.start);
    let end = widen_u64(pat_node.end);
    if pat_node.kind == 2 {
        if starts_with_mark(in f, in a, pat_node.a)
            || !slice_is(in f, in sk, start, end, in a, pat_node.a) {
            return;
        }
        let found = env_find(in alts, pat_node.a);
        let (purpose, num) = if found != NONE {
            (
                w64(in alts, inc(wrapping_mul(found, 3))),
                w64(in alts, add(wrapping_mul(found, 3), 2))
            )
        } else {
            (F_LOCAL, fresh(inout f))
        };
        let mut text = ChunkSeq::new[u8]();
        if short {
            push_name(inout text, in a, pat_node.a);
            text.extend(in ": ".as_bytes());
        }
        push_fresh(inout text, in f.mark, purpose, num);
        rename(inout f, in sk, start, end, in text);
        env_push(inout env, pat_node.a, purpose, num);
    } else if pat_node.kind == 4 {
        for i in 0..list_len(in a, pat_node.a) {
            pattern_using(
                inout f,
                in sk,
                in a,
                list_at(in a, pat_node.a, i),
                inout env,
                false,
                in alts
            );
        }
    } else if pat_node.kind == 5 {
        let named = pat_node.c == 1;
        for i in 0..(list_len(in a, pat_node.b) >> 1) {
            let fname = list_at(in a, pat_node.b, i << 1);
            let field_pat = list_at(in a, pat_node.b, inc(i << 1));
            let field_pat_node = pat_at(in a, field_pat);
            let field_short = named
                && shorthand(
                    in f,
                    in sk,
                    in a,
                    fname,
                    widen_u64(field_pat_node.start),
                    widen_u64(field_pat_node.end)
                );
            pattern_using(inout f, in sk, in a, field_pat, inout env, field_short, in alts);
        }
    }
}

fn pattern(inout f: Fx, in sk: Sk, in a: Ast, pat: u32, inout env: ChunkSeq[u64]) {
    let none_alts = ChunkSeq::new[u64]();
    pattern_using(inout f, in sk, in a, pat, inout env, false, in none_alts);
}

// ---------------------------------------------------------------- places

// `self.place(e, use_mode)`.
fn place(inout f: Fx, in sk: Sk, in c: Caps, in a: Ast, expr: u32, mode: u64) {
    let mut base = expr;
    loop {
        let base_node = expr_at(in a, base);
        if base_node.kind != 7 && base_node.kind != 8 {
            break;
        }
        base = base_node.a;
    }
    let slot = slot_at(in f, in sk, es(in a, base));
    if slot == NONE {
        return;
    }
    let hole = slot_hole(in sk, slot);
    let floor = permission(in c, in sk, hole);
    if floor == 0 {
        return;
    }
    if !permits(floor, mode) {
        let mut message = ChunkSeq::new[u8]();
        message.extend(in "sugar template upgrades a ".as_bytes());
        pass_name(inout message, floor);
        message.extend(in " capture to ".as_bytes());
        pass_name(inout message, mode);
        fail(inout f, in message.as_slice());
        return;
    }
    if mode != S_IN {
        f.writes.try_set(slot, 1);
    }
}

// `self.nested_place(operand)`.
fn nested_place(inout f: Fx, in sk: Sk, in c: Caps, in a: Ast, expr: u32) {
    let mut tok = tokens_before(in f, es(in a, expr));
    loop {
        if tok == 0 {
            return;
        }
        tok = sub(tok, 1);
        let kind = tok_k(in f, tok);
        if !trivia_kind(kind) && kind != k_l_paren() {
            break;
        }
    }
    let start = tok_s(in f, tok);
    let end = tok_e(in f, tok);
    let mode = pass_of_slice(in f, in sk, start, end);
    if mode != 0 {
        place(inout f, in sk, in c, in a, expr, mode);
    }
}

// `self.slice(r).parse::<SugarPass>()`: the pass, or 0.
fn pass_of_slice(in f: Fx, in sk: Sk, start: u64, end: u64) -> u64 {
    if start < PREFIX_LEN || end < start || sub(end, PREFIX_LEN) > sk.src.len() {
        return 0;
    }
    let mut text = ChunkSeq::new[u8]();
    push_range(inout text, in sk.src, sub(start, PREFIX_LEN), sub(end, PREFIX_LEN));
    if bytes_eq(in text, in "in".as_bytes()) {
        S_IN
    } else if bytes_eq(in text, in "inout".as_bytes()) {
        S_INOUT
    } else if bytes_eq(in text, in "out".as_bytes()) {
        S_OUT
    } else if bytes_eq(in text, in "sink".as_bytes()) {
        S_SINK
    } else {
        0
    }
}

fn bytes_eq(in left: ChunkSeq[u8], in right: Slice[u8]) -> bool {
    if left.len() != right.len() {
        return false;
    }
    for j in 0..left.len() {
        let byte = match right.try_get(j) {
            Option::Some(byte) => byte,
            Option::None => 0,
        };
        if b8(in left, j) != byte {
            return false;
        }
    }
    true
}

// ---------------------------------------------------------------- walk

fn walk_kids_tuple(
    inout f: Fx,
    in sk: Sk,
    in c: Caps,
    in a: Ast,
    list: u32,
    parent: u64,
    nested: bool,
    operand_edge: u64,
    inout env: ChunkSeq[u64]
) {
    let mut earlier = false;
    for i in 0..list_len(in a, list) {
        let elem = list_at(in a, list, i);
        let child = node_count(in f);
        let edge = if nested && expr_at(in a, elem).kind == 5 {
            E_REPEATED
        } else {
            operand_edge
        };
        walk(inout f, in sk, in c, in a, elem, parent, edge, inout env);
        if f.failed {
            return;
        }
        nd_set(inout f, child, 5, if earlier { 1 } else { 0 });
        earlier = earlier || !inert(in f, in a, elem);
    }
}

fn set_earlier(inout f: Fx, child: u64, earlier: bool) {
    nd_set(inout f, child, 5, if earlier { 1 } else { 0 });
}

// `self.walk(e, parent, edge, env)`.
fn walk(
    inout f: Fx,
    in sk: Sk,
    in c: Caps,
    in a: Ast,
    expr: u32,
    parent_in: u64,
    edge: u64,
    inout env: ChunkSeq[u64]
) {
    if f.failed {
        return;
    }
    let expr_node = expr_at(in a, expr);
    let start = widen_u64(expr_node.start);
    let end = widen_u64(expr_node.end);
    let node = push_node(inout f, parent_in, edge, start, end);
    let parent = node;
    let nested = is_nested(in f, start, end);
    let operand_edge = if nested { E_CONDITIONAL } else { E_ALWAYS };
    let outer = env_len(in env);
    let kind = expr_node.kind;
    if kind == 2 {
        let slot = slot_at(in f, in sk, start);
        if slot != NONE {
            let hole = slot_hole(in sk, slot);
            // `marker == n`: the mark, then the hole number.
            let mut marker = ChunkSeq::new[u8]();
            marker.extend(in f.mark.as_slice());
            push_decimal(inout marker, hole);
            if name_is(in a, expr_node.a, in marker.as_slice()) {
                f.us.push(hole);
                f.us.push(slot);
                f.us.push(node);
            }
        } else {
            let found = env_find(in env, expr_node.a);
            if found != NONE && slice_is(in f, in sk, start, end, in a, expr_node.a) {
                let mut text = ChunkSeq::new[u8]();
                push_fresh(
                    inout text,
                    in f.mark,
                    w64(in env, inc(wrapping_mul(found, 3))),
                    w64(in env, add(wrapping_mul(found, 3), 2))
                );
                rename(inout f, in sk, start, end, in text);
            }
        }
    } else if kind == 1 || kind == 22 {
        // Literal, Continue.
    } else if kind == 3 {
        walk_kids_tuple(
            inout f,
            in sk,
            in c,
            in a,
            expr_node.a,
            parent,
            nested,
            operand_edge,
            inout env
        );
    } else if kind == 4 {
        let mut earlier = false;
        for i in 0..(list_len(in a, expr_node.b) >> 1) {
            let fname = list_at(in a, expr_node.b, i << 1);
            let field_value = list_at(in a, expr_node.b, inc(i << 1));
            let child = node_count(in f);
            walk(inout f, in sk, in c, in a, field_value, parent, E_ALWAYS, inout env);
            if f.failed {
                return;
            }
            set_earlier(inout f, child, earlier);
            earlier = earlier || !inert(in f, in a, field_value);
            let value_start = es(in a, field_value);
            if shorthand(in f, in sk, in a, fname, value_start, ee(in a, field_value))
                && value_start >= PREFIX_LEN {
                let rel_start = sub(value_start, PREFIX_LEN);
                let rel_end = add(rel_start, name_len(in a, fname));
                for lit in 0..(f.lits.len() >> 2) {
                    if w64(in f.lits, lit << 2) == rel_start
                        && w64(in f.lits, inc(lit << 2)) == rel_end {
                        let first = w64(in f.lits, add(lit << 2, 2));
                        let len = w64(in f.lits, add(lit << 2, 3));
                        let mut text = ChunkSeq::new[u8]();
                        push_name(inout text, in a, fname);
                        text.extend(in ": ".as_bytes());
                        push_range(inout text, in f.pool, first, add(first, len));
                        let new_first = f.pool.len();
                        f.pool.extend(in text.as_slice());
                        f.lits.try_set(add(lit << 2, 2), new_first);
                        f.lits.try_set(add(lit << 2, 3), text.len());
                        break;
                    }
                }
            }
        }
    } else if kind == 5 {
        let block_start = inc(start);
        let mut after = block_start;
        for i in 0..list_len(in a, expr_node.a) {
            let stmt = stmt_of(in a, list_at(in a, expr_node.a, i));
            let first = node_count(in f);
            if stmt.kind == 1 {
                walk(inout f, in sk, in c, in a, stmt.value, parent, operand_edge, inout env);
                if f.failed {
                    return;
                }
                pattern(inout f, in sk, in a, stmt.pat, inout env);
            } else {
                if nested {
                    nested_place(inout f, in sk, in c, in a, stmt.value);
                    if f.failed {
                        return;
                    }
                }
                let inner_edge = if nested && expr_at(in a, stmt.value).kind == 5 {
                    E_REPEATED
                } else {
                    operand_edge
                };
                walk(inout f, in sk, in c, in a, stmt.value, parent, inner_edge, inout env);
                if f.failed {
                    return;
                }
            }
            set_earlier(inout f, first, after != block_start);
            if !nested {
                after = statement(inout f, first, after);
            }
        }
        if expr_node.b != none() {
            let first = node_count(in f);
            walk(inout f, in sk, in c, in a, expr_node.b, parent, E_ALWAYS, inout env);
            if f.failed {
                return;
            }
            set_earlier(inout f, first, after != block_start);
            statement(inout f, first, after);
        }
    } else if kind == 6 {
        walk(inout f, in sk, in c, in a, expr_node.a, parent, E_ALWAYS, inout env);
        if f.failed {
            return;
        }
        let mut earlier = !inert(in f, in a, expr_node.a);
        for i in 0..list_len(in a, expr_node.c) {
            let arg = arg_of(in a, list_at(in a, expr_node.c, i));
            if arg.explicit {
                let mode = if arg.pass == 0 {
                    S_IN
                } else if arg.pass == 1 {
                    S_INOUT
                } else {
                    S_SINK
                };
                place(inout f, in sk, in c, in a, arg.expr, mode);
                if f.failed {
                    return;
                }
            }
            let child = node_count(in f);
            walk(inout f, in sk, in c, in a, arg.expr, parent, E_ALWAYS, inout env);
            if f.failed {
                return;
            }
            set_earlier(inout f, child, earlier);
            earlier = earlier || !inert(in f, in a, arg.expr);
        }
    } else if kind == 7 || kind == 9 {
        walk(inout f, in sk, in c, in a, expr_node.a, parent, E_ALWAYS, inout env);
    } else if kind == 10 {
        walk(inout f, in sk, in c, in a, expr_node.b, parent, E_ALWAYS, inout env);
    } else if kind == 8 || kind == 19 {
        walk(inout f, in sk, in c, in a, expr_node.a, parent, E_ALWAYS, inout env);
        if f.failed {
            return;
        }
        let child = node_count(in f);
        walk(inout f, in sk, in c, in a, expr_node.b, parent, E_ALWAYS, inout env);
        set_earlier(inout f, child, !inert(in f, in a, expr_node.a));
    } else if kind == 11 {
        walk(inout f, in sk, in c, in a, expr_node.b, parent, operand_edge, inout env);
        if f.failed {
            return;
        }
        let child = node_count(in f);
        let lazy_op = name_is(in a, expr_node.a, in "&&".as_bytes())
            || name_is(in a, expr_node.a, in "||".as_bytes());
        let inner_edge = if nested || lazy_op {
            E_CONDITIONAL
        } else {
            E_ALWAYS
        };
        walk(inout f, in sk, in c, in a, expr_node.c, parent, inner_edge, inout env);
        set_earlier(inout f, child, !inert(in f, in a, expr_node.b));
    } else if kind == 12 {
        let mut base = expr_node.b;
        loop {
            let base_node = expr_at(in a, base);
            if base_node.kind != 7 && base_node.kind != 8 {
                break;
            }
            base = base_node.a;
        }
        let mut init_out = false;
        if name_is(in a, expr_node.a, in "=".as_bytes()) {
            let slot = slot_at(in f, in sk, es(in a, base));
            if slot != NONE {
                init_out = cap_pass(in c, hole_cap(in sk, slot_hole(in sk, slot))) == S_OUT;
            }
        }
        place(inout f, in sk, in c, in a, expr_node.b, if init_out { S_OUT } else { S_INOUT });
        if f.failed {
            return;
        }
        walk(inout f, in sk, in c, in a, expr_node.b, parent, E_ALWAYS, inout env);
        if f.failed {
            return;
        }
        walk(inout f, in sk, in c, in a, expr_node.c, parent, E_ALWAYS, inout env);
    } else if kind == 13 {
        walk(inout f, in sk, in c, in a, expr_node.a, parent, E_ALWAYS, inout env);
        if f.failed {
            return;
        }
        walk(inout f, in sk, in c, in a, expr_node.b, parent, E_BRANCH, inout env);
        if f.failed {
            return;
        }
        if expr_node.c != none() {
            walk(inout f, in sk, in c, in a, expr_node.c, parent, E_BRANCH, inout env);
        }
    } else if kind == 14 {
        walk(inout f, in sk, in c, in a, expr_node.a, parent, E_ALWAYS, inout env);
        if f.failed {
            return;
        }
        let arms = list_len(in a, expr_node.b) >> 1;
        let mut i: u64 = 0;
        loop {
            if i >= arms {
                break;
            }
            let arm_pat = list_at(in a, expr_node.b, i << 1);
            let arm_body = list_at(in a, expr_node.b, inc(i << 1));
            // The alternatives of an or-pattern share the body's span.
            let mut alt_end = inc(i);
            loop {
                if alt_end >= arms {
                    break;
                }
                let alt_body = list_at(in a, expr_node.b, inc(alt_end << 1));
                if es(in a, alt_body) != es(in a, arm_body)
                    || ee(in a, alt_body) != ee(in a, arm_body) {
                    break;
                }
                alt_end = inc(alt_end);
            }
            pattern(inout f, in sk, in a, arm_pat, inout env);
            walk(inout f, in sk, in c, in a, arm_body, parent, E_BRANCH, inout env);
            if f.failed {
                return;
            }
            let mut bindings = ChunkSeq::new[u64]();
            for q in wrapping_mul(outer, 3)..env.len() {
                bindings.push(w64(in env, q));
            }
            env_truncate(inout env, outer);
            for alt in inc(i)..alt_end {
                let other = list_at(in a, expr_node.b, alt << 1);
                pattern_using(inout f, in sk, in a, other, inout env, false, in bindings);
                env_truncate(inout env, outer);
            }
            i = alt_end;
        }
    } else if kind == 15 {
        for i in 0..list_len(in a, expr_node.a) {
            let param = param_of(in a, list_at(in a, expr_node.a, i));
            if starts_with_mark(in f, in a, param.name) {
                continue;
            }
            let param_start = widen_u64(param.start);
            let param_end = widen_u64(param.end);
            if param_start < PREFIX_LEN
                || param_end < param_start
                || sub(param_end, PREFIX_LEN) > sk.src.len() {
                // `slice` is empty: no token matches a nonempty name.
                if name_len(in a, param.name) != 0 {
                    continue;
                }
            }
            let mut fragment = ChunkSeq::new[u8]();
            if param_start >= PREFIX_LEN
                && param_end >= param_start
                && sub(param_end, PREFIX_LEN) <= sk.src.len() {
                push_range(
                    inout fragment,
                    in sk.src,
                    sub(param_start, PREFIX_LEN),
                    sub(param_end, PREFIX_LEN)
                );
            }
            let fragment_toks = lex_rows(in fragment);
            let mut hit = NONE;
            for tok in 0..(fragment_toks.len() / 3) {
                let tok_start = w64(in fragment_toks, inc(wrapping_mul(tok, 3)));
                let tok_end = w64(in fragment_toks, add(wrapping_mul(tok, 3), 2));
                if sub(tok_end, tok_start) == name_len(in a, param.name) {
                    let mut same = true;
                    for byte_index in 0..sub(tok_end, tok_start) {
                        if b8(in fragment, add(tok_start, byte_index))
                            != name_byte(in a, param.name, byte_index) {
                            same = false;
                            break;
                        }
                    }
                    if same {
                        hit = tok_start;
                        break;
                    }
                }
            }
            if hit != NONE {
                let name_start = add(param_start, hit);
                let num = fresh(inout f);
                let mut text = ChunkSeq::new[u8]();
                push_fresh(inout text, in f.mark, F_PARAM, num);
                rename(
                    inout f,
                    in sk,
                    name_start,
                    add(name_start, name_len(in a, param.name)),
                    in text
                );
                env_push(inout env, param.name, F_PARAM, num);
            }
        }
        walk(inout f, in sk, in c, in a, expr_node.e, parent, E_REPEATED, inout env);
    } else if kind == 16 {
        if expr_node.b != none() {
            walk(inout f, in sk, in c, in a, expr_node.c, parent, E_ALWAYS, inout env);
            if f.failed {
                return;
            }
            pattern(inout f, in sk, in a, expr_node.b, inout env);
        }
        walk(inout f, in sk, in c, in a, expr_node.d, parent, E_ALWAYS, inout env);
        if f.failed {
            return;
        }
        let base = env_len(in env);
        for i in 0..list_len(in a, expr_node.e) {
            let clause = clause_of(in a, list_at(in a, expr_node.e, i));
            for q in 0..list_len(in a, clause.pats) {
                pattern(inout f, in sk, in a, list_at(in a, clause.pats, q), inout env);
            }
            let inner_edge = if i == 0 { E_CONDITIONAL } else { E_REPEATED };
            walk(inout f, in sk, in c, in a, clause.body, parent, inner_edge, inout env);
            if f.failed {
                return;
            }
            env_truncate(inout env, base);
        }
    } else if kind == 17 {
        walk(inout f, in sk, in c, in a, expr_node.a, parent, E_REPEATED, inout env);
    } else if kind == 18 {
        walk(inout f, in sk, in c, in a, expr_node.b, parent, E_ALWAYS, inout env);
        if f.failed {
            return;
        }
        pattern(inout f, in sk, in a, expr_node.a, inout env);
        walk(inout f, in sk, in c, in a, expr_node.c, parent, E_REPEATED, inout env);
    } else if kind == 20 || kind == 21 {
        if expr_node.a != none() {
            walk(inout f, in sk, in c, in a, expr_node.a, parent, E_ALWAYS, inout env);
        }
    }
    env_truncate(inout env, outer);
}

// `self.statement(child, after)`.
fn statement(inout f: Fx, child: u64, after: u64) -> u64 {
    let at = tokens_before(in f, after);
    let parent = nd(in f, child, 0);
    if parent != NONE && nd(in f, parent, 2) < PREFIX_LEN {
        return nd(in f, child, 3);
    }
    let mut start = NONE;
    for i in at..ntok(in f) {
        let kind = tok_k(in f, i);
        if !trivia_kind(kind) && kind != k_r_paren() && kind != k_semi() {
            start = tok_s(in f, i);
            break;
        }
    }
    nd_set(inout f, child, 4, start);
    nd(in f, child, 3)
}

// `self.function(f, wrapped)`.
fn function(inout f: Fx, in sk: Sk, in c: Caps, in a: Ast, func_index: u32, wrapped: bool) {
    let fnode = fn_of(in a, func_index);
    if fnode.body == none() {
        return;
    }
    let mut names = ChunkSeq::new[u64]();
    if !wrapped {
        for i in 0..list_len(in a, fnode.params) {
            let param = param_of(in a, list_at(in a, fnode.params, i));
            if starts_with_mark(in f, in a, param.name)
                || name_is(in a, param.name, in "self".as_bytes()) {
                continue;
            }
            let param_start = widen_u64(param.start);
            let param_end = widen_u64(param.end);
            let mut tok = tokens_before(in f, param_start);
            loop {
                if tok >= ntok(in f) || tok_s(in f, tok) >= param_end {
                    break;
                }
                if slice_is(in f, in sk, tok_s(in f, tok), tok_e(in f, tok), in a, param.name) {
                    let num = fresh(inout f);
                    let mut text = ChunkSeq::new[u8]();
                    push_fresh(inout text, in f.mark, F_PARAM, num);
                    rename(inout f, in sk, tok_s(in f, tok), tok_e(in f, tok), in text);
                    env_push(inout names, param.name, F_PARAM, num);
                    break;
                }
                tok = inc(tok);
            }
        }
    }
    walk(inout f, in sk, in c, in a, fnode.body, NONE, E_ALWAYS, inout names);
    if f.failed {
        return;
    }
    let nholes = sk.holes.len() >> 2;
    let mut uses = ChunkSeq::new[u64]();
    swap(inout uses, inout f.us);
    for id in 0..nholes {
        // This hole's usages, as (slot, path) rows over a path pool.
        let mut rows = ChunkSeq::new[u64]();
        let mut paths = ChunkSeq::new[u64]();
        let mut written = false;
        for usage in 0..(uses.len() / 3) {
            if w64(in uses, wrapping_mul(usage, 3)) == id {
                let slot = w64(in uses, inc(wrapping_mul(usage, 3)));
                if b8(in f.writes, slot) == 1 {
                    written = true;
                }
            }
        }
        let cap = hole_cap(in sk, id);
        if !sort_in(in c, cap, in "expr".as_bytes()) && !written {
            continue;
        }
        for usage in 0..(uses.len() / 3) {
            if w64(in uses, wrapping_mul(usage, 3)) == id {
                let slot = w64(in uses, inc(wrapping_mul(usage, 3)));
                let node = w64(in uses, add(wrapping_mul(usage, 3), 2));
                let mut chain = ChunkSeq::new[u64]();
                let mut ancestor = node;
                chain.push(ancestor);
                loop {
                    let parent = nd(in f, ancestor, 0);
                    if parent == NONE {
                        break;
                    }
                    ancestor = parent;
                    chain.push(ancestor);
                }
                rows.push(slot);
                rows.push(paths.len());
                rows.push(chain.len());
                let mut j = chain.len();
                loop {
                    if j == 0 {
                        break;
                    }
                    j = sub(j, 1);
                    paths.push(w64(in chain, j));
                }
            }
        }
        plan(inout f, in sk, in c, id, in rows, in paths, 0, rows.len() / 3, 0);
        if f.failed {
            return;
        }
    }
}

// Node `step` of use `usage`'s path, or NONE.
fn path_at(in rows: ChunkSeq[u64], in paths: ChunkSeq[u64], usage: u64, step: u64) -> u64 {
    if step >= w64(in rows, add(wrapping_mul(usage, 3), 2)) {
        return NONE;
    }
    w64(in paths, add(w64(in rows, inc(wrapping_mul(usage, 3))), step))
}

fn path_len(in rows: ChunkSeq[u64], usage: u64) -> u64 {
    w64(in rows, add(wrapping_mul(usage, 3), 2))
}

// `self.plan(id, uses[from..from + count], depth)`.
fn plan(
    inout f: Fx,
    in sk: Sk,
    in c: Caps,
    id: u64,
    in rows: ChunkSeq[u64],
    in paths: ChunkSeq[u64],
    from: u64,
    count: u64,
    depth: u64
) {
    if count == 0 {
        return;
    }
    let mut repeatable = false;
    for usage in from..add(from, count) {
        for i in 0..path_len(in rows, usage) {
            if nd(in f, path_at(in rows, in paths, usage, i), 1) == E_REPEATED {
                repeatable = true;
            }
        }
    }
    if count < 2 && !repeatable {
        return;
    }
    let mut common = depth;
    loop {
        let shared = path_at(in rows, in paths, from, inc(common));
        if shared == NONE {
            break;
        }
        let mut all = true;
        for usage in from..add(from, count) {
            if path_at(in rows, in paths, usage, inc(common)) != shared {
                all = false;
                break;
            }
        }
        if !all {
            break;
        }
        common = inc(common);
    }
    if !repeatable {
        let mut branches = true;
        for usage in from..add(from, count) {
            let next_node = path_at(in rows, in paths, usage, inc(common));
            if next_node == NONE || nd(in f, next_node, 1) != E_BRANCH {
                branches = false;
                break;
            }
        }
        if branches {
            let mut start = from;
            loop {
                if start >= add(from, count) {
                    break;
                }
                let branch = path_at(in rows, in paths, start, inc(common));
                let mut run_len: u64 = 0;
                loop {
                    let usage = add(start, run_len);
                    if usage >= add(from, count)
                        || path_at(in rows, in paths, usage, inc(common)) != branch {
                        break;
                    }
                    run_len = inc(run_len);
                }
                plan(inout f, in sk, in c, id, in rows, in paths, start, run_len, inc(common));
                if f.failed {
                    return;
                }
                start = add(start, run_len);
            }
            return;
        }
    }
    if sort_in(in c, hole_cap(in sk, id), in "place".as_bytes()) {
        fail(
            inout f,
            in "a modifying sugar place is used more than once on a control-flow path".as_bytes()
        );
        return;
    }
    if repeatable {
        for i in 0..inc(common) {
            let node = path_at(in rows, in paths, from, i);
            if node != NONE && nd(in f, node, 1) == E_REPEATED {
                common = if i == 0 { 0 } else { sub(i, 1) };
                break;
            }
        }
    }
    let mut lazy = repeatable;
    if !lazy {
        let len = path_len(in rows, from);
        for i in inc(common)..len {
            let node = path_at(in rows, in paths, from, i);
            let earlier = nd(in f, node, 5) == 1;
            if nd(in f, node, 1) != E_ALWAYS
                || earlier && (i != inc(common) || nd(in f, node, 4) == NONE) {
                lazy = true;
                break;
            }
        }
    }
    let top = path_at(in rows, in paths, from, common);
    let span_start = nd(in f, top, 2);
    let span_end = nd(in f, top, 3);
    let next = path_at(in rows, in paths, from, inc(common));
    let mut statement = NONE;
    if next != NONE {
        statement = nd(in f, next, 4);
    }
    if statement == NONE {
        statement = nd(in f, top, 4);
    }
    let base = if statement == NONE {
        span_start
    } else {
        statement
    };
    let start = if base < PREFIX_LEN {
        0
    } else {
        sub(base, PREFIX_LEN)
    };
    let end = if statement == NONE {
        let clamped = if span_end < PREFIX_LEN {
            0
        } else {
            sub(span_end, PREFIX_LEN)
        };
        if clamped > sk.src.len() {
            sk.src.len()
        } else {
            clamped
        }
    } else {
        NONE
    };
    let num = fresh(inout f);
    f.decls.push(start);
    f.decls.push(end);
    f.decls.push(id);
    f.decls.push(num);
    f.decls.push(if lazy { 1 } else { 0 });
    for usage in from..add(from, count) {
        let slot = w64(in rows, wrapping_mul(usage, 3));
        f.memo.try_set(slot, num);
        f.lazy.try_set(slot, if lazy { 1 } else { 0 });
    }
}

// ---------------------------------------------------------------- render

// The rendered text and its maps: hole spans (start, end), origins
// (start, end, value start, value end, from tail) and places (start, end,
// pass).
pub struct Rd {
    failed: bool,
    msg: ChunkSeq[u8],
    text: ChunkSeq[u8],
    holes: ChunkSeq[u64],
    origins: ChunkSeq[u64],
    places: ChunkSeq[u64]
}

fn rd_fail(inout r: Rd, in text: Slice[u8]) {
    if !r.failed {
        r.failed = true;
        r.msg.clear();
        r.msg.extend(in text);
    }
}

// `bounded(out, s, max)`'s check.
pub fn rd_room(inout r: Rd, n: u64, max: u64) -> bool {
    let left = if r.text.len() > max {
        0
    } else {
        sub(max, r.text.len())
    };
    if n > left {
        rd_fail(inout r, in "sugar expansion byte limit exceeded".as_bytes());
        return false;
    }
    true
}

fn rd_push(inout r: Rd, in bytes: Slice[u8], max: u64) -> bool {
    if !rd_room(inout r, bytes.len(), max) {
        return false;
    }
    r.text.extend(in bytes);
    true
}

fn rd_push_seq(inout r: Rd, in bytes: ChunkSeq[u8], max: u64) -> bool {
    rd_push(inout r, in bytes.as_slice(), max)
}

// `Rendered::hole(h, max)`.
fn rd_hole(
    inout r: Rd,
    in sk: Sk,
    in c: Caps,
    in invocation: ChunkSeq[u8],
    in tail: ChunkSeq[u8],
    hole: u64,
    max: u64
) -> bool {
    let cap = hole_cap(in sk, hole);
    let value_index = w64(in sk.holes, inc(hole << 2));
    let at = value_at(in c, cap, value_index);
    let value_start = w64(in c.w, at);
    let value_end = w64(in c.w, inc(at));
    let from_tail = w64(in c.w, add(at, 2)) == 1;
    let expr = sort_in(in c, cap, in "expr".as_bytes());
    let scope = sort_in(in c, cap, in "scope".as_bytes()) && from_tail;
    let outer_start = r.text.len();
    if expr && !rd_push(inout r, in "(".as_bytes(), max) {
        return false;
    }
    if scope && !rd_push(inout r, in "{".as_bytes(), max) {
        return false;
    }
    let start = r.text.len();
    let mut value = ChunkSeq::new[u8]();
    if from_tail {
        push_range(inout value, in tail, value_start, value_end);
    } else {
        push_range(inout value, in invocation, value_start, value_end);
    }
    if !rd_push_seq(inout r, in value, max) {
        return false;
    }
    r.origins.push(start);
    r.origins.push(r.text.len());
    r.origins.push(value_start);
    r.origins.push(value_end);
    r.origins.push(if from_tail { 1 } else { 0 });
    let pass = permission(in c, in sk, hole);
    if pass != 0 {
        r.places.push(add(start, w64(in sk.holes, add(hole << 2, 2))));
        r.places.push(add(start, w64(in sk.holes, add(hole << 2, 3))));
        r.places.push(pass);
    }
    if expr && !rd_push(inout r, in ")".as_bytes(), max) {
        return false;
    }
    if scope && !rd_push(inout r, in "}".as_bytes(), max) {
        return false;
    }
    r.holes.push(outer_start);
    r.holes.push(r.text.len());
    true
}

// Edit kinds and rows: start, end, kind, a, b, c, d.
const ED_LITERAL: u64 = 0;
const ED_LAZY_USE: u64 = 1;
const ED_HOLE: u64 = 2;
const ED_BINDING: u64 = 3;
const EW: u64 = 7;

fn push_edit(
    inout eds: ChunkSeq[u64],
    start: u64,
    end: u64,
    kind: u64,
    a: u64,
    b: u64,
    c: u64,
    d: u64
) {
    eds.push(start);
    eds.push(end);
    eds.push(kind);
    eds.push(a);
    eds.push(b);
    eds.push(c);
    eds.push(d);
}

// `emit(sk, edits)`: literal texts of `edits` live in `pool`.
fn emit(
    in sk: Sk,
    in c: Caps,
    in invocation: ChunkSeq[u8],
    in tail: ChunkSeq[u8],
    in mark: ChunkSeq[u8],
    in edits: ChunkSeq[u64],
    in pool: ChunkSeq[u8],
    in memo: ChunkSeq[u64],
    in lazy: ChunkSeq[u8]
) -> Rd {
    let mut eds = ChunkSeq::new[u64]();
    eds.extend(in edits.as_slice());
    let toks = lex_rows(in sk.src);
    let tok_count = toks.len() / 3;
    let mut commas = ChunkSeq::new[u64]();
    for slot in 0..(sk.slots.len() / 3) {
        let hole = slot_hole(in sk, slot);
        let slot_start = w64(in sk.slots, inc(wrapping_mul(slot, 3)));
        let slot_end = w64(in sk.slots, add(wrapping_mul(slot, 3), 2));
        let cap = hole_cap(in sk, hole);
        if sort_in(in c, cap, in "args".as_bytes()) || sort_in(in c, cap, in "pats".as_bytes()) {
            let at = value_at(in c, cap, w64(in sk.holes, inc(hole << 2)));
            let value_start = w64(in c.w, at);
            let value_end = w64(in c.w, inc(at));
            let from_tail = w64(in c.w, add(at, 2)) == 1;
            let mut blank = true;
            for j in value_start..value_end {
                let byte = if from_tail {
                    b8(in tail, j)
                } else {
                    b8(in invocation, j)
                };
                // `str::trim`: Unicode whitespace; the captured text is a
                // token span, so only ASCII whitespace occurs at its ends.
                if !(
                    byte == 32 || byte == 9 || byte == 10 || byte == 13 || byte == 11 || byte == 12
                ) {
                    blank = false;
                    break;
                }
            }
            if blank {
                // `tokens.partition_point(|t| t.span.end <= slot.span.end)`.
                let mut tok: u64 = 0;
                loop {
                    if tok >= tok_count || w64(in toks, add(wrapping_mul(tok, 3), 2)) > slot_end {
                        break;
                    }
                    tok = inc(tok);
                }
                loop {
                    if tok >= tok_count
                        || !trivia_kind(wrapping_u8(w64(in toks, wrapping_mul(tok, 3)))) {
                        break;
                    }
                    tok = inc(tok);
                }
                if tok < tok_count && wrapping_u8(w64(in toks, wrapping_mul(tok, 3))) == k_comma() {
                    let comma_start = w64(in toks, inc(wrapping_mul(tok, 3)));
                    let comma_end = w64(in toks, add(wrapping_mul(tok, 3), 2));
                    let mut seen = false;
                    for comma in 0..commas.len() {
                        if w64(in commas, comma) == comma_start {
                            seen = true;
                        }
                    }
                    if !seen {
                        commas.push(comma_start);
                        push_edit(inout eds, comma_start, comma_end, ED_LITERAL, 0, 0, 0, 0);
                    }
                }
            }
        }
        let once_num = w64(in memo, slot);
        if once_num != 0 && b8(in lazy, slot) == 1 {
            push_edit(inout eds, slot_start, slot_end, ED_LAZY_USE, hole, once_num, 0, 0);
        } else if once_num != 0 {
            push_edit(inout eds, slot_start, slot_end, ED_LITERAL, NONE, once_num, 0, 0);
        } else {
            push_edit(inout eds, slot_start, slot_end, ED_HOLE, hole, 0, 0, 0);
        }
    }
    // A stable sort by (start, end).
    let edit_count = eds.len() / EW;
    let mut order = ChunkSeq::new[u64]();
    for edit in 0..edit_count {
        let mut at = order.len();
        order.push(edit);
        loop {
            if at == 0 {
                break;
            }
            let prev = w64(in order, sub(at, 1));
            let prev_start = w64(in eds, wrapping_mul(prev, EW));
            let prev_end = w64(in eds, inc(wrapping_mul(prev, EW)));
            let cur_start = w64(in eds, wrapping_mul(edit, EW));
            let cur_end = w64(in eds, inc(wrapping_mul(edit, EW)));
            if !(cur_start < prev_start || cur_start == prev_start && cur_end < prev_end) {
                break;
            }
            order.try_set(at, prev);
            at = sub(at, 1);
        }
        order.try_set(at, edit);
    }
    let max = sk.max;
    let mut rendered = Rd {
        failed: false,
        msg: ChunkSeq::new[u8](),
        text: ChunkSeq::new[u8](),
        holes: ChunkSeq::new[u64](),
        origins: ChunkSeq::new[u64](),
        places: ChunkSeq::new[u64]()
    };
    let mut pos: u64 = 0;
    for rank in 0..edit_count {
        let edit = w64(in order, rank);
        let row = wrapping_mul(edit, EW);
        let start = w64(in eds, row);
        let end = w64(in eds, inc(row));
        if start < pos {
            rd_fail(inout rendered, in "overlapping sugar template edits".as_bytes());
            return rendered;
        }
        let mut gap = ChunkSeq::new[u8]();
        push_range(inout gap, in sk.src, pos, start);
        if !rd_push_seq(inout rendered, in gap, max) {
            return rendered;
        }
        let kind = w64(in eds, add(row, 2));
        let a = w64(in eds, add(row, 3));
        let b = w64(in eds, add(row, 4));
        if kind == ED_LITERAL {
            let mut text = ChunkSeq::new[u8]();
            if a == NONE {
                push_fresh(inout text, in mark, F_ONCE, b);
            } else {
                push_range(inout text, in pool, a, add(a, b));
            }
            if !rd_push_seq(inout rendered, in text, max) {
                return rendered;
            }
        } else if kind == ED_HOLE {
            if !rd_hole(inout rendered, in sk, in c, in invocation, in tail, a, max) {
                return rendered;
            }
        } else if kind == ED_LAZY_USE {
            let mut name = ChunkSeq::new[u8]();
            push_fresh(inout name, in mark, F_ONCE, b);
            let mut text = ChunkSeq::new[u8]();
            text.extend(in "({ match ".as_bytes());
            text.extend(in name.as_slice());
            text.extend(in " { Option::Some(".as_bytes());
            text.extend(in name.as_slice());
            text.extend(in "_v) => ".as_bytes());
            text.extend(in name.as_slice());
            text.extend(in "_v, Option::None => { let ".as_bytes());
            text.extend(in name.as_slice());
            text.extend(in "_v = ".as_bytes());
            if !rd_push_seq(inout rendered, in text, max) {
                return rendered;
            }
            if !rd_hole(inout rendered, in sk, in c, in invocation, in tail, a, max) {
                return rendered;
            }
            let mut suffix = ChunkSeq::new[u8]();
            suffix.extend(in "; ".as_bytes());
            suffix.extend(in name.as_slice());
            suffix.extend(in " = Option::Some(".as_bytes());
            suffix.extend(in name.as_slice());
            suffix.extend(in "_v); ".as_bytes());
            suffix.extend(in name.as_slice());
            suffix.extend(in "_v } } })".as_bytes());
            if !rd_push_seq(inout rendered, in suffix, max) {
                return rendered;
            }
        } else {
            let block = w64(in eds, add(row, 5)) == 1;
            let is_lazy = w64(in eds, add(row, 6)) == 1;
            let mut name = ChunkSeq::new[u8]();
            push_fresh(inout name, in mark, F_ONCE, b);
            if block && !rd_push(inout rendered, in "{ ".as_bytes(), max) {
                return rendered;
            }
            let mut text = ChunkSeq::new[u8]();
            if is_lazy {
                text.extend(in "let mut ".as_bytes());
                text.extend(in name.as_slice());
                text.extend(in " = if false { Option::Some(".as_bytes());
            } else {
                text.extend(in "let ".as_bytes());
                text.extend(in name.as_slice());
                text.extend(in " = ".as_bytes());
            }
            if !rd_push_seq(inout rendered, in text, max) {
                return rendered;
            }
            if !rd_hole(inout rendered, in sk, in c, in invocation, in tail, a, max) {
                return rendered;
            }
            let closer = if is_lazy {
                ") } else { Option::None }; "
            } else {
                "; "
            };
            if !rd_push(inout rendered, in closer.as_bytes(), max) {
                return rendered;
            }
        }
        pos = end;
    }
    let mut rest = ChunkSeq::new[u8]();
    push_range(inout rest, in sk.src, pos, sk.src.len());
    rd_push_seq(inout rendered, in rest, max);
    rendered
}

// The spans of the CST's sugar call and expression macro nodes (kinds
// 208-210, 218, 221-223, 225) of the parse in `l`.
fn nested_spans(in events: ChunkSeq[u32], in toks: @vesper/front::Tokens) -> ChunkSeq[u64] {
    let mut out = ChunkSeq::new[u64]();
    let mut open = ChunkSeq::new[u64]();
    let mut offset: u64 = 0;
    for i in 0..events.len() {
        let event = match events.try_get(i) {
            Option::Some(event) => widen_u64(event),
            Option::None => 0,
        };
        if event == 4294967295 {
            let last = sub(open.len(), 2);
            let kind = w64(in open, last);
            let start = w64(in open, inc(last));
            open.truncate(last);
            if kind == 208
                || kind == 209
                || kind == 210
                || kind == 218
                || kind == 221
                || kind == 222
                || kind == 223
                || kind == 225 {
                out.push(start);
                out.push(offset);
            }
        } else if event >= 2147483648 {
            open.push(sub(event, 2147483648));
            open.push(offset);
        } else {
            offset = token_end(in toks, event);
        }
    }
    out
}

// `flow::render(sk)` then `emit`: the rendered template, or the refusal.
pub fn render(
    in sk: Sk,
    in c: Caps,
    in invocation: ChunkSeq[u8],
    in tail: ChunkSeq[u8],
    in mark: ChunkSeq[u8]
) -> Rd {
    let nslots = sk.slots.len() / 3;
    let mut f = Fx {
        failed: false,
        msg: ChunkSeq::new[u8](),
        src: ChunkSeq::new[u8](),
        tk: ChunkSeq::new[u64](),
        nested: ChunkSeq::new[u64](),
        nodes: ChunkSeq::new[u64](),
        us: ChunkSeq::new[u64](),
        writes: ChunkSeq::new[u8](),
        memo: ChunkSeq::new[u64](),
        lazy: ChunkSeq::new[u8](),
        lits: ChunkSeq::new[u64](),
        pool: ChunkSeq::new[u8](),
        decls: ChunkSeq::new[u64](),
        fresh: 0,
        mark: ChunkSeq::new[u8]()
    };
    f.mark.extend(in mark.as_slice());
    f.writes.resize(nslots, 0);
    f.memo.resize(nslots, 0);
    f.lazy.resize(nslots, 0);
    let mut wrapped_text = ChunkSeq::new[u8]();
    wrapped_text.extend(in PREFIX.as_bytes());
    wrapped_text.extend(in sk.src.as_slice());
    wrapped_text.extend(in "\n}".as_bytes());
    let mut source = match String::from_utf8(in wrapped_text.as_slice()) {
        Option::Some(text) => text,
        Option::None => String::new(),
    };
    let mut wrapped = true;
    let mut lowered = lower_source(in source.as_str());
    if lowered.p.d.code.len() != 0 {
        lowered = lower_template_source(in source.as_str());
        if lowered.p.t.rejected {
            return refused_rd(in lowered.p.d);
        }
    }
    if lowered.p.d.code.len() != 0 {
        // The prefix's width keeps every offset the same.
        let mut padded = ChunkSeq::new[u8]();
        for i in 0..PREFIX_LEN {
            padded.push(32);
        }
        padded.extend(in sk.src.as_slice());
        source = match String::from_utf8(in padded.as_slice()) {
            Option::Some(text) => text,
            Option::None => String::new(),
        };
        lowered = lower_template_source(in source.as_str());
        if lowered.p.t.rejected {
            return refused_rd(in lowered.p.d);
        }
        wrapped = false;
    }
    f.src.extend(in source.as_bytes());
    f.nested = nested_spans(in lowered.p.ev, in lowered.p.t);
    f.tk = lex_rows(in f.src);
    let a = lowered.ast;
    if lowered.p.d.code.len() == 0 && a.m_items.len() != 0 {
        for i in 0..a.m_items.len() {
            let item = a.items.get_or(
                idx_from_raw[ItemNode](
                    match a.m_items.try_get(i) {
                        Option::Some(raw_item) => raw_item,
                        Option::None => 0,
                    }
                ),
                ItemNode { kind: 0, node: 0 }
            );
            if item.kind == 2 {
                function(inout f, in sk, in c, in a, item.node, wrapped);
            } else if item.kind == 4 {
                let owner = a.impls.get_or(
                    idx_from_raw[ImplNode](item.node),
                    ImplNode { ty: none(), generics: 0, methods: 0 }
                );
                for method in 0..list_len(in a, owner.methods) {
                    function(
                        inout f,
                        in sk,
                        in c,
                        in a,
                        list_at(in a, owner.methods, method),
                        wrapped
                    );
                    if f.failed {
                        break;
                    }
                }
            } else if item.kind == 5 {
                let owner = a.traits.get_or(
                    idx_from_raw[TraitNode](item.node),
                    TraitNode {
                        name: none(),
                        public: false,
                        generics: 0,
                        assoc: 0,
                        methods: 0,
                        start: 0,
                        end: 0
                    }
                );
                for method in 0..list_len(in a, owner.methods) {
                    function(
                        inout f,
                        in sk,
                        in c,
                        in a,
                        list_at(in a, owner.methods, method),
                        wrapped
                    );
                    if f.failed {
                        break;
                    }
                }
            } else if item.kind == 6 {
                let owner = a.confs.get_or(
                    idx_from_raw[ConfNode](item.node),
                    ConfNode {
                        model: none(),
                        public: false,
                        generics: 0,
                        trait_ref: none(),
                        self_ty: none(),
                        wheres: 0,
                        assoc: 0,
                        methods: 0,
                        start: 0,
                        end: 0
                    }
                );
                for method in 0..list_len(in a, owner.methods) {
                    function(
                        inout f,
                        in sk,
                        in c,
                        in a,
                        list_at(in a, owner.methods, method),
                        wrapped
                    );
                    if f.failed {
                        break;
                    }
                }
            }
            if f.failed {
                return refused_text(in f.msg);
            }
        }
    } else {
        // Item-producing and nested-sugar templates need no core
        // expression AST when they contain no local binders or repeated
        // or privileged expressions.
        let toks = lex_rows(in sk.src);
        let mut binders = false;
        for tok in 0..(toks.len() / 3) {
            let kind = wrapping_u8(w64(in toks, wrapping_mul(tok, 3)));
            if kind == k_let() || kind == k_fat_arrow() || kind == k_inout() || kind == k_sink() {
                binders = true;
            }
        }
        let mut ids = ChunkSeq::new[u64]();
        let mut count: u64 = 0;
        for slot in 0..nslots {
            let hole = slot_hole(in sk, slot);
            if sort_in(in c, hole_cap(in sk, hole), in "expr".as_bytes()) {
                count = inc(count);
                let mut seen = false;
                for id_index in 0..ids.len() {
                    if w64(in ids, id_index) == hole {
                        seen = true;
                    }
                }
                if !seen {
                    ids.push(hole);
                }
            }
        }
        if binders || ids.len() != count {
            return refused_str(
                in "cannot prove hygiene and single evaluation for this non-core sugar template"
            );
        }
        let none_edits = ChunkSeq::new[u64]();
        return emit(
            in sk,
            in c,
            in invocation,
            in tail,
            in mark,
            in none_edits,
            in f.pool,
            in f.memo,
            in f.lazy
        );
    }
    let mut edits = ChunkSeq::new[u64]();
    for lit in 0..(f.lits.len() >> 2) {
        push_edit(
            inout edits,
            w64(in f.lits, lit << 2),
            w64(in f.lits, inc(lit << 2)),
            ED_LITERAL,
            w64(in f.lits, add(lit << 2, 2)),
            w64(in f.lits, add(lit << 2, 3)),
            0,
            0
        );
    }
    // Declarations by (start, Reverse(end)), stable; the first insertion
    // at a common start opens the widest wrapper first.
    let decl_count = f.decls.len() / 5;
    let mut order = ChunkSeq::new[u64]();
    for i in 0..decl_count {
        let mut at = order.len();
        order.push(i);
        loop {
            if at == 0 {
                break;
            }
            let prev = w64(in order, sub(at, 1));
            let prev_start = w64(in f.decls, wrapping_mul(prev, 5));
            let prev_end = w64(in f.decls, inc(wrapping_mul(prev, 5)));
            let cur_start = w64(in f.decls, wrapping_mul(i, 5));
            let cur_end = w64(in f.decls, inc(wrapping_mul(i, 5)));
            // `Reverse(end)` with `None < Some`: NONE (None) sorts last.
            let later = if cur_end == NONE {
                false
            } else if prev_end == NONE {
                true
            } else {
                cur_end > prev_end
            };
            if !(cur_start < prev_start || cur_start == prev_start && later) {
                break;
            }
            order.try_set(at, prev);
            at = sub(at, 1);
        }
        order.try_set(at, i);
    }
    for rank in 0..decl_count {
        let decl = w64(in order, rank);
        let start = w64(in f.decls, wrapping_mul(decl, 5));
        let end = w64(in f.decls, inc(wrapping_mul(decl, 5)));
        let id = w64(in f.decls, add(wrapping_mul(decl, 5), 2));
        let num = w64(in f.decls, add(wrapping_mul(decl, 5), 3));
        let lazy = w64(in f.decls, add(wrapping_mul(decl, 5), 4));
        push_edit(
            inout edits,
            start,
            start,
            ED_BINDING,
            id,
            num,
            if end == NONE { 0 } else { 1 },
            lazy
        );
        if end != NONE {
            let first = f.pool.len();
            f.pool.extend(in " }".as_bytes());
            push_edit(inout edits, end, end, ED_LITERAL, first, 2, 0, 0);
        }
    }
    emit(in sk, in c, in invocation, in tail, in mark, in edits, in f.pool, in f.memo, in f.lazy)
}

pub fn refused_text(in message: ChunkSeq[u8]) -> Rd {
    let mut rendered = Rd {
        failed: true,
        msg: ChunkSeq::new[u8](),
        text: ChunkSeq::new[u8](),
        holes: ChunkSeq::new[u64](),
        origins: ChunkSeq::new[u64](),
        places: ChunkSeq::new[u64]()
    };
    rendered.msg.extend(in message.as_slice());
    rendered
}

pub fn refused_str(in message: Str) -> Rd {
    let mut bytes = ChunkSeq::new[u8]();
    bytes.extend(in message.as_bytes());
    refused_text(in bytes)
}

// A lexer refusal of the template-scopes parse: its E0003 message.
pub fn refused_rd(in diag: @vesper/front::Diags) -> Rd {
    let end = if diag.at.len() > 1 {
        w32(in diag.at, 1)
    } else {
        diag.text.len()
    };
    let mut message = ChunkSeq::new[u8]();
    for j in w32(in diag.at, 0)..end {
        message.push(b8(in diag.text, j));
    }
    refused_text(in message)
}
