// `sugar_expand`'s driver: the bounded expansion loop of
// crates/vesper-syntax/src/sugar_expand.rs (`expand_sugar_with_scopes_for_execution`
// without imports, `read_definition`, the registry, `ExpandedSugar::apply`
// and `original_span`) and `hygiene::protect`.
//
// Each round parses the expanded source in the surface profile (@vesper/front
// `parse_surface_tokens` under sugar expansion's limits), reads new sugar
// declarations, and expands every outermost sugar use with the rule matcher
// (matcher.ves), the template (template.ves, flow.ves), pattern hygiene and
// scope captures (hygiene.ves, scope.ves). Edits keep a map from expanded
// to original bytes and the effect regions of each expansion. When no use
// is left, `protect` renames caller bindings that a template's free names
// would otherwise capture.
//
// Tables are rows over pools: texts are (first, length) references into
// byte pools, regions and edits are fixed-width rows with their holes,
// places and copies in their own row pools.

use @vesper/ast::{Ast, ConfNode, ImplNode, ItemNode, expr_at, list_at, list_len, none, pat_at};
use @vesper/ast::lower::{lower_source, lower_surface_source_limits};
use @vesper-std/arena::{idx_from_raw};
use @vesper/front::{P};
use @vesper/front::lex::{
    lex_sugar_raw_with_limits, lex_sugar_with_limits, max_diagnostics, max_source_bytes, max_tokens,
    token_end, trivia_kind
};
use @vesper/front::diag::{diags_new};
use @vesper/front::parse::{hard_depth, parse_surface_tokens};
use @vesper/front::kinds::{
    k_amp, k_amp_eq, k_and, k_arrow, k_caret, k_colon, k_dot, k_eff, k_eq_eq, k_ge, k_gt, k_l_brace,
    k_le, k_linear, k_lower, k_lt, k_minus, k_minus_eq, k_ne, k_or, k_percent, k_percent_eq, k_pipe,
    k_pipe_eq, k_plus, k_plus_eq, k_question, k_r_brace, k_shl, k_shr, k_slash, k_slash_eq, k_star,
    k_star_eq, k_state, k_with
};
use self::flow::{Rd, arg_of, clause_of, fn_of, name_byte, name_len, param_of, render, stmt_of};
use self::hygiene::{pattern_hygiene};
use self::matcher::{captures_tail, match_rule_encoded};
use self::scope::{lower};
use self::template::{
    Caps, add, b8, cap_at, cap_count, caps_read, inc, push_decimal, skeleton_run, sort_in, sub,
    value_at, w32, w64
};

const NONE: u64 = 18446744073709551615;
const MAX_DEPTH: u64 = 64;
const MAX_STEPS: u64 = 8192;
// `lexer::HARD_SOURCE_BYTES` and `HARD_TOKENS`.
const MAX_BYTES: u64 = 8388608;
const HARD_TOKENS: u64 = 262144;
const WORK: u64 = 67108864;

// Node kinds of the surface CST.
const N_SUGAR_ITEM: u8 = 208;
const N_SUGAR_STMT: u8 = 209;
const N_SUGAR_EXPR: u8 = 210;
const N_SUGAR_DECL: u8 = 212;
const N_SUGAR_RULE: u8 = 213;
const N_SUGAR_PATTERN: u8 = 214;
const N_SUGAR_TEMPLATE: u8 = 215;
const N_SUGAR_PAT: u8 = 218;
const N_SUGAR_OPERATOR: u8 = 220;
const N_PIPE_EXPR: u8 = 221;
const N_DOTTED_EXPR: u8 = 222;
const N_TAGGED_LITERAL: u8 = 223;

// ---------------------------------------------------------------- bytes

fn cat(inout out: ChunkSeq[u8], in piece: Str) {
    out.extend(in piece.as_bytes());
}

fn cat_seq(inout out: ChunkSeq[u8], in piece: ChunkSeq[u8]) {
    out.extend(in piece.as_slice());
}

fn cat_range(inout out: ChunkSeq[u8], in bytes: ChunkSeq[u8], start: u64, end: u64) {
    for j in start..end {
        out.push(b8(in bytes, j));
    }
}

fn range_of(in bytes: ChunkSeq[u8], start: u64, end: u64) -> ChunkSeq[u8] {
    let mut out = ChunkSeq::new[u8]();
    cat_range(inout out, in bytes, start, end);
    out
}

fn range_is(in bytes: ChunkSeq[u8], start: u64, end: u64, in expected: Slice[u8]) -> bool {
    if end < start || sub(end, start) != expected.len() {
        return false;
    }
    for j in 0..expected.len() {
        let byte = match expected.try_get(j) {
            Option::Some(byte) => byte,
            Option::None => 0,
        };
        if b8(in bytes, add(start, j)) != byte {
            return false;
        }
    }
    true
}

fn ranges_eq(
    in left: ChunkSeq[u8],
    left_start: u64,
    left_end: u64,
    in right: ChunkSeq[u8],
    right_start: u64,
    right_end: u64
) -> bool {
    if left_end < left_start
        || right_end < right_start
        || sub(left_end, left_start) != sub(right_end, right_start) {
        return false;
    }
    for j in 0..sub(left_end, left_start) {
        if b8(in left, add(left_start, j)) != b8(in right, add(right_start, j)) {
            return false;
        }
    }
    true
}

fn seq_eq(in left: ChunkSeq[u8], in right: ChunkSeq[u8]) -> bool {
    ranges_eq(in left, 0, left.len(), in right, 0, right.len())
}

fn is_space(byte: u8) -> bool {
    byte == 32 || byte == 9 || byte == 10 || byte == 13 || byte == 11 || byte == 12
}

// `text.trim_end().ends_with(';')`.
fn ends_with_semi(in bytes: ChunkSeq[u8], start: u64, end: u64) -> bool {
    let mut pos = end;
    loop {
        if pos <= start {
            return false;
        }
        let byte = b8(in bytes, sub(pos, 1));
        if !is_space(byte) {
            return byte == 59;
        }
        pos = sub(pos, 1);
    }
}

// ---------------------------------------------------------------- diagnostics

// A `Diagnostic`: code, message, span and related labels.
pub struct Dg {
    failed: bool,
    code: ChunkSeq[u8],
    msg: ChunkSeq[u8],
    span_start: u64,
    span_end: u64,
    // Related labels as rows (start, end, message first, message length).
    labels: ChunkSeq[u64],
    label_text: ChunkSeq[u8]
}

fn dg_ok() -> Dg {
    Dg {
        failed: false,
        code: ChunkSeq::new[u8](),
        msg: ChunkSeq::new[u8](),
        span_start: 0,
        span_end: 0,
        labels: ChunkSeq::new[u64](),
        label_text: ChunkSeq::new[u8]()
    }
}

fn dg_new(in code: Str, in msg: ChunkSeq[u8], start: u64, end: u64) -> Dg {
    let mut result = dg_ok();
    result.failed = true;
    cat(inout result.code, in code);
    cat_seq(inout result.msg, in msg);
    result.span_start = start;
    result.span_end = end;
    result
}

fn dg_str(in code: Str, in msg: Str, start: u64, end: u64) -> Dg {
    let mut message = ChunkSeq::new[u8]();
    cat(inout message, in msg);
    dg_new(in code, in message, start, end)
}

// `diag(message, span)`: E0141.
fn diag(in msg: Str, start: u64, end: u64) -> Dg {
    dg_str(in "E0141", in msg, start, end)
}

fn diag_seq(in msg: ChunkSeq[u8], start: u64, end: u64) -> Dg {
    dg_new(in "E0141", in msg, start, end)
}

fn limit(start: u64, end: u64) -> Dg {
    dg_str(in "E0143", in "sugar expansion exceeded its depth, size, or work limit", start, end)
}

fn related(inout target: Dg, start: u64, end: u64, in msg: Str) {
    target.labels.push(start);
    target.labels.push(end);
    target.labels.push(target.label_text.len());
    target.labels.push(msg.as_bytes().len());
    cat(inout target.label_text, in msg);
}

fn charge(inout work: u64, units: u64, start: u64, end: u64) -> Dg {
    if units > work {
        return limit(start, end);
    }
    work = sub(work, units);
    dg_ok()
}

// ---------------------------------------------------------------- CST

// A node of the surface CST: kind, parent, text range, leaf range and the
// index after its last descendant.
copy struct Node {
    kind: u8,
    parent: u32,
    start: u32,
    end: u32,
    lo: u32,
    hi: u32,
    after: u32
}

// The CST of one parse: nodes in preorder, leaves (token indices) in text
// order, and the token kinds and ranges.
struct Cst {
    nodes: ChunkSeq[Node],
    leaves: ChunkSeq[u32],
    token_kinds: ChunkSeq[u8],
    token_starts: ChunkSeq[u64],
    token_ends: ChunkSeq[u64]
}

fn node_at(in cst: Cst, n: u64) -> Node {
    match cst.nodes.try_get(n) {
        Option::Some(node) => node,
        Option::None => Node { kind: 0, parent: 0, start: 0, end: 0, lo: 0, hi: 0, after: 0 },
    }
}

fn build_cst(in surface: P) -> Cst {
    let mut cst = Cst {
        nodes: ChunkSeq::new[Node](),
        leaves: ChunkSeq::new[u32](),
        token_kinds: ChunkSeq::new[u8](),
        token_starts: ChunkSeq::new[u64](),
        token_ends: ChunkSeq::new[u64]()
    };
    for i in 0..surface.t.kind.len() {
        cst.token_kinds.push(b8(in surface.t.kind, i));
        cst.token_starts.push(w32(in surface.t.start, i));
        cst.token_ends.push(token_end(in surface.t, i));
    }
    let mut open = ChunkSeq::new[u64]();
    let mut offset: u64 = 0;
    for i in 0..surface.ev.len() {
        let event = w32(in surface.ev, i);
        if event == 4294967295 {
            let last = sub(open.len(), 1);
            let open_node = w64(in open, last);
            open.truncate(last);
            let mut node = node_at(in cst, open_node);
            node.end = wrapping_u32(offset);
            node.hi = wrapping_u32(cst.leaves.len());
            node.after = wrapping_u32(cst.nodes.len());
            cst.nodes.try_set(open_node, node);
        } else if event >= 2147483648 {
            let parent = if open.len() == 0 {
                4294967295
            } else {
                wrapping_u32(w64(in open, sub(open.len(), 1)))
            };
            open.push(cst.nodes.len());
            cst.nodes.push(
                Node {
                    kind: wrapping_u8(sub(event, 2147483648)),
                    parent: parent,
                    start: wrapping_u32(offset),
                    end: wrapping_u32(offset),
                    lo: wrapping_u32(cst.leaves.len()),
                    hi: wrapping_u32(cst.leaves.len()),
                    after: 0
                }
            );
        } else {
            offset = w64(in cst.token_ends, event);
            cst.leaves.push(wrapping_u32(event));
        }
    }
    cst
}

fn leaf_tok(in cst: Cst, leaf: u64) -> u64 {
    w32(in cst.leaves, leaf)
}

fn tok_kind(in cst: Cst, tok: u64) -> u8 {
    b8(in cst.token_kinds, tok)
}

fn trivia(in cst: Cst, leaf: u64) -> bool {
    trivia_kind(tok_kind(in cst, leaf_tok(in cst, leaf)))
}

// The leaves of `token_words(node)`: the non-trivia leaves under it.
fn words(in cst: Cst, n: u64) -> ChunkSeq[u64] {
    let node = node_at(in cst, n);
    let mut out = ChunkSeq::new[u64]();
    for leaf in widen_u64(node.lo)..widen_u64(node.hi) {
        if !trivia(in cst, leaf) {
            out.push(leaf);
        }
    }
    out
}

fn leaf_s(in cst: Cst, leaf: u64) -> u64 {
    w64(in cst.token_starts, leaf_tok(in cst, leaf))
}

fn leaf_e(in cst: Cst, leaf: u64) -> u64 {
    w64(in cst.token_ends, leaf_tok(in cst, leaf))
}

fn leaf_k(in cst: Cst, leaf: u64) -> u8 {
    tok_kind(in cst, leaf_tok(in cst, leaf))
}

fn leaf_is(in cst: Cst, in src: ChunkSeq[u8], leaf: u64, in expected: Str) -> bool {
    range_is(in src, leaf_s(in cst, leaf), leaf_e(in cst, leaf), in expected.as_bytes())
}

fn n_start(in cst: Cst, n: u64) -> u64 {
    widen_u64(node_at(in cst, n).start)
}

fn n_end(in cst: Cst, n: u64) -> u64 {
    widen_u64(node_at(in cst, n).end)
}

// `significant_range(node).start`.
fn sig_start(in cst: Cst, n: u64) -> u64 {
    let node = node_at(in cst, n);
    for leaf in widen_u64(node.lo)..widen_u64(node.hi) {
        if !trivia(in cst, leaf) {
            return leaf_s(in cst, leaf);
        }
    }
    widen_u64(node.start)
}

// The first child of `n` of kind `wanted`, or NONE.
fn child_of(in cst: Cst, n: u64, wanted: u8) -> u64 {
    let node = node_at(in cst, n);
    for child in inc(n)..widen_u64(node.after) {
        let child_node = node_at(in cst, child);
        if widen_u64(child_node.parent) == n && child_node.kind == wanted {
            return child;
        }
    }
    NONE
}

fn children_of(in cst: Cst, n: u64, wanted: u8) -> ChunkSeq[u64] {
    let node = node_at(in cst, n);
    let mut out = ChunkSeq::new[u64]();
    for child in inc(n)..widen_u64(node.after) {
        let child_node = node_at(in cst, child);
        if widen_u64(child_node.parent) == n && child_node.kind == wanted {
            out.push(child);
        }
    }
    out
}

fn call_node(kind: u8) -> bool {
    kind == N_SUGAR_ITEM
        || kind == N_SUGAR_PAT
        || kind == N_SUGAR_STMT
        || kind == N_SUGAR_EXPR
        || kind == N_DOTTED_EXPR
        || kind == N_PIPE_EXPR
        || kind == N_TAGGED_LITERAL
}

// `head_range(node)`.
fn head_range(in cst: Cst, n: u64) -> (u64, u64) {
    let op = child_of(in cst, n, N_SUGAR_OPERATOR);
    if op != NONE {
        return (n_start(in cst, op), n_end(in cst, op));
    }
    let start = sig_start(in cst, n);
    (start, inc(start))
}

// `call_key(node)` as a byte range of the source.
fn call_key(in cst: Cst, in src: ChunkSeq[u8], n: u64) -> (u64, u64) {
    let op = child_of(in cst, n, N_SUGAR_OPERATOR);
    if op != NONE {
        return (n_start(in cst, op), n_end(in cst, op));
    }
    let leaves = words(in cst, n);
    let first = w64(in leaves, 0);
    if leaf_is(in cst, in src, first, in "ghost") && leaves.len() > 1 {
        let next = w64(in leaves, 1);
        if leaf_k(in cst, next) == k_lower() {
            return (leaf_s(in cst, next), leaf_e(in cst, next));
        }
    }
    (leaf_s(in cst, first), leaf_e(in cst, first))
}

// The end of the leaves of the tree of `n` in the forest (its root's).
fn tree_end(in cst: Cst, n: u64) -> u64 {
    let mut at = n;
    loop {
        let parent = node_at(in cst, at).parent;
        if parent == 4294967295 {
            break;
        }
        at = widen_u64(parent);
    }
    widen_u64(node_at(in cst, at).hi)
}

// `block_end(node, work)`: the start of the enclosing block's `}`.
fn block_end(in cst: Cst, n: u64, inout work: u64, inout end: u64) -> Dg {
    let node = node_at(in cst, n);
    let mut depth: u64 = 0;
    let first = if node.hi > node.lo {
        widen_u64(node.hi)
    } else {
        tree_end(in cst, n)
    };
    for leaf in first..tree_end(in cst, n) {
        let spent = charge(inout work, 1, n_start(in cst, n), n_end(in cst, n));
        if spent.failed {
            return spent;
        }
        let kind = leaf_k(in cst, leaf);
        if kind == k_l_brace() {
            depth = inc(depth);
        }
        if kind == k_r_brace() {
            if depth == 0 {
                end = leaf_s(in cst, leaf);
                return dg_ok();
            }
            depth = sub(depth, 1);
        }
    }
    diag(in "statement sugar needs an enclosing block", n_start(in cst, n), n_end(in cst, n))
}

// `parse(source, include_tests)`: the CST and diagnostics, or the lexer's
// refusal (`LexLimit::diagnostic(0)`).
struct Parsed {
    cst: Cst,
    // Diagnostics as rows (code, start, end, message first, message length).
    diags: ChunkSeq[u64],
    diag_text: ChunkSeq[u8],
    refused: Dg
}

fn parse(in src: ChunkSeq[u8], include_tests: bool) -> Parsed {
    let mut diags = diags_new();
    let lexed = lex_sugar_with_limits(
        in src.as_slice(),
        inout diags,
        MAX_BYTES,
        HARD_TOKENS,
        max_diagnostics()
    );
    if lexed.rejected {
        let end = if diags.at.len() > 1 {
            w32(in diags.at, 1)
        } else {
            diags.text.len()
        };
        let message = range_of(in diags.text, w32(in diags.at, 0), end);
        return Parsed {
            cst: Cst {
                nodes: ChunkSeq::new[Node](),
                leaves: ChunkSeq::new[u32](),
                token_kinds: ChunkSeq::new[u8](),
                token_starts: ChunkSeq::new[u64](),
                token_ends: ChunkSeq::new[u64]()
            },
            diags: ChunkSeq::new[u64](),
            diag_text: ChunkSeq::new[u8](),
            refused: dg_new(in "E0003", in message, 0, 0)
        };
    }
    let surface = parse_surface_tokens(
        in src.as_slice(),
        lexed,
        diags,
        max_diagnostics(),
        hard_depth(),
        include_tests
    );
    let mut rows = ChunkSeq::new[u64]();
    let mut text = ChunkSeq::new[u8]();
    let n = surface.d.code.len();
    for i in 0..n {
        let msg_start = w32(in surface.d.at, i);
        let msg_end = if inc(i) < n {
            w32(in surface.d.at, inc(i))
        } else {
            surface.d.text.len()
        };
        rows.push(widen_u64(b8(in surface.d.code, i)));
        rows.push(w32(in surface.d.start, i));
        rows.push(w32(in surface.d.end, i));
        rows.push(text.len());
        rows.push(sub(msg_end, msg_start));
        cat_range(inout text, in surface.d.text, msg_start, msg_end);
    }
    Parsed { cst: build_cst(in surface), diags: rows, diag_text: text, refused: dg_ok() }
}

// ---------------------------------------------------------------- definitions

// Definitions and rules as rows over one text pool.
//   def rows (DW): name first, len, sort first, len, symbol first or NONE,
//     len, nonassoc, emits first or NONE, len, rule first, count, key
//     first, count, import
//   rule rows (RW): pattern first, len, head start, end, template first,
//     len, span start, end, tail
//   key rows: first, len
const DW: u64 = 14;
const RW: u64 = 9;

struct Reg {
    pool: ChunkSeq[u8],
    defs: ChunkSeq[u64],
    rules: ChunkSeq[u64],
    keys: ChunkSeq[u64],
    // Bindings: key first, len, def, alias, environment (0 the module's
    // `heads`, k + 1 the definition scope k of `scopes`).
    heads: ChunkSeq[u64],
    // `imported_scope`: each import's definition scope.
    imported_scope: ChunkSeq[u64]
}

const HW: u64 = 5;

fn df(in registry: Reg, def: u64, field: u64) -> u64 {
    w64(in registry.defs, add(wrapping_mul(def, DW), field))
}

fn rf(in registry: Reg, rule: u64, field: u64) -> u64 {
    w64(in registry.rules, add(wrapping_mul(rule, RW), field))
}

fn ndefs(in registry: Reg) -> u64 {
    registry.defs.len() / DW
}

fn pool_text(in registry: Reg, first: u64, len: u64) -> ChunkSeq[u8] {
    range_of(in registry.pool, first, add(first, len))
}

fn pool_push(inout registry: Reg, in src: ChunkSeq[u8], start: u64, end: u64) -> u64 {
    let first = registry.pool.len();
    cat_range(inout registry.pool, in src, start, end);
    first
}

fn pool_is(in registry: Reg, first: u64, len: u64, in expected: Str) -> bool {
    range_is(in registry.pool, first, add(first, len), in expected.as_bytes())
}

fn def_rule(in registry: Reg, def: u64, i: u64) -> u64 {
    add(df(in registry, def, 9), i)
}

// `read_definition(source, decl, import)`.
fn read_definition(
    inout registry: Reg,
    in src: ChunkSeq[u8],
    in cst: Cst,
    decl: u64,
    import: u64
) -> Dg {
    let decl_start = n_start(in cst, decl);
    let decl_end = n_end(in cst, decl);
    let leaves = words(in cst, decl);
    let mut at: u64 = 0;
    loop {
        if at >= leaves.len() || leaf_is(in cst, in src, w64(in leaves, at), in "sugar") {
            break;
        }
        at = inc(at);
    }
    at = inc(at);
    if at >= leaves.len() {
        return diag(in "missing sugar name", decl_start, decl_end);
    }
    let name_leaf = w64(in leaves, at);
    at = inc(at);
    if inc(at) >= leaves.len() {
        return diag(in "missing sugar sort", decl_start, decl_end);
    }
    let sort_leaf = w64(in leaves, inc(at));
    at = add(at, 2);
    let mut header = ChunkSeq::new[u64]();
    loop {
        if at >= leaves.len() || leaf_k(in cst, w64(in leaves, at)) == k_l_brace() {
            break;
        }
        header.push(w64(in leaves, at));
        at = inc(at);
    }
    let op = child_of(in cst, decl, N_SUGAR_OPERATOR);
    let mut nonassoc = false;
    let mut emits_at = NONE;
    for i in 0..header.len() {
        let leaf = w64(in header, i);
        if leaf_is(in cst, in src, leaf, in "none") {
            nonassoc = true;
        }
        if emits_at == NONE && leaf_is(in cst, in src, leaf, in "emits") {
            emits_at = i;
        }
    }
    let mut emits_first = NONE;
    let mut emits_len: u64 = 0;
    if emits_at != NONE {
        let start = leaf_s(in cst, w64(in header, inc(emits_at)));
        let end = leaf_e(in cst, w64(in header, sub(header.len(), 1)));
        let mut wrapped = ChunkSeq::new[u8]();
        cat(inout wrapped, in "fn __sugar_row() ");
        cat_range(inout wrapped, in src, start, end);
        cat(inout wrapped, in " {}");
        let text = match String::from_utf8(in wrapped.as_slice()) {
            Option::Some(decoded) => decoded,
            Option::None => String::new(),
        };
        let lowered = lower_source(in text.as_str());
        if lowered.p.d.code.len() != 0 {
            return diag(in "invalid sugar effect row", decl_start, decl_end);
        }
        let ast = lowered.ast;
        if ast.m_items.len() != 0 {
            let item = item_of(in ast, 0);
            if item.kind == 2 {
                let func = fn_of(in ast, item.node);
                if func.effects != none() {
                    let effects = ast.effects.get_or(
                        idx_from_raw[@vesper/ast::EffectsNode](func.effects),
                        @vesper/ast::EffectsNode { instances: 0, tail: none() }
                    );
                    if effects.tail != none() {
                        return diag(
                            in "sugar emits must declare a closed effect row",
                            decl_start,
                            decl_end
                        );
                    }
                }
                emits_first = pool_push(inout registry, in src, start, end);
                emits_len = sub(end, start);
            }
        }
    }
    // Rules.
    let rule_first = registry.rules.len() / RW;
    let key_first = registry.keys.len() >> 1;
    let rules = children_of(in cst, decl, N_SUGAR_RULE);
    let mut sort = ChunkSeq::new[u8]();
    cat_range(inout sort, in src, leaf_s(in cst, sort_leaf), leaf_e(in cst, sort_leaf));
    for rule_index in 0..rules.len() {
        let rule = w64(in rules, rule_index);
        let pat = child_of(in cst, rule, N_SUGAR_PATTERN);
        let body = child_of(in cst, rule, N_SUGAR_TEMPLATE);
        let pat_start = n_start(in cst, pat);
        let pat_end = n_end(in cst, pat);
        let pat_leaves = words(in cst, pat);
        let mut head_index: u64 = 1;
        let mut head = w64(in pat_leaves, head_index);
        if leaf_is(in cst, in src, head, in "ghost") {
            head_index = inc(head_index);
            if head_index >= pat_leaves.len() {
                return diag(
                    in "missing ghost sugar head",
                    n_start(in cst, rule),
                    n_end(in cst, rule)
                );
            }
            head = w64(in pat_leaves, head_index);
        }
        let (key_start, key_end, key_src) = if op != NONE {
            (n_start(in cst, op), n_end(in cst, op), true)
        } else {
            let head_kind = leaf_k(in cst, head);
            if !(
                head_kind == k_lower()
                    || head_kind == k_state()
                    || head_kind == k_linear()
                    || head_kind == k_with()
                    || head_kind == k_eff()
            ) {
                return diag(in "sugar rule needs a literal head word", pat_start, pat_end);
            }
            (leaf_s(in cst, head), leaf_e(in cst, head), true)
        };
        let mut known = false;
        for key in key_first..(registry.keys.len() >> 1) {
            let key_at = w64(in registry.keys, key << 1);
            let key_len = w64(in registry.keys, inc(key << 1));
            if key_src
                && ranges_eq(
                    in registry.pool,
                    key_at,
                    add(key_at, key_len),
                    in src,
                    key_start,
                    key_end
                ) {
                known = true;
            }
        }
        if !known {
            let key_at = pool_push(inout registry, in src, key_start, key_end);
            registry.keys.push(key_at);
            registry.keys.push(sub(key_end, key_start));
        }
        let text = range_of(in src, inc(pat_start), sub(pat_end, 1));
        let tail = captures_tail(in text);
        if tail && !seq_eq(in sort, in stmt_text()) {
            return diag(
                in "a block-tail hole requires statement sugar",
                n_start(in cst, rule),
                n_end(in cst, rule)
            );
        }
        let pattern_first = pool_push(inout registry, in src, inc(pat_start), sub(pat_end, 1));
        let body_start = n_start(in cst, body);
        let body_end = n_end(in cst, body);
        let template_first = pool_push(inout registry, in src, inc(body_start), sub(body_end, 1));
        registry.rules.push(pattern_first);
        registry.rules.push(sub(sub(pat_end, 1), inc(pat_start)));
        registry.rules.push(sub(sub(leaf_s(in cst, head), pat_start), 1));
        registry.rules.push(sub(sub(leaf_e(in cst, head), pat_start), 1));
        registry.rules.push(template_first);
        registry.rules.push(sub(sub(body_end, 1), inc(body_start)));
        registry.rules.push(n_start(in cst, rule));
        registry.rules.push(n_end(in cst, rule));
        registry.rules.push(if tail { 1 } else { 0 });
    }
    let name_first = pool_push(
        inout registry,
        in src,
        leaf_s(in cst, name_leaf),
        leaf_e(in cst, name_leaf)
    );
    registry.defs.push(name_first);
    registry.defs.push(sub(leaf_e(in cst, name_leaf), leaf_s(in cst, name_leaf)));
    let sort_first = pool_push(
        inout registry,
        in src,
        leaf_s(in cst, sort_leaf),
        leaf_e(in cst, sort_leaf)
    );
    registry.defs.push(sort_first);
    registry.defs.push(sort.len());
    if op != NONE {
        let op_first = pool_push(inout registry, in src, n_start(in cst, op), n_end(in cst, op));
        registry.defs.push(op_first);
        registry.defs.push(sub(n_end(in cst, op), n_start(in cst, op)));
    } else {
        registry.defs.push(NONE);
        registry.defs.push(0);
    }
    registry.defs.push(if nonassoc { 1 } else { 0 });
    registry.defs.push(emits_first);
    registry.defs.push(emits_len);
    registry.defs.push(rule_first);
    registry.defs.push(sub(registry.rules.len() / RW, rule_first));
    registry.defs.push(key_first);
    registry.defs.push(sub(registry.keys.len() >> 1, key_first));
    registry.defs.push(import);
    dg_ok()
}

fn stmt_text() -> ChunkSeq[u8] {
    let mut text = ChunkSeq::new[u8]();
    cat(inout text, in "stmt");
    text
}

fn item_of(in ast: Ast, item_index: u64) -> ItemNode {
    let raw = match ast.m_items.try_get(item_index) {
        Option::Some(id) => id,
        Option::None => none(),
    };
    ast.items.get_or(idx_from_raw[ItemNode](raw), ItemNode { kind: 0, node: 0 })
}

// `bind(defs, env, id, visible)`: `visible` is the pool range of the name
// the definition is bound under, `env` the environment (see `Reg.heads`).
fn bind(inout registry: Reg, id: u64, visible_first: u64, visible_len: u64, env: u64) -> Dg {
    if id >= ndefs(in registry) {
        return diag(in "unknown imported sugar declaration", 0, 0);
    }
    let alias = df(in registry, id, 4) == NONE
        && !ranges_eq(
            in registry.pool,
            visible_first,
            add(visible_first, visible_len),
            in registry.pool,
            df(in registry, id, 0),
            add(df(in registry, id, 0), df(in registry, id, 1))
        );
    let mut keys = ChunkSeq::new[u64]();
    if alias {
        keys.push(visible_first);
        keys.push(visible_len);
    } else {
        let first = df(in registry, id, 11);
        for key in first..add(first, df(in registry, id, 12)) {
            keys.push(w64(in registry.keys, key << 1));
            keys.push(w64(in registry.keys, inc(key << 1)));
        }
    }
    for key in 0..(keys.len() >> 1) {
        let key_first = w64(in keys, key << 1);
        let key_len = w64(in keys, inc(key << 1));
        for head in 0..(registry.heads.len() / HW) {
            let row = wrapping_mul(head, HW);
            let head_first = w64(in registry.heads, row);
            let head_len = w64(in registry.heads, inc(row));
            if w64(in registry.heads, add(row, 4)) == env
                && ranges_eq(
                    in registry.pool,
                    head_first,
                    add(head_first, head_len),
                    in registry.pool,
                    key_first,
                    add(key_first, key_len)
                ) {
                let mut message = ChunkSeq::new[u8]();
                cat(inout message, in "duplicate sugar binding for `");
                cat_range(inout message, in registry.pool, key_first, add(key_first, key_len));
                message.push(96);
                let rule = def_rule(in registry, id, 0);
                return diag_seq(in message, rf(in registry, rule, 6), rf(in registry, rule, 7));
            }
        }
        registry.heads.push(key_first);
        registry.heads.push(key_len);
        registry.heads.push(id);
        registry.heads.push(if alias { 1 } else { 0 });
        registry.heads.push(env);
    }
    dg_ok()
}

// `Registry::get(key, call, author)`: the definition, or NONE with `err`
// set; `alias` is set for an alias binding.
fn lookup(
    in registry: Reg,
    in src: ChunkSeq[u8],
    key_start: u64,
    key_end: u64,
    call_start: u64,
    call_end: u64,
    author: u64,
    inout alias: bool,
    inout err: Dg
) -> u64 {
    let env = if author != NONE && author < registry.imported_scope.len() {
        inc(w64(in registry.imported_scope, author))
    } else {
        0
    };
    for head in 0..(registry.heads.len() / HW) {
        let row = wrapping_mul(head, HW);
        let head_first = w64(in registry.heads, row);
        let head_len = w64(in registry.heads, inc(row));
        if w64(in registry.heads, add(row, 4)) == env
            && ranges_eq(
                in registry.pool,
                head_first,
                add(head_first, head_len),
                in src,
                key_start,
                key_end
            ) {
            alias = w64(in registry.heads, add(row, 3)) == 1;
            return w64(in registry.heads, add(row, 2));
        }
    }
    let mut message = ChunkSeq::new[u8]();
    cat(inout message, in "unresolved sugar `");
    cat_range(inout message, in src, key_start, key_end);
    message.push(96);
    err = dg_new(in "E0142", in message, call_start, call_end);
    NONE
}

// `author(state, node)`: the import of the innermost region whose text
// (outside its holes) holds the head `hs..he`, or NONE.
fn author(in state: St, head_start: u64, head_end: u64) -> u64 {
    let mut best = NONE;
    let mut best_len = NONE;
    let mut region = nregs(in state);
    loop {
        if region == 0 {
            break;
        }
        region = sub(region, 1);
        let region_start = rg(in state, region, 0);
        let region_end = rg(in state, region, 1);
        if !(region_start <= head_start && head_end <= region_end) {
            continue;
        }
        let mut in_hole = false;
        let hole_first = rg(in state, region, 2);
        for hole in hole_first..add(hole_first, rg(in state, region, 3)) {
            if w64(in state.holes, hole << 1) <= head_start
                && head_end <= w64(in state.holes, inc(hole << 1)) {
                in_hole = true;
            }
        }
        if in_hole {
            continue;
        }
        // `min_by_key` keeps the first minimum, here the latest region.
        let len = sub(region_end, region_start);
        if best == NONE || len < best_len {
            best = region;
            best_len = len;
        }
    }
    if best == NONE {
        NONE
    } else {
        rg(in state, best, 11)
    }
}

fn sort_is(in registry: Reg, def: u64, in sort_name: Str) -> bool {
    pool_is(in registry, df(in registry, def, 2), df(in registry, def, 3), in sort_name)
}

// `fits_sort(kind, sort)`.
fn fits_sort(in registry: Reg, kind: u8, def: u64) -> bool {
    if kind == N_SUGAR_ITEM {
        sort_is(in registry, def, in "item")
    } else if kind == N_SUGAR_PAT {
        sort_is(in registry, def, in "pat")
    } else if kind == N_SUGAR_STMT {
        sort_is(in registry, def, in "stmt") || sort_is(in registry, def, in "expr")
    } else if kind == N_SUGAR_EXPR {
        sort_is(in registry, def, in "expr")
    } else if kind == N_PIPE_EXPR || kind == N_DOTTED_EXPR {
        sort_is(in registry, def, in "infix")
    } else if kind == N_TAGGED_LITERAL {
        sort_is(in registry, def, in "tag")
    } else {
        false
    }
}

// `operator_level(def)`: the Pratt level of its symbol, 0 for none.
fn operator_level(in registry: Reg, def: u64) -> u64 {
    if df(in registry, def, 4) == NONE {
        return 0;
    }
    let text = pool_text(in registry, df(in registry, def, 4), df(in registry, def, 5));
    let mut diags = diags_new();
    let lexed = lex_sugar_raw_with_limits(
        in text.as_slice(),
        inout diags,
        max_source_bytes(),
        max_tokens(),
        max_diagnostics()
    );
    if lexed.rejected || lexed.kind.len() < 2 {
        return 0;
    }
    if token_end(in lexed, 0) != w32(in lexed.start, 1) {
        return 0;
    }
    let head = b8(in lexed.kind, 0);
    let next = b8(in lexed.kind, 1);
    if head == k_pipe() {
        if next == k_gt() {
            return 3;
        }
        if next == k_question()
            && lexed.kind.len() > 2
            && b8(in lexed.kind, 2) == k_gt()
            && token_end(in lexed, 1) == w32(in lexed.start, 2) {
            return 3;
        }
        return 0;
    }
    if head != k_dot() {
        return 0;
    }
    if next == k_eq_eq() || next == k_ne() {
        8
    } else if next == k_lt()
        || next == k_le()
        || next == k_shl()
        || next == k_gt()
        || next == k_ge()
        || next == k_shr() {
        10
    } else if next == k_pipe() || next == k_pipe_eq() || next == k_or() {
        12
    } else if next == k_caret() {
        14
    } else if next == k_amp() || next == k_amp_eq() || next == k_and() {
        16
    } else if next == k_plus()
        || next == k_minus()
        || next == k_plus_eq()
        || next == k_minus_eq()
        || next == k_arrow() {
        20
    } else if next == k_star()
        || next == k_slash()
        || next == k_percent()
        || next == k_star_eq()
        || next == k_slash_eq()
        || next == k_percent_eq() {
        22
    } else {
        0
    }
}

// ---------------------------------------------------------------- state

// `ExpandedSugar`. Mappings are rows (expanded start, end, original start,
// end, copied); regions rows of RG words: expanded start, end, hole first,
// count, place first, count, definition, call start, end, rule start, end,
// import (NONE for none).
const RG: u64 = 12;

pub struct St {
    src: ChunkSeq[u8],
    mark: ChunkSeq[u8],
    maps: ChunkSeq[u64],
    regions: ChunkSeq[u64],
    holes: ChunkSeq[u64],
    places: ChunkSeq[u64]
}

fn nmaps(in state: St) -> u64 {
    state.maps.len() / 5
}

fn mp(in state: St, row: u64, field: u64) -> u64 {
    w64(in state.maps, add(wrapping_mul(row, 5), field))
}

fn nregs(in state: St) -> u64 {
    state.regions.len() / RG
}

fn rg(in state: St, region: u64, field: u64) -> u64 {
    w64(in state.regions, add(wrapping_mul(region, RG), field))
}

fn clamp(value: u64, lo: u64, hi: u64) -> u64 {
    if value < lo {
        lo
    } else if value > hi {
        hi
    } else {
        value
    }
}

// `SugarSourceSpan::project(range)` of mapping row `map_row` of `maps`.
fn project(in maps: ChunkSeq[u64], map_row: u64, start: u64, end: u64) -> (u64, u64) {
    let row = wrapping_mul(map_row, 5);
    let exp_start = w64(in maps, row);
    let exp_end = w64(in maps, inc(row));
    let orig_start = w64(in maps, add(row, 2));
    let orig_end = w64(in maps, add(row, 3));
    if w64(in maps, add(row, 4)) == 0 {
        return (orig_start, orig_end);
    }
    (
        sub(add(orig_start, clamp(start, exp_start, exp_end)), exp_start),
        sub(add(orig_start, clamp(end, exp_start, exp_end)), exp_start)
    )
}

// `ExpandedSugar::original_span(span)`.
fn original_span(in state: St, start: u64, end: u64) -> (u64, u64) {
    let n = nmaps(in state);
    let mut first_map: u64 = 0;
    loop {
        if first_map >= n || mp(in state, first_map, 1) > start {
            break;
        }
        first_map = inc(first_map);
    }
    if first_map < n {
        let (first_start, first_end) = project(in state.maps, first_map, start, start);
        if start == end {
            return (first_start, first_end);
        }
        let mut end_map: u64 = 0;
        loop {
            if end_map >= n || mp(in state, end_map, 0) >= end {
                break;
            }
            end_map = inc(end_map);
        }
        let last = if end_map == 0 { 0 } else { sub(end_map, 1) };
        let (last_start, last_end) = project(in state.maps, last, end, end);
        let lo = if first_start < last_start {
            first_start
        } else {
            last_start
        };
        let hi = if first_end > last_end {
            first_end
        } else {
            last_end
        };
        return (lo, hi);
    }
    if n == 0 {
        return (0, 0);
    }
    let orig_end = mp(in state, sub(n, 1), 3);
    (orig_end, orig_end)
}

// An edit (`Edit`): rows of EW words: old start, end, text first, length,
// region (0 none, 1 some), region expanded start, end, hole first, count,
// place first, count, definition, call start, end, rule start, end, copy
// first, count, origin start, end, import (NONE for none). Texts, holes, places and copies (new
// start, end, prior start, end) live in the pools of `Eds`.
const EW: u64 = 21;

struct Eds {
    rows: ChunkSeq[u64],
    text: ChunkSeq[u8],
    holes: ChunkSeq[u64],
    places: ChunkSeq[u64],
    copies: ChunkSeq[u64]
}

fn eds_new() -> Eds {
    Eds {
        rows: ChunkSeq::new[u64](),
        text: ChunkSeq::new[u8](),
        holes: ChunkSeq::new[u64](),
        places: ChunkSeq::new[u64](),
        copies: ChunkSeq::new[u64]()
    }
}

fn ed(in edits: Eds, edit: u64, field: u64) -> u64 {
    w64(in edits.rows, add(wrapping_mul(edit, EW), field))
}

fn neds(in edits: Eds) -> u64 {
    edits.rows.len() / EW
}

// A plain edit: no region, no copies.
fn push_plain(
    inout edits: Eds,
    old_start: u64,
    old_end: u64,
    in text: ChunkSeq[u8],
    origin_start: u64,
    origin_end: u64
) {
    edits.rows.push(old_start);
    edits.rows.push(old_end);
    edits.rows.push(edits.text.len());
    edits.rows.push(text.len());
    cat_seq(inout edits.text, in text);
    for k in 0..12 {
        edits.rows.push(0);
    }
    edits.rows.push(edits.copies.len() >> 2);
    edits.rows.push(0);
    edits.rows.push(origin_start);
    edits.rows.push(origin_end);
    edits.rows.push(NONE);
}

// The spans `project(r)` yields for region spans under edit `edit_index`.
fn project_span(
    in edits: Eds,
    edit_index: u64,
    span_start: u64,
    span_end: u64,
    inout out: ChunkSeq[u64]
) {
    let old_start = ed(in edits, edit_index, 0);
    let old_end = ed(in edits, edit_index, 1);
    let end = add(old_start, ed(in edits, edit_index, 3));
    if span_end <= old_start {
        out.push(span_start);
        out.push(span_end);
        return;
    }
    if span_start >= old_end {
        out.push(add(end, sub(span_start, old_end)));
        out.push(add(end, sub(span_end, old_end)));
        return;
    }
    if span_start <= old_start && span_end >= old_end {
        out.push(span_start);
        out.push(add(end, sub(span_end, old_end)));
        return;
    }
    if span_start < old_start {
        out.push(span_start);
        out.push(old_start);
    }
    let copy_first = ed(in edits, edit_index, 16);
    for copy in 0..ed(in edits, edit_index, 17) {
        let row = add(copy_first, copy) << 2;
        let new_start = w64(in edits.copies, row);
        let new_end = w64(in edits.copies, inc(row));
        let prior_start = w64(in edits.copies, add(row, 2));
        let prior_end = w64(in edits.copies, add(row, 3));
        let lo = if span_start > prior_start {
            span_start
        } else {
            prior_start
        };
        let hi = if span_end < prior_end {
            span_end
        } else {
            prior_end
        };
        if lo < hi && sub(new_end, new_start) == sub(prior_end, prior_start) {
            let base = add(old_start, new_start);
            out.push(add(base, sub(lo, prior_start)));
            out.push(add(base, sub(hi, prior_start)));
        }
    }
    if span_end > old_end {
        out.push(end);
        out.push(add(end, sub(span_end, old_end)));
    }
}

// `emit(from, to)` of `apply`: the old mappings over `from` moved to `to`.
fn emit_maps(in state: St, from_start: u64, from_end: u64, to: u64, inout out: ChunkSeq[u64]) {
    let n = nmaps(in state);
    for map_row in 0..n {
        let exp_start = mp(in state, map_row, 0);
        let exp_end = mp(in state, map_row, 1);
        if exp_end <= from_start {
            continue;
        }
        if exp_start >= from_end {
            break;
        }
        let lo = if exp_start > from_start {
            exp_start
        } else {
            from_start
        };
        let hi = if exp_end < from_end {
            exp_end
        } else {
            from_end
        };
        if lo < hi {
            let (orig_start, orig_end) = project(in state.maps, map_row, lo, hi);
            out.push(sub(add(to, lo), from_start));
            out.push(sub(add(to, hi), from_start));
            out.push(orig_start);
            out.push(orig_end);
            out.push(mp(in state, map_row, 4));
        }
    }
}

// `ExpandedSugar::apply(edit, work)` of edit `edit_index`.
fn apply(inout state: St, in edits: Eds, edit_index: u64, inout work: u64) -> Dg {
    let old_start = ed(in edits, edit_index, 0);
    let old_end = ed(in edits, edit_index, 1);
    let text_first = ed(in edits, edit_index, 2);
    let text_len = ed(in edits, edit_index, 3);
    let origin_start = ed(in edits, edit_index, 18);
    let origin_end = ed(in edits, edit_index, 19);
    let ncopies = ed(in edits, edit_index, 17);
    let end = add(old_start, text_len);
    let size = add(sub(state.src.len(), sub(old_end, old_start)), text_len);
    if size > MAX_BYTES {
        return limit(origin_start, origin_end);
    }
    let spent = charge(
        inout work,
        add(add(size, nmaps(in state)), nregs(in state)),
        origin_start,
        origin_end
    );
    if spent.failed {
        return spent;
    }
    let mut regs = ChunkSeq::new[u64]();
    let mut holes = ChunkSeq::new[u64]();
    let mut places = ChunkSeq::new[u64]();
    for region in 0..nregs(in state) {
        let hole_first = rg(in state, region, 2);
        let hole_count = rg(in state, region, 3);
        let place_first = rg(in state, region, 4);
        let place_count = rg(in state, region, 5);
        let units = wrapping_mul(add(add(1, hole_count), place_count), inc(ncopies));
        let spent_region = charge(inout work, units, origin_start, origin_end);
        if spent_region.failed {
            return spent_region;
        }
        let mut spans = ChunkSeq::new[u64]();
        project_span(
            in edits,
            edit_index,
            rg(in state, region, 0),
            rg(in state, region, 1),
            inout spans
        );
        let new_hole_first = holes.len() >> 1;
        for hole in hole_first..add(hole_first, hole_count) {
            let mut projected = ChunkSeq::new[u64]();
            project_span(
                in edits,
                edit_index,
                w64(in state.holes, hole << 1),
                w64(in state.holes, inc(hole << 1)),
                inout projected
            );
            holes.extend(in projected.as_slice());
        }
        let new_hole_count = sub(holes.len() >> 1, new_hole_first);
        let new_place_first = places.len() / 3;
        for place in place_first..add(place_first, place_count) {
            let row = wrapping_mul(place, 3);
            let mut projected = ChunkSeq::new[u64]();
            project_span(
                in edits,
                edit_index,
                w64(in state.places, row),
                w64(in state.places, inc(row)),
                inout projected
            );
            for span in 0..(projected.len() >> 1) {
                places.push(w64(in projected, span << 1));
                places.push(w64(in projected, inc(span << 1)));
                places.push(w64(in state.places, add(row, 2)));
            }
        }
        let new_place_count = sub(places.len() / 3, new_place_first);
        for span in 0..(spans.len() >> 1) {
            regs.push(w64(in spans, span << 1));
            regs.push(w64(in spans, inc(span << 1)));
            regs.push(new_hole_first);
            regs.push(new_hole_count);
            regs.push(new_place_first);
            regs.push(new_place_count);
            for col in 6..RG {
                regs.push(rg(in state, region, col));
            }
        }
    }
    let mut maps = ChunkSeq::new[u64]();
    emit_maps(in state, 0, old_start, 0, inout maps);
    let copy_first = ed(in edits, edit_index, 16);
    for copy in 0..ncopies {
        let row = add(copy_first, copy) << 2;
        let new_start = w64(in edits.copies, row);
        let new_end = w64(in edits.copies, inc(row));
        let prior_start = w64(in edits.copies, add(row, 2));
        let prior_end = w64(in edits.copies, add(row, 3));
        if sub(new_end, new_start) == sub(prior_end, prior_start) {
            emit_maps(in state, prior_start, prior_end, add(old_start, new_start), inout maps);
        }
    }
    emit_maps(in state, old_end, state.src.len(), end, inout maps);
    let mut complete = ChunkSeq::new[u64]();
    let mut fill: u64 = 0;
    for map_row in 0..(maps.len() / 5) {
        let row = wrapping_mul(map_row, 5);
        let exp_start = w64(in maps, row);
        if fill < exp_start {
            complete.push(fill);
            complete.push(exp_start);
            complete.push(origin_start);
            complete.push(origin_end);
            complete.push(0);
        }
        fill = w64(in maps, inc(row));
        for col in 0..5 {
            complete.push(w64(in maps, add(row, col)));
        }
    }
    if fill < size {
        complete.push(fill);
        complete.push(size);
        complete.push(origin_start);
        complete.push(origin_end);
        complete.push(0);
    }
    state.maps = complete;
    let mut text = ChunkSeq::new[u8]();
    cat_range(inout text, in state.src, 0, old_start);
    cat_range(inout text, in edits.text, text_first, add(text_first, text_len));
    cat_range(inout text, in state.src, old_end, state.src.len());
    state.src = text;
    if ed(in edits, edit_index, 4) == 1 {
        let hole_first = ed(in edits, edit_index, 7);
        let hole_count = ed(in edits, edit_index, 8);
        let place_first = ed(in edits, edit_index, 9);
        let place_count = ed(in edits, edit_index, 10);
        regs.push(ed(in edits, edit_index, 5));
        regs.push(ed(in edits, edit_index, 6));
        regs.push(holes.len() >> 1);
        regs.push(hole_count);
        regs.push(places.len() / 3);
        regs.push(place_count);
        for hole in hole_first..add(hole_first, hole_count) {
            holes.push(w64(in edits.holes, hole << 1));
            holes.push(w64(in edits.holes, inc(hole << 1)));
        }
        for place in place_first..add(place_first, place_count) {
            for col in 0..3 {
                places.push(w64(in edits.places, add(wrapping_mul(place, 3), col)));
            }
        }
        regs.push(ed(in edits, edit_index, 11));
        regs.push(ed(in edits, edit_index, 12));
        regs.push(ed(in edits, edit_index, 13));
        regs.push(ed(in edits, edit_index, 14));
        regs.push(ed(in edits, edit_index, 15));
        regs.push(ed(in edits, edit_index, 20));
    }
    state.regions = regs;
    state.holes = holes;
    state.places = places;
    dg_ok()
}

// The `__vesper_sugar_<n>_` numbers that `src` uses, added to `used`.
fn collect_used(in src: ChunkSeq[u8], inout used: ChunkSeq[u64]) {
    let base = "__vesper_sugar_".as_bytes();
    let n = src.len();
    let base_len = base.len();
    let mut at: u64 = 0;
    loop {
        if add(at, base_len) > n {
            break;
        }
        let mut hit = true;
        for j in 0..base_len {
            let byte = match base.try_get(j) {
                Option::Some(byte) => byte,
                Option::None => 0,
            };
            if b8(in src, add(at, j)) != byte {
                hit = false;
                break;
            }
        }
        if !hit {
            at = inc(at);
            continue;
        }
        let tail = add(at, base_len);
        let mut digits_end = tail;
        loop {
            if digits_end >= n {
                break;
            }
            let byte = b8(in src, digits_end);
            if byte < 48 || byte > 57 {
                break;
            }
            digits_end = inc(digits_end);
        }
        if digits_end > tail && digits_end < n && b8(in src, digits_end) == 95 {
            // `tail[..n].parse::<usize>()`: digits past usize overflow
            // and are ignored.
            let mut value: u64 = 0;
            let mut ok = true;
            for q in tail..digits_end {
                let digit = sub(widen_u64(b8(in src, q)), 48);
                if value > 1844674407370955161 || value == 1844674407370955161 && digit > 5 {
                    ok = false;
                    break;
                }
                value = add(wrapping_mul(value, 10), digit);
            }
            if ok {
                let mut seen = false;
                for q in 0..used.len() {
                    if w64(in used, q) == value {
                        seen = true;
                    }
                }
                if !seen {
                    used.push(value);
                }
            }
        }
        // `match_indices` does not overlap.
        at = tail;
    }
}

// `fresh_prefix(once(source).chain(imports' declarations))`.
fn fresh_prefix(in src: ChunkSeq[u8], in imports: Imports) -> ChunkSeq[u8] {
    let mut used = ChunkSeq::new[u64]();
    collect_used(in src, inout used);
    for i in 0..n_imports(in imports) {
        let decl = import_decl(in imports, i);
        collect_used(in decl, inout used);
    }
    let mut id: u64 = 0;
    loop {
        let mut seen = false;
        for q in 0..used.len() {
            if w64(in used, q) == id {
                seen = true;
            }
        }
        if !seen {
            break;
        }
        id = inc(id);
    }
    let mut out = ChunkSeq::new[u8]();
    cat(inout out, in "__vesper_sugar_");
    push_decimal(inout out, id);
    out.push(95);
    out
}

// ---------------------------------------------------------------- imports

// The caller's imports (`expand_sugar_with_scopes_for_execution`): texts
// over one pool. `rows`: alias first, length, declaration first, length
// per import. `scope_of`: each import's definition scope, as an index into
// `scopes`, or empty for none. `scopes`: (first, count) rows over `names`,
// rows of (name first, length, import). `visible`: the imports visible
// under their alias.
pub struct Imports {
    text: ChunkSeq[u8],
    rows: ChunkSeq[u64],
    scope_of: ChunkSeq[u64],
    scopes: ChunkSeq[u64],
    names: ChunkSeq[u64],
    visible: ChunkSeq[u64]
}

pub fn imports_none() -> Imports {
    Imports {
        text: ChunkSeq::new[u8](),
        rows: ChunkSeq::new[u64](),
        scope_of: ChunkSeq::new[u64](),
        scopes: ChunkSeq::new[u64](),
        names: ChunkSeq::new[u64](),
        visible: ChunkSeq::new[u64]()
    }
}

fn n_imports(in imports: Imports) -> u64 {
    imports.rows.len() >> 2
}

fn import_decl(in imports: Imports, i: u64) -> ChunkSeq[u8] {
    let decl_first = w64(in imports.rows, add(i << 2, 2));
    range_of(in imports.text, decl_first, add(decl_first, w64(in imports.rows, add(i << 2, 3))))
}

// The prologue of `expand_sugar_with_scopes_for_execution`: read the
// imported definitions, bind the visible ones, and build the definition
// scopes.
fn read_imports(inout registry: Reg, in imports: Imports, inout work: u64) -> Dg {
    let n = n_imports(in imports);
    if imports.scope_of.len() != 0 && imports.scope_of.len() != n {
        return diag(in "incomplete sugar definition scopes", 0, 0);
    }
    for i in 0..n {
        let decl = import_decl(in imports, i);
        let spent = charge(inout work, decl.len(), 0, 0);
        if spent.failed {
            return spent;
        }
        let parsed = parse(in decl, true);
        if parsed.refused.failed {
            return parsed.refused;
        }
        if parsed.diags.len() != 0 {
            let code = w64(in parsed.diags, 0);
            let first = w64(in parsed.diags, 3);
            let message = range_of(in parsed.diag_text, first, add(first, w64(in parsed.diags, 4)));
            let code_name = if code == 1 {
                "E0001"
            } else if code == 2 {
                "E0002"
            } else {
                "E0003"
            };
            return dg_new(
                in code_name,
                in message,
                w64(in parsed.diags, 1),
                w64(in parsed.diags, 2)
            );
        }
        let mut found = NONE;
        for node in 0..parsed.cst.nodes.len() {
            if node_at(in parsed.cst, node).kind == N_SUGAR_DECL {
                found = node;
                break;
            }
        }
        if found == NONE {
            return diag(in "imported sugar binding is missing its declaration", 0, 0);
        }
        let read_result = read_definition(inout registry, in decl, in parsed.cst, found, i);
        if read_result.failed {
            return read_result;
        }
    }
    for visible in 0..imports.visible.len() {
        let id = w64(in imports.visible, visible);
        if id >= n {
            return diag(in "invalid sugar import", 0, 0);
        }
        let alias_first = w64(in imports.rows, id << 2);
        let visible_first = pool_push(
            inout registry,
            in imports.text,
            alias_first,
            add(alias_first, w64(in imports.rows, inc(id << 2)))
        );
        let bound = bind(inout registry, id, visible_first, w64(in imports.rows, inc(id << 2)), 0);
        if bound.failed {
            return bound;
        }
    }
    // One environment per distinct scope, numbered by first use.
    let mut made = ChunkSeq::new[u64]();
    for i in 0..imports.scope_of.len() {
        let scope = w64(in imports.scope_of, i);
        let mut index = NONE;
        for candidate in 0..made.len() {
            if w64(in made, candidate) == scope {
                index = candidate;
            }
        }
        if index == NONE {
            index = made.len();
            made.push(scope);
            let first = w64(in imports.scopes, scope << 1);
            for name_row in first..add(first, w64(in imports.scopes, inc(scope << 1))) {
                let row = wrapping_mul(name_row, 3);
                let name_first = w64(in imports.names, row);
                let name_len = w64(in imports.names, inc(row));
                let spent = charge(inout work, inc(name_len), 0, 0);
                if spent.failed {
                    return spent;
                }
                let visible_first = pool_push(
                    inout registry,
                    in imports.text,
                    name_first,
                    add(name_first, name_len)
                );
                let bound = bind(
                    inout registry,
                    w64(in imports.names, add(row, 2)),
                    visible_first,
                    name_len,
                    inc(index)
                );
                if bound.failed {
                    return bound;
                }
            }
        }
        registry.imported_scope.push(index);
    }
    dg_ok()
}

// ---------------------------------------------------------------- expansion

fn mapped_diag(in state: St, in parsed: Parsed, i: u64) -> Dg {
    let row = wrapping_mul(i, 5);
    let code = w64(in parsed.diags, row);
    let start = w64(in parsed.diags, inc(row));
    let end = w64(in parsed.diags, add(row, 2));
    let first = w64(in parsed.diags, add(row, 3));
    let len = w64(in parsed.diags, add(row, 4));
    let message = range_of(in parsed.diag_text, first, add(first, len));
    let (orig_start, orig_end) = original_span(in state, start, end);
    let mut result = if code == 1 {
        dg_new(in "E0001", in message, orig_start, orig_end)
    } else if code == 2 {
        dg_new(in "E0002", in message, orig_start, orig_end)
    } else {
        dg_new(in "E0003", in message, orig_start, orig_end)
    };
    let mut region = nregs(in state);
    loop {
        if region == 0 {
            break;
        }
        region = sub(region, 1);
        if rg(in state, region, 0) <= start && start <= rg(in state, region, 1) {
            related(
                inout result,
                rg(in state, region, 9),
                rg(in state, region, 10),
                in "expanded from this sugar rule"
            );
            break;
        }
    }
    result
}

// The outcome of `expand`: a diagnostic, nothing to expand, or the state.
pub struct Ex {
    diag: Dg,
    changed: bool,
    state: St,
    registry: Reg
}

fn ex_err(sink outcome: Dg, sink state: St, sink registry: Reg) -> Ex {
    Ex { diag: outcome, changed: false, state: state, registry: registry }
}

// `expand_sugar_with_scopes_for_execution(source, imports, scopes,
// visible, include_tests)`, with the imports, scopes and visible list in
// `imports` (`imports_none()` for `expand_sugar_for_execution`).
pub fn expand(in source: ChunkSeq[u8], in imports: Imports, include_tests: bool) -> Ex {
    let mut registry = Reg {
        pool: ChunkSeq::new[u8](),
        defs: ChunkSeq::new[u64](),
        rules: ChunkSeq::new[u64](),
        keys: ChunkSeq::new[u64](),
        heads: ChunkSeq::new[u64](),
        imported_scope: ChunkSeq::new[u64]()
    };
    let mut state = St {
        src: ChunkSeq::new[u8](),
        mark: ChunkSeq::new[u8](),
        maps: ChunkSeq::new[u64](),
        regions: ChunkSeq::new[u64](),
        holes: ChunkSeq::new[u64](),
        places: ChunkSeq::new[u64]()
    };
    if source.len() > MAX_BYTES || n_imports(in imports) > MAX_STEPS {
        return ex_err(limit(0, 0), state, registry);
    }
    let mut work = WORK;
    let import_result = read_imports(inout registry, in imports, inout work);
    if import_result.failed {
        return ex_err(import_result, state, registry);
    }
    state.mark = fresh_prefix(in source, in imports);
    cat_seq(inout state.src, in source);
    state.maps.push(0);
    state.maps.push(source.len());
    state.maps.push(0);
    state.maps.push(source.len());
    state.maps.push(1);
    let mut changed = false;
    let mut steps: u64 = 0;
    for depth in 0..inc(MAX_DEPTH) {
        let spent = charge(inout work, state.src.len(), 0, 0);
        if spent.failed {
            return ex_err(spent, state, registry);
        }
        let parsed = parse(in state.src, include_tests);
        if parsed.refused.failed {
            return ex_err(parsed.refused, state, registry);
        }
        let mut decls = ChunkSeq::new[u64]();

        let mut calls = ChunkSeq::new[u64]();
        let mut starts = ChunkSeq::new[u64]();
        for node_index in 0..parsed.cst.nodes.len() {
            let kind = node_at(in parsed.cst, node_index).kind;
            if kind == N_SUGAR_DECL {
                decls.push(node_index);
            }
            if call_node(kind) {
                calls.push(node_index);
                starts.push(sig_start(in parsed.cst, node_index));
            }
        }
        let has_calls = calls.len() != 0;
        if parsed.diags.len() != 0 {
            if !changed && decls.len() == 0 && !has_calls {
                let mut out = ex_err(dg_ok(), state, registry);
                out.changed = false;
                return out;
            }
            let failure = mapped_diag(in state, in parsed, 0);
            return ex_err(failure, state, registry);
        }
        let cst = parsed.cst;
        if !has_calls && decls.len() == 0 {
            if changed {
                let protected = protect(inout state, include_tests, inout work);
                if protected.failed {
                    return ex_err(protected, state, registry);
                }
            }
            let mut out = ex_err(dg_ok(), state, registry);
            out.changed = changed;
            return out;
        }
        if depth == MAX_DEPTH {
            let region_count = nregs(in state);
            let failure = if region_count == 0 {
                limit(0, 0)
            } else {
                limit(rg(in state, sub(region_count, 1), 7), rg(in state, sub(region_count, 1), 8))
            };
            return ex_err(failure, state, registry);
        }
        let mut edits = eds_new();
        for decl_index in 0..decls.len() {
            let decl = w64(in decls, decl_index);
            if changed {
                let (orig_start, orig_end) = original_span(
                    in state,
                    n_start(in cst, decl),
                    n_end(in cst, decl)
                );
                return ex_err(
                    diag(
                        in "a sugar template cannot introduce new sugar declarations",
                        orig_start,
                        orig_end
                    ),
                    state,
                    registry
                );
            }
            let read_result = read_definition(inout registry, in state.src, in cst, decl, NONE);
            if read_result.failed {
                return ex_err(read_result, state, registry);
            }
            let id = sub(ndefs(in registry), 1);
            let bound = bind(inout registry, id, df(in registry, id, 0), df(in registry, id, 1), 0);
            if bound.failed {
                return ex_err(bound, state, registry);
            }
            let mut space = ChunkSeq::new[u8]();
            space.push(32);
            push_plain(
                inout edits,
                n_start(in cst, decl),
                n_end(in cst, decl),
                in space,
                n_start(in cst, decl),
                n_end(in cst, decl)
            );
        }
        let mut skip_to: u64 = 0;
        // Pending calls as forest nodes; nested reparses join the forest.
        let mut pending = ChunkSeq::new[u64]();
        for q in 0..calls.len() {
            pending.push(w64(in calls, q));
        }
        let mut forest = cst;
        let mut head: u64 = 0;
        loop {
            if head >= pending.len() {
                break;
            }
            let node = w64(in pending, head);
            head = inc(head);
            let step = expand_call(
                inout state,
                inout registry,
                inout forest,
                node,
                in starts,
                inout edits,
                inout skip_to,
                inout steps,
                inout work,
                include_tests
            );
            if step.diag.failed {
                return ex_err(step.diag, state, registry);
            }
            if step.calls.len() != 0 {
                // Splice the nested calls in front of the queue, in order.
                let mut front = ChunkSeq::new[u64]();
                for q in 0..step.calls.len() {
                    front.push(w64(in step.calls, q));
                }
                for q in head..pending.len() {
                    front.push(w64(in pending, q));
                }
                pending = front;
                head = 0;
            }
        }
        // `edits.sort_by_key(|e| e.old.start)` then apply from the last.
        let edit_count = neds(in edits);
        let mut order = ChunkSeq::new[u64]();
        for i in 0..edit_count {
            let edit_start = ed(in edits, i, 0);
            let mut at = order.len();
            loop {
                if at == 0 || ed(in edits, w64(in order, sub(at, 1)), 0) <= edit_start {
                    break;
                }
                at = sub(at, 1);
            }
            order.push(0);
            let mut slot = sub(order.len(), 1);
            loop {
                if slot <= at {
                    break;
                }
                order.try_set(slot, w64(in order, sub(slot, 1)));
                slot = sub(slot, 1);
            }
            order.try_set(at, i);
        }
        let mut rank = edit_count;
        loop {
            if rank == 0 {
                break;
            }
            rank = sub(rank, 1);
            let applied = apply(inout state, in edits, w64(in order, rank), inout work);
            if applied.failed {
                return ex_err(applied, state, registry);
            }
        }
        changed = true;
    }
    ex_err(limit(0, 0), state, registry)
}

struct Step {
    diag: Dg,
    // Nested uses to run first, as forest nodes.
    calls: ChunkSeq[u64]
}

fn step_ok() -> Step {
    Step { diag: dg_ok(), calls: ChunkSeq::new[u64]() }
}

fn step_err(sink outcome: Dg) -> Step {
    let mut step = step_ok();
    step.diag = outcome;
    step
}

fn step_msg(
    in msg: ChunkSeq[u8],
    orig_start: u64,
    orig_end: u64,
    rule_start: u64,
    rule_end: u64,
    in label: Str
) -> Step {
    let mut result = diag_seq(in msg, orig_start, orig_end);
    related(inout result, rule_start, rule_end, in label);
    step_err(result)
}

// The body of the `while let Some(node) = pending.pop_front()` loop.
fn expand_call(
    inout state: St,
    inout registry: Reg,
    inout cst: Cst,
    node: u64,
    in starts: ChunkSeq[u64],
    inout edits: Eds,
    inout skip_to: u64,
    inout steps: u64,
    inout work: u64,
    include_tests: bool
) -> Step {
    let kind = node_at(in cst, node).kind;
    if n_start(in cst, node) < skip_to {
        return step_ok();
    }
    let call_start = sig_start(in cst, node);
    let call_end = n_end(in cst, node);
    let (orig_start, orig_end) = original_span(in state, call_start, call_end);
    steps = inc(steps);
    if steps > MAX_STEPS {
        return step_err(limit(orig_start, orig_end));
    }
    let (key_start, key_end) = call_key(in cst, in state.src, node);
    let mut err = dg_ok();
    let (author_start, author_end) = head_range(in cst, node);
    let mut alias = false;
    let def = lookup(
        in registry,
        in state.src,
        key_start,
        key_end,
        orig_start,
        orig_end,
        author(in state, author_start, author_end),
        inout alias,
        inout err
    );
    if def == NONE {
        return step_err(err);
    }
    if !fits_sort(in registry, kind, def) {
        let mut message = ChunkSeq::new[u8]();
        cat(inout message, in "sugar `");
        cat_seq(
            inout message,
            in pool_text(in registry, df(in registry, def, 0), df(in registry, def, 1))
        );
        cat(inout message, in "` has sort ");
        cat_seq(
            inout message,
            in pool_text(in registry, df(in registry, def, 2), df(in registry, def, 3))
        );
        cat(inout message, in ", incompatible with this use");
        let first_rule = def_rule(in registry, def, 0);
        return step_msg(
            in message,
            orig_start,
            orig_end,
            rf(in registry, first_rule, 6),
            rf(in registry, first_rule, 7),
            in "declared by this rule"
        );
    }
    if df(in registry, def, 4) != NONE {
        let node_info = node_at(in cst, node);
        for child in inc(node)..widen_u64(node_info.after) {
            let child_node = node_at(in cst, child);
            if widen_u64(child_node.parent) != node
                || !(child_node.kind == N_PIPE_EXPR || child_node.kind == N_DOTTED_EXPR) {
                continue;
            }
            let op = child_of(in cst, child, N_SUGAR_OPERATOR);
            let (child_start, child_end) = original_span(
                in state,
                n_start(in cst, child),
                n_end(in cst, child)
            );
            let mut inner_err = dg_ok();
            let (child_head_start, child_head_end) = head_range(in cst, child);
            let mut inner_alias = false;
            let inner = lookup(
                in registry,
                in state.src,
                n_start(in cst, op),
                n_end(in cst, op),
                child_start,
                child_end,
                author(in state, child_head_start, child_head_end),
                inout inner_alias,
                inout inner_err
            );
            if inner == NONE {
                return step_err(inner_err);
            }
            let same_symbol = df(in registry, inner, 4) != NONE
                && ranges_eq(
                    in registry.pool,
                    df(in registry, def, 4),
                    add(df(in registry, def, 4), df(in registry, def, 5)),
                    in registry.pool,
                    df(in registry, inner, 4),
                    add(df(in registry, inner, 4), df(in registry, inner, 5))
                );
            if (df(in registry, def, 6) == 1 || df(in registry, inner, 6) == 1)
                && !same_symbol
                && operator_level(in registry, def) == operator_level(in registry, inner) {
                return step_err(
                    dg_str(
                        in "E0140",
                        in "parenthesize mixed non-associative sugar operators",
                        orig_start,
                        orig_end
                    )
                );
            }
        }
    }
    let invocation = range_of(in state.src, call_start, call_end);
    let mut chosen = NONE;
    let mut words = ChunkSeq::new[u64]();
    let mut tail_end = NONE;
    let mut tail = ChunkSeq::new[u8]();
    for rule_index in 0..df(in registry, def, 10) {
        let rule = def_rule(in registry, def, rule_index);
        let rule_tail = rf(in registry, rule, 8) == 1;
        let mut tail_len: u64 = 0;
        if rule_tail {
            if tail_end == NONE {
                let mut end: u64 = 0;
                let found_end = block_end(in cst, node, inout work, inout end);
                if found_end.failed {
                    return step_err(found_end);
                }
                tail_end = end;
            }
            tail = range_of(in state.src, call_end, tail_end);
            tail_len = tail.len();
        }
        let mut pattern = pool_text(
            in registry,
            rf(in registry, rule, 0),
            rf(in registry, rule, 1)
        );
        if alias {
            // `pattern.replace_range(rule.head_span, &key)`.
            let mut aliased = range_of(in pattern, 0, rf(in registry, rule, 2));
            cat_range(inout aliased, in state.src, key_start, key_end);
            cat_range(inout aliased, in pattern, rf(in registry, rule, 3), pattern.len());
            pattern = aliased;
        }
        let matched = match_rule_encoded(in pattern, in invocation, rule_tail, tail_len, work);
        let status = w64(in matched, 0);
        work = w64(in matched, 1);
        if status == 2 {
            let msg_len = w64(in matched, 2);
            let mut message = ChunkSeq::new[u8]();
            for j in 0..msg_len {
                message.push(wrapping_u8(w64(in matched, add(3, j))));
            }
            return step_msg(
                in message,
                orig_start,
                orig_end,
                rf(in registry, rule, 6),
                rf(in registry, rule, 7),
                in "while matching this sugar rule"
            );
        }
        if status == 1 {
            chosen = rule;
            words = matched;
            break;
        }
    }
    if chosen == NONE {
        let mut message = ChunkSeq::new[u8]();
        cat(inout message, in "no rule of `");
        cat_seq(
            inout message,
            in pool_text(in registry, df(in registry, def, 0), df(in registry, def, 1))
        );
        cat(inout message, in "` matches this sugar use");
        let first_rule = def_rule(in registry, def, 0);
        return step_msg(
            in message,
            orig_start,
            orig_end,
            rf(in registry, first_rule, 6),
            rf(in registry, first_rule, 7),
            in "candidate sugar rule"
        );
    }
    let rule = chosen;
    let rule_tail = rf(in registry, rule, 8) == 1;
    if !rule_tail {
        tail.clear();
    }
    let caps = caps_read(words);
    // Scope captures: expand nested uses first.
    let mut postpone = false;
    let mut nested = step_ok();
    for cap in 0..cap_count(in caps) {
        if !sort_in(in caps, cap, in "scope".as_bytes()) {
            continue;
        }
        for value in 0..cap_at(in caps, cap, 4) {
            let value_offset = value_at(in caps, cap, value);
            let value_start = w64(in caps.words, value_offset);
            let value_end = w64(in caps.words, inc(value_offset));
            let from_tail = w64(in caps.words, add(value_offset, 2)) != 0;
            let base = if from_tail { call_end } else { call_start };
            let start = add(base, value_start);
            let end = add(base, value_end);
            let mut probe = NONE;
            for q in 0..starts.len() {
                let other_start = w64(in starts, q);
                if !(other_start < start || other_start <= call_start) {
                    probe = other_start;
                    break;
                }
            }
            if probe != NONE && probe < end {
                postpone = true;
            } else if !from_tail {
                if start < 6 {
                    return step_err(
                        diag(in "scope has no enclosing function", orig_start, orig_end)
                    );
                }
                let spent = charge(inout work, end, orig_start, orig_end);
                if spent.failed {
                    return step_err(spent);
                }
                let mut wrapped = ChunkSeq::new[u8]();
                cat(inout wrapped, in "fn f()");
                for j in 6..start {
                    wrapped.push(32);
                }
                cat_range(inout wrapped, in state.src, start, end);
                let inside = parse(in wrapped, include_tests);
                if inside.refused.failed {
                    return step_err(inside.refused);
                }
                let mut found = ChunkSeq::new[u64]();
                for nested_node in 0..inside.cst.nodes.len() {
                    if call_node(node_at(in inside.cst, nested_node).kind) {
                        found.push(nested_node);
                    }
                }
                if found.len() != 0 {
                    postpone = true;
                    // Later captures push in front of earlier ones.
                    let base = append_cst(inout cst, in inside.cst);
                    let mut front = ChunkSeq::new[u64]();
                    for q in 0..found.len() {
                        front.push(add(base, w64(in found, q)));
                    }
                    for q in 0..nested.calls.len() {
                        front.push(w64(in nested.calls, q));
                    }
                    nested.calls = front;
                }
            }
        }
    }
    if postpone {
        // The use waits for the next round; its nested uses run first,
        // from the trees appended to the forest.
        return nested;
    }
    let (head_start, head_end) = head_range(in cst, node);
    for region in 0..nregs(in state) {
        if rg(in state, region, 11) != df(in registry, def, 13) {
            continue;
        }
        if rg(in state, region, 9) == rf(in registry, rule, 6)
            && rg(in state, region, 10) == rf(in registry, rule, 7)
            && rg(in state, region, 0) <= head_start
            && head_end <= rg(in state, region, 1) {
            let mut in_hole = false;
            let region_hole_first = rg(in state, region, 2);
            for hole in region_hole_first..add(region_hole_first, rg(in state, region, 3)) {
                if w64(in state.holes, hole << 1) <= head_start
                    && head_end <= w64(in state.holes, inc(hole << 1)) {
                    in_hole = true;
                }
            }
            if !in_hole {
                let mut err = dg_str(
                    in "E0143",
                    in "recursive sugar template does not decrease expansion rank",
                    orig_start,
                    orig_end
                );
                related(
                    inout err,
                    rf(in registry, rule, 6),
                    rf(in registry, rule, 7),
                    in "this rule occurs earlier in the same expansion"
                );
                return step_err(err);
            }
        }
    }
    let mut mark = ChunkSeq::new[u8]();
    cat_seq(inout mark, in state.mark);
    push_decimal(inout mark, steps);
    mark.push(95);
    let template = pool_text(in registry, rf(in registry, rule, 4), rf(in registry, rule, 5));
    let skeleton = skeleton_run(in template, in caps, in invocation, in tail, in mark, MAX_BYTES);
    if skeleton.failed {
        return step_msg(
            in skeleton.msg,
            orig_start,
            orig_end,
            rf(in registry, rule, 6),
            rf(in registry, rule, 7),
            in "in this sugar template"
        );
    }
    let mut rendered = render(in skeleton, in caps, in invocation, in tail, in mark);
    if rendered.failed {
        return step_msg(
            in rendered.msg,
            orig_start,
            orig_end,
            rf(in registry, rule, 6),
            rf(in registry, rule, 7),
            in "in this sugar template"
        );
    }
    if kind == N_SUGAR_PAT {
        let hygiene_result = pattern_hygiene(inout rendered, in mark);
        if hygiene_result.failed {
            return step_msg(
                in hygiene_result.msg,
                orig_start,
                orig_end,
                rf(in registry, rule, 6),
                rf(in registry, rule, 7),
                in "in this pattern template"
            );
        }
    }
    let mut has_scope = false;
    for cap in 0..cap_count(in caps) {
        if sort_in(in caps, cap, in "scope".as_bytes()) && cap_at(in caps, cap, 4) != 0 {
            has_scope = true;
        }
    }
    if has_scope {
        let spent = charge(inout work, state.src.len(), orig_start, orig_end);
        if spent.failed {
            return step_err(spent);
        }
    }
    let scope_result = lower(
        inout rendered,
        in caps,
        in state.src,
        call_start,
        call_end,
        in mark,
        MAX_BYTES
    );
    if scope_result.failed {
        return step_msg(
            in scope_result.msg,
            orig_start,
            orig_end,
            rf(in registry, rule, 6),
            rf(in registry, rule, 7),
            in "in this scope template"
        );
    }
    if scope_result.items.len() != 0 {
        let at = state.src.len();
        let mut items_text = ChunkSeq::new[u8]();
        items_text.push(10);
        cat_seq(inout items_text, in scope_result.items);
        items_text.push(10);
        push_plain(inout edits, at, at, in items_text, orig_start, orig_end);
    }
    let end = if rule_tail { tail_end } else { call_end };
    let expr = sort_is(in registry, def, in "expr")
        || sort_is(in registry, def, in "infix")
        || sort_is(in registry, def, in "tag");
    let prefix: u64 = if expr { 1 } else { 0 };
    let mut text = ChunkSeq::new[u8]();
    if expr {
        text.push(40);
        cat_seq(inout text, in rendered.text);
        cat(inout text, in "\n)");
    } else {
        cat_seq(inout text, in rendered.text);
    }
    if kind == N_SUGAR_STMT && !rule_tail && !ends_with_semi(in text, 0, text.len()) {
        let call_info = node_at(in cst, node);
        let mut next_kind: u64 = NONE;
        if call_info.hi > call_info.lo {
            for leaf in widen_u64(call_info.hi)..tree_end(in cst, node) {
                if !trivia(in cst, leaf) {
                    next_kind = widen_u64(leaf_k(in cst, leaf));
                    break;
                }
            }
        }
        if ends_with_semi(in invocation, 0, invocation.len())
            || next_kind != NONE && next_kind != widen_u64(k_r_brace()) {
            text.push(59);
        }
    }
    // The region and its edit.
    let copy_first = edits.copies.len() >> 2;
    let origin_count = rendered.origins.len() / 5;
    let mut copy_rows = ChunkSeq::new[u64]();
    for origin in 0..origin_count {
        let row = wrapping_mul(origin, 5);
        let base = if w64(in rendered.origins, add(row, 4)) != 0 {
            call_end
        } else {
            call_start
        };
        copy_rows.push(add(w64(in rendered.origins, row), prefix));
        copy_rows.push(add(w64(in rendered.origins, inc(row)), prefix));
        copy_rows.push(add(base, w64(in rendered.origins, add(row, 2))));
        copy_rows.push(add(base, w64(in rendered.origins, add(row, 3))));
    }
    // `copies.sort_by_key(|(r, _)| r.start)`, stable.
    let mut order = ChunkSeq::new[u64]();
    for origin in 0..origin_count {
        let copy_start = w64(in copy_rows, origin << 2);
        let mut at = order.len();
        loop {
            if at == 0 || w64(in copy_rows, w64(in order, sub(at, 1)) << 2) <= copy_start {
                break;
            }
            at = sub(at, 1);
        }
        order.push(0);
        let mut slot = sub(order.len(), 1);
        loop {
            if slot <= at {
                break;
            }
            order.try_set(slot, w64(in order, sub(slot, 1)));
            slot = sub(slot, 1);
        }
        order.try_set(at, origin);
    }
    for rank in 0..origin_count {
        let origin = w64(in order, rank);
        for j in 0..4 {
            edits.copies.push(w64(in copy_rows, add(origin << 2, j)));
        }
    }
    let hole_first = edits.holes.len() >> 1;
    for hole in 0..(rendered.holes.len() >> 1) {
        edits.holes.push(add(add(call_start, prefix), w64(in rendered.holes, hole << 1)));
        edits.holes.push(add(add(call_start, prefix), w64(in rendered.holes, inc(hole << 1))));
    }
    let place_first = edits.places.len() / 3;
    for place in 0..(rendered.places.len() / 3) {
        let row = wrapping_mul(place, 3);
        edits.places.push(add(add(call_start, prefix), w64(in rendered.places, row)));
        edits.places.push(add(add(call_start, prefix), w64(in rendered.places, inc(row))));
        edits.places.push(w64(in rendered.places, add(row, 2)));
    }
    edits.rows.push(call_start);
    edits.rows.push(end);
    edits.rows.push(edits.text.len());
    edits.rows.push(text.len());
    cat_seq(inout edits.text, in text);
    edits.rows.push(1);
    edits.rows.push(call_start);
    edits.rows.push(add(call_start, text.len()));
    edits.rows.push(hole_first);
    edits.rows.push(rendered.holes.len() >> 1);
    edits.rows.push(place_first);
    edits.rows.push(rendered.places.len() / 3);
    edits.rows.push(def);
    edits.rows.push(orig_start);
    edits.rows.push(orig_end);
    edits.rows.push(rf(in registry, rule, 6));
    edits.rows.push(rf(in registry, rule, 7));
    edits.rows.push(copy_first);
    edits.rows.push(origin_count);
    edits.rows.push(orig_start);
    edits.rows.push(orig_end);
    edits.rows.push(df(in registry, def, 13));
    skip_to = end;
    step_ok()
}

// Append `cst` to `forest`, shifting its node, leaf and token indices, and
// return the index of its first node.
fn append_cst(inout forest: Cst, in cst: Cst) -> u64 {
    let node_base = forest.nodes.len();
    let leaf_base = forest.leaves.len();
    let tok_base = forest.token_kinds.len();
    for i in 0..cst.nodes.len() {
        let mut node = node_at(in cst, i);
        if node.parent != 4294967295 {
            node.parent = wrapping_add(node.parent, wrapping_u32(node_base));
        }
        node.lo = wrapping_add(node.lo, wrapping_u32(leaf_base));
        node.hi = wrapping_add(node.hi, wrapping_u32(leaf_base));
        node.after = wrapping_add(node.after, wrapping_u32(node_base));
        forest.nodes.push(node);
    }
    for i in 0..cst.leaves.len() {
        match cst.leaves.try_get(i) {
            Option::Some(tok) => forest.leaves.push(wrapping_add(tok, wrapping_u32(tok_base))),
            Option::None => forest.leaves.push(0),
        }
    }
    forest.token_kinds.extend(in cst.token_kinds.as_slice());
    forest.token_starts.extend(in cst.token_starts.as_slice());
    forest.token_ends.extend(in cst.token_ends.as_slice());
    node_base
}

// ---------------------------------------------------------------- protect

// `hygiene::protect(state, mark, work, ast)`.
fn protect(inout state: St, include_tests: bool, inout work: u64) -> Dg {
    if nregs(in state) == 0 {
        return dg_ok();
    }
    let spent = charge(inout work, state.src.len(), 0, 0);
    if spent.failed {
        return spent;
    }
    let mut diags = diags_new();
    let lexed = lex_sugar_raw_with_limits(
        in state.src.as_slice(),
        inout diags,
        MAX_BYTES,
        HARD_TOKENS,
        max_diagnostics()
    );
    if lexed.rejected {
        let end = if diags.at.len() > 1 {
            w32(in diags.at, 1)
        } else {
            diags.text.len()
        };
        let message = range_of(in diags.text, w32(in diags.at, 0), end);
        return dg_new(in "E0003", in message, 0, 0);
    }
    // The non-trivia tokens as (kind, start, end).
    let mut tokens = ChunkSeq::new[u64]();
    for i in 0..lexed.kind.len() {
        let kind = b8(in lexed.kind, i);
        if !trivia_kind(kind) {
            tokens.push(widen_u64(kind));
            tokens.push(w32(in lexed.start, i));
            tokens.push(token_end(in lexed, i));
        }
    }
    let text = match String::from_utf8(in state.src.as_slice()) {
        Option::Some(decoded) => decoded,
        Option::None => String::new(),
    };
    let lowered = lower_surface_source_limits(
        in text.as_str(),
        MAX_BYTES,
        HARD_TOKENS,
        include_tests
    );
    let ast = lowered.ast;
    let mut names = Names {
        bindings: ChunkSeq::new[u64](),
        refs: ChunkSeq::new[u64](),
        shorthand: ChunkSeq::new[u64]()
    };
    for item_index in 0..ast.m_items.len() {
        let item = item_of(in ast, item_index);
        if item.kind == 2 {
            scan(inout names, in state, in tokens, in ast, item.node);
        } else if item.kind == 4 {
            let owner = ast.impls.get_or(
                idx_from_raw[ImplNode](item.node),
                ImplNode { ty: none(), generics: 0, methods: 0 }
            );
            for method in 0..list_len(in ast, owner.methods) {
                scan(
                    inout names,
                    in state,
                    in tokens,
                    in ast,
                    list_at(in ast, owner.methods, method)
                );
            }
        } else if item.kind == 6 {
            let owner = ast.confs.get_or(
                idx_from_raw[ConfNode](item.node),
                ConfNode {
                    model: none(),
                    public: false,
                    generics: 0,
                    trait_ref: none(),
                    self_ty: none(),
                    wheres: 0,
                    assoc: 0,
                    methods: 0,
                    start: 0,
                    end: 0
                }
            );
            for method in 0..list_len(in ast, owner.methods) {
                scan(
                    inout names,
                    in state,
                    in tokens,
                    in ast,
                    list_at(in ast, owner.methods, method)
                );
            }
        }
    }
    let mut edits = eds_new();
    names_edits(inout names, in state, in ast, inout edits);
    // `edits` is in start order: apply from the last.
    let mut edit = neds(in edits);
    loop {
        if edit == 0 {
            break;
        }
        edit = sub(edit, 1);
        let (orig_start, orig_end) = original_span(
            in state,
            ed(in edits, edit, 0),
            ed(in edits, edit, 1)
        );
        edits.rows.try_set(add(wrapping_mul(edit, EW), 18), orig_start);
        edits.rows.try_set(add(wrapping_mul(edit, EW), 19), orig_end);
        let applied = apply(inout state, in edits, edit, inout work);
        if applied.failed {
            return applied;
        }
    }
    dg_ok()
}

// `Names`: bindings as rows (name symbol, binder start, end, scope start,
// end); refs as rows (name symbol, start, end, copied); shorthand starts.
struct Names {
    bindings: ChunkSeq[u64],
    refs: ChunkSeq[u64],
    shorthand: ChunkSeq[u64]
}

fn copied(in state: St, at: u64) -> bool {
    let n = nmaps(in state);
    for i in 0..n {
        if mp(in state, i, 1) > at {
            return mp(in state, i, 4) == 1;
        }
    }
    false
}

// `self.state.source.get(span) == Some(name)`.
fn span_is_name(in state: St, in ast: Ast, start: u64, end: u64, sym: u32) -> bool {
    if end < start || end > state.src.len() || sub(end, start) != name_len(in ast, sym) {
        return false;
    }
    for j in 0..sub(end, start) {
        if b8(in state.src, add(start, j)) != name_byte(in ast, sym, j) {
            return false;
        }
    }
    true
}

// `field(key, span)`.
fn field(
    inout names: Names,
    in state: St,
    in tokens: ChunkSeq[u64],
    in ast: Ast,
    key: u32,
    start: u64,
    end: u64
) {
    if !span_is_name(in state, in ast, start, end, key) {
        return;
    }
    let mut tok: u64 = 0;
    let n = tokens.len() / 3;
    loop {
        if tok >= n || w64(in tokens, add(wrapping_mul(tok, 3), 2)) > start {
            break;
        }
        tok = inc(tok);
    }
    if tok > 0 && w64(in tokens, wrapping_mul(sub(tok, 1), 3)) != widen_u64(k_colon()) {
        let mut seen = false;
        for q in 0..names.shorthand.len() {
            if w64(in names.shorthand, q) == start {
                seen = true;
            }
        }
        if !seen {
            names.shorthand.push(start);
        }
    }
}

fn pat(
    inout names: Names,
    in state: St,
    in tokens: ChunkSeq[u64],
    in ast: Ast,
    pattern: u32,
    scope_start: u64,
    scope_end: u64
) {
    if pattern == none() {
        return;
    }
    let pat_node = pat_at(in ast, pattern);
    if pat_node.kind == 2 {
        if span_is_name(
            in state,
            in ast,
            widen_u64(pat_node.start),
            widen_u64(pat_node.end),
            pat_node.a
        ) {
            names.bindings.push(widen_u64(pat_node.a));
            names.bindings.push(widen_u64(pat_node.start));
            names.bindings.push(widen_u64(pat_node.end));
            names.bindings.push(scope_start);
            names.bindings.push(scope_end);
        }
    } else if pat_node.kind == 4 {
        for i in 0..list_len(in ast, pat_node.a) {
            pat(
                inout names,
                in state,
                in tokens,
                in ast,
                list_at(in ast, pat_node.a, i),
                scope_start,
                scope_end
            );
        }
    } else if pat_node.kind == 5 {
        for i in 0..(list_len(in ast, pat_node.b) >> 1) {
            let key = list_at(in ast, pat_node.b, i << 1);
            let field_pat = list_at(in ast, pat_node.b, inc(i << 1));
            if pat_node.c != 0 {
                let field_pat_node = pat_at(in ast, field_pat);
                field(
                    inout names,
                    in state,
                    in tokens,
                    in ast,
                    key,
                    widen_u64(field_pat_node.start),
                    widen_u64(field_pat_node.end)
                );
            }
            pat(inout names, in state, in tokens, in ast, field_pat, scope_start, scope_end);
        }
    }
}

fn params(
    inout names: Names,
    in state: St,
    in tokens: ChunkSeq[u64],
    in ast: Ast,
    list: u32,
    scope_start: u64,
    scope_end: u64
) {
    let n = tokens.len() / 3;
    for k in 0..list_len(in ast, list) {
        let param = param_of(in ast, list_at(in ast, list, k));
        let param_start = widen_u64(param.start);
        let param_end = widen_u64(param.end);
        let mut tok: u64 = 0;
        loop {
            if tok >= n || w64(in tokens, add(wrapping_mul(tok, 3), 2)) > param_start {
                break;
            }
            tok = inc(tok);
        }
        loop {
            if tok >= n {
                break;
            }
            let tok_start = w64(in tokens, inc(wrapping_mul(tok, 3)));
            let tok_end = w64(in tokens, add(wrapping_mul(tok, 3), 2));
            if tok_start >= param_end {
                break;
            }
            if span_is_name(in state, in ast, tok_start, tok_end, param.name) {
                names.bindings.push(widen_u64(param.name));
                names.bindings.push(tok_start);
                names.bindings.push(tok_end);
                names.bindings.push(scope_start);
                names.bindings.push(scope_end);
                break;
            }
            tok = inc(tok);
        }
    }
}

fn es(in ast: Ast, expr: u32) -> u64 {
    widen_u64(expr_at(in ast, expr).start)
}

fn ee(in ast: Ast, expr: u32) -> u64 {
    widen_u64(expr_at(in ast, expr).end)
}

// `Names::scan(f)`.
fn scan(inout names: Names, in state: St, in tokens: ChunkSeq[u64], in ast: Ast, fn_id: u32) {
    let func = fn_of(in ast, fn_id);
    if func.body == none() {
        return;
    }
    params(
        inout names,
        in state,
        in tokens,
        in ast,
        func.params,
        es(in ast, func.body),
        ee(in ast, func.body)
    );
    walk(inout names, in state, in tokens, in ast, func.body);
}

// `parser::walk_exprs(body, ..)`: children first, then the callback.
fn walk(inout names: Names, in state: St, in tokens: ChunkSeq[u64], in ast: Ast, expr: u32) {
    if expr == none() {
        return;
    }
    let expr_node = expr_at(in ast, expr);
    let kind = expr_node.kind;
    if kind == 3 {
        for i in 0..list_len(in ast, expr_node.a) {
            walk(inout names, in state, in tokens, in ast, list_at(in ast, expr_node.a, i));
        }
    } else if kind == 4 {
        for i in 0..(list_len(in ast, expr_node.b) >> 1) {
            walk(
                inout names,
                in state,
                in tokens,
                in ast,
                list_at(in ast, expr_node.b, inc(i << 1))
            );
        }
    } else if kind == 5 {
        for i in 0..list_len(in ast, expr_node.a) {
            let stmt_node = stmt_of(in ast, list_at(in ast, expr_node.a, i));
            walk(inout names, in state, in tokens, in ast, stmt_node.value);
        }
        walk(inout names, in state, in tokens, in ast, expr_node.b);
    } else if kind == 6 {
        walk(inout names, in state, in tokens, in ast, expr_node.a);
        for i in 0..list_len(in ast, expr_node.c) {
            let arg = arg_of(in ast, list_at(in ast, expr_node.c, i));
            walk(inout names, in state, in tokens, in ast, arg.expr);
        }
    } else if kind == 7 || kind == 9 || kind == 17 {
        walk(inout names, in state, in tokens, in ast, expr_node.a);
    } else if kind == 10 {
        walk(inout names, in state, in tokens, in ast, expr_node.b);
    } else if kind == 8 || kind == 19 {
        walk(inout names, in state, in tokens, in ast, expr_node.a);
        walk(inout names, in state, in tokens, in ast, expr_node.b);
    } else if kind == 11 || kind == 12 {
        walk(inout names, in state, in tokens, in ast, expr_node.b);
        walk(inout names, in state, in tokens, in ast, expr_node.c);
    } else if kind == 13 {
        walk(inout names, in state, in tokens, in ast, expr_node.a);
        walk(inout names, in state, in tokens, in ast, expr_node.b);
        walk(inout names, in state, in tokens, in ast, expr_node.c);
    } else if kind == 14 {
        walk(inout names, in state, in tokens, in ast, expr_node.a);
        for i in 0..(list_len(in ast, expr_node.b) >> 1) {
            walk(
                inout names,
                in state,
                in tokens,
                in ast,
                list_at(in ast, expr_node.b, inc(i << 1))
            );
        }
    } else if kind == 15 {
        walk(inout names, in state, in tokens, in ast, expr_node.e);
    } else if kind == 16 {
        if expr_node.b != none() {
            walk(inout names, in state, in tokens, in ast, expr_node.c);
        }
        walk(inout names, in state, in tokens, in ast, expr_node.d);
        for i in 0..list_len(in ast, expr_node.e) {
            walk(
                inout names,
                in state,
                in tokens,
                in ast,
                clause_of(in ast, list_at(in ast, expr_node.e, i)).body
            );
        }
    } else if kind == 18 {
        walk(inout names, in state, in tokens, in ast, expr_node.b);
        walk(inout names, in state, in tokens, in ast, expr_node.c);
    } else if kind == 20 || kind == 21 {
        walk(inout names, in state, in tokens, in ast, expr_node.a);
    }
    // The callback.
    let start = widen_u64(expr_node.start);
    let end = widen_u64(expr_node.end);
    if kind == 2 {
        if span_is_name(in state, in ast, start, end, expr_node.a) {
            names.refs.push(widen_u64(expr_node.a));
            names.refs.push(start);
            names.refs.push(end);
            names.refs.push(if copied(in state, start) { 1 } else { 0 });
        }
    } else if kind == 4 {
        for i in 0..(list_len(in ast, expr_node.b) >> 1) {
            let key = list_at(in ast, expr_node.b, i << 1);
            let value_expr = list_at(in ast, expr_node.b, inc(i << 1));
            field(
                inout names,
                in state,
                in tokens,
                in ast,
                key,
                es(in ast, value_expr),
                ee(in ast, value_expr)
            );
        }
    } else if kind == 5 {
        for i in 0..list_len(in ast, expr_node.a) {
            let stmt = stmt_of(in ast, list_at(in ast, expr_node.a, i));
            if stmt.kind == 1 {
                pat(
                    inout names,
                    in state,
                    in tokens,
                    in ast,
                    stmt.pat,
                    ee(in ast, stmt.value),
                    end
                );
            }
        }
    } else if kind == 14 {
        for i in 0..(list_len(in ast, expr_node.b) >> 1) {
            let arm_pat = list_at(in ast, expr_node.b, i << 1);
            let arm = list_at(in ast, expr_node.b, inc(i << 1));
            pat(
                inout names,
                in state,
                in tokens,
                in ast,
                arm_pat,
                es(in ast, arm),
                ee(in ast, arm)
            );
        }
    } else if kind == 18 {
        pat(
            inout names,
            in state,
            in tokens,
            in ast,
            expr_node.a,
            es(in ast, expr_node.c),
            ee(in ast, expr_node.c)
        );
    } else if kind == 15 {
        params(
            inout names,
            in state,
            in tokens,
            in ast,
            expr_node.a,
            es(in ast, expr_node.e),
            ee(in ast, expr_node.e)
        );
    } else if kind == 16 {
        if expr_node.b != none() {
            pat(
                inout names,
                in state,
                in tokens,
                in ast,
                expr_node.b,
                es(in ast, expr_node.d),
                end
            );
        }
        for i in 0..list_len(in ast, expr_node.e) {
            let clause = clause_of(in ast, list_at(in ast, expr_node.e, i));
            for j in 0..list_len(in ast, clause.pats) {
                pat(
                    inout names,
                    in state,
                    in tokens,
                    in ast,
                    list_at(in ast, clause.pats, j),
                    es(in ast, clause.body),
                    ee(in ast, clause.body)
                );
            }
        }
    }
}

// Name order: `String`'s byte order of the two symbols' spellings.
fn name_lt(in ast: Ast, left: u64, right: u64) -> bool {
    let left_sym = wrapping_u32(left);
    let right_sym = wrapping_u32(right);
    let left_len = name_len(in ast, left_sym);
    let right_len = name_len(in ast, right_sym);
    let n = if left_len < right_len {
        left_len
    } else {
        right_len
    };
    for j in 0..n {
        let left_byte = name_byte(in ast, left_sym, j);
        let right_byte = name_byte(in ast, right_sym, j);
        if left_byte != right_byte {
            return left_byte < right_byte;
        }
    }
    left_len < right_len
}

// Symbols are interned, so equal spellings are equal ids.
fn same_name(in ast: Ast, left: u64, right: u64) -> bool {
    left == right
}

fn max_u64(x: u64, y: u64) -> u64 {
    if x > y { x } else { y }
}

fn zeros(n: u64) -> ChunkSeq[u8] {
    let mut out = ChunkSeq::new[u8]();
    for i in 0..n {
        out.push(0);
    }
    out
}

// The first index of sorted `values` whose value is at least `target`.
fn lower_bound(in values: ChunkSeq[u64], target: u64) -> u64 {
    let mut lo: u64 = 0;
    let mut hi = values.len();
    loop {
        if lo >= hi {
            break;
        }
        let mid = add(lo, (sub(hi, lo)) >> 1);
        if w64(in values, mid) < target {
            lo = inc(mid);
        } else {
            hi = mid;
        }
    }
    lo
}

// Bottom-up merge sort of `syms` by the spelling of each symbol.
fn sort_by_name(in ast: Ast, inout syms: ChunkSeq[u64]) {
    let n = syms.len();
    let mut width: u64 = 1;
    loop {
        if width >= n {
            break;
        }
        let mut out = ChunkSeq::new[u64]();
        let mut lo: u64 = 0;
        loop {
            if lo >= n {
                break;
            }
            let mid = if add(lo, width) < n {
                add(lo, width)
            } else {
                n
            };
            let hi = if add(mid, width) < n {
                add(mid, width)
            } else {
                n
            };
            let mut i = lo;
            let mut j = mid;
            loop {
                if i >= mid && j >= hi {
                    break;
                }
                let take_right = if i >= mid {
                    true
                } else if j >= hi {
                    false
                } else {
                    name_lt(in ast, w64(in syms, j), w64(in syms, i))
                };
                if take_right {
                    out.push(w64(in syms, j));
                    j = inc(j);
                } else {
                    out.push(w64(in syms, i));
                    i = inc(i);
                }
            }
            lo = hi;
        }
        syms = out;
        width = width << 1;
    }
}

// Bottom-up merge sort of `values` by value.
fn sort_u64(inout values: ChunkSeq[u64]) {
    let n = values.len();
    let mut width: u64 = 1;
    loop {
        if width >= n {
            break;
        }
        let mut out = ChunkSeq::new[u64]();
        let mut lo: u64 = 0;
        loop {
            if lo >= n {
                break;
            }
            let mid = if add(lo, width) < n {
                add(lo, width)
            } else {
                n
            };
            let hi = if add(mid, width) < n {
                add(mid, width)
            } else {
                n
            };
            let mut i = lo;
            let mut j = mid;
            loop {
                if i >= mid && j >= hi {
                    break;
                }
                let take_right = if i >= mid {
                    true
                } else if j >= hi {
                    false
                } else {
                    w64(in values, j) < w64(in values, i)
                };
                if take_right {
                    out.push(w64(in values, j));
                    j = inc(j);
                } else {
                    out.push(w64(in values, i));
                    i = inc(i);
                }
            }
            lo = hi;
        }
        values = out;
        width = width << 1;
    }
}

fn starts_with_mark(in state: St, in ast: Ast, sym: u64) -> bool {
    let name_sym = wrapping_u32(sym);
    if name_len(in ast, name_sym) < state.mark.len() {
        return false;
    }
    for j in 0.. state.mark.len() {
        if name_byte(in ast, name_sym, j) != b8(in state.mark, j) {
            return false;
        }
    }
    true
}

// `Names::edits(mark)` as plain edits in start order (one per start, the
// last insert winning).
fn names_edits(inout names: Names, in state: St, in ast: Ast, inout out: Eds) {
    let binding_count = names.bindings.len() / 5;
    let ref_count = names.refs.len() >> 2;
    // Symbols are interned: one id per spelling. Flags by id replace the
    // name maps of Rust (`BTreeMap`/`BTreeSet`), so the grouping stays
    // O(n log n) in the references.
    let mut top: u64 = 0;
    for i in 0..ref_count {
        top = max_u64(top, inc(w64(in names.refs, i << 2)));
    }
    for binding in 0..binding_count {
        top = max_u64(top, inc(w64(in names.bindings, wrapping_mul(binding, 5))));
    }
    let mut seen = zeros(top);
    let mut uncopied = zeros(top);
    // Distinct ref names in name order.
    let mut ref_syms = ChunkSeq::new[u64]();
    for i in 0..ref_count {
        let sym = w64(in names.refs, i << 2);
        if b8(in seen, sym) == 0 {
            seen.try_set(sym, 1);
            ref_syms.push(sym);
        }
        if w64(in names.refs, add(i << 2, 3)) == 0 {
            uncopied.try_set(sym, 1);
        }
    }
    sort_by_name(in ast, inout ref_syms);
    // `generated`: a name with an uncopied ref that is not the mark's.
    let mut generated = zeros(top);
    let mut any_generated = false;
    for q in 0..ref_syms.len() {
        let sym = w64(in ref_syms, q);
        if b8(in uncopied, sym) == 1 && !starts_with_mark(in state, in ast, sym) {
            generated.try_set(sym, 1);
            any_generated = true;
        }
    }
    // Uncopied ref starts as (symbol, start) keys in order, and each
    // symbol's first key.
    let mut keys = ChunkSeq::new[u64]();
    if any_generated {
        for i in 0..ref_count {
            let sym = w64(in names.refs, i << 2);
            if w64(in names.refs, add(i << 2, 3)) == 0 && b8(in generated, sym) == 1 {
                keys.push(add(sym << 32, w64(in names.refs, inc(i << 2))));
            }
        }
        sort_u64(inout keys);
    }
    // `conflicts`: binding names, in name order, with a generated use in
    // the scope of a copied binder.
    let mut conflicts = ChunkSeq::new[u64]();
    let mut listed = zeros(top);
    for binding in 0..binding_count {
        let row = wrapping_mul(binding, 5);
        let sym = w64(in names.bindings, row);
        if b8(in generated, sym) == 0 || b8(in listed, sym) == 1 {
            continue;
        }
        if !copied(in state, w64(in names.bindings, inc(row))) {
            continue;
        }
        let scope_start = w64(in names.bindings, add(row, 3));
        let scope_end = w64(in names.bindings, add(row, 4));
        // The first generated use at or after the scope start.
        let at = lower_bound(in keys, add(sym << 32, scope_start));
        if at < keys.len() {
            let key = w64(in keys, at);
            if key >> 32 == sym && (key & 4294967295) < scope_end {
                listed.try_set(sym, 1);
                conflicts.push(sym);
            }
        }
    }
    sort_by_name(in ast, inout conflicts);
    // Edits keyed by start: rows (start, end, text first, len) over `pool`.
    let mut rows = ChunkSeq::new[u64]();
    let mut pool = ChunkSeq::new[u8]();
    for id in 0..conflicts.len() {
        let sym = w64(in conflicts, id);
        let mut fresh = ChunkSeq::new[u8]();
        cat_seq(inout fresh, in state.mark);
        cat(inout fresh, in "caller_");
        push_decimal(inout fresh, id);
        // Copied binders of this name, sorted by scope start (stable).
        let mut binders = ChunkSeq::new[u64]();
        for binder in 0..binding_count {
            let row = wrapping_mul(binder, 5);
            if same_name(in ast, w64(in names.bindings, row), sym)
                && copied(in state, w64(in names.bindings, inc(row))) {
                let binder_scope = w64(in names.bindings, add(row, 3));
                let mut at = binders.len();
                loop {
                    if at == 0
                        || w64(
                            in names.bindings,
                            add(wrapping_mul(w64(in binders, sub(at, 1)), 5), 3)
                        )
                            <= binder_scope {
                        break;
                    }
                    at = sub(at, 1);
                }
                binders.push(0);
                let mut slot = sub(binders.len(), 1);
                loop {
                    if slot <= at {
                        break;
                    }
                    binders.try_set(slot, w64(in binders, sub(slot, 1)));
                    slot = sub(slot, 1);
                }
                binders.try_set(at, binder);
            }
        }
        let mut scopes = ChunkSeq::new[u64]();
        for q in 0..binders.len() {
            let row = wrapping_mul(w64(in binders, q), 5);
            let binder_start = w64(in names.bindings, inc(row));
            let binder_end = w64(in names.bindings, add(row, 2));
            rename(
                inout rows,
                inout pool,
                in names,
                in ast,
                sym,
                in fresh,
                binder_start,
                binder_end
            );
            let scope_start = w64(in names.bindings, add(row, 3));
            let scope_end = w64(in names.bindings, add(row, 4));
            let scope_count = scopes.len() >> 1;
            if scope_count != 0 && scope_start <= w64(in scopes, inc(sub(scope_count, 1) << 1)) {
                let prev_end = w64(in scopes, inc(sub(scope_count, 1) << 1));
                scopes.try_set(
                    inc(sub(scope_count, 1) << 1),
                    if scope_end > prev_end {
                        scope_end
                    } else {
                        prev_end
                    }
                );
            } else {
                scopes.push(scope_start);
                scopes.push(scope_end);
            }
        }
        for i in 0..ref_count {
            if !same_name(in ast, w64(in names.refs, i << 2), sym) {
                continue;
            }
            let ref_start = w64(in names.refs, inc(i << 2));
            let ref_end = w64(in names.refs, add(i << 2, 2));
            let is_copied = w64(in names.refs, add(i << 2, 3)) == 1;
            let mut scope: u64 = 0;
            loop {
                if scope >= (scopes.len() >> 1) || w64(in scopes, inc(scope << 1)) > ref_start {
                    break;
                }
                scope = inc(scope);
            }
            if is_copied && scope < (scopes.len() >> 1) && w64(in scopes, scope << 1) <= ref_start {
                rename(inout rows, inout pool, in names, in ast, sym, in fresh, ref_start, ref_end);
            }
        }
    }
    for row in 0..(rows.len() >> 2) {
        let first = w64(in rows, add(row << 2, 2));
        let len = w64(in rows, add(row << 2, 3));
        let text = range_of(in pool, first, add(first, len));
        push_plain(inout out, w64(in rows, row << 2), w64(in rows, inc(row << 2)), in text, 0, 0);
    }
}

fn rename(
    inout rows: ChunkSeq[u64],
    inout pool: ChunkSeq[u8],
    in names: Names,
    in ast: Ast,
    sym: u64,
    in fresh: ChunkSeq[u8],
    start: u64,
    end: u64
) {
    let first = pool.len();
    let mut short = false;
    for q in 0..names.shorthand.len() {
        if w64(in names.shorthand, q) == start {
            short = true;
        }
    }
    if short {
        let name_sym = wrapping_u32(sym);
        for j in 0..name_len(in ast, name_sym) {
            pool.push(name_byte(in ast, name_sym, j));
        }
        cat(inout pool, in ": ");
    }
    cat_seq(inout pool, in fresh);
    let len = sub(pool.len(), first);
    let mut at = rows.len() >> 2;
    for row in 0..(rows.len() >> 2) {
        let row_start = w64(in rows, row << 2);
        if row_start == start {
            rows.try_set(inc(row << 2), end);
            rows.try_set(add(row << 2, 2), first);
            rows.try_set(add(row << 2, 3), len);
            return;
        }
        if row_start > start {
            at = row;
            break;
        }
    }
    for j in 0..4 {
        rows.push(0);
    }
    let mut slot = sub(rows.len() >> 2, 1);
    loop {
        if slot <= at {
            break;
        }
        for j in 0..4 {
            rows.try_set(add(slot << 2, j), w64(in rows, add(sub(slot, 1) << 2, j)));
        }
        slot = sub(slot, 1);
    }
    rows.try_set(at << 2, start);
    rows.try_set(inc(at << 2), end);
    rows.try_set(add(at << 2, 2), first);
    rows.try_set(add(at << 2, 3), len);
}

// ---------------------------------------------------------------- words

fn push_text(inout out: ChunkSeq[u64], in bytes: ChunkSeq[u8]) {
    out.push(bytes.len());
    for i in 0..bytes.len() {
        out.push(widen_u64(b8(in bytes, i)));
    }
}

// The words of `expand`: [2, code, message, start, end, labels, (start,
// end, message)*] for a diagnostic (texts as a length and bytes), [0] for
// nothing to expand, else [1, source, fresh prefix, regions, (expanded
// start, end, holes, (start, end)*, places, (start, end, pass)*, emits
// row text, call start, end, rule start, end, import or NONE)*, mappings,
// (expanded start, end, original start, end, copied)*].
pub fn expand_words(
    in source: ChunkSeq[u8],
    in imports: Imports,
    include_tests: bool
) -> ChunkSeq[u64] {
    let expanded = expand(in source, in imports, include_tests);
    let mut out = ChunkSeq::new[u64]();
    if expanded.diag.failed {
        out.push(2);
        push_text(inout out, in expanded.diag.code);
        push_text(inout out, in expanded.diag.msg);
        out.push(expanded.diag.span_start);
        out.push(expanded.diag.span_end);
        let label_count = expanded.diag.labels.len() >> 2;
        out.push(label_count);
        for label in 0..label_count {
            out.push(w64(in expanded.diag.labels, label << 2));
            out.push(w64(in expanded.diag.labels, inc(label << 2)));
            let first = w64(in expanded.diag.labels, add(label << 2, 2));
            let len = w64(in expanded.diag.labels, add(label << 2, 3));
            push_text(inout out, in range_of(in expanded.diag.label_text, first, add(first, len)));
        }
        return out;
    }
    if !expanded.changed {
        out.push(0);
        return out;
    }
    out.push(1);
    push_text(inout out, in expanded.state.src);
    push_text(inout out, in expanded.state.mark);
    let n = nregs(in expanded.state);
    out.push(n);
    for region in 0..n {
        out.push(rg(in expanded.state, region, 0));
        out.push(rg(in expanded.state, region, 1));
        let hole_first = rg(in expanded.state, region, 2);
        let hole_count = rg(in expanded.state, region, 3);
        out.push(hole_count);
        for hole in hole_first..add(hole_first, hole_count) {
            out.push(w64(in expanded.state.holes, hole << 1));
            out.push(w64(in expanded.state.holes, inc(hole << 1)));
        }
        let place_first = rg(in expanded.state, region, 4);
        let place_count = rg(in expanded.state, region, 5);
        out.push(place_count);
        for place in place_first..add(place_first, place_count) {
            for k in 0..3 {
                out.push(w64(in expanded.state.places, add(wrapping_mul(place, 3), k)));
            }
        }
        let def = rg(in expanded.state, region, 6);
        let emits_first = df(in expanded.registry, def, 7);
        if emits_first == NONE {
            out.push(0);
        } else {
            push_text(
                inout out,
                in pool_text(in expanded.registry, emits_first, df(in expanded.registry, def, 8))
            );
        }
        for k in 7..12 {
            out.push(rg(in expanded.state, region, k));
        }
    }
    let map_count = nmaps(in expanded.state);
    out.push(map_count);
    for i in 0..map_count {
        for k in 0..5 {
            out.push(mp(in expanded.state, i, k));
        }
    }
    out
}
