// `sugar_expand::hygiene::pattern`: a transliteration of `pattern` in
// crates/vesper-syntax/src/sugar_expand/hygiene.rs. A binder a pattern
// template introduces literally is renamed to a fresh name, so it cannot
// bind a caller identifier in the arm that follows; a binder spliced from
// a pattern hole keeps its name. (`protect`, the caller-side renaming,
// runs in the expansion driver.)

use @vesper/ast::{expr_at, list_at, list_len, none, pat_at};
use @vesper/ast::lower::{lower_surface_source};
use self::flow::{Rd, fn_of, name_byte, name_is, name_len};
use self::scope::{Sc, push_name, refusal, sc_err, sc_err_seq, sc_ok};
use self::template::{add, b8, inc, push_decimal, sub, w32, w64};

const PREFIX: Str = "fn __pattern() {match 0 { ";
// `PREFIX.len() + 1`: the rendered text starts after a space.
const OFF: u64 = 27;

// The renamed spelling of symbol `sym`, by first appearance.
fn fresh_id(inout names: ChunkSeq[u32], sym: u32) -> u64 {
    for i in 0..names.len() {
        if match names.try_get(i) {
            Option::Some(seen_sym) => seen_sym == sym,
            Option::None => false,
        }
        {
            return i;
        }
    }
    names.push(sym);
    sub(names.len(), 1)
}

fn is_space(byte: u8) -> bool {
    byte == 32 || byte == 9 || byte == 10 || byte == 13 || byte == 11 || byte == 12
}

// `rendered.text[..at].trim_end().ends_with(':')`.
fn after_colon(in text: ChunkSeq[u8], at: u64) -> bool {
    let mut pos = at;
    loop {
        if pos == 0 {
            return false;
        }
        let byte = b8(in text, sub(pos, 1));
        if !is_space(byte) {
            return byte == 58;
        }
        pos = sub(pos, 1);
    }
}

fn shift(pos: u64, edit_start: u64, old_len: u64, new_len: u64) -> u64 {
    if pos <= edit_start {
        pos
    } else {
        add(sub(pos, old_len), new_len)
    }
}

// `pattern(rendered, mark)`.
pub fn pattern_hygiene(inout rendered: Rd, in mark: ChunkSeq[u8]) -> Sc {
    let mut wrapped = ChunkSeq::new[u8]();
    wrapped.extend(in PREFIX.as_bytes());
    wrapped.push(32);
    wrapped.extend(in rendered.text.as_slice());
    wrapped.extend(in " => 0 } }".as_bytes());
    let source = match String::from_utf8(in wrapped.as_slice()) {
        Option::Some(decoded) => decoded,
        Option::None => String::new(),
    };
    let lowered = lower_surface_source(in source.as_str());
    if lowered.p.t.rejected {
        return refusal(in lowered.p.d);
    }
    if lowered.p.d.code.len() != 0 {
        let diag = lowered.p.d;
        let end = if diag.at.len() > 1 {
            w32(in diag.at, 1)
        } else {
            diag.text.len()
        };
        let mut message = ChunkSeq::new[u8]();
        message.extend(in "invalid expanded sugar pattern: ".as_bytes());
        for j in w32(in diag.at, 0)..end {
            message.push(b8(in diag.text, j));
        }
        return sc_err_seq(in message);
    }
    let ast = lowered.ast;
    let item = match ast.m_items.try_get(0) {
        Option::Some(raw_item) => ast.items.get_or(
            @vesper-std/arena::idx_from_raw[@vesper/ast::ItemNode](raw_item),
            @vesper/ast::ItemNode { kind: 0, node: 0 }
        ),
        Option::None => @vesper/ast::ItemNode { kind: 0, node: 0 },
    };
    if item.kind != 2 {
        return sc_err(in "missing pattern template wrapper".as_bytes());
    }
    let func = fn_of(in ast, item.node);
    if func.body == none() {
        return sc_err(in "missing pattern template".as_bytes());
    }
    let body = expr_at(in ast, func.body);
    if body.kind != 5 || body.b == none() {
        return sc_err(in "missing match pattern".as_bytes());
    }
    let tail = expr_at(in ast, body.b);
    if tail.kind != 14 {
        return sc_err(in "expected a match pattern".as_bytes());
    }
    // The stack of (pattern, field name or NONE).
    let mut stack = ChunkSeq::new[u32]();
    for i in 0..(list_len(in ast, tail.b) >> 1) {
        stack.push(list_at(in ast, tail.b, i << 1));
        stack.push(none());
    }
    let mut names = ChunkSeq::new[u32]();
    // Replacements as rows (start, end, pool first, pool length), one per
    // start, the last insert winning.
    let mut reps = ChunkSeq::new[u64]();
    let mut pool = ChunkSeq::new[u8]();
    loop {
        if stack.len() == 0 {
            break;
        }
        let n = stack.len();
        let field = match stack.try_get(sub(n, 1)) {
            Option::Some(entry) => entry,
            Option::None => none(),
        };
        let pat_index = match stack.try_get(sub(n, 2)) {
            Option::Some(entry) => entry,
            Option::None => none(),
        };
        stack.truncate(sub(n, 2));
        let pat = pat_at(in ast, pat_index);
        if pat.kind == 4 {
            for i in 0..list_len(in ast, pat.a) {
                stack.push(list_at(in ast, pat.a, i));
                stack.push(none());
            }
        } else if pat.kind == 5 {
            for i in 0..(list_len(in ast, pat.b) >> 1) {
                stack.push(list_at(in ast, pat.b, inc(i << 1)));
                stack.push(
                    if pat.c != 0 {
                        list_at(in ast, pat.b, i << 1)
                    } else {
                        none()
                    }
                );
            }
        } else if pat.kind == 2 {
            let binder_start = sub(widen_u64(pat.start), OFF);
            let binder_end = sub(widen_u64(pat.end), OFF);
            let mut in_hole = false;
            for hole in 0..(rendered.holes.len() >> 1) {
                if w64(in rendered.holes, hole << 1) <= binder_start
                    && binder_end <= w64(in rendered.holes, inc(hole << 1))
                {
                    in_hole = true;
                    break;
                }
            }
            if in_hole {
                continue;
            }
            let id = fresh_id(inout names, pat.a);
            let mut fresh = ChunkSeq::new[u8]();
            fresh.extend(in mark.as_slice());
            fresh.extend(in "pattern_".as_bytes());
            push_decimal(inout fresh, id);
            let shorthand = field != none()
                && same_name(in ast, field, pat.a)
                && !after_colon(in rendered.text, binder_start);
            let first = pool.len();
            if shorthand {
                push_name(inout pool, in ast, pat.a);
                pool.extend(in ": ".as_bytes());
            }
            pool.extend(in fresh.as_slice());
            let len = sub(pool.len(), first);
            // A BTreeMap keyed by start.
            let mut at = reps.len() >> 2;
            let mut row: u64 = 0;
            let mut replaced = false;
            loop {
                if row >= (reps.len() >> 2) {
                    break;
                }
                let row_start = w64(in reps, row << 2);
                if row_start == binder_start {
                    reps.try_set(inc(row << 2), binder_end);
                    reps.try_set(add(row << 2, 2), first);
                    reps.try_set(add(row << 2, 3), len);
                    replaced = true;
                    break;
                }
                if row_start > binder_start {
                    at = row;
                    break;
                }
                row = inc(row);
            }
            if !replaced {
                for j in 0..4 {
                    reps.push(0);
                }
                let mut slot = sub(reps.len() >> 2, 1);
                loop {
                    if slot <= at {
                        break;
                    }
                    for j in 0..4 {
                        reps.try_set(add(slot << 2, j), w64(in reps, add(sub(slot, 1) << 2, j)));
                    }
                    slot = sub(slot, 1);
                }
                reps.try_set(at << 2, binder_start);
                reps.try_set(inc(at << 2), binder_end);
                reps.try_set(add(at << 2, 2), first);
                reps.try_set(add(at << 2, 3), len);
            }
        }
    }
    // Apply from the last start back.
    let mut rep = reps.len() >> 2;
    loop {
        if rep == 0 {
            break;
        }
        rep = sub(rep, 1);
        let start = w64(in reps, rep << 2);
        let end = w64(in reps, inc(rep << 2));
        let first = w64(in reps, add(rep << 2, 2));
        let len = w64(in reps, add(rep << 2, 3));
        let old_len = sub(end, start);
        for hole_bound in 0..rendered.holes.len() {
            rendered.holes.try_set(
                hole_bound,
                shift(w64(in rendered.holes, hole_bound), start, old_len, len)
            );
        }
        for place in 0..(rendered.places.len() / 3) {
            let row = wrapping_mul(place, 3);
            rendered.places.try_set(row, shift(w64(in rendered.places, row), start, old_len, len));
            rendered
                .places
                .try_set(inc(row), shift(w64(in rendered.places, inc(row)), start, old_len, len));
        }
        for origin in 0..(rendered.origins.len() / 5) {
            let row = wrapping_mul(origin, 5);
            rendered
                .origins
                .try_set(row, shift(w64(in rendered.origins, row), start, old_len, len));
            rendered
                .origins
                .try_set(inc(row), shift(w64(in rendered.origins, inc(row)), start, old_len, len));
        }
        let mut text = ChunkSeq::new[u8]();
        for j in 0..start {
            text.push(b8(in rendered.text, j));
        }
        for j in 0..len {
            text.push(b8(in pool, add(first, j)));
        }
        for j in end..rendered.text.len() {
            text.push(b8(in rendered.text, j));
        }
        rendered.text = text;
    }
    sc_ok()
}

fn same_name(in ast: @vesper/ast::Ast, left_name: u32, right_name: u32) -> bool {
    if name_len(in ast, left_name) != name_len(in ast, right_name) {
        return false;
    }
    for j in 0..name_len(in ast, left_name) {
        if name_byte(in ast, left_name, j) != name_byte(in ast, right_name, j) {
            return false;
        }
    }
    true
}
