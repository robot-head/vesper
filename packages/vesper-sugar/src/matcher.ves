// `sugar_expand::matcher`: match one validated sugar rule against the
// unexpanded call, a function-by-function transliteration of
// crates/vesper-syntax/src/sugar_expand/matcher.rs. Matching choices share
// one work budget (`spend`), including fragment reparsing, and spend it in
// Rust's order, so the remaining budget and every refusal agree.
//
// Rust's maps become tables: a capture is a row (`cap_*`) named by the
// pattern token of its name, an op is a row (`op_*`), a matcher state on
// the backtracking stack is a row (`td_*`) whose frames live in one pool,
// and the event log is rows (`rec_*`) whose index vectors live in another.

use @vesper/front::lex::{
    lex_sugar_raw_with_limits, max_diagnostics, max_source_bytes, max_tokens, token_end, trivia_kind
};
use @vesper/front::diag::{diags_new};
use @vesper/front::parse::{core_operator_kind};
use @vesper/front::{surface_fragment_status};
use @vesper/front::kinds::{
    k_amp, k_amp_eq, k_and, k_arrow, k_bang, k_caret, k_colon, k_comma, k_dollar, k_dot, k_dot_dot,
    k_dot_dot_eq, k_eff, k_eof, k_eq_eq, k_fat_arrow, k_ge, k_gt, k_l_brace, k_l_bracket, k_l_paren,
    k_le, k_linear, k_lower, k_lt, k_minus, k_minus_eq, k_ne, k_or, k_percent, k_percent_eq, k_pipe,
    k_pipe_eq, k_plus, k_plus_eq, k_question, k_r_brace, k_r_bracket, k_r_paren, k_self_kw, k_semi,
    k_shl, k_shr, k_slash, k_slash_eq, k_star, k_star_eq, k_state, k_string, k_tilde, k_upper,
    k_with
};

const NONE: u64 = 18446744073709551615;

// Words per event record and per backtracking state.
const REC: u64 = 8;
const TD: u64 = 8;

// `parser::HARD_PARSE_DEPTH`.
const HARD_PARSE_DEPTH: u64 = 128;

// Status, word 0 of an encoded match (`match_rule_encoded`,
// `match_bootstrap_scalar_encoded`): no match, a match, or a refusal.
pub const MATCH_NONE: u64 = 0;
pub const MATCH_FOUND: u64 = 1;
pub const MATCH_REFUSED: u64 = 2;

// Op kinds.
const OP_LITERAL: u8 = 0;
const OP_HOLE: u8 = 1;
const OP_TAIL: u8 = 2;
const OP_REPEAT: u8 = 3;
const OP_NEXT: u8 = 4;

// Hole sorts.
const S_OTHER: u8 = 0;
const S_IDENT: u8 = 1;
const S_PLACE: u8 = 2;
const S_BLOCK: u8 = 3;
const S_SCOPE: u8 = 4;
const S_EXPR: u8 = 5;
const S_TY: u8 = 6;
const S_PAT: u8 = 7;
const S_ARGS: u8 = 8;
const S_PATS: u8 = 9;
const S_STMTS: u8 = 10;
const S_ITEMS: u8 = 11;

// `Tokens`: the significant tokens of one text (no trivia, no Eof), with
// their byte ranges and, for an opening delimiter, the exclusive end of
// its balanced tree (`i + 1` for an atom).
pub struct Toks {
    // Rows of four words: kind, start, end, tree end.
    tokens: ChunkSeq[u32]
}

// Matcher state: the budget, the refusal, the compiled rule, the
// backtracking stack and the event log.
pub struct Mx {
    work: u64,
    failed: bool,
    msg: ChunkSeq[u8],
    // Ops: rows of three words, kind, a, b.
    ops: ChunkSeq[u64],
    // Each repetition's capture names: rows of (repetition op, capture).
    rep_names: ChunkSeq[u64],
    // Captures: rows of four words, the pattern tokens of the name and
    // the sort, the sort's code and the passing mode.
    caps: ChunkSeq[u64],
    // Event log rows of `REC` words: previous record, first and count of
    // its indices in `index_pool`, kind (0 value, 1 extent), and a, b, c,
    // from_tail (value: capture, start, end; extent: repetition op, count).
    records: ChunkSeq[u64],
    index_pool: ChunkSeq[u64],
    // Backtracking stack rows of `TD` words: pc, pos, log, pending op (or
    // NONE), pending range, first word and count of its frames in
    // `frame_pool`.
    stack: ChunkSeq[u64],
    frame_pool: ChunkSeq[u64]
}

fn mx_new(work: u64) -> Mx {
    Mx {
        work: work,
        failed: false,
        msg: ChunkSeq::new[u8](),
        ops: ChunkSeq::new[u64](),
        rep_names: ChunkSeq::new[u64](),
        caps: ChunkSeq::new[u64](),
        records: ChunkSeq::new[u64](),
        index_pool: ChunkSeq::new[u64](),
        stack: ChunkSeq::new[u64](),
        frame_pool: ChunkSeq::new[u64]()
    }
}

fn b8(in seq: ChunkSeq[u8], i: u64) -> u8 {
    match seq.try_get(i) {
        Option::Some(value) => value,
        Option::None => 0,
    }
}

fn w32(in seq: ChunkSeq[u32], i: u64) -> u64 {
    match seq.try_get(i) {
        Option::Some(value) => widen_u64(value),
        Option::None => 0,
    }
}

fn w64(in seq: ChunkSeq[u64], i: u64) -> u64 {
    match seq.try_get(i) {
        Option::Some(value) => value,
        Option::None => 0,
    }
}

// Word `field` of event record `record`.
fn rec_at(in matcher: Mx, record: u64, field: u64) -> u64 {
    w64(in matcher.records, add(wrapping_mul(record, REC), field))
}

fn inc(x: u64) -> u64 {
    wrapping_add(x, 1)
}

fn add(a: u64, b: u64) -> u64 {
    wrapping_add(a, b)
}

fn sub(a: u64, b: u64) -> u64 {
    wrapping_sub(a, b)
}

fn fail(inout matcher: Mx, in text: Slice[u8]) {
    if !matcher.failed {
        matcher.failed = true;
        matcher.msg.clear();
        matcher.msg.extend(in text);
    }
}

// `spend`: false (and the refusal) once the budget cannot pay `n`.
fn spend(inout matcher: Mx, n: u64) -> bool {
    if n > matcher.work {
        fail(inout matcher, in "sugar pattern matching work limit exceeded".as_bytes());
        return false;
    }
    matcher.work = sub(matcher.work, n);
    true
}

fn len(in toks: Toks) -> u64 {
    toks.tokens.len() >> 2
}

// `Tokens::kind`: Eof past the end.
fn kind(in toks: Toks, i: u64) -> u8 {
    match toks.tokens.try_get(i << 2) {
        Option::Some(k) => wrapping_u8(widen_u64(k)),
        Option::None => k_eof(),
    }
}

fn tok_s(in toks: Toks, i: u64) -> u64 {
    w32(in toks.tokens, inc(i << 2))
}

fn tok_e(in toks: Toks, i: u64) -> u64 {
    w32(in toks.tokens, add(i << 2, 2))
}

fn tree_end(in toks: Toks, i: u64) -> u64 {
    w32(in toks.tokens, add(i << 2, 3))
}

// `Tokens::text(i) == w`; past the end the text is empty.
fn text_is(in text: ChunkSeq[u8], in toks: Toks, i: u64, in expected: Slice[u8]) -> bool {
    if i >= len(in toks) {
        return expected.len() == 0;
    }
    let start = tok_s(in toks, i);
    let n = sub(tok_e(in toks, i), start);
    if n != expected.len() {
        return false;
    }
    for j in 0..n {
        let byte = match expected.try_get(j) {
            Option::Some(byte) => byte,
            Option::None => 0,
        };
        if b8(in text, add(start, j)) != byte {
            return false;
        }
    }
    true
}

// `p.text(i) == t.text(j)` across two texts.
fn same_text(
    in pattern: ChunkSeq[u8],
    in pattern_toks: Toks,
    i: u64,
    in target: ChunkSeq[u8],
    in target_toks: Toks,
    j: u64
) -> bool {
    let pattern_len = if i < len(in pattern_toks) {
        sub(tok_e(in pattern_toks, i), tok_s(in pattern_toks, i))
    } else {
        0
    };
    let target_len = if j < len(in target_toks) {
        sub(tok_e(in target_toks, j), tok_s(in target_toks, j))
    } else {
        0
    };
    if pattern_len != target_len {
        return false;
    }
    let pattern_start = tok_s(in pattern_toks, i);
    let target_start = tok_s(in target_toks, j);
    for k in 0..pattern_len {
        if b8(in pattern, add(pattern_start, k)) != b8(in target, add(target_start, k)) {
            return false;
        }
    }
    true
}

fn close(tok_kind: u8) -> u8 {
    if tok_kind == k_l_paren() {
        k_r_paren()
    } else if tok_kind == k_l_bracket() {
        k_r_bracket()
    } else if tok_kind == k_l_brace() {
        k_r_brace()
    } else {
        k_eof()
    }
}

fn closer(tok_kind: u8) -> bool {
    tok_kind == k_r_paren() || tok_kind == k_r_bracket() || tok_kind == k_r_brace()
}

// `Tokens::new`: false (and the refusal) for a lexer refusal, a lexer
// diagnostic or unbalanced delimiters.
fn toks_new(in source: ChunkSeq[u8], inout matcher: Mx, inout toks: Toks) -> bool {
    let mut diags = diags_new();
    let raw = lex_sugar_raw_with_limits(
        in source.as_slice(),
        inout diags,
        max_source_bytes(),
        max_tokens(),
        max_diagnostics()
    );
    if raw.rejected {
        let end = if diags.at.len() > 1 {
            w32(in diags.at, 1)
        } else {
            diags.text.len()
        };
        let mut text = ChunkSeq::new[u8]();
        for j in w32(in diags.at, 0)..end {
            text.push(b8(in diags.text, j));
        }
        fail(inout matcher, in text.as_slice());
        return false;
    }
    if diags.code.len() != 0 {
        fail(inout matcher, in "invalid token in sugar rule or invocation".as_bytes());
        return false;
    }
    for i in 0..raw.kind.len() {
        let tok_kind = b8(in raw.kind, i);
        if !trivia_kind(tok_kind) && tok_kind != k_eof() {
            toks.tokens.push(widen_u32(tok_kind));
            toks.tokens.push(wrapping_u32(w32(in raw.start, i)));
            toks.tokens.push(wrapping_u32(token_end(in raw, i)));
            toks.tokens.push(wrapping_u32(inc(toks.tokens.len() >> 2)));
        }
    }
    let mut stack = ChunkSeq::new[u64]();
    for i in 0..len(in toks) {
        let tok_kind = kind(in toks, i);
        if close(tok_kind) != k_eof() {
            stack.push(i);
        } else if closer(tok_kind) {
            if stack.len() == 0 {
                fail(inout matcher, in "unmatched sugar delimiter".as_bytes());
                return false;
            }
            let start = w64(in stack, sub(stack.len(), 1));
            stack.truncate(sub(stack.len(), 1));
            if close(kind(in toks, start)) != tok_kind {
                fail(inout matcher, in "mismatched sugar delimiter".as_bytes());
                return false;
            }
            toks.tokens.try_set(add(start << 2, 3), wrapping_u32(inc(i)));
        }
    }
    if stack.len() != 0 {
        fail(inout matcher, in "unclosed sugar delimiter".as_bytes());
        return false;
    }
    true
}

fn toks_empty() -> Toks {
    Toks { tokens: ChunkSeq::new[u32]() }
}

fn joined(in toks: Toks, i: u64) -> bool {
    tok_e(in toks, sub(i, 1)) == tok_s(in toks, i)
}

// `parser::sugar_operator(tokens, start)`'s end, or 0 when there is none.
fn sugar_operator_end(in toks: Toks, start: u64) -> u64 {
    let n = len(in toks);
    if inc(start) >= n {
        return 0;
    }
    let head = kind(in toks, start);
    let next = kind(in toks, inc(start));
    if tok_e(in toks, start) != tok_s(in toks, inc(start)) {
        return 0;
    }
    if head == k_pipe() {
        if next == k_gt() {
            return add(start, 2);
        }
        if next == k_question() {
            let last = add(start, 2);
            if last < n && kind(in toks, last) == k_gt() && joined(in toks, last) {
                return add(start, 3);
            }
        }
        return 0;
    }
    if head != k_dot() {
        return 0;
    }
    let base = next == k_eq_eq()
        || next == k_ne()
        || next == k_lt()
        || next == k_le()
        || next == k_shl()
        || next == k_gt()
        || next == k_ge()
        || next == k_shr()
        || next == k_pipe()
        || next == k_pipe_eq()
        || next == k_or()
        || next == k_caret()
        || next == k_amp()
        || next == k_amp_eq()
        || next == k_and()
        || next == k_plus()
        || next == k_minus()
        || next == k_plus_eq()
        || next == k_minus_eq()
        || next == k_arrow()
        || next == k_star()
        || next == k_slash()
        || next == k_percent()
        || next == k_star_eq()
        || next == k_slash_eq()
        || next == k_percent_eq();
    if !base {
        return 0;
    }
    let mut end = add(start, 2);
    loop {
        if end >= n {
            break;
        }
        let tok_kind = kind(in toks, end);
        let symbol = tok_kind == k_dot()
            || tok_kind == k_dot_dot()
            || tok_kind == k_dot_dot_eq()
            || tok_kind == k_question()
            || tok_kind == k_tilde()
            || tok_kind == k_bang()
            || tok_kind == k_fat_arrow()
            || tok_kind == k_arrow()
            || tok_kind == k_pipe_eq()
            || tok_kind == k_amp_eq()
            || core_operator_kind(tok_kind);
        if !symbol || !joined(in toks, end) {
            break;
        }
        end = inc(end);
    }
    end
}

// `tail_name(t).is_some()`.
fn has_tail_name(in text: ChunkSeq[u8], in toks: Toks) -> bool {
    if len(in toks) < 5 {
        return false;
    }
    let dollar = sub(len(in toks), 5);
    kind(in toks, dollar) == k_dollar()
        && kind(in toks, inc(dollar)) == k_dot_dot()
        && kind(in toks, add(dollar, 3)) == k_colon()
        && (text_is(in text, in toks, add(dollar, 4), in "stmts".as_bytes())
            || text_is(in text, in toks, add(dollar, 4), in "scope".as_bytes()))
}

// `captures_tail(pattern)`.
pub fn captures_tail(in pattern: ChunkSeq[u8]) -> bool {
    let mut matcher = mx_new(0);
    let mut toks = toks_empty();
    toks_new(in pattern, inout matcher, inout toks) && has_tail_name(in pattern, in toks)
}

fn head_kind(tok_kind: u8) -> bool {
    tok_kind == k_lower()
        || tok_kind == k_with()
        || tok_kind == k_eff()
        || tok_kind == k_linear()
        || tok_kind == k_state()
}

fn sort_code(in text: ChunkSeq[u8], in toks: Toks, i: u64) -> u8 {
    if text_is(in text, in toks, i, in "ident".as_bytes()) {
        S_IDENT
    } else if text_is(in text, in toks, i, in "place".as_bytes()) {
        S_PLACE
    } else if text_is(in text, in toks, i, in "block".as_bytes()) {
        S_BLOCK
    } else if text_is(in text, in toks, i, in "scope".as_bytes()) {
        S_SCOPE
    } else if text_is(in text, in toks, i, in "expr".as_bytes()) {
        S_EXPR
    } else if text_is(in text, in toks, i, in "ty".as_bytes()) {
        S_TY
    } else if text_is(in text, in toks, i, in "pat".as_bytes()) {
        S_PAT
    } else if text_is(in text, in toks, i, in "args".as_bytes()) {
        S_ARGS
    } else if text_is(in text, in toks, i, in "pats".as_bytes()) {
        S_PATS
    } else if text_is(in text, in toks, i, in "stmts".as_bytes()) {
        S_STMTS
    } else if text_is(in text, in toks, i, in "items".as_bytes()) {
        S_ITEMS
    } else {
        S_OTHER
    }
}

// The passing mode before a capture: 0 none, 1 in, 2 inout, 3 out, 4 sink.
fn pass_code(in text: ChunkSeq[u8], in toks: Toks, i: u64) -> u8 {
    if text_is(in text, in toks, i, in "in".as_bytes()) {
        1
    } else if text_is(in text, in toks, i, in "inout".as_bytes()) {
        2
    } else if text_is(in text, in toks, i, in "out".as_bytes()) {
        3
    } else if text_is(in text, in toks, i, in "sink".as_bytes()) {
        4
    } else {
        0
    }
}

fn op_a(in matcher: Mx, pc: u64) -> u64 {
    w64(in matcher.ops, inc(wrapping_mul(pc, 3)))
}

fn op_b(in matcher: Mx, pc: u64) -> u64 {
    w64(in matcher.ops, add(wrapping_mul(pc, 3), 2))
}

fn cap_count(in matcher: Mx) -> u64 {
    matcher.caps.len() >> 2
}

// Word `field` of capture `cap`.
fn cap_at(in matcher: Mx, cap: u64, field: u64) -> u64 {
    w64(in matcher.caps, add(cap << 2, field))
}

fn push_op(inout matcher: Mx, op: u8, a: u64, b: u64) {
    matcher.ops.push(widen_u64(op));
    matcher.ops.push(a);
    matcher.ops.push(b);
}

fn op_count(in matcher: Mx) -> u64 {
    matcher.ops.len() / 3
}

fn op_kind(in matcher: Mx, pc: u64) -> u8 {
    match matcher.ops.try_get(wrapping_mul(pc, 3)) {
        Option::Some(word) => wrapping_u8(word),
        Option::None => 255,
    }
}

// `compile`: false (and the refusal) for a malformed rule.
fn compile(in pattern: ChunkSeq[u8], in pattern_toks: Toks, inout matcher: Mx) -> bool {
    // Open repetition groups: the op of each `Repeat` and the token index
    // of its closing parenthesis.
    let mut group_ops = ChunkSeq::new[u64]();
    let mut group_ends = ChunkSeq::new[u64]();
    let mut tok: u64 = 0;
    let mut symbol_end: u64 = 0;
    let n = len(in pattern_toks);
    loop {
        if tok >= n {
            break;
        }
        if group_ops.len() != 0 && tok == w64(in group_ends, sub(group_ends.len(), 1)) {
            let begin = w64(in group_ops, sub(group_ops.len(), 1));
            group_ops.truncate(sub(group_ops.len(), 1));
            group_ends.truncate(sub(group_ends.len(), 1));
            tok = inc(tok);
            let sep = if kind(in pattern_toks, tok) == k_star()
                || kind(in pattern_toks, tok) == k_plus()
            {
                NONE
            } else {
                let sep_tok = tok;
                tok = inc(tok);
                sep_tok
            };
            let minimum: u64 = if kind(in pattern_toks, tok) == k_plus() {
                1
            } else if kind(in pattern_toks, tok) == k_star() {
                0
            } else {
                fail(inout matcher, in "invalid sugar repetition".as_bytes());
                return false;
            };
            matcher.ops.try_set(inc(wrapping_mul(begin, 3)), op_count(in matcher));
            matcher.ops.try_set(add(wrapping_mul(begin, 3), 2), minimum);
            push_op(inout matcher, OP_NEXT, begin, sep);
            tok = inc(tok);
            continue;
        }
        if kind(in pattern_toks, tok) != k_dollar() {
            let joint: u64 = if tok < symbol_end {
                1
            } else {
                let end = sugar_operator_end(in pattern_toks, tok);
                if end != 0 {
                    symbol_end = end;
                }
                let last_literal = op_count(in matcher) != 0
                    && op_kind(in matcher, sub(op_count(in matcher), 1)) == OP_LITERAL;
                if tok > 0
                    && last_literal
                    && head_kind(kind(in pattern_toks, sub(tok, 1)))
                    && (kind(in pattern_toks, tok) == k_l_brace()
                        || kind(in pattern_toks, tok) == k_string())
                {
                    if joined(in pattern_toks, tok) { 1 } else { 2 }
                } else {
                    0
                }
            };
            push_op(inout matcher, OP_LITERAL, tok, joint);
            tok = inc(tok);
            continue;
        }
        let start = tok;
        tok = inc(tok);
        if kind(in pattern_toks, tok) == k_l_paren() {
            if group_ops.len() >= HARD_PARSE_DEPTH {
                fail(inout matcher, in "sugar repetition nesting limit exceeded".as_bytes());
                return false;
            }
            group_ops.push(op_count(in matcher));
            group_ends.push(sub(tree_end(in pattern_toks, tok), 1));
            push_op(inout matcher, OP_REPEAT, 0, 0);
            tok = inc(tok);
            continue;
        }
        let sequence = kind(in pattern_toks, tok) == k_dot_dot();
        if sequence {
            tok = inc(tok);
        }
        if !(kind(in pattern_toks, tok) == k_lower() || kind(in pattern_toks, tok) == k_upper())
            || kind(in pattern_toks, inc(tok)) != k_colon()
            || kind(in pattern_toks, add(tok, 2)) != k_lower()
        {
            fail(inout matcher, in "malformed sugar capture".as_bytes());
            return false;
        }
        let name = tok;
        let sort = add(tok, 2);
        let pass = if start > 0 {
            pass_code(in pattern, in pattern_toks, sub(start, 1))
        } else {
            0
        };
        for other in 0..cap_count(in matcher) {
            if same_text(
                in pattern,
                in pattern_toks,
                cap_at(in matcher, other, 0),
                in pattern,
                in pattern_toks,
                name
            ) {
                let mut text = ChunkSeq::new[u8]();
                text.extend(in "duplicate sugar capture `$".as_bytes());
                for j in tok_s(in pattern_toks, name)..tok_e(in pattern_toks, name) {
                    text.push(b8(in pattern, j));
                }
                text.push(96);
                fail(inout matcher, in text.as_slice());
                return false;
            }
        }
        let cap = cap_count(in matcher);
        matcher.caps.push(name);
        matcher.caps.push(sort);
        matcher.caps.push(widen_u64(sort_code(in pattern, in pattern_toks, sort)));
        matcher.caps.push(widen_u64(pass));
        if !spend(inout matcher, group_ops.len()) {
            return false;
        }
        for group in 0..group_ops.len() {
            matcher.rep_names.push(w64(in group_ops, group));
            matcher.rep_names.push(cap);
        }
        tok = add(tok, 3);
        let sort_kind = sort_code(in pattern, in pattern_toks, sort);
        if sequence && tok == n && (sort_kind == S_SCOPE || sort_kind == S_STMTS) {
            push_op(inout matcher, OP_TAIL, cap, 0);
        } else {
            push_op(inout matcher, OP_HOLE, cap, if sequence { 1 } else { 0 });
        }
    }
    if group_ops.len() != 0 {
        fail(inout matcher, in "unclosed sugar repetition".as_bytes());
        return false;
    }
    true
}

// `valid_fragment`: 0 false, 1 true, 2 refused.
fn valid_fragment(
    sort: u8,
    sequence: bool,
    in invocation: ChunkSeq[u8],
    in invocation_toks: Toks,
    range_start: u64,
    range_end: u64,
    inout matcher: Mx
) -> u64 {
    if !spend(inout matcher, sub(range_end, range_start)) {
        return 2;
    }
    if !sequence && range_end == range_start {
        return 0;
    }
    let one_tree = range_end != range_start
        && tree_end(in invocation_toks, range_start) == range_end;
    if sort == S_IDENT {
        let tok_kind = kind(in invocation_toks, range_start);
        let ok = sub(range_end, range_start) == 1
            && (tok_kind == k_lower()
                || tok_kind == k_upper()
                || tok_kind == k_state()
                || tok_kind == k_with()
                || tok_kind == k_linear()
                || tok_kind == k_eff());
        return if ok { 1 } else { 0 };
    }
    if sort == S_PLACE {
        let tok_kind = kind(in invocation_toks, range_start);
        if !(tok_kind == k_lower()
            || tok_kind == k_self_kw()
            || tok_kind == k_state()
            || tok_kind == k_with()
            || tok_kind == k_linear()
            || tok_kind == k_eff())
        {
            return 0;
        }
        let mut tok = inc(range_start);
        loop {
            if tok >= range_end {
                break;
            }
            let tok_kind = kind(in invocation_toks, tok);
            if tok_kind == k_dot() && head_kind(kind(in invocation_toks, inc(tok))) {
                tok = add(tok, 2);
            } else if tok_kind == k_l_bracket()
                && tree_end(in invocation_toks, tok) <= range_end
                && tree_end(in invocation_toks, tok) > add(tok, 2)
            {
                tok = tree_end(in invocation_toks, tok);
            } else {
                return 0;
            }
        }
        if tok != range_end {
            return 0;
        }
    } else if (sort == S_BLOCK || sort == S_SCOPE)
        && !sequence
        && (!one_tree || kind(in invocation_toks, range_start) != k_l_brace())
    {
        return 0;
    }
    let mut wrapped = ChunkSeq::new[u8]();
    let mut suffix = ChunkSeq::new[u8]();
    if (sort == S_EXPR || sort == S_PLACE || sort == S_BLOCK || sort == S_SCOPE) && !sequence {
        wrapped.extend(in "fn __f(){let __x = (".as_bytes());
        suffix.extend(in ");}".as_bytes());
    } else if sort == S_TY {
        wrapped.extend(in "fn __f(__x: ".as_bytes());
        suffix.extend(in "){}".as_bytes());
    } else if sort == S_PAT {
        wrapped.extend(in "fn __f(){let ".as_bytes());
        suffix.extend(in " = __x;}".as_bytes());
    } else if sort == S_ARGS {
        wrapped.extend(in "fn __f(){__call(".as_bytes());
        suffix.extend(in ");}".as_bytes());
    } else if sort == S_PATS {
        wrapped.extend(in "fn __f(){let (".as_bytes());
        suffix.extend(in ") = __x;}".as_bytes());
    } else if sort == S_STMTS || sort == S_SCOPE {
        wrapped.extend(in "fn __f(){".as_bytes());
        suffix.extend(in "\n}".as_bytes());
    } else if sort == S_ITEMS {} else {
        return 3;
    }
    if !sequence {
        let mut tok = range_start;
        loop {
            if tok >= range_end {
                break;
            }
            let tok_kind = kind(in invocation_toks, tok);
            if tok_kind == k_semi() || tok_kind == k_comma() {
                return 0;
            }
            tok = tree_end(in invocation_toks, tok);
        }
    }
    let (span_start, span_end) = if range_end == range_start {
        (0, 0)
    } else {
        (tok_s(in invocation_toks, range_start), tok_e(in invocation_toks, sub(range_end, 1)))
    };
    if !spend(inout matcher, add(add(wrapped.len(), sub(span_end, span_start)), suffix.len())) {
        return 2;
    }
    for j in span_start..span_end {
        wrapped.push(b8(in invocation, j));
    }
    wrapped.extend(in suffix.as_slice());
    let mut text = ChunkSeq::new[u8]();
    let status = surface_fragment_status(in wrapped.as_slice(), inout text);
    if status == 2 {
        fail(inout matcher, in text.as_slice());
        return 2;
    }
    if status == 0 { 1 } else { 0 }
}

// `State::record`: log one event under the first `frame_count` frames of `frames`.
fn record(
    inout matcher: Mx,
    in frames: ChunkSeq[u64],
    frame_count: u64,
    log: u64,
    event_kind: u8,
    a: u64,
    b: u64,
    c: u64,
    from_tail: u8
) -> u64 {
    if !spend(inout matcher, inc(frame_count)) {
        return NONE;
    }
    let id = matcher.records.len() / REC;
    matcher.records.push(log);
    matcher.records.push(matcher.index_pool.len());
    matcher.records.push(frame_count);
    for frame in 0..frame_count {
        matcher.index_pool.push(w64(in frames, inc(wrapping_mul(frame, 3))));
    }
    matcher.records.push(widen_u64(event_kind));
    matcher.records.push(a);
    matcher.records.push(b);
    matcher.records.push(c);
    matcher.records.push(widen_u64(from_tail));
    id
}

// Pushes a state with the first `frame_count` frames of `frames`.
fn push_state(
    inout matcher: Mx,
    pc: u64,
    pos: u64,
    log: u64,
    pending_pc: u64,
    pending_start: u64,
    pending_end: u64,
    in frames: ChunkSeq[u64],
    frame_count: u64
) {
    matcher.stack.push(pc);
    matcher.stack.push(pos);
    matcher.stack.push(log);
    matcher.stack.push(pending_pc);
    matcher.stack.push(pending_start);
    matcher.stack.push(pending_end);
    matcher.stack.push(matcher.frame_pool.len());
    matcher.stack.push(frame_count);
    for j in 0..wrapping_mul(frame_count, 3) {
        matcher.frame_pool.push(w64(in frames, j));
    }
}

fn ext_less(in matcher: Mx, a_first: u64, a_len: u64, b_first: u64, b_len: u64) -> bool {
    let mut i: u64 = 0;
    loop {
        if i >= a_len || i >= b_len {
            return a_len < b_len;
        }
        let left = w64(in matcher.index_pool, add(a_first, i));
        let right = w64(in matcher.index_pool, add(b_first, i));
        if left != right {
            return left < right;
        }
        i = inc(i);
    }
    false
}

fn name_less(
    in pattern: ChunkSeq[u8],
    in pattern_toks: Toks,
    left_tok: u64,
    right_tok: u64
) -> bool {
    let (left_start, left_end) = (
        tok_s(in pattern_toks, left_tok),
        tok_e(in pattern_toks, left_tok)
    );
    let (right_start, right_end) = (
        tok_s(in pattern_toks, right_tok),
        tok_e(in pattern_toks, right_tok)
    );
    let mut i: u64 = 0;
    loop {
        if add(left_start, i) >= left_end || add(right_start, i) >= right_end {
            return sub(left_end, left_start) < sub(right_end, right_start);
        }
        let left_byte = b8(in pattern, add(left_start, i));
        let right_byte = b8(in pattern, add(right_start, i));
        if left_byte != right_byte {
            return left_byte < right_byte;
        }
        i = inc(i);
    }
    false
}

fn push_text(inout out: ChunkSeq[u64], in bytes: ChunkSeq[u8], start: u64, end: u64) {
    out.push(sub(end, start));
    for j in start..end {
        out.push(widen_u64(b8(in bytes, j)));
    }
}

// The captures of a match whose log ends at `log`: [1, work, captures]
// (see `match_rule_encoded`), or false (and the refusal).
fn collect(
    in pattern: ChunkSeq[u8],
    in pattern_toks: Toks,
    inout matcher: Mx,
    log: u64,
    inout out: ChunkSeq[u64]
) -> bool {
    // The log, newest first, as Rust walks it.
    let mut chain = ChunkSeq::new[u64]();
    let mut at = log;
    loop {
        if at == NONE {
            break;
        }
        chain.push(at);
        at = rec_at(in matcher, at, 0);
    }
    // Per record, in the walk's order: the values it adds, or the extents.
    for link in 0..chain.len() {
        let event = w64(in chain, link);
        let index_len = rec_at(in matcher, event, 2);
        if rec_at(in matcher, event, 3) == 0 {
            let span = sub(rec_at(in matcher, event, 6), rec_at(in matcher, event, 5));
            if !spend(inout matcher, add(span, index_len)) {
                return false;
            }
        } else {
            let begin = rec_at(in matcher, event, 4);
            for j in 0..(matcher.rep_names.len() >> 1) {
                if w64(in matcher.rep_names, j << 1) == begin
                    && !spend(inout matcher, inc(index_len))
                {
                    return false;
                }
            }
        }
    }
    // Captures in name order.
    let num_caps = cap_count(in matcher);
    let mut order = ChunkSeq::new[u64]();
    for cap_index in 0..num_caps {
        let mut slot = order.len();
        order.push(cap_index);
        loop {
            if slot == 0 {
                break;
            }
            let prev = w64(in order, sub(slot, 1));
            if !name_less(
                in pattern,
                in pattern_toks,
                cap_at(in matcher, cap_index, 0),
                cap_at(in matcher, prev, 0)
            ) {
                break;
            }
            order.try_set(slot, prev);
            slot = sub(slot, 1);
        }
        order.try_set(slot, cap_index);
    }
    out.push(MATCH_FOUND);
    out.push(matcher.work);
    out.push(num_caps);
    for rank in 0..num_caps {
        let cap = w64(in order, rank);
        let name = cap_at(in matcher, cap, 0);
        push_text(
            inout out,
            in pattern,
            tok_s(in pattern_toks, name),
            tok_e(in pattern_toks, name)
        );
        let sort = cap_at(in matcher, cap, 1);
        push_text(
            inout out,
            in pattern,
            tok_s(in pattern_toks, sort),
            tok_e(in pattern_toks, sort)
        );
        out.push(cap_at(in matcher, cap, 3));
        // Values oldest first.
        let mut vals = ChunkSeq::new[u64]();
        let mut val_link = chain.len();
        loop {
            if val_link == 0 {
                break;
            }
            val_link = sub(val_link, 1);
            let event = w64(in chain, val_link);
            if rec_at(in matcher, event, 3) == 0 && rec_at(in matcher, event, 4) == cap {
                vals.push(event);
            }
        }
        out.push(vals.len());
        for v in 0..vals.len() {
            let event = w64(in vals, v);
            out.push(rec_at(in matcher, event, 5));
            out.push(rec_at(in matcher, event, 6));
            out.push(rec_at(in matcher, event, 7));
            let idx_first = rec_at(in matcher, event, 1);
            let idx_len = rec_at(in matcher, event, 2);
            out.push(idx_len);
            for j in 0..idx_len {
                out.push(w64(in matcher.index_pool, add(idx_first, j)));
            }
        }
        // Extents: the oldest record of each index vector wins (Rust walks
        // newest first and overwrites), sorted by index vector.
        let mut ext = ChunkSeq::new[u64]();
        let mut ext_link = chain.len();
        loop {
            if ext_link == 0 {
                break;
            }
            ext_link = sub(ext_link, 1);
            let event = w64(in chain, ext_link);
            if rec_at(in matcher, event, 3) != 1 {
                continue;
            }
            let begin = rec_at(in matcher, event, 4);
            let mut named = false;
            for j in 0..(matcher.rep_names.len() >> 1) {
                if w64(in matcher.rep_names, j << 1) == begin
                    && w64(in matcher.rep_names, inc(j << 1)) == cap
                {
                    named = true;
                }
            }
            if !named {
                continue;
            }
            let idx_first = rec_at(in matcher, event, 1);
            let idx_len = rec_at(in matcher, event, 2);
            let mut seen = false;
            for ext_pos in 0..ext.len() {
                let other = w64(in ext, ext_pos);
                let other_first = rec_at(in matcher, other, 1);
                let other_len = rec_at(in matcher, other, 2);
                if !ext_less(in matcher, idx_first, idx_len, other_first, other_len)
                    && !ext_less(in matcher, other_first, other_len, idx_first, idx_len)
                {
                    seen = true;
                }
            }
            if seen {
                continue;
            }
            let mut slot = ext.len();
            ext.push(event);
            loop {
                if slot == 0 {
                    break;
                }
                let other = w64(in ext, sub(slot, 1));
                if !ext_less(
                    in matcher,
                    idx_first,
                    idx_len,
                    rec_at(in matcher, other, 1),
                    rec_at(in matcher, other, 2)
                ) {
                    break;
                }
                ext.try_set(slot, other);
                slot = sub(slot, 1);
            }
            ext.try_set(slot, event);
        }
        out.push(ext.len());
        for ext_pos in 0..ext.len() {
            let event = w64(in ext, ext_pos);
            let idx_first = rec_at(in matcher, event, 1);
            let idx_len = rec_at(in matcher, event, 2);
            out.push(idx_len);
            for j in 0..idx_len {
                out.push(w64(in matcher.index_pool, add(idx_first, j)));
            }
            out.push(rec_at(in matcher, event, 5));
        }
    }
    true
}

fn refused(in matcher: Mx) -> ChunkSeq[u64] {
    let mut out = ChunkSeq::new[u64]();
    out.push(MATCH_REFUSED);
    out.push(matcher.work);
    out.push(matcher.msg.len());
    for j in 0..matcher.msg.len() {
        out.push(widen_u64(b8(in matcher.msg, j)));
    }
    out
}

// `match_rule(pattern, invocation, tail, work)` as words:
//   Err(message)   [2, work, len, message bytes]
//   Ok(None)       [0, work]
//   Ok(Some(caps)) [1, work, count, per capture in name order:
//                   name (len, bytes), sort (len, bytes), pass (0 none,
//                   1 in, 2 inout, 3 out, 4 sink), values (count, per
//                   value: start, end, from_tail, indices (len, words)),
//                   extents (count, per extent in index order: indices
//                   (len, words), count)]
// where `work` is the budget left. A capture's text is its span of the
// invocation, or of the tail when `from_tail` (the matcher reads only the
// tail's length).
pub fn match_rule_encoded(
    in pattern: ChunkSeq[u8],
    in invocation: ChunkSeq[u8],
    has_tail: bool,
    tail_len: u64,
    work: u64
) -> ChunkSeq[u64] {
    let mut matcher = mx_new(work);
    if !spend(inout matcher, add(pattern.len(), invocation.len())) {
        return refused(in matcher);
    }
    let mut pattern_toks = toks_empty();
    if !toks_new(in pattern, inout matcher, inout pattern_toks) {
        return refused(in matcher);
    }
    let mut invocation_toks = toks_empty();
    if !toks_new(in invocation, inout matcher, inout invocation_toks) {
        return refused(in matcher);
    }
    if !compile(in pattern, in pattern_toks, inout matcher) {
        return refused(in matcher);
    }
    let nops = op_count(in matcher);
    let mut limit = len(in invocation_toks);
    // A statement ending in a brace may carry an optional semicolon.
    let mut last_semi = false;
    let mut j = nops;
    loop {
        if j == 0 {
            break;
        }
        j = sub(j, 1);
        let last_kind = op_kind(in matcher, j);
        if last_kind != OP_TAIL {
            last_semi = last_kind == OP_LITERAL
                && text_is(in pattern, in pattern_toks, op_a(in matcher, j), in ";".as_bytes());
            break;
        }
    }
    if limit >= 2
        && kind(in invocation_toks, sub(limit, 1)) == k_semi()
        && kind(in invocation_toks, sub(limit, 2)) == k_r_brace()
        && !last_semi
    {
        limit = sub(limit, 1);
    }
    let mut frames = ChunkSeq::new[u64]();
    push_state(inout matcher, 0, 0, NONE, NONE, 0, 0, in frames, 0);
    loop {
        let top = matcher.stack.len() / TD;
        if top == 0 {
            break;
        }
        let at = sub(top, 1);
        let mut pc = w64(in matcher.stack, add(wrapping_mul(at, TD), 0));
        let mut pos = w64(in matcher.stack, add(wrapping_mul(at, TD), 1));
        let mut log = w64(in matcher.stack, add(wrapping_mul(at, TD), 2));
        let pending_pc = w64(in matcher.stack, add(wrapping_mul(at, TD), 3));
        let pending_start = w64(in matcher.stack, add(wrapping_mul(at, TD), 4));
        let pending_end = w64(in matcher.stack, add(wrapping_mul(at, TD), 5));
        let frame_first = w64(in matcher.stack, add(wrapping_mul(at, TD), 6));
        let frame_len = w64(in matcher.stack, add(wrapping_mul(at, TD), 7));
        frames.clear();
        for j in 0..wrapping_mul(frame_len, 3) {
            frames.push(w64(in matcher.frame_pool, add(frame_first, j)));
        }
        matcher.frame_pool.truncate(frame_first);
        matcher.stack.truncate(wrapping_mul(at, TD));
        if pending_pc != NONE {
            let cap = op_a(in matcher, pending_pc);
            let sequence = op_b(in matcher, pending_pc) == 1;
            let validity = valid_fragment(
                wrapping_u8(cap_at(in matcher, cap, 2)),
                sequence,
                in invocation,
                in invocation_toks,
                pending_start,
                pending_end,
                inout matcher
            );
            if validity == 3 {
                let mut text = ChunkSeq::new[u8]();
                text.extend(in "unknown sugar hole sort `".as_bytes());
                let sort = cap_at(in matcher, cap, 1);
                for j in tok_s(in pattern_toks, sort)..tok_e(in pattern_toks, sort) {
                    text.push(b8(in pattern, j));
                }
                text.push(96);
                fail(inout matcher, in text.as_slice());
                return refused(in matcher);
            }
            if validity == 2 {
                return refused(in matcher);
            }
            if validity == 0 {
                continue;
            }
            let (value_start, value_end) = if pending_end == pending_start {
                let offset = if pending_start < len(in invocation_toks) {
                    tok_s(in invocation_toks, pending_start)
                } else {
                    invocation.len()
                };
                (offset, offset)
            } else {
                (
                    tok_s(in invocation_toks, pending_start),
                    tok_e(in invocation_toks, sub(pending_end, 1))
                )
            };
            log = record(
                inout matcher,
                in frames,
                frames.len() / 3,
                log,
                0,
                cap,
                value_start,
                value_end,
                0
            );
            if log == NONE {
                return refused(in matcher);
            }
        }
        loop {
            if !spend(inout matcher, 1) {
                return refused(in matcher);
            }
            if pc >= nops {
                if pos != limit {
                    break;
                }
                let mut out = ChunkSeq::new[u64]();
                if !collect(in pattern, in pattern_toks, inout matcher, log, inout out) {
                    return refused(in matcher);
                }
                return out;
            }
            let op = op_kind(in matcher, pc);
            let a = op_a(in matcher, pc);
            let b = op_b(in matcher, pc);
            let frame_count = frames.len() / 3;
            if op == OP_LITERAL {
                if pos == limit
                    || !same_text(
                        in pattern,
                        in pattern_toks,
                        a,
                        in invocation,
                        in invocation_toks,
                        pos
                    )
                {
                    break;
                }
                if b != 0 && (pos == 0 || joined(in invocation_toks, pos) != (b == 1)) {
                    break;
                }
                pos = inc(pos);
                pc = inc(pc);
            } else if op == OP_TAIL {
                if !has_tail {
                    break;
                }
                if pos != limit {
                    break;
                }
                log = record(inout matcher, in frames, frame_count, log, 0, a, 0, tail_len, 1);
                if log == NONE {
                    return refused(in matcher);
                }
                pc = inc(pc);
            } else if op == OP_HOLE {
                let sequence = b == 1;
                let start = pos;
                let mut end = start;
                let scalar = wrapping_u8(cap_at(in matcher, a, 2));
                loop {
                    if !spend(inout matcher, 1) {
                        return refused(in matcher);
                    }
                    let length_ok = (sequence || end > start)
                        && (
                            if scalar == S_IDENT {
                                end == inc(start)
                            } else if (scalar == S_BLOCK || scalar == S_SCOPE) && !sequence {
                                kind(in invocation_toks, start) == k_l_brace()
                                    && start < len(in invocation_toks)
                                    && tree_end(in invocation_toks, start) == end
                            } else {
                                true
                            }
                        );
                    let next_kind = op_kind(in matcher, inc(pc));
                    let next_ok = if next_kind == 255 || next_kind == OP_TAIL {
                        end == limit
                    } else if next_kind == OP_LITERAL {
                        end < limit
                            && same_text(
                                in pattern,
                                in pattern_toks,
                                op_a(in matcher, inc(pc)),
                                in invocation,
                                in invocation_toks,
                                end
                            )
                    } else {
                        true
                    };
                    if length_ok && next_ok {
                        if !spend(inout matcher, inc(frame_count)) {
                            return refused(in matcher);
                        }
                        push_state(
                            inout matcher,
                            inc(pc),
                            end,
                            log,
                            pc,
                            start,
                            end,
                            in frames,
                            frame_count
                        );
                    }
                    if end == limit || closer(kind(in invocation_toks, end)) {
                        break;
                    }
                    if !sequence
                        && (kind(in invocation_toks, end) == k_comma()
                            || kind(in invocation_toks, end) == k_semi())
                    {
                        break;
                    }
                    if end > start
                        && (scalar == S_IDENT
                            || (!sequence && (scalar == S_BLOCK || scalar == S_SCOPE)))
                    {
                        break;
                    }
                    end = tree_end(in invocation_toks, end);
                }
                break;
            } else if op == OP_REPEAT {
                if b == 0 {
                    if !spend(inout matcher, inc(frame_count)) {
                        return refused(in matcher);
                    }
                    let skip_log = record(
                        inout matcher,
                        in frames,
                        frame_count,
                        log,
                        1,
                        pc,
                        0,
                        0,
                        0
                    );
                    if skip_log == NONE {
                        return refused(in matcher);
                    }
                    push_state(
                        inout matcher,
                        inc(a),
                        pos,
                        skip_log,
                        NONE,
                        0,
                        0,
                        in frames,
                        frame_count
                    );
                }
                frames.push(pc);
                frames.push(0);
                frames.push(pos);
                pc = inc(pc);
            } else {
                // Next: `a` is the repetition's op, `b` its separator.
                let top_frame = sub(frame_count, 1);
                let index = w64(in frames, add(wrapping_mul(top_frame, 3), 1));
                let frame_start = w64(in frames, add(wrapping_mul(top_frame, 3), 2));
                if pos == frame_start {
                    break;
                }
                let count = inc(index);
                if !spend(inout matcher, inc(frame_count)) {
                    return refused(in matcher);
                }
                let done_log = record(inout matcher, in frames, top_frame, log, 1, a, count, 0, 0);
                if done_log == NONE {
                    return refused(in matcher);
                }
                push_state(inout matcher, inc(pc), pos, done_log, NONE, 0, 0, in frames, top_frame);
                if b != NONE {
                    if pos == limit
                        || !same_text(
                            in pattern,
                            in pattern_toks,
                            b,
                            in invocation,
                            in invocation_toks,
                            pos
                        )
                    {
                        break;
                    }
                    pos = inc(pos);
                }
                if pos == limit {
                    break;
                }
                frames.try_set(add(wrapping_mul(top_frame, 3), 1), count);
                frames.try_set(add(wrapping_mul(top_frame, 3), 2), pos);
                pc = inc(a);
            }
        }
    }
    let mut out = ChunkSeq::new[u64]();
    out.push(MATCH_NONE);
    out.push(matcher.work);
    out
}

// Compile only unambiguous, delimiter-separated expr captures for the
// bootstrap path. The host matcher still handles repetitions, other sorts
// and ambiguous rule boundaries.
pub fn match_bootstrap_scalar_encoded(
    in pattern: ChunkSeq[u8],
    in invocation: ChunkSeq[u8],
    work: u64
) -> ChunkSeq[u64] {
    let mut matcher = mx_new(work);
    if !spend(inout matcher, add(pattern.len(), invocation.len())) {
        return refused(in matcher);
    }
    let mut p = toks_empty();
    let mut target = toks_empty();
    if !toks_new(in pattern, inout matcher, inout p)
        || !toks_new(in invocation, inout matcher, inout target)
    {
        return refused(in matcher);
    }
    let mut i: u64 = 0;
    let mut j: u64 = 0;
    let mut names = ChunkSeq::new[u64]();
    let mut out = ChunkSeq::new[u64]();
    out.push(MATCH_FOUND);
    out.push(work);
    out.push(0);
    let mut previous_literal = false;
    loop {
        if i == len(in p) {
            break;
        }
        if !spend(inout matcher, 1) {
            return refused(in matcher);
        }
        if kind(in p, i) != k_dollar() {
            if sugar_operator_end(in p, i) != 0 {
                fail(inout matcher, in "unsupported bootstrap operator pattern".as_bytes());
                return refused(in matcher);
            }
            if j >= len(in target) || !same_text(in pattern, in p, i, in invocation, in target, j) {
                return no_match(in matcher);
            }
            if i > 0
                && previous_literal
                && head_kind(kind(in p, sub(i, 1)))
                && (kind(in p, i) == k_l_brace() || kind(in p, i) == k_string())
                && joined(in p, i) != joined(in target, j)
            {
                return no_match(in matcher);
            }
            previous_literal = true;
            i = inc(i);
            j = inc(j);
            continue;
        }
        let name = inc(i);
        let colon = inc(name);
        let sort = inc(colon);
        let separator = inc(sort);
        let delimiter = kind(in p, separator);
        if !(kind(in p, name) == k_lower() || kind(in p, name) == k_upper())
            || kind(in p, colon) != k_colon()
            || !text_is(in pattern, in p, sort, in "expr".as_bytes())
            || !(delimiter == k_semi() || delimiter == k_comma() || closer(delimiter))
            || (i > 0 && pass_code(in pattern, in p, sub(i, 1)) > 1)
        {
            fail(inout matcher, in "unsupported bootstrap capture pattern".as_bytes());
            return refused(in matcher);
        }
        for n in 0..names.len() {
            if !spend(inout matcher, 1) {
                return refused(in matcher);
            }
            if same_text(in pattern, in p, name, in pattern, in p, w64(in names, n)) {
                fail(inout matcher, in "duplicate bootstrap capture name".as_bytes());
                return refused(in matcher);
            }
        }
        names.push(name);
        let begin = j;
        loop {
            if j >= len(in target) {
                return no_match(in matcher);
            }
            if !spend(inout matcher, 1) {
                return refused(in matcher);
            }
            let k = kind(in target, j);
            if k == delimiter {
                break;
            }
            if k == k_semi() || k == k_comma() || closer(k) {
                return no_match(in matcher);
            }
            j = tree_end(in target, j);
        }
        if j == begin {
            return no_match(in matcher);
        }
        let start = tok_s(in target, begin);
        let end = tok_e(in target, sub(j, 1));
        let open = "fn __f(){let __x = (".as_bytes();
        let suffix = ");}".as_bytes();
        if !spend(inout matcher, add(add(open.len(), sub(end, start)), suffix.len())) {
            return refused(in matcher);
        }
        let mut wrapped = ChunkSeq::new[u8]();
        wrapped.extend(in open);
        for n in start..end {
            wrapped.push(b8(in invocation, n));
        }
        wrapped.extend(in suffix);
        let mut message = ChunkSeq::new[u8]();
        let status = surface_fragment_status(in wrapped.as_slice(), inout message);
        if status == 2 {
            fail(inout matcher, in message.as_slice());
            return refused(in matcher);
        }
        if status != 0 {
            return no_match(in matcher);
        }
        push_text(inout out, in pattern, tok_s(in p, name), tok_e(in p, name));
        push_text(inout out, in pattern, tok_s(in p, sort), tok_e(in p, sort));
        out.push(
            if i == 0 {
                0
            } else {
                widen_u64(pass_code(in pattern, in p, sub(i, 1)))
            }
        );
        out.push(1);
        // One scalar fragment.
        out.push(start);
        out.push(end);
        out.push(0);
        // From the invocation, never a separate tail.
        out.push(0);
        // No repeat indices.
        out.push(0);
        // No repetition extents.
        previous_literal = false;
        i = separator;
    }
    if j != len(in target) {
        return no_match(in matcher);
    }
    out.try_set(1, matcher.work);
    out.try_set(2, names.len());
    out
}

fn no_match(in matcher: Mx) -> ChunkSeq[u64] {
    let mut words = ChunkSeq::new[u64]();
    words.push(MATCH_NONE);
    words.push(matcher.work);
    words
}
