// `sugar_expand::scope`: exit-aware scope captures, a transliteration of
// crates/vesper-syntax/src/sugar_expand/scope.rs.
//
// A rule that captures the rest of a block as a `scope` binds it with
// `let exit = $..r;`, runs its cleanup and resumes `exit.resume()` as the
// block's tail. `lower` reifies the scope's exits (return, break,
// continue, `?` under an Option result, and the caller's Fail rows) as
// values of a wrapper loop and handlers, then dispatches them at the
// resume. The scope body is parsed by the core parser (@vesper/ast
// `lower_source`); the ambient effect rows and result type come from the
// surface profile of the whole source (`lower_surface_source`, which does
// not run the expression macro validation of `parse_expansion_scopes`).
//
// Spans are (start, end) pairs in `ChunkSeq[u64]` rows; edits are rows of
// (start, end, text first, text length, forwarded) over one text pool.

use @vesper/ast::{
    Ast, ConfNode, EffectDeclNode, EffectNode, EffectsNode, ImplNode, ItemNode, expr_at, list_at,
    list_len, none, type_at
};
use @vesper/ast::lower::{lower_source, lower_surface_source};
use @vesper-std/arena::{idx_from_raw};
use @vesper/front::lex::{
    lex_sugar_raw_with_limits, max_diagnostics, max_source_bytes, max_tokens, token_end, trivia_kind
};
use @vesper/front::diag::{diags_new};
use @vesper/front::kinds::{k_eof};
use self::flow::{Rd, arg_of, clause_of, fn_of, name_byte, name_is, name_len, stmt_of};
use self::template::{Caps, add, b8, cap_at, cap_count, inc, sort_in, sub, value_at, w32, w64};

const NONE: u64 = 18446744073709551615;
const PROBE: Str = "fn __scope_probe() ";
const PROBE_LEN: u64 = 19;

// `Exit`, in Rust's order.
const X_NORMAL: u64 = 0;
const X_RETURN: u64 = 1;
const X_BREAK: u64 = 2;
const X_CONTINUE: u64 = 3;

// The outcome of `lower`: a refusal, or the items the expansion adds.
pub struct Sc {
    failed: bool,
    msg: ChunkSeq[u8],
    items: ChunkSeq[u8]
}

pub fn sc_ok() -> Sc {
    Sc { failed: false, msg: ChunkSeq::new[u8](), items: ChunkSeq::new[u8]() }
}

pub fn sc_err(in message: Slice[u8]) -> Sc {
    let mut result = sc_ok();
    result.failed = true;
    result.msg.extend(in message);
    result
}

pub fn sc_err_seq(in message: ChunkSeq[u8]) -> Sc {
    sc_err(in message.as_slice())
}

// A lexer refusal: its E0003 message (`LexLimit`'s text).
pub fn refusal(in diag: @vesper/front::Diags) -> Sc {
    let end = if diag.at.len() > 1 {
        w32(in diag.at, 1)
    } else {
        diag.text.len()
    };
    let mut message = ChunkSeq::new[u8]();
    for j in w32(in diag.at, 0)..end {
        message.push(b8(in diag.text, j));
    }
    sc_err_seq(in message)
}

// ---------------------------------------------------------------- spans

fn covers(outer_start: u64, outer_end: u64, inner_start: u64, inner_end: u64) -> bool {
    outer_start <= inner_start && outer_end >= inner_end
}

fn sp_s(in spans: ChunkSeq[u64], i: u64) -> u64 {
    w64(in spans, i << 1)
}

fn sp_e(in spans: ChunkSeq[u64], i: u64) -> u64 {
    w64(in spans, inc(i << 1))
}

fn sp_n(in spans: ChunkSeq[u64]) -> u64 {
    spans.len() >> 1
}

fn sp_push(inout spans: ChunkSeq[u64], start: u64, end: u64) {
    spans.push(start);
    spans.push(end);
}

// `outermost`: sorted by (start, Reverse(end)), the spans no earlier kept
// span covers.
fn outermost(in spans: ChunkSeq[u64]) -> ChunkSeq[u64] {
    let n = sp_n(in spans);
    let mut order = ChunkSeq::new[u64]();
    for i in 0..n {
        // Insertion keeps the sort stable.
        let start = sp_s(in spans, i);
        let end = sp_e(in spans, i);
        let mut at = order.len();
        loop {
            if at == 0 {
                break;
            }
            let prev = w64(in order, sub(at, 1));
            let prev_start = sp_s(in spans, prev);
            let prev_end = sp_e(in spans, prev);
            if prev_start < start || prev_start == start && prev_end >= end {
                break;
            }
            at = sub(at, 1);
        }
        order.push(0);
        let mut slot = sub(order.len(), 1);
        loop {
            if slot <= at {
                break;
            }
            order.try_set(slot, w64(in order, sub(slot, 1)));
            slot = sub(slot, 1);
        }
        order.try_set(at, i);
    }
    let mut out = ChunkSeq::new[u64]();
    for rank in 0..n {
        let i = w64(in order, rank);
        let start = sp_s(in spans, i);
        let end = sp_e(in spans, i);
        let kept_len = sp_n(in out);
        if kept_len == 0
            || !covers(sp_s(in out, sub(kept_len, 1)), sp_e(in out, sub(kept_len, 1)), start, end)
        {
            sp_push(inout out, start, end);
        }
    }
    out
}

// `enclosed`: whether the last span starting at or before `span_start` covers it.
fn enclosed(in spans: ChunkSeq[u64], span_start: u64, span_end: u64) -> bool {
    let mut end: u64 = 0;
    for i in 0..sp_n(in spans) {
        if sp_s(in spans, i) <= span_start {
            end = inc(i);
        } else {
            break;
        }
    }
    end > 0
        && covers(sp_s(in spans, sub(end, 1)), sp_e(in spans, sub(end, 1)), span_start, span_end)
}

// ---------------------------------------------------------------- tokens

// `significant`: the non-trivia tokens of `text` as (start, end) rows,
// or the refusal.
fn significant(in text: ChunkSeq[u8], inout toks: ChunkSeq[u64]) -> Sc {
    let mut diags = diags_new();
    let lexed = lex_sugar_raw_with_limits(
        in text.as_slice(),
        inout diags,
        max_source_bytes(),
        max_tokens(),
        max_diagnostics()
    );
    if lexed.rejected {
        return refusal(in diags);
    }
    if diags.code.len() != 0 {
        return sc_err(in "invalid tokens in scope capture".as_bytes());
    }
    for i in 0..lexed.kind.len() {
        let kind = b8(in lexed.kind, i);
        if !trivia_kind(kind) && kind != k_eof() {
            sp_push(inout toks, w32(in lexed.start, i), token_end(in lexed, i));
        }
    }
    sc_ok()
}

fn word_is(in text: ChunkSeq[u8], in toks: ChunkSeq[u64], i: u64, in expected: Slice[u8]) -> bool {
    let (start, end) = if i < sp_n(in toks) {
        (sp_s(in toks, i), sp_e(in toks, i))
    } else {
        (0, 0)
    };
    if sub(end, start) != expected.len() {
        return false;
    }
    for j in 0..expected.len() {
        let byte = match expected.try_get(j) {
            Option::Some(byte) => byte,
            Option::None => 0,
        };
        if b8(in text, add(start, j)) != byte {
            return false;
        }
    }
    true
}

fn words_eq(in text: ChunkSeq[u8], in toks: ChunkSeq[u64], i: u64, other: u64) -> bool {
    let n = sp_n(in toks);
    let (start, end) = if i < n {
        (sp_s(in toks, i), sp_e(in toks, i))
    } else {
        (0, 0)
    };
    let (other_start, other_end) = if other < n {
        (sp_s(in toks, other), sp_e(in toks, other))
    } else {
        (0, 0)
    };
    if sub(end, start) != sub(other_end, other_start) {
        return false;
    }
    for j in 0..sub(end, start) {
        if b8(in text, add(start, j)) != b8(in text, add(other_start, j)) {
            return false;
        }
    }
    true
}

// ---------------------------------------------------------------- AST

fn effect_of(in ast: Ast, i: u32) -> EffectNode {
    ast.effect_nodes
        .get_or(idx_from_raw[EffectNode](i), EffectNode { label: none(), name: none(), args: 0 })
}

fn effects_of(in ast: Ast, i: u32) -> EffectsNode {
    ast.effects.get_or(idx_from_raw[EffectsNode](i), EffectsNode { instances: 0, tail: none() })
}

fn item_of(in ast: Ast, item_index: u64) -> ItemNode {
    let raw = match ast.m_items.try_get(item_index) {
        Option::Some(id) => id,
        Option::None => none(),
    };
    ast.items.get_or(idx_from_raw[ItemNode](raw), ItemNode { kind: 0, node: 0 })
}

fn rel_s(in ast: Ast, expr: u32) -> u64 {
    sub(widen_u64(expr_at(in ast, expr).start), PROBE_LEN)
}

fn rel_e(in ast: Ast, expr: u32) -> u64 {
    sub(widen_u64(expr_at(in ast, expr).end), PROBE_LEN)
}

// The children of `expr` in `parser::walk_exprs` order.
fn kids(in ast: Ast, expr: u32) -> ChunkSeq[u32] {
    let expr_node = expr_at(in ast, expr);
    let mut out = ChunkSeq::new[u32]();
    let kind = expr_node.kind;
    if kind == 3 {
        for i in 0..list_len(in ast, expr_node.a) {
            out.push(list_at(in ast, expr_node.a, i));
        }
    } else if kind == 4 {
        for i in 0..(list_len(in ast, expr_node.b) >> 1) {
            out.push(list_at(in ast, expr_node.b, inc(i << 1)));
        }
    } else if kind == 5 {
        for i in 0..list_len(in ast, expr_node.a) {
            let stmt = stmt_of(in ast, list_at(in ast, expr_node.a, i));
            if stmt.value != none() {
                out.push(stmt.value);
            }
        }
        if expr_node.b != none() {
            out.push(expr_node.b);
        }
    } else if kind == 6 {
        out.push(expr_node.a);
        for i in 0..list_len(in ast, expr_node.c) {
            out.push(arg_of(in ast, list_at(in ast, expr_node.c, i)).expr);
        }
    } else if kind == 7 || kind == 9 || kind == 17 {
        out.push(expr_node.a);
    } else if kind == 10 {
        out.push(expr_node.b);
    } else if kind == 8 || kind == 19 {
        out.push(expr_node.a);
        out.push(expr_node.b);
    } else if kind == 11 || kind == 12 {
        out.push(expr_node.b);
        out.push(expr_node.c);
    } else if kind == 13 {
        out.push(expr_node.a);
        out.push(expr_node.b);
        if expr_node.c != none() {
            out.push(expr_node.c);
        }
    } else if kind == 14 {
        out.push(expr_node.a);
        for i in 0..(list_len(in ast, expr_node.b) >> 1) {
            out.push(list_at(in ast, expr_node.b, inc(i << 1)));
        }
    } else if kind == 15 {
        out.push(expr_node.e);
    } else if kind == 16 {
        if expr_node.b != none() && expr_node.c != none() {
            out.push(expr_node.c);
        }
        out.push(expr_node.d);
        for i in 0..list_len(in ast, expr_node.e) {
            out.push(clause_of(in ast, list_at(in ast, expr_node.e, i)).body);
        }
    } else if kind == 18 {
        out.push(expr_node.b);
        out.push(expr_node.c);
    } else if kind == 20 || kind == 21 {
        if expr_node.a != none() {
            out.push(expr_node.a);
        }
    }
    out
}

// The expressions under `root` in `walk_exprs` order (children first).
fn post_order(in ast: Ast, root: u32) -> ChunkSeq[u32] {
    let mut out = ChunkSeq::new[u32]();
    // A stack of (expression, next child) rows.
    let mut stack = ChunkSeq::new[u64]();
    let mut kid_lists = ChunkSeq::new[u32]();
    let mut kid_at = ChunkSeq::new[u64]();
    stack.push(widen_u64(root));
    stack.push(0);
    kid_at.push(0);
    let first = kids(in ast, root);
    kid_at.push(first.len());
    kid_lists.extend(in first.as_slice());
    loop {
        let depth = stack.len() >> 1;
        if depth == 0 {
            break;
        }
        let top = sub(depth, 1);
        let expr = wrapping_u32(w64(in stack, top << 1));
        let next = w64(in stack, inc(top << 1));
        let base = w64(in kid_at, top << 1);
        let count = w64(in kid_at, inc(top << 1));
        if next < count {
            stack.try_set(inc(top << 1), inc(next));
            let child = match kid_lists.try_get(add(base, next)) {
                Option::Some(kid) => kid,
                Option::None => none(),
            };
            if child == none() {
                continue;
            }
            let child_kids = kids(in ast, child);
            stack.push(widen_u64(child));
            stack.push(0);
            kid_at.push(kid_lists.len());
            kid_at.push(child_kids.len());
            kid_lists.extend(in child_kids.as_slice());
        } else {
            out.push(expr);
            stack.truncate(top << 1);
            kid_at.truncate(top << 1);
            kid_lists.truncate(base);
        }
    }
    out
}

// ---------------------------------------------------------------- jumps

// `Control`: jumps as rows (exit, start, end, value start or NONE, value
// end), `?` as rows (whole start, end, operand start, end).
struct Ctl {
    jumps: ChunkSeq[u64],
    questions: ChunkSeq[u64],
    crosses_loop: bool,
    question_in_handler: bool
}

fn j_n(in ctl: Ctl) -> u64 {
    ctl.jumps.len() / 5
}

fn j_at(in ctl: Ctl, jump: u64, field: u64) -> u64 {
    w64(in ctl.jumps, add(wrapping_mul(jump, 5), field))
}

fn jumps(in body: ChunkSeq[u8], inout ctl: Ctl) -> Sc {
    let mut probe_text = ChunkSeq::new[u8]();
    probe_text.extend(in PROBE.as_bytes());
    probe_text.extend(in body.as_slice());
    let source = match String::from_utf8(in probe_text.as_slice()) {
        Option::Some(decoded) => decoded,
        Option::None => String::new(),
    };
    let lowered = lower_source(in source.as_str());
    if lowered.p.d.code.len() != 0 {
        return sc_err(in "expand nested surface forms before capturing a scope".as_bytes());
    }
    let ast = lowered.ast;
    let item = item_of(in ast, 0);
    if ast.m_items.len() == 0 || item.kind != 2 {
        return sc_err(in "invalid scope body".as_bytes());
    }
    let func = fn_of(in ast, item.node);
    if func.body == none() {
        return sc_err(in "invalid scope body".as_bytes());
    }
    let mut closures = ChunkSeq::new[u64]();
    let mut loops = ChunkSeq::new[u64]();
    let mut handlers = ChunkSeq::new[u64]();
    let mut forbidden = ChunkSeq::new[u64]();
    let mut jump_rows = ChunkSeq::new[u64]();
    let mut tries = ChunkSeq::new[u64]();
    let order = post_order(in ast, func.body);
    for order_index in 0..order.len() {
        let expr = match order.try_get(order_index) {
            Option::Some(expr) => expr,
            Option::None => none(),
        };
        let expr_node = expr_at(in ast, expr);
        let kind = expr_node.kind;
        if kind == 15 {
            sp_push(inout closures, rel_s(in ast, expr_node.e), rel_e(in ast, expr_node.e));
        } else if kind == 17 {
            sp_push(inout loops, rel_s(in ast, expr_node.a), rel_e(in ast, expr_node.a));
        } else if kind == 18 {
            sp_push(inout loops, rel_s(in ast, expr_node.c), rel_e(in ast, expr_node.c));
        } else if kind == 16 {
            sp_push(inout handlers, rel_s(in ast, expr), rel_e(in ast, expr));
            for i in 0..list_len(in ast, expr_node.e) {
                let handler_body = clause_of(in ast, list_at(in ast, expr_node.e, i)).body;
                sp_push(inout forbidden, rel_s(in ast, handler_body), rel_e(in ast, handler_body));
            }
            if name_is(in ast, effect_of(in ast, expr_node.a).name, in "Region".as_bytes()) {
                sp_push(inout forbidden, rel_s(in ast, expr), rel_e(in ast, expr));
            }
        } else if kind == 9 {
            tries.push(rel_s(in ast, expr));
            tries.push(rel_e(in ast, expr));
            tries.push(rel_s(in ast, expr_node.a));
            tries.push(rel_e(in ast, expr_node.a));
        } else if kind == 20 || kind == 21 || kind == 22 {
            jump_rows.push(
                if kind == 20 {
                    X_BREAK
                } else if kind == 21 {
                    X_RETURN
                } else {
                    X_CONTINUE
                }
            );
            jump_rows.push(rel_s(in ast, expr));
            jump_rows.push(rel_e(in ast, expr));
            if kind != 22 && expr_node.a != none() {
                jump_rows.push(rel_s(in ast, expr_node.a));
                jump_rows.push(rel_e(in ast, expr_node.a));
            } else {
                jump_rows.push(NONE);
                jump_rows.push(NONE);
            }
        }
    }
    let closures = outermost(in closures);
    let loops = outermost(in loops);
    let handlers = outermost(in handlers);
    let forbidden = outermost(in forbidden);
    let mut row: u64 = 0;
    loop {
        if row >= jump_rows.len() {
            break;
        }
        let exit = w64(in jump_rows, row);
        let start = w64(in jump_rows, inc(row));
        let end = w64(in jump_rows, add(row, 2));
        let keep = !enclosed(in closures, start, end)
            && (exit == X_RETURN || !enclosed(in loops, start, end));
        if keep {
            for k in 0..5 {
                ctl.jumps.push(w64(in jump_rows, add(row, k)));
            }
        }
        row = add(row, 5);
    }
    for jump in 0..j_n(in ctl) {
        let start = j_at(in ctl, jump, 1);
        let end = j_at(in ctl, jump, 2);
        if enclosed(in forbidden, start, end)
            || j_at(in ctl, jump, 0) != X_RETURN && enclosed(in handlers, start, end)
        {
            return sc_err(
                in "invalid control transfer across a handler or region boundary".as_bytes()
            );
        }
    }
    let mut try_row: u64 = 0;
    loop {
        if try_row >= tries.len() {
            break;
        }
        let start = w64(in tries, try_row);
        let end = w64(in tries, inc(try_row));
        if !enclosed(in closures, start, end) {
            for k in 0..4 {
                ctl.questions.push(w64(in tries, add(try_row, k)));
            }
            if enclosed(in handlers, start, end) {
                ctl.question_in_handler = true;
            }
        }
        try_row = add(try_row, 4);
    }
    for jump in 0..j_n(in ctl) {
        let start = j_at(in ctl, jump, 1);
        let end = j_at(in ctl, jump, 2);
        if j_at(in ctl, jump, 0) == X_RETURN
            && (enclosed(in handlers, start, end) || enclosed(in loops, start, end))
        {
            ctl.crosses_loop = true;
        }
    }
    sc_ok()
}

// ---------------------------------------------------------------- types

// `source_type(t)`: whether `ty` is built of named and tuple types only.
fn source_ok(in ast: Ast, ty: u32) -> bool {
    if ty == none() {
        return true;
    }
    let ty_node = type_at(in ast, ty);
    let list = if ty_node.kind == 1 {
        ty_node.b
    } else if ty_node.kind == 2 {
        ty_node.a
    } else {
        return false;
    };
    for i in 0..list_len(in ast, list) {
        if !source_ok(in ast, list_at(in ast, list, i)) {
            return false;
        }
    }
    true
}

pub fn push_name(inout out: ChunkSeq[u8], in ast: Ast, sym: u32) {
    for j in 0..name_len(in ast, sym) {
        out.push(name_byte(in ast, sym, j));
    }
}

// `Type`'s Display for named and tuple types (an absent type is the unit
// tuple).
fn type_text(inout out: ChunkSeq[u8], in ast: Ast, ty: u32) {
    if ty == none() {
        out.extend(in "()".as_bytes());
        return;
    }
    let ty_node = type_at(in ast, ty);
    if ty_node.kind == 1 {
        let count = list_len(in ast, ty_node.b);
        if count == 1 && name_is(in ast, ty_node.a, in "dyn".as_bytes()) {
            out.extend(in "dyn ".as_bytes());
            type_text(inout out, in ast, list_at(in ast, ty_node.b, 0));
            return;
        }
        push_name(inout out, in ast, ty_node.a);
        if count != 0 {
            out.push(91);
            for i in 0..count {
                if i != 0 {
                    out.extend(in ", ".as_bytes());
                }
                type_text(inout out, in ast, list_at(in ast, ty_node.b, i));
            }
            out.push(93);
        }
    } else if ty_node.kind == 2 {
        out.push(40);
        for i in 0..list_len(in ast, ty_node.a) {
            if i != 0 {
                out.extend(in ", ".as_bytes());
            }
            type_text(inout out, in ast, list_at(in ast, ty_node.a, i));
        }
        out.push(41);
    }
}

// ---------------------------------------------------------------- ambient

// `ambient(source, call)`: the caller's Fail rows (texts, each closed by
// a 0 byte in `rows`) and its result type (text, whether it is a source
// type, whether it is named Option).
struct Amb {
    rows: ChunkSeq[u8],
    row_count: u64,
    result: ChunkSeq[u8],
    result_is_source: bool,
    result_is_option: bool
}

fn has_row(in rows: ChunkSeq[u8], in row: ChunkSeq[u8]) -> bool {
    let mut at: u64 = 0;
    loop {
        if at >= rows.len() {
            return false;
        }
        let mut end = at;
        loop {
            if end >= rows.len() || b8(in rows, end) == 0 {
                break;
            }
            end = inc(end);
        }
        if sub(end, at) == row.len() {
            let mut same = true;
            for j in 0..row.len() {
                if b8(in rows, add(at, j)) != b8(in row, j) {
                    same = false;
                    break;
                }
            }
            if same {
                return true;
            }
        }
        at = inc(end);
    }
}

fn ambient(in source: ChunkSeq[u8], call_start: u64, call_end: u64, inout amb: Amb) -> Sc {
    let text = match String::from_utf8(in source.as_slice()) {
        Option::Some(decoded) => decoded,
        Option::None => String::new(),
    };
    let lowered = lower_surface_source(in text.as_str());
    if lowered.p.t.rejected {
        return refusal(in lowered.p.d);
    }
    if lowered.p.d.code.len() != 0 {
        return sc_err(in "could not determine effects at scope capture".as_bytes());
    }
    let ast = lowered.ast;
    // The linear effects, by name.
    let mut linear = ChunkSeq::new[u32]();
    for item_index in 0..ast.m_items.len() {
        let item = item_of(in ast, item_index);
        if item.kind == 3 {
            let effect_decl = ast.effect_decls.get_or(
                idx_from_raw[EffectDeclNode](item.node),
                EffectDeclNode {
                    name: none(),
                    linear: false,
                    generics: 0,
                    ops: 0,
                    start: 0,
                    end: 0
                }
            );
            if effect_decl.linear {
                linear.push(effect_decl.name);
            }
        }
    }
    // The first function, method or conformance method whose body covers
    // the call.
    let mut found = none();
    for item_index in 0..ast.m_items.len() {
        if found != none() {
            break;
        }
        let item = item_of(in ast, item_index);
        let mut fns = ChunkSeq::new[u32]();
        if item.kind == 2 {
            fns.push(item.node);
        } else if item.kind == 4 {
            let owner = ast.impls.get_or(
                idx_from_raw[ImplNode](item.node),
                ImplNode { ty: none(), generics: 0, methods: 0 }
            );
            for method in 0..list_len(in ast, owner.methods) {
                fns.push(list_at(in ast, owner.methods, method));
            }
        } else if item.kind == 6 {
            let owner = ast.confs.get_or(
                idx_from_raw[ConfNode](item.node),
                ConfNode {
                    model: none(),
                    public: false,
                    generics: 0,
                    trait_ref: none(),
                    self_ty: none(),
                    wheres: 0,
                    assoc: 0,
                    methods: 0,
                    start: 0,
                    end: 0
                }
            );
            for method in 0..list_len(in ast, owner.methods) {
                fns.push(list_at(in ast, owner.methods, method));
            }
        }
        for fn_pos in 0..fns.len() {
            let fn_id = match fns.try_get(fn_pos) {
                Option::Some(raw_fn) => raw_fn,
                Option::None => none(),
            };
            let func = fn_of(in ast, fn_id);
            if func.body != none() {
                let body_expr = expr_at(in ast, func.body);
                if covers(
                    widen_u64(body_expr.start),
                    widen_u64(body_expr.end),
                    call_start,
                    call_end
                ) {
                    found = fn_id;
                    break;
                }
            }
        }
    }
    if found == none() {
        return sc_err(in "scope capture requires a function body".as_bytes());
    }
    let func = fn_of(in ast, found);
    let mut result = func.result;
    let fn_effects = effects_of(in ast, func.effects);
    let mut instances = ChunkSeq::new[u32]();
    for i in 0..list_len(in ast, fn_effects.instances) {
        instances.push(list_at(in ast, fn_effects.instances, i));
    }
    let mut tail = if func.effects == none() {
        none()
    } else {
        fn_effects.tail
    };
    // Frames as rows (body length, expression), longest first, stable.
    let mut frames = ChunkSeq::new[u64]();
    let order = post_order(in ast, func.body);
    for order_index in 0..order.len() {
        let expr = match order.try_get(order_index) {
            Option::Some(expr) => expr,
            Option::None => none(),
        };
        let expr_node = expr_at(in ast, expr);
        let body = if expr_node.kind == 16 {
            expr_node.d
        } else if expr_node.kind == 15 {
            expr_node.e
        } else {
            none()
        };
        if body == none() {
            continue;
        }
        let body_expr = expr_at(in ast, body);
        let body_start = widen_u64(body_expr.start);
        let body_end = widen_u64(body_expr.end);
        if !covers(body_start, body_end, call_start, call_end) {
            continue;
        }
        let len = sub(body_end, body_start);
        let mut at = frames.len() >> 1;
        loop {
            if at == 0 || w64(in frames, sub(at, 1) << 1) >= len {
                break;
            }
            at = sub(at, 1);
        }
        frames.push(0);
        frames.push(0);
        let mut slot = sub(frames.len() >> 1, 1);
        loop {
            if slot <= at {
                break;
            }
            frames.try_set(slot << 1, w64(in frames, sub(slot, 1) << 1));
            frames.try_set(inc(slot << 1), w64(in frames, inc(sub(slot, 1) << 1)));
            slot = sub(slot, 1);
        }
        frames.try_set(at << 1, len);
        frames.try_set(inc(at << 1), widen_u64(expr));
    }
    for frame in 0..(frames.len() >> 1) {
        let expr = wrapping_u32(w64(in frames, inc(frame << 1)));
        let expr_node = expr_at(in ast, expr);
        if expr_node.kind == 15 {
            if (expr_node.b >> 8) != 0 {
                return sc_err(
                    in "exit-aware scope inside a closure requires an explicit effect row"
                        .as_bytes()
                );
            }
            result = expr_node.c;
            let closure_effects = effects_of(in ast, expr_node.d);
            instances.clear();
            for i in 0..list_len(in ast, closure_effects.instances) {
                instances.push(list_at(in ast, closure_effects.instances, i));
            }
            tail = if expr_node.d == none() {
                none()
            } else {
                closure_effects.tail
            };
        } else {
            instances.push(expr_node.a);
        }
    }
    if tail != none() {
        return sc_err(in "an exit-aware scope requires concrete effect rows".as_bytes());
    }
    for i in 0..instances.len() {
        let effect_index = match instances.try_get(i) {
            Option::Some(raw_effect) => raw_effect,
            Option::None => none(),
        };
        let effect = effect_of(in ast, effect_index);
        if name_is(in ast, effect.name, in "Fail".as_bytes()) {
            if effect.label != none() {
                return sc_err(
                    in "exit-aware scope cannot intercept a labelled Fail capability".as_bytes()
                );
            }
            if list_len(in ast, effect.args) != 1 {
                return sc_err(in "expected Fail with one error type".as_bytes());
            }
            let arg = list_at(in ast, effect.args, 0);
            if !source_ok(in ast, arg) {
                return sc_err(
                    in "scope exit requires an explicit named or tuple payload type".as_bytes()
                );
            }
            let mut row = ChunkSeq::new[u8]();
            row.extend(in "Fail[".as_bytes());
            type_text(inout row, in ast, arg);
            row.push(93);
            if !has_row(in amb.rows, in row) {
                amb.rows.extend(in row.as_slice());
                amb.rows.push(0);
                amb.row_count = inc(amb.row_count);
            }
        } else if name_is(in ast, effect.name, in "ConstTime".as_bytes())
            || name_is(in ast, effect.name, in "Realtime".as_bytes())
            || name_is(in ast, effect.name, in "ConstDenorm".as_bytes())
            || name_is(in ast, effect.name, in "DetFloat".as_bytes())
            || name_is(in ast, effect.name, in "Region".as_bytes())
        {} else {
            let mut is_linear = false;
            for j in 0.. linear.len() {
                if match linear.try_get(j) {
                    Option::Some(linear_name) => linear_name == effect.name,
                    Option::None => false,
                }
                {
                    is_linear = true;
                    break;
                }
            }
            if !is_linear {
                let mut message = ChunkSeq::new[u8]();
                message.extend(
                    in "exit-aware scope cannot relay potentially abortive effect `".as_bytes()
                );
                push_name(inout message, in ast, effect.name);
                message.push(96);
                return sc_err_seq(in message);
            }
        }
    }
    amb.result_is_source = source_ok(in ast, result);
    type_text(inout amb.result, in ast, result);
    amb.result_is_option = result != none()
        && type_at(in ast, result).kind == 1
        && name_is(in ast, type_at(in ast, result).a, in "Option".as_bytes());
    sc_ok()
}

// ---------------------------------------------------------------- edits

// Edits as rows (start, end, pool first, pool length, forwarded).
fn push_change(
    inout eds: ChunkSeq[u64],
    inout pool: ChunkSeq[u8],
    start: u64,
    end: u64,
    in text: ChunkSeq[u8],
    forwarded: bool
) {
    eds.push(start);
    eds.push(end);
    eds.push(pool.len());
    eds.push(text.len());
    eds.push(if forwarded { 1 } else { 0 });
    pool.extend(in text.as_slice());
}

fn cat(inout out: ChunkSeq[u8], in piece: Str) {
    out.extend(in piece.as_bytes());
}

fn cat_seq(inout out: ChunkSeq[u8], in piece: ChunkSeq[u8]) {
    out.extend(in piece.as_slice());
}

// `encode(i, total, leaf)`.
fn encode(i: u64, total: u64, in leaf: ChunkSeq[u8]) -> ChunkSeq[u8] {
    let mut text = ChunkSeq::new[u8]();
    if inc(i) == total {
        cat_seq(inout text, in leaf);
    } else {
        cat(inout text, in "Result::Ok(");
        cat_seq(inout text, in leaf);
        cat(inout text, in ")");
    }
    for level in 0..i {
        let mut wrapped = ChunkSeq::new[u8]();
        cat(inout wrapped, in "Result::Err(");
        cat_seq(inout wrapped, in text);
        cat(inout wrapped, in ")");
        text = wrapped;
    }
    text
}

// `rewrite(r, edits, max)`.
fn rewrite(inout rendered: Rd, in edits: ChunkSeq[u64], in pool: ChunkSeq[u8], max: u64) -> Sc {
    let n = edits.len() / 5;
    // A stable sort of the edits by (start, end).
    let mut order = ChunkSeq::new[u64]();
    for i in 0..n {
        let edit_start = w64(in edits, wrapping_mul(i, 5));
        let edit_end = w64(in edits, inc(wrapping_mul(i, 5)));
        let mut at = order.len();
        loop {
            if at == 0 {
                break;
            }
            let prev = w64(in order, sub(at, 1));
            let prev_start = w64(in edits, wrapping_mul(prev, 5));
            let prev_end = w64(in edits, inc(wrapping_mul(prev, 5)));
            if prev_start < edit_start || prev_start == edit_start && prev_end <= edit_end {
                break;
            }
            at = sub(at, 1);
        }
        order.push(0);
        let mut slot = sub(order.len(), 1);
        loop {
            if slot <= at {
                break;
            }
            order.try_set(slot, w64(in order, sub(slot, 1)));
            slot = sub(slot, 1);
        }
        order.try_set(at, i);
    }
    let mut text = ChunkSeq::new[u8]();
    let mut pos: u64 = 0;
    // Map rows (source start, source end, offset).
    let mut map = ChunkSeq::new[u64]();
    let mut forwarding = ChunkSeq::new[u64]();
    for rank in 0..n {
        let row = wrapping_mul(w64(in order, rank), 5);
        let edit_start = w64(in edits, row);
        let edit_end = w64(in edits, inc(row));
        let first = w64(in edits, add(row, 2));
        let len = w64(in edits, add(row, 3));
        let forwarded = w64(in edits, add(row, 4)) != 0;
        if edit_start < pos {
            return sc_err(in "overlapping scope exits".as_bytes());
        }
        if add(add(text.len(), sub(edit_start, pos)), len) > max {
            return sc_err(in "scope expansion exceeds output budget".as_bytes());
        }
        let offset = text.len();
        for prev in pos..edit_start {
            text.push(b8(in rendered.text, prev));
        }
        map.push(pos);
        map.push(edit_start);
        map.push(offset);
        let start = text.len();
        for prev in 0..len {
            text.push(b8(in pool, add(first, prev)));
        }
        if forwarded {
            forwarding.push(start);
            forwarding.push(text.len());
        }
        pos = edit_end;
    }
    if add(text.len(), sub(rendered.text.len(), pos)) > max {
        return sc_err(in "scope expansion exceeds output budget".as_bytes());
    }
    map.push(pos);
    map.push(rendered.text.len());
    map.push(text.len());
    for prev in pos..rendered.text.len() {
        text.push(b8(in rendered.text, prev));
    }
    let mut holes = ChunkSeq::new[u64]();
    for hole in 0..(rendered.holes.len() >> 1) {
        let parts = parts_of(
            in map,
            w64(in rendered.holes, hole << 1),
            w64(in rendered.holes, inc(hole << 1))
        );
        for part in 0..(parts.len() >> 2) {
            holes.push(w64(in parts, add(part << 2, 2)));
            holes.push(w64(in parts, add(part << 2, 3)));
        }
    }
    holes.extend(in forwarding.as_slice());
    let mut origins = ChunkSeq::new[u64]();
    let origin_count = rendered.origins.len() / 5;
    for origin in 0..origin_count {
        let row = wrapping_mul(origin, 5);
        let orig_start = w64(in rendered.origins, row);
        let orig_end = w64(in rendered.origins, inc(row));
        let value_start = w64(in rendered.origins, add(row, 2));
        let tail = w64(in rendered.origins, add(row, 4));
        let parts = parts_of(in map, orig_start, orig_end);
        for part in 0..(parts.len() >> 2) {
            let part_start = w64(in parts, part << 2);
            let part_end = w64(in parts, inc(part << 2));
            origins.push(w64(in parts, add(part << 2, 2)));
            origins.push(w64(in parts, add(part << 2, 3)));
            origins.push(add(value_start, sub(part_start, orig_start)));
            origins.push(add(value_start, sub(part_end, orig_start)));
            origins.push(tail);
        }
    }
    let mut places = ChunkSeq::new[u64]();
    let place_count = rendered.places.len() / 3;
    for place in 0..place_count {
        let row = wrapping_mul(place, 3);
        let parts = parts_of(
            in map,
            w64(in rendered.places, row),
            w64(in rendered.places, inc(row))
        );
        for part in 0..(parts.len() >> 2) {
            places.push(w64(in parts, add(part << 2, 2)));
            places.push(w64(in parts, add(part << 2, 3)));
            places.push(w64(in rendered.places, add(row, 2)));
        }
    }
    rendered.holes = holes;
    rendered.origins = origins;
    rendered.places = places;
    rendered.text = text;
    sc_ok()
}

// `parts(old)`: rows (old start, old end, new start, new end).
fn parts_of(in map: ChunkSeq[u64], start: u64, end: u64) -> ChunkSeq[u64] {
    let mut out = ChunkSeq::new[u64]();
    let n = map.len() / 3;
    for i in 0..n {
        let seg_start = w64(in map, wrapping_mul(i, 3));
        let seg_end = w64(in map, inc(wrapping_mul(i, 3)));
        let at = w64(in map, add(wrapping_mul(i, 3), 2));
        if seg_end <= start {
            continue;
        }
        if seg_start >= end {
            break;
        }
        let clip_start = if seg_start > start { seg_start } else { start };
        let clip_end = if seg_end < end { seg_end } else { end };
        if clip_start < clip_end {
            out.push(clip_start);
            out.push(clip_end);
            out.push(add(at, sub(clip_start, seg_start)));
            out.push(add(at, sub(clip_end, seg_start)));
        }
    }
    out
}

// ---------------------------------------------------------------- lower

fn exit_known(in kinds: ChunkSeq[u64], exit: u64) -> u64 {
    for i in 0..kinds.len() {
        if w64(in kinds, i) == exit {
            return i;
        }
    }
    NONE
}

// `lower(r, captures, source, call, mark, max)`.
pub fn lower(
    inout rendered: Rd,
    in caps: Caps,
    in source: ChunkSeq[u8],
    call_start: u64,
    call_end: u64,
    in mark: ChunkSeq[u8],
    max: u64
) -> Sc {
    // The scope captures' values.
    let mut scope = NONE;
    let mut nscopes: u64 = 0;
    for cap in 0..cap_count(in caps) {
        if sort_in(in caps, cap, in "scope".as_bytes()) {
            for value_index in 0..cap_at(in caps, cap, 4) {
                if nscopes == 0 {
                    scope = value_at(in caps, cap, value_index);
                }
                nscopes = inc(nscopes);
            }
        }
    }
    if nscopes == 0 {
        return sc_ok();
    }
    if nscopes > 1 {
        return sc_err(in "a rule can resume only one captured scope".as_bytes());
    }
    let value_start = w64(in caps.words, scope);
    let value_end = w64(in caps.words, inc(scope));
    let from_tail = w64(in caps.words, add(scope, 2)) != 0;
    let mut matches: u64 = 0;
    let mut body_start: u64 = 0;
    let mut body_end: u64 = 0;
    for origin in 0..(rendered.origins.len() / 5) {
        let row = wrapping_mul(origin, 5);
        let tail = w64(in rendered.origins, add(row, 4)) != 0;
        if w64(in rendered.origins, add(row, 2)) == value_start
            && w64(in rendered.origins, add(row, 3)) == value_end
            && tail == from_tail
        {
            matches = inc(matches);
            body_start = w64(in rendered.origins, row);
            body_end = w64(in rendered.origins, inc(row));
        }
    }
    if matches != 1 {
        return sc_err(in "a captured scope must be evaluated exactly once".as_bytes());
    }
    if from_tail {
        body_start = sub(body_start, 1);
        body_end = inc(body_end);
    }
    let mut toks = ChunkSeq::new[u64]();
    let lexed = significant(in rendered.text, inout toks);
    if lexed.failed {
        return lexed;
    }
    let tok_count = sp_n(in toks);
    let mut first: u64 = 0;
    let mut after: u64 = 0;
    for i in 0..tok_count {
        if sp_s(in toks, i) < body_start {
            first = inc(i);
        }
        if sp_s(in toks, i) < body_end {
            after = inc(i);
        }
    }
    if first < 3
        || !word_is(in rendered.text, in toks, sub(first, 3), in "let".as_bytes())
        || !word_is(in rendered.text, in toks, sub(first, 1), in "=".as_bytes())
        || !word_is(in rendered.text, in toks, after, in ";".as_bytes())
    {
        return sc_err(
            in "bind the scope exit with `let exit = ...;` before resuming it".as_bytes()
        );
    }
    let binder = sub(first, 2);
    let mut resume = NONE;
    let mut nuses: u64 = 0;
    for i in inc(after)..tok_count {
        if words_eq(in rendered.text, in toks, i, binder) {
            resume = i;
            nuses = inc(nuses);
        }
    }
    if nuses != 1 {
        return sc_err(in "a captured exit must be resumed exactly once".as_bytes());
    }
    let mut tail_ok = word_is(in rendered.text, in toks, inc(resume), in ".".as_bytes())
        && word_is(in rendered.text, in toks, add(resume, 2), in "resume".as_bytes())
        && word_is(in rendered.text, in toks, add(resume, 3), in "(".as_bytes())
        && word_is(in rendered.text, in toks, add(resume, 4), in ")".as_bytes());
    for i in add(resume, 5)..tok_count {
        if !word_is(in rendered.text, in toks, i, in "}".as_bytes()) {
            tail_ok = false;
        }
    }
    if !tail_ok {
        return sc_err(
            in "a scope exit must be resumed as the tail of its cleanup block".as_bytes()
        );
    }
    let mut body = ChunkSeq::new[u8]();
    for j in body_start..body_end {
        body.push(b8(in rendered.text, j));
    }
    let mut ctl = Ctl {
        jumps: ChunkSeq::new[u64](),
        questions: ChunkSeq::new[u64](),
        crosses_loop: false,
        question_in_handler: false
    };
    let jumped = jumps(in body, inout ctl);
    if jumped.failed {
        return jumped;
    }
    let mut amb = Amb {
        rows: ChunkSeq::new[u8](),
        row_count: 0,
        result: ChunkSeq::new[u8](),
        result_is_source: false,
        result_is_option: false
    };
    let ambient_sc = ambient(in source, call_start, call_end, inout amb);
    if ambient_sc.failed {
        return ambient_sc;
    }
    let option_try = ctl.questions.len() != 0 && amb.result_is_option;
    if option_try && (amb.row_count != 0 || ctl.question_in_handler) {
        return sc_err(
            in "use an explicit match for `?` when both Option and Fail exits are active in a scope"
                .as_bytes()
        );
    }
    let relay_return = ctl.crosses_loop || option_try;
    let mut effect = ChunkSeq::new[u8]();
    cat(inout effect, in "VesperScope");
    cat_seq(inout effect, in mark);
    let mut label = ChunkSeq::new[u8]();
    cat_seq(inout label, in mark);
    cat(inout label, in "leave");
    let mut kinds = ChunkSeq::new[u64]();
    kinds.push(X_NORMAL);
    for j in 0..j_n(in ctl) {
        let exit = j_at(in ctl, j, 0);
        if !(relay_return && exit == X_RETURN) && exit_known(in kinds, exit) == NONE {
            kinds.push(exit);
        }
    }
    let kind_count = kinds.len();
    let mut value = ChunkSeq::new[u8]();
    cat_seq(inout value, in mark);
    cat(inout value, in "value");
    let mut err = ChunkSeq::new[u8]();
    cat_seq(inout err, in mark);
    cat(inout err, in "error");
    let mut head = ChunkSeq::new[u8]();
    let mut foot = ChunkSeq::new[u8]();
    if relay_return {
        if !amb.result_is_source {
            return sc_err(
                in "scope exit requires an explicit named or tuple payload type".as_bytes()
            );
        }
        cat(inout head, in "handle ");
        cat_seq(inout head, in label);
        cat(inout head, in ": ");
        cat_seq(inout head, in effect);
        cat(inout head, in "[");
        cat_seq(inout head, in amb.result);
        cat(inout head, in "] in { ");
    }
    // The Fail rows, each closed by a 0 byte.
    let mut at: u64 = 0;
    for fail_row in 0..amb.row_count {
        cat(inout head, in "handle ");
        loop {
            let byte = b8(in amb.rows, at);
            at = inc(at);
            if byte == 0 {
                break;
            }
            head.push(byte);
        }
        cat(inout head, in " in { ");
    }
    if kind_count > 1 {
        cat(inout head, in "loop { let ");
        cat_seq(inout head, in value);
        cat(inout head, in " = ");
        cat(inout foot, in "; break ");
        let encoded = encode(0, kind_count, in value);
        cat_seq(inout foot, in encoded);
        cat(inout foot, in "; }");
    }
    for fail_row in 0..amb.row_count {
        cat(inout foot, in " } with { return ");
        cat_seq(inout foot, in value);
        cat(inout foot, in " => Result::Ok(");
        cat_seq(inout foot, in value);
        cat(inout foot, in "), raise(");
        cat_seq(inout foot, in err);
        cat(inout foot, in ", _) => Result::Err(");
        cat_seq(inout foot, in err);
        cat(inout foot, in "), }");
    }
    if relay_return {
        cat(inout foot, in " } with { return ");
        cat_seq(inout foot, in value);
        cat(inout foot, in " => Result::Ok(");
        cat_seq(inout foot, in value);
        cat(inout foot, in "), leave(");
        cat_seq(inout foot, in err);
        cat(inout foot, in ", _) => Result::Err(");
        cat_seq(inout foot, in err);
        cat(inout foot, in "), }");
    }
    let mut edits = ChunkSeq::new[u64]();
    let mut pool = ChunkSeq::new[u8]();
    push_change(inout edits, inout pool, body_start, body_start, in head, false);
    let mut hash = ChunkSeq::new[u8]();
    hash.push(35);
    for j in 0..j_n(in ctl) {
        let exit = j_at(in ctl, j, 0);
        let mut left = ChunkSeq::new[u8]();
        let mut right = ChunkSeq::new[u8]();
        if relay_return && exit == X_RETURN {
            cat_seq(inout left, in label);
            cat(inout left, in ".leave(");
            cat(inout right, in ")");
        } else {
            let index = exit_known(in kinds, exit);
            let encoded = encode(index, kind_count, in hash);
            cat(inout left, in "break ");
            // Split at the first '#'.
            let mut seen = false;
            for byte_index in 0..encoded.len() {
                let byte = b8(in encoded, byte_index);
                if !seen && byte == 35 {
                    seen = true;
                } else if seen {
                    right.push(byte);
                } else {
                    left.push(byte);
                }
            }
        }
        let jump_start = add(body_start, j_at(in ctl, j, 1));
        let jump_end = add(body_start, j_at(in ctl, j, 2));
        let jump_value = j_at(in ctl, j, 3);
        if jump_value != NONE {
            push_change(
                inout edits,
                inout pool,
                jump_start,
                add(body_start, jump_value),
                in left,
                false
            );
            push_change(inout edits, inout pool, jump_end, jump_end, in right, false);
        } else {
            let mut text = ChunkSeq::new[u8]();
            cat_seq(inout text, in left);
            cat(inout text, in "()");
            cat_seq(inout text, in right);
            push_change(inout edits, inout pool, jump_start, jump_end, in text, false);
        }
    }
    if option_try {
        let mut question: u64 = 0;
        loop {
            if question >= ctl.questions.len() {
                break;
            }
            let whole_end = w64(in ctl.questions, inc(question));
            let operand_start = w64(in ctl.questions, add(question, 2));
            let start = add(body_start, operand_start);
            let mut open = ChunkSeq::new[u8]();
            cat(inout open, in "(match (");
            push_change(inout edits, inout pool, start, start, in open, false);
            let question_mark = sub(add(body_start, whole_end), 1);
            let mut close = ChunkSeq::new[u8]();
            cat(inout close, in ") { Option::Some(");
            cat_seq(inout close, in value);
            cat(inout close, in ") => ");
            cat_seq(inout close, in value);
            cat(inout close, in ", Option::None => ");
            cat_seq(inout close, in label);
            cat(inout close, in ".leave(Option::None), })");
            push_change(inout edits, inout pool, question_mark, inc(question_mark), in close, true);
            question = add(question, 4);
        }
    }
    push_change(inout edits, inout pool, body_end, body_end, in foot, false);
    let mut valued_break = false;
    for j in 0..j_n(in ctl) {
        if j_at(in ctl, j, 0) == X_BREAK && j_at(in ctl, j, 3) != NONE {
            valued_break = true;
        }
    }
    let mut result = dispatch(w64(in kinds, sub(kind_count, 1)), in value, valued_break);
    let mut kind_index = sub(kind_count, 1);
    loop {
        if kind_index == 0 {
            break;
        }
        kind_index = sub(kind_index, 1);
        let mut text = ChunkSeq::new[u8]();
        cat(inout text, in "match ");
        cat_seq(inout text, in value);
        cat(inout text, in " { Result::Ok(");
        cat_seq(inout text, in value);
        cat(inout text, in ") => ");
        let arm = dispatch(w64(in kinds, kind_index), in value, valued_break);
        cat_seq(inout text, in arm);
        cat(inout text, in ", Result::Err(");
        cat_seq(inout text, in value);
        cat(inout text, in ") => ");
        cat_seq(inout text, in result);
        cat(inout text, in ", }");
        result = text;
    }
    for fail_wrap in 0..amb.row_count {
        let mut text = ChunkSeq::new[u8]();
        cat(inout text, in "match ");
        cat_seq(inout text, in value);
        cat(inout text, in " { Result::Ok(");
        cat_seq(inout text, in value);
        cat(inout text, in ") => ");
        cat_seq(inout text, in result);
        cat(inout text, in ", Result::Err(");
        cat_seq(inout text, in err);
        cat(inout text, in ") => Fail::raise(");
        cat_seq(inout text, in err);
        cat(inout text, in "), }");
        result = text;
    }
    if relay_return {
        let mut text = ChunkSeq::new[u8]();
        cat(inout text, in "match ");
        cat_seq(inout text, in value);
        cat(inout text, in " { Result::Ok(");
        cat_seq(inout text, in value);
        cat(inout text, in ") => ");
        cat_seq(inout text, in result);
        cat(inout text, in ", Result::Err(");
        cat_seq(inout text, in err);
        cat(inout text, in ") => return ");
        cat_seq(inout text, in err);
        cat(inout text, in ", }");
        result = text;
    }
    let mut resumed = ChunkSeq::new[u8]();
    cat(inout resumed, in "{ let ");
    cat_seq(inout resumed, in value);
    cat(inout resumed, in " = ");
    for j in sp_s(in toks, binder)..sp_e(in toks, binder) {
        resumed.push(b8(in rendered.text, j));
    }
    cat(inout resumed, in "; ");
    cat_seq(inout resumed, in result);
    cat(inout resumed, in " }");
    push_change(
        inout edits,
        inout pool,
        sp_s(in toks, resume),
        sp_e(in toks, add(resume, 4)),
        in resumed,
        true
    );
    // The forwarded body: the body's span after its own edits.
    let mut size = sub(body_end, body_start);
    for i in 0..(edits.len() / 5) {
        let row = wrapping_mul(i, 5);
        let edit_start = w64(in edits, row);
        let edit_end = w64(in edits, inc(row));
        if covers(body_start, body_end, edit_start, edit_end) {
            size = sub(add(size, w64(in edits, add(row, 3))), sub(edit_end, edit_start));
        }
    }
    let rewritten = rewrite(inout rendered, in edits, in pool, max);
    if rewritten.failed {
        return rewritten;
    }
    rendered.holes.push(body_start);
    rendered.holes.push(add(body_start, size));
    let mut out = sc_ok();
    if relay_return {
        cat(inout out.items, in "\neffect ");
        cat_seq(inout out.items, in effect);
        cat(inout out.items, in "[T] { fn leave(sink value:T) -> Never; }\n");
    }
    out
}

fn dispatch(exit: u64, in value: ChunkSeq[u8], valued_break: bool) -> ChunkSeq[u8] {
    let mut text = ChunkSeq::new[u8]();
    if exit == X_NORMAL {
        cat_seq(inout text, in value);
    } else if exit == X_RETURN {
        cat(inout text, in "return ");
        cat_seq(inout text, in value);
    } else if exit == X_CONTINUE {
        cat(inout text, in "continue");
    } else if valued_break {
        cat(inout text, in "break ");
        cat_seq(inout text, in value);
    } else {
        cat(inout text, in "break");
    }
    text
}
