// @vesper/sugar: the bounded sugar expansion of
// crates/vesper-syntax/src/sugar_expand.rs in Vesper (SH1 lane 14, #1157,
// part 4). It reads the surface profile of @vesper/front.
//
// Part 4a is the rule matcher (sugar_expand/matcher.rs, matcher.ves),
// part 4b-1 the template skeleton (sugar_expand/template.rs, template.ves),
// part 4b-4 its scope and flow analysis (template/flow.rs, flow.ves),
// part 4b-5 exit-aware scope captures (sugar_expand/scope.rs, scope.ves)
// and the pattern template hygiene (hygiene.rs `pattern`, hygiene.ves).
// tests/self_host_sugar.rs checks `match_rule_words` and
// `template_skeleton_words` against Rust's test hooks of the same names in
// `vesper_syntax::sugar_expand` on a rule corpus and a fuzzed corpus.

use self::matcher::{match_rule_encoded};
use self::driver::{expand_words, imports_none};
use self::flow::{Rd, render};
use self::hygiene::{pattern_hygiene};
use self::scope::{lower};
use self::template::{caps_read, skeleton_encoded, skeleton_run};

// `match_rule(pattern, invocation, tail, work)` as words (see
// matcher.ves `match_rule_encoded`). `text` is the pattern, then the
// invocation, then the tail; `lens` holds the pattern's length in its low
// 32 bits, the invocation's in bits 32-62, and bit 63 is set when there is
// a tail (the rest of `text`). Native word functions take at most three
// words.
pub fn match_rule_words(in text: Str, lens: u64, work: u64) -> ChunkSeq[u64] {
    let bytes = text.as_bytes();
    let pattern_len = lens & 4294967295;
    let invocation_len = (lens >> 32) & 2147483647;
    let has_tail = (lens >> 63) == 1;
    let mut pattern = ChunkSeq::new[u8]();
    let mut invocation = ChunkSeq::new[u8]();
    for i in 0..wrapping_add(pattern_len, invocation_len) {
        let byte = match bytes.try_get(i) {
            Option::Some(byte) => byte,
            Option::None => 0,
        };
        if i < pattern_len {
            pattern.push(byte);
        } else {
            invocation.push(byte);
        }
    }
    let tail_len = wrapping_sub(bytes.len(), wrapping_add(pattern_len, invocation_len));
    match_rule_encoded(in pattern, in invocation, has_tail, tail_len, work)
}

// Many `match_rule_words` calls in one, for measuring the matcher without
// the host call around each: `text` is a run of records, each three
// numbers of four base-128 digits (low digit first, so the text stays
// ASCII) and then the pattern and the invocation. The numbers are the
// pattern's length, the invocation's, and the tail's length plus one (0
// for no tail). The result is each record's words in turn. Test hook for
// tests/self_host_sugar.rs (`matcher_speed`).
pub fn match_rule_batch(in text: Str, count: u64, work: u64) -> ChunkSeq[u64] {
    let bytes = text.as_bytes();
    let mut out = ChunkSeq::new[u64]();
    let mut at: u64 = 0;
    for record in 0..count {
        let pattern_len = base128(in bytes, at);
        let invocation_len = base128(in bytes, wrapping_add(at, 4));
        let tail_len_plus_one = base128(in bytes, wrapping_add(at, 8));
        at = wrapping_add(at, 12);
        let mut pattern = ChunkSeq::new[u8]();
        let mut invocation = ChunkSeq::new[u8]();
        for i in 0..wrapping_add(pattern_len, invocation_len) {
            let byte = match bytes.try_get(wrapping_add(at, i)) {
                Option::Some(byte) => byte,
                Option::None => 0,
            };
            if i < pattern_len {
                pattern.push(byte);
            } else {
                invocation.push(byte);
            }
        }
        at = wrapping_add(at, wrapping_add(pattern_len, invocation_len));
        let words = match_rule_encoded(
            in pattern,
            in invocation,
            tail_len_plus_one != 0,
            wrapping_sub(tail_len_plus_one, 1),
            work
        );
        for j in 0..words.len() {
            match words.try_get(j) {
                Option::Some(word) => out.push(word),
                Option::None => {},
            }
        }
    }
    out
}

fn base128(in bytes: Slice[u8], at: u64) -> u64 {
    let mut value: u64 = 0;
    for digit in 0..4 {
        let digit_value = match bytes.try_get(wrapping_add(at, wrapping_sub(3, digit))) {
            Option::Some(byte) => widen_u64(byte),
            Option::None => 0,
        };
        value = wrapping_add(wrapping_mul(value, 128), digit_value);
    }
    value
}

// `template_skeleton_words(pattern, invocation, tail, template, mark,
// max_bytes, work)` of `vesper_syntax::sugar_expand`: the skeleton of the
// template (template.ves `skeleton_encoded`) for the rule's match, or [0]
// when the rule refuses or does not match. `text` is five numbers of four
// base-128 digits (the lengths of the pattern, the invocation, the tail
// plus one or 0 for none, the template and the mark) and then those texts.
pub fn template_skeleton_words(in text: Str, max_bytes: u64, work: u64) -> ChunkSeq[u64] {
    let bytes = text.as_bytes();
    let pattern_len = base128(in bytes, 0);
    let invocation_len = base128(in bytes, 4);
    let tail_len_plus_one = base128(in bytes, 8);
    let template_len = base128(in bytes, 12);
    let mark_len = base128(in bytes, 16);
    let tail_len = wrapping_sub(tail_len_plus_one, if tail_len_plus_one == 0 { 0 } else { 1 });
    let mut at: u64 = 20;
    let pattern = copy_bytes(in bytes, at, pattern_len);
    at = wrapping_add(at, pattern_len);
    let invocation = copy_bytes(in bytes, at, invocation_len);
    at = wrapping_add(at, invocation_len);
    let tail = copy_bytes(in bytes, at, tail_len);
    at = wrapping_add(at, tail_len);
    let template = copy_bytes(in bytes, at, template_len);
    at = wrapping_add(at, template_len);
    let mark = copy_bytes(in bytes, at, mark_len);
    let words = match_rule_encoded(
        in pattern,
        in invocation,
        tail_len_plus_one != 0,
        tail_len,
        work
    );
    let matched = match words.try_get(0) {
        Option::Some(word) => word == 1,
        Option::None => false,
    };
    if !matched {
        let mut out = ChunkSeq::new[u64]();
        out.push(0);
        return out;
    }
    skeleton_encoded(in template, words, in invocation, in tail, in mark, max_bytes)
}

// `template_render_words`: the rendered template (`template::render`,
// flow.ves `render`) for the rule's match, with `text` as in
// `template_skeleton_words`. The words are [0] when the rule refuses or
// does not match, [2, len, message bytes] when rendering refuses, else
// [1, len, text bytes, holes, (start, end)*, origins, (start, end,
// value start, value end, from tail)*, places, (start, end, pass)*] with
// pass 1 In, 2 Inout, 3 Out, 4 Sink.
pub fn template_render_words(in text: Str, max_bytes: u64, work: u64) -> ChunkSeq[u64] {
    render_encoded(in text, max_bytes, work, false, false)
}

// `template_scope_words(pattern, invocation, tail, template, mark, source,
// call, max_bytes, work)` of `vesper_syntax::sugar_expand`: the rendered
// template after `scope::lower` (scope.ves `lower`). `text` is as in
// `template_skeleton_words` with three more numbers in the header (the
// source's length, the call's start and end) and the source after the
// mark. The words are as in `template_render_words` with the items the
// scope adds (length, bytes) after the leading 1.
pub fn template_scope_words(in text: Str, max_bytes: u64, work: u64) -> ChunkSeq[u64] {
    render_encoded(in text, max_bytes, work, true, false)
}

// `template_pattern_words`: `template_render_words` followed by
// `hygiene::pattern` (hygiene.ves `pattern`), with `text` and the words
// as in `template_render_words`.
pub fn template_pattern_words(in text: Str, max_bytes: u64, work: u64) -> ChunkSeq[u64] {
    render_encoded(in text, max_bytes, work, false, true)
}

// `sugar_expand_words(source, include_tests)`: one bounded expansion of
// the sugar driver (sugar_expand.rs `expand_sugar_for_execution`,
// driver.ves `expand`) over `text` with no imports. `include_tests` is 0
// or 1; the words are driver.ves `expand_words`.
pub fn sugar_expand_words(in text: Str, include_tests: u64, work: u64) -> ChunkSeq[u64] {
    let bytes = text.as_bytes();
    let src = copy_bytes(in bytes, 0, bytes.len());
    expand_words(in src, in imports_none(), include_tests != 0)
}

// `sugar_expand_scoped_words`: the same for
// `expand_sugar_with_scopes_for_execution(source, imports, scopes,
// visible, include_tests)`. `text` starts with base-128 numbers of four
// bytes: the source's length, the imports, the imports' scopes (0 for
// none), the distinct scopes, their names, the visible imports; then per
// import its alias's length and its declaration's length; each import's
// scope; per scope its
// name count; per name its length and import; the visible imports; then
// the texts: the source, each import's alias and declaration, and the
// names, in order. The words are driver.ves `expand_words`.
pub fn sugar_expand_scoped_words(in text: Str, include_tests: u64, work: u64) -> ChunkSeq[u64] {
    let bytes = text.as_bytes();
    let source_len = base128(in bytes, 0);
    let import_count = base128(in bytes, 4);
    let scoped_import_count = base128(in bytes, 8);
    let scope_count = base128(in bytes, 12);
    let name_count = base128(in bytes, 16);
    let visible_count = base128(in bytes, 20);
    let mut at: u64 = 24;
    let mut imports = imports_none();
    let mut import_lens = ChunkSeq::new[u64]();
    for i in 0..import_count {
        import_lens.push(base128(in bytes, at));
        import_lens.push(base128(in bytes, wrapping_add(at, 4)));
        at = wrapping_add(at, 8);
    }
    for k in 0..scoped_import_count {
        imports.scope_of.push(base128(in bytes, at));
        at = wrapping_add(at, 4);
    }
    let mut first: u64 = 0;
    for k in 0..scope_count {
        let count = base128(in bytes, at);
        imports.scopes.push(first);
        imports.scopes.push(count);
        first = wrapping_add(first, count);
        at = wrapping_add(at, 4);
    }
    let mut name_lens = ChunkSeq::new[u64]();
    for k in 0..name_count {
        name_lens.push(base128(in bytes, at));
        name_lens.push(base128(in bytes, wrapping_add(at, 4)));
        at = wrapping_add(at, 8);
    }
    for k in 0..visible_count {
        imports.visible.push(base128(in bytes, at));
        at = wrapping_add(at, 4);
    }
    let src = copy_bytes(in bytes, at, source_len);
    at = wrapping_add(at, source_len);
    imports.text = copy_bytes(in bytes, at, wrapping_sub(bytes.len(), at));
    let mut text_offset: u64 = 0;
    for i in 0..import_count {
        let alias_len = word_at(in import_lens, wrapping_mul(i, 2));
        let decl_len = word_at(in import_lens, wrapping_add(wrapping_mul(i, 2), 1));
        imports.rows.push(text_offset);
        imports.rows.push(alias_len);
        imports.rows.push(wrapping_add(text_offset, alias_len));
        imports.rows.push(decl_len);
        text_offset = wrapping_add(text_offset, wrapping_add(alias_len, decl_len));
    }
    for k in 0..name_count {
        let name_len = word_at(in name_lens, wrapping_mul(k, 2));
        imports.names.push(text_offset);
        imports.names.push(name_len);
        imports.names.push(word_at(in name_lens, wrapping_add(wrapping_mul(k, 2), 1)));
        text_offset = wrapping_add(text_offset, name_len);
    }
    expand_words(in src, in imports, include_tests != 0)
}

fn word_at(in words: ChunkSeq[u64], i: u64) -> u64 {
    match words.try_get(i) {
        Option::Some(w) => w,
        Option::None => 0,
    }
}

fn render_encoded(
    in text: Str,
    max_bytes: u64,
    work: u64,
    scoped: bool,
    patterned: bool
) -> ChunkSeq[u64] {
    let bytes = text.as_bytes();
    let pattern_len = base128(in bytes, 0);
    let invocation_len = base128(in bytes, 4);
    let tail_len_plus_one = base128(in bytes, 8);
    let template_len = base128(in bytes, 12);
    let mark_len = base128(in bytes, 16);
    let tail_len = wrapping_sub(tail_len_plus_one, if tail_len_plus_one == 0 { 0 } else { 1 });
    let mut at: u64 = if scoped { 32 } else { 20 };
    let pattern = copy_bytes(in bytes, at, pattern_len);
    at = wrapping_add(at, pattern_len);
    let invocation = copy_bytes(in bytes, at, invocation_len);
    at = wrapping_add(at, invocation_len);
    let tail = copy_bytes(in bytes, at, tail_len);
    at = wrapping_add(at, tail_len);
    let template = copy_bytes(in bytes, at, template_len);
    at = wrapping_add(at, template_len);
    let mark = copy_bytes(in bytes, at, mark_len);
    at = wrapping_add(at, mark_len);
    let source_len = if scoped { base128(in bytes, 20) } else { 0 };
    let call_start = base128(in bytes, 24);
    let call_end = base128(in bytes, 28);
    let source = copy_bytes(in bytes, at, source_len);
    let words = match_rule_encoded(
        in pattern,
        in invocation,
        tail_len_plus_one != 0,
        tail_len,
        work
    );
    let matched = match words.try_get(0) {
        Option::Some(word) => word == 1,
        Option::None => false,
    };
    let mut out = ChunkSeq::new[u64]();
    if !matched {
        out.push(0);
        return out;
    }
    let caps = caps_read(words);
    let skeleton = skeleton_run(in template, in caps, in invocation, in tail, in mark, max_bytes);
    if skeleton.failed {
        out.push(2);
        push_bytes(inout out, in skeleton.msg);
        return out;
    }
    let mut rendered = render(in skeleton, in caps, in invocation, in tail, in mark);
    if rendered.failed {
        out.push(2);
        push_bytes(inout out, in rendered.msg);
        return out;
    }
    if patterned {
        let pattern_result = pattern_hygiene(inout rendered, in mark);
        if pattern_result.failed {
            out.push(2);
            push_bytes(inout out, in pattern_result.msg);
            return out;
        }
    }
    let mut items = ChunkSeq::new[u8]();
    if scoped {
        let scope_result = lower(
            inout rendered,
            in caps,
            in source,
            call_start,
            call_end,
            in mark,
            max_bytes
        );
        if scope_result.failed {
            out.push(2);
            push_bytes(inout out, in scope_result.msg);
            return out;
        }
        items = scope_result.items;
    }
    out.push(1);
    if scoped {
        push_bytes(inout out, in items);
    }
    push_bytes(inout out, in rendered.text);
    push_rows(inout out, in rendered.holes, rendered.holes.len() >> 1);
    push_rows(inout out, in rendered.origins, rows_of(rendered.origins.len(), 5));
    push_rows(inout out, in rendered.places, rows_of(rendered.places.len(), 3));
    out
}

fn push_bytes(inout out: ChunkSeq[u64], in bytes: ChunkSeq[u8]) {
    out.push(bytes.len());
    for i in 0..bytes.len() {
        match bytes.try_get(i) {
            Option::Some(byte) => out.push(widen_u64(byte)),
            Option::None => out.push(0),
        }
    }
}

fn rows_of(len: u64, stride: u64) -> u64 {
    let mut rows: u64 = 0;
    let mut covered: u64 = 0;
    loop {
        if covered >= len {
            break;
        }
        covered = wrapping_add(covered, stride);
        rows = wrapping_add(rows, 1);
    }
    rows
}

fn push_rows(inout out: ChunkSeq[u64], in rows: ChunkSeq[u64], count: u64) {
    out.push(count);
    for i in 0..rows.len() {
        match rows.try_get(i) {
            Option::Some(word) => out.push(word),
            Option::None => out.push(0),
        }
    }
}

fn copy_bytes(in bytes: Slice[u8], at: u64, n: u64) -> ChunkSeq[u8] {
    let mut out = ChunkSeq::new[u8]();
    for i in 0..n {
        match bytes.try_get(wrapping_add(at, i)) {
            Option::Some(byte) => out.push(byte),
            Option::None => out.push(0),
        }
    }
    out
}
