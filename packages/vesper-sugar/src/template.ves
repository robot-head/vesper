// `sugar_expand::template`, the first half: parse a rule's template into
// text, holes and repetitions, and emit its skeleton for one match (each
// hole a marker `mark` + id, repetitions unrolled), a transliteration of
// `parse`, `Skeleton::emit` and `operand_span` of
// crates/vesper-syntax/src/sugar_expand/template.rs. The scope and flow
// analysis (template/flow.rs) that turns the skeleton into the rendered
// text comes next.
//
// Rust's template tree becomes rows (`part_*`) whose child lists and name
// sets live in pools, and its `Captures` map the matcher's words
// (matcher.ves `match_rule_encoded`) read in place.

use @vesper/front::lex::{
    lex_raw, lex_sugar_raw_with_limits, max_diagnostics, max_source_bytes, max_tokens, token_end,
    trivia_kind
};
use @vesper/front::diag::{diags_new};
use @vesper/front::kinds::{
    k_comma, k_dollar, k_dot_dot, k_eff, k_eof, k_l_paren, k_linear, k_lower, k_plus, k_r_paren,
    k_star, k_state, k_upper, k_with
};

const NONE: u64 = 18446744073709551615;

// Part kinds and the row width (kind, then up to seven words).
const P_TEXT: u64 = 0;
const P_HOLE: u64 = 1;
const P_REPEAT: u64 = 2;
const PW: u64 = 8;

pub fn b8(in s: ChunkSeq[u8], i: u64) -> u8 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

pub fn w32(in s: ChunkSeq[u32], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(v) => widen_u64(v),
        Option::None => 0,
    }
}

pub fn w64(in s: ChunkSeq[u64], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

pub fn inc(x: u64) -> u64 {
    wrapping_add(x, 1)
}

pub fn add(a: u64, b: u64) -> u64 {
    wrapping_add(a, b)
}

pub fn sub(a: u64, b: u64) -> u64 {
    wrapping_sub(a, b)
}

fn push_bytes(inout out: ChunkSeq[u8], in text: Slice[u8]) {
    out.extend(in text);
}

pub fn push_range(inout out: ChunkSeq[u8], in b: ChunkSeq[u8], s: u64, e: u64) {
    for j in s..e {
        out.push(b8(in b, j));
    }
}

// The captures of one match: the matcher's words and, per capture in
// name order, rows of seven words (word offsets of its name and sort,
// its pass code, the first and count of its value offsets in `voff`, the
// first and count of its extent offsets in `eoff`).
pub struct Caps {
    w: ChunkSeq[u64],
    cr: ChunkSeq[u64],
    voff: ChunkSeq[u64],
    eoff: ChunkSeq[u64]
}

pub fn caps_read(sink w: ChunkSeq[u64]) -> Caps {
    let mut cr = ChunkSeq::new[u64]();
    let mut voff = ChunkSeq::new[u64]();
    let mut eoff = ChunkSeq::new[u64]();
    let n = w64(in w, 2);
    let mut at: u64 = 3;
    for c in 0..n {
        let name = at;
        at = add(inc(at), w64(in w, at));
        let sort = at;
        at = add(inc(at), w64(in w, at));
        let pass = w64(in w, at);
        at = inc(at);
        let nv = w64(in w, at);
        at = inc(at);
        let vfirst = voff.len();
        for v in 0..nv {
            voff.push(at);
            at = add(at, add(4, w64(in w, add(at, 3))));
        }
        let ne = w64(in w, at);
        at = inc(at);
        let efirst = eoff.len();
        for e in 0..ne {
            eoff.push(at);
            at = add(at, add(2, w64(in w, at)));
        }
        cr.push(name);
        cr.push(sort);
        cr.push(pass);
        cr.push(vfirst);
        cr.push(nv);
        cr.push(efirst);
        cr.push(ne);
    }
    Caps { w: w, cr: cr, voff: voff, eoff: eoff }
}

pub fn cap_count(in c: Caps) -> u64 {
    c.cr.len() / 7
}

pub fn cap_at(in c: Caps, cap: u64, k: u64) -> u64 {
    w64(in c.cr, add(wrapping_mul(cap, 7), k))
}

// Word offset of value `v` of capture `cap`: start, end, from_tail, then
// the indices (length, words).
pub fn value_at(in c: Caps, cap: u64, v: u64) -> u64 {
    w64(in c.voff, add(cap_at(in c, cap, 3), v))
}

fn extent_at(in c: Caps, cap: u64, e: u64) -> u64 {
    w64(in c.eoff, add(cap_at(in c, cap, 5), e))
}

// Whether the text at word offset `at` (length, bytes) is `b[s..e]`.
fn text_eq(in c: Caps, at: u64, in b: ChunkSeq[u8], s: u64, e: u64) -> bool {
    let n = w64(in c.w, at);
    if n != sub(e, s) {
        return false;
    }
    for j in 0..n {
        if w64(in c.w, add(inc(at), j)) != widen_u64(b8(in b, add(s, j))) {
            return false;
        }
    }
    true
}

pub fn text_is(in c: Caps, at: u64, in w: Slice[u8]) -> bool {
    let n = w64(in c.w, at);
    if n != w.len() {
        return false;
    }
    for j in 0..n {
        let b = match w.try_get(j) {
            Option::Some(b) => b,
            Option::None => 0,
        };
        if w64(in c.w, add(inc(at), j)) != widen_u64(b) {
            return false;
        }
    }
    true
}

// `captures.get(name)` for the template's `b[s..e]`: the capture, or NONE.
fn find_cap(in c: Caps, in b: ChunkSeq[u8], s: u64, e: u64) -> u64 {
    for cap in 0..cap_count(in c) {
        if text_eq(in c, cap_at(in c, cap, 0), in b, s, e) {
            return cap;
        }
    }
    NONE
}

// `v.indices.as_slice().cmp(&ix[..n])` for the value at word offset `at`:
// 0 less, 1 equal, 2 greater.
fn indices_cmp(in c: Caps, at: u64, in ix: ChunkSeq[u64], n: u64) -> u64 {
    let len = w64(in c.w, at);
    let common = if len < n {
        len
    } else {
        n
    };
    for j in 0..common {
        let a = w64(in c.w, add(inc(at), j));
        let b = w64(in ix, j);
        if a < b {
            return 0;
        }
        if a > b {
            return 2;
        }
    }
    if len < n {
        0
    } else if len > n {
        2
    } else {
        1
    }
}

// `cap.values.binary_search_by(|v| v.indices.cmp(&ix[..n]))` in std's
// order of probes: the value's index, or NONE.
fn value_search(in c: Caps, cap: u64, in ix: ChunkSeq[u64], n: u64) -> u64 {
    let mut size = cap_at(in c, cap, 4);
    if size == 0 {
        return NONE;
    }
    let mut base: u64 = 0;
    loop {
        if size <= 1 {
            break;
        }
        let half = size >> 1;
        let mid = add(base, half);
        if indices_cmp(in c, add(value_at(in c, cap, mid), 3), in ix, n) != 2 {
            base = mid;
        }
        size = sub(size, half);
    }
    if indices_cmp(in c, add(value_at(in c, cap, base), 3), in ix, n) == 1 {
        base
    } else {
        NONE
    }
}

// `cap.extents.get(&ix[..n])`: the extent's word offset, or NONE.
fn extent_find(in c: Caps, cap: u64, in ix: ChunkSeq[u64], n: u64) -> u64 {
    for e in 0..cap_at(in c, cap, 6) {
        let at = extent_at(in c, cap, e);
        if indices_cmp(in c, at, in ix, n) == 1 {
            return at;
        }
    }
    NONE
}

// The template's tokens, trivia and Eof included: rows of kind, start,
// end.
struct Tt {
    tk: ChunkSeq[u32]
}

fn tt_len(in t: Tt) -> u64 {
    t.tk.len() / 3
}

fn tt_kind(in t: Tt, i: u64) -> u8 {
    match t.tk.try_get(wrapping_mul(i, 3)) {
        Option::Some(k) => wrapping_u8(widen_u64(k)),
        Option::None => k_eof(),
    }
}

fn tt_s(in t: Tt, i: u64) -> u64 {
    w32(in t.tk, inc(wrapping_mul(i, 3)))
}

fn tt_e(in t: Tt, i: u64) -> u64 {
    w32(in t.tk, add(wrapping_mul(i, 3), 2))
}

fn next(in t: Tt, i: u64) -> u64 {
    let mut j = i;
    loop {
        if j >= tt_len(in t) || !trivia_kind(tt_kind(in t, j)) {
            break;
        }
        j = inc(j);
    }
    j
}

// The parsed template: parts (rows of `PW` words), the pool of child
// lists (part ids) and the pool of repetition name sets (start, end
// pairs into the template), and the refusal.
struct Tx {
    failed: bool,
    msg: ChunkSeq[u8],
    parts: ChunkSeq[u64],
    lp: ChunkSeq[u64],
    np: ChunkSeq[u64]
}

fn tx_fail(inout x: Tx, in text: Slice[u8]) {
    if !x.failed {
        x.failed = true;
        x.msg.clear();
        x.msg.extend(in text);
    }
}

fn part_at(in x: Tx, p: u64, k: u64) -> u64 {
    w64(in x.parts, add(wrapping_mul(p, PW), k))
}

fn push_part(inout x: Tx, kind: u64, a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, g: u64)
    -> u64 {
    let id = x.parts.len() / PW;
    x.parts.push(kind);
    x.parts.push(a);
    x.parts.push(b);
    x.parts.push(c);
    x.parts.push(d);
    x.parts.push(e);
    x.parts.push(f);
    x.parts.push(g);
    id
}

// `b[s1..e1] < b[s2..e2]` byte-wise.
fn range_less(in b: ChunkSeq[u8], s1: u64, e1: u64, s2: u64, e2: u64) -> bool {
    let n1 = sub(e1, s1);
    let n2 = sub(e2, s2);
    let common = if n1 < n2 {
        n1
    } else {
        n2
    };
    for j in 0..common {
        let a = b8(in b, add(s1, j));
        let c = b8(in b, add(s2, j));
        if a != c {
            return a < c;
        }
    }
    n1 < n2
}

fn range_eq(in b: ChunkSeq[u8], s1: u64, e1: u64, s2: u64, e2: u64) -> bool {
    !range_less(in b, s1, e1, s2, e2) && !range_less(in b, s2, e2, s1, e1)
}

fn ascii_punctuation(c: u8) -> bool {
    c >= 33 && c <= 47 || c >= 58 && c <= 64 || c >= 91 && c <= 96 || c >= 123 && c <= 126
}

fn hole_name_kind(k: u8) -> bool {
    k == k_lower()
        || k == k_upper()
        || k == k_with()
        || k == k_state()
        || k == k_eff()
        || k == k_linear()
}

// `parse(s, tokens, start..end, depth)`: the list of parts (first << 32
// | count in `lp`), or the refusal.
fn parse(in s: ChunkSeq[u8], in t: Tt, inout x: Tx, start: u64, end: u64, depth: u64) -> u64 {
    if depth >= 64 {
        tx_fail(inout x, in "template repetition nesting limit exceeded".as_bytes());
        return 0;
    }
    let mut ids = ChunkSeq::new[u64]();
    let mut i = start;
    loop {
        if i >= end {
            break;
        }
        if tt_kind(in t, i) != k_dollar() {
            ids.push(push_part(inout x, P_TEXT, tt_s(in t, i), tt_e(in t, i), 0, 0, 0, 0, 0));
            i = inc(i);
            continue;
        }
        i = next(in t, inc(i));
        if i < tt_len(in t) && tt_kind(in t, i) == k_l_paren() {
            let begin = inc(i);
            let mut level: u64 = 1;
            i = begin;
            loop {
                if i >= end {
                    break;
                }
                let k = tt_kind(in t, i);
                if k == k_l_paren() {
                    level = inc(level);
                } else if k == k_r_paren() {
                    level = sub(level, 1);
                }
                if level == 0 {
                    break;
                }
                i = inc(i);
            }
            if i == end {
                tx_fail(inout x, in "unclosed template repetition".as_bytes());
                return 0;
            }
            let body = parse(in s, in t, inout x, begin, i, inc(depth));
            if x.failed {
                return 0;
            }
            // The body's hole names and its repetitions' names, sorted
            // and without duplicates (a `BTreeSet`).
            let mut names = ChunkSeq::new[u64]();
            for j in 0..(body & 4294967295) {
                let p = w64(in x.lp, add(body >> 32, j));
                let k = part_at(in x, p, 0);
                if k == P_HOLE {
                    names.push(part_at(in x, p, 1));
                    names.push(part_at(in x, p, 2));
                } else if k == P_REPEAT {
                    let first = part_at(in x, p, 6);
                    for n in 0..part_at(in x, p, 7) {
                        names.push(w64(in x.np, add(first, n << 1)));
                        names.push(w64(in x.np, inc(add(first, n << 1))));
                    }
                }
            }
            let first = x.np.len();
            let mut count: u64 = 0;
            for j in 0..(names.len() >> 1) {
                let ns = w64(in names, j << 1);
                let ne = w64(in names, inc(j << 1));
                // Insert in order unless present.
                let mut at = count;
                let mut dup = false;
                for q in 0..count {
                    let qs = w64(in x.np, add(first, q << 1));
                    let qe = w64(in x.np, inc(add(first, q << 1)));
                    if range_eq(in s, ns, ne, qs, qe) {
                        dup = true;
                        break;
                    }
                    if range_less(in s, ns, ne, qs, qe) {
                        at = q;
                        break;
                    }
                }
                if dup {
                    continue;
                }
                x.np.push(0);
                x.np.push(0);
                let mut q = count;
                loop {
                    if q <= at {
                        break;
                    }
                    let from = add(first, sub(q, 1) << 1);
                    let to = add(first, q << 1);
                    x.np.try_set(to, w64(in x.np, from));
                    x.np.try_set(inc(to), w64(in x.np, inc(from)));
                    q = sub(q, 1);
                }
                x.np.try_set(add(first, at << 1), ns);
                x.np.try_set(inc(add(first, at << 1)), ne);
                count = inc(count);
            }
            i = next(in t, inc(i));
            let mut sep_s: u64 = 0;
            let mut sep_e: u64 = 0;
            let k = tt_kind(in t, i);
            if !(i < tt_len(in t) && (k == k_plus() || k == k_star())) {
                if !(i < end) {
                    tx_fail(inout x, in "missing template repetition quantifier".as_bytes());
                    return 0;
                }
                sep_s = tt_s(in t, i);
                sep_e = tt_e(in t, i);
                for j in sep_s..sep_e {
                    if !ascii_punctuation(b8(in s, j)) {
                        tx_fail(inout x, in "invalid template repetition separator".as_bytes());
                        return 0;
                    }
                }
                i = next(in t, inc(i));
            }
            if !(i < end) {
                tx_fail(inout x, in "missing template repetition quantifier".as_bytes());
                return 0;
            }
            let q = tt_kind(in t, i);
            if q != k_star() && q != k_plus() {
                tx_fail(inout x, in "expected * or + after template repetition".as_bytes());
                return 0;
            }
            let plus: u64 = if q == k_plus() {
                1
            } else {
                0
            };
            ids
                .push(
                    push_part(
                        inout x,
                        P_REPEAT,
                        body >> 32,
                        body & 4294967295,
                        sep_s,
                        sep_e,
                        plus,
                        first,
                        count
                    )
                );
        } else {
            let seq = i < tt_len(in t) && tt_kind(in t, i) == k_dot_dot();
            if seq {
                i = next(in t, inc(i));
            }
            if !(i < end && hole_name_kind(tt_kind(in t, i))) {
                tx_fail(inout x, in "expected a template hole name".as_bytes());
                return 0;
            }
            let sq: u64 = if seq {
                1
            } else {
                0
            };
            ids.push(push_part(inout x, P_HOLE, tt_s(in t, i), tt_e(in t, i), sq, 0, 0, 0, 0));
        }
        i = inc(i);
    }
    let first = x.lp.len();
    for j in 0..ids.len() {
        x.lp.push(w64(in ids, j));
    }
    (first << 32) | ids.len()
}

// The skeleton: the template source with markers, the holes (rows of
// capture, value, operand start, operand end), the slots (rows of hole,
// start, end), the step budget, the byte limit and the refusal.
pub struct Sk {
    src: ChunkSeq[u8],
    holes: ChunkSeq[u64],
    slots: ChunkSeq[u64],
    steps: u64,
    max: u64,
    failed: bool,
    msg: ChunkSeq[u8]
}

pub fn sk_fail(inout sk: Sk, in text: Slice[u8]) {
    if !sk.failed {
        sk.failed = true;
        sk.msg.clear();
        sk.msg.extend(in text);
    }
}

// `bounded`'s check: false (and the refusal) when `n` more bytes would
// pass the limit.
pub fn room(inout sk: Sk, n: u64) -> bool {
    let left = if sk.src.len() > sk.max {
        0
    } else {
        sub(sk.max, sk.src.len())
    };
    if n > left {
        sk_fail(inout sk, in "sugar expansion byte limit exceeded".as_bytes());
        return false;
    }
    true
}

fn hole_message(inout m: ChunkSeq[u8], in head: Slice[u8], in s: ChunkSeq[u8], ns: u64, ne: u64) {
    m.extend(in head);
    m.push(36);
    push_range(inout m, in s, ns, ne);
}

pub fn push_decimal(inout out: ChunkSeq[u8], v: u64) {
    let mut digits = ChunkSeq::new[u8]();
    let mut x = v;
    loop {
        digits.push(wrapping_u8(add(48, x % 10)));
        x = x / 10;
        if x == 0 {
            break;
        }
    }
    let mut j = digits.len();
    loop {
        if j == 0 {
            break;
        }
        j = sub(j, 1);
        out.push(b8(in digits, j));
    }
}

// `operand_span(text)`: the operand inside grouping parentheses, as a
// start << 32 | end.
fn operand_span(in text: ChunkSeq[u8]) -> u64 {
    let mut d = diags_new();
    let raw = lex_raw(in text.as_slice(), inout d);
    let mut ks = ChunkSeq::new[u8]();
    let mut ss = ChunkSeq::new[u64]();
    let mut es = ChunkSeq::new[u64]();
    for i in 0..raw.kind.len() {
        let k = b8(in raw.kind, i);
        if !trivia_kind(k) && k != k_eof() {
            ks.push(k);
            ss.push(w32(in raw.start, i));
            es.push(token_end(in raw, i));
        }
    }
    let n = ks.len();
    // Open parentheses (index, tuple) and each one's closing index.
    let mut open = ChunkSeq::new[u64]();
    let mut last = ChunkSeq::new[u64]();
    for i in 0..n {
        last.push(NONE);
    }
    for i in 0..n {
        let k = b8(in ks, i);
        if k == k_l_paren() {
            open.push(i);
            open.push(0);
        } else if k == k_comma() {
            if open.len() != 0 {
                open.try_set(sub(open.len(), 1), 1);
            }
        } else if k == k_r_paren() {
            if open.len() != 0 {
                let j = w64(in open, sub(open.len(), 2));
                let tuple = w64(in open, sub(open.len(), 1));
                open.truncate(sub(open.len(), 2));
                if tuple == 0 {
                    last.try_set(j, i);
                }
            }
        }
    }
    let mut a: u64 = 0;
    let mut b = n;
    loop {
        if !(b > add(a, 2) && w64(in last, a) == sub(b, 1)) {
            break;
        }
        a = inc(a);
        b = sub(b, 1);
    }
    if b > a {
        (w64(in ss, a) << 32) | w64(in es, sub(b, 1))
    } else {
        text.len()
    }
}

pub fn value_text(in c: Caps, at: u64, in ib: ChunkSeq[u8], in tb: ChunkSeq[u8]) -> ChunkSeq[u8] {
    let s = w64(in c.w, at);
    let e = w64(in c.w, inc(at));
    let mut out = ChunkSeq::new[u8]();
    if w64(in c.w, add(at, 2)) == 1 {
        push_range(inout out, in tb, s, e);
    } else {
        push_range(inout out, in ib, s, e);
    }
    out
}

pub fn sort_in(in c: Caps, cap: u64, in names: Slice[u8]) -> bool {
    text_is(in c, cap_at(in c, cap, 1), in names)
}

// `Skeleton::emit(parts, caps, indices)` for the part list `list`.
fn emit(
    in s: ChunkSeq[u8],
    in x: Tx,
    list: u64,
    in c: Caps,
    in ib: ChunkSeq[u8],
    in tb: ChunkSeq[u8],
    in mark: ChunkSeq[u8],
    inout sk: Sk,
    inout ix: ChunkSeq[u64]
) {
    for j in 0..(list & 4294967295) {
        let p = w64(in x.lp, add(list >> 32, j));
        if sk.steps == 0 {
            sk_fail(inout sk, in "sugar template work limit exceeded".as_bytes());
            return;
        }
        sk.steps = sub(sk.steps, 1);
        let k = part_at(in x, p, 0);
        if k == P_TEXT {
            let ts = part_at(in x, p, 1);
            let te = part_at(in x, p, 2);
            if !room(inout sk, sub(te, ts)) {
                return;
            }
            push_range(inout sk.src, in s, ts, te);
        } else if k == P_HOLE {
            let ns = part_at(in x, p, 1);
            let ne = part_at(in x, p, 2);
            let sequence = part_at(in x, p, 3) == 1;
            let cap = find_cap(in c, in s, ns, ne);
            if cap == NONE {
                let mut m = ChunkSeq::new[u8]();
                hole_message(inout m, in "undefined template hole ".as_bytes(), in s, ns, ne);
                sk_fail(inout sk, in m.as_slice());
                return;
            }
            let seq_sort = sort_in(in c, cap, in "stmts".as_bytes())
                || sort_in(in c, cap, in "args".as_bytes())
                || sort_in(in c, cap, in "pats".as_bytes())
                || sort_in(in c, cap, in "items".as_bytes());
            if seq_sort && !sequence
                || sequence && !seq_sort && !sort_in(in c, cap, in "scope".as_bytes()) {
                let mut m = ChunkSeq::new[u8]();
                hole_message(inout m, in "wrong splice syntax for ".as_bytes(), in s, ns, ne);
                m.push(58);
                let sort = cap_at(in c, cap, 1);
                for q in 0..w64(in c.w, sort) {
                    m.push(wrapping_u8(w64(in c.w, add(inc(sort), q))));
                }
                sk_fail(inout sk, in m.as_slice());
                return;
            }
            let mut n = ix.len();
            let mut vi = NONE;
            loop {
                vi = value_search(in c, cap, in ix, n);
                if vi != NONE {
                    break;
                }
                if extent_find(in c, cap, in ix, n) != NONE || n == 0 {
                    let mut m = ChunkSeq::new[u8]();
                    hole_message(
                        inout m,
                        in "unbound repetition depth for ".as_bytes(),
                        in s,
                        ns,
                        ne
                    );
                    sk_fail(inout sk, in m.as_slice());
                    return;
                }
                n = sub(n, 1);
            }
            let mut id = NONE;
            for h in 0..(sk.holes.len() >> 2) {
                if w64(in sk.holes, h << 2) == cap && w64(in sk.holes, inc(h << 2)) == vi {
                    id = h;
                    break;
                }
            }
            if id == NONE {
                id = sk.holes.len() >> 2;
                let text = value_text(in c, value_at(in c, cap, vi), in ib, in tb);
                let op = operand_span(in text);
                sk.holes.push(cap);
                sk.holes.push(vi);
                sk.holes.push(op >> 32);
                sk.holes.push(op & 4294967295);
            }
            let mut marker = ChunkSeq::new[u8]();
            marker.extend(in mark.as_slice());
            push_decimal(inout marker, id);
            let start = sk.src.len();
            if !room(inout sk, marker.len()) {
                return;
            }
            sk.src.extend(in marker.as_slice());
            sk.slots.push(id);
            sk.slots.push(start);
            sk.slots.push(sk.src.len());
        } else {
            let mut count = NONE;
            let first = part_at(in x, p, 6);
            for q in 0..part_at(in x, p, 7) {
                let ns = w64(in x.np, add(first, q << 1));
                let ne = w64(in x.np, inc(add(first, q << 1)));
                let cap = find_cap(in c, in s, ns, ne);
                if cap == NONE {
                    let mut m = ChunkSeq::new[u8]();
                    hole_message(inout m, in "undefined template hole ".as_bytes(), in s, ns, ne);
                    sk_fail(inout sk, in m.as_slice());
                    return;
                }
                let e = extent_find(in c, cap, in ix, ix.len());
                if e != NONE {
                    let got = w64(in c.w, add(inc(e), w64(in c.w, e)));
                    let prev = count;
                    count = got;
                    if prev != NONE && prev != got {
                        sk_fail(inout sk, in "incompatible sugar repetition lengths".as_bytes());
                        return;
                    }
                }
            }
            if count == NONE {
                sk_fail(
                    inout sk,
                    in "template repetition has no captured sequence at this depth".as_bytes()
                );
                return;
            }
            if part_at(in x, p, 5) == 1 && count == 0 {
                sk_fail(
                    inout sk,
                    in "nonempty template repetition matched zero elements".as_bytes()
                );
                return;
            }
            let body = (part_at(in x, p, 1) << 32) | part_at(in x, p, 2);
            let sep_s = part_at(in x, p, 3);
            let sep_e = part_at(in x, p, 4);
            for r in 0..count {
                if r > 0 {
                    if !room(inout sk, sub(sep_e, sep_s)) {
                        return;
                    }
                    push_range(inout sk.src, in s, sep_s, sep_e);
                }
                ix.push(r);
                emit(in s, in x, body, in c, in ib, in tb, in mark, inout sk, inout ix);
                if sk.failed {
                    return;
                }
                ix.truncate(sub(ix.len(), 1));
            }
        }
    }
}

pub fn refused(in m: Slice[u8]) -> ChunkSeq[u64] {
    let mut out = ChunkSeq::new[u64]();
    out.push(2);
    out.push(m.len());
    for j in 0..m.len() {
        let b = match m.try_get(j) {
            Option::Some(b) => b,
            Option::None => 0,
        };
        out.push(widen_u64(b));
    }
    out
}

// The skeleton of template `s` for the captures `c` (a match of
// matcher.ves `match_rule_encoded`, whose values are spans of `ib`, or of
// `tb` from the tail): `render`'s `skeleton`, with a refusal in
// `failed`/`msg`.
pub fn skeleton_run(
    in s: ChunkSeq[u8],
    in c: Caps,
    in ib: ChunkSeq[u8],
    in tb: ChunkSeq[u8],
    in mark: ChunkSeq[u8],
    max_bytes: u64
) -> Sk {
    let steps = if max_bytes > 4611686018427387903 {
        NONE
    } else {
        max_bytes << 2
    };
    let mut sk = Sk {
        src: ChunkSeq::new[u8](),
        holes: ChunkSeq::new[u64](),
        slots: ChunkSeq::new[u64](),
        steps: steps,
        max: max_bytes,
        failed: false,
        msg: ChunkSeq::new[u8]()
    };
    let mut d = diags_new();
    let raw = lex_sugar_raw_with_limits(
        in s.as_slice(),
        inout d,
        max_source_bytes(),
        max_tokens(),
        max_diagnostics()
    );
    if raw.rejected {
        let end = if d.at.len() > 1 {
            w32(in d.at, 1)
        } else {
            d.text.len()
        };
        let mut m = ChunkSeq::new[u8]();
        for j in w32(in d.at, 0)..end {
            m.push(b8(in d.text, j));
        }
        sk_fail(inout sk, in m.as_slice());
        return sk;
    }
    if d.code.len() != 0 {
        sk_fail(inout sk, in "invalid token in sugar template".as_bytes());
        return sk;
    }
    let mut t = Tt { tk: ChunkSeq::new[u32]() };
    for i in 0..raw.kind.len() {
        t.tk.push(widen_u32(b8(in raw.kind, i)));
        t.tk.push(wrapping_u32(w32(in raw.start, i)));
        t.tk.push(wrapping_u32(token_end(in raw, i)));
    }
    let mut x = Tx {
        failed: false,
        msg: ChunkSeq::new[u8](),
        parts: ChunkSeq::new[u64](),
        lp: ChunkSeq::new[u64](),
        np: ChunkSeq::new[u64]()
    };
    let top = parse(in s, in t, inout x, 0, sub(tt_len(in t), 1), 0);
    if x.failed {
        sk_fail(inout sk, in x.msg.as_slice());
        return sk;
    }
    let mut ix = ChunkSeq::new[u64]();
    emit(in s, in x, top, in c, in ib, in tb, in mark, inout sk, inout ix);
    sk
}

// The skeleton of `template` for the captures `words`, as
// `template::skeleton_words` encodes it:
//   Err(message)  [2, len, message bytes]
//   Ok(skeleton)  [1, steps left, source (len, bytes), holes (count; per
//                 hole capture, value, operand start, operand end), slots
//                 (count; per slot hole, start, end)]
pub fn skeleton_encoded(
    in s: ChunkSeq[u8],
    sink words: ChunkSeq[u64],
    in ib: ChunkSeq[u8],
    in tb: ChunkSeq[u8],
    in mark: ChunkSeq[u8],
    max_bytes: u64
) -> ChunkSeq[u64] {
    let c = caps_read(words);
    let sk = skeleton_run(in s, in c, in ib, in tb, in mark, max_bytes);
    if sk.failed {
        return refused(in sk.msg.as_slice());
    }
    let mut out = ChunkSeq::new[u64]();
    out.push(1);
    out.push(sk.steps);
    out.push(sk.src.len());
    for j in 0..sk.src.len() {
        out.push(widen_u64(b8(in sk.src, j)));
    }
    out.push(sk.holes.len() >> 2);
    for j in 0..sk.holes.len() {
        out.push(w64(in sk.holes, j));
    }
    out.push(sk.slots.len() / 3);
    for j in 0..sk.slots.len() {
        out.push(w64(in sk.slots, j));
    }
    out
}
