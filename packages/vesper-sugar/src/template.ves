// `sugar_expand::template`, the first half: parse a rule's template into
// text, holes and repetitions, and emit its skeleton for one match (each
// hole a marker `mark` + id, repetitions unrolled), a transliteration of
// `parse`, `Skeleton::emit` and `operand_span` of
// crates/vesper-syntax/src/sugar_expand/template.rs. The scope and flow
// analysis (template/flow.rs) that turns the skeleton into the rendered
// text comes next.
//
// Rust's template tree becomes rows (`part_*`) whose child lists and name
// sets live in pools, and its `Captures` map the matcher's words
// (matcher.ves `match_rule_encoded`) read in place.

use @vesper/front::lex::{
    lex_raw, lex_sugar_raw_with_limits, max_diagnostics, max_source_bytes, max_tokens, token_end,
    trivia_kind
};
use @vesper/front::diag::{diags_new};
use @vesper/front::kinds::{
    k_comma, k_dollar, k_dot_dot, k_eff, k_eof, k_l_paren, k_linear, k_lower, k_plus, k_r_paren,
    k_star, k_state, k_upper, k_with
};

const NONE: u64 = 18446744073709551615;

// Part kinds and the row width (kind, then up to seven words).
const P_TEXT: u64 = 0;
const P_HOLE: u64 = 1;
const P_REPEAT: u64 = 2;
const PW: u64 = 8;

pub fn b8(in seq: ChunkSeq[u8], i: u64) -> u8 {
    match seq.try_get(i) {
        Option::Some(value) => value,
        Option::None => 0,
    }
}

pub fn w32(in seq: ChunkSeq[u32], i: u64) -> u64 {
    match seq.try_get(i) {
        Option::Some(value) => widen_u64(value),
        Option::None => 0,
    }
}

pub fn w64(in seq: ChunkSeq[u64], i: u64) -> u64 {
    match seq.try_get(i) {
        Option::Some(value) => value,
        Option::None => 0,
    }
}

pub fn inc(x: u64) -> u64 {
    wrapping_add(x, 1)
}

pub fn add(a: u64, b: u64) -> u64 {
    wrapping_add(a, b)
}

pub fn sub(a: u64, b: u64) -> u64 {
    wrapping_sub(a, b)
}

fn push_bytes(inout out: ChunkSeq[u8], in text: Slice[u8]) {
    out.extend(in text);
}

pub fn push_range(inout out: ChunkSeq[u8], in bytes: ChunkSeq[u8], start: u64, end: u64) {
    for j in start..end {
        out.push(b8(in bytes, j));
    }
}

// The captures of one match: the matcher's words and, per capture in
// name order, rows of seven words (word offsets of its name and sort,
// its pass code, the first and count of its value offsets in `voff`, the
// first and count of its extent offsets in `eoff`).
pub struct Caps {
    w: ChunkSeq[u64],
    cr: ChunkSeq[u64],
    voff: ChunkSeq[u64],
    eoff: ChunkSeq[u64]
}

pub fn caps_read(sink words: ChunkSeq[u64]) -> Caps {
    let mut cr = ChunkSeq::new[u64]();
    let mut voff = ChunkSeq::new[u64]();
    let mut eoff = ChunkSeq::new[u64]();
    let caps_len = w64(in words, 2);
    let mut at: u64 = 3;
    for cap in 0..caps_len {
        let name = at;
        at = add(inc(at), w64(in words, at));
        let sort = at;
        at = add(inc(at), w64(in words, at));
        let pass = w64(in words, at);
        at = inc(at);
        let value_count = w64(in words, at);
        at = inc(at);
        let vfirst = voff.len();
        for value in 0..value_count {
            voff.push(at);
            at = add(at, add(4, w64(in words, add(at, 3))));
        }
        let extent_count = w64(in words, at);
        at = inc(at);
        let efirst = eoff.len();
        for extent in 0..extent_count {
            eoff.push(at);
            at = add(at, add(2, w64(in words, at)));
        }
        cr.push(name);
        cr.push(sort);
        cr.push(pass);
        cr.push(vfirst);
        cr.push(value_count);
        cr.push(efirst);
        cr.push(extent_count);
    }
    Caps { w: words, cr: cr, voff: voff, eoff: eoff }
}

pub fn cap_count(in c: Caps) -> u64 {
    c.cr.len() / 7
}

pub fn cap_at(in c: Caps, cap: u64, field: u64) -> u64 {
    w64(in c.cr, add(wrapping_mul(cap, 7), field))
}

// Word offset of value `value_index` of capture `cap`: start, end, from_tail, then
// the indices (length, words).
pub fn value_at(in c: Caps, cap: u64, value_index: u64) -> u64 {
    w64(in c.voff, add(cap_at(in c, cap, 3), value_index))
}

fn extent_at(in c: Caps, cap: u64, extent: u64) -> u64 {
    w64(in c.eoff, add(cap_at(in c, cap, 5), extent))
}

// Whether the text at word offset `at` (length, bytes) is `b[s..e]`.
fn text_eq(in c: Caps, at: u64, in bytes: ChunkSeq[u8], start: u64, end: u64) -> bool {
    let n = w64(in c.w, at);
    if n != sub(end, start) {
        return false;
    }
    for j in 0..n {
        if w64(in c.w, add(inc(at), j)) != widen_u64(b8(in bytes, add(start, j))) {
            return false;
        }
    }
    true
}

pub fn text_is(in c: Caps, at: u64, in expected: Slice[u8]) -> bool {
    let n = w64(in c.w, at);
    if n != expected.len() {
        return false;
    }
    for j in 0..n {
        let byte = match expected.try_get(j) {
            Option::Some(byte) => byte,
            Option::None => 0,
        };
        if w64(in c.w, add(inc(at), j)) != widen_u64(byte) {
            return false;
        }
    }
    true
}

// `captures.get(name)` for the template's `b[s..e]`: the capture, or NONE.
fn find_cap(in c: Caps, in bytes: ChunkSeq[u8], start: u64, end: u64) -> u64 {
    for cap in 0..cap_count(in c) {
        if text_eq(in c, cap_at(in c, cap, 0), in bytes, start, end) {
            return cap;
        }
    }
    NONE
}

// `v.indices.as_slice().cmp(&ix[..n])` for the value at word offset `at`:
// 0 less, 1 equal, 2 greater.
fn indices_cmp(in c: Caps, at: u64, in indices: ChunkSeq[u64], n: u64) -> u64 {
    let len = w64(in c.w, at);
    let common = if len < n { len } else { n };
    for j in 0..common {
        let value_index = w64(in c.w, add(inc(at), j));
        let wanted_index = w64(in indices, j);
        if value_index < wanted_index {
            return 0;
        }
        if value_index > wanted_index {
            return 2;
        }
    }
    if len < n {
        0
    } else if len > n {
        2
    } else {
        1
    }
}

// `cap.values.binary_search_by(|v| v.indices.cmp(&ix[..n]))` in std's
// order of probes: the value's index, or NONE.
fn value_search(in c: Caps, cap: u64, in indices: ChunkSeq[u64], n: u64) -> u64 {
    let mut size = cap_at(in c, cap, 4);
    if size == 0 {
        return NONE;
    }
    let mut base: u64 = 0;
    loop {
        if size <= 1 {
            break;
        }
        let half = size >> 1;
        let mid = add(base, half);
        if indices_cmp(in c, add(value_at(in c, cap, mid), 3), in indices, n) != 2 {
            base = mid;
        }
        size = sub(size, half);
    }
    if indices_cmp(in c, add(value_at(in c, cap, base), 3), in indices, n) == 1 {
        base
    } else {
        NONE
    }
}

// `cap.extents.get(&ix[..n])`: the extent's word offset, or NONE.
fn extent_find(in c: Caps, cap: u64, in indices: ChunkSeq[u64], n: u64) -> u64 {
    for extent in 0..cap_at(in c, cap, 6) {
        let at = extent_at(in c, cap, extent);
        if indices_cmp(in c, at, in indices, n) == 1 {
            return at;
        }
    }
    NONE
}

// The template's tokens, trivia and Eof included: rows of kind, start,
// end.
struct Tt {
    tk: ChunkSeq[u32]
}

fn tt_len(in t: Tt) -> u64 {
    t.tk.len() / 3
}

fn tt_kind(in t: Tt, i: u64) -> u8 {
    match t.tk.try_get(wrapping_mul(i, 3)) {
        Option::Some(k) => wrapping_u8(widen_u64(k)),
        Option::None => k_eof(),
    }
}

fn tt_s(in t: Tt, i: u64) -> u64 {
    w32(in t.tk, inc(wrapping_mul(i, 3)))
}

fn tt_e(in t: Tt, i: u64) -> u64 {
    w32(in t.tk, add(wrapping_mul(i, 3), 2))
}

fn next(in t: Tt, i: u64) -> u64 {
    let mut pos = i;
    loop {
        if pos >= tt_len(in t) || !trivia_kind(tt_kind(in t, pos)) {
            break;
        }
        pos = inc(pos);
    }
    pos
}

// The parsed template: parts (rows of `PW` words), the pool of child
// lists (part ids) and the pool of repetition name sets (start, end
// pairs into the template), and the refusal.
struct Tx {
    failed: bool,
    msg: ChunkSeq[u8],
    parts: ChunkSeq[u64],
    lp: ChunkSeq[u64],
    np: ChunkSeq[u64]
}

fn tx_fail(inout x: Tx, in text: Slice[u8]) {
    if !x.failed {
        x.failed = true;
        x.msg.clear();
        x.msg.extend(in text);
    }
}

fn part_at(in x: Tx, part: u64, field: u64) -> u64 {
    w64(in x.parts, add(wrapping_mul(part, PW), field))
}

fn push_part(
    inout x: Tx,
    kind: u64,
    a: u64,
    b: u64,
    c: u64,
    d: u64,
    e: u64,
    f: u64,
    g: u64
) -> u64 {
    let id = x.parts.len() / PW;
    x.parts.push(kind);
    x.parts.push(a);
    x.parts.push(b);
    x.parts.push(c);
    x.parts.push(d);
    x.parts.push(e);
    x.parts.push(f);
    x.parts.push(g);
    id
}

// `b[s1..e1] < b[s2..e2]` byte-wise.
fn range_less(in bytes: ChunkSeq[u8], s1: u64, e1: u64, s2: u64, e2: u64) -> bool {
    let n1 = sub(e1, s1);
    let n2 = sub(e2, s2);
    let common = if n1 < n2 { n1 } else { n2 };
    for j in 0..common {
        let left_byte = b8(in bytes, add(s1, j));
        let right_byte = b8(in bytes, add(s2, j));
        if left_byte != right_byte {
            return left_byte < right_byte;
        }
    }
    n1 < n2
}

fn range_eq(in bytes: ChunkSeq[u8], s1: u64, e1: u64, s2: u64, e2: u64) -> bool {
    !range_less(in bytes, s1, e1, s2, e2) && !range_less(in bytes, s2, e2, s1, e1)
}

fn ascii_punctuation(byte: u8) -> bool {
    byte >= 33 && byte <= 47
        || byte >= 58 && byte <= 64
        || byte >= 91 && byte <= 96
        || byte >= 123 && byte <= 126
}

fn hole_name_kind(kind: u8) -> bool {
    kind == k_lower()
        || kind == k_upper()
        || kind == k_with()
        || kind == k_state()
        || kind == k_eff()
        || kind == k_linear()
}

// `parse(s, tokens, start..end, depth)`: the list of parts (first << 32
// | count in `lp`), or the refusal.
fn parse(
    in template: ChunkSeq[u8],
    in toks: Tt,
    inout x: Tx,
    start: u64,
    end: u64,
    depth: u64
) -> u64 {
    if depth >= 64 {
        tx_fail(inout x, in "template repetition nesting limit exceeded".as_bytes());
        return 0;
    }
    let mut ids = ChunkSeq::new[u64]();
    let mut tok = start;
    loop {
        if tok >= end {
            break;
        }
        if tt_kind(in toks, tok) != k_dollar() {
            ids.push(
                push_part(inout x, P_TEXT, tt_s(in toks, tok), tt_e(in toks, tok), 0, 0, 0, 0, 0)
            );
            tok = inc(tok);
            continue;
        }
        tok = next(in toks, inc(tok));
        if tok < tt_len(in toks) && tt_kind(in toks, tok) == k_l_paren() {
            let begin = inc(tok);
            let mut level: u64 = 1;
            tok = begin;
            loop {
                if tok >= end {
                    break;
                }
                let kind = tt_kind(in toks, tok);
                if kind == k_l_paren() {
                    level = inc(level);
                } else if kind == k_r_paren() {
                    level = sub(level, 1);
                }
                if level == 0 {
                    break;
                }
                tok = inc(tok);
            }
            if tok == end {
                tx_fail(inout x, in "unclosed template repetition".as_bytes());
                return 0;
            }
            let body = parse(in template, in toks, inout x, begin, tok, inc(depth));
            if x.failed {
                return 0;
            }
            // The body's hole names and its repetitions' names, sorted
            // and without duplicates (a `BTreeSet`).
            let mut names = ChunkSeq::new[u64]();
            for j in 0..(body & 4294967295) {
                let part = w64(in x.lp, add(body >> 32, j));
                let kind = part_at(in x, part, 0);
                if kind == P_HOLE {
                    names.push(part_at(in x, part, 1));
                    names.push(part_at(in x, part, 2));
                } else if kind == P_REPEAT {
                    let first = part_at(in x, part, 6);
                    for name in 0..part_at(in x, part, 7) {
                        names.push(w64(in x.np, add(first, name << 1)));
                        names.push(w64(in x.np, inc(add(first, name << 1))));
                    }
                }
            }
            let first = x.np.len();
            let mut count: u64 = 0;
            for j in 0..(names.len() >> 1) {
                let name_start = w64(in names, j << 1);
                let name_end = w64(in names, inc(j << 1));
                // Insert in order unless present.
                let mut at = count;
                let mut dup = false;
                for existing in 0..count {
                    let other_start = w64(in x.np, add(first, existing << 1));
                    let other_end = w64(in x.np, inc(add(first, existing << 1)));
                    if range_eq(in template, name_start, name_end, other_start, other_end) {
                        dup = true;
                        break;
                    }
                    if range_less(in template, name_start, name_end, other_start, other_end) {
                        at = existing;
                        break;
                    }
                }
                if dup {
                    continue;
                }
                x.np.push(0);
                x.np.push(0);
                let mut slot = count;
                loop {
                    if slot <= at {
                        break;
                    }
                    let from = add(first, sub(slot, 1) << 1);
                    let to = add(first, slot << 1);
                    x.np.try_set(to, w64(in x.np, from));
                    x.np.try_set(inc(to), w64(in x.np, inc(from)));
                    slot = sub(slot, 1);
                }
                x.np.try_set(add(first, at << 1), name_start);
                x.np.try_set(inc(add(first, at << 1)), name_end);
                count = inc(count);
            }
            tok = next(in toks, inc(tok));
            let mut sep_start: u64 = 0;
            let mut sep_end: u64 = 0;
            let kind = tt_kind(in toks, tok);
            if !(tok < tt_len(in toks) && (kind == k_plus() || kind == k_star())) {
                if !(tok < end) {
                    tx_fail(inout x, in "missing template repetition quantifier".as_bytes());
                    return 0;
                }
                sep_start = tt_s(in toks, tok);
                sep_end = tt_e(in toks, tok);
                for j in sep_start..sep_end {
                    if !ascii_punctuation(b8(in template, j)) {
                        tx_fail(inout x, in "invalid template repetition separator".as_bytes());
                        return 0;
                    }
                }
                tok = next(in toks, inc(tok));
            }
            if !(tok < end) {
                tx_fail(inout x, in "missing template repetition quantifier".as_bytes());
                return 0;
            }
            let quant = tt_kind(in toks, tok);
            if quant != k_star() && quant != k_plus() {
                tx_fail(inout x, in "expected * or + after template repetition".as_bytes());
                return 0;
            }
            let plus: u64 = if quant == k_plus() { 1 } else { 0 };
            ids.push(
                push_part(
                    inout x,
                    P_REPEAT,
                    body >> 32,
                    body & 4294967295,
                    sep_start,
                    sep_end,
                    plus,
                    first,
                    count
                )
            );
        } else {
            let seq = tok < tt_len(in toks) && tt_kind(in toks, tok) == k_dot_dot();
            if seq {
                tok = next(in toks, inc(tok));
            }
            if !(tok < end && hole_name_kind(tt_kind(in toks, tok))) {
                tx_fail(inout x, in "expected a template hole name".as_bytes());
                return 0;
            }
            let seq_code: u64 = if seq { 1 } else { 0 };
            ids.push(
                push_part(
                    inout x,
                    P_HOLE,
                    tt_s(in toks, tok),
                    tt_e(in toks, tok),
                    seq_code,
                    0,
                    0,
                    0,
                    0
                )
            );
        }
        tok = inc(tok);
    }
    let first = x.lp.len();
    for j in 0..ids.len() {
        x.lp.push(w64(in ids, j));
    }
    (first << 32) | ids.len()
}

// The skeleton: the template source with markers, the holes (rows of
// capture, value, operand start, operand end), the slots (rows of hole,
// start, end), the step budget, the byte limit and the refusal.
pub struct Sk {
    src: ChunkSeq[u8],
    holes: ChunkSeq[u64],
    slots: ChunkSeq[u64],
    steps: u64,
    max: u64,
    failed: bool,
    msg: ChunkSeq[u8]
}

pub fn sk_fail(inout sk: Sk, in text: Slice[u8]) {
    if !sk.failed {
        sk.failed = true;
        sk.msg.clear();
        sk.msg.extend(in text);
    }
}

// `bounded`'s check: false (and the refusal) when `n` more bytes would
// pass the limit.
pub fn room(inout sk: Sk, n: u64) -> bool {
    let left = if sk.src.len() > sk.max {
        0
    } else {
        sub(sk.max, sk.src.len())
    };
    if n > left {
        sk_fail(inout sk, in "sugar expansion byte limit exceeded".as_bytes());
        return false;
    }
    true
}

fn hole_message(
    inout message: ChunkSeq[u8],
    in head: Slice[u8],
    in template: ChunkSeq[u8],
    name_start: u64,
    name_end: u64
) {
    message.extend(in head);
    message.push(36);
    push_range(inout message, in template, name_start, name_end);
}

pub fn push_decimal(inout out: ChunkSeq[u8], value: u64) {
    let mut digits = ChunkSeq::new[u8]();
    let mut rest = value;
    loop {
        digits.push(wrapping_u8(add(48, rest % 10)));
        rest = rest / 10;
        if rest == 0 {
            break;
        }
    }
    let mut j = digits.len();
    loop {
        if j == 0 {
            break;
        }
        j = sub(j, 1);
        out.push(b8(in digits, j));
    }
}

// `operand_span(text)`: the operand inside grouping parentheses, as a
// start << 32 | end.
fn operand_span(in text: ChunkSeq[u8]) -> u64 {
    let mut diags = diags_new();
    let raw = lex_raw(in text.as_slice(), inout diags);
    let mut kinds = ChunkSeq::new[u8]();
    let mut starts = ChunkSeq::new[u64]();
    let mut ends = ChunkSeq::new[u64]();
    for i in 0..raw.kind.len() {
        let kind = b8(in raw.kind, i);
        if !trivia_kind(kind) && kind != k_eof() {
            kinds.push(kind);
            starts.push(w32(in raw.start, i));
            ends.push(token_end(in raw, i));
        }
    }
    let n = kinds.len();
    // Open parentheses (index, tuple) and each one's closing index.
    let mut open = ChunkSeq::new[u64]();
    let mut last = ChunkSeq::new[u64]();
    for i in 0..n {
        last.push(NONE);
    }
    for i in 0..n {
        let kind = b8(in kinds, i);
        if kind == k_l_paren() {
            open.push(i);
            open.push(0);
        } else if kind == k_comma() {
            if open.len() != 0 {
                open.try_set(sub(open.len(), 1), 1);
            }
        } else if kind == k_r_paren() {
            if open.len() != 0 {
                let open_index = w64(in open, sub(open.len(), 2));
                let tuple = w64(in open, sub(open.len(), 1));
                open.truncate(sub(open.len(), 2));
                if tuple == 0 {
                    last.try_set(open_index, i);
                }
            }
        }
    }
    let mut lo: u64 = 0;
    let mut hi = n;
    loop {
        if !(hi > add(lo, 2) && w64(in last, lo) == sub(hi, 1)) {
            break;
        }
        lo = inc(lo);
        hi = sub(hi, 1);
    }
    if hi > lo {
        (w64(in starts, lo) << 32) | w64(in ends, sub(hi, 1))
    } else {
        text.len()
    }
}

pub fn value_text(
    in c: Caps,
    at: u64,
    in invocation: ChunkSeq[u8],
    in tail: ChunkSeq[u8]
) -> ChunkSeq[u8] {
    let start = w64(in c.w, at);
    let end = w64(in c.w, inc(at));
    let mut out = ChunkSeq::new[u8]();
    if w64(in c.w, add(at, 2)) == 1 {
        push_range(inout out, in tail, start, end);
    } else {
        push_range(inout out, in invocation, start, end);
    }
    out
}

pub fn sort_in(in c: Caps, cap: u64, in names: Slice[u8]) -> bool {
    text_is(in c, cap_at(in c, cap, 1), in names)
}

// `Skeleton::emit(parts, caps, indices)` for the part list `list`.
fn emit(
    in template: ChunkSeq[u8],
    in x: Tx,
    list: u64,
    in c: Caps,
    in invocation: ChunkSeq[u8],
    in tail: ChunkSeq[u8],
    in mark: ChunkSeq[u8],
    inout sk: Sk,
    inout indices: ChunkSeq[u64]
) {
    for j in 0..(list & 4294967295) {
        let part = w64(in x.lp, add(list >> 32, j));
        if sk.steps == 0 {
            sk_fail(inout sk, in "sugar template work limit exceeded".as_bytes());
            return;
        }
        sk.steps = sub(sk.steps, 1);
        let kind = part_at(in x, part, 0);
        if kind == P_TEXT {
            let text_start = part_at(in x, part, 1);
            let text_end = part_at(in x, part, 2);
            if !room(inout sk, sub(text_end, text_start)) {
                return;
            }
            push_range(inout sk.src, in template, text_start, text_end);
        } else if kind == P_HOLE {
            let name_start = part_at(in x, part, 1);
            let name_end = part_at(in x, part, 2);
            let sequence = part_at(in x, part, 3) == 1;
            let cap = find_cap(in c, in template, name_start, name_end);
            if cap == NONE {
                let mut message = ChunkSeq::new[u8]();
                hole_message(
                    inout message,
                    in "undefined template hole ".as_bytes(),
                    in template,
                    name_start,
                    name_end
                );
                sk_fail(inout sk, in message.as_slice());
                return;
            }
            let seq_sort = sort_in(in c, cap, in "stmts".as_bytes())
                || sort_in(in c, cap, in "args".as_bytes())
                || sort_in(in c, cap, in "pats".as_bytes())
                || sort_in(in c, cap, in "items".as_bytes());
            if seq_sort && !sequence
                || sequence && !seq_sort && !sort_in(in c, cap, in "scope".as_bytes()) {
                let mut message = ChunkSeq::new[u8]();
                hole_message(
                    inout message,
                    in "wrong splice syntax for ".as_bytes(),
                    in template,
                    name_start,
                    name_end
                );
                message.push(58);
                let sort = cap_at(in c, cap, 1);
                for sort_byte in 0..w64(in c.w, sort) {
                    message.push(wrapping_u8(w64(in c.w, add(inc(sort), sort_byte))));
                }
                sk_fail(inout sk, in message.as_slice());
                return;
            }
            let mut depth = indices.len();
            let mut value_index = NONE;
            loop {
                value_index = value_search(in c, cap, in indices, depth);
                if value_index != NONE {
                    break;
                }
                if extent_find(in c, cap, in indices, depth) != NONE || depth == 0 {
                    let mut message = ChunkSeq::new[u8]();
                    hole_message(
                        inout message,
                        in "unbound repetition depth for ".as_bytes(),
                        in template,
                        name_start,
                        name_end
                    );
                    sk_fail(inout sk, in message.as_slice());
                    return;
                }
                depth = sub(depth, 1);
            }
            let mut id = NONE;
            for hole in 0..(sk.holes.len() >> 2) {
                if w64(in sk.holes, hole << 2) == cap
                    && w64(in sk.holes, inc(hole << 2)) == value_index {
                    id = hole;
                    break;
                }
            }
            if id == NONE {
                id = sk.holes.len() >> 2;
                let text = value_text(
                    in c,
                    value_at(in c, cap, value_index),
                    in invocation,
                    in tail
                );
                let operand = operand_span(in text);
                sk.holes.push(cap);
                sk.holes.push(value_index);
                sk.holes.push(operand >> 32);
                sk.holes.push(operand & 4294967295);
            }
            let mut marker = ChunkSeq::new[u8]();
            marker.extend(in mark.as_slice());
            push_decimal(inout marker, id);
            let start = sk.src.len();
            if !room(inout sk, marker.len()) {
                return;
            }
            sk.src.extend(in marker.as_slice());
            sk.slots.push(id);
            sk.slots.push(start);
            sk.slots.push(sk.src.len());
        } else {
            let mut count = NONE;
            let first = part_at(in x, part, 6);
            for name in 0..part_at(in x, part, 7) {
                let name_start = w64(in x.np, add(first, name << 1));
                let name_end = w64(in x.np, inc(add(first, name << 1)));
                let cap = find_cap(in c, in template, name_start, name_end);
                if cap == NONE {
                    let mut message = ChunkSeq::new[u8]();
                    hole_message(
                        inout message,
                        in "undefined template hole ".as_bytes(),
                        in template,
                        name_start,
                        name_end
                    );
                    sk_fail(inout sk, in message.as_slice());
                    return;
                }
                let extent = extent_find(in c, cap, in indices, indices.len());
                if extent != NONE {
                    let got = w64(in c.w, add(inc(extent), w64(in c.w, extent)));
                    let prev = count;
                    count = got;
                    if prev != NONE && prev != got {
                        sk_fail(inout sk, in "incompatible sugar repetition lengths".as_bytes());
                        return;
                    }
                }
            }
            if count == NONE {
                sk_fail(
                    inout sk,
                    in "template repetition has no captured sequence at this depth".as_bytes()
                );
                return;
            }
            if part_at(in x, part, 5) == 1 && count == 0 {
                sk_fail(
                    inout sk,
                    in "nonempty template repetition matched zero elements".as_bytes()
                );
                return;
            }
            let body = (part_at(in x, part, 1) << 32) | part_at(in x, part, 2);
            let sep_start = part_at(in x, part, 3);
            let sep_end = part_at(in x, part, 4);
            for rep in 0..count {
                if rep > 0 {
                    if !room(inout sk, sub(sep_end, sep_start)) {
                        return;
                    }
                    push_range(inout sk.src, in template, sep_start, sep_end);
                }
                indices.push(rep);
                emit(
                    in template,
                    in x,
                    body,
                    in c,
                    in invocation,
                    in tail,
                    in mark,
                    inout sk,
                    inout indices
                );
                if sk.failed {
                    return;
                }
                indices.truncate(sub(indices.len(), 1));
            }
        }
    }
}

pub fn refused(in message: Slice[u8]) -> ChunkSeq[u64] {
    let mut out = ChunkSeq::new[u64]();
    out.push(2);
    out.push(message.len());
    for j in 0..message.len() {
        let byte = match message.try_get(j) {
            Option::Some(byte) => byte,
            Option::None => 0,
        };
        out.push(widen_u64(byte));
    }
    out
}

// The skeleton of template `template` for the captures `c` (a match of
// matcher.ves `match_rule_encoded`, whose values are spans of `invocation`, or of
// `tail` from the tail): `render`'s `skeleton`, with a refusal in
// `failed`/`msg`.
pub fn skeleton_run(
    in template: ChunkSeq[u8],
    in c: Caps,
    in invocation: ChunkSeq[u8],
    in tail: ChunkSeq[u8],
    in mark: ChunkSeq[u8],
    max_bytes: u64
) -> Sk {
    let steps = if max_bytes > 4611686018427387903 {
        NONE
    } else {
        max_bytes << 2
    };
    let mut sk = Sk {
        src: ChunkSeq::new[u8](),
        holes: ChunkSeq::new[u64](),
        slots: ChunkSeq::new[u64](),
        steps: steps,
        max: max_bytes,
        failed: false,
        msg: ChunkSeq::new[u8]()
    };
    let mut diags = diags_new();
    let raw = lex_sugar_raw_with_limits(
        in template.as_slice(),
        inout diags,
        max_source_bytes(),
        max_tokens(),
        max_diagnostics()
    );
    if raw.rejected {
        let end = if diags.at.len() > 1 {
            w32(in diags.at, 1)
        } else {
            diags.text.len()
        };
        let mut message = ChunkSeq::new[u8]();
        for j in w32(in diags.at, 0)..end {
            message.push(b8(in diags.text, j));
        }
        sk_fail(inout sk, in message.as_slice());
        return sk;
    }
    if diags.code.len() != 0 {
        sk_fail(inout sk, in "invalid token in sugar template".as_bytes());
        return sk;
    }
    let mut toks = Tt { tk: ChunkSeq::new[u32]() };
    for i in 0..raw.kind.len() {
        toks.tk.push(widen_u32(b8(in raw.kind, i)));
        toks.tk.push(wrapping_u32(w32(in raw.start, i)));
        toks.tk.push(wrapping_u32(token_end(in raw, i)));
    }
    let mut parsed = Tx {
        failed: false,
        msg: ChunkSeq::new[u8](),
        parts: ChunkSeq::new[u64](),
        lp: ChunkSeq::new[u64](),
        np: ChunkSeq::new[u64]()
    };
    let top = parse(in template, in toks, inout parsed, 0, sub(tt_len(in toks), 1), 0);
    if parsed.failed {
        sk_fail(inout sk, in parsed.msg.as_slice());
        return sk;
    }
    let mut indices = ChunkSeq::new[u64]();
    emit(
        in template,
        in parsed,
        top,
        in c,
        in invocation,
        in tail,
        in mark,
        inout sk,
        inout indices
    );
    sk
}

// The skeleton of `template` for the captures `words`, as
// `template::skeleton_words` encodes it:
//   Err(message)  [2, len, message bytes]
//   Ok(skeleton)  [1, steps left, source (len, bytes), holes (count; per
//                 hole capture, value, operand start, operand end), slots
//                 (count; per slot hole, start, end)]
pub fn skeleton_encoded(
    in template: ChunkSeq[u8],
    sink words: ChunkSeq[u64],
    in invocation: ChunkSeq[u8],
    in tail: ChunkSeq[u8],
    in mark: ChunkSeq[u8],
    max_bytes: u64
) -> ChunkSeq[u64] {
    let c = caps_read(words);
    let sk = skeleton_run(in template, in c, in invocation, in tail, in mark, max_bytes);
    if sk.failed {
        return refused(in sk.msg.as_slice());
    }
    let mut out = ChunkSeq::new[u64]();
    out.push(1);
    out.push(sk.steps);
    out.push(sk.src.len());
    for j in 0..sk.src.len() {
        out.push(widen_u64(b8(in sk.src, j)));
    }
    out.push(sk.holes.len() >> 2);
    for j in 0..sk.holes.len() {
        out.push(w64(in sk.holes, j));
    }
    out.push(sk.slots.len() / 3);
    for j in 0..sk.slots.len() {
        out.push(w64(in sk.slots, j));
    }
    out
}
