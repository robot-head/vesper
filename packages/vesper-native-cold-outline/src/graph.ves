// The analyses the cold outliner asks Cranelift for, on @vesper/clif
// tables: successors (`block_succs`), the CFG's predecessors, the
// dominator tree (`DominatorTree::with_function`, `dominates`) and the loop
// forest (`LoopAnalysis::compute`, `innermost_loop`, `loop_header`,
// `loop_parent`), each the way Cranelift 0.125 computes it:
//
// - successors are the destinations of a block's last instruction, in
//   order (repeats kept);
// - a block's predecessors are the branches that name it, once per
//   branch, ordered by instruction number (the CFG's bforest map);
// - the spanning-tree DFS from the entry pushes successors in reverse and
//   skips the ones already numbered, so its post-order (and the reverse
//   post-order the loop analysis walks) is Cranelift's;
// - `dominates` compares dominator-tree preorder numbers, which are 0 for
//   an unreachable block, so an unreachable block "dominates" another
//   unreachable one and no reachable block dominates an unreachable one.

use @vesper/clif::{Func, u32_at, w};
use @vesper/clif::codes::{NONE};

pub struct Graph {
    // per block: its successors, succ[succ_start .. succ_start + succ_count]
    succ_start: ChunkSeq[u32],
    succ_count: ChunkSeq[u32],
    succ: ChunkSeq[u32],
    // per block: its predecessors, as (block, branch) pairs at
    // pred_start .. pred_start + pred_count
    pred_start: ChunkSeq[u32],
    pred_count: ChunkSeq[u32],
    pred_blocks: ChunkSeq[u32],
    pred_insts: ChunkSeq[u32],
    // the entry, NONE for an empty layout
    entry: u32,
    // the DFS post-order (reachable blocks)
    post: ChunkSeq[u32],
    // per block: its reverse post-order number + 1, 0 when unreachable
    rpo_num: ChunkSeq[u32],
    idom: ChunkSeq[u32],
    // per block: its innermost loop, NONE for none
    loop_of: ChunkSeq[u32],
    // per loop
    loop_header: ChunkSeq[u32],
    loop_parent: ChunkSeq[u32],
}

// One (block, branch, target) edge per branch and distinct target, in
// layout order.
struct Edges {
    block: ChunkSeq[u32],
    inst: ChunkSeq[u32],
    target: ChunkSeq[u32],
}

fn inc(x: u64) -> u64 {
    wrapping_add(x, 1)
}

fn put(inout s: ChunkSeq[u32], i: u64, x: u32) {
    let ok = s.try_set(i, x);
}

fn u64_at(in s: ChunkSeq[u64], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

// Whether the DFS has numbered `b` (true past the table, so the walk never
// enters a block it cannot mark).
fn visited_at(in visited: ChunkSeq[u8], b: u32) -> bool {
    match visited.try_get(w(b)) {
        Option::Some(v) => v != 0,
        Option::None => true,
    }
}

impl Graph {
    pub fn nsuccs(in self, b: u32) -> u64 {
        w(u32_at(in self.succ_count, w(b)))
    }

    pub fn succ_at(in self, b: u32, k: u64) -> u32 {
        u32_at(in self.succ, wrapping_add(w(u32_at(in self.succ_start, w(b))), k))
    }

    pub fn has_succ(in self, b: u32, s: u32) -> bool {
        for k in 0..self.nsuccs(b) {
            if self.succ_at(b, k) == s {
                return true;
            }
        }
        false
    }

    pub fn npreds(in self, b: u32) -> u64 {
        w(u32_at(in self.pred_count, w(b)))
    }

    pub fn pred_block(in self, b: u32, k: u64) -> u32 {
        u32_at(in self.pred_blocks, wrapping_add(w(u32_at(in self.pred_start, w(b))), k))
    }

    pub fn reachable(in self, b: u32) -> bool {
        b != NONE && u32_at(in self.rpo_num, w(b)) != 0 && u32_at(in self.rpo_num, w(b)) != NONE
    }

    // `domtree.dominates(a, b)` for blocks.
    pub fn dominates(in self, a: u32, b: u32) -> bool {
        let a_reachable = self.reachable(a);
        let b_reachable = self.reachable(b);
        if !a_reachable || !b_reachable {
            return !a_reachable && !b_reachable;
        }
        let mut walk = b;
        loop {
            if walk == a {
                return true;
            }
            if walk == self.entry || walk == NONE {
                return false;
            }
            walk = u32_at(in self.idom, w(walk));
        }
    }

    pub fn innermost(in self, b: u32) -> u32 {
        u32_at(in self.loop_of, w(b))
    }

    pub fn header(in self, lp: u32) -> u32 {
        u32_at(in self.loop_header, w(lp))
    }

    pub fn parent(in self, lp: u32) -> u32 {
        u32_at(in self.loop_parent, w(lp))
    }

    // The `q`-th block in reverse post-order.
    fn rpo_block(in self, q: u64) -> u32 {
        u32_at(in self.post, wrapping_sub(wrapping_sub(self.post.len(), 1), q))
    }
}

// The common dominator of `a` and `b` in the idoms so far (by reverse
// post-order numbers).
fn intersect(in g: Graph, a: u32, b: u32) -> u32 {
    let mut finger_a = a;
    let mut finger_b = b;
    loop {
        if finger_a == finger_b {
            return finger_a;
        }
        let rpo_a = u32_at(in g.rpo_num, w(finger_a));
        let rpo_b = u32_at(in g.rpo_num, w(finger_b));
        if rpo_a > rpo_b {
            finger_a = u32_at(in g.idom, w(finger_a));
        } else {
            finger_b = u32_at(in g.idom, w(finger_b));
        }
    }
}

// The graph of `f` as it stands.
pub fn graph(in f: Func) -> Graph {
    let block_count = f.nblocks();
    let mut g = Graph {
        succ_start: ChunkSeq::new[u32](),
        succ_count: ChunkSeq::new[u32](),
        succ: ChunkSeq::new[u32](),
        pred_start: ChunkSeq::new[u32](),
        pred_count: ChunkSeq::new[u32](),
        pred_blocks: ChunkSeq::new[u32](),
        pred_insts: ChunkSeq::new[u32](),
        entry: f.first_block(),
        post: ChunkSeq::new[u32](),
        rpo_num: ChunkSeq::new[u32](),
        idom: ChunkSeq::new[u32](),
        loop_of: ChunkSeq::new[u32](),
        loop_header: ChunkSeq::new[u32](),
        loop_parent: ChunkSeq::new[u32]()
    };
    g.succ_start.resize(block_count, 0);
    g.succ_count.resize(block_count, 0);
    g.pred_start.resize(block_count, 0);
    g.pred_count.resize(block_count, 0);
    g.rpo_num.resize(block_count, 0);
    g.idom.resize(block_count, NONE);
    g.loop_of.resize(block_count, NONE);
    let edges = successors(inout g, in f);
    predecessors(inout g, in edges, block_count);
    if g.entry == NONE {
        return g;
    }
    post_order(inout g, block_count);
    for q in 0..g.post.len() {
        let blk = g.rpo_block(q);
        put(inout g.rpo_num, w(blk), wrapping_u32(inc(q)));
    }
    dominators(inout g);
    loop_headers(inout g);
    loop_blocks(inout g);
    g
}

// Each block's successors, and the edges its branches add.
fn successors(inout g: Graph, in f: Func) -> Edges {
    let mut edges = Edges {
        block: ChunkSeq::new[u32](),
        inst: ChunkSeq::new[u32](),
        target: ChunkSeq::new[u32]()
    };
    let mut b = f.first_block();
    loop {
        if b == NONE {
            break;
        }
        put(inout g.succ_start, w(b), wrapping_u32(g.succ.len()));
        let last = f.last_inst(b);
        if last != NONE {
            let dest_count = f.ndests(last);
            put(inout g.succ_count, w(b), wrapping_u32(dest_count));
            for k in 0..dest_count {
                let dest = f.dest_block(last, k);
                g.succ.push(dest);
                let mut repeated = false;
                for q in 0..k {
                    if f.dest_block(last, q) == dest {
                        repeated = true;
                    }
                }
                if !repeated {
                    edges.block.push(b);
                    edges.inst.push(last);
                    edges.target.push(dest);
                }
            }
        }
        b = f.next_block(b);
    }
    edges
}

// Each block's predecessors, by branch number: count them, then place them
// in order.
fn predecessors(inout g: Graph, in edges: Edges, block_count: u64) {
    let mut order = ChunkSeq::new[u64]();
    for k in 0..edges.block.len() {
        order.push(k);
    }
    sort_by_inst(inout order, in edges.inst);
    let mut counts = ChunkSeq::new[u32]();
    counts.resize(block_count, 0);
    for k in 0..edges.target.len() {
        let target = w(u32_at(in edges.target, k));
        put(inout counts, target, wrapping_add(u32_at(in counts, target), 1));
    }
    let mut start: u32 = 0;
    for b in 0..block_count {
        put(inout g.pred_start, b, start);
        start = wrapping_add(start, u32_at(in counts, b));
    }
    g.pred_blocks.resize(edges.target.len(), NONE);
    g.pred_insts.resize(edges.target.len(), NONE);
    let mut placed = ChunkSeq::new[u32]();
    placed.resize(block_count, 0);
    for q in 0..order.len() {
        let k = u64_at(in order, q);
        let target = w(u32_at(in edges.target, k));
        let slot = wrapping_add(w(u32_at(in g.pred_start, target)), w(u32_at(in placed, target)));
        put(inout g.pred_blocks, slot, u32_at(in edges.block, k));
        put(inout g.pred_insts, slot, u32_at(in edges.inst, k));
        put(inout placed, target, wrapping_add(u32_at(in placed, target), 1));
    }
    for b in 0..block_count {
        put(inout g.pred_count, b, u32_at(in placed, b));
    }
}

// The spanning-tree DFS from the entry, as a stack of (enter?, block)
// events: a block is numbered when its exit event pops.
fn post_order(inout g: Graph, block_count: u64) {
    let mut visited = ChunkSeq::new[u8]();
    visited.resize(block_count, 0);
    let mut ev_enter = ChunkSeq::new[u8]();
    let mut ev_block = ChunkSeq::new[u32]();
    ev_enter.push(1);
    ev_block.push(g.entry);
    loop {
        let depth = ev_block.len();
        if depth == 0 {
            break;
        }
        let top = wrapping_sub(depth, 1);
        let enter = match ev_enter.try_get(top) {
            Option::Some(v) => v,
            Option::None => 0,
        };
        let blk = u32_at(in ev_block, top);
        ev_enter.truncate(top);
        ev_block.truncate(top);
        if enter == 0 {
            g.post.push(blk);
            continue;
        }
        if visited_at(in visited, blk) {
            continue;
        }
        let ok = visited.try_set(w(blk), 1);
        ev_enter.push(0);
        ev_block.push(blk);
        // Successors go on in reverse, so the first is entered first.
        let mut k = g.nsuccs(blk);
        loop {
            if k == 0 {
                break;
            }
            k = wrapping_sub(k, 1);
            let succ = g.succ_at(blk, k);
            if !visited_at(in visited, succ) {
                ev_enter.push(1);
                ev_block.push(succ);
            }
        }
    }
}

// Immediate dominators (Cooper, Harvey and Kennedy; the tree is unique, so
// it is Semi-NCA's).
fn dominators(inout g: Graph) {
    put(inout g.idom, w(g.entry), g.entry);
    let mut changed = true;
    loop {
        if !changed {
            break;
        }
        changed = false;
        for q in 1..g.post.len() {
            let blk = g.rpo_block(q);
            let mut new_idom = NONE;
            for k in 0..g.npreds(blk) {
                let pred = g.pred_block(blk, k);
                if !g.reachable(pred) || u32_at(in g.idom, w(pred)) == NONE {
                    continue;
                }
                if new_idom == NONE {
                    new_idom = pred;
                } else {
                    new_idom = intersect(in g, pred, new_idom);
                }
            }
            if new_idom != u32_at(in g.idom, w(blk)) {
                put(inout g.idom, w(blk), new_idom);
                changed = true;
            }
        }
    }
}

// Loop headers, in reverse post-order: blocks that dominate a predecessor.
fn loop_headers(inout g: Graph) {
    for q in 0..g.post.len() {
        let blk = g.rpo_block(q);
        let mut is_header = false;
        for k in 0..g.npreds(blk) {
            if g.dominates(blk, g.pred_block(blk, k)) {
                is_header = true;
            }
        }
        if is_header {
            let lp = wrapping_u32(g.loop_header.len());
            g.loop_header.push(blk);
            g.loop_parent.push(NONE);
            put(inout g.loop_of, w(blk), lp);
        }
    }
}

// Each loop's blocks and parent, the last loop first: walk back from the
// header's back edges, claiming blocks in no loop yet and nesting the
// outermost loop of a claimed block under this one.
fn loop_blocks(inout g: Graph) {
    let mut stack = ChunkSeq::new[u32]();
    let mut remaining = g.loop_header.len();
    loop {
        if remaining == 0 {
            break;
        }
        remaining = wrapping_sub(remaining, 1);
        let lp = wrapping_u32(remaining);
        let head = g.header(lp);
        for k in 0..g.npreds(head) {
            let pred = g.pred_block(head, k);
            if g.dominates(head, pred) {
                stack.push(pred);
            }
        }
        loop {
            let depth = stack.len();
            if depth == 0 {
                break;
            }
            let node = u32_at(in stack, wrapping_sub(depth, 1));
            stack.truncate(wrapping_sub(depth, 1));
            // The block whose predecessors the walk continues from.
            let mut continue_from = NONE;
            let inner = g.innermost(node);
            if inner == NONE {
                put(inout g.loop_of, w(node), lp);
                continue_from = node;
            } else {
                let mut outer = inner;
                let mut outer_parent = g.parent(outer);
                loop {
                    if outer_parent == NONE {
                        break;
                    }
                    if outer_parent == lp {
                        break;
                    }
                    outer = outer_parent;
                    outer_parent = g.parent(outer);
                }
                if outer_parent == NONE {
                    if outer != lp {
                        put(inout g.loop_parent, w(outer), lp);
                        continue_from = g.header(outer);
                    }
                }
            }
            if continue_from != NONE {
                for k in 0..g.npreds(continue_from) {
                    stack.push(g.pred_block(continue_from, k));
                }
            }
        }
    }
}

// Sorts the edge indices `order` by their branch number (stable insertion
// sort).
fn sort_by_inst(inout order: ChunkSeq[u64], in inst: ChunkSeq[u32]) {
    for i in 1..order.len() {
        let edge = u64_at(in order, i);
        let key = u32_at(in inst, edge);
        let mut hole = i;
        loop {
            if hole == 0 {
                break;
            }
            let before = u64_at(in order, wrapping_sub(hole, 1));
            if u32_at(in inst, before) <= key {
                break;
            }
            let ok = order.try_set(hole, before);
            hole = wrapping_sub(hole, 1);
        }
        let ok = order.try_set(hole, edge);
    }
}
