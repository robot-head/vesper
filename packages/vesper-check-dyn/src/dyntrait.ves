// `src/dyn_trait.rs` in Vesper: `uses_dyn` and `lower`, which turns every
// `p: dyn Trait[args]` parameter into a hidden type parameter `__dyn__p`
// bounded by `Trait[args]`, checks that `dyn` appears nowhere else, that
// every object trait is object safe (E0630), and that no `dyn` value
// escapes syntactically (E0631, E0632). Its outputs are the rewritten
// module and the `params`, `forwards` and `boxed` tables of `Lowered`.

use @vesper/ast::{ParamNode, FnNode, TraitRefNode, StmtNode};
use @vesper/check-data::types::{Vars, vars_new, substitute_row};
use self::core::{
    D, w, n32, inc, u32_at, u64_at, table_get, table_set, contains, ll, la, mk_list, list_words, ex,
    pt, ty, named, new_generic, new_bound, stmt_at, arg_at, clause_at, param_at, set_param,
    effects_at, effect_at, generic_at, field_at, variant_at, adt_at, fn_at, set_fn, effect_decl_at,
    impl_at, trait_at, assoc_at, conf_at, item_at, intern_buf, buf_sym, nsym, tid, rid, type_name,
    object_trait, boxed_traits, mentions_dyn, mentions_bare_dyn, mentions_name, fn_types,
    pattern_names, without, diag_open, diag_close, dput, dsym, dtype, diag_text, display_into
};

const NONE: u32 = 4294967295;

// ---------------------------------------------------------------- uses_dyn

fn fn_mentions_dyn(inout ctx: D, func: u32) -> bool {
    let mut type_spans = ChunkSeq::new[u32]();
    fn_types(in ctx, func, false, inout type_spans);
    let n = type_spans.len() / 3;
    for i in 0..n {
        if mentions_dyn(in ctx, u32_at(in type_spans, wrapping_mul(i, 3))) {
            return true;
        }
    }
    false
}

fn fns_mention_dyn(inout ctx: D, list: u32) -> bool {
    for i in 0..ll(in ctx, list) {
        if fn_mentions_dyn(inout ctx, la(in ctx, list, i)) {
            return true;
        }
    }
    false
}

fn adt_mentions(in ctx: D, adt: u32, bare: bool) -> bool {
    let adt_row = adt_at(in ctx, adt);
    for i in 0..ll(in ctx, adt_row.variants) {
        let variant = variant_at(in ctx, la(in ctx, adt_row.variants, i));
        for j in 0..ll(in ctx, variant.fields) {
            let field = field_at(in ctx, la(in ctx, variant.fields, j));
            if mentions_name(in ctx, field.ty, ctx.known.dyn_, bare) {
                return true;
            }
        }
    }
    false
}

// `dyn_trait::uses_dyn`: whether the module writes `dyn` anywhere.
pub fn uses_dyn(inout ctx: D) -> bool {
    for i in 0..ctx.ast.m_items.len() {
        let item = item_at(in ctx, u32_at(in ctx.ast.m_items, i));
        let node = item.node;
        let found = if item.kind == 2 {
            fn_mentions_dyn(inout ctx, node)
        } else if item.kind == 4 {
            let impl_ = impl_at(in ctx, node);
            mentions_dyn(in ctx, impl_.ty) || fns_mention_dyn(inout ctx, impl_.methods)
        } else if item.kind == 5 {
            fns_mention_dyn(inout ctx, trait_at(in ctx, node).methods)
        } else if item.kind == 6 {
            let conf = conf_at(in ctx, node);
            fns_mention_dyn(inout ctx, conf.methods) || mentions_dyn(in ctx, conf.self_ty)
        } else if item.kind == 3 {
            fns_mention_dyn(inout ctx, effect_decl_at(in ctx, node).ops)
        } else if item.kind == 1 {
            adt_mentions(in ctx, node, false)
        } else {
            false
        };
        if found {
            return true;
        }
    }
    false
}

// ---------------------------------------------------------------- object safety

// The FNV-1a hash of the `Display` text of type `ast_ty` (`checked_objects`
// holds `tr.to_string()`).
fn display_hash(inout ctx: D, ast_ty: u32) -> u64 {
    ctx.scratch.clear();
    let mut text = ChunkSeq::new[u8]();
    display_into(inout ctx, ast_ty, inout text);
    let mut hash: u64 = 14695981039346656037;
    for i in 0..text.len() {
        let byte = text.try_get(i).unwrap_or(0);
        hash = wrapping_mul(hash ^ widen_u64(byte), 1099511628211);
    }
    hash
}

// `checked.insert(tr.to_string())`.
fn check_once(inout ctx: D, trait_ty: u32) -> bool {
    let hash = display_hash(inout ctx, trait_ty);
    for i in 0..ctx.checked.len() {
        if u64_at(in ctx.checked, i) == hash {
            return false;
        }
    }
    ctx.checked.push(hash);
    true
}

fn unsafe_open(inout ctx: D, decl: u32) -> (u64, u64) {
    let diag = diag_open(inout ctx, in "E0630");
    dput(inout ctx, in "trait '");
    dsym(inout ctx, trait_at(in ctx, decl).name);
    dput(inout ctx, in "' is not object safe: ");
    diag
}

fn method_unsafe(inout ctx: D, decl: u32, method_name: u32, in why: Str, start: u32, end: u32) {
    let diag = unsafe_open(inout ctx, decl);
    dput(inout ctx, in "method '");
    dsym(inout ctx, method_name);
    dput(inout ctx, in why);
    diag_close(inout ctx, diag, start, end);
}

fn mentions_self(in ctx: D, ast_ty: u32) -> bool {
    mentions_name(in ctx, ast_ty, ctx.known.self_ty, false)
}

// `object_safety`: the rules of the module docs for trait `decl` used at
// trait arguments `args` (a list of types).
fn object_safety(inout ctx: D, decl: u32, args: u32, start: u32, end: u32) {
    let trait_ = trait_at(in ctx, decl);
    if ll(in ctx, trait_.assoc) > 0 {
        let assoc = assoc_at(in ctx, la(in ctx, trait_.assoc, 0));
        let diag = unsafe_open(inout ctx, decl);
        dput(inout ctx, in "it declares the associated type '");
        dsym(inout ctx, assoc.name);
        dput(inout ctx, in "'");
        diag_close(inout ctx, diag, start, end);
    }
    let mut vars = vars_new();
    let generic_count = ll(in ctx, trait_.generics);
    let arg_count = ll(in ctx, args);
    let bound_count = if generic_count < arg_count {
        generic_count
    } else {
        arg_count
    };
    for i in 0..bound_count {
        let generic = generic_at(in ctx, la(in ctx, trait_.generics, i));
        let name_sym = nsym(inout ctx, generic.name);
        let arg_id = tid(inout ctx, la(in ctx, args, i));
        vars.set(name_sym, arg_id);
    }
    for i in 0..ll(in ctx, trait_.methods) {
        let method = fn_at(in ctx, la(in ctx, trait_.methods, i));
        if ll(in ctx, method.generics) > 0 {
            method_unsafe(inout ctx, decl, method.name, in "' has type parameters", start, end);
        }
        let mut has_self = false;
        if ll(in ctx, method.params) > 0 {
            let receiver = param_at(in ctx, la(in ctx, method.params, 0));
            // Every `Pass` is `in`, `inout` or `sink`: no `out self`.
            has_self = receiver.name == ctx.known.self_;
        }
        if !has_self {
            method_unsafe(inout ctx, decl, method.name, in "' has no `self` receiver", start, end);
        }
        let mut by_self = false;
        for j in 1..ll(in ctx, method.params) {
            if mentions_self(in ctx, param_at(in ctx, la(in ctx, method.params, j)).ty) {
                by_self = true;
            }
        }
        if mentions_self(in ctx, method.result) {
            by_self = true;
        }
        let effects_row = effects_at(in ctx, method.effects);
        for j in 0..ll(in ctx, effects_row.instances) {
            let effect = effect_at(in ctx, la(in ctx, effects_row.instances, j));
            for arg_index in 0..ll(in ctx, effect.args) {
                if mentions_self(in ctx, la(in ctx, effect.args, arg_index)) {
                    by_self = true;
                }
            }
        }
        if by_self {
            method_unsafe(
                inout ctx,
                decl,
                method.name,
                in "' mentions `Self` outside its receiver",
                start,
                end
            );
        }
        let row_id = rid(inout ctx, method.effects);
        let substituted = substitute_row(inout ctx.types, row_id, in vars);
        if ctx.types.row(substituted).tail != 0 {
            method_unsafe(inout ctx, decl, method.name, in "' has an open effect row", start, end);
        }
    }
}

// A trait type found anywhere (`lower`'s first pass): object-safety
// checked once per Display text, and its name recorded in `boxed`.
fn found_trait(inout ctx: D, trait_ty: u32, start: u32, end: u32) {
    let node = ty(in ctx, trait_ty);
    if node.kind != 1 {
        return;
    }
    let decl = table_get(in ctx.trait_by_name, node.a);
    if decl == 0 {
        return;
    }
    if check_once(inout ctx, trait_ty) {
        object_safety(inout ctx, wrapping_sub(decl, 1), node.b, start, end);
    }
    ctx.boxed.push(node.a);
}

fn found_in(inout ctx: D, in type_spans: ChunkSeq[u32]) {
    let n = type_spans.len() / 3;
    for i in 0..n {
        let ast_ty = u32_at(in type_spans, wrapping_mul(i, 3));
        let start = u32_at(in type_spans, inc(wrapping_mul(i, 3)));
        let end = u32_at(in type_spans, wrapping_add(wrapping_mul(i, 3), 2));
        let mut traits = ChunkSeq::new[u32]();
        let object = object_trait(in ctx, ast_ty);
        if object != NONE {
            traits.push(object);
        }
        boxed_traits(in ctx, ast_ty, inout traits);
        for j in 0..traits.len() {
            found_trait(inout ctx, u32_at(in traits, j), start, end);
        }
    }
}

fn found_fns(inout ctx: D, list: u32) {
    for i in 0..ll(in ctx, list) {
        let mut type_spans = ChunkSeq::new[u32]();
        fn_types(in ctx, la(in ctx, list, i), false, inout type_spans);
        found_in(inout ctx, in type_spans);
    }
}

// ---------------------------------------------------------------- escapes

fn second_class_name(inout ctx: D, name: u32, start: u32, end: u32) {
    let diag = diag_open(inout ctx, in "E0631");
    dput(inout ctx, in "the `dyn` parameter '");
    dsym(inout ctx, name);
    dput(
        inout ctx,
        in "' is second-class: use it only as a method receiver or as the argument of another `dyn` parameter (it cannot be bound, stored, returned or captured)"
    );
    diag_close(inout ctx, diag, start, end);
}

fn is_live(in ctx: D, expr: u32, in live: ChunkSeq[u32]) -> bool {
    let node = ex(in ctx, expr);
    node.kind == 2 && contains(in live, node.a)
}

// A forward: the parameter, the call's span, the callee (1 a name, 2 a
// method with its base's span), the argument index and span.
fn push_forward(
    inout ctx: D,
    name: u32,
    call: u32,
    callee_kind: u64,
    callee: u32,
    base_start: u32,
    base_end: u32,
    index: u64,
    arg: u32
) {
    let call_node = ex(in ctx, call);
    let arg_node = ex(in ctx, arg);
    ctx.forwards.push(w(name));
    ctx.forwards.push(w(call_node.start));
    ctx.forwards.push(w(call_node.end));
    ctx.forwards.push(callee_kind);
    ctx.forwards.push(w(callee));
    ctx.forwards.push(w(base_start));
    ctx.forwards.push(w(base_end));
    ctx.forwards.push(index);
    ctx.forwards.push(w(arg_node.start));
    ctx.forwards.push(w(arg_node.end));
}

fn esc_opt(inout ctx: D, expr: u32, in live: ChunkSeq[u32], closure: bool) {
    if expr != NONE {
        escapes(inout ctx, expr, in live, closure);
    }
}

fn bound_by(in ctx: D, pat: u32) -> ChunkSeq[u32] {
    let mut names = ChunkSeq::new[u32]();
    pattern_names(in ctx, pat, inout names);
    names
}

// `escapes`: the syntactic second-class rule over `expr` with the `dyn`
// parameters `live` in scope; `closure` inside a closure or handler.
fn escapes(inout ctx: D, expr: u32, in live: ChunkSeq[u32], closure: bool) {
    if live.len() == 0 {
        return;
    }
    let node = ex(in ctx, expr);
    let kind = node.kind;
    if kind == 2 {
        if contains(in live, node.a) {
            second_class_name(inout ctx, node.a, node.start, node.end);
        }
    } else if kind == 1 {} else if kind == 6 {
        let callee_node = ex(in ctx, node.a);
        let mut callee_kind: u64 = 0;
        let mut callee: u32 = NONE;
        let mut base_start: u32 = 0;
        let mut base_end: u32 = 0;
        if callee_node.kind == 7 {
            if is_live(in ctx, callee_node.a, in live) {
                if closure {
                    escapes(inout ctx, callee_node.a, in live, closure);
                }
            } else {
                escapes(inout ctx, callee_node.a, in live, closure);
            }
            let base = ex(in ctx, callee_node.a);
            callee_kind = 2;
            callee = callee_node.b;
            base_start = base.start;
            base_end = base.end;
        } else if callee_node.kind == 2 {
            callee_kind = 1;
            callee = callee_node.a;
        } else {
            escapes(inout ctx, node.a, in live, closure);
        }
        for i in 0..ll(in ctx, node.c) {
            let arg = arg_at(in ctx, la(in ctx, node.c, i)).expr;
            let arg_node = ex(in ctx, arg);
            if arg_node.kind == 2 && contains(in live, arg_node.a) && callee_kind != 0 && !closure {
                push_forward(
                    inout ctx,
                    arg_node.a,
                    expr,
                    callee_kind,
                    callee,
                    base_start,
                    base_end,
                    i,
                    arg
                );
            } else {
                escapes(inout ctx, arg, in live, closure);
            }
        }
    } else if kind == 5 {
        let empty = ChunkSeq::new[u32]();
        let mut cur = without(in live, in empty);
        for i in 0..ll(in ctx, node.a) {
            let stmt = stmt_at(in ctx, la(in ctx, node.a, i));
            escapes(inout ctx, stmt.value, in cur, closure);
            if stmt.kind == 1 {
                let bound = bound_by(in ctx, stmt.pat);
                cur = without(in cur, in bound);
            }
        }
        esc_opt(inout ctx, node.b, in cur, closure);
    } else if kind == 3 {
        for i in 0..ll(in ctx, node.a) {
            escapes(inout ctx, la(in ctx, node.a, i), in live, closure);
        }
    } else if kind == 4 {
        let len = ll(in ctx, node.b) / 2;
        for i in 0..len {
            escapes(inout ctx, la(in ctx, node.b, inc(wrapping_mul(i, 2))), in live, closure);
        }
    } else if kind == 7 || kind == 9 {
        escapes(inout ctx, node.a, in live, closure);
    } else if kind == 10 {
        escapes(inout ctx, node.b, in live, closure);
    } else if kind == 8 {
        escapes(inout ctx, node.a, in live, closure);
        escapes(inout ctx, node.b, in live, closure);
    } else if kind == 11 || kind == 12 {
        escapes(inout ctx, node.b, in live, closure);
        escapes(inout ctx, node.c, in live, closure);
    } else if kind == 13 {
        escapes(inout ctx, node.a, in live, closure);
        escapes(inout ctx, node.b, in live, closure);
        esc_opt(inout ctx, node.c, in live, closure);
    } else if kind == 14 {
        escapes(inout ctx, node.a, in live, closure);
        let len = ll(in ctx, node.b) / 2;
        for i in 0..len {
            let bound = bound_by(in ctx, la(in ctx, node.b, wrapping_mul(i, 2)));
            let inner = without(in live, in bound);
            escapes(inout ctx, la(in ctx, node.b, inc(wrapping_mul(i, 2))), in inner, closure);
        }
    } else if kind == 15 {
        let mut bound = ChunkSeq::new[u32]();
        for i in 0..ll(in ctx, node.a) {
            bound.push(param_at(in ctx, la(in ctx, node.a, i)).name);
        }
        let inner = without(in live, in bound);
        escapes(inout ctx, node.e, in inner, true);
    } else if kind == 16 {
        if node.b != NONE {
            escapes(inout ctx, node.c, in live, closure);
        }
        escapes(inout ctx, node.d, in live, closure);
        for i in 0..ll(in ctx, node.e) {
            let clause = clause_at(in ctx, la(in ctx, node.e, i));
            let mut bound = ChunkSeq::new[u32]();
            for j in 0..ll(in ctx, clause.pats) {
                pattern_names(in ctx, la(in ctx, clause.pats, j), inout bound);
            }
            let inner = without(in live, in bound);
            escapes(inout ctx, clause.body, in inner, true);
        }
    } else if kind == 18 {
        escapes(inout ctx, node.b, in live, closure);
        let bound = bound_by(in ctx, node.a);
        let inner = without(in live, in bound);
        escapes(inout ctx, node.c, in inner, closure);
    } else if kind == 17 {
        escapes(inout ctx, node.a, in live, closure);
    } else if kind == 19 {
        escapes(inout ctx, node.a, in live, closure);
        escapes(inout ctx, node.b, in live, closure);
    } else if kind == 20 || kind == 21 {
        esc_opt(inout ctx, node.a, in live, closure);
    }
}

// ---------------------------------------------------------------- lowering

// `bare_dyn_type`: the first type written in `func` that mentions `dyn`
// other than as a boxed object or the object `Box::new[dyn Trait](x)`
// boxes; returns (found, start, end).
fn bare_dyn_type(in ctx: D, func: u32) -> (bool, u32, u32) {
    let mut type_spans = ChunkSeq::new[u32]();
    fn_types(in ctx, func, true, inout type_spans);
    let n = type_spans.len() / 3;
    for i in 0..n {
        if mentions_bare_dyn(in ctx, u32_at(in type_spans, wrapping_mul(i, 3))) {
            return (
                true,
                u32_at(in type_spans, inc(wrapping_mul(i, 3))),
                u32_at(in type_spans, wrapping_add(wrapping_mul(i, 3), 2))
            );
        }
    }
    (false, 0, 0)
}

fn elsewhere(inout ctx: D, in what: Str, start: u32, end: u32) {
    let diag = diag_open(inout ctx, in "E0632");
    dput(
        inout ctx,
        in "`dyn Trait` is second-class: it may only be the whole type of an `in`, `inout` or `sink` parameter of a function or inherent method, not "
    );
    dput(inout ctx, in what);
    diag_close(inout ctx, diag, start, end);
}

fn fns_elsewhere(inout ctx: D, list: u32, in what: Str) {
    for i in 0..ll(in ctx, list) {
        let (found, start, end) = bare_dyn_type(in ctx, la(in ctx, list, i));
        if found {
            elsewhere(inout ctx, in what, start, end);
        }
    }
}

// `params.insert(owner, own)`: the rows of an earlier insert of `owner`
// stop counting.
fn insert_params(inout ctx: D, owner: u32, in generics: ChunkSeq[u32], in traits: ChunkSeq[u32]) {
    for i in 0..ctx.param_owner.len() {
        if u32_at(in ctx.param_owner, i) == owner {
            let ok = ctx.param_live.try_set(i, 0);
        }
    }
    for i in 0..generics.len() {
        let generic = u32_at(in generics, i);
        // `own.insert(g, tr)`: a later parameter of the same name wins.
        let mut later = false;
        for j in inc(i)..generics.len() {
            if u32_at(in generics, j) == generic {
                later = true;
            }
        }
        if !later {
            ctx.param_owner.push(owner);
            ctx.param_generic.push(generic);
            ctx.param_trait.push(u32_at(in traits, i));
            ctx.param_live.push(1);
        }
    }
}

// `lower_function`: the `dyn` parameters of function `func` (World name
// `owner`) become hidden bounded type parameters.
fn lower_function(inout ctx: D, func: u32, owner: u32) {
    let fnode = fn_at(in ctx, func);
    let mut names = ChunkSeq::new[u32]();
    let mut own_generics = ChunkSeq::new[u32]();
    let mut own_traits = ChunkSeq::new[u32]();
    let mut generics = list_words(in ctx, fnode.generics);
    let before = generics.len();
    for i in 0..ll(in ctx, fnode.params) {
        let param_index = la(in ctx, fnode.params, i);
        let param = param_at(in ctx, param_index);
        let trait_ty = object_trait(in ctx, param.ty);
        if trait_ty == NONE {
            continue;
        }
        let trait_node = ty(in ctx, trait_ty);
        if trait_node.kind != 1 {
            continue;
        }
        let mut nested = false;
        for j in 0..ll(in ctx, trait_node.b) {
            if mentions_dyn(in ctx, la(in ctx, trait_node.b, j)) {
                nested = true;
            }
        }
        if nested {
            diag_text(
                inout ctx,
                in "E0632",
                in "`dyn Trait` cannot be a trait argument of another `dyn` type",
                param.start,
                param.end
            );
            continue;
        }
        let decl = table_get(in ctx.trait_by_name, trait_node.a);
        if decl != 0 && check_once(inout ctx, trait_ty) {
            object_safety(inout ctx, wrapping_sub(decl, 1), trait_node.b, param.start, param.end);
        }
        ctx.buf.clear();
        ctx.buf.push_str(in "__dyn__");
        buf_sym(inout ctx, param.name);
        let hidden_name = intern_buf(inout ctx);
        // A borrowed object may be linear; a consumed one may be dropped
        // by the callee, so `sink dyn` admits affine types.
        let bound: u8 = if param.pass == 2 { 1 } else { 2 };
        let generic = new_generic(inout ctx, hidden_name, bound);
        generics.push(generic);
        let trait_ref = ctx.ast
            .trait_refs
            .alloc(TraitRefNode {
                package: NONE,
                name: trait_node.a,
                args: trait_node.b,
                start: param.start,
                end: param.end
            })
            .raw();
        let bound_node = new_bound(
            inout ctx,
            hidden_name,
            trait_ref,
            param.start,
            param.end,
            owner
        );
        ctx.ast.m_bounds.push(bound_node);
        let generic_ty = named(inout ctx, hidden_name, 0);
        set_param(
            inout ctx,
            param_index,
            ParamNode {
                name: param.name,
                pass: param.pass,
                projections: param.projections,
                ty: generic_ty,
                start: param.start,
                end: param.end
            }
        );
        names.push(param.name);
        own_generics.push(hidden_name);
        own_traits.push(trait_ty);
    }
    if generics.len() != before {
        let generic_list = mk_list(inout ctx, in generics);
        let cur = fn_at(in ctx, func);
        set_fn(
            inout ctx,
            func,
            FnNode {
                name: cur.name,
                fip: cur.fip,
                generics: generic_list,
                params: cur.params,
                result: cur.result,
                effects: cur.effects,
                body: cur.body,
                start: cur.start,
                end: cur.end
            }
        );
    }
    let (found, start, end) = bare_dyn_type(in ctx, func);
    if found {
        diag_text(
            inout ctx,
            in "E0632",
            in "`dyn Trait` is second-class unless boxed: it may only be the whole type of an `in`, `inout` or `sink` parameter or the argument of `Box[dyn Trait]`, not a result, a `let` annotation, a type argument, a closure parameter or part of another type",
            start,
            end
        );
    }
    if own_generics.len() == 0 {
        return;
    }
    let body = fn_at(in ctx, func).body;
    if body != NONE {
        escapes(inout ctx, body, in names, false);
    }
    insert_params(inout ctx, owner, in own_generics, in own_traits);
}

// `dyn_trait::lower`. Returns whether it succeeded (no diagnostics).
pub fn lower_dyn(inout ctx: D) -> bool {
    let first_diag = ctx.diags.len();
    let item_count = ctx.ast.m_items.len();
    // The traits by name; a later declaration replaces an earlier one.
    for i in 0..item_count {
        let item = item_at(in ctx, u32_at(in ctx.ast.m_items, i));
        if item.kind == 5 {
            let name = trait_at(in ctx, item.node).name;
            table_set(inout ctx.trait_by_name, name, wrapping_add(item.node, 1));
        }
    }
    // Every object and boxed object trait written anywhere.
    for i in 0..item_count {
        let item = item_at(in ctx, u32_at(in ctx.ast.m_items, i));
        let node = item.node;
        if item.kind == 2 {
            let mut type_spans = ChunkSeq::new[u32]();
            fn_types(in ctx, node, false, inout type_spans);
            found_in(inout ctx, in type_spans);
        } else if item.kind == 4 {
            found_fns(inout ctx, impl_at(in ctx, node).methods);
        } else if item.kind == 5 {
            found_fns(inout ctx, trait_at(in ctx, node).methods);
        } else if item.kind == 6 {
            found_fns(inout ctx, conf_at(in ctx, node).methods);
        } else if item.kind == 3 {
            found_fns(inout ctx, effect_decl_at(in ctx, node).ops);
        } else if item.kind == 1 {
            let adt = adt_at(in ctx, node);
            let mut type_spans = ChunkSeq::new[u32]();
            for j in 0..ll(in ctx, adt.variants) {
                let variant = variant_at(in ctx, la(in ctx, adt.variants, j));
                for field_index in 0..ll(in ctx, variant.fields) {
                    let field = field_at(in ctx, la(in ctx, variant.fields, field_index));
                    type_spans.push(field.ty);
                    type_spans.push(adt.start);
                    type_spans.push(adt.end);
                }
            }
            found_in(inout ctx, in type_spans);
        }
    }
    for i in 0..item_count {
        let item = item_at(in ctx, u32_at(in ctx.ast.m_items, i));
        let node = item.node;
        if item.kind == 2 {
            let owner = fn_at(in ctx, node).name;
            lower_function(inout ctx, node, owner);
        } else if item.kind == 4 {
            let impl_ = impl_at(in ctx, node);
            if mentions_dyn(in ctx, impl_.ty) {
                elsewhere(inout ctx, in "an impl self type", 0, 0);
            }
            let head = type_name(in ctx, impl_.ty);
            for j in 0..ll(in ctx, impl_.methods) {
                let func = la(in ctx, impl_.methods, j);
                ctx.buf.clear();
                buf_sym(inout ctx, head);
                ctx.buf.push_str(in "::");
                buf_sym(inout ctx, fn_at(in ctx, func).name);
                let owner = intern_buf(inout ctx);
                lower_function(inout ctx, func, owner);
            }
        } else if item.kind == 5 {
            fns_elsewhere(
                inout ctx,
                trait_at(in ctx, node).methods,
                in "in a trait method signature"
            );
        } else if item.kind == 6 {
            let conf = conf_at(in ctx, node);
            if mentions_dyn(in ctx, conf.self_ty) {
                elsewhere(inout ctx, in "a conformance self type", conf.start, conf.end);
            }
            fns_elsewhere(inout ctx, conf.methods, in "in a conformance method");
        } else if item.kind == 3 {
            fns_elsewhere(inout ctx, effect_decl_at(in ctx, node).ops, in "in an effect operation");
        } else if item.kind == 1 {
            let adt = adt_at(in ctx, node);
            for j in 0..ll(in ctx, adt.variants) {
                let variant = variant_at(in ctx, la(in ctx, adt.variants, j));
                for field_index in 0..ll(in ctx, variant.fields) {
                    let field = field_at(in ctx, la(in ctx, variant.fields, field_index));
                    if mentions_bare_dyn(in ctx, field.ty) {
                        elsewhere(inout ctx, in "the type of a field", adt.start, adt.end);
                    }
                }
            }
        }
    }
    ctx.diags.len() == first_diag
}
