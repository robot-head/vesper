// @vesper/check-dyn: `src/dyn_fn.rs` and `src/dyn_trait.rs` in Vesper
// (self-hosting wave SH2, lane 11, #1183). Both are syntactic passes over
// the surface AST that run before type checking, as in
// `pact_frontend::check_package_with`:
//
// - fnobj.ves (`dyn_fn`): function objects become hidden one-method
//   traits; closures written where one is expected become hidden structs
//   and conformances.
// - dyntrait.ves (`dyn_trait`): `dyn Trait` parameters become hidden
//   bounded type parameters, with the second-class and object-safety
//   checks.
// - core.ves: the state, AST node helpers, types as hash-consed
//   @vesper/check-data ids, the type walker and `free_names`.
//
// The tree is @vesper/ast's (a module parsed by the Vesper front end),
// names are its interned symbols, types are compared and printed through
// @vesper/check-data's `Types`. Rust stays the default; nothing here
// replaces Rust code.

use @vesper/ast::lower::{lower_source};
use @vesper/ast::dump::{dump_ast};
use @vesper/ast::words::{WordReader, word_reader, read_ast_words, put_ast_words};
use @vesper/check-data::{pack_text};
use @vesper/check-data::util::{put_text_words};
use self::core::{
    D, d_new, w, inc, u32_at, u64_at, u8_at, put, put_u64, put_sym, sym_cmp, sort_syms, display_into
};
use self::fnobj::{uses_fn_objects, lower_fn_objects, relocate};
use self::dyntrait::{uses_dyn, lower_dyn};

const NONE: u32 = 4294967295;

fn put_bool(inout out: ChunkSeq[u8], value: bool) {
    if value {
        out.push(49);
    } else {
        out.push(48);
    }
}

fn put_diags(inout out: ChunkSeq[u8], in ctx: D, from: u64) {
    for i in from..ctx.diags.len() {
        let diag = ctx.diags.row(i);
        put(inout out, in "D ");
        for j in diag.code_a..diag.msg_a {
            out.push(u8_at(in ctx.diags.text, j));
        }
        out.push(32);
        put_u64(inout out, diag.start);
        out.push(32);
        put_u64(inout out, diag.stop);
        out.push(32);
        for j in diag.msg_a..diag.msg_b {
            out.push(u8_at(in ctx.diags.text, j));
        }
        out.push(10);
    }
}

fn put_span_line(inout out: ChunkSeq[u8], in tag: Str, key: u64, start: u64, end: u64) {
    put(inout out, in tag);
    out.push(32);
    put_u64(inout out, key);
    out.push(32);
    put_u64(inout out, start);
    out.push(32);
    put_u64(inout out, end);
    out.push(10);
}

// The origins table, then `relocate` at probe spans: just below the
// synthetic range, each origin's first span and the one after it, and the
// end of the range.
fn put_origins(inout out: ChunkSeq[u8], in ctx: D) {
    let n = ctx.origins.len() / 3;
    put(inout out, in "origins ");
    put_u64(inout out, ctx.base);
    out.push(32);
    put_u64(inout out, ctx.next_span);
    out.push(32);
    put_u64(inout out, n);
    out.push(10);
    for i in 0..n {
        let at = wrapping_mul(i, 3);
        put_span_line(
            inout out,
            in "O",
            u64_at(in ctx.origins, at),
            u64_at(in ctx.origins, inc(at)),
            u64_at(in ctx.origins, wrapping_add(at, 2))
        );
    }
    let mut probes = ChunkSeq::new[u64]();
    if ctx.base > 0 {
        probes.push(wrapping_sub(ctx.base, 1));
    }
    probes.push(ctx.base);
    for i in 0..n {
        let synth_start = u64_at(in ctx.origins, wrapping_mul(i, 3));
        probes.push(synth_start);
        probes.push(inc(synth_start));
    }
    probes.push(ctx.next_span);
    for i in 0..probes.len() {
        let probe = u64_at(in probes, i);
        let (start, end) = relocate(in ctx, probe, inc(probe));
        put_span_line(inout out, in "R", probe, start, end);
    }
}

// The `params` rows in (owner, generic) text order.
fn put_params(inout out: ChunkSeq[u8], inout ctx: D) {
    let mut rows = ChunkSeq::new[u64]();
    for i in 0..ctx.param_owner.len() {
        if u8_at(in ctx.param_live, i) == 1 {
            rows.push(i);
        }
    }
    let n = rows.len();
    for i in 1..n {
        let row = u64_at(in rows, i);
        let mut j = i;
        loop {
            if j == 0 {
                break;
            }
            let prev_row = u64_at(in rows, wrapping_sub(j, 1));
            let owner_order = sym_cmp(
                in ctx.ast,
                u32_at(in ctx.param_owner, prev_row),
                u32_at(in ctx.param_owner, row)
            );
            let order = if owner_order != 0 {
                owner_order
            } else {
                sym_cmp(
                    in ctx.ast,
                    u32_at(in ctx.param_generic, prev_row),
                    u32_at(in ctx.param_generic, row)
                )
            };
            if order <= 0 {
                break;
            }
            let ok = rows.try_set(j, prev_row);
            j = wrapping_sub(j, 1);
        }
        let ok = rows.try_set(j, row);
    }
    for i in 0..n {
        let row = u64_at(in rows, i);
        put(inout out, in "P ");
        put_sym(in ctx.ast, inout out, u32_at(in ctx.param_owner, row));
        out.push(32);
        put_sym(in ctx.ast, inout out, u32_at(in ctx.param_generic, row));
        out.push(32);
        display_into(inout ctx, u32_at(in ctx.param_trait, row), inout out);
        out.push(10);
    }
}

fn put_forwards(inout out: ChunkSeq[u8], in ctx: D) {
    let n = ctx.forwards.len() / 10;
    for i in 0..n {
        let at = wrapping_mul(i, 10);
        put(inout out, in "F ");
        put_sym(in ctx.ast, inout out, wrapping_u32(u64_at(in ctx.forwards, at)));
        for k in 1..3 {
            out.push(32);
            put_u64(inout out, u64_at(in ctx.forwards, wrapping_add(at, k)));
        }
        if u64_at(in ctx.forwards, wrapping_add(at, 3)) == 1 {
            put(inout out, in " N ");
            put_sym(
                in ctx.ast,
                inout out,
                wrapping_u32(u64_at(in ctx.forwards, wrapping_add(at, 4)))
            );
        } else {
            put(inout out, in " M ");
            put_u64(inout out, u64_at(in ctx.forwards, wrapping_add(at, 5)));
            out.push(32);
            put_u64(inout out, u64_at(in ctx.forwards, wrapping_add(at, 6)));
            out.push(32);
            put_sym(
                in ctx.ast,
                inout out,
                wrapping_u32(u64_at(in ctx.forwards, wrapping_add(at, 4)))
            );
        }
        for k in 7..10 {
            out.push(32);
            put_u64(inout out, u64_at(in ctx.forwards, wrapping_add(at, k)));
        }
        out.push(10);
    }
}

fn put_boxed(inout out: ChunkSeq[u8], inout ctx: D) {
    let mut sorted = ChunkSeq::with_capacity[u32](ctx.boxed.len());
    for i in 0..ctx.boxed.len() {
        sorted.push(u32_at(in ctx.boxed, i));
    }
    sort_syms(in ctx.ast, inout sorted);
    for i in 0..sorted.len() {
        put(inout out, in "B ");
        put_sym(in ctx.ast, inout out, u32_at(in sorted, i));
        out.push(10);
    }
}

// Runs both passes over a module as `check_package_with` does and writes
// the outcome: each pass's diagnostics (code, span, message), the origins
// of generated code and `relocate` probes, `params`, `forwards` and
// `boxed`, then the canonical dump of the lowered module. With `force`,
// each pass runs even when its `uses_*` gate says the module needs none
// (more coverage; the passes do not change such a module).
fn run(in source: Str, base: u64, force: bool, inout out: ChunkSeq[u8]) {
    let lowered = lower_source(in source);
    let mut ctx = d_new(lowered.ast, base);
    let uses_fn = uses_fn_objects(in ctx);
    put(inout out, in "fn uses=");
    put_bool(inout out, uses_fn);
    if uses_fn || force {
        let ok = lower_fn_objects(inout ctx);
        put(inout out, in " ok=");
        put_bool(inout out, ok);
        out.push(10);
        put_diags(inout out, in ctx, 0);
        if !ok {
            return;
        }
        put_origins(inout out, in ctx);
    } else {
        out.push(10);
    }
    let first_diag = ctx.diags.len();
    let uses = uses_dyn(inout ctx);
    put(inout out, in "dyn uses=");
    put_bool(inout out, uses);
    if uses || force {
        let ok = lower_dyn(inout ctx);
        put(inout out, in " ok=");
        put_bool(inout out, ok);
        out.push(10);
        put_diags(inout out, in ctx, first_diag);
        if !ok {
            return;
        }
        put_params(inout out, inout ctx);
        put_forwards(inout out, in ctx);
        put_boxed(inout out, inout ctx);
    } else {
        out.push(10);
    }
    dump_ast(in ctx.ast, inout out);
}

// The harness entry: `source` with the dyn_fn span base (`serde_json`'s
// length of the parsed module plus 1,000,000, computed by the caller) and
// flags (bit 0: force both passes). Returns `pack_text` of the outcome.
pub fn check_dyn(in source: Str, base: u64, flags: u64) -> ChunkSeq[u64] {
    let mut out = ChunkSeq::new[u8]();
    run(in source, base, (flags & 1) == 1, inout out);
    pack_text(in out)
}

// Runs both passes and returns a digest of the outcome's length, for
// benchmarks (no dump, no text).
pub fn check_dyn_count(in source: Str, base: u64, flags: u64) -> u64 {
    let lowered = lower_source(in source);
    let mut ctx = d_new(lowered.ast, base);
    let force = (flags & 1) == 1;
    if uses_fn_objects(in ctx) || force {
        if !lower_fn_objects(inout ctx) {
            return ctx.diags.len();
        }
    }
    if uses_dyn(inout ctx) || force {
        let ok = lower_dyn(inout ctx);
    }
    wrapping_add(wrapping_add(ctx.diags.len(), ctx.ast.exprs.len()), ctx.origins.len())
}

// ------------------------------------------------- the hybrid swap (#1976)
//
// The hybrid's `dyn_fn::lower` and `dyn_trait::lower` swaps send the
// module the Rust checker holds as the `ast` section of the `parse_words`
// stream (tests/common/ast_words.rs) and read back the outcome:
//
//   ok                     1 when the pass lowered the module, else 0
//   diagnostics            count, then per diagnostic its code, message,
//                          span start and end, help and related labels
//                          (count, then start, end and message each), the
//                          texts as `put_text_words` (check_words.rs
//                          `decode_diagnostics` reads this)
//   when ok:
//     ast                  the lowered module's `ast` section
//     dyn_fn               end of the synthetic spans, the origin count,
//                          then (first synthetic start, origin start,
//                          origin end) per origin
//     dyn_trait            the live `params` rows (owner symbol, hidden
//                          generic symbol), the forwards (ten words each,
//                          `push_forward`), then the boxed trait symbols
//                          sorted and deduplicated, each a count first
//
// Symbols index the names of the lowered `ast` section.

fn put_diag_words(inout out: ChunkSeq[u64], in ctx: D, from: u64) {
    out.push(wrapping_sub(ctx.diags.len(), from));
    for i in from..ctx.diags.len() {
        let diag = ctx.diags.row(i);
        put_text_words(inout out, in ctx.diags.text[diag.code_a..diag.msg_a]);
        put_text_words(inout out, in ctx.diags.text[diag.msg_a..diag.msg_b]);
        out.push(diag.start);
        out.push(diag.stop);
        put_text_words(inout out, in ctx.diags.text[diag.help_a..diag.end]);
        out.push(widen_u64(diag.rn));
        for k in 0..widen_u64(diag.rn) {
            match ctx.diags.rel.try_get(wrapping_add(widen_u64(diag.ra), k)) {
                Option::Some(label) => {
                    out.push(label.start);
                    out.push(label.stop);
                    put_text_words(inout out, in ctx.diags.text[label.a..label.b]);
                },
                Option::None => {
                    out.push(0);
                    out.push(0);
                    out.push(0);
                },
            }
        }
    }
}

fn read_input(in input: Slice[u8], base: u64) -> D {
    let mut reader = word_reader();
    let ast = read_ast_words(inout reader, in input);
    d_new(ast, base)
}

// `dyn_fn::lower` of the module in `input` with span base `base`.
pub fn dyn_fn_bytes(in input: Slice[u8], base: u64) -> ChunkSeq[u64] {
    let mut ctx = read_input(in input, base);
    let ok = lower_fn_objects(inout ctx);
    let mut out = ChunkSeq::new[u64]();
    out.push(if ok { 1 } else { 0 });
    put_diag_words(inout out, in ctx, 0);
    if !ok {
        return out;
    }
    out.reserve(wrapping_add(wrapping_mul(ctx.ast.exprs.len(), 8), 1024));
    put_ast_words(inout out, in ctx.ast);
    out.push(ctx.next_span);
    let n = ctx.origins.len() / 3;
    out.push(n);
    for i in 0..ctx.origins.len() {
        out.push(u64_at(in ctx.origins, i));
    }
    out
}

// `dyn_trait::lower` of the module in `input`.
pub fn dyn_trait_bytes(in input: Slice[u8]) -> ChunkSeq[u64] {
    let mut ctx = read_input(in input, 0);
    let ok = lower_dyn(inout ctx);
    let mut out = ChunkSeq::new[u64]();
    out.push(if ok { 1 } else { 0 });
    put_diag_words(inout out, in ctx, 0);
    if !ok {
        return out;
    }
    out.reserve(wrapping_add(wrapping_mul(ctx.ast.exprs.len(), 8), 1024));
    put_ast_words(inout out, in ctx.ast);
    let mut live: u64 = 0;
    for i in 0..ctx.param_owner.len() {
        if u8_at(in ctx.param_live, i) == 1 {
            live = inc(live);
        }
    }
    out.push(live);
    for i in 0..ctx.param_owner.len() {
        if u8_at(in ctx.param_live, i) == 1 {
            out.push(w(u32_at(in ctx.param_owner, i)));
            out.push(w(u32_at(in ctx.param_generic, i)));
        }
    }
    out.push(ctx.forwards.len() / 10);
    for i in 0..ctx.forwards.len() {
        out.push(u64_at(in ctx.forwards, i));
    }
    let mut sorted = ChunkSeq::with_capacity[u32](ctx.boxed.len());
    for i in 0..ctx.boxed.len() {
        sorted.push(u32_at(in ctx.boxed, i));
    }
    // `sort_syms` also drops repeats.
    sort_syms(in ctx.ast, inout sorted);
    out.push(sorted.len());
    for i in 0..sorted.len() {
        out.push(w(u32_at(in sorted, i)));
    }
    out
}

// The harness entries: the same, with the words as a string's bytes.
pub fn dyn_fn_words(in input: Str, base: u64) -> ChunkSeq[u64] {
    dyn_fn_bytes(in input.as_bytes(), base)
}

pub fn dyn_trait_words(in input: Str) -> ChunkSeq[u64] {
    dyn_trait_bytes(in input.as_bytes())
}
