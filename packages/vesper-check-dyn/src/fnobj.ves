// `src/dyn_fn.rs` in Vesper: function objects (`dyn Fn(A) -> R eff E`,
// `dyn FnMut`, `dyn FnOnce`) become hidden one-method traits, and each
// closure literal written where a function object is expected becomes a
// hidden struct holding its captures plus a conformance whose `call` body
// is the closure's body. The pass is syntactic: it runs before type
// checking and finds expected types from declarations.
//
// Generated code gets synthetic spans from `base` on, two apart, each
// recorded with the source span it stands for (`origins`, `relocate`).
// The order spans are taken in is Rust's, so the two trees are equal
// node for node, span for span.

use @vesper/ast::{
    Lit, ExprNode, StmtNode, ParamNode, FnNode, TraitNode, TraitRefNode, ConfNode, AdtNode,
    VariantNode, FieldNode, ImplNode, EffectsNode, EffectNode
};
use @vesper/check-data::types::{debug_type, debug_row};
use self::core::{
    D, w, n32, inc, u32_at, u64_at, u8_at, table_get, table_set, contains, ll, la, mk_list, list1,
    list_words, ex, set_ex, new_ex, exn, pt, new_pat, ty, new_type, named, stmt_at, set_stmt,
    new_stmt, arg_at, clause_at, param_at, set_param, new_param, effects_at, new_effects, effect_at,
    new_effect, field_at, set_field, variant_at, adt_at, fn_at, set_fn, effect_decl_at, impl_at,
    set_impl, trait_at, trait_ref_at, set_trait_ref, conf_at, set_conf, item_at, new_item,
    intern_buf, buf_sym, buf_decimal, sym_cmp, sort_syms, generic_at, sym_len, sym_byte,
    sym_ends_with, tid, rid, teq, effect_eq, is_infer, type_name, fn_sig, fn_kind, boxed_fn_sig,
    any_fn_sig, mentions_fn_object, contains_infer, mentions_any, fn_types, pattern_names,
    free_names, diag_open, diag_close, dput, dsym, dtype, ddec
};
use @vesper-std/intern::{symbol_from_id};
use @vesper-std/arena::{idx_from_raw};

const NONE: u32 = 4294967295;

// ---------------------------------------------------------------- uses_fn_objects

fn fn_mentions(in ctx: D, func: u32) -> bool {
    let mut type_spans = ChunkSeq::new[u32]();
    fn_types(in ctx, func, false, inout type_spans);
    let n = type_spans.len() / 3;
    for i in 0..n {
        if mentions_fn_object(in ctx, u32_at(in type_spans, wrapping_mul(i, 3))) {
            return true;
        }
    }
    false
}

fn fns_mention(in ctx: D, list: u32) -> bool {
    for i in 0..ll(in ctx, list) {
        if fn_mentions(in ctx, la(in ctx, list, i)) {
            return true;
        }
    }
    false
}

// `dyn_fn::uses_fn_objects`: whether the module writes a function-object
// type anywhere (`for_each_type`'s positions).
pub fn uses_fn_objects(in ctx: D) -> bool {
    for i in 0..ctx.ast.m_items.len() {
        let item = item_at(in ctx, u32_at(in ctx.ast.m_items, i));
        let node = item.node;
        if item.kind == 1 {
            let adt = adt_at(in ctx, node);
            for j in 0..ll(in ctx, adt.variants) {
                let variant = variant_at(in ctx, la(in ctx, adt.variants, j));
                for field_index in 0..ll(in ctx, variant.fields) {
                    if mentions_fn_object(
                        in ctx,
                        field_at(in ctx, la(in ctx, variant.fields, field_index)).ty
                    ) {
                        return true;
                    }
                }
            }
        } else if item.kind == 2 {
            if fn_mentions(in ctx, node) {
                return true;
            }
        } else if item.kind == 4 {
            let impl_ = impl_at(in ctx, node);
            if mentions_fn_object(in ctx, impl_.ty) || fns_mention(in ctx, impl_.methods) {
                return true;
            }
        } else if item.kind == 5 {
            if fns_mention(in ctx, trait_at(in ctx, node).methods) {
                return true;
            }
        } else if item.kind == 6 {
            let conf = conf_at(in ctx, node);
            if mentions_fn_object(in ctx, conf.self_ty) {
                return true;
            }
            let trait_ref = trait_ref_at(in ctx, conf.trait_ref);
            for j in 0..ll(in ctx, trait_ref.args) {
                if mentions_fn_object(in ctx, la(in ctx, trait_ref.args, j)) {
                    return true;
                }
            }
            if fns_mention(in ctx, conf.methods) {
                return true;
            }
        } else if item.kind == 3 {
            if fns_mention(in ctx, effect_decl_at(in ctx, node).ops) {
                return true;
            }
        }
    }
    false
}

// ---------------------------------------------------------------- Decls

// Adds method `method_name` of type `ty_name` (`insert` when `replace`, else
// `entry().or_insert`).
fn add_method(inout ctx: D, ty_name: u32, method_name: u32, func: u32, replace: bool) {
    let mut link = table_get(in ctx.method_head, method_name);
    loop {
        if link == 0 {
            break;
        }
        let index = w(wrapping_sub(link, 1));
        if u32_at(in ctx.method_owner, index) == ty_name {
            if replace {
                let ok = ctx.method_fn.try_set(index, func);
            }
            return;
        }
        link = u32_at(in ctx.method_next, index);
    }
    let row = n32(ctx.method_owner.len());
    ctx.method_owner.push(ty_name);
    ctx.method_fn.push(func);
    ctx.method_next.push(table_get(in ctx.method_head, method_name));
    table_set(inout ctx.method_head, method_name, wrapping_add(row, 1));
}

// The method `method_name` of type `ty_name`, or NONE.
fn method(in ctx: D, ty_name: u32, method_name: u32) -> u32 {
    let mut link = table_get(in ctx.method_head, method_name);
    loop {
        if link == 0 {
            return NONE;
        }
        let index = w(wrapping_sub(link, 1));
        if u32_at(in ctx.method_owner, index) == ty_name {
            return u32_at(in ctx.method_fn, index);
        }
        link = u32_at(in ctx.method_next, index);
    }
}

// `Decls::of`.
fn decls(inout ctx: D) {
    for i in 0..ctx.ast.m_items.len() {
        let item = item_at(in ctx, u32_at(in ctx.ast.m_items, i));
        let node = item.node;
        if item.kind == 2 {
            table_set(inout ctx.fn_by_name, fn_at(in ctx, node).name, wrapping_add(node, 1));
        } else if item.kind == 4 {
            let impl_ = impl_at(in ctx, node);
            let ty_name = tname(in ctx, impl_.ty);
            for j in 0..ll(in ctx, impl_.methods) {
                let func = la(in ctx, impl_.methods, j);
                add_method(inout ctx, ty_name, fn_at(in ctx, func).name, func, true);
            }
        } else if item.kind == 6 {
            let conf = conf_at(in ctx, node);
            let ty_name = tname(in ctx, conf.self_ty);
            for j in 0..ll(in ctx, conf.methods) {
                let func = la(in ctx, conf.methods, j);
                add_method(inout ctx, ty_name, fn_at(in ctx, func).name, func, false);
            }
        } else if item.kind == 1 {
            let adt = adt_at(in ctx, node);
            if adt.mode == 2 {
                if ctx.linear.len() <= w(adt.name) {
                    ctx.linear.resize(inc(w(adt.name)), 0);
                }
                let ok = ctx.linear.try_set(w(adt.name), 1);
            }
            if !adt.is_enum {
                table_set(inout ctx.adt_by_name, adt.name, wrapping_add(node, 1));
            }
        }
    }
}

// `Type::name` as a symbol: "" for a type that is not Named.
fn tname(in ctx: D, ast_ty: u32) -> u32 {
    let name = type_name(in ctx, ast_ty);
    if name == NONE { ctx.known.empty } else { name }
}

fn is_linear(in ctx: D, name: u32) -> bool {
    if name == NONE {
        return false;
    }
    u8_at(in ctx.linear, w(name)) == 1
}

// The declared type of field `name` of struct `struct_name` (the last field of
// that name), or NONE.
fn field_type(in ctx: D, struct_name: u32, name: u32) -> u32 {
    let adt_entry = table_get(in ctx.adt_by_name, struct_name);
    if adt_entry == 0 {
        return NONE;
    }
    let adt = adt_at(in ctx, wrapping_sub(adt_entry, 1));
    let mut out = NONE;
    for i in 0..ll(in ctx, adt.variants) {
        let variant = variant_at(in ctx, la(in ctx, adt.variants, i));
        for j in 0..ll(in ctx, variant.fields) {
            let field = field_at(in ctx, la(in ctx, variant.fields, j));
            if field.name == name {
                out = field.ty;
            }
        }
    }
    out
}

// ---------------------------------------------------------------- env

fn env_get(in ctx: D, name: u32) -> u32 {
    let mut i = ctx.env_names.len();
    loop {
        if i == 0 {
            return NONE;
        }
        i = wrapping_sub(i, 1);
        if u32_at(in ctx.env_names, i) == name {
            return u32_at(in ctx.env_types, i);
        }
    }
}

fn env_has(in ctx: D, name: u32) -> bool {
    env_get(in ctx, name) != NONE
}

fn env_put(inout ctx: D, name: u32, ast_ty: u32) {
    ctx.env_names.push(name);
    ctx.env_types.push(ast_ty);
}

fn env_mark(in ctx: D) -> u64 {
    ctx.env_names.len()
}

fn env_restore(inout ctx: D, mark: u64) {
    ctx.env_names.truncate(mark);
    ctx.env_types.truncate(mark);
}

// `bind`: a plain binding at `ast_ty`, a tuple element-wise, anything else at
// an unknown type.
fn bind(inout ctx: D, pat: u32, ast_ty: u32) {
    let node = pt(in ctx, pat);
    if node.kind == 2 {
        env_put(inout ctx, node.a, ast_ty);
    } else if node.kind == 4 {
        let ty_node = ty(in ctx, ast_ty);
        for i in 0..ll(in ctx, node.a) {
            let mut elem_ty = ctx.t_infer;
            if ty_node.kind == 2 && i < ll(in ctx, ty_node.a) {
                elem_ty = la(in ctx, ty_node.a, i);
            }
            bind(inout ctx, la(in ctx, node.a, i), elem_ty);
        }
    } else {
        let mut names = ChunkSeq::new[u32]();
        pattern_names(in ctx, pat, inout names);
        for i in 0..names.len() {
            env_put(inout ctx, u32_at(in names, i), ctx.t_infer);
        }
    }
}

// ---------------------------------------------------------------- spans

// `Lowering::span`: the next synthetic span (start..start+1), recorded with the
// current origin.
fn span(inout ctx: D) -> u32 {
    let start = ctx.next_span;
    ctx.next_span = wrapping_add(start, 2);
    ctx.origins.push(start);
    ctx.origins.push(w(ctx.origin_start));
    ctx.origins.push(w(ctx.origin_end));
    n32(start)
}

fn mk_expr(inout ctx: D, kind: u8, a: u32, b: u32) -> u32 {
    let start = span(inout ctx);
    new_ex(inout ctx, exn(kind, start, inc32(start), a, b, NONE))
}

fn inc32(value: u32) -> u32 {
    wrapping_add(value, 1)
}

fn set_origin(inout ctx: D, start: u32, end: u32) {
    ctx.origin_start = start;
    ctx.origin_end = end;
}

// ---------------------------------------------------------------- hidden traits

fn put_pass(inout out: ChunkSeq[u8], pass: u32) {
    if pass == 0 {
        out.extend(in "In".as_bytes());
    } else if pass == 1 {
        out.extend(in "Inout".as_bytes());
    } else {
        out.extend(in "Sink".as_bytes());
    }
}

fn hex_char(nibble: u64) -> u32 {
    if nibble < 10 {
        wrapping_u32(wrapping_add(nibble, 48))
    } else {
        wrapping_u32(wrapping_add(nibble, 87))
    }
}

fn pass_of(kind: u32, in ctx: D) -> u8 {
    if kind == ctx.known.fn_ {
        0
    } else if kind == ctx.known.fn_mut {
        1
    } else {
        2
    }
}

// `hidden_trait`: the hidden trait of function-object `kind` and signature
// `sig` (a Function type), created on first use. Its name hashes the Rust
// `Debug` text of the signature's parameters, result and effects.
fn hidden_trait(inout ctx: D, kind: u32, sig: u32) -> u32 {
    let sig_node = ty(in ctx, sig);
    let mut key = ChunkSeq::new[u8]();
    let ok = put_kind(inout ctx, kind, inout key);
    key.push(124);
    key.push(91);
    let param_count = ll(in ctx, sig_node.a) / 2;
    for i in 0..param_count {
        if i > 0 {
            key.extend(in ", ".as_bytes());
        }
        key.push(40);
        put_pass(inout key, la(in ctx, sig_node.a, wrapping_mul(i, 2)));
        key.extend(in ", ".as_bytes());
        let param_id = tid(inout ctx, la(in ctx, sig_node.a, inc(wrapping_mul(i, 2))));
        debug_type(in ctx.types, in ctx.names, param_id, inout key);
        key.push(41);
    }
    key.push(93);
    key.push(124);
    let result_id = tid(inout ctx, sig_node.b);
    debug_type(in ctx.types, in ctx.names, result_id, inout key);
    key.push(124);
    let row = rid(inout ctx, sig_node.c);
    debug_row(in ctx.types, in ctx.names, row, inout key);
    let mut hash: u64 = 14695981039346656037;
    for i in 0..key.len() {
        hash = wrapping_mul(hash ^ widen_u64(u8_at(in key, i)), 1099511628211);
    }
    ctx.buf.clear();
    ctx.buf.push_str(in "__FnObject");
    buf_sym(inout ctx, kind);
    ctx.buf.push_str(in "_");
    let mut digit: u64 = 16;
    loop {
        if digit == 0 {
            break;
        }
        digit = wrapping_sub(digit, 1);
        ctx.buf.push_char(hex_char(
            wrapping_shr_u64(hash, wrapping_u32(wrapping_mul(digit, 4))) & 15
        ));
    }
    let name = intern_buf(inout ctx);
    if contains(in ctx.trait_names, name) {
        return name;
    }
    let receiver = pass_of(kind, in ctx);
    let mut params = ChunkSeq::new[u32]();
    let self_param = new_param(
        inout ctx,
        ParamNode {
            name: ctx.known.self_,
            pass: receiver,
            projections: 0,
            ty: ctx.t_infer,
            start: 0,
            end: 0
        }
    );
    params.push(self_param);
    for i in 0..param_count {
        ctx.buf.clear();
        ctx.buf.push_str(in "a");
        buf_decimal(inout ctx, i);
        let param_name = intern_buf(inout ctx);
        let param = new_param(
            inout ctx,
            ParamNode {
                name: param_name,
                pass: wrapping_u8(la(in ctx, sig_node.a, wrapping_mul(i, 2))),
                projections: 0,
                ty: la(in ctx, sig_node.a, inc(wrapping_mul(i, 2))),
                start: 0,
                end: 0
            }
        );
        params.push(param);
    }
    let param_list = mk_list(inout ctx, in params);
    let func = ctx.ast
        .fns
        .alloc(FnNode {
            name: ctx.known.call,
            fip: false,
            generics: 0,
            params: param_list,
            result: sig_node.b,
            effects: sig_node.c,
            body: NONE,
            start: 0,
            end: 0
        })
        .raw();
    let method_list = list1(inout ctx, func);
    let trait_node = ctx.ast
        .traits
        .alloc(TraitNode {
            name: name,
            public: false,
            generics: 0,
            assoc: 0,
            methods: method_list,
            start: 0,
            end: 0
        })
        .raw();
    ctx.trait_names.push(name);
    ctx.trait_nodes.push(trait_node);
    name
}

fn put_kind(inout ctx: D, kind: u32, inout out: ChunkSeq[u8]) -> bool {
    let (text_start, text_end) = ctx.ast.names.span(symbol_from_id(kind));
    for i in text_start..text_end {
        match ctx.ast.names.text_byte(i) {
            Option::Some(byte) => out.push(byte),
            Option::None => {},
        }
    }
    true
}

// `erase`: every function-object type in `ast_ty` replaced by its hidden
// trait's object type; returns `ast_ty` itself when nothing changes.
fn erase(inout ctx: D, ast_ty: u32) -> u32 {
    let sig = fn_sig(in ctx, ast_ty);
    if sig != NONE {
        let kind = fn_kind(in ctx, ast_ty);
        let erased_sig = erase_sig(inout ctx, sig);
        let name = hidden_trait(inout ctx, kind, erased_sig);
        let inner = named(inout ctx, name, 0);
        let args = list1(inout ctx, inner);
        return named(inout ctx, ctx.known.dyn_, args);
    }
    let node = ty(in ctx, ast_ty);
    if node.kind == 1 || node.kind == 2 {
        let list = if node.kind == 1 { node.b } else { node.a };
        let len = ll(in ctx, list);
        let mut words = ChunkSeq::with_capacity[u32](len);
        let mut changed = false;
        for i in 0..len {
            let elem = la(in ctx, list, i);
            let erased = erase(inout ctx, elem);
            if erased != elem {
                changed = true;
            }
            words.push(erased);
        }
        if !changed {
            return ast_ty;
        }
        let new_list = mk_list(inout ctx, in words);
        if node.kind == 1 {
            return new_type(inout ctx, 1, node.a, new_list, 0, 0);
        }
        return new_type(inout ctx, 2, new_list, 0, 0, 0);
    }
    if node.kind == 3 {
        return erase_sig(inout ctx, ast_ty);
    }
    ast_ty
}

// A Function type with its parameters and result erased (not its effects).
fn erase_sig(inout ctx: D, ast_ty: u32) -> u32 {
    let node = ty(in ctx, ast_ty);
    let len = ll(in ctx, node.a);
    let mut words = ChunkSeq::with_capacity[u32](len);
    let mut changed = false;
    for i in 0..len {
        let word = la(in ctx, node.a, i);
        if i % 2 == 1 {
            let erased = erase(inout ctx, word);
            if erased != word {
                changed = true;
            }
            words.push(erased);
        } else {
            words.push(word);
        }
    }
    let result = erase(inout ctx, node.b);
    if !changed && result == node.b {
        return ast_ty;
    }
    let new_list = if changed {
        mk_list(inout ctx, in words)
    } else {
        node.a
    };
    new_type(inout ctx, 3, new_list, result, node.c, node.d)
}

fn erase_list(inout ctx: D, list: u32) -> u32 {
    let len = ll(in ctx, list);
    let mut words = ChunkSeq::with_capacity[u32](len);
    let mut changed = false;
    for i in 0..len {
        let elem = la(in ctx, list, i);
        let erased = erase(inout ctx, elem);
        if erased != elem {
            changed = true;
        }
        words.push(erased);
    }
    if changed {
        mk_list(inout ctx, in words)
    } else {
        list
    }
}

fn erase_effect(inout ctx: D, effect: u32) -> u32 {
    let effect_row = effect_at(in ctx, effect);
    let args = erase_list(inout ctx, effect_row.args);
    if args == effect_row.args {
        effect
    } else {
        new_effect(inout ctx, effect_row.label, effect_row.name, args)
    }
}

fn erase_effects(inout ctx: D, effects: u32) -> u32 {
    let effects_row = effects_at(in ctx, effects);
    let len = ll(in ctx, effects_row.instances);
    let mut words = ChunkSeq::with_capacity[u32](len);
    let mut changed = false;
    for i in 0..len {
        let effect = la(in ctx, effects_row.instances, i);
        let erased = erase_effect(inout ctx, effect);
        if erased != effect {
            changed = true;
        }
        words.push(erased);
    }
    if !changed {
        return effects;
    }
    let new_list = mk_list(inout ctx, in words);
    new_effects(inout ctx, new_list, effects_row.tail)
}

fn erase_param(inout ctx: D, param: u32) {
    let param_row = param_at(in ctx, param);
    let erased = erase(inout ctx, param_row.ty);
    if erased != param_row.ty {
        set_param(
            inout ctx,
            param,
            ParamNode {
                name: param_row.name,
                pass: param_row.pass,
                projections: param_row.projections,
                ty: erased,
                start: param_row.start,
                end: param_row.end
            }
        );
    }
}

// `walk_function` with `erase` at every type position.
fn erase_fn(inout ctx: D, func: u32) {
    let fnode = fn_at(in ctx, func);
    for i in 0..ll(in ctx, fnode.params) {
        erase_param(inout ctx, la(in ctx, fnode.params, i));
    }
    let result = erase(inout ctx, fnode.result);
    let effects = erase_effects(inout ctx, fnode.effects);
    if result != fnode.result || effects != fnode.effects {
        let cur = fn_at(in ctx, func);
        set_fn(
            inout ctx,
            func,
            FnNode {
                name: cur.name,
                fip: cur.fip,
                generics: cur.generics,
                params: cur.params,
                result: result,
                effects: effects,
                body: cur.body,
                start: cur.start,
                end: cur.end
            }
        );
    }
    if fnode.body != NONE {
        erase_expr(inout ctx, fnode.body);
    }
}

fn erase_fns(inout ctx: D, list: u32) {
    for i in 0..ll(in ctx, list) {
        erase_fn(inout ctx, la(in ctx, list, i));
    }
}

fn erase_opt(inout ctx: D, expr: u32) {
    if expr != NONE {
        erase_expr(inout ctx, expr);
    }
}

fn erase_expr(inout ctx: D, expr: u32) {
    let node = ex(in ctx, expr);
    let kind = node.kind;
    if kind == 3 {
        for i in 0..ll(in ctx, node.a) {
            erase_expr(inout ctx, la(in ctx, node.a, i));
        }
    } else if kind == 4 {
        let len = ll(in ctx, node.b) / 2;
        for i in 0..len {
            erase_expr(inout ctx, la(in ctx, node.b, inc(wrapping_mul(i, 2))));
        }
    } else if kind == 5 {
        for i in 0..ll(in ctx, node.a) {
            let stmt = la(in ctx, node.a, i);
            let stmt_row = stmt_at(in ctx, stmt);
            if stmt_row.kind == 1 {
                let erased = erase(inout ctx, stmt_row.ty);
                if erased != stmt_row.ty {
                    set_stmt(
                        inout ctx,
                        stmt,
                        StmtNode {
                            kind: stmt_row.kind,
                            pat: stmt_row.pat,
                            ty: erased,
                            value: stmt_row.value,
                            mutable: stmt_row.mutable
                        }
                    );
                }
            }
            erase_expr(inout ctx, stmt_row.value);
        }
        erase_opt(inout ctx, node.b);
    } else if kind == 6 {
        erase_expr(inout ctx, node.a);
        let type_args = erase_list(inout ctx, node.b);
        if type_args != node.b {
            let cur = ex(in ctx, expr);
            set_ex(inout ctx, expr, exn(cur.kind, cur.start, cur.end, cur.a, type_args, cur.c));
        }
        for i in 0..ll(in ctx, node.c) {
            erase_expr(inout ctx, arg_at(in ctx, la(in ctx, node.c, i)).expr);
        }
    } else if kind == 7 || kind == 9 {
        erase_expr(inout ctx, node.a);
    } else if kind == 10 {
        erase_expr(inout ctx, node.b);
    } else if kind == 8 {
        erase_expr(inout ctx, node.a);
        erase_expr(inout ctx, node.b);
    } else if kind == 11 || kind == 12 {
        erase_expr(inout ctx, node.b);
        erase_expr(inout ctx, node.c);
    } else if kind == 13 {
        erase_expr(inout ctx, node.a);
        erase_expr(inout ctx, node.b);
        erase_opt(inout ctx, node.c);
    } else if kind == 14 {
        erase_expr(inout ctx, node.a);
        let len = ll(in ctx, node.b) / 2;
        for i in 0..len {
            erase_expr(inout ctx, la(in ctx, node.b, inc(wrapping_mul(i, 2))));
        }
    } else if kind == 17 {
        erase_expr(inout ctx, node.a);
    } else if kind == 18 {
        erase_expr(inout ctx, node.b);
        erase_expr(inout ctx, node.c);
    } else if kind == 19 {
        erase_expr(inout ctx, node.a);
        erase_expr(inout ctx, node.b);
    } else if kind == 20 || kind == 21 {
        erase_opt(inout ctx, node.a);
    } else if kind == 15 {
        for i in 0..ll(in ctx, node.a) {
            erase_param(inout ctx, la(in ctx, node.a, i));
        }
        let result = erase(inout ctx, node.c);
        let effects = erase_effects(inout ctx, node.d);
        if result != node.c || effects != node.d {
            let cur = ex(in ctx, expr);
            set_ex(
                inout ctx,
                expr,
                ExprNode {
                    kind: cur.kind,
                    start: cur.start,
                    end: cur.end,
                    a: cur.a,
                    b: cur.b,
                    c: result,
                    d: effects,
                    e: cur.e
                }
            );
        }
        erase_expr(inout ctx, node.e);
    } else if kind == 16 {
        let effect = erase_effect(inout ctx, node.a);
        if effect != node.a {
            let cur = ex(in ctx, expr);
            set_ex(
                inout ctx,
                expr,
                ExprNode {
                    kind: cur.kind,
                    start: cur.start,
                    end: cur.end,
                    a: effect,
                    b: cur.b,
                    c: cur.c,
                    d: cur.d,
                    e: cur.e
                }
            );
        }
        if node.b != NONE {
            erase_expr(inout ctx, node.c);
        }
        erase_expr(inout ctx, node.d);
        for i in 0..ll(in ctx, node.e) {
            erase_expr(inout ctx, clause_at(in ctx, la(in ctx, node.e, i)).body);
        }
    }
}

// `for_each_type(module, erase)`.
fn erase_module(inout ctx: D) {
    for i in 0..ctx.ast.m_items.len() {
        let item = item_at(in ctx, u32_at(in ctx.ast.m_items, i));
        let node = item.node;
        if item.kind == 1 {
            let adt = adt_at(in ctx, node);
            for j in 0..ll(in ctx, adt.variants) {
                let variant = variant_at(in ctx, la(in ctx, adt.variants, j));
                for field_index in 0..ll(in ctx, variant.fields) {
                    let field = la(in ctx, variant.fields, field_index);
                    let field_row = field_at(in ctx, field);
                    let erased = erase(inout ctx, field_row.ty);
                    if erased != field_row.ty {
                        set_field(
                            inout ctx,
                            field,
                            FieldNode {
                                name: field_row.name,
                                ty: erased,
                                modality: field_row.modality,
                                temperature: field_row.temperature
                            }
                        );
                    }
                }
            }
        } else if item.kind == 2 {
            erase_fn(inout ctx, node);
        } else if item.kind == 4 {
            let impl_ = impl_at(in ctx, node);
            let erased = erase(inout ctx, impl_.ty);
            if erased != impl_.ty {
                set_impl(
                    inout ctx,
                    node,
                    ImplNode { ty: erased, generics: impl_.generics, methods: impl_.methods }
                );
            }
            erase_fns(inout ctx, impl_.methods);
        } else if item.kind == 5 {
            erase_fns(inout ctx, trait_at(in ctx, node).methods);
        } else if item.kind == 6 {
            let conf = conf_at(in ctx, node);
            let self_ty = erase(inout ctx, conf.self_ty);
            if self_ty != conf.self_ty {
                let cur = conf_at(in ctx, node);
                set_conf(
                    inout ctx,
                    node,
                    ConfNode {
                        model: cur.model,
                        public: cur.public,
                        generics: cur.generics,
                        trait_ref: cur.trait_ref,
                        self_ty: self_ty,
                        wheres: cur.wheres,
                        assoc: cur.assoc,
                        methods: cur.methods,
                        start: cur.start,
                        end: cur.end
                    }
                );
            }
            let trait_ref = trait_ref_at(in ctx, conf.trait_ref);
            let args = erase_list(inout ctx, trait_ref.args);
            if args != trait_ref.args {
                set_trait_ref(
                    inout ctx,
                    conf.trait_ref,
                    TraitRefNode {
                        package: trait_ref.package,
                        name: trait_ref.name,
                        args: args,
                        start: trait_ref.start,
                        end: trait_ref.end
                    }
                );
            }
            erase_fns(inout ctx, conf.methods);
        } else if item.kind == 3 {
            erase_fns(inout ctx, effect_decl_at(in ctx, node).ops);
        }
    }
}

// ---------------------------------------------------------------- syntactic types

// `type_of`: the syntactic type of `expr`, when the pass can tell it, else
// NONE.
fn type_of(in ctx: D, expr: u32) -> u32 {
    let node = ex(in ctx, expr);
    if node.kind == 2 {
        return env_get(in ctx, node.a);
    }
    if node.kind == 7 {
        let base_ty = type_of(in ctx, node.a);
        if base_ty == NONE {
            return NONE;
        }
        return field_type(in ctx, type_name(in ctx, base_ty), node.b);
    }
    if node.kind == 8 {
        let base_ty = type_of(in ctx, node.a);
        if base_ty == NONE {
            return NONE;
        }
        let ty_node = ty(in ctx, base_ty);
        if ty_node.kind == 1 && ll(in ctx, ty_node.b) == 1 {
            return la(in ctx, ty_node.b, 0);
        }
        return NONE;
    }
    NONE
}

// `name.trim_end_matches("::new")` as a symbol.
fn trim_new(inout ctx: D, name: u32) -> u32 {
    let mut len = sym_len(in ctx.ast, name);
    loop {
        if len < 5 {
            break;
        }
        let at = wrapping_sub(len, 5);
        if sym_byte(in ctx.ast, name, at) == 58
            && sym_byte(in ctx.ast, name, inc(at)) == 58
            && sym_byte(in ctx.ast, name, wrapping_add(at, 2)) == 110
            && sym_byte(in ctx.ast, name, wrapping_add(at, 3)) == 101
            && sym_byte(in ctx.ast, name, wrapping_add(at, 4)) == 119
        {
            len = at;
        } else {
            break;
        }
    }
    ctx.buf.clear();
    for i in 0..len {
        ctx.buf.push_char(widen_u32(sym_byte(in ctx.ast, name, i)));
    }
    intern_buf(inout ctx)
}

// `infer`: the type a `let` without an annotation binds, when evident
// (`Type::Infer` otherwise).
fn infer(inout ctx: D, expr: u32) -> u32 {
    let node = ex(in ctx, expr);
    if node.kind == 1 {
        let lit = ctx.ast
            .lits
            .get_or(idx_from_raw[Lit](node.a), Lit { kind: 0, neg: false, bits: 0, hi: 0 });
        if lit.kind == 1 {
            return ctx.t_i64;
        }
        // A literal past `i128::MAX` (`Literal::WideInt`): not evident.
        if lit.kind == 5 {
            return ctx.t_infer;
        }
        if lit.kind == 3 {
            return ctx.t_bool;
        }
        if lit.kind == 2 {
            return ctx.t_f64;
        }
        return ctx.t_string;
    }
    if node.kind == 4 {
        if table_get(in ctx.adt_by_name, node.a) != 0 {
            return named(inout ctx, node.a, 0);
        }
        return ctx.t_infer;
    }
    if node.kind == 6 {
        let callee = ex(in ctx, node.a);
        if callee.kind != 2 {
            return ctx.t_infer;
        }
        let name = callee.a;
        let type_arg_count = ll(in ctx, node.b);
        if name == ctx.known.box_new && type_arg_count == 1 {
            return named(inout ctx, ctx.known.box_, node.b);
        }
        if type_arg_count == 1 && sym_ends_with(in ctx.ast, name, in "::new") {
            let head = trim_new(inout ctx, name);
            return named(inout ctx, head, node.b);
        }
        if !env_has(in ctx, name) {
            let fn_entry = table_get(in ctx.fn_by_name, name);
            if fn_entry != 0 {
                let fnode = fn_at(in ctx, wrapping_sub(fn_entry, 1));
                if ll(in ctx, fnode.generics) == 0 {
                    return fnode.result;
                }
            }
        }
        return ctx.t_infer;
    }
    let syntactic_ty = type_of(in ctx, expr);
    if syntactic_ty == NONE {
        ctx.t_infer
    } else {
        syntactic_ty
    }
}

// The parameter types of function `func`, from parameter `skip` on.
fn param_types(in ctx: D, func: u32, skip: u64, inout out: ChunkSeq[u32]) {
    let fnode = fn_at(in ctx, func);
    for i in skip..ll(in ctx, fnode.params) {
        out.push(param_at(in ctx, la(in ctx, fnode.params, i)).ty);
    }
}

// The function-object shape of method `func`'s parameters: each parameter's
// type id when it is a function object, else NONE.
fn shape(inout ctx: D, func: u32, inout out: ChunkSeq[u32]) {
    let fnode = fn_at(in ctx, func);
    for i in 0..ll(in ctx, fnode.params) {
        let param_ty = param_at(in ctx, la(in ctx, fnode.params, i)).ty;
        if any_fn_sig(in ctx, param_ty) != NONE {
            let id = tid(inout ctx, param_ty);
            out.push(id);
        } else {
            out.push(NONE);
        }
    }
}

fn same_words(in a: ChunkSeq[u32], in b: ChunkSeq[u32]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for i in 0..a.len() {
        if u32_at(in a, i) != u32_at(in b, i) {
            return false;
        }
    }
    true
}

// The symbol of `ctx.buf` if it is interned, else NONE (a name never written
// is no declaration's).
fn lookup_buf(in ctx: D) -> u32 {
    match ctx.ast.names.lookup(in ctx.buf) {
        Option::Some(sym) => sym.id(),
        Option::None => NONE,
    }
}

// `callee_params`: the declared parameter types of the call `callee(..)`,
// aligned with its arguments, into `out`; false when unknown.
fn callee_params(inout ctx: D, callee: u32, inout out: ChunkSeq[u32]) -> bool {
    let callee_node = ex(in ctx, callee);
    if callee_node.kind == 2 {
        if env_has(in ctx, callee_node.a) {
            return false;
        }
        let fn_entry = table_get(in ctx.fn_by_name, callee_node.a);
        if fn_entry != 0 {
            param_types(in ctx, wrapping_sub(fn_entry, 1), 0, inout out);
            return true;
        }
        // `n.rsplit_once("::")`.
        let len = sym_len(in ctx.ast, callee_node.a);
        let mut cut = NONE;
        let mut index = len;
        loop {
            if index < 2 {
                break;
            }
            index = wrapping_sub(index, 1);
            if sym_byte(in ctx.ast, callee_node.a, index) == 58
                && sym_byte(in ctx.ast, callee_node.a, wrapping_sub(index, 1)) == 58
            {
                cut = n32(wrapping_sub(index, 1));
                break;
            }
        }
        if cut == NONE {
            return false;
        }
        ctx.buf.clear();
        for j in 0..w(cut) {
            ctx.buf.push_char(widen_u32(sym_byte(in ctx.ast, callee_node.a, j)));
        }
        let ty_name = lookup_buf(in ctx);
        ctx.buf.clear();
        for j in wrapping_add(w(cut), 2)..len {
            ctx.buf.push_char(widen_u32(sym_byte(in ctx.ast, callee_node.a, j)));
        }
        let method_name = lookup_buf(in ctx);
        if ty_name == NONE || method_name == NONE {
            return false;
        }
        let method_fn = method(in ctx, ty_name, method_name);
        if method_fn == NONE {
            return false;
        }
        param_types(in ctx, method_fn, 0, inout out);
        return true;
    }
    if callee_node.kind == 7 {
        let recv = infer(inout ctx, callee_node.a);
        let method_name = callee_node.b;
        let mut method_fn = NONE;
        if !is_infer(in ctx, recv) {
            method_fn = method(in ctx, tname(in ctx, recv), method_name);
            if method_fn == NONE {
                return false;
            }
        } else {
            // Every candidate must agree on its function-object
            // parameters, type for type; the first is the smallest type
            // name (BTreeMap order).
            let mut link = table_get(in ctx.method_head, method_name);
            let mut first = NONE;
            let mut first_ty = NONE;
            loop {
                if link == 0 {
                    break;
                }
                let index = w(wrapping_sub(link, 1));
                let ty_name = u32_at(in ctx.method_owner, index);
                if first == NONE || sym_cmp(in ctx.ast, ty_name, first_ty) < 0 {
                    first = u32_at(in ctx.method_fn, index);
                    first_ty = ty_name;
                }
                link = u32_at(in ctx.method_next, index);
            }
            if first == NONE {
                return false;
            }
            let mut first_shape = ChunkSeq::new[u32]();
            shape(inout ctx, first, inout first_shape);
            link = table_get(in ctx.method_head, method_name);
            loop {
                if link == 0 {
                    break;
                }
                let index = w(wrapping_sub(link, 1));
                let mut other_shape = ChunkSeq::new[u32]();
                shape(inout ctx, u32_at(in ctx.method_fn, index), inout other_shape);
                if !same_words(in first_shape, in other_shape) {
                    return false;
                }
                link = u32_at(in ctx.method_next, index);
            }
            method_fn = first;
        }
        param_types(in ctx, method_fn, 1, inout out);
        return true;
    }
    false
}

// `trivial`: a literal or a path of names, fields and literal indices.
fn trivial(in ctx: D, expr: u32) -> bool {
    let node = ex(in ctx, expr);
    if node.kind == 1 || node.kind == 2 {
        return true;
    }
    if node.kind == 7 {
        return trivial(in ctx, node.a);
    }
    if node.kind == 8 {
        return trivial(in ctx, node.a) && trivial(in ctx, node.b);
    }
    false
}

// ---------------------------------------------------------------- lowering

// `Lowering::function`.
fn function(inout ctx: D, func: u32, self_ty: u32) {
    let fnode = fn_at(in ctx, func);
    env_restore(inout ctx, 0);
    for i in 0..ll(in ctx, fnode.params) {
        let param = param_at(in ctx, la(in ctx, fnode.params, i));
        let mut param_ty = param.ty;
        if self_ty != NONE {
            let ty_node = ty(in ctx, param.ty);
            if ty_node.kind == 5 && param.name == ctx.known.self_ {
                param_ty = self_ty;
            } else if ty_node.kind == 1
                && ty_node.a == ctx.known.self_ty
                && ll(in ctx, ty_node.b) == 0
            {
                param_ty = self_ty;
            }
        }
        env_put(inout ctx, param.name, param_ty);
    }
    if self_ty != NONE && !env_has(in ctx, ctx.known.self_) {
        env_put(inout ctx, ctx.known.self_, self_ty);
    }
    ctx.generics.clear();
    for i in 0..ll(in ctx, fnode.generics) {
        let generic = generic_at(in ctx, la(in ctx, fnode.generics, i));
        ctx.generics.push(generic.name);
    }
    ctx.result = fnode.result;
    if fnode.body != NONE {
        lower(inout ctx, fnode.body, fnode.result);
    }
    env_restore(inout ctx, 0);
}

fn lower_opt(inout ctx: D, expr: u32, expected: u32) {
    if expr != NONE {
        lower(inout ctx, expr, expected);
    }
}

// `Lowering::lower`: lowers `expr` where a value of `expected` (NONE when
// unknown) is wanted.
fn lower(inout ctx: D, expr: u32, expected: u32) {
    let node = ex(in ctx, expr);
    if expected != NONE && node.kind == 15 {
        let sig = fn_sig(in ctx, expected);
        if sig != NONE {
            let object_kind = fn_kind(in ctx, expected);
            coerce(inout ctx, expr, object_kind, sig);
            return;
        }
    }
    if node.kind == 6 && ll(in ctx, node.c) == 1 {
        let callee = ex(in ctx, node.a);
        let arg = arg_at(in ctx, la(in ctx, node.c, 0)).expr;
        if callee.kind == 2
            && callee.a == ctx.known.box_new
            && !env_has(in ctx, callee.a)
            && ex(in ctx, arg).kind == 15
        {
            let mut object = NONE;
            if ll(in ctx, node.b) > 0 {
                let type_arg = la(in ctx, node.b, 0);
                if fn_sig(in ctx, type_arg) != NONE {
                    object = type_arg;
                }
            } else if expected != NONE && boxed_fn_sig(in ctx, expected) != NONE {
                object = la(in ctx, ty(in ctx, expected).b, 0);
            }
            if object != NONE {
                let sig = fn_sig(in ctx, object);
                if sig != NONE {
                    let object_kind = fn_kind(in ctx, object);
                    coerce(inout ctx, arg, object_kind, sig);
                    if ll(in ctx, node.b) == 0 {
                        let type_args = list1(inout ctx, object);
                        let cur = ex(in ctx, expr);
                        set_ex(
                            inout ctx,
                            expr,
                            exn(cur.kind, cur.start, cur.end, cur.a, type_args, cur.c)
                        );
                    }
                    return;
                }
            }
        }
    }
    let kind = node.kind;
    if kind == 1 || kind == 2 {} else if kind == 3 {
        let expected_node = ty(
            in ctx,
            if expected == NONE {
                ctx.t_infer
            } else {
                expected
            }
        );
        let len = ll(in ctx, node.a);
        let tuple = expected != NONE
            && expected_node.kind == 2
            && ll(in ctx, expected_node.a) == len;
        for i in 0..len {
            let want = if tuple {
                la(in ctx, expected_node.a, i)
            } else {
                ctx.t_infer
            };
            lower(inout ctx, la(in ctx, node.a, i), want);
        }
    } else if kind == 4 {
        let len = ll(in ctx, node.b) / 2;
        for i in 0..len {
            let field = la(in ctx, node.b, wrapping_mul(i, 2));
            let want = field_type(in ctx, node.a, field);
            lower(inout ctx, la(in ctx, node.b, inc(wrapping_mul(i, 2))), want);
        }
    } else if kind == 5 {
        let mark = env_mark(in ctx);
        for i in 0..ll(in ctx, node.a) {
            let stmt = stmt_at(in ctx, la(in ctx, node.a, i));
            if stmt.kind == 1 {
                let want = if is_infer(in ctx, stmt.ty) {
                    NONE
                } else {
                    stmt.ty
                };
                lower(inout ctx, stmt.value, want);
                let bound = if want != NONE {
                    want
                } else {
                    infer(inout ctx, stmt.value)
                };
                bind(inout ctx, stmt.pat, bound);
            } else {
                lower(inout ctx, stmt.value, NONE);
            }
        }
        lower_opt(inout ctx, node.b, expected);
        env_restore(inout ctx, mark);
    } else if kind == 6 {
        call(inout ctx, expr);
    } else if kind == 7 || kind == 9 {
        lower(inout ctx, node.a, NONE);
    } else if kind == 10 {
        lower(inout ctx, node.b, NONE);
    } else if kind == 8 {
        lower(inout ctx, node.a, NONE);
        lower(inout ctx, node.b, NONE);
    } else if kind == 11 {
        lower(inout ctx, node.b, NONE);
        lower(inout ctx, node.c, NONE);
    } else if kind == 12 {
        let target_ty = type_of(in ctx, node.b);
        lower(inout ctx, node.b, NONE);
        lower(inout ctx, node.c, target_ty);
    } else if kind == 13 {
        lower(inout ctx, node.a, NONE);
        lower(inout ctx, node.b, expected);
        lower_opt(inout ctx, node.c, expected);
    } else if kind == 14 {
        lower(inout ctx, node.a, NONE);
        let len = ll(in ctx, node.b) / 2;
        for i in 0..len {
            let mark = env_mark(in ctx);
            bind(inout ctx, la(in ctx, node.b, wrapping_mul(i, 2)), ctx.t_infer);
            lower(inout ctx, la(in ctx, node.b, inc(wrapping_mul(i, 2))), expected);
            env_restore(inout ctx, mark);
        }
    } else if kind == 15 {
        let mark = env_mark(in ctx);
        for i in 0..ll(in ctx, node.a) {
            let param = param_at(in ctx, la(in ctx, node.a, i));
            env_put(inout ctx, param.name, param.ty);
        }
        lower(inout ctx, node.e, NONE);
        env_restore(inout ctx, mark);
    } else if kind == 16 {
        if node.b != NONE {
            lower(inout ctx, node.c, NONE);
        }
        lower(inout ctx, node.d, NONE);
        for i in 0..ll(in ctx, node.e) {
            let clause = clause_at(in ctx, la(in ctx, node.e, i));
            let mark = env_mark(in ctx);
            for j in 0..ll(in ctx, clause.pats) {
                bind(inout ctx, la(in ctx, clause.pats, j), ctx.t_infer);
            }
            lower(inout ctx, clause.body, NONE);
            env_restore(inout ctx, mark);
        }
    } else if kind == 18 {
        lower(inout ctx, node.b, NONE);
        let mark = env_mark(in ctx);
        let bind_ty = if ex(in ctx, node.b).kind == 19 {
            ctx.t_i64
        } else {
            ctx.t_infer
        };
        bind(inout ctx, node.a, bind_ty);
        lower(inout ctx, node.c, NONE);
        env_restore(inout ctx, mark);
    } else if kind == 21 && node.a != NONE {
        let result = ctx.result;
        lower(inout ctx, node.a, result);
    } else if kind == 17 {
        lower(inout ctx, node.a, NONE);
    } else if kind == 19 {
        lower(inout ctx, node.a, NONE);
        lower(inout ctx, node.b, NONE);
    } else if kind == 20 {
        lower_opt(inout ctx, node.a, NONE);
    }
}

// Moves expression `expr`'s node to a new index and puts `Name(name)` with a
// new synthetic span at `expr`; returns the moved node's index.
fn hoist(inout ctx: D, expr: u32, in prefix: Str, mutable: bool, inout stmts: ChunkSeq[u32]) {
    let old = ex(in ctx, expr);
    ctx.buf.clear();
    ctx.buf.push_str(in prefix);
    buf_decimal(inout ctx, w(old.start));
    let name = intern_buf(inout ctx);
    let value = new_ex(inout ctx, old);
    let start = span(inout ctx);
    set_ex(inout ctx, expr, exn(2, start, inc32(start), name, NONE, NONE));
    let pat_start = span(inout ctx);
    let pat = new_pat(inout ctx, 2, pat_start, inc32(pat_start), name, NONE, NONE);
    let stmt = new_stmt(
        inout ctx,
        StmtNode { kind: 1, pat: pat, ty: ctx.t_infer, value: value, mutable: mutable }
    );
    stmts.push(stmt);
}

// `Lowering::call`: closure arguments for function-object parameters
// become objects, and a call of a function object becomes a call of
// `call`.
fn call(inout ctx: D, expr: u32) {
    let node = ex(in ctx, expr);
    let callee = node.a;
    let mut params = ChunkSeq::new[u32]();
    let known = callee_params(inout ctx, callee, inout params);
    let call_start = node.start;
    let call_end = node.end;
    let callee_node = ex(in ctx, callee);
    let mut callee_object = false;
    if callee_node.kind == 2 || callee_node.kind == 8 {
        let callee_ty = type_of(in ctx, callee);
        callee_object = callee_ty != NONE && any_fn_sig(in ctx, callee_ty) != NONE;
    } else if callee_node.kind == 7 {
        let receiver_ty = type_of(in ctx, callee_node.a);
        let has_method = receiver_ty != NONE
            && method(in ctx, tname(in ctx, receiver_ty), callee_node.b) != NONE;
        if !has_method {
            let callee_ty = type_of(in ctx, callee);
            callee_object = callee_ty != NONE && any_fn_sig(in ctx, callee_ty) != NONE;
        }
    }
    let mut push_element = NONE;
    if callee_node.kind == 7 && callee_node.b == ctx.known.push {
        let receiver_ty = type_of(in ctx, callee_node.a);
        if receiver_ty != NONE {
            let receiver_node = ty(in ctx, receiver_ty);
            if receiver_node.kind == 1 && ll(in ctx, receiver_node.b) == 1 {
                let elem_ty = la(in ctx, receiver_node.b, 0);
                if boxed_fn_sig(in ctx, elem_ty) != NONE {
                    push_element = elem_ty;
                }
            }
        }
    }
    lower(inout ctx, callee, NONE);
    set_origin(inout ctx, call_start, call_end);
    let nargs = ll(in ctx, node.c);
    let mut wants = ChunkSeq::with_capacity[u32](nargs);
    let mut lends = ChunkSeq::with_capacity[u8](nargs);
    let mut last_lend: u64 = 0;
    let mut has_lend = false;
    for i in 0..nargs {
        let mut want = push_element;
        if want == NONE && known && i < params.len() {
            want = u32_at(in params, i);
        }
        wants.push(want);
        let arg = arg_at(in ctx, la(in ctx, node.c, i));
        let lend = arg.pass == 1
            && ex(in ctx, arg.expr).kind == 15
            && want != NONE
            && fn_sig(in ctx, want) != NONE;
        lends.push(if lend { 1 } else { 0 });
        if lend {
            last_lend = i;
            has_lend = true;
        }
    }
    let mut hoisted = ChunkSeq::new[u32]();
    for i in 0..nargs {
        let arg = arg_at(in ctx, la(in ctx, node.c, i));
        let want = u32_at(in wants, i);
        let lend_mut = u8_at(in lends, i) == 1;
        lower(inout ctx, arg.expr, want);
        set_origin(inout ctx, call_start, call_end);
        if !lend_mut && arg.pass != 1 && has_lend && i < last_lend && !trivial(in ctx, arg.expr) {
            // An argument before a hoisted closure is evaluated first too,
            // so the closure captures what it left behind.
            hoist(inout ctx, arg.expr, in "$arg", false, inout hoisted);
            continue;
        }
        if lend_mut {
            // An `inout` lend needs a place: the object is a local of the
            // call's own block.
            hoist(inout ctx, arg.expr, in "$closure", true, inout hoisted);
        }
    }
    set_origin(inout ctx, call_start, call_end);
    if callee_object {
        let old = ex(in ctx, callee);
        let moved = new_ex(inout ctx, old);
        let start = span(inout ctx);
        set_ex(inout ctx, callee, exn(7, start, inc32(start), moved, ctx.known.call, NONE));
    }
    if hoisted.len() > 0 {
        let call_node = ex(in ctx, expr);
        let moved = new_ex(inout ctx, call_node);
        let start = span(inout ctx);
        let stmt_list = mk_list(inout ctx, in hoisted);
        set_ex(inout ctx, expr, exn(5, start, inc32(start), stmt_list, moved, NONE));
    }
}

fn field_name(in ctx: D, name: u32) -> u32 {
    if name == ctx.known.self_ {
        ctx.known.self_field
    } else {
        name
    }
}

// The instance and tail names of an effect row, ", "-joined, into the
// diagnostic (`names`).
fn deffect_names(inout ctx: D, effects: u32) {
    let effects_row = effects_at(in ctx, effects);
    let n = ll(in ctx, effects_row.instances);
    for i in 0..n {
        if i > 0 {
            dput(inout ctx, in ", ");
        }
        dsym(inout ctx, effect_at(in ctx, la(in ctx, effects_row.instances, i)).name);
    }
    if effects_row.tail != NONE {
        if n > 0 {
            dput(inout ctx, in ", ");
        }
        dsym(inout ctx, effects_row.tail);
    }
}

fn dpass(inout ctx: D, pass: u8) {
    if pass == 0 {
        dput(inout ctx, in "In");
    } else if pass == 1 {
        dput(inout ctx, in "Inout");
    } else {
        dput(inout ctx, in "Sink");
    }
}

// `Lowering::coerce`: replaces the closure literal `expr` by a value of a
// hidden struct that conforms to the hidden trait of `kind` and `sig`.
fn coerce(inout ctx: D, expr: u32, kind: u32, sig: u32) {
    let node = ex(in ctx, expr);
    let sig_node = ty(in ctx, sig);
    let start = node.start;
    let end = node.end;
    set_origin(inout ctx, start, end);
    let param_count = ll(in ctx, node.a);
    let sig_param_count = ll(in ctx, sig_node.a) / 2;
    if param_count != sig_param_count {
        let diag = diag_open(inout ctx, in "E0207");
        dput(inout ctx, in "the closure takes ");
        ddec(inout ctx, param_count);
        dput(inout ctx, in " parameters; `dyn ");
        dsym(inout ctx, kind);
        dput(inout ctx, in "` takes ");
        ddec(inout ctx, sig_param_count);
        diag_close(inout ctx, diag, start, end);
        return;
    }
    for i in 0..param_count {
        let param = param_at(in ctx, la(in ctx, node.a, i));
        let pass = wrapping_u8(la(in ctx, sig_node.a, wrapping_mul(i, 2)));
        let sig_ty = la(in ctx, sig_node.a, inc(wrapping_mul(i, 2)));
        if !is_infer(in ctx, param.ty) && !teq(inout ctx, param.ty, sig_ty) {
            let diag = diag_open(inout ctx, in "E0200");
            dput(inout ctx, in "the closure's parameter '");
            dsym(inout ctx, param.name);
            dput(inout ctx, in "' is written `");
            dtype(inout ctx, param.ty);
            dput(inout ctx, in "`; `dyn ");
            dsym(inout ctx, kind);
            dput(inout ctx, in "` passes `");
            dtype(inout ctx, sig_ty);
            dput(inout ctx, in "`");
            diag_close(inout ctx, diag, param.start, param.end);
            return;
        }
        if param.pass != 0 && param.pass != pass {
            let diag = diag_open(inout ctx, in "E0200");
            dput(inout ctx, in "the closure takes '");
            dsym(inout ctx, param.name);
            dput(inout ctx, in "' by `");
            dpass(inout ctx, param.pass);
            dput(inout ctx, in "`; `dyn ");
            dsym(inout ctx, kind);
            dput(inout ctx, in "` passes it by `");
            dpass(inout ctx, pass);
            dput(inout ctx, in "`");
            diag_close(inout ctx, diag, param.start, param.end);
            return;
        }
    }
    if !is_infer(in ctx, node.c) && !teq(inout ctx, node.c, sig_node.b) {
        let diag = diag_open(inout ctx, in "E0200");
        dput(inout ctx, in "the closure returns `");
        dtype(inout ctx, node.c);
        dput(inout ctx, in "`; `dyn ");
        dsym(inout ctx, kind);
        dput(inout ctx, in "` returns `");
        dtype(inout ctx, sig_node.b);
        dput(inout ctx, in "`");
        diag_close(inout ctx, diag, start, end);
        return;
    }
    // A written effect row restricts the body; it must fit the object's.
    let infer_effects = node.b >= 256;
    let mode = node.b & 255;
    let mut body_effects = sig_node.c;
    if !infer_effects {
        let written = effects_at(in ctx, node.d);
        let sig_effects = effects_at(in ctx, sig_node.c);
        let mut fits = written.tail == NONE;
        for i in 0..ll(in ctx, written.instances) {
            let effect = la(in ctx, written.instances, i);
            let mut any = false;
            for j in 0..ll(in ctx, sig_effects.instances) {
                if effect_eq(inout ctx, la(in ctx, sig_effects.instances, j), effect) {
                    any = true;
                }
            }
            if !any {
                fits = false;
            }
        }
        if !fits {
            let diag = diag_open(inout ctx, in "E0401");
            dput(inout ctx, in "the closure's written effects [");
            deffect_names(inout ctx, node.d);
            dput(inout ctx, in "] are not within those of `dyn ");
            dsym(inout ctx, kind);
            dput(inout ctx, in "`: [");
            deffect_names(inout ctx, sig_node.c);
            dput(inout ctx, in "]");
            diag_close(inout ctx, diag, start, end);
            return;
        }
        body_effects = node.d;
    }
    if mode == 2 && kind != ctx.known.fn_once {
        let diag = diag_open(inout ctx, in "E0310");
        dput(
            inout ctx,
            in "a linear closure can be called once: it is a `dyn FnOnce`, not a `dyn "
        );
        dsym(inout ctx, kind);
        dput(inout ctx, in "`");
        diag_close(inout ctx, diag, start, end);
    }
    // Lower nested objects inside the body first, with the closure's
    // parameters in scope.
    let mark = env_mark(in ctx);
    for i in 0..param_count {
        let param = param_at(in ctx, la(in ctx, node.a, i));
        env_put(inout ctx, param.name, la(in ctx, sig_node.a, inc(wrapping_mul(i, 2))));
    }
    let saved = ctx.result;
    ctx.result = sig_node.b;
    lower(inout ctx, node.e, sig_node.b);
    ctx.result = saved;
    env_restore(inout ctx, mark);
    // Captures: the body's free names bound outside, sorted by text.
    let free = free_names(in ctx, node.e);
    let mut cap_names = ChunkSeq::new[u32]();
    let mut cap_types = ChunkSeq::new[u32]();
    for i in 0..free.len() {
        let name = u32_at(in free, i);
        let mut is_param = false;
        for j in 0..param_count {
            if param_at(in ctx, la(in ctx, node.a, j)).name == name {
                is_param = true;
            }
        }
        if is_param {
            continue;
        }
        let cap_ty = env_get(in ctx, name);
        if cap_ty != NONE {
            cap_names.push(name);
            cap_types.push(cap_ty);
        }
    }
    let cap_count = cap_names.len();
    for i in 0..cap_count {
        let name = u32_at(in cap_names, i);
        let cap_ty = u32_at(in cap_types, i);
        if contains_infer(in ctx, cap_ty) {
            let diag = diag_open(inout ctx, in "E0102");
            dput(inout ctx, in "the closure captures '");
            dsym(inout ctx, name);
            dput(
                inout ctx,
                in "', whose type is not written where it is bound; annotate it (`let "
            );
            dsym(inout ctx, name);
            dput(inout ctx, in ": T = ..`) to lower the closure to `dyn ");
            dsym(inout ctx, kind);
            dput(inout ctx, in "`");
            diag_close(inout ctx, diag, start, end);
            return;
        }
        if is_linear(in ctx, type_name(in ctx, cap_ty)) {
            let once = kind == ctx.known.fn_once;
            let diag = if once {
                diag_open(inout ctx, in "E0205")
            } else {
                diag_open(inout ctx, in "E0310")
            };
            dput(inout ctx, in "the closure captures the linear '");
            dsym(inout ctx, name);
            dput(inout ctx, in "' (");
            dtype(inout ctx, cap_ty);
            dput(inout ctx, in "); ");
            if once {
                dput(
                    inout ctx,
                    in "a `dyn FnOnce` object may be dropped uncalled, so it cannot own a linear value"
                );
            } else {
                dput(
                    inout ctx,
                    in "a closure capturing a linear value can be called once only: it is never a `dyn Fn` or `dyn FnMut`"
                );
            }
            diag_close(inout ctx, diag, start, end);
            return;
        }
        let mut generic = mentions_any(in ctx, cap_ty, in ctx.generics)
            || mentions_any(in ctx, sig_node.b, in ctx.generics);
        for j in 0..sig_param_count {
            if mentions_any(
                in ctx,
                la(in ctx, sig_node.a, inc(wrapping_mul(j, 2))),
                in ctx.generics
            ) {
                generic = true;
            }
        }
        if generic {
            let diag = diag_open(inout ctx, in "E0633");
            dput(inout ctx, in "a closure lowered to `dyn ");
            dsym(inout ctx, kind);
            dput(
                inout ctx,
                in "` cannot mention the type parameters of its enclosing function yet ('"
            );
            dsym(inout ctx, name);
            dput(inout ctx, in "': ");
            dtype(inout ctx, cap_ty);
            dput(inout ctx, in ")");
            diag_close(inout ctx, diag, start, end);
            return;
        }
    }
    let erased = erase_sig(inout ctx, sig);
    let trait_name = hidden_trait(inout ctx, kind, erased);
    let index = ctx.gen_adts.len();
    ctx.buf.clear();
    ctx.buf.push_str(in "__Closure");
    buf_decimal(inout ctx, index);
    ctx.buf.push_str(in "_");
    buf_decimal(inout ctx, w(start));
    let struct_name = intern_buf(inout ctx);
    let mut fields = ChunkSeq::new[u32]();
    for i in 0..cap_count {
        let cap_field = field_name(in ctx, u32_at(in cap_names, i));
        let field = ctx.ast
            .fields
            .alloc(FieldNode {
                name: cap_field,
                ty: u32_at(in cap_types, i),
                modality: 3,
                temperature: 0
            })
            .raw();
        fields.push(field);
    }
    let field_list = mk_list(inout ctx, in fields);
    let variant = ctx.ast
        .variants
        .alloc(VariantNode { name: struct_name, fields: field_list, named: true })
        .raw();
    let variant_list = list1(inout ctx, variant);
    let adt_span = span(inout ctx);
    let adt = ctx.ast
        .adts
        .alloc(AdtNode {
            name: struct_name,
            mode: 1,
            generics: 0,
            variants: variant_list,
            is_enum: false,
            tiled: false,
            tile_width: 0,
            start: adt_span,
            end: inc32(adt_span)
        })
        .raw();
    let receiver = pass_of(kind, in ctx);
    let mut method_params = ChunkSeq::new[u32]();
    let self_start = span(inout ctx);
    let self_param = new_param(
        inout ctx,
        ParamNode {
            name: ctx.known.self_,
            pass: receiver,
            projections: 0,
            ty: ctx.t_infer,
            start: self_start,
            end: inc32(self_start)
        }
    );
    method_params.push(self_param);
    for i in 0..param_count {
        let param = param_at(in ctx, la(in ctx, node.a, i));
        let method_param = new_param(
            inout ctx,
            ParamNode {
                name: param.name,
                pass: wrapping_u8(la(in ctx, sig_node.a, wrapping_mul(i, 2))),
                projections: 0,
                ty: la(in ctx, sig_node.a, inc(wrapping_mul(i, 2))),
                start: param.start,
                end: param.end
            }
        );
        method_params.push(method_param);
    }
    let body = node.e;
    let mut new_body = body;
    if receiver == 2 {
        // `FnOnce`: the object is consumed whole, binding each capture
        // under its own name (`self` as `$self`).
        let mut from = ChunkSeq::new[u32]();
        let mut to = ChunkSeq::new[u32]();
        for i in 0..cap_count {
            if u32_at(in cap_names, i) == ctx.known.self_ {
                from.push(ctx.known.self_);
                to.push(ctx.known.dollar_self);
            }
        }
        substitute(inout ctx, body, in from, in to, false);
        let mut pats = ChunkSeq::new[u32]();
        for i in 0..cap_count {
            let name = u32_at(in cap_names, i);
            let pat_start = span(inout ctx);
            let bind_name = if name == ctx.known.self_ && from.len() > 0 {
                ctx.known.dollar_self
            } else {
                name
            };
            let pat = new_pat(inout ctx, 2, pat_start, inc32(pat_start), bind_name, NONE, NONE);
            pats.push(field_name(in ctx, name));
            pats.push(pat);
        }
        let pat_list = mk_list(inout ctx, in pats);
        let pat_span = span(inout ctx);
        let self_expr = mk_expr(inout ctx, 2, ctx.known.self_, NONE);
        let block_start = span(inout ctx);
        let struct_pat = new_pat(inout ctx, 5, pat_span, inc32(pat_span), struct_name, pat_list, 1);
        let stmt = new_stmt(
            inout ctx,
            StmtNode { kind: 1, pat: struct_pat, ty: ctx.t_infer, value: self_expr, mutable: true }
        );
        let stmt_list = list1(inout ctx, stmt);
        new_body = new_ex(
            inout ctx,
            exn(5, block_start, inc32(block_start), stmt_list, body, NONE)
        );
    } else {
        let mut to = ChunkSeq::new[u32]();
        for i in 0..cap_count {
            to.push(field_name(in ctx, u32_at(in cap_names, i)));
        }
        substitute(inout ctx, body, in cap_names, in to, true);
    }
    let param_list = mk_list(inout ctx, in method_params);
    let method_start = span(inout ctx);
    let method_fn = ctx.ast
        .fns
        .alloc(FnNode {
            name: ctx.known.call,
            fip: false,
            generics: 0,
            params: param_list,
            result: sig_node.b,
            effects: body_effects,
            body: new_body,
            start: method_start,
            end: inc32(method_start)
        })
        .raw();
    let trait_ref_start = span(inout ctx);
    let trait_ref = ctx.ast
        .trait_refs
        .alloc(TraitRefNode {
            package: NONE,
            name: trait_name,
            args: 0,
            start: trait_ref_start,
            end: inc32(trait_ref_start)
        })
        .raw();
    let self_ty = named(inout ctx, struct_name, 0);
    let method_list = list1(inout ctx, method_fn);
    let conf_start = span(inout ctx);
    let conf = ctx.ast
        .confs
        .alloc(ConfNode {
            model: NONE,
            public: false,
            generics: 0,
            trait_ref: trait_ref,
            self_ty: self_ty,
            wheres: 0,
            assoc: 0,
            methods: method_list,
            start: conf_start,
            end: inc32(conf_start)
        })
        .raw();
    ctx.gen_adts.push(adt);
    ctx.gen_confs.push(conf);
    let mut field_inits = ChunkSeq::new[u32]();
    for i in 0..cap_count {
        let name = u32_at(in cap_names, i);
        let field_value = mk_expr(inout ctx, 2, name, NONE);
        field_inits.push(field_name(in ctx, name));
        field_inits.push(field_value);
    }
    let field_init_list = mk_list(inout ctx, in field_inits);
    set_ex(inout ctx, expr, exn(4, start, end, struct_name, field_init_list, NONE));
}

fn map_get(in from: ChunkSeq[u32], in to: ChunkSeq[u32], key: u32) -> u32 {
    for i in 0..from.len() {
        if u32_at(in from, i) == key {
            return u32_at(in to, i);
        }
    }
    NONE
}

// The map without the keys in `bound`.
fn map_without(
    in from: ChunkSeq[u32],
    in to: ChunkSeq[u32],
    in bound: ChunkSeq[u32],
    inout kept_from: ChunkSeq[u32],
    inout kept_to: ChunkSeq[u32]
) {
    for i in 0..from.len() {
        let key = u32_at(in from, i);
        if !contains(in bound, key) {
            kept_from.push(key);
            kept_to.push(u32_at(in to, i));
        }
    }
}

fn subst_scoped(
    inout ctx: D,
    expr: u32,
    in from: ChunkSeq[u32],
    in to: ChunkSeq[u32],
    in bound: ChunkSeq[u32],
    fields: bool
) {
    let mut kept_from = ChunkSeq::new[u32]();
    let mut kept_to = ChunkSeq::new[u32]();
    map_without(in from, in to, in bound, inout kept_from, inout kept_to);
    substitute(inout ctx, expr, in kept_from, in kept_to, fields);
}

fn subst_opt(inout ctx: D, expr: u32, in from: ChunkSeq[u32], in to: ChunkSeq[u32], fields: bool) {
    if expr != NONE {
        substitute(inout ctx, expr, in from, in to, fields);
    }
}

// `Lowering::substitute`: rewrites the free uses of the map's names in
// `expr`, to `self.field` (`fields`) or to another name.
fn substitute(inout ctx: D, expr: u32, in from: ChunkSeq[u32], in to: ChunkSeq[u32], fields: bool) {
    if from.len() == 0 {
        return;
    }
    let node = ex(in ctx, expr);
    let kind = node.kind;
    if kind == 2 {
        let target = map_get(in from, in to, node.a);
        if target != NONE {
            if fields {
                let base = mk_expr(inout ctx, 2, ctx.known.self_, NONE);
                set_ex(inout ctx, expr, exn(7, node.start, node.end, base, target, NONE));
            } else {
                set_ex(inout ctx, expr, exn(2, node.start, node.end, target, NONE, NONE));
            }
        }
    } else if kind == 3 {
        for i in 0..ll(in ctx, node.a) {
            substitute(inout ctx, la(in ctx, node.a, i), in from, in to, fields);
        }
    } else if kind == 4 {
        let len = ll(in ctx, node.b) / 2;
        for i in 0..len {
            substitute(
                inout ctx,
                la(in ctx, node.b, inc(wrapping_mul(i, 2))),
                in from,
                in to,
                fields
            );
        }
    } else if kind == 5 {
        let mut cur_from = list_copy(in from);
        let mut cur_to = list_copy(in to);
        for i in 0..ll(in ctx, node.a) {
            let stmt = stmt_at(in ctx, la(in ctx, node.a, i));
            substitute(inout ctx, stmt.value, in cur_from, in cur_to, fields);
            if stmt.kind == 1 {
                let mut bound = ChunkSeq::new[u32]();
                pattern_names(in ctx, stmt.pat, inout bound);
                let mut kept_from = ChunkSeq::new[u32]();
                let mut kept_to = ChunkSeq::new[u32]();
                map_without(in cur_from, in cur_to, in bound, inout kept_from, inout kept_to);
                cur_from = kept_from;
                cur_to = kept_to;
            }
        }
        subst_opt(inout ctx, node.b, in cur_from, in cur_to, fields);
    } else if kind == 6 {
        // A path or function name is not a capture.
        let callee = ex(in ctx, node.a);
        if callee.kind != 2 || map_get(in from, in to, callee.a) != NONE {
            substitute(inout ctx, node.a, in from, in to, fields);
        }
        for i in 0..ll(in ctx, node.c) {
            substitute(
                inout ctx,
                arg_at(in ctx, la(in ctx, node.c, i)).expr,
                in from,
                in to,
                fields
            );
        }
    } else if kind == 7 || kind == 9 {
        substitute(inout ctx, node.a, in from, in to, fields);
    } else if kind == 10 {
        substitute(inout ctx, node.b, in from, in to, fields);
    } else if kind == 8 {
        substitute(inout ctx, node.a, in from, in to, fields);
        substitute(inout ctx, node.b, in from, in to, fields);
    } else if kind == 11 || kind == 12 {
        substitute(inout ctx, node.b, in from, in to, fields);
        substitute(inout ctx, node.c, in from, in to, fields);
    } else if kind == 13 {
        substitute(inout ctx, node.a, in from, in to, fields);
        substitute(inout ctx, node.b, in from, in to, fields);
        subst_opt(inout ctx, node.c, in from, in to, fields);
    } else if kind == 14 {
        substitute(inout ctx, node.a, in from, in to, fields);
        let len = ll(in ctx, node.b) / 2;
        for i in 0..len {
            let mut bound = ChunkSeq::new[u32]();
            pattern_names(in ctx, la(in ctx, node.b, wrapping_mul(i, 2)), inout bound);
            subst_scoped(
                inout ctx,
                la(in ctx, node.b, inc(wrapping_mul(i, 2))),
                in from,
                in to,
                in bound,
                fields
            );
        }
    } else if kind == 15 {
        let mut bound = ChunkSeq::new[u32]();
        for i in 0..ll(in ctx, node.a) {
            bound.push(param_at(in ctx, la(in ctx, node.a, i)).name);
        }
        subst_scoped(inout ctx, node.e, in from, in to, in bound, fields);
    } else if kind == 16 {
        if node.b != NONE {
            substitute(inout ctx, node.c, in from, in to, fields);
        }
        substitute(inout ctx, node.d, in from, in to, fields);
        for i in 0..ll(in ctx, node.e) {
            let clause = clause_at(in ctx, la(in ctx, node.e, i));
            let mut bound = ChunkSeq::new[u32]();
            for j in 0..ll(in ctx, clause.pats) {
                pattern_names(in ctx, la(in ctx, clause.pats, j), inout bound);
            }
            subst_scoped(inout ctx, clause.body, in from, in to, in bound, fields);
        }
    } else if kind == 18 {
        substitute(inout ctx, node.b, in from, in to, fields);
        let mut bound = ChunkSeq::new[u32]();
        pattern_names(in ctx, node.a, inout bound);
        subst_scoped(inout ctx, node.c, in from, in to, in bound, fields);
    } else if kind == 17 {
        substitute(inout ctx, node.a, in from, in to, fields);
    } else if kind == 19 {
        substitute(inout ctx, node.a, in from, in to, fields);
        substitute(inout ctx, node.b, in from, in to, fields);
    } else if kind == 20 || kind == 21 {
        subst_opt(inout ctx, node.a, in from, in to, fields);
    }
}

fn list_copy(in seq: ChunkSeq[u32]) -> ChunkSeq[u32] {
    let mut out = ChunkSeq::with_capacity[u32](seq.len());
    for i in 0..seq.len() {
        out.push(u32_at(in seq, i));
    }
    out
}

// `dyn_fn::lower`. Returns whether it succeeded (no diagnostics).
pub fn lower_fn_objects(inout ctx: D) -> bool {
    let first_diag = ctx.diags.len();
    decls(inout ctx);
    let item_count = ctx.ast.m_items.len();
    for i in 0..item_count {
        let item = item_at(in ctx, u32_at(in ctx.ast.m_items, i));
        let node = item.node;
        if item.kind == 2 {
            function(inout ctx, node, NONE);
        } else if item.kind == 4 {
            let impl_ = impl_at(in ctx, node);
            for j in 0..ll(in ctx, impl_.methods) {
                function(inout ctx, la(in ctx, impl_.methods, j), impl_.ty);
            }
        } else if item.kind == 6 {
            let conf = conf_at(in ctx, node);
            for j in 0..ll(in ctx, conf.methods) {
                function(inout ctx, la(in ctx, conf.methods, j), conf.self_ty);
            }
        }
    }
    for i in 0..ctx.gen_adts.len() {
        let adt_item = new_item(inout ctx, 1, u32_at(in ctx.gen_adts, i));
        ctx.ast.m_items.push(adt_item);
        let conf_item = new_item(inout ctx, 6, u32_at(in ctx.gen_confs, i));
        ctx.ast.m_items.push(conf_item);
    }
    // Every function-object type, in source and generated items alike,
    // becomes its hidden trait's object type.
    erase_module(inout ctx);
    if ctx.diags.len() != first_diag {
        return false;
    }
    // The hidden traits first, in name order.
    let mut order = list_copy(in ctx.trait_names);
    sort_syms(in ctx.ast, inout order);
    let mut items = ChunkSeq::with_capacity[u32](wrapping_add(order.len(), ctx.ast.m_items.len()));
    for i in 0..order.len() {
        let name = u32_at(in order, i);
        let mut trait_node = NONE;
        for j in 0..ctx.trait_names.len() {
            if u32_at(in ctx.trait_names, j) == name {
                trait_node = u32_at(in ctx.trait_nodes, j);
            }
        }
        let trait_item = new_item(inout ctx, 5, trait_node);
        items.push(trait_item);
    }
    for i in 0..ctx.ast.m_items.len() {
        items.push(u32_at(in ctx.ast.m_items, i));
    }
    ctx.ast.m_items = items;
    true
}

// `Lowered::relocate` of the span `start..end`: a span of generated code
// is reported at the source span it came from.
pub fn relocate(in ctx: D, start: u64, end: u64) -> (u64, u64) {
    if start < ctx.base || start >= ctx.next_span {
        return (start, end);
    }
    let n = ctx.origins.len() / 3;
    // `partition_point(|(s, _)| *s <= start)`.
    let mut lo: u64 = 0;
    let mut hi = n;
    loop {
        if lo >= hi {
            break;
        }
        let mid = wrapping_add(lo, wrapping_sub(hi, lo) / 2);
        if u64_at(in ctx.origins, wrapping_mul(mid, 3)) <= start {
            lo = inc(mid);
        } else {
            hi = mid;
        }
    }
    if lo == 0 {
        return (start, end);
    }
    let at = wrapping_mul(wrapping_sub(lo, 1), 3);
    (u64_at(in ctx.origins, inc(at)), u64_at(in ctx.origins, wrapping_add(at, 2)))
}
