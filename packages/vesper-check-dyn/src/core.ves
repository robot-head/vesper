// The state of @vesper/check-dyn and the helpers both passes share: node
// accessors and constructors over the @vesper/ast arenas, the AST type
// predicates of `src/dyn_trait.rs` and `src/dyn_fn.rs`, AST types as
// hash-consed @vesper/check-data ids (equality, `Display`, `Debug`), the
// type walker of `pact_frontend::walk_function_spans`, `free_names`, and
// diagnostics.
//
// The tree is the @vesper/ast index graph: a node is rewritten in place by
// overwriting its arena row, so a parent's child index stays valid (Rust
// rewrites `e.kind` behind a `&mut Expr`). Type, effect and list nodes are
// never overwritten: the parser may share them, so a rewrite of a type
// allocates new nodes (copy on write) and repoints the owner.

use @vesper/ast::{
    Ast,
    ListRef,
    ExprNode,
    PatNode,
    TypeNode,
    StmtNode,
    ArgNode,
    ClauseNode,
    ParamNode,
    EffectsNode,
    EffectNode,
    GenericNode,
    FieldNode,
    VariantNode,
    AdtNode,
    FnNode,
    EffectDeclNode,
    ImplNode,
    TraitNode,
    AssocDeclNode,
    TraitRefNode,
    ConfNode,
    ItemNode,
    BoundNode,
    list_len,
    list_at,
    expr_at,
    pat_at,
    type_at
};
use @vesper-std/arena::{
    idx_from_raw
};
use @vesper-std/intern::{
    symbol_from_id
};
use @vesper/check-data::names::{
    Names,
    names_new
};
use @vesper/check-data::types::{
    Types,
    EffNode,
    types_new,
    display
};
use @vesper/check-data::diag::{
    Diags,
    diags_new
};

const NONE: u32 = 4294967295;

// Well-known symbols of the AST interner.
pub copy struct K {
    empty: u32,
    dyn_: u32,
    box_: u32,
    box_new: u32,
    fn_: u32,
    fn_mut: u32,
    fn_once: u32,
    call: u32,
    self_: u32,
    self_ty: u32,
    self_field: u32,
    dollar_self: u32,
    i64_: u32,
    bool_: u32,
    f64_: u32,
    string_: u32,
    push: u32
}

// The state of one run over a module.
pub struct D {
    ast: Ast,
    // check-data names and types, for type equality, Display and Debug.
    names: Names,
    types: Types,
    // AST symbol -> check-data symbol + 1; AST type -> type id + 1.
    nmap: ChunkSeq[u32],
    tmap: ChunkSeq[u32],
    diags: Diags,
    buf: String,
    scratch: ChunkSeq[u8],
    stk: ChunkSeq[u32],
    k: K,
    // Shared nodes: `Type::Infer` and the literal types `dyn_fn` infers.
    t_infer: u32,
    t_i64: u32,
    t_bool: u32,
    t_f64: u32,
    t_string: u32,
    // ---- dyn_fn (`Lowering`)
    base: u64,
    next_span: u64,
    o_start: u32,
    o_end: u32,
    // (first synthetic span start, origin start, origin end) triples.
    origins: ChunkSeq[u64],
    // Hidden traits: name symbol and trait node, in creation order.
    tr_names: ChunkSeq[u32],
    tr_nodes: ChunkSeq[u32],
    // Generated closure ADTs and conformances, in pairs.
    gen_adts: ChunkSeq[u32],
    gen_confs: ChunkSeq[u32],
    generics: ChunkSeq[u32],
    result: u32,
    // `Env`: a binding stack; the latest binding of a name wins.
    env_k: ChunkSeq[u32],
    env_t: ChunkSeq[u32],
    // `Decls`: symbol -> function + 1, non-enum ADT + 1, linear flag;
    // methods as rows chained per method symbol.
    fn_by: ChunkSeq[u32],
    adt_by: ChunkSeq[u32],
    linear: ChunkSeq[u8],
    m_ty: ChunkSeq[u32],
    m_fn: ChunkSeq[u32],
    m_next: ChunkSeq[u32],
    m_head: ChunkSeq[u32],
    // ---- dyn_trait (`Lowered`)
    // symbol -> trait node + 1 (the last declaration wins, as a BTreeMap).
    trait_by: ChunkSeq[u32],
    // `checked_objects`: hashes of the Display text of checked traits.
    checked: ChunkSeq[u64],
    // `params`: (owner, hidden generic, trait type) rows; `p_live` is 0
    // for a row a later insert of the same owner replaced.
    p_owner: ChunkSeq[u32],
    p_g: ChunkSeq[u32],
    p_tr: ChunkSeq[u32],
    p_live: ChunkSeq[u8],
    // `forwards`: ten words per row (see `push_forward`).
    fwd: ChunkSeq[u64],
    // `boxed`: trait name symbols (sorted and deduplicated on output).
    boxed: ChunkSeq[u32]
}

fn intern(inout a: Ast, in s: Str) -> u32 {
    a.names.intern(in s).id()
}

pub fn d_new(sink ast: Ast, base: u64) -> D {
    let mut a = ast;
    let k = K {
        empty: intern(inout a, in ""),
        dyn_: intern(inout a, in "dyn"),
        box_: intern(inout a, in "Box"),
        box_new: intern(inout a, in "Box::new"),
        fn_: intern(inout a, in "Fn"),
        fn_mut: intern(inout a, in "FnMut"),
        fn_once: intern(inout a, in "FnOnce"),
        call: intern(inout a, in "call"),
        self_: intern(inout a, in "self"),
        self_ty: intern(inout a, in "Self"),
        self_field: intern(inout a, in "self_"),
        dollar_self: intern(inout a, in "$self"),
        i64_: intern(inout a, in "i64"),
        bool_: intern(inout a, in "bool"),
        f64_: intern(inout a, in "f64"),
        string_: intern(inout a, in "String"),
        push: intern(inout a, in "push")
    };
    let mut names = names_new();
    let types = types_new(inout names);
    let mut d = D {
        ast: a,
        names: names,
        types: types,
        nmap: ChunkSeq::new[u32](),
        tmap: ChunkSeq::new[u32](),
        diags: diags_new(),
        buf: String::new(),
        scratch: ChunkSeq::new[u8](),
        stk: ChunkSeq::new[u32](),
        k: k,
        t_infer: 0,
        t_i64: 0,
        t_bool: 0,
        t_f64: 0,
        t_string: 0,
        base: base,
        next_span: wrapping_add(base, base & 1),
        o_start: 0,
        o_end: 0,
        origins: ChunkSeq::new[u64](),
        tr_names: ChunkSeq::new[u32](),
        tr_nodes: ChunkSeq::new[u32](),
        gen_adts: ChunkSeq::new[u32](),
        gen_confs: ChunkSeq::new[u32](),
        generics: ChunkSeq::new[u32](),
        result: 0,
        env_k: ChunkSeq::new[u32](),
        env_t: ChunkSeq::new[u32](),
        fn_by: ChunkSeq::new[u32](),
        adt_by: ChunkSeq::new[u32](),
        linear: ChunkSeq::new[u8](),
        m_ty: ChunkSeq::new[u32](),
        m_fn: ChunkSeq::new[u32](),
        m_next: ChunkSeq::new[u32](),
        m_head: ChunkSeq::new[u32](),
        trait_by: ChunkSeq::new[u32](),
        checked: ChunkSeq::new[u64](),
        p_owner: ChunkSeq::new[u32](),
        p_g: ChunkSeq::new[u32](),
        p_tr: ChunkSeq::new[u32](),
        p_live: ChunkSeq::new[u8](),
        fwd: ChunkSeq::new[u64](),
        boxed: ChunkSeq::new[u32]()
    };
    let infer = new_type(inout d, 5, 0, 0, 0, 0);
    d.t_infer = infer;
    let i = new_type(inout d, 1, d.k.i64_, 0, 0, 0);
    d.t_i64 = i;
    let b = new_type(inout d, 1, d.k.bool_, 0, 0, 0);
    d.t_bool = b;
    let f = new_type(inout d, 1, d.k.f64_, 0, 0, 0);
    d.t_f64 = f;
    let s = new_type(inout d, 1, d.k.string_, 0, 0, 0);
    d.t_string = s;
    d
}

// ---------------------------------------------------------------- words

pub fn w(x: u32) -> u64 {
    widen_u64(x)
}

pub fn n32(x: u64) -> u32 {
    wrapping_u32(x)
}

pub fn inc(x: u64) -> u64 {
    wrapping_add(x, 1)
}

pub fn u32_at(in s: ChunkSeq[u32], i: u64) -> u32 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => NONE,
    }
}

pub fn u64_at(in s: ChunkSeq[u64], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

pub fn u8_at(in s: ChunkSeq[u8], i: u64) -> u8 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

// A symbol-indexed table entry (0 = absent).
pub fn table_get(in t: ChunkSeq[u32], s: u32) -> u32 {
    if s == NONE {
        return 0;
    }
    match t.try_get(w(s)) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

pub fn table_set(inout t: ChunkSeq[u32], s: u32, v: u32) {
    if s == NONE {
        return;
    }
    if t.len() <= w(s) {
        t.resize(inc(w(s)), 0);
    }
    let ok = t.try_set(w(s), v);
}

pub fn contains(in s: ChunkSeq[u32], x: u32) -> bool {
    for i in 0..s.len() {
        if u32_at(in s, i) == x {
            return true;
        }
    }
    false
}

// ---------------------------------------------------------------- nodes

pub fn ll(in d: D, l: u32) -> u64 {
    list_len(in d.ast, l)
}

pub fn la(in d: D, l: u32, i: u64) -> u32 {
    list_at(in d.ast, l, i)
}

// A new list of `words` (list 0 is the shared empty list).
pub fn mk_list(inout d: D, in words: ChunkSeq[u32]) -> u32 {
    let n = words.len();
    if n == 0 {
        return 0;
    }
    let first = n32(d.ast.pool.len());
    for i in 0..n {
        d.ast.pool.push(u32_at(in words, i));
    }
    let r = d
        .ast
        .lists
        .alloc(
            ListRef {
                first: first,
                len: n32(n)
            }
        );
    r.raw()
}

pub fn list1(inout d: D, x: u32) -> u32 {
    let mut s = ChunkSeq::new[u32]();
    s.push(x);
    mk_list(inout d, in s)
}

// The words of list `l`.
pub fn list_words(in d: D, l: u32) -> ChunkSeq[u32] {
    let n = ll(in d, l);
    let mut s = ChunkSeq::with_capacity[u32](n);
    for i in 0..n {
        s.push(la(in d, l, i));
    }
    s
}

pub fn ex(in d: D, e: u32) -> ExprNode {
    expr_at(in d.ast, e)
}

pub fn set_ex(inout d: D, e: u32, n: ExprNode) {
    let ok = d.ast.exprs.set(idx_from_raw[ExprNode](e), n);
}

pub fn new_ex(inout d: D, n: ExprNode) -> u32 {
    d.ast.exprs.alloc(n).raw()
}

pub fn exn(kind: u8, start: u32, end: u32, a: u32, b: u32, c: u32) -> ExprNode {
    ExprNode {
        kind: kind,
        start: start,
        end: end,
        a: a,
        b: b,
        c: c,
        d: NONE,
        e: NONE
    }
}

pub fn pt(in d: D, p: u32) -> PatNode {
    pat_at(in d.ast, p)
}

pub fn new_pat(inout d: D, kind: u8, start: u32, end: u32, a: u32, b: u32, c: u32) -> u32 {
    d
        .ast
        .pats
        .alloc(
            PatNode {
                kind: kind,
                start: start,
                end: end,
                a: a,
                b: b,
                c: c
            }
        )
        .raw()
}

pub fn ty(in d: D, t: u32) -> TypeNode {
    type_at(in d.ast, t)
}

pub fn new_type(inout d: D, kind: u8, a: u32, b: u32, c: u32, dd: u32) -> u32 {
    d
        .ast
        .types
        .alloc(
            TypeNode {
                kind: kind,
                a: a,
                b: b,
                c: c,
                d: dd
            }
        )
        .raw()
}

pub fn named(inout d: D, name: u32, args: u32) -> u32 {
    new_type(inout d, 1, name, args, 0, 0)
}

pub fn stmt_at(in d: D, s: u32) -> StmtNode {
    d
        .ast
        .stmts
        .get_or(
            idx_from_raw[StmtNode](s),
            StmtNode {
                kind: 0,
                pat: NONE,
                ty: NONE,
                value: NONE,
                mutable: false
            }
        )
}

pub fn set_stmt(inout d: D, s: u32, n: StmtNode) {
    let ok = d.ast.stmts.set(idx_from_raw[StmtNode](s), n);
}

pub fn new_stmt(inout d: D, n: StmtNode) -> u32 {
    d.ast.stmts.alloc(n).raw()
}

