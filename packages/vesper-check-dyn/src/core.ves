// The state of @vesper/check-dyn and the helpers both passes share: node
// accessors and constructors over the @vesper/ast arenas, the AST type
// predicates of `src/dyn_trait.rs` and `src/dyn_fn.rs`, AST types as
// hash-consed @vesper/check-data ids (equality, `Display`, `Debug`), the
// type walker of `pact_frontend::walk_function_spans`, `free_names`, and
// diagnostics.
//
// The tree is the @vesper/ast index graph: a node is rewritten in place by
// overwriting its arena row, so a parent's child index stays valid (Rust
// rewrites `e.kind` behind a `&mut Expr`). Type, effect and list nodes are
// never overwritten: the parser may share them, so a rewrite of a type
// allocates new nodes (copy on write) and repoints the owner.

use @vesper/ast::{
    Ast, ListRef, ExprNode, PatNode, TypeNode, StmtNode, ArgNode, ClauseNode, ParamNode,
    EffectsNode, EffectNode, GenericNode, FieldNode, VariantNode, AdtNode, FnNode, EffectDeclNode,
    ImplNode, TraitNode, AssocDeclNode, TraitRefNode, ConfNode, ItemNode, BoundNode, list_len,
    list_at, expr_at, pat_at, type_at
};
use @vesper-std/arena::{idx_from_raw};
use @vesper-std/intern::{symbol_from_id};
use @vesper/check-data::names::{Names, names_new};
use @vesper/check-data::types::{Types, EffNode, types_new, display};
use @vesper/check-data::diag::{Diags, diags_new};

const NONE: u32 = 4294967295;

// Well-known symbols of the AST interner.
pub copy struct K {
    empty: u32,
    dyn_: u32,
    box_: u32,
    box_new: u32,
    fn_: u32,
    fn_mut: u32,
    fn_once: u32,
    call: u32,
    self_: u32,
    self_ty: u32,
    self_field: u32,
    dollar_self: u32,
    i64_: u32,
    bool_: u32,
    f64_: u32,
    string_: u32,
    push: u32
}

// The state of one run over a module.
pub struct D {
    ast: Ast,
    // check-data names and types, for type equality, Display and Debug.
    names: Names,
    types: Types,
    // AST symbol -> check-data symbol + 1; AST type -> type id + 1.
    sym_map: ChunkSeq[u32],
    type_map: ChunkSeq[u32],
    diags: Diags,
    buf: String,
    scratch: ChunkSeq[u8],
    stack: ChunkSeq[u32],
    known: K,
    // Shared nodes: `Type::Infer` and the literal types `dyn_fn` infers.
    t_infer: u32,
    t_i64: u32,
    t_bool: u32,
    t_f64: u32,
    t_string: u32,
    // ---- dyn_fn (`Lowering`)
    base: u64,
    next_span: u64,
    origin_start: u32,
    origin_end: u32,
    // (first synthetic span start, origin start, origin end) triples.
    origins: ChunkSeq[u64],
    // Hidden traits: name symbol and trait node, in creation order.
    trait_names: ChunkSeq[u32],
    trait_nodes: ChunkSeq[u32],
    // Generated closure ADTs and conformances, in pairs.
    gen_adts: ChunkSeq[u32],
    gen_confs: ChunkSeq[u32],
    generics: ChunkSeq[u32],
    result: u32,
    // `Env`: a binding stack; the latest binding of a name wins.
    env_names: ChunkSeq[u32],
    env_types: ChunkSeq[u32],
    // `Decls`: symbol -> function + 1, non-enum ADT + 1, linear flag;
    // methods as rows chained per method symbol.
    fn_by_name: ChunkSeq[u32],
    adt_by_name: ChunkSeq[u32],
    linear: ChunkSeq[u8],
    method_owner: ChunkSeq[u32],
    method_fn: ChunkSeq[u32],
    method_next: ChunkSeq[u32],
    method_head: ChunkSeq[u32],
    // ---- dyn_trait (`Lowered`)
    // symbol -> trait node + 1 (the last declaration wins, as a BTreeMap).
    trait_by_name: ChunkSeq[u32],
    // `checked_objects`: hashes of the Display text of checked traits.
    checked: ChunkSeq[u64],
    // `params`: (owner, hidden generic, trait type) rows; `param_live` is 0
    // for a row a later insert of the same owner replaced.
    param_owner: ChunkSeq[u32],
    param_generic: ChunkSeq[u32],
    param_trait: ChunkSeq[u32],
    param_live: ChunkSeq[u8],
    // `forwards`: ten words per row (see `push_forward`).
    forwards: ChunkSeq[u64],
    // `boxed`: trait name symbols (sorted and deduplicated on output).
    boxed: ChunkSeq[u32]
}

fn intern(inout ast: Ast, in text: Str) -> u32 {
    ast.names.intern(in text).id()
}

pub fn d_new(sink ast: Ast, base: u64) -> D {
    let mut module = ast;
    let known = K {
        empty: intern(inout module, in ""),
        dyn_: intern(inout module, in "dyn"),
        box_: intern(inout module, in "Box"),
        box_new: intern(inout module, in "Box::new"),
        fn_: intern(inout module, in "Fn"),
        fn_mut: intern(inout module, in "FnMut"),
        fn_once: intern(inout module, in "FnOnce"),
        call: intern(inout module, in "call"),
        self_: intern(inout module, in "self"),
        self_ty: intern(inout module, in "Self"),
        self_field: intern(inout module, in "self_"),
        dollar_self: intern(inout module, in "$self"),
        i64_: intern(inout module, in "i64"),
        bool_: intern(inout module, in "bool"),
        f64_: intern(inout module, in "f64"),
        string_: intern(inout module, in "String"),
        push: intern(inout module, in "push")
    };
    let mut names = names_new();
    let types = types_new(inout names);
    let mut ctx = D {
        ast: module,
        names: names,
        types: types,
        sym_map: ChunkSeq::new[u32](),
        type_map: ChunkSeq::new[u32](),
        diags: diags_new(),
        buf: String::new(),
        scratch: ChunkSeq::new[u8](),
        stack: ChunkSeq::new[u32](),
        known: known,
        t_infer: 0,
        t_i64: 0,
        t_bool: 0,
        t_f64: 0,
        t_string: 0,
        base: base,
        next_span: wrapping_add(base, base & 1),
        origin_start: 0,
        origin_end: 0,
        origins: ChunkSeq::new[u64](),
        trait_names: ChunkSeq::new[u32](),
        trait_nodes: ChunkSeq::new[u32](),
        gen_adts: ChunkSeq::new[u32](),
        gen_confs: ChunkSeq::new[u32](),
        generics: ChunkSeq::new[u32](),
        result: 0,
        env_names: ChunkSeq::new[u32](),
        env_types: ChunkSeq::new[u32](),
        fn_by_name: ChunkSeq::new[u32](),
        adt_by_name: ChunkSeq::new[u32](),
        linear: ChunkSeq::new[u8](),
        method_owner: ChunkSeq::new[u32](),
        method_fn: ChunkSeq::new[u32](),
        method_next: ChunkSeq::new[u32](),
        method_head: ChunkSeq::new[u32](),
        trait_by_name: ChunkSeq::new[u32](),
        checked: ChunkSeq::new[u64](),
        param_owner: ChunkSeq::new[u32](),
        param_generic: ChunkSeq::new[u32](),
        param_trait: ChunkSeq::new[u32](),
        param_live: ChunkSeq::new[u8](),
        forwards: ChunkSeq::new[u64](),
        boxed: ChunkSeq::new[u32]()
    };
    let infer_ty = new_type(inout ctx, 5, 0, 0, 0, 0);
    ctx.t_infer = infer_ty;
    let i64_ty = new_type(inout ctx, 1, ctx.known.i64_, 0, 0, 0);
    ctx.t_i64 = i64_ty;
    let bool_ty = new_type(inout ctx, 1, ctx.known.bool_, 0, 0, 0);
    ctx.t_bool = bool_ty;
    let f64_ty = new_type(inout ctx, 1, ctx.known.f64_, 0, 0, 0);
    ctx.t_f64 = f64_ty;
    let string_ty = new_type(inout ctx, 1, ctx.known.string_, 0, 0, 0);
    ctx.t_string = string_ty;
    ctx
}

// ---------------------------------------------------------------- words

pub fn w(value: u32) -> u64 {
    widen_u64(value)
}

pub fn n32(value: u64) -> u32 {
    wrapping_u32(value)
}

pub fn inc(value: u64) -> u64 {
    wrapping_add(value, 1)
}

pub fn u32_at(in seq: ChunkSeq[u32], i: u64) -> u32 {
    seq.try_get(i).unwrap_or(NONE)
}

pub fn u64_at(in seq: ChunkSeq[u64], i: u64) -> u64 {
    seq.try_get(i).unwrap_or(0)
}

pub fn u8_at(in seq: ChunkSeq[u8], i: u64) -> u8 {
    seq.try_get(i).unwrap_or(0)
}

// A symbol-indexed table entry (0 = absent).
pub fn table_get(in table: ChunkSeq[u32], sym: u32) -> u32 {
    if sym == NONE {
        return 0;
    }
    table.try_get(w(sym)).unwrap_or(0)
}

pub fn table_set(inout table: ChunkSeq[u32], sym: u32, value: u32) {
    if sym == NONE {
        return;
    }
    if table.len() <= w(sym) {
        table.resize(inc(w(sym)), 0);
    }
    let ok = table.try_set(w(sym), value);
}

pub fn contains(in seq: ChunkSeq[u32], word: u32) -> bool {
    for i in 0..seq.len() {
        if u32_at(in seq, i) == word {
            return true;
        }
    }
    false
}

// ---------------------------------------------------------------- nodes

pub fn ll(in ctx: D, list: u32) -> u64 {
    list_len(in ctx.ast, list)
}

pub fn la(in ctx: D, list: u32, i: u64) -> u32 {
    list_at(in ctx.ast, list, i)
}

// A new list of `words` (list 0 is the shared empty list).
pub fn mk_list(inout ctx: D, in words: ChunkSeq[u32]) -> u32 {
    let n = words.len();
    if n == 0 {
        return 0;
    }
    let first = n32(ctx.ast.pool.len());
    for i in 0..n {
        ctx.ast.pool.push(u32_at(in words, i));
    }
    let list = ctx.ast.lists.alloc(ListRef { first: first, len: n32(n) });
    list.raw()
}

pub fn list1(inout ctx: D, word: u32) -> u32 {
    let mut words = ChunkSeq::new[u32]();
    words.push(word);
    mk_list(inout ctx, in words)
}

// The words of list `list`.
pub fn list_words(in ctx: D, list: u32) -> ChunkSeq[u32] {
    let n = ll(in ctx, list);
    let mut words = ChunkSeq::with_capacity[u32](n);
    for i in 0..n {
        words.push(la(in ctx, list, i));
    }
    words
}

pub fn ex(in ctx: D, expr: u32) -> ExprNode {
    expr_at(in ctx.ast, expr)
}

pub fn set_ex(inout ctx: D, expr: u32, row: ExprNode) {
    let ok = ctx.ast.exprs.set(idx_from_raw[ExprNode](expr), row);
}

pub fn new_ex(inout ctx: D, row: ExprNode) -> u32 {
    ctx.ast.exprs.alloc(row).raw()
}

pub fn exn(kind: u8, start: u32, end: u32, a: u32, b: u32, c: u32) -> ExprNode {
    ExprNode { kind: kind, start: start, end: end, a: a, b: b, c: c, d: NONE, e: NONE }
}

pub fn pt(in ctx: D, pat: u32) -> PatNode {
    pat_at(in ctx.ast, pat)
}

pub fn new_pat(inout ctx: D, kind: u8, start: u32, end: u32, a: u32, b: u32, c: u32) -> u32 {
    ctx.ast.pats.alloc(PatNode { kind: kind, start: start, end: end, a: a, b: b, c: c }).raw()
}

pub fn ty(in ctx: D, ast_ty: u32) -> TypeNode {
    type_at(in ctx.ast, ast_ty)
}

pub fn new_type(inout ctx: D, kind: u8, a: u32, b: u32, c: u32, d: u32) -> u32 {
    ctx.ast.types.alloc(TypeNode { kind: kind, a: a, b: b, c: c, d: d }).raw()
}

pub fn named(inout ctx: D, name: u32, args: u32) -> u32 {
    new_type(inout ctx, 1, name, args, 0, 0)
}

pub fn stmt_at(in ctx: D, stmt: u32) -> StmtNode {
    ctx.ast.stmts.get_or(
        idx_from_raw[StmtNode](stmt),
        StmtNode { kind: 0, pat: NONE, ty: NONE, value: NONE, mutable: false }
    )
}

pub fn set_stmt(inout ctx: D, stmt: u32, row: StmtNode) {
    let ok = ctx.ast.stmts.set(idx_from_raw[StmtNode](stmt), row);
}

pub fn new_stmt(inout ctx: D, row: StmtNode) -> u32 {
    ctx.ast.stmts.alloc(row).raw()
}

pub fn arg_at(in ctx: D, arg: u32) -> ArgNode {
    ctx.ast
        .args
        .get_or(idx_from_raw[ArgNode](arg), ArgNode { pass: 0, explicit: false, expr: NONE })
}

pub fn clause_at(in ctx: D, clause: u32) -> ClauseNode {
    ctx.ast
        .clauses
        .get_or(idx_from_raw[ClauseNode](clause), ClauseNode { name: NONE, pats: 0, body: NONE })
}

pub fn param_at(in ctx: D, param: u32) -> ParamNode {
    ctx.ast.params.get_or(
        idx_from_raw[ParamNode](param),
        ParamNode { name: NONE, pass: 0, projections: 0, ty: NONE, start: 0, end: 0 }
    )
}

pub fn set_param(inout ctx: D, param: u32, row: ParamNode) {
    let ok = ctx.ast.params.set(idx_from_raw[ParamNode](param), row);
}

pub fn new_param(inout ctx: D, row: ParamNode) -> u32 {
    ctx.ast.params.alloc(row).raw()
}

pub fn effects_at(in ctx: D, effects: u32) -> EffectsNode {
    ctx.ast
        .effects
        .get_or(idx_from_raw[EffectsNode](effects), EffectsNode { instances: 0, tail: NONE })
}

pub fn new_effects(inout ctx: D, instances: u32, tail: u32) -> u32 {
    ctx.ast.effects.alloc(EffectsNode { instances: instances, tail: tail }).raw()
}

pub fn effect_at(in ctx: D, effect: u32) -> EffectNode {
    ctx.ast
        .effect_nodes
        .get_or(idx_from_raw[EffectNode](effect), EffectNode { label: NONE, name: NONE, args: 0 })
}

pub fn new_effect(inout ctx: D, label: u32, name: u32, args: u32) -> u32 {
    ctx.ast.effect_nodes.alloc(EffectNode { label: label, name: name, args: args }).raw()
}

pub fn generic_at(in ctx: D, generic: u32) -> GenericNode {
    ctx.ast.generics.get_or(
        idx_from_raw[GenericNode](generic),
        GenericNode { name: NONE, bound: 0, row: false }
    )
}

pub fn new_generic(inout ctx: D, name: u32, bound: u8) -> u32 {
    ctx.ast.generics.alloc(GenericNode { name: name, bound: bound, row: false }).raw()
}

pub fn field_at(in ctx: D, field: u32) -> FieldNode {
    ctx.ast.fields.get_or(
        idx_from_raw[FieldNode](field),
        FieldNode { name: NONE, ty: NONE, modality: 3, temperature: 0 }
    )
}

pub fn set_field(inout ctx: D, field: u32, row: FieldNode) {
    let ok = ctx.ast.fields.set(idx_from_raw[FieldNode](field), row);
}

pub fn variant_at(in ctx: D, variant: u32) -> VariantNode {
    ctx.ast.variants.get_or(
        idx_from_raw[VariantNode](variant),
        VariantNode { name: NONE, fields: 0, named: false }
    )
}

pub fn adt_at(in ctx: D, adt: u32) -> AdtNode {
    ctx.ast.adts.get_or(
        idx_from_raw[AdtNode](adt),
        AdtNode {
            name: NONE,
            mode: 0,
            generics: 0,
            variants: 0,
            is_enum: false,
            tiled: false,
            tile_width: 0,
            start: 0,
            end: 0
        }
    )
}

pub fn fn_at(in ctx: D, func: u32) -> FnNode {
    ctx.ast.fns.get_or(
        idx_from_raw[FnNode](func),
        FnNode {
            name: NONE,
            fip: false,
            generics: 0,
            params: 0,
            result: NONE,
            effects: NONE,
            body: NONE,
            start: 0,
            end: 0
        }
    )
}

pub fn set_fn(inout ctx: D, func: u32, row: FnNode) {
    let ok = ctx.ast.fns.set(idx_from_raw[FnNode](func), row);
}

pub fn effect_decl_at(in ctx: D, decl: u32) -> EffectDeclNode {
    ctx.ast.effect_decls.get_or(
        idx_from_raw[EffectDeclNode](decl),
        EffectDeclNode { name: NONE, linear: false, generics: 0, ops: 0, start: 0, end: 0 }
    )
}

pub fn impl_at(in ctx: D, impl_: u32) -> ImplNode {
    ctx.ast
        .impls
        .get_or(idx_from_raw[ImplNode](impl_), ImplNode { ty: NONE, generics: 0, methods: 0 })
}

pub fn set_impl(inout ctx: D, impl_: u32, row: ImplNode) {
    let ok = ctx.ast.impls.set(idx_from_raw[ImplNode](impl_), row);
}

pub fn trait_at(in ctx: D, trait_: u32) -> TraitNode {
    ctx.ast.traits.get_or(
        idx_from_raw[TraitNode](trait_),
        TraitNode { name: NONE, public: false, generics: 0, assoc: 0, methods: 0, start: 0, end: 0 }
    )
}

pub fn assoc_at(in ctx: D, assoc: u32) -> AssocDeclNode {
    ctx.ast.assoc_decls.get_or(
        idx_from_raw[AssocDeclNode](assoc),
        AssocDeclNode { name: NONE, bound: 0, start: 0, end: 0 }
    )
}

pub fn trait_ref_at(in ctx: D, trait_ref: u32) -> TraitRefNode {
    ctx.ast.trait_refs.get_or(
        idx_from_raw[TraitRefNode](trait_ref),
        TraitRefNode { package: NONE, name: NONE, args: 0, start: 0, end: 0 }
    )
}

pub fn set_trait_ref(inout ctx: D, trait_ref: u32, row: TraitRefNode) {
    let ok = ctx.ast.trait_refs.set(idx_from_raw[TraitRefNode](trait_ref), row);
}

pub fn conf_at(in ctx: D, conf: u32) -> ConfNode {
    ctx.ast.confs.get_or(
        idx_from_raw[ConfNode](conf),
        ConfNode {
            model: NONE,
            public: false,
            generics: 0,
            trait_ref: NONE,
            self_ty: NONE,
            wheres: 0,
            assoc: 0,
            methods: 0,
            start: 0,
            end: 0
        }
    )
}

pub fn set_conf(inout ctx: D, conf: u32, row: ConfNode) {
    let ok = ctx.ast.confs.set(idx_from_raw[ConfNode](conf), row);
}

pub fn item_at(in ctx: D, item: u32) -> ItemNode {
    ctx.ast.items.get_or(idx_from_raw[ItemNode](item), ItemNode { kind: 0, node: NONE })
}

pub fn new_item(inout ctx: D, kind: u8, node: u32) -> u32 {
    ctx.ast.items.alloc(ItemNode { kind: kind, node: node }).raw()
}

pub fn new_bound(
    inout ctx: D,
    param: u32,
    trait_ref: u32,
    start: u32,
    end: u32,
    owner: u32
) -> u32 {
    ctx.ast
        .bounds
        .alloc(BoundNode {
            param: param,
            trait_ref: trait_ref,
            start: start,
            end: end,
            owner: owner
        })
        .raw()
}

// ---------------------------------------------------------------- symbols

pub fn intern_buf(inout ctx: D) -> u32 {
    ctx.ast.names.intern(in ctx.buf).id()
}

pub fn intern_str(inout ctx: D, in text: Str) -> u32 {
    ctx.ast.names.intern(in text).id()
}

// Appends symbol `sym` to `ctx.buf`.
pub fn buf_sym(inout ctx: D, sym: u32) {
    if sym == NONE {
        return;
    }
    let ok = ctx.ast.names.resolve_into(symbol_from_id(sym), inout ctx.buf);
}

pub fn buf_decimal(inout ctx: D, value: u64) {
    if value >= 10 {
        buf_decimal(inout ctx, value / 10);
    }
    ctx.buf.push_char(wrapping_u32(wrapping_add(value % 10, 48)));
}

pub fn sym_len(in ast: Ast, sym: u32) -> u64 {
    let (text_start, text_end) = ast.names.span(symbol_from_id(sym));
    wrapping_sub(text_end, text_start)
}

pub fn sym_byte(in ast: Ast, sym: u32, i: u64) -> u8 {
    let (text_start, text_end) = ast.names.span(symbol_from_id(sym));
    ast.names.text_byte(wrapping_add(text_start, i)).unwrap_or(0)
}

// Byte order of two symbols' texts (`String`'s `Ord`): -1, 0 or 1.
pub fn sym_cmp(in ast: Ast, left: u32, right: u32) -> i64 {
    if left == right {
        return 0;
    }
    let (left_start, left_end) = ast.names.span(symbol_from_id(left));
    let (right_start, right_end) = ast.names.span(symbol_from_id(right));
    let left_len = wrapping_sub(left_end, left_start);
    let right_len = wrapping_sub(right_end, right_start);
    let n = if left_len < right_len {
        left_len
    } else {
        right_len
    };
    for i in 0..n {
        let left_byte = ast.names.text_byte(wrapping_add(left_start, i)).unwrap_or(0);
        let right_byte = ast.names.text_byte(wrapping_add(right_start, i)).unwrap_or(0);
        if left_byte < right_byte {
            return -1;
        }
        if left_byte > right_byte {
            return 1;
        }
    }
    if left_len < right_len {
        -1
    } else if left_len > right_len {
        1
    } else {
        0
    }
}

// Sorts symbols by text and drops repeats (a `BTreeSet<String>`).
pub fn sort_syms(in ast: Ast, inout syms: ChunkSeq[u32]) {
    let n = syms.len();
    for i in 1..n {
        let sym = u32_at(in syms, i);
        let mut j = i;
        loop {
            if j == 0 {
                break;
            }
            let prev = u32_at(in syms, wrapping_sub(j, 1));
            if sym_cmp(in ast, prev, sym) <= 0 {
                break;
            }
            let ok = syms.try_set(j, prev);
            j = wrapping_sub(j, 1);
        }
        let ok = syms.try_set(j, sym);
    }
    let mut kept: u64 = 0;
    for i in 0..n {
        let sym = u32_at(in syms, i);
        if kept == 0 || u32_at(in syms, wrapping_sub(kept, 1)) != sym {
            let ok = syms.try_set(kept, sym);
            kept = inc(kept);
        }
    }
    syms.truncate(kept);
}

// Whether symbol `sym` ends with the bytes of `suffix`.
pub fn sym_ends_with(in ast: Ast, sym: u32, in suffix: Str) -> bool {
    let suffix_bytes = suffix.as_bytes();
    let n = sym_len(in ast, sym);
    if suffix_bytes.len() > n {
        return false;
    }
    let offset = wrapping_sub(n, suffix_bytes.len());
    for i in 0..suffix_bytes.len() {
        let byte = suffix_bytes.try_get(i).unwrap_or(0);
        if sym_byte(in ast, sym, wrapping_add(offset, i)) != byte {
            return false;
        }
    }
    true
}

// ---------------------------------------------------------------- types as ids

// The check-data symbol of AST symbol `sym`.
pub fn nsym(inout ctx: D, sym: u32) -> u32 {
    let entry = table_get(in ctx.sym_map, sym);
    if entry != 0 {
        return wrapping_sub(entry, 1);
    }
    ctx.buf.clear();
    buf_sym(inout ctx, sym);
    let data_sym = ctx.names.intern(in ctx.buf.as_bytes());
    table_set(inout ctx.sym_map, sym, wrapping_add(data_sym, 1));
    data_sym
}

// The hash-consed id of AST type `ast_ty`: equal types have equal ids.
pub fn tid(inout ctx: D, ast_ty: u32) -> u32 {
    let entry = table_get(in ctx.type_map, ast_ty);
    if entry != 0 {
        return wrapping_sub(entry, 1);
    }
    let node = ty(in ctx, ast_ty);
    let mut id: u32 = ctx.types.infer;
    if node.kind == 1 || node.kind == 2 {
        let len = ll(in ctx, node.b);
        let list = if node.kind == 1 { node.b } else { node.a };
        let arg_count = ll(in ctx, list);
        let mut args = ChunkSeq::with_capacity[u32](arg_count);
        for j in 0..arg_count {
            let arg = la(in ctx, list, j);
            let arg_id = tid(inout ctx, arg);
            args.push(arg_id);
        }
        if node.kind == 1 {
            let name = nsym(inout ctx, node.a);
            id = ctx.types.named(name, in args);
        } else {
            id = ctx.types.tuple(in args);
        }
    } else if node.kind == 3 {
        let len = ll(in ctx, node.a) / 2;
        let mut items = ChunkSeq::with_capacity[u32](len);
        let mut passes = ChunkSeq::with_capacity[u8](len);
        for j in 0..len {
            let pass = la(in ctx, node.a, wrapping_mul(j, 2));
            let param_ty = la(in ctx, node.a, inc(wrapping_mul(j, 2)));
            passes.push(wrapping_u8(pass));
            let param_id = tid(inout ctx, param_ty);
            items.push(param_id);
        }
        let result_id = tid(inout ctx, node.b);
        let row = rid(inout ctx, node.c);
        id = ctx.types.mk_with(3, wrapping_u8(node.d), 0, in items, in passes, result_id, row, 0);
    } else if node.kind == 4 {
        let row = rid(inout ctx, node.a);
        id = ctx.types.row_type(row);
    } else if node.kind == 6 {
        id = ctx.types.literal(false, 0);
    }
    table_set(inout ctx.type_map, ast_ty, wrapping_add(id, 1));
    id
}

// The row id of an AST `Effects` node.
pub fn rid(inout ctx: D, effects: u32) -> u32 {
    let effects_row = effects_at(in ctx, effects);
    let n = ll(in ctx, effects_row.instances);
    let mut effect_nodes = ChunkSeq::new[EffNode]();
    let mut args = ChunkSeq::new[u32]();
    for j in 0..n {
        let effect = effect_at(in ctx, la(in ctx, effects_row.instances, j));
        let arg_start = n32(args.len());
        let arg_count = ll(in ctx, effect.args);
        for arg_index in 0..arg_count {
            let arg_ty = la(in ctx, effect.args, arg_index);
            let arg_id = tid(inout ctx, arg_ty);
            args.push(arg_id);
        }
        let label = if effect.label == NONE {
            0
        } else {
            wrapping_add(nsym(inout ctx, effect.label), 1)
        };
        let name = nsym(inout ctx, effect.name);
        effect_nodes.push(EffNode { label: label, name: name, a: arg_start, n: n32(arg_count) });
    }
    let tail = if effects_row.tail == NONE {
        0
    } else {
        wrapping_add(nsym(inout ctx, effects_row.tail), 1)
    };
    ctx.types.mk_row(in effect_nodes, in args, tail)
}

pub fn teq(inout ctx: D, a: u32, b: u32) -> bool {
    let a_id = tid(inout ctx, a);
    let b_id = tid(inout ctx, b);
    a_id == b_id
}

// `Effect` equality (label, name, arguments).
pub fn effect_eq(inout ctx: D, a: u32, b: u32) -> bool {
    let a_effect = effect_at(in ctx, a);
    let b_effect = effect_at(in ctx, b);
    if a_effect.label != b_effect.label || a_effect.name != b_effect.name {
        return false;
    }
    let n = ll(in ctx, a_effect.args);
    if n != ll(in ctx, b_effect.args) {
        return false;
    }
    for i in 0..n {
        if !teq(inout ctx, la(in ctx, a_effect.args, i), la(in ctx, b_effect.args, i)) {
            return false;
        }
    }
    true
}

// `Display` of AST type `ast_ty`, appended to `out`.
pub fn display_into(inout ctx: D, ast_ty: u32, inout out: ChunkSeq[u8]) {
    let id = tid(inout ctx, ast_ty);
    display(in ctx.types, in ctx.names, id, inout out);
}

// ---------------------------------------------------------------- type predicates

pub fn is_infer(in ctx: D, ast_ty: u32) -> bool {
    ty(in ctx, ast_ty).kind == 5
}

// `Type::name`: the name of a Named type, else NONE ("").
pub fn type_name(in ctx: D, ast_ty: u32) -> u32 {
    let node = ty(in ctx, ast_ty);
    if node.kind == 1 { node.a } else { NONE }
}

// `dyn_trait::object_trait`: the trait of `dyn Trait[args]`, or NONE.
pub fn object_trait(in ctx: D, ast_ty: u32) -> u32 {
    let node = ty(in ctx, ast_ty);
    if node.kind == 1 && node.a == ctx.known.dyn_ && ll(in ctx, node.b) == 1 {
        la(in ctx, node.b, 0)
    } else {
        NONE
    }
}

pub fn is_object(in ctx: D, ast_ty: u32) -> bool {
    object_trait(in ctx, ast_ty) != NONE
}

// `dyn_trait::boxed_trait`: the trait of `Box[dyn Trait[args]]`, or NONE.
pub fn boxed_trait(in ctx: D, ast_ty: u32) -> u32 {
    let node = ty(in ctx, ast_ty);
    if node.kind == 1 && node.a == ctx.known.box_ && ll(in ctx, node.b) == 1 {
        object_trait(in ctx, la(in ctx, node.b, 0))
    } else {
        NONE
    }
}

// `dyn_fn::fn_object`: the signature of `dyn Fn(..)`, `dyn FnMut(..)` or
// `dyn FnOnce(..)` (its kind is `type_name(object_trait(ast_ty))`), or NONE.
pub fn fn_sig(in ctx: D, ast_ty: u32) -> u32 {
    let trait_ty = object_trait(in ctx, ast_ty);
    if trait_ty == NONE {
        return NONE;
    }
    let node = ty(in ctx, trait_ty);
    if node.kind != 1
        || (node.a != ctx.known.fn_ && node.a != ctx.known.fn_mut && node.a != ctx.known.fn_once) {
        return NONE;
    }
    if ll(in ctx, node.b) != 1 {
        return NONE;
    }
    let sig = la(in ctx, node.b, 0);
    if ty(in ctx, sig).kind == 3 { sig } else { NONE }
}

pub fn fn_kind(in ctx: D, ast_ty: u32) -> u32 {
    type_name(in ctx, object_trait(in ctx, ast_ty))
}

// `dyn_fn::boxed_fn_object`: the function object a `Box[dyn Fn..]` holds.
pub fn boxed_fn_sig(in ctx: D, ast_ty: u32) -> u32 {
    let node = ty(in ctx, ast_ty);
    if node.kind == 1 && node.a == ctx.known.box_ && ll(in ctx, node.b) == 1 {
        fn_sig(in ctx, la(in ctx, node.b, 0))
    } else {
        NONE
    }
}

pub fn any_fn_sig(in ctx: D, ast_ty: u32) -> u32 {
    let sig = fn_sig(in ctx, ast_ty);
    if sig != NONE {
        sig
    } else {
        boxed_fn_sig(in ctx, ast_ty)
    }
}

fn effects_mention(in ctx: D, effects: u32, name: u32, bare: bool) -> bool {
    let effects_row = effects_at(in ctx, effects);
    for i in 0..ll(in ctx, effects_row.instances) {
        let effect = effect_at(in ctx, la(in ctx, effects_row.instances, i));
        for j in 0..ll(in ctx, effect.args) {
            if mentions_name(in ctx, la(in ctx, effect.args, j), name, bare) {
                return true;
            }
        }
    }
    false
}

// `dyn_trait::mentions` (`name` anywhere), and `mentions_bare_dyn` when
// `bare` (the name is `dyn`, and `Box[dyn Trait[args]]` counts only for
// a `dyn` among its trait arguments).
pub fn mentions_name(in ctx: D, ast_ty: u32, name: u32, bare: bool) -> bool {
    if bare {
        let trait_ty = boxed_trait(in ctx, ast_ty);
        if trait_ty != NONE {
            let trait_node = ty(in ctx, trait_ty);
            if trait_node.kind == 1 {
                for i in 0..ll(in ctx, trait_node.b) {
                    if mentions_name(in ctx, la(in ctx, trait_node.b, i), name, false) {
                        return true;
                    }
                }
                return false;
            }
        }
    }
    let node = ty(in ctx, ast_ty);
    if node.kind == 1 {
        if node.a == name {
            return true;
        }
        for i in 0..ll(in ctx, node.b) {
            if mentions_name(in ctx, la(in ctx, node.b, i), name, bare) {
                return true;
            }
        }
        false
    } else if node.kind == 2 {
        for i in 0..ll(in ctx, node.a) {
            if mentions_name(in ctx, la(in ctx, node.a, i), name, bare) {
                return true;
            }
        }
        false
    } else if node.kind == 3 {
        let len = ll(in ctx, node.a) / 2;
        for i in 0..len {
            if mentions_name(in ctx, la(in ctx, node.a, inc(wrapping_mul(i, 2))), name, bare) {
                return true;
            }
        }
        mentions_name(in ctx, node.b, name, bare) || effects_mention(in ctx, node.c, name, bare)
    } else if node.kind == 4 {
        effects_mention(in ctx, node.a, name, bare)
    } else {
        false
    }
}

pub fn mentions_dyn(in ctx: D, ast_ty: u32) -> bool {
    mentions_name(in ctx, ast_ty, ctx.known.dyn_, false)
}

pub fn mentions_bare_dyn(in ctx: D, ast_ty: u32) -> bool {
    mentions_name(in ctx, ast_ty, ctx.known.dyn_, true)
}

// `dyn_trait::boxed_traits`: the traits of every boxed object in `ast_ty`.
pub fn boxed_traits(in ctx: D, ast_ty: u32, inout out: ChunkSeq[u32]) {
    let trait_ty = boxed_trait(in ctx, ast_ty);
    if trait_ty != NONE {
        out.push(trait_ty);
        return;
    }
    let node = ty(in ctx, ast_ty);
    if node.kind == 1 || node.kind == 2 {
        let list = if node.kind == 1 { node.b } else { node.a };
        for i in 0..ll(in ctx, list) {
            boxed_traits(in ctx, la(in ctx, list, i), inout out);
        }
    } else if node.kind == 3 {
        let len = ll(in ctx, node.a) / 2;
        for i in 0..len {
            boxed_traits(in ctx, la(in ctx, node.a, inc(wrapping_mul(i, 2))), inout out);
        }
        boxed_traits(in ctx, node.b, inout out);
        effects_boxed(in ctx, node.c, inout out);
    } else if node.kind == 4 {
        effects_boxed(in ctx, node.a, inout out);
    }
}

fn effects_boxed(in ctx: D, effects: u32, inout out: ChunkSeq[u32]) {
    let effects_row = effects_at(in ctx, effects);
    for i in 0..ll(in ctx, effects_row.instances) {
        let effect = effect_at(in ctx, la(in ctx, effects_row.instances, i));
        for j in 0..ll(in ctx, effect.args) {
            boxed_traits(in ctx, la(in ctx, effect.args, j), inout out);
        }
    }
}

// `dyn_fn::mentions_fn_object` (no effect rows).
pub fn mentions_fn_object(in ctx: D, ast_ty: u32) -> bool {
    if fn_sig(in ctx, ast_ty) != NONE {
        return true;
    }
    let node = ty(in ctx, ast_ty);
    if node.kind == 1 || node.kind == 2 {
        let list = if node.kind == 1 { node.b } else { node.a };
        for i in 0..ll(in ctx, list) {
            if mentions_fn_object(in ctx, la(in ctx, list, i)) {
                return true;
            }
        }
        false
    } else if node.kind == 3 {
        let len = ll(in ctx, node.a) / 2;
        for i in 0..len {
            if mentions_fn_object(in ctx, la(in ctx, node.a, inc(wrapping_mul(i, 2)))) {
                return true;
            }
        }
        mentions_fn_object(in ctx, node.b)
    } else {
        false
    }
}

// `dyn_fn::contains_infer`.
pub fn contains_infer(in ctx: D, ast_ty: u32) -> bool {
    let node = ty(in ctx, ast_ty);
    if node.kind == 5 {
        return true;
    }
    if node.kind == 1 || node.kind == 2 {
        let list = if node.kind == 1 { node.b } else { node.a };
        for i in 0..ll(in ctx, list) {
            if contains_infer(in ctx, la(in ctx, list, i)) {
                return true;
            }
        }
    }
    false
}

// `dyn_fn::mentions_any`: a bare name of `names` (no effect rows).
pub fn mentions_any(in ctx: D, ast_ty: u32, in names: ChunkSeq[u32]) -> bool {
    if names.len() == 0 {
        return false;
    }
    let node = ty(in ctx, ast_ty);
    if node.kind == 1 {
        if ll(in ctx, node.b) == 0 && contains(in names, node.a) {
            return true;
        }
        for i in 0..ll(in ctx, node.b) {
            if mentions_any(in ctx, la(in ctx, node.b, i), in names) {
                return true;
            }
        }
        false
    } else if node.kind == 2 {
        for i in 0..ll(in ctx, node.a) {
            if mentions_any(in ctx, la(in ctx, node.a, i), in names) {
                return true;
            }
        }
        false
    } else if node.kind == 3 {
        let len = ll(in ctx, node.a) / 2;
        for i in 0..len {
            if mentions_any(in ctx, la(in ctx, node.a, inc(wrapping_mul(i, 2))), in names) {
                return true;
            }
        }
        mentions_any(in ctx, node.b, in names)
    } else {
        false
    }
}

// ---------------------------------------------------------------- the type walker

fn push3(inout out: ChunkSeq[u32], ast_ty: u32, start: u32, end: u32) {
    out.push(ast_ty);
    out.push(start);
    out.push(end);
}

fn effect_types(in ctx: D, effects: u32, start: u32, end: u32, inout out: ChunkSeq[u32]) {
    let effects_row = effects_at(in ctx, effects);
    for i in 0..ll(in ctx, effects_row.instances) {
        let effect = effect_at(in ctx, la(in ctx, effects_row.instances, i));
        for j in 0..ll(in ctx, effect.args) {
            push3(inout out, la(in ctx, effect.args, j), start, end);
        }
    }
}

// `pact_frontend::walk_function_spans`: every type written in function `func`
// with the span to report it at, as (type, start, end) triples. With
// `skip_box`, the type argument of `Box::new[dyn Trait](x)` is left out
// (`dyn_trait::bare_dyn_type`).
pub fn fn_types(in ctx: D, func: u32, skip_box: bool, inout out: ChunkSeq[u32]) {
    let node = fn_at(in ctx, func);
    for i in 0..ll(in ctx, node.params) {
        let param = param_at(in ctx, la(in ctx, node.params, i));
        push3(inout out, param.ty, param.start, param.end);
    }
    push3(inout out, node.result, node.start, node.end);
    effect_types(in ctx, node.effects, node.start, node.end, inout out);
    if node.body != NONE {
        expr_types(in ctx, node.body, skip_box, inout out);
    }
}

fn opt_expr_types(in ctx: D, expr: u32, skip_box: bool, inout out: ChunkSeq[u32]) {
    if expr != NONE {
        expr_types(in ctx, expr, skip_box, inout out);
    }
}

fn expr_types(in ctx: D, expr: u32, skip_box: bool, inout out: ChunkSeq[u32]) {
    let node = ex(in ctx, expr);
    let kind = node.kind;
    if kind == 3 {
        for i in 0..ll(in ctx, node.a) {
            expr_types(in ctx, la(in ctx, node.a, i), skip_box, inout out);
        }
    } else if kind == 4 {
        let len = ll(in ctx, node.b) / 2;
        for i in 0..len {
            expr_types(in ctx, la(in ctx, node.b, inc(wrapping_mul(i, 2))), skip_box, inout out);
        }
    } else if kind == 5 {
        for i in 0..ll(in ctx, node.a) {
            let stmt = stmt_at(in ctx, la(in ctx, node.a, i));
            if stmt.kind == 1 {
                let value = ex(in ctx, stmt.value);
                push3(inout out, stmt.ty, value.start, value.end);
            }
            expr_types(in ctx, stmt.value, skip_box, inout out);
        }
        opt_expr_types(in ctx, node.b, skip_box, inout out);
    } else if kind == 6 {
        expr_types(in ctx, node.a, skip_box, inout out);
        let mut skip = false;
        if skip_box && ll(in ctx, node.b) == 1 {
            let callee = ex(in ctx, node.a);
            if callee.kind == 2 && callee.a == ctx.known.box_new {
                let trait_ty = object_trait(in ctx, la(in ctx, node.b, 0));
                skip = trait_ty != NONE && !mentions_dyn(in ctx, trait_ty);
            }
        }
        if !skip {
            for i in 0..ll(in ctx, node.b) {
                push3(inout out, la(in ctx, node.b, i), node.start, node.end);
            }
        }
        for i in 0..ll(in ctx, node.c) {
            expr_types(in ctx, arg_at(in ctx, la(in ctx, node.c, i)).expr, skip_box, inout out);
        }
    } else if kind == 7 || kind == 9 {
        expr_types(in ctx, node.a, skip_box, inout out);
    } else if kind == 10 {
        expr_types(in ctx, node.b, skip_box, inout out);
    } else if kind == 8 {
        expr_types(in ctx, node.a, skip_box, inout out);
        expr_types(in ctx, node.b, skip_box, inout out);
    } else if kind == 11 || kind == 12 {
        expr_types(in ctx, node.b, skip_box, inout out);
        expr_types(in ctx, node.c, skip_box, inout out);
    } else if kind == 13 {
        expr_types(in ctx, node.a, skip_box, inout out);
        expr_types(in ctx, node.b, skip_box, inout out);
        opt_expr_types(in ctx, node.c, skip_box, inout out);
    } else if kind == 14 {
        expr_types(in ctx, node.a, skip_box, inout out);
        let len = ll(in ctx, node.b) / 2;
        for i in 0..len {
            expr_types(in ctx, la(in ctx, node.b, inc(wrapping_mul(i, 2))), skip_box, inout out);
        }
    } else if kind == 17 {
        expr_types(in ctx, node.a, skip_box, inout out);
    } else if kind == 18 {
        expr_types(in ctx, node.b, skip_box, inout out);
        expr_types(in ctx, node.c, skip_box, inout out);
    } else if kind == 19 {
        expr_types(in ctx, node.a, skip_box, inout out);
        expr_types(in ctx, node.b, skip_box, inout out);
    } else if kind == 20 || kind == 21 {
        opt_expr_types(in ctx, node.a, skip_box, inout out);
    } else if kind == 15 {
        for i in 0..ll(in ctx, node.a) {
            push3(inout out, param_at(in ctx, la(in ctx, node.a, i)).ty, node.start, node.end);
        }
        push3(inout out, node.c, node.start, node.end);
        effect_types(in ctx, node.d, node.start, node.end, inout out);
        expr_types(in ctx, node.e, skip_box, inout out);
    } else if kind == 16 {
        let handled = effect_at(in ctx, node.a);
        for j in 0..ll(in ctx, handled.args) {
            push3(inout out, la(in ctx, handled.args, j), node.start, node.end);
        }
        if node.b != NONE {
            expr_types(in ctx, node.c, skip_box, inout out);
        }
        expr_types(in ctx, node.d, skip_box, inout out);
        for i in 0..ll(in ctx, node.e) {
            expr_types(in ctx, clause_at(in ctx, la(in ctx, node.e, i)).body, skip_box, inout out);
        }
    }
}

// ---------------------------------------------------------------- patterns and names

// `pattern_names`: the names a pattern binds, appended to `out`.
pub fn pattern_names(in ctx: D, pat: u32, inout out: ChunkSeq[u32]) {
    let node = pt(in ctx, pat);
    if node.kind == 2 {
        out.push(node.a);
    } else if node.kind == 4 {
        for i in 0..ll(in ctx, node.a) {
            pattern_names(in ctx, la(in ctx, node.a, i), inout out);
        }
    } else if node.kind == 5 {
        let len = ll(in ctx, node.b) / 2;
        for i in 0..len {
            pattern_names(in ctx, la(in ctx, node.b, inc(wrapping_mul(i, 2))), inout out);
        }
    }
}

// `live` without the names in `bound`.
pub fn without(in live: ChunkSeq[u32], in bound: ChunkSeq[u32]) -> ChunkSeq[u32] {
    let mut out = ChunkSeq::with_capacity[u32](live.len());
    for i in 0..live.len() {
        let name = u32_at(in live, i);
        if !contains(in bound, name) {
            out.push(name);
        }
    }
    out
}

fn mark_bound(inout bound: ChunkSeq[u32], in names: ChunkSeq[u32]) {
    for i in 0..names.len() {
        bound.push(u32_at(in names, i));
    }
}

fn free_walk(in ctx: D, expr: u32, inout bound: ChunkSeq[u32], inout out: ChunkSeq[u32]) {
    let node = ex(in ctx, expr);
    let kind = node.kind;
    if kind == 2 {
        if !contains(in bound, node.a) {
            out.push(node.a);
        }
    } else if kind == 3 {
        for i in 0..ll(in ctx, node.a) {
            free_walk(in ctx, la(in ctx, node.a, i), inout bound, inout out);
        }
    } else if kind == 4 {
        let len = ll(in ctx, node.b) / 2;
        for i in 0..len {
            free_walk(in ctx, la(in ctx, node.b, inc(wrapping_mul(i, 2))), inout bound, inout out);
        }
    } else if kind == 5 {
        let mark = bound.len();
        for i in 0..ll(in ctx, node.a) {
            let stmt = stmt_at(in ctx, la(in ctx, node.a, i));
            free_walk(in ctx, stmt.value, inout bound, inout out);
            if stmt.kind == 1 {
                pattern_names(in ctx, stmt.pat, inout bound);
            }
        }
        if node.b != NONE {
            free_walk(in ctx, node.b, inout bound, inout out);
        }
        bound.truncate(mark);
    } else if kind == 6 {
        free_walk(in ctx, node.a, inout bound, inout out);
        for i in 0..ll(in ctx, node.c) {
            free_walk(in ctx, arg_at(in ctx, la(in ctx, node.c, i)).expr, inout bound, inout out);
        }
    } else if kind == 7 || kind == 9 {
        free_walk(in ctx, node.a, inout bound, inout out);
    } else if kind == 10 {
        free_walk(in ctx, node.b, inout bound, inout out);
    } else if kind == 8 {
        free_walk(in ctx, node.a, inout bound, inout out);
        free_walk(in ctx, node.b, inout bound, inout out);
    } else if kind == 11 || kind == 12 {
        free_walk(in ctx, node.b, inout bound, inout out);
        free_walk(in ctx, node.c, inout bound, inout out);
    } else if kind == 13 {
        free_walk(in ctx, node.a, inout bound, inout out);
        free_walk(in ctx, node.b, inout bound, inout out);
        if node.c != NONE {
            free_walk(in ctx, node.c, inout bound, inout out);
        }
    } else if kind == 14 {
        free_walk(in ctx, node.a, inout bound, inout out);
        let len = ll(in ctx, node.b) / 2;
        for i in 0..len {
            let mark = bound.len();
            pattern_names(in ctx, la(in ctx, node.b, wrapping_mul(i, 2)), inout bound);
            free_walk(in ctx, la(in ctx, node.b, inc(wrapping_mul(i, 2))), inout bound, inout out);
            bound.truncate(mark);
        }
    } else if kind == 15 {
        let mark = bound.len();
        for i in 0..ll(in ctx, node.a) {
            bound.push(param_at(in ctx, la(in ctx, node.a, i)).name);
        }
        free_walk(in ctx, node.e, inout bound, inout out);
        bound.truncate(mark);
    } else if kind == 16 {
        if node.b != NONE {
            free_walk(in ctx, node.c, inout bound, inout out);
        }
        free_walk(in ctx, node.d, inout bound, inout out);
        for i in 0..ll(in ctx, node.e) {
            let clause = clause_at(in ctx, la(in ctx, node.e, i));
            let mark = bound.len();
            for j in 0..ll(in ctx, clause.pats) {
                pattern_names(in ctx, la(in ctx, clause.pats, j), inout bound);
            }
            free_walk(in ctx, clause.body, inout bound, inout out);
            bound.truncate(mark);
        }
    } else if kind == 18 {
        free_walk(in ctx, node.b, inout bound, inout out);
        let mark = bound.len();
        pattern_names(in ctx, node.a, inout bound);
        free_walk(in ctx, node.c, inout bound, inout out);
        bound.truncate(mark);
    } else if kind == 17 {
        free_walk(in ctx, node.a, inout bound, inout out);
    } else if kind == 19 {
        free_walk(in ctx, node.a, inout bound, inout out);
        free_walk(in ctx, node.b, inout bound, inout out);
    } else if kind == 20 || kind == 21 {
        if node.a != NONE {
            free_walk(in ctx, node.a, inout bound, inout out);
        }
    }
}

// `check::free_names`, sorted by text.
pub fn free_names(in ctx: D, expr: u32) -> ChunkSeq[u32] {
    let mut bound = ChunkSeq::new[u32]();
    let mut out = ChunkSeq::new[u32]();
    free_walk(in ctx, expr, inout bound, inout out);
    sort_syms(in ctx.ast, inout out);
    out
}

// ---------------------------------------------------------------- diagnostics

pub fn put(inout out: ChunkSeq[u8], in text: Str) {
    out.extend(in text.as_bytes());
}

pub fn put_u64(inout out: ChunkSeq[u8], value: u64) {
    if value >= 10 {
        put_u64(inout out, value / 10);
    }
    out.push(wrapping_u8(wrapping_add(value % 10, 48)));
}

pub fn put_sym(in ast: Ast, inout out: ChunkSeq[u8], sym: u32) {
    if sym == NONE {
        return;
    }
    let (text_start, text_end) = ast.names.span(symbol_from_id(sym));
    for i in text_start..text_end {
        match ast.names.text_byte(i) {
            Option::Some(byte) => out.push(byte),
            Option::None => {},
        }
    }
}

// Starts a diagnostic with `code`; returns where its message starts.
pub fn diag_open(inout ctx: D, in code: Str) -> (u64, u64) {
    let code_start = ctx.diags.open(in code);
    (code_start, ctx.diags.text.len())
}

pub fn diag_close(inout ctx: D, diag: (u64, u64), start: u32, end: u32) {
    let (code_start, msg_start) = diag;
    ctx.diags.close(code_start, msg_start, in "", w(start), w(end));
}

pub fn dput(inout ctx: D, in text: Str) {
    ctx.diags.text.extend(in text.as_bytes());
}

pub fn dsym(inout ctx: D, sym: u32) {
    put_sym(in ctx.ast, inout ctx.diags.text, sym);
}

pub fn dtype(inout ctx: D, ast_ty: u32) {
    let id = tid(inout ctx, ast_ty);
    display(in ctx.types, in ctx.names, id, inout ctx.diags.text);
}

pub fn ddec(inout ctx: D, value: u64) {
    put_u64(inout ctx.diags.text, value);
}

// A diagnostic whose message is one text.
pub fn diag_text(inout ctx: D, in code: Str, in msg: Str, start: u32, end: u32) {
    let diag = diag_open(inout ctx, in code);
    dput(inout ctx, in msg);
    diag_close(inout ctx, diag, start, end);
}
