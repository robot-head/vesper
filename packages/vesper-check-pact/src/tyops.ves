// The type operations of the trait frontend over `@vesper/check-data`'s
// hash-consed arena: projection encodings (`ast::as_projection`),
// `contains_projection`, `mentions`, `Frontend::conform_type` (a trait
// signature instantiated at one conformance), `check::compatible`, the
// impl-key encoding (`key_segment`) and `row_arg`.

use @vesper/check-data::types::{EffNode, Types, Vars, substitute_row, TyKind};
use @vesper/check-data::names::{Names};
use @vesper/check-data::util::{add, n32, u32_at, w};
use self::decl::{Conf, Decls, TraitRow};

const NONE32: u32 = 4294967295;

// Names the frontend compares against, interned once.
pub copy struct Sy {
    self_ty: u32,
    self_param: u32,
    projection: u32,
    any_trait: u32,
    never: u32,
    unit: u32,
    empty: u32,
}

pub fn sy_new(inout names: Names) -> Sy {
    Sy {
        self_ty: names.intern(in "Self".as_bytes()),
        self_param: names.intern(in "self".as_bytes()),
        projection: names.intern(in "$projection".as_bytes()),
        any_trait: names.intern(in "$any".as_bytes()),
        never: names.intern(in "Never".as_bytes()),
        unit: names.intern(in "Unit".as_bytes()),
        empty: names.intern(in "".as_bytes()),
    }
}

pub fn contains32(in seq: ChunkSeq[u32], value: u32) -> bool {
    for i in 0..seq.len() {
        if u32_at(in seq, i) == value {
            return true;
        }
    }
    false
}

// `BTreeSet::insert`: false when `value` was already present.
pub fn insert32(inout seq: ChunkSeq[u32], value: u32) -> bool {
    if contains32(in seq, value) {
        return false;
    }
    seq.push(value);
    true
}

// ------------------------------------------------------------ projections

// `ast::as_projection(t).is_some()`: `$projection[self, Trait[args], A]`.
pub fn is_projection(in types: Types, syms: Sy, ty: u32) -> bool {
    let node = types.node(ty);
    if node.kind != TyKind::Named || node.name != syms.projection || node.n != 3 {
        return false;
    }
    let trait_node = types.node(types.arg(ty, 1));
    let assoc_node = types.node(types.arg(ty, 2));
    trait_node.kind == TyKind::Named && assoc_node.kind == TyKind::Named && assoc_node.n == 0
}

pub fn proj_self(in types: Types, ty: u32) -> u32 {
    types.arg(ty, 0)
}

// The projection's trait name, or NONE32 for the shorthand `T::A`.
pub fn proj_trait(in types: Types, syms: Sy, ty: u32) -> u32 {
    let name = types.node(types.arg(ty, 1)).name;
    if name == syms.any_trait { NONE32 } else { name }
}

// The `Trait[args]` part (its arguments are the projection's trait args).
pub fn proj_trait_ty(in types: Types, ty: u32) -> u32 {
    types.arg(ty, 1)
}

pub fn proj_assoc(in types: Types, ty: u32) -> u32 {
    types.node(types.arg(ty, 2)).name
}

// `*t == Type::named("Self")`.
pub fn is_self(in types: Types, syms: Sy, ty: u32) -> bool {
    let node = types.node(ty);
    node.kind == TyKind::Named && node.name == syms.self_ty && node.n == 0
}

fn row_contains_projection(in types: Types, syms: Sy, row_id: u32) -> bool {
    let row = types.row(row_id);
    for i in 0..w(row.n) {
        let row_effect = types.effect_at(add(w(row.a), i));
        for j in 0..w(row_effect.n) {
            if contains_projection(
                in types,
                syms,
                u32_at(in types.items, add(w(row_effect.a), j))
            ) {
                return true;
            }
        }
    }
    false
}

// `contains_projection`.
pub fn contains_projection(in types: Types, syms: Sy, ty: u32) -> bool {
    let node = types.node(ty);
    if node.kind == TyKind::Named {
        if node.name == syms.projection {
            return true;
        }
        for i in 0..w(node.n) {
            if contains_projection(in types, syms, types.arg(ty, i)) {
                return true;
            }
        }
        return false;
    }
    if node.kind == TyKind::Tuple {
        for i in 0..w(node.n) {
            if contains_projection(in types, syms, types.arg(ty, i)) {
                return true;
            }
        }
        return false;
    }
    if node.kind == TyKind::Fn {
        for i in 0..w(node.n) {
            if contains_projection(in types, syms, types.arg(ty, i)) {
                return true;
            }
        }
        return contains_projection(in types, syms, node.r)
            || row_contains_projection(in types, syms, node.r2);
    }
    if node.kind == TyKind::Row {
        return row_contains_projection(in types, syms, node.r2);
    }
    false
}

fn row_mentions(in types: Types, row_id: u32, name: u32) -> bool {
    let row = types.row(row_id);
    for i in 0..w(row.n) {
        let row_effect = types.effect_at(add(w(row.a), i));
        for j in 0..w(row_effect.n) {
            if mentions(in types, u32_at(in types.items, add(w(row_effect.a), j)), name) {
                return true;
            }
        }
    }
    false
}

// `mentions(t, name)`: the type names `name` anywhere.
pub fn mentions(in types: Types, ty: u32, name: u32) -> bool {
    let node = types.node(ty);
    if node.kind == TyKind::Named {
        if node.name == name {
            return true;
        }
        for i in 0..w(node.n) {
            if mentions(in types, types.arg(ty, i), name) {
                return true;
            }
        }
        return false;
    }
    if node.kind == TyKind::Tuple {
        for i in 0..w(node.n) {
            if mentions(in types, types.arg(ty, i), name) {
                return true;
            }
        }
        return false;
    }
    if node.kind == TyKind::Fn {
        for i in 0..w(node.n) {
            if mentions(in types, types.arg(ty, i), name) {
                return true;
            }
        }
        return mentions(in types, node.r, name) || row_mentions(in types, node.r2, name);
    }
    if node.kind == TyKind::Row {
        return row_mentions(in types, node.r2, name);
    }
    false
}

// -------------------------------------------------------- conform_type

// Whether trait `trait_row` declares associated type `name`.
pub fn trait_has_assoc(in decls: Decls, trait_row: TraitRow, name: u32) -> bool {
    for i in 0..w(trait_row.assoc_count) {
        if decls.assoc(add(w(trait_row.assoc_start), i)).name == name {
            return true;
        }
    }
    false
}

// The type conformance `conf` binds associated type `name` to (the first
// binding of that name), or NONE32.
pub fn binding_of(in decls: Decls, conf: Conf, name: u32) -> u32 {
    for i in 0..w(conf.bind_count) {
        let bind = decls.bind(add(w(conf.bind_start), i));
        if bind.name == name {
            return bind.ty;
        }
    }
    NONE32
}

// `Frontend::conform_type`: replaces `Self`, the trait parameters (in
// `vars`) and `Self::A` / `<Self as Trait>::A` by conformance `conf`'s values.
// `stack` holds the associated types being expanded on this path: a cyclic
// binding (E0601) is left unexpanded instead of recursing forever.
pub fn conform_type(
    inout types: Types,
    in decls: Decls,
    syms: Sy,
    trait_row: TraitRow,
    conf: Conf,
    ty: u32,
    in vars: Vars,
    inout stack: ChunkSeq[u32]
) -> u32 {
    if is_projection(in types, syms, ty) {
        let trait_name = proj_trait(in types, syms, ty);
        let assoc = proj_assoc(in types, ty);
        if is_self(in types, syms, proj_self(in types, ty))
            && (trait_name == NONE32 || trait_name == trait_row.name)
            && trait_has_assoc(in decls, trait_row, assoc)
            && !contains32(in stack, assoc) {
            let bound_ty = binding_of(in decls, conf, assoc);
            if bound_ty != NONE32 {
                let depth = stack.len();
                stack.push(assoc);
                let out = conform_type(
                    inout types,
                    in decls,
                    syms,
                    trait_row,
                    conf,
                    bound_ty,
                    in vars,
                    inout stack
                );
                stack.truncate(depth);
                return out;
            }
        }
    }
    let node = types.node(ty);
    if node.kind == TyKind::Named {
        if node.n == 0 {
            let var_ty = vars.get(node.name);
            if var_ty != NONE32 {
                return var_ty;
            }
            return ty;
        }
        let mut args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](w(node.n));
        for i in 0..w(node.n) {
            let arg = types.arg(ty, i);
            let conformed = conform_type(
                inout types,
                in decls,
                syms,
                trait_row,
                conf,
                arg,
                in vars,
                inout stack
            );
            args.push(conformed);
        }
        return types.named(node.name, in args);
    }
    if node.kind == TyKind::Tuple {
        if node.n == 0 {
            return ty;
        }
        let mut args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](w(node.n));
        for i in 0..w(node.n) {
            let arg = types.arg(ty, i);
            let conformed = conform_type(
                inout types,
                in decls,
                syms,
                trait_row,
                conf,
                arg,
                in vars,
                inout stack
            );
            args.push(conformed);
        }
        return types.tuple(in args);
    }
    if node.kind == TyKind::Fn {
        let mut args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](w(node.n));
        let mut passes: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](w(node.n));
        for i in 0..w(node.n) {
            let arg = types.arg(ty, i);
            passes.push(types.param_pass(ty, i));
            let conformed = conform_type(
                inout types,
                in decls,
                syms,
                trait_row,
                conf,
                arg,
                in vars,
                inout stack
            );
            args.push(conformed);
        }
        let result = conform_type(
            inout types,
            in decls,
            syms,
            trait_row,
            conf,
            node.r,
            in vars,
            inout stack
        );
        let row = conform_row(
            inout types,
            in decls,
            syms,
            trait_row,
            conf,
            node.r2,
            in vars,
            inout stack
        );
        return types.mk_with(TyKind::Fn, node.mode, 0, in args, in passes, result, row, 0);
    }
    if node.kind == TyKind::Row {
        let row = conform_row(
            inout types,
            in decls,
            syms,
            trait_row,
            conf,
            node.r2,
            in vars,
            inout stack
        );
        return types.row_type(row);
    }
    ty
}

// `go_effects`: arguments conformed, then `substitute_effects` by `vars`.
pub fn conform_row(
    inout types: Types,
    in decls: Decls,
    syms: Sy,
    trait_row: TraitRow,
    conf: Conf,
    row_id: u32,
    in vars: Vars,
    inout stack: ChunkSeq[u32]
) -> u32 {
    let row = types.row(row_id);
    let mut effs: ChunkSeq[EffNode] = ChunkSeq::new[EffNode]();
    let mut args: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..w(row.n) {
        let row_effect = types.effect_at(add(w(row.a), i));
        let arg_start = n32(args.len());
        for j in 0..w(row_effect.n) {
            let item_ty = u32_at(in types.items, add(w(row_effect.a), j));
            let conformed = conform_type(
                inout types,
                in decls,
                syms,
                trait_row,
                conf,
                item_ty,
                in vars,
                inout stack
            );
            args.push(conformed);
        }
        effs.push(EffNode {
            label: row_effect.label,
            name: row_effect.name,
            a: arg_start,
            n: row_effect.n
        });
    }
    let mapped = types.mk_row(in effs, in args, row.tail);
    substitute_row(inout types, mapped, in vars)
}

// --------------------------------------------------------- compatibility

// `check::compatible(a, b)`. Integer literal types never occur in the
// signatures this pass compares (the parser cannot write one), so a
// literal is only compatible with another literal here.
pub fn compatible(in types: Types, syms: Sy, a: u32, b: u32) -> bool {
    let a_node = types.node(a);
    let b_node = types.node(b);
    if a_node.kind == TyKind::Infer
        || b_node.kind == TyKind::Infer
        || (b_node.kind == TyKind::Named && b_node.name == syms.never) {
        return true;
    }
    if a_node.kind == TyKind::Lit || b_node.kind == TyKind::Lit {
        return a_node.kind == TyKind::Lit && b_node.kind == TyKind::Lit;
    }
    if a_node.kind == TyKind::Named && b_node.kind == TyKind::Named {
        if a_node.name != b_node.name || a_node.n != b_node.n {
            return false;
        }
        for i in 0..w(a_node.n) {
            if !compatible(in types, syms, types.arg(a, i), types.arg(b, i)) {
                return false;
            }
        }
        return true;
    }
    if a_node.kind == TyKind::Tuple && b_node.kind == TyKind::Tuple {
        if a_node.n != b_node.n {
            return false;
        }
        for i in 0..w(a_node.n) {
            if !compatible(in types, syms, types.arg(a, i), types.arg(b, i)) {
                return false;
            }
        }
        return true;
    }
    if a_node.kind == TyKind::Named && b_node.kind == TyKind::Tuple {
        return a_node.name == syms.unit && b_node.n == 0;
    }
    if a_node.kind == TyKind::Tuple && b_node.kind == TyKind::Named {
        return b_node.name == syms.unit && a_node.n == 0;
    }
    if a_node.kind == TyKind::Row && b_node.kind == TyKind::Row {
        return a == b;
    }
    if a_node.kind == TyKind::Fn && b_node.kind == TyKind::Fn {
        if !effects_include(in types, syms, a_node.r2, b_node.r2)
            || b_node.mode > a_node.mode
            || a_node.n != b_node.n {
            return false;
        }
        for i in 0..w(a_node.n) {
            if types.param_pass(a, i) != types.param_pass(b, i) {
                return false;
            }
            if !compatible(in types, syms, types.arg(b, i), types.arg(a, i)) {
                return false;
            }
        }
        return compatible(in types, syms, a_node.r, b_node.r);
    }
    false
}

// `check::effects_include(expected, actual)` over two row ids.
pub fn effects_include(in types: Types, syms: Sy, expected: u32, actual: u32) -> bool {
    let expected_row = types.row(expected);
    let actual_row = types.row(actual);
    if actual_row.tail != 0 && expected_row.tail == 0 {
        return false;
    }
    if expected_row.tail != 0 {
        return true;
    }
    for i in 0..w(actual_row.n) {
        let actual_effect = types.effect_at(add(w(actual_row.a), i));
        let mut found = false;
        for j in 0..w(expected_row.n) {
            let expected_effect = types.effect_at(add(w(expected_row.a), j));
            if !found
                && expected_effect.name == actual_effect.name
                && (expected_effect.label == 0 || expected_effect.label == actual_effect.label)
                && expected_effect.n == actual_effect.n {
                let mut all = true;
                for k in 0..w(expected_effect.n) {
                    let expected_arg = u32_at(in types.items, add(w(expected_effect.a), k));
                    let actual_arg = u32_at(in types.items, add(w(actual_effect.a), k));
                    if !compatible(in types, syms, expected_arg, actual_arg) {
                        all = false;
                    }
                }
                if all {
                    found = true;
                }
            }
        }
        if !found {
            return false;
        }
    }
    true
}

// `same_type`: compatible both ways.
pub fn same_type(in types: Types, syms: Sy, a: u32, b: u32) -> bool {
    compatible(in types, syms, a, b) && compatible(in types, syms, b, a)
}

// ------------------------------------------------------------ impl keys

fn push_bytes(inout out: ChunkSeq[u8], in text: Str) {
    out.extend(in text.as_bytes());
}

fn segment_list(in types: Types, in names: Names, ty: u32, inout out: ChunkSeq[u8]) {
    let node = types.node(ty);
    for i in 0..w(node.n) {
        if i > 0 {
            push_bytes(inout out, "-1-");
        }
        key_segment(in types, in names, types.arg(ty, i), inout out);
    }
}

// `key_segment`: the injective impl-key encoding of a type.
pub fn key_segment(in types: Types, in names: Names, ty: u32, inout out: ChunkSeq[u8]) {
    let node = types.node(ty);
    if node.kind == TyKind::Named {
        names.write(node.name, inout out);
        if node.n > 0 {
            push_bytes(inout out, "-0-");
            segment_list(in types, in names, ty, inout out);
            push_bytes(inout out, "-2");
        }
        return;
    }
    if node.kind == TyKind::Tuple {
        if node.n == 0 {
            push_bytes(inout out, "Unit");
            return;
        }
        push_bytes(inout out, "3-0-");
        segment_list(in types, in names, ty, inout out);
        push_bytes(inout out, "-2");
        return;
    }
    if node.kind == TyKind::Row {
        push_bytes(inout out, "4-0-");
        let row = types.row(node.r2);
        let mut first = true;
        for i in 0..w(row.n) {
            let row_effect = types.effect_at(add(w(row.a), i));
            if !first {
                push_bytes(inout out, "-1-");
            }
            first = false;
            names.write(row_effect.name, inout out);
            if row_effect.n > 0 {
                push_bytes(inout out, "-0-");
                for j in 0..w(row_effect.n) {
                    if j > 0 {
                        push_bytes(inout out, "-1-");
                    }
                    key_segment(
                        in types,
                        in names,
                        u32_at(in types.items, add(w(row_effect.a), j)),
                        inout out
                    );
                }
                push_bytes(inout out, "-2");
            }
        }
        if row.tail != 0 {
            if !first {
                push_bytes(inout out, "-1-");
            }
            names.write(wrapping_sub(row.tail, 1), inout out);
        }
        push_bytes(inout out, "-2");
        return;
    }
    push_bytes(inout out, "5");
}

// `row_arg`: a trait argument for an effect-row parameter, as a row.
pub fn row_arg(inout types: Types, arg: u32) -> u32 {
    let node = types.node(arg);
    if node.kind == TyKind::Row {
        return arg;
    }
    if node.kind == TyKind::Named {
        let mut effs: ChunkSeq[EffNode] = ChunkSeq::new[EffNode]();
        let mut args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](w(node.n));
        for i in 0..w(node.n) {
            args.push(types.arg(arg, i));
        }
        effs.push(EffNode { label: 0, name: node.name, a: 0, n: node.n });
        let row_id = types.mk_row(in effs, in args, 0);
        return types.row_type(row_id);
    }
    if node.kind == TyKind::Tuple && node.n == 0 {
        let row_id = types.empty_row;
        return types.row_type(row_id);
    }
    arg
}
