// The source declarations the trait frontend reads (`src/pact_frontend.rs`,
// `Frontend::collect_local`): traits, conformances (canonical `impl`s and
// named `model`s), `use model` declarations, trait bounds outside
// conformance heads, the ADT and effect items whose signatures may not
// mention projections, and the base world's functions with their generics.
// Rust keeps them as `ast` trees; here they are flat tables of rows whose
// lists are ranges into shared pools, with types as `@vesper/check-data`
// ids and names as its symbols.
//
// The harness writes them after the common sections, in module order
// (tests/self_host_check_pact.rs, `encode_declarations`).

use @vesper/check-data::input::{Reader};
use @vesper/check-data::util::{n32, u32_at};

// One generic parameter (`ast::Generic`).
pub copy struct Gen {
    name: u32,
    bound: u8,
    row: bool,
}

// A function signature (`ast::Function` without its body): a trait method,
// a conformance method or an effect operation. `row` is the effects as a
// `Row` type id.
pub copy struct Sig {
    name: u32,
    span_start: u64,
    span_end: u64,
    gen_start: u32,
    gen_count: u32,
    par_start: u32,
    par_count: u32,
    result: u32,
    row: u32,
}

// A parameter (`ast::Param`). Its place projections are the words
// `words[proj_start..proj_start+proj_count]`: per projection its length, then its names.
pub copy struct Par {
    name: u32,
    pass: u8,
    proj_start: u32,
    proj_count: u32,
    ty: u32,
    span_start: u64,
    span_end: u64,
}

// `type A: mod m;` in a trait.
pub copy struct AssocDecl {
    name: u32,
    bound: u8,
    span_start: u64,
    span_end: u64,
}

pub copy struct TraitRow {
    name: u32,
    span_start: u64,
    span_end: u64,
    gen_start: u32,
    gen_count: u32,
    assoc_start: u32,
    assoc_count: u32,
    // methods: sigs[method_start..method_start+method_count]
    method_start: u32,
    method_count: u32,
}

// `Trait[args]`, optionally package-qualified: `pkg` is the package name
// symbol + 1, or 0. Arguments are `words[arg_start..arg_start+arg_count]` (type ids).
pub copy struct TRef {
    pkg: u32,
    name: u32,
    arg_start: u32,
    arg_count: u32,
    span_start: u64,
    span_end: u64,
}

// `where T: Trait[args]` on a conformance.
pub copy struct Where {
    ty: u32,
    tref: u32,
}

// `type A = T;` in an impl or model.
pub copy struct Bind {
    name: u32,
    ty: u32,
    span_start: u64,
    span_end: u64,
}

// A canonical `impl` (`model` false) or a named `model`.
pub copy struct Conf {
    model: bool,
    model_name: u32,
    gen_start: u32,
    gen_count: u32,
    tref: u32,
    self_ty: u32,
    where_start: u32,
    where_count: u32,
    bind_start: u32,
    bind_count: u32,
    method_start: u32,
    method_count: u32,
    span_start: u64,
    span_end: u64,
}

// `use model M;`.
pub copy struct UseRow {
    model: u32,
    span_start: u64,
    span_end: u64,
}

// `ast::TraitBoundSyntax`.
pub copy struct BoundSyn {
    param: u32,
    tref: u32,
    span_start: u64,
    span_end: u64,
    owner: u32,
}

// An ADT item (field types `words[member_start..member_start+member_count]`) or an
// effect item (operations `sigs[member_start..member_start+member_count]`), in module order.
pub copy struct ItemRow {
    adt: bool,
    name: u32,
    span_start: u64,
    span_end: u64,
    member_start: u32,
    member_count: u32,
}

// A function of the base world (`World::functions`) and its generics.
pub copy struct FnRow {
    name: u32,
    gen_start: u32,
    gen_count: u32,
}

pub struct Decls {
    // The package identity as `DefPath` prints it (`@local/main@0.0.0`).
    identity: u32,
    gens: ChunkSeq[Gen],
    sigs: ChunkSeq[Sig],
    pars: ChunkSeq[Par],
    words: ChunkSeq[u32],
    traits: ChunkSeq[TraitRow],
    assocs: ChunkSeq[AssocDecl],
    trefs: ChunkSeq[TRef],
    confs: ChunkSeq[Conf],
    wheres: ChunkSeq[Where],
    binds: ChunkSeq[Bind],
    uses: ChunkSeq[UseRow],
    bounds: ChunkSeq[BoundSyn],
    items: ChunkSeq[ItemRow],
    fns: ChunkSeq[FnRow],
}

pub fn decls_new() -> Decls {
    Decls {
        identity: 0,
        gens: ChunkSeq::new[Gen](),
        sigs: ChunkSeq::new[Sig](),
        pars: ChunkSeq::new[Par](),
        words: ChunkSeq::new[u32](),
        traits: ChunkSeq::new[TraitRow](),
        assocs: ChunkSeq::new[AssocDecl](),
        trefs: ChunkSeq::new[TRef](),
        confs: ChunkSeq::new[Conf](),
        wheres: ChunkSeq::new[Where](),
        binds: ChunkSeq::new[Bind](),
        uses: ChunkSeq::new[UseRow](),
        bounds: ChunkSeq::new[BoundSyn](),
        items: ChunkSeq::new[ItemRow](),
        fns: ChunkSeq::new[FnRow]()
    }
}

impl Decls {
    pub fn gen(in self, i: u64) -> Gen {
        match self.gens.try_get(i) {
            Option::Some(g) => g,
            Option::None => Gen { name: 0, bound: 0, row: false },
        }
    }

    pub fn sig(in self, i: u64) -> Sig {
        match self.sigs.try_get(i) {
            Option::Some(x) => x,
            Option::None => Sig {
                name: 0,
                span_start: 0,
                span_end: 0,
                gen_start: 0,
                gen_count: 0,
                par_start: 0,
                par_count: 0,
                result: 0,
                row: 0
            },
        }
    }

    pub fn par(in self, i: u64) -> Par {
        match self.pars.try_get(i) {
            Option::Some(x) => x,
            Option::None => Par {
                name: 0,
                pass: 0,
                proj_start: 0,
                proj_count: 0,
                ty: 0,
                span_start: 0,
                span_end: 0
            },
        }
    }

    pub fn word(in self, i: u64) -> u32 {
        u32_at(in self.words, i)
    }

    pub fn trait_row(in self, i: u64) -> TraitRow {
        match self.traits.try_get(i) {
            Option::Some(x) => x,
            Option::None => TraitRow {
                name: 0,
                span_start: 0,
                span_end: 0,
                gen_start: 0,
                gen_count: 0,
                assoc_start: 0,
                assoc_count: 0,
                method_start: 0,
                method_count: 0
            },
        }
    }

    pub fn assoc(in self, i: u64) -> AssocDecl {
        match self.assocs.try_get(i) {
            Option::Some(x) => x,
            Option::None => AssocDecl { name: 0, bound: 0, span_start: 0, span_end: 0 },
        }
    }

    pub fn tref(in self, i: u64) -> TRef {
        match self.trefs.try_get(i) {
            Option::Some(x) => x,
            Option::None => TRef {
                pkg: 0,
                name: 0,
                arg_start: 0,
                arg_count: 0,
                span_start: 0,
                span_end: 0
            },
        }
    }

    pub fn conf(in self, i: u64) -> Conf {
        match self.confs.try_get(i) {
            Option::Some(x) => x,
            Option::None => Conf {
                model: false,
                model_name: 0,
                gen_start: 0,
                gen_count: 0,
                tref: 0,
                self_ty: 0,
                where_start: 0,
                where_count: 0,
                bind_start: 0,
                bind_count: 0,
                method_start: 0,
                method_count: 0,
                span_start: 0,
                span_end: 0
            },
        }
    }

    pub fn where_row(in self, i: u64) -> Where {
        match self.wheres.try_get(i) {
            Option::Some(x) => x,
            Option::None => Where { ty: 0, tref: 0 },
        }
    }

    pub fn bind(in self, i: u64) -> Bind {
        match self.binds.try_get(i) {
            Option::Some(x) => x,
            Option::None => Bind { name: 0, ty: 0, span_start: 0, span_end: 0 },
        }
    }

    pub fn use_row(in self, i: u64) -> UseRow {
        match self.uses.try_get(i) {
            Option::Some(x) => x,
            Option::None => UseRow { model: 0, span_start: 0, span_end: 0 },
        }
    }

    pub fn bound_syn(in self, i: u64) -> BoundSyn {
        match self.bounds.try_get(i) {
            Option::Some(x) => x,
            Option::None => BoundSyn { param: 0, tref: 0, span_start: 0, span_end: 0, owner: 0 },
        }
    }

    pub fn item(in self, i: u64) -> ItemRow {
        match self.items.try_get(i) {
            Option::Some(x) => x,
            Option::None => ItemRow {
                adt: false,
                name: 0,
                span_start: 0,
                span_end: 0,
                member_start: 0,
                member_count: 0
            },
        }
    }

    pub fn fn_row(in self, i: u64) -> FnRow {
        match self.fns.try_get(i) {
            Option::Some(x) => x,
            Option::None => FnRow { name: 0, gen_start: 0, gen_count: 0 },
        }
    }
}

// ------------------------------------------------------------------ decoder

fn sym(in nmap: ChunkSeq[u32], index: u64) -> u32 {
    u32_at(in nmap, index)
}

fn tid(in tmap: ChunkSeq[u32], index: u64) -> u32 {
    u32_at(in tmap, index)
}

fn read_gens(
    inout reader: Reader,
    in bytes: Slice[u8],
    inout decls: Decls,
    in nmap: ChunkSeq[u32]
) -> u32 {
    let n = reader.word(in bytes);
    for i in 0..n {
        let name = sym(in nmap, reader.word(in bytes));
        let bound = wrapping_u8(reader.word(in bytes));
        let row = reader.word(in bytes) != 0;
        decls.gens.push(Gen { name: name, bound: bound, row: row });
    }
    n32(n)
}

fn read_tref(
    inout reader: Reader,
    in bytes: Slice[u8],
    inout decls: Decls,
    in nmap: ChunkSeq[u32],
    in tmap: ChunkSeq[u32]
) -> u32 {
    let pkg_word = reader.word(in bytes);
    let pkg = if pkg_word == 0 {
        0
    } else {
        wrapping_add(sym(in nmap, wrapping_sub(pkg_word, 1)), 1)
    };
    let name = sym(in nmap, reader.word(in bytes));
    let arg_count = reader.word(in bytes);
    let arg_start = n32(decls.words.len());
    for i in 0..arg_count {
        let arg_ty = tid(in tmap, reader.word(in bytes));
        decls.words.push(arg_ty);
    }
    let span_start = reader.word(in bytes);
    let span_end = reader.word(in bytes);
    let id = n32(decls.trefs.len());
    decls.trefs.push(
        TRef {
            pkg: pkg,
            name: name,
            arg_start: arg_start,
            arg_count: n32(arg_count),
            span_start: span_start,
            span_end: span_end
        }
    );
    id
}

fn read_sig(
    inout reader: Reader,
    in bytes: Slice[u8],
    inout decls: Decls,
    in nmap: ChunkSeq[u32],
    in tmap: ChunkSeq[u32]
) {
    let name = sym(in nmap, reader.word(in bytes));
    let span_start = reader.word(in bytes);
    let span_end = reader.word(in bytes);
    let gen_start = n32(decls.gens.len());
    let gen_count = read_gens(inout reader, in bytes, inout decls, in nmap);
    let par_count = reader.word(in bytes);
    let par_start = n32(decls.pars.len());
    for i in 0..par_count {
        let pname = sym(in nmap, reader.word(in bytes));
        let pass = wrapping_u8(reader.word(in bytes));
        let proj_lists = reader.word(in bytes);
        let proj_start = n32(decls.words.len());
        for j in 0..proj_lists {
            let len = reader.word(in bytes);
            decls.words.push(n32(len));
            for k in 0..len {
                let proj_name = sym(in nmap, reader.word(in bytes));
                decls.words.push(proj_name);
            }
        }
        let proj_count = wrapping_sub(n32(decls.words.len()), proj_start);
        let ty = tid(in tmap, reader.word(in bytes));
        let par_span_start = reader.word(in bytes);
        let par_span_end = reader.word(in bytes);
        decls.pars.push(
            Par {
                name: pname,
                pass: pass,
                proj_start: proj_start,
                proj_count: proj_count,
                ty: ty,
                span_start: par_span_start,
                span_end: par_span_end
            }
        );
    }
    let result = tid(in tmap, reader.word(in bytes));
    let row = tid(in tmap, reader.word(in bytes));
    decls.sigs.push(
        Sig {
            name: name,
            span_start: span_start,
            span_end: span_end,
            gen_start: gen_start,
            gen_count: gen_count,
            par_start: par_start,
            par_count: n32(par_count),
            result: result,
            row: row
        }
    );
}

// Reads `n` signatures written one after another; they land in
// `sigs[first..first+n]` because each is pushed whole.
fn read_sigs(
    inout reader: Reader,
    in bytes: Slice[u8],
    inout decls: Decls,
    in nmap: ChunkSeq[u32],
    in tmap: ChunkSeq[u32]
) -> u32 {
    let n = reader.word(in bytes);
    for i in 0..n {
        read_sig(inout reader, in bytes, inout decls, in nmap, in tmap);
    }
    n32(n)
}

pub fn read_traits(
    inout reader: Reader,
    in bytes: Slice[u8],
    inout decls: Decls,
    in nmap: ChunkSeq[u32],
    in tmap: ChunkSeq[u32]
) {
    let n = reader.word(in bytes);
    for i in 0..n {
        let name = sym(in nmap, reader.word(in bytes));
        let span_start = reader.word(in bytes);
        let span_end = reader.word(in bytes);
        let gen_start = n32(decls.gens.len());
        let gen_count = read_gens(inout reader, in bytes, inout decls, in nmap);
        let assoc_count = reader.word(in bytes);
        let assoc_start = n32(decls.assocs.len());
        for j in 0..assoc_count {
            let assoc_name = sym(in nmap, reader.word(in bytes));
            let bound = wrapping_u8(reader.word(in bytes));
            let assoc_span_start = reader.word(in bytes);
            let assoc_span_end = reader.word(in bytes);
            decls.assocs.push(
                AssocDecl {
                    name: assoc_name,
                    bound: bound,
                    span_start: assoc_span_start,
                    span_end: assoc_span_end
                }
            );
        }
        let method_start = n32(decls.sigs.len());
        let method_count = read_sigs(inout reader, in bytes, inout decls, in nmap, in tmap);
        decls.traits.push(
            TraitRow {
                name: name,
                span_start: span_start,
                span_end: span_end,
                gen_start: gen_start,
                gen_count: gen_count,
                assoc_start: assoc_start,
                assoc_count: n32(assoc_count),
                method_start: method_start,
                method_count: method_count
            }
        );
    }
}

fn read_confs(
    inout reader: Reader,
    in bytes: Slice[u8],
    inout decls: Decls,
    in nmap: ChunkSeq[u32],
    in tmap: ChunkSeq[u32]
) {
    let n = reader.word(in bytes);
    for i in 0..n {
        let model = reader.word(in bytes) != 0;
        let model_name = sym(in nmap, reader.word(in bytes));
        let gen_start = n32(decls.gens.len());
        let gen_count = read_gens(inout reader, in bytes, inout decls, in nmap);
        let tref = read_tref(inout reader, in bytes, inout decls, in nmap, in tmap);
        let self_ty = tid(in tmap, reader.word(in bytes));
        let where_count = reader.word(in bytes);
        let where_start = n32(decls.wheres.len());
        for j in 0..where_count {
            let ty = tid(in tmap, reader.word(in bytes));
            let where_tref = read_tref(inout reader, in bytes, inout decls, in nmap, in tmap);
            decls.wheres.push(Where { ty: ty, tref: where_tref });
        }
        let bind_count = reader.word(in bytes);
        let bind_start = n32(decls.binds.len());
        for j in 0..bind_count {
            let bind_name = sym(in nmap, reader.word(in bytes));
            let bind_ty = tid(in tmap, reader.word(in bytes));
            let bind_span_start = reader.word(in bytes);
            let bind_span_end = reader.word(in bytes);
            decls.binds.push(
                Bind {
                    name: bind_name,
                    ty: bind_ty,
                    span_start: bind_span_start,
                    span_end: bind_span_end
                }
            );
        }
        let method_start = n32(decls.sigs.len());
        let method_count = read_sigs(inout reader, in bytes, inout decls, in nmap, in tmap);
        let span_start = reader.word(in bytes);
        let span_end = reader.word(in bytes);
        decls.confs.push(
            Conf {
                model: model,
                model_name: model_name,
                gen_start: gen_start,
                gen_count: gen_count,
                tref: tref,
                self_ty: self_ty,
                where_start: where_start,
                where_count: n32(where_count),
                bind_start: bind_start,
                bind_count: n32(bind_count),
                method_start: method_start,
                method_count: method_count,
                span_start: span_start,
                span_end: span_end
            }
        );
    }
}

fn read_items(
    inout reader: Reader,
    in bytes: Slice[u8],
    inout decls: Decls,
    in nmap: ChunkSeq[u32],
    in tmap: ChunkSeq[u32]
) {
    let n = reader.word(in bytes);
    for i in 0..n {
        let adt = reader.word(in bytes) != 0;
        let name = sym(in nmap, reader.word(in bytes));
        let span_start = reader.word(in bytes);
        let span_end = reader.word(in bytes);
        if adt {
            let field_count = reader.word(in bytes);
            let member_start = n32(decls.words.len());
            for j in 0..field_count {
                let field_ty = tid(in tmap, reader.word(in bytes));
                decls.words.push(field_ty);
            }
            decls.items.push(
                ItemRow {
                    adt: true,
                    name: name,
                    span_start: span_start,
                    span_end: span_end,
                    member_start: member_start,
                    member_count: n32(field_count)
                }
            );
        } else {
            let member_start = n32(decls.sigs.len());
            let op_count = read_sigs(inout reader, in bytes, inout decls, in nmap, in tmap);
            decls.items.push(
                ItemRow {
                    adt: false,
                    name: name,
                    span_start: span_start,
                    span_end: span_end,
                    member_start: member_start,
                    member_count: op_count
                }
            );
        }
    }
}

// Decodes the declaration section.
pub fn read_decls(
    inout reader: Reader,
    in bytes: Slice[u8],
    in nmap: ChunkSeq[u32],
    in tmap: ChunkSeq[u32]
) -> Decls {
    let mut decls = decls_new();
    decls.identity = sym(in nmap, reader.word(in bytes));
    let fn_count = reader.word(in bytes);
    for i in 0..fn_count {
        let name = sym(in nmap, reader.word(in bytes));
        let gen_start = n32(decls.gens.len());
        let gen_count = read_gens(inout reader, in bytes, inout decls, in nmap);
        decls.fns.push(FnRow { name: name, gen_start: gen_start, gen_count: gen_count });
    }
    read_traits(inout reader, in bytes, inout decls, in nmap, in tmap);
    read_confs(inout reader, in bytes, inout decls, in nmap, in tmap);
    let use_count = reader.word(in bytes);
    for i in 0..use_count {
        let model = sym(in nmap, reader.word(in bytes));
        let span_start = reader.word(in bytes);
        let span_end = reader.word(in bytes);
        decls.uses.push(UseRow { model: model, span_start: span_start, span_end: span_end });
    }
    let bound_count = reader.word(in bytes);
    for i in 0..bound_count {
        let param = sym(in nmap, reader.word(in bytes));
        let tref = read_tref(inout reader, in bytes, inout decls, in nmap, in tmap);
        let span_start = reader.word(in bytes);
        let span_end = reader.word(in bytes);
        let owner = sym(in nmap, reader.word(in bytes));
        decls.bounds.push(
            BoundSyn {
                param: param,
                tref: tref,
                span_start: span_start,
                span_end: span_end,
                owner: owner
            }
        );
    }
    read_items(inout reader, in bytes, inout decls, in nmap, in tmap);
    decls
}
