// Input/output codecs and ASCII validation helpers for `@vesper/check-pact`'s
// trait session (`session.ves`).

use @vesper/check-data::input::{Ctx, Reader};
use @vesper/check-data::names::{Names};
use @vesper/check-data::types::{EffNode, TyKind};

const K_FN: u8 = TyKind::Fn;
use @vesper/check-data::util::{add, inc, inc32, n32, push_decimal, u32_at, w};
use self::decl::{Gen};

const NONE32: u32 = 4294967295;

pub struct SessionMeta {
    pub pkg_name: u32,
    pub pkg_ver: u32,
    pub max_depth: u64,
    pub max_steps: u64,
    pub max_fix: u64,
    pub fingerprint: u32,
    pub prelude_adts: ChunkSeq[u32],
    pub eff_local: ChunkSeq[bool],
    pub eff_name: ChunkSeq[u32],
    pub eff_gen_start: ChunkSeq[u32],
    pub eff_gen_count: ChunkSeq[u32],
    pub eff_gens: ChunkSeq[Gen],
}

impl SessionMeta {
    pub fn eff_gen(in self, i: u64) -> Gen {
        match self.eff_gens.try_get(i) {
            Option::Some(g) => g,
            Option::None => Gen { name: 0, bound: 0, row: false },
        }
    }
}

pub fn sym(in nmap: ChunkSeq[u32], index: u64) -> u32 {
    u32_at(in nmap, index)
}

pub fn opt_sym(in nmap: ChunkSeq[u32], word: u64) -> u32 {
    if word == 0 {
        0
    } else {
        inc32(u32_at(in nmap, wrapping_sub(word, 1)))
    }
}

// Reads the trailing session metadata after `read_decls`.
pub fn read_session_meta(
    inout reader: Reader,
    in bytes: Slice[u8],
    in nmap: ChunkSeq[u32]
) -> SessionMeta {
    let pkg_name = sym(in nmap, reader.word(in bytes));
    let pkg_ver = sym(in nmap, reader.word(in bytes));
    let max_depth = reader.word(in bytes);
    let max_steps = reader.word(in bytes);
    let max_fix = reader.word(in bytes);
    let fingerprint = sym(in nmap, reader.word(in bytes));

    let prelude_count = reader.word(in bytes);
    let mut prelude_adts: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](prelude_count);
    for _ in 0..prelude_count {
        prelude_adts.push(sym(in nmap, reader.word(in bytes)));
    }

    let eff_count = reader.word(in bytes);
    let mut eff_local: ChunkSeq[bool] = ChunkSeq::with_capacity[bool](eff_count);
    let mut eff_name: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](eff_count);
    let mut eff_gen_start: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](eff_count);
    let mut eff_gen_count: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](eff_count);
    let mut eff_gens: ChunkSeq[Gen] = ChunkSeq::new[Gen]();
    for _ in 0..eff_count {
        eff_local.push(reader.word(in bytes) != 0);
        eff_name.push(sym(in nmap, reader.word(in bytes)));
        let gen_start = n32(eff_gens.len());
        let gen_count = reader.word(in bytes);
        for _ in 0..gen_count {
            let gen_name = sym(in nmap, reader.word(in bytes));
            let gen_bound = wrapping_u8(reader.word(in bytes));
            let gen_row = reader.word(in bytes) != 0;
            eff_gens.push(Gen { name: gen_name, bound: gen_bound, row: gen_row });
        }
        eff_gen_start.push(gen_start);
        eff_gen_count.push(n32(gen_count));
    }

    SessionMeta {
        pkg_name: pkg_name,
        pkg_ver: pkg_ver,
        max_depth: max_depth,
        max_steps: max_steps,
        max_fix: max_fix,
        fingerprint: fingerprint,
        prelude_adts: prelude_adts,
        eff_local: eff_local,
        eff_name: eff_name,
        eff_gen_start: eff_gen_start,
        eff_gen_count: eff_gen_count,
        eff_gens: eff_gens
    }
}

pub copy struct QArg {
    pub is_row: bool,
    pub ty: u32,
}

pub copy struct QGoal {
    pub self_ty: u32,
    pub trait_name: u32,
    pub brand_opt: u32,
    pub arg_start: u32,
    pub arg_count: u32,
}

pub struct QuerySpec {
    pub env_params: ChunkSeq[Gen],
    pub assumptions: ChunkSeq[QGoal],
    pub args: ChunkSeq[QArg],
    pub scope_at: ChunkSeq[u32],
    pub scope_len: ChunkSeq[u32],
    pub scope_models: ChunkSeq[u32],
    pub infer_names: ChunkSeq[u32],
    pub infer_kinds: ChunkSeq[u8],
    pub goal: QGoal,
}

pub fn read_q_names(
    inout reader: Reader,
    in bytes: Slice[u8],
    inout names: Names,
    inout nmap: ChunkSeq[u32]
) {
    let count = reader.word(in bytes);
    for _ in 0..count {
        let len = reader.word(in bytes);
        let start = reader.pos;
        let symbol = names.intern(in bytes[start..wrapping_add(start, len)]);
        nmap.push(symbol);
        let padded = wrapping_mul(wrapping_add(len, 7) / 8, 8);
        reader.pos = wrapping_add(start, padded);
    }
}

fn read_q_row(
    inout reader: Reader,
    in bytes: Slice[u8],
    inout ctx: Ctx,
    in nmap: ChunkSeq[u32],
    in tmap: ChunkSeq[u32]
) -> u32 {
    let count = reader.word(in bytes);
    let mut effs: ChunkSeq[EffNode] = ChunkSeq::new[EffNode]();
    let mut args: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for _ in 0..count {
        let label = opt_sym(in nmap, reader.word(in bytes));
        let name = sym(in nmap, reader.word(in bytes));
        let arg_count = reader.word(in bytes);
        let arg_start = n32(args.len());
        for _ in 0..arg_count {
            args.push(u32_at(in tmap, reader.word(in bytes)));
        }
        effs.push(EffNode { label: label, name: name, a: arg_start, n: n32(arg_count) });
    }
    let tail = opt_sym(in nmap, reader.word(in bytes));
    ctx.types.mk_row(in effs, in args, tail)
}

pub fn read_q_types(
    inout reader: Reader,
    in bytes: Slice[u8],
    inout ctx: Ctx,
    in nmap: ChunkSeq[u32],
    inout tmap: ChunkSeq[u32]
) {
    let count = reader.word(in bytes);
    for _ in 0..count {
        let kind = reader.word(in bytes);
        let mut id: u32 = 0;
        if kind == 0 {
            let neg = reader.word(in bytes) != 0;
            id = ctx.types.literal(neg, reader.word(in bytes));
        } else if kind == 1 {
            let name = sym(in nmap, reader.word(in bytes));
            let arg_count = reader.word(in bytes);
            let mut args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](arg_count);
            for _ in 0..arg_count {
                args.push(u32_at(in tmap, reader.word(in bytes)));
            }
            id = ctx.types.named(name, in args);
        } else if kind == 2 {
            let arg_count = reader.word(in bytes);
            let mut args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](arg_count);
            for _ in 0..arg_count {
                args.push(u32_at(in tmap, reader.word(in bytes)));
            }
            id = ctx.types.tuple(in args);
        } else if kind == 3 {
            let arg_count = reader.word(in bytes);
            let mut args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](arg_count);
            let mut passes: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](arg_count);
            for _ in 0..arg_count {
                passes.push(wrapping_u8(reader.word(in bytes)));
                args.push(u32_at(in tmap, reader.word(in bytes)));
            }
            let result = u32_at(in tmap, reader.word(in bytes));
            let row = read_q_row(inout reader, in bytes, inout ctx, in nmap, in tmap);
            let mode = wrapping_u8(reader.word(in bytes));
            id = ctx.types.mk_with(K_FN, mode, 0, in args, in passes, result, row, 0);
        } else if kind == 4 {
            let row = read_q_row(inout reader, in bytes, inout ctx, in nmap, in tmap);
            id = ctx.types.row_type(row);
        } else {
            id = ctx.types.infer;
        }
        tmap.push(id);
    }
}

fn read_q_goal(
    inout reader: Reader,
    in bytes: Slice[u8],
    in nmap: ChunkSeq[u32],
    in tmap: ChunkSeq[u32],
    inout args: ChunkSeq[QArg]
) -> QGoal {
    let self_ty = u32_at(in tmap, reader.word(in bytes));
    let trait_name = sym(in nmap, reader.word(in bytes));
    let arg_start = n32(args.len());
    let arg_count = reader.word(in bytes);
    for _ in 0..arg_count {
        let is_row = reader.word(in bytes) != 0;
        let ty = u32_at(in tmap, reader.word(in bytes));
        args.push(QArg { is_row: is_row, ty: ty });
    }
    let brand_opt = opt_sym(in nmap, reader.word(in bytes));
    QGoal {
        self_ty: self_ty,
        trait_name: trait_name,
        brand_opt: brand_opt,
        arg_start: arg_start,
        arg_count: n32(arg_count)
    }
}

pub fn read_query(in bytes: Slice[u8], inout ctx: Ctx) -> QuerySpec {
    let mut reader = Reader { pos: 0 };
    let mut nmap: ChunkSeq[u32] = ChunkSeq::new[u32]();
    read_q_names(inout reader, in bytes, inout ctx.names, inout nmap);
    let mut tmap: ChunkSeq[u32] = ChunkSeq::new[u32]();
    read_q_types(inout reader, in bytes, inout ctx, in nmap, inout tmap);

    let param_count = reader.word(in bytes);
    let mut env_params: ChunkSeq[Gen] = ChunkSeq::with_capacity[Gen](param_count);
    for _ in 0..param_count {
        let name = sym(in nmap, reader.word(in bytes));
        let bound = wrapping_u8(reader.word(in bytes));
        let row = reader.word(in bytes) != 0;
        env_params.push(Gen { name: name, bound: bound, row: row });
    }

    let assumption_count = reader.word(in bytes);
    let mut assumptions: ChunkSeq[QGoal] = ChunkSeq::with_capacity[QGoal](assumption_count);
    let mut args: ChunkSeq[QArg] = ChunkSeq::new[QArg]();
    for _ in 0..assumption_count {
        assumptions.push(read_q_goal(inout reader, in bytes, in nmap, in tmap, inout args));
    }

    let scope_count = reader.word(in bytes);
    let mut scope_at: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](scope_count);
    let mut scope_len: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](scope_count);
    let mut scope_models: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for _ in 0..scope_count {
        scope_at.push(n32(scope_models.len()));
        let model_count = reader.word(in bytes);
        for _ in 0..model_count {
            scope_models.push(sym(in nmap, reader.word(in bytes)));
        }
        scope_len.push(n32(model_count));
    }

    let infer_count = reader.word(in bytes);
    let mut infer_names: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](infer_count);
    let mut infer_kinds: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](infer_count);
    for _ in 0..infer_count {
        infer_names.push(sym(in nmap, reader.word(in bytes)));
        infer_kinds.push(wrapping_u8(reader.word(in bytes)));
    }

    let goal = read_q_goal(inout reader, in bytes, in nmap, in tmap, inout args);

    QuerySpec {
        env_params: env_params,
        assumptions: assumptions,
        args: args,
        scope_at: scope_at,
        scope_len: scope_len,
        scope_models: scope_models,
        infer_names: infer_names,
        infer_kinds: infer_kinds,
        goal: goal
    }
}

// ---------------------------------------------------------------------------
// Text / identifier / ordering utilities

pub fn put_str(inout out: ChunkSeq[u8], in text: Str) {
    out.extend(in text.as_bytes());
}

pub fn put_sym(inout out: ChunkSeq[u8], in names: Names, symbol: u32) {
    names.write(symbol, inout out);
}

pub fn put_num(inout out: ChunkSeq[u8], value: u64) {
    push_decimal(inout out, value);
}

// Formats `symbol` with Rust `{:?}` style quotes (ASCII).
pub fn put_quoted_sym(inout out: ChunkSeq[u8], in names: Names, symbol: u32) {
    out.push(34);
    let n = names.size(symbol);
    for i in 0..n {
        let ch = names.byte(symbol, i);
        if ch == 34 {
            put_str(inout out, "\\\"");
        } else if ch == 92 {
            put_str(inout out, "\\\\");
        } else if ch == 10 {
            put_str(inout out, "\\n");
        } else if ch == 13 {
            put_str(inout out, "\\r");
        } else if ch == 9 {
            put_str(inout out, "\\t");
        } else {
            out.push(ch);
        }
    }
    out.push(34);
}

pub fn cmp_sym_ascii(in names: Names, a: u32, b: u32) -> u8 {
    if a == b {
        return 1;
    }
    let a_len = names.size(a);
    let b_len = names.size(b);
    let min_n = if a_len < b_len { a_len } else { b_len };
    for i in 0..min_n {
        let a_byte = names.byte(a, i);
        let b_byte = names.byte(b, i);
        if a_byte < b_byte {
            return 0;
        }
        if a_byte > b_byte {
            return 2;
        }
    }
    if a_len < b_len {
        0
    } else if a_len > b_len {
        2
    } else {
        1
    }
}

pub fn valid_pkg_name(in names: Names, symbol: u32) -> bool {
    let n = names.size(symbol);
    if n == 0 {
        return false;
    }
    for i in 0..n {
        let byte = names.byte(symbol, i);
        let ok = (byte >= 97 && byte <= 122)
            || (byte >= 48 && byte <= 57)
            || byte == 64
            || byte == 47
            || byte == 45
            || byte == 95
            || byte == 46;
        if !ok {
            return false;
        }
    }
    true
}

pub fn valid_pkg_ver(in names: Names, symbol: u32) -> bool {
    let n = names.size(symbol);
    if n == 0 {
        return false;
    }
    for i in 0..n {
        let byte = names.byte(symbol, i);
        let ok = (byte >= 65 && byte <= 90)
            || (byte >= 97 && byte <= 122)
            || (byte >= 48 && byte <= 57)
            || byte == 43
            || byte == 45
            || byte == 46;
        if !ok {
            return false;
        }
    }
    true
}

fn is_ident_tail(byte: u8) -> bool {
    (byte >= 65 && byte <= 90)
        || (byte >= 97 && byte <= 122)
        || (byte >= 48 && byte <= 57)
        || byte == 95
}

pub fn valid_ident(in names: Names, symbol: u32) -> bool {
    let n = names.size(symbol);
    if n == 0 {
        return false;
    }
    let first = names.byte(symbol, 0);
    let first_ok = (first >= 65 && first <= 90) || (first >= 97 && first <= 122) || first == 95;
    if !first_ok {
        return false;
    }
    for i in 1..n {
        if !is_ident_tail(names.byte(symbol, i)) {
            return false;
        }
    }
    true
}

pub fn valid_key(in names: Names, symbol: u32) -> bool {
    let n = names.size(symbol);
    if n == 0 || names.byte(symbol, 0) == 36 {
        return false;
    }
    let mut seg_len: u64 = 0;
    for i in 0..n {
        let byte = names.byte(symbol, i);
        if byte == 46 || byte == 45 || byte == 47 {
            if seg_len == 0 {
                return false;
            }
            seg_len = 0;
        } else {
            if !is_ident_tail(byte) {
                return false;
            }
            seg_len = inc(seg_len);
        }
    }
    seg_len > 0
}

pub fn mode_debug_name(mode: u8) -> Str {
    if mode == 0 {
        "Copy"
    } else if mode == 1 {
        "Affine"
    } else {
        "Linear"
    }
}
