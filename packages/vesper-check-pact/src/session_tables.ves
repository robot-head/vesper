// Sorted Pact identity tables, constructor mode-scheme collection, diagnostic
// formatting (`CODE START END MESSAGE`) and `IdTables::rename_ids` for
// `@vesper/check-pact`'s session.

use @vesper/check-data::input::{Ctx};
use @vesper/check-data::names::{Names};
use @vesper/check-data::types::{TyMode};

const M_AFFINE: u8 = TyMode::Affine;
const M_COPY: u8 = TyMode::Copy;
const M_LINEAR: u8 = TyMode::Linear;
use @vesper/check-data::util::{add, inc, n32, u32_at, u64_at, u8_at, w};
use @vesper/pact::term::{kd_row, kd_type};
use self::decl::{Decls};
use self::frontend::{Fe};
use self::modes::{MAX_MODE_COMBINATIONS, SCHEME_OK, SCHEME_TOO_MANY_COMBOS, derive_adt_scheme};
use self::session_input::{
    SessionMeta, cmp_sym_ascii, put_num, put_str, put_sym, valid_ident, valid_key
};

const NONE32: u32 = 4294967295;
pub const NONE64: u64 = 18446744073709551615;

pub const ORIGIN_PRIMITIVE: u8 = 0;
pub const ORIGIN_UNIT: u8 = 1;
pub const ORIGIN_TUPLE: u8 = 2;
pub const ORIGIN_ADT: u8 = 3;

pub struct Tables {
    pub builtin_pkg: u64,
    pub local_pkg: u64,
    pub pkg0_str: u32,
    pub pkg1_str: u32,
    pub unit_ctor_id: u64,
    pub tuple_ctor_ids: ChunkSeq[u64],

    // Sorted `types` table.
    pub ty_origin: ChunkSeq[u8],
    pub ty_tuple_k: ChunkSeq[u8],
    pub ty_pkg: ChunkSeq[u64],
    pub ty_name: ChunkSeq[u32],
    pub ty_span_start: ChunkSeq[u64],
    pub ty_span_end: ChunkSeq[u64],
    pub ty_param_start: ChunkSeq[u32],
    pub ty_param_count: ChunkSeq[u32],
    pub ty_param_names: ChunkSeq[u32],
    pub ty_param_kinds: ChunkSeq[u8],
    pub ty_param_bounds: ChunkSeq[u8],
    pub ty_base: ChunkSeq[u8],
    pub ty_join_start: ChunkSeq[u32],
    pub ty_join_count: ChunkSeq[u32],
    pub ty_joins: ChunkSeq[u32],

    // Sorted `effects` table.
    pub ef_pkg: ChunkSeq[u64],
    pub ef_name: ChunkSeq[u32],
    pub ef_span_start: ChunkSeq[u64],
    pub ef_span_end: ChunkSeq[u64],
    pub ef_param_start: ChunkSeq[u32],
    pub ef_param_count: ChunkSeq[u32],
    pub ef_param_names: ChunkSeq[u32],
    pub ef_param_kinds: ChunkSeq[u8],
    pub ef_param_bounds: ChunkSeq[u8],

    // Sorted `traits` table.
    pub tr_decl_idx: ChunkSeq[u32],
    pub tr_name: ChunkSeq[u32],
    pub tr_span_start: ChunkSeq[u64],
    pub tr_span_end: ChunkSeq[u64],
    pub tr_param_start: ChunkSeq[u32],
    pub tr_param_count: ChunkSeq[u32],
    pub tr_param_kinds: ChunkSeq[u8],
    pub tr_assoc_start: ChunkSeq[u32],
    pub tr_assoc_count: ChunkSeq[u32],
    pub tr_assoc_names: ChunkSeq[u32],

    // Sorted `impls` and `models` tables (`acc_idx` indexes into `Fe::acc_*`).
    pub im_acc_idx: ChunkSeq[u32],
    pub im_name: ChunkSeq[u32],
    pub im_span_start: ChunkSeq[u64],
    pub im_span_end: ChunkSeq[u64],

    pub mo_acc_idx: ChunkSeq[u32],
    pub mo_name: ChunkSeq[u32],
    pub mo_span_start: ChunkSeq[u64],
    pub mo_span_end: ChunkSeq[u64],
}

impl Tables {
    pub fn pkg_str(in self, id: u64) -> u32 {
        if id == 0 {
            self.pkg0_str
        } else {
            self.pkg1_str
        }
    }
}

pub fn empty_tables() -> Tables {
    Tables {
        builtin_pkg: 0,
        local_pkg: 1,
        pkg0_str: 0,
        pkg1_str: 0,
        unit_ctor_id: 0,
        tuple_ctor_ids: ChunkSeq::new[u64](),
        ty_origin: ChunkSeq::new[u8](),
        ty_tuple_k: ChunkSeq::new[u8](),
        ty_pkg: ChunkSeq::new[u64](),
        ty_name: ChunkSeq::new[u32](),
        ty_span_start: ChunkSeq::new[u64](),
        ty_span_end: ChunkSeq::new[u64](),
        ty_param_start: ChunkSeq::new[u32](),
        ty_param_count: ChunkSeq::new[u32](),
        ty_param_names: ChunkSeq::new[u32](),
        ty_param_kinds: ChunkSeq::new[u8](),
        ty_param_bounds: ChunkSeq::new[u8](),
        ty_base: ChunkSeq::new[u8](),
        ty_join_start: ChunkSeq::new[u32](),
        ty_join_count: ChunkSeq::new[u32](),
        ty_joins: ChunkSeq::new[u32](),
        ef_pkg: ChunkSeq::new[u64](),
        ef_name: ChunkSeq::new[u32](),
        ef_span_start: ChunkSeq::new[u64](),
        ef_span_end: ChunkSeq::new[u64](),
        ef_param_start: ChunkSeq::new[u32](),
        ef_param_count: ChunkSeq::new[u32](),
        ef_param_names: ChunkSeq::new[u32](),
        ef_param_kinds: ChunkSeq::new[u8](),
        ef_param_bounds: ChunkSeq::new[u8](),
        tr_decl_idx: ChunkSeq::new[u32](),
        tr_name: ChunkSeq::new[u32](),
        tr_span_start: ChunkSeq::new[u64](),
        tr_span_end: ChunkSeq::new[u64](),
        tr_param_start: ChunkSeq::new[u32](),
        tr_param_count: ChunkSeq::new[u32](),
        tr_param_kinds: ChunkSeq::new[u8](),
        tr_assoc_start: ChunkSeq::new[u32](),
        tr_assoc_count: ChunkSeq::new[u32](),
        tr_assoc_names: ChunkSeq::new[u32](),
        im_acc_idx: ChunkSeq::new[u32](),
        im_name: ChunkSeq::new[u32](),
        im_span_start: ChunkSeq::new[u64](),
        im_span_end: ChunkSeq::new[u64](),
        mo_acc_idx: ChunkSeq::new[u32](),
        mo_name: ChunkSeq::new[u32](),
        mo_span_start: ChunkSeq::new[u64](),
        mo_span_end: ChunkSeq::new[u64](),
    }
}

pub struct DiagSink {
    pub invalid: ChunkSeq[u8],
    pub unsupported: ChunkSeq[u8],
}

pub fn diag_sink_new() -> DiagSink {
    DiagSink {
        invalid: ChunkSeq::new[u8](),
        unsupported: ChunkSeq::new[u8](),
    }
}

pub fn emit_line(
    inout out: ChunkSeq[u8],
    in code: Str,
    span_start: u64,
    span_end: u64,
    in sub_code: Str,
    in msg: Slice[u8],
    in tables: Tables,
    in names: Names,
    has_subj: bool,
    subj_kind: u8,
    subj_pkg: u64,
    subj_name: u32
) {
    put_str(inout out, in code);
    out.push(32);
    put_num(inout out, span_start);
    out.push(32);
    put_num(inout out, span_end);
    out.push(32);
    put_str(inout out, in sub_code);
    put_str(inout out, ": ");
    for i in 0..msg.len() {
        let ch = u8_at_slice(in msg, i);
        out.push(if ch == 10 { 1 } else { ch });
    }
    if has_subj {
        put_str(inout out, " (");
        put_def_path(inout out, in tables, in names, subj_kind, subj_pkg, subj_name);
        out.push(41);
    }
    out.push(10);
}

// `DefPath::Display`: prefix (`"" | "effect " | "trait " | "impl " | "model "`) + `pkg@ver::name`.
pub fn put_def_path(
    inout out: ChunkSeq[u8],
    in tables: Tables,
    in names: Names,
    kind: u8,
    pkg_id: u64,
    name_sym: u32
) {
    if kind == 1 {
        put_str(inout out, "effect ");
    } else if kind == 2 {
        put_str(inout out, "trait ");
    } else if kind == 3 {
        put_str(inout out, "impl ");
    } else if kind == 4 {
        put_str(inout out, "model ");
    }
    put_sym(inout out, in names, tables.pkg_str(pkg_id));
    put_str(inout out, "::");
    put_sym(inout out, in names, name_sym);
}

fn intern_tuple_name(inout names: Names, arity: u64) -> u32 {
    let mut text: ChunkSeq[u8] = ChunkSeq::new[u8]();
    put_str(inout text, "(tuple/");
    put_num(inout text, arity);
    text.push(41);
    names.intern(in text.as_slice())
}

fn intern_pkg_str(inout names: Names, pkg: u32, ver: u32) -> u32 {
    let mut text: ChunkSeq[u8] = ChunkSeq::new[u8]();
    names.write(pkg, inout text);
    text.push(64);
    names.write(ver, inout text);
    names.intern(in text.as_slice())
}

fn is_primitive_name(in names: Names, symbol: u32) -> bool {
    names.spells(symbol, in "u8".as_bytes())
        || names.spells(symbol, in "u32".as_bytes())
        || names.spells(symbol, in "u64".as_bytes())
        || names.spells(symbol, in "i64".as_bytes())
        || names.spells(symbol, in "f64".as_bytes())
        || names.spells(symbol, in "bool".as_bytes())
        || names.spells(symbol, in "Never".as_bytes())
        || names.spells(symbol, in "String".as_bytes())
        || names.spells(symbol, in "Unit".as_bytes())
}

fn intern_primitive_at(inout names: Names, i: u64) -> u32 {
    if i == 0 {
        names.intern(in "u8".as_bytes())
    } else if i == 1 {
        names.intern(in "u32".as_bytes())
    } else if i == 2 {
        names.intern(in "u64".as_bytes())
    } else if i == 3 {
        names.intern(in "i64".as_bytes())
    } else if i == 4 {
        names.intern(in "f64".as_bytes())
    } else if i == 5 {
        names.intern(in "bool".as_bytes())
    } else if i == 6 {
        names.intern(in "Never".as_bytes())
    } else {
        names.intern(in "String".as_bytes())
    }
}

fn cmp_entry(in names: Names, pkg_a: u64, sym_a: u32, pkg_b: u64, sym_b: u32) -> u8 {
    if pkg_a < pkg_b {
        return 0;
    }
    if pkg_a > pkg_b {
        return 2;
    }
    cmp_sym_ascii(in names, sym_a, sym_b)
}

fn local_item_span(in decls: Decls, is_adt: bool, name: u32) -> (u64, u64) {
    for i in 0..decls.items.len() {
        let item = decls.item(i);
        if item.adt == is_adt && item.name == name {
            return (item.span_start, item.span_end);
        }
    }
    (0, 0)
}

// Builds `Tables`, deriving constructor mode schemes and checking Phase 1 names.
pub fn build_tables(
    inout ctx: Ctx,
    in decls: Decls,
    in fe: Fe,
    in meta: SessionMeta,
    inout sink: DiagSink
) -> Tables {
    let mut tables = empty_tables();
    let builtin_name = ctx.names.intern(in "@vesper/builtin".as_bytes());
    let builtin_ver = ctx.names.intern(in "0.0.0".as_bytes());
    let builtin_str = ctx.names.intern(in "@vesper/builtin@0.0.0".as_bytes());
    let local_str = intern_pkg_str(inout ctx.names, meta.pkg_name, meta.pkg_ver);

    let cmp_name = cmp_sym_ascii(in ctx.names, meta.pkg_name, builtin_name);
    let cmp_pkg = if cmp_name != 1 {
        cmp_name
    } else {
        cmp_sym_ascii(in ctx.names, meta.pkg_ver, builtin_ver)
    };
    if cmp_pkg == 0 {
        tables.local_pkg = 0;
        tables.builtin_pkg = 1;
        tables.pkg0_str = local_str;
        tables.pkg1_str = builtin_str;
    } else {
        tables.builtin_pkg = 0;
        tables.local_pkg = 1;
        tables.pkg0_str = builtin_str;
        tables.pkg1_str = local_str;
    }

    // 1. Collect and sort `traits`, `impls`, `models`.
    let mut trait_idxs: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut trait_syms: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..decls.traits.len() {
        let trait_row = decls.trait_row(i);
        trait_idxs.push(n32(i));
        trait_syms.push(trait_row.name);
        if !valid_ident(in ctx.names, trait_row.name) {
            emit_line(
                inout sink.invalid,
                "E0601",
                trait_row.span_start,
                trait_row.span_end,
                "BRIDGE0001",
                in "invalid trait name".as_bytes(),
                in tables,
                in ctx.names,
                true,
                2,
                tables.local_pkg,
                trait_row.name
            );
        }
    }
    sort_u32_pairs(in ctx.names, inout trait_syms, inout trait_idxs);
    for i in 1..trait_syms.len() {
        if u32_at(in trait_syms, wrapping_sub(i, 1)) == u32_at(in trait_syms, i) {
            emit_line(
                inout sink.invalid,
                "E0601",
                0,
                0,
                "BRIDGE0001",
                in "duplicate trait".as_bytes(),
                in tables,
                in ctx.names,
                true,
                2,
                tables.local_pkg,
                u32_at(in trait_syms, i)
            );
        }
    }

    let mut im_acc: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut im_sym: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut mo_acc: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut mo_sym: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for j in 0..fe.acc_conf.len() {
        let is_model = fe.acc_model.try_get(j).unwrap_or(false);
        let path_sym = u32_at(in fe.acc_path, j);
        let acc_conf = decls.conf(w(u32_at(in fe.acc_conf, j)));
        if is_model {
            mo_acc.push(n32(j));
            mo_sym.push(path_sym);
            if !valid_ident(in ctx.names, path_sym) {
                emit_line(
                    inout sink.invalid,
                    "E0601",
                    acc_conf.span_start,
                    acc_conf.span_end,
                    "BRIDGE0001",
                    in "invalid model name".as_bytes(),
                    in tables,
                    in ctx.names,
                    true,
                    4,
                    tables.local_pkg,
                    path_sym
                );
            }
        } else {
            im_acc.push(n32(j));
            im_sym.push(path_sym);
            if !valid_key(in ctx.names, path_sym) {
                emit_line(
                    inout sink.invalid,
                    "E0601",
                    acc_conf.span_start,
                    acc_conf.span_end,
                    "BRIDGE0001",
                    in "invalid impl key".as_bytes(),
                    in tables,
                    in ctx.names,
                    true,
                    3,
                    tables.local_pkg,
                    path_sym
                );
            }
        }
    }
    sort_u32_pairs(in ctx.names, inout im_sym, inout im_acc);
    sort_u32_pairs(in ctx.names, inout mo_sym, inout mo_acc);
    for i in 1..im_sym.len() {
        if u32_at(in im_sym, wrapping_sub(i, 1)) == u32_at(in im_sym, i) {
            emit_line(
                inout sink.invalid,
                "E0601",
                0,
                0,
                "BRIDGE0001",
                in "duplicate impl key".as_bytes(),
                in tables,
                in ctx.names,
                true,
                3,
                tables.local_pkg,
                u32_at(in im_sym, i)
            );
        }
    }
    for i in 1..mo_sym.len() {
        if u32_at(in mo_sym, wrapping_sub(i, 1)) == u32_at(in mo_sym, i) {
            emit_line(
                inout sink.invalid,
                "E0601",
                0,
                0,
                "BRIDGE0001",
                in "duplicate model".as_bytes(),
                in tables,
                in ctx.names,
                true,
                4,
                tables.local_pkg,
                u32_at(in mo_sym, i)
            );
        }
    }
    if sink.invalid.len() > 0 {
        return tables;
    }

    for i in 0..trait_idxs.len() {
        let decl_idx = u32_at(in trait_idxs, i);
        let trait_row = decls.trait_row(w(decl_idx));
        tables.tr_decl_idx.push(decl_idx);
        tables.tr_name.push(trait_row.name);
        tables.tr_span_start.push(trait_row.span_start);
        tables.tr_span_end.push(trait_row.span_end);
        tables.tr_param_start.push(n32(tables.tr_param_kinds.len()));
        tables.tr_param_count.push(trait_row.gen_count);
        for g_i in 0..w(trait_row.gen_count) {
            let generic = decls.gen(add(w(trait_row.gen_start), g_i));
            tables.tr_param_kinds.push(
                if generic.row {
                    wrapping_u8(kd_row())
                } else {
                    wrapping_u8(kd_type())
                }
            );
        }
        tables.tr_assoc_start.push(n32(tables.tr_assoc_names.len()));
        tables.tr_assoc_count.push(trait_row.assoc_count);
        for a_i in 0..w(trait_row.assoc_count) {
            let assoc = decls.assoc(add(w(trait_row.assoc_start), a_i));
            tables.tr_assoc_names.push(assoc.name);
        }
    }

    for i in 0..im_acc.len() {
        let acc_idx = u32_at(in im_acc, i);
        let conf = decls.conf(w(u32_at(in fe.acc_conf, w(acc_idx))));
        tables.im_acc_idx.push(acc_idx);
        tables.im_name.push(u32_at(in im_sym, i));
        tables.im_span_start.push(conf.span_start);
        tables.im_span_end.push(conf.span_end);
    }
    for i in 0..mo_acc.len() {
        let acc_idx = u32_at(in mo_acc, i);
        let conf = decls.conf(w(u32_at(in fe.acc_conf, w(acc_idx))));
        tables.mo_acc_idx.push(acc_idx);
        tables.mo_name.push(u32_at(in mo_sym, i));
        tables.mo_span_start.push(conf.span_start);
        tables.mo_span_end.push(conf.span_end);
    }

    // 2. Collect and sort `effects`.
    let mut ef_order: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](meta.eff_name.len());
    for i in 0..meta.eff_name.len() {
        ef_order.push(n32(i));
    }
    for i in 1..ef_order.len() {
        let mut j = i;
        loop {
            if j == 0 {
                break;
            }
            let prev = wrapping_sub(j, 1);
            let prev_entry = w(u32_at(in ef_order, prev));
            let cur_entry = w(u32_at(in ef_order, j));
            let prev_pkg = if is_eff_local(in meta, prev_entry) {
                tables.local_pkg
            } else {
                tables.builtin_pkg
            };
            let cur_pkg = if is_eff_local(in meta, cur_entry) {
                tables.local_pkg
            } else {
                tables.builtin_pkg
            };
            if cmp_entry(
                in ctx.names,
                prev_pkg,
                u32_at(in meta.eff_name, prev_entry),
                cur_pkg,
                u32_at(in meta.eff_name, cur_entry)
            )
                != 2 {
                break;
            }
            let prev_slot = u32_at(in ef_order, prev);
            let cur_slot = u32_at(in ef_order, j);
            let _ = ef_order.try_set(prev, cur_slot);
            let _ = ef_order.try_set(j, prev_slot);
            j = prev;
        }
    }
    for i in 0..ef_order.len() {
        let eff_idx = w(u32_at(in ef_order, i));
        let is_local = is_eff_local(in meta, eff_idx);
        let eff_name = u32_at(in meta.eff_name, eff_idx);
        tables.ef_pkg.push(
            if is_local {
                tables.local_pkg
            } else {
                tables.builtin_pkg
            }
        );
        tables.ef_name.push(eff_name);
        if is_local {
            let (span_start, span_end) = local_item_span(in decls, false, eff_name);
            tables.ef_span_start.push(span_start);
            tables.ef_span_end.push(span_end);
        } else {
            tables.ef_span_start.push(0);
            tables.ef_span_end.push(0);
        }
        tables.ef_param_start.push(n32(tables.ef_param_names.len()));
        let gen_count = u32_at(in meta.eff_gen_count, eff_idx);
        let gen_start = u32_at(in meta.eff_gen_start, eff_idx);
        tables.ef_param_count.push(gen_count);
        for g_i in 0..w(gen_count) {
            let generic = meta.eff_gen(add(w(gen_start), g_i));
            tables.ef_param_names.push(generic.name);
            tables.ef_param_kinds.push(
                if generic.row {
                    wrapping_u8(kd_row())
                } else {
                    wrapping_u8(kd_type())
                }
            );
            tables.ef_param_bounds.push(if generic.row { M_LINEAR } else { generic.bound });
        }
    }

    // 3. Collect and sort pending `types`.
    let mut cand_origin: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut cand_tag: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut cand_pkg: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut cand_sym: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut cand_adt: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut cand_span_start: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut cand_span_end: ChunkSeq[u64] = ChunkSeq::new[u64]();

    for i in 0..8 {
        let prim_sym = intern_primitive_at(inout ctx.names, i);
        let prim_mode = if i == 7 { M_AFFINE } else { M_COPY };
        cand_origin.push(ORIGIN_PRIMITIVE);
        cand_tag.push(prim_mode);
        cand_pkg.push(tables.builtin_pkg);
        cand_sym.push(prim_sym);
        cand_adt.push(NONE32);
        cand_span_start.push(0);
        cand_span_end.push(0);
    }
    let unit_sym = ctx.names.intern(in "Unit".as_bytes());
    cand_origin.push(ORIGIN_UNIT);
    cand_tag.push(M_COPY);
    cand_pkg.push(tables.builtin_pkg);
    cand_sym.push(unit_sym);
    cand_adt.push(NONE32);
    cand_span_start.push(0);
    cand_span_end.push(0);

    for tuple_len in 1..13 {
        let tuple_sym = intern_tuple_name(inout ctx.names, tuple_len);
        cand_origin.push(ORIGIN_TUPLE);
        cand_tag.push(wrapping_u8(tuple_len));
        cand_pkg.push(tables.builtin_pkg);
        cand_sym.push(tuple_sym);
        cand_adt.push(NONE32);
        cand_span_start.push(0);
        cand_span_end.push(0);
    }

    for i in 0..meta.prelude_adts.len() {
        let name = u32_at(in meta.prelude_adts, i);
        if !is_primitive_name(in ctx.names, name) {
            let adt_id = ctx.world.lookup(name);
            if adt_id != NONE32 {
                cand_origin.push(ORIGIN_ADT);
                cand_tag.push(0);
                cand_pkg.push(tables.builtin_pkg);
                cand_sym.push(name);
                cand_adt.push(adt_id);
                cand_span_start.push(0);
                cand_span_end.push(0);
            }
        }
    }

    for i in 0..decls.items.len() {
        let item = decls.item(i);
        if item.adt {
            let adt_id = ctx.world.lookup(item.name);
            if adt_id != NONE32 {
                cand_origin.push(ORIGIN_ADT);
                cand_tag.push(0);
                cand_pkg.push(tables.local_pkg);
                cand_sym.push(item.name);
                cand_adt.push(adt_id);
                cand_span_start.push(item.span_start);
                cand_span_end.push(item.span_end);
            }
        }
    }

    let type_count = cand_sym.len();
    let mut ty_ord: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](type_count);
    for i in 0..type_count {
        ty_ord.push(n32(i));
    }
    for i in 1..type_count {
        let mut j = i;
        loop {
            if j == 0 {
                break;
            }
            let prev = wrapping_sub(j, 1);
            let prev_entry = w(u32_at(in ty_ord, prev));
            let cur_entry = w(u32_at(in ty_ord, j));
            if cmp_entry(
                in ctx.names,
                u64_at(in cand_pkg, prev_entry),
                u32_at(in cand_sym, prev_entry),
                u64_at(in cand_pkg, cur_entry),
                u32_at(in cand_sym, cur_entry)
            )
                != 2 {
                break;
            }
            let prev_slot = u32_at(in ty_ord, prev);
            let cur_slot = u32_at(in ty_ord, j);
            let _ = ty_ord.try_set(prev, cur_slot);
            let _ = ty_ord.try_set(j, prev_slot);
            j = prev;
        }
    }

    for _ in 0..13 {
        tables.tuple_ctor_ids.push(0);
    }

    for ctor_id in 0..type_count {
        let cand_idx = w(u32_at(in ty_ord, ctor_id));
        let origin = u8_at(in cand_origin, cand_idx);
        let tag = u8_at(in cand_tag, cand_idx);
        let pkg = u64_at(in cand_pkg, cand_idx);
        let name = u32_at(in cand_sym, cand_idx);
        let adt_idx = u32_at(in cand_adt, cand_idx);
        let span_start = u64_at(in cand_span_start, cand_idx);
        let span_end = u64_at(in cand_span_end, cand_idx);

        tables.ty_origin.push(origin);
        tables.ty_tuple_k.push(tag);
        tables.ty_pkg.push(pkg);
        tables.ty_name.push(name);
        tables.ty_span_start.push(span_start);
        tables.ty_span_end.push(span_end);
        tables.ty_param_start.push(n32(tables.ty_param_names.len()));
        tables.ty_join_start.push(n32(tables.ty_joins.len()));

        if origin == ORIGIN_PRIMITIVE {
            tables.ty_param_count.push(0);
            tables.ty_base.push(tag);
            tables.ty_join_count.push(0);
        } else if origin == ORIGIN_UNIT {
            tables.unit_ctor_id = ctor_id;
            tables.ty_param_count.push(0);
            tables.ty_base.push(M_COPY);
            tables.ty_join_count.push(0);
        } else if origin == ORIGIN_TUPLE {
            let arity = widen_u64(tag);
            let _ = tables.tuple_ctor_ids.try_set(arity, ctor_id);
            tables.ty_param_count.push(n32(arity));
            for p_i in 0..arity {
                let mut pname_text: ChunkSeq[u8] = ChunkSeq::new[u8]();
                put_num(inout pname_text, p_i);
                tables.ty_param_names.push(ctx.names.intern(in pname_text.as_slice()));
                tables.ty_param_kinds.push(wrapping_u8(kd_type()));
                tables.ty_param_bounds.push(M_LINEAR);
                tables.ty_joins.push(n32(p_i));
            }
            tables.ty_base.push(M_COPY);
            tables.ty_join_count.push(n32(arity));
        } else {
            let adt = ctx.world.adt(adt_idx);
            tables.ty_param_count.push(adt.gn);
            for g_i in 0..w(adt.gn) {
                let generic = ctx.world.generic(add(w(adt.ga), g_i));
                tables.ty_param_names.push(generic.name);
                tables.ty_param_kinds.push(
                    if generic.row {
                        wrapping_u8(kd_row())
                    } else {
                        wrapping_u8(kd_type())
                    }
                );
                tables.ty_param_bounds.push(generic.bound);
            }
            let scheme = derive_adt_scheme(inout ctx.types, inout ctx.names, in ctx.world, adt_idx);
            if scheme.status == SCHEME_OK {
                tables.ty_base.push(scheme.base);
                tables.ty_join_count.push(n32(scheme.joins.len()));
                for j_i in 0..scheme.joins.len() {
                    tables.ty_joins.push(u32_at(in scheme.joins, j_i));
                }
            } else {
                let mut msg: ChunkSeq[u8] = ChunkSeq::new[u8]();
                if scheme.status == SCHEME_TOO_MANY_COMBOS {
                    msg.push(96);
                    put_sym(inout msg, in ctx.names, adt.name);
                    put_str(inout msg, "` has ");
                    put_num(inout msg, scheme.non_row_count);
                    put_str(
                        inout msg,
                        " type parameters; verifying its mode scheme against the checker needs more than "
                    );
                    put_num(inout msg, MAX_MODE_COMBINATIONS);
                    put_str(inout msg, " argument-mode combinations");
                } else {
                    put_str(inout msg, "the checker's mode of `");
                    put_sym(inout msg, in ctx.names, adt.name);
                    put_str(
                        inout msg,
                        "` cannot be represented as `base ⊔ joined arguments`; Pact's ModeScheme cannot represent it"
                    );
                }
                emit_line(
                    inout sink.unsupported,
                    "E0607",
                    0,
                    0,
                    "BRIDGE0002",
                    in msg.as_slice(),
                    in tables,
                    in ctx.names,
                    true,
                    0,
                    pkg,
                    name
                );
                tables.ty_base.push(M_LINEAR);
                tables.ty_join_count.push(0);
            }
        }
    }

    tables
}

fn is_eff_local(in meta: SessionMeta, i: u64) -> bool {
    meta.eff_local.try_get(i).unwrap_or(false)
}

fn sort_u32_pairs(in names: Names, inout syms: ChunkSeq[u32], inout vals: ChunkSeq[u32]) {
    for i in 1..syms.len() {
        let mut j = i;
        loop {
            if j == 0 {
                break;
            }
            let prev = wrapping_sub(j, 1);
            if cmp_sym_ascii(in names, u32_at(in syms, prev), u32_at(in syms, j)) != 2 {
                break;
            }
            let prev_sym = u32_at(in syms, prev);
            let cur_sym = u32_at(in syms, j);
            let _ = syms.try_set(prev, cur_sym);
            let _ = syms.try_set(j, prev_sym);
            let prev_val = u32_at(in vals, prev);
            let cur_val = u32_at(in vals, j);
            let _ = vals.try_set(prev, cur_val);
            let _ = vals.try_set(j, prev_val);
            j = prev;
        }
    }
}

// Lookup helpers.
pub fn find_type_in_pkg(in tables: Tables, pkg: u64, name: u32) -> u64 {
    for i in 0..tables.ty_name.len() {
        if u64_at(in tables.ty_pkg, i) == pkg && u32_at(in tables.ty_name, i) == name {
            return i;
        }
    }
    NONE64
}

pub fn resolve_type_id(in tables: Tables, in names: Names, site_pkg: u64, name: u32) -> u64 {
    if !valid_ident(in names, name) {
        return NONE64;
    }
    if names.spells(name, in "Unit".as_bytes()) {
        return tables.unit_ctor_id;
    }
    let hit = find_type_in_pkg(in tables, site_pkg, name);
    if hit != NONE64 {
        return hit;
    }
    find_type_in_pkg(in tables, tables.builtin_pkg, name)
}

pub fn resolve_effect_id(in tables: Tables, site_pkg: u64, name: u32) -> u64 {
    for i in 0..tables.ef_name.len() {
        if u64_at(in tables.ef_pkg, i) == site_pkg && u32_at(in tables.ef_name, i) == name {
            return i;
        }
    }
    for i in 0..tables.ef_name.len() {
        if u64_at(in tables.ef_pkg, i) == tables.builtin_pkg
            && u32_at(in tables.ef_name, i) == name {
            return i;
        }
    }
    NONE64
}

pub fn resolve_trait_id(in tables: Tables, name: u32) -> u64 {
    for i in 0..tables.tr_name.len() {
        if u32_at(in tables.tr_name, i) == name {
            return i;
        }
    }
    NONE64
}

pub fn resolve_model_id(in tables: Tables, name: u32) -> u64 {
    for i in 0..tables.mo_name.len() {
        if u32_at(in tables.mo_name, i) == name {
            return i;
        }
    }
    NONE64
}

pub fn find_assoc_idx(in tables: Tables, trait_id: u64, name: u32) -> u64 {
    let assoc_start = w(u32_at(in tables.tr_assoc_start, trait_id));
    let assoc_count = w(u32_at(in tables.tr_assoc_count, trait_id));
    for i in 0..assoc_count {
        if u32_at(in tables.tr_assoc_names, add(assoc_start, i)) == name {
            return i;
        }
    }
    NONE64
}

// ---------------------------------------------------------------------------
// `IdTables::rename_ids` and `!n` placeholder substitution.

fn starts_at(in bytes: Slice[u8], at: u64, in pat: Slice[u8]) -> bool {
    if add(at, pat.len()) > bytes.len() {
        return false;
    }
    for i in 0..pat.len() {
        if u8_at_slice(in bytes, add(at, i)) != u8_at_slice(in pat, i) {
            return false;
        }
    }
    true
}

fn u8_at_slice(in bytes: Slice[u8], i: u64) -> u8 {
    bytes.try_get(i).unwrap_or(0)
}

fn is_ascii_alnum(byte: u8) -> bool {
    (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122)
}

fn matches_prefix(in bytes: Slice[u8], at: u64, kind: u64) -> u64 {
    if kind == 0 {
        if starts_at(in bytes, at, in "pkg#".as_bytes()) {
            4
        } else {
            0
        }
    } else if kind == 1 {
        if starts_at(in bytes, at, in "type#".as_bytes()) {
            5
        } else {
            0
        }
    } else if kind == 2 {
        if starts_at(in bytes, at, in "trait#".as_bytes()) {
            6
        } else {
            0
        }
    } else if kind == 3 {
        if starts_at(in bytes, at, in "effect#".as_bytes()) {
            7
        } else {
            0
        }
    } else if kind == 4 {
        if starts_at(in bytes, at, in "impl#".as_bytes()) {
            5
        } else {
            0
        }
    } else {
        if starts_at(in bytes, at, in "model#".as_bytes()) {
            6
        } else {
            0
        }
    }
}

fn try_rename_token(
    in bytes: Slice[u8],
    at: u64,
    in tables: Tables,
    in names: Names,
    inout out: ChunkSeq[u8]
) -> u64 {
    if at > 0 && is_ascii_alnum(u8_at_slice(in bytes, wrapping_sub(at, 1))) {
        return 0;
    }
    for kind in 0..6 {
        let prefix_len = matches_prefix(in bytes, at, kind);
        if prefix_len > 0 {
            let start = add(at, prefix_len);
            let mut end = start;
            let mut id_value: u64 = 0;
            loop {
                if end >= bytes.len() {
                    break;
                }
                let ch = u8_at_slice(in bytes, end);
                if ch < 48 || ch > 57 {
                    break;
                }
                id_value = wrapping_add(
                    wrapping_mul(id_value, 10),
                    widen_u64(wrapping_sub(ch, 48))
                );
                end = inc(end);
            }
            if end > start && write_id_name(in tables, in names, kind, id_value, inout out) {
                return end;
            }
            return 0;
        }
    }
    0
}

fn write_id_name(
    in tables: Tables,
    in names: Names,
    kind: u64,
    id: u64,
    inout out: ChunkSeq[u8]
) -> bool {
    if kind == 0 {
        if id < 2 {
            put_sym(inout out, in names, tables.pkg_str(id));
            return true;
        }
        return false;
    }
    if kind == 1 {
        if id >= tables.ty_name.len() {
            return false;
        }
        let orig = u8_at(in tables.ty_origin, id);
        if orig == ORIGIN_TUPLE {
            put_str(inout out, "tuple/");
            put_num(inout out, widen_u64(u8_at(in tables.ty_tuple_k, id)));
            return true;
        }
        let pkg = u64_at(in tables.ty_pkg, id);
        if pkg == tables.builtin_pkg {
            put_sym(inout out, in names, u32_at(in tables.ty_name, id));
            return true;
        }
        put_def_path(inout out, in tables, in names, 0, pkg, u32_at(in tables.ty_name, id));
        return true;
    }
    if kind == 2 {
        if id >= tables.tr_name.len() {
            return false;
        }
        put_def_path(
            inout out,
            in tables,
            in names,
            2,
            tables.local_pkg,
            u32_at(in tables.tr_name, id)
        );
        return true;
    }
    if kind == 3 {
        if id >= tables.ef_name.len() {
            return false;
        }
        put_def_path(
            inout out,
            in tables,
            in names,
            1,
            u64_at(in tables.ef_pkg, id),
            u32_at(in tables.ef_name, id)
        );
        return true;
    }
    if kind == 4 {
        if id >= tables.im_name.len() {
            return false;
        }
        put_def_path(
            inout out,
            in tables,
            in names,
            3,
            tables.local_pkg,
            u32_at(in tables.im_name, id)
        );
        return true;
    }
    if kind == 5 {
        if id >= tables.mo_name.len() {
            return false;
        }
        put_def_path(
            inout out,
            in tables,
            in names,
            4,
            tables.local_pkg,
            u32_at(in tables.mo_name, id)
        );
        return true;
    }
    false
}

pub fn rename_ids(in raw: Slice[u8], in tables: Tables, in names: Names, inout out: ChunkSeq[u8]) {
    let mut i: u64 = 0;
    loop {
        if i >= raw.len() {
            break;
        }
        let next = try_rename_token(in raw, i, in tables, in names, inout out);
        if next > 0 {
            i = next;
        } else {
            out.push(u8_at_slice(in raw, i));
            i = inc(i);
        }
    }
}

pub fn render_query_text(
    in raw: Slice[u8],
    in tables: Tables,
    in names: Names,
    in ph_names: ChunkSeq[u32],
    inout out: ChunkSeq[u8]
) {
    let mut renamed: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](raw.len());
    rename_ids(in raw, in tables, in names, inout renamed);
    let renamed_bytes = renamed.as_slice();
    let mut i: u64 = 0;
    loop {
        if i >= renamed_bytes.len() {
            break;
        }
        let ch = u8_at_slice(in renamed_bytes, i);
        if ch == 33 {
            let start = inc(i);
            let mut end = start;
            let mut index: u64 = 0;
            loop {
                if end >= renamed_bytes.len() {
                    break;
                }
                let digit = u8_at_slice(in renamed_bytes, end);
                if digit < 48 || digit > 57 {
                    break;
                }
                index = wrapping_add(wrapping_mul(index, 10), widen_u64(wrapping_sub(digit, 48)));
                end = inc(end);
            }
            if end > start && index < ph_names.len() {
                put_sym(inout out, in names, u32_at(in ph_names, index));
                i = end;
                continue;
            }
        }
        out.push(ch);
        i = inc(i);
    }
}
