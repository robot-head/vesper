// @vesper/check-pact: trait resolution of the Vesper checker, in Vesper
// (self-hosting wave SH2, lane 13, #1185). It ports src/pact_frontend.rs
// (with src/pact_frontend/{mono,builtin_traits}.rs) onto the tables of
// @vesper/check-data, keeping the census design: types are `u32` ids of
// one hash-consed arena, names are interned symbols, and declarations are
// flat tables with list ranges into shared pools.
//
// Part 1 (this package so far) is the declaration pass of
// `pact_frontend::check_package` for a package without dependencies:
// `Frontend::collect_local` with `validate_trait`, `validate_conformance`,
// `compare_signature`, `collect_bound` and `assoc_cycle`, and the failures
// of `lower_bindings` (decl.ves, tyops.ves, frontend.ves). The Pact session,
// call resolution through @vesper/pact, monomorphization and the builtin
// traits are later parts. Rust stays the default checker.
//
// tests/self_host_check_pact.rs runs `check_pact_declarations` against
// `pact_frontend::declaration_pass` on every corpus world, the checker's
// trait tests and mutants that make each diagnostic fire.

use @vesper/check-data::input::{
    Reader,
    read_ctx
};
use @vesper/check-data::{
    pack_text
};
use self::decl::{
    read_decls
};
use self::deps::{
    deps_words
};
use self::tyops::{
    sy_new
};
use self::frontend::{
    declaration_pass,
    fe_new
};
pub use self::session::{
    PactSession,
    session_open,
    session_solve
};
use self::builtin_traits::{
    builtin_derive_words,
    builtin_wanted_words
};
use self::mono_check::{
    mono_check_words
};
use self::mono_plan::{
    mono_plan_words
};
use self::resolve::{
    normalize_words,
    resolve_words
};
use self::session::{
    queries_words,
    session_words
};

// Task "mono_plan" (part 6): `Mono::evidence`, `Mono::instance`, `Mono::instantiate_body`.
pub fn check_pact_mono_plan(in input: Str) -> ChunkSeq[u64] {
    mono_plan_words(in input.as_bytes())
}

// Task "builtin_derive" (part 4): `builtin_traits::derivable` + derived `impl`s.
pub fn check_pact_builtin_derive(in input: Str) -> ChunkSeq[u64] {
    builtin_derive_words(in input.as_bytes())
}

// Task "builtin_wanted" (part 7): `builtin_traits::wanted`.
pub fn check_pact_builtin_wanted(in input: Str) -> ChunkSeq[u64] {
    builtin_wanted_words(in input.as_bytes())
}

// Task "mono_check" (part 5): `Mono::close_bounded` and `Mono::check_obligations`.
pub fn check_pact_mono_check(in input: Str) -> ChunkSeq[u64] {
    mono_check_words(in input.as_bytes())
}

// Task "resolve" (part 3): `TraitCalls::resolve` over a Pact session.
pub fn check_pact_resolve(in input: Str) -> ChunkSeq[u64] {
    resolve_words(in input.as_bytes())
}

// Task "normalize" (part 3): `Elaborator::normalize` over a Pact session.
pub fn check_pact_normalize(in input: Str) -> ChunkSeq[u64] {
    normalize_words(in input.as_bytes())
}

// Task "session" (part 2b): the coherence-gated Pact session over the
// declaration section plus the session metadata (session_input.ves);
// returns the session's diagnostics as text, empty when it opens.
pub fn check_pact_session(in input: Str) -> ChunkSeq[u64] {
    session_words(in input.as_bytes())
}

// Task "queries": a session followed by queries (`session_solve` each).
pub fn check_pact_queries(in input: Str) -> ChunkSeq[u64] {
    queries_words(in input.as_bytes())
}

// Task "deps" (part 8): `Frontend::add_dependency` + cross-package trait refs.
pub fn check_pact_deps(in input: Str) -> ChunkSeq[u64] {
    deps_words(in input.as_bytes())
}

// Task "declarations": the declaration section (decl.ves) after the common
// sections; returns the diagnostics as text, one `CODE START END MESSAGE`
// line each, in the order Rust reports them.
pub fn check_pact_declarations(in input: Str) -> ChunkSeq[u64] {
    declarations_words(in input.as_bytes())
}

// `check_pact_declarations` over the input's bytes: the entry of the hybrid
// build's `modules/pact` (crates/vesper-hybrid).
pub fn declarations_words(in b: Slice[u8]) -> ChunkSeq[u64] {
    let mut r = Reader {
        pos: 0
    };
    let mut c = read_ctx(inout r, in b);
    let d = read_decls(inout r, in b, in c.nmap, in c.tmap);
    let sy = sy_new(inout c.names);
    let mut fe = fe_new(sy);
    let mut o = ChunkSeq::new[u8]();
    declaration_pass(inout c, in d, inout fe, inout o);
    pack_text(in o)
}

pub fn session_is_ok(in sess: PactSession) -> bool {
    sess.ok
}

pub fn session_revision(in sess: PactSession) -> ChunkSeq[u64] {
    pack_text(in sess.revision)
}

pub fn session_take_diagnostics(in sess: PactSession) -> ChunkSeq[u64] {
    pack_text(in sess.out)
}
