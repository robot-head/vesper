// Constructor mode-scheme derivation (`vesper-pact-binding/src/modes.rs`)
// over `@vesper/check-data`'s `World::mode_of`.
use @vesper/check-data::util::{add, inc, n32, push_decimal, u32_at, u8_at, w};
use @vesper/check-data::names::{Names};
use @vesper/check-data::types::{TyMode, Types};

const M_COPY: u8 = TyMode::Copy;
use @vesper/check-data::world::{Adt, Bounds, World, bounds_new, mode_of};

// Maximum well-formed argument-mode combinations verified per ADT
// (`vesper-pact-binding/src/modes.rs`).
pub const MAX_MODE_COMBINATIONS: u64 = 6561;

// Outcome tags of `derive_adt_scheme`.
pub const SCHEME_OK: u8 = 0;
pub const SCHEME_TOO_MANY_COMBOS: u8 = 1;
pub const SCHEME_UNREPRESENTABLE: u8 = 2;

pub struct DerivedScheme {
    pub status: u8,
    pub base: u8,
    pub joins: ChunkSeq[u32],
    pub non_row_count: u64,
    pub combos: u64,
}

fn synth_param_sym(inout names: Names, idx: u64) -> u32 {
    let mut text: ChunkSeq[u8] = ChunkSeq::new[u8]();
    text.extend(in "$pm_".as_bytes());
    push_decimal(inout text, idx);
    names.intern(in text.as_slice())
}

// Derives `(base, joins)` for `adt_idx` in `world`, checking every
// well-formed combination of argument modes against `World::mode_of`.
pub fn derive_adt_scheme(
    inout types: Types,
    inout names: Names,
    in world: World,
    adt_idx: u32
) -> DerivedScheme {
    let adt = world.adt(adt_idx);
    let gen_count = w(adt.gn);
    let mut is_row: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](gen_count);
    let mut bounds_max: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](gen_count);
    let mut non_row: u64 = 0;
    let mut combos: u64 = 1;
    let mut too_many = false;

    for i in 0..gen_count {
        let generic = world.generic(add(w(adt.ga), i));
        if generic.row {
            is_row.push(1);
            bounds_max.push(0);
        } else {
            is_row.push(0);
            bounds_max.push(generic.bound);
            non_row = inc(non_row);
            let ways = inc(widen_u64(generic.bound));
            if !too_many {
                combos = wrapping_mul(combos, ways);
                if combos > MAX_MODE_COMBINATIONS {
                    too_many = true;
                }
            }
        }
    }

    if too_many {
        return DerivedScheme {
            status: SCHEME_TOO_MANY_COMBOS,
            base: M_COPY,
            joins: ChunkSeq::new[u32](),
            non_row_count: non_row,
            combos: combos
        };
    }

    // Build `Adt[param_0, ...]` using synthetic placeholder symbols so
    // parameter names never shadow existing ADTs in `world`.
    let no_u32: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut param_syms: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](gen_count);
    let mut args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](gen_count);
    let row_empty = types.row_type(types.empty_row);
    for i in 0..gen_count {
        if u8_at(in is_row, i) != 0 {
            param_syms.push(0);
            args.push(row_empty);
        } else {
            let sym = synth_param_sym(inout names, i);
            param_syms.push(sym);
            let param_ty = types.named(sym, in no_u32);
            args.push(param_ty);
        }
    }
    let applied = types.named(adt.name, in args);

    // Evaluate all combinations in Cartesian odometer order `[0, 0, ..., 0]` first.
    let mut modes: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](gen_count);
    for _ in 0..gen_count {
        modes.push(0);
    }

    let mut observed: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](combos);
    let mut step: u64 = 0;
    loop {
        if step >= combos {
            break;
        }
        let mut bounds = bounds_new();
        for i in 0..gen_count {
            if u8_at(in is_row, i) == 0 {
                bounds.set(u32_at(in param_syms, i), u8_at(in modes, i));
            }
        }
        let mode = mode_of(inout types, in names, in world, applied, in bounds);
        observed.push(mode);

        // Advance odometer.
        let mut pos = gen_count;
        loop {
            if pos == 0 {
                break;
            }
            pos = wrapping_sub(pos, 1);
            if u8_at(in is_row, pos) == 0 {
                let next_mode = wrapping_add(u8_at(in modes, pos), 1);
                if next_mode <= u8_at(in bounds_max, pos) {
                    let _ = modes.try_set(pos, next_mode);
                    break;
                }
                let _ = modes.try_set(pos, 0);
            }
        }
        step = inc(step);
    }

    let base = u8_at(in observed, 0);

    // Compute stride of each parameter in odometer order to probe single-param bumps.
    let mut stride: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](gen_count);
    for _ in 0..gen_count {
        stride.push(0);
    }
    let mut stride_acc: u64 = 1;
    let mut idx = gen_count;
    loop {
        if idx == 0 {
            break;
        }
        idx = wrapping_sub(idx, 1);
        if u8_at(in is_row, idx) == 0 {
            let _ = stride.try_set(idx, stride_acc);
            stride_acc = wrapping_mul(stride_acc, inc(widen_u64(u8_at(in bounds_max, idx))));
        }
    }

    let mut joins: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut join_mask: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](gen_count);
    for i in 0..gen_count {
        let mut depends = false;
        if u8_at(in is_row, i) == 0 {
            let max_mode = widen_u64(u8_at(in bounds_max, i));
            let param_stride = stride.try_get(i).unwrap_or(0);
            for mode_value in 1..inc(max_mode) {
                let obs_index = wrapping_mul(mode_value, param_stride);
                if u8_at(in observed, obs_index) > base {
                    depends = true;
                }
            }
        }
        if depends {
            joins.push(n32(i));
            join_mask.push(1);
        } else {
            join_mask.push(0);
        }
    }

    // Verify the fitted `(base, joins)` matches every observed combination.
    let mut check_modes: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](gen_count);
    for _ in 0..gen_count {
        check_modes.push(0);
    }
    let mut ok = true;
    for k in 0..combos {
        let mut expected = base;
        for i in 0..gen_count {
            if u8_at(in join_mask, i) != 0 {
                let check_mode = u8_at(in check_modes, i);
                if check_mode > expected {
                    expected = check_mode;
                }
            }
        }
        if u8_at(in observed, k) != expected {
            ok = false;
        }
        let mut pos = gen_count;
        loop {
            if pos == 0 {
                break;
            }
            pos = wrapping_sub(pos, 1);
            if u8_at(in is_row, pos) == 0 {
                let next_mode = wrapping_add(u8_at(in check_modes, pos), 1);
                if next_mode <= u8_at(in bounds_max, pos) {
                    let _ = check_modes.try_set(pos, next_mode);
                    break;
                }
                let _ = check_modes.try_set(pos, 0);
            }
        }
    }

    if !ok {
        return DerivedScheme {
            status: SCHEME_UNREPRESENTABLE,
            base: base,
            joins: joins,
            non_row_count: non_row,
            combos: combos
        };
    }

    DerivedScheme {
        status: SCHEME_OK,
        base: base,
        joins: joins,
        non_row_count: non_row,
        combos: combos
    }
}
