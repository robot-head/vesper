// The declaration pass of the trait frontend: `Frontend::collect_local`,
// `validate_trait`, `validate_conformance`, `compare_signature`,
// `collect_bound`, `trait_key`, `assoc_cycle` and the failure paths of
// `lower_bindings` (src/pact_frontend.rs), for a package without
// dependencies. Each diagnostic is one line of `out`:
// `CODE START END MESSAGE` (these diagnostics carry no help or labels).
//
// Rust keeps `BTreeMap`s keyed by `String`; here every table is indexed by
// symbol: `kinds` (the name kinds `collect_local` reserves), `trait_of`
// (the accepted local traits) and `fn_of` (the base world's functions).

use @vesper/check-data::input::{Ctx};
use @vesper/check-data::names::{Names};
use @vesper/check-data::types::{Types, Vars, display, vars_new, TyKind};
use @vesper/check-data::world::{Bounds, bounds_new, mode_of, set_by_symbol};
use @vesper/check-data::util::{add, inc, n32, push_decimal, u32_at, w};
use self::decl::{Conf, Decls, Gen, Par, Sig, TRef, TraitRow};
use self::tyops::{
    Sy, binding_of, compatible, contains32, contains_projection, conform_type, insert32,
    is_projection, is_self, key_segment, mentions, proj_assoc, proj_self, proj_trait, proj_trait_ty,
    row_arg, same_type, trait_has_assoc
};

const NONE32: u32 = 4294967295;
const NONE64: u64 = 18446744073709551615;

// Name kinds `collect_local` reserves (its `names` map).
const N_TYPE: u32 = 1;
const N_EFFECT: u32 = 2;
const N_TRAIT: u32 = 3;
const N_MODEL: u32 = 4;

pub struct Fe {
    syms: Sy,
    // symbol -> name kind (N_*), or 0
    kinds: ChunkSeq[u32],
    // symbol -> accepted local trait index + 1, or 0
    trait_of: ChunkSeq[u32],
    // symbol -> base world function index + 1, or 0
    fn_of: ChunkSeq[u32],
    // the accepted local conformances (`Frontend::confs`), in order: the
    // conformance index, its trait index, whether it is a model and its
    // path's name (impl key or model name symbol)
    acc_conf: ChunkSeq[u32],
    acc_trait: ChunkSeq[u32],
    acc_model: ChunkSeq[bool],
    acc_path: ChunkSeq[u32],
    // Dependency support (`add_dependency`): `local_traits` is `NONE64` when
    // all traits in `d.traits` are local; otherwise `0..local_traits` are
    // local and `local_traits..d.traits.len()` belong to dependencies.
    pub local_traits: u64,
    pub dep_pkg_names: ChunkSeq[u32],
    pub dep_trait_pkg: ChunkSeq[u32],
    pub dep_adt_start: ChunkSeq[u32],
    pub dep_adt_count: ChunkSeq[u32],
    pub dep_adt_names: ChunkSeq[u32],
}

pub fn fe_new(syms: Sy) -> Fe {
    Fe {
        syms: syms,
        kinds: ChunkSeq::new[u32](),
        trait_of: ChunkSeq::new[u32](),
        fn_of: ChunkSeq::new[u32](),
        acc_conf: ChunkSeq::new[u32](),
        acc_trait: ChunkSeq::new[u32](),
        acc_model: ChunkSeq::new[bool](),
        acc_path: ChunkSeq::new[u32](),
        local_traits: NONE64,
        dep_pkg_names: ChunkSeq::new[u32](),
        dep_trait_pkg: ChunkSeq::new[u32](),
        dep_adt_start: ChunkSeq::new[u32](),
        dep_adt_count: ChunkSeq::new[u32](),
        dep_adt_names: ChunkSeq::new[u32]()
    }
}

fn at_symbol(in table: ChunkSeq[u32], symbol: u32) -> u32 {
    u32_at(in table, w(symbol))
}

// ---------------------------------------------------------------- output

fn put(inout out: ChunkSeq[u8], in text: Str) {
    out.extend(in text.as_bytes());
}

fn nm(inout out: ChunkSeq[u8], in names: Names, name: u32) {
    names.write(name, inout out);
}

fn num(inout out: ChunkSeq[u8], value: u64) {
    push_decimal(inout out, value);
}

// Starts a diagnostic line; the caller writes the message and `endl`.
fn head(inout out: ChunkSeq[u8], in code: Str, span_start: u64, span_end: u64) {
    put(inout out, code);
    out.push(32);
    num(inout out, span_start);
    out.push(32);
    num(inout out, span_end);
    out.push(32);
}

fn endl(inout out: ChunkSeq[u8]) {
    out.push(10);
}

fn kind_text(inout out: ChunkSeq[u8], kind: u32) {
    if kind == N_TYPE {
        put(inout out, "type");
    } else if kind == N_EFFECT {
        put(inout out, "effect");
    } else if kind == N_TRAIT {
        put(inout out, "trait");
    } else {
        put(inout out, "model");
    }
}

// `{:?}` of `ast::Mode`.
fn mode_text(inout out: ChunkSeq[u8], mode: u8) {
    if mode == 0 {
        put(inout out, "Copy");
    } else if mode == 1 {
        put(inout out, "Affine");
    } else {
        put(inout out, "Linear");
    }
}

// `{:?}` of `ast::Pass`.
fn pass_text(inout out: ChunkSeq[u8], pass: u8) {
    if pass == 0 {
        put(inout out, "In");
    } else if pass == 1 {
        put(inout out, "Inout");
    } else {
        put(inout out, "Sink");
    }
}

// `DefPath` of a local conformance: `impl @pkg@v::key` / `model @pkg@v::M`.
fn path_text(inout out: ChunkSeq[u8], in names: Names, in decls: Decls, model: bool, name: u32) {
    if model {
        put(inout out, "model ");
    } else {
        put(inout out, "impl ");
    }
    nm(inout out, in names, decls.identity);
    put(inout out, "::");
    nm(inout out, in names, name);
}

// ----------------------------------------------------------------- lookups

fn local_trait_count(in decls: Decls, in fe: Fe) -> u64 {
    if fe.local_traits == NONE64 {
        decls.traits.len()
    } else {
        fe.local_traits
    }
}

fn find_dep_pkg(in fe: Fe, pkg_sym: u32) -> u64 {
    for i in 0..fe.dep_pkg_names.len() {
        if u32_at(in fe.dep_pkg_names, i) == pkg_sym {
            return i;
        }
    }
    NONE64
}

fn find_dep_trait(in decls: Decls, in fe: Fe, dep_index: u64, name: u32) -> u32 {
    let local_n = local_trait_count(in decls, in fe);
    for trait_index in local_n..decls.traits.len() {
        let dep_offset = wrapping_sub(trait_index, local_n);
        if w(u32_at(in fe.dep_trait_pkg, dep_offset)) == dep_index
            && decls.trait_row(trait_index).name == name
        {
            return n32(trait_index);
        }
    }
    NONE32
}

// `Frontend::trait_key`: the accepted trait a reference names (its index),
// or NONE32 after a diagnostic.
fn trait_key(
    in names: Names,
    in decls: Decls,
    in fe: Fe,
    tref: TRef,
    inout out: ChunkSeq[u8]
) -> u32 {
    if tref.pkg != 0 {
        let pkg_sym = wrapping_sub(tref.pkg, 1);
        let dep_index = find_dep_pkg(in fe, pkg_sym);
        if dep_index == NONE64 {
            head(inout out, "E0601", tref.span_start, tref.span_end);
            put(inout out, "unknown dependency package '");
            nm(inout out, in names, pkg_sym);
            put(inout out, "'");
            endl(inout out);
            return NONE32;
        }
        let dep_trait = find_dep_trait(in decls, in fe, dep_index, tref.name);
        if dep_trait == NONE32 {
            head(inout out, "E0601", tref.span_start, tref.span_end);
            put(inout out, "unknown trait '");
            nm(inout out, in names, tref.name);
            put(inout out, "'");
            endl(inout out);
            return NONE32;
        }
        return dep_trait;
    }
    let trait_slot = at_symbol(in fe.trait_of, tref.name);
    if trait_slot == 0 {
        head(inout out, "E0601", tref.span_start, tref.span_end);
        put(inout out, "unknown trait '");
        nm(inout out, in names, tref.name);
        put(inout out, "'");
        endl(inout out);
        return NONE32;
    }
    wrapping_sub(trait_slot, 1)
}

// `Frontend::where_key`: like `trait_key`, without diagnostics.
fn where_key(in decls: Decls, in fe: Fe, tref: TRef) -> u32 {
    if tref.pkg != 0 {
        let dep_index = find_dep_pkg(in fe, wrapping_sub(tref.pkg, 1));
        if dep_index == NONE64 {
            return NONE32;
        }
        return find_dep_trait(in decls, in fe, dep_index, tref.name);
    }
    let trait_slot = at_symbol(in fe.trait_of, tref.name);
    if trait_slot == 0 {
        NONE32
    } else {
        wrapping_sub(trait_slot, 1)
    }
}

fn type_of_args_equal(in decls: Decls, a: Par, b: Par) -> bool {
    if a.proj_count != b.proj_count {
        return false;
    }
    for i in 0..w(a.proj_count) {
        if decls.word(add(w(a.proj_start), i)) != decls.word(add(w(b.proj_start), i)) {
            return false;
        }
    }
    true
}

// ----------------------------------------------------------------- traits

fn validate_trait(
    in ctx: Ctx,
    in decls: Decls,
    in fe: Fe,
    trait_row: TraitRow,
    inout out: ChunkSeq[u8]
) {
    let syms = fe.syms;
    let mut seen: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..w(trait_row.gen_count) {
        let generic = decls.gen(add(w(trait_row.gen_start), i));
        if generic.name == syms.self_ty || !insert32(inout seen, generic.name) {
            head(inout out, "E0600", trait_row.span_start, trait_row.span_end);
            put(inout out, "duplicate or reserved trait parameter '");
            nm(inout out, in ctx.names, generic.name);
            put(inout out, "'");
            endl(inout out);
        }
    }
    for i in 0..w(trait_row.assoc_count) {
        let assoc = decls.assoc(add(w(trait_row.assoc_start), i));
        if !insert32(inout seen, assoc.name) {
            head(inout out, "E0600", assoc.span_start, assoc.span_end);
            put(inout out, "duplicate associated type '");
            nm(inout out, in ctx.names, assoc.name);
            put(inout out, "'");
            endl(inout out);
        }
    }
    let mut methods: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..w(trait_row.method_count) {
        let method = decls.sig(add(w(trait_row.method_start), i));
        if !insert32(inout methods, method.name) {
            head(inout out, "E0600", method.span_start, method.span_end);
            put(inout out, "duplicate trait method '");
            nm(inout out, in ctx.names, method.name);
            put(inout out, "'");
            endl(inout out);
        }
        if method.gen_count != 0 {
            head(inout out, "E0607", method.span_start, method.span_end);
            put(inout out, "generic trait methods are not supported in the static fragment");
            endl(inout out);
        }
        let first = decls.par(w(method.par_start));
        if method.par_count > 0 && first.name == syms.self_param {
            let kind = ctx.types.kind(first.ty);
            if kind != TyKind::Infer && !is_self(in ctx.types, syms, first.ty) {
                head(inout out, "E0600", first.span_start, first.span_end);
                put(inout out, "a trait method's 'self' has type Self");
                endl(inout out);
            }
        } else {
            head(inout out, "E0607", method.span_start, method.span_end);
            put(inout out, "trait method '");
            nm(inout out, in ctx.names, method.name);
            put(inout out, "' needs a 'self' receiver; static trait functions are not supported");
            endl(inout out);
        }
        for j in 1..w(method.par_count) {
            let param = decls.par(add(w(method.par_start), j));
            if param.name == syms.self_param {
                head(inout out, "E0600", param.span_start, param.span_end);
                put(inout out, "'self' must be the first parameter");
                endl(inout out);
            }
            if ctx.types.kind(param.ty) == TyKind::Infer {
                head(inout out, "E0102", param.span_start, param.span_end);
                put(inout out, "trait method parameters require a type");
                endl(inout out);
            }
        }
    }
}

// ------------------------------------------------------------ conformances

// `Frontend::trait_substitution`: `Self` and the trait parameters.
fn trait_vars(
    inout types: Types,
    in decls: Decls,
    syms: Sy,
    trait_row: TraitRow,
    conf: Conf
) -> Vars {
    let mut vars = vars_new();
    vars.set(syms.self_ty, conf.self_ty);
    let tref = decls.tref(w(conf.tref));
    let mut arg_count = trait_row.gen_count;
    if tref.arg_count < arg_count {
        arg_count = tref.arg_count;
    }
    for i in 0..w(arg_count) {
        let generic = decls.gen(add(w(trait_row.gen_start), i));
        let arg = decls.word(add(w(tref.arg_start), i));
        if generic.row {
            let row_ty = row_arg(inout types, arg);
            vars.set(generic.name, row_ty);
        } else {
            vars.set(generic.name, arg);
        }
    }
    vars
}

fn cycle_refs(
    in types: Types,
    in decls: Decls,
    syms: Sy,
    trait_row: TraitRow,
    ty: u32,
    inout out: ChunkSeq[u32]
) {
    if is_projection(in types, syms, ty) {
        let trait_name = proj_trait(in types, syms, ty);
        let assoc = proj_assoc(in types, ty);
        if is_self(in types, syms, proj_self(in types, ty))
            && (trait_name == NONE32 || trait_name == trait_row.name)
            && trait_has_assoc(in decls, trait_row, assoc)
        {
            out.push(assoc);
            return;
        }
    }
    let node = types.node(ty);
    if node.kind == TyKind::Named || node.kind == TyKind::Tuple {
        for i in 0..w(node.n) {
            cycle_refs(in types, in decls, syms, trait_row, types.arg(ty, i), inout out);
        }
    } else if node.kind == TyKind::Fn {
        for i in 0..w(node.n) {
            cycle_refs(in types, in decls, syms, trait_row, types.arg(ty, i), inout out);
        }
        cycle_refs(in types, in decls, syms, trait_row, node.r, inout out);
        cycle_row_refs(in types, in decls, syms, trait_row, node.r2, inout out);
    } else if node.kind == TyKind::Row {
        cycle_row_refs(in types, in decls, syms, trait_row, node.r2, inout out);
    }
}

fn cycle_row_refs(
    in types: Types,
    in decls: Decls,
    syms: Sy,
    trait_row: TraitRow,
    row_id: u32,
    inout out: ChunkSeq[u32]
) {
    let row = types.row(row_id);
    for i in 0..w(row.n) {
        let row_effect = types.effect_at(add(w(row.a), i));
        for j in 0..w(row_effect.n) {
            cycle_refs(
                in types,
                in decls,
                syms,
                trait_row,
                u32_at(in types.items, add(w(row_effect.a), j)),
                inout out
            );
        }
    }
}

// `assoc_cycle`'s `visit`: true (with `cycle` set) when a cycle closes.
fn cycle_visit(
    in types: Types,
    in decls: Decls,
    syms: Sy,
    trait_row: TraitRow,
    conf: Conf,
    name: u32,
    inout path: ChunkSeq[u32],
    inout done: ChunkSeq[u32],
    inout cycle: ChunkSeq[u32]
) -> bool {
    for i in 0..path.len() {
        if u32_at(in path, i) == name {
            for j in i..path.len() {
                cycle.push(u32_at(in path, j));
            }
            cycle.push(name);
            return true;
        }
    }
    if !insert32(inout done, name) {
        return false;
    }
    let bound_ty = binding_of(in decls, conf, name);
    if bound_ty == NONE32 {
        return false;
    }
    let mut next: ChunkSeq[u32] = ChunkSeq::new[u32]();
    cycle_refs(in types, in decls, syms, trait_row, bound_ty, inout next);
    let depth = path.len();
    path.push(name);
    for k in 0..next.len() {
        let next_name = u32_at(in next, k);
        if cycle_visit(
            in types,
            in decls,
            syms,
            trait_row,
            conf,
            next_name,
            inout path,
            inout done,
            inout cycle
        ) {
            return true;
        }
    }
    path.truncate(depth);
    false
}

// `assoc_cycle`: the first cycle among `conf`'s associated type bindings.
fn assoc_cycle(
    in types: Types,
    in decls: Decls,
    syms: Sy,
    trait_row: TraitRow,
    conf: Conf,
    inout cycle: ChunkSeq[u32]
) -> bool {
    let mut done: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..w(conf.bind_count) {
        let bind = decls.bind(add(w(conf.bind_start), i));
        let mut path: ChunkSeq[u32] = ChunkSeq::new[u32]();
        if cycle_visit(
            in types,
            in decls,
            syms,
            trait_row,
            conf,
            bind.name,
            inout path,
            inout done,
            inout cycle
        ) {
            return true;
        }
    }
    false
}

fn validate_conformance(
    inout ctx: Ctx,
    in decls: Decls,
    in fe: Fe,
    conf: Conf,
    tr_idx: u32,
    trait_row: TraitRow,
    inout out: ChunkSeq[u8]
) {
    let syms = fe.syms;
    let tref = decls.tref(w(conf.tref));
    if tref.arg_count != trait_row.gen_count {
        head(inout out, "E0601", tref.span_start, tref.span_end);
        put(inout out, "trait '");
        nm(inout out, in ctx.names, trait_row.name);
        put(inout out, "' takes ");
        num(inout out, w(trait_row.gen_count));
        put(inout out, " arguments, found ");
        num(inout out, w(tref.arg_count));
        endl(inout out);
        return;
    }
    let mut bounds = bounds_new();
    for i in 0..w(conf.gen_count) {
        let generic = decls.gen(add(w(conf.gen_start), i));
        if !generic.row {
            bounds.set(generic.name, generic.bound);
        }
    }
    for i in 0..w(trait_row.gen_count) {
        let generic = decls.gen(add(w(trait_row.gen_start), i));
        let arg = decls.word(add(w(tref.arg_start), i));
        if !generic.row && contains_projection(in ctx.types, syms, arg) {
            continue;
        }
        if !generic.row {
            let arg_mode = mode_of(inout ctx.types, in ctx.names, in ctx.world, arg, in bounds);
            if arg_mode > generic.bound {
                head(inout out, "E0606", tref.span_start, tref.span_end);
                put(inout out, "trait argument ");
                display(in ctx.types, in ctx.names, arg, inout out);
                put(inout out, " for '");
                nm(inout out, in ctx.names, generic.name);
                put(inout out, "' exceeds its modal bound mod ");
                mode_text(inout out, generic.bound);
                endl(inout out);
            }
        }
    }
    // Associated types: exactly the trait's, each within its bound.
    let mut given: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..w(conf.bind_count) {
        let bind = decls.bind(add(w(conf.bind_start), i));
        let mut assoc_idx = NONE32;
        for j in 0..w(trait_row.assoc_count) {
            if assoc_idx == NONE32
                && decls.assoc(add(w(trait_row.assoc_start), j)).name == bind.name
            {
                assoc_idx = n32(add(w(trait_row.assoc_start), j));
            }
        }
        if assoc_idx == NONE32 {
            head(inout out, "E0601", bind.span_start, bind.span_end);
            put(inout out, "'");
            nm(inout out, in ctx.names, bind.name);
            put(inout out, "' is not an associated type of '");
            nm(inout out, in ctx.names, trait_row.name);
            put(inout out, "'");
            endl(inout out);
            continue;
        }
        if !insert32(inout given, bind.name) {
            head(inout out, "E0601", bind.span_start, bind.span_end);
            put(inout out, "associated type '");
            nm(inout out, in ctx.names, bind.name);
            put(inout out, "' is given twice");
            endl(inout out);
        }
        let assoc_decl = decls.assoc(w(assoc_idx));
        if !contains_projection(in ctx.types, syms, bind.ty)
            && !mentions(in ctx.types, bind.ty, syms.self_ty)
        {
            let bind_mode = mode_of(
                inout ctx.types,
                in ctx.names,
                in ctx.world,
                bind.ty,
                in bounds
            );
            if bind_mode > assoc_decl.bound {
                head(inout out, "E0606", bind.span_start, bind.span_end);
                put(inout out, "associated type ");
                nm(inout out, in ctx.names, bind.name);
                put(inout out, " = ");
                display(in ctx.types, in ctx.names, bind.ty, inout out);
                put(inout out, " exceeds its modal bound mod ");
                mode_text(inout out, assoc_decl.bound);
                endl(inout out);
            }
        }
    }
    for j in 0..w(trait_row.assoc_count) {
        let assoc = decls.assoc(add(w(trait_row.assoc_start), j));
        if !contains32(in given, assoc.name) {
            head(inout out, "E0601", conf.span_start, conf.span_end);
            put(inout out, "missing associated type '");
            nm(inout out, in ctx.names, assoc.name);
            put(inout out, "'");
            endl(inout out);
        }
    }
    let mut cycle: ChunkSeq[u32] = ChunkSeq::new[u32]();
    if assoc_cycle(in ctx.types, in decls, syms, trait_row, conf, inout cycle) {
        head(inout out, "E0601", conf.span_start, conf.span_end);
        put(inout out, "associated type binding cycle: ");
        for i in 0..cycle.len() {
            if i > 0 {
                put(inout out, " -> ");
            }
            nm(inout out, in ctx.names, u32_at(in cycle, i));
        }
        endl(inout out);
    }
    // Methods: exactly the trait's, with matching signatures.
    let vars = trait_vars(inout ctx.types, in decls, syms, trait_row, conf);
    let mut seen: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..w(conf.method_count) {
        let method = decls.sig(add(w(conf.method_start), i));
        if !insert32(inout seen, method.name) {
            head(inout out, "E0601", method.span_start, method.span_end);
            put(inout out, "method '");
            nm(inout out, in ctx.names, method.name);
            put(inout out, "' is defined twice");
            endl(inout out);
            continue;
        }
        let mut trait_sig_idx = NONE32;
        for j in 0..w(trait_row.method_count) {
            if trait_sig_idx == NONE32
                && decls.sig(add(w(trait_row.method_start), j)).name == method.name
            {
                trait_sig_idx = n32(add(w(trait_row.method_start), j));
            }
        }
        if trait_sig_idx == NONE32 {
            head(inout out, "E0601", method.span_start, method.span_end);
            put(inout out, "'");
            nm(inout out, in ctx.names, method.name);
            put(inout out, "' is not a method of trait '");
            nm(inout out, in ctx.names, trait_row.name);
            put(inout out, "'");
            endl(inout out);
            continue;
        }
        compare_signature(
            inout ctx,
            in decls,
            syms,
            conf,
            trait_row,
            decls.sig(w(trait_sig_idx)),
            method,
            in vars,
            inout out
        );
    }
    for j in 0..w(trait_row.method_count) {
        let trait_sig = decls.sig(add(w(trait_row.method_start), j));
        if !contains32(in seen, trait_sig.name) {
            head(inout out, "E0601", conf.span_start, conf.span_end);
            put(inout out, "missing method '");
            nm(inout out, in ctx.names, trait_sig.name);
            put(inout out, "' of trait '");
            nm(inout out, in ctx.names, trait_row.name);
            put(inout out, "'");
            endl(inout out);
        }
    }
    let local_n = local_trait_count(in decls, in fe);
    if w(tr_idx) >= local_n {
        let dep_index = w(u32_at(in fe.dep_trait_pkg, wrapping_sub(w(tr_idx), local_n)));
        let adt_start = w(u32_at(in fe.dep_adt_start, dep_index));
        let adt_count = w(u32_at(in fe.dep_adt_count, dep_index));
        for j in 0..w(trait_row.method_count) {
            let trait_sig = decls.sig(add(w(trait_row.method_start), j));
            let mut foreign = false;
            for pi in 0..w(trait_sig.par_count) {
                let param = decls.par(add(w(trait_sig.par_start), pi));
                for ai in 0..adt_count {
                    if mentions(
                        in ctx.types,
                        param.ty,
                        u32_at(in fe.dep_adt_names, add(adt_start, ai))
                    ) {
                        foreign = true;
                        break;
                    }
                }
                if foreign {
                    break;
                }
            }
            if !foreign {
                for ai in 0..adt_count {
                    if mentions(
                        in ctx.types,
                        trait_sig.result,
                        u32_at(in fe.dep_adt_names, add(adt_start, ai))
                    ) {
                        foreign = true;
                        break;
                    }
                }
            }
            if !foreign && trait_sig.row != NONE32 {
                for ai in 0..adt_count {
                    if mentions(
                        in ctx.types,
                        trait_sig.row,
                        u32_at(in fe.dep_adt_names, add(adt_start, ai))
                    ) {
                        foreign = true;
                        break;
                    }
                }
            }
            if foreign {
                head(inout out, "E0607", conf.span_start, conf.span_end);
                put(inout out, "method '");
                nm(inout out, in ctx.names, trait_sig.name);
                put(inout out, "' of dependency trait '");
                nm(inout out, in ctx.names, trait_row.name);
                put(
                    inout out,
                    "' mentions dependency types; cross-package source types are not supported"
                );
                endl(inout out);
            }
        }
    }
}

fn conform(
    inout ctx: Ctx,
    in decls: Decls,
    syms: Sy,
    trait_row: TraitRow,
    conf: Conf,
    ty: u32,
    in vars: Vars
) -> u32 {
    let mut stack: ChunkSeq[u32] = ChunkSeq::new[u32]();
    conform_type(inout ctx.types, in decls, syms, trait_row, conf, ty, in vars, inout stack)
}

fn compare_signature(
    inout ctx: Ctx,
    in decls: Decls,
    syms: Sy,
    conf: Conf,
    trait_row: TraitRow,
    trait_sig: Sig,
    method: Sig,
    in vars: Vars,
    inout out: ChunkSeq[u8]
) {
    if method.gen_count != 0 {
        head(inout out, "E0607", method.span_start, method.span_end);
        put(
            inout out,
            "generic methods in impls and models are not supported in the static fragment"
        );
        endl(inout out);
        return;
    }
    if trait_sig.par_count != method.par_count {
        head(inout out, "E0602", method.span_start, method.span_end);
        put(inout out, "method '");
        nm(inout out, in ctx.names, method.name);
        put(inout out, "' takes ");
        num(inout out, w(trait_sig.par_count));
        put(inout out, " parameters in the trait, found ");
        num(inout out, w(method.par_count));
        endl(inout out);
        return;
    }
    let self_ty = conf.self_ty;
    let mut own_vars = vars_new();
    own_vars.set(syms.self_ty, self_ty);
    for i in 0..w(method.par_count) {
        let expected = decls.par(add(w(trait_sig.par_start), i));
        let actual = decls.par(add(w(method.par_start), i));
        if i == 0 && actual.name != syms.self_param {
            head(inout out, "E0602", actual.span_start, actual.span_end);
            put(inout out, "method '");
            nm(inout out, in ctx.names, method.name);
            put(inout out, "' must take 'self' first");
            endl(inout out);
            continue;
        }
        if expected.pass != actual.pass {
            head(inout out, "E0603", actual.span_start, actual.span_end);
            put(inout out, "parameter '");
            nm(inout out, in ctx.names, actual.name);
            put(inout out, "' of '");
            nm(inout out, in ctx.names, method.name);
            put(inout out, "' is passed ");
            pass_text(inout out, actual.pass);
            put(inout out, " but the trait declares ");
            pass_text(inout out, expected.pass);
            endl(inout out);
        }
        if !type_of_args_equal(in decls, expected, actual) {
            head(inout out, "E0603", actual.span_start, actual.span_end);
            put(inout out, "parameter '");
            nm(inout out, in ctx.names, actual.name);
            put(inout out, "' of '");
            nm(inout out, in ctx.names, method.name);
            put(inout out, "' changes the trait's place projections");
            endl(inout out);
        }
        let want = if i == 0 {
            self_ty
        } else {
            conform(inout ctx, in decls, syms, trait_row, conf, expected.ty, in vars)
        };
        let have = if i == 0 && ctx.types.kind(actual.ty) == TyKind::Infer {
            self_ty
        } else {
            conform(inout ctx, in decls, syms, trait_row, conf, actual.ty, in own_vars)
        };
        if !same_type(in ctx.types, syms, want, have) {
            head(inout out, "E0602", actual.span_start, actual.span_end);
            put(inout out, "parameter '");
            nm(inout out, in ctx.names, actual.name);
            put(inout out, "' of '");
            nm(inout out, in ctx.names, method.name);
            put(inout out, "' has type ");
            display(in ctx.types, in ctx.names, have, inout out);
            put(inout out, ", but the trait requires ");
            display(in ctx.types, in ctx.names, want, inout out);
            endl(inout out);
        }
    }
    let want = conform(inout ctx, in decls, syms, trait_row, conf, trait_sig.result, in vars);
    let have = conform(inout ctx, in decls, syms, trait_row, conf, method.result, in own_vars);
    if !same_type(in ctx.types, syms, want, have) {
        head(inout out, "E0602", method.span_start, method.span_end);
        put(inout out, "'");
        nm(inout out, in ctx.names, method.name);
        put(inout out, "' returns ");
        display(in ctx.types, in ctx.names, have, inout out);
        put(inout out, ", but the trait requires ");
        display(in ctx.types, in ctx.names, want, inout out);
        endl(inout out);
    }
    let want_ty = conform(inout ctx, in decls, syms, trait_row, conf, trait_sig.row, in vars);
    let have_ty = conform(inout ctx, in decls, syms, trait_row, conf, method.row, in own_vars);
    let want = ctx.types.node(want_ty).r2;
    let have = ctx.types.node(have_ty).r2;
    let have_row = ctx.types.row(have);
    let want_row = ctx.types.row(want);
    for i in 0..w(have_row.n) {
        let have_effect = ctx.types.effect_at(add(w(have_row.a), i));
        let mut permitted = false;
        for j in 0..w(want_row.n) {
            let want_effect = ctx.types.effect_at(add(w(want_row.a), j));
            if !permitted
                && want_effect.name == have_effect.name
                && want_effect.n == have_effect.n
            {
                let mut all = true;
                for k in 0..w(want_effect.n) {
                    let want_arg = u32_at(in ctx.types.items, add(w(want_effect.a), k));
                    let have_arg = u32_at(in ctx.types.items, add(w(have_effect.a), k));
                    if !same_type(in ctx.types, syms, want_arg, have_arg) {
                        all = false;
                    }
                }
                permitted = all;
            }
        }
        if !permitted {
            head(inout out, "E0604", method.span_start, method.span_end);
            put(inout out, "'");
            nm(inout out, in ctx.names, method.name);
            put(inout out, "' performs ");
            nm(inout out, in ctx.names, have_effect.name);
            if have_effect.n > 0 {
                put(inout out, "[");
                for k in 0..w(have_effect.n) {
                    if k > 0 {
                        put(inout out, ", ");
                    }
                    display(
                        in ctx.types,
                        in ctx.names,
                        u32_at(in ctx.types.items, add(w(have_effect.a), k)),
                        inout out
                    );
                }
                put(inout out, "]");
            }
            put(inout out, " but the trait signature does not permit it");
            endl(inout out);
        }
        if have_effect.label != 0 {
            head(inout out, "E0607", method.span_start, method.span_end);
            put(inout out, "labelled capabilities in trait method signatures are not supported");
            endl(inout out);
        }
    }
    if have_row.tail != 0 && have_row.tail != want_row.tail {
        head(inout out, "E0604", method.span_start, method.span_end);
        put(inout out, "'");
        nm(inout out, in ctx.names, method.name);
        put(inout out, "' has an open effect row the trait does not declare");
        endl(inout out);
    }
}

// ------------------------------------------------------------------ bounds

fn bound_head(inout out: ChunkSeq[u8], in names: Names, param: u32, tref: TRef) {
    nm(inout out, in names, param);
    put(inout out, ": ");
    nm(inout out, in names, tref.name);
}

// `Frontend::collect_bound` (the diagnostics; the bound tables are the
// monomorphizer's, a later part of this port).
fn collect_bound(in ctx: Ctx, in decls: Decls, in fe: Fe, i: u64, inout out: ChunkSeq[u8]) {
    let syms = fe.syms;
    let bound = decls.bound_syn(i);
    let tref = decls.tref(w(bound.tref));
    if bound.owner == syms.empty
        || ctx.names.has_prefix(bound.owner, in "$unsupported::".as_bytes())
    {
        head(inout out, "E0607", bound.span_start, bound.span_end);
        put(inout out, "trait bound '");
        bound_head(inout out, in ctx.names, bound.param, tref);
        put(
            inout out,
            "' is not supported here; bounds go on functions, inherent impl blocks and type declarations"
        );
        endl(inout out);
        return;
    }
    let fn_slot = at_symbol(in fe.fn_of, bound.owner);
    let mut found = false;
    if fn_slot != 0 {
        let fn_row = decls.fn_row(w(wrapping_sub(fn_slot, 1)));
        for j in 0..w(fn_row.gen_count) {
            let generic = decls.gen(add(w(fn_row.gen_start), j));
            if !found && generic.name == bound.param && !generic.row {
                found = true;
            }
        }
    } else {
        let adt_idx = ctx.world.lookup(bound.owner);
        if adt_idx == NONE32 {
            head(inout out, "E0607", bound.span_start, bound.span_end);
            put(inout out, "trait bound '");
            bound_head(inout out, in ctx.names, bound.param, tref);
            put(inout out, "' constrains an unknown item '");
            nm(inout out, in ctx.names, bound.owner);
            put(inout out, "'");
            endl(inout out);
            return;
        }
        let adt = ctx.world.adt(adt_idx);
        for j in 0..w(adt.gn) {
            let generic = ctx.world.generic(add(w(adt.ga), j));
            if !found && generic.name == bound.param && !generic.row {
                found = true;
            }
        }
    }
    if !found {
        head(inout out, "E0607", bound.span_start, bound.span_end);
        put(inout out, "'");
        nm(inout out, in ctx.names, bound.param);
        put(inout out, "' in the bound '");
        bound_head(inout out, in ctx.names, bound.param, tref);
        put(inout out, "' is not a type parameter of '");
        nm(inout out, in ctx.names, bound.owner);
        put(inout out, "'; where-clauses on functions constrain their own type parameters");
        endl(inout out);
        return;
    }
    let key = trait_key(in ctx.names, in decls, in fe, tref, inout out);
    if key == NONE32 {
        return;
    }
    let trait_row = decls.trait_row(w(key));
    if trait_row.gen_count != tref.arg_count {
        head(inout out, "E0601", tref.span_start, tref.span_end);
        put(inout out, "trait '");
        nm(inout out, in ctx.names, trait_row.name);
        put(inout out, "' takes ");
        num(inout out, w(trait_row.gen_count));
        put(inout out, " arguments, found ");
        num(inout out, w(tref.arg_count));
        endl(inout out);
    }
}

// --------------------------------------------------------------- lowering

// The error message of `TypeDto::from_source`, into `err` (true on error).
fn type_err(in ctx: Ctx, ty: u32, inout err: ChunkSeq[u8]) -> bool {
    let node = ctx.types.node(ty);
    if node.kind == TyKind::Named {
        for i in 0..w(node.n) {
            if arg_err(in ctx, ctx.types.arg(ty, i), inout err) {
                return true;
            }
        }
        return false;
    }
    if node.kind == TyKind::Tuple {
        for i in 0..w(node.n) {
            if type_err(in ctx, ctx.types.arg(ty, i), inout err) {
                return true;
            }
        }
        return false;
    }
    if node.kind == TyKind::Fn {
        put(inout err, "function type `");
        display(in ctx.types, in ctx.names, ty, inout err);
        put(inout err, "` has no Pact type constructor in this fragment");
        return true;
    }
    if node.kind == TyKind::Row {
        put(inout err, "an effect row is not a type");
        return true;
    }
    put(inout err, "unresolved source type `");
    display(in ctx.types, in ctx.names, ty, inout err);
    put(inout err, "`");
    true
}

// The error message of `ArgDto::from_source`.
fn arg_err(in ctx: Ctx, ty: u32, inout err: ChunkSeq[u8]) -> bool {
    let node = ctx.types.node(ty);
    if node.kind != TyKind::Row {
        return type_err(in ctx, ty, inout err);
    }
    let row = ctx.types.row(node.r2);
    for i in 0..w(row.n) {
        let row_effect = ctx.types.effect_at(add(w(row.a), i));
        if row_effect.label != 0
            && ctx.names.has_prefix(wrapping_sub(row_effect.label, 1), in "$".as_bytes())
        {
            put(inout err, "checker-internal capability label \"");
            nm(inout err, in ctx.names, wrapping_sub(row_effect.label, 1));
            put(inout err, "\" is not a stable source name");
            return true;
        }
        for j in 0..w(row_effect.n) {
            if arg_err(in ctx, u32_at(in ctx.types.items, add(w(row_effect.a), j)), inout err) {
                return true;
            }
        }
    }
    false
}

fn is_generic(in decls: Decls, gen_start: u32, gen_count: u32, name: u32) -> bool {
    for i in 0..w(gen_count) {
        if decls.gen(add(w(gen_start), i)).name == name {
            return true;
        }
    }
    false
}

// The error message of `Frontend::dto` under generics `gens[gen_start..gen_start+gen_count]`.
fn dto_err(
    in ctx: Ctx,
    in decls: Decls,
    in fe: Fe,
    gen_start: u32,
    gen_count: u32,
    ty: u32,
    inout err: ChunkSeq[u8]
) -> bool {
    let syms = fe.syms;
    if is_projection(in ctx.types, syms, ty) {
        let mut trait_name = proj_trait(in ctx.types, syms, ty);
        let assoc = proj_assoc(in ctx.types, ty);
        if trait_name == NONE32 {
            // `unique_assoc_trait`.
            let mut count: u64 = 0;
            let local_n = local_trait_count(in decls, in fe);
            for i in 0..local_n {
                let trait_row = decls.trait_row(i);
                if at_symbol(in fe.trait_of, trait_row.name) == n32(inc(i))
                    && trait_has_assoc(in decls, trait_row, assoc)
                {
                    count = inc(count);
                    trait_name = trait_row.name;
                }
            }
            if count == 0 {
                put(inout err, "no trait declares an associated type '");
                nm(inout err, in ctx.names, assoc);
                put(inout err, "'");
                return true;
            }
            if count > 1 {
                put(inout err, "associated type '");
                nm(inout err, in ctx.names, assoc);
                put(inout err, "' is declared by several traits; write <T as Trait>::");
                nm(inout err, in ctx.names, assoc);
                return true;
            }
        }
        if at_symbol(in fe.trait_of, trait_name) == 0 {
            put(inout err, "unknown trait '");
            nm(inout err, in ctx.names, trait_name);
            put(inout err, "' in a projection");
            return true;
        }
        if dto_err(
            in ctx,
            in decls,
            in fe,
            gen_start,
            gen_count,
            proj_self(in ctx.types, ty),
            inout err
        ) {
            return true;
        }
        let trait_ty = proj_trait_ty(in ctx.types, ty);
        for i in 0..ctx.types.arity(trait_ty) {
            if dto_err(
                in ctx,
                in decls,
                in fe,
                gen_start,
                gen_count,
                ctx.types.arg(trait_ty, i),
                inout err
            ) {
                return true;
            }
        }
        return false;
    }
    let node = ctx.types.node(ty);
    if node.kind == TyKind::Named {
        if node.n == 0 && is_generic(in decls, gen_start, gen_count, node.name) {
            return false;
        }
        for i in 0..w(node.n) {
            let arg = ctx.types.arg(ty, i);
            let bad = if ctx.types.kind(arg) == TyKind::Row {
                arg_err(in ctx, arg, inout err)
            } else {
                dto_err(in ctx, in decls, in fe, gen_start, gen_count, arg, inout err)
            };
            if bad {
                return true;
            }
        }
        return false;
    }
    if node.kind == TyKind::Tuple {
        for i in 0..w(node.n) {
            if dto_err(
                in ctx,
                in decls,
                in fe,
                gen_start,
                gen_count,
                ctx.types.arg(ty, i),
                inout err
            ) {
                return true;
            }
        }
        return false;
    }
    type_err(in ctx, ty, inout err)
}

// A trait argument by its parameter's kind (`ArgDto::from_source` of the
// row for an effect-row parameter, else `dto`).
fn trait_arg_err(
    inout ctx: Ctx,
    in decls: Decls,
    in fe: Fe,
    gen_start: u32,
    gen_count: u32,
    generic: Gen,
    arg: u32,
    inout err: ChunkSeq[u8]
) -> bool {
    if generic.row {
        let row_ty = row_arg(inout ctx.types, arg);
        arg_err(in ctx, row_ty, inout err)
    } else {
        dto_err(in ctx, in decls, in fe, gen_start, gen_count, arg, inout err)
    }
}

// `lower_bindings`' `lower` for one accepted conformance: true with the
// message in `err` when it fails.
fn lower_err(
    inout ctx: Ctx,
    in decls: Decls,
    in fe: Fe,
    conf: Conf,
    trait_row: TraitRow,
    inout err: ChunkSeq[u8]
) -> bool {
    let syms = fe.syms;
    if dto_err(in ctx, in decls, in fe, conf.gen_start, conf.gen_count, conf.self_ty, inout err) {
        return true;
    }
    let tref = decls.tref(w(conf.tref));
    let mut arg_count = trait_row.gen_count;
    if tref.arg_count < arg_count {
        arg_count = tref.arg_count;
    }
    for i in 0..w(arg_count) {
        let generic = decls.gen(add(w(trait_row.gen_start), i));
        let arg = decls.word(add(w(tref.arg_start), i));
        if trait_arg_err(
            inout ctx,
            in decls,
            in fe,
            conf.gen_start,
            conf.gen_count,
            generic,
            arg,
            inout err
        ) {
            return true;
        }
    }
    for i in 0..w(conf.where_count) {
        let where_decl = decls.where_row(add(w(conf.where_start), i));
        let where_tref = decls.tref(w(where_decl.tref));
        let key = where_key(in decls, in fe, where_tref);
        if key == NONE32 {
            put(inout err, "unknown trait '");
            nm(inout err, in ctx.names, where_tref.name);
            put(inout err, "'");
            return true;
        }
        if dto_err(
            in ctx,
            in decls,
            in fe,
            conf.gen_start,
            conf.gen_count,
            where_decl.ty,
            inout err
        ) {
            return true;
        }
        let where_trait = decls.trait_row(w(key));
        if where_trait.gen_count != where_tref.arg_count {
            put(inout err, "trait '");
            nm(inout err, in ctx.names, where_trait.name);
            put(inout err, "' takes ");
            num(inout err, w(where_trait.gen_count));
            put(inout err, " arguments, found ");
            num(inout err, w(where_tref.arg_count));
            return true;
        }
        for j in 0..w(where_tref.arg_count) {
            let generic = decls.gen(add(w(where_trait.gen_start), j));
            let arg = decls.word(add(w(where_tref.arg_start), j));
            if trait_arg_err(
                inout ctx,
                in decls,
                in fe,
                conf.gen_start,
                conf.gen_count,
                generic,
                arg,
                inout err
            ) {
                return true;
            }
        }
    }
    let mut own = vars_new();
    own.set(syms.self_ty, conf.self_ty);
    for i in 0..w(conf.bind_count) {
        let bind = decls.bind(add(w(conf.bind_start), i));
        let ty = conform(inout ctx, in decls, syms, trait_row, conf, bind.ty, in own);
        if dto_err(in ctx, in decls, in fe, conf.gen_start, conf.gen_count, ty, inout err) {
            return true;
        }
    }
    false
}

// --------------------------------------------------------------- the pass

// `impl_key`: `Trait.Self` (trait arguments and types by `key_segment`).
fn impl_key(in ctx: Ctx, in decls: Decls, conf: Conf, inout out: ChunkSeq[u8]) {
    let tref = decls.tref(w(conf.tref));
    nm(inout out, in ctx.names, tref.name);
    if tref.arg_count > 0 {
        put(inout out, "-0-");
        for i in 0..w(tref.arg_count) {
            if i > 0 {
                put(inout out, "-1-");
            }
            key_segment(
                in ctx.types,
                in ctx.names,
                decls.word(add(w(tref.arg_start), i)),
                inout out
            );
        }
        put(inout out, "-2");
    }
    put(inout out, ".");
    key_segment(in ctx.types, in ctx.names, conf.self_ty, inout out);
}

fn sig_contains_projection(in types: Types, syms: Sy, in decls: Decls, sig: Sig) -> bool {
    for i in 0..w(sig.par_count) {
        if contains_projection(in types, syms, decls.par(add(w(sig.par_start), i)).ty) {
            return true;
        }
    }
    contains_projection(in types, syms, sig.result) || contains_projection(in types, syms, sig.row)
}

// `Frontend::new` for a package without dependencies: `collect_local`,
// then the lowering failures of `lower_bindings`.
pub fn declaration_pass(inout ctx: Ctx, in decls: Decls, inout fe: Fe, inout out: ChunkSeq[u8]) {
    let syms = fe.syms;
    for i in 0..decls.fns.len() {
        let fn_row = decls.fn_row(i);
        set_by_symbol(inout fe.fn_of, fn_row.name, n32(inc(i)));
    }
    for i in 0..ctx.world.adts.len() {
        let adt = ctx.world.adt(n32(i));
        set_by_symbol(inout fe.kinds, adt.name, N_TYPE);
    }
    for i in 0..ctx.world.effects.len() {
        let eff_row = ctx.world.effect_row(n32(i));
        set_by_symbol(inout fe.kinds, eff_row.name, N_EFFECT);
    }
    let local_n = local_trait_count(in decls, in fe);
    for i in 0..local_n {
        let trait_row = decls.trait_row(i);
        let prev = at_symbol(in fe.kinds, trait_row.name);
        set_by_symbol(inout fe.kinds, trait_row.name, N_TRAIT);
        if prev != 0 {
            head(inout out, "E0600", trait_row.span_start, trait_row.span_end);
            put(inout out, "trait '");
            nm(inout out, in ctx.names, trait_row.name);
            put(inout out, "' conflicts with a ");
            kind_text(inout out, prev);
            put(inout out, " of the same name");
            endl(inout out);
            continue;
        }
        validate_trait(in ctx, in decls, in fe, trait_row, inout out);
        set_by_symbol(inout fe.trait_of, trait_row.name, n32(inc(i)));
    }
    for i in 0..decls.confs.len() {
        let conf = decls.conf(i);
        if conf.model {
            let prev = at_symbol(in fe.kinds, conf.model_name);
            set_by_symbol(inout fe.kinds, conf.model_name, N_MODEL);
            if prev != 0 {
                head(inout out, "E0600", conf.span_start, conf.span_end);
                put(inout out, "model '");
                nm(inout out, in ctx.names, conf.model_name);
                put(inout out, "' conflicts with a ");
                kind_text(inout out, prev);
                put(inout out, " of the same name");
                endl(inout out);
                continue;
            }
        }
        let key = trait_key(in ctx.names, in decls, in fe, decls.tref(w(conf.tref)), inout out);
        if key == NONE32 {
            continue;
        }
        let path = if conf.model {
            conf.model_name
        } else {
            let mut key_bytes: ChunkSeq[u8] = ChunkSeq::new[u8]();
            impl_key(in ctx, in decls, conf, inout key_bytes);
            ctx.names.intern(in key_bytes[0..key_bytes.len()])
        };
        let mut overlap = false;
        for j in 0..fe.acc_conf.len() {
            let same_kind = match fe.acc_model.try_get(j) {
                Option::Some(is_model) => is_model == conf.model,
                Option::None => false,
            };
            if same_kind && u32_at(in fe.acc_path, j) == path {
                overlap = true;
            }
        }
        if overlap {
            head(inout out, "E0605", conf.span_start, conf.span_end);
            path_text(inout out, in ctx.names, in decls, conf.model, path);
            put(
                inout out,
                " overlaps an earlier canonical impl with the same head; declare one as a named `model`"
            );
            endl(inout out);
            continue;
        }
        validate_conformance(
            inout ctx,
            in decls,
            in fe,
            conf,
            key,
            decls.trait_row(w(key)),
            inout out
        );
        fe.acc_conf.push(n32(i));
        fe.acc_trait.push(key);
        fe.acc_model.push(conf.model);
        fe.acc_path.push(path);
    }
    for i in 0..decls.uses.len() {
        let use_row = decls.use_row(i);
        let mut declared = false;
        for j in 0..fe.acc_conf.len() {
            let conf = decls.conf(w(u32_at(in fe.acc_conf, j)));
            if conf.model && conf.model_name == use_row.model {
                declared = true;
            }
        }
        if !declared {
            head(inout out, "E0613", use_row.span_start, use_row.span_end);
            put(inout out, "'");
            nm(inout out, in ctx.names, use_row.model);
            put(inout out, "' is not a model declared in this package");
            endl(inout out);
        }
    }
    for i in 0..decls.bounds.len() {
        collect_bound(in ctx, in decls, in fe, i, inout out);
    }
    for i in 0..decls.items.len() {
        let item = decls.item(i);
        if item.adt {
            let mut found = false;
            for j in 0..w(item.member_count) {
                if contains_projection(
                    in ctx.types,
                    syms,
                    decls.word(add(w(item.member_start), j))
                ) {
                    found = true;
                }
            }
            if found {
                head(inout out, "E0607", item.span_start, item.span_end);
                put(inout out, "projections in the fields of '");
                nm(inout out, in ctx.names, item.name);
                put(inout out, "' are not supported");
                endl(inout out);
            }
        } else {
            for j in 0..w(item.member_count) {
                let op = decls.sig(add(w(item.member_start), j));
                if sig_contains_projection(in ctx.types, syms, in decls, op) {
                    head(inout out, "E0607", op.span_start, op.span_end);
                    put(inout out, "projections in effect operation signatures are not supported");
                    endl(inout out);
                }
            }
        }
    }
    // `lower_bindings`: a conformance that cannot be lowered.
    for j in 0..fe.acc_conf.len() {
        let conf = decls.conf(w(u32_at(in fe.acc_conf, j)));
        let trait_row = decls.trait_row(w(u32_at(in fe.acc_trait, j)));
        let mut err: ChunkSeq[u8] = ChunkSeq::new[u8]();
        if lower_err(inout ctx, in decls, in fe, conf, trait_row, inout err) {
            head(inout out, "E0607", conf.span_start, conf.span_end);
            put(inout out, "cannot lower ");
            path_text(inout out, in ctx.names, in decls, conf.model, u32_at(in fe.acc_path, j));
            put(inout out, ": ");
            out.extend(in err[0..err.len()]);
            endl(inout out);
        }
    }
}
