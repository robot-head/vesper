// Dependency loading (`Frontend::add_dependency`) and cross-package trait
// reference checking for `@vesper/check-pact` (SH2 lane 13 part 8, #1725).

use @vesper/check-data::input::{Ctx, Reader, read_ctx};
use @vesper/check-data::{pack_text};
use @vesper/check-data::util::{add, n32, u32_at, u8_at, w};
use self::decl::{Decls, read_decls, read_traits};
use self::frontend::{Fe, declaration_pass, fe_new};
use self::resolve::{put_bytes};
use self::session_input::{put_str, read_q_names, read_q_types};
use self::tyops::{sy_new};

fn padded_len(n: u64) -> u64 {
    wrapping_mul(add(n, 7) / 8, 8)
}

fn read_bytes_chunk(inout reader: Reader, in bytes: Slice[u8]) -> (u64, u64) {
    let n = reader.word(in bytes);
    let start = reader.pos;
    reader.pos = add(start, padded_len(n));
    (start, add(start, n))
}

fn contains_u32(in seq: ChunkSeq[u32], value: u32) -> bool {
    for i in 0..seq.len() {
        if u32_at(in seq, i) == value {
            return true;
        }
    }
    false
}

fn prefix_dep_diags(in dep_out: ChunkSeq[u8], in id_bytes: Slice[u8], inout out: ChunkSeq[u8]) {
    let n = dep_out.len();
    let mut i: u64 = 0;
    loop {
        if i >= n {
            break;
        }
        // Each line is `CODE START END MESSAGE\n`.
        let mut first_space = i;
        loop {
            if first_space >= n || u8_at(in dep_out, first_space) == 32 {
                break;
            }
            first_space = add(first_space, 1);
        }
        let mut second_space = add(first_space, 1);
        loop {
            if second_space >= n || u8_at(in dep_out, second_space) == 32 {
                break;
            }
            second_space = add(second_space, 1);
        }
        let mut third_space = add(second_space, 1);
        loop {
            if third_space >= n || u8_at(in dep_out, third_space) == 32 {
                break;
            }
            third_space = add(third_space, 1);
        }
        let mut line_end = add(third_space, 1);
        loop {
            if line_end >= n || u8_at(in dep_out, line_end) == 10 {
                break;
            }
            line_end = add(line_end, 1);
        }
        for k in i..first_space {
            out.push(u8_at(in dep_out, k));
        }
        put_str(inout out, " 0 0 in dependency ");
        put_bytes(inout out, in id_bytes);
        put_str(inout out, ": ");
        let msg_start = add(third_space, 1);
        if msg_start < line_end {
            for k in msg_start..line_end {
                out.push(u8_at(in dep_out, k));
            }
        }
        out.push(10);
        i = add(line_end, 1);
    }
}

// Entrypoint for `check_pact_deps`:
// `[local_decl_input][n_deps, (pkg_name_bytes, id_bytes, dep_decl_input, dep_traits_input)...]`
pub fn deps_words(in bytes: Slice[u8]) -> ChunkSeq[u64] {
    let mut reader = Reader { pos: 0 };
    let (local_start, local_end) = read_bytes_chunk(inout reader, in bytes);
    let local_bytes = bytes[local_start..local_end];
    let mut local_reader = Reader { pos: 0 };
    let mut ctx = read_ctx(inout local_reader, in local_bytes);
    let mut decls = read_decls(inout local_reader, in local_bytes, in ctx.nmap, in ctx.tmap);
    let syms = sy_new(inout ctx.names);
    let mut fe = fe_new(syms);
    fe.local_traits = decls.traits.len();
    let mut out = ChunkSeq::new[u8]();

    let n_deps = reader.word(in bytes);
    for dep_index in 0..n_deps {
        let (pkg_start, pkg_end) = read_bytes_chunk(inout reader, in bytes);
        let (id_start, id_end) = read_bytes_chunk(inout reader, in bytes);
        let (decl_start, decl_end) = read_bytes_chunk(inout reader, in bytes);
        let (traits_start, traits_end) = read_bytes_chunk(inout reader, in bytes);
        let pkg_bytes = bytes[pkg_start..pkg_end];
        let id_bytes = bytes[id_start..id_end];
        let pkg_sym = ctx.names.intern(in pkg_bytes);
        let id_sym = ctx.names.intern(in id_bytes);
        if id_sym == decls.identity || contains_u32(in fe.dep_pkg_names, pkg_sym) {
            put_str(inout out, "E0600 0 0 dependency ");
            put_bytes(inout out, in id_bytes);
            put_str(inout out, " is declared twice");
            out.push(10);
            return pack_text(in out);
        }

        let dep_bytes = bytes[decl_start..decl_end];
        let mut dep_reader = Reader { pos: 0 };
        let mut dep_ctx = read_ctx(inout dep_reader, in dep_bytes);
        let dep_decls = read_decls(
            inout dep_reader,
            in dep_bytes,
            in dep_ctx.nmap,
            in dep_ctx.tmap
        );
        let dep_syms = sy_new(inout dep_ctx.names);
        let mut dep_fe = fe_new(dep_syms);
        let mut dep_out = ChunkSeq::new[u8]();
        declaration_pass(inout dep_ctx, in dep_decls, inout dep_fe, inout dep_out);
        if dep_out.len() > 0 {
            prefix_dep_diags(in dep_out, in id_bytes, inout out);
            return pack_text(in out);
        }

        fe.dep_pkg_names.push(pkg_sym);
        fe.dep_adt_start.push(n32(fe.dep_adt_names.len()));
        let mut adt_count: u64 = 0;
        for ai in 0..dep_ctx.world.adts.len() {
            let adt = dep_ctx.world.adt(n32(ai));
            let mut name_bytes = ChunkSeq::new[u8]();
            dep_ctx.names.write(adt.name, inout name_bytes);
            let local_adt_sym = ctx.names.intern(in name_bytes.as_slice());
            fe.dep_adt_names.push(local_adt_sym);
            adt_count = add(adt_count, 1);
        }
        fe.dep_adt_count.push(n32(adt_count));

        let traits_bytes = bytes[traits_start..traits_end];
        let mut traits_reader = Reader { pos: 0 };
        let mut dep_nmap = ChunkSeq::new[u32]();
        read_q_names(inout traits_reader, in traits_bytes, inout ctx.names, inout dep_nmap);
        let mut dep_tmap = ChunkSeq::new[u32]();
        read_q_types(inout traits_reader, in traits_bytes, inout ctx, in dep_nmap, inout dep_tmap);
        let before_traits = decls.traits.len();
        read_traits(inout traits_reader, in traits_bytes, inout decls, in dep_nmap, in dep_tmap);
        let after_traits = decls.traits.len();
        for _ in before_traits..after_traits {
            fe.dep_trait_pkg.push(n32(dep_index));
        }
    }

    declaration_pass(inout ctx, in decls, inout fe, inout out);
    pack_text(in out)
}
