// Dependency loading (`Frontend::add_dependency`) and cross-package trait
// reference checking for `@vesper/check-pact` (SH2 lane 13 part 8, #1725).

use @vesper/check-data::input::{
    Ctx,
    Reader,
    read_ctx
};
use @vesper/check-data::{
    pack_text
};
use @vesper/check-data::util::{
    add,
    n32,
    u32_at,
    u8_at,
    w
};
use self::decl::{
    Decls,
    read_decls,
    read_traits
};
use self::frontend::{
    Fe,
    declaration_pass,
    fe_new
};
use self::resolve::{
    put_bytes
};
use self::session_input::{
    put_str,
    read_q_names,
    read_q_types
};
use self::tyops::{
    sy_new
};

fn padded_len(n: u64) -> u64 {
    wrapping_mul(add(n, 7) / 8, 8)
}

fn read_bytes_chunk(inout r: Reader, in b: Slice[u8]) -> (u64, u64) {
    let n = r.word(in b);
    let start = r.pos;
    r.pos = add(start, padded_len(n));
    (start, add(start, n))
}

fn contains_u32(in seq: ChunkSeq[u32], val: u32) -> bool {
    for i in 0..seq.len() {
        if u32_at(in seq, i) == val {
            return true;
        }
    }
    false
}

fn prefix_dep_diags(in dep_out: ChunkSeq[u8], in id_bytes: Slice[u8], inout out: ChunkSeq[u8]) {
    let n = dep_out.len();
    let mut i: u64 = 0;
    loop {
        if i >= n {
            break;
        }
        // Each line is `CODE START END MESSAGE\n`.
        let mut sp1 = i;
        loop {
            if sp1 >= n || u8_at(in dep_out, sp1) == 32 {
                break;
            }
            sp1 = add(sp1, 1);
        }
        let mut sp2 = add(sp1, 1);
        loop {
            if sp2 >= n || u8_at(in dep_out, sp2) == 32 {
                break;
            }
            sp2 = add(sp2, 1);
        }
        let mut sp3 = add(sp2, 1);
        loop {
            if sp3 >= n || u8_at(in dep_out, sp3) == 32 {
                break;
            }
            sp3 = add(sp3, 1);
        }
        let mut nl = add(sp3, 1);
        loop {
            if nl >= n || u8_at(in dep_out, nl) == 10 {
                break;
            }
            nl = add(nl, 1);
        }
        for k in i..sp1 {
            out.push(u8_at(in dep_out, k));
        }
        put_str(inout out, " 0 0 in dependency ");
        put_bytes(inout out, in id_bytes);
        put_str(inout out, ": ");
        let msg_start = add(sp3, 1);
        if msg_start < nl {
            for k in msg_start..nl {
                out.push(u8_at(in dep_out, k));
            }
        }
        out.push(10);
        i = add(nl, 1);
    }
}

// Entrypoint for `check_pact_deps`:
// `[local_decl_input][n_deps, (pkg_name_bytes, id_bytes, dep_decl_input, dep_traits_input)...]`
pub fn deps_words(in b: Slice[u8]) -> ChunkSeq[u64] {
    let mut r = Reader {
        pos: 0
    };
    let (ls, le) = read_bytes_chunk(inout r, in b);
    let local_b = b[ls..le];
    let mut lr = Reader {
        pos: 0
    };
    let mut c = read_ctx(inout lr, in local_b);
    let mut d = read_decls(inout lr, in local_b, in c.nmap, in c.tmap);
    let sy = sy_new(inout c.names);
    let mut fe = fe_new(sy);
    fe.local_traits = d.traits.len();
    let mut o = ChunkSeq::new[u8]();

    let n_deps = r.word(in b);
    for di in 0..n_deps {
        let (ps, pe) = read_bytes_chunk(inout r, in b);
        let (is, ie) = read_bytes_chunk(inout r, in b);
        let (ds, de) = read_bytes_chunk(inout r, in b);
        let (ts, te) = read_bytes_chunk(inout r, in b);
        let pkg_bytes = b[ps..pe];
        let id_bytes = b[is..ie];
        let pkg_sym = c.names.intern(in pkg_bytes);
        let id_sym = c.names.intern(in id_bytes);
        if id_sym == d.identity || contains_u32(in fe.dep_pkg_names, pkg_sym) {
            put_str(inout o, "E0600 0 0 dependency ");
            put_bytes(inout o, in id_bytes);
            put_str(inout o, " is declared twice");
            o.push(10);
            return pack_text(in o);
        }

        let dep_b = b[ds..de];
        let mut dr = Reader {
            pos: 0
        };
        let mut dc = read_ctx(inout dr, in dep_b);
        let dd = read_decls(inout dr, in dep_b, in dc.nmap, in dc.tmap);
        let dsy = sy_new(inout dc.names);
        let mut dfe = fe_new(dsy);
        let mut dep_o = ChunkSeq::new[u8]();
        declaration_pass(inout dc, in dd, inout dfe, inout dep_o);
        if dep_o.len() > 0 {
            prefix_dep_diags(in dep_o, in id_bytes, inout o);
            return pack_text(in o);
        }

        fe.dep_pkg_names.push(pkg_sym);
        fe.dep_adt_a.push(n32(fe.dep_adt_names.len()));
        let mut adt_cnt: u64 = 0;
        for ai in 0..dc.world.adts.len() {
            let a = dc.world.adt(n32(ai));
            let mut ab = ChunkSeq::new[u8]();
            dc.names.write(a.name, inout ab);
            let local_asym = c.names.intern(in ab.as_slice());
            fe.dep_adt_names.push(local_asym);
            adt_cnt = add(adt_cnt, 1);
        }
        fe.dep_adt_n.push(n32(adt_cnt));

        let tr_b = b[ts..te];
        let mut tr_r = Reader {
            pos: 0
        };
        let mut dep_nmap = ChunkSeq::new[u32]();
        read_q_names(inout tr_r, in tr_b, inout c.names, inout dep_nmap);
        let mut dep_tmap = ChunkSeq::new[u32]();
        read_q_types(inout tr_r, in tr_b, inout c, in dep_nmap, inout dep_tmap);
        let before_traits = d.traits.len();
        read_traits(inout tr_r, in tr_b, inout d, in dep_nmap, in dep_tmap);
        let after_traits = d.traits.len();
        for _ in before_traits..after_traits {
            fe.dep_trait_pkg.push(n32(di));
        }
    }

    declaration_pass(inout c, in d, inout fe, inout o);
    pack_text(in o)
}
