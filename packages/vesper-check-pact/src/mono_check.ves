// Monomorphization bound closure (`Mono::close_bounded`) and obligation
// checking (`Mono::check_obligations`, `Mono::type_obligations`,
// `Mono::obligation`) for `@vesper/check-pact` (SH2 lane 13 part 5, #1659).

use @vesper/check-data::input::{Reader};
use @vesper/check-data::names::{Names};
use @vesper/check-data::{pack_text};
use @vesper/check-data::types::{
    TyKind, TypeNode, Types, default_type, display, substitute, vars_new
};
use @vesper/check-data::util::{add, n32, u32_at, u64_at, u8_at, w};
use self::decl::{Gen};
use self::resolve::{
    CxHeader, failure_msg, has_infer, put_bytes, put_sym_bytes, read_cx_header, select_in_cx,
    sym_starts_with
};
use self::session::{PactSession, session_open_reader};
use self::session_input::{QArg, QGoal, put_str, read_q_names, read_q_types, sym};
use self::tyops::{mentions};

const K_FN: u8 = TyKind::Fn;
const K_LIT: u8 = TyKind::Lit;
const K_NAMED: u8 = TyKind::Named;
const K_TUPLE: u8 = TyKind::Tuple;

const NONE32: u32 = 4294967295;
const NONE64: u64 = 18446744073709551615;

const ST_OK: u8 = 0;
const ST_ERR: u8 = 1;

const CODE_E0607: u8 = 0;
const CODE_E0608: u8 = 1;
const CODE_E0609: u8 = 2;
const CODE_E0611: u8 = 3;

pub struct MonoDiags {
    pub codes: ChunkSeq[u8],
    pub span_start: ChunkSeq[u64],
    pub span_end: ChunkSeq[u64],
    pub msg_start: ChunkSeq[u32],
    pub msg_len: ChunkSeq[u32],
    pub msg_bytes: ChunkSeq[u8]
}

pub struct CxPool {
    env_start: ChunkSeq[u32],
    env_count: ChunkSeq[u32],
    env_params: ChunkSeq[Gen],
    assumption_start: ChunkSeq[u32],
    assumption_count: ChunkSeq[u32],
    assumptions: ChunkSeq[QGoal],
    arg_start: ChunkSeq[u32],
    arg_count: ChunkSeq[u32],
    args: ChunkSeq[QArg],
    scopes_start: ChunkSeq[u32],
    scopes_count: ChunkSeq[u32],
    scope_at: ChunkSeq[u32],
    scope_len: ChunkSeq[u32],
    models_start: ChunkSeq[u32],
    models_count: ChunkSeq[u32],
    scope_models: ChunkSeq[u32]
}

pub struct MonoTables {
    // ADTs for `type_obligations`: generic param names per ADT.
    adt_names: ChunkSeq[u32],
    adt_gen_start: ChunkSeq[u32],
    adt_gen_count: ChunkSeq[u32],
    adt_gen_names: ChunkSeq[u32],
    // `type_bounds` per ADT.
    tb_adt_names: ChunkSeq[u32],
    tb_entry_start: ChunkSeq[u32],
    tb_entry_count: ChunkSeq[u32],
    tb_param_idx: ChunkSeq[u32],
    tb_trait: ChunkSeq[u32],
    tb_arg_start: ChunkSeq[u32],
    tb_arg_count: ChunkSeq[u32],
    tb_args: ChunkSeq[u32],
    // Functions (`funcs` in sorted order).
    pub fn_names: ChunkSeq[u32],
    pub fn_is_stub: ChunkSeq[u8],
    pub fn_span_start: ChunkSeq[u64],
    pub fn_span_end: ChunkSeq[u64],
    // Generics per function.
    pub fn_gen_start: ChunkSeq[u32],
    pub fn_gen_count: ChunkSeq[u32],
    pub gen_names: ChunkSeq[u32],
    // Non-dyn bounds per function (`bounds_of`).
    pub fn_bound_start: ChunkSeq[u32],
    pub fn_bound_count: ChunkSeq[u32],
    pub bnd_trait: ChunkSeq[u32],
    pub bnd_ty: ChunkSeq[u32],
    pub bnd_arg_start: ChunkSeq[u32],
    pub bnd_arg_count: ChunkSeq[u32],
    pub bnd_args: ChunkSeq[u32],
    // Calls per function (`calls_in`).
    pub fn_call_start: ChunkSeq[u32],
    pub fn_call_count: ChunkSeq[u32],
    pub call_span_start: ChunkSeq[u64],
    pub call_span_end: ChunkSeq[u64],
    pub call_callee: ChunkSeq[u32],
    pub call_var_start: ChunkSeq[u32],
    pub call_var_count: ChunkSeq[u32],
    pub call_var_name: ChunkSeq[u32],
    pub call_var_ty: ChunkSeq[u32],
    call_scopes_start: ChunkSeq[u32],
    call_scopes_count: ChunkSeq[u32],
    call_scope_at: ChunkSeq[u32],
    call_scope_len: ChunkSeq[u32],
    call_models_start: ChunkSeq[u32],
    call_models_count: ChunkSeq[u32],
    call_scope_models: ChunkSeq[u32],
    // Function-value uses per function.
    fn_fval_start: ChunkSeq[u32],
    fn_fval_count: ChunkSeq[u32],
    fval_span_start: ChunkSeq[u64],
    fval_span_end: ChunkSeq[u64],
    fval_target: ChunkSeq[u32],
    // Walked types per function.
    fn_walk_start: ChunkSeq[u32],
    fn_walk_count: ChunkSeq[u32],
    walk_tys: ChunkSeq[u32]
}

pub fn diags_new() -> MonoDiags {
    MonoDiags {
        codes: ChunkSeq::new[u8](),
        span_start: ChunkSeq::new[u64](),
        span_end: ChunkSeq::new[u64](),
        msg_start: ChunkSeq::new[u32](),
        msg_len: ChunkSeq::new[u32](),
        msg_bytes: ChunkSeq::new[u8]()
    }
}

fn node_at(in types: Types, ty: u32) -> TypeNode {
    types.node(ty)
}

pub fn is_dyn_generic(in names: Names, symbol: u32) -> bool {
    sym_starts_with(in names, symbol, "__dyn__")
}

pub fn closed(in types: Types, ty: u32) -> bool {
    if has_infer(in types, ty) {
        return false;
    }
    node_at(in types, ty).kind != K_LIT
}

fn find_adt_idx(in mono: MonoTables, name: u32) -> u64 {
    for i in 0..mono.adt_names.len() {
        if u32_at(in mono.adt_names, i) == name {
            return i;
        }
    }
    NONE64
}

fn find_tb_idx(in mono: MonoTables, name: u32) -> u64 {
    for i in 0..mono.tb_adt_names.len() {
        if u32_at(in mono.tb_adt_names, i) == name {
            return i;
        }
    }
    NONE64
}

fn seen_contains(
    in diags: MonoDiags,
    span_start: u64,
    span_end: u64,
    in msg: ChunkSeq[u8]
) -> bool {
    let new_len = msg.len();
    for i in 0..diags.codes.len() {
        if u64_at(in diags.span_start, i) != span_start
            || u64_at(in diags.span_end, i) != span_end {
            continue;
        }
        let stored_start = w(u32_at(in diags.msg_start, i));
        let stored_len = w(u32_at(in diags.msg_len, i));
        if stored_len != new_len {
            continue;
        }
        let mut eq = true;
        for j in 0..stored_len {
            if u8_at(in diags.msg_bytes, add(stored_start, j)) != u8_at(in msg, j) {
                eq = false;
                break;
            }
        }
        if eq {
            return true;
        }
    }
    false
}

pub fn push_diag(
    inout diags: MonoDiags,
    code: u8,
    span_start: u64,
    span_end: u64,
    in msg: ChunkSeq[u8]
) {
    diags.codes.push(code);
    diags.span_start.push(span_start);
    diags.span_end.push(span_end);
    diags.msg_start.push(n32(diags.msg_bytes.len()));
    diags.msg_len.push(n32(msg.len()));
    diags.msg_bytes.extend(in msg.as_slice());
}

fn push_unique_diag(
    inout diags: MonoDiags,
    code: u8,
    span_start: u64,
    span_end: u64,
    in msg: ChunkSeq[u8]
) {
    if !seen_contains(in diags, span_start, span_end, in msg) {
        push_diag(inout diags, code, span_start, span_end, in msg);
    }
}

fn get_cx(in pool: CxPool, fn_idx: u64) -> CxHeader {
    let env_start = w(u32_at(in pool.env_start, fn_idx));
    let env_count = w(u32_at(in pool.env_count, fn_idx));
    let mut env_params = ChunkSeq::with_capacity[Gen](env_count);
    for i in 0..env_count {
        let generic = match pool.env_params.try_get(add(env_start, i)) {
            Option::Some(v) => v,
            Option::None => continue,
        };
        env_params.push(generic);
    }
    let assumption_start = w(u32_at(in pool.assumption_start, fn_idx));
    let assumption_count = w(u32_at(in pool.assumption_count, fn_idx));
    let mut assumptions = ChunkSeq::with_capacity[QGoal](assumption_count);
    for i in 0..assumption_count {
        let goal = match pool.assumptions.try_get(add(assumption_start, i)) {
            Option::Some(v) => v,
            Option::None => continue,
        };
        assumptions.push(goal);
    }
    let arg_start = w(u32_at(in pool.arg_start, fn_idx));
    let arg_count = w(u32_at(in pool.arg_count, fn_idx));
    let mut args = ChunkSeq::with_capacity[QArg](arg_count);
    for i in 0..arg_count {
        let arg = match pool.args.try_get(add(arg_start, i)) {
            Option::Some(v) => v,
            Option::None => continue,
        };
        args.push(arg);
    }
    let scope_start = w(u32_at(in pool.scopes_start, fn_idx));
    let scope_count = w(u32_at(in pool.scopes_count, fn_idx));
    let mut scope_at = ChunkSeq::with_capacity[u32](scope_count);
    let mut scope_len = ChunkSeq::with_capacity[u32](scope_count);
    for i in 0..scope_count {
        scope_at.push(u32_at(in pool.scope_at, add(scope_start, i)));
        scope_len.push(u32_at(in pool.scope_len, add(scope_start, i)));
    }
    let model_start = w(u32_at(in pool.models_start, fn_idx));
    let model_count = w(u32_at(in pool.models_count, fn_idx));
    let mut scope_models = ChunkSeq::with_capacity[u32](model_count);
    for i in 0..model_count {
        scope_models.push(u32_at(in pool.scope_models, add(model_start, i)));
    }
    CxHeader {
        env_params: env_params,
        assumptions: assumptions,
        args: args,
        scope_at: scope_at,
        scope_len: scope_len,
        scope_models: scope_models
    }
}

pub fn get_call_cx(in pool: CxPool, in mono: MonoTables, fn_idx: u64, call_idx: u64) -> CxHeader {
    let base = get_cx(in pool, fn_idx);
    let scope_start = w(u32_at(in mono.call_scopes_start, call_idx));
    let scope_count = w(u32_at(in mono.call_scopes_count, call_idx));
    let mut scope_at = ChunkSeq::with_capacity[u32](scope_count);
    let mut scope_len = ChunkSeq::with_capacity[u32](scope_count);
    for i in 0..scope_count {
        scope_at.push(u32_at(in mono.call_scope_at, add(scope_start, i)));
        scope_len.push(u32_at(in mono.call_scope_len, add(scope_start, i)));
    }
    let model_start = w(u32_at(in mono.call_models_start, call_idx));
    let model_count = w(u32_at(in mono.call_models_count, call_idx));
    let mut scope_models = ChunkSeq::with_capacity[u32](model_count);
    for i in 0..model_count {
        scope_models.push(u32_at(in mono.call_scope_models, add(model_start, i)));
    }
    CxHeader {
        env_params: base.env_params,
        assumptions: base.assumptions,
        args: base.args,
        scope_at: scope_at,
        scope_len: scope_len,
        scope_models: scope_models
    }
}

pub fn close_bounded(
    in types: Types,
    in names: Names,
    in mono: MonoTables,
    inout errors: MonoDiags
) -> ChunkSeq[u8] {
    let fn_count = mono.fn_names.len();
    let mut bounded = ChunkSeq::with_capacity[u8](fn_count);
    for fi in 0..fn_count {
        let is_bounded = u32_at(in mono.fn_bound_count, fi) > 0
            || u8_at(in mono.fn_is_stub, fi) != 0;
        bounded.push(if is_bounded { 1 } else { 0 });
    }
    loop {
        let mut changed = false;
        let mut to_add = ChunkSeq::new[u32]();
        for fi in 0..fn_count {
            if u8_at(in bounded, fi) != 0 || u32_at(in mono.fn_gen_count, fi) == 0 {
                continue;
            }
            let gen_start = w(u32_at(in mono.fn_gen_start, fi));
            let gen_count = w(u32_at(in mono.fn_gen_count, fi));
            let call_start = w(u32_at(in mono.fn_call_start, fi));
            let call_count = w(u32_at(in mono.fn_call_count, fi));
            let mut open = false;
            for ci in 0..call_count {
                let call_idx = add(call_start, ci);
                let callee = w(u32_at(in mono.call_callee, call_idx));
                if u8_at(in bounded, callee) == 0 {
                    continue;
                }
                let var_start = w(u32_at(in mono.call_var_start, call_idx));
                let var_count = w(u32_at(in mono.call_var_count, call_idx));
                for vi in 0..var_count {
                    let var_idx = add(var_start, vi);
                    let var_name = u32_at(in mono.call_var_name, var_idx);
                    if is_dyn_generic(in names, var_name) {
                        continue;
                    }
                    let var_ty = u32_at(in mono.call_var_ty, var_idx);
                    for gi in 0..gen_count {
                        let gen_name = u32_at(in mono.gen_names, add(gen_start, gi));
                        if !is_dyn_generic(in names, gen_name)
                            && mentions(in types, var_ty, gen_name) {
                            open = true;
                            break;
                        }
                    }
                    if open {
                        break;
                    }
                }
                if open {
                    break;
                }
            }
            if open {
                to_add.push(n32(fi));
                changed = true;
            }
        }
        if !changed {
            break;
        }
        for i in 0..to_add.len() {
            let _ok = bounded.try_set(w(u32_at(in to_add, i)), 1);
        }
    }
    for fi in 0..fn_count {
        let fval_start = w(u32_at(in mono.fn_fval_start, fi));
        let fval_count = w(u32_at(in mono.fn_fval_count, fi));
        for ui in 0..fval_count {
            let fval_idx = add(fval_start, ui);
            let target = w(u32_at(in mono.fval_target, fval_idx));
            if u8_at(in bounded, target) != 0 {
                let target_name = u32_at(in mono.fn_names, target);
                let mut msg = ChunkSeq::new[u8]();
                msg.push(39);
                put_sym_bytes(in names, target_name, inout msg);
                put_str(
                    inout msg,
                    "' has trait-bounded type parameters and cannot be used as a function value; call it directly (dictionary passing is not supported)"
                );
                push_diag(
                    inout errors,
                    CODE_E0607,
                    u64_at(in mono.fval_span_start, fval_idx),
                    u64_at(in mono.fval_span_end, fval_idx),
                    in msg
                );
            }
        }
    }
    bounded
}

fn fn_mentions_generic(in types: Types, in mono: MonoTables, fn_idx: u64, ty: u32) -> bool {
    let gen_start = w(u32_at(in mono.fn_gen_start, fn_idx));
    let gen_count = w(u32_at(in mono.fn_gen_count, fn_idx));
    for gi in 0..gen_count {
        let gen_name = u32_at(in mono.gen_names, add(gen_start, gi));
        if mentions(in types, ty, gen_name) {
            return true;
        }
    }
    false
}

fn check_one_obligation(
    inout sess: PactSession,
    in mono: MonoTables,
    in context: CxHeader,
    fn_idx: u64,
    trait_name: u32,
    ty: u32,
    in args: Slice[u32],
    span_start: u64,
    span_end: u64,
    in what: ChunkSeq[u8],
    inout errors: MonoDiags
) {
    let outcome = select_in_cx(inout sess, in context, trait_name, ty, 0, in args);
    if outcome.status == ST_OK || (outcome.status == ST_ERR && outcome.val == 5) {
        return;
    }
    let mut trait_text = ChunkSeq::new[u8]();
    put_sym_bytes(in sess.ctx.names, trait_name, inout trait_text);
    let (raw_code, raw_msg) = failure_msg(
        in sess.ctx.types,
        in sess.ctx.names,
        in trait_text.as_slice(),
        trait_name,
        ty,
        outcome.val,
        in outcome.msg.as_slice()
    );
    let generic = fn_mentions_generic(in sess.ctx.types, in mono, fn_idx, ty);
    let mut code = raw_code;
    let mut msg = ChunkSeq::new[u8]();
    put_bytes(inout msg, in what.as_slice());
    put_str(inout msg, ": ");
    put_bytes(inout msg, in raw_msg.as_slice());
    if generic && (code == CODE_E0607 || code == CODE_E0608) {
        code = CODE_E0608;
        put_str(inout msg, "; add the bound `");
        display(in sess.ctx.types, in sess.ctx.names, ty, inout msg);
        put_str(inout msg, ": ");
        put_sym_bytes(in sess.ctx.names, trait_name, inout msg);
        put_str(inout msg, "` to '");
        put_sym_bytes(in sess.ctx.names, u32_at(in mono.fn_names, fn_idx), inout msg);
        msg.push(39);
    }
    push_unique_diag(inout errors, code, span_start, span_end, in msg);
}

fn check_type_obligations(
    inout sess: PactSession,
    in mono: MonoTables,
    in pool: CxPool,
    fn_idx: u64,
    ty: u32,
    inout errors: MonoDiags
) {
    let node = node_at(in sess.ctx.types, ty);
    if node.kind == K_NAMED {
        let arg_start = w(node.a);
        let arg_count = w(node.n);
        for i in 0..arg_count {
            let child = u32_at(in sess.ctx.types.items, add(arg_start, i));
            check_type_obligations(inout sess, in mono, in pool, fn_idx, child, inout errors);
        }
        let tb_idx = find_tb_idx(in mono, node.name);
        if tb_idx == NONE64 {
            return;
        }
        let mut vars = vars_new();
        let adt_idx = find_adt_idx(in mono, node.name);
        if adt_idx != NONE64 {
            let gen_start = w(u32_at(in mono.adt_gen_start, adt_idx));
            let gen_count = w(u32_at(in mono.adt_gen_count, adt_idx));
            let limit = if gen_count < arg_count {
                gen_count
            } else {
                arg_count
            };
            for gi in 0..limit {
                vars.set(
                    u32_at(in mono.adt_gen_names, add(gen_start, gi)),
                    u32_at(in sess.ctx.types.items, add(arg_start, gi))
                );
            }
        }
        let entry_start = w(u32_at(in mono.tb_entry_start, tb_idx));
        let entry_count = w(u32_at(in mono.tb_entry_count, tb_idx));
        let fn_span_start = u64_at(in mono.fn_span_start, fn_idx);
        let fn_span_end = u64_at(in mono.fn_span_end, fn_idx);
        for ei in 0..entry_count {
            let entry_idx = add(entry_start, ei);
            let param_idx = w(u32_at(in mono.tb_param_idx, entry_idx));
            if param_idx >= arg_count {
                continue;
            }
            let raw_arg = u32_at(in sess.ctx.types.items, add(arg_start, param_idx));
            let arg = default_type(inout sess.ctx.types, raw_arg);
            if !closed(in sess.ctx.types, arg) {
                continue;
            }
            let trait_name = u32_at(in mono.tb_trait, entry_idx);
            let mut what = ChunkSeq::new[u8]();
            put_str(inout what, "type '");
            display(in sess.ctx.types, in sess.ctx.names, ty, inout what);
            put_str(inout what, "' requires ");
            display(in sess.ctx.types, in sess.ctx.names, arg, inout what);
            put_str(inout what, ": ");
            put_sym_bytes(in sess.ctx.names, trait_name, inout what);
            let targ_start = w(u32_at(in mono.tb_arg_start, entry_idx));
            let targ_count = w(u32_at(in mono.tb_arg_count, entry_idx));
            let mut targs = ChunkSeq::with_capacity[u32](targ_count);
            for ai in 0..targ_count {
                let raw_targ = u32_at(in mono.tb_args, add(targ_start, ai));
                targs.push(substitute(inout sess.ctx.types, raw_targ, in vars));
            }
            let context = get_cx(in pool, fn_idx);
            check_one_obligation(
                inout sess,
                in mono,
                in context,
                fn_idx,
                trait_name,
                arg,
                in targs.as_slice(),
                fn_span_start,
                fn_span_end,
                in what,
                inout errors
            );
        }
        return;
    }
    if node.kind == K_TUPLE {
        let arg_start = w(node.a);
        let arg_count = w(node.n);
        for i in 0..arg_count {
            let child = u32_at(in sess.ctx.types.items, add(arg_start, i));
            check_type_obligations(inout sess, in mono, in pool, fn_idx, child, inout errors);
        }
        return;
    }
    if node.kind == K_FN {
        let arg_start = w(node.a);
        let arg_count = w(node.n);
        for i in 0..arg_count {
            let child = u32_at(in sess.ctx.types.items, add(arg_start, i));
            check_type_obligations(inout sess, in mono, in pool, fn_idx, child, inout errors);
        }
        check_type_obligations(inout sess, in mono, in pool, fn_idx, node.r, inout errors);
    }
}

pub fn check_obligations(
    inout sess: PactSession,
    in mono: MonoTables,
    in pool: CxPool,
    inout errors: MonoDiags
) {
    let fn_count = mono.fn_names.len();
    for fi in 0..fn_count {
        if u8_at(in mono.fn_is_stub, fi) != 0 {
            continue;
        }
        let call_start = w(u32_at(in mono.fn_call_start, fi));
        let call_count = w(u32_at(in mono.fn_call_count, fi));
        for ci in 0..call_count {
            let call_idx = add(call_start, ci);
            let call_span_start = u64_at(in mono.call_span_start, call_idx);
            let call_span_end = u64_at(in mono.call_span_end, call_idx);
            let callee = w(u32_at(in mono.call_callee, call_idx));
            let var_start = w(u32_at(in mono.call_var_start, call_idx));
            let var_count = w(u32_at(in mono.call_var_count, call_idx));
            let mut vars = vars_new();
            for vi in 0..var_count {
                let var_idx = add(var_start, vi);
                let var_name = u32_at(in mono.call_var_name, var_idx);
                let var_ty = default_type(
                    inout sess.ctx.types,
                    u32_at(in mono.call_var_ty, var_idx)
                );
                vars.set(var_name, var_ty);
            }
            let bound_start = w(u32_at(in mono.fn_bound_start, callee));
            let bound_count = w(u32_at(in mono.fn_bound_count, callee));
            for bi in 0..bound_count {
                let bound_idx = add(bound_start, bi);
                let trait_name = u32_at(in mono.bnd_trait, bound_idx);
                let ty = substitute(
                    inout sess.ctx.types,
                    u32_at(in mono.bnd_ty, bound_idx),
                    in vars
                );
                let targ_start = w(u32_at(in mono.bnd_arg_start, bound_idx));
                let targ_count = w(u32_at(in mono.bnd_arg_count, bound_idx));
                let mut args = ChunkSeq::with_capacity[u32](targ_count);
                for ai in 0..targ_count {
                    let raw_arg = u32_at(in mono.bnd_args, add(targ_start, ai));
                    args.push(substitute(inout sess.ctx.types, raw_arg, in vars));
                }
                let mut what = ChunkSeq::new[u8]();
                what.push(39);
                put_sym_bytes(in sess.ctx.names, u32_at(in mono.fn_names, callee), inout what);
                put_str(inout what, "' requires ");
                display(in sess.ctx.types, in sess.ctx.names, ty, inout what);
                put_str(inout what, ": ");
                put_sym_bytes(in sess.ctx.names, trait_name, inout what);
                if !closed(in sess.ctx.types, ty) {
                    put_str(
                        inout what,
                        ", but the type argument cannot be inferred; annotate the arguments"
                    );
                    push_diag(inout errors, CODE_E0607, call_span_start, call_span_end, in what);
                    continue;
                }
                let context = get_call_cx(in pool, in mono, fi, call_idx);
                check_one_obligation(
                    inout sess,
                    in mono,
                    in context,
                    fi,
                    trait_name,
                    ty,
                    in args.as_slice(),
                    call_span_start,
                    call_span_end,
                    in what,
                    inout errors
                );
            }
        }
        let walk_start = w(u32_at(in mono.fn_walk_start, fi));
        let walk_count = w(u32_at(in mono.fn_walk_count, fi));
        for ti in 0..walk_count {
            let ty = u32_at(in mono.walk_tys, add(walk_start, ti));
            check_type_obligations(inout sess, in mono, in pool, fi, ty, inout errors);
        }
    }
}

pub fn read_mono_tables(
    inout reader: Reader,
    in bytes: Slice[u8],
    inout sess: PactSession,
    in nmap: ChunkSeq[u32],
    in tmap: ChunkSeq[u32]
) -> (MonoTables, CxPool) {
    let adt_count = reader.word(in bytes);
    let mut adt_names = ChunkSeq::with_capacity[u32](adt_count);
    let mut adt_gen_start = ChunkSeq::with_capacity[u32](adt_count);
    let mut adt_gen_count = ChunkSeq::with_capacity[u32](adt_count);
    let mut adt_gen_names = ChunkSeq::new[u32]();
    for _ in 0..adt_count {
        adt_names.push(sym(in nmap, reader.word(in bytes)));
        adt_gen_start.push(n32(adt_gen_names.len()));
        let gen_count = reader.word(in bytes);
        adt_gen_count.push(n32(gen_count));
        for _ in 0..gen_count {
            adt_gen_names.push(sym(in nmap, reader.word(in bytes)));
        }
    }

    let tb_count = reader.word(in bytes);
    let mut tb_adt_names = ChunkSeq::with_capacity[u32](tb_count);
    let mut tb_entry_start = ChunkSeq::with_capacity[u32](tb_count);
    let mut tb_entry_count = ChunkSeq::with_capacity[u32](tb_count);
    let mut tb_param_idx = ChunkSeq::new[u32]();
    let mut tb_trait = ChunkSeq::new[u32]();
    let mut tb_arg_start = ChunkSeq::new[u32]();
    let mut tb_arg_count = ChunkSeq::new[u32]();
    let mut tb_args = ChunkSeq::new[u32]();
    for _ in 0..tb_count {
        tb_adt_names.push(sym(in nmap, reader.word(in bytes)));
        tb_entry_start.push(n32(tb_param_idx.len()));
        let entry_count = reader.word(in bytes);
        tb_entry_count.push(n32(entry_count));
        for _ in 0..entry_count {
            tb_param_idx.push(n32(reader.word(in bytes)));
            tb_trait.push(sym(in nmap, reader.word(in bytes)));
            tb_arg_start.push(n32(tb_args.len()));
            let arg_count = reader.word(in bytes);
            tb_arg_count.push(n32(arg_count));
            for _ in 0..arg_count {
                tb_args.push(u32_at(in tmap, reader.word(in bytes)));
            }
        }
    }

    let fn_count = reader.word(in bytes);
    let mut fn_names = ChunkSeq::with_capacity[u32](fn_count);
    let mut fn_is_stub = ChunkSeq::with_capacity[u8](fn_count);
    let mut fn_span_start = ChunkSeq::with_capacity[u64](fn_count);
    let mut fn_span_end = ChunkSeq::with_capacity[u64](fn_count);
    let mut fn_gen_start = ChunkSeq::with_capacity[u32](fn_count);
    let mut fn_gen_count = ChunkSeq::with_capacity[u32](fn_count);
    let mut gen_names = ChunkSeq::new[u32]();
    let mut fn_bound_start = ChunkSeq::with_capacity[u32](fn_count);
    let mut fn_bound_count = ChunkSeq::with_capacity[u32](fn_count);
    let mut bnd_trait = ChunkSeq::new[u32]();
    let mut bnd_ty = ChunkSeq::new[u32]();
    let mut bnd_arg_start = ChunkSeq::new[u32]();
    let mut bnd_arg_count = ChunkSeq::new[u32]();
    let mut bnd_args = ChunkSeq::new[u32]();
    let mut fn_call_start = ChunkSeq::with_capacity[u32](fn_count);
    let mut fn_call_count = ChunkSeq::with_capacity[u32](fn_count);
    let mut call_span_start = ChunkSeq::new[u64]();
    let mut call_span_end = ChunkSeq::new[u64]();
    let mut call_callee = ChunkSeq::new[u32]();
    let mut call_var_start = ChunkSeq::new[u32]();
    let mut call_var_count = ChunkSeq::new[u32]();
    let mut call_var_name = ChunkSeq::new[u32]();
    let mut call_var_ty = ChunkSeq::new[u32]();
    let mut call_scopes_start = ChunkSeq::new[u32]();
    let mut call_scopes_count = ChunkSeq::new[u32]();
    let mut call_scope_at = ChunkSeq::new[u32]();
    let mut call_scope_len = ChunkSeq::new[u32]();
    let mut call_models_start = ChunkSeq::new[u32]();
    let mut call_models_count = ChunkSeq::new[u32]();
    let mut call_scope_models = ChunkSeq::new[u32]();
    let mut fn_fval_start = ChunkSeq::with_capacity[u32](fn_count);
    let mut fn_fval_count = ChunkSeq::with_capacity[u32](fn_count);
    let mut fval_span_start = ChunkSeq::new[u64]();
    let mut fval_span_end = ChunkSeq::new[u64]();
    let mut fval_target = ChunkSeq::new[u32]();
    let mut fn_walk_start = ChunkSeq::with_capacity[u32](fn_count);
    let mut fn_walk_count = ChunkSeq::with_capacity[u32](fn_count);
    let mut walk_tys = ChunkSeq::new[u32]();

    let mut cp_env_start = ChunkSeq::with_capacity[u32](fn_count);
    let mut cp_env_count = ChunkSeq::with_capacity[u32](fn_count);
    let mut cp_env_params = ChunkSeq::new[Gen]();
    let mut cp_assumption_start = ChunkSeq::with_capacity[u32](fn_count);
    let mut cp_assumption_count = ChunkSeq::with_capacity[u32](fn_count);
    let mut cp_assumptions = ChunkSeq::new[QGoal]();
    let mut cp_arg_start = ChunkSeq::with_capacity[u32](fn_count);
    let mut cp_arg_count = ChunkSeq::with_capacity[u32](fn_count);
    let mut cp_args = ChunkSeq::new[QArg]();
    let mut cp_scopes_start = ChunkSeq::with_capacity[u32](fn_count);
    let mut cp_scopes_count = ChunkSeq::with_capacity[u32](fn_count);
    let mut cp_scope_at = ChunkSeq::new[u32]();
    let mut cp_scope_len = ChunkSeq::new[u32]();
    let mut cp_models_start = ChunkSeq::with_capacity[u32](fn_count);
    let mut cp_models_count = ChunkSeq::with_capacity[u32](fn_count);
    let mut cp_scope_models = ChunkSeq::new[u32]();

    for _ in 0..fn_count {
        let fn_name = sym(in nmap, reader.word(in bytes));
        fn_names.push(fn_name);
        fn_is_stub.push(
            if sym_starts_with(in sess.ctx.names, fn_name, "bound$") {
                1
            } else {
                0
            }
        );
        fn_span_start.push(reader.word(in bytes));
        fn_span_end.push(reader.word(in bytes));

        let context = read_cx_header(inout reader, in bytes, inout sess, in nmap, in tmap, fn_name);
        fn_gen_start.push(n32(gen_names.len()));
        fn_gen_count.push(n32(context.env_params.len()));
        cp_env_start.push(n32(cp_env_params.len()));
        cp_env_count.push(n32(context.env_params.len()));
        for gi in 0..context.env_params.len() {
            let generic = match context.env_params.try_get(gi) {
                Option::Some(v) => v,
                Option::None => continue,
            };
            gen_names.push(generic.name);
            cp_env_params.push(generic);
        }
        cp_assumption_start.push(n32(cp_assumptions.len()));
        cp_assumption_count.push(n32(context.assumptions.len()));
        cp_assumptions.extend(in context.assumptions.as_slice());
        cp_arg_start.push(n32(cp_args.len()));
        cp_arg_count.push(n32(context.args.len()));
        cp_args.extend(in context.args.as_slice());
        cp_scopes_start.push(n32(cp_scope_at.len()));
        cp_scopes_count.push(n32(context.scope_at.len()));
        cp_scope_at.extend(in context.scope_at.as_slice());
        cp_scope_len.extend(in context.scope_len.as_slice());
        cp_models_start.push(n32(cp_scope_models.len()));
        cp_models_count.push(n32(context.scope_models.len()));
        cp_scope_models.extend(in context.scope_models.as_slice());

        fn_bound_start.push(n32(bnd_trait.len()));
        let bound_count = reader.word(in bytes);
        fn_bound_count.push(n32(bound_count));
        for _ in 0..bound_count {
            bnd_trait.push(sym(in nmap, reader.word(in bytes)));
            bnd_ty.push(u32_at(in tmap, reader.word(in bytes)));
            bnd_arg_start.push(n32(bnd_args.len()));
            let arg_count = reader.word(in bytes);
            bnd_arg_count.push(n32(arg_count));
            for _ in 0..arg_count {
                bnd_args.push(u32_at(in tmap, reader.word(in bytes)));
            }
        }

        fn_call_start.push(n32(call_span_start.len()));
        let call_count = reader.word(in bytes);
        fn_call_count.push(n32(call_count));
        for _ in 0..call_count {
            call_span_start.push(reader.word(in bytes));
            call_span_end.push(reader.word(in bytes));
            call_callee.push(n32(reader.word(in bytes)));
            call_var_start.push(n32(call_var_name.len()));
            let var_count = reader.word(in bytes);
            call_var_count.push(n32(var_count));
            for _ in 0..var_count {
                call_var_name.push(sym(in nmap, reader.word(in bytes)));
                call_var_ty.push(u32_at(in tmap, reader.word(in bytes)));
            }
            call_scopes_start.push(n32(call_scope_at.len()));
            let scope_count = reader.word(in bytes);
            call_scopes_count.push(n32(scope_count));
            call_models_start.push(n32(call_scope_models.len()));
            let model_base = call_scope_models.len();
            for _ in 0..scope_count {
                call_scope_at.push(n32(wrapping_sub(call_scope_models.len(), model_base)));
                let models_len = reader.word(in bytes);
                call_scope_len.push(n32(models_len));
                for _ in 0..models_len {
                    call_scope_models.push(sym(in nmap, reader.word(in bytes)));
                }
            }
            call_models_count.push(n32(wrapping_sub(call_scope_models.len(), model_base)));
        }

        fn_fval_start.push(n32(fval_span_start.len()));
        let fval_count = reader.word(in bytes);
        fn_fval_count.push(n32(fval_count));
        for _ in 0..fval_count {
            fval_span_start.push(reader.word(in bytes));
            fval_span_end.push(reader.word(in bytes));
            fval_target.push(n32(reader.word(in bytes)));
        }

        fn_walk_start.push(n32(walk_tys.len()));
        let walk_count = reader.word(in bytes);
        fn_walk_count.push(n32(walk_count));
        for _ in 0..walk_count {
            walk_tys.push(u32_at(in tmap, reader.word(in bytes)));
        }
    }

    (
        MonoTables {
            adt_names: adt_names,
            adt_gen_start: adt_gen_start,
            adt_gen_count: adt_gen_count,
            adt_gen_names: adt_gen_names,
            tb_adt_names: tb_adt_names,
            tb_entry_start: tb_entry_start,
            tb_entry_count: tb_entry_count,
            tb_param_idx: tb_param_idx,
            tb_trait: tb_trait,
            tb_arg_start: tb_arg_start,
            tb_arg_count: tb_arg_count,
            tb_args: tb_args,
            fn_names: fn_names,
            fn_is_stub: fn_is_stub,
            fn_span_start: fn_span_start,
            fn_span_end: fn_span_end,
            fn_gen_start: fn_gen_start,
            fn_gen_count: fn_gen_count,
            gen_names: gen_names,
            fn_bound_start: fn_bound_start,
            fn_bound_count: fn_bound_count,
            bnd_trait: bnd_trait,
            bnd_ty: bnd_ty,
            bnd_arg_start: bnd_arg_start,
            bnd_arg_count: bnd_arg_count,
            bnd_args: bnd_args,
            fn_call_start: fn_call_start,
            fn_call_count: fn_call_count,
            call_span_start: call_span_start,
            call_span_end: call_span_end,
            call_callee: call_callee,
            call_var_start: call_var_start,
            call_var_count: call_var_count,
            call_var_name: call_var_name,
            call_var_ty: call_var_ty,
            call_scopes_start: call_scopes_start,
            call_scopes_count: call_scopes_count,
            call_scope_at: call_scope_at,
            call_scope_len: call_scope_len,
            call_models_start: call_models_start,
            call_models_count: call_models_count,
            call_scope_models: call_scope_models,
            fn_fval_start: fn_fval_start,
            fn_fval_count: fn_fval_count,
            fval_span_start: fval_span_start,
            fval_span_end: fval_span_end,
            fval_target: fval_target,
            fn_walk_start: fn_walk_start,
            fn_walk_count: fn_walk_count,
            walk_tys: walk_tys
        },
        CxPool {
            env_start: cp_env_start,
            env_count: cp_env_count,
            env_params: cp_env_params,
            assumption_start: cp_assumption_start,
            assumption_count: cp_assumption_count,
            assumptions: cp_assumptions,
            arg_start: cp_arg_start,
            arg_count: cp_arg_count,
            args: cp_args,
            scopes_start: cp_scopes_start,
            scopes_count: cp_scopes_count,
            scope_at: cp_scope_at,
            scope_len: cp_scope_len,
            models_start: cp_models_start,
            models_count: cp_models_count,
            scope_models: cp_scope_models
        }
    )
}

fn mono_check_body(
    inout sess: PactSession,
    inout reader: Reader,
    in bytes: Slice[u8],
    inout out: ChunkSeq[u64]
) {
    let mut nmap = ChunkSeq::new[u32]();
    read_q_names(inout reader, in bytes, inout sess.ctx.names, inout nmap);
    let mut tmap = ChunkSeq::new[u32]();
    read_q_types(inout reader, in bytes, inout sess.ctx, in nmap, inout tmap);
    let (mono, pool) = read_mono_tables(inout reader, in bytes, inout sess, in nmap, in tmap);
    let mut errors = diags_new();
    let bounded = close_bounded(in sess.ctx.types, in sess.ctx.names, in mono, inout errors);
    check_obligations(inout sess, in mono, in pool, inout errors);
    out.push(bounded.len());
    for i in 0..bounded.len() {
        out.push(if u8_at(in bounded, i) != 0 { 1 } else { 0 });
    }
    out.push(errors.codes.len());
    for i in 0..errors.codes.len() {
        let code = u8_at(in errors.codes, i);
        out.push(
            if code == 1 {
                1
            } else if code == 2 {
                2
            } else if code == 3 {
                3
            } else {
                0
            }
        );
        out.push(u64_at(in errors.span_start, i));
        out.push(u64_at(in errors.span_end, i));
        let msg_start = w(u32_at(in errors.msg_start, i));
        let msg_len = w(u32_at(in errors.msg_len, i));
        let mut msg = ChunkSeq::with_capacity[u8](msg_len);
        for j in 0..msg_len {
            msg.push(u8_at(in errors.msg_bytes, add(msg_start, j)));
        }
        let packed_msg = pack_text(in msg);
        out.extend(in packed_msg.as_slice());
    }
}

// Entrypoint for an already-open `PactSession`: `[mono_input]`.
pub fn session_mono_check_words(inout sess: PactSession, in bytes: Slice[u8]) -> ChunkSeq[u64] {
    let mut reader = Reader { pos: 0 };
    let mut out = ChunkSeq::new[u64]();
    out.push(0);
    out.push(1);
    mono_check_body(inout sess, inout reader, in bytes, inout out);
    out
}

// Entrypoint for `check_pact_mono_check`: `[session_input][mono_input]`.
pub fn mono_check_words(in bytes: Slice[u8]) -> ChunkSeq[u64] {
    let mut reader = Reader { pos: 0 };
    let mut sess = session_open_reader(inout reader, in bytes);
    let mut out = ChunkSeq::new[u64]();
    let packed_out = pack_text(in sess.out);
    out.extend(in packed_out.as_slice());
    if !sess.ok {
        out.push(0);
        return out;
    }
    out.push(1);
    mono_check_body(inout sess, inout reader, in bytes, inout out);
    out
}
