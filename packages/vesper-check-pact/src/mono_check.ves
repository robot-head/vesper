// Monomorphization bound closure (`Mono::close_bounded`) and obligation
// checking (`Mono::check_obligations`, `Mono::type_obligations`,
// `Mono::obligation`) for `@vesper/check-pact` (SH2 lane 13 part 5, #1659).

use @vesper/check-data::input::{Reader};
use @vesper/check-data::names::{Names};
use @vesper/check-data::{pack_text};
use @vesper/check-data::types::{
    TyKind, TypeNode, Types, default_type, display, substitute, vars_new
};
use @vesper/check-data::util::{add, n32, u32_at, u64_at, u8_at, w};
use self::decl::{Gen};
use self::resolve::{
    CxHeader, failure_msg, has_infer, put_bytes, put_sym_bytes, read_cx_header, select_in_cx,
    sym_starts_with
};
use self::session::{PactSession, session_open_reader};
use self::session_input::{QArg, QGoal, put_str, read_q_names, read_q_types, sym};
use self::tyops::{mentions};

const K_FN: u8 = TyKind::Fn;
const K_LIT: u8 = TyKind::Lit;
const K_NAMED: u8 = TyKind::Named;
const K_TUPLE: u8 = TyKind::Tuple;

const NONE32: u32 = 4294967295;
const NONE64: u64 = 18446744073709551615;

const ST_OK: u8 = 0;
const ST_ERR: u8 = 1;

const CODE_E0607: u8 = 0;
const CODE_E0608: u8 = 1;
const CODE_E0609: u8 = 2;
const CODE_E0611: u8 = 3;

pub struct MonoDiags {
    pub codes: ChunkSeq[u8],
    pub s: ChunkSeq[u64],
    pub e: ChunkSeq[u64],
    pub msg_a: ChunkSeq[u32],
    pub msg_n: ChunkSeq[u32],
    pub msg_bytes: ChunkSeq[u8]
}

pub struct CxPool {
    env_a: ChunkSeq[u32],
    env_n: ChunkSeq[u32],
    env_params: ChunkSeq[Gen],
    ass_a: ChunkSeq[u32],
    ass_n: ChunkSeq[u32],
    assumptions: ChunkSeq[QGoal],
    arg_a: ChunkSeq[u32],
    arg_n: ChunkSeq[u32],
    args: ChunkSeq[QArg],
    sc_a: ChunkSeq[u32],
    sc_n: ChunkSeq[u32],
    scope_at: ChunkSeq[u32],
    scope_len: ChunkSeq[u32],
    sm_a: ChunkSeq[u32],
    sm_n: ChunkSeq[u32],
    scope_models: ChunkSeq[u32]
}

pub struct MonoTables {
    // ADTs for `type_obligations`: generic param names per ADT.
    adt_names: ChunkSeq[u32],
    adt_ga: ChunkSeq[u32],
    adt_gn: ChunkSeq[u32],
    adt_gen_names: ChunkSeq[u32],
    // `type_bounds` per ADT.
    tb_adt_names: ChunkSeq[u32],
    tb_ea: ChunkSeq[u32],
    tb_en: ChunkSeq[u32],
    tb_param_idx: ChunkSeq[u32],
    tb_trait: ChunkSeq[u32],
    tb_aa: ChunkSeq[u32],
    tb_an: ChunkSeq[u32],
    tb_args: ChunkSeq[u32],
    // Functions (`funcs` in sorted order).
    pub fn_names: ChunkSeq[u32],
    pub fn_is_stub: ChunkSeq[u8],
    pub fn_s: ChunkSeq[u64],
    pub fn_e: ChunkSeq[u64],
    // Generics per function.
    pub fn_ga: ChunkSeq[u32],
    pub fn_gn: ChunkSeq[u32],
    pub gen_names: ChunkSeq[u32],
    // Non-dyn bounds per function (`bounds_of`).
    pub fn_ba: ChunkSeq[u32],
    pub fn_bn: ChunkSeq[u32],
    pub bnd_trait: ChunkSeq[u32],
    pub bnd_ty: ChunkSeq[u32],
    pub bnd_aa: ChunkSeq[u32],
    pub bnd_an: ChunkSeq[u32],
    pub bnd_args: ChunkSeq[u32],
    // Calls per function (`calls_in`).
    pub fn_ca: ChunkSeq[u32],
    pub fn_cn: ChunkSeq[u32],
    pub call_s: ChunkSeq[u64],
    pub call_e: ChunkSeq[u64],
    pub call_callee: ChunkSeq[u32],
    pub call_va: ChunkSeq[u32],
    pub call_vn: ChunkSeq[u32],
    pub call_vname: ChunkSeq[u32],
    pub call_vty: ChunkSeq[u32],
    call_sc_a: ChunkSeq[u32],
    call_sc_n: ChunkSeq[u32],
    call_scope_at: ChunkSeq[u32],
    call_scope_len: ChunkSeq[u32],
    call_sm_a: ChunkSeq[u32],
    call_sm_n: ChunkSeq[u32],
    call_scope_models: ChunkSeq[u32],
    // Function-value uses per function.
    fn_fa: ChunkSeq[u32],
    fn_fn: ChunkSeq[u32],
    fval_s: ChunkSeq[u64],
    fval_e: ChunkSeq[u64],
    fval_target: ChunkSeq[u32],
    // Walked types per function.
    fn_ta: ChunkSeq[u32],
    fn_tn: ChunkSeq[u32],
    walk_tys: ChunkSeq[u32]
}

pub fn diags_new() -> MonoDiags {
    MonoDiags {
        codes: ChunkSeq::new[u8](),
        s: ChunkSeq::new[u64](),
        e: ChunkSeq::new[u64](),
        msg_a: ChunkSeq::new[u32](),
        msg_n: ChunkSeq::new[u32](),
        msg_bytes: ChunkSeq::new[u8]()
    }
}

fn node_at(in t: Types, ty: u32) -> TypeNode {
    t.node(ty)
}

pub fn is_dyn_generic(in names: Names, s: u32) -> bool {
    sym_starts_with(in names, s, "__dyn__")
}

pub fn closed(in t: Types, ty: u32) -> bool {
    if has_infer(in t, ty) {
        return false;
    }
    node_at(in t, ty).kind != K_LIT
}

fn find_adt_idx(in m: MonoTables, name: u32) -> u64 {
    for i in 0..m.adt_names.len() {
        if u32_at(in m.adt_names, i) == name {
            return i;
        }
    }
    NONE64
}

fn find_tb_idx(in m: MonoTables, name: u32) -> u64 {
    for i in 0..m.tb_adt_names.len() {
        if u32_at(in m.tb_adt_names, i) == name {
            return i;
        }
    }
    NONE64
}

fn seen_contains(in diags: MonoDiags, s: u64, e: u64, in msg: ChunkSeq[u8]) -> bool {
    let ml = msg.len();
    for i in 0..diags.codes.len() {
        if u64_at(in diags.s, i) != s || u64_at(in diags.e, i) != e {
            continue;
        }
        let ma = w(u32_at(in diags.msg_a, i));
        let mn = w(u32_at(in diags.msg_n, i));
        if mn != ml {
            continue;
        }
        let mut eq = true;
        for j in 0..mn {
            if u8_at(in diags.msg_bytes, add(ma, j)) != u8_at(in msg, j) {
                eq = false;
                break;
            }
        }
        if eq {
            return true;
        }
    }
    false
}

pub fn push_diag(inout diags: MonoDiags, code: u8, s: u64, e: u64, in msg: ChunkSeq[u8]) {
    diags.codes.push(code);
    diags.s.push(s);
    diags.e.push(e);
    diags.msg_a.push(n32(diags.msg_bytes.len()));
    diags.msg_n.push(n32(msg.len()));
    diags.msg_bytes.extend(in msg.as_slice());
}

fn push_unique_diag(inout diags: MonoDiags, code: u8, s: u64, e: u64, in msg: ChunkSeq[u8]) {
    if !seen_contains(in diags, s, e, in msg) {
        push_diag(inout diags, code, s, e, in msg);
    }
}

fn get_cx(in cp: CxPool, fi: u64) -> CxHeader {
    let ea = w(u32_at(in cp.env_a, fi));
    let en = w(u32_at(in cp.env_n, fi));
    let mut env_params = ChunkSeq::with_capacity[Gen](en);
    for i in 0..en {
        let g = match cp.env_params.try_get(add(ea, i)) {
            Option::Some(v) => v,
            Option::None => continue,
        };
        env_params.push(g);
    }
    let aa = w(u32_at(in cp.ass_a, fi));
    let an = w(u32_at(in cp.ass_n, fi));
    let mut assumptions = ChunkSeq::with_capacity[QGoal](an);
    for i in 0..an {
        let q = match cp.assumptions.try_get(add(aa, i)) {
            Option::Some(v) => v,
            Option::None => continue,
        };
        assumptions.push(q);
    }
    let ga = w(u32_at(in cp.arg_a, fi));
    let gn = w(u32_at(in cp.arg_n, fi));
    let mut args = ChunkSeq::with_capacity[QArg](gn);
    for i in 0..gn {
        let a = match cp.args.try_get(add(ga, i)) {
            Option::Some(v) => v,
            Option::None => continue,
        };
        args.push(a);
    }
    let sa = w(u32_at(in cp.sc_a, fi));
    let sn = w(u32_at(in cp.sc_n, fi));
    let mut scope_at = ChunkSeq::with_capacity[u32](sn);
    let mut scope_len = ChunkSeq::with_capacity[u32](sn);
    for i in 0..sn {
        scope_at.push(u32_at(in cp.scope_at, add(sa, i)));
        scope_len.push(u32_at(in cp.scope_len, add(sa, i)));
    }
    let ma = w(u32_at(in cp.sm_a, fi));
    let mn = w(u32_at(in cp.sm_n, fi));
    let mut scope_models = ChunkSeq::with_capacity[u32](mn);
    for i in 0..mn {
        scope_models.push(u32_at(in cp.scope_models, add(ma, i)));
    }
    CxHeader {
        env_params: env_params,
        assumptions: assumptions,
        args: args,
        scope_at: scope_at,
        scope_len: scope_len,
        scope_models: scope_models
    }
}

pub fn get_call_cx(in cp: CxPool, in m: MonoTables, fi: u64, cidx: u64) -> CxHeader {
    let base = get_cx(in cp, fi);
    let sa = w(u32_at(in m.call_sc_a, cidx));
    let sn = w(u32_at(in m.call_sc_n, cidx));
    let mut scope_at = ChunkSeq::with_capacity[u32](sn);
    let mut scope_len = ChunkSeq::with_capacity[u32](sn);
    for i in 0..sn {
        scope_at.push(u32_at(in m.call_scope_at, add(sa, i)));
        scope_len.push(u32_at(in m.call_scope_len, add(sa, i)));
    }
    let ma = w(u32_at(in m.call_sm_a, cidx));
    let mn = w(u32_at(in m.call_sm_n, cidx));
    let mut scope_models = ChunkSeq::with_capacity[u32](mn);
    for i in 0..mn {
        scope_models.push(u32_at(in m.call_scope_models, add(ma, i)));
    }
    CxHeader {
        env_params: base.env_params,
        assumptions: base.assumptions,
        args: base.args,
        scope_at: scope_at,
        scope_len: scope_len,
        scope_models: scope_models
    }
}

pub fn close_bounded(in t: Types, in names: Names, in m: MonoTables, inout errors: MonoDiags)
    -> ChunkSeq[u8] {
    let nf = m.fn_names.len();
    let mut bounded = ChunkSeq::with_capacity[u8](nf);
    for fi in 0..nf {
        let is_b = u32_at(in m.fn_bn, fi) > 0 || u8_at(in m.fn_is_stub, fi) != 0;
        bounded
            .push(
                if is_b {
                    1
                } else {
                    0
                }
            );
    }
    loop {
        let mut changed = false;
        let mut to_add = ChunkSeq::new[u32]();
        for fi in 0..nf {
            if u8_at(in bounded, fi) != 0 || u32_at(in m.fn_gn, fi) == 0 {
                continue;
            }
            let ga = w(u32_at(in m.fn_ga, fi));
            let gn = w(u32_at(in m.fn_gn, fi));
            let ca = w(u32_at(in m.fn_ca, fi));
            let cn = w(u32_at(in m.fn_cn, fi));
            let mut open = false;
            for ci in 0..cn {
                let cidx = add(ca, ci);
                let callee = w(u32_at(in m.call_callee, cidx));
                if u8_at(in bounded, callee) == 0 {
                    continue;
                }
                let va = w(u32_at(in m.call_va, cidx));
                let vn = w(u32_at(in m.call_vn, cidx));
                for vi in 0..vn {
                    let vidx = add(va, vi);
                    let vname = u32_at(in m.call_vname, vidx);
                    if is_dyn_generic(in names, vname) {
                        continue;
                    }
                    let vty = u32_at(in m.call_vty, vidx);
                    for gi in 0..gn {
                        let gname = u32_at(in m.gen_names, add(ga, gi));
                        if !is_dyn_generic(in names, gname) && mentions(in t, vty, gname) {
                            open = true;
                            break;
                        }
                    }
                    if open {
                        break;
                    }
                }
                if open {
                    break;
                }
            }
            if open {
                to_add.push(n32(fi));
                changed = true;
            }
        }
        if !changed {
            break;
        }
        for i in 0..to_add.len() {
            let _ok = bounded.try_set(w(u32_at(in to_add, i)), 1);
        }
    }
    for fi in 0..nf {
        let fa = w(u32_at(in m.fn_fa, fi));
        let fn_cnt = w(u32_at(in m.fn_fn, fi));
        for ui in 0..fn_cnt {
            let uidx = add(fa, ui);
            let target = w(u32_at(in m.fval_target, uidx));
            if u8_at(in bounded, target) != 0 {
                let tname = u32_at(in m.fn_names, target);
                let mut msg = ChunkSeq::new[u8]();
                msg.push(39);
                put_sym_bytes(in names, tname, inout msg);
                put_str(
                    inout msg,
                    "' has trait-bounded type parameters and cannot be used as a function value; call it directly (dictionary passing is not supported)"
                );
                push_diag(
                    inout errors,
                    CODE_E0607,
                    u64_at(in m.fval_s, uidx),
                    u64_at(in m.fval_e, uidx),
                    in msg
                );
            }
        }
    }
    bounded
}

fn fn_mentions_generic(in t: Types, in m: MonoTables, fi: u64, ty: u32) -> bool {
    let ga = w(u32_at(in m.fn_ga, fi));
    let gn = w(u32_at(in m.fn_gn, fi));
    for gi in 0..gn {
        let gname = u32_at(in m.gen_names, add(ga, gi));
        if mentions(in t, ty, gname) {
            return true;
        }
    }
    false
}

fn check_one_obligation(
    inout sess: PactSession,
    in m: MonoTables,
    in cx: CxHeader,
    fi: u64,
    trait_name: u32,
    ty: u32,
    in args: Slice[u32],
    s: u64,
    e: u64,
    in what: ChunkSeq[u8],
    inout errors: MonoDiags
) {
    let res = select_in_cx(inout sess, in cx, trait_name, ty, 0, in args);
    if res.status == ST_OK || (res.status == ST_ERR && res.val == 5) {
        return;
    }
    let mut tb = ChunkSeq::new[u8]();
    put_sym_bytes(in sess.c.names, trait_name, inout tb);
    let (raw_code, raw_msg) = failure_msg(
        in sess.c.types,
        in sess.c.names,
        in tb.as_slice(),
        trait_name,
        ty,
        res.val,
        in res.msg.as_slice()
    );
    let generic = fn_mentions_generic(in sess.c.types, in m, fi, ty);
    let mut code = raw_code;
    let mut msg = ChunkSeq::new[u8]();
    put_bytes(inout msg, in what.as_slice());
    put_str(inout msg, ": ");
    put_bytes(inout msg, in raw_msg.as_slice());
    if generic && (code == CODE_E0607 || code == CODE_E0608) {
        code = CODE_E0608;
        put_str(inout msg, "; add the bound `");
        display(in sess.c.types, in sess.c.names, ty, inout msg);
        put_str(inout msg, ": ");
        put_sym_bytes(in sess.c.names, trait_name, inout msg);
        put_str(inout msg, "` to '");
        put_sym_bytes(in sess.c.names, u32_at(in m.fn_names, fi), inout msg);
        msg.push(39);
    }
    push_unique_diag(inout errors, code, s, e, in msg);
}

fn check_type_obligations(
    inout sess: PactSession,
    in m: MonoTables,
    in cp: CxPool,
    fi: u64,
    ty: u32,
    inout errors: MonoDiags
) {
    let n = node_at(in sess.c.types, ty);
    if n.kind == K_NAMED {
        let aa = w(n.a);
        let an = w(n.n);
        for i in 0..an {
            let child = u32_at(in sess.c.types.items, add(aa, i));
            check_type_obligations(inout sess, in m, in cp, fi, child, inout errors);
        }
        let tb_idx = find_tb_idx(in m, n.name);
        if tb_idx == NONE64 {
            return;
        }
        let mut vars = vars_new();
        let adt_idx = find_adt_idx(in m, n.name);
        if adt_idx != NONE64 {
            let ga = w(u32_at(in m.adt_ga, adt_idx));
            let gn = w(u32_at(in m.adt_gn, adt_idx));
            let limit = if gn < an {
                gn
            } else {
                an
            };
            for gi in 0..limit {
                vars
                    .set(
                        u32_at(in m.adt_gen_names, add(ga, gi)),
                        u32_at(in sess.c.types.items, add(aa, gi))
                    );
            }
        }
        let ea = w(u32_at(in m.tb_ea, tb_idx));
        let en = w(u32_at(in m.tb_en, tb_idx));
        let fs = u64_at(in m.fn_s, fi);
        let fe = u64_at(in m.fn_e, fi);
        for ei in 0..en {
            let eidx = add(ea, ei);
            let pidx = w(u32_at(in m.tb_param_idx, eidx));
            if pidx >= an {
                continue;
            }
            let raw_arg = u32_at(in sess.c.types.items, add(aa, pidx));
            let arg = default_type(inout sess.c.types, raw_arg);
            if !closed(in sess.c.types, arg) {
                continue;
            }
            let tname = u32_at(in m.tb_trait, eidx);
            let mut what = ChunkSeq::new[u8]();
            put_str(inout what, "type '");
            display(in sess.c.types, in sess.c.names, ty, inout what);
            put_str(inout what, "' requires ");
            display(in sess.c.types, in sess.c.names, arg, inout what);
            put_str(inout what, ": ");
            put_sym_bytes(in sess.c.names, tname, inout what);
            let baa = w(u32_at(in m.tb_aa, eidx));
            let ban = w(u32_at(in m.tb_an, eidx));
            let mut targs = ChunkSeq::with_capacity[u32](ban);
            for ai in 0..ban {
                let raw_ta = u32_at(in m.tb_args, add(baa, ai));
                targs.push(substitute(inout sess.c.types, raw_ta, in vars));
            }
            let cx = get_cx(in cp, fi);
            check_one_obligation(
                inout sess,
                in m,
                in cx,
                fi,
                tname,
                arg,
                in targs.as_slice(),
                fs,
                fe,
                in what,
                inout errors
            );
        }
        return;
    }
    if n.kind == K_TUPLE {
        let aa = w(n.a);
        let an = w(n.n);
        for i in 0..an {
            let child = u32_at(in sess.c.types.items, add(aa, i));
            check_type_obligations(inout sess, in m, in cp, fi, child, inout errors);
        }
        return;
    }
    if n.kind == K_FN {
        let aa = w(n.a);
        let an = w(n.n);
        for i in 0..an {
            let child = u32_at(in sess.c.types.items, add(aa, i));
            check_type_obligations(inout sess, in m, in cp, fi, child, inout errors);
        }
        check_type_obligations(inout sess, in m, in cp, fi, n.r, inout errors);
    }
}

pub fn check_obligations(
    inout sess: PactSession,
    in m: MonoTables,
    in cp: CxPool,
    inout errors: MonoDiags
) {
    let nf = m.fn_names.len();
    for fi in 0..nf {
        if u8_at(in m.fn_is_stub, fi) != 0 {
            continue;
        }
        let ca = w(u32_at(in m.fn_ca, fi));
        let cn = w(u32_at(in m.fn_cn, fi));
        for ci in 0..cn {
            let cidx = add(ca, ci);
            let cs = u64_at(in m.call_s, cidx);
            let ce = u64_at(in m.call_e, cidx);
            let callee = w(u32_at(in m.call_callee, cidx));
            let va = w(u32_at(in m.call_va, cidx));
            let vn = w(u32_at(in m.call_vn, cidx));
            let mut vars = vars_new();
            for vi in 0..vn {
                let vidx = add(va, vi);
                let vname = u32_at(in m.call_vname, vidx);
                let vty = default_type(inout sess.c.types, u32_at(in m.call_vty, vidx));
                vars.set(vname, vty);
            }
            let ba = w(u32_at(in m.fn_ba, callee));
            let bn = w(u32_at(in m.fn_bn, callee));
            for bi in 0..bn {
                let bidx = add(ba, bi);
                let tname = u32_at(in m.bnd_trait, bidx);
                let ty = substitute(inout sess.c.types, u32_at(in m.bnd_ty, bidx), in vars);
                let baa = w(u32_at(in m.bnd_aa, bidx));
                let ban = w(u32_at(in m.bnd_an, bidx));
                let mut args = ChunkSeq::with_capacity[u32](ban);
                for ai in 0..ban {
                    let raw_a = u32_at(in m.bnd_args, add(baa, ai));
                    args.push(substitute(inout sess.c.types, raw_a, in vars));
                }
                let mut what = ChunkSeq::new[u8]();
                what.push(39);
                put_sym_bytes(in sess.c.names, u32_at(in m.fn_names, callee), inout what);
                put_str(inout what, "' requires ");
                display(in sess.c.types, in sess.c.names, ty, inout what);
                put_str(inout what, ": ");
                put_sym_bytes(in sess.c.names, tname, inout what);
                if !closed(in sess.c.types, ty) {
                    put_str(
                        inout what,
                        ", but the type argument cannot be inferred; annotate the arguments"
                    );
                    push_diag(inout errors, CODE_E0607, cs, ce, in what);
                    continue;
                }
                let cx = get_call_cx(in cp, in m, fi, cidx);
                check_one_obligation(
                    inout sess,
                    in m,
                    in cx,
                    fi,
                    tname,
                    ty,
                    in args.as_slice(),
                    cs,
                    ce,
                    in what,
                    inout errors
                );
            }
        }
        let ta = w(u32_at(in m.fn_ta, fi));
        let tn = w(u32_at(in m.fn_tn, fi));
        for ti in 0..tn {
            let ty = u32_at(in m.walk_tys, add(ta, ti));
            check_type_obligations(inout sess, in m, in cp, fi, ty, inout errors);
        }
    }
}

pub fn read_mono_tables(
    inout r: Reader,
    in b: Slice[u8],
    inout sess: PactSession,
    in nmap: ChunkSeq[u32],
    in tmap: ChunkSeq[u32]
) -> (MonoTables, CxPool) {
    let n_adts = r.word(in b);
    let mut adt_names = ChunkSeq::with_capacity[u32](n_adts);
    let mut adt_ga = ChunkSeq::with_capacity[u32](n_adts);
    let mut adt_gn = ChunkSeq::with_capacity[u32](n_adts);
    let mut adt_gen_names = ChunkSeq::new[u32]();
    for _ in 0..n_adts {
        adt_names.push(sym(in nmap, r.word(in b)));
        adt_ga.push(n32(adt_gen_names.len()));
        let gn = r.word(in b);
        adt_gn.push(n32(gn));
        for _ in 0..gn {
            adt_gen_names.push(sym(in nmap, r.word(in b)));
        }
    }

    let n_tb = r.word(in b);
    let mut tb_adt_names = ChunkSeq::with_capacity[u32](n_tb);
    let mut tb_ea = ChunkSeq::with_capacity[u32](n_tb);
    let mut tb_en = ChunkSeq::with_capacity[u32](n_tb);
    let mut tb_param_idx = ChunkSeq::new[u32]();
    let mut tb_trait = ChunkSeq::new[u32]();
    let mut tb_aa = ChunkSeq::new[u32]();
    let mut tb_an = ChunkSeq::new[u32]();
    let mut tb_args = ChunkSeq::new[u32]();
    for _ in 0..n_tb {
        tb_adt_names.push(sym(in nmap, r.word(in b)));
        tb_ea.push(n32(tb_param_idx.len()));
        let en = r.word(in b);
        tb_en.push(n32(en));
        for _ in 0..en {
            tb_param_idx.push(n32(r.word(in b)));
            tb_trait.push(sym(in nmap, r.word(in b)));
            tb_aa.push(n32(tb_args.len()));
            let an = r.word(in b);
            tb_an.push(n32(an));
            for _ in 0..an {
                tb_args.push(u32_at(in tmap, r.word(in b)));
            }
        }
    }

    let nf = r.word(in b);
    let mut fn_names = ChunkSeq::with_capacity[u32](nf);
    let mut fn_is_stub = ChunkSeq::with_capacity[u8](nf);
    let mut fn_s = ChunkSeq::with_capacity[u64](nf);
    let mut fn_e = ChunkSeq::with_capacity[u64](nf);
    let mut fn_ga = ChunkSeq::with_capacity[u32](nf);
    let mut fn_gn = ChunkSeq::with_capacity[u32](nf);
    let mut gen_names = ChunkSeq::new[u32]();
    let mut fn_ba = ChunkSeq::with_capacity[u32](nf);
    let mut fn_bn = ChunkSeq::with_capacity[u32](nf);
    let mut bnd_trait = ChunkSeq::new[u32]();
    let mut bnd_ty = ChunkSeq::new[u32]();
    let mut bnd_aa = ChunkSeq::new[u32]();
    let mut bnd_an = ChunkSeq::new[u32]();
    let mut bnd_args = ChunkSeq::new[u32]();
    let mut fn_ca = ChunkSeq::with_capacity[u32](nf);
    let mut fn_cn = ChunkSeq::with_capacity[u32](nf);
    let mut call_s = ChunkSeq::new[u64]();
    let mut call_e = ChunkSeq::new[u64]();
    let mut call_callee = ChunkSeq::new[u32]();
    let mut call_va = ChunkSeq::new[u32]();
    let mut call_vn = ChunkSeq::new[u32]();
    let mut call_vname = ChunkSeq::new[u32]();
    let mut call_vty = ChunkSeq::new[u32]();
    let mut call_sc_a = ChunkSeq::new[u32]();
    let mut call_sc_n = ChunkSeq::new[u32]();
    let mut call_scope_at = ChunkSeq::new[u32]();
    let mut call_scope_len = ChunkSeq::new[u32]();
    let mut call_sm_a = ChunkSeq::new[u32]();
    let mut call_sm_n = ChunkSeq::new[u32]();
    let mut call_scope_models = ChunkSeq::new[u32]();
    let mut fn_fa = ChunkSeq::with_capacity[u32](nf);
    let mut fn_fn = ChunkSeq::with_capacity[u32](nf);
    let mut fval_s = ChunkSeq::new[u64]();
    let mut fval_e = ChunkSeq::new[u64]();
    let mut fval_target = ChunkSeq::new[u32]();
    let mut fn_ta = ChunkSeq::with_capacity[u32](nf);
    let mut fn_tn = ChunkSeq::with_capacity[u32](nf);
    let mut walk_tys = ChunkSeq::new[u32]();

    let mut cp_env_a = ChunkSeq::with_capacity[u32](nf);
    let mut cp_env_n = ChunkSeq::with_capacity[u32](nf);
    let mut cp_env_params = ChunkSeq::new[Gen]();
    let mut cp_ass_a = ChunkSeq::with_capacity[u32](nf);
    let mut cp_ass_n = ChunkSeq::with_capacity[u32](nf);
    let mut cp_assumptions = ChunkSeq::new[QGoal]();
    let mut cp_arg_a = ChunkSeq::with_capacity[u32](nf);
    let mut cp_arg_n = ChunkSeq::with_capacity[u32](nf);
    let mut cp_args = ChunkSeq::new[QArg]();
    let mut cp_sc_a = ChunkSeq::with_capacity[u32](nf);
    let mut cp_sc_n = ChunkSeq::with_capacity[u32](nf);
    let mut cp_scope_at = ChunkSeq::new[u32]();
    let mut cp_scope_len = ChunkSeq::new[u32]();
    let mut cp_sm_a = ChunkSeq::with_capacity[u32](nf);
    let mut cp_sm_n = ChunkSeq::with_capacity[u32](nf);
    let mut cp_scope_models = ChunkSeq::new[u32]();

    for _ in 0..nf {
        let fname = sym(in nmap, r.word(in b));
        fn_names.push(fname);
        fn_is_stub
            .push(
                if sym_starts_with(in sess.c.names, fname, "bound$") {
                    1
                } else {
                    0
                }
            );
        fn_s.push(r.word(in b));
        fn_e.push(r.word(in b));

        let cx = read_cx_header(inout r, in b, inout sess, in nmap, in tmap, fname);
        fn_ga.push(n32(gen_names.len()));
        fn_gn.push(n32(cx.env_params.len()));
        cp_env_a.push(n32(cp_env_params.len()));
        cp_env_n.push(n32(cx.env_params.len()));
        for gi in 0..cx.env_params.len() {
            let g = match cx.env_params.try_get(gi) {
                Option::Some(v) => v,
                Option::None => continue,
            };
            gen_names.push(g.name);
            cp_env_params.push(g);
        }
        cp_ass_a.push(n32(cp_assumptions.len()));
        cp_ass_n.push(n32(cx.assumptions.len()));
        cp_assumptions.extend(in cx.assumptions.as_slice());
        cp_arg_a.push(n32(cp_args.len()));
        cp_arg_n.push(n32(cx.args.len()));
        cp_args.extend(in cx.args.as_slice());
        cp_sc_a.push(n32(cp_scope_at.len()));
        cp_sc_n.push(n32(cx.scope_at.len()));
        cp_scope_at.extend(in cx.scope_at.as_slice());
        cp_scope_len.extend(in cx.scope_len.as_slice());
        cp_sm_a.push(n32(cp_scope_models.len()));
        cp_sm_n.push(n32(cx.scope_models.len()));
        cp_scope_models.extend(in cx.scope_models.as_slice());

        fn_ba.push(n32(bnd_trait.len()));
        let bn = r.word(in b);
        fn_bn.push(n32(bn));
        for _ in 0..bn {
            bnd_trait.push(sym(in nmap, r.word(in b)));
            bnd_ty.push(u32_at(in tmap, r.word(in b)));
            bnd_aa.push(n32(bnd_args.len()));
            let an = r.word(in b);
            bnd_an.push(n32(an));
            for _ in 0..an {
                bnd_args.push(u32_at(in tmap, r.word(in b)));
            }
        }

        fn_ca.push(n32(call_s.len()));
        let cn = r.word(in b);
        fn_cn.push(n32(cn));
        for _ in 0..cn {
            call_s.push(r.word(in b));
            call_e.push(r.word(in b));
            call_callee.push(n32(r.word(in b)));
            call_va.push(n32(call_vname.len()));
            let vn = r.word(in b);
            call_vn.push(n32(vn));
            for _ in 0..vn {
                call_vname.push(sym(in nmap, r.word(in b)));
                call_vty.push(u32_at(in tmap, r.word(in b)));
            }
            call_sc_a.push(n32(call_scope_at.len()));
            let cns = r.word(in b);
            call_sc_n.push(n32(cns));
            call_sm_a.push(n32(call_scope_models.len()));
            let sm_start = call_scope_models.len();
            for _ in 0..cns {
                call_scope_at.push(n32(wrapping_sub(call_scope_models.len(), sm_start)));
                let sl = r.word(in b);
                call_scope_len.push(n32(sl));
                for _ in 0..sl {
                    call_scope_models.push(sym(in nmap, r.word(in b)));
                }
            }
            call_sm_n.push(n32(wrapping_sub(call_scope_models.len(), sm_start)));
        }

        fn_fa.push(n32(fval_s.len()));
        let fn_cnt = r.word(in b);
        fn_fn.push(n32(fn_cnt));
        for _ in 0..fn_cnt {
            fval_s.push(r.word(in b));
            fval_e.push(r.word(in b));
            fval_target.push(n32(r.word(in b)));
        }

        fn_ta.push(n32(walk_tys.len()));
        let tn = r.word(in b);
        fn_tn.push(n32(tn));
        for _ in 0..tn {
            walk_tys.push(u32_at(in tmap, r.word(in b)));
        }
    }

    (
        MonoTables {
            adt_names: adt_names,
            adt_ga: adt_ga,
            adt_gn: adt_gn,
            adt_gen_names: adt_gen_names,
            tb_adt_names: tb_adt_names,
            tb_ea: tb_ea,
            tb_en: tb_en,
            tb_param_idx: tb_param_idx,
            tb_trait: tb_trait,
            tb_aa: tb_aa,
            tb_an: tb_an,
            tb_args: tb_args,
            fn_names: fn_names,
            fn_is_stub: fn_is_stub,
            fn_s: fn_s,
            fn_e: fn_e,
            fn_ga: fn_ga,
            fn_gn: fn_gn,
            gen_names: gen_names,
            fn_ba: fn_ba,
            fn_bn: fn_bn,
            bnd_trait: bnd_trait,
            bnd_ty: bnd_ty,
            bnd_aa: bnd_aa,
            bnd_an: bnd_an,
            bnd_args: bnd_args,
            fn_ca: fn_ca,
            fn_cn: fn_cn,
            call_s: call_s,
            call_e: call_e,
            call_callee: call_callee,
            call_va: call_va,
            call_vn: call_vn,
            call_vname: call_vname,
            call_vty: call_vty,
            call_sc_a: call_sc_a,
            call_sc_n: call_sc_n,
            call_scope_at: call_scope_at,
            call_scope_len: call_scope_len,
            call_sm_a: call_sm_a,
            call_sm_n: call_sm_n,
            call_scope_models: call_scope_models,
            fn_fa: fn_fa,
            fn_fn: fn_fn,
            fval_s: fval_s,
            fval_e: fval_e,
            fval_target: fval_target,
            fn_ta: fn_ta,
            fn_tn: fn_tn,
            walk_tys: walk_tys
        },
        CxPool {
            env_a: cp_env_a,
            env_n: cp_env_n,
            env_params: cp_env_params,
            ass_a: cp_ass_a,
            ass_n: cp_ass_n,
            assumptions: cp_assumptions,
            arg_a: cp_arg_a,
            arg_n: cp_arg_n,
            args: cp_args,
            sc_a: cp_sc_a,
            sc_n: cp_sc_n,
            scope_at: cp_scope_at,
            scope_len: cp_scope_len,
            sm_a: cp_sm_a,
            sm_n: cp_sm_n,
            scope_models: cp_scope_models
        }
    )
}

fn mono_check_body(
    inout sess: PactSession,
    inout r: Reader,
    in b: Slice[u8],
    inout out: ChunkSeq[u64]
) {
    let mut nmap = ChunkSeq::new[u32]();
    read_q_names(inout r, in b, inout sess.c.names, inout nmap);
    let mut tmap = ChunkSeq::new[u32]();
    read_q_types(inout r, in b, inout sess.c, in nmap, inout tmap);
    let (m, cp) = read_mono_tables(inout r, in b, inout sess, in nmap, in tmap);
    let mut errors = diags_new();
    let bounded = close_bounded(in sess.c.types, in sess.c.names, in m, inout errors);
    check_obligations(inout sess, in m, in cp, inout errors);
    out.push(bounded.len());
    for i in 0..bounded.len() {
        out
            .push(
                if u8_at(in bounded, i) != 0 {
                    1
                } else {
                    0
                }
            );
    }
    out.push(errors.codes.len());
    for i in 0..errors.codes.len() {
        let c = u8_at(in errors.codes, i);
        out
            .push(
                if c == 1 {
                    1
                } else if c == 2 {
                    2
                } else if c == 3 {
                    3
                } else {
                    0
                }
            );
        out.push(u64_at(in errors.s, i));
        out.push(u64_at(in errors.e, i));
        let ma = w(u32_at(in errors.msg_a, i));
        let mn = w(u32_at(in errors.msg_n, i));
        let mut msg = ChunkSeq::with_capacity[u8](mn);
        for j in 0..mn {
            msg.push(u8_at(in errors.msg_bytes, add(ma, j)));
        }
        let pmsg = pack_text(in msg);
        out.extend(in pmsg.as_slice());
    }
}

// Entrypoint for an already-open `PactSession`: `[mono_input]`.
pub fn session_mono_check_words(inout sess: PactSession, in b: Slice[u8]) -> ChunkSeq[u64] {
    let mut r = Reader { pos: 0 };
    let mut out = ChunkSeq::new[u64]();
    out.push(0);
    out.push(1);
    mono_check_body(inout sess, inout r, in b, inout out);
    out
}

// Entrypoint for `check_pact_mono_check`: `[session_input][mono_input]`.
pub fn mono_check_words(in b: Slice[u8]) -> ChunkSeq[u64] {
    let mut r = Reader { pos: 0 };
    let mut sess = session_open_reader(inout r, in b);
    let mut out = ChunkSeq::new[u64]();
    let p_out = pack_text(in sess.out);
    out.extend(in p_out.as_slice());
    if !sess.ok {
        out.push(0);
        return out;
    }
    out.push(1);
    mono_check_body(inout sess, inout r, in b, inout out);
    out
}
