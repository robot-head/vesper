// Builtin `Eq`, `Ord`, and `Hash` trait derivation (`builtin_traits::derivable`
// and derived `impl` source generation) for `@vesper/check-pact`
// (SH2 lane 13 part 4, #1617).

use @vesper/check-data::input::{Ctx, Reader, read_ctx};
use @vesper/check-data::names::{Names, names_new};
use @vesper/check-data::{pack_text};
use @vesper/check-data::types::{TyKind, TyMode, TypeNode, Types, display};

const K_FN: u8 = TyKind::Fn;
const K_NAMED: u8 = TyKind::Named;
const K_ROW: u8 = TyKind::Row;
const K_TUPLE: u8 = TyKind::Tuple;
const M_AFFINE: u8 = TyMode::Affine;
const M_COPY: u8 = TyMode::Copy;
const M_LINEAR: u8 = TyMode::Linear;
use @vesper/check-data::util::{add, n32, u32_at, u64_at, u8_at, w};
use self::session_input::{put_num, put_str, put_sym, read_q_names, read_q_types, sym};

const NONE32: u32 = 4294967295;
const NONE64: u64 = 18446744073709551615;

const OFFSET_STR: Str = "14695981039346656037";
const HASH_MIX: Str = "vesper_builtin_hash_mix";

copy struct StructInfo {
    pub name: u32,
    pub mode: u8,
    pub is_enum: bool,
    pub has_row_gen: bool,
    pub gen_start: u32,
    pub gen_count: u32,
    pub field_start: u32,
    pub field_count: u32,
}

copy struct ConfInfo {
    pub is_canonical: bool,
    pub pkg_none: bool,
    pub trait_name: u32,
    pub targ_count: u64,
    pub self_ty: u32,
    pub gen_start: u32,
    pub gen_count: u32,
    pub has_where: bool,
    pub empty_body: bool,
    pub span_start: u64,
    pub span_end: u64,
}

copy struct OwnBound {
    pub owner: u32,
    pub param: u32,
    pub trait_name: u32,
    pub arg_start: u32,
    pub arg_count: u32,
}

struct BuiltinMod {
    pub ctx: Ctx,
    pub gen_names: ChunkSeq[u32],
    pub gen_bounds: ChunkSeq[u8],
    pub field_names: ChunkSeq[u32],
    pub field_tys: ChunkSeq[u32],
    pub structs: ChunkSeq[StructInfo],
    pub confs: ChunkSeq[ConfInfo],
    pub own_bounds: ChunkSeq[OwnBound],
    pub bound_args: ChunkSeq[u32],
}

fn struct_at(in module: BuiltinMod, i: u64) -> StructInfo {
    match module.structs.try_get(i) {
        Option::Some(v) => v,
        Option::None => StructInfo {
            name: 0,
            mode: 0,
            is_enum: true,
            has_row_gen: false,
            gen_start: 0,
            gen_count: 0,
            field_start: 0,
            field_count: 0
        },
    }
}

fn conf_at(in module: BuiltinMod, i: u64) -> ConfInfo {
    match module.confs.try_get(i) {
        Option::Some(v) => v,
        Option::None => ConfInfo {
            is_canonical: false,
            pkg_none: false,
            trait_name: 0,
            targ_count: 0,
            self_ty: 0,
            gen_start: 0,
            gen_count: 0,
            has_where: false,
            empty_body: false,
            span_start: 0,
            span_end: 0
        },
    }
}

fn own_at(in module: BuiltinMod, i: u64) -> OwnBound {
    match module.own_bounds.try_get(i) {
        Option::Some(v) => v,
        Option::None => OwnBound { owner: 0, param: 0, trait_name: 0, arg_start: 0, arg_count: 0 },
    }
}

fn node_at(in types: Types, ty: u32) -> TypeNode {
    match types.nodes.try_get(w(ty)) {
        Option::Some(v) => v,
        Option::None => TypeNode { kind: 0, mode: 0, name: 0, a: 0, n: 0, r: 0, r2: 0, lit: 0 },
    }
}

fn is_builtin_trait(in names: Names, symbol: u32) -> bool {
    names.spells(symbol, in "Eq".as_bytes())
        || names.spells(symbol, in "Ord".as_bytes())
        || names.spells(symbol, in "Hash".as_bytes())
}

fn is_scalar(in names: Names, symbol: u32) -> bool {
    names.spells(symbol, in "u8".as_bytes())
        || names.spells(symbol, in "u32".as_bytes())
        || names.spells(symbol, in "u64".as_bytes())
        || names.spells(symbol, in "i64".as_bytes())
        || names.spells(symbol, in "bool".as_bytes())
}

fn is_request(in names: Names, conf: ConfInfo) -> bool {
    conf.is_canonical
        && conf.pkg_none
        && is_builtin_trait(in names, conf.trait_name)
        && conf.targ_count == 0
        && conf.empty_body
}

fn find_derivable_struct(in module: BuiltinMod, name: u32) -> u64 {
    for i in 0..module.structs.len() {
        let struct_info = struct_at(in module, i);
        if !struct_info.is_enum && !struct_info.has_row_gen && struct_info.name == name {
            return i;
        }
    }
    NONE64
}

fn mentions_name(in types: Types, ty: u32, name: u32) -> bool {
    let node = node_at(in types, ty);
    if node.kind == K_NAMED {
        if node.name == name {
            return true;
        }
        for i in 0..w(node.n) {
            if mentions_name(in types, u32_at(in types.items, add(w(node.a), i)), name) {
                return true;
            }
        }
        return false;
    }
    if node.kind == K_TUPLE {
        for i in 0..w(node.n) {
            if mentions_name(in types, u32_at(in types.items, add(w(node.a), i)), name) {
                return true;
            }
        }
        return false;
    }
    node.kind == K_FN || node.kind == K_ROW
}

fn same_type_bt(in types: Types, a: u32, b: u32) -> bool {
    if a == b {
        return true;
    }
    let a_node = node_at(in types, a);
    let b_node = node_at(in types, b);
    if a_node.kind != b_node.kind {
        return false;
    }
    if a_node.kind == K_NAMED {
        if a_node.name != b_node.name || a_node.n != b_node.n {
            return false;
        }
        for i in 0..w(a_node.n) {
            if !same_type_bt(
                in types,
                u32_at(in types.items, add(w(a_node.a), i)),
                u32_at(in types.items, add(w(b_node.a), i))
            ) {
                return false;
            }
        }
        return true;
    }
    if a_node.kind == K_TUPLE {
        if a_node.n != b_node.n {
            return false;
        }
        for i in 0..w(a_node.n) {
            if !same_type_bt(
                in types,
                u32_at(in types.items, add(w(a_node.a), i)),
                u32_at(in types.items, add(w(b_node.a), i))
            ) {
                return false;
            }
        }
        return true;
    }
    false
}

fn param_index(in module: BuiltinMod, gen_start: u32, gen_count: u32, name: u32) -> u64 {
    for i in 0..w(gen_count) {
        if u32_at(in module.gen_names, add(w(gen_start), i)) == name {
            return i;
        }
    }
    NONE64
}

fn copy_type(in module: BuiltinMod, ty: u32, gen_start: u32, gen_count: u32) -> bool {
    let node = node_at(in module.ctx.types, ty);
    if node.kind == K_NAMED && node.n == 0 {
        let param_pos = param_index(in module, gen_start, gen_count, node.name);
        if param_pos != NONE64 {
            return u8_at(in module.gen_bounds, add(w(gen_start), param_pos)) == M_COPY;
        }
    }
    if node.kind == K_NAMED && is_scalar(in module.ctx.names, node.name) {
        return true;
    }
    if node.kind == K_TUPLE {
        for i in 0..w(node.n) {
            if !copy_type(
                in module,
                u32_at(in module.ctx.types.items, add(w(node.a), i)),
                gen_start,
                gen_count
            ) {
                return false;
            }
        }
        return true;
    }
    if node.kind == K_NAMED {
        let struct_idx = find_derivable_struct(in module, node.name);
        if struct_idx != NONE64 {
            return struct_at(in module, struct_idx).mode == M_COPY;
        }
    }
    false
}

fn user_impl_covers(in module: BuiltinMod, trait_name: u32, ty: u32) -> bool {
    let ty_node = node_at(in module.ctx.types, ty);
    for i in 0..module.confs.len() {
        let conf = conf_at(in module, i);
        if !conf.is_canonical || !conf.pkg_none || is_request(in module.ctx.names, conf) {
            continue;
        }
        if conf.trait_name != trait_name {
            continue;
        }
        let self_node = node_at(in module.ctx.types, conf.self_ty);
        if self_node.kind == K_NAMED && ty_node.kind == K_NAMED && self_node.name == ty_node.name {
            let mut all_params = true;
            for ai in 0..w(self_node.n) {
                let arg_ty = u32_at(in module.ctx.types.items, add(w(self_node.a), ai));
                let arg_node = node_at(in module.ctx.types, arg_ty);
                if !(
                    arg_node.kind == K_NAMED
                        && arg_node.n == 0
                        && param_index(in module, conf.gen_start, conf.gen_count, arg_node.name)
                            != NONE64
                ) {
                    all_params = false;
                    break;
                }
            }
            if all_params || same_type_bt(in module.ctx.types, conf.self_ty, ty) {
                return true;
            }
        } else if same_type_bt(in module.ctx.types, conf.self_ty, ty) {
            return true;
        }
    }
    false
}

fn has_request(
    in req_trait: ChunkSeq[u32],
    in req_struct: ChunkSeq[u32],
    trait_name: u32,
    struct_name: u32
) -> bool {
    for i in 0..req_trait.len() {
        if u32_at(in req_trait, i) == trait_name && u32_at(in req_struct, i) == struct_name {
            return true;
        }
    }
    false
}

// `memo_state`: 0 = unvisited, 1 = false (including active cycle), 2 = true.
fn struct_conforms(
    in module: BuiltinMod,
    struct_idx: u64,
    trait_name: u32,
    in req_trait: ChunkSeq[u32],
    in req_struct: ChunkSeq[u32],
    inout memo_state: ChunkSeq[u8]
) -> bool {
    let memo = u8_at(in memo_state, struct_idx);
    if memo != 0 {
        return memo == 2;
    }
    let _ = memo_state.try_set(struct_idx, 1);
    let struct_info = struct_at(in module, struct_idx);
    let mut ok = true;
    for fi in 0..w(struct_info.field_count) {
        let field_ty = u32_at(in module.field_tys, add(w(struct_info.field_start), fi));
        if !type_conforms(
            in module,
            field_ty,
            trait_name,
            struct_info.gen_start,
            struct_info.gen_count,
            in req_trait,
            in req_struct,
            inout memo_state
        ) {
            ok = false;
            break;
        }
    }
    let _ = memo_state.try_set(struct_idx, if ok { 2 } else { 1 });
    ok
}

fn type_conforms(
    in module: BuiltinMod,
    ty: u32,
    trait_name: u32,
    gen_start: u32,
    gen_count: u32,
    in req_trait: ChunkSeq[u32],
    in req_struct: ChunkSeq[u32],
    inout memo_state: ChunkSeq[u8]
) -> bool {
    let node = node_at(in module.ctx.types, ty);
    if node.kind == K_NAMED && node.n == 0 {
        if param_index(in module, gen_start, gen_count, node.name) != NONE64 {
            return true;
        }
        if is_scalar(in module.ctx.names, node.name) {
            return true;
        }
    }
    if node.kind == K_TUPLE {
        if !(node.n == 0 || (w(node.n) >= 2 && w(node.n) <= 4)) {
            return false;
        }
        for i in 0..w(node.n) {
            let elem_ty = u32_at(in module.ctx.types.items, add(w(node.a), i));
            if !copy_type(in module, elem_ty, gen_start, gen_count)
                || !type_conforms(
                    in module,
                    elem_ty,
                    trait_name,
                    gen_start,
                    gen_count,
                    in req_trait,
                    in req_struct,
                    inout memo_state
                ) {
                return false;
            }
        }
        return true;
    }
    if node.kind == K_NAMED {
        if user_impl_covers(in module, trait_name, ty) {
            return true;
        }
        let struct_idx = find_derivable_struct(in module, node.name);
        if struct_idx == NONE64 {
            return false;
        }
        if !has_request(in req_trait, in req_struct, trait_name, node.name) {
            return false;
        }
        if !struct_conforms(
            in module,
            struct_idx,
            trait_name,
            in req_trait,
            in req_struct,
            inout memo_state
        ) {
            return false;
        }
        let target = struct_at(in module, struct_idx);
        let limit = if w(target.gen_count) < w(node.n) {
            w(target.gen_count)
        } else {
            w(node.n)
        };
        for gi in 0..limit {
            let gen_name = u32_at(in module.gen_names, add(w(target.gen_start), gi));
            let mut mentioned = false;
            for fi in 0..w(target.field_count) {
                if mentions_name(
                    in module.ctx.types,
                    u32_at(in module.field_tys, add(w(target.field_start), fi)),
                    gen_name
                ) {
                    mentioned = true;
                    break;
                }
            }
            if mentioned {
                let arg_ty = u32_at(in module.ctx.types.items, add(w(node.a), gi));
                if !type_conforms(
                    in module,
                    arg_ty,
                    trait_name,
                    gen_start,
                    gen_count,
                    in req_trait,
                    in req_struct,
                    inout memo_state
                ) {
                    return false;
                }
            }
        }
        return true;
    }
    false
}

fn emit_diag(
    inout out: ChunkSeq[u8],
    in code: Str,
    span_start: u64,
    span_end: u64,
    in msg: ChunkSeq[u8]
) {
    put_str(inout out, in code);
    out.push(32);
    put_num(inout out, span_start);
    out.push(32);
    put_num(inout out, span_end);
    out.push(32);
    for i in 0..msg.len() {
        let byte = u8_at(in msg, i);
        if byte == 10 {
            out.push(1);
        } else {
            out.push(byte);
        }
    }
    out.push(10);
}

fn str_eq_bytes(in lhs: Slice[u8], in rhs: Slice[u8]) -> bool {
    if lhs.len() != rhs.len() {
        return false;
    }
    for i in 0..lhs.len() {
        let lhs_byte = lhs.try_get(i).unwrap_or(0);
        let rhs_byte = rhs.try_get(i).unwrap_or(0);
        if lhs_byte != rhs_byte {
            return false;
        }
    }
    true
}

fn eq_items_contain(
    in buf: ChunkSeq[u8],
    in offs: ChunkSeq[u32],
    in lens: ChunkSeq[u32],
    in needle: Slice[u8]
) -> bool {
    for i in 0..offs.len() {
        let start = w(u32_at(in offs, i));
        let len = w(u32_at(in lens, i));
        if str_eq_bytes(in buf[start..add(start, len)], in needle) {
            return true;
        }
    }
    false
}

fn emit_derived_conformance(
    in module: BuiltinMod,
    struct_info: StructInfo,
    trait_name: u32,
    inout out: ChunkSeq[u8]
) {
    let mut ty_text = ChunkSeq::new[u8]();
    put_sym(inout ty_text, in module.ctx.names, struct_info.name);
    if struct_info.gen_count > 0 {
        ty_text.push(91);
        for gi in 0..w(struct_info.gen_count) {
            if gi > 0 {
                put_str(inout ty_text, ", ");
            }
            put_sym(
                inout ty_text,
                in module.ctx.names,
                u32_at(in module.gen_names, add(w(struct_info.gen_start), gi))
            );
        }
        ty_text.push(93);
    }

    let mut head = ChunkSeq::new[u8]();
    if struct_info.gen_count > 0 {
        head.push(91);
        for gi in 0..w(struct_info.gen_count) {
            if gi > 0 {
                put_str(inout head, ", ");
            }
            put_sym(
                inout head,
                in module.ctx.names,
                u32_at(in module.gen_names, add(w(struct_info.gen_start), gi))
            );
            let gen_bound = u8_at(in module.gen_bounds, add(w(struct_info.gen_start), gi));
            if gen_bound == M_AFFINE {
                put_str(inout head, ": mod affine");
            } else if gen_bound == M_COPY {
                put_str(inout head, ": mod copy");
            }
        }
        head.push(93);
    }

    let mut where_buf = ChunkSeq::new[u8]();
    let mut where_offs = ChunkSeq::new[u32]();
    let mut where_lens = ChunkSeq::new[u32]();

    for gi in 0..w(struct_info.gen_count) {
        let gen_name = u32_at(in module.gen_names, add(w(struct_info.gen_start), gi));
        let mut mentioned = false;
        for fi in 0..w(struct_info.field_count) {
            if mentions_name(
                in module.ctx.types,
                u32_at(in module.field_tys, add(w(struct_info.field_start), fi)),
                gen_name
            ) {
                mentioned = true;
                break;
            }
        }
        if mentioned {
            let start = n32(where_buf.len());
            put_sym(inout where_buf, in module.ctx.names, gen_name);
            put_str(inout where_buf, ": ");
            put_sym(inout where_buf, in module.ctx.names, trait_name);
            where_offs.push(start);
            where_lens.push(n32(wrapping_sub(where_buf.len(), w(start))));
        }
    }

    for oi in 0..module.own_bounds.len() {
        let own_bound = own_at(in module, oi);
        if own_bound.owner != struct_info.name {
            continue;
        }
        let mut item = ChunkSeq::new[u8]();
        put_sym(inout item, in module.ctx.names, own_bound.param);
        put_str(inout item, ": ");
        put_sym(inout item, in module.ctx.names, own_bound.trait_name);
        if own_bound.arg_count > 0 {
            item.push(91);
            for ai in 0..w(own_bound.arg_count) {
                if ai > 0 {
                    put_str(inout item, ", ");
                }
                display(
                    in module.ctx.types,
                    in module.ctx.names,
                    u32_at(in module.bound_args, add(w(own_bound.arg_start), ai)),
                    inout item
                );
            }
            item.push(93);
        }
        if !eq_items_contain(in where_buf, in where_offs, in where_lens, in item.as_slice()) {
            let start = n32(where_buf.len());
            where_buf.extend(in item.as_slice());
            where_offs.push(start);
            where_lens.push(n32(item.len()));
        }
    }

    put_str(inout out, "impl");
    out.extend(in head.as_slice());
    out.push(32);
    put_sym(inout out, in module.ctx.names, trait_name);
    put_str(inout out, " for ");
    out.extend(in ty_text.as_slice());
    if where_offs.len() > 0 {
        put_str(inout out, " where ");
        for wi in 0..where_offs.len() {
            if wi > 0 {
                put_str(inout out, ", ");
            }
            let start = w(u32_at(in where_offs, wi));
            let len = w(u32_at(in where_lens, wi));
            out.extend(in where_buf[start..add(start, len)]);
        }
    }
    put_str(inout out, " { ");

    if module.ctx.names.spells(trait_name, in "Eq".as_bytes()) {
        put_str(inout out, "fn eq(in self, in other: ");
        out.extend(in ty_text.as_slice());
        put_str(inout out, ") -> bool { ");
        let mut body = ChunkSeq::new[u8]();
        put_str(inout body, "true");
        let mut fi = w(struct_info.field_count);
        loop {
            if fi == 0 {
                break;
            }
            fi = wrapping_sub(fi, 1);
            let field_name = u32_at(in module.field_names, add(w(struct_info.field_start), fi));
            let mut next = ChunkSeq::new[u8]();
            put_str(inout next, "if Eq::eq(self.");
            put_sym(inout next, in module.ctx.names, field_name);
            put_str(inout next, ", other.");
            put_sym(inout next, in module.ctx.names, field_name);
            put_str(inout next, ") { ");
            next.extend(in body.as_slice());
            put_str(inout next, " } else { false }");
            body = next;
        }
        out.extend(in body.as_slice());
        put_str(inout out, " }");
    } else if module.ctx.names.spells(trait_name, in "Ord".as_bytes()) {
        put_str(inout out, "fn cmp(in self, in other: ");
        out.extend(in ty_text.as_slice());
        put_str(inout out, ") -> Ordering { ");
        let mut body = ChunkSeq::new[u8]();
        put_str(inout body, "Equal");
        let mut fi = w(struct_info.field_count);
        loop {
            if fi == 0 {
                break;
            }
            fi = wrapping_sub(fi, 1);
            let field_name = u32_at(in module.field_names, add(w(struct_info.field_start), fi));
            let mut next = ChunkSeq::new[u8]();
            if str_eq_bytes(in body.as_slice(), in "Equal".as_bytes()) {
                put_str(inout next, "Ord::cmp(self.");
                put_sym(inout next, in module.ctx.names, field_name);
                put_str(inout next, ", other.");
                put_sym(inout next, in module.ctx.names, field_name);
                next.push(41);
            } else {
                put_str(inout next, "match Ord::cmp(self.");
                put_sym(inout next, in module.ctx.names, field_name);
                put_str(inout next, ", other.");
                put_sym(inout next, in module.ctx.names, field_name);
                put_str(inout next, ") { Equal => ");
                next.extend(in body.as_slice());
                put_str(inout next, ", unequal => unequal }");
            }
            body = next;
        }
        out.extend(in body.as_slice());
        put_str(inout out, " }");
    } else {
        put_str(inout out, "fn hash(in self) -> u64 { ");
        let mut body = ChunkSeq::new[u8]();
        put_str(inout body, in OFFSET_STR);
        for fi in 0..w(struct_info.field_count) {
            let field_name = u32_at(in module.field_names, add(w(struct_info.field_start), fi));
            let mut next = ChunkSeq::new[u8]();
            put_str(inout next, in HASH_MIX);
            next.push(40);
            next.extend(in body.as_slice());
            put_str(inout next, ", Hash::hash(self.");
            put_sym(inout next, in module.ctx.names, field_name);
            put_str(inout next, "))");
            body = next;
        }
        out.extend(in body.as_slice());
        put_str(inout out, " }");
    }
    put_str(inout out, " }\n");
}

fn read_builtin_mod(in bytes: Slice[u8]) -> BuiltinMod {
    let mut reader = Reader { pos: 0 };
    let ctx = read_ctx(inout reader, in bytes);

    let mut gen_names = ChunkSeq::new[u32]();
    let mut gen_bounds = ChunkSeq::new[u8]();
    let mut field_names = ChunkSeq::new[u32]();
    let mut field_tys = ChunkSeq::new[u32]();

    let struct_count = reader.word(in bytes);
    let mut structs = ChunkSeq::with_capacity[StructInfo](struct_count);
    for _ in 0..struct_count {
        let struct_name = u32_at(in ctx.nmap, reader.word(in bytes));
        let struct_mode = wrapping_u8(reader.word(in bytes));
        let is_enum = reader.word(in bytes) != 0;
        let gen_start = n32(gen_names.len());
        let gen_count = reader.word(in bytes);
        let mut has_row_gen = false;
        for _ in 0..gen_count {
            gen_names.push(u32_at(in ctx.nmap, reader.word(in bytes)));
            gen_bounds.push(wrapping_u8(reader.word(in bytes)));
            if reader.word(in bytes) != 0 {
                has_row_gen = true;
            }
        }
        let field_start = n32(field_names.len());
        let field_count = reader.word(in bytes);
        for _ in 0..field_count {
            field_names.push(u32_at(in ctx.nmap, reader.word(in bytes)));
            field_tys.push(u32_at(in ctx.tmap, reader.word(in bytes)));
        }
        structs.push(
            StructInfo {
                name: struct_name,
                mode: struct_mode,
                is_enum: is_enum,
                has_row_gen: has_row_gen,
                gen_start: gen_start,
                gen_count: n32(gen_count),
                field_start: field_start,
                field_count: n32(field_count)
            }
        );
    }

    let conf_count = reader.word(in bytes);
    let mut confs = ChunkSeq::with_capacity[ConfInfo](conf_count);
    for _ in 0..conf_count {
        let is_canonical = reader.word(in bytes) != 0;
        let pkg_none = reader.word(in bytes) != 0;
        let trait_name = u32_at(in ctx.nmap, reader.word(in bytes));
        let targ_count = reader.word(in bytes);
        let self_ty = u32_at(in ctx.tmap, reader.word(in bytes));
        let gen_start = n32(gen_names.len());
        let gen_count = reader.word(in bytes);
        for _ in 0..gen_count {
            gen_names.push(u32_at(in ctx.nmap, reader.word(in bytes)));
            gen_bounds.push(wrapping_u8(reader.word(in bytes)));
            let _ = reader.word(in bytes);
        }
        let has_where = reader.word(in bytes) != 0;
        let empty_body = reader.word(in bytes) != 0;
        let span_start = reader.word(in bytes);
        let span_end = reader.word(in bytes);
        confs.push(
            ConfInfo {
                is_canonical: is_canonical,
                pkg_none: pkg_none,
                trait_name: trait_name,
                targ_count: targ_count,
                self_ty: self_ty,
                gen_start: gen_start,
                gen_count: n32(gen_count),
                has_where: has_where,
                empty_body: empty_body,
                span_start: span_start,
                span_end: span_end
            }
        );
    }

    let bound_count = reader.word(in bytes);
    let mut own_bounds = ChunkSeq::with_capacity[OwnBound](bound_count);
    let mut bound_args = ChunkSeq::new[u32]();
    for _ in 0..bound_count {
        let owner = u32_at(in ctx.nmap, reader.word(in bytes));
        let param = u32_at(in ctx.nmap, reader.word(in bytes));
        let trait_name = u32_at(in ctx.nmap, reader.word(in bytes));
        let arg_start = n32(bound_args.len());
        let arg_count = reader.word(in bytes);
        for _ in 0..arg_count {
            bound_args.push(u32_at(in ctx.tmap, reader.word(in bytes)));
        }
        own_bounds.push(
            OwnBound {
                owner: owner,
                param: param,
                trait_name: trait_name,
                arg_start: arg_start,
                arg_count: n32(arg_count)
            }
        );
    }

    BuiltinMod {
        ctx: ctx,
        gen_names: gen_names,
        gen_bounds: gen_bounds,
        field_names: field_names,
        field_tys: field_tys,
        structs: structs,
        confs: confs,
        own_bounds: own_bounds,
        bound_args: bound_args
    }
}

pub fn builtin_derive_words(in bytes: Slice[u8]) -> ChunkSeq[u64] {
    let module = read_builtin_mod(in bytes);
    let mut diags = ChunkSeq::new[u8]();
    let mut req_trait = ChunkSeq::new[u32]();
    let mut req_struct_idx = ChunkSeq::new[u64]();
    let mut req_struct_name = ChunkSeq::new[u32]();
    let mut req_span_start = ChunkSeq::new[u64]();
    let mut req_span_end = ChunkSeq::new[u64]();

    for ci in 0..module.confs.len() {
        let conf = conf_at(in module, ci);
        if !is_request(in module.ctx.names, conf) {
            continue;
        }
        let self_node = node_at(in module.ctx.types, conf.self_ty);
        let mut target_idx: u64 = NONE64;
        if self_node.kind == K_NAMED && !conf.has_where {
            let struct_idx = find_derivable_struct(in module, self_node.name);
            if struct_idx != NONE64 {
                let struct_info = struct_at(in module, struct_idx);
                if w(self_node.n) == w(struct_info.gen_count)
                    && w(conf.gen_count) == w(self_node.n) {
                    let mut params_ok = true;
                    for ai in 0..w(self_node.n) {
                        let arg_ty = u32_at(in module.ctx.types.items, add(w(self_node.a), ai));
                        let arg_node = node_at(in module.ctx.types, arg_ty);
                        let conf_gen_name = u32_at(in module.gen_names, add(w(conf.gen_start), ai));
                        if !(
                            arg_node.kind == K_NAMED
                                && arg_node.n == 0
                                && arg_node.name == conf_gen_name
                        ) {
                            params_ok = false;
                            break;
                        }
                    }
                    if params_ok {
                        target_idx = struct_idx;
                    }
                }
            }
        }
        if target_idx == NONE64 {
            let mut msg = ChunkSeq::new[u8]();
            put_str(inout msg, "an empty `impl ");
            put_sym(inout msg, in module.ctx.names, conf.trait_name);
            put_str(inout msg, " for ");
            display(in module.ctx.types, in module.ctx.names, conf.self_ty, inout msg);
            put_str(inout msg, "` derives ");
            put_sym(inout msg, in module.ctx.names, conf.trait_name);
            put_str(
                inout msg,
                ", which needs a struct of this package with all its parameters in order and no where clause (for example `impl[T] "
            );
            put_sym(inout msg, in module.ctx.names, conf.trait_name);
            put_str(inout msg, " for Pair[T] {}`); write the methods of ");
            put_sym(inout msg, in module.ctx.names, conf.trait_name);
            put_str(inout msg, " otherwise");
            emit_diag(inout diags, "E0616", conf.span_start, conf.span_end, in msg);
            continue;
        }
        req_trait.push(conf.trait_name);
        req_struct_idx.push(target_idx);
        req_struct_name.push(struct_at(in module, target_idx).name);
        req_span_start.push(conf.span_start);
        req_span_end.push(conf.span_end);
    }

    // Group accepted derivations by struct index in module struct order (matching BTreeMap by name?
    // Wait: Rust groups `Derived` by `BTreeMap<String, Vec<(&str, Span)>>`; we emit in `(struct, trait)` order
    // or sort structs by name if needed; each impl is independent).
    let mut ok_trait = ChunkSeq::new[u32]();
    let mut ok_struct_idx = ChunkSeq::new[u64]();

    for req_idx in 0..req_trait.len() {
        let trait_name = u32_at(in req_trait, req_idx);
        let struct_idx = u64_at(in req_struct_idx, req_idx);
        let struct_info = struct_at(in module, struct_idx);
        let mut memo_state = ChunkSeq::with_capacity[u8](module.structs.len());
        for _ in 0..module.structs.len() {
            memo_state.push(0);
        }
        let mut bad_field: u64 = NONE64;
        for fi in 0..w(struct_info.field_count) {
            let field_ty = u32_at(in module.field_tys, add(w(struct_info.field_start), fi));
            if !type_conforms(
                in module,
                field_ty,
                trait_name,
                struct_info.gen_start,
                struct_info.gen_count,
                in req_trait,
                in req_struct_name,
                inout memo_state
            ) {
                bad_field = fi;
                break;
            }
        }
        if bad_field != NONE64 {
            let field_name = u32_at(
                in module.field_names,
                add(w(struct_info.field_start), bad_field)
            );
            let field_ty = u32_at(in module.field_tys, add(w(struct_info.field_start), bad_field));
            let mut msg = ChunkSeq::new[u8]();
            put_str(inout msg, "cannot derive ");
            put_sym(inout msg, in module.ctx.names, trait_name);
            put_str(inout msg, " for '");
            put_sym(inout msg, in module.ctx.names, struct_info.name);
            put_str(inout msg, "': field '");
            put_sym(inout msg, in module.ctx.names, field_name);
            put_str(inout msg, "' of type ");
            display(in module.ctx.types, in module.ctx.names, field_ty, inout msg);
            put_str(inout msg, " does not conform to ");
            put_sym(inout msg, in module.ctx.names, trait_name);
            put_str(inout msg, " (derive or write ");
            put_sym(inout msg, in module.ctx.names, trait_name);
            put_str(inout msg, " for it first)");
            emit_diag(
                inout diags,
                "E0616",
                u64_at(in req_span_start, req_idx),
                u64_at(in req_span_end, req_idx),
                in msg
            );
            continue;
        }
        ok_trait.push(trait_name);
        ok_struct_idx.push(struct_idx);
    }

    let mut out = ChunkSeq::new[u64]();
    let packed_diags = pack_text(in diags);
    out.extend(in packed_diags.as_slice());
    if diags.len() > 0 {
        out.push(0);
        return out;
    }
    out.push(1);
    let mut impls = ChunkSeq::new[u8]();
    for oi in 0..ok_trait.len() {
        let struct_info = struct_at(in module, u64_at(in ok_struct_idx, oi));
        emit_derived_conformance(in module, struct_info, u32_at(in ok_trait, oi), inout impls);
    }
    let packed_impls = pack_text(in impls);
    out.extend(in packed_impls.as_slice());
    out
}

fn is_builtin_name(in names: Names, symbol: u32) -> bool {
    names.spells(symbol, in "Eq".as_bytes())
        || names.spells(symbol, in "Ord".as_bytes())
        || names.spells(symbol, in "Hash".as_bytes())
        || names.spells(symbol, in "Ordering".as_bytes())
}

fn is_builtin_trait_name(in names: Names, symbol: u32) -> bool {
    names.spells(symbol, in "Eq".as_bytes())
        || names.spells(symbol, in "Ord".as_bytes())
        || names.spells(symbol, in "Hash".as_bytes())
}

fn bytes_contains(in hay: Slice[u8], start: u64, end: u64, in needle: Str) -> bool {
    let needle_bytes = needle.as_bytes();
    let needle_len = needle_bytes.len();
    if end < start || wrapping_sub(end, start) < needle_len {
        return false;
    }
    let limit = add(wrapping_sub(wrapping_sub(end, start), needle_len), 1);
    for offset in 0..limit {
        let base = add(start, offset);
        let mut eq = true;
        for j in 0..needle_len {
            let hay_byte = hay.try_get(add(base, j)).unwrap_or(0);
            let needle_byte = needle_bytes.try_get(j).unwrap_or(0);
            if hay_byte != needle_byte {
                eq = false;
                break;
            }
        }
        if eq {
            return true;
        }
    }
    false
}

// Entrypoint for `check_pact_builtin_wanted` (`builtin_traits::wanted`).
pub fn builtin_wanted_words(in bytes: Slice[u8]) -> ChunkSeq[u64] {
    let mut reader = Reader { pos: 0 };
    let mut names = names_new();
    let mut nmap = ChunkSeq::new[u32]();
    read_q_names(inout reader, in bytes, inout names, inout nmap);
    let _nt = reader.word(in bytes);
    let n_decls = reader.word(in bytes);
    let mut declares = false;
    for _ in 0..n_decls {
        let symbol = u32_at(in nmap, reader.word(in bytes));
        if is_builtin_name(in names, symbol) {
            declares = true;
        }
    }
    let n_refs = reader.word(in bytes);
    let mut named_ref = false;
    for _ in 0..n_refs {
        let pkg_none = reader.word(in bytes) != 0;
        let trait_name = u32_at(in nmap, reader.word(in bytes));
        if pkg_none && is_builtin_trait_name(in names, trait_name) {
            named_ref = true;
        }
    }
    let n_bytes = reader.word(in bytes);
    let text_start = reader.pos;
    let text_end = add(text_start, n_bytes);
    let mut out = ChunkSeq::with_capacity[u64](1);
    if declares {
        out.push(0);
        return out;
    }
    if named_ref {
        out.push(1);
        return out;
    }
    let found = bytes_contains(in bytes, text_start, text_end, "\"Eq::")
        || bytes_contains(in bytes, text_start, text_end, "\"Ord::")
        || bytes_contains(in bytes, text_start, text_end, "\"Hash::")
        || bytes_contains(in bytes, text_start, text_end, "\"Ordering\"");
    out.push(if found { 1 } else { 0 });
    out
}
