// The block layout of `Codegen::ir_graph_at` (src/native.rs): the order the
// blocks of one graph are lowered in, the blocks on a cycle, and the blocks
// the walk seals itself.
//
// Rust builds a petgraph `DiGraphMap` of the terminators' edges and asks it
// for a topological order of the reached blocks (or, when they have a
// cycle, a reverse postorder from the entry), then appends the unreached
// blocks. The order is petgraph's, so this module keeps a `GraphMap` as
// petgraph does: one adjacency list per node of (neighbor, direction)
// entries in the order `add_edge` made them, an `IndexMap` node order, and
// `remove_node`'s `swap_remove` of the node and of each entry naming it.
// Removing the unreached blocks reorders the lists of the blocks they jump
// to, and so the order `toposort` visits successors in.

use @vesper/check-data::util::{add, inc, push_decimal, u64_at, u8_at};
use @vesper/place-ir::{BlockRow, FnRow, Program};
use @vesper/place-ir::codes::{Tag};

const OUT: u8 = 0;
const IN: u8 = 1;
const NONE64: u64 = 18446744073709551615;

fn put(inout out: ChunkSeq[u8], in text: Str) {
    out.extend(in text.as_bytes());
}

fn set64(inout seq: ChunkSeq[u64], index: u64, value: u64) {
    let ok = seq.try_set(index, value);
}

fn set8(inout seq: ChunkSeq[u8], index: u64, value: u8) {
    let ok = seq.try_set(index, value);
}

fn zeros64(n: u64) -> ChunkSeq[u64] {
    let mut seq: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](n);
    seq.resize(n, 0);
    seq
}

fn zeros8(n: u64) -> ChunkSeq[u8] {
    let mut seq: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](n);
    seq.resize(n, 0);
    seq
}

fn list(inout out: ChunkSeq[u8], in label: Str, in values: ChunkSeq[u64]) {
    put(inout out, in label);
    for i in 0..values.len() {
        out.push(32);
        push_decimal(inout out, u64_at(in values, i));
    }
    out.push(10);
}

// The petgraph `GraphMap` of one graph's blocks.
struct Graph {
    // adjacency entries of node k:
    // neighbor[entry_start[k]..entry_start[k] + entry_count[k]], with their direction
    entry_start: ChunkSeq[u64],
    entry_count: ChunkSeq[u64],
    neighbor: ChunkSeq[u64],
    direction: ChunkSeq[u8],
    // the `IndexMap` order of the nodes present, and each node's index in
    // it (NONE64 once removed)
    order: ChunkSeq[u64],
    order_index: ChunkSeq[u64],
}

impl Graph {
    fn entry_node(in self, node: u64, entry: u64) -> u64 {
        u64_at(in self.neighbor, add(u64_at(in self.entry_start, node), entry))
    }

    fn entry_dir(in self, node: u64, entry: u64) -> u8 {
        u8_at(in self.direction, add(u64_at(in self.entry_start, node), entry))
    }

    // `remove_single_edge(node, other, direction)`: the first entry (other,
    // direction) of node's list swap-removed.
    fn remove_entry(inout self, node: u64, other: u64, direction: u8) {
        if u64_at(in self.order_index, node) == NONE64 {
            return;
        }
        let start = u64_at(in self.entry_start, node);
        let count = u64_at(in self.entry_count, node);
        for j in 0..count {
            if u64_at(in self.neighbor, add(start, j)) == other
                && u8_at(in self.direction, add(start, j)) == direction {
                let last = add(start, wrapping_sub(count, 1));
                let last_neighbor = u64_at(in self.neighbor, last);
                let last_direction = u8_at(in self.direction, last);
                set64(inout self.neighbor, add(start, j), last_neighbor);
                set8(inout self.direction, add(start, j), last_direction);
                set64(inout self.entry_count, node, wrapping_sub(count, 1));
                return;
            }
        }
    }

    // `GraphMap::remove_node`.
    fn remove_node(inout self, node: u64) {
        let index = u64_at(in self.order_index, node);
        if index == NONE64 {
            return;
        }
        let n = self.order.len();
        let last = u64_at(in self.order, wrapping_sub(n, 1));
        set64(inout self.order, index, last);
        set64(inout self.order_index, last, index);
        self.order.truncate(wrapping_sub(n, 1));
        set64(inout self.order_index, node, NONE64);
        let entry_count = u64_at(in self.entry_count, node);
        for j in 0..entry_count {
            let other = self.entry_node(node, j);
            let reverse = if self.entry_dir(node, j) == OUT {
                IN
            } else {
                OUT
            };
            self.remove_entry(other, node, reverse);
        }
    }
}

// The deduplicated edge targets of every block, in `add_edge` order.
struct Targets {
    // targets of block b: target[start[b]..start[b] + count[b]]
    start: ChunkSeq[u64],
    count: ChunkSeq[u64],
    target: ChunkSeq[u64],
}

fn targets(in program: Program, func: FnRow) -> Targets {
    let n = func.bc;
    let mut edges = Targets { start: zeros64(n), count: zeros64(n), target: ChunkSeq::new[u64]() };
    // mark[target] == block + 1: `block` already has the edge to `target`
    let mut mark = zeros64(n);
    for block in 0..n {
        let row = program.block(add(func.b0, block));
        set64(inout edges.start, block, edges.target.len());
        let mut count: u64 = 0;
        for i in row.ta..add(row.ta, row.tn) {
            if program.tag(i) == Tag::Block {
                let target = program.op(i);
                if target < n && u64_at(in mark, target) != inc(block) {
                    set64(inout mark, target, inc(block));
                    edges.target.push(target);
                    count = inc(count);
                }
            }
        }
        set64(inout edges.count, block, count);
    }
    edges
}

fn build(in edges: Targets, n: u64) -> Graph {
    let mut degree = zeros64(n);
    for block in 0..n {
        let start = u64_at(in edges.start, block);
        let count = u64_at(in edges.count, block);
        set64(inout degree, block, add(u64_at(in degree, block), count));
        for j in 0..count {
            let target = u64_at(in edges.target, add(start, j));
            if target != block {
                set64(inout degree, target, inc(u64_at(in degree, target)));
            }
        }
    }
    let mut graph = Graph {
        entry_start: zeros64(n),
        entry_count: zeros64(n),
        neighbor: ChunkSeq::new[u64](),
        direction: ChunkSeq::new[u8](),
        order: zeros64(n),
        order_index: zeros64(n)
    };
    let mut total: u64 = 0;
    for block in 0..n {
        set64(inout graph.entry_start, block, total);
        total = add(total, u64_at(in degree, block));
        set64(inout graph.order, block, block);
        set64(inout graph.order_index, block, block);
    }
    graph.neighbor.resize(total, 0);
    graph.direction.resize(total, 0);
    for block in 0..n {
        let start = u64_at(in edges.start, block);
        let count = u64_at(in edges.count, block);
        for j in 0..count {
            let target = u64_at(in edges.target, add(start, j));
            let slot = add(
                u64_at(in graph.entry_start, block),
                u64_at(in graph.entry_count, block)
            );
            set64(inout graph.neighbor, slot, target);
            set8(inout graph.direction, slot, OUT);
            set64(inout graph.entry_count, block, inc(u64_at(in graph.entry_count, block)));
            if target != block {
                let back_slot = add(
                    u64_at(in graph.entry_start, target),
                    u64_at(in graph.entry_count, target)
                );
                set64(inout graph.neighbor, back_slot, block);
                set8(inout graph.direction, back_slot, IN);
                set64(inout graph.entry_count, target, inc(u64_at(in graph.entry_count, target)));
            }
        }
    }
    graph
}

// petgraph's iterative DFS from `root` (`DfsPostOrder::next`, and the first
// phase of `toposort`): each node is pushed again for every unvisited
// successor and finished when it is popped a second time. Appends the
// finished nodes to `post`.
fn dfs_from(
    in graph: Graph,
    root: u64,
    inout discovered: ChunkSeq[u8],
    inout finished: ChunkSeq[u8],
    inout post: ChunkSeq[u64]
) {
    let mut stack: ChunkSeq[u64] = ChunkSeq::new[u64]();
    stack.push(root);
    loop {
        let stack_len = stack.len();
        if stack_len == 0 {
            break;
        }
        let node = u64_at(in stack, wrapping_sub(stack_len, 1));
        if u8_at(in discovered, node) == 0 {
            set8(inout discovered, node, 1);
            let entry_count = u64_at(in graph.entry_count, node);
            for j in 0..entry_count {
                if graph.entry_dir(node, j) == OUT {
                    let succ = graph.entry_node(node, j);
                    if u8_at(in discovered, succ) == 0 {
                        stack.push(succ);
                    }
                }
            }
        } else {
            stack.truncate(wrapping_sub(stack_len, 1));
            if u8_at(in finished, node) == 0 {
                set8(inout finished, node, 1);
                post.push(node);
            }
        }
    }
}

// One function's block layout: the order its blocks are lowered in, the
// blocks on a cycle, and the blocks the walk seals as it lowers them (in
// lowering order).
pub struct Layout {
    order: ChunkSeq[u64],
    cyclic: ChunkSeq[u64],
    sealed: ChunkSeq[u64],
}

// Prints the `order`, `cyclic` and `sealed` lines of one function.
pub fn block_layout(in program: Program, func: FnRow, inout out: ChunkSeq[u8]) {
    let blocks = layout(in program, func);
    list(inout out, in "order", in blocks.order);
    list(inout out, in "cyclic", in blocks.cyclic);
    list(inout out, in "sealed", in blocks.sealed);
}

// The block layout of `func`.
pub fn layout(in program: Program, func: FnRow) -> Layout {
    let n = func.bc;
    if n == 0 {
        return Layout {
            order: ChunkSeq::new[u64](),
            cyclic: ChunkSeq::new[u64](),
            sealed: ChunkSeq::new[u64]()
        };
    }
    let edges = targets(in program, func);
    let mut graph = build(in edges, n);
    // the postorder of the whole graph from the entry
    let mut post: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut reached = zeros8(n);
    let mut visited = zeros8(n);
    dfs_from(in graph, 0, inout visited, inout reached, inout post);
    // the live graph: the unreached blocks removed in ascending order
    let mut unreached: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for block in 0..n {
        if u8_at(in reached, block) == 0 {
            unreached.push(block);
            graph.remove_node(block);
        }
    }
    // `toposort`'s finish order over the live nodes in `IndexMap` order
    let mut finish: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut discovered = zeros8(n);
    let mut finished = zeros8(n);
    for i in 0..graph.order.len() {
        let node = u64_at(in graph.order, i);
        if u8_at(in discovered, node) == 0 {
            dfs_from(in graph, node, inout discovered, inout finished, inout finish);
        }
    }
    // strongly connected components (Kosaraju over the incoming entries),
    // in reverse finish order
    let mut component = zeros64(n);
    let mut component_size: ChunkSeq[u64] = ChunkSeq::new[u64]();
    component_size.push(0);
    let mut stack: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let finish_len = finish.len();
    for step in 0..finish_len {
        let node = u64_at(in finish, wrapping_sub(wrapping_sub(finish_len, 1), step));
        if u64_at(in component, node) == 0 {
            let id = component_size.len();
            component_size.push(0);
            set64(inout component, node, id);
            stack.push(node);
            loop {
                let stack_len = stack.len();
                if stack_len == 0 {
                    break;
                }
                let top = u64_at(in stack, wrapping_sub(stack_len, 1));
                stack.truncate(wrapping_sub(stack_len, 1));
                set64(inout component_size, id, inc(u64_at(in component_size, id)));
                let entry_count = u64_at(in graph.entry_count, top);
                for j in 0..entry_count {
                    if graph.entry_dir(top, j) == IN {
                        let pred = graph.entry_node(top, j);
                        if u64_at(in component, pred) == 0 {
                            set64(inout component, pred, id);
                            stack.push(pred);
                        }
                    }
                }
            }
        }
    }
    let mut cyclic = zeros8(n);
    let mut cyclic_list: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for block in 0..n {
        let comp_id = u64_at(in component, block);
        if comp_id != 0 {
            let mut on_cycle = u64_at(in component_size, comp_id) > 1;
            if !on_cycle {
                let entry_count = u64_at(in graph.entry_count, block);
                for j in 0..entry_count {
                    if graph.entry_dir(block, j) == OUT && graph.entry_node(block, j) == block {
                        on_cycle = true;
                    }
                }
            }
            if on_cycle {
                set8(inout cyclic, block, 1);
                cyclic_list.push(block);
            }
        }
    }
    let mut order: ChunkSeq[u64] = ChunkSeq::new[u64]();
    if cyclic_list.len() == 0 {
        for step in 0..finish_len {
            order.push(u64_at(in finish, wrapping_sub(wrapping_sub(finish_len, 1), step)));
        }
    } else {
        let post_len = post.len();
        for step in 0..post_len {
            order.push(u64_at(in post, wrapping_sub(wrapping_sub(post_len, 1), step)));
        }
    }
    for i in 0..unreached.len() {
        order.push(u64_at(in unreached, i));
    }
    // A block is sealed when it is lowered if no predecessor (itself, for a
    // self loop) is still to come.
    let mut pending = zeros64(n);
    for block in 0..n {
        let start = u64_at(in edges.start, block);
        let count = u64_at(in edges.count, block);
        for j in 0..count {
            let target = u64_at(in edges.target, add(start, j));
            set64(inout pending, target, inc(u64_at(in pending, target)));
        }
    }
    let mut sealed: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for pos in 0..order.len() {
        let block = u64_at(in order, pos);
        if block != 0 && u8_at(in cyclic, block) == 0 && u64_at(in pending, block) == 0 {
            sealed.push(block);
        }
        let start = u64_at(in edges.start, block);
        let count = u64_at(in edges.count, block);
        for j in 0..count {
            let target = u64_at(in edges.target, add(start, j));
            set64(inout pending, target, wrapping_sub(u64_at(in pending, target), 1));
        }
    }
    Layout { order: order, cyclic: cyclic_list, sealed: sealed }
}
