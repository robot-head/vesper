// @vesper/codegen-scalar: the core of the native `Codegen` of src/native.rs
// (the Place IR graph walk `ir_graph_at` and the expression lowering
// `expr_at`: operators, conversions, checked arithmetic, shifts, bit
// builtins, branches and exits), self-hosting SH4 lane 6 (#1280).
//
// Part 1 ports what the walk decides before it emits a Cranelift
// instruction, over the @vesper/place-ir tables and the @vesper/check-data
// world. Emission joins it once lane 1 (#1275) lends the Rust builder.
//
// - blocks.ves: the block order, cycles and seals of one graph.
// - `decide_unary`, `decide_binary`: the `expr_at` arm of an `Op::Unary`
//   or `Op::Binary`, the operand's integer kind and lane, and the run-time
//   checks it needs (overflow, divisor, narrowing bounds, shift range).
// - `codegen_scalar_decisions`: the harness entry: one text dump per
//   program, line for line `decisions` of tests/self_host_codegen_scalar.rs.
//
// Integer kinds are numbered in `numeric::IntegerKind`'s spelling order:
// 1 u8, 2 u16, 3 u32, 4 u64, 5 usize, 6 i8, 7 i16, 8 i32, 9 i64, 10 isize,
// 11 i128, 12 u128; 0 is no kind. Lanes are a value's Cranelift type:
// 0 I64, 1 F32, 2 F64, 3 I128.

use @vesper/check-data::pack_text;
use @vesper/check-data::util::{add, inc, n32, push_decimal, u32_at, u64_at, w};
use @vesper/check-data::names::{Names};
use @vesper/check-data::types::{Types, default_type, TyKind};
use @vesper/check-data::world::{set_by_symbol};
use @vesper/check-data::input::{Ctx, Reader, read_ctx};
use @vesper/check-layout::{Layouts, layout_of, layouts_new};
use @vesper/place-ir::{FnRow, InstRow, Program, read_program};
use self::blocks::{block_layout};
use @vesper/codegen-aggregates::{EnumWords, enum_words_none, scalar_enum_words};
use self::handlers::{HandlerFacts, read_handler_facts};
use self::body::{NO_LOCAL};
use @vesper/place-ir::codes::{Lit, Op, Tag, Term};

const NONE32: u32 = 4294967295;

// The `scalar` hook's requests (@vesper/codegen-scalar-emit keeps the
// same numbers): the plan names one per instruction it emits.
const PLAN_ZERO: u64 = 1;
const PLAN_ICONST: u64 = 2;
const PLAN_F64CONST: u64 = 3;
const PLAN_ICMP: u64 = 4;
const PLAN_BINOP: u64 = 5;
const PLAN_BNOT: u64 = 6;
const PLAN_NOT: u64 = 7;
const PLAN_INEG: u64 = 8;
const PLAN_SHIFT: u64 = 9;
const PLAN_CONVERT: u64 = 10;
// `PLAN_SHIFT`'s operations (the low byte; the kind is the next one).
const SHIFT_ISHL: u64 = 1;
const SHIFT_USHR: u64 = 2;
const SHIFT_SSHR: u64 = 3;
const SHIFT_ROTL: u64 = 4;
const SHIFT_ROTR: u64 = 5;
// `PLAN_BINOP`'s operations.
const BIN_IADD: u64 = 1;
const BIN_ISUB: u64 = 2;
const BIN_IMUL: u64 = 3;
const BIN_UDIV: u64 = 4;
const BIN_UREM: u64 = 5;
const BIN_SREM: u64 = 6;
const BIN_BAND: u64 = 7;
const BIN_BOR: u64 = 8;
const BIN_BXOR: u64 = 9;
// `PLAN_ICMP`'s condition codes; an unsigned ordering adds CC_UNSIGNED.
const CC_EQ: u64 = 1;
const CC_NE: u64 = 2;
const CC_SLT: u64 = 3;
const CC_SLE: u64 = 4;
const CC_SGT: u64 = 5;
const CC_SGE: u64 = 6;
const CC_UNSIGNED: u64 = 4;

// Integer kinds.
const KIND_U64: u32 = 4;
const KIND_I64: u32 = 9;
const KIND_I128: u32 = 11;
const KIND_U128: u32 = 12;
const KIND_COUNT: u32 = 12;

// Lanes.
const LANE_I64: u8 = 0;
const LANE_F32: u8 = 1;
const LANE_F64: u8 = 2;
const LANE_I128: u8 = 3;

// `numeric::Conversion`, in `conversion`'s search order.
const CONV_WIDEN: u32 = 1;
pub const CONV_NARROW: u32 = 2;
const CONV_WRAPPING: u32 = 3;

// `integer_widths::BitOp`, in `BIT_BUILTINS` order.
const BIT_OP_COUNT: u32 = 6;

// Flags of the float table.
const FLOAT_INTRINSIC: u32 = 1;
const FLOAT_MATH: u32 = 2;

// Exact float intrinsic codes (`Tables.float_ops`, used by `body.ves`).
pub const FOP_SQRT: u32 = 1;
pub const FOP_ABS: u32 = 2;
pub const FOP_FLOOR: u32 = 3;
pub const FOP_CEIL: u32 = 4;
pub const FOP_ROUND: u32 = 5;
pub const FOP_TRUNC: u32 = 6;
pub const FOP_MIN: u32 = 7;
pub const FOP_MAX: u32 = 8;
pub const FOP_FMA: u32 = 9;
pub const FOP_WIDEN_F32: u32 = 10;
pub const FOP_WIDEN_F64: u32 = 11;
pub const FOP_NEAREST_F32: u32 = 12;
pub const FOP_NEAREST_F64: u32 = 13;
pub const FOP_TO_BITS_F32: u32 = 14;
pub const FOP_TO_BITS_F64: u32 = 15;
pub const FOP_FROM_BITS_F32: u32 = 16;
pub const FOP_FROM_BITS_F64: u32 = 17;
// `saturating_<kind>` is `FOP_SAT_BASE + kind`.
pub const FOP_SAT_BASE: u32 = 32;

// The largest i64, which a literal's magnitude must exceed to default to u64.
const I64_MAX: u64 = 9223372036854775807;

fn put(inout out: ChunkSeq[u8], in text: Str) {
    out.extend(in text.as_bytes());
}

pub fn get(in table: ChunkSeq[u32], symbol: u32) -> u32 {
    if w(symbol) < table.len() {
        u32_at(in table, w(symbol))
    } else {
        0
    }
}

fn intern(inout names: Names, in text: Str) -> u32 {
    names.intern(in text.as_bytes())
}

// `name` spelled `prefix` + the name of `kind`.
fn intern_kind(inout names: Names, in prefix: Str, kind: u32) -> u32 {
    let mut text: ChunkSeq[u8] = ChunkSeq::new[u8]();
    put(inout text, in prefix);
    put_kind(inout text, kind);
    names.intern(in text.as_slice())
}

fn put_kind(inout out: ChunkSeq[u8], kind: u32) {
    if kind == 1 {
        put(inout out, in "u8");
    } else if kind == 2 {
        put(inout out, in "u16");
    } else if kind == 3 {
        put(inout out, in "u32");
    } else if kind == 4 {
        put(inout out, in "u64");
    } else if kind == 5 {
        put(inout out, in "usize");
    } else if kind == 6 {
        put(inout out, in "i8");
    } else if kind == 7 {
        put(inout out, in "i16");
    } else if kind == 8 {
        put(inout out, in "i32");
    } else if kind == 9 {
        put(inout out, in "i64");
    } else if kind == 10 {
        put(inout out, in "isize");
    } else if kind == 11 {
        put(inout out, in "i128");
    } else if kind == 12 {
        put(inout out, in "u128");
    } else {
        put(inout out, in "-");
    }
}

// `IntegerKind::bits`.
fn kind_bits(kind: u32) -> u64 {
    if kind == 1 || kind == 6 {
        8
    } else if kind == 2 || kind == 7 {
        16
    } else if kind == 3 || kind == 8 {
        32
    } else if kind == KIND_I128 || kind == KIND_U128 {
        128
    } else {
        64
    }
}

pub fn kind_unsigned(kind: u32) -> bool {
    (kind >= 1 && kind <= 5) || kind == KIND_U128
}

fn kind_wide(kind: u32) -> bool {
    kind == KIND_I128 || kind == KIND_U128
}

// `IntegerKind::max` of a one-word kind, as a u64.
fn kind_max(kind: u32) -> u64 {
    if kind == 1 {
        255
    } else if kind == 2 {
        65535
    } else if kind == 3 {
        4294967295
    } else if kind == 4 || kind == 5 {
        18446744073709551615
    } else if kind == 6 {
        127
    } else if kind == 7 {
        32767
    } else if kind == 8 {
        2147483647
    } else {
        9223372036854775807
    }
}

// `IntegerKind::min` of a one-word kind, as the magnitude of a value at
// most 0 (0 for an unsigned kind).
fn kind_min_magnitude(kind: u32) -> u64 {
    if kind_unsigned(kind) {
        0
    } else if kind == 6 {
        128
    } else if kind == 7 {
        32768
    } else if kind == 8 {
        2147483648
    } else {
        9223372036854775808
    }
}

fn put_conversion(inout out: ChunkSeq[u8], conversion: u32) {
    if conversion == CONV_WIDEN {
        put(inout out, in "Widen");
    } else if conversion == CONV_NARROW {
        put(inout out, in "Narrow");
    } else {
        put(inout out, in "Wrapping");
    }
}

fn put_bit_op(inout out: ChunkSeq[u8], op: u32) {
    if op == 1 {
        put(inout out, in "LeadingZeros");
    } else if op == 2 {
        put(inout out, in "TrailingZeros");
    } else if op == 3 {
        put(inout out, in "CountOnes");
    } else if op == 4 {
        put(inout out, in "WrappingShl");
    } else if op == 5 {
        put(inout out, in "WrappingShr");
    } else {
        put(inout out, in "WrappingNeg");
    }
}

fn bit_prefix(op: u32) -> Str {
    if op == 1 {
        "leading_zeros_"
    } else if op == 2 {
        "trailing_zeros_"
    } else if op == 3 {
        "count_ones_"
    } else if op == 4 {
        "wrapping_shl_"
    } else if op == 5 {
        "wrapping_shr_"
    } else {
        "wrapping_neg_"
    }
}

// The operator and intrinsic names the decisions compare against, and
// per-symbol tables of the name families (`conversion`, `bit_builtin`,
// `is_float_intrinsic`, `bit_intrinsic`, `rotate_intrinsic`).
struct Tables {
    // symbol -> integer kind of a type name
    kinds: ChunkSeq[u32],
    // symbol -> conversion * 16 + kind
    conversions: ChunkSeq[u32],
    // symbol -> bit op * 16 + kind
    bit_builtins: ChunkSeq[u32],
    // symbol -> FLOAT_* flags
    float_flags: ChunkSeq[u32],
    // symbol -> FOP_* exact float intrinsic code (body.ves)
    float_ops: ChunkSeq[u32],
    // symbol -> 1 bit_and, 2 bit_or, 3 bit_xor, 4 bit_shl, 5 bit_shr
    bit_intrinsics: ChunkSeq[u32],
    // symbol -> 1 rotate_left, 2 rotate_right
    rotations: ChunkSeq[u32],
}

copy struct Ops {
    tilde: u32,
    bang: u32,
    minus: u32,
    plus: u32,
    star: u32,
    slash: u32,
    percent: u32,
    eq: u32,
    ne: u32,
    lt: u32,
    le: u32,
    gt: u32,
    ge: u32,
    and_and: u32,
    or_or: u32,
    shl: u32,
    shr: u32,
    amp: u32,
    pipe: u32,
    caret: u32,
    widen_u64: u32,
    wrapping_add: u32,
    wrapping_sub: u32,
    wrapping_mul: u32,
    f32_: u32,
    f64_: u32,
    string: u32,
    str_: u32,
    never: u32,
    box_: u32,
    bool_: u32,
    // `=` and compound assignments (body.ves)
    assign: u32,
    plus_eq: u32,
    minus_eq: u32,
    star_eq: u32,
    slash_eq: u32,
    percent_eq: u32,
    amp_eq: u32,
    pipe_eq: u32,
    caret_eq: u32,
    const_time: u32,
    realtime: u32,
    det_float: u32,
    isa: u32,
    // the failure-record raises (body.ves, #2425)
    fail_: u32,
    arith_overflow: u32,
    runtime_error: u32,
    division_by_zero: u32,
    // the sequence and string operations of the body hook (body.ves,
    // #2653): `Op::Seq` pool labels, the `SeqOp` `Debug` text
    index_out_of_bounds: u32,
    seq_str_len: u32,
    seq_str_byte_at: u32,
    seq_str_as_str: u32,
    seq_str_as_bytes: u32,
    seq_slice_len: u32,
    seq_slice_get: u32,
    seq_last: u32,
    // a `ChunkSeq`'s `len`, checked element and `as_slice` (#2750)
    seq_len: u32,
    seq_get: u32,
    seq_as_slice: u32,
    seq_set: u32,
    seq_try_set: u32,
    option_some: u32,
    option_none: u32,
}

fn mark(inout table: ChunkSeq[u32], symbol: u32, flag: u32) {
    let old = get(in table, symbol);
    set_by_symbol(inout table, symbol, old | flag);
}

fn ops_new(inout names: Names, inout tables: Tables) -> Ops {
    let mut kinds: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut conversions: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut bit_builtins: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut float_flags: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut float_ops: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut bit_intrinsics: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut rotations: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut kind: u32 = 1;
    loop {
        if kind > KIND_COUNT {
            break;
        }
        let kind_name = intern_kind(inout names, in "", kind);
        set_by_symbol(inout kinds, kind_name, kind);
        // `conversion` tries widen_, narrow_, wrapping_ in that order; the
        // spellings never collide.
        let widen = intern_kind(inout names, in "widen_", kind);
        set_by_symbol(inout conversions, widen, wrapping_add(wrapping_mul(CONV_WIDEN, 16), kind));
        let narrow = intern_kind(inout names, in "narrow_", kind);
        set_by_symbol(inout conversions, narrow, wrapping_add(wrapping_mul(CONV_NARROW, 16), kind));
        let wrapping = intern_kind(inout names, in "wrapping_", kind);
        set_by_symbol(
            inout conversions,
            wrapping,
            wrapping_add(wrapping_mul(CONV_WRAPPING, 16), kind)
        );
        let mut op: u32 = 1;
        loop {
            if op > BIT_OP_COUNT {
                break;
            }
            let bit_name = intern_kind(inout names, bit_prefix(op), kind);
            set_by_symbol(inout bit_builtins, bit_name, wrapping_add(wrapping_mul(op, 16), kind));
            op = wrapping_add(op, 1);
        }
        let saturating = intern_kind(inout names, in "saturating_", kind);
        mark(inout float_flags, saturating, FLOAT_INTRINSIC);
        set_by_symbol(inout float_ops, saturating, wrapping_add(FOP_SAT_BASE, kind));
        kind = wrapping_add(kind, 1);
    }
    let sqrt_sym = intern(inout names, in "sqrt");
    mark(inout float_flags, sqrt_sym, FLOAT_INTRINSIC | FLOAT_MATH);
    set_by_symbol(inout float_ops, sqrt_sym, FOP_SQRT);
    let abs_sym = intern(inout names, in "abs");
    mark(inout float_flags, abs_sym, FLOAT_INTRINSIC | FLOAT_MATH);
    set_by_symbol(inout float_ops, abs_sym, FOP_ABS);
    let floor_sym = intern(inout names, in "floor");
    mark(inout float_flags, floor_sym, FLOAT_INTRINSIC | FLOAT_MATH);
    set_by_symbol(inout float_ops, floor_sym, FOP_FLOOR);
    let ceil_sym = intern(inout names, in "ceil");
    mark(inout float_flags, ceil_sym, FLOAT_INTRINSIC | FLOAT_MATH);
    set_by_symbol(inout float_ops, ceil_sym, FOP_CEIL);
    let round_sym = intern(inout names, in "round");
    mark(inout float_flags, round_sym, FLOAT_INTRINSIC | FLOAT_MATH);
    set_by_symbol(inout float_ops, round_sym, FOP_ROUND);
    let trunc_sym = intern(inout names, in "trunc");
    mark(inout float_flags, trunc_sym, FLOAT_INTRINSIC | FLOAT_MATH);
    set_by_symbol(inout float_ops, trunc_sym, FOP_TRUNC);
    let min_sym = intern(inout names, in "min");
    mark(inout float_flags, min_sym, FLOAT_INTRINSIC | FLOAT_MATH);
    set_by_symbol(inout float_ops, min_sym, FOP_MIN);
    let max_sym = intern(inout names, in "max");
    mark(inout float_flags, max_sym, FLOAT_INTRINSIC | FLOAT_MATH);
    set_by_symbol(inout float_ops, max_sym, FOP_MAX);
    let fma_sym = intern(inout names, in "fma");
    mark(inout float_flags, fma_sym, FLOAT_INTRINSIC | FLOAT_MATH);
    set_by_symbol(inout float_ops, fma_sym, FOP_FMA);
    // float conversions and bit reinterpretations
    let widen_f32_sym = intern(inout names, in "widen_f32");
    mark(inout float_flags, widen_f32_sym, FLOAT_INTRINSIC);
    set_by_symbol(inout float_ops, widen_f32_sym, FOP_WIDEN_F32);
    let widen_f64_sym = intern(inout names, in "widen_f64");
    mark(inout float_flags, widen_f64_sym, FLOAT_INTRINSIC);
    set_by_symbol(inout float_ops, widen_f64_sym, FOP_WIDEN_F64);
    let nearest_f32_sym = intern(inout names, in "nearest_f32");
    mark(inout float_flags, nearest_f32_sym, FLOAT_INTRINSIC);
    set_by_symbol(inout float_ops, nearest_f32_sym, FOP_NEAREST_F32);
    let nearest_f64_sym = intern(inout names, in "nearest_f64");
    mark(inout float_flags, nearest_f64_sym, FLOAT_INTRINSIC);
    set_by_symbol(inout float_ops, nearest_f64_sym, FOP_NEAREST_F64);
    let to_bits_f32_sym = intern(inout names, in "to_bits_f32");
    mark(inout float_flags, to_bits_f32_sym, FLOAT_INTRINSIC);
    set_by_symbol(inout float_ops, to_bits_f32_sym, FOP_TO_BITS_F32);
    let to_bits_f64_sym = intern(inout names, in "to_bits_f64");
    mark(inout float_flags, to_bits_f64_sym, FLOAT_INTRINSIC);
    set_by_symbol(inout float_ops, to_bits_f64_sym, FOP_TO_BITS_F64);
    let from_bits_f32_sym = intern(inout names, in "from_bits_f32");
    mark(inout float_flags, from_bits_f32_sym, FLOAT_INTRINSIC);
    set_by_symbol(inout float_ops, from_bits_f32_sym, FOP_FROM_BITS_F32);
    let from_bits_f64_sym = intern(inout names, in "from_bits_f64");
    mark(inout float_flags, from_bits_f64_sym, FLOAT_INTRINSIC);
    set_by_symbol(inout float_ops, from_bits_f64_sym, FOP_FROM_BITS_F64);
    let bit_and_sym = intern(inout names, in "bit_and");
    set_by_symbol(inout bit_intrinsics, bit_and_sym, 1);
    let bit_or_sym = intern(inout names, in "bit_or");
    set_by_symbol(inout bit_intrinsics, bit_or_sym, 2);
    let bit_xor_sym = intern(inout names, in "bit_xor");
    set_by_symbol(inout bit_intrinsics, bit_xor_sym, 3);
    let bit_shl_sym = intern(inout names, in "bit_shl");
    set_by_symbol(inout bit_intrinsics, bit_shl_sym, 4);
    let bit_shr_sym = intern(inout names, in "bit_shr");
    set_by_symbol(inout bit_intrinsics, bit_shr_sym, 5);
    let rotate_left_sym = intern(inout names, in "rotate_left");
    set_by_symbol(inout rotations, rotate_left_sym, 1);
    let rotate_right_sym = intern(inout names, in "rotate_right");
    set_by_symbol(inout rotations, rotate_right_sym, 2);
    tables.kinds = kinds;
    tables.conversions = conversions;
    tables.bit_builtins = bit_builtins;
    tables.float_flags = float_flags;
    tables.float_ops = float_ops;
    tables.bit_intrinsics = bit_intrinsics;
    tables.rotations = rotations;
    Ops {
        tilde: intern(inout names, in "~"),
        bang: intern(inout names, in "!"),
        minus: intern(inout names, in "-"),
        plus: intern(inout names, in "+"),
        star: intern(inout names, in "*"),
        slash: intern(inout names, in "/"),
        percent: intern(inout names, in "%"),
        eq: intern(inout names, in "=="),
        ne: intern(inout names, in "!="),
        lt: intern(inout names, in "<"),
        le: intern(inout names, in "<="),
        gt: intern(inout names, in ">"),
        ge: intern(inout names, in ">="),
        and_and: intern(inout names, in "&&"),
        or_or: intern(inout names, in "||"),
        shl: intern(inout names, in "<<"),
        shr: intern(inout names, in ">>"),
        assign: intern(inout names, in "="),
        plus_eq: intern(inout names, in "+="),
        minus_eq: intern(inout names, in "-="),
        star_eq: intern(inout names, in "*="),
        slash_eq: intern(inout names, in "/="),
        percent_eq: intern(inout names, in "%="),
        amp_eq: intern(inout names, in "&="),
        pipe_eq: intern(inout names, in "|="),
        caret_eq: intern(inout names, in "^="),
        const_time: intern(inout names, in "ConstTime"),
        realtime: intern(inout names, in "Realtime"),
        det_float: intern(inout names, in "DetFloat"),
        isa: intern(inout names, in "Isa"),
        fail_: intern(inout names, in "Fail"),
        arith_overflow: intern(inout names, in "ArithOverflow"),
        runtime_error: intern(inout names, in "RuntimeError"),
        division_by_zero: intern(inout names, in "DivisionByZero"),
        index_out_of_bounds: intern(inout names, in "IndexOutOfBounds"),
        seq_str_len: intern(inout names, in "Str(Len)"),
        seq_str_byte_at: intern(inout names, in "Str(ByteAt)"),
        seq_str_as_str: intern(inout names, in "Str(AsStr)"),
        seq_str_as_bytes: intern(inout names, in "Str(AsBytes)"),
        seq_slice_len: intern(inout names, in "SliceLen"),
        seq_slice_get: intern(inout names, in "SliceGet"),
        seq_last: intern(inout names, in "Last"),
        seq_len: intern(inout names, in "Len"),
        seq_get: intern(inout names, in "Get"),
        seq_as_slice: intern(inout names, in "AsSlice"),
        seq_set: intern(inout names, in "Set"),
        seq_try_set: intern(inout names, in "TrySet"),
        option_some: intern(inout names, in "Some"),
        option_none: intern(inout names, in "None"),
        amp: intern(inout names, in "&"),
        pipe: intern(inout names, in "|"),
        caret: intern(inout names, in "^"),
        widen_u64: intern(inout names, in "widen_u64"),
        wrapping_add: intern(inout names, in "wrapping_add"),
        wrapping_sub: intern(inout names, in "wrapping_sub"),
        wrapping_mul: intern(inout names, in "wrapping_mul"),
        f32_: intern(inout names, in "f32"),
        f64_: intern(inout names, in "f64"),
        string: intern(inout names, in "String"),
        str_: intern(inout names, in "Str"),
        never: intern(inout names, in "Never"),
        box_: intern(inout names, in "Box"),
        bool_: intern(inout names, in "bool"),
    }
}

impl Ops {
    fn is_comparison(self, op: u32) -> bool {
        op == self.eq
            || op == self.ne
            || op == self.lt
            || op == self.le
            || op == self.gt
            || op == self.ge
    }
}

// The decisions of one program.
pub struct Gen {
    ctx: Ctx,
    tables: Tables,
    ops: Ops,
    layouts: Layouts,
    program: Program,
    // value id -> its IR type + 1 (0: no type) for the current function
    value_types: ChunkSeq[u32],
    out: ChunkSeq[u8],
    // The emission plan (`codegen_scalar_plan`).
    plan: ChunkSeq[u64],
    // The small enums the optimize path keeps as words (#2581): the
    // program's graphs are rewritten by `scalar_enum_words` when the input
    // carries its facts.
    enums: EnumWords,
    // The function `body` plans.
    fi: u64,
    // What each `Op::Handle` holds (#2657), from the facts after the
    // program; the handled error type names in scope while a nested graph
    // is planned, innermost last; and the facts row + 1 and first nested
    // call of the handler `body_inst` plans.
    handlers: HandlerFacts,
    hstack: ChunkSeq[u64],
    // The `raise` clause's error name while its plan is made: a product
    // error bound to its storage's address (NO_LOCAL otherwise).
    bound_error: u64,
    handle_row: u64,
    handle_base: u64,
    // The sequence drop slots of the function `body` plans, by name
    // (`body_drop_slots`).
    drops: ChunkSeq[u64],
    // The temporaries it drops, as (block, instruction, value index)
    // (`body_temporaries`).
    temps: ChunkSeq[u64],
    // Each function's records in `plan`: plan[plan_from[fi]..plan_to[fi]].
    plan_from: ChunkSeq[u64],
    plan_to: ChunkSeq[u64],
}

impl Gen {
    // `IntegerKind::from_type`: a literal's default kind, or the kind the
    // type's name spells.
    fn kind_of(in self, ty: u32) -> u32 {
        let node = self.ctx.types.node(ty);
        if node.kind == TyKind::Lit {
            if node.mode == 0 && wrapping_u64(node.lit) > I64_MAX {
                return KIND_U64;
            }
            return KIND_I64;
        }
        get(in self.tables.kinds, self.ctx.types.name(ty))
    }

    // The Cranelift lane of a value of type `ty` (`native::scalar` of the
    // defaulted type).
    fn lane(inout self, ty: u32) -> u8 {
        let defaulted = default_type(inout self.ctx.types, ty);
        let name = self.ctx.types.name(defaulted);
        if name == self.ops.f32_ {
            LANE_F32
        } else if name == self.ops.f64_ {
            LANE_F64
        } else if kind_wide(get(in self.tables.kinds, name)) {
            LANE_I128
        } else {
            LANE_I64
        }
    }

    // `FloatKind::from_type`: `f32` or `f64` with no arguments.
    fn float_type(in self, ty: u32) -> bool {
        let node = self.ctx.types.node(ty);
        node.kind == TyKind::Named
            && node.n == 0
            && (node.name == self.ops.f32_ || node.name == self.ops.f64_)
    }

    // `strings::is_text`.
    fn is_text(in self, ty: u32) -> bool {
        let node = self.ctx.types.node(ty);
        node.kind == TyKind::Named
            && node.n == 0
            && (node.name == self.ops.string || node.name == self.ops.str_)
    }

    // `fip::is_box_type` (no FFI handle drops in scope).
    fn is_box(in self, ty: u32) -> bool {
        let node = self.ctx.types.node(ty);
        self.ctx.world.box_active
            && node.kind == TyKind::Named
            && node.name == self.ops.box_
            && node.n == 1
    }

    // The IR type of `value`, or NONE32.
    fn value_type(in self, value: u64) -> u32 {
        if value < self.value_types.len() {
            let stored = u32_at(in self.value_types, value);
            if stored != 0 {
                return wrapping_sub(stored, 1);
            }
        }
        NONE32
    }

    fn never(in self, value: u64) -> bool {
        let ty = self.value_type(value);
        ty != NONE32 && self.ctx.types.name(ty) == self.ops.never
    }

    fn name(inout self, symbol: u32) {
        self.ctx.names.write(symbol, inout self.out);
    }

    // The values of `func` (Rust's `f.values`), from its header's (value, type) words.
    fn load_values(inout self, func: FnRow) {
        self.value_types.clear();
        let end = add(func.ha, func.hn);
        let mut i = func.ha;
        loop {
            if inc(i) >= end {
                break;
            }
            if self.program.tag(i) == Tag::Value && self.program.tag(inc(i)) == Tag::Type {
                let value = self.program.op(i);
                let ty = n32(self.program.op(inc(i)));
                loop {
                    if self.value_types.len() > value {
                        break;
                    }
                    self.value_types.push(0);
                }
                let ok = self.value_types.try_set(value, wrapping_add(ty, 1));
                i = add(i, 2);
            } else {
                i = inc(i);
            }
        }
    }

    // `Codegen::binary`'s instruction for `op` on lanes `lhs_lane` and `rhs_lane`.
    fn binary(inout self, op: u32, lhs_lane: u8, rhs_lane: u8, unsigned: bool) {
        if lhs_lane != rhs_lane {
            put(inout self.out, in "error mismatch");
            return;
        }
        let is_float = lhs_lane == LANE_F32 || lhs_lane == LANE_F64;
        let ops = self.ops;
        if (op == ops.slash || op == ops.percent) && lhs_lane == LANE_I128 {
            put(inout self.out, in "wide-divide ");
            put(inout self.out, if unsigned { "u" } else { "s" });
            return;
        }
        if ops.is_comparison(op) {
            if is_float {
                put(inout self.out, in "fcmp ");
            } else {
                put(inout self.out, in "icmp ");
                if unsigned && op != ops.eq && op != ops.ne {
                    self.out.push(117);
                }
            }
            self.name(op);
            return;
        }
        let inst_name = if !is_float && (op == ops.plus || op == ops.wrapping_add) {
            "iadd"
        } else if !is_float && (op == ops.minus || op == ops.wrapping_sub) {
            "isub"
        } else if !is_float && (op == ops.star || op == ops.wrapping_mul) {
            "imul"
        } else if !is_float && op == ops.slash {
            if unsigned { "udiv" } else { "sdiv-guarded" }
        } else if !is_float && op == ops.percent {
            if unsigned { "urem" } else { "srem" }
        } else if is_float && op == ops.plus {
            "fadd"
        } else if is_float && op == ops.minus {
            "fsub"
        } else if is_float && op == ops.star {
            "fmul"
        } else if is_float && op == ops.slash {
            "fdiv"
        } else if is_float && op == ops.percent {
            "fmod"
        } else {
            "error operator"
        };
        put(inout self.out, inst_name);
    }

    // The overflow test `checked_arithmetic` emits for `op` on `kind`.
    fn checked_test(in self, op: u32, kind: u32) -> Str {
        let ops = self.ops;
        if kind_wide(kind) {
            return "wide";
        }
        let narrow_signed = kind == 6 || kind == 7 || kind == 8;
        let narrow_unsigned = kind == 1 || kind == 2 || kind == 3;
        let word_unsigned = kind == 4 || kind == 5;
        let word_signed = kind == 9 || kind == 10;
        let add_sub_mul = op == ops.plus || op == ops.minus || op == ops.star;
        if add_sub_mul && narrow_signed {
            "narrow-signed"
        } else if op == ops.slash && narrow_signed {
            "div-min"
        } else if (op == ops.plus || op == ops.star) && narrow_unsigned {
            "narrow-unsigned"
        } else if op == ops.minus && (narrow_unsigned || word_unsigned) {
            "borrow"
        } else if op == ops.plus && word_unsigned {
            "carry"
        } else if op == ops.star && word_unsigned {
            "umulhi"
        } else if (op == ops.plus || op == ops.minus) && word_signed {
            "sign"
        } else if op == ops.star && word_signed {
            "smulhi"
        } else if op == ops.slash && word_signed {
            "div-min"
        } else {
            "none"
        }
    }

    // The `expr_at` arm for `Op::Unary(op, v)` at span (s0, s1).
    fn decide_unary(inout self, op: u32, value: u64, s0: u64, s1: u64) {
        let value_ty = self.value_type(value);
        if value_ty == NONE32 {
            put(inout self.out, in "error untyped");
            return;
        }
        if op == self.ops.tilde {
            put(inout self.out, in "bnot");
            return;
        }
        let conv_word = get(in self.tables.conversions, op);
        if (get(in self.tables.float_flags, op) & FLOAT_INTRINSIC) != 0
            || (conv_word != 0 && self.float_type(value_ty))
        {
            put(inout self.out, in "float-unary");
            return;
        }
        let bit_builtin = get(in self.tables.bit_builtins, op);
        if bit_builtin != 0 {
            put(inout self.out, in "bit ");
            put_bit_op(inout self.out, bit_builtin >> 4);
            self.out.push(32);
            put_kind(inout self.out, bit_builtin & 15);
            return;
        }
        let overflow = self.ctx.world.may_overflow(s0, s1);
        if conv_word != 0 {
            let from = self.kind_of(value_ty);
            if from == 0 {
                put(inout self.out, in "error convert");
                return;
            }
            let conversion = conv_word >> 4;
            let to = conv_word & 15;
            if kind_wide(from) || kind_wide(to) {
                put(inout self.out, in "convert wide ");
                put_conversion(inout self.out, conversion);
                self.out.push(32);
                put_kind(inout self.out, from);
                self.out.push(32);
                put_kind(inout self.out, to);
                if overflow {
                    put(inout self.out, in " checked");
                }
                return;
            }
            if conversion == CONV_WIDEN {
                put(inout self.out, in "convert widen");
            } else if conversion == CONV_WRAPPING {
                put(inout self.out, in "convert wrapping ");
                put_kind(inout self.out, to);
            } else {
                put(inout self.out, in "convert narrow ");
                put_kind(inout self.out, from);
                self.out.push(32);
                put_kind(inout self.out, to);
                if overflow {
                    let high = kind_max(to) < kind_max(from);
                    let low = !kind_unsigned(from)
                        && kind_min_magnitude(to) < kind_min_magnitude(from);
                    if low {
                        put(inout self.out, in " low");
                    }
                    if high {
                        put(inout self.out, in " high");
                    }
                }
            }
            return;
        }
        let kind = self.kind_of(value_ty);
        let lane = self.lane(value_ty);
        let is_float = lane == LANE_F32 || lane == LANE_F64;
        let check = if op == self.ops.minus && kind != 0 && overflow {
            if kind_unsigned(kind) {
                " check=nonzero"
            } else if kind_wide(kind) {
                " check=min128"
            } else {
                " check=min"
            }
        } else {
            ""
        };
        let inst_name = if op == self.ops.minus {
            if is_float { "fneg" } else { "ineg" }
        } else if op == self.ops.bang && !is_float {
            "not"
        } else if op == self.ops.widen_u64 && !is_float {
            "widen"
        } else {
            put(inout self.out, in "error unary");
            return;
        };
        put(inout self.out, inst_name);
        self.out.push(32);
        put_kind(inout self.out, kind);
        put(inout self.out, check);
    }

    // The `expr_at` arm for `Op::Binary(op, a, b)` at span (s0, s1).
    fn decide_binary(inout self, op: u32, lhs: u64, rhs: u64, s0: u64, s1: u64) {
        let lhs_ty = self.value_type(lhs);
        let rhs_ty = self.value_type(rhs);
        if lhs_ty == NONE32 || rhs_ty == NONE32 {
            put(inout self.out, in "error untyped");
            return;
        }
        if (get(in self.tables.float_flags, op) & FLOAT_MATH) != 0 {
            put(inout self.out, in "float-math");
            return;
        }
        let bit_builtin = get(in self.tables.bit_builtins, op);
        if bit_builtin != 0 {
            put(inout self.out, in "bit ");
            put_bit_op(inout self.out, bit_builtin >> 4);
            self.out.push(32);
            put_kind(inout self.out, bit_builtin & 15);
            return;
        }
        let ops = self.ops;
        if op == ops.and_and || op == ops.or_or {
            put(inout self.out, in "logic");
            return;
        }
        let overflow = self.ctx.world.may_overflow(s0, s1);
        let shift = op == ops.shl || op == ops.shr;
        let rotation = get(in self.tables.rotations, op);
        if shift || rotation != 0 {
            let kind = self.kind_of(lhs_ty);
            if kind == 0 {
                put(inout self.out, in "error shift");
                return;
            }
            let shift_inst = if op == ops.shl {
                "ishl"
            } else if op == ops.shr {
                if kind_unsigned(kind) { "ushr" } else { "sshr" }
            } else if rotation == 1 {
                "rotl"
            } else {
                "rotr"
            };
            put(inout self.out, in "shift ");
            put(inout self.out, shift_inst);
            self.out.push(32);
            put_kind(inout self.out, kind);
            if shift && overflow {
                put(inout self.out, in " range");
            }
            return;
        }
        if op == ops.amp || op == ops.pipe || op == ops.caret {
            put(inout self.out, in "bitop ");
            self.name(op);
            return;
        }
        if ops.is_comparison(op) && (self.is_text(lhs_ty) || self.is_text(rhs_ty)) {
            put(inout self.out, in "str-compare ");
            self.name(op);
            return;
        }
        // `i128` and `u128` are two-word scalars (`Layout::build`);
        // @vesper/check-layout predates them (#1174), so they are decided
        // here.
        let lhs_node = self.ctx.types.node(lhs_ty);
        let wide = lhs_node.kind == TyKind::Named
            && lhs_node.n == 0
            && kind_wide(get(in self.tables.kinds, lhs_node.name));
        if (op == ops.eq || op == ops.ne) && !wide {
            let layout_mark = self.layouts.mark();
            let layout = layout_of(
                inout self.layouts,
                inout self.ctx.types,
                inout self.ctx.names,
                in self.ctx.world,
                lhs_ty
            );
            if layout == NONE32 {
                self.layouts.reset(layout_mark);
                put(inout self.out, in "error layout");
                return;
            }
            let aggregate = self.layouts.aggregate(layout);
            self.layouts.reset(layout_mark);
            if aggregate || self.ctx.types.kind(lhs_ty) == TyKind::Fn || self.is_box(lhs_ty) {
                put(inout self.out, in "equal ");
                self.name(op);
                return;
            }
        }
        let kind = self.kind_of(lhs_ty);
        let unsigned = kind_unsigned(kind);
        if (op == ops.slash || op == ops.percent) && self.ctx.world.is_partial(s0, s1) {
            put(inout self.out, in "divisor ");
        }
        let lhs_lane = self.lane(lhs_ty);
        let rhs_lane = self.lane(rhs_ty);
        let bit_intrinsic = get(in self.tables.bit_intrinsics, op);
        if kind != 0 && overflow {
            put(inout self.out, in "checked ");
            put_kind(inout self.out, kind);
            self.out.push(32);
            put(inout self.out, self.checked_test(op, kind));
            self.out.push(32);
            self.binary(op, lhs_lane, rhs_lane, unsigned);
        } else if bit_intrinsic != 0 {
            if kind == 0 {
                put(inout self.out, in "error bitwise-kind");
            } else if lhs_lane != LANE_I64 || rhs_lane != LANE_I64 {
                put(inout self.out, in "error bitwise-lane");
            } else {
                put(inout self.out, in "bitwise ");
                put(
                    inout self.out,
                    if bit_intrinsic == 1 {
                        "&"
                    } else if bit_intrinsic == 2 {
                        "|"
                    } else if bit_intrinsic == 3 {
                        "^"
                    } else if bit_intrinsic == 4 {
                        "<<"
                    } else {
                        ">>"
                    }
                );
                self.out.push(32);
                put_kind(inout self.out, kind);
            }
        } else {
            self.binary(op, lhs_lane, rhs_lane, unsigned);
        }
    }

    // The `const` decision: Rust asks the checker's type at the span.
    fn decide_constant(inout self, inst: InstRow) {
        let lit = self.program.op(inst.a);
        // A literal past `i128::MAX` is an integer too (`Literal::WideInt`).
        if lit == Lit::Int || lit == Lit::WideInt {
            let expr_ty = self.ctx.world.expr_type(inst.s0, inst.s1);
            let wide = if expr_ty == NONE32 {
                false
            } else {
                let defaulted = default_type(inout self.ctx.types, expr_ty);
                self.ctx.types.kind(defaulted) != TyKind::Lit && kind_wide(self.kind_of(defaulted))
            };
            put(inout self.out, if wide { "const wide" } else { "const int" });
        } else if lit == Lit::Float {
            let expr_ty = self.ctx.world.expr_type(inst.s0, inst.s1);
            let is_f32 = if expr_ty == NONE32 {
                false
            } else {
                let defaulted = default_type(inout self.ctx.types, expr_ty);
                self.ctx.types.name(defaulted) == self.ops.f32_
            };
            put(inout self.out, if is_f32 { "const f32" } else { "const f64" });
        } else if lit == Lit::Bool {
            put(inout self.out, in "const bool");
        } else {
            put(inout self.out, in "const string");
        }
    }

    fn terminator(inout self, block_index: u64, term: u8, term_start: u64, term_count: u64) {
        push_decimal(inout self.out, block_index);
        self.out.push(32);
        if term == Term::Return {
            put(inout self.out, in "return");
            if self.never(self.program.op(term_start)) {
                put(inout self.out, in " never");
            }
        } else if term == Term::Jump {
            put(inout self.out, in "jump ");
            push_decimal(inout self.out, self.program.op(term_start));
            let arg_count = self.program.op(inc(term_start));
            for k in 0..arg_count {
                if self.never(self.program.op(add(add(term_start, 2), k))) {
                    put(inout self.out, in " never");
                    push_decimal(inout self.out, k);
                }
            }
        } else if term == Term::Branch {
            put(inout self.out, in "branch ");
            push_decimal(inout self.out, self.program.op(inc(term_start)));
            self.out.push(32);
            push_decimal(inout self.out, self.program.op(add(term_start, 2)));
        } else if term == Term::Match {
            put(inout self.out, in "match ");
            push_decimal(inout self.out, self.program.op(inc(term_start)));
            for k in term_start..add(term_start, term_count) {
                if self.program.tag(k) == Tag::Block {
                    self.out.push(32);
                    push_decimal(inout self.out, self.program.op(k));
                }
            }
        } else {
            put(inout self.out, in "trap");
        }
        self.out.push(10);
    }

    fn function(inout self, func_index: u64) {
        let func = self.program.function(func_index);
        put(inout self.out, in "fn ");
        self.name(func.name);
        self.out.push(10);
        block_layout(in self.program, func, inout self.out);
        self.load_values(func);
        for block_index in 0..func.bc {
            let block = self.program.block(add(func.b0, block_index));
            for inst_index in 0..block.ic {
                let inst = self.program.inst(add(block.i0, inst_index));
                let known = inst.op == Op::Const
                    || inst.op == Op::Unary
                    || inst.op == Op::Binary
                    || inst.op == Op::Loop
                    || inst.op == Op::Exit;
                if known {
                    push_decimal(inout self.out, block_index);
                    self.out.push(46);
                    push_decimal(inout self.out, inst_index);
                    put(inout self.out, in " %");
                    push_decimal(inout self.out, w(inst.dest));
                    self.out.push(32);
                    if inst.op == Op::Const {
                        self.decide_constant(inst);
                    } else if inst.op == Op::Unary {
                        let op = n32(self.program.op(inst.a));
                        put(inout self.out, in "unary ");
                        self.name(op);
                        self.out.push(32);
                        self.decide_unary(op, self.program.op(inc(inst.a)), inst.s0, inst.s1);
                    } else if inst.op == Op::Binary {
                        let op = n32(self.program.op(inst.a));
                        put(inout self.out, in "binary ");
                        self.name(op);
                        self.out.push(32);
                        self.decide_binary(
                            op,
                            self.program.op(inc(inst.a)),
                            self.program.op(add(inst.a, 2)),
                            inst.s0,
                            inst.s1
                        );
                    } else if inst.op == Op::Loop {
                        put(inout self.out, in "loop");
                    } else {
                        put(inout self.out, in "exit ");
                        self.name(n32(self.program.op(inc(inst.a))));
                        if self.never(self.program.op(inst.a)) {
                            put(inout self.out, in " never");
                        }
                    }
                    self.out.push(10);
                }
            }
            self.terminator(block_index, block.term, block.ta, block.tn);
        }
    }

    // ----------------------------------------------------------- the plan

    // The plan's coerce word for a value of checker type `ty` (`expr_at`
    // ends with `coerce(value, ty(e))`): 0 when `coerce` leaves the value
    // alone (no integer kind, or a one-word 64-bit one), the kind of a
    // narrow one, or NONE32 when the port does not emit it (a 128-bit kind,
    // or a type that may name a generic parameter, which `ty` substitutes).
    fn coerce_word(inout self, ty: u32) -> u32 {
        if ty == NONE32 {
            return 0;
        }
        let defaulted = default_type(inout self.ctx.types, ty);
        let node = self.ctx.types.node(defaulted);
        if node.kind == TyKind::Lit {
            return 0;
        }
        if node.kind != TyKind::Named || node.n != 0 {
            return NONE32;
        }
        if node.name == self.ops.bool_ {
            return 0;
        }
        let kind = get(in self.tables.kinds, node.name);
        if kind == 0 || kind_wide(kind) {
            NONE32
        } else if kind_bits(kind) < 64 {
            kind
        } else {
            0
        }
    }

    // Whether an operand of IR type `ty` is a one-word integer or a bool:
    // `expr_at`'s `Name` arm reads it with one `use_var` (no copy, tag or
    // split read), and its kind does not depend on a generic parameter.
    fn plain_operand(in self, ty: u32) -> bool {
        if ty == NONE32 {
            return false;
        }
        let node = self.ctx.types.node(ty);
        if node.kind == TyKind::Lit {
            return true;
        }
        if node.kind != TyKind::Named || node.n != 0 {
            return false;
        }
        if node.name == self.ops.bool_ {
            return true;
        }
        let kind = get(in self.tables.kinds, node.name);
        kind != 0 && !kind_wide(kind)
    }

    // Pushes one plan record: site, request code and its immediates.
    fn record(
        inout self,
        func_index: u64,
        block_index: u64,
        inst_index: u64,
        code: u64,
        a: u64,
        b: u64
    ) {
        self.plan.push(func_index);
        self.plan.push(block_index);
        self.plan.push(inst_index);
        self.plan.push(code);
        self.plan.push(a);
        self.plan.push(b);
    }

    // The plan of `Op::Constant`: `expr_at`'s `Literal` arm and `coerce`.
    fn plan_constant(
        inout self,
        func_index: u64,
        block_index: u64,
        inst_index: u64,
        inst: InstRow
    ) {
        let lit = self.program.op(inst.a);
        let expr_ty = self.ctx.world.expr_type(inst.s0, inst.s1);
        if lit == Lit::Int || lit == Lit::Bool {
            let result_word = self.coerce_word(expr_ty);
            if result_word != NONE32 {
                self.record(
                    func_index,
                    block_index,
                    inst_index,
                    PLAN_ICONST,
                    self.program.op(inc(inst.a)),
                    widen_u64(result_word)
                );
            }
        } else if lit == Lit::Float && expr_ty != NONE32 {
            let defaulted = default_type(inout self.ctx.types, expr_ty);
            let node = self.ctx.types.node(defaulted);
            if node.kind == TyKind::Named && node.n == 0 && node.name == self.ops.f64_ {
                self.record(
                    func_index,
                    block_index,
                    inst_index,
                    PLAN_F64CONST,
                    self.program.op(inc(inst.a)),
                    0
                );
            }
        }
    }

    // The plan of `Op::Unary(op, v)`, in `expr_at`'s arm order.
    fn plan_unary(inout self, func_index: u64, block_index: u64, inst_index: u64, inst: InstRow) {
        let op = n32(self.program.op(inst.a));
        let operand_ty = self.value_type(self.program.op(inc(inst.a)));
        if !self.plain_operand(operand_ty) {
            return;
        }
        let result_word = self.coerce_word(self.ctx.world.expr_type(inst.s0, inst.s1));
        let operand_word = self.coerce_word(operand_ty);
        if result_word == NONE32 || operand_word == NONE32 {
            return;
        }
        // The result's coerce word, and the operand's (`expr_at` reads
        // a `Name` through `coerce` as well), one byte each.
        let coerce_words = widen_u64(result_word | (operand_word << 8));
        let ops = self.ops;
        if op == ops.tilde {
            self.record(func_index, block_index, inst_index, PLAN_BNOT, coerce_words, 0);
            return;
        }
        if (get(in self.tables.float_flags, op) & FLOAT_INTRINSIC) != 0
            || get(in self.tables.bit_builtins, op) != 0
        {
            return;
        }
        let conv_word = get(in self.tables.conversions, op);
        if conv_word != 0 {
            // `Codegen::convert`: a widening is the operand, a wrapping
            // conversion is `coerce` to the target and an unchecked
            // narrowing is the operand; 128-bit kinds and checked
            // narrowings stay on the Rust code.
            let from = self.kind_of(operand_ty);
            let conversion = conv_word >> 4;
            let to = conv_word & 15;
            if from == 0 || kind_wide(from) || kind_wide(to) {
                return;
            }
            if conversion == CONV_NARROW && self.ctx.world.may_overflow(inst.s0, inst.s1) {
                return;
            }
            self.record(
                func_index,
                block_index,
                inst_index,
                PLAN_CONVERT,
                widen_u64(conversion | (to << 8)),
                coerce_words
            );
            return;
        }
        if op == ops.minus {
            if self.kind_of(operand_ty) != 0 && self.ctx.world.may_overflow(inst.s0, inst.s1) {
                return;
            }
            self.record(func_index, block_index, inst_index, PLAN_INEG, coerce_words, 0);
        } else if op == ops.bang {
            self.record(func_index, block_index, inst_index, PLAN_NOT, coerce_words, 0);
        }
    }

    // The condition code of comparison `op` (`Codegen::binary`).
    fn plan_cc(in self, op: u32, unsigned: bool) -> u64 {
        let ops = self.ops;
        if op == ops.eq {
            return CC_EQ;
        }
        if op == ops.ne {
            return CC_NE;
        }
        let base = if op == ops.lt {
            CC_SLT
        } else if op == ops.le {
            CC_SLE
        } else if op == ops.gt {
            CC_SGT
        } else {
            CC_SGE
        };
        if unsigned {
            add(base, CC_UNSIGNED)
        } else {
            base
        }
    }

    // The plan of `Op::Binary(op, a, b)`, in `expr_at`'s arm order.
    fn plan_binary(inout self, func_index: u64, block_index: u64, inst_index: u64, inst: InstRow) {
        let op = n32(self.program.op(inst.a));
        let lhs_ty = self.value_type(self.program.op(inc(inst.a)));
        let rhs_ty = self.value_type(self.program.op(add(inst.a, 2)));
        if !self.plain_operand(lhs_ty) || !self.plain_operand(rhs_ty) {
            return;
        }
        let result_word = self.coerce_word(self.ctx.world.expr_type(inst.s0, inst.s1));
        let lhs_word = self.coerce_word(lhs_ty);
        let rhs_word = self.coerce_word(rhs_ty);
        if result_word == NONE32 || lhs_word == NONE32 || rhs_word == NONE32 {
            return;
        }
        let ops = self.ops;
        // The coerce words of the result and of both operands, one byte
        // each (below).
        if (get(in self.tables.float_flags, op) & FLOAT_MATH) != 0
            || get(in self.tables.bit_builtins, op) != 0
            || op == ops.and_and
            || op == ops.or_or
        {
            return;
        }
        let coerce_words = widen_u64(result_word | (lhs_word << 8) | (rhs_word << 16));
        let rotation = get(in self.tables.rotations, op);
        if op == ops.shl || op == ops.shr || rotation != 0 {
            // `Codegen::shift` on the left operand's kind; a shift the
            // checker could not prove in range stays on the Rust code.
            let kind = self.kind_of(lhs_ty);
            if kind == 0
                || ((op == ops.shl || op == ops.shr)
                    && self.ctx.world.may_overflow(inst.s0, inst.s1))
            {
                return;
            }
            let shift_op = if op == ops.shl {
                SHIFT_ISHL
            } else if op == ops.shr {
                if kind_unsigned(kind) {
                    SHIFT_USHR
                } else {
                    SHIFT_SSHR
                }
            } else if rotation == 1 {
                SHIFT_ROTL
            } else {
                SHIFT_ROTR
            };
            self.record(
                func_index,
                block_index,
                inst_index,
                PLAN_SHIFT,
                shift_op | (widen_u64(kind) << 8),
                coerce_words
            );
            return;
        }
        if op == ops.amp {
            self.record(func_index, block_index, inst_index, PLAN_BINOP, BIN_BAND, coerce_words);
            return;
        } else if op == ops.pipe {
            self.record(func_index, block_index, inst_index, PLAN_BINOP, BIN_BOR, coerce_words);
            return;
        } else if op == ops.caret {
            self.record(func_index, block_index, inst_index, PLAN_BINOP, BIN_BXOR, coerce_words);
            return;
        }
        // Text comparisons and `equal` take non-scalar operands, which
        // `plain_operand` refused.
        let kind = self.kind_of(lhs_ty);
        let unsigned = kind_unsigned(kind);
        if (op == ops.slash || op == ops.percent) && self.ctx.world.is_partial(inst.s0, inst.s1) {
            return;
        }
        if (kind != 0 && self.ctx.world.may_overflow(inst.s0, inst.s1))
            || get(in self.tables.bit_intrinsics, op) != 0
        {
            return;
        }
        if ops.is_comparison(op) {
            self.record(
                func_index,
                block_index,
                inst_index,
                PLAN_ICMP,
                self.plan_cc(op, unsigned),
                coerce_words
            );
            return;
        }
        let bin_op = if op == ops.plus || op == ops.wrapping_add {
            BIN_IADD
        } else if op == ops.minus || op == ops.wrapping_sub {
            BIN_ISUB
        } else if op == ops.star || op == ops.wrapping_mul {
            BIN_IMUL
        } else if op == ops.slash && unsigned {
            BIN_UDIV
        } else if op == ops.percent && unsigned {
            BIN_UREM
        } else if op == ops.percent {
            BIN_SREM
        } else {
            return;
        };
        self.record(func_index, block_index, inst_index, PLAN_BINOP, bin_op, coerce_words);
    }

    // The plan of one function's instructions.
    fn plan_function(inout self, func_index: u64) {
        let func = self.program.function(func_index);
        self.load_values(func);
        for block_index in 0..func.bc {
            let block = self.program.block(add(func.b0, block_index));
            for inst_index in 0..block.ic {
                let inst = self.program.inst(add(block.i0, inst_index));
                if inst.op == Op::Const {
                    self.plan_constant(func_index, block_index, inst_index, inst);
                } else if inst.op == Op::Unit || inst.op == Op::Loop {
                    self.record(func_index, block_index, inst_index, PLAN_ZERO, 0, 0);
                } else if inst.op == Op::Unary {
                    self.plan_unary(func_index, block_index, inst_index, inst);
                } else if inst.op == Op::Binary {
                    self.plan_binary(func_index, block_index, inst_index, inst);
                }
            }
        }
    }
}

// The planner over the input's program and world.
fn read_gen(in bytes: Slice[u8]) -> Gen {
    read_gen_with(in bytes, true)
}

// `read_gen`, reading what follows the program as `scalar_enums` facts
// only when `facts` is set (a calls input has its calls section there).
fn read_gen_with(in bytes: Slice[u8], facts: bool) -> Gen {
    let mut reader = Reader { pos: 0 };
    let mut ctx = read_ctx(inout reader, in bytes);
    let mut program = read_program(inout reader, in bytes, in ctx);
    // The handler facts (#2657), when the input has them.
    let handlers = read_handler_facts(inout reader, in bytes, inout ctx.names, program.fn_count());
    // `scalar_enums` facts after the program (the optimize path's body
    // plans): the graphs as the walk lowers them, small enums as words.
    let enums = if facts && reader.pos < bytes.len() {
        scalar_enum_words(inout ctx, inout program, inout reader, in bytes)
    } else {
        enum_words_none()
    };
    let mut tables = Tables {
        kinds: ChunkSeq::new[u32](),
        conversions: ChunkSeq::new[u32](),
        bit_builtins: ChunkSeq::new[u32](),
        float_flags: ChunkSeq::new[u32](),
        float_ops: ChunkSeq::new[u32](),
        bit_intrinsics: ChunkSeq::new[u32](),
        rotations: ChunkSeq::new[u32]()
    };
    let ops = ops_new(inout ctx.names, inout tables);
    Gen {
        ctx: ctx,
        tables: tables,
        ops: ops,
        layouts: layouts_new(),
        program: program,
        value_types: ChunkSeq::new[u32](),
        out: ChunkSeq::new[u8](),
        plan: ChunkSeq::new[u64](),
        enums: enums,
        fi: 0,
        handlers: handlers,
        hstack: ChunkSeq::new[u64](),
        bound_error: NO_LOCAL,
        handle_row: 0,
        handle_base: 0,
        drops: ChunkSeq::new[u64](),
        temps: ChunkSeq::new[u64](),
        plan_from: ChunkSeq::new[u64](),
        plan_to: ChunkSeq::new[u64]()
    }
}

// The decisions of the input's program, packed by `pack_text`.
pub fn codegen_scalar_decisions(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mut codegen = read_gen(in bytes);
    for func_index in 0..codegen.program.fn_count() {
        codegen.function(func_index);
    }
    pack_text(in codegen.out)
}

// The emission plan of the input's program: six words per instruction the
// `scalar` hook emits, `[function, block, instruction, request, a, b]`
// (functions in program order). Coerce words (`coerce_word`) are packed a
// byte each: the result's, then each operand's. The request and its immediates are the
// `scalar_hook` protocol of @vesper/codegen-scalar-emit; an instruction
// with no record is left to the Rust lowering.
pub fn codegen_scalar_plan(in input: Str) -> ChunkSeq[u64] {
    codegen_scalar_plan_bytes(in input.as_bytes())
}

// `codegen_scalar_plan` of the input's bytes (the hybrid's `scalar` hook,
// crates/vesper-hybrid/modules/codegen_scalar).
pub fn codegen_scalar_plan_bytes(in bytes: Slice[u8]) -> ChunkSeq[u64] {
    let mut codegen = read_gen(in bytes);
    for func_index in 0..codegen.program.fn_count() {
        codegen.plan_function(func_index);
    }
    codegen.plan
}

// The body plans of the native walk's whole-function hook (body.ves,
// #2094): `[function, n, n words]` for each function that
// @vesper/codegen-scalar-emit's `body_hook` emits whole, over the same
// input as `codegen_scalar_plan`.
pub fn codegen_scalar_body_plan_bytes(in bytes: Slice[u8]) -> ChunkSeq[u64] {
    body_plans(read_gen(in bytes))
}

// `codegen_scalar_body_plan_bytes` of the context and program at the
// start of `bytes`, whatever follows them (@vesper/native-lib's calls
// input, bootstrap switch slice 3a of #2349).
pub fn codegen_scalar_body_plan_prefix(in bytes: Slice[u8]) -> ChunkSeq[u64] {
    body_plans(read_gen_with(in bytes, false))
}

fn body_plans(sink codegen: Gen) -> ChunkSeq[u64] {
    let mut codegen = codegen;
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    // Every function's instruction plan first: a handler's nested graphs
    // are planned inside the function that holds it (#2657).
    for func_index in 0..codegen.program.fn_count() {
        codegen.plan_from.push(codegen.plan.len());
        codegen.plan_function(func_index);
        codegen.plan_to.push(codegen.plan.len());
    }
    for func_index in 0..codegen.program.fn_count() {
        let from = u64_at(in codegen.plan_from, func_index);
        codegen.body(func_index, from, inout out);
    }
    out
}

// `codegen_scalar_body_plan_bytes` of a string (the differential's entry,
// crates/vesper-codegen-swap-test/tests/self_host_native_walk_body.rs).
pub fn codegen_scalar_body_plan(in input: Str) -> ChunkSeq[u64] {
    codegen_scalar_body_plan_bytes(in input.as_bytes())
}
