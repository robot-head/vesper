// `IntegerKind::wide`: `i128` (11) and `u128` (12).
const KIND_WIDE_I128: u32 = 11;
const KIND_WIDE_U128: u32 = 12;
const KIND_U8: u32 = 1;
const KIND_U32: u32 = 3;
const KIND_I8: u32 = 6;
const KIND_I32: u32 = 8;

fn kind_wide(k: u32) -> bool {
    k == KIND_WIDE_I128 || k == KIND_WIDE_U128
}

// The kinds below 64 bits that `coerce` reduces: u8, u16, u32, i8, i16,
// i32.
fn kind_narrow(k: u32) -> bool {
    (k >= KIND_U8 && k <= KIND_U32) || (k >= KIND_I8 && k <= KIND_I32)
}

fn f32_bits_of_f64(bits64: u64) -> u64 {
    widen_u64(to_bits_f32(nearest_f32(from_bits_f64(bits64))))
}

fn grow(inout s: ChunkSeq[u64], n: u64) {
    loop {
        if s.len() >= n {
            break;
        }
        s.push(0);
    }
}

fn set(inout s: ChunkSeq[u64], i: u64, x: u64) {
    grow(inout s, inc(i));
    let ok = s.try_set(i, x);
}

pub fn grow_set(inout s: ChunkSeq[u64], i: u64, x: u64) {
    set(inout s, i, x);
}

fn at(in s: ChunkSeq[u64], i: u64) -> u64 {
    if i < s.len() { u64_at(in s, i) } else { 0 }
}

// One function's header, as the body plan reads it.
pub struct Header {
    // parameter names, in order
    params: ChunkSeq[u64],
    result: u32,
    // value id -> its index + 1 (0: not a value of the graph), and back
    index: ChunkSeq[u64],
    vid: ChunkSeq[u64],
    // value index -> its type
    vty: ChunkSeq[u64],
    // local index -> its name and type
    lname: ChunkSeq[u64],
    lty: ChunkSeq[u64],
    // parameter types, in order
    pty: ChunkSeq[u64],
    // the defaulted error type of each `Fail` instance of a `fail_only`
    // row, in row order (record tag `k + 1` is the `k`-th; #2425)
    fails: ChunkSeq[u64],
    // the header names no bounds, captures, or effects other than `Fail`
    // instances and erased capabilities
    plain: bool,
    // the names and handler capabilities the graph takes from outside
    // (a nested graph's)
    captures: u64,
}

impl Gen {
    // The lane code of a value of type `t`, or 0 for a type part 6 does
    // not emit.
    fn body_lane(inout self, t: u32) -> u64 {
        if t == NONE32 {
            return 0;
        }
        let d = default_type(inout self.ctx.types, t);
        let n = self.ctx.types.node(d);
        if n.kind == TyKind::Lit {
            return LANE_I64;
        }
        if n.kind == TyKind::Tuple && n.n == 0 {
            return LANE_I64;
        }
        if n.kind == TyKind::Tuple {
            return self.body_product_lane(d);
        }
        let k = self.ctx.world.k;
        // A slice is its view `{handle, start, len}` (#2653).
        if n.kind == TyKind::Named && n.n == 1 && n.name == k.slice {
            return self.body_product_lane(d);
        }
        // An instance of a generic struct or enum, such as `Secret[u64]`
        // or `Option[i64]` (#2654), kept in memory when its layout is one.
        if n.kind == TyKind::Named && n.n != 0 {
            return self.body_product_lane(d);
        }
        if n.kind != TyKind::Named {
            return 0;
        }
        if n.name == k.f32_ {
            LANE_F32
        } else if n.name == k.f64_ {
            LANE_F64
        } else if n.name == k.bool_ || n.name == k.unit || n.name == k.never {
            LANE_I64
        } else if k.is_integer(n.name) {
            if kind_wide(self.kind_of(d)) {
                LANE_I128
            } else {
                LANE_I64
            }
        } else {
            self.body_product_lane(d)
        }
    }

    // LANE_PRODUCT for a struct or tuple whose fields are all scalars
    // (`Layout::of` a product with no aggregate field), else 0.
    fn body_product_layout_ok(inout self, l: u32) -> bool {
        if l != NONE32 && self.layouts.node(l).kind == L_ENUM {
            return self.body_enum_layout_ok(l);
        }
        if l == NONE32 || self.layouts.node(l).kind != L_PRODUCT {
            return false;
        }
        let node = self.layouts.node(l);
        for k in 0..widen_u64(node.n) {
            let field = self.layouts.lfield(add(widen_u64(node.a), k));
            if self.layouts.aggregate(field.layout) {
                if !self.body_product_layout_ok(field.layout) {
                    return false;
                }
            }
        }
        true
    }

    // An enum kept in memory (#2654) whose variants' fields are register
    // scalars or products of them: its register holds a pointer to its
    // storage, as a product's does.
    fn body_enum_layout_ok(inout self, l: u32) -> bool {
        let node = self.layouts.node(l);
        for k in 0..widen_u64(node.n) {
            let v = self.layouts.lvariant(add(widen_u64(node.a), k));
            for j in 0..widen_u64(v.fc) {
                let field = self.layouts.lfield(add(widen_u64(v.fa), j));
                let fine = if self.layouts.aggregate(field.layout) {
                    let kind = self.layouts.node(field.layout).kind;
                    if kind == L_ENUM {
                        // An enum payload that is itself an enum kept in
                        // memory (the diagnostics port's `Failure::Budget(Res)`,
                        // #2657), copied by words like a product.
                        self.body_enum_layout_ok(field.layout)
                    } else {
                        kind == L_PRODUCT
                            && self.body_product_layout_ok(field.layout)
                            && self.body_plain_product(field.ty)
                    }
                } else {
                    self.body_register(field.ty)
                };
                if !fine {
                    return false;
                }
            }
        }
        true
    }

    // The index of the variant of enum layout `l` that constructor or
    // pattern name `name` names (`Layout::variant`), or NONE64.
    fn body_variant(inout self, l: u32, name: u32) -> u64 {
        let short = short_name(inout self.ctx.names, name);
        let node = self.layouts.node(l);
        for k in 0..widen_u64(node.n) {
            if self.layouts.lvariant(add(widen_u64(node.a), k)).name == short {
                return k;
            }
        }
        NONE64
    }

    fn body_product_lane(inout self, d: u32) -> u64 {
        let mark = self.layouts.mark();
        let l = layout_of(
            inout self.layouts,
            inout self.ctx.types,
            inout self.ctx.names,
            in self.ctx.world,
            d
        );
        let lane: u64 = if self.body_product_layout_ok(l) {
            LANE_PRODUCT
        } else {
            0
        };
        self.layouts.reset(mark);
        lane
    }

    // `Codegen::data_into` of a product (#2411): the fields' values in
    // `ops`, then in `extra` the storage size, the words to zero first on
    // the optimize path (those no field overwrites whole; an `f32` field
    // writes only its low half), and per field its offset, its value's
    // read kind and the kind its store coerces to. False for anything
    // else.
    fn body_data(
        inout self,
        in h: Header,
        i: InstRow,
        inout ops: ChunkSeq[u64],
        inout extra: ChunkSeq[u64]
    ) -> bool {
        if self.body_lane(i.ty) != LANE_PRODUCT {
            return false;
        }
        let mark = self.layouts.mark();
        let d = default_type(inout self.ctx.types, i.ty);
        let l = layout_of(
            inout self.layouts,
            inout self.ctx.types,
            inout self.ctx.names,
            in self.ctx.world,
            d
        );
        let node = self.layouts.node(l);
        // `Op::Data`: name, count, (field, value) pairs; `Op::Tuple`:
        // count, values.
        let data = i.op == Op::Data;
        // An enum's constructor (#2654): its tag, and its variant's fields.
        let mut tag = NO_TAG;
        let mut field_base = widen_u64(node.a);
        let mut field_count = widen_u64(node.n);
        if node.kind == L_ENUM {
            let variant = if data {
                self.body_variant(l, n32(self.program.op(i.a)))
            } else {
                NONE64
            };
            if variant == NONE64 {
                self.layouts.reset(mark);
                return false;
            }
            let v = self.layouts.lvariant(add(widen_u64(node.a), variant));
            tag = variant;
            field_base = widen_u64(v.fa);
            field_count = widen_u64(v.fc);
        }
        let n = if data {
            self.program.op(inc(i.a))
        } else {
            self.program.op(i.a)
        };
        let mut fields: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let mut covered: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let mut ok = true;
        for k in 0..n {
            let (field, at) = if data {
                let pair = add(add(i.a, DATA_HEADER_WORDS), wrapping_mul(k, DATA_PAIR_WORDS));
                let name = n32(self.program.op(pair));
                let mut index = NONE64;
                for j in 0..field_count {
                    if self.layouts.lfield(add(field_base, j)).name == name {
                        index = j;
                    }
                }
                (index, inc(pair))
            } else {
                (k, add(inc(i.a), k))
            };
            if field == NONE64 || field >= field_count || !self.body_operand(in h, at, inout ops) {
                ok = false;
                break;
            }
            let lf = self.layouts.lfield(add(field_base, field));
            let start = wrapping_u64(widen_i64(lf.offset));
            let size = widen_u64(self.layouts.node(lf.layout).size);
            let vt = n32(u64_at(in h.vty, u64_at(in ops, k)));
            if self.body_lane(vt) == LANE_PRODUCT {
                if size % WORD_BYTES != 0 {
                    ok = false;
                    break;
                }
                let mut off = start;
                loop {
                    if off >= add(start, size) {
                        break;
                    }
                    covered.push(off);
                    off = add(off, WORD_BYTES);
                }
                fields.push(start);
                fields.push(0);
                fields.push(add(STORE_AGGREGATE, size));
                continue;
            }
            let ft = default_type(inout self.ctx.types, lf.ty);
            let fnode = self.ctx.types.node(ft);
            let half = fnode.kind == TyKind::Named
                && fnode.n == 0
                && fnode.name == self.ctx.world.k.f32_;
            if !half {
                let mut off = start;
                loop {
                    if off >= add(start, size) {
                        break;
                    }
                    covered.push(off);
                    off = add(off, WORD_BYTES);
                }
            }
            fields.push(start);
            let vd = default_type(inout self.ctx.types, vt);
            let read = self.body_kind(vd);
            let store = self.body_kind(ft);
            fields.push(read);
            fields.push(store);
        }
        let size = widen_u64(node.size);
        // An enum's zeroing ends at its variant's last field (the words
        // past it are inactive payload, §16.6), its tag word written.
        let mut end = if size < WORD_BYTES { WORD_BYTES } else { size };
        if tag != NO_TAG {
            covered.push(0);
            end = 0;
            for j in 0..field_count {
                let lf = self.layouts.lfield(add(field_base, j));
                let last = add(
                    wrapping_u64(widen_i64(lf.offset)),
                    widen_u64(self.layouts.node(lf.layout).size)
                );
                if last > end {
                    end = last;
                }
            }
            if field_count == 0 {
                end = WORD_BYTES;
            }
        }
        self.layouts.reset(mark);
        if !ok {
            return false;
        }
        extra.push(size);
        let mut zeroed: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let mut off: u64 = 0;
        loop {
            if off >= end {
                break;
            }
            let mut hit = false;
            for c in 0..covered.len() {
                if u64_at(in covered, c) == off {
                    hit = true;
                }
            }
            if !hit {
                zeroed.push(off);
            }
            off = add(off, WORD_BYTES);
        }
        extra.push(zeroed.len());
        extra.extend(in zeroed.as_slice());
        extra.push(tag);
        extra.extend(in fields.as_slice());
        true
    }

    // The storage size of a product type (`Layout::of(..).size`).
    fn body_product_size(inout self, t: u32) -> u64 {
        let mark = self.layouts.mark();
        let d = default_type(inout self.ctx.types, t);
        let l = layout_of(
            inout self.layouts,
            inout self.ctx.types,
            inout self.ctx.names,
            in self.ctx.world,
            d
        );
        let size = if l == NONE32 {
            0
        } else {
            widen_u64(self.layouts.node(l).size)
        };
        self.layouts.reset(mark);
        size
    }

    // `Gen::is_register_scalar` of @vesper/native-walk: an integer, float
    // or `bool` local stays a frontend variable.
    fn body_register(inout self, t: u32) -> bool {
        let d = default_type(inout self.ctx.types, t);
        let n = self.ctx.types.node(d);
        if n.kind != TyKind::Named || n.n != 0 {
            return false;
        }
        let k = self.ctx.world.k;
        k.is_integer(n.name) || n.name == k.f32_ || n.name == k.f64_ || n.name == k.bool_
    }

    // The integer kind `Codegen::coerce` adjusts a value of type `t` to:
    // 0 for none, 1..3/6..8 for narrow 1-word kinds, or 11/12 for i128/u128.
    fn body_kind(in self, t: u32) -> u64 {
        if t == NONE32 {
            return 0;
        }
        let k = self.kind_of(t);
        if kind_wide(k) || kind_narrow(k) {
            widen_u64(k)
        } else {
            0
        }
    }

    fn body_expr_kind(inout self, s0: u64, s1: u64) -> u64 {
        let t = self.ctx.world.expr_type(s0, s1);
        if t == NONE32 {
            0
        } else {
            let d = default_type(inout self.ctx.types, t);
            self.body_kind(d)
        }
    }

    fn body_never(in self, t: u32) -> bool {
        t != NONE32 && self.ctx.types.name(t) == self.ctx.world.k.never
    }

    // The header words of `f` (place-ir `header`).
    fn body_header(inout self, f: FnRow) -> Header {
        let mut h = Header {
            params: ChunkSeq::new[u64](),
            result: NONE32,
            index: ChunkSeq::new[u64](),
            vid: ChunkSeq::new[u64](),
            vty: ChunkSeq::new[u64](),
            lname: ChunkSeq::new[u64](),
            lty: ChunkSeq::new[u64](),
            pty: ChunkSeq::new[u64](),
            fails: ChunkSeq::new[u64](),
            plain: true,
            captures: 0
        };
        let mut i = f.ha;
        let np = self.program.op(i);
        i = inc(i);
        for k in 0..np {
            h.params.push(self.program.op(i));
            let nproj = self.program.op(add(i, 2));
            i = add(add(i, 3), nproj);
            h.pty.push(self.program.op(i));
            // type, span start, span end
            i = add(i, 3);
        }
        h.result = n32(self.program.op(i));
        let effects = n32(self.program.op(inc(i)));
        let row = self.ctx.types.row(self.ctx.types.node(effects).r2);
        if row.tail != 0 {
            h.plain = false;
        } else {
            for k in 0..widen_u64(row.n) {
                let eff = self.ctx.types.effect_at(add(widen_u64(row.a), k));
                let eff_name = eff.name;
                let ops_s = self.ops;
                if eff_name == ops_s.fail_ && eff.label == 0 && eff.n == 1 {
                    // `native::fail_only`'s `Fail[E]`: a failure exit.
                    let e = u32_at(in self.ctx.types.items, widen_u64(eff.a));
                    h.fails.push(widen_u64(default_type(inout self.ctx.types, e)));
                } else if eff_name == ops_s.fail_ && eff.label != 0 && eff.n == 1 {
                    // A handler's lexical capability (#2657): a nested
                    // graph raises to the handler in scope; `body`
                    // refuses it.
                    h.captures = inc(h.captures);
                } else if eff_name != ops_s.const_time
                    && eff_name != ops_s.realtime
                    && eff_name != ops_s.det_float
                    && eff_name != ops_s.isa
                {
                    h.plain = false;
                }
            }
        }
        i = add(i, 2);
        let nb = self.program.op(i);
        i = add(inc(i), wrapping_mul(nb, 2));
        let nc = self.program.op(i);
        i = add(inc(i), nc);
        // A handler's nested graph reads the names it captures from the
        // scope it is emitted in (#2657); `body` refuses them.
        h.captures = add(h.captures, nc);
        if nb != 0 {
            h.plain = false;
        }
        let nv = self.program.op(i);
        i = inc(i);
        for k in 0..nv {
            set(inout h.index, self.program.op(i), inc(k));
            h.vid.push(self.program.op(i));
            h.vty.push(self.program.op(inc(i)));
            i = add(i, 2);
        }
        let nl = self.program.op(i);
        i = inc(i);
        for k in 0..nl {
            h.lname.push(self.program.op(i));
            h.lty.push(self.program.op(inc(i)));
            i = add(i, 2);
        }
        h
    }

    // How many words value index `v` of the function being planned is kept
    // as (#2581), 0 when it is not.
    fn body_words(in self, in h: Header, v: u64) -> u64 {
        if v >= h.vid.len() {
            return 0;
        }
        self.enums.count(self.fi, u64_at(in h.vid, v))
    }

    // The index of the `k`-th word value of kept value index `v`, or
    // NONE64.
    fn body_word(in self, in h: Header, v: u64, k: u64) -> u64 {
        self.body_value(in h, self.enums.word(self.fi, u64_at(in h.vid, v), k))
    }

    // The index of value `v`, or NONE64.
    fn body_value(in self, in h: Header, v: u64) -> u64 {
        let x = at(in h.index, v);
        if x == 0 { NONE64 } else { wrapping_sub(x, 1) }
    }

    // The index of local `name`, or NONE64.
    fn body_local(in self, in h: Header, name: u64) -> u64 {
        for k in 0..h.lname.len() {
            if u64_at(in h.lname, k) == name {
                return k;
            }
        }
        NONE64
    }

    // The type a read of local `k` is coerced to: a parameter's declared
    // type, a declared local's type (`Codegen::local_types`).
    fn body_local_type(in self, in h: Header, k: u64) -> u32 {
        let name = u64_at(in h.lname, k);
        for j in 0..h.params.len() {
            if u64_at(in h.params, j) == name {
                return n32(u64_at(in h.pty, j));
            }
        }
        n32(u64_at(in h.lty, k))
    }

    // The value index of an operand word at `i`, pushed to `ops`; false
    // when the graph does not type it.
    fn body_operand(in self, in h: Header, i: u64, inout ops: ChunkSeq[u64]) -> bool {
        let v = self.body_value(in h, self.program.op(i));
        ops.push(v);
        v != NONE64
    }

    // Classifies a 1-operand float intrinsic or conversion (`float_unary`)
    // on an operand of defaulted type `op_def` and lane `op_lane`.
    fn body_float_unary_op(
        in self,
        op: u32,
        op_def: u32,
        op_lane: u64,
        s0: u64,
        s1: u64,
        inout meta: u64
    ) -> u64 {
        meta = 0;
        let is_flt = op_lane == LANE_F32 || op_lane == LANE_F64;
        let fop = get(in self.tables.float_ops, op);
        if fop == FOP_SQRT && is_flt {
            return FUN_SQRT;
        }
        if fop == FOP_ABS && is_flt {
            return FUN_ABS;
        }
        if fop == FOP_FLOOR && is_flt {
            return FUN_FLOOR;
        }
        if fop == FOP_CEIL && is_flt {
            return FUN_CEIL;
        }
        if fop == FOP_TRUNC && is_flt {
            return FUN_TRUNC;
        }
        if fop == FOP_ROUND && is_flt {
            return FUN_ROUND;
        }
        if fop >= FOP_WIDEN_F32 && fop <= FOP_NEAREST_F64 {
            let to_f32 = fop == FOP_WIDEN_F32 || fop == FOP_NEAREST_F32;
            let to_lane = if to_f32 { LANE_F32 } else { LANE_F64 };
            meta = to_lane;
            if op_lane == LANE_F32 {
                return if to_f32 { FUN_FNOOP } else { FUN_FPROMOTE };
            }
            if op_lane == LANE_F64 {
                return if to_f32 { FUN_FDEMOTE } else { FUN_FNOOP };
            }
            if op_lane == LANE_I64 {
                let ik = self.kind_of(op_def);
                if ik == 0 || kind_wide(ik) {
                    return 0;
                }
                return if kind_unsigned(ik) {
                    FUN_FCVT_UINT
                } else {
                    FUN_FCVT_SINT
                };
            }
            return 0;
        }
        if fop == FOP_TO_BITS_F64 && op_lane == LANE_F64 {
            return FUN_TO_BITS_F64;
        }
        if fop == FOP_TO_BITS_F32 && op_lane == LANE_F32 {
            return FUN_TO_BITS_F32;
        }
        if fop == FOP_FROM_BITS_F64 && op_lane == LANE_I64 {
            return FUN_FROM_BITS_F64;
        }
        if fop == FOP_FROM_BITS_F32 && op_lane == LANE_I64 {
            return FUN_FROM_BITS_F32;
        }
        if fop > FOP_SAT_BASE && is_flt {
            let to_ik = wrapping_sub(fop, FOP_SAT_BASE);
            if to_ik == 0 || kind_wide(to_ik) {
                return 0;
            }
            meta = widen_u64(to_ik);
            return FUN_SAT_TO_INT;
        }
        let conv = get(in self.tables.conversions, op);
        if conv != 0 && (conv >> TABLE_OP_SHIFT) == CONV_NARROW && is_flt {
            let to_ik = conv & TABLE_KIND_MASK;
            if to_ik == 0 || kind_wide(to_ik) || self.ctx.world.may_overflow(s0, s1) {
                return 0;
            }
            meta = widen_u64(to_ik);
            return FUN_SAT_TO_INT;
        }
        0
    }

    fn body_unary(
        inout self,
        in h: Header,
        i: InstRow,
        planned: u64,
        inout ops: ChunkSeq[u64],
        inout kind: u64,
        inout extra: ChunkSeq[u64]
    ) -> bool {
        if !self.body_operand(in h, inc(i.a), inout ops) {
            return false;
        }
        let op_ty = n32(u64_at(in h.vty, u64_at(in ops, 0)));
        let op_lane = self.body_lane(op_ty);
        if op_lane == 0 {
            return false;
        }
        if planned != NONE64 && op_lane == LANE_I64 {
            kind = INST_PLANNED;
            return true;
        }
        let op = n32(self.program.op(i.a));
        let op_def = default_type(inout self.ctx.types, op_ty);
        let op_kind = self.body_kind(op_def);
        let res_kind = self.body_expr_kind(i.s0, i.s1);
        if op_kind == NONE64 || res_kind == NONE64 {
            return false;
        }
        let mut meta: u64 = 0;
        let fun = self.body_float_unary_op(op, op_def, op_lane, i.s0, i.s1, inout meta);
        if fun != 0 {
            kind = INST_FLOAT_UNARY;
            extra.push(fun);
            extra.push(meta);
            extra.push(op_kind);
            extra.push(res_kind);
            return true;
        }
        let bit_word = get(in self.tables.bit_builtins, op);
        if bit_word != 0 && op_lane == LANE_I128 {
            let bop = bit_word >> TABLE_OP_SHIFT;
            let bkind = bit_word & TABLE_KIND_MASK;
            if !kind_wide(bkind)
                || (bop != BIT_OP_CLZ
                    && bop != BIT_OP_CTZ
                    && bop != BIT_OP_POPCNT
                    && bop != BIT_OP_WRAPPING_NEG)
            {
                return false;
            }
            kind = INST_WIDE_UNARY;
            extra.push(WUN_BIT);
            extra.push(widen_u64(bop));
            extra.push(widen_u64(bkind));
            extra.push(op_kind);
            extra.push(res_kind);
            return true;
        }
        if bit_word != 0 && op_lane == LANE_I64 {
            let bop = bit_word >> TABLE_OP_SHIFT;
            let bkind = bit_word & TABLE_KIND_MASK;
            if kind_wide(bkind)
                || (bop != BIT_OP_CLZ
                    && bop != BIT_OP_CTZ
                    && bop != BIT_OP_POPCNT
                    && bop != BIT_OP_WRAPPING_NEG)
            {
                return false;
            }
            kind = INST_INT_EXTRA;
            extra.push(IEX_BIT_UNARY);
            extra.push(widen_u64(bop));
            extra.push(widen_u64(bkind));
            extra.push(op_kind);
            extra.push(0);
            extra.push(res_kind);
            return true;
        }
        if op == self.ops.minus && (op_lane == LANE_F32 || op_lane == LANE_F64) {
            kind = INST_FLOAT_UNARY;
            extra.push(FUN_FNEG);
            extra.push(0);
            extra.push(op_kind);
            extra.push(res_kind);
            return true;
        }
        if op == self.ops.widen_u64 && op_lane == LANE_I64 {
            kind = INST_INT_EXTRA;
            extra.push(IEX_WIDEN_U64);
            extra.push(0);
            extra.push(0);
            extra.push(op_kind);
            extra.push(0);
            extra.push(res_kind);
            return true;
        }
        let conv = get(in self.tables.conversions, op);
        if conv != 0 && (op_lane == LANE_I128 || op_lane == LANE_I64) {
            let to_ik = conv & TABLE_KIND_MASK;
            let from_ik = self.kind_of(op_def);
            if from_ik != 0
                && !((conv >> TABLE_OP_SHIFT) == CONV_NARROW
                    && self.ctx.world.may_overflow(i.s0, i.s1))
            {
                let to_kind = if kind_narrow(to_ik) || kind_wide(to_ik) {
                    widen_u64(to_ik)
                } else {
                    0
                };
                if kind_wide(from_ik) || kind_wide(to_ik) {
                    kind = INST_WIDE_UNARY;
                    extra.push(WUN_CONVERT);
                    extra.push(widen_u64(from_ik));
                    extra.push(to_kind);
                    extra.push(op_kind);
                    extra.push(res_kind);
                } else {
                    kind = INST_INT_EXTRA;
                    extra.push(IEX_WORD_CONVERT);
                    extra.push(to_kind);
                    extra.push(0);
                    extra.push(op_kind);
                    extra.push(0);
                    extra.push(res_kind);
                }
                return true;
            }
        }
        if op_lane == LANE_I128 {
            if op == self.ops.tilde {
                kind = INST_WIDE_UNARY;
                extra.push(WUN_BNOT);
                extra.push(0);
                extra.push(0);
                extra.push(op_kind);
                extra.push(res_kind);
                return true;
            }
            if op == self.ops.minus && !self.ctx.world.may_overflow(i.s0, i.s1) {
                kind = INST_WIDE_UNARY;
                extra.push(WUN_INEG);
                extra.push(0);
                extra.push(0);
                extra.push(op_kind);
                extra.push(res_kind);
                return true;
            }
        }
        if op_lane == LANE_I64 {
            let sub_iex = if op == self.ops.tilde {
                IEX_BNOT
            } else if op == self.ops.minus && !self.ctx.world.may_overflow(i.s0, i.s1) {
                IEX_INEG
            } else if op == self.ops.bang {
                IEX_LNOT
            } else {
                0
            };
            if sub_iex != 0 {
                kind = INST_INT_EXTRA;
                extra.push(sub_iex);
                extra.push(0);
                extra.push(0);
                extra.push(op_kind);
                extra.push(0);
                extra.push(res_kind);
                return true;
            }
        }
        false
    }

    fn body_binary(
        inout self,
        in h: Header,
        i: InstRow,
        planned: u64,
        inout ops: ChunkSeq[u64],
        inout kind: u64,
        inout extra: ChunkSeq[u64]
    ) -> bool {
        if !self.body_operand(in h, inc(i.a), inout ops)
            || !self.body_operand(in h, add(i.a, 2), inout ops)
        {
            return false;
        }
        let t0 = n32(u64_at(in h.vty, u64_at(in ops, 0)));
        let t1 = n32(u64_at(in h.vty, u64_at(in ops, 1)));
        let l0 = self.body_lane(t0);
        let l1 = self.body_lane(t1);
        if l0 == 0 || l1 == 0 {
            return false;
        }
        let op = n32(self.program.op(i.a));
        let ops_s = self.ops;
        if l0 == LANE_I128 {
            let d0 = default_type(inout self.ctx.types, t0);
            let d1 = default_type(inout self.ctx.types, t1);
            let k0 = self.body_kind(d0);
            let k1 = self.body_kind(d1);
            let rk = self.body_expr_kind(i.s0, i.s1);
            let bit_word = get(in self.tables.bit_builtins, op);
            if bit_word != 0 && l1 == LANE_I64 {
                let bop = bit_word >> TABLE_OP_SHIFT;
                let bkind = bit_word & TABLE_KIND_MASK;
                if kind_wide(bkind) && (bop == BIT_OP_WRAPPING_SHL || bop == BIT_OP_WRAPPING_SHR) {
                    let wb = if bop == BIT_OP_WRAPPING_SHL {
                        WBIN_SHL
                    } else if kind_unsigned(bkind) {
                        WBIN_USHR
                    } else {
                        WBIN_SSHR
                    };
                    kind = INST_WIDE_BINARY;
                    extra.push(wb);
                    extra.push(k0);
                    extra.push(k1);
                    extra.push(rk);
                    return true;
                }
                return false;
            }
            if l1 != LANE_I128 {
                return false;
            }
            let bit_intr = get(in self.tables.bit_intrinsics, op);
            if bit_intr != 0 && !self.ctx.world.may_overflow(i.s0, i.s1) {
                let wb = if bit_intr == BIT_INTR_AND {
                    WBIN_BAND
                } else if bit_intr == BIT_INTR_OR {
                    WBIN_BOR
                } else if bit_intr == BIT_INTR_XOR {
                    WBIN_BXOR
                } else {
                    0
                };
                if wb != 0 {
                    kind = INST_WIDE_BINARY;
                    extra.push(wb);
                    extra.push(k0);
                    extra.push(k1);
                    extra.push(rk);
                    return true;
                }
            }
            let unsigned = kind_unsigned(self.kind_of(d0));
            let overflow = self.ctx.world.may_overflow(i.s0, i.s1);
            let wb = if op == ops_s.amp {
                WBIN_BAND
            } else if op == ops_s.pipe {
                WBIN_BOR
            } else if op == ops_s.caret {
                WBIN_BXOR
            } else if op == ops_s.wrapping_add || (op == ops_s.plus && !overflow) {
                WBIN_IADD
            } else if op == ops_s.wrapping_sub || (op == ops_s.minus && !overflow) {
                WBIN_ISUB
            } else if op == ops_s.wrapping_mul || (op == ops_s.star && !overflow) {
                WBIN_IMUL
            } else if op == ops_s.eq {
                WBIN_EQ
            } else if op == ops_s.ne {
                WBIN_NE
            } else if op == ops_s.lt {
                if unsigned { WBIN_ULT } else { WBIN_SLT }
            } else if op == ops_s.le {
                if unsigned { WBIN_ULE } else { WBIN_SLE }
            } else if op == ops_s.gt {
                if unsigned { WBIN_UGT } else { WBIN_SGT }
            } else if op == ops_s.ge {
                if unsigned { WBIN_UGE } else { WBIN_SGE }
            } else {
                0
            };
            if wb == 0 {
                return false;
            }
            kind = INST_WIDE_BINARY;
            extra.push(wb);
            extra.push(k0);
            extra.push(k1);
            extra.push(rk);
            return true;
        }
        if l0 != l1 {
            return false;
        }
        if planned != NONE64 && l0 == LANE_I64 {
            kind = INST_PLANNED;
            return true;
        }
        if l0 == LANE_F32 || l0 == LANE_F64 {
            let fop = get(in self.tables.float_ops, op);
            let fb = if fop == FOP_MIN {
                FBIN_MIN
            } else if fop == FOP_MAX {
                FBIN_MAX
            } else if op == ops_s.plus {
                FBIN_ADD
            } else if op == ops_s.minus {
                FBIN_SUB
            } else if op == ops_s.star {
                FBIN_MUL
            } else if op == ops_s.slash {
                if self.ctx.world.is_partial(i.s0, i.s1) {
                    return false;
                }
                FBIN_DIV
            } else if op == ops_s.eq {
                FBIN_EQ
            } else if op == ops_s.ne {
                FBIN_NE
            } else if op == ops_s.lt {
                FBIN_LT
            } else if op == ops_s.le {
                FBIN_LE
            } else if op == ops_s.gt {
                FBIN_GT
            } else if op == ops_s.ge {
                FBIN_GE
            } else {
                0
            };
            if fb == 0 {
                return false;
            }
            kind = INST_FLOAT_BINARY;
            extra.push(fb);
            return true;
        }
        let d0 = default_type(inout self.ctx.types, t0);
        let d1 = default_type(inout self.ctx.types, t1);
        let k0 = self.body_kind(d0);
        let k1 = self.body_kind(d1);
        let rk = self.body_expr_kind(i.s0, i.s1);
        if k0 == NONE64 || k1 == NONE64 || rk == NONE64 {
            return false;
        }
        let bit_word = get(in self.tables.bit_builtins, op);
        if bit_word != 0 {
            let bop = bit_word >> TABLE_OP_SHIFT;
            let bkind = bit_word & TABLE_KIND_MASK;
            if kind_wide(bkind) || (bop != BIT_OP_WRAPPING_SHL && bop != BIT_OP_WRAPPING_SHR) {
                return false;
            }
            kind = INST_INT_EXTRA;
            extra.push(IEX_BIT_BINARY);
            extra.push(widen_u64(bop));
            extra.push(widen_u64(bkind));
            extra.push(k0);
            extra.push(k1);
            extra.push(rk);
            return true;
        }
        let bit_intr = get(in self.tables.bit_intrinsics, op);
        if bit_intr != 0 {
            let ik = self.kind_of(d0);
            if ik == 0 || kind_wide(ik) || self.ctx.world.may_overflow(i.s0, i.s1) {
                return false;
            }
            kind = INST_INT_EXTRA;
            extra.push(IEX_BITWISE);
            extra.push(widen_u64(bit_intr));
            extra.push(widen_u64(ik));
            extra.push(k0);
            extra.push(k1);
            extra.push(rk);
            return true;
        }
        let partial = (op == ops_s.slash || op == ops_s.percent)
            && self.ctx.world.is_partial(i.s0, i.s1);
        let checked_op = if op == ops_s.plus {
            CK_ADD
        } else if op == ops_s.minus {
            CK_SUB
        } else if op == ops_s.star {
            CK_MUL
        } else if op == ops_s.slash {
            CK_DIV
        } else if op == ops_s.percent {
            CK_REM
        } else {
            0
        };
        if checked_op != 0 && (partial || self.ctx.world.may_overflow(i.s0, i.s1)) {
            return self.body_checked(
                in h,
                i,
                checked_op,
                partial,
                d0,
                k0,
                k1,
                rk,
                inout kind,
                inout extra
            );
        }
        if op == ops_s.slash || op == ops_s.percent {
            let ik = self.kind_of(d0);
            if ik == 0
                || kind_wide(ik)
                || self.ctx.world.is_partial(i.s0, i.s1)
                || self.ctx.world.may_overflow(i.s0, i.s1)
            {
                return false;
            }
            let sub_iex = if op == ops_s.slash {
                if kind_unsigned(ik) {
                    IEX_UDIV
                } else {
                    IEX_SDIV
                }
            } else if kind_unsigned(ik) {
                IEX_UREM
            } else {
                IEX_SREM
            };
            kind = INST_INT_EXTRA;
            extra.push(sub_iex);
            extra.push(0);
            extra.push(0);
            extra.push(k0);
            extra.push(k1);
            extra.push(rk);
            return true;
        }
        if op == ops_s.shl || op == ops_s.shr {
            let ik = self.kind_of(d0);
            if ik == 0 || kind_wide(ik) || self.ctx.world.may_overflow(i.s0, i.s1) {
                return false;
            }
            let sub_iex = if op == ops_s.shl {
                IEX_SHL
            } else if kind_unsigned(ik) {
                IEX_USHR
            } else {
                IEX_SSHR
            };
            kind = INST_INT_EXTRA;
            extra.push(sub_iex);
            extra.push(0);
            extra.push(0);
            extra.push(k0);
            extra.push(k1);
            extra.push(rk);
            return true;
        }
        if op == ops_s.wrapping_add
            || op == ops_s.wrapping_sub
            || op == ops_s.wrapping_mul
            || op == ops_s.amp
            || op == ops_s.pipe
            || op == ops_s.caret
        {
            let sub_iex = if op == ops_s.wrapping_add {
                IEX_WRAPPING_ADD
            } else if op == ops_s.wrapping_sub {
                IEX_WRAPPING_SUB
            } else if op == ops_s.wrapping_mul {
                IEX_WRAPPING_MUL
            } else if op == ops_s.amp {
                IEX_BAND
            } else if op == ops_s.pipe {
                IEX_BOR
            } else {
                IEX_BXOR
            };
            kind = INST_INT_EXTRA;
            extra.push(sub_iex);
            extra.push(0);
            extra.push(0);
            extra.push(k0);
            extra.push(k1);
            extra.push(rk);
            return true;
        }
        let ik = self.kind_of(d0);
        if ik != 0 && !kind_wide(ik) {
            let unsigned = kind_unsigned(ik);
            let overflow = self.ctx.world.may_overflow(i.s0, i.s1);
            let wb = if op == ops_s.plus && !overflow {
                WBIN_IADD
            } else if op == ops_s.minus && !overflow {
                WBIN_ISUB
            } else if op == ops_s.star && !overflow {
                WBIN_IMUL
            } else if op == ops_s.eq {
                WBIN_EQ
            } else if op == ops_s.ne {
                WBIN_NE
            } else if op == ops_s.lt {
                if unsigned { WBIN_ULT } else { WBIN_SLT }
            } else if op == ops_s.le {
                if unsigned { WBIN_ULE } else { WBIN_SLE }
            } else if op == ops_s.gt {
                if unsigned { WBIN_UGT } else { WBIN_SGT }
            } else if op == ops_s.ge {
                if unsigned { WBIN_UGE } else { WBIN_SGE }
            } else {
                0
            };
            if wb != 0 {
                kind = INST_INT_EXTRA;
                extra.push(IEX_WORD_BIN);
                extra.push(wb);
                extra.push(0);
                extra.push(k0);
                extra.push(k1);
                extra.push(rk);
                return true;
            }
        } else if op == ops_s.eq || op == ops_s.ne {
            let n0 = self.ctx.types.node(d0);
            if n0.kind == TyKind::Named && n0.n == 0 && n0.name == self.ctx.world.k.bool_ {
                kind = INST_INT_EXTRA;
                extra.push(IEX_WORD_BIN);
                extra.push(if op == ops_s.eq { WBIN_EQ } else { WBIN_NE });
                extra.push(0);
                extra.push(k0);
                extra.push(k1);
                extra.push(rk);
                return true;
            }
        }
        false
    }

    // `expr_at`'s general `Binary` arm on one-word integers when it raises
    // (#2425): the divisor test of a partial `/` or `%` (`check_divisor`),
    // then `checked_arithmetic`'s overflow test, each raising through the
    // function's failure record, then `binary`. Words: the operator, the
    // integer kind, the operand and result kinds, then a raise descriptor
    // for the divisor (or NO_RAISE) and one for the overflow (or NO_RAISE).
    fn body_checked(
        inout self,
        in h: Header,
        i: InstRow,
        checked_op: u64,
        partial: bool,
        d0: u32,
        k0: u64,
        k1: u64,
        rk: u64,
        inout kind: u64,
        inout extra: ChunkSeq[u64]
    ) -> bool {
        let ik = self.kind_of(d0);
        if ik == 0 || kind_wide(ik) {
            return false;
        }
        kind = INST_CHECKED;
        extra.push(checked_op);
        extra.push(widen_u64(ik));
        extra.push(k0);
        extra.push(k1);
        extra.push(rk);
        if partial {
            let ops_s = self.ops;
            if !self.body_raise(in h, ops_s.runtime_error, ops_s.division_by_zero, inout extra) {
                return false;
            }
        } else {
            extra.push(NO_RAISE);
        }
        if self.ctx.world.may_overflow(i.s0, i.s1) {
            let ops_s = self.ops;
            if !self.body_raise(in h, ops_s.arith_overflow, 0, inout extra) {
                return false;
            }
        } else {
            extra.push(NO_RAISE);
        }
        true
    }

    // The raise descriptor of a payload-free constructor of the named
    // type `ty_name` (`variant` names the enum variant, 0 for a product):
    // the `Fail` instance `perform_values` selects
    // (`instance_capability_key`: the last instance of exactly that type),
    // the type's size, and the variant's tag (NO_TAG for a product). False
    // when the row has no such instance or the constructor has fields.
    fn body_raise(
        inout self,
        in h: Header,
        ty_name: u32,
        variant: u32,
        inout extra: ChunkSeq[u64]
    ) -> bool {
        let mut index = NONE64;
        let mut ty = NONE32;
        for k in 0..h.fails.len() {
            let t = n32(u64_at(in h.fails, k));
            let n = self.ctx.types.node(t);
            if n.kind == TyKind::Named && n.n == 0 && n.name == ty_name {
                index = k;
                ty = t;
            }
        }
        // A handler in scope takes the raise first (#2657).
        let named = self.ctx.types.named0(ty_name);
        let handled = self.handled_raise(named);
        if handled != NONE64 {
            index = handled;
            ty = named;
        }
        if index == NONE64 {
            return false;
        }
        let mark = self.layouts.mark();
        let l = layout_of(
            inout self.layouts,
            inout self.ctx.types,
            inout self.ctx.names,
            in self.ctx.world,
            ty
        );
        if l == NONE32 {
            self.layouts.reset(mark);
            return false;
        }
        let node = self.layouts.node(l);
        let variants = widen_u64(node.a);
        let mut tag = NONE64;
        if node.kind == L_ENUM {
            for k in 0..widen_u64(node.n) {
                let v = self.layouts.lvariant(add(variants, k));
                if v.name == variant && v.fc == 0 {
                    tag = k;
                }
            }
        } else if node.kind == L_PRODUCT && node.n == 0 {
            tag = NO_TAG;
        }
        self.layouts.reset(mark);
        if tag == NONE64 {
            return false;
        }
        extra.push(index);
        extra.push(widen_u64(node.size));
        extra.push(tag);
        true
    }

    // An explicit `Fail::raise(error)` (#2657, `Codegen::perform`'s
    // `fail_exit` or handler clause): its one `sink` argument as the
    // operand, then the instance that takes it, the error's size, its
    // scalar kind or AGGREGATE_ERROR when it is copied by words, and the
    // kind its temporary is read back as. The instance is the one
    // `instance_capability_key` selects: with an explicit type argument the
    // innermost handler of that type, else the last `Fail` instance of it;
    // without one, by name: the innermost handler, else the row's last
    // `Fail` instance. False for a labelled capability, an instance of
    // another type than the error's, or an error of any other shape.
    fn body_raise_call(
        inout self,
        in h: Header,
        i: InstRow,
        call: u64,
        inout builtin_calls: ChunkSeq[u64],
        inout ops: ChunkSeq[u64],
        inout extra: ChunkSeq[u64]
    ) -> bool {
        let nargs = self.program.op(inc(i.a));
        let after = add(add(i.a, CALL_ARGS), wrapping_mul(nargs, CALL_ARG_WORDS));
        let ntypes = self.program.op(after);
        let cap = self.program.op(add(inc(after), ntypes));
        if nargs != 1 || ntypes > 1 || cap != 0 {
            return false;
        }
        let base = add(i.a, CALL_ARGS);
        if self.program.op(base) != PASS_SINK {
            return false;
        }
        if !self.body_operand(in h, inc(base), inout ops) {
            return false;
        }
        let t = default_type(inout self.ctx.types, n32(u64_at(in h.vty, u64_at(in ops, 0))));
        let mut index = NONE64;
        if ntypes == 1 {
            let named = default_type(inout self.ctx.types, n32(self.program.op(inc(after))));
            if named != t {
                return false;
            }
            for k in 0..h.fails.len() {
                if n32(u64_at(in h.fails, k)) == t {
                    index = k;
                }
            }
            let handled = self.handled_raise(t);
            if handled != NONE64 {
                index = handled;
            }
        } else if self.hstack.len() != 0 {
            let top = wrapping_sub(self.hstack.len(), 1);
            if self.handled_raise(t) != add(HANDLER_BASE, top) {
                return false;
            }
            index = add(HANDLER_BASE, top);
        } else if h.fails.len() != 0 {
            let last = wrapping_sub(h.fails.len(), 1);
            if n32(u64_at(in h.fails, last)) != t {
                return false;
            }
            index = last;
        }
        if index == NONE64 {
            return false;
        }
        let mark = self.layouts.mark();
        let l = layout_of(
            inout self.layouts,
            inout self.ctx.types,
            inout self.ctx.names,
            in self.ctx.world,
            t
        );
        if l == NONE32 {
            self.layouts.reset(mark);
            return false;
        }
        let size = widen_u64(self.layouts.node(l).size);
        let aggregate = self.layouts.aggregate(l);
        self.layouts.reset(mark);
        let scalar_kind = if aggregate {
            AGGREGATE_ERROR
        } else if self.body_lane(t) == LANE_I64 {
            self.body_kind(t)
        } else {
            return false;
        };
        let read = self.body_kind(n32(u64_at(in h.vty, u64_at(in ops, 0))));
        builtin_calls.push(call);
        extra.push(index);
        extra.push(size);
        extra.push(scalar_kind);
        extra.push(read);
        true
    }

    // Whether the function being planned has a struct or enum it knows
    // nothing of the words of (#2654): a call's result, or one joined at a
    // block parameter. The walk coerces a narrow field read from such
    // storage once more where it is used, which the plan does not model.
    fn body_opaque_products(inout self, in h: Header) -> bool {
        let f = self.program.function(self.fi);
        for bi in 0..f.bc {
            let row = self.program.block(add(f.b0, bi));
            let pa = self.body_params_at(row.ha);
            for k in 0..self.program.op(pa) {
                let v = self.body_value(in h, self.program.op(add(inc(pa), k)));
                if v != NONE64 && self.body_lane(n32(u64_at(in h.vty, v))) == LANE_PRODUCT {
                    return true;
                }
            }
            for ii in 0..row.ic {
                let x = self.program.inst(add(row.i0, ii));
                if x.op == Op::Call && self.body_lane(x.ty) == LANE_PRODUCT {
                    return true;
                }
            }
        }
        false
    }

    // The function named `name` (place-ir row index), or NONE64.
    fn body_function(in self, name: u32) -> u64 {
        for k in 0..self.program.fn_count() {
            if self.program.function(k).name == name {
                return k;
            }
        }
        NONE64
    }

    // A `fail_only` callee's record and re-raise (`call_function_into`,
    // `reraise_status`): the record's size (`fail_record_size`: a tag
    // word and the largest payload), then for each of the callee's `Fail`
    // instances the caller's instance raising it again (the last of the
    // same type, as `instance_capability_key` selects), its error's size,
    // and its scalar kind or AGGREGATE_ERROR when it is copied by words.
    fn body_reraise(
        inout self,
        in h: Header,
        in callee_fails: ChunkSeq[u64],
        inout extra: ChunkSeq[u64]
    ) -> bool {
        let mut words: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let mut payload = RECORD_WORD;
        for k in 0..callee_fails.len() {
            let t = n32(u64_at(in callee_fails, k));
            let mut index = NONE64;
            for j in 0..h.fails.len() {
                if n32(u64_at(in h.fails, j)) == t {
                    index = j;
                }
            }
            // A handler in scope takes the raise first (#2657).
            let handled = self.handled_raise(t);
            if handled != NONE64 {
                index = handled;
            }
            if index == NONE64 {
                return false;
            }
            let mark = self.layouts.mark();
            let l = layout_of(
                inout self.layouts,
                inout self.ctx.types,
                inout self.ctx.names,
                in self.ctx.world,
                t
            );
            if l == NONE32 {
                self.layouts.reset(mark);
                return false;
            }
            let size = widen_u64(self.layouts.node(l).size);
            let aggregate = self.layouts.aggregate(l);
            self.layouts.reset(mark);
            let scalar_kind = if aggregate {
                AGGREGATE_ERROR
            } else {
                // A one-word integer or `bool` error: loaded as a word,
                // stored after `coerce` to its kind.
                if self.body_lane(t) != LANE_I64 {
                    return false;
                }
                self.body_kind(t)
            };
            if size > payload {
                payload = size;
            }
            words.push(index);
            words.push(size);
            words.push(scalar_kind);
        }
        let rounded = wrapping_mul(
            wrapping_add(payload, wrapping_sub(RECORD_WORD, 1)) / RECORD_WORD,
            RECORD_WORD
        );
        extra.push(add(RECORD_WORD, rounded));
        extra.push(callee_fails.len());
        extra.extend(in words.as_slice());
        true
    }

    // Whether product type `t` holds only register scalars and products of
    // them (#2654): a pattern over it loads its fields and binds no `Box`
    // or handle the walk would drop.
    fn body_plain_product(inout self, t: u32) -> bool {
        let mark = self.layouts.mark();
        let d = default_type(inout self.ctx.types, t);
        let l = layout_of(
            inout self.layouts,
            inout self.ctx.types,
            inout self.ctx.names,
            in self.ctx.world,
            d
        );
        let mut ok = l != NONE32 && self.layouts.node(l).kind == L_PRODUCT;
        if ok {
            let node = self.layouts.node(l);
            for k in 0..widen_u64(node.n) {
                let lf = self.layouts.lfield(add(widen_u64(node.a), k));
                let fine = if self.layouts.aggregate(lf.layout) {
                    self.body_plain_product(lf.ty)
                } else {
                    self.body_register(lf.ty)
                };
                if !fine {
                    ok = false;
                    break;
                }
            }
        }
        self.layouts.reset(mark);
        ok
    }

    // The nodes of pattern `p` (place-ir words, prefix order) over a value
    // of type `t` (#2654), appended to `o`: the walk's `bind_ir` when
    // `bind`, else its `pattern_condition`. Answers the word after the
    // pattern, or NONE64 to leave the function to the walk.
    fn body_pattern(
        inout self,
        in h: Header,
        p: u64,
        t: u32,
        bind: bool,
        inout o: ChunkSeq[u64]
    ) -> u64 {
        let pkind = self.program.op(p);
        if pkind == Pat::Wild {
            o.push(PNODE_NONE);
            return add(p, PAT_WILD_WORDS);
        }
        if pkind == Pat::Bind {
            if bind {
                let k = self.body_local(in h, self.program.op(add(p, PAT_BIND_NAME_OFFSET)));
                if k == NONE64 {
                    return NONE64;
                }
                o.push(PNODE_LOCAL);
                o.push(k);
            } else {
                o.push(PNODE_NONE);
            }
            return add(p, PAT_BIND_WORDS);
        }
        if pkind == Pat::Literal {
            if bind {
                o.push(PNODE_NONE);
                return add(p, PAT_LIT_WORDS);
            }
            let lkind = self.program.op(add(p, PAT_LIT_KIND_OFFSET));
            if (lkind != Lit::Int && lkind != Lit::Bool) || self.body_lane(t) != LANE_I64 {
                return NONE64;
            }
            o.push(PNODE_INT);
            o.push(self.program.op(add(p, PAT_LIT_LO_OFFSET)));
            return add(p, PAT_LIT_WORDS);
        }
        let tuple = pkind == Pat::Tuple;
        if (!tuple && pkind != Pat::Constructor) || self.body_lane(t) != LANE_PRODUCT {
            return NONE64;
        }
        let n = if tuple {
            self.program.op(add(p, PAT_TUPLE_COUNT_OFFSET))
        } else {
            self.program.op(add(p, PAT_CTOR_COUNT_OFFSET))
        };
        let mut q = if tuple {
            add(p, PAT_TUPLE_WORDS)
        } else {
            add(p, PAT_CTOR_WORDS)
        };
        let mark = self.layouts.mark();
        let d = default_type(inout self.ctx.types, t);
        let l = layout_of(
            inout self.layouts,
            inout self.ctx.types,
            inout self.ctx.names,
            in self.ctx.world,
            d
        );
        let node = self.layouts.node(l);
        let mut field_base = widen_u64(node.a);
        let mut field_count = widen_u64(node.n);
        if node.kind == L_ENUM {
            // An enum constructor (#2654): its variant's fields, tested
            // against its tag first when it is an arm's condition.
            let variant = if tuple {
                NONE64
            } else {
                self.body_variant(l, n32(self.program.op(add(p, PAT_CTOR_NAME_OFFSET))))
            };
            if variant == NONE64 {
                self.layouts.reset(mark);
                return NONE64;
            }
            let v = self.layouts.lvariant(add(widen_u64(node.a), variant));
            field_base = widen_u64(v.fa);
            field_count = widen_u64(v.fc);
            if bind {
                o.push(PNODE_FIELDS);
            } else {
                o.push(PNODE_TAG);
                o.push(variant);
            }
        } else {
            // `pattern_condition` of `()` is no product: left to the walk.
            if !self.body_plain_product(t) || (tuple && (n == 0 || n > field_count)) {
                self.layouts.reset(mark);
                return NONE64;
            }
            o.push(PNODE_FIELDS);
        }
        o.push(n);
        for k in 0..n {
            let mut index = NONE64;
            if tuple {
                index = k;
            } else {
                let name = n32(self.program.op(q));
                q = inc(q);
                for j in 0..field_count {
                    if self.layouts.lfield(add(field_base, j)).name == name {
                        index = j;
                    }
                }
            }
            if index == NONE64 {
                q = NONE64;
                break;
            }
            let lf = self.layouts.lfield(add(field_base, index));
            o.push(wrapping_u64(widen_i64(lf.offset)));
            o.push(self.body_lane(lf.ty));
            q = self.body_pattern(in h, q, lf.ty, bind, inout o);
            if q == NONE64 {
                break;
            }
        }
        self.layouts.reset(mark);
        q
    }

    fn body_write(
        inout self,
        in h: Header,
        i: InstRow,
        inout ops: ChunkSeq[u64],
        inout kind: u64,
        inout extra: ChunkSeq[u64]
    ) -> bool {
        let place = self.program.op(i.a);
        let assign = n32(self.program.op(inc(i.a)));
        let k = self.body_local(in h, place);
        if k == NONE64 || !self.body_operand(in h, add(i.a, 2), inout ops) {
            return false;
        }
        let val_ty = default_type(inout self.ctx.types, n32(u64_at(in h.vty, u64_at(in ops, 0))));
        let temp = self.body_kind(val_ty);
        let stated = self.body_expr_kind(i.s0, i.s1);
        if temp == NONE64 || stated == NONE64 {
            return false;
        }
        let ops_s = self.ops;
        if assign == ops_s.assign {
            kind = INST_WRITE;
            extra.push(k);
            extra.push(temp);
            extra.push(stated);
            return true;
        }
        let local_ty = default_type(inout self.ctx.types, self.body_local_type(in h, k));
        let local_lane = self.body_lane(local_ty);
        let local_kind = self.body_kind(local_ty);
        if local_lane == 0
            || local_kind == NONE64
            || self.body_lane(val_ty) != local_lane
            || ((assign == ops_s.slash_eq || assign == ops_s.percent_eq)
                && self.ctx.world.is_partial(i.s0, i.s1))
        {
            return false;
        }
        let ik = self.kind_of(local_ty);
        if ik != 0 && self.ctx.world.may_overflow(i.s0, i.s1) {
            return false;
        }
        let wop = if local_lane == LANE_F32 || local_lane == LANE_F64 {
            if assign == ops_s.plus_eq {
                WOP_FADD
            } else if assign == ops_s.minus_eq {
                WOP_FSUB
            } else if assign == ops_s.star_eq {
                WOP_FMUL
            } else if assign == ops_s.slash_eq {
                WOP_FDIV
            } else {
                0
            }
        } else if assign == ops_s.amp_eq {
            WOP_BAND
        } else if assign == ops_s.pipe_eq {
            WOP_BOR
        } else if assign == ops_s.caret_eq {
            WOP_BXOR
        } else if ik == 0 {
            0
        } else if assign == ops_s.plus_eq {
            WOP_IADD
        } else if assign == ops_s.minus_eq {
            WOP_ISUB
        } else if assign == ops_s.star_eq {
            WOP_IMUL
        } else if kind_wide(ik) {
            0
        } else if assign == ops_s.slash_eq {
            if kind_unsigned(ik) {
                WOP_UDIV
            } else {
                WOP_SDIV
            }
        } else if assign == ops_s.percent_eq {
            if kind_unsigned(ik) {
                WOP_UREM
            } else {
                WOP_SREM
            }
        } else {
            0
        };
        if wop == 0 {
            return false;
        }
        kind = INST_WRITE_OP;
        extra.push(k);
        extra.push(wop);
        extra.push(temp);
        extra.push(local_kind);
        extra.push(stated);
        true
    }

    fn body_call_builtin(
        inout self,
        in h: Header,
        i: InstRow,
        call: u64,
        inout builtin_calls: ChunkSeq[u64],
        inout ops: ChunkSeq[u64],
        inout kind: u64,
        inout extra: ChunkSeq[u64]
    ) -> bool {
        let callee = n32(self.program.op(i.a));
        let nargs = self.program.op(inc(i.a));
        let after = add(add(i.a, CALL_ARGS), wrapping_mul(nargs, CALL_ARG_WORDS));
        let ntypes = self.program.op(after);
        let cap = self.program.op(add(inc(after), ntypes));
        if ntypes != 0 || cap != 0 {
            return false;
        }
        for fi in 0..self.program.fn_count() {
            if self.program.function(fi).name == callee {
                return false;
            }
        }
        let mut arg_lanes: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let mut arg_defs: ChunkSeq[u32] = ChunkSeq::new[u32]();
        let mut arg_kinds: ChunkSeq[u64] = ChunkSeq::new[u64]();
        for m in 0..nargs {
            let base = add(add(i.a, CALL_ARGS), wrapping_mul(m, CALL_ARG_WORDS));
            if self.program.op(base) != PASS_IN
                || self.program.op(add(base, CALL_ARG_ROOT_OFFSET)) != 0
            {
                return false;
            }
            if !self.body_operand(in h, inc(base), inout ops) {
                return false;
            }
            let vt = n32(u64_at(in h.vty, u64_at(in ops, m)));
            let lane = self.body_lane(vt);
            let def = default_type(inout self.ctx.types, vt);
            let ak = self.body_kind(def);
            if lane == 0 || ak == NONE64 {
                return false;
            }
            arg_lanes.push(lane);
            arg_defs.push(def);
            arg_kinds.push(ak);
        }
        let bit_word = get(in self.tables.bit_builtins, callee);
        if bit_word != 0 {
            let bop = bit_word >> TABLE_OP_SHIFT;
            let bkind = bit_word & TABLE_KIND_MASK;
            let arity: u64 = if bop == BIT_OP_WRAPPING_SHL || bop == BIT_OP_WRAPPING_SHR {
                2
            } else {
                1
            };
            if nargs != arity {
                return false;
            }
            if kind_wide(bkind) {
                if u64_at(in arg_lanes, 0) != LANE_I128
                    || (arity == 2 && u64_at(in arg_lanes, 1) != LANE_I64)
                {
                    return false;
                }
                kind = INST_CALL_BUILTIN;
                builtin_calls.push(call);
                extra.push(CB_WIDE_BIT);
                extra.push(widen_u64(bop));
                extra.push(widen_u64(bkind));
                extra.push(0);
                for m in 0..nargs {
                    extra.push(u64_at(in arg_kinds, m));
                }
                return true;
            }
            for m in 0..nargs {
                if u64_at(in arg_lanes, m) != LANE_I64 {
                    return false;
                }
            }
            kind = INST_CALL_BUILTIN;
            builtin_calls.push(call);
            extra.push(CB_BIT);
            extra.push(widen_u64(bop));
            extra.push(widen_u64(bkind));
            extra.push(0);
            for m in 0..nargs {
                extra.push(u64_at(in arg_kinds, m));
            }
            return true;
        }
        if callee == self.ops.widen_u64 && nargs == 1 && u64_at(in arg_lanes, 0) == LANE_I64 {
            kind = INST_CALL_BUILTIN;
            builtin_calls.push(call);
            extra.push(CB_WIDEN_U64);
            extra.push(0);
            extra.push(0);
            extra.push(0);
            extra.push(u64_at(in arg_kinds, 0));
            return true;
        }
        let bit_intr = get(in self.tables.bit_intrinsics, callee);
        if bit_intr != 0 && nargs == 2 {
            let l0 = u64_at(in arg_lanes, 0);
            let l1 = u64_at(in arg_lanes, 1);
            if l0 != LANE_I64 || l1 != LANE_I64 || self.ctx.world.may_overflow(i.s0, i.s1) {
                return false;
            }
            let op_def = match arg_defs.try_get(0) {
                Option::Some(d) => d,
                Option::None => return false,
            };
            let ik = self.kind_of(op_def);
            if ik == 0 || kind_wide(ik) {
                return false;
            }
            kind = INST_CALL_BUILTIN;
            builtin_calls.push(call);
            extra.push(CB_BITWISE);
            extra.push(widen_u64(bit_intr));
            extra.push(widen_u64(ik));
            extra.push(u64_at(in arg_kinds, 0));
            for m in 0..nargs {
                extra.push(u64_at(in arg_kinds, m));
            }
            return true;
        }
        let ops_s = self.ops;
        if nargs == 2
            && (callee == ops_s.wrapping_add
                || callee == ops_s.wrapping_sub
                || callee == ops_s.wrapping_mul)
        {
            let l0 = u64_at(in arg_lanes, 0);
            let l1 = u64_at(in arg_lanes, 1);
            if l0 == l1 && (l0 == LANE_I64 || l0 == LANE_I128) {
                let wb = if callee == ops_s.wrapping_add {
                    WBIN_IADD
                } else if callee == ops_s.wrapping_sub {
                    WBIN_ISUB
                } else {
                    WBIN_IMUL
                };
                kind = INST_CALL_BUILTIN;
                builtin_calls.push(call);
                extra.push(CB_WRAPPING_BIN);
                extra.push(wb);
                extra.push(0);
                extra.push(0);
                for m in 0..nargs {
                    extra.push(u64_at(in arg_kinds, m));
                }
                return true;
            }
        }
        let conv = get(in self.tables.conversions, callee);
        if conv != 0 && nargs == 1 {
            let l0 = u64_at(in arg_lanes, 0);
            if l0 == LANE_I128 || l0 == LANE_I64 {
                let op_def = match arg_defs.try_get(0) {
                    Option::Some(d) => d,
                    Option::None => return false,
                };
                let to_ik = conv & TABLE_KIND_MASK;
                let from_ik = self.kind_of(op_def);
                if from_ik != 0
                    && !((conv >> TABLE_OP_SHIFT) == CONV_NARROW
                        && self.ctx.world.may_overflow(i.s0, i.s1))
                {
                    let to_kind = if kind_narrow(to_ik) || kind_wide(to_ik) {
                        widen_u64(to_ik)
                    } else {
                        0
                    };
                    kind = INST_CALL_BUILTIN;
                    builtin_calls.push(call);
                    if kind_wide(from_ik) || kind_wide(to_ik) {
                        extra.push(CB_WIDE_CONVERT);
                        extra.push(widen_u64(from_ik));
                        extra.push(to_kind);
                        extra.push(0);
                    } else {
                        extra.push(CB_WORD_CONVERT);
                        extra.push(to_kind);
                        extra.push(0);
                        extra.push(0);
                    }
                    extra.push(u64_at(in arg_kinds, 0));
                    return true;
                }
            }
        }
        let fop = get(in self.tables.float_ops, callee);
        if fop == FOP_FMA && nargs == 3 {
            let l0 = u64_at(in arg_lanes, 0);
            if (l0 != LANE_F32 && l0 != LANE_F64)
                || u64_at(in arg_lanes, 1) != l0
                || u64_at(in arg_lanes, 2) != l0
            {
                return false;
            }
            kind = INST_CALL_BUILTIN;
            builtin_calls.push(call);
            extra.push(CB_FMA);
            extra.push(0);
            extra.push(0);
            extra.push(0);
            for m in 0..nargs {
                extra.push(u64_at(in arg_kinds, m));
            }
            return true;
        }
        if (fop == FOP_MIN || fop == FOP_MAX) && nargs == 2 {
            let l0 = u64_at(in arg_lanes, 0);
            if (l0 != LANE_F32 && l0 != LANE_F64) || u64_at(in arg_lanes, 1) != l0 {
                return false;
            }
            kind = INST_CALL_BUILTIN;
            builtin_calls.push(call);
            extra.push(if fop == FOP_MIN { CB_FMIN } else { CB_FMAX });
            extra.push(0);
            extra.push(0);
            extra.push(0);
            for m in 0..nargs {
                extra.push(u64_at(in arg_kinds, m));
            }
            return true;
        }
        if nargs == 1 {
            let site_kind = self.body_expr_kind(i.s0, i.s1);
            if site_kind == NONE64 {
                return false;
            }
            let op_def = match arg_defs.try_get(0) {
                Option::Some(d) => d,
                Option::None => return false,
            };
            let mut meta: u64 = 0;
            let fun = self.body_float_unary_op(
                callee,
                op_def,
                u64_at(in arg_lanes, 0),
                i.s0,
                i.s1,
                inout meta
            );
            if fun != 0 {
                kind = INST_CALL_BUILTIN;
                builtin_calls.push(call);
                extra.push(CB_FLOAT_UNARY);
                extra.push(fun);
                extra.push(meta);
                extra.push(site_kind);
                extra.push(u64_at(in arg_kinds, 0));
                return true;
            }
        }
        false
    }

    // One instruction's plan words, or false to leave the function to the
    // Rust walk. `planned` is the plan's record of it (NONE64: none).
    fn body_inst(
        inout self,
        in h: Header,
        fname: u32,
        i: InstRow,
        planned: u64,
        call: u64,
        inout builtin_calls: ChunkSeq[u64],
        inout o: ChunkSeq[u64]
    ) -> bool {
        let dest = self.body_value(in h, widen_u64(i.dest));
        if dest == NONE64 {
            return false;
        }
        let ty = default_type(inout self.ctx.types, i.ty);
        let post = self.body_kind(ty);
        // A small enum kept as words is only made by a call (#2581) or a
        // sequence operation's `Option` (#2654).
        let kept = self.body_words(in h, dest);
        if post == NONE64
            || (self.body_lane(i.ty) == 0 && !(kept != 0 && (i.op == Op::Call || i.op == Op::Seq)))
        {
            return false;
        }
        // `ir_inline::operands`, which the walk reads before the arm.
        let mut ops: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let mut kind = INST_PLANNED;
        let mut extra: ChunkSeq[u64] = ChunkSeq::new[u64]();
        if i.op == Op::Const || i.op == Op::Unit || i.op == Op::Loop {
            if planned == NONE64 {
                if i.op == Op::Unit || i.op == Op::Loop {
                    kind = INST_ICONST;
                    extra.push(0);
                } else if i.op != Op::Const {
                    return false;
                } else {
                    let lit = self.program.op(i.a);
                    let expr_ty = self.ctx.world.expr_type(i.s0, i.s1);
                    let is_wide_int = if lit == Lit::WideInt {
                        true
                    } else if lit == Lit::Int && expr_ty != NONE32 {
                        let expr_def = default_type(inout self.ctx.types, expr_ty);
                        kind_wide(self.kind_of(expr_def))
                    } else {
                        false
                    };
                    if is_wide_int {
                        kind = INST_WIDE_CONST;
                        extra.push(self.program.op(inc(i.a)));
                        extra.push(self.program.op(add(i.a, 2)));
                        extra.push(self.body_expr_kind(i.s0, i.s1));
                    } else if lit == Lit::Int || lit == Lit::Bool {
                        kind = INST_ICONST;
                        extra.push(self.program.op(inc(i.a)));
                    } else if lit == Lit::Float {
                        let is_f32 = if expr_ty != NONE32 {
                            let d = default_type(inout self.ctx.types, expr_ty);
                            let node = self.ctx.types.node(d);
                            node.kind == TyKind::Named && node.n == 0 && node.name == self.ops.f32_
                        } else {
                            false
                        };
                        if is_f32 {
                            kind = INST_F32CONST;
                            extra.push(f32_bits_of_f64(self.program.op(inc(i.a))));
                        } else {
                            kind = INST_F64CONST;
                            extra.push(self.program.op(inc(i.a)));
                        }
                    } else if lit == Lit::String {
                        kind = INST_SEQ;
                        self.body_literal(n32(self.program.op(inc(i.a))), inout extra);
                    } else {
                        return false;
                    }
                }
            }
        } else if i.op == Op::Exit {
            if n32(self.program.op(inc(i.a))) != fname || !self.body_operand(in h, i.a, inout ops) {
                return false;
            }
            kind = INST_EXIT;
            let vty = n32(u64_at(in h.vty, u64_at(in ops, 0)));
            extra.push(self.body_default(vty, h.result));
        } else if i.op == Op::Unary {
            if !self.body_unary(in h, i, planned, inout ops, inout kind, inout extra) {
                return false;
            }
        } else if i.op == Op::Binary {
            if !self.body_binary(in h, i, planned, inout ops, inout kind, inout extra) {
                return false;
            }
        } else if i.op == Op::Read {
            let root = self.program.op(i.a);
            let path_id = self.program.op(inc(i.a));
            let path = self.program.path(path_id);
            let nproj = self.program.op(add(i.a, 3));
            let k = self.body_local(in h, root);
            if k == NONE64 || nproj != 0 {
                return false;
            }
            if path.n == 0 {
                let local_ty = self.body_local_type(in h, k);
                if self.body_lane(local_ty) == LANE_PRODUCT {
                    let pass = self.program.op(add(i.a, 2));
                    if pass == PASS_IN {
                        kind = INST_READ;
                        extra.push(k);
                        extra.push(0);
                    } else if pass == PASS_SINK {
                        let size = self.body_product_size(local_ty);
                        if size == 0 || size % WORD_BYTES != 0 {
                            return false;
                        }
                        kind = INST_READ_COPY;
                        extra.push(k);
                        extra.push(size);
                    } else {
                        return false;
                    }
                } else {
                    let read = self.body_kind(local_ty);
                    if read == NONE64 {
                        return false;
                    }
                    kind = INST_READ;
                    extra.push(k);
                    extra.push(read);
                }
            } else {
                let res_lane = self.body_lane(i.ty);
                if res_lane == 0 || res_lane == LANE_PRODUCT || post != 0 {
                    return false;
                }
                let mut cur_ty = self.body_local_type(in h, k);
                let mut offs: ChunkSeq[u64] = ChunkSeq::new[u64]();
                let mut ok = true;
                for s in 0..path.n {
                    let field_sym = self.program.path_name(path_id, s);
                    let mark = self.layouts.mark();
                    let d = default_type(inout self.ctx.types, cur_ty);
                    let l = layout_of(
                        inout self.layouts,
                        inout self.ctx.types,
                        inout self.ctx.names,
                        in self.ctx.world,
                        d
                    );
                    let mut found = false;
                    let mut off: u64 = 0;
                    let mut next_ty: u32 = NONE32;
                    if l != NONE32 && self.layouts.node(l).kind == L_PRODUCT {
                        let node = self.layouts.node(l);
                        for fi in 0..widen_u64(node.n) {
                            let lf = self.layouts.lfield(add(widen_u64(node.a), fi));
                            if lf.name == field_sym {
                                off = wrapping_u64(widen_i64(lf.offset));
                                next_ty = lf.ty;
                                found = true;
                            }
                        }
                    }
                    self.layouts.reset(mark);
                    if !found {
                        ok = false;
                        break;
                    }
                    offs.push(off);
                    cur_ty = next_ty;
                }
                if !ok {
                    return false;
                }
                if self.body_kind(i.ty) != 0 && self.body_opaque_products(in h) {
                    return false;
                }
                kind = INST_READ_FIELD;
                extra.push(k);
                extra.push(res_lane);
                extra.push(offs.len());
                extra.extend(in offs.as_slice());
            }
        } else if i.op == Op::Bind {
            kind = INST_BIND;
            if !self.body_operand(in h, i.a, inout ops) {
                return false;
            }
            // pattern: kind, span start, span end, then a Bind's name
            let pat = self.program.op(inc(i.a));
            let fused = self.body_fused_at(u64_at(in ops, 0));
            if fused != NONE64 {
                // An arm's bind of a fused read (`seq_fused_bind`): `Some(x)`
                // loads the element at the read's address into `x`.
                kind = INST_BIND_FUSED;
                let mut next: u64 = 0;
                let mut bound: u64 = 0;
                let stride = u64_at(in self.fused, add(fused, FUSED_STRIDE));
                if self.body_fused_pattern(inc(i.a), inout next, inout bound) == NONE64
                    || stride == 0
                {
                    return false;
                }
                if bound == NONE64 {
                    extra.push(NO_LOCAL);
                } else {
                    let k = self.body_local(in h, bound);
                    if k == NONE64 {
                        return false;
                    }
                    extra.push(k);
                }
                extra.push(stride);
                extra.push(u64_at(in self.fused, add(fused, FUSED_LANE)));
            } else if pat == Pat::Wild {
                extra.push(NO_LOCAL);
            } else if pat == Pat::Bind {
                let k = self.body_local(in h, self.program.op(add(i.a, 4)));
                if k == NONE64 {
                    return false;
                }
                extra.push(k);
            } else if pat == Pat::Tuple || pat == Pat::Constructor {
                // A struct or tuple destructured (#2654).
                kind = INST_BIND_FIELDS;
                let vt = n32(u64_at(in h.vty, u64_at(in ops, 0)));
                if self.body_pattern(in h, inc(i.a), vt, true, inout extra) == NONE64 {
                    return false;
                }
            } else {
                return false;
            }
        } else if i.op == Op::Write {
            if !self.body_write(in h, i, inout ops, inout kind, inout extra) {
                return false;
            }
        } else if i.op == Op::Data || i.op == Op::Tuple {
            kind = INST_DATA;
            if !self.body_data(in h, i, inout ops, inout extra) {
                return false;
            }
        } else if i.op == Op::Project {
            if !self.body_operand(in h, i.a, inout ops) {
                return false;
            }
            let base_ty = n32(u64_at(in h.vty, u64_at(in ops, 0)));
            let res_lane = self.body_lane(i.ty);
            if self.body_lane(base_ty) != LANE_PRODUCT
                || res_lane == 0
                || res_lane == LANE_PRODUCT
            {
                return false;
            }
            let field_sym = n32(self.program.op(inc(i.a)));
            let mark = self.layouts.mark();
            let d = default_type(inout self.ctx.types, base_ty);
            let l = layout_of(
                inout self.layouts,
                inout self.ctx.types,
                inout self.ctx.names,
                in self.ctx.world,
                d
            );
            let mut found = false;
            let mut off: u64 = 0;
            if l != NONE32 && self.layouts.node(l).kind == L_PRODUCT {
                let node = self.layouts.node(l);
                for k in 0..widen_u64(node.n) {
                    let lf = self.layouts.lfield(add(widen_u64(node.a), k));
                    if lf.name == field_sym {
                        off = wrapping_u64(lf.offset);
                        found = true;
                    }
                }
            }
            self.layouts.reset(mark);
            if !found {
                return false;
            }
            if self.body_kind(i.ty) != 0 && self.body_opaque_products(in h) {
                return false;
            }
            kind = INST_PROJECT;
            extra.push(off);
            extra.push(res_lane);
        } else if i.op == Op::Seq {
            kind = INST_SEQ;
            if !self.body_seq(in h, i, dest, kept, inout ops, inout extra) {
                return false;
            }
        } else if i.op == Op::Handle {
            kind = INST_HANDLE;
            let row = self.handle_row;
            let base = self.handle_base;
            if !self.body_handle(in h, i, row, base, inout builtin_calls, inout extra) {
                return false;
            }
        } else if i.op == Op::Call && n32(self.program.op(i.a)) == self.ops.fail_raise {
            kind = INST_RAISE;
            if !self.body_raise_call(in h, i, call, inout builtin_calls, inout ops, inout extra) {
                return false;
            }
        } else if i.op == Op::Call {
            let mut bops: ChunkSeq[u64] = ChunkSeq::new[u64]();
            if self.body_call_builtin(
                in h,
                i,
                call,
                inout builtin_calls,
                inout bops,
                inout kind,
                inout extra
            ) {
                ops.extend(in bops.as_slice());
            } else {
                // Part 6b: a direct call (`Codegen::plain_call`); a
                // `fail_only` callee's failures raised again (#2425).
                let callee = if h.fails.len() == 0 && self.hstack.len() == 0 {
                    NONE64
                } else {
                    self.body_function(n32(self.program.op(i.a)))
                };
                let mut callee_fails: ChunkSeq[u64] = ChunkSeq::new[u64]();
                if callee != NONE64 {
                    let ch = self.body_header(self.program.function(callee));
                    callee_fails = ch.fails;
                }
                kind = if callee_fails.len() != 0 {
                    INST_FAIL_CALL
                } else if kept != 0 {
                    INST_WORDS_CALL
                } else {
                    INST_CALL
                };
                if kind == INST_FAIL_CALL && kept != 0 {
                    return false;
                }
                extra.push(call);
                let mut n = self.program.op(inc(i.a));
                if self.body_has_inout(i, n) {
                    // A pure callee that borrows scalar locals `inout`
                    // (#2563): the `In` arguments are operands; each
                    // `inout` one names its local and lane.
                    // A `fail_only` callee also takes a failure record,
                    // whose failure is raised again (#2614).
                    let fails = kind == INST_FAIL_CALL;
                    kind = INST_INOUT_CALL;
                    if !self.body_inout_args(in h, i, n, inout ops, inout extra) {
                        return false;
                    }
                    if fails && !self.body_reraise(in h, in callee_fails, inout extra) {
                        return false;
                    }
                    n = 0;
                }
                for k in 0..n {
                    let at = add(add(i.a, CALL_ARGS), wrapping_mul(k, CALL_ARG_WORDS));
                    if !self.body_operand(in h, inc(at), inout ops) {
                        return false;
                    }
                    let read = self.body_kind(n32(u64_at(in h.vty, u64_at(in ops, k))));
                    if read == NONE64 {
                        return false;
                    }
                    extra.push(read);
                }
                if kind == INST_FAIL_CALL
                    && !self.body_reraise(in h, in callee_fails, inout extra)
                {
                    return false;
                }
                // A struct or enum result (#2654): its size, which the
                // caller's storage for it takes (0 for a scalar result).
                if kind == INST_CALL {
                    extra.push(
                        if self.body_lane(i.ty) == LANE_PRODUCT {
                            self.body_product_size(i.ty)
                        } else {
                            0
                        }
                    );
                }
                // The result's words (`Codegen::scalar_call_words`): each
                // word value and the kind it is coerced to.
                if kind == INST_WORDS_CALL {
                    extra.push(kept);
                    for k in 0..kept {
                        let word = self.body_word(in h, dest, k);
                        if word == NONE64 {
                            return false;
                        }
                        extra.push(word);
                        extra.push(self.body_kind(n32(u64_at(in h.vty, word))));
                    }
                }
            }
        } else {
            return false;
        }
        // A kept enum is only made by a call or an `Option` result of a
        // sequence operation (`body_option`) and returned: any other
        // instruction that names one is left to the walk.
        if kept != 0 && kind != INST_WORDS_CALL && kind != INST_SEQ {
            return false;
        }
        for k in 0..ops.len() {
            if self.body_words(in h, u64_at(in ops, k)) != 0 {
                return false;
            }
            // A fused read is only bound by its match's arms.
            if kind != INST_BIND_FUSED && self.body_fused_at(u64_at(in ops, k)) != NONE64 {
                return false;
            }
        }
        // A product is only built (INST_DATA) and returned: any other
        // instruction that makes or reads one is left to the walk.
        // A sequence operation reads its view and may make one
        // (`body_seq`).
        if kind != INST_DATA && kind != INST_WORDS_CALL && kind != INST_SEQ {
            if self.body_lane(i.ty) == LANE_PRODUCT
                && kind != INST_READ
                && kind != INST_READ_COPY
                && kind != INST_CALL
            {
                return false;
            }
            if kind != INST_PROJECT
                && kind != INST_BIND
                && kind != INST_BIND_FIELDS
                && kind != INST_BIND_FUSED
                && kind != INST_CALL
                && kind != INST_RAISE
            {
                for k in 0..ops.len() {
                    if self.body_lane(n32(u64_at(in h.vty, u64_at(in ops, k)))) == LANE_PRODUCT {
                        return false;
                    }
                }
            }
        }
        o.push(kind);
        o.push(dest);
        o.push(post);
        // `set_location`'s offset (`native::source_loc`), or NONE64 for an
        // instruction with no span.
        o.push(
            if i.s1 == 0 {
                NONE64
            } else if i.s0 > MAX_SRCLOC {
                MAX_SRCLOC
            } else {
                i.s0
            }
        );
        o.push(ops.len());
        for k in 0..ops.len() {
            o.push(u64_at(in ops, k));
        }
        if kind == INST_PLANNED {
            for k in PLAN_REQUEST_START..PLAN_REQUEST_END {
                o.push(u64_at(in self.plan, add(planned, k)));
            }
        }
        for k in 0..extra.len() {
            o.push(u64_at(in extra, k));
        }
        true
    }

    // `Codegen::seq_op` of a string or slice operation (#2653) that reads
    // its operands only: `Str`/`String` `len`, `as_str`, `as_bytes` and
    // `byte_at`, and `Slice` `len` and `get` of a one-word integer, `bool`
    // or `f64` element. The operands go in `ops`, the form and its words
    // in `extra`: a word's offset, or for a checked access the raise of
    // `RuntimeError::IndexOutOfBounds` (`seq_guard`) and, for a slice
    // element, its stride and lane. False for any other operation.
    // A string literal's words (`SEQ_LITERAL`): its byte count, then its
    // bytes eight to a word, little-endian, the last word zero-padded.
    fn body_literal(in self, symbol: u32, inout extra: ChunkSeq[u64]) {
        let mut bytes: ChunkSeq[u8] = ChunkSeq::new[u8]();
        self.ctx.names.write(symbol, inout bytes);
        extra.push(SEQ_LITERAL);
        extra.push(bytes.len());
        let mut word: u64 = 0;
        let mut shift: u32 = 0;
        for k in 0..bytes.len() {
            word = word | wrapping_shl_u64(widen_u64(u8_at(in bytes, k)), shift);
            shift = wrapping_add(shift, BYTE_BITS);
            if shift == WORD_BITS {
                extra.push(word);
                word = 0;
                shift = 0;
            }
        }
        if shift != 0 {
            extra.push(word);
        }
    }

    fn body_seq(
        inout self,
        in h: Header,
        i: InstRow,
        dest: u64,
        kept: u64,
        inout ops: ChunkSeq[u64],
        inout extra: ChunkSeq[u64]
    ) -> bool {
        // pool row, count, then each argument's call-style words
        let label = self.program.pool_row(self.program.op(i.a)).label;
        let n = self.program.op(inc(i.a));
        for k in 0..n {
            let at = add(add(i.a, CALL_ARGS), wrapping_mul(k, CALL_ARG_WORDS));
            if !self.body_operand(in h, inc(at), inout ops) {
                return false;
            }
        }
        if n == 0 {
            return false;
        }
        let receiver = default_type(inout self.ctx.types, n32(u64_at(in h.vty, u64_at(in ops, 0))));
        let node = self.ctx.types.node(receiver);
        let k = self.ctx.world.k;
        let text = node.kind == TyKind::Named
            && node.n == 0
            && (node.name == k.string || node.name == k.str_);
        let slice = node.kind == TyKind::Named && node.n == 1 && node.name == k.slice;
        let ops_s = self.ops;
        // A `try_get` fused with its block's `match`: the bounds check and
        // the element address (`seq_fused_try_get`), its stride and lane
        // kept for the arms' binds.
        let fused = self.body_fused_at(dest);
        if fused != NONE64 {
            if !slice || n != 2 || label != ops_s.seq_try_get || kept != 0 {
                return false;
            }
            let (stride, lane) = self.body_elem(receiver);
            if stride == 0 {
                return false;
            }
            set(inout self.fused, add(fused, FUSED_STRIDE), stride);
            set(inout self.fused, add(fused, FUSED_LANE), lane);
            extra.push(SEQ_FUSED_TRY_GET);
            extra.push(stride);
            return true;
        }
        // An `Option` result kept as its tag and payload words (#2653).
        if slice && n == 1 && label == ops_s.seq_last {
            return self.body_seq_option(in h, i, dest, kept, receiver, inout extra);
        }
        if kept != 0 {
            return false;
        }
        if text && n == 1 && label == ops_s.seq_str_len {
            extra.push(SEQ_WORD);
            extra.push(STR_LEN_OFFSET);
            return true;
        }
        if text && n == 1 && label == ops_s.seq_str_as_str {
            extra.push(SEQ_SAME);
            return true;
        }
        if text && n == 1 && label == ops_s.seq_str_as_bytes {
            extra.push(SEQ_AS_BYTES);
            return true;
        }
        if slice && n == 1 && label == ops_s.seq_slice_len {
            extra.push(SEQ_VIEW_WORD);
            extra.push(SLICE_LEN_OFFSET);
            return true;
        }
        if text && n == 2 && label == ops_s.seq_str_byte_at {
            extra.push(SEQ_BYTE_AT);
            return self.body_raise(
                in h,
                ops_s.runtime_error,
                ops_s.index_out_of_bounds,
                inout extra
            );
        }
        if slice && n == 2 && label == ops_s.seq_slice_get {
            let (stride, lane) = self.body_elem(receiver);
            if stride == 0 {
                return false;
            }
            extra.push(SEQ_GET);
            extra.push(stride);
            extra.push(lane);
            return self.body_raise(
                in h,
                ops_s.runtime_error,
                ops_s.index_out_of_bounds,
                inout extra
            );
        }
        if text && n == 2 && label == ops_s.seq_str_try_byte_at {
            extra.push(SEQ_TRY_BYTE_AT);
            return self.body_option(in h, i, self.ctx.world.k.u8_, inout extra);
        }
        if slice && n == 2 && label == ops_s.seq_try_get {
            let (stride, lane) = self.body_elem(receiver);
            if stride == 0 {
                return false;
            }
            extra.push(SEQ_TRY_GET);
            extra.push(stride);
            extra.push(lane);
            let elem = default_type(inout self.ctx.types, self.ctx.types.arg(receiver, 0));
            return self.body_option(in h, i, self.ctx.types.node(elem).name, inout extra);
        }
        false
    }

    // A slice's element as `seq_load_elem` loads it: its stride
    // (`seq::elem_bytes`) and lane, for a one-word integer, `bool` or
    // `f64`; stride 0 for any other element.
    fn body_elem(inout self, receiver: u32) -> (u64, u64) {
        let k = self.ctx.world.k;
        let elem = default_type(inout self.ctx.types, self.ctx.types.arg(receiver, 0));
        let lane = self.body_lane(elem);
        let en = self.ctx.types.node(elem);
        if en.kind != TyKind::Named || en.n != 0 || (lane != LANE_I64 && lane != LANE_F64) {
            return (0, 0);
        }
        let stride = if en.name == k.u8_ || en.name == k.bool_ {
            STRIDE_BYTE
        } else if en.name == k.u16_ {
            STRIDE_HALF
        } else if en.name == k.u32_ {
            STRIDE_QUARTER
        } else {
            self.body_product_size(elem)
        };
        if stride != STRIDE_BYTE
            && stride != STRIDE_HALF
            && stride != STRIDE_QUARTER
            && stride != STRIDE_WORD
        {
            return (0, 0);
        }
        // A four-byte float loads as a zero-extended word.
        if lane == LANE_F64 && stride != STRIDE_WORD {
            return (0, 0);
        }
        (stride, lane)
    }

    // `seq_option`'s `Option` of the element named `elem_name` (a plain
    // scalar) that instruction `i` makes (#2654): its size, `Some` and
    // `None` tags, payload offset, the end of the payload's store (for the
    // optimize path's zeroing of the other words), the kind the payload
    // store coerces to, then the words it is kept as (0, or each word
    // value and its kind). False for any other result.
    fn body_option(
        inout self,
        in h: Header,
        i: InstRow,
        elem_name: u32,
        inout extra: ChunkSeq[u64]
    ) -> bool {
        let dest = self.body_value(in h, widen_u64(i.dest));
        let kept = self.body_words(in h, dest);
        let d = default_type(inout self.ctx.types, i.ty);
        let node = self.ctx.types.node(d);
        if node.kind != TyKind::Named || node.n != 1 {
            return false;
        }
        let elem = default_type(inout self.ctx.types, self.ctx.types.arg(d, 0));
        let en = self.ctx.types.node(elem);
        let lane = self.body_lane(elem);
        if en.kind != TyKind::Named || en.n != 0 || en.name != elem_name {
            return false;
        }
        if kept != 0 && (kept != OPTION_WORDS || lane != LANE_I64) {
            return false;
        }
        if kept == 0 && self.body_lane(d) != LANE_PRODUCT {
            return false;
        }
        let mark = self.layouts.mark();
        let l = layout_of(
            inout self.layouts,
            inout self.ctx.types,
            inout self.ctx.names,
            in self.ctx.world,
            d
        );
        if l == NONE32 || self.layouts.node(l).kind != L_ENUM {
            self.layouts.reset(mark);
            return false;
        }
        let some = self.body_variant(l, self.ops.option_some);
        let none = self.body_variant(l, self.ops.option_none);
        let ln = self.layouts.node(l);
        let size = widen_u64(ln.size);
        let mut payload = NONE64;
        if some != NONE64 {
            let v = self.layouts.lvariant(add(widen_u64(ln.a), some));
            if v.fc != 0 {
                payload = wrapping_u64(widen_i64(self.layouts.lfield(widen_u64(v.fa)).offset));
            }
        }
        self.layouts.reset(mark);
        if none == NONE64 || payload == NONE64 {
            return false;
        }
        // An `f32` payload store writes only the low half of its word.
        let end = if elem_name == self.ctx.world.k.f32_ {
            payload
        } else {
            add(payload, self.body_product_size(elem))
        };
        extra.push(size);
        extra.push(some);
        extra.push(none);
        extra.push(payload);
        extra.push(end);
        extra.push(self.body_kind(elem));
        extra.push(kept);
        for k in 0..kept {
            let word = self.body_word(in h, dest, k);
            if word == NONE64 {
                return false;
            }
            extra.push(word);
            extra.push(self.body_kind(n32(u64_at(in h.vty, word))));
        }
        true
    }

    // A slice's `last` (#2653), whose `Option` result the optimize path
    // keeps as its tag and payload words (`aggregates::scalar_enums`,
    // `seq_option` with a two-word request): the form, the element's
    // stride, the `None` and `Some` tags, then each word's value and the
    // kind it is coerced to. False when the result is kept in memory, or
    // its element is a float (the payload word is an integer).
    fn body_seq_option(
        inout self,
        in h: Header,
        i: InstRow,
        dest: u64,
        kept: u64,
        receiver: u32,
        inout extra: ChunkSeq[u64]
    ) -> bool {
        if kept != OPTION_WORDS {
            return false;
        }
        let ops_s = self.ops;
        let (stride, lane) = self.body_elem(receiver);
        if stride == 0 || lane != LANE_I64 {
            return false;
        }
        extra.push(SEQ_LAST);
        extra.push(stride);
        // The tags of `Option`'s variants (`Layout::variant`).
        let mark = self.layouts.mark();
        let d = default_type(inout self.ctx.types, i.ty);
        let l = layout_of(
            inout self.layouts,
            inout self.ctx.types,
            inout self.ctx.names,
            in self.ctx.world,
            d
        );
        let mut none_tag = NONE64;
        let mut some_tag = NONE64;
        if l != NONE32 && self.layouts.node(l).kind == L_ENUM {
            let node = self.layouts.node(l);
            for k in 0..widen_u64(node.n) {
                let v = self.layouts.lvariant(add(widen_u64(node.a), k));
                if v.name == ops_s.option_none {
                    none_tag = k;
                } else if v.name == ops_s.option_some {
                    some_tag = k;
                }
            }
        }
        self.layouts.reset(mark);
        if none_tag == NONE64 || some_tag == NONE64 {
            return false;
        }
        extra.push(none_tag);
        extra.push(some_tag);
        for k in 0..kept {
            let word = self.body_word(in h, dest, k);
            if word == NONE64 {
                return false;
            }
            extra.push(word);
            extra.push(self.body_kind(n32(u64_at(in h.vty, word))));
        }
        true
    }

    // The default a `Never` value of type `t` stands for (`default_value`
    // of the type it flows to): 0 when the value is not `Never`.
    fn body_default(inout self, value_type: u32, target: u32) -> u64 {
        if self.body_never(value_type) {
            self.body_lane(target)
        } else {
            0
        }
    }

    // A block's terminator, or false to leave the function to Rust.
    fn body_terminator(
        inout self,
        in h: Header,
        f: FnRow,
        bi: u64,
        inout o: ChunkSeq[u64]
    ) -> bool {
        let row = self.program.block(add(f.b0, bi));
        let ta = row.ta;
        if row.term == Term::Return {
            let v = self.body_value(in h, self.program.op(ta));
            if v == NONE64 || self.body_fused_at(v) != NONE64 {
                return false;
            }
            // A small enum result returned as words (#2581): each word's
            // register; any other return of such a function reads its words
            // from memory, which the walk does.
            let returned = self.enums.returns(self.fi);
            let kept = self.body_words(in h, v);
            if returned != 0 || kept != 0 {
                if kept != returned {
                    return false;
                }
                o.push(TERM_RETURN_WORDS);
                o.push(v);
                o.push(kept);
                for k in 0..kept {
                    let word = self.body_word(in h, v, k);
                    if word == NONE64 {
                        return false;
                    }
                    o.push(word);
                }
                return true;
            }
            let vt = n32(u64_at(in h.vty, v));
            let d = self.body_default(vt, h.result);
            if self.body_lane(h.result) == LANE_PRODUCT {
                // Copied to the result pointer unless built in it.
                if d != 0 || self.body_lane(vt) != LANE_PRODUCT {
                    return false;
                }
                o.push(TERM_RETURN_SRET);
                o.push(v);
                o.push(self.body_product_size(h.result));
                return true;
            }
            o.push(TERM_RETURN);
            o.push(v);
            o.push(d);
            return true;
        }
        if row.term == Term::Jump {
            let target = self.program.op(ta);
            let n = self.program.op(inc(ta));
            let trow = self.program.block(add(f.b0, target));
            o.push(TERM_JUMP);
            o.push(target);
            o.push(n);
            for k in 0..n {
                let v = self.body_value(in h, self.program.op(add(add(ta, 2), k)));
                let param = self.body_block_param(in h, trow.ha, k);
                if v == NONE64
                    || param == NONE64
                    || self.body_words(in h, v) != 0
                    || self.body_fused_at(v) != NONE64
                {
                    return false;
                }
                // A product joined at a block parameter passes its pointer
                // (#2654); a `Never` one would need fresh storage.
                let d = self.body_default(n32(u64_at(in h.vty, v)), n32(u64_at(in h.vty, param)));
                if d == LANE_PRODUCT {
                    return false;
                }
                o.push(v);
                o.push(d);
            }
            return true;
        }
        if row.term == Term::Branch {
            let c = self.body_value(in h, self.program.op(ta));
            if c == NONE64 || self.body_fused_at(c) != NONE64 {
                return false;
            }
            o.push(TERM_BRANCH);
            o.push(c);
            o.push(self.program.op(inc(ta)));
            o.push(self.program.op(add(ta, 2)));
            return true;
        }
        if row.term == Term::Match {
            let v = self.body_value(in h, self.program.op(ta));
            if v == NONE64 {
                return false;
            }
            let fused = self.body_fused_at(v);
            if fused != NONE64 {
                if u64_at(in self.fused, add(fused, FUSED_BLOCK)) != bi {
                    return false;
                }
                return self.body_fused_match(f, ta, v, inout o);
            }
            let vty = n32(u64_at(in h.vty, v));
            let vlane = self.body_lane(vty);
            if vlane == 0 {
                return false;
            }
            let narms = self.program.op(inc(ta));
            let mut arms_words: ChunkSeq[u64] = ChunkSeq::new[u64]();
            let mut p = add(ta, 2);
            for k in 0..narms {
                let pkind = self.program.op(p);
                let mut akind: u64 = 0;
                let mut payload: u64 = 0;
                if pkind == Pat::Wild {
                    akind = MATCH_TRUE;
                    p = add(p, PAT_WILD_WORDS);
                } else if pkind == Pat::Bind {
                    akind = MATCH_TRUE;
                    p = add(p, PAT_BIND_WORDS);
                } else if (pkind == Pat::Tuple || pkind == Pat::Constructor)
                    && vlane == LANE_PRODUCT
                {
                    // A struct or tuple pattern (#2654): its target, then
                    // its nodes.
                    let mut nodes: ChunkSeq[u64] = ChunkSeq::new[u64]();
                    let after = self.body_pattern(in h, p, vty, false, inout nodes);
                    if after == NONE64 {
                        return false;
                    }
                    let target = self.program.op(after);
                    p = inc(after);
                    let trow = self.program.block(add(f.b0, target));
                    if self.program.op(self.body_params_at(trow.ha)) != 0 {
                        return false;
                    }
                    arms_words.push(MATCH_FIELDS);
                    arms_words.push(0);
                    arms_words.push(target);
                    arms_words.extend(in nodes.as_slice());
                    continue;
                } else if pkind == Pat::Literal {
                    let lkind = self.program.op(add(p, PAT_LIT_KIND_OFFSET));
                    let lo = self.program.op(add(p, PAT_LIT_LO_OFFSET));
                    let hi = self.program.op(add(p, PAT_LIT_HI_OFFSET));
                    p = add(p, PAT_LIT_WORDS);
                    if (lkind == Lit::Int || lkind == Lit::Bool) && vlane == LANE_I64 {
                        akind = MATCH_INT;
                        payload = lo;
                    } else if (lkind == Lit::Int || lkind == Lit::WideInt) && vlane == LANE_I128 {
                        akind = MATCH_WIDE;
                        payload = lo;
                    } else if lkind == Lit::Float && vlane == LANE_F32 {
                        akind = MATCH_F32;
                        payload = f32_bits_of_f64(lo);
                    } else if lkind == Lit::Float && vlane == LANE_F64 {
                        akind = MATCH_F64;
                        payload = lo;
                    } else {
                        return false;
                    }
                    let target = self.program.op(p);
                    p = inc(p);
                    let trow = self.program.block(add(f.b0, target));
                    if self.program.op(self.body_params_at(trow.ha)) != 0 {
                        return false;
                    }
                    arms_words.push(akind);
                    arms_words.push(payload);
                    if akind == MATCH_WIDE {
                        arms_words.push(hi);
                    }
                    arms_words.push(target);
                    continue;
                } else {
                    return false;
                }
                let target = self.program.op(p);
                p = inc(p);
                let trow = self.program.block(add(f.b0, target));
                if self.program.op(self.body_params_at(trow.ha)) != 0 {
                    return false;
                }
                arms_words.push(akind);
                arms_words.push(payload);
                arms_words.push(target);
            }
            o.push(TERM_MATCH);
            o.push(v);
            o.push(narms);
            o.extend(in arms_words.as_slice());
            return true;
        }
        if row.term == Term::Unreachable {
            o.push(TERM_UNREACHABLE);
            return true;
        }
        false
    }

    // The `match` on fused read `v` (`Terminator::Match` with
    // `seq_fused_condition`): each arm's `MATCH_FUSED` outcome, until the
    // arms seen cover both outcomes of the bounds check
    // (`seq_fused_exhaustive`), whose last arm is a `MATCH_JUMP`.
    fn body_fused_match(inout self, f: FnRow, ta: u64, v: u64, inout o: ChunkSeq[u64]) -> bool {
        let narms = self.program.op(inc(ta));
        let mut arms_words: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let mut emitted: u64 = 0;
        let mut some = false;
        let mut none = false;
        let mut p = add(ta, 2);
        for k in 0..narms {
            let mut next: u64 = 0;
            let mut bound: u64 = 0;
            let outcome = self.body_fused_pattern(p, inout next, inout bound);
            if outcome == NONE64 {
                return false;
            }
            let target = self.program.op(next);
            p = inc(next);
            let trow = self.program.block(add(f.b0, target));
            if self.program.op(self.body_params_at(trow.ha)) != 0 {
                return false;
            }
            if outcome == FUSED_SOME {
                some = true;
            } else if outcome == FUSED_NONE {
                none = true;
            }
            emitted = inc(emitted);
            if outcome == FUSED_ANY || (some && none) {
                arms_words.push(MATCH_JUMP);
                arms_words.push(0);
                arms_words.push(target);
                break;
            }
            arms_words.push(MATCH_FUSED);
            arms_words.push(outcome);
            arms_words.push(target);
        }
        o.push(TERM_MATCH);
        o.push(v);
        o.push(emitted);
        o.extend(in arms_words.as_slice());
        true
    }

    // The locals that keep a home slot on the optimize path as well
    // (`register_locals`): those lent `inout` or `sink` to a call that may
    // fail, which writes through the slot before it can leave (#2614), or
    // to `Fail::raise` (#2657), which is no function and so not pure.
    pub fn body_homed(inout self, f: FnRow) -> ChunkSeq[u64] {
        let mut homed: ChunkSeq[u64] = ChunkSeq::new[u64]();
        for bi in 0..f.bc {
            let row = self.program.block(add(f.b0, bi));
            for ii in 0..row.ic {
                let i = self.program.inst(add(row.i0, ii));
                if i.op != Op::Call {
                    continue;
                }
                let n = self.program.op(inc(i.a));
                if !self.body_has_inout(i, n) {
                    continue;
                }
                let name = n32(self.program.op(i.a));
                let callee = if name == self.ops.fail_raise {
                    NONE64
                } else {
                    self.body_function(name)
                };
                if callee == NONE64 && name != self.ops.fail_raise {
                    continue;
                }
                let fails = if callee == NONE64 {
                    1
                } else {
                    let ch = self.body_header(self.program.function(callee));
                    ch.fails.len()
                };
                if fails == 0 {
                    continue;
                }
                for k in 0..n {
                    let at = add(add(i.a, CALL_ARGS), wrapping_mul(k, CALL_ARG_WORDS));
                    let root = self.program.op(add(at, CALL_ARG_ROOT_OFFSET));
                    if self.program.op(at) != PASS_IN && root != 0 {
                        homed.push(wrapping_sub(root, 1));
                    }
                }
            }
        }
        homed
    }

    // Whether one of call `i`'s `n` arguments is not passed `in`.
    fn body_has_inout(in self, i: InstRow, n: u64) -> bool {
        for k in 0..n {
            let at = add(add(i.a, CALL_ARGS), wrapping_mul(k, CALL_ARG_WORDS));
            if self.program.op(at) != PASS_IN {
                return true;
            }
        }
        false
    }

    // The arguments of a direct call with `inout` scalar locals (#2563),
    // after the argument count: `[ARG_IN, kind]` for an `in` argument
    // (whose value joins `ops`), `[ARG_INOUT, local, lane]` for a local
    // lent `inout` (`Codegen::address`, restored after the call).
    fn body_inout_args(
        inout self,
        in h: Header,
        i: InstRow,
        n: u64,
        inout ops: ChunkSeq[u64],
        inout extra: ChunkSeq[u64]
    ) -> bool {
        extra.push(n);
        for k in 0..n {
            let at = add(add(i.a, CALL_ARGS), wrapping_mul(k, CALL_ARG_WORDS));
            let pass = self.program.op(at);
            if pass == PASS_IN {
                if !self.body_operand(in h, inc(at), inout ops) {
                    return false;
                }
                let read = self.body_kind(n32(u64_at(
                    in h.vty,
                    u64_at(in ops, wrapping_sub(ops.len(), 1))
                )));
                if read == NONE64 {
                    return false;
                }
                extra.push(ARG_IN);
                extra.push(read);
            } else if pass == PASS_INOUT {
                let root = self.program.op(add(at, CALL_ARG_ROOT_OFFSET));
                let path = self.program.path(self.program.op(add(at, CALL_ARG_PATH_OFFSET)));
                if root == 0 || path.n != 0 {
                    return false;
                }
                let l = self.body_local(in h, wrapping_sub(root, 1));
                if l == NONE64 {
                    return false;
                }
                let lane = self.body_lane(self.body_local_type(in h, l));
                if lane == 0 || lane == LANE_PRODUCT {
                    return false;
                }
                extra.push(ARG_INOUT);
                extra.push(l);
                extra.push(lane);
            } else {
                return false;
            }
        }
        true
    }

    // The start of a block's parameter words (place-ir `read_block`:
    // entry, the token pairs, out, then the parameter values).
    fn body_params_at(in self, ha: u64) -> u64 {
        let ni = self.program.op(inc(ha));
        add(add(ha, 3), wrapping_mul(ni, 2))
    }

    // The value index of a block's parameter `k`, or NONE64.
    fn body_block_param(in self, in h: Header, ha: u64, k: u64) -> u64 {
        let pa = self.body_params_at(ha);
        if k >= self.program.op(pa) {
            return NONE64;
        }
        self.body_value(in h, self.program.op(add(inc(pa), k)))
    }

    // Whether `f`'s fip side tables (its trailer) are all empty.
    fn body_no_trailer(in self, f: FnRow) -> bool {
        for i in f.ta..add(f.ta, f.tn) {
            if self.program.op(i) != 0 {
                return false;
            }
        }
        true
    }

    // Each block's parameters, then the lowering order and the blocks
    // sealed on the way; false for a parameter the plan does not carry.
    pub fn body_layout(
        inout self,
        in h: Header,
        f: FnRow,
        inout graph_words: ChunkSeq[u64]
    ) -> bool {
        for bi in 0..f.bc {
            let row = self.program.block(add(f.b0, bi));
            let pa = self.body_params_at(row.ha);
            let np = self.program.op(pa);
            graph_words.push(np);
            for k in 0..np {
                let v = self.body_value(in h, self.program.op(add(inc(pa), k)));
                // A product joined at a block parameter is its pointer
                // (#2654); on the optimize path it has a home of its own
                // (`aggregates::plan`), which the walk's request declines.
                if v == NONE64 || self.body_words(in h, v) != 0 {
                    return false;
                }
                graph_words.push(v);
            }
        }
        let l = layout(in self.program, f);
        let mut sealed: ChunkSeq[u64] = ChunkSeq::new[u64]();
        for k in 0..l.sealed.len() {
            set(inout sealed, u64_at(in l.sealed, k), 1);
        }
        for k in 0..l.order.len() {
            let b = u64_at(in l.order, k);
            graph_words.push(b);
            graph_words.push(at(in sealed, b));
        }
        true
    }

    // `fused_pattern` with the planner's names.
    fn body_fused_pattern(inout self, p: u64, inout next: u64, inout bound: u64) -> u64 {
        let ops_s = self.ops;
        fused_pattern(
            inout self.ctx.names,
            in self.program,
            ops_s.option_some,
            ops_s.option_none,
            p,
            inout next,
            inout bound
        )
    }

    // `fused_try_gets` of `f`, into `self.fused` by value index with each
    // read's block. Their other uses are checked as the plan reaches
    // them: a `Bind` with a fused pattern plans `INST_BIND_FUSED`, and any
    // other use refuses the function, where the walk would not fuse the
    // read.
    fn body_fused_reads(inout self, in h: Header, fi: u64) {
        self.fused = ChunkSeq::new[u64]();
        let reads = fused_try_gets(inout self.ctx.names, in self.program, fi);
        let mut k: u64 = 0;
        loop {
            if k >= reads.len() {
                break;
            }
            let x = self.body_value(in h, u64_at(in reads, k));
            if x != NONE64 {
                self.fused.push(x);
                self.fused.push(u64_at(in reads, inc(k)));
                self.fused.push(0);
                self.fused.push(0);
            }
            k = add(k, FUSED_READ_WORDS);
        }
    }

    // The position in `self.fused` of value index `v`'s fused read, or
    // NONE64 when `v` is not one.
    fn body_fused_at(in self, v: u64) -> u64 {
        let mut k: u64 = 0;
        loop {
            if k >= self.fused.len() {
                break;
            }
            if u64_at(in self.fused, k) == v {
                return k;
            }
            k = add(k, FUSED_WORDS);
        }
        NONE64
    }

    // Each block's instructions and terminator, in the lowering order,
    // with the request's call index of each call (`slots`); false for an
    // instruction or terminator the plan does not carry.
    pub fn body_blocks(
        inout self,
        in h: Header,
        f: FnRow,
        in slots: CallSlots,
        inout builtin_calls: ChunkSeq[u64],
        inout block_words: ChunkSeq[u64]
    ) -> bool {
        let fi = self.fi;
        self.body_fused_reads(in h, fi);
        let l = layout(in self.program, f);
        let first = self.program.block(f.b0).i0;
        // The plan's record of each instruction, by its index in `f`.
        let mut record: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let mut r = u64_at(in self.plan_from, fi);
        let to = u64_at(in self.plan_to, fi);
        loop {
            if r >= to {
                break;
            }
            let bi = u64_at(in self.plan, inc(r));
            let ii = u64_at(in self.plan, add(r, 2));
            let row = self.program.block(add(f.b0, bi));
            set(inout record, wrapping_sub(add(row.i0, ii), first), inc(r));
            r = add(r, PLAN_RECORD_WORDS);
        }
        for k in 0..l.order.len() {
            let bi = u64_at(in l.order, k);
            let row = self.program.block(add(f.b0, bi));
            block_words.push(row.ic);
            for ii in 0..row.ic {
                let x = add(row.i0, ii);
                let off = wrapping_sub(x, first);
                let rec = at(in record, off);
                let planned = if rec == 0 {
                    NONE64
                } else {
                    wrapping_sub(rec, 1)
                };
                let call = at(in slots.calls, off);
                self.handle_row = at(in slots.rows, off);
                self.handle_base = at(in slots.bases, off);
                if !self.body_inst(
                    in h,
                    f.name,
                    self.program.inst(x),
                    planned,
                    call,
                    inout builtin_calls,
                    inout block_words
                ) {
                    return false;
                }
            }
            if !self.body_terminator(in h, f, bi, inout block_words) {
                return false;
            }
        }
        true
    }

    // The body plan of function `fi`, whose instruction plan records start
    // at `from` in `self.plan`, appended to `out` as `[fi, n, n words]`.
    pub fn body(inout self, fi: u64, from: u64, inout out: ChunkSeq[u64]) {
        self.fi = fi;
        let f = self.program.function(fi);
        let h = self.body_header(f);
        if !h.plain
            || h.captures != 0
            || f.bc == 0
            || !self.body_no_trailer(f)
            || (self.body_lane(h.result) == 0 && self.enums.returns(fi) == 0)
        {
            return;
        }
        let mut graph_words: ChunkSeq[u64] = ChunkSeq::new[u64]();
        // `ir_graph_at`'s locals, in name order: a parameter has its
        // variable; every other local gets a zeroed one. Each has its kind.
        let homed = self.body_homed(f);
        graph_words.push(h.lname.len());
        for k in 0..h.lname.len() {
            let t = n32(u64_at(in h.lty, k));
            let name = u64_at(in h.lname, k);
            let mut is_param = false;
            let mut entry = self.body_lane(t);
            for j in 0..h.params.len() {
                if u64_at(in h.params, j) == name {
                    entry = if self.body_lane(t) == LANE_PRODUCT {
                        add(LOCAL_PARAM_PRODUCT, j)
                    } else {
                        add(LOCAL_PARAM, j)
                    };
                    is_param = true;
                }
            }
            if !self.body_register(t) && self.body_lane(t) != LANE_PRODUCT {
                return;
            }
            if entry == 0 {
                return;
            }
            for j in 0..homed.len() {
                if u64_at(in homed, j) == name {
                    entry = add(entry, LOCAL_HOME);
                    break;
                }
            }
            graph_words.push(entry);
            // The kind its stores coerce to, on the unoptimized path that
            // keeps every local in a stack slot; a local a handler names
            // keeps its slot on the optimize path too (#2657).
            let home = if self.handler_home(fi, name) {
                HANDLER_HOME
            } else {
                0
            };
            graph_words.push(self.body_kind(t) | home);
        }
        // Each value's register.
        graph_words.push(h.vty.len());
        for k in 0..h.vty.len() {
            // A small enum kept as words before one kept in memory (#2654).
            let lane = if self.body_words(in h, k) != 0 {
                LANE_WORDS
            } else {
                self.body_lane(n32(u64_at(in h.vty, k)))
            };
            if lane == 0 {
                return;
            }
            graph_words.push(lane);
        }
        if !self.body_layout(in h, f, inout graph_words) {
            return;
        }
        let mut builtin_calls: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let mut block_words: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let slots = self.body_call_slots(fi);
        if !self.body_blocks(in h, f, in slots, inout builtin_calls, inout block_words) {
            return;
        }
        let mut o: ChunkSeq[u64] = ChunkSeq::new[u64]();
        o.push(f.bc);
        // A `fail_only` function takes its failure record after its
        // parameters (#2425): the request binds it to one more variable.
        let nfail = h.fails.len();
        o.push(
            if nfail == 0 {
                h.params.len()
            } else {
                inc(h.params.len())
            }
        );
        o.push(builtin_calls.len());
        o.extend(in builtin_calls.as_slice());
        // The failure header: the row's `Fail` count, then (when there is
        // one) the lane of the result a failure exit returns a zero of: a
        // struct result's function returns the word 0 beside its result
        // pointer (#2581).
        o.push(nfail);
        if nfail != 0 {
            let lane = self.body_lane(h.result);
            o.push(if lane == LANE_PRODUCT { LANE_I64 } else { lane });
        }
        // The words a small enum result is returned as (#2581), 0 for any
        // other result: the request's frame must agree.
        o.push(self.enums.returns(fi));
        o.extend(in graph_words.as_slice());
        o.extend(in block_words.as_slice());
        out.push(fi);
        out.push(o.len());
        out.extend(in o.as_slice());
    }
}

// `seq_native::fused_pattern` of the arm pattern at `p` of `program`: its
// `FUSED_*` outcome (`Some(x)` or `Some(_)`, `None`, `_`), or NONE64 for
// any other pattern. `next` gets the word after the pattern, and `bound`
// the name `Some(x)` binds (NONE64 for none). `some` and `none` are the
// variant names.
fn fused_pattern(
    inout names: Names,
    in program: Program,
    some: u32,
    none: u32,
    p: u64,
    inout next: u64,
    inout bound: u64
) -> u64 {
    bound = NONE64;
    let pkind = program.op(p);
    if pkind == Pat::Wild {
        next = add(p, PAT_WILD_WORDS);
        return FUSED_ANY;
    }
    if pkind != Pat::Constructor {
        return NONE64;
    }
    let name = short_name(inout names, n32(program.op(add(p, PAT_CTOR_NAME_OFFSET))));
    let count = program.op(add(p, PAT_CTOR_COUNT_OFFSET));
    if name == none && count == 0 {
        next = add(p, PAT_CTOR_WORDS);
        return FUSED_NONE;
    }
    if name != some || count != 1 {
        return NONE64;
    }
    // The one (field, part) pair: the part after its field name.
    let part = inc(add(p, PAT_CTOR_WORDS));
    let part_kind = program.op(part);
    if part_kind == Pat::Wild {
        next = add(part, PAT_WILD_WORDS);
    } else if part_kind == Pat::Bind {
        bound = program.op(add(part, PAT_BIND_NAME_OFFSET));
        next = add(part, PAT_BIND_WORDS);
    } else {
        return NONE64;
    }
    FUSED_SOME
}

// The `try_get` reads of graph `fi` that `seq_native::fused_reads` may
// fuse with their block's `match`: each read's value id and block, as
// `FUSED_READ_WORDS` words, when the read is its block's `match`
// scrutinee and every arm's pattern is a fused one. The body plan refuses
// a graph that uses such a read any other way, so each one is fused or
// its graph has no plan.
pub fn fused_try_gets(inout names: Names, in program: Program, fi: u64) -> ChunkSeq[u64] {
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let f = program.function(fi);
    let try_get = names.intern(in TRY_GET_LABEL.as_bytes());
    let some = names.intern(in SOME_NAME.as_bytes());
    let none = names.intern(in NONE_NAME.as_bytes());
    for bi in 0..f.bc {
        let row = program.block(add(f.b0, bi));
        if row.term != Term::Match {
            continue;
        }
        let v = program.op(row.ta);
        let mut read = false;
        for ii in 0..row.ic {
            let i = program.inst(add(row.i0, ii));
            if widen_u64(i.dest) == v && i.op == Op::Seq {
                let pool = program.pool_row(program.op(i.a));
                read = pool.kind == PoolKind::Seq && pool.label == try_get;
            }
        }
        if !read {
            continue;
        }
        let narms = program.op(inc(row.ta));
        let mut p = add(row.ta, 2);
        let mut all = true;
        for k in 0..narms {
            let mut next: u64 = 0;
            let mut bound: u64 = 0;
            if fused_pattern(inout names, in program, some, none, p, inout next, inout bound)
                == NONE64
            {
                all = false;
                break;
            }
            // the arm's target block
            p = inc(next);
        }
        if all {
            out.push(v);
            out.push(bi);
        }
    }
    out
}
