pub const INST_SEQ: u64 = 80;
// An arm's `Bind` of a fused `try_get` (`seq_fused_bind`): the local
// `Some(x)` binds (NO_LOCAL for none), then the element's stride and lane.
pub const INST_BIND_FUSED: u64 = 81;
// `INST_SEQ`'s forms: a header word loaded at an offset (`Str::len`,
// `Slice::len`); the operand itself (`as_str`); a byte view of a string
// (`as_bytes`); a checked byte (`byte_at`); a checked slice element
