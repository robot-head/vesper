pub const INST_INT_EXTRA: u64 = 9;
pub const INST_WRITE_OP: u64 = 10;
pub const INST_EXIT: u64 = 11;
pub const INST_CALL_BUILTIN: u64 = 12;
pub const INST_WIDE_CONST: u64 = 13;
pub const INST_WIDE_UNARY: u64 = 14;
pub const INST_WIDE_BINARY: u64 = 15;
// A one-word integer operator that raises through the failure record
// (#2425); codes from 40 leave room for the other body slices.
pub const INST_CHECKED: u64 = 40;
// A direct call of a `fail_only` function, whose failure is raised again.
pub const INST_FAIL_CALL: u64 = 41;
// An explicit `Fail::raise` of a value (#2657): through the failure record,
// or to the handler in scope.
pub const INST_RAISE: u64 = 44;
// A direct call of a pure function that borrows scalar locals `inout`
// (#2563); codes from 48 leave room for the failure-record slice.
pub const INST_INOUT_CALL: u64 = 48;
// A direct call whose small enum result comes back as words in registers
// (#2581); codes from 56 leave room for the other body slices.
pub const INST_WORDS_CALL: u64 = 56;
// A sequence or string operation (`Op::Seq`, #2653): one of the `SEQ_*`
