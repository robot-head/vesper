// Foreign (`.vsys`) calls in the native walk's body plans (#2751): an
// `Op::Call` of an operation of an imported library's `Ffi$Lib` effect is
// `Codegen::foreign_perform` (src/ffi_lowering/native.rs), a direct call of
// the C symbol. The library plan stays on the walk's side, so the facts
// after the handler facts name each foreign operation the program calls,
// its C symbol and its form (tests/common/foreign_facts.rs,
// `ffi_lowering::plan_probe::body_call`).
//
// The plan covers direct calls whose parameters are scalars, `bool`s,
// handles and slices and whose result is `Unit`, a scalar or a nullable
// handle. Each argument is evaluated where the walk evaluates it: an `in`
// or `inout` argument with a place reads its whole local at the call
// (`ir_place_expr`), any other is a temporary of the value already
// computed (`ir_temp`). A handle is its struct's one word, copied first as
// `expr` copies an aggregate; a slice is its view's data and length. A
// nullable handle result is an `Option` of its struct in fresh storage.
// C strings, pointers, wire structs, enums and validated results stay on
// the walk.

use @vesper/check-data::util::{add, inc, n32, u32_at, u64_at, u8_at};
use @vesper/check-data::types::{TyKind, default_type};
use @vesper/check-layout::{L_ENUM, layout_of};
use @vesper/check-data::names::{Names};
use @vesper/check-data::input::{Reader};
use @vesper/place-ir::{InstRow};
use @vesper/place-ir::codes::{Op};
use super::{Gen};
use super::body::{Header, LANE_PRODUCT};

// The section's first word, "FOREIGNS" in ASCII (`FOREIGN_FACTS`).
pub const FOREIGN_FACTS: u64 = 6002813733352656710;
const NONE64: u64 = 18446744073709551615;
const NONE32: u32 = 4294967295;
// The variant names `foreign_result` builds an `Option` from.
const OPTION_SOME: Str = "Some";
const OPTION_NONE: Str = "None";
// The variant names of a refusable call's `Result`.
const RESULT_OK: Str = "Ok";
const RESULT_ERR: Str = "Err";
// The words after the result: whether the call may be refused, then the
// `Result`'s size, `Err` tag and offset, `Ok` tag and offset and the
// `Ok` payload's copied size.
const NO_REFUSAL: u64 = 0;
const REFUSAL: u64 = 1;
// A scalar word's bits.
const SCALAR_BITS: u64 = 255;

// Two variants of an in-memory enum (`body_two_variants`).
copy struct TwoVariants {
    size: u64,
    first: u64,
    first_offset: u64,
    first_ty: u32,
    second: u64,
    second_offset: u64,
}

// `plan_probe::body_call`'s forms.
const CALL_DIRECT: u64 = 1;
// A callback type's call, through the pointer its first (handle)
// argument holds (`Callee::Indirect`).
const CALL_INDIRECT: u64 = 2;
pub const PARAM_SCALAR: u64 = 0;
pub const PARAM_BOOL: u64 = 1;
pub const PARAM_HANDLE: u64 = 2;
// A slice lent in place (`ParameterType::Slice` of a source `Slice[T]`):
// its word is the element's bytes.
pub const PARAM_SLICE: u64 = 3;
// A C string (`ParameterType::CStr`): a NUL-terminated `malloc` copy of a
// byte slice, freed after the call.
pub const PARAM_CSTR: u64 = 4;
const RESULT_UNIT: u64 = 0;
const RESULT_SCALAR: u64 = 1;
// A nullable handle (`ValueType::Handle { nullable: true }`): an
// `Option` of its struct, built from the word.
const RESULT_OPTION_HANDLE: u64 = 2;
// A plan form's words: the form, then its scalar word.
const FORM_WORDS: u64 = 2;

// An argument's source in the plan: a temporary of the next operand, or a
// whole local read at the call.
pub const SOURCE_TEMP: u64 = 0;
pub const SOURCE_LOCAL: u64 = 1;
// A handle (`ParameterType::Handle`), whose word the call loads: from a
// copy of a whole local lent `in` (`expr` copies an aggregate), from the
// local itself lent `inout` (after the same copy, `address`), or from a
// temporary of the value (a `sink` argument).
pub const SOURCE_HANDLE_IN: u64 = 2;
pub const SOURCE_HANDLE_INOUT: u64 = 3;
pub const SOURCE_HANDLE_TEMP: u64 = 4;
// A slice view (`foreign_view`), copied first as `expr` copies an
// aggregate: from a whole local (lent `in` or `inout`, read at the call),
// or from a temporary of the value.
pub const SOURCE_SLICE_LOCAL: u64 = 5;
pub const SOURCE_SLICE_TEMP: u64 = 6;

// A call's argument words: pass, value, place root (+1, 0 for none),
// place path (place-ir `Op::Call`).
const CALL_ARGS: u64 = 2;
const CALL_ARG_WORDS: u64 = 4;
const ARG_VALUE: u64 = 1;
const ARG_ROOT: u64 = 2;
const ARG_PATH: u64 = 3;
const PASS_IN: u64 = 0;
const PASS_INOUT: u64 = 1;
const PASS_SINK: u64 = 2;

const BYTE_BITS: u32 = 8;
const WORD_BITS: u32 = 64;
const WORD_BYTES: u64 = 8;

pub struct ForeignFacts {
    // per row: the callee's name, its C symbol, and its words
    // words[a..a+n]
    callee: ChunkSeq[u32],
    symbol: ChunkSeq[u32],
    a: ChunkSeq[u64],
    n: ChunkSeq[u64],
    words: ChunkSeq[u64],
}

pub fn foreign_facts_none() -> ForeignFacts {
    ForeignFacts {
        callee: ChunkSeq::new[u32](),
        symbol: ChunkSeq::new[u32](),
        a: ChunkSeq::new[u64](),
        n: ChunkSeq::new[u64](),
        words: ChunkSeq::new[u64]()
    }
}

fn read_text(inout reader: Reader, in bytes: Slice[u8], inout names: Names) -> u32 {
    let len = reader.word(in bytes);
    let start = reader.pos;
    let name = names.intern(in bytes[start..wrapping_add(start, len)]);
    reader.pos = wrapping_add(start, wrapping_mul(wrapping_add(len, 7) / WORD_BYTES, WORD_BYTES));
    name
}

// The facts at the reader, or none (the reader left where it was) when the
// next word does not start them.
pub fn read_foreign_facts(
    inout reader: Reader,
    in bytes: Slice[u8],
    inout names: Names
) -> ForeignFacts {
    let mut facts = foreign_facts_none();
    let at = reader.pos;
    if at >= bytes.len() || reader.word(in bytes) != FOREIGN_FACTS {
        reader.pos = at;
        return facts;
    }
    let rows = reader.word(in bytes);
    for k in 0..rows {
        facts.callee.push(read_text(inout reader, in bytes, inout names));
        facts.symbol.push(read_text(inout reader, in bytes, inout names));
        let n = reader.word(in bytes);
        facts.a.push(facts.words.len());
        facts.n.push(n);
        for j in 0..n {
            facts.words.push(reader.word(in bytes));
        }
    }
    facts
}

impl ForeignFacts {
    // The row of callee `name`, or NONE64.
    pub fn row(in self, name: u32) -> u64 {
        for k in 0..self.callee.len() {
            if u32_at(in self.callee, k) == name {
                return k;
            }
        }
        NONE64
    }

    pub fn word(in self, row: u64, k: u64) -> u64 {
        u64_at(in self.words, add(u64_at(in self.a, row), k))
    }
}

impl Gen {
    // `foreign_perform` of the call `i` (`INST_FOREIGN`): its temporaries
    // go in `ops`, and in `extra` the C symbol's bytes, the call's kind
    // (`CALL_DIRECT` or `CALL_INDIRECT`) and argument count, then per argument
    // its source (`SOURCE_TEMP`, or `SOURCE_LOCAL` and the local), the
    // kind its read coerces to and its form with its scalar word, then the
    // result's form and its words, then the refusal words of a call taking
    // a C string (`REFUSAL`) or `NO_REFUSAL`. False for a call the plan
    // does not cover.
    fn body_foreign(
        inout self,
        in h: Header,
        i: InstRow,
        inout ops: ChunkSeq[u64],
        inout extra: ChunkSeq[u64]
    ) -> bool {
        let row = self.foreign.row(n32(self.program.op(i.a)));
        if row == NONE64 || u64_at(in self.foreign.n, row) == 0 {
            return false;
        }
        let call = self.foreign.word(row, 0);
        if call != CALL_DIRECT && call != CALL_INDIRECT {
            return false;
        }
        let nparams = self.foreign.word(row, 1);
        let nargs = self.program.op(inc(i.a));
        if nargs != nparams {
            return false;
        }
        if call == CALL_INDIRECT && (nargs == 0 || self.foreign.word(row, 2) != PARAM_HANDLE) {
            return false;
        }
        self.body_symbol(u32_at(in self.foreign.symbol, row), inout extra);
        extra.push(call);
        let mut refused = false;
        extra.push(nargs);
        for k in 0..nargs {
            let form = self.foreign.word(row, add(2, wrapping_mul(k, FORM_WORDS)));
            let at = add(add(i.a, CALL_ARGS), wrapping_mul(k, CALL_ARG_WORDS));
            let pass = self.program.op(at);
            let root = self.program.op(add(at, ARG_ROOT));
            if form == PARAM_HANDLE {
                if !self.body_foreign_handle(in h, at, pass, root, inout ops, inout extra) {
                    return false;
                }
            } else if form == PARAM_SLICE || form == PARAM_CSTR {
                // A C string is copied from a byte slice's view.
                if !self.body_foreign_slice(in h, at, pass, root, inout ops, inout extra) {
                    return false;
                }
                refused = refused || form == PARAM_CSTR;
            } else if (form != PARAM_SCALAR && form != PARAM_BOOL) || pass != PASS_IN {
                return false;
            } else if root == 0 {
                // `ir_temp` of the argument's value.
                let v = self.body_value(in h, self.program.op(add(at, ARG_VALUE)));
                if v == NONE64 {
                    return false;
                }
                let read = self.body_kind(n32(u64_at(in h.vty, v)));
                if read == NONE64 {
                    return false;
                }
                ops.push(v);
                extra.push(SOURCE_TEMP);
                extra.push(read);
            } else {
                // `ir_place_expr` of a whole local, read at the call.
                if self.program.path(self.program.op(add(at, ARG_PATH))).n != 0 {
                    return false;
                }
                let l = self.body_local(in h, wrapping_sub(root, 1));
                if l == NONE64 {
                    return false;
                }
                let read = self.body_kind(self.body_local_type(in h, l));
                if read == NONE64 {
                    return false;
                }
                extra.push(SOURCE_LOCAL);
                extra.push(l);
                extra.push(read);
            }
            extra.push(form);
            extra.push(self.foreign.word(row, add(add(2, wrapping_mul(k, FORM_WORDS)), 1)));
        }
        let at = add(2, wrapping_mul(nargs, FORM_WORDS));
        let result = self.foreign.word(row, at);
        // A call taking a C string returns `Result[T, ForeignInvalid]`:
        // `Err` when a string holds a NUL byte, else `Ok` of the result.
        let mut ty = i.ty;
        let mut refusal = TwoVariants {
            size: 0,
            first: NONE64,
            first_offset: 0,
            first_ty: NONE32,
            second: NONE64,
            second_offset: 0
        };
        if refused {
            refusal = self.body_two_variants(i.ty, in RESULT_OK, in RESULT_ERR);
            if refusal.first == NONE64 || refusal.second == NONE64 {
                return false;
            }
            ty = refusal.first_ty;
        }
        // The size of the `Ok` payload copied into the `Result` (0 for a
        // word stored whole).
        let mut ok_size: u64 = 0;
        if result == RESULT_UNIT && !refused {
            extra.push(result);
            extra.push(0);
        } else if result == RESULT_SCALAR {
            let scalar = self.foreign.word(row, inc(at));
            if refused && (scalar & SCALAR_BITS) != widen_u64(WORD_BITS) {
                return false;
            }
            extra.push(result);
            extra.push(scalar);
        } else if result == RESULT_OPTION_HANDLE {
            if !self.body_foreign_option(ty, inout extra) {
                return false;
            }
            ok_size = self.body_product_size(ty);
        } else {
            return false;
        }
        if refused {
            extra.push(REFUSAL);
            extra.push(refusal.size);
            extra.push(refusal.second);
            extra.push(refusal.second_offset);
            extra.push(refusal.first);
            extra.push(refusal.first_offset);
            extra.push(ok_size);
        } else {
            extra.push(NO_REFUSAL);
        }
        true
    }

    // The result words of a nullable handle of `Option` type `t`
    // (`foreign_result_layout`): `RESULT_OPTION_HANDLE`, then its storage
    // size, the `Some` tag, the payload's offset and the `None` tag.
    fn body_foreign_option(inout self, t: u32, inout extra: ChunkSeq[u64]) -> bool {
        let o = self.body_two_variants(t, in OPTION_SOME, in OPTION_NONE);
        if o.first == NONE64 || o.second == NONE64 {
            return false;
        }
        extra.push(RESULT_OPTION_HANDLE);
        extra.push(o.size);
        extra.push(o.first);
        extra.push(o.first_offset);
        extra.push(o.second);
        true
    }

    // Variants `first` (with a payload) and `second` of the in-memory enum
    // type `t` (`Layout::variant`): their tags, payload offsets and the
    // first's payload type, NONE64 tags for a type without them.
    fn body_two_variants(inout self, t: u32, in first: Str, in second: Str) -> TwoVariants {
        let mut out = TwoVariants {
            size: 0,
            first: NONE64,
            first_offset: 0,
            first_ty: NONE32,
            second: NONE64,
            second_offset: 0
        };
        if self.body_lane(t) != LANE_PRODUCT {
            return out;
        }
        let mark = self.layouts.mark();
        let d = default_type(inout self.ctx.types, t);
        let l = layout_of(
            inout self.layouts,
            inout self.ctx.types,
            inout self.ctx.names,
            in self.ctx.world,
            d
        );
        let node = self.layouts.node(l);
        if node.kind == L_ENUM {
            for k in 0..widen_u64(node.n) {
                let v = self.layouts.lvariant(add(widen_u64(node.a), k));
                if self.ctx.names.spells(v.name, in first.as_bytes()) && v.fc != 0 {
                    out.first = k;
                    let field = self.layouts.lfield(widen_u64(v.fa));
                    out.first_offset = wrapping_u64(widen_i64(field.offset));
                    out.first_ty = field.ty;
                } else if self.ctx.names.spells(v.name, in second.as_bytes()) {
                    out.second = k;
                    if v.fc != 0 {
                        let field = self.layouts.lfield(widen_u64(v.fa));
                        out.second_offset = wrapping_u64(widen_i64(field.offset));
                    }
                }
            }
        }
        out.size = widen_u64(node.size);
        self.layouts.reset(mark);
        out
    }

    // Whether value `v` of the function being planned is lent `inout` to a
    // foreign call (`SOURCE_HANDLE_INOUT`): the `inout` read that makes it
    // emits nothing, as the walk's does.
    fn body_foreign_lends(in self, v: u64) -> bool {
        let f = self.program.function(self.fi);
        for bi in 0..f.bc {
            let row = self.program.block(add(f.b0, bi));
            for ii in 0..row.ic {
                let i = self.program.inst(add(row.i0, ii));
                if i.op != Op::Call || self.foreign.row(n32(self.program.op(i.a))) == NONE64 {
                    continue;
                }
                let nargs = self.program.op(inc(i.a));
                for k in 0..nargs {
                    let at = add(add(i.a, CALL_ARGS), wrapping_mul(k, CALL_ARG_WORDS));
                    if self.program.op(at) == PASS_INOUT
                        && self.program.op(add(at, ARG_VALUE)) == v
                    {
                        return true;
                    }
                }
            }
        }
        false
    }

    // The source words of a handle argument at call words `at`: a whole
    // local of a one-word product (the handle struct), lent `in` or
    // `inout`, or a `sink` temporary.
    fn body_foreign_handle(
        inout self,
        in h: Header,
        at: u64,
        pass: u64,
        root: u64,
        inout ops: ChunkSeq[u64],
        inout extra: ChunkSeq[u64]
    ) -> bool {
        if pass == PASS_SINK {
            // A `sink` argument is a temporary of its value even with a
            // place (`ir_temp`).
            let v = self.body_value(in h, self.program.op(add(at, ARG_VALUE)));
            if v == NONE64 || self.body_lane(n32(u64_at(in h.vty, v))) != LANE_PRODUCT {
                return false;
            }
            ops.push(v);
            extra.push(SOURCE_HANDLE_TEMP);
            return true;
        }
        if (pass != PASS_IN && pass != PASS_INOUT)
            || self.program.path(self.program.op(add(at, ARG_PATH))).n != 0
        {
            return false;
        }
        let l = self.body_local(in h, wrapping_sub(root, 1));
        if l == NONE64 {
            return false;
        }
        let ty = self.body_local_type(in h, l);
        if self.body_lane(ty) != LANE_PRODUCT || self.body_product_size(ty) != WORD_BYTES {
            return false;
        }
        extra.push(
            if pass == PASS_IN {
                SOURCE_HANDLE_IN
            } else {
                SOURCE_HANDLE_INOUT
            }
        );
        extra.push(l);
        true
    }

    // A symbol's bytes: their count, then eight to a word, little-endian,
    // the last word zero-padded.
    fn body_symbol(in self, symbol: u32, inout extra: ChunkSeq[u64]) {
        let mut bytes: ChunkSeq[u8] = ChunkSeq::new[u8]();
        self.ctx.names.write(symbol, inout bytes);
        extra.push(bytes.len());
        let mut word: u64 = 0;
        let mut shift: u32 = 0;
        for k in 0..bytes.len() {
            word = word | wrapping_shl_u64(widen_u64(u8_at(in bytes, k)), shift);
            shift = wrapping_add(shift, BYTE_BITS);
            if shift == WORD_BITS {
                extra.push(word);
                word = 0;
                shift = 0;
            }
        }
        if shift != 0 {
            extra.push(word);
        }
    }
}

impl Gen {
    // Whether type `t` is a `Slice[T]` (its view `{handle, start, len}`).
    fn body_is_slice(inout self, t: u32) -> bool {
        if t == NONE32 {
            return false;
        }
        let d = default_type(inout self.ctx.types, t);
        let n = self.ctx.types.node(d);
        n.kind == TyKind::Named && n.n == 1 && n.name == self.ctx.world.k.slice
    }

    // The source words of a slice argument at call words `at`
    // (`foreign_view`): a whole `Slice` local lent `in` or `inout`, read at
    // the call, or a temporary of a `Slice` value.
    fn body_foreign_slice(
        inout self,
        in h: Header,
        at: u64,
        pass: u64,
        root: u64,
        inout ops: ChunkSeq[u64],
        inout extra: ChunkSeq[u64]
    ) -> bool {
        if pass == PASS_SINK || root == 0 {
            let v = self.body_value(in h, self.program.op(add(at, ARG_VALUE)));
            if v == NONE64 || !self.body_is_slice(n32(u64_at(in h.vty, v))) {
                return false;
            }
            ops.push(v);
            extra.push(SOURCE_SLICE_TEMP);
            return true;
        }
        if (pass != PASS_IN && pass != PASS_INOUT)
            || self.program.path(self.program.op(add(at, ARG_PATH))).n != 0
        {
            return false;
        }
        let l = self.body_local(in h, wrapping_sub(root, 1));
        if l == NONE64 || !self.body_is_slice(self.body_local_type(in h, l)) {
            return false;
        }
        extra.push(SOURCE_SLICE_LOCAL);
        extra.push(l);
        true
    }
}
