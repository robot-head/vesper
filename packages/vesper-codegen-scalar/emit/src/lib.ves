// @vesper/codegen-scalar-emit: the `scalar` hook of the native lowering
// (self-hosting SH4 lane 6, #1280), over the Rust `Codegen`'s lent
// Cranelift builder (src/codegen_swap.rs, lane 1's swap point).
//
// The graph walk (`Codegen::ir_graph_at`) asks the `scalar` hook to emit
// each Place IR instruction of its family. @vesper/codegen-scalar plans
// what to emit (`codegen_scalar_plan`: the `expr_at` arm, the condition
// code, the narrow kind `coerce` reduces to); the harness hands this hook
// the plan's request and immediates with the instruction's operand values,
// and it emits what `expr_at` would. An instruction with no plan, or with
// operand lanes the plan cannot see (floats, 128-bit words, mismatched
// lanes), is declined and the Rust lowering emits it.
//
// A request's arguments are `[a, b, optimize, operand values...]`, where
// `a` and `b` are the plan's immediates and `optimize` is the compile's
// optimizer flag (`Codegen::operands_only`, which `coerce` reads).

use @vesper/cranelift::{
    Ty, Value, Var, call_arg, call_arg_count, call_builder, call_result, call_op, call_result_value,
    call_module, call_return_builder, call_return_module, cc_eq, cc_ne, cc_sge, cc_sgt, cc_sle,
    cc_slt, cc_uge, cc_ugt, cc_ule, cc_ult, declare_var, def_var, ins_band, ins_band_imm, ins_bnot,
    ins_bor, ins_bxor, ins_f64const, ins_iadd, ins_icmp, ins_icmp_imm, ins_iconst, ins_imul,
    ins_ineg, ins_ireduce, ins_ishl, ins_ishl_imm, ins_rotl, ins_rotr, ins_isub, ins_sextend,
    ins_sshr, ins_srem, ins_smulhi, ins_sshr_imm, ins_udiv, ins_uextend, ins_urem, ins_umulhi,
    ins_ushr, ty_i16, ty_i32, ty_i64, ty_i8, use_var, value_of_word, value_type, invalid, is_invalid
};
use self::body::{emit_body};

// The request protocol (src/codegen_swap.rs): the answer of a hook.
pub const HANDLED: u64 = 1;
pub const DECLINED: u64 = 0;
// The `body` hook's answer to words that are not a body plan, once it may
// have emitted: an error, not a decline (`body.ves`).
pub const BODY_ERROR: u64 = 2;

// The plan's requests (@vesper/codegen-scalar keeps the same numbers).
pub const PLAN_ZERO: u32 = 1;
pub const PLAN_ICONST: u32 = 2;
pub const PLAN_F64CONST: u32 = 3;
pub const PLAN_ICMP: u32 = 4;
pub const PLAN_BINOP: u32 = 5;
pub const PLAN_BNOT: u32 = 6;
pub const PLAN_NOT: u32 = 7;
pub const PLAN_INEG: u32 = 8;
pub const PLAN_SHIFT: u32 = 9;
pub const PLAN_CONVERT: u32 = 10;

// The tests of the raising arms (`codegen_swap::scalar::OVERFLOW` and
// `DIVISOR`, renumbered past the plan's requests by the caller): the
// hook answers the flag and the Rust code raises.
pub const TEST_OVERFLOW: u32 = 11;
pub const TEST_DIVISOR: u32 = 12;
pub const TEST_NEGATE: u32 = 13;
pub const TEST_SHIFT_RANGE: u32 = 14;
pub const TEST_NARROW: u32 = 15;

// A plain local's read, fresh binding and write (`codegen_swap::scalar`'s
// READ_LOCAL, BIND_LOCAL and WRITE_LOCAL, renumbered the same way). The
// Rust code chooses the arm and keeps the variable maps; the hook emits
// the Cranelift variable operations. READ_LOCAL's args carry the
// optimizer flag after the Rust words: `[var, kind, optimize]`.
pub const LOCAL_READ: u32 = 16;
pub const LOCAL_BIND: u32 = 17;
pub const LOCAL_WRITE: u32 = 18;

// `TEST_OVERFLOW`'s operators.
const T_ADD: u64 = 1;
const T_SUB: u64 = 2;
const T_MUL: u64 = 3;
const T_DIV: u64 = 4;

// `PLAN_SHIFT`'s operations (the low byte of `a`; the kind is the next).
const SHIFT_ISHL: u64 = 1;
const SHIFT_USHR: u64 = 2;
const SHIFT_SSHR: u64 = 3;
const SHIFT_ROTL: u64 = 4;

// `PLAN_CONVERT`'s conversions (the low byte of `a`; the target kind is
// the next): `numeric::Conversion`.
const CONV_WRAPPING: u64 = 3;

// `PLAN_BINOP`'s operations.
const BIN_IADD: u64 = 1;
const BIN_ISUB: u64 = 2;
const BIN_IMUL: u64 = 3;
const BIN_UDIV: u64 = 4;
const BIN_UREM: u64 = 5;
const BIN_SREM: u64 = 6;
const BIN_BAND: u64 = 7;
const BIN_BOR: u64 = 8;
const BIN_BXOR: u64 = 9;

// A packed coerce word is one byte.
const BYTE: u64 = 255;

// Argument positions.
const ARG_A: u64 = 0;
const ARG_B: u64 = 1;
const ARG_OPTIMIZE: u64 = 2;
const ARG_X: u64 = 3;
const ARG_Y: u64 = 4;

// Type codes (`codegen_swap::ty_code`) of the integer lanes the hook
// emits on: I8 1 to I64 4.
const CODE_I8: u32 = 1;
const CODE_I64: u32 = 4;

// Integer kinds, in `numeric::IntegerKind`'s order: 1 u8, 2 u16, 3 u32,
// 6 i8, 7 i16, 8 i32 are the narrow ones `coerce` reduces.
pub fn kind_unsigned(kind: u64) -> bool {
    kind >= 1 && kind <= 5
}
fn kind_bits(kind: u64) -> u64 {
    if kind == 1 || kind == 6 {
        8
    } else if kind == 2 || kind == 7 {
        16
    } else {
        32
    }
}
fn kind_mask(kind: u64) -> i64 {
    if kind == 1 {
        255
    } else if kind == 2 {
        65535
    } else {
        4294967295
    }
}

// The narrow type of a narrow kind's width.
pub fn narrow_type(bits: u64) -> Ty {
    if bits == 8 {
        ty_i8()
    } else if bits == 16 {
        ty_i16()
    } else {
        ty_i32()
    }
}

// Whether `kind` is a one-word kind narrower than 64 bits.
fn narrow_kind(kind: u64) -> bool {
    (kind >= 1 && kind <= 3) || (kind >= 6 && kind <= 8)
}

fn code(ty: Ty) -> u32 {
    ty.code
}

// `Codegen::coerce` of a one-word value to narrow `kind` (0: none): a
// narrow move on the optimize path, else a mask or a shift pair, and only
// on an I64 lane.
pub fn coerce(
    inout builder: Builder,
    value: Value,
    kind: u64,
    optimize: bool
) -> Value eff [Ffi[Cranelift]] {
    if kind == 0 || code(value_type(inout builder, value)) != CODE_I64 {
        return value;
    }
    let bits = kind_bits(kind);
    if optimize {
        let narrow = narrow_type(bits);
        let low = ins_ireduce(inout builder, narrow, value);
        return if kind_unsigned(kind) {
            ins_uextend(inout builder, ty_i64(), low)
        } else {
            ins_sextend(inout builder, ty_i64(), low)
        };
    }
    if kind_unsigned(kind) {
        return ins_band_imm(inout builder, value, kind_mask(kind));
    }
    let shift_bits = wrapping_i64(wrapping_sub(64, bits));
    let shifted = ins_ishl_imm(inout builder, value, shift_bits);
    ins_sshr_imm(inout builder, shifted, shift_bits)
}

// Whether `value` has an integer lane of one word or less (I8 to I64).
fn word_lane(inout builder: Builder, value: Value) -> bool eff [Ffi[Cranelift]] {
    let lane_code = code(value_type(inout builder, value));
    lane_code >= CODE_I8 && lane_code <= CODE_I64
}

fn cc_of(cc: u64) -> u32 {
    if cc == 1 {
        cc_eq()
    } else if cc == 2 {
        cc_ne()
    } else if cc == 3 {
        cc_slt()
    } else if cc == 4 {
        cc_sle()
    } else if cc == 5 {
        cc_sgt()
    } else if cc == 6 {
        cc_sge()
    } else if cc == 7 {
        cc_ult()
    } else if cc == 8 {
        cc_ule()
    } else if cc == 9 {
        cc_ugt()
    } else {
        cc_uge()
    }
}

// The operand values, when the request carries `n` of them on one-word
// integer lanes of one type (`Codegen::binary` refuses mismatched lanes;
// floats and 128-bit words take other arms).
fn operands(inout builder: Builder, call: u64, n: u64) -> bool eff [Ffi[Cranelift]] {
    if call_arg_count(call) != add(ARG_X, n) {
        return false;
    }
    let first = value_of_word(call_arg(call, ARG_X));
    if !word_lane(inout builder, first) {
        return false;
    }
    if n == 2 {
        let second = value_of_word(call_arg(call, ARG_Y));
        if code(value_type(inout builder, second)) != code(value_type(inout builder, first)) {
            return false;
        }
    }
    true
}

// `Codegen::ir_temp` of the operand at `arg_index`: a fresh variable of the value's
// type, defined as the value. The Rust walk names each operand this way
// before `expr_at` reads it back with `use_var`, and the variables it
// declares number the ones after them, so the port declares the same.
pub fn temp(inout builder: Builder, value: Value) -> Var eff [Ffi[Cranelift]] {
    let ty = value_type(inout builder, value);
    let var = declare_var(inout builder, ty);
    def_var(inout builder, var, value);
    var
}

// `Codegen::shift`'s rotation of `value` by `amount` in `kind`: in the kind's own width
// (Cranelift takes the amount modulo the width), extended back to a word.
fn rotate(
    inout builder: Builder,
    value: Value,
    amount: Value,
    left: bool,
    kind: u64
) -> Value eff [Ffi[Cranelift]] {
    let lane = value_type(inout builder, value);
    let narrow = if narrow_kind(kind) {
        narrow_type(kind_bits(kind))
    } else {
        lane
    };
    let narrowed = if code(narrow) == code(lane) {
        value
    } else {
        ins_ireduce(inout builder, narrow, value)
    };
    let rotated = if left {
        ins_rotl(inout builder, narrowed, amount)
    } else {
        ins_rotr(inout builder, narrowed, amount)
    };
    if code(narrow) == CODE_I64 {
        rotated
    } else if kind_unsigned(kind) {
        ins_uextend(inout builder, ty_i64(), rotated)
    } else {
        ins_sextend(inout builder, ty_i64(), rotated)
    }
}

// `expr_at`'s read of an operand: `use_var` of its temporary, then
// `coerce` to the operand's own type.
pub fn operand(
    inout builder: Builder,
    var: Var,
    coerce_words: u64,
    optimize: bool
) -> Value eff [Ffi[Cranelift]] {
    let value = use_var(inout builder, var);
    coerce(inout builder, value, coerce_words & BYTE, optimize)
}

fn add(a: u64, c: u64) -> u64 {
    wrapping_add(a, c)
}

// `IntegerKind::min` of a narrow signed kind (6 i8, 7 i16, 8 i32).
fn narrow_min(kind: u64) -> i64 {
    if kind == 6 {
        -128
    } else if kind == 7 {
        -32768
    } else {
        -2147483648
    }
}

// `dividend / divisor`'s overflow: `dividend` is the kind's minimum and `divisor` is -1.
fn div_min(
    inout builder: Builder,
    dividend: Value,
    divisor: Value,
    min: i64
) -> Value eff [Ffi[Cranelift]] {
    let is_min = ins_icmp_imm(inout builder, cc_eq(), dividend, min);
    let minus_one = ins_icmp_imm(inout builder, cc_eq(), divisor, -1);
    ins_band(inout builder, is_min, minus_one)
}

fn arith(inout builder: Builder, op: u64, lhs: Value, rhs: Value) -> Value eff [Ffi[Cranelift]] {
    if op == T_ADD {
        ins_iadd(inout builder, lhs, rhs)
    } else if op == T_SUB {
        ins_isub(inout builder, lhs, rhs)
    } else {
        ins_imul(inout builder, lhs, rhs)
    }
}

// `Codegen::checked_arithmetic`'s overflow test of `op` on one-word kind
// `kind` (1 u8 ... 10 isize), or DECLINED's invalid value when it has none.
fn overflow_test(call: u64, inout builder: Builder) -> u64 eff [Ffi[Cranelift]] {
    let op = call_arg(call, 0);
    let kind = call_arg(call, 1);
    let lhs = value_of_word(call_arg(call, 2));
    let rhs = value_of_word(call_arg(call, 3));
    let overflowed = emit_overflow_test(inout builder, op, kind, lhs, rhs);
    if is_invalid(overflowed) {
        return DECLINED;
    }
    call_result_value(call, overflowed);
    HANDLED
}

// The overflow flag of `overflow_test` on the operand values, or an invalid
// value when `op` on `kind` has no test (the body hook's checked
// arithmetic, #2425, emits it directly).
pub fn emit_overflow_test(
    inout builder: Builder,
    op: u64,
    kind: u64,
    lhs: Value,
    rhs: Value
) -> Value eff [Ffi[Cranelift]] {
    let narrow_signed = kind >= 6 && kind <= 8;
    let narrow_unsigned = kind >= 1 && kind <= 3;
    let word_unsigned = kind == 4 || kind == 5;
    let word_signed = kind == 9 || kind == 10;
    if op != T_DIV && narrow_signed {
        // Exact in 64 bits; overflow iff the result leaves the kind.
        let result = arith(inout builder, op, lhs, rhs);
        let shift_bits = wrapping_i64(wrapping_sub(64, kind_bits(kind)));
        let shifted = ins_ishl_imm(inout builder, result, shift_bits);
        let canonical = ins_sshr_imm(inout builder, shifted, shift_bits);
        ins_icmp(inout builder, cc_ne(), canonical, result)
    } else if op == T_DIV && narrow_signed {
        div_min(inout builder, lhs, rhs, narrow_min(kind))
    } else if (op == T_ADD || op == T_MUL) && narrow_unsigned {
        let result = arith(inout builder, op, lhs, rhs);
        ins_icmp_imm(inout builder, cc_ugt(), result, kind_mask(kind))
    } else if op == T_SUB && (narrow_unsigned || word_unsigned) {
        ins_icmp(inout builder, cc_ult(), lhs, rhs)
    } else if op == T_ADD && word_unsigned {
        let result = ins_iadd(inout builder, lhs, rhs);
        ins_icmp(inout builder, cc_ult(), result, lhs)
    } else if op == T_MUL && word_unsigned {
        let high = ins_umulhi(inout builder, lhs, rhs);
        ins_icmp_imm(inout builder, cc_ne(), high, 0)
    } else if (op == T_ADD || op == T_SUB) && word_signed {
        // Signed overflow iff the result's sign differs from both addends
        // (addition) or from the minuend while the operand signs differ
        // (subtraction).
        let result = arith(inout builder, op, lhs, rhs);
        let lhs_flip = ins_bxor(inout builder, lhs, result);
        let other_flip = if op == T_ADD {
            ins_bxor(inout builder, rhs, result)
        } else {
            ins_bxor(inout builder, lhs, rhs)
        };
        let both = ins_band(inout builder, lhs_flip, other_flip);
        ins_icmp_imm(inout builder, cc_slt(), both, 0)
    } else if op == T_MUL && word_signed {
        let result = ins_imul(inout builder, lhs, rhs);
        let high = ins_smulhi(inout builder, lhs, rhs);
        let sign = ins_sshr_imm(inout builder, result, 63);
        ins_icmp(inout builder, cc_ne(), high, sign)
    } else if op == T_DIV && word_signed {
        div_min(inout builder, lhs, rhs, -9223372036854775807 - 1)
    } else {
        Value { id: invalid() }
    }
}

// `IntegerKind::max` of a one-word kind, as an `i64` immediate (u64's
// max is -1, as Rust's `as i64` makes it).
pub fn kind_max_imm(kind: u64) -> i64 {
    if kind == 1 {
        255
    } else if kind == 2 {
        65535
    } else if kind == 3 {
        4294967295
    } else if kind == 4 || kind == 5 {
        -1
    } else if kind == 6 {
        127
    } else if kind == 7 {
        32767
    } else if kind == 8 {
        2147483647
    } else {
        9223372036854775807
    }
}

// `IntegerKind::min` of a one-word kind.
pub fn kind_min_imm(kind: u64) -> i64 {
    if kind_unsigned(kind) {
        0
    } else if kind == 6 || kind == 7 || kind == 8 {
        narrow_min(kind)
    } else {
        -9223372036854775807 - 1
    }
}

// The maximum of `kind` as an unsigned magnitude, for comparing kinds.
fn max_magnitude(kind: u64) -> u64 {
    if kind == 4 || kind == 5 {
        18446744073709551615
    } else {
        wrapping_u64(kind_max_imm(kind))
    }
}

// The magnitude of `kind`'s minimum (0 for an unsigned kind).
fn min_magnitude(kind: u64) -> u64 {
    if kind_unsigned(kind) {
        0
    } else if kind == 6 {
        128
    } else if kind == 7 {
        32768
    } else if kind == 8 {
        2147483648
    } else {
        9223372036854775808
    }
}

// `Codegen::convert`'s checked narrowing bounds from kind `from` to `to`, or
// DECLINED when the target holds every source value.
fn narrow_test(call: u64, inout builder: Builder) -> u64 eff [Ffi[Cranelift]] {
    let from = call_arg(call, 0);
    let to = call_arg(call, 1);
    let value = value_of_word(call_arg(call, 2));
    let high_needed = max_magnitude(to) < max_magnitude(from);
    let out_of_range = if kind_unsigned(from) {
        // The lane is the value as a u64; the target minimum is at most 0.
        if !high_needed {
            return DECLINED;
        }
        ins_icmp_imm(inout builder, cc_ugt(), value, kind_max_imm(to))
    } else {
        // `to.min() > from.min()`: the target's minimum is nearer zero.
        let low_needed = min_magnitude(to) < min_magnitude(from);
        if !low_needed && !high_needed {
            return DECLINED;
        }
        if low_needed && high_needed {
            let low = ins_icmp_imm(inout builder, cc_slt(), value, kind_min_imm(to));
            let high = ins_icmp_imm(inout builder, cc_sgt(), value, kind_max_imm(to));
            ins_bor(inout builder, low, high)
        } else if low_needed {
            ins_icmp_imm(inout builder, cc_slt(), value, kind_min_imm(to))
        } else {
            ins_icmp_imm(inout builder, cc_sgt(), value, kind_max_imm(to))
        }
    };
    call_result_value(call, out_of_range);
    HANDLED
}

// One planned request on the lent builder; DECLINED emits nothing.
fn scalar(call: u64, inout builder: Builder) -> u64 eff [Ffi[Cranelift]] {
    let op = call_op(call);
    if op == TEST_OVERFLOW {
        return overflow_test(call, inout builder);
    }
    if op == TEST_NEGATE {
        // Signed MIN and every nonzero unsigned value overflow.
        let kind = call_arg(call, 0);
        let value = value_of_word(call_arg(call, 1));
        let result = if kind_unsigned(kind) {
            ins_icmp_imm(inout builder, cc_ne(), value, 0)
        } else {
            ins_icmp_imm(inout builder, cc_eq(), value, kind_min_imm(kind))
        };
        call_result_value(call, result);
        return HANDLED;
    }
    if op == TEST_SHIFT_RANGE {
        // Negative amounts are huge as unsigned lanes.
        let amount = value_of_word(call_arg(call, 0));
        let bits = wrapping_i64(call_arg(call, 1));
        let result = ins_icmp_imm(inout builder, cc_uge(), amount, bits);
        call_result_value(call, result);
        return HANDLED;
    }
    if op == TEST_NARROW {
        return narrow_test(call, inout builder);
    }
    if op == LOCAL_READ {
        // `use_var`, then `coerce` to the read's type; the raw value too,
        // which the Rust code keeps the variable's facts on.
        let var = Var { id: wrapping_u32(call_arg(call, 0)) };
        let raw = use_var(inout builder, var);
        let value = coerce(inout builder, raw, call_arg(call, 1), call_arg(call, 2) != 0);
        call_result_value(call, value);
        call_result_value(call, raw);
        return HANDLED;
    }
    if op == LOCAL_BIND {
        let value = value_of_word(call_arg(call, 0));
        let var_ty = value_type(inout builder, value);
        let var = declare_var(inout builder, var_ty);
        def_var(inout builder, var, value);
        call_result(call, widen_u64(var.id));
        return HANDLED;
    }
    if op == LOCAL_WRITE {
        let var = Var { id: wrapping_u32(call_arg(call, 0)) };
        def_var(inout builder, var, value_of_word(call_arg(call, 1)));
        return HANDLED;
    }
    if op == TEST_DIVISOR {
        let divisor = value_of_word(call_arg(call, 0));
        let nonzero = ins_icmp_imm(inout builder, cc_ne(), divisor, 0);
        call_result_value(call, nonzero);
        return HANDLED;
    }
    let a = call_arg(call, ARG_A);
    let coerce_words = call_arg(call, ARG_B);
    let optimize = call_arg(call, ARG_OPTIMIZE) != 0;
    let count = operand_count(op);
    if count != 0 && !operands(inout builder, call, count) {
        return DECLINED;
    }
    let lhs = if count >= 1 {
        value_of_word(call_arg(call, ARG_X))
    } else {
        Value { id: invalid() }
    };
    let rhs = if count == 2 {
        value_of_word(call_arg(call, ARG_Y))
    } else {
        Value { id: invalid() }
    };
    let result = planned(inout builder, op, a, coerce_words, optimize, lhs, rhs);
    if is_invalid(result) {
        return DECLINED;
    }
    call_result_value(call, result);
    HANDLED
}

// The operands a planned request reads: two for a comparison, an
// operator or a shift, one for a unary operator or a conversion.
fn operand_count(op: u32) -> u64 {
    if op == PLAN_ICMP || op == PLAN_BINOP || op == PLAN_SHIFT {
        2
    } else if op == PLAN_BNOT || op == PLAN_NOT || op == PLAN_INEG || op == PLAN_CONVERT {
        1
    } else {
        0
    }
}

// The planned request `op` with immediates `a` and `coerce_words` on
// operand values `lhs0` and `rhs0` (as many as `operand_count`), as
// `expr_at` emits it: each operand named by a temporary
// (`Codegen::ir_temp`) and read back, then the arm and its `coerce`. An
// invalid value when `op` is no request.
pub fn planned(
    inout builder: Builder,
    op: u32,
    a: u64,
    coerce_words: u64,
    optimize: bool,
    lhs0: Value,
    rhs0: Value
) -> Value eff [Ffi[Cranelift]] {
    if op == PLAN_ZERO {
        ins_iconst(inout builder, ty_i64(), 0)
    } else if op == PLAN_ICONST {
        let value = ins_iconst(inout builder, ty_i64(), wrapping_i64(a));
        coerce(inout builder, value, coerce_words, optimize)
    } else if op == PLAN_F64CONST {
        ins_f64const(inout builder, a)
    } else if op == PLAN_ICMP {
        let lhs_var = temp(inout builder, lhs0);
        let rhs_var = temp(inout builder, rhs0);
        let lhs = operand(inout builder, lhs_var, coerce_words >> 8, optimize);
        let rhs = operand(inout builder, rhs_var, coerce_words >> 16, optimize);
        let cmp = ins_icmp(inout builder, cc_of(a), lhs, rhs);
        let value = ins_uextend(inout builder, ty_i64(), cmp);
        coerce(inout builder, value, coerce_words & BYTE, optimize)
    } else if op == PLAN_BINOP {
        let lhs_var = temp(inout builder, lhs0);
        let rhs_var = temp(inout builder, rhs0);
        let lhs = operand(inout builder, lhs_var, coerce_words >> 8, optimize);
        let rhs = operand(inout builder, rhs_var, coerce_words >> 16, optimize);
        let value = if a == BIN_IADD {
            ins_iadd(inout builder, lhs, rhs)
        } else if a == BIN_ISUB {
            ins_isub(inout builder, lhs, rhs)
        } else if a == BIN_IMUL {
            ins_imul(inout builder, lhs, rhs)
        } else if a == BIN_UDIV {
            ins_udiv(inout builder, lhs, rhs)
        } else if a == BIN_UREM {
            ins_urem(inout builder, lhs, rhs)
        } else if a == BIN_SREM {
            ins_srem(inout builder, lhs, rhs)
        } else if a == BIN_BAND {
            ins_band(inout builder, lhs, rhs)
        } else if a == BIN_BOR {
            ins_bor(inout builder, lhs, rhs)
        } else if a == BIN_BXOR {
            ins_bxor(inout builder, lhs, rhs)
        } else {
            return Value { id: invalid() };
        };
        coerce(inout builder, value, coerce_words & BYTE, optimize)
    } else if op == PLAN_BNOT || op == PLAN_NOT || op == PLAN_INEG {
        let src_var = temp(inout builder, lhs0);
        let src = operand(inout builder, src_var, a >> 8, optimize);
        let value = if op == PLAN_BNOT {
            ins_bnot(inout builder, src)
        } else if op == PLAN_INEG {
            ins_ineg(inout builder, src)
        } else {
            let cmp = ins_icmp_imm(inout builder, cc_eq(), src, 0);
            ins_uextend(inout builder, ty_i64(), cmp)
        };
        // `bnot`, `ineg` and `!` read the plan's coerce words from `a`.
        coerce(inout builder, value, a & BYTE, optimize)
    } else if op == PLAN_SHIFT {
        let lhs_var = temp(inout builder, lhs0);
        let rhs_var = temp(inout builder, rhs0);
        let lhs = operand(inout builder, lhs_var, coerce_words >> 8, optimize);
        let amount = operand(inout builder, rhs_var, coerce_words >> 16, optimize);
        let how = a & BYTE;
        let value = if how == SHIFT_ISHL {
            ins_ishl(inout builder, lhs, amount)
        } else if how == SHIFT_USHR {
            ins_ushr(inout builder, lhs, amount)
        } else if how == SHIFT_SSHR {
            ins_sshr(inout builder, lhs, amount)
        } else {
            rotate(inout builder, lhs, amount, how == SHIFT_ROTL, (a >> 8) & BYTE)
        };
        coerce(inout builder, value, coerce_words & BYTE, optimize)
    } else if op == PLAN_CONVERT {
        let src_var = temp(inout builder, lhs0);
        let src = operand(inout builder, src_var, coerce_words >> 8, optimize);
        let to = (a >> 8) & BYTE;
        // A widening and an unchecked narrowing are the operand itself.
        let value = if (a & BYTE) == CONV_WRAPPING && narrow_kind(to) {
            coerce(inout builder, src, to, optimize)
        } else {
            src
        };
        coerce(inout builder, value, coerce_words & BYTE, optimize)
    } else {
        Value { id: invalid() }
    }
}

// The `scalar` hook: one planned instruction over the lent builder.
pub fn scalar_hook(call: u64) -> u64 eff [Ffi[Cranelift]] {
    let mut builder = match call_builder(call) {
        Some(builder) => builder,
        None => return DECLINED,
    };
    let handled = scalar(call, inout builder);
    call_return_builder(call, builder);
    handled
}

// The `body` hook (#2094, part 6a): a whole scalar function's body from
// its body plan (`body.ves`) over the lent builder, and the lent module
// its direct calls import their callees from (part 6b).
pub fn body_hook(call: u64) -> u64 eff [Ffi[Cranelift]] {
    let mut builder = match call_builder(call) {
        Some(builder) => builder,
        None => return DECLINED,
    };
    let mut module = match call_module(call) {
        Some(module) => module,
        None => {
            call_return_builder(call, builder);
            return DECLINED;
        }
    };
    let answer = emit_body(call, inout builder, inout module);
    call_return_module(call, module);
    call_return_builder(call, builder);
    answer
}
