const MATCH_FIELDS: u64 = 16;

// A product pattern's nodes (#2654, @vesper/codegen-scalar's `PNODE_*`).
const PNODE_NONE: u64 = 0;
const PNODE_LOCAL: u64 = 1;
const PNODE_INT: u64 = 2;
const PNODE_FIELDS: u64 = 3;
const PNODE_TAG: u64 = 4;

