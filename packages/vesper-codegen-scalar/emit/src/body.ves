const NESTED_REGISTER: u64 = 65536;
const HANDLER_HOME: u64 = 131072;
// `dispatch_trap`'s code at the end of a handler's return dispatch.
const DISPATCH_TRAP: u32 = 4;
// No slot.
const NONE64: u64 = 18446744073709551615;
const INST_ICONST: u64 = 16;
const INST_F64CONST: u64 = 17;
const INST_DATA: u64 = 32;
const INST_PROJECT: u64 = 33;
const INST_READ_FIELD: u64 = 34;
