// The `body` hook's emission (#2094, parts 6a-6c of #1509): a whole scalar
// function's body on the lent builder, from @vesper/codegen-scalar's body
// plan (`codegen_scalar_body_plan`), in the order `Codegen::ir_graph_at`
// (src/native.rs) makes its builder calls, so the CLIF is the Rust walk's.
//
// A request's arguments are `[optimize, status, locations, n, n parameter
// variables, m, m callees, the function's plan words]`: the optimizer
// flag, whether the function returns a status word beside its value (the
// register-status Fail ABI), whether instructions carry source locations,
// the variables the entry block bound the parameters to (a `fail_only`
// function's failure record last), and for each of the function's calls
// the function the walk would call directly (part 6b; a `fail_only`
// callee's word carries FAIL_CALL, and STATUS_CALL when it returns its
// status in a register), or NO_CALLEE (allowed for builtin calls, declines
// otherwise). After the callees come the result pointer's value
// (`NO_VALUE` for a function that returns a scalar) and the values
// whose home is that pointer (`aggregates::plan`'s `Home::Result`, #2411):
// a struct built there is written in place, and any other struct result
// is copied to it on return. A function that returns its result in
// registers (#2581) builds it the same way in a local buffer, whose words
// it then returns: its `sret` word carries their count at
// RESULT_WORDS_SHIFT.
//
// A `fail_only` function (#2425) raises through its record
// (`Codegen::fail_exit`): the instance's tag, stored in the record unless
// the status is returned, the error copied to the payload, and a zero
// returned beside the tag.
//
// Each local's entry in the plan is followed by the narrow kind its
// stores coerce to. On the unoptimized path every local lives in a stack
// slot, the way `ir_graph_at` keeps any local without a register. Right
// after its variable is declared, its value is stored to a fresh zeroed
// slot of its size (`Codegen::alloc`), and the slot's address goes in a
// variable. A read loads through that address. A bind stores once, and an
// assignment stores twice, the second time after `coerce` to the local's
// kind (`def_local`, then `store`). A graph of at most
// `FULL_REFRESH_VALUES` values reads every value from its register before
// each instruction and each terminator, not just the operands.

use @vesper/cranelift::codes::{Bin, Cv, FloatCc, Ternary, TyCode, Un};
use @vesper/cranelift::{
    Block, FuncId, Ty, Value, Var, append_block_param, call_args, cc_eq, cc_ne, cc_sge, cc_sgt,
    cc_sle, cc_slt, cc_uge, cc_ugt, cc_ule, cc_ult, create_block, current_block, declare_var,
    def_var, import_function, ins_band, ins_band_imm, ins_binary, ins_bitcast, ins_bnot, ins_bor,
    ins_brif, ins_brif0, ins_bxor, ins_call, ins_clz, ins_convert, ins_ctz, ins_f32const,
    ins_f64const, ins_fadd, ins_fcmp, ins_fdiv, ins_fmul, ins_fneg, ins_fsub, ins_iadd, ins_icmp,
    ins_icmp_imm, ins_iconcat, ins_iconst, ins_imul, ins_ineg, ins_ireduce, ins_ishl, ins_isub,
    ins_jump, ins_popcnt, ins_return, ins_sdiv, ins_select, ins_sextend, ins_srem, ins_sshr,
    ins_trap, ins_udiv, ins_uextend, ins_unary, ins_urem, ins_ushr, inst_result, invalid,
    is_invalid, seal_block, set_srcloc, switch_to_block, trap_user, ty_f32, ty_f64, ty_i128, ty_i32,
    ty_i64, ty_i8, use_var, vals1, value_type, create_stack_slot, ins_iadd_imm, ins_load,
    ins_stack_addr, ins_store, module_pointer_type, ins_imul_imm, ins_uload8, ins_uload16,
    ins_uload32, mem_can_move, mem_readonly, mem_trusted, data_align, data_define, data_new,
    declare_anonymous_data, define_data, import_data, ins_symbol_value
};
use super::{
    BODY_ERROR, DECLINED, HANDLED, coerce, emit_overflow_test, kind_max_imm, kind_min_imm,
    kind_unsigned, narrow_type, operand, planned, temp
};

// The plan's lane codes (@vesper/codegen-scalar's `body.ves`).
const LANE_I64: u64 = 1;
const LANE_F32: u64 = 2;
const LANE_F64: u64 = 3;
const LANE_I128: u64 = 4;
const LANE_PRODUCT: u64 = 5;
const LOCAL_PARAM: u64 = 16;
const LOCAL_PARAM_PRODUCT: u64 = 65536;
const STORE_AGGREGATE: u64 = 65536;
const LOCAL_HOME: u64 = 4294967296;

// Instruction kinds (`body.ves`).
const INST_PLANNED: u64 = 1;
const INST_READ: u64 = 2;
const INST_BIND: u64 = 3;
const INST_WRITE: u64 = 4;
const INST_CALL: u64 = 5;
const INST_F32CONST: u64 = 6;
const INST_FLOAT_UNARY: u64 = 7;
const INST_FLOAT_BINARY: u64 = 8;
const INST_INT_EXTRA: u64 = 9;
const INST_WRITE_OP: u64 = 10;
const INST_EXIT: u64 = 11;
const INST_CALL_BUILTIN: u64 = 12;
const INST_WIDE_CONST: u64 = 13;
const INST_WIDE_UNARY: u64 = 14;
const INST_WIDE_BINARY: u64 = 15;
const INST_CHECKED: u64 = 40;

// `INST_CHECKED`'s operators (`emit_overflow_test`'s numbers, and `%`).
const CK_ADD: u64 = 1;
const CK_SUB: u64 = 2;
const CK_MUL: u64 = 3;
const CK_DIV: u64 = 4;
const CK_REM: u64 = 5;

// A raise descriptor's absence, and the tag word of a product.
const NO_RAISE: u64 = 18446744073709551615;
const NO_TAG: u64 = 18446744073709551614;
// A failure record's error payload follows its one-word tag.
const RECORD_PAYLOAD: i64 = 8;
// A re-raised error copied by words (`/codegen-scalar`).
const AGGREGATE_ERROR: u64 = 18446744073709551615;
const INST_FAIL_CALL: u64 = 41;
// An explicit `Fail::raise` of a value (#2657).
const INST_RAISE: u64 = 44;
// A direct call that borrows scalar locals `inout` (#2563), and its
// argument tags.
const INST_INOUT_CALL: u64 = 48;
const ARG_IN: u64 = 0;
const ARG_INOUT: u64 = 1;
// `codegen_swap::body::FAIL_CALL` and `STATUS_CALL`, the flags of a callee
// word above its 32-bit `FuncId`.
const FAIL_CALL: u64 = 4294967296;
const STATUS_CALL: u64 = 8589934592;
// `codegen_swap::body::WORDS_CALL` (#2581): the callee returns its small
// enum result as words in registers.
const WORDS_CALL: u64 = 17179869184;
// A direct call whose small enum result comes back as words (#2581).
const INST_WORDS_CALL: u64 = 56;
// A sequence or string operation (#2653) and its forms (@vesper/codegen-scalar's
// `body_seq`).
const INST_SEQ: u64 = 80;
const SEQ_WORD: u64 = 1;
const SEQ_SAME: u64 = 2;
const SEQ_AS_BYTES: u64 = 3;
