// The bits of a literal byte, and the bytes of a literal word.
const BYTE_BITS: u64 = 8;
const BYTE_MASK: u64 = 255;
const STR_CAP: i32 = 8;
// A literal's static bytes are aligned like the Rust walk's.
const LITERAL_ALIGN: u64 = 8;
// A literal byte's position within its word.
const LITERAL_WORD_MASK: u64 = 7;
// The header words (src/strings/native.rs, src/seq/native.rs): a
// string's `{len, cap, data}`, a slice view's `{handle, start, len}`, a
// sequence header's data pointer.
const STR_LEN: i32 = 0;
const STR_DATA: i32 = 16;
const VIEW_HANDLE: i32 = 0;
const VIEW_START: i32 = 8;
const VIEW_LEN: i32 = 16;
const HEADER_DATA: i32 = 16;
// A slice view's storage (`seq_slice_value`, `str_value`).
const VIEW_BYTES: u32 = 24;
// `seq_load_elem`'s strides that load zero-extended.
const STRIDE_BYTE: u64 = 1;
const STRIDE_HALF: u64 = 2;
const STRIDE_QUARTER: u64 = 4;
// A struct or tuple destructured (#2654): the pattern's nodes follow.
const INST_BIND_FIELDS: u64 = 72;
const CALLEE_ID_MASK: u64 = 4294967295;
// A `Fail` handler (#2657): its handled body and clauses as nested graphs.
const INST_HANDLE: u64 = 60;
// `codegen_swap::body::NESTED_CALLS_SHIFT` (#2657): the callee count word
