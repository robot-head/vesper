const WBIN_UGT: u64 = 15;
const WBIN_UGE: u64 = 16;
const WBIN_SHL: u64 = 17;
const WBIN_USHR: u64 = 18;
const WBIN_SSHR: u64 = 19;

const KIND_WIDE_I128: u64 = 11;
const KIND_WIDE_U128: u64 = 12;

const NO_LOCAL: u64 = 18446744073709551615;
// `codegen_swap::body::NO_CALLEE`.
const NO_CALLEE: u64 = 18446744073709551615;
const TERM_RETURN: u64 = 0;
const TERM_JUMP: u64 = 1;
const TERM_BRANCH: u64 = 2;
const TERM_MATCH: u64 = 3;
const TERM_UNREACHABLE: u64 = 4;
const TERM_RETURN_SRET: u64 = 32;
// `return` of a small enum's words in registers (#2581).
const TERM_RETURN_WORDS: u64 = 33;
// `codegen_swap::body::NO_VALUE`: no result pointer.
const NO_VALUE: u64 = 18446744073709551615;
// `codegen_swap::body::RESULT_WORDS_SHIFT` (#2581): a register result's
// word count above its buffer's value in the `sret` word.
const RESULT_WORDS_SHIFT: u64 = 32;

// Argument positions.
const ARG_OPTIMIZE: u64 = 0;
const ARG_STATUS: u64 = 1;
const ARG_LOCATIONS: u64 = 2;
const ARG_PARAMS: u64 = 3;

// An instruction with no span keeps the location before it.
const NO_LOCATION: u64 = 18446744073709551615;

// Numeric constants.
const WORD_BITS: u64 = 64;
const KIND_U8: u64 = 1;
const KIND_U16: u64 = 2;
const KIND_U32: u64 = 3;
const KIND_I8: u64 = 6;
const KIND_I16: u64 = 7;
const KIND_I32: u64 = 8;
const F32_HALF_BITS: u32 = 1056964608;
const F32_ONE_BITS: u32 = 1065353216;
const F64_HALF_BITS: u64 = 4602678819172646912;
const F64_ONE_BITS: u64 = 4607182418800017408;
const I64_MIN_IMM: i64 = -9223372036854775807 - 1;
const UNREACHABLE_TRAP: u32 = 1;

// `native::FULL_REFRESH_VALUES`: the most values an unoptimized graph
// reads before every instruction.
const FULL_REFRESH_VALUES: u64 = 256;

// A local's stack slot (`Codegen::alloc`): one word, or two for an
// `i128`/`u128`, word aligned and zeroed a word at a time, with plain
// memory flags.
const WORD_BYTES: u32 = 8;
const WIDE_BYTES: u32 = 16;
const SLOT_ALIGN_SHIFT: u32 = 3;
const PLAIN: u32 = 0;

// A reader over the request's words (0 past the end, as `call_arg`).
struct Words {
    args: ChunkSeq[u64],
    at: u64,
}

impl Words {
    fn next(inout self) -> u64 {
        let w = self.arg(self.at);
        self.at = wrapping_add(self.at, 1);
        w
    }
    fn arg(in self, i: u64) -> u64 {
        match self.args.try_get(i) {
            Option::Some(w) => w,
            Option::None => 0,
        }
    }
}

fn at32(in s: ChunkSeq[u32], i: u64) -> u32 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => invalid(),
    }
}

fn at64(in s: ChunkSeq[u64], i: u64) -> u64 {
    s.try_get(i).unwrap_or(0)
}

fn var_at(in s: ChunkSeq[u32], i: u64) -> Var {
    Var { id: at32(in s, i) }
}

fn lane_type(lane: u64) -> Ty {
    if lane == LANE_F32 {
        ty_f32()
    } else if lane == LANE_F64 {
        ty_f64()
    } else if lane == LANE_I128 {
        ty_i128()
    } else {
        ty_i64()
    }
}

fn wide_const(inout b: Builder, lo: u64, hi: u64) -> Value eff [Ffi[Cranelift]] {
    let low = ins_iconst(inout b, ty_i64(), wrapping_i64(lo));
    let high = ins_iconst(inout b, ty_i64(), wrapping_i64(hi));
    ins_iconcat(inout b, low, high)
}

fn is_wide_kind(kind: u64) -> bool {
    kind == KIND_WIDE_I128 || kind == KIND_WIDE_U128
}

// Full `Codegen::coerce` including `I64 <-> I128` widening/narrowing.
fn body_coerce(
    inout b: Builder,
    v: Value,
    kind: u64,
    optimize: bool
) -> Value eff [Ffi[Cranelift]] {
    if kind == 0 {
        return v;
    }
    let lane = value_type(inout b, v).code;
    if is_wide_kind(kind) {
        if lane == TyCode::I64 {
            return if kind == KIND_WIDE_I128 {
                ins_sextend(inout b, ty_i128(), v)
            } else {
                ins_uextend(inout b, ty_i128(), v)
            };
        }
        return v;
    }
    if lane == TyCode::I128 {
        let low = ins_ireduce(inout b, ty_i64(), v);
        return coerce(inout b, low, kind, optimize);
    }
    coerce(inout b, v, kind, optimize)
}

fn body_operand(
    inout b: Builder,
    var: Var,
    kind: u64,
    optimize: bool
) -> Value eff [Ffi[Cranelift]] {
    let v = use_var(inout b, var);
    body_coerce(inout b, v, kind, optimize)
}

fn word_kind_bits(kind: u64) -> u64 {
    if kind == KIND_U8 || kind == KIND_I8 {
        8
    } else if kind == KIND_U16 || kind == KIND_I16 {
        16
    } else if kind == KIND_U32 || kind == KIND_I32 {
        32
    } else {
        WORD_BITS
    }
}

// `scalar_zero` (and `default_value`) of a lane.
fn zero_of(inout b: Builder, lane: u64) -> Value eff [Ffi[Cranelift]] {
    if lane == LANE_F32 {
        ins_f32const(inout b, 0)
    } else if lane == LANE_F64 {
        ins_f64const(inout b, 0)
    } else if lane == LANE_I128 {
        wide_const(inout b, 0, 0)
    } else {
        ins_iconst(inout b, ty_i64(), 0)
    }
}

// A fresh variable of `lane`, defined as its zero.
fn zeroed(inout b: Builder, lane: u64) -> u32 eff [Ffi[Cranelift]] {
    let var = declare_var(inout b, lane_type(lane));
    let zero = zero_of(inout b, lane);
    def_var(inout b, var, zero);
    var.id
}

fn has_call(in list: ChunkSeq[u64], idx: u64) -> bool {
    for k in 0..list.len() {
        if at64(in list, k) == idx {
            return true;
        }
    }
    false
}

// `Codegen::binary`'s guarded signed 64-bit division (`i64::MIN / -1` wraps).
fn emit_sdiv_guarded(inout b: Builder, lhs: Value, rhs: Value) -> Value eff [Ffi[Cranelift]] {
    let is_min = ins_icmp_imm(inout b, cc_eq(), lhs, I64_MIN_IMM);
    let minus_one = ins_icmp_imm(inout b, cc_eq(), rhs, -1);
    let overflow = ins_band(inout b, is_min, minus_one);
    let wrap = create_block(inout b);
    let divide = create_block(inout b);
    let join = create_block(inout b);
    let result_param = append_block_param(inout b, join, ty_i64());
    ins_brif0(inout b, overflow, wrap, divide);
    switch_to_block(inout b, wrap);
    let wrap_args = vals1(lhs);
    ins_jump(inout b, join, in wrap_args.as_slice());
    switch_to_block(inout b, divide);
    let quot = ins_sdiv(inout b, lhs, rhs);
    let div_args = vals1(quot);
    ins_jump(inout b, join, in div_args.as_slice());
    switch_to_block(inout b, join);
    result_param
}

// `Codegen::bit_builtin` on one-word integer kind `kind`.
fn emit_bit_builtin(
    inout b: Builder,
    bop: u64,
    kind: u64,
    lhs: Value,
    rhs: Value
) -> Value eff [Ffi[Cranelift]] {
    let bits = word_kind_bits(kind);
    let narrowed = if bits == WORD_BITS {
        lhs
    } else {
        ins_ireduce(inout b, narrow_type(bits), lhs)
    };
    let unsigned = kind_unsigned(kind);
    let mut signed = !unsigned;
    let raw = if bop == BIT_OP_CLZ {
        signed = false;
        ins_clz(inout b, narrowed)
    } else if bop == BIT_OP_CTZ {
        signed = false;
        ins_ctz(inout b, narrowed)
    } else if bop == BIT_OP_POPCNT {
        signed = false;
        ins_popcnt(inout b, narrowed)
    } else if bop == BIT_OP_WRAPPING_NEG {
        ins_ineg(inout b, narrowed)
    } else if bop == BIT_OP_WRAPPING_SHL {
        ins_ishl(inout b, narrowed, rhs)
    } else if unsigned {
        ins_ushr(inout b, narrowed, rhs)
    } else {
        ins_sshr(inout b, narrowed, rhs)
    };
    if bits == WORD_BITS {
        raw
    } else if signed {
        ins_sextend(inout b, ty_i64(), raw)
    } else {
        ins_uextend(inout b, ty_i64(), raw)
    }
}

// `Codegen::bitwise` on one-word integer kind `kind`.
fn emit_bitwise(
    inout b: Builder,
    intr: u64,
    kind: u64,
    lhs: Value,
    rhs: Value
) -> Value eff [Ffi[Cranelift]] {
    if intr == BIT_INTR_AND {
        return ins_band(inout b, lhs, rhs);
    }
    if intr == BIT_INTR_OR {
        return ins_bor(inout b, lhs, rhs);
    }
    if intr == BIT_INTR_XOR {
        return ins_bxor(inout b, lhs, rhs);
    }
    let mask = wrapping_sub(wrapping_i64(word_kind_bits(kind)), 1);
    let amount = ins_band_imm(inout b, rhs, mask);
    if intr == BIT_INTR_SHL {
        ins_ishl(inout b, lhs, amount)
    } else if kind_unsigned(kind) {
        ins_ushr(inout b, lhs, amount)
    } else {
        ins_sshr(inout b, lhs, amount)
    }
}

// `Codegen::float_unary` and float unary `-` (`denorm` is empty on plain bodies).
fn emit_float_unary(
    inout b: Builder,
    fun: u64,
    meta: u64,
    src: Value
) -> Value eff [Ffi[Cranelift]] {
    if fun == FUN_FNEG {
        return ins_fneg(inout b, src);
    }
    if fun == FUN_SQRT {
        return ins_unary(inout b, Un::Sqrt, src);
    }
    if fun == FUN_ABS {
        return ins_unary(inout b, Un::Fabs, src);
    }
    if fun == FUN_FLOOR {
        return ins_unary(inout b, Un::Floor, src);
    }
    if fun == FUN_CEIL {
        return ins_unary(inout b, Un::Ceil, src);
    }
    if fun == FUN_TRUNC {
        return ins_unary(inout b, Un::Trunc, src);
    }
    if fun == FUN_ROUND {
        let is32 = value_type(inout b, src).code == TyCode::F32;
        let t = ins_unary(inout b, Un::Trunc, src);
        let dist = ins_binary(inout b, Bin::Fsub, src, t);
        let dist = ins_unary(inout b, Un::Fabs, dist);
        let half = if is32 {
            ins_f32const(inout b, F32_HALF_BITS)
        } else {
            ins_f64const(inout b, F64_HALF_BITS)
        };
        let far = ins_fcmp(inout b, FloatCc::Ge, dist, half);
        let one = if is32 {
            ins_f32const(inout b, F32_ONE_BITS)
        } else {
            ins_f64const(inout b, F64_ONE_BITS)
        };
        let step = ins_binary(inout b, Bin::Fcopysign, one, src);
        let away = ins_binary(inout b, Bin::Fadd, t, step);
        return ins_select(inout b, far, away, t);
    }
    if fun == FUN_FPROMOTE {
        return ins_convert(inout b, Cv::Fpromote, ty_f64(), src);
    }
    if fun == FUN_FDEMOTE {
        return ins_convert(inout b, Cv::Fdemote, ty_f32(), src);
    }
    if fun == FUN_FNOOP {
        return src;
    }
    if fun == FUN_FCVT_SINT {
        return ins_convert(inout b, Cv::FcvtFromSint, lane_type(meta), src);
    }
    if fun == FUN_FCVT_UINT {
        return ins_convert(inout b, Cv::FcvtFromUint, lane_type(meta), src);
    }
    if fun == FUN_TO_BITS_F64 {
        return ins_bitcast(inout b, ty_i64(), src);
    }
    if fun == FUN_TO_BITS_F32 {
        let w32 = ins_bitcast(inout b, ty_i32(), src);
        return ins_uextend(inout b, ty_i64(), w32);
    }
    if fun == FUN_FROM_BITS_F64 {
        return ins_bitcast(inout b, ty_f64(), src);
    }
    if fun == FUN_FROM_BITS_F32 {
        let w32 = ins_ireduce(inout b, ty_i32(), src);
        return ins_bitcast(inout b, ty_f32(), w32);
    }
    if fun == FUN_SAT_TO_INT {
        let bits = word_kind_bits(meta);
        if !kind_unsigned(meta) {
            let n = ins_convert(inout b, Cv::FcvtToSintSat, ty_i64(), src);
            if bits == WORD_BITS {
                return n;
            }
            let lo = ins_iconst(inout b, ty_i64(), kind_min_imm(meta));
            let hi = ins_iconst(inout b, ty_i64(), kind_max_imm(meta));
            let clamped = ins_binary(inout b, Bin::Smax, n, lo);
            return ins_binary(inout b, Bin::Smin, clamped, hi);
        } else {
            let n = ins_convert(inout b, Cv::FcvtToUintSat, ty_i64(), src);
            if bits == WORD_BITS {
                return n;
            }
            let hi = ins_iconst(inout b, ty_i64(), kind_max_imm(meta));
            return ins_binary(inout b, Bin::Umin, n, hi);
        }
    }
    Value { id: invalid() }
}

fn emit_float_binary(
    inout b: Builder,
    fb: u64,
    lhs0: Value,
    rhs0: Value
) -> Value eff [Ffi[Cranelift]] {
    let lhs_var = temp(inout b, lhs0);
    let rhs_var = temp(inout b, rhs0);
    let lhs = use_var(inout b, lhs_var);
    let rhs = use_var(inout b, rhs_var);
    if fb == FBIN_ADD {
        return ins_fadd(inout b, lhs, rhs);
    }
    if fb == FBIN_SUB {
        return ins_fsub(inout b, lhs, rhs);
    }
    if fb == FBIN_MUL {
        return ins_fmul(inout b, lhs, rhs);
    }
    if fb == FBIN_DIV {
        return ins_fdiv(inout b, lhs, rhs);
    }
    if fb == FBIN_MIN {
        return ins_binary(inout b, Bin::Fmin, lhs, rhs);
    }
    if fb == FBIN_MAX {
        return ins_binary(inout b, Bin::Fmax, lhs, rhs);
    }
    let cc = if fb == FBIN_EQ {
        FloatCc::Eq
    } else if fb == FBIN_NE {
        FloatCc::Ne
    } else if fb == FBIN_LT {
        FloatCc::Lt
    } else if fb == FBIN_LE {
        FloatCc::Le
    } else if fb == FBIN_GT {
        FloatCc::Gt
    } else if fb == FBIN_GE {
        FloatCc::Ge
    } else {
        return Value { id: invalid() };
    };
    let cmp = ins_fcmp(inout b, cc, lhs, rhs);
    ins_uextend(inout b, ty_i64(), cmp)
}

fn emit_write_op(inout b: Builder, wop: u64, old: Value, rhs: Value) -> Value eff [Ffi[Cranelift]] {
    if wop == WOP_IADD {
        ins_iadd(inout b, old, rhs)
    } else if wop == WOP_ISUB {
        ins_isub(inout b, old, rhs)
    } else if wop == WOP_IMUL {
        ins_imul(inout b, old, rhs)
    } else if wop == WOP_UDIV {
        ins_udiv(inout b, old, rhs)
    } else if wop == WOP_SDIV {
        emit_sdiv_guarded(inout b, old, rhs)
    } else if wop == WOP_UREM {
        ins_urem(inout b, old, rhs)
    } else if wop == WOP_SREM {
        ins_srem(inout b, old, rhs)
    } else if wop == WOP_BAND {
        ins_band(inout b, old, rhs)
    } else if wop == WOP_BOR {
        ins_bor(inout b, old, rhs)
    } else if wop == WOP_BXOR {
        ins_bxor(inout b, old, rhs)
    } else if wop == WOP_FADD {
        ins_fadd(inout b, old, rhs)
    } else if wop == WOP_FSUB {
        ins_fsub(inout b, old, rhs)
    } else if wop == WOP_FMUL {
        ins_fmul(inout b, old, rhs)
    } else if wop == WOP_FDIV {
        ins_fdiv(inout b, old, rhs)
    } else {
        Value { id: invalid() }
    }
}

fn emit_wide_unary(
    inout b: Builder,
    wun: u64,
    a: u64,
    c: u64,
    src: Value,
    optimize: bool
) -> Value eff [Ffi[Cranelift]] {
    if wun == WUN_BNOT {
        return ins_bnot(inout b, src);
    }
    if wun == WUN_INEG {
        return ins_ineg(inout b, src);
    }
    if wun == WUN_CONVERT {
        let x = if is_wide_kind(a) {
            src
        } else if !kind_unsigned(a) {
            ins_sextend(inout b, ty_i128(), src)
        } else {
            ins_uextend(inout b, ty_i128(), src)
        };
        if is_wide_kind(c) {
            return x;
        }
        let low = ins_ireduce(inout b, ty_i64(), x);
        return coerce(inout b, low, c, optimize);
    }
    if wun == WUN_BIT {
        if a == BIT_OP_CLZ {
            let r = ins_clz(inout b, src);
            return ins_ireduce(inout b, ty_i64(), r);
        }
        if a == BIT_OP_CTZ {
            let r = ins_ctz(inout b, src);
            return ins_ireduce(inout b, ty_i64(), r);
        }
        if a == BIT_OP_POPCNT {
            let r = ins_popcnt(inout b, src);
            return ins_ireduce(inout b, ty_i64(), r);
        }
        if a == BIT_OP_WRAPPING_NEG {
            return ins_ineg(inout b, src);
        }
    }
    Value { id: invalid() }
}

fn emit_wide_binary(
    inout b: Builder,
    wb: u64,
    lhs: Value,
    rhs: Value
) -> Value eff [Ffi[Cranelift]] {
    if wb == WBIN_IADD {
        return ins_iadd(inout b, lhs, rhs);
    }
    if wb == WBIN_ISUB {
        return ins_isub(inout b, lhs, rhs);
    }
    if wb == WBIN_IMUL {
        return ins_imul(inout b, lhs, rhs);
    }
    if wb == WBIN_BAND {
        return ins_band(inout b, lhs, rhs);
    }
    if wb == WBIN_BOR {
        return ins_bor(inout b, lhs, rhs);
    }
    if wb == WBIN_BXOR {
        return ins_bxor(inout b, lhs, rhs);
    }
    if wb == WBIN_SHL {
        return ins_ishl(inout b, lhs, rhs);
    }
    if wb == WBIN_USHR {
        return ins_ushr(inout b, lhs, rhs);
    }
    if wb == WBIN_SSHR {
        return ins_sshr(inout b, lhs, rhs);
    }
    let cc = if wb == WBIN_EQ {
        cc_eq()
    } else if wb == WBIN_NE {
        cc_ne()
    } else if wb == WBIN_SLT {
        cc_slt()
    } else if wb == WBIN_SLE {
        cc_sle()
    } else if wb == WBIN_SGT {
        cc_sgt()
    } else if wb == WBIN_SGE {
        cc_sge()
    } else if wb == WBIN_ULT {
        cc_ult()
    } else if wb == WBIN_ULE {
        cc_ule()
    } else if wb == WBIN_UGT {
        cc_ugt()
    } else if wb == WBIN_UGE {
        cc_uge()
    } else {
        return Value { id: invalid() };
    };
    let cmp = ins_icmp(inout b, cc, lhs, rhs);
    ins_uextend(inout b, ty_i64(), cmp)
}

// The function's emission state.
struct Body {
    optimize: bool,
    status: bool,
    locations: bool,
    // Every value read before each instruction (the unoptimized path).
    refresh_all: bool,
    // block index -> its Cranelift block
    blocks: ChunkSeq[u32],
    // local index -> its variable, the kind its stores coerce to, and its
    // slot's address variable (invalid on the optimize path)
    locals: ChunkSeq[u32],
    kinds: ChunkSeq[u64],
    addresses: ChunkSeq[u32],
    // value index -> its register variable, its block parameter (if
    // any), and the Cranelift value the walk last read it as
    registers: ChunkSeq[u32],
    params: ChunkSeq[u32],
    values: ChunkSeq[u32],
    // call index -> its module FuncId word (from the request's callees)
    callees: ChunkSeq[u64],
    // a `fail_only` function's failure record (its last parameter, an
    // invalid value otherwise) and the lane of the zero a failure exit
    // returns (#2425)
    record: Value,
    fail_lane: u64,
    // The result pointer (invalid when the result is a scalar), the values
    // built in it, and the words returned from it when it is a register
    // result's buffer (0 for a caller's result pointer).
    sret: u32,
    homes: ChunkSeq[u64],
    result_words: u64,
    // The slice parameters read once at entry (#2653): value index -> the
    // receiver its read takes (invalid for any other value), and the
    // views and handles whose header words are read-only memory
    // (`Codegen::invariant_headers`).
    entry_reads: ChunkSeq[u32],
    invariant: ChunkSeq[u32],
    // Those views as the request lists them: each one's parameter index,
    // read count and reads.
    views: ChunkSeq[u64],
    nviews: u64,
    // The graph being emitted's join block (#2657): a nested graph's
    // `return` jumps there; invalid for the function's own graph.
    join: u32,
    // The source location last set (`Codegen::srcloc`), which a nested
    // graph restores when it is done.
    cur_loc: u64,
    // `Codegen::vars` while a handler's graphs are emitted: each local
    // variable's slot (its variable, kind, address and whether it is a
    // register local), and the names in scope with their slots.
    svar: ChunkSeq[u32],
    skind: ChunkSeq[u64],
    saddr: ChunkSeq[u32],
    sreg: ChunkSeq[u64],
    snames: ChunkSeq[u64],
    sslots: ChunkSeq[u64],
    // The handlers in scope, outermost first: exit, dispatch and selector,
    // the result's kind, the `raise` clause's error name and plan (a word
    // position), and its captures (names and slots from `hcap_a`).
    hexit: ChunkSeq[u32],
    hdispatch: ChunkSeq[u32],
    hkind: ChunkSeq[u64],
    herr: ChunkSeq[u64],
    hclause: ChunkSeq[u64],
    hcap_a: ChunkSeq[u64],
    hcap_n: ChunkSeq[u64],
    hcap_names: ChunkSeq[u64],
    hcap_slots: ChunkSeq[u64],
}

impl Body {
    fn is_invariant(in self, v: Value) -> bool {
        for k in 0..self.invariant.len() {
            if at32(in self.invariant, k) == v.id {
                return true;
            }
        }
        false
    }

    // `seq_word`: a header word, loaded as read-only memory
    // (`invariant_word`) from an invariant view or handle.
    fn seq_word(
        inout self,
        inout b: Builder,
        ptr: Value,
        offset: i32
    ) -> Value eff [Ffi[Cranelift]] {
        let flags = if self.is_invariant(ptr) {
            mem_trusted() | mem_readonly() | mem_can_move()
        } else {
            PLAIN
        };
        ins_load(inout b, ty_i64(), flags, ptr, offset)
    }

    // The receiver a read of value `i` takes, or an invalid value.
    fn entry_read(in self, i: u64) -> Value {
        Value {
            id: match self.entry_reads.try_get(i) {
                Option::Some(x) => x,
                Option::None => invalid(),
            }
        }
    }

    fn value(in self, i: u64) -> Value {
        Value { id: at32(in self.values, i) }
    }

    fn block(in self, i: u64) -> Block {
        Block { id: at32(in self.blocks, i) }
    }

    // A field of product pattern node words (#2654): `Codegen::offset`,
    // then `load`, which leaves a product field at its address.
    fn pattern_field(
        inout self,
        inout b: Builder,
        inout w: Words,
        base: Value
    ) -> Value eff [Ffi[Cranelift]] {
        let off = w.next();
        let lane = w.next();
        let ptr = ins_iadd_imm(inout b, base, wrapping_i64(off));
        if lane == LANE_PRODUCT {
            ptr
        } else {
            ins_load(inout b, lane_type(lane), PLAIN, ptr, 0)
        }
    }

    // `Codegen::bind_ir` of a product pattern's node over `v`: each field
    // loaded in order and bound.
    fn bind_node(
        inout self,
        inout b: Builder,
        inout w: Words,
        v: Value
    ) -> bool eff [Ffi[Cranelift]] {
        let node = w.next();
        if node == PNODE_NONE {
            return true;
        }
        if node == PNODE_LOCAL {
            let local = w.next();
            self.def_local(inout b, local, v);
            return true;
        }
        if node != PNODE_FIELDS {
            return false;
        }
        let n = w.next();
        for k in 0..n {
            let field = self.pattern_field(inout b, inout w, v);
            if !self.bind_node(inout b, inout w, field) {
                return false;
            }
        }
        true
    }

    // `Codegen::pattern_condition` of a product pattern's node over `v`:
    // `pattern_true`, a literal's comparison, or the conjunction of the
    // fields' conditions; an invalid value for words that do not read.
    fn match_node(
        inout self,
        inout b: Builder,
        inout w: Words,
        v: Value
    ) -> Value eff [Ffi[Cranelift]] {
        let node = w.next();
        if node == PNODE_NONE {
            return ins_iconst(inout b, ty_i8(), 1);
        }
        if node == PNODE_INT {
            let lit = w.next();
            return ins_icmp_imm(inout b, cc_eq(), v, wrapping_i64(lit));
        }
        if node == PNODE_TAG {
            // An enum constructor: its tag word compared, then (with
            // fields) `pattern_open`'s diamond around the fields'
            // conjunction, closed by `pattern_close`.
            let tag = w.next();
            let n = w.next();
            let actual = ins_load(inout b, ty_i64(), PLAIN, v, 0);
            let matches_tag = ins_icmp_imm(inout b, cc_eq(), actual, wrapping_i64(tag));
            if n == 0 {
                return matches_tag;
            }
            let ok = create_block(inout b);
            let fail = create_block(inout b);
            let done = create_block(inout b);
            let joined = append_block_param(inout b, done, ty_i8());
            ins_brif0(inout b, matches_tag, ok, fail);
            switch_to_block(inout b, fail);
            let zero = ins_iconst(inout b, ty_i8(), 0);
            let mut args: ChunkSeq[u32] = ChunkSeq::new[u32]();
            args.push(zero.id);
            ins_jump(inout b, done, in args.as_slice());
            switch_to_block(inout b, ok);
            let result = self.match_fields(inout b, inout w, v, n);
            if is_invalid(result) {
                return result;
            }
            let mut out: ChunkSeq[u32] = ChunkSeq::new[u32]();
            out.push(result.id);
            ins_jump(inout b, done, in out.as_slice());
            switch_to_block(inout b, done);
            return joined;
        }
        if node != PNODE_FIELDS {
            return Value { id: invalid() };
        }
        let n = w.next();
        self.match_fields(inout b, inout w, v, n)
    }

    // The conjunction of `n` fields' conditions over `v`, from
    // `pattern_true`.
    fn match_fields(
        inout self,
        inout b: Builder,
        inout w: Words,
        v: Value,
        n: u64
    ) -> Value eff [Ffi[Cranelift]] {
        let mut result = ins_iconst(inout b, ty_i8(), 1);
        for k in 0..n {
            let field = self.pattern_field(inout b, inout w, v);
            let c = self.match_node(inout b, inout w, field);
            if is_invalid(c) {
                return c;
            }
            result = ins_band(inout b, result, c);
        }
        result
    }

    // The walk's read of value `i` from its register.
    fn read(inout self, inout b: Builder, i: u64) eff [Ffi[Cranelift]] {
        let v = use_var(inout b, var_at(in self.registers, i));
        let ok = self.values.try_set(i, v.id);
    }

    // The reads before an instruction or terminator: every value's when
    // the graph refreshes all of them, else only its operands' (`ops`).
    fn read_operands(inout self, inout b: Builder, in ops: ChunkSeq[u64]) eff [Ffi[Cranelift]] {
        if self.refresh_all {
            for i in 0..self.registers.len() {
                self.read(inout b, i);
            }
        } else {
            for k in 0..ops.len() {
                self.read(inout b, at64(in ops, k));
            }
        }
    }

    // `Codegen::use_var` of local `l`: its variable, then a load through
    // its slot's address when it has one.
    fn use_local(inout self, inout b: Builder, l: u64) -> Value eff [Ffi[Cranelift]] {
        let raw = use_var(inout b, var_at(in self.locals, l));
        let address = at32(in self.addresses, l);
        if address == invalid() {
            return raw;
        }
        let pointer = use_var(inout b, Var { id: address });
        let ty = value_type(inout b, raw);
        ins_load(inout b, ty, PLAIN, pointer, 0)
    }

    // `Codegen::def_var` of local `l`: its variable, then a store through
    // its slot's address when it has one.
    fn def_local(inout self, inout b: Builder, l: u64, v: Value) eff [Ffi[Cranelift]] {
        def_var(inout b, var_at(in self.locals, l), v);
        let address = at32(in self.addresses, l);
        if address != invalid() {
            let pointer = use_var(inout b, Var { id: address });
            ins_store(inout b, PLAIN, v, pointer, 0);
        }
    }

    // `Codegen::store` of `v` into local `l`'s slot after an assignment:
    // the value coerced to the local's kind, stored again.
    fn store_local(inout self, inout b: Builder, l: u64, v: Value) eff [Ffi[Cranelift]] {
        let address = at32(in self.addresses, l);
        if address != invalid() {
            let pointer = use_var(inout b, Var { id: address });
            let value = body_coerce(inout b, v, at64(in self.kinds, l), self.optimize);
            ins_store(inout b, PLAIN, value, pointer, 0);
        }
    }

    // `ir_graph_at`'s home of a local with no register on the unoptimized
    // path: its value stored to a fresh zeroed slot (`Codegen::alloc`,
    // `store`) whose address `set_pointer` keeps in a variable.
    fn spill(inout self, inout b: Builder, in m: Module, l: u64) eff [Ffi[Cranelift]] {
        let value = use_var(inout b, var_at(in self.locals, l));
        let wide = value_type(inout b, value).code == TyCode::I128;
        let bytes = if wide { WIDE_BYTES } else { WORD_BYTES };
        let slot = create_stack_slot(inout b, bytes, SLOT_ALIGN_SHIFT);
        let ptr = ins_stack_addr(inout b, module_pointer_type(in m), slot, 0);
        let mut offset: u32 = 0;
        loop {
            if offset >= bytes {
                break;
            }
            let zero = ins_iconst(inout b, ty_i64(), 0);
            ins_store(inout b, PLAIN, zero, ptr, wrapping_i32(offset));
            offset = wrapping_add(offset, WORD_BYTES);
        }
        let stored = body_coerce(inout b, value, at64(in self.kinds, l), self.optimize);
        ins_store(inout b, PLAIN, stored, ptr, 0);
        let pointer_ty = value_type(inout b, ptr);
        let address = declare_var(inout b, pointer_ty);
        def_var(inout b, address, ptr);
        let ok = self.addresses.try_set(l, address.id);
    }

    // A struct's own storage, of at least a word: `Codegen::alloc_uninit`
    // on the optimize path, `Codegen::alloc` (zeroed a word at a time)
    // otherwise.
    fn storage(
        inout self,
        inout b: Builder,
        in m: Module,
        size: u64
    ) -> Value eff [Ffi[Cranelift]] {
        let bytes = if size < widen_u64(WORD_BYTES) {
            WORD_BYTES
        } else {
            wrapping_u32(size)
        };
        let slot = create_stack_slot(inout b, bytes, SLOT_ALIGN_SHIFT);
        let ptr = ins_stack_addr(inout b, module_pointer_type(in m), slot, 0);
        if !self.optimize {
            let mut offset: u32 = 0;
            loop {
                if offset >= bytes {
                    break;
                }
                let zero = ins_iconst(inout b, ty_i64(), 0);
                ins_store(inout b, PLAIN, zero, ptr, wrapping_i32(offset));
                offset = wrapping_add(offset, WORD_BYTES);
            }
        }
        ptr
    }

    fn emit_return_value(inout self, inout b: Builder, v: Value) eff [Ffi[Cranelift]] {
        let mut out: ChunkSeq[u32] = ChunkSeq::new[u32]();
        out.push(v.id);
        if self.status {
            let ok = ins_iconst(inout b, ty_i64(), 0);
            out.push(ok.id);
        }
        ins_return(inout b, in out.as_slice());
    }

    // `Codegen::fail_exit` of `Fail` instance `index` (#2425): its tag
    // (stored in the record unless the status goes back in a register),
    // the `size` bytes of the error at `error` copied to the record's
    // payload a word at a time (`copy_bytes`), then a zero result returned
    // beside the tag. Emission goes on in a fresh block no edge reaches,
    // after the zero the walk answers for the raise.
    fn fail_exit(
        inout self,
        inout b: Builder,
        index: u64,
        error: Value,
        size: u64
    ) -> Value eff [Ffi[Cranelift]] {
        let tag = self.fail_tag(inout b, index);
        let payload = ins_iadd_imm(inout b, self.record, RECORD_PAYLOAD);
        let mut offset: u64 = 0;
        loop {
            if offset >= size {
                break;
            }
            let word = ins_load(inout b, ty_i64(), PLAIN, error, wrapping_i32(offset));
            ins_store(inout b, PLAIN, word, payload, wrapping_i32(offset));
            offset = wrapping_add(offset, widen_u64(WORD_BYTES));
        }
        self.fail_return(inout b, tag)
    }

    // `fail_exit` of a one-word scalar error: stored after `coerce` to its
    // kind.
    fn fail_exit_scalar(
        inout self,
        inout b: Builder,
        index: u64,
        error: Value,
        kind: u64
    ) -> Value eff [Ffi[Cranelift]] {
        let tag = self.fail_tag(inout b, index);
        let payload = ins_iadd_imm(inout b, self.record, RECORD_PAYLOAD);
        let value = coerce(inout b, error, kind, self.optimize);
        ins_store(inout b, PLAIN, value, payload, 0);
        self.fail_return(inout b, tag)
    }

    // The tag of instance `index`, stored in the record unless the status
    // goes back in a register.
    fn fail_tag(inout self, inout b: Builder, index: u64) -> Value eff [Ffi[Cranelift]] {
        let tag = ins_iconst(inout b, ty_i64(), wrapping_i64(wrapping_add(index, 1)));
        if !self.status {
            ins_store(inout b, PLAIN, tag, self.record, 0);
        }
        tag
    }

    // A failure exit's return of a zero result (beside the tag), then the
    // unreachable block emission goes on in and the walk's zero, which
    // stands for the raise's `Never` result.
    fn fail_return(inout self, inout b: Builder, tag: Value) -> Value eff [Ffi[Cranelift]] {
        let placeholder = zero_of(inout b, self.fail_lane);
        let mut out: ChunkSeq[u32] = ChunkSeq::new[u32]();
        out.push(placeholder.id);
        if self.status {
            out.push(tag.id);
        }
        ins_return(inout b, in out.as_slice());
        let dead = create_block(inout b);
        switch_to_block(inout b, dead);
        ins_iconst(inout b, ty_i64(), 0)
    }

    // `Codegen::data` of a payload-free constructor of `size` bytes (enum
    // tag `tag`, or NO_TAG for a product), raised through `fail_exit`:
    // fresh word-aligned storage, zeroed whole by the unoptimized `alloc`
    // and, optimized, only where no tag lands (every word of a product),
    // then the tag.
    fn raise_unit(
        inout self,
        inout b: Builder,
        inout m: Module,
        inout w: Words,
        index: u64,
        size: u64,
        tag: u64
    ) -> bool eff [Ffi[Cranelift]] {
        let bytes = if size < widen_u64(WORD_BYTES) {
            WORD_BYTES
        } else {
            wrapping_u32(size)
        };
        let slot = create_stack_slot(inout b, bytes, SLOT_ALIGN_SHIFT);
        let ptr = ins_stack_addr(inout b, module_pointer_type(in m), slot, 0);
        if !self.optimize || tag == NO_TAG {
            let mut offset: u32 = 0;
            loop {
                if offset >= bytes {
                    break;
                }
                let zero = ins_iconst(inout b, ty_i64(), 0);
                ins_store(inout b, PLAIN, zero, ptr, wrapping_i32(offset));
                offset = wrapping_add(offset, WORD_BYTES);
            }
        }
        if tag != NO_TAG {
            let t = ins_iconst(inout b, ty_i64(), wrapping_i64(tag));
            ins_store(inout b, PLAIN, t, ptr, 0);
        }
        if index >= HANDLER_BASE {
            let depth = wrapping_sub(index, HANDLER_BASE);
            return !is_invalid(self.perform(inout b, inout m, inout w, depth, ptr));
        }
        let _ = self.fail_exit(inout b, index, ptr, size);
        true
    }

    // A `fail_only` callee's record of `size` bytes: word-aligned storage,
    // zeroed a word at a time (`Codegen::alloc`) unless the callee returns
    // its status in a register and so writes only a failure's payload
    // (`alloc_uninit`).
    fn alloc_record(
        inout self,
        inout b: Builder,
        in m: Module,
        size: u64,
        status_call: bool
    ) -> Value eff [Ffi[Cranelift]] {
        let bytes = if size < widen_u64(WORD_BYTES) {
            WORD_BYTES
        } else {
            wrapping_u32(size)
        };
        let slot = create_stack_slot(inout b, bytes, SLOT_ALIGN_SHIFT);
        let ptr = ins_stack_addr(inout b, module_pointer_type(in m), slot, 0);
        if !status_call {
            let mut offset: u32 = 0;
            loop {
                if offset >= bytes {
                    break;
                }
                let zero = ins_iconst(inout b, ty_i64(), 0);
                ins_store(inout b, PLAIN, zero, ptr, wrapping_i32(offset));
                offset = wrapping_add(offset, WORD_BYTES);
            }
        }
        ptr
    }

    // `reraise_status` of a call's `tag` (its status register, or the tag
    // its record holds): with several instances one test of the tag
    // first, then for each of the callee's instances (`reraise_each`) a
    // branch on its tag to the raise of its payload through the caller's
    // instance, each time going on in a fresh block.
    fn reraise(
        inout self,
        inout b: Builder,
        inout m: Module,
        inout w: Words,
        record: Value,
        tag: Value
    ) -> bool eff [Ffi[Cranelift]] {
        let n = w.next();
        let no_args: ChunkSeq[u32] = ChunkSeq::new[u32]();
        let mut outer = Block { id: invalid() };
        if n > 1 {
            let failed = ins_icmp_imm(inout b, cc_ne(), tag, 0);
            let bad = create_block(inout b);
            outer = create_block(inout b);
            ins_brif0(inout b, failed, bad, outer);
            switch_to_block(inout b, bad);
        }
        for k in 0..n {
            let index = w.next();
            let size = w.next();
            let scalar_kind = w.next();
            let failed = ins_icmp_imm(inout b, cc_eq(), tag, wrapping_i64(wrapping_add(k, 1)));
            let bad = create_block(inout b);
            let good = create_block(inout b);
            ins_brif0(inout b, failed, bad, good);
            switch_to_block(inout b, bad);
            let payload = ins_iadd_imm(inout b, record, RECORD_PAYLOAD);
            if index >= HANDLER_BASE {
                // A handler in scope takes it (#2657): the payload's
                // address, or its one word loaded.
                let error = if scalar_kind == AGGREGATE_ERROR {
                    payload
                } else {
                    ins_load(inout b, ty_i64(), PLAIN, payload, 0)
                };
                let depth = wrapping_sub(index, HANDLER_BASE);
                if is_invalid(self.perform(inout b, inout m, inout w, depth, error)) {
                    return false;
                }
            } else if scalar_kind == AGGREGATE_ERROR {
                let _ = self.fail_exit(inout b, index, payload, size);
            } else {
                let error = ins_load(inout b, ty_i64(), PLAIN, payload, 0);
                let _ = self.fail_exit_scalar(inout b, index, error, scalar_kind);
            }
            ins_jump(inout b, good, in no_args.as_slice());
            switch_to_block(inout b, good);
        }
        if n > 1 {
            ins_jump(inout b, outer, in no_args.as_slice());
            switch_to_block(inout b, outer);
        }
        true
    }

    // `check_overflow` (`raise_when` true) and `check_divisor` (false): a
    // `good` then a `bad` block, the branch to `bad` when `flag` is
    // `raise_when`, the raise of the descriptor's constructor there, and
    // emission going on in `good`.
    fn raising(
        inout self,
        inout b: Builder,
        inout m: Module,
        inout w: Words,
        flag: Value,
        raise_when: bool,
        index: u64,
        size: u64,
        tag: u64
    ) -> bool eff [Ffi[Cranelift]] {
        let good = create_block(inout b);
        let bad = create_block(inout b);
        if raise_when {
            ins_brif0(inout b, flag, bad, good);
        } else {
            ins_brif0(inout b, flag, good, bad);
        }
        switch_to_block(inout b, bad);
        if !self.raise_unit(inout b, inout m, inout w, index, size, tag) {
            return false;
        }
        let no_args: ChunkSeq[u32] = ChunkSeq::new[u32]();
        ins_jump(inout b, good, in no_args.as_slice());
        switch_to_block(inout b, good);
        true
    }

    // `Codegen::string_literal`: `{n, 0, &static_bytes}` in fresh zeroed
    // storage, `{0, 0, null}` when empty. Invalid when the module refuses
    // the data.
    fn literal(
        inout self,
        inout b: Builder,
        inout m: Module,
        inout w: Words
    ) -> Value eff [Ffi[Cranelift]] {
        let n = w.next();
        let len = ins_iconst(inout b, ty_i64(), wrapping_i64(n));
        let zero = ins_iconst(inout b, ty_i64(), 0);
        let data = if n == 0 {
            zero
        } else {
            let mut bytes = ChunkSeq::with_capacity[u8](n);
            let mut word: u64 = 0;
            for k in 0..n {
                if k & LITERAL_WORD_MASK == 0 {
                    word = w.next();
                }
                bytes.push(wrapping_u8(word & BYTE_MASK));
                word = word >> BYTE_BITS;
            }
            let id = declare_anonymous_data(inout m, false, false);
            let mut d = match data_new() {
                Some(d) => d,
                None => return Value { id: invalid() },
            };
            data_define(inout d, in bytes.as_slice());
            data_align(inout d, LITERAL_ALIGN);
            if !define_data(inout m, id, d) {
                return Value { id: invalid() };
            }
            let gv = import_data(inout b, in m, id);
            ins_symbol_value(inout b, module_pointer_type(in m), gv)
        };
        // `str_value`: `Codegen::alloc(24)`, then the three words.
        let slot = create_stack_slot(inout b, VIEW_BYTES, SLOT_ALIGN_SHIFT);
        let ptr = ins_stack_addr(inout b, module_pointer_type(in m), slot, 0);
        let mut offset: u32 = 0;
        loop {
            if offset >= VIEW_BYTES {
                break;
            }
            let z = ins_iconst(inout b, ty_i64(), 0);
            ins_store(inout b, PLAIN, z, ptr, wrapping_i32(offset));
            offset = wrapping_add(offset, WORD_BYTES);
        }
        ins_store(inout b, PLAIN, len, ptr, STR_LEN);
        ins_store(inout b, PLAIN, zero, ptr, STR_CAP);
        ins_store(inout b, PLAIN, data, ptr, STR_DATA);
        ptr
    }

    // `Codegen::seq_op` of a string or slice operation (#2653) on
    // receiver `x` and index `y`: `str_op`'s `len`, `as_str`, `as_bytes`
    // and `byte_at` (`str_word`, `str_value`, `seq_guard`, `str_byte`),
    // and a slice's `len` and checked element (`seq_view`, `seq_guard`,
    // `seq_elem_addr`, `seq_load_elem`). An invalid value for a form the
    // plan never writes.
    fn seq(
        inout self,
        inout b: Builder,
        inout m: Module,
        inout w: Words,
        x: Value,
        y: Value
    ) -> Value eff [Ffi[Cranelift]] {
        let form = w.next();
        if form == SEQ_LITERAL {
            return self.literal(inout b, inout m, inout w);
        }
        if form == SEQ_WORD {
            let offset = w.next();
            return ins_load(inout b, ty_i64(), PLAIN, x, wrapping_i32(offset));
        }
        if form == SEQ_VIEW_WORD {
            let offset = w.next();
            return self.seq_word(inout b, x, wrapping_i32(offset));
        }
        if form == SEQ_SAME {
            return x;
        }
        if form == SEQ_AS_BYTES {
            // `str_value(s, 0, len)`: the view `{s, 0, len}` in fresh
            // zeroed storage (`Codegen::alloc`).
            let len = ins_load(inout b, ty_i64(), PLAIN, x, STR_LEN);
            let zero = ins_iconst(inout b, ty_i64(), 0);
            let slot = create_stack_slot(inout b, VIEW_BYTES, SLOT_ALIGN_SHIFT);
            let ptr = ins_stack_addr(inout b, module_pointer_type(in m), slot, 0);
            let mut offset: u32 = 0;
            loop {
                if offset >= VIEW_BYTES {
                    break;
                }
                let z = ins_iconst(inout b, ty_i64(), 0);
                ins_store(inout b, PLAIN, z, ptr, wrapping_i32(offset));
                offset = wrapping_add(offset, WORD_BYTES);
            }
            ins_store(inout b, PLAIN, x, ptr, VIEW_HANDLE);
            ins_store(inout b, PLAIN, zero, ptr, VIEW_START);
            ins_store(inout b, PLAIN, len, ptr, VIEW_LEN);
            return ptr;
        }
        if form == SEQ_BYTE_AT {
            let index = w.next();
            let size = w.next();
            let tag = w.next();
            let len = ins_load(inout b, ty_i64(), PLAIN, x, STR_LEN);
            let valid = ins_icmp(inout b, cc_ult(), y, len);
            if !self.raising(inout b, inout m, inout w, valid, false, index, size, tag) {
                return Value { id: invalid() };
            }
            let data = ins_load(inout b, ty_i64(), PLAIN, x, STR_DATA);
            let at = ins_iadd(inout b, data, y);
            return ins_uload8(inout b, ty_i64(), PLAIN, at, 0);
        }
        if form == SEQ_LAST {
            return self.seq_last(inout b, inout w, x);
        }
        if form == SEQ_GET {
            let stride = w.next();
            let lane = w.next();
            let index = w.next();
            let size = w.next();
            let tag = w.next();
            let (handle, start, len) = self.seq_view(inout b, x);
            let valid = ins_icmp(inout b, cc_ult(), y, len);
            if !self.raising(inout b, inout m, inout w, valid, false, index, size, tag) {
                return Value { id: invalid() };
            }
            let addr = self.seq_elem_addr(inout b, handle, start, y, stride);
            return if stride == STRIDE_BYTE {
                ins_uload8(inout b, ty_i64(), PLAIN, addr, 0)
            } else if stride == STRIDE_HALF {
                ins_uload16(inout b, ty_i64(), PLAIN, addr, 0)
            } else if stride == STRIDE_QUARTER {
                ins_uload32(inout b, PLAIN, addr, 0)
            } else {
                ins_load(inout b, lane_type(lane), PLAIN, addr, 0)
            };
        }
        Value { id: invalid() }
    }

    // `seq_view`: a slice view's handle, start and length, the handle
    // invariant when the view is.
    fn seq_view(
        inout self,
        inout b: Builder,
        x: Value
    ) -> (Value, Value, Value) eff [Ffi[Cranelift]] {
        let handle = self.seq_word(inout b, x, VIEW_HANDLE);
        if self.is_invariant(x) {
            self.invariant.push(handle.id);
        }
        let start = self.seq_word(inout b, x, VIEW_START);
        let len = self.seq_word(inout b, x, VIEW_LEN);
        (handle, start, len)
    }

    // `seq_elem_addr` of element `i` from `start`: from an invariant
    // handle, `data + start * stride` first, which Cranelift computes
    // once.
    fn seq_elem_addr(
        inout self,
        inout b: Builder,
        handle: Value,
        start: Value,
        i: Value,
        stride: u64
    ) -> Value eff [Ffi[Cranelift]] {
        let data = self.seq_word(inout b, handle, HEADER_DATA);
        if self.is_invariant(handle) {
            let first = ins_imul_imm(inout b, start, wrapping_i64(stride));
            let base = ins_iadd(inout b, data, first);
            let offset = ins_imul_imm(inout b, i, wrapping_i64(stride));
            ins_iadd(inout b, base, offset)
        } else {
            let at = ins_iadd(inout b, start, i);
            let offset = ins_imul_imm(inout b, at, wrapping_i64(stride));
            ins_iadd(inout b, data, offset)
        }
    }

    // A slice's `last` (#2653) through `seq_option` with a two-word
    // request: the `Option`'s tag and payload joined at a block of two
    // words, each then coerced and defined; the walk's zero is the
    // instruction's own value.
    fn seq_last(
        inout self,
        inout b: Builder,
        inout w: Words,
        x: Value
    ) -> Value eff [Ffi[Cranelift]] {
        let stride = w.next();
        let none_tag = w.next();
        let some_tag = w.next();
        let (handle, start, len) = self.seq_view(inout b, x);
        let present = ins_icmp_imm(inout b, cc_ne(), len, 0);
        let none = create_block(inout b);
        let some = create_block(inout b);
        let done = create_block(inout b);
        let tag_param = append_block_param(inout b, done, ty_i64());
        let value_param = append_block_param(inout b, done, ty_i64());
        ins_brif0(inout b, present, some, none);
        switch_to_block(inout b, none);
        let tag = ins_iconst(inout b, ty_i64(), wrapping_i64(none_tag));
        let zero = ins_iconst(inout b, ty_i64(), 0);
        let mut none_args: ChunkSeq[u32] = ChunkSeq::new[u32]();
        none_args.push(tag.id);
        none_args.push(zero.id);
        ins_jump(inout b, done, in none_args.as_slice());
        switch_to_block(inout b, some);
        let last = ins_iadd_imm(inout b, len, -1);
        let addr = self.seq_elem_addr(inout b, handle, start, last, stride);
        let value = if stride == STRIDE_BYTE {
            ins_uload8(inout b, ty_i64(), PLAIN, addr, 0)
        } else if stride == STRIDE_HALF {
            ins_uload16(inout b, ty_i64(), PLAIN, addr, 0)
        } else if stride == STRIDE_QUARTER {
            ins_uload32(inout b, PLAIN, addr, 0)
        } else {
            ins_load(inout b, ty_i64(), PLAIN, addr, 0)
        };
        let some_value = ins_iconst(inout b, ty_i64(), wrapping_i64(some_tag));
        let mut some_args: ChunkSeq[u32] = ChunkSeq::new[u32]();
        some_args.push(some_value.id);
        some_args.push(value.id);
        ins_jump(inout b, done, in some_args.as_slice());
        switch_to_block(inout b, done);
        let result = ins_iconst(inout b, ty_i64(), 0);
        let mut params: ChunkSeq[u32] = ChunkSeq::new[u32]();
        params.push(tag_param.id);
        params.push(value_param.id);
        for k in 0..params.len() {
            let index = w.next();
            let word_kind = w.next();
            let raw = Value { id: at32(in params, k) };
            let v = body_coerce(inout b, raw, word_kind, self.optimize);
            let ok = self.values.try_set(index, v.id);
            def_var(inout b, var_at(in self.registers, index), v);
        }
        result
    }

    // One instruction (`ir_graph_at`'s instruction loop): its operands
    // read from their registers, its arm, the `coerce` to its type and the
    // definition of its register. False on a word the plan never writes.
    fn inst(
        inout self,
        inout b: Builder,
        inout m: Module,
        inout w: Words
    ) -> bool eff [Ffi[Cranelift]] {
        let kind = w.next();
        let dest = w.next();
        let post = w.next();
        let location = w.next();
        let n = w.next();
        let mut ops: ChunkSeq[u64] = ChunkSeq::new[u64]();
        for k in 0..n {
            ops.push(w.next());
        }
        self.read_operands(inout b, in ops);
        // A read of a slice parameter read at entry is its receiver.
        for k in 0..ops.len() {
            let i = at64(in ops, k);
            let receiver = self.entry_read(i);
            if !is_invalid(receiver) {
                let ok = self.values.try_set(i, receiver.id);
            }
        }
        // `set_location`, after the operands' reads; the arm's own
        // `expr_located` sets and restores the same location.
        if self.locations && location != NO_LOCATION {
            set_srcloc(inout b, wrapping_u32(location));
            self.cur_loc = location;
        }
        let none = Value { id: invalid() };
        let x = if n >= 1 {
            self.value(at64(in ops, 0))
        } else {
            none
        };
        let y = if n >= 2 {
            self.value(at64(in ops, 1))
        } else {
            none
        };
        let v = if kind == INST_PLANNED {
            let request = w.next();
            let a = w.next();
            let k = w.next();
            let r = planned(inout b, wrapping_u32(request), a, k, self.optimize, x, y);
            if is_invalid(r) {
                return false;
            }
            r
        } else if kind == INST_READ {
            // `expr_at`'s read of a local: `use_var`, then `coerce` to the
            // local's type.
            let local = w.next();
            let read = w.next();
            let receiver = self.entry_read(dest);
            if !is_invalid(receiver) {
                receiver
            } else {
                let raw = self.use_local(inout b, local);
                body_coerce(inout b, raw, read, self.optimize)
            }
        } else if kind == INST_BIND {
            let local = w.next();
            if local != NO_LOCAL {
                self.def_local(inout b, local, x);
            }
            ins_iconst(inout b, ty_i64(), 0)
        } else if kind == INST_BIND_FIELDS {
            if !self.bind_node(inout b, inout w, x) {
                return false;
            }
            ins_iconst(inout b, ty_i64(), 0)
        } else if kind == INST_WRITE {
            // `ir_temp` of the value, then the assignment: the temporary
            // read back, the local defined (and stored to its slot), and
            // the statement's zero.
            let local = w.next();
            let temp_kind = w.next();
            let stated = w.next();
            let t = temp(inout b, x);
            let value = body_operand(inout b, t, temp_kind, self.optimize);
            self.def_local(inout b, local, value);
            self.store_local(inout b, local, value);
            let zero = ins_iconst(inout b, ty_i64(), 0);
            body_coerce(inout b, zero, stated, self.optimize)
        } else if kind == INST_WORDS_CALL {
            // `call_function_into` of a callee that returns its small enum
            // result as words (#2581): the call as part 6b makes it, its
            // results, the walk's zero for the call's own value, then each
            // word coerced to its type and defined (`scalar_call_words`).
            let call_idx = w.next();
            if call_idx >= self.callees.len() {
                return false;
            }
            let word = at64(in self.callees, call_idx);
            if (word & (FAIL_CALL | WORDS_CALL)) != WORDS_CALL {
                return false;
            }
            let callee = FuncId { id: wrapping_u32(word & CALLEE_ID_MASK) };
            let mut temps: ChunkSeq[u32] = ChunkSeq::new[u32]();
            for k in 0..n {
                temps.push(temp(inout b, self.value(at64(in ops, k))).id);
            }
            let mut args: ChunkSeq[u32] = ChunkSeq::new[u32]();
            for k in 0..n {
                let read = w.next();
                let tv = Var { id: at32(in temps, k) };
                args.push(body_operand(inout b, tv, read, self.optimize).id);
            }
            let fun = import_function(inout b, inout m, callee);
            let _ = ins_call(inout b, fun, in args.as_slice());
            let nw = w.next();
            let mut results: ChunkSeq[u32] = ChunkSeq::new[u32]();
            for k in 0..nw {
                results.push(inst_result(inout b, wrapping_u32(k)).id);
            }
            let zero = ins_iconst(inout b, ty_i64(), 0);
            for k in 0..nw {
                let index = w.next();
                let word_kind = w.next();
                let raw = Value { id: at32(in results, k) };
                let v = body_coerce(inout b, raw, word_kind, self.optimize);
                let ok = self.values.try_set(index, v.id);
                def_var(inout b, var_at(in self.registers, index), v);
            }
            zero
        } else if kind == INST_CALL || kind == INST_FAIL_CALL {
            // `ir_temp` of every argument, then each read back and coerced
            // in order, then `declare_func_in_func` and `call` (part 6b).
            // A `fail_only` callee (#2425) also takes a failure record,
            // whose failure is raised again after the call.
            let call_idx = w.next();
            if call_idx >= self.callees.len() {
                return false;
            }
            let word = at64(in self.callees, call_idx);
            let fails = kind == INST_FAIL_CALL;
            if ((word & FAIL_CALL) != 0) != fails || (word & WORDS_CALL) != 0 {
                return false;
            }
            let callee = FuncId { id: wrapping_u32(word & CALLEE_ID_MASK) };
            let mut temps: ChunkSeq[u32] = ChunkSeq::new[u32]();
            for k in 0..n {
                temps.push(temp(inout b, self.value(at64(in ops, k))).id);
            }
            let mut args: ChunkSeq[u32] = ChunkSeq::new[u32]();
            for k in 0..n {
                let read = w.next();
                let tv = Var { id: at32(in temps, k) };
                args.push(body_operand(inout b, tv, read, self.optimize).id);
            }
            if !fails {
                let fun = import_function(inout b, inout m, callee);
                let _ = ins_call(inout b, fun, in args.as_slice());
                inst_result(inout b, 0)
            } else {
                let status_call = (word & STATUS_CALL) != 0;
                let size = w.next();
                let record = self.alloc_record(inout b, in m, size, status_call);
                args.push(record.id);
                let fun = import_function(inout b, inout m, callee);
                let _ = ins_call(inout b, fun, in args.as_slice());
                let result = inst_result(inout b, 0);
                let tag = if status_call {
                    inst_result(inout b, 1)
                } else {
                    ins_load(inout b, ty_i64(), PLAIN, record, 0)
                };
                if !self.reraise(inout b, inout m, inout w, record, tag) {
                    return false;
                }
                result
            }
        } else if kind == INST_RAISE {
            // `Codegen::perform` of `Fail::raise` (#2657): the error's
            // `ir_temp` read back, then the handler clause in scope (the
            // value is its entry's parameter) or `fail_exit` (the value is
            // the unreachable block's zero).
            let index = w.next();
            let size = w.next();
            let scalar_kind = w.next();
            let read = w.next();
            let tv = temp(inout b, x);
            let read_back = body_operand(inout b, tv, read, self.optimize);
            // An aggregate error is read as a copy in fresh storage
            // (`Codegen::expr` of a name), a word at a time.
            let error = if scalar_kind == AGGREGATE_ERROR {
                let copy = self.storage(inout b, in m, size);
                let mut offset: u64 = 0;
                loop {
                    if offset >= size {
                        break;
                    }
                    let word = ins_load(inout b, ty_i64(), PLAIN, read_back, wrapping_i32(offset));
                    ins_store(inout b, PLAIN, word, copy, wrapping_i32(offset));
                    offset = wrapping_add(offset, widen_u64(WORD_BYTES));
                }
                copy
            } else {
                read_back
            };
            if index >= HANDLER_BASE {
                let depth = wrapping_sub(index, HANDLER_BASE);
                let resumed = self.perform(inout b, inout m, inout w, depth, error);
                if is_invalid(resumed) {
                    return false;
                }
                resumed
            } else if scalar_kind == AGGREGATE_ERROR {
                self.fail_exit(inout b, index, error, size)
            } else {
                self.fail_exit_scalar(inout b, index, error, scalar_kind)
            }
        } else if kind == INST_INOUT_CALL {
            // A pure callee that borrows scalar locals `inout` (#2563):
            // `ir_temp` of each `in` argument, then in argument order each
            // `in` one read back and each `inout` one's address
            // (`Codegen::address`: its own, or a scratch word holding the
            // register's value) with the value stored to it again
            // (`call_function_into`); the call; then each borrowed local
            // loaded back and defined (`restores`).
            let call_idx = w.next();
            if call_idx >= self.callees.len() {
                return false;
            }
            let word = at64(in self.callees, call_idx);
            let fails = (word & FAIL_CALL) != 0;
            let callee = FuncId { id: wrapping_u32(word & CALLEE_ID_MASK) };
            let mut temps: ChunkSeq[u32] = ChunkSeq::new[u32]();
            for k in 0..n {
                temps.push(temp(inout b, self.value(at64(in ops, k))).id);
            }
            let nargs = w.next();
            let mut args: ChunkSeq[u32] = ChunkSeq::new[u32]();
            let mut lent: ChunkSeq[u64] = ChunkSeq::new[u64]();
            let mut lent_ptrs: ChunkSeq[u32] = ChunkSeq::new[u32]();
            let mut lent_lanes: ChunkSeq[u64] = ChunkSeq::new[u64]();
            let mut ti: u64 = 0;
            for k in 0..nargs {
                let tag = w.next();
                if tag == ARG_IN {
                    let read = w.next();
                    if ti >= n {
                        return false;
                    }
                    let tv = Var { id: at32(in temps, ti) };
                    ti = wrapping_add(ti, 1);
                    args.push(body_operand(inout b, tv, read, self.optimize).id);
                } else if tag == ARG_INOUT {
                    let l = w.next();
                    let lane = w.next();
                    if l >= self.locals.len() {
                        return false;
                    }
                    let address = at32(in self.addresses, l);
                    let ptr = if address != invalid() {
                        use_var(inout b, Var { id: address })
                    } else {
                        let value = self.use_local(inout b, l);
                        let bytes = if lane == LANE_I128 {
                            WIDE_BYTES
                        } else {
                            WORD_BYTES
                        };
                        let slot = create_stack_slot(inout b, bytes, SLOT_ALIGN_SHIFT);
                        let scratch = ins_stack_addr(inout b, module_pointer_type(in m), slot, 0);
                        ins_store(inout b, PLAIN, value, scratch, 0);
                        scratch
                    };
                    let value = self.use_local(inout b, l);
                    ins_store(inout b, PLAIN, value, ptr, 0);
                    lent.push(l);
                    lent_ptrs.push(ptr.id);
                    lent_lanes.push(lane);
                    args.push(ptr.id);
                } else {
                    return false;
                }
            }
            if ti != n {
                return false;
            }
            let mut result = Value { id: invalid() };
            if !fails {
                let fun = import_function(inout b, inout m, callee);
                let _ = ins_call(inout b, fun, in args.as_slice());
                result = inst_result(inout b, 0);
            } else {
                // A `fail_only` callee (#2614): its record after the
                // arguments, the failure raised again before the restores.
                let status_call = (word & STATUS_CALL) != 0;
                let size = w.next();
                let record = self.alloc_record(inout b, in m, size, status_call);
                args.push(record.id);
                let fun = import_function(inout b, inout m, callee);
                let _ = ins_call(inout b, fun, in args.as_slice());
                result = inst_result(inout b, 0);
                let tag = if status_call {
                    inst_result(inout b, 1)
                } else {
                    ins_load(inout b, ty_i64(), PLAIN, record, 0)
                };
                if !self.reraise(inout b, inout m, inout w, record, tag) {
                    return false;
                }
            }
            for k in 0..lent.len() {
                let l = at64(in lent, k);
                let ptr = Value { id: at32(in lent_ptrs, k) };
                let value = ins_load(inout b, lane_type(at64(in lent_lanes, k)), PLAIN, ptr, 0);
                self.def_local(inout b, l, value);
                let address = at32(in self.addresses, l);
                if address != invalid() {
                    let destination = use_var(inout b, Var { id: address });
                    ins_store(inout b, PLAIN, value, destination, 0);
                }
            }
            result
        } else if kind == INST_CHECKED {
            // `expr_at`'s general `Binary` arm (#2425): both operands named
            // by temporaries and read back, the divisor test of a partial
            // `/` or `%`, `checked_arithmetic`'s overflow test, `binary`.
            let op = w.next();
            let ik = w.next();
            let k0 = w.next();
            let k1 = w.next();
            let rk = w.next();
            let lv = temp(inout b, x);
            let rv = temp(inout b, y);
            let lhs = operand(inout b, lv, k0, self.optimize);
            let rhs = operand(inout b, rv, k1, self.optimize);
            let divisor = w.next();
            if divisor != NO_RAISE {
                let size = w.next();
                let tag = w.next();
                let nonzero = ins_icmp_imm(inout b, cc_ne(), rhs, 0);
                if !self.raising(inout b, inout m, inout w, nonzero, false, divisor, size, tag) {
                    return false;
                }
            }
            let overflow = w.next();
            if overflow != NO_RAISE {
                let size = w.next();
                let tag = w.next();
                // `checked_arithmetic` tests `+`, `-`, `*` and `/` only.
                let flag = if op == CK_REM {
                    Value { id: invalid() }
                } else {
                    emit_overflow_test(inout b, op, ik, lhs, rhs)
                };
                if !is_invalid(flag)
                    && !self.raising(inout b, inout m, inout w, flag, true, overflow, size, tag)
                {
                    return false;
                }
            }
            let unsigned = kind_unsigned(ik);
            let raw = if op == CK_ADD {
                ins_iadd(inout b, lhs, rhs)
            } else if op == CK_SUB {
                ins_isub(inout b, lhs, rhs)
            } else if op == CK_MUL {
                ins_imul(inout b, lhs, rhs)
            } else if op == CK_DIV {
                if unsigned {
                    ins_udiv(inout b, lhs, rhs)
                } else {
                    emit_sdiv_guarded(inout b, lhs, rhs)
                }
            } else if op == CK_REM {
                if unsigned {
                    ins_urem(inout b, lhs, rhs)
                } else {
                    ins_srem(inout b, lhs, rhs)
                }
            } else {
                return false;
            };
            coerce(inout b, raw, rk, self.optimize)
        } else if kind == INST_F32CONST {
            ins_f32const(inout b, wrapping_u32(w.next()))
        } else if kind == INST_ICONST {
            ins_iconst(inout b, ty_i64(), wrapping_i64(w.next()))
        } else if kind == INST_F64CONST {
            ins_f64const(inout b, w.next())
        } else if kind == INST_FLOAT_UNARY {
            let fun = w.next();
            let meta = w.next();
            let op_kind = w.next();
            let res_kind = w.next();
            let src_var = temp(inout b, x);
            let src = operand(inout b, src_var, op_kind, self.optimize);
            let raw = emit_float_unary(inout b, fun, meta, src);
            if is_invalid(raw) {
                return false;
            }
            if fun == FUN_FNEG {
                coerce(inout b, raw, res_kind, self.optimize)
            } else {
                let c1 = coerce(inout b, raw, res_kind, self.optimize);
                coerce(inout b, c1, res_kind, self.optimize)
            }
        } else if kind == INST_FLOAT_BINARY {
            let fb = w.next();
            let raw = emit_float_binary(inout b, fb, x, y);
            if is_invalid(raw) {
                return false;
            }
            raw
        } else if kind == INST_INT_EXTRA {
            let iex = w.next();
            let sub = w.next();
            let ik = w.next();
            let k0 = w.next();
            let k1 = w.next();
            let rk = w.next();
            if iex == IEX_WIDEN_U64 {
                let src_var = temp(inout b, x);
                let src = operand(inout b, src_var, k0, self.optimize);
                coerce(inout b, src, rk, self.optimize)
            } else if iex == IEX_BIT_UNARY {
                let src_var = temp(inout b, x);
                let src = operand(inout b, src_var, k0, self.optimize);
                let raw = emit_bit_builtin(inout b, sub, ik, src, none);
                coerce(inout b, raw, rk, self.optimize)
            } else if iex == IEX_BIT_BINARY {
                let lv = temp(inout b, x);
                let rv = temp(inout b, y);
                let lhs = operand(inout b, lv, k0, self.optimize);
                let rhs = operand(inout b, rv, k1, self.optimize);
                let raw = emit_bit_builtin(inout b, sub, ik, lhs, rhs);
                coerce(inout b, raw, rk, self.optimize)
            } else if iex == IEX_BITWISE {
                let lv = temp(inout b, x);
                let rv = temp(inout b, y);
                let lhs = operand(inout b, lv, k0, self.optimize);
                let rhs = operand(inout b, rv, k1, self.optimize);
                let raw = emit_bitwise(inout b, sub, ik, lhs, rhs);
                let c1 = coerce(inout b, raw, k0, self.optimize);
                coerce(inout b, c1, rk, self.optimize)
            } else if iex == IEX_SDIV {
                let lv = temp(inout b, x);
                let rv = temp(inout b, y);
                let lhs = operand(inout b, lv, k0, self.optimize);
                let rhs = operand(inout b, rv, k1, self.optimize);
                let raw = emit_sdiv_guarded(inout b, lhs, rhs);
                coerce(inout b, raw, rk, self.optimize)
            } else if iex == IEX_SREM {
                let lv = temp(inout b, x);
                let rv = temp(inout b, y);
                let lhs = operand(inout b, lv, k0, self.optimize);
                let rhs = operand(inout b, rv, k1, self.optimize);
                let raw = ins_srem(inout b, lhs, rhs);
                coerce(inout b, raw, rk, self.optimize)
            } else if iex == IEX_UDIV {
                let lv = temp(inout b, x);
                let rv = temp(inout b, y);
                let lhs = operand(inout b, lv, k0, self.optimize);
                let rhs = operand(inout b, rv, k1, self.optimize);
                let raw = ins_udiv(inout b, lhs, rhs);
                coerce(inout b, raw, rk, self.optimize)
            } else if iex == IEX_UREM {
                let lv = temp(inout b, x);
                let rv = temp(inout b, y);
                let lhs = operand(inout b, lv, k0, self.optimize);
                let rhs = operand(inout b, rv, k1, self.optimize);
                let raw = ins_urem(inout b, lhs, rhs);
                coerce(inout b, raw, rk, self.optimize)
            } else if iex == IEX_SHL {
                let lv = temp(inout b, x);
                let rv = temp(inout b, y);
                let lhs = operand(inout b, lv, k0, self.optimize);
                let rhs = operand(inout b, rv, k1, self.optimize);
                let raw = ins_ishl(inout b, lhs, rhs);
                coerce(inout b, raw, rk, self.optimize)
            } else if iex == IEX_USHR {
                let lv = temp(inout b, x);
                let rv = temp(inout b, y);
                let lhs = operand(inout b, lv, k0, self.optimize);
                let rhs = operand(inout b, rv, k1, self.optimize);
                let raw = ins_ushr(inout b, lhs, rhs);
                coerce(inout b, raw, rk, self.optimize)
            } else if iex == IEX_SSHR {
                let lv = temp(inout b, x);
                let rv = temp(inout b, y);
                let lhs = operand(inout b, lv, k0, self.optimize);
                let rhs = operand(inout b, rv, k1, self.optimize);
                let raw = ins_sshr(inout b, lhs, rhs);
                coerce(inout b, raw, rk, self.optimize)
            } else if iex == IEX_WORD_CONVERT {
                let src_var = temp(inout b, x);
                let src = operand(inout b, src_var, k0, self.optimize);
                let c1 = coerce(inout b, src, sub, self.optimize);
                coerce(inout b, c1, rk, self.optimize)
            } else if iex == IEX_WRAPPING_ADD {
                let lv = temp(inout b, x);
                let rv = temp(inout b, y);
                let lhs = operand(inout b, lv, k0, self.optimize);
                let rhs = operand(inout b, rv, k1, self.optimize);
                let raw = ins_iadd(inout b, lhs, rhs);
                coerce(inout b, raw, rk, self.optimize)
            } else if iex == IEX_WRAPPING_SUB {
                let lv = temp(inout b, x);
                let rv = temp(inout b, y);
                let lhs = operand(inout b, lv, k0, self.optimize);
                let rhs = operand(inout b, rv, k1, self.optimize);
                let raw = ins_isub(inout b, lhs, rhs);
                coerce(inout b, raw, rk, self.optimize)
            } else if iex == IEX_WRAPPING_MUL {
                let lv = temp(inout b, x);
                let rv = temp(inout b, y);
                let lhs = operand(inout b, lv, k0, self.optimize);
                let rhs = operand(inout b, rv, k1, self.optimize);
                let raw = ins_imul(inout b, lhs, rhs);
                coerce(inout b, raw, rk, self.optimize)
            } else if iex == IEX_BNOT {
                let src_var = temp(inout b, x);
                let src = operand(inout b, src_var, k0, self.optimize);
                let raw = ins_bnot(inout b, src);
                coerce(inout b, raw, rk, self.optimize)
            } else if iex == IEX_INEG {
                let src_var = temp(inout b, x);
                let src = operand(inout b, src_var, k0, self.optimize);
                let raw = ins_ineg(inout b, src);
                coerce(inout b, raw, rk, self.optimize)
            } else if iex == IEX_LNOT {
                let src_var = temp(inout b, x);
                let src = operand(inout b, src_var, k0, self.optimize);
                let cmp = ins_icmp_imm(inout b, cc_eq(), src, 0);
                let raw = ins_uextend(inout b, ty_i64(), cmp);
                coerce(inout b, raw, rk, self.optimize)
            } else if iex == IEX_BAND {
                let lv = temp(inout b, x);
                let rv = temp(inout b, y);
                let lhs = operand(inout b, lv, k0, self.optimize);
                let rhs = operand(inout b, rv, k1, self.optimize);
                let raw = ins_band(inout b, lhs, rhs);
                coerce(inout b, raw, rk, self.optimize)
            } else if iex == IEX_BOR {
                let lv = temp(inout b, x);
                let rv = temp(inout b, y);
                let lhs = operand(inout b, lv, k0, self.optimize);
                let rhs = operand(inout b, rv, k1, self.optimize);
                let raw = ins_bor(inout b, lhs, rhs);
                coerce(inout b, raw, rk, self.optimize)
            } else if iex == IEX_BXOR {
                let lv = temp(inout b, x);
                let rv = temp(inout b, y);
                let lhs = operand(inout b, lv, k0, self.optimize);
                let rhs = operand(inout b, rv, k1, self.optimize);
                let raw = ins_bxor(inout b, lhs, rhs);
                coerce(inout b, raw, rk, self.optimize)
            } else if iex == IEX_WORD_BIN {
                let lv = temp(inout b, x);
                let rv = temp(inout b, y);
                let lhs = operand(inout b, lv, k0, self.optimize);
                let rhs = operand(inout b, rv, k1, self.optimize);
                let raw = emit_wide_binary(inout b, sub, lhs, rhs);
                if is_invalid(raw) {
                    return false;
                }
                coerce(inout b, raw, rk, self.optimize)
            } else {
                return false;
            }
        } else if kind == INST_WRITE_OP {
            let local = w.next();
            let wop = w.next();
            let temp_kind = w.next();
            let local_kind = w.next();
            let stated = w.next();
            let t = temp(inout b, x);
            let rhs = body_operand(inout b, t, temp_kind, self.optimize);
            let old = self.use_local(inout b, local);
            let raw = emit_write_op(inout b, wop, old, rhs);
            if is_invalid(raw) {
                return false;
            }
            let updated = body_coerce(inout b, raw, local_kind, self.optimize);
            self.def_local(inout b, local, updated);
            self.store_local(inout b, local, updated);
            let zero = ins_iconst(inout b, ty_i64(), 0);
            body_coerce(inout b, zero, stated, self.optimize)
        } else if kind == INST_EXIT {
            let default_lane = w.next();
            let out_val = if default_lane != 0 {
                zero_of(inout b, default_lane)
            } else {
                x
            };
            self.emit_return_value(inout b, out_val);
            let dead = create_block(inout b);
            switch_to_block(inout b, dead);
            ins_iconst(inout b, ty_i64(), 0)
        } else if kind == INST_CALL_BUILTIN {
            let cb = w.next();
            let sub = w.next();
            let meta = w.next();
            let site_kind = w.next();
            let mut tvars: ChunkSeq[u32] = ChunkSeq::new[u32]();
            for k in 0..n {
                tvars.push(temp(inout b, self.value(at64(in ops, k))).id);
            }
            let mut avals: ChunkSeq[u32] = ChunkSeq::new[u32]();
            for k in 0..n {
                let ak = w.next();
                let tv = Var { id: at32(in tvars, k) };
                avals.push(body_operand(inout b, tv, ak, self.optimize).id);
            }
            let a0 = Value { id: at32(in avals, 0) };
            let a1 = Value { id: at32(in avals, 1) };
            let a2 = Value { id: at32(in avals, 2) };
            if cb == CB_BIT {
                emit_bit_builtin(inout b, sub, meta, a0, a1)
            } else if cb == CB_WIDE_BIT {
                let raw = if sub == BIT_OP_WRAPPING_SHL {
                    ins_ishl(inout b, a0, a1)
                } else if sub == BIT_OP_WRAPPING_SHR {
                    if kind_unsigned(meta) {
                        ins_ushr(inout b, a0, a1)
                    } else {
                        ins_sshr(inout b, a0, a1)
                    }
                } else {
                    emit_wide_unary(inout b, WUN_BIT, sub, meta, a0, self.optimize)
                };
                if is_invalid(raw) {
                    return false;
                }
                raw
            } else if cb == CB_BITWISE {
                let raw = emit_bitwise(inout b, sub, meta, a0, a1);
                coerce(inout b, raw, site_kind, self.optimize)
            } else if cb == CB_WIDE_CONVERT {
                emit_wide_unary(inout b, WUN_CONVERT, sub, meta, a0, self.optimize)
            } else if cb == CB_WIDEN_U64 {
                a0
            } else if cb == CB_WORD_CONVERT {
                coerce(inout b, a0, sub, self.optimize)
            } else if cb == CB_WRAPPING_BIN {
                emit_wide_binary(inout b, sub, a0, a1)
            } else if cb == CB_FMA {
                Value { id: Cranelift::vcl_ternary(inout b, Ternary::Fma, a0.id, a1.id, a2.id) }
            } else if cb == CB_FMIN {
                ins_binary(inout b, Bin::Fmin, a0, a1)
            } else if cb == CB_FMAX {
                ins_binary(inout b, Bin::Fmax, a0, a1)
            } else if cb == CB_FLOAT_UNARY {
                let raw = emit_float_unary(inout b, sub, meta, a0);
                if is_invalid(raw) {
                    return false;
                }
                coerce(inout b, raw, site_kind, self.optimize)
            } else {
                return false;
            }
        } else if kind == INST_WIDE_CONST {
            let lo = w.next();
            let hi = w.next();
            let rk = w.next();
            let raw = wide_const(inout b, lo, hi);
            body_coerce(inout b, raw, rk, self.optimize)
        } else if kind == INST_WIDE_UNARY {
            let wun = w.next();
            let a = w.next();
            let c = w.next();
            let op_kind = w.next();
            let res_kind = w.next();
            let src_var = temp(inout b, x);
            let src = body_operand(inout b, src_var, op_kind, self.optimize);
            let raw = emit_wide_unary(inout b, wun, a, c, src, self.optimize);
            if is_invalid(raw) {
                return false;
            }
            body_coerce(inout b, raw, res_kind, self.optimize)
        } else if kind == INST_WIDE_BINARY {
            let wb = w.next();
            let k0 = w.next();
            let k1 = w.next();
            let rk = w.next();
            let lv = temp(inout b, x);
            let rv = temp(inout b, y);
            let lhs = body_operand(inout b, lv, k0, self.optimize);
            let rhs = body_operand(inout b, rv, k1, self.optimize);
            let raw = emit_wide_binary(inout b, wb, lhs, rhs);
            if is_invalid(raw) {
                return false;
            }
            body_coerce(inout b, raw, rk, self.optimize)
        } else if kind == INST_DATA {
            // `Codegen::data_into` of a struct or tuple (#2411): every
            // field's value in a temporary, then its storage (the result
            // pointer when this is the result's home, else a fresh slot,
            // zeroed only on the unoptimized path), the optimize path's
            // zeroing of the words no field writes whole, and each field
            // read back, coerced and stored at its offset.
            let size = w.next();
            let mut temps: ChunkSeq[u32] = ChunkSeq::new[u32]();
            for k in 0..n {
                temps.push(temp(inout b, self.value(at64(in ops, k))).id);
            }
            let ptr = if self.sret != invalid() && has_call(in self.homes, dest) {
                Value { id: self.sret }
            } else {
                self.storage(inout b, in m, size)
            };
            let nz = w.next();
            for k in 0..nz {
                let offset = w.next();
                if self.optimize {
                    let zero = ins_iconst(inout b, ty_i64(), 0);
                    ins_store(inout b, PLAIN, zero, ptr, wrapping_i32(offset));
                }
            }
            // An enum's tag (#2654).
            let tag = w.next();
            if tag != NO_TAG {
                let word = ins_iconst(inout b, ty_i64(), wrapping_i64(tag));
                ins_store(inout b, PLAIN, word, ptr, 0);
            }
            for k in 0..n {
                let offset = w.next();
                let read = w.next();
                let store = w.next();
                let tv = Var { id: at32(in temps, k) };
                let read_value = body_operand(inout b, tv, read, self.optimize);
                // The unoptimized path reads an aggregate field's value as
                // an expression: a copy in fresh storage first.
                let value = if store >= STORE_AGGREGATE && !self.optimize {
                    let fsize = wrapping_sub(store, STORE_AGGREGATE);
                    let copy = self.storage(inout b, in m, fsize);
                    let mut foff: u64 = 0;
                    loop {
                        if foff >= fsize {
                            break;
                        }
                        let word = ins_load(
                            inout b,
                            ty_i64(),
                            PLAIN,
                            read_value,
                            wrapping_i32(foff)
                        );
                        ins_store(inout b, PLAIN, word, copy, wrapping_i32(foff));
                        foff = wrapping_add(foff, widen_u64(WORD_BYTES));
                    }
                    copy
                } else {
                    read_value
                };
                let field = ins_iadd_imm(inout b, ptr, wrapping_i64(offset));
                if store >= STORE_AGGREGATE {
                    let fsize = wrapping_sub(store, STORE_AGGREGATE);
                    let mut foff: u64 = 0;
                    loop {
                        if foff >= fsize {
                            break;
                        }
                        let word = ins_load(inout b, ty_i64(), PLAIN, value, wrapping_i32(foff));
                        ins_store(inout b, PLAIN, word, field, wrapping_i32(foff));
                        foff = wrapping_add(foff, widen_u64(WORD_BYTES));
                    }
                } else {
                    let stored = body_coerce(inout b, value, store, self.optimize);
                    ins_store(inout b, PLAIN, stored, field, 0);
                }
            }
            ptr
        } else if kind == INST_PROJECT {
            let off = w.next();
            let flane = w.next();
            let base_var = temp(inout b, x);
            let base = use_var(inout b, base_var);
            let ptr = ins_iadd_imm(inout b, base, wrapping_i64(off));
            ins_load(inout b, lane_type(flane), PLAIN, ptr, 0)
        } else if kind == INST_READ_FIELD {
            let k = w.next();
            let flane = w.next();
            let nsteps = w.next();
            let mut ptr = self.use_local(inout b, k);
            for _ in 0..nsteps {
                let off = w.next();
                ptr = ins_iadd_imm(inout b, ptr, wrapping_i64(off));
            }
            ins_load(inout b, lane_type(flane), PLAIN, ptr, 0)
        } else if kind == INST_SEQ {
            let v = self.seq(inout b, inout m, inout w, x, y);
            if is_invalid(v) {
                return false;
            }
            v
        } else if kind == INST_READ_COPY {
            let local = w.next();
            let size = w.next();
            let from = self.use_local(inout b, local);
            let to = self.storage(inout b, in m, size);
            let mut off: u64 = 0;
            loop {
                if off >= size {
                    break;
                }
                let word = ins_load(inout b, ty_i64(), PLAIN, from, wrapping_i32(off));
                ins_store(inout b, PLAIN, word, to, wrapping_i32(off));
                off = wrapping_add(off, widen_u64(WORD_BYTES));
            }
            to
        } else if kind == INST_HANDLE {
            let out = self.handle(inout b, inout m, inout w);
            if is_invalid(out) {
                return false;
            }
            out
        } else {
            return false;
        };
        let v = body_coerce(inout b, v, post, self.optimize);
        let ok = self.values.try_set(dest, v.id);
        def_var(inout b, var_at(in self.registers, dest), v);
        true
    }

    // A block's terminator, after its operands' reads.
    // The rest of a graph after its locals (`ir_graph_at`): each value's
    // register, the blocks' parameters, then each block in the lowering
    // order, sealed on the way, with its instructions and terminator.
    fn graph_rest(
        inout self,
        inout b: Builder,
        inout m: Module,
        inout w: Words,
        nb: u64
    ) -> bool eff [Ffi[Cranelift]] {
        let nv = w.next();
        let mut lanes: ChunkSeq[u64] = ChunkSeq::new[u64]();
        for k in 0..nv {
            let lane = w.next();
            lanes.push(lane);
            self.registers.push(zeroed(inout b, lane));
            self.params.push(invalid());
            self.values.push(invalid());
        }
        self.refresh_all = !self.optimize && nv <= FULL_REFRESH_VALUES;
        // Block parameters, and where each block's list is.
        let mut starts: ChunkSeq[u64] = ChunkSeq::new[u64]();
        for bi in 0..nb {
            starts.push(w.at);
            let n = w.next();
            for k in 0..n {
                let i = w.next();
                let p = append_block_param(inout b, self.block(bi), lane_type(at64(in lanes, i)));
                let ok = self.params.try_set(i, p.id);
            }
        }
        // The lowering order.
        let mut order: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let mut seal: ChunkSeq[u64] = ChunkSeq::new[u64]();
        for k in 0..nb {
            order.push(w.next());
            seal.push(w.next());
        }
        for k in 0..nb {
            let bi = at64(in order, k);
            let blk = self.block(bi);
            if current_block(inout b).id != blk.id {
                switch_to_block(inout b, blk);
            }
            if at64(in seal, k) != 0 {
                seal_block(inout b, blk);
            }
            // The block's parameters define their registers.
            let mut pa = at64(in starts, bi);
            let n = w.arg(pa);
            for j in 0..n {
                pa = wrapping_add(pa, 1);
                let i = w.arg(pa);
                let p = Value { id: at32(in self.params, i) };
                def_var(inout b, var_at(in self.registers, i), p);
                let ok = self.values.try_set(i, p.id);
            }
            // `seq_entry_view` in the entry block: each view's parameter
            // read once, its header words read-only memory from then on.
            if bi == 0 && self.join == invalid() {
                let mut v: u64 = 0;
                for _ in 0..self.nviews {
                    let p = at64(in self.views, v);
                    let nr = at64(in self.views, wrapping_add(v, 1));
                    v = wrapping_add(v, 2);
                    let var = Var {
                        id: wrapping_u32(w.arg(wrapping_add(wrapping_add(ARG_PARAMS, 1), p)))
                    };
                    let receiver = use_var(inout b, var);
                    self.invariant.push(receiver.id);
                    for _ in 0..nr {
                        let i = at64(in self.views, v);
                        v = wrapping_add(v, 1);
                        loop {
                            if self.entry_reads.len() > i {
                                break;
                            }
                            self.entry_reads.push(invalid());
                        }
                        let ok = self.entry_reads.try_set(i, receiver.id);
                    }
                }
            }
            let ic = w.next();
            for j in 0..ic {
                if !self.inst(inout b, inout m, inout w) {
                    return false;
                }
            }
            if !self.terminator(inout b, inout w) {
                return false;
            }
        }
        true
    }

    // A new local slot (#2657).
    fn new_slot(inout self, var: u32, kind: u64, address: u32, register: bool) -> u64 {
        let slot = self.svar.len();
        self.svar.push(var);
        self.skind.push(kind);
        self.saddr.push(address);
        self.sreg.push(if register { 1 } else { 0 });
        slot
    }

    // The slot of the name `name` in scope, or NONE64.
    fn lookup(in self, name: u64) -> u64 {
        let mut k = self.snames.len();
        loop {
            if k == 0 {
                break;
            }
            k = wrapping_sub(k, 1);
            if at64(in self.snames, k) == name {
                return at64(in self.sslots, k);
            }
        }
        NONE64
    }

    // `Codegen::use_var` of a slot's variable: a load through its address
    // when it has one.
    fn use_slot(inout self, inout b: Builder, slot: u64) -> Value eff [Ffi[Cranelift]] {
        let raw = use_var(inout b, Var { id: at32(in self.svar, slot) });
        let address = at32(in self.saddr, slot);
        if address == invalid() {
            return raw;
        }
        let pointer = use_var(inout b, Var { id: address });
        let ty = value_type(inout b, raw);
        ins_load(inout b, ty, PLAIN, pointer, 0)
    }

    // `copy_bindings`: each slot's value in a fresh variable, a new slot
    // under the same name, in order. The new scope is those names only.
    fn copy_bindings(
        inout self,
        inout b: Builder,
        in names: ChunkSeq[u64],
        in slots: ChunkSeq[u64],
        inout out_names: ChunkSeq[u64],
        inout out_slots: ChunkSeq[u64]
    ) eff [Ffi[Cranelift]] {
        for k in 0..names.len() {
            let slot = at64(in slots, k);
            let v = self.use_slot(inout b, slot);
            let ty = value_type(inout b, v);
            let var = declare_var(inout b, ty);
            def_var(inout b, var, v);
            out_names.push(at64(in names, k));
            out_slots.push(self.new_slot(var.id, at64(in self.skind, slot), invalid(), false));
        }
    }

    // `bind_local` of `v` under `name` (NO_LOCAL binds nothing).
    fn bind_name(inout self, inout b: Builder, name: u64, v: Value) eff [Ffi[Cranelift]] {
        if name == NO_LOCAL {
            return;
        }
        let ty = value_type(inout b, v);
        let var = declare_var(inout b, ty);
        def_var(inout b, var, v);
        let slot = self.new_slot(var.id, 0, invalid(), false);
        self.snames.push(name);
        self.sslots.push(slot);
    }

    // A nested graph (`shared_control`, #2657) whose words start at `w`:
    // its join block of the result's lane, the graph (`ir_graph_at` with a
    // join), then the join's parameter.
    fn nested(
        inout self,
        inout b: Builder,
        inout m: Module,
        inout w: Words
    ) -> Value eff [Ffi[Cranelift]] {
        let len = w.next();
        let end = wrapping_add(w.at, len);
        let lane = w.next();
        let join = create_block(inout b);
        let p = append_block_param(inout b, join, lane_type(lane));
        if !self.graph(inout b, inout m, inout w, join) || w.at != end {
            return Value { id: invalid() };
        }
        switch_to_block(inout b, join);
        p
    }

    // `ir_graph_at` of a nested graph: a fresh entry block jumped to; its
    // locals by name (a name in scope shares its slot, else a zeroed
    // variable in a new one; either keeps a home slot unless it is a
    // register local or has one); then the rest as for the function's own
    // graph, with `return` jumping to `join`. The source location is
    // restored when it is done.
    fn graph(
        inout self,
        inout b: Builder,
        inout m: Module,
        inout w: Words,
        join: Block
    ) -> bool eff [Ffi[Cranelift]] {
        let saved_loc = self.cur_loc;
        let mut blocks: ChunkSeq[u32] = ChunkSeq::new[u32]();
        let mut locals: ChunkSeq[u32] = ChunkSeq::new[u32]();
        let mut kinds: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let mut addresses: ChunkSeq[u32] = ChunkSeq::new[u32]();
        let mut registers: ChunkSeq[u32] = ChunkSeq::new[u32]();
        let mut params: ChunkSeq[u32] = ChunkSeq::new[u32]();
        let mut values: ChunkSeq[u32] = ChunkSeq::new[u32]();
        // The function's entry reads name its own graph's values.
        let mut entry_reads: ChunkSeq[u32] = ChunkSeq::new[u32]();
        swap(inout entry_reads, inout self.entry_reads);
        swap(inout blocks, inout self.blocks);
        swap(inout locals, inout self.locals);
        swap(inout kinds, inout self.kinds);
        swap(inout addresses, inout self.addresses);
        swap(inout registers, inout self.registers);
        swap(inout params, inout self.params);
        swap(inout values, inout self.values);
        let refresh_all = self.refresh_all;
        let outer_join = self.join;
        self.join = join.id;
        let no_args: ChunkSeq[u32] = ChunkSeq::new[u32]();
        let entry = create_block(inout b);
        ins_jump(inout b, entry, in no_args.as_slice());
        switch_to_block(inout b, entry);
        let nb = w.next();
        self.blocks.push(entry.id);
        for k in 1..nb {
            self.blocks.push(create_block(inout b).id);
        }
        let nl = w.next();
        for k in 0..nl {
            let name = w.next();
            let lane = w.next();
            let kind_word = w.next();
            let mut slot = self.lookup(name);
            if slot == NONE64 {
                let var = zeroed(inout b, lane);
                let register = self.optimize && (kind_word & NESTED_REGISTER) != 0;
                slot = self.new_slot(var, kind_word & KIND_MASK, invalid(), register);
                self.snames.push(name);
                self.sslots.push(slot);
            }
            self.locals.push(at32(in self.svar, slot));
            self.kinds.push(kind_word & KIND_MASK);
            self.addresses.push(at32(in self.saddr, slot));
            // A product (a bound error) is its storage's address: no slot.
            if lane != LANE_PRODUCT
                && at64(in self.sreg, slot) == 0
                && at32(in self.saddr, slot) == invalid()
            {
                self.spill(inout b, in m, k);
                let ok = self.saddr.try_set(slot, at32(in self.addresses, k));
            }
        }
        let ok = self.graph_rest(inout b, inout m, inout w, nb);
        swap(inout entry_reads, inout self.entry_reads);
        swap(inout blocks, inout self.blocks);
        swap(inout locals, inout self.locals);
        swap(inout kinds, inout self.kinds);
        swap(inout addresses, inout self.addresses);
        swap(inout registers, inout self.registers);
        swap(inout params, inout self.params);
        swap(inout values, inout self.values);
        self.refresh_all = refresh_all;
        self.join = outer_join;
        if self.locations {
            self.cur_loc = saved_loc;
            set_srcloc(inout b, wrapping_u32(saved_loc));
        }
        ok
    }

    // `ExprKind::Handle` of a `Fail` handler (#2657): `HANDLE_SETUP`'s exit
    // and dispatch blocks and zeroed selector; the aliases in scope; the
    // captures (`copy_bindings`); the handled body with the handler in
    // scope; the captures again and the `return` pattern's binding; the
    // `return` clause; the jump to the dispatch, its one `return_to` test
    // and the trap; then the exit's parameter.
    fn handle(
        inout self,
        inout b: Builder,
        inout m: Module,
        inout w: Words
    ) -> Value eff [Ffi[Cranelift]] {
        let bad = Value { id: invalid() };
        let lane = w.next();
        let kind = w.next();
        let exit = create_block(inout b);
        let out = append_block_param(inout b, exit, lane_type(lane));
        let dispatch = create_block(inout b);
        let out_ty = value_type(inout b, out);
        let dispatched = append_block_param(inout b, dispatch, out_ty);
        let selector = declare_var(inout b, ty_i64());
        let zero = ins_iconst(inout b, ty_i64(), 0);
        def_var(inout b, selector, zero);
        // The aliases: the handler's scope.
        let mut names: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let mut slots: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let na = w.next();
        for k in 0..na {
            let name = w.next();
            let local = w.next();
            let address = at32(in self.addresses, local);
            let register = self.optimize && address == invalid();
            names.push(name);
            slots.push(
                self.new_slot(
                    at32(in self.locals, local),
                    at64(in self.kinds, local),
                    address,
                    register
                )
            );
        }
        swap(inout names, inout self.snames);
        swap(inout slots, inout self.sslots);
        // The captures.
        let nc = w.next();
        let mut cap_names: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let mut cap_slots: ChunkSeq[u64] = ChunkSeq::new[u64]();
        for k in 0..nc {
            let name = w.next();
            let ck = w.next();
            let slot = self.lookup(name);
            if slot == NONE64 {
                return bad;
            }
            cap_names.push(name);
            cap_slots.push(slot);
        }
        let mut captured_names: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let mut captured_slots: ChunkSeq[u64] = ChunkSeq::new[u64]();
        self.copy_bindings(
            inout b,
            in cap_names,
            in cap_slots,
            inout captured_names,
            inout captured_slots
        );
        let ret_name = w.next();
        // The `raise` clause, emitted at each raise of the body.
        let err_name = w.next();
        let clause = w.at;
        let clause_len = w.next();
        w.at = wrapping_add(w.at, clause_len);
        self.hexit.push(exit.id);
        self.hdispatch.push(dispatch.id);
        self.hkind.push(kind);
        self.herr.push(err_name);
        self.hclause.push(clause);
        self.hcap_a.push(self.hcap_names.len());
        self.hcap_n.push(captured_names.len());
        self.hcap_names.extend(in captured_names.as_slice());
        self.hcap_slots.extend(in captured_slots.as_slice());
        let body = self.nested(inout b, inout m, inout w);
        let hx = self.hexit.pop();
        let hd = self.hdispatch.pop();
        let hk = self.hkind.pop();
        let he = self.herr.pop();
        let hc = self.hclause.pop();
        let ha = self.hcap_a.pop();
        let hn = self.hcap_n.pop();
        if is_invalid(body) {
            return bad;
        }
        // The captures again, then the `return` pattern's binding.
        let mut ret_names: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let mut ret_slots: ChunkSeq[u64] = ChunkSeq::new[u64]();
        self.copy_bindings(
            inout b,
            in captured_names,
            in captured_slots,
            inout ret_names,
            inout ret_slots
        );
        swap(inout ret_names, inout self.snames);
        swap(inout ret_slots, inout self.sslots);
        self.bind_name(inout b, ret_name, body);
        let result = self.nested(inout b, inout m, inout w);
        if is_invalid(result) {
            return bad;
        }
        let mut args: ChunkSeq[u32] = ChunkSeq::new[u32]();
        args.push(result.id);
        ins_jump(inout b, dispatch, in args.as_slice());
        switch_to_block(inout b, dispatch);
        let sel = use_var(inout b, selector);
        let next = create_block(inout b);
        let hit = ins_icmp_imm(inout b, cc_eq(), sel, 0);
        let mut out_args: ChunkSeq[u32] = ChunkSeq::new[u32]();
        out_args.push(dispatched.id);
        let no_args: ChunkSeq[u32] = ChunkSeq::new[u32]();
        ins_brif(inout b, hit, exit, in out_args.as_slice(), next, in no_args.as_slice());
        switch_to_block(inout b, next);
        ins_trap(inout b, trap_user(DISPATCH_TRAP));
        // The scope before the handler.
        swap(inout names, inout self.snames);
        swap(inout slots, inout self.sslots);
        switch_to_block(inout b, exit);
        body_coerce(inout b, out, kind, self.optimize)
    }

    // `perform_values` of a raise of `error` that the handler at `depth`
    // takes (#2657): the handler's captures copied (the clause's whole
    // scope) and the error bound to the clause's name; the continuation's
    // entry block; the clause, its result coerced to the handler's and
    // jumped to its dispatch; then emission goes on in the entry.
    fn perform(
        inout self,
        inout b: Builder,
        inout m: Module,
        inout w: Words,
        depth: u64,
        error: Value
    ) -> Value eff [Ffi[Cranelift]] {
        let a = at64(in self.hcap_a, depth);
        let n = at64(in self.hcap_n, depth);
        let mut cap_names: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let mut cap_slots: ChunkSeq[u64] = ChunkSeq::new[u64]();
        for k in a..wrapping_add(a, n) {
            cap_names.push(at64(in self.hcap_names, k));
            cap_slots.push(at64(in self.hcap_slots, k));
        }
        let mut names: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let mut slots: ChunkSeq[u64] = ChunkSeq::new[u64]();
        self.copy_bindings(inout b, in cap_names, in cap_slots, inout names, inout slots);
        swap(inout names, inout self.snames);
        swap(inout slots, inout self.sslots);
        self.bind_name(inout b, at64(in self.herr, depth), error);
        let entry = create_block(inout b);
        let resumed = append_block_param(inout b, entry, ty_i64());
        let back = w.at;
        w.at = at64(in self.hclause, depth);
        let out = self.nested(inout b, inout m, inout w);
        w.at = back;
        swap(inout names, inout self.snames);
        swap(inout slots, inout self.sslots);
        if is_invalid(out) {
            return out;
        }
        let output = body_coerce(inout b, out, at64(in self.hkind, depth), self.optimize);
        let mut args: ChunkSeq[u32] = ChunkSeq::new[u32]();
        args.push(output.id);
        ins_jump(inout b, Block { id: at32(in self.hdispatch, depth) }, in args.as_slice());
        switch_to_block(inout b, entry);
        resumed
    }

    fn terminator(inout self, inout b: Builder, inout w: Words) -> bool eff [Ffi[Cranelift]] {
        let code = w.next();
        let mut ops: ChunkSeq[u64] = ChunkSeq::new[u64]();
        if code == TERM_RETURN {
            let i = w.next();
            let default = w.next();
            ops.push(i);
            self.read_operands(inout b, in ops);
            let v = if default != 0 {
                zero_of(inout b, default)
            } else {
                self.value(i)
            };
            if self.join != invalid() {
                // A nested graph's `return` (#2657): to its join.
                let mut args: ChunkSeq[u32] = ChunkSeq::new[u32]();
                args.push(v.id);
                ins_jump(inout b, Block { id: self.join }, in args.as_slice());
                return true;
            }
            self.emit_return_value(inout b, v);
            return true;
        }
        if code == TERM_RETURN_SRET {
            // A struct result: copied a word at a time to the result
            // pointer unless it was built there, then the word 0.
            let i = w.next();
            let size = w.next();
            ops.push(i);
            self.read_operands(inout b, in ops);
            if self.sret == invalid() {
                return false;
            }
            if !has_call(in self.homes, i) {
                let from = self.value(i);
                let to = Value { id: self.sret };
                let mut offset: u64 = 0;
                loop {
                    if offset >= size {
                        break;
                    }
                    let word = ins_load(inout b, ty_i64(), PLAIN, from, wrapping_i32(offset));
                    ins_store(inout b, PLAIN, word, to, wrapping_i32(offset));
                    offset = wrapping_add(offset, widen_u64(WORD_BYTES));
                }
            }
            // The walk's zero, then a register result's words loaded from
            // its buffer (`Codegen::return_value`).
            let zero = ins_iconst(inout b, ty_i64(), 0);
            if self.result_words != 0 {
                let buffer = Value { id: self.sret };
                let mut out: ChunkSeq[u32] = ChunkSeq::new[u32]();
                for k in 0..self.result_words {
                    let offset = wrapping_mul(k, widen_u64(WORD_BYTES));
                    out.push(ins_load(inout b, ty_i64(), PLAIN, buffer, wrapping_i32(offset)).id);
                }
                ins_return(inout b, in out.as_slice());
            } else {
                self.emit_return_value(inout b, zero);
            }
            return true;
        }
        if code == TERM_RETURN_WORDS {
            // `ir_graph_at`'s return of a small enum kept as words
            // (#2581): the value's own read, each word's register, then
            // the words returned (`return_words`).
            let i = w.next();
            let nw = w.next();
            ops.push(i);
            self.read_operands(inout b, in ops);
            let mut out: ChunkSeq[u32] = ChunkSeq::new[u32]();
            for k in 0..nw {
                let index = w.next();
                out.push(use_var(inout b, var_at(in self.registers, index)).id);
            }
            ins_return(inout b, in out.as_slice());
            return true;
        }
        if code == TERM_JUMP {
            let target = w.next();
            let n = w.next();
            let mut args: ChunkSeq[u64] = ChunkSeq::new[u64]();
            for k in 0..n {
                let i = w.next();
                args.push(i);
                args.push(w.next());
                ops.push(i);
            }
            self.read_operands(inout b, in ops);
            let mut out: ChunkSeq[u32] = ChunkSeq::new[u32]();
            for k in 0..n {
                let i = at64(in args, wrapping_mul(k, 2));
                let default = at64(in args, wrapping_add(wrapping_mul(k, 2), 1));
                let v = if default != 0 {
                    zero_of(inout b, default)
                } else {
                    self.value(i)
                };
                out.push(v.id);
            }
            ins_jump(inout b, self.block(target), in out.as_slice());
            return true;
        }
        if code == TERM_BRANCH {
            let c = w.next();
            let yes = w.next();
            let no = w.next();
            ops.push(c);
            self.read_operands(inout b, in ops);
            ins_brif0(inout b, self.value(c), self.block(yes), self.block(no));
            return true;
        }
        if code == TERM_MATCH {
            let scr_idx = w.next();
            let narms = w.next();
            ops.push(scr_idx);
            self.read_operands(inout b, in ops);
            let scr = self.value(scr_idx);
            for k in 0..narms {
                let akind = w.next();
                let payload = w.next();
                let hi = if akind == MATCH_WIDE { w.next() } else { 0 };
                let target = w.next();
                let next = create_block(inout b);
                let cond = if akind == MATCH_FIELDS {
                    let c = self.match_node(inout b, inout w, scr);
                    if is_invalid(c) {
                        return false;
                    }
                    c
                } else if akind == MATCH_TRUE {
                    ins_iconst(inout b, ty_i8(), 1)
                } else if akind == MATCH_INT {
                    ins_icmp_imm(inout b, cc_eq(), scr, wrapping_i64(payload))
                } else if akind == MATCH_F32 {
                    let lit = ins_f32const(inout b, wrapping_u32(payload));
                    ins_fcmp(inout b, FloatCc::Eq, scr, lit)
                } else if akind == MATCH_F64 {
                    let lit = ins_f64const(inout b, payload);
                    ins_fcmp(inout b, FloatCc::Eq, scr, lit)
                } else if akind == MATCH_WIDE {
                    let lit = wide_const(inout b, payload, hi);
                    ins_icmp(inout b, cc_eq(), scr, lit)
                } else {
                    return false;
                };
                ins_brif0(inout b, cond, self.block(target), next);
                seal_block(inout b, next);
                switch_to_block(inout b, next);
            }
            ins_trap(inout b, trap_user(UNREACHABLE_TRAP));
            return true;
        }
        if code == TERM_UNREACHABLE {
            self.read_operands(inout b, in ops);
            ins_trap(inout b, trap_user(UNREACHABLE_TRAP));
            return true;
        }
        false
    }
}

// The whole body of one planned function on the lent builder, whose
// current block is the function's entry: HANDLED, DECLINED when a non-builtin
// call is not one the walk makes directly, or BODY_ERROR when the words are
// not a body plan (nothing is declined once emission starts).
pub fn emit_body(call: u64, inout b: Builder, inout m: Module) -> u64 eff [Ffi[Cranelift]] {
    emit_body_words(call_args(call), inout b, inout m)
}

// `emit_body` over the request's words themselves: `[optimize, status,
// source locations, n, n parameter variables, m, m callees]` then the
// function's body plan. A driver that builds the function itself
// (@vesper/native-lib) calls this with the entry block current.
pub fn emit_body_words(
    sink args: ChunkSeq[u64],
    inout b: Builder,
    inout m: Module
) -> u64 eff [Ffi[Cranelift]] {
    let count = args.len();
    let mut w = Words { args: args, at: 0 };
    let np = w.arg(ARG_PARAMS);
    w.at = wrapping_add(wrapping_add(ARG_PARAMS, 1), np);
    if count < wrapping_add(w.at, 3) {
        return BODY_ERROR;
    }
    let ncw = w.next();
    let nc = wrapping_add(ncw & CALLEE_ID_MASK, ncw >> NESTED_CALLS_SHIFT);
    let mut callees: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for k in 0..nc {
        callees.push(w.next());
    }
    if count < wrapping_add(w.at, 2) {
        return BODY_ERROR;
    }
    let sret_word = w.next();
    let sret = if sret_word == NO_VALUE {
        invalid()
    } else {
        wrapping_u32(sret_word & CALLEE_ID_MASK)
    };
    let result_words = if sret_word == NO_VALUE {
        0
    } else {
        sret_word >> RESULT_WORDS_SHIFT
    };
    let nh = w.next();
    let mut homes: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for k in 0..nh {
        homes.push(w.next());
    }
    // Each declared parameter's address variable, or `NO_VALUE` (#2563):
    // an `inout` scalar is loaded at entry and stored through its address
    // at every definition, as a spilled local is.
    if count < wrapping_add(w.at, 1) {
        return BODY_ERROR;
    }
    let npointers = w.next();
    if count < wrapping_add(w.at, npointers) {
        return BODY_ERROR;
    }
    let mut pointers: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for k in 0..npointers {
        let word = w.next();
        pointers.push(
            if word == NO_VALUE {
                invalid()
            } else {
                wrapping_u32(word)
            }
        );
    }
    // The slice parameters read once at entry (#2653): each one's
    // parameter index, then the reads that take its receiver.
    if count < wrapping_add(w.at, 1) {
        return BODY_ERROR;
    }
    let nviews = w.next();
    let mut views: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for k in 0..nviews {
        if count < wrapping_add(w.at, 2) {
            return BODY_ERROR;
        }
        let p = w.next();
        let nr = w.next();
        if p >= np || count < wrapping_add(w.at, nr) {
            return BODY_ERROR;
        }
        views.push(p);
        views.push(nr);
        for j in 0..nr {
            views.push(w.next());
        }
    }
    if count < wrapping_add(w.at, 3) {
        return BODY_ERROR;
    }
    let nb = w.next();
    if w.next() != np || nb == 0 {
        return BODY_ERROR;
    }
    let nbuiltins = w.next();
    let mut builtin_calls: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for k in 0..nbuiltins {
        builtin_calls.push(w.next());
    }
    // The failure header (#2425): a `fail_only` function's record is its
    // last parameter variable.
    let nfail = w.next();
    let fail_lane = if nfail != 0 { w.next() } else { 0 };
    if nfail != 0 && np == 0 {
        return BODY_ERROR;
    }
    // The words the plan returns a small enum result as (#2581): the
    // frame must return that many registers with no result pointer.
    let returned = w.next();
    let frame_words = if sret == invalid() { result_words } else { 0 };
    if returned != frame_words {
        return DECLINED;
    }
    for k in 0..nc {
        if at64(in callees, k) == NO_CALLEE && !has_call(in builtin_calls, k) {
            return DECLINED;
        }
    }
    let record = if nfail != 0 {
        let var = Var { id: wrapping_u32(w.arg(wrapping_add(ARG_PARAMS, np))) };
        use_var(inout b, var)
    } else {
        Value { id: invalid() }
    };
    let optimize = w.arg(ARG_OPTIMIZE) != 0;
    let mut s = Body {
        optimize: optimize,
        status: w.arg(ARG_STATUS) != 0,
        locations: w.arg(ARG_LOCATIONS) != 0,
        refresh_all: false,
        blocks: ChunkSeq::new[u32](),
        locals: ChunkSeq::new[u32](),
        kinds: ChunkSeq::new[u64](),
        addresses: ChunkSeq::new[u32](),
        registers: ChunkSeq::new[u32](),
        params: ChunkSeq::new[u32](),
        values: ChunkSeq::new[u32](),
        callees: callees,
        record: record,
        fail_lane: fail_lane,
        sret: sret,
        homes: homes,
        result_words: result_words,
        entry_reads: ChunkSeq::new[u32](),
        invariant: ChunkSeq::new[u32](),
        views: ChunkSeq::new[u64](),
        nviews: 0,
        join: invalid(),
        cur_loc: NO_LOCATION,
        svar: ChunkSeq::new[u32](),
        skind: ChunkSeq::new[u64](),
        saddr: ChunkSeq::new[u32](),
        sreg: ChunkSeq::new[u64](),
        snames: ChunkSeq::new[u64](),
        sslots: ChunkSeq::new[u64](),
        hexit: ChunkSeq::new[u32](),
        hdispatch: ChunkSeq::new[u32](),
        hkind: ChunkSeq::new[u64](),
        herr: ChunkSeq::new[u64](),
        hclause: ChunkSeq::new[u64](),
        hcap_a: ChunkSeq::new[u64](),
        hcap_n: ChunkSeq::new[u64](),
        hcap_names: ChunkSeq::new[u64](),
        hcap_slots: ChunkSeq::new[u64](),
    };
    // The graph's blocks: the entry is the current block.
    s.blocks.push(current_block(inout b).id);
    for k in 1..nb {
        s.blocks.push(create_block(inout b).id);
    }
    // Locals, in name order; on the unoptimized path each one's slot.
    let nl = w.next();
    for k in 0..nl {
        let mut entry = w.next();
        let kind_word = w.next();
        s.kinds.push(kind_word & KIND_MASK);
        let mut address = invalid();
        // A local a handler names keeps its slot on the optimize path too
        // (#2657).
        let mut spilled = !optimize || (kind_word & HANDLER_HOME) != 0;
        // A local lent to a call that may fail keeps its slot on the
        // optimize path too (#2614).
        if entry >= LOCAL_HOME {
            entry = wrapping_sub(entry, LOCAL_HOME);
            spilled = true;
        }
        if entry >= LOCAL_PARAM_PRODUCT {
            // A product parameter is its storage's address: no slot.
            let p = wrapping_sub(entry, LOCAL_PARAM_PRODUCT);
            s.locals.push(wrapping_u32(w.arg(wrapping_add(wrapping_add(ARG_PARAMS, 1), p))));
            spilled = false;
        } else if entry >= LOCAL_PARAM {
            let p = wrapping_sub(entry, LOCAL_PARAM);
            s.locals.push(wrapping_u32(w.arg(wrapping_add(wrapping_add(ARG_PARAMS, 1), p))));
            if p < npointers {
                address = at32(in pointers, p);
            }
        } else if entry == LANE_PRODUCT {
            // A product local's register holds its storage's address.
            s.locals.push(zeroed(inout b, LANE_I64));
            spilled = false;
        } else {
            s.locals.push(zeroed(inout b, entry));
        }
        s.addresses.push(address);
        // A parameter with an address has no slot or register of its own.
        if spilled && address == invalid() {
            s.spill(inout b, in m, k);
        }
    }
    s.views = views;
    s.nviews = nviews;
    if !s.graph_rest(inout b, inout m, inout w, nb) {
        return BODY_ERROR;
    }
    HANDLED
}
