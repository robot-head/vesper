// @vesper/ffi-emit: the native emission of foreign (`.vsys`) calls in
// Vesper (self-hosting SH4 lane 13, #1287), the `ffi` hook of
// `vesper::codegen_swap`.
//
// `Codegen::foreign_perform` (src/ffi_lowering/native.rs) offers each call
// to the hook in steps (`codegen_swap::ffi`): BEGIN, one ARG per argument,
// REFUSE (C strings only), CALL, RESULT and FINISH (C strings only). The
// Rust code keeps what needs its own state: evaluating the arguments, the
// callee's declaration, `inout` restores, the `errno` pair and a refused
// call's `Ok` store. Everything else is emitted here, instruction for
// instruction as the Rust code emits it; the word encodings are documented
// on `codegen_swap::ffi`.

use @vesper/cranelift::{
    Block, DataId, FuncId, FuncRef, SigRef, Ty, Value, append_block_param, block_param, call_args,
    call_builder, call_conv_default, call_conv_system_v, call_module, call_op, call_result,
    call_result_value, call_return_builder, call_return_module, cc_eq, cc_ne, cc_sge, cc_ule,
    cc_ult, create_block, data_of_word, declare_function, define_function_bytes, import_data,
    import_function, ins_band_imm, ins_bor, ins_brif, ins_brif0, ins_bswap, ins_call,
    ins_call_indirect, ins_iadd, ins_iadd_imm, ins_iconst, ins_icmp, ins_icmp_imm, ins_imul_imm,
    ins_ireduce, ins_ishl_imm, ins_isub, ins_jump, ins_jump0, ins_load, ins_select, ins_sextend,
    ins_store, ins_symbol_value, ins_trapnz, ins_trapz, ins_uextend, ins_umul_overflow, inst_result,
    linkage_import, linkage_local, module_get_function, module_pointer_type, seal_block, sig_new,
    sig_param, sig_return, switch_to_block, trap_user, ty_f32, ty_f64, ty_i16, ty_i32, ty_i64,
    ty_i8, value_of_word, value_word, block_word
};
use @vesper/codegen-base::{alloc};

// The answer of a hook (`codegen_swap`).
const HANDLED: u64 = 1;
const DECLINED: u64 = 0;

// The `ffi` requests (`codegen_swap::ffi`).
const BEGIN: u32 = 1;
const ARG: u32 = 2;
const REFUSE: u32 = 3;
const CALL: u32 = 4;
const RESULT: u32 = 5;
const FINISH: u32 = 6;
const CALL_INDIRECT: u32 = 7;
const ISOLATE: u32 = 8;

// `codegen_swap::NO_VALUE`.
const NO_VALUE: u64 = 18446744073709551615;

// Handlers (BEGIN).
const DIRECT: u64 = 0;

// Source kinds (ARG).
const SOURCE_SCALAR: u64 = 0;

// Parameter kinds (ARG).
const KIND_VALUE: u64 = 0;
const KIND_HANDLE: u64 = 1;
const KIND_CSTR: u64 = 2;
const KIND_POINTER: u64 = 3;
const KIND_SLICE: u64 = 4;
const KIND_LENT: u64 = 5;
const KIND_BUFFER: u64 = 6;
const KIND_CSTRLIST: u64 = 7;
const KIND_CWSTR: u64 = 8;

// Value types `V`.
const V_UNIT: u64 = 0;
const V_SCALAR: u64 = 1;
const V_BOOL: u64 = 2;
const V_ENUM: u64 = 3;
const V_HANDLE: u64 = 5;
const V_NONNULL: u64 = 6;
const V_FLOAT: u64 = 7;
const V_CSTR: u64 = 8;
const V_CWSTR: u64 = 9;

// Wire field kinds of `W`.
const F_INTEGER: u64 = 0;
const F_BYTES: u64 = 1;
const F_PADDING: u64 = 2;
const F_STRUCT: u64 = 3;

// Pointees `P`.
const P_SCALAR: u64 = 0;

// Copy-back shapes.
const SHAPE_SCALAR: u64 = 0;
const SHAPE_STRUCT: u64 = 1;
const SHAPE_SLICE: u64 = 2;

// Wire integer byte orders.
const ENDIAN_NATIVE: u64 = 0;
const ENDIAN_LITTLE: u64 = 1;

// `errno` readers (CALL).
const ERRNO_LOCATION: u64 = 1;
const ERRNO_ERROR: u64 = 2;

// `ffi::NULL_HANDLE_TRAP`, `ffi::CSTR_ALLOC_TRAP` and `ffi::MAPPING_ALLOC_TRAP`.
const ISOLATION_TRAP: u32 = 5;
const NULL_HANDLE_TRAP: u32 = 6;
const CSTR_ALLOC_TRAP: u32 = 7;
const MAPPING_ALLOC_TRAP: u32 = 8;

// `MemFlags::new()`.
const PLAIN: u32 = 0;
// Scalar words: `bits | signed << 8`.
const SIGNED_BIT: u64 = 256;
const BITS_MASK: u64 = 255;
const WORD_BITS: u64 = 64;
const BYTE_BITS: u64 = 8;

// ---------------------------------------------------------------------------
// Request words.

struct R {
    words: ChunkSeq[u64],
    pos: u64,
}

fn next(inout cursor: R) -> u64 {
    let word = cursor.words.try_get(cursor.pos).unwrap_or(0);
    cursor.pos = wrapping_add(cursor.pos, 1);
    word
}

fn at(in cursor: R, i: u64) -> u64 {
    cursor.words.try_get(i).unwrap_or(0)
}

fn val(word: u64) -> Value {
    value_of_word(word)
}

fn imm(word: u64) -> i64 {
    wrapping_i64(word)
}

fn off(word: u64) -> i32 {
    wrapping_i32(word)
}

fn bits_of(scalar_word: u64) -> u64 {
    scalar_word & BITS_MASK
}

fn signed_of(scalar_word: u64) -> bool {
    (scalar_word & SIGNED_BIT) != 0
}

// ---------------------------------------------------------------------------
// The small helpers of src/ffi_lowering/native.rs.

fn c_type(bits: u64) -> Ty {
    if bits == 8 {
        ty_i8()
    } else if bits == 16 {
        ty_i16()
    } else if bits == 32 {
        ty_i32()
    } else {
        ty_i64()
    }
}

fn narrow(inout builder: Builder, value: Value, bits: u64) -> Value eff [Ffi[Cranelift]] {
    if bits == WORD_BITS {
        value
    } else {
        ins_ireduce(inout builder, c_type(bits), value)
    }
}

fn widen(
    inout builder: Builder,
    value: Value,
    bits: u64,
    signed: bool
) -> Value eff [Ffi[Cranelift]] {
    if bits == WORD_BITS {
        value
    } else if signed {
        ins_sextend(inout builder, ty_i64(), value)
    } else {
        ins_uextend(inout builder, ty_i64(), value)
    }
}

// `foreign_word`: a scalar source, or the word at a source address.
fn source_word(inout builder: Builder, kind: u64, source: Value) -> Value eff [Ffi[Cranelift]] {
    if kind == SOURCE_SCALAR {
        source
    } else {
        ins_load(inout builder, ty_i64(), PLAIN, source, 0)
    }
}

fn guard(inout builder: Builder, flag: u64, value: Value, ty: Ty) -> Value eff [Ffi[Cranelift]] {
    if flag == NO_VALUE {
        value
    } else {
        let zero = ins_iconst(inout builder, ty, 0);
        ins_select(inout builder, val(flag), value, zero)
    }
}

fn swap(
    inout builder: Builder,
    value: Value,
    int_word: u64,
    endian: u64,
    little: bool
) -> Value eff [Ffi[Cranelift]] {
    let swapped = if endian == ENDIAN_NATIVE {
        false
    } else if endian == ENDIAN_LITTLE {
        !little
    } else {
        little
    };
    if swapped && bits_of(int_word) > BYTE_BITS {
        ins_bswap(inout builder, value)
    } else {
        value
    }
}

// A C library function of 64-bit word parameters (`foreign_libc`).
fn libc(
    inout builder: Builder,
    inout module: Module,
    which: u32,
    params: u64,
    returns: bool
) -> FuncRef eff [Ffi[Cranelift]] {
    let sig = sig_new(inout module, call_conv_default());
    for _ in 0..params {
        sig_param(inout module, sig, ty_i64());
    }
    if returns {
        sig_return(inout module, sig, ty_i64());
    }
    let id = if which == 0 {
        declare_function(inout module, in "malloc".as_bytes(), linkage_import(), sig)
    } else if which == 1 {
        declare_function(inout module, in "memcpy".as_bytes(), linkage_import(), sig)
    } else if which == 2 {
        declare_function(inout module, in "memchr".as_bytes(), linkage_import(), sig)
    } else if which == 3 {
        declare_function(inout module, in "free".as_bytes(), linkage_import(), sig)
    } else {
        declare_function(inout module, in "strlen".as_bytes(), linkage_import(), sig)
    };
    import_function(inout builder, inout module, id)
}

const MALLOC: u32 = 0;
const MEMCPY: u32 = 1;
const MEMCHR: u32 = 2;
const FREE: u32 = 3;
const STRLEN: u32 = 4;

fn call1(inout builder: Builder, func: FuncRef, arg: Value) -> u32 eff [Ffi[Cranelift]] {
    let mut args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](1);
    args.push(wrapping_u32(value_word(arg)));
    ins_call(inout builder, func, in args.as_slice())
}

fn call2(
    inout builder: Builder,
    func: FuncRef,
    first: Value,
    second: Value
) -> u32 eff [Ffi[Cranelift]] {
    let mut args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](2);
    args.push(wrapping_u32(value_word(first)));
    args.push(wrapping_u32(value_word(second)));
    ins_call(inout builder, func, in args.as_slice())
}

fn call3(
    inout builder: Builder,
    func: FuncRef,
    first: Value,
    second: Value,
    third: Value
) -> u32 eff [Ffi[Cranelift]] {
    let mut args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](3);
    args.push(wrapping_u32(value_word(first)));
    args.push(wrapping_u32(value_word(second)));
    args.push(wrapping_u32(value_word(third)));
    ins_call(inout builder, func, in args.as_slice())
}

// `foreign_view`: a source `Slice` view's `(data + start * stride, len)`.
fn view(
    inout builder: Builder,
    in module: Module,
    value: Value,
    stride: u64,
    inout out: ChunkSeq[u64]
) eff [Ffi[Cranelift]] {
    let owner = ins_load(inout builder, ty_i64(), PLAIN, value, 0);
    let start = ins_load(inout builder, ty_i64(), PLAIN, value, 8);
    let len = ins_load(inout builder, ty_i64(), PLAIN, value, 16);
    let data = ins_load(inout builder, ty_i64(), PLAIN, owner, 16);
    let offset = ins_imul_imm(inout builder, start, imm(stride));
    let lent = ins_iadd(inout builder, data, offset);
    let dummy = alloc(inout builder, in module, 8, true);
    let empty = ins_icmp_imm(inout builder, cc_eq(), data, 0);
    let pointer = ins_select(inout builder, empty, dummy, lent);
    out.push(value_word(pointer));
    out.push(value_word(len));
}

// `foreign_cstr`: a NUL-terminated `malloc` copy and the first NUL's offset.
fn cstr(
    inout builder: Builder,
    inout module: Module,
    data: Value,
    len: Value,
    inout out: ChunkSeq[u64]
) eff [Ffi[Cranelift]] {
    let malloc = libc(inout builder, inout module, MALLOC, 1, true);
    let memcpy = libc(inout builder, inout module, MEMCPY, 3, true);
    let memchr = libc(inout builder, inout module, MEMCHR, 3, true);
    let size = ins_iadd_imm(inout builder, len, 1);
    call1(inout builder, malloc, size);
    let buffer = inst_result(inout builder, 0);
    ins_trapz(inout builder, buffer, trap_user(CSTR_ALLOC_TRAP));
    call3(inout builder, memcpy, buffer, data, len);
    let end = ins_iadd(inout builder, buffer, len);
    let nul = ins_iconst(inout builder, ty_i8(), 0);
    ins_store(inout builder, PLAIN, nul, end, 0);
    let zero = ins_iconst(inout builder, ty_i64(), 0);
    call3(inout builder, memchr, data, zero, len);
    let found = inst_result(inout builder, 0);
    let missing = ins_icmp_imm(inout builder, cc_eq(), found, 0);
    let pos = ins_isub(inout builder, found, data);
    let none = ins_iconst(inout builder, ty_i64(), -1);
    let nul_at = ins_select(inout builder, missing, none, pos);
    out.push(value_word(buffer));
    out.push(value_word(nul_at));
}

fn cwstr(
    inout builder: Builder,
    inout module: Module,
    data: Value,
    len: Value,
    inout out: ChunkSeq[u64]
) eff [Ffi[Cranelift]] {
    let malloc = libc(inout builder, inout module, MALLOC, 1, true);
    let memcpy = libc(inout builder, inout module, MEMCPY, 3, true);
    let bytes = ins_ishl_imm(inout builder, len, 1);
    let size = ins_iadd_imm(inout builder, bytes, 2);
    call1(inout builder, malloc, size);
    let buffer = inst_result(inout builder, 0);
    ins_trapz(inout builder, buffer, trap_user(CSTR_ALLOC_TRAP));
    call3(inout builder, memcpy, buffer, data, bytes);
    let end = ins_iadd(inout builder, buffer, bytes);
    let nul = ins_iconst(inout builder, ty_i16(), 0);
    ins_store(inout builder, PLAIN, nul, end, 0);

    let loop_blk = create_block(inout builder);
    let check_blk = create_block(inout builder);
    let step_blk = create_block(inout builder);
    let done_blk = create_block(inout builder);
    append_block_param(inout builder, loop_blk, ty_i64());
    append_block_param(inout builder, done_blk, ty_i64());
    let zero = ins_iconst(inout builder, ty_i64(), 0);
    let none = ins_iconst(inout builder, ty_i64(), -1);
    let mut init_args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](1);
    init_args.push(wrapping_u32(value_word(zero)));
    ins_jump(inout builder, loop_blk, in init_args.as_slice());

    switch_to_block(inout builder, loop_blk);
    let index = block_param(inout builder, loop_blk, 0);
    let more = ins_icmp(inout builder, cc_ult(), index, len);
    let mut none_args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](1);
    none_args.push(wrapping_u32(value_word(none)));
    let no_args: ChunkSeq[u32] = ChunkSeq::new[u32]();
    ins_brif(
        inout builder,
        more,
        check_blk,
        in no_args.as_slice(),
        done_blk,
        in none_args.as_slice()
    );

    switch_to_block(inout builder, check_blk);
    seal_block(inout builder, check_blk);
    let byte_off = ins_ishl_imm(inout builder, index, 1);
    let ptr = ins_iadd(inout builder, buffer, byte_off);
    let unit = ins_load(inout builder, ty_i16(), PLAIN, ptr, 0);
    let is_nul = ins_icmp_imm(inout builder, cc_eq(), unit, 0);
    let mut found_args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](1);
    found_args.push(wrapping_u32(value_word(index)));
    ins_brif(
        inout builder,
        is_nul,
        done_blk,
        in found_args.as_slice(),
        step_blk,
        in no_args.as_slice()
    );

    switch_to_block(inout builder, step_blk);
    seal_block(inout builder, step_blk);
    let next = ins_iadd_imm(inout builder, index, 1);
    let mut next_args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](1);
    next_args.push(wrapping_u32(value_word(next)));
    ins_jump(inout builder, loop_blk, in next_args.as_slice());

    switch_to_block(inout builder, done_blk);
    seal_block(inout builder, loop_blk);
    seal_block(inout builder, done_blk);
    out.push(value_word(buffer));
    out.push(value_word(block_param(inout builder, done_blk, 0)));
}

fn cstr_list_walk(
    inout builder: Builder,
    inout module: Module,
    buffer: Value,
    len: Value,
    has_array: bool,
    array: Value
) -> Value eff [Ffi[Cranelift]] {
    let memchr = libc(inout builder, inout module, MEMCHR, 3, true);
    let walk = create_block(inout builder);
    let body = create_block(inout builder);
    let done = create_block(inout builder);
    for _ in 0..2 {
        append_block_param(inout builder, walk, ty_i64());
        append_block_param(inout builder, body, ty_i64());
    }
    append_block_param(inout builder, done, ty_i64());
    let zero = ins_iconst(inout builder, ty_i64(), 0);
    let mut init: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](2);
    init.push(wrapping_u32(value_word(zero)));
    init.push(wrapping_u32(value_word(zero)));
    ins_jump(inout builder, walk, in init.as_slice());
    switch_to_block(inout builder, walk);
    let walk_start = block_param(inout builder, walk, 0);
    let walk_count = block_param(inout builder, walk, 1);
    let more = ins_icmp(inout builder, cc_ult(), walk_start, len);
    let mut yes_args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](2);
    yes_args.push(wrapping_u32(value_word(walk_start)));
    yes_args.push(wrapping_u32(value_word(walk_count)));
    let mut no_args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](1);
    no_args.push(wrapping_u32(value_word(walk_count)));
    ins_brif(inout builder, more, body, in yes_args.as_slice(), done, in no_args.as_slice());
    switch_to_block(inout builder, body);
    seal_block(inout builder, body);
    let body_start = block_param(inout builder, body, 0);
    let body_count = block_param(inout builder, body, 1);
    let here = ins_iadd(inout builder, buffer, body_start);
    if has_array {
        let slot = ins_imul_imm(inout builder, body_count, 8);
        let slot = ins_iadd(inout builder, array, slot);
        ins_store(inout builder, PLAIN, here, slot, 0);
    }
    let rest = ins_isub(inout builder, len, body_start);
    let rest = ins_iadd_imm(inout builder, rest, 1);
    call3(inout builder, memchr, here, zero, rest);
    let found = inst_result(inout builder, 0);
    let end = ins_isub(inout builder, found, buffer);
    let next_start = ins_iadd_imm(inout builder, end, 1);
    let next_count = ins_iadd_imm(inout builder, body_count, 1);
    let mut back_args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](2);
    back_args.push(wrapping_u32(value_word(next_start)));
    back_args.push(wrapping_u32(value_word(next_count)));
    ins_jump(inout builder, walk, in back_args.as_slice());
    seal_block(inout builder, walk);
    switch_to_block(inout builder, done);
    seal_block(inout builder, done);
    block_param(inout builder, done, 0)
}

fn cstr_list(
    inout builder: Builder,
    inout module: Module,
    data: Value,
    len: Value,
    inout reply: Answer
) eff [Ffi[Cranelift]] {
    let malloc = libc(inout builder, inout module, MALLOC, 1, true);
    let memcpy = libc(inout builder, inout module, MEMCPY, 3, true);
    let size = ins_iadd_imm(inout builder, len, 1);
    call1(inout builder, malloc, size);
    let buffer = inst_result(inout builder, 0);
    ins_trapz(inout builder, buffer, trap_user(CSTR_ALLOC_TRAP));
    call3(inout builder, memcpy, buffer, data, len);
    let end = ins_iadd(inout builder, buffer, len);
    let nul = ins_iconst(inout builder, ty_i8(), 0);
    ins_store(inout builder, PLAIN, nul, end, 0);
    let count = cstr_list_walk(inout builder, inout module, buffer, len, false, buffer);
    let slots = ins_iadd_imm(inout builder, count, 1);
    let bytes = ins_imul_imm(inout builder, slots, 8);
    call1(inout builder, malloc, bytes);
    let array = inst_result(inout builder, 0);
    ins_trapz(inout builder, array, trap_user(CSTR_ALLOC_TRAP));
    let count = cstr_list_walk(inout builder, inout module, buffer, len, true, array);
    let slot = ins_imul_imm(inout builder, count, 8);
    let slot = ins_iadd(inout builder, array, slot);
    let zero = ins_iconst(inout builder, ty_i64(), 0);
    ins_store(inout builder, PLAIN, zero, slot, 0);
    reply.c.push(value_word(array));
    reply.text.push(value_word(buffer));
    reply.text.push(value_word(array));
}

fn foreign_mapping(
    inout builder: Builder,
    inout module: Module,
    address: Value,
    raw_len: Value,
    len_i64: bool,
    stride: u64,
    reg_id: u64
) -> Value eff [Ffi[Cranelift]] {
    let len = if len_i64 {
        raw_len
    } else {
        ins_uextend(inout builder, ty_i64(), raw_len)
    };
    let null = ins_icmp_imm(inout builder, cc_eq(), address, 0);
    let failed = ins_icmp_imm(inout builder, cc_eq(), address, -1);
    let absent = ins_bor(inout builder, null, failed);
    let make = create_block(inout builder);
    let join = create_block(inout builder);
    append_block_param(inout builder, join, ty_i64());
    let zero = ins_iconst(inout builder, ty_i64(), 0);
    let mut yes_args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](1);
    yes_args.push(wrapping_u32(value_word(zero)));
    let no_args: ChunkSeq[u32] = ChunkSeq::new[u32]();
    ins_brif(inout builder, absent, join, in yes_args.as_slice(), make, in no_args.as_slice());
    switch_to_block(inout builder, make);
    seal_block(inout builder, make);
    let bytes = if stride > 1 {
        let stride_value = ins_iconst(inout builder, ty_i64(), imm(stride));
        let prod = ins_umul_overflow(inout builder, len, stride_value);
        let overflow = inst_result(inout builder, 1);
        ins_trapnz(inout builder, overflow, trap_user(MAPPING_ALLOC_TRAP));
        prod
    } else {
        len
    };
    let reg_fn = import_function(inout builder, inout module, FuncId { id: wrapping_u32(reg_id) });
    let align = ins_iconst(inout builder, ty_i64(), imm(stride));
    call3(inout builder, reg_fn, address, bytes, align);
    let malloc = libc(inout builder, inout module, MALLOC, 1, true);
    let size = ins_iconst(inout builder, ty_i64(), 24);
    call1(inout builder, malloc, size);
    let header = inst_result(inout builder, 0);
    ins_trapz(inout builder, header, trap_user(MAPPING_ALLOC_TRAP));
    ins_store(inout builder, PLAIN, len, header, 0);
    ins_store(inout builder, PLAIN, len, header, 8);
    ins_store(inout builder, PLAIN, address, header, 16);
    let mut jmp_args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](1);
    jmp_args.push(wrapping_u32(value_word(header)));
    ins_jump(inout builder, join, in jmp_args.as_slice());
    switch_to_block(inout builder, join);
    seal_block(inout builder, join);
    block_param(inout builder, join, 0)
}

fn foreign_cstr_copy(
    inout builder: Builder,
    inout module: Module,
    address: Value,
    jit: bool
) -> Value eff [Ffi[Cranelift]] {
    let copy = create_block(inout builder);
    let join = create_block(inout builder);
    append_block_param(inout builder, join, ty_i64());
    let zero = ins_iconst(inout builder, ty_i64(), 0);
    let null = ins_icmp_imm(inout builder, cc_eq(), address, 0);
    let mut yes_args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](1);
    yes_args.push(wrapping_u32(value_word(zero)));
    let no_args: ChunkSeq[u32] = ChunkSeq::new[u32]();
    ins_brif(inout builder, null, join, in yes_args.as_slice(), copy, in no_args.as_slice());
    switch_to_block(inout builder, copy);
    seal_block(inout builder, copy);
    let strlen = libc(inout builder, inout module, STRLEN, 1, true);
    let memcpy = libc(inout builder, inout module, MEMCPY, 3, true);
    call1(inout builder, strlen, address);
    let len = inst_result(inout builder, 0);
    let cap = ins_iadd_imm(inout builder, len, 1);
    let stride = ins_iconst(inout builder, ty_i64(), 1);
    let sig = sig_new(inout module, call_conv_default());
    sig_param(inout module, sig, ty_i64());
    sig_param(inout module, sig, ty_i64());
    sig_return(inout module, sig, ty_i64());
    let linkage = if jit {
        linkage_import()
    } else {
        linkage_local()
    };
    let seq_id = declare_function(inout module, in "vesper_seq_make".as_bytes(), linkage, sig);
    let seq_make = import_function(inout builder, inout module, seq_id);
    call2(inout builder, seq_make, cap, stride);
    let header = inst_result(inout builder, 0);
    let data = ins_load(inout builder, ty_i64(), PLAIN, header, 16);
    call3(inout builder, memcpy, data, address, len);
    ins_store(inout builder, PLAIN, len, header, 0);
    let mut jmp_args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](1);
    jmp_args.push(wrapping_u32(value_word(header)));
    ins_jump(inout builder, join, in jmp_args.as_slice());
    switch_to_block(inout builder, join);
    seal_block(inout builder, join);
    block_param(inout builder, join, 0)
}

fn foreign_cwstr_copy(
    inout builder: Builder,
    inout module: Module,
    address: Value,
    jit: bool
) -> Value eff [Ffi[Cranelift]] {
    let scan = create_block(inout builder);
    let step = create_block(inout builder);
    let copy = create_block(inout builder);
    let join = create_block(inout builder);
    append_block_param(inout builder, scan, ty_i64());
    append_block_param(inout builder, join, ty_i64());
    let zero = ins_iconst(inout builder, ty_i64(), 0);
    let null = ins_icmp_imm(inout builder, cc_eq(), address, 0);
    let mut zero_args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](1);
    zero_args.push(wrapping_u32(value_word(zero)));
    ins_brif(inout builder, null, join, in zero_args.as_slice(), scan, in zero_args.as_slice());

    switch_to_block(inout builder, scan);
    let len = block_param(inout builder, scan, 0);
    let byte_off = ins_ishl_imm(inout builder, len, 1);
    let ptr = ins_iadd(inout builder, address, byte_off);
    let unit = ins_load(inout builder, ty_i16(), PLAIN, ptr, 0);
    let is_nul = ins_icmp_imm(inout builder, cc_eq(), unit, 0);
    let no_args: ChunkSeq[u32] = ChunkSeq::new[u32]();
    ins_brif(inout builder, is_nul, copy, in no_args.as_slice(), step, in no_args.as_slice());

    switch_to_block(inout builder, step);
    seal_block(inout builder, step);
    let next_len = ins_iadd_imm(inout builder, len, 1);
    let mut next_args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](1);
    next_args.push(wrapping_u32(value_word(next_len)));
    ins_jump(inout builder, scan, in next_args.as_slice());

    switch_to_block(inout builder, copy);
    seal_block(inout builder, scan);
    seal_block(inout builder, copy);
    let cap = ins_iadd_imm(inout builder, len, 1);
    let stride = ins_iconst(inout builder, ty_i64(), 2);
    let sig = sig_new(inout module, call_conv_default());
    sig_param(inout module, sig, ty_i64());
    sig_param(inout module, sig, ty_i64());
    sig_return(inout module, sig, ty_i64());
    let linkage = if jit {
        linkage_import()
    } else {
        linkage_local()
    };
    let seq_id = declare_function(inout module, in "vesper_seq_make".as_bytes(), linkage, sig);
    let seq_make = import_function(inout builder, inout module, seq_id);
    call2(inout builder, seq_make, cap, stride);
    let header = inst_result(inout builder, 0);
    let data = ins_load(inout builder, ty_i64(), PLAIN, header, 16);
    let bytes = ins_ishl_imm(inout builder, len, 1);
    let memcpy = libc(inout builder, inout module, MEMCPY, 3, true);
    call3(inout builder, memcpy, data, address, bytes);
    ins_store(inout builder, PLAIN, len, header, 0);
    let mut jmp_args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](1);
    jmp_args.push(wrapping_u32(value_word(header)));
    ins_jump(inout builder, join, in jmp_args.as_slice());

    switch_to_block(inout builder, join);
    seal_block(inout builder, join);
    block_param(inout builder, join, 0)
}

// ---------------------------------------------------------------------------
// Wire structs (`W` at the reader's position).

// Whether `W` is already its source layout: only 64-bit native-endian
// integers, in order, without padding or nesting (`identical_struct`).
fn identical_struct(in cursor: R, start: u64, little: bool) -> bool {
    let field_count = at(in cursor, wrapping_add(start, 1));
    let mut pos = wrapping_add(start, 2);
    for k in 0..field_count {
        if at(in cursor, pos) != F_INTEGER {
            return false;
        }
        let offset = at(in cursor, wrapping_add(pos, 1));
        let int_word = at(in cursor, wrapping_add(pos, 2));
        let endian = at(in cursor, wrapping_add(pos, 3));
        let native_order = if endian == ENDIAN_NATIVE {
            true
        } else if endian == ENDIAN_LITTLE {
            little
        } else {
            !little
        };
        if bits_of(int_word) != WORD_BITS || offset != wrapping_mul(8, k) || !native_order {
            return false;
        }
        pos = wrapping_add(pos, 5);
    }
    true
}

// Skip one `W` (returns the position after it).
fn skip_wire(in cursor: R, start: u64) -> u64 {
    let field_count = at(in cursor, wrapping_add(start, 1));
    let mut pos = wrapping_add(start, 2);
    for _ in 0..field_count {
        let kind = at(in cursor, pos);
        if kind == F_INTEGER {
            pos = wrapping_add(pos, 5);
        } else if kind == F_BYTES {
            pos = wrapping_add(pos, wrapping_add(3, at(in cursor, wrapping_add(pos, 2))));
        } else if kind == F_PADDING {
            pos = wrapping_add(pos, 2);
        } else {
            pos = skip_wire(in cursor, wrapping_add(pos, 3));
        }
    }
    pos
}

// `foreign_write_struct`: the source struct at `native` into the C buffer
// at `base`.
fn write_struct(
    inout builder: Builder,
    in cursor: R,
    start: u64,
    native: Value,
    buffer: Value,
    base: u64,
    little: bool
) eff [Ffi[Cranelift]] {
    let field_count = at(in cursor, wrapping_add(start, 1));
    let mut pos = wrapping_add(start, 2);
    for _ in 0..field_count {
        let kind = at(in cursor, pos);
        let offset = at(in cursor, wrapping_add(pos, 1));
        let to = wrapping_add(base, offset);
        if kind == F_INTEGER {
            let int_word = at(in cursor, wrapping_add(pos, 2));
            let endian = at(in cursor, wrapping_add(pos, 3));
            let from = at(in cursor, wrapping_add(pos, 4));
            let value = ins_load(inout builder, ty_i64(), PLAIN, native, off(from));
            let value = narrow(inout builder, value, bits_of(int_word));
            let value = swap(inout builder, value, int_word, endian, little);
            ins_store(inout builder, PLAIN, value, buffer, off(to));
            pos = wrapping_add(pos, 5);
        } else if kind == F_BYTES {
            let count = at(in cursor, wrapping_add(pos, 2));
            for j in 0..count {
                let from = at(in cursor, wrapping_add(pos, wrapping_add(3, j)));
                let value = ins_load(inout builder, ty_i64(), PLAIN, native, off(from));
                let value = ins_ireduce(inout builder, ty_i8(), value);
                ins_store(inout builder, PLAIN, value, buffer, off(wrapping_add(to, j)));
            }
            pos = wrapping_add(pos, wrapping_add(3, count));
        } else if kind == F_PADDING {
            pos = wrapping_add(pos, 2);
        } else {
            let from = at(in cursor, wrapping_add(pos, 2));
            let field_ptr = ins_iadd_imm(inout builder, native, imm(from));
            let inner = wrapping_add(pos, 3);
            write_struct(inout builder, in cursor, inner, field_ptr, buffer, to, little);
            pos = skip_wire(in cursor, inner);
        }
    }
}

// `foreign_read_struct`: the C buffer at `base` back into the source
// struct at `native`.
fn read_struct(
    inout builder: Builder,
    in cursor: R,
    start: u64,
    buffer: Value,
    base: u64,
    native: Value,
    little: bool
) eff [Ffi[Cranelift]] {
    let field_count = at(in cursor, wrapping_add(start, 1));
    let mut pos = wrapping_add(start, 2);
    for _ in 0..field_count {
        let kind = at(in cursor, pos);
        let offset = at(in cursor, wrapping_add(pos, 1));
        let from = wrapping_add(base, offset);
        if kind == F_INTEGER {
            let int_word = at(in cursor, wrapping_add(pos, 2));
            let endian = at(in cursor, wrapping_add(pos, 3));
            let to = at(in cursor, wrapping_add(pos, 4));
            let bits = bits_of(int_word);
            let value = ins_load(inout builder, c_type(bits), PLAIN, buffer, off(from));
            let value = swap(inout builder, value, int_word, endian, little);
            let value = widen(inout builder, value, bits, signed_of(int_word));
            ins_store(inout builder, PLAIN, value, native, off(to));
            pos = wrapping_add(pos, 5);
        } else if kind == F_BYTES {
            let count = at(in cursor, wrapping_add(pos, 2));
            for j in 0..count {
                let to = at(in cursor, wrapping_add(pos, wrapping_add(3, j)));
                let value = ins_load(
                    inout builder,
                    ty_i8(),
                    PLAIN,
                    buffer,
                    off(wrapping_add(from, j))
                );
                let value = ins_uextend(inout builder, ty_i64(), value);
                ins_store(inout builder, PLAIN, value, native, off(to));
            }
            pos = wrapping_add(pos, wrapping_add(3, count));
        } else if kind == F_PADDING {
            pos = wrapping_add(pos, 2);
        } else {
            let to = at(in cursor, wrapping_add(pos, 2));
            let field_ptr = ins_iadd_imm(inout builder, native, imm(to));
            let inner = wrapping_add(pos, 3);
            read_struct(inout builder, in cursor, inner, buffer, from, field_ptr, little);
            pos = skip_wire(in cursor, inner);
        }
    }
}

// The C size of pointee `P` at `start`.
fn pointee_size(in cursor: R, start: u64) -> u64 {
    if at(in cursor, start) == P_SCALAR {
        bits_of(at(in cursor, wrapping_add(start, 1))) / BYTE_BITS
    } else {
        at(in cursor, wrapping_add(start, 1))
    }
}

fn identical_pointee(in cursor: R, start: u64, little: bool) -> bool {
    if at(in cursor, start) == P_SCALAR {
        bits_of(at(in cursor, wrapping_add(start, 1))) == WORD_BITS
    } else {
        identical_struct(in cursor, wrapping_add(start, 1), little)
    }
}

fn skip_pointee(in cursor: R, start: u64) -> u64 {
    if at(in cursor, start) == P_SCALAR {
        wrapping_add(start, 2)
    } else {
        skip_wire(in cursor, wrapping_add(start, 1))
    }
}

// `foreign_write_slice`: `n` elements at the source offsets that follow
// pointee `P` at `pointee`.
fn write_slice(
    inout builder: Builder,
    in cursor: R,
    pointee: u64,
    offsets: u64,
    n: u64,
    native: Value,
    buffer: Value,
    little: bool
) eff [Ffi[Cranelift]] {
    let size = pointee_size(in cursor, pointee);
    for k in 0..n {
        let to = wrapping_mul(k, size);
        let from = at(in cursor, wrapping_add(offsets, k));
        if at(in cursor, pointee) == P_SCALAR {
            let value = ins_load(inout builder, ty_i64(), PLAIN, native, off(from));
            let value = narrow(
                inout builder,
                value,
                bits_of(at(in cursor, wrapping_add(pointee, 1)))
            );
            ins_store(inout builder, PLAIN, value, buffer, off(to));
        } else {
            let inner = ins_iadd_imm(inout builder, native, imm(from));
            write_struct(
                inout builder,
                in cursor,
                wrapping_add(pointee, 1),
                inner,
                buffer,
                to,
                little
            );
        }
    }
}

fn read_slice(
    inout builder: Builder,
    in cursor: R,
    pointee: u64,
    offsets: u64,
    n: u64,
    buffer: Value,
    native: Value,
    little: bool
) eff [Ffi[Cranelift]] {
    let size = pointee_size(in cursor, pointee);
    for k in 0..n {
        let from = wrapping_mul(k, size);
        let to = at(in cursor, wrapping_add(offsets, k));
        if at(in cursor, pointee) == P_SCALAR {
            let scalar_word = at(in cursor, wrapping_add(pointee, 1));
            let value = ins_load(
                inout builder,
                c_type(bits_of(scalar_word)),
                PLAIN,
                buffer,
                off(from)
            );
            let value = widen(inout builder, value, bits_of(scalar_word), signed_of(scalar_word));
            ins_store(inout builder, PLAIN, value, native, off(to));
        } else {
            let inner = ins_iadd_imm(inout builder, native, imm(to));
            read_struct(
                inout builder,
                in cursor,
                wrapping_add(pointee, 1),
                buffer,
                from,
                inner,
                little
            );
        }
    }
}

// Copy words `[from, to)` of the request into `out`.
fn copy_words(in cursor: R, from: u64, to: u64, inout out: ChunkSeq[u64]) {
    for i in from..to {
        out.push(at(in cursor, i));
    }
}

// ---------------------------------------------------------------------------
// ARG: one argument.

// The C arguments, then the copy-back record and C string words, as ARG
// answers them.
struct Answer {
    c: ChunkSeq[u64],
    back: ChunkSeq[u64],
    text: ChunkSeq[u64],
}

fn answer(call: u64, in reply: Answer) eff [Ffi[Cranelift]] {
    call_result(call, reply.c.len());
    for i in 0..reply.c.len() {
        call_result(call, word_at(in reply.c, i));
    }
    call_result(call, reply.back.len());
    for i in 0..reply.back.len() {
        call_result(call, word_at(in reply.back, i));
    }
    call_result(call, reply.text.len());
    for i in 0..reply.text.len() {
        call_result(call, word_at(in reply.text, i));
    }
}

fn word_at(in seq: ChunkSeq[u64], i: u64) -> u64 {
    seq.try_get(i).unwrap_or(0)
}

// `foreign_value` of value type `V` at the reader.
fn value_arg(
    inout builder: Builder,
    inout cursor: R,
    kind: u64,
    source: Value
) -> Value eff [Ffi[Cranelift]] {
    let value_tag = next(inout cursor);
    if value_tag == V_SCALAR {
        let scalar_word = next(inout cursor);
        let word = source_word(inout builder, kind, source);
        narrow(inout builder, word, bits_of(scalar_word))
    } else if value_tag == V_BOOL {
        let word = source_word(inout builder, kind, source);
        ins_ireduce(inout builder, ty_i8(), word)
    } else if value_tag == V_FLOAT {
        let bits = next(inout cursor);
        if kind == SOURCE_SCALAR {
            source
        } else {
            ins_load(inout builder, if bits == 32 { ty_f32() } else { ty_f64() }, PLAIN, source, 0)
        }
    } else {
        // An enum (the Rust code checked that its source is in memory).
        let scalar_word = next(inout cursor);
        let variant_count = next(inout cursor);
        let tag = ins_load(inout builder, ty_i64(), PLAIN, source, 0);
        let first = if variant_count > 0 {
            at(in cursor, cursor.pos)
        } else {
            0
        };
        let mut value = ins_iconst(inout builder, ty_i64(), imm(first));
        for i in 1..variant_count {
            let hit = ins_icmp_imm(inout builder, cc_eq(), tag, imm(i));
            let candidate = ins_iconst(
                inout builder,
                ty_i64(),
                imm(at(in cursor, wrapping_add(cursor.pos, i)))
            );
            value = ins_select(inout builder, hit, candidate, value);
        }
        cursor.pos = wrapping_add(cursor.pos, variant_count);
        narrow(inout builder, value, bits_of(scalar_word))
    }
}

// `foreign_option`: the `Some` payload address and the presence flag.
fn option(
    inout builder: Builder,
    nullable: bool,
    some: u64,
    offset: u64,
    source: Value,
    inout out: ChunkSeq[u64]
) eff [Ffi[Cranelift]] {
    if !nullable {
        out.push(NO_VALUE);
        out.push(value_word(source));
        return;
    }
    let tag = ins_load(inout builder, ty_i64(), PLAIN, source, 0);
    let is_some = ins_icmp_imm(inout builder, cc_eq(), tag, imm(some));
    let payload = ins_iadd_imm(inout builder, source, imm(offset));
    out.push(value_word(is_some));
    out.push(value_word(payload));
}

fn arg(call: u64, inout builder: Builder, inout module: Module) -> u64 eff [Ffi[Cranelift]] {
    let mut cursor = R {
        words: call_args(call),
        pos: 0,
    };
    let _index = next(inout cursor);
    let source_kind = next(inout cursor);
    let source = val(next(inout cursor));
    let little = next(inout cursor) == 1;
    let kind = next(inout cursor);
    let pointer = module_pointer_type(in module);
    let mut reply = Answer {
        c: ChunkSeq::new[u64](),
        back: ChunkSeq::new[u64](),
        text: ChunkSeq::new[u64](),
    };
    if kind == KIND_CSTR {
        let mut lent: ChunkSeq[u64] = ChunkSeq::new[u64]();
        view(inout builder, in module, source, 1, inout lent);
        cstr(
            inout builder,
            inout module,
            val(word_at(in lent, 0)),
            val(word_at(in lent, 1)),
            inout reply.text
        );
        reply.c.push(word_at(in reply.text, 0));
    } else if kind == KIND_CWSTR {
        let mut lent: ChunkSeq[u64] = ChunkSeq::new[u64]();
        view(inout builder, in module, source, 2, inout lent);
        cwstr(
            inout builder,
            inout module,
            val(word_at(in lent, 0)),
            val(word_at(in lent, 1)),
            inout reply.text
        );
        reply.c.push(word_at(in reply.text, 0));
    } else if kind == KIND_LENT {
        let stride = next(inout cursor);
        view(inout builder, in module, source, stride, inout reply.c);
    } else if kind == KIND_BUFFER {
        let release = next(inout cursor) == 1;
        let header = source_word(inout builder, source_kind, source);
        let data = ins_load(inout builder, ty_i64(), PLAIN, header, 16);
        let len = ins_load(inout builder, ty_i64(), PLAIN, header, 0);
        reply.c.push(value_word(data));
        reply.c.push(value_word(len));
        if release {
            reply.text.push(value_word(header));
        }
    } else if kind == KIND_CSTRLIST {
        let mut lent: ChunkSeq[u64] = ChunkSeq::new[u64]();
        view(inout builder, in module, source, 1, inout lent);
        cstr_list(
            inout builder,
            inout module,
            val(word_at(in lent, 0)),
            val(word_at(in lent, 1)),
            inout reply
        );
    } else if kind == KIND_VALUE {
        let value = value_arg(inout builder, inout cursor, source_kind, source);
        reply.c.push(value_word(value));
    } else if kind == KIND_HANDLE {
        let value = source_word(inout builder, source_kind, source);
        reply.c.push(value_word(value));
    } else if kind == KIND_POINTER {
        let writes = next(inout cursor) == 1;
        let nullable = next(inout cursor) == 1;
        let some = next(inout cursor);
        let offset = next(inout cursor);
        let pointee = cursor.pos;
        let mut opt: ChunkSeq[u64] = ChunkSeq::new[u64]();
        option(inout builder, nullable, some, offset, source, inout opt);
        let guard_word = word_at(in opt, 0);
        let payload = val(word_at(in opt, 1));
        let ptr = if at(in cursor, pointee) == P_SCALAR {
            let scalar_word = at(in cursor, wrapping_add(pointee, 1));
            let buffer = alloc(inout builder, in module, 8, true);
            let word = source_word(inout builder, if nullable { 1 } else { source_kind }, payload);
            let value = narrow(inout builder, word, bits_of(scalar_word));
            ins_store(inout builder, PLAIN, value, buffer, 0);
            if writes {
                reply.back.push(guard_word);
                reply.back.push(value_word(buffer));
                reply.back.push(value_word(payload));
                reply.back.push(SHAPE_SCALAR);
                reply.back.push(scalar_word);
            }
            buffer
        } else if identical_struct(in cursor, wrapping_add(pointee, 1), little) {
            payload
        } else {
            let size = at(in cursor, wrapping_add(pointee, 1));
            let buffer = alloc(inout builder, in module, wrapping_u32(size), true);
            write_struct(
                inout builder,
                in cursor,
                wrapping_add(pointee, 1),
                payload,
                buffer,
                0,
                little
            );
            if writes {
                reply.back.push(guard_word);
                reply.back.push(value_word(buffer));
                reply.back.push(value_word(payload));
                reply.back.push(SHAPE_STRUCT);
                copy_words(
                    in cursor,
                    wrapping_add(pointee, 1),
                    skip_pointee(in cursor, pointee),
                    inout reply.back
                );
            }
            buffer
        };
        let guarded = guard(inout builder, guard_word, ptr, pointer);
        reply.c.push(value_word(guarded));
    } else if kind == KIND_SLICE {
        let writes = next(inout cursor) == 1;
        let nullable = next(inout cursor) == 1;
        let some = next(inout cursor);
        let offset = next(inout cursor);
        let elem_count = next(inout cursor);
        let _size = next(inout cursor);
        let pointee = cursor.pos;
        let offsets = skip_pointee(in cursor, pointee);
        let mut opt: ChunkSeq[u64] = ChunkSeq::new[u64]();
        option(inout builder, nullable, some, offset, source, inout opt);
        let guard_word = word_at(in opt, 0);
        let payload = val(word_at(in opt, 1));
        let ptr = if elem_count == 0 {
            alloc(inout builder, in module, 8, true)
        } else if identical_pointee(in cursor, pointee, little) {
            payload
        } else {
            let bytes = wrapping_mul(elem_count, pointee_size(in cursor, pointee));
            let buffer = alloc(inout builder, in module, wrapping_u32(bytes), true);
            write_slice(
                inout builder,
                in cursor,
                pointee,
                offsets,
                elem_count,
                payload,
                buffer,
                little
            );
            if writes {
                reply.back.push(guard_word);
                reply.back.push(value_word(buffer));
                reply.back.push(value_word(payload));
                reply.back.push(SHAPE_SLICE);
                reply.back.push(elem_count);
                reply.back.push(pointee_size(in cursor, pointee));
                copy_words(in cursor, pointee, wrapping_add(offsets, elem_count), inout reply.back);
            }
            buffer
        };
        let guarded = guard(inout builder, guard_word, ptr, pointer);
        reply.c.push(value_word(guarded));
        let len = ins_iconst(inout builder, ty_i64(), imm(elem_count));
        let guarded_len = guard(inout builder, guard_word, len, ty_i64());
        reply.c.push(value_word(guarded_len));
    } else {
        return DECLINED;
    }
    answer(call, in reply);
    HANDLED
}

// ---------------------------------------------------------------------------
// REFUSE, CALL, RESULT, FINISH.

fn refuse(call: u64, inout builder: Builder, in module: Module) eff [Ffi[Cranelift]] {
    let cursor = R {
        words: call_args(call),
        pos: 0,
    };
    let size = at(in cursor, 0);
    let err_tag = at(in cursor, 1);
    let err_offset = at(in cursor, 2);
    let nul_count = wrapping_sub(cursor.words.len(), 3);
    let slot = alloc(inout builder, in module, wrapping_u32(size), true);
    let mut offset = ins_iconst(inout builder, ty_i64(), -1);
    for j in 0..nul_count {
        let nul_index = wrapping_sub(wrapping_sub(nul_count, 1), j);
        let nul_at = val(at(in cursor, wrapping_add(3, nul_index)));
        let found = ins_icmp_imm(inout builder, cc_sge(), nul_at, 0);
        offset = ins_select(inout builder, found, nul_at, offset);
    }
    let refused = ins_icmp_imm(inout builder, cc_sge(), offset, 0);
    let call_block = create_block(inout builder);
    let refuse_block = create_block(inout builder);
    let join = create_block(inout builder);
    ins_brif0(inout builder, refused, refuse_block, call_block);
    switch_to_block(inout builder, refuse_block);
    seal_block(inout builder, refuse_block);
    let tag = ins_iconst(inout builder, ty_i64(), imm(err_tag));
    ins_store(inout builder, PLAIN, tag, slot, 0);
    ins_store(inout builder, PLAIN, offset, slot, off(err_offset));
    ins_jump0(inout builder, join);
    switch_to_block(inout builder, call_block);
    seal_block(inout builder, call_block);
    call_result_value(call, slot);
    call_result(call, block_word(join));
}

// `foreign_os_error`: the calling thread's OS error code as a word.
fn os_error(
    inout builder: Builder,
    inout module: Module,
    which: u64
) -> Value eff [Ffi[Cranelift]] {
    let location = which == ERRNO_LOCATION || which == ERRNO_ERROR;
    let sig = sig_new(inout module, call_conv_default());
    sig_return(inout module, sig, if location { ty_i64() } else { ty_i32() });
    let id = if which == ERRNO_LOCATION {
        declare_function(inout module, in "__errno_location".as_bytes(), linkage_import(), sig)
    } else if which == ERRNO_ERROR {
        declare_function(inout module, in "__error".as_bytes(), linkage_import(), sig)
    } else {
        declare_function(inout module, in "GetLastError".as_bytes(), linkage_import(), sig)
    };
    let func = import_function(inout builder, inout module, id);
    let none: ChunkSeq[u32] = ChunkSeq::new[u32]();
    ins_call(inout builder, func, in none.as_slice());
    let result = inst_result(inout builder, 0);
    let code = if location {
        ins_load(inout builder, ty_i32(), PLAIN, result, 0)
    } else {
        result
    };
    ins_uextend(inout builder, ty_i64(), code)
}

// `foreign_copy_back` of the record at `start` (`[guard, buffer, target,
// shape...]`).
fn copy_back(inout builder: Builder, in cursor: R, start: u64, little: bool) eff [Ffi[Cranelift]] {
    let guard_word = at(in cursor, start);
    let buffer = val(at(in cursor, wrapping_add(start, 1)));
    let target = val(at(in cursor, wrapping_add(start, 2)));
    let shape = at(in cursor, wrapping_add(start, 3));
    let shape_start = wrapping_add(start, 4);
    let mut join_word = NO_VALUE;
    if guard_word != NO_VALUE {
        let then = create_block(inout builder);
        let join = create_block(inout builder);
        ins_brif0(inout builder, val(guard_word), then, join);
        switch_to_block(inout builder, then);
        join_word = block_word(join);
    }
    if shape == SHAPE_SCALAR {
        let scalar_word = at(in cursor, shape_start);
        let value = ins_load(inout builder, c_type(bits_of(scalar_word)), PLAIN, buffer, 0);
        let value = widen(inout builder, value, bits_of(scalar_word), signed_of(scalar_word));
        ins_store(inout builder, PLAIN, value, target, 0);
    } else if shape == SHAPE_STRUCT {
        read_struct(inout builder, in cursor, shape_start, buffer, 0, target, little);
    } else {
        let elem_count = at(in cursor, shape_start);
        let pointee = wrapping_add(shape_start, 2);
        let offsets = skip_pointee(in cursor, pointee);
        read_slice(inout builder, in cursor, pointee, offsets, elem_count, buffer, target, little);
    }
    if join_word != NO_VALUE {
        let join = @vesper/cranelift::block_of_word(join_word);
        ins_jump0(inout builder, join);
        switch_to_block(inout builder, join);
    }
}

fn foreign_helper_rdpkru(
    inout builder: Builder,
    inout module: Module
) -> FuncRef eff [Ffi[Cranelift]] {
    let name = "vesper_bridge_rdpkru".as_bytes();
    let defined = match module_get_function(inout module, in name) {
        Option::Some(_) => true,
        Option::None => false,
    };
    let sig = sig_new(inout module, call_conv_system_v());
    sig_return(inout module, sig, ty_i32());
    let id = declare_function(inout module, in name, linkage_local(), sig);
    if !defined {
        let mut code: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](6);
        code.push(0x31);
        code.push(0xc9);
        code.push(0x0f);
        code.push(0x01);
        code.push(0xee);
        code.push(0xc3);
        let relocs: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let _ = define_function_bytes(
            inout module,
            id,
            16,
            in code.as_slice(),
            in relocs.as_slice()
        );
    }
    import_function(inout builder, inout module, id)
}

fn foreign_helper_wrpkru(
    inout builder: Builder,
    inout module: Module
) -> FuncRef eff [Ffi[Cranelift]] {
    let name = "vesper_bridge_wrpkru".as_bytes();
    let defined = match module_get_function(inout module, in name) {
        Option::Some(_) => true,
        Option::None => false,
    };
    let sig = sig_new(inout module, call_conv_system_v());
    sig_param(inout module, sig, ty_i32());
    let id = declare_function(inout module, in name, linkage_local(), sig);
    if !defined {
        let mut code: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](10);
        code.push(0x89);
        code.push(0xf8);
        code.push(0x31);
        code.push(0xc9);
        code.push(0x31);
        code.push(0xd2);
        code.push(0x0f);
        code.push(0x01);
        code.push(0xef);
        code.push(0xc3);
        let relocs: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let _ = define_function_bytes(
            inout module,
            id,
            16,
            in code.as_slice(),
            in relocs.as_slice()
        );
    }
    import_function(inout builder, inout module, id)
}

fn isolate(call: u64, inout builder: Builder, inout module: Module) eff [Ffi[Cranelift]] {
    let args = call_args(call);
    let data = data_of_word(word_at(in args, 0));
    let ptr_ty = if word_at(in args, 1) == 1 {
        ty_i64()
    } else {
        ty_i32()
    };
    let global = import_data(inout builder, in module, data);
    let address = ins_symbol_value(inout builder, ptr_ty, global);
    let mask = ins_load(inout builder, ty_i32(), PLAIN, address, 0);
    let unset = ins_icmp_imm(inout builder, cc_eq(), mask, 0);
    let host = ins_band_imm(inout builder, mask, 3);
    let host = ins_icmp_imm(inout builder, cc_ne(), host, 0);
    let bad = ins_bor(inout builder, unset, host);
    ins_trapnz(inout builder, bad, trap_user(ISOLATION_TRAP));
    let rdpkru = foreign_helper_rdpkru(inout builder, inout module);
    let empty: ChunkSeq[u32] = ChunkSeq::new[u32]();
    ins_call(inout builder, rdpkru, in empty.as_slice());
    let saved = inst_result(inout builder, 0);
    let revoked = ins_bor(inout builder, saved, mask);
    let wrpkru = foreign_helper_wrpkru(inout builder, inout module);
    call1(inout builder, wrpkru, revoked);
    call_result(call, value_word(saved));
}

fn the_call(call: u64, inout builder: Builder, inout module: Module, indirect: bool) eff [
    Ffi[Cranelift]
] {
    let cursor = R {
        words: call_args(call),
        pos: 0,
    };
    let base: u64 = if indirect { 2 } else { 1 };
    let errno = at(in cursor, base);
    let saved = at(in cursor, wrapping_add(base, 1));
    let returns = at(in cursor, wrapping_add(base, 2)) == 1;
    let little = at(in cursor, wrapping_add(base, 3)) == 1;
    let len_word = at(in cursor, wrapping_add(base, 4));
    let len_meta = at(in cursor, wrapping_add(base, 5));
    let len_i64 = (len_meta & 1) != 0;
    let map_stride = if (len_meta >> 1) == 0 {
        1
    } else {
        len_meta >> 1
    };
    let reg_id = at(in cursor, wrapping_add(base, 6));
    let release_count = at(in cursor, wrapping_add(base, 7));
    let release_start = wrapping_add(base, 8);
    let count_pos = wrapping_add(release_start, release_count);
    let arg_count = at(in cursor, count_pos);
    let args_start = wrapping_add(count_pos, 1);
    let mut args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](arg_count);
    for pos in 0..arg_count {
        args.push(wrapping_u32(at(in cursor, wrapping_add(args_start, pos))));
    }
    if indirect {
        let sig = SigRef { id: wrapping_u32(at(in cursor, 0)) };
        let pointer = val(at(in cursor, 1));
        ins_call_indirect(inout builder, sig, pointer, in args.as_slice());
    } else {
        let callee = FuncRef { id: wrapping_u32(at(in cursor, 0)) };
        ins_call(inout builder, callee, in args.as_slice());
    }
    let mut raw = if returns {
        value_word(inst_result(inout builder, 0))
    } else {
        NO_VALUE
    };
    if len_word != NO_VALUE && raw != NO_VALUE {
        raw = value_word(foreign_mapping(
            inout builder,
            inout module,
            val(raw),
            val(len_word),
            len_i64,
            map_stride,
            reg_id
        ));
    }
    if release_count > 0 {
        let free = libc(inout builder, inout module, FREE, 1, false);
        for j in 0..release_count {
            call1(inout builder, free, val(at(in cursor, wrapping_add(release_start, j))));
        }
    }
    if saved != NO_VALUE {
        let wrpkru = foreign_helper_wrpkru(inout builder, inout module);
        call1(inout builder, wrpkru, val(saved));
    }
    let os = if errno != 0 {
        value_word(os_error(inout builder, inout module, errno))
    } else {
        NO_VALUE
    };
    let mut pos = wrapping_add(args_start, arg_count);
    let copies = at(in cursor, pos);
    pos = wrapping_add(pos, 1);
    for _ in 0..copies {
        let len = at(in cursor, pos);
        copy_back(inout builder, in cursor, wrapping_add(pos, 1), little);
        pos = wrapping_add(pos, wrapping_add(len, 1));
    }
    call_result(call, raw);
    call_result(call, os);
}

// `foreign_validated`: `Ok(ok)` when `valid`, else `Err(ForeignInvalid {
// raw })`, from layout words `[size, ok, ok offset, err, err offset]`.
fn validated(
    inout builder: Builder,
    in module: Module,
    in cursor: R,
    layout: u64,
    valid: Value,
    ok: Value,
    raw: Value
) -> Value eff [Ffi[Cranelift]] {
    let ptr = alloc(inout builder, in module, wrapping_u32(at(in cursor, layout)), true);
    let ok_tag = ins_iconst(inout builder, ty_i64(), imm(at(in cursor, wrapping_add(layout, 1))));
    let err_tag = ins_iconst(inout builder, ty_i64(), imm(at(in cursor, wrapping_add(layout, 3))));
    let tag = ins_select(inout builder, valid, ok_tag, err_tag);
    ins_store(inout builder, PLAIN, tag, ptr, 0);
    let payload = ins_select(inout builder, valid, ok, raw);
    ins_store(inout builder, PLAIN, payload, ptr, off(at(in cursor, wrapping_add(layout, 2))));
    ptr
}

fn result(call: u64, inout builder: Builder, inout module: Module) eff [Ffi[Cranelift]] {
    let mut cursor = R {
        words: call_args(call),
        pos: 0,
    };
    let raw = val(next(inout cursor));
    let jit = next(inout cursor) == 1;
    let value_tag = next(inout cursor);
    let value = if value_tag == V_UNIT {
        ins_iconst(inout builder, ty_i64(), 0)
    } else if value_tag == V_SCALAR {
        let scalar_word = next(inout cursor);
        widen(inout builder, raw, bits_of(scalar_word), signed_of(scalar_word))
    } else if value_tag == V_FLOAT {
        raw
    } else if value_tag == V_CSTR || value_tag == V_CWSTR {
        let copy = if value_tag == V_CWSTR {
            foreign_cwstr_copy(inout builder, inout module, raw, jit)
        } else {
            foreign_cstr_copy(inout builder, inout module, raw, jit)
        };
        let layout = cursor.pos;
        let present = ins_icmp_imm(inout builder, cc_ne(), raw, 0);
        let ptr = alloc(inout builder, in module, wrapping_u32(at(in cursor, layout)), true);
        let some = ins_iconst(inout builder, ty_i64(), imm(at(in cursor, wrapping_add(layout, 1))));
        let none = ins_iconst(inout builder, ty_i64(), imm(at(in cursor, wrapping_add(layout, 3))));
        let tag = ins_select(inout builder, present, some, none);
        ins_store(inout builder, PLAIN, tag, ptr, 0);
        ins_store(inout builder, PLAIN, copy, ptr, off(at(in cursor, wrapping_add(layout, 2))));
        ptr
    } else if value_tag == V_BOOL {
        let word = ins_uextend(inout builder, ty_i64(), raw);
        let valid = ins_icmp_imm(inout builder, cc_ule(), word, 1);
        validated(inout builder, in module, in cursor, cursor.pos, valid, word, word)
    } else if value_tag == V_ENUM {
        let scalar_word = next(inout cursor);
        let variant_count = next(inout cursor);
        let word = widen(inout builder, raw, bits_of(scalar_word), false);
        let mut valid = ins_iconst(inout builder, ty_i8(), 0);
        let mut index = ins_iconst(inout builder, ty_i64(), 0);
        for i in 0..variant_count {
            let hit = ins_icmp_imm(
                inout builder,
                cc_eq(),
                word,
                imm(at(in cursor, wrapping_add(cursor.pos, i)))
            );
            let candidate = ins_iconst(inout builder, ty_i64(), imm(i));
            index = ins_select(inout builder, hit, candidate, index);
            valid = ins_bor(inout builder, valid, hit);
        }
        let layout = wrapping_add(cursor.pos, variant_count);
        validated(inout builder, in module, in cursor, layout, valid, index, word)
    } else if value_tag == V_NONNULL {
        ins_trapz(inout builder, raw, trap_user(NULL_HANDLE_TRAP));
        if at(in cursor, cursor.pos) == 0 {
            raw
        } else {
            let ptr = alloc(
                inout builder,
                in module,
                wrapping_u32(at(in cursor, wrapping_add(cursor.pos, 1))),
                true
            );
            ins_store(inout builder, PLAIN, raw, ptr, 0);
            ptr
        }
    } else {
        // V_HANDLE.
        let nullable = next(inout cursor) == 1;
        let present = ins_icmp_imm(inout builder, cc_ne(), raw, 0);
        if !nullable {
            validated(inout builder, in module, in cursor, cursor.pos, present, raw, raw)
        } else {
            let layout = cursor.pos;
            let ptr = alloc(inout builder, in module, wrapping_u32(at(in cursor, layout)), true);
            let some = ins_iconst(
                inout builder,
                ty_i64(),
                imm(at(in cursor, wrapping_add(layout, 1)))
            );
            let none = ins_iconst(
                inout builder,
                ty_i64(),
                imm(at(in cursor, wrapping_add(layout, 3)))
            );
            let tag = ins_select(inout builder, present, some, none);
            ins_store(inout builder, PLAIN, tag, ptr, 0);
            ins_store(inout builder, PLAIN, raw, ptr, off(at(in cursor, wrapping_add(layout, 2))));
            ptr
        }
    };
    call_result_value(call, value);
}

fn finish(call: u64, inout builder: Builder, inout module: Module) eff [Ffi[Cranelift]] {
    let cursor = R {
        words: call_args(call),
        pos: 0,
    };
    for i in 0..cursor.words.len() {
        let free = libc(inout builder, inout module, FREE, 1, false);
        call1(inout builder, free, val(at(in cursor, i)));
    }
}

// One `ffi` request on the lent handles.
fn request(call: u64, inout builder: Builder, inout module: Module) -> u64 eff [Ffi[Cranelift]] {
    let op = call_op(call);
    if op == BEGIN {
        return HANDLED;
    }
    if op == ARG {
        return arg(call, inout builder, inout module);
    }
    if op == REFUSE {
        refuse(call, inout builder, in module);
    } else if op == ISOLATE {
        isolate(call, inout builder, inout module);
    } else if op == CALL {
        the_call(call, inout builder, inout module, false);
    } else if op == CALL_INDIRECT {
        the_call(call, inout builder, inout module, true);
    } else if op == RESULT {
        result(call, inout builder, inout module);
    } else if op == FINISH {
        finish(call, inout builder, inout module);
    } else {
        return DECLINED;
    }
    HANDLED
}

// The `ffi` hook: one request over the lent builder and module.
pub fn ffi_hook(call: u64) -> u64 eff [Ffi[Cranelift]] {
    let mut builder = match call_builder(call) {
        Some(builder) => builder,
        None => return DECLINED,
    };
    let mut module = match call_module(call) {
        Some(module) => module,
        None => {
            call_return_builder(call, builder);
            return DECLINED;
        }
    };
    let handled = request(call, inout builder, inout module);
    call_return_module(call, module);
    call_return_builder(call, builder);
    handled
}
