// @vesper/ffi-drops: `src/ffi_lowering/drops.rs` (`insert`, `check_rows`,
// `DropCallees`) in Vesper over `@vesper/place-ir` and `@vesper/check-data`
// (self-hosting SH4 lane 13, #1287 / #1714).

use @vesper/check-data::{pack_text};
use @vesper/check-data::input::{Ctx, Reader, read_ctx};
use @vesper/check-data::names::{Names};
use @vesper/check-data::types::{TyKind, TyPass, Types, Vars, display, substitute, vars_new};
use @vesper/check-data::util::{add, inc, n32, push_decimal, u32_at, u64_at, u8_at, w};
use @vesper/check-data::world::{Adt, World, constructor, field_step};
use @vesper/place-ir::{BlockRow, FnRow, InstRow, Program, put_program, read_program};
use @vesper/place-ir::codes::{Op, Pat, Tag, Term};

const NONE32: u32 = 4294967295;
const NONE64: u64 = 18446744073709551615;
const DROP_PREFIX: Str = "$drop$";
const DROP_OPTION_PREFIX: Str = "$drop$Option$";
const EFFECT_PREFIX: Str = "Ffi$";

pub copy struct FnMeta {
    name: u32,
    fip: bool,
    s0: u64,
    s1: u64,
}

pub copy struct DropSite {
    graph: u32,
    handle: u32,
    effect: u32,
}

pub copy struct DropItem {
    blk: u64,
    at: u64,
    // 0 = Value(v, ty), 1 = Place(root, path, ty), 2 = OtherFields(ty, keep)
    kind: u8,
    v: u32,
    root: u32,
    path: u64,
    ty: u32,
    keep: u32,
}

pub copy struct EdgeSplit {
    from: u64,
    to: u64,
}

pub struct FnPlan {
    fi: u64,
    ok: bool,
    splits: ChunkSeq[EdgeSplit],
    before_inst: ChunkSeq[DropItem],
    after_inst: ChunkSeq[DropItem],
    before_term: ChunkSeq[DropItem],
}

fn push_str(inout out: ChunkSeq[u8], in s: Str) {
    out.extend(in s.as_bytes());
}

fn push_sym(inout out: ChunkSeq[u8], in names: Names, sym: u32) {
    let a = names.start(sym);
    let e = names.end(sym);
    for i in a..e {
        out.push(u8_at(in names.text, i));
    }
}

fn sym_starts_with(in names: Names, sym: u32, in prefix: Str) -> bool {
    let a = names.start(sym);
    let e = names.end(sym);
    let pb = prefix.as_bytes();
    if wrapping_sub(e, a) < pb.len() {
        return false;
    }
    for i in 0..pb.len() {
        let ch = match pb.try_get(i) {
            Option::Some(v) => v,
            Option::None => 0,
        };
        if u8_at(in names.text, add(a, i)) != ch {
            return false;
        }
    }
    true
}

fn sym_has_byte(in names: Names, sym: u32, b: u8) -> bool {
    let a = names.start(sym);
    let e = names.end(sym);
    for i in a..e {
        if u8_at(in names.text, i) == b {
            return true;
        }
    }
    false
}

fn sym_eq_str(in names: Names, sym: u32, in s: Str) -> bool {
    let a = names.start(sym);
    let e = names.end(sym);
    let sb = s.as_bytes();
    if wrapping_sub(e, a) != sb.len() {
        return false;
    }
    for i in 0..sb.len() {
        let ch = match sb.try_get(i) {
            Option::Some(v) => v,
            Option::None => 0,
        };
        if u8_at(in names.text, add(a, i)) != ch {
            return false;
        }
    }
    true
}

// Interns `prefix + sym_text` in `names`.
fn intern_prefixed(inout names: Names, in prefix: Str, sym: u32) -> u32 {
    let pb = prefix.as_bytes();
    let a = names.start(sym);
    let e = names.end(sym);
    let mut buf = ChunkSeq::with_capacity[u8](add(pb.len(), wrapping_sub(e, a)));
    buf.extend(in pb);
    for i in a..e {
        buf.push(u8_at(in names.text, i));
    }
    names.intern(in buf[0..buf.len()])
}

fn list_has_u32(in xs: ChunkSeq[u32], x: u32) -> bool {
    for i in 0..xs.len() {
        if u32_at(in xs, i) == x {
            return true;
        }
    }
    false
}

fn list_find_u32(in xs: ChunkSeq[u32], x: u32) -> u64 {
    for i in 0..xs.len() {
        if u32_at(in xs, i) == x {
            return i;
        }
    }
    NONE64
}

// ----- function header helpers ------------------------------------------------

// Parses the header of function `fi` and returns:
// (params_count, params_start_op, result_ty, effects_ty, bounds_op, captures_op, nv_op, locals_op).
fn fn_header_offsets(in p: Program, fi: u64) -> (u64, u64, u32, u32, u64, u64) {
    let f = p.function(fi);
    let mut pos = f.ha;
    let np = p.op(pos);
    pos = inc(pos);
    let params_op = pos;
    for i in 0..np {
        // name, pass, nproj
        let nproj = p.op(add(pos, 2));
        // 3 + nproj + 3 (type, s0, s1)
        pos = add(pos, add(6, nproj));
    }
    let result_ty = n32(p.op(pos));
    let effects_ty = n32(p.op(inc(pos)));
    pos = add(pos, 2);
    // bounds: nb, nb x (name, mode)
    let nb = p.op(pos);
    pos = add(inc(pos), wrapping_mul(nb, 2));
    // captures: nc, nc x name
    let nc = p.op(pos);
    pos = add(inc(pos), nc);
    let nv_op = pos;
    let nv = p.op(pos);
    pos = add(inc(pos), wrapping_mul(nv, 2));
    let locals_op = pos;
    (np, params_op, result_ty, effects_ty, nv_op, locals_op)
}

fn fn_value_type(in p: Program, nv_op: u64, v: u32) -> u32 {
    let nv = p.op(nv_op);
    for i in 0..nv {
        let base = add(inc(nv_op), wrapping_mul(i, 2));
        if n32(p.op(base)) == v {
            return n32(p.op(inc(base)));
        }
    }
    NONE32
}

fn fn_local_or_param_type(
    in p: Program,
    np: u64,
    params_op: u64,
    locals_op: u64,
    name: u32
) -> u32 {
    // locals first (matches drops.rs:324-327)
    let nl = p.op(locals_op);
    for i in 0..nl {
        let base = add(inc(locals_op), wrapping_mul(i, 2));
        if n32(p.op(base)) == name {
            return n32(p.op(inc(base)));
        }
    }
    let mut pos = params_op;
    for i in 0..np {
        let pname = n32(p.op(pos));
        let nproj = p.op(add(pos, 2));
        if pname == name {
            return n32(p.op(add(pos, add(3, nproj))));
        }
        pos = add(pos, add(6, nproj));
    }
    NONE32
}

// Rebuilds `f`'s header with `value -> ty` inserted/updated in `values`.
fn fn_set_value_type(inout p: Program, fi: u64, v: u32, ty: u32) {
    let (_, _, _, _, nv_op, locals_op) = fn_header_offsets(in p, fi);
    let nv = p.op(nv_op);
    for i in 0..nv {
        let base = add(inc(nv_op), wrapping_mul(i, 2));
        if n32(p.op(base)) == v {
            let _ = p.ops.try_set(inc(base), w(ty));
            return;
        }
    }
    // Rebuild header in p.ops with (v, ty) appended in sorted ValueId order or at end.
    let mut f = p.function(fi);
    let new_ha = p.ops.len();
    for pos in f.ha..inc(nv_op) {
        if pos == nv_op {
            p.put(inc(nv), Tag::Raw);
        } else {
            p.put(p.op(pos), p.tag(pos));
        }
    }
    let mut inserted = false;
    for i in 0..nv {
        let base = add(inc(nv_op), wrapping_mul(i, 2));
        let ev = n32(p.op(base));
        if !inserted && v < ev {
            p.put(w(v), Tag::Value);
            p.put(w(ty), Tag::Type);
            inserted = true;
        }
        p.put(w(ev), Tag::Value);
        p.put(p.op(inc(base)), Tag::Type);
    }
    if !inserted {
        p.put(w(v), Tag::Value);
        p.put(w(ty), Tag::Type);
    }
    let tail_start = add(inc(nv_op), wrapping_mul(nv, 2));
    let tail_end = add(f.ha, f.hn);
    for pos in tail_start..tail_end {
        p.put(p.op(pos), p.tag(pos));
    }
    f.ha = new_ha;
    f.hn = wrapping_sub(p.ops.len(), new_ha);
    let _ = p.fns.try_set(fi, f);
}

fn fn_max_value_id(in p: Program, fi: u64, nv_op: u64) -> u32 {
    let mut m: u32 = 0;
    let mut has = false;
    let nv = p.op(nv_op);
    for i in 0..nv {
        let v = n32(p.op(add(inc(nv_op), wrapping_mul(i, 2))));
        if !has || v > m {
            m = v;
            has = true;
        }
    }
    let f = p.function(fi);
    for bi in f.b0..add(f.b0, f.bc) {
        let b = p.block(bi);
        let nbp = p.op(add(b.ha, add(3, wrapping_mul(p.op(inc(b.ha)), 2))));
        // Actually read block header: entry_token(0), ni(1), ni*2 pairs, outgoing, np, np values
        let ni = p.op(inc(b.ha));
        let np_pos = add(b.ha, add(3, wrapping_mul(ni, 2)));
        let np = p.op(np_pos);
        for k in 0..np {
            let v = n32(p.op(add(inc(np_pos), k)));
            if !has || v > m {
                m = v;
                has = true;
            }
        }
        for ii in b.i0..add(b.i0, b.ic) {
            let inst = p.inst(ii);
            if !has || inst.dest > m {
                m = inst.dest;
                has = true;
            }
        }
    }
    if has {
        wrapping_add(m, 1)
    } else {
        0
    }
}

fn find_fn_by_name(in p: Program, name: u32) -> u64 {
    for fi in 0..p.fn_count() {
        if p.function(fi).name == name {
            return fi;
        }
    }
    NONE64
}

// ----- droppable handles & drop_function --------------------------------------

// Returns parallel `(handles, effects)` for every `$drop$<H>` function in `p`.
fn droppable(in c: Ctx, in p: Program) -> (ChunkSeq[u32], ChunkSeq[u32]) {
    let mut handles = ChunkSeq::new[u32]();
    let mut effects = ChunkSeq::new[u32]();
    let plen: u64 = 6;
    for fi in 0..p.fn_count() {
        let f = p.function(fi);
        if !sym_starts_with(in c.names, f.name, in DROP_PREFIX) {
            continue;
        }
        let a = c.names.start(f.name);
        let e = c.names.end(f.name);
        let mut has_dollar = false;
        for i in add(a, plen)..e {
            if u8_at(in c.names.text, i) == 36 {
                has_dollar = true;
            }
        }
        if has_dollar {
            continue;
        }
        let (_, _, _, effects_ty, _, _) = fn_header_offsets(in p, fi);
        let row_id = c.types.node(effects_ty).r2;
        let row = c.types.row(row_id);
        if row.n == 0 {
            continue;
        }
        let eff_name = c.types.effect_at(w(row.a)).name;
        // Intern handle name directly from slice (no mutation needed if we pass inout names,
        // or we compare bytes; here we intern into a copy or pass inout c.names).
        // Note: handled in caller with `inout c`.
        handles.push(f.name);
        effects.push(eff_name);
    }
    (handles, effects)
}

fn droppable_resolved(inout c: Ctx, in p: Program) -> (ChunkSeq[u32], ChunkSeq[u32]) {
    let (raw_fns, effects) = droppable(in c, in p);
    let mut handles = ChunkSeq::new[u32]();
    let plen: u64 = 6;
    for i in 0..raw_fns.len() {
        let fn_sym = u32_at(in raw_fns, i);
        let a = c.names.start(fn_sym);
        let e = c.names.end(fn_sym);
        let mut buf = ChunkSeq::new[u8]();
        for k in add(a, plen)..e {
            buf.push(u8_at(in c.names.text, k));
        }
        handles.push(c.names.intern(in buf[0..buf.len()]));
    }
    (handles, effects)
}

fn drop_function(inout c: Ctx, ty: u32) -> u32 {
    let nd = c.types.node(ty);
    if nd.kind != TyKind::Named {
        return NONE32;
    }
    if nd.n == 0 {
        return intern_prefixed(inout c.names, in DROP_PREFIX, nd.name);
    }
    if sym_eq_str(in c.names, nd.name, in "Option") && nd.n == 1 {
        let inner = c.types.arg(ty, 0);
        let in_nd = c.types.node(inner);
        if in_nd.kind == TyKind::Named && in_nd.n == 0 {
            return intern_prefixed(inout c.names, in DROP_OPTION_PREFIX, in_nd.name);
        }
    }
    NONE32
}

// Whether `ty` is `H` or `Option[H]` for some `H` in `handles`; returns `H` or `NONE32`.
fn direct_or_option_handle(in c: Ctx, ty: u32, in handles: ChunkSeq[u32]) -> u32 {
    let nd = c.types.node(ty);
    if nd.kind != TyKind::Named {
        return NONE32;
    }
    if nd.n == 0 && list_has_u32(in handles, nd.name) {
        return nd.name;
    }
    if sym_eq_str(in c.names, nd.name, in "Option") && nd.n == 1 {
        let inner = c.types.arg(ty, 0);
        let in_nd = c.types.node(inner);
        if in_nd.kind == TyKind::Named && in_nd.n == 0 && list_has_u32(in handles, in_nd.name) {
            return in_nd.name;
        }
    }
    NONE32
}

// ----- holds ------------------------------------------------------------------

fn holds(inout c: Ctx, ty: u32, in handles: ChunkSeq[u32], inout seen: ChunkSeq[u32]) -> bool {
    let nd = c.types.node(ty);
    if nd.kind == TyKind::Named {
        if list_has_u32(in handles, nd.name) {
            return true;
        }
        let ar = c.types.arity(ty);
        for i in 0..ar {
            if holds(inout c, c.types.arg(ty, i), in handles, inout seen) {
                return true;
            }
        }
        if list_has_u32(in seen, nd.name) {
            return false;
        }
        seen.push(nd.name);
        let ai = c.world.lookup(nd.name);
        let mut found = false;
        if ai != NONE32 {
            let a = c.world.adt(ai);
            let vars = c.world.vars_of(in c.types, a, ty);
            for vi in w(a.va)..add(w(a.va), w(a.vn)) {
                let v = c.world.variant(vi);
                for fi in w(v.fa)..add(w(v.fa), w(v.fc)) {
                    let f = c.world.field(fi);
                    let sub = substitute(inout c.types, f.ty, in vars);
                    if holds(inout c, sub, in handles, inout seen) {
                        found = true;
                        break;
                    }
                }
                if found {
                    break;
                }
            }
        }
        if seen.len() > 0 {
            seen.truncate(wrapping_sub(seen.len(), 1));
        }
        return found;
    }
    if nd.kind == TyKind::Tuple {
        let ar = c.types.arity(ty);
        for i in 0..ar {
            if holds(inout c, c.types.arg(ty, i), in handles, inout seen) {
                return true;
            }
        }
    }
    false
}

// ----- pattern helpers --------------------------------------------------------

// Skips one pattern in `p.ops` from `pos` and returns the next op index.
fn skip_pattern(in p: Program, start_pos: u64) -> u64 {
    let mut pos = start_pos;
    let kind = n32(p.op(pos));
    pos = add(pos, 3);
    if kind == Pat::Wild {
        return pos;
    }
    if kind == Pat::Bind {
        return inc(pos);
    }
    if kind == Pat::Literal {
        // lit kind + 2 words
        return add(pos, 3);
    }
    if kind == Pat::Tuple {
        let n = p.op(pos);
        pos = inc(pos);
        for i in 0..n {
            pos = skip_pattern(in p, pos);
        }
        return pos;
    }
    if kind == Pat::Constructor {
        // name, named, n, n x (field_name, pattern)
        let n = p.op(add(pos, 2));
        pos = add(pos, 3);
        for i in 0..n {
            pos = inc(pos);
            pos = skip_pattern(in p, pos);
        }
        return pos;
    }
    pos
}

fn collect_pattern_bound_names(in p: Program, start_pos: u64, inout names: ChunkSeq[u32]) -> u64 {
    let mut pos = start_pos;
    let kind = n32(p.op(pos));
    pos = add(pos, 3);
    if kind == Pat::Wild {
        return pos;
    }
    if kind == Pat::Bind {
        let nm = n32(p.op(pos));
        if !list_has_u32(in names, nm) {
            names.push(nm);
        }
        return inc(pos);
    }
    if kind == Pat::Literal {
        return add(pos, 3);
    }
    if kind == Pat::Tuple {
        let n = p.op(pos);
        pos = inc(pos);
        for i in 0..n {
            pos = collect_pattern_bound_names(in p, pos, inout names);
        }
        return pos;
    }
    if kind == Pat::Constructor {
        let n = p.op(add(pos, 2));
        pos = add(pos, 3);
        for i in 0..n {
            pos = inc(pos);
            pos = collect_pattern_bound_names(in p, pos, inout names);
        }
        return pos;
    }
    pos
}

// ----- borrowed_scrutinees ----------------------------------------------------

fn borrowed_scrutinees(in c: Ctx, in p: Program, fi: u64) -> ChunkSeq[u32] {
    let f = p.function(fi);
    let mut matched = ChunkSeq::new[u32]();
    for bi in f.b0..add(f.b0, f.bc) {
        let b = p.block(bi);
        if b.term == Term::Match {
            let v = n32(p.op(b.ta));
            if !list_has_u32(in matched, v) {
                matched.push(v);
            }
        }
    }
    let (np, params_op, _, _, _, _) = fn_header_offsets(in p, fi);
    let mut bnames = ChunkSeq::new[u32]();
    let mut pos = params_op;
    for i in 0..np {
        let pname = n32(p.op(pos));
        let pass = p.op(inc(pos));
        let nproj = p.op(add(pos, 2));
        if pass != w(TyPass::Sink) && !list_has_u32(in bnames, pname) {
            bnames.push(pname);
        }
        pos = add(pos, add(6, nproj));
    }
    let mut out = ChunkSeq::new[u32]();
    loop {
        let bn = bnames.len();
        let on = out.len();
        for bi in f.b0..add(f.b0, f.bc) {
            let b = p.block(bi);
            for ii in b.i0..add(b.i0, b.ic) {
                let inst = p.inst(ii);
                if inst.op == Op::Read {
                    let root = n32(p.op(inst.a));
                    if list_has_u32(in matched, inst.dest)
                        && list_has_u32(in bnames, root)
                        && !list_has_u32(in out, inst.dest) {
                        out.push(inst.dest);
                    }
                } else if inst.op == Op::Seq {
                    let row = p.pool_row(p.op(inst.a));
                    if (
                        sym_eq_str(in c.names, row.label, in "TryGet")
                            || sym_eq_str(in c.names, row.label, in "Hoisted(TryGet)")
                    )
                        && list_has_u32(in matched, inst.dest)
                        && !list_has_u32(in out, inst.dest) {
                        out.push(inst.dest);
                    }
                } else if inst.op == Op::Bind {
                    let val = n32(p.op(inst.a));
                    if list_has_u32(in out, val) {
                        let _ = collect_pattern_bound_names(in p, inc(inst.a), inout bnames);
                    }
                }
            }
        }
        if bnames.len() == bn && out.len() == on {
            return out;
        }
    }
}

// ----- release_wildcards ------------------------------------------------------

fn release_wildcards(
    inout c: Ctx,
    inout p: Program,
    fi: u64,
    in handles: ChunkSeq[u32],
    in effects: ChunkSeq[u32],
    inout sites: ChunkSeq[DropSite]
) {
    let borrowed = borrowed_scrutinees(in c, in p, fi);
    let f = p.function(fi);
    let (_, _, _, _, nv_op, _) = fn_header_offsets(in p, fi);
    for bi in f.b0..add(f.b0, f.bc) {
        let b = p.block(bi);
        for ii in b.i0..add(b.i0, b.ic) {
            let mut inst = p.inst(ii);
            if inst.op != Op::Bind {
                continue;
            }
            let val = n32(p.op(inst.a));
            let pat_kind = n32(p.op(inc(inst.a)));
            if pat_kind != Pat::Wild || list_has_u32(in borrowed, val) {
                continue;
            }
            let ty = fn_value_type(in p, nv_op, val);
            if ty == NONE32 {
                continue;
            }
            let handle = direct_or_option_handle(in c, ty, in handles);
            if handle == NONE32 {
                continue;
            }
            let callee = drop_function(inout c, ty);
            if callee == NONE32 {
                continue;
            }
            let tfi = find_fn_by_name(in p, callee);
            if tfi == NONE64 {
                continue;
            }
            let (_, _, target_res, _, _, _) = fn_header_offsets(in p, tfi);
            let op_start = p.ops.len();
            p.put(w(callee), Tag::Name);
            p.put(1, Tag::Raw);
            p.put(w(TyPass::Sink), Tag::Raw);
            p.put(w(val), Tag::Value);
            p.put(0, Tag::OptName);
            p.put(0, Tag::Path);
            p.put(0, Tag::Raw);
            p.put(0, Tag::OptName);
            inst.op = Op::Call;
            inst.a = op_start;
            inst.n = 8;
            inst.ty = target_res;
            let _ = p.insts.try_set(ii, inst);
            fn_set_value_type(inout p, fi, inst.dest, target_res);
            let hidx = list_find_u32(in handles, handle);
            sites
                .push(DropSite { graph: f.name, handle: handle, effect: u32_at(in effects, hidx) });
        }
    }
}

// ----- refuse_unplaced --------------------------------------------------------

fn wild_handle(
    inout c: Ctx,
    in p: Program,
    start_pos: u64,
    ty: u32,
    in handles: ChunkSeq[u32]
) -> (bool, u64) {
    let mut pos = start_pos;
    let kind = n32(p.op(pos));
    pos = add(pos, 3);
    if kind == Pat::Wild {
        let mut seen = ChunkSeq::new[u32]();
        return (holds(inout c, ty, in handles, inout seen), pos);
    }
    if kind == Pat::Bind {
        return (false, inc(pos));
    }
    if kind == Pat::Literal {
        return (false, add(pos, 3));
    }
    if kind == Pat::Tuple {
        let n = p.op(pos);
        pos = inc(pos);
        let tnd = c.types.node(ty);
        let mut any = false;
        for i in 0..n {
            let sub_ty = if tnd.kind == TyKind::Tuple && i < c.types.arity(ty) {
                c.types.arg(ty, i)
            } else {
                c.types.unit
            };
            let (hit, next) = wild_handle(inout c, in p, pos, sub_ty, in handles);
            pos = next;
            if tnd.kind == TyKind::Tuple && hit {
                any = true;
            }
        }
        return (any, pos);
    }
    if kind == Pat::Constructor {
        let cname = n32(p.op(pos));
        let _named = p.op(inc(pos));
        let n = p.op(add(pos, 2));
        pos = add(pos, 3);
        let tnd = c.types.node(ty);
        if tnd.kind != TyKind::Named {
            for i in 0..n {
                pos = inc(pos);
                pos = skip_pattern(in p, pos);
            }
            return (false, pos);
        }
        let packed = constructor(in c.world, NONE32, cname);
        if packed == NONE64 {
            for i in 0..n {
                pos = inc(pos);
                pos = skip_pattern(in p, pos);
            }
            return (false, pos);
        }
        let ai = wrapping_u32(packed >> 32);
        let vi = packed & 4294967295;
        let a = c.world.adt(ai);
        let v = c.world.variant(vi);
        let vars = c.world.vars_of(in c.types, a, ty);
        let mut any = false;
        for i in 0..n {
            let fname = n32(p.op(pos));
            pos = inc(pos);
            let fty = c.world.find_field(v, fname);
            if fty != NONE32 {
                let sub_ty = substitute(inout c.types, fty, in vars);
                let (hit, next) = wild_handle(inout c, in p, pos, sub_ty, in handles);
                pos = next;
                if hit {
                    any = true;
                }
            } else {
                pos = skip_pattern(in p, pos);
            }
        }
        return (any, pos);
    }
    (false, pos)
}

fn refuse_unplaced(
    inout c: Ctx,
    in p: Program,
    fi: u64,
    in handles: ChunkSeq[u32],
    inout err: ChunkSeq[u8]
) -> bool {
    let borrowed = borrowed_scrutinees(in c, in p, fi);
    let f = p.function(fi);
    let (np, params_op, _, _, nv_op, locals_op) = fn_header_offsets(in p, fi);
    for bi in f.b0..add(f.b0, f.bc) {
        let b = p.block(bi);
        for ii in b.i0..add(b.i0, b.ic) {
            let inst = p.inst(ii);
            if inst.op == Op::Bind {
                let val = n32(p.op(inst.a));
                if !list_has_u32(in borrowed, val) {
                    let ty = fn_value_type(in p, nv_op, val);
                    if ty != NONE32 {
                        let (hit, _) = wild_handle(inout c, in p, inc(inst.a), ty, in handles);
                        if hit {
                            err.push(39);
                            push_sym(inout err, in c.names, f.name);
                            push_str(
                                inout err,
                                in "' discards a handle with a drop import with `_` inside a pattern; bind it to a name so it is released"
                            );
                            return false;
                        }
                    }
                }
            } else if inst.op == Op::Closure {
                // operands: pool(0), captures(1): nc, nc x (name, name), moves: nm, nm x (root, path)
                let nc = p.op(inc(inst.a));
                let moves_pos = add(add(inst.a, 2), wrapping_mul(nc, 2));
                let nm = p.op(moves_pos);
                for m in 0..nm {
                    let mpos = add(inc(moves_pos), wrapping_mul(m, 2));
                    let root = n32(p.op(mpos));
                    let path_idx = p.op(inc(mpos));
                    let base_ty = fn_local_or_param_type(in p, np, params_op, locals_op, root);
                    if base_ty == NONE32 {
                        continue;
                    }
                    let path_row = p.path(path_idx);
                    let mut ty = base_ty;
                    let mut ok = true;
                    for k in 0..path_row.n {
                        let fname = p.path_name(path_idx, k);
                        let next_ty = field_step(
                            inout c.types,
                            inout c.names,
                            in c.world,
                            ty,
                            fname,
                            false
                        );
                        if next_ty == NONE32 {
                            ok = false;
                            break;
                        }
                        ty = next_ty;
                    }
                    if ok {
                        let mut seen = ChunkSeq::new[u32]();
                        if holds(inout c, ty, in handles, inout seen) {
                            err.push(39);
                            push_sym(inout err, in c.names, f.name);
                            push_str(
                                inout err,
                                in "' moves a handle with a drop import into a closure; a dropped closure does not release it, so pass the handle to the closure's call instead"
                            );
                            return false;
                        }
                    }
                }
            }
        }
    }
    true
}

// ----- split_edge & apply -----------------------------------------------------

fn split_edge(inout p: Program, fi: u64, from_rel: u64, to_rel: u64) {
    let mut f = p.function(fi);
    let at_rel = f.bc;
    let from_abs = add(f.b0, from_rel);
    let to_abs = add(f.b0, to_rel);
    let mut from_blk = p.block(from_abs);
    // Outgoing token of `from_blk`: header word at 2 + ni * 2
    let ni = p.op(inc(from_blk.ha));
    let token = p.op(add(from_blk.ha, add(2, wrapping_mul(ni, 2))));
    // Build new block header: entry_token, 1, (from_rel, token), outgoing_token, 0 params
    let ha = p.ops.len();
    p.put(token, Tag::Raw);
    p.put(1, Tag::Raw);
    p.put(from_rel, Tag::Block);
    p.put(token, Tag::Raw);
    p.put(token, Tag::Raw);
    p.put(0, Tag::Raw);
    let hn = wrapping_sub(p.ops.len(), ha);
    // Terminator: Jump { block: to_rel, args: [] }
    let ta = p.ops.len();
    p.put(to_rel, Tag::Block);
    p.put(0, Tag::Raw);
    let tn = wrapping_sub(p.ops.len(), ta);
    // Ensure `f`'s blocks are contiguous at the end of `p.blocks` before pushing.
    let new_b0 = p.blocks.len();
    if add(f.b0, f.bc) != new_b0 {
        for bi in f.b0..add(f.b0, f.bc) {
            p.blocks.push(p.block(bi));
        }
        f.b0 = new_b0;
    }
    p.blocks.push(BlockRow { ha: ha, hn: hn, i0: 0, ic: 0, term: Term::Jump, ta: ta, tn: tn });
    f.bc = inc(f.bc);
    let _ = p.fns.try_set(fi, f);
    // Rewrite `from_blk`'s terminator target `to_rel -> at_rel`.
    let from_abs_new = add(f.b0, from_rel);
    from_blk = p.block(from_abs_new);
    if from_blk.term == Term::Branch {
        if p.op(inc(from_blk.ta)) == to_rel {
            let _ = p.ops.try_set(inc(from_blk.ta), at_rel);
        }
        if p.op(add(from_blk.ta, 2)) == to_rel {
            let _ = p.ops.try_set(add(from_blk.ta, 2), at_rel);
        }
    } else if from_blk.term == Term::Match {
        let na = p.op(inc(from_blk.ta));
        let mut pos = add(from_blk.ta, 2);
        for i in 0..na {
            pos = skip_pattern(in p, pos);
            if p.op(pos) == to_rel {
                let _ = p.ops.try_set(pos, at_rel);
            }
            pos = inc(pos);
        }
    }
}

fn emit_drop(
    inout c: Ctx,
    inout p: Program,
    fi: u64,
    in d: DropItem,
    in handles: ChunkSeq[u32],
    in effects: ChunkSeq[u32],
    inout next_val: u32,
    inout sites: ChunkSeq[DropSite],
    inout err: ChunkSeq[u8]
) -> bool {
    let f = p.function(fi);
    if d.kind == 2 {
        push_str(inout err, in "'");
        push_sym(inout err, in c.names, f.name);
        push_str(inout err, in "' drops the fields of a `");
        display(in c.types, in c.names, d.ty, inout err);
        push_str(inout err, in "` other than `");
        push_sym(inout err, in c.names, d.keep);
        push_str(
            inout err,
            in "`, and one holds a handle with a drop import; bind the value and move each handle out"
        );
        return false;
    }
    let handle = direct_or_option_handle(in c, d.ty, in handles);
    if handle == NONE32 {
        push_str(inout err, in "'");
        push_sym(inout err, in c.names, f.name);
        push_str(inout err, in "' drops a `");
        display(in c.types, in c.names, d.ty, inout err);
        push_str(
            inout err,
            in "` holding a handle with a drop import; only the handle itself or an `Option` of it is released implicitly, so move the handle out first"
        );
        return false;
    }
    let callee = drop_function(inout c, d.ty);
    let tfi = if callee == NONE32 {
        NONE64
    } else {
        find_fn_by_name(in p, callee)
    };
    if tfi == NONE64 {
        push_str(inout err, in "no drop function for `");
        display(in c.types, in c.names, d.ty, inout err);
        push_str(inout err, in "`");
        return false;
    }
    let (_, _, target_res, _, _, _) = fn_header_offsets(in p, tfi);
    let mut val = d.v;
    if d.kind == 1 {
        val = next_val;
        next_val = wrapping_add(next_val, 1);
        fn_set_value_type(inout p, fi, val, d.ty);
        let rop = p.ops.len();
        p.put(w(d.root), Tag::Name);
        p.put(d.path, Tag::Path);
        p.put(w(TyPass::Sink), Tag::Raw);
        p.put(0, Tag::Raw);
        p
            .insts
            .push(
                InstRow {
                    dest: val,
                    ty: d.ty,
                    s0: 0,
                    s1: 0,
                    has_token: 0,
                    tin: 0,
                    tout: 0,
                    fallible: 0,
                    op: Op::Read,
                    a: rop,
                    n: 4
                }
            );
    }
    let dest = next_val;
    next_val = wrapping_add(next_val, 1);
    fn_set_value_type(inout p, fi, dest, target_res);
    let cop = p.ops.len();
    p.put(w(callee), Tag::Name);
    p.put(1, Tag::Raw);
    p.put(w(TyPass::Sink), Tag::Raw);
    p.put(w(val), Tag::Value);
    p.put(0, Tag::OptName);
    p.put(0, Tag::Path);
    p.put(0, Tag::Raw);
    p.put(0, Tag::OptName);
    p
        .insts
        .push(
            InstRow {
                dest: dest,
                ty: target_res,
                s0: 0,
                s1: 0,
                has_token: 0,
                tin: 0,
                tout: 0,
                fallible: 0,
                op: Op::Call,
                a: cop,
                n: 8
            }
        );
    let hidx = list_find_u32(in handles, handle);
    sites.push(DropSite { graph: f.name, handle: handle, effect: u32_at(in effects, hidx) });
    true
}

fn apply_plan(
    inout c: Ctx,
    inout p: Program,
    fi: u64,
    in plan: FnPlan,
    in handles: ChunkSeq[u32],
    in effects: ChunkSeq[u32],
    inout sites: ChunkSeq[DropSite],
    inout err: ChunkSeq[u8]
) -> bool {
    if plan.before_inst.len() == 0
        && plan.after_inst.len() == 0
        && plan.before_term.len() == 0
        && plan.splits.len() == 0 {
        return true;
    }
    for si in 0..plan.splits.len() {
        let sp = match plan.splits.try_get(si) {
            Option::Some(x) => x,
            Option::None => continue,
        };
        split_edge(inout p, fi, sp.from, sp.to);
    }
    let (_, _, _, _, nv_op, _) = fn_header_offsets(in p, fi);
    let mut next_val = fn_max_value_id(in p, fi, nv_op);
    let f = p.function(fi);
    for b_rel in 0..f.bc {
        let mut any = false;
        for j in 0..plan.before_inst.len() {
            match plan.before_inst.try_get(j) {
                Option::Some(d) => {
                    if d.blk == b_rel {
                        any = true;
                    }
                },
                _ => {},
            }
        }
        for j in 0..plan.after_inst.len() {
            match plan.after_inst.try_get(j) {
                Option::Some(d) => {
                    if d.blk == b_rel {
                        any = true;
                    }
                },
                _ => {},
            }
        }
        for j in 0..plan.before_term.len() {
            match plan.before_term.try_get(j) {
                Option::Some(d) => {
                    if d.blk == b_rel {
                        any = true;
                    }
                },
                _ => {},
            }
        }
        if !any {
            continue;
        }
        let b_abs = add(f.b0, b_rel);
        let mut blk = p.block(b_abs);
        let old_i0 = blk.i0;
        let old_ic = blk.ic;
        let new_i0 = p.insts.len();
        for i in 0..old_ic {
            for j in 0..plan.before_inst.len() {
                match plan.before_inst.try_get(j) {
                    Option::Some(d) => {
                        if d.blk == b_rel && d.at == i {
                            if !emit_drop(
                                inout c,
                                inout p,
                                fi,
                                in d,
                                in handles,
                                in effects,
                                inout next_val,
                                inout sites,
                                inout err
                            ) {
                                return false;
                            }
                        }
                    },
                    _ => {},
                }
            }
            p.insts.push(p.inst(add(old_i0, i)));
            for j in 0..plan.after_inst.len() {
                match plan.after_inst.try_get(j) {
                    Option::Some(d) => {
                        if d.blk == b_rel && d.at == i {
                            if !emit_drop(
                                inout c,
                                inout p,
                                fi,
                                in d,
                                in handles,
                                in effects,
                                inout next_val,
                                inout sites,
                                inout err
                            ) {
                                return false;
                            }
                        }
                    },
                    _ => {},
                }
            }
        }
        for j in 0..plan.before_term.len() {
            match plan.before_term.try_get(j) {
                Option::Some(d) => {
                    if d.blk == b_rel {
                        if !emit_drop(
                            inout c,
                            inout p,
                            fi,
                            in d,
                            in handles,
                            in effects,
                            inout next_val,
                            inout sites,
                            inout err
                        ) {
                            return false;
                        }
                    }
                },
                _ => {},
            }
        }
        blk.i0 = new_i0;
        blk.ic = wrapping_sub(p.insts.len(), new_i0);
        let _ = p.blocks.try_set(b_abs, blk);
    }
    true
}

// ----- thread_tokens ----------------------------------------------------------

fn is_state_action(in c: Ctx, in p: Program, in inst: InstRow) -> bool {
    if inst.fallible != 0 {
        return true;
    }
    if inst.op == Op::Bind
        || inst.op == Op::Write
        || inst.op == Op::Call
        || inst.op == Op::Indirect
        || inst.op == Op::Try
        || inst.op == Op::Handle
        || inst.op == Op::Closure
        || inst.op == Op::Index
        || inst.op == Op::Tiled
        || inst.op == Op::Seq
        || inst.op == Op::Fip
        || inst.op == Op::Exit {
        return true;
    }
    if inst.op == Op::Binary {
        let op_sym = n32(p.op(inst.a));
        return sym_eq_str(in c.names, op_sym, in "/")
            || sym_eq_str(in c.names, op_sym, in "%")
            || sym_eq_str(in c.names, op_sym, in "<<")
            || sym_eq_str(in c.names, op_sym, in ">>");
    }
    false
}

fn thread_tokens(in c: Ctx, inout p: Program) {
    for fi in 0..p.fn_count() {
        let f = p.function(fi);
        let mut next = f.bc;
        for b_rel in 0..f.bc {
            let b_abs = add(f.b0, b_rel);
            let b = p.block(b_abs);
            let entry = b_rel;
            let mut cur = entry;
            for ii in b.i0..add(b.i0, b.ic) {
                let mut inst = p.inst(ii);
                let obs = inst.op == Op::Read;
                let act = is_state_action(in c, in p, in inst);
                if act {
                    let out_tok = next;
                    next = inc(next);
                    inst.has_token = 1;
                    inst.tin = cur;
                    inst.tout = out_tok;
                    cur = out_tok;
                } else if obs {
                    inst.has_token = 1;
                    inst.tin = cur;
                    inst.tout = cur;
                } else {
                    inst.has_token = 0;
                    inst.tin = 0;
                    inst.tout = 0;
                }
                let _ = p.insts.try_set(ii, inst);
            }
            // Write outgoing token temporarily into header word; rebuild headers after collecting edges.
            let ni = p.op(inc(b.ha));
            let _ = p.ops.try_set(b.ha, entry);
            let _ = p.ops.try_set(add(b.ha, add(2, wrapping_mul(ni, 2))), cur);
        }
        let mut edge_src = ChunkSeq::new[u64]();
        let mut edge_dst = ChunkSeq::new[u64]();
        let mut edge_tok = ChunkSeq::new[u64]();
        for b_rel in 0..f.bc {
            let b = p.block(add(f.b0, b_rel));
            let ni = p.op(inc(b.ha));
            let out_tok = p.op(add(b.ha, add(2, wrapping_mul(ni, 2))));
            if b.term == Term::Jump {
                edge_src.push(b_rel);
                edge_dst.push(p.op(b.ta));
                edge_tok.push(out_tok);
            } else if b.term == Term::Branch {
                edge_src.push(b_rel);
                edge_dst.push(p.op(inc(b.ta)));
                edge_tok.push(out_tok);
                edge_src.push(b_rel);
                edge_dst.push(p.op(add(b.ta, 2)));
                edge_tok.push(out_tok);
            } else if b.term == Term::Match {
                let na = p.op(inc(b.ta));
                let mut pos = add(b.ta, 2);
                for i in 0..na {
                    pos = skip_pattern(in p, pos);
                    edge_src.push(b_rel);
                    edge_dst.push(p.op(pos));
                    edge_tok.push(out_tok);
                    pos = inc(pos);
                }
            }
        }
        for b_rel in 0..f.bc {
            let b_abs = add(f.b0, b_rel);
            let mut b = p.block(b_abs);
            let old_ni = p.op(inc(b.ha));
            let out_tok = p.op(add(b.ha, add(2, wrapping_mul(old_ni, 2))));
            let np_pos = add(b.ha, add(3, wrapping_mul(old_ni, 2)));
            let np = p.op(np_pos);
            let mut new_ni: u64 = 0;
            for ei in 0..edge_dst.len() {
                if u64_at(in edge_dst, ei) == b_rel {
                    new_ni = inc(new_ni);
                }
            }
            let new_ha = p.ops.len();
            p.put(b_rel, Tag::Raw);
            p.put(new_ni, Tag::Raw);
            for ei in 0..edge_dst.len() {
                if u64_at(in edge_dst, ei) == b_rel {
                    p.put(u64_at(in edge_src, ei), Tag::Block);
                    p.put(u64_at(in edge_tok, ei), Tag::Raw);
                }
            }
            p.put(out_tok, Tag::Raw);
            p.put(np, Tag::Raw);
            for k in 0..np {
                p.put(p.op(add(inc(np_pos), k)), Tag::Value);
            }
            b.ha = new_ha;
            b.hn = wrapping_sub(p.ops.len(), new_ha);
            let _ = p.blocks.try_set(b_abs, b);
        }
    }
}

// ----- check_rows -------------------------------------------------------------

fn check_rows(
    in c: Ctx,
    in p: Program,
    in metas: ChunkSeq[FnMeta],
    in sites: ChunkSeq[DropSite],
    inout out: ChunkSeq[u8]
) -> bool {
    let mut seen_g = ChunkSeq::new[u32]();
    let mut seen_e = ChunkSeq::new[u32]();
    let mut any_diag = false;
    let eplen: u64 = 4;
    for si in 0..sites.len() {
        let site = match sites.try_get(si) {
            Option::Some(s) => s,
            Option::None => continue,
        };
        let fi = find_fn_by_name(in p, site.graph);
        if fi == NONE64 {
            continue;
        }
        let (_, _, _, effects_ty, _, _) = fn_header_offsets(in p, fi);
        let row = c.types.row(c.types.node(effects_ty).r2);
        let mut performs = false;
        for ei in w(row.a)..add(w(row.a), w(row.n)) {
            let eff = c.types.effect_at(ei);
            if eff.name == site.effect && eff.label == 0 {
                performs = true;
                break;
            }
        }
        if performs {
            continue;
        }
        let mut dup = false;
        for di in 0..seen_g.len() {
            if u32_at(in seen_g, di) == site.graph && u32_at(in seen_e, di) == site.effect {
                dup = true;
                break;
            }
        }
        if dup {
            continue;
        }
        seen_g.push(site.graph);
        seen_e.push(site.effect);
        any_diag = true;
        let mut s0: u64 = 0;
        let mut s1: u64 = 0;
        for mi in 0..metas.len() {
            match metas.try_get(mi) {
                Option::Some(m) => {
                    if m.name == site.graph {
                        s0 = m.s0;
                        s1 = m.s1;
                        break;
                    }
                },
                _ => {},
            }
        }
        let ea = c.names.start(site.effect);
        let ee = c.names.end(site.effect);
        let lib_a = if sym_starts_with(in c.names, site.effect, in EFFECT_PREFIX) {
            add(ea, eplen)
        } else {
            ea
        };
        push_str(inout out, in "E0401 ");
        push_decimal(inout out, s0);
        push_str(inout out, in "..");
        push_decimal(inout out, s1);
        out.push(32);
        out.push(39);
        push_sym(inout out, in c.names, site.graph);
        push_str(inout out, in "' may drop a `");
        push_sym(inout out, in c.names, site.handle);
        push_str(inout out, in "`, which calls its drop import; add Ffi[");
        for k in lib_a..ee {
            out.push(u8_at(in c.names.text, k));
        }
        push_str(inout out, in "] to its effect row\n");
    }
    ! any_diag
}

// ----- DropCallees ------------------------------------------------------------

fn parse_decimal_slice(in bytes: ChunkSeq[u8], a: u64, e: u64) -> (bool, u64) {
    if a >= e {
        return (false, 0);
    }
    let mut v: u64 = 0;
    for i in a..e {
        let ch = u8_at(in bytes, i);
        if ch < 48 || ch > 57 {
            return (false, 0);
        }
        v = add(wrapping_mul(v, 10), widen_u64(wrapping_sub(ch, 48)));
    }
    (true, v)
}

fn drop_callees_of(
    in c: Ctx,
    in p: Program,
    in metas: ChunkSeq[FnMeta],
    target: u32,
    inout out: ChunkSeq[u8]
) {
    let mut s0: u64 = 0;
    let mut s1: u64 = 0;
    let mut has_meta = false;
    for mi in 0..metas.len() {
        match metas.try_get(mi) {
            Option::Some(m) => {
                if m.name == target {
                    s0 = m.s0;
                    s1 = m.s1;
                    has_meta = true;
                    break;
                }
            },
            _ => {},
        }
    }
    if !has_meta {
        return;
    }
    let mut graphs = ChunkSeq::new[u32]();
    for fi in 0..p.fn_count() {
        let f = p.function(fi);
        let mut has_drop = false;
        for bi in f.b0..add(f.b0, f.bc) {
            let b = p.block(bi);
            for ii in b.i0..add(b.i0, b.ic) {
                let inst = p.inst(ii);
                if inst.op == Op::Call
                    && sym_starts_with(in c.names, n32(p.op(inst.a)), in DROP_PREFIX) {
                    has_drop = true;
                    break;
                }
            }
            if has_drop {
                break;
            }
        }
        if !has_drop {
            continue;
        }
        if f.name == target {
            if !list_has_u32(in graphs, f.name) {
                graphs.push(f.name);
            }
            continue;
        }
        let na = c.names.start(f.name);
        let ne = c.names.end(f.name);
        if na < ne && u8_at(in c.names.text, na) == 36 {
            // Find last two '_' in `$<name>_<start>_<end>`.
            let mut u2 = NONE64;
            let mut u1 = NONE64;
            for k in add(na, 1)..ne {
                if u8_at(in c.names.text, k) == 95 {
                    u1 = u2;
                    u2 = k;
                }
            }
            if u1 != NONE64 && u2 != NONE64 {
                let (ok1, gs) = parse_decimal_slice(in c.names.text, inc(u1), u2);
                let (ok2, ge) = parse_decimal_slice(in c.names.text, inc(u2), ne);
                if ok1 && ok2 && gs >= s0 && gs <= s1 && ge <= s1 {
                    if !list_has_u32(in graphs, f.name) {
                        graphs.push(f.name);
                    }
                }
            }
        }
    }
    // Sort `graphs` lexicographically by name.
    for i in 0..graphs.len() {
        let mut j = i;
        loop {
            if j == 0 {
                break;
            }
            let a = u32_at(in graphs, wrapping_sub(j, 1));
            let b = u32_at(in graphs, j);
            let aa = c.names.start(a);
            let ae = c.names.end(a);
            let ba = c.names.start(b);
            let be = c.names.end(b);
            if c.names.text[aa..ae].cmp(in c.names.text[ba..be]) > 0 {
                let _ = graphs.try_set(wrapping_sub(j, 1), b);
                let _ = graphs.try_set(j, a);
                j = wrapping_sub(j, 1);
            } else {
                break;
            }
        }
    }
    let mut callees = ChunkSeq::new[u32]();
    for gi in 0..graphs.len() {
        let fi = find_fn_by_name(in p, u32_at(in graphs, gi));
        if fi == NONE64 {
            continue;
        }
        let f = p.function(fi);
        for bi in f.b0..add(f.b0, f.bc) {
            let b = p.block(bi);
            for ii in b.i0..add(b.i0, b.ic) {
                let inst = p.inst(ii);
                if inst.op == Op::Call {
                    let callee = n32(p.op(inst.a));
                    if sym_starts_with(in c.names, callee, in DROP_PREFIX)
                        && !list_has_u32(in callees, callee) {
                        callees.push(callee);
                    }
                }
            }
        }
    }
    for ci in 0..callees.len() {
        if ci > 0 {
            out.push(32);
        }
        push_sym(inout out, in c.names, u32_at(in callees, ci));
    }
}

// ----- harness entry ----------------------------------------------------------

fn read_drop_item(
    inout r: Reader,
    in b: Slice[u8],
    in c: Ctx,
    inout p: Program,
    blk: u64,
    at: u64
) -> DropItem {
    let kind = wrapping_u8(r.word(in b));
    if kind == 0 {
        let v = n32(r.word(in b));
        let ty = u32_at(in c.tmap, r.word(in b));
        return DropItem { blk: blk, at: at, kind: 0, v: v, root: 0, path: 0, ty: ty, keep: 0 };
    }
    if kind == 1 {
        let root = u32_at(in c.nmap, r.word(in b));
        let plen = r.word(in b);
        let mut names = ChunkSeq::new[u32]();
        for i in 0..plen {
            names.push(u32_at(in c.nmap, r.word(in b)));
        }
        let path = p.add_path(in names);
        let ty = u32_at(in c.tmap, r.word(in b));
        return DropItem {
            blk: blk,
            at: at,
            kind: 1,
            v: 0,
            root: root,
            path: path,
            ty: ty,
            keep: 0
        };
    }
    let ty = u32_at(in c.tmap, r.word(in b));
    let keep = u32_at(in c.nmap, r.word(in b));
    DropItem { blk: blk, at: at, kind: 2, v: 0, root: 0, path: 0, ty: ty, keep: keep }
}

pub fn ffi_drops_entry(in input: Str) -> ChunkSeq[u64] {
    let b = input.as_bytes();
    let mut r = Reader { pos: 0 };
    let mut c = read_ctx(inout r, in b);
    let mut p = read_program(inout r, in b, in c);
    let nf = r.word(in b);
    let mut metas = ChunkSeq::new[FnMeta]();
    let mut fip_fns = ChunkSeq::new[u32]();
    for i in 0..nf {
        let name = u32_at(in c.nmap, r.word(in b));
        let fip = r.word(in b) != 0;
        let s0 = r.word(in b);
        let s1 = r.word(in b);
        metas.push(FnMeta { name: name, fip: fip, s0: s0, s1: s1 });
        if fip {
            fip_fns.push(name);
        }
    }
    let mode = r.word(in b);
    if mode == 1 {
        let nq = r.word(in b);
        let mut out = ChunkSeq::new[u8]();
        for i in 0..nq {
            let target = u32_at(in c.nmap, r.word(in b));
            push_sym(inout out, in c.names, target);
            push_str(inout out, in ": ");
            drop_callees_of(in c, in p, in metas, target, inout out);
            out.push(10);
        }
        return pack_text(in out);
    }
    let np = r.word(in b);
    let mut plans = ChunkSeq::new[FnPlan]();
    for i in 0..np {
        let fi = r.word(in b);
        let ok = r.word(in b) != 0;
        let mut splits = ChunkSeq::new[EdgeSplit]();
        let mut bi = ChunkSeq::new[DropItem]();
        let mut ai = ChunkSeq::new[DropItem]();
        let mut bt = ChunkSeq::new[DropItem]();
        if ok {
            let ns = r.word(in b);
            for k in 0..ns {
                let from = r.word(in b);
                let to = r.word(in b);
                splits.push(EdgeSplit { from: from, to: to });
            }
            let nbi = r.word(in b);
            for k in 0..nbi {
                let blk = r.word(in b);
                let at = r.word(in b);
                bi.push(read_drop_item(inout r, in b, in c, inout p, blk, at));
            }
            let nai = r.word(in b);
            for k in 0..nai {
                let blk = r.word(in b);
                let at = r.word(in b);
                ai.push(read_drop_item(inout r, in b, in c, inout p, blk, at));
            }
            let nbt = r.word(in b);
            for k in 0..nbt {
                let blk = r.word(in b);
                bt.push(read_drop_item(inout r, in b, in c, inout p, blk, 0));
            }
        }
        plans
            .push(
                FnPlan {
                    fi: fi,
                    ok: ok,
                    splits: splits,
                    before_inst: bi,
                    after_inst: ai,
                    before_term: bt
                }
            );
    }
    let (handles, effects) = droppable_resolved(inout c, in p);
    let mut sites = ChunkSeq::new[DropSite]();
    let mut err = ChunkSeq::new[u8]();
    let mut has_err = false;
    if handles.len() > 0 {
        for fi in 0..p.fn_count() {
            let f = p.function(fi);
            if sym_starts_with(in c.names, f.name, in DROP_PREFIX)
                || list_has_u32(in fip_fns, f.name) {
                continue;
            }
            release_wildcards(inout c, inout p, fi, in handles, in effects, inout sites);
            let mut ebuf = ChunkSeq::new[u8]();
            if !refuse_unplaced(inout c, in p, fi, in handles, inout ebuf) {
                if !has_err {
                    err = ebuf;
                    has_err = true;
                }
                continue;
            }
            let mut found_plan = false;
            for pi in 0..plans.len() {
                match plans.try_get(pi) {
                    Option::Some(pl) => {
                        if pl.fi == fi {
                            found_plan = true;
                            if !pl.ok {
                                if !has_err {
                                    push_str(inout err, in "the drops of the handles in '");
                                    push_sym(inout err, in c.names, f.name);
                                    push_str(inout err, in "' do not reach a fixed point");
                                    has_err = true;
                                }
                            } else {
                                let mut abuf = ChunkSeq::new[u8]();
                                if !apply_plan(
                                    inout c,
                                    inout p,
                                    fi,
                                    in pl,
                                    in handles,
                                    in effects,
                                    inout sites,
                                    inout abuf
                                ) {
                                    if !has_err {
                                        err = abuf;
                                        has_err = true;
                                    }
                                }
                            }
                            break;
                        }
                    },
                    _ => {},
                }
            }
            if !found_plan && !has_err {
                push_str(inout err, in "missing handle_drop_plan");
                has_err = true;
            }
        }
        thread_tokens(in c, inout p);
    }
    if has_err {
        let mut out = ChunkSeq::new[u8]();
        push_str(inout out, in "ERR ");
        out.extend(in err[0..err.len()]);
        return pack_text(in out);
    }
    let mut diag_out = ChunkSeq::new[u8]();
    if !check_rows(in c, in p, in metas, in sites, inout diag_out) {
        return pack_text(in diag_out);
    }
    let mut out = ChunkSeq::with_capacity[u64](1);
    out.push(0);
    put_program(in p, in c.types, in c.names, inout out);
    out
}
