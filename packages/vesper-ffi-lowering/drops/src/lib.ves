// @vesper/ffi-drops: `src/ffi_lowering/drops.rs` (`insert`, `check_rows`,
// `DropCallees`) in Vesper over `@vesper/place-ir` and `@vesper/check-data`
// (self-hosting SH4 lane 13, #1287 / #1714).

use @vesper/check-data::{pack_text};
use @vesper/check-data::input::{Ctx, Reader, read_ctx};
use @vesper/check-data::names::{Names};
use @vesper/check-data::types::{TyKind, TyPass, Types, Vars, display, substitute, vars_new};
use @vesper/check-data::util::{add, inc, n32, push_decimal, u32_at, u64_at, u8_at, w};
use @vesper/check-data::world::{Adt, World, constructor, field_step};
use @vesper/place-ir::{BlockRow, FnRow, InstRow, Program, put_program, read_program};
use @vesper/place-ir::codes::{Op, Pat, Tag, Term};

const NONE32: u32 = 4294967295;
const NONE64: u64 = 18446744073709551615;
const DROP_PREFIX: Str = "$drop$";
const DROP_OPTION_PREFIX: Str = "$drop$Option$";
const EFFECT_PREFIX: Str = "Ffi$";

pub copy struct FnMeta {
    name: u32,
    fip: bool,
    span_start: u64,
    span_end: u64,
}

pub copy struct DropSite {
    graph: u32,
    handle: u32,
    effect: u32,
}

pub copy struct DropItem {
    block: u64,
    at: u64,
    // 0 = Value(v, ty), 1 = Place(root, path, ty), 2 = OtherFields(ty, keep)
    kind: u8,
    value: u32,
    root: u32,
    path: u64,
    ty: u32,
    keep: u32,
}

pub copy struct EdgeSplit {
    from: u64,
    to: u64,
}

pub struct FnPlan {
    fi: u64,
    ok: bool,
    splits: ChunkSeq[EdgeSplit],
    before_inst: ChunkSeq[DropItem],
    after_inst: ChunkSeq[DropItem],
    before_term: ChunkSeq[DropItem],
}

fn push_str(inout out: ChunkSeq[u8], in text: Str) {
    out.extend(in text.as_bytes());
}

fn push_sym(inout out: ChunkSeq[u8], in names: Names, sym: u32) {
    let lo = names.start(sym);
    let hi = names.end(sym);
    for i in lo..hi {
        out.push(u8_at(in names.text, i));
    }
}

fn sym_starts_with(in names: Names, sym: u32, in prefix: Str) -> bool {
    let lo = names.start(sym);
    let hi = names.end(sym);
    let prefix_bytes = prefix.as_bytes();
    if wrapping_sub(hi, lo) < prefix_bytes.len() {
        return false;
    }
    for i in 0..prefix_bytes.len() {
        let expected = prefix_bytes.try_get(i).unwrap_or(0);
        if u8_at(in names.text, add(lo, i)) != expected {
            return false;
        }
    }
    true
}

fn sym_has_byte(in names: Names, sym: u32, byte: u8) -> bool {
    let lo = names.start(sym);
    let hi = names.end(sym);
    for i in lo..hi {
        if u8_at(in names.text, i) == byte {
            return true;
        }
    }
    false
}

fn sym_eq_str(in names: Names, sym: u32, in text: Str) -> bool {
    let lo = names.start(sym);
    let hi = names.end(sym);
    let text_bytes = text.as_bytes();
    if wrapping_sub(hi, lo) != text_bytes.len() {
        return false;
    }
    for i in 0..text_bytes.len() {
        let expected = text_bytes.try_get(i).unwrap_or(0);
        if u8_at(in names.text, add(lo, i)) != expected {
            return false;
        }
    }
    true
}

// Interns `prefix + sym_text` in `names`.
fn intern_prefixed(inout names: Names, in prefix: Str, sym: u32) -> u32 {
    let prefix_bytes = prefix.as_bytes();
    let lo = names.start(sym);
    let hi = names.end(sym);
    let mut buf = ChunkSeq::with_capacity[u8](add(prefix_bytes.len(), wrapping_sub(hi, lo)));
    buf.extend(in prefix_bytes);
    for i in lo..hi {
        buf.push(u8_at(in names.text, i));
    }
    names.intern(in buf[0..buf.len()])
}

fn list_has_u32(in xs: ChunkSeq[u32], x: u32) -> bool {
    for i in 0..xs.len() {
        if u32_at(in xs, i) == x {
            return true;
        }
    }
    false
}

fn list_find_u32(in xs: ChunkSeq[u32], x: u32) -> u64 {
    for i in 0..xs.len() {
        if u32_at(in xs, i) == x {
            return i;
        }
    }
    NONE64
}

// ----- function header helpers ------------------------------------------------

// Parses the header of function `fi` and returns:
// (params_count, params_start_op, result_ty, effects_ty, bounds_op, captures_op, nv_op, locals_op).
fn fn_header_offsets(in program: Program, fi: u64) -> (u64, u64, u32, u32, u64, u64) {
    let func = program.function(fi);
    let mut pos = func.ha;
    let param_count = program.op(pos);
    pos = inc(pos);
    let params_op = pos;
    for i in 0..param_count {
        // name, pass, nproj
        let nproj = program.op(add(pos, 2));
        // 3 + nproj + 3 (type, s0, s1)
        pos = add(pos, add(6, nproj));
    }
    let result_ty = n32(program.op(pos));
    let effects_ty = n32(program.op(inc(pos)));
    pos = add(pos, 2);
    // bounds: nb, nb x (name, mode)
    let bound_count = program.op(pos);
    pos = add(inc(pos), wrapping_mul(bound_count, 2));
    // captures: nc, nc x name
    let capture_count = program.op(pos);
    pos = add(inc(pos), capture_count);
    let nv_op = pos;
    let value_count = program.op(pos);
    pos = add(inc(pos), wrapping_mul(value_count, 2));
    let locals_op = pos;
    (param_count, params_op, result_ty, effects_ty, nv_op, locals_op)
}

fn fn_value_type(in program: Program, nv_op: u64, value: u32) -> u32 {
    let value_count = program.op(nv_op);
    for i in 0..value_count {
        let base = add(inc(nv_op), wrapping_mul(i, 2));
        if n32(program.op(base)) == value {
            return n32(program.op(inc(base)));
        }
    }
    NONE32
}

fn fn_local_or_param_type(
    in program: Program,
    param_count: u64,
    params_op: u64,
    locals_op: u64,
    name: u32
) -> u32 {
    // locals first (matches drops.rs:324-327)
    let local_count = program.op(locals_op);
    for i in 0..local_count {
        let base = add(inc(locals_op), wrapping_mul(i, 2));
        if n32(program.op(base)) == name {
            return n32(program.op(inc(base)));
        }
    }
    let mut pos = params_op;
    for i in 0..param_count {
        let param_name = n32(program.op(pos));
        let nproj = program.op(add(pos, 2));
        if param_name == name {
            return n32(program.op(add(pos, add(3, nproj))));
        }
        pos = add(pos, add(6, nproj));
    }
    NONE32
}

// Rebuilds `func`'s header with `value -> ty` inserted/updated in `values`.
fn fn_set_value_type(inout program: Program, fi: u64, value: u32, ty: u32) {
    let (_, _, _, _, nv_op, locals_op) = fn_header_offsets(in program, fi);
    let value_count = program.op(nv_op);
    for i in 0..value_count {
        let base = add(inc(nv_op), wrapping_mul(i, 2));
        if n32(program.op(base)) == value {
            let _ = program.ops.try_set(inc(base), w(ty));
            return;
        }
    }
    // Rebuild header in p.ops with (v, ty) appended in sorted ValueId order or at end.
    let mut func = program.function(fi);
    let new_header = program.ops.len();
    for pos in func.ha..inc(nv_op) {
        if pos == nv_op {
            program.put(inc(value_count), Tag::Raw);
        } else {
            program.put(program.op(pos), program.tag(pos));
        }
    }
    let mut inserted = false;
    for i in 0..value_count {
        let base = add(inc(nv_op), wrapping_mul(i, 2));
        let entry_value = n32(program.op(base));
        if !inserted && value < entry_value {
            program.put(w(value), Tag::Value);
            program.put(w(ty), Tag::Type);
            inserted = true;
        }
        program.put(w(entry_value), Tag::Value);
        program.put(program.op(inc(base)), Tag::Type);
    }
    if !inserted {
        program.put(w(value), Tag::Value);
        program.put(w(ty), Tag::Type);
    }
    let tail_start = add(inc(nv_op), wrapping_mul(value_count, 2));
    let tail_end = add(func.ha, func.hn);
    for pos in tail_start..tail_end {
        program.put(program.op(pos), program.tag(pos));
    }
    func.ha = new_header;
    func.hn = wrapping_sub(program.ops.len(), new_header);
    let _ = program.fns.try_set(fi, func);
}

fn fn_max_value_id(in program: Program, fi: u64, nv_op: u64) -> u32 {
    let mut max_id: u32 = 0;
    let mut has = false;
    let value_count = program.op(nv_op);
    for i in 0..value_count {
        let value = n32(program.op(add(inc(nv_op), wrapping_mul(i, 2))));
        if !has || value > max_id {
            max_id = value;
            has = true;
        }
    }
    let func = program.function(fi);
    for bi in func.b0..add(func.b0, func.bc) {
        let block = program.block(bi);
        let nbp = program.op(add(block.ha, add(3, wrapping_mul(program.op(inc(block.ha)), 2))));
        // Actually read block header: entry_token(0), ni(1), ni*2 pairs, outgoing, np, np values
        let incoming_count = program.op(inc(block.ha));
        let param_pos = add(block.ha, add(3, wrapping_mul(incoming_count, 2)));
        let param_count = program.op(param_pos);
        for k in 0..param_count {
            let value = n32(program.op(add(inc(param_pos), k)));
            if !has || value > max_id {
                max_id = value;
                has = true;
            }
        }
        for ii in block.i0..add(block.i0, block.ic) {
            let inst = program.inst(ii);
            if !has || inst.dest > max_id {
                max_id = inst.dest;
                has = true;
            }
        }
    }
    if has { wrapping_add(max_id, 1) } else { 0 }
}

fn find_fn_by_name(in program: Program, name: u32) -> u64 {
    for fi in 0..program.fn_count() {
        if program.function(fi).name == name {
            return fi;
        }
    }
    NONE64
}

// ----- droppable handles & drop_function --------------------------------------

// Returns parallel `(handles, effects)` for every `$drop$<H>` function in `program`.
fn droppable(in ctx: Ctx, in program: Program) -> (ChunkSeq[u32], ChunkSeq[u32]) {
    let mut handles = ChunkSeq::new[u32]();
    let mut effects = ChunkSeq::new[u32]();
    let prefix_len: u64 = 6;
    for fi in 0..program.fn_count() {
        let func = program.function(fi);
        if !sym_starts_with(in ctx.names, func.name, in DROP_PREFIX) {
            continue;
        }
        let lo = ctx.names.start(func.name);
        let hi = ctx.names.end(func.name);
        let mut has_dollar = false;
        for i in add(lo, prefix_len)..hi {
            if u8_at(in ctx.names.text, i) == 36 {
                has_dollar = true;
            }
        }
        if has_dollar {
            continue;
        }
        let (_, _, _, effects_ty, _, _) = fn_header_offsets(in program, fi);
        let row_id = ctx.types.node(effects_ty).r2;
        let row = ctx.types.row(row_id);
        if row.n == 0 {
            continue;
        }
        let eff_name = ctx.types.effect_at(w(row.a)).name;
        // Intern handle name directly from slice (no mutation needed if we pass inout names,
        // or we compare bytes; here we intern into a copy or pass inout c.names).
        // Note: handled in caller with `inout c`.
        handles.push(func.name);
        effects.push(eff_name);
    }
    (handles, effects)
}

fn droppable_resolved(inout ctx: Ctx, in program: Program) -> (ChunkSeq[u32], ChunkSeq[u32]) {
    let (raw_fns, effects) = droppable(in ctx, in program);
    let mut handles = ChunkSeq::new[u32]();
    let prefix_len: u64 = 6;
    for i in 0..raw_fns.len() {
        let fn_sym = u32_at(in raw_fns, i);
        let lo = ctx.names.start(fn_sym);
        let hi = ctx.names.end(fn_sym);
        let mut buf = ChunkSeq::new[u8]();
        for k in add(lo, prefix_len)..hi {
            buf.push(u8_at(in ctx.names.text, k));
        }
        handles.push(ctx.names.intern(in buf[0..buf.len()]));
    }
    (handles, effects)
}

fn drop_function(inout ctx: Ctx, ty: u32) -> u32 {
    let node = ctx.types.node(ty);
    if node.kind != TyKind::Named {
        return NONE32;
    }
    if node.n == 0 {
        return intern_prefixed(inout ctx.names, in DROP_PREFIX, node.name);
    }
    if sym_eq_str(in ctx.names, node.name, in "Option") && node.n == 1 {
        let inner = ctx.types.arg(ty, 0);
        let inner_node = ctx.types.node(inner);
        if inner_node.kind == TyKind::Named && inner_node.n == 0 {
            return intern_prefixed(inout ctx.names, in DROP_OPTION_PREFIX, inner_node.name);
        }
    }
    NONE32
}

// Whether `ty` is `H` or `Option[H]` for some `H` in `handles`; returns `H` or `NONE32`.
fn direct_or_option_handle(in ctx: Ctx, ty: u32, in handles: ChunkSeq[u32]) -> u32 {
    let node = ctx.types.node(ty);
    if node.kind != TyKind::Named {
        return NONE32;
    }
    if node.n == 0 && list_has_u32(in handles, node.name) {
        return node.name;
    }
    if sym_eq_str(in ctx.names, node.name, in "Option") && node.n == 1 {
        let inner = ctx.types.arg(ty, 0);
        let inner_node = ctx.types.node(inner);
        if inner_node.kind == TyKind::Named
            && inner_node.n == 0
            && list_has_u32(in handles, inner_node.name) {
            return inner_node.name;
        }
    }
    NONE32
}

// ----- holds ------------------------------------------------------------------

fn holds(inout ctx: Ctx, ty: u32, in handles: ChunkSeq[u32], inout seen: ChunkSeq[u32]) -> bool {
    let node = ctx.types.node(ty);
    if node.kind == TyKind::Named {
        if list_has_u32(in handles, node.name) {
            return true;
        }
        let arity = ctx.types.arity(ty);
        for i in 0..arity {
            if holds(inout ctx, ctx.types.arg(ty, i), in handles, inout seen) {
                return true;
            }
        }
        if list_has_u32(in seen, node.name) {
            return false;
        }
        seen.push(node.name);
        let adt_index = ctx.world.lookup(node.name);
        let mut found = false;
        if adt_index != NONE32 {
            let adt = ctx.world.adt(adt_index);
            let vars = ctx.world.vars_of(in ctx.types, adt, ty);
            for vi in w(adt.va)..add(w(adt.va), w(adt.vn)) {
                let variant = ctx.world.variant(vi);
                for fi in w(variant.fa)..add(w(variant.fa), w(variant.fc)) {
                    let field = ctx.world.field(fi);
                    let sub = substitute(inout ctx.types, field.ty, in vars);
                    if holds(inout ctx, sub, in handles, inout seen) {
                        found = true;
                        break;
                    }
                }
                if found {
                    break;
                }
            }
        }
        if seen.len() > 0 {
            seen.truncate(wrapping_sub(seen.len(), 1));
        }
        return found;
    }
    if node.kind == TyKind::Tuple {
        let arity = ctx.types.arity(ty);
        for i in 0..arity {
            if holds(inout ctx, ctx.types.arg(ty, i), in handles, inout seen) {
                return true;
            }
        }
    }
    false
}

// ----- pattern helpers --------------------------------------------------------

// Skips one pattern in `p.ops` from `pos` and returns the next op index.
fn skip_pattern(in program: Program, start_pos: u64) -> u64 {
    let mut pos = start_pos;
    let kind = n32(program.op(pos));
    pos = add(pos, 3);
    if kind == Pat::Wild {
        return pos;
    }
    if kind == Pat::Bind {
        return inc(pos);
    }
    if kind == Pat::Literal {
        // lit kind + 2 words
        return add(pos, 3);
    }
    if kind == Pat::Tuple {
        let n = program.op(pos);
        pos = inc(pos);
        for i in 0..n {
            pos = skip_pattern(in program, pos);
        }
        return pos;
    }
    if kind == Pat::Constructor {
        // name, named, n, n x (field_name, pattern)
        let n = program.op(add(pos, 2));
        pos = add(pos, 3);
        for i in 0..n {
            pos = inc(pos);
            pos = skip_pattern(in program, pos);
        }
        return pos;
    }
    pos
}

fn collect_pattern_bound_names(
    in program: Program,
    start_pos: u64,
    inout names: ChunkSeq[u32]
) -> u64 {
    let mut pos = start_pos;
    let kind = n32(program.op(pos));
    pos = add(pos, 3);
    if kind == Pat::Wild {
        return pos;
    }
    if kind == Pat::Bind {
        let name = n32(program.op(pos));
        if !list_has_u32(in names, name) {
            names.push(name);
        }
        return inc(pos);
    }
    if kind == Pat::Literal {
        return add(pos, 3);
    }
    if kind == Pat::Tuple {
        let n = program.op(pos);
        pos = inc(pos);
        for i in 0..n {
            pos = collect_pattern_bound_names(in program, pos, inout names);
        }
        return pos;
    }
    if kind == Pat::Constructor {
        let n = program.op(add(pos, 2));
        pos = add(pos, 3);
        for i in 0..n {
            pos = inc(pos);
            pos = collect_pattern_bound_names(in program, pos, inout names);
        }
        return pos;
    }
    pos
}

// ----- borrowed_scrutinees ----------------------------------------------------

fn borrowed_scrutinees(in ctx: Ctx, in program: Program, fi: u64) -> ChunkSeq[u32] {
    let func = program.function(fi);
    let mut matched = ChunkSeq::new[u32]();
    for bi in func.b0..add(func.b0, func.bc) {
        let block = program.block(bi);
        if block.term == Term::Match {
            let scrutinee = n32(program.op(block.ta));
            if !list_has_u32(in matched, scrutinee) {
                matched.push(scrutinee);
            }
        }
    }
    let (param_count, params_op, _, _, _, _) = fn_header_offsets(in program, fi);
    let mut bound_names = ChunkSeq::new[u32]();
    let mut pos = params_op;
    for i in 0..param_count {
        let param_name = n32(program.op(pos));
        let pass = program.op(inc(pos));
        let nproj = program.op(add(pos, 2));
        if pass != w(TyPass::Sink) && !list_has_u32(in bound_names, param_name) {
            bound_names.push(param_name);
        }
        pos = add(pos, add(6, nproj));
    }
    let mut out = ChunkSeq::new[u32]();
    loop {
        let bound_len = bound_names.len();
        let out_len = out.len();
        for bi in func.b0..add(func.b0, func.bc) {
            let block = program.block(bi);
            for ii in block.i0..add(block.i0, block.ic) {
                let inst = program.inst(ii);
                if inst.op == Op::Read {
                    let root = n32(program.op(inst.a));
                    if list_has_u32(in matched, inst.dest)
                        && list_has_u32(in bound_names, root)
                        && !list_has_u32(in out, inst.dest) {
                        out.push(inst.dest);
                    }
                } else if inst.op == Op::Seq {
                    let row = program.pool_row(program.op(inst.a));
                    if (
                        sym_eq_str(in ctx.names, row.label, in "TryGet")
                            || sym_eq_str(in ctx.names, row.label, in "Hoisted(TryGet)")
                    )
                        && list_has_u32(in matched, inst.dest)
                        && !list_has_u32(in out, inst.dest) {
                        out.push(inst.dest);
                    }
                } else if inst.op == Op::Bind {
                    let bound_value = n32(program.op(inst.a));
                    if list_has_u32(in out, bound_value) {
                        let _ = collect_pattern_bound_names(
                            in program,
                            inc(inst.a),
                            inout bound_names
                        );
                    }
                }
            }
        }
        if bound_names.len() == bound_len && out.len() == out_len {
            return out;
        }
    }
}

// ----- release_wildcards ------------------------------------------------------

fn release_wildcards(
    inout ctx: Ctx,
    inout program: Program,
    fi: u64,
    in handles: ChunkSeq[u32],
    in effects: ChunkSeq[u32],
    inout sites: ChunkSeq[DropSite]
) {
    let borrowed = borrowed_scrutinees(in ctx, in program, fi);
    let func = program.function(fi);
    let (_, _, _, _, nv_op, _) = fn_header_offsets(in program, fi);
    for bi in func.b0..add(func.b0, func.bc) {
        let block = program.block(bi);
        for ii in block.i0..add(block.i0, block.ic) {
            let mut inst = program.inst(ii);
            if inst.op != Op::Bind {
                continue;
            }
            let value = n32(program.op(inst.a));
            let pat_kind = n32(program.op(inc(inst.a)));
            if pat_kind != Pat::Wild || list_has_u32(in borrowed, value) {
                continue;
            }
            let ty = fn_value_type(in program, nv_op, value);
            if ty == NONE32 {
                continue;
            }
            let handle = direct_or_option_handle(in ctx, ty, in handles);
            if handle == NONE32 {
                continue;
            }
            let callee = drop_function(inout ctx, ty);
            if callee == NONE32 {
                continue;
            }
            let drop_fi = find_fn_by_name(in program, callee);
            if drop_fi == NONE64 {
                continue;
            }
            let (_, _, target_res, _, _, _) = fn_header_offsets(in program, drop_fi);
            let op_start = program.ops.len();
            program.put(w(callee), Tag::Name);
            program.put(1, Tag::Raw);
            program.put(w(TyPass::Sink), Tag::Raw);
            program.put(w(value), Tag::Value);
            program.put(0, Tag::OptName);
            program.put(0, Tag::Path);
            program.put(0, Tag::Raw);
            program.put(0, Tag::OptName);
            inst.op = Op::Call;
            inst.a = op_start;
            inst.n = 8;
            inst.ty = target_res;
            let _ = program.insts.try_set(ii, inst);
            fn_set_value_type(inout program, fi, inst.dest, target_res);
            let handle_index = list_find_u32(in handles, handle);
            sites.push(
                DropSite {
                    graph: func.name,
                    handle: handle,
                    effect: u32_at(in effects, handle_index)
                }
            );
        }
    }
}

// ----- refuse_unplaced --------------------------------------------------------

fn wild_handle(
    inout ctx: Ctx,
    in program: Program,
    start_pos: u64,
    ty: u32,
    in handles: ChunkSeq[u32]
) -> (bool, u64) {
    let mut pos = start_pos;
    let kind = n32(program.op(pos));
    pos = add(pos, 3);
    if kind == Pat::Wild {
        let mut seen = ChunkSeq::new[u32]();
        return (holds(inout ctx, ty, in handles, inout seen), pos);
    }
    if kind == Pat::Bind {
        return (false, inc(pos));
    }
    if kind == Pat::Literal {
        return (false, add(pos, 3));
    }
    if kind == Pat::Tuple {
        let n = program.op(pos);
        pos = inc(pos);
        let ty_node = ctx.types.node(ty);
        let mut any = false;
        for i in 0..n {
            let sub_ty = if ty_node.kind == TyKind::Tuple && i < ctx.types.arity(ty) {
                ctx.types.arg(ty, i)
            } else {
                ctx.types.unit
            };
            let (hit, next) = wild_handle(inout ctx, in program, pos, sub_ty, in handles);
            pos = next;
            if ty_node.kind == TyKind::Tuple && hit {
                any = true;
            }
        }
        return (any, pos);
    }
    if kind == Pat::Constructor {
        let ctor_name = n32(program.op(pos));
        let _named = program.op(inc(pos));
        let n = program.op(add(pos, 2));
        pos = add(pos, 3);
        let ty_node = ctx.types.node(ty);
        if ty_node.kind != TyKind::Named {
            for i in 0..n {
                pos = inc(pos);
                pos = skip_pattern(in program, pos);
            }
            return (false, pos);
        }
        let packed = constructor(in ctx.world, NONE32, ctor_name);
        if packed == NONE64 {
            for i in 0..n {
                pos = inc(pos);
                pos = skip_pattern(in program, pos);
            }
            return (false, pos);
        }
        let adt_index = wrapping_u32(packed >> 32);
        let variant_index = packed & 4294967295;
        let adt = ctx.world.adt(adt_index);
        let variant = ctx.world.variant(variant_index);
        let vars = ctx.world.vars_of(in ctx.types, adt, ty);
        let mut any = false;
        for i in 0..n {
            let field_name = n32(program.op(pos));
            pos = inc(pos);
            let field_ty = ctx.world.find_field(variant, field_name);
            if field_ty != NONE32 {
                let sub_ty = substitute(inout ctx.types, field_ty, in vars);
                let (hit, next) = wild_handle(inout ctx, in program, pos, sub_ty, in handles);
                pos = next;
                if hit {
                    any = true;
                }
            } else {
                pos = skip_pattern(in program, pos);
            }
        }
        return (any, pos);
    }
    (false, pos)
}

fn refuse_unplaced(
    inout ctx: Ctx,
    in program: Program,
    fi: u64,
    in handles: ChunkSeq[u32],
    inout err: ChunkSeq[u8]
) -> bool {
    let borrowed = borrowed_scrutinees(in ctx, in program, fi);
    let func = program.function(fi);
    let (param_count, params_op, _, _, nv_op, locals_op) = fn_header_offsets(in program, fi);
    for bi in func.b0..add(func.b0, func.bc) {
        let block = program.block(bi);
        for ii in block.i0..add(block.i0, block.ic) {
            let inst = program.inst(ii);
            if inst.op == Op::Bind {
                let value = n32(program.op(inst.a));
                if !list_has_u32(in borrowed, value) {
                    let ty = fn_value_type(in program, nv_op, value);
                    if ty != NONE32 {
                        let (hit, _) = wild_handle(
                            inout ctx,
                            in program,
                            inc(inst.a),
                            ty,
                            in handles
                        );
                        if hit {
                            err.push(39);
                            push_sym(inout err, in ctx.names, func.name);
                            push_str(
                                inout err,
                                in "' discards a handle with a drop import with `_` inside a pattern; bind it to a name so it is released"
                            );
                            return false;
                        }
                    }
                }
            } else if inst.op == Op::Closure {
                // operands: pool(0), captures(1): nc, nc x (name, name), moves: nm, nm x (root, path)
                let capture_count = program.op(inc(inst.a));
                let moves_pos = add(add(inst.a, 2), wrapping_mul(capture_count, 2));
                let move_count = program.op(moves_pos);
                for move_index in 0..move_count {
                    let move_pos = add(inc(moves_pos), wrapping_mul(move_index, 2));
                    let root = n32(program.op(move_pos));
                    let path_idx = program.op(inc(move_pos));
                    let base_ty = fn_local_or_param_type(
                        in program,
                        param_count,
                        params_op,
                        locals_op,
                        root
                    );
                    if base_ty == NONE32 {
                        continue;
                    }
                    let path_row = program.path(path_idx);
                    let mut ty = base_ty;
                    let mut ok = true;
                    for k in 0..path_row.n {
                        let fname = program.path_name(path_idx, k);
                        let next_ty = field_step(
                            inout ctx.types,
                            inout ctx.names,
                            in ctx.world,
                            ty,
                            fname,
                            false
                        );
                        if next_ty == NONE32 {
                            ok = false;
                            break;
                        }
                        ty = next_ty;
                    }
                    if ok {
                        let mut seen = ChunkSeq::new[u32]();
                        if holds(inout ctx, ty, in handles, inout seen) {
                            err.push(39);
                            push_sym(inout err, in ctx.names, func.name);
                            push_str(
                                inout err,
                                in "' moves a handle with a drop import into a closure; a dropped closure does not release it, so pass the handle to the closure's call instead"
                            );
                            return false;
                        }
                    }
                }
            }
        }
    }
    true
}

// ----- split_edge & apply -----------------------------------------------------

fn split_edge(inout program: Program, fi: u64, from_rel: u64, to_rel: u64) {
    let mut func = program.function(fi);
    let at_rel = func.bc;
    let from_abs = add(func.b0, from_rel);
    let to_abs = add(func.b0, to_rel);
    let mut from_blk = program.block(from_abs);
    // Outgoing token of `from_blk`: header word at 2 + ni * 2
    let incoming_count = program.op(inc(from_blk.ha));
    let token = program.op(add(from_blk.ha, add(2, wrapping_mul(incoming_count, 2))));
    // Build new block header: entry_token, 1, (from_rel, token), outgoing_token, 0 params
    let header_start = program.ops.len();
    program.put(token, Tag::Raw);
    program.put(1, Tag::Raw);
    program.put(from_rel, Tag::Block);
    program.put(token, Tag::Raw);
    program.put(token, Tag::Raw);
    program.put(0, Tag::Raw);
    let header_len = wrapping_sub(program.ops.len(), header_start);
    // Terminator: Jump { block: to_rel, args: [] }
    let term_start = program.ops.len();
    program.put(to_rel, Tag::Block);
    program.put(0, Tag::Raw);
    let term_len = wrapping_sub(program.ops.len(), term_start);
    // Ensure `func`'s blocks are contiguous at the end of `p.blocks` before pushing.
    let new_b0 = program.blocks.len();
    if add(func.b0, func.bc) != new_b0 {
        for bi in func.b0..add(func.b0, func.bc) {
            program.blocks.push(program.block(bi));
        }
        func.b0 = new_b0;
    }
    program.blocks.push(
        BlockRow {
            ha: header_start,
            hn: header_len,
            i0: 0,
            ic: 0,
            term: Term::Jump,
            ta: term_start,
            tn: term_len
        }
    );
    func.bc = inc(func.bc);
    let _ = program.fns.try_set(fi, func);
    // Rewrite `from_blk`'s terminator target `to_rel -> at_rel`.
    let from_abs_new = add(func.b0, from_rel);
    from_blk = program.block(from_abs_new);
    if from_blk.term == Term::Branch {
        if program.op(inc(from_blk.ta)) == to_rel {
            let _ = program.ops.try_set(inc(from_blk.ta), at_rel);
        }
        if program.op(add(from_blk.ta, 2)) == to_rel {
            let _ = program.ops.try_set(add(from_blk.ta, 2), at_rel);
        }
    } else if from_blk.term == Term::Match {
        let arm_count = program.op(inc(from_blk.ta));
        let mut pos = add(from_blk.ta, 2);
        for i in 0..arm_count {
            pos = skip_pattern(in program, pos);
            if program.op(pos) == to_rel {
                let _ = program.ops.try_set(pos, at_rel);
            }
            pos = inc(pos);
        }
    }
}

fn emit_drop(
    inout ctx: Ctx,
    inout program: Program,
    fi: u64,
    in item: DropItem,
    in handles: ChunkSeq[u32],
    in effects: ChunkSeq[u32],
    inout next_val: u32,
    inout sites: ChunkSeq[DropSite],
    inout err: ChunkSeq[u8]
) -> bool {
    let func = program.function(fi);
    if item.kind == 2 {
        push_str(inout err, in "'");
        push_sym(inout err, in ctx.names, func.name);
        push_str(inout err, in "' drops the fields of a `");
        display(in ctx.types, in ctx.names, item.ty, inout err);
        push_str(inout err, in "` other than `");
        push_sym(inout err, in ctx.names, item.keep);
        push_str(
            inout err,
            in "`, and one holds a handle with a drop import; bind the value and move each handle out"
        );
        return false;
    }
    let handle = direct_or_option_handle(in ctx, item.ty, in handles);
    if handle == NONE32 {
        push_str(inout err, in "'");
        push_sym(inout err, in ctx.names, func.name);
        push_str(inout err, in "' drops a `");
        display(in ctx.types, in ctx.names, item.ty, inout err);
        push_str(
            inout err,
            in "` holding a handle with a drop import; only the handle itself or an `Option` of it is released implicitly, so move the handle out first"
        );
        return false;
    }
    let callee = drop_function(inout ctx, item.ty);
    let drop_fi = if callee == NONE32 {
        NONE64
    } else {
        find_fn_by_name(in program, callee)
    };
    if drop_fi == NONE64 {
        push_str(inout err, in "no drop function for `");
        display(in ctx.types, in ctx.names, item.ty, inout err);
        push_str(inout err, in "`");
        return false;
    }
    let (_, _, target_res, _, _, _) = fn_header_offsets(in program, drop_fi);
    let mut value = item.value;
    if item.kind == 1 {
        value = next_val;
        next_val = wrapping_add(next_val, 1);
        fn_set_value_type(inout program, fi, value, item.ty);
        let read_ops = program.ops.len();
        program.put(w(item.root), Tag::Name);
        program.put(item.path, Tag::Path);
        program.put(w(TyPass::Sink), Tag::Raw);
        program.put(0, Tag::Raw);
        program.insts.push(
            InstRow {
                dest: value,
                ty: item.ty,
                s0: 0,
                s1: 0,
                has_token: 0,
                tin: 0,
                tout: 0,
                fallible: 0,
                op: Op::Read,
                a: read_ops,
                n: 4
            }
        );
    }
    let dest = next_val;
    next_val = wrapping_add(next_val, 1);
    fn_set_value_type(inout program, fi, dest, target_res);
    let call_ops = program.ops.len();
    program.put(w(callee), Tag::Name);
    program.put(1, Tag::Raw);
    program.put(w(TyPass::Sink), Tag::Raw);
    program.put(w(value), Tag::Value);
    program.put(0, Tag::OptName);
    program.put(0, Tag::Path);
    program.put(0, Tag::Raw);
    program.put(0, Tag::OptName);
    program.insts.push(
        InstRow {
            dest: dest,
            ty: target_res,
            s0: 0,
            s1: 0,
            has_token: 0,
            tin: 0,
            tout: 0,
            fallible: 0,
            op: Op::Call,
            a: call_ops,
            n: 8
        }
    );
    let handle_index = list_find_u32(in handles, handle);
    sites.push(
        DropSite { graph: func.name, handle: handle, effect: u32_at(in effects, handle_index) }
    );
    true
}

fn apply_plan(
    inout ctx: Ctx,
    inout program: Program,
    fi: u64,
    in plan: FnPlan,
    in handles: ChunkSeq[u32],
    in effects: ChunkSeq[u32],
    inout sites: ChunkSeq[DropSite],
    inout err: ChunkSeq[u8]
) -> bool {
    if plan.before_inst.len() == 0
        && plan.after_inst.len() == 0
        && plan.before_term.len() == 0
        && plan.splits.len() == 0 {
        return true;
    }
    for si in 0..plan.splits.len() {
        let split = match plan.splits.try_get(si) {
            Option::Some(x) => x,
            Option::None => continue,
        };
        split_edge(inout program, fi, split.from, split.to);
    }
    let (_, _, _, _, nv_op, _) = fn_header_offsets(in program, fi);
    let mut next_val = fn_max_value_id(in program, fi, nv_op);
    let func = program.function(fi);
    for b_rel in 0..func.bc {
        let mut any = false;
        for j in 0..plan.before_inst.len() {
            match plan.before_inst.try_get(j) {
                Option::Some(item) => {
                    if item.block == b_rel {
                        any = true;
                    }
                },
                _ => {},
            }
        }
        for j in 0..plan.after_inst.len() {
            match plan.after_inst.try_get(j) {
                Option::Some(item) => {
                    if item.block == b_rel {
                        any = true;
                    }
                },
                _ => {},
            }
        }
        for j in 0..plan.before_term.len() {
            match plan.before_term.try_get(j) {
                Option::Some(item) => {
                    if item.block == b_rel {
                        any = true;
                    }
                },
                _ => {},
            }
        }
        if !any {
            continue;
        }
        let block_index = add(func.b0, b_rel);
        let mut block = program.block(block_index);
        let old_i0 = block.i0;
        let old_ic = block.ic;
        let new_i0 = program.insts.len();
        for i in 0..old_ic {
            for j in 0..plan.before_inst.len() {
                match plan.before_inst.try_get(j) {
                    Option::Some(item) => {
                        if item.block == b_rel && item.at == i {
                            if !emit_drop(
                                inout ctx,
                                inout program,
                                fi,
                                in item,
                                in handles,
                                in effects,
                                inout next_val,
                                inout sites,
                                inout err
                            ) {
                                return false;
                            }
                        }
                    },
                    _ => {},
                }
            }
            program.insts.push(program.inst(add(old_i0, i)));
            for j in 0..plan.after_inst.len() {
                match plan.after_inst.try_get(j) {
                    Option::Some(item) => {
                        if item.block == b_rel && item.at == i {
                            if !emit_drop(
                                inout ctx,
                                inout program,
                                fi,
                                in item,
                                in handles,
                                in effects,
                                inout next_val,
                                inout sites,
                                inout err
                            ) {
                                return false;
                            }
                        }
                    },
                    _ => {},
                }
            }
        }
        for j in 0..plan.before_term.len() {
            match plan.before_term.try_get(j) {
                Option::Some(item) => {
                    if item.block == b_rel {
                        if !emit_drop(
                            inout ctx,
                            inout program,
                            fi,
                            in item,
                            in handles,
                            in effects,
                            inout next_val,
                            inout sites,
                            inout err
                        ) {
                            return false;
                        }
                    }
                },
                _ => {},
            }
        }
        block.i0 = new_i0;
        block.ic = wrapping_sub(program.insts.len(), new_i0);
        let _ = program.blocks.try_set(block_index, block);
    }
    true
}

// ----- thread_tokens ----------------------------------------------------------

fn is_state_action(in ctx: Ctx, in program: Program, in inst: InstRow) -> bool {
    if inst.fallible != 0 {
        return true;
    }
    if inst.op == Op::Bind
        || inst.op == Op::Write
        || inst.op == Op::Call
        || inst.op == Op::Indirect
        || inst.op == Op::Try
        || inst.op == Op::Handle
        || inst.op == Op::Closure
        || inst.op == Op::Index
        || inst.op == Op::Tiled
        || inst.op == Op::Seq
        || inst.op == Op::Fip
        || inst.op == Op::Exit {
        return true;
    }
    if inst.op == Op::Binary {
        let op_sym = n32(program.op(inst.a));
        return sym_eq_str(in ctx.names, op_sym, in "/")
            || sym_eq_str(in ctx.names, op_sym, in "%")
            || sym_eq_str(in ctx.names, op_sym, in "<<")
            || sym_eq_str(in ctx.names, op_sym, in ">>");
    }
    false
}

fn thread_tokens(in ctx: Ctx, inout program: Program) {
    for fi in 0..program.fn_count() {
        let func = program.function(fi);
        let mut next = func.bc;
        for b_rel in 0..func.bc {
            let block_index = add(func.b0, b_rel);
            let block = program.block(block_index);
            let entry = b_rel;
            let mut cur = entry;
            for ii in block.i0..add(block.i0, block.ic) {
                let mut inst = program.inst(ii);
                let observes = inst.op == Op::Read;
                let acts = is_state_action(in ctx, in program, in inst);
                if acts {
                    let out_tok = next;
                    next = inc(next);
                    inst.has_token = 1;
                    inst.tin = cur;
                    inst.tout = out_tok;
                    cur = out_tok;
                } else if observes {
                    inst.has_token = 1;
                    inst.tin = cur;
                    inst.tout = cur;
                } else {
                    inst.has_token = 0;
                    inst.tin = 0;
                    inst.tout = 0;
                }
                let _ = program.insts.try_set(ii, inst);
            }
            // Write outgoing token temporarily into header word; rebuild headers after collecting edges.
            let incoming_count = program.op(inc(block.ha));
            let _ = program.ops.try_set(block.ha, entry);
            let _ = program
                .ops
                .try_set(add(block.ha, add(2, wrapping_mul(incoming_count, 2))), cur);
        }
        let mut edge_src = ChunkSeq::new[u64]();
        let mut edge_dst = ChunkSeq::new[u64]();
        let mut edge_tok = ChunkSeq::new[u64]();
        for b_rel in 0..func.bc {
            let block = program.block(add(func.b0, b_rel));
            let incoming_count = program.op(inc(block.ha));
            let out_tok = program.op(add(block.ha, add(2, wrapping_mul(incoming_count, 2))));
            if block.term == Term::Jump {
                edge_src.push(b_rel);
                edge_dst.push(program.op(block.ta));
                edge_tok.push(out_tok);
            } else if block.term == Term::Branch {
                edge_src.push(b_rel);
                edge_dst.push(program.op(inc(block.ta)));
                edge_tok.push(out_tok);
                edge_src.push(b_rel);
                edge_dst.push(program.op(add(block.ta, 2)));
                edge_tok.push(out_tok);
            } else if block.term == Term::Match {
                let arm_count = program.op(inc(block.ta));
                let mut pos = add(block.ta, 2);
                for i in 0..arm_count {
                    pos = skip_pattern(in program, pos);
                    edge_src.push(b_rel);
                    edge_dst.push(program.op(pos));
                    edge_tok.push(out_tok);
                    pos = inc(pos);
                }
            }
        }
        for b_rel in 0..func.bc {
            let block_index = add(func.b0, b_rel);
            let mut block = program.block(block_index);
            let old_ni = program.op(inc(block.ha));
            let out_tok = program.op(add(block.ha, add(2, wrapping_mul(old_ni, 2))));
            let param_pos = add(block.ha, add(3, wrapping_mul(old_ni, 2)));
            let param_count = program.op(param_pos);
            let mut new_ni: u64 = 0;
            for ei in 0..edge_dst.len() {
                if u64_at(in edge_dst, ei) == b_rel {
                    new_ni = inc(new_ni);
                }
            }
            let new_header = program.ops.len();
            program.put(b_rel, Tag::Raw);
            program.put(new_ni, Tag::Raw);
            for ei in 0..edge_dst.len() {
                if u64_at(in edge_dst, ei) == b_rel {
                    program.put(u64_at(in edge_src, ei), Tag::Block);
                    program.put(u64_at(in edge_tok, ei), Tag::Raw);
                }
            }
            program.put(out_tok, Tag::Raw);
            program.put(param_count, Tag::Raw);
            for k in 0..param_count {
                program.put(program.op(add(inc(param_pos), k)), Tag::Value);
            }
            block.ha = new_header;
            block.hn = wrapping_sub(program.ops.len(), new_header);
            let _ = program.blocks.try_set(block_index, block);
        }
    }
}

// ----- check_rows -------------------------------------------------------------

fn check_rows(
    in ctx: Ctx,
    in program: Program,
    in metas: ChunkSeq[FnMeta],
    in sites: ChunkSeq[DropSite],
    inout out: ChunkSeq[u8]
) -> bool {
    let mut seen_graphs = ChunkSeq::new[u32]();
    let mut seen_effects = ChunkSeq::new[u32]();
    let mut any_diag = false;
    let prefix_len: u64 = 4;
    for si in 0..sites.len() {
        let site = match sites.try_get(si) {
            Option::Some(s) => s,
            Option::None => continue,
        };
        let fi = find_fn_by_name(in program, site.graph);
        if fi == NONE64 {
            continue;
        }
        let (_, _, _, effects_ty, _, _) = fn_header_offsets(in program, fi);
        let row = ctx.types.row(ctx.types.node(effects_ty).r2);
        let mut performs = false;
        for ei in w(row.a)..add(w(row.a), w(row.n)) {
            let eff = ctx.types.effect_at(ei);
            if eff.name == site.effect && eff.label == 0 {
                performs = true;
                break;
            }
        }
        if performs {
            continue;
        }
        let mut dup = false;
        for di in 0..seen_graphs.len() {
            if u32_at(in seen_graphs, di) == site.graph
                && u32_at(in seen_effects, di) == site.effect {
                dup = true;
                break;
            }
        }
        if dup {
            continue;
        }
        seen_graphs.push(site.graph);
        seen_effects.push(site.effect);
        any_diag = true;
        let mut span_start: u64 = 0;
        let mut span_end: u64 = 0;
        for mi in 0..metas.len() {
            match metas.try_get(mi) {
                Option::Some(meta) => {
                    if meta.name == site.graph {
                        span_start = meta.span_start;
                        span_end = meta.span_end;
                        break;
                    }
                },
                _ => {},
            }
        }
        let eff_start = ctx.names.start(site.effect);
        let eff_end = ctx.names.end(site.effect);
        let lib_start = if sym_starts_with(in ctx.names, site.effect, in EFFECT_PREFIX) {
            add(eff_start, prefix_len)
        } else {
            eff_start
        };
        push_str(inout out, in "E0401 ");
        push_decimal(inout out, span_start);
        push_str(inout out, in "..");
        push_decimal(inout out, span_end);
        out.push(32);
        out.push(39);
        push_sym(inout out, in ctx.names, site.graph);
        push_str(inout out, in "' may drop a `");
        push_sym(inout out, in ctx.names, site.handle);
        push_str(inout out, in "`, which calls its drop import; add Ffi[");
        for k in lib_start..eff_end {
            out.push(u8_at(in ctx.names.text, k));
        }
        push_str(inout out, in "] to its effect row\n");
    }
    ! any_diag
}

// ----- DropCallees ------------------------------------------------------------

fn parse_decimal_slice(in bytes: ChunkSeq[u8], start: u64, end: u64) -> (bool, u64) {
    if start >= end {
        return (false, 0);
    }
    let mut value: u64 = 0;
    for i in start..end {
        let digit = u8_at(in bytes, i);
        if digit < 48 || digit > 57 {
            return (false, 0);
        }
        value = add(wrapping_mul(value, 10), widen_u64(wrapping_sub(digit, 48)));
    }
    (true, value)
}

fn drop_callees_of(
    in ctx: Ctx,
    in program: Program,
    in metas: ChunkSeq[FnMeta],
    target: u32,
    inout out: ChunkSeq[u8]
) {
    let mut span_start: u64 = 0;
    let mut span_end: u64 = 0;
    let mut has_meta = false;
    for mi in 0..metas.len() {
        match metas.try_get(mi) {
            Option::Some(meta) => {
                if meta.name == target {
                    span_start = meta.span_start;
                    span_end = meta.span_end;
                    has_meta = true;
                    break;
                }
            },
            _ => {},
        }
    }
    if !has_meta {
        return;
    }
    let mut graphs = ChunkSeq::new[u32]();
    for fi in 0..program.fn_count() {
        let func = program.function(fi);
        let mut has_drop = false;
        for bi in func.b0..add(func.b0, func.bc) {
            let block = program.block(bi);
            for ii in block.i0..add(block.i0, block.ic) {
                let inst = program.inst(ii);
                if inst.op == Op::Call
                    && sym_starts_with(in ctx.names, n32(program.op(inst.a)), in DROP_PREFIX) {
                    has_drop = true;
                    break;
                }
            }
            if has_drop {
                break;
            }
        }
        if !has_drop {
            continue;
        }
        if func.name == target {
            if !list_has_u32(in graphs, func.name) {
                graphs.push(func.name);
            }
            continue;
        }
        let name_start = ctx.names.start(func.name);
        let name_end = ctx.names.end(func.name);
        if name_start < name_end && u8_at(in ctx.names.text, name_start) == 36 {
            // Find last two '_' in `$<name>_<start>_<end>`.
            let mut last_underscore = NONE64;
            let mut prev_underscore = NONE64;
            for k in add(name_start, 1)..name_end {
                if u8_at(in ctx.names.text, k) == 95 {
                    prev_underscore = last_underscore;
                    last_underscore = k;
                }
            }
            if prev_underscore != NONE64 && last_underscore != NONE64 {
                let (start_ok, graph_start) = parse_decimal_slice(
                    in ctx.names.text,
                    inc(prev_underscore),
                    last_underscore
                );
                let (end_ok, graph_end) = parse_decimal_slice(
                    in ctx.names.text,
                    inc(last_underscore),
                    name_end
                );
                if start_ok
                    && end_ok
                    && graph_start >= span_start
                    && graph_start <= span_end
                    && graph_end <= span_end {
                    if !list_has_u32(in graphs, func.name) {
                        graphs.push(func.name);
                    }
                }
            }
        }
    }
    // Sort `graphs` lexicographically by name.
    for i in 0..graphs.len() {
        let mut j = i;
        loop {
            if j == 0 {
                break;
            }
            let left = u32_at(in graphs, wrapping_sub(j, 1));
            let right = u32_at(in graphs, j);
            let left_start = ctx.names.start(left);
            let left_end = ctx.names.end(left);
            let right_start = ctx.names.start(right);
            let right_end = ctx.names.end(right);
            if ctx.names.text[left_start..left_end].cmp(in ctx.names.text[right_start..right_end])
                > 0 {
                let _ = graphs.try_set(wrapping_sub(j, 1), right);
                let _ = graphs.try_set(j, left);
                j = wrapping_sub(j, 1);
            } else {
                break;
            }
        }
    }
    let mut callees = ChunkSeq::new[u32]();
    for gi in 0..graphs.len() {
        let fi = find_fn_by_name(in program, u32_at(in graphs, gi));
        if fi == NONE64 {
            continue;
        }
        let func = program.function(fi);
        for bi in func.b0..add(func.b0, func.bc) {
            let block = program.block(bi);
            for ii in block.i0..add(block.i0, block.ic) {
                let inst = program.inst(ii);
                if inst.op == Op::Call {
                    let callee = n32(program.op(inst.a));
                    if sym_starts_with(in ctx.names, callee, in DROP_PREFIX)
                        && !list_has_u32(in callees, callee) {
                        callees.push(callee);
                    }
                }
            }
        }
    }
    for ci in 0..callees.len() {
        if ci > 0 {
            out.push(32);
        }
        push_sym(inout out, in ctx.names, u32_at(in callees, ci));
    }
}

// ----- harness entry ----------------------------------------------------------

fn read_drop_item(
    inout reader: Reader,
    in bytes: Slice[u8],
    in ctx: Ctx,
    inout program: Program,
    blk: u64,
    at: u64
) -> DropItem {
    let kind = wrapping_u8(reader.word(in bytes));
    if kind == 0 {
        let value = n32(reader.word(in bytes));
        let ty = u32_at(in ctx.tmap, reader.word(in bytes));
        return DropItem {
            block: blk,
            at: at,
            kind: 0,
            value: value,
            root: 0,
            path: 0,
            ty: ty,
            keep: 0
        };
    }
    if kind == 1 {
        let root = u32_at(in ctx.nmap, reader.word(in bytes));
        let plen = reader.word(in bytes);
        let mut names = ChunkSeq::new[u32]();
        for i in 0..plen {
            names.push(u32_at(in ctx.nmap, reader.word(in bytes)));
        }
        let path = program.add_path(in names);
        let ty = u32_at(in ctx.tmap, reader.word(in bytes));
        return DropItem {
            block: blk,
            at: at,
            kind: 1,
            value: 0,
            root: root,
            path: path,
            ty: ty,
            keep: 0
        };
    }
    let ty = u32_at(in ctx.tmap, reader.word(in bytes));
    let keep = u32_at(in ctx.nmap, reader.word(in bytes));
    DropItem { block: blk, at: at, kind: 2, value: 0, root: 0, path: 0, ty: ty, keep: keep }
}

pub fn ffi_drops_entry(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mut reader = Reader { pos: 0 };
    let mut ctx = read_ctx(inout reader, in bytes);
    let mut program = read_program(inout reader, in bytes, in ctx);
    let meta_count = reader.word(in bytes);
    let mut metas = ChunkSeq::new[FnMeta]();
    let mut fip_fns = ChunkSeq::new[u32]();
    for i in 0..meta_count {
        let name = u32_at(in ctx.nmap, reader.word(in bytes));
        let fip = reader.word(in bytes) != 0;
        let span_start = reader.word(in bytes);
        let span_end = reader.word(in bytes);
        metas.push(FnMeta { name: name, fip: fip, span_start: span_start, span_end: span_end });
        if fip {
            fip_fns.push(name);
        }
    }
    let mode = reader.word(in bytes);
    if mode == 1 {
        let query_count = reader.word(in bytes);
        let mut out = ChunkSeq::new[u8]();
        for i in 0..query_count {
            let target = u32_at(in ctx.nmap, reader.word(in bytes));
            push_sym(inout out, in ctx.names, target);
            push_str(inout out, in ": ");
            drop_callees_of(in ctx, in program, in metas, target, inout out);
            out.push(10);
        }
        return pack_text(in out);
    }
    let plan_count = reader.word(in bytes);
    let mut plans = ChunkSeq::new[FnPlan]();
    for i in 0..plan_count {
        let fi = reader.word(in bytes);
        let ok = reader.word(in bytes) != 0;
        let mut splits = ChunkSeq::new[EdgeSplit]();
        let mut before_inst = ChunkSeq::new[DropItem]();
        let mut after_inst = ChunkSeq::new[DropItem]();
        let mut before_term = ChunkSeq::new[DropItem]();
        if ok {
            let split_count = reader.word(in bytes);
            for k in 0..split_count {
                let from = reader.word(in bytes);
                let to = reader.word(in bytes);
                splits.push(EdgeSplit { from: from, to: to });
            }
            let before_inst_count = reader.word(in bytes);
            for k in 0..before_inst_count {
                let block = reader.word(in bytes);
                let at = reader.word(in bytes);
                before_inst.push(
                    read_drop_item(inout reader, in bytes, in ctx, inout program, block, at)
                );
            }
            let after_inst_count = reader.word(in bytes);
            for k in 0..after_inst_count {
                let block = reader.word(in bytes);
                let at = reader.word(in bytes);
                after_inst.push(
                    read_drop_item(inout reader, in bytes, in ctx, inout program, block, at)
                );
            }
            let before_term_count = reader.word(in bytes);
            for k in 0..before_term_count {
                let block = reader.word(in bytes);
                before_term
                    .push(read_drop_item(inout reader, in bytes, in ctx, inout program, block, 0));
            }
        }
        plans.push(
            FnPlan {
                fi: fi,
                ok: ok,
                splits: splits,
                before_inst: before_inst,
                after_inst: after_inst,
                before_term: before_term
            }
        );
    }
    let (handles, effects) = droppable_resolved(inout ctx, in program);
    let mut sites = ChunkSeq::new[DropSite]();
    let mut err = ChunkSeq::new[u8]();
    let mut has_err = false;
    if handles.len() > 0 {
        for fi in 0..program.fn_count() {
            let func = program.function(fi);
            if sym_starts_with(in ctx.names, func.name, in DROP_PREFIX)
                || list_has_u32(in fip_fns, func.name) {
                continue;
            }
            release_wildcards(inout ctx, inout program, fi, in handles, in effects, inout sites);
            let mut refuse_err = ChunkSeq::new[u8]();
            if !refuse_unplaced(inout ctx, in program, fi, in handles, inout refuse_err) {
                if !has_err {
                    err = refuse_err;
                    has_err = true;
                }
                continue;
            }
            let mut found_plan = false;
            for pi in 0..plans.len() {
                match plans.try_get(pi) {
                    Option::Some(plan) => {
                        if plan.fi == fi {
                            found_plan = true;
                            if !plan.ok {
                                if !has_err {
                                    push_str(inout err, in "the drops of the handles in '");
                                    push_sym(inout err, in ctx.names, func.name);
                                    push_str(inout err, in "' do not reach a fixed point");
                                    has_err = true;
                                }
                            } else {
                                let mut apply_err = ChunkSeq::new[u8]();
                                if !apply_plan(
                                    inout ctx,
                                    inout program,
                                    fi,
                                    in plan,
                                    in handles,
                                    in effects,
                                    inout sites,
                                    inout apply_err
                                ) {
                                    if !has_err {
                                        err = apply_err;
                                        has_err = true;
                                    }
                                }
                            }
                            break;
                        }
                    },
                    _ => {},
                }
            }
            if !found_plan && !has_err {
                push_str(inout err, in "missing handle_drop_plan");
                has_err = true;
            }
        }
        thread_tokens(in ctx, inout program);
    }
    if has_err {
        let mut out = ChunkSeq::new[u8]();
        push_str(inout out, in "ERR ");
        out.extend(in err[0..err.len()]);
        return pack_text(in out);
    }
    let mut diag_out = ChunkSeq::new[u8]();
    if !check_rows(in ctx, in program, in metas, in sites, inout diag_out) {
        return pack_text(in diag_out);
    }
    let mut out = ChunkSeq::with_capacity[u64](1);
    out.push(0);
    put_program(in program, in ctx.types, in ctx.names, inout out);
    out
}
