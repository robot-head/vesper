// @vesper/ffi-lowering: the `.vsys` type mapping and call plans of
// src/ffi_lowering.rs and src/ffi_lowering/types.rs in Vesper (self-hosting
// SH4 lane 13, #1287). Rust stays the default; nothing here replaces Rust
// code yet.
//
// The input is each imported library's canonical descriptor bytes
// (`LibraryDescriptor::canonical_bytes`, the bytes its BLAKE3 identity is
// taken over) with its handler tier, then the probes of one differential
// case. The word format is documented in tests/self_host_ffi_lowering.rs,
// which writes the same text from the Rust code.
//
// - `read_library`: a canonical descriptor as tables (enums, functions,
//   parameters, wire structs with their field offsets, extern types).
// - `generate`: `types::Generated::new`: the generated wire structs, enums,
//   extern-type handles and each function's source shape, or the first
//   duplicate-declaration error.
// - `append`: `Generated::append`, pass 1 (open slices) and pass 2 (one
//   operation per slice-length vector), as the canonical AST dump.
// - `check_collisions`, `demangle`, `op_name`, `slice_length`.
// - `op_plan`, `target_support` and each function's ABI signature
//   (`FunctionDescriptor::abi`): what the native lowering reads.
// - `ffi_plan_text`: the harness entry.
// - cpu.ves: the machine code of `@vesper-std/cpu`'s functions
//   (src/ffi_lowering/cpu.rs), with its entry `ffi_cpu_code`.

use self::cpu::{code_for, has_prefix};

const NONE: u32 = 4294967295;
const NONE64: u64 = 18446744073709551615;

// Scalars, in `vesper_ffi::sys::Scalar` order; the first nine symbols of
// every state are their names, so a scalar's code is its name's symbol.
const SC_U8: u8 = 0;
const SC_I8: u8 = 1;
const SC_U16: u8 = 2;
const SC_I16: u8 = 3;
const SC_U32: u8 = 4;
const SC_I32: u8 = 5;
const SC_U64: u8 = 6;
const SC_I64: u8 = 7;
const SC_USIZE: u8 = 8;
const SC_COUNT: u32 = 9;

// Other names every state interns right after the scalars.
const S_BOOL: u32 = 9;
const S_OPTION: u32 = 10;
const S_RESULT: u32 = 11;
const S_INVALID: u32 = 12;
const S_SLICE: u32 = 13;
const S_OPEN: u32 = 14;
const S_RAW: u32 = 15;
const S_HANDLE: u32 = 16;
const S_FFI: u32 = 17;
const S_EMPTY: u32 = 18;
const S_PINNED: u32 = 19;
const S_CHUNK_SEQ: u32 = 20;
const S_DATA: u32 = 21;
const S_T: u32 = 22;

// `ValueType` tags.
const VT_UNIT: u8 = 0;
const VT_SCALAR: u8 = 1;
const VT_BOOL: u8 = 2;
const VT_ENUM: u8 = 3;
const VT_ADDRESS: u8 = 4;
const VT_HANDLE: u8 = 5;
const VT_NONNULL: u8 = 6;
// `f32` or `f64` by value; `name` spells which.
const VT_FLOAT: u8 = 7;
// A nullable C string copied into a Vesper byte sequence.
const VT_CSTR: u8 = 8;
// A nullable wide C string copied into a Vesper UTF-16 sequence.
const VT_CWSTR: u8 = 9;

// `ParameterType` tags.
const P_VALUE: u8 = 0;
const P_SLICE: u8 = 1;
const P_POINTER: u8 = 2;
const P_HANDLE: u8 = 3;
const P_CSTR: u8 = 4;
// A Vesper function handed to C as callback type `type_name`.
const P_FUNCTION: u8 = 5;
// A `Pinned[T]` buffer of scalar `elem_scalar`.
const P_PINNED: u8 = 6;
// `nocapture in argv: CStrList`: NUL-ended strings in one `Slice[u8]`.
const P_CSTR_LIST: u8 = 7;
// `nocapture in s: CWStr`: NUL-terminated UTF-16 string in `Slice[u16]`.
const P_CWSTR: u8 = 8;

// Accesses: `Access` (in, inout), `PointerAccess` (in, out, inout) and
// `HandleAccess` (in, inout, sink) share these codes.
const A_IN: u8 = 0;
const A_OUT: u8 = 1;
const A_INOUT: u8 = 2;
const A_SINK: u8 = 3;

// Source parameter passing (`ast::Pass`).
const PASS_IN: u8 = 0;
const PASS_INOUT: u8 = 1;
const PASS_SINK: u8 = 2;

// Wire field kinds (`vesper_ffi::FieldKind`).
const F_INT: u8 = 0;
const F_BYTES: u8 = 1;
const F_PAD: u8 = 2;
const F_STRUCT: u8 = 3;

// Byte orders.
const E_NATIVE: u8 = 0;
const E_LITTLE: u8 = 1;
const E_BIG: u8 = 2;

// Type nodes.
const TK_NAMED: u8 = 0;
const TK_TUPLE: u8 = 1;
// A function type: args are the parameters then the result; `name` is the
// index of the parameters' passes in `fn_passes`.
const TK_FN: u8 = 2;

// `FfiErrorKind`s this port raises.
const K_DUPLICATE: u8 = 0;
const K_COLLISION: u8 = 1;
const K_SLICE: u8 = 2;
const K_TARGET: u8 = 3;
const K_ISOLATION: u8 = 4;

// Handler tiers.
const H_DIRECT: u64 = 0;
const H_MPK: u64 = 1;

// `MAX_SLICE_ELEMENTS`.
const MAX_SLICE: u64 = 4096;
const MAX_WIRE_STRUCT_DEPTH: u64 = 512;
const MAX_DESCRIPTOR_TYPE_DEPTH: u64 = 64;
// ASCII 'a' minus the value of hexadecimal digit A.
const LOWER_HEX_DIGIT_OFFSET: u8 = 87;

enum Ascii: u8 {
    LineFeed = 10,
    Space = 32,
    Quote = 34,
    Dollar = 36,
    OpenParen = 40,
    CloseParen = 41,
    Hyphen = 45,
    Digit0 = 48,
    Digit1 = 49,
    Digit9 = 57,
    UpperA = 65,
    UpperZ = 90,
    OpenBracket = 91,
    Backslash = 92,
    CloseBracket = 93,
    Underscore = 95,
    LowerA = 97,
    LowerX = 120,
    LowerZ = 122,
    Tilde = 126,
}

enum TargetOs: u64 {
    Other = 0,
    Linux = 1,
    Darwin = 2,
    Windows = 3,
}

// ----- tables -----------------------------------------------------------------

pub copy struct Lib {
    name: u32,
    handler: u64,
    triple: u32,
    enum_start: u64,
    enum_count: u64,
    fun_start: u64,
    fun_count: u64,
    wire_start: u64,
    wire_count: u64,
    extern_start: u64,
    extern_count: u64,
    const_start: u64,
    const_count: u64,
}

pub copy struct ConstRow {
    name: u32,
    scalar: u8,
    neg: bool,
    value: u64,
}

pub copy struct EnumRow {
    name: u32,
    scalar: u8,
    // a range of `variant_names`
    variant_start: u64,
    variant_count: u64,
}

// A `ValueType`: `scalar` is a scalar code, `name` an enum or handle name.
pub copy struct Vt {
    tag: u8,
    scalar: u8,
    name: u32,
    nullable: bool,
}

pub copy struct Fun {
    sym: u32,
    // a range of `params`
    param_start: u64,
    param_count: u64,
    result: Vt,
    errno: bool,
    has_variadic: bool,
    variadic_first: u64,
    // the library row
    lib: u64,
    // the call of a callback type: params[param_start] is the pointer itself
    indirect: bool,
    // `#[link_name]`: the C symbol a direct call imports, or NONE for `sym`
    link: u32,
    // `-> ForeignVal[Option[M[len]]]`: the result is a mapping
    mapped: bool,
}

// A `ParameterType`. Pointees and slice elements are a scalar (`elem_scalar`) or
// a wire struct (`type_name`); a handle names its type in `type_name`.
pub copy struct Par {
    name: u32,
    tag: u8,
    value_ty: Vt,
    access: u8,
    nullable: bool,
    elem_is_struct: bool,
    elem_scalar: u8,
    type_name: u32,
}

pub copy struct Ws {
    name: u32,
    size: u64,
    align: u64,
    // a range of `wire_fields`
    field_start: u64,
    field_count: u64,
}

pub copy struct Wf {
    name: u32,
    kind: u8,
    bits: u64,
    signed: bool,
    endian: u8,
    // bytes of a byte array or pad, size of a nested struct
    size: u64,
    struct_name: u32,
    offset: u64,
}

pub copy struct Xt {
    name: u32,
    linear: bool,
    // a callback type: a C function pointer, a plain copyable word
    copy: bool,
    drop: u32,
    // a mapping's element scalar (its name), or NONE
    mapping: u32,
}

pub copy struct Tn {
    kind: u8,
    name: u32,
    // args[a..a+n]
    a: u64,
    n: u64,
}

// A generated struct: Ok with a range of `gen_fields`, or Err with `err`.
pub copy struct Gs {
    name: u32,
    ok: bool,
    err: u32,
    field_start: u64,
    field_count: u64,
}

pub copy struct Gf {
    name: u32,
    ty: u32,
}

pub copy struct Ge {
    name: u32,
    row: u64,
}

pub copy struct Gh {
    name: u32,
    linear: bool,
    copy: bool,
    mapping: u32,
}

// A function's shape: Ok with a range of `shape_params` and `result`, or Err.
pub copy struct Sh {
    ok: bool,
    err: u32,
    param_start: u64,
    param_count: u64,
    result: u32,
}

// A shaped parameter: a fixed type, or a slice of `ty` elements.
pub copy struct Sp {
    name: u32,
    pass: u8,
    slice: bool,
    ty: u32,
    nullable: bool,
    in_place: bool,
}

// A typed error: kind, message symbol, optional span.
pub copy struct Err {
    kind: u8,
    msg: u32,
    has_span: bool,
    start: u64,
    end: u64,
}

pub struct S {
    text: ChunkSeq[u8],
    starts: ChunkSeq[u64],
    libs: ChunkSeq[Lib],
    enums: ChunkSeq[EnumRow],
    variant_names: ChunkSeq[u32],
    funs: ChunkSeq[Fun],
    params: ChunkSeq[Par],
    wire_structs: ChunkSeq[Ws],
    wire_fields: ChunkSeq[Wf],
    extern_types: ChunkSeq[Xt],
    consts: ChunkSeq[ConstRow],
    type_nodes: ChunkSeq[Tn],
    type_args: ChunkSeq[u32],
    gen_structs: ChunkSeq[Gs],
    gen_fields: ChunkSeq[Gf],
    gen_enums: ChunkSeq[Ge],
    gen_handles: ChunkSeq[Gh],
    shapes: ChunkSeq[Sh],
    shape_params: ChunkSeq[Sp],
    // the passes of function types' parameters (`TK_FN`)
    fn_passes: ChunkSeq[u8],
    invalid: bool,
    // whether an import takes a `Pinned[T]`
    pinned: bool,
    out: ChunkSeq[u8],
}

fn w(x: u32) -> u64 {
    widen_u64(x)
}

// The symbol of a scalar code (scalar names are the first symbols).
fn sym8(code: u8) -> u32 {
    wrapping_u32(widen_u64(code))
}

fn n32(x: u64) -> u32 {
    wrapping_u32(x)
}

fn inc(x: u64) -> u64 {
    wrapping_add(x, 1)
}

fn add(a: u64, b: u64) -> u64 {
    wrapping_add(a, b)
}

fn u32_at(in seq: ChunkSeq[u32], i: u64) -> u32 {
    seq.try_get(i).unwrap_or(NONE)
}

fn u64_at(in seq: ChunkSeq[u64], i: u64) -> u64 {
    seq.try_get(i).unwrap_or(0)
}

fn u8_at(in seq: ChunkSeq[u8], i: u64) -> u8 {
    seq.try_get(i).unwrap_or(0)
}

fn byte(in bytes: Slice[u8], i: u64) -> u8 {
    bytes.try_get(i).unwrap_or(0)
}

fn vt_unit() -> Vt {
    Vt { tag: VT_UNIT, scalar: 0, name: NONE, nullable: false }
}

fn no_err() -> Err {
    Err { kind: 0, msg: NONE, has_span: false, start: 0, end: 0 }
}

pub fn s_new() -> S {
    let mut state = S {
        text: ChunkSeq::new[u8](),
        starts: ChunkSeq::new[u64](),
        libs: ChunkSeq::new[Lib](),
        enums: ChunkSeq::new[EnumRow](),
        variant_names: ChunkSeq::new[u32](),
        funs: ChunkSeq::new[Fun](),
        params: ChunkSeq::new[Par](),
        wire_structs: ChunkSeq::new[Ws](),
        wire_fields: ChunkSeq::new[Wf](),
        extern_types: ChunkSeq::new[Xt](),
        consts: ChunkSeq::new[ConstRow](),
        type_nodes: ChunkSeq::new[Tn](),
        type_args: ChunkSeq::new[u32](),
        gen_structs: ChunkSeq::new[Gs](),
        gen_fields: ChunkSeq::new[Gf](),
        gen_enums: ChunkSeq::new[Ge](),
        gen_handles: ChunkSeq::new[Gh](),
        shapes: ChunkSeq::new[Sh](),
        shape_params: ChunkSeq::new[Sp](),
        fn_passes: ChunkSeq::new[u8](),
        invalid: false,
        pinned: false,
        out: ChunkSeq::new[u8]()
    };
    state.starts.push(0);
    let u8s = state.intern(in "u8".as_bytes());
    let i8s = state.intern(in "i8".as_bytes());
    let u16s = state.intern(in "u16".as_bytes());
    let i16s = state.intern(in "i16".as_bytes());
    let u32s = state.intern(in "u32".as_bytes());
    let i32s = state.intern(in "i32".as_bytes());
    let u64s = state.intern(in "u64".as_bytes());
    let i64s = state.intern(in "i64".as_bytes());
    let usizes = state.intern(in "usize".as_bytes());
    let bools = state.intern(in "bool".as_bytes());
    let options = state.intern(in "Option".as_bytes());
    let results = state.intern(in "Result".as_bytes());
    let invalids = state.intern(in "ForeignInvalid".as_bytes());
    let slices = state.intern(in "Slice".as_bytes());
    let opens = state.intern(in "$open".as_bytes());
    let raws = state.intern(in "raw".as_bytes());
    let handles = state.intern(in "$handle".as_bytes());
    let ffis = state.intern(in "Ffi".as_bytes());
    let empties = state.intern(in "".as_bytes());
    let pinneds = state.intern(in "Pinned".as_bytes());
    let chunk_seqs = state.intern(in "ChunkSeq".as_bytes());
    let datas = state.intern(in "data".as_bytes());
    let ts = state.intern(in "T".as_bytes());
    state
}

impl S {
    // ----- names -----

    pub fn start(in self, sym: u32) -> u64 {
        u64_at(in self.starts, w(sym))
    }

    pub fn end(in self, sym: u32) -> u64 {
        u64_at(in self.starts, inc(w(sym)))
    }

    pub fn size(in self, sym: u32) -> u64 {
        wrapping_sub(self.end(sym), self.start(sym))
    }

    pub fn spells(in self, sym: u32, in bytes: Slice[u8]) -> bool {
        let lo = self.start(sym);
        let hi = self.end(sym);
        if wrapping_sub(hi, lo) != bytes.len() {
            return false;
        }
        self.text[lo..hi].eq(in bytes)
    }

    pub fn intern(inout self, in bytes: Slice[u8]) -> u32 {
        let n = wrapping_sub(self.starts.len(), 1);
        for i in 0..n {
            if self.spells(n32(i), in bytes) {
                return n32(i);
            }
        }
        self.text.extend(in bytes);
        self.starts.push(self.text.len());
        n32(n)
    }

    // The symbol of the bytes `self.out[from..]`, which it then drops.
    pub fn intern_tail(inout self, from: u64) -> u32 {
        let n = wrapping_sub(self.out.len(), from);
        let mut tail = ChunkSeq::with_capacity[u8](n);
        for i in from..self.out.len() {
            tail.push(u8_at(in self.out, i));
        }
        self.out.truncate(from);
        self.intern(in tail[0..n])
    }

    // Byte order of two names (`str::cmp`): -1, 0 or 1.
    pub fn name_cmp(in self, left: u32, right: u32) -> i32 {
        if left == right {
            return 0;
        }
        let left_start = self.start(left);
        let right_start = self.start(right);
        self.text[left_start..self.end(left)].cmp(in self.text[right_start..self.end(right)])
    }

    pub fn put(inout self, in text: Str) {
        self.out.extend(in text.as_bytes());
    }

    pub fn put_name(inout self, sym: u32) {
        let lo = self.start(sym);
        let hi = self.end(sym);
        for i in lo..hi {
            self.out.push(u8_at(in self.text, i));
        }
    }

    // A name quoted as the AST dump quotes strings.
    pub fn put_q(inout self, sym: u32) {
        self.out.push(Ascii::Quote);
        let lo = self.start(sym);
        let hi = self.end(sym);
        for i in lo..hi {
            let byte = u8_at(in self.text, i);
            if byte < Ascii::Space
                || byte > Ascii::Tilde
                || byte == Ascii::Quote
                || byte == Ascii::Backslash
            {
                self.out.push(Ascii::Backslash);
                self.out.push(Ascii::LowerX);
                self.out.push(hex(byte >> 4));
                self.out.push(hex(byte & 15));
            } else {
                self.out.push(byte);
            }
        }
        self.out.push(Ascii::Quote);
    }

    pub fn put_u64(inout self, value: u64) {
        if value >= 10 {
            self.put_u64(value / 10);
        }
        self.out.push(wrapping_u8(wrapping_add(value % 10, widen_u64(Ascii::Digit0))));
    }

    pub fn nl(inout self) {
        self.out.push(Ascii::LineFeed);
    }

    pub fn indent(inout self, depth: u64) {
        for i in 0..depth {
            self.out.push(Ascii::Space);
        }
    }

    // ----- rows -----

    pub fn lib(in self, i: u64) -> Lib {
        match self.libs.try_get(i) {
            Option::Some(x) => x,
            Option::None => Lib {
                name: NONE,
                handler: 0,
                triple: NONE,
                enum_start: 0,
                enum_count: 0,
                fun_start: 0,
                fun_count: 0,
                wire_start: 0,
                wire_count: 0,
                extern_start: 0,
                extern_count: 0,
                const_start: 0,
                const_count: 0
            },
        }
    }

    pub fn enum_row(in self, i: u64) -> EnumRow {
        match self.enums.try_get(i) {
            Option::Some(x) => x,
            Option::None => EnumRow { name: NONE, scalar: 0, variant_start: 0, variant_count: 0 },
        }
    }

    pub fn fun(in self, i: u64) -> Fun {
        match self.funs.try_get(i) {
            Option::Some(x) => x,
            Option::None => Fun {
                sym: NONE,
                param_start: 0,
                param_count: 0,
                result: vt_unit(),
                errno: false,
                has_variadic: false,
                variadic_first: 0,
                lib: 0,
                indirect: false,
                link: NONE,
                mapped: false
            },
        }
    }

    pub fn par(in self, i: u64) -> Par {
        match self.params.try_get(i) {
            Option::Some(x) => x,
            Option::None => Par {
                name: NONE,
                tag: P_CSTR,
                value_ty: vt_unit(),
                access: 0,
                nullable: false,
                elem_is_struct: false,
                elem_scalar: 0,
                type_name: NONE
            },
        }
    }

    pub fn ws(in self, i: u64) -> Ws {
        match self.wire_structs.try_get(i) {
            Option::Some(x) => x,
            Option::None => Ws { name: NONE, size: 0, align: 0, field_start: 0, field_count: 0 },
        }
    }

    pub fn wf(in self, i: u64) -> Wf {
        match self.wire_fields.try_get(i) {
            Option::Some(x) => x,
            Option::None => Wf {
                name: NONE,
                kind: F_PAD,
                bits: 0,
                signed: false,
                endian: 0,
                size: 0,
                struct_name: NONE,
                offset: 0
            },
        }
    }

    pub fn xt(in self, i: u64) -> Xt {
        match self.extern_types.try_get(i) {
            Option::Some(x) => x,
            Option::None => Xt {
                name: NONE,
                linear: false,
                copy: false,
                drop: NONE,
                mapping: NONE
            },
        }
    }

    pub fn const_row(in self, i: u64) -> ConstRow {
        match self.consts.try_get(i) {
            Option::Some(x) => x,
            Option::None => ConstRow { name: NONE, scalar: 0, neg: false, value: 0 },
        }
    }

    pub fn tn(in self, i: u32) -> Tn {
        match self.type_nodes.try_get(w(i)) {
            Option::Some(x) => x,
            Option::None => Tn { kind: TK_TUPLE, name: NONE, a: 0, n: 0 },
        }
    }

    pub fn gs(in self, i: u64) -> Gs {
        match self.gen_structs.try_get(i) {
            Option::Some(x) => x,
            Option::None => Gs { name: NONE, ok: false, err: NONE, field_start: 0, field_count: 0 },
        }
    }

    pub fn gf(in self, i: u64) -> Gf {
        match self.gen_fields.try_get(i) {
            Option::Some(x) => x,
            Option::None => Gf { name: NONE, ty: NONE },
        }
    }

    pub fn ge(in self, i: u64) -> Ge {
        match self.gen_enums.try_get(i) {
            Option::Some(x) => x,
            Option::None => Ge { name: NONE, row: 0 },
        }
    }

    pub fn gh(in self, i: u64) -> Gh {
        match self.gen_handles.try_get(i) {
            Option::Some(x) => x,
            Option::None => Gh { name: NONE, linear: false, copy: false, mapping: NONE },
        }
    }

    pub fn sh(in self, i: u64) -> Sh {
        match self.shapes.try_get(i) {
            Option::Some(x) => x,
            Option::None => Sh {
                ok: false,
                err: NONE,
                param_start: 0,
                param_count: 0,
                result: NONE
            },
        }
    }

    pub fn sp(in self, i: u64) -> Sp {
        match self.shape_params.try_get(i) {
            Option::Some(x) => x,
            Option::None => Sp {
                name: NONE,
                pass: PASS_IN,
                slice: false,
                ty: NONE,
                nullable: false,
                in_place: false
            },
        }
    }

    pub fn targ(in self, i: u64) -> u32 {
        u32_at(in self.type_args, i)
    }

    // ----- types -----

    pub fn ty_named(inout self, name: u32, in args: ChunkSeq[u32]) -> u32 {
        let arg_start = self.type_args.len();
        for i in 0..args.len() {
            self.type_args.push(u32_at(in args, i));
        }
        let ty = n32(self.type_nodes.len());
        self.type_nodes.push(Tn { kind: TK_NAMED, name: name, a: arg_start, n: args.len() });
        ty
    }

    pub fn ty_name(inout self, name: u32) -> u32 {
        let none = ChunkSeq::new[u32]();
        self.ty_named(name, in none)
    }

    pub fn ty_app1(inout self, name: u32, arg: u32) -> u32 {
        let mut args = ChunkSeq::new[u32]();
        args.push(arg);
        self.ty_named(name, in args)
    }

    pub fn ty_app2(inout self, name: u32, first: u32, second: u32) -> u32 {
        let mut args = ChunkSeq::new[u32]();
        args.push(first);
        args.push(second);
        self.ty_named(name, in args)
    }

    pub fn ty_tuple(inout self, in args: ChunkSeq[u32]) -> u32 {
        let ty = self.ty_named(NONE, in args);
        let mut node = self.tn(ty);
        node.kind = TK_TUPLE;
        self.type_nodes.try_set(w(ty), node);
        ty
    }

    // `(t, t, ..)` of `n` elements.
    pub fn ty_repeat(inout self, elem: u32, n: u64) -> u32 {
        let mut args = ChunkSeq::with_capacity[u32](n);
        for i in 0..n {
            args.push(elem);
        }
        self.ty_tuple(in args)
    }

    pub fn ty_eq(in self, left: u32, right: u32) -> bool {
        if left == right {
            return true;
        }
        let left_node = self.tn(left);
        let right_node = self.tn(right);
        if left_node.kind != right_node.kind
            || left_node.name != right_node.name
            || left_node.n != right_node.n
        {
            return false;
        }
        for i in 0..left_node.n {
            if !self.ty_eq(self.targ(add(left_node.a, i)), self.targ(add(right_node.a, i))) {
                return false;
            }
        }
        true
    }

    // `Display for Type` (named and tuple types).
    pub fn put_display(inout self, ty: u32) {
        let node = self.tn(ty);
        if node.kind == TK_NAMED {
            self.put_name(node.name);
            if node.n == 0 {
                return;
            }
            self.out.push(Ascii::OpenBracket);
        } else {
            self.out.push(Ascii::OpenParen);
        }
        for i in 0..node.n {
            if i > 0 {
                self.put(in ", ");
            }
            self.put_display(self.targ(add(node.a, i)));
        }
        if node.kind == TK_NAMED {
            self.out.push(Ascii::CloseBracket);
        } else {
            self.out.push(Ascii::CloseParen);
        }
    }

    // The AST dump of a type (`T "name"` or `T tuple`, arguments below).
    pub fn dump_ty(inout self, ty: u32, depth: u64) {
        let node = self.tn(ty);
        self.indent(depth);
        if node.kind == TK_FN {
            self.put(in "T fn mode=copy");
            self.nl();
            let param_count = wrapping_sub(node.n, 1);
            for i in 0..param_count {
                self.indent(inc(depth));
                self.put(in "P pass=");
                let pass = self.fn_passes.try_get(add(w(node.name), i)).unwrap_or(PASS_IN);
                if pass == PASS_IN {
                    self.put(in "in");
                } else if pass == PASS_SINK {
                    self.put(in "sink");
                } else {
                    self.put(in "inout");
                }
                self.nl();
                self.dump_ty(self.targ(add(node.a, i)), add(depth, 2));
            }
            self.indent(inc(depth));
            self.put(in "R");
            self.nl();
            self.dump_ty(self.targ(add(node.a, param_count)), add(depth, 2));
            // `callback_row`: each direct library's effect, then `Realtime`.
            for li in 0..self.libs.len() {
                let lib_row = self.lib(li);
                if lib_row.handler == H_DIRECT {
                    self.indent(inc(depth));
                    self.put(in "E \"Ffi$");
                    self.put_name(lib_row.name);
                    self.put(in "\"");
                    self.nl();
                }
            }
            self.indent(inc(depth));
            self.put(in "E \"Realtime\"");
            self.nl();
            return;
        }
        if node.kind == TK_NAMED {
            self.put(in "T ");
            self.put_q(node.name);
        } else {
            self.put(in "T tuple");
        }
        self.nl();
        for i in 0..node.n {
            self.dump_ty(self.targ(add(node.a, i)), inc(depth));
        }
    }

    pub fn mentions_result(in self, ty: u32) -> bool {
        let node = self.tn(ty);
        if node.kind == TK_NAMED && node.name == S_RESULT {
            return true;
        }
        for i in 0..node.n {
            if self.mentions_result(self.targ(add(node.a, i))) {
                return true;
            }
        }
        false
    }
}

fn hex(digit: u8) -> u8 {
    if digit < 10 {
        wrapping_add(digit, Ascii::Digit0)
    } else {
        wrapping_add(digit, LOWER_HEX_DIGIT_OFFSET)
    }
}

// ----- the canonical descriptor -----------------------------------------------

pub struct Reader {
    pos: u64,
    stop: u64,
}

impl Reader {
    // A little-endian input word.
    pub fn word(inout self, in bytes: Slice[u8]) -> u64 {
        let value = bytes.try_read_u64_le(self.pos).unwrap_or(0);
        self.pos = add(self.pos, 8);
        value
    }

    // An input string: its length word, then its bytes; returns (a, b).
    pub fn text(inout self, in bytes: Slice[u8]) -> (u64, u64) {
        let len = self.word(in bytes);
        let start = self.pos;
        self.pos = add(start, len);
        (start, self.pos)
    }

    // A canonical field: a u32 length, then its bytes.
    pub fn field(inout self, in bytes: Slice[u8]) -> (u64, u64) {
        let len = match bytes.try_read_u32_le(self.pos) {
            Option::Some(x) => widen_u64(x),
            Option::None => 0,
        };
        let start = add(self.pos, 4);
        self.pos = add(start, len);
        (start, self.pos)
    }

    // A canonical count or other 8-byte field.
    pub fn count(inout self, in bytes: Slice[u8]) -> u64 {
        let (start, end) = self.field(in bytes);
        bytes.try_read_u64_le(start).unwrap_or(0)
    }

    pub fn at_end(in self) -> bool {
        self.pos >= self.stop
    }
}

fn field_sym(inout reader: Reader, in bytes: Slice[u8], inout state: S) -> u32 {
    let (start, end) = reader.field(in bytes);
    state.intern(in bytes[start..end])
}

fn text_sym(inout reader: Reader, in bytes: Slice[u8], inout state: S) -> u32 {
    let (start, end) = reader.text(in bytes);
    state.intern(in bytes[start..end])
}

// Whether the next canonical field spells `text` (without reading it).
fn peek_is(in reader: Reader, in bytes: Slice[u8], in text: Str) -> bool {
    if reader.at_end() {
        return false;
    }
    let mut probe = Reader { pos: reader.pos, stop: reader.stop };
    let (start, end) = probe.field(in bytes);
    let want = text.as_bytes();
    if wrapping_sub(end, start) != want.len() {
        return false;
    }
    bytes[start..end].eq(in want)
}

fn field_is(in bytes: Slice[u8], start: u64, end: u64, in text: Str) -> bool {
    let want = text.as_bytes();
    if wrapping_sub(end, start) != want.len() {
        return false;
    }
    bytes[start..end].eq(in want)
}

fn access_code(in bytes: Slice[u8], start: u64, end: u64) -> u8 {
    if field_is(in bytes, start, end, in "in") {
        A_IN
    } else if field_is(in bytes, start, end, in "out") {
        A_OUT
    } else if field_is(in bytes, start, end, in "inout") {
        A_INOUT
    } else {
        A_SINK
    }
}

fn scalar_code(sym: u32) -> u8 {
    if sym < SC_COUNT {
        wrapping_u8(sym)
    } else {
        SC_U64
    }
}

fn read_value(inout reader: Reader, in bytes: Slice[u8], inout state: S) -> Vt {
    let (tag_start, tag_end) = reader.field(in bytes);
    let mut value_ty = vt_unit();
    if field_is(in bytes, tag_start, tag_end, in "unit") {
        return value_ty;
    }
    if field_is(in bytes, tag_start, tag_end, in "bool-u8") {
        value_ty.tag = VT_BOOL;
        return value_ty;
    }
    if field_is(in bytes, tag_start, tag_end, in "nullable-cstr-copy") {
        value_ty.tag = VT_CSTR;
        return value_ty;
    }
    if field_is(in bytes, tag_start, tag_end, in "nullable-cwstr-copy") {
        value_ty.tag = VT_CWSTR;
        return value_ty;
    }
    let name = field_sym(inout reader, in bytes, inout state);
    if field_is(in bytes, tag_start, tag_end, in "scalar") {
        value_ty.tag = VT_SCALAR;
        value_ty.scalar = scalar_code(name);
    } else if field_is(in bytes, tag_start, tag_end, in "float") {
        value_ty.tag = VT_FLOAT;
        value_ty.name = name;
    } else if field_is(in bytes, tag_start, tag_end, in "enum") {
        value_ty.tag = VT_ENUM;
        value_ty.name = name;
    } else if field_is(in bytes, tag_start, tag_end, in "address") {
        value_ty.tag = VT_ADDRESS;
        value_ty.scalar = scalar_code(name);
    } else if field_is(in bytes, tag_start, tag_end, in "nullable-address") {
        value_ty.tag = VT_ADDRESS;
        value_ty.scalar = scalar_code(name);
        value_ty.nullable = true;
    } else if field_is(in bytes, tag_start, tag_end, in "handle") {
        value_ty.tag = VT_HANDLE;
        value_ty.name = name;
    } else if field_is(in bytes, tag_start, tag_end, in "nullable-handle") {
        value_ty.tag = VT_HANDLE;
        value_ty.name = name;
        value_ty.nullable = true;
    } else {
        value_ty.tag = VT_NONNULL;
        value_ty.name = name;
    }
    value_ty
}

// A pointee or slice element: `scalar NAME` or `wire-struct NAME`.
fn read_pointee(inout reader: Reader, in bytes: Slice[u8], inout state: S, inout param: Par) {
    let (kind_start, kind_end) = reader.field(in bytes);
    let name = field_sym(inout reader, in bytes, inout state);
    if field_is(in bytes, kind_start, kind_end, in "scalar") {
        param.elem_scalar = scalar_code(name);
    } else {
        param.elem_is_struct = true;
        param.type_name = name;
    }
}

fn read_param(inout reader: Reader, in bytes: Slice[u8], inout state: S) -> Par {
    let name = field_sym(inout reader, in bytes, inout state);
    let mut param = Par {
        name: name,
        tag: P_CSTR,
        value_ty: vt_unit(),
        access: A_IN,
        nullable: false,
        elem_is_struct: false,
        elem_scalar: 0,
        type_name: NONE
    };
    let (tag_start, tag_end) = reader.field(in bytes);
    if field_is(in bytes, tag_start, tag_end, in "value") {
        param.tag = P_VALUE;
        param.value_ty = read_value(inout reader, in bytes, inout state);
    } else if field_is(in bytes, tag_start, tag_end, in "nocapture-slice") {
        param.tag = P_SLICE;
        let (access_start, access_end) = reader.field(in bytes);
        param.access = access_code(in bytes, access_start, access_end);
        param.elem_scalar = scalar_code(field_sym(inout reader, in bytes, inout state));
    } else if field_is(in bytes, tag_start, tag_end, in "nocapture-slice/2") {
        param.tag = P_SLICE;
        let (access_start, access_end) = reader.field(in bytes);
        param.access = access_code(in bytes, access_start, access_end);
        let (option_start, option_end) = reader.field(in bytes);
        param.nullable = field_is(in bytes, option_start, option_end, in "option");
        read_pointee(inout reader, in bytes, inout state, inout param);
    } else if field_is(in bytes, tag_start, tag_end, in "nocapture-pointer") {
        param.tag = P_POINTER;
        let (access_start, access_end) = reader.field(in bytes);
        param.access = access_code(in bytes, access_start, access_end);
        let (option_start, option_end) = reader.field(in bytes);
        param.nullable = field_is(in bytes, option_start, option_end, in "option");
        read_pointee(inout reader, in bytes, inout state, inout param);
    } else if field_is(in bytes, tag_start, tag_end, in "extern-handle") {
        param.tag = P_HANDLE;
        let (access_start, access_end) = reader.field(in bytes);
        param.access = access_code(in bytes, access_start, access_end);
        param.type_name = field_sym(inout reader, in bytes, inout state);
    } else if field_is(in bytes, tag_start, tag_end, in "callback-function") {
        // `retain` or `nocapture`: the plans do not depend on which.
        param.tag = P_FUNCTION;
        let keep = reader.field(in bytes);
        param.type_name = field_sym(inout reader, in bytes, inout state);
    } else if field_is(in bytes, tag_start, tag_end, in "nocapture-cstr-list") {
        // Only a `CStr` can refuse a call, so a list keeps its own tag.
        param.tag = P_CSTR_LIST;
    } else if field_is(in bytes, tag_start, tag_end, in "nocapture-cwstr") {
        param.tag = P_CWSTR;
    } else if field_is(in bytes, tag_start, tag_end, in "pinned-buffer") {
        param.tag = P_PINNED;
        let (access_start, access_end) = reader.field(in bytes);
        param.access = access_code(in bytes, access_start, access_end);
        param.elem_scalar = scalar_code(field_sym(inout reader, in bytes, inout state));
    }
    param
}

// One function of library row `lib`: symbol, parameters, result and the
// trailers appended only when declared.
fn read_function(
    inout reader: Reader,
    in bytes: Slice[u8],
    inout state: S,
    lib: u64,
    indirect: bool
) {
    let sym = field_sym(inout reader, in bytes, inout state);
    let param_start = state.params.len();
    let param_count = reader.count(in bytes);
    for j in 0..param_count {
        let param = read_param(inout reader, in bytes, inout state);
        state.params.push(param);
    }
    let result = read_value(inout reader, in bytes, inout state);
    let mapped = peek_is(in reader, in bytes, in "mapping/length-from");
    if mapped {
        let marker = reader.field(in bytes);
        let length = reader.count(in bytes);
    }
    let errno = peek_is(in reader, in bytes, in "errno/after-call");
    if errno {
        let marker = reader.field(in bytes);
    }
    let mut has_variadic = false;
    let mut variadic_first: u64 = 0;
    if peek_is(in reader, in bytes, in "variadic/from") {
        let marker = reader.field(in bytes);
        variadic_first = reader.count(in bytes);
        has_variadic = true;
    }
    // The C symbol several declarations may share (`#[link_name]`): the
    // plans and shapes name the declaration's own symbol.
    let mut link = NONE;
    if peek_is(in reader, in bytes, in "link-name") {
        let marker = reader.field(in bytes);
        link = field_sym(inout reader, in bytes, inout state);
    }
    state.funs.push(Fun {
        sym: sym,
        param_start: param_start,
        param_count: param_count,
        result: result,
        errno: errno,
        has_variadic: has_variadic,
        variadic_first: variadic_first,
        lib: lib,
        indirect: indirect,
        link: link,
        mapped: mapped
    });
}

// Function rows funs[first..first+n] in symbol order (insertion sort, stable).
fn sort_fun_rows(inout state: S, first: u64, n: u64) {
    for i in 1..n {
        let key = state.fun(add(first, i));
        let mut j = i;
        loop {
            if j == 0 {
                break;
            }
            let prev = state.fun(add(first, wrapping_sub(j, 1)));
            if state.name_cmp(prev.sym, key.sym) <= 0 {
                break;
            }
            state.funs.try_set(add(first, j), prev);
            j = wrapping_sub(j, 1);
        }
        state.funs.try_set(add(first, j), key);
    }
}

fn parse_const_int(in bytes: Slice[u8], start: u64, end: u64) -> (bool, u64) {
    let first = bytes.try_get(start).unwrap_or(0);
    let neg = start < end && first == Ascii::Hyphen;
    let mut i = if neg { inc(start) } else { start };
    let mut magnitude: u64 = 0;
    loop {
        if i >= end {
            break;
        }
        let digit = bytes.try_get(i).unwrap_or(Ascii::Digit0);
        magnitude = wrapping_add(
            wrapping_mul(magnitude, 10),
            widen_u64(wrapping_sub(digit, Ascii::Digit0))
        );
        i = inc(i);
    }
    (neg, magnitude)
}

// One canonical descriptor `bytes[start..end]` with its handler tier, as a library row.
pub fn read_library(in bytes: Slice[u8], start: u64, end: u64, handler: u64, inout state: S) {
    let mut reader = Reader { pos: start, stop: end };
    let schema = reader.field(in bytes);
    let name = field_sym(inout reader, in bytes, inout state);
    let triple = field_sym(inout reader, in bytes, inout state);
    let convention = reader.field(in bytes);
    let model = reader.field(in bytes);
    let mode = reader.field(in bytes);
    let link_name = reader.field(in bytes);
    let digest = reader.field(in bytes);
    let (header_tag_start, header_tag_end) = reader.field(in bytes);
    if field_is(in bytes, header_tag_start, header_tag_end, in "some") {
        let header = reader.field(in bytes);
    }
    let (pkg_tag_start, pkg_tag_end) = reader.field(in bytes);
    if field_is(in bytes, pkg_tag_start, pkg_tag_end, in "some") {
        let pkg = reader.field(in bytes);
    }
    let lib = state.libs.len();
    let enum_start = state.enums.len();
    let enum_count = reader.count(in bytes);
    for i in 0..enum_count {
        let enum_name = field_sym(inout reader, in bytes, inout state);
        let scalar = scalar_code(field_sym(inout reader, in bytes, inout state));
        let variant_start = state.variant_names.len();
        let variant_count = reader.count(in bytes);
        for j in 0..variant_count {
            let variant_name = field_sym(inout reader, in bytes, inout state);
            state.variant_names.push(variant_name);
            let value = reader.field(in bytes);
        }
        state.enums.push(EnumRow {
            name: enum_name,
            scalar: scalar,
            variant_start: variant_start,
            variant_count: variant_count
        });
    }
    let fun_start = state.funs.len();
    let fun_decl_count = reader.count(in bytes);
    for i in 0..fun_decl_count {
        read_function(inout reader, in bytes, inout state, lib, false);
    }
    // Each callback type's call, appended only when present; the rows are
    // then put in symbol order, as the descriptor keeps its functions.
    if peek_is(in reader, in bytes, in "callbacks") {
        let marker = reader.field(in bytes);
        let callback_count = reader.count(in bytes);
        for i in 0..callback_count {
            read_function(inout reader, in bytes, inout state, lib, true);
        }
    }
    let fun_count = wrapping_sub(state.funs.len(), fun_start);
    sort_fun_rows(inout state, fun_start, fun_count);
    let wire_start = state.wire_structs.len();
    if peek_is(in reader, in bytes, in "wire-structs") {
        let marker = reader.field(in bytes);
        let wire_decl_count = reader.count(in bytes);
        for i in 0..wire_decl_count {
            let wire_name = field_sym(inout reader, in bytes, inout state);
            let size = reader.count(in bytes);
            let align = reader.count(in bytes);
            let field_start = state.wire_fields.len();
            let field_count = reader.count(in bytes);
            for j in 0..field_count {
                let field_name = field_sym(inout reader, in bytes, inout state);
                let mut field = Wf {
                    name: field_name,
                    kind: F_PAD,
                    bits: 0,
                    signed: false,
                    endian: E_NATIVE,
                    size: 0,
                    struct_name: NONE,
                    offset: 0
                };
                let (lo, hi) = reader.field(in bytes);
                if field_is(in bytes, lo, hi, in "integer") {
                    field.kind = F_INT;
                    let (sign_start, sign_end) = reader.field(in bytes);
                    field.signed = field_is(in bytes, sign_start, sign_end, in "i");
                    let (bits_start, bits_end) = reader.field(in bytes);
                    field.bits = match bytes.try_read_u16_le(bits_start) {
                        Option::Some(v) => widen_u64(v),
                        Option::None => 0,
                    };
                    field.size = field.bits / 8;
                    let (order_start, order_end) = reader.field(in bytes);
                    if field_is(in bytes, order_start, order_end, in "le") {
                        field.endian = E_LITTLE;
                    } else if field_is(in bytes, order_start, order_end, in "be") {
                        field.endian = E_BIG;
                    }
                } else if field_is(in bytes, lo, hi, in "bytes") {
                    field.kind = F_BYTES;
                    field.size = reader.count(in bytes);
                } else if field_is(in bytes, lo, hi, in "zero-pad") {
                    field.kind = F_PAD;
                    field.size = reader.count(in bytes);
                } else {
                    field.kind = F_STRUCT;
                    field.struct_name = field_sym(inout reader, in bytes, inout state);
                }
                state.wire_fields.push(field);
            }
            state.wire_structs.push(Ws {
                name: wire_name,
                size: size,
                align: align,
                field_start: field_start,
                field_count: field_count
            });
        }
    }
    let wire_count = wrapping_sub(state.wire_structs.len(), wire_start);
    // Offsets: fields are packed in order (a wire struct has no implicit
    // padding); a nested struct's size is its own declaration's.
    for i in 0..wire_count {
        let row = state.ws(add(wire_start, i));
        let mut offset: u64 = 0;
        for j in 0..row.field_count {
            let mut field = state.wf(add(row.field_start, j));
            if field.kind == F_STRUCT {
                for k in 0..wire_count {
                    let inner = state.ws(add(wire_start, k));
                    if inner.name == field.struct_name {
                        field.size = inner.size;
                    }
                }
            }
            field.offset = offset;
            offset = add(offset, field.size);
            state.wire_fields.try_set(add(row.field_start, j), field);
        }
    }
    let extern_start = state.extern_types.len();
    if peek_is(in reader, in bytes, in "extern-types") {
        let marker = reader.field(in bytes);
        let extern_count = reader.count(in bytes);
        for i in 0..extern_count {
            let extern_name = field_sym(inout reader, in bytes, inout state);
            let (lo, hi) = reader.field(in bytes);
            state.extern_types.push(Xt {
                name: extern_name,
                linear: field_is(in bytes, lo, hi, in "linear"),
                copy: false,
                drop: NONE,
                mapping: NONE
            });
        }
        if peek_is(in reader, in bytes, in "drop-imports") {
            let marker2 = reader.field(in bytes);
            for i in 0..extern_count {
                let (lo, hi) = reader.field(in bytes);
                if lo != hi {
                    let mut ext_type = state.xt(add(extern_start, i));
                    ext_type.drop = state.intern(in bytes[lo..hi]);
                    state.extern_types.try_set(add(extern_start, i), ext_type);
                }
            }
        }
        // One element per extern type of the descriptor, callback types
        // included, in name order: empty unless a mapping.
        if peek_is(in reader, in bytes, in "mappings") {
            let marker3 = reader.field(in bytes);
            let mut names = ChunkSeq::new[u32]();
            for i in 0..extern_count {
                names.push(state.xt(add(extern_start, i)).name);
            }
            for i in 0..fun_count {
                let func = state.fun(add(fun_start, i));
                if func.indirect {
                    names.push(func.sym);
                }
            }
            sort_by_name(in state, inout names);
            for i in 0..names.len() {
                let (lo, hi) = reader.field(in bytes);
                if lo != hi {
                    let element = state.intern(in bytes[lo..hi]);
                    let name = u32_at(in names, i);
                    for j in 0..extern_count {
                        let mut ext_type = state.xt(add(extern_start, j));
                        if ext_type.name == name {
                            ext_type.mapping = element;
                            state.extern_types.try_set(add(extern_start, j), ext_type);
                        }
                    }
                }
            }
        }
    }
    // Each callback declares a copyable handle type of its name.
    for i in 0..fun_count {
        let func = state.fun(add(fun_start, i));
        if func.indirect {
            state
                .extern_types
                .push(Xt { name: func.sym, linear: false, copy: true, drop: NONE, mapping: NONE });
        }
    }
    let const_start = state.consts.len();
    if peek_is(in reader, in bytes, in "consts") {
        let marker3 = reader.field(in bytes);
        let const_count = reader.count(in bytes);
        for i in 0..const_count {
            let const_name = field_sym(inout reader, in bytes, inout state);
            let const_scalar = scalar_code(field_sym(inout reader, in bytes, inout state));
            let (value_start, value_end) = reader.field(in bytes);
            let (neg, value) = parse_const_int(in bytes, value_start, value_end);
            state
                .consts
                .push(ConstRow { name: const_name, scalar: const_scalar, neg: neg, value: value });
        }
    }
    state.libs.push(Lib {
        name: name,
        handler: handler,
        triple: triple,
        enum_start: enum_start,
        enum_count: enum_count,
        fun_start: fun_start,
        fun_count: fun_count,
        wire_start: wire_start,
        wire_count: wire_count,
        extern_start: extern_start,
        extern_count: wrapping_sub(state.extern_types.len(), extern_start),
        const_start: const_start,
        const_count: wrapping_sub(state.consts.len(), const_start)
    });
}

// ----- the type mapping (types.rs) --------------------------------------------

// The wire struct of library `lib` named `name`, or NONE64.
fn lib_ws(in state: S, lib: u64, name: u32) -> u64 {
    let lib_row = state.lib(lib);
    for i in 0..lib_row.wire_count {
        if state.ws(add(lib_row.wire_start, i)).name == name {
            return add(lib_row.wire_start, i);
        }
    }
    NONE64
}

pub fn find_gs(in state: S, name: u32) -> u64 {
    for i in 0.. state.gen_structs.len() {
        if state.gs(i).name == name {
            return i;
        }
    }
    NONE64
}

pub fn find_ge(in state: S, name: u32) -> u64 {
    for i in 0.. state.gen_enums.len() {
        if state.ge(i).name == name {
            return i;
        }
    }
    NONE64
}

pub fn find_gh(in state: S, name: u32) -> u64 {
    for i in 0.. state.gen_handles.len() {
        if state.gh(i).name == name {
            return i;
        }
    }
    NONE64
}

// `field_integer`: the source carrier of a wire integer field, or NONE
// after writing its error at `out[mark..]`.
fn field_integer(inout state: S, bits: u64, signed: bool) -> u32 {
    let base = if bits == 8 {
        SC_U8
    } else if bits == 16 {
        SC_U16
    } else if bits == 32 {
        SC_U32
    } else if bits == 64 {
        SC_U64
    } else {
        state.put(in "wire field of ");
        if signed {
            state.put(in "i");
        } else {
            state.put(in "u");
        }
        state.put_u64(bits);
        state.put(in " has no source carrier");
        return NONE;
    };
    if signed {
        sym8(wrapping_add(base, 1))
    } else {
        sym8(base)
    }
}

// `struct_adt` of wire struct row `row`: a new generated struct (not yet
// in the table's lookup order: callers compare, then keep or drop it).
fn struct_adt(inout state: S, lib: u64, row: u64, depth: u64) -> Gs {
    let wire = state.ws(row);
    let mut adt = Gs {
        name: wire.name,
        ok: true,
        err: NONE,
        field_start: state.gen_fields.len(),
        field_count: 0
    };
    let mut fields = ChunkSeq::new[Gf]();
    for j in 0..wire.field_count {
        let field = state.wf(add(wire.field_start, j));
        let mut ty = NONE;
        if field.kind == F_INT {
            let mark = state.out.len();
            let scalar = field_integer(inout state, field.bits, field.signed);
            if scalar == NONE {
                adt.ok = false;
                adt.err = state.intern_tail(mark);
                return adt;
            }
            ty = state.ty_name(scalar);
        } else if field.kind == F_BYTES {
            let u8_ty = state.ty_name(sym8(SC_U8));
            ty = state.ty_repeat(u8_ty, field.size);
        } else if field.kind == F_STRUCT {
            let inner = lib_ws(in state, lib, field.struct_name);
            if depth < MAX_WIRE_STRUCT_DEPTH {
                let inner_adt = struct_adt(inout state, lib, inner, inc(depth));
                if !inner_adt.ok {
                    adt.ok = false;
                    adt.err = inner_adt.err;
                    return adt;
                }
            }
            ty = state.ty_name(field.struct_name);
        }
        if field.kind != F_PAD {
            fields.push(Gf { name: field.name, ty: ty });
        }
    }
    adt.field_start = state.gen_fields.len();
    adt.field_count = fields.len();
    for i in 0..fields.len() {
        match fields.try_get(i) {
            Option::Some(field) => state.gen_fields.push(field),
            Option::None => {},
        }
    }
    adt
}

fn gs_eq(in state: S, left: Gs, right: Gs) -> bool {
    if left.ok != right.ok {
        return false;
    }
    if !left.ok {
        return left.err == right.err;
    }
    if left.field_count != right.field_count {
        return false;
    }
    for i in 0..left.field_count {
        let left_field = state.gf(add(left.field_start, i));
        let right_field = state.gf(add(right.field_start, i));
        if left_field.name != right_field.name || !state.ty_eq(left_field.ty, right_field.ty) {
            return false;
        }
    }
    true
}

fn enum_eq(in state: S, left: u64, right: u64) -> bool {
    let left_enum = state.enum_row(left);
    let right_enum = state.enum_row(right);
    if left_enum.variant_count != right_enum.variant_count {
        return false;
    }
    for i in 0..left_enum.variant_count {
        if u32_at(in state.variant_names, add(left_enum.variant_start, i))
            != u32_at(in state.variant_names, add(right_enum.variant_start, i))
        {
            return false;
        }
    }
    true
}

// `collect_structs`: wire struct `row` after the structs it nests.
fn collect_structs(in state: S, lib: u64, row: u64, inout out: ChunkSeq[u64], depth: u64) {
    if depth > MAX_WIRE_STRUCT_DEPTH {
        return;
    }
    let wire = state.ws(row);
    for j in 0..wire.field_count {
        let field = state.wf(add(wire.field_start, j));
        if field.kind == F_STRUCT {
            let inner = lib_ws(in state, lib, field.struct_name);
            if inner != NONE64 {
                collect_structs(in state, lib, inner, inout out, inc(depth));
            }
        }
    }
    out.push(row);
}

fn duplicate(inout state: S, name: u32) -> Err {
    let mark = state.out.len();
    state.put(in "imported libraries declare '");
    state.put_name(name);
    state.put(in "' differently");
    Err { kind: K_DUPLICATE, msg: state.intern_tail(mark), has_span: false, start: 0, end: 0 }
}

// `Generated::new`: no error (msg NONE) or the first duplicate.
pub fn generate(inout state: S) -> Err {
    for li in 0.. state.libs.len() {
        let lib_row = state.lib(li);
        let mut layouts = ChunkSeq::new[u64]();
        for i in 0..lib_row.wire_count {
            collect_structs(in state, li, add(lib_row.wire_start, i), inout layouts, 0);
        }
        for i in 0..layouts.len() {
            let row = u64_at(in layouts, i);
            let adt = struct_adt(inout state, li, row, 0);
            let at = find_gs(in state, adt.name);
            if at == NONE64 {
                state.gen_structs.push(adt);
            } else if !gs_eq(in state, state.gs(at), adt) {
                return duplicate(inout state, adt.name);
            }
        }
        for i in 0..lib_row.enum_count {
            let row = add(lib_row.enum_start, i);
            let name = state.enum_row(row).name;
            let at = find_ge(in state, name);
            if at == NONE64 {
                state.gen_enums.push(Ge { name: name, row: row });
            } else if !enum_eq(in state, state.ge(at).row, row) {
                return duplicate(inout state, name);
            }
        }
    }
    for li in 0.. state.libs.len() {
        let lib_row = state.lib(li);
        for i in 0..lib_row.extern_count {
            let ext_type = state.xt(add(lib_row.extern_start, i));
            if find_gh(in state, ext_type.name) != NONE64
                || find_gs(in state, ext_type.name) != NONE64
                || find_ge(in state, ext_type.name) != NONE64
            {
                return duplicate(inout state, ext_type.name);
            }
            state.gen_handles.push(Gh {
                name: ext_type.name,
                linear: ext_type.linear,
                copy: ext_type.copy,
                mapping: ext_type.mapping
            });
        }
    }
    for i in 0.. state.params.len() {
        if state.par(i).tag == P_PINNED {
            state.pinned = true;
        }
    }
    for fi in 0.. state.funs.len() {
        let sh = compute_shape(inout state, fi);
        if sh.ok && state.mentions_result(sh.result) {
            state.invalid = true;
        }
        state.shapes.push(sh);
    }
    no_err()
}

fn shape_err(inout state: S, mark: u64) -> Sh {
    Sh { ok: false, err: state.intern_tail(mark), param_start: 0, param_count: 0, result: NONE }
}

// `Generated::pointee`: the source type of a pointee, or NONE after
// writing the error.
fn pointee(inout state: S, param: Par) -> u32 {
    if !param.elem_is_struct {
        return state.ty_name(sym8(param.elem_scalar));
    }
    let at = find_gs(in state, param.type_name);
    if at == NONE64 {
        state.put(in "wire struct ");
        state.put_name(param.type_name);
        state.put(in " was not generated");
        return NONE;
    }
    let adt = state.gs(at);
    if !adt.ok {
        state.put(in "wire struct ");
        state.put_name(param.type_name);
        state.put(in ": ");
        state.put_name(adt.err);
        return NONE;
    }
    state.ty_name(param.type_name)
}

fn in_place_element(param: Par) -> bool {
    !param.elem_is_struct
        && (param.elem_scalar == SC_U8
            || param.elem_scalar == SC_U32
            || param.elem_scalar == SC_U64
            || param.elem_scalar == SC_I64
            || param.elem_scalar == SC_USIZE)
}

fn handle_pass(access: u8) -> u8 {
    if access == A_IN {
        PASS_IN
    } else if access == A_SINK {
        PASS_SINK
    } else {
        PASS_INOUT
    }
}

// `Generated::callback_type`: the source type of a Vesper function C calls
// as callback type `name` of library row `lib`, or NONE after writing the
// error. Its parameters and result each cross as one C word or float, and
// its row holds the direct libraries' effects and `Realtime`.
fn callback_type(inout state: S, lib: u64, name: u32) -> u32 {
    let lib_row = state.lib(lib);
    let mut fi = NONE64;
    for i in 0..lib_row.fun_count {
        let func = state.fun(add(lib_row.fun_start, i));
        if func.indirect && func.sym == name {
            fi = add(lib_row.fun_start, i);
        }
    }
    if fi == NONE64 {
        state.put_name(name);
        state.put(in " is not a callback type");
        return NONE;
    }
    let func = state.fun(fi);
    let mut args = ChunkSeq::new[u32]();
    let mut ok = true;
    for j in 1..func.param_count {
        let param = state.par(add(func.param_start, j));
        if param.tag == P_VALUE && param.value_ty.tag == VT_SCALAR {
            args.push(state.ty_name(sym8(param.value_ty.scalar)));
        } else if param.tag == P_VALUE && param.value_ty.tag == VT_FLOAT {
            args.push(state.ty_name(param.value_ty.name));
        } else {
            ok = false;
        }
    }
    let result_vt = func.result;
    if result_vt.tag == VT_UNIT {
        let none = ChunkSeq::new[u32]();
        args.push(state.ty_tuple(in none));
    } else if result_vt.tag == VT_SCALAR {
        args.push(state.ty_name(sym8(result_vt.scalar)));
    } else if result_vt.tag == VT_FLOAT {
        args.push(state.ty_name(result_vt.name));
    } else {
        ok = false;
    }
    if !ok || func.errno {
        state.put(in "C calls a Vesper function of callback type ");
        state.put_name(name);
        state.put(
            in " only with integer or float parameters and an integer, float or Unit result, without errno, for now"
        );
        return NONE;
    }
    let passes = state.fn_passes.len();
    for j in 1..func.param_count {
        state.fn_passes.push(PASS_IN);
    }
    let fn_ty = state.ty_named(n32(passes), in args);
    let mut node = state.tn(fn_ty);
    node.kind = TK_FN;
    state.type_nodes.try_set(w(fn_ty), node);
    fn_ty
}

// `Generated::compute_shape` of function row `fi`.
pub fn compute_shape(inout state: S, fi: u64) -> Sh {
    let func = state.fun(fi);
    let mark = state.out.len();
    let mut params = ChunkSeq::new[Sp]();
    for j in 0..func.param_count {
        let param = state.par(add(func.param_start, j));
        let mut shape_param = Sp {
            name: param.name,
            pass: PASS_IN,
            slice: false,
            ty: NONE,
            nullable: false,
            in_place: false
        };
        if param.tag == P_VALUE {
            let value_ty = param.value_ty;
            if value_ty.tag == VT_SCALAR {
                shape_param.ty = state.ty_name(sym8(value_ty.scalar));
            } else if value_ty.tag == VT_FLOAT {
                shape_param.ty = state.ty_name(value_ty.name);
            } else if value_ty.tag == VT_BOOL {
                shape_param.ty = state.ty_name(S_BOOL);
            } else if value_ty.tag == VT_ENUM {
                shape_param.ty = state.ty_name(value_ty.name);
            } else if value_ty.tag == VT_UNIT {
                state.put(in "Unit parameter");
                return shape_err(inout state, mark);
            } else if value_ty.tag == VT_CSTR || value_ty.tag == VT_CWSTR {
                state.put(in "a C string result is not a parameter");
                return shape_err(inout state, mark);
            } else if value_ty.tag == VT_HANDLE || value_ty.tag == VT_NONNULL {
                state.put(in "a handle parameter needs a mode");
                return shape_err(inout state, mark);
            } else {
                state.put(
                    in "address parameters have no source carrier (source code has no raw pointers)"
                );
                return shape_err(inout state, mark);
            }
        } else if param.tag == P_POINTER {
            let pointee_ty = pointee(inout state, param);
            if pointee_ty == NONE {
                return shape_err(inout state, mark);
            }
            shape_param.ty = if param.nullable {
                state.ty_app1(S_OPTION, pointee_ty)
            } else {
                pointee_ty
            };
            shape_param.pass = if param.access == A_IN {
                PASS_IN
            } else {
                PASS_INOUT
            };
        } else if param.tag == P_SLICE {
            shape_param.pass = if param.access == A_IN {
                PASS_IN
            } else {
                PASS_INOUT
            };
            let elem_ty = pointee(inout state, param);
            if elem_ty == NONE {
                return shape_err(inout state, mark);
            }
            shape_param.slice = true;
            shape_param.ty = elem_ty;
            shape_param.nullable = param.nullable;
            shape_param.in_place = in_place_element(param);
        } else if param.tag == P_HANDLE {
            shape_param.pass = handle_pass(param.access);
            shape_param.ty = state.ty_name(param.type_name);
        } else if param.tag == P_FUNCTION {
            // A named Vesper function, handed to C as a trampoline.
            shape_param.ty = callback_type(inout state, func.lib, param.type_name);
            if shape_param.ty == NONE {
                return shape_err(inout state, mark);
            }
        } else if param.tag == P_PINNED {
            shape_param.pass = if param.access == A_IN {
                PASS_IN
            } else {
                PASS_INOUT
            };
            let elem_ty = state.ty_name(sym8(param.elem_scalar));
            shape_param.ty = state.ty_app1(S_PINNED, elem_ty);
        } else if param.tag == P_CWSTR {
            let u16_ty = state.ty_name(sym8(SC_U16));
            shape_param.ty = state.ty_app1(S_SLICE, u16_ty);
        } else {
            let u8_ty = state.ty_name(sym8(SC_U8));
            shape_param.ty = state.ty_app1(S_SLICE, u8_ty);
        }
        params.push(shape_param);
    }
    let result_vt = func.result;
    let mut result = NONE;
    if result_vt.tag == VT_UNIT {
        let none = ChunkSeq::new[u32]();
        result = state.ty_tuple(in none);
    } else if result_vt.tag == VT_SCALAR {
        result = state.ty_name(sym8(result_vt.scalar));
    } else if result_vt.tag == VT_FLOAT {
        result = state.ty_name(result_vt.name);
    } else if result_vt.tag == VT_BOOL {
        let inner_ty = state.ty_name(S_BOOL);
        let invalid_ty = state.ty_name(S_INVALID);
        result = state.ty_app2(S_RESULT, inner_ty, invalid_ty);
    } else if result_vt.tag == VT_ENUM {
        let inner_ty = state.ty_name(result_vt.name);
        let invalid_ty = state.ty_name(S_INVALID);
        result = state.ty_app2(S_RESULT, inner_ty, invalid_ty);
    } else if result_vt.tag == VT_ADDRESS {
        state.put(
            in "ForeignVal[Ptr[..]] results have no source carrier (source code has no raw pointers)"
        );
        return shape_err(inout state, mark);
    } else if result_vt.tag == VT_CSTR {
        let byte = state.ty_name(sym8(SC_U8));
        let text = state.ty_app1(S_CHUNK_SEQ, byte);
        result = state.ty_app1(S_OPTION, text);
    } else if result_vt.tag == VT_CWSTR {
        let unit = state.ty_name(sym8(SC_U16));
        let text = state.ty_app1(S_CHUNK_SEQ, unit);
        result = state.ty_app1(S_OPTION, text);
    } else if result_vt.tag == VT_HANDLE && result_vt.nullable {
        let inner_ty = state.ty_name(result_vt.name);
        result = state.ty_app1(S_OPTION, inner_ty);
    } else if result_vt.tag == VT_HANDLE {
        let inner_ty = state.ty_name(result_vt.name);
        let invalid_ty = state.ty_name(S_INVALID);
        result = state.ty_app2(S_RESULT, inner_ty, invalid_ty);
    } else {
        result = state.ty_name(result_vt.name);
    }
    // `wrap_result`.
    if func.errno {
        let u32_ty = state.ty_name(sym8(SC_U32));
        let mut pair = ChunkSeq::new[u32]();
        pair.push(result);
        pair.push(u32_ty);
        result = state.ty_tuple(in pair);
    }
    if takes_cstr(in state, fi) {
        let invalid_ty = state.ty_name(S_INVALID);
        result = state.ty_app2(S_RESULT, result, invalid_ty);
    }
    let param_start = state.shape_params.len();
    for j in 0..params.len() {
        match params.try_get(j) {
            Option::Some(x) => state.shape_params.push(x),
            Option::None => {},
        }
    }
    Sh { ok: true, err: NONE, param_start: param_start, param_count: params.len(), result: result }
}

fn takes_cstr(in state: S, fi: u64) -> bool {
    let func = state.fun(fi);
    for j in 0..func.param_count {
        let tag = state.par(add(func.param_start, j)).tag;
        if tag == P_CSTR || tag == P_CWSTR {
            return true;
        }
    }
    false
}

pub fn slice_count(in state: S, shape: Sh) -> u64 {
    let mut n: u64 = 0;
    for j in 0..shape.param_count {
        if state.sp(add(shape.param_start, j)).slice {
            n = inc(n);
        }
    }
    n
}

// ----- names in byte order ----------------------------------------------------

// Sorts `xs` (indices whose names `key` gives) by name: insertion sort,
// stable, as the BTreeMaps of the Rust side iterate.
fn sort_by_name(in state: S, inout xs: ChunkSeq[u32]) {
    let n = xs.len();
    for i in 1..n {
        let key = u32_at(in xs, i);
        let mut j = i;
        loop {
            if j == 0 {
                break;
            }
            let prev = u32_at(in xs, wrapping_sub(j, 1));
            if state.name_cmp(prev, key) <= 0 {
                break;
            }
            xs.try_set(j, prev);
            j = wrapping_sub(j, 1);
        }
        xs.try_set(j, key);
    }
}

// Generated struct (Ok only), enum and handle names, each table sorted.
pub fn sorted_struct_rows(in state: S) -> ChunkSeq[u32] {
    let mut names = ChunkSeq::new[u32]();
    for i in 0.. state.gen_structs.len() {
        let adt = state.gs(i);
        if adt.ok {
            names.push(adt.name);
        }
    }
    sort_by_name(in state, inout names);
    names
}

pub fn sorted_enum_names(in state: S) -> ChunkSeq[u32] {
    let mut names = ChunkSeq::new[u32]();
    for i in 0.. state.gen_enums.len() {
        names.push(state.ge(i).name);
    }
    sort_by_name(in state, inout names);
    names
}

pub fn sorted_handle_names(in state: S) -> ChunkSeq[u32] {
    let mut names = ChunkSeq::new[u32]();
    for i in 0.. state.gen_handles.len() {
        names.push(state.gh(i).name);
    }
    sort_by_name(in state, inout names);
    names
}

// ----- `append` ---------------------------------------------------------------

fn put_mode(inout state: S, linear: bool, affine: bool) {
    if linear {
        state.put(in "linear");
    } else if affine {
        state.put(in "affine");
    } else {
        state.put(in "copy");
    }
}

fn put_pass(inout state: S, pass: u8) {
    if pass == PASS_IN {
        state.put(in "in");
    } else if pass == PASS_INOUT {
        state.put(in "inout");
    } else {
        state.put(in "sink");
    }
}

// `adt NAME mode=.. enum=.. tile=- @0..0` and its variant line.
fn adt_head(inout state: S, name: u32, linear: bool, affine: bool, is_enum: bool) {
    state.indent(1);
    state.put(in "adt ");
    state.put_q(name);
    state.put(in " mode=");
    put_mode(inout state, linear, affine);
    if is_enum {
        state.put(in " enum=1");
    } else {
        state.put(in " enum=0");
    }
    state.put(in " tile=- @0..0");
    state.nl();
}

fn variant_line(inout state: S, name: u32, named: bool) {
    state.indent(2);
    state.put(in "variant ");
    state.put_q(name);
    if named {
        state.put(in " named=1");
    } else {
        state.put(in " named=0");
    }
    state.nl();
}

fn field_line(inout state: S, name: u32, ty: u32) {
    state.indent(3);
    state.put(in "field ");
    state.put_q(name);
    state.put(in " modality=- temp=-");
    state.nl();
    state.dump_ty(ty, 4);
}

// One slice-length vector of an instance: lens[a..a+n].
pub copy struct Inst {
    lib: u32,
    sym: u32,
    a: u64,
    n: u64,
}

// `Generated::append` onto an empty module, dumped as the AST dump's
// items (depth 1). Pass 1 when `pass2` is false; pass 2 declares one
// operation per vector of `insts` (sorted and unique, as a BTreeSet).
pub fn append(inout state: S, pass2: bool, in insts: ChunkSeq[Inst], in lens: ChunkSeq[u64]) {
    let structs = sorted_struct_rows(in state);
    for i in 0..structs.len() {
        let adt = state.gs(find_gs(in state, u32_at(in structs, i)));
        adt_head(inout state, adt.name, false, false, false);
        variant_line(inout state, adt.name, true);
        for j in 0..adt.field_count {
            let field = state.gf(add(adt.field_start, j));
            field_line(inout state, field.name, field.ty);
        }
    }
    let enums = sorted_enum_names(in state);
    for i in 0..enums.len() {
        let row = state.enum_row(state.ge(find_ge(in state, u32_at(in enums, i))).row);
        adt_head(inout state, row.name, false, false, true);
        for j in 0..row.variant_count {
            variant_line(
                inout state,
                u32_at(in state.variant_names, add(row.variant_start, j)),
                false
            );
        }
    }
    let handles = sorted_handle_names(in state);
    for i in 0..handles.len() {
        let handle = state.gh(find_gh(in state, u32_at(in handles, i)));
        if handle.mapping != NONE {
            // A mapping is viewed in place through a sequence over the
            // foreign memory.
            adt_head(inout state, handle.name, true, false, false);
            variant_line(inout state, handle.name, true);
            let element = state.ty_name(handle.mapping);
            let seq = state.ty_app1(S_CHUNK_SEQ, element);
            field_line(inout state, S_DATA, seq);
            continue;
        }
        adt_head(inout state, handle.name, handle.linear, !handle.linear && !handle.copy, false);
        variant_line(inout state, handle.name, true);
        let u64_ty = state.ty_name(sym8(SC_U64));
        field_line(inout state, S_HANDLE, u64_ty);
    }
    // `linear struct Pinned[T] { data: ChunkSeq[T] }`.
    if state.pinned {
        adt_head(inout state, S_PINNED, true, false, false);
        state.indent(2);
        state.put(in "generic \"T\" bound=linear row=0");
        state.nl();
        variant_line(inout state, S_PINNED, true);
        let generic_ty = state.ty_name(S_T);
        let seq = state.ty_app1(S_CHUNK_SEQ, generic_ty);
        field_line(inout state, S_DATA, seq);
        state.indent(1);
        state.put(in "impl");
        state.nl();
        state.indent(2);
        state.put(in "generic \"T\" bound=linear row=0");
        state.nl();
        let pinned_ty = state.ty_app1(S_PINNED, generic_ty);
        state.dump_ty(pinned_ty, 2);
        state.indent(2);
        state.put(in "fn \"address\" fip=0 @0..0");
        state.nl();
        state.indent(3);
        state.put(in "param \"self\" pass=in @0..0");
        state.nl();
        state.dump_ty(pinned_ty, 4);
        state.indent(3);
        state.put(in "result");
        state.nl();
        let u64_ty = state.ty_name(sym8(SC_U64));
        state.dump_ty(u64_ty, 4);
    }
    if state.invalid {
        adt_head(inout state, S_INVALID, false, false, false);
        variant_line(inout state, S_INVALID, true);
        let u64_ty = state.ty_name(sym8(SC_U64));
        field_line(inout state, S_RAW, u64_ty);
    }
    for li in 0.. state.libs.len() {
        let lib_row = state.lib(li);
        state.indent(1);
        state.put(in "effect_decl \"Ffi$");
        // The library name is an identifier: no byte needs quoting.
        state.put_name(lib_row.name);
        state.put(in "\" linear=1 @0..0");
        state.nl();
        let mut syms = ChunkSeq::new[u32]();
        for i in 0..lib_row.fun_count {
            syms.push(n32(add(lib_row.fun_start, i)));
        }
        sort_funs(in state, inout syms);
        for i in 0..syms.len() {
            let fi = w(u32_at(in syms, i));
            let func = state.fun(fi);
            let sh = state.sh(fi);
            if !sh.ok {
                continue;
            }
            if !pass2 {
                op_decl(inout state, func.sym, sh, false, in lens, 0, 0);
                continue;
            }
            for k in 0..insts.len() {
                match insts.try_get(k) {
                    Option::Some(inst) => {
                        if inst.lib == lib_row.name && inst.sym == func.sym {
                            let open = inst.n != slice_count(in state, sh);
                            op_decl(inout state, func.sym, sh, !open, in lens, inst.a, inst.n);
                        }
                    },
                    Option::None => {},
                }
            }
        }
    }
    let mut next_span: u64 = 1;
    for li in 0.. state.libs.len() {
        let lib_row = state.lib(li);
        for ci in 0..lib_row.const_count {
            let const_def = state.const_row(add(lib_row.const_start, ci));
            state.indent(1);
            state.put(in "fn \"const$FfiConst$");
            state.put_name(lib_row.name);
            state.put(in "$");
            state.put_name(const_def.name);
            state.put(in "\" fip=0 @0..0");
            state.nl();
            state.indent(2);
            state.put(in "result");
            state.nl();
            let const_ty = state.ty_name(sym8(const_def.scalar));
            state.dump_ty(const_ty, 3);
            state.indent(2);
            state.put(in "effects tail=-");
            state.nl();
            state.indent(2);
            state.put(in "body");
            state.nl();
            state.indent(3);
            state.put(in "E lit int ");
            if const_def.neg && const_def.value != 0 {
                state.put(in "-");
            }
            state.put_u64(const_def.value);
            state.put(in " @");
            state.put_u64(next_span);
            state.put(in "..");
            state.put_u64(next_span);
            state.nl();
            next_span = add(next_span, 1);
        }
    }
}

// Function rows sorted by symbol.
pub fn sort_funs(in state: S, inout xs: ChunkSeq[u32]) {
    let n = xs.len();
    for i in 1..n {
        let key = u32_at(in xs, i);
        let mut j = i;
        loop {
            if j == 0 {
                break;
            }
            let prev = u32_at(in xs, wrapping_sub(j, 1));
            if state.name_cmp(state.fun(w(prev)).sym, state.fun(w(key)).sym) <= 0 {
                break;
            }
            xs.try_set(j, prev);
            j = wrapping_sub(j, 1);
        }
        xs.try_set(j, key);
    }
}

// `types::op_name` of `sym` and `lens[len_start..][..len_count]`, written to `out`.
pub fn put_op_name(
    inout state: S,
    sym: u32,
    in lens: ChunkSeq[u64],
    len_start: u64,
    len_count: u64
) {
    state.put_name(sym);
    if len_count == 0 {
        return;
    }
    state.put(in "$");
    for i in 0..len_count {
        if i > 0 {
            state.put(in "_");
        }
        let len = u64_at(in lens, add(len_start, i));
        if len == NONE64 {
            state.put(in "s");
        } else {
            state.put_u64(len);
        }
    }
}

// One operation: closed (`fixed`) with `lens[len_start..][..len_count]`, or open.
fn op_decl(
    inout state: S,
    sym: u32,
    shape: Sh,
    fixed: bool,
    in lens: ChunkSeq[u64],
    len_start: u64,
    len_count: u64
) {
    state.indent(2);
    state.put(in "fn ");
    let mark = state.out.len();
    if fixed {
        put_op_name(inout state, sym, in lens, len_start, len_count);
    } else {
        state.put_name(sym);
    }
    let name = state.intern_tail(mark);
    state.put_q(name);
    state.put(in " fip=0 @0..0");
    state.nl();
    let mut slice_index: u64 = 0;
    for j in 0..shape.param_count {
        let shape_param = state.sp(add(shape.param_start, j));
        state.indent(3);
        state.put(in "param ");
        state.put_q(shape_param.name);
        state.put(in " pass=");
        put_pass(inout state, shape_param.pass);
        state.put(in " @0..0");
        state.nl();
        if !shape_param.slice {
            state.dump_ty(shape_param.ty, 4);
        } else if !fixed {
            let param_ty = state.ty_name(S_OPEN);
            state.dump_ty(param_ty, 4);
        } else {
            let len = u64_at(in lens, add(len_start, slice_index));
            slice_index = inc(slice_index);
            let mut param_ty = if len == NONE64 {
                state.ty_app1(S_SLICE, shape_param.ty)
            } else {
                state.ty_repeat(shape_param.ty, len)
            };
            if shape_param.nullable {
                param_ty = state.ty_app1(S_OPTION, param_ty);
            }
            state.dump_ty(param_ty, 4);
        }
    }
    state.indent(3);
    state.put(in "result");
    state.nl();
    state.dump_ty(shape.result, 4);
    state.indent(3);
    state.put(in "effects tail=-");
    state.nl();
}

// ----- shapes -----------------------------------------------------------------

fn put_bit(inout state: S, bit: bool) {
    if bit {
        state.out.push(Ascii::Digit1);
    } else {
        state.out.push(Ascii::Digit0);
    }
}

// `shape LIB SYM ok|err ..`, every library's functions in descriptor order.
pub fn dump_shapes(inout state: S) {
    for fi in 0.. state.funs.len() {
        let func = state.fun(fi);
        let sh = state.sh(fi);
        state.put(in "shape ");
        state.put_q(state.lib(func.lib).name);
        state.put(in " ");
        state.put_q(func.sym);
        if !sh.ok {
            state.put(in " err ");
            state.put_q(sh.err);
            state.nl();
            continue;
        }
        state.put(in " ok slices=");
        state.put_u64(slice_count(in state, sh));
        state.nl();
        for j in 0..sh.param_count {
            let shape_param = state.sp(add(sh.param_start, j));
            state.indent(1);
            state.put(in "param ");
            state.put_q(shape_param.name);
            state.put(in " pass=");
            put_pass(inout state, shape_param.pass);
            if shape_param.slice {
                state.put(in " slice nullable=");
                put_bit(inout state, shape_param.nullable);
                state.put(in " in_place=");
                put_bit(inout state, shape_param.in_place);
            } else {
                state.put(in " value");
            }
            state.nl();
            state.dump_ty(shape_param.ty, 2);
        }
        state.indent(1);
        state.put(in "result");
        state.nl();
        state.dump_ty(sh.result, 2);
    }
}

// ----- errors -----------------------------------------------------------------

fn put_err(inout state: S, err: Err) {
    if err.kind == K_DUPLICATE {
        state.put(in "DuplicateLibrary");
    } else if err.kind == K_COLLISION {
        state.put(in "NameCollision");
    } else if err.kind == K_SLICE {
        state.put(in "SliceArgument");
    } else if err.kind == K_TARGET {
        state.put(in "TargetMismatch");
    } else {
        state.put(in "IsolationUnavailable");
    }
    if err.has_span {
        state.put(in " @");
        state.put_u64(err.start);
        state.put(in "..");
        state.put_u64(err.end);
    } else {
        state.put(in " -");
    }
    state.put(in " ");
    state.put_q(err.msg);
}

fn err_at(kind: u8, msg: u32, has_span: bool, start: u64, end: u64) -> Err {
    Err { kind: kind, msg: msg, has_span: has_span, start: start, end: end }
}

// ----- `check_collisions` -----------------------------------------------------

pub copy struct Item {
    name: u32,
    start: u64,
    end: u64,
}

fn is_reserved(in state: S, name: u32) -> bool {
    state.spells(name, in "Option".as_bytes())
        || state.spells(name, in "Result".as_bytes())
        || state.spells(name, in "RuntimeError".as_bytes())
        || state.spells(name, in "Unit".as_bytes())
        || state.spells(name, in "Never".as_bytes())
        || state.spells(name, in "String".as_bytes())
        || state.spells(name, in "ArithOverflow".as_bytes())
        || state.spells(name, in "Fail".as_bytes())
}

fn is_library(in state: S, name: u32) -> bool {
    for i in 0.. state.libs.len() {
        if state.lib(i).name == name {
            return true;
        }
    }
    false
}

// `Generated::names`, sorted.
fn generated_names(in state: S) -> ChunkSeq[u32] {
    let mut names = ChunkSeq::new[u32]();
    for i in 0.. state.gen_structs.len() {
        let adt = state.gs(i);
        if adt.ok {
            names.push(adt.name);
        }
    }
    for i in 0.. state.gen_enums.len() {
        let name = state.ge(i).name;
        let mut seen = false;
        for j in 0..names.len() {
            if u32_at(in names, j) == name {
                seen = true;
            }
        }
        if !seen {
            names.push(name);
        }
    }
    for i in 0.. state.gen_handles.len() {
        names.push(state.gh(i).name);
    }
    if state.pinned {
        names.push(S_PINNED);
    }
    if state.invalid {
        let mut seen = false;
        for j in 0..names.len() {
            if u32_at(in names, j) == S_INVALID {
                seen = true;
            }
        }
        if !seen {
            names.push(S_INVALID);
        }
    }
    sort_by_name(in state, inout names);
    names
}

// `Generated::check_collisions` against a module's ADT and eff_name items.
pub fn check_collisions(inout state: S, in items: ChunkSeq[Item]) -> Err {
    let generated = generated_names(in state);
    for i in 0..generated.len() {
        let name = u32_at(in generated, i);
        if is_reserved(in state, name) {
            let mark = state.out.len();
            state.put(in "'");
            state.put_name(name);
            state.put(in "' is a builtin and cannot be generated from a .vsys");
            return err_at(K_COLLISION, state.intern_tail(mark), false, 0, 0);
        }
        if is_library(in state, name) {
            let mark = state.out.len();
            state.put(in "'");
            state.put_name(name);
            state.put(in "' names both a library and one of its types");
            return err_at(K_COLLISION, state.intern_tail(mark), false, 0, 0);
        }
    }
    for i in 0..items.len() {
        let item = match items.try_get(i) {
            Option::Some(name) => name,
            Option::None => Item { name: NONE, start: 0, end: 0 },
        };
        let mut hit = is_library(in state, item.name);
        for j in 0..generated.len() {
            if u32_at(in generated, j) == item.name {
                hit = true;
            }
        }
        if hit {
            let mark = state.out.len();
            state.put(in "source declaration '");
            state.put_name(item.name);
            state.put(in "' collides with an imported .vsys name");
            return err_at(K_COLLISION, state.intern_tail(mark), true, item.start, item.end);
        }
        if item.name == S_FFI {
            let mark = state.out.len();
            state.put(in "'Ffi' is the foreign capability and cannot be declared in source");
            return err_at(K_COLLISION, state.intern_tail(mark), true, item.start, item.end);
        }
    }
    no_err()
}

// ----- `demangle` -------------------------------------------------------------

fn find_at(in hay: ChunkSeq[u8], in needle: ChunkSeq[u8], from: u64) -> u64 {
    let needle_len = needle.len();
    let hay_len = hay.len();
    if needle_len > hay_len {
        return NONE64;
    }
    let last = wrapping_sub(hay_len, needle_len);
    let mut i = from;
    loop {
        if i > last {
            return NONE64;
        }
        if hay[i..add(i, needle_len)].eq(in needle[0..needle_len]) {
            return i;
        }
        i = inc(i);
    }
}

fn is_word_byte(byte: u8) -> bool {
    (byte >= Ascii::Digit0 && byte <= Ascii::Digit9)
        || (byte >= Ascii::UpperA && byte <= Ascii::UpperZ)
        || (byte >= Ascii::LowerA && byte <= Ascii::LowerZ)
        || byte == Ascii::Underscore
}

fn is_digit_byte(byte: u8) -> bool {
    (byte >= Ascii::Digit0 && byte <= Ascii::Digit9) || byte == Ascii::Underscore
}

// `Generated::demangle`: `Ffi$Lib::f$3` as `Lib::f`, `Ffi$Lib` as
// `Ffi[Lib]`.
pub fn demangle(inout state: S, msg: u32) -> u32 {
    let mut out = ChunkSeq::new[u8]();
    for i in state.start(msg).. state.end(msg) {
        out.push(u8_at(in state.text, i));
    }
    for li in 0.. state.libs.len() {
        let lib_name = state.lib(li).name;
        let mut eff_name = ChunkSeq::new[u8]();
        eff_name.extend(in "Ffi$".as_bytes());
        for i in state.start(lib_name).. state.end(lib_name) {
            eff_name.push(u8_at(in state.text, i));
        }
        let mut path = ChunkSeq::new[u8]();
        path.extend(in eff_name[0..eff_name.len()]);
        path.extend(in "::".as_bytes());
        loop {
            let at = find_at(in out, in path, 0);
            if at == NONE64 {
                break;
            }
            let sym_start = add(at, path.len());
            let len = out.len();
            let mut symbol_end = sym_start;
            loop {
                if symbol_end >= len || !is_word_byte(u8_at(in out, symbol_end)) {
                    break;
                }
                symbol_end = inc(symbol_end);
            }
            let mut end = symbol_end;
            if symbol_end < len && u8_at(in out, symbol_end) == Ascii::Dollar {
                end = inc(symbol_end);
                loop {
                    if end >= len || !is_digit_byte(u8_at(in out, end)) {
                        break;
                    }
                    end = inc(end);
                }
            }
            let mut next = ChunkSeq::with_capacity[u8](len);
            for i in 0..at {
                next.push(u8_at(in out, i));
            }
            for i in state.start(lib_name).. state.end(lib_name) {
                next.push(u8_at(in state.text, i));
            }
            next.extend(in "::".as_bytes());
            for i in sym_start..symbol_end {
                next.push(u8_at(in out, i));
            }
            for i in end..len {
                next.push(u8_at(in out, i));
            }
            out = next;
        }
        // `str::replace` of every `Ffi$Lib` with `Ffi[Lib]`.
        let mut next = ChunkSeq::with_capacity[u8](out.len());
        let mut i: u64 = 0;
        loop {
            let at = find_at(in out, in eff_name, i);
            if at == NONE64 {
                break;
            }
            for k in i..at {
                next.push(u8_at(in out, k));
            }
            next.extend(in "Ffi[".as_bytes());
            for k in state.start(lib_name).. state.end(lib_name) {
                next.push(u8_at(in state.text, k));
            }
            next.push(Ascii::CloseBracket);
            i = add(at, eff_name.len());
        }
        for k in i..out.len() {
            next.push(u8_at(in out, k));
        }
        out = next;
    }
    state.intern(in out[0..out.len()])
}

// ----- `slice_length` ---------------------------------------------------------

// `slice_length` of an argument type `ty` (NONE: unknown) for a slice of
// `element`; returns the length (NONE64 for an in-place `Slice`) or writes
// the error into `err`.
pub fn slice_length(
    inout state: S,
    ty: u32,
    element: u32,
    nullable: bool,
    in_place: bool,
    start: u64,
    end: u64,
    inout err: Err
) -> u64 {
    if ty != NONE {
        let node = state.tn(ty);
        if node.kind == TK_NAMED && node.name == S_SLICE {
            if in_place && !nullable && node.n == 1 && state.ty_eq(state.targ(node.a), element) {
                return NONE64;
            }
            let mark = state.out.len();
            state.put(in "a CSlice[");
            state.put_display(element);
            state.put(in "] argument may be a Slice[");
            state.put_display(element);
            state.put(in "] only when it is not nullable and ");
            state.put_display(element);
            state.put(in " is u8, u32, u64, i64 or usize; found ");
            state.put_display(ty);
            err = err_at(K_SLICE, state.intern_tail(mark), true, start, end);
            return 0;
        }
    }
    let mut cur = ty;
    if ty != NONE && nullable {
        let node = state.tn(ty);
        if node.kind == TK_NAMED && node.name == S_OPTION && node.n == 1 {
            cur = state.targ(node.a);
        } else {
            slice_error(inout state, element, nullable, ty, start, end, inout err);
            return 0;
        }
    }
    if cur == NONE {
        slice_error(inout state, element, nullable, NONE, start, end, inout err);
        return 0;
    }
    let node = state.tn(cur);
    let n = if node.kind == TK_TUPLE {
        node.n
    } else if node.kind == TK_NAMED && node.name == unit_sym(inout state) {
        0
    } else {
        slice_error(inout state, element, nullable, cur, start, end, inout err);
        return 0;
    };
    if n > MAX_SLICE {
        let mark = state.out.len();
        state.put(in "slice of ");
        state.put_u64(n);
        state.put(in " elements exceeds the 4096-element bound");
        err = err_at(K_SLICE, state.intern_tail(mark), true, start, end);
        return 0;
    }
    n
}

fn unit_sym(inout state: S) -> u32 {
    state.intern(in "Unit".as_bytes())
}

fn slice_error(
    inout state: S,
    element: u32,
    nullable: bool,
    found: u32,
    start: u64,
    end: u64,
    inout err: Err
) {
    let mark = state.out.len();
    state.put(in "a CSlice[");
    state.put_display(element);
    state.put(in "] argument must be a tuple ");
    if nullable {
        state.put(in "Option[(");
        state.put_display(element);
        state.put(in ", ...)]");
    } else {
        state.put(in "(");
        state.put_display(element);
        state.put(in ", ...)");
    }
    state.put(in "; found ");
    if found == NONE {
        state.put(in "an expression of unknown type");
    } else {
        state.put_display(found);
    }
    err = err_at(K_SLICE, state.intern_tail(mark), true, start, end);
}

// ----- targets, plans and ABI signatures --------------------------------------

// A target triple's architecture is its first component.
fn triple_arch(in state: S, triple: u32) -> u64 {
    let lo = state.start(triple);
    let hi = state.end(triple);
    for i in lo..hi {
        if u8_at(in state.text, i) == Ascii::Hyphen {
            return wrapping_sub(i, lo);
        }
    }
    wrapping_sub(hi, lo)
}

fn sym_contains(in state: S, sym: u32, in text: Str) -> bool {
    let want = text.as_bytes();
    let n = want.len();
    let lo = state.start(sym);
    let hi = state.end(sym);
    if n > wrapping_sub(hi, lo) {
        return false;
    }
    for i in lo..inc(wrapping_sub(hi, n)) {
        if state.text[i..add(i, n)].eq(in want) {
            return true;
        }
    }
    false
}

fn triple_os(in state: S, triple: u32) -> u64 {
    if sym_contains(in state, triple, in "-linux") {
        TargetOs::Linux
    } else if sym_contains(in state, triple, in "-darwin") {
        TargetOs::Darwin
    } else if sym_contains(in state, triple, in "-windows") {
        TargetOs::Windows
    } else {
        TargetOs::Other
    }
}

fn same_arch(in state: S, left: u32, right: u32) -> bool {
    let left_len = triple_arch(in state, left);
    let right_len = triple_arch(in state, right);
    left_len == right_len
        && state
            .text[state.start(left)..add(state.start(left), left_len)]
            .eq(in state.text[state.start(right)..add(state.start(right), right_len)])
}

fn is_x86(in state: S, triple: u32) -> bool {
    triple_arch(in state, triple) == 6
        && state.text[state.start(triple)..add(state.start(triple), 6)].eq(in "x86_64".as_bytes())
}

// `target_support` of library row `li` for the object triple `target`.
pub fn target_support(inout state: S, li: u64, target: u32) -> Err {
    let lib_row = state.lib(li);
    if !same_arch(in state, lib_row.triple, target)
        || triple_os(in state, lib_row.triple) != triple_os(in state, target)
    {
        let mark = state.out.len();
        state.put(in "library '");
        state.put_name(lib_row.name);
        state.put(in "' targets ");
        state.put_name(lib_row.triple);
        state.put(in " but the object targets ");
        state.put_name(target);
        return err_at(K_TARGET, state.intern_tail(mark), false, 0, 0);
    }
    if lib_row.handler == H_MPK
        && !(is_x86(in state, target) && triple_os(in state, target) == TargetOs::Linux)
    {
        let mark = state.out.len();
        state.put(in "isolated(mpk) trampolines are generated for Linux x86-64 (WRPKRU) only; ");
        state.put_name(target);
        state.put(in " is not supported (AArch64 POE is not implemented)");
        return err_at(K_ISOLATION, state.intern_tail(mark), false, 0, 0);
    }
    no_err()
}

fn put_handler(inout state: S, handler: u64) {
    if handler == H_DIRECT {
        state.put(in "direct");
    } else {
        state.put(in "isolated(mpk)");
    }
}

// `op_plan` of operation `op` of `eff_name`, with the libraries the target
// `target` (NONE: no target) cannot call blocked.
pub fn op_plan(inout state: S, target: u32, eff_name: u32, op: u32) {
    let mut lib = NONE64;
    for li in 0.. state.libs.len() {
        let name = state.lib(li).name;
        let name_len = state.size(name);
        let eff_start = state.start(eff_name);
        if state.size(eff_name) == add(name_len, 4)
            && state.text[eff_start..add(eff_start, 4)].eq(in "Ffi$".as_bytes())
            && state.spells(name, in state.text[add(eff_start, 4).. state.end(eff_name)])
        {
            lib = li;
        }
    }
    if lib == NONE64 {
        state.put(in "err ");
        let mark = state.out.len();
        state.put(in "no imported library for effect '");
        state.put_name(eff_name);
        state.put(in "'");
        let message = state.intern_tail(mark);
        state.put_q(message);
        return;
    }
    if target != NONE {
        let e = target_support(inout state, lib, target);
        if e.msg != NONE {
            state.put(in "err ");
            state.put_q(e.msg);
            return;
        }
    }
    let op_start = state.start(op);
    let mut cut = state.end(op);
    for i in op_start.. state.end(op) {
        if u8_at(in state.text, i) == Ascii::Dollar && cut == state.end(op) {
            cut = i;
        }
    }
    let mut sym_bytes = ChunkSeq::new[u8]();
    for i in op_start..cut {
        sym_bytes.push(u8_at(in state.text, i));
    }
    let symbol = state.intern(in sym_bytes[0..sym_bytes.len()]);
    let lib_row = state.lib(lib);
    for i in 0..lib_row.fun_count {
        let func = state.fun(add(lib_row.fun_start, i));
        if func.sym == symbol {
            state.put(in "ok ");
            state.put_q(lib_row.name);
            state.put(in " ");
            put_handler(inout state, lib_row.handler);
            state.put(in " ");
            state.put_q(symbol);
            return;
        }
    }
    state.put(in "err ");
    let mark = state.out.len();
    state.put(in "library '");
    state.put_name(lib_row.name);
    state.put(in "' has no function '");
    state.put_name(symbol);
    state.put(in "'");
    let message = state.intern_tail(mark);
    state.put_q(message);
}

// `plan_probe::body_call`'s forms: what the native walk's body plans read
// of a foreign call (@vesper/codegen-scalar foreign.ves).
pub const BODY_CALL_OTHER: u64 = 0;
pub const BODY_CALL_DIRECT: u64 = 1;
pub const BODY_PARAM_SCALAR: u64 = 0;
pub const BODY_PARAM_BOOL: u64 = 1;
pub const BODY_PARAM_HANDLE: u64 = 2;
pub const BODY_PARAM_SLICE: u64 = 3;
pub const BODY_RESULT_UNIT: u64 = 0;
pub const BODY_RESULT_SCALAR: u64 = 1;
// A nullable handle: an `Option` of its struct.
pub const BODY_RESULT_OPTION_HANDLE: u64 = 2;
// The bit of a scalar word above its width: whether it is signed.
const BODY_SIGNED: u64 = 256;
// A scalar word's bits.
const BODY_BITS_MASK: u64 = 255;
const BITS_8: u64 = 8;
const BITS_16: u64 = 16;
const BITS_32: u64 = 32;
const BITS_64: u64 = 64;

// Whether a direct call of C symbol `symbol` is one the body plans make:
// not a `@vesper-std/cpu` function (`cpu::code_for`), nor one the native
// runtime shares with foreign imports (src/ffi_lowering/native.rs
// `runtime_import`), which the walk calls through its shared declaration.
fn body_symbol_plain(in symbol: Slice[u8]) -> bool {
    !has_prefix(in symbol)
        && !symbol.eq(in "write".as_bytes())
        && !symbol.eq(in "memcpy".as_bytes())
        && !symbol.eq(in "memmove".as_bytes())
        && !symbol.eq(in "memset".as_bytes())
        && !symbol.eq(in "malloc".as_bytes())
        && !symbol.eq(in "calloc".as_bytes())
        && !symbol.eq(in "realloc".as_bytes())
        && !symbol.eq(in "free".as_bytes())
        && !symbol.eq(in "exit".as_bytes())
}

// A scalar code's body word: its bits, and BODY_SIGNED when signed.
fn body_scalar(code: u8) -> u64 {
    let bits = if code == SC_U8 || code == SC_I8 {
        BITS_8
    } else if code == SC_U16 || code == SC_I16 {
        BITS_16
    } else if code == SC_U32 || code == SC_I32 {
        BITS_32
    } else {
        BITS_64
    };
    let signed = code == SC_I8 || code == SC_I16 || code == SC_I32 || code == SC_I64;
    if signed { bits | BODY_SIGNED } else { bits }
}

// The bytes of one element of slice parameter `p` of library row `lib`
// (`Pointee::size`): its scalar's, or its wire struct's size.
fn element_bytes(in state: S, lib: u64, p: Par) -> u64 {
    if !p.elem_is_struct {
        return (body_scalar(p.elem_scalar) & BODY_BITS_MASK) / BITS_8;
    }
    let lib_row = state.lib(lib);
    for i in 0..lib_row.wire_count {
        let ws = state.ws(add(lib_row.wire_start, i));
        if ws.name == p.type_name {
            return ws.size;
        }
    }
    0
}

// The library row of effect `eff_name` (`Ffi$Lib`), or NONE64.
fn effect_lib(in state: S, eff_name: u32) -> u64 {
    let mut lib = NONE64;
    for li in 0.. state.libs.len() {
        let name = state.lib(li).name;
        let eff_start = state.start(eff_name);
        if state.size(eff_name) == add(state.size(name), 4)
            && state.text[eff_start..add(eff_start, 4)].eq(in "Ffi$".as_bytes())
            && state.spells(name, in state.text[add(eff_start, 4).. state.end(eff_name)])
        {
            lib = li;
        }
    }
    lib
}

// `plan_probe::body_call` of operation `op` of `eff_name`: the C symbol a
// direct call imports (NONE when the plan has no such operation), with
// its words in `words`: BODY_CALL_DIRECT, the parameter count, a form and
// a scalar word per parameter and for the result; or BODY_CALL_OTHER for
// a call the body plans leave to the walk.
pub fn body_call(inout state: S, eff_name: u32, op: u32, inout words: ChunkSeq[u64]) -> u32 {
    let lib = effect_lib(in state, eff_name);
    if lib == NONE64 {
        return NONE;
    }
    let op_start = state.start(op);
    let mut cut = state.end(op);
    for i in op_start.. state.end(op) {
        if u8_at(in state.text, i) == Ascii::Dollar && cut == state.end(op) {
            cut = i;
        }
    }
    let mut sym_bytes = ChunkSeq::new[u8]();
    for i in op_start..cut {
        sym_bytes.push(u8_at(in state.text, i));
    }
    let symbol = state.intern(in sym_bytes[0..sym_bytes.len()]);
    let lib_row = state.lib(lib);
    let mut fi = NONE64;
    for i in 0..lib_row.fun_count {
        if state.fun(add(lib_row.fun_start, i)).sym == symbol {
            fi = add(lib_row.fun_start, i);
        }
    }
    if fi == NONE64 {
        return NONE;
    }
    let func = state.fun(fi);
    let link = if func.link == NONE {
        func.sym
    } else {
        func.link
    };
    words.push(BODY_CALL_DIRECT);
    words.push(func.param_count);
    let mut plain = lib_row.handler == H_DIRECT
        && !func.indirect
        && !func.errno
        && !func.has_variadic
        && !func.mapped;
    for k in 0..func.param_count {
        let p = state.par(add(func.param_start, k));
        if p.tag == P_VALUE && p.value_ty.tag == VT_SCALAR {
            words.push(BODY_PARAM_SCALAR);
            words.push(body_scalar(p.value_ty.scalar));
        } else if p.tag == P_VALUE && p.value_ty.tag == VT_BOOL {
            words.push(BODY_PARAM_BOOL);
            words.push(0);
        } else if p.tag == P_HANDLE && !is_mapping(in state, lib, p.type_name) {
            words.push(BODY_PARAM_HANDLE);
            words.push(0);
        } else if p.tag == P_SLICE {
            words.push(BODY_PARAM_SLICE);
            words.push(element_bytes(in state, lib, p));
        } else {
            plain = false;
        }
    }
    if func.result.tag == VT_UNIT {
        words.push(BODY_RESULT_UNIT);
        words.push(0);
    } else if func.result.tag == VT_SCALAR {
        words.push(BODY_RESULT_SCALAR);
        words.push(body_scalar(func.result.scalar));
    } else if func.result.tag == VT_HANDLE && func.result.nullable {
        words.push(BODY_RESULT_OPTION_HANDLE);
        words.push(0);
    } else {
        plain = false;
    }
    if !body_symbol_plain(in state.text[state.start(link).. state.end(link)]) {
        plain = false;
    }
    if !plain {
        words.clear();
        words.push(BODY_CALL_OTHER);
    }
    link
}

// The scalar carrier of an enum of library `lib`.
fn enum_scalar(in state: S, lib: u64, name: u32) -> u8 {
    let lib_row = state.lib(lib);
    for i in 0..lib_row.enum_count {
        let row = state.enum_row(add(lib_row.enum_start, i));
        if row.name == name {
            return row.scalar;
        }
    }
    SC_U32
}

// `carrier`: an ABI type, written; false for `Unit`.
fn put_carrier(inout state: S, lib: u64, value_ty: Vt) -> bool {
    if value_ty.tag == VT_UNIT {
        return false;
    }
    if value_ty.tag == VT_SCALAR {
        state.put_name(sym8(value_ty.scalar));
    } else if value_ty.tag == VT_FLOAT {
        state.put_name(value_ty.name);
    } else if value_ty.tag == VT_BOOL {
        state.put_name(sym8(SC_U8));
    } else if value_ty.tag == VT_ENUM {
        state.put_name(sym8(enum_scalar(in state, lib, value_ty.name)));
    } else {
        state.put(in "ptr");
    }
    true
}

// Whether extern type `name` of library row `lib` is a mapping.
fn is_mapping(in state: S, lib: u64, name: u32) -> bool {
    let lib_row = state.lib(lib);
    for i in 0..lib_row.extern_count {
        let ext_type = state.xt(add(lib_row.extern_start, i));
        if ext_type.name == name && ext_type.mapping != NONE {
            return true;
        }
    }
    false
}

// `FunctionDescriptor::abi` of every function: `abi LIB SYM conv=..
// params=.. result=..`; `none` when a parameter is `Unit` (which no
// validated descriptor has).
pub fn dump_abi(inout state: S) {
    for fi in 0.. state.funs.len() {
        let func = state.fun(fi);
        let lib_row = state.lib(func.lib);
        state.put(in "abi ");
        state.put_q(lib_row.name);
        state.put(in " ");
        state.put_q(func.sym);
        let mut unit = false;
        for j in 0..func.param_count {
            let param = state.par(add(func.param_start, j));
            if param.tag == P_VALUE && param.value_ty.tag == VT_UNIT {
                unit = true;
            }
        }
        if unit {
            state.put(in " none");
            state.nl();
            continue;
        }
        state.put(in " conv=");
        put_convention(inout state, lib_row.triple);
        state.put(in " params=");
        // A callback's call leaves the pointer out of its C signature.
        let first: u64 = if func.indirect { 1 } else { 0 };
        let darwin = triple_os(in state, lib_row.triple) == TargetOs::Darwin;
        let mut integers: u64 = 0;
        let mut emitted = false;
        for j in first..func.param_count {
            if darwin && func.has_variadic && j == func.variadic_first && integers < 8 {
                let pad = wrapping_sub(8, integers);
                for k in 0..pad {
                    if emitted {
                        state.put(in ",");
                    }
                    state.put(in "u64");
                    emitted = true;
                }
            }
            let param = state.par(add(func.param_start, j));
            if emitted {
                state.put(in ",");
            }
            emitted = true;
            if param.tag == P_VALUE {
                let any = put_carrier(inout state, func.lib, param.value_ty);
                if param.value_ty.tag != VT_FLOAT {
                    integers = add(integers, 1);
                }
            } else if param.tag == P_SLICE || param.tag == P_PINNED {
                state.put(in "ptr,usize");
                integers = add(integers, 2);
            } else if param.tag == P_HANDLE && is_mapping(in state, func.lib, param.type_name) {
                state.put(in "ptr,usize");
                integers = add(integers, 2);
            } else {
                state.put(in "ptr");
                integers = add(integers, 1);
            }
        }
        state.put(in " result=");
        if !put_carrier(inout state, func.lib, func.result) {
            state.put(in "-");
        }
        state.nl();
    }
}

// `Target::convention` of a library's triple.
fn put_convention(inout state: S, triple: u32) {
    let os = triple_os(in state, triple);
    if os == TargetOs::Windows {
        state.put(in "win64");
    } else if os == TargetOs::Darwin {
        state.put(in "darwin64");
    } else if is_x86(in state, triple) {
        state.put(in "sysv64");
    } else {
        state.put(in "aapcs64");
    }
}

// ----- the harness entry ------------------------------------------------------

fn read_type(inout reader: Reader, in bytes: Slice[u8], inout state: S, depth: u64) -> u32 {
    let kind = reader.word(in bytes);
    let mut name = NONE;
    if kind == 0 {
        name = text_sym(inout reader, in bytes, inout state);
    }
    let arg_count = reader.word(in bytes);
    let mut args = ChunkSeq::new[u32]();
    if depth < MAX_DESCRIPTOR_TYPE_DEPTH {
        for i in 0..arg_count {
            args.push(read_type(inout reader, in bytes, inout state, inc(depth)));
        }
    }
    if kind == 0 {
        state.ty_named(name, in args)
    } else {
        state.ty_tuple(in args)
    }
}

fn opt_sym(inout reader: Reader, in bytes: Slice[u8], inout state: S) -> u32 {
    let (start, end) = reader.text(in bytes);
    if start == end {
        NONE
    } else {
        state.intern(in bytes[start..end])
    }
}

fn run(in bytes: Slice[u8], inout state: S) {
    let mut reader = Reader { pos: 0, stop: bytes.len() };
    let lib_count = reader.word(in bytes);
    for i in 0..lib_count {
        let handler = reader.word(in bytes);
        let (desc_start, desc_end) = reader.text(in bytes);
        read_library(in bytes, desc_start, desc_end, handler, inout state);
    }
    // instances
    let mut insts = ChunkSeq::new[Inst]();
    let mut lens = ChunkSeq::new[u64]();
    let inst_count = reader.word(in bytes);
    for i in 0..inst_count {
        let lib = text_sym(inout reader, in bytes, inout state);
        let sym = text_sym(inout reader, in bytes, inout state);
        let vector_count = reader.word(in bytes);
        for j in 0..vector_count {
            let n = reader.word(in bytes);
            let len_start = lens.len();
            for k in 0..n {
                lens.push(reader.word(in bytes));
            }
            insts.push(Inst { lib: lib, sym: sym, a: len_start, n: n });
        }
    }
    let gen_error = generate(inout state);
    if gen_error.msg != NONE {
        state.put(in "G err ");
        put_err(inout state, gen_error);
        state.nl();
    } else {
        state.put(in "G ok");
        state.nl();
        dump_shapes(inout state);
        state.put(in "pass1");
        state.nl();
        append(inout state, false, in insts, in lens);
        state.put(in "pass2");
        state.nl();
        append(inout state, true, in insts, in lens);
    }
    // collision probes
    let collide_count = reader.word(in bytes);
    for i in 0..collide_count {
        let mut items = ChunkSeq::new[Item]();
        let item_count = reader.word(in bytes);
        for j in 0..item_count {
            let name = text_sym(inout reader, in bytes, inout state);
            let start = reader.word(in bytes);
            let end = reader.word(in bytes);
            items.push(Item { name: name, start: start, end: end });
        }
        if gen_error.msg == NONE {
            let e = check_collisions(inout state, in items);
            if e.msg == NONE {
                state.put(in "collide ok");
            } else {
                state.put(in "collide err ");
                put_err(inout state, e);
            }
            state.nl();
        }
    }
    // demangle probes
    let demangle_count = reader.word(in bytes);
    for i in 0..demangle_count {
        let message = text_sym(inout reader, in bytes, inout state);
        if gen_error.msg == NONE {
            let demangled = demangle(inout state, message);
            state.put(in "demangle ");
            state.put_q(message);
            state.put(in " ");
            state.put_q(demangled);
            state.nl();
        }
    }
    // handle probes
    let handle_count = reader.word(in bytes);
    for i in 0..handle_count {
        let handle_name = text_sym(inout reader, in bytes, inout state);
        if gen_error.msg == NONE {
            state.put(in "handle ");
            state.put_q(handle_name);
            state.put(in " ");
            put_bit(inout state, find_gh(in state, handle_name) != NONE64);
            state.nl();
        }
    }
    // op plans
    let plan_count = reader.word(in bytes);
    for i in 0..plan_count {
        let target = opt_sym(inout reader, in bytes, inout state);
        let eff_name = text_sym(inout reader, in bytes, inout state);
        let op = text_sym(inout reader, in bytes, inout state);
        state.put(in "plan ");
        if target == NONE {
            state.put(in "-");
        } else {
            state.put_q(target);
        }
        state.put(in " ");
        state.put_q(eff_name);
        state.put(in " ");
        state.put_q(op);
        state.put(in " ");
        op_plan(inout state, target, eff_name, op);
        state.nl();
        // The form the native walk's body plans read.
        let mut words: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let symbol = body_call(inout state, eff_name, op, inout words);
        state.put(in "body ");
        if symbol == NONE {
            state.put(in "-");
        } else {
            state.put(in "ok ");
            state.put_q(symbol);
            for k in 0..words.len() {
                state.put(in " ");
                state.put_u64(words.try_get(k).unwrap_or(0));
            }
        }
        state.nl();
    }
    // target support
    let target_count = reader.word(in bytes);
    for i in 0..target_count {
        let target = text_sym(inout reader, in bytes, inout state);
        state.put(in "target ");
        state.put_q(target);
        state.nl();
        for li in 0.. state.libs.len() {
            let e = target_support(inout state, li, target);
            state.indent(1);
            state.put_q(state.lib(li).name);
            if e.msg == NONE {
                state.put(in " ok");
            } else {
                state.put(in " err ");
                put_err(inout state, e);
            }
            state.nl();
        }
    }
    // slice lengths
    let slice_probe_count = reader.word(in bytes);
    for i in 0..slice_probe_count {
        let has_ty = reader.word(in bytes);
        let ty = if has_ty == 1 {
            read_type(inout reader, in bytes, inout state, 0)
        } else {
            NONE
        };
        let element = read_type(inout reader, in bytes, inout state, 0);
        let nullable = reader.word(in bytes) == 1;
        let in_place = reader.word(in bytes) == 1;
        let start = reader.word(in bytes);
        let end = reader.word(in bytes);
        let mut e = no_err();
        let n = slice_length(inout state, ty, element, nullable, in_place, start, end, inout e);
        state.put(in "slice ");
        if e.msg != NONE {
            state.put(in "err ");
            put_err(inout state, e);
        } else if n == NONE64 {
            state.put(in "ok s");
        } else {
            state.put(in "ok ");
            state.put_u64(n);
        }
        state.nl();
    }
    // op names
    let opname_count = reader.word(in bytes);
    for i in 0..opname_count {
        let sym = text_sym(inout reader, in bytes, inout state);
        let n = reader.word(in bytes);
        let mut name_lens = ChunkSeq::new[u64]();
        for k in 0..n {
            name_lens.push(reader.word(in bytes));
        }
        state.put(in "opname ");
        state.put_q(sym);
        state.put(in " ");
        let mark = state.out.len();
        put_op_name(inout state, sym, in name_lens, 0, n);
        let op_name = state.intern_tail(mark);
        state.put_q(op_name);
        state.nl();
    }
    dump_abi(inout state);
}

// The harness entry: the case `input` (tests/self_host_ffi_lowering.rs) to
// its text, packed as a byte length and eight bytes per word.
pub fn ffi_plan_text(in input: Str) -> ChunkSeq[u64] {
    let mut state = s_new();
    run(in input.as_bytes(), inout state);
    pack(in state.out)
}

// The same work without the text: its length, for timing.
pub fn ffi_plan_count(in input: Str) -> u64 {
    let mut state = s_new();
    run(in input.as_bytes(), inout state);
    state.out.len()
}

fn pack(in text: ChunkSeq[u8]) -> ChunkSeq[u64] {
    let n = text.len();
    let mut out = ChunkSeq::with_capacity[u64](wrapping_add(n >> 3, 2));
    out.push(n);
    let mut word: u64 = 0;
    let mut filled: u32 = 0;
    for i in 0..n {
        let byte = widen_u64(u8_at(in text, i));
        word = word | wrapping_shl_u64(byte, wrapping_mul(filled, 8));
        filled = wrapping_add(filled, 1);
        if filled == 8 {
            out.push(word);
            word = 0;
            filled = 0;
        }
    }
    if filled != 0 {
        out.push(word);
    }
    out
}

// The harness entry of cpu.ves (tests/self_host_ffi_cpu.rs): the input is
// the target's architecture code, the length of its name, the name and the
// symbol; the result is `code_for`'s architecture, then the code and the
// error message, each a count and a word per byte.
pub fn ffi_cpu_code(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let target = widen_u64(byte(in bytes, 0));
    let name_len = widen_u64(byte(in bytes, 1));
    let name_end = add(2, name_len);
    let mut code: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut error: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let arch = code_for(
        in bytes[name_end..bytes.len()],
        target,
        in bytes[2..name_end],
        inout code,
        inout error
    );
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    out.push(arch);
    out.push(code.len());
    for i in 0..code.len() {
        out.push(widen_u64(u8_at(in code, i)));
    }
    out.push(error.len());
    for i in 0..error.len() {
        out.push(widen_u64(u8_at(in error, i)));
    }
    out
}
