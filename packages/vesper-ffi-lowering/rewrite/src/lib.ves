// @vesper/ffi-rewrite: the source rewrite of src/ffi_lowering.rs's
// `Rewriter` in Vesper (self-hosting SH4 lane 13, #1287, part 2), over the
// @vesper/ast tree. Rust stays the default; nothing here replaces Rust code
// yet.
//
// The rewriter turns `Ffi[Lib]` rows into the library's effect `Ffi$Lib`
// and `Lib::f(..)` calls into its operations, and reports the first typed
// error (by span) of the module. Pass 1 leaves slice parameters open and
// records each call's slice arguments; pass 2 gets each call's slice
// lengths (which the checker computes from pass 1) and names one operation
// per slice-length vector, recording the vectors used and the calls.
//
// The input is each imported library's canonical descriptor bytes (as in
// @vesper/ffi-lowering), then the pass 2 lengths; the source is a second
// argument. The word format is documented in
// tests/self_host_ffi_lowering_rewrite.rs, which writes the same text from
// the Rust code.
//
// The tree is the @vesper/ast index graph. A rewrite overwrites an
// expression row (a call's callee) or an effect row (`Ffi[Lib]`) in place;
// both rewrites depend only on the row and the imports, so a row the
// parser shares between owners gets the rewrite every Rust copy gets.

use self::drops::{append_drops};
use self::buffers::{W, w_new, check_buffers};
use @vesper/ast::{
    Ast, Lit, ExprNode, PatNode, TypeNode, StmtNode, ArgNode, ClauseNode, ParamNode, EffectsNode,
    EffectNode, FieldNode, VariantNode, AdtNode, FnNode, EffectDeclNode, ImplNode, TraitNode,
    ConfNode, ItemNode, list_len, list_at, expr_at, pat_at, type_at
};
use @vesper/ast::lower::{lower_source};
use @vesper/ast::dump::{dump_ast};
use @vesper-std/arena::{idx_from_raw};
use @vesper-std/intern::{symbol_from_id};
use @vesper/ffi-lowering::{
    S, Err, Sh, Sp, ConstRow, Reader, s_new, read_library, generate, slice_count, put_op_name
};

const NONE: u32 = 4294967295;
const NONE64: u64 = 18446744073709551615;

// Handler tiers.
const H_MPK: u64 = 1;

// `FfiErrorKind`s: the five of @vesper/ffi-lowering, then the rewriter's.
const K_DUPLICATE: u8 = 0;
const K_COLLISION: u8 = 1;
const K_SLICE: u8 = 2;
const K_TARGET: u8 = 3;
const K_ISOLATION: u8 = 4;
const K_MALFORMED: u8 = 10;
const K_UNKNOWN_LIBRARY: u8 = 11;
const K_REALTIME: u8 = 12;
const K_FOREIGN_VALUE: u8 = 13;
const K_HANDLE_MISUSE: u8 = 14;
const K_FOREIGN_HANDLER: u8 = 15;
const K_UNKNOWN_FUNCTION: u8 = 16;
const K_UNSUPPORTED: u8 = 17;

// Expression kinds (`@vesper/ast` `ExprNode`).
const E_NAME: u8 = 2;
const E_TUPLE: u8 = 3;
const E_STRUCT: u8 = 4;
const E_BLOCK: u8 = 5;
const E_CALL: u8 = 6;
const E_FIELD: u8 = 7;
const E_INDEX: u8 = 8;
const E_TRY: u8 = 9;
const E_UNARY: u8 = 10;
const E_BINARY: u8 = 11;
const E_ASSIGN: u8 = 12;
const E_IF: u8 = 13;
const E_MATCH: u8 = 14;
const E_CLOSURE: u8 = 15;
const E_HANDLE: u8 = 16;
const E_LOOP: u8 = 17;
const E_FOR: u8 = 18;
const E_RANGE: u8 = 19;
const E_BREAK: u8 = 20;
const E_RETURN: u8 = 21;

// Pattern kinds.
const P_LIT: u8 = 3;
const P_TUPLE: u8 = 4;
const P_CONSTRUCTOR: u8 = 5;

// Type kinds.
const T_NAMED: u8 = 1;
const T_TUPLE: u8 = 2;
const T_FUNCTION: u8 = 3;
const T_ROW: u8 = 4;

// Item kinds.
const I_ADT: u8 = 1;
const I_FN: u8 = 2;
const I_EFFECT: u8 = 3;
const I_IMPL: u8 = 4;
const I_TRAIT: u8 = 5;
const I_CONF: u8 = 6;

// Statement kinds.
const ST_LET: u8 = 1;

// The state of one pass over one module.
pub struct R {
    state: S,
    ast: Ast,
    pass2: bool,
    // Pass 2 slice lengths by call span: rows (start, end, first, count)
    // into `lens`.
    len_rows: ChunkSeq[u64],
    lens: ChunkSeq[u64],
    // The first error by span (`Rewriter::finish`).
    has_err: bool,
    err: Err,
    // Pass 1 slice sites: (call start, end, n), then n x (arg start, end,
    // element type, nullable, in place).
    sites: ChunkSeq[u64],
    // Pass 2: used vectors as (library row, function row, first, count)
    // into `inst_lens`; calls as (start, end, library row, function row,
    // first, count) into `call_lens`.
    insts: ChunkSeq[u64],
    inst_lens: ChunkSeq[u64],
    calls: ChunkSeq[u64],
    call_lens: ChunkSeq[u64],
    // Symbol caches by AST symbol: 0 unknown, 1 no, 2 yes (handles);
    // 0 unknown, 1 not foreign, else library row + 2 and the split at bits
    // 32.. (foreign paths).
    handle_of: ChunkSeq[u8],
    path_of: ChunkSeq[u64],
    bytes: ChunkSeq[u8],
    buf: String
}

fn u64_at(in seq: ChunkSeq[u64], i: u64) -> u64 {
    seq.try_get(i).unwrap_or(0)
}

fn u8_at(in seq: ChunkSeq[u8], i: u64) -> u8 {
    seq.try_get(i).unwrap_or(0)
}

fn w(x: u32) -> u64 {
    widen_u64(x)
}

fn n32(x: u64) -> u32 {
    wrapping_u32(x)
}

fn no_err() -> Err {
    Err { kind: 0, msg: NONE, has_span: false, start: 0, end: 0 }
}

fn r_new(
    sink state: S,
    sink ast: Ast,
    pass2: bool,
    in len_rows: ChunkSeq[u64],
    in lens: ChunkSeq[u64]
) -> R {
    let mut rows_copy = ChunkSeq::with_capacity[u64](len_rows.len());
    for i in 0..len_rows.len() {
        rows_copy.push(u64_at(in len_rows, i));
    }
    let mut lens_copy = ChunkSeq::with_capacity[u64](lens.len());
    for i in 0..lens.len() {
        lens_copy.push(u64_at(in lens, i));
    }
    R {
        state: state,
        ast: ast,
        pass2: pass2,
        len_rows: rows_copy,
        lens: lens_copy,
        has_err: false,
        err: no_err(),
        sites: ChunkSeq::new[u64](),
        insts: ChunkSeq::new[u64](),
        inst_lens: ChunkSeq::new[u64](),
        calls: ChunkSeq::new[u64](),
        call_lens: ChunkSeq::new[u64](),
        handle_of: ChunkSeq::new[u8](),
        path_of: ChunkSeq::new[u64](),
        bytes: ChunkSeq::new[u8](),
        buf: String::new()
    }
}

// ---------------------------------------------------------------- symbols

// The bytes of AST symbol `sym`, into `r.bytes`.
fn load_bytes(inout r: R, sym: u32) {
    r.bytes.truncate(0);
    if sym == NONE {
        return;
    }
    let (lo, hi) = r.ast.names.span(symbol_from_id(sym));
    for i in lo..hi {
        match r.ast.names.text_byte(i) {
            Option::Some(byte) => r.bytes.push(byte),
            Option::None => {}
        }
    }
}

// Whether AST symbol `sym` spells `text`.
fn sym_is(in r: R, sym: u32, in text: Str) -> bool {
    if sym == NONE {
        return false;
    }
    r.ast.names.symbol_eq(symbol_from_id(sym), in text)
}

// Appends AST symbol `sym` to the output text of `r.s`.
fn put_sym(inout r: R, sym: u32) {
    load_bytes(inout r, sym);
    for i in 0..r.bytes.len() {
        r.state.out.push(u8_at(in r.bytes, i));
    }
}

// Appends S symbol `sym` to `r.buf`.
fn buf_name(inout r: R, sym: u32) {
    let lo = r.state.start(sym);
    let hi = r.state.end(sym);
    for i in lo..hi {
        r.buf.push_char(wrapping_u32(widen_u64(u8_at(in r.state.text, i))));
    }
}

// The AST symbol of `r.buf`, which it then clears.
fn intern_buf(inout r: R) -> u32 {
    let sym = r.ast.names.intern(in r.buf).id();
    r.buf = String::new();
    sym
}

// Whether AST symbol `sym` names a generated extern-type handle
// (`Generated::is_handle`).
fn is_handle(inout r: R, sym: u32) -> bool {
    if sym == NONE {
        return false;
    }
    let index = w(sym);
    if index < r.handle_of.len() {
        let cached = u8_at(in r.handle_of, index);
        if cached != 0 {
            return cached == 2;
        }
    } else {
        r.handle_of.resize(wrapping_add(index, 1), 0);
    }
    load_bytes(inout r, sym);
    let mut yes = false;
    for i in 0..r.state.gen_handles.len() {
        if r.state.spells(r.state.gh(i).name, in r.bytes[0..r.bytes.len()]) {
            yes = true;
        }
    }
    let ok = r.handle_of.try_set(index, if yes { 2 } else { 1 });
    yes
}

// `Rewriter::foreign_path`: the library row and the byte offset of the
// symbol after the first `::` of name `name`, or NONE64 when the part before
// it is not an imported library.
fn foreign_path(inout r: R, name: u32) -> (u64, u64) {
    if name == NONE {
        return (NONE64, 0);
    }
    let index = w(name);
    if index < r.path_of.len() {
        let cached = u64_at(in r.path_of, index);
        if cached == 1 {
            return (NONE64, 0);
        }
        if cached != 0 {
            return (wrapping_sub(cached & 4294967295, 2), cached >> 32);
        }
    } else {
        r.path_of.resize(wrapping_add(index, 1), 0);
    }
    load_bytes(inout r, name);
    let n = r.bytes.len();
    let mut at = NONE64;
    for i in 1..n {
        if at == NONE64
            && u8_at(in r.bytes, wrapping_sub(i, 1)) == 58
            && u8_at(in r.bytes, i) == 58 {
            at = wrapping_sub(i, 1);
        }
    }
    let mut lib = NONE64;
    if at != NONE64 {
        for li in 0..r.state.libs.len() {
            if lib == NONE64 && r.state.spells(r.state.lib(li).name, in r.bytes[0..at]) {
                lib = li;
            }
        }
    }
    if lib == NONE64 {
        let ok = r.path_of.try_set(index, 1);
        return (NONE64, 0);
    }
    let sym = wrapping_add(at, 2);
    let ok = r.path_of.try_set(index, wrapping_add(lib, 2) | (sym << 32));
    (lib, sym)
}

// Whether AST symbol `sym` names an imported library.
fn is_library(inout r: R, sym: u32) -> bool {
    load_bytes(inout r, sym);
    for li in 0..r.state.libs.len() {
        if r.state.spells(r.state.lib(li).name, in r.bytes[0..r.bytes.len()]) {
            return true;
        }
    }
    false
}

// ---------------------------------------------------------------- errors

// Records an error at `start..end`. The first error by span wins, and of
// equal spans the first one raised (`finish`'s stable sort).
fn raise(inout r: R, kind: u8, msg: u32, start: u32, end: u32) {
    let span_start = w(start);
    let span_end = w(end);
    if r.has_err
        && (r.err.start < span_start || (r.err.start == span_start && r.err.end <= span_end)) {
        return;
    }
    r.has_err = true;
    r.err = Err { kind: kind, msg: msg, has_span: true, start: span_start, end: span_end };
}

// The S symbol of the output text from `mark`, which it then drops.
fn message(inout r: R, mark: u64) -> u32 {
    r.state.intern_tail(mark)
}

fn handle_misuse(inout r: R, name: u32, in what: Str, start: u32, end: u32) {
    let mark = r.state.out.len();
    r.state.put(in "extern type ");
    put_sym(inout r, name);
    r.state.put(in " is an opaque foreign handle: it cannot be ");
    r.state.put(in what);
    r.state.put(in " in source; only its library's imports create, use and finalize it");
    let msg = message(inout r, mark);
    raise(inout r, K_HANDLE_MISUSE, msg, start, end);
}

// ---------------------------------------------------------------- walk

fn module(inout r: R) {
    for i in 0..r.ast.m_items.len() {
        let item_id = r.ast.m_items.try_get(i).unwrap_or(NONE);
        let item = match r.ast.items.get(idx_from_raw[ItemNode](item_id)) {
            Option::Some(x) => x,
            Option::None => ItemNode { kind: 0, node: NONE },
        };
        if item.kind == I_ADT {
            let adt = match r.ast.adts.get(idx_from_raw[AdtNode](item.node)) {
                Option::Some(x) => x,
                Option::None => continue,
            };
            for variant_index in 0..list_len(in r.ast, adt.variants) {
                let variant = match r.ast
                    .variants
                    .get(
                        idx_from_raw[VariantNode](list_at(in r.ast, adt.variants, variant_index))
                    ) {
                    Option::Some(x) => x,
                    Option::None => continue,
                };
                for field_index in 0..list_len(in r.ast, variant.fields) {
                    match r.ast.fields.get(
                        idx_from_raw[FieldNode](list_at(in r.ast, variant.fields, field_index))
                    ) {
                        Option::Some(field) => ty(inout r, field.ty, adt.start, adt.end),
                        Option::None => {}
                    }
                }
            }
        } else if item.kind == I_FN {
            function(inout r, item.node);
        } else if item.kind == I_EFFECT {
            let decl = match r.ast.effect_decls.get(idx_from_raw[EffectDeclNode](item.node)) {
                Option::Some(x) => x,
                Option::None => continue,
            };
            for j in 0..list_len(in r.ast, decl.ops) {
                function(inout r, list_at(in r.ast, decl.ops, j));
            }
        } else if item.kind == I_IMPL {
            let impl_node = match r.ast.impls.get(idx_from_raw[ImplNode](item.node)) {
                Option::Some(x) => x,
                Option::None => continue,
            };
            ty(inout r, impl_node.ty, 0, 0);
            for j in 0..list_len(in r.ast, impl_node.methods) {
                function(inout r, list_at(in r.ast, impl_node.methods, j));
            }
        } else if item.kind == I_TRAIT {
            let trait_node = match r.ast.traits.get(idx_from_raw[TraitNode](item.node)) {
                Option::Some(x) => x,
                Option::None => continue,
            };
            for j in 0..list_len(in r.ast, trait_node.methods) {
                function(inout r, list_at(in r.ast, trait_node.methods, j));
            }
        } else if item.kind == I_CONF {
            let conf = match r.ast.confs.get(idx_from_raw[ConfNode](item.node)) {
                Option::Some(x) => x,
                Option::None => continue,
            };
            for j in 0..list_len(in r.ast, conf.methods) {
                function(inout r, list_at(in r.ast, conf.methods, j));
            }
        }
    }
}

fn function(inout r: R, fi: u32) {
    let func = match r.ast.fns.get(idx_from_raw[FnNode](fi)) {
        Option::Some(x) => x,
        Option::None => return,
    };
    for j in 0..list_len(in r.ast, func.params) {
        match r.ast.params.get(idx_from_raw[ParamNode](list_at(in r.ast, func.params, j))) {
            Option::Some(param) => ty(inout r, param.ty, func.start, func.end),
            Option::None => {}
        }
    }
    ty(inout r, func.result, func.start, func.end);
    effects(inout r, func.effects, func.start, func.end);
    if func.body != NONE {
        expr(inout r, func.body);
    }
}

// `Rewriter::effects`: rewrites each `Ffi[Lib]` instance of row `row_id` to
// `Ffi$Lib`, or raises its error at `start..end`.
fn effects(inout r: R, row_id: u32, start: u32, end: u32) {
    let row = match r.ast.effects.get(idx_from_raw[EffectsNode](row_id)) {
        Option::Some(x) => x,
        Option::None => return,
    };
    let n = list_len(in r.ast, row.instances);
    let mut realtime = false;
    for i in 0..n {
        let effect = effect_at(in r, list_at(in r.ast, row.instances, i));
        if sym_is(in r, effect.name, in "Realtime") {
            realtime = true;
        }
    }
    for i in 0..n {
        let effect_id = list_at(in r.ast, row.instances, i);
        let args_effect = effect_at(in r, effect_id);
        for j in 0..list_len(in r.ast, args_effect.args) {
            ty(inout r, list_at(in r.ast, args_effect.args, j), start, end);
        }
        let effect = effect_at(in r, effect_id);
        if !sym_is(in r, effect.name, in "Ffi") {
            continue;
        }
        let mut library = NONE;
        if list_len(in r.ast, effect.args) == 1 {
            let lib_ty = type_at(in r.ast, list_at(in r.ast, effect.args, 0));
            if lib_ty.kind == T_NAMED && list_len(in r.ast, lib_ty.b) == 0 {
                library = lib_ty.a;
            }
        }
        if library == NONE {
            let mark = r.state.out.len();
            r.state.put(in "a foreign capability is written Ffi[Lib] with one library name");
            let msg = message(inout r, mark);
            raise(inout r, K_MALFORMED, msg, start, end);
            continue;
        }
        if !is_library(inout r, library) {
            let mark = r.state.out.len();
            r.state.put(in "Ffi[");
            put_sym(inout r, library);
            r.state.put(in "] names a library this package does not import");
            let msg = message(inout r, mark);
            raise(inout r, K_UNKNOWN_LIBRARY, msg, start, end);
            continue;
        }
        if effect.label != NONE {
            let mark = r.state.out.len();
            r.state.put(in "Ffi[");
            put_sym(inout r, library);
            r.state.put(in "] cannot be labelled; call Lib::f directly");
            let msg = message(inout r, mark);
            raise(inout r, K_MALFORMED, msg, start, end);
            continue;
        }
        if realtime {
            let mark = r.state.out.len();
            r.state.put(in "realtime code cannot carry Ffi[");
            put_sym(inout r, library);
            r.state.put(in "] (§32.2)");
            let msg = message(inout r, mark);
            raise(inout r, K_REALTIME, msg, start, end);
            continue;
        }
        r.buf.push_str(in "Ffi$");
        let ok = r.ast.names.resolve_into(symbol_from_id(library), inout r.buf);
        let name = intern_buf(inout r);
        let ok2 = r.ast.effect_nodes.set(
            idx_from_raw[EffectNode](effect_id),
            EffectNode { label: effect.label, name: name, args: 0 }
        );
    }
}

fn effect_at(in r: R, id: u32) -> EffectNode {
    r.ast
        .effect_nodes
        .get_or(idx_from_raw[EffectNode](id), EffectNode { label: NONE, name: NONE, args: 0 })
}

// `Rewriter::ty`.
fn ty(inout r: R, type_id: u32, start: u32, end: u32) {
    if type_id == NONE {
        return;
    }
    let node = type_at(in r.ast, type_id);
    if node.kind == T_NAMED {
        for i in 0..list_len(in r.ast, node.b) {
            ty(inout r, list_at(in r.ast, node.b, i), start, end);
        }
    } else if node.kind == T_TUPLE {
        for i in 0..list_len(in r.ast, node.a) {
            ty(inout r, list_at(in r.ast, node.a, i), start, end);
        }
    } else if node.kind == T_FUNCTION {
        let param_count = list_len(in r.ast, node.a) >> 1;
        for i in 0..param_count {
            ty(inout r, list_at(in r.ast, node.a, wrapping_add(i << 1, 1)), start, end);
        }
        ty(inout r, node.b, start, end);
        effects(inout r, node.c, start, end);
    } else if node.kind == T_ROW {
        effects(inout r, node.a, start, end);
    }
}

// `Rewriter::expr`.
fn expr(inout r: R, expr_id: u32) {
    if expr_id == NONE {
        return;
    }
    let node = expr_at(in r.ast, expr_id);
    let expr_kind = node.kind;
    if expr_kind == E_NAME {
        let (lib, at) = foreign_path(inout r, node.a);
        if lib != NONE64 {
            let const_index = const_row(inout r, lib, at, node.a);
            if const_index != NONE64 {
                let cname = r.state.const_row(const_index).name;
                let fn_name = const_fn_sym(inout r, lib, cname);
                let callee_idx = r.ast.exprs.alloc(
                    ExprNode {
                        kind: E_NAME,
                        start: node.start,
                        end: node.start,
                        a: fn_name,
                        b: 0,
                        c: 0,
                        d: 0,
                        e: 0
                    }
                );
                let ok = r.ast.exprs.set(
                    idx_from_raw[ExprNode](expr_id),
                    ExprNode {
                        kind: E_CALL,
                        start: node.start,
                        end: node.end,
                        a: callee_idx.raw(),
                        b: 0,
                        c: 0,
                        d: 0,
                        e: 0
                    }
                );
            } else {
                let mark = r.state.out.len();
                r.state.put(in "foreign function ");
                put_sym(inout r, node.a);
                r.state.put(in " can only be called");
                let msg = message(inout r, mark);
                raise(inout r, K_FOREIGN_VALUE, msg, node.start, node.end);
            }
        } else if is_handle(inout r, node.a) {
            handle_misuse(inout r, node.a, in "constructed", node.start, node.end);
        }
    } else if expr_kind == E_CALL {
        for i in 0..list_len(in r.ast, node.b) {
            ty(inout r, list_at(in r.ast, node.b, i), node.start, node.end);
        }
        for i in 0..list_len(in r.ast, node.c) {
            match r.ast.args.get(idx_from_raw[ArgNode](list_at(in r.ast, node.c, i))) {
                Option::Some(arg) => expr(inout r, arg.expr),
                Option::None => {}
            }
        }
        let callee = expr_at(in r.ast, node.a);
        let mut lib = NONE64;
        let mut at: u64 = 0;
        if callee.kind == E_NAME {
            let (lib_row, sym_at) = foreign_path(inout r, callee.a);
            if lib_row != NONE64 && const_row(inout r, lib_row, sym_at, callee.a) == NONE64 {
                lib = lib_row;
                at = sym_at;
            }
        }
        if lib != NONE64 {
            let name = call(inout r, lib, callee.a, at, node.c, node.start, node.end);
            if name != NONE {
                let ok = r.ast.exprs.set(
                    idx_from_raw[ExprNode](node.a),
                    ExprNode {
                        kind: E_NAME,
                        start: callee.start,
                        end: callee.end,
                        a: name,
                        b: callee.b,
                        c: callee.c,
                        d: callee.d,
                        e: callee.e
                    }
                );
            }
        } else {
            expr(inout r, node.a);
        }
    } else if expr_kind == E_TUPLE {
        for i in 0..list_len(in r.ast, node.a) {
            expr(inout r, list_at(in r.ast, node.a, i));
        }
    } else if expr_kind == E_STRUCT {
        if is_handle(inout r, node.a) {
            handle_misuse(inout r, node.a, in "constructed", node.start, node.end);
        }
        let pair_count = list_len(in r.ast, node.b) >> 1;
        for i in 0..pair_count {
            expr(inout r, list_at(in r.ast, node.b, wrapping_add(i << 1, 1)));
        }
    } else if expr_kind == E_BLOCK {
        for i in 0..list_len(in r.ast, node.a) {
            let stmt = match r.ast.stmts.get(idx_from_raw[StmtNode](list_at(in r.ast, node.a, i))) {
                Option::Some(v) => v,
                Option::None => continue,
            };
            if stmt.kind == ST_LET {
                pattern(inout r, stmt.pat);
                ty(inout r, stmt.ty, node.start, node.end);
                expr(inout r, stmt.value);
            } else {
                expr(inout r, stmt.value);
            }
        }
        expr(inout r, node.b);
    } else if expr_kind == E_FIELD || expr_kind == E_TRY || expr_kind == E_LOOP {
        expr(inout r, node.a);
    } else if expr_kind == E_UNARY {
        expr(inout r, node.b);
    } else if expr_kind == E_INDEX || expr_kind == E_RANGE {
        expr(inout r, node.a);
        expr(inout r, node.b);
    } else if expr_kind == E_BINARY || expr_kind == E_ASSIGN {
        expr(inout r, node.b);
        expr(inout r, node.c);
    } else if expr_kind == E_IF {
        expr(inout r, node.a);
        expr(inout r, node.b);
        expr(inout r, node.c);
    } else if expr_kind == E_MATCH {
        expr(inout r, node.a);
        let pair_count = list_len(in r.ast, node.b) >> 1;
        for i in 0..pair_count {
            pattern(inout r, list_at(in r.ast, node.b, i << 1));
            expr(inout r, list_at(in r.ast, node.b, wrapping_add(i << 1, 1)));
        }
    } else if expr_kind == E_FOR {
        expr(inout r, node.b);
        expr(inout r, node.c);
    } else if expr_kind == E_BREAK || expr_kind == E_RETURN {
        expr(inout r, node.a);
    } else if expr_kind == E_CLOSURE {
        for i in 0..list_len(in r.ast, node.a) {
            match r.ast.params.get(idx_from_raw[ParamNode](list_at(in r.ast, node.a, i))) {
                Option::Some(param) => ty(inout r, param.ty, node.start, node.end),
                Option::None => {}
            }
        }
        ty(inout r, node.c, node.start, node.end);
        effects(inout r, node.d, node.start, node.end);
        expr(inout r, node.e);
    } else if expr_kind == E_HANDLE {
        let eff = effect_at(in r, node.a);
        if sym_is(in r, eff.name, in "Ffi") || is_library(inout r, eff.name) {
            let mark = r.state.out.len();
            r.state.put(
                in "foreign capabilities are granted by the package's import, not handled in source"
            );
            let msg = message(inout r, mark);
            raise(inout r, K_FOREIGN_HANDLER, msg, node.start, node.end);
        }
        for i in 0..list_len(in r.ast, eff.args) {
            ty(inout r, list_at(in r.ast, eff.args, i), node.start, node.end);
        }
        if node.b != NONE {
            expr(inout r, node.c);
        }
        expr(inout r, node.d);
        for i in 0..list_len(in r.ast, node.e) {
            let clause = match r.ast
                .clauses
                .get(idx_from_raw[ClauseNode](list_at(in r.ast, node.e, i))) {
                Option::Some(v) => v,
                Option::None => continue,
            };
            for j in 0..list_len(in r.ast, clause.pats) {
                pattern(inout r, list_at(in r.ast, clause.pats, j));
            }
            expr(inout r, clause.body);
        }
    }
}

// `Rewriter::pattern`.
fn pattern(inout r: R, pat_id: u32) {
    if pat_id == NONE {
        return;
    }
    let node = pat_at(in r.ast, pat_id);
    if node.kind == P_CONSTRUCTOR {
        if list_len(in r.ast, node.b) == 0 {
            let (lib, at) = foreign_path(inout r, node.a);
            if lib != NONE64 {
                let ci = const_row(inout r, lib, at, node.a);
                if ci != NONE64 {
                    let const_def = r.state.const_row(ci);
                    let lit = r.ast
                        .lits
                        .alloc(Lit { kind: 1, neg: const_def.neg, bits: const_def.value, hi: 0 });
                    buf_name(inout r, wrapping_u32(widen_u64(const_def.scalar)));
                    let scalar = intern_buf(inout r);
                    let ok = r.ast.pats.set(
                        idx_from_raw[PatNode](pat_id),
                        PatNode {
                            kind: P_LIT,
                            start: node.start,
                            end: node.end,
                            a: lit.raw(),
                            b: scalar,
                            c: NONE
                        }
                    );
                    return;
                }
            }
        }
        if is_handle(inout r, node.a) {
            handle_misuse(inout r, node.a, in "destructured", node.start, node.end);
        }
        let pair_count = list_len(in r.ast, node.b) >> 1;
        for i in 0..pair_count {
            pattern(inout r, list_at(in r.ast, node.b, wrapping_add(i << 1, 1)));
        }
    } else if node.kind == P_TUPLE {
        for i in 0..list_len(in r.ast, node.a) {
            pattern(inout r, list_at(in r.ast, node.a, i));
        }
    }
}

// ---------------------------------------------------------------- calls

// The constant row of library `lib` whose symbol is `sym`'s bytes from `at`,
// or NONE64.
fn const_row(inout r: R, lib: u64, at: u64, sym: u32) -> u64 {
    load_bytes(inout r, sym);
    let lib_row = r.state.lib(lib);
    let n = r.bytes.len();
    for i in 0..lib_row.const_count {
        let ci = wrapping_add(lib_row.const_start, i);
        if r.state.spells(r.state.const_row(ci).name, in r.bytes[at..n]) {
            return ci;
        }
    }
    NONE64
}

fn const_fn_sym(inout r: R, lib: u64, cname: u32) -> u32 {
    r.buf.push_str(in "const$FfiConst$");
    let lib_name = r.state.lib(lib).name;
    buf_name(inout r, lib_name);
    r.buf.push_str(in "$");
    buf_name(inout r, cname);
    intern_buf(inout r)
}

// The function row of library `lib` whose symbol is `r.bytes[at..]`, or
// NONE64 (`LibraryDescriptor::function`).
fn function_row(inout r: R, lib: u64, at: u64) -> u64 {
    let lib_row = r.state.lib(lib);
    let n = r.bytes.len();
    for i in 0..lib_row.fun_count {
        let fi = wrapping_add(lib_row.fun_start, i);
        if r.state.spells(r.state.fun(fi).sym, in r.bytes[at..n]) {
            return fi;
        }
    }
    NONE64
}

// The pass 2 lengths row of the call at `start..end`, or NONE64.
fn arity_row(in r: R, start: u32, end: u32) -> u64 {
    let n = r.len_rows.len() >> 2;
    for i in 0..n {
        let row = i << 2;
        if u64_at(in r.len_rows, row) == w(start)
            && u64_at(in r.len_rows, wrapping_add(row, 1)) == w(end) {
            return row;
        }
    }
    NONE64
}

// Whether lens[a..a+n] equals inst_lens[b..b+m].
fn same_vector(in r: R, a: u64, n: u64, b: u64, m: u64) -> bool {
    if n != m {
        return false;
    }
    for i in 0..n {
        if u64_at(in r.lens, wrapping_add(a, i)) != u64_at(in r.inst_lens, wrapping_add(b, i)) {
            return false;
        }
    }
    true
}

// Records that (lib, fi) uses lens[a..a+n] (`instances[..].insert`).
fn use_vector(inout r: R, lib: u64, fi: u64, a: u64, n: u64) {
    let inst_count = r.insts.len() >> 2;
    for i in 0..inst_count {
        let row = i << 2;
        if u64_at(in r.insts, row) == lib && u64_at(in r.insts, wrapping_add(row, 1)) == fi {
            if same_vector(
                in r,
                a,
                n,
                u64_at(in r.insts, wrapping_add(row, 2)),
                u64_at(in r.insts, wrapping_add(row, 3))
            ) {
                return;
            }
        }
    }
    r.insts.push(lib);
    r.insts.push(fi);
    r.insts.push(r.inst_lens.len());
    r.insts.push(n);
    for i in 0..n {
        r.inst_lens.push(u64_at(in r.lens, wrapping_add(a, i)));
    }
}

// `Rewriter::call`: the AST symbol of the operation `Lib::f` (name `sym`,
// symbol at byte `at`) resolves to, or NONE after raising its error.
fn call(inout r: R, lib: u64, sym: u32, at: u64, args: u32, start: u32, end: u32) -> u32 {
    load_bytes(inout r, sym);
    let fi = function_row(inout r, lib, at);
    let lib_row = r.state.lib(lib);
    if fi == NONE64 {
        let mark = r.state.out.len();
        r.state.put(in "library '");
        r.state.put_name(lib_row.name);
        r.state.put(in "' declares no function '");
        for i in at..r.bytes.len() {
            r.state.out.push(u8_at(in r.bytes, i));
        }
        r.state.put(in "'");
        let msg = message(inout r, mark);
        raise(inout r, K_UNKNOWN_FUNCTION, msg, start, end);
        return NONE;
    }
    let func = r.state.fun(fi);
    let shape = r.state.sh(fi);
    if !shape.ok {
        let mark = r.state.out.len();
        r.state.put_name(lib_row.name);
        r.state.put(in "::");
        r.state.put_name(func.sym);
        r.state.put(in ": ");
        r.state.put_name(shape.err);
        let msg = message(inout r, mark);
        raise(inout r, K_UNSUPPORTED, msg, start, end);
        return NONE;
    }
    r.buf.push_str(in "Ffi$");
    buf_name(inout r, lib_row.name);
    r.buf.push_str(in "::");
    if !r.pass2 {
        if list_len(in r.ast, args) == shape.param_count {
            let head = r.sites.len();
            let mut count: u64 = 0;
            for j in 0..shape.param_count {
                let shape_param = r.state.sp(wrapping_add(shape.param_start, j));
                if !shape_param.slice {
                    continue;
                }
                if count == 0 {
                    r.sites.push(w(start));
                    r.sites.push(w(end));
                    r.sites.push(0);
                }
                count = wrapping_add(count, 1);
                let arg = match r.ast.args.get(idx_from_raw[ArgNode](list_at(in r.ast, args, j))) {
                    Option::Some(v) => v,
                    Option::None => ArgNode { pass: 0, explicit: false, expr: NONE },
                };
                let arg_expr = expr_at(in r.ast, arg.expr);
                r.sites.push(w(arg_expr.start));
                r.sites.push(w(arg_expr.end));
                r.sites.push(w(shape_param.ty));
                r.sites.push(if shape_param.nullable { 1 } else { 0 });
                r.sites.push(if shape_param.in_place { 1 } else { 0 });
            }
            if count > 0 {
                let ok = r.sites.try_set(wrapping_add(head, 2), count);
            }
        }
        buf_name(inout r, func.sym);
        return intern_buf(inout r);
    }
    let row = arity_row(in r, start, end);
    let mut len_start: u64 = 0;
    let mut len_count: u64 = 0;
    if row != NONE64 {
        len_start = u64_at(in r.len_rows, wrapping_add(row, 2));
        len_count = u64_at(in r.len_rows, wrapping_add(row, 3));
    }
    if len_count != slice_count(in r.state, shape) {
        // Arity mismatch: the checker reports it against the base op.
        use_vector(inout r, lib, fi, 0, 0);
        buf_name(inout r, func.sym);
        return intern_buf(inout r);
    }
    r.calls.push(w(start));
    r.calls.push(w(end));
    r.calls.push(lib);
    r.calls.push(fi);
    r.calls.push(r.call_lens.len());
    r.calls.push(len_count);
    for i in 0..len_count {
        r.call_lens.push(u64_at(in r.lens, wrapping_add(len_start, i)));
    }
    use_vector(inout r, lib, fi, len_start, len_count);
    let mark = r.state.out.len();
    put_op_name(inout r.state, func.sym, in r.lens, len_start, len_count);
    let op = r.state.intern_tail(mark);
    buf_name(inout r, op);
    intern_buf(inout r)
}

// ---------------------------------------------------------------- output

fn put_kind(inout state: S, kind: u8) {
    if kind == K_DUPLICATE {
        state.put(in "DuplicateLibrary");
    } else if kind == K_COLLISION {
        state.put(in "NameCollision");
    } else if kind == K_SLICE {
        state.put(in "SliceArgument");
    } else if kind == K_TARGET {
        state.put(in "TargetMismatch");
    } else if kind == K_ISOLATION {
        state.put(in "IsolationUnavailable");
    } else if kind == K_MALFORMED {
        state.put(in "MalformedCapability");
    } else if kind == K_UNKNOWN_LIBRARY {
        state.put(in "UnknownLibrary");
    } else if kind == K_REALTIME {
        state.put(in "Realtime");
    } else if kind == K_FOREIGN_VALUE {
        state.put(in "ForeignValue");
    } else if kind == K_HANDLE_MISUSE {
        state.put(in "HandleMisuse");
    } else if kind == K_FOREIGN_HANDLER {
        state.put(in "ForeignHandler");
    } else if kind == K_UNKNOWN_FUNCTION {
        state.put(in "UnknownForeignFunction");
    } else {
        state.put(in "UnsupportedType");
    }
}

fn put_err(inout state: S, err: Err) {
    put_kind(inout state, err.kind);
    if err.has_span {
        state.put(in " @");
        state.put_u64(err.start);
        state.put(in "..");
        state.put_u64(err.end);
    } else {
        state.put(in " -");
    }
    state.put(in " ");
    state.put_q(err.msg);
}

fn put_span(inout state: S, start: u64, end: u64) {
    state.put(in " @");
    state.put_u64(start);
    state.put(in "..");
    state.put_u64(end);
}

fn put_lengths(inout state: S, in lens: ChunkSeq[u64], len_start: u64, len_count: u64) {
    state.put(in "[");
    for i in 0..len_count {
        if i > 0 {
            state.put(in ",");
        }
        let len = u64_at(in lens, wrapping_add(len_start, i));
        if len == NONE64 {
            state.put(in "s");
        } else {
            state.put_u64(len);
        }
    }
    state.put(in "]");
}

fn put_flag(inout state: S, flag: bool) {
    if flag {
        state.put(in "1");
    } else {
        state.put(in "0");
    }
}

// Byte order of two S names (`str::cmp`), then of two length vectors
// (`Vec<usize>`'s `Ord`): -1, 0 or 1.
fn vector_cmp(in r: R, left_start: u64, left_len: u64, right_start: u64, right_len: u64) -> i32 {
    let common = if left_len < right_len {
        left_len
    } else {
        right_len
    };
    for i in 0..common {
        let left = u64_at(in r.inst_lens, wrapping_add(left_start, i));
        let right = u64_at(in r.inst_lens, wrapping_add(right_start, i));
        if left < right {
            return -1;
        }
        if left > right {
            return 1;
        }
    }
    if left_len < right_len {
        -1
    } else if left_len > right_len {
        1
    } else {
        0
    }
}

// Whether instance row `i` sorts before row `j`: by (library name, symbol)
// then vector, as the `BTreeMap<(String, String), BTreeSet<Vec<usize>>>`
// iterates.
fn inst_less(in r: R, i: u64, j: u64) -> bool {
    let left_row = i << 2;
    let right_row = j << 2;
    let left_lib = r.state.lib(u64_at(in r.insts, left_row)).name;
    let right_lib = r.state.lib(u64_at(in r.insts, right_row)).name;
    let lib_order = r.state.name_cmp(left_lib, right_lib);
    if lib_order != 0 {
        return lib_order < 0;
    }
    let left_sym = r.state.fun(u64_at(in r.insts, wrapping_add(left_row, 1))).sym;
    let right_sym = r.state.fun(u64_at(in r.insts, wrapping_add(right_row, 1))).sym;
    let sym_order = r.state.name_cmp(left_sym, right_sym);
    if sym_order != 0 {
        return sym_order < 0;
    }
    vector_cmp(
        in r,
        u64_at(in r.insts, wrapping_add(left_row, 2)),
        u64_at(in r.insts, wrapping_add(left_row, 3)),
        u64_at(in r.insts, wrapping_add(right_row, 2)),
        u64_at(in r.insts, wrapping_add(right_row, 3))
    )
        < 0
}

// Writes pass `pass`'s outcome: its first error, its tables, then the
// canonical dump of the rewritten module.
fn report(inout r: R) {
    if r.has_err {
        r.state.put(in " err ");
        let e = r.err;
        put_err(inout r.state, e);
    } else {
        r.state.put(in " ok");
    }
    r.state.nl();
    if !r.pass2 {
        let mut i: u64 = 0;
        let total = r.sites.len();
        for step in 0..total {
            if i >= total {
                break;
            }
            r.state.put(in "site");
            put_span(inout r.state, u64_at(in r.sites, i), u64_at(in r.sites, wrapping_add(i, 1)));
            r.state.nl();
            let arg_count = u64_at(in r.sites, wrapping_add(i, 2));
            i = wrapping_add(i, 3);
            for j in 0..arg_count {
                r.state.put(in " slice");
                put_span(
                    inout r.state,
                    u64_at(in r.sites, i),
                    u64_at(in r.sites, wrapping_add(i, 1))
                );
                r.state.put(in " ");
                r.state.put_display(n32(u64_at(in r.sites, wrapping_add(i, 2))));
                r.state.put(in " nullable=");
                put_flag(inout r.state, u64_at(in r.sites, wrapping_add(i, 3)) == 1);
                r.state.put(in " in_place=");
                put_flag(inout r.state, u64_at(in r.sites, wrapping_add(i, 4)) == 1);
                r.state.nl();
                i = wrapping_add(i, 5);
            }
        }
    } else {
        let inst_count = r.insts.len() >> 2;
        let mut order = ChunkSeq::with_capacity[u64](inst_count);
        for i in 0..inst_count {
            order.push(i);
        }
        // Insertion sort: the rows are few.
        for i in 1..inst_count {
            let mut j = i;
            for step in 0..i {
                if j == 0 {
                    break;
                }
                let key = u64_at(in order, j);
                let prev = u64_at(in order, wrapping_sub(j, 1));
                if !inst_less(in r, key, prev) {
                    break;
                }
                let ok = order.try_set(j, prev);
                let ok2 = order.try_set(wrapping_sub(j, 1), key);
                j = wrapping_sub(j, 1);
            }
        }
        for i in 0..inst_count {
            let row = u64_at(in order, i) << 2;
            r.state.put(in "instance ");
            let lib_name = r.state.lib(u64_at(in r.insts, row)).name;
            r.state.put_q(lib_name);
            r.state.put(in " ");
            let fn_sym = r.state.fun(u64_at(in r.insts, wrapping_add(row, 1))).sym;
            r.state.put_q(fn_sym);
            r.state.put(in " ");
            put_lengths(
                inout r.state,
                in r.inst_lens,
                u64_at(in r.insts, wrapping_add(row, 2)),
                u64_at(in r.insts, wrapping_add(row, 3))
            );
            r.state.nl();
        }
        let call_count = r.calls.len() / 6;
        for i in 0..call_count {
            let row = wrapping_mul(i, 6);
            r.state.put(in "call");
            put_span(
                inout r.state,
                u64_at(in r.calls, row),
                u64_at(in r.calls, wrapping_add(row, 1))
            );
            r.state.put(in " ");
            let lib = r.state.lib(u64_at(in r.calls, wrapping_add(row, 2)));
            r.state.put_q(lib.name);
            r.state.put(in " ");
            let fn_sym = r.state.fun(u64_at(in r.calls, wrapping_add(row, 3))).sym;
            r.state.put_q(fn_sym);
            if lib.handler == H_MPK {
                r.state.put(in " isolated(mpk) ");
            } else {
                r.state.put(in " direct ");
            }
            put_lengths(
                inout r.state,
                in r.call_lens,
                u64_at(in r.calls, wrapping_add(row, 4)),
                u64_at(in r.calls, wrapping_add(row, 5))
            );
            r.state.nl();
        }
    }
    dump_ast(in r.ast, inout r.state.out);
}

// ---------------------------------------------------------------- entries

// One case: reads the libraries and the pass 2 lengths from `bytes`, then runs
// pass 1 and (when asked) pass 2 over `source`; returns the state with its
// text.
fn run(in bytes: Slice[u8], in source: Str) -> S {
    let mut state = s_new();
    let mut reader = Reader { pos: 0, stop: bytes.len() };
    let lib_count = reader.word(in bytes);
    for i in 0..lib_count {
        let handler = reader.word(in bytes);
        let (desc_start, desc_end) = reader.text(in bytes);
        read_library(in bytes, desc_start, desc_end, handler, inout state);
    }
    let has_pass2 = reader.word(in bytes) == 1;
    let mut len_rows = ChunkSeq::new[u64]();
    let mut lens = ChunkSeq::new[u64]();
    if has_pass2 {
        let call_count = reader.word(in bytes);
        for i in 0..call_count {
            len_rows.push(reader.word(in bytes));
            len_rows.push(reader.word(in bytes));
            len_rows.push(lens.len());
            let len_count = reader.word(in bytes);
            len_rows.push(len_count);
            for j in 0..len_count {
                lens.push(reader.word(in bytes));
            }
        }
    }
    let gen_error = generate(inout state);
    if gen_error.msg != NONE {
        state.put(in "G err ");
        put_err(inout state, gen_error);
        state.nl();
        return state;
    }
    let pass1 = lower_source(in source);
    let mut r = r_new(state, pass1.ast, false, in len_rows, in lens);
    r.state.put(in "pass1");
    module(inout r);
    report(inout r);
    if !has_pass2 {
        return r.state;
    }
    let pass2 = lower_source(in source);
    let mut r2 = r_new(r.state, pass2.ast, true, in len_rows, in lens);
    r2.state.put(in "pass2");
    module(inout r2);
    report(inout r2);
    r2.state
}

// The harness entry: the case `input` and `source`
// (tests/self_host_ffi_lowering_rewrite.rs) to its text, packed as a byte
// length and eight bytes per word.
pub fn ffi_rewrite_text(in input: Str, in source: Str) -> ChunkSeq[u64] {
    let state = run(in input.as_bytes(), in source);
    pack(in state.out)
}

// `drops::span_base` + `drops::generated` + pass-1 `Rewriter`, packed as
// a byte length and eight bytes per word.
pub fn ffi_drops_generated_text(in input: Str, in source: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mut state = s_new();
    let mut reader = Reader { pos: 0, stop: bytes.len() };
    let lib_count = reader.word(in bytes);
    for i in 0..lib_count {
        let handler = reader.word(in bytes);
        let (desc_start, desc_end) = reader.text(in bytes);
        read_library(in bytes, desc_start, desc_end, handler, inout state);
    }
    let gen_error = generate(inout state);
    if gen_error.msg != NONE {
        state.put(in "G err ");
        put_err(inout state, gen_error);
        state.nl();
        return pack(in state.out);
    }
    let lowered = lower_source(in source);
    let mut ast = lowered.ast;
    append_drops(inout ast, in state);
    let mut r = r_new(state, ast, false, in ChunkSeq::new[u64](), in ChunkSeq::new[u64]());
    r.state.put(in "drops");
    module(inout r);
    report(inout r);
    pack(in r.state.out)
}

// The same work without the text: its length, for timing.
pub fn ffi_rewrite_count(in input: Str, in source: Str) -> u64 {
    let state = run(in input.as_bytes(), in source);
    state.out.len()
}

fn pack(in text: ChunkSeq[u8]) -> ChunkSeq[u64] {
    let n = text.len();
    let mut out = ChunkSeq::with_capacity[u64](wrapping_add(n >> 3, 2));
    out.push(n);
    let mut word: u64 = 0;
    let mut filled: u32 = 0;
    for i in 0..n {
        let byte = widen_u64(u8_at(in text, i));
        word = word | wrapping_shl_u64(byte, wrapping_mul(filled, 8));
        filled = wrapping_add(filled, 1);
        if filled == 8 {
            out.push(word);
            word = 0;
            filled = 0;
        }
    }
    if filled != 0 {
        out.push(word);
    }
    out
}

// A type of the buffer check's input (`buffer_input` of
// tests/self_host_ffi_lowering_rewrite.rs): 0 other, 1 named (name, n, n
// types), 2 tuple (n, n types).
fn read_ty(inout reader: Reader, in bytes: Slice[u8], inout ast: Ast, inout walk: W) -> u32 {
    let kind = reader.word(in bytes);
    if kind == 0 {
        return 0;
    }
    let mut name: u32 = NONE;
    if kind == 1 {
        let (name_start, name_end) = reader.text(in bytes);
        let mut text = String::new();
        for i in name_start..name_end {
            match bytes.try_get(i) {
                Option::Some(byte) => {
                    let _ = text.push_char(wrapping_u32(widen_u64(byte)));
                }
                Option::None => {}
            }
        }
        name = ast.names.intern(in text).id();
    }
    let item_count = reader.word(in bytes);
    let mut items: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..item_count {
        let item = read_ty(inout reader, in bytes, inout ast, inout walk);
        items.push(item);
    }
    walk.ty(if kind == 1 { 1 } else { 2 }, name, in items)
}

// The harness entry of buffers.ves: the case `input` (the rewrite's, then
// the buffer type names and the checker's expression types) and `source`.
// The source gets its drop items and the pass-2 rewrite, as in
// `check_module`; the text is `ok`, or the first refusal (`err @start..end
// message`).
pub fn ffi_buffer_text(in input: Str, in source: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mut state = s_new();
    let mut reader = Reader { pos: 0, stop: bytes.len() };
    let lib_count = reader.word(in bytes);
    for i in 0..lib_count {
        let handler = reader.word(in bytes);
        let (desc_start, desc_end) = reader.text(in bytes);
        read_library(in bytes, desc_start, desc_end, handler, inout state);
    }
    let has_pass2 = reader.word(in bytes) == 1;
    let mut len_rows = ChunkSeq::new[u64]();
    let mut lens = ChunkSeq::new[u64]();
    if has_pass2 {
        let call_count = reader.word(in bytes);
        for i in 0..call_count {
            len_rows.push(reader.word(in bytes));
            len_rows.push(reader.word(in bytes));
            len_rows.push(lens.len());
            let len_count = reader.word(in bytes);
            len_rows.push(len_count);
            for j in 0..len_count {
                lens.push(reader.word(in bytes));
            }
        }
    }
    let gen_error = generate(inout state);
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    if gen_error.msg != NONE {
        out.extend(in "generate err\n".as_bytes());
        return pack(in out);
    }
    let lowered = lower_source(in source);
    let mut ast = lowered.ast;
    append_drops(inout ast, in state);
    let mut r = r_new(state, ast, true, in len_rows, in lens);
    module(inout r);
    if r.has_err {
        out.extend(in "rewrite err\n".as_bytes());
        return pack(in out);
    }
    let mut walk = w_new(inout r.ast);
    let buffer_count = reader.word(in bytes);
    for i in 0..buffer_count {
        let (name_start, name_end) = reader.text(in bytes);
        let mut text = String::new();
        for j in name_start..name_end {
            match bytes.try_get(j) {
                Option::Some(byte) => {
                    let _ = text.push_char(wrapping_u32(widen_u64(byte)));
                }
                Option::None => {}
            }
        }
        let name = r.ast.names.intern(in text).id();
        walk.add_buffer(name);
    }
    let type_count = reader.word(in bytes);
    for i in 0..type_count {
        let start = reader.word(in bytes);
        let end = reader.word(in bytes);
        let ty = read_ty(inout reader, in bytes, inout r.ast, inout walk);
        walk.record(start, end, ty);
    }
    if check_buffers(in r.ast, inout walk) {
        out.extend(in "err @".as_bytes());
        push_dec(inout out, widen_u64(walk.err_start));
        out.extend(in "..".as_bytes());
        push_dec(inout out, widen_u64(walk.err_end));
        out.push(32);
        for i in 0..walk.msg.len() {
            out.push(u8_at(in walk.msg, i));
        }
        out.push(10);
    } else {
        out.extend(in "ok\n".as_bytes());
    }
    pack(in out)
}

fn push_dec(inout out: ChunkSeq[u8], value: u64) {
    if value >= 10 {
        push_dec(inout out, value / 10);
    }
    out.push(wrapping_u8(wrapping_add(value % 10, 48)));
}
