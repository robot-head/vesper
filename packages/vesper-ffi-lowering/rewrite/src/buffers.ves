// The foreign-memory rules of src/ffi_lowering/buffers.rs (§16.3) over the
// @vesper/ast tree: what a pinned buffer's or a mapping's sequence `b.data`
// obeys beyond the ordinary checker's.
//
// `b.data` is an ordinary `ChunkSeq[T]` to the checker. What the checker
// would also allow, and foreign memory cannot take, is anything that
// changes the sequence's buffer: C may hold its address, so it may not
// grow, shrink, move out or be replaced. The walk refuses every use of
// `b.data` other than an element access or a view, a call of a method that
// keeps the buffer where it is and as long as it is, and an explicit `in`
// argument. C may also write the memory during any later foreign call, so a
// bound view may not be held across one, and a view is never lent to a
// source function that may perform `Ffi`.
//
// The walk types places itself, as Rust's does: parameters and `let`
// bindings by their declared types, fields through the module's structs
// (with their generics substituted), patterns through constructors and
// handler clauses; anything else is the checker's recorded type of the
// expression (`TypeMap`), which the input carries.
//
// Types are rows of `W`: Named (name, args), Tuple (items) or Other (every
// type the walk never looks into, and `Infer`). NO_TY is an absent type
// (Rust's `None`).

use @vesper/ast::{
    Ast, ExprNode, PatNode, TypeNode, StmtNode, ArgNode, ClauseNode, ParamNode, EffectsNode,
    EffectNode, GenericNode, FieldNode, VariantNode, AdtNode, FnNode, EffectDeclNode, ImplNode,
    ConfNode, ItemNode, list_len, list_at, expr_at, pat_at, type_at
};
use @vesper-std/arena::{idx_from_raw};
use @vesper-std/intern::{symbol_from_id};

const NONE: u32 = 4294967295;
const NONE64: u64 = 18446744073709551615;
const NO_TY: u32 = 4294967295;

// Type row kinds.
const TK_OTHER: u8 = 0;
const TK_NAMED: u8 = 1;
const TK_TUPLE: u8 = 2;
// The Other type (`Infer`, functions, rows, literals).
const OTHER: u32 = 0;

// AST kinds (@vesper/ast).
const E_LITERAL: u8 = 1;
const E_NAME: u8 = 2;
const E_TUPLE: u8 = 3;
const E_STRUCT: u8 = 4;
const E_BLOCK: u8 = 5;
const E_CALL: u8 = 6;
const E_FIELD: u8 = 7;
const E_INDEX: u8 = 8;
const E_TRY: u8 = 9;
const E_UNARY: u8 = 10;
const E_BINARY: u8 = 11;
const E_ASSIGN: u8 = 12;
const E_IF: u8 = 13;
const E_MATCH: u8 = 14;
const E_CLOSURE: u8 = 15;
const E_HANDLE: u8 = 16;
const E_LOOP: u8 = 17;
const E_FOR: u8 = 18;
const E_RANGE: u8 = 19;
const E_BREAK: u8 = 20;
const E_RETURN: u8 = 21;
const P_BIND: u8 = 2;
const P_TUPLE: u8 = 4;
const P_CONSTRUCTOR: u8 = 5;
const T_NAMED: u8 = 1;
const T_TUPLE: u8 = 2;
const T_INFER: u8 = 5;
const I_ADT: u8 = 1;
const I_FN: u8 = 2;
const I_EFFECT: u8 = 3;
const I_IMPL: u8 = 4;
const I_CONF: u8 = 6;
const ST_LET: u8 = 1;
const PASS_IN: u8 = 0;

// The walk's state.
pub struct W {
    // types: kind, name symbol, items ti[ta..ta+tn]
    ty_kinds: ChunkSeq[u8],
    tname: ChunkSeq[u32],
    ta: ChunkSeq[u64],
    tn: ChunkSeq[u64],
    ti: ChunkSeq[u32],
    // the checker's types by span key (start << 32 | end), sorted
    rec_key: ChunkSeq[u64],
    rec_ty: ChunkSeq[u32],
    // the buffer type names (`Generated::is_buffer`)
    buffers: ChunkSeq[u32],
    // structs and effects by name (item node indices), in item order: a
    // later one shadows an earlier one, as in Rust's maps
    adt_name: ChunkSeq[u32],
    adt_node: ChunkSeq[u32],
    eff_name: ChunkSeq[u32],
    eff_node: ChunkSeq[u32],
    // the source functions and methods that may perform `Ffi`
    foreign: ChunkSeq[u32],
    // scopes: bindings (name, type), and each scope's first binding
    bind_names: ChunkSeq[u32],
    bind_tys: ChunkSeq[u32],
    marks: ChunkSeq[u64],
    // the first error: its span and message
    has_err: bool,
    err_start: u32,
    err_end: u32,
    msg: ChunkSeq[u8],
    // symbols the walk compares with
    s_data: u32,
    s_range: u32,
    s_as_slice: u32,
    s_as_slice_mut: u32,
    s_option: u32,
    s_some: u32,
    s_result: u32,
    s_ok: u32,
    s_err: u32,
    s_ffi: u32,
    keeps: ChunkSeq[u32],
}

fn u32_at(in seq: ChunkSeq[u32], i: u64) -> u32 {
    seq.try_get(i).unwrap_or(NONE)
}

fn u64_at(in seq: ChunkSeq[u64], i: u64) -> u64 {
    seq.try_get(i).unwrap_or(0)
}

fn u8_at(in seq: ChunkSeq[u8], i: u64) -> u8 {
    seq.try_get(i).unwrap_or(0)
}

fn w64(x: u32) -> u64 {
    widen_u64(x)
}

fn has32(in seq: ChunkSeq[u32], x: u32) -> bool {
    for i in 0..seq.len() {
        if u32_at(in seq, i) == x {
            return true;
        }
    }
    false
}

// Interns `text` into the tree's names.
fn sym(inout ast: Ast, in text: Str) -> u32 {
    ast.names.intern(in text).id()
}

// A new walk over `ast`, whose names gain the symbols it compares with.
pub fn w_new(inout ast: Ast) -> W {
    let mut keeps: ChunkSeq[u32] = ChunkSeq::new[u32]();
    keeps.push(sym(inout ast, in "len"));
    keeps.push(sym(inout ast, in "address"));
    keeps.push(sym(inout ast, in "get"));
    keeps.push(sym(inout ast, in "set"));
    keeps.push(sym(inout ast, in "try_get"));
    keeps.push(sym(inout ast, in "try_set"));
    keeps.push(sym(inout ast, in "try_get_mut"));
    keeps.push(sym(inout ast, in "try_atomic_load"));
    keeps.push(sym(inout ast, in "try_atomic_load_u32"));
    keeps.push(sym(inout ast, in "try_atomic_load_u64"));
    keeps.push(sym(inout ast, in "try_atomic_store"));
    keeps.push(sym(inout ast, in "try_atomic_store_u32"));
    keeps.push(sym(inout ast, in "try_atomic_store_u64"));
    keeps.push(sym(inout ast, in "as_slice"));
    keeps.push(sym(inout ast, in "as_slice_mut"));
    keeps.push(sym(inout ast, in "copy_from"));
    keeps.push(sym(inout ast, in "try_copy_from"));
    keeps.push(sym(inout ast, in "copy_within"));
    keeps.push(sym(inout ast, in "try_copy_within"));
    keeps.push(sym(inout ast, in "fill"));
    keeps.push(sym(inout ast, in "try_fill"));
    keeps.push(sym(inout ast, in "swap"));
    keeps.push(sym(inout ast, in "sum_be16"));
    keeps.push(sym(inout ast, in "eq"));
    keeps.push(sym(inout ast, in "cmp"));
    keeps.push(sym(inout ast, in "find_byte"));
    keeps.push(sym(inout ast, in "find_either"));
    keeps.push(sym(inout ast, in "find_not_in"));
    keeps.push(sym(inout ast, in "eq_ignore_ascii_case"));
    keeps.push(sym(inout ast, in "make_ascii_lowercase"));
    keeps.push(sym(inout ast, in "try_make_ascii_lowercase"));
    let mut walk = W {
        ty_kinds: ChunkSeq::new[u8](),
        tname: ChunkSeq::new[u32](),
        ta: ChunkSeq::new[u64](),
        tn: ChunkSeq::new[u64](),
        ti: ChunkSeq::new[u32](),
        rec_key: ChunkSeq::new[u64](),
        rec_ty: ChunkSeq::new[u32](),
        buffers: ChunkSeq::new[u32](),
        adt_name: ChunkSeq::new[u32](),
        adt_node: ChunkSeq::new[u32](),
        eff_name: ChunkSeq::new[u32](),
        eff_node: ChunkSeq::new[u32](),
        foreign: ChunkSeq::new[u32](),
        bind_names: ChunkSeq::new[u32](),
        bind_tys: ChunkSeq::new[u32](),
        marks: ChunkSeq::new[u64](),
        has_err: false,
        err_start: 0,
        err_end: 0,
        msg: ChunkSeq::new[u8](),
        s_data: sym(inout ast, in "data"),
        s_range: sym(inout ast, in ".."),
        s_as_slice: sym(inout ast, in "as_slice"),
        s_as_slice_mut: sym(inout ast, in "as_slice_mut"),
        s_option: sym(inout ast, in "Option"),
        s_some: sym(inout ast, in "Some"),
        s_result: sym(inout ast, in "Result"),
        s_ok: sym(inout ast, in "Ok"),
        s_err: sym(inout ast, in "Err"),
        s_ffi: sym(inout ast, in "Ffi"),
        keeps: keeps,
    };
    // Type 0 is Other.
    let none: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let other = walk.ty(TK_OTHER, NONE, in none);
    walk
}

impl W {
    // A new type row.
    pub fn ty(inout self, kind: u8, name: u32, in items: ChunkSeq[u32]) -> u32 {
        let id = wrapping_u32(self.ty_kinds.len());
        self.ty_kinds.push(kind);
        self.tname.push(name);
        self.ta.push(self.ti.len());
        self.tn.push(items.len());
        for i in 0..items.len() {
            self.ti.push(u32_at(in items, i));
        }
        id
    }

    fn kind(in self, ty: u32) -> u8 {
        if ty == NO_TY {
            return 255;
        }
        u8_at(in self.ty_kinds, w64(ty))
    }

    fn name(in self, ty: u32) -> u32 {
        u32_at(in self.tname, w64(ty))
    }

    fn count(in self, ty: u32) -> u64 {
        u64_at(in self.tn, w64(ty))
    }

    fn item(in self, ty: u32, i: u64) -> u32 {
        if i >= self.count(ty) {
            return NO_TY;
        }
        u32_at(in self.ti, wrapping_add(u64_at(in self.ta, w64(ty)), i))
    }

    // A recorded type of the checker, for span `start..end`.
    pub fn record(inout self, start: u64, end: u64, ty: u32) {
        self.rec_key.push((start << 32) | end);
        self.rec_ty.push(ty);
    }

    pub fn add_buffer(inout self, name: u32) {
        self.buffers.push(name);
    }

    fn recorded(in self, start: u32, end: u32) -> u32 {
        let key = (w64(start) << 32) | w64(end);
        let mut lo: u64 = 0;
        let mut hi = self.rec_key.len();
        loop {
            if lo >= hi {
                return NO_TY;
            }
            let mid = wrapping_add(lo, hi) >> 1;
            let entry = u64_at(in self.rec_key, mid);
            if entry == key {
                return u32_at(in self.rec_ty, mid);
            }
            if entry < key {
                lo = wrapping_add(mid, 1);
            } else {
                hi = mid;
            }
        }
    }

    fn lookup(in self, name: u32) -> u32 {
        let mut i = self.bind_names.len();
        loop {
            if i == 0 {
                return NO_TY;
            }
            i = wrapping_sub(i, 1);
            if u32_at(in self.bind_names, i) == name {
                return u32_at(in self.bind_tys, i);
            }
        }
    }

    fn push_binding(inout self, name: u32, ty: u32) {
        self.bind_names.push(name);
        self.bind_tys.push(if ty == NO_TY { OTHER } else { ty });
    }

    fn open(inout self) {
        self.marks.push(self.bind_names.len());
    }

    fn close(inout self) {
        let depth = self.marks.len();
        if depth == 0 {
            return;
        }
        let mark = u64_at(in self.marks, wrapping_sub(depth, 1));
        self.marks.truncate(wrapping_sub(depth, 1));
        self.bind_names.truncate(mark);
        self.bind_tys.truncate(mark);
    }

    fn is_buffer(in self, name: u32) -> bool {
        has32(in self.buffers, name)
    }

    fn find_adt(in self, name: u32) -> u32 {
        let mut i = self.adt_name.len();
        loop {
            if i == 0 {
                return NONE;
            }
            i = wrapping_sub(i, 1);
            if u32_at(in self.adt_name, i) == name {
                return u32_at(in self.adt_node, i);
            }
        }
    }

    fn find_effect(in self, name: u32) -> u32 {
        let mut i = self.eff_name.len();
        loop {
            if i == 0 {
                return NONE;
            }
            i = wrapping_sub(i, 1);
            if u32_at(in self.eff_name, i) == name {
                return u32_at(in self.eff_node, i);
            }
        }
    }
}

// ---------------------------------------------------------------- nodes

fn fn_at(in ast: Ast, i: u32) -> FnNode {
    ast.fns.get_or(
        idx_from_raw[FnNode](i),
        FnNode {
            name: NONE,
            fip: false,
            generics: 0,
            params: 0,
            result: NONE,
            effects: NONE,
            body: NONE,
            start: 0,
            end: 0
        }
    )
}

fn param_at(in ast: Ast, i: u32) -> ParamNode {
    ast.params.get_or(
        idx_from_raw[ParamNode](i),
        ParamNode { name: NONE, pass: 0, projections: 0, ty: NONE, start: 0, end: 0 }
    )
}

fn stmt_at(in ast: Ast, i: u32) -> StmtNode {
    ast.stmts.get_or(
        idx_from_raw[StmtNode](i),
        StmtNode { kind: 0, pat: NONE, ty: NONE, value: NONE, mutable: false }
    )
}

fn arg_at(in ast: Ast, i: u32) -> ArgNode {
    ast.args.get_or(idx_from_raw[ArgNode](i), ArgNode { pass: 0, explicit: false, expr: NONE })
}

fn clause_at(in ast: Ast, i: u32) -> ClauseNode {
    ast.clauses.get_or(idx_from_raw[ClauseNode](i), ClauseNode { name: NONE, pats: 0, body: NONE })
}

fn adt_at(in ast: Ast, i: u32) -> AdtNode {
    ast.adts.get_or(
        idx_from_raw[AdtNode](i),
        AdtNode {
            name: NONE,
            mode: 0,
            generics: 0,
            variants: 0,
            is_enum: false,
            tiled: false,
            tile_width: 0,
            start: 0,
            end: 0
        }
    )
}

fn variant_at(in ast: Ast, i: u32) -> VariantNode {
    ast.variants
        .get_or(idx_from_raw[VariantNode](i), VariantNode { name: NONE, fields: 0, named: false })
}

fn field_at(in ast: Ast, i: u32) -> FieldNode {
    ast.fields.get_or(
        idx_from_raw[FieldNode](i),
        FieldNode { name: NONE, ty: NONE, modality: 3, temperature: 0 }
    )
}

fn generic_name(in ast: Ast, i: u32) -> u32 {
    match ast.generics.get(idx_from_raw[GenericNode](i)) {
        Option::Some(g) => g.name,
        Option::None => NONE,
    }
}

fn effect_node(in ast: Ast, i: u32) -> EffectNode {
    ast.effect_nodes
        .get_or(idx_from_raw[EffectNode](i), EffectNode { label: NONE, name: NONE, args: 0 })
}

fn effect_decl(in ast: Ast, i: u32) -> EffectDeclNode {
    ast.effect_decls.get_or(
        idx_from_raw[EffectDeclNode](i),
        EffectDeclNode { name: NONE, linear: false, generics: 0, ops: 0, start: 0, end: 0 }
    )
}

// Whether symbol `sym` starts with `prefix`.
fn sym_starts(in ast: Ast, sym: u32, in prefix: Str) -> bool {
    if sym == NONE {
        return false;
    }
    let (lo, hi) = ast.names.span(symbol_from_id(sym));
    let prefix_bytes = prefix.as_bytes();
    if wrapping_sub(hi, lo) < prefix_bytes.len() {
        return false;
    }
    for i in 0..prefix_bytes.len() {
        let actual = ast.names.text_byte(wrapping_add(lo, i)).unwrap_or(0);
        let expected = prefix_bytes.try_get(i).unwrap_or(0);
        if actual != expected {
            return false;
        }
    }
    true
}

fn put_sym(in ast: Ast, inout out: ChunkSeq[u8], sym: u32) {
    if sym == NONE {
        return;
    }
    let (lo, hi) = ast.names.span(symbol_from_id(sym));
    for i in lo..hi {
        match ast.names.text_byte(i) {
            Option::Some(byte) => out.push(byte),
            Option::None => {}
        }
    }
}

fn put(inout out: ChunkSeq[u8], in text: Str) {
    out.extend(in text.as_bytes());
}

// ---------------------------------------------------------------- types

// The walk's type of AST type `ast_ty`.
fn from_ast(in ast: Ast, inout walk: W, ast_ty: u32) -> u32 {
    if ast_ty == NONE {
        return OTHER;
    }
    let node = type_at(in ast, ast_ty);
    let mut items: ChunkSeq[u32] = ChunkSeq::new[u32]();
    if node.kind == T_NAMED {
        for i in 0..list_len(in ast, node.b) {
            items.push(from_ast(in ast, inout walk, list_at(in ast, node.b, i)));
        }
        return walk.ty(TK_NAMED, node.a, in items);
    }
    if node.kind == T_TUPLE {
        for i in 0..list_len(in ast, node.a) {
            items.push(from_ast(in ast, inout walk, list_at(in ast, node.a, i)));
        }
        return walk.ty(TK_TUPLE, NONE, in items);
    }
    OTHER
}

// `ast::substitute` of `ty` with `names[i] := vals[i]`.
fn subst(inout walk: W, ty: u32, in names: ChunkSeq[u32], in vals: ChunkSeq[u32]) -> u32 {
    let kind = walk.kind(ty);
    if kind == TK_NAMED {
        let name = walk.name(ty);
        let count = walk.count(ty);
        if count == 0 {
            for i in 0..names.len() {
                if u32_at(in names, i) == name {
                    return u32_at(in vals, i);
                }
            }
            return ty;
        }
        let mut items: ChunkSeq[u32] = ChunkSeq::new[u32]();
        for i in 0..count {
            let item = walk.item(ty, i);
            items.push(subst(inout walk, item, in names, in vals));
        }
        return walk.ty(TK_NAMED, name, in items);
    }
    if kind == TK_TUPLE {
        let mut items: ChunkSeq[u32] = ChunkSeq::new[u32]();
        for i in 0..walk.count(ty) {
            let item = walk.item(ty, i);
            items.push(subst(inout walk, item, in names, in vals));
        }
        return walk.ty(TK_TUPLE, NONE, in items);
    }
    ty
}

// The generic names of a generics list, zipped with type `ty`'s arguments
// (`zip` stops at the shorter).
fn zip_vars(
    in ast: Ast,
    in walk: W,
    generics: u32,
    ty: u32,
    inout names: ChunkSeq[u32],
    inout vals: ChunkSeq[u32]
) {
    let generic_count = list_len(in ast, generics);
    let arg_count = walk.count(ty);
    let pair_count = if generic_count < arg_count {
        generic_count
    } else {
        arg_count
    };
    for i in 0..pair_count {
        names.push(generic_name(in ast, list_at(in ast, generics, i)));
        vals.push(walk.item(ty, i));
    }
}

// `Walk::field_type`: the type of field `field` of a value of type `ty`.
fn field_type(in ast: Ast, inout walk: W, ty: u32, field: u32) -> u32 {
    if walk.kind(ty) != TK_NAMED {
        return NO_TY;
    }
    let adt_index = walk.find_adt(walk.name(ty));
    if adt_index == NONE {
        return NO_TY;
    }
    let adt = adt_at(in ast, adt_index);
    if adt.is_enum || list_len(in ast, adt.variants) == 0 {
        return NO_TY;
    }
    let variant = variant_at(in ast, list_at(in ast, adt.variants, 0));
    for i in 0..list_len(in ast, variant.fields) {
        let field_def = field_at(in ast, list_at(in ast, variant.fields, i));
        if field_def.name == field {
            let mut names: ChunkSeq[u32] = ChunkSeq::new[u32]();
            let mut vals: ChunkSeq[u32] = ChunkSeq::new[u32]();
            zip_vars(in ast, in walk, adt.generics, ty, inout names, inout vals);
            let field_ty = from_ast(in ast, inout walk, field_def.ty);
            return subst(inout walk, field_ty, in names, in vals);
        }
    }
    NO_TY
}

// `Walk::payload`: the type of field `field` (position `i`) of constructor
// `cname` of a value of type `ty`.
fn payload(in ast: Ast, inout walk: W, ty: u32, cname: u32, field: u32, i: u64) -> u32 {
    if walk.kind(ty) != TK_NAMED {
        return NO_TY;
    }
    let name = walk.name(ty);
    if (name == walk.s_option && cname == walk.s_some)
        || (name == walk.s_result && cname == walk.s_ok) {
        return walk.item(ty, 0);
    }
    if name == walk.s_result && cname == walk.s_err {
        return walk.item(ty, 1);
    }
    let adt_index = walk.find_adt(name);
    if adt_index == NONE {
        return NO_TY;
    }
    let adt = adt_at(in ast, adt_index);
    let mut found = NONE;
    for k in 0..list_len(in ast, adt.variants) {
        let variant = variant_at(in ast, list_at(in ast, adt.variants, k));
        if variant.name == cname {
            found = list_at(in ast, adt.variants, k);
            break;
        }
    }
    if found == NONE {
        return NO_TY;
    }
    let variant = variant_at(in ast, found);
    let mut field_ast_ty = NONE;
    let mut have = false;
    for k in 0..list_len(in ast, variant.fields) {
        let field_def = field_at(in ast, list_at(in ast, variant.fields, k));
        if field_def.name == field {
            field_ast_ty = field_def.ty;
            have = true;
            break;
        }
    }
    if !have {
        if i >= list_len(in ast, variant.fields) {
            return NO_TY;
        }
        field_ast_ty = field_at(in ast, list_at(in ast, variant.fields, i)).ty;
    }
    let mut names: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut vals: ChunkSeq[u32] = ChunkSeq::new[u32]();
    zip_vars(in ast, in walk, adt.generics, ty, inout names, inout vals);
    let field_ty = from_ast(in ast, inout walk, field_ast_ty);
    subst(inout walk, field_ty, in names, in vals)
}

// `Walk::type_of`: the type of the place or value `expr_id`.
fn type_of(in ast: Ast, inout walk: W, expr_id: u32) -> u32 {
    if expr_id == NONE {
        return NO_TY;
    }
    let node = expr_at(in ast, expr_id);
    if node.kind == E_NAME {
        let ty = walk.lookup(node.a);
        if ty != NO_TY {
            return ty;
        }
        return walk.recorded(node.start, node.end);
    }
    if node.kind == E_FIELD {
        let base_ty = type_of(in ast, inout walk, node.a);
        if base_ty != NO_TY {
            let field_ty = field_type(in ast, inout walk, base_ty, node.b);
            if field_ty != NO_TY {
                return field_ty;
            }
        }
        return walk.recorded(node.start, node.end);
    }
    walk.recorded(node.start, node.end)
}

// `Walk::bind`: binds the names of pattern `pat_id`, which matches a value of
// type `ty`.
fn bind(in ast: Ast, inout walk: W, pat_id: u32, ty: u32) {
    if pat_id == NONE {
        return;
    }
    let node = pat_at(in ast, pat_id);
    if node.kind == P_BIND {
        walk.push_binding(node.a, ty);
    } else if node.kind == P_TUPLE {
        let count = list_len(in ast, node.a);
        let split = walk.kind(ty) == TK_TUPLE && walk.count(ty) == count;
        for i in 0..count {
            let item_ty = if split { walk.item(ty, i) } else { NO_TY };
            bind(in ast, inout walk, list_at(in ast, node.a, i), item_ty);
        }
    } else if node.kind == P_CONSTRUCTOR {
        let count = list_len(in ast, node.b) >> 1;
        for i in 0..count {
            let field = list_at(in ast, node.b, i << 1);
            let sub = list_at(in ast, node.b, wrapping_add(i << 1, 1));
            let field_ty = if ty == NO_TY {
                NO_TY
            } else {
                payload(in ast, inout walk, ty, node.a, field, i)
            };
            bind(in ast, inout walk, sub, field_ty);
        }
    }
}

// ---------------------------------------------------------------- buffers

// `Walk::buffer_of`: the buffer type name when `expr_id` is `b.data` of a pinned
// buffer or a mapping `b`, else NONE.
fn buffer_of(in ast: Ast, inout walk: W, expr_id: u32) -> u32 {
    if expr_id == NONE {
        return NONE;
    }
    let node = expr_at(in ast, expr_id);
    if node.kind != E_FIELD || node.b != walk.s_data {
        return NONE;
    }
    let ty = type_of(in ast, inout walk, node.a);
    if walk.kind(ty) == TK_NAMED && walk.is_buffer(walk.name(ty)) {
        return walk.name(ty);
    }
    NONE
}

// `Walk::view_of`: the buffer type name when `expr_id` is a view of foreign
// memory: `b.data`, `b.data[a..c]` or `b.data.as_slice()`.
fn view_of(in ast: Ast, inout walk: W, expr_id: u32) -> u32 {
    if expr_id == NONE {
        return NONE;
    }
    let node = expr_at(in ast, expr_id);
    if node.kind == E_FIELD {
        return buffer_of(in ast, inout walk, expr_id);
    }
    if node.kind == E_INDEX {
        let index_node = expr_at(in ast, node.b);
        if node.b != NONE && index_node.kind == E_BINARY && index_node.a == walk.s_range {
            return buffer_of(in ast, inout walk, node.a);
        }
        return NONE;
    }
    if node.kind == E_CALL {
        let callee = expr_at(in ast, node.a);
        if callee.kind == E_FIELD
            && (callee.b == walk.s_as_slice || callee.b == walk.s_as_slice_mut) {
            return buffer_of(in ast, inout walk, callee.a);
        }
    }
    NONE
}

// `keeps_buffer`: the `ChunkSeq` methods that neither reallocate, nor
// change the length, nor give the sequence away.
fn keeps_buffer(in ast: Ast, in walk: W, method: u32) -> bool {
    has32(in walk.keeps, method)
        || sym_starts(in ast, method, in "read_")
        || sym_starts(in ast, method, in "write_")
        || sym_starts(in ast, method, in "try_read_")
        || sym_starts(in ast, method, in "try_write_")
}

// `Walk::calls_foreign`: whether calling `callee` may perform `Ffi`.
fn calls_foreign(in ast: Ast, in walk: W, callee: u32) -> bool {
    if callee == NONE {
        return false;
    }
    let callee_node = expr_at(in ast, callee);
    if callee_node.kind == E_NAME {
        return sym_starts(in ast, callee_node.a, in "Ffi$")
            || has32(in walk.foreign, callee_node.a);
    }
    if callee_node.kind == E_FIELD {
        return has32(in walk.foreign, callee_node.b);
    }
    false
}

// The direct subexpressions of `expr_id` (`children`).
fn children(in ast: Ast, expr_id: u32, inout out: ChunkSeq[u32]) {
    if expr_id == NONE {
        return;
    }
    let node = expr_at(in ast, expr_id);
    let kind = node.kind;
    if kind == E_TUPLE {
        for i in 0..list_len(in ast, node.a) {
            out.push(list_at(in ast, node.a, i));
        }
    } else if kind == E_STRUCT {
        for i in 0..(list_len(in ast, node.b) >> 1) {
            out.push(list_at(in ast, node.b, wrapping_add(i << 1, 1)));
        }
    } else if kind == E_BLOCK {
        for i in 0..list_len(in ast, node.a) {
            out.push(stmt_at(in ast, list_at(in ast, node.a, i)).value);
        }
        if node.b != NONE {
            out.push(node.b);
        }
    } else if kind == E_CALL {
        out.push(node.a);
        for i in 0..list_len(in ast, node.c) {
            out.push(arg_at(in ast, list_at(in ast, node.c, i)).expr);
        }
    } else if kind == E_FIELD || kind == E_TRY {
        out.push(node.a);
    } else if kind == E_UNARY {
        out.push(node.b);
    } else if kind == E_INDEX {
        out.push(node.a);
        out.push(node.b);
    } else if kind == E_BINARY || kind == E_ASSIGN {
        out.push(node.b);
        out.push(node.c);
    } else if kind == E_IF {
        out.push(node.a);
        out.push(node.b);
        if node.c != NONE {
            out.push(node.c);
        }
    } else if kind == E_MATCH {
        out.push(node.a);
        for i in 0..(list_len(in ast, node.b) >> 1) {
            out.push(list_at(in ast, node.b, wrapping_add(i << 1, 1)));
        }
    } else if kind == E_CLOSURE {
        out.push(node.e);
    } else if kind == E_HANDLE {
        if node.b != NONE {
            out.push(node.c);
        }
        out.push(node.d);
        for i in 0..list_len(in ast, node.e) {
            out.push(clause_at(in ast, list_at(in ast, node.e, i)).body);
        }
    } else if kind == E_LOOP {
        out.push(node.a);
    } else if kind == E_FOR {
        out.push(node.b);
        out.push(node.c);
    } else if kind == E_RANGE {
        out.push(node.a);
        out.push(node.b);
    } else if kind == E_BREAK || kind == E_RETURN {
        if node.a != NONE {
            out.push(node.a);
        }
    }
}

// `Walk::may_call_foreign`: whether evaluating `expr_id` may call into C.
fn may_call_foreign(in ast: Ast, in walk: W, expr_id: u32) -> bool {
    if expr_id == NONE {
        return false;
    }
    let node = expr_at(in ast, expr_id);
    if node.kind == E_CALL && calls_foreign(in ast, in walk, node.a) {
        return true;
    }
    let mut kids: ChunkSeq[u32] = ChunkSeq::new[u32]();
    children(in ast, expr_id, inout kids);
    for i in 0..kids.len() {
        if may_call_foreign(in ast, in walk, u32_at(in kids, i)) {
            return true;
        }
    }
    false
}

fn refuse_view(in ast: Ast, inout walk: W, ty: u32, expr_id: u32, in why: Str) {
    if walk.has_err {
        return;
    }
    let node = expr_at(in ast, expr_id);
    walk.has_err = true;
    walk.err_start = node.start;
    walk.err_end = node.end;
    put(inout walk.msg, in "C may write the memory of ");
    put_sym(in ast, inout walk.msg, ty);
    put(inout walk.msg, in " during any foreign call, so a view of it ");
    put(inout walk.msg, in why);
    put(
        inout walk.msg,
        in ": read it through `.data[i]` after the call, or end the view before it"
    );
}

fn refuse(in ast: Ast, inout walk: W, ty: u32, expr_id: u32) {
    if walk.has_err {
        return;
    }
    let node = expr_at(in ast, expr_id);
    walk.has_err = true;
    walk.err_start = node.start;
    walk.err_end = node.end;
    put(inout walk.msg, in "the memory of ");
    put_sym(in ast, inout walk.msg, ty);
    put(
        inout walk.msg,
        in " stays where it is while C may hold its address: `.data` is used only as `.data[i]`, `.data[a..b]`, an `in` argument, or the receiver of a method that keeps its length (not growing, shrinking, moving or replacing it)"
    );
}

// ---------------------------------------------------------------- walk

// `Walk::expr`: `expr_id` in a position that may hold `b.data` when `ok`.
fn expr(in ast: Ast, inout walk: W, expr_id: u32, ok: bool) {
    if expr_id == NONE {
        return;
    }
    let buffer = buffer_of(in ast, inout walk, expr_id);
    let node = expr_at(in ast, expr_id);
    if buffer != NONE {
        if !ok {
            refuse(in ast, inout walk, buffer, expr_id);
        }
        if node.kind == E_FIELD {
            expr(in ast, inout walk, node.a, false);
        }
        return;
    }
    let kind = node.kind;
    if kind == E_TUPLE {
        for i in 0..list_len(in ast, node.a) {
            expr(in ast, inout walk, list_at(in ast, node.a, i), false);
        }
    } else if kind == E_STRUCT {
        for i in 0..(list_len(in ast, node.b) >> 1) {
            expr(in ast, inout walk, list_at(in ast, node.b, wrapping_add(i << 1, 1)), false);
        }
    } else if kind == E_BLOCK {
        walk.open();
        let stmt_count = list_len(in ast, node.a);
        for i in 0..stmt_count {
            let stmt = stmt_at(in ast, list_at(in ast, node.a, i));
            if stmt.kind == ST_LET {
                let view = view_of(in ast, inout walk, stmt.value);
                if view != NONE {
                    let mut found = NONE;
                    for j in wrapping_add(i, 1)..stmt_count {
                        let later = stmt_at(in ast, list_at(in ast, node.a, j)).value;
                        if may_call_foreign(in ast, in walk, later) {
                            found = later;
                            break;
                        }
                    }
                    if found == NONE
                        && node.b != NONE
                        && may_call_foreign(in ast, in walk, node.b) {
                        found = node.b;
                    }
                    if found != NONE {
                        refuse_view(
                            in ast,
                            inout walk,
                            view,
                            found,
                            in "may not stay bound across one"
                        );
                    }
                }
                expr(in ast, inout walk, stmt.value, false);
                let infer = stmt.ty == NONE || type_at(in ast, stmt.ty).kind == T_INFER;
                let ty = if infer {
                    type_of(in ast, inout walk, stmt.value)
                } else {
                    from_ast(in ast, inout walk, stmt.ty)
                };
                bind(in ast, inout walk, stmt.pat, ty);
            } else {
                expr(in ast, inout walk, stmt.value, false);
            }
        }
        if node.b != NONE {
            expr(in ast, inout walk, node.b, false);
        }
        walk.close();
    } else if kind == E_CALL {
        let callee = expr_at(in ast, node.a);
        if callee.kind == E_FIELD {
            let keep = keeps_buffer(in ast, in walk, callee.b);
            expr(in ast, inout walk, callee.a, keep);
        } else {
            expr(in ast, inout walk, node.a, false);
        }
        let import = callee.kind == E_NAME && sym_starts(in ast, callee.a, in "Ffi$");
        if !import && calls_foreign(in ast, in walk, node.a) {
            for i in 0..list_len(in ast, node.c) {
                let arg = arg_at(in ast, list_at(in ast, node.c, i));
                let view = view_of(in ast, inout walk, arg.expr);
                if view != NONE {
                    refuse_view(
                        in ast,
                        inout walk,
                        view,
                        arg.expr,
                        in "may not be lent to a function that may call into C"
                    );
                }
            }
        }
        for i in 0..list_len(in ast, node.c) {
            let arg = arg_at(in ast, list_at(in ast, node.c, i));
            expr(in ast, inout walk, arg.expr, arg.explicit && arg.pass == PASS_IN);
        }
    } else if kind == E_FIELD || kind == E_TRY {
        expr(in ast, inout walk, node.a, false);
    } else if kind == E_UNARY {
        expr(in ast, inout walk, node.b, false);
    } else if kind == E_INDEX {
        expr(in ast, inout walk, node.a, true);
        expr(in ast, inout walk, node.b, false);
    } else if kind == E_BINARY || kind == E_ASSIGN {
        expr(in ast, inout walk, node.b, false);
        expr(in ast, inout walk, node.c, false);
    } else if kind == E_IF {
        expr(in ast, inout walk, node.a, false);
        expr(in ast, inout walk, node.b, false);
        if node.c != NONE {
            expr(in ast, inout walk, node.c, false);
        }
    } else if kind == E_MATCH {
        expr(in ast, inout walk, node.a, false);
        let ty = type_of(in ast, inout walk, node.a);
        for i in 0..(list_len(in ast, node.b) >> 1) {
            walk.open();
            bind(in ast, inout walk, list_at(in ast, node.b, i << 1), ty);
            expr(in ast, inout walk, list_at(in ast, node.b, wrapping_add(i << 1, 1)), false);
            walk.close();
        }
    } else if kind == E_CLOSURE {
        walk.open();
        for i in 0..list_len(in ast, node.a) {
            let param = param_at(in ast, list_at(in ast, node.a, i));
            let ty = from_ast(in ast, inout walk, param.ty);
            walk.push_binding(param.name, ty);
        }
        expr(in ast, inout walk, node.e, false);
        walk.close();
    } else if kind == E_HANDLE {
        handle(in ast, inout walk, expr_id);
    } else if kind == E_FOR {
        expr(in ast, inout walk, node.b, false);
        walk.open();
        bind(in ast, inout walk, node.a, NO_TY);
        expr(in ast, inout walk, node.c, false);
        walk.close();
    } else if kind == E_LOOP {
        expr(in ast, inout walk, node.a, false);
    } else if kind == E_RANGE {
        expr(in ast, inout walk, node.a, false);
        expr(in ast, inout walk, node.b, false);
    } else if kind == E_BREAK || kind == E_RETURN {
        expr(in ast, inout walk, node.a, false);
    }
}

// A `handle` expression: the clause patterns are typed as the checker types
// them: the return clause binds the body's value (with the state after
// it), and an operation clause binds the operation's arguments, then the
// state, then the continuation.
fn handle(in ast: Ast, inout walk: W, expr_id: u32) {
    let node = expr_at(in ast, expr_id);
    let has_state = node.b != NONE;
    let mut state_ty = NO_TY;
    if has_state {
        expr(in ast, inout walk, node.c, false);
        state_ty = type_of(in ast, inout walk, node.c);
    }
    expr(in ast, inout walk, node.d, false);
    let body_ty = type_of(in ast, inout walk, node.d);
    let ret_ty = if has_state {
        if body_ty != NO_TY && state_ty != NO_TY {
            let mut items: ChunkSeq[u32] = ChunkSeq::new[u32]();
            items.push(body_ty);
            items.push(state_ty);
            walk.ty(TK_TUPLE, NONE, in items)
        } else {
            NO_TY
        }
    } else {
        body_ty
    };
    let clause_count = list_len(in ast, node.e);
    if clause_count > 0 {
        let return_clause = clause_at(in ast, list_at(in ast, node.e, 0));
        walk.open();
        for i in 0..list_len(in ast, return_clause.pats) {
            let ty = if i == 0 { ret_ty } else { NO_TY };
            bind(in ast, inout walk, list_at(in ast, return_clause.pats, i), ty);
        }
        expr(in ast, inout walk, return_clause.body, false);
        walk.close();
    }
    let eff = effect_node(in ast, node.a);
    let decl_index = walk.find_effect(eff.name);
    let mut names: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut vals: ChunkSeq[u32] = ChunkSeq::new[u32]();
    if decl_index != NONE {
        let decl = effect_decl(in ast, decl_index);
        let generic_count = list_len(in ast, decl.generics);
        let arg_count = list_len(in ast, eff.args);
        let pair_count = if generic_count < arg_count {
            generic_count
        } else {
            arg_count
        };
        for i in 0..pair_count {
            names.push(generic_name(in ast, list_at(in ast, decl.generics, i)));
            let ty = from_ast(in ast, inout walk, list_at(in ast, eff.args, i));
            vals.push(ty);
        }
    }
    for ci in 1..clause_count {
        let clause = clause_at(in ast, list_at(in ast, node.e, ci));
        // The operation's parameter types, then the state's.
        let mut tys: ChunkSeq[u32] = ChunkSeq::new[u32]();
        if decl_index != NONE {
            let decl = effect_decl(in ast, decl_index);
            for j in 0..list_len(in ast, decl.ops) {
                let op = fn_at(in ast, list_at(in ast, decl.ops, j));
                if op.name == clause.name {
                    for param_index in 0..list_len(in ast, op.params) {
                        let param = param_at(in ast, list_at(in ast, op.params, param_index));
                        let param_ty = from_ast(in ast, inout walk, param.ty);
                        tys.push(subst(inout walk, param_ty, in names, in vals));
                    }
                    break;
                }
            }
        }
        if has_state {
            tys.push(state_ty);
        }
        walk.open();
        for i in 0..list_len(in ast, clause.pats) {
            let ty = u32_at(in tys, i);
            bind(in ast, inout walk, list_at(in ast, clause.pats, i), ty);
        }
        expr(in ast, inout walk, clause.body, false);
        walk.close();
    }
}

// `may_perform_foreign`: whether a function with row `row_id` may call into C:
// the row names `Ffi` (before or after the rewrite) or is open.
fn may_perform_foreign(in ast: Ast, in walk: W, row_id: u32) -> bool {
    if row_id == NONE {
        return false;
    }
    let row = match ast.effects.get(idx_from_raw[EffectsNode](row_id)) {
        Option::Some(x) => x,
        Option::None => return false,
    };
    if row.tail != NONE {
        return true;
    }
    for i in 0..list_len(in ast, row.instances) {
        let effect = effect_node(in ast, list_at(in ast, row.instances, i));
        if effect.name == walk.s_ffi || sym_starts(in ast, effect.name, in "Ffi$") {
            return true;
        }
    }
    false
}

fn walk_function(in ast: Ast, inout walk: W, fi: u32) {
    let func = fn_at(in ast, fi);
    if func.body == NONE {
        return;
    }
    walk.open();
    for i in 0..list_len(in ast, func.params) {
        let param = param_at(in ast, list_at(in ast, func.params, i));
        let ty = from_ast(in ast, inout walk, param.ty);
        walk.push_binding(param.name, ty);
    }
    expr(in ast, inout walk, func.body, false);
    walk.close();
}

fn item_at(in ast: Ast, i: u64) -> ItemNode {
    let item_id = ast.m_items.try_get(i).unwrap_or(NONE);
    ast.items.get_or(idx_from_raw[ItemNode](item_id), ItemNode { kind: 0, node: NONE })
}

// The methods list of impl or conformance item `item`, or 0 (the empty
// list).
fn methods_of(in ast: Ast, item: ItemNode) -> u32 {
    if item.kind == I_IMPL {
        return match ast.impls.get(idx_from_raw[ImplNode](item.node)) {
            Option::Some(m) => m.methods,
            Option::None => 0,
        };
    }
    if item.kind == I_CONF {
        return match ast.confs.get(idx_from_raw[ConfNode](item.node)) {
            Option::Some(c) => c.methods,
            Option::None => 0,
        };
    }
    0
}

// `buffers::check`: refuses every use of a pinned buffer's or a mapping's
// `.data` that could move its memory. Returns whether it refused one (the
// message and span are in `walk`).
pub fn check_buffers(in ast: Ast, inout walk: W) -> bool {
    if walk.buffers.len() == 0 {
        return false;
    }
    for i in 0..ast.m_items.len() {
        let item = item_at(in ast, i);
        if item.kind == I_ADT {
            walk.adt_name.push(adt_at(in ast, item.node).name);
            walk.adt_node.push(item.node);
        } else if item.kind == I_EFFECT {
            walk.eff_name.push(effect_decl(in ast, item.node).name);
            walk.eff_node.push(item.node);
        } else if item.kind == I_FN {
            let func = fn_at(in ast, item.node);
            if may_perform_foreign(in ast, in walk, func.effects) {
                walk.foreign.push(func.name);
            }
        } else if item.kind == I_IMPL || item.kind == I_CONF {
            let methods = methods_of(in ast, item);
            for j in 0..list_len(in ast, methods) {
                let func = fn_at(in ast, list_at(in ast, methods, j));
                if may_perform_foreign(in ast, in walk, func.effects) {
                    walk.foreign.push(func.name);
                }
            }
        }
    }
    for i in 0..ast.m_items.len() {
        let item = item_at(in ast, i);
        if item.kind == I_FN {
            walk_function(in ast, inout walk, item.node);
        } else if item.kind == I_IMPL || item.kind == I_CONF {
            let methods = methods_of(in ast, item);
            for j in 0..list_len(in ast, methods) {
                walk_function(in ast, inout walk, list_at(in ast, methods, j));
            }
        }
    }
    walk.has_err
}
