// @vesper/check-tensor-types: the checker half of src/tensor_types (shape
// inference, kinds, dimensions) in Vesper (self-hosting wave SH2, lane 14,
// #1186). Rust stays the default checker; nothing here replaces Rust code.
//
// The entry `check_tensor_types` takes one `in Str` input from
// tests/self_host_check_tensor_types.rs: the source text, the wire
// diagnostics and the checked wires of `tensor_types::wire::check` (the
// Bridge layout checker stays in Rust). It parses the source with
// @vesper/ast and returns the report text (`pack_text`) the Rust side
// prints from `tensor_types::active` and `tensor_types::analyze`.

use @vesper/ast::{Ast};
use @vesper/ast::lower::{lower_source};
use @vesper/check-data::input::{Reader};
use @vesper/check-data::{pack_text};
use @vesper/check-data::util::{push_decimal, add, inc, n32, u32_at, u64_at, u8_at, w};
use @vesper-std/intern::{symbol_from_id};
use self::state::{
    St,
    st_new,
    put,
    put_dim,
    put_ty,
    cmp_names,
};
use self::kinds::{
    Cx,
    Ob,
    cx_new,
    active,
    set32,
    at32,
};
use self::infer::{
    analyze,
};
use self::ast_input::{read_ast};
use self::elaborate::{elaborate_report};

const NONE: u32 = 4294967295;

// Reads a length-prefixed byte string into `out`.
fn read_bytes(inout reader: Reader, in bytes: Slice[u8], inout out: ChunkSeq[u8]) {
    let n = reader.word(in bytes);
    let start = reader.pos;
    for i in 0..n {
        let byte = match bytes.try_get(wrapping_add(start, i)) {
            Option::Some(v) => v,
            Option::None => 0,
        };
        out.push(byte);
    }
    reader.pos = wrapping_add(start, wrapping_mul(wrapping_add(n, 7) / 8, 8));
}

fn put_kind(inout out: ChunkSeq[u8], kind: u8) {
    if kind == 0 {
        put(inout out, in "Dim");
    } else if kind == 1 {
        put(inout out, in "DType");
    } else {
        put(inout out, in "Type");
    }
}

// Sorts distinct names by their bytes.
fn sort_names(in state: St, inout names: ChunkSeq[u32]) {
    let n = names.len();
    for i in 1..n {
        let name = u32_at(in names, i);
        let mut j = i;
        loop {
            if j == 0 {
                break;
            }
            let prev = u32_at(in names, wrapping_sub(j, 1));
            if cmp_names(in state, prev, name) <= 0 {
                break;
            }
            let ok = names.try_set(j, prev);
            j = wrapping_sub(j, 1);
        }
        let ok2 = names.try_set(j, name);
    }
}

fn contains(in list: ChunkSeq[u32], value: u32) -> bool {
    for i in 0..list.len() {
        if u32_at(in list, i) == value {
            return true;
        }
    }
    false
}

fn put_ob(in state: St, inout out: ChunkSeq[u8], ob: Ob) {
    state.names.write(ob.reason, inout out);
    put(inout out, in ": ");
    if ob.kind == 0 {
        put_dim(in state, inout out, ob.dim);
        put(inout out, in " must be even");
    } else {
        put_dim(in state, inout out, ob.multiple);
        put(inout out, in " must be a multiple of ");
        put_dim(in state, inout out, ob.dim);
    }
}

// The report: `inactive`, or `active` then one `D` line per diagnostic,
// one `K` line per ADT's kinds and one `S` block per signature (sorted by
// name, as Rust's `BTreeMap`s iterate).
fn report(in state: St, in ctx: Cx, inout out: ChunkSeq[u8]) {
    put(inout out, in "active\n");
    for i in 0.. state.diag_codes.len() {
        put(inout out, in "D E0");
        push_decimal(inout out, widen_u64(u32_at(in state.diag_codes, i)));
        put(inout out, in " @");
        push_decimal(inout out, u64_at(in state.diag_starts, i));
        put(inout out, in "..");
        push_decimal(inout out, u64_at(in state.diag_ends, i));
        out.push(32);
        let text_start = u64_at(in state.diag_msg_starts, i);
        let text_end = u64_at(in state.diag_msg_ends, i);
        for k in text_start..text_end {
            out.push(u8_at(in state.diag_text, k));
        }
        out.push(10);
    }
    let mut names = ChunkSeq::new[u32]();
    for i in 0..ctx.adt_kind_rows.len() {
        if u32_at(in ctx.adt_kind_rows, i) != NONE {
            names.push(wrapping_u32(i));
        }
    }
    sort_names(in state, inout names);
    for i in 0..names.len() {
        let name = u32_at(in names, i);
        let row = at32(in ctx.adt_kind_rows, name);
        put(inout out, in "K ");
        state.names.write(name, inout out);
        for k in 0..widen_u64(u32_at(in ctx.adt_kind_counts, widen_u64(row))) {
            out.push(32);
            put_kind(
                inout out,
                u8_at(
                    in ctx.adt_kind_values,
                    wrapping_add(widen_u64(u32_at(in ctx.adt_kind_starts, widen_u64(row))), k)
                )
            );
        }
        out.push(10);
    }
    let mut sigs = ChunkSeq::new[u32]();
    for i in 0..ctx.sig_rows.len() {
        if u32_at(in ctx.sig_rows, i) != NONE {
            sigs.push(wrapping_u32(i));
        }
    }
    sort_names(in state, inout sigs);
    for i in 0..sigs.len() {
        let name = u32_at(in sigs, i);
        let row = widen_u64(at32(in ctx.sig_rows, name));
        put(inout out, in "S ");
        state.names.write(name, inout out);
        out.push(10);
        let generics_start = widen_u64(u32_at(in ctx.sig_generic_starts, row));
        for generic_idx in 0..widen_u64(u32_at(in ctx.sig_generic_counts, row)) {
            put(inout out, in " G ");
            state.names.write(
                u32_at(in ctx.sig_generic_names, wrapping_add(generics_start, generic_idx)),
                inout out
            );
            out.push(32);
            put_kind(
                inout out,
                u8_at(in ctx.sig_generic_kinds, wrapping_add(generics_start, generic_idx))
            );
            out.push(10);
        }
        let params_start = widen_u64(u32_at(in ctx.sig_param_starts, row));
        for param_idx in 0..widen_u64(u32_at(in ctx.sig_param_counts, row)) {
            let pass = u8_at(in ctx.sig_param_passes, wrapping_add(params_start, param_idx));
            if pass == 0 {
                put(inout out, in " P In ");
            } else if pass == 1 {
                put(inout out, in " P Inout ");
            } else {
                put(inout out, in " P Sink ");
            }
            put_ty(
                in state,
                inout out,
                u32_at(in ctx.sig_param_tys, wrapping_add(params_start, param_idx))
            );
            out.push(10);
        }
        put(inout out, in " R ");
        put_ty(in state, inout out, u32_at(in ctx.sig_results, row));
        out.push(10);
        if u8_at(in ctx.sig_uses_pool, row) == 1 {
            put(inout out, in " L ");
            put_dim(in state, inout out, u32_at(in ctx.sig_kv_heads, row));
            put(inout out, in ", ");
            put_dim(in state, inout out, u32_at(in ctx.sig_head_dims, row));
            out.push(10);
        }
        let obs_start = widen_u64(u32_at(in ctx.sig_ob_starts, row));
        for k in 0..widen_u64(u32_at(in ctx.sig_ob_counts, row)) {
            let ob = match ctx.obs.try_get(wrapping_add(obs_start, k)) {
                Option::Some(entry) => entry,
                Option::None => Ob { kind: 0, dim: 0, multiple: 0, reason: 0 },
            };
            put(inout out, in " O ");
            put_ob(in state, inout out, ob);
            out.push(10);
        }
    }
}

// Interns every AST symbol into the checker's names (`St.ast_names`).
fn map_names(inout state: St, in ast: Ast) {
    for i in 0..ast.names.len() {
        let mut text = String::new();
        let ok = ast.names.resolve_into(symbol_from_id(wrapping_u32(i)), inout text);
        let name = state.names.intern(in text.as_bytes());
        state.ast_names.push(name);
    }
}

fn setup_and_analyze(in input: Str) -> (bool, St, Cx, Ast) {
    let bytes = input.as_bytes();
    let mut reader = Reader { pos: 0 };
    let source_len = reader.word(in bytes);
    let lowered = lower_source(in input[8..wrapping_add(8, source_len)]);
    reader.pos = wrapping_add(8, wrapping_mul(wrapping_add(source_len, 7) / 8, 8));
    let mut state = st_new();
    map_names(inout state, in lowered.ast);
    let mut ctx = cx_new(inout state);
    if !active(inout state, in lowered.ast) {
        return (false, state, ctx, lowered.ast);
    }
    let diag_count = reader.word(in bytes);
    for i in 0..diag_count {
        let code = reader.word(in bytes);
        let start = reader.word(in bytes);
        let end = reader.word(in bytes);
        let mut message = ChunkSeq::new[u8]();
        read_bytes(inout reader, in bytes, inout message);
        state.diag_codes.push(wrapping_u32(code));
        state.diag_starts.push(start);
        state.diag_ends.push(end);
        state.diag_msg_starts.push(state.diag_text.len());
        state.diag_text.extend(in message.as_slice());
        state.diag_msg_ends.push(state.diag_text.len());
    }
    let wire_count = reader.word(in bytes);
    for i in 0..wire_count {
        let mut name = ChunkSeq::new[u8]();
        read_bytes(inout reader, in bytes, inout name);
        let wire_name = state.names.intern(in name.as_slice());
        let has_format = reader.word(in bytes);
        let mut message = ChunkSeq::new[u8]();
        read_bytes(inout reader, in bytes, inout message);
        if has_format == 1 {
            set32(inout ctx.wire_status, wire_name, 1);
        } else {
            let row = wrapping_u32(ctx.wire_msg_starts.len());
            ctx.wire_msg_starts.push(ctx.wire_text.len());
            ctx.wire_text.extend(in message.as_slice());
            ctx.wire_msg_ends.push(ctx.wire_text.len());
            set32(inout ctx.wire_status, wire_name, wrapping_add(row, 2));
        }
    }
    analyze(inout state, inout ctx, in lowered.ast);
    (true, state, ctx, lowered.ast)
}

// Input words: the source (length, bytes); the wire diagnostics (count,
// then code number, start, end, message); the checked wires (count, then
// name, has-format flag, mismatch message).
pub fn check_tensor_types(in input: Str) -> ChunkSeq[u64] {
    let (is_active, state, ctx, _ast) = setup_and_analyze(in input);
    let mut out = ChunkSeq::new[u8]();
    if !is_active {
        put(inout out, in "inactive\n");
        return pack_text(in out);
    }
    report(in state, in ctx, inout out);
    pack_text(in out)
}

pub fn check_tensor_types_elaborate(in input: Str) -> ChunkSeq[u64] {
    let (is_active, state, ctx, ast) = setup_and_analyze(in input);
    if !is_active {
        let mut out = ChunkSeq::new[u8]();
        put(inout out, in "inactive\n");
        return pack_text(in out);
    }
    let out = elaborate_report(in state, in ctx, in ast);
    pack_text(in out)
}

pub fn check_tensor_types_diags_bytes(in names: Str, in bytes: Slice[u8]) -> ChunkSeq[u64] {
    let mut reader = Reader { pos: 0 };
    let ast = read_ast(in names, inout reader, in bytes);
    let mut state = st_new();
    map_names(inout state, in ast);
    let mut ctx = cx_new(inout state);
    let mut out = ChunkSeq::new[u64]();
    if !active(inout state, in ast) {
        out.push(0);
        return out;
    }
    let diag_count = reader.word(in bytes);
    for _ in 0..diag_count {
        let code = reader.word(in bytes);
        let start = reader.word(in bytes);
        let end = reader.word(in bytes);
        let mut message = ChunkSeq::new[u8]();
        read_bytes(inout reader, in bytes, inout message);
        state.diag_codes.push(wrapping_u32(code));
        state.diag_starts.push(start);
        state.diag_ends.push(end);
        state.diag_msg_starts.push(state.diag_text.len());
        state.diag_text.extend(in message.as_slice());
        state.diag_msg_ends.push(state.diag_text.len());
    }
    let wire_count = reader.word(in bytes);
    for _ in 0..wire_count {
        let mut name = ChunkSeq::new[u8]();
        read_bytes(inout reader, in bytes, inout name);
        let wire_name = state.names.intern(in name.as_slice());
        let has_format = reader.word(in bytes);
        let mut message = ChunkSeq::new[u8]();
        read_bytes(inout reader, in bytes, inout message);
        if has_format == 1 {
            set32(inout ctx.wire_status, wire_name, 1);
        } else {
            let row = wrapping_u32(ctx.wire_msg_starts.len());
            ctx.wire_msg_starts.push(ctx.wire_text.len());
            ctx.wire_text.extend(in message.as_slice());
            ctx.wire_msg_ends.push(ctx.wire_text.len());
            set32(inout ctx.wire_status, wire_name, wrapping_add(row, 2));
        }
    }
    analyze(inout state, inout ctx, in ast);
    out.push(1);
    let n = state.diag_codes.len();
    out.push(n);
    for i in 0..n {
        out.push(widen_u64(u32_at(in state.diag_codes, i)));
        out.push(u64_at(in state.diag_starts, i));
        out.push(u64_at(in state.diag_ends, i));
        let msg_start = u64_at(in state.diag_msg_starts, i);
        let msg_end = u64_at(in state.diag_msg_ends, i);
        let mut msg_text = ChunkSeq::with_capacity[u8](wrapping_sub(msg_end, msg_start));
        for k in msg_start..msg_end {
            msg_text.push(u8_at(in state.diag_text, k));
        }
        let packed = pack_text(in msg_text);
        out.extend(in packed.as_slice());
    }
    out
}
