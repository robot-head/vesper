// @vesper/check-tensor-types: the checker half of src/tensor_types (shape
// inference, kinds, dimensions) in Vesper (self-hosting wave SH2, lane 14,
// #1186). Rust stays the default checker; nothing here replaces Rust code.
//
// The entry `check_tensor_types` takes one `in Str` input from
// tests/self_host_check_tensor_types.rs: the source text, the wire
// diagnostics and the checked wires of `tensor_types::wire::check` (the
// Bridge layout checker stays in Rust). It parses the source with
// @vesper/ast and returns the report text (`pack_text`) the Rust side
// prints from `tensor_types::active` and `tensor_types::analyze`.

use @vesper/ast::{Ast};
use @vesper/ast::lower::{lower_source};
use @vesper/check-data::input::{Reader};
use @vesper/check-data::{pack_text};
use @vesper/check-data::util::{push_decimal, add, inc, n32, u32_at, u64_at, u8_at, w};
use @vesper-std/intern::{symbol_from_id};
use self::state::{
    St,
    st_new,
    put,
    put_dim,
    put_ty,
    cmp_names,
};
use self::kinds::{
    Cx,
    Ob,
    cx_new,
    active,
    set32,
    at32,
};
use self::infer::{
    analyze,
};
use self::ast_input::{read_ast};
use self::elaborate::{elaborate_report};

const NONE: u32 = 4294967295;

// Reads a length-prefixed byte string into `out`.
fn read_bytes(inout reader: Reader, in bytes: Slice[u8], inout out: ChunkSeq[u8]) {
    let n = reader.word(in bytes);
    let start = reader.pos;
    for i in 0..n {
        let byte = match bytes.try_get(wrapping_add(start, i)) {
            Option::Some(v) => v,
            Option::None => 0,
        };
        out.push(byte);
    }
    reader.pos = wrapping_add(start, wrapping_mul(wrapping_add(n, 7) / 8, 8));
}

fn put_kind(inout o: ChunkSeq[u8], kind: u8) {
    if kind == 0 {
        put(inout o, in "Dim");
    } else if kind == 1 {
        put(inout o, in "DType");
    } else {
        put(inout o, in "Type");
    }
}

// Sorts distinct names by their bytes.
fn sort_names(in st: St, inout names: ChunkSeq[u32]) {
    let n = names.len();
    for i in 1..n {
        let name = u32_at(in names, i);
        let mut j = i;
        loop {
            if j == 0 {
                break;
            }
            let prev = u32_at(in names, wrapping_sub(j, 1));
            if cmp_names(in st, prev, name) <= 0 {
                break;
            }
            let ok = names.try_set(j, prev);
            j = wrapping_sub(j, 1);
        }
        let ok2 = names.try_set(j, name);
    }
}

fn contains(in list: ChunkSeq[u32], value: u32) -> bool {
    for i in 0..list.len() {
        if u32_at(in list, i) == value {
            return true;
        }
    }
    false
}

fn put_ob(in st: St, inout o: ChunkSeq[u8], ob: Ob) {
    st.names.write(ob.r, inout o);
    put(inout o, in ": ");
    if ob.k == 0 {
        put_dim(in st, inout o, ob.d1);
        put(inout o, in " must be even");
    } else {
        put_dim(in st, inout o, ob.d2);
        put(inout o, in " must be a multiple of ");
        put_dim(in st, inout o, ob.d1);
    }
}

// The report: `inactive`, or `active` then one `D` line per diagnostic,
// one `K` line per ADT's kinds and one `S` block per signature (sorted by
// name, as Rust's `BTreeMap`s iterate).
fn report(in st: St, in cx: Cx, inout o: ChunkSeq[u8]) {
    put(inout o, in "active\n");
    for i in 0..st.dcode.len() {
        put(inout o, in "D E0");
        push_decimal(inout o, widen_u64(u32_at(in st.dcode, i)));
        put(inout o, in " @");
        push_decimal(inout o, u64_at(in st.dstart, i));
        put(inout o, in "..");
        push_decimal(inout o, u64_at(in st.dend, i));
        o.push(32);
        let text_start = u64_at(in st.dma, i);
        let text_end = u64_at(in st.dmb, i);
        for k in text_start..text_end {
            o.push(u8_at(in st.dtext, k));
        }
        o.push(10);
    }
    let mut names = ChunkSeq::new[u32]();
    for i in 0..cx.ak_row.len() {
        if u32_at(in cx.ak_row, i) != NONE {
            names.push(wrapping_u32(i));
        }
    }
    sort_names(in st, inout names);
    for i in 0..names.len() {
        let name = u32_at(in names, i);
        let row = at32(in cx.ak_row, name);
        put(inout o, in "K ");
        st.names.write(name, inout o);
        for k in 0..widen_u64(u32_at(in cx.ak_n, widen_u64(row))) {
            o.push(32);
            put_kind(
                inout o,
                u8_at(in cx.ak_k, wrapping_add(widen_u64(u32_at(in cx.ak_a, widen_u64(row))), k))
            );
        }
        o.push(10);
    }
    let mut sigs = ChunkSeq::new[u32]();
    for i in 0..cx.sg_row.len() {
        if u32_at(in cx.sg_row, i) != NONE {
            sigs.push(wrapping_u32(i));
        }
    }
    sort_names(in st, inout sigs);
    for i in 0..sigs.len() {
        let name = u32_at(in sigs, i);
        let row = widen_u64(at32(in cx.sg_row, name));
        put(inout o, in "S ");
        st.names.write(name, inout o);
        o.push(10);
        let generics_start = widen_u64(u32_at(in cx.sg_ga, row));
        for generic_idx in 0..widen_u64(u32_at(in cx.sg_gn, row)) {
            put(inout o, in " G ");
            st.names
                .write(u32_at(in cx.sg_gsym, wrapping_add(generics_start, generic_idx)), inout o);
            o.push(32);
            put_kind(inout o, u8_at(in cx.sg_gkind, wrapping_add(generics_start, generic_idx)));
            o.push(10);
        }
        let params_start = widen_u64(u32_at(in cx.sg_pa, row));
        for param_idx in 0..widen_u64(u32_at(in cx.sg_pn, row)) {
            let pass = u8_at(in cx.sg_ppass, wrapping_add(params_start, param_idx));
            if pass == 0 {
                put(inout o, in " P In ");
            } else if pass == 1 {
                put(inout o, in " P Inout ");
            } else {
                put(inout o, in " P Sink ");
            }
            put_ty(in st, inout o, u32_at(in cx.sg_pty, wrapping_add(params_start, param_idx)));
            o.push(10);
        }
        put(inout o, in " R ");
        put_ty(in st, inout o, u32_at(in cx.sg_res, row));
        o.push(10);
        if u8_at(in cx.sg_pool, row) == 1 {
            put(inout o, in " L ");
            put_dim(in st, inout o, u32_at(in cx.sg_kv, row));
            put(inout o, in ", ");
            put_dim(in st, inout o, u32_at(in cx.sg_hd, row));
            o.push(10);
        }
        let obs_start = widen_u64(u32_at(in cx.sg_oa, row));
        for k in 0..widen_u64(u32_at(in cx.sg_on, row)) {
            let ob = match cx.obs.try_get(wrapping_add(obs_start, k)) {
                Option::Some(x) => x,
                Option::None => Ob { k: 0, d1: 0, d2: 0, r: 0 },
            };
            put(inout o, in " O ");
            put_ob(in st, inout o, ob);
            o.push(10);
        }
    }
}

// Interns every AST symbol into the checker's names (`St.amap`).
fn map_names(inout st: St, in a: Ast) {
    for i in 0..a.names.len() {
        let mut text = String::new();
        let ok = a.names.resolve_into(symbol_from_id(wrapping_u32(i)), inout text);
        let name = st.names.intern(in text.as_bytes());
        st.amap.push(name);
    }
}

fn setup_and_analyze(in input: Str) -> (bool, St, Cx, Ast) {
    let bytes = input.as_bytes();
    let mut reader = Reader { pos: 0 };
    let source_len = reader.word(in bytes);
    let lowered = lower_source(in input[8..wrapping_add(8, source_len)]);
    reader.pos = wrapping_add(8, wrapping_mul(wrapping_add(source_len, 7) / 8, 8));
    let mut st = st_new();
    map_names(inout st, in lowered.ast);
    let mut cx = cx_new(inout st);
    if !active(inout st, in lowered.ast) {
        return (false, st, cx, lowered.ast);
    }
    let diag_count = reader.word(in bytes);
    for i in 0..diag_count {
        let code = reader.word(in bytes);
        let start = reader.word(in bytes);
        let end = reader.word(in bytes);
        let mut message = ChunkSeq::new[u8]();
        read_bytes(inout reader, in bytes, inout message);
        st.dcode.push(wrapping_u32(code));
        st.dstart.push(start);
        st.dend.push(end);
        st.dma.push(st.dtext.len());
        st.dtext.extend(in message.as_slice());
        st.dmb.push(st.dtext.len());
    }
    let wire_count = reader.word(in bytes);
    for i in 0..wire_count {
        let mut name = ChunkSeq::new[u8]();
        read_bytes(inout reader, in bytes, inout name);
        let wire_name = st.names.intern(in name.as_slice());
        let has = reader.word(in bytes);
        let mut message = ChunkSeq::new[u8]();
        read_bytes(inout reader, in bytes, inout message);
        if has == 1 {
            set32(inout cx.wire, wire_name, 1);
        } else {
            let row = wrapping_u32(cx.wa.len());
            cx.wa.push(cx.wtext.len());
            cx.wtext.extend(in message.as_slice());
            cx.wb.push(cx.wtext.len());
            set32(inout cx.wire, wire_name, wrapping_add(row, 2));
        }
    }
    analyze(inout st, inout cx, in lowered.ast);
    (true, st, cx, lowered.ast)
}

// Input words: the source (length, bytes); the wire diagnostics (count,
// then code number, start, end, message); the checked wires (count, then
// name, has-format flag, mismatch message).
pub fn check_tensor_types(in input: Str) -> ChunkSeq[u64] {
    let (is_active, st, cx, _a) = setup_and_analyze(in input);
    let mut out = ChunkSeq::new[u8]();
    if !is_active {
        put(inout out, in "inactive\n");
        return pack_text(in out);
    }
    report(in st, in cx, inout out);
    pack_text(in out)
}

pub fn check_tensor_types_elaborate(in input: Str) -> ChunkSeq[u64] {
    let (is_active, st, cx, a) = setup_and_analyze(in input);
    if !is_active {
        let mut out = ChunkSeq::new[u8]();
        put(inout out, in "inactive\n");
        return pack_text(in out);
    }
    let out = elaborate_report(in st, in cx, in a);
    pack_text(in out)
}

pub fn check_tensor_types_diags_bytes(in names: Str, in bytes: Slice[u8]) -> ChunkSeq[u64] {
    let mut reader = Reader { pos: 0 };
    let a = read_ast(in names, inout reader, in bytes);
    let mut st = st_new();
    map_names(inout st, in a);
    let mut cx = cx_new(inout st);
    let mut out = ChunkSeq::new[u64]();
    if !active(inout st, in a) {
        out.push(0);
        return out;
    }
    let diag_count = reader.word(in bytes);
    for _ in 0..diag_count {
        let code = reader.word(in bytes);
        let start = reader.word(in bytes);
        let end = reader.word(in bytes);
        let mut message = ChunkSeq::new[u8]();
        read_bytes(inout reader, in bytes, inout message);
        st.dcode.push(wrapping_u32(code));
        st.dstart.push(start);
        st.dend.push(end);
        st.dma.push(st.dtext.len());
        st.dtext.extend(in message.as_slice());
        st.dmb.push(st.dtext.len());
    }
    let wire_count = reader.word(in bytes);
    for _ in 0..wire_count {
        let mut name = ChunkSeq::new[u8]();
        read_bytes(inout reader, in bytes, inout name);
        let wire_name = st.names.intern(in name.as_slice());
        let has = reader.word(in bytes);
        let mut message = ChunkSeq::new[u8]();
        read_bytes(inout reader, in bytes, inout message);
        if has == 1 {
            set32(inout cx.wire, wire_name, 1);
        } else {
            let row = wrapping_u32(cx.wa.len());
            cx.wa.push(cx.wtext.len());
            cx.wtext.extend(in message.as_slice());
            cx.wb.push(cx.wtext.len());
            set32(inout cx.wire, wire_name, wrapping_add(row, 2));
        }
    }
    analyze(inout st, inout cx, in a);
    out.push(1);
    let n = st.dcode.len();
    out.push(n);
    for i in 0..n {
        out.push(widen_u64(u32_at(in st.dcode, i)));
        out.push(u64_at(in st.dstart, i));
        out.push(u64_at(in st.dend, i));
        let a_off = u64_at(in st.dma, i);
        let b_off = u64_at(in st.dmb, i);
        let mut msg = ChunkSeq::with_capacity[u8](wrapping_sub(b_off, a_off));
        for k in a_off..b_off {
            msg.push(u8_at(in st.dtext, k));
        }
        let packed = pack_text(in msg);
        out.extend(in packed.as_slice());
    }
    out
}
