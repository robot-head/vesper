const NONE: u32 = 4294967295;

const T_TENSOR: u8 = 1;
const T_LEASE: u8 = 2;
const T_SEQ: u8 = 3;
const T_ADT: u8 = 4;
const T_TUPLE: u8 = 5;
const T_FN: u8 = 6;
const T_VAR: u8 = 7;
const T_BASE: u8 = 8;
const T_UNKNOWN: u8 = 9;

const KD_DIM: u8 = 0;
const KD_DTYPE: u8 = 1;
const KD_TYPE: u8 = 2;

// Diagnostic codes (`tensor_types::codes`).
const C_KIND: u32 = 761;
const C_DIM: u32 = 762;
const C_SHAPE: u32 = 763;
const C_INFER: u32 = 764;
const C_OBLIGATION: u32 = 765;
const C_DTYPE: u32 = 766;
const C_WIRE: u32 = 767;
const C_OPAQUE: u32 = 768;
const C_HANDLER: u32 = 769;
const C_UNSUPPORTED: u32 = 770;
const C_POOL: u32 = 771;

// ----- small helpers ------------------------------------------------------------------

fn err_s(inout st: St, code: u32, start: u64, end: u64, in message: Str) {
    let mut bytes = ChunkSeq::new[u8]();
    put(inout bytes, in message);
    push_diag(inout st, code, start, end, in bytes);
}

// A diagnostic whose message is `err`.
fn err_last(inout st: St, code: u32, start: u64, end: u64) {
    let mut message = ChunkSeq::new[u8]();
    message.extend(in st.err.as_slice());
    push_diag(inout st, code, start, end, in message);
}

fn base_s(inout st: St, in text: Str) -> u32 {
    let name = st.names.intern(in text.as_bytes());
    ty_named(inout st, T_BASE, name)
}

fn name_s(inout st: St, in text: Str) -> u32 {
    st.names.intern(in text.as_bytes())
}

fn adt1(inout st: St, name: u32, arg: u32) -> u32 {
    let mut items = ChunkSeq::new[u32]();
    items.push(0);
    items.push(arg);
    mk_ty(inout st, T_ADT, name, 0, in items)
}

fn adt2(inout st: St, name: u32, arg0: u32, arg1: u32) -> u32 {
    let mut items = ChunkSeq::new[u32]();
    items.push(0);
    items.push(arg0);
    items.push(0);
    items.push(arg1);
    mk_ty(inout st, T_ADT, name, 0, in items)
}

// The `Arg::Ty` argument `i` of an Adt type, or NONE.
fn adt_ty_arg(in st: St, t: u32, i: u64) -> u32 {
    let node = ty_node(in st, t);
    if node.k != T_ADT || i >= widen_u64(node.n) {
        return NONE;
    }
    if ty_item(in st, t, wrapping_mul(i, 2)) != 0 {
        return NONE;
    }
    ty_item(in st, t, inc(wrapping_mul(i, 2)))
}

fn or_unknown(in st: St, t: u32) -> u32 {
    if t == NONE { st.unknown } else { t }
}

// ----- obligations ------------------------------------------------------------------------

fn put_ob(in st: St, inout o: ChunkSeq[u8], ob: Ob) {
    st.names.write(ob.r, inout o);
    put(inout o, in ": ");
    if ob.k == 0 {
        put_dim(in st, inout o, ob.d1);
        put(inout o, in " must be even");
    } else {
        put_dim(in st, inout o, ob.d2);
        put(inout o, in " must be a multiple of ");
        put_dim(in st, inout o, ob.d1);
    }
}

// The derived `Ord` of `Obligation`.
fn cmp_ob(in st: St, lhs: Ob, rhs: Ob) -> i64 {
    if lhs.k != rhs.k {
        if lhs.k < rhs.k {
            return -1;
        }
        return 1;
    }
    let order = cmp_dim(in st, lhs.d1, rhs.d1);
    if order != 0 {
        return order;
    }
    if lhs.k == 1 {
        let d2_order = cmp_dim(in st, lhs.d2, rhs.d2);
        if d2_order != 0 {
            return d2_order;
        }
    }
    cmp_names(in st, lhs.r, rhs.r)
}

// `Obligation::decide`: 1 true, 0 false, 2 depends on variables.
fn decide(in st: St, ob: Ob) -> u8 {
    if ob.k == 0 {
        if dim_node(in st, ob.d1).coeff % 2 == 0 {
            return 1;
        }
        if (dim_node(in st, ob.d1).n == 0) {
            return 0;
        }
        return 2;
    }
    if dim_divides(in st, ob.d1, ob.d2) {
        return 1;
    }
    if (dim_node(in st, ob.d1).n == 0) && (dim_node(in st, ob.d2).n == 0) {
        return 0;
    }
    2
}

fn ob_get(in cx: Cx, i: u64) -> Ob {
    match cx.obs.try_get(i) {
        Option::Some(ob) => ob,
        Option::None => Ob { k: 0, d1: 0, d2: 0, r: 0 },
    }
}

fn bo_get(in cx: Cx, i: u64) -> Ob {
    match cx.bo.try_get(i) {
        Option::Some(ob) => ob,
        Option::None => Ob { k: 0, d1: 0, d2: 0, r: 0 },
    }
}

// Inserts into the body's sorted obligation set.
fn bo_insert(in st: St, inout cx: Cx, ob: Ob) {
    let n = cx.bo.len();
    let mut at = n;
    for i in 0..n {
        let order = cmp_ob(in st, bo_get(in cx, i), ob);
        if order == 0 {
            return;
        }
        if order > 0 {
            at = i;
            break;
        }
    }
    cx.bo.push(ob);
    let mut j = n;
    loop {
        if j <= at {
            break;
        }
        let prev = bo_get(in cx, wrapping_sub(j, 1));
        let ok = cx.bo.try_set(j, prev);
        j = wrapping_sub(j, 1);
    }
    let ok2 = cx.bo.try_set(at, ob);
}

// ----- signatures -------------------------------------------------------------------------

fn sig_gen_count(in cx: Cx, row: u32) -> u64 {
    widen_u64(u32_at(in cx.sg_gn, widen_u64(row)))
}

fn sig_gen_name(in cx: Cx, row: u32, i: u64) -> u32 {
    u32_at(in cx.sg_gsym, wrapping_add(widen_u64(u32_at(in cx.sg_ga, widen_u64(row))), i))
}

fn sig_gen_kind(in cx: Cx, row: u32, i: u64) -> u8 {
    u8_at(in cx.sg_gkind, wrapping_add(widen_u64(u32_at(in cx.sg_ga, widen_u64(row))), i))
}

fn sig_param_count(in cx: Cx, row: u32) -> u64 {
    widen_u64(u32_at(in cx.sg_pn, widen_u64(row)))
}

fn sig_param_ty(in cx: Cx, row: u32, i: u64) -> u32 {
    u32_at(in cx.sg_pty, wrapping_add(widen_u64(u32_at(in cx.sg_pa, widen_u64(row))), i))
}

fn sig_param_pass(in cx: Cx, row: u32, i: u64) -> u8 {
    u8_at(in cx.sg_ppass, wrapping_add(widen_u64(u32_at(in cx.sg_pa, widen_u64(row))), i))
}

fn sig_ob_count(in cx: Cx, row: u32) -> u64 {
    widen_u64(u32_at(in cx.sg_on, widen_u64(row)))
}

fn sig_ob(in cx: Cx, row: u32, i: u64) -> Ob {
    ob_get(in cx, wrapping_add(widen_u64(u32_at(in cx.sg_oa, widen_u64(row))), i))
}

// Adds a signature row; generics and params are pushed by the caller
// right before (their starts are given).
fn add_sig(
    inout cx: Cx,
    name: u32,
    generics_start: u64,
    params_start: u64,
    result: u32,
    pool: u8,
    kv: u32,
    hd: u32,
    start: u64,
    end: u64
) -> u32 {
    let row = wrapping_u32(cx.sg_name.len());
    cx.sg_name.push(name);
    cx.sg_ga.push(wrapping_u32(generics_start));
    cx.sg_gn.push(wrapping_u32(wrapping_sub(cx.sg_gsym.len(), generics_start)));
    cx.sg_pa.push(wrapping_u32(params_start));
    cx.sg_pn.push(wrapping_u32(wrapping_sub(cx.sg_pty.len(), params_start)));
    cx.sg_res.push(result);
    cx.sg_pool.push(pool);
    cx.sg_kv.push(kv);
    cx.sg_hd.push(hd);
    cx.sg_oa.push(0);
    cx.sg_on.push(0);
    cx.sg_start.push(start);
    cx.sg_end.push(end);
    row
}

fn set_scope_from(inout cx: Cx, in names: ChunkSeq[u32], in kinds: ChunkSeq[u8]) {
    cx.sc_name.clear();
    cx.sc_kind.clear();
    let mut n = names.len();
    if kinds.len() < n {
        n = kinds.len();
    }
    for i in 0..n {
        cx.sc_name.push(u32_at(in names, i));
        cx.sc_kind.push(u8_at(in kinds, i));
    }
}

// `signature`: adds the function's signature, or pushes its diagnostic.
fn signature(inout st: St, inout cx: Cx, in a: Ast, fn_id: u32) {
    let func = fnn(in a, fn_id);
    let mut names = ChunkSeq::new[u32]();
    for i in 0..list_len(in a, func.generics) {
        let generic = genericn(in a, list_at(in a, func.generics, i));
        if !generic.row {
            names.push(nm(in st, generic.name));
        }
    }
    cx.gset.clear();
    cx.gset.extend(in names.as_slice());
    uses_clear(inout cx);
    for i in 0..list_len(in a, func.params) {
        collect_kinds(in st, inout cx, in a, paramn(in a, list_at(in a, func.params, i)).ty);
    }
    collect_kinds(in st, inout cx, in a, func.result);
    collect_row_kinds(in st, inout cx, in a, func.effects);
    let mut kinds = ChunkSeq::new[u8]();
    let start = widen_u64(func.start);
    let end = widen_u64(func.end);
    if !resolve_kinds(inout st, in cx, in names, inout kinds) {
        err_last(inout st, C_KIND, start, end);
        return;
    }
    set_scope_from(inout cx, in names, in kinds);
    let name = nm(in st, func.name);
    let mut param_tys = ChunkSeq::new[u32]();
    let mut param_passes = ChunkSeq::new[u8]();
    for i in 0..list_len(in a, func.params) {
        let param = paramn(in a, list_at(in a, func.params, i));
        let param_ty = scope_ty(inout st, in cx, in a, param.ty);
        if param_ty == NONE {
            let code = err_code(in st);
            let mut message = ChunkSeq::new[u8]();
            put(inout message, in "parameter '");
            st.names.write(nm(in st, param.name), inout message);
            put(inout message, in "': ");
            message.extend(in st.err.as_slice());
            push_diag(inout st, code, (widen_u64(param.start)), (widen_u64(param.end)), in message);
            return;
        }
        param_tys.push(param_ty);
        param_passes.push(param.pass);
    }
    let result = scope_ty(inout st, in cx, in a, func.result);
    if result == NONE {
        let code = err_code(in st);
        let mut message = ChunkSeq::new[u8]();
        put(inout message, in "result of '");
        st.names.write(name, inout message);
        put(inout message, in "': ");
        message.extend(in st.err.as_slice());
        push_diag(inout st, code, start, end, in message);
        return;
    }
    let mut pool: u8 = 0;
    let mut kv: u32 = 0;
    let mut hd: u32 = 0;
    if func.effects != NONE {
        let row = effectsn(in a, func.effects);
        for i in 0..list_len(in a, row.instances) {
            let effect = effectn(in a, list_at(in a, row.instances, i));
            if nm(in st, effect.name) == st.s_kv && list_len(in a, effect.args) > 0 {
                if list_len(in a, effect.args) != 2 {
                    err_s(
                        inout st,
                        C_KIND,
                        start,
                        end,
                        in "KvCachePool takes two dimensions: KvCachePool[KvHeads, HeadDim]"
                    );
                    return;
                }
                let kv_heads = scope_dim(inout st, in cx, in a, list_at(in a, effect.args, 0));
                if kv_heads == NONE {
                    err_last(inout st, C_KIND, start, end);
                    return;
                }
                let head_dim = scope_dim(inout st, in cx, in a, list_at(in a, effect.args, 1));
                if head_dim == NONE {
                    err_last(inout st, C_KIND, start, end);
                    return;
                }
                pool = 1;
                kv = kv_heads;
                hd = head_dim;
            }
        }
    }
    let generics_start = cx.sg_gsym.len();
    cx.sg_gsym.extend(in names.as_slice());
    cx.sg_gkind.extend(in kinds.as_slice());
    let params_start = cx.sg_pty.len();
    cx.sg_pty.extend(in param_tys.as_slice());
    cx.sg_ppass.extend(in param_passes.as_slice());
    let row = add_sig(
        inout cx,
        name,
        generics_start,
        params_start,
        result,
        pool,
        kv,
        hd,
        start,
        end
    );
    set32(inout cx.sg_row, name, row);
}

// ----- ADT infos --------------------------------------------------------------------------

fn info_gen_count(in cx: Cx, info_row: u32) -> u64 {
    let generic_count = widen_u64(u32_at(in cx.ai_gn, widen_u64(info_row)));
    let kind_count = widen_u64(u32_at(in cx.ai_kn, widen_u64(info_row)));
    if kind_count < generic_count {
        kind_count
    } else {
        generic_count
    }
}

// All generics of the info (not zipped with kinds), for `adt_subst`.

fn info_variant(in st: St, in cx: Cx, info_row: u32, variant: u32) -> u32 {
    let variants_start = widen_u64(u32_at(in cx.ai_va, widen_u64(info_row)));
    let variant_count = widen_u64(u32_at(in cx.ai_vn, widen_u64(info_row)));
    for i in 0..variant_count {
        if u32_at(in cx.vr_name, wrapping_add(variants_start, i)) == variant {
            return wrapping_u32(wrapping_add(variants_start, i));
        }
    }
    NONE
}

// The first ADT in name order (optionally only enums) with a variant
// named `variant`: its info row, or NONE.
fn adt_with_variant(in st: St, in cx: Cx, variant: u32, enums: bool) -> u32 {
    for i in 0..cx.ai_sorted.len() {
        let info_row = u32_at(in cx.ai_sorted, i);
        if enums && !(u8_at(in cx.ai_enum, widen_u64(info_row)) == 1) {
            continue;
        }
        if info_variant(in st, in cx, info_row, variant) != NONE {
            return info_row;
        }
    }
    NONE
}

// `adt_subst(info, args)` of an Adt type `t`.
fn adt_subst(in st: St, in cx: Cx, info_row: u32, t: u32) -> Subst {
    let mut subst = subst_new();
    let node = ty_node(in st, t);
    let mut arg_count = widen_u64(u32_at(in cx.ai_gn, widen_u64(info_row)));
    if node.k != T_ADT {
        arg_count = 0;
    } else if widen_u64(node.n) < arg_count {
        arg_count = widen_u64(node.n);
    }
    for i in 0..arg_count {
        let generic = u32_at(
            in cx.ai_syms,
            wrapping_add(widen_u64(u32_at(in cx.ai_ga, widen_u64(info_row))), i)
        );
        let tag = ty_item(in st, t, wrapping_mul(i, 2));
        let id = ty_item(in st, t, inc(wrapping_mul(i, 2)));
        if tag == 1 {
            set_dim(inout subst, generic, id);
        } else if tag == 2 {
            set_dtype(inout subst, generic, id);
        } else {
            set_ty(inout subst, generic, id);
        }
    }
    subst
}

// The ADT field types (`analyze`'s "ADT field types" pass).
fn adt_infos(inout st: St, inout cx: Cx, in a: Ast) {
    let wire = st.s_wire;
    for i in 0..a.m_items.len() {
        let item = item_at(in a, i);
        if item.kind != 1 {
            continue;
        }
        let adt = adtn(in a, item.node);
        let name = nm(in st, adt.name);
        let kinds_row = at32(in cx.ak_row, name);
        let mut names = ChunkSeq::new[u32]();
        for generic_idx in 0..list_len(in a, adt.generics) {
            names.push(nm(in st, genericn(in a, list_at(in a, adt.generics, generic_idx)).name));
        }
        let mut kinds = ChunkSeq::new[u8]();
        if kinds_row != NONE {
            for kind_idx in 0..widen_u64(u32_at(in cx.ak_n, widen_u64(kinds_row))) {
                kinds.push(u8_at(
                    in cx.ak_k,
                    wrapping_add(widen_u64(u32_at(in cx.ak_a, widen_u64(kinds_row))), kind_idx)
                ));
            }
        }
        set_scope_from(inout cx, in names, in kinds);
        let block = (u8_at(in cx.blocks, widen_u64(name)) == 1);
        let variants_start = cx.vr_name.len();
        let start = widen_u64(adt.start);
        let end = widen_u64(adt.end);
        for variant_idx in 0..list_len(in a, adt.variants) {
            let variant = variantn(in a, list_at(in a, adt.variants, variant_idx));
            let fields_start = cx.fr_name.len();
            for field_idx in 0..list_len(in a, variant.fields) {
                let field = fieldn(in a, list_at(in a, variant.fields, field_idx));
                let field_name = nm(in st, field.name);
                if block {
                    cx.fr_name.push(field_name);
                    let wire_ty = ty_named(inout st, T_BASE, wire);
                    cx.fr_ty.push(wire_ty);
                    continue;
                }
                let field_ty = scope_ty(inout st, in cx, in a, field.ty);
                if field_ty != NONE {
                    let field_kind = ty_node(in st, field_ty).k;
                    if adt.mode != 2 && (field_kind == T_LEASE || field_kind == T_SEQ) {
                        let mut message = ChunkSeq::new[u8]();
                        put(inout message, in "field '");
                        st.names.write(field_name, inout message);
                        put(inout message, in "' holds a linear pool lease; '");
                        st.names.write(name, inout message);
                        put(inout message, in "' must be a linear type");
                        push_diag(inout st, C_OPAQUE, start, end, in message);
                    }
                    cx.fr_name.push(field_name);
                    cx.fr_ty.push(field_ty);
                } else {
                    let code = err_code(in st);
                    let mut message = ChunkSeq::new[u8]();
                    put(inout message, in "field '");
                    st.names.write(field_name, inout message);
                    put(inout message, in "' of '");
                    st.names.write(name, inout message);
                    put(inout message, in "': ");
                    message.extend(in st.err.as_slice());
                    push_diag(inout st, code, start, end, in message);
                    cx.fr_name.push(field_name);
                    cx.fr_ty.push(st.unknown);
                }
            }
            cx.vr_name.push(nm(in st, variant.name));
            cx.vr_fa.push(wrapping_u32(fields_start));
            cx.vr_fn.push(wrapping_u32(wrapping_sub(cx.fr_name.len(), fields_start)));
        }
        let row = wrapping_u32(cx.ai_name.len());
        cx.ai_name.push(name);
        cx.ai_ka.push(wrapping_u32(cx.ai_kinds.len()));
        cx.ai_kn.push(wrapping_u32(kinds.len()));
        cx.ai_kinds.extend(in kinds.as_slice());
        cx.ai_ga.push(wrapping_u32(cx.ai_syms.len()));
        cx.ai_gn.push(wrapping_u32(names.len()));
        cx.ai_syms.extend(in names.as_slice());
        cx.ai_va.push(wrapping_u32(variants_start));
        cx.ai_vn.push(wrapping_u32(wrapping_sub(cx.vr_name.len(), variants_start)));
        let mut enum_flag: u8 = 0;
        if adt.is_enum {
            enum_flag = 1;
        }
        cx.ai_enum.push(enum_flag);
        set32(inout cx.ai_row, name, row);
    }
    // Distinct names in name order, each with its latest row.
    let mut sorted = ChunkSeq::new[u32]();
    for info_row in 0..cx.ai_name.len() {
        let name = u32_at(in cx.ai_name, info_row);
        if widen_u64(at32(in cx.ai_row, name)) != info_row {
            continue;
        }
        let n = sorted.len();
        let mut at = n;
        for i in 0..n {
            if cmp_names(in st, u32_at(in cx.ai_name, widen_u64(u32_at(in sorted, i))), name) > 0 {
                at = i;
                break;
            }
        }
        sorted.push(wrapping_u32(info_row));
        let mut j = n;
        loop {
            if j <= at {
                break;
            }
            let prev = u32_at(in sorted, wrapping_sub(j, 1));
            let ok = sorted.try_set(j, prev);
            j = wrapping_sub(j, 1);
        }
        let ok2 = sorted.try_set(at, wrapping_u32(info_row));
    }
    cx.ai_sorted = sorted;
}

// ----- the body checker --------------------------------------------------------------------

fn env_pop(inout cx: Cx) {
    let n = cx.en_marks.len();
    if n == 0 {
        return;
    }
    let saved_len = u64_at(in cx.en_marks, wrapping_sub(n, 1));
    cx.en_marks.truncate(wrapping_sub(n, 1));
    cx.en_name.truncate(saved_len);
    cx.en_ty.truncate(saved_len);
}

fn bind(inout cx: Cx, name: u32, t: u32) {
    if cx.en_marks.len() == 0 {
        return;
    }
    cx.en_name.push(name);
    cx.en_ty.push(t);
}

fn lookup(in cx: Cx, name: u32) -> u32 {
    let mut i = cx.en_name.len();
    loop {
        if i == 0 {
            return NONE;
        }
        i = wrapping_sub(i, 1);
        if u32_at(in cx.en_name, i) == name {
            return u32_at(in cx.en_ty, i);
        }
    }
}

fn scope_kind_of(in cx: Cx, name: u32) -> u8 {
    let mut i = cx.sc_name.len();
    loop {
        if i == 0 {
            return 9;
        }
        i = wrapping_sub(i, 1);
        if u32_at(in cx.sc_name, i) == name {
            return u8_at(in cx.sc_kind, i);
        }
    }
}

// `Body::expect`.
fn expect(
    inout st: St,
    in cx: Cx,
    expected: u32,
    actual: u32,
    start: u64,
    end: u64,
    in context: ChunkSeq[u8]
) {
    let mut subst = subst_new();
    let code = unify_settle(inout st, inout subst, expected, actual);
    if code != 0 {
        let mut message = ChunkSeq::new[u8]();
        message.extend(in context.as_slice());
        put(inout message, in ": expected ");
        put_ty(in st, inout message, expected);
        put(inout message, in ", found ");
        put_ty(in st, inout message, actual);
        if st.err.len() > 0 {
            put(inout message, in " (");
            message.extend(in st.err.as_slice());
            message.push(41);
        }
        push_diag(inout st, code, start, end, in message);
    }
}

fn expect_s(
    inout st: St,
    in cx: Cx,
    expected: u32,
    actual: u32,
    start: u64,
    end: u64,
    in context: Str
) {
    let mut context_bytes = ChunkSeq::new[u8]();
    put(inout context_bytes, in context);
    expect(inout st, in cx, expected, actual, start, end, in context_bytes);
}

fn ob_all_dims(in st: St, in cx: Cx, d: u32) -> bool {
    for i in 0..widen_u64(dim_node(in st, d).n) {
        if scope_kind(in cx, dim_var_at(in st, d, i)) != KD_DIM {
            return false;
        }
    }
    true
}

// `Body::require`.
fn require(inout st: St, inout cx: Cx, ob: Ob, start: u64, end: u64) {
    let decision = decide(in st, ob);
    if decision == 1 {
        return;
    }
    let mut message = ChunkSeq::new[u8]();
    if decision == 0 {
        put_ob(in st, inout message, ob);
        push_diag(inout st, C_OBLIGATION, start, end, in message);
        return;
    }
    let mut all = ob_all_dims(in st, in cx, ob.d1);
    if ob.k == 1 && all {
        all = ob_all_dims(in st, in cx, ob.d2);
    }
    if all {
        bo_insert(in st, inout cx, ob);
    } else {
        put(inout message, in "cannot decide: ");
        put_ob(in st, inout message, ob);
        push_diag(inout st, C_INFER, start, end, in message);
    }
}

// `Body::tensor`: whether `t` is a tensor; reports otherwise.
fn want_tensor(inout st: St, t: u32, start: u64, end: u64, in what: ChunkSeq[u8]) -> bool {
    let kind = ty_node(in st, t).k;
    if kind == T_TENSOR {
        return true;
    }
    let mut message = ChunkSeq::new[u8]();
    if kind == T_UNKNOWN {
        put(inout message, in "cannot determine the shape of ");
        message.extend(in what.as_slice());
        put(inout message, in "; annotate it with a tensor type");
        push_diag(inout st, C_INFER, start, end, in message);
    } else {
        message.extend(in what.as_slice());
        put(inout message, in " must be a tensor, found ");
        put_ty(in st, inout message, t);
        push_diag(inout st, C_SHAPE, start, end, in message);
    }
    false
}

// `Body::f32`.
fn want_f32(inout st: St, dtype: u32, start: u64, end: u64, in what: ChunkSeq[u8]) -> bool {
    if dtype == 0 {
        return true;
    }
    let mut message = ChunkSeq::new[u8]();
    message.extend(in what.as_slice());
    put(inout message, in " must have element type F32, found ");
    put_dtype(in st, inout message, dtype);
    push_diag(inout st, C_DTYPE, start, end, in message);
    false
}

// "argument {i + 1} of Tensor::{op}".
fn arg_what(in st: St, i: u64, in pre: Str, op: u32) -> ChunkSeq[u8] {
    let mut message = ChunkSeq::new[u8]();
    put(inout message, in "argument ");
    push_decimal(inout message, inc(i));
    put(inout message, in " of ");
    put(inout message, in pre);
    st.names.write(op, inout message);
    message
}

// `Body::no_operator`.
fn no_operator(inout st: St, t: u32, start: u64, end: u64) {
    if (ty_node(in st, t).k == T_TENSOR) {
        err_s(
            inout st,
            C_UNSUPPORTED,
            start,
            end,
            in "tensor arithmetic uses Tensor::add, Tensor::mul and Tensor::matmul, not operators"
        );
    }
}

// `Body::join`.
fn join(inout st: St, in cx: Cx, lhs: u32, rhs: u32, start: u64, end: u64, in what: Str) -> u32 {
    if lhs == st.unknown {
        return rhs;
    }
    expect_s(inout st, in cx, lhs, rhs, start, end, in what);
    lhs
}

// `Body::opaque`.
fn opaque(inout st: St, name: u32, start: u64, end: u64, in what: Str) -> bool {
    let base_name = last_segment(inout st, name);
    if base_name == st.s_tensor
        || base_name == st.s_lease
        || base_name == st.s_seq
        || base_name == st.s_dims {
        let mut message = ChunkSeq::new[u8]();
        message.push(39);
        st.names.write(base_name, inout message);
        put(
            inout message,
            in "' values are created and consumed only by Tensor and KvCachePool operations; a source program cannot "
        );
        put(inout message, in what);
        put(inout message, in " one");
        push_diag(inout st, C_OPAQUE, start, end, in message);
        return true;
    }
    false
}

// `Body::variant_fields`: the (name, type) pairs into `names`/`tys`.
fn variant_fields(
    inout st: St,
    in cx: Cx,
    name: u32,
    t: u32,
    inout names: ChunkSeq[u32],
    inout tys: ChunkSeq[u32]
) {
    names.clear();
    tys.clear();
    let variant = last_segment(inout st, name);
    let node = ty_node(in st, t);
    if node.k != T_ADT {
        return;
    }
    let adt_name = node.a;
    if (adt_name == st.s_option && variant == st.s_some)
        || (adt_name == st.s_result && variant == st.s_ok) {
        names.push(cx.s_zero);
        tys.push(or_unknown(in st, adt_ty_arg(in st, t, 0)));
        return;
    }
    if adt_name == st.s_result && variant == st.s_err {
        names.push(cx.s_zero);
        tys.push(or_unknown(in st, adt_ty_arg(in st, t, 1)));
        return;
    }
    let info_row = at32(in cx.ai_row, adt_name);
    if info_row == NONE {
        return;
    }
    let variant_row = info_variant(in st, in cx, info_row, variant);
    if variant_row == NONE {
        return;
    }
    let subst = adt_subst(in st, in cx, info_row, t);
    for i in 0..widen_u64(u32_at(in cx.vr_fn, widen_u64(variant_row))) {
        names.push(u32_at(
            in cx.fr_name,
            wrapping_add(widen_u64(u32_at(in cx.vr_fa, widen_u64(variant_row))), i)
        ));
        let field_ty = sub_ty_or(
            inout st,
            in subst,
            u32_at(
                in cx.fr_ty,
                wrapping_add(widen_u64(u32_at(in cx.vr_fa, widen_u64(variant_row))), i)
            ),
            st.unknown
        );
        tys.push(field_ty);
    }
}

// `Body::pattern`.
fn pattern(inout st: St, inout cx: Cx, in a: Ast, p: u32, t: u32) {
    let node = pat_at(in a, p);
    if node.kind == 2 {
        bind(inout cx, nm(in st, node.a), t);
    } else if node.kind == 4 {
        let tuple_node = ty_node(in st, t);
        for i in 0..list_len(in a, node.a) {
            let mut elem_ty = st.unknown;
            if tuple_node.k == T_TUPLE && i < widen_u64(tuple_node.n) {
                elem_ty = ty_item(in st, t, i);
            }
            pattern(inout st, inout cx, in a, list_at(in a, node.a, i), elem_ty);
        }
    } else if node.kind == 5 {
        let name = nm(in st, node.a);
        if opaque(inout st, name, widen_u64(node.start), widen_u64(node.end), in "destructure") {
            return;
        }
        let mut field_names = ChunkSeq::new[u32]();
        let mut field_tys = ChunkSeq::new[u32]();
        variant_fields(inout st, in cx, name, t, inout field_names, inout field_tys);
        let field_count = list_len(in a, node.b) >> 1;
        for i in 0..field_count {
            let field_name = nm(in st, list_at(in a, node.b, wrapping_mul(i, 2)));
            let sub_pat = list_at(in a, node.b, inc(wrapping_mul(i, 2)));
            let mut field_ty = st.unknown;
            for j in 0..field_names.len() {
                if u32_at(in field_names, j) == field_name {
                    field_ty = u32_at(in field_tys, j);
                    break;
                }
            }
            pattern(inout st, inout cx, in a, sub_pat, field_ty);
        }
    }
}

// A tuple field name as an index (`f.parse::<usize>()`), or NONE64.
fn field_index(in st: St, field_name: u32) -> u64 {
    let n = st.names.size(field_name);
    if n == 0 || n > 18 {
        return 18446744073709551615;
    }
    let mut value: u64 = 0;
    for i in 0..n {
        let byte = st.names.byte(field_name, i);
        if byte < 48 || byte > 57 {
            return 18446744073709551615;
        }
        value = wrapping_add(wrapping_mul(value, 10), wrapping_sub(widen_u64(byte), 48));
    }
    value
}

// `Body::field`.
fn field(inout st: St, in cx: Cx, t: u32, field_name: u32, start: u64, end: u64) -> u32 {
    let node = ty_node(in st, t);
    if node.k == T_TENSOR || node.k == T_LEASE || node.k == T_SEQ {
        let mut name = st.s_tensor;
        if node.k == T_LEASE {
            name = st.s_lease;
        } else if node.k == T_SEQ {
            name = st.s_seq;
        }
        let reported = opaque(inout st, name, start, end, in "read a field of");
        return st.unknown;
    }
    if node.k == T_TUPLE {
        let i = field_index(in st, field_name);
        if i < widen_u64(node.n) {
            return ty_item(in st, t, i);
        }
        return st.unknown;
    }
    if node.k == T_ADT {
        let info_row = at32(in cx.ai_row, node.a);
        if info_row == NONE || (u8_at(in cx.ai_enum, widen_u64(info_row)) == 1) {
            return st.unknown;
        }
        let variant_count = widen_u64(u32_at(in cx.ai_vn, widen_u64(info_row)));
        if variant_count == 0 {
            return st.unknown;
        }
        let variant_row = u32_at(in cx.ai_va, widen_u64(info_row));
        let subst = adt_subst(in st, in cx, info_row, t);
        for i in 0..widen_u64(u32_at(in cx.vr_fn, widen_u64(variant_row))) {
            if u32_at(
                in cx.fr_name,
                wrapping_add(widen_u64(u32_at(in cx.vr_fa, widen_u64(variant_row))), i)
            )
                == field_name {
                return sub_ty_or(
                    inout st,
                    in subst,
                    u32_at(
                        in cx.fr_ty,
                        wrapping_add(widen_u64(u32_at(in cx.vr_fa, widen_u64(variant_row))), i)
                    ),
                    st.unknown
                );
            }
        }
        return st.unknown;
    }
    st.unknown
}

// `Body::fresh_generics`: binds each generic `(names[i], kinds[i])` to a
// fresh `?n` in `s`; the fresh names go to `fresh`.
fn fresh_generics(
    inout st: St,
    inout cx: Cx,
    in names: ChunkSeq[u32],
    in kinds: ChunkSeq[u8],
    inout s: Subst,
    inout fresh: ChunkSeq[u32]
) {
    for i in 0..names.len() {
        cx.fresh = inc(cx.fresh);
        let mut text = ChunkSeq::new[u8]();
        text.push(63);
        push_decimal(inout text, cx.fresh);
        let fresh_name = st.names.intern(in text.as_slice());
        let generic = u32_at(in names, i);
        let kind = u8_at(in kinds, i);
        if kind == KD_DIM {
            let dim = dim_var(inout st, fresh_name);
            set_dim(inout s, generic, dim);
        } else if kind == KD_DTYPE {
            set_dtype(inout s, generic, wrapping_add(3, wrapping_mul(fresh_name, 2)));
        } else {
            let var_ty = ty_named(inout st, T_VAR, fresh_name);
            set_ty(inout s, generic, var_ty);
        }
        fresh.push(fresh_name);
    }
}

// The fresh name of the first generic named `generic`.
fn fresh_of(in names: ChunkSeq[u32], in fresh: ChunkSeq[u32], generic: u32) -> u32 {
    for i in 0..names.len() {
        if u32_at(in names, i) == generic {
            return u32_at(in fresh, i);
        }
    }
    NONE
}

fn exprs_none(inout st: St, inout cx: Cx, in a: Ast, list: u32, pairs: bool) {
    if pairs {
        let pair_count = list_len(in a, list) >> 1;
        for i in 0..pair_count {
            let t = expr(
                inout st,
                inout cx,
                in a,
                list_at(in a, list, inc(wrapping_mul(i, 2))),
                NONE
            );
        }
    } else {
        for i in 0..list_len(in a, list) {
            let t = expr(inout st, inout cx, in a, list_at(in a, list, i), NONE);
        }
    }
}

fn args_none(inout st: St, inout cx: Cx, in a: Ast, args: u32) -> ChunkSeq[u32] {
    let mut out = ChunkSeq::new[u32]();
    for i in 0..list_len(in a, args) {
        let arg_ty = expr(inout st, inout cx, in a, argn(in a, list_at(in a, args, i)).expr, NONE);
        out.push(arg_ty);
    }
    out
}

// `Body::struct_literal`.
fn struct_literal(
    inout st: St,
    inout cx: Cx,
    in a: Ast,
    e: u32,
    name: u32,
    fields: u32,
    expected: u32
) -> u32 {
    let start = widen_u64(expr_at(in a, e).start);
    let end = widen_u64(expr_at(in a, e).end);
    if opaque(inout st, name, start, end, in "construct") {
        exprs_none(inout st, inout cx, in a, fields, true);
        return st.unknown;
    }
    let colons = first_colons(in st, name);
    let mut adt = name;
    let mut variant = name;
    if colons < st.names.size(name) {
        adt = name_prefix(inout st, name, colons);
        variant = name_suffix(inout st, name, wrapping_add(colons, 2));
    }
    let mut info_row = at32(in cx.ai_row, adt);
    if info_row == NONE {
        info_row = adt_with_variant(in st, in cx, variant, false);
        if info_row == NONE {
            exprs_none(inout st, inout cx, in a, fields, true);
            return st.unknown;
        }
        adt = u32_at(in cx.ai_name, widen_u64(info_row));
    }
    let generic_count = info_gen_count(in cx, info_row);
    let mut gnames = ChunkSeq::new[u32]();
    let mut gkinds = ChunkSeq::new[u8]();
    for i in 0..generic_count {
        gnames.push(u32_at(
            in cx.ai_syms,
            wrapping_add(widen_u64(u32_at(in cx.ai_ga, widen_u64(info_row))), i)
        ));
        gkinds.push(u8_at(
            in cx.ai_kinds,
            wrapping_add(widen_u64(u32_at(in cx.ai_ka, widen_u64(info_row))), i)
        ));
    }
    let mut renaming = subst_new();
    let mut fresh = ChunkSeq::new[u32]();
    fresh_generics(inout st, inout cx, in gnames, in gkinds, inout renaming, inout fresh);
    let mut items = ChunkSeq::new[u32]();
    for i in 0..generic_count {
        let generic = u32_at(in gnames, i);
        let kind = u8_at(in gkinds, i);
        if kind == KD_DIM {
            items.push(1);
            items.push(find(in renaming.dk, in renaming.dv, generic));
        } else if kind == KD_DTYPE {
            items.push(2);
            items.push(find(in renaming.ek, in renaming.ev, generic));
        } else {
            items.push(0);
            items.push(find(in renaming.yk, in renaming.yv, generic));
        }
    }
    let declared = mk_ty(inout st, T_ADT, adt, 0, in items);
    let mut subst = subst_new();
    if expected != NONE {
        let checkpoint = mark(in subst);
        if unify(inout st, inout subst, declared, expected) != 0 {
            undo(inout subst, checkpoint);
        }
    }
    let variant_row = info_variant(in st, in cx, info_row, variant);
    let mut any_tensor = false;
    if variant_row != NONE {
        for i in 0..widen_u64(u32_at(in cx.vr_fn, widen_u64(variant_row))) {
            if has_tensor(
                in st,
                u32_at(
                    in cx.fr_ty,
                    wrapping_add(widen_u64(u32_at(in cx.vr_fa, widen_u64(variant_row))), i)
                )
            ) {
                any_tensor = true;
            }
        }
    }
    let field_count = list_len(in a, fields) >> 1;
    for i in 0..field_count {
        let field_name = nm(in st, list_at(in a, fields, wrapping_mul(i, 2)));
        let field_expr = list_at(in a, fields, inc(wrapping_mul(i, 2)));
        let mut field_ty = st.unknown;
        if variant_row != NONE {
            for j in 0..widen_u64(u32_at(in cx.vr_fn, widen_u64(variant_row))) {
                if u32_at(
                    in cx.fr_name,
                    wrapping_add(widen_u64(u32_at(in cx.vr_fa, widen_u64(variant_row))), j)
                )
                    == field_name {
                    field_ty = sub_ty_or(
                        inout st,
                        in renaming,
                        u32_at(
                            in cx.fr_ty,
                            wrapping_add(widen_u64(u32_at(in cx.vr_fa, widen_u64(variant_row))), j)
                        ),
                        st.unknown
                    );
                    break;
                }
            }
        }
        let want = sub_ty_or(inout st, in subst, field_ty, st.unknown);
        let got = expr(inout st, inout cx, in a, field_expr, want);
        let code = unify(inout st, inout subst, field_ty, got);
        if code != 0 {
            let mut reason = ChunkSeq::new[u8]();
            reason.extend(in st.err.as_slice());
            let want2 = sub_ty_or(inout st, in subst, field_ty, field_ty);
            let mut msg = ChunkSeq::new[u8]();
            put(inout msg, in "field '");
            st.names.write(field_name, inout msg);
            put(inout msg, in "' of '");
            st.names.write(adt, inout msg);
            put(inout msg, in "': expected ");
            put_ty(in st, inout msg, want2);
            put(inout msg, in ", found ");
            put_ty(in st, inout msg, got);
            put(inout msg, in " (");
            msg.extend(in reason.as_slice());
            msg.push(41);
            push_diag(
                inout st,
                code,
                (widen_u64(expr_at(in a, field_expr).start)),
                (widen_u64(expr_at(in a, field_expr).end)),
                in msg
            );
        }
    }
    let code = settle(inout st, inout subst);
    if code != 0 {
        let mut msg = ChunkSeq::new[u8]();
        msg.push(39);
        st.names.write(adt, inout msg);
        put(inout msg, in "' literal: ");
        msg.extend(in st.err.as_slice());
        push_diag(inout st, code, start, end, in msg);
    }
    for i in 0..gnames.len() {
        let generic = u32_at(in gnames, i);
        let fresh_var = u32_at(in fresh, i);
        let mut is_dim = false;
        for j in 0..gnames.len() {
            if u32_at(in gnames, j) == generic && u8_at(in gkinds, j) == KD_DIM {
                is_dim = true;
            }
        }
        if is_dim && !(find(in subst.dk, in subst.dv, fresh_var) != NONE) && any_tensor {
            let mut msg = ChunkSeq::new[u8]();
            put(inout msg, in "cannot infer dimension '");
            st.names.write(generic, inout msg);
            put(inout msg, in "' of '");
            st.names.write(adt, inout msg);
            put(inout msg, in "'; annotate the binding");
            push_diag(inout st, C_INFER, start, end, in msg);
        }
    }
    sub_ty_or(inout st, in subst, declared, st.unknown)
}

// `Body::function_value`.
fn function_value(inout st: St, in cx: Cx, name: u32, start: u64, end: u64) -> u32 {
    let row = at32(in cx.sg_row, name);
    if row == NONE {
        return st.unknown;
    }
    let mut tensorish = has_tensor(in st, u32_at(in cx.sg_res, widen_u64(row)));
    let mut param_tys = ChunkSeq::new[u32]();
    for i in 0..widen_u64(u32_at(in cx.sg_pn, widen_u64(row))) {
        let param_ty = u32_at(
            in cx.sg_pty,
            wrapping_add(widen_u64(u32_at(in cx.sg_pa, widen_u64(row))), i)
        );
        if has_tensor(in st, param_ty) {
            tensorish = true;
        }
        param_tys.push(param_ty);
    }
    if !tensorish {
        return st.unknown;
    }
    if widen_u64(u32_at(in cx.sg_gn, widen_u64(row))) > 0 {
        let mut message = ChunkSeq::new[u8]();
        message.push(39);
        st.names.write(name, inout message);
        put(
            inout message,
            in "' has generic parameters and cannot be used as a value; call it directly"
        );
        push_diag(inout st, C_UNSUPPORTED, start, end, in message);
        return st.unknown;
    }
    mk_ty(inout st, T_FN, 0, u32_at(in cx.sg_res, widen_u64(row)), in param_tys)
}

// `Body::indirect`.
fn indirect(
    inout st: St,
    inout cx: Cx,
    in a: Ast,
    e: u32,
    fn_ty: u32,
    args: u32,
    expected: u32
) -> u32 {
    let fn_node = ty_node(in st, fn_ty);
    let argc = list_len(in a, args);
    if fn_node.k == T_FN && widen_u64(fn_node.n) == argc {
        for i in 0..argc {
            let param_ty = ty_item(in st, fn_ty, i);
            let arg_expr = (argn(in a, list_at(in a, args, i)).expr);
            let arg_ty = expr(inout st, inout cx, in a, arg_expr, param_ty);
            expect_s(
                inout st,
                in cx,
                param_ty,
                arg_ty,
                widen_u64(expr_at(in a, arg_expr).start),
                widen_u64(expr_at(in a, arg_expr).end),
                in "argument"
            );
        }
        return fn_node.c;
    }
    let tys = args_none(inout st, inout cx, in a, args);
    let mut any = expected != NONE && has_tensor(in st, expected);
    for i in 0..tys.len() {
        if has_tensor(in st, u32_at(in tys, i)) {
            any = true;
        }
    }
    if any {
        err_s(
            inout st,
            C_UNSUPPORTED,
            widen_u64(expr_at(in a, e).start),
            widen_u64(expr_at(in a, e).end),
            in "a call through a function value whose type is not known cannot pass or return tensors; annotate the function value with a `fn(..) -> ..` type"
        );
    }
    st.unknown
}

// `strip_flexible`.
fn strip_flexible(inout st: St, t: u32) -> u32 {
    let node = ty_node(in st, t);
    if node.k == T_VAR && (st.names.size(node.a) > 0 && st.names.byte(node.a, 0) == 63) {
        return st.unknown;
    }
    if node.k == T_ADT {
        let mut items = ChunkSeq::new[u32]();
        for i in 0..widen_u64(node.n) {
            let tag = ty_item(in st, t, wrapping_mul(i, 2));
            let id = ty_item(in st, t, inc(wrapping_mul(i, 2)));
            items.push(tag);
            if tag == 0 {
                items.push(strip_flexible(inout st, id));
            } else {
                items.push(id);
            }
        }
        return mk_ty(inout st, T_ADT, node.a, 0, in items);
    }
    if node.k == T_TUPLE || node.k == T_FN {
        let mut items = ChunkSeq::new[u32]();
        for i in 0..widen_u64(node.n) {
            items.push(strip_flexible(inout st, ty_item(in st, t, i)));
        }
        let mut result: u32 = 0;
        if node.k == T_FN {
            result = strip_flexible(inout st, node.c);
        }
        return mk_ty(inout st, node.k, 0, result, in items);
    }
    t
}

// `Obligation::subst` with the one-pass environment `env`: NONE `k` (255)
// on overflow.
fn ob_subst(inout st: St, in env: Subst, ob: Ob) -> Ob {
    let d1 = dim_subst1(inout st, in env, ob.d1);
    let mut d2 = ob.d2;
    if ob.k == 1 && d1 != NONE {
        d2 = dim_subst1(inout st, in env, ob.d2);
    }
    if d1 == NONE || d2 == NONE {
        return Ob { k: 255, d1: 0, d2: 0, r: 0 };
    }
    Ob { k: ob.k, d1: d1, d2: d2, r: ob.r }
}

// `Body::apply`: instantiate signature `row` (or the constructor in the
// `ctor_*` lists when `row` is NONE) at a call.
fn apply(
    inout st: St,
    inout cx: Cx,
    in a: Ast,
    e: u32,
    name: u32,
    in gnames: ChunkSeq[u32],
    in gkinds: ChunkSeq[u8],
    in ptys: ChunkSeq[u32],
    result0: u32,
    pool: u8,
    pkv: u32,
    phd: u32,
    in obs: ChunkSeq[Ob],
    types: u32,
    args: u32,
    expected: u32
) -> u32 {
    let start = widen_u64(expr_at(in a, e).start);
    let end = widen_u64(expr_at(in a, e).end);
    let mut renaming = subst_new();
    let mut fresh = ChunkSeq::new[u32]();
    fresh_generics(inout st, inout cx, in gnames, in gkinds, inout renaming, inout fresh);
    let mut subst = subst_new();
    let type_arg_count = list_len(in a, types);
    if type_arg_count > 0 && type_arg_count == gnames.len() {
        for i in 0..type_arg_count {
            let generic = u32_at(in gnames, i);
            let kind = u8_at(in gkinds, i);
            let type_arg = list_at(in a, types, i);
            let fresh_var = fresh_of(in gnames, in fresh, generic);
            if kind == KD_DIM {
                let dim = scope_dim(inout st, in cx, in a, type_arg);
                if dim == NONE {
                    err_last(inout st, C_KIND, start, end);
                } else {
                    set_dim(inout subst, fresh_var, dim);
                }
            } else if kind == KD_DTYPE {
                let dtype = scope_dtype(inout st, in cx, in a, type_arg);
                if dtype == NONE {
                    err_last(inout st, C_KIND, start, end);
                } else {
                    set_dtype(inout subst, fresh_var, dtype);
                }
            } else {
                let arg_ty = scope_ty(inout st, in cx, in a, type_arg);
                if arg_ty == NONE {
                    err_last(inout st, C_KIND, start, end);
                } else {
                    set_ty(inout subst, fresh_var, arg_ty);
                }
            }
        }
    }
    let result = sub_ty_or(inout st, in renaming, result0, st.unknown);
    if expected != NONE {
        let checkpoint = mark(in subst);
        if unify(inout st, inout subst, result, expected) != 0 {
            undo(inout subst, checkpoint);
        }
    }
    let cur = cx.cur;
    if pool == 1 && cur != NONE && u8_at(in cx.sg_pool, widen_u64(cur)) == 1 {
        let caller_kv = u32_at(in cx.sg_kv, widen_u64(cur));
        let caller_hd = u32_at(in cx.sg_hd, widen_u64(cur));
        let callee_kv = sub_dim_or(inout st, in renaming, pkv);
        let callee_hd = sub_dim_or(inout st, in renaming, phd);
        let mut bad = unify_dim(inout st, inout subst, callee_kv, caller_kv) != 0;
        if !bad {
            bad = unify_dim(inout st, inout subst, callee_hd, caller_hd) != 0;
        }
        if bad {
            let callee_kv_solved = sub_dim_or(inout st, in subst, callee_kv);
            let callee_hd_solved = sub_dim_or(inout st, in subst, callee_hd);
            let mut message = ChunkSeq::new[u8]();
            message.push(39);
            st.names.write(name, inout message);
            put(inout message, in "' uses KvCachePool[");
            put_dim(in st, inout message, callee_kv_solved);
            put(inout message, in ", ");
            put_dim(in st, inout message, callee_hd_solved);
            put(inout message, in "] but the caller's row has KvCachePool[");
            put_dim(in st, inout message, caller_kv);
            put(inout message, in ", ");
            put_dim(in st, inout message, caller_hd);
            message.push(93);
            push_diag(inout st, C_POOL, start, end, in message);
        }
    }
    for i in 0..list_len(in a, args) {
        let arg_expr = (argn(in a, list_at(in a, args, i)).expr);
        if i >= ptys.len() {
            let t = expr(inout st, inout cx, in a, arg_expr, NONE);
            continue;
        }
        let param_ty = sub_ty_or(inout st, in renaming, u32_at(in ptys, i), st.unknown);
        let want = sub_ty_or(inout st, in subst, param_ty, st.unknown);
        let got = expr(inout st, inout cx, in a, arg_expr, want);
        if has_tensor(in st, param_ty) && got == st.unknown {
            let mut message = ChunkSeq::new[u8]();
            put(inout message, in "cannot determine the shape of argument ");
            push_decimal(inout message, inc(i));
            put(inout message, in " of '");
            st.names.write(name, inout message);
            put(inout message, in "'; annotate it");
            push_diag(
                inout st,
                C_INFER,
                (widen_u64(expr_at(in a, arg_expr).start)),
                (widen_u64(expr_at(in a, arg_expr).end)),
                in message
            );
            continue;
        }
        let code = unify(inout st, inout subst, param_ty, got);
        if code != 0 {
            let mut reason = ChunkSeq::new[u8]();
            reason.extend(in st.err.as_slice());
            let want2 = sub_ty_or(inout st, in subst, param_ty, param_ty);
            let mut message = ChunkSeq::new[u8]();
            put(inout message, in "argument ");
            push_decimal(inout message, inc(i));
            put(inout message, in " of '");
            st.names.write(name, inout message);
            put(inout message, in "': expected ");
            put_ty(in st, inout message, want2);
            put(inout message, in ", found ");
            put_ty(in st, inout message, got);
            if reason.len() > 0 {
                put(inout message, in " (");
                message.extend(in reason.as_slice());
                message.push(41);
            }
            push_diag(
                inout st,
                code,
                (widen_u64(expr_at(in a, arg_expr).start)),
                (widen_u64(expr_at(in a, arg_expr).end)),
                in message
            );
        }
    }
    let code = settle(inout st, inout subst);
    if code != 0 {
        let mut message = ChunkSeq::new[u8]();
        put(inout message, in "call of '");
        st.names.write(name, inout message);
        put(inout message, in "': ");
        message.extend(in st.err.as_slice());
        push_diag(inout st, code, start, end, in message);
    }
    let mut env = subst_new();
    let mut dims = ChunkSeq::new[u32]();
    for i in 0..gnames.len() {
        if u8_at(in gkinds, i) != KD_DIM {
            continue;
        }
        let generic = u32_at(in gnames, i);
        let fresh_var = fresh_of(in gnames, in fresh, generic);
        let fresh_dim = dim_var(inout st, fresh_var);
        let solved = sub_dim(inout st, in subst, fresh_dim);
        if solved != NONE && !dim_flexible(in st, solved) {
            set_dim(inout env, generic, solved);
            dims.push(solved);
        } else {
            let mut message = ChunkSeq::new[u8]();
            put(inout message, in "cannot infer dimension '");
            st.names.write(generic, inout message);
            put(inout message, in "' of '");
            st.names.write(name, inout message);
            put(inout message, in "'; annotate an argument or the result");
            push_diag(inout st, C_INFER, start, end, in message);
            return st.unknown;
        }
    }
    for i in 0..obs.len() {
        let raw_ob = match obs.try_get(i) {
            Option::Some(ob) => ob,
            Option::None => Ob { k: 0, d1: 0, d2: 0, r: 0 },
        };
        let ob = ob_subst(inout st, in env, raw_ob);
        if ob.k == 255 {
            let mut message = ChunkSeq::new[u8]();
            put_dim_error(inout message, st.derr);
            push_diag(inout st, C_DIM, start, end, in message);
            continue;
        }
        if decide(in st, ob) == 0 {
            let mut message = ChunkSeq::new[u8]();
            put(inout message, in "call of '");
            st.names.write(name, inout message);
            put(inout message, in "' violates its precondition: ");
            put_ob(in st, inout message, ob);
            push_diag(inout st, C_OBLIGATION, start, end, in message);
        } else {
            require(inout st, inout cx, ob, start, end);
        }
    }
    elab_insert(inout cx, start, end, 1, in dims);
    let out = sub_ty_or(inout st, in subst, result, st.unknown);
    strip_flexible(inout st, out)
}

// `apply` of the signature `row`.
fn apply_sig(
    inout st: St,
    inout cx: Cx,
    in a: Ast,
    e: u32,
    row: u32,
    types: u32,
    args: u32,
    expected: u32
) -> u32 {
    let mut gnames = ChunkSeq::new[u32]();
    let mut gkinds = ChunkSeq::new[u8]();
    for i in 0..widen_u64(u32_at(in cx.sg_gn, widen_u64(row))) {
        gnames.push(u32_at(
            in cx.sg_gsym,
            wrapping_add(widen_u64(u32_at(in cx.sg_ga, widen_u64(row))), i)
        ));
        gkinds.push(u8_at(
            in cx.sg_gkind,
            wrapping_add(widen_u64(u32_at(in cx.sg_ga, widen_u64(row))), i)
        ));
    }
    let mut ptys = ChunkSeq::new[u32]();
    for i in 0..widen_u64(u32_at(in cx.sg_pn, widen_u64(row))) {
        ptys.push(u32_at(
            in cx.sg_pty,
            wrapping_add(widen_u64(u32_at(in cx.sg_pa, widen_u64(row))), i)
        ));
    }
    let mut obs = ChunkSeq::new[Ob]();
    for i in 0..widen_u64(u32_at(in cx.sg_on, widen_u64(row))) {
        obs.push(ob_get(in cx, wrapping_add(widen_u64(u32_at(in cx.sg_oa, widen_u64(row))), i)));
    }
    apply(
        inout st,
        inout cx,
        in a,
        e,
        u32_at(in cx.sg_name, widen_u64(row)),
        in gnames,
        in gkinds,
        in ptys,
        u32_at(in cx.sg_res, widen_u64(row)),
        u8_at(in cx.sg_pool, widen_u64(row)),
        u32_at(in cx.sg_kv, widen_u64(row)),
        u32_at(in cx.sg_hd, widen_u64(row)),
        in obs,
        types,
        args,
        expected
    )
}

// `Body::call`.
fn call(inout st: St, inout cx: Cx, in a: Ast, e: u32, expected: u32) -> u32 {
    let node = expr_at(in a, e);
    let callee = node.a;
    let types = node.b;
    let args = node.c;
    let callee_node = expr_at(in a, callee);
    if callee_node.kind != 2 {
        let fn_ty = expr(inout st, inout cx, in a, callee, NONE);
        return indirect(inout st, inout cx, in a, e, fn_ty, args, expected);
    }
    let name = nm(in st, callee_node.a);
    let op = strip_prefix(inout st, name, in "Tensor::");
    if op != NONE {
        return tensor_op(inout st, inout cx, in a, e, op, types, args, expected);
    }
    let pool_op_name = strip_prefix(inout st, name, in "KvCachePool::");
    if pool_op_name != NONE {
        return pool_op(inout st, inout cx, in a, e, pool_op_name, args, expected);
    }
    let local = lookup(in cx, name);
    if local != NONE {
        return indirect(inout st, inout cx, in a, e, local, args, expected);
    }
    if (name == st.s_some || name == st.s_ok || name == st.s_err) && list_len(in a, args) == 1 {
        let expected_node = ty_node(in st, expected);
        let mut inner = NONE;
        if expected != NONE && expected_node.k == T_ADT {
            if name == st.s_err {
                inner = adt_ty_arg(in st, expected, 1);
            } else {
                inner = adt_ty_arg(in st, expected, 0);
            }
        }
        let payload_ty = expr(
            inout st,
            inout cx,
            in a,
            (argn(in a, list_at(in a, args, 0)).expr),
            inner
        );
        let mut ok_ty = st.unknown;
        let mut err_ty = st.unknown;
        if expected != NONE && expected_node.k == T_ADT {
            ok_ty = or_unknown(in st, adt_ty_arg(in st, expected, 0));
            err_ty = or_unknown(in st, adt_ty_arg(in st, expected, 1));
        }
        if name == st.s_some {
            return adt1(inout st, st.s_option, payload_ty);
        }
        if name == st.s_ok {
            return adt2(inout st, st.s_result, payload_ty, err_ty);
        }
        return adt2(inout st, st.s_result, ok_ty, payload_ty);
    }
    let row = at32(in cx.sg_row, name);
    if row != NONE {
        return apply_sig(inout st, inout cx, in a, e, row, types, args, expected);
    }
    // A tuple-variant constructor of a user enum.
    let variant = last_segment(inout st, name);
    let info_row = adt_with_variant(in st, in cx, variant, true);
    if info_row != NONE {
        let adt = u32_at(in cx.ai_name, widen_u64(info_row));
        let variant_row = info_variant(in st, in cx, info_row, variant);
        let mut ptys = ChunkSeq::new[u32]();
        for i in 0..widen_u64(u32_at(in cx.vr_fn, widen_u64(variant_row))) {
            ptys.push(u32_at(
                in cx.fr_ty,
                wrapping_add(widen_u64(u32_at(in cx.vr_fa, widen_u64(variant_row))), i)
            ));
        }
        let generic_count = info_gen_count(in cx, info_row);
        let mut gnames = ChunkSeq::new[u32]();
        let mut gkinds = ChunkSeq::new[u8]();
        let mut items = ChunkSeq::new[u32]();
        for i in 0..generic_count {
            let generic = u32_at(
                in cx.ai_syms,
                wrapping_add(widen_u64(u32_at(in cx.ai_ga, widen_u64(info_row))), i)
            );
            let kind = u8_at(
                in cx.ai_kinds,
                wrapping_add(widen_u64(u32_at(in cx.ai_ka, widen_u64(info_row))), i)
            );
            gnames.push(generic);
            gkinds.push(kind);
            if kind == KD_DIM {
                items.push(1);
                items.push(dim_var(inout st, generic));
            } else if kind == KD_DTYPE {
                items.push(2);
                items.push(wrapping_add(3, wrapping_mul(generic, 2)));
            } else {
                items.push(0);
                items.push(ty_named(inout st, T_VAR, generic));
            }
        }
        let ctor_ty = mk_ty(inout st, T_ADT, adt, 0, in items);
        let obs = ChunkSeq::new[Ob]();
        let out = apply(
            inout st,
            inout cx,
            in a,
            e,
            name,
            in gnames,
            in gkinds,
            in ptys,
            ctor_ty,
            0,
            0,
            0,
            in obs,
            0,
            args,
            expected
        );
        let expr_node = expr_at(in a, e);
        elab_remove(inout cx, widen_u64(expr_node.start), widen_u64(expr_node.end));
        return out;
    }
    let tys = args_none(inout st, inout cx, in a, args);
    st.unknown
}

// `Body::arity` of a tensor operation.
fn arity(inout st: St, inout cx: Cx, in a: Ast, e: u32, op: u32, args: u32, n: u64) -> bool {
    let argc = list_len(in a, args);
    if argc == n {
        return true;
    }
    let tys = args_none(inout st, inout cx, in a, args);
    let mut message = ChunkSeq::new[u8]();
    put(inout message, in "Tensor::");
    st.names.write(op, inout message);
    put(inout message, in " takes ");
    push_decimal(inout message, n);
    put(inout message, in " argument(s), found ");
    push_decimal(inout message, argc);
    push_diag(
        inout st,
        C_SHAPE,
        (widen_u64(expr_at(in a, e).start)),
        (widen_u64(expr_at(in a, e).end)),
        in message
    );
    false
}

// `Body::target_shape`: the shape into `out`, or false.
fn target_shape(
    inout st: St,
    in cx: Cx,
    in a: Ast,
    e: u32,
    op: u32,
    types: u32,
    expected: u32,
    inout out: ChunkSeq[u32]
) -> bool {
    let start = widen_u64(expr_at(in a, e).start);
    let end = widen_u64(expr_at(in a, e).end);
    let type_arg_count = list_len(in a, types);
    out.clear();
    if type_arg_count == 1 {
        if scope_shape(inout st, in cx, in a, list_at(in a, types, 0), inout out) {
            return true;
        }
        err_last(inout st, C_KIND, start, end);
        return false;
    }
    if type_arg_count == 0 {
        if expected != NONE && (ty_node(in st, expected).k == T_TENSOR) {
            for i in 0..widen_u64(ty_node(in st, expected).n) {
                out.push(ty_item(in st, expected, i));
            }
            return true;
        }
        let mut message = ChunkSeq::new[u8]();
        put(inout message, in "Tensor::");
        st.names.write(op, inout message);
        put(inout message, in " needs a target shape: Tensor::");
        st.names.write(op, inout message);
        put(inout message, in "[[d, ...]](...)");
        push_diag(inout st, C_INFER, start, end, in message);
        return false;
    }
    let mut message = ChunkSeq::new[u8]();
    put(inout message, in "Tensor::");
    st.names.write(op, inout message);
    put(inout message, in " takes one shape argument");
    push_diag(inout st, C_KIND, start, end, in message);
    false
}

// `elements(shape)`: the product, or NONE with `derr`.
fn elements(inout st: St, in shape: ChunkSeq[u32]) -> u32 {
    let mut acc = st.one;
    for i in 0..shape.len() {
        acc = dim_mul(inout st, acc, u32_at(in shape, i));
        if acc == NONE {
            return NONE;
        }
    }
    acc
}

// `Tensor::{op}: {m}` (the `mismatch` closure).
fn mismatch(inout st: St, op: u32, start: u64, end: u64, in detail: ChunkSeq[u8]) -> u32 {
    let mut message = ChunkSeq::new[u8]();
    put(inout message, in "Tensor::");
    st.names.write(op, inout message);
    put(inout message, in ": ");
    message.extend(in detail.as_slice());
    push_diag(inout st, C_SHAPE, start, end, in message);
    st.unknown
}

// "expected {what}, found {shape}".
fn rank_msg(in st: St, in what: Str, in shape: ChunkSeq[u32]) -> ChunkSeq[u8] {
    let mut message = ChunkSeq::new[u8]();
    put(inout message, in "expected ");
    put(inout message, in what);
    put(inout message, in ", found ");
    put_shape(in st, inout message, in shape);
    message
}

// `broadcast(a, b)`: the shape into `out`, or false with the message.
fn broadcast(
    inout st: St,
    in lhs: ChunkSeq[u32],
    in rhs: ChunkSeq[u32],
    inout out: ChunkSeq[u32],
    inout msg: ChunkSeq[u8]
) -> bool {
    let mut n = lhs.len();
    if rhs.len() > n {
        n = rhs.len();
    }
    let one = st.one;
    out.clear();
    for i in 0..n {
        let mut lhs_dim = one;
        let mut rhs_dim = one;
        if wrapping_add(i, lhs.len()) >= n {
            lhs_dim = u32_at(in lhs, wrapping_sub(wrapping_add(i, lhs.len()), n));
        }
        if wrapping_add(i, rhs.len()) >= n {
            rhs_dim = u32_at(in rhs, wrapping_sub(wrapping_add(i, rhs.len()), n));
        }
        if lhs_dim == rhs_dim || rhs_dim == one {
            out.push(lhs_dim);
        } else if lhs_dim == one {
            out.push(rhs_dim);
        } else {
            put_shape(in st, inout msg, in lhs);
            put(inout msg, in " and ");
            put_shape(in st, inout msg, in rhs);
            put(inout msg, in " do not broadcast: axis ");
            push_decimal(inout msg, i);
            put(inout msg, in " has ");
            put_dim(in st, inout msg, lhs_dim);
            put(inout msg, in " and ");
            put_dim(in st, inout msg, rhs_dim);
            return false;
        }
    }
    true
}

// The arity of a tensor operation, 0 for an unknown one.
fn tensor_arity(in st: St, op: u32) -> u64 {
    if spells(in st, op, in "matmul")
        || spells(in st, op, in "matvec")
        || spells(in st, op, in "add")
        || spells(in st, op, in "mul")
        || spells(in st, op, in "swiglu")
        || spells(in st, op, in "qmatvec")
        || spells(in st, op, in "rope") {
        return 2;
    }
    if spells(in st, op, in "reshape")
        || spells(in st, op, in "transpose")
        || spells(in st, op, in "softmax")
        || spells(in st, op, in "silu")
        || spells(in st, op, in "to_bf16")
        || spells(in st, op, in "to_f32")
        || spells(in st, op, in "argmax")
        || spells(in st, op, in "fill") {
        return 1;
    }
    if spells(in st, op, in "rms_norm") || spells(in st, op, in "block_scale") {
        return 3;
    }
    0
}

// `Body::tensor_op`.
fn tensor_op(
    inout st: St,
    inout cx: Cx,
    in a: Ast,
    e: u32,
    op: u32,
    types: u32,
    args: u32,
    expected: u32
) -> u32 {
    let start = widen_u64(expr_at(in a, e).start);
    let end = widen_u64(expr_at(in a, e).end);
    let op_arity = tensor_arity(in st, op);
    if op_arity == 0 {
        let tys = args_none(inout st, inout cx, in a, args);
        let mut message = ChunkSeq::new[u8]();
        put(inout message, in "unknown tensor operation 'Tensor::");
        st.names.write(op, inout message);
        message.push(39);
        push_diag(inout st, C_UNSUPPORTED, start, end, in message);
        return st.unknown;
    }
    let is_reshape = spells(in st, op, in "reshape");
    let is_fill = spells(in st, op, in "fill");
    if !is_reshape && !is_fill && list_len(in a, types) > 0 {
        let mut message = ChunkSeq::new[u8]();
        put(inout message, in "Tensor::");
        st.names.write(op, inout message);
        put(inout message, in " takes no type arguments");
        push_diag(inout st, C_KIND, start, end, in message);
    }
    if !arity(inout st, inout cx, in a, e, op, args, op_arity) {
        return st.unknown;
    }
    if is_fill {
        let arg0_ty = expr(
            inout st,
            inout cx,
            in a,
            (argn(in a, list_at(in a, args, 0)).expr),
            NONE
        );
        let mut shape = ChunkSeq::new[u32]();
        if !target_shape(inout st, in cx, in a, e, op, types, expected, inout shape) {
            return st.unknown;
        }
        elab_insert(inout cx, start, end, 2, in shape);
        return mk_ty(inout st, T_TENSOR, 0, 0, in shape);
    }
    let tys = args_none(inout st, inout cx, in a, args);
    let mut arg0_start: u64 = 0;
    let mut arg0_end: u64 = 0;
    let mut arg1_start: u64 = 0;
    let mut arg1_end: u64 = 0;
    if op_arity >= 1 {
        arg0_start = widen_u64(expr_at(in a, ((argn(in a, list_at(in a, args, 0)).expr))).start);
        arg0_end = widen_u64(expr_at(in a, ((argn(in a, list_at(in a, args, 0)).expr))).end);
    }
    if op_arity >= 2 {
        arg1_start = widen_u64(expr_at(in a, ((argn(in a, list_at(in a, args, 1)).expr))).start);
        arg1_end = widen_u64(expr_at(in a, ((argn(in a, list_at(in a, args, 1)).expr))).end);
    }
    let arg0_ty = u32_at(in tys, 0);
    let arg1_ty = u32_at(in tys, 1);
    let arg0_what = arg_what(in st, 0, in "Tensor::", op);
    let arg1_what = arg_what(in st, 1, in "Tensor::", op);
    let is_matmul = spells(in st, op, in "matmul");
    if is_matmul
        || spells(in st, op, in "matvec")
        || spells(in st, op, in "add")
        || spells(in st, op, in "mul")
        || spells(in st, op, in "swiglu") {
        let ok0 = want_tensor(inout st, arg0_ty, arg0_start, arg0_end, in arg0_what);
        let ok1 = want_tensor(inout st, arg1_ty, arg1_start, arg1_end, in arg1_what);
        if !ok0 || !ok1 {
            return st.unknown;
        }
        if !want_f32(inout st, (ty_node(in st, arg0_ty).a), arg0_start, arg0_end, in arg0_what)
            || !want_f32(
                inout st,
                (ty_node(in st, arg1_ty).a),
                arg1_start,
                arg1_end,
                in arg1_what
            ) {
            return st.unknown;
        }
        let lhs_shape = ty_items(in st, arg0_ty);
        let rhs_shape = ty_items(in st, arg1_ty);
        if is_matmul || spells(in st, op, in "matvec") {
            let mut rhs_rank: u64 = 1;
            if is_matmul {
                rhs_rank = 2;
            }
            if lhs_shape.len() != 2 || rhs_shape.len() != rhs_rank {
                let mut message = ChunkSeq::new[u8]();
                put(inout message, in "expected ranks 2 and ");
                push_decimal(inout message, rhs_rank);
                put(inout message, in ", found ");
                put_shape(in st, inout message, in lhs_shape);
                put(inout message, in " and ");
                put_shape(in st, inout message, in rhs_shape);
                return mismatch(inout st, op, start, end, in message);
            }
            if u32_at(in lhs_shape, 1) != u32_at(in rhs_shape, 0) {
                let mut message = ChunkSeq::new[u8]();
                put(inout message, in "inner dimensions differ: ");
                put_shape(in st, inout message, in lhs_shape);
                put(inout message, in " has ");
                put_dim(in st, inout message, u32_at(in lhs_shape, 1));
                put(inout message, in " columns but ");
                put_shape(in st, inout message, in rhs_shape);
                put(inout message, in " has ");
                put_dim(in st, inout message, u32_at(in rhs_shape, 0));
                put(inout message, in " rows");
                return mismatch(inout st, op, start, end, in message);
            }
            let mut shape = ChunkSeq::new[u32]();
            shape.push(u32_at(in lhs_shape, 0));
            if is_matmul {
                shape.push(u32_at(in rhs_shape, 1));
            }
            return mk_ty(inout st, T_TENSOR, 0, 0, in shape);
        }
        if spells(in st, op, in "swiglu") {
            if arg0_ty != arg1_ty {
                let mut message = ChunkSeq::new[u8]();
                put(inout message, in "gate ");
                put_shape(in st, inout message, in lhs_shape);
                put(inout message, in " and up ");
                put_shape(in st, inout message, in rhs_shape);
                put(inout message, in " must have the same shape");
                return mismatch(inout st, op, start, end, in message);
            }
            return mk_ty(inout st, T_TENSOR, 0, 0, in lhs_shape);
        }
        let mut out = ChunkSeq::new[u32]();
        let mut message = ChunkSeq::new[u8]();
        if broadcast(inout st, in lhs_shape, in rhs_shape, inout out, inout message) {
            return mk_ty(inout st, T_TENSOR, 0, 0, in out);
        }
        return mismatch(inout st, op, start, end, in message);
    }
    if is_reshape {
        if !want_tensor(inout st, arg0_ty, arg0_start, arg0_end, in arg0_what) {
            return st.unknown;
        }
        let dtype = (ty_node(in st, arg0_ty).a);
        let arg_shape = ty_items(in st, arg0_ty);
        let mut target = ChunkSeq::new[u32]();
        if !target_shape(inout st, in cx, in a, e, op, types, expected, inout target) {
            return st.unknown;
        }
        let elem_count = elements(inout st, in arg_shape);
        let elem_err = st.derr;
        let target_count = elements(inout st, in target);
        let target_err = st.derr;
        if elem_count == NONE || target_count == NONE {
            let mut message = ChunkSeq::new[u8]();
            if elem_count == NONE {
                put_dim_error(inout message, elem_err);
            } else {
                put_dim_error(inout message, target_err);
            }
            return mismatch(inout st, op, start, end, in message);
        }
        if elem_count != target_count {
            let mut message = ChunkSeq::new[u8]();
            put_shape(in st, inout message, in arg_shape);
            put(inout message, in " has ");
            put_dim(in st, inout message, elem_count);
            put(inout message, in " elements but ");
            put_shape(in st, inout message, in target);
            put(inout message, in " has ");
            put_dim(in st, inout message, target_count);
            return mismatch(inout st, op, start, end, in message);
        }
        elab_insert(inout cx, start, end, 2, in target);
        return mk_ty(inout st, T_TENSOR, dtype, 0, in target);
    }
    if spells(in st, op, in "transpose")
        || spells(in st, op, in "softmax")
        || spells(in st, op, in "argmax")
        || spells(in st, op, in "silu")
        || spells(in st, op, in "rope") {
        if !want_tensor(inout st, arg0_ty, arg0_start, arg0_end, in arg0_what) {
            return st.unknown;
        }
        let dtype = (ty_node(in st, arg0_ty).a);
        if !want_f32(inout st, dtype, arg0_start, arg0_end, in arg0_what) {
            return st.unknown;
        }
        let arg_shape = ty_items(in st, arg0_ty);
        if spells(in st, op, in "transpose") {
            if arg_shape.len() != 2 {
                let message = rank_msg(in st, in "rank 2", in arg_shape);
                return mismatch(inout st, op, start, end, in message);
            }
            let mut shape = ChunkSeq::new[u32]();
            shape.push(u32_at(in arg_shape, 1));
            shape.push(u32_at(in arg_shape, 0));
            return mk_ty(inout st, T_TENSOR, dtype, 0, in shape);
        }
        if spells(in st, op, in "silu") {
            return arg0_ty;
        }
        if spells(in st, op, in "rope") {
            if arg_shape.len() != 2 {
                let message = rank_msg(in st, in "[Heads, HeadDim]", in arg_shape);
                return mismatch(inout st, op, start, end, in message);
            }
            let reason = name_s(inout st, in "RoPE head width");
            require(
                inout st,
                inout cx,
                Ob { k: 0, d1: u32_at(in arg_shape, 1), d2: 0, r: reason },
                start,
                end
            );
            return arg0_ty;
        }
        if arg_shape.len() != 1 {
            let message = rank_msg(in st, in "rank 1", in arg_shape);
            return mismatch(inout st, op, start, end, in message);
        }
        if spells(in st, op, in "argmax") {
            return ty_named(inout st, T_BASE, st.s_u64);
        }
        return arg0_ty;
    }
    if spells(in st, op, in "to_bf16") || spells(in st, op, in "to_f32") {
        if !want_tensor(inout st, arg0_ty, arg0_start, arg0_end, in arg0_what) {
            return st.unknown;
        }
        let dtype = (ty_node(in st, arg0_ty).a);
        let mut from: u32 = 1;
        let mut to: u32 = 0;
        if spells(in st, op, in "to_bf16") {
            from = 0;
            to = 1;
        }
        if dtype != from {
            let mut message = ChunkSeq::new[u8]();
            put(inout message, in "Tensor::");
            st.names.write(op, inout message);
            put(inout message, in " converts ");
            put_dtype(in st, inout message, from);
            put(inout message, in " tensors, found ");
            put_dtype(in st, inout message, dtype);
            push_diag(inout st, C_DTYPE, arg0_start, arg0_end, in message);
            return st.unknown;
        }
        let arg_shape = ty_items(in st, arg0_ty);
        return mk_ty(inout st, T_TENSOR, to, 0, in arg_shape);
    }
    if spells(in st, op, in "rms_norm") {
        let ok0 = want_tensor(inout st, arg0_ty, arg0_start, arg0_end, in arg0_what);
        let ok1 = want_tensor(inout st, arg1_ty, arg1_start, arg1_end, in arg1_what);
        if !ok0 || !ok1 {
            return st.unknown;
        }
        if !want_f32(inout st, (ty_node(in st, arg0_ty).a), arg0_start, arg0_end, in arg0_what)
            || !want_f32(
                inout st,
                (ty_node(in st, arg1_ty).a),
                arg1_start,
                arg1_end,
                in arg1_what
            ) {
            return st.unknown;
        }
        let input_shape = ty_items(in st, arg0_ty);
        let weight_shape = ty_items(in st, arg1_ty);
        if input_shape.len() != 1 || arg0_ty != arg1_ty {
            let mut message = ChunkSeq::new[u8]();
            put(inout message, in "x ");
            put_shape(in st, inout message, in input_shape);
            put(inout message, in " and weight ");
            put_shape(in st, inout message, in weight_shape);
            put(inout message, in " must be the same rank-1 shape");
            return mismatch(inout st, op, start, end, in message);
        }
        return arg0_ty;
    }
    // qmatvec and block_scale.
    if !want_tensor(inout st, arg0_ty, arg0_start, arg0_end, in arg0_what) {
        return st.unknown;
    }
    let weight_dtype = (ty_node(in st, arg0_ty).a);
    if !(weight_dtype >= 2 && (weight_dtype & 1) == 0) {
        let mut message = ChunkSeq::new[u8]();
        put(inout message, in "argument 1 of Tensor::");
        st.names.write(op, inout message);
        put(inout message, in " must be a quantized block tensor, found ");
        put_dtype(in st, inout message, weight_dtype);
        push_diag(inout st, C_DTYPE, arg0_start, arg0_end, in message);
        return st.unknown;
    }
    let block = (wrapping_sub(weight_dtype, 2) >> 1);
    let wire_status = at32(in cx.wire, block);
    if wire_status == NONE || wire_status == 0 {
        return st.unknown;
    }
    if wire_status >= 2 {
        let row = widen_u64(wrapping_sub(wire_status, 2));
        let msg_start = u64_at(in cx.wa, row);
        let msg_end = u64_at(in cx.wb, row);
        let mut message = ChunkSeq::new[u8]();
        for i in msg_start..msg_end {
            message.push(u8_at(in cx.wtext, i));
        }
        push_diag(inout st, C_WIRE, arg0_start, arg0_end, in message);
        return st.unknown;
    }
    let weight_shape = ty_items(in st, arg0_ty);
    if weight_shape.len() != 2 {
        let message = rank_msg(in st, in "[Rows, Cols]", in weight_shape);
        return mismatch(inout st, op, start, end, in message);
    }
    let mut reason_text = ChunkSeq::new[u8]();
    put(inout reason_text, in "whole 32-element ");
    st.names.write(block, inout reason_text);
    put(inout reason_text, in " blocks per row");
    let reason = st.names.intern(in reason_text.as_slice());
    let block_width = dim_const(inout st, 32);
    require(
        inout st,
        inout cx,
        Ob { k: 1, d1: block_width, d2: u32_at(in weight_shape, 1), r: reason },
        start,
        end
    );
    if spells(in st, op, in "block_scale") {
        return ty_named(inout st, T_BASE, st.s_f64);
    }
    if !want_tensor(inout st, arg1_ty, arg1_start, arg1_end, in arg1_what) {
        return st.unknown;
    }
    if !want_f32(inout st, (ty_node(in st, arg1_ty).a), arg1_start, arg1_end, in arg1_what) {
        return st.unknown;
    }
    let input_shape = ty_items(in st, arg1_ty);
    if input_shape.len() != 1 || u32_at(in input_shape, 0) != u32_at(in weight_shape, 1) {
        let mut message = ChunkSeq::new[u8]();
        put(inout message, in "weights ");
        put_shape(in st, inout message, in weight_shape);
        put(inout message, in " need an input of shape [");
        put_dim(in st, inout message, u32_at(in weight_shape, 1));
        put(inout message, in "], found ");
        put_shape(in st, inout message, in input_shape);
        return mismatch(inout st, op, start, end, in message);
    }
    let mut shape = ChunkSeq::new[u32]();
    shape.push(u32_at(in weight_shape, 0));
    mk_ty(inout st, T_TENSOR, 0, 0, in shape)
}

// `Body::pool_dims`.
fn pool_dims(inout st: St, in cx: Cx, kv: u32, hd: u32, start: u64, end: u64) {
    let cur = cx.cur;
    if cur == NONE || u8_at(in cx.sg_pool, widen_u64(cur)) != 1 {
        return;
    }
    let row_kv = u32_at(in cx.sg_kv, widen_u64(cur));
    let row_hd = u32_at(in cx.sg_hd, widen_u64(cur));
    if row_kv != kv || row_hd != hd {
        let mut message = ChunkSeq::new[u8]();
        put(inout message, in "this lease belongs to KvCachePool[");
        put_dim(in st, inout message, kv);
        put(inout message, in ", ");
        put_dim(in st, inout message, hd);
        put(inout message, in "] but the function's row has KvCachePool[");
        put_dim(in st, inout message, row_kv);
        put(inout message, in ", ");
        put_dim(in st, inout message, row_hd);
        message.push(93);
        push_diag(inout st, C_POOL, start, end, in message);
    }
}

fn pool_arity(in st: St, op: u32) -> u64 {
    if spells(in st, op, in "begin_sequence") {
        return 1;
    }
    if spells(in st, op, in "lease_page") {
        return 0;
    }
    if spells(in st, op, in "append_kv_step") || spells(in st, op, in "write_page") {
        return 3;
    }
    if spells(in st, op, in "attend") {
        return 2;
    }
    if spells(in st, op, in "tokens")
        || spells(in st, op, in "page_tokens")
        || spells(in st, op, in "release_sequence")
        || spells(in st, op, in "release_page") {
        return 1;
    }
    9
}

fn result_of(inout st: St, t: u32) -> u32 {
    let err_ty = ty_named(inout st, T_ADT, st.s_kverr);
    adt2(inout st, st.s_result, t, err_ty)
}

// `Body::pool_op`.
fn pool_op(
    inout st: St,
    inout cx: Cx,
    in a: Ast,
    e: u32,
    op: u32,
    args: u32,
    expected: u32
) -> u32 {
    let start = widen_u64(expr_at(in a, e).start);
    let end = widen_u64(expr_at(in a, e).end);
    let op_arity = pool_arity(in st, op);
    let argc = list_len(in a, args);
    if op_arity == 9 {
        let tys = args_none(inout st, inout cx, in a, args);
        let mut message = ChunkSeq::new[u8]();
        put(inout message, in "unknown pool operation 'KvCachePool::");
        st.names.write(op, inout message);
        message.push(39);
        push_diag(inout st, C_UNSUPPORTED, start, end, in message);
        return st.unknown;
    }
    if argc != op_arity {
        let tys = args_none(inout st, inout cx, in a, args);
        let mut message = ChunkSeq::new[u8]();
        put(inout message, in "KvCachePool::");
        st.names.write(op, inout message);
        put(inout message, in " takes ");
        push_decimal(inout message, op_arity);
        put(inout message, in " argument(s), found ");
        push_decimal(inout message, argc);
        push_diag(inout st, C_SHAPE, start, end, in message);
        return st.unknown;
    }
    let tys = args_none(inout st, inout cx, in a, args);
    let begin = spells(in st, op, in "begin_sequence");
    if begin || spells(in st, op, in "lease_page") {
        let mut expected_kv = NONE;
        let mut expected_hd = NONE;
        if expected != NONE {
            let expected_node = ty_node(in st, expected);
            if expected_node.k == T_ADT && expected_node.a == st.s_result {
                let payload_ty = adt_ty_arg(in st, expected, 0);
                if payload_ty != NONE {
                    let payload_node = ty_node(in st, payload_ty);
                    if (begin && payload_node.k == T_SEQ) || (!begin && payload_node.k == T_LEASE) {
                        expected_kv = payload_node.a;
                        expected_hd = payload_node.c;
                    }
                }
            }
        }
        let cur = cx.cur;
        let mut kv = expected_kv;
        let mut hd = expected_hd;
        if cur != NONE && u8_at(in cx.sg_pool, widen_u64(cur)) == 1 {
            kv = u32_at(in cx.sg_kv, widen_u64(cur));
            hd = u32_at(in cx.sg_hd, widen_u64(cur));
        }
        if kv == NONE {
            let mut message = ChunkSeq::new[u8]();
            put(inout message, in "KvCachePool::");
            st.names.write(op, inout message);
            put(
                inout message,
                in " needs the pool's dimensions: write KvCachePool[KvHeads, HeadDim] in the effect row or annotate the result"
            );
            push_diag(inout st, C_INFER, start, end, in message);
            return st.unknown;
        }
        if expected_kv != NONE {
            pool_dims(inout st, in cx, expected_kv, expected_hd, start, end);
        }
        if begin {
            let handle_ty = ty_pair(inout st, T_SEQ, kv, hd);
            return result_of(inout st, handle_ty);
        }
        let handle_ty = ty_pair(inout st, T_LEASE, kv, hd);
        return result_of(inout st, handle_ty);
    }
    let page = spells(in st, op, in "write_page")
        || spells(in st, op, in "page_tokens")
        || spells(in st, op, in "release_page");
    let arg0_ty = u32_at(in tys, 0);
    let arg0_node = ty_node(in st, arg0_ty);
    let arg0_expr = (argn(in a, list_at(in a, args, 0)).expr);
    if !((arg0_node.k == T_SEQ && !page) || (arg0_node.k == T_LEASE && page)) {
        let mut message = ChunkSeq::new[u8]();
        if arg0_node.k == T_UNKNOWN {
            put(
                inout message,
                in "cannot determine the pool instance of argument 1 of KvCachePool::"
            );
            st.names.write(op, inout message);
            push_diag(
                inout st,
                C_INFER,
                (widen_u64(expr_at(in a, arg0_expr).start)),
                (widen_u64(expr_at(in a, arg0_expr).end)),
                in message
            );
        } else {
            put(inout message, in "argument 1 of KvCachePool::");
            st.names.write(op, inout message);
            put(inout message, in " must be a ");
            if page {
                put(inout message, in "KvPageLease");
            } else {
                put(inout message, in "ActiveKvSeq");
            }
            put(inout message, in ", found ");
            put_ty(in st, inout message, arg0_ty);
            push_diag(
                inout st,
                C_SHAPE,
                (widen_u64(expr_at(in a, arg0_expr).start)),
                (widen_u64(expr_at(in a, arg0_expr).end)),
                in message
            );
        }
        return st.unknown;
    }
    let kv = arg0_node.a;
    let hd = arg0_node.c;
    pool_dims(
        inout st,
        in cx,
        kv,
        hd,
        widen_u64(expr_at(in a, arg0_expr).start),
        widen_u64(expr_at(in a, arg0_expr).end)
    );
    if spells(in st, op, in "append_kv_step") || spells(in st, op, in "write_page") {
        for i in 1..3 {
            let arg_ty = u32_at(in tys, i);
            let arg_expr = (argn(in a, list_at(in a, args, i)).expr);
            let what = arg_what(in st, i, in "KvCachePool::", op);
            if !want_tensor(
                inout st,
                arg_ty,
                widen_u64(expr_at(in a, arg_expr).start),
                widen_u64(expr_at(in a, arg_expr).end),
                in what
            ) {
                return st.unknown;
            }
            let dtype = (ty_node(in st, arg_ty).a);
            if dtype != 1 {
                let mut message = ChunkSeq::new[u8]();
                message.extend(in what.as_slice());
                put(inout message, in " must be a Bf16 K/V step, found ");
                put_dtype(in st, inout message, dtype);
                push_diag(
                    inout st,
                    C_DTYPE,
                    (widen_u64(expr_at(in a, arg_expr).start)),
                    (widen_u64(expr_at(in a, arg_expr).end)),
                    in message
                );
            }
            let step_shape = ty_items(in st, arg_ty);
            let mut want = ChunkSeq::new[u32]();
            want.push(kv);
            want.push(hd);
            let same = step_shape.len() == 2
                && u32_at(in step_shape, 0) == kv
                && u32_at(in step_shape, 1) == hd;
            if !same {
                let mut message = ChunkSeq::new[u8]();
                message.extend(in what.as_slice());
                put(inout message, in ": the pool stores ");
                put_shape(in st, inout message, in want);
                put(inout message, in " steps, found ");
                put_shape(in st, inout message, in step_shape);
                push_diag(
                    inout st,
                    C_SHAPE,
                    (widen_u64(expr_at(in a, arg_expr).start)),
                    (widen_u64(expr_at(in a, arg_expr).end)),
                    in message
                );
            }
        }
        return result_of(inout st, st.unit);
    }
    if spells(in st, op, in "attend") {
        let arg1_ty = u32_at(in tys, 1);
        let arg1_expr = (argn(in a, list_at(in a, args, 1)).expr);
        let mut what = ChunkSeq::new[u8]();
        put(inout what, in "argument 2 of KvCachePool::attend");
        if !want_tensor(
            inout st,
            arg1_ty,
            widen_u64(expr_at(in a, arg1_expr).start),
            widen_u64(expr_at(in a, arg1_expr).end),
            in what
        ) {
            return st.unknown;
        }
        if !want_f32(
            inout st,
            (ty_node(in st, arg1_ty).a),
            widen_u64(expr_at(in a, arg1_expr).start),
            widen_u64(expr_at(in a, arg1_expr).end),
            in what
        ) {
            return st.unknown;
        }
        let query_shape = ty_items(in st, arg1_ty);
        if query_shape.len() != 2 || u32_at(in query_shape, 1) != hd {
            let mut message = ChunkSeq::new[u8]();
            put(inout message, in "KvCachePool::attend: queries must be [QHeads, ");
            put_dim(in st, inout message, hd);
            put(inout message, in "], found ");
            put_shape(in st, inout message, in query_shape);
            push_diag(
                inout st,
                C_SHAPE,
                (widen_u64(expr_at(in a, arg1_expr).start)),
                (widen_u64(expr_at(in a, arg1_expr).end)),
                in message
            );
            return st.unknown;
        }
        let reason = name_s(inout st, in "grouped-query attention (QHeads % KvHeads == 0)");
        require(
            inout st,
            inout cx,
            Ob { k: 1, d1: kv, d2: u32_at(in query_shape, 0), r: reason },
            start,
            end
        );
        return mk_ty(inout st, T_TENSOR, 0, 0, in query_shape);
    }
    if spells(in st, op, in "tokens") || spells(in st, op, in "page_tokens") {
        return ty_named(inout st, T_BASE, st.s_u64);
    }
    st.unit
}

// `Body::let_statement`.
fn let_statement(inout st: St, inout cx: Cx, in a: Ast, p: u32, ty: u32, value: u32) {
    let mut annotated = NONE;
    if type_at(in a, ty).kind != 5 {
        let declared = scope_ty(inout st, in cx, in a, ty);
        if declared == NONE {
            let code = err_code(in st);
            let pat_node = pat_at(in a, p);
            err_last(inout st, code, widen_u64(pat_node.start), widen_u64(pat_node.end));
            annotated = st.unknown;
        } else {
            annotated = declared;
        }
    }
    let value_ty = expr(inout st, inout cx, in a, value, annotated);
    let mut binding_ty = value_ty;
    if annotated != NONE {
        expect_s(
            inout st,
            in cx,
            annotated,
            value_ty,
            widen_u64(expr_at(in a, value).start),
            widen_u64(expr_at(in a, value).end),
            in "let binding"
        );
        if annotated != st.unknown {
            binding_ty = annotated;
        }
    }
    pattern(inout st, inout cx, in a, p, binding_ty);
}

fn is_comparison(in st: St, op: u32) -> bool {
    spells(in st, op, in "==")
        || spells(in st, op, in "!=")
        || spells(in st, op, in "<")
        || spells(in st, op, in "<=")
        || spells(in st, op, in ">")
        || spells(in st, op, in ">=")
        || spells(in st, op, in "&&")
        || spells(in st, op, in "||")
}

// `Body::expr` (`expected` NONE for `None`).
pub fn expr(inout st: St, inout cx: Cx, in a: Ast, e: u32, expected: u32) -> u32 {
    let node = expr_at(in a, e);
    let kind = node.kind;
    let start = widen_u64(node.start);
    let end = widen_u64(node.end);
    if kind == 1 {
        let lit = lit_at(in a, node.a);
        // Int, or WideInt past `i128::MAX` (both "int" to Rust).
        if lit.kind == 1 || lit.kind == 5 {
            return ty_named(inout st, T_BASE, st.s_int);
        }
        if lit.kind == 2 {
            return ty_named(inout st, T_BASE, st.s_f64);
        }
        if lit.kind == 3 {
            return ty_named(inout st, T_BASE, st.s_bool);
        }
        return ty_named(inout st, T_BASE, st.s_string);
    }
    if kind == 2 {
        let name = nm(in st, node.a);
        let t = lookup(in cx, name);
        if t != NONE {
            return t;
        }
        return function_value(inout st, in cx, name, start, end);
    }
    if kind == 3 {
        let count = list_len(in a, node.a);
        let expected_node = ty_node(in st, expected);
        let match_exp = expected != NONE
            && expected_node.k == T_TUPLE
            && widen_u64(expected_node.n) == count;
        let mut items = ChunkSeq::new[u32]();
        for i in 0..count {
            let mut want = NONE;
            if match_exp {
                want = ty_item(in st, expected, i);
            }
            let t = expr(inout st, inout cx, in a, list_at(in a, node.a, i), want);
            items.push(t);
        }
        return mk_ty(inout st, T_TUPLE, 0, 0, in items);
    }
    if kind == 4 {
        return struct_literal(inout st, inout cx, in a, e, nm(in st, node.a), node.b, expected);
    }
    if kind == 5 {
        cx.en_marks.push(cx.en_name.len());
        for i in 0..list_len(in a, node.a) {
            let stmt = stmtn(in a, list_at(in a, node.a, i));
            if stmt.kind == 1 {
                let_statement(inout st, inout cx, in a, stmt.pat, stmt.ty, stmt.value);
            } else {
                let t = expr(inout st, inout cx, in a, stmt.value, NONE);
            }
        }
        let mut t = st.unit;
        if node.b != NONE {
            t = expr(inout st, inout cx, in a, node.b, expected);
        }
        env_pop(inout cx);
        return t;
    }
    if kind == 6 {
        return call(inout st, inout cx, in a, e, expected);
    }
    if kind == 7 {
        let t = expr(inout st, inout cx, in a, node.a, NONE);
        return field(inout st, in cx, t, nm(in st, node.b), start, end);
    }
    if kind == 8 {
        let t = expr(inout st, inout cx, in a, node.a, NONE);
        let index_ty = expr(inout st, inout cx, in a, node.b, NONE);
        if has_tensor(in st, t) {
            err_s(
                inout st,
                C_UNSUPPORTED,
                start,
                end,
                in "tensors are not indexed with []: use Tensor operations"
            );
        }
        return st.unknown;
    }
    if kind == 9 {
        let t = expr(inout st, inout cx, in a, node.a, NONE);
        let inner_node = ty_node(in st, t);
        if inner_node.k == T_ADT
            && (inner_node.a == st.s_result || inner_node.a == st.s_option)
            && inner_node.n > 0 {
            return or_unknown(in st, adt_ty_arg(in st, t, 0));
        }
        return st.unknown;
    }
    if kind == 10 {
        let t = expr(inout st, inout cx, in a, node.b, NONE);
        no_operator(inout st, t, start, end);
        return st.unknown;
    }
    if kind == 11 {
        let lhs_ty = expr(inout st, inout cx, in a, node.b, NONE);
        let rhs_ty = expr(inout st, inout cx, in a, node.c, NONE);
        no_operator(inout st, lhs_ty, start, end);
        no_operator(inout st, rhs_ty, start, end);
        if is_comparison(in st, nm(in st, node.a)) {
            return ty_named(inout st, T_BASE, st.s_bool);
        }
        return st.unknown;
    }
    if kind == 12 {
        let t = expr(inout st, inout cx, in a, node.b, NONE);
        let value_ty = expr(inout st, inout cx, in a, node.c, t);
        expect_s(
            inout st,
            in cx,
            t,
            value_ty,
            widen_u64(expr_at(in a, node.c).start),
            widen_u64(expr_at(in a, node.c).end),
            in "assignment"
        );
        return st.unit;
    }
    if kind == 13 {
        let cond_ty = expr(inout st, inout cx, in a, node.a, NONE);
        let then_ty = expr(inout st, inout cx, in a, node.b, expected);
        if node.c == NONE {
            return st.unit;
        }
        let mut want = expected;
        if want == NONE {
            want = then_ty;
        }
        let else_ty = expr(inout st, inout cx, in a, node.c, want);
        return join(
            inout st,
            in cx,
            then_ty,
            else_ty,
            widen_u64(expr_at(in a, node.c).start),
            widen_u64(expr_at(in a, node.c).end),
            in "the else branch"
        );
    }
    if kind == 14 {
        let scrutinee = expr(inout st, inout cx, in a, node.a, NONE);
        let mut result = NONE;
        let arm_count = list_len(in a, node.b) >> 1;
        for i in 0..arm_count {
            let arm_pat = list_at(in a, node.b, wrapping_mul(i, 2));
            let body = list_at(in a, node.b, inc(wrapping_mul(i, 2)));
            cx.en_marks.push(cx.en_name.len());
            pattern(inout st, inout cx, in a, arm_pat, scrutinee);
            let mut want = expected;
            if want == NONE {
                want = result;
            }
            let t = expr(inout st, inout cx, in a, body, want);
            env_pop(inout cx);
            if result == NONE {
                result = t;
            } else {
                result = join(
                    inout st,
                    in cx,
                    result,
                    t,
                    widen_u64(expr_at(in a, body).start),
                    widen_u64(expr_at(in a, body).end),
                    in "this match arm"
                );
            }
        }
        return or_unknown(in st, result);
    }
    if kind == 17 {
        let t = expr(inout st, inout cx, in a, node.a, NONE);
        return st.unknown;
    }
    if kind == 18 {
        let element = expr(inout st, inout cx, in a, node.b, NONE);
        cx.en_marks.push(cx.en_name.len());
        pattern(inout st, inout cx, in a, node.a, element);
        let t = expr(inout st, inout cx, in a, node.c, NONE);
        env_pop(inout cx);
        return st.unit;
    }
    if kind == 19 {
        let range_start_ty = expr(inout st, inout cx, in a, node.a, NONE);
        let range_end_ty = expr(inout st, inout cx, in a, node.b, range_start_ty);
        return join(
            inout st,
            in cx,
            range_start_ty,
            range_end_ty,
            widen_u64(expr_at(in a, node.b).start),
            widen_u64(expr_at(in a, node.b).end),
            in "the range end"
        );
    }
    if kind == 20 || kind == 21 {
        if node.a != NONE {
            let t = expr(inout st, inout cx, in a, node.a, NONE);
        }
        return st.unknown;
    }
    if kind == 15 {
        cx.en_marks.push(cx.en_name.len());
        let mut param_tys = ChunkSeq::new[u32]();
        for i in 0..list_len(in a, node.a) {
            let param = paramn(in a, list_at(in a, node.a, i));
            let mut t = scope_ty(inout st, in cx, in a, param.ty);
            if t == NONE {
                err_last(inout st, C_KIND, widen_u64(param.start), widen_u64(param.end));
                t = st.unknown;
            }
            bind(inout cx, nm(in st, param.name), t);
            param_tys.push(t);
        }
        let declared_ret = scope_ty(inout st, in cx, in a, node.c);
        let ret_ty = or_unknown(in st, declared_ret);
        let closure_body_ty = expr(inout st, inout cx, in a, node.e, ret_ty);
        expect_s(
            inout st,
            in cx,
            ret_ty,
            closure_body_ty,
            widen_u64(expr_at(in a, node.e).start),
            widen_u64(expr_at(in a, node.e).end),
            in "closure body"
        );
        env_pop(inout cx);
        let mut fn_ret_ty = ret_ty;
        if ret_ty == st.unknown {
            fn_ret_ty = closure_body_ty;
        }
        return mk_ty(inout st, T_FN, 0, fn_ret_ty, in param_tys);
    }
    if kind == 16 {
        let handled_effect = effectn(in a, node.a);
        let effect_name = nm(in st, handled_effect.name);
        if effect_name == st.s_tensor || effect_name == st.s_kv {
            let mut message = ChunkSeq::new[u8]();
            message.push(39);
            st.names.write(effect_name, inout message);
            put(
                inout message,
                in "' is implemented by the host; a source handler could forge or drop tensors and leases"
            );
            push_diag(inout st, C_HANDLER, start, end, in message);
        }
        cx.en_marks.push(cx.en_name.len());
        if node.b != NONE {
            let t = expr(inout st, inout cx, in a, node.c, NONE);
            pattern(inout st, inout cx, in a, node.b, t);
        }
        let body_ty = expr(inout st, inout cx, in a, node.d, NONE);
        for i in 0..list_len(in a, node.e) {
            let clause = clausen(in a, list_at(in a, node.e, i));
            cx.en_marks.push(cx.en_name.len());
            for j in 0..list_len(in a, clause.pats) {
                let mut pat_ty = st.unknown;
                if i == 0 {
                    pat_ty = body_ty;
                }
                pattern(inout st, inout cx, in a, list_at(in a, clause.pats, j), pat_ty);
            }
            let t = expr(inout st, inout cx, in a, clause.body, NONE);
            env_pop(inout cx);
        }
        env_pop(inout cx);
        return st.unknown;
    }
    st.unknown
}

// `check_body`: the function's obligations into `cx.bo`.
fn check_body(inout st: St, inout cx: Cx, in a: Ast, fn_id: u32, row: u32) {
    let func = fnn(in a, fn_id);
    cx.cur = row;
    cx.bo.clear();
    cx.fresh = 0;
    cx.en_name.clear();
    cx.en_ty.clear();
    cx.en_marks.clear();
    cx.en_marks.push(0);
    cx.sc_name.clear();
    cx.sc_kind.clear();
    for i in 0..widen_u64(u32_at(in cx.sg_gn, widen_u64(row))) {
        cx.sc_name.push(u32_at(
            in cx.sg_gsym,
            wrapping_add(widen_u64(u32_at(in cx.sg_ga, widen_u64(row))), i)
        ));
        cx.sc_kind.push(u8_at(
            in cx.sg_gkind,
            wrapping_add(widen_u64(u32_at(in cx.sg_ga, widen_u64(row))), i)
        ));
    }
    let mut param_count = list_len(in a, func.params);
    if widen_u64(u32_at(in cx.sg_pn, widen_u64(row))) < param_count {
        param_count = widen_u64(u32_at(in cx.sg_pn, widen_u64(row)));
    }
    for i in 0..param_count {
        let param = paramn(in a, list_at(in a, func.params, i));
        bind(
            inout cx,
            nm(in st, param.name),
            u32_at(in cx.sg_pty, wrapping_add(widen_u64(u32_at(in cx.sg_pa, widen_u64(row))), i))
        );
    }
    if func.body != NONE {
        let ret_ty = u32_at(in cx.sg_res, widen_u64(row));
        let body_ty = expr(inout st, inout cx, in a, func.body, ret_ty);
        let mut context = ChunkSeq::new[u8]();
        put(inout context, in "body of '");
        st.names.write(nm(in st, func.name), inout context);
        context.push(39);
        expect(
            inout st,
            in cx,
            ret_ty,
            body_ty,
            widen_u64(expr_at(in a, func.body).start),
            widen_u64(expr_at(in a, func.body).end),
            in context
        );
    }
}

fn sig_obs_equal(in cx: Cx, row: u32) -> bool {
    if widen_u64(u32_at(in cx.sg_on, widen_u64(row))) != cx.bo.len() {
        return false;
    }
    for i in 0..cx.bo.len() {
        let sig_ob = ob_get(in cx, wrapping_add(widen_u64(u32_at(in cx.sg_oa, widen_u64(row))), i));
        let body_ob = bo_get(in cx, i);
        if sig_ob.k != body_ob.k
            || sig_ob.d1 != body_ob.d1
            || sig_ob.d2 != body_ob.d2
            || sig_ob.r != body_ob.r {
            return false;
        }
    }
    true
}

// ----- analyze -----------------------------------------------------------------------------

// `infer::analyze` up to the elaboration: the tensor diagnostics in `st`,
// kinds, ADT infos and signatures in `cx`. Wire diagnostics and wires are
// already in place.
pub fn analyze(inout st: St, inout cx: Cx, in a: Ast) {
    mark_blocks(in st, inout cx, in a);
    adt_kinds(inout st, inout cx, in a);
    for i in 0..a.m_items.len() {
        let item = item_at(in a, i);
        if item.kind == 3 {
            let effect_decl = effdecln(in a, item.node);
            let mut bad = fns_mention(inout st, in a, effect_decl.ops);
            for generic_idx in 0..list_len(in a, effect_decl.generics) {
                if at32(
                    in cx.ak_row,
                    (
                        nm(
                            in st,
                            genericn(in a, list_at(in a, effect_decl.generics, generic_idx)).name
                        )
                    )
                )
                    != NONE {
                    bad = true;
                }
            }
            if bad {
                let mut message = ChunkSeq::new[u8]();
                put(inout message, in "effect '");
                st.names.write(nm(in st, effect_decl.name), inout message);
                put(
                    inout message,
                    in "' mentions tensor types; only top-level functions and type declarations may (this slice)"
                );
                push_diag(
                    inout st,
                    C_UNSUPPORTED,
                    (widen_u64(effect_decl.start)),
                    (widen_u64(effect_decl.end)),
                    in message
                );
            }
        } else if item.kind == 4 {
            let impl_node = impln(in a, item.node);
            if type_mentions(in st, in a, impl_node.ty)
                || fns_mention(inout st, in a, impl_node.methods) {
                let mut span_start: u64 = 0;
                let mut span_end: u64 = 0;
                if list_len(in a, impl_node.methods) > 0 {
                    let first_method = fnn(in a, list_at(in a, impl_node.methods, 0));
                    span_start = widen_u64(first_method.start);
                    span_end = widen_u64(first_method.end);
                }
                err_s(
                    inout st,
                    C_UNSUPPORTED,
                    span_start,
                    span_end,
                    in "impl blocks may not mention tensor types; use top-level functions (this slice)"
                );
            }
        } else if item.kind == 6 {
            let conf = confn(in a, item.node);
            if fns_mention(inout st, in a, conf.methods)
                || type_mentions(in st, in a, conf.self_ty) {
                err_s(
                    inout st,
                    C_UNSUPPORTED,
                    widen_u64(conf.start),
                    widen_u64(conf.end),
                    in "trait implementations may not mention tensor types (this slice)"
                );
            }
        } else if item.kind == 5 {
            let trait_node = traitn(in a, item.node);
            if fns_mention(inout st, in a, trait_node.methods) {
                err_s(
                    inout st,
                    C_UNSUPPORTED,
                    widen_u64(trait_node.start),
                    widen_u64(trait_node.end),
                    in "traits may not mention tensor types (this slice)"
                );
            }
        }
    }
    adt_infos(inout st, inout cx, in a);
    for i in 0..a.m_items.len() {
        let item = item_at(in a, i);
        if item.kind == 2 {
            signature(inout st, inout cx, in a, item.node);
        }
    }
    // Functions with signatures, in item order.
    let mut fns = ChunkSeq::new[u32]();
    for i in 0..a.m_items.len() {
        let item = item_at(in a, i);
        if item.kind == 2 && at32(in cx.sg_row, (nm(in st, fnn(in a, item.node).name))) != NONE {
            fns.push(item.node);
        }
    }
    let base = st.dcode.len();
    for round in 0..17 {
        diag_truncate_to(inout st, base);
        elab_clear(inout cx);
        let mut changed = false;
        for i in 0..fns.len() {
            let fn_id = u32_at(in fns, i);
            let func = fnn(in a, fn_id);
            let row = at32(in cx.sg_row, (nm(in st, func.name)));
            check_body(inout st, inout cx, in a, fn_id, row);
            if cx.bo.len() > 64 {
                let mut message = ChunkSeq::new[u8]();
                message.push(39);
                st.names.write(nm(in st, func.name), inout message);
                put(inout message, in "' infers more than 64 dimension preconditions");
                push_diag(
                    inout st,
                    C_OBLIGATION,
                    (widen_u64(func.start)),
                    (widen_u64(func.end)),
                    in message
                );
                continue;
            }
            if !sig_obs_equal(in cx, row) {
                let obs_start = cx.obs.len();
                for j in 0..cx.bo.len() {
                    cx.obs.push(bo_get(in cx, j));
                }
                let ok = cx.sg_oa.try_set(widen_u64(row), wrapping_u32(obs_start));
                let ok2 = cx.sg_on.try_set(widen_u64(row), wrapping_u32(cx.bo.len()));
                changed = true;
            }
        }
        if !changed {
            break;
        }
        if round == 16 {
            let mut span_start: u64 = 0;
            let mut span_end: u64 = 0;
            if fns.len() > 0 {
                let first_fn = fnn(in a, u32_at(in fns, 0));
                span_start = widen_u64(first_fn.start);
                span_end = widen_u64(first_fn.end);
            }
            err_s(
                inout st,
                C_OBLIGATION,
                span_start,
                span_end,
                in "dimension preconditions did not converge across recursive calls"
            );
        }
    }
    // Keep the first of each (code, span, message).
    let n = st.dcode.len();
    let mut keep = ChunkSeq::new[u8]();
    for i in 0..n {
        let mut dup = false;
        for j in 0..i {
            if u8_at(in keep, j) == 1 && diag_same(in st, i, j) {
                dup = true;
                break;
            }
        }
        if dup {
            keep.push(0);
        } else {
            keep.push(1);
        }
    }
    let mut code = ChunkSeq::new[u32]();
    let mut diag_starts = ChunkSeq::new[u64]();
    let mut diag_ends = ChunkSeq::new[u64]();
    let mut msg_starts = ChunkSeq::new[u64]();
    let mut msg_ends = ChunkSeq::new[u64]();
    let mut text = ChunkSeq::new[u8]();
    for i in 0..n {
        if u8_at(in keep, i) != 1 {
            continue;
        }
        code.push(u32_at(in st.dcode, i));
        diag_starts.push(u64_at(in st.dstart, i));
        diag_ends.push(u64_at(in st.dend, i));
        msg_starts.push(text.len());
        let text_start = u64_at(in st.dma, i);
        let text_end = u64_at(in st.dmb, i);
        for k in text_start..text_end {
            text.push(u8_at(in st.dtext, k));
        }
        msg_ends.push(text.len());
    }
    st.dcode = code;
    st.dstart = diag_starts;
    st.dend = diag_ends;
    st.dma = msg_starts;
    st.dmb = msg_ends;
    st.dtext = text;
}
