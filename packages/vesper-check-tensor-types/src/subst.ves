// `infer::Subst`: dimension, dtype and type bindings of one call or
// literal, and its pending dimension equations. Maps are association lists
// read newest first, so a later insert shadows an earlier one exactly as
// `BTreeMap::insert` replaces it, and a failed probe is undone by
// truncating (`mark`/`undo`) where Rust clones and discards.

use @vesper/check-data::util::{push_decimal, add, inc, u32_at, w};
use self::state::{
    St,
    put,
    put_dim,
    put_dtype,
    put_ty,
    dim_node,
    dim_var_at,
    dim_exp_at,
    dim_mul,
    dim_var,
    dim_without,
    dim_divides,
    dim_quotient,
    dim_mentions,
    put_dim_error,
    mk_ty,
    mk_dim,
    ty_node,
    ty_item,
    has_tensor,
};

const NONE: u32 = 4294967295;

const T_TENSOR: u8 = 1;
const T_LEASE: u8 = 2;
const T_SEQ: u8 = 3;
const T_ADT: u8 = 4;
const T_TUPLE: u8 = 5;
const T_FN: u8 = 6;
const T_VAR: u8 = 7;
const T_UNKNOWN: u8 = 9;

pub struct Subst {
    dk: ChunkSeq[u32],
    dv: ChunkSeq[u32],
    ek: ChunkSeq[u32],
    ev: ChunkSeq[u32],
    yk: ChunkSeq[u32],
    yv: ChunkSeq[u32],
    pa: ChunkSeq[u32],
    pb: ChunkSeq[u32]
}

pub copy struct Mark {
    d: u64,
    e: u64,
    y: u64,
    p: u64
}

pub fn subst_new() -> Subst {
    Subst {
        dk: ChunkSeq::new[u32](),
        dv: ChunkSeq::new[u32](),
        ek: ChunkSeq::new[u32](),
        ev: ChunkSeq::new[u32](),
        yk: ChunkSeq::new[u32](),
        yv: ChunkSeq::new[u32](),
        pa: ChunkSeq::new[u32](),
        pb: ChunkSeq::new[u32]()
    }
}

pub fn mark(in s: Subst) -> Mark {
    Mark { d: s.dk.len(), e: s.ek.len(), y: s.yk.len(), p: s.pa.len() }
}

pub fn undo(inout s: Subst, checkpoint: Mark) {
    s.dk.truncate(checkpoint.d);
    s.dv.truncate(checkpoint.d);
    s.ek.truncate(checkpoint.e);
    s.ev.truncate(checkpoint.e);
    s.yk.truncate(checkpoint.y);
    s.yv.truncate(checkpoint.y);
    s.pa.truncate(checkpoint.p);
    s.pb.truncate(checkpoint.p);
}

pub fn find(in keys: ChunkSeq[u32], in values: ChunkSeq[u32], key: u32) -> u32 {
    let mut i = keys.len();
    loop {
        if i == 0 {
            return NONE;
        }
        i = wrapping_sub(i, 1);
        if u32_at(in keys, i) == key {
            return u32_at(in values, i);
        }
    }
}

pub fn set_dim(inout s: Subst, var: u32, d: u32) {
    s.dk.push(var);
    s.dv.push(d);
}

pub fn set_dtype(inout s: Subst, var: u32, dtype: u32) {
    s.ek.push(var);
    s.ev.push(dtype);
}

pub fn set_ty(inout s: Subst, var: u32, t: u32) {
    s.yk.push(var);
    s.yv.push(t);
}

// Whether a name is a unification variable (`?n`, `flexible`).

pub fn dim_flexible(in st: St, d: u32) -> bool {
    for i in 0..widen_u64(dim_node(in st, d).n) {
        if (
            st.names.size((dim_var_at(in st, d, i))) > 0
                && st.names.byte((dim_var_at(in st, d, i)), 0) == 63
        ) {
            return true;
        }
    }
    false
}

// `Dim::subst` with `s.dims` as the environment (one pass): NONE with
// `derr` on overflow.
pub fn dim_subst1(inout st: St, in s: Subst, d: u32) -> u32 {
    let node = dim_node(in st, d);
    let none: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut out = mk_dim(inout st, node.coeff, in none);
    for i in 0..widen_u64(node.n) {
        let var = dim_var_at(in st, d, i);
        let exp = dim_exp_at(in st, d, i);
        let mut factor = find(in s.dk, in s.dv, var);
        if factor == NONE {
            factor = dim_var(inout st, var);
        }
        for k in 0..widen_u64(exp) {
            out = dim_mul(inout st, out, factor);
            if out == NONE {
                return NONE;
            }
        }
    }
    out
}

// `Subst::dim`: NONE with `err` set.
pub fn sub_dim(inout st: St, in s: Subst, initial: u32) -> u32 {
    let mut d = initial;
    for i in 0..32 {
        let next = dim_subst1(inout st, in s, d);
        if next == NONE {
            st.err.clear();
            put_dim_error(inout st.err, st.derr);
            return NONE;
        }
        if next == d {
            return d;
        }
        d = next;
    }
    st.err.clear();
    put(inout st.err, in "dimension substitution does not terminate");
    NONE
}

// `Subst::dim(..).unwrap_or(d)`.
pub fn sub_dim_or(inout st: St, in s: Subst, d: u32) -> u32 {
    let substituted = sub_dim(inout st, in s, d);
    if substituted == NONE { d } else { substituted }
}

pub fn sub_dtype(in s: Subst, d: u32) -> u32 {
    if (d >= 2 && (d & 1) == 1) {
        let bound = find(in s.ek, in s.ev, ((wrapping_sub(d, 2) >> 1)));
        if bound != NONE {
            return bound;
        }
    }
    d
}

// `Subst::ty`: NONE with `err` set.
pub fn sub_ty(inout st: St, in s: Subst, t: u32) -> u32 {
    let node = ty_node(in st, t);
    if node.k == T_TENSOR {
        let mut items = ChunkSeq::new[u32]();
        for i in 0..widen_u64(node.n) {
            let dim = sub_dim(inout st, in s, ty_item(in st, t, i));
            if dim == NONE {
                return NONE;
            }
            items.push(dim);
        }
        return mk_ty(inout st, T_TENSOR, sub_dtype(in s, node.a), 0, in items);
    }
    if node.k == T_LEASE || node.k == T_SEQ {
        let kv = sub_dim(inout st, in s, node.a);
        if kv == NONE {
            return NONE;
        }
        let hd = sub_dim(inout st, in s, node.c);
        if hd == NONE {
            return NONE;
        }
        let none: ChunkSeq[u32] = ChunkSeq::new[u32]();
        return mk_ty(inout st, node.k, kv, hd, in none);
    }
    if node.k == T_ADT {
        let mut items = ChunkSeq::new[u32]();
        for i in 0..widen_u64(node.n) {
            let tag = ty_item(in st, t, wrapping_mul(i, 2));
            let id = ty_item(in st, t, inc(wrapping_mul(i, 2)));
            let mut arg = id;
            if tag == 0 {
                arg = sub_ty(inout st, in s, id);
            } else if tag == 1 {
                arg = sub_dim(inout st, in s, id);
            } else {
                arg = sub_dtype(in s, id);
            }
            if arg == NONE {
                return NONE;
            }
            items.push(tag);
            items.push(arg);
        }
        return mk_ty(inout st, T_ADT, node.a, 0, in items);
    }
    if node.k == T_TUPLE || node.k == T_FN {
        let mut items = ChunkSeq::new[u32]();
        for i in 0..widen_u64(node.n) {
            let elem = sub_ty(inout st, in s, ty_item(in st, t, i));
            if elem == NONE {
                return NONE;
            }
            items.push(elem);
        }
        let mut result: u32 = 0;
        if node.k == T_FN {
            result = sub_ty(inout st, in s, node.c);
            if result == NONE {
                return NONE;
            }
        }
        return mk_ty(inout st, node.k, 0, result, in items);
    }
    if node.k == T_VAR {
        let bound = find(in s.yk, in s.yv, node.a);
        if bound == NONE {
            return t;
        }
        let bound_node = ty_node(in st, bound);
        if bound_node.k == T_VAR && bound_node.a == node.a {
            return t;
        }
        return sub_ty(inout st, in s, bound);
    }
    t
}

// `s.ty(t).unwrap_or(dflt)`.
pub fn sub_ty_or(inout st: St, in s: Subst, t: u32, dflt: u32) -> u32 {
    let substituted = sub_ty(inout st, in s, t);
    if substituted == NONE {
        dflt
    } else {
        substituted
    }
}

// The result of a unification: 0 Ok, else the diagnostic code with the
// reason in `err` (empty for `String::new()`).

pub fn unify_dtype(inout st: St, inout s: Subst, lhs_raw: u32, rhs_raw: u32) -> u32 {
    let lhs = sub_dtype(in s, lhs_raw);
    let rhs = sub_dtype(in s, rhs_raw);
    if lhs == rhs {
        return 0;
    }
    if (lhs >= 2 && (lhs & 1) == 1)
        && (
            st.names.size(((wrapping_sub(lhs, 2) >> 1))) > 0
                && st.names.byte(((wrapping_sub(lhs, 2) >> 1)), 0) == 63
        ) {
        set_dtype(inout s, (wrapping_sub(lhs, 2) >> 1), rhs);
        return 0;
    }
    if (rhs >= 2 && (rhs & 1) == 1)
        && (
            st.names.size(((wrapping_sub(rhs, 2) >> 1))) > 0
                && st.names.byte(((wrapping_sub(rhs, 2) >> 1)), 0) == 63
        ) {
        set_dtype(inout s, (wrapping_sub(rhs, 2) >> 1), lhs);
        return 0;
    }
    let mut message = ChunkSeq::new[u8]();
    put(inout message, in "element type ");
    put_dtype(in st, inout message, lhs);
    put(inout message, in " differs from ");
    put_dtype(in st, inout message, rhs);
    st.err = message;
    766
}

// `Subst::solve`: bind the single flexible variable of `a` so `a == b`.
fn solve(inout st: St, inout s: Subst, a: u32, b: u32) -> bool {
    let mut flex_var = NONE;
    let mut count: u64 = 0;
    let mut exp: u32 = 0;
    for i in 0..widen_u64(dim_node(in st, a).n) {
        let var = dim_var_at(in st, a, i);
        if (st.names.size(var) > 0 && st.names.byte(var, 0) == 63) {
            count = inc(count);
            flex_var = var;
            exp = dim_exp_at(in st, a, i);
        }
    }
    if count != 1 || exp != 1 {
        return false;
    }
    if dim_mentions(in st, b, flex_var) {
        return false;
    }
    let rest = dim_without(inout st, a, flex_var);
    if !dim_divides(in st, rest, b) {
        return false;
    }
    let value = dim_quotient(inout st, rest, b);
    set_dim(inout s, flex_var, value);
    true
}

pub fn unify_dim(inout st: St, inout s: Subst, lhs_raw: u32, rhs_raw: u32) -> u32 {
    let lhs = sub_dim(inout st, in s, lhs_raw);
    if lhs == NONE {
        return 762;
    }
    let rhs = sub_dim(inout st, in s, rhs_raw);
    if rhs == NONE {
        return 762;
    }
    if lhs == rhs {
        return 0;
    }
    if solve(inout st, inout s, lhs, rhs) || solve(inout st, inout s, rhs, lhs) {
        return 0;
    }
    if dim_flexible(in st, lhs) || dim_flexible(in st, rhs) {
        s.pa.push(lhs);
        s.pb.push(rhs);
        return 0;
    }
    let mut message = ChunkSeq::new[u8]();
    put_dim(in st, inout message, lhs);
    put(inout message, in " differs from ");
    put_dim(in st, inout message, rhs);
    st.err = message;
    763
}

// Prefixes `err` with `prefix` (and a number when `with_n`) and ": ".
fn prefix_err(inout st: St, in prefix: Str, with_n: bool, n: u64) {
    let mut message = ChunkSeq::new[u8]();
    put(inout message, in prefix);
    if with_n {
        push_decimal(inout message, n);
    }
    put(inout message, in ": ");
    message.extend(in st.err.as_slice());
    st.err = message;
}

// `Subst::unify(exp, act)`.
pub fn unify(inout st: St, inout s: Subst, exp0: u32, act0: u32) -> u32 {
    let exp = sub_ty(inout st, in s, exp0);
    if exp == NONE {
        return 762;
    }
    let act = sub_ty(inout st, in s, act0);
    if act == NONE {
        return 762;
    }
    let exp_node = ty_node(in st, exp);
    let act_node = ty_node(in st, act);
    if exp_node.k == T_UNKNOWN || act_node.k == T_UNKNOWN {
        return 0;
    }
    if exp_node.k == T_VAR
        && (st.names.size(exp_node.a) > 0 && st.names.byte(exp_node.a, 0) == 63) {
        set_ty(inout s, exp_node.a, act);
        return 0;
    }
    if act_node.k == T_VAR
        && (st.names.size(act_node.a) > 0 && st.names.byte(act_node.a, 0) == 63) {
        set_ty(inout s, act_node.a, exp);
        return 0;
    }
    if exp_node.k == T_TENSOR && act_node.k == T_TENSOR {
        let code = unify_dtype(inout st, inout s, exp_node.a, act_node.a);
        if code != 0 {
            return code;
        }
        if exp_node.n != act_node.n {
            let mut message = ChunkSeq::new[u8]();
            put(inout message, in "rank ");
            push_decimal(inout message, widen_u64(exp_node.n));
            put(inout message, in " differs from rank ");
            push_decimal(inout message, widen_u64(act_node.n));
            st.err = message;
            return 763;
        }
        for i in 0..widen_u64(exp_node.n) {
            let axis_code = unify_dim(
                inout st,
                inout s,
                ty_item(in st, exp, i),
                ty_item(in st, act, i)
            );
            if axis_code != 0 {
                prefix_err(inout st, in "axis ", true, i);
                return axis_code;
            }
        }
        return 0;
    }
    if (exp_node.k == T_LEASE && act_node.k == T_LEASE)
        || (exp_node.k == T_SEQ && act_node.k == T_SEQ) {
        let kv_heads_code = unify_dim(inout st, inout s, exp_node.a, act_node.a);
        if kv_heads_code != 0 {
            prefix_err(inout st, in "KvHeads", false, 0);
            return kv_heads_code;
        }
        let head_dim_code = unify_dim(inout st, inout s, exp_node.c, act_node.c);
        if head_dim_code != 0 {
            prefix_err(inout st, in "HeadDim", false, 0);
            return head_dim_code;
        }
        return 0;
    }
    if exp_node.k == T_ADT
        && act_node.k == T_ADT
        && exp_node.a == act_node.a
        && exp_node.n == act_node.n {
        for i in 0..widen_u64(exp_node.n) {
            let exp_tag = ty_item(in st, exp, wrapping_mul(i, 2));
            let act_tag = ty_item(in st, act, wrapping_mul(i, 2));
            let exp_arg = ty_item(in st, exp, inc(wrapping_mul(i, 2)));
            let act_arg = ty_item(in st, act, inc(wrapping_mul(i, 2)));
            let mut code: u32 = 0;
            if exp_tag == 0 && act_tag == 0 {
                code = unify(inout st, inout s, exp_arg, act_arg);
            } else if exp_tag == 1 && act_tag == 1 {
                code = unify_dim(inout st, inout s, exp_arg, act_arg);
            } else if exp_tag == 2 && act_tag == 2 {
                code = unify_dtype(inout st, inout s, exp_arg, act_arg);
            }
            if code != 0 {
                return code;
            }
        }
        return 0;
    }
    if (exp_node.k == T_TUPLE && act_node.k == T_TUPLE && exp_node.n == act_node.n)
        || (exp_node.k == T_FN && act_node.k == T_FN && exp_node.n == act_node.n) {
        for i in 0..widen_u64(exp_node.n) {
            let code = unify(inout st, inout s, ty_item(in st, exp, i), ty_item(in st, act, i));
            if code != 0 {
                return code;
            }
        }
        if exp_node.k == T_FN {
            return unify(inout st, inout s, exp_node.c, act_node.c);
        }
        return 0;
    }
    if exp_node.k == T_VAR && act_node.k == T_VAR && exp_node.a == act_node.a {
        return 0;
    }
    if !has_tensor(in st, exp) && !has_tensor(in st, act) {
        return 0;
    }
    st.err.clear();
    763
}

// `Subst::settle`.
pub fn settle(inout st: St, inout s: Subst) -> u32 {
    for round in 0..16 {
        if s.pa.len() == 0 {
            return 0;
        }
        let mut pending_lhs = ChunkSeq::new[u32]();
        let mut pending_rhs = ChunkSeq::new[u32]();
        pending_lhs.extend(in s.pa.as_slice());
        pending_rhs.extend(in s.pb.as_slice());
        s.pa.clear();
        s.pb.clear();
        let before = pending_lhs.len();
        for i in 0..before {
            let code = unify_dim(
                inout st,
                inout s,
                u32_at(in pending_lhs, i),
                u32_at(in pending_rhs, i)
            );
            if code != 0 {
                return code;
            }
        }
        if s.pa.len() >= before {
            break;
        }
    }
    if s.pa.len() == 0 {
        return 0;
    }
    let lhs = u32_at(in s.pa, 0);
    let rhs = u32_at(in s.pb, 0);
    let lhs_dim = sub_dim_or(inout st, in s, lhs);
    let rhs_dim = sub_dim_or(inout st, in s, rhs);
    let mut message = ChunkSeq::new[u8]();
    put(inout message, in "cannot solve ");
    put_dim(in st, inout message, lhs_dim);
    put(inout message, in " = ");
    put_dim(in st, inout message, rhs_dim);
    st.err = message;
    764
}

// `unify(..).and_then(|_| settle())`.
pub fn unify_settle(inout st: St, inout s: Subst, exp: u32, act: u32) -> u32 {
    let code = unify(inout st, inout s, exp, act);
    if code != 0 {
        return code;
    }
    settle(inout st, inout s)
}

// Whether `s` binds dimension variable `var` (`s.dims.contains_key(v)`).
pub fn binds_dim(in s: Subst, var: u32) -> bool {
    find(in s.dk, in s.dv, var) != NONE
}
