// `infer::Subst`: dimension, dtype and type bindings of one call or
// literal, and its pending dimension equations. Maps are association lists
// read newest first, so a later insert shadows an earlier one exactly as
// `BTreeMap::insert` replaces it, and a failed probe is undone by
// truncating (`mark`/`undo`) where Rust clones and discards.

use @vesper/check-data::util::{push_decimal, add, inc, u32_at, w};
use self::state::{
    St,
    put,
    put_dim,
    put_dtype,
    put_ty,
    dim_node,
    dim_var_at,
    dim_exp_at,
    dim_mul,
    dim_var,
    dim_without,
    dim_divides,
    dim_quotient,
    dim_mentions,
    put_dim_error,
    mk_ty,
    mk_dim,
    ty_node,
    ty_item,
    has_tensor,
};

const NONE: u32 = 4294967295;

const T_TENSOR: u8 = 1;
const T_LEASE: u8 = 2;
const T_SEQ: u8 = 3;
const T_ADT: u8 = 4;
const T_TUPLE: u8 = 5;
const T_FN: u8 = 6;
const T_VAR: u8 = 7;
const T_UNKNOWN: u8 = 9;

pub struct Subst {
    dim_keys: ChunkSeq[u32],
    dim_values: ChunkSeq[u32],
    dtype_keys: ChunkSeq[u32],
    dtype_values: ChunkSeq[u32],
    ty_keys: ChunkSeq[u32],
    ty_values: ChunkSeq[u32],
    pending_lhs: ChunkSeq[u32],
    pending_rhs: ChunkSeq[u32]
}

pub copy struct Mark {
    dim_len: u64,
    dtype_len: u64,
    ty_len: u64,
    pending_len: u64
}

pub fn subst_new() -> Subst {
    Subst {
        dim_keys: ChunkSeq::new[u32](),
        dim_values: ChunkSeq::new[u32](),
        dtype_keys: ChunkSeq::new[u32](),
        dtype_values: ChunkSeq::new[u32](),
        ty_keys: ChunkSeq::new[u32](),
        ty_values: ChunkSeq::new[u32](),
        pending_lhs: ChunkSeq::new[u32](),
        pending_rhs: ChunkSeq::new[u32]()
    }
}

pub fn mark(in subst: Subst) -> Mark {
    Mark {
        dim_len: subst.dim_keys.len(),
        dtype_len: subst.dtype_keys.len(),
        ty_len: subst.ty_keys.len(),
        pending_len: subst.pending_lhs.len()
    }
}

pub fn undo(inout subst: Subst, checkpoint: Mark) {
    subst.dim_keys.truncate(checkpoint.dim_len);
    subst.dim_values.truncate(checkpoint.dim_len);
    subst.dtype_keys.truncate(checkpoint.dtype_len);
    subst.dtype_values.truncate(checkpoint.dtype_len);
    subst.ty_keys.truncate(checkpoint.ty_len);
    subst.ty_values.truncate(checkpoint.ty_len);
    subst.pending_lhs.truncate(checkpoint.pending_len);
    subst.pending_rhs.truncate(checkpoint.pending_len);
}

pub fn find(in keys: ChunkSeq[u32], in values: ChunkSeq[u32], key: u32) -> u32 {
    let mut i = keys.len();
    loop {
        if i == 0 {
            return NONE;
        }
        i = wrapping_sub(i, 1);
        if u32_at(in keys, i) == key {
            return u32_at(in values, i);
        }
    }
}

pub fn set_dim(inout subst: Subst, var: u32, dim: u32) {
    subst.dim_keys.push(var);
    subst.dim_values.push(dim);
}

pub fn set_dtype(inout subst: Subst, var: u32, dtype: u32) {
    subst.dtype_keys.push(var);
    subst.dtype_values.push(dtype);
}

pub fn set_ty(inout subst: Subst, var: u32, ty: u32) {
    subst.ty_keys.push(var);
    subst.ty_values.push(ty);
}

// Whether a name is a unification variable (`?n`, `flexible`).

pub fn dim_flexible(in state: St, dim: u32) -> bool {
    for i in 0..widen_u64(dim_node(in state, dim).factor_count) {
        if (state.names.size((dim_var_at(in state, dim, i))) > 0
            && state.names.byte((dim_var_at(in state, dim, i)), 0) == 63)
        {
            return true;
        }
    }
    false
}

// `Dim::subst` with `s.dims` as the environment (one pass): NONE with
// `dim_error` on overflow.
pub fn dim_subst1(inout state: St, in subst: Subst, dim: u32) -> u32 {
    let node = dim_node(in state, dim);
    let none: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut out = mk_dim(inout state, node.coeff, in none);
    for i in 0..widen_u64(node.factor_count) {
        let var = dim_var_at(in state, dim, i);
        let exp = dim_exp_at(in state, dim, i);
        let mut factor = find(in subst.dim_keys, in subst.dim_values, var);
        if factor == NONE {
            factor = dim_var(inout state, var);
        }
        for k in 0..widen_u64(exp) {
            out = dim_mul(inout state, out, factor);
            if out == NONE {
                return NONE;
            }
        }
    }
    out
}

// `Subst::dim`: NONE with `err` set.
pub fn sub_dim(inout state: St, in subst: Subst, initial: u32) -> u32 {
    let mut dim = initial;
    for i in 0..32 {
        let next = dim_subst1(inout state, in subst, dim);
        if next == NONE {
            state.err.clear();
            put_dim_error(inout state.err, state.dim_error);
            return NONE;
        }
        if next == dim {
            return dim;
        }
        dim = next;
    }
    state.err.clear();
    put(inout state.err, in "dimension substitution does not terminate");
    NONE
}

// `Subst::dim(..).unwrap_or(d)`.
pub fn sub_dim_or(inout state: St, in subst: Subst, dim: u32) -> u32 {
    let substituted = sub_dim(inout state, in subst, dim);
    if substituted == NONE {
        dim
    } else {
        substituted
    }
}

pub fn sub_dtype(in subst: Subst, dtype: u32) -> u32 {
    if (dtype >= 2 && (dtype & 1) == 1) {
        let bound = find(
            in subst.dtype_keys,
            in subst.dtype_values,
            ((wrapping_sub(dtype, 2) >> 1))
        );
        if bound != NONE {
            return bound;
        }
    }
    dtype
}

// `Subst::ty`: NONE with `err` set.
pub fn sub_ty(inout state: St, in subst: Subst, ty: u32) -> u32 {
    let node = ty_node(in state, ty);
    if node.kind == T_TENSOR {
        let mut items = ChunkSeq::new[u32]();
        for i in 0..widen_u64(node.arity) {
            let dim = sub_dim(inout state, in subst, ty_item(in state, ty, i));
            if dim == NONE {
                return NONE;
            }
            items.push(dim);
        }
        return mk_ty(inout state, T_TENSOR, sub_dtype(in subst, node.primary), 0, in items);
    }
    if node.kind == T_LEASE || node.kind == T_SEQ {
        let kv_heads = sub_dim(inout state, in subst, node.primary);
        if kv_heads == NONE {
            return NONE;
        }
        let head_dim = sub_dim(inout state, in subst, node.secondary);
        if head_dim == NONE {
            return NONE;
        }
        let none: ChunkSeq[u32] = ChunkSeq::new[u32]();
        return mk_ty(inout state, node.kind, kv_heads, head_dim, in none);
    }
    if node.kind == T_ADT {
        let mut items = ChunkSeq::new[u32]();
        for i in 0..widen_u64(node.arity) {
            let tag = ty_item(in state, ty, wrapping_mul(i, 2));
            let id = ty_item(in state, ty, inc(wrapping_mul(i, 2)));
            let mut arg = id;
            if tag == 0 {
                arg = sub_ty(inout state, in subst, id);
            } else if tag == 1 {
                arg = sub_dim(inout state, in subst, id);
            } else {
                arg = sub_dtype(in subst, id);
            }
            if arg == NONE {
                return NONE;
            }
            items.push(tag);
            items.push(arg);
        }
        return mk_ty(inout state, T_ADT, node.primary, 0, in items);
    }
    if node.kind == T_TUPLE || node.kind == T_FN {
        let mut items = ChunkSeq::new[u32]();
        for i in 0..widen_u64(node.arity) {
            let elem = sub_ty(inout state, in subst, ty_item(in state, ty, i));
            if elem == NONE {
                return NONE;
            }
            items.push(elem);
        }
        let mut result: u32 = 0;
        if node.kind == T_FN {
            result = sub_ty(inout state, in subst, node.secondary);
            if result == NONE {
                return NONE;
            }
        }
        return mk_ty(inout state, node.kind, 0, result, in items);
    }
    if node.kind == T_VAR {
        let bound = find(in subst.ty_keys, in subst.ty_values, node.primary);
        if bound == NONE {
            return ty;
        }
        let bound_node = ty_node(in state, bound);
        if bound_node.kind == T_VAR && bound_node.primary == node.primary {
            return ty;
        }
        return sub_ty(inout state, in subst, bound);
    }
    ty
}

// `s.ty(t).unwrap_or(fallback)`.
pub fn sub_ty_or(inout state: St, in subst: Subst, ty: u32, fallback: u32) -> u32 {
    let substituted = sub_ty(inout state, in subst, ty);
    if substituted == NONE {
        fallback
    } else {
        substituted
    }
}

// The result of a unification: 0 Ok, else the diagnostic code with the
// reason in `err` (empty for `String::new()`).

pub fn unify_dtype(inout state: St, inout subst: Subst, lhs_raw: u32, rhs_raw: u32) -> u32 {
    let lhs = sub_dtype(in subst, lhs_raw);
    let rhs = sub_dtype(in subst, rhs_raw);
    if lhs == rhs {
        return 0;
    }
    if (lhs >= 2 && (lhs & 1) == 1)
        && (state.names.size(((wrapping_sub(lhs, 2) >> 1))) > 0
            && state.names.byte(((wrapping_sub(lhs, 2) >> 1)), 0) == 63)
    {
        set_dtype(inout subst, (wrapping_sub(lhs, 2) >> 1), rhs);
        return 0;
    }
    if (rhs >= 2 && (rhs & 1) == 1)
        && (state.names.size(((wrapping_sub(rhs, 2) >> 1))) > 0
            && state.names.byte(((wrapping_sub(rhs, 2) >> 1)), 0) == 63)
    {
        set_dtype(inout subst, (wrapping_sub(rhs, 2) >> 1), lhs);
        return 0;
    }
    let mut message = ChunkSeq::new[u8]();
    put(inout message, in "element type ");
    put_dtype(in state, inout message, lhs);
    put(inout message, in " differs from ");
    put_dtype(in state, inout message, rhs);
    state.err = message;
    766
}

// `Subst::solve`: bind the single flexible variable of `a` so `a == b`.
fn solve(inout state: St, inout subst: Subst, a: u32, b: u32) -> bool {
    let mut flex_var = NONE;
    let mut count: u64 = 0;
    let mut exp: u32 = 0;
    for i in 0..widen_u64(dim_node(in state, a).factor_count) {
        let var = dim_var_at(in state, a, i);
        if (state.names.size(var) > 0 && state.names.byte(var, 0) == 63) {
            count = inc(count);
            flex_var = var;
            exp = dim_exp_at(in state, a, i);
        }
    }
    if count != 1 || exp != 1 {
        return false;
    }
    if dim_mentions(in state, b, flex_var) {
        return false;
    }
    let rest = dim_without(inout state, a, flex_var);
    if !dim_divides(in state, rest, b) {
        return false;
    }
    let value = dim_quotient(inout state, rest, b);
    set_dim(inout subst, flex_var, value);
    true
}

pub fn unify_dim(inout state: St, inout subst: Subst, lhs_raw: u32, rhs_raw: u32) -> u32 {
    let lhs = sub_dim(inout state, in subst, lhs_raw);
    if lhs == NONE {
        return 762;
    }
    let rhs = sub_dim(inout state, in subst, rhs_raw);
    if rhs == NONE {
        return 762;
    }
    if lhs == rhs {
        return 0;
    }
    if solve(inout state, inout subst, lhs, rhs) || solve(inout state, inout subst, rhs, lhs) {
        return 0;
    }
    if dim_flexible(in state, lhs) || dim_flexible(in state, rhs) {
        subst.pending_lhs.push(lhs);
        subst.pending_rhs.push(rhs);
        return 0;
    }
    let mut message = ChunkSeq::new[u8]();
    put_dim(in state, inout message, lhs);
    put(inout message, in " differs from ");
    put_dim(in state, inout message, rhs);
    state.err = message;
    763
}

// Prefixes `err` with `prefix` (and a number when `with_n`) and ": ".
fn prefix_err(inout state: St, in prefix: Str, with_n: bool, n: u64) {
    let mut message = ChunkSeq::new[u8]();
    put(inout message, in prefix);
    if with_n {
        push_decimal(inout message, n);
    }
    put(inout message, in ": ");
    message.extend(in state.err.as_slice());
    state.err = message;
}

// `Subst::unify(exp, act)`.
pub fn unify(inout state: St, inout subst: Subst, exp_raw: u32, act_raw: u32) -> u32 {
    let exp = sub_ty(inout state, in subst, exp_raw);
    if exp == NONE {
        return 762;
    }
    let act = sub_ty(inout state, in subst, act_raw);
    if act == NONE {
        return 762;
    }
    let exp_node = ty_node(in state, exp);
    let act_node = ty_node(in state, act);
    if exp_node.kind == T_UNKNOWN || act_node.kind == T_UNKNOWN {
        return 0;
    }
    if exp_node.kind == T_VAR
        && (state.names.size(exp_node.primary) > 0 && state.names.byte(exp_node.primary, 0) == 63)
    {
        set_ty(inout subst, exp_node.primary, act);
        return 0;
    }
    if act_node.kind == T_VAR
        && (state.names.size(act_node.primary) > 0 && state.names.byte(act_node.primary, 0) == 63)
    {
        set_ty(inout subst, act_node.primary, exp);
        return 0;
    }
    if exp_node.kind == T_TENSOR && act_node.kind == T_TENSOR {
        let code = unify_dtype(inout state, inout subst, exp_node.primary, act_node.primary);
        if code != 0 {
            return code;
        }
        if exp_node.arity != act_node.arity {
            let mut message = ChunkSeq::new[u8]();
            put(inout message, in "rank ");
            push_decimal(inout message, widen_u64(exp_node.arity));
            put(inout message, in " differs from rank ");
            push_decimal(inout message, widen_u64(act_node.arity));
            state.err = message;
            return 763;
        }
        for i in 0..widen_u64(exp_node.arity) {
            let axis_code = unify_dim(
                inout state,
                inout subst,
                ty_item(in state, exp, i),
                ty_item(in state, act, i)
            );
            if axis_code != 0 {
                prefix_err(inout state, in "axis ", true, i);
                return axis_code;
            }
        }
        return 0;
    }
    if (exp_node.kind == T_LEASE && act_node.kind == T_LEASE)
        || (exp_node.kind == T_SEQ && act_node.kind == T_SEQ)
    {
        let kv_heads_code = unify_dim(inout state, inout subst, exp_node.primary, act_node.primary);
        if kv_heads_code != 0 {
            prefix_err(inout state, in "KvHeads", false, 0);
            return kv_heads_code;
        }
        let head_dim_code = unify_dim(
            inout state,
            inout subst,
            exp_node.secondary,
            act_node.secondary
        );
        if head_dim_code != 0 {
            prefix_err(inout state, in "HeadDim", false, 0);
            return head_dim_code;
        }
        return 0;
    }
    if exp_node.kind == T_ADT
        && act_node.kind == T_ADT
        && exp_node.primary == act_node.primary
        && exp_node.arity == act_node.arity
    {
        for i in 0..widen_u64(exp_node.arity) {
            let exp_tag = ty_item(in state, exp, wrapping_mul(i, 2));
            let act_tag = ty_item(in state, act, wrapping_mul(i, 2));
            let exp_arg = ty_item(in state, exp, inc(wrapping_mul(i, 2)));
            let act_arg = ty_item(in state, act, inc(wrapping_mul(i, 2)));
            let mut code: u32 = 0;
            if exp_tag == 0 && act_tag == 0 {
                code = unify(inout state, inout subst, exp_arg, act_arg);
            } else if exp_tag == 1 && act_tag == 1 {
                code = unify_dim(inout state, inout subst, exp_arg, act_arg);
            } else if exp_tag == 2 && act_tag == 2 {
                code = unify_dtype(inout state, inout subst, exp_arg, act_arg);
            }
            if code != 0 {
                return code;
            }
        }
        return 0;
    }
    if (exp_node.kind == T_TUPLE && act_node.kind == T_TUPLE && exp_node.arity == act_node.arity)
        || (exp_node.kind == T_FN && act_node.kind == T_FN && exp_node.arity == act_node.arity)
    {
        for i in 0..widen_u64(exp_node.arity) {
            let code = unify(
                inout state,
                inout subst,
                ty_item(in state, exp, i),
                ty_item(in state, act, i)
            );
            if code != 0 {
                return code;
            }
        }
        if exp_node.kind == T_FN {
            return unify(inout state, inout subst, exp_node.secondary, act_node.secondary);
        }
        return 0;
    }
    if exp_node.kind == T_VAR && act_node.kind == T_VAR && exp_node.primary == act_node.primary {
        return 0;
    }
    if !has_tensor(in state, exp) && !has_tensor(in state, act) {
        return 0;
    }
    state.err.clear();
    763
}

// `Subst::settle`.
pub fn settle(inout state: St, inout subst: Subst) -> u32 {
    for round in 0..16 {
        if subst.pending_lhs.len() == 0 {
            return 0;
        }
        let mut pending_lhs = ChunkSeq::new[u32]();
        let mut pending_rhs = ChunkSeq::new[u32]();
        pending_lhs.extend(in subst.pending_lhs.as_slice());
        pending_rhs.extend(in subst.pending_rhs.as_slice());
        subst.pending_lhs.clear();
        subst.pending_rhs.clear();
        let before = pending_lhs.len();
        for i in 0..before {
            let code = unify_dim(
                inout state,
                inout subst,
                u32_at(in pending_lhs, i),
                u32_at(in pending_rhs, i)
            );
            if code != 0 {
                return code;
            }
        }
        if subst.pending_lhs.len() >= before {
            break;
        }
    }
    if subst.pending_lhs.len() == 0 {
        return 0;
    }
    let lhs = u32_at(in subst.pending_lhs, 0);
    let rhs = u32_at(in subst.pending_rhs, 0);
    let lhs_dim = sub_dim_or(inout state, in subst, lhs);
    let rhs_dim = sub_dim_or(inout state, in subst, rhs);
    let mut message = ChunkSeq::new[u8]();
    put(inout message, in "cannot solve ");
    put_dim(in state, inout message, lhs_dim);
    put(inout message, in " = ");
    put_dim(in state, inout message, rhs_dim);
    state.err = message;
    764
}

// `unify(..).and_then(|_| settle())`.
pub fn unify_settle(inout state: St, inout subst: Subst, exp: u32, act: u32) -> u32 {
    let code = unify(inout state, inout subst, exp, act);
    if code != 0 {
        return code;
    }
    settle(inout state, inout subst)
}

// Whether `subst` binds dimension variable `var` (`s.dims.contains_key(v)`).
pub fn binds_dim(in subst: Subst, var: u32) -> bool {
    find(in subst.dim_keys, in subst.dim_values, var) != NONE
}
