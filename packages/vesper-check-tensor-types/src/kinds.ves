pub fn effectn(in a: Ast, i: u32) -> EffectNode {
    a
        .effect_nodes
        .get_or(
        idx_from_raw[EffectNode](i),
        EffectNode {
            label: NONE,
            name: NONE,
            args: 0
        }
    )
}

pub fn stmtn(in a: Ast, i: u32) -> StmtNode {
    a
        .stmts
        .get_or(
        idx_from_raw[StmtNode](i),
        StmtNode {
            kind: 0,
            pat: NONE,
            ty: NONE,
            value: NONE,
            mutable: false
        }
    )
}

pub fn argn(in a: Ast, i: u32) -> ArgNode {
    a
        .args
        .get_or(
        idx_from_raw[ArgNode](i),
        ArgNode {
            pass: 0,
            explicit: false,
