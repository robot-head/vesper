// The module-level tables of the tensor checker and the surface-type half
// of src/tensor_types (types.rs `collect_kinds`, `resolve_kinds`,
// `adt_kinds`, `Scope`, `display_type`; infer.rs `mentions_tensors`,
// `type_mentions` and the item walks).

use @vesper/ast::{
    Ast,
    ExprNode,
    PatNode,
    TypeNode,
    StmtNode,
    ArgNode,
    ClauseNode,
    ParamNode,
    EffectsNode,
    EffectNode,
    GenericNode,
    FieldNode,
    VariantNode,
    AdtNode,
    FnNode,
    EffectDeclNode,
    ImplNode,
    TraitNode,
    ConfNode,
    ItemNode,
    list_len,
    list_at,
    expr_at,
    pat_at,
    type_at
};
use @vesper-std/arena::{
    idx_from_raw
};
use @vesper/check-data::util::{
    push_decimal,
    add,
    inc,
    n32,
    u32_at,
    u8_at,
    w
};
use self::state::{
    St,
    put,
    fail,
    spells,
    is_digits,
    first_colons,
    name_prefix,
    dim_const,
    dim_var,
    dim_mul,
    dim_fail,
    mk_ty,
    ty_named,
    ty_pair,
    has_tensor,
};

const NONE: u32 = 4294967295;
const MAX_DIM: u64 = 1099511627776;

const T_TENSOR: u8 = 1;
const T_LEASE: u8 = 2;
const T_SEQ: u8 = 3;
const T_ADT: u8 = 4;
const T_TUPLE: u8 = 5;
const T_FN: u8 = 6;
const T_VAR: u8 = 7;
const T_BASE: u8 = 8;

// `types::Kind`, in its `Ord` order.
const KD_DIM: u8 = 0;
const KD_DTYPE: u8 = 1;
const KD_TYPE: u8 = 2;

// Obligations (`infer::Obligation`): k 0 Even (d1 the dim), 1 Divides
// (d1 divisor, d2 value); `r` the reason's name.
pub copy struct Ob {
    k: u8,
    d1: u32,
    d2: u32,
    r: u32
}

pub struct Cx {
    // `AdtKinds`: name -> row; row = kinds at ak_k[a..a + n].
    ak_row: ChunkSeq[u32],
    ak_a: ChunkSeq[u32],
    ak_n: ChunkSeq[u32],
    ak_k: ChunkSeq[u8],
    // `AdtInfo` by name: kinds, generics, variants and fields.
    ai_row: ChunkSeq[u32],
    ai_name: ChunkSeq[u32],
    ai_ka: ChunkSeq[u32],
    ai_kn: ChunkSeq[u32],
    ai_ga: ChunkSeq[u32],
    ai_gn: ChunkSeq[u32],
    ai_va: ChunkSeq[u32],
    ai_vn: ChunkSeq[u32],
    ai_enum: ChunkSeq[u8],
    ai_syms: ChunkSeq[u32],
    ai_kinds: ChunkSeq[u8],
    vr_name: ChunkSeq[u32],
    vr_fa: ChunkSeq[u32],
    vr_fn: ChunkSeq[u32],
    fr_name: ChunkSeq[u32],
    fr_ty: ChunkSeq[u32],
    // Info rows of distinct names in name order (`BTreeMap` iteration).
    ai_sorted: ChunkSeq[u32],
    // Wire struct names (`wire_struct_names`), by name.
    blocks: ChunkSeq[u8],
    // Checked wires by name: 0 absent, 1 a quantized format, 2 + row of
    // its mismatch message.
    wire: ChunkSeq[u32],
    wa: ChunkSeq[u64],
    wb: ChunkSeq[u64],
    wtext: ChunkSeq[u8],
    // Signatures by name (`FnSig`).
    sg_row: ChunkSeq[u32],
    sg_name: ChunkSeq[u32],
    sg_ga: ChunkSeq[u32],
    sg_gn: ChunkSeq[u32],
    sg_gsym: ChunkSeq[u32],
    sg_gkind: ChunkSeq[u8],
    sg_pa: ChunkSeq[u32],
    sg_pn: ChunkSeq[u32],
    sg_ppass: ChunkSeq[u8],
    sg_pty: ChunkSeq[u32],
    sg_res: ChunkSeq[u32],
    sg_pool: ChunkSeq[u8],
    sg_kv: ChunkSeq[u32],
    sg_hd: ChunkSeq[u32],
    sg_oa: ChunkSeq[u32],
    sg_on: ChunkSeq[u32],
    sg_start: ChunkSeq[u64],
    sg_end: ChunkSeq[u64],
    obs: ChunkSeq[Ob],
    // The scope of a conversion: generic name -> kind (newest first).
    sc_name: ChunkSeq[u32],
    sc_kind: ChunkSeq[u8],
    // `collect_kinds`: the generics being collected and their kind sets.
    gset: ChunkSeq[u32],
    us_name: ChunkSeq[u32],
    us_mask: ChunkSeq[u8],
    // The body being checked.
    cur: u32,
    en_name: ChunkSeq[u32],
    en_ty: ChunkSeq[u32],
    en_marks: ChunkSeq[u64],
    bo: ChunkSeq[Ob],
    fresh: u64,
    s_zero: u32,
    s_one: u32
}

pub fn cx_new(inout st: St) -> Cx {
    Cx {
        ak_row: ChunkSeq::new[u32](),
        ak_a: ChunkSeq::new[u32](),
        ak_n: ChunkSeq::new[u32](),
        ak_k: ChunkSeq::new[u8](),
        ai_row: ChunkSeq::new[u32](),
        ai_name: ChunkSeq::new[u32](),
        ai_ka: ChunkSeq::new[u32](),
        ai_kn: ChunkSeq::new[u32](),
        ai_ga: ChunkSeq::new[u32](),
        ai_gn: ChunkSeq::new[u32](),
        ai_va: ChunkSeq::new[u32](),
        ai_vn: ChunkSeq::new[u32](),
        ai_enum: ChunkSeq::new[u8](),
        ai_syms: ChunkSeq::new[u32](),
        ai_kinds: ChunkSeq::new[u8](),
        vr_name: ChunkSeq::new[u32](),
        vr_fa: ChunkSeq::new[u32](),
        vr_fn: ChunkSeq::new[u32](),
        fr_name: ChunkSeq::new[u32](),
        fr_ty: ChunkSeq::new[u32](),
        ai_sorted: ChunkSeq::new[u32](),
        blocks: ChunkSeq::new[u8](),
        wire: ChunkSeq::new[u32](),
        wa: ChunkSeq::new[u64](),
        wb: ChunkSeq::new[u64](),
        wtext: ChunkSeq::new[u8](),
        sg_row: ChunkSeq::new[u32](),
        sg_name: ChunkSeq::new[u32](),
        sg_ga: ChunkSeq::new[u32](),
        sg_gn: ChunkSeq::new[u32](),
        sg_gsym: ChunkSeq::new[u32](),
        sg_gkind: ChunkSeq::new[u8](),
        sg_pa: ChunkSeq::new[u32](),
        sg_pn: ChunkSeq::new[u32](),
        sg_ppass: ChunkSeq::new[u8](),
        sg_pty: ChunkSeq::new[u32](),
        sg_res: ChunkSeq::new[u32](),
        sg_pool: ChunkSeq::new[u8](),
        sg_kv: ChunkSeq::new[u32](),
        sg_hd: ChunkSeq::new[u32](),
        sg_oa: ChunkSeq::new[u32](),
        sg_on: ChunkSeq::new[u32](),
        sg_start: ChunkSeq::new[u64](),
        sg_end: ChunkSeq::new[u64](),
        obs: ChunkSeq::new[Ob](),
        sc_name: ChunkSeq::new[u32](),
        sc_kind: ChunkSeq::new[u8](),
        gset: ChunkSeq::new[u32](),
        us_name: ChunkSeq::new[u32](),
        us_mask: ChunkSeq::new[u8](),
        cur: NONE,
        en_name: ChunkSeq::new[u32](),
        en_ty: ChunkSeq::new[u32](),
        en_marks: ChunkSeq::new[u64](),
        bo: ChunkSeq::new[Ob](),
        fresh: 0,
        s_zero: st.names.intern(in "0".as_bytes()),
        s_one: st.names.intern(in "1".as_bytes())
    }
}

// ----- tables keyed by name -------------------------------------------------------

pub fn at32(in t: ChunkSeq[u32], i: u32) -> u32 {
    match t.try_get(widen_u64(i)) {
        Option::Some(v) => v,
        Option::None => NONE,
    }
}

pub fn set32(inout t: ChunkSeq[u32], i: u32, v: u32) {
    if widen_u64(i) >= t.len() {
        t.resize(inc(widen_u64(i)), NONE);
    }
    let ok = t.try_set(widen_u64(i), v);
}


pub fn set8(inout t: ChunkSeq[u8], i: u32, v: u8) {
    if widen_u64(i) >= t.len() {
        t.resize(inc(widen_u64(i)), 0);
    }
    let ok = t.try_set(widen_u64(i), v);
}

// The `AdtKinds` row of a name, or NONE.



// ----- AST access -------------------------------------------------------------------

// The name of an AST symbol.
pub fn nm(in st: St, s: u32) -> u32 {
    if s == NONE {
        NONE
    } else {
        u32_at(in st.amap, widen_u64(s))
    }
}






pub fn paramn(in a: Ast, i: u32) -> ParamNode {
    a
        .params
        .get_or(
        idx_from_raw[ParamNode](i),
        ParamNode {
            name: NONE,
            pass: 0,
            projections: 0,
            ty: NONE,
            start: 0,
            end: 0
        }
    )
}

pub fn fnn(in a: Ast, i: u32) -> FnNode {
    a
        .fns
        .get_or(
        idx_from_raw[FnNode](i),
        FnNode {
            name: NONE,
            fip: false,
            generics: 0,
            params: 0,
            result: NONE,
            effects: NONE,
            body: NONE,
            start: 0,
            end: 0
        }
    )
}

pub fn adtn(in a: Ast, i: u32) -> AdtNode {
    a
        .adts
        .get_or(
        idx_from_raw[AdtNode](i),
        AdtNode {
            name: NONE,
            mode: 0,
            generics: 0,
            variants: 0,
            is_enum: false,
            tiled: false,
            tile_width: 0,
            start: 0,
            end: 0
        }
    )
}

pub fn variantn(in a: Ast, i: u32) -> VariantNode {
    a
        .variants
        .get_or(
        idx_from_raw[VariantNode](i),
        VariantNode {
            name: NONE,
            fields: 0,
            named: false
        }
    )
}

pub fn fieldn(in a: Ast, i: u32) -> FieldNode {
    a
        .fields
        .get_or(
        idx_from_raw[FieldNode](i),
        FieldNode {
            name: NONE,
            ty: NONE,
            modality: 3,
            temperature: 0
        }
    )
}

pub fn genericn(in a: Ast, i: u32) -> GenericNode {
    a
        .generics
        .get_or(
        idx_from_raw[GenericNode](i),
        GenericNode {
            name: NONE,
            bound: 0,
            row: false
        }
    )
}

pub fn effectsn(in a: Ast, i: u32) -> EffectsNode {
    a
        .effects
        .get_or(
        idx_from_raw[EffectsNode](i),
        EffectsNode {
            instances: 0,
            tail: NONE
