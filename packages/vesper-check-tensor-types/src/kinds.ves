// The module-level tables of the tensor checker and the surface-type half
// of src/tensor_types (types.rs `collect_kinds`, `resolve_kinds`,
// `adt_kinds`, `Scope`, `display_type`; infer.rs `mentions_tensors`,
// `type_mentions` and the item walks).

use @vesper/ast::{
    Ast, ExprNode, PatNode, TypeNode, StmtNode, ArgNode, ClauseNode, ParamNode, EffectsNode,
    EffectNode, GenericNode, FieldNode, VariantNode, AdtNode, FnNode, EffectDeclNode, ImplNode,
    TraitNode, ConfNode, ItemNode, list_len, list_at, expr_at, pat_at, type_at
};
use @vesper-std/arena::{idx_from_raw};
use @vesper/check-data::util::{push_decimal, add, inc, n32, u32_at, u64_at, u8_at, w};
use self::state::{
    St,
    put,
    fail,
    spells,
    is_digits,
    first_colons,
    name_prefix,
    dim_const,
    dim_var,
    dim_mul,
    dim_fail,
    mk_ty,
    ty_named,
    ty_pair,
    has_tensor,
};

const NONE: u32 = 4294967295;
const MAX_DIM: u64 = 1099511627776;

const T_TENSOR: u8 = 1;
const T_LEASE: u8 = 2;
const T_SEQ: u8 = 3;
const T_ADT: u8 = 4;
const T_TUPLE: u8 = 5;
const T_FN: u8 = 6;
const T_VAR: u8 = 7;
const T_BASE: u8 = 8;

// `types::Kind`, in its `Ord` order.
const KD_DIM: u8 = 0;
const KD_DTYPE: u8 = 1;
const KD_TYPE: u8 = 2;

// Obligations (`infer::Obligation`): `kind` 0 Even (`dim` the dim), 1
// Divides (`dim` divisor, `multiple` value); `reason` the reason's name.
pub copy struct Ob {
    kind: u8,
    dim: u32,
    multiple: u32,
    reason: u32
}

pub struct Cx {
    // `AdtKinds`: name -> row; row = kinds at
    // `adt_kind_values[start..start + count]`.
    adt_kind_rows: ChunkSeq[u32],
    adt_kind_starts: ChunkSeq[u32],
    adt_kind_counts: ChunkSeq[u32],
    adt_kind_values: ChunkSeq[u8],
    // `AdtInfo` by name: kinds, generics, variants and fields.
    info_rows: ChunkSeq[u32],
    info_names: ChunkSeq[u32],
    info_kind_starts: ChunkSeq[u32],
    info_kind_counts: ChunkSeq[u32],
    info_generic_starts: ChunkSeq[u32],
    info_generic_counts: ChunkSeq[u32],
    info_variant_starts: ChunkSeq[u32],
    info_variant_counts: ChunkSeq[u32],
    info_is_enum: ChunkSeq[u8],
    info_generic_names: ChunkSeq[u32],
    info_kind_values: ChunkSeq[u8],
    variant_names: ChunkSeq[u32],
    variant_field_starts: ChunkSeq[u32],
    variant_field_counts: ChunkSeq[u32],
    variant_field_names: ChunkSeq[u32],
    variant_field_tys: ChunkSeq[u32],
    // Info rows of distinct names in name order (`BTreeMap` iteration).
    info_rows_sorted: ChunkSeq[u32],
    // Wire struct names (`wire_struct_names`), by name.
    blocks: ChunkSeq[u8],
    // Checked wires by name: 0 absent, 1 a quantized format, 2 + row of
    // its mismatch message.
    wire_status: ChunkSeq[u32],
    wire_msg_starts: ChunkSeq[u64],
    wire_msg_ends: ChunkSeq[u64],
    wire_text: ChunkSeq[u8],
    // Signatures by name (`FnSig`).
    sig_rows: ChunkSeq[u32],
    sig_names: ChunkSeq[u32],
    sig_generic_starts: ChunkSeq[u32],
    sig_generic_counts: ChunkSeq[u32],
    sig_generic_names: ChunkSeq[u32],
    sig_generic_kinds: ChunkSeq[u8],
    sig_param_starts: ChunkSeq[u32],
    sig_param_counts: ChunkSeq[u32],
    sig_param_passes: ChunkSeq[u8],
    sig_param_tys: ChunkSeq[u32],
    sig_results: ChunkSeq[u32],
    sig_uses_pool: ChunkSeq[u8],
    sig_kv_heads: ChunkSeq[u32],
    sig_head_dims: ChunkSeq[u32],
    sig_ob_starts: ChunkSeq[u32],
    sig_ob_counts: ChunkSeq[u32],
    sig_starts: ChunkSeq[u64],
    sig_ends: ChunkSeq[u64],
    obs: ChunkSeq[Ob],
    // The scope of a conversion: generic name -> kind (newest first).
    scope_names: ChunkSeq[u32],
    scope_kinds: ChunkSeq[u8],
    // `collect_kinds`: the generics being collected and their kind sets.
    generic_set: ChunkSeq[u32],
    use_names: ChunkSeq[u32],
    use_masks: ChunkSeq[u8],
    // The body being checked.
    current_sig: u32,
    env_names: ChunkSeq[u32],
    env_tys: ChunkSeq[u32],
    env_marks: ChunkSeq[u64],
    body_obs: ChunkSeq[Ob],
    fresh_count: u64,
    zero_name: u32,
    one_name: u32,
    // Call elaborations: `(elab_starts, elab_ends) -> elab_kinds` (1 = Dims,
    // 2 = Shape, 0 = removed).
    elab_starts: ChunkSeq[u64],
    elab_ends: ChunkSeq[u64],
    elab_kinds: ChunkSeq[u8],
    elab_dims_starts: ChunkSeq[u32],
    elab_dims_lens: ChunkSeq[u32],
    elab_dims: ChunkSeq[u32]
}

pub fn cx_new(inout state: St) -> Cx {
    Cx {
        adt_kind_rows: ChunkSeq::new[u32](),
        adt_kind_starts: ChunkSeq::new[u32](),
        adt_kind_counts: ChunkSeq::new[u32](),
        adt_kind_values: ChunkSeq::new[u8](),
        info_rows: ChunkSeq::new[u32](),
        info_names: ChunkSeq::new[u32](),
        info_kind_starts: ChunkSeq::new[u32](),
        info_kind_counts: ChunkSeq::new[u32](),
        info_generic_starts: ChunkSeq::new[u32](),
        info_generic_counts: ChunkSeq::new[u32](),
        info_variant_starts: ChunkSeq::new[u32](),
        info_variant_counts: ChunkSeq::new[u32](),
        info_is_enum: ChunkSeq::new[u8](),
        info_generic_names: ChunkSeq::new[u32](),
        info_kind_values: ChunkSeq::new[u8](),
        variant_names: ChunkSeq::new[u32](),
        variant_field_starts: ChunkSeq::new[u32](),
        variant_field_counts: ChunkSeq::new[u32](),
        variant_field_names: ChunkSeq::new[u32](),
        variant_field_tys: ChunkSeq::new[u32](),
        info_rows_sorted: ChunkSeq::new[u32](),
        blocks: ChunkSeq::new[u8](),
        wire_status: ChunkSeq::new[u32](),
        wire_msg_starts: ChunkSeq::new[u64](),
        wire_msg_ends: ChunkSeq::new[u64](),
        wire_text: ChunkSeq::new[u8](),
        sig_rows: ChunkSeq::new[u32](),
        sig_names: ChunkSeq::new[u32](),
        sig_generic_starts: ChunkSeq::new[u32](),
        sig_generic_counts: ChunkSeq::new[u32](),
        sig_generic_names: ChunkSeq::new[u32](),
        sig_generic_kinds: ChunkSeq::new[u8](),
        sig_param_starts: ChunkSeq::new[u32](),
        sig_param_counts: ChunkSeq::new[u32](),
        sig_param_passes: ChunkSeq::new[u8](),
        sig_param_tys: ChunkSeq::new[u32](),
        sig_results: ChunkSeq::new[u32](),
        sig_uses_pool: ChunkSeq::new[u8](),
        sig_kv_heads: ChunkSeq::new[u32](),
        sig_head_dims: ChunkSeq::new[u32](),
        sig_ob_starts: ChunkSeq::new[u32](),
        sig_ob_counts: ChunkSeq::new[u32](),
        sig_starts: ChunkSeq::new[u64](),
        sig_ends: ChunkSeq::new[u64](),
        obs: ChunkSeq::new[Ob](),
        scope_names: ChunkSeq::new[u32](),
        scope_kinds: ChunkSeq::new[u8](),
        generic_set: ChunkSeq::new[u32](),
        use_names: ChunkSeq::new[u32](),
        use_masks: ChunkSeq::new[u8](),
        current_sig: NONE,
        env_names: ChunkSeq::new[u32](),
        env_tys: ChunkSeq::new[u32](),
        env_marks: ChunkSeq::new[u64](),
        body_obs: ChunkSeq::new[Ob](),
        fresh_count: 0,
        zero_name: state.names.intern(in "0".as_bytes()),
        one_name: state.names.intern(in "1".as_bytes()),
        elab_starts: ChunkSeq::new[u64](),
        elab_ends: ChunkSeq::new[u64](),
        elab_kinds: ChunkSeq::new[u8](),
        elab_dims_starts: ChunkSeq::new[u32](),
        elab_dims_lens: ChunkSeq::new[u32](),
        elab_dims: ChunkSeq::new[u32]()
    }
}

pub fn elab_clear(inout ctx: Cx) {
    ctx.elab_starts.clear();
    ctx.elab_ends.clear();
    ctx.elab_kinds.clear();
    ctx.elab_dims_starts.clear();
    ctx.elab_dims_lens.clear();
    ctx.elab_dims.clear();
}

pub fn elab_find(in ctx: Cx, start: u64, end: u64) -> u64 {
    let n = ctx.elab_starts.len();
    for i in 0..n {
        if u8_at(in ctx.elab_kinds, i) != 0
            && u64_at(in ctx.elab_starts, i) == start
            && u64_at(in ctx.elab_ends, i) == end {
            return i;
        }
    }
    4294967295
}

pub fn elab_insert(inout ctx: Cx, start: u64, end: u64, kind: u8, in dims: ChunkSeq[u32]) {
    let dims_start = n32(ctx.elab_dims.len());
    let dims_len = n32(dims.len());
    for i in 0..dims.len() {
        ctx.elab_dims.push(u32_at(in dims, i));
    }
    let n = ctx.elab_starts.len();
    for i in 0..n {
        if u64_at(in ctx.elab_starts, i) == start && u64_at(in ctx.elab_ends, i) == end {
            let ok0 = ctx.elab_kinds.try_set(i, kind);
            let ok1 = ctx.elab_dims_starts.try_set(i, dims_start);
            let ok2 = ctx.elab_dims_lens.try_set(i, dims_len);
            return;
        }
    }
    ctx.elab_starts.push(start);
    ctx.elab_ends.push(end);
    ctx.elab_kinds.push(kind);
    ctx.elab_dims_starts.push(dims_start);
    ctx.elab_dims_lens.push(dims_len);
}

pub fn elab_remove(inout ctx: Cx, start: u64, end: u64) {
    let n = ctx.elab_starts.len();
    for i in 0..n {
        if u64_at(in ctx.elab_starts, i) == start && u64_at(in ctx.elab_ends, i) == end {
            let ok = ctx.elab_kinds.try_set(i, 0);
        }
    }
}

// ----- tables keyed by name -------------------------------------------------------

pub fn at32(in table: ChunkSeq[u32], i: u32) -> u32 {
    match table.try_get(widen_u64(i)) {
        Option::Some(value) => value,
        Option::None => NONE,
    }
}

pub fn set32(inout table: ChunkSeq[u32], i: u32, value: u32) {
    if widen_u64(i) >= table.len() {
        table.resize(inc(widen_u64(i)), NONE);
    }
    let ok = table.try_set(widen_u64(i), value);
}

pub fn set8(inout table: ChunkSeq[u8], i: u32, value: u8) {
    if widen_u64(i) >= table.len() {
        table.resize(inc(widen_u64(i)), 0);
    }
    let ok = table.try_set(widen_u64(i), value);
}

// The `AdtKinds` row of a name, or NONE.

// ----- AST access -------------------------------------------------------------------

// The name of an AST symbol.
pub fn nm(in state: St, symbol: u32) -> u32 {
    if symbol == NONE {
        NONE
    } else {
        u32_at(in state.ast_names, widen_u64(symbol))
    }
}

pub fn paramn(in ast: Ast, i: u32) -> ParamNode {
    ast.params.get_or(
        idx_from_raw[ParamNode](i),
        ParamNode { name: NONE, pass: 0, projections: 0, ty: NONE, start: 0, end: 0 }
    )
}

pub fn fnn(in ast: Ast, i: u32) -> FnNode {
    ast.fns.get_or(
        idx_from_raw[FnNode](i),
        FnNode {
            name: NONE,
            fip: false,
            generics: 0,
            params: 0,
            result: NONE,
            effects: NONE,
            body: NONE,
            start: 0,
            end: 0
        }
    )
}

pub fn adtn(in ast: Ast, i: u32) -> AdtNode {
    ast.adts.get_or(
        idx_from_raw[AdtNode](i),
        AdtNode {
            name: NONE,
            mode: 0,
            generics: 0,
            variants: 0,
            is_enum: false,
            tiled: false,
            tile_width: 0,
            start: 0,
            end: 0
        }
    )
}

pub fn variantn(in ast: Ast, i: u32) -> VariantNode {
    ast.variants
        .get_or(idx_from_raw[VariantNode](i), VariantNode { name: NONE, fields: 0, named: false })
}

pub fn fieldn(in ast: Ast, i: u32) -> FieldNode {
    ast.fields.get_or(
        idx_from_raw[FieldNode](i),
        FieldNode { name: NONE, ty: NONE, modality: 3, temperature: 0 }
    )
}

pub fn genericn(in ast: Ast, i: u32) -> GenericNode {
    ast.generics
        .get_or(idx_from_raw[GenericNode](i), GenericNode { name: NONE, bound: 0, row: false })
}

pub fn effectsn(in ast: Ast, i: u32) -> EffectsNode {
    ast.effects.get_or(idx_from_raw[EffectsNode](i), EffectsNode { instances: 0, tail: NONE })
}

pub fn effectn(in ast: Ast, i: u32) -> EffectNode {
    ast.effect_nodes
        .get_or(idx_from_raw[EffectNode](i), EffectNode { label: NONE, name: NONE, args: 0 })
}

pub fn stmtn(in ast: Ast, i: u32) -> StmtNode {
    ast.stmts.get_or(
        idx_from_raw[StmtNode](i),
        StmtNode { kind: 0, pat: NONE, ty: NONE, value: NONE, mutable: false }
    )
}

pub fn argn(in ast: Ast, i: u32) -> ArgNode {
    ast.args.get_or(idx_from_raw[ArgNode](i), ArgNode { pass: 0, explicit: false, expr: NONE })
}

pub fn clausen(in ast: Ast, i: u32) -> ClauseNode {
    ast.clauses.get_or(idx_from_raw[ClauseNode](i), ClauseNode { name: NONE, pats: 0, body: NONE })
}

pub fn itemn(in ast: Ast, i: u32) -> ItemNode {
    ast.items.get_or(idx_from_raw[ItemNode](i), ItemNode { kind: 0, node: NONE })
}

pub fn effdecln(in ast: Ast, i: u32) -> EffectDeclNode {
    ast.effect_decls.get_or(
        idx_from_raw[EffectDeclNode](i),
        EffectDeclNode { name: NONE, linear: false, generics: 0, ops: 0, start: 0, end: 0 }
    )
}

pub fn impln(in ast: Ast, i: u32) -> ImplNode {
    ast.impls.get_or(idx_from_raw[ImplNode](i), ImplNode { ty: NONE, generics: 0, methods: 0 })
}

pub fn traitn(in ast: Ast, i: u32) -> TraitNode {
    ast.traits.get_or(
        idx_from_raw[TraitNode](i),
        TraitNode { name: NONE, public: false, generics: 0, assoc: 0, methods: 0, start: 0, end: 0 }
    )
}

pub fn confn(in ast: Ast, i: u32) -> ConfNode {
    ast.confs.get_or(
        idx_from_raw[ConfNode](i),
        ConfNode {
            model: NONE,
            public: false,
            generics: 0,
            trait_ref: NONE,
            self_ty: NONE,
            wheres: 0,
            assoc: 0,
            methods: 0,
            start: 0,
            end: 0
        }
    )
}

// The module's items.

pub fn item_at(in ast: Ast, i: u64) -> ItemNode {
    let id = match ast.m_items.try_get(i) {
        Option::Some(v) => v,
        Option::None => NONE,
    };
    itemn(in ast, id)
}

// A named type's name (as a name), or NONE.
pub fn tname(in state: St, in ast: Ast, ty: u32) -> u32 {
    let node = type_at(in ast, ty);
    if node.kind == 1 {
        nm(in state, node.a)
    } else {
        NONE
    }
}

// A named type's arguments list (0, the empty list, otherwise).
pub fn targs(in ast: Ast, ty: u32) -> u32 {
    let node = type_at(in ast, ty);
    if node.kind == 1 { node.b } else { 0 }
}

// ----- names --------------------------------------------------------------------------

// `RESERVED`.
pub fn is_reserved(in state: St, name: u32) -> bool {
    name == state.tensor_name
        || name == state.kv_pool_name
        || name == state.lease_name
        || name == state.seq_name
        || name == state.kv_oom_name
        || name == state.dims_name
        || name == state.f32_name
        || name == state.bf16_name
}

// `wire_integer(n).is_some()`: `[ui](16|32|64)(le|be)`.
pub fn is_wire_integer(in state: St, name: u32) -> bool {
    if name == NONE || state.names.size(name) != 5 {
        return false;
    }
    let sign_byte = state.names.byte(name, 0);
    let width_byte1 = state.names.byte(name, 1);
    let width_byte2 = state.names.byte(name, 2);
    let order_byte1 = state.names.byte(name, 3);
    let order_byte2 = state.names.byte(name, 4);
    let sign = sign_byte == 117 || sign_byte == 105;
    let bits = (width_byte1 == 49 && width_byte2 == 54)
        || (width_byte1 == 51 && width_byte2 == 50)
        || (width_byte1 == 54 && width_byte2 == 52);
    let end = (order_byte1 == 108 && order_byte2 == 101)
        || (order_byte1 == 98 && order_byte2 == 101);
    sign && bits && end
}

fn reserved_or_wire(in state: St, name: u32) -> bool {
    is_reserved(in state, name)
        || name == state.shape_name
        || name == state.byte_array_name
        || name == state.zero_pad_name
        || is_wire_integer(in state, name)
}

// `path_mentions`.
pub fn path_mentions(inout state: St, name: u32) -> bool {
    if is_reserved(in state, name) {
        return true;
    }
    let colons = first_colons(in state, name);
    if colons < state.names.size(name) {
        let prefix = name_prefix(inout state, name, colons);
        return is_reserved(in state, prefix);
    }
    false
}

// ----- mentions (infer.rs) ---------------------------------------------------------------

pub fn type_mentions(in state: St, in ast: Ast, ty: u32) -> bool {
    let node = type_at(in ast, ty);
    if node.kind == 1 {
        if reserved_or_wire(in state, nm(in state, node.a)) {
            return true;
        }
        for i in 0..list_len(in ast, node.b) {
            if type_mentions(in state, in ast, list_at(in ast, node.b, i)) {
                return true;
            }
        }
        false
    } else if node.kind == 2 {
        for i in 0..list_len(in ast, node.a) {
            if type_mentions(in state, in ast, list_at(in ast, node.a, i)) {
                return true;
            }
        }
        false
    } else if node.kind == 3 {
        let param_count = list_len(in ast, node.a) >> 1;
        for i in 0..param_count {
            if type_mentions(in state, in ast, list_at(in ast, node.a, inc(wrapping_mul(i, 2)))) {
                return true;
            }
        }
        type_mentions(in state, in ast, node.b) || row_mentions(in state, in ast, node.c)
    } else if node.kind == 4 {
        row_mentions(in state, in ast, node.a)
    } else {
        false
    }
}

pub fn effect_mentions(in state: St, in ast: Ast, effect_id: u32) -> bool {
    let effect = effectn(in ast, effect_id);
    if is_reserved(in state, nm(in state, effect.name)) {
        return true;
    }
    for j in 0..list_len(in ast, effect.args) {
        if type_mentions(in state, in ast, list_at(in ast, effect.args, j)) {
            return true;
        }
    }
    false
}

pub fn row_mentions(in state: St, in ast: Ast, row_id: u32) -> bool {
    if row_id == NONE {
        return false;
    }
    let row = effectsn(in ast, row_id);
    for i in 0..list_len(in ast, row.instances) {
        if effect_mentions(in state, in ast, list_at(in ast, row.instances, i)) {
            return true;
        }
    }
    false
}

fn pattern_mentions(inout state: St, in ast: Ast, pat_id: u32) -> bool {
    let node = pat_at(in ast, pat_id);
    if node.kind == 4 {
        for i in 0..list_len(in ast, node.a) {
            if pattern_mentions(inout state, in ast, list_at(in ast, node.a, i)) {
                return true;
            }
        }
    } else if node.kind == 5 {
        if path_mentions(inout state, nm(in state, node.a)) {
            return true;
        }
        let field_count = list_len(in ast, node.b) >> 1;
        for i in 0..field_count {
            if pattern_mentions(
                inout state,
                in ast,
                list_at(in ast, node.b, inc(wrapping_mul(i, 2)))
            ) {
                return true;
            }
        }
    }
    false
}

fn opt_mentions(inout state: St, in ast: Ast, expr_id: u32) -> bool {
    if expr_id == NONE {
        false
    } else {
        expr_mentions(inout state, in ast, expr_id)
    }
}

fn list_mentions(inout state: St, in ast: Ast, list: u32) -> bool {
    for i in 0..list_len(in ast, list) {
        if expr_mentions(inout state, in ast, list_at(in ast, list, i)) {
            return true;
        }
    }
    false
}

// `function_mentions`' walk of a body (`walk`).
pub fn expr_mentions(inout state: St, in ast: Ast, expr_id: u32) -> bool {
    let node = expr_at(in ast, expr_id);
    let kind = node.kind;
    if kind == 2 {
        return path_mentions(inout state, nm(in state, node.a));
    }
    if kind == 3 {
        return list_mentions(inout state, in ast, node.a);
    }
    if kind == 4 {
        if path_mentions(inout state, nm(in state, node.a)) {
            return true;
        }
        let field_count = list_len(in ast, node.b) >> 1;
        for i in 0..field_count {
            if expr_mentions(
                inout state,
                in ast,
                list_at(in ast, node.b, inc(wrapping_mul(i, 2)))
            ) {
                return true;
            }
        }
        return false;
    }
    if kind == 5 {
        for i in 0..list_len(in ast, node.a) {
            let stmt = stmtn(in ast, list_at(in ast, node.a, i));
            if stmt.kind == 1 {
                if type_mentions(in state, in ast, stmt.ty)
                    || pattern_mentions(inout state, in ast, stmt.pat)
                    || expr_mentions(inout state, in ast, stmt.value) {
                    return true;
                }
            } else if expr_mentions(inout state, in ast, stmt.value) {
                return true;
            }
        }
        return opt_mentions(inout state, in ast, node.b);
    }
    if kind == 6 {
        if expr_mentions(inout state, in ast, node.a) {
            return true;
        }
        for i in 0..list_len(in ast, node.b) {
            if type_mentions(in state, in ast, list_at(in ast, node.b, i)) {
                return true;
            }
        }
        for i in 0..list_len(in ast, node.c) {
            if expr_mentions(inout state, in ast, argn(in ast, list_at(in ast, node.c, i)).expr) {
                return true;
            }
        }
        return false;
    }
    if kind == 7 || kind == 9 || kind == 17 {
        return expr_mentions(inout state, in ast, node.a);
    }
    if kind == 10 {
        return expr_mentions(inout state, in ast, node.b);
    }
    if kind == 8 || kind == 19 {
        return expr_mentions(inout state, in ast, node.a)
            || expr_mentions(inout state, in ast, node.b);
    }
    if kind == 11 || kind == 12 {
        return expr_mentions(inout state, in ast, node.b)
            || expr_mentions(inout state, in ast, node.c);
    }
    if kind == 13 {
        return expr_mentions(inout state, in ast, node.a)
            || expr_mentions(inout state, in ast, node.b)
            || opt_mentions(inout state, in ast, node.c);
    }
    if kind == 14 {
        if expr_mentions(inout state, in ast, node.a) {
            return true;
        }
        let arm_count = list_len(in ast, node.b) >> 1;
        for i in 0..arm_count {
            if pattern_mentions(inout state, in ast, list_at(in ast, node.b, wrapping_mul(i, 2)))
                || expr_mentions(
                    inout state,
                    in ast,
                    list_at(in ast, node.b, inc(wrapping_mul(i, 2)))
                ) {
                return true;
            }
        }
        return false;
    }
    if kind == 18 {
        return expr_mentions(inout state, in ast, node.b)
            || pattern_mentions(inout state, in ast, node.a)
            || expr_mentions(inout state, in ast, node.c);
    }
    if kind == 20 || kind == 21 {
        return opt_mentions(inout state, in ast, node.a);
    }
    if kind == 15 {
        for i in 0..list_len(in ast, node.a) {
            if type_mentions(in state, in ast, paramn(in ast, list_at(in ast, node.a, i)).ty) {
                return true;
            }
        }
        return type_mentions(in state, in ast, node.c)
            || row_mentions(in state, in ast, node.d)
            || expr_mentions(inout state, in ast, node.e);
    }
    if kind == 16 {
        if effect_mentions(in state, in ast, node.a) {
            return true;
        }
        if node.b != NONE
            && (
                pattern_mentions(inout state, in ast, node.b)
                    || expr_mentions(inout state, in ast, node.c)
            ) {
            return true;
        }
        if expr_mentions(inout state, in ast, node.d) {
            return true;
        }
        for i in 0..list_len(in ast, node.e) {
            let clause = clausen(in ast, list_at(in ast, node.e, i));
            for j in 0..list_len(in ast, clause.pats) {
                if pattern_mentions(inout state, in ast, list_at(in ast, clause.pats, j)) {
                    return true;
                }
            }
            if expr_mentions(inout state, in ast, clause.body) {
                return true;
            }
        }
        return false;
    }
    false
}

pub fn function_mentions(inout state: St, in ast: Ast, fn_id: u32) -> bool {
    let func = fnn(in ast, fn_id);
    for i in 0..list_len(in ast, func.params) {
        if type_mentions(in state, in ast, paramn(in ast, list_at(in ast, func.params, i)).ty) {
            return true;
        }
    }
    if type_mentions(in state, in ast, func.result)
        || row_mentions(in state, in ast, func.effects) {
        return true;
    }
    if func.body != NONE {
        return expr_mentions(inout state, in ast, func.body);
    }
    false
}

pub fn fns_mention(inout state: St, in ast: Ast, list: u32) -> bool {
    for i in 0..list_len(in ast, list) {
        if function_mentions(inout state, in ast, list_at(in ast, list, i)) {
            return true;
        }
    }
    false
}

// `mentions_tensors`.
pub fn mentions_tensors(inout state: St, in ast: Ast) -> bool {
    for i in 0..ast.m_items.len() {
        let item = item_at(in ast, i);
        if item.kind == 1 {
            let adt = adtn(in ast, item.node);
            for variant_idx in 0..list_len(in ast, adt.variants) {
                let variant = variantn(in ast, list_at(in ast, adt.variants, variant_idx));
                for field_idx in 0..list_len(in ast, variant.fields) {
                    if type_mentions(
                        in state,
                        in ast,
                        fieldn(in ast, list_at(in ast, variant.fields, field_idx)).ty
                    ) {
                        return true;
                    }
                }
            }
        } else if item.kind == 2 {
            if function_mentions(inout state, in ast, item.node) {
                return true;
            }
        } else if item.kind == 3 {
            if fns_mention(inout state, in ast, effdecln(in ast, item.node).ops) {
                return true;
            }
        } else if item.kind == 4 {
            let impl_node = impln(in ast, item.node);
            if type_mentions(in state, in ast, impl_node.ty)
                || fns_mention(inout state, in ast, impl_node.methods) {
                return true;
            }
        } else if item.kind == 5 {
            if fns_mention(inout state, in ast, traitn(in ast, item.node).methods) {
                return true;
            }
        } else if item.kind == 6 {
            let conf = confn(in ast, item.node);
            if fns_mention(inout state, in ast, conf.methods)
                || type_mentions(in state, in ast, conf.self_ty) {
                return true;
            }
        }
    }
    false
}

// `tensor_types::active`.
pub fn active(inout state: St, in ast: Ast) -> bool {
    for i in 0..ast.m_items.len() {
        let item = item_at(in ast, i);
        if item.kind == 1 && is_reserved(in state, nm(in state, adtn(in ast, item.node).name)) {
            return false;
        }
        if item.kind == 3 && is_reserved(in state, nm(in state, effdecln(in ast, item.node).name)) {
            return false;
        }
    }
    mentions_tensors(inout state, in ast)
}

// ----- wire struct names (wire.rs) ------------------------------------------------------

fn wire_only(in state: St, in ast: Ast, ty: u32) -> bool {
    let node = type_at(in ast, ty);
    if node.kind != 1 {
        return false;
    }
    let name = nm(in state, node.a);
    (list_len(in ast, node.b) == 0 && is_wire_integer(in state, name))
        || name == state.byte_array_name
        || name == state.zero_pad_name
}

// `wire_struct_names`.
pub fn mark_blocks(in state: St, inout ctx: Cx, in ast: Ast) {
    for i in 0..ast.m_items.len() {
        let item = item_at(in ast, i);
        if item.kind != 1 {
            continue;
        }
        let adt = adtn(in ast, item.node);
        if adt.is_enum {
            continue;
        }
        let mut wire = false;
        for variant_idx in 0..list_len(in ast, adt.variants) {
            let variant = variantn(in ast, list_at(in ast, adt.variants, variant_idx));
            for field_idx in 0..list_len(in ast, variant.fields) {
                if wire_only(
                    in state,
                    in ast,
                    fieldn(in ast, list_at(in ast, variant.fields, field_idx)).ty
                ) {
                    wire = true;
                }
            }
        }
        if wire {
            set8(inout ctx.blocks, nm(in state, adt.name), 1);
        }
    }
}

pub fn is_block(in ctx: Cx, name: u32) -> bool {
    u8_at(in ctx.blocks, widen_u64(name)) == 1
}

// ----- kinds (types.rs) ---------------------------------------------------------------------

fn in_gset(in ctx: Cx, name: u32) -> bool {
    for i in 0..ctx.generic_set.len() {
        if u32_at(in ctx.generic_set, i) == name {
            return true;
        }
    }
    false
}

// `out.entry(n).or_default().insert(k)`.
fn use_kind(inout ctx: Cx, name: u32, kind: u8) {
    let bit = wrapping_shl_u8(1, widen_u32(kind));
    for i in 0..ctx.use_names.len() {
        if u32_at(in ctx.use_names, i) == name {
            let mask = u8_at(in ctx.use_masks, i) | bit;
            let ok = ctx.use_masks.try_set(i, mask);
            return;
        }
    }
    ctx.use_names.push(name);
    ctx.use_masks.push(bit);
}

pub fn uses_of(in ctx: Cx, name: u32) -> u8 {
    for i in 0..ctx.use_names.len() {
        if u32_at(in ctx.use_names, i) == name {
            return u8_at(in ctx.use_masks, i);
        }
    }
    0
}

pub fn uses_clear(inout ctx: Cx) {
    ctx.use_names.clear();
    ctx.use_masks.clear();
}

// `dim_names` with the `generics.contains` filter of its callers.
fn dim_names(in state: St, inout ctx: Cx, in ast: Ast, ty: u32) {
    let node = type_at(in ast, ty);
    if node.kind != 1 {
        return;
    }
    let name = nm(in state, node.a);
    if name == state.product_name || name == state.shape_name {
        for i in 0..list_len(in ast, node.b) {
            dim_names(in state, inout ctx, in ast, list_at(in ast, node.b, i));
        }
    } else if list_len(in ast, node.b) == 0 {
        if in_gset(in ctx, name) {
            use_kind(inout ctx, name, KD_DIM);
        }
    }
}

// Whether `ty` is `Named(d, [])` with `d` a collected generic: `d`, or NONE.
fn bare_generic(in state: St, in ctx: Cx, in ast: Ast, ty: u32) -> u32 {
    let node = type_at(in ast, ty);
    if node.kind == 1 && list_len(in ast, node.b) == 0 {
        let d = nm(in state, node.a);
        if in_gset(in ctx, d) {
            return d;
        }
    }
    NONE
}

// `collect_kinds` over the generics in `ctx.generic_set` into `ctx.use_*`.
pub fn collect_kinds(in state: St, inout ctx: Cx, in ast: Ast, ty: u32) {
    let node = type_at(in ast, ty);
    if node.kind == 1 {
        let name = nm(in state, node.a);
        let args = node.b;
        let arg_count = list_len(in ast, args);
        if name == state.tensor_name && arg_count == 2 {
            let generic = bare_generic(in state, in ctx, in ast, list_at(in ast, args, 0));
            if generic != NONE {
                use_kind(inout ctx, generic, KD_DTYPE);
            } else {
                collect_kinds(in state, inout ctx, in ast, list_at(in ast, args, 0));
            }
            dim_names(in state, inout ctx, in ast, list_at(in ast, args, 1));
        } else if name == state.lease_name || name == state.seq_name || name == state.shape_name {
            for i in 0..arg_count {
                dim_names(in state, inout ctx, in ast, list_at(in ast, args, i));
            }
        } else if arg_count == 0 && in_gset(in ctx, name) {
            use_kind(inout ctx, name, KD_TYPE);
        } else {
            let row = at32(in ctx.adt_kind_rows, name);
            for i in 0..arg_count {
                let mut kind: u8 = 9;
                if row != NONE && i < widen_u64(u32_at(in ctx.adt_kind_counts, widen_u64(row))) {
                    kind = u8_at(
                        in ctx.adt_kind_values,
                        wrapping_add(widen_u64(u32_at(in ctx.adt_kind_starts, widen_u64(row))), i)
                    );
                }
                let arg = list_at(in ast, args, i);
                if kind == KD_DIM {
                    dim_names(in state, inout ctx, in ast, arg);
                } else if kind == KD_DTYPE {
                    let generic = bare_generic(in state, in ctx, in ast, arg);
                    if generic != NONE {
                        use_kind(inout ctx, generic, KD_DTYPE);
                    }
                } else {
                    collect_kinds(in state, inout ctx, in ast, arg);
                }
            }
        }
    } else if node.kind == 2 {
        for i in 0..list_len(in ast, node.a) {
            collect_kinds(in state, inout ctx, in ast, list_at(in ast, node.a, i));
        }
    } else if node.kind == 3 {
        let param_count = list_len(in ast, node.a) >> 1;
        for i in 0..param_count {
            collect_kinds(
                in state,
                inout ctx,
                in ast,
                list_at(in ast, node.a, inc(wrapping_mul(i, 2)))
            );
        }
        collect_kinds(in state, inout ctx, in ast, node.b);
        collect_row_kinds(in state, inout ctx, in ast, node.c);
    } else if node.kind == 4 {
        collect_row_kinds(in state, inout ctx, in ast, node.a);
    }
}

pub fn collect_row_kinds(in state: St, inout ctx: Cx, in ast: Ast, row_id: u32) {
    if row_id == NONE {
        return;
    }
    let row = effectsn(in ast, row_id);
    for i in 0..list_len(in ast, row.instances) {
        let effect = effectn(in ast, list_at(in ast, row.instances, i));
        let is_kv = nm(in state, effect.name) == state.kv_pool_name;
        for j in 0..list_len(in ast, effect.args) {
            if is_kv {
                dim_names(in state, inout ctx, in ast, list_at(in ast, effect.args, j));
            } else {
                collect_kinds(in state, inout ctx, in ast, list_at(in ast, effect.args, j));
            }
        }
    }
}

// `resolve_kinds` of the generics `names` (in order) from `ctx.use_*`: the
// kinds, or NONE in the first slot's place with `err` set (the returned
// list is then empty).
pub fn resolve_kinds(
    inout state: St,
    in ctx: Cx,
    in names: ChunkSeq[u32],
    inout out: ChunkSeq[u8]
) -> bool {
    out.clear();
    for i in 0..names.len() {
        let generic = u32_at(in names, i);
        let mask = uses_of(in ctx, generic);
        if mask == 0 {
            out.push(KD_TYPE);
        } else if mask == 1 {
            out.push(KD_DIM);
        } else if mask == 2 {
            out.push(KD_DTYPE);
        } else if mask == 4 {
            out.push(KD_TYPE);
        } else {
            state.err.clear();
            put(inout state.err, in "generic '");
            state.names.write(generic, inout state.err);
            put(inout state.err, in "' is used both as a tensor dimension or dtype and as a type");
            out.clear();
            return false;
        }
    }
    true
}

// Sets the `AdtKinds` of `name`.
pub fn set_kinds(inout ctx: Cx, name: u32, in kinds: ChunkSeq[u8]) {
    let row = wrapping_u32(ctx.adt_kind_starts.len());
    ctx.adt_kind_starts.push(wrapping_u32(ctx.adt_kind_values.len()));
    ctx.adt_kind_counts.push(wrapping_u32(kinds.len()));
    ctx.adt_kind_values.extend(in kinds.as_slice());
    set32(inout ctx.adt_kind_rows, name, row);
}

fn kinds_equal(in ctx: Cx, row: u32, in kinds: ChunkSeq[u8]) -> bool {
    if row == NONE || widen_u64(u32_at(in ctx.adt_kind_counts, widen_u64(row))) != kinds.len() {
        return false;
    }
    for i in 0..kinds.len() {
        if u8_at(
            in ctx.adt_kind_values,
            wrapping_add(widen_u64(u32_at(in ctx.adt_kind_starts, widen_u64(row))), i)
        )
            != u8_at(in kinds, i) {
            return false;
        }
    }
    true
}

// `adt_kinds`: kinds of every ADT to a fixed point; the errors of the last
// round are pushed as E0761 diagnostics at the ADT.
pub fn adt_kinds(inout state: St, inout ctx: Cx, in ast: Ast) {
    let base = state.diag_codes.len();
    let rounds = inc(ast.m_items.len());
    let mut kinds = ChunkSeq::new[u8]();
    let mut names = ChunkSeq::new[u32]();
    for round in 0..rounds {
        let mut changed = false;
        diag_truncate_to(inout state, base);
        for i in 0..ast.m_items.len() {
            let item = item_at(in ast, i);
            if item.kind != 1 {
                continue;
            }
            let adt = adtn(in ast, item.node);
            names.clear();
            for generic_idx in 0..list_len(in ast, adt.generics) {
                names.push(
                    nm(in state, genericn(in ast, list_at(in ast, adt.generics, generic_idx)).name)
                );
            }
            ctx.generic_set.clear();
            ctx.generic_set.extend(in names.as_slice());
            uses_clear(inout ctx);
            for variant_idx in 0..list_len(in ast, adt.variants) {
                let variant = variantn(in ast, list_at(in ast, adt.variants, variant_idx));
                for field_idx in 0..list_len(in ast, variant.fields) {
                    collect_kinds(
                        in state,
                        inout ctx,
                        in ast,
                        fieldn(in ast, list_at(in ast, variant.fields, field_idx)).ty
                    );
                }
            }
            if !resolve_kinds(inout state, in ctx, in names, inout kinds) {
                let mut message = ChunkSeq::new[u8]();
                message.extend(in state.err.as_slice());
                push_diag(inout state, 761, widen_u64(adt.start), widen_u64(adt.end), in message);
                kinds.clear();
                for generic_idx in 0..names.len() {
                    kinds.push(KD_TYPE);
                }
            }
            let name = nm(in state, adt.name);
            if !kinds_equal(in ctx, at32(in ctx.adt_kind_rows, name), in kinds) {
                set_kinds(inout ctx, name, in kinds);
                changed = true;
            }
        }
        if !changed {
            break;
        }
    }
}

pub fn push_diag(inout state: St, code: u32, start: u64, end: u64, in message: ChunkSeq[u8]) {
    state.diag_codes.push(code);
    state.diag_starts.push(start);
    state.diag_ends.push(end);
    state.diag_msg_starts.push(state.diag_text.len());
    state.diag_text.extend(in message.as_slice());
    state.diag_msg_ends.push(state.diag_text.len());
}

pub fn diag_truncate_to(inout state: St, n: u64) {
    if n >= state.diag_codes.len() {
        return;
    }
    let text_len = match state.diag_msg_starts.try_get(n) {
        Option::Some(v) => v,
        Option::None => state.diag_text.len(),
    };
    state.diag_text.truncate(text_len);
    state.diag_codes.truncate(n);
    state.diag_starts.truncate(n);
    state.diag_ends.truncate(n);
    state.diag_msg_starts.truncate(n);
    state.diag_msg_ends.truncate(n);
}

// ----- Type Display and Debug (vesper_core::ast) -------------------------------------------

fn put_types(
    in state: St,
    in ast: Ast,
    inout out: ChunkSeq[u8],
    list: u32,
    step: u64,
    offset: u64,
    display: bool
) {
    let mut n = list_len(in ast, list);
    if step == 2 {
        n = n >> 1;
    }
    for i in 0..n {
        if i > 0 {
            put(inout out, in ", ");
        }
        let ty = list_at(in ast, list, wrapping_add(wrapping_mul(i, step), offset));
        if display {
            put_type(in state, in ast, inout out, ty);
        } else {
            debug_type(in state, in ast, inout out, ty);
        }
    }
}

// `impl Display for ast::Type`.
pub fn put_type(in state: St, in ast: Ast, inout out: ChunkSeq[u8], ty: u32) {
    let node = type_at(in ast, ty);
    if node.kind == 1 {
        let name = nm(in state, node.a);
        if name == state.dyn_name && list_len(in ast, node.b) == 1 {
            put(inout out, in "dyn ");
            put_type(in state, in ast, inout out, list_at(in ast, node.b, 0));
            return;
        }
        state.names.write(name, inout out);
        if list_len(in ast, node.b) > 0 {
            out.push(91);
            put_types(in state, in ast, inout out, node.b, 1, 0, true);
            out.push(93);
        }
    } else if node.kind == 2 {
        out.push(40);
        put_types(in state, in ast, inout out, node.a, 1, 0, true);
        out.push(41);
    } else if node.kind == 3 {
        put(inout out, in "fn(");
        put_types(in state, in ast, inout out, node.a, 2, 1, true);
        put(inout out, in ") -> ");
        put_type(in state, in ast, inout out, node.b);
    } else if node.kind == 4 {
        put(inout out, in "eff ");
        debug_row(in state, in ast, inout out, node.a);
    } else if node.kind == 6 {
        put(inout out, in "integer literal ");
        push_decimal(inout out, widen_u64(node.a));
    } else {
        out.push(95);
    }
}

fn debug_name(in state: St, inout out: ChunkSeq[u8], name: u32) {
    out.push(34);
    state.names.write(name, inout out);
    out.push(34);
}

fn debug_opt_name(in state: St, inout out: ChunkSeq[u8], name: u32) {
    if name == NONE {
        put(inout out, in "None");
    } else {
        put(inout out, in "Some(");
        debug_name(in state, inout out, name);
        out.push(41);
    }
}

pub fn debug_row(in state: St, in ast: Ast, inout out: ChunkSeq[u8], row_id: u32) {
    let row = effectsn(in ast, row_id);
    put(inout out, in "Effects { instances: [");
    for i in 0..list_len(in ast, row.instances) {
        if i > 0 {
            put(inout out, in ", ");
        }
        let effect = effectn(in ast, list_at(in ast, row.instances, i));
        put(inout out, in "Effect { label: ");
        debug_opt_name(in state, inout out, nm(in state, effect.label));
        put(inout out, in ", name: ");
        debug_name(in state, inout out, nm(in state, effect.name));
        put(inout out, in ", args: [");
        put_types(in state, in ast, inout out, effect.args, 1, 0, false);
        put(inout out, in "] }");
    }
    put(inout out, in "], tail: ");
    debug_opt_name(in state, inout out, nm(in state, row.tail));
    put(inout out, in " }");
}

pub fn debug_type(in state: St, in ast: Ast, inout out: ChunkSeq[u8], ty: u32) {
    let node = type_at(in ast, ty);
    if node.kind == 1 {
        put(inout out, in "Named(");
        debug_name(in state, inout out, nm(in state, node.a));
        put(inout out, in ", [");
        put_types(in state, in ast, inout out, node.b, 1, 0, false);
        put(inout out, in "])");
    } else if node.kind == 2 {
        put(inout out, in "Tuple([");
        put_types(in state, in ast, inout out, node.a, 1, 0, false);
        put(inout out, in "])");
    } else if node.kind == 3 {
        put(inout out, in "Function { params: [");
        let param_count = list_len(in ast, node.a) >> 1;
        for i in 0..param_count {
            if i > 0 {
                put(inout out, in ", ");
            }
            out.push(40);
            let pass = list_at(in ast, node.a, wrapping_mul(i, 2));
            if pass == 0 {
                put(inout out, in "In");
            } else if pass == 1 {
                put(inout out, in "Inout");
            } else {
                put(inout out, in "Sink");
            }
            put(inout out, in ", ");
            debug_type(
                in state,
                in ast,
                inout out,
                list_at(in ast, node.a, inc(wrapping_mul(i, 2)))
            );
            out.push(41);
        }
        put(inout out, in "], result: ");
        debug_type(in state, in ast, inout out, node.b);
        put(inout out, in ", effects: ");
        debug_row(in state, in ast, inout out, node.c);
        put(inout out, in ", mode: ");
        if node.d == 0 {
            put(inout out, in "Copy");
        } else if node.d == 1 {
            put(inout out, in "Affine");
        } else {
            put(inout out, in "Linear");
        }
        put(inout out, in " }");
    } else if node.kind == 4 {
        put(inout out, in "Row(");
        debug_row(in state, in ast, inout out, node.a);
        out.push(41);
    } else if node.kind == 6 {
        put(inout out, in "IntLiteral(");
        push_decimal(inout out, widen_u64(node.a));
        out.push(41);
    } else {
        put(inout out, in "Infer");
    }
}

// `types::display_type`.
pub fn display_type(in state: St, in ast: Ast, inout out: ChunkSeq[u8], ty: u32) {
    let node = type_at(in ast, ty);
    if node.kind == 1 {
        let name = nm(in state, node.a);
        let arg_count = list_len(in ast, node.b);
        if name == state.shape_name {
            out.push(91);
            for i in 0..arg_count {
                if i > 0 {
                    put(inout out, in ", ");
                }
                display_type(in state, in ast, inout out, list_at(in ast, node.b, i));
            }
            out.push(93);
            return;
        }
        if name == state.product_name && arg_count == 2 {
            display_type(in state, in ast, inout out, list_at(in ast, node.b, 0));
            put(inout out, in " * ");
            display_type(in state, in ast, inout out, list_at(in ast, node.b, 1));
            return;
        }
        if arg_count > 0 {
            state.names.write(name, inout out);
            out.push(91);
            for i in 0..arg_count {
                if i > 0 {
                    put(inout out, in ", ");
                }
                display_type(in state, in ast, inout out, list_at(in ast, node.b, i));
            }
            out.push(93);
            return;
        }
    }
    put_type(in state, in ast, inout out, ty);
}

// ----- Scope (types.rs) ----------------------------------------------------------------------

// The kind of generic `name` in the scope, or 9 when it is not a generic.
pub fn scope_kind(in ctx: Cx, name: u32) -> u8 {
    let mut i = ctx.scope_names.len();
    loop {
        if i == 0 {
            return 9;
        }
        i = wrapping_sub(i, 1);
        if u32_at(in ctx.scope_names, i) == name {
            return u8_at(in ctx.scope_kinds, i);
        }
    }
}

// `Scope::dim`: a dimension, or NONE with `err`.
pub fn scope_dim(inout state: St, in ctx: Cx, in ast: Ast, ty: u32) -> u32 {
    let node = type_at(in ast, ty);
    if node.kind == 1 {
        let name = nm(in state, node.a);
        let arg_count = list_len(in ast, node.b);
        if name == state.product_name && arg_count == 2 {
            let lhs = scope_dim(inout state, in ctx, in ast, list_at(in ast, node.b, 0));
            if lhs == NONE {
                return NONE;
            }
            let rhs = scope_dim(inout state, in ctx, in ast, list_at(in ast, node.b, 1));
            if rhs == NONE {
                return NONE;
            }
            let dim = dim_mul(inout state, lhs, rhs);
            if dim == NONE {
                return dim_fail(inout state);
            }
            return dim;
        }
        if arg_count == 0 && is_digits(in state, name) {
            let mut value: u64 = 0;
            for i in 0.. state.names.size(name) {
                let digit = widen_u64(state.names.byte(name, i));
                value = wrapping_add(wrapping_mul(value, 10), wrapping_sub(digit, 48));
                if value > MAX_DIM {
                    state.dim_error = 1;
                    return dim_fail(inout state);
                }
            }
            let dim = dim_const(inout state, value);
            if dim == NONE {
                return dim_fail(inout state);
            }
            return dim;
        }
        if arg_count == 0 {
            if scope_kind(in ctx, name) == KD_DIM {
                return dim_var(inout state, name);
            }
            state.err.clear();
            put(inout state.err, in "unknown dimension '");
            state.names.write(name, inout state.err);
            put(inout state.err, in "': declare it as a parameter `");
            state.names.write(name, inout state.err);
            put(inout state.err, in ": dim`");
            return NONE;
        }
    }
    let mut message = ChunkSeq::new[u8]();
    put(inout message, in "expected a dimension, found '");
    display_type(in state, in ast, inout message, ty);
    message.push(39);
    state.err = message;
    NONE
}

// `Scope::dtype`: a dtype word, or NONE with `err`.
pub fn scope_dtype(inout state: St, in ctx: Cx, in ast: Ast, ty: u32) -> u32 {
    let node = type_at(in ast, ty);
    if node.kind == 1 && list_len(in ast, node.b) == 0 {
        let name = nm(in state, node.a);
        if name == state.f32_name {
            return 0;
        }
        if name == state.bf16_name {
            return 1;
        }
        if scope_kind(in ctx, name) == KD_DTYPE {
            return wrapping_add(3, wrapping_mul(name, 2));
        }
        if (u8_at(in ctx.blocks, widen_u64(name)) == 1) {
            return wrapping_add(2, wrapping_mul(name, 2));
        }
    }
    let mut message = ChunkSeq::new[u8]();
    message.push(39);
    display_type(in state, in ast, inout message, ty);
    put(
        inout message,
        in "' is not a tensor dtype: use F32, Bf16, a quantized block wire struct or a dtype parameter"
    );
    state.err = message;
    NONE
}

// `Scope::shape`: the dims into `out`, or false with `err`.
pub fn scope_shape(
    inout state: St,
    in ctx: Cx,
    in ast: Ast,
    ty: u32,
    inout out: ChunkSeq[u32]
) -> bool {
    out.clear();
    let node = type_at(in ast, ty);
    if node.kind == 1 && nm(in state, node.a) == state.shape_name {
        let rank = list_len(in ast, node.b);
        if rank > 4 {
            state.err.clear();
            put(inout state.err, in "tensor rank ");
            push_decimal(inout state.err, rank);
            put(inout state.err, in " exceeds the supported rank 4");
            return false;
        }
        for i in 0..rank {
            let dim = scope_dim(inout state, in ctx, in ast, list_at(in ast, node.b, i));
            if dim == NONE {
                return false;
            }
            out.push(dim);
        }
        return true;
    }
    let mut message = ChunkSeq::new[u8]();
    put(inout message, in "expected a shape literal [d, ...], found '");
    display_type(in state, in ast, inout message, ty);
    message.push(39);
    state.err = message;
    false
}

fn err_named(inout state: St, in prefix: Str, name: u32, in suffix: Str) -> u32 {
    state.err.clear();
    put(inout state.err, in prefix);
    state.names.write(name, inout state.err);
    put(inout state.err, in suffix);
    NONE
}

// `Scope::ty`: a type, or NONE with `err`.
pub fn scope_ty(inout state: St, in ctx: Cx, in ast: Ast, ty: u32) -> u32 {
    let node = type_at(in ast, ty);
    if node.kind == 1 {
        let name = nm(in state, node.a);
        let args = node.b;
        let arg_count = list_len(in ast, args);
        if name == state.tensor_name {
            if arg_count != 2 {
                return fail(inout state, in "a tensor type is written Tensor[DType, [d, ...]]");
            }
            let tensor_dtype = scope_dtype(inout state, in ctx, in ast, list_at(in ast, args, 0));
            if tensor_dtype == NONE {
                return NONE;
            }
            let mut shape = ChunkSeq::new[u32]();
            if !scope_shape(inout state, in ctx, in ast, list_at(in ast, args, 1), inout shape) {
                return NONE;
            }
            return mk_ty(inout state, T_TENSOR, tensor_dtype, 0, in shape);
        }
        if name == state.lease_name || name == state.seq_name {
            if arg_count != 2 {
                state.err.clear();
                state.names.write(name, inout state.err);
                put(inout state.err, in " takes two dimensions: ");
                state.names.write(name, inout state.err);
                put(inout state.err, in "[KvHeads, HeadDim]");
                return NONE;
            }
            let kv_heads = scope_dim(inout state, in ctx, in ast, list_at(in ast, args, 0));
            if kv_heads == NONE {
                return NONE;
            }
            let head_dim = scope_dim(inout state, in ctx, in ast, list_at(in ast, args, 1));
            if head_dim == NONE {
                return NONE;
            }
            if name == state.lease_name {
                return ty_pair(inout state, T_LEASE, kv_heads, head_dim);
            }
            return ty_pair(inout state, T_SEQ, kv_heads, head_dim);
        }
        if name == state.shape_name {
            return fail(
                inout state,
                in "a shape literal is only valid as a tensor's second argument"
            );
        }
        if arg_count == 0 {
            let kind = scope_kind(in ctx, name);
            if kind == KD_TYPE {
                return ty_named(inout state, T_VAR, name);
            }
            if kind == KD_DTYPE {
                return err_named(
                    inout state,
                    in "dtype parameter '",
                    name,
                    in "' is used as a type"
                );
            }
            if kind == KD_DIM {
                return err_named(inout state, in "dimension '", name, in "' is used as a type");
            }
            if is_digits(in state, name) {
                return err_named(inout state, in "'", name, in "' is a dimension, not a type");
            }
        }
        let row = at32(in ctx.adt_kind_rows, name);
        if row != NONE || name == state.option_name || name == state.result_name {
            let mut kind_count = arg_count;
            if row != NONE {
                kind_count = widen_u64(u32_at(in ctx.adt_kind_counts, widen_u64(row)));
            }
            if kind_count != arg_count {
                return state.unknown;
            }
            let mut items = ChunkSeq::new[u32]();
            for i in 0..arg_count {
                let mut kind = KD_TYPE;
                if row != NONE {
                    kind = u8_at(
                        in ctx.adt_kind_values,
                        wrapping_add(widen_u64(u32_at(in ctx.adt_kind_starts, widen_u64(row))), i)
                    );
                }
                let arg = list_at(in ast, args, i);
                if kind == KD_DIM {
                    let dim = scope_dim(inout state, in ctx, in ast, arg);
                    if dim == NONE {
                        return NONE;
                    }
                    items.push(1);
                    items.push(dim);
                } else if kind == KD_DTYPE {
                    let dtype = scope_dtype(inout state, in ctx, in ast, arg);
                    if dtype == NONE {
                        return NONE;
                    }
                    items.push(2);
                    items.push(dtype);
                } else {
                    let arg_ty = scope_ty(inout state, in ctx, in ast, arg);
                    if arg_ty == NONE {
                        return NONE;
                    }
                    items.push(0);
                    items.push(arg_ty);
                }
            }
            return mk_ty(inout state, T_ADT, name, 0, in items);
        }
        if is_wire_integer(in state, name)
            || name == state.byte_array_name
            || name == state.zero_pad_name {
            return err_named(
                inout state,
                in "'",
                name,
                in "' is only valid as a wire struct field type"
            );
        }
        for i in 0..arg_count {
            let arg_ty = scope_ty(inout state, in ctx, in ast, list_at(in ast, args, i));
            if arg_ty == NONE {
                return NONE;
            }
            if has_tensor(in state, arg_ty) {
                return err_named(
                    inout state,
                    in "a tensor type cannot instantiate the parameters of '",
                    name,
                    in "'"
                );
            }
        }
        return ty_named(inout state, T_BASE, name);
    }
    if node.kind == 2 {
        let mut items = ChunkSeq::new[u32]();
        for i in 0..list_len(in ast, node.a) {
            let elem_ty = scope_ty(inout state, in ctx, in ast, list_at(in ast, node.a, i));
            if elem_ty == NONE {
                return NONE;
            }
            items.push(elem_ty);
        }
        return mk_ty(inout state, T_TUPLE, 0, 0, in items);
    }
    if node.kind == 3 {
        let mut items = ChunkSeq::new[u32]();
        let param_count = list_len(in ast, node.a) >> 1;
        for i in 0..param_count {
            let param_ty = scope_ty(
                inout state,
                in ctx,
                in ast,
                list_at(in ast, node.a, inc(wrapping_mul(i, 2)))
            );
            if param_ty == NONE {
                return NONE;
            }
            items.push(param_ty);
        }
        let result_ty = scope_ty(inout state, in ctx, in ast, node.b);
        if result_ty == NONE {
            return NONE;
        }
        return mk_ty(inout state, T_FN, 0, result_ty, in items);
    }
    state.unknown
}
