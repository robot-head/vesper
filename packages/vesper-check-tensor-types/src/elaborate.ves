// Lowering a checked tensor module to core syntax (src/tensor_types/elaborate.rs)
// for `@vesper/check-tensor-types` (SH2 lane 14 part 2, #1186).

use @vesper/ast::{
    Ast, ExprNode, TypeNode, StmtNode, ArgNode, ClauseNode, ParamNode, EffectsNode, EffectNode,
    GenericNode, FieldNode, VariantNode, AdtNode, FnNode, ItemNode, lit_at, list_len, list_at,
    expr_at, type_at
};
use @vesper/check-data::util::{push_decimal, add, inc, u32_at, u64_at, u8_at, w};
use self::state::{St, dim_exp_at, dim_node, dim_var_at, put, put_dim, spells};
use self::kinds::{
    Cx, at32, nm, paramn, fnn, adtn, variantn, fieldn, genericn, effectsn, effectn, stmtn, argn,
    clausen, effdecln, impln, traitn, confn, item_at, is_wire_integer, elab_find
};

const NONE: u32 = 4294967295;
const NONE64: u64 = 4294967295;
const KD_DIM: u8 = 0;
const KD_TYPE: u8 = 2;

struct ElabOut {
    next: u64,
    syn_starts: ChunkSeq[u64],
    orig_starts: ChunkSeq[u64],
    orig_ends: ChunkSeq[u64],
    out: ChunkSeq[u8]
}

fn elab_out_new(base: u64) -> ElabOut {
    ElabOut {
        next: base,
        syn_starts: ChunkSeq::new[u64](),
        orig_starts: ChunkSeq::new[u64](),
        orig_ends: ChunkSeq::new[u64](),
        out: ChunkSeq::new[u8]()
    }
}

fn alloc_span(inout elab: ElabOut, orig_start: u64, orig_end: u64) -> u64 {
    let syn_start = elab.next;
    elab.next = add(syn_start, 2);
    elab.syn_starts.push(syn_start);
    elab.orig_starts.push(orig_start);
    elab.orig_ends.push(orig_end);
    syn_start
}

fn is_erased_adt_kind(in ctx: Cx, name_sym: u32, idx: u64) -> bool {
    let row = at32(in ctx.adt_kind_rows, name_sym);
    if row == NONE {
        return false;
    }
    let kinds_start = w(u32_at(in ctx.adt_kind_starts, w(row)));
    let kind_count = w(u32_at(in ctx.adt_kind_counts, w(row)));
    if idx < kind_count {
        return u8_at(in ctx.adt_kind_values, add(kinds_start, idx)) != KD_TYPE;
    }
    false
}

fn put_raw_ty(in state: St, in ast: Ast, ty: u32, inout out: ChunkSeq[u8]) {
    let node = type_at(in ast, ty);
    if node.kind == 1 {
        let name = nm(in state, node.a);
        state.names.write(name, inout out);
        let arg_count = list_len(in ast, node.b);
        if arg_count > 0 {
            out.push(91);
            for i in 0..arg_count {
                if i > 0 {
                    put(inout out, in ", ");
                }
                put_raw_ty(in state, in ast, list_at(in ast, node.b, i), inout out);
            }
            out.push(93);
        }
    } else if node.kind == 2 {
        out.push(40);
        let elem_count = list_len(in ast, node.a);
        for i in 0..elem_count {
            if i > 0 {
                put(inout out, in ", ");
            }
            put_raw_ty(in state, in ast, list_at(in ast, node.a, i), inout out);
        }
        out.push(41);
    } else if node.kind == 5 {
        out.push(91);
        out.push(93);
        out.push(91);
        let elem_count = list_len(in ast, node.a);
        for i in 0..elem_count {
            if i > 0 {
                put(inout out, in ", ");
            }
            put_raw_ty(in state, in ast, list_at(in ast, node.a, i), inout out);
        }
        out.push(93);
    } else {
        put(inout out, in "_");
    }
}

fn put_erased_ty(in state: St, in ctx: Cx, in ast: Ast, ty: u32, inout out: ChunkSeq[u8]) {
    let node = type_at(in ast, ty);
    if node.kind == 1 {
        let name = nm(in state, node.a);
        let arg_count = list_len(in ast, node.b);
        if spells(in state, name, in "Tensor")
            || spells(in state, name, in "KvPageLease")
            || spells(in state, name, in "ActiveKvSeq")
        {
            state.names.write(name, inout out);
            return;
        }
        if arg_count == 0 && is_wire_integer(in state, name) {
            put(inout out, in "u64");
            return;
        }
        if spells(in state, name, in "ByteArray") || spells(in state, name, in "ZeroPad") {
            put(inout out, in "()");
            return;
        }
        state.names.write(name, inout out);
        let mut first = true;
        for i in 0..arg_count {
            if is_erased_adt_kind(in ctx, name, i) {
                continue;
            }
            if first {
                out.push(91);
                first = false;
            } else {
                put(inout out, in ", ");
            }
            put_erased_ty(in state, in ctx, in ast, list_at(in ast, node.b, i), inout out);
        }
        if !first {
            out.push(93);
        }
    } else if node.kind == 2 {
        out.push(40);
        let elem_count = list_len(in ast, node.a);
        for i in 0..elem_count {
            if i > 0 {
                put(inout out, in ", ");
            }
            put_erased_ty(in state, in ctx, in ast, list_at(in ast, node.a, i), inout out);
        }
        out.push(41);
    } else if node.kind == 3 {
        put(inout out, in "fn(");
        let param_count = list_len(in ast, node.a) >> 1;
        for i in 0..param_count {
            if i > 0 {
                put(inout out, in ", ");
            }
            put_erased_ty(
                in state,
                in ctx,
                in ast,
                list_at(in ast, node.a, inc(wrapping_mul(i, 2))),
                inout out
            );
        }
        put(inout out, in ") -> ");
        put_erased_ty(in state, in ctx, in ast, node.b, inout out);
        if node.c != NONE {
            let row = effectsn(in ast, node.c);
            if list_len(in ast, row.instances) > 0 || row.tail != NONE {
                put(inout out, in " with ");
                put_erased_row(in state, in ctx, in ast, node.c, inout out);
            }
        }
    } else if node.kind == 4 {
        put_erased_row(in state, in ctx, in ast, node.a, inout out);
    } else {
        put(inout out, in "_");
    }
}

fn put_erased_effect(
    in state: St,
    in ctx: Cx,
    in ast: Ast,
    effect_id: u32,
    inout out: ChunkSeq[u8]
) {
    let effect = effectn(in ast, effect_id);
    let effect_name = nm(in state, effect.name);
    if effect.label != NONE {
        state.names.write(nm(in state, effect.label), inout out);
        put(inout out, in ": ");
    }
    state.names.write(effect_name, inout out);
    if !spells(in state, effect_name, in "KvCachePool") {
        let arg_count = list_len(in ast, effect.args);
        if arg_count > 0 {
            out.push(91);
            for j in 0..arg_count {
                if j > 0 {
                    put(inout out, in ", ");
                }
                put_erased_ty(in state, in ctx, in ast, list_at(in ast, effect.args, j), inout out);
            }
            out.push(93);
        }
    }
}

fn put_erased_row(in state: St, in ctx: Cx, in ast: Ast, row_id: u32, inout out: ChunkSeq[u8]) {
    if row_id == NONE {
        return;
    }
    let row = effectsn(in ast, row_id);
    let instance_count = list_len(in ast, row.instances);
    let mut first = true;
    for i in 0..instance_count {
        if !first {
            put(inout out, in ", ");
        }
        first = false;
        put_erased_effect(in state, in ctx, in ast, list_at(in ast, row.instances, i), inout out);
    }
    if row.tail != NONE {
        if !first {
            put(inout out, in ", ");
        }
        put(inout out, in "..");
        state.names.write(nm(in state, row.tail), inout out);
    }
}

fn max_end(in ast: Ast) -> u64 {
    let mut latest_end: u64 = 0;
    for i in 0..ast.m_items.len() {
        let item = item_at(in ast, i);
        let mut end: u64 = 0;
        if item.kind == 1 {
            end = widen_u64(adtn(in ast, item.node).end);
        } else if item.kind == 2 {
            end = widen_u64(fnn(in ast, item.node).end);
        } else if item.kind == 3 {
            end = widen_u64(effdecln(in ast, item.node).end);
        } else if item.kind == 4 {
            let impl_node = impln(in ast, item.node);
            for j in 0..list_len(in ast, impl_node.methods) {
                let method_end = widen_u64(fnn(in ast, list_at(in ast, impl_node.methods, j)).end);
                if method_end > end {
                    end = method_end;
                }
            }
        } else if item.kind == 5 {
            end = widen_u64(traitn(in ast, item.node).end);
        } else if item.kind == 6 {
            end = widen_u64(confn(in ast, item.node).end);
        }
        if end > latest_end {
            latest_end = end;
        }
    }
    latest_end
}

fn emit_dim_expr_str(
    in state: St,
    dim: u32,
    orig_start: u64,
    orig_end: u64,
    inout elab: ElabOut
) -> ChunkSeq[u8] {
    let node = dim_node(in state, dim);
    let coeff = node.coeff;
    let var_count = widen_u64(node.factor_count);
    let mut product = ChunkSeq::new[u8]();
    let mut has_factor = false;
    if coeff != 1 || var_count == 0 {
        let span = alloc_span(inout elab, orig_start, orig_end);
        put(inout product, in "lit(");
        push_decimal(inout product, coeff);
        put(inout product, in ")@");
        push_decimal(inout product, span);
        put(inout product, in "..");
        push_decimal(inout product, inc(span));
        has_factor = true;
    }
    for i in 0..var_count {
        let var = dim_var_at(in state, dim, i);
        let exp = widen_u64(dim_exp_at(in state, dim, i));
        for _ in 0..exp {
            let span = alloc_span(inout elab, orig_start, orig_end);
            let mut factor = ChunkSeq::new[u8]();
            put(inout factor, in "name($dim_");
            state.names.write(var, inout factor);
            put(inout factor, in ")@");
            push_decimal(inout factor, span);
            put(inout factor, in "..");
            push_decimal(inout factor, inc(span));
            if !has_factor {
                product = factor;
                has_factor = true;
            } else {
                let callee_span = alloc_span(inout elab, orig_start, orig_end);
                let call_span = alloc_span(inout elab, orig_start, orig_end);
                let mut next_product = ChunkSeq::new[u8]();
                put(inout next_product, in "call(wrapping_mul@");
                push_decimal(inout next_product, callee_span);
                put(inout next_product, in "..");
                push_decimal(inout next_product, inc(callee_span));
                put(inout next_product, in ", ");
                next_product.extend(in product.as_slice());
                put(inout next_product, in ", ");
                next_product.extend(in factor.as_slice());
                put(inout next_product, in ")@");
                push_decimal(inout next_product, call_span);
                put(inout next_product, in "..");
                push_decimal(inout next_product, inc(call_span));
                product = next_product;
            }
        }
    }
    product
}

fn emit_dims_value(
    in state: St,
    in ctx: Cx,
    dims_start: u64,
    dims_len: u64,
    orig_start: u64,
    orig_end: u64,
    inout elab: ElabOut
) -> ChunkSeq[u8] {
    let mut out = ChunkSeq::new[u8]();
    let rank_span = alloc_span(inout elab, orig_start, orig_end);
    put(inout out, in "struct(Dims, rank: lit(");
    push_decimal(inout out, dims_len);
    put(inout out, in ")@");
    push_decimal(inout out, rank_span);
    put(inout out, in "..");
    push_decimal(inout out, inc(rank_span));
    for i in 0..4 {
        put(inout out, in ", d");
        push_decimal(inout out, i);
        put(inout out, in ": ");
        if i < dims_len {
            let dim = u32_at(in ctx.elab_dims, add(dims_start, i));
            let dim_text = emit_dim_expr_str(in state, dim, orig_start, orig_end, inout elab);
            out.extend(in dim_text.as_slice());
        } else {
            let span = alloc_span(inout elab, orig_start, orig_end);
            put(inout out, in "lit(1)@");
            push_decimal(inout out, span);
            put(inout out, in "..");
            push_decimal(inout out, inc(span));
        }
    }
    let struct_span = alloc_span(inout elab, orig_start, orig_end);
    put(inout out, in ")@");
    push_decimal(inout out, struct_span);
    put(inout out, in "..");
    push_decimal(inout out, inc(struct_span));
    out
}

fn emit_expr(in state: St, in ctx: Cx, in ast: Ast, expr_id: u32, inout elab: ElabOut) {
    let node = expr_at(in ast, expr_id);
    let kind = node.kind;
    let expr_start = widen_u64(node.start);
    let expr_end = widen_u64(node.end);
    if kind == 1 || kind == 2 {
        put(inout elab.out, in "E");
        push_decimal(inout elab.out, widen_u64(kind));
        put(inout elab.out, in "@");
        push_decimal(inout elab.out, expr_start);
        put(inout elab.out, in "..");
        push_decimal(inout elab.out, expr_end);
        return;
    }
    if kind == 3 {
        put(inout elab.out, in "(");
        let elem_count = list_len(in ast, node.a);
        for i in 0..elem_count {
            if i > 0 {
                put(inout elab.out, in ", ");
            }
            emit_expr(in state, in ctx, in ast, list_at(in ast, node.a, i), inout elab);
        }
        put(inout elab.out, in ")@");
        push_decimal(inout elab.out, expr_start);
        put(inout elab.out, in "..");
        push_decimal(inout elab.out, expr_end);
        return;
    }
    if kind == 4 {
        state.names.write(nm(in state, node.a), inout elab.out);
        put(inout elab.out, in "{");
        let field_count = list_len(in ast, node.b) >> 1;
        for i in 0..field_count {
            if i > 0 {
                put(inout elab.out, in ", ");
            }
            state
                .names
                .write(nm(in state, list_at(in ast, node.b, wrapping_mul(i, 2))), inout elab.out);
            put(inout elab.out, in ": ");
            emit_expr(
                in state,
                in ctx,
                in ast,
                list_at(in ast, node.b, inc(wrapping_mul(i, 2))),
                inout elab
            );
        }
        put(inout elab.out, in "}@");
        push_decimal(inout elab.out, expr_start);
        put(inout elab.out, in "..");
        push_decimal(inout elab.out, expr_end);
        return;
    }
    if kind == 5 {
        put(inout elab.out, in "{");
        for i in 0..list_len(in ast, node.a) {
            if i > 0 {
                put(inout elab.out, in "; ");
            }
            let stmt = stmtn(in ast, list_at(in ast, node.a, i));
            if stmt.kind == 1 {
                put(inout elab.out, in "let:");
                put_erased_ty(in state, in ctx, in ast, stmt.ty, inout elab.out);
                put(inout elab.out, in "=");
            }
            emit_expr(in state, in ctx, in ast, stmt.value, inout elab);
        }
        if node.b != NONE {
            put(inout elab.out, in "; ");
            emit_expr(in state, in ctx, in ast, node.b, inout elab);
        }
        put(inout elab.out, in "}@");
        push_decimal(inout elab.out, expr_start);
        put(inout elab.out, in "..");
        push_decimal(inout elab.out, expr_end);
        return;
    }
    if kind == 6 {
        let elab_idx = elab_find(in ctx, expr_start, expr_end);
        let elab_kind = if elab_idx == NONE64 {
            0
        } else {
            u8_at(in ctx.elab_kinds, elab_idx)
        };
        put(inout elab.out, in "call(");
        emit_expr(in state, in ctx, in ast, node.a, inout elab);
        let type_arg_count = list_len(in ast, node.b);
        if elab_kind == 1 {
            let callee = expr_at(in ast, node.a);
            let mut filtered = false;
            if callee.kind == 2 {
                let row = at32(in ctx.sig_rows, nm(in state, callee.a));
                if row != NONE {
                    let generic_count = w(u32_at(in ctx.sig_generic_counts, w(row)));
                    if type_arg_count == generic_count {
                        let generics_start = w(u32_at(in ctx.sig_generic_starts, w(row)));
                        let mut type_args_text = ChunkSeq::new[u8]();
                        let mut first = true;
                        for i in 0..type_arg_count {
                            if u8_at(in ctx.sig_generic_kinds, add(generics_start, i)) == KD_TYPE {
                                if !first {
                                    put(inout type_args_text, in ", ");
                                }
                                first = false;
                                put_erased_ty(
                                    in state,
                                    in ctx,
                                    in ast,
                                    list_at(in ast, node.b, i),
                                    inout type_args_text
                                );
                            }
                        }
                        if !first {
                            elab.out.push(91);
                            elab.out.extend(in type_args_text.as_slice());
                            elab.out.push(93);
                        }
                        filtered = true;
                    }
                }
            }
            if !filtered && type_arg_count > 0 {
                put(inout elab.out, in "[");
                for i in 0..type_arg_count {
                    if i > 0 {
                        put(inout elab.out, in ", ");
                    }
                    put_erased_ty(
                        in state,
                        in ctx,
                        in ast,
                        list_at(in ast, node.b, i),
                        inout elab.out
                    );
                }
                put(inout elab.out, in "]");
            }
            let dims_start = w(u32_at(in ctx.elab_dims_starts, elab_idx));
            let dims_len = w(u32_at(in ctx.elab_dims_lens, elab_idx));
            for i in 0..dims_len {
                put(inout elab.out, in ", ");
                let dim_text = emit_dim_expr_str(
                    in state,
                    u32_at(in ctx.elab_dims, add(dims_start, i)),
                    expr_start,
                    expr_end,
                    inout elab
                );
                elab.out.extend(in dim_text.as_slice());
            }
            for i in 0..list_len(in ast, node.c) {
                put(inout elab.out, in ", ");
                emit_expr(
                    in state,
                    in ctx,
                    in ast,
                    argn(in ast, list_at(in ast, node.c, i)).expr,
                    inout elab
                );
            }
        } else if elab_kind == 2 {
            for i in 0..list_len(in ast, node.c) {
                put(inout elab.out, in ", ");
                emit_expr(
                    in state,
                    in ctx,
                    in ast,
                    argn(in ast, list_at(in ast, node.c, i)).expr,
                    inout elab
                );
            }
            let dims_start = w(u32_at(in ctx.elab_dims_starts, elab_idx));
            let dims_len = w(u32_at(in ctx.elab_dims_lens, elab_idx));
            put(inout elab.out, in ", ");
            let dims_value = emit_dims_value(
                in state,
                in ctx,
                dims_start,
                dims_len,
                expr_start,
                expr_end,
                inout elab
            );
            elab.out.extend(in dims_value.as_slice());
        } else {
            if type_arg_count > 0 {
                put(inout elab.out, in "[");
                for i in 0..type_arg_count {
                    if i > 0 {
                        put(inout elab.out, in ", ");
                    }
                    put_erased_ty(
                        in state,
                        in ctx,
                        in ast,
                        list_at(in ast, node.b, i),
                        inout elab.out
                    );
                }
                put(inout elab.out, in "]");
            }
            for i in 0..list_len(in ast, node.c) {
                put(inout elab.out, in ", ");
                emit_expr(
                    in state,
                    in ctx,
                    in ast,
                    argn(in ast, list_at(in ast, node.c, i)).expr,
                    inout elab
                );
            }
        }
        put(inout elab.out, in ")@");
        push_decimal(inout elab.out, expr_start);
        put(inout elab.out, in "..");
        push_decimal(inout elab.out, expr_end);
        return;
    }
    if kind == 7 || kind == 9 || kind == 17 {
        put(inout elab.out, in "U");
        push_decimal(inout elab.out, widen_u64(kind));
        put(inout elab.out, in "(");
        emit_expr(in state, in ctx, in ast, node.a, inout elab);
        put(inout elab.out, in ")@");
        push_decimal(inout elab.out, expr_start);
        put(inout elab.out, in "..");
        push_decimal(inout elab.out, expr_end);
        return;
    }
    if kind == 10 {
        put(inout elab.out, in "Un(");
        emit_expr(in state, in ctx, in ast, node.b, inout elab);
        put(inout elab.out, in ")@");
        push_decimal(inout elab.out, expr_start);
        put(inout elab.out, in "..");
        push_decimal(inout elab.out, expr_end);
        return;
    }
    if kind == 8 || kind == 19 {
        put(inout elab.out, in "B");
        push_decimal(inout elab.out, widen_u64(kind));
        put(inout elab.out, in "(");
        emit_expr(in state, in ctx, in ast, node.a, inout elab);
        put(inout elab.out, in ", ");
        emit_expr(in state, in ctx, in ast, node.b, inout elab);
        put(inout elab.out, in ")@");
        push_decimal(inout elab.out, expr_start);
        put(inout elab.out, in "..");
        push_decimal(inout elab.out, expr_end);
        return;
    }
    if kind == 11 || kind == 12 {
        put(inout elab.out, in "Op");
        push_decimal(inout elab.out, widen_u64(kind));
        put(inout elab.out, in "(");
        emit_expr(in state, in ctx, in ast, node.b, inout elab);
        put(inout elab.out, in ", ");
        emit_expr(in state, in ctx, in ast, node.c, inout elab);
        put(inout elab.out, in ")@");
        push_decimal(inout elab.out, expr_start);
        put(inout elab.out, in "..");
        push_decimal(inout elab.out, expr_end);
        return;
    }
    if kind == 13 {
        put(inout elab.out, in "if(");
        emit_expr(in state, in ctx, in ast, node.a, inout elab);
        put(inout elab.out, in ", ");
        emit_expr(in state, in ctx, in ast, node.b, inout elab);
        if node.c != NONE {
            put(inout elab.out, in ", ");
            emit_expr(in state, in ctx, in ast, node.c, inout elab);
        }
        put(inout elab.out, in ")@");
        push_decimal(inout elab.out, expr_start);
        put(inout elab.out, in "..");
        push_decimal(inout elab.out, expr_end);
        return;
    }
    if kind == 14 {
        put(inout elab.out, in "match(");
        emit_expr(in state, in ctx, in ast, node.a, inout elab);
        let arm_count = list_len(in ast, node.b) >> 1;
        for i in 0..arm_count {
            put(inout elab.out, in ", ");
            emit_expr(
                in state,
                in ctx,
                in ast,
                list_at(in ast, node.b, inc(wrapping_mul(i, 2))),
                inout elab
            );
        }
        put(inout elab.out, in ")@");
        push_decimal(inout elab.out, expr_start);
        put(inout elab.out, in "..");
        push_decimal(inout elab.out, expr_end);
        return;
    }
    if kind == 18 {
        put(inout elab.out, in "for(");
        emit_expr(in state, in ctx, in ast, node.b, inout elab);
        put(inout elab.out, in ", ");
        emit_expr(in state, in ctx, in ast, node.c, inout elab);
        put(inout elab.out, in ")@");
        push_decimal(inout elab.out, expr_start);
        put(inout elab.out, in "..");
        push_decimal(inout elab.out, expr_end);
        return;
    }
    if kind == 20 || kind == 21 {
        put(inout elab.out, in "J");
        push_decimal(inout elab.out, widen_u64(kind));
        put(inout elab.out, in "(");
        if node.a != NONE {
            emit_expr(in state, in ctx, in ast, node.a, inout elab);
        }
        put(inout elab.out, in ")@");
        push_decimal(inout elab.out, expr_start);
        put(inout elab.out, in "..");
        push_decimal(inout elab.out, expr_end);
        return;
    }
    if kind == 15 {
        put(inout elab.out, in "fn(");
        for i in 0..list_len(in ast, node.a) {
            if i > 0 {
                put(inout elab.out, in ", ");
            }
            put_erased_ty(
                in state,
                in ctx,
                in ast,
                paramn(in ast, list_at(in ast, node.a, i)).ty,
                inout elab.out
            );
        }
        put(inout elab.out, in ")->");
        put_erased_ty(in state, in ctx, in ast, node.c, inout elab.out);
        if node.d != NONE {
            let row = effectsn(in ast, node.d);
            if list_len(in ast, row.instances) > 0 || row.tail != NONE {
                put(inout elab.out, in " with ");
                put_erased_row(in state, in ctx, in ast, node.d, inout elab.out);
            }
        }
        put(inout elab.out, in "{");
        emit_expr(in state, in ctx, in ast, node.e, inout elab);
        put(inout elab.out, in "}@");
        push_decimal(inout elab.out, expr_start);
        put(inout elab.out, in "..");
        push_decimal(inout elab.out, expr_end);
        return;
    }
    if kind == 16 {
        put(inout elab.out, in "handle(");
        put_erased_effect(in state, in ctx, in ast, node.a, inout elab.out);
        if node.b != NONE {
            put(inout elab.out, in ", ");
            emit_expr(in state, in ctx, in ast, node.c, inout elab);
        }
        put(inout elab.out, in ", ");
        emit_expr(in state, in ctx, in ast, node.d, inout elab);
        for i in 0..list_len(in ast, node.e) {
            put(inout elab.out, in ", ");
            emit_expr(
                in state,
                in ctx,
                in ast,
                clausen(in ast, list_at(in ast, node.e, i)).body,
                inout elab
            );
        }
        put(inout elab.out, in ")@");
        push_decimal(inout elab.out, expr_start);
        put(inout elab.out, in "..");
        push_decimal(inout elab.out, expr_end);
        return;
    }
    put(inout elab.out, in "C@");
    push_decimal(inout elab.out, expr_start);
    put(inout elab.out, in "..");
    push_decimal(inout elab.out, expr_end);
}

pub fn elaborate_report(in state: St, in ctx: Cx, in ast: Ast) -> ChunkSeq[u8] {
    let base = add(max_end(in ast), 1048576);
    let mut elab = elab_out_new(base);
    put(inout elab.out, in "base ");
    push_decimal(inout elab.out, base);
    elab.out.push(10);
    for i in 0..ast.m_items.len() {
        let item = item_at(in ast, i);
        if item.kind == 1 {
            let adt = adtn(in ast, item.node);
            let adt_name = nm(in state, adt.name);
            put(inout elab.out, in "ADT ");
            state.names.write(adt_name, inout elab.out);
            let adt_generic_count = list_len(in ast, adt.generics);
            for j in 0..adt_generic_count {
                if !is_erased_adt_kind(in ctx, adt_name, j) {
                    put(inout elab.out, in " ");
                    let generic = genericn(in ast, list_at(in ast, adt.generics, j));
                    state.names.write(nm(in state, generic.name), inout elab.out);
                }
            }
            elab.out.push(10);
            for variant_idx in 0..list_len(in ast, adt.variants) {
                let variant = variantn(in ast, list_at(in ast, adt.variants, variant_idx));
                put(inout elab.out, in " V ");
                state.names.write(nm(in state, variant.name), inout elab.out);
                for field_idx in 0..list_len(in ast, variant.fields) {
                    let field = fieldn(in ast, list_at(in ast, variant.fields, field_idx));
                    put(inout elab.out, in " ");
                    put_erased_ty(in state, in ctx, in ast, field.ty, inout elab.out);
                }
                elab.out.push(10);
            }
        } else if item.kind == 2 {
            let func = fnn(in ast, item.node);
            let fn_name = nm(in state, func.name);
            put(inout elab.out, in "FN ");
            state.names.write(fn_name, inout elab.out);
            elab.out.push(10);
            let row = at32(in ctx.sig_rows, fn_name);
            if row == NONE {
                for generic_idx in 0..list_len(in ast, func.generics) {
                    let generic = genericn(in ast, list_at(in ast, func.generics, generic_idx));
                    put(inout elab.out, in " G ");
                    state.names.write(nm(in state, generic.name), inout elab.out);
                    elab.out.push(10);
                }
                for param_idx in 0..list_len(in ast, func.params) {
                    let param = paramn(in ast, list_at(in ast, func.params, param_idx));
                    put(inout elab.out, in " P ");
                    state.names.write(nm(in state, param.name), inout elab.out);
                    put(inout elab.out, in ":");
                    put_raw_ty(in state, in ast, param.ty, inout elab.out);
                    put(inout elab.out, in "@");
                    push_decimal(inout elab.out, widen_u64(param.start));
                    put(inout elab.out, in "..");
                    push_decimal(inout elab.out, widen_u64(param.end));
                    elab.out.push(10);
                }
                put(inout elab.out, in " R ");
                put_raw_ty(in state, in ast, func.result, inout elab.out);
                elab.out.push(10);
                if func.body != NONE {
                    put(inout elab.out, in " B ");
                    emit_expr(in state, in ctx, in ast, func.body, inout elab);
                    elab.out.push(10);
                }
                continue;
            }
            let sig_generics_start = w(u32_at(in ctx.sig_generic_starts, w(row)));
            let sig_generic_count = w(u32_at(in ctx.sig_generic_counts, w(row)));
            for generic_idx in 0..list_len(in ast, func.generics) {
                let generic = genericn(in ast, list_at(in ast, func.generics, generic_idx));
                let generic_name = nm(in state, generic.name);
                let mut keep = generic.row;
                if !keep {
                    let mut generic_kind = KD_TYPE;
                    for k in 0..sig_generic_count {
                        if u32_at(in ctx.sig_generic_names, add(sig_generics_start, k))
                            == generic_name
                        {
                            generic_kind = u8_at(
                                in ctx.sig_generic_kinds,
                                add(sig_generics_start, k)
                            );
                            break;
                        }
                    }
                    keep = generic_kind == KD_TYPE;
                }
                if keep {
                    put(inout elab.out, in " G ");
                    state.names.write(generic_name, inout elab.out);
                    elab.out.push(10);
                }
            }
            for k in 0..sig_generic_count {
                if u8_at(in ctx.sig_generic_kinds, add(sig_generics_start, k)) == KD_DIM {
                    let span = alloc_span(inout elab, widen_u64(func.start), widen_u64(func.end));
                    put(inout elab.out, in " P $dim_");
                    state.names.write(
                        u32_at(in ctx.sig_generic_names, add(sig_generics_start, k)),
                        inout elab.out
                    );
                    put(inout elab.out, in ":u64@");
                    push_decimal(inout elab.out, span);
                    put(inout elab.out, in "..");
                    push_decimal(inout elab.out, inc(span));
                    elab.out.push(10);
                }
            }
            for param_idx in 0..list_len(in ast, func.params) {
                let param = paramn(in ast, list_at(in ast, func.params, param_idx));
                put(inout elab.out, in " P ");
                state.names.write(nm(in state, param.name), inout elab.out);
                put(inout elab.out, in ":");
                put_erased_ty(in state, in ctx, in ast, param.ty, inout elab.out);
                put(inout elab.out, in "@");
                push_decimal(inout elab.out, widen_u64(param.start));
                put(inout elab.out, in "..");
                push_decimal(inout elab.out, widen_u64(param.end));
                elab.out.push(10);
            }
            put(inout elab.out, in " R ");
            put_erased_ty(in state, in ctx, in ast, func.result, inout elab.out);
            elab.out.push(10);
            if func.effects != NONE {
                let effects_row = effectsn(in ast, func.effects);
                if list_len(in ast, effects_row.instances) > 0 || effects_row.tail != NONE {
                    put(inout elab.out, in " E ");
                    put_erased_row(in state, in ctx, in ast, func.effects, inout elab.out);
                    elab.out.push(10);
                }
            }
            if func.body != NONE {
                put(inout elab.out, in " B ");
                emit_expr(in state, in ctx, in ast, func.body, inout elab);
                elab.out.push(10);
            }
        }
    }
    for i in 0..elab.syn_starts.len() {
        put(inout elab.out, in "SYN ");
        push_decimal(inout elab.out, u64_at(in elab.syn_starts, i));
        put(inout elab.out, in " -> @");
        push_decimal(inout elab.out, u64_at(in elab.orig_starts, i));
        put(inout elab.out, in "..");
        push_decimal(inout elab.out, u64_at(in elab.orig_ends, i));
        elab.out.push(10);
    }
    elab.out
}
