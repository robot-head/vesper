// Binary `Ast` decoder for `@vesper/check-tensor-types` (SH2 lane 14 part 3, #1186).

use @vesper/ast::{
    AdtNode,
    ArgNode,
    Ast,
    ClauseNode,
    ConfNode,
    EffectDeclNode,
    EffectNode,
    EffectsNode,
    ExprNode,
    FieldNode,
    FnNode,
    GenericNode,
    ImplNode,
    ItemNode,
    ListRef,
    Lit,
    ParamNode,
    PatNode,
    StmtNode,
    TraitNode,
    TypeNode,
    VariantNode,
    ast_new
};
use @vesper/check-data::input::{Reader};
use @vesper/check-data::util::{add, n32};

pub fn read_ast(in names: Str, inout r: Reader, in b: Slice[u8]) -> Ast {
    let mut a = ast_new();
    let n_names = r.word(in b);
    let mut noff: u64 = 0;
    for _ in 0..n_names {
        let nlen = r.word(in b);
        let nend = add(noff, nlen);
        let _ = a.names.intern(in names[noff..nend]);
        noff = nend;
    }
    let n_lits = r.word(in b);
    for _ in 0..n_lits {
        let _ = a
            .lits
            .alloc(
                Lit {
                    kind: wrapping_u8(r.word(in b)),
                    neg: r.word(in b) != 0,
                    bits: r.word(in b),
                    hi: r.word(in b)
                }
            );
    }
    let n_exprs = r.word(in b);
    for _ in 0..n_exprs {
        let _ = a
            .exprs
            .alloc(
                ExprNode {
                    kind: wrapping_u8(r.word(in b)),
                    start: wrapping_u32(r.word(in b)),
                    end: wrapping_u32(r.word(in b)),
                    a: wrapping_u32(r.word(in b)),
                    b: wrapping_u32(r.word(in b)),
                    c: wrapping_u32(r.word(in b)),
                    d: wrapping_u32(r.word(in b)),
                    e: wrapping_u32(r.word(in b))
                }
            );
    }
    let n_pats = r.word(in b);
    for _ in 0..n_pats {
        let _ = a
            .pats
            .alloc(
                PatNode {
                    kind: wrapping_u8(r.word(in b)),
                    start: wrapping_u32(r.word(in b)),
                    end: wrapping_u32(r.word(in b)),
                    a: wrapping_u32(r.word(in b)),
                    b: wrapping_u32(r.word(in b)),
                    c: wrapping_u32(r.word(in b))
                }
            );
    }
    let n_types = r.word(in b);
    for _ in 0..n_types {
        let _ = a
            .types
            .alloc(
                TypeNode {
                    kind: wrapping_u8(r.word(in b)),
                    a: wrapping_u32(r.word(in b)),
                    b: wrapping_u32(r.word(in b)),
                    c: wrapping_u32(r.word(in b)),
                    d: wrapping_u32(r.word(in b))
                }
            );
    }
    let n_stmts = r.word(in b);
    for _ in 0..n_stmts {
        let _ = a
            .stmts
            .alloc(
                StmtNode {
                    kind: wrapping_u8(r.word(in b)),
                    pat: wrapping_u32(r.word(in b)),
                    ty: wrapping_u32(r.word(in b)),
                    value: wrapping_u32(r.word(in b)),
                    mutable: r.word(in b) != 0
                }
            );
    }
    let n_args = r.word(in b);
    for _ in 0..n_args {
        let _ = a
            .args
            .alloc(
                ArgNode {
                    pass: wrapping_u8(r.word(in b)),
                    explicit: r.word(in b) != 0,
                    expr: wrapping_u32(r.word(in b))
                }
            );
    }
    let n_clauses = r.word(in b);
    for _ in 0..n_clauses {
        let _ = a
            .clauses
            .alloc(
                ClauseNode {
                    name: wrapping_u32(r.word(in b)),
                    pats: wrapping_u32(r.word(in b)),
                    body: wrapping_u32(r.word(in b))
                }
            );
    }
    let n_params = r.word(in b);
    for _ in 0..n_params {
        let _ = a
            .params
            .alloc(
                ParamNode {
                    name: wrapping_u32(r.word(in b)),
                    pass: wrapping_u8(r.word(in b)),
                    projections: wrapping_u32(r.word(in b)),
                    ty: wrapping_u32(r.word(in b)),
                    start: wrapping_u32(r.word(in b)),
                    end: wrapping_u32(r.word(in b))
                }
            );
    }
    let n_effects = r.word(in b);
    for _ in 0..n_effects {
        let _ = a
            .effects
            .alloc(
                EffectsNode {
                    instances: wrapping_u32(r.word(in b)),
                    tail: wrapping_u32(r.word(in b))
                }
            );
    }
    let n_enodes = r.word(in b);
    for _ in 0..n_enodes {
        let _ = a
            .effect_nodes
            .alloc(
                EffectNode {
                    label: wrapping_u32(r.word(in b)),
                    name: wrapping_u32(r.word(in b)),
                    args: wrapping_u32(r.word(in b))
                }
            );
    }
    let n_generics = r.word(in b);
    for _ in 0..n_generics {
        let _ = a
            .generics
            .alloc(
                GenericNode {
                    name: wrapping_u32(r.word(in b)),
                    bound: wrapping_u8(r.word(in b)),
                    row: r.word(in b) != 0
                }
            );
    }
    let n_fields = r.word(in b);
    for _ in 0..n_fields {
        let _ = a
            .fields
            .alloc(
                FieldNode {
                    name: wrapping_u32(r.word(in b)),
                    ty: wrapping_u32(r.word(in b)),
                    modality: wrapping_u8(r.word(in b)),
                    temperature: wrapping_u8(r.word(in b))
                }
            );
    }
    let n_variants = r.word(in b);
    for _ in 0..n_variants {
        let _ = a
            .variants
            .alloc(
                VariantNode {
                    name: wrapping_u32(r.word(in b)),
                    fields: wrapping_u32(r.word(in b)),
                    named: r.word(in b) != 0
                }
            );
    }
    let n_adts = r.word(in b);
    for _ in 0..n_adts {
        let _ = a
            .adts
            .alloc(
                AdtNode {
                    name: wrapping_u32(r.word(in b)),
                    mode: wrapping_u8(r.word(in b)),
                    generics: wrapping_u32(r.word(in b)),
                    variants: wrapping_u32(r.word(in b)),
                    is_enum: r.word(in b) != 0,
                    tiled: r.word(in b) != 0,
                    tile_width: wrapping_u32(r.word(in b)),
                    start: wrapping_u32(r.word(in b)),
                    end: wrapping_u32(r.word(in b))
                }
            );
    }
    let n_fns = r.word(in b);
    for _ in 0..n_fns {
        let _ = a
            .fns
            .alloc(
                FnNode {
                    name: wrapping_u32(r.word(in b)),
                    fip: r.word(in b) != 0,
                    generics: wrapping_u32(r.word(in b)),
                    params: wrapping_u32(r.word(in b)),
                    result: wrapping_u32(r.word(in b)),
                    effects: wrapping_u32(r.word(in b)),
                    body: wrapping_u32(r.word(in b)),
                    start: wrapping_u32(r.word(in b)),
                    end: wrapping_u32(r.word(in b))
                }
            );
    }
    let n_edecls = r.word(in b);
    for _ in 0..n_edecls {
        let _ = a
            .effect_decls
            .alloc(
                EffectDeclNode {
                    name: wrapping_u32(r.word(in b)),
                    linear: r.word(in b) != 0,
                    generics: wrapping_u32(r.word(in b)),
                    ops: wrapping_u32(r.word(in b)),
                    start: wrapping_u32(r.word(in b)),
                    end: wrapping_u32(r.word(in b))
                }
            );
    }
    let n_impls = r.word(in b);
    for _ in 0..n_impls {
        let _ = a
            .impls
            .alloc(
                ImplNode {
                    ty: wrapping_u32(r.word(in b)),
                    generics: wrapping_u32(r.word(in b)),
                    methods: wrapping_u32(r.word(in b))
                }
            );
    }
    let n_traits = r.word(in b);
    for _ in 0..n_traits {
        let _ = a
            .traits
            .alloc(
                TraitNode {
                    name: wrapping_u32(r.word(in b)),
                    public: r.word(in b) != 0,
                    generics: wrapping_u32(r.word(in b)),
                    assoc: wrapping_u32(r.word(in b)),
                    methods: wrapping_u32(r.word(in b)),
                    start: wrapping_u32(r.word(in b)),
                    end: wrapping_u32(r.word(in b))
                }
            );
    }
    let n_confs = r.word(in b);
    for _ in 0..n_confs {
        let _ = a
            .confs
            .alloc(
                ConfNode {
                    model: wrapping_u32(r.word(in b)),
                    public: r.word(in b) != 0,
                    generics: wrapping_u32(r.word(in b)),
                    trait_ref: wrapping_u32(r.word(in b)),
                    self_ty: wrapping_u32(r.word(in b)),
                    wheres: wrapping_u32(r.word(in b)),
                    assoc: wrapping_u32(r.word(in b)),
                    methods: wrapping_u32(r.word(in b)),
                    start: wrapping_u32(r.word(in b)),
                    end: wrapping_u32(r.word(in b))
                }
            );
    }
    let n_items = r.word(in b);
    for _ in 0..n_items {
        let _ = a
            .items
            .alloc(ItemNode { kind: wrapping_u8(r.word(in b)), node: wrapping_u32(r.word(in b)) });
    }
    let n_lists = r.word(in b);
    for _ in 0..n_lists {
        let _ = a.lists.alloc(ListRef { first: n32(r.word(in b)), len: n32(r.word(in b)) });
    }
    let n_pool = r.word(in b);
    for _ in 0..n_pool {
        a.pool.push(wrapping_u32(r.word(in b)));
    }
    let n_mitems = r.word(in b);
    for _ in 0..n_mitems {
        a.m_items.push(wrapping_u32(r.word(in b)));
    }
    a
}
