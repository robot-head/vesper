// The tables of the tensor checker (src/tensor_types/dim.rs and types.rs):
// interned names, hash-consed dimensions and tensor-view types, the
// diagnostics, and the display of each as Rust prints it.
//
// The census design (docs/parallel-results/self-host-census.md): a
// dimension and a type are `u32` ids of hash-consed nodes, so `Dim == Dim`
// and `Ty == Ty` in Rust are id equality here; names are symbols of one
// `Names` table, compared byte by byte where Rust orders `String`s.

use @vesper/check-data::names::{Names, names_new};
use @vesper/check-data::util::{add, fold, inc, inc32, n32, push_decimal, u32_at, u64_at, u8_at, w};

// `u32::MAX`: an absent id, or a failed conversion (its text is `St.err`).
const NONE: u32 = 4294967295;
// `dim::MAX_DIM` and `dim::MAX_FACTORS`.
const MAX_DIM: u64 = 1099511627776;
const MAX_FACTORS: u64 = 16;

// Ty kinds (`types::Ty`).
const T_TENSOR: u8 = 1;
const T_LEASE: u8 = 2;
const T_SEQ: u8 = 3;
const T_ADT: u8 = 4;
const T_TUPLE: u8 = 5;
const T_FN: u8 = 6;
const T_VAR: u8 = 7;
const T_BASE: u8 = 8;
const T_UNKNOWN: u8 = 9;

// `coeff * Π var^exp`: `factor_count` (var, exp) pairs at
// `dim_factors[factors_start..]`, sorted by
// the variable's name bytes (`BTreeMap<String, u32>` order).
pub copy struct DimN {
    coeff: u64,
    factors_start: u32,
    factor_count: u32
}

// A `types::Ty`. Tensor: `primary` dtype, items = shape dims. Lease and
// Seq: `primary` KvHeads, `secondary` HeadDim. Adt: `primary` name, items =
// (tag, id) pairs (tag 0 Ty, 1 Dim, 2 DType). Tuple: items. Fn: items =
// parameters, `secondary` result. Var and Base: `primary` name.
pub copy struct TyN {
    kind: u8,
    primary: u32,
    secondary: u32,
    items_start: u32,
    arity: u32
}

pub struct St {
    names: Names,
    // AST symbol -> name.
    ast_names: ChunkSeq[u32],
    // Well-known names.
    tensor_name: u32,
    kv_pool_name: u32,
    lease_name: u32,
    seq_name: u32,
    kv_oom_name: u32,
    dims_name: u32,
    f32_name: u32,
    bf16_name: u32,
    byte_array_name: u32,
    zero_pad_name: u32,
    shape_name: u32,
    product_name: u32,
    option_name: u32,
    result_name: u32,
    some_name: u32,
    ok_name: u32,
    err_name: u32,
    wire_name: u32,
    int_name: u32,
    f64_name: u32,
    bool_name: u32,
    string_name: u32,
    u64_name: u32,
    dyn_name: u32,
    // Dimensions.
    dim_nodes: ChunkSeq[DimN],
    dim_factors: ChunkSeq[u32],
    dim_hashes: ChunkSeq[u64],
    dim_slots: ChunkSeq[u32],
    dim_mask: u64,
    // The last `DimError`: 1 Overflow, 2 Zero, 3 Factors.
    dim_error: u8,
    one_dim: u32,
    // Types.
    ty_nodes: ChunkSeq[TyN],
    ty_item_pool: ChunkSeq[u32],
    ty_hashes: ChunkSeq[u64],
    ty_slots: ChunkSeq[u32],
    ty_mask: u64,
    unknown: u32,
    unit: u32,
    // The message of the last failed conversion (Rust's `Err(String)`).
    err: ChunkSeq[u8],
    // Diagnostics: code number (761 for E0761), span, message bytes.
    diag_codes: ChunkSeq[u32],
    diag_starts: ChunkSeq[u64],
    diag_ends: ChunkSeq[u64],
    diag_msg_starts: ChunkSeq[u64],
    diag_msg_ends: ChunkSeq[u64],
    diag_text: ChunkSeq[u8]
}

pub fn zero_slots(n: u64) -> ChunkSeq[u32] {
    let mut slots: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](n);
    slots.resize(n, 0);
    slots
}

fn sym(inout names: Names, in text: Str) -> u32 {
    names.intern(in text.as_bytes())
}

pub fn st_new() -> St {
    let mut names = names_new();
    let mut state = St {
        tensor_name: sym(inout names, "Tensor"),
        kv_pool_name: sym(inout names, "KvCachePool"),
        lease_name: sym(inout names, "KvPageLease"),
        seq_name: sym(inout names, "ActiveKvSeq"),
        kv_oom_name: sym(inout names, "KvOomError"),
        dims_name: sym(inout names, "Dims"),
        f32_name: sym(inout names, "F32"),
        bf16_name: sym(inout names, "Bf16"),
        byte_array_name: sym(inout names, "ByteArray"),
        zero_pad_name: sym(inout names, "ZeroPad"),
        shape_name: sym(inout names, "[]"),
        product_name: sym(inout names, "*"),
        option_name: sym(inout names, "Option"),
        result_name: sym(inout names, "Result"),
        some_name: sym(inout names, "Some"),
        ok_name: sym(inout names, "Ok"),
        err_name: sym(inout names, "Err"),
        wire_name: sym(inout names, "wire"),
        int_name: sym(inout names, "int"),
        f64_name: sym(inout names, "f64"),
        bool_name: sym(inout names, "bool"),
        string_name: sym(inout names, "String"),
        u64_name: sym(inout names, "u64"),
        dyn_name: sym(inout names, "dyn"),
        names: names,
        ast_names: ChunkSeq::new[u32](),
        dim_nodes: ChunkSeq::new[DimN](),
        dim_factors: ChunkSeq::new[u32](),
        dim_hashes: ChunkSeq::new[u64](),
        dim_slots: zero_slots(1024),
        dim_mask: 1023,
        dim_error: 0,
        one_dim: 0,
        ty_nodes: ChunkSeq::new[TyN](),
        ty_item_pool: ChunkSeq::new[u32](),
        ty_hashes: ChunkSeq::new[u64](),
        ty_slots: zero_slots(1024),
        ty_mask: 1023,
        unknown: 0,
        unit: 0,
        err: ChunkSeq::new[u8](),
        diag_codes: ChunkSeq::new[u32](),
        diag_starts: ChunkSeq::new[u64](),
        diag_ends: ChunkSeq::new[u64](),
        diag_msg_starts: ChunkSeq::new[u64](),
        diag_msg_ends: ChunkSeq::new[u64](),
        diag_text: ChunkSeq::new[u8]()
    };
    let none: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let one = mk_dim(inout state, 1, in none);
    state.one_dim = one;
    let unknown = mk_ty(inout state, T_UNKNOWN, 0, 0, in none);
    state.unknown = unknown;
    let unit = mk_ty(inout state, T_TUPLE, 0, 0, in none);
    state.unit = unit;
    state
}

// ----- text -------------------------------------------------------------------

pub fn put(inout out: ChunkSeq[u8], in text: Str) {
    out.extend(in text.as_bytes());
}

// Clears the error text.

pub fn fail(inout state: St, in message: Str) -> u32 {
    state.err.clear();
    put(inout state.err, in message);
    NONE
}

// Byte order of two names (`String` order): -1, 0 or 1.
pub fn cmp_names(in state: St, name_a: u32, name_b: u32) -> i64 {
    if name_a == name_b {
        return 0;
    }
    let len_a = state.names.size(name_a);
    let len_b = state.names.size(name_b);
    let mut i: u64 = 0;
    loop {
        if i >= len_a || i >= len_b {
            break;
        }
        let byte_a = state.names.byte(name_a, i);
        let byte_b = state.names.byte(name_b, i);
        if byte_a < byte_b {
            return -1;
        }
        if byte_a > byte_b {
            return 1;
        }
        i = inc(i);
    }
    if len_a < len_b {
        -1
    } else if len_a > len_b {
        1
    } else {
        0
    }
}

pub fn spells(in state: St, name: u32, in text: Str) -> bool {
    state.names.spells(name, in text.as_bytes())
}

// Whether the name is a nonempty run of ASCII digits (`is_dim_name`).
pub fn is_digits(in state: St, name: u32) -> bool {
    let n = state.names.size(name);
    if n == 0 {
        return false;
    }
    for i in 0..n {
        let byte = state.names.byte(name, i);
        if byte < 48 || byte > 57 {
            return false;
        }
    }
    true
}

// Interns bytes `from..` of name `name`.
pub fn name_suffix(inout state: St, name: u32, from: u64) -> u32 {
    let mut bytes = ChunkSeq::new[u8]();
    let n = state.names.size(name);
    let mut i = from;
    loop {
        if i >= n {
            break;
        }
        bytes.push(state.names.byte(name, i));
        i = inc(i);
    }
    state.names.intern(in bytes.as_slice())
}

// Interns bytes `..to` of name `name`.
pub fn name_prefix(inout state: St, name: u32, to: u64) -> u32 {
    let mut bytes = ChunkSeq::new[u8]();
    for i in 0..to {
        bytes.push(state.names.byte(name, i));
    }
    state.names.intern(in bytes.as_slice())
}

// The offset of the first `::` in `name`, or the name's size.
pub fn first_colons(in state: St, name: u32) -> u64 {
    let n = state.names.size(name);
    let mut i: u64 = 0;
    loop {
        if inc(i) >= n {
            return n;
        }
        if state.names.byte(name, i) == 58 && state.names.byte(name, inc(i)) == 58 {
            return i;
        }
        i = inc(i);
    }
}

// `name.rsplit("::").next()`: the text after the last `::`.
pub fn last_segment(inout state: St, name: u32) -> u32 {
    let n = state.names.size(name);
    let mut cut: u64 = 0;
    let mut found = false;
    let mut i: u64 = 0;
    loop {
        if inc(i) >= n {
            break;
        }
        if state.names.byte(name, i) == 58 && state.names.byte(name, inc(i)) == 58 {
            cut = wrapping_add(i, 2);
            found = true;
        }
        i = inc(i);
    }
    if found {
        name_suffix(inout state, name, cut)
    } else {
        name
    }
}

// `name.strip_prefix(prefix)` for a `prefix` ending in `::`: the rest, or
// NONE.
pub fn strip_prefix(inout state: St, name: u32, in prefix: Str) -> u32 {
    if state.names.has_prefix(name, in prefix.as_bytes()) {
        name_suffix(inout state, name, prefix.len())
    } else {
        NONE
    }
}

// ----- dimensions (dim.rs) ------------------------------------------------------

pub fn dim_node(in state: St, dim: u32) -> DimN {
    match state.dim_nodes.try_get(widen_u64(dim)) {
        Option::Some(node) => node,
        Option::None => DimN { coeff: 1, factors_start: 0, factor_count: 0 },
    }
}

pub fn dim_var_at(in state: St, dim: u32, i: u64) -> u32 {
    let node = dim_node(in state, dim);
    u32_at(in state.dim_factors, wrapping_add(widen_u64(node.factors_start), wrapping_mul(i, 2)))
}

pub fn dim_exp_at(in state: St, dim: u32, i: u64) -> u32 {
    let node = dim_node(in state, dim);
    u32_at(
        in state.dim_factors,
        wrapping_add(widen_u64(node.factors_start), inc(wrapping_mul(i, 2)))
    )
}

fn dim_hash(coeff: u64, in items: ChunkSeq[u32]) -> u64 {
    let mut hash = fold(14695981039346656037, coeff);
    for i in 0..items.len() {
        hash = fold(hash, widen_u64(u32_at(in items, i)));
    }
    hash
}

fn dim_same(in state: St, id: u32, coeff: u64, in items: ChunkSeq[u32]) -> bool {
    let node = dim_node(in state, id);
    if node.coeff != coeff || wrapping_mul(widen_u64(node.factor_count), 2) != items.len() {
        return false;
    }
    for i in 0..items.len() {
        if u32_at(in state.dim_factors, wrapping_add(widen_u64(node.factors_start), i))
            != u32_at(in items, i) {
            return false;
        }
    }
    true
}

fn grow_dims(inout state: St) {
    let cap = wrapping_mul(wrapping_add(state.dim_mask, 1), 2);
    let mut slots = zero_slots(cap);
    let mask = wrapping_sub(cap, 1);
    for id in 0.. state.dim_hashes.len() {
        let mut at = u64_at(in state.dim_hashes, id) & mask;
        loop {
            if u32_at(in slots, at) == 0 {
                break;
            }
            at = inc(at) & mask;
        }
        let ok = slots.try_set(at, wrapping_u32(inc(id)));
    }
    state.dim_slots = slots;
    state.dim_mask = mask;
}

// The dimension `coeff * Π items` (items sorted (var, exp) pairs).
pub fn mk_dim(inout state: St, coeff: u64, in items: ChunkSeq[u32]) -> u32 {
    let hash = dim_hash(coeff, in items);
    let mut at = hash & state.dim_mask;
    loop {
        let slot = u32_at(in state.dim_slots, at);
        if slot == 0 {
            break;
        }
        let id = wrapping_sub(slot, 1);
        if u64_at(in state.dim_hashes, widen_u64(id)) == hash
            && dim_same(in state, id, coeff, in items) {
            return id;
        }
        at = inc(at) & state.dim_mask;
    }
    let id = wrapping_u32(state.dim_nodes.len());
    let items_start = wrapping_u32(state.dim_factors.len());
    state.dim_factors.extend(in items.as_slice());
    state.dim_nodes.push(
        DimN {
            coeff: coeff,
            factors_start: items_start,
            factor_count: wrapping_u32(items.len() >> 1)
        }
    );
    state.dim_hashes.push(hash);
    let ok = state.dim_slots.try_set(at, inc32(id));
    if wrapping_mul(state.dim_hashes.len(), 2) > state.dim_mask {
        grow_dims(inout state);
    }
    id
}

// `Dim::constant`: NONE with `dim_error` on zero or overflow.
pub fn dim_const(inout state: St, value: u64) -> u32 {
    if value == 0 {
        state.dim_error = 2;
        return NONE;
    }
    if value > MAX_DIM {
        state.dim_error = 1;
        return NONE;
    }
    let none: ChunkSeq[u32] = ChunkSeq::new[u32]();
    mk_dim(inout state, value, in none)
}

pub fn dim_var(inout state: St, var: u32) -> u32 {
    let mut items = ChunkSeq::new[u32]();
    items.push(var);
    items.push(1);
    mk_dim(inout state, 1, in items)
}

// `Dim::as_const`: the constant, or NONE64 (u64::MAX).

// `Dim::as_var`: the variable when the dimension is exactly it, else NONE.
pub fn dim_as_var(in state: St, dim: u32) -> u32 {
    let node = dim_node(in state, dim);
    if node.coeff == 1 && node.factor_count == 1 && dim_exp_at(in state, dim, 0) == 1 {
        dim_var_at(in state, dim, 0)
    } else {
        NONE
    }
}

// `Dim::mul`: NONE with `dim_error` on overflow or too many factors.
pub fn dim_mul(inout state: St, lhs: u32, rhs: u32) -> u32 {
    let lhs_node = dim_node(in state, lhs);
    let rhs_node = dim_node(in state, rhs);
    let coeff = match checked_mul_u64(lhs_node.coeff, rhs_node.coeff) {
        Option::Some(product) => product,
        Option::None => {
            state.dim_error = 1;
            return NONE;
        },
    };
    if coeff > MAX_DIM {
        state.dim_error = 1;
        return NONE;
    }
    let mut items = ChunkSeq::new[u32]();
    let mut i: u64 = 0;
    let mut j: u64 = 0;
    let lhs_len = widen_u64(lhs_node.factor_count);
    let rhs_len = widen_u64(rhs_node.factor_count);
    let mut total: u64 = 0;
    loop {
        if i >= lhs_len && j >= rhs_len {
            break;
        }
        let mut take: i64 = 0;
        if i >= lhs_len {
            take = 1;
        } else if j >= rhs_len {
            take = -1;
        } else {
            take = cmp_names(in state, dim_var_at(in state, lhs, i), dim_var_at(in state, rhs, j));
        }
        if take < 0 {
            items.push(dim_var_at(in state, lhs, i));
            let exp = dim_exp_at(in state, lhs, i);
            items.push(exp);
            total = wrapping_add(total, widen_u64(exp));
            i = inc(i);
        } else if take > 0 {
            items.push(dim_var_at(in state, rhs, j));
            let exp = dim_exp_at(in state, rhs, j);
            items.push(exp);
            total = wrapping_add(total, widen_u64(exp));
            j = inc(j);
        } else {
            items.push(dim_var_at(in state, lhs, i));
            let exp = wrapping_add(dim_exp_at(in state, lhs, i), dim_exp_at(in state, rhs, j));
            items.push(exp);
            total = wrapping_add(total, widen_u64(exp));
            i = inc(i);
            j = inc(j);
        }
    }
    if total > MAX_FACTORS {
        state.dim_error = 3;
        return NONE;
    }
    mk_dim(inout state, coeff, in items)
}

// The dimension `dim` without variable `var` (its factor removed), keeping the
// coefficient.
pub fn dim_without(inout state: St, dim: u32, var: u32) -> u32 {
    let node = dim_node(in state, dim);
    let mut items = ChunkSeq::new[u32]();
    for i in 0..widen_u64(node.factor_count) {
        let factor_var = dim_var_at(in state, dim, i);
        if factor_var != var {
            items.push(factor_var);
            items.push(dim_exp_at(in state, dim, i));
        }
    }
    mk_dim(inout state, node.coeff, in items)
}

pub fn dim_mentions(in state: St, dim: u32, var: u32) -> bool {
    for i in 0..widen_u64(dim_node(in state, dim).factor_count) {
        if dim_var_at(in state, dim, i) == var {
            return true;
        }
    }
    false
}

// The exponent of `var` in `dim` (0 when absent).
pub fn dim_exp_of(in state: St, dim: u32, var: u32) -> u32 {
    for i in 0..widen_u64(dim_node(in state, dim).factor_count) {
        if dim_var_at(in state, dim, i) == var {
            return dim_exp_at(in state, dim, i);
        }
    }
    0
}

// `Dim::divides`: `divisor` divides `dividend` for every value of the variables.
pub fn dim_divides(in state: St, divisor: u32, dividend: u32) -> bool {
    let divisor_node = dim_node(in state, divisor);
    let dividend_node = dim_node(in state, dividend);
    let divisor_coeff = divisor_node.coeff;
    if divisor_coeff == 0 {
        return dividend_node.coeff == 0;
    }
    if dividend_node.coeff % divisor_coeff != 0 {
        return false;
    }
    for i in 0..widen_u64(divisor_node.factor_count) {
        let var = dim_var_at(in state, divisor, i);
        if dim_exp_of(in state, dividend, var) < dim_exp_at(in state, divisor, i) {
            return false;
        }
    }
    true
}

// `y / x` when `dim_divides(x, y)`: the solved value of `Subst::solve`.
pub fn dim_quotient(inout state: St, divisor: u32, dividend: u32) -> u32 {
    let divisor_node = dim_node(in state, divisor);
    let dividend_node = dim_node(in state, dividend);
    let mut coeff = dividend_node.coeff;
    let divisor_coeff = divisor_node.coeff;
    if divisor_coeff > 0 {
        coeff = dividend_node.coeff / divisor_coeff;
    }
    let mut items = ChunkSeq::new[u32]();
    for i in 0..widen_u64(dividend_node.factor_count) {
        let var = dim_var_at(in state, dividend, i);
        let exp = wrapping_sub(
            dim_exp_at(in state, dividend, i),
            dim_exp_of(in state, divisor, var)
        );
        if exp != 0 {
            items.push(var);
            items.push(exp);
        }
    }
    mk_dim(inout state, coeff, in items)
}

// The derived `Ord` of `Dim`: coefficient, then the (var, exp) pairs.
pub fn cmp_dim(in state: St, lhs: u32, rhs: u32) -> i64 {
    if lhs == rhs {
        return 0;
    }
    let lhs_node = dim_node(in state, lhs);
    let rhs_node = dim_node(in state, rhs);
    if lhs_node.coeff < rhs_node.coeff {
        return -1;
    }
    if lhs_node.coeff > rhs_node.coeff {
        return 1;
    }
    let mut i: u64 = 0;
    loop {
        if i >= widen_u64(lhs_node.factor_count) || i >= widen_u64(rhs_node.factor_count) {
            break;
        }
        let name_order = cmp_names(
            in state,
            dim_var_at(in state, lhs, i),
            dim_var_at(in state, rhs, i)
        );
        if name_order != 0 {
            return name_order;
        }
        let lhs_exp = dim_exp_at(in state, lhs, i);
        let rhs_exp = dim_exp_at(in state, rhs, i);
        if lhs_exp < rhs_exp {
            return -1;
        }
        if lhs_exp > rhs_exp {
            return 1;
        }
        i = inc(i);
    }
    if lhs_node.factor_count < rhs_node.factor_count {
        -1
    } else if lhs_node.factor_count > rhs_node.factor_count {
        1
    } else {
        0
    }
}

// `impl Display for DimError`.
pub fn put_dim_error(inout out: ChunkSeq[u8], code: u8) {
    if code == 1 {
        put(inout out, in "dimension exceeds 1099511627776");
    } else if code == 2 {
        put(inout out, in "dimensions must be positive");
    } else {
        put(inout out, in "dimension has more than 16 factors");
    }
}

// Sets `err` to the last `DimError` and returns NONE.
pub fn dim_fail(inout state: St) -> u32 {
    state.err.clear();
    put_dim_error(inout state.err, state.dim_error);
    NONE
}

// `impl Display for Dim`.
pub fn put_dim(in state: St, inout out: ChunkSeq[u8], dim: u32) {
    let node = dim_node(in state, dim);
    let mut first = true;
    if node.coeff != 1 || node.factor_count == 0 {
        push_decimal(inout out, node.coeff);
        first = false;
    }
    for i in 0..widen_u64(node.factor_count) {
        let var = dim_var_at(in state, dim, i);
        let exp = dim_exp_at(in state, dim, i);
        for k in 0..widen_u64(exp) {
            if !first {
                put(inout out, in " * ");
            }
            state.names.write(var, inout out);
            first = false;
        }
    }
}

// A shape is a list of dims: `n` ids at `items[a..]`. `display_shape`.
pub fn put_shape(in state: St, inout out: ChunkSeq[u8], in items: ChunkSeq[u32]) {
    out.push(91);
    for i in 0..items.len() {
        if i > 0 {
            put(inout out, in ", ");
        }
        put_dim(in state, inout out, u32_at(in items, i));
    }
    out.push(93);
}

// ----- dtypes --------------------------------------------------------------------
// A `DType` is one word: 0 F32, 1 Bf16, 2 + 2 * name a block, 3 + 2 * name a
// dtype variable.

pub fn put_dtype(in state: St, inout out: ChunkSeq[u8], dtype: u32) {
    if dtype == 0 {
        put(inout out, in "F32");
    } else if dtype == 1 {
        put(inout out, in "Bf16");
    } else {
        state.names.write((wrapping_sub(dtype, 2) >> 1), inout out);
    }
}

// ----- types (types.rs `Ty`) ------------------------------------------------------

pub fn ty_node(in state: St, ty: u32) -> TyN {
    match state.ty_nodes.try_get(widen_u64(ty)) {
        Option::Some(node) => node,
        Option::None => TyN { kind: T_UNKNOWN, primary: 0, secondary: 0, items_start: 0, arity: 0 },
    }
}

// Item `i` of a type (a shape dim, tuple element or parameter; for an Adt
// the tag of argument `i / 2` or its id).
pub fn ty_item(in state: St, ty: u32, i: u64) -> u32 {
    let node = ty_node(in state, ty);
    u32_at(in state.ty_item_pool, wrapping_add(widen_u64(node.items_start), i))
}

// The items of a type as a list.
pub fn ty_items(in state: St, ty: u32) -> ChunkSeq[u32] {
    let node = ty_node(in state, ty);
    let mut out = ChunkSeq::with_capacity[u32](widen_u64(node.arity));
    let mut item_count = widen_u64(node.arity);
    if node.kind == T_ADT {
        item_count = wrapping_mul(item_count, 2);
    }
    for i in 0..item_count {
        out.push(u32_at(in state.ty_item_pool, wrapping_add(widen_u64(node.items_start), i)));
    }
    out
}

fn ty_hash(kind: u8, primary: u32, secondary: u32, in items: ChunkSeq[u32]) -> u64 {
    let mut hash = fold(14695981039346656037, widen_u64(kind));
    hash = fold(hash, widen_u64(primary));
    hash = fold(hash, widen_u64(secondary));
    for i in 0..items.len() {
        hash = fold(hash, widen_u64(u32_at(in items, i)));
    }
    hash
}

fn ty_same(
    in state: St,
    id: u32,
    kind: u8,
    primary: u32,
    secondary: u32,
    in items: ChunkSeq[u32]
) -> bool {
    let node = ty_node(in state, id);
    let mut item_count = widen_u64(node.arity);
    if node.kind == T_ADT {
        item_count = wrapping_mul(item_count, 2);
    }
    if node.kind != kind
        || node.primary != primary
        || node.secondary != secondary
        || item_count != items.len() {
        return false;
    }
    for i in 0..items.len() {
        if u32_at(in state.ty_item_pool, wrapping_add(widen_u64(node.items_start), i))
            != u32_at(in items, i) {
            return false;
        }
    }
    true
}

fn grow_tys(inout state: St) {
    let cap = wrapping_mul(wrapping_add(state.ty_mask, 1), 2);
    let mut slots = zero_slots(cap);
    let mask = wrapping_sub(cap, 1);
    for id in 0.. state.ty_hashes.len() {
        let mut at = u64_at(in state.ty_hashes, id) & mask;
        loop {
            if u32_at(in slots, at) == 0 {
                break;
            }
            at = inc(at) & mask;
        }
        let ok = slots.try_set(at, wrapping_u32(inc(id)));
    }
    state.ty_slots = slots;
    state.ty_mask = mask;
}

// The type with these parts (hash-consed). For an Adt `items` holds
// (tag, id) pairs.
pub fn mk_ty(
    inout state: St,
    kind: u8,
    primary: u32,
    secondary: u32,
    in items: ChunkSeq[u32]
) -> u32 {
    let hash = ty_hash(kind, primary, secondary, in items);
    let mut at = hash & state.ty_mask;
    loop {
        let slot = u32_at(in state.ty_slots, at);
        if slot == 0 {
            break;
        }
        let id = wrapping_sub(slot, 1);
        if u64_at(in state.ty_hashes, widen_u64(id)) == hash
            && ty_same(in state, id, kind, primary, secondary, in items) {
            return id;
        }
        at = inc(at) & state.ty_mask;
    }
    let id = wrapping_u32(state.ty_nodes.len());
    let items_start = wrapping_u32(state.ty_item_pool.len());
    state.ty_item_pool.extend(in items.as_slice());
    let mut arity = items.len();
    if kind == T_ADT {
        arity = arity >> 1;
    }
    state.ty_nodes.push(
        TyN {
            kind: kind,
            primary: primary,
            secondary: secondary,
            items_start: items_start,
            arity: wrapping_u32(arity)
        }
    );
    state.ty_hashes.push(hash);
    let ok = state.ty_slots.try_set(at, inc32(id));
    if wrapping_mul(state.ty_hashes.len(), 2) > state.ty_mask {
        grow_tys(inout state);
    }
    id
}

pub fn ty_named(inout state: St, kind: u8, name: u32) -> u32 {
    let none: ChunkSeq[u32] = ChunkSeq::new[u32]();
    mk_ty(inout state, kind, name, 0, in none)
}

pub fn ty_pair(inout state: St, kind: u8, kv_heads: u32, head_dim: u32) -> u32 {
    let none: ChunkSeq[u32] = ChunkSeq::new[u32]();
    mk_ty(inout state, kind, kv_heads, head_dim, in none)
}

// `Ty::has_tensor`.
pub fn has_tensor(in state: St, ty: u32) -> bool {
    let node = ty_node(in state, ty);
    if node.kind == T_TENSOR || node.kind == T_LEASE || node.kind == T_SEQ {
        return true;
    }
    if node.kind == T_ADT {
        for i in 0..widen_u64(node.arity) {
            let tag = ty_item(in state, ty, wrapping_mul(i, 2));
            if tag != 0 {
                return true;
            }
            if has_tensor(in state, ty_item(in state, ty, inc(wrapping_mul(i, 2)))) {
                return true;
            }
        }
        return false;
    }
    if node.kind == T_TUPLE || node.kind == T_FN {
        for i in 0..widen_u64(node.arity) {
            if has_tensor(in state, ty_item(in state, ty, i)) {
                return true;
            }
        }
        if node.kind == T_FN {
            return has_tensor(in state, node.secondary);
        }
    }
    false
}

// `impl Display for Ty`.
pub fn put_ty(in state: St, inout out: ChunkSeq[u8], ty: u32) {
    let node = ty_node(in state, ty);
    if node.kind == T_TENSOR {
        put(inout out, in "Tensor[");
        put_dtype(in state, inout out, node.primary);
        put(inout out, in ", ");
        out.push(91);
        for i in 0..widen_u64(node.arity) {
            if i > 0 {
                put(inout out, in ", ");
            }
            put_dim(in state, inout out, ty_item(in state, ty, i));
        }
        put(inout out, in "]]");
    } else if node.kind == T_LEASE || node.kind == T_SEQ {
        if node.kind == T_LEASE {
            put(inout out, in "KvPageLease[");
        } else {
            put(inout out, in "ActiveKvSeq[");
        }
        put_dim(in state, inout out, node.primary);
        put(inout out, in ", ");
        put_dim(in state, inout out, node.secondary);
        out.push(93);
    } else if node.kind == T_ADT {
        state.names.write(node.primary, inout out);
        if node.arity > 0 {
            out.push(91);
            for i in 0..widen_u64(node.arity) {
                if i > 0 {
                    put(inout out, in ", ");
                }
                let tag = ty_item(in state, ty, wrapping_mul(i, 2));
                let id = ty_item(in state, ty, inc(wrapping_mul(i, 2)));
                if tag == 0 {
                    put_ty(in state, inout out, id);
                } else if tag == 1 {
                    put_dim(in state, inout out, id);
                } else {
                    put_dtype(in state, inout out, id);
                }
            }
            out.push(93);
        }
    } else if node.kind == T_TUPLE {
        out.push(40);
        for i in 0..widen_u64(node.arity) {
            if i > 0 {
                put(inout out, in ", ");
            }
            put_ty(in state, inout out, ty_item(in state, ty, i));
        }
        out.push(41);
    } else if node.kind == T_FN {
        put(inout out, in "fn(");
        for i in 0..widen_u64(node.arity) {
            if i > 0 {
                put(inout out, in ", ");
            }
            put_ty(in state, inout out, ty_item(in state, ty, i));
        }
        put(inout out, in ") -> ");
        put_ty(in state, inout out, node.secondary);
    } else if node.kind == T_VAR || node.kind == T_BASE {
        state.names.write(node.primary, inout out);
    } else {
        out.push(95);
    }
}

// ----- diagnostics ------------------------------------------------------------------

// Pushes a diagnostic whose message is `message`.
pub fn diag(inout state: St, code: u32, start: u64, end: u64, in message: ChunkSeq[u8]) {
    state.diag_codes.push(code);
    state.diag_starts.push(start);
    state.diag_ends.push(end);
    state.diag_msg_starts.push(state.diag_text.len());
    state.diag_text.extend(in message.as_slice());
    state.diag_msg_ends.push(state.diag_text.len());
}

pub fn diag_s(inout state: St, code: u32, start: u64, end: u64, in message: Str) {
    let mut bytes = ChunkSeq::new[u8]();
    put(inout bytes, in message);
    diag(inout state, code, start, end, in bytes);
}

// Whether diagnostics `i` and `j` have the same code, span and message.
pub fn diag_same(in state: St, i: u64, j: u64) -> bool {
    if u32_at(in state.diag_codes, i) != u32_at(in state.diag_codes, j)
        || u64_at(in state.diag_starts, i) != u64_at(in state.diag_starts, j)
        || u64_at(in state.diag_ends, i) != u64_at(in state.diag_ends, j) {
        return false;
    }
    let start_i = u64_at(in state.diag_msg_starts, i);
    let end_i = u64_at(in state.diag_msg_ends, i);
    let start_j = u64_at(in state.diag_msg_starts, j);
    let end_j = u64_at(in state.diag_msg_ends, j);
    if wrapping_sub(end_i, start_i) != wrapping_sub(end_j, start_j) {
        return false;
    }
    for k in 0..wrapping_sub(end_i, start_i) {
        if u8_at(in state.diag_text, wrapping_add(start_i, k))
            != u8_at(in state.diag_text, wrapping_add(start_j, k)) {
            return false;
        }
    }
    true
}

// Truncates the diagnostics to the first `n`.
pub fn diag_truncate(inout state: St, n: u64) {
    state.diag_codes.truncate(n);
    state.diag_starts.truncate(n);
    state.diag_ends.truncate(n);
    let text_len = u64_at(in state.diag_msg_starts, n);
    if n < state.diag_msg_starts.len() {
        state.diag_text.truncate(text_len);
    }
    state.diag_msg_starts.truncate(n);
    state.diag_msg_ends.truncate(n);
}

// Whether `err` contains `needle` (`str::contains`).
pub fn err_contains(in state: St, in needle: Str) -> bool {
    let needle_bytes = needle.as_bytes();
    let n = state.err.len();
    let needle_len = needle_bytes.len();
    if needle_len > n {
        return false;
    }
    let mut i: u64 = 0;
    loop {
        if wrapping_add(i, needle_len) > n {
            break;
        }
        let mut ok = true;
        for k in 0..needle_len {
            let byte = match needle_bytes.try_get(k) {
                Option::Some(v) => v,
                Option::None => 0,
            };
            if u8_at(in state.err, wrapping_add(i, k)) != byte {
                ok = false;
                break;
            }
        }
        if ok {
            return true;
        }
        i = inc(i);
    }
    false
}

// `types::error_code` of `err`: 762 for dimension range and rank errors,
// else 761.
pub fn err_code(in state: St) -> u32 {
    if err_contains(in state, in "dimension exceeds 1099511627776")
        || err_contains(in state, in "dimensions must be positive")
        || err_contains(in state, in "dimension has more than 16 factors")
        || err_contains(in state, in "exceeds the supported rank") {
        762
    } else {
        761
    }
}
