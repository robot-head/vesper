// `extract_test_attrs` of crates/vesper-syntax/src/test_attrs.rs: the
// `@test`, `@test(...)` and `@test_case(...)` attributes attached to
// top-level functions (and functions of a `test { }` block), read from the
// non-trivia tokens of @vesper/front's lexer. The attribute-argument
// diagnostics are not kept: discovery drops them.

use @vesper/front::lex::{trivia_kind};
use @vesper/front::kinds::{
    k_at, k_comma, k_eof, k_eq, k_false, k_float, k_fn, k_int, k_l_brace, k_l_bracket, k_l_paren,
    k_lower, k_minus, k_r_brace, k_r_bracket, k_r_paren, k_string, k_true, k_upper
};
use @vesper-std/bytes::ascii::{
    BACKSLASH, CARRIAGE_RETURN, DIGIT_ZERO, HYPHEN, LOWER_N, LOWER_R, LOWER_T, NEWLINE, NUL, QUOTE,
    TAB
};
use self::big::{Big, as_u64, parse_int};
use self::util::{add, byte, inc, is_text, push_range, sub, trim_end, trim_start, u8_at, u64_at};

// `AttrValue` tags.
pub const V_IDENT: u8 = 0;
pub const V_STRING: u8 = 1;
pub const V_INT: u8 = 2;
pub const V_FLOAT: u8 = 3;
pub const V_BOOL: u8 = 4;
pub const V_RAW: u8 = 5;

// One `AttrValue`: the text of Ident, String, Float and Raw is
// `text[text_start..text_end]`.
pub copy struct Val {
    tag: u8,
    text_start: u64,
    text_end: u64,
    int_value: Big,
    bool_value: bool,
}

// An optional text (`text[text_start..text_end]`).
pub copy struct OptText {
    has: bool,
    text_start: u64,
    text_end: u64,
}

pub copy struct OptNum {
    has: bool,
    value: u64,
}

// `TestAttr` (without `extra`, which nothing reads).
pub copy struct TestAttr {
    start: u64,
    end: u64,
    expect_error: OptText,
    primary: OptText,
    related: OptText,
    message: OptText,
    expected_span: OptText,
    cases: OptNum,
    sim_schedules: OptNum,
    fault_profile: OptText,
    max_stack: OptNum,
    max_cycles: OptNum,
    zero_alloc_has: bool,
    zero_alloc: bool,
}

// One `TestCaseArg`: the name is the source range `name_start..name_end`.
pub copy struct Arg {
    has_name: bool,
    name_start: u64,
    name_end: u64,
    value: Val,
    start: u64,
    end: u64,
}

// One `TestCaseAttr`: `args[first_arg..first_arg + arg_count]`.
pub copy struct CaseAttr {
    first_arg: u64,
    arg_count: u64,
    start: u64,
    end: u64,
}

// One `FunctionTestAttrs`: the name is the source range `name_start..name_end`,
// the pins `cases[case_start..case_start + case_count]`.
pub copy struct FnAttrs {
    name_start: u64,
    name_end: u64,
    has_test: bool,
    test: TestAttr,
    case_start: u64,
    case_count: u64,
}

pub struct Attrs {
    text: ChunkSeq[u8],
    args: ChunkSeq[Arg],
    cases: ChunkSeq[CaseAttr],
    fns: ChunkSeq[FnAttrs],
}

fn no_text() -> OptText {
    OptText { has: false, text_start: 0, text_end: 0 }
}

fn no_num() -> OptNum {
    OptNum { has: false, value: 0 }
}

fn no_big() -> Big {
    Big { ok: false, neg: false, hi: 0, lo: 0 }
}

pub fn test_attr_new(start: u64, end: u64) -> TestAttr {
    TestAttr {
        start: start,
        end: end,
        expect_error: no_text(),
        primary: no_text(),
        related: no_text(),
        message: no_text(),
        expected_span: no_text(),
        cases: no_num(),
        sim_schedules: no_num(),
        fault_profile: no_text(),
        max_stack: no_num(),
        max_cycles: no_num(),
        zero_alloc_has: false,
        zero_alloc: false
    }
}

// The token stream without trivia, and the extraction state.
struct Stream {
    kind: ChunkSeq[u8],
    start: ChunkSeq[u64],
    end: ChunkSeq[u64],
    pos: u64,
    len: u64,
    out: Attrs,
    // The pins of the attribute set being read (moved into `out.cases`
    // when a function takes them).
    pending: ChunkSeq[CaseAttr],
}

impl Stream {
    fn kind(in self) -> u8 {
        self.nth_kind(0)
    }

    fn nth_kind(in self, offset: u64) -> u8 {
        match self.kind.try_get(add(self.pos, offset)) {
            Option::Some(k) => k,
            Option::None => k_eof(),
        }
    }

    fn start_at(in self, offset: u64) -> u64 {
        self.start.try_get(add(self.pos, offset)).unwrap_or(self.len)
    }

    fn end_at(in self, offset: u64) -> u64 {
        self.end.try_get(add(self.pos, offset)).unwrap_or(self.len)
    }

    fn at_word(in self, in src: Slice[u8], offset: u64, in word: Str) -> bool {
        let lower = self.nth_kind(offset) == k_lower();
        lower && is_text(in src, self.start_at(offset), self.end_at(offset), in word)
    }

    // `bump`: the token's range; Eof does not advance.
    fn bump(inout self) -> (u64, u64) {
        let start = self.start_at(0);
        let end = self.end_at(0);
        if self.pos < self.kind.len() && self.kind() != k_eof() {
            self.pos = inc(self.pos);
        }
        (start, end)
    }

    fn is_open(in self) -> bool {
        let kind = self.kind();
        kind == k_l_paren() || kind == k_l_bracket() || kind == k_l_brace()
    }

    fn is_close(in self) -> bool {
        let kind = self.kind();
        kind == k_r_paren() || kind == k_r_bracket() || kind == k_r_brace()
    }

    fn skip_to_comma_or_rparen(inout self) {
        let mut depth: u64 = 0;
        loop {
            if self.kind() == k_eof() {
                break;
            }
            if depth == 0 && (self.kind() == k_comma() || self.kind() == k_r_paren()) {
                break;
            }
            if self.is_open() {
                depth = inc(depth);
            } else if self.is_close() {
                if depth > 0 {
                    depth = sub(depth, 1);
                }
            }
            self.bump();
        }
    }

    // Skips a recovered entry and the comma after it.
    fn recover(inout self) {
        self.skip_to_comma_or_rparen();
        if self.kind() == k_comma() {
            self.bump();
        }
    }

    fn put_text(inout self, in src: Slice[u8], start: u64, end: u64) -> (u64, u64) {
        let text_start = self.out.text.len();
        push_range(inout self.out.text, in src, start, end);
        (text_start, self.out.text.len())
    }

    fn text_val(inout self, tag: u8, in src: Slice[u8], start: u64, end: u64) -> Val {
        let (text_start, text_end) = self.put_text(in src, start, end);
        Val {
            tag: tag,
            text_start: text_start,
            text_end: text_end,
            int_value: no_big(),
            bool_value: false
        }
    }

    // `unescape_string` of a String token `src[start..end]`.
    fn string_val(inout self, in src: Slice[u8], start: u64, end: u64) -> Val {
        let mut i = start;
        let mut j = end;
        if j > i && byte(in src, i) == QUOTE {
            i = inc(i);
            if j > i && byte(in src, sub(j, 1)) == QUOTE {
                j = sub(j, 1);
            } else {
                // No closing quote: `strip_suffix` fails, so the raw text
                // stays whole.
                i = start;
            }
        }
        let text_start = self.out.text.len();
        loop {
            if i >= j {
                break;
            }
            let cur_byte = byte(in src, i);
            i = inc(i);
            if cur_byte != BACKSLASH {
                self.out.text.push(cur_byte);
                continue;
            }
            if i >= j {
                self.out.text.push(BACKSLASH);
                break;
            }
            let escape = byte(in src, i);
            i = inc(i);
            if escape == QUOTE {
                self.out.text.push(QUOTE);
            } else if escape == BACKSLASH {
                self.out.text.push(BACKSLASH);
            } else if escape == LOWER_N {
                self.out.text.push(NEWLINE);
            } else if escape == LOWER_R {
                self.out.text.push(CARRIAGE_RETURN);
            } else if escape == LOWER_T {
                self.out.text.push(TAB);
            } else if escape == DIGIT_ZERO {
                self.out.text.push(NUL);
            } else {
                self.out.text.push(BACKSLASH);
                self.out.text.push(escape);
            }
        }
        Val {
            tag: V_STRING,
            text_start: text_start,
            text_end: self.out.text.len(),
            int_value: no_big(),
            bool_value: false
        }
    }

    // `parse_attr_value`: the value up to the next top-level `,` or `)`
    // and its source range.
    fn value(inout self, in src: Slice[u8]) -> (Val, u64, u64) {
        let first = self.pos;
        let start = self.start_at(0);
        let mut depth: u64 = 0;
        loop {
            if self.kind() == k_eof() {
                break;
            }
            if depth == 0 && (self.kind() == k_comma() || self.kind() == k_r_paren()) {
                break;
            }
            if self.is_open() {
                depth = inc(depth);
            } else if self.is_close() {
                if depth > 0 {
                    depth = sub(depth, 1);
                }
            }
            self.bump();
        }
        let token_count = sub(self.pos, first);
        let end = if token_count == 0 {
            start
        } else {
            u64_at(in self.end, sub(self.pos, 1))
        };
        let first_kind = u8_at(in self.kind, first);
        let second_kind = u8_at(in self.kind, inc(first));
        let first_start = u64_at(in self.start, first);
        let first_end = u64_at(in self.end, first);
        let second_start = u64_at(in self.start, inc(first));
        let second_end = u64_at(in self.end, inc(first));
        let parsed = if token_count == 1 && first_kind == k_string() {
            self.string_val(in src, first_start, first_end)
        } else if token_count == 1 && (first_kind == k_true() || first_kind == k_false()) {
            Val {
                tag: V_BOOL,
                text_start: 0,
                text_end: 0,
                int_value: no_big(),
                bool_value: first_kind == k_true()
            }
        } else if token_count == 1 && first_kind == k_int() {
            self.int_val(in src, first_start, first_end, false, start, end)
        } else if token_count == 2 && first_kind == k_minus() && second_kind == k_int() {
            self.int_val(in src, second_start, second_end, true, start, end)
        } else if token_count == 1 && first_kind == k_float() {
            self.text_val(V_FLOAT, in src, first_start, first_end)
        } else if token_count == 2 && first_kind == k_minus() && second_kind == k_float() {
            let text_start = self.out.text.len();
            self.out.text.push(HYPHEN);
            push_range(inout self.out.text, in src, second_start, second_end);
            Val {
                tag: V_FLOAT,
                text_start: text_start,
                text_end: self.out.text.len(),
                int_value: no_big(),
                bool_value: false
            }
        } else if token_count == 1 && (first_kind == k_lower() || first_kind == k_upper()) {
            self.text_val(V_IDENT, in src, first_start, first_end)
        } else {
            let raw_start = trim_start(in src, start, end);
            let raw_end = trim_end(in src, raw_start, end);
            self.text_val(V_RAW, in src, raw_start, raw_end)
        };
        (parsed, start, end)
    }

    fn int_val(
        inout self,
        in src: Slice[u8],
        int_start: u64,
        int_end: u64,
        neg: bool,
        start: u64,
        end: u64
    ) -> Val {
        let parsed = parse_int(in src, int_start, int_end, neg);
        if parsed.ok {
            Val { tag: V_INT, text_start: 0, text_end: 0, int_value: parsed, bool_value: false }
        } else {
            self.text_val(V_RAW, in src, start, end)
        }
    }

    fn opt_str(in self, value: Val) -> OptText {
        if value.tag == V_STRING || value.tag == V_IDENT {
            OptText { has: true, text_start: value.text_start, text_end: value.text_end }
        } else {
            no_text()
        }
    }

    fn opt_u64(in self, value: Val) -> OptNum {
        if value.tag != V_INT {
            return no_num();
        }
        let (ok, number) = as_u64(value.int_value);
        OptNum { has: ok, value: number }
    }

    // `apply_test_kv`: an invalid value leaves the field as it was (and
    // the Rust parser reports a diagnostic nothing reads).
    fn apply(
        inout self,
        inout attr: TestAttr,
        in src: Slice[u8],
        key_start: u64,
        key_end: u64,
        value: Val
    ) {
        if is_text(in src, key_start, key_end, in "expect_error") {
            let opt_text = self.opt_str(value);
            if opt_text.has {
                attr.expect_error = opt_text;
            }
        } else if is_text(in src, key_start, key_end, in "primary") {
            let opt_text = self.opt_str(value);
            if opt_text.has {
                attr.primary = opt_text;
            }
        } else if is_text(in src, key_start, key_end, in "related") {
            let opt_text = self.opt_str(value);
            if opt_text.has {
                attr.related = opt_text;
            }
        } else if is_text(in src, key_start, key_end, in "message") {
            let opt_text = self.opt_str(value);
            if opt_text.has {
                attr.message = opt_text;
            }
        } else if is_text(in src, key_start, key_end, in "span") {
            let opt_text = self.opt_str(value);
            if opt_text.has {
                attr.expected_span = opt_text;
            }
        } else if is_text(in src, key_start, key_end, in "cases") {
            let opt_num = self.opt_u64(value);
            if opt_num.has {
                attr.cases = opt_num;
            }
        } else if is_text(in src, key_start, key_end, in "sim_schedules") {
            let opt_num = self.opt_u64(value);
            if opt_num.has {
                attr.sim_schedules = opt_num;
            }
        } else if is_text(in src, key_start, key_end, in "fault_profile") {
            let opt_text = self.opt_str(value);
            if opt_text.has {
                attr.fault_profile = opt_text;
            }
        } else if is_text(in src, key_start, key_end, in "max_stack") {
            let opt_num = self.opt_u64(value);
            if opt_num.has {
                attr.max_stack = opt_num;
            }
        } else if is_text(in src, key_start, key_end, in "max_cycles") {
            let opt_num = self.opt_u64(value);
            if opt_num.has {
                attr.max_cycles = opt_num;
            }
        } else if is_text(in src, key_start, key_end, in "zero_alloc") {
            if value.tag == V_BOOL {
                attr.zero_alloc_has = true;
                attr.zero_alloc = value.bool_value;
            }
        }
    }

    fn is_name(in self) -> bool {
        self.kind() == k_lower() || self.kind() == k_upper()
    }

    // `parse_test_attr`, at `@`.
    fn test_attr(inout self, in src: Slice[u8]) -> TestAttr {
        let (at_start, at_end) = self.bump();
        let (word_start, word_end) = self.bump();
        let mut attr = test_attr_new(at_start, word_end);
        if self.kind() != k_l_paren() {
            return attr;
        }
        self.bump();
        loop {
            if self.kind() == k_r_paren() || self.kind() == k_eof() {
                break;
            }
            if !self.is_name() {
                self.recover();
                continue;
            }
            let (key_start, key_end) = self.bump();
            if self.kind() != k_eq() {
                self.recover();
                continue;
            }
            self.bump();
            let (value, value_start, value_end) = self.value(in src);
            self.apply(inout attr, in src, key_start, key_end, value);
            if self.kind() == k_comma() {
                self.bump();
            } else if self.kind() != k_r_paren() {
                self.recover();
            }
        }
        if self.kind() == k_r_paren() {
            let (tok_start, tok_end) = self.bump();
            attr.end = tok_end;
        }
        attr
    }

    // `parse_test_case_attr`, at `@`.
    fn test_case_attr(inout self, in src: Slice[u8]) -> CaseAttr {
        let (at_start, at_end) = self.bump();
        let (word_start, word_end) = self.bump();
        let first_arg = self.out.args.len();
        let mut end = word_end;
        if self.kind() != k_l_paren() {
            return CaseAttr { first_arg: first_arg, arg_count: 0, start: at_start, end: end };
        }
        self.bump();
        loop {
            if self.kind() == k_r_paren() || self.kind() == k_eof() {
                break;
            }
            let arg_start = self.start_at(0);
            let named = self.is_name() && self.nth_kind(1) == k_eq();
            let mut name_start: u64 = 0;
            let mut name_end: u64 = 0;
            if named {
                let (tok_start, tok_end) = self.bump();
                name_start = tok_start;
                name_end = tok_end;
                self.bump();
            }
            let (value, value_start, value_end) = self.value(in src);
            self.out.args.push(Arg {
                has_name: named,
                name_start: name_start,
                name_end: name_end,
                value: value,
                start: arg_start,
                end: value_end
            });
            if self.kind() == k_comma() {
                self.bump();
            } else if self.kind() != k_r_paren() {
                self.recover();
            }
        }
        if self.kind() == k_r_paren() {
            let (tok_start, tok_end) = self.bump();
            end = tok_end;
        }
        CaseAttr {
            first_arg: first_arg,
            arg_count: sub(self.out.args.len(), first_arg),
            start: at_start,
            end: end
        }
    }

    // `extract_all`.
    fn extract(inout self, in src: Slice[u8]) {
        let mut brace_depth: u64 = 0;
        let mut test_block = false;
        let mut has_test = false;
        let mut test = test_attr_new(0, 0);
        loop {
            if self.kind() == k_eof() {
                break;
            }
            if brace_depth > 0 {
                if self.kind() == k_l_brace() {
                    brace_depth = inc(brace_depth);
                } else if self.kind() == k_r_brace() {
                    brace_depth = sub(brace_depth, 1);
                }
                self.bump();
                continue;
            }
            if !test_block
                && self.at_word(in src, 0, in "test")
                && self.nth_kind(1) == k_l_brace()
            {
                has_test = false;
                self.pending.clear();
                self.bump();
                self.bump();
                test_block = true;
                continue;
            }
            if test_block && self.kind() == k_r_brace() {
                has_test = false;
                self.pending.clear();
                self.bump();
                test_block = false;
                continue;
            }
            if self.kind() == k_at() && self.at_word(in src, 1, in "test") {
                test = self.test_attr(in src);
                has_test = true;
                continue;
            }
            if self.kind() == k_at() && self.at_word(in src, 1, in "test_case") {
                let case_attr = self.test_case_attr(in src);
                self.pending.push(case_attr);
                continue;
            }
            if self.kind() == k_at() && self.at_word(in src, 1, in "fip") {
                self.bump();
                self.bump();
                continue;
            }
            if self.at_word(in src, 0, in "pub") {
                self.bump();
                continue;
            }
            if self.kind() == k_fn() {
                self.bump();
                if self.is_name() {
                    let (name_start, name_end) = self.bump();
                    if has_test || self.pending.len() > 0 {
                        let case_start = self.out.cases.len();
                        let case_count = self.pending.len();
                        for i in 0..case_count {
                            match self.pending.try_get(i) {
                                Option::Some(case_attr) => self.out.cases.push(case_attr),
                                Option::None => {},
                            }
                        }
                        self.out.fns.push(FnAttrs {
                            name_start: name_start,
                            name_end: name_end,
                            has_test: has_test,
                            test: test,
                            case_start: case_start,
                            case_count: case_count
                        });
                    }
                }
                has_test = false;
                self.pending.clear();
                continue;
            }
            has_test = false;
            self.pending.clear();
            if self.kind() == k_l_brace() {
                brace_depth = inc(brace_depth);
            }
            self.bump();
        }
    }
}

// `extract_test_attrs(source)` over the whole token stream of `src`
// (kinds and ranges, trivia included), which discovery lexes once.
pub fn extract_test_attrs(
    in src: Slice[u8],
    in token_kind: ChunkSeq[u8],
    in token_start: ChunkSeq[u64],
    in token_end: ChunkSeq[u64]
) -> Attrs {
    let n = token_kind.len();
    let mut kind = ChunkSeq::with_capacity[u8](n);
    let mut start = ChunkSeq::with_capacity[u64](n);
    let mut end = ChunkSeq::with_capacity[u64](n);
    for i in 0..n {
        let cur_kind = u8_at(in token_kind, i);
        if !trivia_kind(cur_kind) {
            kind.push(cur_kind);
            start.push(u64_at(in token_start, i));
            end.push(u64_at(in token_end, i));
        }
    }
    let mut stream = Stream {
        kind: kind,
        start: start,
        end: end,
        pos: 0,
        len: src.len(),
        out: Attrs {
            text: ChunkSeq::new[u8](),
            args: ChunkSeq::new[Arg](),
            cases: ChunkSeq::new[CaseAttr](),
            fns: ChunkSeq::new[FnAttrs]()
        },
        pending: ChunkSeq::new[CaseAttr]()
    };
    stream.extract(in src);
    stream.out
}
