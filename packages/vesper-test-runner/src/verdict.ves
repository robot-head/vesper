// What `vesper test --doc` decides about a file's examples without running
// them: `rust_wrappers` and `rust_verdict` of src/doctest_verdict.rs.
//
// `wrappers`: each example's private wrapper `__vesper_doctest_{index}`,
// lengthened with `_` until it collides with no reserved name (the base
// functions, every `entry=`, every identifier token of every example and
// every earlier wrapper), at most 128 bytes. Input words: the function
// count and names, the example count and per example the entry (0, or 1
// and the name), the line count and the lines. Result words: 0, the count
// and the names, or 1 and the error.
//
// `verdict`: an example's line and column, its diagnostics placed in the
// documented file, and whether checking alone settles it. Input words: the
// source, the fence offset, the line count and each (offset, length), the
// snippet and code starts, the segment count and each (start, end), the
// error count and each (code, message, start, end), the expected code (0,
// or 1 and the code) and whether the snippet defines its entry. Result
// words: the line, the column, the diagnostic count and each (code,
// message, start, end, line, column), and the decision (0, or 1, passed
// and the message) (tests/common/doctest_verdict_words.rs).

use @vesper-std/intern::{Interner, interner_new};
use @vesper/front::kinds::{k_lower, k_upper};
use self::discover::{toks};
use self::util::{
    Reader, add, inc, push_decimal, push_range, put_buf, put_text, same, sub, u8_at, u64_at
};

// `reserved.insert(text)`: whether `text` was new.
fn reserve(inout names: Interner, in text: Slice[u8]) -> bool {
    match names.lookup_view(in text) {
        Option::Some(s) => false,
        Option::None => {
            let owned = match String::from_utf8(in text) {
                Option::Some(decoded) => decoded,
                Option::None => String::new(),
            };
            let sym = names.intern(in owned.as_str());
            true
        },
    }
}

fn reserve_range(inout names: Interner, in bytes: Slice[u8], start: u64, end: u64) -> bool {
    reserve(inout names, in bytes[start..end])
}

fn error_text(in text: Str) -> ChunkSeq[u64] {
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    out.push(1);
    let message_bytes = text.as_bytes();
    put_text(inout out, in message_bytes, 0, message_bytes.len());
    out
}

// `rust_wrappers` over the input words.
pub fn wrappers(in input: Slice[u8]) -> ChunkSeq[u64] {
    let mut reader = Reader { pos: 0 };
    let mut names = interner_new();
    let fn_count = reader.word(in input);
    for i in 0..fn_count {
        let (start, end) = reader.text(in input);
        let fresh = reserve_range(inout names, in input, start, end);
    }
    let example_count = reader.word(in input);
    let mut raw: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for example in 0..example_count {
        if reader.word(in input) != 0 {
            let (start, end) = reader.text(in input);
            let fresh = reserve_range(inout names, in input, start, end);
        }
        raw.clear();
        let line_count = reader.word(in input);
        for i in 0..line_count {
            let (start, end) = reader.text(in input);
            push_range(inout raw, in input, start, end);
            raw.push(10);
        }
        let tokens = toks(in raw.as_slice());
        let n = tokens.kind.len();
        for k in 0..n {
            let kind = u8_at(in tokens.kind, k);
            if kind == k_lower() || kind == k_upper() {
                let fresh = reserve_range(
                    inout names,
                    in raw.as_slice(),
                    u64_at(in tokens.start, k),
                    u64_at(in tokens.end, k)
                );
            }
        }
    }
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    out.push(0);
    out.push(example_count);
    let mut wrapper: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for example in 0..example_count {
        wrapper.clear();
        wrapper.extend(in "__vesper_doctest_".as_bytes());
        push_decimal(inout wrapper, example);
        loop {
            if reserve(inout names, in wrapper.as_slice()) {
                break;
            }
            wrapper.push(95);
            if wrapper.len() > 128 {
                return error_text(in "doctest private wrapper name limit");
            }
        }
        put_buf(inout out, in wrapper);
    }
    out
}

// The number of `\n` bytes in `bytes[from..end]`, eight bytes at a time.
fn newlines(in bytes: Slice[u8], from: u64, end: u64) -> u64 {
    let ones: u64 = 0x0101010101010101;
    let low: u64 = 0x7f7f7f7f7f7f7f7f;
    let high: u64 = 0x8080808080808080;
    let newline_bytes: u64 = 0x0a0a0a0a0a0a0a0a;
    let mut count: u64 = 0;
    let mut i = from;
    loop {
        if add(i, 8) > end {
            break;
        }
        let chunk = bytes.try_read_u64_le(i).unwrap_or(0);
        let masked = chunk ^ newline_bytes;
        // A byte of `masked` is zero exactly where `chunk` holds `\n`.
        let zero_test = (wrapping_add(masked & low, low) | masked) ^ 0xffffffffffffffff;
        let zero_bits = zero_test & high;
        if zero_bits != 0 {
            count = add(
                count,
                wrapping_shr_u64(wrapping_mul(wrapping_shr_u64(zero_bits, 7), ones), 56)
            );
        }
        i = add(i, 8);
    }
    loop {
        if i >= end {
            break;
        }
        let cur_byte = bytes.try_get(i).unwrap_or(0);
        if cur_byte == 10 {
            count = inc(count);
        }
        i = inc(i);
    }
    count
}

// For byte `offset` (`doctest_verdict::location`): the start of its line
// and its 1-based column (in characters).
fn line_start(in bytes: Slice[u8], offset: u64) -> (u64, u64) {
    let n = bytes.len();
    let mut end = offset;
    if end > n {
        end = n;
    }
    loop {
        if end == 0 || end >= n {
            break;
        }
        let cur_byte = bytes.try_get(end).unwrap_or(0);
        if cur_byte < 128 || cur_byte >= 192 {
            break;
        }
        end = sub(end, 1);
    }
    let mut column: u64 = 1;
    let mut begin = end;
    loop {
        if begin == 0 {
            break;
        }
        let cur_byte = bytes.try_get(sub(begin, 1)).unwrap_or(0);
        if cur_byte == 10 {
            break;
        }
        if cur_byte < 128 || cur_byte >= 192 {
            column = inc(column);
        }
        begin = sub(begin, 1);
    }
    (begin, column)
}

// The (line, column) of every offset of `queries`, with one pass over `bytes`:
// the queries in line-start order, each counting the newlines since the
// previous one.
fn place_all(in bytes: Slice[u8], in queries: ChunkSeq[u64]) -> ChunkSeq[u64] {
    let n = queries.len();
    let mut starts: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut order: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for i in 0..n {
        let (begin, column) = line_start(in bytes, u64_at(in queries, i));
        starts.push(begin);
        out.push(0);
        out.push(column);
        // Insertion into `order`, by line start.
        order.push(i);
        let mut k = i;
        loop {
            if k == 0 {
                break;
            }
            let prev = u64_at(in order, sub(k, 1));
            if u64_at(in starts, prev) <= begin {
                break;
            }
            let set = order.try_set(k, prev);
            k = sub(k, 1);
        }
        let set2 = order.try_set(k, i);
    }
    let mut last_begin: u64 = 0;
    let mut lines: u64 = 1;
    for k in 0..n {
        let i = u64_at(in order, k);
        let begin = u64_at(in starts, i);
        lines = add(lines, newlines(in bytes, last_begin, begin));
        last_begin = begin;
        let set = out.try_set(wrapping_mul(i, 2), lines);
    }
    out
}

// `map_offset`: generated offset `gen_offset` in the documented file.
fn map_offset(
    in segs: ChunkSeq[u64],
    in lines: ChunkSeq[u64],
    offset: u64,
    code_start: u64,
    gen_offset: u64
) -> u64 {
    let n = segs.len() / 2;
    for i in 0..n {
        let seg_start = u64_at(in segs, wrapping_mul(i, 2));
        let seg_end = u64_at(in segs, inc(wrapping_mul(i, 2)));
        if gen_offset >= seg_start && gen_offset <= seg_end {
            return add(u64_at(in lines, wrapping_mul(i, 2)), sub(gen_offset, seg_start));
        }
    }
    let line_count = lines.len() / 2;
    if line_count == 0 {
        return offset;
    }
    if gen_offset < code_start {
        u64_at(in lines, 0)
    } else {
        let last_at = wrapping_mul(sub(line_count, 1), 2);
        add(u64_at(in lines, last_at), u64_at(in lines, inc(last_at)))
    }
}

// `rust_verdict` over the input words.
pub fn verdict(in input: Slice[u8]) -> ChunkSeq[u64] {
    let mut reader = Reader { pos: 0 };
    let (src_start, src_end) = reader.text(in input);
    let offset = reader.word(in input);
    let line_count = reader.word(in input);
    let mut lines: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for i in 0..line_count {
        lines.push(reader.word(in input));
        lines.push(reader.word(in input));
    }
    let snippet_start = reader.word(in input);
    let code_start = reader.word(in input);
    let seg_count = reader.word(in input);
    let mut segs: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for i in 0..seg_count {
        segs.push(reader.word(in input));
        segs.push(reader.word(in input));
    }
    // Per error: code start, code end, message start, message end, start, end.
    let err_count = reader.word(in input);
    let mut errs: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for i in 0..err_count {
        let (err_code_start, err_code_end) = reader.text(in input);
        let (msg_start, msg_end) = reader.text(in input);
        errs.push(err_code_start);
        errs.push(err_code_end);
        errs.push(msg_start);
        errs.push(msg_end);
        errs.push(reader.word(in input));
        errs.push(reader.word(in input));
    }
    let has_expected = reader.word(in input) != 0;
    let mut expected_start: u64 = 0;
    let mut expected_end: u64 = 0;
    if has_expected {
        let (text_start, text_end) = reader.text(in input);
        expected_start = text_start;
        expected_end = text_end;
    }
    let own_entry = reader.word(in input) != 0;
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    // The fence offset and each diagnostic's placed start, placed at once.
    let mut queries: ChunkSeq[u64] = ChunkSeq::new[u64]();
    queries.push(offset);
    let mut placed: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for i in 0..err_count {
        let err_at = wrapping_mul(i, 6);
        let start = u64_at(in errs, add(err_at, 4));
        let end = u64_at(in errs, add(err_at, 5));
        let (placed_start, placed_end) = if start < snippet_start {
            (start, end)
        } else {
            (
                map_offset(in segs, in lines, offset, code_start, start),
                map_offset(in segs, in lines, offset, code_start, end)
            )
        };
        placed.push(placed_start);
        placed.push(placed_end);
        queries.push(placed_start);
    }
    let line_cols = place_all(in input[src_start..src_end], in queries);
    out.push(u64_at(in line_cols, 0));
    out.push(u64_at(in line_cols, 1));
    out.push(err_count);
    let mut local_only = true;
    let mut all_expected = true;
    for i in 0..err_count {
        let err_at = wrapping_mul(i, 6);
        let err_code_start = u64_at(in errs, err_at);
        let err_code_end = u64_at(in errs, add(err_at, 1));
        let msg_start = u64_at(in errs, add(err_at, 2));
        let msg_end = u64_at(in errs, add(err_at, 3));
        let start = u64_at(in errs, add(err_at, 4));
        let end = u64_at(in errs, add(err_at, 5));
        let mut inside = false;
        for k in 0..seg_count {
            let seg_start = u64_at(in segs, wrapping_mul(k, 2));
            let seg_end = u64_at(in segs, inc(wrapping_mul(k, 2)));
            if start >= seg_start && start <= seg_end {
                inside = true;
                break;
            }
        }
        if !inside {
            local_only = false;
        }
        if !has_expected
            || !same(
                in input,
                err_code_start,
                err_code_end,
                in input,
                expected_start,
                expected_end
            ) {
            all_expected = false;
        }
        let placed_start = u64_at(in placed, wrapping_mul(i, 2));
        let placed_end = u64_at(in placed, inc(wrapping_mul(i, 2)));
        let placed_line = u64_at(in line_cols, wrapping_mul(inc(i), 2));
        let placed_column = u64_at(in line_cols, inc(wrapping_mul(inc(i), 2)));
        put_text(inout out, in input, err_code_start, err_code_end);
        put_text(inout out, in input, msg_start, msg_end);
        out.push(placed_start);
        out.push(placed_end);
        out.push(placed_line);
        out.push(placed_column);
    }
    if has_expected {
        let passed = err_count != 0 && local_only && all_expected;
        out.push(1);
        if passed {
            out.push(1);
            let message_bytes = "matched exact diagnostic code".as_bytes();
            put_text(inout out, in message_bytes, 0, message_bytes.len());
        } else {
            out.push(0);
            let message_bytes = "expected exact snippet diagnostic code; unrelated/base errors cannot satisfy compile_fail"
                .as_bytes();
            put_text(inout out, in message_bytes, 0, message_bytes.len());
        }
    } else if err_count != 0 {
        out.push(1);
        out.push(0);
        let message_bytes = "positive example failed full checking".as_bytes();
        put_text(inout out, in message_bytes, 0, message_bytes.len());
    } else if !own_entry {
        out.push(1);
        out.push(0);
        let message_bytes = "positive entry must be defined by this snippet, not inherited from the base package"
            .as_bytes();
        put_text(inout out, in message_bytes, 0, message_bytes.len());
    } else {
        out.push(0);
    }
    out
}
