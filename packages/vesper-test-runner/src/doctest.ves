// Doctest fence extraction and the token preflight of `vesper test --doc`:
// `rust_extract` and `rust_preflight` of src/doctest_extract.rs, with
// `SimSpec::parse` of crates/vesper-doc/src/sim.rs for `sim(...)` fences.
//
// The input and result words are those of
// tests/common/doctest_extract_words.rs (util.ves `Reader`, `put_text`).
// An error result is the status word 1 and the message; an ok result is
// the status word 0 and the payload.

use @vesper/front::lex::{lex_raw, token_end};
use @vesper/front::diag::{diags_new};
use @vesper/front::kinds::{
    k_affine, k_block_comment, k_comment, k_copy, k_effect, k_enum, k_eof, k_fn, k_impl, k_l_brace,
    k_l_bracket, k_l_paren, k_linear, k_lower, k_r_brace, k_r_bracket, k_r_paren, k_semi, k_struct,
    k_whitespace
};
use @vesper/front::util::{w32};
use @vesper-std/bytes::ascii::{
    APOSTROPHE, BACKTICK, CLOSE_PAREN, COMMA, DIGIT_ZERO, LOWER_A, LOWER_F, LOWER_X, LOWER_Z,
    OPEN_PAREN, PLUS, SPACE, TILDE, UNDERSCORE, UPPER_A, UPPER_E, UPPER_F, UPPER_Z
};
use self::util::{
    HEX_LETTER_BASE, HEX_PREFIX_BYTES, HEX_UPPER_LETTER_BASE, NOT_A_DIGIT, PAIR_WORDS, Reader,
    STATUS_ERROR, STATUS_OK, add, bit, byte, char_at, inc, is_digit, is_space_char, is_text,
    push_range, put_buf, put_text, starts_with, sub, trim_end, trim_start, u8_at, u64_at
};

// The device bits of a `sim(...)` spec (`Device` of vesper-doc).
pub fn device_clock() -> u64 {
    1
}

pub fn device_net() -> u64 {
    2
}

pub fn device_disk() -> u64 {
    4
}

// The preflight's group stack: three words per open group, the completed
// statement peak two words back from its end.
const GROUP_WORDS: u64 = 3;
const GROUP_PEAK_BACK: u64 = 2;

// The bytes of the `seed=`, `compile_fail(`, `entry=` and `sim(` prefixes,
// of the shortest `sim(..)` attribute, of a diagnostic code (`E0123`), of
// `///` or `//!` and of the `vesper` language tag.
const SEED_PREFIX_BYTES: u64 = 5;
const COMPILE_FAIL_PREFIX_BYTES: u64 = 13;
const ENTRY_PREFIX_BYTES: u64 = 6;
const SIM_PREFIX_BYTES: u64 = 4;
const MIN_SIM_BYTES: u64 = 5;
const DIAGNOSTIC_CODE_BYTES: u64 = 5;
const DOC_COMMENT_PREFIX_BYTES: u64 = 3;
const VESPER_TAG_BYTES: u64 = 6;
// The fewest fence bytes, and the longest `entry=` name.
const MIN_FENCE_WIDTH: u64 = 3;
const MAX_ENTRY_BYTES: u64 = 128;
// The example count's word of the `extract` result, after the status.
const EXAMPLE_COUNT_WORD: u64 = 1;

fn put_error(in msg: ChunkSeq[u8]) -> ChunkSeq[u64] {
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    out.push(STATUS_ERROR);
    put_buf(inout out, in msg);
    out
}

fn error_of(in text: Str) -> ChunkSeq[u64] {
    let mut msg: ChunkSeq[u8] = ChunkSeq::new[u8]();
    msg.extend(in text.as_bytes());
    put_error(in msg)
}

// ---------------------------------------------------------------- preflight

fn is_trivia(kind: u8) -> bool {
    kind == k_whitespace() || kind == k_comment() || kind == k_block_comment() || kind == k_eof()
}

fn is_declaration(kind: u8) -> bool {
    kind == k_fn()
        || kind == k_struct()
        || kind == k_enum()
        || kind == k_effect()
        || kind == k_impl()
}

fn is_item_start(kind: u8) -> bool {
    is_declaration(kind) || kind == k_copy() || kind == k_affine() || kind == k_linear()
}

fn is_contextual_item(in src: Slice[u8], start: u64, end: u64) -> bool {
    is_text(in src, start, end, in "trait")
        || is_text(in src, start, end, in "model")
        || is_text(in src, start, end, in "pub")
}

// `rust_preflight`: input words are the source, `max_tokens`,
// `max_nesting`, `max_segment_tokens` and `max_declarations`.
pub fn preflight(in input: Slice[u8]) -> ChunkSeq[u64] {
    let mut reader = Reader { pos: 0 };
    let (src_start, src_end) = reader.text(in input);
    let max_tokens = reader.word(in input);
    let max_nesting = reader.word(in input);
    let max_segment = reader.word(in input);
    let max_declarations = reader.word(in input);
    let src = input[src_start..src_end];
    let mut diags = diags_new();
    let lexed = lex_raw(in src, inout diags);
    let n = lexed.kind.len();
    let mut count: u64 = 0;
    let mut declarations: u64 = 0;
    // The stack of open groups: (unfinished outer segment, maximum
    // completed statement, opener) as three words per group.
    let mut stack: ChunkSeq[u64] = ChunkSeq::new[u64]();
    // The sum of the stack's outer segments.
    let mut outer_sum: u64 = 0;
    let mut segment: u64 = 0;
    let mut top_item = false;
    for i in 0..n {
        let kind = u8_at(in lexed.kind, i);
        if is_trivia(kind) {
            continue;
        }
        count = inc(count);
        if is_declaration(kind) {
            declarations = inc(declarations);
        }
        if count > max_tokens || declarations > max_declarations {
            return error_of(in "doctest token/declaration limit");
        }
        if stack.len() == 0
            && (is_item_start(kind)
                || kind == k_lower()
                    && is_contextual_item(in src, w32(in lexed.start, i), token_end(in lexed, i)))
        {
            top_item = true;
        }
        let mut completed_item = false;
        if kind == k_l_paren() || kind == k_l_brace() || kind == k_l_bracket() {
            stack.push(segment);
            stack.push(0);
            stack.push(widen_u64(kind));
            outer_sum = add(outer_sum, segment);
            segment = 0;
        } else if kind == k_r_paren() || kind == k_r_brace() || kind == k_r_bracket() {
            let mut outer: u64 = 0;
            let mut peak: u64 = 0;
            let mut opener = widen_u64(kind);
            let depth = stack.len();
            if depth >= GROUP_WORDS {
                outer = u64_at(in stack, sub(depth, GROUP_WORDS));
                peak = u64_at(in stack, sub(depth, GROUP_PEAK_BACK));
                opener = u64_at(in stack, sub(depth, 1));
                stack.truncate(sub(depth, GROUP_WORDS));
                outer_sum = sub(outer_sum, outer);
            }
            let mut inner = segment;
            if peak > inner {
                inner = peak;
            }
            segment = inc(add(outer, inner));
            completed_item = stack.len() == 0
                && top_item
                && opener == widen_u64(k_l_brace())
                && kind == k_r_brace();
        } else if kind == k_semi() {
            let depth = stack.len();
            if depth >= GROUP_WORDS {
                let peak_at = sub(depth, GROUP_PEAK_BACK);
                if segment > u64_at(in stack, peak_at) {
                    let ok = stack.try_set(peak_at, segment);
                }
            }
            segment = 0;
            if depth == 0 {
                top_item = false;
            }
        } else {
            segment = inc(segment);
        }
        let weighted = add(segment, outer_sum);
        if stack.len() / GROUP_WORDS > max_nesting || weighted > max_segment {
            return error_of(in "doctest nesting/expression-segment limit");
        }
        if completed_item {
            segment = 0;
            top_item = false;
        }
    }
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    out.push(STATUS_OK);
    out
}

// ---------------------------------------------------------------- sim specs

// `u64::from_str_radix(text, radix)` of the bytes of `digits` (an optional
// `+` and then at least one digit): (ok, value).
fn parse_u64(in digits: ChunkSeq[u8], start: u64, radix: u64) -> (bool, u64) {
    let n = digits.len();
    let mut i = start;
    if i < n && u8_at(in digits, i) == PLUS {
        i = inc(i);
    }
    if i >= n {
        return (false, 0);
    }
    let mut value: u64 = 0;
    loop {
        if i >= n {
            break;
        }
        let cur_byte = u8_at(in digits, i);
        let mut digit_value: u64 = NOT_A_DIGIT;
        if is_digit(cur_byte) {
            digit_value = sub(widen_u64(cur_byte), widen_u64(DIGIT_ZERO));
        } else if radix == 16 && cur_byte >= LOWER_A && cur_byte <= LOWER_F {
            digit_value = sub(widen_u64(cur_byte), widen_u64(HEX_LETTER_BASE));
        } else if radix == 16 && cur_byte >= UPPER_A && cur_byte <= UPPER_F {
            digit_value = sub(widen_u64(cur_byte), widen_u64(HEX_UPPER_LETTER_BASE));
        }
        if digit_value >= radix {
            return (false, 0);
        }
        match checked_mul_u64(value, radix) {
            Option::Some(checked) => {
                value = checked;
            }
            Option::None => {
                return (false, 0);
            }
        }
        match checked_add_u64(value, digit_value) {
            Option::Some(checked) => {
                value = checked;
            }
            Option::None => {
                return (false, 0);
            }
        }
        i = inc(i);
    }
    (true, value)
}

fn sim_error(inout msg: ChunkSeq[u8], in text: Str) {
    msg.clear();
    msg.extend(in "invalid sim attribute: ".as_bytes());
    msg.extend(in text.as_bytes());
}

fn sim_error_part(
    inout msg: ChunkSeq[u8],
    in head: Str,
    in src: Slice[u8],
    start: u64,
    end: u64,
    in tail: Str
) {
    sim_error(inout msg, in head);
    push_range(inout msg, in src, start, end);
    msg.extend(in tail.as_bytes());
}

// `SimSpec::parse(src[start..end])`: (ok, seed, device bits); the error message
// goes to `msg` (the `SimError` text).
fn parse_sim(in src: Slice[u8], start: u64, end: u64, inout msg: ChunkSeq[u8]) -> (bool, u64, u64) {
    let mut has_seed = false;
    let mut seed: u64 = 0;
    let mut devices: u64 = 0;
    let mut digits: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut part_start = start;
    loop {
        // The next part: up to the next comma.
        let mut part_end = part_start;
        loop {
            if part_end >= end || byte(in src, part_end) == COMMA {
                break;
            }
            part_end = inc(part_end);
        }
        let text_start = trim_start(in src, part_start, part_end);
        let text_end = trim_end(in src, text_start, part_end);
        if starts_with(in src, text_start, text_end, in "seed=") {
            let value_start = add(text_start, SEED_PREFIX_BYTES);
            if has_seed {
                sim_error(inout msg, in "duplicate seed");
                return (false, 0, 0);
            }
            digits.clear();
            for i in value_start..text_end {
                let cur_byte = byte(in src, i);
                if cur_byte != UNDERSCORE {
                    digits.push(cur_byte);
                }
            }
            let hex = digits.len() >= HEX_PREFIX_BYTES
                && u8_at(in digits, 0) == DIGIT_ZERO
                && u8_at(in digits, 1) == LOWER_X;
            let (ok, value) = if hex {
                parse_u64(in digits, HEX_PREFIX_BYTES, 16)
            } else {
                parse_u64(in digits, 0, 10)
            };
            if !ok {
                sim_error_part(
                    inout msg,
                    in "invalid seed '",
                    in src,
                    value_start,
                    text_end,
                    in "'"
                );
                return (false, 0, 0);
            }
            has_seed = true;
            seed = value;
        } else {
            let mut device: u64 = 0;
            if is_text(in src, text_start, text_end, in "clock") {
                device = device_clock();
            } else if is_text(in src, text_start, text_end, in "net") {
                device = device_net();
            } else if is_text(in src, text_start, text_end, in "disk") {
                device = device_disk();
            }
            if device == 0 {
                sim_error_part(
                    inout msg,
                    in "unknown sim attribute '",
                    in src,
                    text_start,
                    text_end,
                    in "' (expected seed=N, clock, net or disk)"
                );
                return (false, 0, 0);
            }
            if devices & device != 0 {
                sim_error_part(
                    inout msg,
                    in "duplicate device '",
                    in src,
                    text_start,
                    text_end,
                    in "'"
                );
                return (false, 0, 0);
            }
            devices = devices | device;
        }
        if part_end >= end {
            break;
        }
        part_start = inc(part_end);
    }
    if !has_seed {
        sim_error(inout msg, in "sim requires a fixed seed=N");
        return (false, 0, 0);
    }
    if devices == 0 {
        sim_error(inout msg, in "sim requires at least one device: clock, net or disk");
        return (false, 0, 0);
    }
    (true, seed, devices)
}

// ------------------------------------------------------------------ fences

// `fence(src[start..end])`: (is a fence, fence byte, width, info start, info end).
fn fence(in src: Slice[u8], start: u64, end: u64) -> (bool, u8, u64, u64, u64) {
    let text_start = trim_start(in src, start, end);
    let text_end = trim_end(in src, text_start, end);
    if text_start >= text_end {
        return (false, 0, 0, 0, 0);
    }
    let first = byte(in src, text_start);
    if first != BACKTICK && first != TILDE {
        return (false, 0, 0, 0, 0);
    }
    let mut i = text_start;
    loop {
        if i >= text_end || byte(in src, i) != first {
            break;
        }
        i = inc(i);
    }
    let count = sub(i, text_start);
    if count < MIN_FENCE_WIDTH {
        return (false, 0, 0, 0, 0);
    }
    let info_start = trim_start(in src, i, text_end);
    let info_end = trim_end(in src, info_start, text_end);
    (true, first, count, info_start, info_end)
}

// One parsed fence's attributes: `compile_fail`, `entry` and `sim`.
pub struct Attrs {
    has_expected: bool,
    expected_start: u64,
    expected_end: u64,
    has_entry: bool,
    entry_start: u64,
    entry_end: u64,
    has_sim: bool,
    seed: u64,
    devices: u64,
}

fn attrs_none() -> Attrs {
    Attrs {
        has_expected: false,
        expected_start: 0,
        expected_end: 0,
        has_entry: false,
        entry_start: 0,
        entry_end: 0,
        has_sim: false,
        seed: 0,
        devices: 0
    }
}

fn is_entry_byte(c: u8) -> bool {
    is_digit(c)
        || (c >= UPPER_A && c <= UPPER_Z)
        || (c >= LOWER_A && c <= LOWER_Z)
        || c == UNDERSCORE
}

// `attributes(src[start..end])` (with `attribute_parts`): false and the message
// in `msg` on an error.
fn attributes(
    in src: Slice[u8],
    start: u64,
    end: u64,
    inout attrs: Attrs,
    inout msg: ChunkSeq[u8]
) -> bool {
    // attribute_parts: the balance check covers the whole info first.
    let mut depth: u64 = 0;
    for i in start..end {
        let cur_byte = byte(in src, i);
        if cur_byte == OPEN_PAREN {
            depth = inc(depth);
        } else if cur_byte == CLOSE_PAREN {
            if depth == 0 {
                msg.clear();
                msg.extend(in "unbalanced doctest fence attribute".as_bytes());
                return false;
            }
            depth = sub(depth, 1);
        }
    }
    if depth != 0 {
        msg.clear();
        msg.extend(in "unbalanced doctest fence attribute".as_bytes());
        return false;
    }
    let mut part_start = start;
    let mut first = true;
    depth = 0;
    loop {
        let mut part_end = part_start;
        loop {
            if part_end >= end {
                break;
            }
            let cur_byte = byte(in src, part_end);
            if cur_byte == OPEN_PAREN {
                depth = inc(depth);
            } else if cur_byte == CLOSE_PAREN {
                depth = sub(depth, 1);
            } else if cur_byte == COMMA && depth == 0 {
                break;
            }
            part_end = inc(part_end);
        }
        if !first {
            let text_start = trim_start(in src, part_start, part_end);
            let text_end = trim_end(in src, text_start, part_end);
            if !part(in src, text_start, text_end, inout attrs, inout msg) {
                return false;
            }
        }
        first = false;
        if part_end >= end {
            break;
        }
        part_start = inc(part_end);
    }
    if attrs.has_expected && attrs.has_entry {
        msg.clear();
        msg.extend(in "compile_fail doctest cannot request execution entry".as_bytes());
        return false;
    }
    if attrs.has_expected && attrs.has_sim {
        msg.clear();
        msg.extend(in "compile_fail doctest cannot request simulated execution".as_bytes());
        return false;
    }
    true
}

// Whether `src[start..end]` is `prefix` + something + `)`.
fn wrapped(in src: Slice[u8], start: u64, end: u64, in prefix: Str) -> bool {
    let prefix_len = prefix.as_bytes().len();
    sub(end, start) > prefix_len
        && starts_with(in src, start, end, in prefix)
        && byte(in src, sub(end, 1)) == CLOSE_PAREN
}

// One attribute of `attributes`.
fn part(
    in src: Slice[u8],
    start: u64,
    end: u64,
    inout attrs: Attrs,
    inout msg: ChunkSeq[u8]
) -> bool {
    if wrapped(in src, start, end, in "compile_fail(") {
        let code_start = add(start, COMPILE_FAIL_PREFIX_BYTES);
        let code_end = sub(end, 1);
        let mut good = !attrs.has_expected
            && sub(code_end, code_start) == DIAGNOSTIC_CODE_BYTES
            && byte(in src, code_start) == UPPER_E;
        if good {
            for i in inc(code_start)..code_end {
                if !is_digit(byte(in src, i)) {
                    good = false;
                }
            }
        }
        if !good {
            msg.clear();
            msg.extend(in "invalid doctest diagnostic code".as_bytes());
            return false;
        }
        attrs.has_expected = true;
        attrs.expected_start = code_start;
        attrs.expected_end = code_end;
        return true;
    }
    if starts_with(in src, start, end, in "entry=") {
        let entry_start = add(start, ENTRY_PREFIX_BYTES);
        let len = sub(end, entry_start);
        let mut good = !attrs.has_entry
            && len > 0
            && len <= MAX_ENTRY_BYTES
            && !is_digit(byte(in src, entry_start));
        if good {
            for i in entry_start..end {
                if !is_entry_byte(byte(in src, i)) {
                    good = false;
                }
            }
        }
        if !good {
            msg.clear();
            msg.extend(in "invalid doctest entry".as_bytes());
            return false;
        }
        attrs.has_entry = true;
        attrs.entry_start = entry_start;
        attrs.entry_end = end;
        return true;
    }
    if sub(end, start) >= MIN_SIM_BYTES
        && starts_with(in src, start, end, in "sim(")
        && byte(in src, sub(end, 1)) == CLOSE_PAREN
    {
        if attrs.has_sim {
            msg.clear();
            msg.extend(in "duplicate sim doctest attribute".as_bytes());
            return false;
        }
        let (ok, seed, devices) = parse_sim(
            in src,
            add(start, SIM_PREFIX_BYTES),
            sub(end, 1),
            inout msg
        );
        if !ok {
            return false;
        }
        attrs.has_sim = true;
        attrs.seed = seed;
        attrs.devices = devices;
        return true;
    }
    msg.clear();
    msg.extend(in "unsupported Vesper doctest fence attribute '".as_bytes());
    push_range(inout msg, in src, start, end);
    msg.push(APOSTROPHE);
    false
}

// --------------------------------------------------------------- extraction

// Whether `src[start..end]` is all whitespace characters.
fn all_space(in src: Slice[u8], start: u64, end: u64) -> bool {
    trim_start(in src, start, end) >= end
}

fn is_doc_comment(in src: Slice[u8], start: u64, end: u64) -> bool {
    starts_with(in src, start, end, in "///") && !starts_with(in src, start, end, in "////")
        || starts_with(in src, start, end, in "//!")
}

// The result words of one finished example, appended to `out`: offset,
// expected (flag, text), entry (flag, text), sim (flag, seed, devices) and
// the (offset, end) of each line in `lines`.
fn put_example(
    inout out: ChunkSeq[u64],
    in src: Slice[u8],
    offset: u64,
    in attrs: Attrs,
    in lines: ChunkSeq[u64]
) {
    out.push(offset);
    out.push(bit(attrs.has_expected));
    put_text(inout out, in src, attrs.expected_start, attrs.expected_end);
    out.push(bit(attrs.has_entry));
    put_text(inout out, in src, attrs.entry_start, attrs.entry_end);
    out.push(bit(attrs.has_sim));
    out.push(attrs.seed);
    out.push(attrs.devices);
    let line_count = lines.len() / PAIR_WORDS;
    out.push(line_count);
    for i in 0..wrapping_mul(line_count, PAIR_WORDS) {
        out.push(u64_at(in lines, i));
    }
}

// `rust_extract`: input words are the source, `max_snippet_bytes` and
// `max_examples`; an ok result is the example count and each example's
// words (`put_example`).
pub fn extract(in input: Slice[u8]) -> ChunkSeq[u64] {
    let mut reader = Reader { pos: 0 };
    let (src_start, src_end) = reader.text(in input);
    let max_snippet = reader.word(in input);
    let max_examples = reader.word(in input);
    let src = input[src_start..src_end];
    let mut diags = diags_new();
    let lexed = lex_raw(in src, inout diags);
    let n = lexed.kind.len();
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    out.push(STATUS_OK);
    out.push(0);
    let mut examples: u64 = 0;
    let mut msg: ChunkSeq[u8] = ChunkSeq::new[u8]();
    // The end of the previous doc comment of the current block.
    let mut in_block = false;
    let mut previous: u64 = 0;
    // The open fence of the current block.
    let mut active = false;
    let mut open_kind: u8 = 0;
    let mut open_width: u64 = 0;
    let mut has_example = false;
    let mut offset: u64 = 0;
    let mut attrs = attrs_none();
    let mut lines: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut code_bytes: u64 = 0;
    for i in 0..n {
        if u8_at(in lexed.kind, i) != k_comment() {
            continue;
        }
        let comment_start = w32(in lexed.start, i);
        let comment_end = token_end(in lexed, i);
        if !is_doc_comment(in src, comment_start, comment_end) {
            in_block = false;
            continue;
        }
        let mut line_start = add(comment_start, DOC_COMMENT_PREFIX_BYTES);
        if line_start < comment_end && byte(in src, line_start) == SPACE {
            line_start = inc(line_start);
        }
        if !in_block || !all_space(in src, previous, comment_start) {
            // A new block: the previous one must not end inside an example.
            if active && has_example {
                return error_of(in "unterminated Vesper doctest fence");
            }
            active = false;
        }
        in_block = true;
        previous = comment_end;
        let (is_fence, fence_kind, fence_width, info_start, info_end) = fence(
            in src,
            line_start,
            comment_end
        );
        if active {
            if is_fence
                && fence_kind == open_kind
                && fence_width >= open_width
                && info_start >= info_end
            {
                if has_example {
                    put_example(inout out, in src, offset, in attrs, in lines);
                    examples = inc(examples);
                    if examples > max_examples {
                        return error_of(in "doctest example limit");
                    }
                }
                active = false;
                continue;
            }
            if has_example {
                code_bytes = add(code_bytes, inc(sub(comment_end, line_start)));
                if code_bytes > max_snippet {
                    return error_of(in "doctest snippet byte limit");
                }
                lines.push(line_start);
                lines.push(comment_end);
            }
        } else if is_fence {
            // The language: the info up to its first comma, trimmed.
            let mut lang_limit = info_start;
            loop {
                if lang_limit >= info_end || byte(in src, lang_limit) == COMMA {
                    break;
                }
                lang_limit = inc(lang_limit);
            }
            let lang_start = trim_start(in src, info_start, lang_limit);
            let lang_end = trim_end(in src, lang_start, lang_limit);
            let vesper = is_text(in src, lang_start, lang_end, in "vesper");
            if !vesper && starts_with(in src, lang_start, lang_end, in "vesper") {
                let (code_point, char_len) = char_at(in src, add(lang_start, VESPER_TAG_BYTES));
                if is_space_char(code_point) {
                    return error_of(
                        in "unsupported Vesper doctest fence metadata (use comma-separated attributes)"
                    );
                }
            }
            has_example = vesper;
            if vesper {
                attrs = attrs_none();
                if !attributes(in src, info_start, info_end, inout attrs, inout msg) {
                    return put_error(in msg);
                }
                offset = line_start;
                lines.clear();
            }
            code_bytes = 0;
            active = true;
            open_kind = fence_kind;
            open_width = fence_width;
        }
    }
    if active && has_example {
        return error_of(in "unterminated Vesper doctest fence");
    }
    let ok = out.try_set(EXAMPLE_COUNT_WORD, examples);
    out
}
