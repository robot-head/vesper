// Mutation sites of `vesper test --mutate`: `rust_collect` of
// src/test_mutants.rs (`collect_source_mutants`, `collect_mutants_in_fn`
// and `find_operator_span`) over @vesper/ast's AST of the source.
//
// Input words: the source and the test names. Result words: the site
// count and, per site sorted by (start, end, replacement), the function's
// name, start, end, the original text and the replacement
// (tests/common/test_mutants_words.rs).

use @vesper/ast::{
    ArgNode, Ast, ClauseNode, ConfNode, FnNode, ImplNode, ItemNode, StmtNode, expr_at, list_at,
    list_len, lit_at, none
};
use @vesper/ast::lower::{lower_source};
use @vesper-std/arena::{idx_from_raw};
use @vesper-std/intern::{symbol_from_id};
use @vesper/front::kinds::{k_block_comment, k_comment, k_whitespace};
use self::discover::{Toks, case_marker, is_test_marker, preceding_comments, toks};
use self::ast_kinds::{
    EXPR_ASSIGN, EXPR_BINARY, EXPR_BLOCK, EXPR_BREAK, EXPR_CALL, EXPR_CLOSURE, EXPR_FIELD, EXPR_FOR,
    EXPR_HANDLE, EXPR_IF, EXPR_INDEX, EXPR_LITERAL, EXPR_LOOP, EXPR_MATCH, EXPR_RANGE, EXPR_RETURN,
    EXPR_STRUCT, EXPR_TRY, EXPR_TUPLE, EXPR_UNARY, ITEM_CONFORMANCE, ITEM_FUNCTION, ITEM_IMPL,
    LIT_BOOL
};
use self::util::{
    PAIR_WORDS, Reader, STATUS_OK, add, inc, is_text, put_text, same, sub, trim_end, trim_start,
    u8_at, u64_at
};

// The most expressions one function's walk visits.
const MAX_VISITED: u64 = 16384;

// The interned operators a site can replace.
struct Ops {
    plus: u32,
    minus: u32,
    star: u32,
    eq_eq: u32,
    ne: u32,
    lt: u32,
    le: u32,
    gt: u32,
    ge: u32,
    and: u32,
    or: u32,
    not: u32,
    plus_eq: u32,
    minus_eq: u32
}

fn ops_new(inout ast: Ast) -> Ops {
    Ops {
        plus: ast.names.intern(in "+").id(),
        minus: ast.names.intern(in "-").id(),
        star: ast.names.intern(in "*").id(),
        eq_eq: ast.names.intern(in "==").id(),
        ne: ast.names.intern(in "!=").id(),
        lt: ast.names.intern(in "<").id(),
        le: ast.names.intern(in "<=").id(),
        gt: ast.names.intern(in ">").id(),
        ge: ast.names.intern(in ">=").id(),
        and: ast.names.intern(in "&&").id(),
        or: ast.names.intern(in "||").id(),
        not: ast.names.intern(in "!").id(),
        plus_eq: ast.names.intern(in "+=").id(),
        minus_eq: ast.names.intern(in "-=").id()
    }
}

// The sites found so far: per site the function's name symbol, start,
// end, and the original and replacement as `code` numbers (`code_text`).
struct Sites {
    words: ChunkSeq[u64]
}

// The words of a site.
enum SiteWord: u64 {
    Name = 0,
    Start = 1,
    End = 2,
    Original = 3,
    Replacement = 4,
    Words = 5,
}

// The `code` numbers of the site texts (0 for none).
const SITE_NONE: u64 = 0;
const SITE_PLUS: u64 = 1;
const SITE_MINUS: u64 = 2;
const SITE_STAR: u64 = 3;
const SITE_EQ_EQ: u64 = 4;
const SITE_NE: u64 = 5;
const SITE_LT: u64 = 6;
const SITE_LE: u64 = 7;
const SITE_GT: u64 = 8;
const SITE_GE: u64 = 9;
const SITE_AND: u64 = 10;
const SITE_OR: u64 = 11;
const SITE_NOT: u64 = 12;
const SITE_PLUS_EQ: u64 = 13;
const SITE_MINUS_EQ: u64 = 14;
const SITE_TRUE: u64 = 15;
const SITE_FALSE: u64 = 16;
const SITE_DROPPED_NOT: u64 = 17;

// Site texts: 1-14 operators, 15 "true", 16 "false", 17 " " (a dropped `!`).
fn code_text(code: u64) -> Str {
    match code {
        SITE_PLUS => "+",
        SITE_MINUS => "-",
        SITE_STAR => "*",
        SITE_EQ_EQ => "==",
        SITE_NE => "!=",
        SITE_LT => "<",
        SITE_LE => "<=",
        SITE_GT => ">",
        SITE_GE => ">=",
        SITE_AND => "&&",
        SITE_OR => "||",
        SITE_NOT => "!",
        SITE_PLUS_EQ => "+=",
        SITE_MINUS_EQ => "-=",
        SITE_TRUE => "true",
        SITE_FALSE => "false",
        _ => " ",
    }
}

fn site(inout sites: Sites, name: u32, start: u64, end: u64, original: u64, replacement: u64) {
    sites.words.push(widen_u64(name));
    sites.words.push(start);
    sites.words.push(end);
    sites.words.push(original);
    sites.words.push(replacement);
}

// The binary operator code of `op` and its one or two replacement codes
// (0 when none): `collect_mutants_in_fn`'s table.
fn binary_codes(in ops: Ops, op: u32) -> (u64, u64, u64) {
    if op == ops.plus {
        (SITE_PLUS, SITE_MINUS, SITE_NONE)
    } else if op == ops.minus {
        (SITE_MINUS, SITE_PLUS, SITE_NONE)
    } else if op == ops.star {
        (SITE_STAR, SITE_PLUS, SITE_NONE)
    } else if op == ops.eq_eq {
        (SITE_EQ_EQ, SITE_NE, SITE_NONE)
    } else if op == ops.ne {
        (SITE_NE, SITE_EQ_EQ, SITE_NONE)
    } else if op == ops.lt {
        (SITE_LT, SITE_LE, SITE_GE)
    } else if op == ops.le {
        (SITE_LE, SITE_LT, SITE_GT)
    } else if op == ops.gt {
        (SITE_GT, SITE_GE, SITE_LE)
    } else if op == ops.ge {
        (SITE_GE, SITE_GT, SITE_LT)
    } else if op == ops.and {
        (SITE_AND, SITE_OR, SITE_NONE)
    } else if op == ops.or {
        (SITE_OR, SITE_AND, SITE_NONE)
    } else {
        (SITE_NONE, SITE_NONE, SITE_NONE)
    }
}

// `find_operator_span`: the first non-trivia token within
// `[range_start, range_end]` whose text is `op`, as (found, start, end).
fn find_operator(
    in src: Slice[u8],
    in tokens: Toks,
    range_start: u64,
    range_end: u64,
    in op: Str
) -> (bool, u64, u64) {
    // partition_point(|t| t.span.start < range_start)
    let mut lo: u64 = 0;
    let mut hi = tokens.kind.len();
    loop {
        if lo >= hi {
            break;
        }
        let mid = add(lo, sub(hi, lo) / 2);
        if u64_at(in tokens.start, mid) < range_start {
            lo = inc(mid);
        } else {
            hi = mid;
        }
    }
    let n = tokens.kind.len();
    let mut i = lo;
    loop {
        if i >= n {
            break;
        }
        let tok_start = u64_at(in tokens.start, i);
        let tok_end = u64_at(in tokens.end, i);
        if tok_end > range_end {
            break;
        }
        let kind = u8_at(in tokens.kind, i);
        if kind != k_whitespace()
            && kind != k_comment()
            && kind != k_block_comment()
            && is_text(in src, tok_start, tok_end, in op) {
            return (true, tok_start, tok_end);
        }
        i = inc(i);
    }
    (false, 0, 0)
}

fn stmt_at(in ast: Ast, i: u32) -> StmtNode {
    ast.stmts.get_or(
        idx_from_raw[StmtNode](i),
        StmtNode { kind: 0, pat: 0, ty: 0, value: 0, mutable: false }
    )
}

fn arg_at(in ast: Ast, i: u32) -> ArgNode {
    ast.args.get_or(idx_from_raw[ArgNode](i), ArgNode { pass: 0, explicit: false, expr: 0 })
}

fn clause_at(in ast: Ast, i: u32) -> ClauseNode {
    ast.clauses.get_or(idx_from_raw[ClauseNode](i), ClauseNode { name: 0, pats: 0, body: 0 })
}

fn fn_at(in ast: Ast, i: u32) -> FnNode {
    ast.fns.get_or(
        idx_from_raw[FnNode](i),
        FnNode {
            name: 0,
            fip: false,
            generics: 0,
            params: 0,
            result: 0,
            effects: 0,
            body: none(),
            start: 0,
            end: 0
        }
    )
}

// Pushes the elements of `list` (`stride` words each, the expression at
// word `at`) in reverse order.
fn push_rev(inout stack: ChunkSeq[u32], in ast: Ast, list: u32, stride: u64, at: u64) {
    let len = list_len(in ast, list);
    let n = if stride == PAIR_WORDS {
        len / PAIR_WORDS
    } else {
        len
    };
    let mut k = n;
    loop {
        if k == 0 {
            break;
        }
        k = sub(k, 1);
        stack.push(list_at(in ast, list, add(wrapping_mul(k, stride), at)));
    }
}

// `collect_mutants_in_fn` for the function `func`.
fn collect_in_fn(
    in src: Slice[u8],
    in tokens: Toks,
    in ast: Ast,
    in ops: Ops,
    in func: FnNode,
    inout stack: ChunkSeq[u32],
    inout out: Sites
) {
    if func.body == none() {
        return;
    }
    stack.clear();
    stack.push(func.body);
    let mut visited: u64 = 0;
    loop {
        let stack_len = stack.len();
        if stack_len == 0 {
            break;
        }
        let expr_id = stack.try_get(sub(stack_len, 1)).unwrap_or(0);
        stack.truncate(sub(stack_len, 1));
        visited = inc(visited);
        if visited > MAX_VISITED {
            break;
        }
        let expr = expr_at(in ast, expr_id);
        let kind = expr.kind;
        if kind == EXPR_LITERAL {
            let lit = lit_at(in ast, expr.a);
            if lit.kind == LIT_BOOL {
                let lit_start = widen_u64(expr.start);
                let lit_end = widen_u64(expr.end);
                if lit_end <= src.len() && lit_start <= lit_end {
                    let text_start = trim_start(in src, lit_start, lit_end);
                    let text_end = trim_end(in src, text_start, lit_end);
                    let value = lit.bits != 0;
                    if value && is_text(in src, text_start, text_end, in "true") {
                        site(inout out, func.name, text_start, text_end, SITE_TRUE, SITE_FALSE);
                    } else if !value && is_text(in src, text_start, text_end, in "false") {
                        site(inout out, func.name, text_start, text_end, SITE_FALSE, SITE_TRUE);
                    }
                }
            }
        } else if kind == EXPR_UNARY {
            if expr.a == ops.not {
                let inner = expr_at(in ast, expr.b);
                let (found, op_start, op_end) = find_operator(
                    in src,
                    in tokens,
                    widen_u64(expr.start),
                    widen_u64(inner.start),
                    in "!"
                );
                if found {
                    site(inout out, func.name, op_start, op_end, SITE_NOT, SITE_DROPPED_NOT);
                }
            }
            stack.push(expr.b);
        } else if kind == EXPR_BINARY {
            let (code, first_rep, second_rep) = binary_codes(in ops, expr.a);
            if code != SITE_NONE {
                let lhs = expr_at(in ast, expr.b);
                let rhs = expr_at(in ast, expr.c);
                let (found, op_start, op_end) = find_operator(
                    in src,
                    in tokens,
                    widen_u64(lhs.end),
                    widen_u64(rhs.start),
                    in code_text(code)
                );
                if found {
                    site(inout out, func.name, op_start, op_end, code, first_rep);
                    if second_rep != SITE_NONE {
                        site(inout out, func.name, op_start, op_end, code, second_rep);
                    }
                }
            }
            stack.push(expr.c);
            stack.push(expr.b);
        } else if kind == EXPR_ASSIGN {
            let mut code: u64 = SITE_NONE;
            let mut replacement: u64 = SITE_NONE;
            if expr.a == ops.plus_eq {
                code = SITE_PLUS_EQ;
                replacement = SITE_MINUS_EQ;
            } else if expr.a == ops.minus_eq {
                code = SITE_MINUS_EQ;
                replacement = SITE_PLUS_EQ;
            }
            if code != SITE_NONE {
                let lhs = expr_at(in ast, expr.b);
                let rhs = expr_at(in ast, expr.c);
                let (found, op_start, op_end) = find_operator(
                    in src,
                    in tokens,
                    widen_u64(lhs.end),
                    widen_u64(rhs.start),
                    in code_text(code)
                );
                if found {
                    site(inout out, func.name, op_start, op_end, code, replacement);
                }
            }
            stack.push(expr.c);
            stack.push(expr.b);
        } else if kind == EXPR_TUPLE {
            push_rev(inout stack, in ast, expr.a, 1, 0);
        } else if kind == EXPR_STRUCT {
            push_rev(inout stack, in ast, expr.b, PAIR_WORDS, 1);
        } else if kind == EXPR_BLOCK {
            if expr.b != none() {
                stack.push(expr.b);
            }
            let count = list_len(in ast, expr.a);
            let mut q = count;
            loop {
                if q == 0 {
                    break;
                }
                q = sub(q, 1);
                let stmt = stmt_at(in ast, list_at(in ast, expr.a, q));
                stack.push(stmt.value);
            }
        } else if kind == EXPR_CALL {
            let count = list_len(in ast, expr.c);
            let mut q = count;
            loop {
                if q == 0 {
                    break;
                }
                q = sub(q, 1);
                stack.push(arg_at(in ast, list_at(in ast, expr.c, q)).expr);
            }
            stack.push(expr.a);
        } else if kind == EXPR_FIELD || kind == EXPR_TRY {
            stack.push(expr.a);
        } else if kind == EXPR_INDEX {
            stack.push(expr.b);
            stack.push(expr.a);
        } else if kind == EXPR_IF {
            if expr.c != none() {
                stack.push(expr.c);
            }
            stack.push(expr.b);
            stack.push(expr.a);
        } else if kind == EXPR_MATCH {
            push_rev(inout stack, in ast, expr.b, PAIR_WORDS, 1);
            stack.push(expr.a);
        } else if kind == EXPR_CLOSURE {
            stack.push(expr.e);
        } else if kind == EXPR_LOOP {
            stack.push(expr.a);
        } else if kind == EXPR_FOR {
            // control_children [iter, body], reversed onto the stack.
            stack.push(expr.c);
            stack.push(expr.b);
        } else if kind == EXPR_RANGE {
            stack.push(expr.b);
            stack.push(expr.a);
        } else if kind == EXPR_BREAK || kind == EXPR_RETURN {
            if expr.a != none() {
                stack.push(expr.a);
            }
        } else if kind == EXPR_HANDLE {
            // The clauses: the return clause, then the operations.
            let count = list_len(in ast, expr.e);
            let mut q = count;
            loop {
                if q <= 1 {
                    break;
                }
                q = sub(q, 1);
                stack.push(clause_at(in ast, list_at(in ast, expr.e, q)).body);
            }
            if count > 0 {
                stack.push(clause_at(in ast, list_at(in ast, expr.e, 0)).body);
            }
            stack.push(expr.d);
            if expr.b != none() {
                stack.push(expr.c);
            }
        }
    }
}

// Whether `name` is one of the test names in `input`.
fn is_test_name(in input: Slice[u8], in names: ChunkSeq[u64], in name: Slice[u8]) -> bool {
    let n = names.len() / PAIR_WORDS;
    for i in 0..n {
        let name_start = u64_at(in names, wrapping_mul(i, PAIR_WORDS));
        let name_end = u64_at(in names, inc(wrapping_mul(i, PAIR_WORDS)));
        if same(in input, name_start, name_end, in name, 0, name.len()) {
            return true;
        }
    }
    false
}

// Site `site_index`'s word `word` of `sites`.
fn sw(in sites: Sites, site_index: u64, word: u64) -> u64 {
    u64_at(in sites.words, add(wrapping_mul(site_index, SiteWord::Words), word))
}

// Whether site `lhs` sorts before site `rhs`: (start, end, replacement text).
fn site_less(in sites: Sites, lhs: u64, rhs: u64) -> bool {
    let (lhs_start, rhs_start) = (
        sw(in sites, lhs, SiteWord::Start),
        sw(in sites, rhs, SiteWord::Start)
    );
    if lhs_start != rhs_start {
        return lhs_start < rhs_start;
    }
    let (lhs_end, rhs_end) = (sw(in sites, lhs, SiteWord::End), sw(in sites, rhs, SiteWord::End));
    if lhs_end != rhs_end {
        return lhs_end < rhs_end;
    }
    let lhs_text = code_text(sw(in sites, lhs, SiteWord::Replacement)).as_bytes();
    let rhs_text = code_text(sw(in sites, rhs, SiteWord::Replacement)).as_bytes();
    let lhs_len = lhs_text.len();
    let rhs_len = rhs_text.len();
    let mut i: u64 = 0;
    loop {
        if i >= lhs_len || i >= rhs_len {
            break;
        }
        let (lhs_byte, rhs_byte) = (u8_at_slice(in lhs_text, i), u8_at_slice(in rhs_text, i));
        if lhs_byte != rhs_byte {
            return lhs_byte < rhs_byte;
        }
        i = inc(i);
    }
    lhs_len < rhs_len
}

fn u8_at_slice(in bytes: Slice[u8], i: u64) -> u8 {
    bytes.try_get(i).unwrap_or(0)
}

// `rust_collect` over the input words.
pub fn collect(in input: Slice[u8]) -> ChunkSeq[u64] {
    let mut reader = Reader { pos: 0 };
    let (src_start, src_end) = reader.text(in input);
    let name_count = reader.word(in input);
    let mut names: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for i in 0..name_count {
        let (name_start, name_end) = reader.text(in input);
        names.push(name_start);
        names.push(name_end);
    }
    let src = input[src_start..src_end];
    let text = match String::from_utf8(in src) {
        Option::Some(decoded) => decoded,
        Option::None => String::new(),
    };
    let mut lowered = lower_source(in text.as_str());
    let ops = ops_new(inout lowered.ast);
    let tokens = toks(in src);
    let mut out = Sites { words: ChunkSeq::new[u64]() };
    let mut stack: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut comments: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut name: String = String::new();
    let items = lowered.ast.m_items.len();
    for i in 0..items {
        let item_id = lowered.ast.m_items.try_get(i).unwrap_or(0);
        let item = lowered
            .ast
            .items
            .get_or(idx_from_raw[ItemNode](item_id), ItemNode { kind: 0, node: 0 });
        if item.kind == ITEM_FUNCTION {
            let func = fn_at(in lowered.ast, item.node);
            name.clear();
            let ok = lowered.ast.names.resolve_into(symbol_from_id(func.name), inout name);
            let name_bytes = name.as_bytes();
            let mut test = is_test_name(in input, in names, in name_bytes)
                || starts_with_bytes(in name_bytes, in "test_");
            if !test {
                preceding_comments(in tokens, widen_u64(func.start), inout comments);
                let comment_count = comments.len() / PAIR_WORDS;
                for q in 0..comment_count {
                    let comment_start = u64_at(in comments, wrapping_mul(q, PAIR_WORDS));
                    let comment_end = u64_at(in comments, inc(wrapping_mul(q, PAIR_WORDS)));
                    let (is_row, row_start, row_end) = case_marker(
                        in src,
                        comment_start,
                        comment_end
                    );
                    if is_test_marker(in src, comment_start, comment_end) || is_row {
                        test = true;
                    }
                }
            }
            if !test {
                collect_in_fn(
                    in src,
                    in tokens,
                    in lowered.ast,
                    in ops,
                    in func,
                    inout stack,
                    inout out
                );
            }
        } else if item.kind == ITEM_IMPL {
            let impl_node = lowered.ast.impls.get_or(
                idx_from_raw[ImplNode](item.node),
                ImplNode { ty: 0, generics: 0, methods: 0 }
            );
            let method_count = list_len(in lowered.ast, impl_node.methods);
            for q in 0..method_count {
                let func = fn_at(in lowered.ast, list_at(in lowered.ast, impl_node.methods, q));
                collect_in_fn(
                    in src,
                    in tokens,
                    in lowered.ast,
                    in ops,
                    in func,
                    inout stack,
                    inout out
                );
            }
        } else if item.kind == ITEM_CONFORMANCE {
            let conf = lowered.ast.confs.get_or(
                idx_from_raw[ConfNode](item.node),
                ConfNode {
                    model: 0,
                    public: false,
                    generics: 0,
                    trait_ref: 0,
                    self_ty: 0,
                    wheres: 0,
                    assoc: 0,
                    methods: 0,
                    start: 0,
                    end: 0
                }
            );
            let method_count = list_len(in lowered.ast, conf.methods);
            for q in 0..method_count {
                let func = fn_at(in lowered.ast, list_at(in lowered.ast, conf.methods, q));
                collect_in_fn(
                    in src,
                    in tokens,
                    in lowered.ast,
                    in ops,
                    in func,
                    inout stack,
                    inout out
                );
            }
        }
    }
    // A stable insertion sort of the site indices (the walk is close to
    // source order already).
    let site_count = out.words.len() / SiteWord::Words;
    let mut order: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](site_count);
    for i in 0..site_count {
        order.push(i);
        let mut j = i;
        loop {
            if j == 0 {
                break;
            }
            let prev = u64_at(in order, sub(j, 1));
            let cur = u64_at(in order, j);
            if !site_less(in out, cur, prev) {
                break;
            }
            let ok1 = order.try_set(sub(j, 1), cur);
            let ok2 = order.try_set(j, prev);
            j = sub(j, 1);
        }
    }
    let mut res: ChunkSeq[u64] = ChunkSeq::new[u64]();
    res.push(STATUS_OK);
    res.push(site_count);
    for i in 0..site_count {
        let site_index = u64_at(in order, i);
        name.clear();
        let ok = lowered.ast.names.resolve_into(
            symbol_from_id(wrapping_u32(sw(in out, site_index, SiteWord::Name))),
            inout name
        );
        let name_bytes = name.as_bytes();
        put_text(inout res, in name_bytes, 0, name_bytes.len());
        res.push(sw(in out, site_index, SiteWord::Start));
        res.push(sw(in out, site_index, SiteWord::End));
        let orig = code_text(sw(in out, site_index, SiteWord::Original)).as_bytes();
        put_text(inout res, in orig, 0, orig.len());
        let rep = code_text(sw(in out, site_index, SiteWord::Replacement)).as_bytes();
        put_text(inout res, in rep, 0, rep.len());
    }
    res
}

fn starts_with_bytes(in bytes: Slice[u8], in text: Str) -> bool {
    let prefix = text.as_bytes();
    if bytes.len() < prefix.len() {
        return false;
    }
    same(in bytes, 0, prefix.len(), in prefix, 0, prefix.len())
}
