// The Anvil function graph: `FunctionGraph::from_module` of
// src/anvil_hash.rs over @vesper/ast's AST of a source. For every
// top-level function and `impl` method (keyed `name` or `Owner::name`):
// its canonical, span-insensitive BLAKE3 digest (`hash_function`) and its
// direct callees in the module (`collect_expr_calls`). The canonical bytes
// of a function go to one buffer and are hashed once with
// @vesper-std/hash's BLAKE3; each effect instance is hashed on its own
// and the digests sorted, as in Rust.
//
// Input words: the source. Result words: the entry count and, per entry
// in declaration order, the key, the lowercase hex digest, the number of
// direct callees and their keys (each once, in no particular order)
// (tests/common/anvil_graph_words.rs).

use @vesper/ast::{
    ArgNode, Ast, ClauseNode, EffectNode, EffectsNode, FnNode, GenericNode, ImplNode, ItemNode,
    ParamNode, PatNode, StmtNode, expr_at, list_at, list_len, lit_at, none, pat_at, type_at
};
use @vesper/ast::lower::{lower_source};
use @vesper-std/arena::{idx_from_raw};
use @vesper-std/intern::{symbol_from_id};
use @vesper-std/hash::blake3::{Digest, blake3, digest_bytes, digest_hex};
use self::util::{Reader, is_text, put_text, u8_at};

// ------------------------------------------------------------ node access

fn stmt_at(in ast: Ast, i: u32) -> StmtNode {
    ast.stmts.get_or(
        idx_from_raw[StmtNode](i),
        StmtNode { kind: 0, pat: 0, ty: 0, value: 0, mutable: false }
    )
}

fn arg_at(in ast: Ast, i: u32) -> ArgNode {
    ast.args.get_or(idx_from_raw[ArgNode](i), ArgNode { pass: 0, explicit: false, expr: 0 })
}

fn clause_at(in ast: Ast, i: u32) -> ClauseNode {
    ast.clauses.get_or(idx_from_raw[ClauseNode](i), ClauseNode { name: 0, pats: 0, body: 0 })
}

fn param_at(in ast: Ast, i: u32) -> ParamNode {
    ast.params.get_or(
        idx_from_raw[ParamNode](i),
        ParamNode { name: 0, pass: 0, projections: 0, ty: 0, start: 0, end: 0 }
    )
}

fn generic_at(in ast: Ast, i: u32) -> GenericNode {
    ast.generics.get_or(idx_from_raw[GenericNode](i), GenericNode { name: 0, bound: 0, row: false })
}

fn effects_at(in ast: Ast, i: u32) -> EffectsNode {
    ast.effects.get_or(idx_from_raw[EffectsNode](i), EffectsNode { instances: 0, tail: none() })
}

fn effect_at(in ast: Ast, i: u32) -> EffectNode {
    ast.effect_nodes
        .get_or(idx_from_raw[EffectNode](i), EffectNode { label: none(), name: 0, args: 0 })
}

fn fn_at(in ast: Ast, i: u32) -> FnNode {
    ast.fns.get_or(
        idx_from_raw[FnNode](i),
        FnNode {
            name: 0,
            fip: false,
            generics: 0,
            params: 0,
            result: 0,
            effects: 0,
            body: none(),
            start: 0,
            end: 0
        }
    )
}

// ---------------------------------------------------------- canonical bytes

fn put_u8(inout buf: ChunkSeq[u8], value: u8) {
    buf.push(value);
}

fn put_bool(inout buf: ChunkSeq[u8], value: bool) {
    if value {
        buf.push(1);
    } else {
        buf.push(0);
    }
}

fn put_u64(inout buf: ChunkSeq[u8], value: u64) {
    let mut shift: u32 = 0;
    loop {
        if shift >= 64 {
            break;
        }
        buf.push(wrapping_u8(wrapping_shr_u64(value, shift)));
        shift = wrapping_add(shift, 8);
    }
}

// `hash_str` of `bytes`.
fn put_bytes(inout buf: ChunkSeq[u8], in bytes: Slice[u8]) {
    put_u64(inout buf, bytes.len());
    buf.extend(in bytes);
}

// `hash_str` of a symbol's text.
fn put_sym(inout buf: ChunkSeq[u8], in ast: Ast, sym: u32, inout scratch: String) {
    scratch.clear();
    let ok = ast.names.resolve_into(symbol_from_id(sym), inout scratch);
    put_bytes(inout buf, in scratch.as_bytes());
}

// `hash_mode` of an optional-mode word: 0 Copy, 1 Affine, 2 Linear.
fn put_mode(inout buf: ChunkSeq[u8], mode: u64) {
    buf.push(wrapping_u8(mode));
}

fn put_type(inout buf: ChunkSeq[u8], in ast: Ast, type_id: u32, inout scratch: String) {
    let node = type_at(in ast, type_id);
    if node.kind == 1 {
        put_u8(inout buf, 1);
        put_sym(inout buf, in ast, node.a, inout scratch);
        let count = list_len(in ast, node.b);
        put_u64(inout buf, count);
        for i in 0..count {
            put_type(inout buf, in ast, list_at(in ast, node.b, i), inout scratch);
        }
    } else if node.kind == 2 {
        put_u8(inout buf, 2);
        let count = list_len(in ast, node.a);
        put_u64(inout buf, count);
        for i in 0..count {
            put_type(inout buf, in ast, list_at(in ast, node.a, i), inout scratch);
        }
    } else if node.kind == 3 {
        put_u8(inout buf, 3);
        let count = list_len(in ast, node.a) / 2;
        put_u64(inout buf, count);
        for i in 0..count {
            let pair_at = wrapping_mul(i, 2);
            put_u8(inout buf, wrapping_u8(widen_u64(list_at(in ast, node.a, pair_at))));
            put_type(
                inout buf,
                in ast,
                list_at(in ast, node.a, wrapping_add(pair_at, 1)),
                inout scratch
            );
        }
        put_type(inout buf, in ast, node.b, inout scratch);
        put_effects(inout buf, in ast, node.c, inout scratch);
        put_mode(inout buf, widen_u64(node.d));
    } else if node.kind == 4 {
        put_u8(inout buf, 4);
        put_effects(inout buf, in ast, node.a, inout scratch);
    } else {
        put_u8(inout buf, 5);
    }
}

// `hash_effect`.
fn put_effect(inout buf: ChunkSeq[u8], in ast: Ast, effect_id: u32, inout scratch: String) {
    let node = effect_at(in ast, effect_id);
    if node.label != none() {
        put_u8(inout buf, 1);
        put_sym(inout buf, in ast, node.label, inout scratch);
    } else {
        put_u8(inout buf, 0);
    }
    put_sym(inout buf, in ast, node.name, inout scratch);
    let count = list_len(in ast, node.args);
    put_u64(inout buf, count);
    for i in 0..count {
        put_type(inout buf, in ast, list_at(in ast, node.args, i), inout scratch);
    }
}

// Whether the 32 bytes of `digests` at `i` sort before those at `j`.
fn digest_less(in digests: ChunkSeq[u8], i: u64, j: u64) -> bool {
    for k in 0..32 {
        let lhs_byte = u8_at(in digests, wrapping_add(wrapping_mul(i, 32), k));
        let rhs_byte = u8_at(in digests, wrapping_add(wrapping_mul(j, 32), k));
        if lhs_byte != rhs_byte {
            return lhs_byte < rhs_byte;
        }
    }
    false
}

// `hash_effects`: every instance's own digest, sorted, then the tail.
fn put_effects(inout buf: ChunkSeq[u8], in ast: Ast, effects: u32, inout scratch: String) {
    let node = effects_at(in ast, effects);
    let count = list_len(in ast, node.instances);
    let mut digests: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut instance_bytes: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for i in 0..count {
        instance_bytes.clear();
        put_effect(inout instance_bytes, in ast, list_at(in ast, node.instances, i), inout scratch);
        digest_bytes(blake3(in instance_bytes.as_slice()), inout digests);
    }
    // Insertion sort of the order of the digests.
    let mut order: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](count);
    for i in 0..count {
        order.push(i);
        let mut j = i;
        loop {
            if j == 0 {
                break;
            }
            let prev = order.try_get(wrapping_sub(j, 1)).unwrap_or(0);
            if !digest_less(in digests, i, prev) {
                break;
            }
            let ok = order.try_set(j, prev);
            j = wrapping_sub(j, 1);
        }
        let ok = order.try_set(j, i);
    }
    put_u64(inout buf, count);
    for i in 0..count {
        let digest_index = order.try_get(i).unwrap_or(0);
        let digest_start = wrapping_mul(digest_index, 32);
        for k in digest_start..wrapping_add(digest_start, 32) {
            match digests.try_get(k) {
                Option::Some(digest_byte) => buf.push(digest_byte),
                Option::None => {},
            }
        }
    }
    if node.tail != none() {
        put_u8(inout buf, 1);
        put_sym(inout buf, in ast, node.tail, inout scratch);
    } else {
        put_u8(inout buf, 0);
    }
}

// The 16 little-endian bytes of a 128-bit value `hi:lo`.
fn put_u128(inout buf: ChunkSeq[u8], lo: u64, hi: u64) {
    put_u64(inout buf, lo);
    put_u64(inout buf, hi);
}

// `hash_literal` of literal `lit_id`.
fn put_lit(inout buf: ChunkSeq[u8], in ast: Ast, lit_id: u32, inout scratch: String) {
    let lit = lit_at(in ast, lit_id);
    if lit.kind == 1 {
        put_u8(inout buf, 0);
        if lit.neg {
            // The two's complement of the magnitude.
            let lo = wrapping_add(!lit.bits, 1);
            let carry: u64 = if lo == 0 { 1 } else { 0 };
            put_u128(inout buf, lo, wrapping_add(!lit.hi, carry));
        } else {
            put_u128(inout buf, lit.bits, lit.hi);
        }
    } else if lit.kind == 2 {
        put_u8(inout buf, 1);
        put_u64(inout buf, lit.bits);
    } else if lit.kind == 3 {
        put_u8(inout buf, 2);
        put_bool(inout buf, lit.bits != 0);
    } else if lit.kind == 5 {
        put_u8(inout buf, 4);
        put_u128(inout buf, lit.bits, lit.hi);
    } else {
        put_u8(inout buf, 3);
        put_sym(inout buf, in ast, wrapping_u32(lit.bits), inout scratch);
    }
}

fn put_pat(inout buf: ChunkSeq[u8], in ast: Ast, pat_id: u32, inout scratch: String) {
    let node = pat_at(in ast, pat_id);
    if node.kind == 1 {
        put_u8(inout buf, 0);
    } else if node.kind == 2 {
        put_u8(inout buf, 1);
        put_sym(inout buf, in ast, node.a, inout scratch);
    } else if node.kind == 3 {
        put_u8(inout buf, 2);
        put_lit(inout buf, in ast, node.a, inout scratch);
    } else if node.kind == 4 {
        put_u8(inout buf, 3);
        let count = list_len(in ast, node.a);
        put_u64(inout buf, count);
        for i in 0..count {
            put_pat(inout buf, in ast, list_at(in ast, node.a, i), inout scratch);
        }
    } else {
        put_u8(inout buf, 4);
        put_sym(inout buf, in ast, node.a, inout scratch);
        put_bool(inout buf, node.c != 0);
        let count = list_len(in ast, node.b) / 2;
        put_u64(inout buf, count);
        for i in 0..count {
            let pair_at = wrapping_mul(i, 2);
            put_sym(inout buf, in ast, list_at(in ast, node.b, pair_at), inout scratch);
            put_pat(
                inout buf,
                in ast,
                list_at(in ast, node.b, wrapping_add(pair_at, 1)),
                inout scratch
            );
        }
    }
}

fn put_params(inout buf: ChunkSeq[u8], in ast: Ast, params: u32, inout scratch: String) {
    let count = list_len(in ast, params);
    put_u64(inout buf, count);
    for i in 0..count {
        let param = param_at(in ast, list_at(in ast, params, i));
        put_sym(inout buf, in ast, param.name, inout scratch);
        put_u8(inout buf, param.pass);
        let proj_count = list_len(in ast, param.projections);
        put_u64(inout buf, proj_count);
        for j in 0..proj_count {
            let proj = list_at(in ast, param.projections, j);
            let sym_count = list_len(in ast, proj);
            put_u64(inout buf, sym_count);
            for k in 0..sym_count {
                put_sym(inout buf, in ast, list_at(in ast, proj, k), inout scratch);
            }
        }
        put_type(inout buf, in ast, param.ty, inout scratch);
    }
}

fn put_clause(inout buf: ChunkSeq[u8], in ast: Ast, clause_id: u32, inout scratch: String) {
    let clause = clause_at(in ast, clause_id);
    put_sym(inout buf, in ast, clause.name, inout scratch);
    let count = list_len(in ast, clause.pats);
    put_u64(inout buf, count);
    for i in 0..count {
        put_pat(inout buf, in ast, list_at(in ast, clause.pats, i), inout scratch);
    }
    put_expr(inout buf, in ast, clause.body, inout scratch);
}

fn put_opt_expr(inout buf: ChunkSeq[u8], in ast: Ast, expr_id: u32, inout scratch: String) {
    if expr_id != none() {
        put_u8(inout buf, 1);
        put_expr(inout buf, in ast, expr_id, inout scratch);
    } else {
        put_u8(inout buf, 0);
    }
}

// `hash_expr`.
fn put_expr(inout buf: ChunkSeq[u8], in ast: Ast, expr_id: u32, inout scratch: String) {
    let expr = expr_at(in ast, expr_id);
    let kind = expr.kind;
    if kind == 1 {
        put_u8(inout buf, 0);
        put_lit(inout buf, in ast, expr.a, inout scratch);
    } else if kind == 2 {
        put_u8(inout buf, 1);
        put_sym(inout buf, in ast, expr.a, inout scratch);
    } else if kind == 3 {
        put_u8(inout buf, 2);
        let count = list_len(in ast, expr.a);
        put_u64(inout buf, count);
        for i in 0..count {
            put_expr(inout buf, in ast, list_at(in ast, expr.a, i), inout scratch);
        }
    } else if kind == 4 {
        put_u8(inout buf, 3);
        put_sym(inout buf, in ast, expr.a, inout scratch);
        let count = list_len(in ast, expr.b) / 2;
        put_u64(inout buf, count);
        for i in 0..count {
            let pair_at = wrapping_mul(i, 2);
            put_sym(inout buf, in ast, list_at(in ast, expr.b, pair_at), inout scratch);
            put_expr(
                inout buf,
                in ast,
                list_at(in ast, expr.b, wrapping_add(pair_at, 1)),
                inout scratch
            );
        }
    } else if kind == 5 {
        put_u8(inout buf, 4);
        let count = list_len(in ast, expr.a);
        put_u64(inout buf, count);
        for i in 0..count {
            let stmt = stmt_at(in ast, list_at(in ast, expr.a, i));
            if stmt.kind == 1 {
                put_u8(inout buf, 0);
                put_pat(inout buf, in ast, stmt.pat, inout scratch);
                put_type(inout buf, in ast, stmt.ty, inout scratch);
                put_expr(inout buf, in ast, stmt.value, inout scratch);
                put_bool(inout buf, stmt.mutable);
            } else {
                put_u8(inout buf, 1);
                put_expr(inout buf, in ast, stmt.value, inout scratch);
            }
        }
        put_opt_expr(inout buf, in ast, expr.b, inout scratch);
    } else if kind == 6 {
        put_u8(inout buf, 5);
        put_expr(inout buf, in ast, expr.a, inout scratch);
        let type_count = list_len(in ast, expr.b);
        put_u64(inout buf, type_count);
        for i in 0..type_count {
            put_type(inout buf, in ast, list_at(in ast, expr.b, i), inout scratch);
        }
        let arg_count = list_len(in ast, expr.c);
        put_u64(inout buf, arg_count);
        for i in 0..arg_count {
            let arg = arg_at(in ast, list_at(in ast, expr.c, i));
            put_u8(inout buf, arg.pass);
            put_bool(inout buf, arg.explicit);
            put_expr(inout buf, in ast, arg.expr, inout scratch);
        }
    } else if kind == 7 {
        put_u8(inout buf, 6);
        put_expr(inout buf, in ast, expr.a, inout scratch);
        put_sym(inout buf, in ast, expr.b, inout scratch);
    } else if kind == 8 {
        put_u8(inout buf, 7);
        put_expr(inout buf, in ast, expr.a, inout scratch);
        put_expr(inout buf, in ast, expr.b, inout scratch);
    } else if kind == 9 {
        put_u8(inout buf, 8);
        put_expr(inout buf, in ast, expr.a, inout scratch);
    } else if kind == 10 {
        put_u8(inout buf, 9);
        put_sym(inout buf, in ast, expr.a, inout scratch);
        put_expr(inout buf, in ast, expr.b, inout scratch);
    } else if kind == 11 || kind == 12 {
        if kind == 11 {
            put_u8(inout buf, 10);
        } else {
            put_u8(inout buf, 11);
        }
        put_sym(inout buf, in ast, expr.a, inout scratch);
        put_expr(inout buf, in ast, expr.b, inout scratch);
        put_expr(inout buf, in ast, expr.c, inout scratch);
    } else if kind == 13 {
        put_u8(inout buf, 12);
        put_expr(inout buf, in ast, expr.a, inout scratch);
        put_expr(inout buf, in ast, expr.b, inout scratch);
        put_opt_expr(inout buf, in ast, expr.c, inout scratch);
    } else if kind == 14 {
        put_u8(inout buf, 13);
        put_expr(inout buf, in ast, expr.a, inout scratch);
        let count = list_len(in ast, expr.b) / 2;
        put_u64(inout buf, count);
        for i in 0..count {
            let pair_at = wrapping_mul(i, 2);
            put_pat(inout buf, in ast, list_at(in ast, expr.b, pair_at), inout scratch);
            put_expr(
                inout buf,
                in ast,
                list_at(in ast, expr.b, wrapping_add(pair_at, 1)),
                inout scratch
            );
        }
    } else if kind == 15 {
        put_u8(inout buf, 14);
        put_params(inout buf, in ast, expr.a, inout scratch);
        let mode = widen_u64(expr.b) & 255;
        if mode == 3 {
            put_u8(inout buf, 0);
        } else {
            put_u8(inout buf, 1);
            put_mode(inout buf, mode);
        }
        put_type(inout buf, in ast, expr.c, inout scratch);
        put_effects(inout buf, in ast, expr.d, inout scratch);
        put_bool(inout buf, ((widen_u64(expr.b) >> 8) & 1) != 0);
        put_expr(inout buf, in ast, expr.e, inout scratch);
    } else if kind == 16 {
        put_u8(inout buf, 15);
        put_effect(inout buf, in ast, expr.a, inout scratch);
        if expr.b != none() {
            put_u8(inout buf, 1);
            put_pat(inout buf, in ast, expr.b, inout scratch);
            put_expr(inout buf, in ast, expr.c, inout scratch);
        } else {
            put_u8(inout buf, 0);
        }
        put_expr(inout buf, in ast, expr.d, inout scratch);
        let count = list_len(in ast, expr.e);
        if count > 0 {
            put_clause(inout buf, in ast, list_at(in ast, expr.e, 0), inout scratch);
        }
        let op_count = if count > 0 { wrapping_sub(count, 1) } else { 0 };
        put_u64(inout buf, op_count);
        for i in 1..count {
            put_clause(inout buf, in ast, list_at(in ast, expr.e, i), inout scratch);
        }
    } else if kind == 17 {
        put_u8(inout buf, 16);
        put_expr(inout buf, in ast, expr.a, inout scratch);
    } else if kind == 18 {
        put_u8(inout buf, 17);
        put_pat(inout buf, in ast, expr.a, inout scratch);
        put_expr(inout buf, in ast, expr.b, inout scratch);
        put_expr(inout buf, in ast, expr.c, inout scratch);
    } else if kind == 19 {
        put_u8(inout buf, 18);
        put_expr(inout buf, in ast, expr.a, inout scratch);
        put_expr(inout buf, in ast, expr.b, inout scratch);
        put_bool(inout buf, expr.c != 0);
    } else if kind == 20 {
        put_u8(inout buf, 19);
        put_opt_expr(inout buf, in ast, expr.a, inout scratch);
    } else if kind == 21 {
        put_u8(inout buf, 20);
        put_opt_expr(inout buf, in ast, expr.a, inout scratch);
    } else {
        put_u8(inout buf, 21);
    }
}

// `hash_function`: the canonical bytes of function `func` keyed `key`.
fn put_function(
    inout buf: ChunkSeq[u8],
    in ast: Ast,
    in key: Slice[u8],
    in func: FnNode,
    inout scratch: String
) {
    buf.clear();
    buf.extend(in "vesper.anvil.fn_blake3.v1".as_bytes());
    buf.push(0);
    put_bytes(inout buf, in key);
    put_bool(inout buf, func.fip);
    let generic_count = list_len(in ast, func.generics);
    put_u64(inout buf, generic_count);
    for i in 0..generic_count {
        let generic = generic_at(in ast, list_at(in ast, func.generics, i));
        put_sym(inout buf, in ast, generic.name, inout scratch);
        put_u8(inout buf, generic.bound);
        put_bool(inout buf, generic.row);
    }
    put_params(inout buf, in ast, func.params, inout scratch);
    put_type(inout buf, in ast, func.result, inout scratch);
    put_effects(inout buf, in ast, func.effects, inout scratch);
    put_opt_expr(inout buf, in ast, func.body, inout scratch);
}

// ------------------------------------------------------------- type text

// `Type`'s `Display` (`impl_type_key` of a type that is not Named).
fn type_text(in ast: Ast, type_id: u32, inout out: String, inout scratch: String) {
    let node = type_at(in ast, type_id);
    if node.kind == 1 {
        scratch.clear();
        let ok = ast.names.resolve_into(symbol_from_id(node.a), inout scratch);
        let count = list_len(in ast, node.b);
        if count == 1 && is_text(in scratch.as_bytes(), 0, scratch.as_bytes().len(), in "dyn") {
            out.push_str(in "dyn ");
            type_text(in ast, list_at(in ast, node.b, 0), inout out, inout scratch);
            return;
        }
        out.push_str(in scratch.as_str());
        if count > 0 {
            out.push_str(in "[");
            for i in 0..count {
                if i > 0 {
                    out.push_str(in ", ");
                }
                type_text(in ast, list_at(in ast, node.b, i), inout out, inout scratch);
            }
            out.push_str(in "]");
        }
    } else if node.kind == 2 {
        out.push_str(in "(");
        let count = list_len(in ast, node.a);
        for i in 0..count {
            if i > 0 {
                out.push_str(in ", ");
            }
            type_text(in ast, list_at(in ast, node.a, i), inout out, inout scratch);
        }
        out.push_str(in ")");
    } else if node.kind == 3 {
        out.push_str(in "fn(");
        let count = list_len(in ast, node.a) / 2;
        for i in 0..count {
            if i > 0 {
                out.push_str(in ", ");
            }
            type_text(
                in ast,
                list_at(in ast, node.a, wrapping_add(wrapping_mul(i, 2), 1)),
                inout out,
                inout scratch
            );
        }
        out.push_str(in ") -> ");
        type_text(in ast, node.b, inout out, inout scratch);
    } else if node.kind == 4 {
        // `Type::Row(e)` displays as `eff {e:?}`.
        out.push_str(in "eff ");
        effects_debug(in ast, node.a, inout out, inout scratch);
    } else {
        out.push_str(in "_");
    }
}

// The `Debug` text of a symbol as a Rust `String`: its quoted name.
fn sym_debug(in ast: Ast, sym: u32, inout out: String, inout scratch: String) {
    scratch.clear();
    let ok = ast.names.resolve_into(symbol_from_id(sym), inout scratch);
    out.push_str(in "\"");
    out.push_str(in scratch.as_str());
    out.push_str(in "\"");
}

// The `Debug` text of a list of types: `[t, u]`.
fn types_debug(in ast: Ast, list: u32, inout out: String, inout scratch: String) {
    out.push_str(in "[");
    let count = list_len(in ast, list);
    for i in 0..count {
        if i > 0 {
            out.push_str(in ", ");
        }
        type_debug(in ast, list_at(in ast, list, i), inout out, inout scratch);
    }
    out.push_str(in "]");
}

// The derived `Debug` text of a `Type`.
fn type_debug(in ast: Ast, type_id: u32, inout out: String, inout scratch: String) {
    let node = type_at(in ast, type_id);
    if node.kind == 1 {
        out.push_str(in "Named(");
        sym_debug(in ast, node.a, inout out, inout scratch);
        out.push_str(in ", ");
        types_debug(in ast, node.b, inout out, inout scratch);
        out.push_str(in ")");
    } else if node.kind == 2 {
        out.push_str(in "Tuple(");
        types_debug(in ast, node.a, inout out, inout scratch);
        out.push_str(in ")");
    } else if node.kind == 3 {
        out.push_str(in "Function { params: [");
        let count = list_len(in ast, node.a) / 2;
        for i in 0..count {
            if i > 0 {
                out.push_str(in ", ");
            }
            let pair_at = wrapping_mul(i, 2);
            let pass = list_at(in ast, node.a, pair_at);
            if pass == 0 {
                out.push_str(in "(In, ");
            } else if pass == 1 {
                out.push_str(in "(Inout, ");
            } else {
                out.push_str(in "(Sink, ");
            }
            type_debug(
                in ast,
                list_at(in ast, node.a, wrapping_add(pair_at, 1)),
                inout out,
                inout scratch
            );
            out.push_str(in ")");
        }
        out.push_str(in "], result: ");
        type_debug(in ast, node.b, inout out, inout scratch);
        out.push_str(in ", effects: ");
        effects_debug(in ast, node.c, inout out, inout scratch);
        if node.d == 0 {
            out.push_str(in ", mode: Copy }");
        } else if node.d == 2 {
            out.push_str(in ", mode: Linear }");
        } else {
            out.push_str(in ", mode: Affine }");
        }
    } else if node.kind == 4 {
        out.push_str(in "Row(");
        effects_debug(in ast, node.a, inout out, inout scratch);
        out.push_str(in ")");
    } else {
        out.push_str(in "Infer");
    }
}

// The derived `Debug` text of an `Effects`.
fn effects_debug(in ast: Ast, effects: u32, inout out: String, inout scratch: String) {
    let node = effects_at(in ast, effects);
    out.push_str(in "Effects { instances: [");
    let count = list_len(in ast, node.instances);
    for i in 0..count {
        if i > 0 {
            out.push_str(in ", ");
        }
        let effect = effect_at(in ast, list_at(in ast, node.instances, i));
        out.push_str(in "Effect { label: ");
        if effect.label != none() {
            out.push_str(in "Some(");
            sym_debug(in ast, effect.label, inout out, inout scratch);
            out.push_str(in ")");
        } else {
            out.push_str(in "None");
        }
        out.push_str(in ", name: ");
        sym_debug(in ast, effect.name, inout out, inout scratch);
        out.push_str(in ", args: ");
        types_debug(in ast, effect.args, inout out, inout scratch);
        out.push_str(in " }");
    }
    out.push_str(in "], tail: ");
    if node.tail != none() {
        out.push_str(in "Some(");
        sym_debug(in ast, node.tail, inout out, inout scratch);
        out.push_str(in ")");
    } else {
        out.push_str(in "None");
    }
    out.push_str(in " }");
}

// ------------------------------------------------------------------ calls

// The graph being built: the key symbol of each entry and, by symbol id,
// whether a name is a known key and the first entry of a method name's
// chain (`method_index`).
struct Calls {
    known: ChunkSeq[u8],
    method_head: ChunkSeq[u32],
    method_next: ChunkSeq[u32],
    method_key: ChunkSeq[u32],
    // The callee keys found so far for one caller, and a mark per symbol.
    out: ChunkSeq[u32],
    seen: ChunkSeq[u8]
}

fn sym_flag(in flags: ChunkSeq[u8], i: u32) -> bool {
    match flags.try_get(widen_u64(i)) {
        Option::Some(v) => v != 0,
        Option::None => false,
    }
}

fn add_callee(inout call_graph: Calls, key: u32) {
    if !sym_flag(in call_graph.seen, key) {
        let ok = call_graph.seen.try_set(widen_u64(key), 1);
        call_graph.out.push(key);
    }
}

// `collect_expr_calls`.
fn calls(in ast: Ast, expr_id: u32, inout call_graph: Calls) {
    let expr = expr_at(in ast, expr_id);
    let kind = expr.kind;
    if kind == 3 {
        let count = list_len(in ast, expr.a);
        for i in 0..count {
            calls(in ast, list_at(in ast, expr.a, i), inout call_graph);
        }
    } else if kind == 4 {
        let count = list_len(in ast, expr.b) / 2;
        for i in 0..count {
            calls(
                in ast,
                list_at(in ast, expr.b, wrapping_add(wrapping_mul(i, 2), 1)),
                inout call_graph
            );
        }
    } else if kind == 5 {
        let count = list_len(in ast, expr.a);
        for i in 0..count {
            calls(in ast, stmt_at(in ast, list_at(in ast, expr.a, i)).value, inout call_graph);
        }
        if expr.b != none() {
            calls(in ast, expr.b, inout call_graph);
        }
    } else if kind == 6 {
        let callee = expr_at(in ast, expr.a);
        if callee.kind == 2 {
            if sym_flag(in call_graph.known, callee.a) {
                add_callee(inout call_graph, callee.a);
            }
        } else if callee.kind == 7 {
            calls(in ast, callee.a, inout call_graph);
            let mut method_entry = match call_graph.method_head.try_get(widen_u64(callee.b)) {
                Option::Some(v) => v,
                Option::None => none(),
            };
            loop {
                if method_entry == none() {
                    break;
                }
                let key = call_graph.method_key.try_get(widen_u64(method_entry)).unwrap_or(0);
                add_callee(inout call_graph, key);
                method_entry = match call_graph.method_next.try_get(widen_u64(method_entry)) {
                    Option::Some(v) => v,
                    Option::None => none(),
                };
            }
            if sym_flag(in call_graph.known, callee.b) {
                add_callee(inout call_graph, callee.b);
            }
        } else {
            calls(in ast, expr.a, inout call_graph);
        }
        let arg_count = list_len(in ast, expr.c);
        for i in 0..arg_count {
            calls(in ast, arg_at(in ast, list_at(in ast, expr.c, i)).expr, inout call_graph);
        }
    } else if kind == 7 || kind == 9 || kind == 17 {
        calls(in ast, expr.a, inout call_graph);
    } else if kind == 10 {
        calls(in ast, expr.b, inout call_graph);
    } else if kind == 8 || kind == 19 {
        calls(in ast, expr.a, inout call_graph);
        calls(in ast, expr.b, inout call_graph);
    } else if kind == 11 || kind == 12 {
        calls(in ast, expr.b, inout call_graph);
        calls(in ast, expr.c, inout call_graph);
    } else if kind == 13 {
        calls(in ast, expr.a, inout call_graph);
        calls(in ast, expr.b, inout call_graph);
        if expr.c != none() {
            calls(in ast, expr.c, inout call_graph);
        }
    } else if kind == 14 {
        calls(in ast, expr.a, inout call_graph);
        let count = list_len(in ast, expr.b) / 2;
        for i in 0..count {
            calls(
                in ast,
                list_at(in ast, expr.b, wrapping_add(wrapping_mul(i, 2), 1)),
                inout call_graph
            );
        }
    } else if kind == 15 {
        calls(in ast, expr.e, inout call_graph);
    } else if kind == 18 {
        calls(in ast, expr.b, inout call_graph);
        calls(in ast, expr.c, inout call_graph);
    } else if kind == 16 {
        if expr.b != none() {
            calls(in ast, expr.c, inout call_graph);
        }
        calls(in ast, expr.d, inout call_graph);
        let count = list_len(in ast, expr.e);
        for i in 0..count {
            calls(in ast, clause_at(in ast, list_at(in ast, expr.e, i)).body, inout call_graph);
        }
    } else if kind == 20 || kind == 21 {
        if expr.a != none() {
            calls(in ast, expr.a, inout call_graph);
        }
    }
}

// ------------------------------------------------------------------ entry

fn grow(inout seq: ChunkSeq[u8], len: u64) {
    loop {
        if seq.len() >= len {
            break;
        }
        seq.push(0);
    }
}

fn grow_u32(inout seq: ChunkSeq[u32], len: u64) {
    loop {
        if seq.len() >= len {
            break;
        }
        seq.push(none());
    }
}

// `FunctionGraph::from_module` over the input words.
// `text` as a text of the result words.
fn put_string(inout res: ChunkSeq[u64], in text: String) {
    let bytes = text.as_bytes();
    put_text(inout res, in bytes, 0, bytes.len());
}

pub fn graph(in input: Slice[u8]) -> ChunkSeq[u64] {
    let mut reader = Reader { pos: 0 };
    let (src_start, src_end) = reader.text(in input);
    let text = match String::from_utf8(in input[src_start..src_end]) {
        Option::Some(decoded) => decoded,
        Option::None => String::new(),
    };
    let mut lowered = lower_source(in text.as_str());
    let mut scratch = String::new();
    let mut key = String::new();
    let mut owner = String::new();
    // The entries: (key symbol, function node) in declaration order.
    let mut keys: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut fns: ChunkSeq[u32] = ChunkSeq::new[u32]();
    // method name symbol, entry index
    let mut methods: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let items = lowered.ast.m_items.len();
    for i in 0..items {
        let item_id = lowered.ast.m_items.try_get(i).unwrap_or(0);
        let item = lowered
            .ast
            .items
            .get_or(idx_from_raw[ItemNode](item_id), ItemNode { kind: 0, node: 0 });
        if item.kind == 2 {
            let func = fn_at(in lowered.ast, item.node);
            keys.push(func.name);
            fns.push(item.node);
        } else if item.kind == 4 {
            let impl_node = lowered.ast.impls.get_or(
                idx_from_raw[ImplNode](item.node),
                ImplNode { ty: 0, generics: 0, methods: 0 }
            );
            // impl_type_key
            owner.clear();
            let owner_ty = type_at(in lowered.ast, impl_node.ty);
            if owner_ty.kind == 1 {
                let ok = lowered.ast.names.resolve_into(symbol_from_id(owner_ty.a), inout owner);
            } else {
                type_text(in lowered.ast, impl_node.ty, inout owner, inout scratch);
            }
            let method_count = list_len(in lowered.ast, impl_node.methods);
            for q in 0..method_count {
                let method_fn = list_at(in lowered.ast, impl_node.methods, q);
                let func = fn_at(in lowered.ast, method_fn);
                key.clear();
                key.push_str(in owner.as_str());
                key.push_str(in "::");
                let ok = lowered.ast.names.resolve_into(symbol_from_id(func.name), inout key);
                let key_sym = lowered.ast.names.intern(in key.as_str()).id();
                methods.push(func.name);
                methods.push(wrapping_u32(keys.len()));
                keys.push(key_sym);
                fns.push(method_fn);
            }
        }
    }
    let sym_count = lowered.ast.names.len();
    let mut call_graph = Calls {
        known: ChunkSeq::new[u8](),
        method_head: ChunkSeq::new[u32](),
        method_next: ChunkSeq::new[u32](),
        method_key: ChunkSeq::new[u32](),
        out: ChunkSeq::new[u32](),
        seen: ChunkSeq::new[u8]()
    };
    grow(inout call_graph.known, sym_count);
    grow(inout call_graph.seen, sym_count);
    grow_u32(inout call_graph.method_head, sym_count);
    let entry_count = keys.len();
    for i in 0..entry_count {
        let key_sym = keys.try_get(i).unwrap_or(0);
        let ok = call_graph.known.try_set(widen_u64(key_sym), 1);
    }
    // The method chains, in reverse so each chain runs in declaration
    // order (the order does not matter to a set).
    let method_pairs = methods.len() / 2;
    for q in 0..method_pairs {
        let name = methods.try_get(wrapping_mul(q, 2)).unwrap_or(0);
        let entry = methods.try_get(wrapping_add(wrapping_mul(q, 2), 1)).unwrap_or(0);
        let key_sym = keys.try_get(widen_u64(entry)).unwrap_or(0);
        let head = match call_graph.method_head.try_get(widen_u64(name)) {
            Option::Some(v) => v,
            Option::None => none(),
        };
        call_graph.method_key.push(key_sym);
        call_graph.method_next.push(head);
        let ok = call_graph.method_head.try_set(widen_u64(name), wrapping_u32(q));
    }
    let mut res: ChunkSeq[u64] = ChunkSeq::new[u64]();
    res.push(0);
    res.push(entry_count);
    let mut bytes: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut hex = String::new();
    for i in 0..entry_count {
        let key_sym = keys.try_get(i).unwrap_or(0);
        let fn_id = fns.try_get(i).unwrap_or(0);
        let func = fn_at(in lowered.ast, fn_id);
        key.clear();
        let ok = lowered.ast.names.resolve_into(symbol_from_id(key_sym), inout key);
        bytes.clear();
        put_function(inout bytes, in lowered.ast, in key.as_bytes(), in func, inout scratch);
        hex.clear();
        digest_hex(blake3(in bytes.as_slice()), inout hex);
        put_string(inout res, in key);
        put_string(inout res, in hex);
        call_graph.out.clear();
        if func.body != none() {
            calls(in lowered.ast, func.body, inout call_graph);
        }
        let callee_count = call_graph.out.len();
        res.push(callee_count);
        for j in 0..callee_count {
            let callee = call_graph.out.try_get(j).unwrap_or(0);
            let ok = call_graph.seen.try_set(widen_u64(callee), 0);
            key.clear();
            let ok2 = lowered.ast.names.resolve_into(symbol_from_id(callee), inout key);
            put_string(inout res, in key);
        }
    }
    res
}
