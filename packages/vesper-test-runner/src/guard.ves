// The fail-closed source profile of `vesper test --doc`: `rust_guard` of
// src/doctest_guard.rs over @vesper/ast's AST of the source. A doctest
// module that parsed without diagnostics must stay under the item, AST
// volume and AST depth limits, use no construct whose checking grows
// inferred composites (generics, nonempty tuples, builtin generic
// constructors, closures, handlers, traits and models), and unfold its
// nominal types within the nominal expansion budget, before the checker
// runs.
//
// The walk is Rust's: one explicit stack of nodes popped last first, so
// the first error found is the same one. Input words: the source,
// `max_declarations` and `max_nominal_expansion`. Result words: the status
// (0 ok, or 1 and the message) (tests/common/doctest_guard_words.rs).

use @vesper/ast::{
    AdtNode, ArgNode, Ast, EffectDeclNode, EffectNode, EffectsNode, FieldNode, FnNode, ImplNode,
    ItemNode, ParamNode, StmtNode, VariantNode, expr_at, list_at, list_len, none, pat_at, type_at
};
use @vesper/ast::lower::{lower_source};
use @vesper-std/arena::{idx_from_raw};
use @vesper-std/intern::{symbol_from_id};
use @vesper-std/bytes::ascii::COLON;
use self::ast_kinds::{
    EXPR_ASSIGN, EXPR_BINARY, EXPR_BLOCK, EXPR_CALL, EXPR_CLOSURE, EXPR_FIELD, EXPR_HANDLE, EXPR_IF,
    EXPR_INDEX, EXPR_MATCH, EXPR_NAME, EXPR_STRUCT, EXPR_TRY, EXPR_TUPLE, EXPR_UNARY, ITEM_ADT,
    ITEM_EFFECT, ITEM_FUNCTION, ITEM_IMPL, PAT_CONSTRUCTOR, PAT_TUPLE, STMT_LET, TYPE_FUNCTION,
    TYPE_INFER, TYPE_NAMED, TYPE_ROW, TYPE_TUPLE
};
use self::util::{PAIR_WORDS, Reader, STATUS_ERROR, STATUS_OK, put_text, sub};

// ------------------------------------------------------------ node access

fn item_at(in a: Ast, i: u32) -> ItemNode {
    a.items.get_or(idx_from_raw[ItemNode](i), ItemNode { kind: 0, node: 0 })
}

fn adt_at(in a: Ast, i: u32) -> AdtNode {
    a.adts.get_or(
        idx_from_raw[AdtNode](i),
        AdtNode {
            name: 0,
            mode: 0,
            generics: none(),
            variants: none(),
            is_enum: false,
            tiled: false,
            tile_width: 0,
            start: 0,
            end: 0
        }
    )
}

fn variant_at(in a: Ast, i: u32) -> VariantNode {
    a.variants.get_or(
        idx_from_raw[VariantNode](i),
        VariantNode { name: 0, fields: none(), named: false }
    )
}

fn field_at(in a: Ast, i: u32) -> FieldNode {
    a.fields.get_or(
        idx_from_raw[FieldNode](i),
        FieldNode { name: 0, ty: none(), modality: 3, temperature: 0 }
    )
}

fn effect_decl_at(in a: Ast, i: u32) -> EffectDeclNode {
    a.effect_decls.get_or(
        idx_from_raw[EffectDeclNode](i),
        EffectDeclNode { name: 0, linear: false, generics: none(), ops: none(), start: 0, end: 0 }
    )
}

fn impl_at(in a: Ast, i: u32) -> ImplNode {
    a.impls.get_or(
        idx_from_raw[ImplNode](i),
        ImplNode { ty: none(), generics: none(), methods: none() }
    )
}

fn fn_at(in a: Ast, i: u32) -> FnNode {
    a.fns.get_or(
        idx_from_raw[FnNode](i),
        FnNode {
            name: 0,
            fip: false,
            generics: none(),
            params: none(),
            result: none(),
            effects: none(),
            body: none(),
            start: 0,
            end: 0
        }
    )
}

fn param_at(in a: Ast, i: u32) -> ParamNode {
    a.params.get_or(
        idx_from_raw[ParamNode](i),
        ParamNode { name: 0, pass: 0, projections: none(), ty: none(), start: 0, end: 0 }
    )
}

fn effects_at(in a: Ast, i: u32) -> EffectsNode {
    a.effects.get_or(idx_from_raw[EffectsNode](i), EffectsNode { instances: none(), tail: none() })
}

fn effect_at(in a: Ast, i: u32) -> EffectNode {
    a.effect_nodes
        .get_or(idx_from_raw[EffectNode](i), EffectNode { label: none(), name: 0, args: none() })
}

fn stmt_at(in a: Ast, i: u32) -> StmtNode {
    a.stmts.get_or(
        idx_from_raw[StmtNode](i),
        StmtNode { kind: 0, pat: none(), ty: none(), value: none(), mutable: false }
    )
}

fn arg_at(in a: Ast, i: u32) -> ArgNode {
    a.args.get_or(idx_from_raw[ArgNode](i), ArgNode { pass: 0, explicit: false, expr: none() })
}

// ---------------------------------------------------------------- errors

// The error codes (0 is ok).
const E_ITEM_LIMIT: u64 = 1;
const E_GENERIC_NOMINAL: u64 = 2;
const E_GENERIC_EFFECT: u64 = 3;
const E_GENERIC_IMPL: u64 = 4;
const E_TRAIT_MODEL: u64 = 5;
const E_VOLUME_LIMIT: u64 = 6;
const E_GENERIC_FUNCTION: u64 = 7;
const E_DEPTH_LIMIT: u64 = 8;
const E_TUPLE_TYPE: u64 = 9;
const E_TYPE_APPLICATION: u64 = 10;
const E_INFERRED_SIGNATURE: u64 = 11;
const E_TUPLE_PATTERN: u64 = 12;
const E_BUILTIN_GROWTH: u64 = 13;
const E_TUPLE: u64 = 14;
const E_CLOSURE_HANDLER: u64 = 15;
const E_BUILTIN_CONSTRUCTOR: u64 = 16;
const E_GENERIC_CALL: u64 = 17;
const E_NOMINAL_LIMIT: u64 = 18;
const E_NOMINAL_DEPTH: u64 = 19;
const E_RECURSIVE_NOMINAL: u64 = 20;

// The messages, by code (0 is ok).
fn message(code: u64) -> Str {
    match code {
        E_ITEM_LIMIT => "doctest parsed module item limit",
        E_GENERIC_NOMINAL => "doctest inferred composite growth: generic nominal types unsupported before checking",
        E_GENERIC_EFFECT => "doctest generic effect declarations unsupported before checking",
        E_GENERIC_IMPL => "doctest generic implementations unsupported before checking",
        E_TRAIT_MODEL => "doctest trait/model inference unsupported before checking",
        E_VOLUME_LIMIT => "doctest parsed AST volume limit",
        E_GENERIC_FUNCTION => "doctest inferred composite growth: generic functions unsupported before checking",
        E_DEPTH_LIMIT => "doctest parsed AST depth limit",
        E_TUPLE_TYPE => "doctest inferred composite growth: nonempty tuple types unsupported before checking",
        E_TYPE_APPLICATION => "doctest inferred composite growth: generic type applications unsupported before checking",
        E_INFERRED_SIGNATURE => "doctest inferred function/field signatures unsupported before checking",
        E_TUPLE_PATTERN => "doctest inferred composite growth: tuple patterns unsupported before checking",
        E_BUILTIN_GROWTH => "doctest inferred composite growth: builtin generic constructors unsupported before checking",
        E_TUPLE => "doctest inferred composite growth: nonempty tuples unsupported before checking",
        E_CLOSURE_HANDLER => "doctest inferred composite growth: closures/handlers unsupported before checking",
        E_BUILTIN_CONSTRUCTOR => "doctest builtin generic constructors unsupported before checking",
        E_GENERIC_CALL => "doctest inferred composite growth: generic calls unsupported before checking",
        E_NOMINAL_LIMIT => "doctest nominal expansion limit",
        E_NOMINAL_DEPTH => "doctest nominal expansion depth limit",
        _ => "recursive nominal doctest types are unsupported before checking",
    }
}

// ------------------------------------------------------------- the walk

// The walk's state: the stack (three words per node: the tag, 1 Expr,
// 2 Type or 3 Pattern, plus 256 when a type may be inferred; the node;
// its depth) and the builtin-constructor answer per symbol (0 not yet
// known, 1 no, 2 yes).
const NODE_WORDS: u64 = 3;
// How far a node's word sits from the end of the stack's last record.
const NODE_WORD_BACK: u64 = 2;
const TAG_EXPR: u64 = 1;
const TAG_TYPE: u64 = 2;
const TAG_PATTERN: u64 = 3;
const TAG_MAY_INFER: u64 = 256;
const TAG_KIND_MASK: u64 = 255;
const BUILTIN_UNKNOWN: u8 = 0;
const BUILTIN_NO: u8 = 1;
const BUILTIN_YES: u8 = 2;

// The AST volume and depth limits, and the depth limit of nominal
// expansion.
const MAX_NODES: u64 = 16384;
const MAX_DEPTH: u64 = 64;
const MAX_NOMINAL_DEPTH: u64 = 48;

struct Walk {
    todo: ChunkSeq[u64],
    builtin: ChunkSeq[u8],
    tmp: String,
    self_sym: u32,
    option_sym: u32,
    result_sym: u32
}

fn push_node(inout w: Walk, tag: u64, node: u32, depth: u64) {
    w.todo.push(tag);
    w.todo.push(widen_u64(node));
    w.todo.push(depth);
}

fn nodes(in w: Walk) -> u64 {
    w.todo.len() / NODE_WORDS
}

// Whether the last `::` segment of the name is Some, None, Ok, Err,
// Option or Result (`builtin_constructor`).
fn builtin(in a: Ast, inout w: Walk, name: u32) -> bool {
    let k = widen_u64(name);
    let known = w.builtin.try_get(k).unwrap_or(0);
    if known != BUILTIN_UNKNOWN {
        return known == BUILTIN_YES;
    }
    w.tmp.clear();
    let ok = a.names.resolve_into(symbol_from_id(name), inout w.tmp);
    let yes = builtin_text(in w.tmp);
    let set = w.builtin.try_set(k, if yes { BUILTIN_YES } else { BUILTIN_NO });
    yes
}

// The length of `::`.
const PATH_SEPARATOR_BYTES: u64 = 2;

fn builtin_text(in s: String) -> bool {
    let b = s.as_bytes();
    let n = b.len();
    // `rsplit("::").next()`: what follows the last `::`.
    let mut start: u64 = 0;
    let mut i = n;
    loop {
        if i < PATH_SEPARATOR_BYTES {
            break;
        }
        let c0 = b.try_get(sub(i, PATH_SEPARATOR_BYTES)).unwrap_or(0);
        let c1 = b.try_get(sub(i, 1)).unwrap_or(0);
        if c0 == COLON && c1 == COLON {
            start = i;
            break;
        }
        i = sub(i, 1);
    }
    let len = sub(n, start);
    if len == 4 {
        segment_is(in b, start, in "Some") || segment_is(in b, start, in "None")
    } else if len == 2 {
        segment_is(in b, start, in "Ok")
    } else if len == 3 {
        segment_is(in b, start, in "Err")
    } else if len == 6 {
        segment_is(in b, start, in "Option") || segment_is(in b, start, in "Result")
    } else {
        false
    }
}

fn segment_is(in b: Slice[u8], start: u64, in w: Str) -> bool {
    let c = w.as_bytes();
    let n = c.len();
    for i in 0..n {
        let x = b.try_get(wrapping_add(start, i)).unwrap_or(0);
        let y = c.try_get(i).unwrap_or(0);
        if x != y {
            return false;
        }
    }
    true
}

// The argument types of the effect instances of `effs`.
fn push_effect_args(in a: Ast, inout w: Walk, effs: u32, depth: u64) {
    let e = effects_at(in a, effs);
    let m = list_len(in a, e.instances);
    for i in 0..m {
        let inst = effect_at(in a, list_at(in a, e.instances, i));
        let k = list_len(in a, inst.args);
        for j in 0..k {
            push_node(inout w, TAG_TYPE, list_at(in a, inst.args, j), depth);
        }
    }
}

// `function`: a function's signature and body onto the stack.
fn function(in a: Ast, inout w: Walk, fi: u32, implicit_self: bool) -> u64 {
    let f = fn_at(in a, fi);
    if list_len(in a, f.generics) != 0 {
        return E_GENERIC_FUNCTION;
    }
    push_node(inout w, TAG_TYPE, f.result, 1);
    let m = list_len(in a, f.params);
    for i in 0..m {
        let p = param_at(in a, list_at(in a, f.params, i));
        if implicit_self && p.name == w.self_sym && type_at(in a, p.ty).kind == TYPE_INFER {
            continue;
        }
        push_node(inout w, TAG_TYPE, p.ty, 1);
    }
    push_effect_args(in a, inout w, f.effects, 1);
    if f.body != none() {
        push_node(inout w, TAG_EXPR, f.body, 1);
    }
    0
}

fn visit_type(in a: Ast, inout w: Walk, t: u32, allow_infer: bool, next: u64) -> u64 {
    let n = type_at(in a, t);
    if n.kind == TYPE_TUPLE {
        if list_len(in a, n.a) != 0 {
            return E_TUPLE_TYPE;
        }
    } else if n.kind == TYPE_NAMED {
        if list_len(in a, n.b) != 0 || n.a == w.option_sym || n.a == w.result_sym {
            return E_TYPE_APPLICATION;
        }
    } else if n.kind == TYPE_INFER {
        if !allow_infer {
            return E_INFERRED_SIGNATURE;
        }
    } else if n.kind == TYPE_FUNCTION {
        let m = list_len(in a, n.a) / PAIR_WORDS;
        for i in 0..m {
            push_node(
                inout w,
                TAG_TYPE,
                list_at(in a, n.a, wrapping_add(wrapping_mul(i, PAIR_WORDS), 1)),
                next
            );
        }
        push_node(inout w, TAG_TYPE, n.b, next);
        push_effect_args(in a, inout w, n.c, next);
    } else if n.kind == TYPE_ROW {
        push_effect_args(in a, inout w, n.a, next);
    }
    0
}

fn visit_pat(in a: Ast, inout w: Walk, p: u32, next: u64) -> u64 {
    let n = pat_at(in a, p);
    if n.kind == PAT_TUPLE {
        if list_len(in a, n.a) != 0 {
            return E_TUPLE_PATTERN;
        }
    } else if n.kind == PAT_CONSTRUCTOR {
        if builtin(in a, inout w, n.a) {
            return E_BUILTIN_GROWTH;
        }
        let m = list_len(in a, n.b) / PAIR_WORDS;
        for i in 0..m {
            push_node(
                inout w,
                TAG_PATTERN,
                list_at(in a, n.b, wrapping_add(wrapping_mul(i, PAIR_WORDS), 1)),
                next
            );
        }
    }
    0
}

fn visit_expr(in a: Ast, inout w: Walk, x: u32, next: u64) -> u64 {
    let e = expr_at(in a, x);
    let k = e.kind;
    if k == EXPR_TUPLE {
        if list_len(in a, e.a) != 0 {
            return E_TUPLE;
        }
    } else if k == EXPR_CLOSURE || k == EXPR_HANDLE {
        return E_CLOSURE_HANDLER;
    } else if k == EXPR_NAME {
        if builtin(in a, inout w, e.a) {
            return E_BUILTIN_GROWTH;
        }
    } else if k == EXPR_STRUCT {
        if builtin(in a, inout w, e.a) {
            return E_BUILTIN_CONSTRUCTOR;
        }
        let m = list_len(in a, e.b) / PAIR_WORDS;
        for i in 0..m {
            push_node(
                inout w,
                TAG_EXPR,
                list_at(in a, e.b, wrapping_add(wrapping_mul(i, PAIR_WORDS), 1)),
                next
            );
        }
    } else if k == EXPR_BLOCK {
        let m = list_len(in a, e.a);
        for i in 0..m {
            let s = stmt_at(in a, list_at(in a, e.a, i));
            if s.kind == STMT_LET {
                push_node(inout w, TAG_PATTERN, s.pat, next);
                push_node(inout w, TAG_TYPE | TAG_MAY_INFER, s.ty, next);
                push_node(inout w, TAG_EXPR, s.value, next);
            } else {
                push_node(inout w, TAG_EXPR, s.value, next);
            }
        }
        if e.b != none() {
            push_node(inout w, TAG_EXPR, e.b, next);
        }
    } else if k == EXPR_CALL {
        if list_len(in a, e.b) != 0 {
            return E_GENERIC_CALL;
        }
        push_node(inout w, TAG_EXPR, e.a, next);
        let m = list_len(in a, e.c);
        for i in 0..m {
            push_node(inout w, TAG_EXPR, arg_at(in a, list_at(in a, e.c, i)).expr, next);
        }
    } else if k == EXPR_FIELD {
        if builtin(in a, inout w, e.b) {
            return E_BUILTIN_GROWTH;
        }
        push_node(inout w, TAG_EXPR, e.a, next);
    } else if k == EXPR_TRY {
        push_node(inout w, TAG_EXPR, e.a, next);
    } else if k == EXPR_UNARY {
        push_node(inout w, TAG_EXPR, e.b, next);
    } else if k == EXPR_BINARY || k == EXPR_ASSIGN {
        push_node(inout w, TAG_EXPR, e.b, next);
        push_node(inout w, TAG_EXPR, e.c, next);
    } else if k == EXPR_INDEX {
        push_node(inout w, TAG_EXPR, e.a, next);
        push_node(inout w, TAG_EXPR, e.b, next);
    } else if k == EXPR_IF {
        push_node(inout w, TAG_EXPR, e.a, next);
        push_node(inout w, TAG_EXPR, e.b, next);
        if e.c != none() {
            push_node(inout w, TAG_EXPR, e.c, next);
        }
    } else if k == EXPR_MATCH {
        push_node(inout w, TAG_EXPR, e.a, next);
        let m = list_len(in a, e.b) / PAIR_WORDS;
        for i in 0..m {
            let q = wrapping_mul(i, PAIR_WORDS);
            push_node(inout w, TAG_PATTERN, list_at(in a, e.b, q), next);
            push_node(inout w, TAG_EXPR, list_at(in a, e.b, wrapping_add(q, 1)), next);
        }
    }
    0
}

// The items and then the stack, as `rust_guard` before
// `nominal_expansion`.
fn walk(in a: Ast, inout w: Walk, max_declarations: u64) -> u64 {
    let items = a.m_items.len();
    if items > max_declarations {
        return E_ITEM_LIMIT;
    }
    for i in 0..items {
        let it = a.m_items.try_get(i).unwrap_or(0);
        let item = item_at(in a, it);
        if item.kind == ITEM_FUNCTION {
            let c = function(in a, inout w, item.node, false);
            if c != 0 {
                return c;
            }
        } else if item.kind == ITEM_ADT {
            let adt = adt_at(in a, item.node);
            if list_len(in a, adt.generics) != 0 {
                return E_GENERIC_NOMINAL;
            }
            let nv = list_len(in a, adt.variants);
            for v in 0..nv {
                let var = variant_at(in a, list_at(in a, adt.variants, v));
                let nf = list_len(in a, var.fields);
                for f in 0..nf {
                    push_node(
                        inout w,
                        TAG_TYPE,
                        field_at(in a, list_at(in a, var.fields, f)).ty,
                        1
                    );
                }
            }
        } else if item.kind == ITEM_EFFECT {
            let d = effect_decl_at(in a, item.node);
            if list_len(in a, d.generics) != 0 {
                return E_GENERIC_EFFECT;
            }
            let m = list_len(in a, d.ops);
            for q in 0..m {
                let c = function(in a, inout w, list_at(in a, d.ops, q), false);
                if c != 0 {
                    return c;
                }
            }
        } else if item.kind == ITEM_IMPL {
            let im = impl_at(in a, item.node);
            if list_len(in a, im.generics) != 0 {
                return E_GENERIC_IMPL;
            }
            push_node(inout w, TAG_TYPE, im.ty, 1);
            let m = list_len(in a, im.methods);
            for q in 0..m {
                let c = function(in a, inout w, list_at(in a, im.methods, q), true);
                if c != 0 {
                    return c;
                }
            }
        } else {
            return E_TRAIT_MODEL;
        }
        if nodes(in w) > MAX_NODES {
            return E_VOLUME_LIMIT;
        }
    }
    let mut count: u64 = 0;
    loop {
        let n = w.todo.len();
        if n < NODE_WORDS {
            break;
        }
        let tag = w.todo.try_get(sub(n, NODE_WORDS)).unwrap_or(0);
        let node = w.todo.try_get(sub(n, NODE_WORD_BACK)).unwrap_or(0);
        let depth = w.todo.try_get(sub(n, 1)).unwrap_or(0);
        w.todo.truncate(sub(n, NODE_WORDS));
        count = wrapping_add(count, 1);
        if count > MAX_NODES {
            return E_VOLUME_LIMIT;
        }
        if depth > MAX_DEPTH {
            return E_DEPTH_LIMIT;
        }
        let next = wrapping_add(depth, 1);
        let id = wrapping_u32(node);
        let kind = tag & TAG_KIND_MASK;
        let c = if kind == TAG_EXPR {
            visit_expr(in a, inout w, id, next)
        } else if kind == TAG_TYPE {
            visit_type(in a, inout w, id, tag >= TAG_MAY_INFER, next)
        } else {
            visit_pat(in a, inout w, id, next)
        };
        if c != 0 {
            return c;
        }
        if wrapping_add(count, nodes(in w)) > MAX_NODES {
            return E_VOLUME_LIMIT;
        }
    }
    0
}

// ---------------------------------------------------- nominal expansion

// `nominal_expansion`'s state: the budget left, the path of ADT names
// being unfolded and the ADT of each name symbol (the last declared one).
struct Nominal {
    remaining: u64,
    path: ChunkSeq[u32],
    adt_of: ChunkSeq[u32]
}

fn on_path(in s: Nominal, name: u32) -> bool {
    let n = s.path.len();
    for i in 0..n {
        let p = match s.path.try_get(i) {
            Option::Some(v) => v,
            Option::None => none(),
        };
        if p == name {
            return true;
        }
    }
    false
}

// `visit` of a `Type::Named(name, args)`, after its budget and depth step.
fn visit_named(in a: Ast, inout s: Nominal, name: u32, args: u32, depth: u64) -> u64 {
    let next = wrapping_add(depth, 1);
    let m = list_len(in a, args);
    for i in 0..m {
        let c = visit_nominal(in a, inout s, list_at(in a, args, i), next);
        if c != 0 {
            return c;
        }
    }
    let adt = match s.adt_of.try_get(widen_u64(name)) {
        Option::Some(v) => v,
        Option::None => none(),
    };
    if adt == none() {
        return 0;
    }
    if on_path(in s, name) {
        return E_RECURSIVE_NOMINAL;
    }
    s.path.push(name);
    let d = adt_at(in a, adt);
    let nv = list_len(in a, d.variants);
    for v in 0..nv {
        let var = variant_at(in a, list_at(in a, d.variants, v));
        let nf = list_len(in a, var.fields);
        for f in 0..nf {
            let ty = field_at(in a, list_at(in a, var.fields, f)).ty;
            let c = visit_nominal(in a, inout s, ty, next);
            if c != 0 {
                return c;
            }
        }
    }
    let n = s.path.len();
    s.path.truncate(sub(n, 1));
    0
}

// The budget and depth step of `visit`.
fn step(inout s: Nominal, depth: u64) -> u64 {
    if s.remaining == 0 {
        return E_NOMINAL_LIMIT;
    }
    s.remaining = sub(s.remaining, 1);
    if depth > MAX_NOMINAL_DEPTH {
        return E_NOMINAL_DEPTH;
    }
    0
}

fn visit_nominal(in a: Ast, inout s: Nominal, t: u32, depth: u64) -> u64 {
    let c = step(inout s, depth);
    if c != 0 {
        return c;
    }
    let n = type_at(in a, t);
    let next = wrapping_add(depth, 1);
    if n.kind == TYPE_NAMED {
        return visit_named(in a, inout s, n.a, n.b, depth);
    } else if n.kind == TYPE_TUPLE {
        let m = list_len(in a, n.a);
        for i in 0..m {
            let c2 = visit_nominal(in a, inout s, list_at(in a, n.a, i), next);
            if c2 != 0 {
                return c2;
            }
        }
    } else if n.kind == TYPE_FUNCTION {
        let m = list_len(in a, n.a) / PAIR_WORDS;
        for i in 0..m {
            let ty = list_at(in a, n.a, wrapping_add(wrapping_mul(i, PAIR_WORDS), 1));
            let c2 = visit_nominal(in a, inout s, ty, next);
            if c2 != 0 {
                return c2;
            }
        }
        return visit_nominal(in a, inout s, n.b, next);
    }
    0
}

// Whether the text of symbol `x` sorts before that of `y` (byte order).
fn text_less(in a: Ast, x: u32, y: u32, inout t1: String, inout t2: String) -> bool {
    t1.clear();
    t2.clear();
    let ok1 = a.names.resolve_into(symbol_from_id(x), inout t1);
    let ok2 = a.names.resolve_into(symbol_from_id(y), inout t2);
    let b1 = t1.as_bytes();
    let b2 = t2.as_bytes();
    let n1 = b1.len();
    let n2 = b2.len();
    let n = if n1 < n2 { n1 } else { n2 };
    for i in 0..n {
        let c1 = b1.try_get(i).unwrap_or(0);
        let c2 = b2.try_get(i).unwrap_or(0);
        if c1 != c2 {
            return c1 < c2;
        }
    }
    n1 < n2
}

fn nominal_expansion(in a: Ast, limit: u64, nsym: u64) -> u64 {
    let mut s = Nominal {
        remaining: limit,
        path: ChunkSeq::new[u32](),
        adt_of: ChunkSeq::new[u32]()
    };
    loop {
        if s.adt_of.len() >= nsym {
            break;
        }
        s.adt_of.push(none());
    }
    // The ADT names, each once.
    let mut names: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let items = a.m_items.len();
    for i in 0..items {
        let it = a.m_items.try_get(i).unwrap_or(0);
        let item = item_at(in a, it);
        if item.kind == ITEM_ADT {
            let name = adt_at(in a, item.node).name;
            let k = widen_u64(name);
            let had = match s.adt_of.try_get(k) {
                Option::Some(v) => v,
                Option::None => none(),
            };
            if had == none() {
                names.push(name);
            }
            let set = s.adt_of.try_set(k, item.node);
        }
    }
    // BTreeMap order: by name text.
    let mut t1 = String::new();
    let mut t2 = String::new();
    let n = names.len();
    for i in 1..n {
        let x = names.try_get(i).unwrap_or(0);
        let mut j = i;
        loop {
            if j == 0 {
                break;
            }
            let y = names.try_get(sub(j, 1)).unwrap_or(0);
            if !text_less(in a, x, y, inout t1, inout t2) {
                break;
            }
            let set = names.try_set(j, y);
            j = sub(j, 1);
        }
        let set2 = names.try_set(j, x);
    }
    for i in 0..n {
        let name = names.try_get(i).unwrap_or(0);
        s.path.clear();
        let c = step(inout s, 0);
        if c != 0 {
            return c;
        }
        let c2 = visit_named(in a, inout s, name, none(), 0);
        if c2 != 0 {
            return c2;
        }
    }
    0
}

// ------------------------------------------------------------------ entry

// `doctest_guard::rust_guard` over the input words.
pub fn guard(in b: Slice[u8]) -> ChunkSeq[u64] {
    let mut r = Reader { pos: 0 };
    let (ss, se) = r.text(in b);
    let max_declarations = r.word(in b);
    let max_nominal = r.word(in b);
    let text = match String::from_utf8(in b[ss..se]) {
        Option::Some(x) => x,
        Option::None => String::new(),
    };
    let mut l = lower_source(in text.as_str());
    let self_sym = l.ast.names.intern(in "self").id();
    let option_sym = l.ast.names.intern(in "Option").id();
    let result_sym = l.ast.names.intern(in "Result").id();
    let nsym = l.ast.names.len();
    let mut w = Walk {
        todo: ChunkSeq::new[u64](),
        builtin: ChunkSeq::new[u8](),
        tmp: String::new(),
        self_sym: self_sym,
        option_sym: option_sym,
        result_sym: result_sym
    };
    loop {
        if w.builtin.len() >= nsym {
            break;
        }
        w.builtin.push(BUILTIN_UNKNOWN);
    }
    let mut code = walk(in l.ast, inout w, max_declarations);
    if code == 0 {
        code = nominal_expansion(in l.ast, max_nominal, nsym);
    }
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    if code == 0 {
        out.push(STATUS_OK);
    } else {
        out.push(STATUS_ERROR);
        let m = message(code).as_bytes();
        put_text(inout out, in m, 0, m.len());
    }
    out
}
