// The fail-closed source profile of `vesper test --doc`: `rust_guard` of
// src/doctest_guard.rs over @vesper/ast's AST of the source. A doctest
// module that parsed without diagnostics must stay under the item, AST
// volume and AST depth limits, use no construct whose checking grows
// inferred composites (generics, nonempty tuples, builtin generic
// constructors, closures, handlers, traits and models), and unfold its
// nominal types within the nominal expansion budget, before the checker
// runs.
//
// The walk is Rust's: one explicit stack of nodes popped last first, so
// the first error found is the same one. Input words: the source,
// `max_declarations` and `max_nominal_expansion`. Result words: the status
// (0 ok, or 1 and the message) (tests/common/doctest_guard_words.rs).

use @vesper/ast::{
    AdtNode, ArgNode, Ast, EffectDeclNode, EffectNode, EffectsNode, FieldNode, FnNode, ImplNode,
    ItemNode, ParamNode, StmtNode, VariantNode, expr_at, list_at, list_len, none, pat_at, type_at
};
use @vesper/ast::lower::{lower_source};
use @vesper-std/arena::{idx_from_raw};
use @vesper-std/intern::{symbol_from_id};
use self::util::{Reader, put_text, sub};

// ------------------------------------------------------------ node access

fn item_at(in ast: Ast, i: u32) -> ItemNode {
    ast.items.get_or(idx_from_raw[ItemNode](i), ItemNode { kind: 0, node: 0 })
}

fn adt_at(in ast: Ast, i: u32) -> AdtNode {
    ast.adts.get_or(
        idx_from_raw[AdtNode](i),
        AdtNode {
            name: 0,
            mode: 0,
            generics: none(),
            variants: none(),
            is_enum: false,
            tiled: false,
            tile_width: 0,
            start: 0,
            end: 0
        }
    )
}

fn variant_at(in ast: Ast, i: u32) -> VariantNode {
    ast.variants.get_or(
        idx_from_raw[VariantNode](i),
        VariantNode { name: 0, fields: none(), named: false }
    )
}

fn field_at(in ast: Ast, i: u32) -> FieldNode {
    ast.fields.get_or(
        idx_from_raw[FieldNode](i),
        FieldNode { name: 0, ty: none(), modality: 3, temperature: 0 }
    )
}

fn effect_decl_at(in ast: Ast, i: u32) -> EffectDeclNode {
    ast.effect_decls.get_or(
        idx_from_raw[EffectDeclNode](i),
        EffectDeclNode { name: 0, linear: false, generics: none(), ops: none(), start: 0, end: 0 }
    )
}

fn impl_at(in ast: Ast, i: u32) -> ImplNode {
    ast.impls.get_or(
        idx_from_raw[ImplNode](i),
        ImplNode { ty: none(), generics: none(), methods: none() }
    )
}

fn fn_at(in ast: Ast, i: u32) -> FnNode {
    ast.fns.get_or(
        idx_from_raw[FnNode](i),
        FnNode {
            name: 0,
            fip: false,
            generics: none(),
            params: none(),
            result: none(),
            effects: none(),
            body: none(),
            start: 0,
            end: 0
        }
    )
}

fn param_at(in ast: Ast, i: u32) -> ParamNode {
    ast.params.get_or(
        idx_from_raw[ParamNode](i),
        ParamNode { name: 0, pass: 0, projections: none(), ty: none(), start: 0, end: 0 }
    )
}

fn effects_at(in ast: Ast, i: u32) -> EffectsNode {
    ast.effects
        .get_or(idx_from_raw[EffectsNode](i), EffectsNode { instances: none(), tail: none() })
}

fn effect_at(in ast: Ast, i: u32) -> EffectNode {
    ast.effect_nodes
        .get_or(idx_from_raw[EffectNode](i), EffectNode { label: none(), name: 0, args: none() })
}

fn stmt_at(in ast: Ast, i: u32) -> StmtNode {
    ast.stmts.get_or(
        idx_from_raw[StmtNode](i),
        StmtNode { kind: 0, pat: none(), ty: none(), value: none(), mutable: false }
    )
}

fn arg_at(in ast: Ast, i: u32) -> ArgNode {
    ast.args.get_or(idx_from_raw[ArgNode](i), ArgNode { pass: 0, explicit: false, expr: none() })
}

// ---------------------------------------------------------------- errors

// The messages, by code (0 is ok).
fn message(code: u64) -> Str {
    match code {
        1 => "doctest parsed module item limit",
        2 => "doctest inferred composite growth: generic nominal types unsupported before checking",
        3 => "doctest generic effect declarations unsupported before checking",
        4 => "doctest generic implementations unsupported before checking",
        5 => "doctest trait/model inference unsupported before checking",
        6 => "doctest parsed AST volume limit",
        7 => "doctest inferred composite growth: generic functions unsupported before checking",
        8 => "doctest parsed AST depth limit",
        9 => "doctest inferred composite growth: nonempty tuple types unsupported before checking",
        10 => "doctest inferred composite growth: generic type applications unsupported before checking",
        11 => "doctest inferred function/field signatures unsupported before checking",
        12 => "doctest inferred composite growth: tuple patterns unsupported before checking",
        13 => "doctest inferred composite growth: builtin generic constructors unsupported before checking",
        14 => "doctest inferred composite growth: nonempty tuples unsupported before checking",
        15 => "doctest inferred composite growth: closures/handlers unsupported before checking",
        16 => "doctest builtin generic constructors unsupported before checking",
        17 => "doctest inferred composite growth: generic calls unsupported before checking",
        18 => "doctest nominal expansion limit",
        19 => "doctest nominal expansion depth limit",
        _ => "recursive nominal doctest types are unsupported before checking",
    }
}

// ------------------------------------------------------------- the walk

// The walk's state: the stack (three words per node: the tag, 1 Expr,
// 2 Type or 3 Pattern, plus 256 when a type may be inferred; the node;
// its depth) and the builtin-constructor answer per symbol (0 not yet
// known, 1 no, 2 yes).
struct Walk {
    todo: ChunkSeq[u64],
    builtin: ChunkSeq[u8],
    scratch: String,
    self_sym: u32,
    option_sym: u32,
    result_sym: u32
}

fn push_node(inout walker: Walk, tag: u64, node: u32, depth: u64) {
    walker.todo.push(tag);
    walker.todo.push(widen_u64(node));
    walker.todo.push(depth);
}

fn nodes(in walker: Walk) -> u64 {
    walker.todo.len() / 3
}

// Whether the last `::` segment of the name is Some, None, Ok, Err,
// Option or Result (`builtin_constructor`).
fn builtin(in ast: Ast, inout walker: Walk, name: u32) -> bool {
    let slot = widen_u64(name);
    let known = walker.builtin.try_get(slot).unwrap_or(0);
    if known != 0 {
        return known == 2;
    }
    walker.scratch.clear();
    let ok = ast.names.resolve_into(symbol_from_id(name), inout walker.scratch);
    let yes = builtin_text(in walker.scratch);
    let set = walker.builtin.try_set(slot, if yes { 2 } else { 1 });
    yes
}

fn builtin_text(in text: String) -> bool {
    let bytes = text.as_bytes();
    let n = bytes.len();
    // `rsplit("::").next()`: what follows the last `::`.
    let mut start: u64 = 0;
    let mut i = n;
    loop {
        if i < 2 {
            break;
        }
        let first_byte = bytes.try_get(sub(i, 2)).unwrap_or(0);
        let second_byte = bytes.try_get(sub(i, 1)).unwrap_or(0);
        if first_byte == 58 && second_byte == 58 {
            start = i;
            break;
        }
        i = sub(i, 1);
    }
    let len = sub(n, start);
    if len == 4 {
        segment_is(in bytes, start, in "Some") || segment_is(in bytes, start, in "None")
    } else if len == 2 {
        segment_is(in bytes, start, in "Ok")
    } else if len == 3 {
        segment_is(in bytes, start, in "Err")
    } else if len == 6 {
        segment_is(in bytes, start, in "Option") || segment_is(in bytes, start, in "Result")
    } else {
        false
    }
}

fn segment_is(in bytes: Slice[u8], start: u64, in text: Str) -> bool {
    let text_bytes = text.as_bytes();
    let n = text_bytes.len();
    for i in 0..n {
        let actual = bytes.try_get(wrapping_add(start, i)).unwrap_or(0);
        let expected = text_bytes.try_get(i).unwrap_or(0);
        if actual != expected {
            return false;
        }
    }
    true
}

// The argument types of the effect instances of `effects`.
fn push_effect_args(in ast: Ast, inout walker: Walk, effects: u32, depth: u64) {
    let node = effects_at(in ast, effects);
    let count = list_len(in ast, node.instances);
    for i in 0..count {
        let instance = effect_at(in ast, list_at(in ast, node.instances, i));
        let arg_count = list_len(in ast, instance.args);
        for j in 0..arg_count {
            push_node(inout walker, 2, list_at(in ast, instance.args, j), depth);
        }
    }
}

// `function`: a function's signature and body onto the stack.
fn function(in ast: Ast, inout walker: Walk, fn_id: u32, implicit_self: bool) -> u64 {
    let func = fn_at(in ast, fn_id);
    if list_len(in ast, func.generics) != 0 {
        return 7;
    }
    push_node(inout walker, 2, func.result, 1);
    let param_count = list_len(in ast, func.params);
    for i in 0..param_count {
        let param = param_at(in ast, list_at(in ast, func.params, i));
        if implicit_self && param.name == walker.self_sym && type_at(in ast, param.ty).kind == 5 {
            continue;
        }
        push_node(inout walker, 2, param.ty, 1);
    }
    push_effect_args(in ast, inout walker, func.effects, 1);
    if func.body != none() {
        push_node(inout walker, 1, func.body, 1);
    }
    0
}

fn visit_type(in ast: Ast, inout walker: Walk, type_id: u32, allow_infer: bool, next: u64) -> u64 {
    let node = type_at(in ast, type_id);
    if node.kind == 2 {
        if list_len(in ast, node.a) != 0 {
            return 9;
        }
    } else if node.kind == 1 {
        if list_len(in ast, node.b) != 0
            || node.a == walker.option_sym
            || node.a == walker.result_sym {
            return 10;
        }
    } else if node.kind == 5 {
        if !allow_infer {
            return 11;
        }
    } else if node.kind == 3 {
        let count = list_len(in ast, node.a) / 2;
        for i in 0..count {
            push_node(
                inout walker,
                2,
                list_at(in ast, node.a, wrapping_add(wrapping_mul(i, 2), 1)),
                next
            );
        }
        push_node(inout walker, 2, node.b, next);
        push_effect_args(in ast, inout walker, node.c, next);
    } else if node.kind == 4 {
        push_effect_args(in ast, inout walker, node.a, next);
    }
    0
}

fn visit_pat(in ast: Ast, inout walker: Walk, pat_id: u32, next: u64) -> u64 {
    let node = pat_at(in ast, pat_id);
    if node.kind == 4 {
        if list_len(in ast, node.a) != 0 {
            return 12;
        }
    } else if node.kind == 5 {
        if builtin(in ast, inout walker, node.a) {
            return 13;
        }
        let count = list_len(in ast, node.b) / 2;
        for i in 0..count {
            push_node(
                inout walker,
                3,
                list_at(in ast, node.b, wrapping_add(wrapping_mul(i, 2), 1)),
                next
            );
        }
    }
    0
}

fn visit_expr(in ast: Ast, inout walker: Walk, expr_id: u32, next: u64) -> u64 {
    let expr = expr_at(in ast, expr_id);
    let kind = expr.kind;
    if kind == 3 {
        if list_len(in ast, expr.a) != 0 {
            return 14;
        }
    } else if kind == 15 || kind == 16 {
        return 15;
    } else if kind == 2 {
        if builtin(in ast, inout walker, expr.a) {
            return 13;
        }
    } else if kind == 4 {
        if builtin(in ast, inout walker, expr.a) {
            return 16;
        }
        let count = list_len(in ast, expr.b) / 2;
        for i in 0..count {
            push_node(
                inout walker,
                1,
                list_at(in ast, expr.b, wrapping_add(wrapping_mul(i, 2), 1)),
                next
            );
        }
    } else if kind == 5 {
        let count = list_len(in ast, expr.a);
        for i in 0..count {
            let stmt = stmt_at(in ast, list_at(in ast, expr.a, i));
            if stmt.kind == 1 {
                push_node(inout walker, 3, stmt.pat, next);
                push_node(inout walker, 2 + 256, stmt.ty, next);
                push_node(inout walker, 1, stmt.value, next);
            } else {
                push_node(inout walker, 1, stmt.value, next);
            }
        }
        if expr.b != none() {
            push_node(inout walker, 1, expr.b, next);
        }
    } else if kind == 6 {
        if list_len(in ast, expr.b) != 0 {
            return 17;
        }
        push_node(inout walker, 1, expr.a, next);
        let count = list_len(in ast, expr.c);
        for i in 0..count {
            push_node(inout walker, 1, arg_at(in ast, list_at(in ast, expr.c, i)).expr, next);
        }
    } else if kind == 7 {
        if builtin(in ast, inout walker, expr.b) {
            return 13;
        }
        push_node(inout walker, 1, expr.a, next);
    } else if kind == 9 {
        push_node(inout walker, 1, expr.a, next);
    } else if kind == 10 {
        push_node(inout walker, 1, expr.b, next);
    } else if kind == 11 || kind == 12 {
        push_node(inout walker, 1, expr.b, next);
        push_node(inout walker, 1, expr.c, next);
    } else if kind == 8 {
        push_node(inout walker, 1, expr.a, next);
        push_node(inout walker, 1, expr.b, next);
    } else if kind == 13 {
        push_node(inout walker, 1, expr.a, next);
        push_node(inout walker, 1, expr.b, next);
        if expr.c != none() {
            push_node(inout walker, 1, expr.c, next);
        }
    } else if kind == 14 {
        push_node(inout walker, 1, expr.a, next);
        let count = list_len(in ast, expr.b) / 2;
        for i in 0..count {
            let pair_at = wrapping_mul(i, 2);
            push_node(inout walker, 3, list_at(in ast, expr.b, pair_at), next);
            push_node(inout walker, 1, list_at(in ast, expr.b, wrapping_add(pair_at, 1)), next);
        }
    }
    0
}

// The items and then the stack, as `rust_guard` before
// `nominal_expansion`.
fn walk(in ast: Ast, inout walker: Walk, max_declarations: u64) -> u64 {
    let items = ast.m_items.len();
    if items > max_declarations {
        return 1;
    }
    for i in 0..items {
        let item_id = ast.m_items.try_get(i).unwrap_or(0);
        let item = item_at(in ast, item_id);
        if item.kind == 2 {
            let code = function(in ast, inout walker, item.node, false);
            if code != 0 {
                return code;
            }
        } else if item.kind == 1 {
            let adt = adt_at(in ast, item.node);
            if list_len(in ast, adt.generics) != 0 {
                return 2;
            }
            let variant_count = list_len(in ast, adt.variants);
            for v in 0..variant_count {
                let variant = variant_at(in ast, list_at(in ast, adt.variants, v));
                let field_count = list_len(in ast, variant.fields);
                for f in 0..field_count {
                    push_node(
                        inout walker,
                        2,
                        field_at(in ast, list_at(in ast, variant.fields, f)).ty,
                        1
                    );
                }
            }
        } else if item.kind == 3 {
            let effect_decl = effect_decl_at(in ast, item.node);
            if list_len(in ast, effect_decl.generics) != 0 {
                return 3;
            }
            let member_count = list_len(in ast, effect_decl.ops);
            for q in 0..member_count {
                let code = function(
                    in ast,
                    inout walker,
                    list_at(in ast, effect_decl.ops, q),
                    false
                );
                if code != 0 {
                    return code;
                }
            }
        } else if item.kind == 4 {
            let impl_node = impl_at(in ast, item.node);
            if list_len(in ast, impl_node.generics) != 0 {
                return 4;
            }
            push_node(inout walker, 2, impl_node.ty, 1);
            let member_count = list_len(in ast, impl_node.methods);
            for q in 0..member_count {
                let code = function(
                    in ast,
                    inout walker,
                    list_at(in ast, impl_node.methods, q),
                    true
                );
                if code != 0 {
                    return code;
                }
            }
        } else {
            return 5;
        }
        if nodes(in walker) > 16384 {
            return 6;
        }
    }
    let mut count: u64 = 0;
    loop {
        let stack_len = walker.todo.len();
        if stack_len < 3 {
            break;
        }
        let tag = walker.todo.try_get(sub(stack_len, 3)).unwrap_or(0);
        let node = walker.todo.try_get(sub(stack_len, 2)).unwrap_or(0);
        let depth = walker.todo.try_get(sub(stack_len, 1)).unwrap_or(0);
        walker.todo.truncate(sub(stack_len, 3));
        count = wrapping_add(count, 1);
        if count > 16384 {
            return 6;
        }
        if depth > 64 {
            return 8;
        }
        let next = wrapping_add(depth, 1);
        let id = wrapping_u32(node);
        let kind = tag & 255;
        let code = if kind == 1 {
            visit_expr(in ast, inout walker, id, next)
        } else if kind == 2 {
            visit_type(in ast, inout walker, id, tag >= 256, next)
        } else {
            visit_pat(in ast, inout walker, id, next)
        };
        if code != 0 {
            return code;
        }
        if wrapping_add(count, nodes(in walker)) > 16384 {
            return 6;
        }
    }
    0
}

// ---------------------------------------------------- nominal expansion

// `nominal_expansion`'s state: the budget left, the path of ADT names
// being unfolded and the ADT of each name symbol (the last declared one).
struct Nominal {
    remaining: u64,
    path: ChunkSeq[u32],
    adt_of: ChunkSeq[u32]
}

fn on_path(in nominal: Nominal, name: u32) -> bool {
    let n = nominal.path.len();
    for i in 0..n {
        let path_name = match nominal.path.try_get(i) {
            Option::Some(v) => v,
            Option::None => none(),
        };
        if path_name == name {
            return true;
        }
    }
    false
}

// `visit` of a `Type::Named(name, args)`, after its budget and depth step.
fn visit_named(in ast: Ast, inout nominal: Nominal, name: u32, args: u32, depth: u64) -> u64 {
    let next = wrapping_add(depth, 1);
    let count = list_len(in ast, args);
    for i in 0..count {
        let code = visit_nominal(in ast, inout nominal, list_at(in ast, args, i), next);
        if code != 0 {
            return code;
        }
    }
    let adt = match nominal.adt_of.try_get(widen_u64(name)) {
        Option::Some(v) => v,
        Option::None => none(),
    };
    if adt == none() {
        return 0;
    }
    if on_path(in nominal, name) {
        return 20;
    }
    nominal.path.push(name);
    let adt_node = adt_at(in ast, adt);
    let variant_count = list_len(in ast, adt_node.variants);
    for v in 0..variant_count {
        let variant = variant_at(in ast, list_at(in ast, adt_node.variants, v));
        let field_count = list_len(in ast, variant.fields);
        for f in 0..field_count {
            let ty = field_at(in ast, list_at(in ast, variant.fields, f)).ty;
            let code = visit_nominal(in ast, inout nominal, ty, next);
            if code != 0 {
                return code;
            }
        }
    }
    let path_len = nominal.path.len();
    nominal.path.truncate(sub(path_len, 1));
    0
}

// The budget and depth step of `visit`.
fn step(inout nominal: Nominal, depth: u64) -> u64 {
    if nominal.remaining == 0 {
        return 18;
    }
    nominal.remaining = sub(nominal.remaining, 1);
    if depth > 48 {
        return 19;
    }
    0
}

fn visit_nominal(in ast: Ast, inout nominal: Nominal, type_id: u32, depth: u64) -> u64 {
    let code = step(inout nominal, depth);
    if code != 0 {
        return code;
    }
    let node = type_at(in ast, type_id);
    let next = wrapping_add(depth, 1);
    if node.kind == 1 {
        return visit_named(in ast, inout nominal, node.a, node.b, depth);
    } else if node.kind == 2 {
        let count = list_len(in ast, node.a);
        for i in 0..count {
            let elem_code = visit_nominal(in ast, inout nominal, list_at(in ast, node.a, i), next);
            if elem_code != 0 {
                return elem_code;
            }
        }
    } else if node.kind == 3 {
        let count = list_len(in ast, node.a) / 2;
        for i in 0..count {
            let ty = list_at(in ast, node.a, wrapping_add(wrapping_mul(i, 2), 1));
            let elem_code = visit_nominal(in ast, inout nominal, ty, next);
            if elem_code != 0 {
                return elem_code;
            }
        }
        return visit_nominal(in ast, inout nominal, node.b, next);
    }
    0
}

// Whether the text of symbol `lhs` sorts before that of `rhs` (byte order).
fn text_less(
    in ast: Ast,
    lhs: u32,
    rhs: u32,
    inout lhs_text: String,
    inout rhs_text: String
) -> bool {
    lhs_text.clear();
    rhs_text.clear();
    let ok1 = ast.names.resolve_into(symbol_from_id(lhs), inout lhs_text);
    let ok2 = ast.names.resolve_into(symbol_from_id(rhs), inout rhs_text);
    let lhs_bytes = lhs_text.as_bytes();
    let rhs_bytes = rhs_text.as_bytes();
    let lhs_len = lhs_bytes.len();
    let rhs_len = rhs_bytes.len();
    let common_len = if lhs_len < rhs_len { lhs_len } else { rhs_len };
    for i in 0..common_len {
        let lhs_byte = lhs_bytes.try_get(i).unwrap_or(0);
        let rhs_byte = rhs_bytes.try_get(i).unwrap_or(0);
        if lhs_byte != rhs_byte {
            return lhs_byte < rhs_byte;
        }
    }
    lhs_len < rhs_len
}

fn nominal_expansion(in ast: Ast, limit: u64, sym_count: u64) -> u64 {
    let mut nominal = Nominal {
        remaining: limit,
        path: ChunkSeq::new[u32](),
        adt_of: ChunkSeq::new[u32]()
    };
    loop {
        if nominal.adt_of.len() >= sym_count {
            break;
        }
        nominal.adt_of.push(none());
    }
    // The ADT names, each once.
    let mut names: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let items = ast.m_items.len();
    for i in 0..items {
        let item_id = ast.m_items.try_get(i).unwrap_or(0);
        let item = item_at(in ast, item_id);
        if item.kind == 1 {
            let name = adt_at(in ast, item.node).name;
            let slot = widen_u64(name);
            let had = match nominal.adt_of.try_get(slot) {
                Option::Some(v) => v,
                Option::None => none(),
            };
            if had == none() {
                names.push(name);
            }
            let set = nominal.adt_of.try_set(slot, item.node);
        }
    }
    // BTreeMap order: by name text.
    let mut lhs_text = String::new();
    let mut rhs_text = String::new();
    let n = names.len();
    for i in 1..n {
        let cur_name = names.try_get(i).unwrap_or(0);
        let mut j = i;
        loop {
            if j == 0 {
                break;
            }
            let prev_name = names.try_get(sub(j, 1)).unwrap_or(0);
            if !text_less(in ast, cur_name, prev_name, inout lhs_text, inout rhs_text) {
                break;
            }
            let set = names.try_set(j, prev_name);
            j = sub(j, 1);
        }
        let set2 = names.try_set(j, cur_name);
    }
    for i in 0..n {
        let name = names.try_get(i).unwrap_or(0);
        nominal.path.clear();
        let code = step(inout nominal, 0);
        if code != 0 {
            return code;
        }
        let named_code = visit_named(in ast, inout nominal, name, none(), 0);
        if named_code != 0 {
            return named_code;
        }
    }
    0
}

// ------------------------------------------------------------------ entry

// `doctest_guard::rust_guard` over the input words.
pub fn guard(in input: Slice[u8]) -> ChunkSeq[u64] {
    let mut reader = Reader { pos: 0 };
    let (src_start, src_end) = reader.text(in input);
    let max_declarations = reader.word(in input);
    let max_nominal = reader.word(in input);
    let text = match String::from_utf8(in input[src_start..src_end]) {
        Option::Some(decoded) => decoded,
        Option::None => String::new(),
    };
    let mut lowered = lower_source(in text.as_str());
    let self_sym = lowered.ast.names.intern(in "self").id();
    let option_sym = lowered.ast.names.intern(in "Option").id();
    let result_sym = lowered.ast.names.intern(in "Result").id();
    let sym_count = lowered.ast.names.len();
    let mut walker = Walk {
        todo: ChunkSeq::new[u64](),
        builtin: ChunkSeq::new[u8](),
        scratch: String::new(),
        self_sym: self_sym,
        option_sym: option_sym,
        result_sym: result_sym
    };
    loop {
        if walker.builtin.len() >= sym_count {
            break;
        }
        walker.builtin.push(0);
    }
    let mut code = walk(in lowered.ast, inout walker, max_declarations);
    if code == 0 {
        code = nominal_expansion(in lowered.ast, max_nominal, sym_count);
    }
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    if code == 0 {
        out.push(0);
    } else {
        out.push(1);
        let message_text = message(code).as_bytes();
        put_text(inout out, in message_text, 0, message_text.len());
    }
    out
}
