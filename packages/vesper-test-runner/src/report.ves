// The text reports of `vesper test` and `vesper test --doc`: `rust_doc_text`,
// `rust_unit_text`, `rust_baseline_text` and `rust_mutants_text` of
// src/test_report.rs.
//
// Input words (tests/common/test_report_words.rs):
// - `doc_text`: the file, the base diagnostic count and each diagnostic,
//   the example count and per example the index, line, column, passed, the
//   message, the engine (0, or 1 and the name) and its diagnostics (count
//   and each). A diagnostic is its line, column, code and message.
// - `unit_text` and `baseline_text`: the file count and per file the
//   display name, the error (0, or 1 and the text), the test count and per
//   test the name, line, column, passed, the message, the engine, the pin
//   and the capsule (each 0, or 1 and the text).
// - `mutants_text`: the mutant count and per mutant the file, line,
//   column, function, original and replacement and the outcome (0 and the
//   killer (0, or 1 and the name), 1 survived, 2 ill-typed), then the
//   killed, survived, ill-typed, tested and total counts.
// Result words: 0 and the text.

use self::util::{Reader, push_decimal, push_range, put_buf, sub};

// `value` in decimal. Below 10^16 the digits are packed into two words, most
// significant in the lowest byte, and pushed in order.
fn decimal(inout out: ChunkSeq[u8], value: u64) {
    if value < 10 {
        out.push(wrapping_u8(wrapping_add(value, 48)));
        return;
    }
    if value >= 10000000000000000 {
        push_decimal(inout out, value);
        return;
    }
    let mut lo: u64 = 0;
    let mut hi: u64 = 0;
    let mut n: u64 = 0;
    let mut rest = value;
    loop {
        let digit_char = wrapping_add(rest % 10, 48);
        hi = wrapping_shl_u64(hi, 8) | wrapping_shr_u64(lo, 56);
        lo = wrapping_shl_u64(lo, 8) | digit_char;
        n = wrapping_add(n, 1);
        rest = rest / 10;
        if rest == 0 {
            break;
        }
    }
    for i in 0..n {
        let out_char = if i >= 8 {
            wrapping_shr_u64(hi, wrapping_u32(wrapping_mul(wrapping_sub(i, 8), 8)))
        } else {
            wrapping_shr_u64(lo, wrapping_u32(wrapping_mul(i, 8)))
        };
        out.push(wrapping_u8(out_char & 255));
    }
}

fn push_str(inout out: ChunkSeq[u8], in text: Str) {
    out.extend(in text.as_bytes());
}

// `input[reader.text()]` appended to `out`.
fn copy_text(inout out: ChunkSeq[u8], inout reader: Reader, in input: Slice[u8]) {
    let (start, end) = reader.text(in input);
    push_range(inout out, in input, start, end);
}

fn result(in out: ChunkSeq[u8]) -> ChunkSeq[u64] {
    let mut words: ChunkSeq[u64] = ChunkSeq::new[u64]();
    words.reserve(wrapping_add(out.len() / 8, 3));
    words.push(0);
    put_buf(inout words, in out);
    words
}

// `{file}:{line}:{column}: `
fn push_place(
    inout out: ChunkSeq[u8],
    in input: Slice[u8],
    file_start: u64,
    file_end: u64,
    line: u64,
    column: u64
) {
    push_range(inout out, in input, file_start, file_end);
    out.push(58);
    decimal(inout out, line);
    out.push(58);
    decimal(inout out, column);
    push_str(inout out, in ": ");
}

// `{file}:{line}:{column}: {code}: {message}\n` for each of `n` diagnostics.
fn diags(
    inout out: ChunkSeq[u8],
    inout reader: Reader,
    in input: Slice[u8],
    file_start: u64,
    file_end: u64
) {
    let n = reader.word(in input);
    for i in 0..n {
        let line = reader.word(in input);
        let column = reader.word(in input);
        push_place(inout out, in input, file_start, file_end, line, column);
        copy_text(inout out, inout reader, in input);
        push_str(inout out, in ": ");
        copy_text(inout out, inout reader, in input);
        out.push(10);
    }
}

// `rust_doc_text` over the input words.
pub fn doc_text(in input: Slice[u8]) -> ChunkSeq[u64] {
    let mut reader = Reader { pos: 0 };
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    out.reserve(input.len());
    let (file_start, file_end) = reader.text(in input);
    diags(inout out, inout reader, in input, file_start, file_end);
    let n = reader.word(in input);
    for i in 0..n {
        let index = reader.word(in input);
        let line = reader.word(in input);
        let column = reader.word(in input);
        let passed = reader.word(in input) != 0;
        push_place(inout out, in input, file_start, file_end, line, column);
        if passed {
            push_str(inout out, in "PASS doctest ");
        } else {
            push_str(inout out, in "FAIL doctest ");
        }
        decimal(inout out, index);
        push_str(inout out, in ": ");
        copy_text(inout out, inout reader, in input);
        if reader.word(in input) != 0 {
            push_str(inout out, in " [");
            copy_text(inout out, inout reader, in input);
            out.push(93);
        }
        out.push(10);
        diags(inout out, inout reader, in input, file_start, file_end);
    }
    result(in out)
}

// An optional text: (present, start, end).
fn optional(inout reader: Reader, in input: Slice[u8]) -> (bool, u64, u64) {
    if reader.word(in input) != 0 {
        let (start, end) = reader.text(in input);
        (true, start, end)
    } else {
        let zero: u64 = 0;
        (false, zero, zero)
    }
}

// `rust_unit_text` over the input words.
pub fn unit_text(in input: Slice[u8]) -> ChunkSeq[u64] {
    let mut reader = Reader { pos: 0 };
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    out.reserve(input.len());
    let mut total: u64 = 0;
    let mut failed: u64 = 0;
    let mut file_errors: u64 = 0;
    let file_count = reader.word(in input);
    for f in 0..file_count {
        let (display_start, display_end) = reader.text(in input);
        let (has_error, error_start, error_end) = optional(inout reader, in input);
        if has_error {
            file_errors = wrapping_add(file_errors, 1);
            push_range(inout out, in input, display_start, display_end);
            push_str(inout out, in ": FAIL: ");
            push_range(inout out, in input, error_start, error_end);
            out.push(10);
        }
        let test_count = reader.word(in input);
        total = wrapping_add(total, test_count);
        for t in 0..test_count {
            let (name_start, name_end) = reader.text(in input);
            let line = reader.word(in input);
            let column = reader.word(in input);
            let passed = reader.word(in input) != 0;
            if !passed {
                failed = wrapping_add(failed, 1);
            }
            let (msg_start, msg_end) = reader.text(in input);
            let (engine_start, engine_end) = reader.text(in input);
            let (has_pin, pin_start, pin_end) = optional(inout reader, in input);
            let (has_capsule, capsule_start, capsule_end) = optional(inout reader, in input);
            if !has_error {
                push_place(inout out, in input, display_start, display_end, line, column);
                if passed {
                    push_str(inout out, in "PASS ");
                } else {
                    push_str(inout out, in "FAIL ");
                }
                push_range(inout out, in input, name_start, name_end);
                push_str(inout out, in " (");
                push_range(inout out, in input, msg_start, msg_end);
                push_str(inout out, in ") [");
                push_range(inout out, in input, engine_start, engine_end);
                push_str(inout out, in "]\n");
                if has_pin {
                    push_str(inout out, in "  pin regression: ");
                    push_range(inout out, in input, pin_start, pin_end);
                    out.push(10);
                }
                if has_capsule {
                    push_str(inout out, in "  replay capsule: ");
                    push_range(inout out, in input, capsule_start, capsule_end);
                    out.push(10);
                }
            }
        }
    }
    push_str(inout out, in "tests: ");
    decimal(inout out, sub(total, failed));
    push_str(inout out, in " passed, ");
    decimal(inout out, failed);
    push_str(inout out, in " failed (");
    decimal(inout out, file_errors);
    push_str(inout out, in " file error(s))\n");
    result(in out)
}

// `rust_baseline_text` over the input words.
pub fn baseline_text(in input: Slice[u8]) -> ChunkSeq[u64] {
    let mut reader = Reader { pos: 0 };
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    out.reserve(input.len());
    let file_count = reader.word(in input);
    for f in 0..file_count {
        let (display_start, display_end) = reader.text(in input);
        let (has_error, error_start, error_end) = optional(inout reader, in input);
        if has_error {
            push_range(inout out, in input, display_start, display_end);
            push_str(inout out, in ": FAIL: ");
            push_range(inout out, in input, error_start, error_end);
            out.push(10);
        }
        let test_count = reader.word(in input);
        for t in 0..test_count {
            let (name_start, name_end) = reader.text(in input);
            let line = reader.word(in input);
            let column = reader.word(in input);
            let passed = reader.word(in input) != 0;
            let (msg_start, msg_end) = reader.text(in input);
            let (engine_start, engine_end) = reader.text(in input);
            let pin = optional(inout reader, in input);
            let capsule = optional(inout reader, in input);
            if !passed {
                push_place(inout out, in input, display_start, display_end, line, column);
                push_str(inout out, in "FAIL ");
                push_range(inout out, in input, name_start, name_end);
                push_str(inout out, in ": ");
                push_range(inout out, in input, msg_start, msg_end);
                out.push(10);
            }
        }
    }
    result(in out)
}

// `rust_mutants_text` over the input words.
pub fn mutants_text(in input: Slice[u8]) -> ChunkSeq[u64] {
    let mut reader = Reader { pos: 0 };
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    out.reserve(input.len());
    let n = reader.word(in input);
    for i in 0..n {
        let (file_start, file_end) = reader.text(in input);
        let line = reader.word(in input);
        let column = reader.word(in input);
        let (func_start, func_end) = reader.text(in input);
        let (orig_start, orig_end) = reader.text(in input);
        let (rep_start, rep_end) = reader.text(in input);
        let outcome = reader.word(in input);
        if outcome == 2 {
            continue;
        }
        let mut has_killer: bool = false;
        let mut killer_start: u64 = 0;
        let mut killer_end: u64 = 0;
        if outcome == 0 {
            let (found, start, end) = optional(inout reader, in input);
            has_killer = found;
            killer_start = start;
            killer_end = end;
        }
        push_place(inout out, in input, file_start, file_end, line, column);
        if outcome == 0 {
            push_str(inout out, in "KILLED ");
        } else {
            push_str(inout out, in "SURVIVED ");
        }
        push_range(inout out, in input, func_start, func_end);
        push_str(inout out, in " (");
        push_range(inout out, in input, orig_start, orig_end);
        push_str(inout out, in " -> ");
        push_range(inout out, in input, rep_start, rep_end);
        out.push(41);
        if outcome == 0 {
            push_str(inout out, in " by ");
            if has_killer {
                push_range(inout out, in input, killer_start, killer_end);
            } else {
                push_str(inout out, in "test");
            }
        }
        out.push(10);
    }
    let killed = reader.word(in input);
    let survived = reader.word(in input);
    let ill_typed = reader.word(in input);
    let tested = reader.word(in input);
    let total = reader.word(in input);
    push_str(inout out, in "mutation gate: ");
    decimal(inout out, killed);
    push_str(inout out, in " killed, ");
    decimal(inout out, survived);
    push_str(inout out, in " survived, ");
    decimal(inout out, ill_typed);
    push_str(inout out, in " ill-typed (of ");
    decimal(inout out, tested);
    out.push(47);
    decimal(inout out, total);
    push_str(inout out, in " candidate(s))\n");
    result(in out)
}
