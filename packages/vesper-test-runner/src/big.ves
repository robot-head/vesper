// The `i128` of `AttrValue::Int` as a sign and a 128-bit magnitude in two
// words (`hi`, `lo`), with `parse_int` and `i128::to_string` of
// crates/vesper-syntax/src/test_attrs.rs and src/test_discovery.rs.

use @vesper-std/bytes::ascii::{
    DIGIT_NINE, DIGIT_ZERO, HYPHEN, LOWER_A, LOWER_F, LOWER_X, UNDERSCORE, UPPER_A, UPPER_F, UPPER_X
};
use self::util::{
    HEX_LETTER_BASE, HEX_PREFIX_BYTES, HEX_UPPER_LETTER_BASE, NOT_A_DIGIT, U32_MASK, add, byte, inc,
    sub
};

// A magnitude in 32-bit limbs: a limb's bits, the limbs of 128 bits, and
// the top bit of the high word's upper limb (a magnitude with it set is past
// `i128::MAX`).
const LIMB_BITS: u32 = 32;
const LIMBS: u64 = 4;
const HIGH_LIMB_SIGN: u64 = 2147483648;

// A signed 128-bit integer: zero is never negative.
pub copy struct Big {
    ok: bool,
    neg: bool,
    hi: u64,
    lo: u64,
}

fn none() -> Big {
    Big { ok: false, neg: false, hi: 0, lo: 0 }
}

// `x * m + a` for a magnitude below 2^127, `m` at most 16 and `a` below
// `m`; `ok` is false past `i128::MAX`.
fn mul_add(x: Big, m: u64, a: u64) -> Big {
    let mask: u64 = U32_MASK;
    let lo_low = wrapping_add(wrapping_mul(x.lo & mask, m), a);
    let lo_high = wrapping_add(wrapping_mul(x.lo >> LIMB_BITS, m), lo_low >> LIMB_BITS);
    let lo = (lo_low & mask) | wrapping_shl_u64(lo_high, LIMB_BITS);
    let carry = lo_high >> LIMB_BITS;
    // x.hi < 2^63 and m <= 16, so the product stays below 2^67: check it
    // in halves.
    let hi_low = wrapping_add(wrapping_mul(x.hi & mask, m), carry);
    let hi_high = wrapping_add(wrapping_mul(x.hi >> LIMB_BITS, m), hi_low >> LIMB_BITS);
    if hi_high >= HIGH_LIMB_SIGN {
        return none();
    }
    Big { ok: true, neg: false, hi: (hi_low & mask) | wrapping_shl_u64(hi_high, LIMB_BITS), lo: lo }
}

fn digit(ascii: u8, hex: bool) -> u64 {
    if ascii >= DIGIT_ZERO && ascii <= DIGIT_NINE {
        widen_u64(wrapping_sub(ascii, DIGIT_ZERO))
    } else if hex && ascii >= LOWER_A && ascii <= LOWER_F {
        widen_u64(wrapping_sub(ascii, HEX_LETTER_BASE))
    } else if hex && ascii >= UPPER_A && ascii <= UPPER_F {
        widen_u64(wrapping_sub(ascii, HEX_UPPER_LETTER_BASE))
    } else {
        NOT_A_DIGIT
    }
}

// `parse_int(raw, negative)`: underscores are dropped, `0x`/`0X` is hex;
// `ok` is false for an empty or invalid spelling or a magnitude past
// `i128::MAX`.
pub fn parse_int(in bytes: Slice[u8], start: u64, end: u64, negative: bool) -> Big {
    // The first two non-underscore bytes decide the radix.
    let mut i = start;
    let mut seen: u64 = 0;
    let mut first_byte: u8 = 0;
    let mut hex = false;
    let mut digits_start = start;
    loop {
        if i >= end || seen >= HEX_PREFIX_BYTES {
            break;
        }
        let cur_byte = byte(in bytes, i);
        if cur_byte != UNDERSCORE {
            if seen == 0 {
                first_byte = cur_byte;
            } else if first_byte == DIGIT_ZERO && (cur_byte == LOWER_X || cur_byte == UPPER_X) {
                hex = true;
                digits_start = inc(i);
            }
            seen = inc(seen);
        }
        i = inc(i);
    }
    let base: u64 = if hex { 16 } else { 10 };
    let mut value = Big { ok: true, neg: false, hi: 0, lo: 0 };
    let mut digits: u64 = 0;
    let mut j = digits_start;
    loop {
        if j >= end {
            break;
        }
        let cur_byte = byte(in bytes, j);
        j = inc(j);
        if cur_byte == UNDERSCORE {
            continue;
        }
        let digit_value = digit(cur_byte, hex);
        if digit_value >= base {
            return none();
        }
        value = mul_add(value, base, digit_value);
        if !value.ok {
            return none();
        }
        digits = inc(digits);
    }
    if digits == 0 {
        return none();
    }
    let zero = value.hi == 0 && value.lo == 0;
    Big { ok: true, neg: negative && !zero, hi: value.hi, lo: value.lo }
}

// `u64::try_from(n)`.
pub fn as_u64(value: Big) -> (bool, u64) {
    if value.neg || value.hi != 0 {
        (false, 0)
    } else {
        (true, value.lo)
    }
}

// Appends the decimal spelling of `value` (`i128::to_string`).
pub fn push_big(inout out: ChunkSeq[u8], value: Big) {
    if value.neg {
        out.push(HYPHEN);
    }
    let mask: u64 = U32_MASK;
    let mut limbs: ChunkSeq[u64] = ChunkSeq::new[u64]();
    limbs.push(value.hi >> LIMB_BITS);
    limbs.push(value.hi & mask);
    limbs.push(value.lo >> LIMB_BITS);
    limbs.push(value.lo & mask);
    let mut digits: ChunkSeq[u8] = ChunkSeq::new[u8]();
    loop {
        let mut rem: u64 = 0;
        let mut nonzero = false;
        for k in 0..LIMBS {
            let limb = limbs.try_get(k).unwrap_or(0);
            let cur = wrapping_shl_u64(rem, LIMB_BITS) | limb;
            let quot = cur / 10;
            rem = cur % 10;
            let ok = limbs.try_set(k, quot);
            if quot != 0 {
                nonzero = true;
            }
        }
        digits.push(wrapping_u8(add(rem, widen_u64(DIGIT_ZERO))));
        if !nonzero {
            break;
        }
    }
    let n = digits.len();
    for k in 0..n {
        let digit_byte = digits.try_get(sub(sub(n, 1), k)).unwrap_or(DIGIT_ZERO);
        out.push(digit_byte);
    }
}
