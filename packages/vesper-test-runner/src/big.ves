// The `i128` of `AttrValue::Int` as a sign and a 128-bit magnitude in two
// words (`hi`, `lo`), with `parse_int` and `i128::to_string` of
// crates/vesper-syntax/src/test_attrs.rs and src/test_discovery.rs.

use @vesper-std/bytes::ascii::{
    DIGIT_NINE, DIGIT_ZERO, HYPHEN, LOWER_A, LOWER_F, LOWER_X, UNDERSCORE, UPPER_A, UPPER_F, UPPER_X
};
use self::util::{
    HEX_LETTER_BASE, HEX_PREFIX_BYTES, HEX_UPPER_LETTER_BASE, NOT_A_DIGIT, U32_MASK, add, byte, inc,
    sub
};

// A magnitude in 32-bit limbs: a limb's bits, the limbs of 128 bits, and
// the top bit of the high word's upper limb (a magnitude with it set is past
// `i128::MAX`).
const LIMB_BITS: u32 = 32;
const LIMBS: u64 = 4;
const HIGH_LIMB_SIGN: u64 = 2147483648;

// A signed 128-bit integer: zero is never negative.
pub copy struct Big {
    ok: bool,
    neg: bool,
    hi: u64,
    lo: u64,
}

fn none() -> Big {
    Big { ok: false, neg: false, hi: 0, lo: 0 }
}

// `x * m + a` for a magnitude below 2^127, `m` at most 16 and `a` below
// `m`; `ok` is false past `i128::MAX`.
fn mul_add(x: Big, m: u64, a: u64) -> Big {
    let mask: u64 = U32_MASK;
    let p0 = wrapping_add(wrapping_mul(x.lo & mask, m), a);
    let p1 = wrapping_add(wrapping_mul(x.lo >> LIMB_BITS, m), p0 >> LIMB_BITS);
    let lo = (p0 & mask) | wrapping_shl_u64(p1, LIMB_BITS);
    let carry = p1 >> LIMB_BITS;
    // x.hi < 2^63 and m <= 16, so the product stays below 2^67: check it
    // in halves.
    let h0 = wrapping_add(wrapping_mul(x.hi & mask, m), carry);
    let h1 = wrapping_add(wrapping_mul(x.hi >> LIMB_BITS, m), h0 >> LIMB_BITS);
    if h1 >= HIGH_LIMB_SIGN {
        return none();
    }
    Big { ok: true, neg: false, hi: (h0 & mask) | wrapping_shl_u64(h1, LIMB_BITS), lo: lo }
}

fn digit(c: u8, hex: bool) -> u64 {
    if c >= DIGIT_ZERO && c <= DIGIT_NINE {
        widen_u64(wrapping_sub(c, DIGIT_ZERO))
    } else if hex && c >= LOWER_A && c <= LOWER_F {
        widen_u64(wrapping_sub(c, HEX_LETTER_BASE))
    } else if hex && c >= UPPER_A && c <= UPPER_F {
        widen_u64(wrapping_sub(c, HEX_UPPER_LETTER_BASE))
    } else {
        NOT_A_DIGIT
    }
}

// `parse_int(raw, negative)`: underscores are dropped, `0x`/`0X` is hex;
// `ok` is false for an empty or invalid spelling or a magnitude past
// `i128::MAX`.
pub fn parse_int(in b: Slice[u8], s: u64, e: u64, negative: bool) -> Big {
    // The first two non-underscore bytes decide the radix.
    let mut i = s;
    let mut seen: u64 = 0;
    let mut c0: u8 = 0;
    let mut hex = false;
    let mut start = s;
    loop {
        if i >= e || seen >= HEX_PREFIX_BYTES {
            break;
        }
        let c = byte(in b, i);
        if c != UNDERSCORE {
            if seen == 0 {
                c0 = c;
            } else if c0 == DIGIT_ZERO && (c == LOWER_X || c == UPPER_X) {
                hex = true;
                start = inc(i);
            }
            seen = inc(seen);
        }
        i = inc(i);
    }
    let base: u64 = if hex { 16 } else { 10 };
    let mut x = Big { ok: true, neg: false, hi: 0, lo: 0 };
    let mut digits: u64 = 0;
    let mut j = start;
    loop {
        if j >= e {
            break;
        }
        let c = byte(in b, j);
        j = inc(j);
        if c == UNDERSCORE {
            continue;
        }
        let d = digit(c, hex);
        if d >= base {
            return none();
        }
        x = mul_add(x, base, d);
        if !x.ok {
            return none();
        }
        digits = inc(digits);
    }
    if digits == 0 {
        return none();
    }
    let zero = x.hi == 0 && x.lo == 0;
    Big { ok: true, neg: negative && !zero, hi: x.hi, lo: x.lo }
}

// `u64::try_from(n)`.
pub fn as_u64(x: Big) -> (bool, u64) {
    if x.neg || x.hi != 0 {
        (false, 0)
    } else {
        (true, x.lo)
    }
}

// Appends the decimal spelling of `x` (`i128::to_string`).
pub fn push_big(inout out: ChunkSeq[u8], x: Big) {
    if x.neg {
        out.push(HYPHEN);
    }
    let mask: u64 = U32_MASK;
    let mut limbs: ChunkSeq[u64] = ChunkSeq::new[u64]();
    limbs.push(x.hi >> LIMB_BITS);
    limbs.push(x.hi & mask);
    limbs.push(x.lo >> LIMB_BITS);
    limbs.push(x.lo & mask);
    let mut digits: ChunkSeq[u8] = ChunkSeq::new[u8]();
    loop {
        let mut r: u64 = 0;
        let mut nonzero = false;
        for k in 0..LIMBS {
            let limb = limbs.try_get(k).unwrap_or(0);
            let cur = wrapping_shl_u64(r, LIMB_BITS) | limb;
            let q = cur / 10;
            r = cur % 10;
            let ok = limbs.try_set(k, q);
            if q != 0 {
                nonzero = true;
            }
        }
        digits.push(wrapping_u8(add(r, widen_u64(DIGIT_ZERO))));
        if !nonzero {
            break;
        }
    }
    let n = digits.len();
    for k in 0..n {
        let c = digits.try_get(sub(sub(n, 1), k)).unwrap_or(DIGIT_ZERO);
        out.push(c);
    }
}
