// The generated module of one doctest example: `rust_generate` of
// src/doctest_generate.rs. The snippet is appended to the file's base
// source; unless it declares items it is wrapped in the entry function
// (with the device effect row of a `sim(...)` fence). A snippet declares
// items when it parses (@vesper/ast) without diagnostics into a module
// with items or model uses, or when its first token starts a declaration
// (@vesper/front's lexer).
//
// Input words: the base, the line count and the lines, the wrapper, the
// entry (0, or 1 and the name), `expected` (0 or 1) and the sim effects
// (0, or 1, their count and the names). Result words: 0, the source, the
// snippet and code starts, the segment count and each (start, end), and
// the entry (0, or 1 and the name) (tests/common/doctest_generate_words.rs).

use @vesper/ast::lower::{lower_source};
use @vesper/front::kinds::{
    k_affine, k_block_comment, k_comment, k_copy, k_effect, k_enum, k_eof, k_fn, k_impl, k_linear,
    k_lower, k_struct, k_whitespace
};
use self::discover::{toks};
use self::util::{Reader, inc, is_text, push_range, put_buf, u8_at, u64_at};

// Whether the first non-trivia token of `raw` starts a declaration.
fn declaration_token(in raw: Slice[u8]) -> bool {
    let tokens = toks(in raw);
    let n = tokens.kind.len();
    let mut i: u64 = 0;
    loop {
        if i >= n {
            return false;
        }
        let kind = u8_at(in tokens.kind, i);
        if kind != k_whitespace()
            && kind != k_comment()
            && kind != k_block_comment()
            && kind != k_eof() {
            break;
        }
        i = inc(i);
    }
    let kind = u8_at(in tokens.kind, i);
    if kind == k_fn()
        || kind == k_copy()
        || kind == k_affine()
        || kind == k_linear()
        || kind == k_struct()
        || kind == k_enum()
        || kind == k_effect()
        || kind == k_impl() {
        return true;
    }
    if kind != k_lower() {
        return false;
    }
    let tok_start = u64_at(in tokens.start, i);
    let tok_end = u64_at(in tokens.end, i);
    is_text(in raw, tok_start, tok_end, in "trait")
        || is_text(in raw, tok_start, tok_end, in "model")
        || is_text(in raw, tok_start, tok_end, in "pub")
}

// `doctest_generate::declaration`.
fn declaration(in raw: ChunkSeq[u8]) -> bool {
    let text = match String::from_utf8(in raw.as_slice()) {
        Option::Some(decoded) => decoded,
        Option::None => String::new(),
    };
    let lowered = lower_source(in text.as_str());
    if lowered.p.d.code.len() == 0
        && (lowered.ast.m_items.len() != 0 || lowered.ast.m_model_uses.len() != 0) {
        return true;
    }
    declaration_token(in raw.as_slice())
}

fn push_str(inout out: ChunkSeq[u8], in text: Str) {
    out.extend(in text.as_bytes());
}

// `rust_generate` over the input words.
pub fn generate(in input: Slice[u8]) -> ChunkSeq[u64] {
    let mut reader = Reader { pos: 0 };
    let (base_start, base_end) = reader.text(in input);
    let line_count = reader.word(in input);
    // The lines' ranges in `input`.
    let mut line_ranges: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut raw: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for i in 0..line_count {
        let (start, end) = reader.text(in input);
        line_ranges.push(start);
        line_ranges.push(end);
        push_range(inout raw, in input, start, end);
        raw.push(10);
    }
    let (wrapper_start, wrapper_end) = reader.text(in input);
    let has_entry = reader.word(in input) != 0;
    let mut entry_start: u64 = 0;
    let mut entry_end: u64 = 0;
    if has_entry {
        let (start, end) = reader.text(in input);
        entry_start = start;
        entry_end = end;
    }
    let expected = reader.word(in input) != 0;
    let has_sim = reader.word(in input) != 0;
    // The sim effect names' ranges in `input`.
    let mut sims: ChunkSeq[u64] = ChunkSeq::new[u64]();
    if has_sim {
        let n = reader.word(in input);
        for i in 0..n {
            let (start, end) = reader.text(in input);
            sims.push(start);
            sims.push(end);
        }
    }
    let mut src: ChunkSeq[u8] = ChunkSeq::new[u8]();
    push_range(inout src, in input, base_start, base_end);
    src.push(10);
    let snippet_start = src.len();
    let declares = declaration(in raw);
    // The entry: (present, from `input` or "main").
    let mut entry: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let has_result_entry = !expected;
    if !expected {
        if has_entry {
            push_range(inout entry, in input, entry_start, entry_end);
        } else if declares {
            push_str(inout entry, in "main");
        } else {
            push_range(inout entry, in input, wrapper_start, wrapper_end);
        }
    }
    if !declares {
        push_str(inout src, in "fn ");
        if has_result_entry {
            src.extend(in entry.as_slice());
        } else {
            push_range(inout src, in input, wrapper_start, wrapper_end);
        }
        push_str(inout src, in "()");
        if has_sim {
            push_str(inout src, in " eff [");
            let n = sims.len() / 2;
            for i in 0..n {
                if i != 0 {
                    push_str(inout src, in ", ");
                }
                let start = u64_at(in sims, wrapping_mul(i, 2));
                let end = u64_at(in sims, inc(wrapping_mul(i, 2)));
                push_range(inout src, in input, start, end);
            }
            push_str(inout src, in "]");
        }
        push_str(inout src, in " {\n");
    }
    let code_start = src.len();
    let mut segs: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for i in 0..line_count {
        let start = u64_at(in line_ranges, wrapping_mul(i, 2));
        let end = u64_at(in line_ranges, inc(wrapping_mul(i, 2)));
        segs.push(src.len());
        push_range(inout src, in input, start, end);
        segs.push(src.len());
        src.push(10);
    }
    if !declares {
        push_str(inout src, in "}\n");
    }
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    out.push(0);
    put_buf(inout out, in src);
    out.push(snippet_start);
    out.push(code_start);
    out.push(line_count);
    let seg_words = segs.len();
    for i in 0..seg_words {
        out.push(u64_at(in segs, i));
    }
    if has_result_entry {
        out.push(1);
        put_buf(inout out, in entry);
    } else {
        out.push(0);
    }
    out
}
