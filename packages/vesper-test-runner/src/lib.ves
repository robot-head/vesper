// @vesper/test-runner: the test runner of `vesper test` in Vesper
// (self-hosting wave SH5 lane 14, #1337). Part 1 is discovery: the
// `// @case` rows of a source and their wrapper functions, the
// `@test`/`@test_case` attributes (crates/vesper-syntax/src/test_attrs.rs,
// over @vesper/front's lexer), which functions are tests, and each test's
// Anvil harness plan (`classify` of crates/vesper-test). Execution (the JIT,
// the evaluator and SimPulse) stays in Rust.
//
// Rust stays the default: src/test_discovery.rs is the swap point, the
// hybrid Stage 2 build installs this package there, and
// tests/self_host_test_runner.rs runs both on the repository's corpus.
//
// - util.ves: bytes, text and the input/result words.
// - ast_kinds.ves: the node kind numbers of @vesper/ast.
// - big.ves: the `i128` of integer attribute values.
// - attrs.ves: `extract_test_attrs`.
// - discover.ves: `case_rows`, `discover` and `classify`.
// - doctest.ves: doctest fence extraction and the token preflight of
//   `vesper test --doc` (src/doctest_extract.rs).
// - mutants.ves: the mutation sites of `vesper test --mutate`
//   (src/test_mutants.rs), over @vesper/ast.
// - graph.ves: the Anvil function graph and per-function BLAKE3 digests
//   (`FunctionGraph::from_module` of src/anvil_hash.rs), over @vesper/ast
//   and @vesper-std/hash.
// - generate.ves: the generated module of a doctest example
//   (src/doctest_generate.rs), over @vesper/ast and @vesper/front.
// - verdict.ves: the doctest wrapper names and per-example verdicts
//   before execution (src/doctest_verdict.rs).
// - report.ves: the text reports of `vesper test` and `vesper test --doc`
//   (src/test_report.rs).
// - guard.ves: the fail-closed source profile a doctest module passes
//   before checking (src/doctest_guard.rs), over @vesper/ast.

use self::discover::{case_rows, discover};
use self::doctest::{extract, preflight};
use self::graph::{graph};
use self::generate::{generate};
use self::guard::{guard};
use self::report::{baseline_text, doc_text, mutants_text, unit_text};
use self::verdict::{verdict, wrappers};
use self::mutants::{collect};

// The word format of the entries; tests/common/test_runner_words.rs
// checks it.
pub fn format() -> u64 {
    1
}

// `test_discovery::case_rows` over the input words.
pub fn case_rows_words(in input: Slice[u8]) -> ChunkSeq[u64] {
    case_rows(in input)
}

// `test_discovery::discover` over the input words.
pub fn discover_words(in input: Slice[u8]) -> ChunkSeq[u64] {
    discover(in input)
}

// The same entries taking `in Str`, for the JIT harness.
pub fn case_rows_str(in input: Str) -> ChunkSeq[u64] {
    case_rows(in input.as_bytes())
}

pub fn discover_str(in input: Str) -> ChunkSeq[u64] {
    discover(in input.as_bytes())
}

// `doctest_extract::preflight` over the input words.
pub fn doctest_preflight_words(in input: Slice[u8]) -> ChunkSeq[u64] {
    preflight(in input)
}

// `doctest_extract::extract` over the input words.
pub fn doctest_extract_words(in input: Slice[u8]) -> ChunkSeq[u64] {
    extract(in input)
}

pub fn doctest_preflight_str(in input: Str) -> ChunkSeq[u64] {
    preflight(in input.as_bytes())
}

pub fn doctest_extract_str(in input: Str) -> ChunkSeq[u64] {
    extract(in input.as_bytes())
}

// `test_mutants::collect` over the input words.
pub fn mutants_words(in input: Slice[u8]) -> ChunkSeq[u64] {
    collect(in input)
}

pub fn mutants_str(in input: Str) -> ChunkSeq[u64] {
    collect(in input.as_bytes())
}

// `anvil_hash::FunctionGraph::from_module` of a source.
pub fn anvil_graph_words(in input: Slice[u8]) -> ChunkSeq[u64] {
    graph(in input)
}

pub fn anvil_graph_str(in input: Str) -> ChunkSeq[u64] {
    graph(in input.as_bytes())
}

// `doctest_guard::rust_guard` of a source under the given limits.
pub fn doctest_guard_words(in input: Slice[u8]) -> ChunkSeq[u64] {
    guard(in input)
}

pub fn doctest_guard_str(in input: Str) -> ChunkSeq[u64] {
    guard(in input.as_bytes())
}

// `doctest_generate::rust_generate` of one example.
pub fn doctest_generate_words(in input: Slice[u8]) -> ChunkSeq[u64] {
    generate(in input)
}

pub fn doctest_generate_str(in input: Str) -> ChunkSeq[u64] {
    generate(in input.as_bytes())
}

// `doctest_verdict::rust_wrappers` of a file's examples.
pub fn doctest_wrappers_words(in input: Slice[u8]) -> ChunkSeq[u64] {
    wrappers(in input)
}

pub fn doctest_wrappers_str(in input: Str) -> ChunkSeq[u64] {
    wrappers(in input.as_bytes())
}

// `doctest_verdict::rust_verdict` of one checked example.
pub fn doctest_verdict_words(in input: Slice[u8]) -> ChunkSeq[u64] {
    verdict(in input)
}

pub fn doctest_verdict_str(in input: Str) -> ChunkSeq[u64] {
    verdict(in input.as_bytes())
}

// `test_report::rust_doc_text`: the lines of one file's doctests.
pub fn report_doc_text_words(in input: Slice[u8]) -> ChunkSeq[u64] {
    doc_text(in input)
}

pub fn report_doc_text_str(in input: Str) -> ChunkSeq[u64] {
    doc_text(in input.as_bytes())
}

// `test_report::rust_unit_text`: the unit-test lines and summary.
pub fn report_unit_text_words(in input: Slice[u8]) -> ChunkSeq[u64] {
    unit_text(in input)
}

pub fn report_unit_text_str(in input: Str) -> ChunkSeq[u64] {
    unit_text(in input.as_bytes())
}

// `test_report::rust_baseline_text`: the failing baseline lines of the mutation gate.
pub fn report_baseline_text_words(in input: Slice[u8]) -> ChunkSeq[u64] {
    baseline_text(in input)
}

pub fn report_baseline_text_str(in input: Str) -> ChunkSeq[u64] {
    baseline_text(in input.as_bytes())
}

// `test_report::rust_mutants_text`: the mutant lines and summary.
pub fn report_mutants_text_words(in input: Slice[u8]) -> ChunkSeq[u64] {
    mutants_text(in input)
}

pub fn report_mutants_text_str(in input: Str) -> ChunkSeq[u64] {
    mutants_text(in input.as_bytes())
}
