// Byte, text and word helpers. Indices stay far below 2^32 (test sources
// are at most 512 KiB), so arithmetic on them is `wrapping_*`.

use @vesper-std/bytes::ascii::{DIGIT_NINE, DIGIT_ZERO, LOWER_A, LOWER_Z, NEWLINE, UPPER_A, UPPER_Z};

// The status word that starts a result (`status` of
// tests/common/test_runner_words.rs and its siblings): ok, or an error
// and its message.
pub const STATUS_OK: u64 = 0;
pub const STATUS_ERROR: u64 = 1;

// A word's bytes and bits, a byte's bits, the shift of a word's top
// byte, and what rounds a byte length up to whole words (`WORD_BYTES - 1`).
pub const WORD_BYTES: u64 = 8;
pub const WORD_BITS: u32 = 64;
pub const BYTE_BITS: u32 = 8;
pub const TOP_BYTE_SHIFT: u32 = 56;
const WORD_ROUND_UP: u64 = 7;
// The low 32 bits of a word (`n as u32`).
pub const U32_MASK: u64 = 4294967295;
// A (start, end) range or another pair, as two words of a sequence.
pub const PAIR_WORDS: u64 = 2;

// Hex digits: subtracted from `a`-`f` and `A`-`F` to give 10 to 15
// (`'a' - 10`, `'A' - 10`), the bytes of a `0x` prefix, and a digit value
// past every radix for a byte that is no digit.
pub const HEX_LETTER_BASE: u8 = 87;
pub const HEX_UPPER_LETTER_BASE: u8 = 55;
pub const HEX_PREFIX_BYTES: u64 = 2;
pub const NOT_A_DIGIT: u64 = 99;

pub fn inc(x: u64) -> u64 {
    wrapping_add(x, 1)
}

pub fn add(a: u64, b: u64) -> u64 {
    wrapping_add(a, b)
}

pub fn sub(a: u64, b: u64) -> u64 {
    wrapping_sub(a, b)
}

pub fn byte(in bytes: Slice[u8], i: u64) -> u8 {
    bytes.try_get(i).unwrap_or(0)
}

pub fn u8_at(in seq: ChunkSeq[u8], i: u64) -> u8 {
    seq.try_get(i).unwrap_or(0)
}

pub fn u64_at(in seq: ChunkSeq[u64], i: u64) -> u64 {
    seq.try_get(i).unwrap_or(0)
}

pub fn bit(flag: bool) -> u64 {
    if flag { 1 } else { 0 }
}

// Whether `lhs[lhs_start..lhs_end]` and `rhs[rhs_start..rhs_end]` hold the same bytes.
pub fn same(
    in lhs: Slice[u8],
    lhs_start: u64,
    lhs_end: u64,
    in rhs: Slice[u8],
    rhs_start: u64,
    rhs_end: u64
) -> bool {
    if sub(lhs_end, lhs_start) != sub(rhs_end, rhs_start) {
        return false;
    }
    let n = sub(lhs_end, lhs_start);
    for i in 0..n {
        if byte(in lhs, add(lhs_start, i)) != byte(in rhs, add(rhs_start, i)) {
            return false;
        }
    }
    true
}

// Whether `bytes[start..end]` is `text`.
pub fn is_text(in bytes: Slice[u8], start: u64, end: u64, in text: Str) -> bool {
    let text_bytes = text.as_bytes();
    same(in bytes, start, end, in text_bytes, 0, text_bytes.len())
}

// Whether `bytes[start..end]` starts with `text`.
pub fn starts_with(in bytes: Slice[u8], start: u64, end: u64, in text: Str) -> bool {
    let text_bytes = text.as_bytes();
    if sub(end, start) < text_bytes.len() {
        return false;
    }
    same(in bytes, start, add(start, text_bytes.len()), in text_bytes, 0, text_bytes.len())
}

pub fn is_alpha(c: u8) -> bool {
    (c >= UPPER_A && c <= UPPER_Z) || (c >= LOWER_A && c <= LOWER_Z)
}

pub fn is_digit(c: u8) -> bool {
    c >= DIGIT_ZERO && c <= DIGIT_NINE
}

pub fn is_alnum(c: u8) -> bool {
    is_alpha(c) || is_digit(c)
}

// The scalar value of the UTF-8 character at `i` (sources are valid
// UTF-8) and its length in bytes.
pub fn char_at(in bytes: Slice[u8], i: u64) -> (u64, u64) {
    let lead = widen_u64(byte(in bytes, i));
    if lead < 128 {
        (lead, 1)
    } else if lead < 224 {
        let second = widen_u64(byte(in bytes, inc(i))) & 63;
        (((lead & 31) << 6) | second, 2)
    } else if lead < 240 {
        let second = widen_u64(byte(in bytes, inc(i))) & 63;
        let third = widen_u64(byte(in bytes, add(i, 2))) & 63;
        (((lead & 15) << 12) | (second << 6) | third, 3)
    } else {
        let second = widen_u64(byte(in bytes, inc(i))) & 63;
        let third = widen_u64(byte(in bytes, add(i, 2))) & 63;
        let fourth = widen_u64(byte(in bytes, add(i, 3))) & 63;
        (((lead & 7) << 18) | (second << 12) | (third << 6) | fourth, 4)
    }
}

// Rust's `char::is_whitespace` (the Unicode White_Space property).
pub fn is_space_char(c: u64) -> bool {
    if c >= 9 && c <= 13 {
        return true;
    }
    if c >= 8192 && c <= 8202 {
        return true;
    }
    match c {
        32 => true,
        133 => true,
        160 => true,
        5760 => true,
        8232 => true,
        8233 => true,
        8239 => true,
        8287 => true,
        12288 => true,
        _ => false,
    }
}

pub fn is_continuation(c: u8) -> bool {
    c >= 128 && c < 192
}

// `str::trim_start`: the first byte of `bytes[start..end]` that starts a
// non-whitespace character, else `end`.
pub fn trim_start(in bytes: Slice[u8], start: u64, end: u64) -> u64 {
    let mut i = start;
    loop {
        if i >= end {
            break;
        }
        let (code_point, char_len) = char_at(in bytes, i);
        if !is_space_char(code_point) {
            break;
        }
        i = add(i, char_len);
    }
    i
}

// `str::trim_end`: the end of `bytes[start..end]` without trailing whitespace.
pub fn trim_end(in bytes: Slice[u8], start: u64, end: u64) -> u64 {
    let mut trimmed_end = end;
    loop {
        if trimmed_end <= start {
            break;
        }
        let mut char_start = sub(trimmed_end, 1);
        loop {
            if char_start <= start || !is_continuation(byte(in bytes, char_start)) {
                break;
            }
            char_start = sub(char_start, 1);
        }
        let (code_point, char_len) = char_at(in bytes, char_start);
        if !is_space_char(code_point) {
            break;
        }
        trimmed_end = char_start;
    }
    trimmed_end
}

// Whether `bytes[start..end]` starts with a whitespace character.
pub fn starts_with_space(in bytes: Slice[u8], start: u64, end: u64) -> bool {
    if start >= end {
        return false;
    }
    let (code_point, char_len) = char_at(in bytes, start);
    is_space_char(code_point)
}

// The 1-based line and column (in characters) of byte `offset`
// (`location` of src/test_discovery.rs).
pub fn location(in bytes: Slice[u8], offset: u64) -> (u64, u64) {
    let mut end = offset;
    if end > bytes.len() {
        end = bytes.len();
    }
    loop {
        if end == 0 || end >= bytes.len() || !is_continuation(byte(in bytes, end)) {
            break;
        }
        end = sub(end, 1);
    }
    let mut line: u64 = 1;
    let mut column: u64 = 1;
    for i in 0..end {
        let cur_byte = byte(in bytes, i);
        if cur_byte == NEWLINE {
            line = inc(line);
            column = 1;
        } else if !is_continuation(cur_byte) {
            column = inc(column);
        }
    }
    (line, column)
}

pub fn push_decimal(inout out: ChunkSeq[u8], value: u64) {
    if value >= 10 {
        push_decimal(inout out, value / 10);
    }
    out.push(wrapping_u8(wrapping_add(value % 10, widen_u64(DIGIT_ZERO))));
}

pub fn push_range(inout out: ChunkSeq[u8], in bytes: Slice[u8], start: u64, end: u64) {
    if start < end {
        out.extend(in bytes[start..end]);
    }
}

// The input words: little-endian u64s, and texts as a byte length and the
// bytes padded to whole words (`Words::text` in
// tests/common/test_runner_words.rs).
pub struct Reader {
    pos: u64,
}

impl Reader {
    pub fn word(inout self, in input: Slice[u8]) -> u64 {
        let value = input.try_read_u64_le(self.pos).unwrap_or(0);
        self.pos = add(self.pos, WORD_BYTES);
        value
    }

    // A text: its range in `input`.
    pub fn text(inout self, in input: Slice[u8]) -> (u64, u64) {
        let len = self.word(in input);
        let start = self.pos;
        self.pos = add(start, wrapping_mul(add(len, WORD_ROUND_UP) / WORD_BYTES, WORD_BYTES));
        (start, add(start, len))
    }
}

// The result words (decoded by `test_runner_words.rs`).
pub fn put_text(inout out: ChunkSeq[u64], in bytes: Slice[u8], start: u64, end: u64) {
    let n = sub(end, start);
    out.push(n);
    // Whole words straight from `bytes`, then the tail byte by byte.
    let mut pos = start;
    loop {
        if add(pos, WORD_BYTES) > end {
            break;
        }
        match bytes.try_read_u64_le(pos) {
            Option::Some(word) => out.push(word),
            Option::None => out.push(0),
        }
        pos = add(pos, WORD_BYTES);
    }
    if pos < end {
        let mut word: u64 = 0;
        let mut tail_len: u64 = 0;
        loop {
            if pos >= end {
                break;
            }
            let cur_byte = widen_u64(byte(in bytes, pos));
            word = word
                | wrapping_shl_u64(
                    cur_byte,
                    wrapping_u32(wrapping_mul(tail_len, widen_u64(BYTE_BITS)))
                );
            tail_len = inc(tail_len);
            pos = inc(pos);
        }
        out.push(word);
    }
}

pub fn put_buf(inout out: ChunkSeq[u64], in buf: ChunkSeq[u8]) {
    put_text(inout out, in buf.as_slice(), 0, buf.len());
}
