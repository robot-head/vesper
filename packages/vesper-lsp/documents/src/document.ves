// `DocumentStore` of crates/vesper-lsp/src/document.rs: transactional,
// bounded, UTF-16 in-memory documents over the span port's line table.
//
// The data design is flat: every URI and text lives in one `String` arena
// (`pool`) and a document is a row of offsets, lengths, its version and
// revision. A change builds its candidate texts in scratch strings and
// appends the accepted one to the arena, so a refused change leaves every
// row as it was (Rust keeps the old `Arc<str>` the same way). The arena is
// compacted when its dead bytes outgrow the live ones.
use @vesper/span::{Limits, Position, Range, line_table, span};
use @vesper/span::Error as SpanError;

// `StoreError`, variant for variant (prefixed: variants share one
// namespace).
pub copy enum StoreError {
    SInvalidLimits,
    SInvalidUri,
    SAlreadyOpen,
    SNotOpen,
    SVersion,
    SDocumentLimit,
    STotalLimit,
    SChangeLimit,
    SWorkLimit,
    SRevisionOverflow,
    SRangeLength,
    SAllocation,
    SIndex(SpanError)
}

// `StoreLimits`.
pub copy struct StoreLimits {
    max_document_bytes: u64,
    max_documents: u64,
    max_total_bytes: u64,
    max_uri_bytes: u64,
    max_changes: u64,
    max_work: u64,
    index: Limits
}

// `size_of::<Line>()` of vesper-span: two `usize`s.
const LINE_SIZE: u64 = 16;
const U64_MAX: u64 = 18446744073709551615;
// Compact the arena once it holds more than this many dead bytes and more
// dead than live ones.
const COMPACT_SLACK: u64 = 65536;

// `StoreLimits::HARD` (the index limits are `hard_index`).
enum Hard: _ {
    DocumentBytes = 1048576,
    Documents = 256,
    TotalBytes = 16777216,
    UriBytes = 16384,
    Changes = 4096,
    Work = 134217728
}

// The work a mutation charges per byte: `open` per text byte, `change` per
// byte of the old text it copies, of the text a range is resolved in and
// of each candidate text.
enum Cost: _ {
    Open = 3,
    Copy = 2,
    Range = 2,
    Candidate = 4
}

// The bytes `char::is_control` looks at in UTF-8: the C0 controls end at
// the space, DEL, and the C1 controls U+0080 to U+009F are `C2 80` to
// `C2 9F`.
enum Control: _ {
    C0End = 0x20,
    Del = 0x7f,
    C1Lead = 0xc2,
    C1First = 0x80,
    C1End = 0xa0
}

pub struct Store {
    limits: StoreLimits,
    pool: String,
    uri_off: ChunkSeq[u64],
    uri_len: ChunkSeq[u64],
    text_off: ChunkSeq[u64],
    text_len: ChunkSeq[u64],
    versions: ChunkSeq[i64],
    revisions: ChunkSeq[u64],
    total: u64,
    revision: u64,
    live_bytes: u64
}

// One `ContentChange`: an optional range, an optional range length and the
// text.
pub struct Change {
    has_range: bool,
    range: Range,
    has_len: bool,
    len: u64,
    text: String
}

fn w(in seq: ChunkSeq[u64], i: u64) -> u64 {
    seq.try_get(i).unwrap_or(0)
}

fn hard_index() -> Limits {
    Limits {
        max_source_bytes: 1048576,
        max_lines: 262145,
        max_metadata_bytes: 16777216,
        max_work: 67108864,
        max_edits: 4096,
        max_output_bytes: 2097152,
        max_diagnostics: 4096,
        max_labels: 16384,
        max_fixes: 4096,
        max_text_bytes: 2097152
    }
}

fn index_valid(in index_limits: Limits) -> bool {
    let hard = hard_index();
    index_limits.max_source_bytes <= hard.max_source_bytes
        && index_limits.max_lines <= hard.max_lines
        && index_limits.max_metadata_bytes <= hard.max_metadata_bytes
        && index_limits.max_work <= hard.max_work
        && index_limits.max_edits <= hard.max_edits
        && index_limits.max_output_bytes <= hard.max_output_bytes
        && index_limits.max_diagnostics <= hard.max_diagnostics
        && index_limits.max_labels <= hard.max_labels
        && index_limits.max_fixes <= hard.max_fixes
        && index_limits.max_text_bytes <= hard.max_text_bytes
}

// `StoreLimits::validate`.
fn validate(limits: StoreLimits) -> Unit eff [Fail[StoreError]] {
    if !index_valid(in limits.index) {
        Fail::raise(StoreError::SIndex(SpanError::InvalidLimits));
    }
    if limits.max_document_bytes > Hard::DocumentBytes
        || limits.max_document_bytes > widen_u64(limits.index.max_source_bytes)
        || limits.max_documents > Hard::Documents
        || limits.max_total_bytes > Hard::TotalBytes
        || limits.max_uri_bytes > Hard::UriBytes
        || limits.max_changes > Hard::Changes
        || limits.max_work > Hard::Work {
        Fail::raise(StoreError::SInvalidLimits);
    }
}

// `DocumentStore::new`.
pub fn store_new(limits: StoreLimits) -> Store eff [Fail[StoreError]] {
    validate(limits);
    Store {
        limits: limits,
        pool: String::new(),
        uri_off: ChunkSeq::new(),
        uri_len: ChunkSeq::new(),
        text_off: ChunkSeq::new(),
        text_len: ChunkSeq::new(),
        versions: ChunkSeq::new(),
        revisions: ChunkSeq::new(),
        total: 0,
        revision: 0,
        live_bytes: 0
    }
}

// `Work`: a per-mutation allowance.
copy struct Work {
    left: u64
}

fn spend(inout work: Work, n: u64) -> Unit eff [Fail[StoreError]] {
    if n > work.left {
        Fail::raise(StoreError::SWorkLimit);
    }
    work.left = wrapping_sub(work.left, n);
}

fn mul(a: u64, b: u64) -> u64 eff [Fail[StoreError]] {
    let (lo, hi) = mul_wide(a, b);
    if hi != 0 {
        Fail::raise(StoreError::SWorkLimit);
    }
    lo
}

// `char::is_control` over UTF-8: C0 controls, DEL and the C1 controls
// (U+0080 to U+009F, encoded `C2 80` to `C2 9F`).
fn has_control(in uri: Str) -> bool {
    let bytes = uri.as_bytes();
    let n = bytes.len();
    for i in 0..n {
        let c = bytes.try_get(i).unwrap_or(0);
        if c < Control::C0End || c == Control::Del {
            return true;
        }
        if c == Control::C1Lead {
            let second = bytes.try_get(wrapping_add(i, 1)).unwrap_or(0);
            if second >= Control::C1First && second < Control::C1End {
                return true;
            }
        }
    }
    false
}

// `valid_uri`.
fn valid_uri(in store: Store, in uri: Str) -> bool {
    !(uri.len() == 0 || uri.len() > store.limits.max_uri_bytes || has_control(in uri))
}

// `lookup_work`.
fn lookup_work(in store: Store) -> u64 eff [Fail[StoreError]] {
    if store.limits.max_uri_bytes == U64_MAX {
        Fail::raise(StoreError::SWorkLimit);
    }
    mul(store.uri_off.len(), wrapping_add(store.limits.max_uri_bytes, 1))
}

// The row of `uri`, or the number of rows.
fn find(in store: Store, in uri: Str) -> u64 {
    let row_count = store.uri_off.len();
    let pool_bytes = store.pool.as_bytes();
    for i in 0..row_count {
        let uri_start = w(in store.uri_off, i);
        let uri_end = wrapping_add(uri_start, w(in store.uri_len, i));
        if pool_bytes[uri_start..uri_end].eq(in uri.as_bytes()) {
            return i;
        }
    }
    row_count
}

// `lookup`.
fn lookup(in store: Store, in uri: Str) -> u64 eff [Fail[StoreError]] {
    if !valid_uri(in store, in uri) {
        Fail::raise(StoreError::SInvalidUri);
    }
    let mut work = Work { left: store.limits.max_work };
    spend(inout work, uri.len());
    spend(inout work, lookup_work(in store));
    let at = find(in store, in uri);
    if at == store.uri_off.len() {
        Fail::raise(StoreError::SNotOpen);
    }
    at
}

fn next_revision(in store: Store) -> u64 eff [Fail[StoreError]] {
    if store.revision == U64_MAX {
        Fail::raise(StoreError::SRevisionOverflow);
    }
    wrapping_add(store.revision, 1)
}

// `text_size`: the store's total with a text of `new_len` bytes in place of
// one of `old_len`.
fn text_size(in store: Store, new_len: u64, old_len: u64) -> u64 eff [Fail[StoreError]] {
    if new_len > store.limits.max_document_bytes {
        Fail::raise(StoreError::SDocumentLimit);
    }
    if old_len > store.total {
        Fail::raise(StoreError::STotalLimit);
    }
    let rest = wrapping_sub(store.total, old_len);
    if new_len > wrapping_sub(U64_MAX, rest) {
        Fail::raise(StoreError::STotalLimit);
    }
    let total = wrapping_add(rest, new_len);
    if total > store.limits.max_total_bytes {
        Fail::raise(StoreError::STotalLimit);
    }
    total
}

// `LineIndex::new`, kept only for its refusals.
fn index_lines(in text: Str, limits: StoreLimits) -> ChunkSeq[u64] eff [Fail[StoreError]] {
    let table: Result[ChunkSeq[u64], SpanError] = handle Fail[SpanError] in {
        lines_ok(line_table(in text, in limits.index, narrow_usize(LINE_SIZE)))
    } with {
        return v => v,
        raise(e, resume) => lines_err(e),
    };
    match table {
        Result::Ok(t) => t,
        Result::Err(e) => Fail::raise(StoreError::SIndex(e)),
    }
}

fn span_of(
    in text: Str,
    in lines: ChunkSeq[u64],
    limits: StoreLimits,
    range: Range
) -> (u64, u64) eff [Fail[StoreError]] {
    let got: Result[(u64, u64), SpanError] = handle Fail[SpanError] in {
        let bounds = span(in text, in lines[0..lines.len()], limits.index.max_work, range);
        span_ok(widen_u64(bounds.start), widen_u64(bounds.end))
    } with {
        return v => v,
        raise(e, resume) => span_err(e),
    };
    match got {
        Result::Ok(x) => x,
        Result::Err(e) => Fail::raise(StoreError::SIndex(e)),
    }
}

// The UTF-16 length of `text`.
fn utf16_len(in text: Str) -> u64 {
    let bytes = text.as_bytes();
    let mut units: u64 = 0;
    for i in 0..bytes.len() {
        let c = bytes.try_get(i).unwrap_or(0);
        if c < 128 || c >= 192 {
            units = if c >= 240 {
                wrapping_add(units, 2)
            } else {
                wrapping_add(units, 1)
            };
        }
    }
    units
}

fn append(inout store: Store, in text: Str) -> u64 {
    let at = store.pool.len();
    store.pool.push_str(in text);
    at
}

// Rewrites the arena with only the live URIs and texts.
fn compact(inout store: Store) {
    let mut pool = String::new();
    for i in 0..store.uri_off.len() {
        let uri_start = w(in store.uri_off, i);
        let uri_end = wrapping_add(uri_start, w(in store.uri_len, i));
        let text_start = w(in store.text_off, i);
        let text_end = wrapping_add(text_start, w(in store.text_len, i));
        let new_uri_off = pool.len();
        pool.push_str(in store.pool[uri_start..uri_end]);
        let new_text_off = pool.len();
        pool.push_str(in store.pool[text_start..text_end]);
        let _ = store.uri_off.try_set(i, new_uri_off);
        let _ = store.text_off.try_set(i, new_text_off);
    }
    store.live_bytes = pool.len();
    store.pool = pool;
}

fn maybe_compact(inout store: Store) {
    let dead = wrapping_sub(store.pool.len(), store.live_bytes);
    if dead > COMPACT_SLACK && dead > store.live_bytes {
        compact(inout store);
    }
}

// `open`.
pub fn store_open(
    inout store: Store,
    in uri: Str,
    version: i64,
    in text: Str
) -> u64 eff [Fail[StoreError]] {
    if !valid_uri(in store, in uri) {
        Fail::raise(StoreError::SInvalidUri);
    }
    let mut work = Work { left: store.limits.max_work };
    spend(inout work, uri.len());
    spend(inout work, lookup_work(in store));
    if find(in store, in uri) != store.uri_off.len() {
        Fail::raise(StoreError::SAlreadyOpen);
    }
    if store.uri_off.len() >= store.limits.max_documents {
        Fail::raise(StoreError::SDocumentLimit);
    }
    let total = text_size(in store, text.len(), 0);
    let revision = next_revision(in store);
    spend(inout work, mul(text.len(), Cost::Open));
    let lines = index_lines(in text, store.limits);
    let uri_start = append(inout store, in uri);
    let text_start = append(inout store, in text);
    store.uri_off.push(uri_start);
    store.uri_len.push(uri.len());
    store.text_off.push(text_start);
    store.text_len.push(text.len());
    store.versions.push(version);
    store.revisions.push(revision);
    store.live_bytes = wrapping_add(store.live_bytes, wrapping_add(uri.len(), text.len()));
    store.total = total;
    store.revision = revision;
    wrapping_sub(store.uri_off.len(), 1)
}

// A copy of the text of row `at`.
fn text_copy(in store: Store, at: u64) -> String {
    let start = w(in store.text_off, at);
    let end = wrapping_add(start, w(in store.text_len, at));
    let mut copy = String::new();
    copy.push_str(in store.pool[start..end]);
    copy
}

// `change`: every change applies to the candidate before it; nothing is
// committed until all succeed.
pub fn store_change(
    inout store: Store,
    in uri: Str,
    version: i64,
    in changes: ChunkSeq[Change]
) -> u64 eff [Fail[StoreError]] {
    let at = lookup(in store, in uri);
    let old_version = store.versions.try_get(at).unwrap_or(0);
    let old_len = w(in store.text_len, at);
    if version <= old_version {
        Fail::raise(StoreError::SVersion);
    }
    if changes.len() > store.limits.max_changes {
        Fail::raise(StoreError::SChangeLimit);
    }
    let revision = next_revision(in store);
    let mut work = Work { left: store.limits.max_work };
    spend(inout work, uri.len());
    spend(inout work, lookup_work(in store));
    spend(inout work, mul(old_len, Cost::Copy));
    let mut text = text_copy(in store, at);
    let mut lines = index_lines(in text, store.limits);
    let mut total = store.total;
    for i in 0..changes.len() {
        match changes.try_get(i) {
            Option::Some(change) => {
                spend(inout work, 1);
                let mut start: u64 = 0;
                let mut end = text.len();
                if change.has_range {
                    spend(inout work, mul(text.len(), Cost::Range));
                    let (range_start, range_end) = span_of(
                        in text,
                        in lines,
                        store.limits,
                        change.range
                    );
                    if change.has_len {
                        spend(inout work, wrapping_sub(range_end, range_start));
                        if utf16_len(in text[range_start..range_end]) != change.len {
                            Fail::raise(StoreError::SRangeLength);
                        }
                    }
                    start = range_start;
                    end = range_end;
                } else if change.has_len {
                    Fail::raise(StoreError::SRangeLength);
                }
                let keep = wrapping_sub(text.len(), wrapping_sub(end, start));
                if change.text.len() > wrapping_sub(U64_MAX, keep) {
                    Fail::raise(StoreError::SDocumentLimit);
                }
                let new_len = wrapping_add(keep, change.text.len());
                total = text_size(in store, new_len, old_len);
                spend(inout work, mul(new_len, Cost::Candidate));
                let mut candidate = String::new();
                candidate.push_str(in text[0..start]);
                candidate.push_str(in change.text);
                candidate.push_str(in text[end..text.len()]);
                lines = index_lines(in candidate, store.limits);
                text = candidate;
            }
            Option::None => {}
        }
    }
    let text_start = append(inout store, in text);
    let _ = store.text_off.try_set(at, text_start);
    let _ = store.text_len.try_set(at, text.len());
    let _ = store.versions.try_set(at, version);
    let _ = store.revisions.try_set(at, revision);
    store.live_bytes = wrapping_add(wrapping_sub(store.live_bytes, old_len), text.len());
    store.total = total;
    store.revision = revision;
    maybe_compact(inout store);
    at
}

fn remove_u64(inout column: ChunkSeq[u64], at: u64) {
    let len = column.len();
    for i in at..wrapping_sub(len, 1) {
        let _ = column.try_set(i, w(in column, wrapping_add(i, 1)));
    }
    column.truncate(wrapping_sub(len, 1));
}

fn remove_i64(inout column: ChunkSeq[i64], at: u64) {
    let len = column.len();
    for i in at..wrapping_sub(len, 1) {
        let next_value = column.try_get(wrapping_add(i, 1)).unwrap_or(0);
        let _ = column.try_set(i, next_value);
    }
    column.truncate(wrapping_sub(len, 1));
}

// The closed document `close` returns: its version, revision and text.
pub struct Closed {
    version: i64,
    revision: u64,
    text: String
}

// `close`.
pub fn store_close(inout store: Store, in uri: Str) -> Closed eff [Fail[StoreError]] {
    let at = lookup(in store, in uri);
    let revision = next_revision(in store);
    let closed = Closed {
        version: store.versions.try_get(at).unwrap_or(0),
        revision: w(in store.revisions, at),
        text: text_copy(in store, at)
    };
    let len = w(in store.text_len, at);
    store.live_bytes = wrapping_sub(store.live_bytes, wrapping_add(len, w(in store.uri_len, at)));
    remove_u64(inout store.uri_off, at);
    remove_u64(inout store.uri_len, at);
    remove_u64(inout store.text_off, at);
    remove_u64(inout store.text_len, at);
    remove_i64(inout store.versions, at);
    remove_u64(inout store.revisions, at);
    store.total = wrapping_sub(store.total, len);
    store.revision = revision;
    maybe_compact(inout store);
    closed
}

// `get`: the row of `uri`, or `None`.
pub fn store_get(in store: Store, in uri: Str) -> Option[u64] {
    if !valid_uri(in store, in uri) {
        return Option::None;
    }
    let at = find(in store, in uri);
    if at == store.uri_off.len() {
        Option::None
    } else {
        Option::Some(at)
    }
}

pub fn doc_version(in store: Store, at: u64) -> i64 {
    store.versions.try_get(at).unwrap_or(0)
}

pub fn doc_revision(in store: Store, at: u64) -> u64 {
    w(in store.revisions, at)
}

// The text of row `at`, appended to `out`.
pub fn doc_text(in store: Store, at: u64, inout out: ChunkSeq[u8]) {
    let start = w(in store.text_off, at);
    let end = wrapping_add(start, w(in store.text_len, at));
    let pool_bytes = store.pool.as_bytes();
    out.extend(in pool_bytes[start..end]);
}

pub fn store_len(in store: Store) -> u64 {
    store.uri_off.len()
}

pub fn store_total(in store: Store) -> u64 {
    store.total
}

pub fn store_revision(in store: Store) -> u64 {
    store.revision
}

// Forces the store revision, as the Rust unit test does to reach
// `RevisionOverflow`.
pub fn store_set_revision(inout store: Store, revision: u64) {
    store.revision = revision;
}

// Typed constructors: a handle body or clause that builds a Result or
// Option with a variant constructor leaves the other type parameter
// uninferred (`_`), which the native layout refuses (report, gap 2).
fn lines_ok(sink v: ChunkSeq[u64]) -> Result[ChunkSeq[u64], SpanError] {
    Result::Ok(v)
}

fn lines_err(e: SpanError) -> Result[ChunkSeq[u64], SpanError] {
    Result::Err(e)
}

fn span_ok(start: u64, end: u64) -> Result[(u64, u64), SpanError] {
    Result::Ok((start, end))
}

fn span_err(e: SpanError) -> Result[(u64, u64), SpanError] {
    Result::Err(e)
}
