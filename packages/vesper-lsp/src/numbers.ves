const MAX_POW10: u64 = 308;
const U64_MAX_TENTH: u64 = 1844674407370955161;
const U64_MAX_LAST_DIGIT: u64 = 5;
const I32_MAX_TENTH: i64 = 214748364;
const I32_MAX_LAST_DIGIT: i64 = 7;
const I32_MAX: i64 = 2147483647;
const I32_MIN: i64 = -2147483648;
const INFINITE_EXPONENT: u64 = 2047;

fn at(in t: Slice[u8], i: u64) -> u64 {
    match t.try_get(i) {
        Option::Some(c) => widen_u64(c),
        Option::None => 0,
    }
}

fn is_digit(c: u64) -> bool {
    c >= 48 && c <= 57
}

fn pow10(e: u64) -> f64 {
    // A guard does not bound a constant-array index (a known gap): the
    // table is padded to 512 and the index masked.
    from_bits_f64(POW10_BITS[e & 511])
}

fn infinite(f: f64) -> bool {
    (to_bits_f64(f) >> 52) & INFINITE_EXPONENT == INFINITE_EXPONENT
}

// `overflow!(s * 10 + d, u64::MAX)`.
fn overflows(s: u64, d: u64) -> bool {
    s >= U64_MAX_TENTH && (s > U64_MAX_TENTH || d > U64_MAX_LAST_DIGIT)
}

fn saturate(v: i64) -> i64 {
    if v > I32_MAX {
        I32_MAX
    } else if v < I32_MIN {
        I32_MIN
    } else {
        v
    }
}

// `f64_from_parts`: whether `significand * 10^exponent` is out of range.
fn out_of_range(significand: u64, exponent: i64) -> bool {
    let mut f = nearest_f64(significand);
    let mut e = exponent;
    loop {
        let magnitude = if e < 0 {
            wrapping_u64(wrapping_sub(0, e))
        } else {
            wrapping_u64(e)
        };
        if magnitude <= MAX_POW10 {
            if e >= 0 {
                f = f * pow10(magnitude);
                return infinite(f);
            }
            return false;
        }
        if wrapping_shl_u64(to_bits_f64(f), 1) == 0 {
            return false;
        }
        if e >= 0 {
            return true;
        }
        f = f / pow10(MAX_POW10);
        e = wrapping_add(e, 308);
    }
}

// Whether serde_json refuses the JSON number `t` (already validated by
// the serde port) as out of range.
pub fn number_out_of_range(in t: Slice[u8]) -> bool {
    let mut i: u64 = 0;
    if at(in t, 0) == 45 {
        i = 1;
    }
    let mut s: u64 = 0;
    let mut exponent: i64 = 0;
    let mut float = false;
    // The integer part: past the significand's overflow, digits only
    // count (`parse_long_integer`).
    let mut long = false;
    loop {
        let c = at(in t, i);
        if !is_digit(c) {
            break;
        }
        let d = wrapping_sub(c, 48);
        if long || overflows(s, d) {
            long = true;
            float = true;
            exponent = wrapping_add(exponent, 1);
        } else {
            s = wrapping_add(wrapping_mul(s, 10), d);
        }
        i = wrapping_add(i, 1);
    }
    // The fraction: digits past the overflow are dropped
    // (`parse_decimal_overflow`).
    if at(in t, i) == 46 {
        float = true;
        i = wrapping_add(i, 1);
        let mut dropped = false;
        loop {
            let c = at(in t, i);
            if !is_digit(c) {
                break;
            }
            let d = wrapping_sub(c, 48);
            if dropped || overflows(s, d) {
                dropped = true;
            } else {
                s = wrapping_add(wrapping_mul(s, 10), d);
                exponent = wrapping_sub(exponent, 1);
            }
            i = wrapping_add(i, 1);
        }
    }
    let c = at(in t, i);
    if c == 101 || c == 69 {
        float = true;
        i = wrapping_add(i, 1);
        let mut positive = true;
        if at(in t, i) == 43 {
            i = wrapping_add(i, 1);
        } else if at(in t, i) == 45 {
            positive = false;
            i = wrapping_add(i, 1);
        }
        let mut x: i64 = 0;
        loop {
            let c = at(in t, i);
            if !is_digit(c) {
                break;
            }
            let d = wrapping_i64(wrapping_sub(c, 48));
            // `parse_exponent_overflow`.
            if x >= I32_MAX_TENTH && (x > I32_MAX_TENTH || d > I32_MAX_LAST_DIGIT) {
                return s != 0 && positive;
            }
            x = wrapping_add(wrapping_mul(x, 10), d);
            i = wrapping_add(i, 1);
        }
        exponent = if positive {
            saturate(wrapping_add(exponent, x))
        } else {
            saturate(wrapping_sub(exponent, x))
        };
    }
    float && out_of_range(s, exponent)
}
