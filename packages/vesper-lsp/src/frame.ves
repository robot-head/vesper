// `read_frame` of crates/vesper-lsp/src/transport.rs over a lent byte
// stream: the bounded CRLF header lines, the header fields and the body.
// A cursor over the whole stream sees what `BufRead::fill_buf` would hand
// over in one piece; chunking does not change which error is raised
// (crates/vesper-lsp/tests/transport.rs reads at every chunk size).

use self::limits::{Ascii, Crlf, Perr, Plimits, add, bound, byte, min64, sat_add, sat_sub, validate};

// The bit that tells a lower-case ASCII letter from its capital.
const CASE_BIT: u8 = 32;

// One frame's body: `start` and `len` in the stream.
pub copy struct Body {
    start: u64,
    len: u64
}

// The stream cursor of one `read_frame` call.
pub copy struct Cursor {
    pos: u64
}

// A header line in the stream (its CRLF included).
copy struct Line {
    start: u64,
    len: u64
}

// `header_line`: `None` on a clean end of the stream at a frame boundary.
fn header_line(
    in stream: Slice[u8],
    inout cursor: Cursor,
    inout total: u64,
    limits: Plimits
) -> Option[Line] eff [Fail[Perr]] {
    let stream_len = stream.len();
    let start = cursor.pos;
    let mut len: u64 = 0;
    loop {
        if cursor.pos >= stream_len {
            if len == 0 && total == 0 {
                return Option::None;
            }
            Fail::raise(Perr::PTruncated);
        }
        let remaining = min64(
            sat_sub(limits.max_header_line_bytes, len),
            sat_sub(limits.max_header_bytes, total)
        );
        let scan = min64(wrapping_sub(stream_len, cursor.pos), sat_add(remaining, 1));
        let count = match stream[cursor.pos..wrapping_add(cursor.pos, scan)].find_byte(Ascii::Lf) {
            Option::Some(lf_at) => wrapping_add(lf_at, 1),
            Option::None => scan,
        };
        let new_len = add(len, count);
        let new_total = add(total, count);
        bound(new_len, limits.max_header_line_bytes, Perr::PHeaderLimit);
        bound(new_total, limits.max_header_bytes, Perr::PHeaderLimit);
        len = new_len;
        cursor.pos = wrapping_add(cursor.pos, count);
        total = new_total;
        if byte(in stream, wrapping_sub(cursor.pos, 1)) == Ascii::Lf {
            if len < Crlf::Len
                || byte(in stream, wrapping_sub(cursor.pos, Crlf::Len)) != Ascii::Cr
            {
                Fail::raise(Perr::PInvalidHeader);
            }
            return Option::Some(Line { start: start, len: len });
        }
    }
}

fn lower(ch: u8) -> u8 {
    if ch >= Ascii::UpperA && ch <= Ascii::UpperZ {
        wrapping_add(ch, CASE_BIT)
    } else {
        ch
    }
}

// `eq_ignore_ascii_case` of `stream[start..end]` and `expected`.
fn eq_ic(in stream: Slice[u8], start: u64, end: u64, in expected: Str) -> bool {
    let expected_bytes = expected.as_bytes();
    if wrapping_sub(end, start) != expected_bytes.len() {
        return false;
    }
    for i in 0..expected_bytes.len() {
        if lower(byte(in stream, wrapping_add(start, i))) != lower(byte(in expected_bytes, i)) {
            return false;
        }
    }
    true
}

// `str::trim` on header bytes, which hold only printable ASCII and tabs: the
// bounds of `stream[start..end]` without leading and trailing spaces and tabs.
fn trim(in stream: Slice[u8], start: u64, end: u64) -> (u64, u64) {
    let mut lo = start;
    let mut hi = end;
    loop {
        if lo >= hi {
            break;
        }
        let c = byte(in stream, lo);
        if c != Ascii::Space && c != Ascii::Tab {
            break;
        }
        lo = wrapping_add(lo, 1);
    }
    loop {
        if hi <= lo {
            break;
        }
        let c = byte(in stream, wrapping_sub(hi, 1));
        if c != Ascii::Space && c != Ascii::Tab {
            break;
        }
        hi = wrapping_sub(hi, 1);
    }
    (lo, hi)
}

// The first `needle` in `stream[start..end]`, or `end`.
fn find(in stream: Slice[u8], start: u64, end: u64, needle: u8) -> u64 {
    let mut pos = start;
    loop {
        if pos >= end || byte(in stream, pos) == needle {
            return pos;
        }
        pos = wrapping_add(pos, 1);
    }
}

// `content_type`.
fn content_type(in stream: Slice[u8], start: u64, end: u64) -> Unit eff [Fail[Perr]] {
    let first_semi = find(in stream, start, end, Ascii::Semicolon);
    let (media_start, media_end) = trim(in stream, start, first_semi);
    if !eq_ic(in stream, media_start, media_end, "application/vscode-jsonrpc")
        && !eq_ic(in stream, media_start, media_end, "application/json")
    {
        Fail::raise(Perr::PUnsupportedEncoding);
    }
    let mut seen_charset = false;
    let mut at = first_semi;
    loop {
        if at >= end {
            break;
        }
        let param_start = wrapping_add(at, 1);
        let param_end = find(in stream, param_start, end, Ascii::Semicolon);
        at = param_end;
        let (pair_start, pair_end) = trim(in stream, param_start, param_end);
        let equals_at = find(in stream, pair_start, pair_end, Ascii::Equals);
        if equals_at >= pair_end {
            Fail::raise(Perr::PInvalidHeader);
        }
        let (key_start, key_end) = trim(in stream, pair_start, equals_at);
        if !eq_ic(in stream, key_start, key_end, "charset") || seen_charset {
            Fail::raise(Perr::PInvalidHeader);
        }
        seen_charset = true;
        let (raw_start, raw_end) = trim(in stream, wrapping_add(equals_at, 1), pair_end);
        let mut value_start = raw_start;
        let mut value_end = raw_end;
        if raw_start < raw_end && byte(in stream, raw_start) == Ascii::Quote {
            // `strip_prefix('"')` then `strip_suffix('"')`.
            value_start = wrapping_add(raw_start, 1);
            if value_end <= value_start
                || byte(in stream, wrapping_sub(value_end, 1)) != Ascii::Quote
            {
                Fail::raise(Perr::PInvalidHeader);
            }
            value_end = wrapping_sub(value_end, 1);
        }
        if !eq_ic(in stream, value_start, value_end, "utf-8")
            && !eq_ic(in stream, value_start, value_end, "utf8")
        {
            Fail::raise(Perr::PUnsupportedEncoding);
        }
    }
}

fn is_name_byte(c: u8) -> bool {
    (c >= Ascii::Zero && c <= Ascii::Nine)
        || (c >= Ascii::UpperA && c <= Ascii::UpperZ)
        || (c >= Ascii::LowerA && c <= Ascii::LowerZ)
        || c == Ascii::Dash
}

// `read_frame`: the next body, or `None` at a clean end of the stream.
pub fn read_frame(
    in stream: Slice[u8],
    inout cursor: Cursor,
    limits: Plimits
) -> Option[Body] eff [Fail[Perr]] {
    validate(limits);
    let mut total: u64 = 0;
    let mut header_count: u64 = 0;
    let mut length: u64 = 0;
    let mut has_length = false;
    let mut has_type = false;
    loop {
        let line = match header_line(in stream, inout cursor, inout total, limits) {
            Option::Some(x) => x,
            Option::None => return Option::None,
        };
        if line.len == Crlf::Len {
            break;
        }
        header_count = wrapping_add(header_count, 1);
        bound(header_count, limits.max_headers, Perr::PHeaderLimit);
        let line_start = line.start;
        let content_end = wrapping_add(line.start, wrapping_sub(line.len, Crlf::Len));
        for i in line_start..content_end {
            let ch = byte(in stream, i);
            if !((ch >= Ascii::Space && ch <= Ascii::Tilde) || ch == Ascii::Tab) {
                Fail::raise(Perr::PInvalidHeader);
            }
        }
        let colon = find(in stream, line_start, content_end, Ascii::Colon);
        if colon >= content_end || colon == line_start {
            Fail::raise(Perr::PInvalidHeader);
        }
        for i in line_start..colon {
            if !is_name_byte(byte(in stream, i)) {
                Fail::raise(Perr::PInvalidHeader);
            }
        }
        // `trim_matches([' ', '\t'])`.
        let (value_start, value_end) = trim(in stream, wrapping_add(colon, 1), content_end);
        if eq_ic(in stream, line_start, colon, "content-length") {
            if has_length {
                Fail::raise(Perr::PDuplicateLength);
            }
            if value_start == value_end {
                Fail::raise(Perr::PInvalidLength);
            }
            for i in value_start..value_end {
                let ch = byte(in stream, i);
                if ch < Ascii::Zero || ch > Ascii::Nine {
                    Fail::raise(Perr::PInvalidLength);
                }
            }
            let mut parsed_len: u64 = 0;
            for i in value_start..value_end {
                let digit = widen_u64(wrapping_sub(byte(in stream, i), Ascii::Zero));
                // `max_body_bytes <= 8 MiB` keeps `parsed_len * 10 + digit`
                // far from overflow: each digit is bounded before the next.
                parsed_len = wrapping_add(wrapping_mul(parsed_len, 10), digit);
                bound(parsed_len, limits.max_body_bytes, Perr::PBodyLimit);
            }
            length = parsed_len;
            has_length = true;
        } else if eq_ic(in stream, line_start, colon, "content-type") {
            if has_type {
                Fail::raise(Perr::PInvalidHeader);
            }
            content_type(in stream, value_start, value_end);
            has_type = true;
        } else if eq_ic(in stream, line_start, colon, "content-encoding")
            && !eq_ic(in stream, value_start, value_end, "identity")
        {
            Fail::raise(Perr::PUnsupportedEncoding);
        }
    }
    if !has_length {
        Fail::raise(Perr::PMissingLength);
    }
    if wrapping_sub(stream.len(), cursor.pos) < length {
        cursor.pos = stream.len();
        Fail::raise(Perr::PTruncated);
    }
    let body = Body { start: cursor.pos, len: length };
    cursor.pos = wrapping_add(cursor.pos, length);
    Option::Some(body)
}
