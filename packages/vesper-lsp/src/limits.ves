// `ProtocolLimits` and `ProtocolErrorKind` of crates/vesper-lsp/src/transport.rs.

// `ProtocolErrorKind`, variant for variant (the harness reads the index).
pub copy enum Perr {
    PInvalidLimits,
    PIo,
    PHeaderLimit,
    PInvalidHeader,
    PMissingLength,
    PDuplicateLength,
    PInvalidLength,
    PBodyLimit,
    PTruncated,
    PUnsupportedEncoding,
    PUtf8,
    PJson,
    PDuplicateJsonKey,
    PJsonLimit,
    PInvalidEnvelope,
    PInvalidId,
    POutputLimit,
    PWorkLimit,
    PAllocation
}

// `ProtocolLimits`, field for field.
pub copy struct Plimits {
    max_body_bytes: u64,
    max_reply_bytes: u64,
    max_header_bytes: u64,
    max_header_line_bytes: u64,
    max_headers: u64,
    max_json_depth: u64,
    max_json_nodes: u64,
    max_json_string_bytes: u64,
    max_json_total_string_bytes: u64,
    max_json_index_bytes: u64,
    max_json_work: u64,
    max_id_bytes: u64,
    max_method_bytes: u64
}

// The number of words of `Plimits` in the harness input.
pub const LIMIT_WORDS: u64 = 13;

const MIB: u64 = 1048576;

// `ProtocolLimits::HARD`.
pub fn hard() -> Plimits {
    Plimits {
        max_body_bytes: 8 * MIB,
        max_reply_bytes: 8 * MIB,
        max_header_bytes: 16384,
        max_header_line_bytes: 4096,
        max_headers: 128,
        max_json_depth: 64,
        max_json_nodes: 262144,
        max_json_string_bytes: 8 * MIB,
        max_json_total_string_bytes: 8 * MIB,
        max_json_index_bytes: 16 * MIB,
        max_json_work: 128 * MIB,
        max_id_bytes: 1024,
        max_method_bytes: 1024
    }
}

// `ProtocolLimits::validate`.
pub fn validate(l: Plimits) -> Unit eff [Fail[Perr]] {
    let h = hard();
    if l
        .max_body_bytes
        > h
        .max_body_bytes
        || l
        .max_reply_bytes
        > h
        .max_reply_bytes
        || l
        .max_header_bytes
        > h
        .max_header_bytes
        || l
        .max_header_line_bytes
        > h
        .max_header_line_bytes
        || l
        .max_headers
        > h
        .max_headers
        || l
        .max_json_depth
        > h
        .max_json_depth
        || l
        .max_json_nodes
        > h
        .max_json_nodes
        || l
        .max_json_string_bytes
        > h
        .max_json_string_bytes
        || l
        .max_json_total_string_bytes
        > h
        .max_json_total_string_bytes
        || l
        .max_json_index_bytes
        > h
        .max_json_index_bytes
        || l
        .max_json_work
        > h
        .max_json_work
        || l
        .max_id_bytes
        > h
        .max_id_bytes
        || l
        .max_method_bytes
        > h
        .max_method_bytes {
        Fail::raise(Perr::PInvalidLimits);
    }
}

// `bound`: `n <= max`, else `kind`.
pub fn bound(n: u64, max: u64, kind: Perr) -> Unit eff [Fail[Perr]] {
    if n > max {
        Fail::raise(kind);
    }
}

// `add`: checked, `JsonLimit` on overflow.
pub fn add(a: u64, b: u64) -> u64 eff [Fail[Perr]] {
    if b > wrapping_sub(18446744073709551615, a) {
        Fail::raise(Perr::PJsonLimit);
    }
    wrapping_add(a, b)
}

pub fn sat_sub(a: u64, b: u64) -> u64 {
    if b > a {
        0
    } else {
        wrapping_sub(a, b)
    }
}

pub fn sat_add(a: u64, b: u64) -> u64 {
    if b > wrapping_sub(18446744073709551615, a) {
        18446744073709551615
    } else {
        wrapping_add(a, b)
    }
}

pub fn min64(a: u64, b: u64) -> u64 {
    if a < b {
        a
    } else {
        b
    }
}

// The index of a `Perr` (its Rust discriminant).
pub fn perr_code(e: Perr) -> u64 {
    match e {
        Perr::PInvalidLimits => 0,
        Perr::PIo => 1,
        Perr::PHeaderLimit => 2,
        Perr::PInvalidHeader => 3,
        Perr::PMissingLength => 4,
        Perr::PDuplicateLength => 5,
        Perr::PInvalidLength => 6,
        Perr::PBodyLimit => 7,
        Perr::PTruncated => 8,
        Perr::PUnsupportedEncoding => 9,
        Perr::PUtf8 => 10,
        Perr::PJson => 11,
        Perr::PDuplicateJsonKey => 12,
        Perr::PJsonLimit => 13,
        Perr::PInvalidEnvelope => 14,
        Perr::PInvalidId => 15,
        Perr::POutputLimit => 16,
        Perr::PWorkLimit => 17,
        Perr::PAllocation => 18,
    }
}

// The kind's name as `ProtocolError`'s `Display` writes it ("LSP Json").
pub fn perr_name(e: Perr) -> Str {
    match e {
        Perr::PInvalidLimits => "InvalidLimits",
        Perr::PIo => "Io",
        Perr::PHeaderLimit => "HeaderLimit",
        Perr::PInvalidHeader => "InvalidHeader",
        Perr::PMissingLength => "MissingLength",
        Perr::PDuplicateLength => "DuplicateLength",
        Perr::PInvalidLength => "InvalidLength",
        Perr::PBodyLimit => "BodyLimit",
        Perr::PTruncated => "Truncated",
        Perr::PUnsupportedEncoding => "UnsupportedEncoding",
        Perr::PUtf8 => "Utf8",
        Perr::PJson => "Json",
        Perr::PDuplicateJsonKey => "DuplicateJsonKey",
        Perr::PJsonLimit => "JsonLimit",
        Perr::PInvalidEnvelope => "InvalidEnvelope",
        Perr::PInvalidId => "InvalidId",
        Perr::POutputLimit => "OutputLimit",
        Perr::PWorkLimit => "WorkLimit",
        Perr::PAllocation => "Allocation",
    }
}

// The harness input's limits: `LIMIT_WORDS` little-endian words at `at`.
pub fn read_limits(in b: Slice[u8], at: u64) -> Plimits {
    Plimits {
        max_body_bytes: le(in b, at, 0),
        max_reply_bytes: le(in b, at, 1),
        max_header_bytes: le(in b, at, 2),
        max_header_line_bytes: le(in b, at, 3),
        max_headers: le(in b, at, 4),
        max_json_depth: le(in b, at, 5),
        max_json_nodes: le(in b, at, 6),
        max_json_string_bytes: le(in b, at, 7),
        max_json_total_string_bytes: le(in b, at, 8),
        max_json_index_bytes: le(in b, at, 9),
        max_json_work: le(in b, at, 10),
        max_id_bytes: le(in b, at, 11),
        max_method_bytes: le(in b, at, 12)
    }
}

// The little-endian word `k` after byte `at` (0 past the end).
pub fn le(in b: Slice[u8], at: u64, k: u64) -> u64 {
    match b.try_read_u64_le(wrapping_add(at, wrapping_mul(k, 8))) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

pub fn byte(in b: Slice[u8], i: u64) -> u8 {
    match b.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}
