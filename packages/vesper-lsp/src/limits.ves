// `ProtocolLimits` and `ProtocolErrorKind` of crates/vesper-lsp/src/transport.rs.

// `ProtocolErrorKind`, variant for variant (the harness reads the index).
pub copy enum Perr {
    PInvalidLimits,
    PIo,
    PHeaderLimit,
    PInvalidHeader,
    PMissingLength,
    PDuplicateLength,
    PInvalidLength,
    PBodyLimit,
    PTruncated,
    PUnsupportedEncoding,
    PUtf8,
    PJson,
    PDuplicateJsonKey,
    PJsonLimit,
    PInvalidEnvelope,
    PInvalidId,
    POutputLimit,
    PWorkLimit,
    PAllocation
}

// `ProtocolLimits`, field for field.
pub copy struct Plimits {
    max_body_bytes: u64,
    max_reply_bytes: u64,
    max_header_bytes: u64,
    max_header_line_bytes: u64,
    max_headers: u64,
    max_json_depth: u64,
    max_json_nodes: u64,
    max_json_string_bytes: u64,
    max_json_total_string_bytes: u64,
    max_json_index_bytes: u64,
    max_json_work: u64,
    max_id_bytes: u64,
    max_method_bytes: u64
}

// The words of `Plimits` in the harness input, field for field, and
// their count.
pub enum LimitWord: _ {
    BodyBytes = 0,
    ReplyBytes = 1,
    HeaderBytes = 2,
    HeaderLineBytes = 3,
    Headers = 4,
    JsonDepth = 5,
    JsonNodes = 6,
    JsonStringBytes = 7,
    JsonTotalStringBytes = 8,
    JsonIndexBytes = 9,
    JsonWork = 10,
    IdBytes = 11,
    MethodBytes = 12,
    Count = 13
}

// The harness's little-endian words.
pub enum Le: _ {
    WordBytes = 8
}

// The ASCII bytes the transport reads and writes, and `'a' - 10` for hex
// digits.
pub enum Ascii: _ {
    Backspace = 0x08,
    Tab = 0x09,
    Lf = 0x0a,
    FormFeed = 0x0c,
    Cr = 0x0d,
    Space = 0x20,
    Quote = 0x22,
    Plus = 0x2b,
    Dash = 0x2d,
    Dot = 0x2e,
    Zero = 0x30,
    Nine = 0x39,
    Colon = 0x3a,
    Semicolon = 0x3b,
    Equals = 0x3d,
    UpperA = 0x41,
    UpperE = 0x45,
    UpperZ = 0x5a,
    Backslash = 0x5c,
    LowerHexBase = 0x57,
    LowerA = 0x61,
    LowerE = 0x65,
    LowerZ = 0x7a,
    Tilde = 0x7e
}

// The binary64 fields: the significand width and mask, its hidden bit,
// the exponent mask and bias, the sign bit and the magnitude mask.
pub enum F64: _ {
    SignificandBits = 52,
    SignificandMask = 4503599627370495,
    HiddenBit = 4503599627370496,
    ExponentMask = 2047,
    // The exponent of the significand's last bit at biased exponent 0.
    ExponentBias = 1075,
    SignShift = 63,
    MagnitudeMask = 9223372036854775807
}

// `i32`'s bounds: `i32::MAX` and the magnitude of `i32::MIN`.
pub enum I32: _ {
    Max = 2147483647,
    MinMagnitude = 2147483648
}

// A header line's CRLF.
pub enum Crlf: _ {
    Len = 2
}

const MAX_U64: u64 = 18446744073709551615;

const MIB: u64 = 1048576;

// `ProtocolLimits::HARD`.
pub fn hard() -> Plimits {
    Plimits {
        max_body_bytes: 8 * MIB,
        max_reply_bytes: 8 * MIB,
        max_header_bytes: 16384,
        max_header_line_bytes: 4096,
        max_headers: 128,
        max_json_depth: 64,
        max_json_nodes: 262144,
        max_json_string_bytes: 8 * MIB,
        max_json_total_string_bytes: 8 * MIB,
        max_json_index_bytes: 16 * MIB,
        max_json_work: 128 * MIB,
        max_id_bytes: 1024,
        max_method_bytes: 1024
    }
}

// `ProtocolLimits::validate`.
pub fn validate(l: Plimits) -> Unit eff [Fail[Perr]] {
    let h = hard();
    if l.max_body_bytes > h.max_body_bytes
        || l.max_reply_bytes > h.max_reply_bytes
        || l.max_header_bytes > h.max_header_bytes
        || l.max_header_line_bytes > h.max_header_line_bytes
        || l.max_headers > h.max_headers
        || l.max_json_depth > h.max_json_depth
        || l.max_json_nodes > h.max_json_nodes
        || l.max_json_string_bytes > h.max_json_string_bytes
        || l.max_json_total_string_bytes > h.max_json_total_string_bytes
        || l.max_json_index_bytes > h.max_json_index_bytes
        || l.max_json_work > h.max_json_work
        || l.max_id_bytes > h.max_id_bytes
        || l.max_method_bytes > h.max_method_bytes {
        Fail::raise(Perr::PInvalidLimits);
    }
}

// `bound`: `n <= max`, else `kind`.
pub fn bound(n: u64, max: u64, kind: Perr) -> Unit eff [Fail[Perr]] {
    if n > max {
        Fail::raise(kind);
    }
}

// `add`: checked, `JsonLimit` on overflow.
pub fn add(a: u64, b: u64) -> u64 eff [Fail[Perr]] {
    if b > wrapping_sub(MAX_U64, a) {
        Fail::raise(Perr::PJsonLimit);
    }
    wrapping_add(a, b)
}

pub fn sat_sub(a: u64, b: u64) -> u64 {
    if b > a {
        0
    } else {
        wrapping_sub(a, b)
    }
}

pub fn sat_add(a: u64, b: u64) -> u64 {
    if b > wrapping_sub(MAX_U64, a) {
        MAX_U64
    } else {
        wrapping_add(a, b)
    }
}

pub fn min64(a: u64, b: u64) -> u64 {
    if a < b {
        a
    } else {
        b
    }
}

// The index of a `Perr` (its Rust discriminant).
pub fn perr_code(e: Perr) -> u64 {
    match e {
        Perr::PInvalidLimits => 0,
        Perr::PIo => 1,
        Perr::PHeaderLimit => 2,
        Perr::PInvalidHeader => 3,
        Perr::PMissingLength => 4,
        Perr::PDuplicateLength => 5,
        Perr::PInvalidLength => 6,
        Perr::PBodyLimit => 7,
        Perr::PTruncated => 8,
        Perr::PUnsupportedEncoding => 9,
        Perr::PUtf8 => 10,
        Perr::PJson => 11,
        Perr::PDuplicateJsonKey => 12,
        Perr::PJsonLimit => 13,
        Perr::PInvalidEnvelope => 14,
        Perr::PInvalidId => 15,
        Perr::POutputLimit => 16,
        Perr::PWorkLimit => 17,
        Perr::PAllocation => 18,
    }
}

// The kind's name as `ProtocolError`'s `Display` writes it ("LSP Json").
pub fn perr_name(e: Perr) -> Str {
    match e {
        Perr::PInvalidLimits => "InvalidLimits",
        Perr::PIo => "Io",
        Perr::PHeaderLimit => "HeaderLimit",
        Perr::PInvalidHeader => "InvalidHeader",
        Perr::PMissingLength => "MissingLength",
        Perr::PDuplicateLength => "DuplicateLength",
        Perr::PInvalidLength => "InvalidLength",
        Perr::PBodyLimit => "BodyLimit",
        Perr::PTruncated => "Truncated",
        Perr::PUnsupportedEncoding => "UnsupportedEncoding",
        Perr::PUtf8 => "Utf8",
        Perr::PJson => "Json",
        Perr::PDuplicateJsonKey => "DuplicateJsonKey",
        Perr::PJsonLimit => "JsonLimit",
        Perr::PInvalidEnvelope => "InvalidEnvelope",
        Perr::PInvalidId => "InvalidId",
        Perr::POutputLimit => "OutputLimit",
        Perr::PWorkLimit => "WorkLimit",
        Perr::PAllocation => "Allocation",
    }
}

// The harness input's limits: `LimitWord::Count` little-endian words at
// `at`.
pub fn read_limits(in b: Slice[u8], at: u64) -> Plimits {
    Plimits {
        max_body_bytes: le(in b, at, LimitWord::BodyBytes),
        max_reply_bytes: le(in b, at, LimitWord::ReplyBytes),
        max_header_bytes: le(in b, at, LimitWord::HeaderBytes),
        max_header_line_bytes: le(in b, at, LimitWord::HeaderLineBytes),
        max_headers: le(in b, at, LimitWord::Headers),
        max_json_depth: le(in b, at, LimitWord::JsonDepth),
        max_json_nodes: le(in b, at, LimitWord::JsonNodes),
        max_json_string_bytes: le(in b, at, LimitWord::JsonStringBytes),
        max_json_total_string_bytes: le(in b, at, LimitWord::JsonTotalStringBytes),
        max_json_index_bytes: le(in b, at, LimitWord::JsonIndexBytes),
        max_json_work: le(in b, at, LimitWord::JsonWork),
        max_id_bytes: le(in b, at, LimitWord::IdBytes),
        max_method_bytes: le(in b, at, LimitWord::MethodBytes)
    }
}

// The little-endian word `k` after byte `at` (0 past the end).
pub fn le(in b: Slice[u8], at: u64, k: u64) -> u64 {
    match b.try_read_u64_le(wrapping_add(at, wrapping_mul(k, Le::WordBytes))) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

pub fn byte(in b: Slice[u8], i: u64) -> u8 {
    match b.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}
