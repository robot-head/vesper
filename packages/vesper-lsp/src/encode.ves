// `encode_frame` of crates/vesper-lsp/src/transport.rs: the output budget
// (`validate_output`, `JsonBudget`), then serde_json's compact writer of the
// envelope, write by write into the bounded `Output`, then the
// `Content-Length` header.
//
// The envelope comes as a word stream with its text in a byte pool:
//
//   0 Request:      id_tag id_int id_off id_len method_off method_len
//                   has_params [value]
//   1 Notification: method_off method_len has_params [value]
//   2 Response:     id_tag id_int id_off id_len payload, then
//                   0 Result: value, or
//                   1 Error: code message_off message_len has_data [value]
//
// A `serde_json::Value` is in prefix order: 0 Null | 1 Bool b | 2 U64 n |
// 3 I64 n | 4 F64 bits | 5 String off len | 6 Array count, then the values
// | 7 Object count, then per field the key (a String) and the value. An
// object's fields come in its map order, which is the order serde_json
// writes them in.
use @vesper/serde::dragon::{Shortest, shortest};
use self::limits::{Ascii, Crlf, F64, Perr, Plimits, add, bound, byte, validate};
use self::envelope::{Envelope, Id};

// A `Value`'s tag.
enum Tag: _ {
    Null = 0,
    Bool = 1,
    U64 = 2,
    I64 = 3,
    F64 = 4,
    String = 5,
    Array = 6,
    Object = 7
}

// A value's words: a tag, then its payload (a scalar, a string's offset or
// a container's count) and a string's length. `Null` is the tag alone, a
// string three words, every other value two.
enum Value: _ {
    Payload = 1,
    StringLen = 2,
    NullWords = 1,
    Words = 2,
    StringWords = 3
}

// The words of a request (`Envelope::Request`) and a response.
enum Head: _ {
    Kind = 0,
    IdTag = 1,
    IdInt = 2,
    IdOff = 3,
    IdLen = 4,
    // A request's method, or a response's payload tag.
    Method = 5,
    Payload = 5,
    // A result, or an error's code.
    Result = 6,
    Code = 6,
    MessageOff = 7,
    MessageLen = 8,
    HasData = 9,
    Data = 10
}

// A request's or notification's method part, from its first word: the
// method's offset and length, whether params follow, then the params.
enum Call: _ {
    MethodOff = 0,
    MethodLen = 1,
    HasParams = 2,
    Params = 3,
    // Where a notification's method part starts.
    NotificationAt = 1
}

// A response's payload.
enum Payload: _ {
    Result = 0,
    Error = 1
}

// The bytes of the member names serde_json writes (`JsonBudget::key`).
enum Key: _ {
    Jsonrpc = 7,
    Version = 3,
    Id = 2,
    Method = 6,
    Params = 6,
    Result = 6,
    Error = 5,
    Code = 4,
    Message = 7,
    Data = 4
}

// The JSON depth of a value under the envelope, of the error object and
// of a value under it.
enum Depth: _ {
    Envelope = 1,
    Member = 2,
    ErrorMember = 3
}

// "Content-Length: " and two CRLFs.
const HEADER_FIXED: u64 = 20;
// The words of a pending value on `value`'s stack: its position and depth.
const FRAME_WORDS: u64 = 2;
// An object field is two values: its key and its value.
const FIELD_VALUES: u64 = 2;
// `\u00` and two hex digits.
const UNICODE_ESCAPE_LEN: u64 = 6;
// The offset from the digits of a halfway value to the two candidates.
const HALF_ULP_DIGIT: u64 = 5;
// The exponent of a subnormal's last bit.
const SUBNORMAL_EXPONENT: i64 = -1074;
// ryu writes a value without an exponent while its decimal point is at
// most `PLAIN_EXPONENT` digits in and above `SMALL_EXPONENT`.
const PLAIN_EXPONENT: i64 = 16;
const SMALL_EXPONENT: i64 = -5;

fn word(in words: Slice[u64], index: u64) -> u64 {
    words.try_get(index).unwrap_or(0)
}

// `JsonBudget`.
copy struct Budget {
    limits: Plimits,
    nodes: u64,
    strings: u64,
    remaining: u64
}

fn work(inout budget: Budget, n: u64) -> Unit eff [Fail[Perr]] {
    if n > budget.remaining {
        Fail::raise(Perr::PWorkLimit);
    }
    budget.remaining = wrapping_sub(budget.remaining, n);
}

fn node(inout budget: Budget) -> Unit eff [Fail[Perr]] {
    budget.nodes = add(budget.nodes, 1);
    bound(budget.nodes, budget.limits.max_json_nodes, Perr::PJsonLimit);
    work(inout budget, 1);
}

fn text(inout budget: Budget, n: u64) -> Unit eff [Fail[Perr]] {
    bound(n, budget.limits.max_json_string_bytes, Perr::PJsonLimit);
    budget.strings = add(budget.strings, n);
    bound(budget.strings, budget.limits.max_json_total_string_bytes, Perr::PJsonLimit);
    work(inout budget, n);
}

fn key(inout budget: Budget, n: u64) -> Unit eff [Fail[Perr]] {
    node(inout budget);
    text(inout budget, n);
}

// The position after the value at `start`.
fn skip(in words: Slice[u64], start: u64) -> u64 {
    let mut pos = start;
    let mut pending: u64 = 1;
    loop {
        if pending == 0 || pos >= words.len() {
            return pos;
        }
        pending = wrapping_sub(pending, 1);
        let tag = word(in words, pos);
        if tag == Tag::Null {
            pos = wrapping_add(pos, Value::NullWords);
        } else if tag == Tag::String {
            pos = wrapping_add(pos, Value::StringWords);
        } else if tag == Tag::Array {
            pending = wrapping_add(pending, word(in words, wrapping_add(pos, Value::Payload)));
            pos = wrapping_add(pos, Value::Words);
        } else if tag == Tag::Object {
            pending = wrapping_add(
                pending,
                wrapping_mul(word(in words, wrapping_add(pos, Value::Payload)), FIELD_VALUES)
            );
            pos = wrapping_add(pos, Value::Words);
        } else {
            pos = wrapping_add(pos, Value::Words);
        }
    }
}

// `JsonBudget::value`: the same stack walk, so the same limit fires first.
fn value(
    inout budget: Budget,
    in words: Slice[u64],
    start: u64,
    start_depth: u64
) -> Unit eff [Fail[Perr]] {
    bound(add(budget.nodes, 1), budget.limits.max_json_nodes, Perr::PJsonLimit);
    bound(1, budget.remaining, Perr::PWorkLimit);
    let mut stack: ChunkSeq[u64] = ChunkSeq::new();
    stack.push(start);
    stack.push(start_depth);
    loop {
        if stack.len() == 0 {
            break;
        }
        let depth = stack.pop().unwrap_or(0);
        let pos = stack.pop().unwrap_or(0);
        node(inout budget);
        let tag = word(in words, pos);
        if tag == Tag::Array || tag == Tag::Object {
            bound(depth, budget.limits.max_json_depth, Perr::PJsonLimit);
        }
        let pending = stack.len() / FRAME_WORDS;
        if tag == Tag::String {
            text(inout budget, word(in words, wrapping_add(pos, Value::StringLen)));
        } else if tag == Tag::Array {
            let n = word(in words, wrapping_add(pos, Value::Payload));
            bound(
                add(budget.nodes, add(pending, n)),
                budget.limits.max_json_nodes,
                Perr::PJsonLimit
            );
            work(inout budget, n);
            let mut child_pos = wrapping_add(pos, Value::Words);
            for i in 0..n {
                stack.push(child_pos);
                stack.push(wrapping_add(depth, 1));
                child_pos = skip(in words, child_pos);
            }
        } else if tag == Tag::Object {
            let n = word(in words, wrapping_add(pos, Value::Payload));
            let (field_nodes, overflow) = mul_wide(n, FIELD_VALUES);
            if overflow != 0 {
                Fail::raise(Perr::PJsonLimit);
            }
            bound(
                add(budget.nodes, add(pending, field_nodes)),
                budget.limits.max_json_nodes,
                Perr::PJsonLimit
            );
            work(inout budget, n);
            let mut child_pos = wrapping_add(pos, Value::Words);
            for i in 0..n {
                key(inout budget, word(in words, wrapping_add(child_pos, Value::StringLen)));
                child_pos = wrapping_add(child_pos, Value::StringWords);
                stack.push(child_pos);
                stack.push(wrapping_add(depth, 1));
                child_pos = skip(in words, child_pos);
            }
        }
    }
}

fn id(inout budget: Budget, tag: u64, len: u64) -> Unit eff [Fail[Perr]] {
    node(inout budget);
    if tag == Id::String {
        bound(len, budget.limits.max_id_bytes, Perr::PInvalidId);
        text(inout budget, len);
    }
}

fn check_method(len: u64, limits: Plimits) -> Unit eff [Fail[Perr]] {
    if len == 0 || len > limits.max_method_bytes {
        Fail::raise(Perr::PInvalidEnvelope);
    }
}

fn container(in words: Slice[u64], pos: u64) -> bool {
    let tag = word(in words, pos);
    tag == Tag::Array || tag == Tag::Object
}

// `validate_output`.
fn validate_output(in words: Slice[u64], limits: Plimits) -> Budget eff [Fail[Perr]] {
    validate(limits);
    bound(Depth::Envelope, limits.max_json_depth, Perr::PJsonLimit);
    let mut budget = Budget {
        limits: limits,
        nodes: 0,
        strings: 0,
        remaining: limits.max_json_work
    };
    node(inout budget);
    key(inout budget, Key::Jsonrpc);
    node(inout budget);
    text(inout budget, Key::Version);
    let kind = word(in words, Head::Kind);
    if kind == Envelope::Request || kind == Envelope::Notification {
        let mut call_at: u64 = Call::NotificationAt;
        if kind == Envelope::Request {
            key(inout budget, Key::Id);
            id(inout budget, word(in words, Head::IdTag), word(in words, Head::IdLen));
            call_at = Head::Method;
        }
        let method_len = word(in words, wrapping_add(call_at, Call::MethodLen));
        check_method(method_len, limits);
        key(inout budget, Key::Method);
        node(inout budget);
        text(inout budget, method_len);
        if word(in words, wrapping_add(call_at, Call::HasParams)) == 1 {
            let at = wrapping_add(call_at, Call::Params);
            if !container(in words, at) {
                Fail::raise(Perr::PInvalidEnvelope);
            }
            key(inout budget, Key::Params);
            value(inout budget, in words, at, Depth::Member);
        }
    } else {
        key(inout budget, Key::Id);
        id(inout budget, word(in words, Head::IdTag), word(in words, Head::IdLen));
        if word(in words, Head::Payload) == Payload::Error {
            key(inout budget, Key::Error);
            bound(Depth::Member, limits.max_json_depth, Perr::PJsonLimit);
            node(inout budget);
            key(inout budget, Key::Code);
            node(inout budget);
            key(inout budget, Key::Message);
            node(inout budget);
            text(inout budget, word(in words, Head::MessageLen));
            if word(in words, Head::HasData) == 1 {
                key(inout budget, Key::Data);
                value(inout budget, in words, Head::Data, Depth::ErrorMember);
            }
        } else {
            key(inout budget, Key::Result);
            value(inout budget, in words, Head::Result, Depth::Member);
        }
    }
    budget
}

// `Output`: every serde_json `write_all` is one `put`, checked as
// `Output::write` checks it.
struct Out {
    bytes: ChunkSeq[u8],
    budget: Budget
}

fn charge_write(inout out: Out, n: u64) -> Unit eff [Fail[Perr]] {
    let new_len = wrapping_add(out.bytes.len(), n);
    if new_len > out.budget.limits.max_reply_bytes {
        Fail::raise(Perr::POutputLimit);
    }
    work(inout out.budget, n);
}

fn put(inout out: Out, in chunk: Str) -> Unit eff [Fail[Perr]] {
    charge_write(inout out, chunk.len());
    out.bytes.extend(in chunk.as_bytes());
}

fn put_pool(inout out: Out, in pool: Slice[u8], start: u64, end: u64) -> Unit eff [Fail[Perr]] {
    charge_write(inout out, wrapping_sub(end, start));
    out.bytes.extend(in pool[start..end]);
}

fn hex_digit(nibble: u8) -> u8 {
    if nibble < 10 {
        wrapping_add(nibble, Ascii::Zero)
    } else {
        wrapping_add(nibble, Ascii::LowerHexBase)
    }
}

// `format_escaped_str`: the quotes, every run between escapes and every
// escape are separate writes.
fn put_string(inout out: Out, in pool: Slice[u8], off: u64, len: u64) -> Unit eff [Fail[Perr]] {
    put(inout out, "\"");
    let end = wrapping_add(off, len);
    let mut start = off;
    for i in off..end {
        let c = byte(in pool, i);
        if c < Ascii::Space || c == Ascii::Quote || c == Ascii::Backslash {
            if start < i {
                put_pool(inout out, in pool, start, i);
            }
            if c == Ascii::Quote {
                put(inout out, "\\\"");
            } else if c == Ascii::Backslash {
                put(inout out, "\\\\");
            } else if c == Ascii::Backspace {
                put(inout out, "\\b");
            } else if c == Ascii::Tab {
                put(inout out, "\\t");
            } else if c == Ascii::Lf {
                put(inout out, "\\n");
            } else if c == Ascii::FormFeed {
                put(inout out, "\\f");
            } else if c == Ascii::Cr {
                put(inout out, "\\r");
            } else {
                charge_write(inout out, UNICODE_ESCAPE_LEN);
                out.bytes.extend(in "\\u00".as_bytes());
                out.bytes.push(hex_digit(c >> 4));
                out.bytes.push(hex_digit(c & 15));
            }
            start = wrapping_add(i, 1);
        }
    }
    if start < end {
        put_pool(inout out, in pool, start, end);
    }
    put(inout out, "\"");
}

// `itoa` of `magnitude` (with a sign when `negative`), one write.
fn put_integer(inout out: Out, negative: bool, magnitude: u64) -> Unit eff [Fail[Perr]] {
    let mut digits: ChunkSeq[u8] = ChunkSeq::new();
    if negative {
        digits.push(Ascii::Dash);
    }
    push_decimal(inout digits, magnitude);
    charge_write(inout out, digits.len());
    out.bytes.extend(in digits[0..digits.len()]);
}

fn push_decimal(inout out: ChunkSeq[u8], number: u64) {
    if number >= 10 {
        push_decimal(inout out, number / 10);
    }
    out.push(wrapping_u8(wrapping_add(number % 10, Ascii::Zero)));
}

// The `count` decimal digits of `number`, most significant first.
fn digits_of(number: u64, count: u64) -> ChunkSeq[u8] {
    let mut reversed: ChunkSeq[u8] = ChunkSeq::new();
    let mut rest = number;
    for i in 0..count {
        reversed.push(wrapping_u8(wrapping_add(rest % 10, Ascii::Zero)));
        rest = rest / 10;
    }
    let mut out: ChunkSeq[u8] = ChunkSeq::with_capacity(count);
    let mut i = count;
    loop {
        if i == 0 {
            break;
        }
        i = wrapping_sub(i, 1);
        match reversed.try_get(i) {
            Option::Some(c) => out.push(c),
            Option::None => {}
        }
    }
    out
}

fn push_exponent(inout out: ChunkSeq[u8], exponent: i64) {
    if exponent < 0 {
        out.push(Ascii::Dash);
        push_decimal(inout out, wrapping_u64(wrapping_sub(0, exponent)));
    } else {
        // serde_json's writer signs positive exponents ("1e+16").
        out.push(Ascii::Plus);
        push_decimal(inout out, wrapping_u64(exponent));
    }
}

// The shortest digits the serde port gives are Rust's `Display` digits,
// which round a value exactly halfway between two shortest candidates up;
// serde_json's writer (zmij) takes the even one: 1000000000000000.25 is
// `1000000000000000.2`. A tie means the double's exact value is
// `(10 * digits -+ 5) * 10^(k - n - 1)`: with `m * 2^e` its odd
// significand, `e` is that power of ten and the odd parts agree.
fn even_tie(bits: u64, decimal: Shortest) -> Shortest {
    if decimal.n == 0 || decimal.digits & 1 == 0 {
        return decimal;
    }
    let biased = (bits >> F64::SignificandBits) & F64::ExponentMask;
    let mut m = bits & F64::SignificandMask;
    let mut e: i64 = SUBNORMAL_EXPONENT;
    if biased != 0 {
        m = m | F64::HiddenBit;
        e = wrapping_sub(wrapping_i64(biased), F64::ExponentBias);
    }
    loop {
        if m & 1 == 1 {
            break;
        }
        m = m >> 1;
        e = wrapping_add(e, 1);
    }
    let scale = wrapping_sub(wrapping_sub(decimal.k, wrapping_i64(decimal.n)), 1);
    if e != scale {
        return decimal;
    }
    let scaled_digits = wrapping_mul(decimal.digits, 10);
    let mut out = decimal;
    if exact_odd(wrapping_sub(scaled_digits, HALF_ULP_DIGIT), m, scale) {
        // Rounded up from the midpoint: the even candidate is below.
        out.digits = wrapping_sub(decimal.digits, 1);
    } else if exact_odd(wrapping_add(scaled_digits, HALF_ULP_DIGIT), m, scale) {
        out.digits = wrapping_add(decimal.digits, 1);
    } else {
        return decimal;
    }
    // Keep the digit count; strip a trailing zero the change made.
    if decimal_len(out.digits) != decimal.n {
        return decimal;
    }
    loop {
        if out.n <= 1 || out.digits % 10 != 0 {
            break;
        }
        out.digits = out.digits / 10;
        out.n = wrapping_sub(out.n, 1);
    }
    out
}

// Whether `x * 10^scale == m * 2^scale` for odd `x` and `m`: `x * 5^scale
// == m` when `scale >= 0`, else `x == m * 5^-scale`.
fn exact_odd(x: u64, m: u64, scale: i64) -> bool {
    let mut small = x;
    let mut big = m;
    let mut power = scale;
    if scale < 0 {
        small = m;
        big = x;
        power = wrapping_sub(0, scale);
    }
    for i in 0..wrapping_u64(power) {
        if small > big / 5 {
            return false;
        }
        small = wrapping_mul(small, 5);
    }
    small == big
}

// ryu's `format64` layout (serde_json's `f64` text) from the shortest digits:
// `decimal.digits` holds `decimal.n` digits and the value is
// `0.digits * 10^decimal.k`.
fn put_float(inout out: Out, bits: u64) -> Unit eff [Fail[Perr]] {
    let mut rendered: ChunkSeq[u8] = ChunkSeq::new();
    if bits >> F64::SignShift == 1 {
        rendered.push(Ascii::Dash);
    }
    if bits & F64::MagnitudeMask == 0 {
        rendered.extend(in "0.0".as_bytes());
    } else {
        let decimal = even_tie(bits, shortest(bits));
        let digit_text = digits_of(decimal.digits, decimal.n);
        let digit_count = wrapping_i64(decimal.n);
        let decimal_exp = decimal.k;
        let trailing_zeros = wrapping_sub(decimal_exp, digit_count);
        if trailing_zeros >= 0 && decimal_exp <= PLAIN_EXPONENT {
            rendered.extend(in digit_text[0..digit_text.len()]);
            for i in 0..wrapping_u64(trailing_zeros) {
                rendered.push(Ascii::Zero);
            }
            rendered.extend(in ".0".as_bytes());
        } else if decimal_exp > 0 && decimal_exp <= PLAIN_EXPONENT {
            let point = wrapping_u64(decimal_exp);
            rendered.extend(in digit_text[0..point]);
            rendered.push(Ascii::Dot);
            rendered.extend(in digit_text[point..digit_text.len()]);
        } else if decimal_exp > SMALL_EXPONENT && decimal_exp <= 0 {
            rendered.extend(in "0.".as_bytes());
            for i in 0..wrapping_u64(wrapping_sub(0, decimal_exp)) {
                rendered.push(Ascii::Zero);
            }
            rendered.extend(in digit_text[0..digit_text.len()]);
        } else if digit_count == 1 {
            rendered.extend(in digit_text[0..digit_text.len()]);
            rendered.push(Ascii::LowerE);
            push_exponent(inout rendered, wrapping_sub(decimal_exp, 1));
        } else {
            rendered.extend(in digit_text[0..1]);
            rendered.push(Ascii::Dot);
            rendered.extend(in digit_text[1..digit_text.len()]);
            rendered.push(Ascii::LowerE);
            push_exponent(inout rendered, wrapping_sub(decimal_exp, 1));
        }
    }
    charge_write(inout out, rendered.len());
    out.bytes.extend(in rendered[0..rendered.len()]);
}

// The `Serialize` of a `Value`, in serde_json's compact writes.
fn put_value(
    inout out: Out,
    in words: Slice[u64],
    in pool: Slice[u8],
    pos: u64
) -> u64 eff [Fail[Perr]] {
    let tag = word(in words, pos);
    if tag == Tag::Null {
        put(inout out, "null");
        return wrapping_add(pos, Value::NullWords);
    }
    let payload = word(in words, wrapping_add(pos, Value::Payload));
    if tag == Tag::Bool {
        if payload == 1 {
            put(inout out, "true");
        } else {
            put(inout out, "false");
        }
        return wrapping_add(pos, Value::Words);
    }
    if tag == Tag::U64 {
        put_integer(inout out, false, payload);
        return wrapping_add(pos, Value::Words);
    }
    if tag == Tag::I64 {
        let signed = wrapping_i64(payload);
        if signed < 0 {
            put_integer(inout out, true, wrapping_u64(wrapping_sub(0, signed)));
        } else {
            put_integer(inout out, false, payload);
        }
        return wrapping_add(pos, Value::Words);
    }
    if tag == Tag::F64 {
        put_float(inout out, payload);
        return wrapping_add(pos, Value::Words);
    }
    if tag == Tag::String {
        put_string(
            inout out,
            in pool,
            payload,
            word(in words, wrapping_add(pos, Value::StringLen))
        );
        return wrapping_add(pos, Value::StringWords);
    }
    if tag == Tag::Array {
        put(inout out, "[");
        let mut next_pos = wrapping_add(pos, Value::Words);
        for i in 0..payload {
            if i != 0 {
                put(inout out, ",");
            }
            next_pos = put_value(inout out, in words, in pool, next_pos);
        }
        put(inout out, "]");
        return next_pos;
    }
    put(inout out, "{");
    let mut next_pos = wrapping_add(pos, Value::Words);
    for i in 0..payload {
        if i != 0 {
            put(inout out, ",");
        }
        put_string(
            inout out,
            in pool,
            word(in words, wrapping_add(next_pos, Value::Payload)),
            word(in words, wrapping_add(next_pos, Value::StringLen))
        );
        put(inout out, ":");
        next_pos = put_value(
            inout out,
            in words,
            in pool,
            wrapping_add(next_pos, Value::StringWords)
        );
    }
    put(inout out, "}");
    next_pos
}

fn put_key(inout out: Out, in name: Str, first: bool) -> Unit eff [Fail[Perr]] {
    if !first {
        put(inout out, ",");
    }
    put(inout out, "\"");
    put(inout out, name);
    put(inout out, "\"");
    put(inout out, ":");
}

// serialize_i32 or the string of an `Id`, or `null`.
fn put_id(inout out: Out, in words: Slice[u64], in pool: Slice[u8]) -> Unit eff [Fail[Perr]] {
    let tag = word(in words, Head::IdTag);
    if tag == Id::Int {
        let id_int = wrapping_i64(word(in words, Head::IdInt));
        if id_int < 0 {
            put_integer(inout out, true, wrapping_u64(wrapping_sub(0, id_int)));
        } else {
            put_integer(inout out, false, wrapping_u64(id_int));
        }
    } else if tag == Id::String {
        put_string(inout out, in pool, word(in words, Head::IdOff), word(in words, Head::IdLen));
    } else {
        put(inout out, "null");
    }
}

// `Envelope::serialize`.
fn put_envelope(inout out: Out, in words: Slice[u64], in pool: Slice[u8]) -> Unit eff [Fail[Perr]] {
    put(inout out, "{");
    put_key(inout out, "jsonrpc", true);
    put(inout out, "\"");
    put(inout out, "2.0");
    put(inout out, "\"");
    let kind = word(in words, Head::Kind);
    if kind == Envelope::Request || kind == Envelope::Notification {
        let mut call_at: u64 = Call::NotificationAt;
        if kind == Envelope::Request {
            put_key(inout out, "id", false);
            put_id(inout out, in words, in pool);
            call_at = Head::Method;
        }
        put_key(inout out, "method", false);
        put_string(
            inout out,
            in pool,
            word(in words, wrapping_add(call_at, Call::MethodOff)),
            word(in words, wrapping_add(call_at, Call::MethodLen))
        );
        if word(in words, wrapping_add(call_at, Call::HasParams)) == 1 {
            put_key(inout out, "params", false);
            put_value(inout out, in words, in pool, wrapping_add(call_at, Call::Params));
        }
    } else {
        put_key(inout out, "id", false);
        put_id(inout out, in words, in pool);
        if word(in words, Head::Payload) == Payload::Error {
            put_key(inout out, "error", false);
            put(inout out, "{");
            put_key(inout out, "code", true);
            let code = wrapping_i64(word(in words, Head::Code));
            if code < 0 {
                put_integer(inout out, true, wrapping_u64(wrapping_sub(0, code)));
            } else {
                put_integer(inout out, false, wrapping_u64(code));
            }
            put_key(inout out, "message", false);
            put_string(
                inout out,
                in pool,
                word(in words, Head::MessageOff),
                word(in words, Head::MessageLen)
            );
            if word(in words, Head::HasData) == 1 {
                put_key(inout out, "data", false);
                put_value(inout out, in words, in pool, Head::Data);
            }
            put(inout out, "}");
        } else {
            put_key(inout out, "result", false);
            put_value(inout out, in words, in pool, Head::Result);
        }
    }
    put(inout out, "}");
}

fn decimal_len(number: u64) -> u64 {
    if number < 10 {
        1
    } else {
        wrapping_add(decimal_len(number / 10), 1)
    }
}

// `encode_frame`: the whole frame, or the first limit it breaks.
pub fn encode_frame(
    in words: Slice[u64],
    in pool: Slice[u8],
    limits: Plimits
) -> ChunkSeq[u8] eff [Fail[Perr]] {
    let budget = validate_output(in words, limits);
    let mut out = Out { bytes: ChunkSeq::new(), budget: budget };
    put_envelope(inout out, in words, in pool);
    let body_len = out.bytes.len();
    let header_bytes = wrapping_add(HEADER_FIXED, decimal_len(body_len));
    bound(header_bytes, limits.max_header_bytes, Perr::PHeaderLimit);
    // The header line without the CRLF that ends the headers.
    bound(wrapping_sub(header_bytes, Crlf::Len), limits.max_header_line_bytes, Perr::PHeaderLimit);
    bound(1, limits.max_headers, Perr::PHeaderLimit);
    let mut frame: ChunkSeq[u8] = ChunkSeq::with_capacity(wrapping_add(header_bytes, body_len));
    frame.extend(in "Content-Length: ".as_bytes());
    push_decimal(inout frame, body_len);
    frame.extend(in "\r\n\r\n".as_bytes());
    frame.extend(in out.bytes[0..body_len]);
    frame
}
