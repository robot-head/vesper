// `@vesper/vsys`: `.vsys` parser, validator, and canonical encoder
// (`crates/vesper-ffi/src/sys`).
use self::lexer::{
    Lexed, Tok, VsysError, err_duplicate, err_limit, err_syntax, err_type, err_unsupported,
    fail_vsys, lex, tok_arrow, tok_ellipsis, tok_eof, tok_num, tok_punct, tok_text, tok_word
};
use self::wire::{
    WireField, WireStructDef, compile_all, endian_be, endian_le, endian_native, wt_bytes, wt_int,
    wt_pad, wt_struct
};
use self::encode::{Encoder, new_encoder, put_bytes, put_count, put_decimal_const, put_str, put_u16};

// ---------------------------------------------------------------------------
// Slice / arena helpers.

fn u8_at(in s: Slice[u8], i: u64) -> u8 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

fn eq_bytes(in a: Slice[u8], in b: Slice[u8]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for i in 0..a.len() {
        if u8_at(in a, i) != u8_at(in b, i) {
            return false;
        }
    }
    true
}

fn lt_bytes(in a: Slice[u8], in b: Slice[u8]) -> bool {
    let n = if a.len() < b.len() {
        a.len()
    } else {
        b.len()
    };
    for i in 0..n {
        let xa = u8_at(in a, i);
        let xb = u8_at(in b, i);
        if xa != xb {
            return xa < xb;
        }
    }
    a.len() < b.len()
}

fn eq_str(in arena: Slice[u8], a: u64, b: u64, in lit: Str) -> bool {
    eq_bytes(in arena[a..b], in lit.as_bytes())
}

fn push_str_arena(inout arena: ChunkSeq[u8], in s: Str) -> (u64, u64) {
    let a = arena.len();
    arena.extend(in s.as_bytes());
    (a, arena.len())
}

// ---------------------------------------------------------------------------
// Scalar / float / integer descriptors.

fn scalar_name(sc: u8) -> Str {
    if sc == 1 {
        "u8"
    } else if sc == 2 {
        "i8"
    } else if sc == 3 {
        "u16"
    } else if sc == 4 {
        "i16"
    } else if sc == 5 {
        "u32"
    } else if sc == 6 {
        "i32"
    } else if sc == 7 {
        "u64"
    } else if sc == 8 {
        "i64"
    } else {
        "usize"
    }
}

fn parse_scalar(in s: Slice[u8]) -> u8 {
    if eq_bytes(in s, in "u8".as_bytes()) {
        1
    } else if eq_bytes(in s, in "i8".as_bytes()) {
        2
    } else if eq_bytes(in s, in "u16".as_bytes()) {
        3
    } else if eq_bytes(in s, in "i16".as_bytes()) {
        4
    } else if eq_bytes(in s, in "u32".as_bytes()) {
        5
    } else if eq_bytes(in s, in "i32".as_bytes()) {
        6
    } else if eq_bytes(in s, in "u64".as_bytes()) {
        7
    } else if eq_bytes(in s, in "i64".as_bytes()) {
        8
    } else if eq_bytes(in s, in "usize".as_bytes()) {
        9
    } else {
        0
    }
}

fn scalar_signed(sc: u8) -> bool {
    sc == 2 || sc == 4 || sc == 6 || sc == 8
}

fn scalar_bits(sc: u8) -> u8 {
    if sc == 1 || sc == 2 {
        8
    } else if sc == 3 || sc == 4 {
        16
    } else if sc == 5 || sc == 6 {
        32
    } else {
        64
    }
}

fn parse_float(in s: Slice[u8]) -> u8 {
    if eq_bytes(in s, in "f32".as_bytes()) {
        1
    } else if eq_bytes(in s, in "f64".as_bytes()) {
        2
    } else {
        0
    }
}

fn float_name(fl: u8) -> Str {
    if fl == 1 {
        "f32"
    } else {
        "f64"
    }
}

fn is_reserved_type(in s: Slice[u8]) -> bool {
    parse_scalar(in s) != 0
        || parse_float(in s) != 0
        || eq_bytes(in s, in "bool".as_bytes())
        || eq_bytes(in s, in "Unit".as_bytes())
        || eq_bytes(in s, in "Ptr".as_bytes())
        || eq_bytes(in s, in "NullablePtr".as_bytes())
        || eq_bytes(in s, in "Option".as_bytes())
        || eq_bytes(in s, in "NonNull".as_bytes())
        || eq_bytes(in s, in "ForeignVal".as_bytes())
        || eq_bytes(in s, in "CStr".as_bytes())
        || eq_bytes(in s, in "CWStr".as_bytes())
        || eq_bytes(in s, in "CStrList".as_bytes())
        || eq_bytes(in s, in "CSlice".as_bytes())
        || eq_bytes(in s, in "Pinned".as_bytes())
        || eq_bytes(in s, in "ByteArray".as_bytes())
        || eq_bytes(in s, in "ZeroPad".as_bytes())
}

// ---------------------------------------------------------------------------
// IR records.

copy struct EnumVar {
    na: u64,
    nb: u64,
    val: u64,
}

copy struct EnumDef {
    na: u64,
    nb: u64,
    scalar: u8,
    v0: u64,
    vn: u64,
}

copy struct ConstDef {
    na: u64,
    nb: u64,
    scalar: u8,
    neg: bool,
    mag: u64,
}

copy struct ExternDef {
    na: u64,
    nb: u64,
    // 1 = linear, 2 = affine, 3 = callback
    linearity: u8,
    has_drop: bool,
    drop_a: u64,
    drop_b: u64,
    mapping: u8,
}

// Parameter kinds:
// 1=Value, 2=Slice, 3=Pointer, 4=Handle, 5=CStr, 6=CWStr, 7=CStrList, 8=Function, 9=Pinned
// ValueType tags:
// 1=Unit, 2=Scalar, 3=Float, 4=Bool, 5=Enum, 6=Address, 7=NullableAddress,
// 8=Handle, 9=NullableHandle, 10=NonNullHandle, 11=OptionCStr, 12=OptionCWStr
copy struct ValTy {
    tag: u8,
    sc: u8,
    na: u64,
    nb: u64,
}

copy struct ParDef {
    na: u64,
    nb: u64,
    kind: u8,
    // access: 1=in, 2=inout, 3=out, 4=sink
    access: u8,
    flag: bool,
    vt: ValTy,
    // pointee / handle / callback name
    p_sc: u8,
    p_na: u64,
    p_nb: u64,
    is_struct: bool,
}

copy struct FunDef {
    sym_a: u64,
    sym_b: u64,
    p0: u64,
    pn: u64,
    result: ValTy,
    has_len: bool,
    len_a: u64,
    len_b: u64,
    mapping_len: u64,
    has_mapping_len: bool,
    errno: bool,
    has_variadic: bool,
    variadic: u64,
    has_link: bool,
    link_a: u64,
    link_b: u64,
    indirect: bool,
}

// ---------------------------------------------------------------------------
// Token cursor.

struct P {
    toks: ChunkSeq[Tok],
    arena: ChunkSeq[u8],
    at: u64,
}

fn cur(in p: P) -> Tok {
    match p.toks.try_get(p.at) {
        Option::Some(t) => t,
        Option::None => Tok {
            kind: tok_eof(),
            a: 0,
            b: 0,
            num: 0,
            s0: 0,
            s1: 0,
        },
    }
}

fn peek_tok(in p: P, off: u64) -> Tok {
    match p.toks.try_get(wrapping_add(p.at, off)) {
        Option::Some(t) => t,
        Option::None => Tok {
            kind: tok_eof(),
            a: 0,
            b: 0,
            num: 0,
            s0: 0,
            s1: 0,
        },
    }
}

fn err_at[T](in p: P, kind: u8, code: u32) -> T eff [Fail[VsysError]] {
    let t = cur(in p);
    fail_vsys(kind, t.s0, t.s1, code)
}

fn bump(inout p: P) -> Tok {
    let t = cur(in p);
    if t.kind != tok_eof() {
        p.at = wrapping_add(p.at, 1);
    }
    t
}

fn eat_punct(inout p: P, ch: u8) -> bool {
    let t = cur(in p);
    if t.kind == tok_punct() && t.a == widen_u64(ch) {
        p.at = wrapping_add(p.at, 1);
        true
    } else {
        false
    }
}

fn expect_punct(inout p: P, ch: u8) eff [Fail[VsysError]] {
    if !eat_punct(inout p, ch) {
        err_at(in p, err_syntax(), 300)
    }
}

fn is_word(in p: P, in s: Str) -> bool {
    let t = cur(in p);
    t.kind == tok_word() && eq_str(in p.arena.as_slice(), t.a, t.b, in s)
}

fn peek_is_word(in p: P, off: u64, in s: Str) -> bool {
    let t = peek_tok(in p, off);
    t.kind == tok_word() && eq_str(in p.arena.as_slice(), t.a, t.b, in s)
}

fn peek_is_punct(in p: P, off: u64, ch: u8) -> bool {
    let t = peek_tok(in p, off);
    t.kind == tok_punct() && t.a == widen_u64(ch)
}

fn expect_word(inout p: P, in s: Str) eff [Fail[VsysError]] {
    if is_word(in p, in s) {
        let _ = bump(inout p);
    } else {
        err_at(in p, err_syntax(), 301)
    }
}

fn take_word(inout p: P) -> (u64, u64) eff [Fail[VsysError]] {
    let t = cur(in p);
    if t.kind != tok_word() {
        return err_at(in p, err_syntax(), 302);
    }
    let _ = bump(inout p);
    (t.a, t.b)
}

fn take_text(inout p: P) -> (u64, u64) eff [Fail[VsysError]] {
    let t = cur(in p);
    if t.kind != tok_text() {
        return err_at(in p, err_syntax(), 303);
    }
    let _ = bump(inout p);
    (t.a, t.b)
}

fn take_num(inout p: P) -> u64 eff [Fail[VsysError]] {
    let t = cur(in p);
    if t.kind != tok_num() {
        return err_at(in p, err_syntax(), 304);
    }
    let _ = bump(inout p);
    t.num
}

// ---------------------------------------------------------------------------
// Header option validation.

fn is_bare_link_name(in s: Slice[u8]) -> bool {
    let n = s.len();
    if n == 0 || n > 128 {
        return false;
    }
    let first = u8_at(in s, 0);
    if first == 45 {
        return false;
    }
    for i in 0..n {
        let c = u8_at(in s, i);
        let ok = (c >= 97 && c <= 122)
            || (c >= 65 && c <= 90)
            || (c >= 48 && c <= 57)
            || c == 95
            || c == 45
            || c == 46;
        if !ok {
            return false;
        }
    }
    true
}

fn parse_hex_nibble(c: u8) -> u8 {
    if c >= 48 && c <= 57 {
        wrapping_sub(c, 48)
    } else if c >= 97 && c <= 102 {
        wrapping_add(wrapping_sub(c, 97), 10)
    } else {
        255
    }
}

fn parse_artifact_blake3(in p: P, a: u64, b: u64) -> ChunkSeq[u8] eff [Fail[VsysError]] {
    let s = p.arena[a..b];
    if s.len() != 71 || !eq_bytes(in s[0..7], in "blake3:".as_bytes()) {
        return err_at(in p, err_syntax(), 310);
    }
    let mut out: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](32);
    for i in 0..32 {
        let hi = parse_hex_nibble(u8_at(in s, wrapping_add(7, wrapping_mul(i, 2))));
        let lo = parse_hex_nibble(u8_at(in s, wrapping_add(8, wrapping_mul(i, 2))));
        if hi > 15 || lo > 15 {
            return err_at(in p, err_syntax(), 311);
        }
        out.push(wrapping_shl_u8(hi, 4) | lo);
    }
    out
}

// ---------------------------------------------------------------------------
// Type parsing (value types, wire types, parameters).

fn parse_raw_val_type(inout p: P) -> ValTy eff [Fail[VsysError]] {
    let (na, nb) = take_word(inout p);
    let is_ptr = eq_bytes(in p.arena[na..nb], in "Ptr".as_bytes());
    let is_nptr = eq_bytes(in p.arena[na..nb], in "NullablePtr".as_bytes());
    if is_ptr || is_nptr {
        let nullable = is_nptr;
        expect_punct(inout p, 91);
        let (pa, pb) = take_word(inout p);
        let sc = parse_scalar(in p.arena[pa..pb]);
        if sc == 0 {
            return err_at(in p, err_unsupported(), 320);
        }
        expect_punct(inout p, 93);
        return ValTy {
            tag: if nullable {
                7
            } else {
                6
            },
            sc: sc,
            na: 0,
            nb: 0,
        };
    }
    let s = p.arena[na..nb];
    if eq_bytes(in s, in "Unit".as_bytes()) {
        return ValTy {
            tag: 1,
            sc: 0,
            na: 0,
            nb: 0,
        };
    }
    if eq_bytes(in s, in "bool".as_bytes()) {
        return ValTy {
            tag: 4,
            sc: 0,
            na: 0,
            nb: 0,
        };
    }
    let sc = parse_scalar(in s);
    if sc != 0 {
        return ValTy {
            tag: 2,
            sc: sc,
            na: 0,
            nb: 0,
        };
    }
    let fl = parse_float(in s);
    if fl != 0 {
        return ValTy {
            tag: 3,
            sc: fl,
            na: 0,
            nb: 0,
        };
    }
    // Named enum or handle (resolved later).
    ValTy {
        tag: 5,
        sc: 0,
        na: na,
        nb: nb,
    }
}

fn parse_wire_field_type(inout p: P, name_a: u64, name_b: u64, s0: u64, s1: u64)
    -> WireField eff [Fail[VsysError]] {
    let (ta, tb) = take_word(inout p);
    let is_ba = eq_bytes(in p.arena[ta..tb], in "ByteArray".as_bytes());
    let is_zp = eq_bytes(in p.arena[ta..tb], in "ZeroPad".as_bytes());
    if is_ba || is_zp {
        let is_pad = is_zp;
        expect_punct(inout p, 91);
        let n = take_num(inout p);
        expect_punct(inout p, 93);
        return WireField {
            name_a: name_a,
            name_b: name_b,
            kind: if is_pad {
                wt_pad()
            } else {
                wt_bytes()
            },
            signed: false,
            bits: 0,
            endian: 0,
            count: n,
            struct_a: 0,
            struct_b: 0,
            s0: s0,
            s1: s1,
        };
    }
    let ts = p.arena[ta..tb];
    let mut endian = endian_native();
    let mut base_len = ts.len();
    if base_len > 2 {
        let e0 = u8_at(in ts, wrapping_sub(base_len, 2));
        let e1 = u8_at(in ts, wrapping_sub(base_len, 1));
        if e0 == 108 && e1 == 101 {
            endian = endian_le();
            base_len = wrapping_sub(base_len, 2);
        } else if e0 == 98 && e1 == 101 {
            endian = endian_be();
            base_len = wrapping_sub(base_len, 2);
        }
    }
    let base = p.arena[ta..wrapping_add(ta, base_len)];
    let sc = parse_scalar(in base);
    if sc != 0 && sc != 9 {
        let bits = scalar_bits(sc);
        if bits == 8 && endian != endian_native() {
            return err_at(in p, err_type(), 330);
        }
        return WireField {
            name_a: name_a,
            name_b: name_b,
            kind: wt_int(),
            signed: scalar_signed(sc),
            bits: bits,
            endian: endian,
            count: 0,
            struct_a: 0,
            struct_b: 0,
            s0: s0,
            s1: s1,
        };
    }
    WireField {
        name_a: name_a,
        name_b: name_b,
        kind: wt_struct(),
        signed: false,
        bits: 0,
        endian: 0,
        count: 0,
        struct_a: ta,
        struct_b: tb,
        s0: s0,
        s1: s1,
    }
}

fn parse_borrowed_param(inout p: P, name_a: u64, name_b: u64, access: u8)
    -> ParDef eff [Fail[VsysError]] {
    let mut nullable = false;
    if is_word(in p, in "Option") {
        let _ = bump(inout p);
        expect_punct(inout p, 91);
        nullable = true;
    }
    let mut par = ParDef {
        na: name_a,
        nb: name_b,
        kind: 3,
        access: access,
        flag: nullable,
        vt: ValTy {
            tag: 1,
            sc: 0,
            na: 0,
            nb: 0,
        },
        p_sc: 0,
        p_na: 0,
        p_nb: 0,
        is_struct: false,
    };
    if is_word(in p, in "CStr") {
        if access != 1 || nullable {
            return err_at(in p, err_unsupported(), 340);
        }
        let _ = bump(inout p);
        par.kind = 5;
        return par;
    }
    if is_word(in p, in "CStrList") {
        if access != 1 || nullable {
            return err_at(in p, err_unsupported(), 341);
        }
        let _ = bump(inout p);
        par.kind = 7;
        return par;
    }
    if is_word(in p, in "CWStr") {
        if access != 1 || nullable {
            return err_at(in p, err_unsupported(), 342);
        }
        let _ = bump(inout p);
        par.kind = 6;
        return par;
    }
    if is_word(in p, in "CSlice") {
        if access == 3 {
            return err_at(in p, err_unsupported(), 343);
        }
        let _ = bump(inout p);
        expect_punct(inout p, 91);
        let (ea, eb) = take_word(inout p);
        let sc = parse_scalar(in p.arena[ea..eb]);
        par.kind = 2;
        if sc != 0 {
            par.p_sc = sc;
        } else {
            par.is_struct = true;
            par.p_na = ea;
            par.p_nb = eb;
        }
        expect_punct(inout p, 93);
        if nullable {
            expect_punct(inout p, 93);
        }
        return par;
    }
    let (ea, eb) = take_word(inout p);
    let sc = parse_scalar(in p.arena[ea..eb]);
    if sc != 0 {
        par.kind = 3;
        par.p_sc = sc;
    } else {
        // Could be WireStruct (Pointer) or Handle (resolved later).
        par.kind = 3;
        par.is_struct = true;
        par.p_na = ea;
        par.p_nb = eb;
    }
    if nullable {
        expect_punct(inout p, 93);
    }
    par
}

// ---------------------------------------------------------------------------
// Sorting helpers (insertion sort, deterministic).

fn sort_vars(inout vars: ChunkSeq[EnumVar], start: u64, n: u64, in arena: Slice[u8]) {
    for i in 1..n {
        let mut j = i;
        loop {
            if j == 0 {
                break;
            }
            let idx_a = wrapping_add(start, wrapping_sub(j, 1));
            let idx_b = wrapping_add(start, j);
            let a = match vars.try_get(idx_a) {
                Option::Some(v) => v,
                Option::None => break,
            };
            let b = match vars.try_get(idx_b) {
                Option::Some(v) => v,
                Option::None => break,
            };
            let swap = if lt_bytes(in arena[b.na..b.nb], in arena[a.na..a.nb]) {
                true
            } else if eq_bytes(in arena[a.na..a.nb], in arena[b.na..b.nb]) {
                b.val < a.val
            } else {
                false
            };
            if !swap {
                break;
            }
            vars.try_set(idx_a, b);
            vars.try_set(idx_b, a);
            j = wrapping_sub(j, 1);
        }
    }
}

fn sort_consts(inout cs: ChunkSeq[ConstDef], in arena: Slice[u8]) {
    let n = cs.len();
    for i in 1..n {
        let mut j = i;
        loop {
            if j == 0 {
                break;
            }
            let a = match cs.try_get(wrapping_sub(j, 1)) {
                Option::Some(v) => v,
                Option::None => break,
            };
            let b = match cs.try_get(j) {
                Option::Some(v) => v,
                Option::None => break,
            };
            if !lt_bytes(in arena[b.na..b.nb], in arena[a.na..a.nb]) {
                break;
            }
            cs.try_set(wrapping_sub(j, 1), b);
            cs.try_set(j, a);
            j = wrapping_sub(j, 1);
        }
    }
}

fn sort_enums(inout es: ChunkSeq[EnumDef], in arena: Slice[u8]) {
    let n = es.len();
    for i in 1..n {
        let mut j = i;
        loop {
            if j == 0 {
                break;
            }
            let a = match es.try_get(wrapping_sub(j, 1)) {
                Option::Some(v) => v,
                Option::None => break,
            };
            let b = match es.try_get(j) {
                Option::Some(v) => v,
                Option::None => break,
            };
            if !lt_bytes(in arena[b.na..b.nb], in arena[a.na..a.nb]) {
                break;
            }
            es.try_set(wrapping_sub(j, 1), b);
            es.try_set(j, a);
            j = wrapping_sub(j, 1);
        }
    }
}

fn sort_externs(inout xs: ChunkSeq[ExternDef], in arena: Slice[u8]) {
    let n = xs.len();
    for i in 1..n {
        let mut j = i;
        loop {
            if j == 0 {
                break;
            }
            let a = match xs.try_get(wrapping_sub(j, 1)) {
                Option::Some(v) => v,
                Option::None => break,
            };
            let b = match xs.try_get(j) {
                Option::Some(v) => v,
                Option::None => break,
            };
            if !lt_bytes(in arena[b.na..b.nb], in arena[a.na..a.nb]) {
                break;
            }
            xs.try_set(wrapping_sub(j, 1), b);
            xs.try_set(j, a);
            j = wrapping_sub(j, 1);
        }
    }
}

fn sort_wires(inout ws: ChunkSeq[WireStructDef], in arena: Slice[u8]) {
    let n = ws.len();
    for i in 1..n {
        let mut j = i;
        loop {
            if j == 0 {
                break;
            }
            let a = match ws.try_get(wrapping_sub(j, 1)) {
                Option::Some(v) => v,
                Option::None => break,
            };
            let b = match ws.try_get(j) {
                Option::Some(v) => v,
                Option::None => break,
            };
            if !lt_bytes(in arena[b.name_a..b.name_b], in arena[a.name_a..a.name_b]) {
                break;
            }
            ws.try_set(wrapping_sub(j, 1), b);
            ws.try_set(j, a);
            j = wrapping_sub(j, 1);
        }
    }
}

fn sort_funs(inout fs: ChunkSeq[FunDef], in arena: Slice[u8]) {
    let n = fs.len();
    for i in 1..n {
        let mut j = i;
        loop {
            if j == 0 {
                break;
            }
            let a = match fs.try_get(wrapping_sub(j, 1)) {
                Option::Some(v) => v,
                Option::None => break,
            };
            let b = match fs.try_get(j) {
                Option::Some(v) => v,
                Option::None => break,
            };
            if !lt_bytes(in arena[b.sym_a..b.sym_b], in arena[a.sym_a..a.sym_b]) {
                break;
            }
            fs.try_set(wrapping_sub(j, 1), b);
            fs.try_set(j, a);
            j = wrapping_sub(j, 1);
        }
    }
}

// ---------------------------------------------------------------------------
// Name resolution helpers.

fn find_enum(in es: Slice[EnumDef], in arena: Slice[u8], a: u64, b: u64) -> Option[u64] {
    for i in 0..es.len() {
        let e = match es.try_get(i) {
            Option::Some(v) => v,
            Option::None => continue,
        };
        if eq_bytes(in arena[e.na..e.nb], in arena[a..b]) {
            return Option::Some(i);
        }
    }
    Option::None
}

fn find_extern(in xs: Slice[ExternDef], in arena: Slice[u8], a: u64, b: u64) -> Option[u64] {
    for i in 0..xs.len() {
        let x = match xs.try_get(i) {
            Option::Some(v) => v,
            Option::None => continue,
        };
        if eq_bytes(in arena[x.na..x.nb], in arena[a..b]) {
            return Option::Some(i);
        }
    }
    Option::None
}

fn find_wire(in ws: Slice[WireStructDef], in arena: Slice[u8], a: u64, b: u64) -> Option[u64] {
    for i in 0..ws.len() {
        let w = match ws.try_get(i) {
            Option::Some(v) => v,
            Option::None => continue,
        };
        if eq_bytes(in arena[w.name_a..w.name_b], in arena[a..b]) {
            return Option::Some(i);
        }
    }
    Option::None
}

fn resolve_val_ty(in vt: ValTy, in es: Slice[EnumDef], in xs: Slice[ExternDef], in arena: Slice[u8])
    -> ValTy eff [Fail[VsysError]] {
    if vt.tag != 5 {
        return vt;
    }
    match find_enum(in es, in arena, vt.na, vt.nb) {
        Option::Some(_) => ValTy {
            tag: 5,
            sc: 0,
            na: vt.na,
            nb: vt.nb,
        },
        Option::None => match find_extern(in xs, in arena, vt.na, vt.nb) {
            Option::Some(_) => ValTy {
                tag: 8,
                sc: 0,
                na: vt.na,
                nb: vt.nb,
            },
            Option::None => fail_vsys(err_type(), 0, 0, 401),
        },
    }
}

fn encode_val_ty(inout enc: Encoder, in vt: ValTy, in arena: Slice[u8]) eff [Fail[VsysError]] {
    if vt.tag == 1 {
        put_str(inout enc, in "unit");
    } else if vt.tag == 2 {
        put_str(inout enc, in "scalar");
        put_str(inout enc, in scalar_name(vt.sc));
    } else if vt.tag == 3 {
        put_str(inout enc, in "float");
        put_str(inout enc, in float_name(vt.sc));
    } else if vt.tag == 4 {
        put_str(inout enc, in "bool-u8");
    } else if vt.tag == 5 {
        put_str(inout enc, in "enum");
        put_bytes(inout enc, in arena[vt.na..vt.nb]);
    } else if vt.tag == 6 {
        put_str(inout enc, in "address");
        put_str(inout enc, in scalar_name(vt.sc));
    } else if vt.tag == 7 {
        put_str(inout enc, in "nullable-address");
        put_str(inout enc, in scalar_name(vt.sc));
    } else if vt.tag == 8 {
        put_str(inout enc, in "handle");
        put_bytes(inout enc, in arena[vt.na..vt.nb]);
    } else if vt.tag == 9 {
        put_str(inout enc, in "nullable-handle");
        put_bytes(inout enc, in arena[vt.na..vt.nb]);
    } else if vt.tag == 10 {
        put_str(inout enc, in "nonnull-handle");
        put_bytes(inout enc, in arena[vt.na..vt.nb]);
    } else if vt.tag == 11 {
        put_str(inout enc, in "nullable-cstr-copy");
    } else {
        put_str(inout enc, in "nullable-cwstr-copy");
    }
}

fn encode_fun(inout enc: Encoder, in f: FunDef, in pars: Slice[ParDef], in arena: Slice[u8]) eff [
    Fail[VsysError]
] {
    put_bytes(inout enc, in arena[f.sym_a..f.sym_b]);
    put_count(inout enc, f.pn);
    for pi in 0..f.pn {
        let par = match pars.try_get(wrapping_add(f.p0, pi)) {
            Option::Some(v) => v,
            Option::None => continue,
        };
        put_bytes(inout enc, in arena[par.na..par.nb]);
        if par.kind == 1 {
            put_str(inout enc, in "value");
            encode_val_ty(inout enc, in par.vt, in arena);
        } else if par.kind == 2 {
            let acc = if par.access == 1 {
                "in"
            } else {
                "inout"
            };
            if !par.is_struct && !par.flag {
                put_str(inout enc, in "nocapture-slice");
                put_str(inout enc, in acc);
                put_str(inout enc, in scalar_name(par.p_sc));
            } else {
                put_str(inout enc, in "nocapture-slice/2");
                put_str(inout enc, in acc);
                put_str(
                    inout enc,
                    in if par.flag {
                        "option"
                    } else {
                        "nonnull"
                    }
                );
                if !par.is_struct {
                    put_str(inout enc, in "scalar");
                    put_str(inout enc, in scalar_name(par.p_sc));
                } else {
                    put_str(inout enc, in "wire-struct");
                    put_bytes(inout enc, in arena[par.p_na..par.p_nb]);
                }
            }
        } else if par.kind == 3 {
            put_str(inout enc, in "nocapture-pointer");
            let acc = if par.access == 1 {
                "in"
            } else if par.access == 2 {
                "inout"
            } else {
                "out"
            };
            put_str(inout enc, in acc);
            put_str(
                inout enc,
                in if par.flag {
                    "option"
                } else {
                    "nonnull"
                }
            );
            if !par.is_struct {
                put_str(inout enc, in "scalar");
                put_str(inout enc, in scalar_name(par.p_sc));
            } else {
                put_str(inout enc, in "wire-struct");
                put_bytes(inout enc, in arena[par.p_na..par.p_nb]);
            }
        } else if par.kind == 4 {
            put_str(inout enc, in "extern-handle");
            let acc = if par.access == 1 {
                "in"
            } else if par.access == 2 {
                "inout"
            } else if par.access == 3 {
                "out"
            } else {
                "sink"
            };
            put_str(inout enc, in acc);
            put_bytes(inout enc, in arena[par.p_na..par.p_nb]);
        } else if par.kind == 5 {
            put_str(inout enc, in "nocapture-cstr");
        } else if par.kind == 6 {
            put_str(inout enc, in "nocapture-cwstr");
        } else if par.kind == 7 {
            put_str(inout enc, in "nocapture-cstr-list");
        } else if par.kind == 8 {
            put_str(inout enc, in "callback-function");
            put_str(
                inout enc,
                in if par.flag {
                    "retain"
                } else {
                    "nocapture"
                }
            );
            put_bytes(inout enc, in arena[par.p_na..par.p_nb]);
        } else {
            put_str(inout enc, in "pinned-buffer");
            put_str(
                inout enc,
                in if par.access == 1 {
                    "in"
                } else {
                    "inout"
                }
            );
            put_str(inout enc, in scalar_name(par.p_sc));
        }
    }
    encode_val_ty(inout enc, in f.result, in arena);
    if f.has_mapping_len {
        put_str(inout enc, in "mapping/length-from");
        put_count(inout enc, f.mapping_len);
    }
    if f.errno {
        put_str(inout enc, in "errno/after-call");
    }
    if f.has_variadic {
        put_str(inout enc, in "variadic/from");
        put_count(inout enc, f.variadic);
    }
    if f.has_link {
        put_str(inout enc, in "link-name");
        put_bytes(inout enc, in arena[f.link_a..f.link_b]);
    }
}

// ---------------------------------------------------------------------------
// Top-level `.vsys` parser + canonical encoder.

pub fn parse_and_encode(in source: Slice[u8]) -> ChunkSeq[u8] eff [Fail[VsysError]] {
    let lexed = lex(in source);
    let mut p = P {
        toks: lexed.toks,
        arena: lexed.arena,
        at: 0,
    };
    expect_word(inout p, in "sys");
    expect_word(inout p, in "library");
    let (lib_a, lib_b) = take_word(inout p);
    expect_punct(inout p, 40);
    let mut has_target = false;
    let mut target_a: u64 = 0;
    let mut target_b: u64 = 0;
    let mut has_abi = false;
    let mut abi_a: u64 = 0;
    let mut abi_b: u64 = 0;
    let mut has_link = false;
    let mut link_a: u64 = 0;
    let mut link_b: u64 = 0;
    let mut has_name = false;
    let mut name_a: u64 = 0;
    let mut name_b: u64 = 0;
    let mut has_art = false;
    let mut art_a: u64 = 0;
    let mut art_b: u64 = 0;
    let mut has_hdr = false;
    let mut hdr_a: u64 = 0;
    let mut hdr_b: u64 = 0;
    let mut has_pkg = false;
    let mut pkg_a: u64 = 0;
    let mut pkg_b: u64 = 0;
    loop {
        if eat_punct(inout p, 41) {
            break;
        }
        let (ka, kb) = take_word(inout p);
        expect_punct(inout p, 61);
        let (va, vb) = take_text(inout p);
        if eq_str(in p.arena.as_slice(), ka, kb, in "target") {
            if has_target {
                return err_at(in p, err_duplicate(), 500);
            }
            has_target = true;
            target_a = va;
            target_b = vb;
        } else if eq_str(in p.arena.as_slice(), ka, kb, in "abi") {
            if has_abi {
                return err_at(in p, err_duplicate(), 500);
            }
            has_abi = true;
            abi_a = va;
            abi_b = vb;
        } else if eq_str(in p.arena.as_slice(), ka, kb, in "link") {
            if has_link {
                return err_at(in p, err_duplicate(), 500);
            }
            has_link = true;
            link_a = va;
            link_b = vb;
        } else if eq_str(in p.arena.as_slice(), ka, kb, in "name") {
            if has_name {
                return err_at(in p, err_duplicate(), 500);
            }
            has_name = true;
            name_a = va;
            name_b = vb;
        } else if eq_str(in p.arena.as_slice(), ka, kb, in "artifact") {
            if has_art {
                return err_at(in p, err_duplicate(), 500);
            }
            has_art = true;
            art_a = va;
            art_b = vb;
        } else if eq_str(in p.arena.as_slice(), ka, kb, in "header") {
            if has_hdr {
                return err_at(in p, err_duplicate(), 500);
            }
            has_hdr = true;
            hdr_a = va;
            hdr_b = vb;
        } else if eq_str(in p.arena.as_slice(), ka, kb, in "pkg_config") {
            if has_pkg {
                return err_at(in p, err_duplicate(), 500);
            }
            has_pkg = true;
            pkg_a = va;
            pkg_b = vb;
        } else {
            return err_at(in p, err_unsupported(), 501);
        }
        if !eat_punct(inout p, 44) {
            expect_punct(inout p, 41);
            break;
        }
    }
    if !has_target || !has_abi || !has_link || !has_name || !has_art {
        return err_at(in p, err_syntax(), 502);
    }
    let mut expected_abi = "sysv64";
    if eq_str(in p.arena.as_slice(), target_a, target_b, in "x86_64-unknown-linux-gnu") {
        expected_abi = "sysv64";
    } else if eq_str(in p.arena.as_slice(), target_a, target_b, in "aarch64-unknown-linux-gnu") {
        expected_abi = "aapcs64";
    } else if eq_str(in p.arena.as_slice(), target_a, target_b, in "aarch64-apple-darwin") {
        expected_abi = "darwin64";
    } else if eq_str(in p.arena.as_slice(), target_a, target_b, in "x86_64-pc-windows-msvc") {
        expected_abi = "win64";
    } else {
        return err_at(in p, err_type(), 503);
    }
    if !eq_str(in p.arena.as_slice(), abi_a, abi_b, in expected_abi) {
        return err_at(in p, err_type(), 504);
    }
    if !eq_str(in p.arena.as_slice(), link_a, link_b, in "static")
        && !eq_str(in p.arena.as_slice(), link_a, link_b, in "dynamic") {
        return err_at(in p, err_type(), 505);
    }
    if !is_bare_link_name(in p.arena[name_a..name_b]) {
        return err_at(in p, err_type(), 506);
    }
    let blake3_bytes = parse_artifact_blake3(in p, art_a, art_b);
    expect_punct(inout p, 123);

    let mut enums: ChunkSeq[EnumDef] = ChunkSeq::new[EnumDef]();
    let mut enum_vars: ChunkSeq[EnumVar] = ChunkSeq::new[EnumVar]();
    let mut consts: ChunkSeq[ConstDef] = ChunkSeq::new[ConstDef]();
    let mut externs: ChunkSeq[ExternDef] = ChunkSeq::new[ExternDef]();
    let mut wires: ChunkSeq[WireStructDef] = ChunkSeq::new[WireStructDef]();
    let mut wire_fields: ChunkSeq[WireField] = ChunkSeq::new[WireField]();
    let mut funs: ChunkSeq[FunDef] = ChunkSeq::new[FunDef]();
    let mut pars: ChunkSeq[ParDef] = ChunkSeq::new[ParDef]();

    loop {
        if eat_punct(inout p, 125) {
            break;
        }
        if is_word(in p, in "const") {
            let _ = bump(inout p);
            let (ca, cb) = take_word(inout p);
            if is_reserved_type(in p.arena[ca..cb])
                || eq_str(in p.arena.as_slice(), ca, cb, in "true")
                || eq_str(in p.arena.as_slice(), ca, cb, in "false") {
                return err_at(in p, err_type(), 510);
            }
            expect_punct(inout p, 58);
            let (sa, sb) = take_word(inout p);
            let sc = parse_scalar(in p.arena[sa..sb]);
            if sc == 0 {
                return err_at(in p, err_unsupported(), 511);
            }
            expect_punct(inout p, 61);
            let neg = eat_punct(inout p, 45);
            let mag = take_num(inout p);
            if neg && !scalar_signed(sc) {
                return err_at(in p, err_type(), 512);
            }
            let bits = scalar_bits(sc);
            if neg {
                let max_neg = wrapping_shl_u64(1, wrapping_sub(widen_u32(bits), 1));
                if mag > max_neg {
                    return err_at(in p, err_type(), 513);
                }
            } else {
                let max_pos: u64 = if scalar_signed(sc) {
                    wrapping_sub(wrapping_shl_u64(1, wrapping_sub(widen_u32(bits), 1)), 1)
                } else if bits == 64 {
                    18446744073709551615
                } else {
                    wrapping_sub(wrapping_shl_u64(1, widen_u32(bits)), 1)
                };
                if mag > max_pos {
                    return err_at(in p, err_type(), 514);
                }
            }
            expect_punct(inout p, 59);
            consts
                .push(
                    ConstDef {
                        na: ca,
                        nb: cb,
                        scalar: sc,
                        neg: neg,
                        mag: mag,
                    }
                );
        } else if is_word(in p, in "enum") {
            let _ = bump(inout p);
            let (ea, eb) = take_word(inout p);
            if is_reserved_type(in p.arena[ea..eb]) {
                return err_at(in p, err_type(), 520);
            }
            expect_punct(inout p, 58);
            let (sa, sb) = take_word(inout p);
            let sc = parse_scalar(in p.arena[sa..sb]);
            if sc == 0 || scalar_signed(sc) || sc == 9 {
                return err_at(in p, err_unsupported(), 521);
            }
            expect_punct(inout p, 123);
            let v0 = enum_vars.len();
            let mut vn: u64 = 0;
            loop {
                if eat_punct(inout p, 125) {
                    break;
                }
                let (va, vb) = take_word(inout p);
                expect_punct(inout p, 61);
                let val = take_num(inout p);
                let bits = scalar_bits(sc);
                if bits < 64 && val >= wrapping_shl_u64(1, widen_u32(bits)) {
                    return err_at(in p, err_type(), 522);
                }
                for k in 0..vn {
                    let prev = match enum_vars.try_get(wrapping_add(v0, k)) {
                        Option::Some(v) => v,
                        Option::None => continue,
                    };
                    if prev.val == val {
                        return err_at(in p, err_duplicate(), 523);
                    }
                    if eq_bytes(in p.arena[prev.na..prev.nb], in p.arena[va..vb]) {
                        return err_at(in p, err_duplicate(), 524);
                    }
                }
                enum_vars
                    .push(
                        EnumVar {
                            na: va,
                            nb: vb,
                            val: val,
                        }
                    );
                vn = wrapping_add(vn, 1);
                if !eat_punct(inout p, 44) {
                    expect_punct(inout p, 125);
                    break;
                }
            }
            if vn == 0 {
                return err_at(in p, err_type(), 525);
            }
            sort_vars(inout enum_vars, v0, vn, in p.arena.as_slice());
            enums
                .push(
                    EnumDef {
                        na: ea,
                        nb: eb,
                        scalar: sc,
                        v0: v0,
                        vn: vn,
                    }
                );
        } else if (is_word(in p, in "linear") || is_word(in p, in "affine"))
            && peek_is_word(in p, 1, in "extern") {
            let lin: u8 = if is_word(in p, in "linear") {
                1
            } else {
                2
            };
            let _ = bump(inout p);
            let _ = bump(inout p);
            if is_word(in p, in "mapping") {
                if lin != 1 {
                    return err_at(in p, err_type(), 530);
                }
                let _ = bump(inout p);
                let (xa, xb) = take_word(inout p);
                if is_reserved_type(in p.arena[xa..xb]) {
                    return err_at(in p, err_type(), 531);
                }
                expect_punct(inout p, 91);
                let (ma, mb) = take_word(inout p);
                let msc = parse_scalar(in p.arena[ma..mb]);
                if msc != 1 && msc != 5 && msc != 7 && msc != 8 && msc != 9 {
                    return err_at(in p, err_unsupported(), 532);
                }
                expect_punct(inout p, 93);
                expect_punct(inout p, 59);
                externs
                    .push(
                        ExternDef {
                            na: xa,
                            nb: xb,
                            linearity: 1,
                            has_drop: false,
                            drop_a: 0,
                            drop_b: 0,
                            mapping: msc,
                        }
                    );
            } else {
                expect_word(inout p, in "type");
                let (xa, xb) = take_word(inout p);
                if is_reserved_type(in p.arena[xa..xb]) {
                    return err_at(in p, err_type(), 533);
                }
                let mut has_drop = false;
                let mut da: u64 = 0;
                let mut db: u64 = 0;
                if is_word(in p, in "drop") {
                    if lin == 1 {
                        return err_at(in p, err_type(), 534);
                    }
                    let _ = bump(inout p);
                    let (d0, d1) = take_word(inout p);
                    has_drop = true;
                    da = d0;
                    db = d1;
                }
                expect_punct(inout p, 59);
                externs
                    .push(
                        ExternDef {
                            na: xa,
                            nb: xb,
                            linearity: lin,
                            has_drop: has_drop,
                            drop_a: da,
                            drop_b: db,
                            mapping: 0,
                        }
                    );
            }
        } else if is_word(in p, in "wire") {
            let wt = cur(in p);
            let _ = bump(inout p);
            expect_word(inout p, in "struct");
            let (wa, wb) = take_word(inout p);
            if is_reserved_type(in p.arena[wa..wb]) {
                return err_at(in p, err_type(), 540);
            }
            expect_punct(inout p, 123);
            let f0 = wire_fields.len();
            let mut fn_count: u64 = 0;
            loop {
                if eat_punct(inout p, 125) {
                    break;
                }
                let ft = cur(in p);
                let (fa, fb) = take_word(inout p);
                expect_punct(inout p, 58);
                let wf = parse_wire_field_type(inout p, fa, fb, ft.s0, ft.s1);
                wire_fields.push(wf);
                fn_count = wrapping_add(fn_count, 1);
                if !eat_punct(inout p, 44) {
                    expect_punct(inout p, 125);
                    break;
                }
            }
            wires
                .push(
                    WireStructDef {
                        name_a: wa,
                        name_b: wb,
                        f0: f0,
                        fn_count: fn_count,
                        size: 0,
                        alignment: 0,
                        s0: wt.s0,
                        s1: wt.s1,
                    }
                );
        } else if is_word(in p, in "fn")
            || is_word(in p, in "callback")
            || peek_is_punct(in p, 0, 35) {
            let mut has_link_attr = false;
            let mut la: u64 = 0;
            let mut lb: u64 = 0;
            if eat_punct(inout p, 35) {
                expect_punct(inout p, 91);
                expect_word(inout p, in "link_name");
                expect_punct(inout p, 61);
                let (t0, t1) = take_text(inout p);
                expect_punct(inout p, 93);
                has_link_attr = true;
                la = t0;
                lb = t1;
            }
            let is_cb = !has_link_attr && is_word(in p, in "callback");
            if is_cb {
                let _ = bump(inout p);
            } else {
                expect_word(inout p, in "fn");
            }
            let (sym_a, sym_b) = take_word(inout p);
            expect_punct(inout p, 40);
            let p0 = pars.len();
            let mut pn: u64 = 0;
            if is_cb {
                let (ha, hb) = push_str_arena(inout p.arena, in "callee");
                pars
                    .push(
                        ParDef {
                            na: ha,
                            nb: hb,
                            kind: 4,
                            access: 1,
                            flag: false,
                            vt: ValTy {
                                tag: 1,
                                sc: 0,
                                na: 0,
                                nb: 0,
                            },
                            p_sc: 0,
                            p_na: sym_a,
                            p_nb: sym_b,
                            is_struct: false,
                        }
                    );
                pn = 1;
            }
            let mut has_variadic = false;
            let mut variadic: u64 = 0;
            loop {
                if eat_punct(inout p, 41) {
                    break;
                }
                if cur(in p).kind == tok_ellipsis() {
                    if has_variadic || pn == 0 {
                        return err_at(in p, err_syntax(), 550);
                    }
                    let _ = bump(inout p);
                    if !eat_punct(inout p, 44) || peek_is_punct(in p, 0, 41) {
                        return err_at(in p, err_syntax(), 551);
                    }
                    has_variadic = true;
                    variadic = pn;
                    continue;
                }
                if (is_word(in p, in "nocapture") || is_word(in p, in "retain"))
                    && peek_is_punct(in p, 2, 58)
                    && !peek_is_word(in p, 1, in "in")
                    && !peek_is_word(in p, 1, in "out")
                    && !peek_is_word(in p, 1, in "inout") {
                    let retain = is_word(in p, in "retain");
                    let _ = bump(inout p);
                    let (pa, pb) = take_word(inout p);
                    expect_punct(inout p, 58);
                    let (ca, cb) = take_word(inout p);
                    pars
                        .push(
                            ParDef {
                                na: pa,
                                nb: pb,
                                kind: 8,
                                access: 1,
                                flag: retain,
                                vt: ValTy {
                                    tag: 1,
                                    sc: 0,
                                    na: 0,
                                    nb: 0,
                                },
                                p_sc: 0,
                                p_na: ca,
                                p_nb: cb,
                                is_struct: false,
                            }
                        );
                    pn = wrapping_add(pn, 1);
                    if !eat_punct(inout p, 44) {
                        expect_punct(inout p, 41);
                        break;
                    }
                    continue;
                }
                let nocap = is_word(in p, in "nocapture");
                if nocap {
                    let _ = bump(inout p);
                }
                if !nocap && is_word(in p, in "sink") && peek_tok(in p, 1).kind == tok_word() {
                    let _ = bump(inout p);
                    let (pa, pb) = take_word(inout p);
                    expect_punct(inout p, 58);
                    let (ha, hb) = take_word(inout p);
                    pars
                        .push(
                            ParDef {
                                na: pa,
                                nb: pb,
                                kind: 4,
                                access: 4,
                                flag: false,
                                vt: ValTy {
                                    tag: 1,
                                    sc: 0,
                                    na: 0,
                                    nb: 0,
                                },
                                p_sc: 0,
                                p_na: ha,
                                p_nb: hb,
                                is_struct: false,
                            }
                        );
                    pn = wrapping_add(pn, 1);
                    if !eat_punct(inout p, 44) {
                        expect_punct(inout p, 41);
                        break;
                    }
                    continue;
                }
                let mut acc: u8 = 0;
                if peek_tok(in p, 1).kind == tok_word() {
                    if is_word(in p, in "in") {
                        acc = 1;
                    } else if is_word(in p, in "inout") {
                        acc = 2;
                    } else if is_word(in p, in "out") {
                        acc = 3;
                    }
                }
                if acc != 0 {
                    let _ = bump(inout p);
                    let (pa, pb) = take_word(inout p);
                    expect_punct(inout p, 58);
                    if !nocap && is_word(in p, in "Pinned") && peek_is_punct(in p, 1, 91) {
                        if acc == 3 {
                            return err_at(in p, err_unsupported(), 552);
                        }
                        let _ = bump(inout p);
                        expect_punct(inout p, 91);
                        let (ea, eb) = take_word(inout p);
                        let sc = parse_scalar(in p.arena[ea..eb]);
                        if sc == 0 {
                            return err_at(in p, err_unsupported(), 553);
                        }
                        expect_punct(inout p, 93);
                        pars
                            .push(
                                ParDef {
                                    na: pa,
                                    nb: pb,
                                    kind: 9,
                                    access: acc,
                                    flag: false,
                                    vt: ValTy {
                                        tag: 1,
                                        sc: 0,
                                        na: 0,
                                        nb: 0,
                                    },
                                    p_sc: sc,
                                    p_na: 0,
                                    p_nb: 0,
                                    is_struct: false,
                                }
                            );
                    } else if nocap {
                        pars.push(parse_borrowed_param(inout p, pa, pb, acc));
                    } else {
                        let (ha, hb) = take_word(inout p);
                        pars
                            .push(
                                ParDef {
                                    na: pa,
                                    nb: pb,
                                    kind: 4,
                                    access: acc,
                                    flag: false,
                                    vt: ValTy {
                                        tag: 1,
                                        sc: 0,
                                        na: 0,
                                        nb: 0,
                                    },
                                    p_sc: 0,
                                    p_na: ha,
                                    p_nb: hb,
                                    is_struct: false,
                                }
                            );
                    }
                } else {
                    if nocap {
                        return err_at(in p, err_unsupported(), 554);
                    }
                    let (pa, pb) = take_word(inout p);
                    expect_punct(inout p, 58);
                    let vt = parse_raw_val_type(inout p);
                    pars
                        .push(
                            ParDef {
                                na: pa,
                                nb: pb,
                                kind: 1,
                                access: 0,
                                flag: false,
                                vt: vt,
                                p_sc: 0,
                                p_na: 0,
                                p_nb: 0,
                                is_struct: false,
                            }
                        );
                }
                pn = wrapping_add(pn, 1);
                if !eat_punct(inout p, 44) {
                    expect_punct(inout p, 41);
                    break;
                }
            }
            if cur(in p).kind != tok_arrow() {
                return err_at(in p, err_syntax(), 560);
            }
            let _ = bump(inout p);
            expect_word(inout p, in "ForeignVal");
            expect_punct(inout p, 91);
            let mut has_len = false;
            let mut len_a: u64 = 0;
            let mut len_b: u64 = 0;
            let mut res = ValTy {
                tag: 1,
                sc: 0,
                na: 0,
                nb: 0,
            };
            if is_word(in p, in "Option") && peek_is_punct(in p, 1, 91) {
                let _ = bump(inout p);
                expect_punct(inout p, 91);
                let (ra, rb) = take_word(inout p);
                if eat_punct(inout p, 91) {
                    let (la0, lb0) = take_word(inout p);
                    has_len = true;
                    len_a = la0;
                    len_b = lb0;
                    expect_punct(inout p, 93);
                }
                expect_punct(inout p, 93);
                if !has_len && eq_str(in p.arena.as_slice(), ra, rb, in "CStr") {
                    if is_cb {
                        return err_at(in p, err_unsupported(), 561);
                    }
                    res.tag = 11;
                } else if !has_len && eq_str(in p.arena.as_slice(), ra, rb, in "CWStr") {
                    if is_cb {
                        return err_at(in p, err_unsupported(), 562);
                    }
                    res.tag = 12;
                } else {
                    res.tag = 9;
                    res.na = ra;
                    res.nb = rb;
                }
            } else if is_word(in p, in "NonNull") && peek_is_punct(in p, 1, 91) {
                let _ = bump(inout p);
                expect_punct(inout p, 91);
                let (ra, rb) = take_word(inout p);
                expect_punct(inout p, 93);
                res.tag = 10;
                res.na = ra;
                res.nb = rb;
            } else {
                res = parse_raw_val_type(inout p);
            }
            expect_punct(inout p, 93);
            let errno = is_word(in p, in "errno");
            if errno {
                let _ = bump(inout p);
            }
            expect_punct(inout p, 59);
            if is_cb {
                externs
                    .push(
                        ExternDef {
                            na: sym_a,
                            nb: sym_b,
                            linearity: 3,
                            has_drop: false,
                            drop_a: 0,
                            drop_b: 0,
                            mapping: 0,
                        }
                    );
            }
            funs
                .push(
                    FunDef {
                        sym_a: sym_a,
                        sym_b: sym_b,
                        p0: p0,
                        pn: pn,
                        result: res,
                        has_len: has_len,
                        len_a: len_a,
                        len_b: len_b,
                        mapping_len: 0,
                        has_mapping_len: false,
                        errno: errno,
                        has_variadic: has_variadic,
                        variadic: variadic,
                        has_link: has_link_attr,
                        link_a: la,
                        link_b: lb,
                        indirect: is_cb,
                    }
                );
        } else {
            return err_at(in p, err_syntax(), 570);
        }
    }
    if cur(in p).kind != tok_eof() {
        return err_at(in p, err_syntax(), 571);
    }

    // Compile wire structs & sort declarations.
    compile_all(inout wires, in wire_fields.as_slice(), in p.arena.as_slice());
    sort_consts(inout consts, in p.arena.as_slice());
    sort_enums(inout enums, in p.arena.as_slice());
    sort_externs(inout externs, in p.arena.as_slice());
    sort_wires(inout wires, in p.arena.as_slice());

    // Resolve parameter & return types.
    for fi in 0..funs.len() {
        let mut f = match funs.try_get(fi) {
            Option::Some(v) => v,
            Option::None => continue,
        };
        for pi in 0..f.pn {
            let pidx = wrapping_add(f.p0, pi);
            let mut par = match pars.try_get(pidx) {
                Option::Some(v) => v,
                Option::None => continue,
            };
            if par.kind == 1 {
                par
                    .vt = resolve_val_ty(
                        in par.vt,
                        in enums.as_slice(),
                        in externs.as_slice(),
                        in p.arena.as_slice()
                    );
            } else if par.kind == 2 && par.is_struct {
                match find_wire(in wires.as_slice(), in p.arena.as_slice(), par.p_na, par.p_nb) {
                    Option::Some(_) => (),
                    Option::None => return fail_vsys(err_type(), 0, 0, 600),
                }
            } else if par.kind == 3 && par.is_struct {
                match find_wire(in wires.as_slice(), in p.arena.as_slice(), par.p_na, par.p_nb) {
                    Option::Some(_) => (),
                    Option::None => {
                        match find_extern(
                            in externs.as_slice(),
                            in p.arena.as_slice(),
                            par.p_na,
                            par.p_nb
                        ) {
                            Option::Some(_) => {
                                if par.flag {
                                    return fail_vsys(err_type(), 0, 0, 601);
                                }
                                par.kind = 4;
                                par.is_struct = false;
                            }
                            Option::None => return fail_vsys(err_type(), 0, 0, 602),
                        }
                    }
                }
            }
            if f.has_variadic && pi >= f.variadic {
                let word_ok = if par.kind == 1 {
                    par.vt.tag == 2 && scalar_bits(par.vt.sc) == 64
                } else {
                    true
                };
                if !word_ok {
                    return fail_vsys(err_unsupported(), 0, 0, 605);
                }
            }
            pars.try_set(pidx, par);
        }
        if f.result.tag == 9 || f.result.tag == 10 {
            match find_extern(
                in externs.as_slice(),
                in p.arena.as_slice(),
                f.result.na,
                f.result.nb
            ) {
                Option::Some(_) => (),
                Option::None => return fail_vsys(err_type(), 0, 0, 603),
            }
        } else {
            f
                .result = resolve_val_ty(
                    in f.result,
                    in enums.as_slice(),
                    in externs.as_slice(),
                    in p.arena.as_slice()
                );
        }
        if f.has_len {
            let mut found = false;
            for pi in 0..f.pn {
                let par = match pars.try_get(wrapping_add(f.p0, pi)) {
                    Option::Some(v) => v,
                    Option::None => continue,
                };
                if eq_bytes(in p.arena[par.na..par.nb], in p.arena[f.len_a..f.len_b]) {
                    f.mapping_len = pi;
                    f.has_mapping_len = true;
                    found = true;
                    break;
                }
            }
            if !found {
                return fail_vsys(err_type(), 0, 0, 604);
            }
        }
        funs.try_set(fi, f);
    }
    sort_funs(inout funs, in p.arena.as_slice());

    // Canonicalize!
    let mut enc = new_encoder(1048576);
    put_str(inout enc, in "vesper.vsys/1");
    put_bytes(inout enc, in p.arena[lib_a..lib_b]);
    put_bytes(inout enc, in p.arena[target_a..target_b]);
    put_bytes(inout enc, in p.arena[abi_a..abi_b]);
    put_str(inout enc, in "pointer64-little-endian");
    put_bytes(inout enc, in p.arena[link_a..link_b]);
    put_bytes(inout enc, in p.arena[name_a..name_b]);
    put_bytes(inout enc, in blake3_bytes.as_slice());
    if has_hdr {
        put_str(inout enc, in "some");
        put_bytes(inout enc, in p.arena[hdr_a..hdr_b]);
    } else {
        put_str(inout enc, in "none");
    }
    if has_pkg {
        put_str(inout enc, in "some");
        put_bytes(inout enc, in p.arena[pkg_a..pkg_b]);
    } else {
        put_str(inout enc, in "none");
    }
    put_count(inout enc, enums.len());
    for ei in 0..enums.len() {
        let e = match enums.try_get(ei) {
            Option::Some(v) => v,
            Option::None => continue,
        };
        put_bytes(inout enc, in p.arena[e.na..e.nb]);
        put_str(inout enc, in scalar_name(e.scalar));
        put_count(inout enc, e.vn);
        for vi in 0..e.vn {
            let v = match enum_vars.try_get(wrapping_add(e.v0, vi)) {
                Option::Some(x) => x,
                Option::None => continue,
            };
            put_bytes(inout enc, in p.arena[v.na..v.nb]);
            put_count(inout enc, v.val);
        }
    }
    let mut n_direct: u64 = 0;
    let mut n_cb: u64 = 0;
    for fi in 0..funs.len() {
        let f = match funs.try_get(fi) {
            Option::Some(v) => v,
            Option::None => continue,
        };
        if f.indirect {
            n_cb = wrapping_add(n_cb, 1);
        } else {
            n_direct = wrapping_add(n_direct, 1);
        }
    }
    put_count(inout enc, n_direct);
    for fi in 0..funs.len() {
        let f = match funs.try_get(fi) {
            Option::Some(v) => v,
            Option::None => continue,
        };
        if !f.indirect {
            encode_fun(inout enc, in f, in pars.as_slice(), in p.arena.as_slice());
        }
    }
    if n_cb > 0 {
        put_str(inout enc, in "callbacks");
        put_count(inout enc, n_cb);
        for fi in 0..funs.len() {
            let f = match funs.try_get(fi) {
                Option::Some(v) => v,
                Option::None => continue,
            };
            if f.indirect {
                encode_fun(inout enc, in f, in pars.as_slice(), in p.arena.as_slice());
            }
        }
    }
    if wires.len() > 0 {
        put_str(inout enc, in "wire-structs");
        put_count(inout enc, wires.len());
        for wi in 0..wires.len() {
            let w = match wires.try_get(wi) {
                Option::Some(v) => v,
                Option::None => continue,
            };
            put_bytes(inout enc, in p.arena[w.name_a..w.name_b]);
            put_count(inout enc, w.size);
            put_count(inout enc, w.alignment);
            put_count(inout enc, w.fn_count);
            for fi in 0..w.fn_count {
                let wf = match wire_fields.try_get(wrapping_add(w.f0, fi)) {
                    Option::Some(v) => v,
                    Option::None => continue,
                };
                put_bytes(inout enc, in p.arena[wf.name_a..wf.name_b]);
                if wf.kind == wt_int() {
                    put_str(inout enc, in "integer");
                    put_str(
                        inout enc,
                        in if wf.signed {
                            "i"
                        } else {
                            "u"
                        }
                    );
                    put_u16(inout enc, widen_u16(wf.bits));
                    let es = if wf.endian == endian_native() {
                        "native"
                    } else if wf.endian == endian_le() {
                        "le"
                    } else {
                        "be"
                    };
                    put_str(inout enc, in es);
                } else if wf.kind == wt_bytes() {
                    put_str(inout enc, in "bytes");
                    put_count(inout enc, wf.count);
                } else if wf.kind == wt_pad() {
                    put_str(inout enc, in "zero-pad");
                    put_count(inout enc, wf.count);
                } else {
                    put_str(inout enc, in "struct");
                    put_bytes(inout enc, in p.arena[wf.struct_a..wf.struct_b]);
                }
            }
        }
    }
    let mut n_ext: u64 = 0;
    let mut any_drop = false;
    let mut any_map = false;
    for xi in 0..externs.len() {
        let x = match externs.try_get(xi) {
            Option::Some(v) => v,
            Option::None => continue,
        };
        if x.mapping != 0 {
            any_map = true;
        }
        if x.linearity != 3 {
            n_ext = wrapping_add(n_ext, 1);
            if x.has_drop {
                any_drop = true;
            }
        }
    }
    if n_ext > 0 {
        put_str(inout enc, in "extern-types");
        put_count(inout enc, n_ext);
        for xi in 0..externs.len() {
            let x = match externs.try_get(xi) {
                Option::Some(v) => v,
                Option::None => continue,
            };
            if x.linearity != 3 {
                put_bytes(inout enc, in p.arena[x.na..x.nb]);
                put_str(
                    inout enc,
                    in if x.linearity == 1 {
                        "linear"
                    } else {
                        "affine"
                    }
                );
            }
        }
        if any_drop {
            put_str(inout enc, in "drop-imports");
            for xi in 0..externs.len() {
                let x = match externs.try_get(xi) {
                    Option::Some(v) => v,
                    Option::None => continue,
                };
                if x.linearity != 3 {
                    if x.has_drop {
                        put_bytes(inout enc, in p.arena[x.drop_a..x.drop_b]);
                    } else {
                        put_str(inout enc, in "");
                    }
                }
            }
        }
        if any_map {
            put_str(inout enc, in "mappings");
            for xi in 0..externs.len() {
                let x = match externs.try_get(xi) {
                    Option::Some(v) => v,
                    Option::None => continue,
                };
                if x.mapping != 0 {
                    put_str(inout enc, in scalar_name(x.mapping));
                } else {
                    put_str(inout enc, in "");
                }
            }
        }
    }
    if consts.len() > 0 {
        put_str(inout enc, in "consts");
        put_count(inout enc, consts.len());
        for ci in 0..consts.len() {
            let c = match consts.try_get(ci) {
                Option::Some(v) => v,
                Option::None => continue,
            };
            put_bytes(inout enc, in p.arena[c.na..c.nb]);
            put_str(inout enc, in scalar_name(c.scalar));
            put_decimal_const(inout enc, c.neg, c.mag);
        }
    }
    enc.out
}

fn pack_bytes(in bytes: Slice[u8]) -> ChunkSeq[u64] {
    let n = bytes.len();
    let cap = wrapping_add(1, wrapping_shr_u64(wrapping_add(n, 7), 3));
    let mut words: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](cap);
    words.push(n);
    let mut i: u64 = 0;
    loop {
        if i >= n {
            break;
        }
        let mut w: u64 = 0;
        for k in 0..8 {
            let idx = wrapping_add(i, k);
            if idx < n {
                let b = widen_u64(u8_at(in bytes, idx));
                w = w | wrapping_shl_u64(b, wrapping_mul(wrapping_u32(k), 8));
            }
        }
        words.push(w);
        i = wrapping_add(i, 8);
    }
    words
}

pub fn run_vsys_check(in source: Str) -> ChunkSeq[u64] {
    let raw = handle Fail[VsysError] in {
        let bytes = parse_and_encode(in source.as_bytes());
        let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
        out.push(0);
        out.extend(in bytes.as_slice());
        out
    } with {
        return v => v,
        raise(e, _) => {
            let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
            out.push(1);
            out.push(e.kind);
            out
        }
    };
    pack_bytes(in raw.as_slice())
}
