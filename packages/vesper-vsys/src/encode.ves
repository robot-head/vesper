// Canonical byte encoder for `.vsys` `LibraryDescriptor` (`vesper_ffi::sys::canonicalize`).
use self::lexer::{VsysError, err_limit, fail_vsys};

pub struct Encoder {
    pub out: ChunkSeq[u8],
    pub limit: u64,
}

pub fn new_encoder(limit: u64) -> Encoder {
    Encoder {
        out: ChunkSeq::new[u8](),
        limit: limit,
    }
}

pub fn put_bytes(inout encoder: Encoder, in data: Slice[u8]) eff [Fail[VsysError]] {
    let n = data.len();
    let max_u32: u64 = 4294967295;
    if n > max_u32 {
        return fail_vsys(err_limit(), 0, 0, 200);
    }
    let out_len = encoder.out.len();
    let needed = wrapping_add(4, n);
    if wrapping_add(out_len, needed) > encoder.limit {
        return fail_vsys(err_limit(), 0, 0, 201);
    }
    let len32 = wrapping_u32(n);
    encoder.out.push(wrapping_u8(len32 & 255));
    encoder.out.push(wrapping_u8(wrapping_shr_u32(len32, 8) & 255));
    encoder.out.push(wrapping_u8(wrapping_shr_u32(len32, 16) & 255));
    encoder.out.push(wrapping_u8(wrapping_shr_u32(len32, 24) & 255));
    encoder.out.extend(in data);
}

pub fn put_str(inout encoder: Encoder, in text: Str) eff [Fail[VsysError]] {
    put_bytes(inout encoder, in text.as_bytes());
}

pub fn put_u16(inout encoder: Encoder, value: u16) eff [Fail[VsysError]] {
    let mut buf: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](2);
    buf.push(wrapping_u8(value & 255));
    buf.push(wrapping_u8(wrapping_shr_u16(value, 8) & 255));
    put_bytes(inout encoder, in buf.as_slice());
}

pub fn put_count(inout encoder: Encoder, count: u64) eff [Fail[VsysError]] {
    let mut buf: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](8);
    let mut rest = count;
    for i in 0..8 {
        buf.push(wrapping_u8(rest & 255));
        rest = wrapping_shr_u64(rest, 8);
    }
    put_bytes(inout encoder, in buf.as_slice());
}

pub fn put_u128_u64(inout encoder: Encoder, value: u64) eff [Fail[VsysError]] {
    let mut buf: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](16);
    let mut rest = value;
    for i in 0..8 {
        buf.push(wrapping_u8(rest & 255));
        rest = wrapping_shr_u64(rest, 8);
    }
    for i in 0..8 {
        buf.push(0);
    }
    put_bytes(inout encoder, in buf.as_slice());
}

pub fn put_decimal_const(inout encoder: Encoder, negative: bool, magnitude: u64) eff [
    Fail[VsysError]
] {
    let mut text: ChunkSeq[u8] = ChunkSeq::new[u8]();
    if magnitude == 0 {
        text.push(48);
        return put_bytes(inout encoder, in text.as_slice());
    }
    let mut rest = magnitude;
    let mut reversed: ChunkSeq[u8] = ChunkSeq::new[u8]();
    loop {
        if rest == 0 {
            break;
        }
        let digit = rest % 10;
        reversed.push(wrapping_add(wrapping_u8(digit), 48));
        rest = rest / 10;
    }
    if negative {
        text.push(45);
    }
    let mut pos = reversed.len();
    loop {
        if pos == 0 {
            break;
        }
        pos = wrapping_sub(pos, 1);
        let digit_char = reversed.try_get(pos).unwrap_or(48);
        text.push(digit_char);
    }
    put_bytes(inout encoder, in text.as_slice());
}
