// @vesper/ir-check: `src/ir_check.rs` (state-token evidence and the
// ownership abstract interpretation over Place IR: `validate`, `evidence`,
// `Flow`) over the @vesper/check-data tables (self-hosting SH2 lane 5,
// #1177). The census translation (SH1 lane 15, #1130) promoted to a
// package; it matched Rust on every corpus world and five mutants of each
// (190,875 diagnostics) at 0.57x of its time.
//
// The IR is decoded into flat tables (instructions, an operand pool, a
// pattern pool); a dataflow `State` is a set of sorted rows, and the
// per-block incoming states live in one append-only pool (a `ChunkSeq` of
// structs that own sequences cannot be indexed in place until element
// borrows land, SH2 lane 1).
//
// - `validate_into`: `validate`, the kept (deduplicated) diagnostics.
// - `ir_check_words`: the hybrid build's entry: the diagnostics as words
//   (read back by `decode_diagnostics` in tests/common/check_words.rs).
// - `check_ir_text` / `check_ir_words`: the harness entries
//   (tests/hybrid_ir_check.rs).

use @vesper/check-data::pack_text;
use @vesper/check-data::util::{add, fold, inc, inc32, n32, push_decimal, u32_at, u64_at, u8_at, w};
use @vesper/check-data::names::{Names};
use @vesper/check-data::types::{
    Types, default_type, substitute, vars_new, zero_slots, TyKind, TyMode, TyPass
};
use @vesper/check-data::world::{Bounds, Known, World, bounds_new, constructor, field_step, mode_of};
use @vesper/check-data::diag::{DiagRow, Diags, RelRow, diags_new};
use @vesper/check-data::input::{Ctx, Reader, ctx_new, extend_ctx, read_ctx};

// Constants cannot be imported across modules yet (check-data gap 1); these
// copies equal check-data's.
const NONE32: u32 = 4294967295;
const NO_ADT: u32 = 4294967295;

// Input name index -> symbol (`sym` of check-data's input.ves).
fn sym(in name_map: ChunkSeq[u32], index: u64) -> u32 {
    u32_at(in name_map, index)
}

// src/ir_check.rs: state-token evidence and the ownership abstract
// interpretation over Place IR (`validate`, `evidence`, `Flow`). The IR is
// decoded into flat tables (instructions, an operand pool, a pattern pool);
// a dataflow `State` is a set of sorted rows, and the per-block incoming
// states live in one append-only pool (a `ChunkSeq` of structs that own
// sequences cannot be indexed in place).

// ----- paths and places -------------------------------------------------------

pub copy struct PathNode {
    parent: u32,
    last: u32,
    len: u32,
}

pub struct Paths {
    nodes: ChunkSeq[PathNode],
    hashes: ChunkSeq[u64],
    slots: ChunkSeq[u32],
    mask: u64,
}

pub fn paths_new() -> Paths {
    let mut paths = Paths {
        nodes: ChunkSeq::new[PathNode](),
        hashes: ChunkSeq::new[u64](),
        slots: zero_slots(1024),
        mask: 1023
    };
    paths.nodes.push(PathNode { parent: 0, last: 0, len: 0 });
    paths.hashes.push(0);
    paths
}

impl Paths {
    pub fn node(in self, path: u32) -> PathNode {
        match self.nodes.try_get(w(path)) {
            Option::Some(node) => node,
            Option::None => PathNode { parent: 0, last: 0, len: 0 },
        }
    }

    pub fn len(in self, path: u32) -> u32 {
        self.node(path).len
    }

    fn grow(inout self) {
        let cap = wrapping_mul(add(self.mask, 1), 2);
        let mut slots = zero_slots(cap);
        let mask = wrapping_sub(cap, 1);
        for id in 1..self.hashes.len() {
            let mut pos = u64_at(in self.hashes, id) & mask;
            loop {
                if u32_at(in slots, pos) == 0 {
                    break;
                }
                pos = inc(pos) & mask;
            }
            let ok = slots.try_set(pos, n32(id));
        }
        self.slots = slots;
        self.mask = mask;
    }

    // The path `parent` followed by field `sym`.
    pub fn child(inout self, parent: u32, sym: u32) -> u32 {
        let hash = fold(fold(14695981039346656037, w(parent)), w(sym));
        let mut pos = hash & self.mask;
        loop {
            let slot = u32_at(in self.slots, pos);
            if slot == 0 {
                break;
            }
            let node = self.node(slot);
            if node.parent == parent && node.last == sym {
                return slot;
            }
            pos = inc(pos) & self.mask;
        }
        let id = n32(self.nodes.len());
        let len = inc32(self.len(parent));
        self.nodes.push(PathNode { parent: parent, last: sym, len: len });
        self.hashes.push(hash);
        let ok = self.slots.try_set(pos, id);
        if wrapping_mul(self.nodes.len(), 2) > self.mask {
            self.grow();
        }
        id
    }

    // The prefix of `path` with `len` fields.
    pub fn prefix(in self, path: u32, len: u32) -> u32 {
        let mut cur = path;
        loop {
            let node = self.node(cur);
            if node.len <= len {
                return cur;
            }
            cur = node.parent;
        }
    }

    // `a.starts_with(b)`.
    pub fn starts_with(in self, a: u32, b: u32) -> bool {
        let b_len = self.len(b);
        self.len(a) >= b_len && self.prefix(a, b_len) == b
    }

    pub fn overlaps(in self, a: u32, b: u32) -> bool {
        self.starts_with(a, b) || self.starts_with(b, a)
    }

    // ".f.g" for path f.g.
    pub fn write(in self, in names: Names, path: u32, inout out: ChunkSeq[u8]) {
        if path == 0 {
            return;
        }
        let node = self.node(path);
        self.write(in names, node.parent, inout out);
        out.push(46);
        names.write(node.last, inout out);
    }

    // `World::field(ty, path)`; NONE32 for None.
    pub fn field_type(
        in self,
        inout types: Types,
        inout names: Names,
        in world: World,
        ty: u32,
        path: u32
    ) -> u32 {
        if path == 0 {
            return ty;
        }
        let node = self.node(path);
        let base = self.field_type(inout types, inout names, in world, ty, node.parent);
        if base == NONE32 {
            return NONE32;
        }
        let is_index_step = names.size(node.last) > 0 && names.byte(node.last, 0) == 91;
        field_step(inout types, inout names, in world, base, node.last, is_index_step)
    }
}

// A place is root symbol * 2^32 + path id.
fn place(root: u32, path: u32) -> u64 {
    wrapping_add(wrapping_mul(w(root), 4294967296), w(path))
}

fn place_root(place: u64) -> u32 {
    n32(place >> 32)
}

fn place_path(place: u64) -> u32 {
    n32(place & 4294967295)
}

// ----- the decoded program ----------------------------------------------------

const OP_NONE: u8 = 0;
const OP_READ: u8 = 1;
const OP_BIND: u8 = 2;
const OP_WRITE: u8 = 3;
const OP_CONSUME1: u8 = 4;
const OP_BINARY: u8 = 5;
const OP_CONSUME_N: u8 = 6;
const OP_VECTOR: u8 = 7;
const OP_SEQ: u8 = 8;
const OP_PROJECT: u8 = 9;
const OP_INDEX: u8 = 10;
const OP_CALL: u8 = 11;
const OP_INDIRECT: u8 = 12;
const OP_TRY: u8 = 13;
const OP_MOVES: u8 = 14;
const OP_HANDLE: u8 = 15;

// Instruction flags.
const F_ABORT: u64 = 1;
const F_EFFECTFUL: u64 = 2;
const F_ACTION: u64 = 4;
const F_TOKEN: u64 = 8;
const F_NEVER: u64 = 16;

pub copy struct Inst {
    dest: u32,
    ty: u32,
    s0: u64,
    s1: u64,
    tok_in: u32,
    tok_out: u32,
    flags: u64,
    op: u8,
    // its operands: operands[operand_start..]
    operand_start: u32,
}

pub copy struct Blk {
    entry: u32,
    // incoming tokens: pairs (block, token) in operands[in_start..+2*in_count]
    in_start: u32,
    in_count: u32,
    out_tok: u32,
    // block params: operands[param_start..+param_count]
    param_start: u32,
    param_count: u32,
    // instructions: insts[inst_start..+inst_count]
    inst_start: u32,
    inst_count: u32,
    // terminator kind, and its operands at operands[term_start..]
    term: u8,
    term_start: u32,
}

pub copy struct ParamRow {
    name: u32,
    pass: u8,
    ty: u32,
    s0: u64,
    s1: u64,
}

pub copy struct FnRow {
    param_start: u32,
    param_count: u32,
    // bounds: operands[bound_start..+2*bound_count] pairs (name, mode)
    bound_start: u32,
    bound_count: u32,
    // external captures: operands[capture_start..+capture_count]
    capture_start: u32,
    capture_count: u32,
    // block-param value types: operands[value_ty_start..+2*value_ty_count] pairs (id, ty)
    value_ty_start: u32,
    value_ty_count: u32,
    block_start: u32,
    block_count: u32,
}

pub struct Program {
    fns: ChunkSeq[FnRow],
    params: ChunkSeq[ParamRow],
    blocks: ChunkSeq[Blk],
    insts: ChunkSeq[Inst],
    operands: ChunkSeq[u64],
    patterns: ChunkSeq[u64],
    paths: Paths,
    // symbol -> name order rank (BTreeMap<String, _> order)
    ranks: ChunkSeq[u32],
    // non-linear effect names
    nonlinear: ChunkSeq[u32],
}

impl Program {
    pub fn op(in self, i: u64) -> u64 {
        u64_at(in self.operands, i)
    }

    pub fn pat(in self, i: u64) -> u64 {
        u64_at(in self.patterns, i)
    }

    pub fn inst(in self, i: u64) -> Inst {
        match self.insts.try_get(i) {
            Option::Some(inst) => inst,
            Option::None => Inst {
                dest: 0,
                ty: 0,
                s0: 0,
                s1: 0,
                tok_in: 0,
                tok_out: 0,
                flags: 0,
                op: 0,
                operand_start: 0
            },
        }
    }

    pub fn block(in self, i: u64) -> Blk {
        match self.blocks.try_get(i) {
            Option::Some(block) => block,
            Option::None => Blk {
                entry: 0,
                in_start: 0,
                in_count: 0,
                out_tok: 0,
                param_start: 0,
                param_count: 0,
                inst_start: 0,
                inst_count: 0,
                term: 4,
                term_start: 0
            },
        }
    }

    pub fn rank_of(in self, symbol: u32) -> u32 {
        u32_at(in self.ranks, w(symbol))
    }

    pub fn is_nonlinear(in self, symbol: u32) -> bool {
        for i in 0..self.nonlinear.len() {
            if u32_at(in self.nonlinear, i) == symbol {
                return true;
            }
        }
        false
    }
}

// ----- decoding ---------------------------------------------------------------

fn read_path(
    inout reader: Reader,
    in bytes: Slice[u8],
    in name_map: ChunkSeq[u32],
    inout paths: Paths,
    base: u32
) -> u32 {
    let n = reader.word(in bytes);
    let mut path = base;
    for i in 0..n {
        path = paths.child(path, sym(in name_map, reader.word(in bytes)));
    }
    path
}

// A pattern: kind, start, stop, then Bind: name; Tuple: n, children;
// Constructor: qualifier + 1 (0 none), short, n, (field, child)*;
// multi-segment path constructors are kind 3 (never resolve). Children are
// pool positions.
fn read_pattern(
    inout reader: Reader,
    in bytes: Slice[u8],
    in name_map: ChunkSeq[u32],
    inout patterns: ChunkSeq[u64]
) -> u64 {
    let kind = reader.word(in bytes);
    let s0 = reader.word(in bytes);
    let s1 = reader.word(in bytes);
    if kind == 1 {
        let start = patterns.len();
        patterns.push(kind);
        patterns.push(s0);
        patterns.push(s1);
        patterns.push(w(sym(in name_map, reader.word(in bytes))));
        return start;
    }
    if kind == 2 {
        let n = reader.word(in bytes);
        let mut children: ChunkSeq[u64] = ChunkSeq::new[u64]();
        for i in 0..n {
            let child = read_pattern(inout reader, in bytes, in name_map, inout patterns);
            children.push(child);
        }
        let start = patterns.len();
        patterns.push(kind);
        patterns.push(s0);
        patterns.push(s1);
        patterns.push(n);
        for i in 0..n {
            patterns.push(u64_at(in children, i));
        }
        return start;
    }
    // A constructor (4), or one whose multi-component path the checker
    // cannot resolve (3): binding skips the latter, but the origin index
    // still walks its fields.
    if kind == 4 || kind == 3 {
        let qual_word = reader.word(in bytes);
        let qualifier = if qual_word == 0 {
            NONE32
        } else {
            sym(in name_map, wrapping_sub(qual_word, 1))
        };
        let short = sym(in name_map, reader.word(in bytes));
        let n = reader.word(in bytes);
        let mut fields: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let mut children: ChunkSeq[u64] = ChunkSeq::new[u64]();
        for i in 0..n {
            fields.push(w(sym(in name_map, reader.word(in bytes))));
            let child = read_pattern(inout reader, in bytes, in name_map, inout patterns);
            children.push(child);
        }
        let start = patterns.len();
        patterns.push(kind);
        patterns.push(s0);
        patterns.push(s1);
        patterns.push(w(qualifier));
        patterns.push(w(short));
        patterns.push(n);
        for i in 0..n {
            patterns.push(u64_at(in fields, i));
            patterns.push(u64_at(in children, i));
        }
        return start;
    }
    // Wild (0), literal and the rest (5).
    let start = patterns.len();
    patterns.push(kind);
    patterns.push(s0);
    patterns.push(s1);
    start
}

fn read_args(inout reader: Reader, in bytes: Slice[u8], inout operands: ChunkSeq[u64]) {
    let n = reader.word(in bytes);
    operands.push(n);
    for i in 0..n {
        operands.push(reader.word(in bytes));
        operands.push(reader.word(in bytes));
    }
}

fn read_op(
    inout reader: Reader,
    in bytes: Slice[u8],
    in name_map: ChunkSeq[u32],
    inout program: Program,
    op: u8
) {
    if op == OP_READ {
        let root = sym(in name_map, reader.word(in bytes));
        let pass = reader.word(in bytes);
        let is_fn = reader.word(in bytes);
        let base = read_path(inout reader, in bytes, in name_map, inout program.paths, 0);
        let path_count = reader.word(in bytes);
        program.operands.push(w(root));
        program.operands.push(pass);
        program.operands.push(is_fn);
        if path_count == 0 {
            program.operands.push(1);
            program.operands.push(w(base));
        } else {
            program.operands.push(path_count);
            for i in 0..path_count {
                let path = read_path(
                    inout reader,
                    in bytes,
                    in name_map,
                    inout program.paths,
                    base
                );
                program.operands.push(w(path));
            }
        }
    } else if op == OP_BIND {
        program.operands.push(reader.word(in bytes));
        let pat_pos = read_pattern(inout reader, in bytes, in name_map, inout program.patterns);
        program.operands.push(pat_pos);
    } else if op == OP_WRITE {
        program.operands.push(reader.word(in bytes));
        program.operands.push(w(sym(in name_map, reader.word(in bytes))));
        let path = read_path(inout reader, in bytes, in name_map, inout program.paths, 0);
        program.operands.push(w(path));
        program.operands.push(reader.word(in bytes));
    } else if op == OP_CONSUME1 || op == OP_PROJECT || op == OP_TRY {
        program.operands.push(reader.word(in bytes));
    } else if op == OP_BINARY {
        program.operands.push(reader.word(in bytes));
        program.operands.push(reader.word(in bytes));
        program.operands.push(reader.word(in bytes));
    } else if op == OP_INDEX {
        program.operands.push(reader.word(in bytes));
        program.operands.push(reader.word(in bytes));
    } else if op == OP_CONSUME_N || op == OP_VECTOR {
        let n = reader.word(in bytes);
        program.operands.push(n);
        for i in 0..n {
            program.operands.push(reader.word(in bytes));
        }
    } else if op == OP_SEQ || op == OP_CALL {
        read_args(inout reader, in bytes, inout program.operands);
    } else if op == OP_INDIRECT {
        program.operands.push(reader.word(in bytes));
        read_args(inout reader, in bytes, inout program.operands);
    } else if op == OP_MOVES || op == OP_HANDLE {
        let n = reader.word(in bytes);
        program.operands.push(n);
        for i in 0..n {
            let root = sym(in name_map, reader.word(in bytes));
            let path = read_path(inout reader, in bytes, in name_map, inout program.paths, 0);
            program.operands.push(place(root, path));
        }
        program.operands.push(reader.word(in bytes));
        program.operands.push(reader.word(in bytes));
    }
}

pub fn read_program(
    inout reader: Reader,
    in bytes: Slice[u8],
    in names: Names,
    in name_map: ChunkSeq[u32],
    in type_map: ChunkSeq[u32]
) -> Program {
    let mut program = Program {
        fns: ChunkSeq::new[FnRow](),
        params: ChunkSeq::new[ParamRow](),
        blocks: ChunkSeq::new[Blk](),
        insts: ChunkSeq::new[Inst](),
        operands: ChunkSeq::new[u64](),
        patterns: ChunkSeq::new[u64](),
        paths: paths_new(),
        ranks: ChunkSeq::new[u32](),
        nonlinear: ChunkSeq::new[u32](),
    };
    // Name ranks, by input name index.
    program.ranks.resize(names.len(), 0);
    for i in 0..name_map.len() {
        let ok = program.ranks.try_set(w(u32_at(in name_map, i)), n32(reader.word(in bytes)));
    }
    let nonlinear_count = reader.word(in bytes);
    for i in 0..nonlinear_count {
        program.nonlinear.push(sym(in name_map, reader.word(in bytes)));
    }
    let fn_count = reader.word(in bytes);
    for fi in 0..fn_count {
        let param_start = n32(program.params.len());
        let param_count = reader.word(in bytes);
        for i in 0..param_count {
            let name = sym(in name_map, reader.word(in bytes));
            let pass = wrapping_u8(reader.word(in bytes));
            let ty = u32_at(in type_map, reader.word(in bytes));
            let s0 = reader.word(in bytes);
            let s1 = reader.word(in bytes);
            program.params.push(ParamRow { name: name, pass: pass, ty: ty, s0: s0, s1: s1 });
        }
        let bound_start = n32(program.operands.len());
        let bound_count = reader.word(in bytes);
        for i in 0..bound_count {
            program.operands.push(w(sym(in name_map, reader.word(in bytes))));
            program.operands.push(reader.word(in bytes));
        }
        let capture_start = n32(program.operands.len());
        let capture_count = reader.word(in bytes);
        for i in 0..capture_count {
            program.operands.push(w(sym(in name_map, reader.word(in bytes))));
        }
        let value_ty_start = n32(program.operands.len());
        let value_ty_count = reader.word(in bytes);
        for i in 0..value_ty_count {
            program.operands.push(reader.word(in bytes));
            program.operands.push(w(u32_at(in type_map, reader.word(in bytes))));
        }
        let block_start = n32(program.blocks.len());
        let block_count = reader.word(in bytes);
        for bi in 0..block_count {
            let entry = n32(reader.word(in bytes));
            let in_start = n32(program.operands.len());
            let in_count = reader.word(in bytes);
            for i in 0..in_count {
                program.operands.push(reader.word(in bytes));
                program.operands.push(reader.word(in bytes));
            }
            let out_tok = n32(reader.word(in bytes));
            let block_param_start = n32(program.operands.len());
            let block_param_count = reader.word(in bytes);
            for i in 0..block_param_count {
                program.operands.push(reader.word(in bytes));
            }
            let inst_start = n32(program.insts.len());
            let inst_count = reader.word(in bytes);
            for ii in 0..inst_count {
                let dest = n32(reader.word(in bytes));
                let ty = u32_at(in type_map, reader.word(in bytes));
                let s0 = reader.word(in bytes);
                let s1 = reader.word(in bytes);
                let flags = reader.word(in bytes);
                let tok_in = n32(reader.word(in bytes));
                let tok_out = n32(reader.word(in bytes));
                let op = wrapping_u8(reader.word(in bytes));
                let operand_start = n32(program.operands.len());
                read_op(inout reader, in bytes, in name_map, inout program, op);
                program.insts.push(Inst {
                    dest: dest,
                    ty: ty,
                    s0: s0,
                    s1: s1,
                    tok_in: tok_in,
                    tok_out: tok_out,
                    flags: flags,
                    op: op,
                    operand_start: operand_start
                });
            }
            let term = wrapping_u8(reader.word(in bytes));
            let term_start = n32(program.operands.len());
            if term == 0 {
                program.operands.push(reader.word(in bytes));
            } else if term == 1 || term == 3 {
                let n = if term == 1 {
                    program.operands.push(reader.word(in bytes));
                    reader.word(in bytes)
                } else {
                    reader.word(in bytes)
                };
                program.operands.push(n);
                for i in 0..n {
                    program.operands.push(reader.word(in bytes));
                }
                // A match's scrutinee value follows its arms.
                if term == 3 {
                    program.operands.push(reader.word(in bytes));
                }
            } else if term == 2 {
                program.operands.push(reader.word(in bytes));
                program.operands.push(reader.word(in bytes));
            }
            program.blocks.push(Blk {
                entry: entry,
                in_start: in_start,
                in_count: n32(in_count),
                out_tok: out_tok,
                param_start: block_param_start,
                param_count: n32(block_param_count),
                inst_start: inst_start,
                inst_count: n32(inst_count),
                term: term,
                term_start: term_start
            });
        }
        program.fns.push(FnRow {
            param_start: param_start,
            param_count: n32(param_count),
            bound_start: bound_start,
            bound_count: n32(bound_count),
            capture_start: capture_start,
            capture_count: n32(capture_count),
            value_ty_start: value_ty_start,
            value_ty_count: n32(value_ty_count),
            block_start: block_start,
            block_count: n32(block_count)
        });
    }
    program
}

// Successor blocks of block `block` (absolute), as relative indices.
fn targets(in program: Program, block: Blk, inout out: ChunkSeq[u32]) {
    out.clear();
    let term_start = w(block.term_start);
    if block.term == 1 {
        out.push(n32(program.op(term_start)));
    } else if block.term == 2 {
        out.push(n32(program.op(term_start)));
        out.push(n32(program.op(inc(term_start))));
    } else if block.term == 3 {
        let n = program.op(term_start);
        for i in 0..n {
            out.push(n32(program.op(add(inc(term_start), i))));
        }
    }
}

// ----- evidence ---------------------------------------------------------------

fn e0411(inout diags: Diags, in msg: Str, s0: u64, s1: u64) {
    let code_start = diags.open("E0411");
    let msg_start = diags.text.len();
    diags.text.extend(in msg.as_bytes());
    diags.close(code_start, msg_start, "", s0, s1);
}

fn sorted_insert(inout sorted: ChunkSeq[u64], value: u64) {
    sorted.push(value);
    let mut i = wrapping_sub(sorted.len(), 1);
    loop {
        if i == 0 {
            break;
        }
        let prev = u64_at(in sorted, wrapping_sub(i, 1));
        if prev <= value {
            break;
        }
        let ok = sorted.try_set(i, prev);
        i = wrapping_sub(i, 1);
    }
    let ok = sorted.try_set(i, value);
}

// Sorted set of u32: insert, false when present.
// One unit of origin-indexing work (`charge` in Origins::try_build); false
// once the budget is spent.
fn charge(inout work: u64) -> bool {
    if work == 0 {
        return false;
    }
    work = wrapping_sub(work, 1);
    true
}

// A slot name against the origin text budget: false for a name over
// MAX_CAUSE_NAME bytes or once the budget cannot hold it.
fn charge_name(in names: Names, name: u32, inout text: u64) -> bool {
    let n = names.size(name);
    if n > MAX_CAUSE_NAME || n > text {
        return false;
    }
    text = wrapping_sub(text, n);
    true
}

// Whether sorted `sorted` holds `value`.
fn sorted_contains(in sorted: ChunkSeq[u32], value: u32) -> bool {
    let mut lo: u64 = 0;
    let mut hi = sorted.len();
    loop {
        if lo >= hi {
            return false;
        }
        let mid = wrapping_add(lo, hi) / 2;
        let mid_value = u32_at(in sorted, mid);
        if mid_value == value {
            return true;
        }
        if mid_value < value {
            lo = inc(mid);
        } else {
            hi = mid;
        }
    }
}

fn set_insert(inout set: ChunkSeq[u32], value: u32) -> bool {
    let mut lo: u64 = 0;
    let mut hi = set.len();
    loop {
        if lo >= hi {
            break;
        }
        let mid = wrapping_add(lo, hi) / 2;
        let mid_value = u32_at(in set, mid);
        if mid_value == value {
            return false;
        }
        if mid_value < value {
            lo = inc(mid);
        } else {
            hi = mid;
        }
    }
    set.push(value);
    let mut i = wrapping_sub(set.len(), 1);
    loop {
        if i <= lo {
            break;
        }
        let ok = set.try_set(i, u32_at(in set, wrapping_sub(i, 1)));
        i = wrapping_sub(i, 1);
    }
    let ok = set.try_set(lo, value);
    true
}

pub fn evidence(in program: Program, inout diags: Diags) {
    let mut successors: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for fi in 0..program.fns.len() {
        let func = match program.fns.try_get(fi) {
            Option::Some(func) => func,
            Option::None => FnRow {
                param_start: 0,
                param_count: 0,
                bound_start: 0,
                bound_count: 0,
                capture_start: 0,
                capture_count: 0,
                value_ty_start: 0,
                value_ty_count: 0,
                block_start: 0,
                block_count: 0
            },
        };
        let mut defs: ChunkSeq[u32] = ChunkSeq::new[u32]();
        // incoming edges per block: (source << 32 | token), sorted later
        let mut edges: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let mut edge_block: ChunkSeq[u32] = ChunkSeq::new[u32]();
        for bi in 0..w(func.block_count) {
            let block = program.block(add(w(func.block_start), bi));
            if !set_insert(inout defs, block.entry) {
                e0411(inout diags, "duplicate state-token parameter", 0, 0);
            }
        }
        for bi in 0..w(func.block_count) {
            let block = program.block(add(w(func.block_start), bi));
            let mut current = block.entry;
            for ii in 0..w(block.inst_count) {
                let inst = program.inst(add(w(block.inst_start), ii));
                let is_action = (inst.flags & F_ACTION) != 0;
                let is_read = inst.op == OP_READ;
                let has_token = (inst.flags & F_TOKEN) != 0;
                if is_action || is_read {
                    if has_token {
                        if inst.tok_in != current
                            || (is_action && inst.tok_out == inst.tok_in)
                            || (is_read && inst.tok_in != inst.tok_out) {
                            e0411(
                                inout diags,
                                "instruction uses stale or invalid state-token evidence",
                                inst.s0,
                                inst.s1
                            );
                        }
                        if is_action && !set_insert(inout defs, inst.tok_out) {
                            e0411(inout diags, "state token is defined twice", inst.s0, inst.s1);
                        }
                        current = inst.tok_out;
                    } else {
                        e0411(inout diags, "stateful instruction lacks evidence", inst.s0, inst.s1);
                    }
                } else if has_token {
                    e0411(
                        inout diags,
                        "pure instruction unexpectedly defines state evidence",
                        inst.s0,
                        inst.s1
                    );
                }
            }
            if current != block.out_tok {
                e0411(inout diags, "block returns stale state evidence", 0, 0);
            }
            targets(in program, block, inout successors);
            for k in 0..successors.len() {
                let target = u32_at(in successors, k);
                if w(target) < w(func.block_count) {
                    edge_block.push(target);
                    edges.push(wrapping_add(wrapping_mul(bi, 4294967296), w(current)));
                } else {
                    e0411(inout diags, "control-flow edge targets a missing block", 0, 0);
                }
            }
        }
        let mut actual: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let mut expect: ChunkSeq[u64] = ChunkSeq::new[u64]();
        for bi in 0..w(func.block_count) {
            let block = program.block(add(w(func.block_start), bi));
            actual.clear();
            expect.clear();
            for k in 0..w(block.in_count) {
                let pair_at = add(w(block.in_start), wrapping_mul(k, 2));
                sorted_insert(
                    inout actual,
                    wrapping_add(
                        wrapping_mul(program.op(pair_at), 4294967296),
                        program.op(inc(pair_at))
                    )
                );
            }
            for k in 0..edges.len() {
                if w(u32_at(in edge_block, k)) == bi {
                    sorted_insert(inout expect, u64_at(in edges, k));
                }
            }
            let mut same = actual.len() == expect.len();
            if same {
                for k in 0..actual.len() {
                    if u64_at(in actual, k) != u64_at(in expect, k) {
                        same = false;
                    }
                }
            }
            if !same {
                e0411(inout diags, "state-token phi does not match predecessor evidence", 0, 0);
            }
        }
    }
}
// src/ir_check.rs, part 2: the ownership dataflow (`Flow`).

pub copy struct SlotS {
    rank: u32,
    name: u32,
    ty: u32,
    pass: u8,
}

pub copy struct ValS {
    id: u32,
    ty: u32,
    owned: bool,
    consumed: bool,
    // loan pass, or 255 for no loan; places loans[loan_start..+loan_count]
    loan_pass: u8,
    loan_start: u32,
    loan_count: u32,
}

// `State`: slots sorted by name rank, moved paths as sorted
// (rank * 2^32 + path) keys, values sorted by id, loan places in `loans`.
pub struct State {
    slots: ChunkSeq[SlotS],
    moved: ChunkSeq[u64],
    values: ChunkSeq[ValS],
    loans: ChunkSeq[u64],
}

pub fn state_new() -> State {
    State {
        slots: ChunkSeq::new[SlotS](),
        moved: ChunkSeq::new[u64](),
        values: ChunkSeq::new[ValS](),
        loans: ChunkSeq::new[u64]()
    }
}

const NOSLOT: SlotS = SlotS { rank: 0, name: 0, ty: 0, pass: 0 };
const NOVAL: ValS = ValS {
    id: 0,
    ty: 0,
    owned: false,
    consumed: false,
    loan_pass: 255,
    loan_start: 0,
    loan_count: 0
};

fn key(rank: u32, path: u32) -> u64 {
    wrapping_add(wrapping_mul(w(rank), 4294967296), w(path))
}

impl State {
    pub fn clear(inout self) {
        self.slots.clear();
        self.moved.clear();
        self.values.clear();
        self.loans.clear();
    }

    pub fn slot_at(in self, i: u64) -> SlotS {
        self.slots.try_get(i).unwrap_or(NOSLOT)
    }

    pub fn val_at(in self, i: u64) -> ValS {
        self.values.try_get(i).unwrap_or(NOVAL)
    }

    // Index of the slot with `rank`, or the insertion point with bit 63.
    pub fn find_slot(in self, rank: u32) -> u64 {
        let mut lo: u64 = 0;
        let mut hi = self.slots.len();
        loop {
            if lo >= hi {
                break;
            }
            let mid = wrapping_add(lo, hi) / 2;
            let mid_rank = self.slot_at(mid).rank;
            if mid_rank == rank {
                return mid;
            }
            if mid_rank < rank {
                lo = inc(mid);
            } else {
                hi = mid;
            }
        }
        lo | 9223372036854775808
    }

    pub fn find_val(in self, id: u32) -> u64 {
        let mut lo: u64 = 0;
        let mut hi = self.values.len();
        loop {
            if lo >= hi {
                break;
            }
            let mid = wrapping_add(lo, hi) / 2;
            let mid_id = self.val_at(mid).id;
            if mid_id == id {
                return mid;
            }
            if mid_id < id {
                lo = inc(mid);
            } else {
                hi = mid;
            }
        }
        lo | 9223372036854775808
    }

    // `slots.insert(n, slot)` with an empty moved set.
    pub fn put_slot(inout self, slot: SlotS) {
        let found = self.find_slot(slot.rank);
        if found < 9223372036854775808 {
            let ok = self.slots.try_set(found, slot);
        } else {
            let pos = found & 9223372036854775807;
            self.slots.push(slot);
            let mut i = wrapping_sub(self.slots.len(), 1);
            loop {
                if i <= pos {
                    break;
                }
                let ok = self.slots.try_set(i, self.slot_at(wrapping_sub(i, 1)));
                i = wrapping_sub(i, 1);
            }
            let ok = self.slots.try_set(pos, slot);
        }
        self.moved_clear(slot.rank);
    }

    // `values.insert(id, v)`.
    pub fn put_val(inout self, val: ValS) {
        let found = self.find_val(val.id);
        if found < 9223372036854775808 {
            let ok = self.values.try_set(found, val);
        } else {
            let pos = found & 9223372036854775807;
            self.values.push(val);
            let mut i = wrapping_sub(self.values.len(), 1);
            loop {
                if i <= pos {
                    break;
                }
                let ok = self.values.try_set(i, self.val_at(wrapping_sub(i, 1)));
                i = wrapping_sub(i, 1);
            }
            let ok = self.values.try_set(pos, val);
        }
    }

    pub fn set_val_at(inout self, i: u64, val: ValS) {
        let ok = self.values.try_set(i, val);
    }

    // Moved keys of `rank`: [lo, hi).
    fn moved_range(in self, rank: u32) -> (u64, u64) {
        let first_key = key(rank, 0);
        let mut lo: u64 = 0;
        let mut hi = self.moved.len();
        loop {
            if lo >= hi {
                break;
            }
            let mid = wrapping_add(lo, hi) / 2;
            if u64_at(in self.moved, mid) < first_key {
                lo = inc(mid);
            } else {
                hi = mid;
            }
        }
        let mut end = lo;
        loop {
            if end >= self.moved.len() || place_root(u64_at(in self.moved, end)) != rank {
                break;
            }
            end = inc(end);
        }
        (lo, end)
    }

    pub fn moved_has(in self, rank: u32, path: u32) -> bool {
        let (lo, hi) = self.moved_range(rank);
        for i in lo..hi {
            if u64_at(in self.moved, i) == key(rank, path) {
                return true;
            }
        }
        false
    }

    pub fn moved_insert(inout self, rank: u32, path: u32) {
        if self.moved_has(rank, path) {
            return;
        }
        sorted_insert(inout self.moved, key(rank, path));
    }

    fn moved_clear(inout self, rank: u32) {
        let (lo, hi) = self.moved_range(rank);
        if lo == hi {
            return;
        }
        let n = wrapping_sub(hi, lo);
        for i in hi..self.moved.len() {
            let ok = self.moved.try_set(wrapping_sub(i, n), u64_at(in self.moved, i));
        }
        self.moved.truncate(wrapping_sub(self.moved.len(), n));
    }

    // `moved.retain(|q| !q.starts_with(path))`.
    pub fn moved_retain_not_under(inout self, in paths: Paths, rank: u32, path: u32) {
        let mut kept: u64 = 0;
        for i in 0..self.moved.len() {
            let moved_key = u64_at(in self.moved, i);
            let drop = place_root(moved_key) == rank
                && paths.starts_with(place_path(moved_key), path);
            if !drop {
                let ok = self.moved.try_set(kept, moved_key);
                kept = inc(kept);
            }
        }
        self.moved.truncate(kept);
    }

    // Some moved q of `rank` with q.starts_with(path) || path.starts_with(q).
    pub fn moved_overlaps(in self, in paths: Paths, rank: u32, path: u32) -> bool {
        let (lo, hi) = self.moved_range(rank);
        for i in lo..hi {
            if paths.overlaps(place_path(u64_at(in self.moved, i)), path) {
                return true;
            }
        }
        false
    }

    pub fn loan(in self, i: u64) -> u64 {
        u64_at(in self.loans, i)
    }

    pub fn copy_from(inout self, in other: State) {
        self.clear();
        self.slots.extend(in other.slots.as_slice());
        self.moved.extend(in other.moved.as_slice());
        self.values.extend(in other.values.as_slice());
        self.loans.extend(in other.loans.as_slice());
    }

    // `State == State` (loans by content).
    pub fn same(in self, in other: State) -> bool {
        if self.slots.len() != other.slots.len()
            || self.moved.len() != other.moved.len()
            || self.values.len() != other.values.len() {
            return false;
        }
        for i in 0..self.slots.len() {
            let slot = self.slot_at(i);
            let other_slot = other.slot_at(i);
            if slot.rank != other_slot.rank
                || slot.ty != other_slot.ty
                || slot.pass != other_slot.pass {
                return false;
            }
        }
        for i in 0..self.moved.len() {
            if u64_at(in self.moved, i) != u64_at(in other.moved, i) {
                return false;
            }
        }
        for i in 0..self.values.len() {
            let val = self.val_at(i);
            let other_val = other.val_at(i);
            if val.id != other_val.id
                || val.ty != other_val.ty
                || val.owned != other_val.owned
                || val.consumed != other_val.consumed
                || val.loan_pass != other_val.loan_pass {
                return false;
            }
            if val.loan_pass != 255 {
                if val.loan_count != other_val.loan_count {
                    return false;
                }
                for j in 0..w(val.loan_count) {
                    if self.loan(add(w(val.loan_start), j))
                        != other.loan(add(w(other_val.loan_start), j)) {
                        return false;
                    }
                }
            }
        }
        true
    }
}

// Incoming states of a function's blocks, in one append-only pool.
pub copy struct Stored {
    slot_start: u64,
    slot_count: u64,
    moved_start: u64,
    moved_count: u64,
    value_start: u64,
    value_count: u64,
    loan_start: u64,
    loan_count: u64,
}

pub struct Pool {
    slots: ChunkSeq[SlotS],
    moved: ChunkSeq[u64],
    values: ChunkSeq[ValS],
    loans: ChunkSeq[u64],
    // per block: 0 = no state yet, else index + 1 into `stored`
    stored_index: ChunkSeq[u32],
    stored: ChunkSeq[Stored],
}

pub fn pool_new() -> Pool {
    Pool {
        slots: ChunkSeq::new[SlotS](),
        moved: ChunkSeq::new[u64](),
        values: ChunkSeq::new[ValS](),
        loans: ChunkSeq::new[u64](),
        stored_index: ChunkSeq::new[u32](),
        stored: ChunkSeq::new[Stored]()
    }
}

impl Pool {
    pub fn reset(inout self, blocks: u64) {
        self.slots.clear();
        self.moved.clear();
        self.values.clear();
        self.loans.clear();
        self.stored.clear();
        self.stored_index.clear();
        self.stored_index.resize(blocks, 0);
    }

    pub fn has(in self, block: u64) -> bool {
        u32_at(in self.stored_index, block) != 0
    }

    pub fn store(inout self, block: u64, in state: State) {
        let record = Stored {
            slot_start: self.slots.len(),
            slot_count: state.slots.len(),
            moved_start: self.moved.len(),
            moved_count: state.moved.len(),
            value_start: self.values.len(),
            value_count: state.values.len(),
            loan_start: self.loans.len(),
            loan_count: state.loans.len(),
        };
        self.slots.extend(in state.slots.as_slice());
        self.moved.extend(in state.moved.as_slice());
        self.values.extend(in state.values.as_slice());
        self.loans.extend(in state.loans.as_slice());
        self.stored.push(record);
        let ok = self.stored_index.try_set(block, n32(self.stored.len()));
    }

    pub fn load(in self, block: u64, inout state: State) {
        state.clear();
        let stored_index = u32_at(in self.stored_index, block);
        if stored_index == 0 {
            return;
        }
        let record = match self.stored.try_get(w(wrapping_sub(stored_index, 1))) {
            Option::Some(row) => row,
            Option::None => Stored {
                slot_start: 0,
                slot_count: 0,
                moved_start: 0,
                moved_count: 0,
                value_start: 0,
                value_count: 0,
                loan_start: 0,
                loan_count: 0
            },
        };
        state
            .slots
            .extend(in self.slots[record.slot_start..add(record.slot_start, record.slot_count)]);
        state.moved.extend(
            in self.moved[record.moved_start..add(record.moved_start, record.moved_count)]
        );
        state.values.extend(
            in self.values[record.value_start..add(record.value_start, record.value_count)]
        );
        state
            .loans
            .extend(in self.loans[record.loan_start..add(record.loan_start, record.loan_count)]);
    }
}

// ----- origins (diagnostic evidence) -----------------------------------------

const MAX_CAUSE_WORK: u64 = 65536;
const MAX_CAUSE_TEXT: u64 = 1048576;
const MAX_CAUSE_NAME: u64 = 1024;

// Per value id / name rank: 0 absent, 1 unique span, 2 ambiguous (None).
pub struct Origins {
    value_state: ChunkSeq[u8],
    value_s0: ChunkSeq[u64],
    value_s1: ChunkSeq[u64],
    slot_state: ChunkSeq[u8],
    slot_s0: ChunkSeq[u64],
    slot_s1: ChunkSeq[u64],
    slot_is_param: ChunkSeq[u8],
    touched_values: ChunkSeq[u32],
    touched_slots: ChunkSeq[u32],
}

pub fn origins_new() -> Origins {
    Origins {
        value_state: ChunkSeq::new[u8](),
        value_s0: ChunkSeq::new[u64](),
        value_s1: ChunkSeq::new[u64](),
        slot_state: ChunkSeq::new[u8](),
        slot_s0: ChunkSeq::new[u64](),
        slot_s1: ChunkSeq::new[u64](),
        slot_is_param: ChunkSeq::new[u8](),
        touched_values: ChunkSeq::new[u32](),
        touched_slots: ChunkSeq::new[u32]()
    }
}

impl Origins {
    fn clear(inout self) {
        for i in 0..self.touched_values.len() {
            let ok = self.value_state.try_set(w(u32_at(in self.touched_values, i)), 0);
        }
        for i in 0..self.touched_slots.len() {
            let ok = self.slot_state.try_set(w(u32_at(in self.touched_slots, i)), 0);
        }
        self.touched_values.clear();
        self.touched_slots.clear();
    }

    fn ensure_v(inout self, id: u32) {
        if w(id) >= self.value_state.len() {
            let n = inc(w(id));
            self.value_state.resize(n, 0);
            self.value_s0.resize(n, 0);
            self.value_s1.resize(n, 0);
        }
    }

    fn ensure_s(inout self, rank: u32) {
        if w(rank) >= self.slot_state.len() {
            let n = inc(w(rank));
            self.slot_state.resize(n, 0);
            self.slot_s0.resize(n, 0);
            self.slot_s1.resize(n, 0);
            self.slot_is_param.resize(n, 0);
        }
    }

    fn value(inout self, id: u32, has_span: bool, s0: u64, s1: u64) {
        self.ensure_v(id);
        let state = u8_at(in self.value_state, w(id));
        if state == 0 {
            self.touched_values.push(id);
            if has_span && s0 < s1 {
                let ok = self.value_state.try_set(w(id), 1);
                let ok2 = self.value_s0.try_set(w(id), s0);
                let ok3 = self.value_s1.try_set(w(id), s1);
            } else {
                let ok = self.value_state.try_set(w(id), 2);
            }
        } else {
            let ok = self.value_state.try_set(w(id), 2);
        }
    }

    fn slot(inout self, rank: u32, s0: u64, s1: u64, param: bool) {
        self.ensure_s(rank);
        let state = u8_at(in self.slot_state, w(rank));
        if state == 0 {
            self.touched_slots.push(rank);
            if s0 < s1 {
                let ok = self.slot_state.try_set(w(rank), 1);
                let ok2 = self.slot_s0.try_set(w(rank), s0);
                let ok3 = self.slot_s1.try_set(w(rank), s1);
                let ok4 = self.slot_is_param.try_set(w(rank), if param { 1 } else { 0 });
            } else {
                let ok = self.slot_state.try_set(w(rank), 2);
            }
        } else {
            let ok = self.slot_state.try_set(w(rank), 2);
        }
    }

    pub fn has_value(in self, id: u32) -> bool {
        u8_at(in self.value_state, w(id)) == 1
    }

    pub fn has_slot(in self, rank: u32) -> bool {
        u8_at(in self.slot_state, w(rank)) == 1
    }
}

// ----- Flow -------------------------------------------------------------------

pub struct Flow {
    bounds: Bounds,
    external: ChunkSeq[u32],
    reservable: ChunkSeq[u32],
    // The values a `match` terminator inspects (`scrutinees`), sorted.
    scrutinees: ChunkSeq[u32],
    // The function values `func` calls indirectly (`callees`, #1242), sorted.
    callees: ChunkSeq[u32],
    origins: Origins,
    // local consume witnesses: id -> span, cleared per block
    has_witness: ChunkSeq[u8],
    witness_s0: ChunkSeq[u64],
    witness_s1: ChunkSeq[u64],
    witness_touched: ChunkSeq[u32],
    diags: Diags,
    message: ChunkSeq[u8],
}

pub fn flow_new() -> Flow {
    Flow {
        bounds: bounds_new(),
        external: ChunkSeq::new[u32](),
        reservable: ChunkSeq::new[u32](),
        scrutinees: ChunkSeq::new[u32](),
        callees: ChunkSeq::new[u32](),
        origins: origins_new(),
        has_witness: ChunkSeq::new[u8](),
        witness_s0: ChunkSeq::new[u64](),
        witness_s1: ChunkSeq::new[u64](),
        witness_touched: ChunkSeq::new[u32](),
        diags: diags_new(),
        message: ChunkSeq::new[u8]()
    }
}

// One cause of `caused`: kind 0 none, 1 value origin, 2 slot origin,
// 3 a span; `label` picks the label text.
pub copy struct Cause {
    kind: u8,
    id: u32,
    s0: u64,
    s1: u64,
    label: u8,
}

const NOCAUSE: Cause = Cause { kind: 0, id: 0, s0: 0, s1: 0, label: 0 };

fn value_cause(id: u32) -> Cause {
    Cause { kind: 1, id: id, s0: 0, s1: 0, label: 0 }
}

fn value_cause_as(id: u32, label: u8) -> Cause {
    Cause { kind: 1, id: id, s0: 0, s1: 0, label: label }
}

fn slot_cause(rank: u32) -> Cause {
    Cause { kind: 2, id: rank, s0: 0, s1: 0, label: 0 }
}

fn push_label(inout diags: Diags, label: u8, param: bool) {
    if label == 1 {
        diags.text.extend(in "this IR read requests the conflicting access".as_bytes());
    } else if label == 2 {
        diags.text.extend(in "the overlapping argument loan is taken here".as_bytes());
    } else if label == 3 {
        diags.text.extend(in "an earlier consuming use in this block is here".as_bytes());
    } else if label == 4 {
        if param {
            diags.text.extend(in "source span for this IR parameter".as_bytes());
        } else {
            diags.text.extend(in "this IR binding is introduced here".as_bytes());
        }
    } else {
        diags.text.extend(in "this IR temporary is defined here".as_bytes());
    }
}

impl Flow {
    fn mode(in self, inout types: Types, in names: Names, in world: World, ty: u32) -> u8 {
        mode_of(inout types, in names, in world, ty, in self.bounds)
    }

    // `Flow::error`: E0410 with the message in `self.message`.
    fn error(inout self, s0: u64, s1: u64) {
        let code_start = self.diags.open("E0410");
        let msg_start = self.diags.text.len();
        self.diags.text.extend(in self.message.as_slice());
        self.diags.close(code_start, msg_start, "", s0, s1);
    }

    fn resolve(in self, cause: Cause) -> Cause {
        if cause.kind == 1 {
            if self.origins.has_value(cause.id) {
                return Cause {
                    kind: 3,
                    id: 0,
                    s0: u64_at(in self.origins.value_s0, w(cause.id)),
                    s1: u64_at(in self.origins.value_s1, w(cause.id)),
                    label: cause.label
                };
            }
            return NOCAUSE;
        }
        if cause.kind == 2 {
            if self.origins.has_slot(cause.id) {
                return Cause {
                    kind: 3,
                    id: if u8_at(in self.origins.slot_is_param, w(cause.id)) == 1 {
                        1
                    } else {
                        0
                    },
                    s0: u64_at(in self.origins.slot_s0, w(cause.id)),
                    s1: u64_at(in self.origins.slot_s1, w(cause.id)),
                    label: 4
                };
            }
            return NOCAUSE;
        }
        cause
    }

    // `Flow::caused` with up to two causes; message in `self.message`.
    fn caused(inout self, s0: u64, s1: u64, first_cause: Cause, second_cause: Cause, in help: Str) {
        let code_start = self.diags.open("E0410");
        let msg_start = self.diags.text.len();
        self.diags.text.extend(in self.message.as_slice());
        let msg_end = self.diags.text.len();
        let rel_start = n32(self.diags.rel.len());
        let first_span = self.resolve(first_cause);
        let second_span = self.resolve(second_cause);
        let mut label_count: u32 = 0;
        if first_span.kind == 3
            && first_span.s0 < first_span.s1
            && !(first_span.s0 == s0 && first_span.s1 == s1) {
            let label_start = self.diags.text.len();
            push_label(inout self.diags, first_span.label, first_span.id == 1);
            self.diags.rel.push(RelRow {
                a: label_start,
                b: self.diags.text.len(),
                start: first_span.s0,
                stop: first_span.s1
            });
            label_count = 1;
        }
        if second_span.kind == 3
            && second_span.s0 < second_span.s1
            && !(second_span.s0 == s0 && second_span.s1 == s1)
            && !(
                label_count == 1
                    && first_span.s0 == second_span.s0
                    && first_span.s1 == second_span.s1
            ) {
            let label_start = self.diags.text.len();
            push_label(inout self.diags, second_span.label, second_span.id == 1);
            self.diags.rel.push(RelRow {
                a: label_start,
                b: self.diags.text.len(),
                start: second_span.s0,
                stop: second_span.s1
            });
            label_count = inc32(label_count);
        }
        if label_count > 0 {
            self.diags.close(code_start, msg_start, help, s0, s1);
        } else {
            self.diags.close(code_start, msg_start, "", s0, s1);
        }
        let last = wrapping_sub(self.diags.rows.len(), 1);
        let row = self.diags.row(last);
        let ok = self.diags.rows.try_set(
            last,
            DiagRow {
                code_a: row.code_a,
                msg_a: row.msg_a,
                msg_b: msg_end,
                help_a: row.help_a,
                end: row.end,
                start: row.start,
                stop: row.stop,
                ra: rel_start,
                rn: label_count
            }
        );
    }

    fn say(inout self, in text: Str) {
        self.message.clear();
        self.message.extend(in text.as_bytes());
    }

    fn say_id(inout self, in prefix: Str, id: u32, in suffix: Str) {
        self.message.clear();
        self.message.extend(in prefix.as_bytes());
        self.message.push(37);
        push_decimal(inout self.message, w(id));
        self.message.extend(in suffix.as_bytes());
    }

    fn say_name(inout self, in names: Names, in prefix: Str, name: u32, in suffix: Str) {
        self.message.clear();
        self.message.extend(in prefix.as_bytes());
        names.write(name, inout self.message);
        self.message.extend(in suffix.as_bytes());
    }

    fn say_place(
        inout self,
        in names: Names,
        in paths: Paths,
        in prefix: Str,
        place: u64,
        in suffix: Str
    ) {
        self.message.clear();
        self.message.extend(in prefix.as_bytes());
        names.write(place_root(place), inout self.message);
        paths.write(in names, place_path(place), inout self.message);
        self.message.extend(in suffix.as_bytes());
    }

    fn note_consume(inout self, id: u32, s0: u64, s1: u64) {
        if s0 < s1 && self.origins.has_value(id) {
            if w(id) >= self.has_witness.len() {
                let n = inc(w(id));
                self.has_witness.resize(n, 0);
                self.witness_s0.resize(n, 0);
                self.witness_s1.resize(n, 0);
            }
            if u8_at(in self.has_witness, w(id)) == 0 {
                let ok = self.has_witness.try_set(w(id), 1);
                let ok2 = self.witness_s0.try_set(w(id), s0);
                let ok3 = self.witness_s1.try_set(w(id), s1);
                self.witness_touched.push(id);
            }
        }
    }

    fn clear_consumes(inout self) {
        for i in 0..self.witness_touched.len() {
            let ok = self.has_witness.try_set(w(u32_at(in self.witness_touched, i)), 0);
        }
        self.witness_touched.clear();
    }

    pub fn consume(
        inout self,
        inout state: State,
        inout types: Types,
        in names: Names,
        in world: World,
        id: u32,
        s0: u64,
        s1: u64
    ) {
        let val_index = state.find_val(id);
        if val_index >= 9223372036854775808 {
            self.say_id("IR uses undefined value ", id, "");
            self.error(s0, s1);
            return;
        }
        let val = state.val_at(val_index);
        if self.mode(inout types, in names, in world, val.ty) == TyMode::Copy {
            return;
        }
        if !val.owned {
            self.say("a borrowed non-copy temporary cannot be moved into an owned value");
            self.caused(
                s0,
                s1,
                value_cause(id),
                NOCAUSE,
                "A borrowed non-copy temporary cannot transfer ownership to an owned value."
            );
        }
        if val.consumed {
            let prior = if u8_at(in self.has_witness, w(id)) == 1 {
                Cause {
                    kind: 3,
                    id: 0,
                    s0: u64_at(in self.witness_s0, w(id)),
                    s1: u64_at(in self.witness_s1, w(id)),
                    label: 3
                }
            } else {
                NOCAUSE
            };
            self.say_id("IR temporary ", id, " is consumed more than once");
            self.caused(
                s0,
                s1,
                value_cause(id),
                prior,
                "A non-copy IR temporary may be consumed only once on an execution path."
            );
        }
        if val.owned && !val.consumed {
            self.note_consume(id, s0, s1);
        }
        state.set_val_at(
            val_index,
            ValS {
                id: val.id,
                ty: val.ty,
                owned: val.owned,
                consumed: true,
                loan_pass: 255,
                loan_start: 0,
                loan_count: 0
            }
        );
    }

    fn release(inout self, inout state: State, id: u32) -> bool {
        let val_index = state.find_val(id);
        if val_index >= 9223372036854775808 {
            return false;
        }
        let val = state.val_at(val_index);
        state.set_val_at(
            val_index,
            ValS {
                id: val.id,
                ty: val.ty,
                owned: val.owned,
                consumed: true,
                loan_pass: 255,
                loan_start: 0,
                loan_count: 0
            }
        );
        true
    }

    fn scrutinee(in self, id: u32) -> bool {
        sorted_contains(in self.scrutinees, id)
    }

    // Whether `func` calls the value `id` (`callees`).
    fn callee(in self, id: u32) -> bool {
        sorted_contains(in self.callees, id)
    }

    fn reserved(in self, id: u32) -> bool {
        let mut lo: u64 = 0;
        let mut hi = self.reservable.len();
        loop {
            if lo >= hi {
                return false;
            }
            let mid = wrapping_add(lo, hi) / 2;
            let mid_id = u32_at(in self.reservable, mid);
            if mid_id == id {
                return true;
            }
            if mid_id < id {
                lo = inc(mid);
            } else {
                hi = mid;
            }
        }
    }

    pub fn access(
        inout self,
        inout state: State,
        inout types: Types,
        inout names: Names,
        in world: World,
        in program: Program,
        place: u64,
        pass: u8,
        s0: u64,
        s1: u64
    ) {
        let root = place_root(place);
        let path = place_path(place);
        let rank = program.rank_of(root);
        let slot_index = state.find_slot(rank);
        if slot_index >= 9223372036854775808 {
            self.say_place(in names, in program.paths, "IR uses undefined place '", place, "'");
            self.error(s0, s1);
            return;
        }
        let slot = state.slot_at(slot_index);
        if state.moved_overlaps(in program.paths, rank, path) {
            self.say_place(in names, in program.paths, "IR uses moved place '", place, "'");
            self.caused(
                s0,
                s1,
                slot_cause(rank),
                NOCAUSE,
                "A moved place cannot be used again until ownership is re-established."
            );
        }
        let found_ty = program.paths.field_type(inout types, inout names, in world, slot.ty, path);
        let ty = if found_ty == NONE32 {
            types.infer
        } else {
            found_ty
        };
        let place_mode = self.mode(inout types, in names, in world, ty);
        let exclusive = pass == TyPass::Inout
            || (pass == TyPass::Sink && place_mode != TyMode::Copy);
        for vi in 0.. state.values.len() {
            let val = state.val_at(vi);
            if val.loan_pass != 255
                && !val.consumed
                && (exclusive || (val.loan_pass == TyPass::Inout && !self.reserved(val.id))) {
                let mut hit = false;
                for j in 0..w(val.loan_count) {
                    let loan = state.loan(add(w(val.loan_start), j));
                    if place_root(loan) == root && program.paths.overlaps(path, place_path(loan)) {
                        hit = true;
                    }
                }
                if hit {
                    self.message.clear();
                    self.message.extend(in "IR access to '".as_bytes());
                    names.write(root, inout self.message);
                    program.paths.write(in names, path, inout self.message);
                    self.message.extend(in "' overlaps active loan '".as_bytes());
                    for j in 0..w(val.loan_count) {
                        if j > 0 {
                            self.message.extend(in ", ".as_bytes());
                        }
                        let loan = state.loan(add(w(val.loan_start), j));
                        names.write(place_root(loan), inout self.message);
                        program.paths.write(in names, place_path(loan), inout self.message);
                    }
                    self.message.push(39);
                    self.caused(
                        s0,
                        s1,
                        value_cause_as(val.id, 1),
                        slot_cause(rank),
                        "Overlapping access must respect the shared or exclusive permission of each active loan."
                    );
                }
            }
        }
        if pass == TyPass::Inout && slot.pass == TyPass::In {
            self.say("IR mutates a shared parameter");
            self.caused(
                s0,
                s1,
                slot_cause(rank),
                NOCAUSE,
                "Shared parameters do not grant mutation permission."
            );
        }
        if pass == TyPass::Sink && place_mode != TyMode::Copy {
            if slot.pass != TyPass::Sink {
                self.say("IR moves from a borrowed parameter");
                self.caused(
                    s0,
                    s1,
                    slot_cause(rank),
                    NOCAUSE,
                    "Borrowed parameters do not transfer ownership to this function."
                );
            }
            if path != 0 && self.mode(inout types, in names, in world, slot.ty) == TyMode::Linear {
                self.say("IR must destructure a linear aggregate before moving fields");
                self.caused(
                    s0,
                    s1,
                    slot_cause(rank),
                    NOCAUSE,
                    "Consume the full linear aggregate through its supported destructuring rules."
                );
            }
            state.moved_insert(rank, path);
        }
    }

    // `Flow::activate` over the (pass, value) pairs at operands[args_start..].
    fn activate(
        inout self,
        in state: State,
        inout types: Types,
        in names: Names,
        known: Known,
        in program: Program,
        args_start: u64,
        s0: u64,
        s1: u64
    ) {
        let n = program.op(args_start);
        for i in 0..n {
            let inout_id = n32(program.op(add(args_start, add(2, wrapping_mul(i, 2)))));
            let inout_index = state.find_val(inout_id);
            if inout_index >= 9223372036854775808 {
                continue;
            }
            let inout_val = state.val_at(inout_index);
            if inout_val.loan_pass != TyPass::Inout || inout_val.consumed {
                continue;
            }
            for j in 0..n {
                let arg_pass = wrapping_u8(program.op(add(args_start, inc(wrapping_mul(j, 2)))));
                let arg_id = n32(program.op(add(args_start, add(2, wrapping_mul(j, 2)))));
                let arg_index = state.find_val(arg_id);
                if arg_index >= 9223372036854775808 {
                    continue;
                }
                let arg_val = state.val_at(arg_index);
                if arg_val.loan_pass != TyPass::In || arg_val.consumed {
                    continue;
                }
                if arg_pass != TyPass::Inout && is_scalar_type(in types, known, arg_val.ty) {
                    continue;
                }
                let mut found: u64 = 18446744073709551615;
                for qi in 0..w(arg_val.loan_count) {
                    let arg_loan = state.loan(add(w(arg_val.loan_start), qi));
                    for pi in 0..w(inout_val.loan_count) {
                        let inout_loan = state.loan(add(w(inout_val.loan_start), pi));
                        if found == 18446744073709551615
                            && place_root(inout_loan) == place_root(arg_loan)
                            && program
                                .paths
                                .overlaps(place_path(inout_loan), place_path(arg_loan)) {
                            found = arg_loan;
                        }
                    }
                }
                if found != 18446744073709551615 {
                    self.message.clear();
                    self.message.extend(in "IR call activates inout loan '".as_bytes());
                    for pi in 0..w(inout_val.loan_count) {
                        if pi > 0 {
                            self.message.extend(in ", ".as_bytes());
                        }
                        let inout_loan = state.loan(add(w(inout_val.loan_start), pi));
                        names.write(place_root(inout_loan), inout self.message);
                        program.paths.write(in names, place_path(inout_loan), inout self.message);
                    }
                    self.message.extend(in "' while its argument loan '".as_bytes());
                    names.write(place_root(found), inout self.message);
                    program.paths.write(in names, place_path(found), inout self.message);
                    self.message.extend(in "' is live".as_bytes());
                    self.caused(
                        s0,
                        s1,
                        value_cause_as(arg_id, 2),
                        NOCAUSE,
                        "A reserved inout loan becomes exclusive when its call runs, so no argument of the same call may borrow its place."
                    );
                }
            }
        }
    }
}

// `check::is_scalar_type`: a scalar name without arguments after
// `default_type` (an integer literal is i64).
fn is_scalar_type(in types: Types, known: Known, ty: u32) -> bool {
    let node = types.node(ty);
    if node.kind == TyKind::Lit {
        return true;
    }
    node.kind == TyKind::Named && node.n == 0 && known.is_scalar(node.name)
}
// src/ir_check.rs, part 3: bind, frame, end, the instruction transfer,
// merge, the worklist and `validate`.

impl Flow {
    fn bind(
        inout self,
        inout state: State,
        inout types: Types,
        inout names: Names,
        in world: World,
        in program: Program,
        pat: u64,
        ty: u32,
        origin: u32,
        pass: u8
    ) {
        let kind = program.pat(pat);
        let s0 = program.pat(inc(pat));
        let s1 = program.pat(add(pat, 2));
        if kind == 1 {
            let name = n32(program.pat(add(pat, 3)));
            state.put_slot(SlotS { rank: program.rank_of(name), name: name, ty: ty, pass: pass });
        } else if kind == 0 {
            if pass == TyPass::Sink
                && self.mode(inout types, in names, in world, ty) == TyMode::Linear {
                self.say("IR wildcard discards a linear value");
                self.caused(
                    s0,
                    s1,
                    value_cause(origin),
                    NOCAUSE,
                    "Linear components must be consumed rather than discarded by a wildcard."
                );
            }
        } else if kind == 2 {
            if types.kind(ty) == TyKind::Tuple {
                let n = program.pat(add(pat, 3));
                let arity = types.arity(ty);
                for i in 0..n {
                    if i >= arity {
                        break;
                    }
                    let child = program.pat(add(add(pat, 4), i));
                    self.bind(
                        inout state,
                        inout types,
                        inout names,
                        in world,
                        in program,
                        child,
                        types.arg(ty, i),
                        origin,
                        pass
                    );
                }
            }
        } else if kind == 4 {
            let qualifier = n32(program.pat(add(pat, 3)));
            let short = n32(program.pat(add(pat, 4)));
            let ctor = constructor(in world, qualifier, short);
            if ctor != 18446744073709551615 {
                let adt = world.adt(n32(ctor >> 32));
                let variant = world.variant(ctor & 4294967295);
                let vars = if types.kind(ty) == TyKind::Named {
                    world.vars_of(in types, adt, ty)
                } else {
                    vars_new()
                };
                let n = program.pat(add(pat, 5));
                for i in 0..n {
                    let field_name = n32(program.pat(add(add(pat, 6), wrapping_mul(i, 2))));
                    let child = program.pat(add(add(pat, 7), wrapping_mul(i, 2)));
                    let field_index = world.find_field(variant, field_name);
                    if field_index != NONE32 {
                        let field_ty = substitute(
                            inout types,
                            world.field(w(field_index)).ty,
                            in vars
                        );
                        self.bind(
                            inout state,
                            inout types,
                            inout names,
                            in world,
                            in program,
                            child,
                            field_ty,
                            origin,
                            pass
                        );
                    }
                }
            }
        }
    }

    fn external_has(in self, name: u32) -> bool {
        for i in 0..self.external.len() {
            if u32_at(in self.external, i) == name {
                return true;
            }
        }
        false
    }

    fn live_linear_slot(
        inout self,
        in state: State,
        inout types: Types,
        in names: Names,
        in world: World,
        slot: SlotS
    ) -> bool {
        slot.pass == TyPass::Sink
            && self.mode(inout types, in names, in world, slot.ty) == TyMode::Linear
            && !state.moved_has(slot.rank, 0)
    }

    // `Flow::frame` (end = false) and `Flow::end` (end = true).
    fn frame(
        inout self,
        in state: State,
        inout types: Types,
        in names: Names,
        in world: World,
        s0: u64,
        s1: u64,
        end: bool
    ) {
        for i in 0.. state.slots.len() {
            let slot = state.slot_at(i);
            if self.live_linear_slot(in state, inout types, in names, in world, slot)
                && !self.external_has(slot.name) {
                if end {
                    self.say_name(
                        in names,
                        "linear place '",
                        slot.name,
                        "' remains live at IR return"
                    );
                    self.caused(
                        s0,
                        s1,
                        slot_cause(slot.rank),
                        NOCAUSE,
                        "Each owned linear place must be consumed on every returning path."
                    );
                } else {
                    self.say_name(
                        in names,
                        "abortable effect may abandon linear place '",
                        slot.name,
                        "'"
                    );
                    self.caused(
                        s0,
                        s1,
                        slot_cause(slot.rank),
                        NOCAUSE,
                        "An abortable operation must not abandon a live owned linear place."
                    );
                }
            }
        }
        for i in 0.. state.values.len() {
            let val = state.val_at(i);
            if val.owned
                && !val.consumed
                && self.mode(inout types, in names, in world, val.ty) == TyMode::Linear {
                if end {
                    self.say_id("linear temporary ", val.id, " remains live at IR return");
                    self.caused(
                        s0,
                        s1,
                        value_cause(val.id),
                        NOCAUSE,
                        "Each owned linear temporary must be consumed on every returning path."
                    );
                } else {
                    self.say_id("abortable effect may abandon linear temporary ", val.id, "");
                    self.caused(
                        s0,
                        s1,
                        value_cause(val.id),
                        NOCAUSE,
                        "An abortable operation must not abandon a live owned linear temporary."
                    );
                }
            }
        }
    }

    // Arguments (pass, value)* at operands[args_start..]: sink arguments are consumed,
    // borrowed ones release their loans.
    fn args(
        inout self,
        inout state: State,
        inout types: Types,
        in names: Names,
        in world: World,
        in program: Program,
        args_start: u64,
        s0: u64,
        s1: u64
    ) {
        let n = program.op(args_start);
        for i in 0..n {
            let pass = wrapping_u8(program.op(add(args_start, inc(wrapping_mul(i, 2)))));
            let val_id = n32(program.op(add(args_start, add(2, wrapping_mul(i, 2)))));
            if pass == TyPass::Sink {
                self.consume(inout state, inout types, in names, in world, val_id, s0, s1);
            } else {
                let released = self.release(inout state, val_id);
            }
        }
    }

    fn row_effectful(in self, in types: Types, in program: Program, ty: u32) -> bool {
        let node = types.node(ty);
        if node.kind != TyKind::Fn {
            return false;
        }
        let row = types.row(node.r2);
        if row.tail != 0 {
            return true;
        }
        for i in 0..w(row.n) {
            if program.is_nonlinear(types.effect_at(add(w(row.a), i)).name) {
                return true;
            }
        }
        false
    }

    pub fn instruction(
        inout self,
        inout state: State,
        inout types: Types,
        inout names: Names,
        in world: World,
        in program: Program,
        inst: Inst
    ) {
        let known = world.k;
        let operand_start = w(inst.operand_start);
        let s0 = inst.s0;
        let s1 = inst.s1;
        let mut owned = true;
        let mut loan_pass: u8 = 255;
        let mut loan_from: u64 = 0;
        let mut loan_count: u64 = 0;
        // Element view matches (`match s.try_get(i)`, #1221) are not
        // ported: the encoder (`program_encodable` in
        // tests/common/check_words.rs) refuses every world with element
        // views, and the hybrid build runs `rust_validate` for it, so no
        // `try_get` payload reaches this checker. Test:
        // `element_views_stay_on_rust` in tests/hybrid_ir_check.rs.
        if inst.op == OP_READ {
            let root = n32(program.op(operand_start));
            let read_pass = wrapping_u8(program.op(inc(operand_start)));
            let is_fn = program.op(add(operand_start, 2)) != 0;
            let path_count = program.op(add(operand_start, 3));
            // A by-value read that only a `match` inspects, of a borrowed
            // slot's non-copy place, is a borrow (§4.3).
            let mut pass = read_pass;
            if pass == TyPass::Sink && self.scrutinee(inst.dest) {
                let slot_index = state.find_slot(program.rank_of(root));
                if slot_index < 9223372036854775808
                    && state.slot_at(slot_index).pass != TyPass::Sink
                    && self.mode(inout types, in names, in world, inst.ty) != TyMode::Copy {
                    pass = TyPass::In;
                }
            }
            // Calling a borrowed slot's function value that is not `copy`
            // reads it (a lent function parameter, §4.2).
            if pass == TyPass::Sink
                && path_count == 1
                && program.op(add(operand_start, 4)) == 0
                && self.callee(inst.dest) {
                let slot_index = state.find_slot(program.rank_of(root));
                let ty_node = types.node(inst.ty);
                if slot_index < 9223372036854775808
                    && state.slot_at(slot_index).pass != TyPass::Sink
                    && ty_node.kind == TyKind::Fn
                    && ty_node.mode != TyMode::Copy {
                    pass = TyPass::In;
                }
            }
            if state.find_slot(program.rank_of(root)) < 9223372036854775808 || !is_fn {
                for j in 0..path_count {
                    let path = n32(program.op(add(add(operand_start, 4), j)));
                    self.access(
                        inout state,
                        inout types,
                        inout names,
                        in world,
                        in program,
                        place(root, path),
                        pass,
                        s0,
                        s1
                    );
                }
            }
            if pass != TyPass::Sink {
                owned = false;
                // A borrowed scrutinee lends its place to the arms'
                // bindings, which the checker keeps from conflicting with
                // any write (§4.3); it takes no value loan.
                if read_pass != TyPass::Sink {
                    loan_pass = pass;
                    loan_from = add(operand_start, 4);
                    loan_count = path_count;
                }
            }
        } else if inst.op == OP_BIND {
            let value = n32(program.op(operand_start));
            let val_index = state.find_val(value);
            let ty = if val_index < 9223372036854775808 {
                state.val_at(val_index).ty
            } else {
                types.infer
            };
            // A borrowed scrutinee binds borrows of its payloads.
            let borrowed = self.scrutinee(value)
                && val_index < 9223372036854775808
                && !state.val_at(val_index).owned;
            let pass = if borrowed {
                TyPass::In
            } else {
                self.consume(inout state, inout types, in names, in world, value, s0, s1);
                TyPass::Sink
            };
            self.bind(
                inout state,
                inout types,
                inout names,
                in world,
                in program,
                program.op(inc(operand_start)),
                ty,
                value,
                pass
            );
        } else if inst.op == OP_WRITE {
            let value = n32(program.op(operand_start));
            let root = n32(program.op(inc(operand_start)));
            let path = n32(program.op(add(operand_start, 2)));
            let assign = program.op(add(operand_start, 3)) != 0;
            self.consume(inout state, inout types, in names, in world, value, s0, s1);
            let rank = program.rank_of(root);
            if assign && state.find_slot(rank) < 9223372036854775808 {
                state.moved_retain_not_under(in program.paths, rank, path);
            }
            self.access(
                inout state,
                inout types,
                inout names,
                in world,
                in program,
                place(root, path),
                TyPass::Inout,
                s0,
                s1
            );
            let slot_index = state.find_slot(rank);
            if slot_index < 9223372036854775808 {
                let found_ty = program.paths.field_type(
                    inout types,
                    inout names,
                    in world,
                    state.slot_at(slot_index).ty,
                    path
                );
                let field_ty = if found_ty == NONE32 {
                    types.infer
                } else {
                    found_ty
                };
                if self.mode(inout types, in names, in world, field_ty) == TyMode::Linear {
                    self.say("IR assignment overwrites a linear obligation");
                    self.caused(
                        s0,
                        s1,
                        slot_cause(rank),
                        NOCAUSE,
                        "Overwriting an owned linear obligation would discard it."
                    );
                }
            }
        } else if inst.op == OP_CONSUME1 {
            self.consume(
                inout state,
                inout types,
                in names,
                in world,
                n32(program.op(operand_start)),
                s0,
                s1
            );
        } else if inst.op == OP_BINARY {
            let is_cmp = program.op(operand_start) != 0;
            for j in 1..3 {
                let val_id = n32(program.op(add(operand_start, j)));
                let val_index = state.find_val(val_id);
                let mut done = false;
                if is_cmp && val_index < 9223372036854775808 {
                    let val = state.val_at(val_index);
                    let ty_node = types.node(val.ty);
                    if !val.owned
                        && ty_node.kind == TyKind::Named
                        && ty_node.n == 0
                        && (ty_node.name == known.string || ty_node.name == known.str_) {
                        state.set_val_at(
                            val_index,
                            ValS {
                                id: val.id,
                                ty: val.ty,
                                owned: val.owned,
                                consumed: true,
                                loan_pass: 255,
                                loan_start: 0,
                                loan_count: 0
                            }
                        );
                        done = true;
                    }
                }
                if !done {
                    self.consume(inout state, inout types, in names, in world, val_id, s0, s1);
                }
            }
        } else if inst.op == OP_CONSUME_N {
            let n = program.op(operand_start);
            for j in 0..n {
                self.consume(
                    inout state,
                    inout types,
                    in names,
                    in world,
                    n32(program.op(add(inc(operand_start), j))),
                    s0,
                    s1
                );
            }
        } else if inst.op == OP_VECTOR {
            let n = program.op(operand_start);
            for j in 0..n {
                let val_id = n32(program.op(add(inc(operand_start), j)));
                if !self.release(inout state, val_id) {
                    self.consume(inout state, inout types, in names, in world, val_id, s0, s1);
                }
            }
        } else if inst.op == OP_SEQ || inst.op == OP_CALL {
            self.activate(
                in state,
                inout types,
                in names,
                known,
                in program,
                operand_start,
                s0,
                s1
            );
            self.args(
                inout state,
                inout types,
                in names,
                in world,
                in program,
                operand_start,
                s0,
                s1
            );
            if inst.op == OP_CALL && (inst.flags & F_EFFECTFUL) != 0 {
                self.frame(in state, inout types, in names, in world, s0, s1, false);
            }
        } else if inst.op == OP_PROJECT {
            let val_id = n32(program.op(operand_start));
            let val_index = state.find_val(val_id);
            if val_index < 9223372036854775808
                && self.mode(inout types, in names, in world, state.val_at(val_index).ty)
                    == TyMode::Linear {
                self.say("projection would abandon a temporary linear aggregate");
                self.caused(
                    s0,
                    s1,
                    value_cause(val_id),
                    NOCAUSE,
                    "A linear aggregate must retain all of its ownership obligations when destructured."
                );
            }
            self.consume(inout state, inout types, in names, in world, val_id, s0, s1);
        } else if inst.op == OP_INDEX {
            self.consume(
                inout state,
                inout types,
                in names,
                in world,
                n32(program.op(operand_start)),
                s0,
                s1
            );
            self.consume(
                inout state,
                inout types,
                in names,
                in world,
                n32(program.op(inc(operand_start))),
                s0,
                s1
            );
        } else if inst.op == OP_INDIRECT {
            let callee = n32(program.op(operand_start));
            let val_index = state.find_val(callee);
            let effectful = val_index < 9223372036854775808
                && self.row_effectful(in types, in program, state.val_at(val_index).ty);
            let lent = if val_index < 9223372036854775808 {
                let val = state.val_at(val_index);
                let ty_node = types.node(val.ty);
                !val.owned && ty_node.kind == TyKind::Fn && ty_node.mode != TyMode::Copy
            } else {
                false
            };
            if lent {
                // A lent function parameter is read by its call (§4.2).
                let val = state.val_at(val_index);
                state.set_val_at(
                    val_index,
                    ValS {
                        id: val.id,
                        ty: val.ty,
                        owned: val.owned,
                        consumed: true,
                        loan_pass: 255,
                        loan_start: 0,
                        loan_count: 0
                    }
                );
            } else {
                self.consume(inout state, inout types, in names, in world, callee, s0, s1);
            }
            self.activate(
                in state,
                inout types,
                in names,
                known,
                in program,
                inc(operand_start),
                s0,
                s1
            );
            self.args(
                inout state,
                inout types,
                in names,
                in world,
                in program,
                inc(operand_start),
                s0,
                s1
            );
            if effectful {
                self.frame(in state, inout types, in names, in world, s0, s1, false);
            }
        } else if inst.op == OP_TRY {
            self.consume(
                inout state,
                inout types,
                in names,
                in world,
                n32(program.op(operand_start)),
                s0,
                s1
            );
            self.frame(in state, inout types, in names, in world, s0, s1, false);
        } else if inst.op == OP_MOVES || inst.op == OP_HANDLE {
            let n = program.op(operand_start);
            for j in 0..n {
                self.access(
                    inout state,
                    inout types,
                    inout names,
                    in world,
                    in program,
                    program.op(add(inc(operand_start), j)),
                    TyPass::Sink,
                    s0,
                    s1
                );
            }
        }
        if (inst.flags & F_ABORT) != 0 {
            self.frame(in state, inout types, in names, in world, s0, s1, false);
        }
        if inst.op == OP_HANDLE {
            let n = program.op(operand_start);
            if program.op(add(inc(operand_start), n)) != 0 {
                self.consume(
                    inout state,
                    inout types,
                    in names,
                    in world,
                    n32(program.op(add(add(operand_start, 2), n))),
                    s0,
                    s1
                );
            }
            if (inst.flags & F_EFFECTFUL) != 0 {
                self.frame(in state, inout types, in names, in world, s0, s1, false);
            }
        }
        let ty = if inst.op == OP_BIND || inst.op == OP_WRITE {
            types.unit
        } else {
            inst.ty
        };
        let loan_start = n32(state.loans.len());
        if loan_pass != 255 {
            for j in 0..loan_count {
                state.loans.push(place(
                    n32(program.op(operand_start)),
                    n32(program.op(add(loan_from, j)))
                ));
            }
        }
        state.put_val(ValS {
            id: inst.dest,
            ty: ty,
            owned: owned,
            consumed: false,
            loan_pass: loan_pass,
            loan_start: loan_start,
            loan_count: n32(loan_count)
        });
    }

    // `out = merge(out, incoming)`: `out` holds a clone of the old state.
    fn merge(
        inout self,
        inout out: State,
        in incoming: State,
        inout types: Types,
        in names: Names,
        in world: World,
        s0: u64,
        s1: u64
    ) {
        for i in 0..incoming.slots.len() {
            let slot = incoming.slot_at(i);
            let slot_index = out.find_slot(slot.rank);
            if slot_index < 9223372036854775808 {
                let old_slot = out.slot_at(slot_index);
                let old_live = self.live_linear_slot(
                    in out,
                    inout types,
                    in names,
                    in world,
                    old_slot
                );
                let new_live = self.live_linear_slot(
                    in incoming,
                    inout types,
                    in names,
                    in world,
                    slot
                );
                if old_live != new_live {
                    self.say_name(
                        in names,
                        "linear place '",
                        slot.name,
                        "' has inconsistent ownership at a CFG join"
                    );
                    self.caused(
                        s0,
                        s1,
                        slot_cause(slot.rank),
                        NOCAUSE,
                        "Ownership of a linear place must agree on the incoming control-flow edges."
                    );
                }
                let (lo, hi) = incoming.moved_range(slot.rank);
                for j in lo..hi {
                    out.moved_insert(slot.rank, place_path(u64_at(in incoming.moved, j)));
                }
            } else {
                if self.live_linear_slot(in incoming, inout types, in names, in world, slot) {
                    self.say_name(
                        in names,
                        "linear place '",
                        slot.name,
                        "' survives only one CFG edge"
                    );
                    self.caused(
                        s0,
                        s1,
                        slot_cause(slot.rank),
                        NOCAUSE,
                        "An owned linear place cannot disappear on another incoming control-flow edge."
                    );
                }
                out.put_slot(slot);
                let (lo, hi) = incoming.moved_range(slot.rank);
                for j in lo..hi {
                    out.moved_insert(slot.rank, place_path(u64_at(in incoming.moved, j)));
                }
            }
        }
        for i in 0..incoming.values.len() {
            let val = incoming.val_at(i);
            let val_index = out.find_val(val.id);
            if val_index < 9223372036854775808 {
                let old_val = out.val_at(val_index);
                if self.mode(inout types, in names, in world, old_val.ty) == TyMode::Linear
                    && old_val.owned
                    && old_val.consumed != val.consumed {
                    self.say_id(
                        "linear temporary ",
                        val.id,
                        " has inconsistent ownership at a CFG join"
                    );
                    self.caused(
                        s0,
                        s1,
                        value_cause(val.id),
                        NOCAUSE,
                        "Ownership of a linear temporary must agree on incoming control-flow edges."
                    );
                }
                let consumed = old_val.consumed || val.consumed;
                if consumed {
                    out.set_val_at(
                        val_index,
                        ValS {
                            id: old_val.id,
                            ty: old_val.ty,
                            owned: old_val.owned,
                            consumed: true,
                            loan_pass: 255,
                            loan_start: 0,
                            loan_count: 0
                        }
                    );
                }
            } else {
                let loan_start = n32(out.loans.len());
                if val.loan_pass != 255 {
                    for j in 0..w(val.loan_count) {
                        out.loans.push(incoming.loan(add(w(val.loan_start), j)));
                    }
                }
                out.put_val(ValS {
                    id: val.id,
                    ty: val.ty,
                    owned: val.owned,
                    consumed: val.consumed,
                    loan_pass: val.loan_pass,
                    loan_start: loan_start,
                    loan_count: val.loan_count
                });
            }
        }
    }

    fn origins_build(inout self, in names: Names, in program: Program, func: FnRow) {
        self.origins.clear();
        let mut work = MAX_CAUSE_WORK;
        let mut text = MAX_CAUSE_TEXT;
        // Rust's `try_build` charges one unit of work per parameter, block,
        // block parameter, instruction and pattern node, and a name's bytes
        // against the text budget (a name over 1,024 bytes fails at once);
        // at the first exhausted limit it keeps no origins at all.
        let mut ok = true;
        for i in 0..w(func.param_count) {
            let param_row = match program.params.try_get(add(w(func.param_start), i)) {
                Option::Some(row) => row,
                Option::None => ParamRow { name: 0, pass: 0, ty: 0, s0: 0, s1: 0 },
            };
            if !charge(inout work) || !charge_name(in names, param_row.name, inout text) {
                ok = false;
                break;
            }
            self.origins.slot(program.rank_of(param_row.name), param_row.s0, param_row.s1, true);
        }
        let mut pending: ChunkSeq[u64] = ChunkSeq::new[u64]();
        for bi in 0..w(func.block_count) {
            if !ok || !charge(inout work) {
                ok = false;
                break;
            }
            let block = program.block(add(w(func.block_start), bi));
            for j in 0..w(block.param_count) {
                if !charge(inout work) {
                    ok = false;
                    break;
                }
                self.origins.value(n32(program.op(add(w(block.param_start), j))), false, 0, 0);
            }
            for ii in 0..w(block.inst_count) {
                if !ok || !charge(inout work) {
                    ok = false;
                    break;
                }
                let inst = program.inst(add(w(block.inst_start), ii));
                self.origins.value(inst.dest, true, inst.s0, inst.s1);
                if inst.op == OP_BIND {
                    pending.clear();
                    pending.push(program.op(inc(w(inst.operand_start))));
                    loop {
                        if pending.len() == 0 || !ok {
                            break;
                        }
                        if !charge(inout work) {
                            ok = false;
                            break;
                        }
                        let pat_pos = u64_at(in pending, wrapping_sub(pending.len(), 1));
                        pending.truncate(wrapping_sub(pending.len(), 1));
                        let kind = program.pat(pat_pos);
                        if kind == 1 {
                            let name = n32(program.pat(add(pat_pos, 3)));
                            if !charge_name(in names, name, inout text) {
                                ok = false;
                                break;
                            }
                            self.origins.slot(
                                program.rank_of(name),
                                program.pat(inc(pat_pos)),
                                program.pat(add(pat_pos, 2)),
                                false
                            );
                        } else if kind == 2 {
                            let n = program.pat(add(pat_pos, 3));
                            for child_index in 0..n {
                                if !charge(inout work) {
                                    ok = false;
                                    break;
                                }
                                pending.push(program.pat(add(add(pat_pos, 4), child_index)));
                            }
                        } else if kind == 4 || kind == 3 {
                            let n = program.pat(add(pat_pos, 5));
                            for child_index in 0..n {
                                if !charge(inout work) {
                                    ok = false;
                                    break;
                                }
                                pending.push(
                                    program.pat(add(add(pat_pos, 7), wrapping_mul(child_index, 2)))
                                );
                            }
                        }
                    }
                }
            }
        }
        if !ok {
            self.origins.clear();
        }
    }

    pub fn function(
        inout self,
        inout types: Types,
        inout names: Names,
        in world: World,
        in program: Program,
        func: FnRow,
        inout pool: Pool,
        inout state: State,
        inout edge: State,
        inout next: State,
        inout old: State
    ) {
        if func.block_count == 0 {
            return;
        }
        self.bounds = bounds_new();
        for i in 0..w(func.bound_count) {
            let bound_at = add(w(func.bound_start), wrapping_mul(i, 2));
            self.bounds.set(n32(program.op(bound_at)), wrapping_u8(program.op(inc(bound_at))));
        }
        self.external.clear();
        for i in 0..w(func.capture_count) {
            self.external.push(n32(program.op(add(w(func.capture_start), i))));
        }
        // `reservable`: values some call-like operation takes as inout.
        self.reservable.clear();
        for bi in 0..w(func.block_count) {
            let block = program.block(add(w(func.block_start), bi));
            for ii in 0..w(block.inst_count) {
                let inst = program.inst(add(w(block.inst_start), ii));
                let args_start = if inst.op == OP_SEQ || inst.op == OP_CALL {
                    w(inst.operand_start)
                } else if inst.op == OP_INDIRECT {
                    inc(w(inst.operand_start))
                } else {
                    18446744073709551615
                };
                if args_start != 18446744073709551615 {
                    let n = program.op(args_start);
                    for j in 0..n {
                        if wrapping_u8(program.op(add(args_start, inc(wrapping_mul(j, 2)))))
                            == TyPass::Inout {
                            let added = set_insert(
                                inout self.reservable,
                                n32(program.op(add(args_start, add(2, wrapping_mul(j, 2)))))
                            );
                        }
                    }
                }
            }
        }
        // `scrutinees`: the values a `match` terminator inspects. A by-value
        // read of a borrowed slot's non-copy place that only a `match`
        // inspects is a borrow (§4.3).
        self.scrutinees.clear();
        for bi in 0..w(func.block_count) {
            let block = program.block(add(w(func.block_start), bi));
            if block.term == 3 {
                let n = program.op(w(block.term_start));
                let added = set_insert(
                    inout self.scrutinees,
                    n32(program.op(add(inc(w(block.term_start)), n)))
                );
            }
        }
        // `callees`: the function values `func` calls. Calling a borrowed slot
        // of a function type that is not `copy` (a lent function
        // parameter, §4.2) reads it.
        self.callees.clear();
        for bi in 0..w(func.block_count) {
            let block = program.block(add(w(func.block_start), bi));
            for ii in 0..w(block.inst_count) {
                let inst = program.inst(add(w(block.inst_start), ii));
                if inst.op == OP_INDIRECT {
                    let added = set_insert(
                        inout self.callees,
                        n32(program.op(w(inst.operand_start)))
                    );
                }
            }
        }
        self.origins_build(in names, in program, func);
        pool.reset(w(func.block_count));
        state.clear();
        for i in 0..w(func.param_count) {
            let param_row = match program.params.try_get(add(w(func.param_start), i)) {
                Option::Some(row) => row,
                Option::None => ParamRow { name: 0, pass: 0, ty: 0, s0: 0, s1: 0 },
            };
            state.put_slot(SlotS {
                rank: program.rank_of(param_row.name),
                name: param_row.name,
                ty: param_row.ty,
                pass: param_row.pass
            });
        }
        pool.store(0, in state);
        let mut queue: ChunkSeq[u32] = ChunkSeq::new[u32]();
        let mut queued: ChunkSeq[u8] = ChunkSeq::new[u8]();
        queued.resize(w(func.block_count), 0);
        let mut head: u64 = 0;
        queue.push(0);
        let ok0 = queued.try_set(0, 1);
        let mut visits: u64 = 0;
        let limit = if wrapping_mul(w(func.block_count), 32) > 32 {
            wrapping_mul(w(func.block_count), 32)
        } else {
            32
        };
        let mut successors: ChunkSeq[u32] = ChunkSeq::new[u32]();
        loop {
            if head >= queue.len() {
                break;
            }
            let block_id = u32_at(in queue, head);
            head = inc(head);
            let okq = queued.try_set(w(block_id), 0);
            visits = inc(visits);
            if visits > limit {
                self.say("IR ownership dataflow did not converge");
                self.error(0, 0);
                break;
            }
            pool.load(w(block_id), inout state);
            self.clear_consumes();
            let block = program.block(add(w(func.block_start), w(block_id)));
            let mut diverges = false;
            let mut s0: u64 = 0;
            let mut s1: u64 = 0;
            for ii in 0..w(block.inst_count) {
                let inst = program.inst(add(w(block.inst_start), ii));
                self.instruction(inout state, inout types, inout names, in world, in program, inst);
                s0 = inst.s0;
                s1 = inst.s1;
                if (inst.flags & F_NEVER) != 0 {
                    diverges = true;
                    break;
                }
            }
            if diverges {
                continue;
            }
            let term_start = w(block.term_start);
            if block.term == 0 {
                self.consume(
                    inout state,
                    inout types,
                    in names,
                    in world,
                    n32(program.op(term_start)),
                    s0,
                    s1
                );
                self.frame(in state, inout types, in names, in world, s0, s1, true);
            }
            targets(in program, block, inout successors);
            for e in 0..successors.len() {
                let target = u32_at(in successors, e);
                let target_block = program.block(add(w(func.block_start), w(target)));
                edge.copy_from(in state);
                if block.term == 1 {
                    let arg_count = program.op(inc(term_start));
                    for j in 0..arg_count {
                        if j >= w(target_block.param_count) {
                            break;
                        }
                        let arg = n32(program.op(add(add(term_start, 2), j)));
                        let param = n32(program.op(add(w(target_block.param_start), j)));
                        self.consume(inout edge, inout types, in names, in world, arg, s0, s1);
                        edge.put_val(ValS {
                            id: param,
                            ty: param_type(in program, func, param),
                            owned: true,
                            consumed: false,
                            loan_pass: 255,
                            loan_start: 0,
                            loan_count: 0
                        });
                    }
                }
                let had = pool.has(w(target));
                if had {
                    pool.load(w(target), inout old);
                    next.copy_from(in old);
                    self.merge(inout next, in edge, inout types, in names, in world, s0, s1);
                    if !next.same(in old) {
                        pool.store(w(target), in next);
                        if u8_at(in queued, w(target)) == 0 {
                            queue.push(target);
                            let okq2 = queued.try_set(w(target), 1);
                        }
                    }
                } else {
                    pool.store(w(target), in edge);
                    if u8_at(in queued, w(target)) == 0 {
                        queue.push(target);
                        let okq3 = queued.try_set(w(target), 1);
                    }
                }
            }
        }
    }
}

fn param_type(in program: Program, func: FnRow, id: u32) -> u32 {
    for i in 0..w(func.value_ty_count) {
        let pair_at = add(w(func.value_ty_start), wrapping_mul(i, 2));
        if n32(program.op(pair_at)) == id {
            return n32(program.op(inc(pair_at)));
        }
    }
    0
}

// `validate`: evidence, then each function's flow; duplicates (code, span,
// message) removed, first kept. The digest folds what remains.
pub fn validate_digest(
    inout types: Types,
    inout names: Names,
    in world: World,
    in program: Program,
    inout flow: Flow,
    inout pool: Pool,
    inout state: State,
    inout edge: State,
    inout next: State,
    inout old: State
) -> u64 {
    flow.diags.clear();
    evidence(in program, inout flow.diags);
    for fi in 0..program.fns.len() {
        let func = match program.fns.try_get(fi) {
            Option::Some(func) => func,
            Option::None => FnRow {
                param_start: 0,
                param_count: 0,
                bound_start: 0,
                bound_count: 0,
                capture_start: 0,
                capture_count: 0,
                value_ty_start: 0,
                value_ty_count: 0,
                block_start: 0,
                block_count: 0
            },
        };
        flow.function(
            inout types,
            inout names,
            in world,
            in program,
            func,
            inout pool,
            inout state,
            inout edge,
            inout next,
            inout old
        );
    }
    let mut seen: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut hash: u64 = 14695981039346656037;
    let mut kept: u64 = 0;
    for i in 0..flow.diags.len() {
        let row = flow.diags.row(i);
        let row_key = flow.diags.fold_range(
            flow.diags.fold_range(
                fold(fold(14695981039346656037, row.start), row.stop),
                row.code_a,
                row.msg_a
            ),
            row.msg_a,
            row.msg_b
        );
        let mut dup = false;
        for j in 0..seen.len() {
            if u64_at(in seen, j) == row_key {
                dup = true;
            }
        }
        if !dup {
            seen.push(row_key);
            kept = inc(kept);
            hash = flow.diags.digest_row(hash, i);
        }
    }
    fold(hash, kept)
}

// ----- entries ----------------------------------------------------------------

// `validate`: evidence, then each function's flow, into `flow.diags`; returns the
// rows kept after removing duplicates of (code, span, message), first kept.
pub fn validate_into(
    inout types: Types,
    inout names: Names,
    in world: World,
    in program: Program,
    inout flow: Flow,
    inout pool: Pool,
    inout state: State,
    inout edge: State,
    inout next: State,
    inout old: State
) -> ChunkSeq[u64] {
    flow.diags.clear();
    evidence(in program, inout flow.diags);
    for fi in 0..program.fns.len() {
        let func = match program.fns.try_get(fi) {
            Option::Some(func) => func,
            Option::None => FnRow {
                param_start: 0,
                param_count: 0,
                bound_start: 0,
                bound_count: 0,
                capture_start: 0,
                capture_count: 0,
                value_ty_start: 0,
                value_ty_count: 0,
                block_start: 0,
                block_count: 0
            },
        };
        flow.function(
            inout types,
            inout names,
            in world,
            in program,
            func,
            inout pool,
            inout state,
            inout edge,
            inout next,
            inout old
        );
    }
    let mut seen: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut kept: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for i in 0..flow.diags.len() {
        let row = flow.diags.row(i);
        let row_key = flow.diags.fold_range(
            flow.diags.fold_range(
                fold(fold(14695981039346656037, row.start), row.stop),
                row.code_a,
                row.msg_a
            ),
            row.msg_a,
            row.msg_b
        );
        let mut dup = false;
        for j in 0..seen.len() {
            if u64_at(in seen, j) == row_key && same_key(in flow.diags, u64_at(in kept, j), i) {
                dup = true;
            }
        }
        if !dup {
            seen.push(row_key);
            kept.push(i);
        }
    }
    kept
}

// Rows `i` and `j` have the same code, span and message (the digest above
// only narrows the candidates).
fn same_key(in diags: Diags, i: u64, j: u64) -> bool {
    let first_row = diags.row(i);
    let second_row = diags.row(j);
    first_row.start == second_row.start
        && first_row.stop == second_row.stop
        && same_range(
            in diags,
            first_row.code_a,
            first_row.msg_a,
            second_row.code_a,
            second_row.msg_a
        )
        && same_range(
            in diags,
            first_row.msg_a,
            first_row.msg_b,
            second_row.msg_a,
            second_row.msg_b
        )
}

fn same_range(in diags: Diags, a0: u64, a1: u64, b0: u64, b1: u64) -> bool {
    if wrapping_sub(a1, a0) != wrapping_sub(b1, b0) {
        return false;
    }
    for i in 0..wrapping_sub(a1, a0) {
        if u8_at(in diags.text, add(a0, i)) != u8_at(in diags.text, add(b0, i)) {
            return false;
        }
    }
    true
}

// Bytes `a..b` of `text` after their length, eight per word, little-endian.
fn put_range(inout out: ChunkSeq[u64], in text: ChunkSeq[u8], a: u64, b: u64) {
    out.push(wrapping_sub(b, a));
    let mut acc: u64 = 0;
    let mut filled: u32 = 0;
    for i in a..b {
        acc = acc | wrapping_shl_u64(widen_u64(u8_at(in text, i)), wrapping_mul(filled, 8));
        filled = wrapping_add(filled, 1);
        if filled == 8 {
            out.push(acc);
            acc = 0;
            filled = 0;
        }
    }
    if filled != 0 {
        out.push(acc);
    }
}

fn rel_at(in diags: Diags, i: u64) -> RelRow {
    match diags.rel.try_get(i) {
        Option::Some(label) => label,
        Option::None => RelRow { a: 0, b: 0, start: 0, stop: 0 },
    }
}

// The kept diagnostics as words: a count, then per diagnostic its code,
// message, start, end, help (empty for none) and related labels (count,
// then start, end and message each).
fn put_diags(in diags: Diags, in kept: ChunkSeq[u64], inout out: ChunkSeq[u64]) {
    out.push(kept.len());
    for k in 0..kept.len() {
        let row = diags.row(u64_at(in kept, k));
        put_range(inout out, in diags.text, row.code_a, row.msg_a);
        put_range(inout out, in diags.text, row.msg_a, row.msg_b);
        out.push(row.start);
        out.push(row.stop);
        put_range(inout out, in diags.text, row.help_a, row.end);
        out.push(w(row.rn));
        for j in 0..w(row.rn) {
            let label = rel_at(in diags, add(w(row.ra), j));
            out.push(label.start);
            out.push(label.stop);
            put_range(inout out, in diags.text, label.a, label.b);
        }
    }
}

// The hybrid task: the world and the program; the diagnostics as words.
pub fn ir_check_words(in input: Slice[u8]) -> ChunkSeq[u64] {
    let mut reader = Reader { pos: 0 };
    let mut ctx = read_ctx(inout reader, in input);
    ir_check_task(inout reader, in input, inout ctx)
}

// The program part of `ir_check_words` over a context already read, `reader` at
// the name ranks (the hybrid's encode-once input, SH4 lane 2, #1276).
pub fn ir_check_task(inout reader: Reader, in input: Slice[u8], inout ctx: Ctx) -> ChunkSeq[u64] {
    let program = read_program(inout reader, in input, in ctx.names, in ctx.nmap, in ctx.tmap);
    let mut flow = flow_new();
    let mut pool = pool_new();
    let mut state = state_new();
    let mut edge = state_new();
    let mut next = state_new();
    let mut old = state_new();
    let kept = validate_into(
        inout ctx.types,
        inout ctx.names,
        in ctx.world,
        in program,
        inout flow,
        inout pool,
        inout state,
        inout edge,
        inout next,
        inout old
    );
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    put_diags(in flow.diags, in kept, inout out);
    out
}

// One part of an input that arrives in parts (self-hosting SH4 lane 2,
// #1276): `extend_ctx` adds the part's names, types, ADTs and effects to
// `ctx`, then the IR check of the part's program, as `ir_check_words` writes
// it.
pub fn ir_check_part(inout ctx: Ctx, in part: Slice[u8]) -> ChunkSeq[u64] {
    let mut reader = Reader { pos: 0 };
    extend_ctx(inout reader, in part, inout ctx);
    ir_check_task(inout reader, in part, inout ctx)
}

// The harness entry of `ir_check_part` (tests/self_host_swap_inputs.rs): a
// count, then each part as a byte length and its bytes padded to words;
// returns each part's answer as a word count and the words.
pub fn check_ir_parts(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mut reader = Reader { pos: 0 };
    let mut ctx = ctx_new();
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let n = reader.word(in bytes);
    for i in 0..n {
        let len = reader.word(in bytes);
        let start = reader.pos;
        let answer = ir_check_part(inout ctx, in bytes[start..wrapping_add(start, len)]);
        out.push(answer.len());
        for j in 0..answer.len() {
            out.push(u64_at(in answer, j));
        }
        reader.pos = wrapping_add(start, wrapping_mul(wrapping_add(len, 7) / 8, 8));
    }
    out
}

// `ir_check_words` from the harness's `Str` input.
pub fn check_ir_words(in input: Str) -> ChunkSeq[u64] {
    ir_check_words(in input.as_bytes())
}

fn put_text(inout out: ChunkSeq[u8], in text: ChunkSeq[u8], a: u64, b: u64) {
    for i in a..b {
        out.push(u8_at(in text, i));
    }
}

// The diagnostics as text, one line each, the format of `rust_text` in
// tests/hybrid_ir_check.rs: `code start-end message`, then each related
// label as ` [start-end message]`, then ` help: text` when there is help.
pub fn check_ir_text(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mut reader = Reader { pos: 0 };
    let mut ctx = read_ctx(inout reader, in bytes);
    let program = read_program(inout reader, in bytes, in ctx.names, in ctx.nmap, in ctx.tmap);
    let mut flow = flow_new();
    let mut pool = pool_new();
    let mut state = state_new();
    let mut edge = state_new();
    let mut next = state_new();
    let mut old = state_new();
    let kept = validate_into(
        inout ctx.types,
        inout ctx.names,
        in ctx.world,
        in program,
        inout flow,
        inout pool,
        inout state,
        inout edge,
        inout next,
        inout old
    );
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for k in 0..kept.len() {
        let row = flow.diags.row(u64_at(in kept, k));
        put_text(inout out, in flow.diags.text, row.code_a, row.msg_a);
        out.push(32);
        push_decimal(inout out, row.start);
        out.push(45);
        push_decimal(inout out, row.stop);
        out.push(32);
        put_text(inout out, in flow.diags.text, row.msg_a, row.msg_b);
        for j in 0..w(row.rn) {
            let label = rel_at(in flow.diags, add(w(row.ra), j));
            out.extend(in " [".as_bytes());
            push_decimal(inout out, label.start);
            out.push(45);
            push_decimal(inout out, label.stop);
            out.push(32);
            put_text(inout out, in flow.diags.text, label.a, label.b);
            out.push(93);
        }
        if row.end > row.help_a {
            out.extend(in " help: ".as_bytes());
            put_text(inout out, in flow.diags.text, row.help_a, row.end);
        }
        out.push(10);
    }
    pack_text(in out)
}
