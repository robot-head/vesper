// The integer semantics of the evaluator (`vesper.arith.checked/1`, the
// `IntegerKind` methods of vesper-core's numeric.rs and `binary`, `unary`
// and `bitwise` of src/runtime.rs and src/capability_effects.rs) for the
// 64-bit kinds and narrower.
//
// A value of an integer kind is its bit pattern in one word: sign-extended for the
// signed kinds, zero-extended for the unsigned ones. `exact` reads it as
// the `i128` the Rust evaluator computes with; `pattern_of` writes an in-range
// `i128` back.

// Value kinds (`Value::Int`, `UInt(_, w)`, `SInt(_, w)`). `usize` is a
// `u64` and `isize` an `i64` here, as in `value_kind`.
pub const K_I64: u8 = 0;
pub const K_U8: u8 = 1;
pub const K_U16: u8 = 2;
pub const K_U32: u8 = 3;
pub const K_U64: u8 = 4;
pub const K_I8: u8 = 5;
pub const K_I16: u8 = 6;
pub const K_I32: u8 = 7;

// Failures (`ArithFailure`).
pub const F_OK: u8 = 0;
pub const F_OVERFLOW: u8 = 1;
pub const F_DIV_ZERO: u8 = 2;
// An evaluator error (`Fault::Error`): the message is the caller's.
pub const F_ERROR: u8 = 3;

pub fn is_signed(kind: u8) -> bool {
    kind == K_I64 || kind == K_I8 || kind == K_I16 || kind == K_I32
}

pub fn bits(kind: u8) -> u64 {
    if kind == K_U8 || kind == K_I8 {
        8
    } else if kind == K_U16 || kind == K_I16 {
        16
    } else if kind == K_U32 || kind == K_I32 {
        32
    } else {
        64
    }
}

// The mask of the kind's bits in a word.
pub fn mask(kind: u8) -> u64 {
    let width = bits(kind);
    if width >= 64 {
        18446744073709551615
    } else {
        wrapping_sub(wrapping_shl_u64(1, wrapping_u32(width)), 1)
    }
}

pub fn min_of(kind: u8) -> i128 {
    if is_signed(kind) {
        let sign_bit: i128 = wrapping_shl_i128_1(wrapping_sub(bits(kind), 1));
        wrapping_sub(0, sign_bit)
    } else {
        0
    }
}

pub fn max_of(kind: u8) -> i128 {
    if is_signed(kind) {
        let sign_bit: i128 = wrapping_shl_i128_1(wrapping_sub(bits(kind), 1));
        wrapping_sub(sign_bit, 1)
    } else {
        widen_i128(mask(kind))
    }
}

// 2^n for n < 127.
fn wrapping_shl_i128_1(n: u64) -> i128 {
    let mut power: i128 = 1;
    for i in 0..n {
        power = wrapping_add(power, power);
    }
    power
}

pub fn fits(kind: u8, value: i128) -> bool {
    value >= min_of(kind) && value <= max_of(kind)
}

// The exact value of `pattern`, a bit pattern of kind `kind`.
pub fn exact(kind: u8, pattern: u64) -> i128 {
    if is_signed(kind) {
        widen_i128(wrapping_i64(pattern))
    } else {
        widen_i128(pattern)
    }
}

// `IntegerKind::wrap`: `n` modulo 2^bits, read in the kind, as a pattern.
pub fn wrap(kind: u8, n: i128) -> u64 {
    let pattern = wrapping_u64(n) & mask(kind);
    if is_signed(kind) && bits(kind) < 64 {
        let sign_bit = wrapping_shl_u64(1, wrapping_u32(wrapping_sub(bits(kind), 1)));
        if pattern & sign_bit != 0 {
            return pattern | (mask(kind) ^ 18446744073709551615);
        }
    }
    pattern
}

// The pattern of an in-range exact value.
pub fn pattern_of(kind: u8, value: i128) -> u64 {
    wrap(kind, value)
}

fn udiv(a: u64, b: u64) -> u64 {
    handle Fail[RuntimeError] in {
        a / b
    } with {
        return value => value,
        raise(e, resume) => 0,
    }
}

fn urem(a: u64, b: u64) -> u64 {
    handle Fail[RuntimeError] in {
        a % b
    } with {
        return value => value,
        raise(e, resume) => 0,
    }
}

fn sdiv(a: i64, b: i64) -> i64 {
    handle Fail[RuntimeError] in {
        handle Fail[ArithOverflow] in {
            a / b
        } with {
            return value => value,
            raise(e, resume) => 0,
        }
    } with {
        return value => value,
        raise(e, resume) => 0,
    }
}

fn srem(a: i64, b: i64) -> i64 {
    handle Fail[RuntimeError] in {
        handle Fail[ArithOverflow] in {
            a % b
        } with {
            return value => value,
            raise(e, resume) => 0,
        }
    } with {
        return value => value,
        raise(e, resume) => 0,
    }
}

// Binary operator codes (`OP_*`), assigned to operator names at load.
pub const B_ADD: u8 = 1;
pub const B_SUB: u8 = 2;
pub const B_MUL: u8 = 3;
pub const B_DIV: u8 = 4;
pub const B_REM: u8 = 5;
pub const B_AND: u8 = 6;
pub const B_OR: u8 = 7;
pub const B_XOR: u8 = 8;
pub const B_SHL: u8 = 9;
pub const B_SHR: u8 = 10;
pub const B_EQ: u8 = 11;
pub const B_NE: u8 = 12;
pub const B_LT: u8 = 13;
pub const B_LE: u8 = 14;
pub const B_GT: u8 = 15;
pub const B_GE: u8 = 16;
pub const B_LAND: u8 = 17;
pub const B_LOR: u8 = 18;
pub const B_WADD: u8 = 19;
pub const B_WSUB: u8 = 20;
pub const B_WMUL: u8 = 21;
pub const B_ROTL: u8 = 22;
pub const B_ROTR: u8 = 23;
pub const B_BAND: u8 = 24;
pub const B_BOR: u8 = 25;
pub const B_BXOR: u8 = 26;
pub const B_BSHL: u8 = 27;
pub const B_BSHR: u8 = 28;

// `IntegerKind::checked` on in-range operands `lhs`, `rhs` of kind `kind`
// (`+ - * / %`); the failure code in `failure`.
pub fn checked(kind: u8, op: u8, lhs: i128, rhs: i128, inout failure: u8) -> i128 {
    let mut result: i128 = 0;
    if op == B_ADD {
        result = wrapping_add(lhs, rhs);
    } else if op == B_SUB {
        result = wrapping_sub(lhs, rhs);
    } else if op == B_MUL {
        // u64 x u64 may pass i128; such a product never fits 64 bits.
        let big: i128 = 4294967296;
        if !is_signed(kind) && lhs >= big && rhs >= big {
            failure = F_OVERFLOW;
            return 0;
        }
        result = wrapping_mul(lhs, rhs);
    } else if op == B_DIV || op == B_REM {
        if rhs == 0 {
            failure = F_DIV_ZERO;
            return 0;
        }
        if is_signed(kind) {
            let lhs_word = wrapping_i64(lhs);
            let rhs_word = wrapping_i64(rhs);
            if rhs_word == -1 {
                if op == B_REM {
                    return 0;
                }
                result = wrapping_sub(0, lhs);
            } else if op == B_DIV {
                result = widen_i128(sdiv(lhs_word, rhs_word));
            } else {
                result = widen_i128(srem(lhs_word, rhs_word));
            }
        } else {
            let lhs_word = wrapping_u64(lhs);
            let rhs_word = wrapping_u64(rhs);
            if op == B_DIV {
                result = widen_i128(udiv(lhs_word, rhs_word));
            } else {
                result = widen_i128(urem(lhs_word, rhs_word));
            }
        }
    } else {
        failure = F_OVERFLOW;
        return 0;
    }
    if fits(kind, result) {
        result
    } else {
        failure = F_OVERFLOW;
        0
    }
}

// `IntegerKind::wrapping`.
pub fn wrapping(kind: u8, op: u8, lhs: i128, rhs: i128) -> i128 {
    let result = if op == B_WADD {
        wrapping_add(lhs, rhs)
    } else if op == B_WSUB {
        wrapping_sub(lhs, rhs)
    } else {
        wrapping_mul(lhs, rhs)
    };
    exact(kind, wrap(kind, result))
}

// `IntegerKind::bit` (`& | ^`).
pub fn bit(kind: u8, op: u8, lhs: i128, rhs: i128) -> i128 {
    let lhs_bits = wrapping_u64(lhs) & mask(kind);
    let rhs_bits = wrapping_u64(rhs) & mask(kind);
    let pattern = if op == B_AND || op == B_BAND {
        lhs_bits & rhs_bits
    } else if op == B_OR || op == B_BOR {
        lhs_bits | rhs_bits
    } else {
        lhs_bits ^ rhs_bits
    };
    exact(kind, wrap(kind, widen_i128(pattern)))
}

// `IntegerKind::not`.
pub fn not(kind: u8, operand: i128) -> i128 {
    let pattern = (wrapping_u64(operand) & mask(kind)) ^ mask(kind);
    exact(kind, wrap(kind, widen_i128(pattern)))
}

// `IntegerKind::shift`: the amount must be in `0..bits`.
pub fn shift(kind: u8, op: u8, operand: i128, amount: i128, inout failure: u8) -> i128 {
    let width: i128 = widen_i128(bits(kind));
    if amount < 0 || amount >= width {
        failure = F_OVERFLOW;
        return 0;
    }
    let shift_by = wrapping_u32(wrapping_u64(amount));
    let pattern = wrapping_u64(operand) & mask(kind);
    if op == B_SHL {
        exact(kind, wrap(kind, widen_i128(wrapping_shl_u64(pattern, shift_by))))
    } else if !is_signed(kind) {
        widen_i128(wrapping_shr_u64(pattern, shift_by))
    } else {
        widen_i128(wrapping_shr_i64(wrapping_i64(operand), shift_by))
    }
}

// `x >> n` on an i64 (arithmetic), n < 64.
fn wrapping_shr_i64(x: i64, n: u32) -> i64 {
    let all_ones: u64 = 18446744073709551615;
    if x >= 0 {
        wrapping_i64(wrapping_shr_u64(wrapping_u64(x), n))
    } else {
        wrapping_i64(wrapping_shr_u64(wrapping_u64(x) ^ all_ones, n) ^ all_ones)
    }
}

// `IntegerKind::rotate`: the amount modulo the width.
pub fn rotate(kind: u8, left: bool, operand: i128, amount: i128) -> i128 {
    let width = bits(kind);
    // rem_euclid: the amount is a 64-bit kind's value.
    let amount_mod = if amount >= 0 {
        urem(wrapping_u64(amount), width)
    } else {
        let neg_rem = urem(wrapping_u64(wrapping_sub(0, amount)), width);
        if neg_rem == 0 {
            0
        } else {
            wrapping_sub(width, neg_rem)
        }
    };
    let left_by = if left {
        amount_mod
    } else {
        urem(wrapping_sub(width, amount_mod), width)
    };
    let pattern = wrapping_u64(operand) & mask(kind);
    let rotated = if left_by == 0 {
        pattern
    } else {
        (
            wrapping_shl_u64(pattern, wrapping_u32(left_by))
                | wrapping_shr_u64(pattern, wrapping_u32(wrapping_sub(width, left_by)))
        )
            & mask(kind)
    };
    exact(kind, wrap(kind, widen_i128(rotated)))
}

// `capability_effects::bitwise` (`bit_and` ... `bit_shr`): the amount is
// taken modulo the width.
pub fn bitwise(kind: u8, op: u8, lhs: i128, rhs: i128) -> i128 {
    let width = bits(kind);
    let amount = wrapping_u32(urem(wrapping_u64(rhs), width));
    let lhs_bits = wrapping_u64(lhs) & mask(kind);
    let rhs_bits = wrapping_u64(rhs) & mask(kind);
    let result: i128 = if op == B_BAND {
        widen_i128(lhs_bits & rhs_bits)
    } else if op == B_BOR {
        widen_i128(lhs_bits | rhs_bits)
    } else if op == B_BXOR {
        widen_i128(lhs_bits ^ rhs_bits)
    } else if op == B_BSHL {
        widen_i128(wrapping_shl_u64(lhs_bits, amount) & mask(kind))
    } else if !is_signed(kind) {
        widen_i128(wrapping_shr_u64(lhs_bits, amount))
    } else {
        widen_i128(wrapping_shr_i64(wrapping_i64(lhs), amount))
    };
    exact(kind, wrap(kind, result))
}
