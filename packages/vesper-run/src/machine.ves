// The core machine of `Runtime::drive` over Place IR (slice 1 of #2053).
//
// Values are two words (`Val`): a tag and a payload. Integers carry their
// kind in the tag (arith.ves); tuples and data point at a row of `heap`,
// whose children are `kids[kid_start..kid_start+kid_count]` (and, for data,
// the field names at the same indices of `kid_names`). Values never change
// once made, so a Rust `clone` is a copy here, and assigning through a place
// rebuilds the aggregates along its path (`put_path`), as Rust's `slot_set`
// changes a clone.
//
// An activation (`IrState`) is a frame `Fr` over four stacks: its IR values
// `vals[val_base..]` (one per value id of its function), its environment
// `env[env_base..]` (name, cell, path; the latest binding of a name wins, as
// a `BTreeMap` insert), the cells its bindings own `cells[cell_base..]` and
// the path segments of its `inout` slots `segs[seg_base..]`. Without
// closures and handlers nothing outlives its activation but the returned
// value, so a return truncates all four.

use @vesper/check-data::util::{add, inc, n32, push_decimal, u32_at, u64_at, u8_at, w};
use @vesper/check-data::names::{Names};
use @vesper/check-data::types::{TyKind, Types};
use @vesper/check-data::world::{constructor};
use @vesper/check-data::input::{Ctx, Reader};
use @vesper/place-ir::codes::{Lit, Op, Pat, Term};
use @vesper/place-ir::{BlockRow, FnRow, InstRow, Program};
use @vesper/serde::dragon::{Shortest, put_shortest, shortest, shortest_f32, shortest_len};
use self::arith::{
    B_ADD, B_AND, B_BAND, B_BOR, B_BSHL, B_BSHR, B_BXOR, B_DIV, B_EQ, B_GE, B_GT, B_LAND, B_LE,
    B_LOR, B_LT, B_MUL, B_NE, B_OR, B_REM, B_ROTL, B_ROTR, B_SHL, B_SHR, B_SUB, B_WADD, B_WMUL,
    B_WSUB, B_XOR, F_OK, F_OVERFLOW, K_I16, K_I32, K_I64, K_I8, K_U16, K_U32, K_U64, K_U8, bit,
    bitwise, checked, exact, fits, is_signed, not, rotate, shift, wrap, wrapping
};

const NONE32: u32 = 4294967295;
const NONE64: u64 = 18446744073709551615;

// Value tags beyond the integer kinds 0..=7.
pub const T_BOOL: u8 = 8;
pub const T_STR: u8 = 9;
pub const T_TUPLE: u8 = 10;
pub const T_DATA: u8 = 11;
pub const T_FN: u8 = 12;
// A handler clause's continuation (`Value::Continuation`): its `conts`
// index, with its serial in the high half.
pub const T_CONT: u8 = 13;
// A `ChunkSeq` (`Value::Seq`): its `seqs` index; a `Slice` view: its
// `slices` index.
pub const T_SEQ: u8 = 14;
pub const T_SLICE: u8 = 15;
// A closure (`Value::Closure`): its `closures` index.
pub const T_CLOS: u8 = 16;
// A function value with bound evidence (`Value::Bound`): its `bounds` index.
pub const T_BOUND: u8 = 17;
// `Value::Float` and `Value::Float32`: the bit pattern (an `f32`'s in the
// low half).
pub const T_F64: u8 = 18;
pub const T_F32: u8 = 19;
pub const T_UNDEF: u8 = 255;

// Unary codes; a conversion is U_CONV + family * CONV_STRIDE + target kind.
const U_NEG: u64 = 1;
const U_NOT: u64 = 2;
const U_INV: u64 = 3;
const U_CONV: u64 = 16;
// The codes of one conversion family: one per integer kind.
const CONV_STRIDE: u64 = 16;
const C_WIDEN: u64 = 0;
const C_NARROW: u64 = 1;
const C_WRAPPING: u64 = 2;
// A float intrinsic is U_FLOAT + operation * 2 + float kind.
const U_FLOAT: u64 = 128;
const FC_WIDEN: u64 = 0;
const FC_NEAREST: u64 = 1;
const FC_TO_BITS: u64 = 2;
const FC_FROM_BITS: u64 = 3;
const FK_F32: u64 = 0;
const FK_F64: u64 = 1;
const FLOAT_KINDS: u64 = 2;
// The sign bits of a binary64 and a binary32, which `-x` flips.
const F64_SIGN: u64 = 9223372036854775808;
const F32_SIGN: u64 = 2147483648;
// The exponent bits of a binary64 and a binary32: all ones is a NaN or an
// infinity (an infinity when the fraction is zero).
const F64_EXPONENT: u64 = 9218868437227405312;
const F64_FRACTION: u64 = 4503599627370495;
const F32_EXPONENT: u64 = 2139095040;
const F32_FRACTION: u64 = 8388607;
// The bits of a binary32 (`f32::from_bits` of the low half).
const F32_BITS: u64 = 4294967295;

// Frame kinds (`Frame::IrResume`, `Frame::Try`).
const FR_IR: u8 = 0;
const FR_TRY: u8 = 1;
// `Frame::Handler`: `func_index` is its effect-table site, `block` and `ip`
// the start and count of its captured environment in `hcap_*` (a state
// handler's state follows it), `ty` HANDLER_STATE for a state, the bases
// the arena lengths when it was installed.
const FR_HANDLER: u8 = 2;
const HANDLER_STATE: u32 = 1;
// `Frame::Coerce`: the returned value takes type `ty`.
const FR_COERCE: u8 = 3;
// Evidence a bound callable or closure carries into its call
// (`evidence_environment(caller)` extended by its own): `block` and `ip`
// the start and count of its entries in `evs`. Free to pop.
const FR_EVIDENCE: u8 = 4;

// What `drive` holds (`Control::Ir`, `Control::Return`).
const C_IR: u8 = 0;
const C_RET: u8 = 1;
// `Control::Eval` of the handler expression of instruction `pending`.
const C_INSTALL: u8 = 2;

// Primitive failures (`Failure`).
const P_OVERFLOW: u8 = 1;
const P_DIV_ZERO: u8 = 2;
const P_INDEX: u8 = 4;

// Effect-table site kinds (run_words.rs `sites`).
const SITE_HANDLE: u64 = 1;
const SITE_EFFECT_CALL: u64 = 2;
const SITE_TRY: u64 = 3;
const SITE_CLOSURE: u64 = 4;

// A type's integer kind is not known yet / it has none.
const TK_UNSEEN: u8 = 254;
const TK_NONE: u8 = 255;

pub copy struct Val {
    tag: u8,
    payload: u64,
}

copy struct Agg {
    ctor: u32,
    kid_start: u64,
    kid_count: u64,
}

copy struct Fr {
    func_index: u64,
    block: u64,
    ip: u64,
    val_base: u64,
    env_base: u64,
    cell_base: u64,
    seg_base: u64,
    dest: u32,
    ty: u32,
    kind: u8,
    // A handler's identity (`Handler::id`), 0 for other frames.
    serial: u64,
}

copy struct En {
    name: u32,
    cell: u64,
    seg_start: u64,
    seg_count: u64,
}

// A function: its parameters `params[param_start..param_start+param_count]`,
// its value count, its first block and whether `scan` reached it.
copy struct Fi {
    name: u32,
    param_start: u64,
    param_count: u64,
    value_count: u64,
    first_block: u64,
    reached: bool,
}

copy struct Pm {
    name: u32,
    pass: u64,
    ty: u32,
}

// A `Write` place split at its dots: root, segments
// `write_segs[seg_start..seg_start+seg_count]` and the compound operator's
// code (0 for `=`).
copy struct Wr {
    root: u32,
    seg_start: u64,
    seg_count: u64,
    code: u64,
}

// An evidence entry: handler `serial` (installed at effect-table site
// `site`) for every key it provides, or for `$effect:<effect>` only.
copy struct Ev {
    serial: u64,
    site: u64,
    effect: u32,
}
const EV_ALL_KEYS: u32 = 4294967295;

// A bound function value: function `callee` and its evidence.
copy struct Bd {
    callee: u32,
    ev_start: u64,
    ev_count: u64,
}

// A closure: its effect-table site and captures
// `clos_*[cap_start..cap_start + cap_count]`.
copy struct Cl {
    site: u64,
    cap_start: u64,
    cap_count: u64,
    // its evidence `evs[ev_start..ev_start + ev_count]`
    ev_start: u64,
    ev_count: u64,
}

// A sequence: its elements `seq_items[at..at + len]`, with room for `cap`.
copy struct Sq {
    at: u64,
    len: u64,
    cap: u64,
}

// A slice: elements `start..start + len` of sequence `seq`.
copy struct Sl {
    seq: u64,
    start: u64,
    len: u64,
}

// A string (`Value::String`, also a view): bytes `str_bytes[at..at + len]`,
// never changed (an update makes a new string).
copy struct Sr {
    at: u64,
    len: u64,
}

// A captured continuation (`Continuation`): the frames from its handler
// up, and the arena entries above the handler's levels, in the `k_*`
// stores at `*_start`; the levels when it was captured; the handler's
// stack index and the frame below it; its serial.
copy struct Kt {
    frame_start: u64,
    val_start: u64,
    env_start: u64,
    cell_start: u64,
    seg_start: u64,
    hcap_start: u64,
    val_base: u64,
    env_base: u64,
    cell_base: u64,
    seg_base: u64,
    hcap_base: u64,
    depth: u64,
    below: Fr,
    serial: u64,
    taken: bool,
}

pub struct M {
    ctx: Ctx,
    program: Program,
    fuel: u64,
    entry: u64,
    fns: ChunkSeq[Fi],
    params: ChunkSeq[Pm],
    // symbol -> function index + 1
    fn_of: ChunkSeq[u32],
    // per instruction: its operator code, callee, constructor or `Write` row
    aux: ChunkSeq[u64],
    writes: ChunkSeq[Wr],
    write_segs: ChunkSeq[u32],
    // per block: the operand index of its parameter count
    block_params: ChunkSeq[u64],
    // per type id: its integer kind, TK_NONE, or TK_UNSEEN
    type_kinds: ChunkSeq[u8],
    // per symbol: the symbol of its last `::` segment + 1, or 0 unseen
    short_syms: ChunkSeq[u32],
    vals: ChunkSeq[Val],
    env: ChunkSeq[En],
    cells: ChunkSeq[Val],
    segs: ChunkSeq[u32],
    heap: ChunkSeq[Agg],
    kids: ChunkSeq[Val],
    kid_names: ChunkSeq[u32],
    stack: ChunkSeq[Fr],
    frame: Fr,
    ret_value: Val,
    control: u8,
    // scratch: a slot path being read or written, call arguments
    path: ChunkSeq[u32],
    arg_vals: ChunkSeq[Val],
    arg_roots: ChunkSeq[u64],
    arg_paths: ChunkSeq[u64],
    failed: bool,
    declined: bool,
    message: ChunkSeq[u8],
    // The effect table: its words (names as symbols), and per instruction
    // its site's offset + 1 or 0.
    sites: ChunkSeq[u64],
    site_of: ChunkSeq[u64],
    // The `Fail` instance keys of the primitive failures (symbol + 1, or 0).
    key_overflow: u64,
    key_runtime: u64,
    // The instruction of a `C_INSTALL`.
    pending: u64,
    // Handlers' captured environments (`handler_environment`).
    hcap_names: ChunkSeq[u32],
    hcap_vals: ChunkSeq[Val],
    // Per function: the continuation parameter's name + 1 of an operation
    // clause (whose type `scan` lets through), or 0.
    cont_names: ChunkSeq[u32],
    // Captured continuations and what they hold.
    conts: ChunkSeq[Kt],
    k_frames: ChunkSeq[Fr],
    k_vals: ChunkSeq[Val],
    k_env: ChunkSeq[En],
    k_cells: ChunkSeq[Val],
    k_segs: ChunkSeq[u32],
    k_hnames: ChunkSeq[u32],
    k_hvals: ChunkSeq[Val],
    k_serial: u64,
    // Closures (site, captures) and their captured environments.
    closures: ChunkSeq[Cl],
    clos_names: ChunkSeq[u32],
    clos_vals: ChunkSeq[Val],
    // Evidence entries, bound function values and the last handler serial.
    evs: ChunkSeq[Ev],
    bounds: ChunkSeq[Bd],
    h_serial: u64,
    // Sequences, their elements and slice views.
    seqs: ChunkSeq[Sq],
    seq_items: ChunkSeq[Val],
    slices: ChunkSeq[Sl],
    // Strings and their bytes; per literal symbol its string + 1, or 0.
    strs: ChunkSeq[Sr],
    str_bytes: ChunkSeq[u8],
    lit_strs: ChunkSeq[u64],
    some_sym: u32,
    none_sym: u32,
    fail_sym: u32,
    raise_sym: u32,
    overflow_sym: u32,
    div_zero_sym: u32,
    index_sym: u32,
    // well-known symbols
    ok_sym: u32,
    err_sym: u32,
    zero_sym: u32,
    dot_sym: u32,
}

fn fr_zero() -> Fr {
    Fr {
        func_index: 0,
        block: 0,
        ip: 0,
        val_base: 0,
        env_base: 0,
        cell_base: 0,
        seg_base: 0,
        dest: 0,
        ty: 0,
        kind: FR_IR,
        serial: 0
    }
}

fn undef() -> Val {
    Val { tag: T_UNDEF, payload: 0 }
}

fn unit() -> Val {
    Val { tag: T_TUPLE, payload: NONE64 }
}

pub fn machine_new(sink ctx: Ctx, sink program: Program, fuel: u64) -> M {
    M {
        ctx: ctx,
        program: program,
        fuel: fuel,
        entry: NONE64,
        fns: ChunkSeq::new[Fi](),
        params: ChunkSeq::new[Pm](),
        fn_of: ChunkSeq::new[u32](),
        aux: ChunkSeq::new[u64](),
        writes: ChunkSeq::new[Wr](),
        write_segs: ChunkSeq::new[u32](),
        block_params: ChunkSeq::new[u64](),
        type_kinds: ChunkSeq::new[u8](),
        short_syms: ChunkSeq::new[u32](),
        vals: ChunkSeq::new[Val](),
        env: ChunkSeq::new[En](),
        cells: ChunkSeq::new[Val](),
        segs: ChunkSeq::new[u32](),
        heap: ChunkSeq::new[Agg](),
        kids: ChunkSeq::new[Val](),
        kid_names: ChunkSeq::new[u32](),
        stack: ChunkSeq::new[Fr](),
        frame: fr_zero(),
        ret_value: unit(),
        control: C_IR,
        path: ChunkSeq::new[u32](),
        arg_vals: ChunkSeq::new[Val](),
        arg_roots: ChunkSeq::new[u64](),
        arg_paths: ChunkSeq::new[u64](),
        failed: false,
        declined: false,
        message: ChunkSeq::new[u8](),
        sites: ChunkSeq::new[u64](),
        site_of: ChunkSeq::new[u64](),
        key_overflow: 0,
        key_runtime: 0,
        pending: 0,
        hcap_names: ChunkSeq::new[u32](),
        hcap_vals: ChunkSeq::new[Val](),
        cont_names: ChunkSeq::new[u32](),
        conts: ChunkSeq::new[Kt](),
        k_frames: ChunkSeq::new[Fr](),
        k_vals: ChunkSeq::new[Val](),
        k_env: ChunkSeq::new[En](),
        k_cells: ChunkSeq::new[Val](),
        k_segs: ChunkSeq::new[u32](),
        k_hnames: ChunkSeq::new[u32](),
        k_hvals: ChunkSeq::new[Val](),
        k_serial: 0,
        closures: ChunkSeq::new[Cl](),
        clos_names: ChunkSeq::new[u32](),
        clos_vals: ChunkSeq::new[Val](),
        evs: ChunkSeq::new[Ev](),
        bounds: ChunkSeq::new[Bd](),
        h_serial: 0,
        seqs: ChunkSeq::new[Sq](),
        seq_items: ChunkSeq::new[Val](),
        slices: ChunkSeq::new[Sl](),
        strs: ChunkSeq::new[Sr](),
        str_bytes: ChunkSeq::new[u8](),
        lit_strs: ChunkSeq::new[u64](),
        some_sym: 0,
        none_sym: 0,
        fail_sym: 0,
        raise_sym: 0,
        overflow_sym: 0,
        div_zero_sym: 0,
        index_sym: 0,
        ok_sym: 0,
        err_sym: 0,
        zero_sym: 0,
        dot_sym: 0,
    }
}

// ----- text --------------------------------------------------------------------

fn put(inout out: ChunkSeq[u8], in text: Str) {
    out.extend(in text.as_bytes());
}

fn put_sym(inout out: ChunkSeq[u8], in names: Names, sym: u32) {
    let text_start = names.start(sym);
    let text_end = names.end(sym);
    for i in text_start..text_end {
        out.push(u8_at(in names.text, i));
    }
}

fn put_signed(inout out: ChunkSeq[u8], value: i64) {
    if value < 0 {
        out.push(45);
        push_decimal(inout out, wrapping_u64(wrapping_sub(0, value)));
    } else {
        push_decimal(inout out, wrapping_u64(value));
    }
}

fn fail(inout machine: M, in text: Str) {
    if !machine.failed {
        machine.failed = true;
        machine.message.clear();
        put(inout machine.message, text);
    }
}

// `"<prefix>'<sym>'<suffix>"`, as Rust's `format!("{prefix}'{sym}'{suffix}")`.
fn fail_sym(inout machine: M, in prefix: Str, sym: u32, in suffix: Str) {
    if !machine.failed {
        machine.failed = true;
        machine.message.clear();
        put(inout machine.message, prefix);
        put_sym(inout machine.message, in machine.ctx.names, sym);
        put(inout machine.message, suffix);
    }
}

fn decline(inout machine: M, in reason: Str, sym: u32) {
    if !machine.declined {
        machine.declined = true;
        machine.message.clear();
        put(inout machine.message, reason);
        if sym != NONE32 {
            put_sym(inout machine.message, in machine.ctx.names, sym);
        }
    }
}

// ----- the effect table --------------------------------------------------------

// Word offsets in a site (`sites` in run_words.rs), from its first word.
const SITE_INST: u64 = 0;
const SITE_KIND: u64 = 1;
// handle: effect, label + 1, instance key + 1, flags, static key, then the
// captured names (count, names), then `HandleTail`.
const HS_EFFECT: u64 = 2;
const HS_LABEL: u64 = 3;
const HS_KEY: u64 = 4;
const HS_FLAGS: u64 = 5;
const HS_STATIC: u64 = 6;
const HS_FREE_COUNT: u64 = 7;
const HS_FREE: u64 = 8;
// After the captured names: body fn + 1, return clause fn + 1, return
// pattern and a pair's two patterns, operation clause count, then per
// clause: operation, fn + 1, pattern count, patterns.
const HT_BODY: u64 = 0;
const HT_RET: u64 = 1;
const HT_RET_PAT: u64 = 2;
const HT_RET_FIRST: u64 = 3;
const HT_RET_SECOND: u64 = 4;
const HT_OP_COUNT: u64 = 5;
const HT_OPS: u64 = 6;
const CL_OP: u64 = 0;
const CL_FN: u64 = 1;
const CL_PAT_COUNT: u64 = 2;
const CL_PATS: u64 = 3;
// effect call: effect, operation, instance key + 1, label + 1.
const EC_EFFECT: u64 = 2;
const EC_OP: u64 = 3;
const EC_KEY: u64 = 4;
// A labelled operation's capability label + 1 (`stop.raise(x)`), or 0.
const EC_LABEL: u64 = 5;
// try: instance key + 1.
const TRY_KEY: u64 = 2;
// closure: coerce flag, captured names (count, names), body fn + 1, then
// the parameter count.
const CS_COERCE: u64 = 2;
const CS_FREE_COUNT: u64 = 3;
const CS_FREE: u64 = 4;
// After the captured names.
const CT_BODY: u64 = 0;
const CT_PARAM_COUNT: u64 = 1;
// `Op::Closure` operands: pool index, then the alias count and pairs.
const CO_ALIAS_COUNT: u64 = 1;
// A closure's `Control::Eval`: the `Eval` itself (its `Frame::Coerce` pop
// is one more when the closure is typed).
const CLOSURE_EVAL_STEPS: u64 = 1;
// Handle flags: the expression has a type (a `Frame::Coerce`); a state;
// the state initializer has a type.
const FLAG_COERCE: u64 = 1;
const FLAG_STATE: u64 = 2;
const FLAG_INIT_COERCE: u64 = 4;
// Pattern words: `_`, or a pattern the machine does not bind; a return
// pattern may be a pair, whose two patterns follow.
const PAT_WILD: u64 = 0;
const PAT_OTHER: u64 = 18446744073709551615;
const PAT_PAIR: u64 = 18446744073709551614;
// A state handler's `Eval` of its `$handler_init` name and the pop of
// its `Frame::HandleState`.
const STATE_INIT_STEPS: u64 = 2;
// `Op::Handle` operands: state flag, state value, pool index, then the
// alias count and (name, slot) pairs.
const HO_STATE_VALUE: u64 = 1;
const HO_ALIAS_COUNT: u64 = 3;
// The width of one (name, slot) alias pair in `Op::Handle` and
// `Op::Closure` operands.
const ALIAS_PAIR_WORDS: u64 = 2;
// `Op::Data` operands: the constructor, the field count, then (name,
// value) pairs.
const DATA_FIELDS_AT: u64 = 2;
const DATA_FIELD_WORDS: u64 = 2;
// A call argument's pass word for `inout` (`Pass::Inout`).
const PASS_INOUT: u64 = 1;
// Words per call argument: pass, value, root + 1, path.
const ARG_WORDS: u64 = 4;
// A continuation value's payload: its `conts` index in the low half, its
// serial in the high half.
const CONT_SERIAL: u64 = 4294967296;
const CONT_INDEX_MASK: u64 = 4294967295;

fn site_word(in machine: M, at: u64) -> u64 {
    u64_at(in machine.sites, at)
}

fn name_word(in machine: M, index: u64) -> u64 {
    w(u32_at(in machine.ctx.nmap, index))
}

// A `name + 1` word, or 0.
fn opt_name_word(in machine: M, word: u64) -> u64 {
    if word == 0 {
        0
    } else {
        inc(name_word(in machine, wrapping_sub(word, 1)))
    }
}

fn pattern_word(in machine: M, word: u64) -> u64 {
    if word == PAT_WILD || word == PAT_OTHER || word == PAT_PAIR {
        word
    } else {
        opt_name_word(in machine, word)
    }
}

// Reads the effect table after the entry, with names as symbols.
pub fn read_sites(inout machine: M, inout reader: Reader, in bytes: Slice[u8]) {
    machine.key_overflow = opt_name_word(in machine, reader.word(in bytes));
    machine.key_runtime = opt_name_word(in machine, reader.word(in bytes));
    machine.site_of.resize(machine.program.insts.len(), 0);
    let site_count = reader.word(in bytes);
    for i in 0..site_count {
        let inst_id = reader.word(in bytes);
        let kind = reader.word(in bytes);
        let ok = machine.site_of.try_set(inst_id, inc(machine.sites.len()));
        machine.sites.push(inst_id);
        machine.sites.push(kind);
        if kind == SITE_HANDLE {
            let effect = name_word(in machine, reader.word(in bytes));
            machine.sites.push(effect);
            let label = opt_name_word(in machine, reader.word(in bytes));
            machine.sites.push(label);
            let key = opt_name_word(in machine, reader.word(in bytes));
            machine.sites.push(key);
            machine.sites.push(reader.word(in bytes));
            let static_key = name_word(in machine, reader.word(in bytes));
            machine.sites.push(static_key);
            let free_count = reader.word(in bytes);
            machine.sites.push(free_count);
            for j in 0..free_count {
                let name = name_word(in machine, reader.word(in bytes));
                machine.sites.push(name);
            }
            let body = opt_name_word(in machine, reader.word(in bytes));
            machine.sites.push(body);
            let ret = opt_name_word(in machine, reader.word(in bytes));
            machine.sites.push(ret);
            let ret_pat = pattern_word(in machine, reader.word(in bytes));
            machine.sites.push(ret_pat);
            for j in 0..2 {
                let pair_pat = pattern_word(in machine, reader.word(in bytes));
                machine.sites.push(pair_pat);
            }
            let op_count = reader.word(in bytes);
            machine.sites.push(op_count);
            for j in 0..op_count {
                let op_name = name_word(in machine, reader.word(in bytes));
                machine.sites.push(op_name);
                let clause = opt_name_word(in machine, reader.word(in bytes));
                machine.sites.push(clause);
                let pat_count = reader.word(in bytes);
                machine.sites.push(pat_count);
                for k in 0..pat_count {
                    let pat = pattern_word(in machine, reader.word(in bytes));
                    machine.sites.push(pat);
                }
            }
        } else if kind == SITE_EFFECT_CALL {
            let effect = name_word(in machine, reader.word(in bytes));
            machine.sites.push(effect);
            let op_name = name_word(in machine, reader.word(in bytes));
            machine.sites.push(op_name);
            let key = opt_name_word(in machine, reader.word(in bytes));
            machine.sites.push(key);
            let label = opt_name_word(in machine, reader.word(in bytes));
            machine.sites.push(label);
        } else if kind == SITE_TRY {
            let key = opt_name_word(in machine, reader.word(in bytes));
            machine.sites.push(key);
        } else if kind == SITE_CLOSURE {
            machine.sites.push(reader.word(in bytes));
            let free_count = reader.word(in bytes);
            machine.sites.push(free_count);
            for j in 0..free_count {
                let name = name_word(in machine, reader.word(in bytes));
                machine.sites.push(name);
            }
            let body = opt_name_word(in machine, reader.word(in bytes));
            machine.sites.push(body);
            machine.sites.push(reader.word(in bytes));
        }
    }
}

// The site of instruction `inst_id` of kind `kind`, or NONE64.
fn site(in machine: M, inst_id: u64, kind: u64) -> u64 {
    let slot = u64_at(in machine.site_of, inst_id);
    if slot == 0 {
        return NONE64;
    }
    let at = wrapping_sub(slot, 1);
    if site_word(in machine, add(at, SITE_KIND)) != kind {
        return NONE64;
    }
    at
}

// The first word after a handle site's captured names.
fn handle_tail(in machine: M, at: u64) -> u64 {
    add(add(at, HS_FREE), site_word(in machine, add(at, HS_FREE_COUNT)))
}

// The function of a `fn + 1` word, or NONE64.
fn site_fn(in machine: M, word: u64) -> u64 {
    if word == 0 {
        NONE64
    } else {
        fn_index(in machine, n32(wrapping_sub(word, 1)))
    }
}

// The end of the operation clause at `at`.
fn clause_end(in machine: M, at: u64) -> u64 {
    add(add(at, CL_PATS), site_word(in machine, add(at, CL_PAT_COUNT)))
}

// `scan` of handle site `at`: its bodies are reached, or the machine
// declines what it does not run yet.
fn scan_handle(inout machine: M, at: u64, inout work: ChunkSeq[u64]) {
    if site_word(in machine, add(at, HS_FLAGS)) & FLAG_INIT_COERCE != 0 {
        decline(inout machine, "a typed state initializer", NONE32);
        return;
    }
    let tail = handle_tail(in machine, at);
    let body = site_fn(in machine, site_word(in machine, add(tail, HT_BODY)));
    let ret = site_fn(in machine, site_word(in machine, add(tail, HT_RET)));
    if body == NONE64 || ret == NONE64 {
        decline(inout machine, "a handler body run as an expression", NONE32);
        return;
    }
    if site_word(in machine, add(tail, HT_RET_PAT)) == PAT_OTHER {
        decline(inout machine, "a handler clause pattern", NONE32);
        return;
    }
    reach(inout machine, body, inout work);
    reach(inout machine, ret, inout work);
    let mut clause_at = add(tail, HT_OPS);
    for i in 0..site_word(in machine, add(tail, HT_OP_COUNT)) {
        let clause = site_fn(in machine, site_word(in machine, add(clause_at, CL_FN)));
        if clause == NONE64 {
            decline(inout machine, "a handler body run as an expression", NONE32);
            return;
        }
        reach(inout machine, clause, inout work);
        // The last pattern binds the continuation.
        let pat_count = site_word(in machine, add(clause_at, CL_PAT_COUNT));
        if pat_count != 0 {
            let cont = site_word(
                in machine,
                add(add(clause_at, CL_PATS), wrapping_sub(pat_count, 1))
            );
            if cont != PAT_WILD && cont != PAT_OTHER {
                if clause >= machine.cont_names.len() {
                    machine.cont_names.resize(inc(clause), 0);
                }
                let ok = machine.cont_names.try_set(clause, n32(cont));
            }
        }
        for j in 0..pat_count {
            if site_word(in machine, add(add(clause_at, CL_PATS), j)) == PAT_OTHER {
                decline(inout machine, "a handler clause pattern", NONE32);
                return;
            }
        }
        clause_at = clause_end(in machine, clause_at);
    }
}

// The `Eval` of a handler expression (`ExprKind::Handle` without a
// state): its `Frame::Coerce`, its `Frame::Handler` over the captured
// environment, then the body's activation over the aliased places.
fn install(inout machine: M) {
    let inst_id = machine.pending;
    let inst = machine.program.inst(inst_id);
    let at = site(in machine, inst_id, SITE_HANDLE);
    let stateful = site_word(in machine, add(at, HS_FLAGS)) & FLAG_STATE != 0;
    let mut state = unit();
    if stateful {
        // The initializer was lowered: `Eval` reads it back by name.
        state = get(inout machine, machine.program.op(add(inst.a, HO_STATE_VALUE)));
        for i in 0..STATE_INIT_STEPS {
            if machine.fuel == 0 {
                fail(inout machine, "execution fuel exhausted");
            }
            machine.fuel = wrapping_sub(machine.fuel, 1);
        }
        if machine.failed {
            return;
        }
    }
    if site_word(in machine, add(at, HS_FLAGS)) & FLAG_COERCE != 0 {
        let mut coerce_frame = machine.frame;
        coerce_frame.kind = FR_COERCE;
        coerce_frame.ty = inst.ty;
        machine.stack.push(coerce_frame);
    }
    let val_base = machine.vals.len();
    let env_base = machine.env.len();
    let cell_base = machine.cells.len();
    let seg_base = machine.segs.len();
    // The aliases resolve in the suspended activation.
    let mut slots: ChunkSeq[En] = ChunkSeq::new[En]();
    let alias_at = add(inst.a, HO_ALIAS_COUNT);
    for i in 0..machine.program.op(alias_at) {
        let pair_at = add(inc(alias_at), wrapping_mul(i, ALIAS_PAIR_WORDS));
        let name = n32(machine.program.op(pair_at));
        let bound_index = binding(in machine, n32(machine.program.op(inc(pair_at))));
        if bound_index != NONE64 {
            let env_entry = entry(in machine, bound_index);
            let seg_start = machine.segs.len();
            for j in 0..env_entry.seg_count {
                machine.segs.push(u32_at(in machine.segs, add(env_entry.seg_start, j)));
            }
            slots.push(En {
                name: name,
                cell: env_entry.cell,
                seg_start: seg_start,
                seg_count: env_entry.seg_count
            });
        }
    }
    // `handler_environment`: the clauses' free names, by value.
    let hcap_start = machine.hcap_names.len();
    for i in 0..site_word(in machine, add(at, HS_FREE_COUNT)) {
        let name = n32(site_word(in machine, add(add(at, HS_FREE), i)));
        let mut k = slots.len();
        loop {
            if k == 0 {
                break;
            }
            k = wrapping_sub(k, 1);
            let slot = match slots.try_get(k) {
                Option::Some(found) => found,
                Option::None => En { name: 0, cell: 0, seg_start: 0, seg_count: 0 },
            };
            if slot.name == name {
                slot_path(inout machine, slot);
                let value = read_path(inout machine, slot.cell);
                if machine.failed {
                    return;
                }
                machine.hcap_names.push(name);
                machine.hcap_vals.push(value);
                break;
            }
        }
    }
    let mut handler_frame = machine.frame;
    handler_frame.kind = FR_HANDLER;
    handler_frame.func_index = at;
    machine.h_serial = inc(machine.h_serial);
    handler_frame.serial = machine.h_serial;
    handler_frame.block = hcap_start;
    handler_frame.ip = wrapping_sub(machine.hcap_names.len(), hcap_start);
    if stateful {
        handler_frame.ty = HANDLER_STATE;
        machine.hcap_names.push(NONE32);
        machine.hcap_vals.push(state);
    } else {
        handler_frame.ty = 0;
    }
    handler_frame.val_base = val_base;
    handler_frame.env_base = env_base;
    handler_frame.cell_base = cell_base;
    handler_frame.seg_base = seg_base;
    machine.stack.push(handler_frame);
    for i in 0..slots.len() {
        match slots.try_get(i) {
            Option::Some(env_entry) => machine.env.push(env_entry),
            Option::None => {},
        }
    }
    let body = site_fn(
        in machine,
        site_word(in machine, add(handle_tail(in machine, at), HT_BODY))
    );
    let fn_info = func(in machine, body);
    machine.vals.resize(add(val_base, fn_info.value_count), undef());
    machine
        .frame = Fr {
            func_index: body,
            block: fn_info.first_block,
            ip: 0,
            val_base: val_base,
            env_base: env_base,
            cell_base: cell_base,
            seg_base: seg_base,
            dest: 0,
            ty: 0,
            kind: FR_IR,
            serial: 0
        };
    machine.control = C_IR;
}

// A clause's activation of function `func_index` where `handler` was
// installed, over a copy of its captured environment
// (`snapshot_environment`); the handler's captures are released.
fn clause_frame(inout machine: M, handler: Fr, func_index: u64) {
    machine.vals.truncate(handler.val_base);
    machine.env.truncate(handler.env_base);
    machine.cells.truncate(handler.cell_base);
    machine.segs.truncate(handler.seg_base);
    for i in 0..handler.ip {
        let cell = machine.cells.len();
        machine.cells.push(match machine.hcap_vals.try_get(add(handler.block, i)) {
            Option::Some(value) => value,
            Option::None => undef(),
        });
        machine.env.push(En {
            name: u32_at(in machine.hcap_names, add(handler.block, i)),
            cell: cell,
            seg_start: 0,
            seg_count: 0
        });
    }
    machine.hcap_names.truncate(handler.block);
    machine.hcap_vals.truncate(handler.block);
    let fn_info = func(in machine, func_index);
    machine.vals.resize(add(handler.val_base, fn_info.value_count), undef());
    machine
        .frame = Fr {
            func_index: func_index,
            block: fn_info.first_block,
            ip: 0,
            val_base: handler.val_base,
            env_base: handler.env_base,
            cell_base: handler.cell_base,
            seg_base: handler.seg_base,
            dest: 0,
            ty: 0,
            kind: FR_IR,
            serial: 0
        };
    machine.control = C_IR;
}

// The handler's body returned `value` (`Frame::Handler` in `drive`): its
// return clause runs.
fn handler_return(inout machine: M, handler: Fr, value: Val) {
    let tail = handle_tail(in machine, handler.func_index);
    let ret = site_fn(in machine, site_word(in machine, add(tail, HT_RET)));
    let stateful = handler.ty == HANDLER_STATE;
    let state = handler_state(in machine, handler);
    clause_frame(inout machine, handler, ret);
    let pat = site_word(in machine, add(tail, HT_RET_PAT));
    if pat == PAT_PAIR {
        let mut first = value;
        let mut second = state;
        if !stateful {
            let aggregate = agg(in machine, value);
            if value.tag != T_TUPLE || aggregate.kid_count != 2 {
                fail(inout machine, "handler return pattern mismatch");
                return;
            }
            first = kid(in machine, aggregate.kid_start);
            second = kid(in machine, inc(aggregate.kid_start));
        }
        bind_word(inout machine, site_word(in machine, add(tail, HT_RET_FIRST)), first);
        bind_word(inout machine, site_word(in machine, add(tail, HT_RET_SECOND)), second);
    } else if stateful {
        let kid_start = machine.kids.len();
        push_kid(inout machine, 0, value);
        push_kid(inout machine, 0, state);
        let pair = make(inout machine, T_TUPLE, 0, kid_start);
        bind_word(inout machine, pat, pair);
    } else {
        bind_word(inout machine, pat, value);
    }
}

// Binds pattern word `pat` (`_` or a binding) to `value`.
fn bind_word(inout machine: M, pat: u64, value: Val) {
    if pat != PAT_WILD {
        bind_new(inout machine, n32(wrapping_sub(pat, 1)), value);
    }
}

// A state handler's state, or the unit value.
fn handler_state(in machine: M, handler: Fr) -> Val {
    if handler.ty != HANDLER_STATE {
        return unit();
    }
    match machine.hcap_vals.try_get(add(handler.block, handler.ip)) {
        Option::Some(value) => value,
        Option::None => undef(),
    }
}

// `perform` of `effect::op` on `arg_vals`, with the instance key `key`
// (symbol + 1, or 0) the raising activation's evidence names: the
// innermost handler with that key, else the innermost of the effect.
fn perform(inout machine: M, effect: u32, op_name: u32, key: u64, label: u64) {
    let mut found = NONE64;
    if label != 0 {
        // `$label:<label>` first, then the instance as unlabelled.
        found = find_labelled(inout machine, label);
    }
    if found == NONE64 && key != 0 {
        found = find_handler(inout machine, key, effect);
    }
    if found == NONE64 {
        found = find_handler(inout machine, 0, effect);
    }
    if machine.declined {
        return;
    }
    if found == NONE64 {
        if !machine.failed {
            machine.failed = true;
            machine.message.clear();
            put(inout machine.message, "unhandled effect ");
            put_sym(inout machine.message, in machine.ctx.names, effect);
            put(inout machine.message, "::");
            put_sym(inout machine.message, in machine.ctx.names, op_name);
        }
        return;
    }
    let handler = stack_at(in machine, found);
    let state = handler_state(in machine, handler);
    let cont = capture(inout machine, found);
    machine.stack.truncate(found);
    let tail = handle_tail(in machine, handler.func_index);
    let mut clause_at = add(tail, HT_OPS);
    let mut clause = NONE64;
    for j in 0..site_word(in machine, add(tail, HT_OP_COUNT)) {
        if clause == NONE64 && site_word(in machine, add(clause_at, CL_OP)) == w(op_name) {
            clause = clause_at;
        }
        clause_at = clause_end(in machine, clause_at);
    }
    if clause == NONE64 {
        fail(inout machine, "handler lacks operation");
        return;
    }
    // The arguments, the state, then the continuation.
    let pat_count = site_word(in machine, add(clause, CL_PAT_COUNT));
    let arg_count = machine.arg_vals.len();
    let stateful = handler.ty == HANDLER_STATE;
    let value_count = if stateful {
        add(arg_count, 2)
    } else {
        inc(arg_count)
    };
    if value_count != pat_count {
        fail(inout machine, "operation handler pattern arity mismatch");
        return;
    }
    let mut args: ChunkSeq[Val] = ChunkSeq::new[Val]();
    for j in 0..arg_count {
        args.push(match machine.arg_vals.try_get(j) {
            Option::Some(value) => value,
            Option::None => undef(),
        });
    }
    if stateful {
        args.push(state);
    }
    args.push(cont);
    clause_frame(
        inout machine,
        handler,
        site_fn(in machine, site_word(in machine, add(clause, CL_FN)))
    );
    for j in 0..pat_count {
        let pat = site_word(in machine, add(add(clause, CL_PATS), j));
        if pat != PAT_WILD {
            let value = match args.try_get(j) {
                Option::Some(found_value) => found_value,
                Option::None => undef(),
            };
            bind_new(inout machine, n32(wrapping_sub(pat, 1)), value);
        }
    }
}

fn stack_at(in machine: M, index: u64) -> Fr {
    match machine.stack.try_get(index) {
        Option::Some(frame) => frame,
        Option::None => fr_zero(),
    }
}

fn val_at(in seq: ChunkSeq[Val], index: u64) -> Val {
    match seq.try_get(index) {
        Option::Some(value) => value,
        Option::None => undef(),
    }
}

fn fr_at(in seq: ChunkSeq[Fr], index: u64) -> Fr {
    match seq.try_get(index) {
        Option::Some(frame) => frame,
        Option::None => fr_zero(),
    }
}

fn en_at(in seq: ChunkSeq[En], index: u64) -> En {
    match seq.try_get(index) {
        Option::Some(found) => found,
        Option::None => En { name: 0, cell: 0, seg_start: 0, seg_count: 0 },
    }
}

fn kt_at(in machine: M, index: u64) -> Kt {
    match machine.conts.try_get(index) {
        Option::Some(found) => found,
        Option::None => Kt {
            frame_start: 0,
            val_start: 0,
            env_start: 0,
            cell_start: 0,
            seg_start: 0,
            hcap_start: 0,
            val_base: 0,
            env_base: 0,
            cell_base: 0,
            seg_base: 0,
            hcap_base: 0,
            depth: 0,
            below: fr_zero(),
            serial: 0,
            taken: false
        },
    }
}

// The continuation of a `perform` whose handler is `stack[found]`
// (`Continuation`): the frames from the handler up, and the arena entries
// above the handler's levels, which `clause_frame` then drops.
fn capture(inout machine: M, found: u64) -> Val {
    let handler = stack_at(in machine, found);
    // A continuation captured at this depth or above is resumed only
    // after its frames moved (declined) or is unreachable: its clause
    // ended without resuming it. Its snapshot is released.
    loop {
        let count = machine.conts.len();
        if count == 0 || kt_at(in machine, wrapping_sub(count, 1)).depth < found {
            break;
        }
        drop_last(inout machine);
    }
    machine.k_serial = inc(machine.k_serial);
    let below = if found == 0 {
        fr_zero()
    } else {
        stack_at(in machine, wrapping_sub(found, 1))
    };
    let index = machine.conts.len();
    machine.conts.push(Kt {
        frame_start: machine.k_frames.len(),
        val_start: machine.k_vals.len(),
        env_start: machine.k_env.len(),
        cell_start: machine.k_cells.len(),
        seg_start: machine.k_segs.len(),
        hcap_start: machine.k_hnames.len(),
        val_base: handler.val_base,
        env_base: handler.env_base,
        cell_base: handler.cell_base,
        seg_base: handler.seg_base,
        hcap_base: handler.block,
        depth: found,
        below: below,
        serial: machine.k_serial,
        taken: false
    });
    for i in found..machine.stack.len() {
        machine.k_frames.push(stack_at(in machine, i));
    }
    for i in handler.val_base..machine.vals.len() {
        machine.k_vals.push(val_at(in machine.vals, i));
    }
    for i in handler.env_base..machine.env.len() {
        machine.k_env.push(en_at(in machine.env, i));
    }
    for i in handler.cell_base..machine.cells.len() {
        machine.k_cells.push(val_at(in machine.cells, i));
    }
    for i in handler.seg_base..machine.segs.len() {
        machine.k_segs.push(u32_at(in machine.segs, i));
    }
    for i in handler.block..machine.hcap_names.len() {
        machine.k_hnames.push(u32_at(in machine.hcap_names, i));
        machine.k_hvals.push(val_at(in machine.hcap_vals, i));
    }
    Val { tag: T_CONT, payload: add(index, wrapping_mul(machine.k_serial, CONT_SERIAL)) }
}

fn same_frame(lhs: Fr, rhs: Fr) -> bool {
    lhs.kind == rhs.kind
        && lhs.func_index == rhs.func_index
        && lhs.block == rhs.block
        && lhs.ip == rhs.ip
        && lhs.val_base == rhs.val_base
        && lhs.env_base == rhs.env_base
        && lhs.cell_base == rhs.cell_base
        && lhs.seg_base == rhs.seg_base
}

// Resumes continuation `cont` on `arg_vals` after its caller was suspended
// (`Value::Continuation` in `call_value`): its handler and frames go back
// on the stack over the current arena levels, and the value returns into
// the operation's caller.
fn resume_cont(inout machine: M, cont: Val) {
    let index = cont.payload & CONT_INDEX_MASK;
    let k = kt_at(in machine, index);
    if index >= machine.conts.len()
        || wrapping_mul(k.serial, CONT_SERIAL) != wrapping_sub(cont.payload, index)
    {
        decline(inout machine, "a released continuation", NONE32);
        return;
    }
    if k.taken {
        fail(inout machine, "one-shot continuation was resumed twice");
        return;
    }
    let mut taken = k;
    taken.taken = true;
    let ok = machine.conts.try_set(index, taken);
    let handler = fr_at(in machine.k_frames, k.frame_start);
    let expected = if handler.ty == HANDLER_STATE { 2 } else { 1 };
    if machine.arg_vals.len() != expected {
        fail(inout machine, "continuation expects ");
        push_decimal(inout machine.message, expected);
        put(inout machine.message, " arguments");
        return;
    }
    // A continuation resumed outside its handler's activation would see
    // other places below it.
    if k.depth > machine.stack.len()
        || (k.depth != 0 && !same_frame(stack_at(in machine, wrapping_sub(k.depth, 1)), k.below))
    {
        decline(inout machine, "an escaped continuation", NONE32);
        return;
    }
    let last = inc(index) == machine.conts.len();
    let next = kt_at(in machine, inc(index));
    let frame_end = if last {
        machine.k_frames.len()
    } else {
        next.frame_start
    };
    let val_end = if last {
        machine.k_vals.len()
    } else {
        next.val_start
    };
    let env_end = if last {
        machine.k_env.len()
    } else {
        next.env_start
    };
    let cell_end = if last {
        machine.k_cells.len()
    } else {
        next.cell_start
    };
    let seg_end = if last {
        machine.k_segs.len()
    } else {
        next.seg_start
    };
    let hcap_end = if last {
        machine.k_hnames.len()
    } else {
        next.hcap_start
    };
    let val_delta = wrapping_sub(machine.vals.len(), k.val_base);
    let env_delta = wrapping_sub(machine.env.len(), k.env_base);
    let cell_delta = wrapping_sub(machine.cells.len(), k.cell_base);
    let seg_delta = wrapping_sub(machine.segs.len(), k.seg_base);
    let hcap_delta = wrapping_sub(machine.hcap_names.len(), k.hcap_base);
    for i in k.val_start..val_end {
        machine.vals.push(val_at(in machine.k_vals, i));
    }
    for i in k.cell_start..cell_end {
        machine.cells.push(val_at(in machine.k_cells, i));
    }
    for i in k.seg_start..seg_end {
        machine.segs.push(u32_at(in machine.k_segs, i));
    }
    for i in k.hcap_start..hcap_end {
        machine.hcap_names.push(u32_at(in machine.k_hnames, i));
        machine.hcap_vals.push(val_at(in machine.k_hvals, i));
    }
    // Entries into the saved cells and segments move with them; aliases of
    // places below the handler stay.
    for i in k.env_start..env_end {
        let mut env_entry = en_at(in machine.k_env, i);
        if env_entry.cell >= k.cell_base {
            env_entry.cell = add(env_entry.cell, cell_delta);
        }
        if env_entry.seg_count != 0 {
            env_entry.seg_start = add(env_entry.seg_start, seg_delta);
        }
        machine.env.push(env_entry);
    }
    for i in k.frame_start..frame_end {
        let mut frame = fr_at(in machine.k_frames, i);
        frame.val_base = add(frame.val_base, val_delta);
        frame.env_base = add(frame.env_base, env_delta);
        frame.cell_base = add(frame.cell_base, cell_delta);
        frame.seg_base = add(frame.seg_base, seg_delta);
        if frame.kind == FR_HANDLER {
            frame.block = add(frame.block, hcap_delta);
        }
        if i == k.frame_start && frame.ty == HANDLER_STATE {
            let set = machine
                .hcap_vals
                .try_set(add(frame.block, frame.ip), val_at(in machine.arg_vals, 1));
        }
        machine.stack.push(frame);
    }
    if last {
        drop_last(inout machine);
    }
    machine.ret_value = val_at(in machine.arg_vals, 0);
    machine.control = C_RET;
}

// A primitive failure (`raise_primitive`): `Fail::raise` of the failure's
// value through the typed `Fail` instance in scope.
fn raise(inout machine: M, failure: u8) {
    let ctor = if failure == P_OVERFLOW {
        machine.overflow_sym
    } else if failure == P_DIV_ZERO {
        machine.div_zero_sym
    } else {
        machine.index_sym
    };
    let key = if failure == P_OVERFLOW {
        machine.key_overflow
    } else {
        machine.key_runtime
    };
    let payload = make(inout machine, T_DATA, ctor, machine.kids.len());
    machine.arg_vals.clear();
    machine.arg_vals.push(payload);
    perform(inout machine, machine.fail_sym, machine.raise_sym, key, 0);
}

// ----- symbols -----------------------------------------------------------------

fn lookup(in machine: M, in text: Str) -> u32 {
    machine.ctx.names.lookup(in text.as_bytes())
}

fn spells(in machine: M, sym: u32, in text: Str) -> bool {
    machine.ctx.names.spells(sym, in text.as_bytes())
}

// `s.parse::<usize>()` of a symbol's text, or NONE64.
fn index_of(in machine: M, sym: u32) -> u64 {
    let text_start = machine.ctx.names.start(sym);
    let text_end = machine.ctx.names.end(sym);
    let mut digit_start = text_start;
    if digit_start < text_end && u8_at(in machine.ctx.names.text, digit_start) == 43 {
        digit_start = inc(digit_start);
    }
    if digit_start >= text_end {
        return NONE64;
    }
    let mut value: u64 = 0;
    for j in digit_start..text_end {
        let byte = u8_at(in machine.ctx.names.text, j);
        if byte < 48 || byte > 57 {
            return NONE64;
        }
        let digit = widen_u64(wrapping_sub(byte, 48));
        if value > 1844674407370955161 || (value == 1844674407370955161 && digit > 5) {
            return NONE64;
        }
        value = wrapping_add(wrapping_mul(value, 10), digit);
    }
    value
}

// The symbol of the text after the last `::` of `sym` (`rsplit("::")`).
fn short_of(inout machine: M, sym: u32) -> u32 {
    let cached = u32_at(in machine.short_syms, w(sym));
    if cached != 0 {
        return wrapping_sub(cached, 1);
    }
    let text_start = machine.ctx.names.start(sym);
    let text_end = machine.ctx.names.end(sym);
    let mut tail_start = text_start;
    let mut pos = text_start;
    loop {
        if inc(pos) >= text_end {
            break;
        }
        if u8_at(in machine.ctx.names.text, pos) == 58
            && u8_at(in machine.ctx.names.text, inc(pos)) == 58
        {
            tail_start = add(pos, 2);
            pos = add(pos, 2);
        } else {
            pos = inc(pos);
        }
    }
    let mut bytes: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for j in tail_start..text_end {
        bytes.push(u8_at(in machine.ctx.names.text, j));
    }
    let short_sym = machine.ctx.names.intern(in bytes[0..bytes.len()]);
    if w(sym) >= machine.short_syms.len() {
        machine.short_syms.resize(inc(w(sym)), 0);
    }
    let ok = machine.short_syms.try_set(w(sym), wrapping_add(short_sym, 1));
    short_sym
}

// `World::constructor(name)`: the variant's symbol, or NONE32.
fn ctor_of(inout machine: M, sym: u32) -> u32 {
    let text_start = machine.ctx.names.start(sym);
    let text_end = machine.ctx.names.end(sym);
    let mut sep_count: u64 = 0;
    let mut sep_at = text_start;
    let mut pos = text_start;
    loop {
        if inc(pos) >= text_end {
            break;
        }
        if u8_at(in machine.ctx.names.text, pos) == 58
            && u8_at(in machine.ctx.names.text, inc(pos)) == 58
        {
            sep_count = inc(sep_count);
            sep_at = pos;
            pos = add(pos, 2);
        } else {
            pos = inc(pos);
        }
    }
    if sep_count > 1 {
        return NONE32;
    }
    let mut qualifier = NONE32;
    let mut short_sym = sym;
    if sep_count == 1 {
        let mut qual_text: ChunkSeq[u8] = ChunkSeq::new[u8]();
        for j in text_start..sep_at {
            qual_text.push(u8_at(in machine.ctx.names.text, j));
        }
        let mut short_text: ChunkSeq[u8] = ChunkSeq::new[u8]();
        for j in add(sep_at, 2)..text_end {
            short_text.push(u8_at(in machine.ctx.names.text, j));
        }
        qualifier = machine.ctx.names.lookup(in qual_text[0..qual_text.len()]);
        short_sym = machine.ctx.names.lookup(in short_text[0..short_text.len()]);
        if qualifier == NONE32 || short_sym == NONE32 {
            return NONE32;
        }
    }
    if constructor(in machine.ctx.world, qualifier, short_sym) == NONE64 {
        NONE32
    } else {
        short_sym
    }
}

// ----- types -------------------------------------------------------------------

fn int_kind(inout machine: M, ty: u32) -> u8 {
    let ty_index = w(ty);
    let cached = u8_at(in machine.type_kinds, ty_index);
    if ty_index < machine.type_kinds.len() && cached != TK_UNSEEN {
        return cached;
    }
    let kind = if machine.ctx.types.kind(ty) != TyKind::Named || machine.ctx.types.arity(ty) != 0 {
        TK_NONE
    } else {
        let name = machine.ctx.types.name(ty);
        let known = machine.ctx.world.k;
        if name == known.i64_ || name == known.isize_ {
            K_I64
        } else if name == known.u8_ {
            K_U8
        } else if name == known.u16_ {
            K_U16
        } else if name == known.u32_ {
            K_U32
        } else if name == known.u64_ || name == known.usize_ {
            K_U64
        } else if name == known.i8_ {
            K_I8
        } else if name == known.i16_ {
            K_I16
        } else if name == known.i32_ {
            K_I32
        } else {
            TK_NONE
        }
    };
    if ty_index >= machine.type_kinds.len() {
        machine.type_kinds.resize(inc(ty_index), TK_UNSEEN);
    }
    let ok = machine.type_kinds.try_set(ty_index, kind);
    kind
}

// `coerce_value`: an integer takes the kind of an integer type.
fn coerce(inout machine: M, value: Val, ty: u32) -> Val {
    if value.tag == T_FN || value.tag == T_CLOS || value.tag == T_BOUND {
        // `qualify_value` without ambient evidence: `$cap` instances only.
        return bind_evidence(inout machine, value, ty, false);
    }
    if value.tag == T_F64 {
        // An unsuffixed float literal checked as an `f32` takes its `f32`
        // value.
        if is_f32(in machine, ty) {
            return f32_val(nearest_f32(f64_of(value)));
        }
        return value;
    }
    if value.tag > K_I32 {
        return value;
    }
    let kind = int_kind(inout machine, ty);
    if kind == TK_NONE {
        return value;
    }
    Val { tag: kind, payload: wrap(kind, exact(value.tag, value.payload)) }
}

// Whether `ty` is `f32` (`FloatKind::from_type`).
fn is_f32(in machine: M, ty: u32) -> bool {
    machine.ctx.types.kind(ty) == TyKind::Named
        && machine.ctx.types.arity(ty) == 0
        && machine.ctx.types.name(ty) == machine.ctx.world.k.f32_
}

fn f64_val(x: f64) -> Val {
    Val { tag: T_F64, payload: to_bits_f64(x) }
}

fn f32_val(x: f32) -> Val {
    Val { tag: T_F32, payload: widen_u64(to_bits_f32(x)) }
}

fn f64_of(value: Val) -> f64 {
    from_bits_f64(value.payload)
}

fn f32_of(value: Val) -> f32 {
    from_bits_f32(wrapping_u32(value.payload))
}

fn is_float(value: Val) -> bool {
    value.tag == T_F64 || value.tag == T_F32
}

// How deep `type_ok` and `inner_effects` follow a type.
const TYPE_DEPTH_LIMIT: u64 = 64;

// Whether the machine runs values of type `ty` (`scan`).
fn type_ok(in machine: M, ty: u32, depth: u64) -> bool {
    if depth > TYPE_DEPTH_LIMIT {
        return false;
    }
    let node = machine.ctx.types.node(ty);
    if node.kind == TyKind::Named {
        let name = node.name;
        let known = machine.ctx.world.k;
        if name == known.i128_
            || name == known.u128_
            || name == known.tiled_seq
            || name == known.vec
            || name == known.mask
            || name == known.region
            || name == known.region_box
            || name == known.watermark
            || name == known.dyn_
            || spells(in machine, name, "Atomic")
        {
            return false;
        }
    }
    if node.kind == TyKind::Fn {
        // A function value with effects carries evidence (`evs`); the
        // machine keys it by effect name, so a user label (`$label:` keys) declines;
        // a latent label keys by name, a `$cap` or `$fncap:` one by its handler's
        // `$static:` key.
        let row = machine.ctx.types.row(node.r2);
        for i in 0..w(row.n) {
            let label = machine.ctx.types.effect_at(add(w(row.a), i)).label;
            if label != 0
                && !has_prefix(in machine, wrapping_sub(label, 1), "$latent:")
                && !bound_label(in machine, wrapping_sub(label, 1))
            {
                return false;
            }
        }
        if !type_ok(in machine, node.r, inc(depth)) {
            return false;
        }
    }
    if node.kind == TyKind::Named || node.kind == TyKind::Tuple || node.kind == TyKind::Fn {
        for i in 0..w(node.n) {
            if !type_ok(in machine, machine.ctx.types.arg(ty, i), inc(depth)) {
                return false;
            }
        }
    }
    true
}

// Whether a function type with effects appears inside type `ty` below its
// top: a call binds evidence to a parameter's own function value only,
// not to one inside a tuple or data value (`qualify_value`).
fn inner_effects(in machine: M, ty: u32, depth: u64) -> bool {
    if depth > TYPE_DEPTH_LIMIT {
        return true;
    }
    let node = machine.ctx.types.node(ty);
    if node.kind == TyKind::Fn && depth > 0 {
        let row = machine.ctx.types.row(node.r2);
        if row.n != 0 || row.tail != 0 {
            return true;
        }
    }
    if node.kind == TyKind::Named || node.kind == TyKind::Tuple {
        for i in 0..w(node.n) {
            if inner_effects(in machine, machine.ctx.types.arg(ty, i), inc(depth)) {
                return true;
            }
        }
    }
    false
}

// ----- loading -----------------------------------------------------------------

fn op_code(in machine: M, sym: u32) -> u64 {
    let text_start = machine.ctx.names.start(sym);
    let text_end = machine.ctx.names.end(sym);
    let len = wrapping_sub(text_end, text_start);
    if len == 1 {
        let byte = u8_at(in machine.ctx.names.text, text_start);
        if byte == 43 {
            return widen_u64(B_ADD);
        } else if byte == 45 {
            return widen_u64(B_SUB);
        } else if byte == 42 {
            return widen_u64(B_MUL);
        } else if byte == 47 {
            return widen_u64(B_DIV);
        } else if byte == 37 {
            return widen_u64(B_REM);
        } else if byte == 38 {
            return widen_u64(B_AND);
        } else if byte == 124 {
            return widen_u64(B_OR);
        } else if byte == 94 {
            return widen_u64(B_XOR);
        } else if byte == 60 {
            return widen_u64(B_LT);
        } else if byte == 62 {
            return widen_u64(B_GT);
        }
        return 0;
    }
    if spells(in machine, sym, "<<") {
        widen_u64(B_SHL)
    } else if spells(in machine, sym, ">>") {
        widen_u64(B_SHR)
    } else if spells(in machine, sym, "==") {
        widen_u64(B_EQ)
    } else if spells(in machine, sym, "!=") {
        widen_u64(B_NE)
    } else if spells(in machine, sym, "<=") {
        widen_u64(B_LE)
    } else if spells(in machine, sym, ">=") {
        widen_u64(B_GE)
    } else if spells(in machine, sym, "&&") {
        widen_u64(B_LAND)
    } else if spells(in machine, sym, "||") {
        widen_u64(B_LOR)
    } else if spells(in machine, sym, "wrapping_add") {
        widen_u64(B_WADD)
    } else if spells(in machine, sym, "wrapping_sub") {
        widen_u64(B_WSUB)
    } else if spells(in machine, sym, "wrapping_mul") {
        widen_u64(B_WMUL)
    } else if spells(in machine, sym, "rotate_left") {
        widen_u64(B_ROTL)
    } else if spells(in machine, sym, "rotate_right") {
        widen_u64(B_ROTR)
    } else if spells(in machine, sym, "bit_and") {
        widen_u64(B_BAND)
    } else if spells(in machine, sym, "bit_or") {
        widen_u64(B_BOR)
    } else if spells(in machine, sym, "bit_xor") {
        widen_u64(B_BXOR)
    } else if spells(in machine, sym, "bit_shl") {
        widen_u64(B_BSHL)
    } else if spells(in machine, sym, "bit_shr") {
        widen_u64(B_BSHR)
    } else {
        0
    }
}

// The kind named by the text `names.text[a..e]`, or TK_NONE.
fn kind_named(in machine: M, text_start: u64, text_end: u64) -> u8 {
    let mut bytes: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for j in text_start..text_end {
        bytes.push(u8_at(in machine.ctx.names.text, j));
    }
    let sym = machine.ctx.names.lookup(in bytes[0..bytes.len()]);
    if sym == NONE32 {
        return TK_NONE;
    }
    let known = machine.ctx.world.k;
    if sym == known.i64_ || sym == known.isize_ {
        K_I64
    } else if sym == known.u8_ {
        K_U8
    } else if sym == known.u16_ {
        K_U16
    } else if sym == known.u32_ {
        K_U32
    } else if sym == known.u64_ || sym == known.usize_ {
        K_U64
    } else if sym == known.i8_ {
        K_I8
    } else if sym == known.i16_ {
        K_I16
    } else if sym == known.i32_ {
        K_I32
    } else {
        TK_NONE
    }
}

fn has_prefix(in machine: M, sym: u32, in prefix: Str) -> bool {
    machine.ctx.names.has_prefix(sym, in prefix.as_bytes())
}

fn unary_code(in machine: M, sym: u32) -> u64 {
    if spells(in machine, sym, "-") {
        return U_NEG;
    }
    if spells(in machine, sym, "!") {
        return U_NOT;
    }
    if spells(in machine, sym, "~") {
        return U_INV;
    }
    let float_code = float_unary_code(in machine, sym);
    if float_code != 0 {
        return float_code;
    }
    let text_start = machine.ctx.names.start(sym);
    let text_end = machine.ctx.names.end(sym);
    let mut family = NONE64;
    let mut kind_at = text_start;
    if has_prefix(in machine, sym, "widen_") {
        family = C_WIDEN;
        kind_at = add(text_start, 6);
    } else if has_prefix(in machine, sym, "narrow_") {
        family = C_NARROW;
        kind_at = add(text_start, 7);
    } else if has_prefix(in machine, sym, "wrapping_") {
        family = C_WRAPPING;
        kind_at = add(text_start, 9);
    }
    if family == NONE64 {
        return 0;
    }
    let kind = kind_named(in machine, kind_at, text_end);
    if kind == TK_NONE {
        return 0;
    }
    add(add(U_CONV, wrapping_mul(family, CONV_STRIDE)), widen_u64(kind))
}

// The float conversions and bit reinterpretations (`float_conversion`,
// `bits_intrinsic`): U_FLOAT + operation * 2 + kind, or 0. The math
// intrinsics and saturating conversions are not codes: the machine
// declines them.
fn float_unary_code(in machine: M, sym: u32) -> u64 {
    let mut op = NONE64;
    let mut kind = NONE64;
    if spells(in machine, sym, "widen_f32") {
        op = FC_WIDEN;
        kind = FK_F32;
    } else if spells(in machine, sym, "widen_f64") {
        op = FC_WIDEN;
        kind = FK_F64;
    } else if spells(in machine, sym, "nearest_f32") {
        op = FC_NEAREST;
        kind = FK_F32;
    } else if spells(in machine, sym, "nearest_f64") {
        op = FC_NEAREST;
        kind = FK_F64;
    } else if spells(in machine, sym, "to_bits_f32") {
        op = FC_TO_BITS;
        kind = FK_F32;
    } else if spells(in machine, sym, "to_bits_f64") {
        op = FC_TO_BITS;
        kind = FK_F64;
    } else if spells(in machine, sym, "from_bits_f32") {
        op = FC_FROM_BITS;
        kind = FK_F32;
    } else if spells(in machine, sym, "from_bits_f64") {
        op = FC_FROM_BITS;
        kind = FK_F64;
    }
    if op == NONE64 {
        return 0;
    }
    add(U_FLOAT, add(wrapping_mul(op, FLOAT_KINDS), kind))
}

// Reads every function's header: parameters, value count, first block.
pub fn load(inout machine: M, entry_index: u64) {
    machine.ok_sym = machine.ctx.names.intern(in "Ok".as_bytes());
    machine.err_sym = machine.ctx.names.intern(in "Err".as_bytes());
    machine.zero_sym = machine.ctx.names.intern(in "0".as_bytes());
    machine.some_sym = machine.ctx.names.intern(in "Some".as_bytes());
    machine.none_sym = machine.ctx.names.intern(in "None".as_bytes());
    machine.dot_sym = machine.ctx.names.intern(in ".".as_bytes());
    machine.fail_sym = machine.ctx.names.intern(in "Fail".as_bytes());
    machine.raise_sym = machine.ctx.names.intern(in "raise".as_bytes());
    machine.overflow_sym = machine.ctx.names.intern(in "ArithOverflow".as_bytes());
    machine.div_zero_sym = machine.ctx.names.intern(in "DivisionByZero".as_bytes());
    machine.index_sym = machine.ctx.names.intern(in "IndexOutOfBounds".as_bytes());
    let entry_sym = u32_at(in machine.ctx.nmap, entry_index);
    machine.aux.resize(machine.program.insts.len(), 0);
    machine.block_params.resize(machine.program.blocks.len(), 0);
    for func_index in 0..machine.program.fns.len() {
        let fn_row = machine.program.function(func_index);
        let mut cursor = fn_row.ha;
        let param_count = machine.program.op(cursor);
        cursor = inc(cursor);
        let param_start = machine.params.len();
        for i in 0..param_count {
            let name = n32(machine.program.op(cursor));
            let pass = machine.program.op(inc(cursor));
            let path_count = machine.program.op(add(cursor, 2));
            cursor = add(cursor, add(3, path_count));
            // type, span start, end
            let param_ty = n32(machine.program.op(cursor));
            cursor = add(cursor, 3);
            machine.params.push(Pm { name: name, pass: pass, ty: param_ty });
        }
        // result, effects
        cursor = add(cursor, 2);
        let bound_count = machine.program.op(cursor);
        cursor = add(inc(cursor), wrapping_mul(bound_count, 2));
        let name_count = machine.program.op(cursor);
        cursor = add(inc(cursor), name_count);
        let value_entries = machine.program.op(cursor);
        cursor = inc(cursor);
        let mut value_count: u64 = 0;
        for i in 0..value_entries {
            let value_id = machine.program.op(cursor);
            if inc(value_id) > value_count {
                value_count = inc(value_id);
            }
            cursor = add(cursor, 2);
        }
        // Instruction destinations and block parameters too.
        for block_index in 0..fn_row.bc {
            let block_id = add(fn_row.b0, block_index);
            let block = machine.program.block(block_id);
            let token_in_count = machine.program.op(inc(block.ha));
            let params_at = add(add(block.ha, 3), wrapping_mul(token_in_count, 2));
            let ok = machine.block_params.try_set(block_id, params_at);
            let block_param_count = machine.program.op(params_at);
            for j in 0..block_param_count {
                let value_id = machine.program.op(add(inc(params_at), j));
                if inc(value_id) > value_count {
                    value_count = inc(value_id);
                }
            }
            for inst_index in 0..block.ic {
                let inst = machine.program.inst(add(block.i0, inst_index));
                if inc(w(inst.dest)) > value_count {
                    value_count = inc(w(inst.dest));
                }
            }
        }
        machine.fns.push(Fi {
            name: fn_row.name,
            param_start: param_start,
            param_count: param_count,
            value_count: value_count,
            first_block: fn_row.b0,
            reached: false
        });
        if w(fn_row.name) >= machine.fn_of.len() {
            machine.fn_of.resize(inc(w(fn_row.name)), 0);
        }
        let ok = machine.fn_of.try_set(w(fn_row.name), n32(inc(func_index)));
    }
    let entry_slot = u32_at(in machine.fn_of, w(entry_sym));
    if entry_index == NONE64 || entry_slot == 0 {
        decline(inout machine, "the entry has no lowered body", NONE32);
        return;
    }
    machine.entry = w(wrapping_sub(entry_slot, 1));
}

fn fn_index(in machine: M, sym: u32) -> u64 {
    let slot = u32_at(in machine.fn_of, w(sym));
    if slot == 0 {
        NONE64
    } else {
        w(wrapping_sub(slot, 1))
    }
}

// The end of the pattern at operand `at`.
fn pat_end(in machine: M, at: u64) -> u64 {
    let kind = machine.program.op(at);
    let body_at = add(at, 3);
    if kind == widen_u64(Pat::Bind) {
        inc(body_at)
    } else if kind == widen_u64(Pat::Literal) {
        add(body_at, 3)
    } else if kind == widen_u64(Pat::Tuple) {
        let n = machine.program.op(body_at);
        let mut sub_at = inc(body_at);
        for i in 0..n {
            sub_at = pat_end(in machine, sub_at);
        }
        sub_at
    } else if kind == widen_u64(Pat::Constructor) {
        let n = machine.program.op(add(body_at, 2));
        let mut sub_at = add(body_at, 3);
        for i in 0..n {
            sub_at = pat_end(in machine, inc(sub_at));
        }
        sub_at
    } else {
        body_at
    }
}

// Declines a literal the machine has no value for (a 128-bit integer). `run` declines a non-ASCII string in the result, whose `Debug`
// text needs Unicode tables.
fn scan_literal(inout machine: M, at: u64) {
    let kind = machine.program.op(at);
    let lo = machine.program.op(inc(at));
    let hi = machine.program.op(add(at, 2));
    if kind == widen_u64(Lit::Int) {
        let neg = hi == NONE64 && (lo >> 63) == 1;
        if !(hi == 0 || neg) {
            decline(inout machine, "a 128-bit integer literal", NONE32);
        }
    } else if kind != widen_u64(Lit::String)
        && kind != widen_u64(Lit::Bool)
        && kind != widen_u64(Lit::Float)
    {
        decline(inout machine, "a wide literal", NONE32);
    }
}

fn scan_pattern(inout machine: M, at: u64) {
    let kind = machine.program.op(at);
    let body_at = add(at, 3);
    if kind == widen_u64(Pat::Literal) {
        scan_literal(inout machine, body_at);
    } else if kind == widen_u64(Pat::Tuple) {
        let n = machine.program.op(body_at);
        let mut sub_at = inc(body_at);
        for i in 0..n {
            scan_pattern(inout machine, sub_at);
            sub_at = pat_end(in machine, sub_at);
        }
    } else if kind == widen_u64(Pat::Constructor) {
        let n = machine.program.op(add(body_at, 2));
        let mut sub_at = add(body_at, 3);
        for i in 0..n {
            scan_pattern(inout machine, inc(sub_at));
            sub_at = pat_end(in machine, inc(sub_at));
        }
    }
}

fn reach(inout machine: M, func_index: u64, inout work: ChunkSeq[u64]) {
    match machine.fns.try_get(func_index) {
        Option::Some(fn_info) => {
            if !fn_info.reached {
                let mut updated = fn_info;
                updated.reached = true;
                let ok = machine.fns.try_set(func_index, updated);
                work.push(func_index);
            }
        },
        Option::None => {},
    }
}

// Splits a `Write` place at its dots into a `writes` row.
fn split_place(inout machine: M, place: u32, code: u64) -> u64 {
    let text_start = machine.ctx.names.start(place);
    let text_end = machine.ctx.names.end(place);
    let mut parts: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut part: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for i in text_start..text_end {
        let byte = u8_at(in machine.ctx.names.text, i);
        if byte == 46 {
            parts.push(machine.ctx.names.intern(in part[0..part.len()]));
            part.clear();
        } else {
            part.push(byte);
        }
    }
    parts.push(machine.ctx.names.intern(in part[0..part.len()]));
    let seg_start = machine.write_segs.len();
    for i in 1..parts.len() {
        machine.write_segs.push(u32_at(in parts, i));
    }
    let row = machine.writes.len();
    machine.writes.push(Wr {
        root: u32_at(in parts, 0),
        seg_start: seg_start,
        seg_count: wrapping_sub(parts.len(), 1),
        code: code
    });
    row
}

// Whether every function the entry reaches runs on this machine; fills
// `aux` for their instructions.
pub fn scan(inout machine: M) {
    let mut work: ChunkSeq[u64] = ChunkSeq::new[u64]();
    reach(inout machine, machine.entry, inout work);
    loop {
        if machine.declined {
            return;
        }
        let func_index = match work.pop() {
            Option::Some(func_index) => func_index,
            Option::None => {
                break;
            },
        };
        let fn_info = match machine.fns.try_get(func_index) {
            Option::Some(found) => found,
            Option::None => {
                break;
            },
        };
        let fn_row = machine.program.function(func_index);
        // Header types: parameters, result, effects aside, values.
        let mut cursor = fn_row.ha;
        let param_count = machine.program.op(cursor);
        cursor = inc(cursor);
        let cont_name = u32_at(in machine.cont_names, func_index);
        let mut cont_type: u32 = 0;
        for i in 0..param_count {
            let param_name = n32(machine.program.op(cursor));
            let path_count = machine.program.op(add(cursor, 2));
            cursor = add(cursor, add(3, path_count));
            let param_type = n32(machine.program.op(cursor));
            if cont_name != 0 && param_name == wrapping_sub(cont_name, 1) {
                cont_type = wrapping_add(param_type, 1);
            } else if !type_ok(in machine, param_type, 0) {
                decline(inout machine, "a parameter type of ", fn_info.name);
            } else if inner_effects(in machine, param_type, 0) {
                decline(
                    inout machine,
                    "an effectful function inside a parameter of ",
                    fn_info.name
                );
            }
            cursor = add(cursor, 3);
        }
        if !type_ok(in machine, n32(machine.program.op(cursor)), 0) {
            decline(inout machine, "the result type of ", fn_info.name);
        }
        for block_index in 0..fn_row.bc {
            let block_id = add(fn_row.b0, block_index);
            let block = machine.program.block(block_id);
            for inst_index in 0..block.ic {
                let inst_id = add(block.i0, inst_index);
                let inst = machine.program.inst(inst_id);
                // A read of the continuation may name its type with the state's
                // type resolved.
                let reads_cont = cont_name != 0
                    && inst.op == Op::Read
                    && n32(machine.program.op(inst.a)) == wrapping_sub(cont_name, 1)
                    && machine.program.op(inc(inst.a)) == 0;
                if !(cont_type != 0 && inst.ty == wrapping_sub(cont_type, 1))
                    && !reads_cont
                    && !type_ok(in machine, inst.ty, 0)
                {
                    decline(inout machine, "a value type in ", fn_info.name);
                }
                let operand_at = inst.a;
                let op = inst.op;
                if op == Op::Const {
                    scan_literal(inout machine, operand_at);
                } else if op == Op::Read {
                    let root = n32(machine.program.op(operand_at));
                    let path = machine.program.op(inc(operand_at));
                    let callee_index = fn_index(in machine, root);
                    if callee_index != NONE64 && path == 0 {
                        reach(inout machine, callee_index, inout work);
                    }
                } else if op == Op::Bind {
                    scan_pattern(inout machine, inc(operand_at));
                } else if op == Op::Write {
                    let op_sym = n32(machine.program.op(inc(operand_at)));
                    let mut code: u64 = 0;
                    if !spells(in machine, op_sym, "=") {
                        if has_prefix(in machine, op_sym, "[]") {
                            decline(inout machine, "an array element write", NONE32);
                        }
                        let op_start = machine.ctx.names.start(op_sym);
                        let mut first_text: ChunkSeq[u8] = ChunkSeq::new[u8]();
                        first_text.push(u8_at(in machine.ctx.names.text, op_start));
                        let first_sym = machine.ctx.names.intern(in first_text[0..1]);
                        code = op_code(in machine, first_sym);
                        if code == 0 {
                            decline(inout machine, "the compound assignment ", op_sym);
                        }
                    }
                    let row = split_place(inout machine, n32(machine.program.op(operand_at)), code);
                    let ok = machine.aux.try_set(inst_id, row);
                } else if op == Op::Unary {
                    let code = unary_code(in machine, n32(machine.program.op(operand_at)));
                    if code == 0 {
                        decline(
                            inout machine,
                            "the unary operator ",
                            n32(machine.program.op(operand_at))
                        );
                    }
                    let ok = machine.aux.try_set(inst_id, code);
                } else if op == Op::Binary {
                    let code = op_code(in machine, n32(machine.program.op(operand_at)));
                    if code == 0 {
                        decline(
                            inout machine,
                            "the binary operator ",
                            n32(machine.program.op(operand_at))
                        );
                    }
                    let ok = machine.aux.try_set(inst_id, code);
                } else if op == Op::Data {
                    let ctor = ctor_of(inout machine, n32(machine.program.op(operand_at)));
                    let ok = machine
                        .aux
                        .try_set(inst_id, if ctor == NONE32 { 0 } else { inc(w(ctor)) });
                } else if op == Op::Call {
                    let callee = n32(machine.program.op(operand_at));
                    let callee_index = fn_index(in machine, callee);
                    if callee_index == NONE64 {
                        if site(in machine, inst_id, SITE_EFFECT_CALL) == NONE64 {
                            decline(inout machine, "a call of ", callee);
                        } else if has_inout_arg(in machine, inc(operand_at)) {
                            // A clause would bind the caller's place, not a copy.
                            decline(
                                inout machine,
                                "an effect operation with an inout argument",
                                NONE32
                            );
                        } else {
                            let ok = machine.aux.try_set(inst_id, NONE64);
                        }
                    } else {
                        reach(inout machine, callee_index, inout work);
                        let ok = machine.aux.try_set(inst_id, callee_index);
                    }
                } else if op == Op::Tuple
                    || op == Op::Exit
                    || op == Op::Unit
                    || op == Op::Project
                    || op == Op::Index
                    || op == Op::Indirect
                    || op == Op::Try
                    || op == Op::Loop
                {} else if op == Op::Closure {
                    let closure_site = site(in machine, inst_id, SITE_CLOSURE);
                    let body = if closure_site == NONE64 {
                        NONE64
                    } else {
                        site_fn(
                            in machine,
                            site_word(
                                in machine,
                                add(closure_tail(in machine, closure_site), CT_BODY)
                            )
                        )
                    };
                    if body == NONE64 {
                        decline(inout machine, "a closure in ", fn_info.name);
                    } else {
                        reach(inout machine, body, inout work);
                    }
                } else if op == Op::Handle {
                    let handle_site = site(in machine, inst_id, SITE_HANDLE);
                    if handle_site == NONE64 {
                        decline(inout machine, "a handler in ", fn_info.name);
                    } else {
                        scan_handle(inout machine, handle_site, inout work);
                    }
                } else if op == Op::Seq {
                    let label = machine.program.pool_row(machine.program.op(operand_at)).label;
                    let code = seq_code(in machine, label);
                    let ok = machine.aux.try_set(inst_id, code);
                    if code == 0 {
                        decline(inout machine, "a sequence operation in ", fn_info.name);
                    }
                } else if op == Op::Fip {
                    // `Box::new` and its reuse forms: a `Box` data value.
                } else {
                    decline(inout machine, "a vector or tiled operation in ", fn_info.name);
                }
            }
            if block.term == Term::Match {
                let n = machine.program.op(inc(block.ta));
                let mut pat_at = add(block.ta, 2);
                for i in 0..n {
                    scan_pattern(inout machine, pat_at);
                    pat_at = inc(pat_end(in machine, pat_at));
                }
            }
        }
    }
}

// ----- values ------------------------------------------------------------------

fn agg(in machine: M, value: Val) -> Agg {
    if value.payload == NONE64 {
        return Agg { ctor: 0, kid_start: 0, kid_count: 0 };
    }
    match machine.heap.try_get(value.payload) {
        Option::Some(found) => found,
        Option::None => Agg { ctor: 0, kid_start: 0, kid_count: 0 },
    }
}

fn kid(in machine: M, kid_index: u64) -> Val {
    match machine.kids.try_get(kid_index) {
        Option::Some(v) => v,
        Option::None => undef(),
    }
}

// A new aggregate from `kids[a..]` (appended by the caller).
fn make(inout machine: M, tag: u8, ctor: u32, kid_start: u64) -> Val {
    let kid_count = wrapping_sub(machine.kids.len(), kid_start);
    if tag == T_TUPLE && kid_count == 0 {
        return unit();
    }
    let heap_index = machine.heap.len();
    machine.heap.push(Agg { ctor: ctor, kid_start: kid_start, kid_count: kid_count });
    Val { tag: tag, payload: heap_index }
}

fn push_kid(inout machine: M, name: u32, value: Val) {
    machine.kids.push(value);
    machine.kid_names.push(name);
}

// The index of field `name` of a data value, or NONE64.
fn field_index(in machine: M, aggregate: Agg, name: u32) -> u64 {
    for i in 0..aggregate.kid_count {
        if u32_at(in machine.kid_names, add(aggregate.kid_start, i)) == name {
            return i;
        }
    }
    NONE64
}

fn sym_less(in machine: M, lhs: u32, rhs: u32) -> bool {
    let lhs_start = machine.ctx.names.start(lhs);
    let lhs_end = machine.ctx.names.end(lhs);
    let rhs_start = machine.ctx.names.start(rhs);
    let rhs_end = machine.ctx.names.end(rhs);
    let lhs_len = wrapping_sub(lhs_end, lhs_start);
    let rhs_len = wrapping_sub(rhs_end, rhs_start);
    let common_len = if lhs_len < rhs_len { lhs_len } else { rhs_len };
    for i in 0..common_len {
        let lhs_byte = u8_at(in machine.ctx.names.text, add(lhs_start, i));
        let rhs_byte = u8_at(in machine.ctx.names.text, add(rhs_start, i));
        if lhs_byte != rhs_byte {
            return lhs_byte < rhs_byte;
        }
    }
    lhs_len < rhs_len
}

// `Value::Display`.
fn display(in machine: M, value: Val, inout out: ChunkSeq[u8], depth: u64) {
    if value.tag <= K_I32 {
        if is_signed(value.tag) {
            put_signed(inout out, wrapping_i64(value.payload));
        } else {
            push_decimal(inout out, value.payload);
        }
    } else if value.tag == T_F64 {
        put_float(
            inout out,
            value.payload,
            F64_SIGN,
            F64_EXPONENT,
            F64_FRACTION,
            shortest(value.payload)
        );
    } else if value.tag == T_F32 {
        put_float(
            inout out,
            value.payload,
            F32_SIGN,
            F32_EXPONENT,
            F32_FRACTION,
            shortest_f32(value.payload)
        );
    } else if value.tag == T_BOOL {
        if value.payload != 0 {
            put(inout out, "true");
        } else {
            put(inout out, "false");
        }
    } else if value.tag == T_STR {
        let text = str_at(in machine, value.payload);
        debug_str(inout out, in machine.str_bytes, text.at, add(text.at, text.len));
    } else if value.tag == T_FN {
        put(inout out, "<fn ");
        put_sym(inout out, in machine.ctx.names, n32(value.payload));
        put(inout out, ">");
    } else if value.tag == T_BOUND {
        put(inout out, "<fn ");
        put_sym(inout out, in machine.ctx.names, bd_at(in machine, value.payload).callee);
        put(inout out, ">");
    } else if value.tag == T_CONT {
        put(inout out, "<one-shot continuation>");
    } else if value.tag == T_CLOS {
        put(inout out, "<closure>");
    } else if value.tag == T_SEQ {
        put(inout out, "<ChunkSeq len=");
        push_decimal(inout out, sq_at(in machine, value.payload).len);
        put(inout out, ">");
    } else if value.tag == T_SLICE {
        let view = sl_at(in machine, value.payload);
        put(inout out, "<Slice ");
        push_decimal(inout out, view.start);
        put(inout out, "..");
        push_decimal(inout out, add(view.start, view.len));
        put(inout out, ">");
    } else if value.tag == T_TUPLE {
        let aggregate = agg(in machine, value);
        out.push(40);
        for i in 0..aggregate.kid_count {
            if i > 0 {
                put(inout out, ", ");
            }
            display(
                in machine,
                kid(in machine, add(aggregate.kid_start, i)),
                inout out,
                inc(depth)
            );
        }
        out.push(41);
    } else if value.tag == T_DATA {
        let aggregate = agg(in machine, value);
        put_sym(inout out, in machine.ctx.names, aggregate.ctor);
        if aggregate.kid_count == 0 {
            return;
        }
        // The fields in `BTreeMap` order, or by number when every name
        // is one.
        let mut numeric = true;
        for i in 0..aggregate.kid_count {
            if index_of(in machine, u32_at(in machine.kid_names, add(aggregate.kid_start, i)))
                == NONE64
            {
                numeric = false;
            }
        }
        let mut order: ChunkSeq[u64] = ChunkSeq::new[u64]();
        for i in 0..aggregate.kid_count {
            order.push(i);
        }
        // insertion sort (data values have few fields)
        for i in 1..aggregate.kid_count {
            let mut j = i;
            loop {
                if j == 0 {
                    break;
                }
                let prev_field = u64_at(in order, wrapping_sub(j, 1));
                let cur_field = u64_at(in order, j);
                let prev_sym = u32_at(in machine.kid_names, add(aggregate.kid_start, prev_field));
                let cur_sym = u32_at(in machine.kid_names, add(aggregate.kid_start, cur_field));
                let less = if numeric {
                    index_of(in machine, cur_sym) < index_of(in machine, prev_sym)
                } else {
                    sym_less(in machine, cur_sym, prev_sym)
                };
                if !less {
                    break;
                }
                let ok1 = order.try_set(wrapping_sub(j, 1), cur_field);
                let ok2 = order.try_set(j, prev_field);
                j = wrapping_sub(j, 1);
            }
        }
        if numeric {
            out.push(40);
        } else {
            put(inout out, " { ");
        }
        for i in 0..aggregate.kid_count {
            if i > 0 {
                put(inout out, ", ");
            }
            let kid_index = add(aggregate.kid_start, u64_at(in order, i));
            if !numeric {
                put_sym(inout out, in machine.ctx.names, u32_at(in machine.kid_names, kid_index));
                put(inout out, ": ");
            }
            display(in machine, kid(in machine, kid_index), inout out, inc(depth));
        }
        if numeric {
            out.push(41);
        } else {
            put(inout out, " }");
        }
    }
}

// Rust's `{}` of a float with bit pattern `bits` (fields `sign`,
// `exponent`, `fraction`) and shortest digits `digits`: `NaN`, `inf`,
// `-inf`, or the shortest round-trip decimal without an exponent.
fn put_float(
    inout out: ChunkSeq[u8],
    bits: u64,
    sign: u64,
    exponent: u64,
    fraction: u64,
    digits: Shortest
) {
    if bits & exponent == exponent {
        if bits & fraction != 0 {
            put(inout out, "NaN");
        } else if bits & sign != 0 {
            put(inout out, "-inf");
        } else {
            put(inout out, "inf");
        }
        return;
    }
    let len = shortest_len(digits);
    let mut text: ChunkSeq[u8] = ChunkSeq::with_capacity(len);
    for _i in 0..len {
        text.push(0);
    }
    put_shortest(inout text.as_slice_mut(), 0, digits);
    out.extend(in text.as_slice());
}

fn hex(digit: u64) -> u8 {
    if digit < 10 {
        wrapping_u8(add(digit, 48))
    } else {
        wrapping_u8(add(digit, 87))
    }
}

// Rust's `{:?}` of an ASCII string `bytes[text_start..text_end]`. Other
// bytes are copied, and `run` declines a result whose text has one.
fn debug_str(inout out: ChunkSeq[u8], in bytes: ChunkSeq[u8], text_start: u64, text_end: u64) {
    out.push(34);
    for i in text_start..text_end {
        let byte = u8_at(in bytes, i);
        if byte == 34 {
            out.push(92);
            out.push(34);
        } else if byte == 92 {
            out.push(92);
            out.push(92);
        } else if byte == 10 {
            out.push(92);
            out.push(110);
        } else if byte == 13 {
            out.push(92);
            out.push(114);
        } else if byte == 9 {
            out.push(92);
            out.push(116);
        } else if byte == 0 {
            out.push(92);
            out.push(48);
        } else if byte < 32 || byte == 127 {
            put(inout out, "\\u{");
            let code_point = widen_u64(byte);
            if code_point >= 16 {
                out.push(hex(code_point / 16));
            }
            out.push(hex(code_point % 16));
            out.push(125);
        } else {
            out.push(byte);
        }
    }
    out.push(34);
}

// `equal`.
fn equal(in machine: M, lhs: Val, rhs: Val) -> bool {
    if lhs.tag == T_STR {
        return rhs.tag == T_STR && text_order(in machine, lhs, rhs) == ORDER_EQUAL;
    }
    if lhs.tag <= K_I32 || lhs.tag == T_BOOL {
        return lhs.tag == rhs.tag && lhs.payload == rhs.payload;
    }
    // IEEE 754 equality: a NaN equals nothing, and -0 equals 0.
    if lhs.tag == T_F64 {
        return rhs.tag == T_F64 && f64_of(lhs) == f64_of(rhs);
    }
    if lhs.tag == T_F32 {
        return rhs.tag == T_F32 && f32_of(lhs) == f32_of(rhs);
    }
    if lhs.tag == T_TUPLE && rhs.tag == T_TUPLE {
        let lhs_agg = agg(in machine, lhs);
        let rhs_agg = agg(in machine, rhs);
        if lhs_agg.kid_count != rhs_agg.kid_count {
            return false;
        }
        for i in 0..lhs_agg.kid_count {
            if !equal(
                in machine,
                kid(in machine, add(lhs_agg.kid_start, i)),
                kid(in machine, add(rhs_agg.kid_start, i))
            ) {
                return false;
            }
        }
        return true;
    }
    if lhs.tag == T_DATA && rhs.tag == T_DATA {
        let lhs_agg = agg(in machine, lhs);
        let rhs_agg = agg(in machine, rhs);
        if lhs_agg.ctor != rhs_agg.ctor || lhs_agg.kid_count != rhs_agg.kid_count {
            return false;
        }
        for i in 0..lhs_agg.kid_count {
            let rhs_field = field_index(
                in machine,
                rhs_agg,
                u32_at(in machine.kid_names, add(lhs_agg.kid_start, i))
            );
            if rhs_field == NONE64 {
                return false;
            }
            if !equal(
                in machine,
                kid(in machine, add(lhs_agg.kid_start, i)),
                kid(in machine, add(rhs_agg.kid_start, rhs_field))
            ) {
                return false;
            }
        }
        return true;
    }
    false
}

// ----- places ------------------------------------------------------------------

// The child of `value` named by segment `seg` (`slot_get`'s step), or an
// error: 1 unknown field, 2 not a tuple index, 3 out of bounds, 4 not an
// aggregate.
fn child(in machine: M, value: Val, seg: u32, inout err: u64) -> u64 {
    let aggregate = agg(in machine, value);
    if value.tag == T_DATA {
        let index = field_index(in machine, aggregate, seg);
        if index == NONE64 {
            err = 1;
        }
        return index;
    }
    if value.tag == T_TUPLE {
        let index = index_of(in machine, seg);
        if index == NONE64 {
            err = 2;
            return index;
        }
        if index >= aggregate.kid_count {
            err = 3;
            return NONE64;
        }
        return index;
    }
    err = 4;
    NONE64
}

// `slot_get` of `cells[cell]` along `machine.path`.
fn read_path(inout machine: M, cell: u64) -> Val {
    let mut value = match machine.cells.try_get(cell) {
        Option::Some(value) => value,
        Option::None => undef(),
    };
    for i in 0..machine.path.len() {
        let seg = u32_at(in machine.path, i);
        let mut err: u64 = 0;
        let child_index = child(in machine, value, seg, inout err);
        if err == 1 {
            fail_sym(inout machine, "unknown field ", seg, "");
            // Rust quotes the field: `unknown field 'f'`.
            machine.message.clear();
            put(inout machine.message, "unknown field '");
            put_sym(inout machine.message, in machine.ctx.names, seg);
            put(inout machine.message, "'");
            return undef();
        } else if err == 2 {
            fail(inout machine, "invalid tuple index");
            return undef();
        } else if err == 3 {
            fail(inout machine, "tuple index out of bounds");
            return undef();
        } else if err == 4 {
            fail(inout machine, "field access requires aggregate");
            return undef();
        }
        value = kid(in machine, add(agg(in machine, value).kid_start, child_index));
    }
    value
}

// `value` with the value at `machine.path[seg_index..]` replaced by `new`.
fn put_path(inout machine: M, value: Val, seg_index: u64, new: Val) -> Val {
    if seg_index >= machine.path.len() {
        return new;
    }
    let seg = u32_at(in machine.path, seg_index);
    let mut err: u64 = 0;
    let child_index = child(in machine, value, seg, inout err);
    if err == 1 {
        fail(inout machine, "unknown field");
        return undef();
    } else if err == 2 {
        fail(inout machine, "invalid index");
        return undef();
    } else if err == 3 {
        fail(inout machine, "index out of bounds");
        return undef();
    } else if err == 4 {
        fail(inout machine, "assignment requires aggregate");
        return undef();
    }
    let aggregate = agg(in machine, value);
    let inner = put_path(
        inout machine,
        kid(in machine, add(aggregate.kid_start, child_index)),
        inc(seg_index),
        new
    );
    if machine.failed {
        return undef();
    }
    let kid_start = machine.kids.len();
    for j in 0..aggregate.kid_count {
        let name = u32_at(in machine.kid_names, add(aggregate.kid_start, j));
        if j == child_index {
            push_kid(inout machine, name, inner);
        } else {
            push_kid(inout machine, name, kid(in machine, add(aggregate.kid_start, j)));
        }
    }
    make(inout machine, value.tag, aggregate.ctor, kid_start)
}

fn write_path(inout machine: M, cell: u64, new: Val) {
    let old = match machine.cells.try_get(cell) {
        Option::Some(value) => value,
        Option::None => undef(),
    };
    let updated = put_path(inout machine, old, 0, new);
    if !machine.failed {
        let ok = machine.cells.try_set(cell, updated);
    }
}

// The latest binding of `name` in the current activation, or NONE64.
fn binding(in machine: M, name: u32) -> u64 {
    let mut index = machine.env.len();
    loop {
        if index <= machine.frame.env_base {
            return NONE64;
        }
        index = wrapping_sub(index, 1);
        match machine.env.try_get(index) {
            Option::Some(env_entry) => {
                if env_entry.name == name {
                    return index;
                }
            },
            Option::None => {},
        }
    }
}

fn entry(in machine: M, index: u64) -> En {
    match machine.env.try_get(index) {
        Option::Some(found) => found,
        Option::None => En { name: 0, cell: 0, seg_start: 0, seg_count: 0 },
    }
}

// `machine.path` = the slot path of binding `env_entry`.
fn slot_path(inout machine: M, env_entry: En) {
    machine.path.clear();
    for i in 0..env_entry.seg_count {
        machine.path.push(u32_at(in machine.segs, add(env_entry.seg_start, i)));
    }
}

// Binds `name` to `value`. The Rust evaluator's environment is a map, so a
// rebinding (a loop body's pattern, each iteration) replaces the entry,
// reusing the entry's own cell: nothing else refers to it once no call is
// in flight. The environment stays as small as Rust's.
fn bind_new(inout machine: M, name: u32, value: Val) {
    let bound_index = binding(in machine, name);
    if bound_index != NONE64 {
        let env_entry = entry(in machine, bound_index);
        if env_entry.seg_count == 0 && env_entry.cell >= machine.frame.cell_base {
            let ok = machine.cells.try_set(env_entry.cell, value);
            return;
        }
        let cell = machine.cells.len();
        machine.cells.push(value);
        let ok = machine
            .env
            .try_set(bound_index, En { name: name, cell: cell, seg_start: 0, seg_count: 0 });
        return;
    }
    let cell = machine.cells.len();
    machine.cells.push(value);
    machine.env.push(En { name: name, cell: cell, seg_start: 0, seg_count: 0 });
}

// ----- patterns ----------------------------------------------------------------

// Whether literal words `at` (kind, lo, hi) match `value` (`bind_pattern`).
fn literal_matches(in machine: M, at: u64, value: Val) -> bool {
    let kind = machine.program.op(at);
    let lo = machine.program.op(inc(at));
    let hi = machine.program.op(add(at, 2));
    if kind == widen_u64(Lit::Int) {
        if value.tag > K_I32 {
            return false;
        }
        let value_hi = if is_signed(value.tag) && wrapping_i64(value.payload) < 0 {
            NONE64
        } else {
            0
        };
        return lo == value.payload && hi == value_hi;
    }
    if kind == widen_u64(Lit::Bool) {
        return value.tag == T_BOOL && value.payload == lo;
    }
    if kind == widen_u64(Lit::Float) {
        if value.tag == T_F64 {
            return from_bits_f64(lo) == f64_of(value);
        }
        return value.tag == T_F32 && nearest_f32(from_bits_f64(lo)) == f32_of(value);
    }
    if kind == widen_u64(Lit::String) {
        return value.tag == T_STR && text_spells(in machine, value, n32(lo));
    }
    false
}

fn pat_matches(inout machine: M, at: u64, value: Val) -> bool {
    let kind = machine.program.op(at);
    let body_at = add(at, 3);
    if kind == widen_u64(Pat::Wild) || kind == widen_u64(Pat::Bind) {
        return true;
    }
    if kind == widen_u64(Pat::Literal) {
        return literal_matches(in machine, body_at, value);
    }
    if kind == widen_u64(Pat::Tuple) {
        if value.tag != T_TUPLE {
            return false;
        }
        let aggregate = agg(in machine, value);
        let n = machine.program.op(body_at);
        if n != aggregate.kid_count {
            return false;
        }
        let mut sub_at = inc(body_at);
        for i in 0..n {
            if !pat_matches(inout machine, sub_at, kid(in machine, add(aggregate.kid_start, i))) {
                return false;
            }
            sub_at = pat_end(in machine, sub_at);
        }
        return true;
    }
    if kind == widen_u64(Pat::Constructor) {
        if value.tag != T_DATA {
            return false;
        }
        let aggregate = agg(in machine, value);
        if short_of(inout machine, n32(machine.program.op(body_at))) != aggregate.ctor {
            return false;
        }
        let n = machine.program.op(add(body_at, 2));
        let mut sub_at = add(body_at, 3);
        for i in 0..n {
            let field_sym = n32(machine.program.op(sub_at));
            let field_pos = field_index(in machine, aggregate, field_sym);
            if field_pos == NONE64 {
                return false;
            }
            if !pat_matches(
                inout machine,
                inc(sub_at),
                kid(in machine, add(aggregate.kid_start, field_pos))
            ) {
                return false;
            }
            sub_at = pat_end(in machine, inc(sub_at));
        }
        return true;
    }
    false
}

// Binds a pattern `pat_matches` accepted, each name in a new cell.
fn pat_bind(inout machine: M, at: u64, value: Val) {
    let kind = machine.program.op(at);
    let body_at = add(at, 3);
    if kind == widen_u64(Pat::Bind) {
        bind_new(inout machine, n32(machine.program.op(body_at)), value);
    } else if kind == widen_u64(Pat::Tuple) {
        let aggregate = agg(in machine, value);
        let n = machine.program.op(body_at);
        let mut sub_at = inc(body_at);
        for i in 0..n {
            pat_bind(inout machine, sub_at, kid(in machine, add(aggregate.kid_start, i)));
            sub_at = pat_end(in machine, sub_at);
        }
    } else if kind == widen_u64(Pat::Constructor) {
        let aggregate = agg(in machine, value);
        let n = machine.program.op(add(body_at, 2));
        let mut sub_at = add(body_at, 3);
        for i in 0..n {
            let field_pos = field_index(in machine, aggregate, n32(machine.program.op(sub_at)));
            pat_bind(
                inout machine,
                inc(sub_at),
                kid(in machine, add(aggregate.kid_start, field_pos))
            );
            sub_at = pat_end(in machine, inc(sub_at));
        }
    }
}

// ----- operators ---------------------------------------------------------------

fn int_val(kind: u8, value: i128) -> Val {
    Val { tag: kind, payload: wrap(kind, value) }
}

fn bool_val(value: bool) -> Val {
    Val { tag: T_BOOL, payload: if value { 1 } else { 0 } }
}

// `binary` (without floats and 128-bit integers); the failure code in `failure`.
fn binary(inout machine: M, code: u64, lhs: Val, rhs: Val, inout failure: u8) -> Val {
    let op = wrapping_u8(code);
    if lhs.tag <= K_I32 && rhs.tag <= K_I32 {
        let lhs_kind = lhs.tag;
        if op == B_SHL || op == B_SHR {
            let result = shift(
                lhs_kind,
                op,
                exact(lhs_kind, lhs.payload),
                exact(rhs.tag, rhs.payload),
                inout failure
            );
            return int_val(lhs_kind, result);
        }
        if op == B_ROTL || op == B_ROTR {
            return int_val(
                lhs_kind,
                rotate(
                    lhs_kind,
                    op == B_ROTL,
                    exact(lhs_kind, lhs.payload),
                    exact(rhs.tag, rhs.payload)
                )
            );
        }
        let kind = if lhs_kind != K_I64 { lhs_kind } else { rhs.tag };
        let lhs_int = exact(kind, wrap(kind, exact(lhs_kind, lhs.payload)));
        let rhs_int = exact(kind, wrap(kind, exact(rhs.tag, rhs.payload)));
        if op == B_ADD || op == B_SUB || op == B_MUL || op == B_DIV || op == B_REM {
            let result = checked(kind, op, lhs_int, rhs_int, inout failure);
            return int_val(kind, result);
        }
        if op == B_WADD || op == B_WSUB || op == B_WMUL {
            return int_val(kind, wrapping(kind, op, lhs_int, rhs_int));
        }
        if op == B_BAND || op == B_BOR || op == B_BXOR || op == B_BSHL || op == B_BSHR {
            return int_val(kind, bitwise(kind, op, lhs_int, rhs_int));
        }
        if op == B_AND || op == B_OR || op == B_XOR {
            return int_val(kind, bit(kind, op, lhs_int, rhs_int));
        }
        if op == B_EQ {
            return bool_val(lhs_int == rhs_int);
        } else if op == B_NE {
            return bool_val(lhs_int != rhs_int);
        } else if op == B_LT {
            return bool_val(lhs_int < rhs_int);
        } else if op == B_LE {
            return bool_val(lhs_int <= rhs_int);
        } else if op == B_GT {
            return bool_val(lhs_int > rhs_int);
        } else if op == B_GE {
            return bool_val(lhs_int >= rhs_int);
        }
        fail(inout machine, "invalid integer operator");
        return undef();
    }
    if lhs.tag == T_F64 && rhs.tag == T_F64 {
        return f64_binary(inout machine, op, f64_of(lhs), f64_of(rhs));
    }
    if lhs.tag == T_F32 && rhs.tag == T_F32 {
        return f32_binary(inout machine, op, f32_of(lhs), f32_of(rhs));
    }
    if lhs.tag == T_BOOL && rhs.tag == T_BOOL {
        if op == B_LAND {
            return bool_val(lhs.payload != 0 && rhs.payload != 0);
        } else if op == B_LOR {
            return bool_val(lhs.payload != 0 || rhs.payload != 0);
        } else if op == B_EQ {
            return bool_val(lhs.payload == rhs.payload);
        } else if op == B_NE {
            return bool_val(lhs.payload != rhs.payload);
        }
        fail(inout machine, "invalid boolean operator");
        return undef();
    }
    if lhs.tag == T_STR && rhs.tag == T_STR {
        let order = text_order(in machine, lhs, rhs);
        if op == B_EQ {
            return bool_val(order == ORDER_EQUAL);
        } else if op == B_NE {
            return bool_val(order != ORDER_EQUAL);
        } else if op == B_LT {
            return bool_val(order == ORDER_LESS);
        } else if op == B_LE {
            return bool_val(order != ORDER_GREATER);
        } else if op == B_GT {
            return bool_val(order == ORDER_GREATER);
        } else if op == B_GE {
            return bool_val(order != ORDER_LESS);
        }
        fail(inout machine, "invalid string operator");
        return undef();
    }
    if op == B_EQ {
        return bool_val(equal(in machine, lhs, rhs));
    } else if op == B_NE {
        return bool_val(!equal(in machine, lhs, rhs));
    }
    fail(inout machine, "incompatible binary operands");
    undef()
}

// `binary` of two `f64` values.
fn f64_binary(inout machine: M, op: u8, a: f64, b: f64) -> Val {
    if op == B_ADD {
        return f64_val(a + b);
    } else if op == B_SUB {
        return f64_val(a - b);
    } else if op == B_MUL {
        return f64_val(a * b);
    } else if op == B_DIV {
        return f64_val(a / b);
    } else if op == B_REM {
        return f64_val(a % b);
    } else if op == B_EQ {
        return bool_val(a == b);
    } else if op == B_NE {
        return bool_val(a != b);
    } else if op == B_LT {
        return bool_val(a < b);
    } else if op == B_LE {
        return bool_val(a <= b);
    } else if op == B_GT {
        return bool_val(a > b);
    } else if op == B_GE {
        return bool_val(a >= b);
    }
    fail(inout machine, "invalid float operator");
    undef()
}

// `binary` of two `f32` values.
fn f32_binary(inout machine: M, op: u8, a: f32, b: f32) -> Val {
    if op == B_ADD {
        return f32_val(a + b);
    } else if op == B_SUB {
        return f32_val(a - b);
    } else if op == B_MUL {
        return f32_val(a * b);
    } else if op == B_DIV {
        return f32_val(a / b);
    } else if op == B_REM {
        return f32_val(a % b);
    } else if op == B_EQ {
        return bool_val(a == b);
    } else if op == B_NE {
        return bool_val(a != b);
    } else if op == B_LT {
        return bool_val(a < b);
    } else if op == B_LE {
        return bool_val(a <= b);
    } else if op == B_GT {
        return bool_val(a > b);
    } else if op == B_GE {
        return bool_val(a >= b);
    }
    fail(inout machine, "invalid float operator");
    undef()
}

// A float conversion or bit reinterpretation (`float_unary`); `code` is
// at least U_FLOAT.
fn float_unary(inout machine: M, code: u64, value: Val) -> Val {
    let op = wrapping_sub(code, U_FLOAT) / FLOAT_KINDS;
    let kind = wrapping_sub(code, U_FLOAT) % FLOAT_KINDS;
    if op == FC_WIDEN || op == FC_NEAREST {
        // `nearest_float`: an `f32` widens exactly, an `f64` rounds to the
        // nearest `f32`; `integer_to_float` rounds an integer once.
        if value.tag == T_F64 {
            return if kind == FK_F32 {
                f32_val(nearest_f32(f64_of(value)))
            } else {
                value
            };
        }
        if value.tag == T_F32 {
            return if kind == FK_F64 {
                f64_val(widen_f64(f32_of(value)))
            } else {
                value
            };
        }
        if value.tag > K_I32 {
            fail(inout machine, "invalid float conversion operand");
            return undef();
        }
        let n = exact(value.tag, value.payload);
        if n < 0 {
            let signed = wrapping_i64(n);
            return if kind == FK_F32 {
                f32_val(nearest_f32(signed))
            } else {
                f64_val(nearest_f64(signed))
            };
        }
        let unsigned = wrapping_u64(n);
        return if kind == FK_F32 {
            f32_val(nearest_f32(unsigned))
        } else {
            f64_val(nearest_f64(unsigned))
        };
    }
    if op == FC_TO_BITS {
        // The operand's own bits as the kind's bits integer (u32, u64).
        if value.tag == T_F64 && kind == FK_F64 {
            return Val { tag: K_U64, payload: value.payload };
        }
        if value.tag == T_F32 && kind == FK_F32 {
            return Val { tag: K_U32, payload: value.payload };
        }
        if is_float(value) {
            decline(inout machine, "a mismatched float bit reinterpretation", NONE32);
            return undef();
        }
        fail(inout machine, "invalid to_bits operand");
        return undef();
    }
    if value.tag > K_I32 {
        fail(inout machine, "invalid from_bits operand");
        return undef();
    }
    if kind == FK_F32 {
        return Val { tag: T_F32, payload: value.payload & F32_BITS };
    }
    Val { tag: T_F64, payload: value.payload }
}

// `unary` (without 128-bit integers).
fn unary(inout machine: M, code: u64, value: Val, inout failure: u8) -> Val {
    if code == U_NOT && value.tag == T_BOOL {
        return bool_val(value.payload == 0);
    }
    if code >= U_FLOAT {
        return float_unary(inout machine, code, value);
    }
    if code == U_NEG && value.tag == T_F64 {
        return Val { tag: T_F64, payload: value.payload ^ F64_SIGN };
    }
    if code == U_NEG && value.tag == T_F32 {
        return Val { tag: T_F32, payload: value.payload ^ F32_SIGN };
    }
    if code >= U_CONV && is_float(value) && wrapping_sub(code, U_CONV) / CONV_STRIDE == C_NARROW {
        // A checked float-to-integer conversion (`float_to_integer_checked`).
        decline(inout machine, "a float-to-integer conversion", NONE32);
        return undef();
    }
    if code >= U_CONV {
        let family = wrapping_sub(code, U_CONV) / CONV_STRIDE;
        let target_kind = wrapping_u8(wrapping_sub(code, U_CONV) % CONV_STRIDE);
        if value.tag > K_I32 {
            fail(inout machine, "invalid conversion operand");
            return undef();
        }
        let exact_value = exact(value.tag, value.payload);
        if family == C_WRAPPING {
            return int_val(target_kind, exact_value);
        }
        if !fits(target_kind, exact_value) {
            failure = F_OVERFLOW;
            return undef();
        }
        return int_val(target_kind, exact_value);
    }
    if value.tag > K_I32 {
        fail(inout machine, "invalid unary operands");
        return undef();
    }
    let exact_value = exact(value.tag, value.payload);
    if code == U_NOT || code == U_INV {
        return int_val(value.tag, not(value.tag, exact_value));
    }
    let negated = wrapping_sub(0, exact_value);
    if !fits(value.tag, negated) {
        failure = F_OVERFLOW;
        return undef();
    }
    int_val(value.tag, negated)
}

// ----- the machine -------------------------------------------------------------

fn val(in machine: M, id: u64) -> Val {
    match machine.vals.try_get(add(machine.frame.val_base, id)) {
        Option::Some(value) => value,
        Option::None => undef(),
    }
}

fn set_val(inout machine: M, id: u64, value: Val) {
    let ok = machine.vals.try_set(add(machine.frame.val_base, id), value);
}

fn undefined(inout machine: M, id: u64) {
    if !machine.failed {
        machine.failed = true;
        machine.message.clear();
        put(inout machine.message, "undefined IR value %");
        push_decimal(inout machine.message, id);
    }
}

// The operand value `id`, or an `undefined IR value` failure.
fn get(inout machine: M, id: u64) -> Val {
    let value = val(in machine, id);
    if value.tag == T_UNDEF {
        undefined(inout machine, id);
    }
    value
}

fn func(in machine: M, func_index: u64) -> Fi {
    match machine.fns.try_get(func_index) {
        Option::Some(found) => found,
        Option::None => Fi {
            name: 0,
            param_start: 0,
            param_count: 0,
            value_count: 0,
            first_block: 0,
            reached: false
        },
    }
}

fn param(in machine: M, index: u64) -> Pm {
    match machine.params.try_get(index) {
        Option::Some(found) => found,
        Option::None => Pm { name: 0, pass: 0, ty: 0 },
    }
}

// Ends the current activation with `value` (`Control::Return`).
fn leave(inout machine: M, value: Val) {
    let frame = machine.frame;
    machine.vals.truncate(frame.val_base);
    machine.env.truncate(frame.env_base);
    machine.cells.truncate(frame.cell_base);
    machine.segs.truncate(frame.seg_base);
    machine.ret_value = value;
    machine.control = C_RET;
}

// `exit_to` of a `return` in a nested body (a handler body or clause):
// abandons every frame up to the suspended activation of `owner`, which
// becomes the current one for `leave`.
fn exit_to(inout machine: M, owner: u32) {
    loop {
        let frame = match machine.stack.pop() {
            Option::Some(popped) => popped,
            Option::None => {
                fail_sym(inout machine, "'return' target '", owner, "' is not active");
                return;
            },
        };
        if frame.kind == FR_IR && func(in machine, frame.func_index).name == owner {
            machine.frame = frame;
            return;
        }
    }
}

// Suspends the current activation for a call or `?` (`Frame::IrResume`).
fn suspend(inout machine: M, dest: u32, ty: u32) {
    let mut frame = machine.frame;
    frame.dest = dest;
    frame.ty = ty;
    frame.kind = FR_IR;
    machine.stack.push(frame);
}

// Collects call arguments at operand `args_at` (`n`, then pass, value, root + 1,
// path each) into `arg_vals` (values) and `arg_roots`/`arg_paths` (place
// root + 1 and path, or 0).
fn collect_args(inout machine: M, args_at: u64) -> u64 {
    let n = machine.program.op(args_at);
    machine.arg_vals.clear();
    machine.arg_roots.clear();
    machine.arg_paths.clear();
    for i in 0..n {
        let arg_at = add(inc(args_at), wrapping_mul(i, ARG_WORDS));
        let value = get(inout machine, machine.program.op(inc(arg_at)));
        machine.arg_vals.push(value);
        machine.arg_roots.push(machine.program.op(add(arg_at, 2)));
        machine.arg_paths.push(machine.program.op(add(arg_at, 3)));
    }
    n
}

// `invoke_scoped` of function `func_index` on the collected arguments, after the
// caller was suspended: the callee's activation becomes current.
fn invoke(inout machine: M, func_index: u64) {
    invoke_with(inout machine, func_index, 0, 0, false);
}

// `invoke` over captured names `clos_names[cap_start..cap_start + cap_count]`
// (a closure's environment, shadowed by its parameters). A closure's
// lowered body lists its captures before its parameters, which take the
// arguments.
fn invoke_with(inout machine: M, func_index: u64, cap_start: u64, cap_count: u64, closure: bool) {
    let fn_info = func(in machine, func_index);
    let arg_count = machine.arg_vals.len();
    if arg_count > fn_info.param_count || (!closure && arg_count != fn_info.param_count) {
        fail(inout machine, "argument arity mismatch");
        return;
    }
    let skip = wrapping_sub(fn_info.param_count, arg_count);
    let val_base = machine.vals.len();
    let env_base = machine.env.len();
    let cell_base = machine.cells.len();
    let seg_base = machine.segs.len();
    // The `inout` places resolve in the caller's environment.
    let mut slots: ChunkSeq[En] = ChunkSeq::new[En]();
    for i in 0..arg_count {
        let param_row = param(in machine, add(add(fn_info.param_start, skip), i));
        if param_row.pass == PASS_INOUT {
            let root = u64_at(in machine.arg_roots, i);
            let mut found = false;
            if root != 0 {
                let bound_index = binding(in machine, n32(wrapping_sub(root, 1)));
                if bound_index != NONE64 {
                    let env_entry = entry(in machine, bound_index);
                    let seg_start = machine.segs.len();
                    for j in 0..env_entry.seg_count {
                        machine.segs.push(u32_at(in machine.segs, add(env_entry.seg_start, j)));
                    }
                    let path = u64_at(in machine.arg_paths, i);
                    let path_row = machine.program.path(path);
                    for j in 0..path_row.n {
                        machine.segs.push(machine.program.path_name(path, j));
                    }
                    slots.push(En {
                        name: param_row.name,
                        cell: env_entry.cell,
                        seg_start: seg_start,
                        seg_count: wrapping_sub(machine.segs.len(), seg_start)
                    });
                    found = true;
                }
            }
            let value = val_at(in machine.arg_vals, i);
            if !found && value.tag == T_SLICE {
                // A slice view shares its sequence.
                let cell = machine.cells.len();
                machine.cells.push(value);
                slots.push(En { name: param_row.name, cell: cell, seg_start: 0, seg_count: 0 });
            } else if !found {
                fail(inout machine, "inout argument requires place");
                return;
            }
        } else {
            let mut value = val_at(in machine.arg_vals, i);
            // `qualify_value` with the caller's evidence.
            value = bind_evidence(inout machine, value, param_row.ty, true);
            let cell = machine.cells.len();
            machine.cells.push(value);
            slots.push(En { name: param_row.name, cell: cell, seg_start: 0, seg_count: 0 });
        }
    }
    if machine.declined {
        return;
    }
    // `snapshot_environment`: the captures, by value.
    for i in 0..cap_count {
        let cell = machine.cells.len();
        machine.cells.push(val_at(in machine.clos_vals, add(cap_start, i)));
        machine.env.push(En {
            name: u32_at(in machine.clos_names, add(cap_start, i)),
            cell: cell,
            seg_start: 0,
            seg_count: 0
        });
    }
    for i in 0..slots.len() {
        match slots.try_get(i) {
            Option::Some(env_entry) => machine.env.push(env_entry),
            Option::None => {},
        }
    }
    machine.vals.resize(add(val_base, fn_info.value_count), undef());
    machine
        .frame = Fr {
            func_index: func_index,
            block: fn_info.first_block,
            ip: 0,
            val_base: val_base,
            env_base: env_base,
            cell_base: cell_base,
            seg_base: seg_base,
            dest: 0,
            ty: 0,
            kind: FR_IR,
            serial: 0
        };
}

// Calls value `callee` (`Op::Indirect`).
fn call_value(inout machine: M, callee: Val) {
    if callee.tag == T_CONT {
        resume_cont(inout machine, callee);
        return;
    }
    if callee.tag == T_CLOS {
        call_closure(inout machine, callee);
        return;
    }
    if callee.tag == T_BOUND {
        let bound = bd_at(in machine, callee.payload);
        let func_index = fn_index(in machine, bound.callee);
        if func_index == NONE64 {
            fail_sym(inout machine, "unknown function '", bound.callee, "'");
            return;
        }
        push_evidence_frame(inout machine, bound.ev_start, bound.ev_count);
        invoke(inout machine, func_index);
        return;
    }
    if callee.tag == T_FN {
        let func_index = fn_index(in machine, n32(callee.payload));
        if func_index == NONE64 {
            fail_sym(inout machine, "unknown function '", n32(callee.payload), "'");
            return;
        }
        invoke(inout machine, func_index);
        return;
    }
    fail(inout machine, "value is not callable");
}

// One `ir_step` of the current activation.
fn step(inout machine: M) {
    let block = machine.program.block(machine.frame.block);
    if machine.frame.ip >= block.ic {
        terminate(inout machine, block);
        return;
    }
    let inst_id = add(block.i0, machine.frame.ip);
    let inst = machine.program.inst(inst_id);
    machine.frame.ip = inc(machine.frame.ip);
    let operand_at = inst.a;
    let op = inst.op;
    let mut failure: u8 = F_OK;
    let mut result = unit();
    if op == Op::Loop || op == Op::Unit {
        result = unit();
    } else if op == Op::Exit {
        let value = get(inout machine, machine.program.op(operand_at));
        if machine.failed {
            return;
        }
        let owner = n32(machine.program.op(inc(operand_at)));
        if owner != func(in machine, machine.frame.func_index).name {
            exit_to(inout machine, owner);
            if machine.failed {
                return;
            }
        }
        leave(inout machine, value);
        return;
    } else if op == Op::Const {
        let kind = machine.program.op(operand_at);
        let lo = machine.program.op(inc(operand_at));
        if kind == widen_u64(Lit::Int) {
            let hi = machine.program.op(add(operand_at, 2));
            result = if hi == 0 && (lo >> 63) == 1 {
                Val { tag: K_U64, payload: lo }
            } else {
                Val { tag: K_I64, payload: lo }
            };
        } else if kind == widen_u64(Lit::Bool) {
            result = bool_val(lo != 0);
        } else if kind == widen_u64(Lit::Float) {
            result = Val { tag: T_F64, payload: lo };
        } else {
            result = lit_str(inout machine, n32(lo));
        }
    } else if op == Op::Read {
        let root = n32(machine.program.op(operand_at));
        let path = machine.program.op(inc(operand_at));
        let bound_index = binding(in machine, root);
        if path == 0 && bound_index == NONE64 && fn_index(in machine, root) != NONE64 {
            result = Val { tag: T_FN, payload: w(root) };
        } else {
            if bound_index == NONE64 {
                fail_sym(inout machine, "undefined IR place '", root, "'");
                return;
            }
            let env_entry = entry(in machine, bound_index);
            slot_path(inout machine, env_entry);
            let path_row = machine.program.path(path);
            for j in 0..path_row.n {
                machine.path.push(machine.program.path_name(path, j));
            }
            result = read_path(inout machine, env_entry.cell);
        }
    } else if op == Op::Bind {
        let value = get(inout machine, machine.program.op(operand_at));
        if machine.failed {
            return;
        }
        if !pat_matches(inout machine, inc(operand_at), value) {
            fail(inout machine, "IR binding pattern mismatch");
            return;
        }
        pat_bind(inout machine, inc(operand_at), value);
        result = unit();
    } else if op == Op::Write {
        let value = get(inout machine, machine.program.op(add(operand_at, 2)));
        if machine.failed {
            return;
        }
        let write_row = match machine.writes.try_get(u64_at(in machine.aux, inst_id)) {
            Option::Some(found) => found,
            Option::None => Wr { root: 0, seg_start: 0, seg_count: 0, code: 0 },
        };
        let bound_index = binding(in machine, write_row.root);
        if bound_index == NONE64 {
            fail(inout machine, "undefined IR assignment place");
            return;
        }
        let env_entry = entry(in machine, bound_index);
        slot_path(inout machine, env_entry);
        for j in 0..write_row.seg_count {
            machine.path.push(u32_at(in machine.write_segs, add(write_row.seg_start, j)));
        }
        let mut new = value;
        if write_row.code != 0 {
            let old = read_path(inout machine, env_entry.cell);
            if machine.failed {
                return;
            }
            new = binary(inout machine, write_row.code, old, value, inout failure);
            if failure != F_OK {
                suspend(inout machine, inst.dest, inst.ty);
                raise(inout machine, failure);
                return;
            }
            if machine.failed {
                return;
            }
        }
        write_path(inout machine, env_entry.cell, new);
        result = unit();
    } else if op == Op::Unary {
        let value = get(inout machine, machine.program.op(inc(operand_at)));
        if machine.failed {
            return;
        }
        result = unary(inout machine, u64_at(in machine.aux, inst_id), value, inout failure);
    } else if op == Op::Binary {
        let lhs = get(inout machine, machine.program.op(inc(operand_at)));
        let rhs = get(inout machine, machine.program.op(add(operand_at, 2)));
        if machine.failed {
            return;
        }
        result = binary(inout machine, u64_at(in machine.aux, inst_id), lhs, rhs, inout failure);
    } else if op == Op::Tuple {
        let n = machine.program.op(operand_at);
        let kid_start = machine.kids.len();
        for i in 0..n {
            let value = get(inout machine, machine.program.op(add(inc(operand_at), i)));
            push_kid(inout machine, 0, value);
        }
        if machine.failed {
            return;
        }
        result = make(inout machine, T_TUPLE, 0, kid_start);
    } else if op == Op::Data {
        let ctor_code = u64_at(in machine.aux, inst_id);
        if ctor_code == 0 {
            fail(inout machine, "unknown IR constructor");
            return;
        }
        let n = machine.program.op(inc(operand_at));
        let kid_start = machine.kids.len();
        for i in 0..n {
            let field_at = add(add(operand_at, DATA_FIELDS_AT), wrapping_mul(i, DATA_FIELD_WORDS));
            let value = get(inout machine, machine.program.op(inc(field_at)));
            push_kid(inout machine, n32(machine.program.op(field_at)), value);
        }
        if machine.failed {
            return;
        }
        result = make(inout machine, T_DATA, n32(wrapping_sub(ctor_code, 1)), kid_start);
    } else if op == Op::Project {
        let value = get(inout machine, machine.program.op(operand_at));
        if machine.failed {
            return;
        }
        let field_sym = n32(machine.program.op(inc(operand_at)));
        let aggregate = agg(in machine, value);
        if value.tag == T_DATA {
            let j = field_index(in machine, aggregate, field_sym);
            if j == NONE64 {
                fail(inout machine, "unknown IR field");
                return;
            }
            result = kid(in machine, add(aggregate.kid_start, j));
        } else if value.tag == T_TUPLE {
            let j = index_of(in machine, field_sym);
            if j == NONE64 {
                fail(inout machine, "invalid IR tuple field");
                return;
            }
            if j >= aggregate.kid_count {
                fail(inout machine, "IR tuple field out of bounds");
                return;
            }
            result = kid(in machine, add(aggregate.kid_start, j));
        } else {
            fail(inout machine, "IR projection requires data");
            return;
        }
    } else if op == Op::Closure {
        make_closure(inout machine, inst_id, inst);
        return;
    } else if op == Op::Fip {
        // `Op::Fip` (a non-`dyn` box): `Data { Box, 0: inner }`.
        let n = collect_args(inout machine, inc(operand_at));
        if machine.failed {
            return;
        }
        if n == 0 {
            fail(inout machine, "Box constructor requires 1 argument");
            return;
        }
        let inner = val_at(in machine.arg_vals, 0);
        let kid_start = machine.kids.len();
        push_kid(inout machine, machine.zero_sym, inner);
        result = make(inout machine, T_DATA, machine.ctx.world.k.box_, kid_start);
    } else if op == Op::Seq {
        let n = collect_args(inout machine, inc(operand_at));
        if machine.failed {
            return;
        }
        let mut oob = false;
        result = seq_op(inout machine, u64_at(in machine.aux, inst_id), inout oob);
        if machine.failed || machine.declined {
            return;
        }
        if oob {
            suspend(inout machine, inst.dest, inst.ty);
            raise(inout machine, P_INDEX);
            return;
        }
    } else if op == Op::Index {
        let index_value = get(inout machine, machine.program.op(inc(operand_at)));
        if machine.failed {
            return;
        }
        if index_value.tag > K_I32 {
            fail(inout machine, "IR index must be integer");
            return;
        }
        let neg = is_signed(index_value.tag) && wrapping_i64(index_value.payload) < 0;
        let base = get(inout machine, machine.program.op(operand_at));
        if machine.failed {
            return;
        }
        if base.tag != T_TUPLE {
            fail(inout machine, "IR index requires tuple");
            return;
        }
        let aggregate = agg(in machine, base);
        if neg || index_value.payload >= aggregate.kid_count {
            suspend(inout machine, inst.dest, inst.ty);
            raise(inout machine, P_INDEX);
            return;
        }
        result = kid(in machine, add(aggregate.kid_start, index_value.payload));
    } else if op == Op::Call {
        let n = collect_args(inout machine, inc(operand_at));
        if machine.failed {
            return;
        }
        suspend(inout machine, inst.dest, inst.ty);
        let callee_index = u64_at(in machine.aux, inst_id);
        if callee_index == NONE64 {
            // An effect operation (`Value::EffectOp`).
            let at = site(in machine, inst_id, SITE_EFFECT_CALL);
            perform(
                inout machine,
                n32(site_word(in machine, add(at, EC_EFFECT))),
                n32(site_word(in machine, add(at, EC_OP))),
                site_word(in machine, add(at, EC_KEY)),
                site_word(in machine, add(at, EC_LABEL))
            );
            return;
        }
        invoke(inout machine, callee_index);
        return;
    } else if op == Op::Handle {
        suspend(inout machine, inst.dest, inst.ty);
        machine.pending = inst_id;
        machine.control = C_INSTALL;
        return;
    } else if op == Op::Indirect {
        let callee = get(inout machine, machine.program.op(operand_at));
        let n = collect_args(inout machine, inc(operand_at));
        if machine.failed {
            return;
        }
        suspend(inout machine, inst.dest, inst.ty);
        call_value(inout machine, callee);
        return;
    } else if op == Op::Try {
        let value = get(inout machine, machine.program.op(operand_at));
        if machine.failed {
            return;
        }
        suspend(inout machine, inst.dest, inst.ty);
        let mut try_frame = machine.frame;
        try_frame.kind = FR_TRY;
        // The `Fail` instance key the `?` raises through.
        let try_site = site(in machine, inst_id, SITE_TRY);
        try_frame.dest = if try_site == NONE64 {
            0
        } else {
            n32(site_word(in machine, add(try_site, TRY_KEY)))
        };
        machine.stack.push(try_frame);
        machine.ret_value = value;
        machine.control = C_RET;
        return;
    } else {
        fail(inout machine, "the run machine does not know this operation");
        return;
    }
    if machine.failed {
        return;
    }
    if failure != F_OK {
        // `primitive_failure`: the raise is unhandled.
        suspend(inout machine, inst.dest, inst.ty);
        raise(inout machine, failure);
        return;
    }
    let coerced = coerce(inout machine, result, inst.ty);
    set_val(inout machine, w(inst.dest), coerced);
}

// A block's terminator.
fn terminate(inout machine: M, block: BlockRow) {
    let term_at = block.ta;
    let fn_info = func(in machine, machine.frame.func_index);
    if block.term == Term::Return {
        let id = machine.program.op(term_at);
        let value = val(in machine, id);
        if value.tag == T_UNDEF {
            fail(inout machine, "missing IR return value");
            return;
        }
        leave(inout machine, value);
        return;
    }
    if block.term == Term::Jump {
        let target = add(fn_info.first_block, machine.program.op(term_at));
        let n = machine.program.op(inc(term_at));
        let prev_arg_count = machine.arg_vals.len();
        machine.arg_vals.clear();
        for i in 0..n {
            let value = val(in machine, machine.program.op(add(add(term_at, 2), i)));
            if value.tag == T_UNDEF {
                fail(inout machine, "missing IR edge argument");
                return;
            }
            machine.arg_vals.push(value);
        }
        let params_at = u64_at(in machine.block_params, target);
        let param_count = machine.program.op(params_at);
        for i in 0..param_count {
            if i < n {
                let id = machine.program.op(add(inc(params_at), i));
                match machine.arg_vals.try_get(i) {
                    Option::Some(value) => set_val(inout machine, id, value),
                    Option::None => {},
                }
            }
        }
        let _ = prev_arg_count;
        machine.frame.block = target;
        machine.frame.ip = 0;
        return;
    }
    if block.term == Term::Branch {
        let value = val(in machine, machine.program.op(term_at));
        if value.tag == T_UNDEF {
            fail(inout machine, "missing IR condition");
            return;
        }
        if value.tag != T_BOOL {
            fail(inout machine, "IR branch condition must be bool");
            return;
        }
        let target = if value.payload != 0 {
            machine.program.op(inc(term_at))
        } else {
            machine.program.op(add(term_at, 2))
        };
        machine.frame.block = add(fn_info.first_block, target);
        machine.frame.ip = 0;
        return;
    }
    if block.term == Term::Match {
        let value = val(in machine, machine.program.op(term_at));
        if value.tag == T_UNDEF {
            fail(inout machine, "missing IR match value");
            return;
        }
        let n = machine.program.op(inc(term_at));
        let mut pat_at = add(term_at, 2);
        for i in 0..n {
            let target_at = pat_end(in machine, pat_at);
            if pat_matches(inout machine, pat_at, value) {
                machine.frame.block = add(fn_info.first_block, machine.program.op(target_at));
                machine.frame.ip = 0;
                return;
            }
            pat_at = inc(target_at);
        }
        fail(inout machine, "non-exhaustive IR match");
        return;
    }
    fail(inout machine, "reached an unreachable IR block");
}

// A returned value meets the top frame (`Control::Return` in `drive`);
// false when the run is complete.
fn resume(inout machine: M) -> bool {
    let mut frame = match machine.stack.pop() {
        Option::Some(popped) => popped,
        Option::None => {
            return false;
        },
    };
    // An evidence frame is no `Frame`: popping it takes no step.
    loop {
        if frame.kind != FR_EVIDENCE {
            break;
        }
        frame = match machine.stack.pop() {
            Option::Some(popped) => popped,
            Option::None => {
                return false;
            },
        };
    }
    if frame.kind == FR_TRY {
        let value = machine.ret_value;
        if value.tag == T_DATA {
            let aggregate = agg(in machine, value);
            if aggregate.ctor == machine.ok_sym || aggregate.ctor == machine.err_sym {
                let payload_index = field_index(in machine, aggregate, machine.zero_sym);
                if payload_index == NONE64 {
                    if aggregate.ctor == machine.ok_sym {
                        fail(inout machine, "missing Ok payload");
                    } else {
                        fail(inout machine, "missing Err payload");
                    }
                    return true;
                }
                if aggregate.ctor == machine.ok_sym {
                    machine.ret_value = kid(in machine, add(aggregate.kid_start, payload_index));
                    return true;
                }
                let payload = kid(in machine, add(aggregate.kid_start, payload_index));
                machine.arg_vals.clear();
                machine.arg_vals.push(payload);
                perform(inout machine, machine.fail_sym, machine.raise_sym, w(frame.dest), 0);
                return true;
            }
        }
        fail(inout machine, "'?' requires Result");
        return true;
    }
    if frame.kind == FR_COERCE {
        let value = machine.ret_value;
        machine.ret_value = coerce(inout machine, value, frame.ty);
        return true;
    }
    if frame.kind == FR_HANDLER {
        let value = machine.ret_value;
        handler_return(inout machine, frame, value);
        return true;
    }
    machine.frame = frame;
    let ret_value = machine.ret_value;
    let coerced = coerce(inout machine, ret_value, frame.ty);
    set_val(inout machine, w(frame.dest), coerced);
    machine.control = C_IR;
    true
}

// `Runtime::run` of the entry with no arguments: the value's text in
// `message`, or the error in `message` with `failed`.
pub fn drive(inout machine: M) {
    machine.arg_vals.clear();
    machine.arg_roots.clear();
    machine.arg_paths.clear();
    machine.frame = fr_zero();
    invoke(inout machine, machine.entry);
    machine.control = C_IR;
    loop {
        if machine.failed || machine.declined {
            return;
        }
        if machine.fuel == 0 {
            fail(inout machine, "execution fuel exhausted");
            return;
        }
        machine.fuel = wrapping_sub(machine.fuel, 1);
        if machine.control == C_IR {
            step(inout machine);
        } else if machine.control == C_INSTALL {
            install(inout machine);
        } else if !resume(inout machine) {
            break;
        }
    }
    machine.message.clear();
    let value = machine.ret_value;
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    display(in machine, value, inout out, 0);
    // Every other value's text is ASCII: a byte past it came from a string.
    for i in 0..out.len() {
        if u8_at(in out, i) >= NON_ASCII {
            decline(inout machine, "a non-ASCII string in the result", NONE32);
            return;
        }
    }
    machine.message = out;
}

// Whether the call arguments at operand `args_at` (`n`, then pass, value,
// root + 1, path each) pass a place `inout`.
fn has_inout_arg(in machine: M, args_at: u64) -> bool {
    for i in 0..machine.program.op(args_at) {
        if machine.program.op(add(inc(args_at), wrapping_mul(i, ARG_WORDS))) == PASS_INOUT {
            return true;
        }
    }
    false
}

// Releases the newest continuation and its snapshot.
fn drop_last(inout machine: M) {
    let count = machine.conts.len();
    if count == 0 {
        return;
    }
    let k = kt_at(in machine, wrapping_sub(count, 1));
    machine.k_frames.truncate(k.frame_start);
    machine.k_vals.truncate(k.val_start);
    machine.k_env.truncate(k.env_start);
    machine.k_cells.truncate(k.cell_start);
    machine.k_segs.truncate(k.seg_start);
    machine.k_hnames.truncate(k.hcap_start);
    machine.k_hvals.truncate(k.hcap_start);
    machine.conts.truncate(wrapping_sub(count, 1));
}

// ----- sequences -----------------------------------------------------------------

// `SeqOp`s the machine runs, from the pool row's `Debug` text (`seq_code`).
const SQ_NEW: u64 = 1;
const SQ_WITH_CAPACITY: u64 = 2;
const SQ_LEN: u64 = 3;
const SQ_SLICE_LEN: u64 = 4;
const SQ_PUSH: u64 = 5;
const SQ_POP: u64 = 6;
const SQ_GET: u64 = 7;
const SQ_SET: u64 = 8;
const SQ_TRY_GET: u64 = 9;
const SQ_LAST: u64 = 10;
const SQ_TRY_SET: u64 = 11;
const SQ_CLEAR: u64 = 12;
const SQ_TRUNCATE: u64 = 13;
const SQ_RESERVE: u64 = 14;
const SQ_EXTEND: u64 = 15;
const SQ_FINISH: u64 = 16;
const SQ_AS_SLICE: u64 = 17;
const SQ_SUB_SLICE: u64 = 18;
const SQ_FILL: u64 = 19;
const SQ_COPY_FROM: u64 = 20;
const SQ_TRY_COPY_FROM: u64 = 21;
const SQ_EXTEND_REVERSED: u64 = 22;
// String primitives (`SeqOp::Str`), below `SQ_WIDE`.
const SQ_STR_LEN: u64 = 101;
const SQ_STR_BYTE_AT: u64 = 102;
const SQ_STR_TRY_BYTE_AT: u64 = 103;
const SQ_STR_AS_STR: u64 = 104;
const SQ_STR_AS_BYTES: u64 = 105;
const SQ_STR_SUB_STR: u64 = 106;
const SQ_STR_PUSH_STR: u64 = 107;
const SQ_STR_PUSH_CHAR: u64 = 108;
const SQ_STR_CLEAR: u64 = 109;
const SQ_STR_RESERVE: u64 = 110;
// UTF-8 (`char::from_u32`, `String::push`): the largest scalar value and
// the surrogates; a continuation byte's tag, payload bits and mask; the
// lead byte tags, continuation counts and first scalars of the 2-, 3- and
// 4-byte encodings; and a char boundary's test (`str::is_char_boundary`).
const CHAR_MAX: u64 = 1114111;
const SURROGATE_LO: u64 = 55296;
const SURROGATE_HI: u64 = 57343;
const UTF8_CONT_TAG: u64 = 128;
const UTF8_CONT_SHIFT: u32 = 6;
const UTF8_CONT_MASK: u64 = 63;
const UTF8_LEAD2: u64 = 192;
const UTF8_LEAD3: u64 = 224;
const UTF8_LEAD4: u64 = 240;
const UTF8_CONTS2: u32 = 1;
const UTF8_CONTS3: u32 = 2;
const UTF8_CONTS4: u32 = 3;
const UTF8_FIRST2: u64 = 128;
const UTF8_FIRST3: u64 = 2048;
const UTF8_FIRST4: u64 = 65536;
const UTF8_TAG_MASK: u8 = 192;
const UTF8_CONT_BYTE: u8 = 128;
// The first non-ASCII byte.
const NON_ASCII: u8 = 128;
// A `SeqOp::Hoisted` access adds this to its checked access's code.
const SQ_HOISTED: u64 = 1000;
// A fixed-width byte access (`SeqOp::Wide`): this plus bytes * 8, then 4
// when big-endian, 2 for a write and 1 for the total form.
const SQ_WIDE: u64 = 200;
const WIDE_BIG: u64 = 4;
const WIDE_WRITE: u64 = 2;
const WIDE_TOTAL: u64 = 1;
const BITS_PER_BYTE: u64 = 8;
const BYTE_MASK: u64 = 255;
// The flag combinations of a wide access (big, write, total).
const WIDE_FLAG_COMBOS: u64 = 8;
// Wide access widths in bytes: 2, 4 and 8, each twice the last.
const WIDE_U16_BYTES: u64 = 2;
const WIDE_U32_BYTES: u64 = 4;
const WIDE_U64_BYTES: u64 = 8;
const WIDE_WIDTH_STEP: u64 = 2;
// The largest `with_capacity` the machine takes: Rust's `try_reserve` of a
// larger one may fail.
const SEQ_CAPACITY_LIMIT: u64 = 16777216;
// A sequence's first allocation.
const SEQ_MIN_CAPACITY: u64 = 4;

// The code of `SeqOp` Debug text `sym`, or 0.
fn seq_code(in machine: M, sym: u32) -> u64 {
    if spells(in machine, sym, "New") {
        SQ_NEW
    } else if spells(in machine, sym, "WithCapacity") {
        SQ_WITH_CAPACITY
    } else if spells(in machine, sym, "Len") {
        SQ_LEN
    } else if spells(in machine, sym, "SliceLen") {
        SQ_SLICE_LEN
    } else if spells(in machine, sym, "Push") {
        SQ_PUSH
    } else if spells(in machine, sym, "Pop") {
        SQ_POP
    } else if spells(in machine, sym, "Get") || spells(in machine, sym, "SliceGet") {
        SQ_GET
    } else if spells(in machine, sym, "Set") || spells(in machine, sym, "SliceSet") {
        SQ_SET
    } else if spells(in machine, sym, "TryGet") {
        SQ_TRY_GET
    } else if spells(in machine, sym, "Last") {
        SQ_LAST
    } else if spells(in machine, sym, "TrySet") {
        SQ_TRY_SET
    } else if spells(in machine, sym, "Clear") {
        SQ_CLEAR
    } else if spells(in machine, sym, "Truncate") {
        SQ_TRUNCATE
    } else if spells(in machine, sym, "Reserve") {
        SQ_RESERVE
    } else if spells(in machine, sym, "Extend") {
        SQ_EXTEND
    } else if spells(in machine, sym, "Finish") {
        SQ_FINISH
    } else if spells(in machine, sym, "AsSlice") {
        SQ_AS_SLICE
    } else if spells(in machine, sym, "SubSlice") {
        SQ_SUB_SLICE
    } else if spells(in machine, sym, "Fill") {
        SQ_FILL
    } else if spells(in machine, sym, "CopyFrom { total: false }") {
        SQ_COPY_FROM
    } else if spells(in machine, sym, "CopyFrom { total: true }") {
        SQ_TRY_COPY_FROM
    } else if spells(in machine, sym, "ExtendReversed") {
        SQ_EXTEND_REVERSED
    } else if spells(in machine, sym, "Str(Len)") {
        SQ_STR_LEN
    } else if spells(in machine, sym, "Str(ByteAt)") {
        SQ_STR_BYTE_AT
    } else if spells(in machine, sym, "Str(TryByteAt)") {
        SQ_STR_TRY_BYTE_AT
    } else if spells(in machine, sym, "Str(AsStr)") {
        SQ_STR_AS_STR
    } else if spells(in machine, sym, "Str(AsBytes)") {
        SQ_STR_AS_BYTES
    } else if spells(in machine, sym, "Str(SubStr)") {
        SQ_STR_SUB_STR
    } else if spells(in machine, sym, "Str(PushStr)") {
        SQ_STR_PUSH_STR
    } else if spells(in machine, sym, "Str(PushChar)") {
        SQ_STR_PUSH_CHAR
    } else if spells(in machine, sym, "Str(Clear)") {
        SQ_STR_CLEAR
    } else if spells(in machine, sym, "Str(Reserve)") {
        SQ_STR_RESERVE
    } else if spells(in machine, sym, "Hoisted(Get)") {
        add(SQ_HOISTED, SQ_GET)
    } else if spells(in machine, sym, "Hoisted(Set)") {
        add(SQ_HOISTED, SQ_SET)
    } else if spells(in machine, sym, "Hoisted(TryGet)") {
        add(SQ_HOISTED, SQ_TRY_GET)
    } else if spells(in machine, sym, "Hoisted(TrySet)") {
        add(SQ_HOISTED, SQ_TRY_SET)
    } else {
        wide_code(in machine, sym)
    }
}

fn sq_at(in machine: M, id: u64) -> Sq {
    match machine.seqs.try_get(id) {
        Option::Some(found) => found,
        Option::None => Sq { at: 0, len: 0, cap: 0 },
    }
}

fn sl_at(in machine: M, id: u64) -> Sl {
    match machine.slices.try_get(id) {
        Option::Some(found) => found,
        Option::None => Sl { seq: 0, start: 0, len: 0 },
    }
}

fn new_seq(inout machine: M) -> Val {
    let id = machine.seqs.len();
    machine.seqs.push(Sq { at: machine.seq_items.len(), len: 0, cap: 0 });
    Val { tag: T_SEQ, payload: id }
}

fn new_slice(inout machine: M, view: Sl) -> Val {
    let id = machine.slices.len();
    machine.slices.push(view);
    Val { tag: T_SLICE, payload: id }
}

// Element `i` of a view.
fn item(in machine: M, view: Sl, i: u64) -> Val {
    val_at(in machine.seq_items, add(add(sq_at(in machine, view.seq).at, view.start), i))
}

fn set_item(inout machine: M, view: Sl, i: u64, value: Val) {
    let at = add(add(sq_at(in machine, view.seq).at, view.start), i);
    let ok = machine.seq_items.try_set(at, value);
}

// Room for `extra` more elements of sequence `id`, moving it to the end of
// `seq_items` when it is full.
fn grow(inout machine: M, id: u64, extra: u64) {
    let sq = sq_at(in machine, id);
    let need = add(sq.len, extra);
    if need <= sq.cap {
        return;
    }
    let mut cap = wrapping_mul(sq.cap, 2);
    if cap < need {
        cap = need;
    }
    if cap < SEQ_MIN_CAPACITY {
        cap = SEQ_MIN_CAPACITY;
    }
    let at = machine.seq_items.len();
    for i in 0..sq.len {
        machine.seq_items.push(val_at(in machine.seq_items, add(sq.at, i)));
    }
    machine.seq_items.resize(add(at, cap), undef());
    let ok = machine.seqs.try_set(id, Sq { at: at, len: sq.len, cap: cap });
}

fn push_item(inout machine: M, id: u64, value: Val) {
    grow(inout machine, id, 1);
    let sq = sq_at(in machine, id);
    let ok = machine.seq_items.try_set(add(sq.at, sq.len), value);
    let set = machine.seqs.try_set(id, Sq { at: sq.at, len: inc(sq.len), cap: sq.cap });
}

fn set_len(inout machine: M, id: u64, len: u64) {
    let sq = sq_at(in machine, id);
    let ok = machine.seqs.try_set(id, Sq { at: sq.at, len: len, cap: sq.cap });
}

// `index`: an unsigned integer, or a non-negative `i64`.
fn seq_index(inout machine: M, value: Val) -> u64 {
    if value.tag == K_U8 || value.tag == K_U16 || value.tag == K_U32 || value.tag == K_U64 {
        return value.payload;
    }
    if value.tag == K_I64 {
        if wrapping_i64(value.payload) < 0 {
            fail(inout machine, "sequence index is negative");
        }
        return value.payload;
    }
    fail(inout machine, "sequence index must be an integer");
    0
}

// The sequence and interval of a sequence or slice value (`view`).
fn seq_view(inout machine: M, value: Val) -> Sl {
    if value.tag == T_SEQ {
        return Sl { seq: value.payload, start: 0, len: sq_at(in machine, value.payload).len };
    }
    if value.tag == T_SLICE {
        return sl_at(in machine, value.payload);
    }
    fail(inout machine, "expected a ChunkSeq or Slice value");
    Sl { seq: 0, start: 0, len: 0 }
}

// The sequence of a `ChunkSeq` value (`seq`).
fn seq_id(inout machine: M, value: Val) -> u64 {
    if value.tag == T_SEQ {
        return value.payload;
    }
    fail(inout machine, "expected a ChunkSeq value");
    0
}

// `Option::Some(value)` when `has`, else `Option::None`.
fn option_val(inout machine: M, has: bool, value: Val) -> Val {
    let kid_start = machine.kids.len();
    if has {
        push_kid(inout machine, machine.zero_sym, value);
        return make(inout machine, T_DATA, machine.some_sym, kid_start);
    }
    make(inout machine, T_DATA, machine.none_sym, kid_start)
}

fn u64_val(n: u64) -> Val {
    Val { tag: K_U64, payload: n }
}

// ----- strings -----------------------------------------------------------------

// `Ordering` of two strings' bytes.
const ORDER_LESS: u8 = 0;
const ORDER_EQUAL: u8 = 1;
const ORDER_GREATER: u8 = 2;

fn str_at(in machine: M, id: u64) -> Sr {
    match machine.strs.try_get(id) {
        Option::Some(found) => found,
        Option::None => Sr { at: 0, len: 0 },
    }
}

// A string of the bytes `str_bytes[at..]` pushed since `at`.
fn new_str(inout machine: M, at: u64) -> Val {
    let id = machine.strs.len();
    machine.strs.push(Sr { at: at, len: wrapping_sub(machine.str_bytes.len(), at) });
    Val { tag: T_STR, payload: id }
}

// Appends the bytes of string value `text` to `str_bytes`.
fn push_text(inout machine: M, text: Val) {
    let range = str_at(in machine, text.payload);
    for i in 0..range.len {
        let byte = u8_at(in machine.str_bytes, add(range.at, i));
        machine.str_bytes.push(byte);
    }
}

// The string of literal `sym`, made once: strings never change.
fn lit_str(inout machine: M, sym: u32) -> Val {
    let index = w(sym);
    let cached = u64_at(in machine.lit_strs, index);
    if cached != 0 {
        return Val { tag: T_STR, payload: wrapping_sub(cached, 1) };
    }
    let at = machine.str_bytes.len();
    let text_start = machine.ctx.names.start(sym);
    let text_end = machine.ctx.names.end(sym);
    for i in text_start..text_end {
        machine.str_bytes.push(u8_at(in machine.ctx.names.text, i));
    }
    let value = new_str(inout machine, at);
    for i in machine.lit_strs.len()..inc(index) {
        machine.lit_strs.push(0);
    }
    let ok = machine.lit_strs.try_set(index, inc(value.payload));
    value
}

// `Ord` of `String`: bytewise, then by length.
fn text_order(in machine: M, lhs: Val, rhs: Val) -> u8 {
    let lhs_range = str_at(in machine, lhs.payload);
    let rhs_range = str_at(in machine, rhs.payload);
    let common_len = if lhs_range.len < rhs_range.len {
        lhs_range.len
    } else {
        rhs_range.len
    };
    for i in 0..common_len {
        let lhs_byte = u8_at(in machine.str_bytes, add(lhs_range.at, i));
        let rhs_byte = u8_at(in machine.str_bytes, add(rhs_range.at, i));
        if lhs_byte != rhs_byte {
            return if lhs_byte < rhs_byte {
                ORDER_LESS
            } else {
                ORDER_GREATER
            };
        }
    }
    if lhs_range.len < rhs_range.len {
        ORDER_LESS
    } else if lhs_range.len > rhs_range.len {
        ORDER_GREATER
    } else {
        ORDER_EQUAL
    }
}

// Whether string value `text` holds the text of symbol `sym`.
fn text_spells(in machine: M, text: Val, sym: u32) -> bool {
    let range = str_at(in machine, text.payload);
    let text_start = machine.ctx.names.start(sym);
    if wrapping_sub(machine.ctx.names.end(sym), text_start) != range.len {
        return false;
    }
    for i in 0..range.len {
        let byte = u8_at(in machine.str_bytes, add(range.at, i));
        if byte != u8_at(in machine.ctx.names.text, add(text_start, i)) {
            return false;
        }
    }
    true
}

// `str::is_char_boundary` of byte `i` of string `range`.
fn char_boundary(in machine: M, range: Sr, i: u64) -> bool {
    if i == 0 || i == range.len {
        return true;
    }
    if i > range.len {
        return false;
    }
    (u8_at(in machine.str_bytes, add(range.at, i)) & UTF8_TAG_MASK) != UTF8_CONT_BYTE
}

// A string update writes the new string back to the receiver's place
// (argument 0; `inout` parameters share it).
fn write_receiver(inout machine: M, updated: Val) {
    let root = u64_at(in machine.arg_roots, 0);
    if root == 0 {
        fail(inout machine, "string update requires a place");
        return;
    }
    let bound_index = binding(in machine, n32(wrapping_sub(root, 1)));
    if bound_index == NONE64 {
        fail(inout machine, "undefined string receiver place");
        return;
    }
    let env_entry = entry(in machine, bound_index);
    slot_path(inout machine, env_entry);
    let path = u64_at(in machine.arg_paths, 0);
    for j in 0..machine.program.path(path).n {
        machine.path.push(machine.program.path_name(path, j));
    }
    write_path(inout machine, env_entry.cell, updated);
}

// Pushes a lead byte `lead_tag | c >> (6 * conts)`, then `conts`
// continuation bytes of scalar value `c`, high bits first.
fn push_encoded(inout machine: M, c: u64, lead_tag: u64, conts: u32) {
    let lead = wrapping_shr_u64(c, wrapping_mul(conts, UTF8_CONT_SHIFT));
    machine.str_bytes.push(wrapping_u8(lead_tag | lead));
    for i in 0..conts {
        let k = wrapping_sub(wrapping_sub(conts, 1), i);
        let payload = wrapping_shr_u64(c, wrapping_mul(k, UTF8_CONT_SHIFT)) & UTF8_CONT_MASK;
        machine.str_bytes.push(wrapping_u8(UTF8_CONT_TAG | payload));
    }
}

// `String::push` of scalar value `c` onto the bytes being built.
fn push_utf8(inout machine: M, c: u64) {
    if c < UTF8_FIRST2 {
        machine.str_bytes.push(wrapping_u8(c));
    } else if c < UTF8_FIRST3 {
        push_encoded(inout machine, c, UTF8_LEAD2, UTF8_CONTS2);
    } else if c < UTF8_FIRST4 {
        push_encoded(inout machine, c, UTF8_LEAD3, UTF8_CONTS3);
    } else {
        push_encoded(inout machine, c, UTF8_LEAD4, UTF8_CONTS4);
    }
}

// `str_op`: a string primitive on the collected arguments. A string and a
// view are both a string value; an update makes a new string and writes
// it to the receiver's place.
fn str_op(inout machine: M, code: u64, inout oob: bool) -> Val {
    let arg0 = val_at(in machine.arg_vals, 0);
    let arg1 = val_at(in machine.arg_vals, 1);
    let arg2 = val_at(in machine.arg_vals, 2);
    if arg0.tag != T_STR {
        fail(inout machine, "String operation expects a string operand");
        return unit();
    }
    let range = str_at(in machine, arg0.payload);
    if code == SQ_STR_LEN {
        return u64_val(range.len);
    }
    if code == SQ_STR_BYTE_AT || code == SQ_STR_TRY_BYTE_AT {
        let i = seq_index(inout machine, arg1);
        if machine.failed {
            return unit();
        }
        let inside = i < range.len;
        let byte = if inside {
            Val { tag: K_U8, payload: widen_u64(u8_at(in machine.str_bytes, add(range.at, i))) }
        } else {
            unit()
        };
        if code == SQ_STR_TRY_BYTE_AT {
            return option_val(inout machine, inside, byte);
        }
        if !inside {
            oob = true;
        }
        return byte;
    }
    if code == SQ_STR_AS_STR {
        return arg0;
    }
    if code == SQ_STR_AS_BYTES {
        let bytes = new_seq(inout machine);
        for i in 0..range.len {
            let byte = widen_u64(u8_at(in machine.str_bytes, add(range.at, i)));
            push_item(inout machine, bytes.payload, Val { tag: K_U8, payload: byte });
        }
        return new_slice(inout machine, Sl { seq: bytes.payload, start: 0, len: range.len });
    }
    if code == SQ_STR_SUB_STR {
        let lo = seq_index(inout machine, arg1);
        let hi = seq_index(inout machine, arg2);
        if machine.failed {
            return unit();
        }
        if lo > hi || hi > range.len {
            fail(inout machine, "");
            machine.message.clear();
            put(inout machine.message, "String fault: interval ");
            push_decimal(inout machine.message, lo);
            put(inout machine.message, "..");
            push_decimal(inout machine.message, hi);
            put(inout machine.message, " is out of bounds of length ");
            push_decimal(inout machine.message, range.len);
            return unit();
        }
        if !char_boundary(in machine, range, lo) || !char_boundary(in machine, range, hi) {
            fail(inout machine, "");
            machine.message.clear();
            put(inout machine.message, "String fault: interval ");
            push_decimal(inout machine.message, lo);
            put(inout machine.message, "..");
            push_decimal(inout machine.message, hi);
            put(inout machine.message, " is not on char boundaries");
            return unit();
        }
        let id = machine.strs.len();
        machine.strs.push(Sr { at: add(range.at, lo), len: wrapping_sub(hi, lo) });
        return Val { tag: T_STR, payload: id };
    }
    if code == SQ_STR_PUSH_STR {
        if arg1.tag != T_STR {
            fail(inout machine, "String operation expects a string operand");
            return unit();
        }
        let at = machine.str_bytes.len();
        push_text(inout machine, arg0);
        push_text(inout machine, arg1);
        let updated = new_str(inout machine, at);
        write_receiver(inout machine, updated);
        return unit();
    }
    if code == SQ_STR_PUSH_CHAR {
        let c = seq_index(inout machine, arg1);
        if machine.failed {
            return unit();
        }
        if c > CHAR_MAX || (c >= SURROGATE_LO && c <= SURROGATE_HI) {
            return bool_val(false);
        }
        let at = machine.str_bytes.len();
        push_text(inout machine, arg0);
        push_utf8(inout machine, c);
        let updated = new_str(inout machine, at);
        write_receiver(inout machine, updated);
        return bool_val(true);
    }
    if code == SQ_STR_CLEAR {
        let updated = new_str(inout machine, machine.str_bytes.len());
        write_receiver(inout machine, updated);
        return unit();
    }
    // `SQ_STR_RESERVE`: capacity is not observable.
    let n = seq_index(inout machine, arg1);
    if n > SEQ_CAPACITY_LIMIT {
        decline(inout machine, "a large String capacity", NONE32);
    }
    write_receiver(inout machine, arg0);
    unit()
}

// `seq_op` of operation `code` on `arg_vals`: its value, or `oob` for the
// `IndexOutOfBounds` the caller raises.
fn seq_op(inout machine: M, code: u64, inout oob: bool) -> Val {
    let arg0 = val_at(in machine.arg_vals, 0);
    let arg1 = val_at(in machine.arg_vals, 1);
    let arg2 = val_at(in machine.arg_vals, 2);
    if code > SQ_HOISTED {
        // A hoisted access is its checked access under a guard that held.
        let value = seq_op(inout machine, wrapping_sub(code, SQ_HOISTED), inout oob);
        if oob {
            oob = false;
            decline(inout machine, "a hoisted access out of bounds", NONE32);
        }
        return value;
    }
    if code > SQ_WIDE {
        return wide_op(inout machine, wrapping_sub(code, SQ_WIDE), inout oob);
    }
    if code >= SQ_STR_LEN && code <= SQ_STR_RESERVE {
        return str_op(inout machine, code, inout oob);
    }
    if code == SQ_NEW {
        return new_seq(inout machine);
    }
    if code == SQ_WITH_CAPACITY {
        let cap = seq_index(inout machine, arg0);
        if cap > SEQ_CAPACITY_LIMIT {
            decline(inout machine, "a large ChunkSeq capacity", NONE32);
        }
        return new_seq(inout machine);
    }
    if code == SQ_LEN {
        let id = seq_id(inout machine, arg0);
        return u64_val(sq_at(in machine, id).len);
    }
    if code == SQ_SLICE_LEN {
        return u64_val(seq_view(inout machine, arg0).len);
    }
    if code == SQ_PUSH {
        let id = seq_id(inout machine, arg0);
        if !machine.failed {
            push_item(inout machine, id, arg1);
        }
        return unit();
    }
    if code == SQ_POP {
        let id = seq_id(inout machine, arg0);
        let sq = sq_at(in machine, id);
        if machine.failed || sq.len == 0 {
            return option_val(inout machine, false, unit());
        }
        let value = val_at(in machine.seq_items, add(sq.at, wrapping_sub(sq.len, 1)));
        set_len(inout machine, id, wrapping_sub(sq.len, 1));
        return option_val(inout machine, true, value);
    }
    if code == SQ_GET || code == SQ_SET || code == SQ_TRY_GET || code == SQ_TRY_SET {
        let view = seq_view(inout machine, arg0);
        let i = seq_index(inout machine, arg1);
        if machine.failed {
            return unit();
        }
        let inside = i < view.len;
        if code == SQ_TRY_GET {
            let value = if inside {
                item(in machine, view, i)
            } else {
                unit()
            };
            return option_val(inout machine, inside, value);
        }
        if code == SQ_TRY_SET {
            if inside {
                set_item(inout machine, view, i, arg2);
            }
            return bool_val(inside);
        }
        if !inside {
            oob = true;
            return unit();
        }
        if code == SQ_GET {
            return item(in machine, view, i);
        }
        set_item(inout machine, view, i, arg2);
        return unit();
    }
    if code == SQ_LAST {
        let view = seq_view(inout machine, arg0);
        if view.len == 0 {
            return option_val(inout machine, false, unit());
        }
        let value = item(in machine, view, wrapping_sub(view.len, 1));
        return option_val(inout machine, true, value);
    }
    if code == SQ_CLEAR {
        let id = seq_id(inout machine, arg0);
        if !machine.failed {
            set_len(inout machine, id, 0);
        }
        return unit();
    }
    if code == SQ_TRUNCATE {
        let n = seq_index(inout machine, arg1);
        let id = seq_id(inout machine, arg0);
        if !machine.failed && n < sq_at(in machine, id).len {
            set_len(inout machine, id, n);
        }
        return unit();
    }
    if code == SQ_RESERVE {
        let n = seq_index(inout machine, arg1);
        let id = seq_id(inout machine, arg0);
        return unit();
    }
    if code == SQ_EXTEND || code == SQ_EXTEND_REVERSED {
        let view = seq_view(inout machine, arg1);
        let id = seq_id(inout machine, arg0);
        if machine.failed {
            return unit();
        }
        // Copy out first: the source may be a view of the same sequence.
        let mut items: ChunkSeq[Val] = ChunkSeq::new[Val]();
        for i in 0..view.len {
            let at = if code == SQ_EXTEND {
                i
            } else {
                wrapping_sub(wrapping_sub(view.len, 1), i)
            };
            items.push(item(in machine, view, at));
        }
        grow(inout machine, id, items.len());
        for i in 0..items.len() {
            push_item(inout machine, id, val_at(in items, i));
        }
        return unit();
    }
    if code == SQ_FINISH {
        let id = seq_id(inout machine, arg0);
        if !machine.failed && sq_at(in machine, id).len != 0 {
            oob = true;
        }
        return unit();
    }
    if code == SQ_AS_SLICE {
        let view = seq_view(inout machine, arg0);
        return new_slice(inout machine, view);
    }
    if code == SQ_SUB_SLICE {
        if arg0.tag == T_STR {
            return str_op(inout machine, SQ_STR_SUB_STR, inout oob);
        }
        let view = seq_view(inout machine, arg0);
        let lo = seq_index(inout machine, arg1);
        let hi = seq_index(inout machine, arg2);
        if machine.failed {
            return unit();
        }
        if lo <= hi && hi <= view.len {
            return new_slice(
                inout machine,
                Sl { seq: view.seq, start: add(view.start, lo), len: wrapping_sub(hi, lo) }
            );
        }
        fail(inout machine, "ChunkSeq fault: slice interval ");
        push_decimal(inout machine.message, lo);
        put(inout machine.message, "..");
        push_decimal(inout machine.message, hi);
        put(inout machine.message, " is out of bounds of length ");
        push_decimal(inout machine.message, view.len);
        return unit();
    }
    if code == SQ_FILL {
        let view = seq_view(inout machine, arg0);
        for i in 0..view.len {
            set_item(inout machine, view, i, arg1);
        }
        return unit();
    }
    if code == SQ_COPY_FROM || code == SQ_TRY_COPY_FROM {
        let total = code == SQ_TRY_COPY_FROM;
        let view = seq_view(inout machine, arg0);
        let at = seq_index(inout machine, arg1);
        let src = seq_view(inout machine, arg2);
        if machine.failed {
            return unit();
        }
        if !(at <= view.len && src.len <= wrapping_sub(view.len, at)) {
            if total {
                return bool_val(false);
            }
            oob = true;
            return unit();
        }
        let mut items: ChunkSeq[Val] = ChunkSeq::new[Val]();
        for i in 0..src.len {
            items.push(item(in machine, src, i));
        }
        for i in 0..items.len() {
            set_item(inout machine, view, add(at, i), val_at(in items, i));
        }
        if total {
            return bool_val(true);
        }
        return unit();
    }
    decline(inout machine, "a sequence operation", NONE32);
    unit()
}

fn put_flag(inout out: ChunkSeq[u8], in field: Str, on: bool) {
    put(inout out, field);
    if on {
        put(inout out, "true");
    } else {
        put(inout out, "false");
    }
}

// The code of a `Wide(Wide { bytes, big, write, total })` Debug text, or 0.
fn wide_code(in machine: M, sym: u32) -> u64 {
    if !has_prefix(in machine, sym, "Wide(Wide { bytes: ") {
        return 0;
    }
    for flags in 0..WIDE_FLAG_COMBOS {
        let mut bytes = WIDE_U16_BYTES;
        loop {
            if bytes > WIDE_U64_BYTES {
                break;
            }
            let mut text: ChunkSeq[u8] = ChunkSeq::new[u8]();
            put(inout text, "Wide(Wide { bytes: ");
            push_decimal(inout text, bytes);
            put_flag(inout text, ", big: ", flags & WIDE_BIG != 0);
            put_flag(inout text, ", write: ", flags & WIDE_WRITE != 0);
            put_flag(inout text, ", total: ", flags & WIDE_TOTAL != 0);
            put(inout text, " })");
            if machine.ctx.names.spells(sym, in text.as_slice()) {
                return add(add(SQ_WIDE, wrapping_mul(bytes, BITS_PER_BYTE)), flags);
            }
            bytes = wrapping_mul(bytes, WIDE_WIDTH_STEP);
        }
    }
    0
}

// `wide_op` of `form` (bytes * 8 plus the flags) on `arg_vals`.
fn wide_op(inout machine: M, form: u64, inout oob: bool) -> Val {
    let n = form / BITS_PER_BYTE;
    let big = form & WIDE_BIG != 0;
    let write = form & WIDE_WRITE != 0;
    let total = form & WIDE_TOTAL != 0;
    let view = seq_view(inout machine, val_at(in machine.arg_vals, 0));
    let at = seq_index(inout machine, val_at(in machine.arg_vals, 1));
    if machine.failed {
        return unit();
    }
    let inside = at <= view.len && n <= wrapping_sub(view.len, at);
    if write {
        if inside {
            let value = seq_index(inout machine, val_at(in machine.arg_vals, 2));
            if machine.failed {
                return unit();
            }
            for k in 0..n {
                let byte_index = if big {
                    wrapping_sub(wrapping_sub(n, 1), k)
                } else {
                    k
                };
                let shift_by = wrapping_u32(wrapping_mul(byte_index, BITS_PER_BYTE));
                let byte = wrapping_shr_u64(value, shift_by) & BYTE_MASK;
                set_item(inout machine, view, add(at, k), Val { tag: K_U8, payload: byte });
            }
        }
        if total {
            return bool_val(inside);
        }
        if !inside {
            oob = true;
        }
        return unit();
    }
    let mut value: u64 = 0;
    if inside {
        for k in 0..n {
            let item_index = if big {
                add(at, k)
            } else {
                add(at, wrapping_sub(wrapping_sub(n, 1), k))
            };
            let byte = seq_index(inout machine, item(in machine, view, item_index));
            value = wrapping_mul(value, inc(BYTE_MASK)) | (byte & BYTE_MASK);
        }
    }
    let kind = if n == WIDE_U16_BYTES {
        K_U16
    } else if n == WIDE_U32_BYTES {
        K_U32
    } else {
        K_U64
    };
    let read = Val { tag: kind, payload: value };
    if total {
        return option_val(inout machine, inside, read);
    }
    if !inside {
        oob = true;
    }
    read
}

// ----- closures ------------------------------------------------------------------

// The first word after a closure site's captured names.
fn closure_tail(in machine: M, at: u64) -> u64 {
    add(add(at, CS_FREE), site_word(in machine, add(at, CS_FREE_COUNT)))
}

// ----- evidence ----------------------------------------------------------------

// Whether evidence entry `ev` provides instance key `key` (when `key` is
// not 0) or effect `effect` by name.
fn ev_provides(in machine: M, ev: Ev, key: u64, effect: u32) -> bool {
    if key != 0 {
        return ev.effect == EV_ALL_KEYS && site_word(in machine, add(ev.site, HS_KEY)) == key;
    }
    if ev.effect == EV_ALL_KEYS {
        return site_word(in machine, add(ev.site, HS_EFFECT)) == w(effect);
    }
    ev.effect == effect
}

// The stack index of the live handler with serial `serial`, or NONE64.
fn live_handler(in machine: M, serial: u64) -> u64 {
    let mut i = machine.stack.len();
    loop {
        if i == 0 {
            return NONE64;
        }
        i = wrapping_sub(i, 1);
        let frame = stack_at(in machine, i);
        if frame.kind == FR_HANDLER && frame.serial == serial {
            return i;
        }
    }
}

// `capability` of instance key `key` (when not 0) or `$effect:<effect>` in
// the evidence of the top of the stack: the innermost handler providing
// it, where an evidence frame's entries come before the frames below it.
// NONE64 when there is none; a handler an entry names that is no longer
// installed declines.
fn find_handler(inout machine: M, key: u64, effect: u32) -> u64 {
    let mut i = machine.stack.len();
    loop {
        if i == 0 {
            return NONE64;
        }
        i = wrapping_sub(i, 1);
        let frame = stack_at(in machine, i);
        if frame.kind == FR_HANDLER {
            let provides = if key != 0 {
                site_word(in machine, add(frame.func_index, HS_KEY)) == key
            } else {
                site_word(in machine, add(frame.func_index, HS_EFFECT)) == w(effect)
            };
            if provides {
                return i;
            }
        } else if frame.kind == FR_EVIDENCE {
            for j in frame.block..add(frame.block, frame.ip) {
                let ev = ev_at(in machine, j);
                if ev_provides(in machine, ev, key, effect) {
                    let found = live_handler(in machine, ev.serial);
                    if found == NONE64 {
                        decline(inout machine, "evidence of a handler no longer installed", NONE32);
                    }
                    return found;
                }
            }
        }
    }
}

// `capability` of `$label:<label>` (`label` is the label + 1): the
// innermost handler installed with that label, where an evidence frame's
// whole-handler entries come before the frames below it. NONE64 when there
// is none.
fn find_labelled(inout machine: M, label: u64) -> u64 {
    let mut i = machine.stack.len();
    loop {
        if i == 0 {
            return NONE64;
        }
        i = wrapping_sub(i, 1);
        let frame = stack_at(in machine, i);
        if frame.kind == FR_HANDLER {
            if site_word(in machine, add(frame.func_index, HS_LABEL)) == label {
                return i;
            }
        } else if frame.kind == FR_EVIDENCE {
            for j in frame.block..add(frame.block, frame.ip) {
                let ev = ev_at(in machine, j);
                if ev.effect == EV_ALL_KEYS
                    && site_word(in machine, add(ev.site, HS_LABEL)) == label
                {
                    let found = live_handler(in machine, ev.serial);
                    if found == NONE64 {
                        decline(inout machine, "evidence of a handler no longer installed", NONE32);
                    }
                    return found;
                }
            }
        }
    }
}

fn ev_at(in machine: M, index: u64) -> Ev {
    match machine.evs.try_get(index) {
        Option::Some(found) => found,
        Option::None => Ev { serial: 0, site: 0, effect: 0 },
    }
}

// `evidence_environment` of the top of the stack, appended to `evs`
// innermost first: every installed handler, and the entries of each
// evidence frame before the frames below it.
fn push_evidence(inout machine: M) {
    let mut i = machine.stack.len();
    loop {
        if i == 0 {
            break;
        }
        i = wrapping_sub(i, 1);
        let frame = stack_at(in machine, i);
        if frame.kind == FR_HANDLER {
            machine
                .evs
                .push(Ev { serial: frame.serial, site: frame.func_index, effect: EV_ALL_KEYS });
        } else if frame.kind == FR_EVIDENCE {
            for j in frame.block..add(frame.block, frame.ip) {
                let ev = ev_at(in machine, j);
                machine.evs.push(ev);
            }
        }
    }
}

// Copies entries `evs[start..start + count]` to the end of `evs`.
fn copy_evidence(inout machine: M, start: u64, count: u64) {
    for j in start..add(start, count) {
        let ev = ev_at(in machine, j);
        machine.evs.push(ev);
    }
}

// Whether label `sym` binds its instance to a lexical handler (`$cap`,
// `$fncap:`): such an instance names the handler's `$static:` key.
fn bound_label(in machine: M, sym: u32) -> bool {
    has_prefix(in machine, sym, "$cap") || has_prefix(in machine, sym, "$fncap:")
}

// The symbol of `$static:<label>`, or NONE32 when no handler has it.
fn static_key(in machine: M, label: u32) -> u32 {
    let mut text: ChunkSeq[u8] = ChunkSeq::new[u8]();
    put(inout text, "$static:");
    let text_start = machine.ctx.names.start(label);
    for i in text_start..machine.ctx.names.end(label) {
        text.push(u8_at(in machine.ctx.names.text, i));
    }
    machine.ctx.names.lookup(in text[0..text.len()])
}

// `capability` of `$static:` key `key`: the innermost handler with it,
// through evidence frames as `find_handler`. NONE64 when there is none.
fn find_static(inout machine: M, key: u32) -> u64 {
    let mut i = machine.stack.len();
    loop {
        if i == 0 {
            return NONE64;
        }
        i = wrapping_sub(i, 1);
        let frame = stack_at(in machine, i);
        if frame.kind == FR_HANDLER {
            if site_word(in machine, add(frame.func_index, HS_STATIC)) == w(key) {
                return i;
            }
        } else if frame.kind == FR_EVIDENCE {
            for j in frame.block..add(frame.block, frame.ip) {
                let ev = ev_at(in machine, j);
                if site_word(in machine, add(ev.site, HS_STATIC)) == w(key) {
                    let found = live_handler(in machine, ev.serial);
                    if found == NONE64 {
                        decline(inout machine, "evidence of a handler no longer installed", NONE32);
                    }
                    return found;
                }
            }
        }
    }
}

// Appends the evidence `bind_callable_evidence` gives a callable of
// function type `ty`: per effect instance, its `$cap`/`$fncap:` handler,
// and with `ambient` evidence (a call's parameter) the caller's handler
// of each other instance, or all of them for an open row.
fn push_bound(inout machine: M, ty: u32, ambient: bool) {
    let node = machine.ctx.types.node(ty);
    if node.kind != TyKind::Fn {
        return;
    }
    let row = machine.ctx.types.row(node.r2);
    for i in 0..w(row.n) {
        let effect_node = machine.ctx.types.effect_at(add(w(row.a), i));
        let bound = effect_node.label != 0
            && bound_label(in machine, wrapping_sub(effect_node.label, 1));
        let mut found = NONE64;
        if bound {
            let key = static_key(in machine, wrapping_sub(effect_node.label, 1));
            if key != NONE32 {
                found = find_static(inout machine, key);
            }
        } else if ambient {
            found = find_handler(inout machine, 0, effect_node.name);
        }
        if found != NONE64 {
            let handler = stack_at(in machine, found);
            machine.evs.push(Ev {
                serial: handler.serial,
                site: handler.func_index,
                effect: effect_node.name
            });
        }
    }
    if ambient && row.tail != 0 {
        push_evidence(inout machine);
    }
}

// `qualify_value` of a callable at function type `ty`: its evidence from
// `push_bound`. A closure keeps the evidence it captured first, a bound
// function its earlier evidence (`or_insert`, `extend`).
fn bind_evidence(inout machine: M, value: Val, ty: u32, ambient: bool) -> Val {
    if value.tag != T_FN && value.tag != T_CLOS && value.tag != T_BOUND {
        return value;
    }
    let node = machine.ctx.types.node(ty);
    if node.kind != TyKind::Fn {
        return value;
    }
    let row = machine.ctx.types.row(node.r2);
    if row.n == 0 && row.tail == 0 {
        return value;
    }
    if !ambient {
        let mut any_bound = false;
        for i in 0..w(row.n) {
            let label = machine.ctx.types.effect_at(add(w(row.a), i)).label;
            if label != 0 && bound_label(in machine, wrapping_sub(label, 1)) {
                any_bound = true;
            }
        }
        if !any_bound {
            return value;
        }
    }
    let start = machine.evs.len();
    let mut callee = n32(value.payload);
    if value.tag == T_CLOS {
        let closure = cl_at(in machine, value.payload);
        copy_evidence(inout machine, closure.ev_start, closure.ev_count);
    } else if value.tag == T_BOUND {
        let bound = bd_at(in machine, value.payload);
        callee = bound.callee;
        copy_evidence(inout machine, bound.ev_start, bound.ev_count);
    }
    let fresh = machine.evs.len();
    push_bound(inout machine, ty, ambient);
    if machine.evs.len() == fresh {
        machine.evs.truncate(start);
        return value;
    }
    let count = wrapping_sub(machine.evs.len(), start);
    if value.tag == T_CLOS {
        let closure = cl_at(in machine, value.payload);
        let id = machine.closures.len();
        machine.closures.push(Cl {
            site: closure.site,
            cap_start: closure.cap_start,
            cap_count: closure.cap_count,
            ev_start: start,
            ev_count: count
        });
        return Val { tag: T_CLOS, payload: id };
    }
    let id = machine.bounds.len();
    machine.bounds.push(Bd { callee: callee, ev_start: start, ev_count: count });
    Val { tag: T_BOUND, payload: id }
}

fn bd_at(in machine: M, id: u64) -> Bd {
    match machine.bounds.try_get(id) {
        Option::Some(found) => found,
        Option::None => Bd { callee: 0, ev_start: 0, ev_count: 0 },
    }
}

// Pushes an evidence frame over `evs[start..start + count]` for a call.
fn push_evidence_frame(inout machine: M, start: u64, count: u64) {
    if count == 0 {
        return;
    }
    let mut frame = fr_zero();
    frame.kind = FR_EVIDENCE;
    frame.block = start;
    frame.ip = count;
    machine.stack.push(frame);
}
fn cl_at(in machine: M, id: u64) -> Cl {
    match machine.closures.try_get(id) {
        Option::Some(found) => found,
        Option::None => Cl { site: 0, cap_start: 0, cap_count: 0, ev_start: 0, ev_count: 0 },
    }
}

// `Op::Closure` (`Control::Eval` of `ExprKind::Closure`): the closure over
// the captured free names it reads through its aliases, by value, returned
// into the suspended activation.
fn make_closure(inout machine: M, inst_id: u64, inst: InstRow) {
    let at = site(in machine, inst_id, SITE_CLOSURE);
    let mut steps = CLOSURE_EVAL_STEPS;
    if site_word(in machine, add(at, CS_COERCE)) != 0 {
        steps = inc(steps);
    }
    for i in 0..steps {
        if machine.fuel == 0 {
            fail(inout machine, "execution fuel exhausted");
            return;
        }
        machine.fuel = wrapping_sub(machine.fuel, 1);
    }
    let cap_start = machine.clos_names.len();
    let alias_at = add(inst.a, CO_ALIAS_COUNT);
    let alias_count = machine.program.op(alias_at);
    for i in 0..site_word(in machine, add(at, CS_FREE_COUNT)) {
        let name = n32(site_word(in machine, add(add(at, CS_FREE), i)));
        for j in 0..alias_count {
            let pair_at = add(inc(alias_at), wrapping_mul(j, ALIAS_PAIR_WORDS));
            if n32(machine.program.op(pair_at)) == name {
                let bound_index = binding(in machine, n32(machine.program.op(inc(pair_at))));
                if bound_index != NONE64 {
                    let env_entry = entry(in machine, bound_index);
                    slot_path(inout machine, env_entry);
                    let value = read_path(inout machine, env_entry.cell);
                    if machine.failed {
                        return;
                    }
                    machine.clos_names.push(name);
                    machine.clos_vals.push(value);
                }
            }
        }
    }
    // The evidence it was made under (`$effect:` keys of its environment),
    // after the handler each `$cap` instance of its type names.
    let ev_start = machine.evs.len();
    push_bound(inout machine, inst.ty, false);
    push_evidence(inout machine);
    let id = machine.closures.len();
    machine.closures.push(Cl {
        site: at,
        cap_start: cap_start,
        cap_count: wrapping_sub(machine.clos_names.len(), cap_start),
        ev_start: ev_start,
        ev_count: wrapping_sub(machine.evs.len(), ev_start)
    });
    suspend(inout machine, inst.dest, inst.ty);
    machine.ret_value = Val { tag: T_CLOS, payload: id };
    machine.control = C_RET;
}

// Calls closure `callee` on the collected arguments (`Value::Closure` in
// `call_value`): its lowered body over its captures and parameters.
fn call_closure(inout machine: M, callee: Val) {
    let closure = cl_at(in machine, callee.payload);
    let tail = closure_tail(in machine, closure.site);
    if machine.arg_vals.len() != site_word(in machine, add(tail, CT_PARAM_COUNT)) {
        fail(inout machine, "closure argument arity mismatch");
        return;
    }
    let body = site_fn(in machine, site_word(in machine, add(tail, CT_BODY)));
    push_evidence_frame(inout machine, closure.ev_start, closure.ev_count);
    invoke_with(inout machine, body, closure.cap_start, closure.cap_count, true);
}
