// The core machine of `Runtime::drive` over Place IR (slice 1 of #2053).
//
// Values are two words (`Val`): a tag and a payload. Integers carry their
// kind in the tag (arith.ves); tuples and data point at a row of `heap`,
// whose children are `kids[kid_start..kid_start+kid_count]` (and, for data,
// the field names at the same indices of `kid_names`). Values never change
// once made, so a Rust `clone` is a copy here, and assigning through a place
// rebuilds the aggregates along its path (`put_path`), as Rust's `slot_set`
// changes a clone.
//
// An activation (`IrState`) is a frame `Fr` over four stacks: its IR values
// `vals[val_base..]` (one per value id of its function), its environment
// `env[env_base..]` (name, cell, path; the latest binding of a name wins, as
// a `BTreeMap` insert), the cells its bindings own `cells[cell_base..]` and
// the path segments of its `inout` slots `segs[seg_base..]`. Without
// closures and handlers nothing outlives its activation but the returned
// value, so a return truncates all four.

use @vesper/check-data::util::{add, inc, n32, push_decimal, u32_at, u64_at, u8_at, w};
use @vesper/check-data::names::{Names};
use @vesper/check-data::types::{TyKind, Types};
use @vesper/check-data::world::{constructor};
use @vesper/check-data::input::{Ctx, Reader};
use @vesper/place-ir::codes::{Lit, Op, Pat, Term};
use @vesper/place-ir::{BlockRow, FnRow, InstRow, Program};
use self::arith::{
    B_ADD, B_AND, B_BAND, B_BOR, B_BSHL, B_BSHR, B_BXOR, B_DIV, B_EQ, B_GE, B_GT, B_LAND, B_LE,
    B_LOR, B_LT, B_MUL, B_NE, B_OR, B_REM, B_ROTL, B_ROTR, B_SHL, B_SHR, B_SUB, B_WADD, B_WMUL,
    B_WSUB, B_XOR, F_OK, F_OVERFLOW, K_I16, K_I32, K_I64, K_I8, K_U16, K_U32, K_U64, K_U8, bit,
    bitwise, checked, exact, fits, is_signed, not, rotate, shift, wrap, wrapping
};

const NONE32: u32 = 4294967295;
const NONE64: u64 = 18446744073709551615;

// Value tags beyond the integer kinds 0..=7.
pub const T_BOOL: u8 = 8;
pub const T_STR: u8 = 9;
pub const T_TUPLE: u8 = 10;
pub const T_DATA: u8 = 11;
pub const T_FN: u8 = 12;
// A handler clause's continuation (`Value::Continuation`); calling it is
// declined (resumption is a later slice).
pub const T_CONT: u8 = 13;
pub const T_UNDEF: u8 = 255;

// Unary codes; a conversion is U_CONV + family * 16 + target kind.
const U_NEG: u64 = 1;
const U_NOT: u64 = 2;
const U_INV: u64 = 3;
const U_CONV: u64 = 16;
const C_WIDEN: u64 = 0;
const C_NARROW: u64 = 1;
const C_WRAPPING: u64 = 2;

// Frame kinds (`Frame::IrResume`, `Frame::Try`).
const FR_IR: u8 = 0;
const FR_TRY: u8 = 1;
// `Frame::Handler`: `func_index` is its effect-table site, `block` and `ip`
// the start and count of its captured environment in `hcap_*`, the bases
// the arena lengths when it was installed.
const FR_HANDLER: u8 = 2;
// `Frame::Coerce`: the returned value takes type `ty`.
const FR_COERCE: u8 = 3;

// What `drive` holds (`Control::Ir`, `Control::Return`).
const C_IR: u8 = 0;
const C_RET: u8 = 1;
// `Control::Eval` of the handler expression of instruction `pending`.
const C_INSTALL: u8 = 2;

// Primitive failures (`Failure`).
const P_OVERFLOW: u8 = 1;
const P_DIV_ZERO: u8 = 2;
const P_INDEX: u8 = 4;

// Effect-table site kinds (run_words.rs `sites`).
const SITE_HANDLE: u64 = 1;
const SITE_EFFECT_CALL: u64 = 2;
const SITE_TRY: u64 = 3;

// A type's integer kind is not known yet / it has none.
const TK_UNSEEN: u8 = 254;
const TK_NONE: u8 = 255;

pub copy struct Val {
    tag: u8,
    payload: u64,
}

copy struct Agg {
    ctor: u32,
    kid_start: u64,
    kid_count: u64,
}

copy struct Fr {
    func_index: u64,
    block: u64,
    ip: u64,
    val_base: u64,
    env_base: u64,
    cell_base: u64,
    seg_base: u64,
    dest: u32,
    ty: u32,
    kind: u8,
}

copy struct En {
    name: u32,
    cell: u64,
    seg_start: u64,
    seg_count: u64,
}

// A function: its parameters `params[param_start..param_start+param_count]`,
// its value count, its first block and whether `scan` reached it.
copy struct Fi {
    name: u32,
    param_start: u64,
    param_count: u64,
    value_count: u64,
    first_block: u64,
    reached: bool,
}

copy struct Pm {
    name: u32,
    pass: u64,
}

// A `Write` place split at its dots: root, segments
// `write_segs[seg_start..seg_start+seg_count]` and the compound operator's
// code (0 for `=`).
copy struct Wr {
    root: u32,
    seg_start: u64,
    seg_count: u64,
    code: u64,
}

pub struct M {
    ctx: Ctx,
    program: Program,
    fuel: u64,
    entry: u64,
    fns: ChunkSeq[Fi],
    params: ChunkSeq[Pm],
    // symbol -> function index + 1
    fn_of: ChunkSeq[u32],
    // per instruction: its operator code, callee, constructor or `Write` row
    aux: ChunkSeq[u64],
    writes: ChunkSeq[Wr],
    write_segs: ChunkSeq[u32],
    // per block: the operand index of its parameter count
    block_params: ChunkSeq[u64],
    // per type id: its integer kind, TK_NONE, or TK_UNSEEN
    type_kinds: ChunkSeq[u8],
    // per symbol: the symbol of its last `::` segment + 1, or 0 unseen
    short_syms: ChunkSeq[u32],
    vals: ChunkSeq[Val],
    env: ChunkSeq[En],
    cells: ChunkSeq[Val],
    segs: ChunkSeq[u32],
    heap: ChunkSeq[Agg],
    kids: ChunkSeq[Val],
    kid_names: ChunkSeq[u32],
    stack: ChunkSeq[Fr],
    frame: Fr,
    ret_value: Val,
    control: u8,
    // scratch: a slot path being read or written, call arguments
    path: ChunkSeq[u32],
    arg_vals: ChunkSeq[Val],
    arg_roots: ChunkSeq[u64],
    arg_paths: ChunkSeq[u64],
    failed: bool,
    declined: bool,
    message: ChunkSeq[u8],
    // The effect table: its words (names as symbols), and per instruction
    // its site's offset + 1 or 0.
    sites: ChunkSeq[u64],
    site_of: ChunkSeq[u64],
    // The `Fail` instance keys of the primitive failures (symbol + 1, or 0).
    key_overflow: u64,
    key_runtime: u64,
    // The instruction of a `C_INSTALL`.
    pending: u64,
    // Handlers' captured environments (`handler_environment`).
    hcap_names: ChunkSeq[u32],
    hcap_vals: ChunkSeq[Val],
    // Per function: the continuation parameter's name + 1 of an operation
    // clause (whose type `scan` lets through), or 0.
    cont_names: ChunkSeq[u32],
    fail_sym: u32,
    raise_sym: u32,
    overflow_sym: u32,
    div_zero_sym: u32,
    index_sym: u32,
    // well-known symbols
    ok_sym: u32,
    err_sym: u32,
    zero_sym: u32,
    dot_sym: u32,
}

fn fr_zero() -> Fr {
    Fr {
        func_index: 0,
        block: 0,
        ip: 0,
        val_base: 0,
        env_base: 0,
        cell_base: 0,
        seg_base: 0,
        dest: 0,
        ty: 0,
        kind: FR_IR
    }
}

fn undef() -> Val {
    Val { tag: T_UNDEF, payload: 0 }
}

fn unit() -> Val {
    Val { tag: T_TUPLE, payload: NONE64 }
}

pub fn machine_new(sink ctx: Ctx, sink program: Program, fuel: u64) -> M {
    M {
        ctx: ctx,
        program: program,
        fuel: fuel,
        entry: NONE64,
        fns: ChunkSeq::new[Fi](),
        params: ChunkSeq::new[Pm](),
        fn_of: ChunkSeq::new[u32](),
        aux: ChunkSeq::new[u64](),
        writes: ChunkSeq::new[Wr](),
        write_segs: ChunkSeq::new[u32](),
        block_params: ChunkSeq::new[u64](),
        type_kinds: ChunkSeq::new[u8](),
        short_syms: ChunkSeq::new[u32](),
        vals: ChunkSeq::new[Val](),
        env: ChunkSeq::new[En](),
        cells: ChunkSeq::new[Val](),
        segs: ChunkSeq::new[u32](),
        heap: ChunkSeq::new[Agg](),
        kids: ChunkSeq::new[Val](),
        kid_names: ChunkSeq::new[u32](),
        stack: ChunkSeq::new[Fr](),
        frame: fr_zero(),
        ret_value: unit(),
        control: C_IR,
        path: ChunkSeq::new[u32](),
        arg_vals: ChunkSeq::new[Val](),
        arg_roots: ChunkSeq::new[u64](),
        arg_paths: ChunkSeq::new[u64](),
        failed: false,
        declined: false,
        message: ChunkSeq::new[u8](),
        sites: ChunkSeq::new[u64](),
        site_of: ChunkSeq::new[u64](),
        key_overflow: 0,
        key_runtime: 0,
        pending: 0,
        hcap_names: ChunkSeq::new[u32](),
        hcap_vals: ChunkSeq::new[Val](),
        cont_names: ChunkSeq::new[u32](),
        fail_sym: 0,
        raise_sym: 0,
        overflow_sym: 0,
        div_zero_sym: 0,
        index_sym: 0,
        ok_sym: 0,
        err_sym: 0,
        zero_sym: 0,
        dot_sym: 0,
    }
}

// ----- text --------------------------------------------------------------------

fn put(inout out: ChunkSeq[u8], in text: Str) {
    out.extend(in text.as_bytes());
}

fn put_sym(inout out: ChunkSeq[u8], in names: Names, sym: u32) {
    let text_start = names.start(sym);
    let text_end = names.end(sym);
    for i in text_start..text_end {
        out.push(u8_at(in names.text, i));
    }
}

fn put_signed(inout out: ChunkSeq[u8], value: i64) {
    if value < 0 {
        out.push(45);
        push_decimal(inout out, wrapping_u64(wrapping_sub(0, value)));
    } else {
        push_decimal(inout out, wrapping_u64(value));
    }
}

fn fail(inout machine: M, in text: Str) {
    if !machine.failed {
        machine.failed = true;
        machine.message.clear();
        put(inout machine.message, text);
    }
}

// `"<prefix>'<sym>'<suffix>"`, as Rust's `format!("{prefix}'{sym}'{suffix}")`.
fn fail_sym(inout machine: M, in prefix: Str, sym: u32, in suffix: Str) {
    if !machine.failed {
        machine.failed = true;
        machine.message.clear();
        put(inout machine.message, prefix);
        put_sym(inout machine.message, in machine.ctx.names, sym);
        put(inout machine.message, suffix);
    }
}

fn decline(inout machine: M, in reason: Str, sym: u32) {
    if !machine.declined {
        machine.declined = true;
        machine.message.clear();
        put(inout machine.message, reason);
        if sym != NONE32 {
            put_sym(inout machine.message, in machine.ctx.names, sym);
        }
    }
}

// ----- the effect table --------------------------------------------------------

// Word offsets in a site (`sites` in run_words.rs), from its first word.
const SITE_INST: u64 = 0;
const SITE_KIND: u64 = 1;
// handle: effect, label + 1, instance key + 1, flags, static key, then the
// captured names (count, names), then `HandleTail`.
const HS_EFFECT: u64 = 2;
const HS_LABEL: u64 = 3;
const HS_KEY: u64 = 4;
const HS_FLAGS: u64 = 5;
const HS_FREE_COUNT: u64 = 7;
const HS_FREE: u64 = 8;
// After the captured names: body fn + 1, return clause fn + 1, return
// pattern, operation clause count, then per clause: operation, fn + 1,
// pattern count, patterns.
const HT_BODY: u64 = 0;
const HT_RET: u64 = 1;
const HT_RET_PAT: u64 = 2;
const HT_OP_COUNT: u64 = 3;
const HT_OPS: u64 = 4;
const CL_OP: u64 = 0;
const CL_FN: u64 = 1;
const CL_PAT_COUNT: u64 = 2;
const CL_PATS: u64 = 3;
// effect call: effect, operation, instance key + 1.
const EC_EFFECT: u64 = 2;
const EC_OP: u64 = 3;
const EC_KEY: u64 = 4;
// try: instance key + 1.
const TRY_KEY: u64 = 2;
// Handle flags: the expression has a type (a `Frame::Coerce`); a state.
const FLAG_COERCE: u64 = 1;
const FLAG_STATE: u64 = 2;
// Pattern words: `_`, or a pattern the machine does not bind.
const PAT_WILD: u64 = 0;
const PAT_OTHER: u64 = 18446744073709551615;
// `Op::Handle` operands: state flag, state value, pool index, then the
// alias count and (name, slot) pairs.
const HO_ALIAS_COUNT: u64 = 3;
// A call argument's pass word for `inout` (`Pass::Inout`).
const PASS_INOUT: u64 = 1;
// Words per call argument: pass, value, root + 1, path.
const ARG_WORDS: u64 = 4;

fn site_word(in machine: M, at: u64) -> u64 {
    u64_at(in machine.sites, at)
}

fn name_word(in machine: M, index: u64) -> u64 {
    w(u32_at(in machine.ctx.nmap, index))
}

// A `name + 1` word, or 0.
fn opt_name_word(in machine: M, word: u64) -> u64 {
    if word == 0 {
        0
    } else {
        inc(name_word(in machine, wrapping_sub(word, 1)))
    }
}

fn pattern_word(in machine: M, word: u64) -> u64 {
    if word == PAT_WILD || word == PAT_OTHER {
        word
    } else {
        opt_name_word(in machine, word)
    }
}

// Reads the effect table after the entry, with names as symbols.
pub fn read_sites(inout machine: M, inout reader: Reader, in bytes: Slice[u8]) {
    machine.key_overflow = opt_name_word(in machine, reader.word(in bytes));
    machine.key_runtime = opt_name_word(in machine, reader.word(in bytes));
    machine.site_of.resize(machine.program.insts.len(), 0);
    let site_count = reader.word(in bytes);
    for i in 0..site_count {
        let inst_id = reader.word(in bytes);
        let kind = reader.word(in bytes);
        let ok = machine.site_of.try_set(inst_id, inc(machine.sites.len()));
        machine.sites.push(inst_id);
        machine.sites.push(kind);
        if kind == SITE_HANDLE {
            let effect = name_word(in machine, reader.word(in bytes));
            machine.sites.push(effect);
            let label = opt_name_word(in machine, reader.word(in bytes));
            machine.sites.push(label);
            let key = opt_name_word(in machine, reader.word(in bytes));
            machine.sites.push(key);
            machine.sites.push(reader.word(in bytes));
            let static_key = name_word(in machine, reader.word(in bytes));
            machine.sites.push(static_key);
            let free_count = reader.word(in bytes);
            machine.sites.push(free_count);
            for j in 0..free_count {
                let name = name_word(in machine, reader.word(in bytes));
                machine.sites.push(name);
            }
            let body = opt_name_word(in machine, reader.word(in bytes));
            machine.sites.push(body);
            let ret = opt_name_word(in machine, reader.word(in bytes));
            machine.sites.push(ret);
            let ret_pat = pattern_word(in machine, reader.word(in bytes));
            machine.sites.push(ret_pat);
            let op_count = reader.word(in bytes);
            machine.sites.push(op_count);
            for j in 0..op_count {
                let op_name = name_word(in machine, reader.word(in bytes));
                machine.sites.push(op_name);
                let clause = opt_name_word(in machine, reader.word(in bytes));
                machine.sites.push(clause);
                let pat_count = reader.word(in bytes);
                machine.sites.push(pat_count);
                for k in 0..pat_count {
                    let pat = pattern_word(in machine, reader.word(in bytes));
                    machine.sites.push(pat);
                }
            }
        } else if kind == SITE_EFFECT_CALL {
            let effect = name_word(in machine, reader.word(in bytes));
            machine.sites.push(effect);
            let op_name = name_word(in machine, reader.word(in bytes));
            machine.sites.push(op_name);
            let key = opt_name_word(in machine, reader.word(in bytes));
            machine.sites.push(key);
        } else if kind == SITE_TRY {
            let key = opt_name_word(in machine, reader.word(in bytes));
            machine.sites.push(key);
        }
    }
}

// The site of instruction `inst_id` of kind `kind`, or NONE64.
fn site(in machine: M, inst_id: u64, kind: u64) -> u64 {
    let slot = u64_at(in machine.site_of, inst_id);
    if slot == 0 {
        return NONE64;
    }
    let at = wrapping_sub(slot, 1);
    if site_word(in machine, add(at, SITE_KIND)) != kind {
        return NONE64;
    }
    at
}

// The first word after a handle site's captured names.
fn handle_tail(in machine: M, at: u64) -> u64 {
    add(add(at, HS_FREE), site_word(in machine, add(at, HS_FREE_COUNT)))
}

// The function of a `fn + 1` word, or NONE64.
fn site_fn(in machine: M, word: u64) -> u64 {
    if word == 0 {
        NONE64
    } else {
        fn_index(in machine, n32(wrapping_sub(word, 1)))
    }
}

// The end of the operation clause at `at`.
fn clause_end(in machine: M, at: u64) -> u64 {
    add(add(at, CL_PATS), site_word(in machine, add(at, CL_PAT_COUNT)))
}

// `scan` of handle site `at`: its bodies are reached, or the machine
// declines what it does not run yet.
fn scan_handle(inout machine: M, at: u64, inout work: ChunkSeq[u64]) {
    if site_word(in machine, add(at, HS_FLAGS)) & FLAG_STATE != 0 {
        decline(inout machine, "a state handler", NONE32);
        return;
    }
    let tail = handle_tail(in machine, at);
    let body = site_fn(in machine, site_word(in machine, add(tail, HT_BODY)));
    let ret = site_fn(in machine, site_word(in machine, add(tail, HT_RET)));
    if body == NONE64 || ret == NONE64 {
        decline(inout machine, "a handler body run as an expression", NONE32);
        return;
    }
    if site_word(in machine, add(tail, HT_RET_PAT)) == PAT_OTHER {
        decline(inout machine, "a handler clause pattern", NONE32);
        return;
    }
    reach(inout machine, body, inout work);
    reach(inout machine, ret, inout work);
    let mut clause_at = add(tail, HT_OPS);
    for i in 0..site_word(in machine, add(tail, HT_OP_COUNT)) {
        let clause = site_fn(in machine, site_word(in machine, add(clause_at, CL_FN)));
        if clause == NONE64 {
            decline(inout machine, "a handler body run as an expression", NONE32);
            return;
        }
        reach(inout machine, clause, inout work);
        // The last pattern binds the continuation.
        let pat_count = site_word(in machine, add(clause_at, CL_PAT_COUNT));
        if pat_count != 0 {
            let cont = site_word(
                in machine,
                add(add(clause_at, CL_PATS), wrapping_sub(pat_count, 1))
            );
            if cont != PAT_WILD && cont != PAT_OTHER {
                if clause >= machine.cont_names.len() {
                    machine.cont_names.resize(inc(clause), 0);
                }
                let ok = machine.cont_names.try_set(clause, n32(cont));
            }
        }
        for j in 0..pat_count {
            if site_word(in machine, add(add(clause_at, CL_PATS), j)) == PAT_OTHER {
                decline(inout machine, "a handler clause pattern", NONE32);
                return;
            }
        }
        clause_at = clause_end(in machine, clause_at);
    }
}

// The `Eval` of a handler expression (`ExprKind::Handle` without a
// state): its `Frame::Coerce`, its `Frame::Handler` over the captured
// environment, then the body's activation over the aliased places.
fn install(inout machine: M) {
    let inst_id = machine.pending;
    let inst = machine.program.inst(inst_id);
    let at = site(in machine, inst_id, SITE_HANDLE);
    if site_word(in machine, add(at, HS_FLAGS)) & FLAG_COERCE != 0 {
        let mut coerce_frame = machine.frame;
        coerce_frame.kind = FR_COERCE;
        coerce_frame.ty = inst.ty;
        machine.stack.push(coerce_frame);
    }
    let val_base = machine.vals.len();
    let env_base = machine.env.len();
    let cell_base = machine.cells.len();
    let seg_base = machine.segs.len();
    // The aliases resolve in the suspended activation.
    let mut slots: ChunkSeq[En] = ChunkSeq::new[En]();
    let alias_at = add(inst.a, HO_ALIAS_COUNT);
    for i in 0..machine.program.op(alias_at) {
        let pair_at = add(inc(alias_at), wrapping_mul(i, 2));
        let name = n32(machine.program.op(pair_at));
        let bound_index = binding(in machine, n32(machine.program.op(inc(pair_at))));
        if bound_index != NONE64 {
            let env_entry = entry(in machine, bound_index);
            let seg_start = machine.segs.len();
            for j in 0..env_entry.seg_count {
                machine.segs.push(u32_at(in machine.segs, add(env_entry.seg_start, j)));
            }
            slots.push(En {
                name: name,
                cell: env_entry.cell,
                seg_start: seg_start,
                seg_count: env_entry.seg_count
            });
        }
    }
    // `handler_environment`: the clauses' free names, by value.
    let hcap_start = machine.hcap_names.len();
    for i in 0..site_word(in machine, add(at, HS_FREE_COUNT)) {
        let name = n32(site_word(in machine, add(add(at, HS_FREE), i)));
        let mut k = slots.len();
        loop {
            if k == 0 {
                break;
            }
            k = wrapping_sub(k, 1);
            let slot = match slots.try_get(k) {
                Option::Some(found) => found,
                Option::None => En { name: 0, cell: 0, seg_start: 0, seg_count: 0 },
            };
            if slot.name == name {
                slot_path(inout machine, slot);
                let value = read_path(inout machine, slot.cell);
                if machine.failed {
                    return;
                }
                machine.hcap_names.push(name);
                machine.hcap_vals.push(value);
                break;
            }
        }
    }
    let mut handler_frame = machine.frame;
    handler_frame.kind = FR_HANDLER;
    handler_frame.func_index = at;
    handler_frame.block = hcap_start;
    handler_frame.ip = wrapping_sub(machine.hcap_names.len(), hcap_start);
    handler_frame.val_base = val_base;
    handler_frame.env_base = env_base;
    handler_frame.cell_base = cell_base;
    handler_frame.seg_base = seg_base;
    machine.stack.push(handler_frame);
    for i in 0..slots.len() {
        match slots.try_get(i) {
            Option::Some(env_entry) => machine.env.push(env_entry),
            Option::None => {},
        }
    }
    let body = site_fn(
        in machine,
        site_word(in machine, add(handle_tail(in machine, at), HT_BODY))
    );
    let fn_info = func(in machine, body);
    machine.vals.resize(add(val_base, fn_info.value_count), undef());
    machine
        .frame = Fr {
            func_index: body,
            block: fn_info.first_block,
            ip: 0,
            val_base: val_base,
            env_base: env_base,
            cell_base: cell_base,
            seg_base: seg_base,
            dest: 0,
            ty: 0,
            kind: FR_IR
        };
    machine.control = C_IR;
}

// A clause's activation of function `func_index` where `handler` was
// installed, over a copy of its captured environment
// (`snapshot_environment`); the handler's captures are released.
fn clause_frame(inout machine: M, handler: Fr, func_index: u64) {
    machine.vals.truncate(handler.val_base);
    machine.env.truncate(handler.env_base);
    machine.cells.truncate(handler.cell_base);
    machine.segs.truncate(handler.seg_base);
    for i in 0..handler.ip {
        let cell = machine.cells.len();
        machine.cells.push(match machine.hcap_vals.try_get(add(handler.block, i)) {
            Option::Some(value) => value,
            Option::None => undef(),
        });
        machine.env.push(En {
            name: u32_at(in machine.hcap_names, add(handler.block, i)),
            cell: cell,
            seg_start: 0,
            seg_count: 0
        });
    }
    machine.hcap_names.truncate(handler.block);
    machine.hcap_vals.truncate(handler.block);
    let fn_info = func(in machine, func_index);
    machine.vals.resize(add(handler.val_base, fn_info.value_count), undef());
    machine
        .frame = Fr {
            func_index: func_index,
            block: fn_info.first_block,
            ip: 0,
            val_base: handler.val_base,
            env_base: handler.env_base,
            cell_base: handler.cell_base,
            seg_base: handler.seg_base,
            dest: 0,
            ty: 0,
            kind: FR_IR
        };
    machine.control = C_IR;
}

// The handler's body returned `value` (`Frame::Handler` in `drive`): its
// return clause runs.
fn handler_return(inout machine: M, handler: Fr, value: Val) {
    let tail = handle_tail(in machine, handler.func_index);
    let ret = site_fn(in machine, site_word(in machine, add(tail, HT_RET)));
    clause_frame(inout machine, handler, ret);
    let pat = site_word(in machine, add(tail, HT_RET_PAT));
    if pat != PAT_WILD {
        bind_new(inout machine, n32(wrapping_sub(pat, 1)), value);
    }
}

// `perform` of `effect::op` on `arg_vals`, with the instance key `key`
// (symbol + 1, or 0) the raising activation's evidence names: the
// innermost handler with that key, else the innermost of the effect.
fn perform(inout machine: M, effect: u32, op_name: u32, key: u64) {
    let mut found = NONE64;
    let mut i = machine.stack.len();
    loop {
        if i == 0 || key == 0 {
            break;
        }
        i = wrapping_sub(i, 1);
        let frame = stack_at(in machine, i);
        if frame.kind == FR_HANDLER && site_word(in machine, add(frame.func_index, HS_KEY)) == key {
            found = i;
            break;
        }
    }
    i = machine.stack.len();
    loop {
        if i == 0 || found != NONE64 {
            break;
        }
        i = wrapping_sub(i, 1);
        let frame = stack_at(in machine, i);
        if frame.kind == FR_HANDLER
            && site_word(in machine, add(frame.func_index, HS_EFFECT)) == w(effect)
        {
            found = i;
        }
    }
    if found == NONE64 {
        if !machine.failed {
            machine.failed = true;
            machine.message.clear();
            put(inout machine.message, "unhandled effect ");
            put_sym(inout machine.message, in machine.ctx.names, effect);
            put(inout machine.message, "::");
            put_sym(inout machine.message, in machine.ctx.names, op_name);
        }
        return;
    }
    let handler = stack_at(in machine, found);
    machine.stack.truncate(found);
    let tail = handle_tail(in machine, handler.func_index);
    let mut clause_at = add(tail, HT_OPS);
    let mut clause = NONE64;
    for j in 0..site_word(in machine, add(tail, HT_OP_COUNT)) {
        if clause == NONE64 && site_word(in machine, add(clause_at, CL_OP)) == w(op_name) {
            clause = clause_at;
        }
        clause_at = clause_end(in machine, clause_at);
    }
    if clause == NONE64 {
        fail(inout machine, "handler lacks operation");
        return;
    }
    // The arguments, then the continuation.
    let pat_count = site_word(in machine, add(clause, CL_PAT_COUNT));
    let arg_count = machine.arg_vals.len();
    if inc(arg_count) != pat_count {
        fail(inout machine, "operation handler pattern arity mismatch");
        return;
    }
    let mut args: ChunkSeq[Val] = ChunkSeq::new[Val]();
    for j in 0..arg_count {
        args.push(match machine.arg_vals.try_get(j) {
            Option::Some(value) => value,
            Option::None => undef(),
        });
    }
    args.push(Val { tag: T_CONT, payload: 0 });
    clause_frame(
        inout machine,
        handler,
        site_fn(in machine, site_word(in machine, add(clause, CL_FN)))
    );
    for j in 0..pat_count {
        let pat = site_word(in machine, add(add(clause, CL_PATS), j));
        if pat != PAT_WILD {
            let value = match args.try_get(j) {
                Option::Some(found_value) => found_value,
                Option::None => undef(),
            };
            bind_new(inout machine, n32(wrapping_sub(pat, 1)), value);
        }
    }
}

fn stack_at(in machine: M, index: u64) -> Fr {
    match machine.stack.try_get(index) {
        Option::Some(frame) => frame,
        Option::None => fr_zero(),
    }
}

// A primitive failure (`raise_primitive`): `Fail::raise` of the failure's
// value through the typed `Fail` instance in scope.
fn raise(inout machine: M, failure: u8) {
    let ctor = if failure == P_OVERFLOW {
        machine.overflow_sym
    } else if failure == P_DIV_ZERO {
        machine.div_zero_sym
    } else {
        machine.index_sym
    };
    let key = if failure == P_OVERFLOW {
        machine.key_overflow
    } else {
        machine.key_runtime
    };
    let payload = make(inout machine, T_DATA, ctor, machine.kids.len());
    machine.arg_vals.clear();
    machine.arg_vals.push(payload);
    perform(inout machine, machine.fail_sym, machine.raise_sym, key);
}

// ----- symbols -----------------------------------------------------------------

fn lookup(in machine: M, in text: Str) -> u32 {
    machine.ctx.names.lookup(in text.as_bytes())
}

fn spells(in machine: M, sym: u32, in text: Str) -> bool {
    machine.ctx.names.spells(sym, in text.as_bytes())
}

// `s.parse::<usize>()` of a symbol's text, or NONE64.
fn index_of(in machine: M, sym: u32) -> u64 {
    let text_start = machine.ctx.names.start(sym);
    let text_end = machine.ctx.names.end(sym);
    let mut digit_start = text_start;
    if digit_start < text_end && u8_at(in machine.ctx.names.text, digit_start) == 43 {
        digit_start = inc(digit_start);
    }
    if digit_start >= text_end {
        return NONE64;
    }
    let mut value: u64 = 0;
    for j in digit_start..text_end {
        let byte = u8_at(in machine.ctx.names.text, j);
        if byte < 48 || byte > 57 {
            return NONE64;
        }
        let digit = widen_u64(wrapping_sub(byte, 48));
        if value > 1844674407370955161 || (value == 1844674407370955161 && digit > 5) {
            return NONE64;
        }
        value = wrapping_add(wrapping_mul(value, 10), digit);
    }
    value
}

// The symbol of the text after the last `::` of `sym` (`rsplit("::")`).
fn short_of(inout machine: M, sym: u32) -> u32 {
    let cached = u32_at(in machine.short_syms, w(sym));
    if cached != 0 {
        return wrapping_sub(cached, 1);
    }
    let text_start = machine.ctx.names.start(sym);
    let text_end = machine.ctx.names.end(sym);
    let mut tail_start = text_start;
    let mut pos = text_start;
    loop {
        if inc(pos) >= text_end {
            break;
        }
        if u8_at(in machine.ctx.names.text, pos) == 58
            && u8_at(in machine.ctx.names.text, inc(pos)) == 58
        {
            tail_start = add(pos, 2);
            pos = add(pos, 2);
        } else {
            pos = inc(pos);
        }
    }
    let mut bytes: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for j in tail_start..text_end {
        bytes.push(u8_at(in machine.ctx.names.text, j));
    }
    let short_sym = machine.ctx.names.intern(in bytes[0..bytes.len()]);
    if w(sym) >= machine.short_syms.len() {
        machine.short_syms.resize(inc(w(sym)), 0);
    }
    let ok = machine.short_syms.try_set(w(sym), wrapping_add(short_sym, 1));
    short_sym
}

// `World::constructor(name)`: the variant's symbol, or NONE32.
fn ctor_of(inout machine: M, sym: u32) -> u32 {
    let text_start = machine.ctx.names.start(sym);
    let text_end = machine.ctx.names.end(sym);
    let mut sep_count: u64 = 0;
    let mut sep_at = text_start;
    let mut pos = text_start;
    loop {
        if inc(pos) >= text_end {
            break;
        }
        if u8_at(in machine.ctx.names.text, pos) == 58
            && u8_at(in machine.ctx.names.text, inc(pos)) == 58
        {
            sep_count = inc(sep_count);
            sep_at = pos;
            pos = add(pos, 2);
        } else {
            pos = inc(pos);
        }
    }
    if sep_count > 1 {
        return NONE32;
    }
    let mut qualifier = NONE32;
    let mut short_sym = sym;
    if sep_count == 1 {
        let mut qual_text: ChunkSeq[u8] = ChunkSeq::new[u8]();
        for j in text_start..sep_at {
            qual_text.push(u8_at(in machine.ctx.names.text, j));
        }
        let mut short_text: ChunkSeq[u8] = ChunkSeq::new[u8]();
        for j in add(sep_at, 2)..text_end {
            short_text.push(u8_at(in machine.ctx.names.text, j));
        }
        qualifier = machine.ctx.names.lookup(in qual_text[0..qual_text.len()]);
        short_sym = machine.ctx.names.lookup(in short_text[0..short_text.len()]);
        if qualifier == NONE32 || short_sym == NONE32 {
            return NONE32;
        }
    }
    if constructor(in machine.ctx.world, qualifier, short_sym) == NONE64 {
        NONE32
    } else {
        short_sym
    }
}

// ----- types -------------------------------------------------------------------

fn int_kind(inout machine: M, ty: u32) -> u8 {
    let ty_index = w(ty);
    let cached = u8_at(in machine.type_kinds, ty_index);
    if ty_index < machine.type_kinds.len() && cached != TK_UNSEEN {
        return cached;
    }
    let kind = if machine.ctx.types.kind(ty) != TyKind::Named || machine.ctx.types.arity(ty) != 0 {
        TK_NONE
    } else {
        let name = machine.ctx.types.name(ty);
        let known = machine.ctx.world.k;
        if name == known.i64_ || name == known.isize_ {
            K_I64
        } else if name == known.u8_ {
            K_U8
        } else if name == known.u16_ {
            K_U16
        } else if name == known.u32_ {
            K_U32
        } else if name == known.u64_ || name == known.usize_ {
            K_U64
        } else if name == known.i8_ {
            K_I8
        } else if name == known.i16_ {
            K_I16
        } else if name == known.i32_ {
            K_I32
        } else {
            TK_NONE
        }
    };
    if ty_index >= machine.type_kinds.len() {
        machine.type_kinds.resize(inc(ty_index), TK_UNSEEN);
    }
    let ok = machine.type_kinds.try_set(ty_index, kind);
    kind
}

// `coerce_value`: an integer takes the kind of an integer type.
fn coerce(inout machine: M, value: Val, ty: u32) -> Val {
    if value.tag > K_I32 {
        return value;
    }
    let kind = int_kind(inout machine, ty);
    if kind == TK_NONE {
        return value;
    }
    Val { tag: kind, payload: wrap(kind, exact(value.tag, value.payload)) }
}

// Whether the machine runs values of type `ty` (`scan`).
fn type_ok(in machine: M, ty: u32, depth: u64) -> bool {
    if depth > 64 {
        return false;
    }
    let node = machine.ctx.types.node(ty);
    if node.kind == TyKind::Named {
        let name = node.name;
        let known = machine.ctx.world.k;
        if name == known.f32_
            || name == known.f64_
            || name == known.i128_
            || name == known.u128_
            || name == known.chunk_seq
            || name == known.slice
            || name == known.tiled_seq
            || name == known.box_
            || name == known.vec
            || name == known.mask
            || name == known.region
            || name == known.region_box
            || name == known.watermark
            || name == known.dyn_
            || spells(in machine, name, "Atomic")
        {
            return false;
        }
    }
    if node.kind == TyKind::Fn {
        // A function value with effects may carry bound evidence
        // (`bind_callable_evidence`), which the machine does not keep; only
        // a clause's continuation is let through (`cont_names`).
        let row = machine.ctx.types.row(node.r2);
        if row.n != 0 || row.tail != 0 {
            return false;
        }
        if !type_ok(in machine, node.r, inc(depth)) {
            return false;
        }
    }
    if node.kind == TyKind::Named || node.kind == TyKind::Tuple || node.kind == TyKind::Fn {
        for i in 0..w(node.n) {
            if !type_ok(in machine, machine.ctx.types.arg(ty, i), inc(depth)) {
                return false;
            }
        }
    }
    true
}

// ----- loading -----------------------------------------------------------------

fn op_code(in machine: M, sym: u32) -> u64 {
    let text_start = machine.ctx.names.start(sym);
    let text_end = machine.ctx.names.end(sym);
    let len = wrapping_sub(text_end, text_start);
    if len == 1 {
        let byte = u8_at(in machine.ctx.names.text, text_start);
        if byte == 43 {
            return widen_u64(B_ADD);
        } else if byte == 45 {
            return widen_u64(B_SUB);
        } else if byte == 42 {
            return widen_u64(B_MUL);
        } else if byte == 47 {
            return widen_u64(B_DIV);
        } else if byte == 37 {
            return widen_u64(B_REM);
        } else if byte == 38 {
            return widen_u64(B_AND);
        } else if byte == 124 {
            return widen_u64(B_OR);
        } else if byte == 94 {
            return widen_u64(B_XOR);
        } else if byte == 60 {
            return widen_u64(B_LT);
        } else if byte == 62 {
            return widen_u64(B_GT);
        }
        return 0;
    }
    if spells(in machine, sym, "<<") {
        widen_u64(B_SHL)
    } else if spells(in machine, sym, ">>") {
        widen_u64(B_SHR)
    } else if spells(in machine, sym, "==") {
        widen_u64(B_EQ)
    } else if spells(in machine, sym, "!=") {
        widen_u64(B_NE)
    } else if spells(in machine, sym, "<=") {
        widen_u64(B_LE)
    } else if spells(in machine, sym, ">=") {
        widen_u64(B_GE)
    } else if spells(in machine, sym, "&&") {
        widen_u64(B_LAND)
    } else if spells(in machine, sym, "||") {
        widen_u64(B_LOR)
    } else if spells(in machine, sym, "wrapping_add") {
        widen_u64(B_WADD)
    } else if spells(in machine, sym, "wrapping_sub") {
        widen_u64(B_WSUB)
    } else if spells(in machine, sym, "wrapping_mul") {
        widen_u64(B_WMUL)
    } else if spells(in machine, sym, "rotate_left") {
        widen_u64(B_ROTL)
    } else if spells(in machine, sym, "rotate_right") {
        widen_u64(B_ROTR)
    } else if spells(in machine, sym, "bit_and") {
        widen_u64(B_BAND)
    } else if spells(in machine, sym, "bit_or") {
        widen_u64(B_BOR)
    } else if spells(in machine, sym, "bit_xor") {
        widen_u64(B_BXOR)
    } else if spells(in machine, sym, "bit_shl") {
        widen_u64(B_BSHL)
    } else if spells(in machine, sym, "bit_shr") {
        widen_u64(B_BSHR)
    } else {
        0
    }
}

// The kind named by the text `names.text[a..e]`, or TK_NONE.
fn kind_named(in machine: M, text_start: u64, text_end: u64) -> u8 {
    let mut bytes: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for j in text_start..text_end {
        bytes.push(u8_at(in machine.ctx.names.text, j));
    }
    let sym = machine.ctx.names.lookup(in bytes[0..bytes.len()]);
    if sym == NONE32 {
        return TK_NONE;
    }
    let known = machine.ctx.world.k;
    if sym == known.i64_ || sym == known.isize_ {
        K_I64
    } else if sym == known.u8_ {
        K_U8
    } else if sym == known.u16_ {
        K_U16
    } else if sym == known.u32_ {
        K_U32
    } else if sym == known.u64_ || sym == known.usize_ {
        K_U64
    } else if sym == known.i8_ {
        K_I8
    } else if sym == known.i16_ {
        K_I16
    } else if sym == known.i32_ {
        K_I32
    } else {
        TK_NONE
    }
}

fn has_prefix(in machine: M, sym: u32, in prefix: Str) -> bool {
    machine.ctx.names.has_prefix(sym, in prefix.as_bytes())
}

fn unary_code(in machine: M, sym: u32) -> u64 {
    if spells(in machine, sym, "-") {
        return U_NEG;
    }
    if spells(in machine, sym, "!") {
        return U_NOT;
    }
    if spells(in machine, sym, "~") {
        return U_INV;
    }
    let text_start = machine.ctx.names.start(sym);
    let text_end = machine.ctx.names.end(sym);
    let mut family = NONE64;
    let mut kind_at = text_start;
    if has_prefix(in machine, sym, "widen_") {
        family = C_WIDEN;
        kind_at = add(text_start, 6);
    } else if has_prefix(in machine, sym, "narrow_") {
        family = C_NARROW;
        kind_at = add(text_start, 7);
    } else if has_prefix(in machine, sym, "wrapping_") {
        family = C_WRAPPING;
        kind_at = add(text_start, 9);
    }
    if family == NONE64 {
        return 0;
    }
    let kind = kind_named(in machine, kind_at, text_end);
    if kind == TK_NONE {
        return 0;
    }
    add(add(U_CONV, wrapping_mul(family, 16)), widen_u64(kind))
}

// Reads every function's header: parameters, value count, first block.
pub fn load(inout machine: M, entry_index: u64) {
    machine.ok_sym = machine.ctx.names.intern(in "Ok".as_bytes());
    machine.err_sym = machine.ctx.names.intern(in "Err".as_bytes());
    machine.zero_sym = machine.ctx.names.intern(in "0".as_bytes());
    machine.dot_sym = machine.ctx.names.intern(in ".".as_bytes());
    machine.fail_sym = machine.ctx.names.intern(in "Fail".as_bytes());
    machine.raise_sym = machine.ctx.names.intern(in "raise".as_bytes());
    machine.overflow_sym = machine.ctx.names.intern(in "ArithOverflow".as_bytes());
    machine.div_zero_sym = machine.ctx.names.intern(in "DivisionByZero".as_bytes());
    machine.index_sym = machine.ctx.names.intern(in "IndexOutOfBounds".as_bytes());
    let entry_sym = u32_at(in machine.ctx.nmap, entry_index);
    machine.aux.resize(machine.program.insts.len(), 0);
    machine.block_params.resize(machine.program.blocks.len(), 0);
    for func_index in 0..machine.program.fns.len() {
        let fn_row = machine.program.function(func_index);
        let mut cursor = fn_row.ha;
        let param_count = machine.program.op(cursor);
        cursor = inc(cursor);
        let param_start = machine.params.len();
        for i in 0..param_count {
            let name = n32(machine.program.op(cursor));
            let pass = machine.program.op(inc(cursor));
            let path_count = machine.program.op(add(cursor, 2));
            cursor = add(cursor, add(3, path_count));
            // type, span start, end
            cursor = add(cursor, 3);
            machine.params.push(Pm { name: name, pass: pass });
        }
        // result, effects
        cursor = add(cursor, 2);
        let bound_count = machine.program.op(cursor);
        cursor = add(inc(cursor), wrapping_mul(bound_count, 2));
        let name_count = machine.program.op(cursor);
        cursor = add(inc(cursor), name_count);
        let value_entries = machine.program.op(cursor);
        cursor = inc(cursor);
        let mut value_count: u64 = 0;
        for i in 0..value_entries {
            let value_id = machine.program.op(cursor);
            if inc(value_id) > value_count {
                value_count = inc(value_id);
            }
            cursor = add(cursor, 2);
        }
        // Instruction destinations and block parameters too.
        for block_index in 0..fn_row.bc {
            let block_id = add(fn_row.b0, block_index);
            let block = machine.program.block(block_id);
            let token_in_count = machine.program.op(inc(block.ha));
            let params_at = add(add(block.ha, 3), wrapping_mul(token_in_count, 2));
            let ok = machine.block_params.try_set(block_id, params_at);
            let block_param_count = machine.program.op(params_at);
            for j in 0..block_param_count {
                let value_id = machine.program.op(add(inc(params_at), j));
                if inc(value_id) > value_count {
                    value_count = inc(value_id);
                }
            }
            for inst_index in 0..block.ic {
                let inst = machine.program.inst(add(block.i0, inst_index));
                if inc(w(inst.dest)) > value_count {
                    value_count = inc(w(inst.dest));
                }
            }
        }
        machine.fns.push(Fi {
            name: fn_row.name,
            param_start: param_start,
            param_count: param_count,
            value_count: value_count,
            first_block: fn_row.b0,
            reached: false
        });
        if w(fn_row.name) >= machine.fn_of.len() {
            machine.fn_of.resize(inc(w(fn_row.name)), 0);
        }
        let ok = machine.fn_of.try_set(w(fn_row.name), n32(inc(func_index)));
    }
    let entry_slot = u32_at(in machine.fn_of, w(entry_sym));
    if entry_index == NONE64 || entry_slot == 0 {
        decline(inout machine, "the entry has no lowered body", NONE32);
        return;
    }
    machine.entry = w(wrapping_sub(entry_slot, 1));
}

fn fn_index(in machine: M, sym: u32) -> u64 {
    let slot = u32_at(in machine.fn_of, w(sym));
    if slot == 0 {
        NONE64
    } else {
        w(wrapping_sub(slot, 1))
    }
}

// The end of the pattern at operand `at`.
fn pat_end(in machine: M, at: u64) -> u64 {
    let kind = machine.program.op(at);
    let body_at = add(at, 3);
    if kind == widen_u64(Pat::Bind) {
        inc(body_at)
    } else if kind == widen_u64(Pat::Literal) {
        add(body_at, 3)
    } else if kind == widen_u64(Pat::Tuple) {
        let n = machine.program.op(body_at);
        let mut sub_at = inc(body_at);
        for i in 0..n {
            sub_at = pat_end(in machine, sub_at);
        }
        sub_at
    } else if kind == widen_u64(Pat::Constructor) {
        let n = machine.program.op(add(body_at, 2));
        let mut sub_at = add(body_at, 3);
        for i in 0..n {
            sub_at = pat_end(in machine, inc(sub_at));
        }
        sub_at
    } else {
        body_at
    }
}

// Declines a literal the machine has no value for (a float, a 128-bit
// integer, a non-ASCII string, whose `Debug` text needs Unicode tables).
fn scan_literal(inout machine: M, at: u64) {
    let kind = machine.program.op(at);
    let lo = machine.program.op(inc(at));
    let hi = machine.program.op(add(at, 2));
    if kind == widen_u64(Lit::Int) {
        let neg = hi == NONE64 && (lo >> 63) == 1;
        if !(hi == 0 || neg) {
            decline(inout machine, "a 128-bit integer literal", NONE32);
        }
    } else if kind == widen_u64(Lit::String) {
        let sym = n32(lo);
        let text_start = machine.ctx.names.start(sym);
        let text_end = machine.ctx.names.end(sym);
        for i in text_start..text_end {
            if u8_at(in machine.ctx.names.text, i) >= 128 {
                decline(inout machine, "a non-ASCII string literal", NONE32);
            }
        }
    } else if kind != widen_u64(Lit::Bool) {
        decline(inout machine, "a float or wide literal", NONE32);
    }
}

fn scan_pattern(inout machine: M, at: u64) {
    let kind = machine.program.op(at);
    let body_at = add(at, 3);
    if kind == widen_u64(Pat::Literal) {
        scan_literal(inout machine, body_at);
    } else if kind == widen_u64(Pat::Tuple) {
        let n = machine.program.op(body_at);
        let mut sub_at = inc(body_at);
        for i in 0..n {
            scan_pattern(inout machine, sub_at);
            sub_at = pat_end(in machine, sub_at);
        }
    } else if kind == widen_u64(Pat::Constructor) {
        let n = machine.program.op(add(body_at, 2));
        let mut sub_at = add(body_at, 3);
        for i in 0..n {
            scan_pattern(inout machine, inc(sub_at));
            sub_at = pat_end(in machine, inc(sub_at));
        }
    }
}

fn reach(inout machine: M, func_index: u64, inout work: ChunkSeq[u64]) {
    match machine.fns.try_get(func_index) {
        Option::Some(fn_info) => {
            if !fn_info.reached {
                let mut updated = fn_info;
                updated.reached = true;
                let ok = machine.fns.try_set(func_index, updated);
                work.push(func_index);
            }
        },
        Option::None => {},
    }
}

// Splits a `Write` place at its dots into a `writes` row.
fn split_place(inout machine: M, place: u32, code: u64) -> u64 {
    let text_start = machine.ctx.names.start(place);
    let text_end = machine.ctx.names.end(place);
    let mut parts: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut part: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for i in text_start..text_end {
        let byte = u8_at(in machine.ctx.names.text, i);
        if byte == 46 {
            parts.push(machine.ctx.names.intern(in part[0..part.len()]));
            part.clear();
        } else {
            part.push(byte);
        }
    }
    parts.push(machine.ctx.names.intern(in part[0..part.len()]));
    let seg_start = machine.write_segs.len();
    for i in 1..parts.len() {
        machine.write_segs.push(u32_at(in parts, i));
    }
    let row = machine.writes.len();
    machine.writes.push(Wr {
        root: u32_at(in parts, 0),
        seg_start: seg_start,
        seg_count: wrapping_sub(parts.len(), 1),
        code: code
    });
    row
}

// Whether every function the entry reaches runs on this machine; fills
// `aux` for their instructions.
pub fn scan(inout machine: M) {
    let mut work: ChunkSeq[u64] = ChunkSeq::new[u64]();
    reach(inout machine, machine.entry, inout work);
    loop {
        if machine.declined {
            return;
        }
        let func_index = match work.pop() {
            Option::Some(func_index) => func_index,
            Option::None => {
                break;
            },
        };
        let fn_info = match machine.fns.try_get(func_index) {
            Option::Some(found) => found,
            Option::None => {
                break;
            },
        };
        let fn_row = machine.program.function(func_index);
        // Header types: parameters, result, effects aside, values.
        let mut cursor = fn_row.ha;
        let param_count = machine.program.op(cursor);
        cursor = inc(cursor);
        let cont_name = u32_at(in machine.cont_names, func_index);
        let mut cont_type: u32 = 0;
        for i in 0..param_count {
            let param_name = n32(machine.program.op(cursor));
            let path_count = machine.program.op(add(cursor, 2));
            cursor = add(cursor, add(3, path_count));
            let param_type = n32(machine.program.op(cursor));
            if cont_name != 0 && param_name == wrapping_sub(cont_name, 1) {
                cont_type = wrapping_add(param_type, 1);
            } else if !type_ok(in machine, param_type, 0) {
                decline(inout machine, "a parameter type of ", fn_info.name);
            }
            cursor = add(cursor, 3);
        }
        if !type_ok(in machine, n32(machine.program.op(cursor)), 0) {
            decline(inout machine, "the result type of ", fn_info.name);
        }
        for block_index in 0..fn_row.bc {
            let block_id = add(fn_row.b0, block_index);
            let block = machine.program.block(block_id);
            for inst_index in 0..block.ic {
                let inst_id = add(block.i0, inst_index);
                let inst = machine.program.inst(inst_id);
                if !(cont_type != 0 && inst.ty == wrapping_sub(cont_type, 1))
                    && !type_ok(in machine, inst.ty, 0)
                {
                    decline(inout machine, "a value type in ", fn_info.name);
                }
                let operand_at = inst.a;
                let op = inst.op;
                if op == Op::Const {
                    scan_literal(inout machine, operand_at);
                } else if op == Op::Read {
                    let root = n32(machine.program.op(operand_at));
                    let path = machine.program.op(inc(operand_at));
                    let callee_index = fn_index(in machine, root);
                    if callee_index != NONE64 && path == 0 {
                        reach(inout machine, callee_index, inout work);
                    }
                } else if op == Op::Bind {
                    scan_pattern(inout machine, inc(operand_at));
                } else if op == Op::Write {
                    let op_sym = n32(machine.program.op(inc(operand_at)));
                    let mut code: u64 = 0;
                    if !spells(in machine, op_sym, "=") {
                        if has_prefix(in machine, op_sym, "[]") {
                            decline(inout machine, "an array element write", NONE32);
                        }
                        let op_start = machine.ctx.names.start(op_sym);
                        let mut first_text: ChunkSeq[u8] = ChunkSeq::new[u8]();
                        first_text.push(u8_at(in machine.ctx.names.text, op_start));
                        let first_sym = machine.ctx.names.intern(in first_text[0..1]);
                        code = op_code(in machine, first_sym);
                        if code == 0 {
                            decline(inout machine, "the compound assignment ", op_sym);
                        }
                    }
                    let row = split_place(inout machine, n32(machine.program.op(operand_at)), code);
                    let ok = machine.aux.try_set(inst_id, row);
                } else if op == Op::Unary {
                    let code = unary_code(in machine, n32(machine.program.op(operand_at)));
                    if code == 0 {
                        decline(
                            inout machine,
                            "the unary operator ",
                            n32(machine.program.op(operand_at))
                        );
                    }
                    let ok = machine.aux.try_set(inst_id, code);
                } else if op == Op::Binary {
                    let code = op_code(in machine, n32(machine.program.op(operand_at)));
                    if code == 0 {
                        decline(
                            inout machine,
                            "the binary operator ",
                            n32(machine.program.op(operand_at))
                        );
                    }
                    let ok = machine.aux.try_set(inst_id, code);
                } else if op == Op::Data {
                    let ctor = ctor_of(inout machine, n32(machine.program.op(operand_at)));
                    let ok = machine
                        .aux
                        .try_set(inst_id, if ctor == NONE32 { 0 } else { inc(w(ctor)) });
                } else if op == Op::Call {
                    let callee = n32(machine.program.op(operand_at));
                    let callee_index = fn_index(in machine, callee);
                    if callee_index == NONE64 {
                        if site(in machine, inst_id, SITE_EFFECT_CALL) == NONE64 {
                            decline(inout machine, "a call of ", callee);
                        } else if has_inout_arg(in machine, inc(operand_at)) {
                            // A clause would bind the caller's place, not a copy.
                            decline(
                                inout machine,
                                "an effect operation with an inout argument",
                                NONE32
                            );
                        } else {
                            let ok = machine.aux.try_set(inst_id, NONE64);
                        }
                    } else {
                        reach(inout machine, callee_index, inout work);
                        let ok = machine.aux.try_set(inst_id, callee_index);
                    }
                } else if op == Op::Exit {
                    if n32(machine.program.op(inc(operand_at))) != fn_info.name {
                        decline(inout machine, "a `return` out of a nested body", NONE32);
                    }
                } else if op == Op::Tuple
                    || op == Op::Unit
                    || op == Op::Project
                    || op == Op::Index
                    || op == Op::Indirect
                    || op == Op::Try
                    || op == Op::Loop
                {} else if op == Op::Closure {
                    decline(inout machine, "a closure in ", fn_info.name);
                } else if op == Op::Handle {
                    let handle_site = site(in machine, inst_id, SITE_HANDLE);
                    if handle_site == NONE64 {
                        decline(inout machine, "a handler in ", fn_info.name);
                    } else {
                        scan_handle(inout machine, handle_site, inout work);
                    }
                } else if op == Op::Seq {
                    decline(inout machine, "a sequence operation in ", fn_info.name);
                } else {
                    decline(inout machine, "a vector, tiled or Box operation in ", fn_info.name);
                }
            }
            if block.term == Term::Match {
                let n = machine.program.op(inc(block.ta));
                let mut pat_at = add(block.ta, 2);
                for i in 0..n {
                    scan_pattern(inout machine, pat_at);
                    pat_at = inc(pat_end(in machine, pat_at));
                }
            }
        }
    }
}

// ----- values ------------------------------------------------------------------

fn agg(in machine: M, value: Val) -> Agg {
    if value.payload == NONE64 {
        return Agg { ctor: 0, kid_start: 0, kid_count: 0 };
    }
    match machine.heap.try_get(value.payload) {
        Option::Some(found) => found,
        Option::None => Agg { ctor: 0, kid_start: 0, kid_count: 0 },
    }
}

fn kid(in machine: M, kid_index: u64) -> Val {
    match machine.kids.try_get(kid_index) {
        Option::Some(v) => v,
        Option::None => undef(),
    }
}

// A new aggregate from `kids[a..]` (appended by the caller).
fn make(inout machine: M, tag: u8, ctor: u32, kid_start: u64) -> Val {
    let kid_count = wrapping_sub(machine.kids.len(), kid_start);
    if tag == T_TUPLE && kid_count == 0 {
        return unit();
    }
    let heap_index = machine.heap.len();
    machine.heap.push(Agg { ctor: ctor, kid_start: kid_start, kid_count: kid_count });
    Val { tag: tag, payload: heap_index }
}

fn push_kid(inout machine: M, name: u32, value: Val) {
    machine.kids.push(value);
    machine.kid_names.push(name);
}

// The index of field `name` of a data value, or NONE64.
fn field_index(in machine: M, aggregate: Agg, name: u32) -> u64 {
    for i in 0..aggregate.kid_count {
        if u32_at(in machine.kid_names, add(aggregate.kid_start, i)) == name {
            return i;
        }
    }
    NONE64
}

fn sym_less(in machine: M, lhs: u32, rhs: u32) -> bool {
    let lhs_start = machine.ctx.names.start(lhs);
    let lhs_end = machine.ctx.names.end(lhs);
    let rhs_start = machine.ctx.names.start(rhs);
    let rhs_end = machine.ctx.names.end(rhs);
    let lhs_len = wrapping_sub(lhs_end, lhs_start);
    let rhs_len = wrapping_sub(rhs_end, rhs_start);
    let common_len = if lhs_len < rhs_len { lhs_len } else { rhs_len };
    for i in 0..common_len {
        let lhs_byte = u8_at(in machine.ctx.names.text, add(lhs_start, i));
        let rhs_byte = u8_at(in machine.ctx.names.text, add(rhs_start, i));
        if lhs_byte != rhs_byte {
            return lhs_byte < rhs_byte;
        }
    }
    lhs_len < rhs_len
}

// `Value::Display`.
fn display(in machine: M, value: Val, inout out: ChunkSeq[u8], depth: u64) {
    if value.tag <= K_I32 {
        if is_signed(value.tag) {
            put_signed(inout out, wrapping_i64(value.payload));
        } else {
            push_decimal(inout out, value.payload);
        }
    } else if value.tag == T_BOOL {
        if value.payload != 0 {
            put(inout out, "true");
        } else {
            put(inout out, "false");
        }
    } else if value.tag == T_STR {
        debug_str(inout out, in machine.ctx.names, n32(value.payload));
    } else if value.tag == T_FN {
        put(inout out, "<fn ");
        put_sym(inout out, in machine.ctx.names, n32(value.payload));
        put(inout out, ">");
    } else if value.tag == T_TUPLE {
        let aggregate = agg(in machine, value);
        out.push(40);
        for i in 0..aggregate.kid_count {
            if i > 0 {
                put(inout out, ", ");
            }
            display(
                in machine,
                kid(in machine, add(aggregate.kid_start, i)),
                inout out,
                inc(depth)
            );
        }
        out.push(41);
    } else if value.tag == T_DATA {
        let aggregate = agg(in machine, value);
        put_sym(inout out, in machine.ctx.names, aggregate.ctor);
        if aggregate.kid_count == 0 {
            return;
        }
        // The fields in `BTreeMap` order, or by number when every name
        // is one.
        let mut numeric = true;
        for i in 0..aggregate.kid_count {
            if index_of(in machine, u32_at(in machine.kid_names, add(aggregate.kid_start, i)))
                == NONE64
            {
                numeric = false;
            }
        }
        let mut order: ChunkSeq[u64] = ChunkSeq::new[u64]();
        for i in 0..aggregate.kid_count {
            order.push(i);
        }
        // insertion sort (data values have few fields)
        for i in 1..aggregate.kid_count {
            let mut j = i;
            loop {
                if j == 0 {
                    break;
                }
                let prev_field = u64_at(in order, wrapping_sub(j, 1));
                let cur_field = u64_at(in order, j);
                let prev_sym = u32_at(in machine.kid_names, add(aggregate.kid_start, prev_field));
                let cur_sym = u32_at(in machine.kid_names, add(aggregate.kid_start, cur_field));
                let less = if numeric {
                    index_of(in machine, cur_sym) < index_of(in machine, prev_sym)
                } else {
                    sym_less(in machine, cur_sym, prev_sym)
                };
                if !less {
                    break;
                }
                let ok1 = order.try_set(wrapping_sub(j, 1), cur_field);
                let ok2 = order.try_set(j, prev_field);
                j = wrapping_sub(j, 1);
            }
        }
        if numeric {
            out.push(40);
        } else {
            put(inout out, " { ");
        }
        for i in 0..aggregate.kid_count {
            if i > 0 {
                put(inout out, ", ");
            }
            let kid_index = add(aggregate.kid_start, u64_at(in order, i));
            if !numeric {
                put_sym(inout out, in machine.ctx.names, u32_at(in machine.kid_names, kid_index));
                put(inout out, ": ");
            }
            display(in machine, kid(in machine, kid_index), inout out, inc(depth));
        }
        if numeric {
            out.push(41);
        } else {
            put(inout out, " }");
        }
    }
}

fn hex(digit: u64) -> u8 {
    if digit < 10 {
        wrapping_u8(add(digit, 48))
    } else {
        wrapping_u8(add(digit, 87))
    }
}

// Rust's `{:?}` of an ASCII string (`scan` declines the others).
fn debug_str(inout out: ChunkSeq[u8], in names: Names, sym: u32) {
    out.push(34);
    let text_start = names.start(sym);
    let text_end = names.end(sym);
    for i in text_start..text_end {
        let byte = u8_at(in names.text, i);
        if byte == 34 {
            out.push(92);
            out.push(34);
        } else if byte == 92 {
            out.push(92);
            out.push(92);
        } else if byte == 10 {
            out.push(92);
            out.push(110);
        } else if byte == 13 {
            out.push(92);
            out.push(114);
        } else if byte == 9 {
            out.push(92);
            out.push(116);
        } else if byte == 0 {
            out.push(92);
            out.push(48);
        } else if byte < 32 || byte == 127 {
            put(inout out, "\\u{");
            let code_point = widen_u64(byte);
            if code_point >= 16 {
                out.push(hex(code_point / 16));
            }
            out.push(hex(code_point % 16));
            out.push(125);
        } else {
            out.push(byte);
        }
    }
    out.push(34);
}

// `equal`.
fn equal(in machine: M, lhs: Val, rhs: Val) -> bool {
    if lhs.tag <= K_I32 || lhs.tag == T_BOOL || lhs.tag == T_STR {
        return lhs.tag == rhs.tag && lhs.payload == rhs.payload;
    }
    if lhs.tag == T_TUPLE && rhs.tag == T_TUPLE {
        let lhs_agg = agg(in machine, lhs);
        let rhs_agg = agg(in machine, rhs);
        if lhs_agg.kid_count != rhs_agg.kid_count {
            return false;
        }
        for i in 0..lhs_agg.kid_count {
            if !equal(
                in machine,
                kid(in machine, add(lhs_agg.kid_start, i)),
                kid(in machine, add(rhs_agg.kid_start, i))
            ) {
                return false;
            }
        }
        return true;
    }
    if lhs.tag == T_DATA && rhs.tag == T_DATA {
        let lhs_agg = agg(in machine, lhs);
        let rhs_agg = agg(in machine, rhs);
        if lhs_agg.ctor != rhs_agg.ctor || lhs_agg.kid_count != rhs_agg.kid_count {
            return false;
        }
        for i in 0..lhs_agg.kid_count {
            let rhs_field = field_index(
                in machine,
                rhs_agg,
                u32_at(in machine.kid_names, add(lhs_agg.kid_start, i))
            );
            if rhs_field == NONE64 {
                return false;
            }
            if !equal(
                in machine,
                kid(in machine, add(lhs_agg.kid_start, i)),
                kid(in machine, add(rhs_agg.kid_start, rhs_field))
            ) {
                return false;
            }
        }
        return true;
    }
    false
}

// ----- places ------------------------------------------------------------------

// The child of `value` named by segment `seg` (`slot_get`'s step), or an
// error: 1 unknown field, 2 not a tuple index, 3 out of bounds, 4 not an
// aggregate.
fn child(in machine: M, value: Val, seg: u32, inout err: u64) -> u64 {
    let aggregate = agg(in machine, value);
    if value.tag == T_DATA {
        let index = field_index(in machine, aggregate, seg);
        if index == NONE64 {
            err = 1;
        }
        return index;
    }
    if value.tag == T_TUPLE {
        let index = index_of(in machine, seg);
        if index == NONE64 {
            err = 2;
            return index;
        }
        if index >= aggregate.kid_count {
            err = 3;
            return NONE64;
        }
        return index;
    }
    err = 4;
    NONE64
}

// `slot_get` of `cells[cell]` along `machine.path`.
fn read_path(inout machine: M, cell: u64) -> Val {
    let mut value = match machine.cells.try_get(cell) {
        Option::Some(value) => value,
        Option::None => undef(),
    };
    for i in 0..machine.path.len() {
        let seg = u32_at(in machine.path, i);
        let mut err: u64 = 0;
        let child_index = child(in machine, value, seg, inout err);
        if err == 1 {
            fail_sym(inout machine, "unknown field ", seg, "");
            // Rust quotes the field: `unknown field 'f'`.
            machine.message.clear();
            put(inout machine.message, "unknown field '");
            put_sym(inout machine.message, in machine.ctx.names, seg);
            put(inout machine.message, "'");
            return undef();
        } else if err == 2 {
            fail(inout machine, "invalid tuple index");
            return undef();
        } else if err == 3 {
            fail(inout machine, "tuple index out of bounds");
            return undef();
        } else if err == 4 {
            fail(inout machine, "field access requires aggregate");
            return undef();
        }
        value = kid(in machine, add(agg(in machine, value).kid_start, child_index));
    }
    value
}

// `value` with the value at `machine.path[seg_index..]` replaced by `new`.
fn put_path(inout machine: M, value: Val, seg_index: u64, new: Val) -> Val {
    if seg_index >= machine.path.len() {
        return new;
    }
    let seg = u32_at(in machine.path, seg_index);
    let mut err: u64 = 0;
    let child_index = child(in machine, value, seg, inout err);
    if err == 1 {
        fail(inout machine, "unknown field");
        return undef();
    } else if err == 2 {
        fail(inout machine, "invalid index");
        return undef();
    } else if err == 3 {
        fail(inout machine, "index out of bounds");
        return undef();
    } else if err == 4 {
        fail(inout machine, "assignment requires aggregate");
        return undef();
    }
    let aggregate = agg(in machine, value);
    let inner = put_path(
        inout machine,
        kid(in machine, add(aggregate.kid_start, child_index)),
        inc(seg_index),
        new
    );
    if machine.failed {
        return undef();
    }
    let kid_start = machine.kids.len();
    for j in 0..aggregate.kid_count {
        let name = u32_at(in machine.kid_names, add(aggregate.kid_start, j));
        if j == child_index {
            push_kid(inout machine, name, inner);
        } else {
            push_kid(inout machine, name, kid(in machine, add(aggregate.kid_start, j)));
        }
    }
    make(inout machine, value.tag, aggregate.ctor, kid_start)
}

fn write_path(inout machine: M, cell: u64, new: Val) {
    let old = match machine.cells.try_get(cell) {
        Option::Some(value) => value,
        Option::None => undef(),
    };
    let updated = put_path(inout machine, old, 0, new);
    if !machine.failed {
        let ok = machine.cells.try_set(cell, updated);
    }
}

// The latest binding of `name` in the current activation, or NONE64.
fn binding(in machine: M, name: u32) -> u64 {
    let mut index = machine.env.len();
    loop {
        if index <= machine.frame.env_base {
            return NONE64;
        }
        index = wrapping_sub(index, 1);
        match machine.env.try_get(index) {
            Option::Some(env_entry) => {
                if env_entry.name == name {
                    return index;
                }
            },
            Option::None => {},
        }
    }
}

fn entry(in machine: M, index: u64) -> En {
    match machine.env.try_get(index) {
        Option::Some(found) => found,
        Option::None => En { name: 0, cell: 0, seg_start: 0, seg_count: 0 },
    }
}

// `machine.path` = the slot path of binding `env_entry`.
fn slot_path(inout machine: M, env_entry: En) {
    machine.path.clear();
    for i in 0..env_entry.seg_count {
        machine.path.push(u32_at(in machine.segs, add(env_entry.seg_start, i)));
    }
}

// Binds `name` to `value`. The Rust evaluator's environment is a map, so a
// rebinding (a loop body's pattern, each iteration) replaces the entry,
// reusing the entry's own cell: nothing else refers to it once no call is
// in flight. The environment stays as small as Rust's.
fn bind_new(inout machine: M, name: u32, value: Val) {
    let bound_index = binding(in machine, name);
    if bound_index != NONE64 {
        let env_entry = entry(in machine, bound_index);
        if env_entry.seg_count == 0 && env_entry.cell >= machine.frame.cell_base {
            let ok = machine.cells.try_set(env_entry.cell, value);
            return;
        }
        let cell = machine.cells.len();
        machine.cells.push(value);
        let ok = machine
            .env
            .try_set(bound_index, En { name: name, cell: cell, seg_start: 0, seg_count: 0 });
        return;
    }
    let cell = machine.cells.len();
    machine.cells.push(value);
    machine.env.push(En { name: name, cell: cell, seg_start: 0, seg_count: 0 });
}

// ----- patterns ----------------------------------------------------------------

// Whether literal words `at` (kind, lo, hi) match `value` (`bind_pattern`).
fn literal_matches(in machine: M, at: u64, value: Val) -> bool {
    let kind = machine.program.op(at);
    let lo = machine.program.op(inc(at));
    let hi = machine.program.op(add(at, 2));
    if kind == widen_u64(Lit::Int) {
        if value.tag > K_I32 {
            return false;
        }
        let value_hi = if is_signed(value.tag) && wrapping_i64(value.payload) < 0 {
            NONE64
        } else {
            0
        };
        return lo == value.payload && hi == value_hi;
    }
    if kind == widen_u64(Lit::Bool) {
        return value.tag == T_BOOL && value.payload == lo;
    }
    if kind == widen_u64(Lit::String) {
        return value.tag == T_STR && value.payload == lo;
    }
    false
}

fn pat_matches(inout machine: M, at: u64, value: Val) -> bool {
    let kind = machine.program.op(at);
    let body_at = add(at, 3);
    if kind == widen_u64(Pat::Wild) || kind == widen_u64(Pat::Bind) {
        return true;
    }
    if kind == widen_u64(Pat::Literal) {
        return literal_matches(in machine, body_at, value);
    }
    if kind == widen_u64(Pat::Tuple) {
        if value.tag != T_TUPLE {
            return false;
        }
        let aggregate = agg(in machine, value);
        let n = machine.program.op(body_at);
        if n != aggregate.kid_count {
            return false;
        }
        let mut sub_at = inc(body_at);
        for i in 0..n {
            if !pat_matches(inout machine, sub_at, kid(in machine, add(aggregate.kid_start, i))) {
                return false;
            }
            sub_at = pat_end(in machine, sub_at);
        }
        return true;
    }
    if kind == widen_u64(Pat::Constructor) {
        if value.tag != T_DATA {
            return false;
        }
        let aggregate = agg(in machine, value);
        if short_of(inout machine, n32(machine.program.op(body_at))) != aggregate.ctor {
            return false;
        }
        let n = machine.program.op(add(body_at, 2));
        let mut sub_at = add(body_at, 3);
        for i in 0..n {
            let field_sym = n32(machine.program.op(sub_at));
            let field_pos = field_index(in machine, aggregate, field_sym);
            if field_pos == NONE64 {
                return false;
            }
            if !pat_matches(
                inout machine,
                inc(sub_at),
                kid(in machine, add(aggregate.kid_start, field_pos))
            ) {
                return false;
            }
            sub_at = pat_end(in machine, inc(sub_at));
        }
        return true;
    }
    false
}

// Binds a pattern `pat_matches` accepted, each name in a new cell.
fn pat_bind(inout machine: M, at: u64, value: Val) {
    let kind = machine.program.op(at);
    let body_at = add(at, 3);
    if kind == widen_u64(Pat::Bind) {
        bind_new(inout machine, n32(machine.program.op(body_at)), value);
    } else if kind == widen_u64(Pat::Tuple) {
        let aggregate = agg(in machine, value);
        let n = machine.program.op(body_at);
        let mut sub_at = inc(body_at);
        for i in 0..n {
            pat_bind(inout machine, sub_at, kid(in machine, add(aggregate.kid_start, i)));
            sub_at = pat_end(in machine, sub_at);
        }
    } else if kind == widen_u64(Pat::Constructor) {
        let aggregate = agg(in machine, value);
        let n = machine.program.op(add(body_at, 2));
        let mut sub_at = add(body_at, 3);
        for i in 0..n {
            let field_pos = field_index(in machine, aggregate, n32(machine.program.op(sub_at)));
            pat_bind(
                inout machine,
                inc(sub_at),
                kid(in machine, add(aggregate.kid_start, field_pos))
            );
            sub_at = pat_end(in machine, inc(sub_at));
        }
    }
}

// ----- operators ---------------------------------------------------------------

fn int_val(kind: u8, value: i128) -> Val {
    Val { tag: kind, payload: wrap(kind, value) }
}

fn bool_val(value: bool) -> Val {
    Val { tag: T_BOOL, payload: if value { 1 } else { 0 } }
}

// `binary` (without floats and 128-bit integers); the failure code in `failure`.
fn binary(inout machine: M, code: u64, lhs: Val, rhs: Val, inout failure: u8) -> Val {
    let op = wrapping_u8(code);
    if lhs.tag <= K_I32 && rhs.tag <= K_I32 {
        let lhs_kind = lhs.tag;
        if op == B_SHL || op == B_SHR {
            let result = shift(
                lhs_kind,
                op,
                exact(lhs_kind, lhs.payload),
                exact(rhs.tag, rhs.payload),
                inout failure
            );
            return int_val(lhs_kind, result);
        }
        if op == B_ROTL || op == B_ROTR {
            return int_val(
                lhs_kind,
                rotate(
                    lhs_kind,
                    op == B_ROTL,
                    exact(lhs_kind, lhs.payload),
                    exact(rhs.tag, rhs.payload)
                )
            );
        }
        let kind = if lhs_kind != K_I64 { lhs_kind } else { rhs.tag };
        let lhs_int = exact(kind, wrap(kind, exact(lhs_kind, lhs.payload)));
        let rhs_int = exact(kind, wrap(kind, exact(rhs.tag, rhs.payload)));
        if op == B_ADD || op == B_SUB || op == B_MUL || op == B_DIV || op == B_REM {
            let result = checked(kind, op, lhs_int, rhs_int, inout failure);
            return int_val(kind, result);
        }
        if op == B_WADD || op == B_WSUB || op == B_WMUL {
            return int_val(kind, wrapping(kind, op, lhs_int, rhs_int));
        }
        if op == B_BAND || op == B_BOR || op == B_BXOR || op == B_BSHL || op == B_BSHR {
            return int_val(kind, bitwise(kind, op, lhs_int, rhs_int));
        }
        if op == B_AND || op == B_OR || op == B_XOR {
            return int_val(kind, bit(kind, op, lhs_int, rhs_int));
        }
        if op == B_EQ {
            return bool_val(lhs_int == rhs_int);
        } else if op == B_NE {
            return bool_val(lhs_int != rhs_int);
        } else if op == B_LT {
            return bool_val(lhs_int < rhs_int);
        } else if op == B_LE {
            return bool_val(lhs_int <= rhs_int);
        } else if op == B_GT {
            return bool_val(lhs_int > rhs_int);
        } else if op == B_GE {
            return bool_val(lhs_int >= rhs_int);
        }
        fail(inout machine, "invalid integer operator");
        return undef();
    }
    if lhs.tag == T_BOOL && rhs.tag == T_BOOL {
        if op == B_LAND {
            return bool_val(lhs.payload != 0 && rhs.payload != 0);
        } else if op == B_LOR {
            return bool_val(lhs.payload != 0 || rhs.payload != 0);
        } else if op == B_EQ {
            return bool_val(lhs.payload == rhs.payload);
        } else if op == B_NE {
            return bool_val(lhs.payload != rhs.payload);
        }
        fail(inout machine, "invalid boolean operator");
        return undef();
    }
    if lhs.tag == T_STR && rhs.tag == T_STR {
        let lhs_sym = n32(lhs.payload);
        let rhs_sym = n32(rhs.payload);
        if op == B_EQ {
            return bool_val(lhs_sym == rhs_sym);
        } else if op == B_NE {
            return bool_val(lhs_sym != rhs_sym);
        } else if op == B_LT {
            return bool_val(sym_less(in machine, lhs_sym, rhs_sym));
        } else if op == B_LE {
            return bool_val(!sym_less(in machine, rhs_sym, lhs_sym));
        } else if op == B_GT {
            return bool_val(sym_less(in machine, rhs_sym, lhs_sym));
        } else if op == B_GE {
            return bool_val(!sym_less(in machine, lhs_sym, rhs_sym));
        }
        fail(inout machine, "invalid string operator");
        return undef();
    }
    if op == B_EQ {
        return bool_val(equal(in machine, lhs, rhs));
    } else if op == B_NE {
        return bool_val(!equal(in machine, lhs, rhs));
    }
    fail(inout machine, "incompatible binary operands");
    undef()
}

// `unary` (without floats and 128-bit integers).
fn unary(inout machine: M, code: u64, value: Val, inout failure: u8) -> Val {
    if code == U_NOT && value.tag == T_BOOL {
        return bool_val(value.payload == 0);
    }
    if code >= U_CONV {
        let family = wrapping_sub(code, U_CONV) / 16;
        let target_kind = wrapping_u8(wrapping_sub(code, U_CONV) % 16);
        if value.tag > K_I32 {
            fail(inout machine, "invalid conversion operand");
            return undef();
        }
        let exact_value = exact(value.tag, value.payload);
        if family == C_WRAPPING {
            return int_val(target_kind, exact_value);
        }
        if !fits(target_kind, exact_value) {
            failure = F_OVERFLOW;
            return undef();
        }
        return int_val(target_kind, exact_value);
    }
    if value.tag > K_I32 {
        fail(inout machine, "invalid unary operands");
        return undef();
    }
    let exact_value = exact(value.tag, value.payload);
    if code == U_NOT || code == U_INV {
        return int_val(value.tag, not(value.tag, exact_value));
    }
    let negated = wrapping_sub(0, exact_value);
    if !fits(value.tag, negated) {
        failure = F_OVERFLOW;
        return undef();
    }
    int_val(value.tag, negated)
}

// ----- the machine -------------------------------------------------------------

fn val(in machine: M, id: u64) -> Val {
    match machine.vals.try_get(add(machine.frame.val_base, id)) {
        Option::Some(value) => value,
        Option::None => undef(),
    }
}

fn set_val(inout machine: M, id: u64, value: Val) {
    let ok = machine.vals.try_set(add(machine.frame.val_base, id), value);
}

fn undefined(inout machine: M, id: u64) {
    if !machine.failed {
        machine.failed = true;
        machine.message.clear();
        put(inout machine.message, "undefined IR value %");
        push_decimal(inout machine.message, id);
    }
}

// The operand value `id`, or an `undefined IR value` failure.
fn get(inout machine: M, id: u64) -> Val {
    let value = val(in machine, id);
    if value.tag == T_UNDEF {
        undefined(inout machine, id);
    }
    value
}

fn func(in machine: M, func_index: u64) -> Fi {
    match machine.fns.try_get(func_index) {
        Option::Some(found) => found,
        Option::None => Fi {
            name: 0,
            param_start: 0,
            param_count: 0,
            value_count: 0,
            first_block: 0,
            reached: false
        },
    }
}

fn param(in machine: M, index: u64) -> Pm {
    match machine.params.try_get(index) {
        Option::Some(found) => found,
        Option::None => Pm { name: 0, pass: 0 },
    }
}

// Ends the current activation with `value` (`Control::Return`).
fn leave(inout machine: M, value: Val) {
    let frame = machine.frame;
    machine.vals.truncate(frame.val_base);
    machine.env.truncate(frame.env_base);
    machine.cells.truncate(frame.cell_base);
    machine.segs.truncate(frame.seg_base);
    machine.ret_value = value;
    machine.control = C_RET;
}

// Suspends the current activation for a call or `?` (`Frame::IrResume`).
fn suspend(inout machine: M, dest: u32, ty: u32) {
    let mut frame = machine.frame;
    frame.dest = dest;
    frame.ty = ty;
    frame.kind = FR_IR;
    machine.stack.push(frame);
}

// Collects call arguments at operand `args_at` (`n`, then pass, value, root + 1,
// path each) into `arg_vals` (values) and `arg_roots`/`arg_paths` (place
// root + 1 and path, or 0).
fn collect_args(inout machine: M, args_at: u64) -> u64 {
    let n = machine.program.op(args_at);
    machine.arg_vals.clear();
    machine.arg_roots.clear();
    machine.arg_paths.clear();
    for i in 0..n {
        let arg_at = add(inc(args_at), wrapping_mul(i, ARG_WORDS));
        let value = get(inout machine, machine.program.op(inc(arg_at)));
        machine.arg_vals.push(value);
        machine.arg_roots.push(machine.program.op(add(arg_at, 2)));
        machine.arg_paths.push(machine.program.op(add(arg_at, 3)));
    }
    n
}

// `invoke_scoped` of function `func_index` on the collected arguments, after the
// caller was suspended: the callee's activation becomes current.
fn invoke(inout machine: M, func_index: u64) {
    let fn_info = func(in machine, func_index);
    if machine.arg_vals.len() != fn_info.param_count {
        fail(inout machine, "argument arity mismatch");
        return;
    }
    let val_base = machine.vals.len();
    let env_base = machine.env.len();
    let cell_base = machine.cells.len();
    let seg_base = machine.segs.len();
    // The `inout` places resolve in the caller's environment.
    let mut slots: ChunkSeq[En] = ChunkSeq::new[En]();
    for i in 0..fn_info.param_count {
        let param_row = param(in machine, add(fn_info.param_start, i));
        if param_row.pass == PASS_INOUT {
            let root = u64_at(in machine.arg_roots, i);
            let mut found = false;
            if root != 0 {
                let bound_index = binding(in machine, n32(wrapping_sub(root, 1)));
                if bound_index != NONE64 {
                    let env_entry = entry(in machine, bound_index);
                    let seg_start = machine.segs.len();
                    for j in 0..env_entry.seg_count {
                        machine.segs.push(u32_at(in machine.segs, add(env_entry.seg_start, j)));
                    }
                    let path = u64_at(in machine.arg_paths, i);
                    let path_row = machine.program.path(path);
                    for j in 0..path_row.n {
                        machine.segs.push(machine.program.path_name(path, j));
                    }
                    slots.push(En {
                        name: param_row.name,
                        cell: env_entry.cell,
                        seg_start: seg_start,
                        seg_count: wrapping_sub(machine.segs.len(), seg_start)
                    });
                    found = true;
                }
            }
            if !found {
                fail(inout machine, "inout argument requires place");
                return;
            }
        } else {
            let cell = machine.cells.len();
            machine.cells.push(match machine.arg_vals.try_get(i) {
                Option::Some(value) => value,
                Option::None => undef(),
            });
            slots.push(En { name: param_row.name, cell: cell, seg_start: 0, seg_count: 0 });
        }
    }
    for i in 0..slots.len() {
        match slots.try_get(i) {
            Option::Some(env_entry) => machine.env.push(env_entry),
            Option::None => {},
        }
    }
    machine.vals.resize(add(val_base, fn_info.value_count), undef());
    machine
        .frame = Fr {
            func_index: func_index,
            block: fn_info.first_block,
            ip: 0,
            val_base: val_base,
            env_base: env_base,
            cell_base: cell_base,
            seg_base: seg_base,
            dest: 0,
            ty: 0,
            kind: FR_IR
        };
}

// Calls value `callee` (`Op::Indirect`).
fn call_value(inout machine: M, callee: Val) {
    if callee.tag == T_CONT {
        decline(inout machine, "a resumed continuation", NONE32);
        return;
    }
    if callee.tag == T_FN {
        let func_index = fn_index(in machine, n32(callee.payload));
        if func_index == NONE64 {
            fail_sym(inout machine, "unknown function '", n32(callee.payload), "'");
            return;
        }
        invoke(inout machine, func_index);
        return;
    }
    fail(inout machine, "value is not callable");
}

// One `ir_step` of the current activation.
fn step(inout machine: M) {
    let block = machine.program.block(machine.frame.block);
    if machine.frame.ip >= block.ic {
        terminate(inout machine, block);
        return;
    }
    let inst_id = add(block.i0, machine.frame.ip);
    let inst = machine.program.inst(inst_id);
    machine.frame.ip = inc(machine.frame.ip);
    let operand_at = inst.a;
    let op = inst.op;
    let mut failure: u8 = F_OK;
    let mut result = unit();
    if op == Op::Loop || op == Op::Unit {
        result = unit();
    } else if op == Op::Exit {
        let value = get(inout machine, machine.program.op(operand_at));
        if machine.failed {
            return;
        }
        leave(inout machine, value);
        return;
    } else if op == Op::Const {
        let kind = machine.program.op(operand_at);
        let lo = machine.program.op(inc(operand_at));
        if kind == widen_u64(Lit::Int) {
            let hi = machine.program.op(add(operand_at, 2));
            result = if hi == 0 && (lo >> 63) == 1 {
                Val { tag: K_U64, payload: lo }
            } else {
                Val { tag: K_I64, payload: lo }
            };
        } else if kind == widen_u64(Lit::Bool) {
            result = bool_val(lo != 0);
        } else {
            result = Val { tag: T_STR, payload: lo };
        }
    } else if op == Op::Read {
        let root = n32(machine.program.op(operand_at));
        let path = machine.program.op(inc(operand_at));
        let bound_index = binding(in machine, root);
        if path == 0 && bound_index == NONE64 && fn_index(in machine, root) != NONE64 {
            result = Val { tag: T_FN, payload: w(root) };
        } else {
            if bound_index == NONE64 {
                fail_sym(inout machine, "undefined IR place '", root, "'");
                return;
            }
            let env_entry = entry(in machine, bound_index);
            slot_path(inout machine, env_entry);
            let path_row = machine.program.path(path);
            for j in 0..path_row.n {
                machine.path.push(machine.program.path_name(path, j));
            }
            result = read_path(inout machine, env_entry.cell);
        }
    } else if op == Op::Bind {
        let value = get(inout machine, machine.program.op(operand_at));
        if machine.failed {
            return;
        }
        if !pat_matches(inout machine, inc(operand_at), value) {
            fail(inout machine, "IR binding pattern mismatch");
            return;
        }
        pat_bind(inout machine, inc(operand_at), value);
        result = unit();
    } else if op == Op::Write {
        let value = get(inout machine, machine.program.op(add(operand_at, 2)));
        if machine.failed {
            return;
        }
        let write_row = match machine.writes.try_get(u64_at(in machine.aux, inst_id)) {
            Option::Some(found) => found,
            Option::None => Wr { root: 0, seg_start: 0, seg_count: 0, code: 0 },
        };
        let bound_index = binding(in machine, write_row.root);
        if bound_index == NONE64 {
            fail(inout machine, "undefined IR assignment place");
            return;
        }
        let env_entry = entry(in machine, bound_index);
        slot_path(inout machine, env_entry);
        for j in 0..write_row.seg_count {
            machine.path.push(u32_at(in machine.write_segs, add(write_row.seg_start, j)));
        }
        let mut new = value;
        if write_row.code != 0 {
            let old = read_path(inout machine, env_entry.cell);
            if machine.failed {
                return;
            }
            new = binary(inout machine, write_row.code, old, value, inout failure);
            if failure != F_OK {
                suspend(inout machine, inst.dest, inst.ty);
                raise(inout machine, failure);
                return;
            }
            if machine.failed {
                return;
            }
        }
        write_path(inout machine, env_entry.cell, new);
        result = unit();
    } else if op == Op::Unary {
        let value = get(inout machine, machine.program.op(inc(operand_at)));
        if machine.failed {
            return;
        }
        result = unary(inout machine, u64_at(in machine.aux, inst_id), value, inout failure);
    } else if op == Op::Binary {
        let lhs = get(inout machine, machine.program.op(inc(operand_at)));
        let rhs = get(inout machine, machine.program.op(add(operand_at, 2)));
        if machine.failed {
            return;
        }
        result = binary(inout machine, u64_at(in machine.aux, inst_id), lhs, rhs, inout failure);
    } else if op == Op::Tuple {
        let n = machine.program.op(operand_at);
        let kid_start = machine.kids.len();
        for i in 0..n {
            let value = get(inout machine, machine.program.op(add(inc(operand_at), i)));
            push_kid(inout machine, 0, value);
        }
        if machine.failed {
            return;
        }
        result = make(inout machine, T_TUPLE, 0, kid_start);
    } else if op == Op::Data {
        let ctor_code = u64_at(in machine.aux, inst_id);
        if ctor_code == 0 {
            fail(inout machine, "unknown IR constructor");
            return;
        }
        let n = machine.program.op(inc(operand_at));
        let kid_start = machine.kids.len();
        for i in 0..n {
            let field_at = add(add(operand_at, 2), wrapping_mul(i, 2));
            let value = get(inout machine, machine.program.op(inc(field_at)));
            push_kid(inout machine, n32(machine.program.op(field_at)), value);
        }
        if machine.failed {
            return;
        }
        result = make(inout machine, T_DATA, n32(wrapping_sub(ctor_code, 1)), kid_start);
    } else if op == Op::Project {
        let value = get(inout machine, machine.program.op(operand_at));
        if machine.failed {
            return;
        }
        let field_sym = n32(machine.program.op(inc(operand_at)));
        let aggregate = agg(in machine, value);
        if value.tag == T_DATA {
            let j = field_index(in machine, aggregate, field_sym);
            if j == NONE64 {
                fail(inout machine, "unknown IR field");
                return;
            }
            result = kid(in machine, add(aggregate.kid_start, j));
        } else if value.tag == T_TUPLE {
            let j = index_of(in machine, field_sym);
            if j == NONE64 {
                fail(inout machine, "invalid IR tuple field");
                return;
            }
            if j >= aggregate.kid_count {
                fail(inout machine, "IR tuple field out of bounds");
                return;
            }
            result = kid(in machine, add(aggregate.kid_start, j));
        } else {
            fail(inout machine, "IR projection requires data");
            return;
        }
    } else if op == Op::Index {
        let index_value = get(inout machine, machine.program.op(inc(operand_at)));
        if machine.failed {
            return;
        }
        if index_value.tag > K_I32 {
            fail(inout machine, "IR index must be integer");
            return;
        }
        let neg = is_signed(index_value.tag) && wrapping_i64(index_value.payload) < 0;
        let base = get(inout machine, machine.program.op(operand_at));
        if machine.failed {
            return;
        }
        if base.tag != T_TUPLE {
            fail(inout machine, "IR index requires tuple");
            return;
        }
        let aggregate = agg(in machine, base);
        if neg || index_value.payload >= aggregate.kid_count {
            suspend(inout machine, inst.dest, inst.ty);
            raise(inout machine, P_INDEX);
            return;
        }
        result = kid(in machine, add(aggregate.kid_start, index_value.payload));
    } else if op == Op::Call {
        let n = collect_args(inout machine, inc(operand_at));
        if machine.failed {
            return;
        }
        suspend(inout machine, inst.dest, inst.ty);
        let callee_index = u64_at(in machine.aux, inst_id);
        if callee_index == NONE64 {
            // An effect operation (`Value::EffectOp`).
            let at = site(in machine, inst_id, SITE_EFFECT_CALL);
            perform(
                inout machine,
                n32(site_word(in machine, add(at, EC_EFFECT))),
                n32(site_word(in machine, add(at, EC_OP))),
                site_word(in machine, add(at, EC_KEY))
            );
            return;
        }
        invoke(inout machine, callee_index);
        return;
    } else if op == Op::Handle {
        suspend(inout machine, inst.dest, inst.ty);
        machine.pending = inst_id;
        machine.control = C_INSTALL;
        return;
    } else if op == Op::Indirect {
        let callee = get(inout machine, machine.program.op(operand_at));
        let n = collect_args(inout machine, inc(operand_at));
        if machine.failed {
            return;
        }
        suspend(inout machine, inst.dest, inst.ty);
        call_value(inout machine, callee);
        return;
    } else if op == Op::Try {
        let value = get(inout machine, machine.program.op(operand_at));
        if machine.failed {
            return;
        }
        suspend(inout machine, inst.dest, inst.ty);
        let mut try_frame = machine.frame;
        try_frame.kind = FR_TRY;
        // The `Fail` instance key the `?` raises through.
        let try_site = site(in machine, inst_id, SITE_TRY);
        try_frame.dest = if try_site == NONE64 {
            0
        } else {
            n32(site_word(in machine, add(try_site, TRY_KEY)))
        };
        machine.stack.push(try_frame);
        machine.ret_value = value;
        machine.control = C_RET;
        return;
    } else {
        fail(inout machine, "the run machine does not know this operation");
        return;
    }
    if machine.failed {
        return;
    }
    if failure != F_OK {
        // `primitive_failure`: the raise is unhandled.
        suspend(inout machine, inst.dest, inst.ty);
        raise(inout machine, failure);
        return;
    }
    let coerced = coerce(inout machine, result, inst.ty);
    set_val(inout machine, w(inst.dest), coerced);
}

// A block's terminator.
fn terminate(inout machine: M, block: BlockRow) {
    let term_at = block.ta;
    let fn_info = func(in machine, machine.frame.func_index);
    if block.term == Term::Return {
        let id = machine.program.op(term_at);
        let value = val(in machine, id);
        if value.tag == T_UNDEF {
            fail(inout machine, "missing IR return value");
            return;
        }
        leave(inout machine, value);
        return;
    }
    if block.term == Term::Jump {
        let target = add(fn_info.first_block, machine.program.op(term_at));
        let n = machine.program.op(inc(term_at));
        let prev_arg_count = machine.arg_vals.len();
        machine.arg_vals.clear();
        for i in 0..n {
            let value = val(in machine, machine.program.op(add(add(term_at, 2), i)));
            if value.tag == T_UNDEF {
                fail(inout machine, "missing IR edge argument");
                return;
            }
            machine.arg_vals.push(value);
        }
        let params_at = u64_at(in machine.block_params, target);
        let param_count = machine.program.op(params_at);
        for i in 0..param_count {
            if i < n {
                let id = machine.program.op(add(inc(params_at), i));
                match machine.arg_vals.try_get(i) {
                    Option::Some(value) => set_val(inout machine, id, value),
                    Option::None => {},
                }
            }
        }
        let _ = prev_arg_count;
        machine.frame.block = target;
        machine.frame.ip = 0;
        return;
    }
    if block.term == Term::Branch {
        let value = val(in machine, machine.program.op(term_at));
        if value.tag == T_UNDEF {
            fail(inout machine, "missing IR condition");
            return;
        }
        if value.tag != T_BOOL {
            fail(inout machine, "IR branch condition must be bool");
            return;
        }
        let target = if value.payload != 0 {
            machine.program.op(inc(term_at))
        } else {
            machine.program.op(add(term_at, 2))
        };
        machine.frame.block = add(fn_info.first_block, target);
        machine.frame.ip = 0;
        return;
    }
    if block.term == Term::Match {
        let value = val(in machine, machine.program.op(term_at));
        if value.tag == T_UNDEF {
            fail(inout machine, "missing IR match value");
            return;
        }
        let n = machine.program.op(inc(term_at));
        let mut pat_at = add(term_at, 2);
        for i in 0..n {
            let target_at = pat_end(in machine, pat_at);
            if pat_matches(inout machine, pat_at, value) {
                machine.frame.block = add(fn_info.first_block, machine.program.op(target_at));
                machine.frame.ip = 0;
                return;
            }
            pat_at = inc(target_at);
        }
        fail(inout machine, "non-exhaustive IR match");
        return;
    }
    fail(inout machine, "reached an unreachable IR block");
}

// A returned value meets the top frame (`Control::Return` in `drive`);
// false when the run is complete.
fn resume(inout machine: M) -> bool {
    let frame = match machine.stack.pop() {
        Option::Some(popped) => popped,
        Option::None => {
            return false;
        },
    };
    if frame.kind == FR_TRY {
        let value = machine.ret_value;
        if value.tag == T_DATA {
            let aggregate = agg(in machine, value);
            if aggregate.ctor == machine.ok_sym || aggregate.ctor == machine.err_sym {
                let payload_index = field_index(in machine, aggregate, machine.zero_sym);
                if payload_index == NONE64 {
                    if aggregate.ctor == machine.ok_sym {
                        fail(inout machine, "missing Ok payload");
                    } else {
                        fail(inout machine, "missing Err payload");
                    }
                    return true;
                }
                if aggregate.ctor == machine.ok_sym {
                    machine.ret_value = kid(in machine, add(aggregate.kid_start, payload_index));
                    return true;
                }
                let payload = kid(in machine, add(aggregate.kid_start, payload_index));
                machine.arg_vals.clear();
                machine.arg_vals.push(payload);
                perform(inout machine, machine.fail_sym, machine.raise_sym, w(frame.dest));
                return true;
            }
        }
        fail(inout machine, "'?' requires Result");
        return true;
    }
    if frame.kind == FR_COERCE {
        let value = machine.ret_value;
        machine.ret_value = coerce(inout machine, value, frame.ty);
        return true;
    }
    if frame.kind == FR_HANDLER {
        let value = machine.ret_value;
        handler_return(inout machine, frame, value);
        return true;
    }
    machine.frame = frame;
    let ret_value = machine.ret_value;
    let coerced = coerce(inout machine, ret_value, frame.ty);
    set_val(inout machine, w(frame.dest), coerced);
    machine.control = C_IR;
    true
}

// `Runtime::run` of the entry with no arguments: the value's text in
// `message`, or the error in `message` with `failed`.
pub fn drive(inout machine: M) {
    machine.arg_vals.clear();
    machine.arg_roots.clear();
    machine.arg_paths.clear();
    machine.frame = fr_zero();
    invoke(inout machine, machine.entry);
    machine.control = C_IR;
    loop {
        if machine.failed || machine.declined {
            return;
        }
        if machine.fuel == 0 {
            fail(inout machine, "execution fuel exhausted");
            return;
        }
        machine.fuel = wrapping_sub(machine.fuel, 1);
        if machine.control == C_IR {
            step(inout machine);
        } else if machine.control == C_INSTALL {
            install(inout machine);
        } else if !resume(inout machine) {
            break;
        }
    }
    machine.message.clear();
    let value = machine.ret_value;
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    display(in machine, value, inout out, 0);
    machine.message = out;
}

// Whether the call arguments at operand `args_at` (`n`, then pass, value,
// root + 1, path each) pass a place `inout`.
fn has_inout_arg(in machine: M, args_at: u64) -> bool {
    for i in 0..machine.program.op(args_at) {
        if machine.program.op(add(inc(args_at), wrapping_mul(i, ARG_WORDS))) == PASS_INOUT {
            return true;
        }
    }
    false
}
