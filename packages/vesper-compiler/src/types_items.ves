// @vesper-lang/compiler, part 3 of 5: types, generics and items.
// Types.
fn ty(p: P) -> P eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    leave(close(ty_inner(open(enter(p), 204))), p)
}

fn ty_inner(p: P) -> P eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    let k = kind(p);
    if k == 12 {
        let q = bump(p);
        let q = if at(q, 44) {
            mode(bump(q))
        } else {
            q
        };
        let q = expect(ty_params(expect(q, 32)), 33);
        let q = if at(q, 46) {
            ty(bump(q))
        } else {
            q
        };
        effects(q)
    } else if k == 32 {
        expect(ty_list(bump(p)), 33)
    } else if k == 36 {
        // A tensor shape `[M, N * K, 128]` (§28.2).
        expect(dimensions(bump(p)), 37)
    } else if k == 61 {
        let q = ty(bump(p));
        let q = expect_word(q, 0x6173);
        let q = type_args(upper(q));
        upper(expect(expect(q, 63), 41))
    } else {
        let q = ident(p);
        if at(q, 41) && nth(q, 1).kind == 3 {
            upper(bump(q))
        } else {
            type_args(q)
        }
    }
}

fn dimensions(p: P) -> P eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    if at_end(p, 37) {
        p
    } else {
        let q = dimension(dimension_factor(p));
        let r = eat(q, 38);
        if ate(q, r) {
            dimensions(r)
        } else {
            r
        }
    }
}

// A product of decimal literals and dimension names (`QHeads * HeadDim`).
fn dimension(p: P) -> P eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    let q = eat(p, 56);
    if ate(p, q) {
        dimension(dimension_factor(q))
    } else {
        p
    }
}

fn dimension_factor(p: P) -> P eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    if at(p, 6) {
        close(bump(open(p, 204)))
    } else {
        ty(p)
    }
}

fn ty_params(p: P) -> P eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    if at_end(p, 33) {
        p
    } else {
        let q = ty(pass(p));
        let r = eat(q, 38);
        if ate(q, r) {
            ty_params(r)
        } else {
            r
        }
    }
}

fn ty_list(p: P) -> P eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    if at_end(p, 33) {
        p
    } else {
        let q = ty(p);
        let r = eat(q, 38);
        if ate(q, r) {
            ty_list(r)
        } else {
            r
        }
    }
}

fn type_args(p: P) -> P eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    let d = enter(p);
    let q = eat(d, 36);
    if ate(d, q) {
        leave(expect(type_arg_list(q), 37), p)
    } else {
        p
    }
}

fn type_arg_list(p: P) -> P eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    if at_end(p, 37) {
        p
    } else {
        let q = type_arg(p);
        let r = eat(q, 38);
        if ate(q, r) {
            type_arg_list(r)
        } else {
            r
        }
    }
}

fn type_arg(p: P) -> P eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    let t = nth(p, 0);
    if t.kind == 4 && !primitive(t) {
        let q = bump(p);
        let r = eat(q, 40);
        if ate(q, r) {
            let s = type_args(upper(r));
            let u = eat(s, 68);
            if ate(s, u) {
                lower(u)
            } else {
                u
            }
        } else {
            r
        }
    } else if t.kind == 6 {
        // A decimal lane count, as in `Vec[u8, 16]` (§14.3): one TYPE node.
        close(bump(open(p, 204)))
    } else {
        let named = t.kind == 3 || t.kind == 4 || t.kind == 22;
        let q = ty(p);
        let r = eat(q, 68);
        if ate(q, r) {
            if named {
                lower(r)
            } else {
                syntax_issue(lower(r), 27)
            }
        } else {
            r
        }
    }
}

fn effects(p: P) -> P eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    let q = eat(p, 18);
    if ate(p, q) {
        expect(effect_list(expect(q, 36)), 37)
    } else {
        p
    }
}

fn effect_list(p: P) -> P eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    if at_end(p, 37) {
        p
    } else {
        let q = eat(p, 68);
        if ate(p, q) {
            lower(q)
        } else if at(p, 4) && nth(p, 1).kind != 40 {
            lower(p)
        } else {
            let q = if at(p, 4) {
                expect(lower(p), 40)
            } else {
                p
            };
            let r = type_args(upper(q));
            let s = eat(r, 38);
            if ate(r, s) || at(r, 68) {
                effect_list(s)
            } else {
                s
            }
        }
    }
}

// Generics, bounds and fields.
fn generics(p: P, track: bool) -> P eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    syntax_put(7, 0);
    let q = eat(p, 36);
    if ate(p, q) {
        expect(generic_list(q, track), 37)
    } else {
        p
    }
}

fn generic_list(p: P, track: bool) -> P eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    if at_end(p, 37) {
        p
    } else {
        let row = at(p, 4);
        let q = ident(
            if row && track {
                syntax_bind(p, true)
            } else {
                p
            }
        );
        let q = if row && track {
            with_flags(q, q.nostruct, true, q.bounds)
        } else {
            q
        };
        let c = eat(q, 40);
        let r = if ate(q, c) {
            if row {
                expect(c, 18)
            } else if at_word(c, 0, 0x64696d) {
                // `N: dim` (§28.2), a tensor dimension parameter.
                bump(c)
            } else if at(c, 3) {
                let b = trait_ref(c);
                let count = syntax_cell(7);
                if count >= 128 {
                    let ignored = fail_i(Diag::Limit(c.cur.start));
                } else {
                    ()
                };
                syntax_put(997000 + count * 2, c.cur.start);
                syntax_put(997001 + count * 2, b.pos);
                syntax_put(7, count + 1);
                with_flags(b, b.nostruct, b.rows, true)
            } else {
                required_mode(expect(c, 17))
            }
        } else if row {
            syntax_issue(q, 26)
        } else {
            q
        };
        let s = eat(r, 38);
        if ate(r, s) {
            generic_list(s, track)
        } else {
            s
        }
    }
}

fn trait_ref(p: P) -> P eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    let q = if at(p, 44) {
        expect(package_path(bump(p)), 41)
    } else {
        p
    };
    type_args(upper(q))
}

fn package_path(p: P) -> P eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    let k = kind(p);
    if (k == 4 || k == 55 || k == 57 || k == 6) && nth(p, 0).start == p.pos {
        package_path(bump(p))
    } else {
        p
    }
}

fn expect_word(p: P, packed: i64) -> P eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    if at_word(p, 0, packed) {
        bump(p)
    } else {
        syntax_issue(
            p,
            if packed == 0x6173 {
                15
            } else {
                16
            }
        )
    }
}

fn fields(p: P) -> P eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    expect(field_list(expect(p, 34)), 35)
}

fn field_list(p: P) -> P eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    if at_end(p, 35) {
        p
    } else {
        let q = ty(expect(lower(p), 40));
        let m = eat(q, 45);
        let r = if ate(q, m) {
            field_mode(m)
        } else {
            q
        };
        let s = eat(r, 38);
        if ate(r, s) {
            field_list(s)
        } else {
            s
        }
    }
}
