// @vesper-lang/compiler, part 5 of 5: the module parser and entry points.
// Module: MODULE { ITEM* } spanning the whole source, trailing trivia
// included.
fn items(p: P) -> P eff [Fail[Diag], Fail[ArithOverflow]] {
    if at(p, 70) {
        p
    } else {
        items(close(item(open(p, 201))))
    }
}

fn parse_digest() -> i64 eff [Fail[Diag], Fail[ArithOverflow]] {
    // The seed rejects over-budget token streams before parsing; the lexer
    // phase enforces the same budget and its lexical errors come first.
    let lexed = lex_digest();
    let p = items(
        open(
            P {
                pos: 0,
                cur: next_sig(0),
                h: offset_basis(),
                nostruct: false,
                rows: false,
                bounds: false,
                depth: 0
            },
            200
        )
    );
    // The module node ends after the trailing trivia.
    digest(mix(mix(p.h, 3000), source_len()))
}

// Results: a non-negative digest, or -1 - (code * 2^32 + byte offset).
fn encode(code: i64, at: i64) -> i64 eff [Fail[ArithOverflow]] {
    -1 - (code * 4294967296 + at)
}

fn diag_code(d: Diag) -> i64 eff [Fail[ArithOverflow]] {
    match d {
        Diag::Lex(at) => encode(1, at),
        Diag::Expected(k, at) => encode(2, at),
        Diag::Unsupported(what, at) => encode(16 + what, at),
        Diag::Invalid(at) => encode(4, at),
        Diag::Limit(at) => encode(5, at),
    }
}

// Entry points. Each phase runs inside its own lexical region (§42.3
// Region::scoped); the phases allocate nothing, so the bound only caps the
// region itself.
fn lex_main() -> i64 {
    handle Fail[ArithOverflow] in {
        handle Fail[Diag] in {
            region lexer_arena(4096) {
                lex_digest()
            }
        } with {
            return value => value,
            raise(d, resume) => diag_code(d),
        }
    } with {
        return value => value,
        raise(overflow, resume) => -1 - 3 * 4294967296,
    }
}

fn parse_main() -> i64 {
    handle Fail[ArithOverflow] in {
        handle Fail[Diag] in {
            region parser_arena(4096) {
                parse_digest()
            }
        } with {
            return value => value,
            raise(d, resume) => diag_code(d),
        }
    } with {
        return value => value,
        raise(overflow, resume) => -1 - 3 * 4294967296,
    }
}
