// @vesper-lang/compiler, part 5 of 5: the module parser and entry points.
// Module: MODULE { ITEM* } spanning the whole source, trailing trivia
// included.
fn items(p: P) -> P eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    if at(p, 70) {
        p
    } else {
        let q = close(item(open(p, 201)));
        if q.pos == p.pos {
            items(bump(syntax_issue(q, 6)))
        } else {
            items(q)
        }
    }
}

fn parse_digest() -> i64 eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    // The seed rejects over-budget token streams before parsing; the lexer
    // phase enforces the same budget and its lexical errors come first.
    syntax_put(0, 0);
    syntax_put(1, 0);
    syntax_put(2, 0);
    syntax_put(3, 0);
    syntax_put(4, 0);
    syntax_put(6, 0);
    syntax_put(7, 0);
    let lexed = syntax_lex();
    let p = items(
        open(
            P {
                pos: 0,
                cur: syntax_tok(syntax_sig(0)),
                h: offset_basis(),
                nostruct: false,
                rows: false,
                bounds: false,
                depth: 0,
                index: syntax_sig(0),
                token_pos: 0,
                row_head: 0,
                value_head: 0
            },
            200
        )
    );
    // The module node ends after the trailing trivia.
    syntax_attach(p.token_pos, syntax_cell(0) - 1);
    syntax_close(source_len());
    if syntax_cell(2) > 0 {
        encode(syntax_cell(6), syntax_cell(1000002))
    } else {
        digest(mix(mix(p.h, 3000), source_len()))
    }
}

// Results: a non-negative digest, or -1 - (code * 2^32 + byte offset).
fn encode(code: i64, at: i64) -> i64 eff [Fail[ArithOverflow]] {
    -1 - (code * 4294967296 + at)
}

fn diag_code(d: Diag) -> i64 eff [Fail[ArithOverflow]] {
    match d {
        Diag::Lex(at) => encode(1, at),
        Diag::Expected(k, at) => encode(2, at),
        Diag::Unsupported(what, at) => encode(16 + what, at),
        Diag::Invalid(at) => encode(4, at),
        Diag::Limit(at) => encode(5, at),
    }
}

// Entry points. lex_main preserves the seed token-digest adapter;
// parse_main closes SyntaxMemory with Vesper region storage. Embedders may
// supply their own bounded byte buffer through parse_transport.
fn lex_main() -> i64 {
    handle Fail[ArithOverflow] in {
        handle Fail[Diag] in {
            region lexer_arena(4096) {
                lex_digest()
            }
        } with {
            return value => value,
            raise(d, resume) => diag_code(d),
        }
    } with {
        return value => value,
        raise(overflow, resume) => -1 - 3 * 4294967296,
    }
}

fn parse_main() -> i64 {
    handle Fail[ArithOverflow] in {
        handle Fail[Diag] in {
            syntax_run(parse_digest)
        } with {
            return value => value,
            raise(d, resume) => diag_code(d),
        }
    } with {
        return value => value,
        raise(overflow, resume) => -1 - 3 * 4294967296,
    }
}

fn parse_transport() -> i64 eff [SyntaxMemory] {
    handle Fail[ArithOverflow] in {
        handle Fail[Diag] in {
            parse_digest()
        } with {
            return value => value,
            raise(error, resume) => diag_code(error),
        }
    } with {
        return value => value,
        raise(error, resume) => -1 - 3 * 4294967296,
    }
}
