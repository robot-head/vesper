fn parse_items(p: ParseCursor) -> ParseCursor eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    if parse_at(p, 70) {
        p
    } else {
        let q = parse_close(parse_item(parse_open(p, 201)));
        if q.pos == p.pos {
            parse_items(parse_bump(syntax_issue(q, 6)))
        } else {
            parse_items(q)
        }
    }
}

fn parse_build() -> i64 eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    // The seed rejects over-budget token streams before parsing; the lexer
    // phase enforces the same budget and its lexical errors come first.
    syntax_put(0, 0);
    syntax_put(1, 0);
    syntax_put(2, 0);
    syntax_put(3, 0);
    syntax_put(4, 0);
    syntax_put(6, 0);
    syntax_put(7, 0);
    let lexed = syntax_lex();
    let p = parse_items(
        parse_open(
            ParseCursor {
                pos: 0,
                cur: syntax_tok(syntax_sig(0)),
                h: offset_basis(),
                nostruct: false,
                rows: false,
                bounds: false,
                depth: 0,
                index: syntax_sig(0),
                token_pos: 0,
                row_head: 0,
                value_head: 0
            },
            200
        )
    );
    // The module node ends after the trailing trivia.
    syntax_attach(p.token_pos, syntax_cell(0) - 1);
    syntax_close(source_len());
    if syntax_cell(2) > 0 {
        encode(syntax_cell(6), syntax_cell(1000002))
    } else {
        digest(mix(mix(p.h, 3000), source_len()))
    }
}

// Structured entry point backed entirely by Vesper region storage.
fn parse_tree_main() -> i64 {
    handle Fail[ArithOverflow] in {
        handle Fail[Diag] in {
            syntax_run(parse_build)
        } with {
            return value => value,
            raise(d, resume) => diag_code(d),
        }
    } with {
        return value => value,
        raise(overflow, resume) => -1 - 3 * 4294967296,
    }
}

fn parse_transport() -> i64 eff [SyntaxMemory] {
    handle Fail[ArithOverflow] in {
        handle Fail[Diag] in {
            parse_build()
        } with {
            return value => value,
            raise(error, resume) => diag_code(error),
        }
    } with {
        return value => value,
        raise(error, resume) => -1 - 3 * 4294967296,
    }
}
