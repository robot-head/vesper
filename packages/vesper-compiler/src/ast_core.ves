// Stage 1 checker adapter, version 1. Source offsets are stable handles.
// The parser on main emits a digest. This adapter reads its significant tokens;
// it does not consult the seed AST, resolver, type table or diagnostics.
// CType: 0 Unit, 1 bool, 2 i64, 3 nominal, 4 function signature.
copy struct CKind {
    mode: i64,
    seen: i64
}
copy struct CType {
    tag: i64,
    at: i64
}
copy struct CTypeAt {
    ty: CType,
    next: i64
}
copy struct CParam {
    name: Tok,
    ty: CType,
    pass: i64,
    next: i64
}
copy struct CSignature {
    params: i64,
    result: CType,
    effects: i64,
    body: i64
}
copy struct CDecl {
    kind: i64,
    mode: i64,
    name: Tok,
    start: i64,
    body: i64,
    end: i64
}
copy struct CBinding {
    name: Tok,
    ty: CType,
    pass: i64
}
copy struct CEnv {
    slots: (
        CBinding,
        CBinding,
        CBinding,
        CBinding,
        CBinding,
        CBinding,
        CBinding,
        CBinding,
        CBinding,
        CBinding,
        CBinding,
        CBinding,
        CBinding,
        CBinding,
        CBinding,
        CBinding
    ),
    count: i64,
    moved: i64
}
copy struct CExpr {
    ty: CType,
    next: i64,
    env: CEnv,
    start: i64,
    end: i64,
    place: i64,
    value_start: i64,
    value_end: i64
}
copy enum CheckError {
    Semantic(i64, i64, i64),
    Unsupported(i64, i64, i64),
    Limit(i64)
}
// Unsupported rules: 1 generics, 2 type, 3 item, 4 expression/operator,
// 5 pattern, 6 projection, 7 effect/handler, 8 constructor, 9 recursion.
fn c_error(code: i64, start: i64, end: i64)
    -> i64 eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    let r: Result[i64, CheckError] = Err(CheckError::Semantic(code, start, end));
    r?
}
fn c_unsupported(rule: i64, at: i64)
    -> i64 eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    let t = next_sig(at);
    let r: Result[i64, CheckError] = Err(CheckError::Unsupported(rule, t.start, t.end));
    r?
}
fn c_limit(at: i64) -> i64 eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    let r: Result[i64, CheckError] = Err(CheckError::Limit(at));
    r?
}
fn c_token(at: i64) -> Tok eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    next_sig(at)
}
fn c_kind(at: i64) -> i64 eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    c_token(at).kind
}
fn c_next(at: i64) -> i64 eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    c_token(at).end
}
fn c_take(at: i64, kind: i64) -> i64 eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    let t = c_token(at);
    if t.kind == kind {
        t.end
    } else {
        c_unsupported(4, at)
    }
}
fn c_word(at: i64, packed: i64) -> bool eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    let t = c_token(at);
    word(t.start, t.end) == packed
}
fn c_equal_bytes(a: i64, b: i64, n: i64)
    -> bool eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    if n == 0 {
        true
    } else if source_byte(a) != source_byte(b) {
        false
    } else {
        c_equal_bytes(a + 1, b + 1, n - 1)
    }
}
fn c_name(a: Tok, b: Tok) -> bool eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    a.end - a.start == b.end - b.start && c_equal_bytes(a.start, b.start, a.end - a.start)
}
fn c_less_bytes(a: i64, ae: i64, b: i64, be: i64)
    -> bool eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    if a == ae {
        b != be
    } else if b == be {
        false
    } else if source_byte(a) == source_byte(b) {
        c_less_bytes(a + 1, ae, b + 1, be)
    } else {
        source_byte(a) < source_byte(b)
    }
}
fn c_less(a: Tok, b: Tok) -> bool eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    c_less_bytes(a.start, a.end, b.start, b.end)
}
// Skip a balanced delimiter group. Parse validation runs before semantic work.
fn c_group(at: i64, depth: i64) -> i64 eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    if depth > 64 {
        c_limit(at)
    } else {
        let k = c_kind(at);
        if k == 32 || k == 34 || k == 36 {
            c_group_tail(
                c_next(at),
                if k == 32 {
                    33
                } else if k == 34 {
                    35
                } else {
                    37
                },
                depth + 1
            )
        } else {
            c_next(at)
        }
    }
}
fn c_group_tail(at: i64, close: i64, depth: i64)
    -> i64 eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    if c_kind(at) == close {
        c_next(at)
    } else if c_kind(at) == 70 {
        c_unsupported(4, at)
    } else {
        c_group_tail(c_group(at, depth), close, depth)
    }
}
fn c_empty() -> CEnv eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    let b = CBinding {
        name: Tok {
            kind: 70,
            start: 0,
            end: 0
        },
        ty: CType {
            tag: 0,
            at: 0
        },
        pass: 2
    };
    CEnv {
        slots: (b, b, b, b, b, b, b, b, b, b, b, b, b, b, b, b),
        count: 0,
        moved: 0
    }
}
fn c_slot(env: CEnv, i: i64) -> CBinding eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    handle Fail[RuntimeError] in {
        env.slots[i]
    } with {
        return b => b,
        raise(e, resume) => {
            let limit = c_limit(0);
            CBinding {
                name: c_token(0),
                ty: CType {
                    tag: 0,
                    at: 0
                },
                pass: 2
            }
        },
    }
}
fn c_power(i: i64) -> i64 eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    if i == 0 {
        1
    } else {
        2 * c_power(i - 1)
    }
}
fn c_moved(env: CEnv, i: i64) -> bool eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    c_div(env.moved, c_power(i)) % 2 == 1
}
fn c_move(env: CEnv, i: i64) -> CEnv eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    CEnv {
        slots: env.slots,
        count: env.count,
        moved: if c_moved(env, i) {
            env.moved
        } else {
            env.moved + c_power(i)
        }
    }
}
fn c_lookup(env: CEnv, name: Tok, n: i64)
    -> i64 eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    if n == 0 {
        -1
    } else if c_name(c_slot(env, n - 1).name, name) {
        n - 1
    } else {
        c_lookup(env, name, n - 1)
    }
}
fn c_push(env: CEnv, binding: CBinding)
    -> CEnv eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    if env.count >= 16 {
        let limit = c_limit(binding.name.start);
        env
    } else {
        CEnv {
            slots: (
                if env.count == 0 {
                    binding
                } else {
                    c_slot(env, 0)
                },
                if env.count == 1 {
                    binding
                } else {
                    c_slot(env, 1)
                },
                if env.count == 2 {
                    binding
                } else {
                    c_slot(env, 2)
                },
                if env.count == 3 {
                    binding
                } else {
                    c_slot(env, 3)
                },
                if env.count == 4 {
                    binding
                } else {
                    c_slot(env, 4)
                },
                if env.count == 5 {
                    binding
                } else {
                    c_slot(env, 5)
                },
                if env.count == 6 {
                    binding
                } else {
                    c_slot(env, 6)
                },
                if env.count == 7 {
                    binding
                } else {
                    c_slot(env, 7)
                },
                if env.count == 8 {
                    binding
                } else {
                    c_slot(env, 8)
                },
                if env.count == 9 {
                    binding
                } else {
                    c_slot(env, 9)
                },
                if env.count == 10 {
                    binding
                } else {
                    c_slot(env, 10)
                },
                if env.count == 11 {
                    binding
                } else {
                    c_slot(env, 11)
                },
                if env.count == 12 {
                    binding
                } else {
                    c_slot(env, 12)
                },
                if env.count == 13 {
                    binding
                } else {
                    c_slot(env, 13)
                },
                if env.count == 14 {
                    binding
                } else {
                    c_slot(env, 14)
                },
                if env.count == 15 {
                    binding
                } else {
                    c_slot(env, 15)
                }
            ),
            count: env.count + 1,
            moved: env.moved
        }
    }
}
fn c_result(ty: CType, next: i64, env: CEnv, start: i64, end: i64, place: i64)
    -> CExpr eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    CExpr {
        ty: ty,
        next: next,
        env: env,
        start: start,
        end: end,
        place: place,
        value_start: start,
        value_end: end
    }
}

fn c_div(a: i64, b: i64) -> i64 eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    handle Fail[RuntimeError] in {
        a / b
    } with {
        return value => value,
        raise(e, resume) => c_limit(0),
    }
}
fn c_mod(a: i64, b: i64) -> i64 eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    handle Fail[RuntimeError] in {
        a % b
    } with {
        return value => value,
        raise(e, resume) => c_limit(0),
    }
}
