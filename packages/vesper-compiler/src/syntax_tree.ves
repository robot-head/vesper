// Flat syntax transport, vesper.syntax.flat/1. Metadata cells 0..6:
// token count (EOF included), node count, diagnostic count, name count,
// current node + 1, reserved, first compatibility error code.
// Tokens: base 16, four cells: kind, start, end, owning node + 1 (EOF: 0).
// Nodes: base 270000, four cells: kind, start, end, parent + 1 (root: 0).
// Names: base 800000, three cells: start, end, previous binding + 1.
// Diagnostics: base 1000000, six cells: code, template, start, end, arg0, arg1.
// Every cell has an eight-byte little-endian view through syntax_byte.
fn syntax_byte(index: i64, byte: i64) -> i64 eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    if byte < 0 || byte > 7 {
        fail_i(Diag::Limit(0))
    } else {
        let value = syntax_cell(index);
        match byte {
            0 => value % 256,
            1 => value / 256 % 256,
            2 => value / 65536 % 256,
            3 => value / 16777216 % 256,
            4 => value / 4294967296 % 256,
            5 => value / 1099511627776 % 256,
            6 => value / 281474976710656 % 256,
            _ => value / 72057594037927936 % 256,
        }
    }
}

fn syntax_tok(i: i64) -> Tok eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    let base = 16 + i * 4;
    Tok {
        kind: syntax_cell(base),
        start: syntax_cell(base + 1),
        end: syntax_cell(base + 2)
    }
}

fn syntax_sig(i: i64) -> i64 eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    if is_trivia(syntax_tok(i).kind) {
        syntax_sig(i + 1)
    } else {
        i
    }
}

fn syntax_nth(i: i64, n: i64) -> Tok eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    let t = syntax_tok(i);
    if n == 0 || t.kind == 70 {
        t
    } else {
        syntax_nth(syntax_sig(i + 1), n - 1)
    }
}

fn syntax_lex_step(s: Lexer) -> Lexer eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    if s.done {
        s
    } else {
        let start = s.pos;
        let t = handle Fail[Diag] in {
            lex_at(start)
        } with {
            return value => value,
            raise(error, resume) => tok(69, start, syntax_lex_error_end(start)),
        };
        if t.kind == 69 {
            syntax_diag(23, t.start, t.end, 0, 0, 1);
        } else {
            ()
        };
        if t.kind != 70 && s.count >= max_tokens() {
            fail_lexer(Diag::Limit(s.pos))
        } else {
            let base = 16 + s.count * 4;
            syntax_put(base, t.kind);
            syntax_put(base + 1, t.start);
            syntax_put(base + 2, t.end);
            syntax_put(base + 3, 0);
            Lexer {
                pos: t.end,
                h: mix_token(s.h, t),
                count: s.count + 1,
                done: t.kind == 70
            }
        }
    }
}

fn syntax_lex_steps(k: i64, s: Lexer) -> Lexer eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    if k == 0 || s.done {
        s
    } else if k == 1 {
        syntax_lex_step(s)
    } else {
        syntax_lex_steps(k - k / 2, syntax_lex_steps(k / 2, s))
    }
}

fn syntax_lex() -> i64 eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    if source_len() > 1048576 {
        fail_i(Diag::Limit(0))
    } else {
        let s = syntax_lex_steps(
            65537,
            Lexer {
                pos: 0,
                h: offset_basis(),
                count: 0,
                done: false
            }
        );
        syntax_put(0, s.count);
        digest(mix(s.h, s.count))
    }
}

fn syntax_attach(first: i64, end: i64) -> Unit eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    if first < end {
        syntax_put(16 + first * 4 + 3, syntax_cell(4));
        syntax_attach(first + 1, end)
    } else {
        ()
    }
}

fn syntax_open(kind: i64, start: i64) -> Unit eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    let id = syntax_cell(1);
    if id >= 131072 {
        let ignored = fail_i(Diag::Limit(start));
        ()
    } else {
        let base = 270000 + id * 4;
        syntax_put(base, kind);
        syntax_put(base + 1, start);
        syntax_put(base + 3, syntax_cell(4));
        syntax_put(1, id + 1);
        syntax_put(4, id + 1)
    }
}

fn syntax_close(end: i64) -> Unit eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    let base = 270000 + (syntax_cell(4) - 1) * 4;
    syntax_put(base + 2, end);
    syntax_put(4, syntax_cell(base + 3))
}

fn syntax_name(t: Tok, previous: i64) -> i64 eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    let id = syntax_cell(3) + 1;
    if id > 65536 {
        fail_i(Diag::Limit(t.start))
    } else {
        let base = 800000 + (id - 1) * 3;
        syntax_put(base, t.start);
        syntax_put(base + 1, t.end);
        syntax_put(base + 2, previous);
        syntax_put(3, id);
        id
    }
}

fn syntax_text_equal(a: i64, b: i64, n: i64) -> bool eff [Fail[ArithOverflow]] {
    if n == 0 {
        true
    } else if source_byte(a) != source_byte(b) {
        false
    } else {
        syntax_text_equal(a + 1, b + 1, n - 1)
    }
}

fn syntax_contains(head: i64, t: Tok) -> bool eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    if head == 0 {
        false
    } else {
        let base = 800000 + (head - 1) * 3;
        let start = syntax_cell(base);
        let end = syntax_cell(base + 1);
        if end - start == t.end - t.start && syntax_text_equal(start, t.start, end - start) {
            true
        } else {
            syntax_contains(syntax_cell(base + 2), t)
        }
    }
}

fn syntax_heads(p: ParseCursor, rows: i64, values: i64) -> ParseCursor eff [SyntaxMemory] {
    ParseCursor {
        pos: p.pos,
        cur: p.cur,
        h: p.h,
        nostruct: p.nostruct,
        rows: p.rows,
        bounds: p.bounds,
        depth: p.depth,
        index: p.index,
        row_head: rows,
        value_head: values,
        token_pos: p.token_pos
    }
}

fn syntax_bind(p: ParseCursor, row: bool)
    -> ParseCursor eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    if row {
        syntax_heads(p, syntax_name(p.cur, p.row_head), p.value_head)
    } else {
        syntax_heads(p, p.row_head, syntax_name(p.cur, p.value_head))
    }
}

// Logos retains the valid regex prefix of a malformed string. An escape
// followed by newline/EOF ends that prefix before the backslash.
fn syntax_bad_string(i: i64) -> i64 eff [Fail[ArithOverflow]] {
    let c = source_byte(i);
    if c == -1 {
        i
    } else if c == 92 {
        let next = source_byte(i + 1);
        if next == -1 || next == 10 {
            i
        } else {
            syntax_bad_string(i + 2)
        }
    } else {
        syntax_bad_string(i + 1)
    }
}
fn syntax_utf8_end(i: i64) -> i64 eff [Fail[ArithOverflow]] {
    let c = source_byte(i);
    if c >= 128 && c < 192 {
        syntax_utf8_end(i + 1)
    } else {
        i
    }
}
fn syntax_lex_error_end(start: i64) -> i64 eff [Fail[ArithOverflow]] {
    let c = source_byte(start);
    if c == 34 {
        syntax_bad_string(start + 1)
    } else if c == 47 && source_byte(start + 1) == 42 {
        source_len()
    } else if c >= 128 {
        syntax_utf8_end(start + 1)
    } else {
        start + 1
    }
}
