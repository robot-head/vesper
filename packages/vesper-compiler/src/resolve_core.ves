// Monomorphic declaration/name resolution. Identifiers compare exact bytes,
// including identifiers longer than the lexer's six-byte keyword packing.
fn c_type(at: i64, depth: i64) -> CTypeAt eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    if depth > 32 {
        let limit = c_limit(at);
        CTypeAt {
            ty: CType {
                tag: 0,
                at: 0
            },
            next: at
        }
    } else {
        let t = c_token(at);
        if t.kind == 12 {
            let sig = c_signature(at, false, depth + 1);
            CTypeAt {
                ty: CType {
                    tag: 4,
                    at: t.start
                },
                next: sig.body
            }
        } else if t.kind == 32 && c_kind(t.end) == 33 {
            CTypeAt {
                ty: CType {
                    tag: 0,
                    at: 0
                },
                next: c_next(t.end)
            }
        } else if t.kind == 3 || t.kind == 4 {
            let builtin = t
                .end
                - t
                .start
                > 6
                && (
                word(t.start, t.start + 6)
                    == 0x41726974684f
                    || word(t.start, t.start + 6)
                    == 0x52756e74696d
            );
            let unsupported = if builtin
                || c_word(at, 0x7538)
                || c_word(at, 0x753332)
                || c_word(at, 0x753634)
                || c_word(at, 0x663634)
                || c_word(at, 0x537472696e67)
                || c_word(at, 0x4e65766572) {
                c_unsupported(2, at)
            } else {
                0
            };
            let tag = if c_word(at, 0x556e6974) {
                0
            } else if c_word(at, 0x626f6f6c) {
                1
            } else if c_word(at, 0x693634) {
                2
            } else {
                3
            };
            if c_kind(t.end) == 36 {
                let unsupported = c_unsupported(1, t.end);
                CTypeAt {
                    ty: CType {
                        tag: tag,
                        at: t.start
                    },
                    next: t.end
                }
            } else if c_kind(t.end) == 41 {
                let unsupported = c_unsupported(2, at);
                CTypeAt {
                    ty: CType {
                        tag: tag,
                        at: t.start
                    },
                    next: t.end
                }
            } else {
                CTypeAt {
                    ty: CType {
                        tag: tag,
                        at: t.start
                    },
                    next: t.end
                }
            }
        } else {
            let unsupported = c_unsupported(2, at);
            CTypeAt {
                ty: CType {
                    tag: 0,
                    at: 0
                },
                next: at
            }
        }
    }
}
fn c_pass(at: i64) -> i64 eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    if c_kind(at) == 20 {
        1
    } else if c_kind(at) == 21 {
        2
    } else {
        0
    }
}
fn c_pass_next(at: i64) -> i64 eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    let k = c_kind(at);
    if k == 19 || k == 20 || k == 21 {
        c_next(at)
    } else {
        at
    }
}
fn c_param(at: i64, named: bool, depth: i64)
    -> CParam eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    let start = c_pass_next(at);
    let name = c_token(start);
    let ty_at = if named {
        c_take(name.end, 40)
    } else {
        start
    };
    let ty = c_type(ty_at, depth + 1);
    CParam {
        name: name,
        ty: ty.ty,
        pass: c_pass(at),
        next: ty.next
    }
}
fn c_params_end(at: i64, named: bool, depth: i64)
    -> i64 eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    if c_kind(at) == 33 {
        c_next(at)
    } else {
        let p = c_param(at, named, depth);
        if c_kind(p.next) == 38 {
            c_params_end(c_next(p.next), named, depth)
        } else {
            c_take(p.next, 33)
        }
    }
}
fn c_signature(at: i64, named: bool, depth: i64)
    -> CSignature eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    let next = c_take(at, 12);
    let next = if named {
        c_next(next)
    } else {
        next
    };
    let next = if c_kind(next) == 44 {
        c_next(c_next(next))
    } else {
        next
    };
    let params = c_take(next, 32);
    let next = c_params_end(params, named, depth);
    let ret = if c_kind(next) == 46 {
        c_type(c_next(next), depth + 1)
    } else {
        CTypeAt {
            ty: CType {
                tag: 0,
                at: 0
            },
            next: next
        }
    };
    let effects = if c_kind(ret.next) == 18 {
        c_take(c_next(ret.next), 36)
    } else {
        -1
    };
    let body = if effects < 0 {
        ret.next
    } else {
        c_row_end(effects)
    };
    CSignature {
        params: params,
        result: ret.ty,
        effects: effects,
        body: body
    }
}
// Rows contain only unlabelled Fail[monomorphic error type] entries.
fn c_row_end(at: i64) -> i64 eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    if c_kind(at) == 37 {
        c_next(at)
    } else if c_word(at, 0x4661696c) {
        let ty = c_type(c_take(c_next(at), 36), 0);
        let next = c_take(ty.next, 37);
        if c_kind(next) == 38 {
            c_row_end(c_next(next))
        } else {
            c_take(next, 37)
        }
    } else {
        c_unsupported(7, at)
    }
}
fn c_decl(at: i64) -> CDecl eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    let start = c_token(at).start;
    let first = c_kind(at);
    let mode = if first == 14 {
        0
    } else if first == 16 {
        2
    } else {
        1
    };
    let at = if first == 14 || first == 15 || first == 16 {
        c_next(at)
    } else {
        at
    };
    let kind = c_kind(at);
    let name = c_token(c_next(at));
    let body = if kind == 12 {
        c_signature(at, true, 0).body
    } else if kind == 8 || kind == 9 {
        name.end
    } else {
        c_unsupported(3, at)
    };
    if c_kind(body) == 36 {
        let unsupported = c_unsupported(1, body);
        CDecl {
            kind: kind,
            mode: mode,
            name: name,
            start: start,
            body: body,
            end: body
        }
    } else {
        CDecl {
            kind: kind,
            mode: mode,
            name: name,
            start: start,
            body: body,
            end: c_group(body, 0)
        }
    }
}
fn c_find(name: Tok, kind: i64, at: i64)
    -> i64 eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    if c_kind(at) == 70 {
        -1
    } else {
        let d = c_decl(at);
        if (d.kind == kind || kind == 0 && (d.kind == 8 || d.kind == 9)) && c_name(d.name, name) {
            d.start
        } else {
            c_find(name, kind, d.end)
        }
    }
}
fn c_valid_type(ty: CType, start: i64, end: i64, depth: i64)
    -> i64 eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    if depth > 32 {
        c_unsupported(9, start)
    } else if ty.tag == 3 {
        if c_find(c_token(ty.at), 0, 0) < 0 {
            c_error(101, start, end)
        } else {
            0
        }
    } else if ty.tag == 4 {
        let sig = c_signature(ty.at, false, depth + 1);
        let params = c_valid_params(sig.params, false, start, end, depth + 1);
        c_valid_type(sig.result, start, end, depth + 1)
    } else {
        0
    }
}
fn c_valid_params(at: i64, named: bool, start: i64, end: i64, depth: i64)
    -> i64 eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    if c_kind(at) == 33 {
        0
    } else {
        let p = c_param(at, named, depth);
        let valid = c_valid_type(p.ty, start, end, depth);
        if c_kind(p.next) == 38 {
            c_valid_params(c_next(p.next), named, start, end, depth)
        } else {
            0
        }
    }
}
fn c_same(a: CType, b: CType, depth: i64)
    -> bool eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    if depth > 32 {
        let limit = c_limit(0);
        false
    } else if a.tag != b.tag {
        false
    } else if a.tag == 3 {
        c_name(c_token(a.at), c_token(b.at))
    } else if a.tag == 4 {
        let sa = c_signature(a.at, c_kind(c_next(a.at)) == 4, depth + 1);
        let sb = c_signature(b.at, c_kind(c_next(b.at)) == 4, depth + 1);
        c_same(sa.result, sb.result, depth + 1)
            && c_same_params(
            sa.params,
            sb.params,
            c_kind(c_next(a.at)) == 4,
            c_kind(c_next(b.at)) == 4,
            depth + 1
        )
            && c_row_subset(sa.effects, sb.effects)
            && c_row_subset(sb.effects, sa.effects)
    } else {
        true
    }
}
fn c_same_params(a: i64, b: i64, an: bool, bn: bool, depth: i64)
    -> bool eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    if c_kind(a) == 33 || c_kind(b) == 33 {
        c_kind(a) == c_kind(b)
    } else {
        let pa = c_param(a, an, depth);
        let pb = c_param(b, bn, depth);
        pa
            .pass
            == pb
            .pass
            && c_same(pa.ty, pb.ty, depth + 1)
            && c_same_params(
            if c_kind(pa.next) == 38 {
                c_next(pa.next)
            } else {
                pa.next
            },
            if c_kind(pb.next) == 38 {
                c_next(pb.next)
            } else {
                pb.next
            },
            an,
            bn,
            depth
        )
    }
}
fn c_expect_type(expected: CType, actual: CType, start: i64, end: i64)
    -> i64 eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    if c_compatible(expected, actual, 0) {
        0
    } else {
        c_error(200, start, end)
    }
}
fn c_row_has(row: i64, ty: CType) -> bool eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    if row < 0 || c_kind(row) == 37 {
        false
    } else {
        let t = c_type(c_take(c_next(row), 36), 0);
        if c_same(t.ty, ty, 0) {
            true
        } else {
            let next = c_take(t.next, 37);
            if c_kind(next) == 38 {
                c_row_has(c_next(next), ty)
            } else {
                false
            }
        }
    }
}
fn c_row_subset(a: i64, b: i64) -> bool eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    if a < 0 || c_kind(a) == 37 {
        true
    } else {
        let ty = c_type(c_take(c_next(a), 36), 0);
        let next = c_take(ty.next, 37);
        c_row_has(b, ty.ty)
            && (
            if c_kind(next) == 38 {
                c_row_subset(c_next(next), b)
            } else {
                true
            }
        )
    }
}

fn c_compatible(expected: CType, actual: CType, depth: i64)
    -> bool eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    if depth > 32 {
        let limit = c_limit(0);
        false
    } else if expected.tag == 4 && actual.tag == 4 {
        let en = c_kind(c_next(expected.at)) == 4;
        let an = c_kind(c_next(actual.at)) == 4;
        let e = c_signature(expected.at, en, depth + 1);
        let a = c_signature(actual.at, an, depth + 1);
        c_mode(actual, 0)
            <= c_mode(expected, 0)
            && c_row_subset(a.effects, e.effects)
            && c_compatible(e.result, a.result, depth + 1)
            && c_compatible_params(e.params, a.params, en, an, depth + 1)
    } else {
        c_same(expected, actual, depth)
    }
}
fn c_compatible_params(e: i64, a: i64, en: bool, an: bool, depth: i64)
    -> bool eff [Fail[CheckError], Fail[Diag], Fail[ArithOverflow]] {
    if c_kind(e) == 33 || c_kind(a) == 33 {
        c_kind(e) == c_kind(a)
    } else {
        let ep = c_param(e, en, depth);
        let ap = c_param(a, an, depth);
        ep
            .pass
            == ap
            .pass
            && c_compatible(ap.ty, ep.ty, depth + 1)
            && c_compatible_params(
            if c_kind(ep.next) == 38 {
                c_next(ep.next)
            } else {
                ep.next
            },
            if c_kind(ap.next) == 38 {
                c_next(ap.next)
            } else {
                ap.next
            },
            en,
            an,
            depth
        )
    }
}
