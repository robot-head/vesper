// Diagnostics use the seed codes, UTF-8 byte spans and seed message text.
// Template 1 is `expected {TokenKind}, found {TokenKind}`. Other templates
// are static strings; syntax_message_byte renders both in Vesper, so a
// consumer needs no Rust message table.
fn syntax_diag(message: i64, start: i64, end: i64, a: i64, b: i64, legacy: i64)
    -> Unit eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    let count = syntax_cell(2);
    if count >= 128 {
        let ignored = fail_i(Diag::Limit(start));
        ()
    } else {
        let base = 1000000 + count * 6;
        syntax_put(
            base,
            if message == 23 {
                1
            } else {
                2
            }
        );
        syntax_put(base + 1, message);
        syntax_put(base + 2, start);
        syntax_put(base + 3, end);
        syntax_put(base + 4, a);
        syntax_put(base + 5, b);
        syntax_put(2, count + 1);
        if count == 0 {
            syntax_put(6, legacy);
        } else {
            ()
        }
    }
}
fn syntax_issue(p: P, message: i64) -> P eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    syntax_diag(
        message,
        p.cur.start,
        p.cur.end,
        0,
        0,
        if message == 10 || message == 11 || message == 12 || message == 13 || message == 9 {
            4
        } else {
            2
        }
    );
    p
}
fn syntax_expected(p: P, expected: i64) -> P eff [SyntaxMemory, Fail[Diag], Fail[ArithOverflow]] {
    syntax_diag(1, p.cur.start, p.cur.end, expected, p.cur.kind, 2);
    p
}
fn syntax_message_len(message: i64, a: i64, b: i64) -> i64 eff [Fail[ArithOverflow]] {
    if message == 1 {
        17 + syntax_static_len(100 + a) + syntax_static_len(100 + b)
    } else {
        syntax_static_len(message)
    }
}
fn syntax_message_byte(message: i64, a: i64, b: i64, i: i64) -> i64 eff [Fail[ArithOverflow]] {
    if message != 1 {
        syntax_static_byte(message, i)
    } else {
        let name_end = 9 + syntax_static_len(100 + a);
        if i < 9 {
            syntax_static_byte(200, i)
        } else if i < name_end {
            syntax_static_byte(100 + a, i - 9)
        } else if i < name_end + 8 {
            syntax_static_byte(201, i - name_end)
        } else {
            syntax_static_byte(100 + b, i - name_end - 8)
        }
    }
}
