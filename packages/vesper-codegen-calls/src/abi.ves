// The native ABI decisions of src/native.rs: `scalar`,
// `signature_with_abi`, `FnAbi`, `NativeAbi::plan`/`internal`,
// `register_result_words`, and the entry checks and declarations of
// `compile_entry`/`declare_instances_with_trace` (an object or JIT entry
// that handles its effects: `EntryEffects::Handled`).
//
// A signature is a list of value-type codes (`V_*`) for its parameters and
// its returns; the pointer type is `I64` on every hosted target.

use @vesper/check-data::util::{add, n32, push_decimal, u32_at, w};
use @vesper/check-data::names::{Names};
use @vesper/check-data::types::{TyKind, TyPass, Types, display};
use @vesper/check-data::world::{World};
use @vesper/check-layout::{Layouts, layout_of};
use self::data::{Calls, FnInfo, ParamInfo};
use self::instances::{
    Conc, Found, Inst, Syms, bare_trace, capability_abi, capability_only, concrete,
    contains_function, fail_only, is_foreign, is_root
};

const NONE32: u32 = 4294967295;

pub const V_I64: u8 = 0;
pub const V_I128: u8 = 1;
pub const V_F64: u8 = 2;
pub const V_F32: u8 = 3;
// No type: `scalar` refused (the message is in the error buffer).
const V_NONE: u8 = 255;

// `FnAbi`.
pub copy struct FnAbi {
    status: bool,
    // register-result words, or 0 for none
    result_words: u32,
}

pub fn default_abi() -> FnAbi {
    FnAbi { status: false, result_words: 0 }
}

pub struct Sig {
    params: ChunkSeq[u8],
    returns: ChunkSeq[u8],
}

// The error of a failed decision (Rust: `Err(String)`), shared by every
// step of one task.
pub struct Errs {
    text: ChunkSeq[u8],
}

impl Errs {
    pub fn failed(in self) -> bool {
        self.text.len() > 0
    }
}

// `Layout::of(world, ty)`: (aggregate, size), or the message in `err`.
pub copy struct LayoutFacts {
    ok: bool,
    aggregate: bool,
    size: u32,
}

pub fn layout_facts(
    inout layouts: Layouts,
    inout types: Types,
    inout names: Names,
    in world: World,
    ty: u32,
    inout err: Errs
) -> LayoutFacts {
    let mark = layouts.mark();
    let layout = layout_of(inout layouts, inout types, inout names, in world, ty);
    if layout == NONE32 {
        err.text.clear();
        err.text.extend(in layouts.err.as_slice());
        layouts.reset(mark);
        return LayoutFacts { ok: false, aggregate: false, size: 0 };
    }
    let facts = LayoutFacts {
        ok: true,
        aggregate: layouts.aggregate(layout),
        size: layouts.node(layout).size
    };
    layouts.reset(mark);
    facts
}

// `scalar(t, generics)`.
pub fn scalar(
    in types: Types,
    in names: Names,
    in calls: Calls,
    syms: Syms,
    info: FnInfo,
    ty: u32,
    inout err: Errs
) -> u8 {
    let node = types.node(ty);
    if node.kind == TyKind::Lit {
        return V_I64;
    }
    if node.kind == TyKind::Named {
        if syms.is_wide(node.name) {
            return V_I128;
        }
        if node.name == syms.f64_ {
            return V_F64;
        }
        if node.name == syms.f32_ {
            return V_F32;
        }
        if syms.is_scalar(node.name) && !syms.is_float(node.name) {
            return V_I64;
        }
        for i in 0..w(info.generic_count) {
            if calls.generic(add(w(info.generic_start), i)) == node.name {
                return V_I64;
            }
        }
        // Region box, watermark, TiledSeq, Box[T] and sequence handles are
        // one word.
        if node.name == syms.region_box || node.name == syms.watermark {
            return V_I64;
        }
        if node.name == syms.box_ && node.n == 1 {
            return V_I64;
        }
        if node.name == syms.tiled_seq && (node.n == 1 || node.n == 2) {
            return V_I64;
        }
        if node.name == syms.chunk_seq && node.n == 1 {
            return V_I64;
        }
    }
    if node.kind == TyKind::Tuple && node.n == 0 {
        return V_I64;
    }
    if node.kind == TyKind::Infer || node.kind == TyKind::Fn {
        return V_I64;
    }
    err.text.clear();
    err.text.extend(in "native backend does not yet lower aggregate type ".as_bytes());
    display(in types, in names, ty, inout err.text);
    V_NONE
}

pub fn uses_caller_slot(in calls: Calls, info: FnInfo) -> bool {
    info.fip && calls.uses_caller_slot_name(info.name)
}

// `signature_with_abi(m, world, f, false, abi)`; false with the message in
// `err` when a layout or `scalar` refuses.
pub fn signature(
    inout layouts: Layouts,
    inout types: Types,
    inout names: Names,
    in world: World,
    in calls: Calls,
    syms: Syms,
    in func: Conc,
    abi: FnAbi,
    inout sig: Sig,
    inout err: Errs
) -> bool {
    sig.params.clear();
    sig.returns.clear();
    let info = calls.fn_info(func.func_index);
    let result = layout_facts(
        inout layouts,
        inout types,
        inout names,
        in world,
        func.result,
        inout err
    );
    if !result.ok {
        return false;
    }
    if result.aggregate && abi.result_words == 0 {
        sig.params.push(V_I64);
    }
    for i in 0..func.params.len() {
        let param = func.param(i);
        let param_layout = layout_facts(
            inout layouts,
            inout types,
            inout names,
            in world,
            param.ty,
            inout err
        );
        if !param_layout.ok {
            return false;
        }
        if param_layout.aggregate || param.pass == TyPass::Inout {
            sig.params.push(V_I64);
        } else {
            let code = scalar(in types, in names, in calls, syms, info, param.ty, inout err);
            if code == V_NONE {
                return false;
            }
            sig.params.push(code);
        }
    }
    if uses_caller_slot(in calls, info) {
        sig.params.push(V_I64);
    }
    if fail_only(inout types, in names, in world, syms, in func) {
        sig.params.push(V_I64);
    }
    if abi.result_words != 0 {
        for i in 0..w(abi.result_words) {
            sig.returns.push(V_I64);
        }
    } else if result.aggregate {
        sig.returns.push(V_I64);
    } else {
        let code = scalar(in types, in names, in calls, syms, info, func.result, inout err);
        if code == V_NONE {
            return false;
        }
        sig.returns.push(code);
    }
    if abi.status {
        sig.returns.push(V_I64);
    }
    true
}

// `register_result_words`: 0 for none.
fn register_result_words(
    inout layouts: Layouts,
    inout types: Types,
    inout names: Names,
    in world: World,
    in calls: Calls,
    in func: Conc,
    inout err: Errs
) -> u32 {
    let layout = layout_facts(
        inout layouts,
        inout types,
        inout names,
        in world,
        func.result,
        inout err
    );
    if !layout.ok {
        return NONE32;
    }
    let info = calls.fn_info(func.func_index);
    if !layout.aggregate
        || layout.size == 0
        || layout.size > 16
        || contains_function(inout types, in world, func.result)
        || uses_caller_slot(in calls, info)
        || info.fip
    {
        return 0;
    }
    wrapping_add(layout.size, 7) / 8
}

// `NativeAbi::internal`: the convention of a non-boundary function; false
// with the message in `err` when its result layout refuses.
pub fn internal(
    inout layouts: Layouts,
    inout types: Types,
    inout names: Names,
    in world: World,
    in calls: Calls,
    syms: Syms,
    in func: Conc,
    inout abi: FnAbi,
    inout err: Errs
) -> bool {
    abi.status = false;
    abi.result_words = 0;
    let row = types.row(func.row);
    if fail_only(inout types, in names, in world, syms, in func)
        && !capability_abi(inout types, in names, in world, syms, in func)
    {
        abi.status = true;
    } else if row.n == 0 && row.tail == 0 {
        let words = register_result_words(
            inout layouts,
            inout types,
            inout names,
            in world,
            in calls,
            in func,
            inout err
        );
        if words == NONE32 {
            return false;
        }
        abi.result_words = words;
    }
    true
}

// The entry checks of `compile_entry` for `EntryEffects::Handled`; false
// with the message in `err`.
pub fn check_entry(
    inout types: Types,
    in names: Names,
    in world: World,
    in calls: Calls,
    entry: u32,
    inout err: Errs
) -> bool {
    check_entry_traced(inout types, in names, in world, in calls, entry, false, inout err)
}

// `trace_ok` of `compile_entry`: a trace-host task whose entry, with Beacon
// active, has a closed row holding the bare `Trace` and otherwise only
// foreign capabilities.
pub fn trace_entry_ok(
    in types: Types,
    in names: Names,
    in calls: Calls,
    syms: Syms,
    entry: u32
) -> bool {
    let func_index = calls.function(entry);
    if func_index == NONE32 || !calls.trace_active {
        return false;
    }
    let row = types.row(calls.fn_info(func_index).row);
    if row.tail != 0 {
        return false;
    }
    let mut any = false;
    for i in 0..w(row.n) {
        let effect = types.effect_at(add(w(row.a), i));
        if bare_trace(syms, effect) {
            any = true;
        } else if !is_foreign(in names, effect.name) {
            return false;
        }
    }
    any
}

// [`check_entry`] of a task; `trace_ok` ([`trace_entry_ok`]) lets the
// entry leave the bare `Trace` unhandled.
pub fn check_entry_traced(
    inout types: Types,
    in names: Names,
    in world: World,
    in calls: Calls,
    entry: u32,
    trace_ok: bool,
    inout err: Errs
) -> bool {
    let func_index = calls.function(entry);
    if func_index == NONE32 {
        err.text.clear();
        err.text.extend(in "unknown entry".as_bytes());
        return false;
    }
    let info = calls.fn_info(func_index);
    let row = types.row(info.row);
    let mut handled = row.tail == 0;
    for i in 0..w(row.n) {
        if !is_foreign(in names, types.effect_at(add(w(row.a), i)).name) {
            handled = false;
        }
    }
    if !handled && !trace_ok {
        err.text.clear();
        err.text.extend(in "native entry must handle all effects".as_bytes());
        return false;
    }
    let mut exposes = contains_function(inout types, in world, info.result);
    for i in 0..w(info.param_count) {
        if contains_function(inout types, in world, calls.param(add(w(info.param_start), i)).ty) {
            exposes = true;
        }
    }
    if exposes {
        err.text.clear();
        err.text.extend(
            in "native entry cannot expose specialized closure values; invoke them within the entry function"
                .as_bytes()
        );
        return false;
    }
    true
}

fn put_code(code: u8, inout out: ChunkSeq[u8]) {
    if code == V_I128 {
        out.extend(in "i128".as_bytes());
    } else if code == V_F64 {
        out.extend(in "f64".as_bytes());
    } else if code == V_F32 {
        out.extend(in "f32".as_bytes());
    } else {
        out.extend(in "i64".as_bytes());
    }
}

// `(p, ...) -> r, ...`
pub fn put_sig(in sig: Sig, inout out: ChunkSeq[u8]) {
    out.push(40);
    for i in 0..sig.params.len() {
        if i > 0 {
            out.extend(in ", ".as_bytes());
        }
        put_code(sig.params.try_get(i).unwrap_or(V_I64), inout out);
    }
    out.extend(in ") -> ".as_bytes());
    for i in 0..sig.returns.len() {
        if i > 0 {
            out.extend(in ", ".as_bytes());
        }
        put_code(sig.returns.try_get(i).unwrap_or(V_I64), inout out);
    }
}

// The declarations of an entry's instances: `NativeAbi::plan` (optimized
// builds; the entry is the only boundary) then each instance's symbol and
// signature, one line each: `I <index> <key> = <source> @ <symbol> : <sig>`.
// False with the message in `err` when a decision refuses.
pub fn declare(
    inout layouts: Layouts,
    inout types: Types,
    inout names: Names,
    in world: World,
    in calls: Calls,
    syms: Syms,
    in found: Found,
    entry: u32,
    optimize: bool,
    inout out: ChunkSeq[u8],
    inout err: Errs
) -> bool {
    let mut roots: ChunkSeq[u32] = ChunkSeq::new[u32]();
    roots.push(entry);
    declare_roots(
        inout layouts,
        inout types,
        inout names,
        in world,
        in calls,
        syms,
        in found,
        in roots,
        optimize,
        inout out,
        inout err
    )
}

// [`declare`] with every root a boundary (a library's exports keep the
// failure-record ABI, `native_export::compile_exports`); a root's line
// names its source symbol.
pub fn declare_roots(
    inout layouts: Layouts,
    inout types: Types,
    inout names: Names,
    in world: World,
    in calls: Calls,
    syms: Syms,
    in found: Found,
    in roots: ChunkSeq[u32],
    optimize: bool,
    inout out: ChunkSeq[u8],
    inout err: Errs
) -> bool {
    let n = found.insts.len();
    let mut abis: ChunkSeq[FnAbi] = ChunkSeq::with_capacity[FnAbi](n);
    for i in 0..n {
        let inst = found.inst(i);
        let mut abi = default_abi();
        if optimize && !is_root(in roots, inst.key) {
            let vars = found.vars_of(inst);
            let func = concrete(inout types, inout names, in calls, inst.name, in vars);
            if !internal(
                inout layouts,
                inout types,
                inout names,
                in world,
                in calls,
                syms,
                in func,
                inout abi,
                inout err
            ) {
                return false;
            }
        }
        abis.push(abi);
    }
    let mut sig = Sig {
        params: ChunkSeq::new[u8](),
        returns: ChunkSeq::new[u8](),
    };
    let mut lines: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for i in 0..n {
        let inst = found.inst(i);
        let vars = found.vars_of(inst);
        let func = concrete(inout types, inout names, in calls, inst.name, in vars);
        let abi = match abis.try_get(i) {
            Option::Some(planned) => planned,
            Option::None => default_abi(),
        };
        if !signature(
            inout layouts,
            inout types,
            inout names,
            in world,
            in calls,
            syms,
            in func,
            abi,
            inout sig,
            inout err
        ) {
            return false;
        }
        lines.extend(in "I ".as_bytes());
        push_decimal(inout lines, i);
        lines.push(32);
        names.write(inst.key, inout lines);
        lines.extend(in " = ".as_bytes());
        names.write(inst.name, inout lines);
        lines.extend(in " @ ".as_bytes());
        if is_root(in roots, inst.key) {
            names.write(inst.key, inout lines);
        } else {
            lines.extend(in "vesper_function_".as_bytes());
            push_decimal(inout lines, i);
            lines.push(95);
            push_symbol_key(in names, inst.key, inout lines);
        }
        lines.extend(in " : ".as_bytes());
        put_sig(in sig, inout lines);
        lines.push(10);
    }
    out.extend(in lines.as_slice());
    true
}

// The key part of `local_symbol` (src/native.rs, #1451): the first 96
// characters of the instance key, each outside `[A-Za-z0-9_]` as `_`. A
// UTF-8 continuation byte belongs to the character before it, so it adds
// nothing.
pub fn push_symbol_key(in names: Names, key: u32, inout out: ChunkSeq[u8]) {
    let n = names.size(key);
    let mut chars: u64 = 0;
    let mut i: u64 = 0;
    loop {
        if i >= n {
            break;
        }
        let byte = names.byte(key, i);
        i = add(i, 1);
        if byte >= 128 && byte < 192 {
            continue;
        }
        if chars >= 96 {
            break;
        }
        chars = add(chars, 1);
        let keep = (byte >= 48 && byte <= 57)
            || (byte >= 65 && byte <= 90)
            || (byte >= 97 && byte <= 122)
            || byte == 95;
        if keep {
            out.push(byte);
        } else {
            out.push(95);
        }
    }
}
