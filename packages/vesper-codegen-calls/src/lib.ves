// @vesper/codegen-calls: native lowering's instances, signatures and
// calling conventions (self-hosting wave SH4, lane 7, #1281), ported from
// src/native.rs:
//
// - instances.ves: monomorphization (`instances_for_entry`,
//   `instance_key`, `concrete`, `call_vars`, the function predicates and
//   `drop_callees`).
// - abi.ves: `scalar`, `signature_with_abi`, `FnAbi`/`NativeAbi`,
//   `register_result_words`, the entry checks of `compile_entry` and the
//   symbols and signatures `declare_instances_with_trace` declares.
// - data.ves: the function table, body expressions, call instantiations
//   and `dyn` tables these read (the calls section of the input).
//
// The input is @vesper/check-data's names, types and world, then
// @vesper/place-ir's program section (the lowered program, whose reads and
// handle drops discovery follows), then the calls section; the harness is
// tests/self_host_codegen_calls.rs. Emission (call lowering, entries)
// comes with the SH4 codegen swap point (lane 1, #1275).
//
// - `codegen_calls_text`: per task (entry, optimize) a block
//   `E <entry> <0|1>`, the capability-ABI instance keys (`C <key>`, or
//   `C! <error>`), then the declared instances (`I ...`) or the error that
//   refused the entry (`X <message>`).

use @vesper/check-data::pack_text;
use @vesper/check-data::input::{Reader, read_ctx};
use @vesper/check-layout::{layouts_new};
use @vesper/place-ir::{read_program};
use self::data::{read_calls};
use self::instances::{capability_abi, concrete, discover, program_facts, syms_new};
use self::abi::{Errs, check_entry, declare};

pub fn codegen_calls_text(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mut reader = Reader { pos: 0 };
    let mut ctx = read_ctx(inout reader, in bytes);
    let program = read_program(inout reader, in bytes, in ctx);
    let calls = read_calls(inout reader, in bytes, in ctx);
    let syms = syms_new(inout ctx.names);
    let facts = program_facts(in ctx.names, in calls, in program);
    let mut layouts = layouts_new();
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for task_index in 0..calls.tasks.len() {
        let task = calls.task(task_index);
        out.extend(in "E ".as_bytes());
        ctx.names.write(task.entry, inout out);
        if task.optimize {
            out.extend(in " 1\n".as_bytes());
        } else {
            out.extend(in " 0\n".as_bytes());
        }
        let found = discover(
            inout ctx.types,
            inout ctx.names,
            in ctx.world,
            in calls,
            in facts,
            syms,
            task.entry
        );
        if found.err.len() > 0 {
            out.extend(in "C! ".as_bytes());
            out.extend(in found.err.as_slice());
            out.push(10);
        } else {
            for i in 0..found.insts.len() {
                let inst = found.inst(i);
                let vars = found.vars_of(inst);
                let func = concrete(inout ctx.types, inout ctx.names, in calls, inst.name, in vars);
                if capability_abi(inout ctx.types, in ctx.names, in ctx.world, syms, in func) {
                    out.extend(in "C ".as_bytes());
                    ctx.names.write(inst.key, inout out);
                    out.push(10);
                }
            }
        }
        let mut err = Errs { text: ChunkSeq::new[u8]() };
        let ok = check_entry(
            inout ctx.types,
            in ctx.names,
            in ctx.world,
            in calls,
            task.entry,
            inout err
        )
            && found.err.len() == 0
            && declare(
                inout layouts,
                inout ctx.types,
                inout ctx.names,
                in ctx.world,
                in calls,
                syms,
                in found,
                task.entry,
                task.optimize,
                inout out,
                inout err
            );
        if !ok {
            out.extend(in "X ".as_bytes());
            if err.failed() {
                out.extend(in err.text.as_slice());
            } else {
                out.extend(in found.err.as_slice());
            }
            out.push(10);
        }
    }
    pack_text(in out)
}
