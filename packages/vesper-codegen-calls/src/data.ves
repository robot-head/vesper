// The parts of the checker's `World` and of each function's AST that
// native lowering's decisions read, beyond @vesper/check-data's world
// section: the function table (`world.functions`), the body expressions
// (in `native::visit` order), the call instantiations (`world.calls`),
// the `dyn` tables (`world.dyn_objects`) and three facts other passes own
// (`trace_effects::active`, whether a `ConstDenorm` span exists and the fip
// caller-slot functions).
//
// The section follows @vesper/place-ir's program section; the encoder is
// `calls_section` in tests/self_host_codegen_calls.rs:
//
//   world flags: 1 trace_active | 2 a ConstDenorm span
//     (`capability_effects::const_denorm_spans` is not empty)
//   nf, nf x (name, fip, span start, end, ng, ng generic names,
//             np, np x (name, pass, type), result type, effects (a Row
//             type), body root expression + 1 or 0)
//   ne, ne x (kind, span start, end, symbol + 1 or 0, children, size)
//   nc, nc x (span start, end, k, k x (generic name, type))
//   nd, nd x (function, k, k x (dyn generic, trait type))
//   ns, ns stub names
//   nv, nv x (object type, self type, m, m x (method, k, k x (name, type)))
//   nk, nk caller-slot function names
//   nt, nt x (entry name, flags: 1 optimize | 2 trace host | 4 library | 8 more roots)
//
// Expressions are pre-order rows: a node's children follow it, `size` is
// the row count of its subtree, so a pre-order walk is a range walk.

use @vesper/check-data::util::{add, inc, inc32, n32, u32_at, w};
use @vesper/check-data::input::{Ctx, Reader};
use @vesper/check-data::world::{set_by_symbol};

const NONE32: u32 = 4294967295;
// The world flags word's bits.
const WORLD_TRACE_ACTIVE: u64 = 1;
const WORLD_CONST_DENORM: u64 = 2;

// `ExprKind` tags (the encoder's `expr_kind`).
pub enum ExprKind: _ {
    Literal = 0,
    Name = 1,
    Call = 5,
    Field = 6,
}

pub const E_LITERAL: u8 = ExprKind::Literal;
pub const E_NAME: u8 = ExprKind::Name;
pub const E_CALL: u8 = ExprKind::Call;
pub const E_FIELD: u8 = ExprKind::Field;

pub copy struct FnInfo {
    name: u32,
    fip: bool,
    s0: u64,
    s1: u64,
    // generic names: generics[generic_start..generic_start + generic_count]
    generic_start: u32,
    generic_count: u32,
    // params[param_start..param_start + param_count]
    param_start: u32,
    param_count: u32,
    result: u32,
    // the effects row (a row id of the type table)
    row: u32,
    // the body's root expression, or NONE32
    body: u32,
}

pub copy struct ParamInfo {
    name: u32,
    pass: u8,
    ty: u32,
}

pub copy struct ExprNode {
    kind: u8,
    s0: u64,
    s1: u64,
    // Name: the name; Field: the field or method name; else 0
    sym: u32,
    children: u32,
    size: u32,
}

// One `world.calls` entry or one vtable method: pairs[pair_start..pair_start + pair_count].
pub copy struct VarsRow {
    s0: u64,
    s1: u64,
    name: u32,
    pair_start: u32,
    pair_count: u32,
}

pub copy struct VTableRow {
    object: u32,
    self_ty: u32,
    // methods[method_start..method_start + method_count]
    method_start: u32,
    method_count: u32,
}

// The task's flags word: bit 0 optimizes, bit 1 asks for a Beacon trace
// host (`EntryEffects::TraceHost`), bit 2 starts a library whose entry is
// its first export root (`native_export::compile_exports`) and bit 3 adds
// the entry as another root of the library before it.
pub copy struct Task {
    entry: u32,
    optimize: bool,
    trace_host: bool,
    library: bool,
    more_roots: bool,
}

pub struct Calls {
    trace_active: bool,
    // A `ConstDenorm` function or closure exists, so the native walk flushes
    // subnormals somewhere (`capability_effects::const_denorm_spans`).
    const_denorm: bool,
    fns: ChunkSeq[FnInfo],
    generics: ChunkSeq[u32],
    params: ChunkSeq[ParamInfo],
    exprs: ChunkSeq[ExprNode],
    // `world.calls`, sorted by span
    calls: ChunkSeq[VarsRow],
    // `dyn_objects.params`, by function
    dyn_params: ChunkSeq[VarsRow],
    vtables: ChunkSeq[VTableRow],
    methods: ChunkSeq[VarsRow],
    // (key symbol, type) pairs of every VarsRow table
    pair_keys: ChunkSeq[u32],
    pair_tys: ChunkSeq[u32],
    // symbol -> function index + 1
    fn_by_name: ChunkSeq[u32],
    // symbol -> dyn params row + 1
    dyn_by_name: ChunkSeq[u32],
    // symbol -> 1 for vtable stubs, caller-slot functions
    stubs: ChunkSeq[u32],
    caller_slot_fns: ChunkSeq[u32],
    tasks: ChunkSeq[Task],
}

impl Calls {
    pub fn fn_info(in self, i: u32) -> FnInfo {
        match self.fns.try_get(w(i)) {
            Option::Some(info) => info,
            Option::None => FnInfo {
                name: 0,
                fip: false,
                s0: 0,
                s1: 0,
                generic_start: 0,
                generic_count: 0,
                param_start: 0,
                param_count: 0,
                result: 0,
                row: 0,
                body: NONE32
            },
        }
    }

    // The function named `sym` as an index, or NONE32.
    pub fn function(in self, sym: u32) -> u32 {
        let stored = u32_at(in self.fn_by_name, w(sym));
        if stored == 0 {
            NONE32
        } else {
            wrapping_sub(stored, 1)
        }
    }

    pub fn param(in self, i: u64) -> ParamInfo {
        match self.params.try_get(i) {
            Option::Some(param) => param,
            Option::None => ParamInfo { name: 0, pass: 0, ty: 0 },
        }
    }

    pub fn generic(in self, i: u64) -> u32 {
        u32_at(in self.generics, i)
    }

    pub fn expr(in self, i: u64) -> ExprNode {
        match self.exprs.try_get(i) {
            Option::Some(node) => node,
            Option::None => ExprNode {
                kind: ExprKind::Literal,
                s0: 0,
                s1: 0,
                sym: 0,
                children: 0,
                size: 1
            },
        }
    }

    pub fn pair_key(in self, i: u64) -> u32 {
        u32_at(in self.pair_keys, i)
    }

    pub fn pair_ty(in self, i: u64) -> u32 {
        u32_at(in self.pair_tys, i)
    }

    pub fn is_stub(in self, sym: u32) -> bool {
        u32_at(in self.stubs, w(sym)) != 0
    }

    pub fn uses_caller_slot_name(in self, sym: u32) -> bool {
        u32_at(in self.caller_slot_fns, w(sym)) != 0
    }

    pub fn vtable_row(in self, i: u64) -> VTableRow {
        match self.vtables.try_get(i) {
            Option::Some(row) => row,
            Option::None => VTableRow { object: 0, self_ty: 0, method_start: 0, method_count: 0 },
        }
    }

    pub fn method(in self, i: u64) -> VarsRow {
        vars_row(in self.methods, i)
    }

    // The `dyn` parameters of function `sym` (`dyn_objects.params[sym]`), or
    // a row with no pairs.
    pub fn dyn_row(in self, sym: u32) -> VarsRow {
        let stored = u32_at(in self.dyn_by_name, w(sym));
        if stored == 0 {
            return VarsRow { s0: 0, s1: 0, name: sym, pair_start: 0, pair_count: 0 };
        }
        vars_row(in self.dyn_params, w(wrapping_sub(stored, 1)))
    }

    // `world.calls.get(&(s0, s1))`, or a row with no pairs.
    pub fn call_row(in self, s0: u64, s1: u64) -> VarsRow {
        let mut lo: u64 = 0;
        let mut hi = self.calls.len();
        loop {
            if lo >= hi {
                break;
            }
            let mid = wrapping_add(lo, wrapping_sub(hi, lo) / 2);
            let row = vars_row(in self.calls, mid);
            if row.s0 < s0 || (row.s0 == s0 && row.s1 < s1) {
                lo = inc(mid);
            } else {
                hi = mid;
            }
        }
        let row = vars_row(in self.calls, lo);
        if lo < self.calls.len() && row.s0 == s0 && row.s1 == s1 {
            row
        } else {
            VarsRow { s0: s0, s1: s1, name: 0, pair_start: 0, pair_count: 0 }
        }
    }

    pub fn task(in self, i: u64) -> Task {
        match self.tasks.try_get(i) {
            Option::Some(task) => task,
            Option::None => Task {
                entry: 0,
                optimize: false,
                trace_host: false,
                library: false,
                more_roots: false
            },
        }
    }
}

fn vars_row(in rows: ChunkSeq[VarsRow], i: u64) -> VarsRow {
    match rows.try_get(i) {
        Option::Some(row) => row,
        Option::None => VarsRow { s0: 0, s1: 0, name: 0, pair_start: 0, pair_count: 0 },
    }
}

fn sym(in ctx: Ctx, word: u64) -> u32 {
    u32_at(in ctx.nmap, word)
}

fn ty(in ctx: Ctx, word: u64) -> u32 {
    u32_at(in ctx.tmap, word)
}

// `count` (name, type) pairs into the pair tables; returns their start.
fn read_pairs(
    inout reader: Reader,
    in bytes: Slice[u8],
    in ctx: Ctx,
    inout calls: Calls,
    count: u64
) -> u32 {
    let start = n32(calls.pair_keys.len());
    for i in 0..count {
        let key = sym(in ctx, reader.word(in bytes));
        let pair_ty = ty(in ctx, reader.word(in bytes));
        calls.pair_keys.push(key);
        calls.pair_tys.push(pair_ty);
    }
    start
}

fn read_names_into(
    inout reader: Reader,
    in bytes: Slice[u8],
    in ctx: Ctx,
    inout table: ChunkSeq[u32]
) {
    let n = reader.word(in bytes);
    for i in 0..n {
        let name = sym(in ctx, reader.word(in bytes));
        set_by_symbol(inout table, name, 1);
    }
}

// Decodes the calls section; `reader` is left after it.
pub fn read_calls(inout reader: Reader, in bytes: Slice[u8], in ctx: Ctx) -> Calls {
    let mut calls = Calls {
        trace_active: false,
        const_denorm: false,
        fns: ChunkSeq::new[FnInfo](),
        generics: ChunkSeq::new[u32](),
        params: ChunkSeq::new[ParamInfo](),
        exprs: ChunkSeq::new[ExprNode](),
        calls: ChunkSeq::new[VarsRow](),
        dyn_params: ChunkSeq::new[VarsRow](),
        vtables: ChunkSeq::new[VTableRow](),
        methods: ChunkSeq::new[VarsRow](),
        pair_keys: ChunkSeq::new[u32](),
        pair_tys: ChunkSeq::new[u32](),
        fn_by_name: ChunkSeq::new[u32](),
        dyn_by_name: ChunkSeq::new[u32](),
        stubs: ChunkSeq::new[u32](),
        caller_slot_fns: ChunkSeq::new[u32](),
        tasks: ChunkSeq::new[Task](),
    };
    let world_flags = reader.word(in bytes);
    calls.trace_active = world_flags & WORLD_TRACE_ACTIVE != 0;
    calls.const_denorm = world_flags & WORLD_CONST_DENORM != 0;
    let fn_count = reader.word(in bytes);
    for i in 0..fn_count {
        let name = sym(in ctx, reader.word(in bytes));
        let fip = reader.word(in bytes) != 0;
        let s0 = reader.word(in bytes);
        let s1 = reader.word(in bytes);
        let generic_count = reader.word(in bytes);
        let generic_start = n32(calls.generics.len());
        for j in 0..generic_count {
            calls.generics.push(sym(in ctx, reader.word(in bytes)));
        }
        let param_count = reader.word(in bytes);
        let param_start = n32(calls.params.len());
        for j in 0..param_count {
            let param_name = sym(in ctx, reader.word(in bytes));
            let pass = wrapping_u8(reader.word(in bytes));
            let param_ty = ty(in ctx, reader.word(in bytes));
            calls.params.push(ParamInfo { name: param_name, pass: pass, ty: param_ty });
        }
        let result = ty(in ctx, reader.word(in bytes));
        let row_ty = ty(in ctx, reader.word(in bytes));
        let row = ctx.types.node(row_ty).r2;
        let body = reader.word(in bytes);
        let root = if body == 0 {
            NONE32
        } else {
            n32(wrapping_sub(body, 1))
        };
        set_by_symbol(inout calls.fn_by_name, name, inc32(n32(calls.fns.len())));
        calls.fns.push(FnInfo {
            name: name,
            fip: fip,
            s0: s0,
            s1: s1,
            generic_start: generic_start,
            generic_count: n32(generic_count),
            param_start: param_start,
            param_count: n32(param_count),
            result: result,
            row: row,
            body: root
        });
    }
    let expr_count = reader.word(in bytes);
    for i in 0..expr_count {
        let kind = wrapping_u8(reader.word(in bytes));
        let s0 = reader.word(in bytes);
        let s1 = reader.word(in bytes);
        let sym_word = reader.word(in bytes);
        let expr_sym = if sym_word == 0 {
            0
        } else {
            sym(in ctx, wrapping_sub(sym_word, 1))
        };
        let children = n32(reader.word(in bytes));
        let size = n32(reader.word(in bytes));
        calls.exprs.push(ExprNode {
            kind: kind,
            s0: s0,
            s1: s1,
            sym: expr_sym,
            children: children,
            size: size
        });
    }
    let call_count = reader.word(in bytes);
    for i in 0..call_count {
        let s0 = reader.word(in bytes);
        let s1 = reader.word(in bytes);
        let pair_count = reader.word(in bytes);
        let pair_start = read_pairs(inout reader, in bytes, in ctx, inout calls, pair_count);
        calls.calls.push(VarsRow {
            s0: s0,
            s1: s1,
            name: 0,
            pair_start: pair_start,
            pair_count: n32(pair_count)
        });
    }
    let dyn_count = reader.word(in bytes);
    for i in 0..dyn_count {
        let func_sym = sym(in ctx, reader.word(in bytes));
        let pair_count = reader.word(in bytes);
        let pair_start = read_pairs(inout reader, in bytes, in ctx, inout calls, pair_count);
        set_by_symbol(inout calls.dyn_by_name, func_sym, inc32(n32(calls.dyn_params.len())));
        calls.dyn_params.push(VarsRow {
            s0: 0,
            s1: 0,
            name: func_sym,
            pair_start: pair_start,
            pair_count: n32(pair_count)
        });
    }
    read_names_into(inout reader, in bytes, in ctx, inout calls.stubs);
    let vtable_count = reader.word(in bytes);
    for i in 0..vtable_count {
        let object = ty(in ctx, reader.word(in bytes));
        let self_ty = ty(in ctx, reader.word(in bytes));
        let method_count = reader.word(in bytes);
        let method_start = n32(calls.methods.len());
        for j in 0..method_count {
            let method = sym(in ctx, reader.word(in bytes));
            let pair_count = reader.word(in bytes);
            let pair_start = read_pairs(inout reader, in bytes, in ctx, inout calls, pair_count);
            calls.methods.push(VarsRow {
                s0: 0,
                s1: 0,
                name: method,
                pair_start: pair_start,
                pair_count: n32(pair_count)
            });
        }
        calls.vtables.push(VTableRow {
            object: object,
            self_ty: self_ty,
            method_start: method_start,
            method_count: n32(method_count)
        });
    }
    read_names_into(inout reader, in bytes, in ctx, inout calls.caller_slot_fns);
    let task_count = reader.word(in bytes);
    for i in 0..task_count {
        let entry = sym(in ctx, reader.word(in bytes));
        let flags = reader.word(in bytes);
        calls.tasks.push(Task {
            entry: entry,
            optimize: flags & 1 != 0,
            trace_host: flags & 2 != 0,
            library: flags & 4 != 0,
            more_roots: flags & 8 != 0
        });
    }
    calls
}
