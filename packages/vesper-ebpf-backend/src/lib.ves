// @vesper/ebpf-backend: the compiler's eBPF target (src/ebpf_backend.rs,
// src/ebpf_backend/{surface,lower}.rs) in Vesper, on the @vesper/ebpf port
// (self-hosting SH4 lane 16, #1290).
//
// - asm.ves: the part of `vesper_ebpf::Asm` the backend uses (labels,
//   fixups, maps, subprograms, line info).
// - extra.ves: the task section after the Place IR program: options,
//   source, ADT spans, `world.functions` and `world.effects`.
// - backend.ves: `Surface::analyze` and `lower`.
//
// The entry `ebpf_backend_words` reads the harness input (check-data's
// context, the @vesper/place-ir program, the task section) and returns
// the result as words (tests/self_host_ebpf_backend.rs decodes them):
//
// - status 0, the assembled program: action (0 XDP, 1 tc), the program
//   name, n instructions (code | dst << 8 | src << 12 | off << 16 |
//   imm << 32), n maps (name, kind, key, value, max, flags), n map
//   relocations (slot, map), n subprograms (name, slot), n lines (slot,
//   text, line, col), n frames (name, bytes), n loops (name), n map
//   bindings (effect, index);
// - status 1, `Unsupported`: rule, function, has span, s0, s1, message;
// - status 2, `Asm`: message.
//
// A string is its byte count and the bytes packed little-endian into
// words. Verification and ELF emission stay with `vesper_ebpf` (the
// @vesper/ebpf port has both; the harness runs the Rust verifier on the
// decoded program so verifier results are compared as well).

use @vesper/check-data::util::{u32_at, u64_at, u8_at, w};
use @vesper/check-data::names::{Names};
use @vesper/check-data::input::{Reader, read_ctx};
use @vesper/place-ir::{read_program};
use @vesper/ebpf::insn::{RawInsn};
use self::asm::{LineRow, MapRow, slot_at};
use self::extra::{read_extra};
use self::backend::{G, analyze, g_new, lower};
use self::object::{build_object, declined_compile};

fn put_bytes(inout out: ChunkSeq[u64], in bytes: ChunkSeq[u8]) {
    let n = bytes.len();
    out.push(n);
    let mut word: u64 = 0;
    let mut packed: u32 = 0;
    for i in 0..n {
        word = word | wrapping_shl_u64(widen_u64(u8_at(in bytes, i)), wrapping_mul(packed, 8));
        packed = wrapping_add(packed, 1);
        if packed == 8 {
            out.push(word);
            word = 0;
            packed = 0;
        }
    }
    if packed != 0 {
        out.push(word);
    }
}

fn put_sym(inout out: ChunkSeq[u64], in names: Names, symbol: u32) {
    let mut bytes: ChunkSeq[u8] = ChunkSeq::new[u8]();
    names.write(symbol, inout bytes);
    put_bytes(inout out, in bytes);
}

fn put_range(inout out: ChunkSeq[u64], in source: ChunkSeq[u8], start: u64, end: u64) {
    let mut bytes: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for i in start..end {
        bytes.push(u8_at(in source, i));
    }
    put_bytes(inout out, in bytes);
}

fn pack(raw: RawInsn) -> u64 {
    let code = widen_u64(raw.code);
    let regs = wrapping_shl_u64(widen_u64(raw.dst), 8) | wrapping_shl_u64(widen_u64(raw.src), 12);
    let off = wrapping_shl_u64(widen_u64(wrapping_u16(raw.off)), 16);
    let imm = wrapping_shl_u64(widen_u64(wrapping_u32(raw.imm)), 32);
    code | regs | off | imm
}

fn put_ok(inout out: ChunkSeq[u64], in backend: G, in names: Names, in source: ChunkSeq[u8]) {
    out.push(0);
    out.push(widen_u64(backend.action));
    put_bytes(inout out, in backend.name);

    out.push(backend.asm.slots.len());
    for i in 0..backend.asm.slots.len() {
        out.push(pack(slot_at(in backend.asm.slots, i)));
    }
    out.push(backend.asm.maps.len());
    for i in 0..backend.asm.maps.len() {
        match backend.asm.maps.try_get(i) {
            Option::Some(map_row) => {
                put_sym(inout out, in names, map_row.name);
                out.push(widen_u64(map_row.kind));
                out.push(w(map_row.key));
                out.push(w(map_row.value));
                out.push(w(map_row.max));
                out.push(w(map_row.flags));
            },
            Option::None => (),
        }
    }
    let reloc_count = backend.asm.relocs.len() / 2;
    out.push(reloc_count);
    for i in 0..wrapping_mul(reloc_count, 2) {
        out.push(u64_at(in backend.asm.relocs, i));
    }
    out.push(backend.asm.fn_names.len());
    for i in 0..backend.asm.fn_names.len() {
        put_sym(inout out, in names, u32_at(in backend.asm.fn_names, i));
        out.push(backend.asm.resolve(u64_at(in backend.asm.fn_labels, i)));
    }
    out.push(backend.asm.lines.len());
    for i in 0..backend.asm.lines.len() {
        match backend.asm.lines.try_get(i) {
            Option::Some(line_row) => {
                out.push(line_row.slot);
                put_range(inout out, in source, line_row.text_start, line_row.text_end);
                out.push(w(line_row.line));
                out.push(w(line_row.col));
            },
            Option::None => (),
        }
    }
    out.push(backend.functions.len());
    for i in 0..backend.functions.len() {
        put_sym(inout out, in names, u32_at(in backend.functions, i));
        out.push(w(u32_at(in backend.frames, i)));
    }
    out.push(backend.loops.len());
    for i in 0..backend.loops.len() {
        put_sym(inout out, in names, u32_at(in backend.loops, i));
    }
    out.push(backend.map_effects.len());
    for i in 0..backend.map_effects.len() {
        put_sym(inout out, in names, u32_at(in backend.map_effects, i));
        out.push(i);
    }
}

fn put_err(inout out: ChunkSeq[u64], in backend: G, in names: Names) {
    out.push(widen_u64(backend.err));
    if backend.err == 1 {
        out.push(widen_u64(backend.err_rule));
        put_sym(inout out, in names, backend.err_fn);
        out.push(if backend.err_has_span { 1 } else { 0 });
        out.push(backend.err_s0);
        out.push(backend.err_s1);
    }
    put_bytes(inout out, in backend.message);
}

// The harness entry: input bytes to result words.
pub fn ebpf_backend_bytes(in bytes: Slice[u8]) -> ChunkSeq[u64] {
    let mut reader = Reader { pos: 0 };
    let mut ctx = read_ctx(inout reader, in bytes);
    let program = read_program(inout reader, in bytes, in ctx);
    let extra = read_extra(inout reader, in bytes, inout ctx.types, inout ctx.names);
    let mut backend = g_new();
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    if analyze(inout backend, inout ctx, in program, in extra)
        && lower(inout backend, inout ctx, in program, in extra) {
        put_ok(inout out, in backend, in ctx.names, in extra.source);
    } else {
        put_err(inout out, in backend, in ctx.names);
    }
    out
}

// The harness entry: input words to result words.
pub fn ebpf_backend_words(in input: Str) -> ChunkSeq[u64] {
    ebpf_backend_bytes(in input.as_bytes())
}

// `vesper build --target bpf` in the Vesper driver (#1895): compile,
// verify and write the ELF object (object.ves). 0 with the object in
// `object` and the summary after "wrote <path> (<n> bytes): " in `tail`,
// or nonzero when Rust should build it (a compile error or anything the
// Rust pass reports in its own words).
pub fn ebpf_backend_build(
    in bytes: Slice[u8],
    inout object: ChunkSeq[u8],
    inout tail: ChunkSeq[u8]
) -> u64 {
    let mut reader = Reader { pos: 0 };
    let mut ctx = read_ctx(inout reader, in bytes);
    let program = read_program(inout reader, in bytes, in ctx);
    let extra = read_extra(inout reader, in bytes, inout ctx.types, inout ctx.names);
    let mut backend = g_new();
    if analyze(inout backend, inout ctx, in program, in extra)
        && lower(inout backend, inout ctx, in program, in extra) {
        build_object(in backend, in ctx.names, in extra, inout object, inout tail)
    } else {
        declined_compile()
    }
}
