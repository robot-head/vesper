// Module backend of @vesper/ebpf-backend (see lib.ves): src/ebpf_backend/
// surface.rs (`Surface::analyze`, the effect and map recognition and
// `map_spec`) and src/ebpf_backend/lower.rs (`lower`, `FnLower`), over
// the @vesper/place-ir tables and the task section of extra.ves.
//
// One state `G` holds the surface, the assembler, the outputs and the
// per-function lowering tables (reset for each function). A step that
// fails records the Rust `EbpfBackendError` in `G` (rule, function, span,
// message) and returns false; its caller returns false at once, so the
// first error is the one Rust returns.
//
// Value-indexed tables (locations, representations, types, definition
// blocks) are dense arrays over the function's value ids. A `Repr` is one
// byte: 0 Unit, 1 + s a scalar, 6 a field-less enum, 7 + s `Option` of a
// scalar, where s is 0 u8, 1 u32, 2 u64, 3 i64, 4 bool.

use @vesper/place-ir::codes::{Lit, Op, Pat, Term};
use @vesper/check-data::util::{add, inc, inc32, n32, push_decimal, u32_at, u64_at, u8_at, w};
use @vesper/check-data::names::{Names};
use @vesper/check-data::types::{Types, default_type, display, TyKind, TyPass};
use @vesper/check-data::world::{Adt, Variant, World, set_by_symbol};
use @vesper/check-data::input::{Ctx};
use @vesper/place-ir::{BlockRow, FnRow, InstRow, Program};
use @vesper/ebpf::insn::{AluOp, Endian, JmpOp, Operand, Size};
use @vesper/ebpf::program::{ProgramType};
use @vesper/ebpf::helpers::{allowed};
use self::asm::{Asm, MapRow, asm_new, slot_off};
use self::extra::{Extra, XEff, XFn, XOp, XParam};

const NONE32: u32 = 4294967295;
const NONE64: u64 = 18446744073709551615;

// Rule ids (`ebpf_backend::rules`), in this order on the Rust side.
const R_ENTRY: u8 = 0;
const R_ACTION: u8 = 1;
const R_TYPE: u8 = 2;
const R_EFFECT: u8 = 3;
const R_MAP: u8 = 4;
const R_RECURSION: u8 = 5;
const R_OPERATION: u8 = 6;
const R_FALLIBLE: u8 = 7;
const R_CALL: u8 = 8;
const R_STACK: u8 = 9;
const R_GENERIC: u8 = 10;

// Error kinds of `G.err`.
const E_UNSUPPORTED: u8 = 1;
const E_ASM: u8 = 2;

// Scalars and representations.
const S_U8: u8 = 0;
const S_U32: u8 = 1;
const S_U64: u8 = 2;
const S_I64: u8 = 3;
const S_BOOL: u8 = 4;
const S_NONE: u8 = 255;
const REP_UNIT: u8 = 0;
const REP_SCALAR: u8 = 1;
const REP_ENUM: u8 = 6;
const REP_OPT: u8 = 7;
const REP_BAD: u8 = 255;

// Locations.
const L_UNDEF: u8 = 0;
const L_NONE: u8 = 1;
const L_IMM: u8 = 2;
const L_SLOT: u8 = 3;

// Effect operation kinds and their parts.
const EO_PACKET: u8 = 1;
const EO_HELPER: u8 = 2;
const EO_MAP: u8 = 3;
const PK_U8: u8 = 0;
const PK_U16: u8 = 1;
const PK_U32: u8 = 2;
const MO_LOOKUP: u8 = 0;
const MO_UPDATE: u8 = 1;
const MO_DELETE: u8 = 2;
const MO_ADD: u8 = 3;
const MK_HASH: u8 = 0;
const MK_ARRAY: u8 = 1;
const MK_PERCPU_HASH: u8 = 2;
const MK_PERCPU_ARRAY: u8 = 3;
const MK_LRU_HASH: u8 = 4;

// Helper ids (`vesper_ebpf::helpers`).
const H_LOOKUP: i32 = 1;
const H_UPDATE: i32 = 2;
const H_DELETE: i32 = 3;
const H_KTIME: i32 = 5;
const H_PRANDOM: i32 = 7;
const H_SMP: i32 = 8;

// `MAX_PACKET_OFF`, `BPF_MAX_STACK_BYTES`, the BPF map flags and the map
// validation bounds (`MapDef::validate`).
const MAX_PACKET_OFF: i64 = 65535;
const MAX_STACK: u32 = 512;
const BPF_ANY: i32 = 0;
const BPF_NOEXIST: i32 = 1;
const OBJ_NAME_LEN: u64 = 16;
const MAX_KEY: u32 = 512;
const MAX_VALUE: u32 = 1048576;
const FRAME_ALIGN: u32 = 32;
const ARG_REGS: u64 = 4;

// Registers.
const R0: u8 = 0;
const R1: u8 = 1;
const R2: u8 = 2;
const R3: u8 = 3;
const R4: u8 = 4;
const R9: u8 = 9;
const R10: u8 = 10;

// A recognised effect operation (`EffectOp`).
pub copy struct EOp {
    kind: u8,
    // packet view, helper id, or map index / op / key / value / map kind
    packet: u8,
    helper: i32,
    map: u64,
    map_op: u8,
    key: u8,
    value: u8,
    map_kind: u8,
}

// A parameter of the function being lowered (its IR header).
pub copy struct PInfo {
    name: u32,
    pass: u8,
    proj_count: u64,
    ty: u32,
    s0: u64,
    s1: u64,
}

pub struct G {
    // the first error
    err: u8,
    err_rule: u8,
    err_fn: u32,
    err_has_span: bool,
    err_s0: u64,
    err_s1: u64,
    message: ChunkSeq[u8],
    // program function symbol -> program fn index + 1
    ir_by_name: ChunkSeq[u32],
    // surface
    action: u8,
    map_defs: ChunkSeq[MapRow],
    map_effects: ChunkSeq[u32],
    eops: ChunkSeq[EOp],
    // callee symbol -> eops index + 1
    eop_by_callee: ChunkSeq[u32],
    // effect symbol -> 1 once recognised
    registered: ChunkSeq[u32],
    functions: ChunkSeq[u32],
    // lowering outputs
    asm: Asm,
    fn_label: ChunkSeq[u64],
    // function symbol -> index in `functions` + 1
    fn_pos: ChunkSeq[u32],
    frames: ChunkSeq[u32],
    loops: ChunkSeq[u32],
    // the call graph without tail self-calls: function k's callees, sorted
    // by name, are callees[callee_starts[k]..callee_starts[k]+callee_counts[k]]
    callees: ChunkSeq[u32],
    callee_starts: ChunkSeq[u64],
    callee_counts: ChunkSeq[u64],
    // tail self-call dests: tails[tail_starts[k]..tail_starts[k]+tail_counts[k]]
    tails: ChunkSeq[u32],
    tail_starts: ChunkSeq[u64],
    tail_counts: ChunkSeq[u64],
    // line table (`LineTable`): the start of every line
    line_starts: ChunkSeq[u64],
    // the program name
    name: ChunkSeq[u8],
    // ----- the function being lowered (`FnLower`)
    f_index: u64,
    f_name: u32,
    f_entry: bool,
    f_has_span: bool,
    f_s0: u64,
    f_s1: u64,
    f_result: u32,
    params: ChunkSeq[PInfo],
    block_labels: ChunkSeq[u64],
    loop_head: u64,
    value_count: u64,
    value_types: ChunkSeq[u32],
    loc_kinds: ChunkSeq[u8],
    loc_values: ChunkSeq[u64],
    reprs: ChunkSeq[u8],
    def_block: ChunkSeq[u64],
    use_min: ChunkSeq[u64],
    use_max: ChunkSeq[u64],
    is_tail: ChunkSeq[bool],
    last_use_inst: ChunkSeq[u64],
    last_use_block: ChunkSeq[u64],
    local_names: ChunkSeq[u32],
    local_slot: ChunkSeq[u32],
    local_rep: ChunkSeq[u8],
    // local symbol -> local index + 1
    local_by_name: ChunkSeq[u32],
    key_slot: u32,
    val_slot: u32,
    slot_count: u32,
    last_line: u32,
    uses: ChunkSeq[u32],
    free_slot: ChunkSeq[u32],
    free_size: ChunkSeq[u32],
}

pub fn g_new() -> G {
    G {
        err: 0,
        err_rule: 0,
        err_fn: 0,
        err_has_span: false,
        err_s0: 0,
        err_s1: 0,
        message: ChunkSeq::new[u8](),
        ir_by_name: ChunkSeq::new[u32](),
        action: 0,
        map_defs: ChunkSeq::new[MapRow](),
        map_effects: ChunkSeq::new[u32](),
        eops: ChunkSeq::new[EOp](),
        eop_by_callee: ChunkSeq::new[u32](),
        registered: ChunkSeq::new[u32](),
        functions: ChunkSeq::new[u32](),
        asm: asm_new(),
        fn_label: ChunkSeq::new[u64](),
        fn_pos: ChunkSeq::new[u32](),
        frames: ChunkSeq::new[u32](),
        loops: ChunkSeq::new[u32](),
        callees: ChunkSeq::new[u32](),
        callee_starts: ChunkSeq::new[u64](),
        callee_counts: ChunkSeq::new[u64](),
        tails: ChunkSeq::new[u32](),
        tail_starts: ChunkSeq::new[u64](),
        tail_counts: ChunkSeq::new[u64](),
        line_starts: ChunkSeq::new[u64](),
        name: ChunkSeq::new[u8](),
        f_index: 0,
        f_name: 0,
        f_entry: false,
        f_has_span: false,
        f_s0: 0,
        f_s1: 0,
        f_result: 0,
        params: ChunkSeq::new[PInfo](),
        block_labels: ChunkSeq::new[u64](),
        loop_head: 0,
        value_count: 0,
        value_types: ChunkSeq::new[u32](),
        loc_kinds: ChunkSeq::new[u8](),
        loc_values: ChunkSeq::new[u64](),
        reprs: ChunkSeq::new[u8](),
        def_block: ChunkSeq::new[u64](),
        use_min: ChunkSeq::new[u64](),
        use_max: ChunkSeq::new[u64](),
        is_tail: ChunkSeq::new[bool](),
        last_use_inst: ChunkSeq::new[u64](),
        last_use_block: ChunkSeq::new[u64](),
        local_names: ChunkSeq::new[u32](),
        local_slot: ChunkSeq::new[u32](),
        local_rep: ChunkSeq::new[u8](),
        local_by_name: ChunkSeq::new[u32](),
        key_slot: 0,
        val_slot: 0,
        slot_count: 0,
        last_line: 0,
        uses: ChunkSeq::new[u32](),
        free_slot: ChunkSeq::new[u32](),
        free_size: ChunkSeq::new[u32](),
    }
}

// ----- small helpers ------------------------------------------------------------

fn txt(inout message: ChunkSeq[u8], in text: Str) {
    message.extend(in text.as_bytes());
}

fn sym(inout message: ChunkSeq[u8], in names: Names, symbol: u32) {
    names.write(symbol, inout message);
}

fn is(in names: Names, symbol: u32, in lit: Str) -> bool {
    names.spells(symbol, in lit.as_bytes())
}

fn intern(inout names: Names, in lit: Str) -> u32 {
    names.intern(in lit.as_bytes())
}

fn bool_at(in seq: ChunkSeq[bool], i: u64) -> bool {
    match seq.try_get(i) {
        Option::Some(value) => value,
        Option::None => false,
    }
}

fn set8(inout seq: ChunkSeq[u8], i: u64, value: u8) {
    let ok = seq.try_set(i, value);
}

fn set32(inout seq: ChunkSeq[u32], i: u64, value: u32) {
    let ok = seq.try_set(i, value);
}

fn set64(inout seq: ChunkSeq[u64], i: u64, value: u64) {
    let ok = seq.try_set(i, value);
}

// Records the first error (`unsupported(rule, function, span, ...)`); the
// caller appends the message.
fn fail(inout backend: G, rule: u8, function: u32, has_span: bool, s0: u64, s1: u64) {
    backend.err = E_UNSUPPORTED;
    backend.err_rule = rule;
    backend.err_fn = function;
    backend.err_has_span = has_span;
    backend.err_s0 = s0;
    backend.err_s1 = s1;
    backend.message.clear();
}

fn fail_asm(inout backend: G) {
    backend.err = E_ASM;
    backend.message.clear();
}

// The last `::` segment of `symbol` (`rsplit("::").next()`), as bytes.
fn last_segment(in names: Names, symbol: u32, inout out: ChunkSeq[u8]) {
    out.clear();
    let n = names.size(symbol);
    let mut start: u64 = 0;
    let mut i: u64 = 0;
    loop {
        if wrapping_add(i, 1) >= n {
            break;
        }
        if names.byte(symbol, i) == 58 && names.byte(symbol, inc(i)) == 58 {
            start = add(i, 2);
            i = add(i, 2);
        } else {
            i = inc(i);
        }
    }
    for k in start..n {
        out.push(names.byte(symbol, k));
    }
}

fn last_is(in names: Names, symbol: u32, in lit: Str) -> bool {
    let mut seg: ChunkSeq[u8] = ChunkSeq::new[u8]();
    last_segment(in names, symbol, inout seg);
    let want = lit.as_bytes();
    if seg.len() != want.len() {
        return false;
    }
    for i in 0..want.len() {
        let want_byte = match want.try_get(i) {
            Option::Some(byte) => byte,
            Option::None => 0,
        };
        if u8_at(in seg, i) != want_byte {
            return false;
        }
    }
    true
}

// Byte order of two names (`str` order): -1, 0 or 1.
fn name_cmp(in names: Names, a: u32, b: u32) -> i64 {
    let a_len = names.size(a);
    let b_len = names.size(b);
    let n = if a_len < b_len { a_len } else { b_len };
    for i in 0..n {
        let a_byte = names.byte(a, i);
        let b_byte = names.byte(b, i);
        if a_byte < b_byte {
            return -1;
        }
        if a_byte > b_byte {
            return 1;
        }
    }
    if a_len < b_len {
        -1
    } else if a_len > b_len {
        1
    } else {
        0
    }
}

// The decimal text of a 128-bit two's-complement integer (lo, hi words).
fn push_i128(inout message: ChunkSeq[u8], lo: u64, hi: u64) {
    let neg = (hi >> 63) != 0;
    let mut abs_lo = lo;
    let mut abs_hi = hi;
    if neg {
        abs_lo = wrapping_sub(0, lo);
        abs_hi = if lo == 0 {
            wrapping_sub(0, hi)
        } else {
            wrapping_sub(NONE64, hi)
        };
        message.push(45);
    }
    if abs_hi == 0 {
        push_decimal(inout message, abs_lo);
        return;
    }
    // four 32-bit limbs, divided by ten until zero
    let mut limbs: ChunkSeq[u64] = ChunkSeq::new[u64]();
    limbs.push(abs_hi >> 32);
    limbs.push(abs_hi & 4294967295);
    limbs.push(abs_lo >> 32);
    limbs.push(abs_lo & 4294967295);
    let mut digits: ChunkSeq[u8] = ChunkSeq::new[u8]();
    loop {
        let mut zero = true;
        let mut rem: u64 = 0;
        for i in 0..4 {
            let dividend = wrapping_add(wrapping_shl_u64(rem, 32), u64_at(in limbs, i));
            let quotient = dividend / 10;
            rem = dividend % 10;
            set64(inout limbs, i, quotient);
            if quotient != 0 {
                zero = false;
            }
        }
        digits.push(wrapping_u8(wrapping_add(rem, 48)));
        if zero {
            break;
        }
    }
    let n = digits.len();
    for i in 0..n {
        message.push(u8_at(in digits, wrapping_sub(wrapping_sub(n, 1), i)));
    }
}

// ----- the Place IR tables --------------------------------------------------------

fn pop(in program: Program, i: u64) -> u64 {
    program.op(i)
}

fn pos32(in program: Program, i: u64) -> u32 {
    n32(program.op(i))
}

// The word just past the pattern at `at` (place-ir's pattern layout).
fn pat_end(in program: Program, at: u64) -> u64 {
    let kind = program.op(at);
    let body_at = add(at, 3);
    if kind == Pat::Bind {
        return inc(body_at);
    }
    if kind == Pat::Literal {
        return add(body_at, 3);
    }
    if kind == Pat::Tuple {
        let n = program.op(body_at);
        let mut next_at = inc(body_at);
        for i in 0..n {
            next_at = pat_end(in program, next_at);
        }
        return next_at;
    }
    if kind == Pat::Constructor {
        let n = program.op(add(body_at, 2));
        let mut next_at = add(body_at, 3);
        for i in 0..n {
            next_at = pat_end(in program, inc(next_at));
        }
        return next_at;
    }
    body_at
}

// The values `op` reads (`op_uses`), into `out`.
fn op_uses(in program: Program, inst: InstRow, inout out: ChunkSeq[u32]) {
    out.clear();
    let operand_at = inst.a;
    let op = inst.op;
    if op == Op::Bind {
        out.push(pos32(in program, operand_at));
    } else if op == Op::Write {
        out.push(pos32(in program, add(operand_at, 2)));
    } else if op == Op::Unary {
        out.push(pos32(in program, inc(operand_at)));
    } else if op == Op::Try || op == Op::Exit || op == Op::Project {
        out.push(pos32(in program, operand_at));
    } else if op == Op::Binary {
        out.push(pos32(in program, inc(operand_at)));
        out.push(pos32(in program, add(operand_at, 2)));
    } else if op == Op::Index {
        out.push(pos32(in program, operand_at));
        out.push(pos32(in program, inc(operand_at)));
    } else if op == Op::Tuple {
        let n = program.op(operand_at);
        for k in 0..n {
            out.push(pos32(in program, add(inc(operand_at), k)));
        }
    } else if op == Op::Vector {
        let n = program.op(inc(operand_at));
        for k in 0..n {
            out.push(pos32(in program, add(add(operand_at, 2), k)));
        }
    } else if op == Op::Data {
        let n = program.op(inc(operand_at));
        for k in 0..n {
            out.push(pos32(in program, add(add(operand_at, 3), wrapping_mul(k, 2))));
        }
    } else if op == Op::Call || op == Op::Tiled || op == Op::Seq || op == Op::Fip {
        args_values(in program, inc(operand_at), inout out);
    } else if op == Op::Indirect {
        out.push(pos32(in program, operand_at));
        args_values(in program, inc(operand_at), inout out);
    } else if op == Op::Handle {
        if program.op(operand_at) != 0 {
            out.push(pos32(in program, inc(operand_at)));
        }
    }
}

// Argument values of the argument list at `at` (n, n x 4 words).
fn args_values(in program: Program, at: u64, inout out: ChunkSeq[u32]) {
    let n = program.op(at);
    for k in 0..n {
        out.push(pos32(in program, add(at, add(2, wrapping_mul(k, 4)))));
    }
}

// The values a terminator reads (`term_uses`), into `out`.
fn term_uses(in program: Program, block: BlockRow, inout out: ChunkSeq[u32]) {
    out.clear();
    let term_at = block.ta;
    if block.term == Term::Return || block.term == Term::Branch || block.term == Term::Match {
        out.push(pos32(in program, term_at));
    } else if block.term == Term::Jump {
        let n = program.op(inc(term_at));
        for k in 0..n {
            out.push(pos32(in program, add(add(term_at, 2), k)));
        }
    }
}

// Block parameter `k` of `block`, and their count.
fn block_nparams(in program: Program, block: BlockRow) -> u64 {
    let token_count = program.op(inc(block.ha));
    program.op(add(block.ha, add(3, wrapping_mul(token_count, 2))))
}

fn block_param(in program: Program, block: BlockRow, k: u64) -> u32 {
    let token_count = program.op(inc(block.ha));
    pos32(in program, add(add(block.ha, add(4, wrapping_mul(token_count, 2))), k))
}

fn fn_block(in program: Program, func: FnRow, block_index: u64) -> BlockRow {
    program.block(add(func.b0, block_index))
}

fn block_inst(in program: Program, block: BlockRow, k: u64) -> InstRow {
    program.inst(add(block.i0, k))
}

// The program function `name`: its index + 1, or 0.
fn ir_index(in backend: G, name: u32) -> u64 {
    w(u32_at(in backend.ir_by_name, w(name)))
}

// ----- types ---------------------------------------------------------------------

// `Scalar::of`.
fn scalar_of(inout ctx: Ctx, ty: u32) -> u8 {
    let defaulted = default_type(inout ctx.types, ty);
    let node = ctx.types.node(defaulted);
    if node.kind != TyKind::Named || node.n != 0 {
        return S_NONE;
    }
    let known = ctx.world.k;
    if node.name == known.u8_ {
        S_U8
    } else if node.name == known.u32_ {
        S_U32
    } else if node.name == known.u64_ {
        S_U64
    } else if node.name == known.i64_ {
        S_I64
    } else if node.name == known.bool_ {
        S_BOOL
    } else {
        S_NONE
    }
}

fn map_bytes(scalar: u8) -> u32 {
    if scalar == S_U8 {
        1
    } else if scalar == S_U32 {
        4
    } else if scalar == S_U64 {
        8
    } else {
        0
    }
}

fn rep_slots(rep: u8) -> u32 {
    if rep == REP_UNIT {
        0
    } else if rep >= REP_OPT {
        2
    } else {
        1
    }
}

fn is_named(in types: Types, ty: u32, name: u32, arity: u32) -> bool {
    let node = types.node(ty);
    node.kind == TyKind::Named && node.name == name && node.n == arity
}

// `named(t, "Unit")` or the empty tuple.
fn is_unit_type(in ctx: Ctx, ty: u32) -> bool {
    let node = ctx.types.node(ty);
    (node.kind == TyKind::Tuple && node.n == 0)
        || (node.kind == TyKind::Named && node.n == 0 && node.name == ctx.world.k.unit)
}

// `option_of`: the argument of `Option[T]`, or NONE32.
fn option_of(in ctx: Ctx, in names: Names, ty: u32) -> u32 {
    let node = ctx.types.node(ty);
    if node.kind == TyKind::Named && node.n == 1 && is(in names, node.name, "Option") {
        ctx.types.arg(ty, 0)
    } else {
        NONE32
    }
}

// `Type::name` as a symbol (0, the empty name, for other kinds).
fn type_name(in ctx: Ctx, ty: u32) -> u32 {
    ctx.types.name(ty)
}

// `repr` without its error: the representation, or REP_BAD.
fn repr_of(inout ctx: Ctx, ty: u32) -> u8 {
    let defaulted = default_type(inout ctx.types, ty);
    let scalar = scalar_of(inout ctx, defaulted);
    if scalar != S_NONE {
        return add8(REP_SCALAR, scalar);
    }
    let node = ctx.types.node(defaulted);
    if node.kind == TyKind::Tuple && node.n == 0 {
        return REP_UNIT;
    }
    if node.kind == TyKind::Named
        && node.n == 0
        && (node.name == ctx.world.k.unit || node.name == ctx.world.k.never) {
        return REP_UNIT;
    }
    if node.kind == TyKind::Named && node.n == 1 && is(in ctx.names, node.name, "Option") {
        let arg_ty = ctx.types.arg(defaulted, 0);
        let arg_scalar = scalar_of(inout ctx, arg_ty);
        if arg_scalar != S_NONE {
            return add8(REP_OPT, arg_scalar);
        }
        return REP_BAD;
    }
    if node.kind == TyKind::Named && node.n == 0 {
        let adt_id = ctx.world.lookup(node.name);
        if adt_id != NONE32 {
            let adt = ctx.world.adt(adt_id);
            if adt.is_enum && adt.gn == 0 && fieldless(in ctx.world, adt) {
                return REP_ENUM;
            }
        }
    }
    REP_BAD
}

fn add8(a: u8, b: u8) -> u8 {
    wrapping_add(a, b)
}

fn fieldless(in world: World, adt: Adt) -> bool {
    for i in 0..w(adt.vn) {
        if world.variant(add(w(adt.va), i)).fc != 0 {
            return false;
        }
    }
    true
}

// `repr`: the representation of `ty`, or the TYPE error (REP_BAD).
fn repr(
    inout backend: G,
    inout ctx: Ctx,
    ty: u32,
    function: u32,
    has_span: bool,
    s0: u64,
    s1: u64
) -> u8 {
    let rep = repr_of(inout ctx, ty);
    if rep == REP_BAD {
        let defaulted = default_type(inout ctx.types, ty);
        fail(inout backend, R_TYPE, function, has_span, s0, s1);
        txt(inout backend.message, "type `");
        display(in ctx.types, in ctx.names, defaulted, inout backend.message);
        txt(
            inout backend.message,
            "` is outside the eBPF subset (u8, u32, u64, i64, bool, Unit, field-less enums, Option of a scalar)"
        );
    }
    rep
}

// `variant_tag`: the tag of variant `name` (its last segment) of the enum
// `ty`, or -1.
fn variant_tag(inout ctx: Ctx, ty: u32, name: u32) -> i64 {
    let defaulted = default_type(inout ctx.types, ty);
    let adt_name = type_name(in ctx, defaulted);
    let adt_id = ctx.world.lookup(adt_name);
    if adt_id == NONE32 {
        return -1;
    }
    let adt = ctx.world.adt(adt_id);
    let mut seg: ChunkSeq[u8] = ChunkSeq::new[u8]();
    last_segment(in ctx.names, name, inout seg);
    let variant_sym = ctx.names.lookup(in seg.as_slice());
    if variant_sym == NONE32 {
        return -1;
    }
    for i in 0..w(adt.vn) {
        if ctx.world.variant(add(w(adt.va), i)).name == variant_sym {
            return wrapping_i64(i);
        }
    }
    - 1
}

// ----- the surface (`Surface::analyze`) ------------------------------------------

fn snake(in names: Names, symbol: u32, inout out: ChunkSeq[u8]) {
    let n = names.size(symbol);
    for i in 0..n {
        let ch = names.byte(symbol, i);
        if ch >= 65 && ch <= 90 {
            if i > 0 {
                out.push(95);
            }
            out.push(wrapping_add(ch, 32));
        } else {
            out.push(ch);
        }
    }
}

fn eop_index(in backend: G, callee: u32) -> u64 {
    w(u32_at(in backend.eop_by_callee, w(callee)))
}

fn eop_at(in backend: G, i: u64) -> EOp {
    match backend.eops.try_get(i) {
        Option::Some(e) => e,
        Option::None => EOp {
            kind: 0,
            packet: 0,
            helper: 0,
            map: 0,
            map_op: 0,
            key: 0,
            value: 0,
            map_kind: 0
        },
    }
}

fn add_eop(inout backend: G, inout names: Names, eff: u32, op: u32, eop: EOp) {
    let mut key: ChunkSeq[u8] = ChunkSeq::new[u8]();
    names.write(eff, inout key);
    key.push(58);
    key.push(58);
    names.write(op, inout key);
    let key_sym = names.intern(in key.as_slice());
    let existing = eop_index(in backend, key_sym);
    if existing != 0 {
        let ok = backend.eops.try_set(wrapping_sub(existing, 1), eop);
    } else {
        set_by_symbol(inout backend.eop_by_callee, key_sym, inc32(n32(backend.eops.len())));
        backend.eops.push(eop);
    }
}

fn prog_type(backend: G) -> ProgramType {
    if backend.action == 0 {
        ProgramType::Xdp
    } else {
        ProgramType::SchedCls
    }
}

fn op_param(in extra: Extra, op: XOp, k: u64) -> u32 {
    u32_at(in extra.op_params, add(op.param_start, k))
}

// `Surface::analyze`.
pub fn analyze(inout backend: G, inout ctx: Ctx, in program: Program, in extra: Extra) -> bool {
    for i in 0..program.fn_count() {
        set_by_symbol(inout backend.ir_by_name, program.function(i).name, inc32(n32(i)));
    }
    let entry = extra.entry;
    let entry_index = extra.fn_index(entry);
    if entry_index == 0 {
        fail(inout backend, R_ENTRY, entry, false, 0, 0);
        txt(inout backend.message, "entry function `");
        sym(inout backend.message, in ctx.names, entry);
        txt(inout backend.message, "` not found");
        return false;
    }
    let entry_fn = extra.func(wrapping_sub(entry_index, 1));
    if entry_fn.param_count != 0 {
        fail(inout backend, R_ENTRY, entry, true, entry_fn.s0, entry_fn.s1);
        txt(
            inout backend.message,
            "an eBPF entry takes no parameters; packet bytes are read through the `Packet` effect"
        );
        return false;
    }
    let result_name = type_name(in ctx, entry_fn.result);
    if is(in ctx.names, result_name, "XdpAction") {
        backend.action = 0;
    } else if is(in ctx.names, result_name, "TcAction") {
        backend.action = 1;
    } else {
        fail(inout backend, R_ENTRY, entry, true, entry_fn.s0, entry_fn.s1);
        txt(
            inout backend.message,
            "an eBPF entry returns `XdpAction` (XDP) or `TcAction` (tc), not `"
        );
        if ctx.names.size(result_name) == 0 {
            display(in ctx.types, in ctx.names, entry_fn.result, inout backend.message);
        } else {
            sym(inout backend.message, in ctx.names, result_name);
        }
        backend.message.push(96);
        return false;
    }
    if !check_action(inout backend, inout ctx, in extra, result_name) {
        return false;
    }
    // Reachable functions, entry first (depth-first order).
    let mut seen: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut stack: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut found: ChunkSeq[u32] = ChunkSeq::new[u32]();
    stack.push(entry);
    loop {
        let name = match stack.pop() {
            Option::Some(n) => n,
            Option::None => {
                break;
            },
        };
        if u32_at(in seen, w(name)) != 0 {
            continue;
        }
        set_by_symbol(inout seen, name, 1);
        let world_index = extra.fn_index(name);
        let func = extra.func(wrapping_sub(world_index, 1));
        if func.generic_count != 0 {
            fail(inout backend, R_GENERIC, name, true, func.s0, func.s1);
            txt(
                inout backend.message,
                "generic functions are not monomorphised for the eBPF target"
            );
            return false;
        }
        for k in 0..func.eff_count {
            let eff_name = u32_at(in extra.eff_names, add(func.eff_start, k));
            if !effect_rule(inout backend, inout ctx, in program, in extra, name, eff_name) {
                return false;
            }
        }
        if func.tail {
            fail(inout backend, R_EFFECT, name, true, func.s0, func.s1);
            txt(inout backend.message, "open effect rows are not supported on the eBPF target");
            return false;
        }
        backend.functions.push(name);
        let ir_pos = ir_index(in backend, name);
        if ir_pos == 0 {
            fail(inout backend, R_OPERATION, name, true, func.s0, func.s1);
            txt(inout backend.message, "function has no body");
            return false;
        }
        let ir_fn = program.function(wrapping_sub(ir_pos, 1));
        found.clear();
        for block_index in 0..ir_fn.bc {
            let block = fn_block(in program, ir_fn, block_index);
            for k in 0..block.ic {
                let inst = block_inst(in program, block, k);
                if inst.op != Op::Call {
                    continue;
                }
                let callee = pos32(in program, inst.a);
                if ir_index(in backend, callee) != 0 {
                    found.push(callee);
                    continue;
                }
                let eff = effect_prefix(inout ctx.names, callee);
                if eff != NONE32 && extra.decl_index(eff) != 0 {
                    if !effect_rule(inout backend, inout ctx, in program, in extra, name, eff) {
                        return false;
                    }
                    if eop_index(in backend, callee) == 0 {
                        fail(inout backend, R_EFFECT, name, true, inst.s0, inst.s1);
                        backend.message.push(96);
                        sym(inout backend.message, in ctx.names, callee);
                        txt(inout backend.message, "` has no eBPF lowering");
                        return false;
                    }
                } else {
                    fail(inout backend, R_OPERATION, name, true, inst.s0, inst.s1);
                    txt(inout backend.message, "call of `");
                    sym(inout backend.message, in ctx.names, callee);
                    txt(inout backend.message, "` has no eBPF lowering");
                    return false;
                }
            }
        }
        let n = found.len();
        for k in 0..n {
            stack.push(u32_at(in found, wrapping_sub(wrapping_sub(n, 1), k)));
        }
    }
    true
}

// The effect name before the first `::` of `callee`, interned, or NONE32.
fn effect_prefix(inout names: Names, callee: u32) -> u32 {
    let n = names.size(callee);
    let mut i: u64 = 0;
    loop {
        if wrapping_add(i, 1) >= n {
            return NONE32;
        }
        if names.byte(callee, i) == 58 && names.byte(callee, inc(i)) == 58 {
            break;
        }
        i = inc(i);
    }
    let mut prefix: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for k in 0..i {
        prefix.push(names.byte(callee, k));
    }
    names.intern(in prefix.as_slice())
}

fn variant_names_are(in ctx: Ctx, adt: Adt, action: u8) -> bool {
    let want: u32 = if action == 0 { 5 } else { 8 };
    if adt.vn != want {
        return false;
    }
    for i in 0..w(adt.vn) {
        let variant = ctx.world.variant(add(w(adt.va), i));
        if variant.fc != 0 {
            return false;
        }
        let ok = if action == 0 {
            match i {
                0 => is(in ctx.names, variant.name, "Aborted"),
                1 => is(in ctx.names, variant.name, "Drop"),
                2 => is(in ctx.names, variant.name, "Pass"),
                3 => is(in ctx.names, variant.name, "Tx"),
                _ => is(in ctx.names, variant.name, "Redirect"),
            }
        } else {
            match i {
                0 => is(in ctx.names, variant.name, "Ok"),
                1 => is(in ctx.names, variant.name, "Reclassify"),
                2 => is(in ctx.names, variant.name, "Shot"),
                3 => is(in ctx.names, variant.name, "Pipe"),
                4 => is(in ctx.names, variant.name, "Stolen"),
                5 => is(in ctx.names, variant.name, "Queued"),
                6 => is(in ctx.names, variant.name, "Repeat"),
                _ => is(in ctx.names, variant.name, "Redirect"),
            }
        };
        if !ok {
            return false;
        }
    }
    true
}

fn check_action(inout backend: G, inout ctx: Ctx, in extra: Extra, enum_name: u32) -> bool {
    let id = ctx.world.lookup(enum_name);
    // Rust indexes `world.adts` here; a checked world always has it.
    let adt = ctx.world.adt(id);
    if variant_names_are(in ctx, adt, backend.action) {
        return true;
    }
    let s0 = u64_at(in extra.adt_s0, w(id));
    let s1 = u64_at(in extra.adt_s1, w(id));
    fail(inout backend, R_ACTION, extra.entry, true, s0, s1);
    backend.message.push(96);
    sym(inout backend.message, in ctx.names, enum_name);
    txt(inout backend.message, "` must declare exactly the field-less variants ");
    if backend.action == 0 {
        txt(inout backend.message, "Aborted, Drop, Pass, Tx, Redirect");
    } else {
        txt(inout backend.message, "Ok, Reclassify, Shot, Pipe, Stolen, Queued, Repeat, Redirect");
    }
    txt(inout backend.message, " in this order (the tag is the kernel return code)");
    false
}

// `Surface::effect`: recognise and register effect `name` (idempotent).
fn effect_rule(
    inout backend: G,
    inout ctx: Ctx,
    in program: Program,
    in extra: Extra,
    function: u32,
    name: u32
) -> bool {
    if u32_at(in backend.registered, w(name)) != 0 {
        return true;
    }
    if is(in ctx.names, name, "Fail") {
        fail(inout backend, R_FALLIBLE, function, false, 0, 0);
        txt(
            inout backend.message,
            "`Fail` cannot reach the kernel: use wrapping_add/wrapping_sub/wrapping_mul or prove the operation total"
        );
        return false;
    }
    let decl_pos = extra.decl_index(name);
    if decl_pos == 0 {
        fail(inout backend, R_EFFECT, function, false, 0, 0);
        txt(inout backend.message, "effect `");
        sym(inout backend.message, in ctx.names, name);
        txt(inout backend.message, "` is not declared");
        return false;
    }
    let decl = extra.decl(wrapping_sub(decl_pos, 1));
    if decl.generic_count != 0 {
        fail(inout backend, R_EFFECT, function, true, decl.s0, decl.s1);
        txt(inout backend.message, "effect `");
        sym(inout backend.message, in ctx.names, name);
        txt(inout backend.message, "` is generic");
        return false;
    }
    let ok = if is(in ctx.names, name, "Packet") {
        packet_effect(inout backend, inout ctx, in extra, function, decl)
    } else if is(in ctx.names, name, "Bpf") {
        helper_effect(inout backend, inout ctx, in extra, function, decl)
    } else {
        map_effect(inout backend, inout ctx, in program, in extra, function, decl)
    };
    if ok {
        set_by_symbol(inout backend.registered, name, 1);
    }
    ok
}

// `bad(op, want)`: a recognised operation with the wrong signature.
fn bad_signature(inout backend: G, in ctx: Ctx, function: u32, decl: XEff, op: u32) {
    fail(inout backend, R_EFFECT, function, true, decl.s0, decl.s1);
    backend.message.push(96);
    sym(inout backend.message, in ctx.names, decl.name);
    txt(inout backend.message, "::");
    sym(inout backend.message, in ctx.names, op);
    txt(inout backend.message, "` must have the signature `");
}

fn packet_effect(
    inout backend: G,
    inout ctx: Ctx,
    in extra: Extra,
    function: u32,
    decl: XEff
) -> bool {
    for k in 0..decl.op_count {
        let op = extra.op(add(decl.op_start, k));
        let view = if is(in ctx.names, op.name, "load_u8") {
            PK_U8
        } else if is(in ctx.names, op.name, "load_u16be") {
            PK_U16
        } else if is(in ctx.names, op.name, "load_u32be") {
            PK_U32
        } else {
            fail(inout backend, R_EFFECT, function, true, op.s0, op.s1);
            txt(inout backend.message, "`Packet::");
            sym(inout backend.message, in ctx.names, op.name);
            txt(
                inout backend.message,
                "` is not a supported packet view (load_u8, load_u16be, load_u32be)"
            );
            return false;
        };
        let one_u32 = op.param_count == 1
            && scalar_of(inout ctx, op_param(in extra, op, 0)) == S_U32;
        let inner = option_of(in ctx, in ctx.names, op.result);
        let want_u8 = view == PK_U8;
        let inner_name = if inner != NONE32 {
            type_name(in ctx, inner)
        } else {
            0
        };
        let result_ok = inner != NONE32
            && (
                (want_u8 && is(in ctx.names, inner_name, "u8"))
                    || (!want_u8 && is(in ctx.names, inner_name, "u32"))
            );
        if !one_u32 || !result_ok {
            bad_signature(inout backend, in ctx, function, decl, op.name);
            if view == PK_U8 {
                txt(inout backend.message, "fn load_u8(offset: u32) -> Option[u8]`");
            } else if view == PK_U16 {
                txt(inout backend.message, "fn load_u16be(offset: u32) -> Option[u32]`");
            } else {
                txt(inout backend.message, "fn load_u32be(offset: u32) -> Option[u32]`");
            }
            return false;
        }
        add_eop(
            inout backend,
            inout ctx.names,
            decl.name,
            op.name,
            EOp {
                kind: EO_PACKET,
                packet: view,
                helper: 0,
                map: 0,
                map_op: 0,
                key: 0,
                value: 0,
                map_kind: 0
            }
        );
    }
    true
}

fn helper_effect(
    inout backend: G,
    inout ctx: Ctx,
    in extra: Extra,
    function: u32,
    decl: XEff
) -> bool {
    for k in 0..decl.op_count {
        let op = extra.op(add(decl.op_start, k));
        let helper_id = if is(in ctx.names, op.name, "ktime_get_ns") {
            H_KTIME
        } else if is(in ctx.names, op.name, "smp_processor_id") {
            H_SMP
        } else if is(in ctx.names, op.name, "prandom_u32") {
            H_PRANDOM
        } else {
            fail(inout backend, R_EFFECT, function, true, op.s0, op.s1);
            txt(inout backend.message, "`Bpf::");
            sym(inout backend.message, in ctx.names, op.name);
            txt(
                inout backend.message,
                "` is not a supported helper (ktime_get_ns, smp_processor_id, prandom_u32)"
            );
            return false;
        };
        let result_name = type_name(in ctx, op.result);
        let result_ok = if helper_id == H_KTIME {
            is(in ctx.names, result_name, "u64")
        } else {
            is(in ctx.names, result_name, "u32")
        };
        if op.param_count != 0 || !result_ok {
            bad_signature(inout backend, in ctx, function, decl, op.name);
            txt(inout backend.message, "fn ");
            sym(inout backend.message, in ctx.names, op.name);
            if helper_id == H_KTIME {
                txt(inout backend.message, "() -> u64`");
            } else {
                txt(inout backend.message, "() -> u32`");
            }
            return false;
        }
        if !allowed(prog_type(backend), helper_id) {
            fail(inout backend, R_EFFECT, function, true, op.s0, op.s1);
            txt(inout backend.message, "helper `");
            sym(inout backend.message, in ctx.names, op.name);
            txt(inout backend.message, "` is not allowed in this program type");
            return false;
        }
        add_eop(
            inout backend,
            inout ctx.names,
            decl.name,
            op.name,
            EOp {
                kind: EO_HELPER,
                packet: 0,
                helper: helper_id,
                map: 0,
                map_op: 0,
                key: 0,
                value: 0,
                map_kind: 0
            }
        );
    }
    true
}

// `unify` of `map_effect`: false (with the MAP error) when `ty` is not a
// map scalar or disagrees with `slot`.
fn unify(
    inout backend: G,
    inout ctx: Ctx,
    function: u32,
    decl: XEff,
    inout slot: u8,
    ty: u32,
    key: bool,
    op: u32
) -> bool {
    let scalar = scalar_of(inout ctx, ty);
    if scalar == S_NONE || map_bytes(scalar) == 0 {
        fail(inout backend, R_MAP, function, true, decl.s0, decl.s1);
        backend.message.push(96);
        sym(inout backend.message, in ctx.names, decl.name);
        txt(inout backend.message, "::");
        sym(inout backend.message, in ctx.names, op);
        if key {
            txt(inout backend.message, "`: map key type must be u8, u32 or u64, found ");
        } else {
            txt(inout backend.message, "`: map value type must be u8, u32 or u64, found ");
        }
        display(in ctx.types, in ctx.names, ty, inout backend.message);
        return false;
    }
    if slot != S_NONE && slot != scalar {
        fail(inout backend, R_MAP, function, true, decl.s0, decl.s1);
        backend.message.push(96);
        sym(inout backend.message, in ctx.names, decl.name);
        txt(inout backend.message, "::");
        sym(inout backend.message, in ctx.names, op);
        if key {
            txt(inout backend.message, "`: map key type disagrees with another operation");
        } else {
            txt(inout backend.message, "`: map value type disagrees with another operation");
        }
        return false;
    }
    slot = scalar;
    true
}

fn map_err(inout backend: G, function: u32, decl: XEff) {
    fail(inout backend, R_MAP, function, true, decl.s0, decl.s1);
}

fn map_effect(
    inout backend: G,
    inout ctx: Ctx,
    in program: Program,
    in extra: Extra,
    function: u32,
    decl: XEff
) -> bool {
    let name = decl.name;
    let mut key: u8 = S_NONE;
    let mut value: u8 = S_NONE;
    let mut map_ops: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for k in 0..decl.op_count {
        let op = extra.op(add(decl.op_start, k));
        let map_op = if op.param_count == 1 && is(in ctx.names, op.name, "lookup") {
            if !unify(
                inout backend,
                inout ctx,
                function,
                decl,
                inout key,
                op_param(in extra, op, 0),
                true,
                op.name
            ) {
                return false;
            }
            let inner_ty = option_of(in ctx, in ctx.names, op.result);
            if inner_ty == NONE32 {
                map_err(inout backend, function, decl);
                backend.message.push(96);
                sym(inout backend.message, in ctx.names, name);
                txt(inout backend.message, "::lookup` must return Option[V]");
                return false;
            }
            if !unify(
                inout backend,
                inout ctx,
                function,
                decl,
                inout value,
                inner_ty,
                false,
                op.name
            ) {
                return false;
            }
            MO_LOOKUP
        } else if op.param_count == 2
            && (is(in ctx.names, op.name, "update") || is(in ctx.names, op.name, "add")) {
            if !unify(
                inout backend,
                inout ctx,
                function,
                decl,
                inout key,
                op_param(in extra, op, 0),
                true,
                op.name
            ) {
                return false;
            }
            if !unify(
                inout backend,
                inout ctx,
                function,
                decl,
                inout value,
                op_param(in extra, op, 1),
                false,
                op.name
            ) {
                return false;
            }
            if !is_unit_type(in ctx, op.result) {
                map_err(inout backend, function, decl);
                backend.message.push(96);
                sym(inout backend.message, in ctx.names, name);
                txt(inout backend.message, "::");
                sym(inout backend.message, in ctx.names, op.name);
                txt(inout backend.message, "` must return Unit");
                return false;
            }
            if is(in ctx.names, op.name, "add") {
                MO_ADD
            } else {
                MO_UPDATE
            }
        } else if op.param_count == 1 && is(in ctx.names, op.name, "delete") {
            if !unify(
                inout backend,
                inout ctx,
                function,
                decl,
                inout key,
                op_param(in extra, op, 0),
                true,
                op.name
            ) {
                return false;
            }
            if !is_unit_type(in ctx, op.result) {
                map_err(inout backend, function, decl);
                backend.message.push(96);
                sym(inout backend.message, in ctx.names, name);
                txt(inout backend.message, "::delete` must return Unit");
                return false;
            }
            MO_DELETE
        } else {
            fail(inout backend, R_EFFECT, function, true, op.s0, op.s1);
            txt(inout backend.message, "effect `");
            sym(inout backend.message, in ctx.names, name);
            txt(inout backend.message, "` is not Packet, Bpf or a map: `");
            sym(inout backend.message, in ctx.names, op.name);
            txt(
                inout backend.message,
                "` is not lookup(key), update(key, value), delete(key) or add(key, delta)"
            );
            return false;
        };
        map_ops.push(map_op);
    }
    if key == S_NONE || value == S_NONE {
        map_err(inout backend, function, decl);
        txt(inout backend.message, "map effect `");
        sym(inout backend.message, in ctx.names, name);
        txt(inout backend.message, "` needs operations that fix both its key and value types");
        return false;
    }
    let mut map_name: ChunkSeq[u8] = ChunkSeq::new[u8]();
    snake(in ctx.names, name, inout map_name);
    let mut spec_name: ChunkSeq[u8] = ChunkSeq::new[u8]();
    spec_name.extend(in map_name.as_slice());
    txt(inout spec_name, "_map");
    let spec_sym = ctx.names.intern(in spec_name.as_slice());
    let mut why: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut map_kind: u8 = 0;
    let mut max: u32 = 0;
    if !map_spec(
        inout ctx,
        in program,
        in backend,
        spec_sym,
        inout map_kind,
        inout max,
        inout why
    ) {
        map_err(inout backend, function, decl);
        txt(inout backend.message, "map effect `");
        sym(inout backend.message, in ctx.names, name);
        txt(inout backend.message, "` needs `fn ");
        backend.message.extend(in spec_name.as_slice());
        txt(
            inout backend.message,
            "() -> BpfMapSpec { BpfMapSpec { kind: BpfMapKind::..., max_entries: N } }`: "
        );
        backend.message.extend(in why.as_slice());
        return false;
    }
    let array = map_kind == MK_ARRAY || map_kind == MK_PERCPU_ARRAY;
    if array && key != S_U32 {
        map_err(inout backend, function, decl);
        txt(inout backend.message, "array map `");
        sym(inout backend.message, in ctx.names, name);
        txt(inout backend.message, "` must have u32 keys");
        return false;
    }
    let mut has_add = false;
    let mut has_delete = false;
    for k in 0..map_ops.len() {
        let map_op = u8_at(in map_ops, k);
        if map_op == MO_ADD {
            has_add = true;
        }
        if map_op == MO_DELETE {
            has_delete = true;
        }
    }
    if has_add && value == S_U8 {
        map_err(inout backend, function, decl);
        backend.message.push(96);
        sym(inout backend.message, in ctx.names, name);
        txt(inout backend.message, "::add` needs a u32 or u64 value (atomic add has no byte form)");
        return false;
    }
    if has_delete && array {
        map_err(inout backend, function, decl);
        txt(inout backend.message, "array map `");
        sym(inout backend.message, in ctx.names, name);
        txt(inout backend.message, "` has no delete");
        return false;
    }
    let key_bytes = map_bytes(key);
    let value_bytes = map_bytes(value);
    let mut map_why: ChunkSeq[u8] = ChunkSeq::new[u8]();
    if !validate_map(in map_name, array, key_bytes, value_bytes, max, inout map_why) {
        map_err(inout backend, function, decl);
        txt(inout backend.message, "map `");
        backend.message.extend(in map_name.as_slice());
        txt(inout backend.message, "`: ");
        backend.message.extend(in map_why.as_slice());
        return false;
    }
    let index = backend.map_defs.len();
    let map_sym = ctx.names.intern(in map_name.as_slice());
    backend.map_defs.push(
        MapRow {
            name: map_sym,
            kind: map_kind,
            key: key_bytes,
            value: value_bytes,
            max: max,
            flags: 0
        }
    );
    backend.map_effects.push(name);
    for k in 0..decl.op_count {
        let op = extra.op(add(decl.op_start, k));
        add_eop(
            inout backend,
            inout ctx.names,
            name,
            op.name,
            EOp {
                kind: EO_MAP,
                packet: 0,
                helper: 0,
                map: index,
                map_op: u8_at(in map_ops, k),
                key: key,
                value: value,
                map_kind: map_kind
            }
        );
    }
    true
}

// `MapDef::validate` for the kinds the backend makes (no ring buffers or
// program arrays); the message on failure.
pub fn validate_map(
    in name: ChunkSeq[u8],
    array: bool,
    key: u32,
    value: u32,
    max: u32,
    inout why: ChunkSeq[u8]
) -> bool {
    let mut ascii = true;
    for i in 0..name.len() {
        if u8_at(in name, i) >= 128 {
            ascii = false;
        }
    }
    if name.len() == 0 || name.len() >= OBJ_NAME_LEN || !ascii {
        txt(inout why, "map name \"");
        why.extend(in name.as_slice());
        txt(inout why, "\" must be 1..=15 ASCII bytes");
        return false;
    }
    if max == 0 || value == 0 {
        txt(inout why, "max_entries and value_size must be nonzero");
        return false;
    }
    if array && key != 4 {
        txt(inout why, "array maps have 4-byte keys");
        return false;
    }
    if key == 0 || key > MAX_KEY {
        txt(inout why, "key size must be 1..=512");
        return false;
    }
    if value > MAX_VALUE {
        txt(inout why, "value size too large");
        return false;
    }
    true
}

// The instruction defining `value` in `func`, if any (the last
// one, as a `BTreeMap` collect keeps).
fn def_of(in program: Program, func: FnRow, value: u32, inout found: bool) -> InstRow {
    let mut def = program.inst(NONE64);
    found = false;
    for block_index in 0..func.bc {
        let block = fn_block(in program, func, block_index);
        for k in 0..block.ic {
            let inst = block_inst(in program, block, k);
            if inst.dest == value {
                def = inst;
                found = true;
            }
        }
    }
    def
}

// The data field `field` of the `Op::Data` at `inst`, as the defining
// instruction of its value.
fn data_field(
    in program: Program,
    func: FnRow,
    inst: InstRow,
    in names: Names,
    in field: Str,
    inout found: bool
) -> InstRow {
    let field_count = program.op(inc(inst.a));
    for k in 0..field_count {
        let pair_at = add(add(inst.a, 2), wrapping_mul(k, 2));
        if is(in names, pos32(in program, pair_at), field) {
            return def_of(in program, func, pos32(in program, inc(pair_at)), inout found);
        }
    }
    found = false;
    program.inst(NONE64)
}

// `map_spec`: the kind and size of a constant `BpfMapSpec` function, or
// the reason it is not one.
fn map_spec(
    inout ctx: Ctx,
    in program: Program,
    in backend: G,
    name: u32,
    inout kind: u8,
    inout max: u32,
    inout why: ChunkSeq[u8]
) -> bool {
    let ir_pos = ir_index(in backend, name);
    if ir_pos == 0 {
        txt(inout why, "function not found");
        return false;
    }
    let func = program.function(wrapping_sub(ir_pos, 1));
    let param_count = program.op(func.ha);
    let result = header_result(in program, func);
    if param_count != 0 || !is(in ctx.names, type_name(in ctx, result), "BpfMapSpec") {
        txt(inout why, "it must take no parameters and return BpfMapSpec");
        return false;
    }
    if func.bc != 1 {
        txt(inout why, "its body must be one constant struct literal");
        return false;
    }
    let block = fn_block(in program, func, 0);
    if block.term != Term::Return {
        txt(inout why, "its body must be one constant struct literal");
        return false;
    }
    let mut found = false;
    let literal = def_of(in program, func, pos32(in program, block.ta), inout found);
    if !found || literal.op != Op::Data {
        txt(inout why, "its body must be one constant struct literal");
        return false;
    }
    let literal_name = pos32(in program, literal.a);
    if !is(in ctx.names, literal_name, "BpfMapSpec") {
        txt(inout why, "it returns `");
        sym(inout why, in ctx.names, literal_name);
        why.push(96);
        return false;
    }
    let mut has_kind = false;
    let kind_inst = data_field(in program, func, literal, in ctx.names, "kind", inout has_kind);
    if !has_kind || kind_inst.op != Op::Data || program.op(inc(kind_inst.a)) != 0 {
        txt(inout why, "`kind` must be a BpfMapKind constant");
        return false;
    }
    let kind_name = pos32(in program, kind_inst.a);
    kind = if is(in ctx.names, kind_name, "BpfMapKind::Hash") {
        MK_HASH
    } else if is(in ctx.names, kind_name, "BpfMapKind::Array") {
        MK_ARRAY
    } else if is(in ctx.names, kind_name, "BpfMapKind::PerCpuHash") {
        MK_PERCPU_HASH
    } else if is(in ctx.names, kind_name, "BpfMapKind::PerCpuArray") {
        MK_PERCPU_ARRAY
    } else if is(in ctx.names, kind_name, "BpfMapKind::LruHash") {
        MK_LRU_HASH
    } else {
        txt(inout why, "unsupported map kind `");
        sym(inout why, in ctx.names, kind_name);
        why.push(96);
        return false;
    };
    let mut has_max = false;
    let max_inst = data_field(
        in program,
        func,
        literal,
        in ctx.names,
        "max_entries",
        inout has_max
    );
    if !has_max || max_inst.op != Op::Const || program.op(max_inst.a) != Lit::Int {
        txt(inout why, "`max_entries` must be an integer literal");
        return false;
    }
    let lo = program.op(inc(max_inst.a));
    let hi = program.op(add(max_inst.a, 2));
    if hi != 0 || lo > 4294967295 {
        txt(inout why, "max_entries ");
        push_i128(inout why, lo, hi);
        txt(inout why, " is out of range");
        return false;
    }
    max = n32(lo);
    true
}

// ----- function headers ------------------------------------------------------------

// The header position just past the parameters of `func`.
fn header_after_params(in program: Program, func: FnRow) -> u64 {
    let param_count = program.op(func.ha);
    let mut at = inc(func.ha);
    for i in 0..param_count {
        let proj_count = program.op(add(at, 2));
        at = add(at, add(6, proj_count));
    }
    at
}

fn header_result(in program: Program, func: FnRow) -> u32 {
    pos32(in program, header_after_params(in program, func))
}

fn read_params(inout backend: G, in program: Program, func: FnRow) {
    backend.params.clear();
    let param_count = program.op(func.ha);
    let mut at = inc(func.ha);
    for i in 0..param_count {
        let name = pos32(in program, at);
        let pass = wrapping_u8(program.op(inc(at)));
        let proj_count = program.op(add(at, 2));
        let ty_at = add(at, add(3, proj_count));
        backend.params.push(
            PInfo {
                name: name,
                pass: pass,
                proj_count: proj_count,
                ty: pos32(in program, ty_at),
                s0: program.op(inc(ty_at)),
                s1: program.op(add(ty_at, 2))
            }
        );
        at = add(ty_at, 3);
    }
}

fn param_at(in backend: G, k: u64) -> PInfo {
    match backend.params.try_get(k) {
        Option::Some(x) => x,
        Option::None => PInfo { name: 0, pass: 0, proj_count: 0, ty: 0, s0: 0, s1: 0 },
    }
}

// ----- lowering (`lower`) -------------------------------------------------------------

fn fn_pos(in backend: G, name: u32) -> u64 {
    w(u32_at(in backend.fn_pos, w(name)))
}

fn world_fn(in extra: Extra, name: u32, inout found: bool) -> XFn {
    let index = extra.fn_index(name);
    found = index != 0;
    extra.func(wrapping_sub(index, 1))
}

// `returns_directly`.
fn returns_directly(in program: Program, func: FnRow, block_index: u64, value: u32) -> bool {
    let mut block = fn_block(in program, func, block_index);
    let mut cur_value = value;
    for step in 0..inc(func.bc) {
        if block.term == Term::Return {
            return pos32(in program, block.ta) == cur_value;
        }
        if block.term != Term::Jump {
            return false;
        }
        let arg_count = program.op(inc(block.ta));
        if arg_count != 1 || pos32(in program, add(block.ta, 2)) != cur_value {
            return false;
        }
        let target = fn_block(in program, func, program.op(block.ta));
        if target.ic != 0 || block_nparams(in program, target) != 1 {
            return false;
        }
        cur_value = block_param(in program, target, 0);
        block = target;
    }
    false
}

// `tail_self_calls` of function `k` into `backend.tails`, and its callees
// (not counting tail self-calls) into `backend.callees`, sorted by name.
fn calls_of(inout backend: G, inout ctx: Ctx, in program: Program, k: u64) -> bool {
    let name = u32_at(in backend.functions, k);
    let func = program.function(wrapping_sub(ir_index(in backend, name), 1));
    let tail_start = backend.tails.len();
    for block_index in 0..func.bc {
        let block = fn_block(in program, func, block_index);
        for j in 0..block.ic {
            let inst = block_inst(in program, block, j);
            if inst.op == Op::Call && pos32(in program, inst.a) == func.name {
                if inc(j) == block.ic
                    && returns_directly(in program, func, block_index, inst.dest) {
                    backend.tails.push(inst.dest);
                } else {
                    fail(inout backend, R_RECURSION, func.name, true, inst.s0, inst.s1);
                    txt(
                        inout backend.message,
                        "recursion is not allowed on the eBPF target; only a tail self-call (a bounded loop) is lowered"
                    );
                    return false;
                }
            }
        }
    }
    backend.tail_starts.push(tail_start);
    backend.tail_counts.push(wrapping_sub(backend.tails.len(), tail_start));
    let callee_start = backend.callees.len();
    for block_index in 0..func.bc {
        let block = fn_block(in program, func, block_index);
        for j in 0..block.ic {
            let inst = block_inst(in program, block, j);
            if inst.op != Op::Call {
                continue;
            }
            let callee = pos32(in program, inst.a);
            if ir_index(in backend, callee) == 0 || in_tails(in backend, k, inst.dest, tail_start) {
                continue;
            }
            insert_sorted(inout backend.callees, callee_start, callee, in ctx.names);
        }
    }
    backend.callee_starts.push(callee_start);
    backend.callee_counts.push(wrapping_sub(backend.callees.len(), callee_start));
    true
}

fn in_tails(in backend: G, k: u64, value: u32, tail_start: u64) -> bool {
    for i in tail_start..backend.tails.len() {
        if u32_at(in backend.tails, i) == value {
            return true;
        }
    }
    false
}

// Inserts `symbol` into the sorted, deduplicated run `seq[from..]`.
fn insert_sorted(inout seq: ChunkSeq[u32], from: u64, symbol: u32, in names: Names) {
    let mut at = from;
    loop {
        if at >= seq.len() {
            break;
        }
        let existing = u32_at(in seq, at);
        if existing == symbol {
            return;
        }
        if name_cmp(in names, existing, symbol) > 0 {
            break;
        }
        at = inc(at);
    }
    seq.push(0);
    let mut j = wrapping_sub(seq.len(), 1);
    loop {
        if j <= at {
            break;
        }
        let prev = u32_at(in seq, wrapping_sub(j, 1));
        set32(inout seq, j, prev);
        j = wrapping_sub(j, 1);
    }
    set32(inout seq, at, symbol);
}

fn callee_count(in backend: G, k: u64) -> u64 {
    u64_at(in backend.callee_counts, k)
}

fn callee_at(in backend: G, k: u64, j: u64) -> u32 {
    u32_at(in backend.callees, add(u64_at(in backend.callee_starts, k), j))
}

// `cycle`: a recursion path from function `k` (pushed into `path`), or
// none. `state`: 0 new, 2 done.
fn cycle(in backend: G, k: u64, inout path: ChunkSeq[u64], inout done: ChunkSeq[u8]) -> bool {
    for i in 0..path.len() {
        if u64_at(in path, i) == k {
            // keep path[i..] and close it with k
            let mut closed: ChunkSeq[u64] = ChunkSeq::new[u64]();
            for j in i..path.len() {
                closed.push(u64_at(in path, j));
            }
            closed.push(k);
            path.clear();
            path.extend(in closed.as_slice());
            return true;
        }
    }
    if u8_at(in done, k) != 0 {
        return false;
    }
    path.push(k);
    for j in 0..callee_count(in backend, k) {
        let callee_pos = wrapping_sub(fn_pos(in backend, callee_at(in backend, k, j)), 1);
        if cycle(in backend, callee_pos, inout path, inout done) {
            return true;
        }
    }
    let gone = path.pop();
    set8(inout done, k, 1);
    false
}

// `chain`: the worst call-chain bytes from function `k`, and its path.
fn chain(in backend: G, k: u64, inout path: ChunkSeq[u64]) -> u32 {
    let frame = u32_at(in backend.frames, k);
    let own = wrapping_mul(
        wrapping_add(frame, wrapping_sub(FRAME_ALIGN, 1)) / FRAME_ALIGN,
        FRAME_ALIGN
    );
    let mut best: u32 = 0;
    let mut best_path: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for j in 0..callee_count(in backend, k) {
        let callee_pos = wrapping_sub(fn_pos(in backend, callee_at(in backend, k, j)), 1);
        let mut sub_path: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let callee_bytes = chain(in backend, callee_pos, inout sub_path);
        if callee_bytes > best {
            best = callee_bytes;
            best_path.clear();
            best_path.extend(in sub_path.as_slice());
        }
    }
    path.clear();
    path.push(k);
    path.extend(in best_path.as_slice());
    wrapping_add(own, best)
}

fn join_names(
    inout message: ChunkSeq[u8],
    in names: Names,
    in functions: ChunkSeq[u32],
    in path: ChunkSeq[u64]
) {
    for i in 0..path.len() {
        if i > 0 {
            txt(inout message, " -> ");
        }
        sym(inout message, in names, u32_at(in functions, u64_at(in path, i)));
    }
}

// `lower`.
pub fn lower(inout backend: G, inout ctx: Ctx, in program: Program, in extra: Extra) -> bool {
    for i in 0..backend.map_defs.len() {
        let map_def = match backend.map_defs.try_get(i) {
            Option::Some(map_def) => map_def,
            Option::None => {
                break;
            },
        };
        // `Asm::map`: validated already; a second map with the same name
        // is an assembly error.
        for j in 0..i {
            let other = match backend.map_defs.try_get(j) {
                Option::Some(other) => other,
                Option::None => map_def,
            };
            if other.name == map_def.name {
                fail_asm(inout backend);
                txt(inout backend.message, "duplicate map ");
                sym(inout backend.message, in ctx.names, map_def.name);
                return false;
            }
        }
        backend.asm.maps.push(map_def);
    }
    if extra.has_source {
        backend.line_starts.push(0);
        for i in 0..extra.source.len() {
            if u8_at(in extra.source, i) == 10 {
                backend.line_starts.push(inc(i));
            }
        }
    }
    for k in 0..backend.functions.len() {
        set_by_symbol(inout backend.fn_pos, u32_at(in backend.functions, k), inc32(n32(k)));
    }
    for k in 0..backend.functions.len() {
        if !calls_of(inout backend, inout ctx, in program, k) {
            return false;
        }
    }
    let mut path: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut done: ChunkSeq[u8] = ChunkSeq::new[u8]();
    done.resize(backend.functions.len(), 0);
    if cycle(in backend, 0, inout path, inout done) {
        let first = u32_at(in backend.functions, u64_at(in path, 0));
        let mut has_span = false;
        let world_func = world_fn(in extra, first, inout has_span);
        fail(inout backend, R_RECURSION, first, has_span, world_func.s0, world_func.s1);
        txt(inout backend.message, "recursion is not allowed on the eBPF target: ");
        join_names(inout backend.message, in ctx.names, in backend.functions, in path);
        return false;
    }
    for k in 0..backend.functions.len() {
        let label = backend.asm.label();
        backend.fn_label.push(label);
    }
    for k in 0..backend.functions.len() {
        let name = u32_at(in backend.functions, k);
        if u64_at(in backend.tail_counts, k) != 0 {
            backend.loops.push(name);
        }
        let label = u64_at(in backend.fn_label, k);
        if !backend.asm.bind(label) {
            fail_asm(inout backend);
            txt(inout backend.message, "label ");
            push_decimal(inout backend.message, label);
            txt(inout backend.message, " bound twice");
            return false;
        }
        if k > 0 {
            backend.asm.function(name, label);
        }
        if !lower_fn(inout backend, inout ctx, in program, in extra, k) {
            return false;
        }
        backend.frames.push(wrapping_mul(backend.slot_count, 8));
    }
    for k in 0..backend.functions.len() {
        let frame_bytes = u32_at(in backend.frames, k);
        if frame_bytes > MAX_STACK {
            let func_name = u32_at(in backend.functions, k);
            let mut has_span = false;
            let world_func = world_fn(in extra, func_name, inout has_span);
            fail(inout backend, R_STACK, func_name, has_span, world_func.s0, world_func.s1);
            txt(inout backend.message, "frame of ");
            push_decimal(inout backend.message, w(frame_bytes));
            txt(inout backend.message, " bytes exceeds the 512-byte eBPF stack");
            return false;
        }
    }
    let mut worst_path: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let worst = chain(in backend, 0, inout worst_path);
    if worst > MAX_STACK {
        fail(inout backend, R_STACK, u32_at(in backend.functions, 0), false, 0, 0);
        txt(inout backend.message, "call chain ");
        join_names(inout backend.message, in ctx.names, in backend.functions, in worst_path);
        txt(inout backend.message, " needs ");
        push_decimal(inout backend.message, w(worst));
        txt(inout backend.message, " stack bytes, over the 512-byte eBPF limit");
        return false;
    }
    let entry = u32_at(in backend.functions, 0);
    for i in 0..ctx.names.size(entry) {
        let ch = ctx.names.byte(entry, i);
        let alnum = (ch >= 48 && ch <= 57) || (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122);
        if (alnum || ch == 95) && backend.name.len() < 15 {
            backend.name.push(ch);
        }
    }
    if backend.name.len() == 0 {
        txt(inout backend.name, "prog");
    }
    let mut bad: u64 = 0;
    let fixed = backend.asm.fix_up(inout bad);
    if fixed == 1 {
        fail_asm(inout backend);
        txt(inout backend.message, "label ");
        push_decimal(inout backend.message, bad);
        txt(inout backend.message, " never bound");
        return false;
    }
    if fixed == 2 {
        fail_asm(inout backend);
        txt(inout backend.message, "jump at slot ");
        push_decimal(inout backend.message, bad);
        txt(inout backend.message, " out of 16-bit range");
        return false;
    }
    for k in 0..backend.asm.fn_labels.len() {
        let label = u64_at(in backend.asm.fn_labels, k);
        if backend.asm.resolve(label) == NONE64 {
            fail_asm(inout backend);
            txt(inout backend.message, "label ");
            push_decimal(inout backend.message, label);
            txt(inout backend.message, " never bound");
            return false;
        }
    }
    true
}

// ----- one function (`FnLower`) -----------------------------------------------------

fn vrep(in backend: G, v: u32) -> u8 {
    match backend.reprs.try_get(w(v)) {
        Option::Some(rep) => rep,
        Option::None => REP_BAD,
    }
}

fn vty(in backend: G, v: u32) -> u32 {
    match backend.value_types.try_get(w(v)) {
        Option::Some(t) => t,
        Option::None => NONE32,
    }
}

fn grow_values(inout backend: G, v: u32) {
    let n = inc(w(v));
    if n <= backend.value_count {
        return;
    }
    backend.value_count = n;
    backend.value_types.resize(n, NONE32);
    backend.loc_kinds.resize(n, L_UNDEF);
    backend.loc_values.resize(n, 0);
    backend.reprs.resize(n, REP_BAD);
    backend.def_block.resize(n, NONE64);
    backend.use_min.resize(n, NONE64);
    backend.use_max.resize(n, 0);
    backend.is_tail.resize(n, false);
    backend.last_use_inst.resize(n, 0);
    backend.last_use_block.resize(n, 0);
}

fn set_loc(inout backend: G, v: u32, kind: u8, value: u64) {
    grow_values(inout backend, v);
    set8(inout backend.loc_kinds, w(v), kind);
    set64(inout backend.loc_values, w(v), value);
}

fn loc_kind(in backend: G, v: u32) -> u8 {
    u8_at(in backend.loc_kinds, w(v))
}

fn loc_val(in backend: G, v: u32) -> u64 {
    u64_at(in backend.loc_values, w(v))
}

fn local_index(in backend: G, name: u32) -> u64 {
    w(u32_at(in backend.local_by_name, w(name)))
}

fn note_use(inout backend: G, v: u32, block_index: u64) {
    grow_values(inout backend, v);
    if block_index < u64_at(in backend.use_min, w(v)) {
        set64(inout backend.use_min, w(v), block_index);
    }
    if block_index > u64_at(in backend.use_max, w(v))
        || u64_at(in backend.use_min, w(v)) == block_index {
        if block_index > u64_at(in backend.use_max, w(v)) {
            set64(inout backend.use_max, w(v), block_index);
        }
    }
}

fn reset_fn(inout backend: G) {
    backend.value_count = 0;
    backend.value_types.clear();
    backend.loc_kinds.clear();
    backend.loc_values.clear();
    backend.reprs.clear();
    backend.def_block.clear();
    backend.use_min.clear();
    backend.use_max.clear();
    backend.is_tail.clear();
    backend.last_use_inst.clear();
    backend.last_use_block.clear();
    for i in 0..backend.local_names.len() {
        set32(inout backend.local_by_name, w(u32_at(in backend.local_names, i)), 0);
    }
    backend.local_names.clear();
    backend.local_slot.clear();
    backend.local_rep.clear();
    backend.block_labels.clear();
    backend.key_slot = 0;
    backend.val_slot = 0;
    backend.slot_count = 0;
    backend.last_line = 0;
}

fn lower_fn(
    inout backend: G,
    inout ctx: Ctx,
    in program: Program,
    in extra: Extra,
    k: u64
) -> bool {
    reset_fn(inout backend);
    let name = u32_at(in backend.functions, k);
    let func = program.function(wrapping_sub(ir_index(in backend, name), 1));
    backend.f_index = k;
    backend.f_name = name;
    backend.f_entry = k == 0;
    let mut has_span = false;
    let world_func = world_fn(in extra, name, inout has_span);
    backend.f_has_span = has_span;
    backend.f_s0 = world_func.s0;
    backend.f_s1 = world_func.s1;
    read_params(inout backend, in program, func);
    backend.f_result = header_result(in program, func);
    for block_index in 0..func.bc {
        let label = backend.asm.label();
        backend.block_labels.push(label);
    }
    let loop_head = backend.asm.label();
    backend.loop_head = loop_head;
    // value types (header values) and tail dests
    let mut at = inc(header_after_params(in program, func));
    at = inc(at);
    let bound_count = program.op(at);
    at = add(at, add(1, wrapping_mul(bound_count, 2)));
    let name_count = program.op(at);
    at = add(at, inc(name_count));
    let value_count = program.op(at);
    at = inc(at);
    for i in 0..value_count {
        let v = pos32(in program, at);
        grow_values(inout backend, v);
        set32(inout backend.value_types, w(v), pos32(in program, inc(at)));
        at = add(at, 2);
    }
    let locals_at = at;
    for i in u64_at(in backend.tail_starts, k)..add(
        u64_at(in backend.tail_starts, k),
        u64_at(in backend.tail_counts, k)
    ) {
        let v = u32_at(in backend.tails, i);
        grow_values(inout backend, v);
        let ok = backend.is_tail.try_set(w(v), true);
    }
    if !check_signature(inout backend, inout ctx) {
        return false;
    }
    if !allocate(inout backend, inout ctx, in program, func, locals_at) {
        return false;
    }
    emit(inout backend, inout ctx, in program, in extra, func)
}

fn fn_err(inout backend: G, rule: u8) {
    fail(inout backend, rule, backend.f_name, backend.f_has_span, backend.f_s0, backend.f_s1);
}

fn err_at(inout backend: G, rule: u8, s0: u64, s1: u64) {
    fail(inout backend, rule, backend.f_name, true, s0, s1);
}

// `check_signature`.
fn check_signature(inout backend: G, inout ctx: Ctx) -> bool {
    let mut reg_count: u64 = 0;
    for k in 0..backend.params.len() {
        let param = param_at(in backend, k);
        if param.pass == TyPass::Inout {
            err_at(inout backend, R_CALL, param.s0, param.s1);
            txt(inout backend.message, "inout parameter `");
            sym(inout backend.message, in ctx.names, param.name);
            txt(inout backend.message, "` is not supported on the eBPF target");
            return false;
        }
        if param.proj_count != 0 {
            err_at(inout backend, R_CALL, param.s0, param.s1);
            txt(inout backend.message, "parameter projections are not supported");
            return false;
        }
        let rep = repr(
            inout backend,
            inout ctx,
            param.ty,
            backend.f_name,
            true,
            param.s0,
            param.s1
        );
        if rep == REP_BAD {
            return false;
        }
        if rep >= REP_OPT {
            err_at(inout backend, R_CALL, param.s0, param.s1);
            txt(inout backend.message, "parameter `");
            sym(inout backend.message, in ctx.names, param.name);
            txt(inout backend.message, "`: Option parameters are not passed in registers");
            return false;
        }
        if rep != REP_UNIT {
            reg_count = inc(reg_count);
        }
    }
    if reg_count > ARG_REGS {
        fn_err(inout backend, R_CALL);
        push_decimal(inout backend.message, reg_count);
        txt(
            inout backend.message,
            " scalar parameters: a BPF subprogram takes at most 4 besides the context"
        );
        return false;
    }
    let rep = repr(
        inout backend,
        inout ctx,
        backend.f_result,
        backend.f_name,
        backend.f_has_span,
        backend.f_s0,
        backend.f_s1
    );
    if rep == REP_BAD {
        return false;
    }
    if rep >= REP_OPT {
        let payload = wrapping_sub(rep, REP_OPT);
        if payload != S_U8 && payload != S_U32 && payload != S_BOOL {
            fn_err(inout backend, R_CALL);
            txt(
                inout backend.message,
                "an Option result is returned packed in r0, so its payload must be at most 32 bits"
            );
            return false;
        }
    }
    true
}

fn take_slots(inout next: u32, n: u32) -> u32 {
    let first = next;
    next = wrapping_add(next, n);
    first
}

// `allocate`.
fn allocate(
    inout backend: G,
    inout ctx: Ctx,
    in program: Program,
    func: FnRow,
    locals_at: u64
) -> bool {
    let mut next: u32 = 0;
    let local_count = program.op(locals_at);
    for i in 0..local_count {
        let at = add(inc(locals_at), wrapping_mul(i, 2));
        let local_name = pos32(in program, at);
        let ty = pos32(in program, inc(at));
        let rep = repr(
            inout backend,
            inout ctx,
            ty,
            backend.f_name,
            backend.f_has_span,
            backend.f_s0,
            backend.f_s1
        );
        if rep == REP_BAD {
            return false;
        }
        let slot = take_slots(inout next, rep_slots(rep));
        let local_pos = local_index(in backend, local_name);
        if local_pos != 0 {
            set32(inout backend.local_slot, wrapping_sub(local_pos, 1), slot);
            set8(inout backend.local_rep, wrapping_sub(local_pos, 1), rep);
        } else {
            set_by_symbol(
                inout backend.local_by_name,
                local_name,
                inc32(n32(backend.local_names.len()))
            );
            backend.local_names.push(local_name);
            backend.local_slot.push(slot);
            backend.local_rep.push(rep);
        }
    }
    let mut uses_map = false;
    for block_index in 0..func.bc {
        let block = fn_block(in program, func, block_index);
        for k in 0..block.ic {
            let inst = block_inst(in program, block, k);
            if inst.op == Op::Call {
                let eop_pos = eop_index(in backend, pos32(in program, inst.a));
                if eop_pos != 0 && eop_at(in backend, wrapping_sub(eop_pos, 1)).kind == EO_MAP {
                    uses_map = true;
                }
            }
        }
    }
    if uses_map {
        backend.key_slot = take_slots(inout next, 1);
        backend.val_slot = take_slots(inout next, 1);
    }
    // definition and use blocks
    let mut uses: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for block_index in 0..func.bc {
        let block = fn_block(in program, func, block_index);
        for k in 0..block_nparams(in program, block) {
            let v = block_param(in program, block, k);
            grow_values(inout backend, v);
            set64(inout backend.def_block, w(v), NONE64);
        }
        for k in 0..block.ic {
            let inst = block_inst(in program, block, k);
            grow_values(inout backend, inst.dest);
            set64(inout backend.def_block, w(inst.dest), block_index);
            op_uses(in program, inst, inout uses);
            for u in 0..uses.len() {
                note_use(inout backend, u32_at(in uses, u), block_index);
            }
        }
        term_uses(in program, block, inout uses);
        for u in 0..uses.len() {
            note_use(inout backend, u32_at(in uses, u), block_index);
        }
    }
    // representations and immediates
    for block_index in 0..func.bc {
        let block = fn_block(in program, func, block_index);
        for k in 0..block_nparams(in program, block) {
            let v = block_param(in program, block, k);
            let ty = vty(in backend, v);
            if ty == NONE32 {
                fn_err(inout backend, R_OPERATION);
                txt(inout backend.message, "block parameter v");
                push_decimal(inout backend.message, w(v));
                txt(inout backend.message, " has no type");
                return false;
            }
            let rep = repr(
                inout backend,
                inout ctx,
                ty,
                backend.f_name,
                backend.f_has_span,
                backend.f_s0,
                backend.f_s1
            );
            if rep == REP_BAD {
                return false;
            }
            set8(inout backend.reprs, w(v), rep);
        }
        for k in 0..block.ic {
            let inst = block_inst(in program, block, k);
            let rep = repr(
                inout backend,
                inout ctx,
                inst.ty,
                backend.f_name,
                true,
                inst.s0,
                inst.s1
            );
            if rep == REP_BAD {
                return false;
            }
            set8(inout backend.reprs, w(inst.dest), rep);
            if rep == REP_UNIT {
                set_loc(inout backend, inst.dest, L_NONE, 0);
            } else if inst.op == Op::Const && rep < REP_ENUM && program.op(inst.a) == Lit::Int {
                set_loc(inout backend, inst.dest, L_IMM, program.op(inc(inst.a)));
            } else if inst.op == Op::Const && rep < REP_ENUM && program.op(inst.a) == Lit::Bool {
                set_loc(inout backend, inst.dest, L_IMM, program.op(inc(inst.a)));
            } else if inst.op == Op::Data && rep == REP_ENUM && program.op(inc(inst.a)) == 0 {
                let variant_name = pos32(in program, inst.a);
                let tag = variant_tag(inout ctx, inst.ty, variant_name);
                if tag < 0 {
                    err_at(inout backend, R_OPERATION, inst.s0, inst.s1);
                    txt(inout backend.message, "unknown variant `");
                    sym(inout backend.message, in ctx.names, variant_name);
                    backend.message.push(96);
                    return false;
                }
                set_loc(inout backend, inst.dest, L_IMM, wrapping_u64(tag));
            }
        }
    }
    // dedicated slots: block parameters and values used outside their
    // defining block, in value order
    for v in 0..backend.value_count {
        let def_at = u64_at(in backend.def_block, v);
        let defined = def_at != NONE64 || is_param_def(in backend, in program, func, n32(v));
        if !defined || u8_at(in backend.loc_kinds, v) != L_UNDEF {
            continue;
        }
        let rep = u8_at(in backend.reprs, v);
        let min_use = u64_at(in backend.use_min, v);
        let max_use = u64_at(in backend.use_max, v);
        let used = min_use != NONE64;
        let cross = def_at == NONE64 || (used && (min_use != def_at || max_use != def_at));
        if rep == REP_UNIT {
            set_loc(inout backend, n32(v), L_NONE, 0);
        } else if cross {
            let cross_slot = take_slots(inout next, rep_slots(rep));
            set_loc(inout backend, n32(v), L_SLOT, w(cross_slot));
        }
    }
    // the block-local pool
    let base = next;
    let mut pool_max: u32 = 0;
    for block_index in 0..func.bc {
        let block = fn_block(in program, func, block_index);
        let stamp = inc(block_index);
        for k in 0..block.ic {
            let inst = block_inst(in program, block, k);
            op_uses(in program, inst, inout uses);
            for u in 0..uses.len() {
                let v = u32_at(in uses, u);
                grow_values(inout backend, v);
                set64(inout backend.last_use_inst, w(v), k);
                set64(inout backend.last_use_block, w(v), stamp);
            }
        }
        term_uses(in program, block, inout uses);
        for u in 0..uses.len() {
            let v = u32_at(in uses, u);
            grow_values(inout backend, v);
            set64(inout backend.last_use_inst, w(v), block.ic);
            set64(inout backend.last_use_block, w(v), stamp);
        }
        backend.free_slot.clear();
        backend.free_size.clear();
        let mut pool_top: u32 = 0;
        for k in 0..block.ic {
            let inst = block_inst(in program, block, k);
            let dest = inst.dest;
            if loc_kind(in backend, dest) == L_UNDEF {
                let size = rep_slots(vrep(in backend, dest));
                let mut slot = pool_top;
                let mut reused = false;
                for q in 0..backend.free_size.len() {
                    if u32_at(in backend.free_size, q) == size {
                        slot = u32_at(in backend.free_slot, q);
                        swap_remove(inout backend, q);
                        reused = true;
                        break;
                    }
                }
                if !reused {
                    pool_top = wrapping_add(pool_top, size);
                }
                if pool_top > pool_max {
                    pool_max = pool_top;
                }
                set_loc(inout backend, dest, L_SLOT, w(wrapping_add(base, slot)));
                if u64_at(in backend.last_use_block, w(dest)) != stamp {
                    backend.free_slot.push(slot);
                    backend.free_size.push(size);
                }
            }
            op_uses(in program, inst, inout uses);
            sort_dedup(inout uses);
            for u in 0..uses.len() {
                let v = u32_at(in uses, u);
                if u64_at(in backend.last_use_block, w(v)) == stamp
                    && u64_at(in backend.last_use_inst, w(v)) == k
                    && u64_at(in backend.def_block, w(v)) == block_index
                    && loc_kind(in backend, v) == L_SLOT
                    && loc_val(in backend, v) >= w(base) {
                    backend.free_slot.push(n32(wrapping_sub(loc_val(in backend, v), w(base))));
                    backend.free_size.push(rep_slots(vrep(in backend, v)));
                }
            }
        }
    }
    backend.slot_count = wrapping_add(base, pool_max);
    true
}

// Whether `v` is a block parameter of `func` (its `def_block` is
// `usize::MAX`, which NONE64 also means for "not defined").
fn is_param_def(in backend: G, in program: Program, func: FnRow, v: u32) -> bool {
    for block_index in 0..func.bc {
        let block = fn_block(in program, func, block_index);
        for k in 0..block_nparams(in program, block) {
            if block_param(in program, block, k) == v {
                // a later instruction dest overrides the parameter entry
                return true;
            }
        }
    }
    false
}

fn swap_remove(inout backend: G, index: u64) {
    let n = backend.free_slot.len();
    let last_slot = u32_at(in backend.free_slot, wrapping_sub(n, 1));
    let last_size = u32_at(in backend.free_size, wrapping_sub(n, 1));
    set32(inout backend.free_slot, index, last_slot);
    set32(inout backend.free_size, index, last_size);
    backend.free_slot.truncate(wrapping_sub(n, 1));
    backend.free_size.truncate(wrapping_sub(n, 1));
}

fn sort_dedup(inout seq: ChunkSeq[u32]) {
    let n = seq.len();
    for i in 1..n {
        let item = u32_at(in seq, i);
        let mut j = i;
        loop {
            if j == 0 {
                break;
            }
            let prev = u32_at(in seq, wrapping_sub(j, 1));
            if prev <= item {
                break;
            }
            set32(inout seq, j, prev);
            j = wrapping_sub(j, 1);
        }
        set32(inout seq, j, item);
    }
    let mut kept: u64 = 0;
    for i in 0..n {
        let item = u32_at(in seq, i);
        if i == 0 || item != u32_at(in seq, wrapping_sub(kept, 1)) {
            set32(inout seq, kept, item);
            kept = inc(kept);
        }
    }
    seq.truncate(kept);
}

// ----- emission -----------------------------------------------------------------------

fn mov_imm(inout backend: G, reg: u8, value: i64) {
    if value >= -2147483648 && value <= 2147483647 {
        backend.asm.mov_i(reg, wrapping_i32(value));
    } else {
        backend.asm.ld_imm64(reg, wrapping_u64(value));
    }
}

fn st(inout backend: G, slot: u32, reg: u8) {
    backend.asm.stx(Size::DW, R10, slot_off(slot), reg);
}

fn st_imm(inout backend: G, slot: u32, value: i32) {
    backend.asm.st(Size::DW, R10, slot_off(slot), value);
}

fn undefined(inout backend: G, in ctx: Ctx, v: u32, s0: u64, s1: u64) {
    err_at(inout backend, R_OPERATION, s0, s1);
    txt(inout backend.message, "value v");
    push_decimal(inout backend.message, w(v));
    txt(inout backend.message, " is not defined");
}

// `ld`: part `part` (0 scalar or tag, 1 payload) of `v` into `reg`.
fn ld(inout backend: G, in ctx: Ctx, reg: u8, v: u32, part: u32, s0: u64, s1: u64) -> bool {
    let kind = loc_kind(in backend, v);
    if kind == L_UNDEF {
        undefined(inout backend, in ctx, v, s0, s1);
        return false;
    }
    if kind == L_NONE {
        backend.asm.mov_i(reg, 0);
    } else if kind == L_IMM {
        let imm_value = if part == 0 {
            wrapping_i64(loc_val(in backend, v))
        } else {
            0
        };
        mov_imm(inout backend, reg, imm_value);
    } else {
        let slot = wrapping_add(n32(loc_val(in backend, v)), part);
        backend.asm.ldx(Size::DW, reg, R10, slot_off(slot));
    }
    true
}

// `dest_slot`: the slot of `v` (in `slot`), false without one; an
// undefined value is an error (`ok` false).
fn dest_slot(
    inout backend: G,
    in ctx: Ctx,
    v: u32,
    s0: u64,
    s1: u64,
    inout slot: u32,
    inout ok: bool
) -> bool {
    let kind = loc_kind(in backend, v);
    if kind == L_UNDEF {
        undefined(inout backend, in ctx, v, s0, s1);
        ok = false;
        return false;
    }
    ok = true;
    if kind == L_SLOT {
        slot = n32(loc_val(in backend, v));
        return true;
    }
    false
}

fn copy_to(inout backend: G, in ctx: Ctx, dst: u32, v: u32, parts: u32, s0: u64, s1: u64) -> bool {
    for part in 0..parts {
        if !ld(inout backend, in ctx, R1, v, part, s0, s1) {
            return false;
        }
        st(inout backend, wrapping_add(dst, part), R1);
    }
    true
}

// `LineTable::at` and `line`.
fn line(inout backend: G, in extra: Extra, offset: u64, force: bool) {
    if !extra.has_source {
        return;
    }
    // partition_point(s <= offset)
    let mut lo: u64 = 0;
    let mut hi = backend.line_starts.len();
    loop {
        if lo >= hi {
            break;
        }
        let mid = wrapping_add(lo, wrapping_sub(hi, lo) / 2);
        if u64_at(in backend.line_starts, mid) <= offset {
            lo = inc(mid);
        } else {
            hi = mid;
        }
    }
    let line_index = if lo < 1 { 0 } else { wrapping_sub(lo, 1) };
    let start = u64_at(in backend.line_starts, line_index);
    let n = extra.source.len();
    let mut end = start;
    loop {
        if end >= n || u8_at(in extra.source, end) == 10 {
            break;
        }
        end = inc(end);
    }
    let col = if offset > start {
        wrapping_sub(offset, start)
    } else {
        0
    };
    let line_num = n32(inc(line_index));
    if force || line_num != backend.last_line {
        let mut text_start = start;
        let mut text_end = end;
        loop {
            if text_start >= text_end || !space(u8_at(in extra.source, text_start)) {
                break;
            }
            text_start = inc(text_start);
        }
        loop {
            if text_end <= text_start || !space(u8_at(in extra.source, wrapping_sub(text_end, 1))) {
                break;
            }
            text_end = wrapping_sub(text_end, 1);
        }
        backend.asm.line(line_num, n32(inc(col)), text_start, text_end);
        backend.last_line = line_num;
    }
}

fn space(byte: u8) -> bool {
    byte == 32 || (byte >= 9 && byte <= 13)
}

fn asm_err_bind(inout backend: G, label: u64) -> bool {
    if backend.asm.bind(label) {
        return true;
    }
    fail_asm(inout backend);
    txt(inout backend.message, "label ");
    push_decimal(inout backend.message, label);
    txt(inout backend.message, " bound twice");
    false
}

// `emit`.
fn emit(
    inout backend: G,
    inout ctx: Ctx,
    in program: Program,
    in extra: Extra,
    func: FnRow
) -> bool {
    if backend.f_has_span {
        line(inout backend, in extra, backend.f_s0, true);
    }
    backend.asm.mov_reg(R9, R1);
    if !backend.f_entry {
        let mut arg_reg: u64 = 0;
        for param_index in 0..backend.params.len() {
            let param = param_at(in backend, param_index);
            let local_pos = wrapping_sub(local_index(in backend, param.name), 1);
            let rep = u8_at(in backend.local_rep, local_pos);
            if rep != REP_UNIT {
                st(
                    inout backend,
                    u32_at(in backend.local_slot, local_pos),
                    wrapping_add(R2, wrapping_u8(arg_reg))
                );
                arg_reg = inc(arg_reg);
            }
        }
    }
    if !asm_err_bind(inout backend, backend.loop_head) {
        return false;
    }
    for block_index in 0..func.bc {
        if !asm_err_bind(inout backend, u64_at(in backend.block_labels, block_index)) {
            return false;
        }
        let block = fn_block(in program, func, block_index);
        let mut ended = false;
        for k in 0..block.ic {
            let inst = block_inst(in program, block, k);
            line(inout backend, in extra, inst.s0, false);
            let mut tail = false;
            if !instruction(inout backend, inout ctx, in program, in extra, inst, inout tail) {
                return false;
            }
            if tail {
                ended = true;
                break;
            }
        }
        if !ended {
            if !terminator(inout backend, inout ctx, in program, func, block_index) {
                return false;
            }
        }
    }
    true
}

fn op_name(inout message: ChunkSeq[u8], op: u8) {
    let text = match op {
        0 => "constant",
        1 => "unit",
        2 => "read",
        3 => "bind",
        4 => "write",
        5 => "unary operator",
        6 => "binary operator",
        7 => "tuple",
        8 => "struct or variant value",
        9 => "field projection",
        10 => "indexing",
        11 => "call",
        12 => "indirect call",
        13 => "`?`",
        14 => "closure",
        15 => "effect handler",
        16 => "vector operation",
        17 => "tiled AoSoA sequence operation",
        18 => "ChunkSeq or Slice operation",
        19 => "FIP Box operation",
        20 => "loop",
        _ => "early return",
    };
    txt(inout message, text);
}

// `instruction`; `tail` is set when a tail self-call ended the block.
fn instruction(
    inout backend: G,
    inout ctx: Ctx,
    in program: Program,
    in extra: Extra,
    inst: InstRow,
    inout tail: bool
) -> bool {
    let s0 = inst.s0;
    let s1 = inst.s1;
    if inst.fallible != 0 {
        err_at(inout backend, R_FALLIBLE, s0, s1);
        txt(inout backend.message, "this ");
        op_name(inout backend.message, inst.op);
        txt(
            inout backend.message,
            " may raise Fail at run time: use wrapping_add/wrapping_sub/wrapping_mul, a nonzero constant divisor, or a guard the checker can see"
        );
        return false;
    }
    let operand_at = inst.a;
    let op = inst.op;
    if op == Op::Const || op == Op::Unit {
        return true;
    }
    if op == Op::Data {
        let rep = vrep(in backend, inst.dest);
        if rep == REP_ENUM || rep == REP_UNIT {
            return true;
        }
        if rep >= REP_OPT {
            let mut dest: u32 = 0;
            let mut ok = true;
            if !dest_slot(inout backend, in ctx, inst.dest, s0, s1, inout dest, inout ok) {
                return ok;
            }
            let ctor_name = pos32(in program, operand_at);
            let field_count = program.op(inc(operand_at));
            if field_count == 1 && last_is(in ctx.names, ctor_name, "Some") {
                if !ld(
                    inout backend,
                    in ctx,
                    R1,
                    pos32(in program, add(operand_at, 3)),
                    0,
                    s0,
                    s1
                ) {
                    return false;
                }
                st(inout backend, inc32(dest), R1);
                st_imm(inout backend, dest, 1);
            } else if field_count == 0 && last_is(in ctx.names, ctor_name, "None") {
                st_imm(inout backend, dest, 0);
                st_imm(inout backend, inc32(dest), 0);
            } else {
                err_at(inout backend, R_OPERATION, s0, s1);
                txt(inout backend.message, "constructor `");
                sym(inout backend.message, in ctx.names, ctor_name);
                backend.message.push(96);
                return false;
            }
            return true;
        }
        err_at(inout backend, R_OPERATION, s0, s1);
        txt(
            inout backend.message,
            "struct values are not supported at run time on the eBPF target"
        );
        return false;
    }
    if op == Op::Read {
        let root = pos32(in program, operand_at);
        if program.path(program.op(inc(operand_at))).n != 0 {
            err_at(inout backend, R_OPERATION, s0, s1);
            txt(inout backend.message, "field projections are not supported");
            return false;
        }
        let local_pos = local_index(in backend, root);
        if local_pos == 0 {
            err_at(inout backend, R_OPERATION, s0, s1);
            backend.message.push(96);
            sym(inout backend.message, in ctx.names, root);
            txt(
                inout backend.message,
                "` is not a local scalar (function values are not supported)"
            );
            return false;
        }
        let slot = u32_at(in backend.local_slot, wrapping_sub(local_pos, 1));
        let rep = u8_at(in backend.local_rep, wrapping_sub(local_pos, 1));
        let mut dest: u32 = 0;
        let mut ok = true;
        if dest_slot(inout backend, in ctx, inst.dest, s0, s1, inout dest, inout ok) {
            for part in 0..rep_slots(rep) {
                backend.asm.ldx(Size::DW, R1, R10, slot_off(wrapping_add(slot, part)));
                st(inout backend, wrapping_add(dest, part), R1);
            }
        }
        return ok;
    }
    if op == Op::Bind {
        return bind(
            inout backend,
            in ctx,
            in program,
            inc(operand_at),
            pos32(in program, operand_at),
            s0,
            s1
        );
    }
    if op == Op::Write {
        let place = pos32(in program, operand_at);
        let assign_op = pos32(in program, inc(operand_at));
        let value = pos32(in program, add(operand_at, 2));
        let local_pos = local_index(in backend, place);
        if local_pos == 0 {
            err_at(inout backend, R_OPERATION, s0, s1);
            txt(inout backend.message, "assignment to `");
            sym(inout backend.message, in ctx.names, place);
            txt(inout backend.message, "`: only whole scalar locals are writable");
            return false;
        }
        let slot = u32_at(in backend.local_slot, wrapping_sub(local_pos, 1));
        let rep = u8_at(in backend.local_rep, wrapping_sub(local_pos, 1));
        if is(in ctx.names, assign_op, "=") {
            return copy_to(inout backend, in ctx, slot, value, rep_slots(rep), s0, s1);
        }
        if rep < REP_SCALAR || rep >= REP_ENUM {
            err_at(inout backend, R_OPERATION, s0, s1);
            backend.message.push(96);
            sym(inout backend.message, in ctx.names, assign_op);
            txt(inout backend.message, "` on a non-scalar");
            return false;
        }
        backend.asm.ldx(Size::DW, R1, R10, slot_off(slot));
        if !ld(inout backend, in ctx, R2, value, 0, s0, s1) {
            return false;
        }
        // the operator without its trailing `=`
        let n = ctx.names.size(assign_op);
        let mut bin_op: ChunkSeq[u8] = ChunkSeq::new[u8]();
        for part in 0..n {
            bin_op.push(ctx.names.byte(assign_op, part));
        }
        if n > 0 && u8_at(in bin_op, wrapping_sub(n, 1)) == 61 {
            bin_op.truncate(wrapping_sub(n, 1));
        }
        if !arith(inout backend, in ctx, in bin_op, wrapping_sub(rep, REP_SCALAR), s0, s1) {
            return false;
        }
        st(inout backend, slot, R1);
        return true;
    }
    if op == Op::Unary {
        let unary_op = pos32(in program, operand_at);
        let mut dest: u32 = 0;
        let mut ok = true;
        let has_dest = dest_slot(inout backend, in ctx, inst.dest, s0, s1, inout dest, inout ok);
        if !ok {
            return false;
        }
        if !ld(inout backend, in ctx, R1, pos32(in program, inc(operand_at)), 0, s0, s1) {
            return false;
        }
        let rep = vrep(in backend, inst.dest);
        if is(in ctx.names, unary_op, "!") && rep == add8(REP_SCALAR, S_BOOL) {
            backend.asm.alu64(AluOp::Xor, R1, Operand::Imm(1));
        } else if is(in ctx.names, unary_op, "-") && rep == add8(REP_SCALAR, S_I64) {
            backend.asm.alu64(AluOp::Neg, R1, Operand::Imm(0));
        } else {
            err_at(inout backend, R_OPERATION, s0, s1);
            txt(inout backend.message, "unary `");
            sym(inout backend.message, in ctx.names, unary_op);
            backend.message.push(96);
            return false;
        }
        if has_dest {
            st(inout backend, dest, R1);
        }
        return true;
    }
    if op == Op::Binary {
        return binary(inout backend, inout ctx, in program, inst);
    }
    if op == Op::Call {
        return call(inout backend, inout ctx, in program, in extra, inst, inout tail);
    }
    err_at(inout backend, R_OPERATION, s0, s1);
    op_name(inout backend.message, op);
    txt(inout backend.message, " is not supported on the eBPF target");
    false
}

fn binary(inout backend: G, inout ctx: Ctx, in program: Program, inst: InstRow) -> bool {
    let s0 = inst.s0;
    let s1 = inst.s1;
    let operand_at = inst.a;
    let bin_op = pos32(in program, operand_at);
    let lhs = pos32(in program, inc(operand_at));
    let rhs = pos32(in program, add(operand_at, 2));
    let mut dest: u32 = 0;
    let mut ok = true;
    let has_dest = dest_slot(inout backend, in ctx, inst.dest, s0, s1, inout dest, inout ok);
    if !ok {
        return false;
    }
    let lhs_ty = vty(in backend, lhs);
    let operand = if lhs_ty != NONE32 {
        let rep = repr(inout backend, inout ctx, lhs_ty, backend.f_name, true, s0, s1);
        if rep == REP_BAD {
            return false;
        }
        rep
    } else {
        vrep(in backend, inst.dest)
    };
    if !ld(inout backend, in ctx, R1, lhs, 0, s0, s1) {
        return false;
    }
    if !ld(inout backend, in ctx, R2, rhs, 0, s0, s1) {
        return false;
    }
    let eq = is(in ctx.names, bin_op, "==");
    let ne = is(in ctx.names, bin_op, "!=");
    if operand >= REP_OPT && operand != REP_BAD {
        if !(eq || ne) {
            err_at(inout backend, R_OPERATION, s0, s1);
            backend.message.push(96);
            sym(inout backend.message, in ctx.names, bin_op);
            txt(inout backend.message, "` on an Option");
            return false;
        }
        // equal tags, and equal payloads when both are Some
        let done = backend.asm.label();
        let equal = backend.asm.label();
        if !ld(inout backend, in ctx, R3, lhs, 1, s0, s1) {
            return false;
        }
        if !ld(inout backend, in ctx, R4, rhs, 1, s0, s1) {
            return false;
        }
        backend.asm.mov_i(R0, 0);
        backend.asm.jmp_reg(JmpOp::Ne, R1, R2, done);
        backend.asm.jmp_i(JmpOp::Eq, R1, 0, equal);
        backend.asm.jmp_reg(JmpOp::Ne, R3, R4, done);
        if !asm_err_bind(inout backend, equal) {
            return false;
        }
        backend.asm.mov_i(R0, 1);
        if !asm_err_bind(inout backend, done) {
            return false;
        }
        if ne {
            backend.asm.alu64(AluOp::Xor, R0, Operand::Imm(1));
        }
        if has_dest {
            st(inout backend, dest, R0);
        }
        return true;
    }
    let signed = operand == add8(REP_SCALAR, S_I64);
    let mut is_cmp = true;
    let cmp = if eq {
        JmpOp::Eq
    } else if ne {
        JmpOp::Ne
    } else if is(in ctx.names, bin_op, "<") {
        if signed { JmpOp::SLt } else { JmpOp::Lt }
    } else if is(in ctx.names, bin_op, "<=") {
        if signed { JmpOp::SLe } else { JmpOp::Le }
    } else if is(in ctx.names, bin_op, ">") {
        if signed { JmpOp::SGt } else { JmpOp::Gt }
    } else if is(in ctx.names, bin_op, ">=") {
        if signed { JmpOp::SGe } else { JmpOp::Ge }
    } else {
        is_cmp = false;
        JmpOp::Eq
    };
    if is_cmp {
        let done = backend.asm.label();
        backend.asm.mov_i(R0, 1);
        backend.asm.jmp_reg(cmp, R1, R2, done);
        backend.asm.mov_i(R0, 0);
        if !asm_err_bind(inout backend, done) {
            return false;
        }
        if has_dest {
            st(inout backend, dest, R0);
        }
        return true;
    }
    if operand < REP_SCALAR || operand >= REP_ENUM {
        err_at(inout backend, R_OPERATION, s0, s1);
        backend.message.push(96);
        sym(inout backend.message, in ctx.names, bin_op);
        txt(inout backend.message, "` on a non-scalar");
        return false;
    }
    let mut op_text: ChunkSeq[u8] = ChunkSeq::new[u8]();
    ctx.names.write(bin_op, inout op_text);
    if !arith(inout backend, in ctx, in op_text, wrapping_sub(operand, REP_SCALAR), s0, s1) {
        return false;
    }
    if has_dest {
        st(inout backend, dest, R1);
    }
    true
}

fn bytes_are(in bytes: ChunkSeq[u8], in lit: Str) -> bool {
    let want = lit.as_bytes();
    if bytes.len() != want.len() {
        return false;
    }
    for i in 0..want.len() {
        let want_byte = match want.try_get(i) {
            Option::Some(v) => v,
            Option::None => 0,
        };
        if u8_at(in bytes, i) != want_byte {
            return false;
        }
    }
    true
}

// `arith`: r1 = r1 <op> r2, wrapping at the width of scalar `scalar`.
fn arith(inout backend: G, in ctx: Ctx, in op: ChunkSeq[u8], scalar: u8, s0: u64, s1: u64) -> bool {
    let mut div = false;
    let alu = if bytes_are(in op, "+") || bytes_are(in op, "wrapping_add") {
        AluOp::Add
    } else if bytes_are(in op, "-") || bytes_are(in op, "wrapping_sub") {
        AluOp::Sub
    } else if bytes_are(in op, "*") || bytes_are(in op, "wrapping_mul") {
        AluOp::Mul
    } else if bytes_are(in op, "/") {
        div = true;
        AluOp::Div
    } else if bytes_are(in op, "%") {
        div = true;
        AluOp::Mod
    } else if bytes_are(in op, "&&") {
        AluOp::And
    } else if bytes_are(in op, "||") {
        AluOp::Or
    } else {
        err_at(inout backend, R_OPERATION, s0, s1);
        txt(inout backend.message, "operator `");
        backend.message.extend(in op.as_slice());
        backend.message.push(96);
        return false;
    };
    if div && scalar == S_I64 {
        err_at(inout backend, R_OPERATION, s0, s1);
        txt(
            inout backend.message,
            "signed division needs eBPF v4 sdiv/smod, which the target does not use"
        );
        return false;
    }
    if scalar == S_U32 {
        backend.asm.alu32(alu, R1, Operand::Reg(R2));
    } else if scalar == S_U8 {
        backend.asm.alu64(alu, R1, Operand::Reg(R2));
        backend.asm.alu64(AluOp::And, R1, Operand::Imm(255));
    } else {
        backend.asm.alu64(alu, R1, Operand::Reg(R2));
    }
    true
}

// `bind` of the pattern at `at` to `value`.
fn bind(
    inout backend: G,
    in ctx: Ctx,
    in program: Program,
    at: u64,
    value: u32,
    s0: u64,
    s1: u64
) -> bool {
    let kind = program.op(at);
    if kind == Pat::Wild || kind == Pat::Literal {
        return true;
    }
    if kind == Pat::Bind {
        let name = pos32(in program, add(at, 3));
        let local_pos = local_index(in backend, name);
        if local_pos == 0 {
            err_at(inout backend, R_OPERATION, s0, s1);
            txt(inout backend.message, "binding `");
            sym(inout backend.message, in ctx.names, name);
            backend.message.push(96);
            return false;
        }
        let slot = u32_at(in backend.local_slot, wrapping_sub(local_pos, 1));
        let rep = u8_at(in backend.local_rep, wrapping_sub(local_pos, 1));
        return copy_to(inout backend, in ctx, slot, value, rep_slots(rep), s0, s1);
    }
    if kind == Pat::Constructor {
        let name = pos32(in program, add(at, 3));
        let field_count = program.op(add(at, 5));
        let rep = vrep(in backend, value);
        if rep >= REP_OPT
            && rep != REP_BAD
            && field_count == 1
            && last_is(in ctx.names, name, "Some") {
            let sub_at = add(at, 7);
            let sub_kind = program.op(sub_at);
            if sub_kind == Pat::Bind {
                let bind_name = pos32(in program, add(sub_at, 3));
                let local_pos = local_index(in backend, bind_name);
                if local_pos == 0 {
                    err_at(inout backend, R_OPERATION, s0, s1);
                    txt(inout backend.message, "binding `");
                    sym(inout backend.message, in ctx.names, bind_name);
                    backend.message.push(96);
                    return false;
                }
                if !ld(inout backend, in ctx, R1, value, 1, s0, s1) {
                    return false;
                }
                st(inout backend, u32_at(in backend.local_slot, wrapping_sub(local_pos, 1)), R1);
                return true;
            }
            if sub_kind == Pat::Wild || sub_kind == Pat::Literal {
                return true;
            }
            err_at(inout backend, R_OPERATION, s0, s1);
            txt(inout backend.message, "nested pattern");
            return false;
        }
        if field_count == 0 {
            return true;
        }
        err_at(inout backend, R_OPERATION, s0, s1);
        txt(inout backend.message, "pattern `");
        sym(inout backend.message, in ctx.names, name);
        backend.message.push(96);
        return false;
    }
    err_at(inout backend, R_OPERATION, s0, s1);
    txt(inout backend.message, "tuple patterns");
    false
}

fn call(
    inout backend: G,
    inout ctx: Ctx,
    in program: Program,
    in extra: Extra,
    inst: InstRow,
    inout tail: bool
) -> bool {
    let s0 = inst.s0;
    let s1 = inst.s1;
    let callee = pos32(in program, inst.a);
    let args = inc(inst.a);
    let nargs = program.op(args);
    let eop_pos = eop_index(in backend, callee);
    if eop_pos != 0 {
        return effect_op(
            inout backend,
            in ctx,
            in program,
            eop_at(in backend, wrapping_sub(eop_pos, 1)),
            inst
        );
    }
    if bool_at(in backend.is_tail, w(inst.dest)) {
        // assign the parameters, jump back; the arguments live in value
        // slots, so no parameter is overwritten before it is read
        for param_index in 0..backend.params.len() {
            if param_index >= nargs {
                break;
            }
            let param = param_at(in backend, param_index);
            let local_pos = wrapping_sub(local_index(in backend, param.name), 1);
            let rep = u8_at(in backend.local_rep, local_pos);
            if rep != REP_UNIT {
                let arg = pos32(in program, add(args, add(2, wrapping_mul(param_index, 4))));
                if !ld(inout backend, in ctx, R1, arg, 0, s0, s1) {
                    return false;
                }
                st(inout backend, u32_at(in backend.local_slot, local_pos), R1);
            }
        }
        backend.asm.ja(backend.loop_head);
        tail = true;
        return true;
    }
    let pos = fn_pos(in backend, callee);
    if pos == 0 {
        err_at(inout backend, R_OPERATION, s0, s1);
        txt(inout backend.message, "call of `");
        sym(inout backend.message, in ctx.names, callee);
        backend.message.push(96);
        return false;
    }
    let label = u64_at(in backend.fn_label, wrapping_sub(pos, 1));
    let mut has_span = false;
    let callee_fn = world_fn(in extra, callee, inout has_span);
    let mut arg_reg: u64 = 0;
    for param_index in 0..callee_fn.param_count {
        if param_index >= nargs {
            break;
        }
        let callee_param = extra.param(add(callee_fn.param_start, param_index));
        let at = add(args, add(1, wrapping_mul(param_index, 4)));
        if wrapping_u8(program.op(at)) == TyPass::Inout {
            err_at(inout backend, R_CALL, s0, s1);
            txt(inout backend.message, "inout arguments are not supported");
            return false;
        }
        let rep = repr(inout backend, inout ctx, callee_param.ty, backend.f_name, true, s0, s1);
        if rep == REP_BAD {
            return false;
        }
        if rep != REP_UNIT {
            if arg_reg >= ARG_REGS {
                fail(inout backend, R_CALL, callee, has_span, callee_fn.s0, callee_fn.s1);
                txt(
                    inout backend.message,
                    "a BPF subprogram takes at most 4 scalar parameters besides the context"
                );
                return false;
            }
            if !ld(
                inout backend,
                in ctx,
                wrapping_add(R2, wrapping_u8(arg_reg)),
                pos32(in program, inc(at)),
                0,
                s0,
                s1
            ) {
                return false;
            }
            arg_reg = inc(arg_reg);
        }
    }
    backend.asm.mov_reg(R1, R9);
    backend.asm.call_local(label);
    let mut dest: u32 = 0;
    let mut ok = true;
    if dest_slot(inout backend, in ctx, inst.dest, s0, s1, inout dest, inout ok) {
        if vrep(in backend, inst.dest) >= REP_OPT {
            // payload in the low 32 bits, tag above
            backend.asm.mov_reg(R1, R0);
            backend.asm.alu64(AluOp::Rsh, R1, Operand::Imm(32));
            st(inout backend, dest, R1);
            backend.asm.alu32(AluOp::Mov, R0, Operand::Reg(R0));
            st(inout backend, inc32(dest), R0);
        } else {
            st(inout backend, dest, R0);
        }
    }
    ok
}

fn key_ptr(inout backend: G, reg: u8) {
    backend.asm.mov_reg(reg, R10);
    backend.asm.add_i(reg, widen_i32(slot_off(backend.key_slot)));
}

fn val_ptr(inout backend: G, reg: u8) {
    backend.asm.mov_reg(reg, R10);
    backend.asm.add_i(reg, widen_i32(slot_off(backend.val_slot)));
}

fn update_with(inout backend: G, map: u64, flags: i32) {
    backend.asm.ld_map(R1, map);
    key_ptr(inout backend, R2);
    val_ptr(inout backend, R3);
    backend.asm.mov_i(R4, flags);
    backend.asm.call(H_UPDATE);
}

fn value_size(scalar: u8) -> Size {
    if scalar == S_U8 {
        Size::B
    } else if scalar == S_U32 {
        Size::W
    } else {
        Size::DW
    }
}

fn arg_value(in program: Program, inst: InstRow, k: u64) -> u32 {
    pos32(in program, add(inc(inst.a), add(2, wrapping_mul(k, 4))))
}

// `effect`: a recognised effect operation.
fn effect_op(inout backend: G, in ctx: Ctx, in program: Program, eop: EOp, inst: InstRow) -> bool {
    let s0 = inst.s0;
    let s1 = inst.s1;
    let mut dest: u32 = 0;
    let mut ok = true;
    let has_dest = dest_slot(inout backend, in ctx, inst.dest, s0, s1, inout dest, inout ok);
    if !ok {
        return false;
    }
    if eop.kind == EO_PACKET {
        if !has_dest {
            return true;
        }
        let data: i16 = if backend.action == 0 { 0 } else { 76 };
        let data_end: i16 = if backend.action == 0 { 4 } else { 80 };
        let none = backend.asm.label();
        let done = backend.asm.label();
        backend.asm.ldx(Size::W, R2, R9, data);
        backend.asm.ldx(Size::W, R3, R9, data_end);
        let offset_arg = arg_value(in program, inst, 0);
        let kind = loc_kind(in backend, offset_arg);
        if kind == L_UNDEF {
            undefined(inout backend, in ctx, offset_arg, s0, s1);
            return false;
        }
        let const_off = wrapping_i64(loc_val(in backend, offset_arg));
        if kind == L_IMM && const_off >= 0 && const_off <= MAX_PACKET_OFF {
            backend.asm.add_i(R2, wrapping_i32(const_off));
        } else {
            if !ld(inout backend, in ctx, R1, offset_arg, 0, s0, s1) {
                return false;
            }
            backend.asm.jmp_i(JmpOp::Gt, R1, wrapping_i32(MAX_PACKET_OFF), none);
            backend.asm.add_reg(R2, R1);
        }
        // verifier-canonical guard: cursor + size > data_end -> none
        backend.asm.mov_reg(R4, R2);
        let bytes: i32 = if eop.packet == PK_U8 {
            1
        } else if eop.packet == PK_U16 {
            2
        } else {
            4
        };
        backend.asm.add_i(R4, bytes);
        backend.asm.jmp_reg(JmpOp::Gt, R4, R3, none);
        let size = if eop.packet == PK_U8 {
            Size::B
        } else if eop.packet == PK_U16 {
            Size::H
        } else {
            Size::W
        };
        backend.asm.ldx(size, R0, R2, 0);
        if eop.packet == PK_U16 {
            backend.asm.endian(Endian::ToBe, 16, R0);
        } else if eop.packet == PK_U32 {
            backend.asm.endian(Endian::ToBe, 32, R0);
        }
        st(inout backend, inc32(dest), R0);
        st_imm(inout backend, dest, 1);
        backend.asm.ja(done);
        if !asm_err_bind(inout backend, none) {
            return false;
        }
        st_imm(inout backend, dest, 0);
        st_imm(inout backend, inc32(dest), 0);
        return asm_err_bind(inout backend, done);
    }
    if eop.kind == EO_HELPER {
        backend.asm.call(eop.helper);
        if has_dest {
            if vrep(in backend, inst.dest) == add8(REP_SCALAR, S_U32) {
                backend.asm.alu32(AluOp::Mov, R0, Operand::Reg(R0));
            }
            st(inout backend, dest, R0);
        }
        return true;
    }
    // a map operation
    if !ld(inout backend, in ctx, R1, arg_value(in program, inst, 0), 0, s0, s1) {
        return false;
    }
    st(inout backend, backend.key_slot, R1);
    let value_width = value_size(eop.value);
    let array = eop.map_kind == MK_ARRAY || eop.map_kind == MK_PERCPU_ARRAY;
    if eop.map_op == MO_LOOKUP {
        let none = backend.asm.label();
        let done = backend.asm.label();
        backend.asm.ld_map(R1, eop.map);
        key_ptr(inout backend, R2);
        backend.asm.call(H_LOOKUP);
        if has_dest {
            backend.asm.jmp_i(JmpOp::Eq, R0, 0, none);
            backend.asm.ldx(value_width, R1, R0, 0);
            st(inout backend, inc32(dest), R1);
            st_imm(inout backend, dest, 1);
            backend.asm.ja(done);
            if !asm_err_bind(inout backend, none) {
                return false;
            }
            st_imm(inout backend, dest, 0);
            st_imm(inout backend, inc32(dest), 0);
            return asm_err_bind(inout backend, done);
        }
        if !asm_err_bind(inout backend, none) {
            return false;
        }
        return asm_err_bind(inout backend, done);
    }
    if eop.map_op == MO_UPDATE {
        if !ld(inout backend, in ctx, R1, arg_value(in program, inst, 1), 0, s0, s1) {
            return false;
        }
        st(inout backend, backend.val_slot, R1);
        update_with(inout backend, eop.map, BPF_ANY);
        return true;
    }
    if eop.map_op == MO_DELETE {
        backend.asm.ld_map(R1, eop.map);
        key_ptr(inout backend, R2);
        backend.asm.call(H_DELETE);
        return true;
    }
    // add
    let miss = backend.asm.label();
    let done = backend.asm.label();
    backend.asm.ld_map(R1, eop.map);
    key_ptr(inout backend, R2);
    backend.asm.call(H_LOOKUP);
    backend.asm.jmp_i(JmpOp::Eq, R0, 0, miss);
    if !ld(inout backend, in ctx, R1, arg_value(in program, inst, 1), 0, s0, s1) {
        return false;
    }
    backend.asm.atomic_add(value_width, R0, 0, R1);
    backend.asm.ja(done);
    if !asm_err_bind(inout backend, miss) {
        return false;
    }
    if !array {
        // first sighting: insert the delta only if the key is still
        // absent; if another CPU inserted it, look it up again and add
        if !ld(inout backend, in ctx, R1, arg_value(in program, inst, 1), 0, s0, s1) {
            return false;
        }
        st(inout backend, backend.val_slot, R1);
        update_with(inout backend, eop.map, BPF_NOEXIST);
        backend.asm.jmp_i(JmpOp::Eq, R0, 0, done);
        backend.asm.ld_map(R1, eop.map);
        key_ptr(inout backend, R2);
        backend.asm.call(H_LOOKUP);
        backend.asm.jmp_i(JmpOp::Eq, R0, 0, done);
        if !ld(inout backend, in ctx, R1, arg_value(in program, inst, 1), 0, s0, s1) {
            return false;
        }
        backend.asm.atomic_add(value_width, R0, 0, R1);
    }
    asm_err_bind(inout backend, done)
}

fn jump_to(inout backend: G, from: u64, to: u64) {
    if to != inc(from) {
        backend.asm.ja(u64_at(in backend.block_labels, to));
    }
}

// The integer value of the literal at `at` (`literal`).
fn literal_at(in program: Program, at: u64) -> i64 {
    let kind = program.op(at);
    if kind == Lit::Int || kind == Lit::Bool {
        wrapping_i64(program.op(inc(at)))
    } else {
        0
    }
}

// `terminator`.
fn terminator(
    inout backend: G,
    inout ctx: Ctx,
    in program: Program,
    func: FnRow,
    block_index: u64
) -> bool {
    let block = fn_block(in program, func, block_index);
    let s0 = if backend.f_has_span { backend.f_s0 } else { 0 };
    let s1 = if backend.f_has_span { backend.f_s1 } else { 0 };
    let term_at = block.ta;
    if block.term == Term::Return {
        let v = pos32(in program, term_at);
        let rep = vrep(in backend, v);
        if rep >= REP_OPT && rep != REP_BAD {
            if !ld(inout backend, in ctx, R0, v, 1, s0, s1) {
                return false;
            }
            if !ld(inout backend, in ctx, R1, v, 0, s0, s1) {
                return false;
            }
            backend.asm.alu64(AluOp::Lsh, R1, Operand::Imm(32));
            backend.asm.alu64(AluOp::Or, R0, Operand::Reg(R1));
        } else {
            if !ld(inout backend, in ctx, R0, v, 0, s0, s1) {
                return false;
            }
        }
        backend.asm.exit();
        return true;
    }
    if block.term == Term::Jump {
        let target_index = program.op(term_at);
        let target_block = fn_block(in program, func, target_index);
        let arg_count = program.op(inc(term_at));
        let param_count = block_nparams(in program, target_block);
        for k in 0..arg_count {
            if k >= param_count {
                break;
            }
            let param_value = block_param(in program, target_block, k);
            if loc_kind(in backend, param_value) == L_SLOT {
                let parts = rep_slots(vrep(in backend, param_value));
                if !copy_to(
                    inout backend,
                    in ctx,
                    n32(loc_val(in backend, param_value)),
                    pos32(in program, add(add(term_at, 2), k)),
                    parts,
                    s0,
                    s1
                ) {
                    return false;
                }
            }
        }
        jump_to(inout backend, block_index, target_index);
        return true;
    }
    if block.term == Term::Branch {
        if !ld(inout backend, in ctx, R1, pos32(in program, term_at), 0, s0, s1) {
            return false;
        }
        backend
            .asm
            .jmp_i(JmpOp::Ne, R1, 0, u64_at(in backend.block_labels, program.op(inc(term_at))));
        jump_to(inout backend, block_index, program.op(add(term_at, 2)));
        return true;
    }
    if block.term == Term::Match {
        let v = pos32(in program, term_at);
        let raw_rep = vrep(in backend, v);
        let rep = if raw_rep == REP_BAD {
            REP_UNIT
        } else {
            raw_rep
        };
        let ty = vty(in backend, v);
        if !ld(inout backend, in ctx, R1, v, 0, s0, s1) {
            return false;
        }
        let narms = program.op(inc(term_at));
        let mut at = add(term_at, 2);
        for k in 0..narms {
            let last = inc(k) == narms;
            let pat = at;
            let end = pat_end(in program, pat);
            let target = u64_at(in backend.block_labels, program.op(end));
            at = inc(end);
            let kind = program.op(pat);
            if kind == Pat::Wild || kind == Pat::Bind {
                backend.asm.ja(target);
                break;
            }
            if kind == Pat::Constructor && rep >= REP_OPT {
                let name = pos32(in program, add(pat, 3));
                let some = last_is(in ctx.names, name, "Some");
                let field_count = program.op(add(pat, 5));
                let sub_at = add(pat, 7);
                let sub_is_lit = field_count > 0 && program.op(sub_at) == Pat::Literal;
                if some && sub_is_lit {
                    let lit_value = literal_at(in program, add(sub_at, 3));
                    let next = backend.asm.label();
                    backend.asm.jmp_i(JmpOp::Ne, R1, 1, next);
                    if !ld(inout backend, in ctx, R2, v, 1, s0, s1) {
                        return false;
                    }
                    mov_imm(inout backend, R3, lit_value);
                    backend.asm.jmp_reg(JmpOp::Eq, R2, R3, target);
                    if !asm_err_bind(inout backend, next) {
                        return false;
                    }
                } else if some {
                    backend.asm.jmp_i(JmpOp::Eq, R1, 1, target);
                } else {
                    backend.asm.jmp_i(JmpOp::Eq, R1, 0, target);
                }
            } else if kind == Pat::Constructor && rep == REP_ENUM {
                let name = pos32(in program, add(pat, 3));
                let enum_ty = if ty == NONE32 { ctx.types.infer } else { ty };
                let tag = variant_tag(inout ctx, enum_ty, name);
                if tag < 0 {
                    err_at(
                        inout backend,
                        R_OPERATION,
                        program.op(inc(pat)),
                        program.op(add(pat, 2))
                    );
                    txt(inout backend.message, "unknown variant `");
                    sym(inout backend.message, in ctx.names, name);
                    backend.message.push(96);
                    return false;
                }
                mov_imm(inout backend, R2, tag);
                backend.asm.jmp_reg(JmpOp::Eq, R1, R2, target);
            } else if kind == Pat::Literal && rep >= REP_SCALAR && rep < REP_ENUM {
                mov_imm(inout backend, R2, literal_at(in program, add(pat, 3)));
                backend.asm.jmp_reg(JmpOp::Eq, R1, R2, target);
            } else {
                err_at(inout backend, R_OPERATION, program.op(inc(pat)), program.op(add(pat, 2)));
                txt(inout backend.message, "match pattern");
                return false;
            }
            if last {
                // exhaustive by checking; keep the fall-through edge out of
                // the next block's code
                backend.asm.ja(target);
            }
        }
        return true;
    }
    backend.asm.mov_i(R0, 0);
    backend.asm.exit();
    true
}
