// Module extra of @vesper/ebpf-backend (see lib.ves): the backend's task
// section, after the @vesper/place-ir program section. It carries what the
// backend reads from the checked `World` beyond check-data's tables: the
// options, the source text, the ADT spans, `world.functions` (signatures,
// effect rows, spans) and `world.effects` (operation signatures, spans).
// tests/self_host_ebpf_backend.rs (`ebpf_section`) writes it.
//
// Strings are a byte count and the bytes padded to words; they are
// interned into the context's names. Types are inline trees interned into
// the context's types (`read_ty`), so they need no index in the stream's
// own type table.

use @vesper/check-data::util::{add, inc32, n32, u32_at, w};
use @vesper/check-data::names::{Names};
use @vesper/check-data::types::{EffNode, Types, TyKind};
use @vesper/check-data::input::{Reader};
use @vesper/check-data::world::{set_by_symbol};

// A parameter of a `world.functions` entry.
pub copy struct XParam {
    name: u32,
    pass: u8,
    ty: u32,
    s0: u64,
    s1: u64,
}

// A `world.functions` entry: params[param_start..param_start+param_count],
// effect instance names eff_names[eff_start..eff_start+eff_count].
pub copy struct XFn {
    name: u32,
    s0: u64,
    s1: u64,
    generic_count: u64,
    param_start: u64,
    param_count: u64,
    result: u32,
    eff_start: u64,
    eff_count: u64,
    tail: bool,
}

// An operation of an effect declaration: parameter types
// op_params[param_start..param_start+param_count].
pub copy struct XOp {
    name: u32,
    s0: u64,
    s1: u64,
    param_start: u64,
    param_count: u64,
    result: u32,
}

// A `world.effects` entry: ops[op_start..op_start+op_count].
pub copy struct XEff {
    name: u32,
    generic_count: u64,
    s0: u64,
    s1: u64,
    op_start: u64,
    op_count: u64,
}

pub struct Extra {
    entry: u32,
    file: u32,
    has_source: bool,
    source: ChunkSeq[u8],
    // ADT spans, in check-data's ADT order
    adt_s0: ChunkSeq[u64],
    adt_s1: ChunkSeq[u64],
    fns: ChunkSeq[XFn],
    params: ChunkSeq[XParam],
    eff_names: ChunkSeq[u32],
    // symbol -> fns index + 1
    fn_by_name: ChunkSeq[u32],
    decls: ChunkSeq[XEff],
    ops: ChunkSeq[XOp],
    op_params: ChunkSeq[u32],
    // symbol -> decls index + 1
    decl_by_name: ChunkSeq[u32],
}

pub fn read_str(inout reader: Reader, in bytes: Slice[u8], inout names: Names) -> u32 {
    let len = reader.word(in bytes);
    let start = reader.pos;
    let end = add(start, len);
    let symbol = if end <= bytes.len() {
        names.intern(in bytes[start..end])
    } else {
        0
    };
    reader.pos = add(start, wrapping_mul(wrapping_add(len, 7) / 8, 8));
    symbol
}

fn read_row(
    inout reader: Reader,
    in bytes: Slice[u8],
    inout types: Types,
    inout names: Names
) -> u32 {
    let n = reader.word(in bytes);
    let mut nodes: ChunkSeq[EffNode] = ChunkSeq::new[EffNode]();
    let mut args: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..n {
        let has_label = reader.word(in bytes);
        let label = if has_label != 0 {
            inc32(read_str(inout reader, in bytes, inout names))
        } else {
            0
        };
        let name = read_str(inout reader, in bytes, inout names);
        let arg_count = reader.word(in bytes);
        let mut node_args: ChunkSeq[u32] = ChunkSeq::new[u32]();
        for j in 0..arg_count {
            let arg_ty = read_ty(inout reader, in bytes, inout types, inout names);
            node_args.push(arg_ty);
        }
        let arg_start = n32(args.len());
        for j in 0..node_args.len() {
            args.push(u32_at(in node_args, j));
        }
        nodes.push(EffNode { label: label, name: name, a: arg_start, n: n32(arg_count) });
    }
    let has_tail = reader.word(in bytes);
    let tail = if has_tail != 0 {
        inc32(read_str(inout reader, in bytes, inout names))
    } else {
        0
    };
    types.mk_row(in nodes, in args, tail)
}

// An inline type tree: 0 literal (neg, magnitude), 1 named (name, n,
// args), 2 tuple (n, items), 3 function (n, n x (pass, type), result, row,
// mode), 4 row, 5 infer.
pub fn read_ty(
    inout reader: Reader,
    in bytes: Slice[u8],
    inout types: Types,
    inout names: Names
) -> u32 {
    let kind = reader.word(in bytes);
    if kind == 0 {
        let neg = reader.word(in bytes) != 0;
        let magnitude = reader.word(in bytes);
        return types.literal(neg, magnitude);
    }
    if kind == 1 {
        let name = read_str(inout reader, in bytes, inout names);
        let n = reader.word(in bytes);
        let mut args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](n);
        for i in 0..n {
            let arg_ty = read_ty(inout reader, in bytes, inout types, inout names);
            args.push(arg_ty);
        }
        return types.named(name, in args);
    }
    if kind == 2 {
        let n = reader.word(in bytes);
        let mut args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](n);
        for i in 0..n {
            let arg_ty = read_ty(inout reader, in bytes, inout types, inout names);
            args.push(arg_ty);
        }
        return types.tuple(in args);
    }
    if kind == 3 {
        let n = reader.word(in bytes);
        let mut args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](n);
        let mut passes: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](n);
        for i in 0..n {
            passes.push(wrapping_u8(reader.word(in bytes)));
            let arg_ty = read_ty(inout reader, in bytes, inout types, inout names);
            args.push(arg_ty);
        }
        let result = read_ty(inout reader, in bytes, inout types, inout names);
        let row = read_row(inout reader, in bytes, inout types, inout names);
        let mode = wrapping_u8(reader.word(in bytes));
        return types.mk_with(TyKind::Fn, mode, 0, in args, in passes, result, row, 0);
    }
    if kind == 4 {
        let row = read_row(inout reader, in bytes, inout types, inout names);
        return types.row_type(row);
    }
    types.infer
}

pub fn read_extra(
    inout reader: Reader,
    in bytes: Slice[u8],
    inout types: Types,
    inout names: Names
) -> Extra {
    let entry = read_str(inout reader, in bytes, inout names);
    let file = read_str(inout reader, in bytes, inout names);
    let has_source = reader.word(in bytes) != 0;
    let mut source: ChunkSeq[u8] = ChunkSeq::new[u8]();
    if has_source {
        let len = reader.word(in bytes);
        let start = reader.pos;
        let end = add(start, len);
        if end <= bytes.len() {
            source.extend(in bytes[start..end]);
        }
        reader.pos = add(start, wrapping_mul(wrapping_add(len, 7) / 8, 8));
    }
    let mut extra = Extra {
        entry: entry,
        file: file,
        has_source: has_source,
        source: source,
        adt_s0: ChunkSeq::new[u64](),
        adt_s1: ChunkSeq::new[u64](),
        fns: ChunkSeq::new[XFn](),
        params: ChunkSeq::new[XParam](),
        eff_names: ChunkSeq::new[u32](),
        fn_by_name: ChunkSeq::new[u32](),
        decls: ChunkSeq::new[XEff](),
        ops: ChunkSeq::new[XOp](),
        op_params: ChunkSeq::new[u32](),
        decl_by_name: ChunkSeq::new[u32](),
    };
    let adt_count = reader.word(in bytes);
    for i in 0..adt_count {
        extra.adt_s0.push(reader.word(in bytes));
        extra.adt_s1.push(reader.word(in bytes));
    }
    let fn_count = reader.word(in bytes);
    for i in 0..fn_count {
        let name = read_str(inout reader, in bytes, inout names);
        let s0 = reader.word(in bytes);
        let s1 = reader.word(in bytes);
        let generic_count = reader.word(in bytes);
        let param_count = reader.word(in bytes);
        let param_start = extra.params.len();
        for j in 0..param_count {
            let param_name = read_str(inout reader, in bytes, inout names);
            let pass = wrapping_u8(reader.word(in bytes));
            let param_s0 = reader.word(in bytes);
            let param_s1 = reader.word(in bytes);
            let ty = read_ty(inout reader, in bytes, inout types, inout names);
            extra
                .params
                .push(XParam { name: param_name, pass: pass, ty: ty, s0: param_s0, s1: param_s1 });
        }
        let result = read_ty(inout reader, in bytes, inout types, inout names);
        let eff_count = reader.word(in bytes);
        let eff_start = extra.eff_names.len();
        for j in 0..eff_count {
            let eff_name = read_str(inout reader, in bytes, inout names);
            extra.eff_names.push(eff_name);
        }
        let tail = reader.word(in bytes) != 0;
        set_by_symbol(inout extra.fn_by_name, name, inc32(n32(extra.fns.len())));
        extra.fns.push(XFn {
            name: name,
            s0: s0,
            s1: s1,
            generic_count: generic_count,
            param_start: param_start,
            param_count: param_count,
            result: result,
            eff_start: eff_start,
            eff_count: eff_count,
            tail: tail
        });
    }
    let decl_count = reader.word(in bytes);
    for i in 0..decl_count {
        let name = read_str(inout reader, in bytes, inout names);
        let generic_count = reader.word(in bytes);
        let s0 = reader.word(in bytes);
        let s1 = reader.word(in bytes);
        let op_count = reader.word(in bytes);
        let op_start = extra.ops.len();
        for j in 0..op_count {
            let op_name = read_str(inout reader, in bytes, inout names);
            let op_s0 = reader.word(in bytes);
            let op_s1 = reader.word(in bytes);
            let param_count = reader.word(in bytes);
            let param_start = extra.op_params.len();
            for k in 0..param_count {
                let ty = read_ty(inout reader, in bytes, inout types, inout names);
                extra.op_params.push(ty);
            }
            let result = read_ty(inout reader, in bytes, inout types, inout names);
            extra.ops.push(XOp {
                name: op_name,
                s0: op_s0,
                s1: op_s1,
                param_start: param_start,
                param_count: param_count,
                result: result
            });
        }
        set_by_symbol(inout extra.decl_by_name, name, inc32(n32(extra.decls.len())));
        extra.decls.push(XEff {
            name: name,
            generic_count: generic_count,
            s0: s0,
            s1: s1,
            op_start: op_start,
            op_count: op_count
        });
    }
    extra
}

impl Extra {
    // The `world.functions` index of `name` + 1, or 0.
    pub fn fn_index(in self, name: u32) -> u64 {
        w(u32_at(in self.fn_by_name, w(name)))
    }

    pub fn func(in self, i: u64) -> XFn {
        match self.fns.try_get(i) {
            Option::Some(f) => f,
            Option::None => XFn {
                name: 0,
                s0: 0,
                s1: 0,
                generic_count: 0,
                param_start: 0,
                param_count: 0,
                result: 0,
                eff_start: 0,
                eff_count: 0,
                tail: false
            },
        }
    }

    pub fn param(in self, i: u64) -> XParam {
        match self.params.try_get(i) {
            Option::Some(p) => p,
            Option::None => XParam { name: 0, pass: 0, ty: 0, s0: 0, s1: 0 },
        }
    }

    pub fn decl_index(in self, name: u32) -> u64 {
        w(u32_at(in self.decl_by_name, w(name)))
    }

    pub fn decl(in self, i: u64) -> XEff {
        match self.decls.try_get(i) {
            Option::Some(d) => d,
            Option::None => XEff {
                name: 0,
                generic_count: 0,
                s0: 0,
                s1: 0,
                op_start: 0,
                op_count: 0
            },
        }
    }

    pub fn op(in self, i: u64) -> XOp {
        match self.ops.try_get(i) {
            Option::Some(o) => o,
            Option::None => XOp {
                name: 0,
                s0: 0,
                s1: 0,
                param_start: 0,
                param_count: 0,
                result: 0
            },
        }
    }
}
