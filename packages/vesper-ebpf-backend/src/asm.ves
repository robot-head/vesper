// Module asm of @vesper/ebpf-backend (see lib.ves): the part of
// `vesper_ebpf::Asm` (crates/vesper-ebpf/src/program.rs) the backend uses:
// labels with jump and local-call fixups, map declarations and their
// `LD_IMM64` relocations, named subprograms and line info. Instructions
// are encoded by the @vesper/ebpf port (`insn::encode`).

use @vesper/ebpf::insn::{
    AluOp,
    AtomicOp,
    CallTarget,
    Endian,
    Imm64,
    Insn,
    JmpOp,
    Operand,
    RawInsn,
    Size,
    encode
};

// A label that is not bound yet.
const UNBOUND: u64 = 18446744073709551615;
// `insn::class::JMP32`: a long `ja` keeps its offset in `imm`.
const CLASS_JMP32: u8 = 6;
const R10: u8 = 10;

pub copy struct MapRow {
    // the map's name (a symbol)
    name: u32,
    // 0 Hash, 1 Array, 2 PerCpuHash, 3 PerCpuArray, 4 LruHash
    kind: u8,
    key: u32,
    value: u32,
    max: u32,
    flags: u32,
}

pub copy struct LineRow {
    slot: u64,
    line: u32,
    col: u32,
    // the line's text: source[ta..tb]
    ta: u64,
    tb: u64,
}

pub copy struct Fix {
    at: u64,
    label: u64,
    call: bool,
}

pub struct Asm {
    slots: ChunkSeq[RawInsn],
    labels: ChunkSeq[u64],
    fixes: ChunkSeq[Fix],
    maps: ChunkSeq[MapRow],
    // (slot, map index) pairs
    relocs: ChunkSeq[u64],
    fn_names: ChunkSeq[u32],
    fn_labels: ChunkSeq[u64],
    lines: ChunkSeq[LineRow],
}

pub fn asm_new() -> Asm {
    Asm {
        slots: ChunkSeq::new[RawInsn](),
        labels: ChunkSeq::new[u64](),
        fixes: ChunkSeq::new[Fix](),
        maps: ChunkSeq::new[MapRow](),
        relocs: ChunkSeq::new[u64](),
        fn_names: ChunkSeq::new[u32](),
        fn_labels: ChunkSeq::new[u64](),
        lines: ChunkSeq::new[LineRow](),
    }
}

fn reg(r: u8) -> Operand {
    Operand::Reg(r)
}

fn imm(v: i32) -> Operand {
    Operand::Imm(v)
}

pub fn slot_at(in s: ChunkSeq[RawInsn], i: u64) -> RawInsn {
    match s.try_get(i) {
        Option::Some(r) => r,
        Option::None => RawInsn {
            code: 0,
            dst: 0,
            src: 0,
            off: 0,
            imm: 0
        },
    }
}

impl Asm {
    pub fn pc(in self) -> u64 {
        self.slots.len()
    }

    pub fn label(inout self) -> u64 {
        self.labels.push(UNBOUND);
        wrapping_sub(self.labels.len(), 1)
    }

    // `Asm::bind`; false when `l` is already bound.
    pub fn bind(inout self, l: u64) -> bool {
        let at = match self.labels.try_get(l) {
            Option::Some(x) => x,
            Option::None => 0,
        };
        if at != UNBOUND {
            return false;
        }
        let ok = self.labels.try_set(l, self.slots.len());
        true
    }

    pub fn insn(inout self, i: Insn) {
        let e = encode(i);
        self.slots.push(e.lo);
        if e.n == 2 {
            self.slots.push(e.hi);
        }
    }

    pub fn alu64(inout self, op: AluOp, dst: u8, src: Operand) {
        self
            .insn(
            Insn::Alu {
                wide: true,
                op: op,
                dst: dst,
                src: src
            }
        );
    }

    pub fn alu32(inout self, op: AluOp, dst: u8, src: Operand) {
        self
            .insn(
            Insn::Alu {
                wide: false,
                op: op,
                dst: dst,
                src: src
            }
        );
    }

    pub fn mov_reg(inout self, dst: u8, src: u8) {
        self.alu64(AluOp::Mov, dst, reg(src));
    }

    pub fn mov_i(inout self, dst: u8, v: i32) {
        self.alu64(AluOp::Mov, dst, imm(v));
    }

    pub fn add_reg(inout self, dst: u8, src: u8) {
        self.alu64(AluOp::Add, dst, reg(src));
    }

    pub fn add_i(inout self, dst: u8, v: i32) {
        self.alu64(AluOp::Add, dst, imm(v));
    }

    pub fn endian(inout self, kind: Endian, bits: u8, dst: u8) {
        self
            .insn(
            Insn::Endian {
                kind: kind,
                bits: bits,
                dst: dst
            }
        );
    }

    pub fn ld_imm64(inout self, dst: u8, v: u64) {
        self
            .insn(
            Insn::LdImm64 {
                dst: dst,
                imm: Imm64::Value(v)
            }
        );
    }

    pub fn ld_map(inout self, dst: u8, map: u64) {
        self.relocs.push(self.slots.len());
        self.relocs.push(map);
        self
            .insn(
            Insn::LdImm64 {
                dst: dst,
                imm: Imm64::MapFd(wrapping_i32(map))
            }
        );
    }

    pub fn ldx(inout self, size: Size, dst: u8, src: u8, off: i16) {
        self
            .insn(
            Insn::Ldx {
                size: size,
                dst: dst,
                src: src,
                off: off,
                sign_extend: false
            }
        );
    }

    pub fn stx(inout self, size: Size, dst: u8, off: i16, src: u8) {
        self
            .insn(
            Insn::Stx {
                size: size,
                dst: dst,
                src: src,
                off: off
            }
        );
    }

    pub fn st(inout self, size: Size, dst: u8, off: i16, v: i32) {
        self
            .insn(
            Insn::St {
                size: size,
                dst: dst,
                off: off,
                imm: v
            }
        );
    }

    pub fn atomic_add(inout self, size: Size, dst: u8, off: i16, src: u8) {
        self
            .insn(
            Insn::Atomic {
                size: size,
                op: AtomicOp::Add {
                    fetch: false
                },
                dst: dst,
                src: src,
                off: off
            }
        );
    }

    pub fn call(inout self, helper: i32) {
        self.insn(Insn::Call(CallTarget::Helper(helper)));
    }

    pub fn call_local(inout self, target: u64) {
        self
            .fixes
            .push(
            Fix {
                at: self.slots.len(),
                label: target,
                call: true
            }
        );
        self.insn(Insn::Call(CallTarget::Local(0)));
    }

    // `Asm::line`: the source position of the next instruction; a second
    // record for the same slot replaces the first (slots only grow, so
    // only the last record can share it).
    pub fn line(inout self, line: u32, col: u32, ta: u64, tb: u64) {
        let slot = self.slots.len();
        let n = self.lines.len();
        if n > 0 {
            let last = match self.lines.try_get(wrapping_sub(n, 1)) {
                Option::Some(l) => l.slot,
                Option::None => UNBOUND,
            };
            if last == slot {
                self.lines.truncate(wrapping_sub(n, 1));
            }
        }
        self
            .lines
            .push(
            LineRow {
                slot: slot,
                line: line,
                col: col,
                ta: ta,
                tb: tb
            }
        );
    }

    pub fn function(inout self, name: u32, entry: u64) {
        self.fn_names.push(name);
        self.fn_labels.push(entry);
    }

    pub fn exit(inout self) {
        self.insn(Insn::Exit);
    }

    pub fn ja(inout self, target: u64) {
        self
            .fixes
            .push(
            Fix {
                at: self.slots.len(),
                label: target,
                call: false
            }
        );
        self
            .insn(
            Insn::Ja {
                off: 0
            }
        );
    }

    pub fn jmp(inout self, op: JmpOp, dst: u8, src: Operand, target: u64) {
        self
            .fixes
            .push(
            Fix {
                at: self.slots.len(),
                label: target,
                call: false
            }
        );
        self
            .insn(
            Insn::Jcond {
                wide: true,
                op: op,
                dst: dst,
                src: src,
                off: 0
            }
        );
    }

    pub fn jmp_i(inout self, op: JmpOp, dst: u8, v: i32, target: u64) {
        self.jmp(op, dst, imm(v), target);
    }

    pub fn jmp_reg(inout self, op: JmpOp, dst: u8, src: u8, target: u64) {
        self.jmp(op, dst, reg(src), target);
    }

    pub fn resolve(in self, l: u64) -> u64 {
        match self.labels.try_get(l) {
            Option::Some(x) => x,
            Option::None => UNBOUND,
        }
    }

    // `Asm::finish`'s fixups: 0 when every fixup resolves, else 1 for an
    // unbound label (`bad` is the label) or 2 for a jump out of range
    // (`bad` is the slot).
    pub fn fix_up(inout self, inout bad: u64) -> u8 {
        for k in 0..self.fixes.len() {
            let f = match self.fixes.try_get(k) {
                Option::Some(x) => x,
                Option::None => Fix {
                    at: 0,
                    label: 0,
                    call: false
                },
            };
            let target = self.resolve(f.label);
            if target == UNBOUND {
                bad = f.label;
                return 1;
            }
            let rel = wrapping_sub(wrapping_i64(target), wrapping_add(wrapping_i64(f.at), 1));
            let s = slot_at(in self.slots, f.at);
            let wide_imm = f.call || s.code == CLASS_JMP32;
            if wide_imm {
                if rel < -2147483648 || rel > 2147483647 {
                    bad = f.at;
                    return 2;
                }
                let ok = self
                    .slots
                    .try_set(
                    f.at,
                    RawInsn {
                        code: s.code,
                        dst: s.dst,
                        src: s.src,
                        off: s.off,
                        imm: wrapping_i32(rel)
                    }
                );
            } else {
                if rel < -32768 || rel > 32767 {
                    bad = f.at;
                    return 2;
                }
                let ok = self
                    .slots
                    .try_set(
                    f.at,
                    RawInsn {
                        code: s.code,
                        dst: s.dst,
                        src: s.src,
                        off: wrapping_i16(rel),
                        imm: s.imm
                    }
                );
            }
        }
        0
    }
}

// `slot_off`: the frame offset of 8-byte slot `slot` below r10, with the
// Rust `i16` arithmetic (wrapping, as a release build does).
pub fn slot_off(slot: u32) -> i16 {
    let s = wrapping_add(wrapping_i16(slot), 1);
    let z: i16 = 0;
    wrapping_sub(z, wrapping_mul(8, s))
}

pub fn fp() -> u8 {
    R10
}
