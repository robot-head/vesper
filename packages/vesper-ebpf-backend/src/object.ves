// Module object of @vesper/ebpf-backend (see lib.ves): what
// `vesper build --target bpf` does after lowering (#1895), so the Vesper
// driver builds the object itself. `vesper_ebpf::verify` through the
// @vesper/ebpf verifier, `Compiled::object` (vesper_ebpf::elf::write_object
// with `btf_ext::build` or `maps_btf`) and the summary of
// src/ebpf_backend.rs `build_command`.
//
// Only what the compiler's programs use is written: no kfuncs, CO-RE
// relocations or attach targets (the backend emits none). The ELF layout
// is the `object` crate's (0.37) for a relocatable little-endian BPF
// file: sections in the order they are added, each with its `.rel`
// section after it when it has relocations, then `.symtab`, `.strtab`
// and `.shstrtab`; string tables sorted by reversed bytes with suffixes
// merged.

use @vesper/check-data::util::{push_decimal, u32_at, u64_at, u8_at, w};
use @vesper/check-data::names::{Names};
use @vesper/ebpf::insn::{RawInsn};
use @vesper/ebpf::program::{MapKind, ProgramType, map_validate};
use @vesper/ebpf::verifier::{Outcome, new_pools, verify_program};
use self::asm::{MapRow, LineRow, slot_at};
use self::backend::{G};
use self::extra::{Extra};

// BTF (src/btf.rs) and `.BTF.ext` (src/btf_ext.rs) constants.
const BTF_MAGIC: u64 = 60319;
const BTF_HDR_LEN: u64 = 24;
const EXT_HDR_LEN: u64 = 32;
const KIND_INT: u32 = 1;
const KIND_PTR: u32 = 2;
const KIND_ARRAY: u32 = 3;
const KIND_STRUCT: u32 = 4;
const KIND_FUNC: u32 = 12;
const KIND_FUNC_PROTO: u32 = 13;
const KIND_VAR: u32 = 14;
const KIND_DATASEC: u32 = 15;
const FUNC_STATIC: u32 = 0;
const FUNC_GLOBAL: u32 = 1;
const VAR_GLOBAL_ALLOCATED: u32 = 1;
const FUNC_REC_SIZE: u32 = 8;
const LINE_REC_SIZE: u32 = 16;
const CORE_REC_SIZE: u32 = 16;
const LINE_COL_MASK: u32 = 1023;
const LINE_LIMIT: u32 = 4194304;

// ELF constants.
const ET_REL: u64 = 1;
const EM_BPF: u64 = 247;
const SHT_PROGBITS: u32 = 1;
const SHT_SYMTAB: u32 = 2;
const SHT_STRTAB: u32 = 3;
const SHT_REL: u32 = 9;
const SHF_WRITE: u64 = 1;
const SHF_ALLOC: u64 = 2;
const SHF_EXECINSTR: u64 = 4;
const SHF_INFO_LINK: u64 = 64;
const STT_OBJECT: u8 = 1;
const STT_FUNC: u8 = 2;
const STB_GLOBAL: u8 = 16;
const R_BPF_64_64: u64 = 1;
const HEADER: u64 = 64;
const SECTION_HEADER: u64 = 64;
const SYM: u64 = 24;
const REL: u64 = 16;

// `PT_REGS_SIZE` of x86-64 (only kprobe contexts read it; the backend
// writes XDP and tc programs) and the default `VerifierPolicy`.
const PT_REGS: i64 = 168;
const MAX_INSNS: u64 = 1000000;
const MAX_STATES: u64 = 64;

// Why the build was left to Rust (any of them reruns the Rust pass).
const D_COMPILE: u64 = 1;
const D_MAP: u64 = 2;
const D_VERIFY: u64 = 3;
const D_LINE: u64 = 4;
const D_NAME: u64 = 5;

// ------------------------------------------------------------------ bytes

fn put16(inout out: ChunkSeq[u8], value: u64) {
    out.push(wrapping_u8(value & 255));
    out.push(wrapping_u8(wrapping_shr_u64(value, 8) & 255));
}

fn put32(inout out: ChunkSeq[u8], value: u64) {
    for k in 0..4 {
        out.push(wrapping_u8(wrapping_shr_u64(value, wrapping_mul(wrapping_u32(k), 8)) & 255));
    }
}

fn put64(inout out: ChunkSeq[u8], value: u64) {
    for k in 0..8 {
        out.push(wrapping_u8(wrapping_shr_u64(value, wrapping_mul(wrapping_u32(k), 8)) & 255));
    }
}

fn pad_to(inout out: ChunkSeq[u8], align: u64) {
    if align > 1 {
        loop {
            if (out.len() & wrapping_sub(align, 1)) == 0 {
                break;
            }
            out.push(0);
        }
    }
}

fn align_up(offset: u64, align: u64) -> u64 {
    if align <= 1 {
        return offset;
    }
    let rem = offset & wrapping_sub(align, 1);
    if rem == 0 {
        offset
    } else {
        wrapping_add(offset, wrapping_sub(align, rem))
    }
}

fn same(in a: Slice[u8], in b: Slice[u8]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for i in 0..a.len() {
        if u8_of(in a, i) != u8_of(in b, i) {
            return false;
        }
    }
    true
}

fn u8_of(in bytes: Slice[u8], i: u64) -> u8 {
    bytes.try_get(i).unwrap_or(0)
}

// ---------------------------------------------------------------- program

// The assembled program with its strings in one pool: string k of a list
// is pool[x_start[k]..x_end[k]] (`name_start`/`name_end` for a single one).
struct Prog {
    pool: ChunkSeq[u8],
    name_start: u64,
    name_end: u64,
    section_start: u64,
    section_end: u64,
    file_start: u64,
    file_end: u64,
    xdp: bool,
    insns: ChunkSeq[RawInsn],
    map_name_start: ChunkSeq[u64],
    map_name_end: ChunkSeq[u64],
    map_kind: ChunkSeq[u8],
    map_key: ChunkSeq[u32],
    map_value: ChunkSeq[u32],
    map_max: ChunkSeq[u32],
    map_flags: ChunkSeq[u32],
    // (slot, map) pairs
    relocs: ChunkSeq[u64],
    fn_name_start: ChunkSeq[u64],
    fn_name_end: ChunkSeq[u64],
    fn_slot: ChunkSeq[u64],
    line_slot: ChunkSeq[u64],
    line_text_start: ChunkSeq[u64],
    line_text_end: ChunkSeq[u64],
    line_number: ChunkSeq[u32],
    line_col: ChunkSeq[u32],
    bind_effect_start: ChunkSeq[u64],
    bind_effect_end: ChunkSeq[u64],
}

fn pool_sym(inout prog: Prog, in names: Names, symbol: u32) -> (u64, u64) {
    let start = prog.pool.len();
    names.write(symbol, inout prog.pool);
    (start, prog.pool.len())
}

fn pool_bytes(inout prog: Prog, in bytes: Slice[u8]) -> (u64, u64) {
    let start = prog.pool.len();
    prog.pool.extend(in bytes);
    (start, prog.pool.len())
}

fn prog_of(in backend: G, in names: Names, in extra: Extra) -> Prog {
    let mut prog = Prog {
        pool: ChunkSeq::new[u8](),
        name_start: 0,
        name_end: 0,
        section_start: 0,
        section_end: 0,
        file_start: 0,
        file_end: 0,
        xdp: backend.action == 0,
        insns: ChunkSeq::new[RawInsn](),
        map_name_start: ChunkSeq::new[u64](),
        map_name_end: ChunkSeq::new[u64](),
        map_kind: ChunkSeq::new[u8](),
        map_key: ChunkSeq::new[u32](),
        map_value: ChunkSeq::new[u32](),
        map_max: ChunkSeq::new[u32](),
        map_flags: ChunkSeq::new[u32](),
        relocs: ChunkSeq::new[u64](),
        fn_name_start: ChunkSeq::new[u64](),
        fn_name_end: ChunkSeq::new[u64](),
        fn_slot: ChunkSeq::new[u64](),
        line_slot: ChunkSeq::new[u64](),
        line_text_start: ChunkSeq::new[u64](),
        line_text_end: ChunkSeq::new[u64](),
        line_number: ChunkSeq::new[u32](),
        line_col: ChunkSeq::new[u32](),
        bind_effect_start: ChunkSeq::new[u64](),
        bind_effect_end: ChunkSeq::new[u64](),
    };
    let (start, end) = pool_bytes(inout prog, in backend.name.as_slice());
    prog.name_start = start;
    prog.name_end = end;
    let section = if prog.xdp { "xdp" } else { "classifier" };
    let (start, end) = pool_bytes(inout prog, in section.as_bytes());
    prog.section_start = start;
    prog.section_end = end;
    let (start, end) = pool_sym(inout prog, in names, extra.file);
    prog.file_start = start;
    prog.file_end = end;
    for i in 0..backend.asm.slots.len() {
        prog.insns.push(slot_at(in backend.asm.slots, i));
    }
    for i in 0..backend.asm.maps.len() {
        match backend.asm.maps.try_get(i) {
            Option::Some(map_row) => {
                let (start, end) = pool_sym(inout prog, in names, map_row.name);
                prog.map_name_start.push(start);
                prog.map_name_end.push(end);
                prog.map_kind.push(map_row.kind);
                prog.map_key.push(map_row.key);
                prog.map_value.push(map_row.value);
                prog.map_max.push(map_row.max);
                prog.map_flags.push(map_row.flags);
            },
            Option::None => (),
        }
    }
    for i in 0..backend.asm.relocs.len() {
        prog.relocs.push(u64_at(in backend.asm.relocs, i));
    }
    for i in 0..backend.asm.fn_names.len() {
        let (start, end) = pool_sym(inout prog, in names, u32_at(in backend.asm.fn_names, i));
        prog.fn_name_start.push(start);
        prog.fn_name_end.push(end);
        prog.fn_slot.push(backend.asm.resolve(u64_at(in backend.asm.fn_labels, i)));
    }
    for i in 0..backend.asm.lines.len() {
        match backend.asm.lines.try_get(i) {
            Option::Some(line_row) => {
                let start = prog.pool.len();
                for k in line_row.text_start..line_row.text_end {
                    prog.pool.push(u8_at(in extra.source, k));
                }
                prog.line_slot.push(line_row.slot);
                prog.line_text_start.push(start);
                prog.line_text_end.push(prog.pool.len());
                prog.line_number.push(line_row.line);
                prog.line_col.push(line_row.col);
            },
            Option::None => (),
        }
    }
    for i in 0..backend.map_effects.len() {
        let (start, end) = pool_sym(inout prog, in names, u32_at(in backend.map_effects, i));
        prog.bind_effect_start.push(start);
        prog.bind_effect_end.push(end);
    }
    prog
}

// The backend's map kind (asm.ves `MapRow.kind`).
fn map_kind(kind: u8) -> MapKind {
    if kind == 0 {
        MapKind::Hash
    } else if kind == 1 {
        MapKind::ArrayMap
    } else if kind == 2 {
        MapKind::PerCpuHash
    } else if kind == 3 {
        MapKind::PerCpuArray
    } else {
        MapKind::LruHash
    }
}

fn kernel_type(kind: u8) -> u32 {
    if kind == 0 {
        1
    } else if kind == 1 {
        2
    } else if kind == 2 {
        5
    } else if kind == 3 {
        6
    } else {
        9
    }
}

// `MapKind`'s `Debug` name.
fn kind_name(kind: u8) -> Str {
    if kind == 0 {
        "Hash"
    } else if kind == 1 {
        "Array"
    } else if kind == 2 {
        "PerCpuHash"
    } else if kind == 3 {
        "PerCpuArray"
    } else {
        "LruHash"
    }
}

fn seq64(in seq: ChunkSeq[u64], i: u64) -> u64 {
    u64_at(in seq, i)
}

// ----------------------------------------------------------------- verify

// `vesper_ebpf::verify` (src/port.rs): the map checks, then the verifier.
// The outcome words on acceptance, or None on any rejection.
fn verify(in prog: Prog) -> Option[ChunkSeq[u64]] {
    let mut maps: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut text: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for i in 0..prog.map_name_start.len() {
        let name_start = seq64(in prog.map_name_start, i);
        let name_end = seq64(in prog.map_name_end, i);
        let name = match String::from_utf8(in prog.pool[name_start..name_end]) {
            Option::Some(s) => s,
            Option::None => return Option::None,
        };
        let kind = u8_at(in prog.map_kind, i);
        let rule = map_validate(
            in name.as_str(),
            map_kind(kind),
            u32_at(in prog.map_key, i),
            u32_at(in prog.map_value, i),
            u32_at(in prog.map_max, i)
        );
        if rule != 0 {
            return Option::None;
        }
        maps.push(w(kernel_type(kind)));
        maps.push(w(u32_at(in prog.map_key, i)));
        maps.push(w(u32_at(in prog.map_value, i)));
        maps.push(w(u32_at(in prog.map_max, i)));
        maps.push(text.len());
        maps.push(wrapping_sub(name_end, name_start));
        text.extend(in prog.pool[name_start..name_end]);
    }
    let kfuncs: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut pools = new_pools();
    let prog_type = if prog.xdp {
        ProgramType::Xdp
    } else {
        ProgramType::SchedCls
    };
    let outcome = verify_program(
        in prog.insns.as_slice(),
        prog_type,
        PT_REGS,
        true,
        in maps.as_slice(),
        in kfuncs.as_slice(),
        in text.as_slice(),
        MAX_INSNS,
        MAX_STATES,
        true,
        inout pools
    );
    if seq64(in outcome.words, 0) != 0 {
        return Option::None;
    }
    Option::Some(outcome.words)
}

// -------------------------------------------------------------------- BTF

// `BtfBuilder` (src/btf.rs): types, strings (each added once) and the
// number of types.
struct Btf {
    types: ChunkSeq[u8],
    strings: ChunkSeq[u8],
    str_offsets: ChunkSeq[u64],
    str_lens: ChunkSeq[u64],
    count: u32,
}

fn btf_new() -> Btf {
    let mut btf = Btf {
        types: ChunkSeq::new[u8](),
        strings: ChunkSeq::new[u8](),
        str_offsets: ChunkSeq::new[u64](),
        str_lens: ChunkSeq::new[u64](),
        count: 0,
    };
    btf.strings.push(0);
    btf
}

fn btf_str(inout btf: Btf, in bytes: Slice[u8]) -> u32 {
    let len = bytes.len();
    if len == 0 {
        return 0;
    }
    for k in 0..btf.str_offsets.len() {
        let offset = seq64(in btf.str_offsets, k);
        if seq64(in btf.str_lens, k) == len
            && same(in btf.strings[offset..wrapping_add(offset, len)], in bytes)
        {
            return wrapping_u32(offset);
        }
    }
    let offset = btf.strings.len();
    btf.strings.extend(in bytes);
    btf.strings.push(0);
    btf.str_offsets.push(offset);
    btf.str_lens.push(len);
    wrapping_u32(offset)
}

fn btf_word(inout btf: Btf, value: u32) {
    put32(inout btf.types, w(value));
}

fn btf_header(inout btf: Btf, name: u32, kind: u32, vlen: u32, size_or_type: u32) -> u32 {
    btf_word(inout btf, name);
    btf_word(inout btf, wrapping_shl_u32(kind, 24) | (vlen & 65535));
    btf_word(inout btf, size_or_type);
    btf.count = wrapping_add(btf.count, 1);
    btf.count
}

fn btf_int(inout btf: Btf, in name: Str, size: u32, signed: bool) -> u32 {
    let name_off = btf_str(inout btf, in name.as_bytes());
    let type_id = btf_header(inout btf, name_off, KIND_INT, 0, size);
    let encoding: u32 = if signed { 16777216 } else { 0 };
    btf_word(inout btf, encoding | wrapping_mul(size, 8));
    type_id
}

fn btf_finish(in btf: Btf) -> ChunkSeq[u8] {
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    put16(inout out, BTF_MAGIC);
    out.push(1);
    out.push(0);
    put32(inout out, BTF_HDR_LEN);
    put32(inout out, 0);
    put32(inout out, btf.types.len());
    put32(inout out, btf.types.len());
    put32(inout out, btf.strings.len());
    out.extend(in btf.types.as_slice());
    out.extend(in btf.strings.as_slice());
    out
}

// The `__uint()` members of map k (`map_fields`): (name, value) pairs.
fn field_count(in prog: Prog, k: u64) -> u64 {
    if u32_at(in prog.map_flags, k) != 0 {
        5
    } else {
        4
    }
}

fn field_name(field: u64) -> Str {
    if field == 0 {
        "type"
    } else if field == 1 {
        "key_size"
    } else if field == 2 {
        "value_size"
    } else if field == 3 {
        "max_entries"
    } else {
        "map_flags"
    }
}

fn field_value(in prog: Prog, k: u64, field: u64) -> u32 {
    if field == 0 {
        kernel_type(u8_at(in prog.map_kind, k))
    } else if field == 1 {
        u32_at(in prog.map_key, k)
    } else if field == 2 {
        u32_at(in prog.map_value, k)
    } else if field == 3 {
        u32_at(in prog.map_max, k)
    } else {
        u32_at(in prog.map_flags, k)
    }
}

// The `.maps` types (`maps_btf`, and the start of `btf_ext::build`): each
// map's offset in `.maps`, and the section size.
fn maps_types(inout btf: Btf, in prog: Prog, inout offsets: ChunkSeq[u64]) -> u64 {
    let int_ty = btf_int(inout btf, in "int", 4, true);
    let mut ptr_value: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut ptr_type: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut vars: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut at: u64 = 0;
    for k in 0..prog.map_name_start.len() {
        let member_count = field_count(in prog, k);
        let mut member_types: ChunkSeq[u32] = ChunkSeq::new[u32]();
        for field in 0..member_count {
            let member_value = field_value(in prog, k, field);
            let mut ptr_ty: u32 = 0;
            let mut found = false;
            for j in 0..ptr_value.len() {
                if !found && u32_at(in ptr_value, j) == member_value {
                    ptr_ty = u32_at(in ptr_type, j);
                    found = true;
                }
            }
            if !found {
                let array_ty = btf_header(inout btf, 0, KIND_ARRAY, 0, 0);
                btf_word(inout btf, int_ty);
                btf_word(inout btf, int_ty);
                btf_word(inout btf, member_value);
                ptr_ty = btf_header(inout btf, 0, KIND_PTR, 0, array_ty);
                ptr_value.push(member_value);
                ptr_type.push(ptr_ty);
            }
            member_types.push(ptr_ty);
        }
        let size = wrapping_u32(wrapping_mul(8, member_count));
        let mut member_names: ChunkSeq[u32] = ChunkSeq::new[u32]();
        for field in 0..member_count {
            let member_name = btf_str(inout btf, in field_name(field).as_bytes());
            member_names.push(member_name);
        }
        let struct_ty = btf_header(inout btf, 0, KIND_STRUCT, wrapping_u32(member_count), size);
        for field in 0..member_count {
            btf_word(inout btf, u32_at(in member_names, field));
            btf_word(inout btf, u32_at(in member_types, field));
            btf_word(inout btf, wrapping_u32(wrapping_mul(field, 64)));
        }
        let name_start = seq64(in prog.map_name_start, k);
        let name_end = seq64(in prog.map_name_end, k);
        let var_name = btf_str(inout btf, in prog.pool[name_start..name_end]);
        let var_ty = btf_header(inout btf, var_name, KIND_VAR, 0, struct_ty);
        btf_word(inout btf, VAR_GLOBAL_ALLOCATED);
        vars.push(var_ty);
        vars.push(wrapping_u32(at));
        vars.push(size);
        offsets.push(at);
        at = wrapping_add(at, w(size));
    }
    let var_count = vars.len() / 3;
    if var_count > 0 {
        let sec_name = btf_str(inout btf, in ".maps".as_bytes());
        let datasec = btf_header(
            inout btf,
            sec_name,
            KIND_DATASEC,
            wrapping_u32(var_count),
            wrapping_u32(at)
        );
        for i in 0..vars.len() {
            btf_word(inout btf, u32_at(in vars, i));
        }
    }
    at
}

// `btf::subprog_starts`: 0 and the targets of local calls and
// `BPF_PSEUDO_FUNC` loads, sorted, each once.
fn subprog_starts(in prog: Prog) -> ChunkSeq[u64] {
    let n = prog.insns.len();
    let mut starts: ChunkSeq[u64] = ChunkSeq::new[u64]();
    starts.push(0);
    for pc in 0..n {
        let insn = slot_at(in prog.insns, pc);
        let local_call = insn.code == 133 && insn.src == 1;
        let func_load = insn.code == 24 && insn.src == 4;
        if local_call || func_load {
            let target = wrapping_add(wrapping_add(wrapping_i64(pc), 1), widen_i64(insn.imm));
            if target >= 0 && target < wrapping_i64(n) {
                insert_sorted(inout starts, wrapping_u64(target));
            }
        }
    }
    starts
}

fn insert_sorted(inout seq: ChunkSeq[u64], value: u64) {
    let n = seq.len();
    let mut at = n;
    for k in 0..n {
        let item = seq64(in seq, k);
        if item == value {
            return;
        }
        if at == n && item > value {
            at = k;
        }
    }
    seq.push(0);
    let mut k = n;
    loop {
        if k <= at {
            break;
        }
        let prev = seq64(in seq, wrapping_sub(k, 1));
        let ok = seq.try_set(k, prev);
        k = wrapping_sub(k, 1);
    }
    let ok = seq.try_set(at, value);
}

// `c_identifier`: bytes other than ASCII letters, digits and `_` become
// `_`, and a leading `_` when empty or starting with a digit. False for a
// name that is not ASCII (Rust maps each character, not each byte).
fn c_identifier(in name: Slice[u8], inout out: ChunkSeq[u8]) -> bool {
    let n = name.len();
    let first = u8_of(in name, 0);
    if n == 0 || (first >= 48 && first <= 57) {
        out.push(95);
    }
    for i in 0..n {
        let byte = u8_of(in name, i);
        if byte >= 128 {
            return false;
        }
        let ok = (byte >= 48 && byte <= 57)
            || (byte >= 65 && byte <= 90)
            || (byte >= 97 && byte <= 122)
            || byte == 95;
        if ok {
            out.push(byte);
        } else {
            out.push(95);
        }
    }
    true
}

// `add_func_types`: the FUNC of every subprogram; the (slot, type id)
// pairs, or false for a name `c_identifier` maps per character.
fn func_types(inout btf: Btf, in prog: Prog, inout infos: ChunkSeq[u64]) -> bool {
    let int_ty = btf_int(inout btf, in "int", 4, true);
    let u64_ty = btf_int(inout btf, in "unsigned long long", 8, false);
    let void_ptr = btf_header(inout btf, 0, KIND_PTR, 0, 0);
    let ctx_name = btf_str(inout btf, in "ctx".as_bytes());
    let main_proto = btf_header(inout btf, 0, KIND_FUNC_PROTO, 1, int_ty);
    btf_word(inout btf, ctx_name);
    btf_word(inout btf, void_ptr);
    let a1_name = btf_str(inout btf, in "a1".as_bytes());
    let a2_name = btf_str(inout btf, in "a2".as_bytes());
    let sub_proto = btf_header(inout btf, 0, KIND_FUNC_PROTO, 2, int_ty);
    btf_word(inout btf, a1_name);
    btf_word(inout btf, u64_ty);
    btf_word(inout btf, a2_name);
    btf_word(inout btf, void_ptr);
    let starts = subprog_starts(in prog);
    for k in 0..starts.len() {
        let start = seq64(in starts, k);
        let mut name: ChunkSeq[u8] = ChunkSeq::new[u8]();
        let mut named = false;
        for fn_index in 0..prog.fn_slot.len() {
            if !named && seq64(in prog.fn_slot, fn_index) == start {
                let name_start = seq64(in prog.fn_name_start, fn_index);
                let name_end = seq64(in prog.fn_name_end, fn_index);
                name.extend(in prog.pool[name_start..name_end]);
                named = true;
            }
        }
        if !named {
            if start == 0 {
                name.extend(in prog.pool[prog.name_start..prog.name_end]);
            } else {
                name.extend(in "sub_".as_bytes());
                push_decimal(inout name, start);
            }
        }
        let mut id_bytes: ChunkSeq[u8] = ChunkSeq::new[u8]();
        if !c_identifier(in name.as_slice(), inout id_bytes) {
            return false;
        }
        let name_off = btf_str(inout btf, in id_bytes.as_slice());
        let (proto, linkage) = if start == 0 {
            (main_proto, FUNC_GLOBAL)
        } else {
            (sub_proto, FUNC_STATIC)
        };
        let id = btf_header(inout btf, name_off, KIND_FUNC, linkage, proto);
        infos.push(start);
        infos.push(w(id));
    }
    true
}

// A `.BTF.ext` subsection: the record size, then (section, count,
// records) when there are records.
fn subsection(
    inout out: ChunkSeq[u8],
    rec_size: u32,
    sec: u32,
    in records: ChunkSeq[u32],
    words: u64
) {
    put32(inout out, w(rec_size));
    let count = if words == 2 {
        records.len() / 2
    } else {
        records.len() / 4
    };
    if count > 0 {
        put32(inout out, w(sec));
        put32(inout out, count);
        for i in 0..records.len() {
            put32(inout out, w(u32_at(in records, i)));
        }
    }
}

// `btf_ext::build` for a program without kfuncs or CO-RE relocations:
// `.BTF`, `.BTF.ext`, the map offsets and the `.maps` size; false when a
// line or a function name is out of what Rust writes the same way.
fn object_btf(
    in prog: Prog,
    inout btf: ChunkSeq[u8],
    inout ext: ChunkSeq[u8],
    inout offsets: ChunkSeq[u64],
    inout maps_size: u64
) -> u64 {
    let mut builder = btf_new();
    maps_size = maps_types(inout builder, in prog, inout offsets);
    let mut infos: ChunkSeq[u64] = ChunkSeq::new[u64]();
    if !func_types(inout builder, in prog, inout infos) {
        return D_NAME;
    }
    let mut lines: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..prog.line_slot.len() {
        let line = u32_at(in prog.line_number, i);
        let col = u32_at(in prog.line_col, i);
        if col > LINE_COL_MASK || line >= LINE_LIMIT {
            return D_LINE;
        }
        lines.push(wrapping_u32(wrapping_mul(seq64(in prog.line_slot, i), 8)));
        lines.push(btf_str(inout builder, in prog.pool[prog.file_start..prog.file_end]));
        let text_start = seq64(in prog.line_text_start, i);
        let text_end = seq64(in prog.line_text_end, i);
        lines.push(btf_str(inout builder, in prog.pool[text_start..text_end]));
        lines.push(wrapping_shl_u32(line, 10) | col);
    }
    let sec_name = btf_str(inout builder, in prog.pool[prog.section_start..prog.section_end]);
    let mut func_info: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for k in 0..infos.len() / 2 {
        func_info.push(wrapping_u32(wrapping_mul(seq64(in infos, wrapping_mul(k, 2)), 8)));
        func_info.push(wrapping_u32(seq64(in infos, wrapping_add(wrapping_mul(k, 2), 1))));
    }
    let core: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut func_sec: ChunkSeq[u8] = ChunkSeq::new[u8]();
    subsection(inout func_sec, FUNC_REC_SIZE, sec_name, in func_info, 2);
    let mut line_sec: ChunkSeq[u8] = ChunkSeq::new[u8]();
    subsection(inout line_sec, LINE_REC_SIZE, sec_name, in lines, 4);
    let mut core_sec: ChunkSeq[u8] = ChunkSeq::new[u8]();
    subsection(inout core_sec, CORE_REC_SIZE, sec_name, in core, 4);
    put16(inout ext, BTF_MAGIC);
    ext.push(1);
    ext.push(0);
    put32(inout ext, EXT_HDR_LEN);
    put32(inout ext, 0);
    put32(inout ext, func_sec.len());
    put32(inout ext, func_sec.len());
    put32(inout ext, line_sec.len());
    put32(inout ext, wrapping_add(func_sec.len(), line_sec.len()));
    put32(inout ext, core_sec.len());
    ext.extend(in func_sec.as_slice());
    ext.extend(in line_sec.as_slice());
    ext.extend(in core_sec.as_slice());
    let bytes = btf_finish(in builder);
    btf.extend(in bytes.as_slice());
    0
}

// -------------------------------------------------------------------- ELF

// An `object` string table: the strings in insertion order (each once),
// written sorted by their bytes from the end, descending, a string that
// ends the previous one sharing its bytes.
struct Strtab {
    bytes: ChunkSeq[u8],
    a: ChunkSeq[u64],
    b: ChunkSeq[u64],
    offsets: ChunkSeq[u64],
}

fn strtab_new() -> Strtab {
    Strtab {
        bytes: ChunkSeq::new[u8](),
        a: ChunkSeq::new[u64](),
        b: ChunkSeq::new[u64](),
        offsets: ChunkSeq::new[u64](),
    }
}

// The id of `bytes`.
fn strtab_add(inout table: Strtab, in bytes: Slice[u8]) -> u64 {
    for k in 0..table.a.len() {
        let start = seq64(in table.a, k);
        let end = seq64(in table.b, k);
        if same(in table.bytes[start..end], in bytes) {
            return k;
        }
    }
    let start = table.bytes.len();
    table.bytes.extend(in bytes);
    table.a.push(start);
    table.b.push(table.bytes.len());
    wrapping_sub(table.a.len(), 1)
}

// The byte of string k `pos` bytes from its end (1 is the last), 0 past
// its start.
fn back_byte(in table: Strtab, k: u64, pos: u64) -> u8 {
    let start = seq64(in table.a, k);
    let end = seq64(in table.b, k);
    let len = wrapping_sub(end, start);
    if pos > len {
        0
    } else {
        u8_at(in table.bytes, wrapping_sub(end, pos))
    }
}

// String j goes before string k.
fn before(in table: Strtab, j: u64, k: u64) -> bool {
    let mut pos: u64 = 1;
    loop {
        let j_byte = back_byte(in table, j, pos);
        let k_byte = back_byte(in table, k, pos);
        if j_byte != k_byte {
            return j_byte > k_byte;
        }
        if j_byte == 0 {
            return false;
        }
        pos = wrapping_add(pos, 1);
    }
}

// `StringTable::write` after a NUL: the table's bytes, and each id's
// offset in `t.offsets`.
fn strtab_write(inout table: Strtab) -> ChunkSeq[u8] {
    let n = table.a.len();
    let mut ids: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for k in 0..n {
        // insertion sort
        let mut at = ids.len();
        for i in 0..ids.len() {
            if at == ids.len() && before(in table, k, seq64(in ids, i)) {
                at = i;
            }
        }
        ids.push(0);
        let mut i = wrapping_sub(ids.len(), 1);
        loop {
            if i <= at {
                break;
            }
            let prev = seq64(in ids, wrapping_sub(i, 1));
            let ok = ids.try_set(i, prev);
            i = wrapping_sub(i, 1);
        }
        let ok = ids.try_set(at, k);
    }
    let mut offsets: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for k in 0..n {
        offsets.push(0);
    }
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    out.push(0);
    let mut prev_start: u64 = 0;
    let mut prev_end: u64 = 0;
    for i in 0..n {
        let id = seq64(in ids, i);
        let start = seq64(in table.a, id);
        let end = seq64(in table.b, id);
        let len = wrapping_sub(end, start);
        let prev_len = wrapping_sub(prev_end, prev_start);
        let mut suffix = len <= prev_len;
        if suffix {
            for k in 0..len {
                if u8_at(in table.bytes, wrapping_add(start, k))
                    != u8_at(in table.bytes, wrapping_add(wrapping_sub(prev_end, len), k))
                {
                    suffix = false;
                }
            }
        }
        if suffix {
            let ok = offsets.try_set(id, wrapping_sub(wrapping_sub(out.len(), len), 1));
        } else {
            let ok = offsets.try_set(id, out.len());
            out.extend(in table.bytes[start..end]);
            out.push(0);
            prev_start = start;
            prev_end = end;
        }
    }
    table.offsets = offsets;
    out
}

fn str_offset(in table: Strtab, id: u64) -> u64 {
    seq64(in table.offsets, id)
}

// One added section: its name (shstrtab id), data, alignment, flags, and
// its relocation section's name id (u64::MAX without relocations).
struct Sections {
    names: ChunkSeq[u64],
    data_start: ChunkSeq[u64],
    data_end: ChunkSeq[u64],
    align: ChunkSeq[u64],
    flags: ChunkSeq[u64],
    rel_name: ChunkSeq[u64],
    data: ChunkSeq[u8],
}

const NONE: u64 = 18446744073709551615;

fn add_section(
    inout sections: Sections,
    inout shstrtab: Strtab,
    in name: Slice[u8],
    in data: Slice[u8],
    align: u64,
    flags: u64,
    rels: bool
) {
    sections.names.push(strtab_add(inout shstrtab, in name));
    if rels {
        let mut rel_label: ChunkSeq[u8] = ChunkSeq::new[u8]();
        rel_label.extend(in ".rel".as_bytes());
        rel_label.extend(in name);
        sections.rel_name.push(strtab_add(inout shstrtab, in rel_label.as_slice()));
    } else {
        sections.rel_name.push(NONE);
    }
    let start = sections.data.len();
    sections.data.extend(in data);
    sections.data_start.push(start);
    sections.data_end.push(sections.data.len());
    sections.align.push(align);
    sections.flags.push(flags);
}

// `Compiled::object` (`elf::write_object`).
fn write_object(in prog: Prog, inout out: ChunkSeq[u8]) -> u64 {
    // Program code with the map relocations' immediates cleared.
    let mut insns: ChunkSeq[RawInsn] = ChunkSeq::new[RawInsn]();
    for i in 0..prog.insns.len() {
        insns.push(slot_at(in prog.insns, i));
    }
    let reloc_count = prog.relocs.len() / 2;
    for reloc in 0..reloc_count {
        let at = seq64(in prog.relocs, wrapping_mul(reloc, 2));
        let reloc_insn = slot_at(in insns, at);
        let ok = insns.try_set(
            at,
            RawInsn {
                code: reloc_insn.code,
                dst: reloc_insn.dst,
                src: reloc_insn.src,
                off: reloc_insn.off,
                imm: 0
            }
        );
    }
    let mut code: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for i in 0..insns.len() {
        let raw = slot_at(in insns, i);
        let off = widen_u64(wrapping_u16(raw.off));
        let imm = widen_u64(wrapping_u32(raw.imm));
        code.push(raw.code);
        code.push((raw.dst & 15) | wrapping_shl_u8(raw.src & 15, 4));
        put16(inout code, off);
        put32(inout code, imm);
    }
    let mut shstrtab = strtab_new();
    let mut sections = Sections {
        names: ChunkSeq::new[u64](),
        data_start: ChunkSeq::new[u64](),
        data_end: ChunkSeq::new[u64](),
        align: ChunkSeq::new[u64](),
        flags: ChunkSeq::new[u64](),
        rel_name: ChunkSeq::new[u64](),
        data: ChunkSeq::new[u8](),
    };
    // Sections: 0 text, 1 license, then .BTF/.BTF.ext and .maps.
    add_section(
        inout sections,
        inout shstrtab,
        in prog.pool[prog.section_start..prog.section_end],
        in code.as_slice(),
        8,
        SHF_ALLOC | SHF_EXECINSTR,
        reloc_count > 0
    );
    let mut license: ChunkSeq[u8] = ChunkSeq::new[u8]();
    license.extend(in "Dual MIT/GPL".as_bytes());
    license.push(0);
    add_section(
        inout sections,
        inout shstrtab,
        in "license".as_bytes(),
        in license.as_slice(),
        1,
        SHF_ALLOC | SHF_WRITE,
        false
    );
    let map_count = prog.map_name_start.len();
    let starts = subprog_starts(in prog);
    let rich = prog.line_slot.len() > 0 || starts.len() > 1;
    let mut btf: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut ext: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut offsets: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut maps_size: u64 = 0;
    if rich {
        let reason = object_btf(in prog, inout btf, inout ext, inout offsets, inout maps_size);
        if reason != 0 {
            return reason;
        }
        add_section(
            inout sections,
            inout shstrtab,
            in ".BTF".as_bytes(),
            in btf.as_slice(),
            4,
            0,
            false
        );
        add_section(
            inout sections,
            inout shstrtab,
            in ".BTF.ext".as_bytes(),
            in ext.as_slice(),
            4,
            0,
            false
        );
    } else if map_count > 0 {
        let mut builder = btf_new();
        maps_size = maps_types(inout builder, in prog, inout offsets);
        btf = btf_finish(in builder);
    }
    let mut maps_index: u64 = 0;
    if map_count > 0 {
        let mut zeros: ChunkSeq[u8] = ChunkSeq::new[u8]();
        zeros.resize(maps_size, 0);
        maps_index = sections.names.len();
        add_section(
            inout sections,
            inout shstrtab,
            in ".maps".as_bytes(),
            in zeros.as_slice(),
            8,
            SHF_ALLOC | SHF_WRITE,
            false
        );
        if !rich {
            add_section(
                inout sections,
                inout shstrtab,
                in ".BTF".as_bytes(),
                in btf.as_slice(),
                4,
                0,
                false
            );
        }
    }
    // Symbols in `add_symbol` order: (name start, end, section, value, size,
    // local, func).
    let mut sym_name_start: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut sym_name_end: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut sym_sec: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut sym_value: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut sym_size: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut sym_local: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut sym_func: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut names: ChunkSeq[u8] = ChunkSeq::new[u8]();
    names.extend(in "_license".as_bytes());
    sym_name_start.push(0);
    sym_name_end.push(names.len());
    sym_sec.push(1);
    sym_value.push(0);
    sym_size.push(license.len());
    sym_local.push(0);
    sym_func.push(0);
    for k in 0..map_count {
        let name_start = names.len();
        names.extend(
            in prog.pool[seq64(in prog.map_name_start, k)..seq64(in prog.map_name_end, k)]
        );
        sym_name_start.push(name_start);
        sym_name_end.push(names.len());
        sym_sec.push(maps_index);
        sym_value.push(seq64(in offsets, k));
        sym_size.push(wrapping_mul(8, field_count(in prog, k)));
        sym_local.push(0);
        sym_func.push(0);
    }
    // The entry and named subprograms, by slot (a stable sort).
    let mut ent_name_start: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut ent_name_end: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut ent_slot: ChunkSeq[u64] = ChunkSeq::new[u64]();
    ent_name_start.push(prog.name_start);
    ent_name_end.push(prog.name_end);
    ent_slot.push(0);
    for fn_index in 0..prog.fn_slot.len() {
        let start_slot = seq64(in prog.fn_slot, fn_index);
        if start_slot != 0 {
            let mut at = ent_slot.len();
            for i in 0..ent_slot.len() {
                if at == ent_slot.len() && seq64(in ent_slot, i) > start_slot {
                    at = i;
                }
            }
            ent_name_start.push(0);
            ent_name_end.push(0);
            ent_slot.push(0);
            let mut i = wrapping_sub(ent_slot.len(), 1);
            loop {
                if i <= at {
                    break;
                }
                let j = wrapping_sub(i, 1);
                let moved = seq64(in ent_name_start, j);
                let ok = ent_name_start.try_set(i, moved);
                let moved = seq64(in ent_name_end, j);
                let ok = ent_name_end.try_set(i, moved);
                let moved = seq64(in ent_slot, j);
                let ok = ent_slot.try_set(i, moved);
                i = j;
            }
            let ok = ent_name_start.try_set(at, seq64(in prog.fn_name_start, fn_index));
            let ok = ent_name_end.try_set(at, seq64(in prog.fn_name_end, fn_index));
            let ok = ent_slot.try_set(at, start_slot);
        }
    }
    let entry_count = ent_slot.len();
    for i in 0..entry_count {
        let start_slot = seq64(in ent_slot, i);
        let end = if wrapping_add(i, 1) < entry_count {
            seq64(in ent_slot, wrapping_add(i, 1))
        } else {
            insns.len()
        };
        let name_start = names.len();
        names.extend(in prog.pool[seq64(in ent_name_start, i)..seq64(in ent_name_end, i)]);
        sym_name_start.push(name_start);
        sym_name_end.push(names.len());
        sym_sec.push(0);
        sym_value.push(wrapping_mul(start_slot, 8));
        sym_size.push(wrapping_mul(wrapping_sub(end, start_slot), 8));
        sym_local.push(if i == 0 { 0 } else { 1 });
        sym_func.push(1);
    }
    let sym_count = sym_name_start.len();

    // Layout (`elf_write`): section indices (each section, then its
    // `.rel` section), symbol indices (locals first), the strtab.
    let section_count = sections.names.len();
    let mut index: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut offset: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut len: u64 = HEADER;
    let mut section_num: u64 = 1;
    for k in 0..section_count {
        index.push(section_num);
        section_num = wrapping_add(section_num, 1);
        len = align_up(len, seq64(in sections.align, k));
        offset.push(len);
        len = wrapping_add(
            len,
            wrapping_sub(seq64(in sections.data_end, k), seq64(in sections.data_start, k))
        );
        if seq64(in sections.rel_name, k) != NONE {
            section_num = wrapping_add(section_num, 1);
        }
    }
    let mut sym_index: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for k in 0..sym_count {
        sym_index.push(0);
    }
    let mut count: u64 = 1;
    for k in 0..sym_count {
        if u8_at(in sym_local, k) == 1 {
            let ok = sym_index.try_set(k, count);
            count = wrapping_add(count, 1);
        }
    }
    let num_local = count;
    for k in 0..sym_count {
        if u8_at(in sym_local, k) == 0 {
            let ok = sym_index.try_set(k, count);
            count = wrapping_add(count, 1);
        }
    }
    let mut strtab = strtab_new();
    let mut sym_str: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for k in 0..sym_count {
        let name_start = seq64(in sym_name_start, k);
        let name_end = seq64(in sym_name_end, k);
        if name_end > name_start {
            sym_str.push(strtab_add(inout strtab, in names[name_start..name_end]));
        } else {
            sym_str.push(NONE);
        }
    }
    let symtab_name = strtab_add(inout shstrtab, in ".symtab".as_bytes());
    let symtab_index = section_num;
    section_num = wrapping_add(section_num, 1);
    len = align_up(len, 8);
    let symtab_offset = len;
    len = wrapping_add(len, wrapping_mul(count, SYM));
    let strtab_name = strtab_add(inout shstrtab, in ".strtab".as_bytes());
    let strtab_index = section_num;
    section_num = wrapping_add(section_num, 1);
    let strtab_data = strtab_write(inout strtab);
    let strtab_offset = len;
    len = wrapping_add(len, strtab_data.len());
    let mut rel_offset: u64 = 0;
    if reloc_count > 0 {
        len = align_up(len, 8);
        rel_offset = len;
        len = wrapping_add(len, wrapping_mul(reloc_count, REL));
    }
    let shstrtab_name = strtab_add(inout shstrtab, in ".shstrtab".as_bytes());
    let shstrtab_index = section_num;
    section_num = wrapping_add(section_num, 1);
    let shstrtab_data = strtab_write(inout shstrtab);
    let shstrtab_offset = len;
    len = wrapping_add(len, shstrtab_data.len());
    len = align_up(len, 8);
    let section_offset = len;

    // The file header.
    out.push(127);
    out.push(69);
    out.push(76);
    out.push(70);
    out.push(2);
    out.push(1);
    out.push(1);
    for k in 0..9 {
        out.push(0);
    }
    put16(inout out, ET_REL);
    put16(inout out, EM_BPF);
    put32(inout out, 1);
    put64(inout out, 0);
    put64(inout out, 0);
    put64(inout out, section_offset);
    put32(inout out, 0);
    put16(inout out, HEADER);
    put16(inout out, 0);
    put16(inout out, 0);
    put16(inout out, SECTION_HEADER);
    put16(inout out, section_num);
    put16(inout out, shstrtab_index);
    // Section data.
    for k in 0..section_count {
        pad_to(inout out, seq64(in sections.align, k));
        out.extend(
            in sections.data[seq64(in sections.data_start, k)..seq64(in sections.data_end, k)]
        );
    }
    // Symbols.
    pad_to(inout out, 8);
    for k in 0..SYM {
        out.push(0);
    }
    for pass in 0..2 {
        for k in 0..sym_count {
            let local = u8_at(in sym_local, k) == 1;
            if (pass == 0) == local {
                let id = seq64(in sym_str, k);
                let name = if id == NONE {
                    0
                } else {
                    str_offset(in strtab, id)
                };
                put32(inout out, name);
                let ty = if u8_at(in sym_func, k) == 1 {
                    STT_FUNC
                } else {
                    STT_OBJECT
                };
                let bind = if local { 0 } else { STB_GLOBAL };
                out.push(bind | ty);
                out.push(0);
                put16(inout out, seq64(in index, seq64(in sym_sec, k)));
                put64(inout out, seq64(in sym_value, k));
                put64(inout out, seq64(in sym_size, k));
            }
        }
    }
    out.extend(in strtab_data.as_slice());
    // Relocations (text only): R_BPF_64_64 against each map's symbol.
    if reloc_count > 0 {
        pad_to(inout out, 8);
        for reloc in 0..reloc_count {
            let at = seq64(in prog.relocs, wrapping_mul(reloc, 2));
            let map = seq64(in prog.relocs, wrapping_add(wrapping_mul(reloc, 2), 1));
            if map >= map_count {
                return D_MAP;
            }
            put64(inout out, wrapping_mul(at, 8));
            let sym = seq64(in sym_index, wrapping_add(map, 1));
            put64(inout out, wrapping_shl_u64(sym, 32) | R_BPF_64_64);
        }
    }
    out.extend(in shstrtab_data.as_slice());
    // Section headers.
    pad_to(inout out, 8);
    for k in 0..SECTION_HEADER {
        out.push(0);
    }
    for k in 0..section_count {
        put32(inout out, str_offset(in shstrtab, seq64(in sections.names, k)));
        put32(inout out, w(SHT_PROGBITS));
        put64(inout out, seq64(in sections.flags, k));
        put64(inout out, 0);
        put64(inout out, seq64(in offset, k));
        put64(
            inout out,
            wrapping_sub(seq64(in sections.data_end, k), seq64(in sections.data_start, k))
        );
        put32(inout out, 0);
        put32(inout out, 0);
        put64(inout out, seq64(in sections.align, k));
        put64(inout out, 0);
        let rel = seq64(in sections.rel_name, k);
        if rel != NONE {
            put32(inout out, str_offset(in shstrtab, rel));
            put32(inout out, w(SHT_REL));
            put64(inout out, SHF_INFO_LINK);
            put64(inout out, 0);
            put64(inout out, rel_offset);
            put64(inout out, wrapping_mul(reloc_count, REL));
            put32(inout out, symtab_index);
            put32(inout out, seq64(in index, k));
            put64(inout out, 8);
            put64(inout out, REL);
        }
    }
    put32(inout out, str_offset(in shstrtab, symtab_name));
    put32(inout out, w(SHT_SYMTAB));
    put64(inout out, 0);
    put64(inout out, 0);
    put64(inout out, symtab_offset);
    put64(inout out, wrapping_mul(count, SYM));
    put32(inout out, strtab_index);
    put32(inout out, num_local);
    put64(inout out, 8);
    put64(inout out, SYM);
    put32(inout out, str_offset(in shstrtab, strtab_name));
    put32(inout out, w(SHT_STRTAB));
    put64(inout out, 0);
    put64(inout out, 0);
    put64(inout out, strtab_offset);
    put64(inout out, strtab_data.len());
    put32(inout out, 0);
    put32(inout out, 0);
    put64(inout out, 1);
    put64(inout out, 0);
    put32(inout out, str_offset(in shstrtab, shstrtab_name));
    put32(inout out, w(SHT_STRTAB));
    put64(inout out, 0);
    put64(inout out, 0);
    put64(inout out, shstrtab_offset);
    put64(inout out, shstrtab_data.len());
    put32(inout out, 0);
    put32(inout out, 0);
    put64(inout out, 1);
    put64(inout out, 0);
    0
}

// ---------------------------------------------------------------- summary

// `build_command`'s summary after "wrote <path> (<n> bytes): ".
fn summary(in prog: Prog, in words: ChunkSeq[u64], inout out: ChunkSeq[u8]) {
    out.extend(in prog.pool[prog.section_start..prog.section_end]);
    out.extend(in " program `".as_bytes());
    out.extend(in prog.pool[prog.name_start..prog.name_end]);
    out.extend(in "`, ".as_bytes());
    push_decimal(inout out, prog.insns.len());
    out.extend(in " instructions, ".as_bytes());
    push_decimal(inout out, prog.map_name_start.len());
    out.extend(in " map(s)\nverifier model: accepted, ".as_bytes());
    push_decimal(inout out, seq64(in words, 1));
    out.extend(in " insns processed, worst-case stack ".as_bytes());
    push_decimal(inout out, seq64(in words, 6));
    out.extend(in " bytes\n".as_bytes());
    for i in 0..prog.bind_effect_start.len() {
        out.extend(in "map ".as_bytes());
        out.extend(in prog.pool[seq64(in prog.map_name_start, i)..seq64(in prog.map_name_end, i)]);
        out.extend(in " <- effect ".as_bytes());
        out.extend(
            in prog.pool[seq64(in prog.bind_effect_start, i)..seq64(in prog.bind_effect_end, i)]
        );
        out.extend(in ": ".as_bytes());
        out.extend(in kind_name(u8_at(in prog.map_kind, i)).as_bytes());
        out.extend(in ", key ".as_bytes());
        push_decimal(inout out, w(u32_at(in prog.map_key, i)));
        out.extend(in " B, value ".as_bytes());
        push_decimal(inout out, w(u32_at(in prog.map_value, i)));
        out.extend(in " B, ".as_bytes());
        push_decimal(inout out, w(u32_at(in prog.map_max, i)));
        out.extend(in " entries\n".as_bytes());
    }
}

// After a lowering that succeeded: verify, write the object into
// `object` and the summary's tail into `tail`; 0, or why Rust should
// build it instead.
pub fn build_object(
    in backend: G,
    in names: Names,
    in extra: Extra,
    inout object: ChunkSeq[u8],
    inout tail: ChunkSeq[u8]
) -> u64 {
    let prog = prog_of(in backend, in names, in extra);
    // Every binding names map `index` = its position (backend.ves).
    if prog.bind_effect_start.len() > prog.map_name_start.len() {
        return D_MAP;
    }
    let words = match verify(in prog) {
        Option::Some(outcome) => outcome,
        Option::None => return D_VERIFY,
    };
    let reason = write_object(in prog, inout object);
    if reason != 0 {
        return reason;
    }
    summary(in prog, in words, inout tail);
    0
}

pub fn declined_compile() -> u64 {
    D_COMPILE
}
