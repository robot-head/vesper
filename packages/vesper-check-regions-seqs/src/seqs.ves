// The type and world rules of src/seq.rs and src/strings.rs: sequence,
// slice and text types, `holds_sequence`, the operation a call names
// (`seq::resolve`, `strings::resolve`) with its properties, and the
// second-class `Slice[T]` rule of `seq::check_world` (E1520). The checker
// methods of src/seq/check.rs and src/strings/check.rs walk the AST: a
// later PR of #1181.
//
// An operation is a `u32` code: `SeqOp` variants 1-41 (0 = none), `Wide`
// accesses 64 + `Wide::index`, `StrOp` variants 100 + their order.

use @vesper/check-data::util::{add, n32, u32_at, u8_at, w};
use @vesper/check-data::names::{Names};
use @vesper/check-data::types::{Types, display, TyKind, TyPass};
use @vesper/check-data::world::{Known, World};
use @vesper/check-data::diag::{Diags};

const NONE32: u32 = 4294967295;

const OP_NEW: u32 = 1;
const OP_WITH_CAPACITY: u32 = 2;
const OP_LEN: u32 = 3;
const OP_PUSH: u32 = 4;
const OP_POP: u32 = 5;
const OP_GET: u32 = 6;
const OP_SET: u32 = 7;
const OP_TRY_GET: u32 = 8;
const OP_TRY_SET: u32 = 9;
const OP_CLEAR: u32 = 10;
const OP_TRUNCATE: u32 = 11;
const OP_RESERVE: u32 = 12;
const OP_EXTEND: u32 = 13;
const OP_FINISH: u32 = 14;
const OP_AS_SLICE: u32 = 15;
const OP_SLICE_LEN: u32 = 16;
const OP_SLICE_GET: u32 = 17;
const OP_SLICE_SET: u32 = 18;
const OP_COPY_FROM: u32 = 19;
const OP_TRY_COPY_FROM: u32 = 20;
const OP_FILL: u32 = 21;
const OP_SUM_BE16: u32 = 22;
const OP_BYTES_EQ: u32 = 23;
const OP_BYTES_CMP: u32 = 24;
const OP_FIND_BYTE: u32 = 25;
const OP_COPY_WITHIN: u32 = 26;
const OP_TRY_COPY_WITHIN: u32 = 27;
const OP_SWAP: u32 = 28;
const OP_REPLACE: u32 = 29;
const OP_FIND_EITHER: u32 = 30;
const OP_FIND_NOT_IN: u32 = 31;
const OP_EQ_IGNORE_ASCII_CASE: u32 = 32;
const OP_EXTEND_ASCII_LOWERCASE: u32 = 33;
const OP_MAKE_ASCII_LOWERCASE: u32 = 34;
const OP_TRY_MAKE_ASCII_LOWERCASE: u32 = 35;
const OP_RESIZE: u32 = 36;
const OP_TRY_FILL: u32 = 37;
const OP_EXTEND_FROM_WITHIN: u32 = 38;
const OP_TRY_EXTEND_FROM_WITHIN: u32 = 39;
const OP_EXTEND_REVERSED: u32 = 40;
const OP_FILL_RANGE: u32 = 41;
const OP_WIDE: u32 = 64;
const OP_STR: u32 = 100;

// Method and callee names, interned once in a fixed order (`name_at`).
// 0-18 sequence methods, 19-33 shared block methods, 34-39 string
// methods, 40-44 free callees, 45-68 the `Wide` accesses in
// `WIDE_NAMES` order, 69 `try_get_mut` (an alias of `try_get`).
pub struct SeqNames {
    syms: ChunkSeq[u32],
}

fn intern(inout names: Names, inout syms: ChunkSeq[u32], in text: Str) {
    let sym = names.intern(in text.as_bytes());
    syms.push(sym);
}

pub fn seq_names_new(inout names: Names) -> SeqNames {
    let mut syms: ChunkSeq[u32] = ChunkSeq::new[u32]();
    intern(inout names, inout syms, "len");
    intern(inout names, inout syms, "push");
    intern(inout names, inout syms, "pop");
    intern(inout names, inout syms, "get");
    intern(inout names, inout syms, "set");
    intern(inout names, inout syms, "try_get");
    intern(inout names, inout syms, "try_set");
    intern(inout names, inout syms, "clear");
    intern(inout names, inout syms, "truncate");
    intern(inout names, inout syms, "reserve");
    intern(inout names, inout syms, "extend");
    intern(inout names, inout syms, "extend_from_slice");
    intern(inout names, inout syms, "extend_ascii_lowercase");
    intern(inout names, inout syms, "resize");
    intern(inout names, inout syms, "extend_from_within");
    intern(inout names, inout syms, "try_extend_from_within");
    intern(inout names, inout syms, "extend_reversed");
    intern(inout names, inout syms, "as_slice");
    intern(inout names, inout syms, "as_slice_mut");
    intern(inout names, inout syms, "copy_from");
    intern(inout names, inout syms, "try_copy_from");
    intern(inout names, inout syms, "copy_within");
    intern(inout names, inout syms, "try_copy_within");
    intern(inout names, inout syms, "fill");
    intern(inout names, inout syms, "try_fill");
    intern(inout names, inout syms, "sum_be16");
    intern(inout names, inout syms, "eq");
    intern(inout names, inout syms, "cmp");
    intern(inout names, inout syms, "find_byte");
    intern(inout names, inout syms, "find_either");
    intern(inout names, inout syms, "find_not_in");
    intern(inout names, inout syms, "eq_ignore_ascii_case");
    intern(inout names, inout syms, "make_ascii_lowercase");
    intern(inout names, inout syms, "try_make_ascii_lowercase");
    intern(inout names, inout syms, "byte_at");
    intern(inout names, inout syms, "try_byte_at");
    intern(inout names, inout syms, "as_str");
    intern(inout names, inout syms, "as_bytes");
    intern(inout names, inout syms, "push_str");
    intern(inout names, inout syms, "push_char");
    intern(inout names, inout syms, "swap");
    intern(inout names, inout syms, "replace");
    intern(inout names, inout syms, "ChunkSeq::new");
    intern(inout names, inout syms, "ChunkSeq::with_capacity");
    intern(inout names, inout syms, "ChunkSeq::finish");
    intern(inout names, inout syms, "read_u16_le");
    intern(inout names, inout syms, "read_u16_be");
    intern(inout names, inout syms, "read_u32_le");
    intern(inout names, inout syms, "read_u32_be");
    intern(inout names, inout syms, "read_u64_le");
    intern(inout names, inout syms, "read_u64_be");
    intern(inout names, inout syms, "write_u16_le");
    intern(inout names, inout syms, "write_u16_be");
    intern(inout names, inout syms, "write_u32_le");
    intern(inout names, inout syms, "write_u32_be");
    intern(inout names, inout syms, "write_u64_le");
    intern(inout names, inout syms, "write_u64_be");
    intern(inout names, inout syms, "try_read_u16_le");
    intern(inout names, inout syms, "try_read_u16_be");
    intern(inout names, inout syms, "try_read_u32_le");
    intern(inout names, inout syms, "try_read_u32_be");
    intern(inout names, inout syms, "try_read_u64_le");
    intern(inout names, inout syms, "try_read_u64_be");
    intern(inout names, inout syms, "try_write_u16_le");
    intern(inout names, inout syms, "try_write_u16_be");
    intern(inout names, inout syms, "try_write_u32_le");
    intern(inout names, inout syms, "try_write_u32_be");
    intern(inout names, inout syms, "try_write_u64_le");
    intern(inout names, inout syms, "try_write_u64_be");
    intern(inout names, inout syms, "try_get_mut");
    SeqNames { syms: syms }
}

impl SeqNames {
    // The position of symbol `sym` in the table, or NONE32.
    pub fn index(in self, sym: u32) -> u32 {
        for i in 0..self.syms.len() {
            if u32_at(in self.syms, i) == sym {
                return n32(i);
            }
        }
        NONE32
    }

    pub fn name_at(in self, i: u32) -> u32 {
        u32_at(in self.syms, w(i))
    }
}

// ----- types ------------------------------------------------------------------

pub fn is_seq_type(in types: Types, known: Known, ty: u32) -> bool {
    let node = types.node(ty);
    node.kind == TyKind::Named && node.name == known.chunk_seq && node.n == 1
}

pub fn is_slice_type(in types: Types, known: Known, ty: u32) -> bool {
    let node = types.node(ty);
    node.kind == TyKind::Named && node.name == known.slice && node.n == 1
}

pub fn is_seq_or_slice(in types: Types, known: Known, ty: u32) -> bool {
    is_seq_type(in types, known, ty) || is_slice_type(in types, known, ty)
}

// `seq::elem`: the element type, or NONE32.
pub fn elem(in types: Types, known: Known, ty: u32) -> u32 {
    if is_seq_or_slice(in types, known, ty) {
        types.arg(ty, 0)
    } else {
        NONE32
    }
}

pub fn mentions_slice(in types: Types, known: Known, ty: u32) -> bool {
    let node = types.node(ty);
    if node.kind == TyKind::Named && node.name == known.slice {
        return true;
    }
    if node.kind == TyKind::Named || node.kind == TyKind::Tuple || node.kind == TyKind::Fn {
        for i in 0..w(node.n) {
            if mentions_slice(in types, known, u32_at(in types.items, add(w(node.a), i))) {
                return true;
            }
        }
    }
    node.kind == TyKind::Fn && mentions_slice(in types, known, node.r)
}

pub fn is_string_type(in types: Types, known: Known, ty: u32) -> bool {
    let node = types.node(ty);
    node.kind == TyKind::Named && node.name == known.string && node.n == 0
}

pub fn is_str_type(in types: Types, known: Known, ty: u32) -> bool {
    let node = types.node(ty);
    node.kind == TyKind::Named && node.name == known.str_ && node.n == 0
}

pub fn is_text(in types: Types, known: Known, ty: u32) -> bool {
    is_string_type(in types, known, ty) || is_str_type(in types, known, ty)
}

pub fn mentions_str(in types: Types, known: Known, ty: u32) -> bool {
    let node = types.node(ty);
    if node.kind == TyKind::Named && node.name == known.str_ {
        return true;
    }
    if node.kind == TyKind::Named || node.kind == TyKind::Tuple || node.kind == TyKind::Fn {
        for i in 0..w(node.n) {
            if mentions_str(in types, known, u32_at(in types.items, add(w(node.a), i))) {
                return true;
            }
        }
    }
    node.kind == TyKind::Fn && mentions_str(in types, known, node.r)
}

// `arrays::element`: the element type of a non-empty tuple of one type
// (its length is the tuple's arity), or NONE32.
pub fn array_element(in types: Types, ty: u32) -> u32 {
    let node = types.node(ty);
    if node.kind != TyKind::Tuple || node.n == 0 {
        return NONE32;
    }
    let first = types.arg(ty, 0);
    for i in 1..w(node.n) {
        if types.arg(ty, i) != first {
            return NONE32;
        }
    }
    first
}

fn on_stack(in seen: ChunkSeq[u32], sym: u32) -> bool {
    for i in 0..seen.len() {
        if u32_at(in seen, i) == sym {
            return true;
        }
    }
    false
}

fn holds_visit(
    in types: Types,
    in world: World,
    known: Known,
    ty: u32,
    inout seen: ChunkSeq[u32]
) -> bool {
    if is_seq_or_slice(in types, known, ty) {
        return true;
    }
    let node = types.node(ty);
    if node.kind == TyKind::Tuple {
        for i in 0..w(node.n) {
            if holds_visit(in types, in world, known, types.arg(ty, i), inout seen) {
                return true;
            }
        }
        return false;
    }
    if node.kind != TyKind::Named {
        return false;
    }
    for i in 0..w(node.n) {
        if holds_visit(in types, in world, known, types.arg(ty, i), inout seen) {
            return true;
        }
    }
    let adt_id = world.lookup(node.name);
    if adt_id == NONE32 {
        return false;
    }
    if on_stack(in seen, node.name) {
        return false;
    }
    seen.push(node.name);
    let adt = world.adt(adt_id);
    let mut found = false;
    for variant_index in 0..w(adt.vn) {
        let variant = world.variant(add(w(adt.va), variant_index));
        for field_index in 0..w(variant.fc) {
            let field = world.field(add(w(variant.fa), field_index));
            if !found && holds_visit(in types, in world, known, field.ty, inout seen) {
                found = true;
            }
        }
    }
    let popped = seen.pop();
    found
}

// `seq::holds_sequence`.
pub fn holds_sequence(in types: Types, in world: World, known: Known, ty: u32) -> bool {
    let mut seen: ChunkSeq[u32] = ChunkSeq::new[u32]();
    holds_visit(in types, in world, known, ty, inout seen)
}

// ----- resolve -----------------------------------------------------------------

fn shared_method(name_index: u32) -> u32 {
    if name_index >= 45 && name_index < 69 {
        return wrapping_add(OP_WIDE, wrapping_sub(name_index, 45));
    }
    match name_index {
        19 => OP_COPY_FROM,
        20 => OP_TRY_COPY_FROM,
        21 => OP_COPY_WITHIN,
        22 => OP_TRY_COPY_WITHIN,
        23 => OP_FILL,
        24 => OP_TRY_FILL,
        25 => OP_SUM_BE16,
        26 => OP_BYTES_EQ,
        27 => OP_BYTES_CMP,
        28 => OP_FIND_BYTE,
        29 => OP_FIND_EITHER,
        30 => OP_FIND_NOT_IN,
        31 => OP_EQ_IGNORE_ASCII_CASE,
        32 => OP_MAKE_ASCII_LOWERCASE,
        33 => OP_TRY_MAKE_ASCII_LOWERCASE,
        _ => 0,
    }
}

fn seq_method(name_index: u32) -> u32 {
    match name_index {
        0 => OP_LEN,
        1 => OP_PUSH,
        2 => OP_POP,
        3 => OP_GET,
        4 => OP_SET,
        5 | 69 => OP_TRY_GET,
        6 => OP_TRY_SET,
        7 => OP_CLEAR,
        8 => OP_TRUNCATE,
        9 => OP_RESERVE,
        10 => OP_EXTEND,
        11 => OP_EXTEND,
        12 => OP_EXTEND_ASCII_LOWERCASE,
        13 => OP_RESIZE,
        14 => OP_EXTEND_FROM_WITHIN,
        15 => OP_TRY_EXTEND_FROM_WITHIN,
        16 => OP_EXTEND_REVERSED,
        17 => OP_AS_SLICE,
        18 => OP_AS_SLICE,
        _ => shared_method(name_index),
    }
}

fn slice_method(name_index: u32) -> u32 {
    match name_index {
        0 => OP_SLICE_LEN,
        3 => OP_SLICE_GET,
        4 => OP_SLICE_SET,
        5 | 69 => OP_TRY_GET,
        6 => OP_TRY_SET,
        _ => shared_method(name_index),
    }
}

// `strings::resolve` as a code (100 + `StrOp`), or 0.
pub fn str_resolve(in types: Types, known: Known, name_index: u32, receiver: u32) -> u32 {
    let op: u32 = match name_index {
        0 => 0,
        34 => 1,
        35 => 2,
        36 => 3,
        37 => 4,
        38 => 6,
        39 => 7,
        7 => 8,
        9 => 9,
        _ => 99,
    };
    if op == 99 {
        return 0;
    }
    let code = wrapping_add(OP_STR, op);
    if is_string_type(in types, known, receiver)
        || (is_str_type(in types, known, receiver) && !mutates(code)) {
        code
    } else {
        0
    }
}

// The symbol of the last `::` segment of `sym` (all of it without one).
fn last_segment(inout names: Names, sym: u32) -> u32 {
    let start = names.start(sym);
    let end = names.end(sym);
    let mut cut = start;
    let mut i = start;
    loop {
        if wrapping_add(i, 1) >= end {
            break;
        }
        if u8_at(in names.text, i) == 58 && u8_at(in names.text, wrapping_add(i, 1)) == 58 {
            cut = wrapping_add(i, 2);
        }
        i = wrapping_add(i, 1);
    }
    if cut == start {
        return sym;
    }
    let mut segment: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for j in cut..end {
        segment.push(u8_at(in names.text, j));
    }
    names.intern(in segment.as_slice())
}

// `seq::resolve(callee, receiver)`; `receiver` is NONE32 for a free call.
pub fn resolve(
    inout names: Names,
    in seq_names: SeqNames,
    in types: Types,
    known: Known,
    callee: u32,
    receiver: u32
) -> u32 {
    if receiver != NONE32 {
        let method = last_segment(inout names, callee);
        let name_index = seq_names.index(method);
        if is_text(in types, known, receiver) {
            return str_resolve(in types, known, name_index, receiver);
        }
        if is_seq_type(in types, known, receiver) {
            return seq_method(name_index);
        }
        if is_slice_type(in types, known, receiver) {
            return slice_method(name_index);
        }
        return 0;
    }
    match seq_names.index(callee) {
        40 => OP_SWAP,
        41 => OP_REPLACE,
        42 => OP_NEW,
        43 => OP_WITH_CAPACITY,
        44 => OP_FINISH,
        _ => 0,
    }
}

// ----- properties ---------------------------------------------------------------

fn is_wide(op: u32) -> bool {
    op >= OP_WIDE && op < wrapping_add(OP_WIDE, 24)
}

fn wide_index(op: u32) -> u32 {
    wrapping_sub(op, OP_WIDE)
}

fn is_str(op: u32) -> bool {
    op >= OP_STR
}

pub fn byte_scan(op: u32) -> bool {
    op == OP_SUM_BE16
        || op == OP_BYTES_EQ
        || op == OP_BYTES_CMP
        || op == OP_FIND_BYTE
        || op == OP_FIND_EITHER
        || op == OP_FIND_NOT_IN
        || op == OP_EQ_IGNORE_ASCII_CASE
        || op == OP_EXTEND_ASCII_LOWERCASE
        || op == OP_MAKE_ASCII_LOWERCASE
        || op == OP_TRY_MAKE_ASCII_LOWERCASE
}

pub fn fallible(op: u32) -> bool {
    if is_str(op) {
        return op == wrapping_add(OP_STR, 1);
    }
    if is_wide(op) {
        return wide_index(op) < 12;
    }
    op == OP_GET
        || op == OP_SET
        || op == OP_FINISH
        || op == OP_SLICE_GET
        || op == OP_SLICE_SET
        || op == OP_COPY_FROM
        || op == OP_COPY_WITHIN
        || op == OP_MAKE_ASCII_LOWERCASE
        || op == OP_FILL_RANGE
        || op == OP_EXTEND_FROM_WITHIN
}

pub fn mutates(op: u32) -> bool {
    if is_str(op) {
        return op >= wrapping_add(OP_STR, 6);
    }
    if is_wide(op) {
        return (wide_index(op) / 6) % 2 == 1;
    }
    op == OP_PUSH
        || op == OP_POP
        || op == OP_SET
        || op == OP_TRY_SET
        || op == OP_CLEAR
        || op == OP_TRUNCATE
        || op == OP_RESERVE
        || op == OP_EXTEND
        || op == OP_EXTEND_ASCII_LOWERCASE
        || op == OP_MAKE_ASCII_LOWERCASE
        || op == OP_TRY_MAKE_ASCII_LOWERCASE
        || op == OP_COPY_FROM
        || op == OP_TRY_COPY_FROM
        || op == OP_COPY_WITHIN
        || op == OP_TRY_COPY_WITHIN
        || op == OP_FILL
        || op == OP_RESIZE
        || op == OP_TRY_FILL
        || op == OP_FILL_RANGE
        || op == OP_EXTEND_FROM_WITHIN
        || op == OP_TRY_EXTEND_FROM_WITHIN
        || op == OP_EXTEND_REVERSED
}

pub fn place_primitive(op: u32) -> bool {
    op == OP_SWAP || op == OP_REPLACE
}

pub fn receiver_pass(op: u32) -> u8 {
    if mutates(op) || op == OP_SLICE_SET {
        TyPass::Inout
    } else {
        TyPass::In
    }
}

pub fn has_receiver(op: u32) -> bool {
    !(op == OP_NEW || op == OP_WITH_CAPACITY || op == OP_SWAP || op == OP_REPLACE)
}

// Whether `seq::fip_allocation` reports the operation (it grows a sequence).
pub fn grows(op: u32) -> bool {
    op == OP_NEW
        || op == OP_WITH_CAPACITY
        || op == OP_PUSH
        || op == OP_EXTEND
        || op == OP_EXTEND_ASCII_LOWERCASE
        || op == OP_RESIZE
        || op == OP_EXTEND_FROM_WITHIN
        || op == OP_TRY_EXTEND_FROM_WITHIN
        || op == OP_EXTEND_REVERSED
        || op == wrapping_add(OP_STR, 6)
        || op == wrapping_add(OP_STR, 7)
        || op == wrapping_add(OP_STR, 9)
}

// `SeqOp::with_arity`.
pub fn with_arity(op: u32, operands: u64) -> u32 {
    if op == OP_FILL && operands == 3 {
        OP_FILL_RANGE
    } else {
        op
    }
}

fn put(inout out: ChunkSeq[u8], in text: Str) {
    out.extend(in text.as_bytes());
}

fn put_bool(inout out: ChunkSeq[u8], value: bool) {
    if value {
        put(inout out, "true");
    } else {
        put(inout out, "false");
    }
}

// `SeqOp::name`.
pub fn op_name(in names: Names, in seq_names: SeqNames, op: u32, inout out: ChunkSeq[u8]) {
    if is_wide(op) {
        names.write(seq_names.name_at(wrapping_add(45, wide_index(op))), inout out);
        return;
    }
    match op {
        1 => put(inout out, "new"),
        2 => put(inout out, "with_capacity"),
        3 => put(inout out, "len"),
        16 => put(inout out, "len"),
        4 => put(inout out, "push"),
        5 => put(inout out, "pop"),
        6 => put(inout out, "get"),
        17 => put(inout out, "get"),
        7 => put(inout out, "set"),
        18 => put(inout out, "set"),
        8 => put(inout out, "try_get"),
        9 => put(inout out, "try_set"),
        10 => put(inout out, "clear"),
        11 => put(inout out, "truncate"),
        12 => put(inout out, "reserve"),
        13 => put(inout out, "extend"),
        14 => put(inout out, "finish"),
        15 => put(inout out, "as_slice"),
        19 => put(inout out, "copy_from"),
        20 => put(inout out, "try_copy_from"),
        21 => put(inout out, "fill"),
        22 => put(inout out, "sum_be16"),
        23 => put(inout out, "eq"),
        24 => put(inout out, "cmp"),
        25 => put(inout out, "find_byte"),
        26 => put(inout out, "copy_within"),
        27 => put(inout out, "try_copy_within"),
        28 => put(inout out, "swap"),
        29 => put(inout out, "replace"),
        30 => put(inout out, "find_either"),
        31 => put(inout out, "find_not_in"),
        32 => put(inout out, "eq_ignore_ascii_case"),
        33 => put(inout out, "extend_ascii_lowercase"),
        34 => put(inout out, "make_ascii_lowercase"),
        35 => put(inout out, "try_make_ascii_lowercase"),
        36 => put(inout out, "resize"),
        37 => put(inout out, "try_fill"),
        38 => put(inout out, "extend_from_within"),
        39 => put(inout out, "try_extend_from_within"),
        40 => put(inout out, "extend_reversed"),
        41 => put(inout out, "fill"),
        100 => put(inout out, "len"),
        101 => put(inout out, "byte_at"),
        102 => put(inout out, "try_byte_at"),
        103 => put(inout out, "as_str"),
        104 => put(inout out, "as_bytes"),
        105 => put(inout out, "slice"),
        106 => put(inout out, "push_str"),
        107 => put(inout out, "push_char"),
        108 => put(inout out, "clear"),
        109 => put(inout out, "reserve"),
        _ => put(inout out, "?"),
    }
}

fn total(inout out: ChunkSeq[u8], in name: Str, is_total: bool) {
    put(inout out, name);
    put(inout out, " { total: ");
    put_bool(inout out, is_total);
    put(inout out, " }");
}

// `{:?}` of the `SeqOp`.
pub fn op_debug(op: u32, inout out: ChunkSeq[u8]) {
    if is_wide(op) {
        let index = wide_index(op);
        let bytes: u64 = match (index / 2) % 3 {
            0 => 2,
            1 => 4,
            _ => 8,
        };
        put(inout out, "Wide(Wide { bytes: ");
        out.push(wrapping_u8(wrapping_add(bytes, 48)));
        put(inout out, ", big: ");
        put_bool(inout out, index % 2 == 1);
        put(inout out, ", write: ");
        put_bool(inout out, (index / 6) % 2 == 1);
        put(inout out, ", total: ");
        put_bool(inout out, index >= 12);
        put(inout out, " })");
        return;
    }
    if is_str(op) {
        put(inout out, "Str(");
        match wrapping_sub(op, OP_STR) {
            0 => put(inout out, "Len"),
            1 => put(inout out, "ByteAt"),
            2 => put(inout out, "TryByteAt"),
            3 => put(inout out, "AsStr"),
            4 => put(inout out, "AsBytes"),
            5 => put(inout out, "SubStr"),
            6 => put(inout out, "PushStr"),
            7 => put(inout out, "PushChar"),
            8 => put(inout out, "Clear"),
            _ => put(inout out, "Reserve"),
        }
        out.push(41);
        return;
    }
    match op {
        1 => put(inout out, "New"),
        2 => put(inout out, "WithCapacity"),
        3 => put(inout out, "Len"),
        4 => put(inout out, "Push"),
        5 => put(inout out, "Pop"),
        6 => put(inout out, "Get"),
        7 => put(inout out, "Set"),
        8 => put(inout out, "TryGet"),
        9 => put(inout out, "TrySet"),
        10 => put(inout out, "Clear"),
        11 => put(inout out, "Truncate"),
        12 => put(inout out, "Reserve"),
        13 => put(inout out, "Extend"),
        14 => put(inout out, "Finish"),
        15 => put(inout out, "AsSlice"),
        16 => put(inout out, "SliceLen"),
        17 => put(inout out, "SliceGet"),
        18 => put(inout out, "SliceSet"),
        19 => total(inout out, "CopyFrom", false),
        20 => total(inout out, "CopyFrom", true),
        21 => put(inout out, "Fill"),
        22 => put(inout out, "SumBe16"),
        23 => put(inout out, "BytesEq"),
        24 => put(inout out, "BytesCmp"),
        25 => put(inout out, "FindByte"),
        26 => total(inout out, "CopyWithin", false),
        27 => total(inout out, "CopyWithin", true),
        28 => put(inout out, "Swap"),
        29 => put(inout out, "Replace"),
        30 => put(inout out, "FindEither"),
        31 => put(inout out, "FindNotIn"),
        32 => put(inout out, "EqIgnoreAsciiCase"),
        33 => put(inout out, "ExtendAsciiLowercase"),
        34 => total(inout out, "MakeAsciiLowercase", false),
        35 => total(inout out, "MakeAsciiLowercase", true),
        36 => put(inout out, "Resize"),
        37 => total(inout out, "FillRange", true),
        38 => total(inout out, "ExtendFromWithin", false),
        39 => total(inout out, "ExtendFromWithin", true),
        40 => put(inout out, "ExtendReversed"),
        41 => total(inout out, "FillRange", false),
        _ => put(inout out, "?"),
    }
}

// ----- seq::check_world ------------------------------------------------------------

// A function signature (`world.functions`, in name order): the lane 9
// section of the harness input (`read_sigs` in lib.ves).
pub copy struct Sig {
    name: u32,
    start: u64,
    stop: u64,
    result: u32,
    // params[param_start..param_start+param_count]
    param_start: u32,
    param_count: u32,
}

pub copy struct Param {
    name: u32,
    pass: u8,
    ty: u32,
    start: u64,
    stop: u64,
}

pub struct Sigs {
    sigs: ChunkSeq[Sig],
    params: ChunkSeq[Param],
    // ADT spans and field temperatures, in `World` order.
    adt_start: ChunkSeq[u64],
    adt_stop: ChunkSeq[u64],
    // 0 none, 1 hot, 2 cold; one per field of `World::fields`
    field_temps: ChunkSeq[u8],
}

pub fn sigs_new() -> Sigs {
    Sigs {
        sigs: ChunkSeq::new[Sig](),
        params: ChunkSeq::new[Param](),
        adt_start: ChunkSeq::new[u64](),
        adt_stop: ChunkSeq::new[u64](),
        field_temps: ChunkSeq::new[u8]()
    }
}

impl Sigs {
    pub fn sig(in self, i: u64) -> Sig {
        match self.sigs.try_get(i) {
            Option::Some(s) => s,
            Option::None => Sig {
                name: 0,
                start: 0,
                stop: 0,
                result: 0,
                param_start: 0,
                param_count: 0
            },
        }
    }

    pub fn param(in self, i: u64) -> Param {
        match self.params.try_get(i) {
            Option::Some(p) => p,
            Option::None => Param { name: 0, pass: 0, ty: 0, start: 0, stop: 0 },
        }
    }

    pub fn adt_span_start(in self, i: u64) -> u64 {
        self.adt_start.try_get(i).unwrap_or(0)
    }

    pub fn adt_span_stop(in self, i: u64) -> u64 {
        self.adt_stop.try_get(i).unwrap_or(0)
    }

    pub fn temp(in self, field: u64) -> u8 {
        u8_at(in self.field_temps, field)
    }
}

fn second_class_open(inout diags: Diags) -> u64 {
    let code_start = diags.open("E1520");
    diags.text.extend(in "Slice[T] is a second-class borrow and cannot appear in ".as_bytes());
    code_start
}

fn second_class_close(inout diags: Diags, code_start: u64, msg_start: u64, start: u64, stop: u64) {
    diags.close(
        code_start,
        msg_start,
        "take the slice as an 'in' or 'inout' parameter and pass s[a..b] or s.as_slice() at the call",
        start,
        stop
    );
}

fn lower(byte: u8) -> u8 {
    if byte >= 65 && byte <= 90 {
        wrapping_add(byte, 32)
    } else {
        byte
    }
}

// Writes `sym` ASCII-lowercased (Rust lowercases the whole message).
fn write_lower(in names: Names, sym: u32, inout out: ChunkSeq[u8]) {
    let start = names.start(sym);
    let end = names.end(sym);
    for i in start..end {
        out.push(lower(u8_at(in names.text, i)));
    }
}

// `seq::check_world`: where `Slice[T]` may appear (E1520).
pub fn seq_check_world(
    in types: Types,
    in names: Names,
    in world: World,
    in sigs: Sigs,
    inout diags: Diags
) {
    let known = world.k;
    for i in 0..sigs.sigs.len() {
        let sig = sigs.sig(i);
        for j in 0..w(sig.param_count) {
            let param = sigs.param(add(w(sig.param_start), j));
            let is_slice = is_slice_type(in types, known, param.ty);
            let top = is_slice && (param.pass == TyPass::In || param.pass == TyPass::Inout);
            let nested = if top {
                mentions_slice(in types, known, types.arg(param.ty, 0))
            } else {
                mentions_slice(in types, known, param.ty)
            };
            if nested || (is_slice && !top) {
                let code_start = diags.open("E1520");
                let msg_start = diags.text.len();
                diags.text.extend(
                    in "Slice[T] is a second-class borrow and cannot appear in the ".as_bytes()
                );
                if param.pass == TyPass::In {
                    put(inout diags.text, "in");
                } else if param.pass == TyPass::Inout {
                    put(inout diags.text, "inout");
                } else {
                    put(inout diags.text, "sink");
                }
                put(inout diags.text, " parameter '");
                write_lower(in names, param.name, inout diags.text);
                diags.text.push(39);
                second_class_close(inout diags, code_start, msg_start, param.start, param.stop);
            }
        }
        if mentions_slice(in types, known, sig.result) {
            let code_start = diags.open("E1520");
            let msg_start = diags.text.len();
            diags.text.extend(
                in "Slice[T] is a second-class borrow and cannot appear in the result of '"
                    .as_bytes()
            );
            names.write(sig.name, inout diags.text);
            diags.text.push(39);
            second_class_close(inout diags, code_start, msg_start, sig.start, sig.stop);
        }
    }
    for i in 0..world.adts.len() {
        let adt = world.adt(n32(i));
        for variant_index in 0..w(adt.vn) {
            let variant = world.variant(add(w(adt.va), variant_index));
            for field_index in 0..w(variant.fc) {
                let field = world.field(add(w(variant.fa), field_index));
                if mentions_slice(in types, known, field.ty) {
                    let code_start = diags.open("E1520");
                    let msg_start = diags.text.len();
                    diags.text.extend(
                        in "Slice[T] is a second-class borrow and cannot appear in field '"
                            .as_bytes()
                    );
                    names.write(adt.name, inout diags.text);
                    diags.text.push(46);
                    names.write(field.name, inout diags.text);
                    diags.text.push(39);
                    second_class_close(
                        inout diags,
                        code_start,
                        msg_start,
                        sigs.adt_span_start(i),
                        sigs.adt_span_stop(i)
                    );
                }
            }
        }
    }
}
