// @vesper/check-regions-seqs: the region, sequence, string, array, tiled
// and vector rules of the checker in Vesper (self-hosting wave SH2, lane 9,
// #1181), on @vesper/check-data. Rust stays the default checker.
//
// This first part ports the rules that are functions of types and of the
// `World` tables:
// - regions.ves: `src/regions.rs` type half (region rows, handles,
//   `normalize`, `validate_type`, `display`, `mismatch`).
// - seqs.ves: `src/seq.rs` and `src/strings.rs` types, `holds_sequence`,
//   `resolve` with the operation properties, `seq::check_world` (E1520),
//   and `arrays::element`.
// - tiled.ves: `src/tiled.rs` types and `check_world_adts` (E1501-E1503).
// - vector.ves: `src/vector.rs` shapes, `type_error`, `layout_words`,
//   profiles and `isa_row_entry` (E1404).
// - isa.ves: the `Isa` discipline of `vector::check_world` (E1401-E1403)
//   over the @vesper/ast tree (#1830).
// The checker methods of src/{regions,seq,strings,arrays,tiled,vector}/
// check.rs and the expression passes of each `check_world` walk the AST;
// they are the next part.
//
// The entries are the differential tasks of
// tests/self_host_check_regions_seqs.rs; each returns `pack_text`'s text.

use @vesper/check-data::util::{add, n32, push_decimal, u32_at, u8_at, w};
use @vesper/check-data::names::{Names};
use @vesper/check-data::types::{Types, Vars, display, vars_new, TyKind};
use @vesper/check-data::world::{Known, World};
use @vesper/check-data::diag::{Diags, diags_new};
use @vesper/check-data::input::{Ctx, Reader, read_ctx};
use @vesper/check-data::{pack_text};
use self::isa::isa_text;
use self::regions::{is_handle_type, mismatch, normalize, region_display, validate_type};
use self::seqs::{
    Param, SeqNames, Sig, Sigs, array_element, byte_scan, elem, fallible, grows, has_receiver,
    holds_sequence, is_seq_type, is_slice_type, is_str_type, is_string_type, mentions_slice,
    mentions_str, mutates, op_debug, op_name, place_primitive, receiver_pass, resolve,
    seq_check_world, seq_names_new, sigs_new, with_arity
};
use self::tiled::{
    check_world_adts, hot_elem_bytes, hot_vector_shape, is_tiled_seq, seq_adt, seq_elem
};
use self::vector::{
    Shape, VecNames, elem_bits, lanes_per_chunk, elem_name, is_vector_spelling, isa_row_entry,
    layout_words, required_profile, profile_name, shape_bits, shape_display, shape_of, type_error,
    vec_names_new
};

const NONE32: u32 = 4294967295;

fn put(inout out: ChunkSeq[u8], in text: Str) {
    out.extend(in text.as_bytes());
}

fn bit(inout out: ChunkSeq[u8], value: bool) {
    out.push(32);
    if value {
        out.push(49);
    } else {
        out.push(48);
    }
}

fn range(inout out: ChunkSeq[u8], in diags: Diags, start: u64, end: u64) {
    for i in start..end {
        out.push(u8_at(in diags.text, i));
    }
}

// One diagnostic: `code|message|help|start|stop`.
fn diag_line(inout out: ChunkSeq[u8], in diags: Diags, i: u64) {
    let row = diags.row(i);
    range(inout out, in diags, row.code_a, row.msg_a);
    out.push(124);
    range(inout out, in diags, row.msg_a, row.msg_b);
    out.push(124);
    range(inout out, in diags, row.help_a, row.end);
    out.push(124);
    push_decimal(inout out, row.start);
    out.push(124);
    push_decimal(inout out, row.stop);
    out.push(10);
}

fn ty_or_dash(inout out: ChunkSeq[u8], in ctx: Ctx, ty: u32) {
    out.push(32);
    if ty == NONE32 {
        out.push(45);
    } else {
        display(in ctx.types, in ctx.names, ty, inout out);
    }
}

fn shape_or_dash(inout out: ChunkSeq[u8], shape: Shape) {
    out.push(32);
    if shape.elem == 0 {
        out.push(45);
    } else {
        shape_display(shape, inout out);
    }
}

// The isa entries of a row: `I` lines.
fn isa_lines(
    inout out: ChunkSeq[u8],
    in ctx: Ctx,
    in vec_names: VecNames,
    row: u32,
    type_index: u64
) {
    let row_node = ctx.types.row(row);
    for j in 0..w(row_node.n) {
        let effect = ctx.types.effect_at(add(w(row_node.a), j));
        let mut diags = diags_new();
        put(inout out, "I ");
        if isa_row_entry(
            in ctx.types,
            in ctx.names,
            in vec_names,
            effect,
            type_index,
            wrapping_add(type_index, 1),
            inout diags
        ) {
            diag_line(inout out, in diags, 0);
        } else {
            put(inout out, "-\n");
        }
    }
}

// Task "types": every listed type through each module's type rules (see
// tests/self_host_check_regions_seqs.rs `types_text` for the lines).
// Task words: l, l pairs (source label, capability) of names; n, n types.
pub fn regions_seqs_types(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mut reader = Reader { pos: 0 };
    let mut ctx = read_ctx(inout reader, in bytes);
    let known = ctx.world.k;
    let vec_names = vec_names_new(inout ctx.names);
    let mut labels = vars_new();
    let label_count = reader.word(in bytes);
    for i in 0..label_count {
        let source_label = u32_at(in ctx.nmap, reader.word(in bytes));
        let capability = u32_at(in ctx.nmap, reader.word(in bytes));
        labels.set(source_label, capability);
    }
    let type_count = reader.word(in bytes);
    let mut out = ChunkSeq::new[u8]();
    let mut prev_ty = NONE32;
    for type_index in 0..type_count {
        let ty = u32_at(in ctx.tmap, reader.word(in bytes));
        let start = type_index;
        let stop = wrapping_add(type_index, 1);
        put(inout out, "T ");
        display(in ctx.types, in ctx.names, ty, inout out);
        out.push(10);
        // regions
        let mut diags = diags_new();
        put(inout out, "R");
        bit(inout out, is_handle_type(in ctx.types, known, ty));
        if validate_type(in ctx.types, in ctx.names, known, ty, start, stop, inout diags) {
            out.push(32);
            push_decimal(inout out, diags.len());
            out.push(10);
            for j in 0..diags.len() {
                put(inout out, "  ");
                diag_line(inout out, in diags, j);
            }
        } else {
            put(inout out, " -\n");
        }
        let normalized = normalize(inout ctx.types, known, ty, in labels);
        put(inout out, "N ");
        region_display(in ctx.types, in ctx.names, known, normalized, inout out);
        out.push(10);
        put(inout out, "M ");
        let mut mismatch_diags = diags_new();
        if prev_ty != NONE32
            && mismatch(
                in ctx.types,
                in ctx.names,
                known,
                prev_ty,
                normalized,
                start,
                stop,
                inout mismatch_diags
            )
        {
            diag_line(inout out, in mismatch_diags, 0);
        } else {
            put(inout out, "-\n");
        }
        prev_ty = normalized;
        // sequences, strings, arrays
        put(inout out, "S");
        bit(inout out, is_seq_type(in ctx.types, known, ty));
        bit(inout out, is_slice_type(in ctx.types, known, ty));
        ty_or_dash(inout out, in ctx, elem(in ctx.types, known, ty));
        bit(inout out, mentions_slice(in ctx.types, known, ty));
        bit(inout out, holds_sequence(in ctx.types, in ctx.world, known, ty));
        out.push(10);
        put(inout out, "X");
        bit(inout out, is_string_type(in ctx.types, known, ty));
        bit(inout out, is_str_type(in ctx.types, known, ty));
        bit(inout out, mentions_str(in ctx.types, known, ty));
        let array_elem = array_element(in ctx.types, ty);
        ty_or_dash(inout out, in ctx, array_elem);
        if array_elem != NONE32 {
            out.push(32);
            push_decimal(inout out, ctx.types.arity(ty));
        }
        out.push(10);
        // tiled
        put(inout out, "L");
        bit(inout out, is_tiled_seq(in ctx.types, known, ty));
        ty_or_dash(inout out, in ctx, seq_elem(in ctx.types, known, ty));
        out.push(32);
        let label = self::regions::seq_region_label(in ctx.types, known, ty);
        if label == 0 {
            out.push(45);
        } else {
            ctx.names.write(wrapping_sub(label, 1), inout out);
        }
        out.push(32);
        let adt = seq_adt(in ctx.types, in ctx.world, known, ty);
        if adt == NONE32 {
            out.push(45);
        } else {
            let adt_row = ctx.world.adt(adt);
            ctx.names.write(adt_row.name, inout out);
            out.push(47);
            push_decimal(inout out, w(wrapping_sub(adt_row.tile, 1)));
        }
        out.push(32);
        push_decimal(inout out, hot_elem_bytes(in ctx.types, known, ty));
        shape_or_dash(inout out, hot_vector_shape(in ctx.types, known, ty, 8));
        shape_or_dash(inout out, hot_vector_shape(in ctx.types, known, ty, 16));
        shape_or_dash(inout out, hot_vector_shape(in ctx.types, known, ty, 32));
        shape_or_dash(inout out, hot_vector_shape(in ctx.types, known, ty, 64));
        out.push(10);
        // vectors
        put(inout out, "V");
        bit(inout out, is_vector_spelling(in ctx.types, in ctx.names, known, ty));
        let shape = shape_of(in ctx.types, in ctx.names, known, ty);
        out.push(32);
        if shape.elem == 0 {
            out.push(45);
        } else {
            if shape.kind == 1 {
                put(inout out, "Vec");
            } else {
                put(inout out, "Mask");
            }
            shape_display(shape, inout out);
            out.push(32);
            push_decimal(inout out, shape_bits(shape));
            out.push(32);
            push_decimal(inout out, shape_bits(shape) / 128);
            out.push(32);
            push_decimal(inout out, lanes_per_chunk(shape));
            out.push(32);
            profile_name(required_profile(shape), inout out);
        }
        out.push(32);
        if !type_error(in ctx.types, in ctx.names, known, ty, inout out) {
            out.push(45);
        }
        out.push(32);
        let layout_word_count = layout_words(in ctx.types, in ctx.names, known, ty);
        if layout_word_count == NONE32 {
            out.push(45);
        } else {
            push_decimal(inout out, w(layout_word_count));
        }
        out.push(10);
        let node = ctx.types.node(ty);
        if node.kind == TyKind::Row || node.kind == TyKind::Fn {
            isa_lines(inout out, in ctx, in vec_names, node.r2, type_index);
        }
    }
    pack_text(in out)
}

// The lane 9 world section: function signatures in name order (name,
// span, result, params of (name, pass, type, span)), then each ADT's span
// and each field's temperature (0 none, 1 hot, 2 cold) in `World` order.
fn read_sigs(inout reader: Reader, in bytes: Slice[u8], in ctx: Ctx) -> Sigs {
    let mut sigs = sigs_new();
    let fn_count = reader.word(in bytes);
    for i in 0..fn_count {
        let name = u32_at(in ctx.nmap, reader.word(in bytes));
        let start = reader.word(in bytes);
        let stop = reader.word(in bytes);
        let result = u32_at(in ctx.tmap, reader.word(in bytes));
        let param_count = reader.word(in bytes);
        let first_param = n32(sigs.params.len());
        for j in 0..param_count {
            let param_name = u32_at(in ctx.nmap, reader.word(in bytes));
            let param_pass = wrapping_u8(reader.word(in bytes));
            let param_ty = u32_at(in ctx.tmap, reader.word(in bytes));
            let param_span_start = reader.word(in bytes);
            let param_span_stop = reader.word(in bytes);
            sigs.params.push(Param {
                name: param_name,
                pass: param_pass,
                ty: param_ty,
                start: param_span_start,
                stop: param_span_stop
            });
        }
        sigs.sigs.push(Sig {
            name: name,
            start: start,
            stop: stop,
            result: result,
            param_start: first_param,
            param_count: n32(param_count)
        });
    }
    for i in 0..ctx.world.adts.len() {
        sigs.adt_start.push(reader.word(in bytes));
        sigs.adt_stop.push(reader.word(in bytes));
    }
    for i in 0..ctx.world.fields.len() {
        sigs.field_temps.push(wrapping_u8(reader.word(in bytes)));
    }
    sigs
}

// Task "world": `seq::check_world` then `tiled::check_world_adts`, one
// diagnostic per line. Task words: the lane 9 world section.
pub fn regions_seqs_world(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mut reader = Reader { pos: 0 };
    let ctx = read_ctx(inout reader, in bytes);
    let sigs = read_sigs(inout reader, in bytes, in ctx);
    let mut seq_diags = diags_new();
    seq_check_world(in ctx.types, in ctx.names, in ctx.world, in sigs, inout seq_diags);
    let mut out = ChunkSeq::new[u8]();
    for i in 0..seq_diags.len() {
        diag_line(inout out, in seq_diags, i);
    }
    let mut tiled_diags = diags_new();
    check_world_adts(in ctx.types, in ctx.names, in ctx.world, in sigs, inout tiled_diags);
    for i in 0..tiled_diags.len() {
        diag_line(inout out, in tiled_diags, i);
    }
    pack_text(in out)
}

// Task "resolve": `seq::resolve(callee, receiver)` and the operation's
// properties. Task words: n, n queries of (callee name, receiver type + 1
// or 0 for a free call).
pub fn regions_seqs_resolve(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mut reader = Reader { pos: 0 };
    let mut ctx = read_ctx(inout reader, in bytes);
    let known = ctx.world.k;
    let seq_names = seq_names_new(inout ctx.names);
    let query_count = reader.word(in bytes);
    let mut out = ChunkSeq::new[u8]();
    for i in 0..query_count {
        let callee = u32_at(in ctx.nmap, reader.word(in bytes));
        let receiver_code = reader.word(in bytes);
        let receiver = if receiver_code == 0 {
            NONE32
        } else {
            u32_at(in ctx.tmap, wrapping_sub(receiver_code, 1))
        };
        let op = resolve(inout ctx.names, in seq_names, in ctx.types, known, callee, receiver);
        if op == 0 {
            put(inout out, "-\n");
            continue;
        }
        op_debug(op, inout out);
        out.push(32);
        op_name(in ctx.names, in seq_names, op, inout out);
        bit(inout out, fallible(op));
        bit(inout out, mutates(op));
        if receiver_pass(op) == 0 {
            put(inout out, " In");
        } else {
            put(inout out, " Inout");
        }
        bit(inout out, byte_scan(op));
        bit(inout out, has_receiver(op));
        bit(inout out, place_primitive(op));
        bit(inout out, grows(op));
        out.push(32);
        op_debug(with_arity(op, 3), inout out);
        out.push(10);
    }
    pack_text(in out)
}

// The decode alone (`read_ctx` and the vector names), which the speed
// test subtracts from the type task's time.
pub fn regions_seqs_decode(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mut reader = Reader { pos: 0 };
    let mut ctx = read_ctx(inout reader, in bytes);
    let vec_names = vec_names_new(inout ctx.names);
    let out = ChunkSeq::new[u8]();
    pack_text(in out)
}

// `vector::check_world` (isa.ves): the world facts in `input`, the tree
// parsed from `source`.
pub fn regions_seqs_isa(in input: Str, in source: Str) -> ChunkSeq[u64] {
    pack_text(in isa_text(in input, in source))
}
