// The type rules of src/regions.rs: region rows, `RegionBox[r, T]` and
// `Watermark[r]` handles, `normalize`, `validate_type`, `display`,
// `source_label` and `mismatch`. Started from the census sample
// (docs/parallel-results/self-host-census.md), now on @vesper/check-data.
// The expression half (`check_world`'s rewind flow and the checker methods
// of src/regions/check.rs) walks the AST: a later PR of #1181.

use @vesper/check-data::util::{add, inc32, push_decimal, u32_at, u8_at, w};
use @vesper/check-data::names::{Names};
use @vesper/check-data::types::{EffNode, Types, Vars, display, TyKind};
use @vesper/check-data::world::{Known};
use @vesper/check-data::diag::{Diags};

const NONE32: u32 = 4294967295;

// `region_row(label)`: `eff [label: Region]`.
pub fn region_row(inout types: Types, known: Known, label: u32) -> u32 {
    let mut effects: ChunkSeq[EffNode] = ChunkSeq::new[EffNode]();
    let args: ChunkSeq[u32] = ChunkSeq::new[u32]();
    effects.push(EffNode { label: inc32(label), name: known.region, a: 0, n: 0 });
    let row = types.mk_row(in effects, in args, 0);
    types.row_type(row)
}

pub fn box_type(inout types: Types, known: Known, label: u32, payload: u32) -> u32 {
    let row = region_row(inout types, known, label);
    let mut args: ChunkSeq[u32] = ChunkSeq::new[u32]();
    args.push(row);
    args.push(payload);
    types.named(known.region_box, in args)
}

pub fn watermark_type(inout types: Types, known: Known, label: u32) -> u32 {
    let row = region_row(inout types, known, label);
    let mut args: ChunkSeq[u32] = ChunkSeq::new[u32]();
    args.push(row);
    types.named(known.watermark, in args)
}

// `row_label`: label symbol + 1, or 0.
pub fn row_label(in types: Types, known: Known, ty: u32) -> u32 {
    let node = types.node(ty);
    if node.kind != TyKind::Row {
        return 0;
    }
    let row = types.row(node.r2);
    if row.tail != 0 || row.n != 1 {
        return 0;
    }
    let effect = types.effect_at(w(row.a));
    if effect.label != 0 && effect.name == known.region && effect.n == 0 {
        effect.label
    } else {
        0
    }
}

// `box_parts`: the label + 1 (0 = none); the payload is argument 1.
pub fn box_label(in types: Types, known: Known, ty: u32) -> u32 {
    let node = types.node(ty);
    if node.kind != TyKind::Named || node.name != known.region_box || node.n != 2 {
        return 0;
    }
    row_label(in types, known, types.arg(ty, 0))
}

pub fn watermark_label(in types: Types, known: Known, ty: u32) -> u32 {
    let node = types.node(ty);
    if node.kind != TyKind::Named || node.name != known.watermark || node.n != 1 {
        return 0;
    }
    row_label(in types, known, types.arg(ty, 0))
}

// `tiled::seq_region_label`: label + 1, or 0.
pub fn seq_region_label(in types: Types, known: Known, ty: u32) -> u32 {
    let node = types.node(ty);
    if node.kind != TyKind::Named || node.name != known.tiled_seq || node.n != 2 {
        return 0;
    }
    row_label(in types, known, types.arg(ty, 1))
}

pub fn is_handle_name(known: Known, sym: u32) -> bool {
    sym == known.region_box || sym == known.watermark
}

// `is_handle_type`.
pub fn is_handle_type(in types: Types, known: Known, ty: u32) -> bool {
    let node = types.node(ty);
    node.kind == TyKind::Named && is_handle_name(known, node.name)
}

// `source_name`: symbol + 1, or 0.
fn source_name(in types: Types, ty: u32) -> u32 {
    let node = types.node(ty);
    if node.kind == TyKind::Named && node.n == 0 {
        return inc32(node.name);
    }
    if node.kind == TyKind::Row {
        let row = types.row(node.r2);
        if row.n == 0 && row.tail != 0 {
            return row.tail;
        }
    }
    0
}

// `normalize(t, labels)`: `labels` maps source label symbols to capability
// identity symbols.
pub fn normalize(inout types: Types, known: Known, ty: u32, in labels: Vars) -> u32 {
    let node = types.node(ty);
    if node.kind == TyKind::Named {
        if node.n == 0 {
            return ty;
        }
        let mut args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](w(node.n));
        for i in 0..w(node.n) {
            let arg = u32_at(in types.items, add(w(node.a), i));
            let normalized = normalize(inout types, known, arg, in labels);
            args.push(normalized);
        }
        let slot: u64 = if is_handle_name(known, node.name) {
            0
        } else if node.name == known.tiled_seq && node.n == 2 {
            1
        } else {
            9
        };
        if slot != 9 {
            let source = source_name(in types, u32_at(in args, slot));
            if source != 0 {
                let cap = labels.get(wrapping_sub(source, 1));
                if cap != NONE32 {
                    let row = region_row(inout types, known, cap);
                    let ok = args.try_set(slot, row);
                }
            }
        }
        return types.named(node.name, in args);
    }
    if node.kind == TyKind::Tuple {
        let mut args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](w(node.n));
        for i in 0..w(node.n) {
            let arg = u32_at(in types.items, add(w(node.a), i));
            let normalized = normalize(inout types, known, arg, in labels);
            args.push(normalized);
        }
        return types.tuple(in args);
    }
    if node.kind == TyKind::Fn {
        let mut args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](w(node.n));
        let mut passes: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](w(node.n));
        for i in 0..w(node.n) {
            let item_index = add(w(node.a), i);
            passes.push(u8_at(in types.passes, item_index));
            let normalized = normalize(
                inout types,
                known,
                u32_at(in types.items, item_index),
                in labels
            );
            args.push(normalized);
        }
        let result = normalize(inout types, known, node.r, in labels);
        return types.mk_with(TyKind::Fn, node.mode, 0, in args, in passes, result, node.r2, 0);
    }
    ty
}

// `source_label`: "region@N" for `$capN`, "region of f" for `$fncap:f:i`,
// "region" for other `$` identities, else the label.
fn source_label(in names: Names, label: u32, inout out: ChunkSeq[u8]) {
    if names.has_prefix(label, in "$cap".as_bytes()) {
        out.extend(in "region@".as_bytes());
        let start = names.start(label);
        let end = names.end(label);
        for i in add(start, 4)..end {
            out.push(u8_at(in names.text, i));
        }
        return;
    }
    if names.has_prefix(label, in "$fncap:".as_bytes()) {
        out.extend(in "region of ".as_bytes());
        let start = add(names.start(label), 7);
        let end = names.end(label);
        // `rsplit_once(':')`: up to the last ':', or all of it.
        let mut cut = end;
        let mut i = end;
        loop {
            if i <= start {
                break;
            }
            i = wrapping_sub(i, 1);
            if u8_at(in names.text, i) == 58 {
                cut = i;
                break;
            }
        }
        for j in start..cut {
            out.push(u8_at(in names.text, j));
        }
        return;
    }
    if names.has_prefix(label, in "$".as_bytes()) {
        out.extend(in "region".as_bytes());
        return;
    }
    names.write(label, inout out);
}

// `regions::display`.
pub fn region_display(
    in types: Types,
    in names: Names,
    known: Known,
    ty: u32,
    inout out: ChunkSeq[u8]
) {
    let label = row_label(in types, known, ty);
    if label != 0 {
        source_label(in names, wrapping_sub(label, 1), inout out);
        return;
    }
    let node = types.node(ty);
    if node.kind == TyKind::Row {
        let source = source_name(in types, ty);
        if source != 0 {
            names.write(wrapping_sub(source, 1), inout out);
            return;
        }
    }
    if node.kind == TyKind::Named && node.n > 0 {
        names.write(node.name, inout out);
        out.push(91);
        for i in 0..w(node.n) {
            if i > 0 {
                out.extend(in ", ".as_bytes());
            }
            region_display(in types, in names, known, types.arg(ty, i), inout out);
        }
        out.push(93);
        return;
    }
    if node.kind == TyKind::Tuple {
        out.push(40);
        for i in 0..w(node.n) {
            if i > 0 {
                out.extend(in ", ".as_bytes());
            }
            region_display(in types, in names, known, types.arg(ty, i), inout out);
        }
        out.push(41);
        return;
    }
    display(in types, in names, ty, inout out);
}

// `validate_type`: false when `ty` is not a region type (Rust `None`);
// otherwise its diagnostics are appended to `diags`.
pub fn validate_type(
    in types: Types,
    in names: Names,
    known: Known,
    ty: u32,
    start: u64,
    stop: u64,
    inout diags: Diags
) -> bool {
    let node = types.node(ty);
    if node.kind != TyKind::Named {
        return false;
    }
    if node.name == known.tiled_seq && node.n == 2 {
        let arg = types.arg(ty, 1);
        if row_label(in types, known, arg) == 0 {
            let code_start = diags.open("E0797");
            let msg_start = diags.text.len();
            diags.text.extend(in "the second argument of ".as_bytes());
            names.write(node.name, inout diags.text);
            diags.text.extend(in " must name a region capability in scope, found ".as_bytes());
            region_display(in types, in names, known, arg, inout diags.text);
            diags.close(
                code_start,
                msg_start,
                "bind one with `region r { ... }` or declare `eff [r: Region]`",
                start,
                stop
            );
        }
        return true;
    }
    if !is_handle_name(known, node.name) {
        return false;
    }
    let arity: u32 = if node.name == known.region_box { 2 } else { 1 };
    if node.n != arity {
        let code_start = diags.open("E0797");
        let msg_start = diags.text.len();
        names.write(node.name, inout diags.text);
        diags.text.extend(in " expects ".as_bytes());
        push_decimal(inout diags.text, w(arity));
        diags.text.extend(in " type arguments, found ".as_bytes());
        push_decimal(inout diags.text, w(node.n));
        if node.name == known.region_box {
            diags.close(
                code_start,
                msg_start,
                "write RegionBox[r, T] for a T allocated in region r",
                start,
                stop
            );
        } else {
            diags.close(
                code_start,
                msg_start,
                "write Watermark[r] for a checkpoint of region r",
                start,
                stop
            );
        }
    } else if row_label(in types, known, types.arg(ty, 0)) == 0 {
        let code_start = diags.open("E0797");
        let msg_start = diags.text.len();
        diags.text.extend(in "the first argument of ".as_bytes());
        names.write(node.name, inout diags.text);
        diags.text.extend(in " must name a region capability in scope, found ".as_bytes());
        region_display(in types, in names, known, types.arg(ty, 0), inout diags.text);
        diags.close(
            code_start,
            msg_start,
            "bind one with `region r { ... }` or declare `eff [r: Region]`",
            start,
            stop
        );
    }
    true
}

fn mentions(in types: Types, known: Known, ty: u32) -> bool {
    let node = types.node(ty);
    if node.kind == TyKind::Named {
        if is_handle_name(known, node.name) || (node.name == known.tiled_seq && node.n == 2) {
            return true;
        }
    }
    if node.kind == TyKind::Named || node.kind == TyKind::Tuple {
        for i in 0..w(node.n) {
            if mentions(in types, known, types.arg(ty, i)) {
                return true;
            }
        }
    }
    false
}

fn differ(a: u32, b: u32) -> bool {
    a != 0 && b != 0 && a != b
}

// `mismatch`: false when neither side involves regions.
pub fn mismatch(
    in types: Types,
    in names: Names,
    known: Known,
    expected: u32,
    actual: u32,
    start: u64,
    stop: u64,
    inout diags: Diags
) -> bool {
    if !mentions(in types, known, expected) && !mentions(in types, known, actual) {
        return false;
    }
    let cross = differ(box_label(in types, known, expected), box_label(in types, known, actual))
        || differ(
            watermark_label(in types, known, expected),
            watermark_label(in types, known, actual)
        )
        || differ(
            seq_region_label(in types, known, expected),
            seq_region_label(in types, known, actual)
        );
    let code_start = if cross {
        diags.open("E0792")
    } else {
        diags.open("E0200")
    };
    let msg_start = diags.text.len();
    diags.text.extend(in "expected ".as_bytes());
    region_display(in types, in names, known, expected, inout diags.text);
    diags.text.extend(in ", found ".as_bytes());
    region_display(in types, in names, known, actual, inout diags.text);
    if cross {
        diags
            .text
            .extend(in ": a region reference belongs to the region that allocated it".as_bytes());
    }
    diags.close(code_start, msg_start, "", start, stop);
    true
}
