// The `Isa` discipline of src/vector.rs `check_world` over the @vesper/ast
// tree: E1401 (a two-parameter `Vec` or `Mask` ADT), E1402 (aggregate
// comparison of vector or mask values) and E1403 (a vector operation, a
// `load_tile_vec` profile or a call that needs an `Isa[P]` the scope does
// not grant).
//
// The tree is the source parsed by @vesper/ast. The world facts the walk
// reads come in the input (the layout is `isa_input` in
// tests/self_host_check_regions_seqs.rs): the ADTs (name, span, generics,
// field types), the functions in `world.functions` order (name, effect
// row, body span) and the checker's recorded expression types. The walk
// and every rule are here.
//
// Types are rows of `T`: Other (anything the walk never looks into, and
// `Infer`), Named (name, args), Tuple (items) or Function (its effect row:
// each effect's name and its argument when it has exactly one).

use @vesper/ast::{
    Ast, ExprNode, TypeNode, StmtNode, ArgNode, ClauseNode, EffectsNode, EffectNode, FnNode,
    list_len, list_at, expr_at, type_at, lit_at
};
use @vesper/ast::lower::{lower_source};
use @vesper-std/arena::{idx_from_raw};
use @vesper-std/intern::{symbol_from_id};
use @vesper/check-data::util::{push_decimal};

const NONE: u32 = 4294967295;
const NO_TY: u32 = 4294967295;

const TK_OTHER: u8 = 0;
const TK_NAMED: u8 = 1;
const TK_TUPLE: u8 = 2;
const TK_FN: u8 = 3;

// @vesper/ast expression kinds.
const E_LITERAL: u8 = 1;
const E_NAME: u8 = 2;
const E_TUPLE: u8 = 3;
const E_STRUCT: u8 = 4;
const E_BLOCK: u8 = 5;
const E_CALL: u8 = 6;
const E_FIELD: u8 = 7;
const E_INDEX: u8 = 8;
const E_TRY: u8 = 9;
const E_UNARY: u8 = 10;
const E_BINARY: u8 = 11;
const E_ASSIGN: u8 = 12;
const E_IF: u8 = 13;
const E_MATCH: u8 = 14;
const E_CLOSURE: u8 = 15;
const E_HANDLE: u8 = 16;
const E_LOOP: u8 = 17;
const E_FOR: u8 = 18;
const E_RANGE: u8 = 19;
const E_BREAK: u8 = 20;
const E_RETURN: u8 = 21;
const AT_NAMED: u8 = 1;

// Profiles: 1 Baseline128, 2 Avx2, 3 Avx512, 4 Sve2, 5 Rvv1 (0 = none).
const P_BASE: u8 = 1;
const P_AVX2: u8 = 2;
const P_AVX512: u8 = 3;

// Intrinsic classes the walk distinguishes (`Intrinsic`), 0 = not one.
const I_OTHER: u8 = 1;
const I_ISA: u8 = 2;
const I_LOAD: u8 = 3;
const I_STORE: u8 = 4;
const I_STORE_MASKED: u8 = 5;
const I_LOAD_MASKED: u8 = 6;
const I_CONVERT: u8 = 7;
const I_EXTRACT: u8 = 8;
const I_REPLACE: u8 = 9;
const I_SHUFFLE: u8 = 10;
// A reserved namespace's unknown name (`Some(Err(()))`).
const I_UNKNOWN: u8 = 255;

fn u32_at(in seq: ChunkSeq[u32], i: u64) -> u32 {
    match seq.try_get(i) {
        Option::Some(x) => x,
        Option::None => NONE,
    }
}

fn u64_at(in seq: ChunkSeq[u64], i: u64) -> u64 {
    match seq.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

fn u8_at(in seq: ChunkSeq[u8], i: u64) -> u8 {
    match seq.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

fn byte_at(in bytes: Slice[u8], i: u64) -> u8 {
    match bytes.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

fn w64(value: u32) -> u64 {
    widen_u64(value)
}

fn stmt_at(in ast: Ast, i: u32) -> StmtNode {
    ast.stmts.get_or(
        idx_from_raw[StmtNode](i),
        StmtNode { kind: 0, pat: NONE, ty: NONE, value: NONE, mutable: false }
    )
}

fn arg_at(in ast: Ast, i: u32) -> ArgNode {
    ast.args.get_or(idx_from_raw[ArgNode](i), ArgNode { pass: 0, explicit: false, expr: NONE })
}

fn clause_at(in ast: Ast, i: u32) -> ClauseNode {
    ast.clauses.get_or(idx_from_raw[ClauseNode](i), ClauseNode { name: NONE, pats: 0, body: NONE })
}

fn effects_at(in ast: Ast, i: u32) -> EffectsNode {
    ast.effects.get_or(idx_from_raw[EffectsNode](i), EffectsNode { instances: 0, tail: NONE })
}

fn effect_at(in ast: Ast, i: u32) -> EffectNode {
    ast.effect_nodes
        .get_or(idx_from_raw[EffectNode](i), EffectNode { label: NONE, name: NONE, args: 0 })
}

fn fn_at(in ast: Ast, i: u32) -> FnNode {
    ast.fns.get_or(
        idx_from_raw[FnNode](i),
        FnNode {
            name: NONE,
            fip: false,
            generics: 0,
            params: 0,
            result: NONE,
            effects: NONE,
            body: NONE,
            start: 0,
            end: 0
        }
    )
}

// Whether symbol `sym` of the tree is `text`.
fn sym_is(in ast: Ast, sym: u32, in text: Str) -> bool {
    if sym == NONE {
        return false;
    }
    ast.names.symbol_eq(symbol_from_id(sym), in text)
}

// The bytes of symbol `sym`, appended to `out`.
fn sym_text(in ast: Ast, sym: u32, inout out: ChunkSeq[u8]) {
    if sym == NONE {
        return;
    }
    let (start, end) = ast.names.span(symbol_from_id(sym));
    for i in start..end {
        match ast.names.text_byte(i) {
            Option::Some(byte) => out.push(byte),
            Option::None => {}
        }
    }
}

// Interns UTF-8 `bytes[start..end]` into the tree's names.
fn intern_bytes(inout ast: Ast, in bytes: Slice[u8], start: u64, end: u64) -> u32 {
    let mut text = String::new();
    let mut i = start;
    loop {
        if i >= end {
            break;
        }
        let lead = widen_u64(byte_at(in bytes, i));
        let (code_point, char_len): (u64, u64) = if lead < 128 {
            (lead, 1)
        } else if lead < 224 {
            (((lead & 31) << 6) | (widen_u64(byte_at(in bytes, wrapping_add(i, 1))) & 63), 2)
        } else if lead < 240 {
            (
                ((lead & 15) << 12)
                    | ((widen_u64(byte_at(in bytes, wrapping_add(i, 1))) & 63) << 6)
                    | (widen_u64(byte_at(in bytes, wrapping_add(i, 2))) & 63),
                3
            )
        } else {
            (
                ((lead & 7) << 18)
                    | ((widen_u64(byte_at(in bytes, wrapping_add(i, 1))) & 63) << 12)
                    | ((widen_u64(byte_at(in bytes, wrapping_add(i, 2))) & 63) << 6)
                    | (widen_u64(byte_at(in bytes, wrapping_add(i, 3))) & 63),
                4
            )
        };
        let _ = text.push_char(wrapping_u32(code_point));
        i = wrapping_add(i, char_len);
    }
    ast.names.intern(in text).id()
}

fn intern_seq(inout ast: Ast, in bytes: ChunkSeq[u8]) -> u32 {
    intern_bytes(inout ast, in bytes.as_slice(), 0, bytes.len())
}

// The walk's state.
pub struct I {
    // types: kind, name symbol, items ty_items[ty_item_start..+ty_item_count]
    // (a Function's range indexes its effect row in effect_name/effect_arg)
    ty_kind: ChunkSeq[u8],
    ty_name: ChunkSeq[u32],
    ty_item_start: ChunkSeq[u64],
    ty_item_count: ChunkSeq[u64],
    ty_items: ChunkSeq[u32],
    effect_name: ChunkSeq[u32],
    effect_arg: ChunkSeq[u32],
    // the checker's types by span key (start << 32 | end), sorted
    recorded_key: ChunkSeq[u64],
    recorded_ty: ChunkSeq[u32],
    // ADTs: name, generics generic_names[adt_generic_start..+adt_generic_count],
    // field types field_tys[adt_field_start..+adt_field_count]
    adt_name: ChunkSeq[u32],
    adt_generic_start: ChunkSeq[u64],
    adt_generic_count: ChunkSeq[u64],
    adt_field_start: ChunkSeq[u64],
    adt_field_count: ChunkSeq[u64],
    generic_names: ChunkSeq[u32],
    field_tys: ChunkSeq[u32],
    // functions: name, row profiles profiles[fn_profile_start..+fn_profile_count]
    fn_name: ChunkSeq[u32],
    fn_profile_start: ChunkSeq[u64],
    fn_profile_count: ChunkSeq[u64],
    profiles: ChunkSeq[u8],
    // the report
    out: ChunkSeq[u8],
    // symbols
    vec_name: u32,
    mask_name: u32,
    isa_name: u32,
    tiled_seq_name: u32,
    chunk_seq_name: u32,
    slice_name: u32,
    load_tile_vec_path: u32,
    load_tile_vec_name: u32,
}

fn i_new(inout ast: Ast) -> I {
    let mut walk = I {
        ty_kind: ChunkSeq::new[u8](),
        ty_name: ChunkSeq::new[u32](),
        ty_item_start: ChunkSeq::new[u64](),
        ty_item_count: ChunkSeq::new[u64](),
        ty_items: ChunkSeq::new[u32](),
        effect_name: ChunkSeq::new[u32](),
        effect_arg: ChunkSeq::new[u32](),
        recorded_key: ChunkSeq::new[u64](),
        recorded_ty: ChunkSeq::new[u32](),
        adt_name: ChunkSeq::new[u32](),
        adt_generic_start: ChunkSeq::new[u64](),
        adt_generic_count: ChunkSeq::new[u64](),
        adt_field_start: ChunkSeq::new[u64](),
        adt_field_count: ChunkSeq::new[u64](),
        generic_names: ChunkSeq::new[u32](),
        field_tys: ChunkSeq::new[u32](),
        fn_name: ChunkSeq::new[u32](),
        fn_profile_start: ChunkSeq::new[u64](),
        fn_profile_count: ChunkSeq::new[u64](),
        profiles: ChunkSeq::new[u8](),
        out: ChunkSeq::new[u8](),
        vec_name: ast.names.intern(in "Vec").id(),
        mask_name: ast.names.intern(in "Mask").id(),
        isa_name: ast.names.intern(in "Isa").id(),
        tiled_seq_name: ast.names.intern(in "TiledSeq").id(),
        chunk_seq_name: ast.names.intern(in "ChunkSeq").id(),
        slice_name: ast.names.intern(in "Slice").id(),
        load_tile_vec_path: ast.names.intern(in "TiledSeq::load_tile_vec").id(),
        load_tile_vec_name: ast.names.intern(in "load_tile_vec").id(),
    };
    // Type 0 is Other.
    let no_items: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let other_ty = walk.ty(TK_OTHER, NONE, in no_items);
    walk
}

impl I {
    fn ty(inout self, kind: u8, name: u32, in items: ChunkSeq[u32]) -> u32 {
        let id = wrapping_u32(self.ty_kind.len());
        self.ty_kind.push(kind);
        self.ty_name.push(name);
        self.ty_item_start.push(self.ty_items.len());
        self.ty_item_count.push(items.len());
        for i in 0..items.len() {
            self.ty_items.push(u32_at(in items, i));
        }
        id
    }

    fn kind(in self, ty: u32) -> u8 {
        if ty == NO_TY {
            return TK_OTHER;
        }
        u8_at(in self.ty_kind, w64(ty))
    }

    fn name(in self, ty: u32) -> u32 {
        if ty == NO_TY {
            return NONE;
        }
        u32_at(in self.ty_name, w64(ty))
    }

    fn count(in self, ty: u32) -> u64 {
        if ty == NO_TY {
            return 0;
        }
        u64_at(in self.ty_item_count, w64(ty))
    }

    fn item(in self, ty: u32, i: u64) -> u32 {
        if i >= self.count(ty) {
            return NO_TY;
        }
        u32_at(in self.ty_items, wrapping_add(u64_at(in self.ty_item_start, w64(ty)), i))
    }

    fn recorded(in self, start: u32, end: u32) -> u32 {
        let key = (w64(start) << 32) | w64(end);
        let mut lo: u64 = 0;
        let mut hi = self.recorded_key.len();
        loop {
            if lo >= hi {
                return 0;
            }
            let mid = wrapping_add(lo, hi) >> 1;
            let mid_key = u64_at(in self.recorded_key, mid);
            if mid_key == key {
                return u32_at(in self.recorded_ty, mid);
            }
            if mid_key < key {
                lo = wrapping_add(mid, 1);
            } else {
                hi = mid;
            }
        }
    }

    // The function named `name`: its index + 1, or 0.
    fn function(in self, name: u32) -> u64 {
        for i in 0..self.fn_name.len() {
            if u32_at(in self.fn_name, i) == name {
                return wrapping_add(i, 1);
            }
        }
        0
    }

    fn adt(in self, name: u32) -> u64 {
        // A later entry with the same name replaces an earlier one.
        let mut found: u64 = 0;
        for i in 0..self.adt_name.len() {
            if u32_at(in self.adt_name, i) == name {
                found = wrapping_add(i, 1);
            }
        }
        found
    }
}

// ------------------------------------------------------------------ input

struct Rd {
    pos: u64,
}

impl Rd {
    fn word(inout self, in bytes: Slice[u8]) -> u64 {
        let value = match bytes.try_read_u64_le(self.pos) {
            Option::Some(value) => value,
            Option::None => 0,
        };
        self.pos = wrapping_add(self.pos, 8);
        value
    }

    // A string: its length, then its bytes padded to whole words.
    fn text(inout self, inout ast: Ast, in bytes: Slice[u8]) -> u32 {
        let len = self.word(in bytes);
        let start = self.pos;
        self.pos = wrapping_add(start, wrapping_mul(wrapping_add(len, 7) >> 3, 8));
        intern_bytes(inout ast, in bytes, start, wrapping_add(start, len))
    }
}

fn read_ty(inout reader: Rd, in bytes: Slice[u8], inout ast: Ast, inout walk: I) -> u32 {
    let tag = reader.word(in bytes);
    let mut items: ChunkSeq[u32] = ChunkSeq::new[u32]();
    if tag == 1 {
        let name = reader.text(inout ast, in bytes);
        let count = reader.word(in bytes);
        for i in 0..count {
            items.push(read_ty(inout reader, in bytes, inout ast, inout walk));
        }
        return walk.ty(TK_NAMED, name, in items);
    }
    if tag == 2 {
        let count = reader.word(in bytes);
        for i in 0..count {
            items.push(read_ty(inout reader, in bytes, inout ast, inout walk));
        }
        return walk.ty(TK_TUPLE, NONE, in items);
    }
    if tag == 3 {
        // A function type: its effect row.
        let count = reader.word(in bytes);
        let mut effect_names: ChunkSeq[u32] = ChunkSeq::new[u32]();
        let mut effect_args: ChunkSeq[u32] = ChunkSeq::new[u32]();
        for i in 0..count {
            effect_names.push(reader.text(inout ast, in bytes));
            let arg_count = reader.word(in bytes);
            let mut only_arg = NO_TY;
            for j in 0..arg_count {
                let arg_ty = read_ty(inout reader, in bytes, inout ast, inout walk);
                if arg_count == 1 {
                    only_arg = arg_ty;
                }
            }
            effect_args.push(only_arg);
        }
        let id = wrapping_u32(walk.ty_kind.len());
        walk.ty_kind.push(TK_FN);
        walk.ty_name.push(NONE);
        walk.ty_item_start.push(walk.effect_name.len());
        walk.ty_item_count.push(count);
        for i in 0..count {
            walk.effect_name.push(u32_at(in effect_names, i));
            walk.effect_arg.push(u32_at(in effect_args, i));
        }
        return id;
    }
    0
}

// ------------------------------------------------------------------ rules

fn profile_of_sym(in ast: Ast, sym: u32) -> u8 {
    if sym_is(in ast, sym, in "Baseline128") {
        1
    } else if sym_is(in ast, sym, in "Avx2") {
        2
    } else if sym_is(in ast, sym, in "Avx512") {
        3
    } else if sym_is(in ast, sym, in "Sve2") {
        4
    } else if sym_is(in ast, sym, in "Rvv1") {
        5
    } else {
        0
    }
}

fn profile_name(profile: u8, inout out: ChunkSeq[u8]) {
    let text = if profile == 1 {
        "Baseline128"
    } else if profile == 2 {
        "Avx2"
    } else if profile == 3 {
        "Avx512"
    } else if profile == 4 {
        "Sve2"
    } else {
        "Rvv1"
    };
    out.extend(in text.as_bytes());
}

// `Profile::le`: `needed ⊑ granted`.
fn profile_le(needed: u8, granted: u8) -> bool {
    needed == granted || needed == P_BASE || (needed == P_AVX2 && granted == P_AVX512)
}

fn fixed_bits(profile: u8) -> u64 {
    if profile == P_AVX2 {
        256
    } else if profile == P_AVX512 {
        512
    } else {
        128
    }
}

// The profile of an `Isa[P]` effect: its argument a Named type with no
// arguments that names a profile.
fn effect_profile(in ast: Ast, in walk: I, name: u32, arg: u32) -> u8 {
    if name != walk.isa_name || arg == NO_TY || walk.kind(arg) != TK_NAMED || walk.count(arg) != 0 {
        return 0;
    }
    profile_of_sym(in ast, walk.name(arg))
}

// `row_profiles` of a Function type.
fn fn_type_profiles(in ast: Ast, in walk: I, ty: u32, inout out: ChunkSeq[u8]) -> bool {
    if walk.kind(ty) != TK_FN {
        return false;
    }
    let row_start = u64_at(in walk.ty_item_start, w64(ty));
    for i in 0..walk.count(ty) {
        let effect_index = wrapping_add(row_start, i);
        let profile = effect_profile(
            in ast,
            in walk,
            u32_at(in walk.effect_name, effect_index),
            u32_at(in walk.effect_arg, effect_index)
        );
        if profile != 0 {
            out.push(profile);
        }
    }
    true
}

// `row_profiles` of an AST effect row (a closure's).
fn ast_row_profiles(in ast: Ast, effects: u32, inout out: ChunkSeq[u8]) {
    if effects == NONE {
        return;
    }
    let row = effects_at(in ast, effects);
    for i in 0..list_len(in ast, row.instances) {
        let effect = effect_at(in ast, list_at(in ast, row.instances, i));
        if effect.name == NONE
            || !sym_is(in ast, effect.name, in "Isa")
            || list_len(in ast, effect.args) != 1
        {
            continue;
        }
        let arg_node = type_at(in ast, list_at(in ast, effect.args, 0));
        if arg_node.kind != AT_NAMED || list_len(in ast, arg_node.b) != 0 {
            continue;
        }
        let profile = profile_of_sym(in ast, arg_node.a);
        if profile != 0 {
            out.push(profile);
        }
    }
}

// The lane bits of an element type name (`Elem::from_name`), 0 if none.
fn elem_bits_of(in ast: Ast, sym: u32) -> u64 {
    if sym_is(in ast, sym, in "u8") {
        8
    } else if sym_is(in ast, sym, in "u32") || sym_is(in ast, sym, in "f32") {
        32
    } else if sym_is(in ast, sym, in "u64")
        || sym_is(in ast, sym, in "i64")
        || sym_is(in ast, sym, in "f64")
    {
        64
    } else {
        0
    }
}

// A lane count: `u16`'s parse of the name's text, `strict` for
// `is_lane_count` (digits only, no sign). NONE when not one.
fn lane_count(in ast: Ast, sym: u32, strict: bool) -> u64 {
    let mut text: ChunkSeq[u8] = ChunkSeq::new[u8]();
    sym_text(in ast, sym, inout text);
    let mut i: u64 = 0;
    if !strict && u8_at(in text, 0) == 43 {
        i = 1;
    }
    if i >= text.len() {
        return 4294967295;
    }
    let mut value: u64 = 0;
    loop {
        if i >= text.len() {
            break;
        }
        let byte = u8_at(in text, i);
        if byte < 48 || byte > 57 {
            return 4294967295;
        }
        value = wrapping_add(wrapping_mul(value, 10), wrapping_sub(widen_u64(byte), 48));
        if value > 65535 {
            return 4294967295;
        }
        i = wrapping_add(i, 1);
    }
    value
}

// A shape's bits (`Shape::new`): 0 unless 128, 256 or 512.
fn shape_bits(elem: u64, lanes: u64) -> u64 {
    if elem == 0 || lanes == 4294967295 {
        return 0;
    }
    let bits = wrapping_mul(elem, lanes);
    if bits == 128 || bits == 256 || bits == 512 {
        bits
    } else {
        0
    }
}

// `shape_of`: the bits of a valid vector or mask type, 0 if not one.
fn shape_of(in ast: Ast, in walk: I, ty: u32) -> u64 {
    if walk.kind(ty) != TK_NAMED {
        return 0;
    }
    let name = walk.name(ty);
    if name != walk.vec_name && name != walk.mask_name {
        return 0;
    }
    if walk.count(ty) != 2 {
        return 0;
    }
    let elem_ty = walk.item(ty, 0);
    let count_ty = walk.item(ty, 1);
    if walk.kind(count_ty) != TK_NAMED || walk.count(count_ty) != 0 {
        return 0;
    }
    let lanes = lane_count(in ast, walk.name(count_ty), true);
    if walk.kind(elem_ty) != TK_NAMED || walk.count(elem_ty) != 0 {
        return 0;
    }
    shape_bits(elem_bits_of(in ast, walk.name(elem_ty)), lanes)
}

// `explicit_shape` of explicit type arguments `[T, N]` (AST types).
fn explicit_shape(in ast: Ast, types: u32) -> u64 {
    if list_len(in ast, types) != 2 {
        return 0;
    }
    let elem_node = type_at(in ast, list_at(in ast, types, 0));
    let count_node = type_at(in ast, list_at(in ast, types, 1));
    if count_node.kind != AT_NAMED {
        return 0;
    }
    if elem_node.kind != AT_NAMED || list_len(in ast, elem_node.b) != 0 {
        return 0;
    }
    shape_bits(elem_bits_of(in ast, elem_node.a), lane_count(in ast, count_node.a, false))
}

fn required_profile(bits: u64) -> u8 {
    if bits == 128 {
        P_BASE
    } else if bits == 256 {
        P_AVX2
    } else {
        P_AVX512
    }
}

// `Intrinsic::lookup`, in the classes the walk distinguishes.
fn intrinsic(in ast: Ast, name: u32) -> u8 {
    let mut text: ChunkSeq[u8] = ChunkSeq::new[u8]();
    sym_text(in ast, name, inout text);
    // Split at the first `::`.
    let mut sep_at: u64 = 0;
    let mut found = false;
    loop {
        if wrapping_add(sep_at, 1) >= text.len() {
            break;
        }
        if u8_at(in text, sep_at) == 58 && u8_at(in text, wrapping_add(sep_at, 1)) == 58 {
            found = true;
            break;
        }
        sep_at = wrapping_add(sep_at, 1);
    }
    if !found {
        return 0;
    }
    let method_start = wrapping_add(sep_at, 2);
    let text_len = text.len();
    let is_vec = range_is(in text, 0, sep_at, in "Vec");
    let is_mask = range_is(in text, 0, sep_at, in "Mask");
    let is_isa = range_is(in text, 0, sep_at, in "Isa");
    if is_vec {
        if range_is(in text, method_start, text_len, in "load") {
            return I_LOAD;
        }
        if range_is(in text, method_start, text_len, in "store") {
            return I_STORE;
        }
        if range_is(in text, method_start, text_len, in "store_masked") {
            return I_STORE_MASKED;
        }
        if range_is(in text, method_start, text_len, in "load_masked") {
            return I_LOAD_MASKED;
        }
        if range_is(in text, method_start, text_len, in "to_bits")
            || range_is(in text, method_start, text_len, in "from_bits")
            || range_is(in text, method_start, text_len, in "widen_f64")
            || range_is(in text, method_start, text_len, in "nearest_f32")
        {
            return I_CONVERT;
        }
        if range_is(in text, method_start, text_len, in "extract") {
            return I_EXTRACT;
        }
        if range_is(in text, method_start, text_len, in "replace") {
            return I_REPLACE;
        }
        if range_is(in text, method_start, text_len, in "shuffle") {
            return I_SHUFFLE;
        }
        let others = "splat from add sub mul div min max and or xor saturating_add saturating_sub not sqrt abs neg mul_add shl shr eq ne lt le gt ge select reduce_add reduce_xor reduce_or reduce_and reduce_min reduce_max";
        if word_in(in text, method_start, text_len, in others) {
            return I_OTHER;
        }
        return I_UNKNOWN;
    }
    if is_mask {
        let others = "and or xor not count bitmask any all in_bounds active";
        if word_in(in text, method_start, text_len, in others) {
            return I_OTHER;
        }
        return I_UNKNOWN;
    }
    if is_isa {
        if range_is(in text, method_start, text_len, in "supported") {
            return I_ISA;
        }
        return I_UNKNOWN;
    }
    0
}

// Whether `bytes[start..end]` is `text`.
fn range_is(in bytes: ChunkSeq[u8], start: u64, end: u64, in text: Str) -> bool {
    let expected = text.as_bytes();
    if wrapping_sub(end, start) != expected.len() {
        return false;
    }
    for i in 0..expected.len() {
        if u8_at(in bytes, wrapping_add(start, i)) != byte_at(in expected, i) {
            return false;
        }
    }
    true
}

// Whether `bytes[start..end]` is one of the space-separated words of `list`.
fn word_in(in bytes: ChunkSeq[u8], start: u64, end: u64, in list: Str) -> bool {
    let list_bytes = list.as_bytes();
    let len = wrapping_sub(end, start);
    let mut word_start: u64 = 0;
    let mut i: u64 = 0;
    loop {
        if i > list_bytes.len() {
            break;
        }
        if i == list_bytes.len() || byte_at(in list_bytes, i) == 32 {
            if wrapping_sub(i, word_start) == len {
                let mut same = true;
                for k in 0..len {
                    if u8_at(in bytes, wrapping_add(start, k))
                        != byte_at(in list_bytes, wrapping_add(word_start, k))
                    {
                        same = false;
                        break;
                    }
                }
                if same {
                    return true;
                }
            }
            word_start = wrapping_add(i, 1);
        }
        i = wrapping_add(i, 1);
    }
    false
}

fn is_seq_or_slice(in walk: I, ty: u32) -> bool {
    walk.kind(ty) == TK_NAMED
        && walk.count(ty) == 1
        && (walk.name(ty) == walk.chunk_seq_name || walk.name(ty) == walk.slice_name)
}

fn is_tiled_seq(in walk: I, ty: u32) -> bool {
    walk.kind(ty) == TK_NAMED
        && walk.name(ty) == walk.tiled_seq_name
        && (walk.count(ty) == 1 || walk.count(ty) == 2)
}

// A literal lane index (`u16::try_from` of an integer literal).
fn is_lane_literal(in ast: Ast, expr_id: u32) -> bool {
    let node = expr_at(in ast, expr_id);
    if node.kind != E_LITERAL {
        return false;
    }
    let lit = lit_at(in ast, node.a);
    if lit.kind != 1 || lit.hi != 0 || lit.bits > 65535 {
        return false;
    }
    ! lit.neg || lit.bits == 0
}

// `VectorOp::resolve(..).shape()`: the operation's shape bits, 0 for none.
fn op_shape(
    in ast: Ast,
    inout walk: I,
    intrinsic_class: u8,
    types: u32,
    args: u32,
    result: u32
) -> u64 {
    let arg_count = list_len(in ast, args);
    let first_ty = if arg_count > 0 {
        arg_type(in ast, in walk, args, 0)
    } else {
        NO_TY
    };
    // `SliceIo::resolve`.
    let applies = intrinsic_class == I_LOAD
        || intrinsic_class == I_STORE
        || intrinsic_class == I_STORE_MASKED
        || (
            intrinsic_class == I_LOAD_MASKED
                && first_ty != NO_TY
                && is_seq_or_slice(in walk, first_ty)
        );
    if applies {
        let store = intrinsic_class == I_STORE || intrinsic_class == I_STORE_MASKED;
        let io_shape = if store {
            if arg_count > 2 {
                shape_of(in ast, in walk, arg_type(in ast, in walk, args, 2))
            } else {
                0
            }
        } else {
            let result_shape = shape_of(in ast, in walk, result);
            if result_shape != 0 {
                result_shape
            } else {
                explicit_shape(in ast, types)
            }
        };
        if io_shape != 0 {
            return io_shape;
        }
    }
    let operand_shape = if first_ty == NO_TY {
        0
    } else {
        shape_of(in ast, in walk, first_ty)
    };
    let shape = if intrinsic_class == I_CONVERT {
        operand_shape
    } else {
        let result_shape = shape_of(in ast, in walk, result);
        if result_shape != 0 {
            result_shape
        } else if operand_shape != 0 {
            operand_shape
        } else {
            explicit_shape(in ast, types)
        }
    };
    if shape == 0 {
        return 0;
    }
    // Literal lane indices.
    let (lo, hi): (u64, u64) = if intrinsic_class == I_EXTRACT || intrinsic_class == I_REPLACE {
        (1, 2)
    } else if intrinsic_class == I_SHUFFLE {
        (1, if arg_count > 1 { arg_count } else { 1 })
    } else {
        (0, 0)
    };
    for i in lo..hi {
        if !is_lane_literal(in ast, arg_at(in ast, list_at(in ast, args, i)).expr) {
            return 0;
        }
    }
    shape
}

fn arg_type(in ast: Ast, in walk: I, args: u32, i: u64) -> u32 {
    let expr_id = arg_at(in ast, list_at(in ast, args, i)).expr;
    expr_type(in ast, in walk, expr_id)
}

fn expr_type(in ast: Ast, in walk: I, expr_id: u32) -> u32 {
    let node = expr_at(in ast, expr_id);
    walk.recorded(node.start, node.end)
}

// `substitute` of `ty` with the ADT's generics `g` bound to `args` (of the
// type `owner`); only Named and Tuple types are rebuilt.
fn subst(inout walk: I, ty: u32, adt: u64, owner: u32) -> u32 {
    let kind = walk.kind(ty);
    if kind == TK_NAMED {
        let name = walk.name(ty);
        let count = walk.count(ty);
        if count == 0 {
            let generic_start = u64_at(in walk.adt_generic_start, adt);
            let generic_count = u64_at(in walk.adt_generic_count, adt);
            // The last generic of that name wins, as a map collect does;
            // only generics with an argument bind.
            let mut found = NO_TY;
            let bound = if generic_count < walk.count(owner) {
                generic_count
            } else {
                walk.count(owner)
            };
            for i in 0..bound {
                if u32_at(in walk.generic_names, wrapping_add(generic_start, i)) == name {
                    found = walk.item(owner, i);
                }
            }
            if found != NO_TY {
                return found;
            }
            return ty;
        }
        let mut items: ChunkSeq[u32] = ChunkSeq::new[u32]();
        for i in 0..count {
            let item = walk.item(ty, i);
            items.push(subst(inout walk, item, adt, owner));
        }
        return walk.ty(TK_NAMED, name, in items);
    }
    if kind == TK_TUPLE {
        let mut items: ChunkSeq[u32] = ChunkSeq::new[u32]();
        for i in 0..walk.count(ty) {
            let item = walk.item(ty, i);
            items.push(subst(inout walk, item, adt, owner));
        }
        return walk.ty(TK_TUPLE, NONE, in items);
    }
    ty
}

// `contains_vector`.
fn contains_vector(in ast: Ast, inout walk: I, ty: u32, depth: u64) -> bool {
    if depth > 32 {
        return false;
    }
    if shape_of(in ast, in walk, ty) != 0 {
        return true;
    }
    let kind = walk.kind(ty);
    if kind == TK_TUPLE {
        for i in 0..walk.count(ty) {
            let item = walk.item(ty, i);
            if contains_vector(in ast, inout walk, item, wrapping_add(depth, 1)) {
                return true;
            }
        }
        return false;
    }
    if kind == TK_NAMED {
        let found = walk.adt(walk.name(ty));
        if found == 0 {
            return false;
        }
        let adt = wrapping_sub(found, 1);
        let field_start = u64_at(in walk.adt_field_start, adt);
        let field_count = u64_at(in walk.adt_field_count, adt);
        for i in 0..field_count {
            let field_ty = u32_at(in walk.field_tys, wrapping_add(field_start, i));
            let substituted = subst(inout walk, field_ty, adt, ty);
            if contains_vector(in ast, inout walk, substituted, wrapping_add(depth, 1)) {
                return true;
            }
        }
    }
    false
}

// ------------------------------------------------------------------ report

fn diag_head(inout walk: I, in code: Str, start: u32, end: u32) {
    walk.out.extend(in code.as_bytes());
    walk.out.push(32);
    push_decimal(inout walk.out, w64(start));
    walk.out.extend(in "..".as_bytes());
    push_decimal(inout walk.out, w64(end));
    walk.out.push(32);
}

// `IsaWalker::require`; `what` is the message's subject.
fn require(
    inout walk: I,
    needed: u8,
    in available: ChunkSeq[u8],
    in what: ChunkSeq[u8],
    start: u32,
    end: u32
) {
    for i in 0..available.len() {
        if profile_le(needed, u8_at(in available, i)) {
            return;
        }
    }
    diag_head(inout walk, in "E1403", start, end);
    walk.out.extend(in what.as_slice());
    walk.out.extend(in " requires 'eff [Isa[".as_bytes());
    profile_name(needed, inout walk.out);
    walk.out.extend(in "]]'".as_bytes());
    if available.len() > 0 {
        walk.out.extend(in "; only ".as_bytes());
        for i in 0..available.len() {
            if i > 0 {
                walk.out.extend(in ", ".as_bytes());
            }
            walk.out.extend(in "Isa[".as_bytes());
            profile_name(u8_at(in available, i), inout walk.out);
            walk.out.push(93);
        }
        walk.out.extend(in " is available here".as_bytes());
    }
    walk.out.extend(in " | add Isa[".as_bytes());
    profile_name(needed, inout walk.out);
    walk.out.extend(
        in "] to the function's effect row, or call it from the checked dispatch `if Isa::supported["
            .as_bytes()
    );
    profile_name(needed, inout walk.out);
    walk.out.extend(in "]() { ... }`\n".as_bytes());
}

// `IsaWalker::vector_width`.
fn vector_width(
    inout walk: I,
    bits: u64,
    in available: ChunkSeq[u8],
    in name: ChunkSeq[u8],
    start: u32,
    end: u32
) {
    for i in 0..available.len() {
        if fixed_bits(u8_at(in available, i)) >= bits {
            return;
        }
    }
    let mut what: ChunkSeq[u8] = ChunkSeq::new[u8]();
    what.push(39);
    what.extend(in name.as_slice());
    what.extend(in "' on ".as_bytes());
    push_decimal(inout what, bits);
    what.extend(in "-bit vectors".as_bytes());
    require(inout walk, required_profile(bits), in available, in what, start, end);
}

fn require_profiles(
    inout walk: I,
    in profiles: ChunkSeq[u8],
    in available: ChunkSeq[u8],
    in what: ChunkSeq[u8],
    start: u32,
    end: u32
) {
    for i in 0..profiles.len() {
        require(inout walk, u8_at(in profiles, i), in available, in what, start, end);
    }
}

fn fn_profiles(in walk: I, func_index: u64, inout out: ChunkSeq[u8]) {
    let profile_start = u64_at(in walk.fn_profile_start, func_index);
    for i in 0..u64_at(in walk.fn_profile_count, func_index) {
        out.push(u8_at(in walk.profiles, wrapping_add(profile_start, i)));
    }
}

fn calling(in ast: Ast, name: u32) -> ChunkSeq[u8] {
    let mut what: ChunkSeq[u8] = ChunkSeq::new[u8]();
    what.extend(in "calling '".as_bytes());
    sym_text(in ast, name, inout what);
    what.push(39);
    what
}

// `load_tile_vec`'s explicit profile and result width.
fn load_tile_vec(
    in ast: Ast,
    inout walk: I,
    profile: u8,
    call: ExprNode,
    in available: ChunkSeq[u8]
) {
    if profile != 0 {
        let mut what: ChunkSeq[u8] = ChunkSeq::new[u8]();
        what.extend(in "calling 'load_tile_vec[".as_bytes());
        profile_name(profile, inout what);
        what.extend(in ", ...]'".as_bytes());
        require(inout walk, profile, in available, in what, call.start, call.end);
    }
    let bits = shape_of(in ast, in walk, walk.recorded(call.start, call.end));
    if bits != 0 {
        let mut name: ChunkSeq[u8] = ChunkSeq::new[u8]();
        name.extend(in "load_tile_vec".as_bytes());
        vector_width(inout walk, bits, in available, in name, call.start, call.end);
    }
}

// The profile a type argument names when it is a Named type with no
// arguments.
fn type_arg_profile(in ast: Ast, types: u32, i: u64) -> u8 {
    let arg_node = type_at(in ast, list_at(in ast, types, i));
    if arg_node.kind != AT_NAMED || list_len(in ast, arg_node.b) != 0 {
        return 0;
    }
    profile_of_sym(in ast, arg_node.a)
}

fn is_comparison(in ast: Ast, op: u32) -> bool {
    sym_is(in ast, op, in "==")
        || sym_is(in ast, op, in "!=")
        || sym_is(in ast, op, in "<")
        || sym_is(in ast, op, in "<=")
        || sym_is(in ast, op, in ">")
        || sym_is(in ast, op, in ">=")
}

// `IsaWalker::expr`.
fn expr(inout ast: Ast, inout walk: I, id: u32, in available: ChunkSeq[u8]) {
    if id == NONE {
        return;
    }
    let node = expr_at(in ast, id);
    let kind = node.kind;
    if kind == E_IF {
        expr(inout ast, inout walk, node.a, in available);
        let mut granted = copy_u8(in available);
        let cond = expr_at(in ast, node.a);
        if cond.kind == E_CALL {
            let callee = expr_at(in ast, cond.a);
            if callee.kind == E_NAME
                && intrinsic(in ast, callee.a) == I_ISA
                && list_len(in ast, cond.b) == 1
            {
                let arg_node = type_at(in ast, list_at(in ast, cond.b, 0));
                if arg_node.kind == AT_NAMED {
                    let profile = profile_of_sym(in ast, arg_node.a);
                    if profile != 0 {
                        granted.push(profile);
                    }
                }
            }
        }
        expr(inout ast, inout walk, node.b, in granted);
        expr(inout ast, inout walk, node.c, in available);
    } else if kind == E_CALL {
        let callee = expr_at(in ast, node.a);
        if callee.kind == E_NAME {
            let callee_name = callee.a;
            let intrinsic_class = intrinsic(in ast, callee_name);
            let func = walk.function(callee_name);
            if intrinsic_class != 0 && intrinsic_class != I_UNKNOWN && func == 0 {
                if intrinsic_class != I_ISA {
                    let result = walk.recorded(node.start, node.end);
                    let bits = op_shape(
                        in ast,
                        inout walk,
                        intrinsic_class,
                        node.b,
                        node.c,
                        result
                    );
                    if bits != 0 {
                        let mut name: ChunkSeq[u8] = ChunkSeq::new[u8]();
                        sym_text(in ast, callee_name, inout name);
                        vector_width(inout walk, bits, in available, in name, node.start, node.end);
                        let result_bits = shape_of(in ast, in walk, result);
                        if result_bits != 0 && result_bits > bits {
                            vector_width(
                                inout walk,
                                result_bits,
                                in available,
                                in name,
                                node.start,
                                node.end
                            );
                        }
                    }
                }
            } else if callee_name == walk.load_tile_vec_path {
                let type_arg_count = list_len(in ast, node.b);
                let profile = if type_arg_count == 3 {
                    type_arg_profile(in ast, node.b, 1)
                } else if type_arg_count == 2 {
                    type_arg_profile(in ast, node.b, 0)
                } else {
                    0
                };
                load_tile_vec(in ast, inout walk, profile, node, in available);
            } else if func != 0 {
                let mut profiles: ChunkSeq[u8] = ChunkSeq::new[u8]();
                fn_profiles(in walk, wrapping_sub(func, 1), inout profiles);
                let what = calling(in ast, callee_name);
                require_profiles(
                    inout walk,
                    in profiles,
                    in available,
                    in what,
                    node.start,
                    node.end
                );
            } else {
                let callee_ty = walk.recorded(callee.start, callee.end);
                let mut profiles: ChunkSeq[u8] = ChunkSeq::new[u8]();
                if fn_type_profiles(in ast, in walk, callee_ty, inout profiles) {
                    let what = calling(in ast, callee_name);
                    require_profiles(
                        inout walk,
                        in profiles,
                        in available,
                        in what,
                        node.start,
                        node.end
                    );
                }
            }
        } else {
            if callee.kind == E_FIELD {
                let base_ty = walk.recorded(
                    expr_at(in ast, callee.a).start,
                    expr_at(in ast, callee.a).end
                );
                if callee.b == walk.load_tile_vec_name && is_tiled_seq(in walk, base_ty) {
                    let profile = if list_len(in ast, node.b) == 2 {
                        type_arg_profile(in ast, node.b, 0)
                    } else {
                        0
                    };
                    load_tile_vec(in ast, inout walk, profile, node, in available);
                } else {
                    let mut name: ChunkSeq[u8] = ChunkSeq::new[u8]();
                    if walk.kind(base_ty) == TK_NAMED {
                        sym_text(in ast, walk.name(base_ty), inout name);
                    }
                    name.extend(in "::".as_bytes());
                    sym_text(in ast, callee.b, inout name);
                    let method_sym = intern_seq(inout ast, in name);
                    let func = walk.function(method_sym);
                    if func != 0 {
                        let mut profiles: ChunkSeq[u8] = ChunkSeq::new[u8]();
                        fn_profiles(in walk, wrapping_sub(func, 1), inout profiles);
                        let what = calling(in ast, method_sym);
                        require_profiles(
                            inout walk,
                            in profiles,
                            in available,
                            in what,
                            node.start,
                            node.end
                        );
                    }
                }
            }
            let callee_ty = walk.recorded(callee.start, callee.end);
            let mut profiles: ChunkSeq[u8] = ChunkSeq::new[u8]();
            if fn_type_profiles(in ast, in walk, callee_ty, inout profiles) {
                let mut what: ChunkSeq[u8] = ChunkSeq::new[u8]();
                what.extend(in "calling this function value".as_bytes());
                require_profiles(
                    inout walk,
                    in profiles,
                    in available,
                    in what,
                    node.start,
                    node.end
                );
            }
            expr(inout ast, inout walk, node.a, in available);
        }
        for i in 0..list_len(in ast, node.c) {
            let arg = arg_at(in ast, list_at(in ast, node.c, i)).expr;
            expr(inout ast, inout walk, arg, in available);
        }
    } else if kind == E_LOOP {
        expr(inout ast, inout walk, node.a, in available);
    } else if kind == E_FOR {
        expr(inout ast, inout walk, node.b, in available);
        expr(inout ast, inout walk, node.c, in available);
    } else if kind == E_RANGE {
        expr(inout ast, inout walk, node.a, in available);
        expr(inout ast, inout walk, node.b, in available);
    } else if kind == E_BREAK || kind == E_RETURN {
        expr(inout ast, inout walk, node.a, in available);
    } else if kind == E_CLOSURE {
        // A closure may run outside this scope: only its own row grants
        // it a profile.
        let mut own: ChunkSeq[u8] = ChunkSeq::new[u8]();
        ast_row_profiles(in ast, node.d, inout own);
        expr(inout ast, inout walk, node.e, in own);
    } else if kind == E_HANDLE {
        if node.b != NONE {
            expr(inout ast, inout walk, node.c, in available);
        }
        expr(inout ast, inout walk, node.d, in available);
        for i in 0..list_len(in ast, node.e) {
            let body = clause_at(in ast, list_at(in ast, node.e, i)).body;
            expr(inout ast, inout walk, body, in available);
        }
    } else if kind == E_TUPLE {
        for i in 0..list_len(in ast, node.a) {
            let child = list_at(in ast, node.a, i);
            expr(inout ast, inout walk, child, in available);
        }
    } else if kind == E_STRUCT {
        for i in 0..(list_len(in ast, node.b) >> 1) {
            let child = list_at(in ast, node.b, wrapping_add(i << 1, 1));
            expr(inout ast, inout walk, child, in available);
        }
    } else if kind == E_BLOCK {
        for i in 0..list_len(in ast, node.a) {
            let stmt_value = stmt_at(in ast, list_at(in ast, node.a, i)).value;
            expr(inout ast, inout walk, stmt_value, in available);
        }
        expr(inout ast, inout walk, node.b, in available);
    } else if kind == E_FIELD || kind == E_TRY {
        expr(inout ast, inout walk, node.a, in available);
    } else if kind == E_UNARY {
        expr(inout ast, inout walk, node.b, in available);
    } else if kind == E_BINARY
        && is_comparison(in ast, node.a)
        && contains_vector(in ast, inout walk, expr_type(in ast, in walk, node.b), 0)
    {
        // Aggregate equality would compare lane bits, not values (-0.0
        // and NaN): lanes are compared with Vec::eq and friends.
        diag_head(inout walk, in "E1402", node.start, node.end);
        walk.out.push(39);
        sym_text(in ast, node.a, inout walk.out);
        walk.out.extend(
            in "' is not defined on vector and mask values | compare lanes with Vec::eq, Vec::ne, Vec::lt, ... and reduce the mask with Mask::all or Mask::any\n"
                .as_bytes()
        );
    } else if kind == E_INDEX {
        expr(inout ast, inout walk, node.a, in available);
        expr(inout ast, inout walk, node.b, in available);
    } else if kind == E_BINARY || kind == E_ASSIGN {
        expr(inout ast, inout walk, node.b, in available);
        expr(inout ast, inout walk, node.c, in available);
    } else if kind == E_MATCH {
        expr(inout ast, inout walk, node.a, in available);
        for i in 0..(list_len(in ast, node.b) >> 1) {
            let child = list_at(in ast, node.b, wrapping_add(i << 1, 1));
            expr(inout ast, inout walk, child, in available);
        }
    }
}

fn copy_u8(in seq: ChunkSeq[u8]) -> ChunkSeq[u8] {
    let mut copy: ChunkSeq[u8] = ChunkSeq::new[u8]();
    copy.extend(in seq.as_slice());
    copy
}

// The body expression whose span is `start..end`, among the tree's
// functions; NONE when none.
fn body_at(in ast: Ast, start: u64, end: u64) -> u32 {
    for i in 0..ast.fns.len() {
        let func = fn_at(in ast, wrapping_u32(i));
        if func.body == NONE {
            continue;
        }
        let body = expr_at(in ast, func.body);
        if w64(body.start) == start && w64(body.end) == end {
            return func.body;
        }
    }
    NONE
}

// `vector::check_world` on the input's world and `source`'s tree: one
// line per diagnostic (`code start..end message | help`), or `missing
// <function>` for a function whose body the tree lacks.
pub fn isa_text(in input: Str, in source: Str) -> ChunkSeq[u8] {
    let bytes = input.as_bytes();
    let lowered = lower_source(in source);
    let mut ast = lowered.ast;
    let mut walk = i_new(inout ast);
    let mut reader = Rd { pos: 0 };
    // ADTs.
    let adt_count = reader.word(in bytes);
    let mut spans: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for i in 0..adt_count {
        let name = reader.text(inout ast, in bytes);
        spans.push(reader.word(in bytes));
        spans.push(reader.word(in bytes));
        walk.adt_name.push(name);
        walk.adt_generic_start.push(walk.generic_names.len());
        let generic_count = reader.word(in bytes);
        walk.adt_generic_count.push(generic_count);
        for j in 0..generic_count {
            let generic = reader.text(inout ast, in bytes);
            walk.generic_names.push(generic);
        }
        let field_count = reader.word(in bytes);
        let mut field_tys: ChunkSeq[u32] = ChunkSeq::new[u32]();
        for j in 0..field_count {
            field_tys.push(read_ty(inout reader, in bytes, inout ast, inout walk));
        }
        walk.adt_field_start.push(walk.field_tys.len());
        walk.adt_field_count.push(field_count);
        for j in 0..field_count {
            walk.field_tys.push(u32_at(in field_tys, j));
        }
    }
    // Functions.
    let fn_count = reader.word(in bytes);
    let mut bodies: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for i in 0..fn_count {
        let name = reader.text(inout ast, in bytes);
        walk.fn_name.push(name);
        walk.fn_profile_start.push(walk.profiles.len());
        let effect_count = reader.word(in bytes);
        let mut profile_count: u64 = 0;
        for j in 0..effect_count {
            let effect_name = reader.text(inout ast, in bytes);
            let arg_count = reader.word(in bytes);
            let mut only_arg = NO_TY;
            for q in 0..arg_count {
                let arg_ty = read_ty(inout reader, in bytes, inout ast, inout walk);
                if arg_count == 1 {
                    only_arg = arg_ty;
                }
            }
            let profile = effect_profile(in ast, in walk, effect_name, only_arg);
            if profile != 0 {
                walk.profiles.push(profile);
                profile_count = wrapping_add(profile_count, 1);
            }
        }
        walk.fn_profile_count.push(profile_count);
        let has_body = reader.word(in bytes);
        let start = reader.word(in bytes);
        let end = reader.word(in bytes);
        bodies.push(has_body);
        bodies.push(start);
        bodies.push(end);
    }
    // The checker's expression types, sorted by span.
    let type_count = reader.word(in bytes);
    for i in 0..type_count {
        let start = reader.word(in bytes);
        let end = reader.word(in bytes);
        let expr_ty = read_ty(inout reader, in bytes, inout ast, inout walk);
        walk.recorded_key.push((start << 32) | end);
        walk.recorded_ty.push(expr_ty);
    }
    for i in 0..adt_count {
        let adt_name = u32_at(in walk.adt_name, i);
        if (adt_name == walk.vec_name || adt_name == walk.mask_name)
            && u64_at(in walk.adt_generic_count, i) == 2
        {
            let start = wrapping_u32(u64_at(in spans, wrapping_mul(i, 2)));
            let end = wrapping_u32(u64_at(in spans, wrapping_add(wrapping_mul(i, 2), 1)));
            diag_head(inout walk, in "E1401", start, end);
            walk.out.push(39);
            sym_text(in ast, adt_name, inout walk.out);
            walk.out.extend(in "' with two parameters is reserved for vector types\n".as_bytes());
        }
    }
    for i in 0..fn_count {
        if u64_at(in bodies, wrapping_mul(i, 3)) == 0 {
            continue;
        }
        let start = u64_at(in bodies, wrapping_add(wrapping_mul(i, 3), 1));
        let end = u64_at(in bodies, wrapping_add(wrapping_mul(i, 3), 2));
        let body = body_at(in ast, start, end);
        if body == NONE {
            walk.out.extend(in "missing ".as_bytes());
            sym_text(in ast, u32_at(in walk.fn_name, i), inout walk.out);
            walk.out.push(10);
            continue;
        }
        let mut available: ChunkSeq[u8] = ChunkSeq::new[u8]();
        fn_profiles(in walk, i, inout available);
        expr(inout ast, inout walk, body, in available);
    }
    walk.out
}
