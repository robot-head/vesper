// The type rules of src/vector.rs: lane types (`Elem`), shapes, `Vec` and
// `Mask` spellings, `shape_of`, `type_error`, `layout_words`, ISA profiles
// and the `Isa[P]` row entry rule (E1404). The intrinsic rules of
// src/vector/check.rs and the ISA walker of `vector::check_world` walk the
// AST: a later PR of #1181.

use @vesper/check-data::util::{add, push_decimal, u32_at, w};
use @vesper/check-data::names::{Names};
use @vesper/check-data::types::{EffNode, Types, display, TyKind};
use @vesper/check-data::world::{Known};
use @vesper/check-data::diag::{Diags};

const NONE32: u32 = 4294967295;

pub const E_U8: u8 = 1;
pub const E_U32: u8 = 2;
pub const E_U64: u8 = 3;
pub const E_I64: u8 = 4;
pub const E_F32: u8 = 5;
pub const E_F64: u8 = 6;

// Profiles: 1 Baseline128, 2 Avx2, 3 Avx512, 4 Sve2, 5 Rvv1 (0 = none).
pub struct VecNames {
    isa_name: u32,
    profiles: ChunkSeq[u32],
}

pub fn vec_names_new(inout names: Names) -> VecNames {
    let mut profiles: ChunkSeq[u32] = ChunkSeq::new[u32]();
    profiles.push(names.intern(in "Baseline128".as_bytes()));
    profiles.push(names.intern(in "Avx2".as_bytes()));
    profiles.push(names.intern(in "Avx512".as_bytes()));
    profiles.push(names.intern(in "Sve2".as_bytes()));
    profiles.push(names.intern(in "Rvv1".as_bytes()));
    VecNames { isa_name: names.intern(in "Isa".as_bytes()), profiles: profiles }
}

// `Elem::from_name`, or 0.
pub fn elem_of_name(known: Known, sym: u32) -> u8 {
    if sym == known.u8_ {
        E_U8
    } else if sym == known.u32_ {
        E_U32
    } else if sym == known.u64_ {
        E_U64
    } else if sym == known.i64_ {
        E_I64
    } else if sym == known.f32_ {
        E_F32
    } else if sym == known.f64_ {
        E_F64
    } else {
        0
    }
}

// `Elem::from_type`, or 0.
pub fn elem_of(in types: Types, known: Known, ty: u32) -> u8 {
    let node = types.node(ty);
    if node.kind == TyKind::Named && node.n == 0 {
        elem_of_name(known, node.name)
    } else {
        0
    }
}

pub fn elem_bits(elem: u8) -> u64 {
    if elem == E_U8 {
        8
    } else if elem == E_U32 || elem == E_F32 {
        32
    } else {
        64
    }
}

pub fn elem_name(elem: u8, inout out: ChunkSeq[u8]) {
    match elem {
        1 => out.extend(in "u8".as_bytes()),
        2 => out.extend(in "u32".as_bytes()),
        3 => out.extend(in "u64".as_bytes()),
        4 => out.extend(in "i64".as_bytes()),
        5 => out.extend(in "f32".as_bytes()),
        _ => out.extend(in "f64".as_bytes()),
    }
}

// A shape: lane type and count (`Shape`); `elem` 0 means none.
pub copy struct Shape {
    kind: u8,
    elem: u8,
    lanes: u64,
}

pub fn no_shape() -> Shape {
    Shape { kind: 0, elem: 0, lanes: 0 }
}

// `Shape::new`: a shape of 128, 256 or 512 bits, else none.
pub fn shape_new(elem: u8, lanes: u64) -> Shape {
    let bits = wrapping_mul(elem_bits(elem), lanes);
    if elem != 0 && (bits == 128 || bits == 256 || bits == 512) {
        Shape { kind: 0, elem: elem, lanes: lanes }
    } else {
        no_shape()
    }
}

pub fn shape_bits(shape: Shape) -> u64 {
    wrapping_mul(elem_bits(shape.elem), shape.lanes)
}

// `Shape::lanes_per_chunk`: lanes in one 128-bit chunk.
pub fn lanes_per_chunk(shape: Shape) -> u64 {
    let bits = elem_bits(shape.elem);
    if bits == 8 {
        16
    } else if bits == 32 {
        4
    } else {
        2
    }
}

// `Shape::required_profile`.
pub fn required_profile(shape: Shape) -> u8 {
    let bits = shape_bits(shape);
    if bits == 128 {
        1
    } else if bits == 256 {
        2
    } else {
        3
    }
}

// `is_lane_count`: a non-empty string of ASCII digits.
fn is_lane_count(in names: Names, sym: u32) -> bool {
    let len = names.size(sym);
    if len == 0 {
        return false;
    }
    for i in 0..len {
        let byte = names.byte(sym, i);
        if byte < 48 || byte > 57 {
            return false;
        }
    }
    true
}

// `count.parse::<u16>()` of a lane count: the value, or 65536 on overflow.
fn lane_value(in names: Names, sym: u32) -> u64 {
    let mut value: u64 = 0;
    for i in 0..names.size(sym) {
        value = wrapping_add(
            wrapping_mul(value, 10),
            widen_u64(wrapping_sub(names.byte(sym, i), 48))
        );
        if value > 65535 {
            return 65536;
        }
    }
    value
}

// 1 for `Vec`, 2 for `Mask`, else 0.
fn kind_of(known: Known, sym: u32) -> u8 {
    if sym == known.vec {
        1
    } else if sym == known.mask {
        2
    } else {
        0
    }
}

// `is_vector_spelling`.
pub fn is_vector_spelling(in types: Types, in names: Names, known: Known, ty: u32) -> bool {
    let node = types.node(ty);
    if node.kind != TyKind::Named || kind_of(known, node.name) == 0 || node.n != 2 {
        return false;
    }
    let count_node = types.node(types.arg(ty, 1));
    count_node.kind == TyKind::Named
        && count_node.n == 0
        && is_lane_count(in names, count_node.name)
}

// `shape_of`: the kind (1 Vec, 2 Mask) and shape, or `elem` 0.
pub fn shape_of(in types: Types, in names: Names, known: Known, ty: u32) -> Shape {
    let node = types.node(ty);
    if node.kind != TyKind::Named {
        return no_shape();
    }
    let kind = kind_of(known, node.name);
    if kind == 0 || node.n != 2 {
        return no_shape();
    }
    let count_node = types.node(types.arg(ty, 1));
    if count_node.kind != TyKind::Named
        || count_node.n != 0
        || !is_lane_count(in names, count_node.name) {
        return no_shape();
    }
    let lanes = lane_value(in names, count_node.name);
    if lanes > 65535 {
        return no_shape();
    }
    let shape = shape_new(elem_of(in types, known, types.arg(ty, 0)), lanes);
    Shape { kind: kind, elem: shape.elem, lanes: shape.lanes }
}

// `type_error`: appends the message and returns true, or returns false.
pub fn type_error(
    in types: Types,
    in names: Names,
    known: Known,
    ty: u32,
    inout out: ChunkSeq[u8]
) -> bool {
    if !is_vector_spelling(in types, in names, known, ty)
        || shape_of(in types, in names, known, ty).elem != 0 {
        return false;
    }
    let first = types.arg(ty, 0);
    if elem_of(in types, known, first) == 0 {
        names.write(types.name(ty), inout out);
        out.extend(in " lanes must be u8, u32, u64, i64, f32 or f64, found ".as_bytes());
        display(in types, in names, first, inout out);
    } else {
        display(in types, in names, ty, inout out);
        out.extend(in " is not a 128-, 256- or 512-bit vector shape".as_bytes());
    }
    true
}

// `layout_words`: words of a valid vector or mask, or NONE32.
pub fn layout_words(in types: Types, in names: Names, known: Known, ty: u32) -> u32 {
    let shape = shape_of(in types, in names, known, ty);
    if shape.elem == 0 {
        NONE32
    } else {
        wrapping_u32(shape_bits(shape) / 64)
    }
}

pub fn profile_name(profile: u8, inout out: ChunkSeq[u8]) {
    match profile {
        1 => out.extend(in "Baseline128".as_bytes()),
        2 => out.extend(in "Avx2".as_bytes()),
        3 => out.extend(in "Avx512".as_bytes()),
        4 => out.extend(in "Sve2".as_bytes()),
        _ => out.extend(in "Rvv1".as_bytes()),
    }
}

// `Profile::from_name`, or 0.
pub fn profile_of_name(in vec_names: VecNames, sym: u32) -> u8 {
    for i in 0..vec_names.profiles.len() {
        if u32_at(in vec_names.profiles, i) == sym {
            return wrapping_u8(wrapping_add(i, 1));
        }
    }
    0
}

// `profile_of(effect)`, or 0.
pub fn profile_of(in types: Types, in vec_names: VecNames, effect: EffNode) -> u8 {
    if effect.name != vec_names.isa_name || effect.n != 1 {
        return 0;
    }
    let arg_node = types.node(u32_at(in types.items, w(effect.a)));
    if arg_node.kind != TyKind::Named || arg_node.n != 0 {
        return 0;
    }
    profile_of_name(in vec_names, arg_node.name)
}

// `isa_row_entry(effect, span)`: false when the entry is a valid profile.
pub fn isa_row_entry(
    in types: Types,
    in names: Names,
    in vec_names: VecNames,
    effect: EffNode,
    start: u64,
    stop: u64,
    inout diags: Diags
) -> bool {
    if profile_of(in types, in vec_names, effect) != 0 {
        return false;
    }
    let code_start = diags.open("E1404");
    let msg_start = diags.text.len();
    diags.text.extend(in "'Isa' takes one ISA profile argument, found [".as_bytes());
    for j in 0..w(effect.n) {
        if j > 0 {
            diags.text.extend(in ", ".as_bytes());
        }
        display(in types, in names, u32_at(in types.items, add(w(effect.a), j)), inout diags.text);
    }
    diags.text.push(93);
    diags.close(
        code_start,
        msg_start,
        "use Isa[Baseline128], Isa[Avx2], Isa[Avx512], Isa[Sve2] or Isa[Rvv1]",
        start,
        stop
    );
    true
}

// `Display for Shape`: `[elem, lanes]`.
pub fn shape_display(shape: Shape, inout out: ChunkSeq[u8]) {
    out.push(91);
    elem_name(shape.elem, inout out);
    out.extend(in ", ".as_bytes());
    push_decimal(inout out, shape.lanes);
    out.push(93);
}
