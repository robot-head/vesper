// `Diagnostic` (code, message, span, related labels, help) as rows of one
// text buffer: every text field is a range of `text`.

use self::util::{fold, n32, u8_at, w, add};

pub copy struct DiagRow {
    code_a: u64,
    msg_a: u64,
    // end of the message (related label texts follow it)
    msg_b: u64,
    help_a: u64,
    end: u64,
    start: u64,
    stop: u64,
    // related labels: rel[ra..ra+rn]
    ra: u32,
    rn: u32,
}

pub copy struct RelRow {
    a: u64,
    b: u64,
    start: u64,
    stop: u64,
}

pub struct Diags {
    text: ChunkSeq[u8],
    rows: ChunkSeq[DiagRow],
    rel: ChunkSeq[RelRow],
}

pub fn diags_new() -> Diags {
    Diags {
        text: ChunkSeq::new[u8](),
        rows: ChunkSeq::new[DiagRow](),
        rel: ChunkSeq::new[RelRow]()
    }
}

impl Diags {
    pub fn len(in self) -> u64 {
        self.rows.len()
    }

    // Starts a diagnostic: the code is written; the caller then writes the
    // message into `text` and calls `help` (or `close`).
    pub fn open(inout self, in code: Str) -> u64 {
        let code_start = self.text.len();
        self.text.extend(in code.as_bytes());
        code_start
    }

    pub fn close(inout self, code_start: u64, msg_start: u64, in help: Str, start: u64, stop: u64) {
        let help_start = self.text.len();
        self.text.extend(in help.as_bytes());
        self.rows.push(DiagRow {
            code_a: code_start,
            msg_a: msg_start,
            msg_b: help_start,
            help_a: help_start,
            end: self.text.len(),
            start: start,
            stop: stop,
            ra: n32(self.rel.len()),
            rn: 0
        });
    }

    pub fn row(in self, i: u64) -> DiagRow {
        match self.rows.try_get(i) {
            Option::Some(row) => row,
            Option::None => DiagRow {
                code_a: 0,
                msg_a: 0,
                msg_b: 0,
                help_a: 0,
                end: 0,
                start: 0,
                stop: 0,
                ra: 0,
                rn: 0
            },
        }
    }

    pub fn clear(inout self) {
        self.text.clear();
        self.rows.clear();
        self.rel.clear();
    }

    pub fn fold_range(in self, seed: u64, start: u64, end: u64) -> u64 {
        let mut hash = seed;
        for i in start..end {
            hash = fold(hash, widen_u64(u8_at(in self.text, i)));
        }
        fold(hash, 255)
    }

    pub fn digest_row(in self, seed: u64, i: u64) -> u64 {
        let row = self.row(i);
        let mut hash = self.fold_range(seed, row.code_a, row.msg_a);
        hash = self.fold_range(hash, row.msg_a, row.msg_b);
        hash = fold(fold(hash, row.start), row.stop);
        hash = fold(hash, w(row.rn));
        for j in 0..w(row.rn) {
            let label = match self.rel.try_get(add(w(row.ra), j)) {
                Option::Some(label) => label,
                Option::None => RelRow { a: 0, b: 0, start: 0, stop: 0 },
            };
            hash = fold(fold(hash, label.start), label.stop);
            hash = self.fold_range(hash, label.a, label.b);
        }
        self.fold_range(hash, row.help_a, row.end)
    }

    // The census digest of the diagnostics from row `from` on.
    pub fn digest(in self, seed: u64, from: u64) -> u64 {
        let mut hash = fold(seed, wrapping_sub(self.rows.len(), from));
        for i in from..self.rows.len() {
            let row = self.row(i);
            hash = self.fold_range(hash, row.code_a, row.msg_a);
            hash = self.fold_range(hash, row.msg_a, row.msg_b);
            hash = fold(fold(hash, row.start), row.stop);
            hash = fold(hash, w(row.rn));
            for j in 0..w(row.rn) {
                let label = match self.rel.try_get(add(w(row.ra), j)) {
                    Option::Some(label) => label,
                    Option::None => RelRow { a: 0, b: 0, start: 0, stop: 0 },
                };
                hash = fold(fold(hash, label.start), label.stop);
                hash = self.fold_range(hash, label.a, label.b);
            }
            hash = self.fold_range(hash, row.help_a, row.end);
        }
        hash
    }
}
