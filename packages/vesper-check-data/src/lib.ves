// @vesper/check-data: the checker's data in Vesper (self-hosting wave SH2
// lane 4, #1176). Every SH2 checker port builds on these tables:
//
// - names.ves: interned names (`Names`); symbol 0 is the empty name.
// - types.ves: `ast::Type` and `Effects` as a hash-consed arena (`Types`);
//   a type is a `u32` id and equal types have equal ids. `Display`,
//   `Debug`, `substitute` and `default_type` match vesper-core.
// - world.ves: the checker's `World` as flat tables with sorted rows (ADTs,
//   generics, variants, fields, effect declarations, expression types,
//   partial and overflowing operations) and its lookups (`constructor`,
//   `mode_of`, `field_step`, `vector_words`, `effectful_row`).
// - diag.ves: diagnostics as rows over one text buffer (`Diags`).
// - input.ves: the decoder of the harness input (`read_ctx`).
//
// The census (docs/parallel-results/self-host-census.md) measured this
// design at 0.34x to 0.87x of Rust's time. The package README documents
// the differential harness (tests/common/check_harness.rs) for lanes 5-14.
// The entries below are the harness's own differential tasks
// (tests/self_host_check_data.rs).

use self::util::{n32, put_text_words, u32_at, u8_at, w};
use self::names::{Names};
use self::types::{TyKind, Types, Vars, debug_type, default_type, display, substitute, vars_new};
use self::world::{
    Adt, Variant, bounds_new, constructor, effectful_row, field_step, mode_of, vector_words
};
use self::input::{Ctx, Reader, read_ctx};

const NONE32: u32 = 4294967295;

fn put(inout out: ChunkSeq[u8], in text: Str) {
    out.extend(in text.as_bytes());
}

fn put_u64(inout out: ChunkSeq[u8], value: u64) {
    if value >= 10 {
        put_u64(inout out, value / 10);
    }
    out.push(wrapping_u8(wrapping_add(value % 10, 48)));
}

// `text` packed little-endian eight bytes per word after one header word,
// its byte length: how an entry hands text back to the harness.
pub fn pack_text(in text: ChunkSeq[u8]) -> ChunkSeq[u64] {
    let n = text.len();
    let mut out = ChunkSeq::with_capacity[u64](wrapping_add(n >> 3, 2));
    put_text_words(inout out, in text[0..n]);
    out
}

fn line_type(inout out: ChunkSeq[u8], in ctx: Ctx, tag: u8, ty: u32) {
    out.push(tag);
    out.push(32);
    display(in ctx.types, in ctx.names, ty, inout out);
    out.push(10);
}

fn line_debug(inout out: ChunkSeq[u8], in ctx: Ctx, ty: u32) {
    put(inout out, "G ");
    debug_type(in ctx.types, in ctx.names, ty, inout out);
    out.push(10);
}

// Task "types": for every listed type its `Display` (D), `Debug` (G) and
// `default_type` (F); then every listed substitution's result (S, G).
// Task words: n, n type indices; m, then m cases of (type, k, k pairs of
// (name index, type index)).
pub fn check_data_types(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mut reader = Reader { pos: 0 };
    let mut ctx = read_ctx(inout reader, in bytes);
    let mut out = ChunkSeq::new[u8]();
    let n = reader.word(in bytes);
    for i in 0..n {
        let ty = u32_at(in ctx.tmap, reader.word(in bytes));
        line_type(inout out, in ctx, 68, ty);
        line_debug(inout out, in ctx, ty);
        let default_ty = default_type(inout ctx.types, ty);
        line_type(inout out, in ctx, 70, default_ty);
    }
    let subst_count = reader.word(in bytes);
    for i in 0..subst_count {
        let ty = u32_at(in ctx.tmap, reader.word(in bytes));
        let pair_count = reader.word(in bytes);
        let mut vars = vars_new();
        for j in 0..pair_count {
            let name = u32_at(in ctx.nmap, reader.word(in bytes));
            let bound_ty = u32_at(in ctx.tmap, reader.word(in bytes));
            vars.set(name, bound_ty);
        }
        let substituted = substitute(inout ctx.types, ty, in vars);
        line_type(inout out, in ctx, 83, substituted);
        line_debug(inout out, in ctx, substituted);
    }
    pack_text(in out)
}

// Task "world": the `World` lookups.
// - n cases of (type, k, k field-name indices): `World::mode` with no
//   bounds (M), `vector::layout_words` (V), `World::field(ty, [name])` per
//   name (P: the type or `-`), and for a function or row type whether it
//   is effectful (E).
// - m cases of (type, k, k pairs of (generic name, bound)): `World::mode`
//   under those bounds (B).
// - q constructor queries (qualifier index + 1 or 0, short name index):
//   `World::constructor` (C: ADT and variant names, or `-`).
// - s span probes (start, end): the expression type (T: type or `-`),
//   `partial_ops` and `overflow_ops` membership (O: two digits).
pub fn check_data_world(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mut reader = Reader { pos: 0 };
    let mut ctx = read_ctx(inout reader, in bytes);
    let mut out = ChunkSeq::new[u8]();
    let no_bounds = bounds_new();
    let n = reader.word(in bytes);
    for i in 0..n {
        let ty = u32_at(in ctx.tmap, reader.word(in bytes));
        put(inout out, "M ");
        put_u64(
            inout out,
            widen_u64(mode_of(inout ctx.types, in ctx.names, in ctx.world, ty, in no_bounds))
        );
        put(inout out, "\nV ");
        put_u64(inout out, w(vector_words(in ctx.types, in ctx.names, ctx.world.k, ty)));
        out.push(10);
        let name_count = reader.word(in bytes);
        for j in 0..name_count {
            let name = u32_at(in ctx.nmap, reader.word(in bytes));
            let is_segment = ctx.names.has_prefix(name, in "[".as_bytes());
            let field_ty = field_step(
                inout ctx.types,
                inout ctx.names,
                in ctx.world,
                ty,
                name,
                is_segment
            );
            if field_ty == NONE32 {
                put(inout out, "P -\n");
            } else {
                line_type(inout out, in ctx, 80, field_ty);
            }
        }
        let node = ctx.types.node(ty);
        if node.kind == TyKind::Fn || node.kind == TyKind::Row {
            put(inout out, "E ");
            if effectful_row(in ctx.types, in ctx.world, node.r2) {
                out.push(49);
            } else {
                out.push(48);
            }
            out.push(10);
        }
    }
    let bound_case_count = reader.word(in bytes);
    for i in 0..bound_case_count {
        let ty = u32_at(in ctx.tmap, reader.word(in bytes));
        let bound_count = reader.word(in bytes);
        let mut bounds = bounds_new();
        for j in 0..bound_count {
            let name = u32_at(in ctx.nmap, reader.word(in bytes));
            bounds.set(name, wrapping_u8(reader.word(in bytes)));
        }
        put(inout out, "B ");
        put_u64(
            inout out,
            widen_u64(mode_of(inout ctx.types, in ctx.names, in ctx.world, ty, in bounds))
        );
        out.push(10);
    }
    let query_count = reader.word(in bytes);
    for i in 0..query_count {
        let qual_index = reader.word(in bytes);
        let qual = if qual_index == 0 {
            NONE32
        } else {
            u32_at(in ctx.nmap, wrapping_sub(qual_index, 1))
        };
        let short = u32_at(in ctx.nmap, reader.word(in bytes));
        let found = constructor(in ctx.world, qual, short);
        put(inout out, "C ");
        if found == 18446744073709551615 {
            out.push(45);
        } else {
            let adt = ctx.world.adt(n32(found >> 32));
            let variant = ctx.world.variant(found & 4294967295);
            ctx.names.write(adt.name, inout out);
            put(inout out, "::");
            ctx.names.write(variant.name, inout out);
        }
        out.push(10);
    }
    let probe_count = reader.word(in bytes);
    for i in 0..probe_count {
        let start = reader.word(in bytes);
        let end = reader.word(in bytes);
        let ty = ctx.world.expr_type(start, end);
        if ty == NONE32 {
            put(inout out, "T -\n");
        } else {
            line_type(inout out, in ctx, 84, ty);
        }
        put(inout out, "O ");
        if ctx.world.is_partial(start, end) {
            out.push(49);
        } else {
            out.push(48);
        }
        if ctx.world.may_overflow(start, end) {
            out.push(49);
        } else {
            out.push(48);
        }
        out.push(10);
    }
    pack_text(in out)
}

// Task "decode": the table sizes after decoding, for the harness's own
// round-trip test and as the cheapest entry to time the decoder with.
pub fn check_data_sizes(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mut reader = Reader { pos: 0 };
    let ctx = read_ctx(inout reader, in bytes);
    let mut out = ChunkSeq::new[u64]();
    out.push(ctx.names.len());
    out.push(ctx.types.nodes.len());
    out.push(ctx.types.rows.len());
    out.push(ctx.world.adts.len());
    out.push(ctx.world.variants.len());
    out.push(ctx.world.fields.len());
    out.push(ctx.world.effects.len());
    out.push(ctx.world.expr_types.len());
    out.push(ctx.world.partial_ops.len());
    out.push(ctx.world.overflow_ops.len());
    out
}
