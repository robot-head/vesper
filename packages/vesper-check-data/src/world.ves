// The part of the checker's `World` the sample reads: the ADT table
// (`world.adts`, a BTreeMap by name in Rust, kept here in the same name
// order), `World::constructor`, `World::field` and `World::mode`.

use self::util::{add, copy_seq, inc, fold, inc32, n32, u32_at, u64_at, u8_at, w};
use self::names::{Names};
use self::types::{Types, Vars, substitute, vars_new, TyKind, TyMode};

const NONE32: u32 = 4294967295;

pub copy struct Adt {
    name: u32,
    mode: u8,
    ga: u32,
    gn: u32,
    va: u32,
    vn: u32,
    is_enum: bool,
    // tile width + 1, or 0
    tile: u32,
    span_zero: bool,
}

pub copy struct Generic {
    name: u32,
    bound: u8,
    row: bool,
}

pub copy struct Variant {
    name: u32,
    fa: u32,
    fc: u32,
    named: bool,
}

pub copy struct Field {
    name: u32,
    ty: u32,
    // mode + 1, or 0 when the field inherits its component kind
    modality: u8,
}

// Symbols the rules compare against, interned once.
pub copy struct Known {
    string: u32,
    str_: u32,
    dyn_: u32,
    region_box: u32,
    watermark: u32,
    chunk_seq: u32,
    slice: u32,
    tiled_seq: u32,
    box_: u32,
    vec: u32,
    mask: u32,
    u8_: u32,
    u16_: u32,
    u32_: u32,
    u64_: u32,
    usize_: u32,
    i8_: u32,
    i16_: u32,
    i32_: u32,
    i64_: u32,
    isize_: u32,
    i128_: u32,
    u128_: u32,
    f32_: u32,
    f64_: u32,
    bool_: u32,
    unit: u32,
    never: u32,
    region: u32,
    len: u32,
    cap: u32,
    data: u32,
}

pub fn known_new(inout names: Names) -> Known {
    Known {
        string: names.intern(in "String".as_bytes()),
        str_: names.intern(in "Str".as_bytes()),
        dyn_: names.intern(in "dyn".as_bytes()),
        region_box: names.intern(in "RegionBox".as_bytes()),
        watermark: names.intern(in "Watermark".as_bytes()),
        chunk_seq: names.intern(in "ChunkSeq".as_bytes()),
        slice: names.intern(in "Slice".as_bytes()),
        tiled_seq: names.intern(in "TiledSeq".as_bytes()),
        box_: names.intern(in "Box".as_bytes()),
        vec: names.intern(in "Vec".as_bytes()),
        mask: names.intern(in "Mask".as_bytes()),
        u8_: names.intern(in "u8".as_bytes()),
        u16_: names.intern(in "u16".as_bytes()),
        u32_: names.intern(in "u32".as_bytes()),
        u64_: names.intern(in "u64".as_bytes()),
        usize_: names.intern(in "usize".as_bytes()),
        i8_: names.intern(in "i8".as_bytes()),
        i16_: names.intern(in "i16".as_bytes()),
        i32_: names.intern(in "i32".as_bytes()),
        i64_: names.intern(in "i64".as_bytes()),
        isize_: names.intern(in "isize".as_bytes()),
        i128_: names.intern(in "i128".as_bytes()),
        u128_: names.intern(in "u128".as_bytes()),
        f32_: names.intern(in "f32".as_bytes()),
        f64_: names.intern(in "f64".as_bytes()),
        bool_: names.intern(in "bool".as_bytes()),
        unit: names.intern(in "Unit".as_bytes()),
        never: names.intern(in "Never".as_bytes()),
        region: names.intern(in "Region".as_bytes()),
        len: names.intern(in "len".as_bytes()),
        cap: names.intern(in "cap".as_bytes()),
        data: names.intern(in "data".as_bytes()),
    }
}

impl Known {
    pub fn is_integer(self, sym: u32) -> bool {
        sym == self.u8_
            || sym == self.u16_
            || sym == self.u32_
            || sym == self.u64_
            || sym == self.usize_
            || sym == self.i8_
            || sym == self.i16_
            || sym == self.i32_
            || sym == self.i64_
            || sym == self.isize_
            || sym == self.i128_
            || sym == self.u128_
    }

    // `numeric::is_wide_name`: the two-word integers (#1174), which
    // `is_integer` also includes.
    pub fn is_wide(self, sym: u32) -> bool {
        sym == self.i128_ || sym == self.u128_
    }

    // `numeric::is_scalar_name`.
    pub fn is_scalar(self, sym: u32) -> bool {
        self.is_integer(sym)
            || self.is_wide(sym)
            || sym == self.f32_
            || sym == self.f64_
            || sym == self.bool_
            || sym == self.unit
            || sym == self.never
    }

    // Bits of a vector element (`vector::Elem::from_name`), or 0.
    pub fn elem_bits(self, sym: u32) -> u32 {
        if sym == self.u8_ {
            8
        } else if sym == self.u32_ || sym == self.f32_ {
            32
        } else if sym == self.u64_ || sym == self.i64_ || sym == self.f64_ {
            64
        } else {
            0
        }
    }
}

// An effect declaration (`world.effects`, in name order).
pub copy struct EffectRow {
    name: u32,
    linear: bool,
}

// A row of a span-keyed table (`world.types`, `partial_ops`,
// `overflow_ops`), sorted by (start, end) as the Rust BTreeMap is. `ty` is
// the expression type for `types` and unused for the span sets.
pub copy struct SpanRow {
    start: u64,
    end: u64,
    ty: u32,
}

// The checker's `World`. Each SH2 lane adds the fields it needs below its
// own comment line, in its own PR; keep the census layout of the rest.
pub struct World {
    adts: ChunkSeq[Adt],
    generics: ChunkSeq[Generic],
    variants: ChunkSeq[Variant],
    fields: ChunkSeq[Field],
    // symbol -> adt index + 1
    by_name: ChunkSeq[u32],
    box_active: bool,
    k: Known,
    // `world.effects`.
    effects: ChunkSeq[EffectRow],
    // symbol -> effect index + 1
    effect_by_name: ChunkSeq[u32],
    // `world.types`: the type of each checked expression span.
    expr_types: ChunkSeq[SpanRow],
    // `world.partial_ops` and `world.overflow_ops`.
    partial_ops: ChunkSeq[SpanRow],
    overflow_ops: ChunkSeq[SpanRow],
}

pub fn world_new(k: Known) -> World {
    World {
        adts: ChunkSeq::new[Adt](),
        generics: ChunkSeq::new[Generic](),
        variants: ChunkSeq::new[Variant](),
        fields: ChunkSeq::new[Field](),
        by_name: ChunkSeq::new[u32](),
        box_active: false,
        k: k,
        effects: ChunkSeq::new[EffectRow](),
        effect_by_name: ChunkSeq::new[u32](),
        expr_types: ChunkSeq::new[SpanRow](),
        partial_ops: ChunkSeq::new[SpanRow](),
        overflow_ops: ChunkSeq::new[SpanRow](),
    }
}

// Grows a symbol-indexed table to cover `name` and sets it to `value`.
pub fn set_by_symbol(inout table: ChunkSeq[u32], name: u32, value: u32) {
    loop {
        if table.len() > w(name) {
            break;
        }
        table.push(0);
    }
    let ok = table.try_set(w(name), value);
}

fn span_row(in rows: ChunkSeq[SpanRow], i: u64) -> SpanRow {
    match rows.try_get(i) {
        Option::Some(row) => row,
        Option::None => SpanRow { start: 0, end: 0, ty: NONE32 },
    }
}

// The index of the row of span (start, end) in sorted `rows`, or the row
// count when there is none.
pub fn find_span(in rows: ChunkSeq[SpanRow], start: u64, end: u64) -> u64 {
    let mut lo: u64 = 0;
    let mut hi = rows.len();
    loop {
        if lo >= hi {
            break;
        }
        let mid = wrapping_add(lo, wrapping_sub(hi, lo) / 2);
        let row = span_row(in rows, mid);
        if row.start < start || (row.start == start && row.end < end) {
            lo = inc(mid);
        } else {
            hi = mid;
        }
    }
    let row = span_row(in rows, lo);
    if lo < rows.len() && row.start == start && row.end == end {
        lo
    } else {
        rows.len()
    }
}

const NO_ADT: u32 = NONE32;

fn copy_span_rows(in rows: ChunkSeq[SpanRow]) -> ChunkSeq[SpanRow] {
    let n = rows.len();
    if n == 0 {
        return ChunkSeq::new[SpanRow]();
    }
    let mut out = ChunkSeq::with_capacity[SpanRow](n);
    for i in 0..n {
        match rows.try_get(i) {
            Option::Some(row) => out.push(SpanRow {
                start: row.start,
                end: row.end,
                ty: row.ty,
            }),
            Option::None => {},
        }
    }
    out
}

impl World {
    pub fn deep_clone_in_heap(in self) -> World {
        let mut adts = ChunkSeq::with_capacity[Adt](self.adts.len());
        for i in 0..self.adts.len() {
            match self.adts.try_get(i) {
                Option::Some(adt) => adts.push(Adt {
                    name: adt.name,
                    mode: adt.mode,
                    ga: adt.ga,
                    gn: adt.gn,
                    va: adt.va,
                    vn: adt.vn,
                    is_enum: adt.is_enum,
                    tile: adt.tile,
                    span_zero: adt.span_zero,
                }),
                Option::None => {},
            }
        }
        let mut generics = ChunkSeq::with_capacity[Generic](self.generics.len());
        for i in 0..self.generics.len() {
            match self.generics.try_get(i) {
                Option::Some(generic) => generics.push(Generic {
                    name: generic.name,
                    bound: generic.bound,
                    row: generic.row,
                }),
                Option::None => {},
            }
        }
        let mut variants = ChunkSeq::with_capacity[Variant](self.variants.len());
        for i in 0..self.variants.len() {
            match self.variants.try_get(i) {
                Option::Some(variant) => variants.push(Variant {
                    name: variant.name,
                    fa: variant.fa,
                    fc: variant.fc,
                    named: variant.named,
                }),
                Option::None => {},
            }
        }
        let mut fields = ChunkSeq::with_capacity[Field](self.fields.len());
        for i in 0..self.fields.len() {
            match self.fields.try_get(i) {
                Option::Some(field) => fields.push(Field {
                    name: field.name,
                    ty: field.ty,
                    modality: field.modality,
                }),
                Option::None => {},
            }
        }
        let mut effects = ChunkSeq::with_capacity[EffectRow](self.effects.len());
        for i in 0..self.effects.len() {
            match self.effects.try_get(i) {
                Option::Some(effect) => effects.push(EffectRow {
                    name: effect.name,
                    linear: effect.linear,
                }),
                Option::None => {},
            }
        }
        let known = Known {
            string: self.k.string,
            str_: self.k.str_,
            dyn_: self.k.dyn_,
            region_box: self.k.region_box,
            watermark: self.k.watermark,
            chunk_seq: self.k.chunk_seq,
            slice: self.k.slice,
            tiled_seq: self.k.tiled_seq,
            box_: self.k.box_,
            vec: self.k.vec,
            mask: self.k.mask,
            u8_: self.k.u8_,
            u16_: self.k.u16_,
            u32_: self.k.u32_,
            u64_: self.k.u64_,
            usize_: self.k.usize_,
            i8_: self.k.i8_,
            i16_: self.k.i16_,
            i32_: self.k.i32_,
            i64_: self.k.i64_,
            isize_: self.k.isize_,
            i128_: self.k.i128_,
            u128_: self.k.u128_,
            f32_: self.k.f32_,
            f64_: self.k.f64_,
            bool_: self.k.bool_,
            unit: self.k.unit,
            never: self.k.never,
            region: self.k.region,
            len: self.k.len,
            cap: self.k.cap,
            data: self.k.data,
        };
        World {
            adts: adts,
            generics: generics,
            variants: variants,
            fields: fields,
            by_name: copy_seq[u32](in self.by_name),
            box_active: self.box_active,
            k: known,
            effects: effects,
            effect_by_name: copy_seq[u32](in self.effect_by_name),
            expr_types: copy_span_rows(in self.expr_types),
            partial_ops: copy_span_rows(in self.partial_ops),
            overflow_ops: copy_span_rows(in self.overflow_ops),
        }
    }

    pub fn adt(in self, i: u32) -> Adt {
        match self.adts.try_get(w(i)) {
            Option::Some(adt) => adt,
            Option::None => Adt {
                name: 0,
                mode: 0,
                ga: 0,
                gn: 0,
                va: 0,
                vn: 0,
                is_enum: false,
                tile: 0,
                span_zero: false
            },
        }
    }

    pub fn generic(in self, i: u64) -> Generic {
        match self.generics.try_get(i) {
            Option::Some(generic) => generic,
            Option::None => Generic { name: 0, bound: 0, row: false },
        }
    }

    pub fn variant(in self, i: u64) -> Variant {
        match self.variants.try_get(i) {
            Option::Some(variant) => variant,
            Option::None => Variant { name: 0, fa: 0, fc: 0, named: false },
        }
    }

    pub fn field(in self, i: u64) -> Field {
        match self.fields.try_get(i) {
            Option::Some(field) => field,
            Option::None => Field { name: 0, ty: 0, modality: 0 },
        }
    }

    // `world.adts.get(name)`.
    pub fn lookup(in self, name: u32) -> u32 {
        let entry = u32_at(in self.by_name, w(name));
        if entry == 0 {
            NO_ADT
        } else {
            wrapping_sub(entry, 1)
        }
    }

    pub fn index(inout self, name: u32, adt: u32) {
        set_by_symbol(inout self.by_name, name, inc32(adt));
    }

    // `world.effects.get(name)`, as an effect index, or NONE32.
    pub fn effect_index(in self, name: u32) -> u32 {
        let entry = u32_at(in self.effect_by_name, w(name));
        if entry == 0 {
            NONE32
        } else {
            wrapping_sub(entry, 1)
        }
    }

    pub fn effect_row(in self, i: u32) -> EffectRow {
        match self.effects.try_get(w(i)) {
            Option::Some(effect) => effect,
            Option::None => EffectRow { name: 0, linear: false },
        }
    }

    // The type the checker gave expression span (start, end), or NONE32.
    pub fn expr_type(in self, start: u64, end: u64) -> u32 {
        let i = find_span(in self.expr_types, start, end);
        span_row(in self.expr_types, i).ty
    }

    // `world.partial_ops.contains(&(start, end))`: the primitive operation
    // there can raise `Fail[RuntimeError]`.
    pub fn is_partial(in self, start: u64, end: u64) -> bool {
        find_span(in self.partial_ops, start, end) < self.partial_ops.len()
    }

    // `world.overflow_ops.contains(&(start, end))`: the checked integer
    // operation there can raise `Fail[ArithOverflow]`.
    pub fn may_overflow(in self, start: u64, end: u64) -> bool {
        find_span(in self.overflow_ops, start, end) < self.overflow_ops.len()
    }

    // The substitution of an ADT's generics by the arguments of `ty`
    // (Rust: `a.generics.iter().zip(args).collect::<BTreeMap<_, _>>()`).
    pub fn vars_of(in self, in types: Types, adt: Adt, ty: u32) -> Vars {
        let mut vars = vars_new();
        let arity = types.arity(ty);
        for i in 0..w(adt.gn) {
            if i >= arity {
                break;
            }
            let generic = self.generic(add(w(adt.ga), i));
            vars.set(generic.name, types.arg(ty, i));
        }
        vars
    }

    // The field `name` of `variant`, as a field index, or NONE32.
    pub fn find_field(in self, variant: Variant, name: u32) -> u32 {
        for i in 0..w(variant.fc) {
            let field = self.field(add(w(variant.fa), i));
            if field.name == name {
                return n32(add(w(variant.fa), i));
            }
        }
        NONE32
    }
}

// `vector::layout_words`: words of a valid `Vec[e, N]` / `Mask[e, N]`, or 0.
pub fn vector_words(in types: Types, in names: Names, known: Known, ty: u32) -> u32 {
    let node = types.node(ty);
    if node.kind != TyKind::Named
        || (node.name != known.vec && node.name != known.mask)
        || node.n != 2
    {
        return 0;
    }
    let elem = types.arg(ty, 0);
    let count = types.arg(ty, 1);
    let count_node = types.node(count);
    if count_node.kind != TyKind::Named || count_node.n != 0 {
        return 0;
    }
    let size = names.size(count_node.name);
    if size == 0 {
        return 0;
    }
    let mut lanes: u64 = 0;
    for i in 0..size {
        let digit = names.byte(count_node.name, i);
        if digit < 48 || digit > 57 {
            return 0;
        }
        lanes = wrapping_add(wrapping_mul(lanes, 10), widen_u64(wrapping_sub(digit, 48)));
        if lanes > 65535 {
            return 0;
        }
    }
    let elem_node = types.node(elem);
    if elem_node.kind != TyKind::Named || elem_node.n != 0 {
        return 0;
    }
    let bits = wrapping_mul(w(known.elem_bits(elem_node.name)), lanes);
    if bits == 128 || bits == 256 || bits == 512 {
        n32(bits / 64)
    } else {
        0
    }
}

// `World::constructor`: the first ADT in name order with a variant `short`;
// a qualified `T::V` must name that ADT. `qual` is the qualifier symbol or
// NONE32. Returns (adt, variant index) packed as adt * 2^32 + variant, or
// NONE (all ones).
pub fn constructor(in world: World, qual: u32, short: u32) -> u64 {
    for i in 0..world.adts.len() {
        let adt = world.adt(n32(i));
        if qual == NONE32 || qual == adt.name {
            for j in 0..w(adt.vn) {
                let variant = world.variant(add(w(adt.va), j));
                if variant.name == short {
                    return wrapping_add(wrapping_mul(i, 4294967296), add(w(adt.va), j));
                }
            }
        }
    }
    18446744073709551615
}

// Generic bounds in scope (`BTreeMap<String, Mode>`).
pub struct Bounds {
    keys: ChunkSeq[u32],
    modes: ChunkSeq[u8],
}

pub fn bounds_new() -> Bounds {
    Bounds { keys: ChunkSeq::new[u32](), modes: ChunkSeq::new[u8]() }
}

impl Bounds {
    pub fn get(in self, key: u32) -> u8 {
        for i in 0..self.keys.len() {
            if u32_at(in self.keys, i) == key {
                return u8_at(in self.modes, i);
            }
        }
        255
    }

    pub fn set(inout self, key: u32, mode: u8) {
        for i in 0..self.keys.len() {
            if u32_at(in self.keys, i) == key {
                let ok = self.modes.try_set(i, mode);
                return;
            }
        }
        self.keys.push(key);
        self.modes.push(mode);
    }
}

fn join(a: u8, b: u8) -> u8 {
    if a > b { a } else { b }
}

// `World::mode`.
pub fn mode_of(
    inout types: Types,
    in names: Names,
    in world: World,
    ty: u32,
    in bounds: Bounds
) -> u8 {
    let mut seen_names: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut seen_modes: ChunkSeq[u64] = ChunkSeq::new[u64]();
    mode_visit(inout types, in names, in world, ty, in bounds, inout seen_names, inout seen_modes)
}

fn mode_visit(
    inout types: Types,
    in names: Names,
    in world: World,
    ty: u32,
    in bounds: Bounds,
    inout seen_names: ChunkSeq[u32],
    inout seen_modes: ChunkSeq[u64]
) -> u8 {
    let node = types.node(ty);
    let known = world.k;
    if node.kind == TyKind::Infer || node.kind == TyKind::Lit || node.kind == TyKind::Row {
        return TyMode::Copy;
    }
    if node.kind == TyKind::Tuple {
        let mut mode = TyMode::Copy;
        for i in 0..w(node.n) {
            let part_mode = mode_visit(
                inout types,
                in names,
                in world,
                u32_at(in types.items, add(w(node.a), i)),
                in bounds,
                inout seen_names,
                inout seen_modes
            );
            mode = join(mode, part_mode);
        }
        return mode;
    }
    if node.kind == TyKind::Fn {
        return node.mode;
    }
    let bound_mode = bounds.get(node.name);
    if bound_mode != 255 {
        return bound_mode;
    }
    if vector_words(in types, in names, known, ty) != 0 {
        return TyMode::Copy;
    }
    if known.is_scalar(node.name) {
        return TyMode::Copy;
    }
    if node.name == known.string || node.name == known.str_ || node.name == known.dyn_ {
        return TyMode::Affine;
    }
    if node.name == known.region_box {
        if node.n < 2 {
            return TyMode::Linear;
        }
        return mode_visit(
            inout types,
            in names,
            in world,
            types.arg(ty, 1),
            in bounds,
            inout seen_names,
            inout seen_modes
        );
    }
    if node.name == known.chunk_seq || node.name == known.slice || node.name == known.tiled_seq {
        if node.n == 0 {
            return TyMode::Affine;
        }
        let part_mode = mode_visit(
            inout types,
            in names,
            in world,
            types.arg(ty, 0),
            in bounds,
            inout seen_names,
            inout seen_modes
        );
        return join(part_mode, TyMode::Affine);
    }
    let adt_index = world.lookup(node.name);
    if adt_index == NO_ADT {
        return TyMode::Linear;
    }
    let adt = world.adt(adt_index);
    let mut arg_modes: ChunkSeq[u8] = ChunkSeq::new[u8]();
    // The `seen` key `"{n}:{argument_modes:?}"`: the name and the modes.
    let mut key: u64 = fold(14695981039346656037, w(node.n));
    for i in 0..w(node.n) {
        let part_mode = mode_visit(
            inout types,
            in names,
            in world,
            u32_at(in types.items, add(w(node.a), i)),
            in bounds,
            inout seen_names,
            inout seen_modes
        );
        arg_modes.push(part_mode);
        key = fold(key, widen_u64(part_mode));
    }
    for i in 0..seen_names.len() {
        if u32_at(in seen_names, i) == node.name && u64_at(in seen_modes, i) == key {
            return adt.mode;
        }
    }
    seen_names.push(node.name);
    seen_modes.push(key);
    let mut component = bounds_new();
    for i in 0..w(adt.gn) {
        if i >= arg_modes.len() {
            break;
        }
        component.set(world.generic(add(w(adt.ga), i)).name, u8_at(in arg_modes, i));
    }
    let mut mode = adt.mode;
    for vi in 0..w(adt.vn) {
        let variant = world.variant(add(w(adt.va), vi));
        for fi in 0..w(variant.fc) {
            let field = world.field(add(w(variant.fa), fi));
            let intrinsic = mode_visit(
                inout types,
                in names,
                in world,
                field.ty,
                in component,
                inout seen_names,
                inout seen_modes
            );
            if field.modality == 0 {
                mode = join(mode, intrinsic);
            } else {
                mode = join(mode, wrapping_sub(field.modality, 1));
            }
        }
    }
    let last = wrapping_sub(seen_names.len(), 1);
    seen_names.truncate(last);
    seen_modes.truncate(last);
    mode
}

// `World::field(ty, path)` for one path step `name` (a field name, a tuple
// index, or a `[..]` segment, which `is_segment` marks). Returns NONE32 for None.
pub fn field_step(
    inout types: Types,
    inout names: Names,
    in world: World,
    ty: u32,
    name: u32,
    is_segment: bool
) -> u32 {
    let node = types.node(ty);
    let known = world.k;
    if node.kind == TyKind::Named {
        if is_segment && (node.name == known.chunk_seq || node.name == known.slice) {
            if node.n == 0 {
                return NONE32;
            }
            let mut args: ChunkSeq[u32] = ChunkSeq::new[u32]();
            args.push(types.arg(ty, 0));
            return types.named(known.slice, in args);
        }
        if is_segment && node.n == 0 && (node.name == known.string || node.name == known.str_) {
            return types.named0(known.str_);
        }
        if node.name == known.tiled_seq {
            if node.n == 0 {
                return NONE32;
            }
            let elem = types.arg(ty, 0);
            let elem_node = types.node(elem);
            if elem_node.kind != TyKind::Named {
                return NONE32;
            }
            let adt_index = world.lookup(elem_node.name);
            if adt_index == NO_ADT {
                return NONE32;
            }
            let adt = world.adt(adt_index);
            if adt.is_enum || adt.tile == 0 || adt.vn == 0 {
                return NONE32;
            }
            let field_index = world.find_field(world.variant(w(adt.va)), name);
            if field_index == NONE32 {
                return NONE32;
            }
            let vars = world.vars_of(in types, adt, elem);
            return substitute(inout types, world.field(w(field_index)).ty, in vars);
        }
        let adt_index = world.lookup(node.name);
        if adt_index == NO_ADT {
            return NONE32;
        }
        let adt = world.adt(adt_index);
        if adt.is_enum || adt.vn == 0 {
            return NONE32;
        }
        let field_index = world.find_field(world.variant(w(adt.va)), name);
        if field_index == NONE32 {
            return NONE32;
        }
        let vars = world.vars_of(in types, adt, ty);
        return substitute(inout types, world.field(w(field_index)).ty, in vars);
    }
    if node.kind == TyKind::Tuple {
        // `name.parse::<usize>()`: decimal digits only.
        let size = names.size(name);
        if size == 0 {
            return NONE32;
        }
        let mut index: u64 = 0;
        for i in 0..size {
            let digit = names.byte(name, i);
            if digit < 48 || digit > 57 {
                return NONE32;
            }
            index = wrapping_add(wrapping_mul(index, 10), widen_u64(wrapping_sub(digit, 48)));
        }
        if index >= w(node.n) {
            return NONE32;
        }
        return types.arg(ty, index);
    }
    NONE32
}

// Whether a call with effect row `row_id` is effectful: an open row, or an
// instance of an effect declared non-linear (what the census harness
// precomputed in Rust: `row.tail.is_some() || row.instances.iter()
// .any(|e| world.effects.get(&e.name).is_some_and(|d| !d.linear))`).
pub fn effectful_row(in types: Types, in world: World, row_id: u32) -> bool {
    let row = types.row(row_id);
    if row.tail != 0 {
        return true;
    }
    for i in 0..w(row.n) {
        let eff = types.effect_at(add(w(row.a), i));
        let decl = world.effect_index(eff.name);
        if decl != NONE32 && !world.effect_row(decl).linear {
            return true;
        }
    }
    false
}
