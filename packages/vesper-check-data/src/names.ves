// Interned names: the names table every other table refers to.

use self::util::{add, copy_seq, put_text_words, fold, inc, inc32, n32, u32_at, u64_at, u8_at, w};

// Symbol 0 is the empty name, so 0 can mean "none" in
// tables (Rust: `Option<String>`).
pub struct Names {
    text: ChunkSeq[u8],
    starts: ChunkSeq[u64],
    hashes: ChunkSeq[u64],
    slots: ChunkSeq[u32],
    mask: u64,
}

pub fn names_new() -> Names {
    names_sized(4096)
}

// An empty table with `slots` hash slots (a power of two), for inputs
// with few names: `names_new` zeroes 4,096 slots, which costs more than
// a small task's whole answer. The table grows like any other.
pub fn names_sized(slots: u64) -> Names {
    let mut slots_seq: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](slots);
    slots_seq.resize(slots, 0);
    let mut starts: ChunkSeq[u64] = ChunkSeq::new[u64]();
    starts.push(0);
    let mut table = Names {
        text: ChunkSeq::new[u8](),
        starts: starts,
        hashes: ChunkSeq::new[u64](),
        slots: slots_seq,
        mask: wrapping_sub(slots, 1),
    };
    let empty = table.intern(in "".as_bytes());
    table
}

pub fn hash_bytes(in bytes: Slice[u8]) -> u64 {
    let mut hash: u64 = 14695981039346656037;
    for i in 0..bytes.len() {
        let byte = match bytes.try_get(i) {
            Option::Some(byte) => byte,
            Option::None => 0,
        };
        hash = wrapping_mul(hash ^ widen_u64(byte), 1099511628211);
    }
    hash
}

impl Names {
    pub fn len(in self) -> u64 {
        if self.hashes.len() > 0 {
            self.hashes.len()
        } else if self.starts.len() > 0 {
            wrapping_sub(self.starts.len(), 1)
        } else {
            0
        }
    }

    pub fn text_len(in self) -> u64 {
        self.text.len()
    }

    pub fn mask_val(in self) -> u64 {
        self.mask
    }

    pub fn reserve_names(inout self, names_cap: u64, text_cap: u64) {
        self.text.reserve(text_cap);
        self.starts.reserve(inc(names_cap));
        self.hashes.reserve(names_cap);
    }

    pub fn clone_in_heap(sink self) -> Names {
        let Names {
            text,
            starts,
            hashes,
            slots,
            mask,
        } = self;
        Names {
            text: text,
            starts: starts,
            hashes: hashes,
            slots: slots,
            mask: mask,
        }
    }

    pub fn deep_clone_in_heap(in self) -> Names {
        let mut text = if self.text.len() == 0 {
            ChunkSeq::new[u8]()
        } else {
            let mut copied = ChunkSeq::with_capacity[u8](self.text.len());
            copied.extend(in self.text.as_slice());
            copied
        };
        Names {
            text: text,
            starts: copy_seq[u64](in self.starts),
            hashes: copy_seq[u64](in self.hashes),
            slots: copy_seq[u32](in self.slots),
            mask: self.mask,
        }
    }

    pub fn snapshot_text(in self) -> Names {
        let mut text = ChunkSeq::new[u8]();
        text.extend(in self.text.as_slice());
        let mut starts = ChunkSeq::new[u64]();
        for i in 0..self.starts.len() {
            starts.push(u64_at(in self.starts, i));
        }
        Names {
            text: text,
            starts: starts,
            hashes: ChunkSeq::new[u64](),
            slots: ChunkSeq::new[u32](),
            mask: 0,
        }
    }

    pub fn start(in self, sym: u32) -> u64 {
        u64_at(in self.starts, w(sym))
    }

    pub fn end(in self, sym: u32) -> u64 {
        u64_at(in self.starts, inc(w(sym)))
    }

    pub fn size(in self, sym: u32) -> u64 {
        wrapping_sub(self.end(sym), self.start(sym))
    }

    pub fn byte(in self, sym: u32, i: u64) -> u8 {
        u8_at(in self.text, add(self.start(sym), i))
    }

    // Whether symbol `sym` spells `bytes`.
    pub fn spells(in self, sym: u32, in bytes: Slice[u8]) -> bool {
        let start = self.start(sym);
        let len = wrapping_sub(self.end(sym), start);
        if len != bytes.len() {
            return false;
        }
        let mut i: u64 = 0;
        loop {
            if i >= len {
                break;
            }
            let actual = u8_at(in self.text, add(start, i));
            let expected = match bytes.try_get(i) {
                Option::Some(byte) => byte,
                Option::None => 0,
            };
            if actual != expected {
                return false;
            }
            i = inc(i);
        }
        true
    }

    pub fn has_prefix(in self, sym: u32, in bytes: Slice[u8]) -> bool {
        let start = self.start(sym);
        let len = wrapping_sub(self.end(sym), start);
        if len < bytes.len() {
            return false;
        }
        for i in 0..bytes.len() {
            let expected = match bytes.try_get(i) {
                Option::Some(byte) => byte,
                Option::None => 0,
            };
            if u8_at(in self.text, add(start, i)) != expected {
                return false;
            }
        }
        true
    }

    fn grow(inout self) {
        let cap = wrapping_mul(add(self.mask, 1), 2);
        let mut slots: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](cap);
        slots.resize(cap, 0);
        let mask = wrapping_sub(cap, 1);
        for id in 0..self.hashes.len() {
            let mut probe = u64_at(in self.hashes, id) & mask;
            loop {
                if u32_at(in slots, probe) == 0 {
                    break;
                }
                probe = inc(probe) & mask;
            }
            let ok = slots.try_set(probe, n32(inc(id)));
        }
        self.slots = slots;
        self.mask = mask;
    }

    pub fn lookup(in self, in bytes: Slice[u8]) -> u32 {
        let hash = hash_bytes(in bytes);
        let mut probe = hash & self.mask;
        loop {
            let slot = u32_at(in self.slots, probe);
            if slot == 0 {
                return 4294967295;
            }
            let id = wrapping_sub(slot, 1);
            if u64_at(in self.hashes, w(id)) == hash && self.spells(id, in bytes) {
                return id;
            }
            probe = inc(probe) & self.mask;
        }
    }

    pub fn intern(inout self, in bytes: Slice[u8]) -> u32 {
        let hash = hash_bytes(in bytes);
        let mut probe = hash & self.mask;
        loop {
            let slot = u32_at(in self.slots, probe);
            if slot == 0 {
                break;
            }
            let id = wrapping_sub(slot, 1);
            if u64_at(in self.hashes, w(id)) == hash && self.spells(id, in bytes) {
                return id;
            }
            probe = inc(probe) & self.mask;
        }
        let id = n32(self.hashes.len());
        self.text.extend(in bytes);
        self.starts.push(self.text.len());
        self.hashes.push(hash);
        let ok = self.slots.try_set(probe, inc32(id));
        if wrapping_mul(self.hashes.len(), 2) > self.mask {
            self.grow();
        }
        id
    }

    // The text of `sym` as `put_text_words` words.
    pub fn put_words(in self, sym: u32, inout out: ChunkSeq[u64]) {
        let start = self.start(sym);
        let end = self.end(sym);
        if start < end && end <= self.text.len() {
            put_text_words(inout out, in self.text[start..end]);
        } else {
            out.push(0);
        }
    }

    // Appends the text of `sym` to `out`.
    pub fn write(in self, sym: u32, inout out: ChunkSeq[u8]) {
        let start = self.start(sym);
        let end = self.end(sym);
        if start < end && end <= self.text.len() {
            out.extend(in self.text[start..end]);
        }
    }

    // Digest of a name's bytes (what Rust folds for a `String`).
    pub fn fold_name(in self, seed: u64, sym: u32) -> u64 {
        let mut hash = seed;
        let start = self.start(sym);
        let end = self.end(sym);
        for i in start..end {
            hash = fold(hash, widen_u64(u8_at(in self.text, i)));
        }
        fold(hash, 255)
    }
}
