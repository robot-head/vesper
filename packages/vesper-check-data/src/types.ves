// The type table of vesper-core (`ast::Type`, `Effects`, `substitute`,
// `Display`), as a hash-consed arena. A Rust `Type` is a tree of owned
// `Vec`s and `Box`es, cloned whenever it is passed on; here a type is a
// `u32` id and equal types have equal ids, so `clone` is a copy and `==`
// is one compare. That is most of why the census samples ran at 0.34x to
// 0.87x of Rust's time; keep it.

use self::util::{add, copy_seq, fold, inc, inc32, n32, push_decimal, u32_at, u64_at, u8_at, w};
use self::names::{Names};

const NONE32: u32 = 4294967295;
// Bits in half a u64 word, and its low half.
const HALF_WORD_BITS: u64 = 32;
const HALF_WORD_MASK: u64 = 4294967295;
const DECIMAL_BASE: u64 = 10;
const ASCII_ZERO: u64 = 48;
const I64_MAX_U64: u64 = 9223372036854775807;
// The magnitude of i64::MIN.
const I64_MIN_MAGNITUDE: u64 = 9223372036854775808;

// A type node's kind. Every checker, lowering and backend package that
// reads check-data's type table compares against these, so they live here
// as value enums and fold to the same literals everywhere.
pub enum TyKind: _ {
    Lit = 0,
    Named = 1,
    Tuple = 2,
    Fn = 3,
    Row = 4,
    Infer = 5,
}

// `Mode`: Copy < Affine < Linear.
pub enum TyMode: _ {
    Copy = 0,
    Affine = 1,
    Linear = 2,
}

// `Pass`: how a parameter is passed.
pub enum TyPass: _ {
    In = 0,
    Inout = 1,
    Sink = 2,
}

pub copy struct TypeNode {
    kind: u8,
    mode: u8,
    // Named: the name. Function: unused.
    name: u32,
    // Named/Tuple: arguments; Function: parameters (items[a..a+n]).
    a: u32,
    n: u32,
    // Function: result type; Function/Row: `r2` is the row id.
    r: u32,
    r2: u32,
    lit: i64,
}

pub copy struct RowNode {
    // effects[a..a+n]
    a: u32,
    n: u32,
    // tail symbol + 1, or 0
    tail: u32,
}

pub copy struct EffNode {
    // label symbol + 1, or 0
    label: u32,
    name: u32,
    // effect arguments: items[a..a+n]
    a: u32,
    n: u32,
}

pub struct Types {
    nodes: ChunkSeq[TypeNode],
    items: ChunkSeq[u32],
    passes: ChunkSeq[u8],
    hashes: ChunkSeq[u64],
    slots: ChunkSeq[u32],
    mask: u64,
    rows: ChunkSeq[RowNode],
    effs: ChunkSeq[EffNode],
    row_hashes: ChunkSeq[u64],
    row_slots: ChunkSeq[u32],
    row_mask: u64,
    // Well-known names, interned at creation.
    s_dyn: u32,
    s_u64: u32,
    s_i64: u32,
    s_i128: u32,
    s_unit: u32,
    unit: u32,
    infer: u32,
    empty_row: u32,
}

pub fn zero_slots(n: u64) -> ChunkSeq[u32] {
    let mut slots: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](n);
    slots.resize(n, 0);
    slots
}

pub fn types_new(inout names: Names) -> Types {
    let mut types = Types {
        nodes: ChunkSeq::new[TypeNode](),
        items: ChunkSeq::new[u32](),
        passes: ChunkSeq::new[u8](),
        hashes: ChunkSeq::new[u64](),
        slots: zero_slots(4096),
        mask: 4095,
        rows: ChunkSeq::new[RowNode](),
        effs: ChunkSeq::new[EffNode](),
        row_hashes: ChunkSeq::new[u64](),
        row_slots: zero_slots(1024),
        row_mask: 1023,
        s_dyn: names.intern(in "dyn".as_bytes()),
        s_u64: names.intern(in "u64".as_bytes()),
        s_i64: names.intern(in "i64".as_bytes()),
        s_i128: names.intern(in "i128".as_bytes()),
        s_unit: names.intern(in "Unit".as_bytes()),
        unit: 0,
        infer: 0,
        empty_row: 0,
    };
    let no_items: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let no_effs: ChunkSeq[EffNode] = ChunkSeq::new[EffNode]();
    let empty_row = types.mk_row(in no_effs, in no_items, 0);
    types.empty_row = empty_row;
    let unit = types.mk(TyKind::Tuple, 0, 0, in no_items, 0, 0, 0);
    types.unit = unit;
    let infer = types.mk(TyKind::Infer, 0, 0, in no_items, 0, 0, 0);
    types.infer = infer;
    types
}

fn node_hash(
    kind: u8,
    mode: u8,
    name: u32,
    in items: ChunkSeq[u32],
    result: u32,
    row: u32,
    lit: i64
) -> u64 {
    let mut hash = fold(14695981039346656037, widen_u64(kind));
    hash = fold(hash, widen_u64(mode));
    hash = fold(hash, w(name));
    hash = fold(hash, w(result));
    hash = fold(hash, w(row));
    hash = fold(hash, wrapping_u64(lit));
    for i in 0..items.len() {
        hash = fold(hash, w(u32_at(in items, i)));
    }
    hash
}

impl Types {
    pub fn t_mask(in self) -> u64 {
        self.mask
    }

    pub fn r_mask(in self) -> u64 {
        self.row_mask
    }

    pub fn items_len(in self) -> u64 {
        self.items.len()
    }

    pub fn effs_len(in self) -> u64 {
        self.effs.len()
    }

    pub fn reserve_types(inout self, nodes_cap: u64, items_cap: u64, rows_cap: u64, effs_cap: u64) {
        self.nodes.reserve(nodes_cap);
        self.hashes.reserve(nodes_cap);
        self.items.reserve(items_cap);
        self.passes.reserve(items_cap);
        self.rows.reserve(rows_cap);
        self.row_hashes.reserve(rows_cap);
        self.effs.reserve(effs_cap);
    }

    pub fn clone_tail_in_heap(sink self, n_nodes: u64, n_rows: u64, n_effs: u64) -> Types {
        let mut types = self;
        let mut new_nodes = ChunkSeq::new[TypeNode]();
        let tail_nodes = wrapping_sub(types.nodes.len(), n_nodes);
        for i in n_nodes..types.nodes.len() {
            match types.nodes.try_get(i) {
                Option::Some(node) => new_nodes.push(TypeNode {
                    kind: node.kind,
                    mode: node.mode,
                    name: node.name,
                    a: node.a,
                    n: node.n,
                    r: node.r,
                    r2: node.r2,
                    lit: node.lit,
                }),
                Option::None => {},
            }
        }
        for _ in 0..tail_nodes {
            let _ = types.nodes.pop();
        }
        for i in 0..new_nodes.len() {
            match new_nodes.try_get(i) {
                Option::Some(node) => types.nodes.push(TypeNode {
                    kind: node.kind,
                    mode: node.mode,
                    name: node.name,
                    a: node.a,
                    n: node.n,
                    r: node.r,
                    r2: node.r2,
                    lit: node.lit,
                }),
                Option::None => {},
            }
        }
        let mut new_rows = ChunkSeq::new[RowNode]();
        let tail_rows = wrapping_sub(types.rows.len(), n_rows);
        for i in n_rows..types.rows.len() {
            match types.rows.try_get(i) {
                Option::Some(row) => new_rows.push(RowNode { a: row.a, n: row.n, tail: row.tail }),
                Option::None => {},
            }
        }
        for _ in 0..tail_rows {
            let _ = types.rows.pop();
        }
        for i in 0..new_rows.len() {
            match new_rows.try_get(i) {
                Option::Some(row) => types
                    .rows
                    .push(RowNode { a: row.a, n: row.n, tail: row.tail }),
                Option::None => {},
            }
        }
        let mut new_effs = ChunkSeq::new[EffNode]();
        let tail_effs = wrapping_sub(types.effs.len(), n_effs);
        for i in n_effs..types.effs.len() {
            match types.effs.try_get(i) {
                Option::Some(eff) => new_effs.push(EffNode {
                    label: eff.label,
                    name: eff.name,
                    a: eff.a,
                    n: eff.n,
                }),
                Option::None => {},
            }
        }
        for _ in 0..tail_effs {
            let _ = types.effs.pop();
        }
        for i in 0..new_effs.len() {
            match new_effs.try_get(i) {
                Option::Some(eff) => types.effs.push(EffNode {
                    label: eff.label,
                    name: eff.name,
                    a: eff.a,
                    n: eff.n,
                }),
                Option::None => {},
            }
        }
        types.clone_in_heap()
    }

    pub fn clone_in_heap(sink self) -> Types {
        let Types {
            nodes,
            items,
            passes,
            hashes,
            slots,
            mask,
            rows,
            effs,
            row_hashes,
            row_slots,
            row_mask,
            s_dyn,
            s_u64,
            s_i64,
            s_i128,
            s_unit,
            unit,
            infer,
            empty_row,
        } = self;
        Types {
            nodes: nodes,
            items: items,
            passes: passes,
            hashes: hashes,
            slots: slots,
            mask: mask,
            rows: rows,
            effs: effs,
            row_hashes: row_hashes,
            row_slots: row_slots,
            row_mask: row_mask,
            s_dyn: s_dyn,
            s_u64: s_u64,
            s_i64: s_i64,
            s_i128: s_i128,
            s_unit: s_unit,
            unit: unit,
            infer: infer,
            empty_row: empty_row,
        }
    }

    pub fn deep_clone_in_heap(in self) -> Types {
        let mut nodes = ChunkSeq::with_capacity[TypeNode](self.nodes.len());
        for i in 0..self.nodes.len() {
            match self.nodes.try_get(i) {
                Option::Some(node) => nodes.push(TypeNode {
                    kind: node.kind,
                    mode: node.mode,
                    name: node.name,
                    a: node.a,
                    n: node.n,
                    r: node.r,
                    r2: node.r2,
                    lit: node.lit,
                }),
                Option::None => {},
            }
        }
        let mut rows = ChunkSeq::with_capacity[RowNode](self.rows.len());
        for i in 0..self.rows.len() {
            match self.rows.try_get(i) {
                Option::Some(row) => rows.push(RowNode {
                    a: row.a,
                    n: row.n,
                    tail: row.tail,
                }),
                Option::None => {},
            }
        }
        let mut effs = ChunkSeq::with_capacity[EffNode](self.effs.len());
        for i in 0..self.effs.len() {
            match self.effs.try_get(i) {
                Option::Some(eff) => effs.push(EffNode {
                    label: eff.label,
                    name: eff.name,
                    a: eff.a,
                    n: eff.n,
                }),
                Option::None => {},
            }
        }
        Types {
            nodes: nodes,
            items: copy_seq[u32](in self.items),
            passes: copy_seq[u8](in self.passes),
            hashes: copy_seq[u64](in self.hashes),
            slots: copy_seq[u32](in self.slots),
            mask: self.mask,
            rows: rows,
            effs: effs,
            row_hashes: copy_seq[u64](in self.row_hashes),
            row_slots: copy_seq[u32](in self.row_slots),
            row_mask: self.row_mask,
            s_dyn: self.s_dyn,
            s_u64: self.s_u64,
            s_i64: self.s_i64,
            s_i128: self.s_i128,
            s_unit: self.s_unit,
            unit: self.unit,
            infer: self.infer,
            empty_row: self.empty_row,
        }
    }

    pub fn node(in self, ty: u32) -> TypeNode {
        match self.nodes.try_get(w(ty)) {
            Option::Some(node) => node,
            Option::None => TypeNode {
                kind: TyKind::Infer,
                mode: 0,
                name: 0,
                a: 0,
                n: 0,
                r: 0,
                r2: 0,
                lit: 0
            },
        }
    }

    pub fn kind(in self, ty: u32) -> u8 {
        self.node(ty).kind
    }

    // `Type::name`: the name of a `Named` type, else "" (symbol 0).
    pub fn name(in self, ty: u32) -> u32 {
        let node = self.node(ty);
        if node.kind == TyKind::Named {
            node.name
        } else {
            0
        }
    }

    pub fn arity(in self, ty: u32) -> u64 {
        let node = self.node(ty);
        if node.kind == TyKind::Named || node.kind == TyKind::Tuple || node.kind == TyKind::Fn {
            w(node.n)
        } else {
            0
        }
    }

    // Argument `i` of a Named or Tuple type (parameter type of a function).
    pub fn arg(in self, ty: u32, i: u64) -> u32 {
        let node = self.node(ty);
        if i >= w(node.n) {
            return NONE32;
        }
        u32_at(in self.items, add(w(node.a), i))
    }

    pub fn param_pass(in self, ty: u32, i: u64) -> u8 {
        let node = self.node(ty);
        u8_at(in self.passes, add(w(node.a), i))
    }

    pub fn row(in self, row_id: u32) -> RowNode {
        match self.rows.try_get(w(row_id)) {
            Option::Some(row) => row,
            Option::None => RowNode { a: 0, n: 0, tail: 0 },
        }
    }

    pub fn effect_at(in self, i: u64) -> EffNode {
        match self.effs.try_get(i) {
            Option::Some(eff) => eff,
            Option::None => EffNode { label: 0, name: 0, a: 0, n: 0 },
        }
    }

    fn grow(inout self) {
        let cap = wrapping_mul(add(self.mask, 1), 2);
        let mut slots = zero_slots(cap);
        let mask = wrapping_sub(cap, 1);
        for id in 0..self.hashes.len() {
            let mut probe = u64_at(in self.hashes, id) & mask;
            loop {
                if u32_at(in slots, probe) == 0 {
                    break;
                }
                probe = inc(probe) & mask;
            }
            let ok = slots.try_set(probe, n32(inc(id)));
        }
        self.slots = slots;
        self.mask = mask;
    }

    fn same(
        in self,
        id: u32,
        kind: u8,
        mode: u8,
        name: u32,
        in items: ChunkSeq[u32],
        in passes: ChunkSeq[u8],
        result: u32,
        row: u32,
        lit: i64
    ) -> bool {
        let node = self.node(id);
        if node.kind != kind
            || node.mode != mode
            || node.name != name
            || node.r != result
            || node.r2 != row
            || node.lit != lit
            || w(node.n) != items.len()
        {
            return false;
        }
        for i in 0..items.len() {
            let item_index = add(w(node.a), i);
            if u32_at(in self.items, item_index) != u32_at(in items, i) {
                return false;
            }
            if kind == TyKind::Fn && u8_at(in self.passes, item_index) != u8_at(in passes, i) {
                return false;
            }
        }
        true
    }

    // The id of the type with these parts (hash-consed).
    pub fn mk_with(
        inout self,
        kind: u8,
        mode: u8,
        name: u32,
        in items: ChunkSeq[u32],
        in passes: ChunkSeq[u8],
        result: u32,
        row: u32,
        lit: i64
    ) -> u32 {
        let mut hash = node_hash(kind, mode, name, in items, result, row, lit);
        if kind == TyKind::Fn {
            for i in 0..passes.len() {
                hash = fold(hash, widen_u64(u8_at(in passes, i)));
            }
        }
        let mut probe = hash & self.mask;
        loop {
            let slot = u32_at(in self.slots, probe);
            if slot == 0 {
                break;
            }
            let id = wrapping_sub(slot, 1);
            if u64_at(in self.hashes, w(id)) == hash
                && self.same(id, kind, mode, name, in items, in passes, result, row, lit)
            {
                return id;
            }
            probe = inc(probe) & self.mask;
        }
        let id = n32(self.nodes.len());
        let item_start = n32(self.items.len());
        for i in 0..items.len() {
            self.items.push(u32_at(in items, i));
            if kind == TyKind::Fn {
                self.passes.push(u8_at(in passes, i));
            } else {
                self.passes.push(0);
            }
        }
        self.nodes.push(TypeNode {
            kind: kind,
            mode: mode,
            name: name,
            a: item_start,
            n: n32(items.len()),
            r: result,
            r2: row,
            lit: lit
        });
        self.hashes.push(hash);
        let ok = self.slots.try_set(probe, inc32(id));
        if wrapping_mul(self.hashes.len(), 2) > self.mask {
            self.grow();
        }
        id
    }

    pub fn mk(
        inout self,
        kind: u8,
        mode: u8,
        name: u32,
        in items: ChunkSeq[u32],
        result: u32,
        row: u32,
        lit: i64
    ) -> u32 {
        let no_passes: ChunkSeq[u8] = ChunkSeq::new[u8]();
        self.mk_with(kind, mode, name, in items, in no_passes, result, row, lit)
    }

    pub fn named(inout self, name: u32, in args: ChunkSeq[u32]) -> u32 {
        self.mk(TyKind::Named, 0, name, in args, 0, 0, 0)
    }

    pub fn named0(inout self, name: u32) -> u32 {
        let no_args: ChunkSeq[u32] = ChunkSeq::new[u32]();
        self.mk(TyKind::Named, 0, name, in no_args, 0, 0, 0)
    }

    pub fn tuple(inout self, in args: ChunkSeq[u32]) -> u32 {
        self.mk(TyKind::Tuple, 0, 0, in args, 0, 0, 0)
    }

    // An integer literal type: Rust holds an `i128`; Vesper has no 128-bit
    // integer, so the sample keeps a sign (in `mode`) and a u64 magnitude.
    pub fn literal(inout self, neg: bool, magnitude: u64) -> u32 {
        self.wide_literal(neg, magnitude, 0)
    }

    // An integer literal type past u64 in magnitude: the magnitude's high
    // word is split over `r` (low half) and `r2` (high half), which a
    // literal does not otherwise use.
    pub fn wide_literal(inout self, neg: bool, lo: u64, hi: u64) -> u32 {
        let no_args: ChunkSeq[u32] = ChunkSeq::new[u32]();
        self.mk(
            TyKind::Lit,
            if neg { 1 } else { 0 },
            0,
            in no_args,
            wrapping_u32(hi),
            wrapping_u32(hi >> HALF_WORD_BITS),
            wrapping_i64(lo)
        )
    }

    pub fn row_type(inout self, row: u32) -> u32 {
        let no_args: ChunkSeq[u32] = ChunkSeq::new[u32]();
        self.mk(TyKind::Row, 0, 0, in no_args, 0, row, 0)
    }

    // A row of effects `effs` whose arguments are `args` (each effect's
    // `a` indexes `args`), with tail symbol + 1 (0 = closed).
    pub fn mk_row(
        inout self,
        in effs: ChunkSeq[EffNode],
        in args: ChunkSeq[u32],
        tail: u32
    ) -> u32 {
        let mut hash = fold(14695981039346656037, w(tail));
        for i in 0..effs.len() {
            let eff = match effs.try_get(i) {
                Option::Some(eff) => eff,
                Option::None => EffNode { label: 0, name: 0, a: 0, n: 0 },
            };
            hash = fold(fold(fold(hash, w(eff.label)), w(eff.name)), w(eff.n));
            for j in 0..w(eff.n) {
                hash = fold(hash, w(u32_at(in args, add(w(eff.a), j))));
            }
        }
        let mut probe = hash & self.row_mask;
        loop {
            let slot = u32_at(in self.row_slots, probe);
            if slot == 0 {
                break;
            }
            let id = wrapping_sub(slot, 1);
            if u64_at(in self.row_hashes, w(id)) == hash
                && self.same_row(id, in effs, in args, tail)
            {
                return id;
            }
            probe = inc(probe) & self.row_mask;
        }
        let id = n32(self.rows.len());
        let eff_start = n32(self.effs.len());
        for i in 0..effs.len() {
            let eff = match effs.try_get(i) {
                Option::Some(eff) => eff,
                Option::None => EffNode { label: 0, name: 0, a: 0, n: 0 },
            };
            let arg_start = n32(self.items.len());
            for j in 0..w(eff.n) {
                self.items.push(u32_at(in args, add(w(eff.a), j)));
                self.passes.push(0);
            }
            self.effs.push(EffNode { label: eff.label, name: eff.name, a: arg_start, n: eff.n });
        }
        self.rows.push(RowNode { a: eff_start, n: n32(effs.len()), tail: tail });
        self.row_hashes.push(hash);
        let ok = self.row_slots.try_set(probe, inc32(id));
        if wrapping_mul(self.row_hashes.len(), 2) > self.row_mask {
            self.grow_rows();
        }
        id
    }

    fn same_row(
        in self,
        id: u32,
        in effs: ChunkSeq[EffNode],
        in args: ChunkSeq[u32],
        tail: u32
    ) -> bool {
        let row = self.row(id);
        if row.tail != tail || w(row.n) != effs.len() {
            return false;
        }
        for i in 0..effs.len() {
            let stored_eff = self.effect_at(add(w(row.a), i));
            let new_eff = match effs.try_get(i) {
                Option::Some(eff) => eff,
                Option::None => EffNode { label: 0, name: 0, a: 0, n: 0 },
            };
            if stored_eff.label != new_eff.label
                || stored_eff.name != new_eff.name
                || stored_eff.n != new_eff.n
            {
                return false;
            }
            for j in 0..w(stored_eff.n) {
                if u32_at(in self.items, add(w(stored_eff.a), j))
                    != u32_at(in args, add(w(new_eff.a), j))
                {
                    return false;
                }
            }
        }
        true
    }

    fn grow_rows(inout self) {
        let cap = wrapping_mul(add(self.row_mask, 1), 2);
        let mut slots = zero_slots(cap);
        let mask = wrapping_sub(cap, 1);
        for id in 0..self.row_hashes.len() {
            let mut probe = u64_at(in self.row_hashes, id) & mask;
            loop {
                if u32_at(in slots, probe) == 0 {
                    break;
                }
                probe = inc(probe) & mask;
            }
            let ok = slots.try_set(probe, n32(inc(id)));
        }
        self.row_slots = slots;
        self.row_mask = mask;
    }
}

// ----- Display and Debug -----------------------------------------------------

fn push_text(inout out: ChunkSeq[u8], in s: Str) {
    out.extend(in s.as_bytes());
}

// `impl Display for Type`.
pub fn display(in types: Types, in names: Names, ty: u32, inout out: ChunkSeq[u8]) {
    let node = types.node(ty);
    match node.kind {
        0 => {
            push_text(inout out, "integer literal ");
            push_literal(inout out, node);
        }
        1 => {
            if node.name == types.s_dyn && node.n == 1 {
                push_text(inout out, "dyn ");
                display(in types, in names, types.arg(ty, 0), inout out);
            } else {
                names.write(node.name, inout out);
                if node.n > 0 {
                    out.push(91);
                    display_list(in types, in names, ty, inout out);
                    out.push(93);
                }
            }
        }
        2 => {
            out.push(40);
            display_list(in types, in names, ty, inout out);
            out.push(41);
        }
        3 => {
            push_text(inout out, "fn(");
            display_list(in types, in names, ty, inout out);
            push_text(inout out, ") -> ");
            display(in types, in names, node.r, inout out);
        }
        4 => {
            push_text(inout out, "eff ");
            debug_row(in types, in names, node.r2, inout out);
        }
        _ => {
            out.push(95);
        }
    }
}

fn display_list(in types: Types, in names: Names, ty: u32, inout out: ChunkSeq[u8]) {
    let node = types.node(ty);
    for i in 0..w(node.n) {
        if i > 0 {
            push_text(inout out, ", ");
        }
        display(in types, in names, u32_at(in types.items, add(w(node.a), i)), inout out);
    }
}

fn debug_name(in names: Names, sym: u32, inout out: ChunkSeq[u8]) {
    out.push(34);
    names.write(sym, inout out);
    out.push(34);
}

fn debug_mode(mode: u8, inout out: ChunkSeq[u8]) {
    match mode {
        0 => push_text(inout out, "Copy"),
        1 => push_text(inout out, "Affine"),
        _ => push_text(inout out, "Linear"),
    }
}

fn debug_pass(pass: u8, inout out: ChunkSeq[u8]) {
    match pass {
        0 => push_text(inout out, "In"),
        1 => push_text(inout out, "Inout"),
        _ => push_text(inout out, "Sink"),
    }
}

// `{:?}` of `Effects`.
pub fn debug_row(in types: Types, in names: Names, row_id: u32, inout out: ChunkSeq[u8]) {
    let row = types.row(row_id);
    push_text(inout out, "Effects { instances: [");
    for i in 0..w(row.n) {
        if i > 0 {
            push_text(inout out, ", ");
        }
        let eff = types.effect_at(add(w(row.a), i));
        push_text(inout out, "Effect { label: ");
        if eff.label == 0 {
            push_text(inout out, "None");
        } else {
            push_text(inout out, "Some(");
            debug_name(in names, wrapping_sub(eff.label, 1), inout out);
            out.push(41);
        }
        push_text(inout out, ", name: ");
        debug_name(in names, eff.name, inout out);
        push_text(inout out, ", args: [");
        for j in 0..w(eff.n) {
            if j > 0 {
                push_text(inout out, ", ");
            }
            debug_type(in types, in names, u32_at(in types.items, add(w(eff.a), j)), inout out);
        }
        push_text(inout out, "] }");
    }
    push_text(inout out, "], tail: ");
    if row.tail == 0 {
        push_text(inout out, "None");
    } else {
        push_text(inout out, "Some(");
        debug_name(in names, wrapping_sub(row.tail, 1), inout out);
        out.push(41);
    }
    push_text(inout out, " }");
}

// `{:?}` of `Type`.
pub fn debug_type(in types: Types, in names: Names, ty: u32, inout out: ChunkSeq[u8]) {
    let node = types.node(ty);
    match node.kind {
        0 => {
            push_text(inout out, "IntLiteral(");
            push_literal(inout out, node);
            out.push(41);
        }
        1 => {
            push_text(inout out, "Named(");
            debug_name(in names, node.name, inout out);
            push_text(inout out, ", [");
            debug_list(in types, in names, ty, inout out);
            push_text(inout out, "])");
        }
        2 => {
            push_text(inout out, "Tuple([");
            debug_list(in types, in names, ty, inout out);
            push_text(inout out, "])");
        }
        3 => {
            push_text(inout out, "Function { params: [");
            for i in 0..w(node.n) {
                if i > 0 {
                    push_text(inout out, ", ");
                }
                out.push(40);
                debug_pass(types.param_pass(ty, i), inout out);
                push_text(inout out, ", ");
                debug_type(in types, in names, types.arg(ty, i), inout out);
                out.push(41);
            }
            push_text(inout out, "], result: ");
            debug_type(in types, in names, node.r, inout out);
            push_text(inout out, ", effects: ");
            debug_row(in types, in names, node.r2, inout out);
            push_text(inout out, ", mode: ");
            debug_mode(node.mode, inout out);
            push_text(inout out, " }");
        }
        4 => {
            push_text(inout out, "Row(");
            debug_row(in types, in names, node.r2, inout out);
            out.push(41);
        }
        _ => push_text(inout out, "Infer"),
    }
}

fn debug_list(in types: Types, in names: Names, ty: u32, inout out: ChunkSeq[u8]) {
    let node = types.node(ty);
    for i in 0..w(node.n) {
        if i > 0 {
            push_text(inout out, ", ");
        }
        debug_type(in types, in names, u32_at(in types.items, add(w(node.a), i)), inout out);
    }
}

// ----- substitute and default_type --------------------------------------------

// A substitution `vars`: generic name symbols and their types, in pairs.
pub struct Vars {
    keys: ChunkSeq[u32],
    vals: ChunkSeq[u32],
}

pub fn vars_new() -> Vars {
    Vars { keys: ChunkSeq::new[u32](), vals: ChunkSeq::new[u32]() }
}

impl Vars {
    pub fn get(in self, key: u32) -> u32 {
        for i in 0..self.keys.len() {
            if u32_at(in self.keys, i) == key {
                return u32_at(in self.vals, i);
            }
        }
        NONE32
    }

    // BTreeMap::insert: a later key replaces an earlier one.
    pub fn set(inout self, key: u32, value: u32) {
        for i in 0..self.keys.len() {
            if u32_at(in self.keys, i) == key {
                let ok = self.vals.try_set(i, value);
                return;
            }
        }
        self.keys.push(key);
        self.vals.push(value);
    }

    pub fn is_empty(in self) -> bool {
        self.keys.len() == 0
    }
}

// `ast::substitute`. There is no shortcut for an empty substitution: Rust
// still runs `substitute_effects` on every function row, which drops
// repeated instances.
pub fn substitute(inout types: Types, ty: u32, in vars: Vars) -> u32 {
    let node = types.node(ty);
    if node.kind == TyKind::Named {
        if node.n == 0 {
            let bound = vars.get(node.name);
            if bound != NONE32 {
                return bound;
            }
            return ty;
        }
        let mut args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](w(node.n));
        for i in 0..w(node.n) {
            let arg = u32_at(in types.items, add(w(node.a), i));
            let subst = substitute(inout types, arg, in vars);
            args.push(subst);
        }
        return types.mk(TyKind::Named, 0, node.name, in args, 0, 0, 0);
    }
    if node.kind == TyKind::Tuple {
        if node.n == 0 {
            return ty;
        }
        let mut args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](w(node.n));
        for i in 0..w(node.n) {
            let arg = u32_at(in types.items, add(w(node.a), i));
            let subst = substitute(inout types, arg, in vars);
            args.push(subst);
        }
        return types.tuple(in args);
    }
    if node.kind == TyKind::Fn {
        let mut args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](w(node.n));
        let mut passes: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](w(node.n));
        for i in 0..w(node.n) {
            let item_index = add(w(node.a), i);
            let arg = u32_at(in types.items, item_index);
            passes.push(u8_at(in types.passes, item_index));
            let subst = substitute(inout types, arg, in vars);
            args.push(subst);
        }
        let result = substitute(inout types, node.r, in vars);
        let row = substitute_row(inout types, node.r2, in vars);
        return types.mk_with(TyKind::Fn, node.mode, 0, in args, in passes, result, row, 0);
    }
    ty
}

// `ast::substitute_effects`: arguments substituted, an open tail bound to
// a row variable spliced in, duplicates removed (first wins).
pub fn substitute_row(inout types: Types, row_id: u32, in vars: Vars) -> u32 {
    let row = types.row(row_id);
    let mut effs: ChunkSeq[EffNode] = ChunkSeq::new[EffNode]();
    let mut args: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..w(row.n) {
        let eff = types.effect_at(add(w(row.a), i));
        let arg_start = n32(args.len());
        for j in 0..w(eff.n) {
            let arg = u32_at(in types.items, add(w(eff.a), j));
            let subst = substitute(inout types, arg, in vars);
            args.push(subst);
        }
        push_unique(
            in types,
            inout effs,
            in args,
            EffNode { label: eff.label, name: eff.name, a: arg_start, n: eff.n }
        );
    }
    let mut tail = row.tail;
    if row.tail != 0 {
        let bound = vars.get(wrapping_sub(row.tail, 1));
        if bound != NONE32 && types.kind(bound) == TyKind::Row {
            let inner = types.row(types.node(bound).r2);
            for i in 0..w(inner.n) {
                let eff = types.effect_at(add(w(inner.a), i));
                let arg_start = n32(args.len());
                for j in 0..w(eff.n) {
                    args.push(u32_at(in types.items, add(w(eff.a), j)));
                }
                push_unique(
                    in types,
                    inout effs,
                    in args,
                    EffNode { label: eff.label, name: eff.name, a: arg_start, n: eff.n }
                );
            }
            tail = inner.tail;
        }
    }
    types.mk_row(in effs, in args, tail)
}

// Keeps the first of equal (label, name, args) instances. Rust compares
// the arguments' Display strings; equal ids imply equal strings, and the
// census corpus has no instance where distinct types print alike.
fn push_unique(
    in types: Types,
    inout effs: ChunkSeq[EffNode],
    in args: ChunkSeq[u32],
    eff: EffNode
) {
    for i in 0..effs.len() {
        let kept = match effs.try_get(i) {
            Option::Some(kept) => kept,
            Option::None => EffNode { label: 0, name: 0, a: 0, n: 0 },
        };
        if kept.label == eff.label && kept.name == eff.name && kept.n == eff.n {
            let mut same = true;
            for j in 0..w(eff.n) {
                if u32_at(in args, add(w(kept.a), j)) != u32_at(in args, add(w(eff.a), j)) {
                    same = false;
                }
            }
            if same {
                return;
            }
        }
    }
    effs.push(eff);
}

// `numeric::default_type`: integer literals take `IntegerKind::default_for`:
// i128 past u64::MAX or below i64::MIN, u64 above i64::MAX, else i64.
pub fn default_type(inout types: Types, ty: u32) -> u32 {
    let node = types.node(ty);
    if node.kind == TyKind::Lit {
        let lo = wrapping_u64(node.lit);
        let wide = literal_hi(node) != 0;
        if wide || (node.mode == 1 && lo > I64_MIN_MAGNITUDE) {
            return types.named0(types.s_i128);
        }
        if node.mode == 0 && lo > I64_MAX_U64 {
            return types.named0(types.s_u64);
        }
        return types.named0(types.s_i64);
    }
    if node.kind == TyKind::Named || node.kind == TyKind::Tuple {
        if node.n == 0 {
            return ty;
        }
        let mut args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](w(node.n));
        for i in 0..w(node.n) {
            let arg = u32_at(in types.items, add(w(node.a), i));
            let defaulted = default_type(inout types, arg);
            args.push(defaulted);
        }
        return types.mk(node.kind, 0, node.name, in args, 0, 0, 0);
    }
    if node.kind == TyKind::Fn {
        let mut args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](w(node.n));
        let mut passes: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](w(node.n));
        for i in 0..w(node.n) {
            let item_index = add(w(node.a), i);
            passes.push(u8_at(in types.passes, item_index));
            let defaulted = default_type(inout types, u32_at(in types.items, item_index));
            args.push(defaulted);
        }
        let result = default_type(inout types, node.r);
        let row = default_row(inout types, node.r2);
        return types.mk_with(TyKind::Fn, node.mode, 0, in args, in passes, result, row, 0);
    }
    ty
}

fn default_row(inout types: Types, row_id: u32) -> u32 {
    let row = types.row(row_id);
    let mut effs: ChunkSeq[EffNode] = ChunkSeq::new[EffNode]();
    let mut args: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..w(row.n) {
        let eff = types.effect_at(add(w(row.a), i));
        let arg_start = n32(args.len());
        for j in 0..w(eff.n) {
            let defaulted = default_type(inout types, u32_at(in types.items, add(w(eff.a), j)));
            args.push(defaulted);
        }
        effs.push(EffNode { label: eff.label, name: eff.name, a: arg_start, n: eff.n });
    }
    types.mk_row(in effs, in args, row.tail)
}

// The high word of a literal's magnitude (`wide_literal`).
pub fn literal_hi(node: TypeNode) -> u64 {
    widen_u64(node.r) | (widen_u64(node.r2) << HALF_WORD_BITS)
}

fn push_literal(inout out: ChunkSeq[u8], node: TypeNode) {
    if node.mode == 1 {
        out.push(45);
    }
    push_wide_decimal(inout out, literal_hi(node), wrapping_u64(node.lit));
}

// The decimal digits of the 128-bit value `hi * 2^64 + lo`.
pub fn push_wide_decimal(inout out: ChunkSeq[u8], hi: u64, lo: u64) {
    if hi == 0 {
        push_decimal(inout out, lo);
        return;
    }
    // Divide by ten a 32-bit digit at a time: each partial dividend is
    // below 10 * 2^32, so it fits a u64.
    let q_hi = hi / DECIMAL_BASE;
    let r_hi = hi % DECIMAL_BASE;
    let upper = (r_hi << HALF_WORD_BITS) | (lo >> HALF_WORD_BITS);
    let q_upper = upper / DECIMAL_BASE;
    let lower = ((upper % DECIMAL_BASE) << HALF_WORD_BITS) | (lo & HALF_WORD_MASK);
    let q_lower = lower / DECIMAL_BASE;
    let digit = lower % DECIMAL_BASE;
    push_wide_decimal(inout out, q_hi, (q_upper << HALF_WORD_BITS) | q_lower);
    out.push(wrapping_u8(wrapping_add(digit, ASCII_ZERO)));
}
