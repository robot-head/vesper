load("//tools/bazel:vesper_port.bzl", "vesper_package")

# @vesper/cranelift (#1126): the `.vsys` library and wrappers that
# crates/vesper-cranelift-sys's tests load.
filegroup(
    name = "files",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
    visibility = ["//visibility:public"],
)

# The package as a path dependency of port builds: @vesper/codegen-base
# and the hybrid compiler's codegen module (#1275).
vesper_package(
    name = "cranelift_package",
    srcs = glob(["src/**/*.ves"]),
    manifest = "Loom.toml",
    visibility = ["//visibility:public"],
    vsys = ["cranelift.vsys"],
)
