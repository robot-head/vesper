// ---------------------------------------------------------------------------
// Instructions, by shape. `binary`/`binary_imm`/`unary`/`convert` take the
// opcode codes of codes.rs; the named wrappers below cover the compiler's
// instruction set (the inventory in
// docs/parallel-results/self-host-cranelift-shim.md).

pub fn ins_binary(inout b: Builder, op: u32, x: Value, y: Value) -> Value eff [Ffi[Cranelift]] {
    Value {
        id: Cranelift::vcl_binary(inout b, op, x.id, y.id)
    }
}
