    Value {
        id: Cranelift::vcl_binary_imm(inout b, op, x.id, imm)
    }
}
pub fn ins_unary(inout b: Builder, op: u32, x: Value) -> Value eff [Ffi[Cranelift]] {
    Value {
        id: Cranelift::vcl_unary(inout b, op, x.id)
    }
}
pub fn ins_convert(inout b: Builder, op: u32, ty: Ty, x: Value) -> Value eff [Ffi[Cranelift]] {
    Value {
        id: Cranelift::vcl_convert(inout b, op, ty.code, x.id)
    }
}
pub fn ins_overflow(inout b: Builder, op: u32, x: Value, y: Value) -> Value eff [Ffi[Cranelift]] {
    Value {
        id: Cranelift::vcl_overflow(inout b, op, x.id, y.id)
    }
}

