// |     fn vcl_overflow(inout b: Builder, op: u32, x: u32, y: u32) -> ForeignVal[u32];
// |     fn vcl_icmp(inout b: Builder, cc: u32, x: u32, y: u32) -> ForeignVal[u32];
// |     fn vcl_icmp_imm(inout b: Builder, cc: u32, x: u32, imm: i64) -> ForeignVal[u32];
// |     fn vcl_fcmp(inout b: Builder, cc: u32, x: u32, y: u32) -> ForeignVal[u32];
// |     fn vcl_load(inout b: Builder, op: u32, ty: u32, flags: u32, addr: u32, offset: i32) -> ForeignVal[u32];
// |     fn vcl_store(inout b: Builder, op: u32, flags: u32, x: u32, addr: u32, offset: i32) -> ForeignVal[Unit];
// |     fn vcl_stack_addr(inout b: Builder, ty: u32, slot: u32, offset: i32) -> ForeignVal[u32];
// |     fn vcl_stack_load(inout b: Builder, ty: u32, slot: u32, offset: i32) -> ForeignVal[u32];
// |     fn vcl_stack_store(inout b: Builder, x: u32, slot: u32, offset: i32) -> ForeignVal[Unit];
// |     fn vcl_extractlane(inout b: Builder, x: u32, lane: u32) -> ForeignVal[u32];
// |     fn vcl_insertlane(inout b: Builder, x: u32, y: u32, lane: u32) -> ForeignVal[u32];
// |     fn vcl_vconst(inout b: Builder, ty: u32, nocapture in bytes: CSlice[u8]) -> ForeignVal[u32];
// |     fn vcl_shuffle(inout b: Builder, x: u32, y: u32, nocapture in mask: CSlice[u8]) -> ForeignVal[u32];
// |     fn vcl_atomic_rmw(inout b: Builder, op: u32, ty: u32, flags: u32, addr: u32, x: u32) -> ForeignVal[u32];
// |     fn vcl_atomic_load(inout b: Builder, ty: u32, flags: u32, addr: u32) -> ForeignVal[u32];
// |     fn vcl_atomic_store(inout b: Builder, flags: u32, x: u32, addr: u32) -> ForeignVal[Unit];
// |     fn vcl_func_addr(inout b: Builder, ty: u32, fref: u32) -> ForeignVal[u32];
// |     fn vcl_symbol_value(inout b: Builder, ty: u32, gv: u32) -> ForeignVal[u32];
// |     fn vcl_global_value(inout b: Builder, ty: u32, gv: u32) -> ForeignVal[u32];
// |     fn vcl_get_stack_pointer(inout b: Builder, ty: u32) -> ForeignVal[u32];
// |     fn vcl_call(inout b: Builder, fref: u32, nocapture in args: CSlice[u32]) -> ForeignVal[u32];
// |     fn vcl_call_indirect(inout b: Builder, sigref: u32, callee: u32, nocapture in args: CSlice[u32]) -> ForeignVal[u32];
// |     fn vcl_return_call(inout b: Builder, fref: u32, nocapture in args: CSlice[u32]) -> ForeignVal[Unit];
// |     fn vcl_jump(inout b: Builder, blk: u32, nocapture in args: CSlice[u32]) -> ForeignVal[Unit];
// |     fn vcl_brif(inout b: Builder, c: u32, then_blk: u32, nocapture in then_args: CSlice[u32], else_blk: u32, nocapture in else_args: CSlice[u32]) -> ForeignVal[Unit];
// |     fn vcl_return(inout b: Builder, nocapture in vals: CSlice[u32]) -> ForeignVal[Unit];
// |     fn vcl_trap(inout b: Builder, code: u32) -> ForeignVal[Unit];
// |     fn vcl_trap_if(inout b: Builder, c: u32, if_nonzero: bool, code: u32) -> ForeignVal[Unit];
// |     fn vcl_emit(inout b: Builder, nocapture in code: CSlice[u64], nocapture inout out: CSlice[u32]) -> ForeignVal[u32];
// |     fn vcl_jit_module_new(nocapture in flags: CSlice[u8], nocapture in symbols: CSlice[u8], nocapture in addrs: CSlice[u64]) -> ForeignVal[Option[Module]];
// |     fn vcl_module_finalize(inout m: Module) -> ForeignVal[u32];
// |     fn vcl_function_address(inout m: Module, func: u32) -> ForeignVal[u64];
// |     fn vcl_module_function_count(in m: Module) -> ForeignVal[u32];
// |     fn vcl_module_function_name(in m: Module, func: u32, nocapture inout out: CSlice[u8]) -> ForeignVal[u64];
// |     fn vcl_module_get_function(inout m: Module, nocapture in name: CSlice[u8]) -> ForeignVal[u32];
// |     fn vcl_module_get_data(inout m: Module, nocapture in name: CSlice[u8]) -> ForeignVal[u32];
// |     fn vcl_module_kind(in m: Module) -> ForeignVal[u32];
// |     fn vcl_compile(inout m: Module, sink b: Builder) -> ForeignVal[u64];
// |     fn vcl_module_last_code(in m: Module, offset: u64, nocapture inout out: CSlice[u8]) -> ForeignVal[u64];
// |     fn vcl_module_last_unwind(in m: Module, nocapture inout out: CSlice[u8]) -> ForeignVal[u64];
// |     fn vcl_module_last_traps(in m: Module, nocapture inout out: CSlice[u64]) -> ForeignVal[u64];
// |     fn vcl_import_data_colocated(inout b: Builder, in m: Module, data: u32, colocated: bool) -> ForeignVal[u32];
// |     fn vcl_set_srcloc(inout b: Builder, loc: u32) -> ForeignVal[Unit];
// |     fn vcl_set_cold_block(inout b: Builder, blk: u32) -> ForeignVal[Unit];
// |     fn vcl_current_block(inout b: Builder) -> ForeignVal[u32];
// |     fn vcl_set_func_name(inout b: Builder, ns: u32, index: u32) -> ForeignVal[Unit];
// |     fn vcl_import_function_colocated(inout b: Builder, inout m: Module, func: u32, colocated: bool) -> ForeignVal[u32];
// |     fn vcl_switch(inout b: Builder, x: u32, otherwise: u32, nocapture in indices: CSlice[u64], nocapture in blocks: CSlice[u32]) -> ForeignVal[Unit];
// |     fn vcl_call_op(call: u64) -> ForeignVal[u32];
// |     fn vcl_call_arg_count(call: u64) -> ForeignVal[u64];
// |     fn vcl_call_arg(call: u64, i: u64) -> ForeignVal[u64];
// |     fn vcl_call_args(call: u64, nocapture inout out: CSlice[u64]) -> ForeignVal[u64];
// |     fn vcl_call_result(call: u64, w: u64) -> ForeignVal[Unit];
// |     fn vcl_call_builder(call: u64) -> ForeignVal[Option[Builder]];
// |     fn vcl_call_module(call: u64) -> ForeignVal[Option[Module]];
// |     fn vcl_call_return_builder(call: u64, sink b: Builder) -> ForeignVal[Unit];
// |     fn vcl_call_return_module(call: u64, sink m: Module) -> ForeignVal[Unit];
// | }
//
// @vesper/cranelift: Cranelift 0.125 from Vesper (self-hosting wave SH0,
// lane 4, #1126). Cranelift stays a vetted external library behind the C
// shim crates/vesper-cranelift-sys (owner decision, 2026-11-19); this
// package is the `.vsys` library above and typed wrappers that read like
// the compiler's Rust lowering:
//
//     let x = block_param(inout b, entry, 0);
//     let y = ins_iadd_imm(inout b, x, 1);
//     ins_return1(inout b, y);
//
// Handles: `Module`, `Builder`, `Data` and `Object` are linear, so the
// checker makes every path finalize each one exactly once: a builder is
// consumed by `define_function` (or `builder_free`), a data description by
// `define_data`, a module by `module_finish` (or `module_free`) and an
// object by `object_publish`, `object_free` or the caller's copy.
//
// Everything else is a copy struct around Cranelift's own entity number or
// the shim's code (crates/vesper-cranelift-sys/src/codes.rs), so values and
// blocks are numbered the same as in a Rust lowering. A failed call returns
// the invalid number (`is_invalid`) and records a sticky error on the
// builder or module; `define_function` then reports it.

pub copy struct Value {
    id: u32,
}
pub copy struct Block {
    id: u32,
}
pub copy struct Ty {
    code: u32,
}
pub copy struct Var {
    id: u32,
}
pub copy struct Slot {
    id: u32,
}
pub copy struct FuncRef {
    id: u32,
}
pub copy struct SigRef {
    id: u32,
}
pub copy struct GlobalValue {
    id: u32,
}
pub copy struct FuncId {
    id: u32,
}
pub copy struct DataId {
    id: u32,
}
pub copy struct SigId {
    id: u32,
}

pub fn invalid() -> u32 {
    4294967295
}
pub fn is_invalid(v: Value) -> bool {
    v.id == invalid()
}

// ---------------------------------------------------------------------------
// Types (`lane | log2(lanes) << 8`).

pub fn ty_i8() -> Ty {
    Ty {
        code: 1
    }
}
pub fn ty_i16() -> Ty {
    Ty {
        code: 2
    }
}
pub fn ty_i32() -> Ty {
    Ty {
        code: 3
    }
}
pub fn ty_i64() -> Ty {
    Ty {
        code: 4
    }
}
pub fn ty_i128() -> Ty {
    Ty {
        code: 5
    }
}
pub fn ty_f32() -> Ty {
    Ty {
        code: 6
    }
}
pub fn ty_f64() -> Ty {
    Ty {
        code: 7
    }
}
// `lanes_log2` of 4 makes I8X16 from I8.
pub fn ty_vector(lane: Ty, lanes_log2: u32) -> Ty {
    Ty {
        code: lane.code | (lanes_log2 << 8)
    }
}

// ---------------------------------------------------------------------------
// Linkage, calling conventions, condition codes, memory flags, traps.

pub fn linkage_import() -> u32 {
    0
}
pub fn linkage_local() -> u32 {
    1
}
pub fn linkage_preemptible() -> u32 {
    2
}
pub fn linkage_hidden() -> u32 {
    3
}
pub fn linkage_export() -> u32 {
    4
}
pub fn call_conv_default() -> u32 {
    0
}
pub fn call_conv_system_v() -> u32 {
    1
}
pub fn call_conv_windows_fastcall() -> u32 {
    2
}
pub fn call_conv_apple_aarch64() -> u32 {
    3
}
pub fn call_conv_tail() -> u32 {
    4
}

pub fn cc_eq() -> u32 {
    0
}
pub fn cc_ne() -> u32 {
    1
}
pub fn cc_slt() -> u32 {
    2
}
pub fn cc_sge() -> u32 {
    3
}
pub fn cc_sgt() -> u32 {
    4
}
pub fn cc_sle() -> u32 {
    5
}
pub fn cc_ult() -> u32 {
    6
}
pub fn cc_uge() -> u32 {
    7
}
pub fn cc_ugt() -> u32 {
    8
}
pub fn cc_ule() -> u32 {
    9
}

pub fn mem_notrap() -> u32 {
    1
}
pub fn mem_aligned() -> u32 {
    2
}
pub fn mem_readonly() -> u32 {
    4
}
// `MemFlags::trusted()`: notrap and aligned.
pub fn mem_trusted() -> u32 {
    3
}

pub fn trap_stack_overflow() -> u32 {
    1
}
pub fn trap_integer_overflow() -> u32 {
    2
}
pub fn trap_heap_out_of_bounds() -> u32 {
    3
}
pub fn trap_integer_division_by_zero() -> u32 {
    4
}
// `TrapCode::user(n)`.
pub fn trap_user(n: u32) -> u32 {
    wrapping_add(16, n)
}

// ---------------------------------------------------------------------------
// Modules.

// An object module for `triple` (empty: the host) with Cranelift flags
// (`key=value` separated by `;`), or None (`new_error_len` says why).
pub fn module_new(in triple: Slice[u8], in flags: Slice[u8], in name: Slice[u8])
    -> Option[Module] eff [Ffi[Cranelift]] {
    Cranelift::vcl_module_new(in triple, in flags, in name)
}
pub fn new_error_len() -> u64 eff [Ffi[Cranelift]] {
    let mut none: ChunkSeq[u8] = ChunkSeq::new[u8]();
    Cranelift::vcl_new_error(inout none.as_slice_mut())
}
pub fn module_free(sink m: Module) eff [Ffi[Cranelift]] {
    Cranelift::vcl_module_free(m);
}
pub fn module_error_len(in m: Module) -> u64 eff [Ffi[Cranelift]] {
    let mut none: ChunkSeq[u8] = ChunkSeq::new[u8]();
    Cranelift::vcl_module_error(in m, inout none.as_slice_mut())
}
pub fn module_pointer_type(in m: Module) -> Ty eff [Ffi[Cranelift]] {
    Ty {
        code: Cranelift::vcl_module_pointer_type(in m)
    }
}
pub fn module_keep_clif(inout m: Module, keep: bool) eff [Ffi[Cranelift]] {
    Cranelift::vcl_module_keep_clif(inout m, keep);
}
pub fn module_code_bytes(in m: Module) -> u64 eff [Ffi[Cranelift]] {
    Cranelift::vcl_module_code_bytes(in m)
}
pub fn sig_new(inout m: Module, call_conv: u32) -> SigId eff [Ffi[Cranelift]] {
    SigId {
        id: Cranelift::vcl_sig_new(inout m, call_conv)
    }
}
pub fn sig_param(inout m: Module, sig: SigId, ty: Ty) eff [Ffi[Cranelift]] {
    Cranelift::vcl_sig_param(inout m, sig.id, ty.code);
}
pub fn sig_return(inout m: Module, sig: SigId, ty: Ty) eff [Ffi[Cranelift]] {
    Cranelift::vcl_sig_return(inout m, sig.id, ty.code);
}
pub fn declare_function(inout m: Module, in name: Slice[u8], linkage: u32, sig: SigId)
    -> FuncId eff [Ffi[Cranelift]] {
    FuncId {
        id: Cranelift::vcl_declare_function(inout m, in name, linkage, sig.id)
    }
}
pub fn declare_data(inout m: Module, in name: Slice[u8], linkage: u32, writable: bool)
    -> DataId eff [Ffi[Cranelift]] {
    DataId {
        id: Cranelift::vcl_declare_data(inout m, in name, linkage, writable, false)
    }
}
// Compile and define `func` from `b`; false if it failed
// (`module_error_len`).
pub fn define_function(inout m: Module, func: FuncId, sink b: Builder)
    -> bool eff [Ffi[Cranelift]] {
    Cranelift::vcl_define_function(inout m, func.id, b) == 0
}
pub fn define_data(inout m: Module, data: DataId, sink d: Data) -> bool eff [Ffi[Cranelift]] {
    Cranelift::vcl_define_data(inout m, data.id, d) == 0
}
// Emit the object, or None (`new_error_len`).
pub fn module_finish(sink m: Module) -> Option[Object] eff [Ffi[Cranelift]] {
    Cranelift::vcl_module_finish(m)
}

// ---------------------------------------------------------------------------
// Objects.

pub fn object_len(in o: Object) -> u64 eff [Ffi[Cranelift]] {
    Cranelift::vcl_object_len(in o)
}
// The object's bytes, copied into a sequence; the object is freed.
pub fn object_bytes(sink o: Object) -> ChunkSeq[u8] eff [Ffi[Cranelift]] {
    let n = Cranelift::vcl_object_len(in o);
    let mut out: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](n);
    for _ in 0..n {
        out.push(0);
    }
    Cranelift::vcl_object_read(in o, 0, inout out.as_slice_mut());
    Cranelift::vcl_object_free(o);
    out
}
// Hand the object to the Rust host (`vesper_cranelift_sys::take_published`).
pub fn object_publish(sink o: Object) -> u64 eff [Ffi[Cranelift]] {
    Cranelift::vcl_object_publish(o)
}
pub fn object_free(sink o: Object) eff [Ffi[Cranelift]] {
    Cranelift::vcl_object_free(o);
}

// ---------------------------------------------------------------------------
// Data descriptions.

pub fn data_new() -> Option[Data] eff [Ffi[Cranelift]] {
    Cranelift::vcl_data_new()
}
pub fn data_free(sink d: Data) eff [Ffi[Cranelift]] {
    Cranelift::vcl_data_free(d);
}
pub fn data_define(inout d: Data, in bytes: Slice[u8]) eff [Ffi[Cranelift]] {
    Cranelift::vcl_data_define(inout d, in bytes);
}
pub fn data_zeroinit(inout d: Data, size: u64) eff [Ffi[Cranelift]] {
    Cranelift::vcl_data_zeroinit(inout d, size);
}
pub fn data_align(inout d: Data, align: u64) eff [Ffi[Cranelift]] {
    Cranelift::vcl_data_align(inout d, align);
}
pub fn data_func_addr(inout d: Data, in m: Module, offset: u32, func: FuncId) eff [Ffi[Cranelift]] {
    Cranelift::vcl_data_func_addr(inout d, in m, offset, func.id);
}
pub fn data_data_addr(inout d: Data, in m: Module, offset: u32, data: DataId, addend: i64) eff [
    Ffi[Cranelift]
] {
    Cranelift::vcl_data_data_addr(inout d, in m, offset, data.id, addend);
}

// ---------------------------------------------------------------------------
// Builders.

pub fn builder_new(in m: Module, sig: SigId) -> Option[Builder] eff [Ffi[Cranelift]] {
    Cranelift::vcl_builder_new(in m, sig.id)
}
pub fn builder_free(sink b: Builder) eff [Ffi[Cranelift]] {
    Cranelift::vcl_builder_free(b);
}
pub fn builder_error_len(in b: Builder) -> u64 eff [Ffi[Cranelift]] {
    let mut none: ChunkSeq[u8] = ChunkSeq::new[u8]();
    Cranelift::vcl_builder_error(in b, inout none.as_slice_mut())
}
pub fn import_function(inout b: Builder, inout m: Module, func: FuncId)
    -> FuncRef eff [Ffi[Cranelift]] {
    FuncRef {
        id: Cranelift::vcl_import_function(inout b, inout m, func.id)
    }
}
pub fn import_signature(inout b: Builder, in m: Module, sig: SigId) -> SigRef eff [Ffi[Cranelift]] {
    SigRef {
        id: Cranelift::vcl_import_signature(inout b, in m, sig.id)
    }
}
pub fn import_data(inout b: Builder, in m: Module, data: DataId)
