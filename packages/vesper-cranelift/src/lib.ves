// Memory. `op` 1 is `load`; 2-7 are uload8, sload8, uload16, sload16,
// uload32, sload32. Stores: 1 store, 2 istore8, 3 istore16, 4 istore32.
pub fn ins_load(inout b: Builder, ty: Ty, flags: u32, addr: Value, offset: i32)
    -> Value eff [Ffi[Cranelift]] {
    Value {
        id: Cranelift::vcl_load(inout b, 1, ty.code, flags, addr.id, offset)
    }
}
