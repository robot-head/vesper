// @vesper-std/env: the process's arguments, environment variables and
// current directory (self-hosting SH0 lane 3, #1125), over the `.vsys`
// library `StdEnv`: the C library itself (env-@OS@.vsys, SH6 lane 13,
// #1408). Every operation performs `Ffi[StdEnv]`. Text comes back as
// `String` when it is UTF-8 and as bytes from the `*_bytes` variants (Unix
// allows any bytes; Windows text is UTF-16 converted to UTF-8).
use @vesper-std/fs::{IoError, raise_kind};

// The word of `size` bytes (at most 8, little-endian) at `address`, or 0
// for a `NULL` address.
fn word(address: u64, size: u64) -> u64 eff [Ffi[StdEnv]] {
    if address == 0 {
        return 0;
    }
    let mut w: u64 = 0;
    let _ = StdEnv::read_word(inout w, address, size);
    w
}

// The address of the C function `name` of the process, `None` when there
// is none.
fn function(in name: Str) -> Option[AddressFn] eff [Ffi[StdEnv]] {
    match StdEnv::dlsym_function(StdEnv::RTLD_DEFAULT, in name.as_bytes()) {
        Result::Ok(f) => f,
        Result::Err(_) => Option::None,
    }
}

// The address of the C variable `name` of the process, or 0.
fn variable(in name: Str) -> u64 eff [Ffi[StdEnv]] {
    match StdEnv::dlsym(StdEnv::RTLD_DEFAULT, in name.as_bytes()) {
        Result::Ok(a) => a,
        Result::Err(_) => 0,
    }
}

// `(argc, argv)`: Apple's `_NSGetArgc` and `_NSGetArgv`, else glibc's
// stack top `__libc_stack_end`, where argc is followed by argv.
fn arguments() -> (u64, u64) eff [Ffi[StdEnv]] {
    match function(in "_NSGetArgv") {
        Option::Some(argv) => {
            let argc = match function(in "_NSGetArgc") {
                Option::Some(f) => word(StdEnv::AddressFn(f), 4),
                Option::None => 0,
            };
            (argc, word(StdEnv::AddressFn(argv), 8))
        }
        Option::None => {
            let top = word(variable(in "__libc_stack_end"), 8);
            if top == 0 {
                return (0, 0);
            }
            (word(top, 8), wrapping_add(top, 8))
        }
    }
}

// The NULL-terminated `environ` array now (`setenv` may move it).
fn environment() -> u64 eff [Ffi[StdEnv]] {
    match function(in "_NSGetEnviron") {
        Option::Some(f) => word(StdEnv::AddressFn(f), 8),
        Option::None => word(variable(in "environ"), 8),
    }
}

// Whether byte `i` of `s` is `c`.
fn byte_is(in s: Slice[u8], i: u64, c: u8) -> bool {
    match s.try_get(i) {
        Option::Some(b) => b == c,
        Option::None => false,
    }
}

// A copy of the C string at `address`.
fn c_string(address: u64) -> ChunkSeq[u8] eff [Ffi[StdEnv]] {
    match StdEnv::cstr_at(address, in "".as_bytes()) {
        Result::Ok(Option::Some(s)) => s,
        _ => ChunkSeq::new[u8](),
    }
}

// The number of arguments, the program name (argument 0) included.
pub fn arg_count() -> u64 eff [Ffi[StdEnv]] {
    let (argc, _) = arguments();
    argc
}

// Argument `i` as bytes, `None` past the last.
pub fn arg_bytes(i: u64) -> Option[ChunkSeq[u8]] eff [Ffi[StdEnv]] {
    let (argc, argv) = arguments();
    if i >= argc {
        return Option::None;
    }
    let p = word(wrapping_add(argv, wrapping_mul(i, 8)), 8);
    if p == 0 {
        return Option::None;
    }
    Option::Some(c_string(p))
}

// Argument `i` as text, `None` past the last or when it is not UTF-8.
pub fn arg(i: u64) -> Option[String] eff [Ffi[StdEnv]] {
    match arg_bytes(i) {
        Option::Some(b) => String::from_utf8(in b.as_slice()),
        Option::None => Option::None,
    }
}

// Variable `key` as bytes, `None` when it is unset (or `key` is empty or
// holds `=` or NUL).
pub fn var_bytes(in key: Str) -> Option[ChunkSeq[u8]] eff [Ffi[StdEnv]] {
    let k = key.as_bytes();
    if k.len() == 0 {
        return Option::None;
    }
    for i in 0..k.len() {
        if byte_is(in k, i, 61) {
            return Option::None;
        }
    }
    match StdEnv::getenv(in k) {
        Result::Ok(v) => v,
        Result::Err(_) => Option::None,
    }
}

// Variable `key` as text, `None` when it is unset or not UTF-8.
pub fn var(in key: Str) -> Option[String] eff [Ffi[StdEnv]] {
    match var_bytes(in key) {
        Option::Some(b) => String::from_utf8(in b.as_slice()),
        Option::None => Option::None,
    }
}

// Whether the `environ` entry at `p` is a variable: it has a `=` after
// its first byte (as Rust's `std::env::vars_os` reads them).
fn is_variable(p: u64) -> bool eff [Ffi[StdEnv]] {
    if word(p, 1) == 0 {
        return false;
    }
    StdEnv::find_byte(wrapping_add(p, 1), 61) != 0
}

// The address of variable `i`'s `KEY=VALUE` string, or 0 past the last.
fn variable_at(i: u64) -> u64 eff [Ffi[StdEnv]] {
    let table = environment();
    if table == 0 {
        return 0;
    }
    let mut seen: u64 = 0;
    let mut k: u64 = 0;
    loop {
        let p = word(wrapping_add(table, wrapping_mul(k, 8)), 8);
        if p == 0 {
            return 0;
        }
        if is_variable(p) {
            if seen == i {
                return p;
            }
            seen = wrapping_add(seen, 1);
        }
        k = wrapping_add(k, 1);
    }
}

// The number of environment variables.
pub fn var_count() -> u64 eff [Ffi[StdEnv]] {
    let table = environment();
    if table == 0 {
        return 0;
    }
    let mut n: u64 = 0;
    let mut k: u64 = 0;
    loop {
        let p = word(wrapping_add(table, wrapping_mul(k, 8)), 8);
        if p == 0 {
            return n;
        }
        if is_variable(p) {
            n = wrapping_add(n, 1);
        }
        k = wrapping_add(k, 1);
    }
}

// Variable `i` as `KEY=VALUE` bytes, `None` past the last.
pub fn var_at_bytes(i: u64) -> Option[ChunkSeq[u8]] eff [Ffi[StdEnv]] {
    let p = variable_at(i);
    if p == 0 {
        return Option::None;
    }
    Option::Some(c_string(p))
}

// The `IoError` kind of the C library's `errno` value `e`.
fn errno_kind(e: u32) -> u32 {
    if StdEnv::OS == 3 {
        return match e {
            2 => 1,
            3 => 1,
            5 => 2,
            8 => 12,
            14 => 12,
            50 => 11,
            80 => 3,
            87 => 7,
            145 => 6,
            183 => 3,
            267 => 4,
            _ => 13,
        };
    }
    let mac = StdEnv::OS == 2;
    match e {
        1 => 2,
        2 => 1,
        4 => 8,
        12 => 12,
        13 => 2,
        17 => 3,
        20 => 4,
        21 => 5,
        22 => 7,
        39 => if mac { 13 } else { 6 },
        66 => if mac { 6 } else { 13 },
        38 => if mac { 13 } else { 11 },
        78 => if mac { 11 } else { 13 },
        _ => 13,
    }
}

// The path of the running executable (`std::env::current_exe`): on Linux
// the target of `/proc/self/exe`, on macOS `_NSGetExecutablePath`.
pub fn current_exe_bytes() -> ChunkSeq[u8] eff [Ffi[StdEnv], Fail[IoError]] {
    match StdEnv::dlsym_exe_path(StdEnv::RTLD_DEFAULT, in "_NSGetExecutablePath".as_bytes()) {
        Result::Ok(Option::Some(f)) => apple_exe_path(f),
        _ => proc_self_exe(),
    }
}

// `fs::read_link("/proc/self/exe")`: `readlink` into a buffer that doubles
// until the link fits. With no `/proc`, the error `std` gives
// (`Uncategorized`, here `other()`).
fn proc_self_exe() -> ChunkSeq[u8] eff [Ffi[StdEnv], Fail[IoError]] {
    let mut buf: ChunkSeq[u8] = ChunkSeq::new[u8]();
    buf.resize(256, 0);
    loop {
        let (n, e) = match StdEnv::readlink(
            in "/proc/self/exe".as_bytes(),
            inout buf.as_slice_mut()
        ) {
            Result::Ok(r) => r,
            Result::Err(_) => return raise_kind(7),
        };
        if n < 0 {
            if e == 2 {
                return raise_kind(13);
            }
            return Fail::raise(IoError {
                kind: errno_kind(e),
                os: e,
            });
        }
        let len = wrapping_u64(n);
        if len < buf.len() {
            buf.truncate(len);
            return buf;
        }
        let cap = buf.len();
        buf.resize(wrapping_mul(cap, 2), 0);
    }
    buf
}

// `_NSGetExecutablePath` as `std` calls it: once for the size, then into a
// buffer of that size (C memory, copied out up to its NUL).
fn apple_exe_path(f: ExePathFn) -> ChunkSeq[u8] eff [Ffi[StdEnv], Fail[IoError]] {
    let cell = StdEnv::malloc(8);
    if cell == 0 {
        return raise_kind(12);
    }
    let mut size: u64 = 0;
    let _ = StdEnv::write_word(cell, inout size, 8);
    let _ = StdEnv::ExePathFn(f, 0, cell);
    let need = word(cell, 4);
    if need == 0 {
        StdEnv::free(cell);
        return raise_kind(13);
    }
    let buf = StdEnv::malloc(need);
    if buf == 0 {
        StdEnv::free(cell);
        return raise_kind(12);
    }
    let r = StdEnv::ExePathFn(f, buf, cell);
    let path = if r == 0 {
        Option::Some(c_string(buf))
    } else {
        Option::None
    };
    StdEnv::free(buf);
    StdEnv::free(cell);
    match path {
        Option::Some(p) => p,
        Option::None => raise_kind(13),
    }
}

// The current directory as path bytes.
pub fn current_dir_bytes() -> ChunkSeq[u8] eff [Ffi[StdEnv], Fail[IoError]] {
    let mut buf: ChunkSeq[u8] = ChunkSeq::new[u8]();
    buf.resize(256, 0);
    loop {
        let (at, e) = StdEnv::getcwd(inout buf.as_slice_mut());
        if at != 0 {
            break;
        }
        if e != StdEnv::ERANGE {
            return Fail::raise(IoError {
                kind: errno_kind(e),
                os: e,
            });
        }
        let n = buf.len();
        buf.resize(wrapping_mul(n, 2), 0);
    }
    let mut n: u64 = 0;
    loop {
        if n >= buf.len() {
            break;
        }
        if byte_is(in buf.as_slice(), n, 0) {
            break;
        }
        n = wrapping_add(n, 1);
    }
    buf.truncate(n);
    buf
}

// The current directory as text (an `invalid_input()` error when it is
// not UTF-8).
pub fn current_dir() -> String eff [Ffi[StdEnv], Fail[IoError]] {
    let b = current_dir_bytes();
    match String::from_utf8(in b.as_slice()) {
        Option::Some(s) => s,
        Option::None => raise_kind(7),
    }
}

// The platform: `os_linux()`, `os_macos()`, `os_windows()`, or 0.
pub fn os() -> u32 {
    StdEnv::OS
}

pub fn os_linux() -> u32 {
    1
}

pub fn os_macos() -> u32 {
    2
}

pub fn os_windows() -> u32 {
    3
}
