// @vesper-std/intern: string interning (self-hosting SH0 lane 5, #1127).
//
// An `Interner` maps each distinct string to a `Symbol`, a dense 32-bit id,
// and back. Ids are given in first-insertion order starting at 0, so the
// ids of a program's names are a function of the order they were interned
// in, never of hash values or capacity. Both directions are O(1): `intern`
// and `lookup` probe an open-addressing index of FNV-1a hashes; `resolve`,
// `symbol_len` and `symbol_eq` read the symbol's range in one shared text
// buffer.
//
// All interned text lives in one `String`, so interning allocates only when
// that buffer, the offset table or the index grows.

// An interned string's id.
pub copy struct Symbol {
    id: u32
}

impl Eq for Symbol {}

impl Ord for Symbol {}

impl Hash for Symbol {}

// The symbol with id `id` (as stored elsewhere); `resolve` checks it.
pub fn symbol_from_id(id: u32) -> Symbol {
    Symbol {
        id: id
    }
}

impl Symbol {
    pub fn id(self) -> u32 {
        self.id
    }

    pub fn index(self) -> u64 {
        widen_u64(self.id)
    }
}

pub struct Interner {
    text: String,
    // starts[i]..starts[i + 1] is symbol i's range of `text`.
    starts: ChunkSeq[u64],
    hashes: ChunkSeq[u64],
    // 0 is empty, otherwise symbol id + 1.
    slots: ChunkSeq[u32],
    mask: u64
}

// The hash `intern` uses (FNV-1a over 8-byte words and the tail, then
// mixed), so callers can key side tables by text the same way.
pub fn hash_str(in s: Str) -> u64 {
    hash_bytes(in s.as_bytes())
}

// `hash_str` of the bytes of a view (`Interner::lookup_view`).
pub fn hash_bytes(in b: Slice[u8]) -> u64 {
    let n = b.len();
    let mut h: u64 = 14695981039346656037;
    let mut i: u64 = 0;
    // Eight bytes at a time, then the tail: FNV-1a over words, mixed.
    loop {
        if wrapping_add(i, 8) > n {
            break;
        }
        let w = match b.try_read_u64_le(i) {
            Option::Some(x) => x,
            Option::None => 0,
        };
        h = wrapping_mul(h ^ w, 1099511628211);
        i = wrapping_add(i, 8);
    }
    loop {
        if i >= n {
            break;
        }
        let x = match b.try_get(i) {
            Option::Some(x) => x,
            Option::None => 0,
        };
        h = wrapping_mul(h ^ widen_u64(x), 1099511628211);
        i = wrapping_add(i, 1);
    }
    let a = wrapping_mul(h ^ (h >> 32), 13787848793156543929);
    a ^ (a >> 29)
}

fn empty_slots(n: u64) -> ChunkSeq[u32] {
    let mut s: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](n);
    s.resize(n, 0);
    s
}

// An empty interner.
pub fn interner_new() -> Interner {
    interner_with_capacity(0)
}

fn initial_slot_capacity(n: u64) -> u64 {
    let mut cap: u64 = 16;
    loop {
        if cap >= wrapping_mul(n, 2) || cap >= 2147483648 {
            break;
        }
        cap = wrapping_mul(cap, 2);
    }
    cap
}

// An empty interner with room for `n` symbols before its index grows.
pub fn interner_with_capacity(n: u64) -> Interner {
    let cap = initial_slot_capacity(n);
    let mut starts: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](wrapping_add(n, 1));
    starts.push(0);
    Interner {
        text: String::new(),
        starts: starts,
        hashes: ChunkSeq::with_capacity[u64](n),
        slots: empty_slots(cap),
        mask: wrapping_sub(cap, 1)
    }
}

impl Interner {
    // The number of distinct symbols.
    pub fn len(in self) -> u64 {
        self.hashes.len()
    }

    pub fn is_empty(in self) -> bool {
        self.hashes.len() == 0
    }

    fn range(in self, id: u64) -> (u64, u64) {
        let a = match self.starts.try_get(id) {
            Option::Some(x) => x,
            Option::None => 0,
        };
        let b = match self.starts.try_get(wrapping_add(id, 1)) {
            Option::Some(x) => x,
            Option::None => a,
        };
        (a, b)
    }

    // Whether symbol `id` spells the bytes `q`.
    fn spells(in self, id: u64, in q: Slice[u8]) -> bool {
        let (a, b) = self.range(id);
        if wrapping_sub(b, a) != q.len() {
            false
        } else {
            let t = self.text.as_bytes();
            let mut i: u64 = 0;
            let n = q.len();
            loop {
                if wrapping_add(i, 8) > n {
                    break;
                }
                let x = match t.try_read_u64_le(wrapping_add(a, i)) {
                    Option::Some(v) => v,
                    Option::None => 0,
                };
                let y = match q.try_read_u64_le(i) {
                    Option::Some(v) => v,
                    Option::None => 1,
                };
                if x != y {
                    break;
                }
                i = wrapping_add(i, 8);
            }
            loop {
                if i >= n {
                    break true;
                }
                let x = match t.try_get(wrapping_add(a, i)) {
                    Option::Some(v) => widen_u32(v),
                    Option::None => 256,
                };
                let y = match q.try_get(i) {
                    Option::Some(v) => widen_u32(v),
                    Option::None => 257,
                };
                if x != y {
                    break false;
                }
                i = wrapping_add(i, 1);
            }
        }
    }

    // The slot for `s` with hash `h`: the slot holding its symbol, or the
    // empty slot where it would go.
    fn probe(in self, in s: Slice[u8], h: u64) -> u64 {
        let mut i = h & self.mask;
        loop {
            let v = match self.slots.try_get(i) {
                Option::Some(x) => x,
                Option::None => 0,
            };
            if v == 0 {
                break i;
            }
            let id = widen_u64(wrapping_sub(v, 1));
            let same_hash = match self.hashes.try_get(id) {
                Option::Some(x) => x == h,
                Option::None => false,
            };
            if same_hash && self.spells(id, in s) {
                break i;
            }
            i = wrapping_add(i, 1) & self.mask;
        }
    }

    // The symbol for `s`, if it was interned.
    pub fn lookup(in self, in s: Str) -> Option[Symbol] {
        self.lookup_view(in s.as_bytes())
    }

    // The symbol whose text is the bytes `b` (a view of any buffer, such as
    // a segment of a name), if it was interned: nothing is copied.
    pub fn lookup_view(in self, in b: Slice[u8]) -> Option[Symbol] {
        let h = hash_bytes(in b);
        let i = self.probe(in b, h);
        match self.slots.try_get(i) {
            Option::Some(v) => if v == 0 {
                Option::None
            } else {
                Option::Some(
                    Symbol {
                        id: wrapping_sub(v, 1)
                    }
                )
            },
            Option::None => Option::None,
        }
    }

    fn grow(inout self) {
        let cap = wrapping_mul(self.slots.len(), 2);
        let mask = wrapping_sub(cap, 1);
        self.slots.clear();
        self.slots.resize(cap, 0);
        self.mask = mask;
        let n = self.hashes.len();
        let mut id: u64 = 0;
        loop {
            if id >= n {
                break;
            }
            let h = match self.hashes.try_get(id) {
                Option::Some(x) => x,
                Option::None => 0,
            };
            let mut i = h & mask;
            loop {
                let v = match self.slots.try_get(i) {
                    Option::Some(x) => x,
                    Option::None => 1,
                };
                if v == 0 {
                    break;
                }
                i = wrapping_add(i, 1) & mask;
            }
            self.slots.try_set(i, wrapping_add(wrapping_u32(id), 1));
            id = wrapping_add(id, 1);
        }
    }

    // The symbol for `s`, interning it if it is new.
    pub fn intern(inout self, in s: Str) -> Symbol {
        let h = hash_str(in s);
        let i = self.probe(in s.as_bytes(), h);
        let v = match self.slots.try_get(i) {
            Option::Some(x) => x,
            Option::None => 0,
        };
        if v != 0 {
            Symbol {
                id: wrapping_sub(v, 1)
            }
        } else {
            let id = self.hashes.len();
            self.text.push_str(in s);
            let end = self.text.len();
            self.starts.push(end);
            self.hashes.push(h);
            self.slots.try_set(i, wrapping_add(wrapping_u32(id), 1));
            // Keep the load factor at most 1/2.
            if wrapping_mul(self.hashes.len(), 2) > self.slots.len() {
                self.grow();
            }
            Symbol {
                id: wrapping_u32(id)
            }
        }
    }

    // The byte length of `sym`'s text (0 for an unknown symbol).
    pub fn symbol_len(in self, sym: Symbol) -> u64 {
        let (a, b) = self.range(widen_u64(sym.id));
        wrapping_sub(b, a)
    }

    // Whether `sym` was handed out by this interner.
    pub fn contains(in self, sym: Symbol) -> bool {
        widen_u64(sym.id) < self.hashes.len()
    }

    // Whether `sym` spells `s`.
    pub fn symbol_eq(in self, sym: Symbol, in s: Str) -> bool {
        if widen_u64(sym.id) >= self.hashes.len() {
            false
        } else {
            self.spells(widen_u64(sym.id), in s.as_bytes())
        }
    }

    // Append `sym`'s text to `out`; `false` (nothing appended) for a symbol
    // this interner did not hand out.
    pub fn resolve_into(in self, sym: Symbol, inout out: String) -> bool {
        if widen_u64(sym.id) >= self.hashes.len() {
            false
        } else {
            let (a, b) = self.range(widen_u64(sym.id));
            out.push_str(in self.text[a..b]);
            true
        }
    }

    // The symbol spelled by bytes `from..to` of `sym`'s text (the last `::`
    // segment of a path, say), if it was interned. The bytes are read in
    // place; `None` for a symbol this interner did not hand out or a range
    // past its text.
    pub fn lookup_span(in self, sym: Symbol, from: u64, to: u64) -> Option[Symbol] {
        let (a, b) = self.range(widen_u64(sym.id));
        if widen_u64(sym.id) >= self.hashes.len() || from > to || to > wrapping_sub(b, a) {
            return Option::None;
        }
        let t = self.text.as_bytes();
        self.lookup_view(in t[wrapping_add(a, from)..wrapping_add(a, to)])
    }

    // The byte range of `sym` in `text_bytes`, for reading it in place.
    pub fn span(in self, sym: Symbol) -> (u64, u64) {
        self.range(widen_u64(sym.id))
    }

    // The byte at offset `i` of the shared text (see `span`).
    pub fn text_byte(in self, i: u64) -> Option[u8] {
        self.text.try_byte_at(i)
    }
}

test {
    // @case empty(0, 16)
    // @case exactly_half(8, 16)
    // @case above_half(9, 32)
    // @case at_slot_limit(1073741824, 2147483648)
    // @case exceeds_slot_limit(1073741825, 2147483648)
    fn test_initial_slot_capacity(requested: u64, expected: u64) -> bool {
        initial_slot_capacity(requested) == expected
    }

    // @case first(1, 16)
    // @case at_half(8, 16)
    // @case beyond_half(9, 32)
    fn test_growth_threshold(count: u64, expected_slots: u64) -> bool {
        let mut table = interner_new();
        for i in 0..count {
            let mut name = String::new();
            name.push_char(wrapping_u32(wrapping_add(65, i)));
            table.intern(in name);
        }
        table.slots.len() == expected_slots
    }

    // @case empty(in "", 0xe725b373746bacdb)
    // @case tail_only(in "abcdefg", 0xc701347573c6bef5)
    // @case exact_word(in "abcdefgh", 0x88d63ec771ba6945)
    // @case word_and_tail(in "abcdefghi", 0xcabc1f8c7c950657)
    // @case two_words(in "abcdefghABCDEFGH", 0x53f9b5a03964db5f)
    fn test_hash_str(in text: Str, expected: u64) -> bool {
        hash_str(in text) == expected
    }

    // @case different_length(in "abcdefgh", in "abcdefg")
    // @case different_word(in "abcdefgh", in "xbcdefgh")
    // @case different_tail(in "abcdefghi", in "abcdefghj")
    fn test_hash_collision(in stored: Str, in different: Str) -> bool {
        let mut table = interner_new();
        let sym = table.intern(in stored);
        // Use the stored hash for both strings to exercise collision handling.
        let vacant = table.probe(in different.as_bytes(), hash_str(in stored));
        table.slots.try_get(vacant) == Option::Some(0) && !table.symbol_eq(sym, in different)
    }

    // @case equal(1, true)
    // @case different(2, false)
    fn test_short_string_in_word_sized_storage(query_byte: u32, expected: bool) -> bool {
        let mut table = interner_new();
        let mut first = String::new();
        first.push_char(1);
        let sym = table.intern(in first.as_str());
        // The backing buffer now begins with the little-endian word 1,
        // although the symbol itself owns only the first byte.
        let mut suffix = String::new();
        for i in 0..7 {
            suffix.push_char(0);
        }
        table.intern(in suffix.as_str());
        let mut query = String::new();
        query.push_char(query_byte);
        table.symbol_eq(sym, in query.as_str()) == expected
    }

    // @case first(0)
    // @case top_bit(2147483648)
    // @case max_id(4294967295)
    fn test_symbol_id(raw: u32) -> bool {
        let symbol = symbol_from_id(raw);
        symbol.id() == raw && symbol.index() == widen_u64(raw)
    }

    // @case empty(in "", in "prefix", 0)
    // @case ascii(in "abc", in "prefixabc", 3)
    // @case utf8(in "é水", in "prefixé水", 5)
    // @case full_word(in "abcdefgh", in "prefixabcdefgh", 8)
    // @case word_and_tail(in "abcdefghi", in "prefixabcdefghi", 9)
    fn test_intern_lookup_resolve(in text: Str, in appended: Str, length: u64) -> bool {
        let mut table = interner_new();
        if !table.is_empty() || table.lookup(in text) != Option::None {
            return false;
        }
        let first = table.intern(in text);
        let second = table.intern(in text);
        let (start, end) = table.span(first);
        if first
            .id()
            != 0
            || first
            != second
            || table
            .lookup(in text)
            != Option::Some(first)
            || table
            .is_empty()
            || table
            .len()
            != 1
            || !table
            .contains(first)
            || !table
            .symbol_eq(first, in text)
            || table
            .symbol_len(first)
            != length
            || start
            != 0
            || end
            != length
            || table
            .text_byte(end)
            != Option::None {
            return false;
        }
        let bytes = text.as_bytes();
        for i in start..end {
            if table.text_byte(i) != bytes.try_get(i) {
                return false;
            }
        }
        let mut out = String::new();
        out.push_str(in "prefix");
        if !table.resolve_into(first, inout out) || out.len() != appended.len() {
            return false;
        }
        let expected = appended.as_bytes();
        for i in 0..out.len() {
            if out.try_byte_at(i) != expected.try_get(i) {
                return false;
            }
        }
        true
    }

    // @case next_unused(1)
    // @case high_unused(4294967295)
    fn test_missing_symbol(raw: u32) -> bool {
        let mut table = interner_new();
        let first = table.intern(in "abc");
        let unknown = symbol_from_id(raw);
        let mut out = String::new();
        out.push_str(in "z");
        !table
            .contains(unknown)
            && table
            .symbol_len(unknown)
            == 0
            && !table
            .symbol_eq(unknown, in "")
            && !table
            .resolve_into(unknown, inout out)
            && out
            .len()
            == 1
            && out
            .try_byte_at(0)
            == Option::Some(122)
            && table
            .lookup(in "ab")
            == Option::None
            && !table
            .symbol_eq(first, in "abd")
    }

    // @case empty(0, 0)
    // @case at_initial_threshold(0, 8)
    // @case first_growth(0, 9)
    // @case repeated_growth(1, 40)
    // @case preallocated(40, 40)
    fn test_growth_preserves_symbol_order(capacity: u64, len: u64) -> bool {
        let mut table = interner_with_capacity(capacity);
        for i in 0..len {
            let mut name = String::new();
            name.push_char(wrapping_u32(wrapping_add(65, i)));
            if table.intern(in name).index() != i {
                return false;
            }
        }
        for i in 0..len {
            let mut name = String::new();
            name.push_char(wrapping_u32(wrapping_add(65, i)));
            let sym = symbol_from_id(wrapping_u32(i));
            if table
                .lookup(in name)
                != Option::Some(sym)
                || !table
                .symbol_eq(sym, in name)
                || table
                .intern(in name)
                != sym {
                return false;
            }
        }
        for slot in 0..table.slots.len() {
            match table.slots.try_get(slot) {
                Option::Some(symbol) => {
                    if widen_u64(symbol) > len {
                        return false;
                    }
                },
                Option::None => return false,
            }
        }
        table.len() == len
    }

    // The last `::` segment of an interned path is looked up in place,
    // with no copy, and a byte view of another buffer finds the same
    // symbol.
    // @case segment(in "std::seq::push", in "push", true)
    // @case whole(in "push", in "push", true)
    // @case missing(in "std::seq::pop", in "push", false)
    fn test_lookup_segment(in path: Str, in seg: Str, found: bool) -> bool {
        let mut t = interner_new();
        let want = t.intern(in seg);
        let p = t.intern(in path);
        let b = path.as_bytes();
        let mut at: u64 = 0;
        for i in 1..b.len() {
            if b
                .try_get(i)
                == Option::Some(58)
                && b
                .try_get(wrapping_sub(i, 1))
                == Option::Some(58) {
                at = wrapping_add(i, 1);
            }
        }
        let hit = t.lookup_span(p, at, path.len());
        let view = t.lookup_view(in b[at..b.len()]);
        hit
            == view
            && (hit == Option::Some(want))
            == found
            && t
            .lookup_span(p, 1, 0)
            == Option::None
            && t
            .lookup_span(p, 0, wrapping_add(path.len(), 1))
            == Option::None
    }
}
