// @vesper-std/hash::fast: non-cryptographic hashes for tables and caches.

fn byte(in s: Slice[u8], i: u64) -> u8 {
    match s.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

fn u64_at(in s: Slice[u8], i: u64) -> u64 {
    match s.try_read_u64_le(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

fn u32_at(in s: Slice[u8], i: u64) -> u32 {
    match s.try_read_u32_le(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

// FNV-1a, 64-bit.
pub fn fnv1a64(in s: Slice[u8]) -> u64 {
    let mut h: u64 = 14695981039346656037;
    let n = s.len();
    let mut i: u64 = 0;
    loop {
        if i >= n {
            break h;
        }
        h = wrapping_mul(h ^ widen_u64(byte(in s, i)), 1099511628211);
        i = wrapping_add(i, 1);
    }
}

// FNV-1a, 32-bit.
pub fn fnv1a32(in s: Slice[u8]) -> u32 {
    let mut h: u32 = 2166136261;
    let n = s.len();
    let mut i: u64 = 0;
    loop {
        if i >= n {
            break h;
        }
        h = wrapping_mul(h ^ widen_u32(byte(in s, i)), 16777619);
        i = wrapping_add(i, 1);
    }
}

// The 64-bit finalizer of SplitMix64 / MurmurHash3: a bijection whose
// every output bit depends on every input bit. Use it to hash integer
// keys (symbol ids, indices) for open addressing.
pub fn mix64(x: u64) -> u64 {
    let a = wrapping_mul(x ^ (x >> 30), 13787848793156543929);
    let b = wrapping_mul(a ^ (a >> 27), 10723151780598845931);
    b ^ (b >> 31)
}

// A hash of two words, for pair keys: `mix64` of a rotate-xor combination.
pub fn hash_pair(a: u64, b: u64) -> u64 {
    mix64(wrapping_mul(a, 11400714819323198485) ^ rotate_left(b, 32))
}

fn p1() -> u64 {
    11400714785074694791
}

fn p2() -> u64 {
    14029467366897019727
}

fn p3() -> u64 {
    1609587929392839161
}

fn p4() -> u64 {
    9650029242287828579
}

fn p5() -> u64 {
    2870177450012600261
}

fn xround(acc: u64, input: u64) -> u64 {
    wrapping_mul(rotate_left(wrapping_add(acc, wrapping_mul(input, p2())), 31), p1())
}

fn xmerge(acc: u64, v: u64) -> u64 {
    wrapping_add(wrapping_mul(acc ^ xround(0, v), p1()), p4())
}

// XXH64 of `s` with `seed` (the xxHash specification, version 0.8).
pub fn xxh64(in s: Slice[u8], seed: u64) -> u64 {
    let n = s.len();
    let mut i: u64 = 0;
    let mut h: u64 = 0;
    if n >= 32 {
        let mut v1 = wrapping_add(wrapping_add(seed, p1()), p2());
        let mut v2 = wrapping_add(seed, p2());
        let mut v3 = seed;
        let mut v4 = wrapping_sub(seed, p1());
        let last = wrapping_sub(n, 32);
        loop {
            if i > last {
                break;
            }
            v1 = xround(v1, u64_at(in s, i));
            v2 = xround(v2, u64_at(in s, wrapping_add(i, 8)));
            v3 = xround(v3, u64_at(in s, wrapping_add(i, 16)));
            v4 = xround(v4, u64_at(in s, wrapping_add(i, 24)));
            i = wrapping_add(i, 32);
        }
        h = wrapping_add(
            wrapping_add(rotate_left(v1, 1), rotate_left(v2, 7)),
            wrapping_add(rotate_left(v3, 12), rotate_left(v4, 18))
        );
        h = xmerge(h, v1);
        h = xmerge(h, v2);
        h = xmerge(h, v3);
        h = xmerge(h, v4);
    } else {
        h = wrapping_add(seed, p5());
    }
    h = wrapping_add(h, n);
    loop {
        if wrapping_add(i, 8) > n {
            break;
        }
        h = h ^ xround(0, u64_at(in s, i));
        h = wrapping_add(wrapping_mul(rotate_left(h, 27), p1()), p4());
        i = wrapping_add(i, 8);
    }
    if wrapping_add(i, 4) <= n {
        h = h ^ wrapping_mul(widen_u64(u32_at(in s, i)), p1());
        h = wrapping_add(wrapping_mul(rotate_left(h, 23), p2()), p3());
        i = wrapping_add(i, 4);
    }
    loop {
        if i >= n {
            break;
        }
        h = h ^ wrapping_mul(widen_u64(byte(in s, i)), p5());
        h = wrapping_mul(rotate_left(h, 11), p1());
        i = wrapping_add(i, 1);
    }
    h = wrapping_mul(h ^ (h >> 33), p2());
    h = wrapping_mul(h ^ (h >> 29), p3());
    h ^ (h >> 32)
}
