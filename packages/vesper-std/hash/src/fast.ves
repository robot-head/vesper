// @vesper-std/hash::fast: non-cryptographic hashes for tables and caches.

fn byte(in s: Slice[u8], i: u64) -> u8 {
    match s.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

fn u64_at(in s: Slice[u8], i: u64) -> u64 {
    match s.try_read_u64_le(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

fn u32_at(in s: Slice[u8], i: u64) -> u32 {
    match s.try_read_u32_le(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

// FNV-1a, 64-bit.
pub fn fnv1a64(in s: Slice[u8]) -> u64 {
    let mut h: u64 = 14695981039346656037;
    let n = s.len();
    let mut i: u64 = 0;
    loop {
        if i >= n {
            break h;
        }
        h = wrapping_mul(h ^ widen_u64(byte(in s, i)), 1099511628211);
        i = wrapping_add(i, 1);
    }
}

// FNV-1a, 32-bit.
pub fn fnv1a32(in s: Slice[u8]) -> u32 {
    let mut h: u32 = 2166136261;
    let n = s.len();
    let mut i: u64 = 0;
    loop {
        if i >= n {
            break h;
        }
        h = wrapping_mul(h ^ widen_u32(byte(in s, i)), 16777619);
        i = wrapping_add(i, 1);
    }
}

// The 64-bit finalizer of SplitMix64 / MurmurHash3: a bijection whose
// every output bit depends on every input bit. Use it to hash integer
// keys (symbol ids, indices) for open addressing.
pub fn mix64(x: u64) -> u64 {
    let a = wrapping_mul(x ^ (x >> 30), 13787848793156543929);
    let b = wrapping_mul(a ^ (a >> 27), 10723151780598845931);
    b ^ (b >> 31)
}

// A hash of two words, for pair keys: `mix64` of a rotate-xor combination.
pub fn hash_pair(a: u64, b: u64) -> u64 {
    mix64(wrapping_mul(a, 11400714819323198485) ^ rotate_left(b, 32))
}

fn p1() -> u64 {
    11400714785074694791
}

fn p2() -> u64 {
    14029467366897019727
}

fn p3() -> u64 {
    1609587929392839161
}

fn p4() -> u64 {
    9650029242287828579
}

fn p5() -> u64 {
    2870177450012600261
}

fn xround(acc: u64, input: u64) -> u64 {
    wrapping_mul(rotate_left(wrapping_add(acc, wrapping_mul(input, p2())), 31), p1())
}

fn xmerge(acc: u64, v: u64) -> u64 {
    wrapping_add(wrapping_mul(acc ^ xround(0, v), p1()), p4())
}

// XXH64 of `s` with `seed` (the xxHash specification, version 0.8).
pub fn xxh64(in s: Slice[u8], seed: u64) -> u64 {
    let n = s.len();
    let mut i: u64 = 0;
    let mut h: u64 = 0;
    if n >= 32 {
        let mut v1 = wrapping_add(wrapping_add(seed, p1()), p2());
        let mut v2 = wrapping_add(seed, p2());
        let mut v3 = seed;
        let mut v4 = wrapping_sub(seed, p1());
        let last = wrapping_sub(n, 32);
        loop {
            if i > last {
                break;
            }
            v1 = xround(v1, u64_at(in s, i));
            v2 = xround(v2, u64_at(in s, wrapping_add(i, 8)));
            v3 = xround(v3, u64_at(in s, wrapping_add(i, 16)));
            v4 = xround(v4, u64_at(in s, wrapping_add(i, 24)));
            i = wrapping_add(i, 32);
        }
        h = wrapping_add(
            wrapping_add(rotate_left(v1, 1), rotate_left(v2, 7)),
            wrapping_add(rotate_left(v3, 12), rotate_left(v4, 18))
        );
        h = xmerge(h, v1);
        h = xmerge(h, v2);
        h = xmerge(h, v3);
        h = xmerge(h, v4);
    } else {
        h = wrapping_add(seed, p5());
    }
    h = wrapping_add(h, n);
    loop {
        if wrapping_add(i, 8) > n {
            break;
        }
        h = h ^ xround(0, u64_at(in s, i));
        h = wrapping_add(wrapping_mul(rotate_left(h, 27), p1()), p4());
        i = wrapping_add(i, 8);
    }
    if wrapping_add(i, 4) <= n {
        h = h ^ wrapping_mul(widen_u64(u32_at(in s, i)), p1());
        h = wrapping_add(wrapping_mul(rotate_left(h, 23), p2()), p3());
        i = wrapping_add(i, 4);
    }
    loop {
        if i >= n {
            break;
        }
        h = h ^ wrapping_mul(widen_u64(byte(in s, i)), p5());
        h = wrapping_mul(rotate_left(h, 11), p1());
        i = wrapping_add(i, 1);
    }
    h = wrapping_mul(h ^ (h >> 33), p2());
    h = wrapping_mul(h ^ (h >> 29), p3());
    h ^ (h >> 32)
}

test {
    // FNV-1a reference vectors, in both published widths.
    // @case empty(in "", 0xcbf29ce484222325, 0x811c9dc5)
    // @case single_byte(in "a", 0xaf63dc4c8601ec8c, 0xe40c292c)
    // @case three_bytes(in "abc", 0xe71fa2190541574b, 0x1a47e90b)
    // @case six_bytes(in "foobar", 0x85944171f73967e8, 0xbf9cf968)
    fn test_fnv1a(in input: Str, expected64: u64, expected32: u32) -> bool {
        let bytes = input.as_bytes();
        fnv1a64(in bytes) == expected64 && fnv1a32(in bytes) == expected32
    }

    // XXH64 checked against the reference C implementation.
    // @case empty(in "", 0, 0xef46db3751d8e999)
    // @case empty_seeded(in "", 0xae0543311b702d91, 0x4b6a04fcdf7a4672)
    // @case byte_tail(in "*", 0, 0x0a9edecebeb03ae4)
    // @case four_byte_tail(in "abcd", 0, 0xde0327b0d25d92cc)
    // @case eight_byte_tail(in "abcdefgh", 0, 0x3ad351775b4634b7)
    // @case eight_plus_one(in "abcdefghi", 0, 0x27f1a34fdbb95e13)
    // @case below_stripe(in "0123456789abcdefghijklmnopqrstu", 0, 0x80adfc1d42020f39)
    // @case exact_stripe(in "0123456789abcdefghijklmnopqrstuv", 0, 0xbf7c9dbe16b5c6e2)
    // @case stripe_plus_tail(in "0123456789abcdefghijklmnopqrstuvw", 0, 0xe97423e605e2f3b4)
    // @case two_seeded_stripes(in "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ+-", 0xae0543311b702d91, 0x7bae8f84dc631f22)
    fn test_xxh64(in input: Str, seed: u64, expected: u64) -> bool {
        xxh64(in input.as_bytes(), seed) == expected
    }

    // @case zero(0x0000000000000000, 0x0000000000000000)
    // @case one(0x0000000000000001, 0x5692161d100b05e5)
    // @case top_bit(0x8000000000000000, 0x25c26ea579cea98a)
    // @case all_bits(0xffffffffffffffff, 0xb4d055fcf2cbbd7b)
    fn test_mix64(value: u64, expected: u64) -> bool {
        mix64(value) == expected
    }

    // @case zero(0x0000000000000000, 0x0000000000000000, 0x0000000000000000)
    // @case left_only(0x0000000000000001, 0x0000000000000000, 0xe220a8397b1dcdaf)
    // @case right_only(0x0000000000000000, 0x0000000000000001, 0xd820b7e910b0f93f)
    // @case both(0x0123456789abcdef, 0xfedcba9876543210, 0x6d7e1601802a23ec)
    // @case reversed(0xfedcba9876543210, 0x0123456789abcdef, 0xcd3040b1c21cb7be)
    fn test_hash_pair(first: u64, second: u64, expected: u64) -> bool {
        hash_pair(first, second) == expected
    }
}
