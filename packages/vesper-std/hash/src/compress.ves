// @vesper-std/hash::compress: the BLAKE3 compression function.
//
// Generated by packages/vesper-std/hash/gen/blake3_gen.py from the BLAKE3
// reference implementation; do not edit by hand. The 16-word state lives in
// `out`; each round is 8 calls of the quarter round `g` with the message
// permutation applied to the arguments. One straight-line function with the
// state in 16 locals runs more instructions when optimized (shared values are
// recomputed at each store) and takes minutes to compile unoptimized in a
// debug compiler; see docs/parallel-results/self-host-std-data.md.

fn word(in m: Slice[u32], i: u64) -> u32 {
    match m.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

// The quarter round on state words `a`, `b`, `c` and `d` of `v`.
fn g(inout v: Slice[u32], a: u64, b: u64, c: u64, d: u64, x: u32, y: u32) {
    let mut va = word(in v, a);
    let mut vb = word(in v, b);
    let mut vc = word(in v, c);
    let mut vd = word(in v, d);
    va = wrapping_add(wrapping_add(va, vb), x);
    vd = rotate_right(vd ^ va, 16);
    vc = wrapping_add(vc, vd);
    vb = rotate_right(vb ^ vc, 12);
    va = wrapping_add(wrapping_add(va, vb), y);
    vd = rotate_right(vd ^ va, 8);
    vc = wrapping_add(vc, vd);
    vb = rotate_right(vb ^ vc, 7);
    v.try_set(a, va);
    v.try_set(b, vb);
    v.try_set(c, vc);
    v.try_set(d, vd);
}

// Compress the 16 message words `m` into the chaining value `cv` (8 words)
// and write the 16 output words to `out`, which must hold 16 words. Missing
// words read as zero and writes past the end of `out` are dropped, so the
// function is total.
pub fn compress(
    in cv: Slice[u32],
    in m: Slice[u32],
    counter: u64,
    block_len: u32,
    flags: u32,
    inout out: Slice[u32]
