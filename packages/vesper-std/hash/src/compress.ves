    let m1 = word(in m, 1);
    let m2 = word(in m, 2);
    let m3 = word(in m, 3);
    let m4 = word(in m, 4);
    let m5 = word(in m, 5);
    let m6 = word(in m, 6);
    let m7 = word(in m, 7);
    let m8 = word(in m, 8);
    let m9 = word(in m, 9);
    let m10 = word(in m, 10);
    let m11 = word(in m, 11);
    let m12 = word(in m, 12);
    let m13 = word(in m, 13);
    let m14 = word(in m, 14);
    let m15 = word(in m, 15);
    out.try_set(0, word(in cv, 0));
    out.try_set(1, word(in cv, 1));
    out.try_set(2, word(in cv, 2));
    out.try_set(3, word(in cv, 3));
    out.try_set(4, word(in cv, 4));
    out.try_set(5, word(in cv, 5));
    out.try_set(6, word(in cv, 6));
    out.try_set(7, word(in cv, 7));
    out.try_set(8, 1779033703);
    out.try_set(9, 3144134277);
    out.try_set(10, 1013904242);
    out.try_set(11, 2773480762);
    out.try_set(12, wrapping_u32(counter));
    out.try_set(13, wrapping_u32(counter >> 32));
    out.try_set(14, block_len);
    out.try_set(15, flags);
    // Round 1.
    g(inout out, 0, 4, 8, 12, m0, m1);
    g(inout out, 1, 5, 9, 13, m2, m3);
    g(inout out, 2, 6, 10, 14, m4, m5);
    g(inout out, 3, 7, 11, 15, m6, m7);
    g(inout out, 0, 5, 10, 15, m8, m9);
    g(inout out, 1, 6, 11, 12, m10, m11);
    g(inout out, 2, 7, 8, 13, m12, m13);
    g(inout out, 3, 4, 9, 14, m14, m15);
    // Round 2.
    g(inout out, 0, 4, 8, 12, m2, m6);
    g(inout out, 1, 5, 9, 13, m3, m10);
    g(inout out, 2, 6, 10, 14, m7, m0);
    g(inout out, 3, 7, 11, 15, m4, m13);
    g(inout out, 0, 5, 10, 15, m1, m11);
    g(inout out, 1, 6, 11, 12, m12, m5);
    g(inout out, 2, 7, 8, 13, m9, m14);
    g(inout out, 3, 4, 9, 14, m15, m8);
    // Round 3.
    g(inout out, 0, 4, 8, 12, m3, m4);
    g(inout out, 1, 5, 9, 13, m10, m12);
    g(inout out, 2, 6, 10, 14, m13, m2);
    g(inout out, 3, 7, 11, 15, m7, m14);
    g(inout out, 0, 5, 10, 15, m6, m5);
    g(inout out, 1, 6, 11, 12, m9, m0);
    g(inout out, 2, 7, 8, 13, m11, m15);
    g(inout out, 3, 4, 9, 14, m8, m1);
    // Round 4.
    g(inout out, 0, 4, 8, 12, m10, m7);
    g(inout out, 1, 5, 9, 13, m12, m9);
    g(inout out, 2, 6, 10, 14, m14, m3);
    g(inout out, 3, 7, 11, 15, m13, m15);
    g(inout out, 0, 5, 10, 15, m4, m0);
    g(inout out, 1, 6, 11, 12, m11, m2);
    g(inout out, 2, 7, 8, 13, m5, m8);
    g(inout out, 3, 4, 9, 14, m1, m6);
    // Round 5.
    g(inout out, 0, 4, 8, 12, m12, m13);
    g(inout out, 1, 5, 9, 13, m9, m11);
    g(inout out, 2, 6, 10, 14, m15, m10);
    g(inout out, 3, 7, 11, 15, m14, m8);
    g(inout out, 0, 5, 10, 15, m7, m2);
    g(inout out, 1, 6, 11, 12, m5, m3);
    g(inout out, 2, 7, 8, 13, m0, m1);
    g(inout out, 3, 4, 9, 14, m6, m4);
    // Round 6.
    g(inout out, 0, 4, 8, 12, m9, m14);
    g(inout out, 1, 5, 9, 13, m11, m5);
    g(inout out, 2, 6, 10, 14, m8, m12);
    g(inout out, 3, 7, 11, 15, m15, m1);
    g(inout out, 0, 5, 10, 15, m13, m3);
    g(inout out, 1, 6, 11, 12, m0, m10);
    g(inout out, 2, 7, 8, 13, m2, m6);
    g(inout out, 3, 4, 9, 14, m4, m7);
    // Round 7.
    g(inout out, 0, 4, 8, 12, m11, m15);
    g(inout out, 1, 5, 9, 13, m5, m0);
    g(inout out, 2, 6, 10, 14, m1, m9);
    g(inout out, 3, 7, 11, 15, m8, m6);
    g(inout out, 0, 5, 10, 15, m14, m10);
    g(inout out, 1, 6, 11, 12, m2, m12);
    g(inout out, 2, 7, 8, 13, m3, m4);
    g(inout out, 3, 4, 9, 14, m7, m13);
    out.try_set(0, word(in out, 0) ^ word(in out, 8));
    out.try_set(1, word(in out, 1) ^ word(in out, 9));
    out.try_set(2, word(in out, 2) ^ word(in out, 10));
    out.try_set(3, word(in out, 3) ^ word(in out, 11));
    out.try_set(4, word(in out, 4) ^ word(in out, 12));
    out.try_set(5, word(in out, 5) ^ word(in out, 13));
    out.try_set(6, word(in out, 6) ^ word(in out, 14));
    out.try_set(7, word(in out, 7) ^ word(in out, 15));
    out.try_set(8, word(in out, 8) ^ word(in cv, 0));
    out.try_set(9, word(in out, 9) ^ word(in cv, 1));
    out.try_set(10, word(in out, 10) ^ word(in cv, 2));
    out.try_set(11, word(in out, 11) ^ word(in cv, 3));
    out.try_set(12, word(in out, 12) ^ word(in cv, 4));
    out.try_set(13, word(in out, 13) ^ word(in cv, 5));
    out.try_set(14, word(in out, 14) ^ word(in cv, 6));
    out.try_set(15, word(in out, 15) ^ word(in cv, 7));
