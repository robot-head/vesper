    s4 = rotate_right(s4 ^ s9, 12);
    s3 = wrapping_add(wrapping_add(s3, s4), m7);
    s14 = rotate_right(s14 ^ s3, 8);
    s9 = wrapping_add(s9, s14);
    s4 = rotate_right(s4 ^ s9, 7);
    // Round 7.
    s0 = wrapping_add(wrapping_add(s0, s4), m11);
    s12 = rotate_right(s12 ^ s0, 16);
    s8 = wrapping_add(s8, s12);
    s4 = rotate_right(s4 ^ s8, 12);
    s0 = wrapping_add(wrapping_add(s0, s4), m15);
    s12 = rotate_right(s12 ^ s0, 8);
    s8 = wrapping_add(s8, s12);
    s4 = rotate_right(s4 ^ s8, 7);
    s1 = wrapping_add(wrapping_add(s1, s5), m5);
    s13 = rotate_right(s13 ^ s1, 16);
    s9 = wrapping_add(s9, s13);
    s5 = rotate_right(s5 ^ s9, 12);
    s1 = wrapping_add(wrapping_add(s1, s5), m0);
    s13 = rotate_right(s13 ^ s1, 8);
    s9 = wrapping_add(s9, s13);
    s5 = rotate_right(s5 ^ s9, 7);
    s2 = wrapping_add(wrapping_add(s2, s6), m1);
    s14 = rotate_right(s14 ^ s2, 16);
    s10 = wrapping_add(s10, s14);
    s6 = rotate_right(s6 ^ s10, 12);
    s2 = wrapping_add(wrapping_add(s2, s6), m9);
    s14 = rotate_right(s14 ^ s2, 8);
    s10 = wrapping_add(s10, s14);
    s6 = rotate_right(s6 ^ s10, 7);
    s3 = wrapping_add(wrapping_add(s3, s7), m8);
    s15 = rotate_right(s15 ^ s3, 16);
    s11 = wrapping_add(s11, s15);
    s7 = rotate_right(s7 ^ s11, 12);
    s3 = wrapping_add(wrapping_add(s3, s7), m6);
    s15 = rotate_right(s15 ^ s3, 8);
    s11 = wrapping_add(s11, s15);
    s7 = rotate_right(s7 ^ s11, 7);
    s0 = wrapping_add(wrapping_add(s0, s5), m14);
    s15 = rotate_right(s15 ^ s0, 16);
    s10 = wrapping_add(s10, s15);
    s5 = rotate_right(s5 ^ s10, 12);
    s0 = wrapping_add(wrapping_add(s0, s5), m10);
    s15 = rotate_right(s15 ^ s0, 8);
    s10 = wrapping_add(s10, s15);
    s5 = rotate_right(s5 ^ s10, 7);
    s1 = wrapping_add(wrapping_add(s1, s6), m2);
    s12 = rotate_right(s12 ^ s1, 16);
    s11 = wrapping_add(s11, s12);
    s6 = rotate_right(s6 ^ s11, 12);
    s1 = wrapping_add(wrapping_add(s1, s6), m12);
    s12 = rotate_right(s12 ^ s1, 8);
    s11 = wrapping_add(s11, s12);
    s6 = rotate_right(s6 ^ s11, 7);
    s2 = wrapping_add(wrapping_add(s2, s7), m3);
    s13 = rotate_right(s13 ^ s2, 16);
    s8 = wrapping_add(s8, s13);
    s7 = rotate_right(s7 ^ s8, 12);
    s2 = wrapping_add(wrapping_add(s2, s7), m4);
    s13 = rotate_right(s13 ^ s2, 8);
    s8 = wrapping_add(s8, s13);
    s7 = rotate_right(s7 ^ s8, 7);
    s3 = wrapping_add(wrapping_add(s3, s4), m7);
    s14 = rotate_right(s14 ^ s3, 16);
    s9 = wrapping_add(s9, s14);
    s4 = rotate_right(s4 ^ s9, 12);
    s3 = wrapping_add(wrapping_add(s3, s4), m13);
    s14 = rotate_right(s14 ^ s3, 8);
    s9 = wrapping_add(s9, s14);
    s4 = rotate_right(s4 ^ s9, 7);
    out.try_set(0, s0 ^ s8);
    out.try_set(1, s1 ^ s9);
    out.try_set(2, s2 ^ s10);
    out.try_set(3, s3 ^ s11);
    out.try_set(4, s4 ^ s12);
    out.try_set(5, s5 ^ s13);
    out.try_set(6, s6 ^ s14);
    out.try_set(7, s7 ^ s15);
    out.try_set(8, s8 ^ c0);
    out.try_set(9, s9 ^ c1);
    out.try_set(10, s10 ^ c2);
    out.try_set(11, s11 ^ c3);
    out.try_set(12, s12 ^ c4);
    out.try_set(13, s13 ^ c5);
    out.try_set(14, s14 ^ c6);
    out.try_set(15, s15 ^ c7);
}
