// @vesper-std/hash-sys: BLAKE3 through the official C implementation
// (self-hosting SH0 lane 5, #1127).
//
// The `.vsys` library `Blake3` (blake3.vsys, named by this package's
// manifest) is C: the official BLAKE3 C implementation (upstream 1.8.7,
// SIMD kernels picked at run time) and the glue `c/vesper_blake3.c`, which
// the manifest's `[package] objects` compile into the static library
// `vesper_std_blake3` (Rust-exit gap wave 1 lane 12, #1510). Results are
// `@vesper-std/hash::blake3::Digest` values, equal to those of the portable
// Vesper implementation.
//
// A `Hasher` is a linear handle to a C `blake3_hasher`: create it
// with `hasher_new`/`hasher_new_keyed`/`hasher_new_derive_key`, feed it with
// `update`, read it with `finalize`/`finalize_xof` and release it once with
// `hasher_free`; the checker makes every path release it exactly once.
use @vesper-std/hash::blake3::Digest;

fn read_word(in b: Slice[u8], at: u64) -> u64 {
    match b.try_read_u64_le(at) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

fn digest_of(in b: Slice[u8]) -> Digest {
    Digest {
        w0: read_word(in b, 0),
        w1: read_word(in b, 8),
        w2: read_word(in b, 16),
        w3: read_word(in b, 24)
    }
}

fn zeros(n: u64) -> ChunkSeq[u8] {
    let mut s: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](n);
    s.resize(n, 0);
    s
}

// The BLAKE3 digest of `data`, computed by the BLAKE3 C library.
pub fn hash(in data: Slice[u8]) -> Digest eff [Ffi[Blake3]] {
    let mut out = zeros(32);
    Blake3::vesper_blake3_hash(in data, inout out.as_slice_mut());
    digest_of(in out.as_slice())
}

// Append `n` bytes of the key-derivation hash of `data` under `context` to
// `out`, in one call with no hasher handle; false (appending nothing) unless
// `context` is UTF-8.
pub fn derive_key_hash(
    in context: Slice[u8],
    in data: Slice[u8],
    n: u64,
    inout out: ChunkSeq[u8]
) -> bool eff [Ffi[Blake3]] {
    let at = out.len();
    out.resize(wrapping_add(at, n), 0);
    let end = out.len();
    if Blake3::vesper_blake3_derive_key_hash(in context, in data, inout out[at..end]) == 0 {
        out.resize(at, 0);
        return false;
    }
    true
}

// A new unkeyed hasher (`None` only if the host cannot allocate one).
pub fn hasher_new() -> Option[Hasher] eff [Ffi[Blake3]] {
    Blake3::vesper_blake3_new()
}

// A keyed hasher; `None` unless `key` is exactly 32 bytes.
pub fn hasher_new_keyed(in key: Slice[u8]) -> Option[Hasher] eff [Ffi[Blake3]] {
    Blake3::vesper_blake3_new_keyed(in key)
}

// A key-derivation hasher for `context`; `None` unless `context` is UTF-8.
pub fn hasher_new_derive_key(in context: Slice[u8]) -> Option[Hasher] eff [Ffi[Blake3]] {
    Blake3::vesper_blake3_new_derive_key(in context)
}

// Absorb `data`.
pub fn update(inout h: Hasher, in data: Slice[u8]) eff [Ffi[Blake3]] {
    Blake3::vesper_blake3_update(inout h, in data);
}

// The digest of the input so far; `h` stays usable.
pub fn finalize(in h: Hasher) -> Digest eff [Ffi[Blake3]] {
    let mut out = zeros(32);
    Blake3::vesper_blake3_finalize(in h, inout out.as_slice_mut());
    digest_of(in out.as_slice())
}

// Append `n` bytes of extendable output to `out`.
pub fn finalize_xof(in h: Hasher, n: u64, inout out: ChunkSeq[u8]) eff [Ffi[Blake3]] {
    let at = out.len();
    out.resize(wrapping_add(at, n), 0);
    let end = out.len();
    Blake3::vesper_blake3_finalize(in h, inout out[at..end]);
}

// Release `h`.
pub fn hasher_free(sink h: Hasher) eff [Ffi[Blake3]] {
    Blake3::vesper_blake3_free(h);
}
