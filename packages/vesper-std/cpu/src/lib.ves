// @vesper-std/cpu: CPU instructions with no Cranelift instruction (audit
// gap G4) over the `.vsys` library `StdCpu` (cpu.vsys). Every operation
// performs `Ffi[StdCpu]`, so a package reaches the CPU only when its
// `capability_ceiling` lists "Ffi[StdCpu]". The native backend emits each
// instruction as a small leaf function. A function of the other
// architecture fails to compile on this target, so `x86_*` builds only for
// x86_64 and `aarch64_*` only for AArch64. The evaluator has no CPU
// instructions.
//
// The counter reads trap when the operating system has not enabled
// user-space access: RDPMC needs CR4.PCE (Linux: a perf event mapped with
// `cap_user_rdpmc`), and PMCCNTR_EL0 / PMXEVCNTR_EL0 need PMUSERENR_EL0.
// The time-stamp and generic-timer reads are enabled on common systems.

// `cpuid` of `leaf` and `subleaf`: `(eax, ebx, ecx, edx)`. CPUID runs in
// user space on every x86_64 system.
pub fn x86_cpuid(leaf: u32, subleaf: u32) -> (u32, u32, u32, u32) eff [Ffi[StdCpu]] {
    let mut r = CpuidRegs {
        eax: 0,
        ebx: 0,
        ecx: 0,
        edx: 0,
    };
    StdCpu::vstd_cpu_cpuid(leaf, subleaf, inout r);
    (r.eax, r.ebx, r.ecx, r.edx)
}

// Whether the CPU has RDRAND (CPUID.01H:ECX bit 30), which
// `x86_rdrand64` needs.
pub fn x86_has_rdrand() -> bool eff [Ffi[StdCpu]] {
    let (_, _, ecx, _) = x86_cpuid(1, 0);
    ((ecx >> 30) & 1) == 1
}

// The time-stamp counter after earlier instructions complete (`lfence;
// rdtsc`).
pub fn x86_rdtsc() -> u64 eff [Ffi[StdCpu]] {
    StdCpu::vstd_cpu_rdtsc()
}

// Performance counter `index` (`lfence; rdpmc; lfence`): the general
// counters from 0, the fixed counters at `(1 << 30) + n`.
pub fn x86_rdpmc(index: u32) -> u64 eff [Ffi[StdCpu]] {
    StdCpu::vstd_cpu_rdpmc(index)
}

// One hardware random word (`rdrand`), or `None` when the generator had
// none ready. Callers retry a few times, as Intel recommends. RDRAND is an
// invalid opcode on a CPU without it, so callers check `x86_has_rdrand`
// first.
pub fn x86_rdrand64() -> Option[u64] eff [Ffi[StdCpu]] {
    let mut out: u64 = 0;
    if StdCpu::vstd_cpu_rdrand64(inout out) == 0 {
        return Option::None;
    }
    Option::Some(out)
}

// Whether the operating system has enabled protection keys
// (CPUID.07H:ECX bit 4, OSPKE), which `x86_rdpkru` and `x86_wrpkru` need.
// Both are invalid opcodes otherwise.
pub fn x86_has_pku() -> bool eff [Ffi[StdCpu]] {
    let (max, _, _, _) = x86_cpuid(0, 0);
    if max < 7 {
        return false;
    }
    let (_, _, ecx, _) = x86_cpuid(7, 0);
    ((ecx >> 4) & 1) == 1
}

// The protection-key rights register (`rdpkru`): two bits per key, access
// disable then write disable.
pub fn x86_rdpkru() -> u32 eff [Ffi[StdCpu]] {
    StdCpu::vstd_cpu_rdpkru()
}

// Set the protection-key rights register (`wrpkru`).
pub fn x86_wrpkru(value: u32) -> Unit eff [Ffi[StdCpu]] {
    StdCpu::vstd_cpu_wrpkru(value);
}

// `lfence`: later instructions start after earlier ones complete.
pub fn x86_lfence() -> Unit eff [Ffi[StdCpu]] {
    StdCpu::vstd_cpu_lfence();
}

// `mfence`: earlier loads and stores are globally visible first.
pub fn x86_mfence() -> Unit eff [Ffi[StdCpu]] {
    StdCpu::vstd_cpu_mfence();
}

// `sfence`: earlier stores are globally visible first.
pub fn x86_sfence() -> Unit eff [Ffi[StdCpu]] {
    StdCpu::vstd_cpu_sfence();
}

// The virtual count of the generic timer (`isb; mrs cntvct_el0`).
pub fn aarch64_cntvct() -> u64 eff [Ffi[StdCpu]] {
    StdCpu::vstd_cpu_cntvct()
}

// The cycle counter (`isb; mrs pmccntr_el0; isb`).
pub fn aarch64_pmccntr() -> u64 eff [Ffi[StdCpu]] {
    StdCpu::vstd_cpu_pmccntr()
}

// Event counter `index` (0 to 30), selected through PMSELR_EL0.
pub fn aarch64_pmevcntr(index: u32) -> u64 eff [Ffi[StdCpu]] {
    StdCpu::vstd_cpu_pmevcntr(index)
}

// One hardware random word (`mrs rndr`, FEAT_RNG), or `None` when the
// generator had none ready. It is undefined without FEAT_RNG
// (ID_AA64ISAR0_EL1.RNDR), so callers check that first.
pub fn aarch64_rndr() -> Option[u64] eff [Ffi[StdCpu]] {
    let mut out: u64 = 0;
    if StdCpu::vstd_cpu_rndr(inout out) == 0 {
        return Option::None;
    }
    Option::Some(out)
}

// `isb`: later instructions are fetched after earlier ones complete.
pub fn aarch64_isb() -> Unit eff [Ffi[StdCpu]] {
    StdCpu::vstd_cpu_isb();
}

// `dmb ish`: a full barrier for the inner shareable domain.
pub fn aarch64_dmb_ish() -> Unit eff [Ffi[StdCpu]] {
    StdCpu::vstd_cpu_dmb_ish();
}

// `dsb sy`: a full system barrier that waits for earlier accesses.
pub fn aarch64_dsb_sy() -> Unit eff [Ffi[StdCpu]] {
    StdCpu::vstd_cpu_dsb_sy();
}

// The permission-overlay register (`mrs por_el0`, FEAT_S1POE): four bits
// per overlay index. It is undefined without FEAT_S1POE
// (ID_AA64MMFR3_EL1.S1POE; Linux: `HWCAP2_POE`), so callers check first.
pub fn aarch64_rdpor() -> u64 eff [Ffi[StdCpu]] {
    StdCpu::vstd_cpu_rdpor()
}

// Set the permission-overlay register (`msr por_el0; isb`).
pub fn aarch64_wrpor(value: u64) -> Unit eff [Ffi[StdCpu]] {
    StdCpu::vstd_cpu_wrpor(value);
}
