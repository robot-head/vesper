// @vesper-std/arena: typed index arenas (self-hosting SH0 lane 5, #1127).
//
// An `Arena[T]` owns its values in one `ChunkSeq[T]`; `alloc` returns a
// typed `Idx[T]`, a 32-bit position that names a value of that arena's
// element type only. Trees and graphs (syntax trees, IR, the Place
// Capability Graph) become index graphs: a node holds `Idx[Node]` fields
// instead of `Box[Node]`, so a whole tree is one allocation, copies of a
// node are cheap, and a traversal walks one contiguous buffer.
//
// `IdxMap[K, V]` is a side table keyed by `Idx[K]` (types of expressions,
// spans of nodes): dense, growing on write, reading a default where unset.
// Its values need not be copy (self-hosting SH2 lane 1): `idx_map_owning`
// builds one, `put` moves a value in at the next index or over an existing
// one (moving that one out), and `put_with` fills a gap below the index with
// a constructor closure first. Values are read in place: `m.with_ref(i, |in
// v| ..)` and `m.with_mut(i, |inout v| ..)` lend one to a closure, or as
// element views of `vals`, `match m.vals.try_get(i.index()) { Some(v) => ..,
// None => .. }` (`m.dflt` is the default), `try_get_mut` to update one.
//
// Access is checked: `get` is an `Option`, `set` and `update` return
// `false` and write nothing for an index the arena never handed out, so no
// operation raises. An arena holds at most 2^32 - 1 values; `alloc` past
// that returns `idx_none()`, which no `get` accepts.

// Values need not be copy (self-hosting SH2 lane 1): `alloc` moves a value
// in, and a value that is not copy is read in place, as an element view of
// `items`: `match a.items.try_get(i.index()) { Some(v) => .., None => .. }`,
// and `try_get_mut` to update one.

// A typed index into an `Arena[T]`.
pub copy struct Idx[T] {
    raw: u32
}

impl [T] Eq for Idx[T] {}

impl [T] Ord for Idx[T] {}

impl [T] Hash for Idx[T] {}

// The index with position `raw`. Use it to rebuild an index that was stored
// as a number; `get` checks it.
pub fn idx_from_raw[T](raw: u32) -> Idx[T] {
    Idx {
        raw: raw
    }
}

// The reserved index that names no value (`u32::MAX`).
pub fn idx_none[T]() -> Idx[T] {
    Idx {
        raw: 4294967295
    }
}

impl [T] Idx[T] {
    // The position as a `u32`.
    pub fn raw(self) -> u32 {
        self.raw
    }

    // The position as a `u64`, for indexing sequences.
    pub fn index(self) -> u64 {
        widen_u64(self.raw)
    }

    pub fn is_none(self) -> bool {
        self.raw == 4294967295
    }
}

// An arena of `T` values addressed by `Idx[T]`.
pub struct Arena[T] {
    items: ChunkSeq[T]
}

// An empty arena.
pub fn arena_new[T: mod affine]() -> Arena[T] {
    Arena {
        items: ChunkSeq::new[T]()
    }
}

// An empty arena with room for `n` values.
pub fn arena_with_capacity[T: mod affine](n: u64) -> Arena[T] {
    Arena {
        items: ChunkSeq::with_capacity[T](n)
    }
}

fn at_capacity(len: u64) -> bool {
    len >= 4294967295
}

impl [T: mod affine] Arena[T] {
    // The number of values allocated.
    pub fn len(in self) -> u64 {
        self.items.len()
    }

    pub fn is_empty(in self) -> bool {
        self.items.len() == 0
    }

    // Store `v` and return its index (`idx_none()` once the arena is full,
    // and `v` is dropped).
    pub fn alloc(inout self, sink v: T) -> Idx[T] {
        let n = self.items.len();
        if at_capacity(n) {
            Idx {
                raw: 4294967295
            }
        } else {
            self.items.push(v);
            Idx {
                raw: wrapping_u32(n)
            }
        }
    }

    // The index the next `alloc` returns.
    pub fn next_idx(in self) -> Idx[T] {
        let n = self.items.len();
        if at_capacity(n) {
            Idx {
                raw: 4294967295
            }
        } else {
            Idx {
                raw: wrapping_u32(n)
            }
        }
    }

    // Whether `i` names a value of this arena.
    pub fn contains(in self, i: Idx[T]) -> bool {
        widen_u64(i.raw) < self.items.len()
    }

    // Drop every value allocated after the first `n` (rollback after a failed
    // parse, for example). Indices at or past `n` stop resolving.
    pub fn truncate(inout self, n: u64) {
        self.items.truncate(n);
    }

    // Remove every value.
    pub fn clear(inout self) {
        self.items.clear();
    }
}

impl [T: mod copy] Arena[T] {
    // The value at `i`.
    pub fn get(in self, i: Idx[T]) -> Option[T] {
        self.items.try_get(widen_u64(i.raw))
    }

    // The value at `i`, or `fallback`.
    pub fn get_or(in self, i: Idx[T], fallback: T) -> T {
        match self.items.try_get(widen_u64(i.raw)) {
            Option::Some(v) => v,
            Option::None => fallback,
        }
    }

    // Replace the value at `i`; `false` (and nothing written) when `i` is not
    // in the arena.
    pub fn set(inout self, i: Idx[T], v: T) -> bool {
        self.items.try_set(widen_u64(i.raw), v)
    }

    // The value at position `k` (0-based allocation order), for iteration.
    pub fn at(in self, k: u64) -> Option[T] {
        self.items.try_get(k)
    }
}

// A dense side table from `Idx[K]` to `V`: unset entries read as the
// default given at creation.
pub struct IdxMap[K, V] {
    vals: ChunkSeq[V],
    dflt: V
}

// An empty side table whose unset entries read as `dflt`.
pub fn idx_map_new[K, V: mod copy](dflt: V) -> IdxMap[K, V] {
    IdxMap {
        vals: ChunkSeq::new[V](),
        dflt: dflt
    }
}

// An empty side table of values that need not be copy, whose unset
// entries read as `dflt` (in place: `m.dflt`).
pub fn idx_map_owning[K, V: mod affine](sink dflt: V) -> IdxMap[K, V] {
    IdxMap {
        vals: ChunkSeq::new[V](),
        dflt: dflt
    }
}

impl [K, V: mod affine] IdxMap[K, V] {
    // One past the highest index written.
    pub fn len(in self) -> u64 {
        self.vals.len()
    }

    // Move `v` in at `i` and return the value no longer in the table: the
    // one `i` held (`i < len`), nothing when `i` is the next index
    // (`i == len`, the table grows by one), or `v` itself, unwritten, when
    // `i` is past that or `idx_none()` (a table of values that are not
    // copy cannot fill the gap with defaults).
    pub fn put(inout self, i: Idx[K], sink v: V) -> Option[V] {
        let k = widen_u64(i.raw);
        let n = self.vals.len();
        if i.raw == 4294967295 || k > n {
            Option::Some(v)
        } else if k == n {
            self.vals.push(v);
            Option::None
        } else {
            match self.vals.try_get_mut(k) {
                Option::Some(slot) => Option::Some(replace(inout slot, v)),
                Option::None => Option::None,
            }
        }
    }

    // Move `v` in at `i`, first filling any gap below `i` with `fill(j)`
    // for each new index `j`, and return the value `i` held, if any. `v`
    // itself comes back, unwritten, only for `idx_none()`. `fill` is a lent
    // closure (§4.2).
    pub fn put_with[e: eff](inout self, i: Idx[K], sink v: V, fill: fn(u64) -> V eff [e])
        -> Option[V] eff [e] {
        if i.raw == 4294967295 {
            return Option::Some(v);
        }
        let k = widen_u64(i.raw);
        loop {
            let n = self.vals.len();
            if n >= k {
                break;
            }
            self.vals.push(fill(n));
        }
        self.put(i, v)
    }

    // Call `f` on the value at `i`, read in place, or on the default when
    // `i` is unset, and return its result.
    pub fn with_ref[R, e: eff](in self, i: Idx[K], f: fn(in V) -> R eff [e]) -> R eff [e] {
        match self.vals.try_get(widen_u64(i.raw)) {
            Option::Some(v) => f(in v),
            Option::None => f(in self.dflt),
        }
    }

    // Call `f` on the value at `i`, lent `inout` in place, and return its
    // result; `None` (and `f` not called) when `i` is unset.
    pub fn with_mut[R, e: eff](inout self, i: Idx[K], f: fn(inout V) -> R eff [e])
        -> Option[R] eff [e] {
        let k = widen_u64(i.raw);
        match self.vals.try_get_mut(k) {
            Option::Some(v) => Option::Some(f(inout v)),
            Option::None => Option::None,
        }
    }
}

impl [K, V: mod copy] IdxMap[K, V] {
    // The value for `i`, or the default.
    pub fn get(in self, i: Idx[K]) -> V {
        match self.vals.try_get(widen_u64(i.raw)) {
            Option::Some(v) => v,
            Option::None => self.dflt,
        }
    }

    // Set the value for `i`, growing the table with defaults as needed.
    // `false` (nothing written) for `idx_none()`.
    pub fn set(inout self, i: Idx[K], v: V) -> bool {
        if i.raw == 4294967295 {
            false
        } else {
            let k = widen_u64(i.raw);
            if k >= self.vals.len() {
                let d = self.dflt;
                self.vals.resize(wrapping_add(k, 1), d);
            }
            self.vals.try_set(k, v)
        }
    }
}

test {
    // @case last_usable(4294967294, false)
    // @case reserved(4294967295, true)
    // @case beyond_index_range(4294967296, true)
    fn test_capacity_boundary(len: u64, expected: bool) -> bool {
        at_capacity(len) == expected
    }

    // @case first(0, false)
    // @case largest_usable(4294967294, false)
    // @case reserved(4294967295, true)
    fn test_index(raw: u32, missing: bool) -> bool {
        let idx = idx_from_raw[u64](raw);
        idx
            .raw()
            == raw
            && idx
            .index()
            == widen_u64(raw)
            && idx
            .is_none()
            == missing
            && (idx == idx_none[u64]())
            == missing
    }

    // @case empty(0, 0)
    // @case first_allocation(0, 1)
    // @case beyond_reserved_capacity(1, 40)
    // @case reserved_capacity(64, 64)
    fn test_arena_allocation(capacity: u64, count: u64) -> bool {
        let mut arena = arena_with_capacity[u64](capacity);
        if !arena.is_empty() || !arena_new[u64]().is_empty() {
            return false;
        }
        for i in 0..count {
            let next = arena.next_idx();
            let value = wrapping_add(i, 100);
            let allocated = arena.alloc(value);
            if next != allocated || allocated.index() != i || arena.at(i) != Option::Some(value) {
                return false;
            }
        }
        arena
            .len()
            == count
            && arena
            .is_empty()
            == (count == 0)
            && arena
            .next_idx()
            .index()
            == count
            && arena
            .at(count)
            == Option::None
    }

    // @case first(0, true, 99, 20)
    // @case last(1, true, 10, 99)
    // @case next(2, false, 10, 20)
    // @case reserved(4294967295, false, 10, 20)
    fn test_arena_set(raw: u32, exists: bool, first: u64, second: u64) -> bool {
        let mut arena = arena_new[u64]();
        arena.alloc(10);
        arena.alloc(20);
        let idx = idx_from_raw[u64](raw);
        let present = arena.contains(idx);
        let written = arena.set(idx, 99);
        let expected: Option[u64] = if exists {
            Option::Some(99)
        } else {
            Option::None
        };
        let value = if exists {
            99
        } else {
            77
        };
        present
            == exists
            && written
            == exists
            && arena
            .get(idx)
            == expected
            && arena
            .get_or(idx, 77)
            == value
            && arena
            .len()
            == 2
            && arena
            .at(0)
            == Option::Some(first)
            && arena
            .at(1)
            == Option::Some(second)
    }

    // @case truncate_all(0, 0)
    // @case keep_first(1, 1)
    // @case keep_all(2, 2)
    // @case cannot_grow(3, 2)
    fn test_arena_truncate(requested: u64, retained: u64) -> bool {
        let mut arena = arena_new[u64]();
        arena.alloc(10);
        arena.alloc(20);
        arena.truncate(requested);
        if arena.len() != retained || arena.at(retained) != Option::None {
            return false;
        }
        let reused = arena.alloc(30);
        if reused.index() != retained || arena.get(reused) != Option::Some(30) {
            return false;
        }
        arena.clear();
        arena.is_empty() && arena.at(0) == Option::None && arena.next_idx().index() == 0
    }

    // @case first(0, true, 2)
    // @case existing(1, true, 2)
    // @case append(2, true, 3)
    // @case sparse(12, true, 13)
    // @case reserved(4294967295, false, 2)
    fn test_index_map(raw: u32, expected_write: bool, length: u64) -> bool {
        let mut map = idx_map_new[u32, u64](99);
        let first = idx_from_raw[u32](1);
        let target = idx_from_raw[u32](raw);
        if map.len() != 0 || map.get(first) != 99 || !map.set(first, 12) {
            return false;
        }
        let contents = if raw == 1 {
            7
        } else {
            12
        };
        let target_value = if expected_write {
            7
        } else {
            99
        };
        let wrote = map.set(target, 7);
        wrote
            == expected_write
            && map
            .len()
            == length
            && map
            .get(target)
            == target_value
            && map
            .get(first)
            == contents
            && map
            .get(idx_from_raw[u32](3))
            == 99
    }
}
