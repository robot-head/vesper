// @vesper-std/fs::walk (Windows): directory listings and recursive walks directly over Win32 `kernel32`.
use self::{IoError, raise_io, raise_kind, invalid_input, kind_file, kind_dir, kind_symlink};

pub struct Entries {
    pub bytes: ChunkSeq[u8],
    pub ends: ChunkSeq[u64],
    pub kinds: ChunkSeq[u32],
}

fn get64(in s: Slice[u64], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

fn byte(in s: Slice[u8], i: u64) -> u8 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

fn push_utf8_cp(inout out: ChunkSeq[u8], cp: u32) {
    if cp < 128 {
        out.push(wrapping_u8(cp));
    } else if cp < 2048 {
        out.push(wrapping_u8(192 | wrapping_shr_u32(cp, 6)));
        out.push(wrapping_u8(128 | (cp & 63)));
    } else if cp < 65536 {
        out.push(wrapping_u8(224 | wrapping_shr_u32(cp, 12)));
        out.push(wrapping_u8(128 | (wrapping_shr_u32(cp, 6) & 63)));
        out.push(wrapping_u8(128 | (cp & 63)));
    } else {
        out.push(wrapping_u8(240 | wrapping_shr_u32(cp, 18)));
        out.push(wrapping_u8(128 | (wrapping_shr_u32(cp, 12) & 63)));
        out.push(wrapping_u8(128 | (wrapping_shr_u32(cp, 6) & 63)));
        out.push(wrapping_u8(128 | (cp & 63)));
    }
}

fn append_utf16_as_utf8(in src: Slice[u16], inout out: ChunkSeq[u8]) {
    let n = src.len();
    let mut i: u64 = 0;
    loop {
        if i >= n {
            break;
        }
        let w1 = widen_u32(
            match src.try_get(i) {
                Option::Some(v) => v,
                Option::None => 0,
            }
        );
        i = wrapping_add(i, 1);
        if w1 >= 55296 && w1 <= 56319 && i < n {
            let w2 = widen_u32(
                match src.try_get(i) {
                    Option::Some(v) => v,
                    Option::None => 0,
                }
            );
            if w2 >= 56320 && w2 <= 57343 {
                i = wrapping_add(i, 1);
                let hi = wrapping_shl_u32(wrapping_sub(w1, 55296), 10);
                let lo = wrapping_sub(w2, 56320);
                push_utf8_cp(inout out, wrapping_add(65536, hi | lo));
                continue;
            }
        }
        if w1 >= 55296 && w1 <= 57343 {
            push_utf8_cp(inout out, 65533);
        } else {
            push_utf8_cp(inout out, w1);
        }
    }
}

pub fn entry_count(in e: Entries) -> u64 {
    e.ends.len()
}

pub fn entry_start(in e: Entries, i: u64) -> u64 {
    if i == 0 {
        0
    } else {
        get64(in e.ends.as_slice(), wrapping_sub(i, 1))
    }
}

pub fn entry_end(in e: Entries, i: u64) -> u64 {
    get64(in e.ends.as_slice(), i)
}

pub fn entry_kind(in e: Entries, i: u64) -> u32 {
    match e.kinds.try_get(i) {
        Option::Some(k) => k,
        Option::None => 0,
    }
}

pub fn entry_path(in e: Entries, i: u64) -> Option[String] {
    if i >= e.ends.len() {
        return Option::None;
    }
    let a = entry_start(in e, i);
    let b = entry_end(in e, i);
    String::from_utf8(in e.bytes[a..b])
}

pub fn entry_join(in base: Slice[u8], in e: Entries, i: u64) -> ChunkSeq[u8] {
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    out.extend(in base);
    out.push(47);
    let a = entry_start(in e, i);
    let b = entry_end(in e, i);
    out.extend(in e.bytes[a..b]);
    out
}

fn empty_entries() -> Entries {
    Entries {
        bytes: ChunkSeq::new[u8](),
        ends: ChunkSeq::new[u64](),
        kinds: ChunkSeq::new[u32](),
    }
}

fn u8_at(in s: Slice[u8], i: u64) -> u8 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

fn utf8_to_utf16(in src: Slice[u8]) -> ChunkSeq[u16] eff [Fail[IoError]] {
    let n = src.len();
    let mut out: ChunkSeq[u16] = ChunkSeq::with_capacity[u16](wrapping_add(n, 4));
    let mut long_abs = false;
    if n >= 240 && u8_at(in src, 1) == 58 {
        let s2 = u8_at(in src, 2);
        if s2 == 47 || s2 == 92 {
            long_abs = true;
            out.push(92);
            out.push(92);
            out.push(63);
            out.push(92);
        }
    }
    let mut i: u64 = 0;
    loop {
        if i >= n {
            break;
        }
        let b0 = widen_u32(u8_at(in src, i));
        if b0 == 0 {
            return raise_kind(invalid_input());
        }
        if b0 < 128 {
            if long_abs && b0 == 47 {
                out.push(92);
            } else {
                out.push(wrapping_u16(b0));
            }
            i = wrapping_add(i, 1);
        } else if b0 >= 194 && b0 <= 223 && wrapping_add(i, 1) < n {
            let b1 = widen_u32(u8_at(in src, wrapping_add(i, 1)));
            if (b1 & 192) != 128 {
                return raise_kind(invalid_input());
            }
            let cp = wrapping_shl_u32(b0 & 31, 6) | (b1 & 63);
            out.push(wrapping_u16(cp));
            i = wrapping_add(i, 2);
        } else if b0 >= 224 && b0 <= 239 && wrapping_add(i, 2) < n {
            let b1 = widen_u32(u8_at(in src, wrapping_add(i, 1)));
            let b2 = widen_u32(u8_at(in src, wrapping_add(i, 2)));
            if (b1 & 192) != 128 || (b2 & 192) != 128 {
                return raise_kind(invalid_input());
            }
            let cp = wrapping_shl_u32(b0 & 15, 12) | wrapping_shl_u32(b1 & 63, 6) | (b2 & 63);
            out.push(wrapping_u16(cp));
            i = wrapping_add(i, 3);
        } else if b0 >= 240 && b0 <= 244 && wrapping_add(i, 3) < n {
            let b1 = widen_u32(u8_at(in src, wrapping_add(i, 1)));
            let b2 = widen_u32(u8_at(in src, wrapping_add(i, 2)));
            let b3 = widen_u32(u8_at(in src, wrapping_add(i, 3)));
            if (b1 & 192) != 128 || (b2 & 192) != 128 || (b3 & 192) != 128 {
                return raise_kind(invalid_input());
            }
            let cp = wrapping_shl_u32(b0 & 7, 18) | wrapping_shl_u32(
                b1 & 63,
                12
            ) | wrapping_shl_u32(b2 & 63, 6) | (b3 & 63);
            let adj = wrapping_sub(cp, 65536);
            out.push(wrapping_u16(wrapping_add(55296, wrapping_shr_u32(adj, 10))));
            out.push(wrapping_u16(wrapping_add(56320, adj & 1023)));
            i = wrapping_add(i, 4);
        } else {
            return raise_kind(invalid_input());
        }
    }
    out
}

fn find_data_u32(in buf: Slice[u8], off: u64) -> u32 {
    let b0 = widen_u32(u8_at(in buf, off));
    let b1 = widen_u32(u8_at(in buf, wrapping_add(off, 1)));
    let b2 = widen_u32(u8_at(in buf, wrapping_add(off, 2)));
    let b3 = widen_u32(u8_at(in buf, wrapping_add(off, 3)));
    b0 | wrapping_shl_u32(b1, 8) | wrapping_shl_u32(b2, 16) | wrapping_shl_u32(b3, 24)
}

fn find_data_name(in buf: Slice[u8], inout out: ChunkSeq[u16]) {
    out.clear();
    let mut i: u64 = 0;
    loop {
        if i >= 260 {
            break;
        }
        let off = wrapping_add(44, wrapping_mul(i, 2));
        let lo = widen_u16(u8_at(in buf, off));
        let hi = widen_u16(u8_at(in buf, wrapping_add(off, 1)));
        let cu = lo | wrapping_shl_u16(hi, 8);
        if cu == 0 {
            break;
        }
        out.push(cu);
        i = wrapping_add(i, 1);
    }
}

fn is_dot_u16(in name: Slice[u16]) -> bool {
    let n = name.len();
    let c0 = match name.try_get(0) {
        Option::Some(v) => v,
        Option::None => 0,
    };
    let c1 = match name.try_get(1) {
        Option::Some(v) => v,
        Option::None => 0,
    };
    (n == 1 && c0 == 46) || (n == 2 && c0 == 46 && c1 == 46)
}

fn list_into(in dir: Slice[u8], in prefix: Slice[u8], inout out: Entries) eff [
    Ffi[StdFs],
    Fail[IoError]
] {
    let wdir = utf8_to_utf16(in dir);
    let mut pattern: ChunkSeq[u16] = ChunkSeq::with_capacity[u16](wrapping_add(wdir.len(), 2));
    pattern.extend(in wdir.as_slice());
    pattern.push(92);
    pattern.push(42);
    let mut data: ChunkSeq[u8] = ChunkSeq::new[u8]();
    data.resize(592, 0);
    let fh = match StdFs::FindFirstFileW(in pattern.as_slice(), inout data.as_slice_mut()) {
        Result::Ok((h, err)) => {
            if h == StdFs::INVALID_HANDLE_VALUE {
                if err == StdFs::ERROR_FILE_NOT_FOUND || err == StdFs::ERROR_NO_MORE_FILES {
                    return ();
                }
                return raise_io(widen_u64(err));
            }
            h
        }
        Result::Err(_) => return raise_kind(invalid_input()),
    };
    let mut cname: ChunkSeq[u16] = ChunkSeq::new[u16]();
    let mut err_out: u32 = 0;
    loop {
        find_data_name(in data.as_slice(), inout cname);
        if !is_dot_u16(in cname.as_slice()) {
            let attrs = find_data_u32(in data.as_slice(), 0);
            let kind = if (attrs & StdFs::FILE_ATTRIBUTE_REPARSE_POINT) != 0 {
                kind_symlink()
            } else if (attrs & StdFs::FILE_ATTRIBUTE_DIRECTORY) != 0 {
                kind_dir()
            } else {
                kind_file()
            };
            if prefix.len() > 0 {
                out.bytes.extend(in prefix);
                out.bytes.push(47);
            }
            append_utf16_as_utf8(in cname.as_slice(), inout out.bytes);
            out.ends.push(out.bytes.len());
            out.kinds.push(kind);
        }
        let (nok, nerr) = StdFs::FindNextFileW(fh, inout data.as_slice_mut());
        if nok == 0 {
            if nerr != StdFs::ERROR_NO_MORE_FILES {
                err_out = nerr;
            }
            break;
        }
    }
    let _ = StdFs::FindClose(fh);
    if err_out != 0 {
        raise_io(widen_u64(err_out))
    }
}

fn before(in bytes: Slice[u8], in ends: Slice[u64], x: u64, y: u64) -> bool {
    let xa = if x == 0 {
        0
    } else {
        get64(in ends, wrapping_sub(x, 1))
    };
    let xb = get64(in ends, x);
    let ya = if y == 0 {
        0
    } else {
        get64(in ends, wrapping_sub(y, 1))
    };
    let yb = get64(in ends, y);
    let xl = wrapping_sub(xb, xa);
    let yl = wrapping_sub(yb, ya);
    let n = if xl < yl {
        xl
    } else {
        yl
    };
    let mut i: u64 = 0;
    loop {
        if i >= n {
            break xl < yl;
        }
        let p = byte(in bytes, wrapping_add(xa, i));
        let q = byte(in bytes, wrapping_add(ya, i));
        if p != q {
            break p < q;
        }
        i = wrapping_add(i, 1);
    }
}

fn merge_pass(
    in bytes: Slice[u8],
    in ends: Slice[u64],
    in src: Slice[u64],
    inout dst: Slice[u64],
    n: u64,
    width: u64
) {
    let mut lo: u64 = 0;
    loop {
        if lo >= n {
            break;
        }
        let mid0 = wrapping_add(lo, width);
        let mid = if mid0 < n {
            mid0
        } else {
            n
        };
        let hi0 = wrapping_add(mid, width);
        let hi = if hi0 < n {
            hi0
        } else {
            n
        };
        let mut i = lo;
        let mut j = mid;
        let mut k = lo;
        loop {
            if k >= hi {
                break;
            }
            let take_left = if i >= mid {
                false
            } else if j >= hi {
                true
            } else {
                !before(in bytes, in ends, get64(in src, j), get64(in src, i))
            };
            if take_left {
                dst.try_set(k, get64(in src, i));
                i = wrapping_add(i, 1);
            } else {
                dst.try_set(k, get64(in src, j));
                j = wrapping_add(j, 1);
            }
            k = wrapping_add(k, 1);
        }
        lo = hi;
    }
}

fn sorted(in e: Entries) -> Entries {
    let n = e.ends.len();
    let mut a: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](n);
    let mut b: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](n);
    for i in 0..n {
        a.push(i);
        b.push(i);
    }
    let mut width: u64 = 1;
    let mut in_a = true;
    loop {
        if width >= n {
            break;
        }
        if in_a {
            merge_pass(
                in e.bytes.as_slice(),
                in e.ends.as_slice(),
                in a.as_slice(),
                inout b.as_slice_mut(),
                n,
                width
            );
        } else {
            merge_pass(
                in e.bytes.as_slice(),
                in e.ends.as_slice(),
                in b.as_slice(),
                inout a.as_slice_mut(),
                n,
                width
            );
        }
        in_a = !in_a;
        width = wrapping_add(width, width);
    }
    let mut out = Entries {
        bytes: ChunkSeq::with_capacity[u8](e.bytes.len()),
        ends: ChunkSeq::with_capacity[u64](n),
        kinds: ChunkSeq::with_capacity[u32](n),
    };
    for k in 0..n {
        let i = if in_a {
            get64(in a.as_slice(), k)
        } else {
            get64(in b.as_slice(), k)
        };
        let s = entry_start(in e, i);
        let t = entry_end(in e, i);
        out.bytes.extend(in e.bytes[s..t]);
        out.ends.push(out.bytes.len());
        out.kinds.push(entry_kind(in e, i));
    }
    out
}

pub fn list_dir(in path: Str) -> Entries eff [Ffi[StdFs], Fail[IoError]] {
    list_dir_path(in path.as_bytes())
}

pub fn list_dir_path(in path: Slice[u8]) -> Entries eff [Ffi[StdFs], Fail[IoError]] {
    let mut out = empty_entries();
    let none: ChunkSeq[u8] = ChunkSeq::new[u8]();
    list_into(in path, in none.as_slice(), inout out);
    sorted(in out)
}

pub fn walk(in root: Str) -> Entries eff [Ffi[StdFs], Fail[IoError]] {
    walk_path(in root.as_bytes())
}

pub fn walk_path(in root: Slice[u8]) -> Entries eff [Ffi[StdFs], Fail[IoError]] {
    let mut out = empty_entries();
    let none: ChunkSeq[u8] = ChunkSeq::new[u8]();
    list_into(in root, in none.as_slice(), inout out);
    let mut i: u64 = 0;
    loop {
        if i >= out.ends.len() {
            break;
        }
        if entry_kind(in out, i) == kind_dir() {
            let a = entry_start(in out, i);
            let b = entry_end(in out, i);
            let mut rel: ChunkSeq[u8] = ChunkSeq::new[u8]();
            rel.extend(in out.bytes[a..b]);
            let mut dir: ChunkSeq[u8] = ChunkSeq::new[u8]();
            dir.extend(in root);
            dir.push(47);
            dir.extend(in rel.as_slice());
            list_into(in dir.as_slice(), in rel.as_slice(), inout out);
        }
        i = wrapping_add(i, 1);
    }
    sorted(in out)
}
