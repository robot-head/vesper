// @vesper-std/fs::walk (Linux): directory listings and recursive walks directly over libc.
use self::{
    IoError,
    raise_io,
    raise_kind,
    invalid_input,
    kind_file,
    kind_dir,
    kind_symlink,
    kind_other
};

pub struct Entries {
    pub bytes: ChunkSeq[u8],
    pub ends: ChunkSeq[u64],
    pub kinds: ChunkSeq[u32],
}

fn get64(in s: Slice[u64], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

fn byte(in s: Slice[u8], i: u64) -> u8 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

pub fn entry_count(in e: Entries) -> u64 {
    e.ends.len()
}

pub fn entry_start(in e: Entries, i: u64) -> u64 {
    if i == 0 {
        0
    } else {
        get64(in e.ends.as_slice(), wrapping_sub(i, 1))
    }
}

pub fn entry_end(in e: Entries, i: u64) -> u64 {
    get64(in e.ends.as_slice(), i)
}

pub fn entry_kind(in e: Entries, i: u64) -> u32 {
    match e.kinds.try_get(i) {
        Option::Some(k) => k,
        Option::None => 0,
    }
}

pub fn entry_path(in e: Entries, i: u64) -> Option[String] {
    if i >= e.ends.len() {
        return Option::None;
    }
    let a = entry_start(in e, i);
    let b = entry_end(in e, i);
    String::from_utf8(in e.bytes[a..b])
}

pub fn entry_join(in base: Slice[u8], in e: Entries, i: u64) -> ChunkSeq[u8] {
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    out.extend(in base);
    out.push(47);
    let a = entry_start(in e, i);
    let b = entry_end(in e, i);
    out.extend(in e.bytes[a..b]);
    out
}

fn empty_entries() -> Entries {
    Entries {
        bytes: ChunkSeq::new[u8](),
        ends: ChunkSeq::new[u64](),
        kinds: ChunkSeq::new[u32](),
    }
}

fn is_dot_entry(in name: Slice[u8]) -> bool {
    let n = name.len();
    if n == 1 && byte(in name, 0) == 46 {
        true
    } else if n == 2 && byte(in name, 0) == 46 && byte(in name, 1) == 46 {
        true
    } else {
        false
    }
}

fn statx_zero_ts() -> StatxTs {
    StatxTs {
        tv_sec: 0,
        tv_nsec: 0,
        reserved: 0,
    }
}

fn statx_zero() -> StatxBuf {
    StatxBuf {
        stx_mask: 0,
        stx_blksize: 0,
        stx_attributes: 0,
        stx_nlink: 0,
        stx_uid: 0,
        stx_gid: 0,
        stx_mode: 0,
        spare0: 0,
        stx_ino: 0,
        stx_size: 0,
        stx_blocks: 0,
        stx_attributes_mask: 0,
        stx_atime: statx_zero_ts(),
        stx_btime: statx_zero_ts(),
        stx_ctime: statx_zero_ts(),
        stx_mtime: statx_zero_ts(),
        rdev_major: 0,
        rdev_minor: 0,
        dev_major: 0,
        dev_minor: 0,
        stx_mnt_id: 0,
        dio_mem_align: 0,
        dio_offset_align: 0,
        s0: 0,
        s1: 0,
        s2: 0,
        s3: 0,
        s4: 0,
        s5: 0,
        s6: 0,
        s7: 0,
        s8: 0,
        s9: 0,
        s10: 0,
        s11: 0,
    }
}

fn statx_mode_kind(stx_mode: u16) -> u32 {
    let fmt = wrapping_shr_u32(widen_u32(stx_mode), 12) & 15;
    if fmt == 8 {
        kind_file()
    } else if fmt == 4 {
        kind_dir()
    } else if fmt == 10 {
        kind_symlink()
    } else {
        kind_other()
    }
}

fn dirent_kind(dirfd: i32, in name: Slice[u8], d_type: u8) -> u32 eff [Ffi[StdFs]] {
    if d_type == 8 {
        return kind_file();
    }
    if d_type == 4 {
        return kind_dir();
    }
    if d_type == 10 {
        return kind_symlink();
    }
    if d_type != 0 {
        return kind_other();
    }
    let mut stx = statx_zero();
    match StdFs::statx(dirfd, in name, StdFs::AT_SYMLINK_NOFOLLOW, StdFs::STATX_TYPE, inout stx) {
        Result::Ok((r, _)) => {
            if r == 0 {
                statx_mode_kind(stx.stx_mode)
            } else {
                kind_other()
            }
        }
        Result::Err(_) => kind_other(),
    }
}

fn list_into(in dir: Slice[u8], in prefix: Slice[u8], inout out: Entries) eff [
    Ffi[StdFs],
    Fail[IoError]
] {
    let fd = match StdFs::openat(StdFs::AT_FDCWD, in dir, StdFs::O_RDONLY | StdFs::O_CLOEXEC, 0) {
        Result::Ok((f, err)) => {
            if f < 0 {
                return raise_io(widen_u64(err));
            }
            f
        }
        Result::Err(_) => return raise_kind(invalid_input()),
    };
    let mut buf: ChunkSeq[u8] = ChunkSeq::new[u8]();
    buf.resize(4096, 0);
    let mut name: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut err_out: u32 = 0;
    loop {
        let (nread, err) = StdFs::getdents64(fd, inout buf.as_slice_mut());
        if nread < 0 {
            if err == 4 {
                continue;
            }
            err_out = err;
            break;
        }
        if nread == 0 {
            break;
        }
        let end = wrapping_u64(nread);
        let mut pos: u64 = 0;
        loop {
            if pos >= end {
                break;
            }
            let reclen = widen_u64(
                wrapping_u16(
                    widen_u32(byte(in buf.as_slice(), wrapping_add(pos, 16))) | wrapping_shl_u32(
                        widen_u32(byte(in buf.as_slice(), wrapping_add(pos, 17))),
                        8
                    )
                )
            );
            let d_type = byte(in buf.as_slice(), wrapping_add(pos, 18));
            let name_start = wrapping_add(pos, 19);
            let rec_end = wrapping_add(pos, reclen);
            let mut nul = name_start;
            loop {
                if nul >= rec_end || byte(in buf.as_slice(), nul) == 0 {
                    break;
                }
                nul = wrapping_add(nul, 1);
            }
            name.clear();
            name.extend(in buf[name_start..nul]);
            if !is_dot_entry(in name.as_slice()) {
                let kind = dirent_kind(fd, in name.as_slice(), d_type);
                if prefix.len() > 0 {
                    out.bytes.extend(in prefix);
                    out.bytes.push(47);
                }
                out.bytes.extend(in name.as_slice());
                out.ends.push(out.bytes.len());
                out.kinds.push(kind);
            }
            pos = rec_end;
        }
    }
    let _ = StdFs::close(fd);
    if err_out != 0 {
        raise_io(widen_u64(err_out))
    }
}

fn before(in bytes: Slice[u8], in ends: Slice[u64], x: u64, y: u64) -> bool {
    let xa = if x == 0 {
        0
    } else {
        get64(in ends, wrapping_sub(x, 1))
    };
    let xb = get64(in ends, x);
    let ya = if y == 0 {
        0
    } else {
        get64(in ends, wrapping_sub(y, 1))
    };
    let yb = get64(in ends, y);
    let xl = wrapping_sub(xb, xa);
    let yl = wrapping_sub(yb, ya);
    let n = if xl < yl {
        xl
    } else {
        yl
    };
    let mut i: u64 = 0;
    loop {
        if i >= n {
            break xl < yl;
        }
        let p = byte(in bytes, wrapping_add(xa, i));
        let q = byte(in bytes, wrapping_add(ya, i));
        if p != q {
            break p < q;
        }
        i = wrapping_add(i, 1);
    }
}

fn merge_pass(
    in bytes: Slice[u8],
    in ends: Slice[u64],
    in src: Slice[u64],
    inout dst: Slice[u64],
    n: u64,
    width: u64
) {
    let mut lo: u64 = 0;
    loop {
        if lo >= n {
            break;
        }
        let mid0 = wrapping_add(lo, width);
        let mid = if mid0 < n {
            mid0
        } else {
            n
        };
        let hi0 = wrapping_add(mid, width);
        let hi = if hi0 < n {
            hi0
        } else {
            n
        };
        let mut i = lo;
        let mut j = mid;
        let mut k = lo;
        loop {
            if k >= hi {
                break;
            }
            let take_left = if i >= mid {
                false
            } else if j >= hi {
                true
            } else {
                !before(in bytes, in ends, get64(in src, j), get64(in src, i))
            };
            if take_left {
                dst.try_set(k, get64(in src, i));
                i = wrapping_add(i, 1);
            } else {
                dst.try_set(k, get64(in src, j));
                j = wrapping_add(j, 1);
            }
            k = wrapping_add(k, 1);
        }
        lo = hi;
    }
}

fn sorted(in e: Entries) -> Entries {
    let n = e.ends.len();
    let mut a: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](n);
    let mut b: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](n);
    for i in 0..n {
        a.push(i);
        b.push(i);
    }
    let mut width: u64 = 1;
    let mut in_a = true;
    loop {
        if width >= n {
            break;
        }
        if in_a {
            merge_pass(
                in e.bytes.as_slice(),
                in e.ends.as_slice(),
                in a.as_slice(),
                inout b.as_slice_mut(),
                n,
                width
            );
        } else {
            merge_pass(
                in e.bytes.as_slice(),
                in e.ends.as_slice(),
                in b.as_slice(),
                inout a.as_slice_mut(),
                n,
                width
            );
        }
        in_a = !in_a;
        width = wrapping_add(width, width);
    }
    let mut out = Entries {
        bytes: ChunkSeq::with_capacity[u8](e.bytes.len()),
        ends: ChunkSeq::with_capacity[u64](n),
        kinds: ChunkSeq::with_capacity[u32](n),
    };
    for k in 0..n {
        let i = if in_a {
            get64(in a.as_slice(), k)
        } else {
            get64(in b.as_slice(), k)
        };
        let s = entry_start(in e, i);
        let t = entry_end(in e, i);
        out.bytes.extend(in e.bytes[s..t]);
        out.ends.push(out.bytes.len());
        out.kinds.push(entry_kind(in e, i));
    }
    out
}

pub fn list_dir(in path: Str) -> Entries eff [Ffi[StdFs], Fail[IoError]] {
    list_dir_path(in path.as_bytes())
}

pub fn list_dir_path(in path: Slice[u8]) -> Entries eff [Ffi[StdFs], Fail[IoError]] {
    let mut out = empty_entries();
    let none: ChunkSeq[u8] = ChunkSeq::new[u8]();
    list_into(in path, in none.as_slice(), inout out);
    sorted(in out)
}

pub fn walk(in root: Str) -> Entries eff [Ffi[StdFs], Fail[IoError]] {
    walk_path(in root.as_bytes())
}

pub fn walk_path(in root: Slice[u8]) -> Entries eff [Ffi[StdFs], Fail[IoError]] {
    let mut out = empty_entries();
    let none: ChunkSeq[u8] = ChunkSeq::new[u8]();
    list_into(in root, in none.as_slice(), inout out);
    let mut i: u64 = 0;
    loop {
        if i >= out.ends.len() {
            break;
        }
        if entry_kind(in out, i) == kind_dir() {
            let a = entry_start(in out, i);
            let b = entry_end(in out, i);
            let mut rel: ChunkSeq[u8] = ChunkSeq::new[u8]();
            rel.extend(in out.bytes[a..b]);
            let mut dir: ChunkSeq[u8] = ChunkSeq::new[u8]();
            dir.extend(in root);
            dir.push(47);
            dir.extend(in rel.as_slice());
            list_into(in dir.as_slice(), in rel.as_slice(), inout out);
        }
        i = wrapping_add(i, 1);
    }
    sorted(in out)
}
