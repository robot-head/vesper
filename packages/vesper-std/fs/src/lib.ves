// @vesper-std/fs: files and directories (self-hosting SH0 lane 3, #1125),
// over the `.vsys` library `StdFs`: the C library itself on Linux and
// macOS (fs-@OS@-@ARCH@.vsys and src/sys.ves, SH6 lane 13, #1408). Every
// operation performs `Ffi[StdFs]` and raises `Fail[IoError]` when the OS
// refuses it. Files are descriptors inside this package: each public
// function opens and closes its own, so none escapes and every path
// closes it exactly once.
//
// Paths are `in Str` in the public API and bytes underneath (`*_path`
// variants take an `in Slice[u8]`): on Unix any bytes but NUL, on Windows
// UTF-8. Modules:
// - `walk`: sorted directory listings and recursive walks (`Entries`).
// - `sys`: the operations over the C library.
use self::sys::{
    os_open,
    os_close,
    os_read,
    os_write,
    os_sync,
    os_metadata,
    os_file_len,
    os_rename,
    os_remove_file,
    os_remove_dir,
    os_create_dir,
    os_create_dir_mode,
    os_set_permissions,
    os_copy,
    os_sync_dir,
    os_parent_len,
    os_unique,
    os_word_kind,
    os_error_message,
    os_is_executable,
    os_canonicalize
};

// Why an operation failed. `kind` is one of the codes below
// (`not_found()` and friends); `os` is the raw OS error (`errno`, or
// `GetLastError` on Windows), 0 when there is none.
pub copy struct IoError {
    pub kind: u32,
    pub os: u32,
}

pub fn not_found() -> u32 {
    1
}

pub fn permission_denied() -> u32 {
    2
}

pub fn already_exists() -> u32 {
    3
}

pub fn not_a_directory() -> u32 {
    4
}

pub fn is_a_directory() -> u32 {
    5
}

pub fn directory_not_empty() -> u32 {
    6
}

// A malformed argument: a NUL byte in a path, a non-UTF-8 path on
// Windows, or (from `read_string`) a file that is not UTF-8.
pub fn invalid_input() -> u32 {
    7
}

pub fn interrupted() -> u32 {
    8
}

pub fn unexpected_eof() -> u32 {
    9
}

pub fn write_zero() -> u32 {
    10
}

pub fn unsupported() -> u32 {
    11
}

pub fn out_of_memory() -> u32 {
    12
}

pub fn other() -> u32 {
    13
}

// The host's error word: the kind in the low 8 bits, the OS error in the
// high 32.
pub fn error_of(word: u64) -> IoError {
    IoError {
        kind: wrapping_u32(word & 255),
        os: wrapping_u32(word >> 32),
    }
}

pub fn raise_io[T](word: u64) -> T eff [Fail[IoError]] {
    Fail::raise(error_of(word))
}

pub fn raise_kind[T](kind: u32) -> T eff [Fail[IoError]] {
    Fail::raise(
        IoError {
            kind: kind,
            os: 0,
        }
    )
}

// Open modes of `sys::open`.
fn mode_read() -> u32 {
    0
}

fn mode_truncate() -> u32 {
    1
}

fn mode_create_new() -> u32 {
    2
}

fn mode_append() -> u32 {
    3
}

// What `metadata` reports. `kind` is `kind_file()`, `kind_dir()`,
// `kind_symlink()` or `kind_other()`; the modification time is
// `mtime_s` whole seconds since the Unix epoch plus `mtime_ns`. `mode`
// holds the permission bits (`st_mode & 0o7777`); on Windows it is 0o444
// for a read-only entry and 0o666 otherwise.
pub copy struct Metadata {
    pub size: u64,
    pub mtime_s: i64,
    pub mtime_ns: u32,
    pub kind: u32,
    pub mode: u32,
}

pub fn kind_file() -> u32 {
    1
}

pub fn kind_dir() -> u32 {
    2
}

pub fn kind_symlink() -> u32 {
    3
}

pub fn kind_other() -> u32 {
    4
}

// ---------------------------------------------------------------------------
// Whole files.

// The whole file at `path`.
pub fn read(in path: Str) -> ChunkSeq[u8] eff [Ffi[StdFs], Fail[IoError]] {
    read_path(in path.as_bytes())
}

pub fn read_path(in path: Slice[u8]) -> ChunkSeq[u8] eff [Ffi[StdFs], Fail[IoError]] {
    read_path_limit(in path, 18446744073709551615)
}

// At most the first `limit` bytes of the file at `path` (`Read::take`):
// no more is read, however long the file is.
pub fn read_path_limit(in path: Slice[u8], limit: u64)
    -> ChunkSeq[u8] eff [Ffi[StdFs], Fail[IoError]] {
    let mut err: u64 = 0;
    let fd = os_open(in path, mode_read(), inout err);
    if fd < 0 {
        return raise_io(err);
    }
    // Read the length the file has now and one byte more, so a file that
    // did not grow ends at the same `read` that finds its end; a file that
    // grew is read on to its end (or the limit).
    let n = os_file_len(fd);
    let first = if n < limit {
        wrapping_add(n, 1)
    } else {
        limit
    };
    let mut buf: ChunkSeq[u8] = ChunkSeq::new[u8]();
    buf.resize(first, 0);
    let got = os_read(fd, inout buf, 0, inout err);
    buf.truncate(got);
    if err == 0 && got > n && got < limit {
        loop {
            let at = buf.len();
            if at >= limit {
                break;
            }
            let room = wrapping_sub(limit, at);
            let step: u64 = if room < 4096 {
                room
            } else {
                4096
            };
            buf.resize(wrapping_add(at, step), 0);
            let m = os_read(fd, inout buf, at, inout err);
            buf.truncate(wrapping_add(at, m));
            if m == 0 || err != 0 {
                break;
            }
        }
    }
    os_close(fd);
    if err != 0 {
        return raise_io(err);
    }
    buf
}

// The whole file at `path` as text: an `invalid_input()` error when it is
// not UTF-8.
pub fn read_string(in path: Str) -> String eff [Ffi[StdFs], Fail[IoError]] {
    let bytes = read_path(in path.as_bytes());
    match String::from_utf8(in bytes.as_slice()) {
        Option::Some(s) => s,
        Option::None => raise_kind(invalid_input()),
    }
}

fn write_mode(in path: Slice[u8], in data: Slice[u8], mode: u32, sync: bool) eff [
    Ffi[StdFs],
    Fail[IoError]
] {
    let mut err: u64 = 0;
    let fd = os_open(in path, mode, inout err);
    if fd < 0 {
        return raise_io(err);
    }
    let failed = os_write(fd, in data, inout err);
    if failed == 0 && sync {
        let s = os_sync(fd, inout err);
    }
    os_close(fd);
    if err != 0 {
        raise_io(err)
    }
}

// ---------------------------------------------------------------------------
// Standard output and standard error.

// Write all of `data` to standard output, unbuffered: one `write` loop on
// descriptor 1 (retrying `EINTR`), so it never reorders with other writers
// of the descriptor that flush before returning.
pub fn write_stdout(in data: Slice[u8]) eff [Ffi[StdFs], Fail[IoError]] {
    write_stream(1, in data);
}

// Write all of `data` to standard error (descriptor 2), as `write_stdout`.
pub fn write_stderr(in data: Slice[u8]) eff [Ffi[StdFs], Fail[IoError]] {
    write_stream(2, in data);
}

fn write_stream(fd: i32, in data: Slice[u8]) eff [Ffi[StdFs], Fail[IoError]] {
    let mut err: u64 = 0;
    if os_write(fd, in data, inout err) != 0 {
        raise_io(err)
    }
}

// Write `data` as the whole file at `path`, creating it or truncating it.
pub fn write(in path: Str, in data: Slice[u8]) eff [Ffi[StdFs], Fail[IoError]] {
    write_mode(in path.as_bytes(), in data, mode_truncate(), false);
}

pub fn write_path(in path: Slice[u8], in data: Slice[u8]) eff [Ffi[StdFs], Fail[IoError]] {
    write_mode(in path, in data, mode_truncate(), false);
}

// Append `data` to the file at `path`, creating it if needed.
pub fn append(in path: Str, in data: Slice[u8]) eff [Ffi[StdFs], Fail[IoError]] {
    write_mode(in path.as_bytes(), in data, mode_append(), false);
}

// Write `data` to a new file at `path`: an `already_exists()` error if
// there is one.
pub fn create_new(in path: Str, in data: Slice[u8]) eff [Ffi[StdFs], Fail[IoError]] {
    write_mode(in path.as_bytes(), in data, mode_create_new(), false);
}

// Append `n` in lower-case hexadecimal.
fn push_hex(inout out: ChunkSeq[u8], n: u64) {
    let mut shift: u64 = 60;
    loop {
        let d = wrapping_u8(wrapping_shr_u64(n, wrapping_u32(shift)) & 15);
        if d < 10 {
            out.push(wrapping_add(d, 48));
        } else {
            out.push(wrapping_add(d, 87));
        }
        if shift == 0 {
            break;
        }
        shift = wrapping_sub(shift, 4);
    }
}

// Replace the file at `path` with `data` atomically: write a temporary
// file in the same directory, flush it to storage, rename it over `path`
// and flush the directory. Readers see the old contents or the new ones,
// never a mix; on failure the temporary file is removed and `path` is
// unchanged.
pub fn replace(in path: Str, in data: Slice[u8]) eff [Ffi[StdFs], Fail[IoError]] {
    replace_path(in path.as_bytes(), in data);
}

pub fn replace_path(in path: Slice[u8], in data: Slice[u8]) eff [Ffi[StdFs], Fail[IoError]] {
    // The temporary file goes beside `path`, under a short name of its own
    // (so a target name near the file system's limit still works):
    // "<dir>.vst-<16 hex digits>.tmp", the process id and a number, the
    // next one when a file of that name is already there.
    let cut = os_parent_len(in path);
    let mut err: u64 = 0;
    let mut n: u64 = 0;
    let mut temp: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut fd: i32 = -1;
    loop {
        temp.truncate(0);
        temp.extend(in path[0..cut]);
        temp.push(46);
        temp.push(118);
        temp.push(115);
        temp.push(116);
        temp.push(45);
        push_hex(inout temp, os_unique(n));
        temp.push(46);
        temp.push(116);
        temp.push(109);
        temp.push(112);
        fd = os_open(in temp.as_slice(), mode_create_new(), inout err);
        if fd >= 0 {
            break;
        }
        if os_word_kind(err) != already_exists() || n >= 4294967295 {
            return raise_io(err);
        }
        n = wrapping_add(n, 1);
    }
    let failed = os_write(fd, in data, inout err);
    if failed == 0 {
        let s = os_sync(fd, inout err);
    }
    os_close(fd);
    if err == 0 {
        let r = os_rename(in temp.as_slice(), in path, inout err);
    }
    if err != 0 {
        let mut ignored: u64 = 0;
        let r = os_remove_file(in temp.as_slice(), inout ignored);
        return raise_io(err);
    }
    let mut dir: ChunkSeq[u8] = ChunkSeq::new[u8]();
    if cut == 0 {
        dir.push(46);
    } else {
        dir.extend(in path[0..cut]);
    }
    let s = os_sync_dir(in dir.as_slice(), inout err);
    if err != 0 {
        raise_io(err)
    }
}

// ---------------------------------------------------------------------------
// Paths.

fn check(status: u32, err: u64) eff [Fail[IoError]] {
    if status != 0 {
        raise_io(err)
    }
}

pub fn rename(in from: Str, in to: Str) eff [Ffi[StdFs], Fail[IoError]] {
    let mut err: u64 = 0;
    check(os_rename(in from.as_bytes(), in to.as_bytes(), inout err), err);
}

pub fn remove_file(in path: Str) eff [Ffi[StdFs], Fail[IoError]] {
    let mut err: u64 = 0;
    check(os_remove_file(in path.as_bytes(), inout err), err);
}

// Remove an empty directory.
pub fn remove_dir(in path: Str) eff [Ffi[StdFs], Fail[IoError]] {
    let mut err: u64 = 0;
    check(os_remove_dir(in path.as_bytes(), false, inout err), err);
}

// Remove a directory and everything in it.
pub fn remove_dir_all(in path: Str) eff [Ffi[StdFs], Fail[IoError]] {
    let mut err: u64 = 0;
    check(os_remove_dir(in path.as_bytes(), true, inout err), err);
}

// Create one directory; its parent must exist.
pub fn create_dir(in path: Str) eff [Ffi[StdFs], Fail[IoError]] {
    let mut err: u64 = 0;
    check(os_create_dir(in path.as_bytes(), false, inout err), err);
}

// Create one directory with permission bits `mode` (less the umask), as
// `std`'s `DirBuilder::mode`; its parent must exist. Windows has no mode
// and creates a plain directory.
pub fn create_dir_mode(in path: Str, mode: u32) eff [Ffi[StdFs], Fail[IoError]] {
    let mut err: u64 = 0;
    check(os_create_dir_mode(in path.as_bytes(), mode, inout err), err);
}

// Set the permission bits of `path` to `mode` (`chmod`, following a
// symbolic link), as `std::fs::set_permissions` with
// `Permissions::from_mode`. On Windows only the owner write bit (0o200)
// counts: without it the entry becomes read-only.
pub fn set_permissions(in path: Str, mode: u32) eff [Ffi[StdFs], Fail[IoError]] {
    let mut err: u64 = 0;
    check(os_set_permissions(in path.as_bytes(), mode, inout err), err);
}

// Copy the file `from` to `to`, creating or truncating `to`, with the
// permission bits of `from`, as `std::fs::copy`: the number of bytes
// copied. `to` has those bits before any byte lands in it, and the copy
// streams, so a file of any size copies in bounded memory. A source that
// is not a regular file (after following symbolic links) is an
// `invalid_input()` error.
pub fn copy(in from: Str, in to: Str) -> u64 eff [Ffi[StdFs], Fail[IoError]] {
    let m = metadata(in from);
    if m.kind != kind_file() {
        return raise_kind(invalid_input());
    }
    let mut err: u64 = 0;
    let n = os_copy(in from.as_bytes(), in to.as_bytes(), m.mode, inout err);
    if err != 0 {
        return raise_io(err);
    }
    n
}

// Create a directory and any missing parents; an existing directory is
// fine.
pub fn create_dir_all(in path: Str) eff [Ffi[StdFs], Fail[IoError]] {
    create_dir_all_path(in path.as_bytes());
}

pub fn create_dir_all_path(in path: Slice[u8]) eff [Ffi[StdFs], Fail[IoError]] {
    let mut err: u64 = 0;
    check(os_create_dir(in path, true, inout err), err);
}

fn meta_path(in path: Slice[u8], follow: bool) -> Metadata eff [Ffi[StdFs], Fail[IoError]] {
    let mut err: u64 = 0;
    let m = os_metadata(in path, follow, inout err);
    if err != 0 {
        return raise_io(err);
    }
    m
}

// The metadata of `path`, following symbolic links.
pub fn metadata(in path: Str) -> Metadata eff [Ffi[StdFs], Fail[IoError]] {
    meta_path(in path.as_bytes(), true)
}

pub fn metadata_path(in path: Slice[u8]) -> Metadata eff [Ffi[StdFs], Fail[IoError]] {
    meta_path(in path, true)
}

// The metadata of `path` itself: a symbolic link reports `kind_symlink()`.
pub fn symlink_metadata(in path: Str) -> Metadata eff [Ffi[StdFs], Fail[IoError]] {
    meta_path(in path.as_bytes(), false)
}

// Whether `path` (following symbolic links) is a regular file with an
// execute bit: the check a shell makes before running it. Never fails.
pub fn is_executable(in path: Str) -> bool eff [Ffi[StdFs]] {
    os_is_executable(in path.as_bytes())
}

pub fn is_executable_path(in path: Slice[u8]) -> bool eff [Ffi[StdFs]] {
    os_is_executable(in path)
}

// `std::fs::canonicalize`: the absolute path of `path` with every symbolic
// link, `.` and `..` resolved (`realpath`). The path must exist.
pub fn canonicalize(in path: Str) -> ChunkSeq[u8] eff [Ffi[StdFs], Fail[IoError]] {
    canonicalize_path(in path.as_bytes())
}

pub fn canonicalize_path(in path: Slice[u8]) -> ChunkSeq[u8] eff [Ffi[StdFs], Fail[IoError]] {
    let mut err: u64 = 0;
    let out = os_canonicalize(in path, inout err);
    if err != 0 {
        return raise_io(err);
    }
    out
}

// Whether `path` names anything (following symbolic links). Never fails.
pub fn exists(in path: Str) -> bool eff [Ffi[StdFs]] {
    let mut err: u64 = 0;
    let m = os_metadata(in path.as_bytes(), true, inout err);
    err == 0
}

// `Path::is_dir`: whether `path` names a directory, following symbolic
// links. Never fails.
pub fn is_dir_path(in path: Slice[u8]) -> bool eff [Ffi[StdFs]] {
    let mut err: u64 = 0;
    let m = os_metadata(in path, true, inout err);
    err == 0 && m.kind == kind_dir()
}

// `Path::is_file`: whether `path` names a regular file, following
// symbolic links. Never fails.
pub fn is_file_path(in path: Slice[u8]) -> bool eff [Ffi[StdFs]] {
    let mut err: u64 = 0;
    let m = os_metadata(in path, true, inout err);
    err == 0 && m.kind == kind_file()
}

// ---------------------------------------------------------------------------
// Error text.

// Rust's `Display` of the `io::Error` that `e` stands for (#1896): the OS
// error's message and number (`No such file or directory (os error 2)`)
// when it has one, else its kind's text (`entity not found`).
pub fn error_text(e: IoError) -> ChunkSeq[u8] eff [Ffi[StdFs]] {
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    if e.os != 0 {
        os_error_message(inout out, e.os);
        os_error_suffix(inout out, e.os);
        return out;
    }
    out.extend(in kind_text(e.kind).as_bytes());
    out
}

// ` (os error <n>)`, with the number as Rust's `i32`.
fn os_error_suffix(inout out: ChunkSeq[u8], os: u32) {
    out.extend(in " (os error ".as_bytes());
    let mut n = widen_u64(os);
    if os >= 2147483648 {
        out.push(45);
        n = wrapping_sub(4294967296, n);
    }
    let mut digits: ChunkSeq[u8] = ChunkSeq::new[u8]();
    loop {
        digits.push(wrapping_u8(wrapping_add(48, n % 10)));
        n = n / 10;
        if n == 0 {
            break;
        }
    }
    let len = digits.len();
    for i in 0..len {
        match digits.try_get(wrapping_sub(wrapping_sub(len, 1), i)) {
            Option::Some(d) => out.push(d),
            Option::None => (),
        }
    }
    out.push(41);
}

// `ErrorKind::as_str` of the kind the hybrid's error words decode to
// (`io_error` in crates/vesper-hybrid/src/driver.rs): every other code is
// `Other`.
fn kind_text(kind: u32) -> Str {
    match kind {
        1 => "entity not found",
        2 => "permission denied",
        3 => "entity already exists",
        4 => "not a directory",
        5 => "is a directory",
        6 => "directory not empty",
        7 => "invalid input parameter",
        8 => "operation interrupted",
        9 => "unexpected end of file",
        10 => "write zero",
        11 => "unsupported",
        12 => "out of memory",
        _ => "other error",
    }
}
