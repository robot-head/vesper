// @vesper-std/process (Windows): child processes directly over kernel32.
use @vesper-std/fs::{IoError, error_of, invalid_input, program_not_found};

pub copy struct ExitStatus {
    pub code: i64,
    pub signal: u32,
    pub exited: bool,
}

pub fn success(s: ExitStatus) -> bool {
    s.exited && s.code == 0
}

pub struct Output {
    pub status: ExitStatus,
    pub stdout: ChunkSeq[u8],
    pub stderr: ChunkSeq[u8],
}

pub fn stdin_stream() -> u32 {
    0
}

pub fn stdout_stream() -> u32 {
    1
}

pub fn stderr_stream() -> u32 {
    2
}

pub fn inherit() -> u32 {
    0
}

pub fn capture() -> u32 {
    1
}

pub fn null() -> u32 {
    2
}

pub struct ProcCommand {
    program: ChunkSeq[u8],
    arg_bytes: ChunkSeq[u8],
    arg_ends: ChunkSeq[u64],
    env_ops: ChunkSeq[u8],
    env_keys: ChunkSeq[u8],
    env_key_ends: ChunkSeq[u64],
    env_vals: ChunkSeq[u8],
    env_val_ends: ChunkSeq[u64],
    env_cleared: bool,
    has_cwd: bool,
    cwd: ChunkSeq[u8],
    stdin_mode: u32,
    stdout_mode: u32,
    stderr_mode: u32,
    // `process_group`: the child runs in a job object of its own.
    group: bool,
    // `capture_limit`: bytes kept of each captured stream (0: all).
    limit: u64,
}

// A spawned child. `job` is its job object (0 without `process_group`, or
// when Windows refused one); `cut` is set once a captured stream went past
// `limit` bytes.
pub struct ProcChild {
    h_process: u64,
    stdout_h: u64,
    stderr_h: u64,
    stdout_buf: ChunkSeq[u8],
    stderr_buf: ChunkSeq[u8],
    waited: bool,
    job: u64,
    limit: u64,
    cut: bool,
}

fn byte(in s: Slice[u8], i: u64) -> u8 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

fn get64(in s: Slice[u64], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

fn get16(in s: Slice[u16], i: u64) -> u16 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

fn contains_byte(in s: Slice[u8], target: u8) -> bool {
    for i in 0..s.len() {
        if byte(in s, i) == target {
            return true;
        }
    }
    false
}

fn utf8_to_utf16(in bytes: Slice[u8], inout out: ChunkSeq[u16]) -> bool {
    let n = bytes.len();
    let mut i: u64 = 0;
    loop {
        if i >= n {
            break true;
        }
        let b0 = widen_u32(byte(in bytes, i));
        if b0 == 0 {
            break false;
        }
        if b0 < 128 {
            out.push(wrapping_u16(widen_u64(b0)));
            i = wrapping_add(i, 1);
        } else if b0 < 224 {
            if wrapping_add(i, 1) >= n {
                break false;
            }
            let b1 = widen_u32(byte(in bytes, wrapping_add(i, 1)));
            let cp = ((b0 & 31) << 6) | (b1 & 63);
            out.push(wrapping_u16(widen_u64(cp)));
            i = wrapping_add(i, 2);
        } else if b0 < 240 {
            if wrapping_add(i, 2) >= n {
                break false;
            }
            let b1 = widen_u32(byte(in bytes, wrapping_add(i, 1)));
            let b2 = widen_u32(byte(in bytes, wrapping_add(i, 2)));
            let cp = ((b0 & 15) << 12) | ((b1 & 63) << 6) | (b2 & 63);
            out.push(wrapping_u16(widen_u64(cp)));
            i = wrapping_add(i, 3);
        } else {
            if wrapping_add(i, 3) >= n {
                break false;
            }
            let b1 = widen_u32(byte(in bytes, wrapping_add(i, 1)));
            let b2 = widen_u32(byte(in bytes, wrapping_add(i, 2)));
            let b3 = widen_u32(byte(in bytes, wrapping_add(i, 3)));
            let cp = ((b0 & 7) << 18) | ((b1 & 63) << 12) | ((b2 & 63) << 6) | (b3 & 63);
            let adj = wrapping_sub(widen_u64(cp), 65536);
            out.push(wrapping_u16(wrapping_add(55296, wrapping_shr_u64(adj, 10))));
            out.push(wrapping_u16(wrapping_add(56320, adj & 1023)));
            i = wrapping_add(i, 4);
        }
    }
}

fn push_u16_le(inout out: ChunkSeq[u8], w: u16) {
    out.push(wrapping_u8(widen_u64(w)));
    out.push(wrapping_u8(wrapping_shr_u64(widen_u64(w), 8)));
}

fn alloc_utf16_bytes(in units: Slice[u16], with_double_nul: bool) -> u64 eff [Ffi[StdProcess]] {
    let mut bytes: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for i in 0..units.len() {
        push_u16_le(inout bytes, get16(in units, i));
    }
    push_u16_le(inout bytes, 0);
    if with_double_nul {
        push_u16_le(inout bytes, 0);
    }
    let heap = StdProcess::GetProcessHeap();
    let ptr = StdProcess::HeapAlloc(heap, 0, bytes.len());
    if ptr != 0 {
        StdProcess::RtlMoveMemory(ptr, in bytes.as_slice());
    }
    ptr
}

fn free_heap_ptr(ptr: u64) eff [Ffi[StdProcess]] {
    if ptr != 0 {
        let heap = StdProcess::GetProcessHeap();
        let _ = StdProcess::HeapFree(heap, 0, ptr);
    }
}

fn needs_quotes(in s: Slice[u8]) -> bool {
    if s.len() == 0 {
        return true;
    }
    for i in 0..s.len() {
        let b = byte(in s, i);
        if b == 32 || b == 9 || b == 34 {
            return true;
        }
    }
    false
}

fn append_win_arg(inout out: ChunkSeq[u8], in a: Slice[u8]) {
    if !needs_quotes(in a) {
        out.extend(in a);
        return;
    }
    out.push(34);
    let mut bs: u64 = 0;
    for i in 0..a.len() {
        let b = byte(in a, i);
        if b == 92 {
            bs = wrapping_add(bs, 1);
        } else if b == 34 {
            for _ in 0..wrapping_add(wrapping_mul(bs, 2), 1) {
                out.push(92);
            }
            out.push(34);
            bs = 0;
        } else {
            for _ in 0..bs {
                out.push(92);
            }
            out.push(b);
            bs = 0;
        }
    }
    for _ in 0..wrapping_mul(bs, 2) {
        out.push(92);
    }
    out.push(34);
}

fn build_cmd_line(in c: ProcCommand, inout out: ChunkSeq[u16]) -> bool {
    let mut raw: ChunkSeq[u8] = ChunkSeq::new[u8]();
    append_win_arg(inout raw, in c.program.as_slice());
    let n = c.arg_ends.len();
    for i in 0..n {
        raw.push(32);
        let a = if i == 0 {
            0
        } else {
            get64(in c.arg_ends.as_slice(), wrapping_sub(i, 1))
        };
        let b = get64(in c.arg_ends.as_slice(), i);
        append_win_arg(inout raw, in c.arg_bytes[a..b]);
    }
    utf8_to_utf16(in raw.as_slice(), inout out)
}

fn ascii_upper(b: u8) -> u8 {
    if b >= 97 && b <= 122 {
        wrapping_u8(wrapping_sub(widen_u64(b), 32))
    } else {
        b
    }
}

fn slice_eq_nocase(in a: Slice[u8], in b: Slice[u8]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for i in 0..a.len() {
        if ascii_upper(byte(in a, i)) != ascii_upper(byte(in b, i)) {
            return false;
        }
    }
    true
}

fn env_key_bounds(in c: ProcCommand, i: u64) -> (u64, u64) {
    let a = if i == 0 {
        0
    } else {
        get64(in c.env_key_ends.as_slice(), wrapping_sub(i, 1))
    };
    let b = get64(in c.env_key_ends.as_slice(), i);
    (a, b)
}

fn env_val_bounds(in c: ProcCommand, i: u64) -> (u64, u64) {
    let a = if i == 0 {
        0
    } else {
        get64(in c.env_val_ends.as_slice(), wrapping_sub(i, 1))
    };
    let b = get64(in c.env_val_ends.as_slice(), i);
    (a, b)
}

fn is_last_env_op(in c: ProcCommand, idx: u64) -> bool {
    let (ka, kb) = env_key_bounds(in c, idx);
    let n = c.env_ops.len();
    let mut j = wrapping_add(idx, 1);
    loop {
        if j >= n {
            break true;
        }
        let (ja, jb) = env_key_bounds(in c, j);
        if slice_eq_nocase(in c.env_keys[ja..jb], in c.env_keys[ka..kb]) {
            break false;
        }
        j = wrapping_add(j, 1);
    }
}

fn env_override_state(in c: ProcCommand, in key: Slice[u8]) -> u8 {
    let n = c.env_ops.len();
    let mut i = n;
    loop {
        if i == 0 {
            break 0;
        }
        i = wrapping_sub(i, 1);
        let (a, b) = env_key_bounds(in c, i);
        if slice_eq_nocase(in c.env_keys[a..b], in key) {
            let op = byte(in c.env_ops.as_slice(), i);
            break if op == 1 { 1 } else { 2 };
        }
    }
}

fn append_parent_env(in c: ProcCommand, inout units: ChunkSeq[u16]) eff [Ffi[StdProcess]] {
    let block = StdProcess::GetEnvironmentStringsW();
    if block == 0 {
        return;
    }
    let mut cur = block;
    let mut buf: ChunkSeq[u8] = ChunkSeq::new[u8]();
    loop {
        let wlen = StdProcess::lstrlenW(cur);
        if wlen <= 0 {
            break;
        }
        buf.clear();
        let need = StdProcess::WideCharToMultiByte(
            65001,
            0,
            cur,
            wlen,
            inout buf.as_slice_mut(),
            0,
            0
        );
        if need > 0 {
            buf.resize(widen_u64(wrapping_u32(need)), 0);
            let got = StdProcess::WideCharToMultiByte(
                65001,
                0,
                cur,
                wlen,
                inout buf.as_slice_mut(),
                0,
                0
            );
            if got > 0 {
                let s = buf[0..widen_u64(wrapping_u32(got))];
                let mut eq: u64 = 0;
                let mut found = false;
                loop {
                    if eq >= s.len() {
                        break;
                    }
                    if byte(in s, eq) == 61 {
                        found = true;
                        break;
                    }
                    eq = wrapping_add(eq, 1);
                }
                if found && eq > 0 && env_override_state(in c, in s[0..eq]) == 0 {
                    let _ = utf8_to_utf16(in s, inout units);
                    units.push(0);
                }
            }
        }
        cur = wrapping_add(cur, wrapping_mul(wrapping_add(widen_u64(wrapping_u32(wlen)), 1), 2));
    }
    let _ = StdProcess::FreeEnvironmentStringsW(block);
}

fn build_env_block(in c: ProcCommand) -> u64 eff [Ffi[StdProcess]] {
    if !c.env_cleared && c.env_ops.len() == 0 {
        return 0;
    }
    let mut units: ChunkSeq[u16] = ChunkSeq::new[u16]();
    if !c.env_cleared {
        append_parent_env(in c, inout units);
    }
    let n = c.env_ops.len();
    for i in 0..n {
        if byte(in c.env_ops.as_slice(), i) == 1 && is_last_env_op(in c, i) {
            let (ka, kb) = env_key_bounds(in c, i);
            let (va, vb) = env_val_bounds(in c, i);
            let _ = utf8_to_utf16(in c.env_keys[ka..kb], inout units);
            units.push(61);
            let _ = utf8_to_utf16(in c.env_vals[va..vb], inout units);
            units.push(0);
        }
    }
    alloc_utf16_bytes(in units.as_slice(), true)
}

pub fn command(in program: Str) -> ProcCommand {
    command_path(in program.as_bytes())
}

pub fn command_path(in program: Slice[u8]) -> ProcCommand {
    let mut prog: ChunkSeq[u8] = ChunkSeq::new[u8]();
    prog.extend(in program);
    ProcCommand {
        program: prog,
        arg_bytes: ChunkSeq::new[u8](),
        arg_ends: ChunkSeq::new[u64](),
        env_ops: ChunkSeq::new[u8](),
        env_keys: ChunkSeq::new[u8](),
        env_key_ends: ChunkSeq::new[u64](),
        env_vals: ChunkSeq::new[u8](),
        env_val_ends: ChunkSeq::new[u64](),
        env_cleared: false,
        has_cwd: false,
        cwd: ChunkSeq::new[u8](),
        stdin_mode: inherit(),
        stdout_mode: inherit(),
        stderr_mode: inherit(),
        group: false,
        limit: 0,
    }
}

pub fn arg(inout c: ProcCommand, in a: Str) {
    arg_bytes(inout c, in a.as_bytes());
}

pub fn arg_bytes(inout c: ProcCommand, in a: Slice[u8]) {
    c.arg_bytes.extend(in a);
    c.arg_ends.push(c.arg_bytes.len());
}

pub fn env(inout c: ProcCommand, in key: Str, in value: Str) {
    env_bytes(inout c, in key, in value.as_bytes());
}

// `env` with a value that need not be UTF-8 (a path the host gave).
pub fn env_bytes(inout c: ProcCommand, in key: Str, in value: Slice[u8]) {
    c.env_ops.push(1);
    c.env_keys.extend(in key.as_bytes());
    c.env_key_ends.push(c.env_keys.len());
    c.env_vals.extend(in value);
    c.env_val_ends.push(c.env_vals.len());
}

pub fn env_remove(inout c: ProcCommand, in key: Str) {
    c.env_ops.push(0);
    c.env_keys.extend(in key.as_bytes());
    c.env_key_ends.push(c.env_keys.len());
    c.env_val_ends.push(c.env_vals.len());
}

pub fn env_clear(inout c: ProcCommand) {
    c.env_cleared = true;
    c.env_ops.clear();
    c.env_keys.clear();
    c.env_key_ends.clear();
    c.env_vals.clear();
    c.env_val_ends.clear();
}

pub fn cwd(inout c: ProcCommand, in dir: Str) {
    c.has_cwd = true;
    c.cwd.clear();
    c.cwd.extend(in dir.as_bytes());
}

pub fn stdio(inout c: ProcCommand, stream: u32, mode: u32) {
    if stream == stdin_stream() {
        c.stdin_mode = if mode == capture() { null() } else { mode };
    } else if stream == stdout_stream() {
        c.stdout_mode = mode;
    } else if stream == stderr_stream() {
        c.stderr_mode = mode;
    }
}

// Start the child in a job object of its own, so `kill_tree` also stops
// every process it starts.
pub fn process_group(inout c: ProcCommand) {
    c.group = true;
}

// Keep at most `bytes` of each captured stream (0: no limit). The rest is
// still read, so the child never blocks on a full pipe, and dropped;
// `truncated` reports it.
pub fn capture_limit(inout c: ProcCommand, bytes: u64) {
    c.limit = bytes;
}

pub fn discard(sink c: ProcCommand) {}

fn close_handle_if(h: u64) eff [Ffi[StdProcess]] {
    if h != 0 && h != wrapping_sub(0, 1) {
        let _ = StdProcess::CloseHandle(h);
    }
}

fn make_capture_pipe() -> Result[(u64, u64), IoError] eff [Ffi[StdProcess]] {
    let mut r = HandleBox { h: 0 };
    let mut w = HandleBox { h: 0 };
    let sa = SecAttr {
        length: 24,
        pad0: 0,
        sec_desc: 0,
        inherit: 1,
        pad1: 0,
    };
    let (ok, err) = StdProcess::CreatePipe(inout r, inout w, in sa, 0);
    if ok == 0 {
        return Result::Err(error_of(widen_u64(err)));
    }
    let _ = StdProcess::SetHandleInformation(r.h, StdProcess::HANDLE_FLAG_INHERIT, 0);
    Result::Ok((r.h, w.h))
}

fn open_nul_handle(for_write: bool) -> u64 eff [Ffi[StdProcess]] {
    let mut nul: ChunkSeq[u16] = ChunkSeq::new[u16]();
    nul.push(78);
    nul.push(85);
    nul.push(76);
    let sa = SecAttr {
        length: 24,
        pad0: 0,
        sec_desc: 0,
        inherit: 1,
        pad1: 0,
    };
    let access = if for_write {
        StdProcess::GENERIC_WRITE
    } else {
        StdProcess::GENERIC_READ
    };
    match StdProcess::CreateFileW(
        in nul.as_slice(),
        access,
        StdProcess::FILE_SHARE_READ | StdProcess::FILE_SHARE_WRITE,
        in sa,
        StdProcess::OPEN_EXISTING,
        StdProcess::FILE_ATTRIBUTE_NORMAL,
        0
    ) {
        Result::Ok((h, _)) => h,
        Result::Err(_) => wrapping_sub(0, 1),
    }
}

// ---------------------------------------------------------------------------
// The program search of Rust's `Command` on Windows (`resolve_exe` in
// library/std/src/sys/process/windows.rs), so `CreateProcessW` gets an
// application name and never runs its own search, which would also look in
// the current directory. A bare file name is searched along the child's
// `PATH` (when the command changed it), the executable's directory, the
// system and Windows directories, then the parent's `PATH`, skipping empty
// entries, with `.exe` appended when the name has no `.`. A name with a
// separator is used as given, or with `.exe` when that file exists.

fn is_sep16(u: u16) -> bool {
    u == 47 || u == 92
}

fn ascii_letter16(u: u16) -> bool {
    (u >= 65 && u <= 90) || (u >= 97 && u <= 122)
}

// `X:` and nothing else (`Prefix::Disk`, the only `is_drive()` prefix).
fn bare_drive16(in p: Slice[u16]) -> bool {
    p.len() == 2 && ascii_letter16(get16(in p, 0)) && get16(in p, 1) == 58
}

fn starts_with_drive16(in p: Slice[u16]) -> bool {
    p.len() >= 2 && ascii_letter16(get16(in p, 0)) && get16(in p, 1) == 58
}

fn get32(in s: Slice[u32], i: u64) -> u32 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

// The first `n` UTF-16 units of a buffer packed two per `u32`.
fn unpack_u16(in src: Slice[u32], n: u64) -> ChunkSeq[u16] {
    let mut out: ChunkSeq[u16] = ChunkSeq::with_capacity[u16](n);
    for i in 0..n {
        let w = get32(in src, wrapping_shr_u64(i, 1));
        let u = if (i & 1) == 0 {
            wrapping_u16(widen_u64(w & 65535))
        } else {
            wrapping_u16(widen_u64(wrapping_shr_u32(w, 16)))
        };
        out.push(u);
    }
    out
}

// 0: the executable's path, 1: the system directory, 2: the Windows
// directory; empty when the call fails.
fn host_dir16(which: u8) -> ChunkSeq[u16] eff [Ffi[StdProcess]] {
    let mut buf: ChunkSeq[u32] = ChunkSeq::new[u32]();
    buf.resize(260, 0);
    loop {
        let n = if which == 0 {
            StdProcess::GetModuleFileNameW(0, inout buf.as_slice_mut())
        } else if which == 1 {
            StdProcess::GetSystemDirectoryW(inout buf.as_slice_mut())
        } else {
            StdProcess::GetWindowsDirectoryW(inout buf.as_slice_mut())
        };
        if n == 0 {
            return ChunkSeq::new[u16]();
        }
        let nu = widen_u64(n);
        if nu < buf.len() {
            return unpack_u16(in buf.as_slice(), nu);
        }
        if buf.len() >= 32768 {
            return ChunkSeq::new[u16]();
        }
        buf.resize(wrapping_mul(buf.len(), 2), 0);
    }
    ChunkSeq::new[u16]()
}

// `PathBuf::pop` of the executable's path: its directory.
fn parent16(in p: Slice[u16]) -> ChunkSeq[u16] {
    let mut out: ChunkSeq[u16] = ChunkSeq::new[u16]();
    let mut last: u64 = p.len();
    for i in 0..p.len() {
        if is_sep16(get16(in p, i)) {
            last = i;
        }
    }
    if last == p.len() {
        return out;
    }
    // Keep the root separator (`C:\vesper.exe` pops to `C:\`).
    let end = if (last == 2 && starts_with_drive16(in p)) || last == 0 {
        wrapping_add(last, 1)
    } else {
        last
    };
    for i in 0..end {
        out.push(get16(in p, i));
    }
    out
}

fn parent_path16() -> Option[ChunkSeq[u16]] eff [Ffi[StdProcess]] {
    let mut name: ChunkSeq[u16] = ChunkSeq::new[u16]();
    name.push(80);
    name.push(65);
    name.push(84);
    name.push(72);
    let mut buf: ChunkSeq[u32] = ChunkSeq::new[u32]();
    buf.resize(1024, 0);
    loop {
        let n = match StdProcess::GetEnvironmentVariableW(
            in name.as_slice(),
            inout buf.as_slice_mut()
        ) {
            Result::Ok(n) => n,
            Result::Err(_) => 0,
        };
        if n == 0 {
            return Option::None;
        }
        let nu = widen_u64(n);
        if nu < buf.len() {
            return Option::Some(unpack_u16(in buf.as_slice(), nu));
        }
        buf.resize(nu, 0);
    }
    Option::None
}

// The child's `PATH` when the command changed it: `Some(None)` when it
// removed it (or cleared the environment without setting it).
fn child_path16(in c: ProcCommand) -> Option[Option[ChunkSeq[u16]]] {
    let n = c.env_ops.len();
    let mut i = n;
    loop {
        if i == 0 {
            break;
        }
        i = wrapping_sub(i, 1);
        let (a, b) = env_key_bounds(in c, i);
        if slice_eq_nocase(in c.env_keys[a..b], in "PATH".as_bytes()) {
            if byte(in c.env_ops.as_slice(), i) != 1 {
                return Option::Some(Option::None);
            }
            let (va, vb) = env_val_bounds(in c, i);
            let mut w: ChunkSeq[u16] = ChunkSeq::new[u16]();
            if !utf8_to_utf16(in c.env_vals[va..vb], inout w) {
                return Option::Some(Option::None);
            }
            return Option::Some(Option::Some(w));
        }
    }
    if c.env_cleared {
        return Option::Some(Option::None);
    }
    Option::None
}

// `PathBuf::push(name)` then `.exe` when `name` has no `.`.
fn candidate16(in dir: Slice[u16], in name: Slice[u16], has_extension: bool) -> ChunkSeq[u16] {
    let mut p: ChunkSeq[u16] = ChunkSeq::new[u16]();
    // A name with a drive prefix (`C:tool`) replaces the directory.
    if !starts_with_drive16(in name) {
        p.extend(in dir);
        let n = dir.len();
        if n != 0 && !is_sep16(get16(in dir, wrapping_sub(n, 1))) && !bare_drive16(in dir) {
            p.push(92);
        }
    }
    p.extend(in name);
    if !has_extension {
        p.push(46);
        p.push(101);
        p.push(120);
        p.push(101);
    }
    p
}

fn exists16(in path: Slice[u16]) -> bool eff [Ffi[StdProcess]] {
    match StdProcess::GetFileAttributesW(in path) {
        Result::Ok(a) => a != StdProcess::INVALID_FILE_ATTRIBUTES,
        Result::Err(_) => false,
    }
}

// The first `dir\name` that exists, over the `;`-separated entries of
// `paths` (quotes stripped, empty entries skipped), or empty.
fn search16(
    in paths: Slice[u16],
    in name: Slice[u16],
    has_extension: bool
) -> ChunkSeq[u16] eff [Ffi[StdProcess]] {
    let mut dir: ChunkSeq[u16] = ChunkSeq::new[u16]();
    let mut quoted = false;
    let n = paths.len();
    for i in 0..wrapping_add(n, 1) {
        let u = get16(in paths, i);
        if i < n && u == 34 {
            quoted = !quoted;
        } else if i == n || (!quoted && u == 59) {
            if dir.len() != 0 {
                let c = candidate16(in dir.as_slice(), in name, has_extension);
                if exists16(in c.as_slice()) {
                    return c;
                }
            }
            dir.clear();
        } else {
            dir.push(u);
        }
    }
    ChunkSeq::new[u16]()
}

fn lower16(u: u16) -> u16 {
    if u >= 65 && u <= 90 {
        wrapping_u16(wrapping_add(widen_u64(u), 32))
    } else {
        u
    }
}

fn ends_with_exe16(in p: Slice[u16]) -> bool {
    let n = p.len();
    if n < 4 {
        return false;
    }
    let base = wrapping_sub(n, 4);
    lower16(get16(in p, base)) == 46
        && lower16(get16(in p, wrapping_add(base, 1))) == 101
        && lower16(get16(in p, wrapping_add(base, 2))) == 120
        && lower16(get16(in p, wrapping_add(base, 3))) == 101
}

fn io_err(kind: u32) -> IoError {
    IoError { kind: kind, os: 0 }
}

// The application name `CreateProcessW` gets for `c.program`.
fn resolve_exe(in c: ProcCommand) -> Result[ChunkSeq[u16], IoError] eff [Ffi[StdProcess]] {
    let mut exe: ChunkSeq[u16] = ChunkSeq::new[u16]();
    if !utf8_to_utf16(in c.program.as_slice(), inout exe) {
        return Result::Err(io_err(invalid_input()));
    }
    let n = exe.len();
    if n == 0 {
        return Result::Err(io_err(invalid_input()));
    }
    let last = get16(in exe.as_slice(), wrapping_sub(n, 1));
    let verbatim = n >= 4
        && get16(in exe.as_slice(), 0) == 92
        && get16(in exe.as_slice(), 1) == 92
        && get16(in exe.as_slice(), 2) == 63
        && get16(in exe.as_slice(), 3) == 92;
    if last == 92 || (!verbatim && last == 47) {
        return Result::Err(io_err(invalid_input()));
    }
    let mut file_name = true;
    let mut has_extension = false;
    for i in 0..n {
        let u = get16(in exe.as_slice(), i);
        if is_sep16(u) {
            file_name = false;
        }
        if u == 46 {
            has_extension = true;
        }
    }
    if !file_name {
        if ends_with_exe16(in exe.as_slice()) {
            return Result::Ok(exe);
        }
        let mut with_exe: ChunkSeq[u16] = ChunkSeq::new[u16]();
        with_exe.extend(in exe.as_slice());
        with_exe.push(46);
        with_exe.push(101);
        with_exe.push(120);
        with_exe.push(101);
        if exists16(in with_exe.as_slice()) {
            return Result::Ok(with_exe);
        }
        return Result::Ok(exe);
    }
    // 1. The child's `PATH`, when the command changed it.
    match child_path16(in c) {
        Option::Some(Option::Some(paths)) => {
            let found = search16(in paths.as_slice(), in exe.as_slice(), has_extension);
            if found.len() != 0 {
                return Result::Ok(found);
            }
        },
        _ => {},
    }
    // 2. The application's directory; 3 and 4. the system directories.
    for which in 0..3 {
        let mut dir = host_dir16(wrapping_u8(which));
        if which == 0 {
            dir = parent16(in dir.as_slice());
        }
        if dir.len() != 0 {
            let c16 = candidate16(in dir.as_slice(), in exe.as_slice(), has_extension);
            if exists16(in c16.as_slice()) {
                return Result::Ok(c16);
            }
        }
    }
    // 5. The parent's `PATH`.
    match parent_path16() {
        Option::Some(paths) => {
            let found = search16(in paths.as_slice(), in exe.as_slice(), has_extension);
            if found.len() != 0 {
                return Result::Ok(found);
            }
        },
        Option::None => {},
    }
    Result::Err(io_err(program_not_found()))
}

pub fn spawn(sink c: ProcCommand) -> Result[ProcChild, IoError] eff [Ffi[StdProcess]] {
    if contains_byte(in c.program.as_slice(), 0) {
        return Result::Err(IoError { kind: invalid_input(), os: 0 });
    }
    let app = match resolve_exe(in c) {
        Result::Ok(a) => a,
        Result::Err(e) => return Result::Err(e),
    };
    let mut cmd_w: ChunkSeq[u16] = ChunkSeq::new[u16]();
    if !build_cmd_line(in c, inout cmd_w) {
        return Result::Err(IoError { kind: invalid_input(), os: 0 });
    }
    let mut out_r: u64 = 0;
    let mut out_w: u64 = 0;
    if c.stdout_mode == capture() {
        match make_capture_pipe() {
            Result::Ok((r, w)) => {
                out_r = r;
                out_w = w;
            },
            Result::Err(e) => return Result::Err(e),
        }
    }
    let mut err_r: u64 = 0;
    let mut err_w: u64 = 0;
    if c.stderr_mode == capture() {
        match make_capture_pipe() {
            Result::Ok((r, w)) => {
                err_r = r;
                err_w = w;
            },
            Result::Err(e) => {
                close_handle_if(out_r);
                close_handle_if(out_w);
                return Result::Err(e);
            },
        }
    }
    let mut nul_in: u64 = 0;
    let h_in = if c.stdin_mode == null() {
        nul_in = open_nul_handle(false);
        nul_in
    } else {
        StdProcess::GetStdHandle(StdProcess::STD_INPUT_HANDLE)
    };
    let mut nul_out: u64 = 0;
    let h_out = if c.stdout_mode == capture() {
        out_w
    } else if c.stdout_mode == null() {
        nul_out = open_nul_handle(true);
        nul_out
    } else {
        StdProcess::GetStdHandle(StdProcess::STD_OUTPUT_HANDLE)
    };
    let mut nul_err: u64 = 0;
    let h_err = if c.stderr_mode == capture() {
        err_w
    } else if c.stderr_mode == null() {
        nul_err = open_nul_handle(true);
        nul_err
    } else {
        StdProcess::GetStdHandle(StdProcess::STD_ERROR_HANDLE)
    };
    let env_ptr = build_env_block(in c);
    let mut cwd_ptr: u64 = 0;
    if c.has_cwd {
        let mut cwd_w: ChunkSeq[u16] = ChunkSeq::new[u16]();
        if !utf8_to_utf16(in c.cwd.as_slice(), inout cwd_w) {
            free_heap_ptr(env_ptr);
            close_handle_if(out_r);
            close_handle_if(out_w);
            close_handle_if(err_r);
            close_handle_if(err_w);
            close_handle_if(nul_in);
            close_handle_if(nul_out);
            close_handle_if(nul_err);
            return Result::Err(IoError { kind: invalid_input(), os: 0 });
        }
        cwd_ptr = alloc_utf16_bytes(in cwd_w.as_slice(), false);
    }
    let si = StartupInfoW {
        cb: 104,
        pad0: 0,
        reserved: 0,
        desktop: 0,
        title: 0,
        x: 0,
        y: 0,
        x_size: 0,
        y_size: 0,
        x_count_chars: 0,
        y_count_chars: 0,
        fill_attr: 0,
        flags: StdProcess::STARTF_USESTDHANDLES,
        show_window: 0,
        cb_reserved2: 0,
        pad1: 0,
        reserved2: 0,
        std_input: h_in,
        std_output: h_out,
        std_error: h_err,
    };
    let mut pi = ProcessInfo {
        h_process: 0,
        h_thread: 0,
        pid: 0,
        tid: 0,
    };
    let flags = if env_ptr != 0 {
        StdProcess::CREATE_UNICODE_ENVIRONMENT
    } else {
        0
    };
    let flags = if c.group {
        flags | StdProcess::CREATE_SUSPENDED
    } else {
        flags
    };
    let app_ptr = alloc_utf16_bytes(in app.as_slice(), false);
    let res = StdProcess::CreateProcessW(
        app_ptr,
        in cmd_w.as_slice(),
        0,
        0,
        1,
        flags,
        env_ptr,
        cwd_ptr,
        in si,
        inout pi
    );
    free_heap_ptr(app_ptr);
    free_heap_ptr(env_ptr);
    free_heap_ptr(cwd_ptr);
    close_handle_if(out_w);
    close_handle_if(err_w);
    close_handle_if(nul_in);
    close_handle_if(nul_out);
    close_handle_if(nul_err);
    match res {
        Result::Ok((ok, err)) => {
            if ok == 0 {
                close_handle_if(out_r);
                close_handle_if(err_r);
                return Result::Err(error_of(widen_u64(err)));
            }
        },
        Result::Err(_) => {
            close_handle_if(out_r);
            close_handle_if(err_r);
            return Result::Err(IoError { kind: invalid_input(), os: 0 });
        },
    }
    // A suspended child joins its job before it can start anything; if
    // Windows refuses the job, it runs without one (`kill_tree` then
    // stops the child alone).
    let mut job: u64 = 0;
    if c.group {
        let (j, _) = StdProcess::CreateJobObjectW(0, 0);
        job = j;
        if job != 0 {
            let (joined, _) = StdProcess::AssignProcessToJobObject(job, pi.h_process);
            if joined == 0 {
                close_handle_if(job);
                job = 0;
            }
        }
        let _ = StdProcess::ResumeThread(pi.h_thread);
    }
    close_handle_if(pi.h_thread);
    Result::Ok(ProcChild {
        h_process: pi.h_process,
        stdout_h: out_r,
        stderr_h: err_r,
        stdout_buf: ChunkSeq::new[u8](),
        stderr_buf: ChunkSeq::new[u8](),
        waited: false,
        job: job,
        limit: c.limit,
        cut: false,
    })
}

// Append `src[0..n]` to `dst`, keeping at most `limit` bytes (0: all);
// `cut` is set when bytes are dropped.
fn keep(inout dst: ChunkSeq[u8], in src: Slice[u8], n: u64, limit: u64, inout cut: bool) {
    let room = if limit == 0 {
        n
    } else if dst.len() >= limit {
        0
    } else {
        wrapping_sub(limit, dst.len())
    };
    let take = if n < room { n } else { room };
    if take < n {
        cut = true;
    }
    dst.extend(in src[0..take]);
}

fn drain_pipe(h: u64, inout dst: ChunkSeq[u8], limit: u64, inout cut: bool) eff [Ffi[StdProcess]] {
    if h == 0 {
        return;
    }
    let mut tmp: ChunkSeq[u8] = ChunkSeq::new[u8]();
    tmp.resize(4096, 0);
    let mut n = DwordBox { v: 0 };
    loop {
        n.v = 0;
        let (ok, _) = StdProcess::ReadFile(h, inout tmp.as_slice_mut(), inout n, 0);
        if ok == 0 || n.v == 0 {
            break;
        }
        let cnt = widen_u64(n.v);
        keep(inout dst, in tmp.as_slice(), cnt, limit, inout cut);
    }
    close_handle_if(h);
}

// Read what is waiting in pipe `h` now, without blocking: the new handle
// (0 once the pipe has ended and is closed) and whether bytes came.
fn pump_pipe(
    h: u64,
    inout dst: ChunkSeq[u8],
    limit: u64,
    inout cut: bool
) -> (u64, bool) eff [Ffi[StdProcess]] {
    if h == 0 {
        return (0, false);
    }
    let mut avail = DwordBox { v: 0 };
    let (ok, _) = StdProcess::PeekNamedPipe(h, 0, 0, 0, inout avail, 0);
    if ok == 0 {
        // The writers are gone (`ERROR_BROKEN_PIPE`) or the pipe failed:
        // either way nothing more comes.
        close_handle_if(h);
        return (0, false);
    }
    if avail.v == 0 {
        return (h, false);
    }
    let want = if avail.v > 65536 { 65536 } else { avail.v };
    let mut tmp: ChunkSeq[u8] = ChunkSeq::new[u8]();
    tmp.resize(widen_u64(want), 0);
    let mut n = DwordBox { v: 0 };
    let (rok, _) = StdProcess::ReadFile(h, inout tmp.as_slice_mut(), inout n, 0);
    if rok == 0 || n.v == 0 {
        close_handle_if(h);
        return (0, false);
    }
    keep(inout dst, in tmp.as_slice(), widen_u64(n.v), limit, inout cut);
    (h, true)
}

// The exit status of an ended child; its handles (and job) are closed
// and it counts as waited for.
fn finish(inout ch: ProcChild) -> Result[ExitStatus, IoError] eff [Ffi[StdProcess]] {
    let mut code = DwordBox { v: 0 };
    let (ok, err) = StdProcess::GetExitCodeProcess(ch.h_process, inout code);
    close_handle_if(ch.h_process);
    ch.h_process = 0;
    close_handle_if(ch.job);
    ch.job = 0;
    ch.waited = true;
    if ok == 0 {
        return Result::Err(error_of(widen_u64(err)));
    }
    Result::Ok(ExitStatus {
        code: widen_i64(code.v),
        signal: 0,
        exited: true,
    })
}

pub fn wait(inout ch: ProcChild) -> Result[ExitStatus, IoError] eff [Ffi[StdProcess]] {
    if ch.waited {
        return Result::Err(IoError { kind: invalid_input(), os: 0 });
    }
    drain_pipe(ch.stdout_h, inout ch.stdout_buf, ch.limit, inout ch.cut);
    ch.stdout_h = 0;
    drain_pipe(ch.stderr_h, inout ch.stderr_buf, ch.limit, inout ch.cut);
    ch.stderr_h = 0;
    let _ = StdProcess::WaitForSingleObject(ch.h_process, StdProcess::INFINITE);
    finish(inout ch)
}

// Wait at most `millis` milliseconds for the child to end, collecting
// captured output meanwhile: `Some(status)` once it has ended and its
// captured streams are drained, as `wait` returns it (the child is then
// waited for), or `None` when the time runs out first (the child, and
// what it wrote so far, stay; wait again, or `kill_tree`). 0 milliseconds
// only checks. Waiting for a waited child is an `invalid_input()` error.
pub fn wait_timeout(
    inout ch: ProcChild,
    millis: u64
) -> Result[Option[ExitStatus], IoError] eff [Ffi[StdProcess]] {
    if ch.waited {
        return Result::Err(IoError { kind: invalid_input(), os: 0 });
    }
    let start = StdProcess::GetTickCount64();
    loop {
        let (oh, ogot) = pump_pipe(ch.stdout_h, inout ch.stdout_buf, ch.limit, inout ch.cut);
        ch.stdout_h = oh;
        let (eh, egot) = pump_pipe(ch.stderr_h, inout ch.stderr_buf, ch.limit, inout ch.cut);
        ch.stderr_h = eh;
        let ended = StdProcess::WaitForSingleObject(ch.h_process, 0) == StdProcess::WAIT_OBJECT_0;
        if ended && ch.stdout_h == 0 && ch.stderr_h == 0 {
            return match finish(inout ch) {
                Result::Ok(s) => Result::Ok(Option::Some(s)),
                Result::Err(e) => Result::Err(e),
            };
        }
        let spent = wrapping_sub(StdProcess::GetTickCount64(), start);
        if spent >= millis {
            return Result::Ok(Option::None);
        }
        if !ogot && !egot {
            let left = wrapping_sub(millis, spent);
            let slice = if left < 5 { left } else { 5 };
            if ended {
                StdProcess::Sleep(wrapping_u32(slice));
            } else {
                let _ = StdProcess::WaitForSingleObject(ch.h_process, wrapping_u32(slice));
            }
        }
    }
}

// Kill the child and, under `process_group`, every process in its job,
// then wait for it. The captured streams are closed without reading on;
// what they carried so far stays. The child's status (exit code 1 when
// killed), or `invalid_input()` for a child already waited for.
pub fn kill_tree(inout ch: ProcChild) -> Result[ExitStatus, IoError] eff [Ffi[StdProcess]] {
    if ch.waited {
        return Result::Err(IoError { kind: invalid_input(), os: 0 });
    }
    if ch.job != 0 {
        let _ = StdProcess::TerminateJobObject(ch.job, 1);
    }
    let _ = StdProcess::TerminateProcess(ch.h_process, 1);
    close_handle_if(ch.stdout_h);
    ch.stdout_h = 0;
    close_handle_if(ch.stderr_h);
    ch.stderr_h = 0;
    let _ = StdProcess::WaitForSingleObject(ch.h_process, StdProcess::INFINITE);
    finish(inout ch)
}

// Whether a captured stream went past the `capture_limit` (its first
// bytes were kept, the rest dropped).
pub fn truncated(in ch: ProcChild) -> bool {
    ch.cut
}

pub fn stdout(in ch: ProcChild) -> ChunkSeq[u8] {
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    out.extend(in ch.stdout_buf.as_slice());
    out
}

pub fn stderr(in ch: ProcChild) -> ChunkSeq[u8] {
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    out.extend(in ch.stderr_buf.as_slice());
    out
}

pub fn child_id(in ch: ProcChild) -> u64 eff [Ffi[StdProcess]] {
    if ch.waited || ch.h_process == 0 {
        0
    } else {
        widen_u64(StdProcess::GetProcessId(ch.h_process))
    }
}

pub fn release(sink ch: ProcChild) eff [Ffi[StdProcess]] {
    close_handle_if(ch.stdout_h);
    close_handle_if(ch.stderr_h);
    if !ch.waited && ch.h_process != 0 {
        if ch.job != 0 {
            let _ = StdProcess::TerminateJobObject(ch.job, 1);
        }
        let _ = StdProcess::TerminateProcess(ch.h_process, 1);
        let _ = StdProcess::WaitForSingleObject(ch.h_process, StdProcess::INFINITE);
        close_handle_if(ch.h_process);
    }
    close_handle_if(ch.job);
}

pub fn output(sink c: ProcCommand) -> Output eff [Ffi[StdProcess], Fail[IoError]] {
    let mut c = c;
    stdio(inout c, stdin_stream(), null());
    stdio(inout c, stdout_stream(), capture());
    stdio(inout c, stderr_stream(), capture());
    let mut ch = match spawn(c) {
        Result::Ok(ch) => ch,
        Result::Err(e) => return Fail::raise(e),
    };
    let waited = wait(inout ch);
    let out = stdout(in ch);
    let err = stderr(in ch);
    release(ch);
    match waited {
        Result::Ok(s) => Output {
            status: s,
            stdout: out,
            stderr: err,
        },
        Result::Err(e) => Fail::raise(e),
    }
}

pub fn exit(code: i64) eff [Ffi[StdProcess]] {
    StdProcess::ExitProcess(wrapping_u32(wrapping_u64(code)));
}

pub fn id() -> u64 eff [Ffi[StdProcess]] {
    widen_u64(StdProcess::GetCurrentProcessId())
}

// ---------------------------------------------------------------------------
// This process's standard input.

// How long `read_wait` sleeps between looks at a pipe, in milliseconds.
const PEEK_SLICE_MS: u64 = 5;
// `read_wait`'s answers for the end of the stream and for a wait that
// passed with nothing to read.
const READ_END: i64 = 0;
const READ_WAITED: i64 = -1;

// This process's standard input, for `read_wait`: a `HANDLE`.
pub fn stdin_handle() -> u64 eff [Ffi[StdProcess]] {
    StdProcess::GetStdHandle(StdProcess::STD_INPUT_HANDLE)
}

// Read what the open stream `stream` holds into `buf` (which is not
// empty), waiting at most `wait_ms` milliseconds for bytes (negative: no
// limit): the bytes read, 0 at the end of the stream, or -1 when the wait
// passed with nothing to read. A pipe is watched with `PeekNamedPipe`;
// any other stream (a console, a file) is read without a time limit.
pub fn read_wait(
    stream: u64,
    inout buf: Slice[u8],
    wait_ms: i64
) -> Result[i64, IoError] eff [Ffi[StdProcess]] {
    if wait_ms >= 0 {
        let millis = wrapping_u64(wait_ms);
        let start = StdProcess::GetTickCount64();
        loop {
            let mut avail = DwordBox { v: 0 };
            let (ok, e) = StdProcess::PeekNamedPipe(stream, 0, 0, 0, inout avail, 0);
            if ok == 0 {
                if e == StdProcess::ERROR_BROKEN_PIPE {
                    return Result::Ok(READ_END);
                }
                break;
            }
            if avail.v > 0 {
                break;
            }
            let spent = wrapping_sub(StdProcess::GetTickCount64(), start);
            if spent >= millis {
                return Result::Ok(READ_WAITED);
            }
            let left = wrapping_sub(millis, spent);
            StdProcess::Sleep(wrapping_u32(
                if left < PEEK_SLICE_MS {
                    left
                } else {
                    PEEK_SLICE_MS
                }
            ));
        }
    }
    let mut n = DwordBox { v: 0 };
    let (ok, e) = StdProcess::ReadFile(stream, inout buf, inout n, 0);
    if ok == 0 {
        if e == StdProcess::ERROR_BROKEN_PIPE {
            return Result::Ok(READ_END);
        }
        return Result::Err(error_of(widen_u64(e)));
    }
    Result::Ok(widen_i64(n.v))
}
