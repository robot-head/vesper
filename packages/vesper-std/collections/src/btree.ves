// @vesper-std/collections::btree: `CacheBTree[K, V]`, an ordered map kept
// as a B+tree with 16 keys per node (manuscript chapter 13).
//
// Nodes live in flat arenas indexed by `u64` node ids, so the tree holds no
// pointers and relocates with a plain copy. Leaf `l` keeps its entries at
// `l * 16 ..` of `lkeys`/`lvals` and is linked to its neighbours in key
// order. Internal node `n` keeps its separators at `n * 16 ..` of `ikeys`
// and its children at `n * 17 ..` of `ikids`; child `i` holds the keys `k`
// with `sep[i - 1] <= k < sep[i]`.
//
// Removal does not merge or free nodes: a leaf may become empty and stays
// linked, and every read skips empty leaves. Results never depend on node
// shape, only on the keys present.

// Absent node id.
fn none_id() -> u64 {
    18446744073709551615
}

// A position in key order: entry `pos` of leaf `leaf`, or the end when
// `leaf` is absent.
pub copy struct BTreeCursor {
    leaf: u64,
    pos: u64
}

pub struct CacheBTree[K, V] {
    lkeys: ChunkSeq[K],
    lvals: ChunkSeq[V],
    lcount: ChunkSeq[u64],
    lnext: ChunkSeq[u64],
    lprev: ChunkSeq[u64],
    ikeys: ChunkSeq[K],
    ikids: ChunkSeq[u64],
    icount: ChunkSeq[u64],
    // Scratch for one insertion: the internal nodes visited and the child
    // slot taken in each, and an oversized node during a split.
    path: ChunkSeq[u64],
    slots: ChunkSeq[u64],
    split_keys: ChunkSeq[K],
    split_kids: ChunkSeq[u64],
    root: u64,
    height: u64,
    len: u64
}

// Read `s[i]`, or `fallback` out of range.
fn at[T: mod copy](in s: Slice[T], i: u64, fallback: T) -> T {
    match s.try_get(i) {
        Option::Some(x) => x,
        Option::None => fallback,
    }
}

// An empty ordered map.
pub fn btree_new[K: mod copy + Ord, V: mod copy]() -> CacheBTree[K, V] {
    CacheBTree {
        lkeys: ChunkSeq::new[K](),
        lvals: ChunkSeq::new[V](),
        lcount: ChunkSeq::new[u64](),
        lnext: ChunkSeq::new[u64](),
        lprev: ChunkSeq::new[u64](),
        ikeys: ChunkSeq::new[K](),
        ikids: ChunkSeq::new[u64](),
        icount: ChunkSeq::new[u64](),
        path: ChunkSeq::new[u64](),
        slots: ChunkSeq::new[u64](),
        split_keys: ChunkSeq::new[K](),
        split_kids: ChunkSeq::new[u64](),
        root: none_id(),
        height: 0,
        len: 0
    }
}

impl [K: mod copy + Ord, V: mod copy] CacheBTree[K, V] {
    // Number of entries.
    pub fn len(in self) -> u64 {
        self.len
    }

    pub fn is_empty(in self) -> bool {
        self.len == 0
    }

    // Remove every entry and release nothing (the arenas are reused).
    pub fn clear(inout self) {
        self.lkeys.clear();
        self.lvals.clear();
        self.lcount.clear();
        self.lnext.clear();
        self.lprev.clear();
        self.ikeys.clear();
        self.ikids.clear();
        self.icount.clear();
        self.root = none_id();
        self.height = 0;
        self.len = 0;
    }

    fn leaf_count(in self, leaf: u64) -> u64 {
        at(in self.lcount.as_slice(), leaf, 0)
    }

    fn leaf_next(in self, leaf: u64) -> u64 {
        at(in self.lnext.as_slice(), leaf, none_id())
    }

    fn leaf_prev(in self, leaf: u64) -> u64 {
        at(in self.lprev.as_slice(), leaf, none_id())
    }

    fn kid(in self, node: u64, slot: u64) -> u64 {
        at(in self.ikids.as_slice(), wrapping_add(wrapping_mul(node, 17), slot), none_id())
    }

    // The child slot of `node` whose range holds `k`.
    fn child_slot(in self, node: u64, k: K) -> u64 {
        let n = at(in self.icount.as_slice(), node, 0);
        let base = wrapping_mul(node, 16);
        let mut i: u64 = 0;
        loop {
            if i >= n {
                break n;
            }
            match self.ikeys.try_get(wrapping_add(base, i)) {
                Option::Some(sep) => {
                    match k.cmp(sep) {
                        Less => {
                            break i;
                        },
                        _ => {},
                    }
                },
                Option::None => {
                    break n;
                },
            }
            i = wrapping_add(i, 1);
        }
    }

    // The first position in `leaf` whose key is not below `k`.
    fn leaf_pos(in self, leaf: u64, k: K) -> u64 {
        let n = self.leaf_count(leaf);
        let base = wrapping_mul(leaf, 16);
        let mut i: u64 = 0;
        loop {
            if i >= n {
                break n;
            }
            match self.lkeys.try_get(wrapping_add(base, i)) {
                Option::Some(x) => {
                    match x.cmp(k) {
                        Less => {},
                        _ => {
                            break i;
                        },
                    }
                },
                Option::None => {
                    break n;
                },
            }
            i = wrapping_add(i, 1);
        }
    }

    // The leaf whose range holds `k` (the tree must be non-empty).
    fn find_leaf(in self, k: K) -> u64 {
        let mut node = self.root;
        let mut h = self.height;
        loop {
            if h == 0 {
                break node;
            }
            node = self.kid(node, self.child_slot(node, k));
            h = wrapping_sub(h, 1);
        }
    }

    // The value for `k`, if present.
    pub fn get(in self, k: K) -> Option[V] {
        if self.root == none_id() {
            return Option::None;
        }
        let leaf = self.find_leaf(k);
        let n = self.leaf_count(leaf);
        let pos = self.leaf_pos(leaf, k);
        if pos >= n {
            return Option::None;
        }
        let i = wrapping_add(wrapping_mul(leaf, 16), pos);
        match self.lkeys.try_get(i) {
            Option::Some(found) => {
                match found.cmp(k) {
                    Equal => self.lvals.try_get(i),
                    _ => Option::None,
                }
            },
            Option::None => Option::None,
        }
    }

    pub fn contains_key(in self, k: K) -> bool {
        match self.get(k) {
            Option::Some(_) => true,
            Option::None => false,
        }
    }
}
