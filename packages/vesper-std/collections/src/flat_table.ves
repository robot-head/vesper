// @vesper-std/collections::flat_table: `FlatTable[K, V]`, a hash map
// (manuscript chapter 13) with a deterministic hasher.
//
// Entries are stored densely in insertion order; an open-addressing index
// of `u64` slots (linear probing, power-of-two capacity) maps hashes to
// entry positions. Removal moves the last entry into the hole, so the
// order of entries is a function of the operations performed and never of
// hash values or capacity: iterating by position is deterministic.
//
// Slot values: 0 is empty, `none_id()` is a tombstone, anything else is an
// entry position plus one.
//
// `V` need not be copy (self-hosting SH2 lane 1): `vals` holds the values in
// entry order, `insert` moves a value in (and the replaced one out) and
// `remove` moves the value out. A value that is not copy is read in place,
// as an element view of `vals`:
// `match t.vals.try_get(t.position(k)) { Some(v) => .., None => .. }`, and
// `try_get_mut` to update one; `position` is `none_id()` for an absent key.

fn none_id() -> u64 {
    18446744073709551615
}

fn at[T: mod copy](in s: Slice[T], i: u64, fallback: T) -> T {
    match s.try_get(i) {
        Option::Some(x) => x,
        Option::None => fallback,
    }
}

// The builtin `Hash` (FNV-style, deterministic) with its bits mixed so
// that the low bits used for probing depend on every input bit.
fn mix(h: u64) -> u64 {
    let a = wrapping_mul(h ^ (h >> 33), 18397679294719823053);
    let b = wrapping_mul(a ^ (a >> 33), 14181476777654086739);
    b ^ (b >> 33)
}

pub struct FlatTable[K, V] {
    keys: ChunkSeq[K],
    vals: ChunkSeq[V],
    hashes: ChunkSeq[u64],
    slots: ChunkSeq[u64],
    mask: u64,
    tombs: u64
}

// An empty table.
pub fn flat_table_new[K: mod copy + Eq + Hash, V: mod affine]() -> FlatTable[K, V] {
    let mut slots: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut i: u64 = 0;
    loop {
        if i >= 8 {
            break;
        }
        slots.push(0);
        i = wrapping_add(i, 1);
    }
    FlatTable {
        keys: ChunkSeq::new[K](),
        vals: ChunkSeq::new[V](),
        hashes: ChunkSeq::new[u64](),
        slots: slots,
        mask: 7,
        tombs: 0
    }
}

impl [K: mod copy + Eq + Hash, V: mod affine] FlatTable[K, V] {
    pub fn len(in self) -> u64 {
        self.keys.len()
    }

    pub fn is_empty(in self) -> bool {
        self.keys.len() == 0
    }

    // The slot holding `k`, or `none_id()`.
    fn find_slot(in self, k: K, h: u64) -> u64 {
        let mut i = h & self.mask;
        loop {
            let s = at(in self.slots.as_slice(), i, 0);
            if s == 0 {
                break none_id();
            }
            if s != none_id() {
                let e = wrapping_sub(s, 1);
                if at(in self.hashes.as_slice(), e, 0) == h {
                    match self.keys.try_get(e) {
                        Option::Some(x) => {
                            if x.eq(k) {
                                break i;
                            }
                        },
                        Option::None => {},
                    }
                }
            }
            i = wrapping_add(i, 1) & self.mask;
        }
    }

    // The slot whose value is `value` on the probe path of hash `h`.
    fn slot_of(in self, h: u64, value: u64) -> u64 {
        let mut i = h & self.mask;
        loop {
            let s = at(in self.slots.as_slice(), i, 0);
            if s == value || s == 0 {
                break i;
            }
            i = wrapping_add(i, 1) & self.mask;
        }
    }

    // Put entry position `e` (hash `h`) in the first free slot of its path.
    fn place(inout self, h: u64, e: u64) {
        let mut i = h & self.mask;
        loop {
            let s = at(in self.slots.as_slice(), i, 0);
            if s == 0 || s == none_id() {
                if s == none_id() {
                    self.tombs = wrapping_sub(self.tombs, 1);
                }
                self.slots.try_set(i, wrapping_add(e, 1));
                break;
            }
            i = wrapping_add(i, 1) & self.mask;
        }
    }

    // Rebuild the index with `capacity` slots (a power of two).
    fn rebuild(inout self, capacity: u64) {
        self.slots.clear();
        let mut i: u64 = 0;
        loop {
            if i >= capacity {
                break;
            }
            self.slots.push(0);
            i = wrapping_add(i, 1);
        }
        self.mask = wrapping_sub(capacity, 1);
        self.tombs = 0;
        let n = self.keys.len();
        let mut e: u64 = 0;
        loop {
            if e >= n {
                break;
            }
            let h = at(in self.hashes.as_slice(), e, 0);
            self.place(h, e);
            e = wrapping_add(e, 1);
        }
    }

    // Insert or replace; the previous value for `k`, if any. The value is
    // moved in, and the previous one moved out.
    pub fn insert(inout self, k: K, sink v: V) -> Option[V] {
        let h = mix(k.hash());
        let s = self.find_slot(k, h);
        if s != none_id() {
            let e = wrapping_sub(at(in self.slots.as_slice(), s, 1), 1);
            return match self.vals.try_get_mut(e) {
                Option::Some(slot) => Option::Some(replace(inout slot, v)),
                Option::None => Option::None,
            };
        }
        // Keep occupied slots plus tombstones at most 7/8 of capacity.
        let capacity = wrapping_add(self.mask, 1);
        let used = wrapping_add(wrapping_add(self.keys.len(), self.tombs), 1);
        if wrapping_mul(used, 8) > wrapping_mul(capacity, 7) {
            let live = wrapping_add(self.keys.len(), 1);
            let grown = if wrapping_mul(live, 2) > capacity {
                wrapping_mul(capacity, 2)
            } else {
                capacity
            };
            self.rebuild(grown);
        }
        let e = self.keys.len();
        self.keys.push(k);
        self.vals.push(v);
        self.hashes.push(h);
        self.place(h, e);
        Option::None
    }

    // The entry position of `k` (its value's index in `vals`), or
    // `none_id()` when `k` is absent.
    pub fn position(in self, k: K) -> u64 {
        let h = mix(k.hash());
        let s = self.find_slot(k, h);
        if s == none_id() {
            return none_id();
        }
        wrapping_sub(at(in self.slots.as_slice(), s, 1), 1)
    }

    pub fn contains_key(in self, k: K) -> bool {
        let h = mix(k.hash());
        self.find_slot(k, h) != none_id()
    }

    // Remove `k`; its value, if it was present. The last entry takes the
    // removed entry's position.
    pub fn remove(inout self, k: K) -> Option[V] {
        let h = mix(k.hash());
        let s = self.find_slot(k, h);
        if s == none_id() {
            return Option::None;
        }
        let e = wrapping_sub(at(in self.slots.as_slice(), s, 1), 1);
        self.slots.try_set(s, none_id());
        self.tombs = wrapping_add(self.tombs, 1);
        let last = wrapping_sub(self.keys.len(), 1);
        if e != last {
            let lh = at(in self.hashes.as_slice(), last, 0);
            let ls = self.slot_of(lh, wrapping_add(last, 1));
            self.slots.try_set(ls, wrapping_add(e, 1));
            match self.keys.try_get(last) {
                Option::Some(x) => {
                    self.keys.try_set(e, x);
                },
                Option::None => {},
            }
            self.hashes.try_set(e, lh);
        }
        self.keys.pop();
        self.hashes.pop();
        // The last value moves into the hole and the removed one out.
        match self.vals.pop() {
            Option::Some(moved) => {
                if e == last {
                    Option::Some(moved)
                } else {
                    match self.vals.try_get_mut(e) {
                        Option::Some(slot) => Option::Some(replace(inout slot, moved)),
                        Option::None => Option::None,
                    }
                }
            },
            Option::None => Option::None,
        }
    }

    // Remove every entry.
    pub fn clear(inout self) {
        self.keys.clear();
        self.vals.clear();
        self.hashes.clear();
        self.rebuild(8);
    }

    // Append every key to `out`, in entry order.
    pub fn keys_into(in self, inout out: ChunkSeq[K]) {
        out.extend(in self.keys.as_slice());
    }

    // The key at entry position `i` (0 ..< len).
    pub fn key_at(in self, i: u64) -> Option[K] {
        self.keys.try_get(i)
    }
}

impl [K: mod copy + Eq + Hash, V: mod copy] FlatTable[K, V] {
    // The value for `k`, if present.
    pub fn get(in self, k: K) -> Option[V] {
        self.vals.try_get(self.position(k))
    }

    // The entry at position `i` (0 ..< len), in the deterministic entry
    // order described above.
    pub fn entry_at(in self, i: u64) -> Option[(K, V)] {
        match self.keys.try_get(i) {
            Option::Some(k) => {
                match self.vals.try_get(i) {
                    Option::Some(v) => Option::Some((k, v)),
                    Option::None => Option::None,
                }
            },
            Option::None => Option::None,
        }
    }
}

test {
    // @case empty(0, 8)
    // @case at_threshold(7, 8)
    // @case exceeds_threshold(8, 16)
    fn test_slot_capacity(count: u64, capacity: u64) -> bool {
        let mut table = flat_table_new[u64, u64]();
        for i in 0..count {
            let value = i;
            table.insert(i, value);
        }
        table.slots.len() == capacity && table.mask == wrapping_sub(capacity, 1)
    }

    fn test_slot_search_wraps_past_occupied_slots() -> bool {
        let mut table = flat_table_new[u64, u64]();
        table.slots.try_set(7, 1);
        table.slots.try_set(0, 2);
        table.slot_of(7, 2) == 0 && table.slot_of(7, 3) == 1
    }

    fn test_rebuild_at_half_live_capacity_clears_tombstones() -> bool {
        let mut table = flat_table_new[u64, u64]();
        let count: u64 = 7;
        for i in 0..count {
            let value = i;
            table.insert(i, value);
        }
        for i in 0..4 {
            table.remove(i);
        }
        table.insert(7, 7);
        if table.slots.len() != 8 || table.tombs != 0 || table.len() != 4 {
            return false;
        }
        let start: u64 = 4;
        for i in start..8 {
            if table.get(i) != Option::Some(i) {
                return false;
            }
        }
        let mut occupied: u64 = 0;
        for i in 0..8 {
            if table.slots.try_get(i) != Option::Some(0) {
                occupied = wrapping_add(occupied, 1);
            }
        }
        occupied == 4
    }

    // @case empty(0)
    // @case one(1)
    // @case at_load_threshold(7)
    // @case crosses_load_threshold(8)
    // @case repeated_growth(40)
    fn test_insert_replace_and_clear(count: u64) -> bool {
        let mut table = flat_table_new[u64, u64]();
        if !table.is_empty() || table.len() != 0 {
            return false;
        }
        for k in 0..count {
            if table.insert(k, wrapping_add(k, 100)) != Option::None {
                return false;
            }
        }
        let mut keys = ChunkSeq::new[u64]();
        keys.push(999);
        table.keys_into(inout keys);
        if keys.len() != wrapping_add(count, 1) || keys.try_get(0) != Option::Some(999) {
            return false;
        }
        for k in 0..count {
            let previous = wrapping_add(k, 100);
            let replacement = wrapping_add(k, 200);
            if keys
                .try_get(wrapping_add(k, 1))
                != Option::Some(k)
                || !table
                .contains_key(k)
                || table
                .entry_at(k)
                != Option::Some((k, previous))
                || table
                .insert(k, replacement)
                != Option::Some(previous)
                || table
                .get(k)
                != Option::Some(replacement)
                || table
                .entry_at(k)
                != Option::Some((k, replacement)) {
                return false;
            }
        }
        if table
            .len()
            != count
            || table
            .contains_key(count)
            || table
            .get(count)
            != Option::None
            || table
            .entry_at(count)
            != Option::None {
            return false;
        }
        table.clear();
        table
            .len()
            == 0
            && table
            .is_empty()
            && table
            .get(0)
            == Option::None
            && table
            .insert(0, 11)
            == Option::None
            && table
            .get(0)
            == Option::Some(11)
    }

    // @case first(0, 2, 1)
    // @case middle(1, 0, 2)
    // @case last(2, 0, 1)
    fn test_remove_and_reinsert(removed_key: u64, first: u64, second: u64) -> bool {
        let mut table = flat_table_new[u64, u64]();
        for k in 0..3 {
            table.insert(k, wrapping_add(k, 10));
        }
        if table
            .remove(removed_key)
            != Option::Some(wrapping_add(removed_key, 10))
            || table
            .remove(removed_key)
            != Option::None
            || table
            .len()
            != 2
            || table
            .contains_key(removed_key)
            || table
            .entry_at(0)
            != Option::Some((first, wrapping_add(first, 10)))
            || table
            .entry_at(1)
            != Option::Some((second, wrapping_add(second, 10)))
            || table
            .get(first)
            != Option::Some(wrapping_add(first, 10))
            || table
            .get(second)
            != Option::Some(wrapping_add(second, 10)) {
            return false;
        }
        let replacement: u64 = 99;
        table
            .insert(removed_key, replacement)
            == Option::None
            && table
            .len()
            == 3
            && table
            .get(removed_key)
            == Option::Some(replacement)
            && table
            .entry_at(2)
            == Option::Some((removed_key, replacement))
    }

    // @case first_key(0)
    // @case different_initial_probe(17)
    fn test_lookup_across_tombstone(first: u64) -> bool {
        let mut table = flat_table_new[u64, u64]();
        let slot = mix(first.hash()) & table.mask;
        let mut later = wrapping_add(first, 1);
        loop {
            if (mix(later.hash()) & table.mask) == slot {
                break;
            }
            later = wrapping_add(later, 1);
        }
        table.insert(first, 10);
        table.insert(later, 20);
        table
            .remove(first)
            == Option::Some(10)
            && table
            .get(later)
            == Option::Some(20)
            && table
            .insert(later, 21)
            == Option::Some(20)
            && table
            .insert(first, 11)
            == Option::None
            && table
            .get(first)
            == Option::Some(11)
            && table
            .get(later)
            == Option::Some(21)
            && table
            .len()
            == 2
    }
}
