// @vesper-std/collections::btree_cursor: ordered traversal of
// `CacheBTree[K, V]` (the layout is described in `btree.ves`).
use self::btree::{
    CacheBTree,
    BTreeCursor
};

fn none_id() -> u64 {
    18446744073709551615
}

fn at[T: mod copy](in s: Slice[T], i: u64, fallback: T) -> T {
    match s.try_get(i) {
        Option::Some(x) => x,
        Option::None => fallback,
    }
}

impl [K: mod copy + Ord, V: mod copy] CacheBTree[K, V] {
    // `c` moved forward past empty leaves to a real entry, or to the end.
    fn settle(in self, c: BTreeCursor) -> BTreeCursor {
        let mut leaf = c.leaf;
        let mut pos = c.pos;
        loop {
            if leaf == none_id() {
                break BTreeCursor {
                    leaf: none_id(),
                    pos: 0
                };
            }
            if pos < self.leaf_count(leaf) {
                break BTreeCursor {
                    leaf: leaf,
                    pos: pos
                };
            }
            leaf = self.leaf_next(leaf);
            pos = 0;
        }
    }

    // The cursor at the smallest entry (the end when empty).
    pub fn cursor_first(in self) -> BTreeCursor {
        if self.root == none_id() {
            return BTreeCursor {
                leaf: none_id(),
                pos: 0
            };
        }
        let mut node = self.root;
        let mut h = self.height;
        loop {
            if h == 0 {
                break;
            }
            node = self.kid(node, 0);
            h = wrapping_sub(h, 1);
        }
        self
            .settle(
            BTreeCursor {
                leaf: node,
                pos: 0
            }
        )
    }

    // The cursor at the first entry whose key is not below `k`.
    pub fn lower_bound(in self, k: K) -> BTreeCursor {
        if self.root == none_id() {
            return BTreeCursor {
                leaf: none_id(),
                pos: 0
            };
        }
        let leaf = self.find_leaf(k);
        self
            .settle(
            BTreeCursor {
                leaf: leaf,
                pos: self.leaf_pos(leaf, k)
            }
        )
    }

    // The entry at `c`, or `None` at the end.
    pub fn entry(in self, c: BTreeCursor) -> Option[(K, V)] {
        if c.leaf == none_id() {
            return Option::None;
        }
        let i = wrapping_add(wrapping_mul(c.leaf, 16), c.pos);
        match self.lkeys.try_get(i) {
            Option::Some(k) => {
                match self.lvals.try_get(i) {
                    Option::Some(v) => Option::Some((k, v)),
                    Option::None => Option::None,
                }
            },
            Option::None => Option::None,
        }
    }

    // The cursor after `c`.
    pub fn advance(in self, c: BTreeCursor) -> BTreeCursor {
        if c.leaf == none_id() {
            return c;
        }
        self
            .settle(
            BTreeCursor {
                leaf: c.leaf,
                pos: wrapping_add(c.pos, 1)
            }
        )
    }

    // The smallest entry.
    pub fn first(in self) -> Option[(K, V)] {
        self.entry(self.cursor_first())
    }

    // The largest entry.
    pub fn last(in self) -> Option[(K, V)] {
        if self.root == none_id() {
            return Option::None;
        }
        let mut node = self.root;
        let mut h = self.height;
        loop {
            if h == 0 {
                break;
            }
            node = self.kid(node, at(in self.icount.as_slice(), node, 0));
            h = wrapping_sub(h, 1);
        }
        loop {
            if node == none_id() {
                break Option::None;
            }
            let n = self.leaf_count(node);
            if n > 0 {
                break self
                    .entry(
                    BTreeCursor {
                        leaf: node,
                        pos: wrapping_sub(n, 1)
                    }
                );
            }
            node = self.leaf_prev(node);
        }
    }

    // The entry of rank `i` in key order (0 is the smallest).
    pub fn nth(in self, i: u64) -> Option[(K, V)] {
        if i >= self.len {
            return Option::None;
        }
        let mut c = self.cursor_first();
        let mut left = i;
        loop {
            if c.leaf == none_id() {
                break Option::None;
            }
            let n = self.leaf_count(c.leaf);
            let room = wrapping_sub(n, c.pos);
            if left < room {
                break self
                    .entry(
                    BTreeCursor {
                        leaf: c.leaf,
                        pos: wrapping_add(c.pos, left)
                    }
                );
            }
            left = wrapping_sub(left, room);
            c = self
                .settle(
                BTreeCursor {
                    leaf: self.leaf_next(c.leaf),
                    pos: 0
                }
            );
        }
    }

    // Append up to `limit` entries with `lo <= key < hi`, ascending, to
    // `keys` and `vals`; the number appended.
    pub fn range_into(
        in self,
        lo: K,
        hi: K,
        limit: u64,
        inout keys: ChunkSeq[K],
        inout vals: ChunkSeq[V]
    ) -> u64 {
        let mut c = self.lower_bound(lo);
        let mut n: u64 = 0;
        loop {
            if n >= limit {
                break n;
            }
            match self.entry(c) {
                Option::Some((k, v)) => {
                    match k.cmp(hi) {
                        Less => {
                            keys.push(k);
                            vals.push(v);
                            n = wrapping_add(n, 1);
                        },
                        _ => {
                            break n;
                        },
                    }
                },
                Option::None => {
                    break n;
                },
            }
            c = self.advance(c);
        }
    }
}

test {
    use self::btree::btree_new;

    fn odd_keys(count: u64) -> CacheBTree[u64, u64] {
        let mut tree = btree_new[u64, u64]();
        for index in 0..count {
            let key = wrapping_add(index << 1, 1);
            tree.insert(key, wrapping_add(key, 100));
        }
        tree
    }

    // @case empty(0)
    // @case single(1)
    // @case leaf_boundary(17)
    // @case multiple_leaves(48)
    fn test_cursor_traversal(count: u64) -> bool {
        let tree = odd_keys(count);
        let mut cursor = tree.cursor_first();
        if tree.first() != tree.entry(cursor) {
            return false;
        }
        let mut last: Option[(u64, u64)] = Option::None;
        for i in 0..count {
            let key = wrapping_add(i << 1, 1);
            let value = wrapping_add(key, 100);
            let expected = Option::Some((key, value));
            if tree.entry(cursor) != expected || tree.nth(i) != expected {
                return false;
            }
            last = expected;
            cursor = tree.advance(cursor);
        }
        tree
            .entry(cursor)
            == Option::None
            && tree
            .entry(tree.advance(cursor))
            == Option::None
            && tree
            .last()
            == last
            && tree
            .nth(count)
            == Option::None
    }

    // @case before_first(0, Option::Some((1, 101)))
    // @case exact(5, Option::Some((5, 105)))
    // @case between(6, Option::Some((7, 107)))
    // @case crosses_leaf(16, Option::Some((17, 117)))
    // @case beyond_last(40, Option::None)
    fn test_lower_bound(key: u64, expected: Option[(u64, u64)]) -> bool {
        let tree = odd_keys(20);
        tree.entry(tree.lower_bound(key)) == expected
    }

    // @case includes_low_excludes_high(1, 7, 10, 3, 1)
    // @case limit_caps_output(1, 7, 2, 2, 1)
    // @case no_budget(1, 7, 0, 0, 1)
    // @case inverted(7, 1, 5, 0, 7)
    // @case crosses_leaf(14, 21, 10, 3, 15)
    // @case outside_tree(45, 50, 5, 0, 45)
    fn test_range_into(lo: u64, hi: u64, limit: u64, count: u64, first: u64) -> bool {
        let tree = odd_keys(20);
        let mut keys = ChunkSeq::new[u64]();
        let mut values = ChunkSeq::new[u64]();
        keys.push(88);
        values.push(99);
        let added = tree.range_into(lo, hi, limit, inout keys, inout values);
        if added != count || keys.len() != wrapping_add(count, 1) || values.len() != keys.len() {
            return false;
        }
        for i in 0..count {
            let key = wrapping_add(first, i << 1);
            let position = wrapping_add(i, 1);
            let value = wrapping_add(key, 100);
            if keys
                .try_get(position)
                != Option::Some(key)
                || values
                .try_get(position)
                != Option::Some(value) {
                return false;
            }
        }
        keys.try_get(0) == Option::Some(88) && values.try_get(0) == Option::Some(99)
    }
}
