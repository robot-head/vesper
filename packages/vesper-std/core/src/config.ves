// Copy a configuration and apply the field updates from left to right.
// The source and each right-hand side are evaluated once. Named field
// paths can descend into nested copy configurations. Reading the private
// source binding twice requires copy mode without a def-site helper call.
pub sugar update: expr {
    rule (
        update $source:expr {
            $($field:ident $(.$child:ident)* = $value:expr),*
        }
    ) => {
        {
            let original = $source;
            let mut updated = original;
            let _copy_required = original;
            $(updated.$field $(.$child)* = $value;)* updated
        }
    }
}

test {
    copy struct Config {
        port: i64,
        tls: bool,
        attempts: i64,
    }

    fn config(port: i64) -> Config {
        Config { port: port, tls: false, attempts: 3 }
    }

    fn mark(inout log: i64, n: i64) -> i64 {
        log = wrapping_add(wrapping_mul(log, 10), n);
        n
    }

    // @case copy_and_update()
    fn preserves_original_and_unspecified_fields() -> bool {
        let original = config(12);
        let updated: i64 = 80;
        let changed = update original {
            port = updated,
            tls = true
        };
        original.port == 12
            && !original.tls
            && changed.port == 80
            && changed.tls
            && changed.attempts == 3
    }

    copy struct Server {
        config: Config,
        active: bool,
    }

    copy struct Cluster {
        server: Server,
        workers: i64,
    }

    fn cluster(inout log: i64) -> Cluster {
        Cluster { server: Server { config: config(mark(inout log, 1)), active: false }, workers: 8 }
    }

    fn nested_updates() -> bool {
        let mut log: i64 = 0;
        let original = cluster(inout log);
        let changed = update original {
            server.config.port = mark(inout log, 2),
            workers = mark(inout log, 3),
            server.active = mark(inout log, 4) == 4,
            server.config.tls = mark(inout log, 5) == 5
        };
        original.server.config.port == 1
            && !original.server.active
            && original.workers == 8
            && changed.server.config.port == 2
            && changed.workers == 3
            && changed.server.active
            && changed.server.config.tls
            && changed.server.config.attempts == 3
            && log == 12345
    }

    // @case evaluation_order()
    fn evaluates_source_and_values_once_in_order() -> bool {
        let mut log: i64 = 0;
        let changed = update config(mark(inout log, 1)) {
            port = mark(inout log, 2),
            tls = mark(inout log, 3) == 3
        };
        changed.port == 2 && changed.tls && changed.attempts == 3 && log == 123 && nested_updates()
    }

    // @case empty_update()
    fn empty_update_keeps_the_original_value() -> bool {
        let original = config(12);
        let changed = update original {};
        changed.port == 12 && !changed.tls && changed.attempts == 3
    }
}
