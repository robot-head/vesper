// Branchless selection for secret scalars (manuscript §7.7). Evaluate both
// arms, left to right, before passing their values and the mask to the
// existing constant-time primitive; never branch on the mask.
pub sugar ct_if: expr emits eff [ConstTime] {
    rule (ct_if $mask:expr $then_arm:block else $else_arm:block) => {
        {
            let first = $then_arm;
            let second = $else_arm;
            let choice = $mask;
            ct_select(choice, first, second)
        }
    }
}
