// Short-circuiting predicate folds from manuscript §7.8. The braced
// predicate is evaluated in the iteration binding's scope, once per
// visited element. Both forms evaluate the source once and allocate nothing.
pub sugar any: tag {
    rule (
        any{
            $predicate:block | $element:pat in $lo:expr.. $hi:expr
        }
    ) => {
        {
            let mut found = false;
            for $element in $lo.. $hi {
                if $predicate {
                    found = true;
                    break;
                }
            }
            found
        }
    }

    rule (
        any{
            $predicate:block | $element:pat in $source:expr
        }
    ) => {
        {
            let mut found = false;
            for $element in $source {
                if $predicate {
                    found = true;
                    break;
                }
            }
            found
        }
    }
}

pub sugar all: tag {
    rule (
        all{
            $predicate:block | $element:pat in $lo:expr.. $hi:expr
        }
    ) => {
        {
            let mut accepted = true;
            for $element in $lo.. $hi {
                if !$predicate {
                    accepted = false;
                    break;
                }
            }
            accepted
        }
    }

    rule (
        all{
            $predicate:block | $element:pat in $source:expr
        }
    ) => {
        {
            let mut accepted = true;
            for $element in $source {
                if !$predicate {
                    accepted = false;
                    break;
                }
            }
            accepted
        }
    }
}

// Checked numeric fold from §7.8. The braced projection runs in the
// iteration binding's scope. Use ordinary += rather than silent wrapping.
pub sugar sum: tag emits eff [Fail] {
    // A tagged source avoids shadowing an ordinary function named zip.
    // Restrict sources to names and fields: lengths and views must not
    // re-evaluate an effectful index.
    rule (
        sum{
            $projection:block | $pair:pat in zip{
                $left:ident $(.$left_field:ident)*,
                $right:ident $(.$right_field:ident)*
            }
        }
    ) => {
        {
            let nl = $left $(.$left_field)*.len();
            let nr = $right $(.$right_field)*.len();
            let lhs = $left $(.$left_field)* [0..nl];
            let rhs = $right $(.$right_field)* [0..nr];
            let limit = if nl < nr {
                nl
            } else {
                nr
            };
            let mut total = 0;
            for i in 0..limit {
                match (lhs.try_get(i), rhs.try_get(i)) {
                    (Option::Some(a), Option::Some(b)) => {
                        let $pair = (a, b);
                        total += $projection;
                    },
                    _ => (),
                }
            }
            total
        }
    }

    rule (
        sum{
            $projection:block | $element:pat in $lo:expr.. $hi:expr
        }
    ) => {
        {
            let mut total = 0;
            for $element in $lo.. $hi {
                total += $projection;
            }
            total
        }
    }

    rule (
        sum{
            $projection:block | $element:pat in $source:expr
        }
    ) => {
        {
            let mut total = 0;
            for $element in $source {
                total += $projection;
            }
            total
        }
    }
}

test {
    fn mark(inout log: u64, digit: u64) -> u64 {
        log = wrapping_add(wrapping_mul(log, 10), digit);
        digit
    }

    // @case any_stops_at_first_match()
    fn any_runs_bounds_once_and_stops() -> bool {
        let mut log: u64 = 0;
        let found = any{
            {
                mark(inout log, x) == 2
            }
            | x in mark(inout log, 1)..mark(inout log, 4)
        };
        found && log == 1412
    }

    // @case all_stops_at_first_miss()
    fn all_runs_bounds_once_and_stops() -> bool {
        let mut log: u64 = 0;
        let accepted = all{
            {
                mark(inout log, x) < 2
            }
            | x in mark(inout log, 1)..mark(inout log, 4)
        };
        !accepted && log == 1412
    }

    // @case empty_range_does_not_run_predicate()
    fn empty_ranges_use_boolean_identities() -> bool {
        let mut calls: u64 = 0;
        let lo: u64 = 2;
        let hi: u64 = 2;
        let found = any{
            {
                mark(inout calls, x) != 0
            }
            | x in lo..hi
        };
        let accepted = all{
            {
                mark(inout calls, x) != 0
            }
            | x in lo..hi
        };
        !found && accepted && calls == 0
    }

    // @case uses_caller_binding()
    fn predicate_matches_tuples_and_preserves_names() -> bool {
        let found = 9;
        let accepted = 3;
        let mut pairs: ChunkSeq[(i64, i64)] = ChunkSeq::new();
        pairs.push((0, 3));
        pairs.push((9, 3));
        let matches = any{
            {
                left == found && right == accepted
            }
            | (left, right) in pairs.as_slice()
        };
        matches && all{
            {
                x < found
            }
            | x in [1, 3, 8]
        }
        && found == 9 && accepted == 3
    }

    // @case borrows_existing_view(in "aba", true, false)
    // @case empty_view(in "", false, true)
    fn slice_is_iterated_without_copy(in text: Str, found: bool, accepted: bool) -> bool {
        let bytes = text.as_bytes();
        let has_b = any{
            {
                byte == 98
            }
            | byte in bytes
        };
        let only_a = all{
            {
                byte == 97
            }
            | byte in bytes
        };
        has_b == found && only_a == accepted
    }
}

test {
    fn sum_signed(in data: Slice[i64]) -> i64 eff [Fail[ArithOverflow]] {
        sum{
            {
                n
            }
            | n in data
        }
    }

    fn handwritten(in data: Slice[i64]) -> i64 eff [Fail[ArithOverflow]] {
        let mut total: i64 = 0;
        for n in data {
            total += n;
        }
        total
    }

    fn sum_mark(inout log: u64, n: u64) -> u64 {
        log = wrapping_add(wrapping_mul(log, 10), n);
        n
    }

    fn sum_range(inout log: u64, start: u64, end: u64) -> u64 eff [Fail[ArithOverflow]] {
        sum{
            {
                sum_mark(inout log, n)
            }
            | n in sum_mark(inout log, start)..sum_mark(inout log, end)
        }
    }

    fn sum_numbers(inout log: u64) -> ChunkSeq[u64] {
        sum_mark(inout log, 1);
        let mut xs = ChunkSeq::new[u64]();
        xs.push(2);
        xs.push(3);
        xs
    }

    fn sum_sourced(inout log: u64) -> u64 eff [Fail[ArithOverflow]] {
        sum{
            {
                sum_mark(inout log, n)
            }
            | n in sum_numbers(inout log)
        }
    }

    fn sum_with_overflow(inout visits: u64, first: u64) -> u64 eff [Fail[ArithOverflow]] {
        let mut xs = ChunkSeq::new[u64]();
        xs.push(first);
        xs.push(1);
        xs.push(3);
        sum{
            {
                visits = wrapping_add(visits, 1);
                n
            }
            | n in xs.as_slice()
        }
    }

    // @case signed_empty()
    fn signed_sum_is_zero_for_empty_slice() -> bool {
        let empty = ChunkSeq::new[i64]();
        handle Fail[ArithOverflow] in {
            sum_signed(in empty.as_slice()) == 0
        } with {
            return value => value,
            raise(_, _) => false,
        }
    }

    // @case negative_total(-25, 8)
    // @case positive_total(7, 35)
    // @case signed_high_overflow(9223372036854775807, 1)
    // @case signed_low_overflow(-9223372036854775808, -1)
    fn signed_fold_matches_checked_effect(a: i64, b: i64) -> bool {
        let mut data = ChunkSeq::new[i64]();
        data.push(a);
        data.push(b);
        let actual: Option[i64] = handle Fail[ArithOverflow] in {
            Option::Some(sum_signed(in data.as_slice()))
        } with {
            return value => value,
            raise(_, _) => Option::None,
        };
        let expected: Option[i64] = handle Fail[ArithOverflow] in {
            Option::Some(handwritten(in data.as_slice()))
        } with {
            return value => value,
            raise(_, _) => Option::None,
        };
        actual == expected
    }

    // @case nonempty_bounds(1, 4, 6, 14123)
    // @case empty_bounds(2, 2, 0, 22)
    fn sum_runs_bounds_once_in_order(start: u64, end: u64, expected: u64, trace: u64) -> bool {
        let mut log: u64 = 0;
        let ok = handle Fail[ArithOverflow] in {
            sum_range(inout log, start, end) == expected
        } with {
            return value => value,
            raise(_, _) => false,
        };
        ok && log == trace
    }

    // @case evaluates_iterable_once()
    fn sum_evaluates_iterable_once() -> bool {
        let mut log: u64 = 0;
        let ok = handle Fail[ArithOverflow] in {
            sum_sourced(inout log) == 5
        } with {
            return value => value,
            raise(_, _) => false,
        };
        ok && log == 123
    }

    // @case unsigned_overflow(18446744073709551615, true, 2)
    // @case unsigned_no_overflow(38, false, 3)
    fn sum_overflow_does_not_visit_later_elements(first: u64, fails: bool, count: u64) -> bool {
        let mut visits: u64 = 0;
        let ok = handle Fail[ArithOverflow] in {
            sum_with_overflow(inout visits, first)
        } with {
            return value => !fails && value == 42,
            raise(_, _) => fails,
        };
        ok && visits == count
    }
}

test {
    struct ZipInputs {
        coefficients: ChunkSeq[i64],
        weights: ChunkSeq[u64],
    }

    fn zip_dot(in inputs: ZipInputs, inout visits: u64) -> i64 eff [Fail[ArithOverflow]] {
        sum{
            {
                visits = wrapping_add(visits, 1);
                x * narrow_i64(weight)
            }
            | (x, weight) in zip{
                inputs.coefficients,
                inputs.weights
            }
        }
    }

    // @case right_shorter(1, 3, 3, 1)
    // @case left_shorter(3, 2, 7, 2)
    // @case equal(3, 3, 12, 3)
    // @case left_empty(3, 0, 0, 0)
    // @case right_empty(0, 3, 0, 0)
    fn zip_stops_at_shorter_input(weights: u64, coefficients: u64, total: i64, count: u64) -> bool {
        let mut data = ZipInputs {
            coefficients: ChunkSeq::new[i64](),
            weights: ChunkSeq::new[u64](),
        };
        for i in 0..coefficients {
            data.coefficients.push(wrapping_i64(wrapping_add(3, i)));
        }
        for _ in 0..weights {
            data.weights.push(1);
        }
        let mut visits: u64 = 0;
        let ok = handle Fail[ArithOverflow] in {
            zip_dot(in data, inout visits) == total
        } with {
            return value => value,
            raise(_, _) => false,
        };
        ok && visits == count
    }

    fn zip(a: i64, b: i64) -> ChunkSeq[i64] {
        let mut values = ChunkSeq::new[i64]();
        values.push(a);
        values.push(b);
        values
    }

    fn zip_calls_still_resolve_to_functions() -> i64 eff [Fail[ArithOverflow]] {
        sum{
            {
                x
            }
            | x in zip(40, 2)
        }
    }

    // @case independent_zip_name()
    fn tagged_source_keeps_ordinary_zip_functions() -> bool {
        handle Fail[ArithOverflow] in {
            zip_calls_still_resolve_to_functions() == 42
        } with {
            return value => value,
            raise(_, _) => false,
        }
    }

    fn paired_with_self(in input: Slice[i64]) -> i64 eff [Fail[ArithOverflow]] {
        sum{
            {
                x * y
            }
            | (x, y) in zip{
                input,
                input
            }
        }
    }

    // @case shared_borrow_alias()
    fn one_slice_can_supply_both_views() -> bool {
        let input = zip(3, 4);
        handle Fail[ArithOverflow] in {
            paired_with_self(in input.as_slice()) == 25
        } with {
            return value => value,
            raise(_, _) => false,
        }
    }
}
