// @vesper-std/core::saturating: saturating add, subtract and multiply for
// each integer kind (P3b gaps lane 11, #1096). Each is total: a result
// outside the kind's range is clamped to its nearest bound.

pub fn saturating_add_u8(a: u8, b: u8) -> u8 {
    let s = wrapping_add(widen_u64(a), widen_u64(b));
    if s > 255 {
        wrapping_u8(255)
    } else {
        wrapping_u8(s)
    }
}

pub fn saturating_sub_u8(a: u8, b: u8) -> u8 {
    if b > a {
        wrapping_u8(0)
    } else {
        wrapping_sub(a, b)
    }
}

pub fn saturating_mul_u8(a: u8, b: u8) -> u8 {
    let p = wrapping_mul(widen_u64(a), widen_u64(b));
    if p > 255 {
        wrapping_u8(255)
    } else {
        wrapping_u8(p)
    }
}

pub fn saturating_add_u16(a: u16, b: u16) -> u16 {
    let s = wrapping_add(widen_u64(a), widen_u64(b));
    if s > 65535 {
        wrapping_u16(65535)
    } else {
        wrapping_u16(s)
    }
}

pub fn saturating_sub_u16(a: u16, b: u16) -> u16 {
    if b > a {
        wrapping_u16(0)
    } else {
        wrapping_sub(a, b)
    }
}

pub fn saturating_mul_u16(a: u16, b: u16) -> u16 {
    let p = wrapping_mul(widen_u64(a), widen_u64(b));
    if p > 65535 {
        wrapping_u16(65535)
    } else {
        wrapping_u16(p)
    }
}

pub fn saturating_add_u32(a: u32, b: u32) -> u32 {
    let s = wrapping_add(widen_u64(a), widen_u64(b));
    if s > 4294967295 {
        wrapping_u32(4294967295)
    } else {
        wrapping_u32(s)
    }
}

pub fn saturating_sub_u32(a: u32, b: u32) -> u32 {
    if b > a {
        wrapping_u32(0)
    } else {
        wrapping_sub(a, b)
    }
}

pub fn saturating_mul_u32(a: u32, b: u32) -> u32 {
    let p = wrapping_mul(widen_u64(a), widen_u64(b));
    if p > 4294967295 {
        wrapping_u32(4294967295)
    } else {
        wrapping_u32(p)
    }
}

pub fn saturating_add_u64(a: u64, b: u64) -> u64 {
    let s = wrapping_add(a, b);
    if s < a {
        18446744073709551615
    } else {
        s
    }
}

pub fn saturating_sub_u64(a: u64, b: u64) -> u64 {
    if b > a {
        0
    } else {
        wrapping_sub(a, b)
    }
}

pub fn saturating_mul_u64(a: u64, b: u64) -> u64 {
    let (lo, hi) = mul_wide(a, b);
    if hi != 0 {
        18446744073709551615
    } else {
        lo
    }
}

// `x` (an exact `i64` result) clamped to the range of `i8`.
fn clamp_i8(x: i64) -> i8 {
    let lo: i64 = 0 - 128;
    let hi: i64 = 127;
    if x < lo {
        wrapping_i8(lo)
    } else if x > hi {
        wrapping_i8(hi)
    } else {
        wrapping_i8(x)
    }
}

pub fn saturating_add_i8(a: i8, b: i8) -> i8 {
    clamp_i8(wrapping_add(widen_i64(a), widen_i64(b)))
}

pub fn saturating_sub_i8(a: i8, b: i8) -> i8 {
    clamp_i8(wrapping_sub(widen_i64(a), widen_i64(b)))
}

pub fn saturating_mul_i8(a: i8, b: i8) -> i8 {
    clamp_i8(wrapping_mul(widen_i64(a), widen_i64(b)))
}

// `x` (an exact `i64` result) clamped to the range of `i16`.
fn clamp_i16(x: i64) -> i16 {
    let lo: i64 = 0 - 32768;
    let hi: i64 = 32767;
    if x < lo {
        wrapping_i16(lo)
    } else if x > hi {
        wrapping_i16(hi)
    } else {
        wrapping_i16(x)
    }
}

pub fn saturating_add_i16(a: i16, b: i16) -> i16 {
    clamp_i16(wrapping_add(widen_i64(a), widen_i64(b)))
}

pub fn saturating_sub_i16(a: i16, b: i16) -> i16 {
    clamp_i16(wrapping_sub(widen_i64(a), widen_i64(b)))
}

pub fn saturating_mul_i16(a: i16, b: i16) -> i16 {
    clamp_i16(wrapping_mul(widen_i64(a), widen_i64(b)))
}

// `x` (an exact `i64` result) clamped to the range of `i32`.
fn clamp_i32(x: i64) -> i32 {
    let lo: i64 = 0 - 2147483648;
    let hi: i64 = 2147483647;
    if x < lo {
        wrapping_i32(lo)
    } else if x > hi {
        wrapping_i32(hi)
    } else {
        wrapping_i32(x)
    }
}

pub fn saturating_add_i32(a: i32, b: i32) -> i32 {
    clamp_i32(wrapping_add(widen_i64(a), widen_i64(b)))
}

pub fn saturating_sub_i32(a: i32, b: i32) -> i32 {
    clamp_i32(wrapping_sub(widen_i64(a), widen_i64(b)))
}

pub fn saturating_mul_i32(a: i32, b: i32) -> i32 {
    clamp_i32(wrapping_mul(widen_i64(a), widen_i64(b)))
}

// The bound an overflowing `i64` result saturates to: `MIN` when the true
// result is negative, else `MAX`.
fn bound_i64(negative: bool) -> i64 {
    if negative {
        wrapping_i64(9223372036854775808)
    } else {
        9223372036854775807
    }
}

pub fn saturating_add_i64(a: i64, b: i64) -> i64 {
    let s = wrapping_add(a, b);
    if ((a ^ s) & (b ^ s)) < 0 {
        bound_i64(a < 0)
    } else {
        s
    }
}

pub fn saturating_sub_i64(a: i64, b: i64) -> i64 {
    let s = wrapping_sub(a, b);
    if ((a ^ b) & (a ^ s)) < 0 {
        bound_i64(a < 0)
    } else {
        s
    }
}

// |x| as a `u64` (exact for `MIN`).
fn magnitude_i64(x: i64) -> u64 {
    let u = wrapping_u64(x);
    if x < 0 {
        wrapping_sub(0, u)
    } else {
        u
    }
}

pub fn saturating_mul_i64(a: i64, b: i64) -> i64 {
    let negative = (a < 0) != (b < 0);
    let (lo, hi) = mul_wide(magnitude_i64(a), magnitude_i64(b));
    if negative {
        if hi != 0 || lo > 9223372036854775808 {
            bound_i64(true)
        } else {
            wrapping_i64(wrapping_sub(0, lo))
        }
    } else {
        if hi != 0 || lo > 9223372036854775807 {
            bound_i64(false)
        } else {
            wrapping_i64(lo)
        }
    }
}

test {
    // @case exact(40, 2, 42)
    // @case upper_bound(254, 1, 255)
    // @case overflow(255, 1, 255)
    // @case zero_identity(255, 0, 255)
    fn test_saturating_add_u8(a: u8, b: u8, expected: u8) -> bool {
        saturating_add_u8(a, b) == expected
    }

    // @case exact(10, 3, 7)
    // @case lower_bound(255, 255, 0)
    // @case underflow(0, 255, 0)
    // @case zero_identity(255, 0, 255)
    fn test_saturating_sub_u8(a: u8, b: u8, expected: u8) -> bool {
        saturating_sub_u8(a, b) == expected
    }

    // @case exact(6, 7, 42)
    // @case zero(255, 0, 0)
    // @case upper_bound(255, 1, 255)
    // @case overflow(128, 2, 255)
    fn test_saturating_mul_u8(a: u8, b: u8, expected: u8) -> bool {
        saturating_mul_u8(a, b) == expected
    }

    // @case exact(40, 2, 42)
    // @case upper_bound(65534, 1, 65535)
    // @case overflow(65535, 1, 65535)
    // @case zero_identity(65535, 0, 65535)
    fn test_saturating_add_u16(a: u16, b: u16, expected: u16) -> bool {
        saturating_add_u16(a, b) == expected
    }

    // @case exact(10, 3, 7)
    // @case lower_bound(65535, 65535, 0)
    // @case underflow(0, 65535, 0)
    // @case zero_identity(65535, 0, 65535)
    fn test_saturating_sub_u16(a: u16, b: u16, expected: u16) -> bool {
        saturating_sub_u16(a, b) == expected
    }

    // @case exact(6, 7, 42)
    // @case zero(65535, 0, 0)
    // @case upper_bound(65535, 1, 65535)
    // @case overflow(32768, 2, 65535)
    fn test_saturating_mul_u16(a: u16, b: u16, expected: u16) -> bool {
        saturating_mul_u16(a, b) == expected
    }

    // @case exact(40, 2, 42)
    // @case upper_bound(4294967294, 1, 4294967295)
    // @case overflow(4294967295, 1, 4294967295)
    // @case zero_identity(4294967295, 0, 4294967295)
    fn test_saturating_add_u32(a: u32, b: u32, expected: u32) -> bool {
        saturating_add_u32(a, b) == expected
    }

    // @case exact(10, 3, 7)
    // @case lower_bound(4294967295, 4294967295, 0)
    // @case underflow(0, 4294967295, 0)
    // @case zero_identity(4294967295, 0, 4294967295)
    fn test_saturating_sub_u32(a: u32, b: u32, expected: u32) -> bool {
        saturating_sub_u32(a, b) == expected
    }

    // @case exact(6, 7, 42)
    // @case zero(4294967295, 0, 0)
    // @case upper_bound(4294967295, 1, 4294967295)
    // @case overflow(2147483648, 2, 4294967295)
    fn test_saturating_mul_u32(a: u32, b: u32, expected: u32) -> bool {
        saturating_mul_u32(a, b) == expected
    }

    // @case exact(40, 2, 42)
    // @case upper_bound(18446744073709551614, 1, 18446744073709551615)
    // @case overflow(18446744073709551615, 1, 18446744073709551615)
    // @case zero_identity(18446744073709551615, 0, 18446744073709551615)
    // @case zero_identity_below_max(42, 0, 42)
    fn test_saturating_add_u64(a: u64, b: u64, expected: u64) -> bool {
        saturating_add_u64(a, b) == expected
    }

    // @case exact(10, 3, 7)
    // @case lower_bound(18446744073709551615, 18446744073709551615, 0)
    // @case underflow(0, 18446744073709551615, 0)
    // @case zero_identity(18446744073709551615, 0, 18446744073709551615)
    fn test_saturating_sub_u64(a: u64, b: u64, expected: u64) -> bool {
        saturating_sub_u64(a, b) == expected
    }

    // @case exact(6, 7, 42)
    // @case zero(18446744073709551615, 0, 0)
    // @case upper_bound(18446744073709551615, 1, 18446744073709551615)
    // @case overflow(9223372036854775808, 2, 18446744073709551615)
    fn test_saturating_mul_u64(a: u64, b: u64, expected: u64) -> bool {
        saturating_mul_u64(a, b) == expected
    }

    // @case exact(40, 2, 42)
    // @case upper_bound(126, 1, 127)
    // @case lower_bound(-127, -1, -128)
    // @case above_max(127, 1, 127)
    // @case below_min(-128, -1, -128)
    // @case opposite_extremes(127, -128, -1)
    fn test_saturating_add_i8(a: i8, b: i8, expected: i8) -> bool {
        saturating_add_i8(a, b) == expected
    }

    // @case exact(10, 3, 7)
    // @case upper_bound(126, -1, 127)
    // @case lower_bound(-127, 1, -128)
    // @case above_max(127, -1, 127)
    // @case below_min(-128, 1, -128)
    // @case same_extreme(-128, -128, 0)
    fn test_saturating_sub_i8(a: i8, b: i8, expected: i8) -> bool {
        saturating_sub_i8(a, b) == expected
    }

    // @case exact(-6, 7, -42)
    // @case two_negatives(-6, -7, 42)
    // @case zero(-128, 0, 0)
    // @case upper_bound(127, 1, 127)
    // @case lower_bound(-128, 1, -128)
    // @case above_max(-128, -1, 127)
    // @case positive_overflow(127, 2, 127)
    // @case below_min(-65, 2, -128)
    fn test_saturating_mul_i8(a: i8, b: i8, expected: i8) -> bool {
        saturating_mul_i8(a, b) == expected
    }

    // @case exact(40, 2, 42)
    // @case upper_bound(32766, 1, 32767)
    // @case lower_bound(-32767, -1, -32768)
    // @case above_max(32767, 1, 32767)
    // @case below_min(-32768, -1, -32768)
    // @case opposite_extremes(32767, -32768, -1)
    fn test_saturating_add_i16(a: i16, b: i16, expected: i16) -> bool {
        saturating_add_i16(a, b) == expected
    }

    // @case exact(10, 3, 7)
    // @case upper_bound(32766, -1, 32767)
    // @case lower_bound(-32767, 1, -32768)
    // @case above_max(32767, -1, 32767)
    // @case below_min(-32768, 1, -32768)
    // @case same_extreme(-32768, -32768, 0)
    fn test_saturating_sub_i16(a: i16, b: i16, expected: i16) -> bool {
        saturating_sub_i16(a, b) == expected
    }

    // @case exact(-6, 7, -42)
    // @case two_negatives(-6, -7, 42)
    // @case zero(-32768, 0, 0)
    // @case upper_bound(32767, 1, 32767)
    // @case lower_bound(-32768, 1, -32768)
    // @case above_max(-32768, -1, 32767)
    // @case positive_overflow(32767, 2, 32767)
    // @case below_min(-16385, 2, -32768)
    fn test_saturating_mul_i16(a: i16, b: i16, expected: i16) -> bool {
        saturating_mul_i16(a, b) == expected
    }

    // @case exact(40, 2, 42)
    // @case upper_bound(2147483646, 1, 2147483647)
    // @case lower_bound(-2147483647, -1, -2147483648)
    // @case above_max(2147483647, 1, 2147483647)
    // @case below_min(-2147483648, -1, -2147483648)
    // @case opposite_extremes(2147483647, -2147483648, -1)
    fn test_saturating_add_i32(a: i32, b: i32, expected: i32) -> bool {
        saturating_add_i32(a, b) == expected
    }

    // @case exact(10, 3, 7)
    // @case upper_bound(2147483646, -1, 2147483647)
    // @case lower_bound(-2147483647, 1, -2147483648)
    // @case above_max(2147483647, -1, 2147483647)
    // @case below_min(-2147483648, 1, -2147483648)
    // @case same_extreme(-2147483648, -2147483648, 0)
    fn test_saturating_sub_i32(a: i32, b: i32, expected: i32) -> bool {
        saturating_sub_i32(a, b) == expected
    }

    // @case exact(-6, 7, -42)
    // @case two_negatives(-6, -7, 42)
    // @case zero(-2147483648, 0, 0)
    // @case upper_bound(2147483647, 1, 2147483647)
    // @case lower_bound(-2147483648, 1, -2147483648)
    // @case above_max(-2147483648, -1, 2147483647)
    // @case positive_overflow(2147483647, 2, 2147483647)
    // @case below_min(-1073741825, 2, -2147483648)
    fn test_saturating_mul_i32(a: i32, b: i32, expected: i32) -> bool {
        saturating_mul_i32(a, b) == expected
    }

    // @case exact(40, 2, 42)
    // @case upper_bound(9223372036854775806, 1, 9223372036854775807)
    // @case lower_bound(-9223372036854775807, -1, -9223372036854775808)
    // @case above_max(9223372036854775807, 1, 9223372036854775807)
    // @case below_min(-9223372036854775808, -1, -9223372036854775808)
    // @case opposite_extremes(9223372036854775807, -9223372036854775808, -1)
    fn test_saturating_add_i64(a: i64, b: i64, expected: i64) -> bool {
        saturating_add_i64(a, b) == expected
    }

    // @case exact(10, 3, 7)
    // @case upper_bound(9223372036854775806, -1, 9223372036854775807)
    // @case lower_bound(-9223372036854775807, 1, -9223372036854775808)
    // @case above_max(9223372036854775807, -1, 9223372036854775807)
    // @case below_min(-9223372036854775808, 1, -9223372036854775808)
    // @case same_extreme(-9223372036854775808, -9223372036854775808, 0)
    // @case subtract_minimum_from_zero(0, -9223372036854775808, 9223372036854775807)
    fn test_saturating_sub_i64(a: i64, b: i64, expected: i64) -> bool {
        saturating_sub_i64(a, b) == expected
    }

    // @case exact(-6, 7, -42)
    // @case two_negatives(-6, -7, 42)
    // @case zero(-9223372036854775808, 0, 0)
    // @case upper_bound(9223372036854775807, 1, 9223372036854775807)
    // @case lower_bound(-9223372036854775808, 1, -9223372036854775808)
    // @case above_max(-9223372036854775808, -1, 9223372036854775807)
    // @case positive_overflow(9223372036854775807, 2, 9223372036854775807)
    // @case below_min(-4611686018427387905, 2, -9223372036854775808)
    fn test_saturating_mul_i64(a: i64, b: i64, expected: i64) -> bool {
        saturating_mul_i64(a, b) == expected
    }
}
