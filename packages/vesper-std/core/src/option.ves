// @vesper-std/core::option: combinators over the builtin `Option[T]`.

pub fn is_some[T: mod copy](o: Option[T]) -> bool {
    match o {
        Option::Some(_) => true,
        Option::None => false,
    }
}

pub fn is_none[T: mod copy](o: Option[T]) -> bool {
    match o {
        Option::Some(_) => false,
        Option::None => true,
    }
}

// The value, or `fallback` when there is none.
pub fn unwrap_or[T: mod copy](o: Option[T], fallback: T) -> T {
    match o {
        Option::Some(x) => x,
        Option::None => fallback,
    }
}

// The value, or `f()` when there is none.
pub fn unwrap_or_else[T: mod copy](o: Option[T], sink f: fn() -> T) -> T {
    match o {
        Option::Some(x) => x,
        Option::None => f(),
    }
}

// The value; raises `IndexOutOfBounds` when there is none.
pub fn unwrap[T: mod copy](o: Option[T]) -> T eff [Fail[RuntimeError]] {
    match o {
        Option::Some(x) => x,
        Option::None => {
            let r: Result[T, RuntimeError] = Result::Err(RuntimeError::IndexOutOfBounds);
            r?
        },
    }
}

pub fn map[T: mod copy, U: mod copy](o: Option[T], sink f: fn(T) -> U) -> Option[U] {
    match o {
        Option::Some(x) => Option::Some(f(x)),
        Option::None => Option::None,
    }
}

// `f(x)` for a value `x`, else `fallback`.
pub fn map_or[T: mod copy, U: mod copy](o: Option[T], fallback: U, sink f: fn(T) -> U) -> U {
    match o {
        Option::Some(x) => f(x),
        Option::None => fallback,
    }
}

pub fn and_then[T: mod copy, U: mod copy](o: Option[T], sink f: fn(T) -> Option[U]) -> Option[U] {
    match o {
        Option::Some(x) => f(x),
        Option::None => Option::None,
    }
}

// `o` when it holds a value, else `other`.
pub fn or[T: mod copy](o: Option[T], other: Option[T]) -> Option[T] {
    match o {
        Option::Some(x) => Option::Some(x),
        Option::None => other,
    }
}

// The value when `keep(value)` holds.
pub fn filter[T: mod copy](o: Option[T], sink keep: fn(T) -> bool) -> Option[T] {
    match o {
        Option::Some(x) => {
            if keep(x) {
                Option::Some(x)
            } else {
                Option::None
            }
        },
        Option::None => Option::None,
    }
}

// Both values, when both are present.
pub fn zip[T: mod copy, U: mod copy](a: Option[T], b: Option[U]) -> Option[(T, U)] {
    match a {
        Option::Some(x) => {
            match b {
                Option::Some(y) => Option::Some((x, y)),
                Option::None => Option::None,
            }
        },
        Option::None => Option::None,
    }
}

// `Ok(value)`, or `Err(error)` when there is none.
pub fn ok_or[T: mod copy, E: mod copy](o: Option[T], error: E) -> Result[T, E] {
    match o {
        Option::Some(x) => Result::Ok(x),
        Option::None => Result::Err(error),
    }
}

test {
    // @case present(Option::Some(4), 7, 4)
    // @case present_zero(Option::Some(0), 7, 0)
    // @case absent(Option::None, 7, 7)
    fn test_unwrap_or_u64(input: Option[u64], fallback: u64, expected: u64) -> bool {
        unwrap_or(input, fallback) == expected
    }

    // @case both_present(Option::Some(4), Option::Some(9), true)
    // @case left_absent(Option::None, Option::Some(9), false)
    // @case right_absent(Option::Some(4), Option::None, false)
    // @case both_absent(Option::None, Option::None, false)
    fn test_zip_u64(left: Option[u64], right: Option[u64], expected_present: bool) -> bool {
        match zip(left, right) {
            Option::Some((a, b)) => expected_present && a == 4 && b == 9,
            Option::None => !expected_present,
        }
    }

    // @case some(Option::Some(0), true)
    // @case none(Option::None, false)
    fn test_presence(input: Option[u64], present: bool) -> bool {
        is_some(input) == present && is_none(input) != present
    }

    // @case some(Option::Some(4), 4)
    // @case none(Option::None, 9)
    fn test_unwrap_or_else(input: Option[u64], expected: u64) -> bool {
        unwrap_or_else(
            input,
            || -> u64 {
                9
            }
        )
            == expected
    }

    // @case some(Option::Some(4), Result::Ok(4))
    // @case none(Option::None, Result::Err(RuntimeError::IndexOutOfBounds))
    fn test_unwrap(input: Option[u64], expected: Result[u64, RuntimeError]) -> bool {
        let actual: Result[u64, RuntimeError] = handle Fail[RuntimeError] in {
            unwrap(input)
        } with {
            return x => Result::Ok(x),
            raise(error, k) => Result::Err(error),
        };
        match (actual, expected) {
            (Result::Ok(x), Result::Ok(y)) => x == y,
            (
                Result::Err(RuntimeError::IndexOutOfBounds),
                Result::Err(RuntimeError::IndexOutOfBounds)
            ) => true,
            _ => false,
        }
    }

    // @case some(Option::Some(4), Option::Some(5), 5)
    // @case none(Option::None, Option::None, 99)
    fn test_map_and_map_or(input: Option[u8], mapped: Option[u16], resolved: u16) -> bool {
        let actual = map(
            input,
            | x: u8 | -> u16 {
                wrapping_add(wrapping_u16(x), 1)
            }
        );
        actual
            == mapped
            && map_or(
            input,
            99,
            | x: u8 | -> u16 {
                wrapping_add(wrapping_u16(x), 1)
            }
        )
            == resolved
    }

    // @case maps_even(Option::Some(8), Option::Some(4))
    // @case rejects_odd(Option::Some(7), Option::None)
    // @case none(Option::None, Option::None)
    fn test_and_then(input: Option[u64], expected: Option[u64]) -> bool {
        and_then(
            input,
            | x: u64 | -> Option[u64] {
                if (x & 1) == 0 {
                    Option::Some(x >> 1)
                } else {
                    Option::None
                }
            }
        )
            == expected
    }

    // @case first_some(Option::Some(4), Option::Some(9), Option::Some(4))
    // @case fallback_some(Option::None, Option::Some(9), Option::Some(9))
    // @case fallback_none(Option::Some(4), Option::None, Option::Some(4))
    // @case both_none(Option::None, Option::None, Option::None)
    fn test_or(first: Option[u64], fallback: Option[u64], expected: Option[u64]) -> bool {
        or(first, fallback) == expected
    }

    // @case keep(Option::Some(9), Option::Some(9))
    // @case reject_at_boundary(Option::Some(8), Option::None)
    // @case none(Option::None, Option::None)
    fn test_filter(input: Option[u64], expected: Option[u64]) -> bool {
        filter(
            input,
            | x: u64 | -> bool {
                x > 8
            }
        )
            == expected
    }

    // @case some(Option::Some(4), Result::Ok(4))
    // @case none(Option::None, Result::Err(13))
    fn test_ok_or(input: Option[u64], expected: Result[u64, u8]) -> bool {
        let error: u8 = 13;
        ok_or(input, error) == expected
    }
}
