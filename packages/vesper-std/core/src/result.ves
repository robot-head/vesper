// @vesper-std/core::result: combinators over the builtin `Result[T, E]`.

pub fn is_ok[T: mod copy, E: mod copy](r: Result[T, E]) -> bool {
    match r {
        Result::Ok(_) => true,
        Result::Err(_) => false,
    }
}

pub fn is_err[T: mod copy, E: mod copy](r: Result[T, E]) -> bool {
    match r {
        Result::Ok(_) => false,
        Result::Err(_) => true,
    }
}

// The success value, if any.
pub fn ok[T: mod copy, E: mod copy](r: Result[T, E]) -> Option[T] {
    match r {
        Result::Ok(x) => Option::Some(x),
        Result::Err(_) => Option::None,
    }
}

// The error value, if any.
pub fn err[T: mod copy, E: mod copy](r: Result[T, E]) -> Option[E] {
    match r {
        Result::Ok(_) => Option::None,
        Result::Err(e) => Option::Some(e),
    }
}

pub fn unwrap_or[T: mod copy, E: mod copy](r: Result[T, E], fallback: T) -> T {
    match r {
        Result::Ok(x) => x,
        Result::Err(_) => fallback,
    }
}

// The success value, or `f(error)`.
pub fn unwrap_or_else[T: mod copy, E: mod copy](r: Result[T, E], sink f: fn(E) -> T) -> T {
    match r {
        Result::Ok(x) => x,
        Result::Err(e) => f(e),
    }
}

pub fn map[T: mod copy, U: mod copy, E: mod copy](r: Result[T, E], sink f: fn(T) -> U)
    -> Result[U, E] {
    match r {
        Result::Ok(x) => Result::Ok(f(x)),
        Result::Err(e) => Result::Err(e),
    }
}

pub fn map_err[T: mod copy, E: mod copy, F: mod copy](r: Result[T, E], sink f: fn(E) -> F)
    -> Result[T, F] {
    match r {
        Result::Ok(x) => Result::Ok(x),
        Result::Err(e) => Result::Err(f(e)),
    }
}

pub fn and_then[T: mod copy, U: mod copy, E: mod copy](
    r: Result[T, E],
    sink f: fn(T) -> Result[U, E]
) -> Result[U, E] {
    match r {
        Result::Ok(x) => f(x),
        Result::Err(e) => Result::Err(e),
    }
}

// `r` when it succeeded, else `other`.
pub fn or[T: mod copy, E: mod copy](r: Result[T, E], other: Result[T, E]) -> Result[T, E] {
    match r {
        Result::Ok(x) => Result::Ok(x),
        Result::Err(_) => other,
    }
}

test {
    // @case success(Result::Ok(0), true, Option::Some(0), Option::None)
    // @case error(Result::Err(7), false, Option::None, Option::Some(7))
    fn test_result_projection(
        input: Result[u64, u8],
        success: bool,
        value: Option[u64],
        error: Option[u8]
    ) -> bool {
        is_ok(input) == success
            && is_err(input) != success
            && ok(input) == value
            && err(input) == error
    }

    // @case success(Result::Ok(4), 4, 4)
    // @case error(Result::Err(7), 99, 8)
    fn test_result_fallback(input: Result[u64, u8], eager: u64, lazy: u64) -> bool {
        unwrap_or(input, 99) == eager
            && unwrap_or_else(
                input,
                | x: u8 | -> u64 {
                    wrapping_add(widen_u64(x), 1)
                }
            )
                == lazy
    }

    // @case success(Result::Ok(4), Result::Ok(5), Result::Ok(4))
    // @case error(Result::Err(7), Result::Err(7), Result::Err(9))
    fn test_result_mapping(
        input: Result[u64, u8],
        mapped: Result[u32, u8],
        mapped_error: Result[u64, u16]
    ) -> bool {
        let value = map(
            input,
            | x: u64 | -> u32 {
                wrapping_add(wrapping_u32(x), 1)
            }
        );
        let error = map_err(
            input,
            | x: u8 | -> u16 {
                wrapping_add(wrapping_u16(x), 2)
            }
        );
        value == mapped && error == mapped_error
    }

    // @case maps_success(Result::Ok(8), Result::Ok(4))
    // @case callback_error(Result::Ok(7), Result::Err(2))
    // @case original_error(Result::Err(9), Result::Err(9))
    fn test_result_and_then(input: Result[u64, u8], expected: Result[u32, u8]) -> bool {
        and_then(
            input,
            | x: u64 | -> Result[u32, u8] {
                if (x & 1) == 0 {
                    Result::Ok(wrapping_u32(x >> 1))
                } else {
                    Result::Err(2)
                }
            }
        )
            == expected
    }

    // @case first_success(Result::Ok(4), Result::Ok(9), Result::Ok(4))
    // @case first_success_second_error(Result::Ok(4), Result::Err(7), Result::Ok(4))
    // @case fallback_success(Result::Err(7), Result::Ok(9), Result::Ok(9))
    // @case fallback_error(Result::Err(7), Result::Err(8), Result::Err(8))
    fn test_result_or(first: Result[u64, u8], fallback: Result[u64, u8], expected: Result[u64, u8])
        -> bool {
        or(first, fallback) == expected
    }
}
