// @vesper-std/sugar: control-flow sugar for every Vesper package
// (manuscript §7.5, `std/sugar`).
//
// Import the forms a module uses, as with any other item:
//
//     use @vesper-std/sugar::{guard, when, while, trace_span};
//
// The pattern forms expand to `match` before checking. A template's
// `$rhs` runs once, and `$body` or `$diverge` only on its own arm, so the
// expansion has exactly the effects and cost of the hand-written `match`.
//
// `while` re-reads two names in a comparison, or re-evaluates a condition
// block on each iteration. An expression hole here would run only once.

// The package version, for diagnostics.
pub fn version() -> u64 {
    1
}

// `guard let PAT = rhs else { .. };` binds `PAT` for the rest of the block
// when `rhs` matches it, or runs the `else` block, which must leave the
// block (`return`, `break` or `continue`):
//
//     guard let Option::Some(x) = s.try_get(i) else {
//         return false;
//     };
pub sugar guard: stmt {
    rule (guard let $pat:pat = $rhs:expr else $diverge:block; $..rest:stmts) => {
        match $rhs {
            $pat => {
                $..rest
            },
            _ => {
                let rejected: Never = $diverge;
                rejected
            },
        }
    }
}

// `when let PAT = rhs { .. }` runs the block with `PAT` bound when `rhs`
// matches it, and does nothing otherwise:
//
//     when let Option::Some(v) = s.try_get(i) {
//         out.push(v);
//     }
pub sugar when: stmt {
    rule (when let $pat:pat = $rhs:expr $body:block) => {
        match $rhs {
            $pat => $body,
            _ => {},
        }
    }
}

// Test the condition once before every iteration, including the first.
// The parentheses keep the condition's braces separate from the body.
// Ordinary break and continue inside the body apply to the generated loop.
pub sugar while: expr {
    rule (while $left:ident < $right:ident $body:block) => {
        loop {
            if !($left < $right) {
                break;
            }
            $body;
        }
    }
    rule (while($condition:block) $body:block) => {
        loop {
            if !($condition) {
                break;
            }
            $body;
        }
    }
}

// Typed count attributes are safe for ordinary public counters only.
pub copy struct TraceCount {
    count: u64,
}

impl Telemetrable for TraceCount {
    fn telemetry_attr(in self) -> TelemetryAttr {
        TelemetryAttr::Count(self.count)
    }
}

// Start a real Trace span for a Result-returning body. Finish it once
// before returning the unchanged typed outcome. Only the successful arm
// asks the caller's Telemetrable model for an attribute; failure reports
// an explicitly public code and message, not the private error payload.
pub sugar trace_span: tag emits eff [Trace] {
    rule (
        trace_span{
            $name:expr schema $schema:expr;
            attempt $body:block telemetry $attribute:block;
            public_error $public_error:block
        }
    ) => {
        {
            let span = Trace::start_span($schema, $name);
            let outcome = $body;
            match outcome {
                Result::Ok(completed) => {
                    let attribute = $attribute;
                    Trace::emit_attr(span, attribute.telemetry_attr());
                    Result::Ok(completed)
                },
                Result::Err(error) => {
                    let public: (u32, String) = $public_error;
                    let (code, message) = public;
                    Trace::emit_err(span, code, message);
                    Result::Err(error)
                },
            }
        }
    }
}

test {
    fn first_or(in s: Str, fallback: u8) -> u8 {
        guard let Option::Some(b) = s.as_bytes().try_get(0) else {
            return fallback;
        };
        b
    }

    fn sum_present(in s: Str, a: u64, b: u64) -> u64 {
        let mut total: u64 = 0;
        for i in [a, b] {
            when let Option::Some(x) = s.as_bytes().try_get(i) {
                total = wrapping_add(total, widen_u64(x));
            }
        }
        total
    }

    fn sum_until_missing(in s: Str, n: u64) -> u64 {
        let mut total: u64 = 0;
        for i in 0..n {
            guard let Option::Some(x) = s.as_bytes().try_get(i) else {
                break;
            };
            total = wrapping_add(total, widen_u64(x));
        }
        total
    }

    // @case present(in "a", 0, 97)
    // @case missing(in "", 7, 7)
    fn test_guard_binds_or_leaves(in s: Str, fallback: u8, expected: u8) -> bool {
        first_or(in s, fallback) == expected
    }

    // @case both(in "ab", 0, 1, 195)
    // @case one_missing(in "ab", 0, 5, 97)
    // @case none(in "", 0, 1, 0)
    fn test_when_runs_only_on_match(in s: Str, a: u64, b: u64, expected: u64) -> bool {
        sum_present(in s, a, b) == expected
            && trace_span_preserves_payload(false)
            && trace_span_preserves_payload(true)
    }

    fn while_paths(limit: u64, stop: bool, expected_checks: u64, expected_sum: u64) -> bool {
        let mut cursor: u64 = 0;
        let mut checks: u64 = 0;
        let mut sum: u64 = 0;
        while(
            {
                checks = wrapping_add(checks, 1);
                cursor < limit
            }
        ) {
            cursor = wrapping_add(cursor, 1);
            if cursor == 1 {
                continue;
            }
            if stop && cursor == 3 {
                break;
            }
            sum = wrapping_add(sum, cursor);
        };
        checks == expected_checks && sum == expected_sum
    }

    fn comparison_rereads_both_names() -> bool {
        let mut cursor: u64 = 0;
        let mut limit: u64 = 6;
        while cursor < limit {
            cursor = wrapping_add(cursor, 1);
            limit = wrapping_sub(limit, 1);
        };
        cursor == 3 && limit == 3
    }

    // @case stops_at_end(in "ab", 5, 195)
    // @case all_present(in "abc", 2, 195)
    fn test_guard_break_leaves_the_loop(in s: Str, n: u64, expected: u64) -> bool {
        sum_until_missing(in s, n) == expected
            && while_paths(0, false, 1, 0)
            && while_paths(3, false, 4, 5)
            && while_paths(8, true, 3, 2)
            && comparison_rereads_both_names()
    }
    copy struct Secret[T] {
        value: T,
    }

    model TelemetryRedaction: Telemetrable for Secret[u64] {
        fn telemetry_attr(in self) -> TelemetryAttr {
            TelemetryAttr::Redacted
        }
    }

    copy struct Observation {
        outcome: Result[u64, Secret[u64]],
        started: u64,
        finished: u64,
        attribute: u64,
    }

    fn ctx() -> SpanContext {
        SpanContext { trace_id_hi: 1, trace_id_lo: 1, span_id: 1, flags: 1 }
    }

    fn trace_span_preserves_payload(failed: bool) -> bool {
        use model TelemetryRedaction;
        let secret: u64 = 9;
        let success: u64 = 42;
        let result: Observation = handle Trace in {
            trace_span{
                "work" schema 0;
                attempt {
                    if failed {
                        Result::Err(
                            Secret {
                                value: secret
                            }
                        )
                    } else {
                        Result::Ok(success)
                    }
                }
                telemetry {
                    Secret {
                        value: secret
                    }
                };
                public_error {
                    (1, "closed")
                }
            }
        } with {
            return value => Observation { outcome: value, started: 0, finished: 0, attribute: 0 },
            current_ctx(resume) => resume(ctx()),
            start_span(schema, _, resume) => {
                let mut r = resume(ActiveSpan {
                    ctx: ctx(),
                    parent_span_id: 0,
                    start_mono_ns: 1,
                    schema_id: schema
                });
                r.started = wrapping_add(r.started, 1);
                r
            },
            start_child(parent, schema, _, resume) => resume(ActiveSpan {
                ctx: ctx(),
                parent_span_id: parent.span_id,
                start_mono_ns: 1,
                schema_id: schema
            }),
            emit_ok(span, _, resume) => {
                let ActiveSpan { ctx, parent_span_id, start_mono_ns, schema_id } = span;
                let mut r = resume(());
                r.finished = wrapping_add(r.finished, ctx.span_id);
                r
            },
            emit_attr(span, attr, resume) => {
                let ActiveSpan { ctx, parent_span_id, start_mono_ns, schema_id } = span;
                let mut r = resume(());
                r.finished = wrapping_add(r.finished, ctx.span_id);
                r.attribute = match attr {
                    TelemetryAttr::Redacted => 1,
                    _ => 0
                };
                r
            },
            emit_err(span, code, msg, resume) => {
                let ActiveSpan { ctx, parent_span_id, start_mono_ns, schema_id } = span;
                let mut r = resume(());
                r.finished = wrapping_add(r.finished, ctx.span_id);
                if code == 1 && msg.as_bytes().eq(in "closed".as_bytes()) {
                    r.attribute = 2;
                }
                r
            },
        };
        result.started == 1 && result.finished == 1 && match result.outcome {
            Result::Ok(val) => !failed && val == 42 && result.attribute == 1,
            Result::Err(priv) => failed && priv.value == 9 && result.attribute == 2,
        }
    }
}
