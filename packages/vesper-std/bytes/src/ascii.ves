// @vesper-std/bytes::ascii: ASCII bytes by the character each one is.
// Vesper has no character literals, so byte code compares and pushes
// these names instead of raw codes (`b == DOT`, `out.push(NEWLINE)`).
// They are `u8`; a `u64` context widens them (`widen_u64(DIGIT_ZERO)`).

// Control bytes.
pub const NUL: u8 = 0;
pub const BACKSPACE: u8 = 8;
pub const TAB: u8 = 9;
pub const NEWLINE: u8 = 10;
pub const VERTICAL_TAB: u8 = 11;
pub const FORM_FEED: u8 = 12;
pub const CARRIAGE_RETURN: u8 = 13;
pub const DELETE: u8 = 127;

// Space and the punctuation before the digits.
pub const SPACE: u8 = 32;
pub const EXCLAMATION: u8 = 33;
pub const QUOTE: u8 = 34;
pub const HASH: u8 = 35;
pub const DOLLAR: u8 = 36;
pub const PERCENT: u8 = 37;
pub const AMPERSAND: u8 = 38;
pub const APOSTROPHE: u8 = 39;
pub const OPEN_PAREN: u8 = 40;
pub const CLOSE_PAREN: u8 = 41;
pub const ASTERISK: u8 = 42;
pub const PLUS: u8 = 43;
pub const COMMA: u8 = 44;
pub const HYPHEN: u8 = 45;
pub const DOT: u8 = 46;
pub const SLASH: u8 = 47;

// Digits: `0`, `1` and `9`.
pub const DIGIT_ZERO: u8 = 48;
pub const DIGIT_ONE: u8 = 49;
pub const DIGIT_NINE: u8 = 57;

// The punctuation between the digits and the upper-case letters.
pub const COLON: u8 = 58;
pub const SEMICOLON: u8 = 59;
pub const LESS_THAN: u8 = 60;
pub const EQUALS: u8 = 61;
pub const GREATER_THAN: u8 = 62;
pub const QUESTION: u8 = 63;
pub const AT_SIGN: u8 = 64;

// Upper-case letters: the ends of the range and the hex and exponent letters.
pub const UPPER_A: u8 = 65;
pub const UPPER_E: u8 = 69;
pub const UPPER_F: u8 = 70;
pub const UPPER_Z: u8 = 90;

// The punctuation between the upper-case and lower-case letters.
pub const OPEN_BRACKET: u8 = 91;
pub const BACKSLASH: u8 = 92;
pub const CLOSE_BRACKET: u8 = 93;
pub const CARET: u8 = 94;
pub const UNDERSCORE: u8 = 95;
pub const BACKTICK: u8 = 96;

// Lower-case letters: the ends of the range and the letters of escapes,
// literals and prefixes (`\b`, `\n`, `true`, `0x`, ...).
pub const LOWER_A: u8 = 97;
pub const LOWER_B: u8 = 98;
pub const LOWER_E: u8 = 101;
pub const LOWER_F: u8 = 102;
pub const LOWER_N: u8 = 110;
pub const LOWER_R: u8 = 114;
pub const LOWER_T: u8 = 116;
pub const LOWER_U: u8 = 117;
pub const LOWER_X: u8 = 120;
pub const LOWER_Z: u8 = 122;

// The punctuation after the lower-case letters.
pub const OPEN_BRACE: u8 = 123;
pub const PIPE: u8 = 124;
pub const CLOSE_BRACE: u8 = 125;
pub const TILDE: u8 = 126;
