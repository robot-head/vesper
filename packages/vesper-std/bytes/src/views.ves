// @vesper-std/bytes::views: searching and splitting byte views (SH3 lane
// 4, #1243).
//
// A view cannot be returned inside an `Option` (manuscript section 13: a
// `Str` or `Slice` result is static text only), so the splitting helpers
// return the offsets of the pieces and the caller binds the views:
//
//     match rsplit_once(in name.as_bytes(), in "::".as_bytes()) {
//         Option::Some((head_end, tail_start)) => {
//             let tail = name[tail_start..name.len()];
//             ...
//         }
//         Option::None => ...,
//     }
//
// The views share the bytes of their source, so no piece is copied. Splitting
// valid UTF-8 at a valid UTF-8 separator ends every piece on a char
// boundary, so the offsets also cut `Str` views.

// The first offset at which `needle` occurs in `hay` (0 for an empty
// needle).
pub fn find(in hay: Slice[u8], in needle: Slice[u8]) -> Option[u64] {
    let n = hay.len();
    let m = needle.len();
    if m > n {
        return Option::None;
    }
    if m == 0 {
        return Option::Some(0);
    }
    let first = match needle.try_get(0) {
        Option::Some(b) => b,
        Option::None => 0,
    };
    let last = wrapping_sub(n, m);
    let mut at: u64 = 0;
    loop {
        if at > last {
            return Option::None;
        }
        // Skip to the next candidate first byte, 16 bytes per step.
        let i = match hay[at..n].find_byte(first) {
            Option::Some(i) => wrapping_add(at, i),
            Option::None => return Option::None,
        };
        if i > last {
            return Option::None;
        }
        if hay[i..wrapping_add(i, m)].eq(in needle) {
            return Option::Some(i);
        }
        at = wrapping_add(i, 1);
    }
}

// The last offset at which `needle` occurs in `hay` (`hay.len()` for an
// empty needle).
pub fn rfind(in hay: Slice[u8], in needle: Slice[u8]) -> Option[u64] {
    let n = hay.len();
    let m = needle.len();
    if m > n {
        return Option::None;
    }
    let mut i = wrapping_sub(n, m);
    loop {
        if hay[i..wrapping_add(i, m)].eq(in needle) {
            return Option::Some(i);
        }
        if i == 0 {
            return Option::None;
        }
        i = wrapping_sub(i, 1);
    }
}

// Whether `s` begins with `prefix`.
pub fn starts_with(in s: Slice[u8], in prefix: Slice[u8]) -> bool {
    let m = prefix.len();
    m <= s.len() && s[0..m].eq(in prefix)
}

// Whether `s` ends with `suffix`.
pub fn ends_with(in s: Slice[u8], in suffix: Slice[u8]) -> bool {
    let n = s.len();
    let m = suffix.len();
    m <= n && s[wrapping_sub(n, m)..n].eq(in suffix)
}

// `s` split around the first `sep`: the end of the head and the start of
// the tail (`s[0..head_end]` and `s[tail_start..s.len()]`).
pub fn split_once(in s: Slice[u8], in sep: Slice[u8]) -> Option[(u64, u64)] {
    match find(in s, in sep) {
        Option::Some(i) => Option::Some((i, wrapping_add(i, sep.len()))),
        Option::None => Option::None,
    }
}

// `s` split around the last `sep`: the end of the head and the start of
// the tail.
pub fn rsplit_once(in s: Slice[u8], in sep: Slice[u8]) -> Option[(u64, u64)] {
    match rfind(in s, in sep) {
        Option::Some(i) => Option::Some((i, wrapping_add(i, sep.len()))),
        Option::None => Option::None,
    }
}

// Where the rest of `s` after `prefix` starts (`s[at..s.len()]`), when `s`
// begins with it.
pub fn strip_prefix(in s: Slice[u8], in prefix: Slice[u8]) -> Option[u64] {
    if starts_with(in s, in prefix) {
        Option::Some(prefix.len())
    } else {
        Option::None
    }
}

// Where the rest of `s` before `suffix` ends (`s[0..end]`), when `s` ends
// with it.
pub fn strip_suffix(in s: Slice[u8], in suffix: Slice[u8]) -> Option[u64] {
    if ends_with(in s, in suffix) {
        Option::Some(wrapping_sub(s.len(), suffix.len()))
    } else {
        Option::None
    }
}

// The start of the last `sep`-separated segment of `s` (0 without a
// separator): the last `::` segment of a path is `s[last_segment_start(in
// s, in "::".as_bytes())..s.len()]`.
pub fn last_segment_start(in s: Slice[u8], in sep: Slice[u8]) -> u64 {
    match rsplit_once(in s, in sep) {
        Option::Some((_head_end, tail_start)) => tail_start,
        Option::None => 0,
    }
}

test {
    // @case empty_needle(in "abc", in "", Option::Some(0))
    // @case first(in "abcabc", in "bc", Option::Some(1))
    // @case whole(in "abc", in "abc", Option::Some(0))
    // @case missing(in "abc", in "abd", Option::None)
    // @case longer(in "ab", in "abc", Option::None)
    // @case late_first_byte(in "aaaaaaaaaaaaaaaaaaab", in "ab", Option::Some(18))
    // @case path(in "a::b::c", in "::", Option::Some(1))
    fn test_find(in hay: Str, in needle: Str, expected: Option[u64]) -> bool {
        find(in hay.as_bytes(), in needle.as_bytes()) == expected
    }

    // @case empty_needle(in "abc", in "", Option::Some(3))
    // @case last(in "abcabc", in "bc", Option::Some(4))
    // @case missing(in "abc", in "x", Option::None)
    // @case path(in "a::b::c", in "::", Option::Some(4))
    fn test_rfind(in hay: Str, in needle: Str, expected: Option[u64]) -> bool {
        rfind(in hay.as_bytes(), in needle.as_bytes()) == expected
    }

    // @case yes(in "Atomic::new", in "Atomic::", true, false)
    // @case no(in "Atom", in "Atomic::", false, false)
    // @case both(in "ab", in "ab", true, true)
    // @case suffix(in "x.ves", in ".ves", false, true)
    fn test_affixes(in s: Str, in a: Str, prefix: bool, suffix: bool) -> bool {
        starts_with(in s.as_bytes(), in a.as_bytes())
            == prefix
            && ends_with(in s.as_bytes(), in a.as_bytes())
            == suffix
    }

    // @case path(in "a::b::c", in "::", Option::Some((1, 3)), Option::Some((4, 6)))
    // @case none(in "abc", in "::", Option::None, Option::None)
    fn test_split(in s: Str, in sep: Str, first: Option[(u64, u64)], last: Option[(u64, u64)])
        -> bool {
        split_once(in s.as_bytes(), in sep.as_bytes())
            == first
            && rsplit_once(in s.as_bytes(), in sep.as_bytes())
            == last
    }

    // @case atomic(in "Atomic::load", in "Atomic::", Option::Some(8))
    // @case other(in "Box::new", in "Atomic::", Option::None)
    fn test_strip_prefix(in s: Str, in p: Str, expected: Option[u64]) -> bool {
        strip_prefix(in s.as_bytes(), in p.as_bytes()) == expected
    }

    // @case source(in "main.ves", in ".ves", Option::Some(4))
    // @case other(in "main.rs", in ".ves", Option::None)
    fn test_strip_suffix(in s: Str, in p: Str, expected: Option[u64]) -> bool {
        strip_suffix(in s.as_bytes(), in p.as_bytes()) == expected
    }

    // A bound view of the last segment, compared without a copy.
    // @case path(in "std::seq::push", in "push", true)
    // @case plain(in "push", in "push", true)
    // @case other(in "std::seq::pop", in "push", false)
    fn test_last_segment_view(in s: Str, in want: Str, expected: bool) -> bool {
        let at = last_segment_start(in s.as_bytes(), in "::".as_bytes());
        let tail = s[at..s.len()];
        (tail == want) == expected
    }
}
