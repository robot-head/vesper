// Pack named unsigned fields, most significant first, into the low bits
// of one u64. Names document the layout; the widths are in bits.
//
// bits{ version: 4 = 4, length: 12 = n } produces Some(0x4000 | n)
// when n fits. Returns None for a zero width, total width above 64, or
// a value that does not fit. Never truncates a field or allocates.
// Width and value expressions run once, left to right, up to and
// including the first invalid field. An empty layout produces Some(0).
pub sugar bits: tag {
    // Read one field from an existing word. Bit 0 is the least significant.
    rule (
        bits{
            from $word:expr;
            offset $offset:expr,
            width $width:expr
        }
    ) => {
        extract_field($word, $offset, $width)
    }

    rule (bits{ $($field:ident: $width:expr = $value:expr),* }) => {
        {
            let mut packed: Option[PackedBits] = Option::Some(
                PackedBits {
                    word: 0,
                    used: 0
                }
            );
            $(
                packed = match packed {
                    Option::Some(previous) => append_field(previous, $width, $value),
                    Option::None => Option::None,
                };
            )* match packed {
                Option::Some(result) => Option::Some(result.word),
                Option::None => Option::None,
            }
        }
    }
}

copy struct PackedBits {
    word: u64,
    used: u64,
}

fn append_field(previous: PackedBits, width: u64, value: u64) -> Option[PackedBits] {
    if width == 0 || width > wrapping_sub(WORD_BITS, previous.used) {
        return Option::None;
    }
    if width == WORD_BITS {
        return Option::Some(PackedBits { word: value, used: WORD_BITS });
    }
    let shift = wrapping_u32(width);
    if wrapping_shr_u64(value, shift) != 0 {
        return Option::None;
    }
    Option::Some(PackedBits {
        word: wrapping_shl_u64(previous.word, shift) | value,
        used: wrapping_add(previous.used, width)
    })
}

const WORD_BITS: u64 = 64;

// All three arguments have already been evaluated, once and in order.
fn extract_field(word: u64, offset: u64, width: u64) -> Option[u64] {
    if width == 0 || offset >= WORD_BITS || width > wrapping_sub(WORD_BITS, offset) {
        return Option::None;
    }
    if width == WORD_BITS {
        return Option::Some(word);
    }
    let mask = wrapping_sub(wrapping_shl_u64(1, wrapping_u32(width)), 1);
    Option::Some(wrapping_shr_u64(word, wrapping_u32(offset)) & mask)
}

test {
    // @case typical(0xabc, Option::Some(0x4abc))
    // @case max_length(4095, Option::Some(0x4fff))
    // @case overflow(4096, Option::None)
    fn header_fields(length: u64, expected: Option[u64]) -> bool {
        let packed = bits{ version: 4 = 4, length: 12 = length };
        packed == expected && match packed {
            Option::Some(word) => bits{
                from word;
                offset 12,
                width 4
            }
            == Option::Some(4) && bits{
                from word;
                offset 0,
                width 12
            }
            == Option::Some(length),
            Option::None => true,
        }
    }

    // @case edge_widths()
    fn accepts_full_words_and_rejects_invalid_widths() -> bool {
        let all: u64 = 0xffffffffffffffff;
        let extract_edge_cases = bits{
            from all;
            offset 0,
            width 64
        }
        == Option::Some(all) && bits{
            from all;
            offset 63,
            width 1
        }
        == Option::Some(1) && bits{
            from all;
            offset 64,
            width 1
        }
        == Option::None && bits{
            from all;
            offset 1,
            width 64
        }
        == Option::None && bits{
            from all;
            offset 0,
            width 0
        }
        == Option::None && bits{
            from all;
            offset all,
            width all
        }
        == Option::None;
        extract_edge_cases
            && bits{} == Option::Some(0)
            && bits{ full: 64 = all } == Option::Some(all)
            && bits{ hi: 1 = 1, rest: 63 = 0x7fffffffffffffff } == Option::Some(all)
            && bits{ zero: 0 = 0 } == Option::None
            && bits{ hi: 1 = 0, rest: 64 = 0 } == Option::None
            && bits{ huge: 0xffffffffffffffff = 0 } == Option::None
    }

    fn record(inout log: u64, digit: u64) -> u64 {
        log = wrapping_add(wrapping_mul(log, 10), digit);
        digit
    }

    // @case success(3, Option::Some(255), 33234)
    // @case first_failure(1, Option::None, 13)
    fn evaluation_order(width: u64, expected: Option[u64], trace: u64) -> bool {
        let mut log: u64 = 0;
        let packed = bits{
            first: record(inout log, width) = record(inout log, 3),
            second: record(inout log, 2) = record(inout log, 3),
            third: record(inout log, 4) = 15
        };
        let write_ok = packed == expected && log == trace;
        log = 0;
        let extracted = bits{
            from record(inout log, 1);
            offset record(inout log, 2),
            width record(inout log, 0)
        };
        write_ok && extracted == Option::None && log == 120
    }
}
