// @vesper-std/graph::reach: reachability and depth-first orders.
use self::Graph;
use self::util::{
    get32,
    get64,
    get_bool,
    filled_bool
};

// Which nodes are reachable from `root` (including `root`); all `false`
// when `root` is not a node.
pub fn reachable_from(in g: Graph, root: u32) -> ChunkSeq[bool] {
    let mut roots: ChunkSeq[u32] = ChunkSeq::new[u32]();
    roots.push(root);
    reachable_from_all(in g, in roots.as_slice())
}

// Which nodes are reachable from any of `roots`; non-nodes are skipped.
pub fn reachable_from_all(in g: Graph, in roots: Slice[u32]) -> ChunkSeq[bool] {
    let n = g.node_count();
    let mut seen = filled_bool(n, false);
    let mut work: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut i: u64 = 0;
    loop {
        if i >= roots.len() {
            break;
        }
        let r = get32(in roots, i, 4294967295);
        let rk = widen_u64(r);
        if rk < n && !get_bool(in seen.as_slice(), rk) {
            seen.try_set(rk, true);
            work.push(r);
        }
        i = wrapping_add(i, 1);
    }
    loop {
        let v = match work.pop() {
            Option::Some(x) => x,
            Option::None => break,
        };
        let (lo, hi) = g.succ_range(v);
        let mut e = lo;
        loop {
            if e >= hi {
                break;
            }
            let w = g.succ_edge(e);
            let wk = widen_u64(w);
            if !get_bool(in seen.as_slice(), wk) {
                seen.try_set(wk, true);
                work.push(w);
            }
            e = wrapping_add(e, 1);
        }
    }
    seen
}

// Whether `b` is reachable from `a` (every node reaches itself).
pub fn reaches(in g: Graph, a: u32, b: u32) -> bool {
    let n = g.node_count();
    if widen_u64(a) >= n || widen_u64(b) >= n {
        false
    } else if a == b {
        true
    } else {
        let mut seen = filled_bool(n, false);
        let mut work: ChunkSeq[u32] = ChunkSeq::new[u32]();
        seen.try_set(widen_u64(a), true);
        work.push(a);
        loop {
            let v = match work.pop() {
                Option::Some(x) => x,
                Option::None => break false,
            };
            let (lo, hi) = g.succ_range(v);
            let mut e = lo;
            let mut found = false;
            loop {
                if e >= hi {
                    break;
                }
                let w = g.succ_edge(e);
                if w == b {
                    found = true;
                    break;
                }
                let wk = widen_u64(w);
                if !get_bool(in seen.as_slice(), wk) {
                    seen.try_set(wk, true);
                    work.push(w);
                }
                e = wrapping_add(e, 1);
            }
            if found {
                break true;
            }
        }
    }
}

// The nodes reachable from `root` in depth-first postorder (successors in
// edge order). Empty when `root` is not a node.
pub fn postorder(in g: Graph, root: u32) -> ChunkSeq[u32] {
    let n = g.node_count();
    let mut out: ChunkSeq[u32] = ChunkSeq::new[u32]();
    if widen_u64(root) < n {
        let mut seen = filled_bool(n, false);
        let mut call_node: ChunkSeq[u32] = ChunkSeq::new[u32]();
        let mut call_edge: ChunkSeq[u64] = ChunkSeq::new[u64]();
        seen.try_set(widen_u64(root), true);
        let (lo, _hi) = g.succ_range(root);
        call_node.push(root);
        call_edge.push(lo);
        loop {
            let depth = call_node.len();
            if depth == 0 {
                break;
            }
            let top = wrapping_sub(depth, 1);
            let v = get32(in call_node.as_slice(), top, 0);
            let e = get64(in call_edge.as_slice(), top, 0);
            let (_lo, hi) = g.succ_range(v);
            if e < hi {
                call_edge.try_set(top, wrapping_add(e, 1));
                let w = g.succ_edge(e);
                let wk = widen_u64(w);
                if !get_bool(in seen.as_slice(), wk) {
                    seen.try_set(wk, true);
                    let (wlo, _whi) = g.succ_range(w);
                    call_node.push(w);
                    call_edge.push(wlo);
                }
            } else {
                call_node.truncate(top);
                call_edge.truncate(top);
                out.push(v);
            }
        }
    }
    out
}

// The nodes reachable from `root` in reverse postorder: every node comes
// before its successors except along back edges.
pub fn reverse_postorder(in g: Graph, root: u32) -> ChunkSeq[u32] {
    let po = postorder(in g, root);
    let mut out: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](po.len());
    out.extend_reversed(in po.as_slice());
    out
}

test {
    use self::graph_builder;

    fn traversal_fixture(cycle: bool) -> Graph {
        let mut builder = graph_builder(5);
        builder.add_edge(0, 2);
        builder.add_edge(0, 1);
        builder.add_edge(2, 3);
        builder.add_edge(1, 3);
        if cycle {
            builder.add_edge(3, 0);
        }
        builder.build()
    }

    // @case transitive(false, 0, 3, true)
    // @case no_reverse_path(false, 3, 0, false)
    // @case cycle_wraps(true, 3, 1, true)
    // @case isolated_reflexive(false, 4, 4, true)
    // @case isolated_unreachable(true, 0, 4, false)
    // @case cycle_cannot_reach_island(true, 1, 4, false)
    // @case invalid_root(false, 5, 0, false)
    // @case invalid_target(true, 0, 4294967295, false)
    fn test_reaches(cycle: bool, root: u32, target: u32, expected: bool) -> bool {
        let graph = traversal_fixture(cycle);
        let result = reachable_from(in graph, root);
        let from_root = get_bool(in result.as_slice(), widen_u64(target));
        result.len() == 5 && from_root == expected && reaches(in graph, root, target) == expected
    }

    // @case existing_row(0, 3, false)
    // @case empty_row(1, 3, false)
    // @case correct_row(2, 3, true)
    fn test_reaches_stops_at_edge_row(root: u32, target: u32, expected: bool) -> bool {
        let mut builder = graph_builder(4);
        builder.add_edge(0, 1);
        builder.add_edge(2, 3);
        let graph = builder.build();
        reaches(in graph, root, target) == expected
    }

    // @case disjoint_roots(0, 4, 31)
    // @case overlapping_roots(1, 2, 14)
    // @case duplicate_root(1, 1, 10)
    // @case invalid_root(5, 4, 16)
    // @case no_valid_roots(5, 4294967295, 0)
    fn test_reachable_from_all(first: u32, second: u32, mask: u64) -> bool {
        let graph = traversal_fixture(false);
        let mut roots = ChunkSeq::new[u32]();
        roots.push(first);
        roots.push(second);
        let result = reachable_from_all(in graph, in roots.as_slice());
        for i in 0..5 {
            let expected = (wrapping_shr_u64(mask, wrapping_u32(i)) & 1) != 0;
            if result.try_get(i) != Option::Some(expected) {
                return false;
            }
        }
        result.len() == 5
    }

    fn test_repeated_roots_visit_the_same_neighbors_once() -> bool {
        let leaves: u32 = 512;
        let mut builder = graph_builder(wrapping_add(leaves, 1));
        for i in 0..leaves {
            builder.add_edge(0, wrapping_add(i, 1));
        }
        let graph = builder.build();
        let mut roots = ChunkSeq::new[u32]();
        roots.resize(widen_u64(leaves), 0);
        let result = reachable_from_all(in graph, in roots.as_slice());
        if result.len() != wrapping_add(widen_u64(leaves), 1) {
            return false;
        }
        for i in 0..result.len() {
            if result.try_get(i) != Option::Some(true) {
                return false;
            }
        }
        true
    }

    // @case diamond_uses_edge_order(false, 0, in "3210")
    // @case one_branch(false, 1, in "31")
    // @case cycle_visits_once(true, 3, in "2103")
    // @case isolated(false, 4, in "4")
    // @case absent(false, 5, in "")
    fn test_postorders(cycle: bool, root: u32, in expected: Str) -> bool {
        let graph = traversal_fixture(cycle);
        let post = postorder(in graph, root);
        let reverse = reverse_postorder(in graph, root);
        let count = expected.len();
        if post.len() != count || reverse.len() != count {
            return false;
        }
        for i in 0..count {
            let digit = get32(in post.as_slice(), i, 4294967295);
            let byte = wrapping_add(wrapping_u8(digit), 48);
            let reverse_index = wrapping_sub(wrapping_sub(count, 1), i);
            if expected
                .try_byte_at(i)
                != Option::Some(byte)
                || reverse
                .try_get(reverse_index)
                != Option::Some(digit) {
                return false;
            }
        }
        true
    }
}
