// @vesper-std/graph::topo: topological order with a cycle report.
use self::{Graph, GraphIndex};
use self::util::{get32, get_bool, filled32, filled_bool};

// The result of `toposort`: the nodes in a topological order when the graph
// is a DAG; otherwise the nodes that could be ordered (those no cycle
// reaches) and one cycle.
pub struct Topo {
    order: ChunkSeq[u32],
    cycle: ChunkSeq[u32]
}

impl Topo {
    // Whether the graph has no cycle (every node is in `order`).
    pub fn is_dag(in self) -> bool {
        self.cycle.len() == 0
    }

    pub fn order_len(in self) -> u64 {
        self.order.len()
    }

    // The `i`th node of the order, or `none()`.
    pub fn order_at(in self, i: u64) -> u32 {
        get32(in self.order.as_slice(), i, GraphIndex::Missing)
    }

    // The length of the reported cycle (0 for a DAG).
    pub fn cycle_len(in self) -> u64 {
        self.cycle.len()
    }

    // The `i`th node of the cycle: there is an edge from node `i` to node
    // `i + 1`, and from the last back to the first.
    pub fn cycle_at(in self, i: u64) -> u32 {
        get32(in self.cycle.as_slice(), i, GraphIndex::Missing)
    }
}

// Kahn's algorithm: sources are taken first-in first-out, starting in node
// order, and successors are released in edge order. When nodes remain, the
// cycle is found by walking predecessors among them from the lowest
// remaining id, so it too is deterministic.
pub fn toposort(in g: Graph) -> Topo {
    let order = kahn_order(in g);
    let cycle = if order.len() < g.node_count() {
        find_cycle(in g, in order.as_slice())
    } else {
        ChunkSeq::new[u32]()
    };
    Topo { order: order, cycle: cycle }
}

// The nodes Kahn's algorithm can order, in the order it takes them.
fn kahn_order(in g: Graph) -> ChunkSeq[u32] {
    let n = g.node_count();
    // The number of edges into each node from nodes not yet ordered.
    let mut remaining_in = filled32(n, 0);
    for v in 0..n {
        remaining_in.try_set(v, wrapping_u32(g.pred_len(wrapping_u32(v))));
    }
    let mut order: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](n);
    for v in 0..n {
        if get32(in remaining_in.as_slice(), v, 1) == 0 {
            order.push(wrapping_u32(v));
        }
    }
    // `order` doubles as the queue: `order[head..]` is still to be taken.
    let mut head: u64 = 0;
    loop {
        if head >= order.len() {
            break;
        }
        let taken = get32(in order.as_slice(), head, 0);
        head = wrapping_add(head, 1);
        let (lo, hi) = g.succ_range(taken);
        for e in lo..hi {
            let successor = g.succ_edge(e);
            let index = widen_u64(successor);
            let left = wrapping_sub(get32(in remaining_in.as_slice(), index, 1), 1);
            remaining_in.try_set(index, left);
            if left == 0 {
                order.push(successor);
            }
        }
    }
    order
}

// One cycle among the nodes missing from `order`, in edge direction.
fn find_cycle(in g: Graph, in order: Slice[u32]) -> ChunkSeq[u32] {
    let n = g.node_count();
    let mut placed = filled_bool(n, false);
    for v in order {
        placed.try_set(widen_u64(v), true);
    }
    // The first unplaced node.
    let mut start: u64 = 0;
    loop {
        if start >= n || !get_bool(in placed.as_slice(), start) {
            break;
        }
        start = wrapping_add(start, 1);
    }
    // Walk to an unplaced predecessor until a node repeats. step[v] is
    // the walk position of v plus one (0 = not on the walk).
    let mut cycle: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut step = filled32(n, 0);
    let mut walk: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut current = wrapping_u32(start);
    loop {
        let index = widen_u64(current);
        let seen_at = get32(in step.as_slice(), index, 0);
        if seen_at != 0 {
            // walk[seen_at - 1..] is a cycle followed backwards.
            let from = widen_u64(wrapping_sub(seen_at, 1));
            cycle.extend_reversed(in walk[from..walk.len()]);
            break;
        }
        walk.push(current);
        step.try_set(index, wrapping_u32(walk.len()));
        let next = unplaced_predecessor(in g, in placed.as_slice(), current);
        if next == GraphIndex::Missing {
            // Unreachable: an unplaced node always has an unplaced
            // predecessor.
            break;
        }
        current = next;
    }
    cycle
}

// The first predecessor of `v` in edge order that `placed` does not mark,
// or `GraphIndex::Missing`.
fn unplaced_predecessor(in g: Graph, in placed: Slice[bool], v: u32) -> u32 {
    let (lo, hi) = g.pred_range(v);
    for e in lo..hi {
        let p = g.pred_edge(e);
        if !get_bool(in placed, widen_u64(p)) {
            return p;
        }
    }
    GraphIndex::Missing
}

test {
    use self::graph_builder;

    // Each pair of ASCII digits is one directed edge.
    // @case empty(0, in "", in "", in "")
    // @case isolated_nodes(3, in "", in "012", in "")
    // @case fifo_and_edge_order(4, in "0201", in "0321", in "")
    // @case parallel_edges(3, in "010112", in "012", in "")
    // @case self_loop(1, in "00", in "", in "0")
    // @case cycle_and_isolated(4, in "01122331", in "0", in "231")
    // @case cycle_blocks_downstream(4, in "01100112", in "3", in "10")
    fn test_toposort(nodes: u32, in edges: Str, in order: Str, in cycle: Str) -> bool {
        let mut builder = graph_builder(nodes);
        let bytes = edges.as_bytes();
        let mut i: u64 = 0;
        loop {
            if i >= bytes.len() {
                break;
            }
            let a = match bytes.try_get(i) {
                Option::Some(value) => widen_u32(wrapping_sub(value, 48)),
                Option::None => return false,
            };
            let b = match bytes.try_get(wrapping_add(i, 1)) {
                Option::Some(value) => widen_u32(wrapping_sub(value, 48)),
                Option::None => return false,
            };
            if !builder.add_edge(a, b) {
                return false;
            }
            i = wrapping_add(i, 2);
        }
        let graph = builder.build();
        let result = toposort(in graph);
        if result.is_dag() != (cycle.len() == 0)
            || result.order_len() != order.len()
            || result.cycle_len() != cycle.len() {
            return false;
        }
        for j in 0..order.len() {
            let actual = wrapping_add(wrapping_u8(result.order_at(j)), 48);
            if order.try_byte_at(j) != Option::Some(actual) {
                return false;
            }
        }
        for j in 0..cycle.len() {
            let actual = wrapping_add(wrapping_u8(result.cycle_at(j)), 48);
            if cycle.try_byte_at(j) != Option::Some(actual) {
                return false;
            }
        }
        result.order_at(order.len()) == 4294967295 && result.cycle_at(cycle.len()) == 4294967295
    }
}
