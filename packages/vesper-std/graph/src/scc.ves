// @vesper-std/graph::scc: strongly connected components (Tarjan, iterative).
use self::util::{get32, get64, get_bool, filled32, filled_bool};
use self::{Graph, GraphIndex};

// The strongly connected components of a graph. Components are numbered
// `0..count()` in the order Tarjan's algorithm completes them, which is a
// reverse topological order of the condensation: every edge between two
// components goes from a higher number to a lower one (component 0 has no
// edge to another component).
pub struct Scc {
    comp: ChunkSeq[u32],
    // Nodes grouped by component; component c is nodes[starts[c]..starts[c + 1]],
    // in the order the algorithm popped them.
    nodes: ChunkSeq[u32],
    starts: ChunkSeq[u64]
}

impl Scc {
    // The number of components.
    pub fn count(in self) -> u64 {
        wrapping_sub(self.starts.len(), 1)
    }

    // The component of node `v`, or `none()`.
    pub fn component(in self, v: u32) -> u32 {
        get32(in self.comp.as_slice(), widen_u64(v), GraphIndex::Missing)
    }

    // The number of nodes in component `c`.
    pub fn size(in self, c: u32) -> u64 {
        let k = widen_u64(c);
        let a = get64(in self.starts.as_slice(), k, 0);
        wrapping_sub(get64(in self.starts.as_slice(), wrapping_add(k, 1), a), a)
    }

    // The `i`th node of component `c`, or `none()`.
    pub fn member(in self, c: u32, i: u64) -> u32 {
        let k = widen_u64(c);
        let a = get64(in self.starts.as_slice(), k, 0);
        let b = get64(in self.starts.as_slice(), wrapping_add(k, 1), a);
        if i >= wrapping_sub(b, a) {
            GraphIndex::Missing
        } else {
            get32(in self.nodes.as_slice(), wrapping_add(a, i), GraphIndex::Missing)
        }
    }
}

fn min32(a: u32, b: u32) -> u32 {
    if a < b {
        a
    } else {
        b
    }
}

// The discovery number of a node `scc` has not reached yet.
const UNVISITED: u32 = GraphIndex::Missing;

// The working state of `scc`. The recursion of Tarjan's algorithm is kept
// as an explicit call stack: frame `f` is visiting `call_node[f]` and will
// try its successor edge `call_edge[f]` next.
struct Tarjan {
    // Each node's discovery number, or `UNVISITED`.
    index: ChunkSeq[u32],
    // The lowest discovery number reachable from the node's subtree through
    // nodes still on `stack`.
    low: ChunkSeq[u32],
    on_stack: ChunkSeq[bool],
    stack: ChunkSeq[u32],
    call_node: ChunkSeq[u32],
    call_edge: ChunkSeq[u64],
    next_index: u32,
    // The result as it is built (see `Scc`).
    comp: ChunkSeq[u32],
    nodes: ChunkSeq[u32],
    starts: ChunkSeq[u64],
    component_count: u32
}

fn tarjan_new(n: u64) -> Tarjan {
    let mut starts: ChunkSeq[u64] = ChunkSeq::new[u64]();
    starts.push(0);
    Tarjan {
        index: filled32(n, UNVISITED),
        low: filled32(n, 0),
        on_stack: filled_bool(n, false),
        stack: ChunkSeq::new[u32](),
        call_node: ChunkSeq::new[u32](),
        call_edge: ChunkSeq::new[u64](),
        next_index: 0,
        comp: filled32(n, UNVISITED),
        nodes: ChunkSeq::with_capacity[u32](n),
        starts: starts,
        component_count: 0
    }
}

impl Tarjan {
    fn index_of(in self, v: u64) -> u32 {
        get32(in self.index.as_slice(), v, 0)
    }

    fn low_of(in self, v: u64) -> u32 {
        get32(in self.low.as_slice(), v, 0)
    }

    // `low[v] = min(low[v], candidate)`.
    fn lower_low(inout self, v: u64, candidate: u32) {
        let current = self.low_of(v);
        self.low.try_set(v, min32(current, candidate));
    }

    // Give `v` the next discovery number, push it on the stack and start a
    // call frame for it at its first successor edge.
    fn discover(inout self, in g: Graph, v: u32) {
        let vk = widen_u64(v);
        self.index.try_set(vk, self.next_index);
        self.low.try_set(vk, self.next_index);
        self.next_index = wrapping_add(self.next_index, 1);
        self.stack.push(v);
        self.on_stack.try_set(vk, true);
        let (first_edge, _) = g.succ_range(v);
        self.call_node.push(v);
        self.call_edge.push(first_edge);
    }

    // Pop the stack down to `root` as one new component.
    fn close_component(inout self, root: u32) {
        let component = self.component_count;
        loop {
            let w = match self.stack.pop() {
                Option::Some(x) => x,
                Option::None => break,
            };
            let wk = widen_u64(w);
            self.on_stack.try_set(wk, false);
            self.comp.try_set(wk, component);
            self.nodes.push(w);
            if w == root {
                break;
            }
        }
        self.starts.push(self.nodes.len());
        self.component_count = wrapping_add(component, 1);
    }

    // Run the call stack down to empty: the depth-first search from the
    // node `discover` last started.
    fn search(inout self, in g: Graph) {
        loop {
            let depth = self.call_node.len();
            if depth == 0 {
                break;
            }
            let top = wrapping_sub(depth, 1);
            let v = get32(in self.call_node.as_slice(), top, 0);
            let vk = widen_u64(v);
            let e = get64(in self.call_edge.as_slice(), top, 0);
            let (_, end) = g.succ_range(v);
            if e < end {
                // Follow the next edge `v -> w`.
                self.call_edge.try_set(top, wrapping_add(e, 1));
                let w = g.succ_edge(e);
                let wk = widen_u64(w);
                let w_index = self.index_of(wk);
                if w_index == UNVISITED {
                    self.discover(in g, w);
                } else if get_bool(in self.on_stack.as_slice(), wk) {
                    self.lower_low(vk, w_index);
                }
            } else {
                // Every edge of `v` is done: return from its frame.
                self.call_node.truncate(top);
                self.call_edge.truncate(top);
                let v_low = self.low_of(vk);
                if v_low == self.index_of(vk) {
                    self.close_component(v);
                }
                if top > 0 {
                    let caller = widen_u64(
                        get32(in self.call_node.as_slice(), wrapping_sub(top, 1), 0)
                    );
                    self.lower_low(caller, v_low);
                }
            }
        }
    }
}

// The strongly connected components of `g`. Roots are tried in node order
// and edges in insertion order; the recursion is an explicit stack, so deep
// graphs do not overflow.
pub fn scc(in g: Graph) -> Scc {
    let n = g.node_count();
    let mut state = tarjan_new(n);
    for root in 0..n {
        if state.index_of(root) == UNVISITED {
            state.discover(in g, wrapping_u32(root));
            state.search(in g);
        }
    }
    let Tarjan {
        index,
        low,
        on_stack,
        stack,
        call_node,
        call_edge,
        next_index,
        comp,
        nodes,
        starts,
        component_count,
    } = state;
    Scc {
        comp: comp,
        nodes: nodes,
        starts: starts
    }
}

test {
    use self::graph_builder;

    // @case empty(0, false, 0, in "")
    // @case single(1, false, 1, in "0")
    // @case chain(4, false, 4, in "3210")
    // @case closed_cycle(4, true, 1, in "0000")
    fn test_components(nodes: u32, close_cycle: bool, count: u64, in expected: Str) -> bool {
        let mut builder = graph_builder(nodes);
        for node in 1..widen_u64(nodes) {
            builder.add_edge(wrapping_u32(wrapping_sub(node, 1)), wrapping_u32(node));
        }
        if close_cycle {
            builder.add_edge(wrapping_sub(nodes, 1), 0);
        }
        let graph = builder.build();
        let result = scc(in graph);
        if result.count() != count || result.component(nodes) != 4294967295 {
            return false;
        }
        for node in 0..widen_u64(nodes) {
            let id = result.component(wrapping_u32(node));
            let digit = wrapping_add(wrapping_u8(id), 48);
            if expected.try_byte_at(node) != Option::Some(digit) {
                return false;
            }
            let member_index = if close_cycle {
                widen_u64(id)
            } else {
                0
            };
            let expected_member = if close_cycle {
                wrapping_sub(nodes, 1)
            } else {
                wrapping_u32(node)
            };
            let size = if close_cycle {
                widen_u64(nodes)
            } else {
                1
            };
            if result.member(id, member_index) != expected_member
                || result.size(id) != size
                || result.member(id, size) != 4294967295 {
                return false;
            }
        }
        if close_cycle {
            for i in 0..widen_u64(nodes) {
                if result.member(0, i) != wrapping_sub(wrapping_sub(nodes, 1), wrapping_u32(i)) {
                    return false;
                }
            }
        }
        result.size(wrapping_u32(count)) == 0 && result.member(wrapping_u32(count), 0) == 4294967295
    }

    // @case edge_to_completed_component(1, 0, 0, 1)
    // @case edge_to_unvisited_component(0, 1, 1, 0)
    fn test_one_way_edge(from: u32, to: u32, first: u32, second: u32) -> bool {
        let mut builder = graph_builder(2);
        builder.add_edge(from, to);
        let graph = builder.build();
        let result = scc(in graph);
        result.count() == 2 && result.component(0) == first && result.component(1) == second
    }

    // @case without_bridge(false, 0, 1)
    // @case with_bridge(true, 1, 0)
    fn test_component_order(bridge: bool, left: u32, right: u32) -> bool {
        let mut builder = graph_builder(4);
        builder.add_edge(0, 1);
        builder.add_edge(1, 0);
        builder.add_edge(2, 3);
        builder.add_edge(3, 2);
        if bridge {
            builder.add_edge(1, 2);
        }
        let graph = builder.build();
        let result = scc(in graph);
        let first = result.component(0) == left && result.component(1) == left;
        let second = result.component(2) == right && result.component(3) == right;
        first && second && result.count() == 2 && result.size(left) == 2 && result.size(right) == 2
    }
}
