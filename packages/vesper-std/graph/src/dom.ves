// @vesper-std/graph::dom: immediate dominators (Cooper, Harvey and Kennedy,
// "A Simple, Fast Dominance Algorithm", 2001).
use self::{Graph, GraphIndex};
use self::reach::reverse_postorder;
use self::util::{get32, filled32};

// The dominator tree of the nodes reachable from a root.
pub struct Dominators {
    root: u32,
    idom: ChunkSeq[u32]
}

impl Dominators {
    pub fn root(in self) -> u32 {
        self.root
    }

    // The immediate dominator of `v`: `v` itself for the root, `none()` for
    // a node the root does not reach.
    pub fn idom(in self, v: u32) -> u32 {
        get32(in self.idom.as_slice(), widen_u64(v), GraphIndex::Missing)
    }

    // Whether `a` dominates `b` (every node the root reaches dominates
    // itself).
    pub fn dominates(in self, a: u32, b: u32) -> bool {
        let unreached: u32 = GraphIndex::Missing;
        if self.idom(a) == unreached || self.idom(b) == unreached {
            false
        } else {
            let mut cur = b;
            loop {
                if cur == a {
                    break true;
                }
                if cur == self.root {
                    break false;
                }
                cur = self.idom(cur);
            }
        }
    }
}

// The immediate dominators of every node `root` reaches. The iteration runs
// over reverse postorder until no `idom` changes.
pub fn dominators(in g: Graph, root: u32) -> Dominators {
    let n = g.node_count();
    let unreached: u32 = GraphIndex::Missing;
    let mut idom = filled32(n, unreached);
    let rpo = reverse_postorder(in g, root);
    let count = rpo.len();
    if count > 0 {
        // po[v] is v's postorder number: higher is closer to the root.
        let mut po = filled32(n, 0);
        for i in 0..count {
            let v = get32(in rpo.as_slice(), i, 0);
            po.try_set(widen_u64(v), wrapping_u32(wrapping_sub(wrapping_sub(count, 1), i)));
        }
        idom.try_set(widen_u64(root), root);
        loop {
            let mut changed = false;
            // Every node but the root (`rpo[0]`), in reverse postorder.
            for k in 1..count {
                let b = get32(in rpo.as_slice(), k, 0);
                // Intersect the dominators of the predecessors processed so far.
                let (lo, hi) = g.pred_range(b);
                let mut new_idom = unreached;
                for e in lo..hi {
                    let p = g.pred_edge(e);
                    if get32(in idom.as_slice(), widen_u64(p), unreached) != unreached {
                        new_idom = if new_idom == unreached {
                            p
                        } else {
                            intersect(in idom.as_slice(), in po.as_slice(), root, p, new_idom)
                        };
                    }
                }
                let bk = widen_u64(b);
                if get32(in idom.as_slice(), bk, unreached) != new_idom {
                    idom.try_set(bk, new_idom);
                    changed = true;
                }
            }
            if !changed {
                break;
            }
        }
    }
    Dominators { root: root, idom: idom }
}

// The nearest common dominator of `a` and `b` in the partial tree `idom`:
// walk the finger with the lower postorder number up until they meet.
fn intersect(in idom: Slice[u32], in po: Slice[u32], root: u32, a: u32, b: u32) -> u32 {
    let mut finger_a = a;
    let mut finger_b = b;
    loop {
        if finger_a == finger_b {
            break finger_a;
        }
        loop {
            if get32(in po, widen_u64(finger_a), 0) >= get32(in po, widen_u64(finger_b), 0) {
                break;
            }
            finger_a = get32(in idom, widen_u64(finger_a), root);
        }
        loop {
            if get32(in po, widen_u64(finger_b), 0) >= get32(in po, widen_u64(finger_a), 0) {
                break;
            }
            finger_b = get32(in idom, widen_u64(finger_b), root);
        }
    }
}

test {
    use self::graph_builder;

    // @case irreducible_loop(true, 1, 3, 1)
    // @case next_predecessor_row(false, 0, 2, 1)
    fn test_dominator_graph_boundary(
        irreducible: bool,
        root: u32,
        node: u32,
        immediate: u32
    ) -> bool {
        let mut builder = graph_builder(4);
        if irreducible {
            // Both entries to the loop are reachable from the root.
            builder.add_edge(1, 0);
            builder.add_edge(1, 2);
            builder.add_edge(0, 3);
            builder.add_edge(3, 2);
            builder.add_edge(2, 3);
        } else {
            builder.add_edge(0, 1);
            builder.add_edge(0, 3);
            builder.add_edge(1, 2);
        }
        let graph = builder.build();
        dominators(in graph, root).idom(node) == immediate
    }

    // @case root(0, 0, 0, 0, true)
    // @case diamond_join(0, 3, 0, 1, false)
    // @case chain_after_join(0, 4, 3, 3, true)
    // @case reached_self(0, 2, 0, 2, true)
    // @case unreachable(0, 5, 4294967295, 0, false)
    // @case different_root(1, 3, 1, 1, true)
    // @case back_edge(2, 1, 3, 3, true)
    // @case invalid_root(6, 0, 4294967295, 0, false)
    // @case invalid_node(0, 6, 4294967295, 0, false)
    fn test_dominators(
        root: u32,
        node: u32,
        immediate: u32,
        candidate: u32,
        expected: bool
    ) -> bool {
        let mut builder = graph_builder(6);
        builder.add_edge(0, 1);
        builder.add_edge(0, 2);
        builder.add_edge(1, 3);
        builder.add_edge(2, 3);
        builder.add_edge(3, 4);
        builder.add_edge(3, 1);
        let graph = builder.build();
        let result = dominators(in graph, root);
        result.root() == root
            && result.idom(node) == immediate
            && result.dominates(candidate, node) == expected
    }
}
