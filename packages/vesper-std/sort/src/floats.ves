// @vesper-std/sort::floats: sorting floats under the IEEE 754 total order.
use self::unstable::{
    sort,
    is_sorted
};
use self::stable::stable_sort;

// `f64::total_cmp` as an `Ord` model: the bit pattern as an `i64`, with the
// magnitude bits flipped for negative values, compares as the total order
// -NaN < -inf < .. < -0.0 < +0.0 < .. < +inf < +NaN.
model TotalOrderF64: Ord for f64 {
    fn cmp(in self, in other: f64) -> Ordering {
        let a = total_key_f64(self);
        let b = total_key_f64(other);
        if a < b {
            Less
        } else if a == b {
            Equal
        } else {
            Greater
        }
    }
}

// The `i64` whose signed order is the total order of `f64` values.
pub fn total_key_f64(x: f64) -> i64 {
    let b = wrapping_i64(to_bits_f64(x));
    b ^ wrapping_i64(wrapping_u64(wrapping_shr_i64(b, 63)) >> 1)
}

// Sorts `s` ascending under the total order; equal values may change order.
pub fn sort_f64(inout s: Slice[f64]) {
    use model TotalOrderF64;
    sort(inout s);
}

// Sorts `s` ascending under the total order, keeping equal values in order.
pub fn stable_sort_f64(inout s: Slice[f64]) {
    use model TotalOrderF64;
    stable_sort(inout s);
}

// Whether `s` is ascending under the total order.
pub fn is_sorted_f64(in s: Slice[f64]) -> bool {
    use model TotalOrderF64;
    is_sorted(in s)
}

// The `u32` whose unsigned order is the total order of the `f32` with bit
// pattern `b`: the sign bit flipped for positive values, every bit for
// negative ones. `f32_bits_from_key` is its inverse.
pub fn total_key_f32_bits(b: u32) -> u32 {
    if (b & 2147483648) != 0 {
        ~b
    } else {
        b | 2147483648
    }
}

pub fn f32_bits_from_key(k: u32) -> u32 {
    if (k & 2147483648) != 0 {
        k & 2147483647
    } else {
        ~k
    }
}

// Sorts `f32` values held as bit patterns (`to_bits_f32`) ascending under
// the total order (`f32::total_cmp`), in place: each word is mapped to its
// order key, the keys are sorted, and mapped back.
pub fn sort_f32_bits(inout s: Slice[u32]) {
    let n = s.len();
    for i in 0..n {
        match s.try_get(i) {
            Option::Some(b) => {
                s.try_set(i, total_key_f32_bits(b));
            },
            Option::None => {},
        }
    }
    sort(inout s);
    for i in 0..n {
        match s.try_get(i) {
            Option::Some(k) => {
                s.try_set(i, f32_bits_from_key(k));
            },
            Option::None => {},
        }
    }
}

test {
    // @case equal_zero(0, 0, Equal)
    // @case equal_nan_payload(0x7ff8000000000001, 0x7ff8000000000001, Equal)
    // @case signed_zero(0x8000000000000000, 0, Less)
    // @case reversed_signed_zero(0, 0x8000000000000000, Greater)
    fn test_total_order_f64_comparison(a: u64, b: u64, expected: Ordering) -> bool {
        use model TotalOrderF64;
        let left: f64 = from_bits_f64(a);
        let right: f64 = from_bits_f64(b);
        left.cmp(right) == expected
    }

    // @case across_signed_zero(0x8000000000000000, 0, true)
    // @case negative_nan(0xfff8000000000001, 0xfff0000000000000, true)
    // @case negative_subnormal(0x8000000000000001, 0x8000000000000000, true)
    // @case positive_subnormal(0, 1, true)
    // @case positive_nan(0x7ff0000000000000, 0x7ff8000000000001, true)
    // @case reverse(0x3ff0000000000000, 0xbff0000000000000, false)
    // @case identical_nan(0x7ff8000000000001, 0x7ff8000000000001, false)
    fn test_total_key_f64(a: u64, b: u64, ordered: bool) -> bool {
        let x = total_key_f64(from_bits_f64(a));
        let y = total_key_f64(from_bits_f64(b));
        (x < y) == ordered && (x == y) == (a == b)
    }

    // @case unstable(false)
    // @case stable(true)
    fn test_float_total_order(stable: bool) -> bool {
        let mut values = ChunkSeq::new[f64]();
        values.push(from_bits_f64(0x7ff8000000000001));
        values.push(from_bits_f64(0x0000000000000000));
        values.push(from_bits_f64(0xfff0000000000000));
        values.push(from_bits_f64(0x8000000000000000));
        values.push(from_bits_f64(0xfff8000000000001));
        values.push(from_bits_f64(0x7ff0000000000000));
        if is_sorted_f64(in values.as_slice()) {
            return false;
        }
        if stable {
            stable_sort_f64(inout values.as_slice_mut());
        } else {
            sort_f64(inout values.as_slice_mut());
        }
        let mut expected = ChunkSeq::new[u64]();
        expected.push(0xfff8000000000001);
        expected.push(0xfff0000000000000);
        expected.push(0x8000000000000000);
        expected.push(0x0000000000000000);
        expected.push(0x7ff0000000000000);
        expected.push(0x7ff8000000000001);
        for i in 0..expected.len() {
            match values.try_get(i) {
                Option::Some(value) => {
                    if expected.try_get(i) != Option::Some(to_bits_f64(value)) {
                        return false;
                    }
                },
                Option::None => return false,
            }
        }
        values.len() == 6 && is_sorted_f64(in values.as_slice())
    }

    // @case negative_nan(0xffc00001, 0x003ffffe)
    // @case negative_infinity(0xff800000, 0x007fffff)
    // @case negative_zero(0x80000000, 0x7fffffff)
    // @case positive_zero(0, 0x80000000)
    // @case positive_subnormal(1, 0x80000001)
    // @case positive_infinity(0x7f800000, 0xff800000)
    // @case positive_nan(0x7fc00001, 0xffc00001)
    fn test_f32_keys(bits: u32, key: u32) -> bool {
        total_key_f32_bits(bits) == key && f32_bits_from_key(key) == bits
    }

    // @case signed_zeros(0, 0x80000000, 0x80000000, 0)
    // @case infinities(0x7f800000, 0xff800000, 0xff800000, 0x7f800000)
    // @case negative_nan_before_negative_infinity(0xff800000, 0xffc00001, 0xffc00001, 0xff800000)
    // @case positive_nan_payloads(0x7fc00002, 0x7fc00001, 0x7fc00001, 0x7fc00002)
    fn test_sort_f32_bits(a: u32, b: u32, first: u32, second: u32) -> bool {
        let mut values = ChunkSeq::new[u32]();
        values.push(a);
        values.push(b);
        sort_f32_bits(inout values.as_slice_mut());
        values.try_get(0) == Option::Some(first) && values.try_get(1) == Option::Some(second)
    }
}
