// @vesper-std/sort::stable: a stable bottom-up merge sort.
use self::unstable::{lt, insertion};
use @vesper-std/sugar::{guard, when};

// The length of the runs `stable_sort` insertion sorts before merging.
const RUN: u64 = 16;

// `a` or `b`, whichever is smaller.
fn min_u64(a: u64, b: u64) -> u64 {
    if a < b {
        a
    } else {
        b
    }
}

// Merges the sorted runs `src[lo..mid]` and `src[mid..hi]` into
// `dst[lo..hi]`. On equal elements the left run's comes first. Once one run
// is used up, the rest of the other is copied in one block.
fn merge[T: mod copy + Ord](in src: Slice[T], inout dst: Slice[T], lo: u64, mid: u64, hi: u64) {
    let mut left = lo;
    let mut right = mid;
    let mut out = lo;
    loop {
        if left >= mid || right >= hi {
            break;
        }
        match src.try_get(left) {
            Option::Some(a) => match src.try_get(right) {
                Option::Some(b) => {
                    if lt(b, a) {
                        dst.try_set(out, b);
                        right = wrapping_add(right, 1);
                    } else {
                        dst.try_set(out, a);
                        left = wrapping_add(left, 1);
                    }
                    out = wrapping_add(out, 1);
                },
                Option::None => {
                    right = hi;
                },
            },
            Option::None => {
                left = mid;
            },
        }
    }
    if left < mid {
        dst.try_copy_from(out, in src[left..mid]);
    } else if right < hi {
        dst.try_copy_from(out, in src[right..hi]);
    }
}

// One merge pass of runs of `width` from `src` into `dst` (both of length
// `n`); a last run without a partner is copied.
fn pass[T: mod copy + Ord](in src: Slice[T], inout dst: Slice[T], n: u64, width: u64) {
    let mut lo: u64 = 0;
    loop {
        if lo >= n {
            break;
        }
        let mid = min_u64(wrapping_add(lo, width), n);
        // `hi` wraps past the end only when `width` is near `u64::MAX`.
        let hi_unclamped = wrapping_add(mid, width);
        let hi = if hi_unclamped < n && hi_unclamped > mid {
            hi_unclamped
        } else {
            n
        };
        merge(in src, inout dst, lo, mid, hi);
        lo = hi;
    }
}

// Sorts `s` in place, ascending, keeping equal elements in their order.
// Runs of `RUN` are insertion sorted in place, then merged in passes between
// `s` and one scratch sequence of `s.len()` elements.
pub fn stable_sort[T: mod copy + Ord](inout s: Slice[T]) {
    let n = s.len();
    if n < 2 {
        return;
    }
    let mut lo: u64 = 0;
    loop {
        if lo >= n {
            break;
        }
        let hi = min_u64(wrapping_add(lo, RUN), n);
        insertion(inout s, lo, hi);
        lo = hi;
    }
    if n <= RUN {
        return;
    }
    when let Option::Some(first) = s.try_get(0) {
        merge_runs(inout s, n, RUN, first);
    }
}

// The merge passes of `stable_sort` over runs of `run` sorted elements;
// `first` fills the scratch sequence before the first pass.
fn merge_runs[T: mod copy + Ord](inout s: Slice[T], n: u64, run: u64, first: T) {
    let mut scratch: ChunkSeq[T] = ChunkSeq::with_capacity[T](n);
    scratch.resize(n, first);
    let mut width = run;
    let mut in_scratch = false;
    loop {
        if width >= n {
            break;
        }
        if in_scratch {
            pass(in scratch.as_slice(), inout s, n, width);
        } else {
            pass(in s, inout scratch.as_slice_mut(), n, width);
        }
        in_scratch = !in_scratch;
        width = wrapping_mul(width, 2);
    }
    if in_scratch {
        s.try_copy_from(0, in scratch.as_slice());
    }
}

test {
    copy struct StableProbe {
        key: u64,
        payload: u64
    }

    model StableProbeOrder: Ord for StableProbe {
        fn cmp(in self, in other: StableProbe) -> Ordering {
            self.key.cmp(other.key)
        }
    }

    // @case empty(0)
    // @case singleton(1)
    // @case reversed_pair(2)
    // @case one_run(16)
    // @case partial_second_run(17)
    // @case two_runs(32)
    // @case multiple_passes(65)
    fn test_stable_sort(count: u64) -> bool {
        use model StableProbeOrder;
        let mut items = ChunkSeq::new[StableProbe]();
        for i in 0..count {
            items.push(StableProbe { key: 1 ^ (i & 1), payload: wrapping_sub(count, i) });
        }
        stable_sort(inout items.as_slice_mut());
        let zeros = count >> 1;
        for i in 0..count {
            let expected_key: u64 = if i < zeros {
                0
            } else {
                1
            };
            let original_index = if i < zeros {
                wrapping_add(i << 1, 1)
            } else {
                wrapping_sub(i, zeros) << 1
            };
            guard let Option::Some(item) = items.try_get(i) else {
                return false;
            };
            let payload = wrapping_sub(count, original_index);
            if item.key != expected_key || item.payload != payload {
                return false;
            }
        }
        items.len() == count
    }

    fn test_stable_sort_descending_many_runs() -> bool {
        let count: u64 = 512;
        let mut items = ChunkSeq::new[u64]();
        for i in 0..count {
            items.push(wrapping_sub(count, i));
        }
        stable_sort(inout items.as_slice_mut());
        for i in 0..count {
            if items.try_get(i) != Option::Some(wrapping_add(i, 1)) {
                return false;
            }
        }
        true
    }
}
