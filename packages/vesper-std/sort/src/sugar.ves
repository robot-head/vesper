// @vesper-std/sort::sugar: the package's control-flow sugar.
//
// Every element read in this package is a `try_get` whose `None` arm no
// index reaches, so most code needs "take the value or leave". These two
// sugars name that shape instead of spelling out a `match` each time.
//
// A template's `$rhs` runs once, and `$body` or `$diverge` only on its own
// arm, exactly as the `match` it expands to.

// `guard let PAT = rhs else { .. };` binds `PAT` for the rest of the block,
// or runs the `else` block, which must leave it (`return`, `break` or
// `continue`).
pub sugar guard: stmt {
    rule (guard let $pat:pat = $rhs:expr else $diverge:block; $..rest:stmts) => {
        match $rhs {
            $pat => {
                $..rest
            },
            _ => $diverge,
        }
    }
}

// `when let PAT = rhs { .. }` runs the block with `PAT` bound when `rhs`
// matches it, and does nothing otherwise.
pub sugar when: stmt {
    rule (when let $pat:pat = $rhs:expr $body:block) => {
        match $rhs {
            $pat => $body,
            _ => {},
        }
    }
}
