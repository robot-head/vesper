// Patterns and exhaustiveness: `check::is_uninhabited` and
// `check::matrix_covered` (constructor specialization, nested enum
// payloads included), with `Checker::irrefutable` and `Checker::coverage`
// on top. Patterns are rows of a flat table; pattern 0 is the wildcard the
// specialization fills missing payloads with.

use @vesper/check-data::util::{
    add,
    inc,
    n32,
    u32_at,
    w
};
use @vesper/check-data::names::{
    Names
};
use @vesper/check-data::types::{
    Types,
    Vars,
    substitute
};
use @vesper/check-data::world::{
    Adt,
    Field,
    Variant,
    World
};
use self::relations::{
    item
};

const NONE32: u32 = 4294967295;
const K_NAMED: u8 = 1;
const K_TUPLE: u8 = 2;

// Pattern kinds.
pub const P_WILD: u8 = 0;
pub const P_BIND: u8 = 1;
pub const P_TRUE: u8 = 2;
pub const P_FALSE: u8 = 3;
// Any other literal (integer, float, string).
pub const P_LIT: u8 = 4;
pub const P_TUPLE: u8 = 5;
pub const P_CTOR: u8 = 6;

pub copy struct Pat {
    kind: u8,
    // Constructor: the last `::` segment of its name.
    name: u32,
    // Tuple and constructor sub-patterns: kids[a..a+n] (a constructor's
    // field names are knames[a..a+n]).
    a: u32,
    n: u32,
}

pub struct Pats {
    pats: ChunkSeq[Pat],
    kids: ChunkSeq[u32],
    knames: ChunkSeq[u32],
    // Symbols of the specialization tags.
    s_true: u32,
    s_false: u32,
    s_tuple: u32,
    s_bool: u32,
    // s_index[i]: the symbol of `i.to_string()`, a tuple field's name.
    s_index: ChunkSeq[u32],
}

pub fn pats_new(inout names: Names) -> Pats {
    let mut p = Pats {
        pats: ChunkSeq::new[Pat](),
        kids: ChunkSeq::new[u32](),
        knames: ChunkSeq::new[u32](),
        s_true: names.intern(in "true".as_bytes()),
        s_false: names.intern(in "false".as_bytes()),
        s_tuple: names.intern(in "tuple".as_bytes()),
        s_bool: names.intern(in "bool".as_bytes()),
        s_index: ChunkSeq::new[u32]()
    };
    let no_kids: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let wild = p.add(P_WILD, 0, in no_kids, in no_kids);
    p
}

impl Pats {
    pub fn pat(in self, i: u32) -> Pat {
        match self.pats.try_get(w(i)) {
            Option::Some(x) => x,
            Option::None => Pat {
                kind: P_WILD,
                name: 0,
                a: 0,
                n: 0
            },
        }
    }

    pub fn kid(in self, i: u64) -> u32 {
        u32_at(in self.kids, i)
    }

    pub fn kname(in self, i: u64) -> u32 {
        u32_at(in self.knames, i)
    }

    // A pattern with sub-patterns `kids` named `knames` (constructors).
    pub fn add(inout self, kind: u8, name: u32, in kids: ChunkSeq[u32], in knames: ChunkSeq[u32])
        -> u32 {
        let a = n32(self.kids.len());
        for i in 0..kids.len() {
            self.kids.push(u32_at(in kids, i));
            if i < knames.len() {
                self.knames.push(u32_at(in knames, i));
            } else {
                self.knames.push(0);
            }
        }
        let id = n32(self.pats.len());
        self
            .pats
            .push(
            Pat {
                kind: kind,
                name: name,
                a: a,
                n: n32(kids.len())
            }
        );
        id
    }

    // The symbol of decimal `i`.
    pub fn index_name(inout self, inout names: Names, i: u64) -> u32 {
        loop {
            if self.s_index.len() > i {
                break;
            }
            let mut text = ChunkSeq::new[u8]();
            push_decimal_text(inout text, self.s_index.len());
            let s = names.intern(in text.as_slice());
            self.s_index.push(s);
        }
        u32_at(in self.s_index, i)
    }

    fn wildcard(in self, p: u32) -> bool {
        let k = self.pat(p).kind;
        k == P_WILD || k == P_BIND
    }
}

fn push_decimal_text(inout out: ChunkSeq[u8], v: u64) {
    if v >= 10 {
        push_decimal_text(inout out, v / 10);
    }
    out.push(wrapping_u8(wrapping_add(v % 10, 48)));
}

fn contains(in s: ChunkSeq[u32], x: u32) -> bool {
    for i in 0..s.len() {
        if u32_at(in s, i) == x {
            return true;
        }
    }
    false
}

// `check::is_uninhabited`; `seen` holds the ADT names being expanded.
pub fn is_uninhabited(inout t: Types, in wd: World, ty: u32, inout seen: ChunkSeq[u32]) -> bool {
    let n = t.node(ty);
    if n.kind == K_NAMED && n.name == wd.k.never {
        return true;
    }
    if n.kind == K_TUPLE {
        for i in 0..w(n.n) {
            let x = item(in t, add(w(n.a), i));
            if is_uninhabited(inout t, in wd, x, inout seen) {
                return true;
            }
        }
        return false;
    }
    if n.kind != K_NAMED {
        return false;
    }
    let ai = wd.lookup(n.name);
    if ai == NONE32 {
        return false;
    }
    let a = wd.adt(ai);
    if a.vn == 0 {
        return true;
    }
    if contains(in seen, n.name) {
        return false;
    }
    seen.push(n.name);
    let vars = wd.vars_of(in t, a, ty);
    let mut all = true;
    for vi in 0..w(a.vn) {
        let v = wd.variant(add(w(a.va), vi));
        let mut any = false;
        for fi in 0..w(v.fc) {
            let f = wd.field(add(w(v.fa), fi));
            let ft = substitute(inout t, f.ty, in vars);
            if is_uninhabited(inout t, in wd, ft, inout seen) {
                any = true;
                break;
            }
        }
        if !any {
            all = false;
            break;
        }
    }
    seen.truncate(wrapping_sub(seen.len(), 1));
    all
}

// A coverage matrix: `rows` rows of `width` pattern ids, row-major, over
// column types `types`.
pub struct Matrix {
    cells: ChunkSeq[u32],
    rows: u64,
    types: ChunkSeq[u32],
}

pub fn matrix_new(in types: ChunkSeq[u32]) -> Matrix {
    let mut ts: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](types.len());
    for i in 0..types.len() {
        ts.push(u32_at(in types, i));
    }
    Matrix {
        cells: ChunkSeq::new[u32](),
        rows: 0,
        types: ts
    }
}

impl Matrix {
    pub fn cell(in self, r: u64, c: u64) -> u32 {
        u32_at(in self.cells, add(wrapping_mul(r, self.types.len()), c))
    }

    pub fn push_row(inout self, in row: ChunkSeq[u32]) {
        for i in 0..row.len() {
            self.cells.push(u32_at(in row, i));
        }
        self.rows = inc(self.rows);
    }
}

// The constructors of a column type: tags and their payload fields (names
// and substituted types), flattened.
struct Ctors {
    tags: ChunkSeq[u32],
    // fields of tag i: fnames/ftypes[fa[i]..fa[i+1]]
    fa: ChunkSeq[u32],
    fnames: ChunkSeq[u32],
    ftypes: ChunkSeq[u32],
}

fn ctors_new() -> Ctors {
    let mut fa: ChunkSeq[u32] = ChunkSeq::new[u32]();
    fa.push(0);
    Ctors {
        tags: ChunkSeq::new[u32](),
        fa: fa,
        fnames: ChunkSeq::new[u32](),
        ftypes: ChunkSeq::new[u32]()
    }
}

impl Ctors {
    fn close(inout self, tag: u32) {
        self.tags.push(tag);
        self.fa.push(n32(self.fnames.len()));
    }
}

// `check::matrix_covered(world, rows, types, depth)`.
pub fn matrix_covered(
    inout t: Types,
    inout names: Names,
    in wd: World,
    inout ps: Pats,
    in m: Matrix,
    depth: u64
) -> bool {
    let width = m.types.len();
    if width == 0 {
        return m.rows != 0;
    }
    if m.rows == 0 {
        for i in 0..width {
            let mut seen: ChunkSeq[u32] = ChunkSeq::new[u32]();
            if is_uninhabited(inout t, in wd, u32_at(in m.types, i), inout seen) {
                return true;
            }
        }
        return false;
    }
    if depth > 64 {
        return false;
    }
    for r in 0..m.rows {
        let mut all = true;
        for c in 0..width {
            if !ps.wildcard(m.cell(r, c)) {
                all = false;
                break;
            }
        }
        if all {
            return true;
        }
    }
    let t0 = u32_at(in m.types, 0);
    let n0 = t.node(t0);
    let mut cs = ctors_new();
    let mut known = true;
    if n0.kind == K_NAMED && n0.name == ps.s_bool {
        cs.close(ps.s_true);
        cs.close(ps.s_false);
    } else if n0.kind == K_NAMED {
        let ai = wd.lookup(n0.name);
        if ai == NONE32 {
            known = false;
        } else {
            let a = wd.adt(ai);
            let vars = wd.vars_of(in t, a, t0);
            for vi in 0..w(a.vn) {
                let v = wd.variant(add(w(a.va), vi));
                for fi in 0..w(v.fc) {
                    let f = wd.field(add(w(v.fa), fi));
                    cs.fnames.push(f.name);
                    let ft = substitute(inout t, f.ty, in vars);
                    cs.ftypes.push(ft);
                }
                cs.close(v.name);
            }
        }
    } else if n0.kind == K_TUPLE {
        for i in 0..w(n0.n) {
            let s = ps.index_name(inout names, i);
            cs.fnames.push(s);
            cs.ftypes.push(item(in t, add(w(n0.a), i)));
        }
        cs.close(ps.s_tuple);
    } else {
        known = false;
    }
    if !known {
        // No constructors: keep the rows whose first column is a wildcard.
        let mut rest_types: ChunkSeq[u32] = ChunkSeq::new[u32]();
        for i in 1..width {
            rest_types.push(u32_at(in m.types, i));
        }
        let mut rest = matrix_new(in rest_types);
        for r in 0..m.rows {
            if ps.wildcard(m.cell(r, 0)) {
                let mut row: ChunkSeq[u32] = ChunkSeq::new[u32]();
                for c in 1..width {
                    row.push(m.cell(r, c));
                }
                rest.push_row(in row);
            }
        }
        return matrix_covered(inout t, inout names, in wd, inout ps, in rest, inc(depth));
    }
    for ci in 0..cs.tags.len() {
        let tag = u32_at(in cs.tags, ci);
        let fa = w(u32_at(in cs.fa, ci));
        let fb = w(u32_at(in cs.fa, inc(ci)));
        let nf = wrapping_sub(fb, fa);
        let mut ts: ChunkSeq[u32] = ChunkSeq::new[u32]();
        for i in fa..fb {
            ts.push(u32_at(in cs.ftypes, i));
        }
        for i in 1..width {
            ts.push(u32_at(in m.types, i));
        }
        let mut spec = matrix_new(in ts);
        for r in 0..m.rows {
            let p = m.cell(r, 0);
            let mut row: ChunkSeq[u32] = ChunkSeq::new[u32]();
            let mut keep = true;
            if ps.wildcard(p) {
                for i in 0..nf {
                    row.push(0);
                }
            } else {
                let x = ps.pat(p);
                if x.kind == P_CTOR && x.name == tag {
                    for i in fa..fb {
                        let fname = u32_at(in cs.fnames, i);
                        let mut found = NONE32;
                        for j in 0..w(x.n) {
                            if ps.kname(add(w(x.a), j)) == fname {
                                found = ps.kid(add(w(x.a), j));
                                break;
                            }
                        }
                        if found == NONE32 {
                            // A constructor pattern without a field of its
                            // variant: Rust's closure returns false.
                            return false;
                        }
                        row.push(found);
                    }
                } else if x.kind == P_TUPLE && tag == ps.s_tuple && w(x.n) == nf {
                    for j in 0..w(x.n) {
                        row.push(ps.kid(add(w(x.a), j)));
                    }
                } else if (x.kind == P_TRUE && tag == ps.s_true)
                    || (x.kind == P_FALSE && tag == ps.s_false) {
                    keep = true;
                } else {
                    keep = false;
                }
            }
            if keep {
                for c in 1..width {
                    row.push(m.cell(r, c));
                }
                spec.push_row(in row);
            }
        }
        if !matrix_covered(inout t, inout names, in wd, inout ps, in spec, inc(depth)) {
            return false;
        }
    }
    true
}

// `Checker::irrefutable(p, ty)`.
pub fn irrefutable(
    inout t: Types,
    inout names: Names,
    in wd: World,
    inout ps: Pats,
    p: u32,
    ty: u32
) -> bool {
    let mut ts: ChunkSeq[u32] = ChunkSeq::new[u32]();
    ts.push(ty);
    let mut m = matrix_new(in ts);
    let mut row: ChunkSeq[u32] = ChunkSeq::new[u32]();
    row.push(p);
    m.push_row(in row);
    matrix_covered(inout t, inout names, in wd, inout ps, in m, 0)
}

// Whether the match arms `arms` cover `ty` (`Checker::coverage` raises
// E0212 when they do not).
pub fn arms_cover(
    inout t: Types,
    inout names: Names,
    in wd: World,
    inout ps: Pats,
    in arms: ChunkSeq[u32],
    ty: u32
) -> bool {
    let mut ts: ChunkSeq[u32] = ChunkSeq::new[u32]();
    ts.push(ty);
    let mut m = matrix_new(in ts);
    for i in 0..arms.len() {
        let mut row: ChunkSeq[u32] = ChunkSeq::new[u32]();
        row.push(u32_at(in arms, i));
        m.push_row(in row);
    }
    matrix_covered(inout t, inout names, in wd, inout ps, in m, 0)
}
