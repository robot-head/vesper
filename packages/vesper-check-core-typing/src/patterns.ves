// Patterns and exhaustiveness: `check::is_uninhabited` and
// `check::matrix_covered` (constructor specialization, nested enum
// payloads included), with `Checker::irrefutable` and `Checker::coverage`
// on top. Patterns are rows of a flat table; pattern 0 is the wildcard the
// specialization fills missing payloads with.

use @vesper/check-data::util::{add, inc, n32, u32_at, w};
use @vesper/check-data::names::{Names};
use @vesper/check-data::types::{Types, Vars, substitute, TyKind};
use @vesper/check-data::world::{Adt, Field, Variant, World};
use self::relations::{item};

const NONE32: u32 = 4294967295;

// Pattern kinds.
pub const P_WILD: u8 = 0;
pub const P_BIND: u8 = 1;
pub const P_TRUE: u8 = 2;
pub const P_FALSE: u8 = 3;
// Any other literal (integer, float, string).
pub const P_LIT: u8 = 4;
pub const P_TUPLE: u8 = 5;
pub const P_CTOR: u8 = 6;

pub copy struct Pat {
    kind: u8,
    // Constructor: the last `::` segment of its name.
    name: u32,
    // Tuple and constructor sub-patterns: kids[kid_start..+kid_count] (a
    // constructor's field names are kid_names[kid_start..+kid_count]).
    kid_start: u32,
    kid_count: u32,
}

pub struct Pats {
    pats: ChunkSeq[Pat],
    kids: ChunkSeq[u32],
    kid_names: ChunkSeq[u32],
    // Symbols of the specialization tags.
    true_sym: u32,
    false_sym: u32,
    tuple_sym: u32,
    bool_sym: u32,
    // index_syms[i]: the symbol of `i.to_string()`, a tuple field's name.
    index_syms: ChunkSeq[u32],
}

pub fn pats_new(inout names: Names) -> Pats {
    let mut pats = Pats {
        pats: ChunkSeq::new[Pat](),
        kids: ChunkSeq::new[u32](),
        kid_names: ChunkSeq::new[u32](),
        true_sym: names.intern(in "true".as_bytes()),
        false_sym: names.intern(in "false".as_bytes()),
        tuple_sym: names.intern(in "tuple".as_bytes()),
        bool_sym: names.intern(in "bool".as_bytes()),
        index_syms: ChunkSeq::new[u32]()
    };
    let no_kids: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let wild = pats.add(P_WILD, 0, in no_kids, in no_kids);
    pats
}

impl Pats {
    pub fn pat(in self, i: u32) -> Pat {
        match self.pats.try_get(w(i)) {
            Option::Some(x) => x,
            Option::None => Pat { kind: P_WILD, name: 0, kid_start: 0, kid_count: 0 },
        }
    }

    pub fn kid(in self, i: u64) -> u32 {
        u32_at(in self.kids, i)
    }

    pub fn kname(in self, i: u64) -> u32 {
        u32_at(in self.kid_names, i)
    }

    // A pattern with sub-patterns `kids` named `kid_names` (constructors).
    pub fn add(
        inout self,
        kind: u8,
        name: u32,
        in kids: ChunkSeq[u32],
        in kid_names: ChunkSeq[u32]
    ) -> u32 {
        let kid_start = n32(self.kids.len());
        for i in 0..kids.len() {
            self.kids.push(u32_at(in kids, i));
            if i < kid_names.len() {
                self.kid_names.push(u32_at(in kid_names, i));
            } else {
                self.kid_names.push(0);
            }
        }
        let id = n32(self.pats.len());
        self.pats.push(Pat {
            kind: kind,
            name: name,
            kid_start: kid_start,
            kid_count: n32(kids.len())
        });
        id
    }

    // The symbol of decimal `i`.
    pub fn index_name(inout self, inout names: Names, i: u64) -> u32 {
        loop {
            if self.index_syms.len() > i {
                break;
            }
            let mut text = ChunkSeq::new[u8]();
            push_decimal_text(inout text, self.index_syms.len());
            let sym = names.intern(in text.as_slice());
            self.index_syms.push(sym);
        }
        u32_at(in self.index_syms, i)
    }

    fn wildcard(in self, pat_id: u32) -> bool {
        let kind = self.pat(pat_id).kind;
        kind == P_WILD || kind == P_BIND
    }
}

fn push_decimal_text(inout out: ChunkSeq[u8], value: u64) {
    if value >= 10 {
        push_decimal_text(inout out, value / 10);
    }
    out.push(wrapping_u8(wrapping_add(value % 10, 48)));
}

fn contains(in seq: ChunkSeq[u32], value: u32) -> bool {
    for i in 0..seq.len() {
        if u32_at(in seq, i) == value {
            return true;
        }
    }
    false
}

// `check::is_uninhabited`; `seen` holds the ADT names being expanded.
pub fn is_uninhabited(
    inout types: Types,
    in world: World,
    ty: u32,
    inout seen: ChunkSeq[u32]
) -> bool {
    let node = types.node(ty);
    if node.kind == TyKind::Named && node.name == world.k.never {
        return true;
    }
    if node.kind == TyKind::Tuple {
        for i in 0..w(node.n) {
            let elem_ty = item(in types, add(w(node.a), i));
            if is_uninhabited(inout types, in world, elem_ty, inout seen) {
                return true;
            }
        }
        return false;
    }
    if node.kind != TyKind::Named {
        return false;
    }
    let adt_index = world.lookup(node.name);
    if adt_index == NONE32 {
        return false;
    }
    let adt = world.adt(adt_index);
    if adt.vn == 0 {
        return true;
    }
    if contains(in seen, node.name) {
        return false;
    }
    seen.push(node.name);
    let vars = world.vars_of(in types, adt, ty);
    let mut all = true;
    for vi in 0..w(adt.vn) {
        let variant = world.variant(add(w(adt.va), vi));
        let mut any = false;
        for fi in 0..w(variant.fc) {
            let field = world.field(add(w(variant.fa), fi));
            let field_ty = substitute(inout types, field.ty, in vars);
            if is_uninhabited(inout types, in world, field_ty, inout seen) {
                any = true;
                break;
            }
        }
        if !any {
            all = false;
            break;
        }
    }
    seen.truncate(wrapping_sub(seen.len(), 1));
    all
}

// A coverage matrix: `row_count` rows of `width` pattern ids, row-major, over
// column types `types`.
pub struct Matrix {
    cells: ChunkSeq[u32],
    row_count: u64,
    types: ChunkSeq[u32],
}

pub fn matrix_new(in types: ChunkSeq[u32]) -> Matrix {
    let mut col_types: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](types.len());
    for i in 0..types.len() {
        col_types.push(u32_at(in types, i));
    }
    Matrix { cells: ChunkSeq::new[u32](), row_count: 0, types: col_types }
}

impl Matrix {
    pub fn cell(in self, row: u64, col: u64) -> u32 {
        u32_at(in self.cells, add(wrapping_mul(row, self.types.len()), col))
    }

    pub fn push_row(inout self, in row: ChunkSeq[u32]) {
        for i in 0..row.len() {
            self.cells.push(u32_at(in row, i));
        }
        self.row_count = inc(self.row_count);
    }
}

// The constructors of a column type: tags and their payload fields (names
// and substituted types), flattened.
struct Ctors {
    tags: ChunkSeq[u32],
    // fields of tag i: field_names/field_types[field_starts[i]..field_starts[i+1]]
    field_starts: ChunkSeq[u32],
    field_names: ChunkSeq[u32],
    field_types: ChunkSeq[u32],
}

fn ctors_new() -> Ctors {
    let mut field_starts: ChunkSeq[u32] = ChunkSeq::new[u32]();
    field_starts.push(0);
    Ctors {
        tags: ChunkSeq::new[u32](),
        field_starts: field_starts,
        field_names: ChunkSeq::new[u32](),
        field_types: ChunkSeq::new[u32]()
    }
}

impl Ctors {
    fn close(inout self, tag: u32) {
        self.tags.push(tag);
        self.field_starts.push(n32(self.field_names.len()));
    }
}

// `check::matrix_covered(world, rows, types, depth)`.
pub fn matrix_covered(
    inout types: Types,
    inout names: Names,
    in world: World,
    inout pats: Pats,
    in matrix: Matrix,
    depth: u64
) -> bool {
    let width = matrix.types.len();
    if width == 0 {
        return matrix.row_count != 0;
    }
    if matrix.row_count == 0 {
        for i in 0..width {
            let mut seen: ChunkSeq[u32] = ChunkSeq::new[u32]();
            if is_uninhabited(inout types, in world, u32_at(in matrix.types, i), inout seen) {
                return true;
            }
        }
        return false;
    }
    if depth > 64 {
        return false;
    }
    for row_index in 0..matrix.row_count {
        let mut all = true;
        for col in 0..width {
            if !pats.wildcard(matrix.cell(row_index, col)) {
                all = false;
                break;
            }
        }
        if all {
            return true;
        }
    }
    let first_ty = u32_at(in matrix.types, 0);
    let first_node = types.node(first_ty);
    let mut ctors = ctors_new();
    let mut known = true;
    if first_node.kind == TyKind::Named && first_node.name == pats.bool_sym {
        ctors.close(pats.true_sym);
        ctors.close(pats.false_sym);
    } else if first_node.kind == TyKind::Named {
        let adt_index = world.lookup(first_node.name);
        if adt_index == NONE32 {
            known = false;
        } else {
            let adt = world.adt(adt_index);
            let vars = world.vars_of(in types, adt, first_ty);
            for vi in 0..w(adt.vn) {
                let variant = world.variant(add(w(adt.va), vi));
                for fi in 0..w(variant.fc) {
                    let field = world.field(add(w(variant.fa), fi));
                    ctors.field_names.push(field.name);
                    let field_ty = substitute(inout types, field.ty, in vars);
                    ctors.field_types.push(field_ty);
                }
                ctors.close(variant.name);
            }
        }
    } else if first_node.kind == TyKind::Tuple {
        for i in 0..w(first_node.n) {
            let index_sym = pats.index_name(inout names, i);
            ctors.field_names.push(index_sym);
            ctors.field_types.push(item(in types, add(w(first_node.a), i)));
        }
        ctors.close(pats.tuple_sym);
    } else {
        known = false;
    }
    if !known {
        // No constructors: keep the rows whose first column is a wildcard.
        let mut rest_types: ChunkSeq[u32] = ChunkSeq::new[u32]();
        for i in 1..width {
            rest_types.push(u32_at(in matrix.types, i));
        }
        let mut rest = matrix_new(in rest_types);
        for row_index in 0..matrix.row_count {
            if pats.wildcard(matrix.cell(row_index, 0)) {
                let mut row: ChunkSeq[u32] = ChunkSeq::new[u32]();
                for col in 1..width {
                    row.push(matrix.cell(row_index, col));
                }
                rest.push_row(in row);
            }
        }
        return matrix_covered(inout types, inout names, in world, inout pats, in rest, inc(depth));
    }
    for ctor_index in 0..ctors.tags.len() {
        let tag = u32_at(in ctors.tags, ctor_index);
        let field_start = w(u32_at(in ctors.field_starts, ctor_index));
        let field_end = w(u32_at(in ctors.field_starts, inc(ctor_index)));
        let field_count = wrapping_sub(field_end, field_start);
        let mut spec_types: ChunkSeq[u32] = ChunkSeq::new[u32]();
        for i in field_start..field_end {
            spec_types.push(u32_at(in ctors.field_types, i));
        }
        for i in 1..width {
            spec_types.push(u32_at(in matrix.types, i));
        }
        let mut spec = matrix_new(in spec_types);
        for row_index in 0..matrix.row_count {
            let pat_id = matrix.cell(row_index, 0);
            let mut row: ChunkSeq[u32] = ChunkSeq::new[u32]();
            let mut keep = true;
            if pats.wildcard(pat_id) {
                for i in 0..field_count {
                    row.push(0);
                }
            } else {
                let pat = pats.pat(pat_id);
                if pat.kind == P_CTOR && pat.name == tag {
                    for i in field_start..field_end {
                        let fname = u32_at(in ctors.field_names, i);
                        let mut found = NONE32;
                        for j in 0..w(pat.kid_count) {
                            if pats.kname(add(w(pat.kid_start), j)) == fname {
                                found = pats.kid(add(w(pat.kid_start), j));
                                break;
                            }
                        }
                        if found == NONE32 {
                            // A constructor pattern without a field of its
                            // variant: Rust's closure returns false.
                            return false;
                        }
                        row.push(found);
                    }
                } else if pat.kind == P_TUPLE
                    && tag == pats.tuple_sym
                    && w(pat.kid_count) == field_count
                {
                    for j in 0..w(pat.kid_count) {
                        row.push(pats.kid(add(w(pat.kid_start), j)));
                    }
                } else if (pat.kind == P_TRUE && tag == pats.true_sym)
                    || (pat.kind == P_FALSE && tag == pats.false_sym)
                {
                    keep = true;
                } else {
                    keep = false;
                }
            }
            if keep {
                for col in 1..width {
                    row.push(matrix.cell(row_index, col));
                }
                spec.push_row(in row);
            }
        }
        if !matrix_covered(inout types, inout names, in world, inout pats, in spec, inc(depth)) {
            return false;
        }
    }
    true
}

// `Checker::irrefutable(p, ty)`.
pub fn irrefutable(
    inout types: Types,
    inout names: Names,
    in world: World,
    inout pats: Pats,
    pat_id: u32,
    ty: u32
) -> bool {
    let mut col_types: ChunkSeq[u32] = ChunkSeq::new[u32]();
    col_types.push(ty);
    let mut matrix = matrix_new(in col_types);
    let mut row: ChunkSeq[u32] = ChunkSeq::new[u32]();
    row.push(pat_id);
    matrix.push_row(in row);
    matrix_covered(inout types, inout names, in world, inout pats, in matrix, 0)
}

// Whether the match arms `arms` cover `ty` (`Checker::coverage` raises
// E0212 when they do not).
pub fn arms_cover(
    inout types: Types,
    inout names: Names,
    in world: World,
    inout pats: Pats,
    in arms: ChunkSeq[u32],
    ty: u32
) -> bool {
    let mut col_types: ChunkSeq[u32] = ChunkSeq::new[u32]();
    col_types.push(ty);
    let mut matrix = matrix_new(in col_types);
    for i in 0..arms.len() {
        let mut row: ChunkSeq[u32] = ChunkSeq::new[u32]();
        row.push(u32_at(in arms, i));
        matrix.push_row(in row);
    }
    matrix_covered(inout types, inout names, in world, inout pats, in matrix, 0)
}
