// Integer literal values as the type arena keeps them: a sign and a u64
// magnitude (`Types::literal`; Rust holds an `i128`, which waits on SH2
// lane 2). `numeric::IntegerKind::{fits, default_for}` over that form.

use @vesper/check-data::world::{
    Known
};

const I64_MAX: u64 = 9223372036854775807;

// A literal value: `neg` is the sign (never set for zero).
pub copy struct Lit {
    neg: bool,
    mag: u64,
}

// -1, 0 or 1 as `a` is below, equal to or above `b`.
pub fn lit_cmp(a: Lit, b: Lit) -> i64 {
    if a.neg != b.neg {
        if a.neg {
            return -1;
        }
        return 1;
    }
    if a.mag == b.mag {
        return 0;
    }
    let below = a.mag < b.mag;
    if below != a.neg {
        -1
    } else {
        1
    }
}

pub fn lit_max(a: Lit, b: Lit) -> Lit {
    if lit_cmp(a, b) < 0 {
        b
    } else {
        a
    }
}

pub fn lit_min(a: Lit, b: Lit) -> Lit {
    if lit_cmp(a, b) > 0 {
        b
    } else {
        a
    }
}

// `n > i64::MAX as i128`.
pub fn above_i64(a: Lit) -> bool {
    !a.neg && a.mag > I64_MAX
}

// Width in bits of integer kind `s`, or 0 when `s` names no integer kind.
pub fn int_bits(k: Known, s: u32) -> u32 {
    if s == k.u8_ || s == k.i8_ {
        8
    } else if s == k.u16_ || s == k.i16_ {
        16
    } else if s == k.u32_ || s == k.i32_ {
        32
    } else if k.is_integer(s) {
        64
    } else {
        0
    }
}

pub fn int_unsigned(k: Known, s: u32) -> bool {
    s == k.u8_ || s == k.u16_ || s == k.u32_ || s == k.u64_ || s == k.usize_
}

// `IntegerKind::fits` for kind `s` (an integer name symbol).
pub fn fits(k: Known, s: u32, v: Lit) -> bool {
    let bits = int_bits(k, s);
    if bits == 0 {
        return false;
    }
    if int_unsigned(k, s) {
        if v.neg {
            return false;
        }
        if bits == 64 {
            return true;
        }
        return v.mag <= wrapping_sub(wrapping_shl_u64(1, bits), 1);
    }
    let half = wrapping_shl_u64(1, wrapping_sub(bits, 1));
    if v.neg {
        v.mag <= half
    } else {
        v.mag < half
    }
}

// `IntegerKind::default_for(n).fits(m)`: u64 above i64::MAX, else i64.
pub fn default_fits(k: Known, n: Lit, m: Lit) -> bool {
    if above_i64(n) {
        fits(k, k.u64_, m)
    } else {
        fits(k, k.i64_, m)
    }
}
