// Integer literal values as the type arena keeps them: a sign and a
// 128-bit magnitude in two words (`Types::wide_literal`; Rust holds an
// `i128`). `numeric::IntegerKind::{fits, default_for}` over that form,
// including the 128-bit kinds.

use @vesper/check-data::world::{Known};

const I64_MAX: u64 = 9223372036854775807;
// 2^63: the magnitude of i64::MIN, and the high word of i128::MIN's.
const SIGN_BIT: u64 = 9223372036854775808;

// A literal value: `neg` is the sign (never set for zero); the magnitude
// is `hi * 2^64 + mag`.
pub copy struct Lit {
    neg: bool,
    mag: u64,
    hi: u64,
}

// A literal of at most 64 bits in magnitude.
pub fn small_lit(neg: bool, mag: u64) -> Lit {
    Lit { neg: neg, mag: mag, hi: 0 }
}

// `Literal::WideInt`: a value above i128::MAX, typed `u128`.
pub fn above_i128(value: Lit) -> bool {
    !value.neg && value.hi >= SIGN_BIT
}

// -1, 0 or 1 as `a` is below, equal to or above `b`.
pub fn lit_cmp(a: Lit, b: Lit) -> i64 {
    if a.neg != b.neg {
        if a.neg {
            return -1;
        }
        return 1;
    }
    if a.mag == b.mag && a.hi == b.hi {
        return 0;
    }
    let below = a.hi < b.hi || (a.hi == b.hi && a.mag < b.mag);
    if below != a.neg { -1 } else { 1 }
}

pub fn lit_max(a: Lit, b: Lit) -> Lit {
    if lit_cmp(a, b) < 0 { b } else { a }
}

pub fn lit_min(a: Lit, b: Lit) -> Lit {
    if lit_cmp(a, b) > 0 { b } else { a }
}

// `n > i64::MAX as i128`.
pub fn above_i64(value: Lit) -> bool {
    !value.neg && (value.hi != 0 || value.mag > I64_MAX)
}

// Width in bits of integer kind `kind`, or 0 when it names no integer kind.
pub fn int_bits(known: Known, kind: u32) -> u32 {
    if kind == known.u8_ || kind == known.i8_ {
        8
    } else if kind == known.u16_ || kind == known.i16_ {
        16
    } else if kind == known.u32_ || kind == known.i32_ {
        32
    } else if kind == known.i128_ || kind == known.u128_ {
        128
    } else if known.is_integer(kind) {
        64
    } else {
        0
    }
}

pub fn int_unsigned(known: Known, kind: u32) -> bool {
    kind == known.u8_
        || kind == known.u16_
        || kind == known.u32_
        || kind == known.u64_
        || kind == known.usize_
        || kind == known.u128_
}

// `IntegerKind::fits` for `kind` (an integer name symbol).
pub fn fits(known: Known, kind: u32, value: Lit) -> bool {
    let bits = int_bits(known, kind);
    if bits == 0 {
        return false;
    }
    // u128 holds the i128 domain (`IntegerKind::max`): every literal
    // value that is not negative.
    if int_unsigned(known, kind) && bits == 128 {
        return !value.neg;
    }
    if bits == 128 {
        // i128: down to -2^127.
        return !value.neg || value.hi < SIGN_BIT || (value.hi == SIGN_BIT && value.mag == 0);
    }
    if value.hi != 0 {
        return false;
    }
    if int_unsigned(known, kind) {
        if value.neg {
            return false;
        }
        if bits >= 64 {
            return true;
        }
        return value.mag <= wrapping_sub(wrapping_shl_u64(1, bits), 1);
    }
    let half = wrapping_shl_u64(1, wrapping_sub(bits, 1));
    if value.neg {
        value.mag <= half
    } else {
        value.mag < half
    }
}

// `IntegerKind::default_for(n).fits(m)`.
pub fn default_fits(known: Known, n: Lit, m: Lit) -> bool {
    fits(known, default_of(known, n), m)
}

// `n < i64::MIN as i128`: a magnitude past 2^63, negated.
pub fn below_i64(value: Lit) -> bool {
    value.neg && (value.hi != 0 || value.mag > SIGN_BIT)
}

// `IntegerKind::default_for(n)`: i128 past u64::MAX or below i64::MIN,
// u64 above i64::MAX, else i64.
pub fn default_of(known: Known, n: Lit) -> u32 {
    if below_i64(n) || (!n.neg && n.hi != 0) {
        known.i128_
    } else if above_i64(n) {
        known.u64_
    } else {
        known.i64_
    }
}
