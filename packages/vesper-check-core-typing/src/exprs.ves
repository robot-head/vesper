// Expression typing: `Checker::expr_expected` of src/check.rs and what it
// calls for the expressions ported so far (literals, names, tuples,
// constructors, fields, blocks and `let`, `if`, `match`, unary and binary
// operators, calls of constructors and of effect-free functions), with
// `construct`, `apply`, `apply_args`, `bind_mode`, `constrain_literals`
// and `generic_bounds`.
//
// The checker reports a function it cannot check yet as skipped: one that
// reaches an expression kind not ported here, a type of another lane
// (strings, sequences, vectors, boxes, regions, `f32`, function types and
// effect rows), an effectful callee or an intrinsic. Modes, moves and
// loans (part 3), effects (lane 8) and literal typing (part 4) are not
// here; the clean corpus needs none of them for its expression types.

use @vesper/check-data::util::{add, inc, n32, u32_at, u8_at, w};
use @vesper/check-data::names::{Names};
use @vesper/check-data::types::{
    Types, Vars, debug_type, default_type, substitute, vars_new, TyKind, TyMode
};
use @vesper/check-data::world::{
    Adt, Bounds, Field, Generic, Known, Variant, World, bounds_new, constructor, field_step,
    mode_of, set_by_symbol
};
use @vesper/check-data::input::{Ctx, Reader};
use self::ints::{Lit, default_fits, default_of, fits, lit_max};
use self::relations::{
    compatible, infer, item, join_types, lit_of, mk_lit, refine_annotation, unresolved
};
use self::patterns::{Pats, arms_cover, irrefutable, pats_new};

const NONE32: u32 = 4294967295;
const NONE64: u64 = 18446744073709551615;
const P_INOUT: u8 = 1;
const P_SINK: u8 = 2;

// Expression kinds (the harness encoder's `E_*`).
const E_OTHER: u8 = 0;
const E_INT: u8 = 1;
const E_FLOAT: u8 = 2;
const E_BOOL: u8 = 3;
const E_STRING: u8 = 4;
const E_NAME: u8 = 5;
const E_TUPLE: u8 = 6;
const E_STRUCT: u8 = 7;
const E_BLOCK: u8 = 8;
const E_CALL: u8 = 9;
const E_FIELD: u8 = 10;
const E_UNARY: u8 = 11;
const E_BINARY: u8 = 12;
const E_IF: u8 = 13;
const E_MATCH: u8 = 14;

// Pattern kinds (patterns.ves).
const P_WILD: u8 = 0;
const P_BIND: u8 = 1;
const P_TRUE: u8 = 2;
const P_FALSE: u8 = 3;
const P_LIT: u8 = 4;
const P_TUPLE: u8 = 5;
const P_CTOR: u8 = 6;

// Binary operator codes.
const B_ADD: u32 = 1;
const B_SUB: u32 = 2;
const B_MUL: u32 = 3;
const B_DIV: u32 = 4;
const B_REM: u32 = 5;
const B_EQ: u32 = 6;
const B_NE: u32 = 7;
const B_LT: u32 = 8;
const B_LE: u32 = 9;
const B_GT: u32 = 10;
const B_GE: u32 = 11;
const B_AND: u32 = 12;
const B_OR: u32 = 13;

// One expression. Lists index the checker's tables (`kids`, `field_names`,
// `stmts`, `targs`, `args`, `arms`), by kind:
// - int literal: neg, mag; bool: x = value; name: x = full, y = qualifier
//   (symbol + 1, 0 none, NONE32 refused), z = short name;
// - tuple: kids[a..a+n]; struct: x/y/z name, kids and field_names [a..a+n];
// - block: stmts[a..a+n], x = tail or NONE32;
// - call: x = callee, y = 1 for an intrinsic, targs[b..b+m], args[a..a+n];
// - field: x = base, y = field name; unary: x = operand, y = op;
// - binary: x, z = operands, y = op; if: x = condition, y = then, z = else
//   or NONE32; match: x = scrutinee, arms[a..a+n].
pub copy struct Ex {
    kind: u8,
    start: u64,
    end: u64,
    a: u32,
    n: u32,
    b: u32,
    m: u32,
    x: u32,
    y: u32,
    z: u32,
    neg: bool,
    mag: u64,
}

pub copy struct Stmt {
    is_let: bool,
    pat: u32,
    ty: u32,
    value: u32,
}

pub copy struct Arg {
    pass: u8,
    explicit: bool,
    expr: u32,
}

pub copy struct Arm {
    pat: u32,
    body: u32,
}

// Pattern extras beside the `Pats` row of the same id: spans, a binding's
// name, a constructor's full name and qualifier, a literal's type.
pub copy struct PatX {
    start: u64,
    end: u64,
    // Binding or constructor name, or a typed integer literal's scalar name.
    name: u32,
    // constructor qualifier (symbol + 1, 0 none, NONE32 refused)
    qualifier: u32,
    // Literal: 0 contextual int, 1 float, 2 bool, 3 string, 4 typed int.
    lit_kind: u8,
    neg: bool,
    mag: u64,
}

pub copy struct FnSig {
    name: u32,
    generic_start: u32,
    generic_count: u32,
    param_start: u32,
    param_count: u32,
    result: u32,
    effectful: bool,
    // `world.function_results`, or the declared result
    inferred: u32,
}

pub copy struct ParamSig {
    pass: u8,
    name: u32,
    ty: u32,
    projections: u32,
    start: u64,
    end: u64,
}

pub copy struct Bind {
    name: u32,
    ty: u32,
    pass: u8,
}

pub struct Ck {
    ctx: Ctx,
    pats: Pats,
    pat_extras: ChunkSeq[PatX],
    exs: ChunkSeq[Ex],
    kids: ChunkSeq[u32],
    field_names: ChunkSeq[u32],
    stmts: ChunkSeq[Stmt],
    targs: ChunkSeq[u32],
    args: ChunkSeq[Arg],
    arms: ChunkSeq[Arm],
    fns: ChunkSeq[FnSig],
    generics: ChunkSeq[Generic],
    params: ChunkSeq[ParamSig],
    // symbol -> function index + 1
    fn_by_name: ChunkSeq[u32],
    // The function being checked.
    env: ChunkSeq[Bind],
    bounds: Bounds,
    // expression id -> recorded type, or NONE32
    ex_types: ChunkSeq[u32],
    skip: bool,
    out: ChunkSeq[u8],
    atomic_sym: u32,
}

fn put(inout out: ChunkSeq[u8], in text: Str) {
    out.extend(in text.as_bytes());
}

fn put_u64(inout out: ChunkSeq[u8], value: u64) {
    if value >= 10 {
        put_u64(inout out, value / 10);
    }
    out.push(wrapping_u8(wrapping_add(value % 10, 48)));
}

fn sym(in ctx: Ctx, word: u64) -> u32 {
    u32_at(in ctx.nmap, word)
}

fn tyw(in ctx: Ctx, word: u64) -> u32 {
    u32_at(in ctx.tmap, word)
}

fn qual_word(in ctx: Ctx, word: u64) -> u32 {
    if word == NONE64 {
        return NONE32;
    }
    if word == 0 {
        return 0;
    }
    inc32w(sym(in ctx, wrapping_sub(word, 1)))
}

fn inc32w(value: u32) -> u32 {
    wrapping_add(value, 1)
}

pub fn ck_new(sink ctx: Ctx) -> Ck {
    let mut ck = Ck {
        ctx: ctx,
        pats: pats_dummy(),
        pat_extras: ChunkSeq::new[PatX](),
        exs: ChunkSeq::new[Ex](),
        kids: ChunkSeq::new[u32](),
        field_names: ChunkSeq::new[u32](),
        stmts: ChunkSeq::new[Stmt](),
        targs: ChunkSeq::new[u32](),
        args: ChunkSeq::new[Arg](),
        arms: ChunkSeq::new[Arm](),
        fns: ChunkSeq::new[FnSig](),
        generics: ChunkSeq::new[Generic](),
        params: ChunkSeq::new[ParamSig](),
        fn_by_name: ChunkSeq::new[u32](),
        env: ChunkSeq::new[Bind](),
        bounds: bounds_new(),
        ex_types: ChunkSeq::new[u32](),
        skip: false,
        out: ChunkSeq::new[u8](),
        atomic_sym: 0,
    };
    let pats = pats_new(inout ck.ctx.names);
    ck.pats = pats;
    let atomic = ck.ctx.names.intern(in "Atomic".as_bytes());
    ck.atomic_sym = atomic;
    // Pattern 0, the wildcard, has no extras.
    ck.pat_extras
        .push(PatX { start: 0, end: 0, name: 0, qualifier: 0, lit_kind: 0, neg: false, mag: 0 });
    ck
}

fn pats_dummy() -> Pats {
    let mut names = @vesper/check-data::names::names_new();
    pats_new(inout names)
}

// ----- decoding --------------------------------------------------------------

impl Ck {
    pub fn ex(in self, i: u32) -> Ex {
        match self.exs.try_get(w(i)) {
            Option::Some(x) => x,
            Option::None => Ex {
                kind: E_OTHER,
                start: 0,
                end: 0,
                a: 0,
                n: 0,
                b: 0,
                m: 0,
                x: NONE32,
                y: 0,
                z: NONE32,
                neg: false,
                mag: 0
            },
        }
    }

    fn patx(in self, pat_id: u32) -> PatX {
        match self.pat_extras.try_get(w(pat_id)) {
            Option::Some(x) => x,
            Option::None => PatX {
                start: 0,
                end: 0,
                name: 0,
                qualifier: 0,
                lit_kind: 0,
                neg: false,
                mag: 0
            },
        }
    }

    fn stmt(in self, i: u64) -> Stmt {
        match self.stmts.try_get(i) {
            Option::Some(x) => x,
            Option::None => Stmt { is_let: false, pat: 0, ty: 0, value: NONE32 },
        }
    }

    fn arg(in self, i: u64) -> Arg {
        match self.args.try_get(i) {
            Option::Some(x) => x,
            Option::None => Arg { pass: 0, explicit: false, expr: NONE32 },
        }
    }

    fn arm(in self, i: u64) -> Arm {
        match self.arms.try_get(i) {
            Option::Some(x) => x,
            Option::None => Arm { pat: 0, body: NONE32 },
        }
    }

    fn fsig(in self, i: u32) -> FnSig {
        match self.fns.try_get(w(i)) {
            Option::Some(x) => x,
            Option::None => FnSig {
                name: 0,
                generic_start: 0,
                generic_count: 0,
                param_start: 0,
                param_count: 0,
                result: 0,
                effectful: true,
                inferred: 0
            },
        }
    }

    fn param(in self, i: u64) -> ParamSig {
        match self.params.try_get(i) {
            Option::Some(x) => x,
            Option::None => ParamSig { pass: 0, name: 0, ty: 0, projections: 0, start: 0, end: 0 },
        }
    }

    fn gen(in self, i: u64) -> Generic {
        match self.generics.try_get(i) {
            Option::Some(x) => x,
            Option::None => Generic { name: 0, bound: 0, row: false },
        }
    }

    fn kid(in self, i: u64) -> u32 {
        u32_at(in self.kids, i)
    }
}

fn push_ex(inout ck: Ck, ex: Ex) -> u32 {
    let id = n32(ck.exs.len());
    ck.exs.push(ex);
    ck.ex_types.push(NONE32);
    id
}

fn blank(kind: u8, start: u64, end: u64) -> Ex {
    Ex {
        kind: kind,
        start: start,
        end: end,
        a: 0,
        n: 0,
        b: 0,
        m: 0,
        x: NONE32,
        y: 0,
        z: NONE32,
        neg: false,
        mag: 0
    }
}

// One pattern (the harness's `encode_pattern`), into `pats` and `pat_extras`.
fn read_xpat(inout reader: Reader, in bytes: Slice[u8], inout ck: Ck) -> u32 {
    let kind = wrapping_u8(reader.word(in bytes));
    let start = reader.word(in bytes);
    let end = reader.word(in bytes);
    let mut extra = PatX {
        start: start,
        end: end,
        name: 0,
        qualifier: 0,
        lit_kind: 0,
        neg: false,
        mag: 0
    };
    let mut short_name: u32 = 0;
    let mut kids: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut kid_names: ChunkSeq[u32] = ChunkSeq::new[u32]();
    if kind == P_BIND {
        extra.name = sym(in ck.ctx, reader.word(in bytes));
    } else if kind == P_LIT {
        extra.lit_kind = wrapping_u8(reader.word(in bytes));
        if extra.lit_kind == 0 {
            extra.neg = reader.word(in bytes) != 0;
            extra.mag = reader.word(in bytes);
        } else if extra.lit_kind == 4 {
            extra.name = sym(in ck.ctx, reader.word(in bytes));
        }
    } else if kind == P_TUPLE {
        let kid_count = reader.word(in bytes);
        for i in 0..kid_count {
            let kid = read_xpat(inout reader, in bytes, inout ck);
            kids.push(kid);
        }
    } else if kind == P_CTOR {
        extra.name = sym(in ck.ctx, reader.word(in bytes));
        extra.qualifier = qual_word(in ck.ctx, reader.word(in bytes));
        short_name = sym(in ck.ctx, reader.word(in bytes));
        let kid_count = reader.word(in bytes);
        for i in 0..kid_count {
            kid_names.push(sym(in ck.ctx, reader.word(in bytes)));
            let kid = read_xpat(inout reader, in bytes, inout ck);
            kids.push(kid);
        }
    }
    let id = ck.pats.add(kind, short_name, in kids, in kid_names);
    ck.pat_extras.push(extra);
    id
}

fn read_name(inout reader: Reader, in bytes: Slice[u8], in ctx: Ctx, inout ex: Ex) {
    ex.x = sym(in ctx, reader.word(in bytes));
    ex.y = qual_word(in ctx, reader.word(in bytes));
    ex.z = sym(in ctx, reader.word(in bytes));
}

// One expression (the harness's `encode_expr`).
fn read_expr(inout reader: Reader, in bytes: Slice[u8], inout ck: Ck) -> u32 {
    let kind = wrapping_u8(reader.word(in bytes));
    let start = reader.word(in bytes);
    let end = reader.word(in bytes);
    let mut ex = blank(kind, start, end);
    if kind == E_INT {
        ex.neg = reader.word(in bytes) != 0;
        ex.mag = reader.word(in bytes);
    } else if kind == E_BOOL {
        ex.x = n32(reader.word(in bytes));
    } else if kind == E_NAME {
        read_name(inout reader, in bytes, in ck.ctx, inout ex);
    } else if kind == E_TUPLE {
        let count = reader.word(in bytes);
        let mut kid_ids: ChunkSeq[u32] = ChunkSeq::new[u32]();
        for i in 0..count {
            let kid = read_expr(inout reader, in bytes, inout ck);
            kid_ids.push(kid);
        }
        ex.a = n32(ck.kids.len());
        ex.n = n32(count);
        for i in 0..count {
            ck.kids.push(u32_at(in kid_ids, i));
            ck.field_names.push(0);
        }
    } else if kind == E_STRUCT {
        read_name(inout reader, in bytes, in ck.ctx, inout ex);
        let count = reader.word(in bytes);
        let mut kid_ids: ChunkSeq[u32] = ChunkSeq::new[u32]();
        let mut field_syms: ChunkSeq[u32] = ChunkSeq::new[u32]();
        for i in 0..count {
            field_syms.push(sym(in ck.ctx, reader.word(in bytes)));
            let kid = read_expr(inout reader, in bytes, inout ck);
            kid_ids.push(kid);
        }
        ex.a = n32(ck.kids.len());
        ex.n = n32(count);
        for i in 0..count {
            ck.kids.push(u32_at(in kid_ids, i));
            ck.field_names.push(u32_at(in field_syms, i));
        }
    } else if kind == E_BLOCK {
        let count = reader.word(in bytes);
        let mut block_stmts: ChunkSeq[Stmt] = ChunkSeq::new[Stmt]();
        for i in 0..count {
            let tag = reader.word(in bytes);
            if tag == 0 {
                let pat = read_xpat(inout reader, in bytes, inout ck);
                let ty = tyw(in ck.ctx, reader.word(in bytes));
                let mutable = reader.word(in bytes);
                let value = read_expr(inout reader, in bytes, inout ck);
                block_stmts.push(Stmt { is_let: true, pat: pat, ty: ty, value: value });
            } else {
                let value = read_expr(inout reader, in bytes, inout ck);
                block_stmts.push(Stmt { is_let: false, pat: 0, ty: 0, value: value });
            }
        }
        ex.a = n32(ck.stmts.len());
        ex.n = n32(count);
        for i in 0..count {
            match block_stmts.try_get(i) {
                Option::Some(stmt) => ck.stmts.push(stmt),
                Option::None => {},
            }
        }
        if reader.word(in bytes) != 0 {
            ex.x = read_expr(inout reader, in bytes, inout ck);
        }
    } else if kind == E_CALL {
        ex.y = n32(reader.word(in bytes));
        ex.x = read_expr(inout reader, in bytes, inout ck);
        let targ_count = reader.word(in bytes);
        ex.b = n32(ck.targs.len());
        ex.m = n32(targ_count);
        for i in 0..targ_count {
            ck.targs.push(tyw(in ck.ctx, reader.word(in bytes)));
        }
        let count = reader.word(in bytes);
        let mut call_args: ChunkSeq[Arg] = ChunkSeq::new[Arg]();
        for i in 0..count {
            let pass = wrapping_u8(reader.word(in bytes));
            let explicit = reader.word(in bytes) != 0;
            let arg_ex = read_expr(inout reader, in bytes, inout ck);
            call_args.push(Arg { pass: pass, explicit: explicit, expr: arg_ex });
        }
        ex.a = n32(ck.args.len());
        ex.n = n32(count);
        for i in 0..count {
            match call_args.try_get(i) {
                Option::Some(arg) => ck.args.push(arg),
                Option::None => {},
            }
        }
    } else if kind == E_FIELD {
        ex.y = sym(in ck.ctx, reader.word(in bytes));
        ex.x = read_expr(inout reader, in bytes, inout ck);
    } else if kind == E_UNARY {
        ex.y = n32(reader.word(in bytes));
        ex.x = read_expr(inout reader, in bytes, inout ck);
    } else if kind == E_BINARY {
        ex.y = n32(reader.word(in bytes));
        ex.x = read_expr(inout reader, in bytes, inout ck);
        ex.z = read_expr(inout reader, in bytes, inout ck);
    } else if kind == E_IF {
        ex.x = read_expr(inout reader, in bytes, inout ck);
        ex.y = read_expr(inout reader, in bytes, inout ck);
        if reader.word(in bytes) != 0 {
            ex.z = read_expr(inout reader, in bytes, inout ck);
        }
    } else if kind == E_MATCH {
        ex.x = read_expr(inout reader, in bytes, inout ck);
        let count = reader.word(in bytes);
        let mut match_arms: ChunkSeq[Arm] = ChunkSeq::new[Arm]();
        for i in 0..count {
            let pat = read_xpat(inout reader, in bytes, inout ck);
            let body = read_expr(inout reader, in bytes, inout ck);
            match_arms.push(Arm { pat: pat, body: body });
        }
        ex.a = n32(ck.arms.len());
        ex.n = n32(count);
        for i in 0..count {
            match match_arms.try_get(i) {
                Option::Some(arm) => ck.arms.push(arm),
                Option::None => {},
            }
        }
    }
    push_ex(inout ck, ex)
}

// The function table of the task input.
pub fn read_fns(inout reader: Reader, in bytes: Slice[u8], inout ck: Ck) {
    let fn_count = reader.word(in bytes);
    for i in 0..fn_count {
        let name = sym(in ck.ctx, reader.word(in bytes));
        let generic_start = n32(ck.generics.len());
        let generic_count = reader.word(in bytes);
        for j in 0..generic_count {
            let generic = Generic {
                name: sym(in ck.ctx, reader.word(in bytes)),
                bound: wrapping_u8(reader.word(in bytes)),
                row: reader.word(in bytes) != 0
            };
            ck.generics.push(generic);
        }
        let param_start = n32(ck.params.len());
        let param_count = reader.word(in bytes);
        for j in 0..param_count {
            let param = ParamSig {
                pass: wrapping_u8(reader.word(in bytes)),
                name: sym(in ck.ctx, reader.word(in bytes)),
                ty: tyw(in ck.ctx, reader.word(in bytes)),
                projections: n32(reader.word(in bytes)),
                start: reader.word(in bytes),
                end: reader.word(in bytes)
            };
            ck.params.push(param);
        }
        let result = tyw(in ck.ctx, reader.word(in bytes));
        let effectful = reader.word(in bytes) != 0;
        let inferred = tyw(in ck.ctx, reader.word(in bytes));
        let id = n32(ck.fns.len());
        ck.fns.push(FnSig {
            name: name,
            generic_start: generic_start,
            generic_count: n32(generic_count),
            param_start: param_start,
            param_count: n32(param_count),
            result: result,
            effectful: effectful,
            inferred: inferred
        });
        set_by_symbol(inout ck.fn_by_name, name, inc32w(id));
    }
}

fn fn_index(in ck: Ck, name: u32) -> u32 {
    let entry = u32_at(in ck.fn_by_name, w(name));
    if entry == 0 {
        NONE32
    } else {
        wrapping_sub(entry, 1)
    }
}

// ----- checker state ---------------------------------------------------------

fn error(inout ck: Ck, in code: Str, start: u64, end: u64) {
    put(inout ck.out, "D ");
    put(inout ck.out, code);
    ck.out.push(32);
    put_u64(inout ck.out, start);
    ck.out.push(32);
    put_u64(inout ck.out, end);
    ck.out.push(10);
}

// Whether `ty` belongs to another lane's rules (strings, sequences,
// vectors, boxes, regions, atomics, `f32`, function types, effect rows).
fn foreign(in ck: Ck, ty: u32) -> bool {
    let node = ck.ctx.types.node(ty);
    if node.kind == TyKind::Fn || node.kind == TyKind::Row {
        return true;
    }
    if node.kind == TyKind::Named {
        let known = ck.ctx.world.k;
        let name = node.name;
        if name == known.string
            || name == known.str_
            || name == known.chunk_seq
            || name == known.slice
            || name == known.tiled_seq
            || name == known.vec
            || name == known.mask
            || name == known.box_
            || name == known.region_box
            || name == known.f32_
            || name == known.dyn_
            || name == ck.atomic_sym
        {
            return true;
        }
    }
    if node.kind == TyKind::Named || node.kind == TyKind::Tuple {
        for i in 0..w(node.n) {
            if foreign(in ck, item(in ck.ctx.types, add(w(node.a), i))) {
                return true;
            }
        }
    }
    false
}

fn note(inout ck: Ck, ty: u32) {
    if foreign(in ck, ty) {
        ck.skip = true;
    }
}

fn record(inout ck: Ck, e: u32, ty: u32) {
    note(inout ck, ty);
    let ok = ck.ex_types.try_set(w(e), ty);
}

fn mode(inout ck: Ck, ty: u32) -> u8 {
    mode_of(inout ck.ctx.types, in ck.ctx.names, in ck.ctx.world, ty, in ck.bounds)
}

fn lookup(in ck: Ck, name: u32) -> u32 {
    let mut i = ck.env.len();
    loop {
        if i == 0 {
            break;
        }
        i = wrapping_sub(i, 1);
        match ck.env.try_get(i) {
            Option::Some(bind) => {
                if bind.name == name {
                    return n32(i);
                }
            },
            Option::None => {},
        }
    }
    NONE32
}

fn binding(in ck: Ck, i: u32) -> Bind {
    match ck.env.try_get(w(i)) {
        Option::Some(x) => x,
        Option::None => Bind { name: 0, ty: 0, pass: 0 },
    }
}

fn bind_name(inout ck: Ck, name: u32, ty: u32, pass: u8) {
    note(inout ck, ty);
    ck.env.push(Bind { name: name, ty: ty, pass: pass });
}

fn named(inout ck: Ck, name: u32) -> u32 {
    ck.ctx.types.named0(name)
}

fn is_named(in ck: Ck, ty: u32, name: u32) -> bool {
    let node = ck.ctx.types.node(ty);
    node.kind == TyKind::Named && node.name == name
}

fn expect_type(inout ck: Ck, expected: u32, actual: u32, start: u64, end: u64) {
    if !compatible(in ck.ctx.types, ck.ctx.world.k, expected, actual) {
        error(inout ck, "E0200", start, end);
    }
}

fn join(inout ck: Ck, a: u32, b: u32, start: u64, end: u64) -> u32 {
    let mut errors: u64 = 0;
    let known = ck.ctx.world.k;
    let joined = join_types(inout ck.ctx.types, known, a, b, inout errors);
    for i in 0..errors {
        error(inout ck, "E0200", start, end);
    }
    joined
}

// `check::integer(t)`.
fn integer(in ck: Ck, ty: u32) -> bool {
    let node = ck.ctx.types.node(ty);
    if node.kind == TyKind::Lit || node.kind == TyKind::Infer {
        return true;
    }
    node.kind == TyKind::Named && ck.ctx.world.k.is_integer(node.name)
}

// `check::numeric(t)`.
fn numeric(in ck: Ck, ty: u32) -> bool {
    if integer(in ck, ty) {
        return true;
    }
    let known = ck.ctx.world.k;
    is_named(in ck, ty, known.f64_) || is_named(in ck, ty, known.f32_)
}

// `IntegerKind::from_type(t)`: the kind symbol, or NONE32.
fn int_kind(in ck: Ck, ty: u32) -> u32 {
    let node = ck.ctx.types.node(ty);
    let known = ck.ctx.world.k;
    if node.kind == TyKind::Lit {
        return default_of(known, lit_of(node));
    }
    if node.kind == TyKind::Named && known.is_integer(node.name) {
        return node.name;
    }
    NONE32
}

fn default_kind(in ck: Ck, value: Lit) -> u32 {
    default_of(ck.ctx.world.k, value)
}

fn bounds_of(in ck: Ck, sig: FnSig) -> Bounds {
    let mut bounds = bounds_new();
    for i in 0..w(sig.generic_count) {
        let generic = ck.gen(add(w(sig.generic_start), i));
        if !generic.row {
            bounds.set(generic.name, generic.bound);
        }
    }
    bounds
}

// ----- expressions -----------------------------------------------------------

fn expr(inout ck: Ck, e: u32) -> u32 {
    let hole = ck.ctx.types.infer;
    expr_expected(inout ck, e, hole)
}

// `Checker::expr_expected`.
pub fn expr_expected(inout ck: Ck, e: u32, expected: u32) -> u32 {
    let hole = ck.ctx.types.infer;
    if ck.skip {
        return hole;
    }
    let ex = ck.ex(e);
    let ty = if ex.kind == E_INT {
        int_literal(inout ck, ex, expected)
    } else if ex.kind == E_FLOAT {
        let known = ck.ctx.world.k;
        if is_named(in ck, expected, known.f32_) {
            ck.skip = true;
        }
        named(inout ck, known.f64_)
    } else if ex.kind == E_BOOL {
        let known = ck.ctx.world.k;
        named(inout ck, known.bool_)
    } else if ex.kind == E_NAME {
        name_expr(inout ck, ex, expected)
    } else if ex.kind == E_TUPLE {
        tuple_expr(inout ck, ex, expected)
    } else if ex.kind == E_STRUCT {
        let mut fields: ChunkSeq[u32] = ChunkSeq::new[u32]();
        let mut values: ChunkSeq[u32] = ChunkSeq::new[u32]();
        for i in 0..w(ex.n) {
            fields.push(u32_at(in ck.field_names, add(w(ex.a), i)));
            values.push(ck.kid(add(w(ex.a), i)));
        }
        construct(inout ck, ex.y, ex.z, in fields, in values, expected, ex.start, ex.end)
    } else if ex.kind == E_FIELD {
        field_expr(inout ck, e, ex)
    } else if ex.kind == E_BLOCK {
        block_expr(inout ck, ex, expected)
    } else if ex.kind == E_CALL {
        call_expr(inout ck, ex, expected)
    } else if ex.kind == E_UNARY {
        unary_expr(inout ck, ex, expected)
    } else if ex.kind == E_BINARY {
        binary_expr(inout ck, ex, expected)
    } else if ex.kind == E_IF {
        if_expr(inout ck, ex, expected)
    } else if ex.kind == E_MATCH {
        match_expr(inout ck, ex, expected)
    } else {
        // E_OTHER and string literals: not ported yet.
        ck.skip = true;
        hole
    };
    if ck.skip {
        return hole;
    }
    // `instantiate_latent_effects` changes only function types, which
    // skip the function.
    if expected != hole {
        expect_type(inout ck, expected, ty, ex.start, ex.end);
    }
    record(inout ck, e, ty);
    ty
}

fn int_literal(inout ck: Ck, ex: Ex, expected: u32) -> u32 {
    let value = Lit { neg: ex.neg, mag: ex.mag };
    let known = ck.ctx.world.k;
    let kind = int_kind(in ck, expected);
    if kind != NONE32 {
        if !fits(known, kind, value) {
            error(inout ck, "E0209", ex.start, ex.end);
        }
        return named(inout ck, kind);
    }
    if !default_fits(known, value, value) {
        error(inout ck, "E0209", ex.start, ex.end);
    }
    mk_lit(inout ck.ctx.types, value)
}

fn ctor_of(in ck: Ck, qualifier: u32, short_name: u32) -> u64 {
    if qualifier == NONE32 {
        return NONE64;
    }
    let qualifier_sym = if qualifier == 0 {
        NONE32
    } else {
        wrapping_sub(qualifier, 1)
    };
    constructor(in ck.ctx.world, qualifier_sym, short_name)
}

fn infer_args(inout ck: Ck, adt: Adt) -> ChunkSeq[u32] {
    let mut args: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..w(adt.gn) {
        args.push(ck.ctx.types.infer);
    }
    args
}

fn name_expr(inout ck: Ck, ex: Ex, expected: u32) -> u32 {
    let hole = ck.ctx.types.infer;
    let bind_index = lookup(in ck, ex.x);
    if bind_index != NONE32 {
        // `place` on the whole binding (modes and moves: part 3).
        return binding(in ck, bind_index).ty;
    }
    if fn_index(in ck, ex.x) != NONE32 {
        // A function value has a function type.
        ck.skip = true;
        return hole;
    }
    let ctor = ctor_of(in ck, ex.y, ex.z);
    if ctor != NONE64 {
        let adt = ck.ctx.world.adt(n32(ctor >> 32));
        let variant = ck.ctx.world.variant(ctor & 4294967295);
        if variant.fc == 0 {
            if is_named(in ck, expected, adt.name) {
                return expected;
            }
            let args = infer_args(inout ck, adt);
            return ck.ctx.types.named(adt.name, in args);
        }
        error(inout ck, "E0203", ex.start, ex.end);
        return hole;
    }
    // Qualified paths outside a package and unknown names: the package
    // loader's diagnostics are lane 6's.
    ck.skip = true;
    hole
}

fn float_name(in ck: Ck, ty: u32) -> bool {
    let known = ck.ctx.world.k;
    is_named(in ck, ty, known.f64_) || is_named(in ck, ty, known.f32_)
}

fn tuple_expr(inout ck: Ck, ex: Ex, expected: u32) -> u32 {
    let expected_node = ck.ctx.types.node(expected);
    let mut elem_types: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..w(ex.n) {
        let mut goal = ck.ctx.types.infer;
        if expected_node.kind == TyKind::Tuple && expected_node.n == ex.n {
            let expected_elem = item(in ck.ctx.types, add(w(expected_node.a), i));
            if float_name(in ck, expected_elem)
                || ck.ctx.types.kind(expected_elem) == TyKind::Tuple
            {
                goal = expected_elem;
            }
        }
        let elem_ty = expr_expected(inout ck, ck.kid(add(w(ex.a), i)), goal);
        elem_types.push(elem_ty);
    }
    ck.ctx.types.tuple(in elem_types)
}

fn generic_names(in ck: Ck, adt: Adt) -> ChunkSeq[u32] {
    let mut generics: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..w(adt.gn) {
        generics.push(ck.ctx.world.generic(add(w(adt.ga), i)).name);
    }
    generics
}

// `vars` with every name of `generics` it lacks bound to `Infer`.
fn with_infer(in ck: Ck, in vars: Vars, in generics: ChunkSeq[u32]) -> Vars {
    let mut filled = vars_new();
    for i in 0..vars.keys.len() {
        filled.set(u32_at(in vars.keys, i), u32_at(in vars.vals, i));
    }
    for i in 0..generics.len() {
        let name = u32_at(in generics, i);
        if filled.get(name) == NONE32 {
            filled.set(name, ck.ctx.types.infer);
        }
    }
    filled
}

// `Checker::construct`.
fn construct(
    inout ck: Ck,
    qualifier: u32,
    short_name: u32,
    in fields: ChunkSeq[u32],
    in values: ChunkSeq[u32],
    expected: u32,
    start: u64,
    end: u64
) -> u32 {
    let hole = ck.ctx.types.infer;
    let ctor = ctor_of(in ck, qualifier, short_name);
    if ctor == NONE64 {
        error(inout ck, "E0201", start, end);
        return hole;
    }
    let adt = ck.ctx.world.adt(n32(ctor >> 32));
    let variant = ck.ctx.world.variant(ctor & 4294967295);
    let generics = generic_names(in ck, adt);
    let mut vars = vars_new();
    if is_named(in ck, expected, adt.name) {
        let expected_node = ck.ctx.types.node(expected);
        for i in 0..w(adt.gn) {
            if i >= w(expected_node.n) {
                break;
            }
            vars.set(u32_at(in generics, i), item(in ck.ctx.types, add(w(expected_node.a), i)));
        }
    }
    let mut seen: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..fields.len() {
        let field_name = u32_at(in fields, i);
        let e = u32_at(in values, i);
        let context = with_infer(in ck, in vars, in generics);
        let field_index = ck.ctx.world.find_field(variant, field_name);
        let mut target = hole;
        if field_index != NONE32 {
            let field = ck.ctx.world.field(w(field_index));
            target = substitute(inout ck.ctx.types, field.ty, in context);
        }
        let value_ty = expr_expected(inout ck, e, target);
        if ck.skip {
            return hole;
        }
        let ex = ck.ex(e);
        let mut dup = false;
        for j in 0..seen.len() {
            if u32_at(in seen, j) == field_name {
                dup = true;
            }
        }
        if dup {
            error(inout ck, "E0204", ex.start, ex.end);
        } else {
            seen.push(field_name);
        }
        if field_index != NONE32 {
            let field = ck.ctx.world.field(w(field_index));
            let known = ck.ctx.world.k;
            infer(inout ck.ctx.types, known, field.ty, value_ty, in generics, inout vars);
            let want = substitute(inout ck.ctx.types, field.ty, in vars);
            expect_type(inout ck, want, value_ty, ex.start, ex.end);
        } else {
            error(inout ck, "E0202", ex.start, ex.end);
        }
    }
    if seen.len() != w(variant.fc) {
        error(inout ck, "E0204", start, end);
    }
    adt_bounds(inout ck, adt, in vars, start, end);
    let mut args: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..generics.len() {
        let arg_ty = vars.get(u32_at(in generics, i));
        if arg_ty == NONE32 {
            args.push(hole);
        } else {
            args.push(arg_ty);
        }
    }
    ck.ctx.types.named(adt.name, in args)
}

// `Checker::generic_bounds` over an ADT's generics.
fn adt_bounds(inout ck: Ck, adt: Adt, in vars: Vars, start: u64, end: u64) {
    for i in 0..w(adt.gn) {
        let generic = ck.ctx.world.generic(add(w(adt.ga), i));
        check_bound(inout ck, generic, in vars, start, end);
    }
}

fn check_bound(inout ck: Ck, generic: Generic, in vars: Vars, start: u64, end: u64) {
    let arg_ty = vars.get(generic.name);
    if arg_ty == NONE32 {
        return;
    }
    let hole = ck.ctx.types.infer;
    if arg_ty != hole && generic.row != (ck.ctx.types.kind(arg_ty) == TyKind::Row) {
        error(inout ck, "E0205", start, end);
    }
    if !generic.row && mode(inout ck, arg_ty) > generic.bound {
        error(inout ck, "E0205", start, end);
    }
}

// A place expression (`Place::from_expr`): its root binding name and field
// path, or NONE32 as the root.
fn place_of(in ck: Ck, e: u32, inout path: ChunkSeq[u32]) -> u32 {
    let ex = ck.ex(e);
    if ex.kind == E_NAME {
        return ex.x;
    }
    if ex.kind == E_FIELD {
        let root = place_of(in ck, ex.x, inout path);
        if root != NONE32 {
            path.push(ex.y);
        }
        return root;
    }
    NONE32
}

// `World::field(ty, path)`, or NONE32.
fn field_path(inout ck: Ck, ty: u32, in path: ChunkSeq[u32]) -> u32 {
    let mut field_ty = ty;
    for i in 0..path.len() {
        field_ty = field_step(
            inout ck.ctx.types,
            inout ck.ctx.names,
            in ck.ctx.world,
            field_ty,
            u32_at(in path, i),
            false
        );
        if field_ty == NONE32 {
            return NONE32;
        }
    }
    field_ty
}

fn field_expr(inout ck: Ck, e: u32, ex: Ex) -> u32 {
    let hole = ck.ctx.types.infer;
    let mut path: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let root = place_of(in ck, e, inout path);
    if root != NONE32 {
        let bind_index = lookup(in ck, root);
        if bind_index == NONE32 {
            // `peek_type` of an unknown root, then `place`'s E0201: a
            // qualified name (`Enum::Variant.x`) or a typo; not ported.
            ck.skip = true;
            return hole;
        }
        // `peek_type(base)`: a TiledSeq base is lane 9's.
        let root_ty = binding(in ck, bind_index).ty;
        note(inout ck, root_ty);
        let path_ty = field_path(inout ck, root_ty, in path);
        if path_ty == NONE32 {
            error(inout ck, "E0202", ex.start, ex.end);
            return hole;
        }
        return path_ty;
    }
    let base_ty = expr(inout ck, ex.x);
    if ck.skip {
        return hole;
    }
    if mode(inout ck, base_ty) == TyMode::Linear {
        error(inout ck, "E0306", ex.start, ex.end);
    }
    let mut step: ChunkSeq[u32] = ChunkSeq::new[u32]();
    step.push(ex.y);
    let field_ty = field_path(inout ck, base_ty, in step);
    if field_ty == NONE32 {
        error(inout ck, "E0202", ex.start, ex.end);
        return hole;
    }
    field_ty
}

fn block_expr(inout ck: Ck, ex: Ex, expected: u32) -> u32 {
    let mark = ck.env.len();
    let hole = ck.ctx.types.infer;
    let known = ck.ctx.world.k;
    let mut result = ck.ctx.types.unit;
    for i in 0..w(ex.n) {
        if ck.skip {
            return hole;
        }
        if ck.ctx.types.name(result) == known.never {
            break;
        }
        let stmt = ck.stmt(add(w(ex.a), i));
        if stmt.is_let {
            note(inout ck, stmt.ty);
            let actual = expr_expected(inout ck, stmt.value, stmt.ty);
            if ck.skip {
                return hole;
            }
            let value_ex = ck.ex(stmt.value);
            expect_type(inout ck, stmt.ty, actual, value_ex.start, value_ex.end);
            let let_ty = if stmt.ty == hole {
                default_type(inout ck.ctx.types, actual)
            } else {
                refine_annotation(inout ck.ctx.types, stmt.ty, actual)
            };
            if unresolved(in ck.ctx.types, let_ty) {
                error(inout ck, "E0208", value_ex.start, value_ex.end);
            }
            let pat_extra = ck.patx(stmt.pat);
            if !irrefutable(
                inout ck.ctx.types,
                inout ck.ctx.names,
                in ck.ctx.world,
                inout ck.pats,
                stmt.pat,
                let_ty
            ) {
                error(inout ck, "E0210", pat_extra.start, pat_extra.end);
            }
            bind_mode(inout ck, stmt.pat, let_ty, P_SINK);
        } else {
            let stmt_ty = expr(inout ck, stmt.value);
            if ck.skip {
                return hole;
            }
            if mode(inout ck, stmt_ty) == TyMode::Linear {
                let value_ex = ck.ex(stmt.value);
                error(inout ck, "E0302", value_ex.start, value_ex.end);
            }
            if ck.ctx.types.name(stmt_ty) == known.never {
                result = stmt_ty;
            }
        }
    }
    if ck.ctx.types.name(result) != known.never && ex.x != NONE32 {
        result = expr_expected(inout ck, ex.x, expected);
    }
    ck.env.truncate(mark);
    result
}

// `Checker::bind_mode` without the linear-value checks (part 3).
fn bind_mode(inout ck: Ck, pat_id: u32, ty: u32, pass: u8) {
    let pat = ck.pats.pat(pat_id);
    let extra = ck.patx(pat_id);
    let known = ck.ctx.world.k;
    if pat.kind == P_WILD {
        return;
    }
    if pat.kind == P_BIND {
        bind_name(inout ck, extra.name, ty, pass);
        return;
    }
    if pat.kind == P_TRUE || pat.kind == P_FALSE || pat.kind == P_LIT {
        let lit_ty = if pat.kind == P_LIT && extra.lit_kind == 4 {
            named(inout ck, extra.name)
        } else if pat.kind == P_LIT && extra.lit_kind == 0 {
            mk_lit(inout ck.ctx.types, Lit { neg: extra.neg, mag: extra.mag })
        } else if pat.kind == P_LIT && extra.lit_kind == 1 {
            if is_named(in ck, ty, known.f32_) {
                ck.skip = true;
            }
            named(inout ck, known.f64_)
        } else if pat.kind == P_LIT && extra.lit_kind == 3 {
            ck.skip = true;
            named(inout ck, known.string)
        } else {
            named(inout ck, known.bool_)
        };
        expect_type(inout ck, ty, lit_ty, extra.start, extra.end);
        return;
    }
    if pat.kind == P_TUPLE {
        let ty_node = ck.ctx.types.node(ty);
        if ty_node.kind == TyKind::Tuple {
            if pat.kid_count != ty_node.n {
                error(inout ck, "E0211", extra.start, extra.end);
            }
            let mut zip_len = w(pat.kid_count);
            if w(ty_node.n) < zip_len {
                zip_len = w(ty_node.n);
            }
            for i in 0..zip_len {
                bind_mode(
                    inout ck,
                    ck.pats.kid(add(w(pat.kid_start), i)),
                    item(in ck.ctx.types, add(w(ty_node.a), i)),
                    pass
                );
            }
        } else {
            error(inout ck, "E0211", extra.start, extra.end);
        }
        return;
    }
    // A constructor pattern.
    let ctor = ctor_of(in ck, extra.qualifier, pat.name);
    if ctor == NONE64 {
        error(inout ck, "E0211", extra.start, extra.end);
        return;
    }
    let adt = ck.ctx.world.adt(n32(ctor >> 32));
    let variant = ck.ctx.world.variant(ctor & 4294967295);
    let ty_node = ck.ctx.types.node(ty);
    let generics = generic_names(in ck, adt);
    let mut vars = vars_new();
    if ty_node.kind == TyKind::Named {
        if ty_node.name != adt.name {
            error(inout ck, "E0211", extra.start, extra.end);
        }
        for i in 0..generics.len() {
            if i >= w(ty_node.n) {
                break;
            }
            vars.set(u32_at(in generics, i), item(in ck.ctx.types, add(w(ty_node.a), i)));
        }
    } else {
        error(inout ck, "E0211", extra.start, extra.end);
    }
    let mut seen: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..w(pat.kid_count) {
        let fname = ck.pats.kname(add(w(pat.kid_start), i));
        let sub_pat = ck.pats.kid(add(w(pat.kid_start), i));
        let mut dup = false;
        for j in 0..seen.len() {
            if u32_at(in seen, j) == fname {
                dup = true;
            }
        }
        let sub_extra = ck.patx(sub_pat);
        if dup {
            error(inout ck, "E0211", sub_extra.start, sub_extra.end);
        } else {
            seen.push(fname);
        }
        let field_index = ck.ctx.world.find_field(variant, fname);
        if field_index != NONE32 {
            let field = ck.ctx.world.field(w(field_index));
            let field_ty = substitute(inout ck.ctx.types, field.ty, in vars);
            bind_mode(inout ck, sub_pat, field_ty, pass);
        } else {
            error(inout ck, "E0211", sub_extra.start, sub_extra.end);
        }
    }
    if seen.len() != w(variant.fc) {
        error(inout ck, "E0211", extra.start, extra.end);
    }
}

fn unary_expr(inout ck: Ck, ex: Ex, expected: u32) -> u32 {
    let raw_ty = expr_expected(inout ck, ex.x, expected);
    let operand_ty = default_type(inout ck.ctx.types, raw_ty);
    let known = ck.ctx.world.k;
    if ex.y == 1 {
        let bool_ty = named(inout ck, known.bool_);
        expect_type(inout ck, bool_ty, operand_ty, ex.start, ex.end);
        return bool_ty;
    }
    if !numeric(in ck, operand_ty) {
        error(inout ck, "E0200", ex.start, ex.end);
    }
    // Overflow of a negation raises `Fail` (lane 8's effect rows).
    operand_ty
}

// `float_math_rules::float_literal_tree`.
fn float_literal_tree(in ck: Ck, e: u32) -> bool {
    let ex = ck.ex(e);
    if ex.kind == E_FLOAT {
        return true;
    }
    if ex.kind == E_UNARY && ex.y == 2 {
        return float_literal_tree(in ck, ex.x);
    }
    if ex.kind == E_BINARY && ex.y >= B_ADD && ex.y <= B_REM {
        return float_literal_tree(in ck, ex.x) && float_literal_tree(in ck, ex.z);
    }
    false
}

fn binary_expr(inout ck: Ck, ex: Ex, expected: u32) -> u32 {
    let hole = ck.ctx.types.infer;
    let known = ck.ctx.world.k;
    let op = ex.y;
    let arithmetic = op >= B_ADD && op <= B_REM;
    let logic = op == B_AND || op == B_OR;
    let goal = if logic {
        named(inout ck, known.bool_)
    } else if arithmetic && numeric(in ck, expected) && expected != hole {
        expected
    } else {
        hole
    };
    let left_ty = expr_expected(inout ck, ex.x, goal);
    if ck.skip {
        return hole;
    }
    let right_goal = if goal != hole {
        goal
    } else if float_literal_tree(in ck, ex.x) {
        hole
    } else if ck.ctx.types.kind(left_ty) != TyKind::Lit {
        left_ty
    } else {
        hole
    };
    // `&&` and `||` merge the environments of both paths (facts: part 3).
    let right_ty = expr_expected(inout ck, ex.z, right_goal);
    if ck.skip {
        return hole;
    }
    let left_node = ck.ctx.types.node(left_ty);
    let right_node = ck.ctx.types.node(right_ty);
    let common = if left_node.kind == TyKind::Lit && right_node.kind == TyKind::Lit {
        let hi = lit_max(lit_of(left_node), lit_of(right_node));
        named(inout ck, default_kind(in ck, hi))
    } else if left_node.kind == TyKind::Lit {
        right_ty
    } else {
        left_ty
    };
    let left_ex = ck.ex(ex.x);
    let right_ex = ck.ex(ex.z);
    expect_type(inout ck, common, left_ty, left_ex.start, left_ex.end);
    expect_type(inout ck, common, right_ty, right_ex.start, right_ex.end);
    if left_node.kind == TyKind::Lit {
        record(inout ck, ex.x, common);
    }
    if right_node.kind == TyKind::Lit {
        record(inout ck, ex.z, common);
    }
    let ordered = op == B_LT || op == B_LE || op == B_GT || op == B_GE;
    if (arithmetic || ordered) && !numeric(in ck, common) {
        error(inout ck, "E0200", ex.start, ex.end);
    }
    if (op == B_EQ || op == B_NE) && mode(inout ck, common) == TyMode::Linear {
        error(inout ck, "E0302", ex.start, ex.end);
    }
    // Division by zero and overflow raise `Fail` (lane 8's effect rows).
    if logic || op == B_EQ || op == B_NE || ordered {
        named(inout ck, known.bool_)
    } else {
        common
    }
}

fn if_expr(inout ck: Ck, ex: Ex, expected: u32) -> u32 {
    let hole = ck.ctx.types.infer;
    let known = ck.ctx.world.k;
    let cond_ty = expr(inout ck, ex.x);
    let cond_ex = ck.ex(ex.x);
    let bool_ty = named(inout ck, known.bool_);
    expect_type(inout ck, bool_ty, cond_ty, cond_ex.start, cond_ex.end);
    let then_ty = expr_expected(inout ck, ex.y, expected);
    let else_ty = if ex.z != NONE32 {
        expr_expected(inout ck, ex.z, expected)
    } else {
        ck.ctx.types.unit
    };
    if ck.skip {
        return hole;
    }
    let result = join(inout ck, then_ty, else_ty, ex.start, ex.end);
    let then_ex = ck.ex(ex.y);
    expect_type(inout ck, result, then_ty, then_ex.start, then_ex.end);
    expect_type(inout ck, result, else_ty, ex.start, ex.end);
    constrain_literals(inout ck, ex.y, result);
    if ex.z != NONE32 {
        constrain_literals(inout ck, ex.z, result);
    }
    result
}

fn match_expr(inout ck: Ck, ex: Ex, expected: u32) -> u32 {
    let hole = ck.ctx.types.infer;
    let known = ck.ctx.world.k;
    let scrutinee_ty = expr(inout ck, ex.x);
    if ck.skip {
        return hole;
    }
    let mut arm_pats: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..w(ex.n) {
        arm_pats.push(ck.arm(add(w(ex.a), i)).pat);
    }
    if !arms_cover(
        inout ck.ctx.types,
        inout ck.ctx.names,
        in ck.ctx.world,
        inout ck.pats,
        in arm_pats,
        scrutinee_ty
    ) {
        error(inout ck, "E0212", ex.start, ex.end);
    }
    let mut result = named(inout ck, known.never);
    for i in 0..w(ex.n) {
        let arm = ck.arm(add(w(ex.a), i));
        let mark = ck.env.len();
        bind_mode(inout ck, arm.pat, scrutinee_ty, P_SINK);
        let arm_type = expr_expected(inout ck, arm.body, expected);
        ck.env.truncate(mark);
        if ck.skip {
            return hole;
        }
        let body_ex = ck.ex(arm.body);
        if ck.ctx.types.name(result) == known.never {
            result = arm_type;
        } else {
            let common = join(inout ck, result, arm_type, body_ex.start, body_ex.end);
            expect_type(inout ck, common, result, body_ex.start, body_ex.end);
            expect_type(inout ck, common, arm_type, body_ex.start, body_ex.end);
            result = common;
        }
    }
    for i in 0..w(ex.n) {
        constrain_literals(inout ck, ck.arm(add(w(ex.a), i)).body, result);
    }
    result
}

// `Checker::constrain_literals`.
fn constrain_literals(inout ck: Ck, e: u32, target: u32) {
    let actual = u32_at(in ck.ex_types, w(e));
    if actual != NONE32 {
        let known = ck.ctx.world.k;
        let actual_kind = ck.ctx.types.kind(actual);
        if actual_kind == TyKind::Lit && int_kind(in ck, target) != NONE32 {
            record(inout ck, e, target);
        } else if (actual_kind == TyKind::Named || actual_kind == TyKind::Tuple)
            && compatible(in ck.ctx.types, known, target, actual)
        {
            let refined = refine_annotation(inout ck.ctx.types, target, actual);
            record(inout ck, e, refined);
        }
    }
    let ex = ck.ex(e);
    if ex.kind == E_TUPLE {
        let target_node = ck.ctx.types.node(target);
        if target_node.kind == TyKind::Tuple {
            let mut zip_len = w(ex.n);
            if w(target_node.n) < zip_len {
                zip_len = w(target_node.n);
            }
            for i in 0..zip_len {
                constrain_literals(
                    inout ck,
                    ck.kid(add(w(ex.a), i)),
                    item(in ck.ctx.types, add(w(target_node.a), i))
                );
            }
        }
    } else if ex.kind == E_STRUCT || (ex.kind == E_CALL && ck.ex(ex.x).kind == E_NAME) {
        let (qualifier, short_name) = if ex.kind == E_STRUCT {
            (ex.y, ex.z)
        } else {
            let callee = ck.ex(ex.x);
            (callee.y, callee.z)
        };
        if ex.kind == E_CALL && ex.y != 0 {
            // `Box::new` under fip (lane 12) never reaches here: boxes
            // skip the function.
            return;
        }
        let ctor = ctor_of(in ck, qualifier, short_name);
        if ctor == NONE64 {
            return;
        }
        let adt = ck.ctx.world.adt(n32(ctor >> 32));
        let variant = ck.ctx.world.variant(ctor & 4294967295);
        let generics = generic_names(in ck, adt);
        let mut vars = vars_new();
        let target_node = ck.ctx.types.node(target);
        if target_node.kind == TyKind::Named {
            for i in 0..generics.len() {
                if i >= w(target_node.n) {
                    break;
                }
                vars.set(u32_at(in generics, i), item(in ck.ctx.types, add(w(target_node.a), i)));
            }
        }
        if ex.kind == E_STRUCT {
            for i in 0..w(ex.n) {
                let field_index = ck.ctx
                    .world
                    .find_field(variant, u32_at(in ck.field_names, add(w(ex.a), i)));
                if field_index != NONE32 {
                    let field = ck.ctx.world.field(w(field_index));
                    let field_ty = substitute(inout ck.ctx.types, field.ty, in vars);
                    constrain_literals(inout ck, ck.kid(add(w(ex.a), i)), field_ty);
                }
            }
        } else {
            let mut zip_len = w(ex.n);
            if w(variant.fc) < zip_len {
                zip_len = w(variant.fc);
            }
            for i in 0..zip_len {
                let field = ck.ctx.world.field(add(w(variant.fa), i));
                let field_ty = substitute(inout ck.ctx.types, field.ty, in vars);
                constrain_literals(inout ck, ck.arg(add(w(ex.a), i)).expr, field_ty);
            }
        }
    } else if ex.kind == E_BLOCK {
        if ex.x != NONE32 {
            constrain_literals(inout ck, ex.x, target);
        }
    } else if ex.kind == E_IF {
        constrain_literals(inout ck, ex.y, target);
        if ex.z != NONE32 {
            constrain_literals(inout ck, ex.z, target);
        }
    } else if ex.kind == E_MATCH {
        for i in 0..w(ex.n) {
            constrain_literals(inout ck, ck.arm(add(w(ex.a), i)).body, target);
        }
    }
}

// ----- calls -----------------------------------------------------------------

fn call_expr(inout ck: Ck, ex: Ex, expected: u32) -> u32 {
    let hole = ck.ctx.types.infer;
    let callee = ck.ex(ex.x);
    if callee.kind == E_FIELD {
        return method_call(inout ck, ex, callee, expected);
    }
    if callee.kind != E_NAME || lookup(in ck, callee.x) != NONE32 || ex.y != 0 {
        // Closures, function values and intrinsics: not ported yet.
        ck.skip = true;
        return hole;
    }
    let ctor = ctor_of(in ck, callee.y, callee.z);
    if ctor != NONE64 {
        let adt = ck.ctx.world.adt(n32(ctor >> 32));
        let mut fields: ChunkSeq[u32] = ChunkSeq::new[u32]();
        let mut values: ChunkSeq[u32] = ChunkSeq::new[u32]();
        for i in 0..w(ex.n) {
            let index_sym = ck.pats.index_name(inout ck.ctx.names, i);
            fields.push(index_sym);
            values.push(ck.arg(add(w(ex.a), i)).expr);
        }
        let mut targs: ChunkSeq[u32] = ChunkSeq::new[u32]();
        for i in 0..w(ex.m) {
            targs.push(u32_at(in ck.targs, add(w(ex.b), i)));
        }
        let goal = if ex.m == 0 {
            expected
        } else {
            ck.ctx.types.named(adt.name, in targs)
        };
        let ctor_ty = construct(
            inout ck,
            callee.y,
            callee.z,
            in fields,
            in values,
            goal,
            ex.start,
            ex.end
        );
        if ex.m != 0 && ck.ctx.types.kind(ctor_ty) == TyKind::Named {
            let ctor_node = ck.ctx.types.node(ctor_ty);
            let mut actual: ChunkSeq[u32] = ChunkSeq::new[u32]();
            for i in 0..w(ctor_node.n) {
                actual.push(item(in ck.ctx.types, add(w(ctor_node.a), i)));
            }
            let want = ck.ctx.types.named(ctor_node.name, in targs);
            let got = ck.ctx.types.named(ctor_node.name, in actual);
            expect_type(inout ck, want, got, ex.start, ex.end);
            return want;
        }
        return ctor_ty;
    }
    let callee_index = fn_index(in ck, callee.x);
    if callee_index == NONE32 {
        // Intrinsics, effect operations and trait calls: not ported yet.
        ck.skip = true;
        return hole;
    }
    let sig = ck.fsig(callee_index);
    if sig.effectful {
        ck.skip = true;
        return hole;
    }
    apply(inout ck, sig, ex, NONE32, expected)
}

// The inherent-method arm of `Checker::call`: `receiver.method(args)` on a
// place whose type has a `Type::method` function in the world, checked as
// that function with the receiver as its first argument. Region and
// capability operations, the builtin string, sequence, tiled and array
// methods, literal and call receivers and trait methods are not ported
// yet and skip the function.
fn method_call(inout ck: Ck, ex: Ex, callee: Ex, expected: u32) -> u32 {
    let hole = ck.ctx.types.infer;
    let mut path: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let root = place_of(in ck, callee.x, inout path);
    if root == NONE32 {
        ck.skip = true;
        return hole;
    }
    let bind_index = lookup(in ck, root);
    if bind_index == NONE32 {
        ck.skip = true;
        return hole;
    }
    // `peek_type(base)`.
    let receiver_ty = field_path(inout ck, binding(in ck, bind_index).ty, in path);
    if receiver_ty == NONE32
        || foreign(in ck, receiver_ty)
        || ck.ctx.types.kind(receiver_ty) != TyKind::Named
    {
        ck.skip = true;
        return hole;
    }
    let mut inherent = ChunkSeq::new[u8]();
    ck.ctx.names.write(ck.ctx.types.node(receiver_ty).name, inout inherent);
    put(inout inherent, "::");
    ck.ctx.names.write(callee.y, inout inherent);
    let method_sym = ck.ctx.names.lookup(in inherent.as_slice());
    let method_index = if method_sym == NONE32 {
        NONE32
    } else {
        fn_index(in ck, method_sym)
    };
    if method_index == NONE32 {
        ck.skip = true;
        return hole;
    }
    let sig = ck.fsig(method_index);
    if sig.effectful {
        ck.skip = true;
        return hole;
    }
    apply(inout ck, sig, ex, callee.x, expected)
}

fn fn_generics(in ck: Ck, sig: FnSig) -> ChunkSeq[u32] {
    let mut generics: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..w(sig.generic_count) {
        generics.push(ck.gen(add(w(sig.generic_start), i)).name);
    }
    generics
}

// `Checker::apply` for an effect-free function; `receiver` is the method
// receiver's expression, or NONE32.
fn apply(inout ck: Ck, sig: FnSig, ex: Ex, receiver: u32, expected: u32) -> u32 {
    let hole = ck.ctx.types.infer;
    let known = ck.ctx.world.k;
    let generics = fn_generics(in ck, sig);
    let mut vars = vars_new();
    if expected != hole {
        infer(inout ck.ctx.types, known, sig.result, expected, in generics, inout vars);
    }
    let result_ty = apply_args(inout ck, sig, ex, receiver, inout vars);
    if ck.skip {
        return hole;
    }
    substitute(inout ck.ctx.types, sig.inferred, in vars)
}

fn copy_vars(in vars: Vars) -> Vars {
    let mut copied = vars_new();
    for i in 0..vars.keys.len() {
        copied.set(u32_at(in vars.keys, i), u32_at(in vars.vals, i));
    }
    copied
}

// The call's actual arguments: the receiver (passed without an explicit
// mode), then the written arguments.
fn actuals_of(in ck: Ck, ex: Ex, receiver: u32) -> ChunkSeq[Arg] {
    let mut actuals: ChunkSeq[Arg] = ChunkSeq::new[Arg]();
    if receiver != NONE32 {
        actuals.push(Arg { pass: 0, explicit: false, expr: receiver });
    }
    for i in 0..w(ex.n) {
        actuals.push(ck.arg(add(w(ex.a), i)));
    }
    actuals
}

fn actual_at(in actuals: ChunkSeq[Arg], i: u64) -> Arg {
    match actuals.try_get(i) {
        Option::Some(x) => x,
        Option::None => Arg { pass: 0, explicit: false, expr: NONE32 },
    }
}

// `Checker::apply_args` for an effect-free function without projections.
fn apply_args(inout ck: Ck, sig: FnSig, ex: Ex, receiver: u32, inout vars: Vars) -> u32 {
    let hole = ck.ctx.types.infer;
    let known = ck.ctx.world.k;
    let generics = fn_generics(in ck, sig);
    let mut explicit: u64 = 0;
    for i in 0..w(sig.generic_count) {
        if explicit >= w(ex.m) {
            break;
        }
        let generic = ck.gen(add(w(sig.generic_start), i));
        if generic.row {
            ck.skip = true;
            return hole;
        }
        let targ = u32_at(in ck.targs, add(w(ex.b), explicit));
        explicit = inc(explicit);
        note(inout ck, targ);
        vars.set(generic.name, targ);
    }
    if explicit < w(ex.m) {
        error(inout ck, "E0205", ex.start, ex.end);
    }
    let call_args = actuals_of(in ck, ex, receiver);
    if call_args.len() != w(sig.param_count) {
        error(inout ck, "E0207", ex.start, ex.end);
    }
    let mut zip_len = call_args.len();
    if w(sig.param_count) < zip_len {
        zip_len = w(sig.param_count);
    }
    let mut actuals: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..zip_len {
        let arg = actual_at(in call_args, i);
        let param = ck.param(add(w(sig.param_start), i));
        let arg_ex = ck.ex(arg.expr);
        if param.projections != 0 {
            ck.skip = true;
            return hole;
        }
        if arg.explicit && arg.pass != param.pass {
            error(inout ck, "E0308", arg_ex.start, arg_ex.end);
        }
        let mut path: ChunkSeq[u32] = ChunkSeq::new[u32]();
        let place = place_of(in ck, arg.expr, inout path);
        if param.pass == P_INOUT && place == NONE32 {
            error(inout ck, "E0300", arg_ex.start, arg_ex.end);
        }
        let context = with_infer(in ck, in vars, in generics);
        let target = substitute(inout ck.ctx.types, param.ty, in context);
        note(inout ck, target);
        let actual = if param.pass == P_INOUT {
            expr(inout ck, arg.expr)
        } else {
            expr_expected(inout ck, arg.expr, target)
        };
        if ck.skip {
            return hole;
        }
        if param.pass != P_SINK && place == NONE32 && mode(inout ck, actual) == TyMode::Linear {
            error(inout ck, "E0302", arg_ex.start, arg_ex.end);
        }
        if param.pass == P_INOUT && !compatible(in ck.ctx.types, known, actual, target) {
            error(inout ck, "E0403", arg_ex.start, arg_ex.end);
        }
        infer(inout ck.ctx.types, known, param.ty, actual, in generics, inout vars);
        actuals.push(actual);
        let want = substitute(inout ck.ctx.types, param.ty, in vars);
        expect_type(inout ck, want, actual, arg_ex.start, arg_ex.end);
    }
    for i in 0..vars.vals.len() {
        let defaulted = default_type(inout ck.ctx.types, u32_at(in vars.vals, i));
        let ok = vars.vals.try_set(i, defaulted);
    }
    for i in 0..zip_len {
        let arg = actual_at(in call_args, i);
        let param = ck.param(add(w(sig.param_start), i));
        let arg_ex = ck.ex(arg.expr);
        let target = substitute(inout ck.ctx.types, param.ty, in vars);
        expect_type(inout ck, target, u32_at(in actuals, i), arg_ex.start, arg_ex.end);
        constrain_literals(inout ck, arg.expr, target);
    }
    for i in 0..w(sig.generic_count) {
        let generic = ck.gen(add(w(sig.generic_start), i));
        check_bound(inout ck, generic, in vars, ex.start, ex.end);
    }
    substitute(inout ck.ctx.types, sig.result, in vars)
}

// ----- functions -------------------------------------------------------------

// `Checker::function_body` for the expression types: the parameters bound,
// the body checked against the declared result. Writes `F start end` and a
// `T start end type` row per recorded expression, or `S start end`.
pub fn check_function(inout ck: Ck, fname: u32, start: u64, end: u64, body: u32, first: u32) {
    ck.skip = false;
    ck.env.truncate(0);
    let sig_index = fn_index(in ck, fname);
    if sig_index == NONE32 {
        ck.skip = true;
    }
    let sig = ck.fsig(sig_index);
    if sig.effectful {
        ck.skip = true;
    }
    ck.bounds = bounds_of(in ck, sig);
    let mark = ck.out.len();
    put(inout ck.out, "F ");
    put_u64(inout ck.out, start);
    ck.out.push(32);
    put_u64(inout ck.out, end);
    ck.out.push(10);
    for i in 0..w(sig.param_count) {
        let param = ck.param(add(w(sig.param_start), i));
        bind_name(inout ck, param.name, param.ty, param.pass);
    }
    note(inout ck, sig.result);
    if !ck.skip {
        let actual = expr_expected(inout ck, body, sig.result);
        if !ck.skip {
            let body_ex = ck.ex(body);
            expect_type(inout ck, sig.result, actual, body_ex.start, body_ex.end);
        }
    }
    if ck.skip {
        ck.out.truncate(mark);
        put(inout ck.out, "S ");
        put_u64(inout ck.out, start);
        ck.out.push(32);
        put_u64(inout ck.out, end);
        ck.out.push(10);
        return;
    }
    for e in w(first)..ck.exs.len() {
        let ty = u32_at(in ck.ex_types, e);
        if ty != NONE32 {
            let ex = ck.ex(n32(e));
            put(inout ck.out, "T ");
            put_u64(inout ck.out, ex.start);
            ck.out.push(32);
            put_u64(inout ck.out, ex.end);
            ck.out.push(32);
            debug_type(in ck.ctx.types, in ck.ctx.names, ty, inout ck.out);
            ck.out.push(10);
        }
    }
}

// The task: the function table, then each checked function (name, span,
// body tree), checked as it is read.
pub fn check_exprs(inout reader: Reader, in bytes: Slice[u8], inout ck: Ck) {
    read_fns(inout reader, in bytes, inout ck);
    let fn_count = reader.word(in bytes);
    for i in 0..fn_count {
        let name = sym(in ck.ctx, reader.word(in bytes));
        let start = reader.word(in bytes);
        let end = reader.word(in bytes);
        let first = n32(ck.exs.len());
        let body = read_expr(inout reader, in bytes, inout ck);
        check_function(inout ck, name, start, end, body, first);
    }
}
