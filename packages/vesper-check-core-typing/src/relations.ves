// The type relations of src/check.rs: `compatible`, `effects_include`,
// `refine_annotation`, `unresolved`, `union_effects`, `join_types` and
// `infer`. Types are ids of the check-data arena, so the clones Rust makes
// are copies and `==` on types and rows is one compare.

use @vesper/check-data::util::{add, n32, u32_at, u8_at, w};
use @vesper/check-data::types::{EffNode, RowNode, TypeNode, Types, Vars, TyKind, literal_hi};
use @vesper/check-data::world::{Known};
use self::ints::{Lit, above_i64, default_fits, fits, lit_max, lit_min};

const NONE32: u32 = 4294967295;

pub fn lit_of(node: TypeNode) -> Lit {
    Lit { neg: node.mode == 1, mag: wrapping_u64(node.lit), hi: literal_hi(node) }
}

pub fn mk_lit(inout types: Types, value: Lit) -> u32 {
    types.wide_literal(value.neg, value.mag, value.hi)
}

// Item `i` of the arena's shared item list (arguments and parameters).
pub fn item(in types: Types, i: u64) -> u32 {
    u32_at(in types.items, i)
}

fn is_never(in types: Types, known: Known, ty: u32) -> bool {
    types.name(ty) == known.never
}

// `check::compatible`.
pub fn compatible(in types: Types, known: Known, a: u32, b: u32) -> bool {
    if a == types.infer || b == types.infer || is_never(in types, known, b) {
        return true;
    }
    let a_node = types.node(a);
    let b_node = types.node(b);
    if a_node.kind == TyKind::Lit && b_node.kind == TyKind::Lit {
        return true;
    }
    if a_node.kind == TyKind::Lit {
        return fits_type(in types, known, b, lit_of(a_node));
    }
    if b_node.kind == TyKind::Lit {
        return fits_type(in types, known, a, lit_of(b_node));
    }
    if a_node.kind == TyKind::Named && b_node.kind == TyKind::Named {
        if a_node.name != b_node.name || a_node.n != b_node.n {
            return false;
        }
        return all_compatible(in types, known, a_node, b_node);
    }
    if a_node.kind == TyKind::Tuple && b_node.kind == TyKind::Tuple {
        if a_node.n != b_node.n {
            return false;
        }
        return all_compatible(in types, known, a_node, b_node);
    }
    if a_node.kind == TyKind::Named && b_node.kind == TyKind::Tuple {
        return a_node.name == known.unit && b_node.n == 0;
    }
    if a_node.kind == TyKind::Tuple && b_node.kind == TyKind::Named {
        return b_node.name == known.unit && a_node.n == 0;
    }
    if a_node.kind == TyKind::Row && b_node.kind == TyKind::Row {
        return a == b;
    }
    if a_node.kind == TyKind::Fn && b_node.kind == TyKind::Fn {
        if !effects_include(in types, known, a_node.r2, b_node.r2)
            || b_node.mode > a_node.mode
            || a_node.n != b_node.n
        {
            return false;
        }
        for i in 0..w(a_node.n) {
            let a_pass = u8_at(in types.passes, add(w(a_node.a), i));
            let b_pass = u8_at(in types.passes, add(w(b_node.a), i));
            if a_pass != b_pass {
                return false;
            }
            // Parameters are contravariant.
            if !compatible(
                in types,
                known,
                item(in types, add(w(b_node.a), i)),
                item(in types, add(w(a_node.a), i))
            ) {
                return false;
            }
        }
        return compatible(in types, known, a_node.r, b_node.r);
    }
    false
}

fn all_compatible(in types: Types, known: Known, a_node: TypeNode, b_node: TypeNode) -> bool {
    for i in 0..w(a_node.n) {
        if !compatible(
            in types,
            known,
            item(in types, add(w(a_node.a), i)),
            item(in types, add(w(b_node.a), i))
        ) {
            return false;
        }
    }
    true
}

// `IntegerKind::from_type(t).is_some_and(|k| k.fits(n))` for a non-literal `ty`.
fn fits_type(in types: Types, known: Known, ty: u32, value: Lit) -> bool {
    let node = types.node(ty);
    if node.kind != TyKind::Named {
        return false;
    }
    fits(known, node.name, value)
}

// `check::effects_include(expected, actual)` on rows.
pub fn effects_include(in types: Types, known: Known, expected: u32, actual: u32) -> bool {
    let expected_row = types.row(expected);
    let actual_row = types.row(actual);
    if actual_row.tail != 0 && expected_row.tail == 0 {
        return false;
    }
    if expected_row.tail != 0 {
        return true;
    }
    for i in 0..w(actual_row.n) {
        let actual_effect = types.effect_at(add(w(actual_row.a), i));
        let mut found = false;
        for j in 0..w(expected_row.n) {
            let expected_effect = types.effect_at(add(w(expected_row.a), j));
            if expected_effect.name == actual_effect.name
                && (expected_effect.label == 0 || expected_effect.label == actual_effect.label)
                && expected_effect.n == actual_effect.n
            {
                let mut all = true;
                for arg_index in 0..w(expected_effect.n) {
                    if !compatible(
                        in types,
                        known,
                        item(in types, add(w(expected_effect.a), arg_index)),
                        item(in types, add(w(actual_effect.a), arg_index))
                    ) {
                        all = false;
                        break;
                    }
                }
                if all {
                    found = true;
                    break;
                }
            }
        }
        if !found {
            return false;
        }
    }
    true
}

// `check::unresolved`.
pub fn unresolved(in types: Types, ty: u32) -> bool {
    let node = types.node(ty);
    if node.kind == TyKind::Infer {
        return true;
    }
    if node.kind == TyKind::Named || node.kind == TyKind::Tuple || node.kind == TyKind::Fn {
        for i in 0..w(node.n) {
            if unresolved(in types, item(in types, add(w(node.a), i))) {
                return true;
            }
        }
        if node.kind == TyKind::Fn {
            return unresolved(in types, node.r);
        }
    }
    false
}

// ----- rows under construction --------------------------------------------

// A row being built: effect instances whose arguments index `args`.
pub struct RowBuf {
    effects: ChunkSeq[EffNode],
    args: ChunkSeq[u32],
    tail: u32,
}

pub fn row_buf(in types: Types, row_id: u32) -> RowBuf {
    let mut buf = RowBuf {
        effects: ChunkSeq::new[EffNode](),
        args: ChunkSeq::new[u32](),
        tail: types.row(row_id).tail
    };
    let row = types.row(row_id);
    for i in 0..w(row.n) {
        buf.push(in types, types.effect_at(add(w(row.a), i)));
    }
    buf
}

impl RowBuf {
    // Appends arena instance `e` (its arguments copied).
    pub fn push(inout self, in types: Types, e: EffNode) {
        let arg_start = n32(self.args.len());
        for j in 0..w(e.n) {
            self.args.push(item(in types, add(w(e.a), j)));
        }
        self.effects.push(EffNode { label: e.label, name: e.name, a: arg_start, n: e.n });
    }

    // `instances.contains(e)` for arena instance `e`.
    pub fn contains(in self, in types: Types, e: EffNode) -> bool {
        for i in 0..self.effects.len() {
            let held = match self.effects.try_get(i) {
                Option::Some(held) => held,
                Option::None => return false,
            };
            if held.label == e.label && held.name == e.name && held.n == e.n {
                let mut same = true;
                for j in 0..w(e.n) {
                    if u32_at(in self.args, add(w(held.a), j)) != item(in types, add(w(e.a), j)) {
                        same = false;
                        break;
                    }
                }
                if same {
                    return true;
                }
            }
        }
        false
    }

    // Whether an instance has the name of arena instance `e`.
    pub fn has_name(in self, e: EffNode) -> bool {
        for i in 0..self.effects.len() {
            match self.effects.try_get(i) {
                Option::Some(held) => {
                    if held.name == e.name {
                        return true;
                    }
                },
                Option::None => return false,
            }
        }
        false
    }

    pub fn finish(in self, inout types: Types) -> u32 {
        types.mk_row(in self.effects, in self.args, self.tail)
    }
}

// `check::union_effects(into, from)`: the new row.
pub fn union_rows(inout types: Types, into: u32, from: u32) -> u32 {
    let mut buf = row_buf(in types, into);
    let from_row = types.row(from);
    for i in 0..w(from_row.n) {
        let effect = types.effect_at(add(w(from_row.a), i));
        if !buf.contains(in types, effect) {
            buf.push(in types, effect);
        }
    }
    if buf.tail == 0 {
        buf.tail = from_row.tail;
    }
    buf.finish(inout types)
}

fn mk_fn(inout types: Types, like: u32, result: u32, row: u32, mode: u8) -> u32 {
    let like_node = types.node(like);
    let mut params: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](w(like_node.n));
    let mut passes: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](w(like_node.n));
    for i in 0..w(like_node.n) {
        params.push(item(in types, add(w(like_node.a), i)));
        passes.push(u8_at(in types.passes, add(w(like_node.a), i)));
    }
    types.mk_with(TyKind::Fn, mode, 0, in params, in passes, result, row, 0)
}

// `check::refine_annotation(expected, actual)`.
pub fn refine_annotation(inout types: Types, expected: u32, actual: u32) -> u32 {
    let expected_node = types.node(expected);
    let actual_node = types.node(actual);
    if (expected_node.kind == TyKind::Named
        && actual_node.kind == TyKind::Named
        && expected_node.name == actual_node.name)
        || (expected_node.kind == TyKind::Tuple && actual_node.kind == TyKind::Tuple)
    {
        // `zip`: the shorter list wins.
        let mut zip_len = w(expected_node.n);
        if w(actual_node.n) < zip_len {
            zip_len = w(actual_node.n);
        }
        let mut args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](zip_len);
        for i in 0..zip_len {
            let expected_arg = item(in types, add(w(expected_node.a), i));
            let actual_arg = item(in types, add(w(actual_node.a), i));
            let refined = refine_annotation(inout types, expected_arg, actual_arg);
            args.push(refined);
        }
        if expected_node.kind == TyKind::Named {
            return types.named(expected_node.name, in args);
        }
        return types.tuple(in args);
    }
    if expected_node.kind == TyKind::Fn && actual_node.kind == TyKind::Fn {
        let mut row = row_buf(in types, actual_node.r2);
        let expected_row = types.row(expected_node.r2);
        for i in 0..w(expected_row.n) {
            let effect = types.effect_at(add(w(expected_row.a), i));
            if !row.has_name(effect) {
                row.push(in types, effect);
            }
        }
        if row.tail == 0 {
            row.tail = expected_row.tail;
        }
        let row_id = row.finish(inout types);
        let result = refine_annotation(inout types, expected_node.r, actual_node.r);
        return mk_fn(inout types, expected, result, row_id, expected_node.mode);
    }
    expected
}

// `check::join_types(a, b)`; adds the `E0200` diagnostics it raises to
// `errors`.
pub fn join_types(inout types: Types, known: Known, a: u32, b: u32, inout errors: u64) -> u32 {
    if is_never(in types, known, a) || a == types.infer {
        return b;
    }
    if is_never(in types, known, b) || b == types.infer {
        return a;
    }
    let a_node = types.node(a);
    let b_node = types.node(b);
    if a_node.kind == TyKind::Lit && b_node.kind == TyKind::Lit {
        let a_lit = lit_of(a_node);
        let b_lit = lit_of(b_node);
        let hi = lit_max(a_lit, b_lit);
        let mut joined_lit = hi;
        if !above_i64(hi) && lit_min(a_lit, b_lit).neg {
            joined_lit = lit_min(a_lit, b_lit);
        }
        if !default_fits(known, joined_lit, a_lit) || !default_fits(known, joined_lit, b_lit) {
            errors = wrapping_add(errors, 1);
        }
        return mk_lit(inout types, joined_lit);
    }
    if a_node.kind == TyKind::Lit {
        return b;
    }
    if b_node.kind == TyKind::Lit {
        return a;
    }
    if (a_node.kind == TyKind::Named
        && b_node.kind == TyKind::Named
        && a_node.name == b_node.name
        && a_node.n == b_node.n)
        || (a_node.kind == TyKind::Tuple && b_node.kind == TyKind::Tuple && a_node.n == b_node.n)
    {
        let mut args: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](w(a_node.n));
        for i in 0..w(a_node.n) {
            let a_arg = item(in types, add(w(a_node.a), i));
            let b_arg = item(in types, add(w(b_node.a), i));
            let joined_arg = join_types(inout types, known, a_arg, b_arg, inout errors);
            args.push(joined_arg);
        }
        if a_node.kind == TyKind::Named {
            return types.named(a_node.name, in args);
        }
        return types.tuple(in args);
    }
    if a_node.kind == TyKind::Fn && b_node.kind == TyKind::Fn {
        let row = union_rows(inout types, a_node.r2, b_node.r2);
        let result = join_types(inout types, known, a_node.r, b_node.r, inout errors);
        let mut mode = a_node.mode;
        if b_node.mode > mode {
            mode = b_node.mode;
        }
        return mk_fn(inout types, a, result, row, mode);
    }
    a
}

// ----- infer ---------------------------------------------------------------

fn is_generic(in generics: ChunkSeq[u32], name: u32) -> bool {
    for i in 0..generics.len() {
        if u32_at(in generics, i) == name {
            return true;
        }
    }
    false
}

// `check::infer(expected, actual, generics, vars)`: `generics` are the
// generic name symbols, `vars` the inferred bindings (NONE32 = absent).
pub fn infer(
    inout types: Types,
    known: Known,
    expected: u32,
    actual: u32,
    in generics: ChunkSeq[u32],
    inout vars: Vars
) {
    let expected_node = types.node(expected);
    let actual_node = types.node(actual);
    if expected_node.kind == TyKind::Named
        && expected_node.n == 0
        && is_generic(in generics, expected_node.name)
    {
        let current = vars.get(expected_node.name);
        if current == NONE32 || current == types.infer {
            vars.set(expected_node.name, actual);
            return;
        }
        let current_node = types.node(current);
        if current_node.kind == TyKind::Lit {
            if actual_node.kind == TyKind::Lit {
                let prev = lit_of(current_node);
                let next = lit_of(actual_node);
                let mut widened = lit_max(prev, next);
                if !above_i64(next) && !above_i64(prev) && (prev.neg || next.neg) {
                    widened = lit_min(prev, next);
                }
                let lit_ty = mk_lit(inout types, widened);
                vars.set(expected_node.name, lit_ty);
            } else if compatible(in types, known, current, actual) {
                vars.set(expected_node.name, actual);
            }
            return;
        }
        if compatible(in types, known, current, actual) {
            let refined = refine_annotation(inout types, current, actual);
            vars.set(expected_node.name, refined);
        }
        return;
    }
    if (expected_node.kind == TyKind::Named && actual_node.kind == TyKind::Named)
        || (expected_node.kind == TyKind::Tuple && actual_node.kind == TyKind::Tuple)
    {
        let mut zip_len = w(expected_node.n);
        if w(actual_node.n) < zip_len {
            zip_len = w(actual_node.n);
        }
        for i in 0..zip_len {
            let expected_arg = item(in types, add(w(expected_node.a), i));
            let actual_arg = item(in types, add(w(actual_node.a), i));
            infer(inout types, known, expected_arg, actual_arg, in generics, inout vars);
        }
        return;
    }
    if expected_node.kind == TyKind::Fn && actual_node.kind == TyKind::Fn {
        let mut zip_len = w(expected_node.n);
        if w(actual_node.n) < zip_len {
            zip_len = w(actual_node.n);
        }
        for i in 0..zip_len {
            let expected_arg = item(in types, add(w(expected_node.a), i));
            let actual_arg = item(in types, add(w(actual_node.a), i));
            infer(inout types, known, expected_arg, actual_arg, in generics, inout vars);
        }
        infer(inout types, known, expected_node.r, actual_node.r, in generics, inout vars);
        let expected_row = types.row(expected_node.r2);
        if expected_row.tail == 0 {
            return;
        }
        let row_var = wrapping_sub(expected_row.tail, 1);
        let actual_row = types.row(actual_node.r2);
        // The instances of `actual_row` that no instance of `expected_row` names
        // (name and label).
        let mut leftover = RowBuf {
            effects: ChunkSeq::new[EffNode](),
            args: ChunkSeq::new[u32](),
            tail: actual_row.tail
        };
        for i in 0..w(actual_row.n) {
            let effect = types.effect_at(add(w(actual_row.a), i));
            let mut named = false;
            for j in 0..w(expected_row.n) {
                let expected_effect = types.effect_at(add(w(expected_row.a), j));
                if expected_effect.name == effect.name && expected_effect.label == effect.label {
                    named = true;
                    break;
                }
            }
            if !named {
                leftover.push(in types, effect);
            }
        }
        let prev = vars.get(row_var);
        if prev != NONE32 && types.kind(prev) == TyKind::Row {
            let mut merged = row_buf(in types, types.node(prev).r2);
            let leftover_row = leftover.finish(inout types);
            let leftover_node = types.row(leftover_row);
            for i in 0..w(leftover_node.n) {
                let effect = types.effect_at(add(w(leftover_node.a), i));
                if !merged.contains(in types, effect) {
                    merged.push(in types, effect);
                }
            }
            if merged.tail == 0 {
                merged.tail = leftover_node.tail;
            }
            let merged_row = merged.finish(inout types);
            let ty = types.row_type(merged_row);
            vars.set(row_var, ty);
        } else {
            let leftover_row = leftover.finish(inout types);
            let ty = types.row_type(leftover_row);
            vars.set(row_var, ty);
        }
    }
}
