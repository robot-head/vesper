// @vesper/check-core-typing: the core typing of src/check.rs in Vesper
// (self-hosting wave SH2, lane 7, #1179), on @vesper/check-data. Rust stays
// the default checker; this is a non-default port with a differential
// (tests/self_host_check_core_typing.rs).
//
// - ints.ves: integer literal values and `IntegerKind::fits`.
// - relations.ves: `compatible`, `effects_include`, `refine_annotation`,
//   `unresolved`, `union_effects`, `join_types` and `infer`.
// - patterns.ves: `is_uninhabited`, `matrix_covered`, `irrefutable` and
//   match coverage (E0212).
// - floats.ves: the float intrinsics (math, conversions, bit
//   reinterpretation).
// - vectors.ves: the reserved `Vec::`, `Mask::` and `Isa::` intrinsics.
//
// The entries below are the differential's tasks.

use @vesper/check-data::util::{u32_at, w};
use @vesper/check-data::names::{Names};
use @vesper/check-data::types::{Types, Vars, debug_type, vars_new};
use @vesper/check-data::input::{Ctx, Reader, read_ctx};
use @vesper/check-data::{pack_text};
use self::relations::{compatible, infer, join_types, refine_annotation, unresolved};
use self::exprs::{check_exprs, ck_new};
use self::patterns::{Pats, arms_cover, irrefutable, is_uninhabited, pats_new};

// Pattern kinds (constants cannot be imported yet; keep equal to
// patterns.ves).
const P_TUPLE: u8 = 5;
const P_CTOR: u8 = 6;

fn put(inout out: ChunkSeq[u8], in text: Str) {
    out.extend(in text.as_bytes());
}

fn put_u64(inout out: ChunkSeq[u8], value: u64) {
    if value >= 10 {
        put_u64(inout out, value / 10);
    }
    out.push(wrapping_u8(wrapping_add(value % 10, 48)));
}

fn put_bool(inout out: ChunkSeq[u8], value: bool) {
    out.push(32);
    if value {
        out.push(49);
    } else {
        out.push(48);
    }
}

fn put_debug(inout out: ChunkSeq[u8], in ctx: Ctx, ty: u32) {
    debug_type(in ctx.types, in ctx.names, ty, inout out);
}

// Task "relations".
// - n pairs (a, b): P with compatible(a, b), compatible(b, a),
//   unresolved(a); J with Debug of join_types(a, b) and its E0200 count;
//   R with Debug of refine_annotation(a, b).
// - m infer cases (g, g generic names, p, p pairs (expected, actual)):
//   `infer` over the pairs in order on one map, then a V line per binding
//   (name, Debug) and a `-` line. The harness sorts each case's V lines.
pub fn core_typing_relations(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mut reader = Reader { pos: 0 };
    let mut ctx = read_ctx(inout reader, in bytes);
    let known = ctx.world.k;
    let mut out = ChunkSeq::new[u8]();
    let pair_count = reader.word(in bytes);
    for i in 0..pair_count {
        let first_ty = u32_at(in ctx.tmap, reader.word(in bytes));
        let second_ty = u32_at(in ctx.tmap, reader.word(in bytes));
        put(inout out, "P");
        put_bool(inout out, compatible(in ctx.types, known, first_ty, second_ty));
        put_bool(inout out, compatible(in ctx.types, known, second_ty, first_ty));
        put_bool(inout out, unresolved(in ctx.types, first_ty));
        put(inout out, "\nJ ");
        let mut errors: u64 = 0;
        let joined = join_types(inout ctx.types, known, first_ty, second_ty, inout errors);
        put_debug(inout out, in ctx, joined);
        out.push(32);
        put_u64(inout out, errors);
        put(inout out, "\nR ");
        let refined = refine_annotation(inout ctx.types, first_ty, second_ty);
        put_debug(inout out, in ctx, refined);
        out.push(10);
    }
    let case_count = reader.word(in bytes);
    for i in 0..case_count {
        let generic_count = reader.word(in bytes);
        let mut generics: ChunkSeq[u32] = ChunkSeq::new[u32]();
        for j in 0..generic_count {
            generics.push(u32_at(in ctx.nmap, reader.word(in bytes)));
        }
        let infer_pair_count = reader.word(in bytes);
        let mut vars = vars_new();
        for j in 0..infer_pair_count {
            let expected = u32_at(in ctx.tmap, reader.word(in bytes));
            let actual = u32_at(in ctx.tmap, reader.word(in bytes));
            infer(inout ctx.types, known, expected, actual, in generics, inout vars);
        }
        for j in 0..vars.keys.len() {
            put(inout out, "V ");
            ctx.names.write(u32_at(in vars.keys, j), inout out);
            out.push(32);
            put_debug(inout out, in ctx, u32_at(in vars.vals, j));
            out.push(10);
        }
        put(inout out, "-\n");
    }
    pack_text(in out)
}

// One pattern tree of the task input (pre-order): kind; a tuple then has
// n and n trees; a constructor its short name, n and n (field name, tree).
fn read_pat(inout reader: Reader, in bytes: Slice[u8], in ctx: Ctx, inout pats: Pats) -> u32 {
    let kind = wrapping_u8(reader.word(in bytes));
    let mut name: u32 = 0;
    let mut kids: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut kid_names: ChunkSeq[u32] = ChunkSeq::new[u32]();
    if kind == P_CTOR {
        name = u32_at(in ctx.nmap, reader.word(in bytes));
    }
    if kind == P_CTOR || kind == P_TUPLE {
        let kid_count = reader.word(in bytes);
        for i in 0..kid_count {
            if kind == P_CTOR {
                kid_names.push(u32_at(in ctx.nmap, reader.word(in bytes)));
            }
            let kid = read_pat(inout reader, in bytes, in ctx, inout pats);
            kids.push(kid);
        }
    }
    pats.add(kind, name, in kids, in kid_names)
}

// Task "patterns".
// - u types: U with is_uninhabited.
// - q cases (type, k, k pattern trees): C with whether the k arms cover
//   the type (no E0212), then I per arm with whether it is irrefutable.
pub fn core_typing_patterns(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mut reader = Reader { pos: 0 };
    let mut ctx = read_ctx(inout reader, in bytes);
    let mut pats = pats_new(inout ctx.names);
    let mut out = ChunkSeq::new[u8]();
    let type_count = reader.word(in bytes);
    for i in 0..type_count {
        let ty = u32_at(in ctx.tmap, reader.word(in bytes));
        let mut seen: ChunkSeq[u32] = ChunkSeq::new[u32]();
        put(inout out, "U");
        put_bool(inout out, is_uninhabited(inout ctx.types, in ctx.world, ty, inout seen));
        out.push(10);
    }
    let case_count = reader.word(in bytes);
    for i in 0..case_count {
        let ty = u32_at(in ctx.tmap, reader.word(in bytes));
        let arm_count = reader.word(in bytes);
        let mut arms: ChunkSeq[u32] = ChunkSeq::new[u32]();
        for j in 0..arm_count {
            let arm_pat = read_pat(inout reader, in bytes, in ctx, inout pats);
            arms.push(arm_pat);
        }
        put(inout out, "C");
        put_bool(
            inout out,
            arms_cover(inout ctx.types, inout ctx.names, in ctx.world, inout pats, in arms, ty)
        );
        out.push(10);
        for j in 0..arm_count {
            put(inout out, "I");
            let arm_pat = u32_at(in arms, j);
            put_bool(
                inout out,
                irrefutable(inout ctx.types, inout ctx.names, in ctx.world, inout pats, arm_pat, ty)
            );
            out.push(10);
        }
    }
    pack_text(in out)
}

// Expression typing: the per-span types of every supported function.
pub fn core_typing_exprs(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mut reader = Reader { pos: 0 };
    let ctx = read_ctx(inout reader, in bytes);
    let mut ck = ck_new(sink ctx);
    check_exprs(inout reader, in bytes, inout ck);
    pack_text(in ck.out)
}
