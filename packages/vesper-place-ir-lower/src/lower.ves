// `ir::lower_world` and `thread_tokens` of src/ir.rs (with the loop
// lowering of src/loops/ir.rs), statement by statement, writing
// @vesper/place-ir tables.
//
// One function is lowered at a time into working tables (blocks, and
// instructions tagged with their block, over one scratch operand pool),
// because lowering appends to blocks out of order. `flush` then threads
// the state tokens and writes the function's rows into the `Program` in
// block order. Value ids, slot names (`$slot{n}_{x}`, `$loop{n}_index`)
// and block numbers come from the same counters, in the same order, as in
// Rust, so the program is `Debug`-equal to Rust's.
//
// Every expression kind is lowered, including sequence, tiled sequence,
// vector and `Box` operations. Closures and handlers nest functions
// (`add_nested`), lowered after the world's.

use @vesper/place-ir::codes::{Lit, Op, Pat, PoolKind, Tag, Term};
use @vesper/check-data::util::{
    add, inc, n32, push_decimal, stage2_heap_mark, stage2_heap_reset, stage2_heap_swap, u32_at,
    u64_at, u8_at, w
};
use @vesper/check-data::names::{Names};
use @vesper/check-data::types::{
    Types, Vars, default_type, substitute, vars_new, TyKind, TyMode, TyPass
};
use @vesper/check-data::world::{Adt, Variant, constructor, field_step, set_by_symbol};
use @vesper/check-data::input::{Ctx, ctx_new};
use @vesper/place-ir::{BlockRow, FnRow, InstRow, PoolRow, Program, program_new};
use self::ast::{Ast, Ex, FnR, Gn, Pm, Pt, ast_empty};
use self::ops::{
    SeqRes, TiledRes, VecRes, is_seq_type, is_slice_type, resolve_seq_call, resolve_tiled,
    resolve_vector
};

const NONE32: u32 = 4294967295;
const NONE64: u64 = 18446744073709551615;
const LOW32: u64 = 4294967295;

// Expression kinds (ast.ves).
const X_FOREIGN: u8 = 0;
const X_LITERAL: u8 = 1;
const X_NAME: u8 = 2;
const X_TUPLE: u8 = 3;
const X_STRUCT: u8 = 4;
const X_FIELD: u8 = 5;
const X_INDEX: u8 = 6;
const X_UNARY: u8 = 7;
const X_BINARY: u8 = 8;
const X_ASSIGN: u8 = 9;
const X_BLOCK: u8 = 10;
const X_CALL: u8 = 11;
const X_TRY: u8 = 12;
const X_IF: u8 = 13;
const X_MATCH: u8 = 14;
const X_LOOP: u8 = 15;
const X_FOR: u8 = 16;
const X_RANGE: u8 = 17;
const X_BREAK: u8 = 18;
const X_CONTINUE: u8 = 19;
const X_RETURN: u8 = 20;
const X_CLOSURE: u8 = 21;
const X_HANDLE: u8 = 22;

// Nested function kinds (`nested_name`).
const NK_CLOSURE: u8 = 0;
const NK_BODY: u8 = 1;
const NK_CLAUSE: u8 = 2;

// Intrinsic classes (ir_lower_words.rs `I_*`).
const I_WRAPPING: u64 = 1;
const I_BIT: u64 = 2;
const I_CONVERSION: u64 = 4;
const I_ROTATE: u64 = 8;
const I_FLOAT: u64 = 16;
const I_FLOAT_NOT_UNARY: u64 = 32;

// An `if` arm: an expression, a `bool` literal (`&&` and `||`), or none.
const BR_EXPR: u8 = 0;
const BR_LIT: u8 = 1;
const BR_NONE: u8 = 2;

// A block being lowered: its one parameter (or NONE) and terminator
// (code and words sops[ta..ta+tn]).
copy struct Bk {
    param: u32,
    term: u8,
    ta: u64,
    tn: u64,
}

// An instruction being lowered: operands sops[a..a+n]. `action` and
// `read` are `state_action` and the read observation of `thread_tokens`.
copy struct In {
    block: u64,
    dest: u32,
    ty: u32,
    s0: u64,
    s1: u64,
    fallible: bool,
    action: bool,
    read: bool,
    op: u8,
    a: u64,
    n: u64,
}

// An enclosing loop (`LoopTarget`): `next` is the header a `continue`
// jumps to, or NONE in a `for`, whose `continue`s are conts[cs..].
copy struct Lp {
    exit: u64,
    value: bool,
    next: u64,
    cs: u64,
}

// An `Argument`: root is the place root symbol + 1, or 0 for none.
copy struct Arg {
    pass: u8,
    value: u32,
    root: u32,
    path: u64,
}

pub struct L {
    c: Ctx,
    a: Ast,
    p: Program,
    // Symbols the rules compare against.
    s_and: u32,
    s_or: u32,
    s_div: u32,
    s_rem: u32,
    s_shl: u32,
    s_shr: u32,
    s_eq: u32,
    s_ne: u32,
    s_lt: u32,
    s_le: u32,
    s_gt: u32,
    s_ge: u32,
    s_plus: u32,
    s_set: u32,
    s_dotdot: u32,
    s_box_new: u32,
    s_box_new_in_caller: u32,
    s_seq_subslice: u32,
    s_seq_get: u32,
    s_seq_slice_get: u32,
    s_fip_box_new: u32,
    s_fip_box_new_in_caller: u32,
    // input path id -> program path id + 1
    ppath: ChunkSeq[u64],
    // The function being lowered.
    owner: u32,
    next: u32,
    cur: u64,
    blocks: ChunkSeq[Bk],
    insts: ChunkSeq[In],
    sops: ChunkSeq[u64],
    stags: ChunkSeq[u8],
    // value id -> type, or NONE32 for a counter value that is not one
    vals: ChunkSeq[u32],
    // `names`: source symbol -> slot symbol + 1, with an undo trail of
    // (symbol << 32 | old) words for the scopes that restore it
    alias: ChunkSeq[u32],
    trail: ChunkSeq[u64],
    // `locals`: symbol -> type + 1, and the symbols in insertion order
    local_ty: ChunkSeq[u32],
    locals: ChunkSeq[u32],
    // `capabilities`: label -> effect + 1
    cap_of: ChunkSeq[u32],
    cap_set: ChunkSeq[u32],
    loops: ChunkSeq[Lp],
    conts: ChunkSeq[u64],
    skip: bool,
    // `free_names`: symbol -> binding count, and the bound symbols; a
    // foreign row seen (its names are not in the input)
    fbound: ChunkSeq[u32],
    fbt: ChunkSeq[u32],
    ffor: bool,
    // The function being lowered: params pms[fpa..fpa+fpn] (the
    // `permissions`) and generics gens[fga..fga+fgn].
    fpa: u64,
    fpn: u64,
    fga: u64,
    fgn: u64,
    pub lowered: u64,
    pub skipped: u64,
}

fn intern(inout c: Ctx, in text: Str) -> u32 {
    c.names.intern(in text.as_bytes())
}

pub fn l_new(sink ctx: Ctx, sink ast: Ast) -> L {
    let mut ctx = ctx;
    let mut program = program_new();
    // Path 0 is the empty path (an argument without a place).
    let empty: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let empty_path = program.add_path(in empty);
    L {
        s_and: intern(inout ctx, "&&"),
        s_or: intern(inout ctx, "||"),
        s_div: intern(inout ctx, "/"),
        s_rem: intern(inout ctx, "%"),
        s_shl: intern(inout ctx, "<<"),
        s_shr: intern(inout ctx, ">>"),
        s_eq: intern(inout ctx, "=="),
        s_ne: intern(inout ctx, "!="),
        s_lt: intern(inout ctx, "<"),
        s_le: intern(inout ctx, "<="),
        s_gt: intern(inout ctx, ">"),
        s_ge: intern(inout ctx, ">="),
        s_plus: intern(inout ctx, "+"),
        s_set: intern(inout ctx, "="),
        s_dotdot: intern(inout ctx, ".."),
        s_box_new: intern(inout ctx, "Box::new"),
        s_box_new_in_caller: intern(inout ctx, "Box::new_in_caller"),
        s_seq_subslice: intern(inout ctx, "SubSlice"),
        s_seq_get: intern(inout ctx, "Get"),
        s_seq_slice_get: intern(inout ctx, "SliceGet"),
        s_fip_box_new: intern(inout ctx, "BoxNew"),
        s_fip_box_new_in_caller: intern(inout ctx, "BoxNewInCaller"),
        c: ctx,
        a: ast,
        p: program,
        ppath: ChunkSeq::new[u64](),
        owner: 0,
        next: 0,
        cur: 0,
        blocks: ChunkSeq::new[Bk](),
        insts: ChunkSeq::new[In](),
        sops: ChunkSeq::new[u64](),
        stags: ChunkSeq::new[u8](),
        vals: ChunkSeq::new[u32](),
        alias: ChunkSeq::new[u32](),
        trail: ChunkSeq::new[u64](),
        local_ty: ChunkSeq::new[u32](),
        locals: ChunkSeq::new[u32](),
        cap_of: ChunkSeq::new[u32](),
        cap_set: ChunkSeq::new[u32](),
        loops: ChunkSeq::new[Lp](),
        conts: ChunkSeq::new[u64](),
        skip: false,
        fbound: ChunkSeq::new[u32](),
        fbt: ChunkSeq::new[u32](),
        ffor: false,
        fpa: 0,
        fpn: 0,
        fga: 0,
        fgn: 0,
        lowered: 0,
        skipped: 0,
    }
}

// ----- small tables -------------------------------------------------------------

fn alias_of(in l: L, sym: u32) -> u32 {
    let entry = u32_at(in l.alias, w(sym));
    if entry == 0 {
        NONE32
    } else {
        wrapping_sub(entry, 1)
    }
}

fn has_alias(in l: L, sym: u32) -> bool {
    u32_at(in l.alias, w(sym)) != 0
}

fn set_alias(inout l: L, sym: u32, slot: u32) {
    let old = u32_at(in l.alias, w(sym));
    l.trail.push(wrapping_shl_u64(w(sym), 32) | w(old));
    set_by_symbol(inout l.alias, sym, wrapping_add(slot, 1));
}

// Undoes the alias changes after trail position `mark`.
fn restore(inout l: L, mark: u64) {
    loop {
        let n = l.trail.len();
        if n <= mark {
            break;
        }
        let entry = u64_at(in l.trail, wrapping_sub(n, 1));
        set_by_symbol(inout l.alias, n32(wrapping_shr_u64(entry, 32)), n32(entry & LOW32));
        l.trail.truncate(wrapping_sub(n, 1));
    }
}

fn set_local(inout l: L, sym: u32, ty: u32) {
    if u32_at(in l.local_ty, w(sym)) == 0 {
        l.locals.push(sym);
    }
    set_by_symbol(inout l.local_ty, sym, wrapping_add(ty, 1));
}

fn local_of(in l: L, sym: u32) -> u32 {
    let entry = u32_at(in l.local_ty, w(sym));
    if entry == 0 {
        NONE32
    } else {
        wrapping_sub(entry, 1)
    }
}

fn cap_of(in l: L, label: u32) -> u32 {
    let entry = u32_at(in l.cap_of, w(label));
    if entry == 0 {
        NONE32
    } else {
        wrapping_sub(entry, 1)
    }
}

fn fresh(inout l: L) -> u32 {
    let id = l.next;
    l.next = wrapping_add(id, 1);
    l.vals.push(NONE32);
    id
}

fn set_val(inout l: L, value: u32, ty: u32) {
    let ok = l.vals.try_set(w(value), ty);
}

fn val_ty(in l: L, value: u32) -> u32 {
    match l.vals.try_get(w(value)) {
        Option::Some(ty) => ty,
        Option::None => NONE32,
    }
}

fn put(inout l: L, word: u64, tag: u8) {
    l.sops.push(word);
    l.stags.push(tag);
}

fn sop(in l: L, i: u64) -> u64 {
    u64_at(in l.sops, i)
}

fn bk(in l: L, i: u64) -> Bk {
    match l.blocks.try_get(i) {
        Option::Some(row) => row,
        Option::None => Bk { param: NONE32, term: Term::Unreachable, ta: 0, tn: 0 },
    }
}

fn new_block(inout l: L) -> u64 {
    let n = l.blocks.len();
    l.blocks.push(Bk { param: NONE32, term: Term::Unreachable, ta: 0, tn: 0 });
    n
}

fn set_param(inout l: L, block_id: u64, value: u32) {
    let mut row = bk(in l, block_id);
    row.param = value;
    let ok = l.blocks.try_set(block_id, row);
}

// Block `block_id`'s terminator is `term` with the words sops[a..].
fn set_term(inout l: L, block_id: u64, term: u8, ops_start: u64) {
    let mut row = bk(in l, block_id);
    row.term = term;
    row.ta = ops_start;
    row.tn = wrapping_sub(l.sops.len(), ops_start);
    let ok = l.blocks.try_set(block_id, row);
}

fn jump(inout l: L, from: u64, to: u64, arg: u32) {
    let ops_start = l.sops.len();
    put(inout l, to, Tag::Block);
    if arg == NONE32 {
        put(inout l, 0, Tag::Raw);
    } else {
        put(inout l, 1, Tag::Raw);
        put(inout l, w(arg), Tag::Value);
    }
    set_term(inout l, from, Term::Jump, ops_start);
}

fn branch(inout l: L, from: u64, condition: u32, yes: u64, no: u64) {
    let ops_start = l.sops.len();
    put(inout l, w(condition), Tag::Value);
    put(inout l, yes, Tag::Block);
    put(inout l, no, Tag::Block);
    set_term(inout l, from, Term::Branch, ops_start);
}

// The program path of input path `input_path` (parameter projections).
fn ppath(inout l: L, input_path: u64) -> u64 {
    let entry = u64_at(in l.ppath, input_path);
    if entry != 0 {
        return wrapping_sub(entry, 1);
    }
    let path_row = l.a.path(input_path);
    let mut syms: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for k in 0..path_row.n {
        syms.push(l.a.psym(add(path_row.a, k)));
    }
    let id = l.p.add_path(in syms);
    loop {
        if l.ppath.len() > input_path {
            break;
        }
        l.ppath.push(0);
    }
    let ok = l.ppath.try_set(input_path, inc(id));
    id
}

// ----- types --------------------------------------------------------------------

// `types.get(span)`, or `Type::Infer`.
fn span_type(in l: L, s0: u64, s1: u64) -> u32 {
    let ty = l.c.world.expr_type(s0, s1);
    if ty == NONE32 { l.c.types.infer } else { ty }
}

// `type_at`: the default type of the span's type.
fn type_at(inout l: L, s0: u64, s1: u64) -> u32 {
    let span_ty = span_type(in l, s0, s1);
    default_type(inout l.c.types, span_ty)
}

fn is_named(in l: L, ty: u32, name: u32) -> bool {
    l.c.types.kind(ty) == TyKind::Named && l.c.types.name(ty) == name
}

fn is_never(in l: L, ty: u32) -> bool {
    ty != NONE32 && is_named(in l, ty, l.c.world.k.never)
}

// `strings::is_text`: `String` or `Str` without arguments.
fn is_text(in l: L, ty: u32) -> bool {
    let known = l.c.world.k;
    ty != NONE32
        && l.c.types.arity(ty) == 0
        && (is_named(in l, ty, known.string) || is_named(in l, ty, known.str_))
}

fn bool_type(inout l: L) -> u32 {
    let bool_sym = l.c.world.k.bool_;
    l.c.types.named0(bool_sym)
}

// `World::field(ty, path)` over program path `path`, or NONE32.
fn field_type(inout l: L, root_ty: u32, path: u64) -> u32 {
    let path_row = l.p.path(path);
    let mut ty = root_ty;
    for k in 0..path_row.n {
        let name = l.p.path_name(path, k);
        let seg = l.c.names.size(name) > 0 && l.c.names.byte(name, 0) == 91;
        ty = field_step(inout l.c.types, inout l.c.names, in l.c.world, ty, name, seg);
        if ty == NONE32 {
            return NONE32;
        }
    }
    ty
}

// ----- names ----------------------------------------------------------------------

fn name_bytes(in l: L, sym: u32, inout out: ChunkSeq[u8]) {
    l.c.names.write(sym, inout out);
}

// The symbol spelled `bytes`, interned.
fn intern_bytes(inout l: L, in bytes: ChunkSeq[u8]) -> u32 {
    l.c.names.intern(in bytes.as_slice())
}

// `World::constructor(name)`: (adt << 32 | variant), or NONE.
fn ctor_of(inout l: L, sym: u32) -> u64 {
    let size = l.c.names.size(sym);
    let mut count: u64 = 0;
    let mut at: u64 = 0;
    let mut i: u64 = 0;
    loop {
        if inc(i) >= size {
            break;
        }
        if l.c.names.byte(sym, i) == 58 && l.c.names.byte(sym, inc(i)) == 58 {
            count = inc(count);
            at = i;
            i = add(i, 2);
        } else {
            i = inc(i);
        }
    }
    if count > 1 {
        return NONE64;
    }
    if count == 0 {
        return constructor(in l.c.world, NONE32, sym);
    }
    let mut qual_bytes: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut short_bytes: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for j in 0..size {
        let byte = l.c.names.byte(sym, j);
        if j < at {
            qual_bytes.push(byte);
        } else if j >= add(at, 2) {
            short_bytes.push(byte);
        }
    }
    let qual = l.c.names.lookup(in qual_bytes.as_slice());
    let short = l.c.names.lookup(in short_bytes.as_slice());
    if qual == NONE32 || short == NONE32 {
        return NONE64;
    }
    constructor(in l.c.world, qual, short)
}

fn is_fn(in l: L, sym: u32) -> bool {
    l.a.fn_index(sym) != NONE64
}

// ----- emitting -------------------------------------------------------------------

fn state_action(in l: L, op: u8, ops_start: u64, fallible: bool) -> bool {
    if op == Op::Bind
        || op == Op::Write
        || op == Op::Call
        || op == Op::Indirect
        || op == Op::Try
        || op == Op::Handle
        || op == Op::Closure
        || op == Op::Index
        || op == Op::Tiled
        || op == Op::Seq
        || op == Op::Fip
        || op == Op::Exit
        || fallible {
        return true;
    }
    if op == Op::Binary {
        let op_sym = n32(sop(in l, ops_start));
        return op_sym == l.s_div || op_sym == l.s_rem || op_sym == l.s_shl || op_sym == l.s_shr;
    }
    false
}

fn push_inst(inout l: L, op: u8, ops_start: u64, s0: u64, s1: u64, ty: u32, fallible: bool) -> u32 {
    let dest = fresh(inout l);
    set_val(inout l, dest, ty);
    let action = state_action(in l, op, ops_start, fallible);
    let inst = In {
        block: l.cur,
        dest: dest,
        ty: ty,
        s0: s0,
        s1: s1,
        fallible: fallible,
        action: action,
        read: op == Op::Read,
        op: op,
        a: ops_start,
        n: wrapping_sub(l.sops.len(), ops_start)
    };
    l.insts.push(inst);
    dest
}

// `Lower::emit`: operands are sops[a..].
fn emit(inout l: L, op: u8, ops_start: u64, s0: u64, s1: u64) -> u32 {
    let infer = l.c.types.infer;
    let mut ty = type_at(inout l, s0, s1);
    if ty == infer && op == Op::Read {
        let root_ty = local_of(in l, n32(sop(in l, ops_start)));
        if root_ty != NONE32 {
            let field_ty = field_type(inout l, root_ty, sop(in l, inc(ops_start)));
            if field_ty != NONE32 {
                ty = default_type(inout l.c.types, field_ty);
            }
        }
    }
    if op == Op::Bind || op == Op::Write || op == Op::Loop {
        ty = l.c.types.unit;
    }
    let fallible = (
        op == Op::Binary || op == Op::Unary || op == Op::Write || op == Op::Index || op == Op::Seq
    )
        && (l.c.world.is_partial(s0, s1) || l.c.world.may_overflow(s0, s1));
    push_inst(inout l, op, ops_start, s0, s1, ty, fallible)
}

// `emit_at` of the loop lowering: the given type, never fallible.
fn emit_at(inout l: L, op: u8, ops_start: u64, s0: u64, s1: u64, ty: u32) -> u32 {
    push_inst(inout l, op, ops_start, s0, s1, ty, false)
}

fn unit(inout l: L, s0: u64, s1: u64) -> u32 {
    let ops_start = l.sops.len();
    emit(inout l, Op::Unit, ops_start, s0, s1)
}

fn put_literal(inout l: L, kind: u64, lo: u64, hi: u64) {
    put(inout l, kind, Tag::Raw);
    if kind == Lit::String {
        put(inout l, lo, Tag::Name);
    } else {
        put(inout l, lo, Tag::Raw);
    }
    put(inout l, hi, Tag::Raw);
}

fn read_paths(
    inout l: L,
    root: u32,
    path: u64,
    pass: u8,
    in proj_paths: ChunkSeq[u64],
    s0: u64,
    s1: u64
) -> u32 {
    let ops_start = l.sops.len();
    put(inout l, w(root), Tag::Name);
    put(inout l, path, Tag::Path);
    put(inout l, widen_u64(pass), Tag::Raw);
    let qn = proj_paths.len();
    put(inout l, qn, Tag::Raw);
    for i in 0..qn {
        put(inout l, u64_at(in proj_paths, i), Tag::Path);
    }
    emit(inout l, Op::Read, ops_start, s0, s1)
}

// A `Read` of root `root` and program path `path`; projections are input
// path ids projs[qa..qa+qn].
fn read(inout l: L, root: u32, path: u64, pass: u8, qa: u64, qn: u64, s0: u64, s1: u64) -> u32 {
    let mut proj_paths: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for i in 0..qn {
        let input_path = l.a.proj(add(qa, i));
        let id = ppath(inout l, input_path);
        proj_paths.push(id);
    }
    read_paths(inout l, root, path, pass, in proj_paths, s0, s1)
}

fn pool_entry(inout l: L, kind: u64, label: u32) -> u64 {
    let n = l.p.pool.len();
    for i in l.a.pool_count..n {
        let row = l.p.pool_row(i);
        if row.kind == kind && row.label == label {
            return i;
        }
    }
    l.p.pool.push(PoolRow { kind: kind, label: label });
    n
}

fn emit_pool_args(
    inout l: L,
    op: u8,
    kind: u64,
    label: u32,
    in args: ChunkSeq[Arg],
    s0: u64,
    s1: u64
) -> u32 {
    let pool_id = pool_entry(inout l, kind, label);
    let ops_start = l.sops.len();
    put(inout l, pool_id, Tag::Pool);
    put_args(inout l, in args);
    emit(inout l, op, ops_start, s0, s1)
}

// ----- patterns -------------------------------------------------------------------

fn slot_name(inout l: L, in prefix: Str, number: u32, src: u32, in suffix: Str) -> u32 {
    let mut bytes: ChunkSeq[u8] = ChunkSeq::new[u8]();
    bytes.extend(in prefix.as_bytes());
    push_decimal(inout bytes, w(number));
    if src != NONE32 {
        bytes.push(95);
        name_bytes(in l, src, inout bytes);
    }
    bytes.extend(in suffix.as_bytes());
    intern_bytes(inout l, in bytes)
}

// The words of pattern `pid`; with `rename`, `rename_pattern` at type
// `ty` (bindings get fresh slots, recorded in `names` and `locals`).
fn pattern(inout l: L, pid: u64, ty: u32, rename: bool) {
    let pat = l.a.pt(pid);
    put(inout l, widen_u64(pat.kind), Tag::Raw);
    put(inout l, pat.s0, Tag::Raw);
    put(inout l, pat.s1, Tag::Raw);
    if pat.kind == Pat::Bind {
        let src = n32(pat.a);
        if rename {
            let slot_id = fresh(inout l);
            let unique = slot_name(inout l, "$slot", slot_id, src, "");
            set_alias(inout l, src, unique);
            let slot_ty = default_type(inout l.c.types, ty);
            set_local(inout l, unique, slot_ty);
            put(inout l, w(unique), Tag::Name);
        } else {
            put(inout l, pat.a, Tag::Name);
        }
    } else if pat.kind == Pat::Literal {
        put_literal(inout l, pat.a, pat.b, pat.c);
    } else if pat.kind == Pat::Tuple {
        put(inout l, pat.n, Tag::Raw);
        let tuple = rename && l.c.types.kind(ty) == TyKind::Tuple;
        let ty_arity = if tuple { l.c.types.arity(ty) } else { 0 };
        for i in 0..pat.n {
            let kid = l.a.px(add(pat.b, i));
            if i < ty_arity {
                let elem_ty = l.c.types.arg(ty, i);
                pattern(inout l, kid, elem_ty, true);
            } else {
                pattern(inout l, kid, 0, false);
            }
        }
    } else if pat.kind == Pat::Constructor {
        put(inout l, pat.a, Tag::Name);
        put(inout l, pat.c, Tag::Raw);
        put(inout l, pat.n, Tag::Raw);
        let mut ctor = NONE64;
        if rename {
            ctor = ctor_of(inout l, n32(pat.a));
        }
        if ctor == NONE64 {
            for i in 0..pat.n {
                put(inout l, l.a.px(add(pat.b, wrapping_mul(i, 2))), Tag::Name);
                pattern(inout l, l.a.px(add(pat.b, inc(wrapping_mul(i, 2)))), 0, false);
            }
            return;
        }
        let adt = l.c.world.adt(n32(wrapping_shr_u64(ctor, 32)));
        let variant = l.c.world.variant(ctor & LOW32);
        let vars = if l.c.types.kind(ty) == TyKind::Named {
            l.c.world.vars_of(in l.c.types, adt, ty)
        } else {
            vars_new()
        };
        for i in 0..pat.n {
            let field = n32(l.a.px(add(pat.b, wrapping_mul(i, 2))));
            let kid = l.a.px(add(pat.b, inc(wrapping_mul(i, 2))));
            put(inout l, w(field), Tag::Name);
            let field_index = l.c.world.find_field(variant, field);
            if field_index == NONE32 {
                pattern(inout l, kid, 0, false);
            } else {
                let fty = l.c.world.field(w(field_index)).ty;
                let field_ty = substitute(inout l.c.types, fty, in vars);
                pattern(inout l, kid, field_ty, true);
            }
        }
    }
}

// ----- places and arguments ---------------------------------------------------------

// `Place::from_expr(e)` with its root renamed: the root slot (NONE32 when
// `e` is not a place or its root is not a local), and the field path in
// `path`.
fn place(in l: L, id: u64, inout path: ChunkSeq[u32]) -> u32 {
    let mut fields: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut at = id;
    loop {
        let e = l.a.ex(at);
        if e.kind == X_FIELD {
            fields.push(n32(e.b));
            at = e.a;
        } else if e.kind == X_NAME {
            let root = alias_of(in l, n32(e.a));
            if root == NONE32 {
                return NONE32;
            }
            let n = fields.len();
            for i in 0..n {
                path.push(u32_at(in fields, wrapping_sub(wrapping_sub(n, 1), i)));
            }
            return root;
        } else {
            return NONE32;
        }
    }
}

fn argument_with(inout l: L, id: u64, pass: u8, qa: u64, qn: u64, proj_field: u32) -> Arg {
    let mut syms: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let root = place(in l, id, inout syms);
    if root != NONE32 {
        let path = l.p.add_path(in syms);
        let e = l.a.ex(id);
        let value = if proj_field != NONE32 {
            let mut single: ChunkSeq[u32] = ChunkSeq::new[u32]();
            single.push(proj_field);
            let mut proj_paths: ChunkSeq[u64] = ChunkSeq::new[u64]();
            proj_paths.push(l.p.add_path(in single));
            read_paths(inout l, root, path, pass, in proj_paths, e.s0, e.s1)
        } else {
            read(inout l, root, path, pass, qa, qn, e.s0, e.s1)
        };
        return Arg { pass: pass, value: value, root: wrapping_add(root, 1), path: path };
    }
    let value = expr(inout l, id);
    Arg { pass: pass, value: value, root: 0, path: 0 }
}

// `Lower::argument`.
fn argument(inout l: L, id: u64, pass: u8, qa: u64, qn: u64) -> Arg {
    argument_with(inout l, id, pass, qa, qn, NONE32)
}

fn argument_proj(inout l: L, id: u64, pass: u8, proj_field: u32) -> Arg {
    argument_with(inout l, id, pass, 0, 0, proj_field)
}

fn put_args(inout l: L, in args: ChunkSeq[Arg]) {
    put(inout l, args.len(), Tag::Raw);
    for i in 0..args.len() {
        match args.try_get(i) {
            Option::Some(arg) => {
                put(inout l, widen_u64(arg.pass), Tag::Raw);
                put(inout l, w(arg.value), Tag::Value);
                put(inout l, w(arg.root), Tag::OptName);
                put(inout l, arg.path, Tag::Path);
            },
            Option::None => {},
        }
    }
}

// ----- expressions ------------------------------------------------------------------

// `Lower::expr`.
pub fn expr(inout l: L, id: u64) -> u32 {
    let e = l.a.ex(id);
    let kind = e.kind;
    if kind == X_CLOSURE {
        return closure(inout l, e);
    }
    if kind == X_HANDLE {
        return handler(inout l, e);
    }
    if kind == X_FOREIGN {
        l.skip = true;
        return unit(inout l, e.s0, e.s1);
    }
    if kind == X_LITERAL {
        let ops_start = l.sops.len();
        put_literal(inout l, e.a, e.b, e.c);
        return emit(inout l, Op::Const, ops_start, e.s0, e.s1);
    }
    if kind == X_NAME {
        let name_sym = n32(e.a);
        if !has_alias(in l, name_sym) && ctor_of(inout l, name_sym) != NONE64 {
            let ops_start = l.sops.len();
            put(inout l, e.a, Tag::Name);
            put(inout l, 0, Tag::Raw);
            return emit(inout l, Op::Data, ops_start, e.s0, e.s1);
        }
        let mut root = alias_of(in l, name_sym);
        if root == NONE32 {
            root = name_sym;
        }
        return read(inout l, root, 0, TyPass::Sink, 0, 0, e.s0, e.s1);
    }
    if kind == X_TUPLE {
        let mut values: ChunkSeq[u32] = ChunkSeq::new[u32]();
        for i in 0..e.n {
            let value = expr(inout l, l.a.x(add(e.a, i)));
            values.push(value);
        }
        let ops_start = l.sops.len();
        put(inout l, e.n, Tag::Raw);
        for i in 0..e.n {
            put(inout l, w(u32_at(in values, i)), Tag::Value);
        }
        return emit(inout l, Op::Tuple, ops_start, e.s0, e.s1);
    }
    if kind == X_STRUCT {
        let mut values: ChunkSeq[u32] = ChunkSeq::new[u32]();
        for i in 0..e.n {
            let value = expr(inout l, l.a.x(add(e.b, inc(wrapping_mul(i, 2)))));
            values.push(value);
        }
        let ops_start = l.sops.len();
        put(inout l, e.a, Tag::Name);
        put(inout l, e.n, Tag::Raw);
        for i in 0..e.n {
            put(inout l, l.a.x(add(e.b, wrapping_mul(i, 2))), Tag::Name);
            put(inout l, w(u32_at(in values, i)), Tag::Value);
        }
        return emit(inout l, Op::Data, ops_start, e.s0, e.s1);
    }
    if kind == X_FIELD {
        let mut syms: ChunkSeq[u32] = ChunkSeq::new[u32]();
        let root = place(in l, id, inout syms);
        if root != NONE32 {
            let path = l.p.add_path(in syms);
            return read(inout l, root, path, TyPass::Sink, 0, 0, e.s0, e.s1);
        }
        let value = expr(inout l, e.a);
        let ops_start = l.sops.len();
        put(inout l, w(value), Tag::Value);
        put(inout l, e.b, Tag::Name);
        return emit(inout l, Op::Project, ops_start, e.s0, e.s1);
    }
    if kind == X_INDEX {
        let idx = l.a.ex(e.b);
        if idx.kind == X_BINARY && n32(idx.a) == l.s_dotdot {
            let mut args: ChunkSeq[Arg] = ChunkSeq::new[Arg]();
            args.push(argument(inout l, e.a, TyPass::In, 0, 0));
            args.push(argument(inout l, idx.b, TyPass::Sink, 0, 0));
            args.push(argument(inout l, idx.c, TyPass::Sink, 0, 0));
            return emit_pool_args(
                inout l,
                Op::Seq,
                PoolKind::MakeSeq,
                l.s_seq_subslice,
                in args,
                e.s0,
                e.s1
            );
        }
        let target = l.a.ex(e.a);
        let target_ty = span_type(in l, target.s0, target.s1);
        if is_seq_type(in l.c, target_ty) || is_slice_type(in l.c, target_ty) {
            let label = if is_seq_type(in l.c, target_ty) {
                l.s_seq_get
            } else {
                l.s_seq_slice_get
            };
            let mut args: ChunkSeq[Arg] = ChunkSeq::new[Arg]();
            args.push(argument(inout l, e.a, TyPass::In, 0, 0));
            args.push(argument(inout l, e.b, TyPass::Sink, 0, 0));
            return emit_pool_args(inout l, Op::Seq, PoolKind::MakeSeq, label, in args, e.s0, e.s1);
        }
        let base_value = expr(inout l, e.a);
        let index_value = expr(inout l, e.b);
        let ops_start = l.sops.len();
        put(inout l, w(base_value), Tag::Value);
        put(inout l, w(index_value), Tag::Value);
        return emit(inout l, Op::Index, ops_start, e.s0, e.s1);
    }
    if kind == X_UNARY {
        let value = expr(inout l, e.b);
        let ops_start = l.sops.len();
        put(inout l, e.a, Tag::Name);
        put(inout l, w(value), Tag::Value);
        return emit(inout l, Op::Unary, ops_start, e.s0, e.s1);
    }
    if kind == X_BINARY {
        let op = n32(e.a);
        if op == l.s_and {
            return lower_if(inout l, e.b, BR_EXPR, e.c, BR_LIT, 0, e.s0, e.s1);
        }
        if op == l.s_or {
            return lower_if(inout l, e.b, BR_LIT, 1, BR_EXPR, e.c, e.s0, e.s1);
        }
        let lhs = operand(inout l, op, e.b);
        let rhs = operand(inout l, op, e.c);
        let ops_start = l.sops.len();
        put(inout l, e.a, Tag::Name);
        put(inout l, w(lhs), Tag::Value);
        put(inout l, w(rhs), Tag::Value);
        return emit(inout l, Op::Binary, ops_start, e.s0, e.s1);
    }
    if kind == X_ASSIGN {
        let value = expr(inout l, e.c);
        let mut syms: ChunkSeq[u32] = ChunkSeq::new[u32]();
        let root = place(in l, e.b, inout syms);
        let mut text: ChunkSeq[u8] = ChunkSeq::new[u8]();
        if root != NONE32 {
            name_bytes(in l, root, inout text);
            for i in 0..syms.len() {
                text.push(46);
                name_bytes(in l, u32_at(in syms, i), inout text);
            }
        }
        let display = intern_bytes(inout l, in text);
        let ops_start = l.sops.len();
        put(inout l, w(display), Tag::Name);
        put(inout l, e.a, Tag::Name);
        put(inout l, w(value), Tag::Value);
        return emit(inout l, Op::Write, ops_start, e.s0, e.s1);
    }
    if kind == X_BLOCK {
        return block(inout l, e);
    }
    if kind == X_CALL {
        return call(inout l, e);
    }
    if kind == X_TRY {
        let value = expr(inout l, e.a);
        let ops_start = l.sops.len();
        put(inout l, w(value), Tag::Value);
        return emit(inout l, Op::Try, ops_start, e.s0, e.s1);
    }
    if kind == X_IF {
        if e.c == NONE64 {
            return lower_if(inout l, e.a, BR_EXPR, e.b, BR_NONE, 0, e.s0, e.s1);
        }
        return lower_if(inout l, e.a, BR_EXPR, e.b, BR_EXPR, e.c, e.s0, e.s1);
    }
    if kind == X_MATCH {
        return lower_match(inout l, e);
    }
    control(inout l, e)
}

// A binary operand: string comparisons borrow their operands (§13).
fn operand(inout l: L, op: u32, id: u64) -> u32 {
    let comparison = op == l.s_eq
        || op == l.s_ne
        || op == l.s_lt
        || op == l.s_le
        || op == l.s_gt
        || op == l.s_ge;
    if comparison {
        let operand_ex = l.a.ex(id);
        let ty = l.c.world.expr_type(operand_ex.s0, operand_ex.s1);
        if is_text(in l, ty) {
            return argument(inout l, id, TyPass::In, 0, 0).value;
        }
    }
    expr(inout l, id)
}

fn arm(inout l: L, kind: u8, payload: u64, s0: u64, s1: u64) -> u32 {
    if kind == BR_EXPR {
        return expr(inout l, payload);
    }
    if kind == BR_LIT {
        let ops_start = l.sops.len();
        put_literal(inout l, Lit::Bool, payload, 0);
        return emit(inout l, Op::Const, ops_start, s0, s1);
    }
    unit(inout l, s0, s1)
}

// `ExprKind::If` (and `&&`, `||` as an `if` with a literal arm).
fn lower_if(
    inout l: L,
    cond: u64,
    then_kind: u8,
    then_arm: u64,
    else_kind: u8,
    else_arm: u64,
    s0: u64,
    s1: u64
) -> u32 {
    let condition = expr(inout l, cond);
    let yes = new_block(inout l);
    let no = new_block(inout l);
    let join = new_block(inout l);
    let output = fresh(inout l);
    let out_ty = type_at(inout l, s0, s1);
    set_val(inout l, output, out_ty);
    set_param(inout l, join, output);
    branch(inout l, l.cur, condition, yes, no);
    l.cur = yes;
    let then_value = arm(inout l, then_kind, then_arm, s0, s1);
    jump(inout l, l.cur, join, then_value);
    l.cur = no;
    let else_value = arm(inout l, else_kind, else_arm, s0, s1);
    jump(inout l, l.cur, join, else_value);
    l.cur = join;
    output
}

fn lower_match(inout l: L, e: Ex) -> u32 {
    let value = expr(inout l, e.a);
    let join = new_block(inout l);
    let out = fresh(inout l);
    let out_ty = type_at(inout l, e.s0, e.s1);
    set_val(inout l, out, out_ty);
    set_param(inout l, join, out);
    let first = l.blocks.len();
    for i in 0..e.n {
        let arm_block = new_block(inout l);
    }
    let ops_start = l.sops.len();
    put(inout l, w(value), Tag::Value);
    put(inout l, e.n, Tag::Raw);
    for i in 0..e.n {
        pattern(inout l, l.a.x(add(e.b, wrapping_mul(i, 2))), 0, false);
        put(inout l, add(first, i), Tag::Block);
    }
    set_term(inout l, l.cur, Term::Match, ops_start);
    // Every arm's `Bind` has the first arm body's span.
    let body0 = l.a.ex(l.a.x(inc(e.b)));
    let mark = l.trail.len();
    let value_ty = val_ty(in l, value);
    for i in 0..e.n {
        l.cur = add(first, i);
        restore(inout l, mark);
        let bind_start = l.sops.len();
        put(inout l, w(value), Tag::Value);
        pattern(inout l, l.a.x(add(e.b, wrapping_mul(i, 2))), value_ty, true);
        let bind = emit(inout l, Op::Bind, bind_start, body0.s0, body0.s1);
        let arm_value = expr(inout l, l.a.x(add(e.b, inc(wrapping_mul(i, 2)))));
        jump(inout l, l.cur, join, arm_value);
    }
    l.cur = join;
    restore(inout l, mark);
    out
}

fn block(inout l: L, e: Ex) -> u32 {
    let mark = l.trail.len();
    for i in 0..e.n {
        let at = add(e.a, wrapping_mul(i, 3));
        let is_let = l.a.x(at) == 1;
        let stmt_id = l.a.x(add(at, 2));
        if is_let {
            let stmt_value = expr(inout l, stmt_id);
            let stmt_ty = val_ty(in l, stmt_value);
            let ops_start = l.sops.len();
            put(inout l, w(stmt_value), Tag::Value);
            pattern(inout l, l.a.x(inc(at)), stmt_ty, true);
            let stmt_ex = l.a.ex(stmt_id);
            let bind = emit(inout l, Op::Bind, ops_start, stmt_ex.s0, stmt_ex.s1);
        } else {
            let stmt_value = expr(inout l, stmt_id);
            let stmt_ex = l.a.ex(stmt_id);
            if is_never(in l, l.c.world.expr_type(stmt_ex.s0, stmt_ex.s1)) {
                restore(inout l, mark);
                return unit(inout l, e.s0, e.s1);
            }
        }
    }
    let value = if e.b == NONE64 {
        unit(inout l, e.s0, e.s1)
    } else {
        expr(inout l, e.b)
    };
    restore(inout l, mark);
    value
}

fn binary_call(inout l: L, e: Ex, op: u32) -> u32 {
    let lhs = expr(inout l, l.a.x(inc(e.b)));
    let rhs = expr(inout l, l.a.x(add(e.b, 3)));
    let ops_start = l.sops.len();
    put(inout l, w(op), Tag::Name);
    put(inout l, w(lhs), Tag::Value);
    put(inout l, w(rhs), Tag::Value);
    emit(inout l, Op::Binary, ops_start, e.s0, e.s1)
}

fn unary_call(inout l: L, e: Ex, op: u32) -> u32 {
    let arg_value = expr(inout l, l.a.x(inc(e.b)));
    let ops_start = l.sops.len();
    put(inout l, w(op), Tag::Name);
    put(inout l, w(arg_value), Tag::Value);
    emit(inout l, Op::Unary, ops_start, e.s0, e.s1)
}

// "{a}::{b}" of two symbols' spellings, as bytes.
fn path_text(in l: L, qual: u32, member: u32, inout out: ChunkSeq[u8]) {
    name_bytes(in l, qual, inout out);
    out.push(58);
    out.push(58);
    name_bytes(in l, member, inout out);
}

// The parameters (pms range) of the callee `name`: a world function's,
// or an effect operation's (`Effect::op`); (start, count).
fn callee_params(inout l: L, name: u32) -> u64 {
    let fi = l.a.fn_index(name);
    if fi != NONE64 {
        let func = l.a.function(fi);
        return wrapping_shl_u64(func.pa, 32) | func.pn;
    }
    // split_once("::")
    let size = l.c.names.size(name);
    let mut at = NONE64;
    let mut i: u64 = 0;
    loop {
        if inc(i) >= size {
            break;
        }
        if l.c.names.byte(name, i) == 58 && l.c.names.byte(name, inc(i)) == 58 {
            at = i;
            break;
        }
        i = inc(i);
    }
    if at == NONE64 {
        return 0;
    }
    let mut qual_bytes: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut op_bytes: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for j in 0..size {
        let byte = l.c.names.byte(name, j);
        if j < at {
            qual_bytes.push(byte);
        } else if j >= add(at, 2) {
            op_bytes.push(byte);
        }
    }
    let eff_index = l.a.effect_index(l.c.names.lookup(in qual_bytes.as_slice()));
    let op = l.c.names.lookup(in op_bytes.as_slice());
    if eff_index == NONE64 || op == NONE32 {
        return 0;
    }
    let eff_decl = l.a.effect_decl(eff_index);
    for j in 0..eff_decl.on {
        let op_sig = l.a.eop(add(eff_decl.oa, j));
        if op_sig.name == op {
            return wrapping_shl_u64(op_sig.pa, 32) | op_sig.pn;
        }
    }
    0
}

fn seq_arg_pass(mode: u8, i: u64) -> u8 {
    if mode == 1 {
        TyPass::In
    } else if mode == 2 {
        TyPass::Inout
    } else if mode == 3 && i == 0 {
        TyPass::Inout
    } else if mode == 4 && i == 0 {
        TyPass::In
    } else if mode == 5 && i == 1 {
        TyPass::In
    } else {
        TyPass::Sink
    }
}

fn lower_seq_call(inout l: L, e: Ex, recv_id: u64, seq: SeqRes) -> u32 {
    let mut args: ChunkSeq[Arg] = ChunkSeq::new[Arg]();
    if seq.has_recv {
        args.push(argument(inout l, recv_id, seq.recv_pass, 0, 0));
    }
    for i in 0..e.n {
        let arg_id = l.a.x(add(e.b, inc(wrapping_mul(i, 2))));
        let pass = seq_arg_pass(seq.arg_mode, i);
        args.push(argument(inout l, arg_id, pass, 0, 0));
    }
    emit_pool_args(inout l, Op::Seq, PoolKind::MakeSeq, seq.label, in args, e.s0, e.s1)
}

fn lower_tiled_call(inout l: L, e: Ex, receiver: u64, tiled_res: TiledRes) -> u32 {
    let mut args: ChunkSeq[Arg] = ChunkSeq::new[Arg]();
    if receiver != NONE64 && tiled_res.is_recv_first {
        args.push(argument_proj(inout l, receiver, tiled_res.recv_pass, tiled_res.recv_proj));
    }
    let start: u64 = if tiled_res.skip_first { 1 } else { 0 };
    for i in start..e.n {
        let arg_id = l.a.x(add(e.b, inc(wrapping_mul(i, 2))));
        if receiver == NONE64 && tiled_res.is_recv_first && i == 0 {
            args.push(argument_proj(inout l, arg_id, tiled_res.recv_pass, tiled_res.recv_proj));
        } else {
            args.push(argument(inout l, arg_id, TyPass::Sink, 0, 0));
        }
    }
    let pool_id = pool_entry(inout l, PoolKind::MakeTiled, tiled_res.label);
    let ops_start = l.sops.len();
    put(inout l, pool_id, Tag::Pool);
    put_args(inout l, in args);
    put(inout l, w(tiled_res.cap), Tag::OptName);
    emit(inout l, Op::Tiled, ops_start, e.s0, e.s1)
}

fn lower_vector_call(inout l: L, e: Ex, vector_res: VecRes) -> u32 {
    let mut vals: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..e.n {
        if vector_res.const_lo < vector_res.const_hi
            && i >= vector_res.const_lo
            && i < vector_res.const_hi {
            continue;
        }
        let arg_id = l.a.x(add(e.b, inc(wrapping_mul(i, 2))));
        let arg_ex = l.a.ex(arg_id);
        let arg_ty = span_type(in l, arg_ex.s0, arg_ex.s1);
        let value = if arg_ty != NONE32 && l.c.types.name(arg_ty) == l.c.world.k.string {
            argument(inout l, arg_id, TyPass::In, 0, 0).value
        } else {
            expr(inout l, arg_id)
        };
        vals.push(value);
    }
    let pool_id = pool_entry(inout l, PoolKind::MakeVector, vector_res.label);
    let ops_start = l.sops.len();
    put(inout l, pool_id, Tag::Pool);
    put(inout l, vals.len(), Tag::Raw);
    for i in 0..vals.len() {
        put(inout l, w(u32_at(in vals, i)), Tag::Value);
    }
    emit(inout l, Op::Vector, ops_start, e.s0, e.s1)
}

fn call(inout l: L, e: Ex) -> u32 {
    let callee = l.a.ex(e.a);
    let local_alias = callee.kind == X_NAME && has_alias(in l, n32(callee.a));
    let seq = resolve_seq_call(inout l.c, in l.a, e, callee, local_alias);
    if seq.matched {
        return lower_seq_call(inout l, e, callee.a, seq);
    }
    let mut receiver = NONE64;
    let mut capability: u32 = 0;
    let mut name = NONE32;
    if callee.kind == X_NAME && !has_alias(in l, n32(callee.a)) {
        name = n32(callee.a);
    } else if callee.kind == X_FIELD {
        let base = l.a.ex(callee.a);
        let method = n32(callee.b);
        let base_ty = span_type(in l, base.s0, base.s1);
        let tname = l.c.types.name(base_ty);
        let mut text: ChunkSeq[u8] = ChunkSeq::new[u8]();
        path_text(in l, tname, method, inout text);
        let tiled = is_named(in l, base_ty, l.c.world.k.tiled_seq)
            && (l.c.types.arity(base_ty) == 1 || l.c.types.arity(base_ty) == 2);
        let qualified = l.c.names.lookup(in text.as_slice());
        if tiled || (qualified != NONE32 && is_fn(in l, qualified)) {
            receiver = callee.a;
            name = intern_bytes(inout l, in text);
        } else if base.kind == X_NAME && cap_of(in l, n32(base.a)) != NONE32 {
            capability = wrapping_add(n32(base.a), 1);
            let eff = cap_of(in l, n32(base.a));
            let mut eff_text: ChunkSeq[u8] = ChunkSeq::new[u8]();
            path_text(in l, eff, method, inout eff_text);
            name = intern_bytes(inout l, in eff_text);
        }
    }
    if name == NONE32 {
        return indirect(inout l, e, callee);
    }
    let tiled_res = resolve_tiled(inout l.c, in l.a, e, name, receiver);
    if tiled_res.matched {
        return lower_tiled_call(inout l, e, receiver, tiled_res);
    }
    let known = is_fn(in l, name);
    let class = e.x;
    if receiver == NONE64 && !known {
        let vector_res = resolve_vector(inout l.c, in l.a, e, name);
        if vector_res.matched {
            return lower_vector_call(inout l, e, vector_res);
        }
        if (class & I_WRAPPING) != 0 && e.n == 2 {
            return binary_call(inout l, e, name);
        }
        if (class & I_BIT) != 0 && e.n == 2 {
            return binary_call(inout l, e, name);
        }
        if (class & I_CONVERSION) != 0 && e.n == 1 {
            return unary_call(inout l, e, name);
        }
        if (class & I_ROTATE) != 0 && e.n == 2 {
            return binary_call(inout l, e, name);
        }
        if (class & I_FLOAT) != 0 {
            let unary = (class & I_FLOAT_NOT_UNARY) == 0;
            if unary && e.n == 1 {
                return unary_call(inout l, e, name);
            }
            if e.n == 2 {
                return binary_call(inout l, e, name);
            }
        }
    }
    if receiver == NONE64
        && l.c.world.box_active
        && (name == l.s_box_new || name == l.s_box_new_in_caller)
        && e.n == 1 {
        let fip_label = if name == l.s_box_new {
            l.s_fip_box_new
        } else {
            l.s_fip_box_new_in_caller
        };
        let mut args: ChunkSeq[Arg] = ChunkSeq::new[Arg]();
        args.push(argument(inout l, l.a.x(inc(e.b)), TyPass::Sink, 0, 0));
        return emit_pool_args(inout l, Op::Fip, PoolKind::MakeFip, fip_label, in args, e.s0, e.s1);
    }
    if ctor_of(inout l, name) != NONE64 {
        let mut values: ChunkSeq[u32] = ChunkSeq::new[u32]();
        for i in 0..e.n {
            let value = expr(inout l, l.a.x(add(e.b, inc(wrapping_mul(i, 2)))));
            values.push(value);
        }
        let mut fields: ChunkSeq[u32] = ChunkSeq::new[u32]();
        for i in 0..e.n {
            let mut digits: ChunkSeq[u8] = ChunkSeq::new[u8]();
            push_decimal(inout digits, i);
            let field_sym = intern_bytes(inout l, in digits);
            fields.push(field_sym);
        }
        let ops_start = l.sops.len();
        put(inout l, w(name), Tag::Name);
        put(inout l, e.n, Tag::Raw);
        for i in 0..e.n {
            put(inout l, w(u32_at(in fields, i)), Tag::Name);
            put(inout l, w(u32_at(in values, i)), Tag::Value);
        }
        return emit(inout l, Op::Data, ops_start, e.s0, e.s1);
    }
    let range = callee_params(inout l, name);
    let pa = wrapping_shr_u64(range, 32);
    let pn = range & LOW32;
    let mut args: ChunkSeq[Arg] = ChunkSeq::new[Arg]();
    let mut i: u64 = 0;
    if receiver != NONE64 {
        let arg = param_argument(inout l, receiver, pa, pn, 0);
        args.push(arg);
        i = 1;
    }
    for j in 0..e.n {
        let arg = param_argument(inout l, l.a.x(add(e.b, inc(wrapping_mul(j, 2)))), pa, pn, i);
        args.push(arg);
        i = inc(i);
    }
    let ops_start = l.sops.len();
    put(inout l, w(name), Tag::Name);
    put_args(inout l, in args);
    put(inout l, e.m, Tag::Raw);
    for j in 0..e.m {
        put(inout l, l.a.x(add(e.c, j)), Tag::Type);
    }
    put(inout l, w(capability), Tag::OptName);
    emit(inout l, Op::Call, ops_start, e.s0, e.s1)
}

// Argument `i` of a call whose callee has parameters pms[pa..pa+pn]:
// the parameter's pass and projections, or `in` past them.
fn param_argument(inout l: L, id: u64, pa: u64, pn: u64, i: u64) -> Arg {
    if i < pn {
        let param = l.a.param(add(pa, i));
        return argument(inout l, id, param.pass, param.qa, param.qn);
    }
    argument(inout l, id, TyPass::In, 0, 0)
}

fn indirect(inout l: L, e: Ex, callee: Ex) -> u32 {
    let callable = expr(inout l, e.a);
    let callee_ty = l.c.world.expr_type(callee.s0, callee.s1);
    let mut modes: u64 = 0;
    if callee_ty != NONE32 && l.c.types.kind(callee_ty) == TyKind::Fn {
        modes = l.c.types.arity(callee_ty);
    }
    let mut args: ChunkSeq[Arg] = ChunkSeq::new[Arg]();
    for i in 0..e.n {
        let at = add(e.b, wrapping_mul(i, 2));
        let pass = if i < modes {
            l.c.types.param_pass(callee_ty, i)
        } else {
            wrapping_u8(l.a.x(at))
        };
        let arg = argument(inout l, l.a.x(inc(at)), pass, 0, 0);
        args.push(arg);
    }
    let ops_start = l.sops.len();
    put(inout l, w(callable), Tag::Value);
    put_args(inout l, in args);
    emit(inout l, Op::Indirect, ops_start, e.s0, e.s1)
}

// ----- loops and exits (src/loops/ir.rs) ---------------------------------------------

// Continues after a jump in a block nothing reaches.
fn after_jump(inout l: L, e: Ex) -> u32 {
    l.cur = new_block(inout l);
    unit(inout l, e.s0, e.s1)
}

fn read_slot(inout l: L, slot: u32, s0: u64, ty: u32) -> u32 {
    let ops_start = l.sops.len();
    put(inout l, w(slot), Tag::Name);
    put(inout l, 0, Tag::Path);
    put(inout l, widen_u64(TyPass::Sink), Tag::Raw);
    put(inout l, 0, Tag::Raw);
    emit_at(inout l, Op::Read, ops_start, s0, s0, ty)
}

fn loop_target(in l: L) -> Lp {
    match l.loops.try_get(wrapping_sub(l.loops.len(), 1)) {
        Option::Some(target) => target,
        Option::None => Lp { exit: 0, value: false, next: NONE64, cs: 0 },
    }
}

fn pop_loop(inout l: L) -> Lp {
    let target = loop_target(in l);
    l.loops.truncate(wrapping_sub(l.loops.len(), 1));
    target
}

fn control(inout l: L, e: Ex) -> u32 {
    let unit_ty = l.c.types.unit;
    if e.kind == X_LOOP {
        let ty = type_at(inout l, e.s0, e.s1);
        let param_ty = if is_never(in l, ty) { unit_ty } else { ty };
        let header = new_block(inout l);
        let exit = new_block(inout l);
        let result = fresh(inout l);
        set_val(inout l, result, param_ty);
        set_param(inout l, exit, result);
        jump(inout l, l.cur, header, NONE32);
        l.cur = header;
        let ops_start = l.sops.len();
        let loop_inst = emit_at(inout l, Op::Loop, ops_start, e.s0, e.s1, unit_ty);
        l.loops.push(Lp { exit: exit, value: true, next: header, cs: l.conts.len() });
        let mark = l.trail.len();
        let body = expr(inout l, e.a);
        restore(inout l, mark);
        let popped = pop_loop(inout l);
        jump(inout l, l.cur, header, NONE32);
        l.cur = exit;
        return result;
    }
    if e.kind == X_FOR {
        return lower_for(inout l, e);
    }
    if e.kind == X_BREAK {
        if l.loops.len() == 0 {
            return unit(inout l, e.s0, e.s1);
        }
        let target = loop_target(in l);
        let value = if e.a == NONE64 {
            let ops_start = l.sops.len();
            emit_at(inout l, Op::Unit, ops_start, e.s0, e.s1, unit_ty)
        } else {
            expr(inout l, e.a)
        };
        if target.value {
            jump(inout l, l.cur, target.exit, value);
        } else {
            jump(inout l, l.cur, target.exit, NONE32);
        }
        return after_jump(inout l, e);
    }
    if e.kind == X_CONTINUE {
        if l.loops.len() == 0 {
            return unit(inout l, e.s0, e.s1);
        }
        let target = loop_target(in l);
        let mut to = target.next;
        if to == NONE64 {
            l.conts.push(l.cur);
            // Patched to the step block after the body.
            to = l.cur;
        }
        jump(inout l, l.cur, to, NONE32);
        return after_jump(inout l, e);
    }
    if e.kind == X_RETURN {
        let value = if e.a == NONE64 {
            let ops_start = l.sops.len();
            emit_at(inout l, Op::Unit, ops_start, e.s0, e.s1, unit_ty)
        } else {
            expr(inout l, e.a)
        };
        let ops_start = l.sops.len();
        put(inout l, w(value), Tag::Value);
        put(inout l, w(l.owner), Tag::Name);
        let exit_inst = emit(inout l, Op::Exit, ops_start, e.s0, e.s1);
        let term_start = l.sops.len();
        set_term(inout l, l.cur, Term::Unreachable, term_start);
        return after_jump(inout l, e);
    }
    // `Range` and anything else.
    unit(inout l, e.s0, e.s1)
}

fn lower_for(inout l: L, e: Ex) -> u32 {
    let iter = l.a.ex(e.b);
    if iter.kind != X_RANGE {
        return unit(inout l, e.s0, e.s1);
    }
    let unit_ty = l.c.types.unit;
    let start = l.a.ex(iter.a);
    let element = type_at(inout l, start.s0, start.s1);
    let bool_ty = bool_type(inout l);
    // Synthetic instructions use the zero-width spans the checker typed:
    // the element type at the range start, bool at its end.
    let at = iter.s0;
    let test_at = iter.s1;
    let inclusive = iter.c != 0;
    let lo = expr(inout l, iter.a);
    let hi = expr(inout l, iter.b);
    let index_id = fresh(inout l);
    let index = slot_name(inout l, "$loop", index_id, NONE32, "_index");
    let bound_id = fresh(inout l);
    let bound = slot_name(inout l, "$loop", bound_id, NONE32, "_bound");
    set_local(inout l, index, element);
    bind_slot(inout l, index, lo, at, unit_ty);
    set_local(inout l, bound, element);
    bind_slot(inout l, bound, hi, at, unit_ty);
    let header = new_block(inout l);
    let body_block = new_block(inout l);
    let exit = new_block(inout l);
    jump(inout l, l.cur, header, NONE32);
    l.cur = header;
    let ops_start = l.sops.len();
    let loop_inst = emit_at(inout l, Op::Loop, ops_start, e.s0, e.s1, unit_ty);
    let index_value = read_slot(inout l, index, at, element);
    let bound_value = read_slot(inout l, bound, at, element);
    let op = if inclusive { l.s_le } else { l.s_lt };
    let condition = binary_at(inout l, op, index_value, bound_value, test_at, bool_ty);
    branch(inout l, l.cur, condition, body_block, exit);
    l.cur = body_block;
    let mark = l.trail.len();
    let pat_value = read_slot(inout l, index, at, element);
    let pat = l.a.pt(e.a);
    let bind_start = l.sops.len();
    put(inout l, w(pat_value), Tag::Value);
    pattern(inout l, e.a, element, true);
    let bind = emit_at(inout l, Op::Bind, bind_start, pat.s0, pat.s1, unit_ty);
    l.loops.push(Lp { exit: exit, value: false, next: NONE64, cs: l.conts.len() });
    let body = expr(inout l, e.c);
    let popped = pop_loop(inout l);
    let mut continues: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for j in popped.cs..l.conts.len() {
        continues.push(u64_at(in l.conts, j));
    }
    l.conts.truncate(popped.cs);
    restore(inout l, mark);
    if continues.len() > 0 {
        // Every `continue` and the body's end meet in one step block.
        let step = new_block(inout l);
        for j in 0..continues.len() {
            jump(inout l, u64_at(in continues, j), step, NONE32);
        }
        jump(inout l, l.cur, step, NONE32);
        l.cur = step;
    }
    let latch = new_block(inout l);
    if inclusive {
        // Leave at the bound instead of incrementing past it.
        let last_index = read_slot(inout l, index, at, element);
        let last_bound = read_slot(inout l, bound, at, element);
        let last = binary_at(inout l, l.s_eq, last_index, last_bound, test_at, bool_ty);
        branch(inout l, l.cur, last, exit, latch);
    } else {
        jump(inout l, l.cur, latch, NONE32);
    }
    l.cur = latch;
    let step_index = read_slot(inout l, index, at, element);
    let one_start = l.sops.len();
    put_literal(inout l, Lit::Int, 1, 0);
    let one = emit_at(inout l, Op::Const, one_start, at, at, element);
    let next = binary_at(inout l, l.s_plus, step_index, one, at, element);
    let write_start = l.sops.len();
    put(inout l, w(index), Tag::Name);
    put(inout l, w(l.s_set), Tag::Name);
    put(inout l, w(next), Tag::Value);
    let write_inst = emit_at(inout l, Op::Write, write_start, at, at, unit_ty);
    jump(inout l, l.cur, header, NONE32);
    l.cur = exit;
    unit(inout l, e.s0, e.s1)
}

fn bind_slot(inout l: L, slot: u32, value: u32, at: u64, unit_ty: u32) {
    let ops_start = l.sops.len();
    put(inout l, w(value), Tag::Value);
    put(inout l, widen_u64(Pat::Bind), Tag::Raw);
    put(inout l, at, Tag::Raw);
    put(inout l, at, Tag::Raw);
    put(inout l, w(slot), Tag::Name);
    let bind_inst = emit_at(inout l, Op::Bind, ops_start, at, at, unit_ty);
}

fn binary_at(inout l: L, op: u32, lhs: u32, rhs: u32, at: u64, ty: u32) -> u32 {
    let ops_start = l.sops.len();
    put(inout l, w(op), Tag::Name);
    put(inout l, w(lhs), Tag::Value);
    put(inout l, w(rhs), Tag::Value);
    emit_at(inout l, Op::Binary, ops_start, at, at, ty)
}

// ----- closures and handlers ------------------------------------------------------

fn free_bind(inout l: L, sym: u32) {
    set_by_symbol(inout l.fbound, sym, wrapping_add(u32_at(in l.fbound, w(sym)), 1));
    l.fbt.push(sym);
}

fn free_unbind(inout l: L, mark: u64) {
    loop {
        let n = l.fbt.len();
        if n <= mark {
            break;
        }
        let sym = u32_at(in l.fbt, wrapping_sub(n, 1));
        set_by_symbol(inout l.fbound, sym, wrapping_sub(u32_at(in l.fbound, w(sym)), 1));
        l.fbt.truncate(wrapping_sub(n, 1));
    }
}

// Binds the names of pattern `pid` (`pattern_names`).
fn free_pattern(inout l: L, pid: u64) {
    let pat = l.a.pt(pid);
    if pat.kind == Pat::Bind {
        free_bind(inout l, n32(pat.a));
    } else if pat.kind == Pat::Tuple {
        for i in 0..pat.n {
            free_pattern(inout l, l.a.px(add(pat.b, i)));
        }
    } else if pat.kind == Pat::Constructor {
        for i in 0..pat.n {
            free_pattern(inout l, l.a.px(add(pat.b, inc(wrapping_mul(i, 2)))));
        }
    }
}

fn free_use(inout l: L, sym: u32, inout out: ChunkSeq[u64]) {
    if u32_at(in l.fbound, w(sym)) == 0 {
        out.push(wrapping_shl_u64(w(sym), 32));
    }
}

// Walks a clause: its patterns bound over its body.
fn free_clause(inout l: L, clause_id: u64, inout out: ChunkSeq[u64]) {
    let clause = l.a.clause(clause_id);
    let mark = l.fbt.len();
    for i in 0..clause.pn {
        free_pattern(inout l, l.a.x(add(clause.pa, i)));
    }
    free_walk(inout l, clause.body, inout out);
    free_unbind(inout l, mark);
}

// `check::free_names` of expression `id`, as (symbol << 32) words in
// `out`; a name bound in scope (`fbound`) is not free. A foreign row sets
// `ffor`, since its names are not in the input.
fn free_walk(inout l: L, id: u64, inout out: ChunkSeq[u64]) {
    if id == NONE64 {
        return;
    }
    let e = l.a.ex(id);
    let kind = e.kind;
    if kind == X_NAME {
        free_use(inout l, n32(e.a), inout out);
    } else if kind == X_TUPLE {
        for i in 0..e.n {
            free_walk(inout l, l.a.x(add(e.a, i)), inout out);
        }
    } else if kind == X_STRUCT || kind == X_CALL {
        if kind == X_CALL {
            free_walk(inout l, e.a, inout out);
        }
        for i in 0..e.n {
            free_walk(inout l, l.a.x(add(e.b, inc(wrapping_mul(i, 2)))), inout out);
        }
    } else if kind == X_BLOCK {
        let mark = l.fbt.len();
        for i in 0..e.n {
            let at = add(e.a, wrapping_mul(i, 3));
            free_walk(inout l, l.a.x(add(at, 2)), inout out);
            if l.a.x(at) == 1 {
                free_pattern(inout l, l.a.x(inc(at)));
            }
        }
        free_walk(inout l, e.b, inout out);
        free_unbind(inout l, mark);
    } else if kind == X_FIELD
        || kind == X_TRY
        || kind == X_LOOP
        || kind == X_BREAK
        || kind == X_RETURN {
        free_walk(inout l, e.a, inout out);
    } else if kind == X_UNARY {
        free_walk(inout l, e.b, inout out);
    } else if kind == X_INDEX || kind == X_RANGE {
        free_walk(inout l, e.a, inout out);
        free_walk(inout l, e.b, inout out);
    } else if kind == X_BINARY || kind == X_ASSIGN {
        free_walk(inout l, e.b, inout out);
        free_walk(inout l, e.c, inout out);
    } else if kind == X_IF {
        free_walk(inout l, e.a, inout out);
        free_walk(inout l, e.b, inout out);
        free_walk(inout l, e.c, inout out);
    } else if kind == X_MATCH {
        free_walk(inout l, e.a, inout out);
        for i in 0..e.n {
            let at = add(e.b, wrapping_mul(i, 2));
            let mark = l.fbt.len();
            free_pattern(inout l, l.a.x(at));
            free_walk(inout l, l.a.x(inc(at)), inout out);
            free_unbind(inout l, mark);
        }
    } else if kind == X_FOR {
        free_walk(inout l, e.b, inout out);
        let mark = l.fbt.len();
        free_pattern(inout l, e.a);
        free_walk(inout l, e.c, inout out);
        free_unbind(inout l, mark);
    } else if kind == X_CLOSURE {
        let mark = l.fbt.len();
        for i in 0..e.n {
            free_bind(inout l, l.a.param(add(e.b, i)).name);
        }
        free_walk(inout l, e.c, inout out);
        free_unbind(inout l, mark);
    } else if kind == X_HANDLE {
        let handler_row = l.a.handler(e.a);
        if handler_row.has_state {
            free_walk(inout l, handler_row.sexpr, inout out);
        }
        free_walk(inout l, handler_row.body, inout out);
        for i in 0..inc(handler_row.on) {
            free_clause(inout l, add(handler_row.ret, i), inout out);
        }
    } else if kind == X_FOREIGN {
        l.ffor = true;
    }
}

// The distinct symbols of (symbol << 32) words, in name order (a
// `BTreeSet<String>`).
fn sorted_names(in l: L, inout xs: ChunkSeq[u64]) -> ChunkSeq[u32] {
    sort_by_name(in l.c.names, inout xs);
    let mut out: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut last = NONE32;
    for i in 0..xs.len() {
        let sym = n32(wrapping_shr_u64(u64_at(in xs, i), 32));
        if sym != last {
            out.push(sym);
            last = sym;
        }
    }
    out
}

// The parameter row of the function being lowered named `name` (the last
// one, as `permissions` collects them), or NONE.
fn permission(in l: L, name: u32) -> u64 {
    let mut found = NONE64;
    for i in 0..l.fpn {
        let param_index = add(l.fpa, i);
        if l.a.param(param_index).name == name {
            found = param_index;
        }
    }
    found
}

// `Lower::capture_params`: names with a slot and a local type, as `sink`
// parameters (or, `borrowed`, with the slot's permission).
fn capture_params(
    inout l: L,
    in names: ChunkSeq[u32],
    borrowed: bool,
    s0: u64,
    s1: u64,
    inout out: ChunkSeq[Pm]
) {
    for i in 0..names.len() {
        let sym = u32_at(in names, i);
        let slot = alias_of(in l, sym);
        let ty = if slot == NONE32 {
            NONE32
        } else {
            local_of(in l, slot)
        };
        if ty != NONE32 {
            let mut param = Pm {
                name: sym,
                pass: TyPass::Sink,
                qa: 0,
                qn: 0,
                ty: ty,
                s0: s0,
                s1: s1
            };
            if borrowed {
                let param_index = permission(in l, slot);
                if param_index != NONE64 {
                    let perm = l.a.param(param_index);
                    param.pass = perm.pass;
                    param.qa = perm.qa;
                    param.qn = perm.qn;
                }
            }
            out.push(param);
        }
    }
}

fn pm_at(in params: ChunkSeq[Pm], i: u64) -> Pm {
    match params.try_get(i) {
        Option::Some(param) => param,
        Option::None => Pm { name: 0, pass: 0, qa: 0, qn: 0, ty: 0, s0: 0, s1: 0 },
    }
}

// `pattern_params`: the bindings of pattern `pid` at type `ty`.
fn pattern_params(inout l: L, pid: u64, ty: u32, pass: u8, inout out: ChunkSeq[Pm]) {
    let pat = l.a.pt(pid);
    if pat.kind == Pat::Bind {
        out.push(Pm { name: n32(pat.a), pass: pass, qa: 0, qn: 0, ty: ty, s0: pat.s0, s1: pat.s1 });
    } else if pat.kind == Pat::Tuple {
        if l.c.types.kind(ty) == TyKind::Tuple {
            let typed_count = min_u64(pat.n, l.c.types.arity(ty));
            for i in 0..typed_count {
                let elem_ty = l.c.types.arg(ty, i);
                pattern_params(inout l, l.a.px(add(pat.b, i)), elem_ty, pass, inout out);
            }
        }
    } else if pat.kind == Pat::Constructor {
        let ctor = ctor_of(inout l, n32(pat.a));
        if ctor == NONE64 {
            return;
        }
        let adt = l.c.world.adt(n32(wrapping_shr_u64(ctor, 32)));
        let variant = l.c.world.variant(ctor & LOW32);
        let vars = if l.c.types.kind(ty) == TyKind::Named {
            l.c.world.vars_of(in l.c.types, adt, ty)
        } else {
            vars_new()
        };
        for i in 0..pat.n {
            let field = n32(l.a.px(add(pat.b, wrapping_mul(i, 2))));
            let kid = l.a.px(add(pat.b, inc(wrapping_mul(i, 2))));
            let field_index = l.c.world.find_field(variant, field);
            if field_index != NONE32 {
                let fty = l.c.world.field(w(field_index)).ty;
                let field_ty = substitute(inout l.c.types, fty, in vars);
                pattern_params(inout l, kid, field_ty, pass, inout out);
            }
        }
    }
}

// `nested_name`: `${kind}_{start}_{end}` of the body's span.
fn nested_name(inout l: L, kind: u8, s0: u64, s1: u64) -> u32 {
    let mut bytes: ChunkSeq[u8] = ChunkSeq::new[u8]();
    if kind == NK_CLOSURE {
        bytes.extend(in "$closure_".as_bytes());
    } else if kind == NK_BODY {
        bytes.extend(in "$handler_body_".as_bytes());
    } else {
        bytes.extend(in "$handler_clause_".as_bytes());
    }
    push_decimal(inout bytes, s0);
    bytes.push(95);
    push_decimal(inout bytes, s1);
    intern_bytes(inout l, in bytes)
}

// `Lower::add_nested`: appends the function to the table, to be lowered
// after the world's. A handler body leaves through its enclosing owner
// and captures its `sink` parameters externally.
fn add_nested(inout l: L, kind: u8, body: u64, in params: ChunkSeq[Pm], result: u32, effects: u32) {
    let body_ex = l.a.ex(body);
    let name = nested_name(inout l, kind, body_ex.s0, body_ex.s1);
    let pa = l.a.pms.len();
    for i in 0..params.len() {
        let at = l.a.add_param(pm_at(in params, i));
    }
    let xa = l.a.exts.len();
    let mut xn: u64 = 0;
    if kind == NK_BODY {
        let mut keys: ChunkSeq[u64] = ChunkSeq::new[u64]();
        for i in 0..params.len() {
            let param = pm_at(in params, i);
            if param.pass == TyPass::Sink {
                keys.push(wrapping_shl_u64(w(param.name), 32));
            }
        }
        let names = sorted_names(in l, inout keys);
        for i in 0..names.len() {
            l.a.add_ext(u32_at(in names, i));
        }
        xn = names.len();
    }
    let ca = l.a.caps.len();
    let mut cn: u64 = 0;
    for i in 0..l.cap_set.len() {
        let label = u32_at(in l.cap_set, i);
        let eff = cap_of(in l, label);
        if eff != NONE32 {
            l.a.add_cap(label, eff);
            cn = inc(cn);
        }
    }
    let owner = if kind == NK_BODY { l.owner } else { name };
    l.a.add_function(FnR {
        key: name,
        name: name,
        has_body: true,
        body: body,
        pa: pa,
        pn: params.len(),
        result: result,
        effects: effects,
        ga: l.fga,
        gn: l.fgn,
        ca: ca,
        cn: cn,
        owner: owner,
        xa: xa,
        xn: xn
    });
}

// The free names of `body` (minus the bound ones), or false when a
// foreign row hides some.
fn free_names_of(inout l: L, body: u64, inout names: ChunkSeq[u32]) -> bool {
    l.ffor = false;
    let mut raw: ChunkSeq[u64] = ChunkSeq::new[u64]();
    free_walk(inout l, body, inout raw);
    names = sorted_names(in l, inout raw);
    !l.ffor
}

// `prepare_nested` of a closure.
fn prepare_closure(inout l: L, e: Ex) {
    let mark = l.fbt.len();
    for i in 0..e.n {
        free_bind(inout l, l.a.param(add(e.b, i)).name);
    }
    let mut names: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let known = free_names_of(inout l, e.c, inout names);
    free_unbind(inout l, mark);
    let closure_ty = span_type(in l, e.s0, e.s1);
    if l.c.types.kind(closure_ty) != TyKind::Fn {
        return;
    }
    if !known {
        l.skipped = inc(l.skipped);
        return;
    }
    let mut params: ChunkSeq[Pm] = ChunkSeq::new[Pm]();
    capture_params(inout l, in names, false, e.s0, e.s1, inout params);
    let arity = l.c.types.arity(closure_ty);
    for i in 0..e.n {
        let mut param = l.a.param(add(e.b, i));
        if i < arity {
            param.pass = l.c.types.param_pass(closure_ty, i);
            param.ty = l.c.types.arg(closure_ty, i);
        }
        params.push(param);
    }
    let node = l.c.types.node(closure_ty);
    let effects = l.c.types.row_type(node.r2);
    add_nested(inout l, NK_CLOSURE, e.c, in params, node.r, effects);
}

// The capture parameters of handler clause `clause_id` (`clause_free_names`),
// or false when a foreign row hides some.
fn clause_params(inout l: L, clause_id: u64, inout params: ChunkSeq[Pm]) -> bool {
    let clause = l.a.clause(clause_id);
    let mark = l.fbt.len();
    for i in 0..clause.pn {
        free_pattern(inout l, l.a.x(add(clause.pa, i)));
    }
    let mut names: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let known = free_names_of(inout l, clause.body, inout names);
    free_unbind(inout l, mark);
    let body_ex = l.a.ex(clause.body);
    capture_params(inout l, in names, false, body_ex.s0, body_ex.s1, inout params);
    known
}

fn nest_clause(
    inout l: L,
    clause_id: u64,
    known: bool,
    in params: ChunkSeq[Pm],
    output: u32,
    outgoing: u32
) {
    if known {
        add_nested(inout l, NK_CLAUSE, l.a.clause(clause_id).body, in params, output, outgoing);
    } else {
        l.skipped = inc(l.skipped);
    }
}

// `prepare_nested` of a handler: its body and every clause.
fn prepare_handler(inout l: L, e: Ex) {
    let handler_row = l.a.handler(e.a);
    let body_ex = l.a.ex(handler_row.body);
    let body_type = span_type(in l, body_ex.s0, body_ex.s1);
    let output = span_type(in l, e.s0, e.s1);
    let outgoing = handler_row.outgoing;
    let mut names: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let known = free_names_of(inout l, handler_row.body, inout names);
    let mut body_params: ChunkSeq[Pm] = ChunkSeq::new[Pm]();
    capture_params(inout l, in names, true, body_ex.s0, body_ex.s1, inout body_params);
    if known {
        // the handled label names the effect inside the body only
        let label = if handler_row.label == 0 {
            NONE32
        } else {
            wrapping_sub(handler_row.label, 1)
        };
        let old = if label == NONE32 {
            0
        } else {
            u32_at(in l.cap_of, w(label))
        };
        if label != NONE32 {
            set_by_symbol(inout l.cap_of, label, wrapping_add(handler_row.eff_name, 1));
            l.cap_set.push(label);
        }
        add_nested(inout l, NK_BODY, handler_row.body, in body_params, body_type, outgoing);
        if label != NONE32 {
            set_by_symbol(inout l.cap_of, label, old);
        }
    } else {
        l.skipped = inc(l.skipped);
    }
    let unit_ty = l.c.types.unit;
    let mut state_type = unit_ty;
    if handler_row.has_state {
        let state_ex = l.a.ex(handler_row.sexpr);
        let state_expr_ty = l.c.world.expr_type(state_ex.s0, state_ex.s1);
        if state_expr_ty != NONE32 {
            state_type = state_expr_ty;
        }
    }
    let ret_type = if handler_row.has_state {
        let mut pair_tys: ChunkSeq[u32] = ChunkSeq::new[u32]();
        pair_tys.push(body_type);
        pair_tys.push(state_type);
        l.c.types.tuple(in pair_tys)
    } else {
        body_type
    };
    let mut ret_params: ChunkSeq[Pm] = ChunkSeq::new[Pm]();
    let ret_known = clause_params(inout l, handler_row.ret, inout ret_params);
    let ret_clause = l.a.clause(handler_row.ret);
    if ret_clause.pn > 0 {
        pattern_params(inout l, l.a.x(ret_clause.pa), ret_type, TyPass::Sink, inout ret_params);
    }
    nest_clause(inout l, handler_row.ret, ret_known, in ret_params, output, outgoing);
    let eff_index = l.a.effect_index(handler_row.eff_name);
    if eff_index == NONE64 {
        return;
    }
    let decl = l.a.effect_decl(eff_index);
    let mut vars = vars_new();
    for i in 0..min_u64(decl.gn, handler_row.tn) {
        vars.set(l.a.egen(add(decl.ga, i)), n32(l.a.x(add(handler_row.ta, i))));
    }
    let row = l.c.types.node(outgoing).r2;
    let mode = if decl.linear {
        TyMode::Linear
    } else {
        TyMode::Affine
    };
    for j in 0..handler_row.on {
        let clause_id = add(inc(handler_row.ret), j);
        let clause = l.a.clause(clause_id);
        let mut sig_index = NONE64;
        for k in 0..decl.on {
            if sig_index == NONE64 && l.a.eop(add(decl.oa, k)).name == clause.name {
                sig_index = add(decl.oa, k);
            }
        }
        if sig_index != NONE64 {
            let sig = l.a.eop(sig_index);
            let mut op_params: ChunkSeq[Pm] = ChunkSeq::new[Pm]();
            let op_known = clause_params(inout l, clause_id, inout op_params);
            for i in 0..min_u64(clause.pn, sig.pn) {
                let pid = l.a.x(add(clause.pa, i));
                let sig_param = l.a.param(add(sig.pa, i));
                let param_ty = substitute(inout l.c.types, sig_param.ty, in vars);
                pattern_params(inout l, pid, param_ty, sig_param.pass, inout op_params);
                let pat = l.a.pt(pid);
                if pat.kind == Pat::Bind {
                    let bind_name = n32(pat.a);
                    let mut done = false;
                    for k in 0..op_params.len() {
                        let mut param_row = pm_at(in op_params, k);
                        if !done && param_row.name == bind_name {
                            param_row.qa = sig_param.qa;
                            param_row.qn = sig_param.qn;
                            let ok = op_params.try_set(k, param_row);
                            done = true;
                        }
                    }
                }
            }
            let mut index = sig.pn;
            if handler_row.has_state {
                if index < clause.pn {
                    pattern_params(
                        inout l,
                        l.a.x(add(clause.pa, index)),
                        state_type,
                        TyPass::Sink,
                        inout op_params
                    );
                }
                index = inc(index);
            }
            let mut items: ChunkSeq[u32] = ChunkSeq::new[u32]();
            let mut passes: ChunkSeq[u8] = ChunkSeq::new[u8]();
            items.push(substitute(inout l.c.types, sig.result, in vars));
            passes.push(TyPass::Sink);
            if handler_row.has_state {
                items.push(state_type);
                passes.push(TyPass::Sink);
            }
            let resume_ty = l.c.types
                .mk_with(TyKind::Fn, mode, 0, in items, in passes, output, row, 0);
            if index < clause.pn {
                pattern_params(
                    inout l,
                    l.a.x(add(clause.pa, index)),
                    resume_ty,
                    TyPass::Sink,
                    inout op_params
                );
            }
            nest_clause(inout l, clause_id, op_known, in op_params, output, outgoing);
        }
    }
}

// `names` as alias pairs (a `BTreeMap<String, String>`).
fn put_aliases(inout l: L) {
    let mut keys: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for i in 0..l.trail.len() {
        let sym = n32(wrapping_shr_u64(u64_at(in l.trail, i), 32));
        if has_alias(in l, sym) {
            keys.push(wrapping_shl_u64(w(sym), 32));
        }
    }
    let names = sorted_names(in l, inout keys);
    put(inout l, names.len(), Tag::Raw);
    for i in 0..names.len() {
        let sym = u32_at(in names, i);
        put(inout l, w(sym), Tag::Name);
        put(inout l, w(alias_of(in l, sym)), Tag::Name);
    }
}

// Appends place (root, path symbols) to `out` as root, n, n symbols.
fn add_place(inout l: L, root: u32, path: u64, proj: u64, inout out: ChunkSeq[u32]) {
    out.push(root);
    let path_row = l.p.path(path);
    let mut n = path_row.n;
    if proj != NONE64 {
        n = add(n, l.p.path(proj).n);
    }
    out.push(n32(n));
    for k in 0..path_row.n {
        out.push(l.p.path_name(path, k));
    }
    if proj != NONE64 {
        for k in 0..l.p.path(proj).n {
            out.push(l.p.path_name(proj, k));
        }
    }
}

// Whether place (root, program path) is in the `add_place` list.
fn has_place(in l: L, in places: ChunkSeq[u32], root: u32, path: u64) -> bool {
    let path_row = l.p.path(path);
    let mut i: u64 = 0;
    loop {
        if i >= places.len() {
            return false;
        }
        let n = w(u32_at(in places, inc(i)));
        if u32_at(in places, i) == root && n == path_row.n {
            let mut same = true;
            for k in 0..n {
                if u32_at(in places, add(add(i, 2), k)) != l.p.path_name(path, k) {
                    same = false;
                }
            }
            if same {
                return true;
            }
        }
        i = add(add(i, 2), n);
    }
}

// The moves of an instruction's operands at sops[m..] (n, n x (root,
// path)) into the `add_place` list.
fn add_moves(inout l: L, moves_at: u64, inout out: ChunkSeq[u32]) {
    let n = sop(in l, moves_at);
    for j in 0..n {
        let at = add(inc(moves_at), wrapping_mul(j, 2));
        add_place(inout l, n32(sop(in l, at)), sop(in l, inc(at)), NONE64, inout out);
    }
}

// `world.moves` of a closure or handler (xs[xa..xa+2m]) with their roots
// renamed, leaving out the places in `initialized`.
fn put_moves(inout l: L, xa: u64, move_count: u64, in initialized: ChunkSeq[u32]) {
    let mut moves: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for i in 0..move_count {
        let at = add(xa, wrapping_mul(i, 2));
        let root = alias_of(in l, n32(l.a.x(at)));
        if root != NONE32 {
            let path = ppath(inout l, l.a.x(inc(at)));
            if !has_place(in l, in initialized, root, path) {
                moves.push(w(root));
                moves.push(path);
            }
        }
    }
    put(inout l, moves.len() / 2, Tag::Raw);
    for i in 0..moves.len() / 2 {
        put(inout l, u64_at(in moves, wrapping_mul(i, 2)), Tag::Name);
        put(inout l, u64_at(in moves, inc(wrapping_mul(i, 2))), Tag::Path);
    }
}

fn closure(inout l: L, e: Ex) -> u32 {
    prepare_closure(inout l, e);
    let none: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let ops_start = l.sops.len();
    put(inout l, e.a, Tag::Pool);
    put_aliases(inout l);
    put_moves(inout l, e.x, e.m, in none);
    emit(inout l, Op::Closure, ops_start, e.s0, e.s1)
}

fn handler(inout l: L, e: Ex) -> u32 {
    prepare_handler(inout l, e);
    let handler_row = l.a.handler(e.a);
    let mut initialized: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut state_value: u32 = 0;
    if handler_row.has_state {
        let mark = l.insts.len();
        state_value = expr(inout l, handler_row.sexpr);
        for i in mark..l.insts.len() {
            let inst = inst_at(in l, i);
            if inst.op == Op::Read && sop(in l, add(inst.a, 2)) == widen_u64(TyPass::Sink) {
                let root = n32(sop(in l, inst.a));
                let path = sop(in l, inc(inst.a));
                let qn = sop(in l, add(inst.a, 3));
                if qn == 0 {
                    add_place(inout l, root, path, NONE64, inout initialized);
                } else {
                    for j in 0..qn {
                        let proj = sop(in l, add(add(inst.a, 4), j));
                        add_place(inout l, root, path, proj, inout initialized);
                    }
                }
            } else if inst.op == Op::Closure {
                let arg_count = sop(in l, inc(inst.a));
                add_moves(
                    inout l,
                    add(add(inst.a, 2), wrapping_mul(arg_count, 2)),
                    inout initialized
                );
            } else if inst.op == Op::Handle {
                let arg_count = sop(in l, add(inst.a, 3));
                add_moves(
                    inout l,
                    add(add(inst.a, 4), wrapping_mul(arg_count, 2)),
                    inout initialized
                );
            }
        }
    }
    let ops_start = l.sops.len();
    put(inout l, if handler_row.has_state { 1 } else { 0 }, Tag::Raw);
    put(inout l, w(state_value), Tag::Value);
    put(inout l, handler_row.pool, Tag::Pool);
    put_aliases(inout l);
    put_moves(inout l, handler_row.ma, handler_row.mn, in initialized);
    emit(inout l, Op::Handle, ops_start, e.s0, e.s1)
}

// ----- functions ----------------------------------------------------------------------

fn reset(inout l: L) {
    l.next = 0;
    l.cur = 0;
    l.blocks.clear();
    l.insts.clear();
    l.sops.clear();
    l.stags.clear();
    l.vals.clear();
    restore(inout l, 0);
    for i in 0..l.locals.len() {
        set_by_symbol(inout l.local_ty, u32_at(in l.locals, i), 0);
    }
    l.locals.clear();
    for i in 0..l.cap_set.len() {
        set_by_symbol(inout l.cap_of, u32_at(in l.cap_set, i), 0);
    }
    l.cap_set.clear();
    l.loops.clear();
    l.conts.clear();
    l.skip = false;
}

// Lowers world function `fi` (with a body) and writes it to the program,
// unless it reaches a construct part 1 does not lower.
fn lower_fn(inout l: L, fi: u64) {
    reset(inout l);
    let func = l.a.function(fi);
    l.owner = func.owner;
    l.fpa = func.pa;
    l.fpn = func.pn;
    l.fga = func.ga;
    l.fgn = func.gn;
    for i in 0..func.pn {
        let param = l.a.param(add(func.pa, i));
        set_alias(inout l, param.name, param.name);
        set_local(inout l, param.name, param.ty);
    }
    for i in 0..func.cn {
        let label = l.a.cap(add(func.ca, wrapping_mul(i, 2)));
        let eff = l.a.cap(add(func.ca, inc(wrapping_mul(i, 2))));
        set_by_symbol(inout l.cap_of, label, wrapping_add(eff, 1));
        l.cap_set.push(label);
    }
    let entry_block = new_block(inout l);
    let value = expr(inout l, func.body);
    let ops_start = l.sops.len();
    put(inout l, w(value), Tag::Value);
    set_term(inout l, l.cur, Term::Return, ops_start);
    if l.skip {
        l.skipped = inc(l.skipped);
        return;
    }
    flush(inout l, func);
    l.lowered = inc(l.lowered);
}

fn dummy_low() -> L {
    let ctx = ctx_new();
    let ast = ast_empty();
    let program = program_new();
    L {
        s_and: 0,
        s_or: 0,
        s_div: 0,
        s_rem: 0,
        s_shl: 0,
        s_shr: 0,
        s_eq: 0,
        s_ne: 0,
        s_lt: 0,
        s_le: 0,
        s_gt: 0,
        s_ge: 0,
        s_plus: 0,
        s_set: 0,
        s_dotdot: 0,
        s_box_new: 0,
        s_box_new_in_caller: 0,
        s_seq_subslice: 0,
        s_seq_get: 0,
        s_seq_slice_get: 0,
        s_fip_box_new: 0,
        s_fip_box_new_in_caller: 0,
        c: ctx,
        a: ast,
        p: program,
        ppath: ChunkSeq::new[u64](),
        owner: 0,
        next: 0,
        cur: 0,
        blocks: ChunkSeq::new[Bk](),
        insts: ChunkSeq::new[In](),
        sops: ChunkSeq::new[u64](),
        stags: ChunkSeq::new[u8](),
        vals: ChunkSeq::new[u32](),
        alias: ChunkSeq::new[u32](),
        trail: ChunkSeq::new[u64](),
        local_ty: ChunkSeq::new[u32](),
        locals: ChunkSeq::new[u32](),
        cap_of: ChunkSeq::new[u32](),
        cap_set: ChunkSeq::new[u32](),
        loops: ChunkSeq::new[Lp](),
        conts: ChunkSeq::new[u64](),
        skip: false,
        fbound: ChunkSeq::new[u32](),
        fbt: ChunkSeq::new[u32](),
        ffor: false,
        fpa: 0,
        fpn: 0,
        fga: 0,
        fgn: 0,
        lowered: 0,
        skipped: 0,
    }
}

fn rebuild_low(
    sink l: L,
    heap_mark: u64,
    low_perm: u64,
    low_perm_end: u64,
    n_fns: u64,
    n_blocks: u64,
    n_insts: u64,
    n_paths: u64,
    n_pool: u64,
    n_afns: u64,
    n_apms: u64,
    n_nodes: u64,
    n_rows: u64,
    n_effs: u64
) -> (L, u64) {
    let L {
        s_and,
        s_or,
        s_div,
        s_rem,
        s_shl,
        s_shr,
        s_eq,
        s_ne,
        s_lt,
        s_le,
        s_gt,
        s_ge,
        s_plus,
        s_set,
        s_dotdot,
        s_box_new,
        s_box_new_in_caller,
        s_seq_subslice,
        s_seq_get,
        s_seq_slice_get,
        s_fip_box_new,
        s_fip_box_new_in_caller,
        c,
        a,
        p,
        ppath: _ppath,
        owner,
        next,
        cur,
        blocks: _blocks,
        insts: _insts,
        sops: _sops,
        stags: _stags,
        vals: _vals,
        alias: _alias,
        trail: _trail,
        local_ty: _local_ty,
        locals: _locals,
        cap_of: _cap_of,
        cap_set: _cap_set,
        loops: _loops,
        conts: _conts,
        skip,
        fbound: _fbound,
        fbt: _fbt,
        ffor,
        fpa,
        fpn,
        fga,
        fgn,
        lowered,
        skipped,
    } = l;
    let Ctx {
        names,
        types,
        world,
        tmap,
        nmap,
    } = c;
    let saved = stage2_heap_swap(low_perm);
    let new_ctx = Ctx {
        names: names.clone_in_heap(),
        types: types.clone_tail_in_heap(n_nodes, n_rows, n_effs),
        world: world,
        tmap: tmap,
        nmap: nmap,
    };
    let new_ast = a.clone_tail_in_heap(n_afns, n_apms);
    let new_program = p.clone_tail_in_heap(n_fns, n_blocks, n_insts, n_paths, n_pool);
    let next_perm = stage2_heap_swap(saved);
    if next_perm < low_perm_end {
        stage2_heap_reset(heap_mark);
    }
    let out = L {
        s_and: s_and,
        s_or: s_or,
        s_div: s_div,
        s_rem: s_rem,
        s_shl: s_shl,
        s_shr: s_shr,
        s_eq: s_eq,
        s_ne: s_ne,
        s_lt: s_lt,
        s_le: s_le,
        s_gt: s_gt,
        s_ge: s_ge,
        s_plus: s_plus,
        s_set: s_set,
        s_dotdot: s_dotdot,
        s_box_new: s_box_new,
        s_box_new_in_caller: s_box_new_in_caller,
        s_seq_subslice: s_seq_subslice,
        s_seq_get: s_seq_get,
        s_seq_slice_get: s_seq_slice_get,
        s_fip_box_new: s_fip_box_new,
        s_fip_box_new_in_caller: s_fip_box_new_in_caller,
        c: new_ctx,
        a: new_ast,
        p: new_program,
        ppath: ChunkSeq::new[u64](),
        owner: owner,
        next: next,
        cur: cur,
        blocks: ChunkSeq::new[Bk](),
        insts: ChunkSeq::new[In](),
        sops: ChunkSeq::new[u64](),
        stags: ChunkSeq::new[u8](),
        vals: ChunkSeq::new[u32](),
        alias: ChunkSeq::new[u32](),
        trail: ChunkSeq::new[u64](),
        local_ty: ChunkSeq::new[u32](),
        locals: ChunkSeq::new[u32](),
        cap_of: ChunkSeq::new[u32](),
        cap_set: ChunkSeq::new[u32](),
        loops: ChunkSeq::new[Lp](),
        conts: ChunkSeq::new[u64](),
        skip: skip,
        fbound: ChunkSeq::new[u32](),
        fbt: ChunkSeq::new[u32](),
        ffor: ffor,
        fpa: fpa,
        fpn: fpn,
        fga: fga,
        fgn: fgn,
        lowered: lowered,
        skipped: skipped,
    };
    (out, next_perm)
}

// Every world function, then the closures and handlers they nest (each
// appended to the function table as it is prepared).
pub fn lower_all(inout l: L) {
    let mut low_perm_buf = ChunkSeq::new[u8]();
    low_perm_buf.reserve(268435456);
    let low_perm_end = stage2_heap_mark();
    let mut low_perm = wrapping_sub(low_perm_end, 268435456);
    let mut max_fns = wrapping_add(l.p.fns.len(), 32768);
    let mut max_blocks = wrapping_add(l.p.blocks.len(), 131072);
    let mut max_insts = wrapping_add(l.p.insts.len(), 524288);
    let mut max_ops = wrapping_add(l.p.ops.len(), 2097152);
    let mut max_tags = wrapping_add(l.p.tags.len(), 2097152);
    let mut max_paths = wrapping_add(l.p.paths.len(), 65536);
    let mut max_path_syms = wrapping_add(l.p.path_syms.len(), 131072);
    let mut max_pool = wrapping_add(l.p.pool.len(), 32768);
    let mut max_afns = wrapping_add(l.a.fns.len(), 16384);
    let mut max_apms = wrapping_add(l.a.pms.len(), 32768);
    let mut max_acaps = wrapping_add(l.a.caps.len(), 16384);
    let mut max_aexts = wrapping_add(l.a.exts.len(), 16384);
    let low_entry = stage2_heap_swap(low_perm);
    l.p.reserve_lower(
        max_fns,
        max_blocks,
        max_insts,
        max_ops,
        max_tags,
        max_paths,
        max_path_syms,
        max_pool
    );
    l.a.reserve_lower(16384, 32768, 16384, 16384);
    l.c.names.reserve_names(
        wrapping_add(l.c.names.len(), 32768),
        wrapping_add(l.c.names.text.len(), 524288)
    );
    l.c.types.reserve_types(
        wrapping_add(l.c.types.nodes.len(), 32768),
        wrapping_add(l.c.types.items_len(), 32768),
        wrapping_add(l.c.types.rows.len(), 16384),
        wrapping_add(l.c.types.effs.len(), 8192)
    );
    for i in 0..l.a.pool_count {
        l.p.pool.push(PoolRow { kind: PoolKind::Expr, label: 0 });
    }
    low_perm = stage2_heap_swap(low_entry);
    let mut n_fns = l.p.fns.len();
    let mut n_blocks = l.p.blocks.len();
    let mut n_insts = l.p.insts.len();
    let mut n_paths = l.p.paths.len();
    let mut n_pool = l.p.pool.len();
    let mut n_afns = l.a.fns.len();
    let mut n_apms = l.a.pms.len();
    let mut n_nodes = l.c.types.nodes.len();
    let mut n_rows = l.c.types.rows.len();
    let mut n_effs = l.c.types.effs.len();
    let mut prev_nmask = l.c.names.mask;
    let mut prev_tmask = l.c.types.mask;
    let mut prev_rmask = l.c.types.row_mask;
    let mut heap_mark = stage2_heap_mark();
    let mut fi: u64 = 0;
    loop {
        if fi >= l.a.fns.len() {
            break;
        }
        let func = l.a.function(fi);
        if func.has_body {
            lower_fn(inout l, fi);
            if (fi & 1023) == 1023 {
                if l.p.fns.len() < max_fns
                    && l.p.blocks.len() < max_blocks
                    && l.p.insts.len() < max_insts
                    && l.p.ops.len() < max_ops
                    && l.p.tags.len() < max_tags
                    && l.p.paths.len() < max_paths
                    && l.p.path_syms.len() < max_path_syms
                    && l.p.pool.len() < max_pool
                    && l.a.fns.len() < max_afns
                    && l.a.pms.len() < max_apms
                    && l.a.caps.len() < max_acaps
                    && l.a.exts.len() < max_aexts
                    && l.c.names.mask == prev_nmask
                    && l.c.types.mask == prev_tmask
                    && l.c.types.row_mask == prev_rmask
                    && low_perm < low_perm_end {
                    let mut placeholder = dummy_low();
                    swap(inout l, inout placeholder);
                    let (rebuilt, next_perm) = rebuild_low(
                        placeholder,
                        heap_mark,
                        low_perm,
                        low_perm_end,
                        n_fns,
                        n_blocks,
                        n_insts,
                        n_paths,
                        n_pool,
                        n_afns,
                        n_apms,
                        n_nodes,
                        n_rows,
                        n_effs
                    );
                    let mut incoming = rebuilt;
                    low_perm = next_perm;
                    swap(inout l, inout incoming);
                    if low_perm >= low_perm_end {
                        low_perm = low_perm_end;
                    }
                    heap_mark = stage2_heap_mark();
                } else {
                    let saved_heap = if low_perm < low_perm_end {
                        stage2_heap_swap(low_perm)
                    } else {
                        0
                    };
                    max_fns = wrapping_add(l.p.fns.len(), 32768);
                    max_blocks = wrapping_add(l.p.blocks.len(), 131072);
                    max_insts = wrapping_add(l.p.insts.len(), 524288);
                    max_ops = wrapping_add(l.p.ops.len(), 2097152);
                    max_tags = wrapping_add(l.p.tags.len(), 2097152);
                    max_paths = wrapping_add(l.p.paths.len(), 65536);
                    max_path_syms = wrapping_add(l.p.path_syms.len(), 131072);
                    max_pool = wrapping_add(l.p.pool.len(), 32768);
                    max_afns = wrapping_add(l.a.fns.len(), 16384);
                    max_apms = wrapping_add(l.a.pms.len(), 32768);
                    max_acaps = wrapping_add(l.a.caps.len(), 16384);
                    max_aexts = wrapping_add(l.a.exts.len(), 16384);
                    l.p.reserve_lower(
                        max_fns,
                        max_blocks,
                        max_insts,
                        max_ops,
                        max_tags,
                        max_paths,
                        max_path_syms,
                        max_pool
                    );
                    l.a.reserve_lower(16384, 32768, 16384, 16384);
                    if low_perm < low_perm_end {
                        low_perm = stage2_heap_swap(saved_heap);
                    }
                    prev_nmask = l.c.names.mask;
                    prev_tmask = l.c.types.mask;
                    prev_rmask = l.c.types.row_mask;
                    heap_mark = stage2_heap_mark();
                }
                n_fns = l.p.fns.len();
                n_blocks = l.p.blocks.len();
                n_insts = l.p.insts.len();
                n_paths = l.p.paths.len();
                n_pool = l.p.pool.len();
                n_afns = l.a.fns.len();
                n_apms = l.a.pms.len();
                n_nodes = l.c.types.nodes.len();
                n_rows = l.c.types.rows.len();
                n_effs = l.c.types.effs.len();
            }
        }
        fi = inc(fi);
    }
    if l.p.fns.len() < max_fns
        && l.p.blocks.len() < max_blocks
        && l.p.insts.len() < max_insts
        && l.p.ops.len() < max_ops
        && l.p.tags.len() < max_tags
        && l.p.paths.len() < max_paths
        && l.p.path_syms.len() < max_path_syms
        && l.p.pool.len() < max_pool
        && l.a.fns.len() < max_afns
        && l.a.pms.len() < max_apms
        && l.a.caps.len() < max_acaps
        && l.a.exts.len() < max_aexts
        && l.c.names.mask == prev_nmask
        && l.c.types.mask == prev_tmask
        && l.c.types.row_mask == prev_rmask
        && low_perm < low_perm_end {
        let mut placeholder = dummy_low();
        swap(inout l, inout placeholder);
        let (rebuilt, next_perm) = rebuild_low(
            placeholder,
            heap_mark,
            low_perm,
            low_perm_end,
            n_fns,
            n_blocks,
            n_insts,
            n_paths,
            n_pool,
            n_afns,
            n_apms,
            n_nodes,
            n_rows,
            n_effs
        );
        let mut incoming = rebuilt;
        low_perm = next_perm;
        swap(inout l, inout incoming);
    }
}

// ----- sorting by name ------------------------------------------------------------------

// Byte order of two symbols' spellings (`String`'s `Ord`): -1, 0 or 1 as
// 0, 1, 2.
fn cmp_names(in names: Names, a: u32, b: u32) -> u8 {
    if a == b {
        return 1;
    }
    let len_a = names.size(a);
    let len_b = names.size(b);
    let n = if len_a < len_b { len_a } else { len_b };
    for i in 0..n {
        let byte_a = names.byte(a, i);
        let byte_b = names.byte(b, i);
        if byte_a < byte_b {
            return 0;
        }
        if byte_a > byte_b {
            return 2;
        }
    }
    if len_a < len_b {
        0
    } else if len_a > len_b {
        2
    } else {
        1
    }
}

// A stable merge sort of words by the symbol in their high 32 bits.
fn sort_by_name(in names: Names, inout xs: ChunkSeq[u64]) {
    let n = xs.len();
    let mut src = copy_words(in xs);
    let mut dst: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](n);
    dst.resize(n, 0);
    let mut width: u64 = 1;
    loop {
        if width >= n {
            break;
        }
        let mut lo: u64 = 0;
        loop {
            if lo >= n {
                break;
            }
            let mid = min_u64(add(lo, width), n);
            let hi = min_u64(add(mid, width), n);
            let mut i = lo;
            let mut j = mid;
            let mut k = lo;
            loop {
                if k >= hi {
                    break;
                }
                let take_left = if i < mid && j < hi {
                    let sym_a = n32(wrapping_shr_u64(u64_at(in src, i), 32));
                    let sym_b = n32(wrapping_shr_u64(u64_at(in src, j), 32));
                    cmp_names(in names, sym_a, sym_b) != 2
                } else {
                    i < mid
                };
                if take_left {
                    let ok = dst.try_set(k, u64_at(in src, i));
                    i = inc(i);
                } else {
                    let ok = dst.try_set(k, u64_at(in src, j));
                    j = inc(j);
                }
                k = inc(k);
            }
            lo = hi;
        }
        swap(inout src, inout dst);
        width = wrapping_mul(width, 2);
    }
    xs = src;
}

fn copy_words(in words: ChunkSeq[u64]) -> ChunkSeq[u64] {
    let mut out: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](words.len());
    for i in 0..words.len() {
        out.push(u64_at(in words, i));
    }
    out
}

fn min_u64(a: u64, b: u64) -> u64 {
    if a < b { a } else { b }
}

// ----- thread_tokens and the program tables ----------------------------------------------

fn put_p(inout l: L, word: u64, tag: u8) {
    l.p.put(word, tag);
}

fn header(inout l: L, f: FnR) {
    put_p(inout l, f.pn, Tag::Raw);
    for i in 0..f.pn {
        let param = l.a.param(add(f.pa, i));
        put_p(inout l, w(param.name), Tag::Name);
        put_p(inout l, widen_u64(param.pass), Tag::Raw);
        put_p(inout l, param.qn, Tag::Raw);
        for j in 0..param.qn {
            let id = ppath(inout l, l.a.proj(add(param.qa, j)));
            put_p(inout l, id, Tag::Path);
        }
        put_p(inout l, w(param.ty), Tag::Type);
        put_p(inout l, param.s0, Tag::Raw);
        put_p(inout l, param.s1, Tag::Raw);
    }
    put_p(inout l, w(f.result), Tag::Type);
    put_p(inout l, w(f.effects), Tag::Type);
    // bounds: the non-row generics by name; a repeated name keeps its last.
    let mut generic_keys: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for i in 0..f.gn {
        let generic = l.a.generic(add(f.ga, i));
        if !generic.row {
            generic_keys.push(wrapping_shl_u64(w(generic.name), 32) | add(f.ga, i));
        }
    }
    sort_by_name(in l.c.names, inout generic_keys);
    let mut keep: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for i in 0..generic_keys.len() {
        let key = u64_at(in generic_keys, i);
        let last = inc(i) >= generic_keys.len()
            || wrapping_shr_u64(u64_at(in generic_keys, inc(i)), 32) != wrapping_shr_u64(key, 32);
        if last {
            keep.push(key & LOW32);
        }
    }
    put_p(inout l, keep.len(), Tag::Raw);
    for i in 0..keep.len() {
        let generic = l.a.generic(u64_at(in keep, i));
        put_p(inout l, w(generic.name), Tag::Name);
        put_p(inout l, widen_u64(generic.bound), Tag::Raw);
    }
    // external captures (sorted when the handler body was nested)
    put_p(inout l, f.xn, Tag::Raw);
    for i in 0..f.xn {
        put_p(inout l, w(l.a.ext(add(f.xa, i))), Tag::Name);
    }
    let mut typed_count: u64 = 0;
    for value in 0..l.vals.len() {
        if u32_at(in l.vals, value) != NONE32 {
            typed_count = inc(typed_count);
        }
    }
    put_p(inout l, typed_count, Tag::Raw);
    for value in 0..l.vals.len() {
        let ty = u32_at(in l.vals, value);
        if ty != NONE32 {
            put_p(inout l, value, Tag::Value);
            put_p(inout l, w(ty), Tag::Type);
        }
    }
    let mut local_keys: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for i in 0..l.locals.len() {
        local_keys.push(wrapping_shl_u64(w(u32_at(in l.locals, i)), 32));
    }
    sort_by_name(in l.c.names, inout local_keys);
    put_p(inout l, local_keys.len(), Tag::Raw);
    for i in 0..local_keys.len() {
        let sym = n32(wrapping_shr_u64(u64_at(in local_keys, i), 32));
        put_p(inout l, w(sym), Tag::Name);
        put_p(inout l, w(local_of(in l, sym)), Tag::Type);
    }
}

fn inst_at(in l: L, i: u64) -> In {
    match l.insts.try_get(i) {
        Option::Some(inst) => inst,
        Option::None => In {
            block: 0,
            dest: 0,
            ty: 0,
            s0: 0,
            s1: 0,
            fallible: false,
            action: false,
            read: false,
            op: Op::Unit,
            a: 0,
            n: 0
        },
    }
}

// `thread_tokens` for the function being lowered, then its rows.
fn flush(inout l: L, f: FnR) {
    let block_count = l.blocks.len();
    // Instructions grouped by block, in order (a counting sort).
    let mut start: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](inc(block_count));
    start.resize(inc(block_count), 0);
    for i in 0..l.insts.len() {
        let block_id = inst_at(in l, i).block;
        let ok = start.try_set(inc(block_id), inc(u64_at(in start, inc(block_id))));
    }
    for block_id in 0..block_count {
        let ok = start.try_set(
            inc(block_id),
            add(u64_at(in start, block_id), u64_at(in start, inc(block_id)))
        );
    }
    let mut fill = copy_words(in start);
    let mut order: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](l.insts.len());
    order.resize(l.insts.len(), 0);
    for i in 0..l.insts.len() {
        let block_id = inst_at(in l, i).block;
        let at = u64_at(in fill, block_id);
        let ok = order.try_set(at, i);
        let ok2 = fill.try_set(block_id, inc(at));
    }
    // Tokens: each block's entry token is its id; actions take fresh ones.
    let mut next = block_count;
    let mut outgoing: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](block_count);
    let mut tin: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](l.insts.len());
    tin.resize(l.insts.len(), 0);
    let mut tout: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](l.insts.len());
    tout.resize(l.insts.len(), 0);
    for block_id in 0..block_count {
        let mut cur = block_id;
        for k in u64_at(in start, block_id)..u64_at(in start, inc(block_id)) {
            let i = u64_at(in order, k);
            let inst = inst_at(in l, i);
            if inst.action {
                let ok = tin.try_set(i, cur);
                let ok2 = tout.try_set(i, next);
                cur = next;
                next = inc(next);
            } else if inst.read {
                let ok = tin.try_set(i, cur);
                let ok2 = tout.try_set(i, cur);
            }
        }
        outgoing.push(cur);
    }
    // Incoming tokens: the edges in source order, each terminator's
    // targets in order (its block-tagged words), grouped by target.
    let mut edges: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut count: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](inc(block_count));
    count.resize(inc(block_count), 0);
    for block_id in 0..block_count {
        let block_row = bk(in l, block_id);
        for j in block_row.ta..add(block_row.ta, block_row.tn) {
            if u8_at(in l.stags, j) == Tag::Block {
                let target = sop(in l, j);
                edges.push(target);
                edges.push(block_id);
                let ok = count.try_set(inc(target), inc(u64_at(in count, inc(target))));
            }
        }
    }
    for block_id in 0..block_count {
        let ok = count.try_set(
            inc(block_id),
            add(u64_at(in count, block_id), u64_at(in count, inc(block_id)))
        );
    }
    let edge_count = edges.len() / 2;
    let mut edge_fill = copy_words(in count);
    let mut edge_src: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](edge_count);
    edge_src.resize(edge_count, 0);
    for k in 0..edge_count {
        let target = u64_at(in edges, wrapping_mul(k, 2));
        let source = u64_at(in edges, inc(wrapping_mul(k, 2)));
        let at = u64_at(in edge_fill, target);
        let ok = edge_src.try_set(at, source);
        let ok2 = edge_fill.try_set(target, inc(at));
    }
    // The function row.
    let ha = l.p.ops.len();
    header(inout l, f);
    let hn = wrapping_sub(l.p.ops.len(), ha);
    let b0 = l.p.blocks.len();
    for block_id in 0..block_count {
        let block_row = bk(in l, block_id);
        let bha = l.p.ops.len();
        put_p(inout l, block_id, Tag::Raw);
        let edge_start = u64_at(in count, block_id);
        let edge_end = u64_at(in count, inc(block_id));
        put_p(inout l, wrapping_sub(edge_end, edge_start), Tag::Raw);
        for k in edge_start..edge_end {
            let source = u64_at(in edge_src, k);
            put_p(inout l, source, Tag::Block);
            put_p(inout l, u64_at(in outgoing, source), Tag::Raw);
        }
        put_p(inout l, u64_at(in outgoing, block_id), Tag::Raw);
        if block_row.param == NONE32 {
            put_p(inout l, 0, Tag::Raw);
        } else {
            put_p(inout l, 1, Tag::Raw);
            put_p(inout l, w(block_row.param), Tag::Value);
        }
        let bhn = wrapping_sub(l.p.ops.len(), bha);
        let i0 = l.p.insts.len();
        for k in u64_at(in start, block_id)..u64_at(in start, inc(block_id)) {
            let i = u64_at(in order, k);
            let inst = inst_at(in l, i);
            let ops_start = l.p.ops.len();
            for j in inst.a..add(inst.a, inst.n) {
                put_p(inout l, sop(in l, j), u8_at(in l.stags, j));
            }
            let has_token = if inst.action || inst.read { 1 } else { 0 };
            l.p.insts.push(InstRow {
                dest: inst.dest,
                ty: inst.ty,
                s0: inst.s0,
                s1: inst.s1,
                has_token: has_token,
                tin: u64_at(in tin, i),
                tout: u64_at(in tout, i),
                fallible: if inst.fallible { 1 } else { 0 },
                op: inst.op,
                a: ops_start,
                n: inst.n
            });
        }
        let ic = wrapping_sub(l.p.insts.len(), i0);
        let ta = l.p.ops.len();
        for j in block_row.ta..add(block_row.ta, block_row.tn) {
            put_p(inout l, sop(in l, j), u8_at(in l.stags, j));
        }
        l.p.blocks.push(BlockRow {
            ha: bha,
            hn: bhn,
            i0: i0,
            ic: ic,
            term: block_row.term,
            ta: ta,
            tn: wrapping_sub(l.p.ops.len(), ta)
        });
    }
    // The trailer: no fip side tables at lowering.
    let ta = l.p.ops.len();
    for j in 0..5 {
        put_p(inout l, 0, Tag::Raw);
    }
    l.p.fns.push(FnRow {
        name: f.name,
        ha: ha,
        hn: hn,
        b0: b0,
        bc: block_count,
        ta: ta,
        tn: wrapping_sub(l.p.ops.len(), ta)
    });
}
