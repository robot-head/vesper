// The lowering input after check-data's context: the world's function
// table, effect operation signatures, and every function body as flat
// rows of expressions and patterns (tests/common/ir_lower_words.rs writes
// them; its module comment is the format). Rows are in post-order, so a
// row's children have smaller ids. Names are check-data symbols and types
// are check-data type ids.

use @vesper/check-data::util::{add, copy_seq, inc, n32, u32_at, u64_at, w};
use @vesper/check-data::world::{set_by_symbol};
use @vesper/check-data::input::{Ctx, Reader};
use @vesper/place-ir::codes::{Lit, Pat};

const NONE32: u32 = 4294967295;
const NONE64: u64 = 18446744073709551615;

// Expression kinds (ir_lower_words.rs `X_*`).
const X_FOREIGN: u8 = 0;
const X_LITERAL: u8 = 1;
const X_NAME: u8 = 2;
const X_TUPLE: u8 = 3;
const X_STRUCT: u8 = 4;
const X_FIELD: u8 = 5;
const X_INDEX: u8 = 6;
const X_UNARY: u8 = 7;
const X_BINARY: u8 = 8;
const X_ASSIGN: u8 = 9;
const X_BLOCK: u8 = 10;
const X_CALL: u8 = 11;
const X_TRY: u8 = 12;
const X_IF: u8 = 13;
const X_MATCH: u8 = 14;
const X_LOOP: u8 = 15;
const X_FOR: u8 = 16;
const X_RANGE: u8 = 17;
const X_BREAK: u8 = 18;
const X_CONTINUE: u8 = 19;
const X_RETURN: u8 = 20;
const X_CLOSURE: u8 = 21;
const X_HANDLE: u8 = 22;

// One expression. By kind (lists are ranges of `xs`):
// - literal: a = literal kind, b = low word (a string's symbol), c = high;
// - name: a = symbol; tuple: xs[a..a+n] exprs;
// - struct: a = name, xs[b..b+2n] (field, expr) pairs;
// - field: a = base, b = field; index: a = base, b = index;
// - unary: a = op, b = operand; binary, assign: a = op, b, c operands;
// - block: xs[a..a+3n] (is let, pattern, expr) triples, b = tail or NONE;
// - call: a = callee, x = intrinsic class, xs[b..b+2n] (pass, expr)
//   pairs, xs[c..c+m] type ids;
// - try, loop: a; if: a, b, c = else or NONE;
// - match: a = value, xs[b..b+2n] (pattern, body) pairs;
// - for: a = pattern, b = iter, c = body; range: a, b, c = inclusive;
// - break, return: a = value or NONE;
// - closure: a = pool entry, pms[b..b+n] params, c = body, xs[x..x+2m]
//   moves (root, path id);
// - handle: a = its `Hd` row.
pub copy struct Ex {
    kind: u8,
    s0: u64,
    s1: u64,
    a: u64,
    b: u64,
    c: u64,
    n: u64,
    m: u64,
    x: u64,
}

// One pattern: bind: a = name; literal: a = kind, b, c = words;
// tuple: pxs[b..b+n] patterns; constructor: a = name, c = named,
// pxs[b..b+2n] (field, pattern) pairs.
pub copy struct Pt {
    kind: u8,
    s0: u64,
    s1: u64,
    a: u64,
    b: u64,
    c: u64,
    n: u64,
}

// A path: psyms[a..a+n].
pub copy struct PathR {
    a: u64,
    n: u64,
}

// A world function (`world.functions`, in key order).
pub copy struct FnR {
    key: u32,
    name: u32,
    has_body: bool,
    body: u64,
    // params pms[param_start..param_start+param_count]
    param_start: u64,
    param_count: u64,
    result: u32,
    effects: u32,
    // generics gens[generic_start..generic_start+generic_count]
    generic_start: u64,
    generic_count: u64,
    // capabilities caps[cap_start..cap_start+2*cap_count] (label, effect)
    cap_start: u64,
    cap_count: u64,
    // the function a `return` leaves (a handler body's enclosing owner)
    owner: u32,
    // external captures exts[ext_start..ext_start+ext_count]
    ext_start: u64,
    ext_count: u64,
}

// A parameter: projections are path ids projs[proj_start..proj_start+proj_count].
pub copy struct Pm {
    name: u32,
    pass: u8,
    proj_start: u64,
    proj_count: u64,
    ty: u32,
    s0: u64,
    s1: u64,
}

pub copy struct Gn {
    name: u32,
    bound: u8,
    is_row: bool,
}

// An effect declaration: generic names egens[generic_start..generic_start+generic_count],
// operations eops[op_start..op_start+op_count].
pub copy struct Ef {
    name: u32,
    linear: bool,
    generic_start: u64,
    generic_count: u64,
    op_start: u64,
    op_count: u64,
}

// An effect operation: parameters pms[param_start..param_start+param_count] and result type.
pub copy struct Eop {
    name: u32,
    param_start: u64,
    param_count: u64,
    result: u32,
}

// A handler clause: patterns xs[pattern_start..pattern_start+pattern_count], body.
pub copy struct Cl {
    name: u32,
    pattern_start: u64,
    pattern_count: u64,
    body: u64,
}

// A handler (`ExprKind::Handle`): effect label (symbol + 1, or 0), name
// and argument types xs[arg_ty_start..arg_ty_start+arg_ty_count]; state pattern and
// expression (NONE without state); the return clause cls[return_clause] and
// operation clauses cls[return_clause+1..return_clause+1+op_count]; outgoing
// effects (a Row type); moves xs[move_start..move_start+2*move_count].
pub copy struct Hd {
    pool: u64,
    label: u32,
    eff_name: u32,
    arg_ty_start: u64,
    arg_ty_count: u64,
    has_state: bool,
    state_pattern: u64,
    state_expr: u64,
    body: u64,
    return_clause: u64,
    op_count: u64,
    outgoing: u32,
    move_start: u64,
    move_count: u64,
}

pub struct Ast {
    exs: ChunkSeq[Ex],
    xs: ChunkSeq[u64],
    pts: ChunkSeq[Pt],
    pxs: ChunkSeq[u64],
    fns: ChunkSeq[FnR],
    pms: ChunkSeq[Pm],
    projs: ChunkSeq[u64],
    paths: ChunkSeq[PathR],
    psyms: ChunkSeq[u32],
    gens: ChunkSeq[Gn],
    caps: ChunkSeq[u32],
    exts: ChunkSeq[u32],
    // symbol -> function index + 1
    fn_by_key: ChunkSeq[u32],
    effs: ChunkSeq[Ef],
    egens: ChunkSeq[u32],
    eops: ChunkSeq[Eop],
    // symbol -> effect index + 1
    eff_by_name: ChunkSeq[u32],
    hds: ChunkSeq[Hd],
    cls: ChunkSeq[Cl],
    // payload pool entries (closure and handler expressions)
    pub pool_count: u64,
}

pub fn ast_empty() -> Ast {
    Ast {
        exs: ChunkSeq::new[Ex](),
        xs: ChunkSeq::new[u64](),
        pts: ChunkSeq::new[Pt](),
        pxs: ChunkSeq::new[u64](),
        fns: ChunkSeq::new[FnR](),
        pms: ChunkSeq::new[Pm](),
        projs: ChunkSeq::new[u64](),
        paths: ChunkSeq::new[PathR](),
        psyms: ChunkSeq::new[u32](),
        gens: ChunkSeq::new[Gn](),
        caps: ChunkSeq::new[u32](),
        exts: ChunkSeq::new[u32](),
        fn_by_key: ChunkSeq::new[u32](),
        effs: ChunkSeq::new[Ef](),
        egens: ChunkSeq::new[u32](),
        eops: ChunkSeq::new[Eop](),
        eff_by_name: ChunkSeq::new[u32](),
        hds: ChunkSeq::new[Hd](),
        cls: ChunkSeq::new[Cl](),
        pool_count: 0,
    }
}

impl Ast {
    pub fn reserve_lower(
        inout self,
        fns_extra: u64,
        pms_extra: u64,
        caps_extra: u64,
        exts_extra: u64
    ) {
        self.fns.reserve(add(self.fns.len(), fns_extra));
        self.pms.reserve(add(self.pms.len(), pms_extra));
        self.caps.reserve(add(self.caps.len(), caps_extra));
        self.exts.reserve(add(self.exts.len(), exts_extra));
    }

    pub fn clone_tail_in_heap(sink self, n_fns: u64, n_pms: u64) -> Ast {
        let mut ast = self;
        let mut new_fns = ChunkSeq::new[FnR]();
        let fn_tail_count = wrapping_sub(ast.fns.len(), n_fns);
        for i in n_fns..ast.fns.len() {
            match ast.fns.try_get(i) {
                Option::Some(row) => new_fns.push(FnR {
                    key: row.key,
                    name: row.name,
                    has_body: row.has_body,
                    body: row.body,
                    param_start: row.param_start,
                    param_count: row.param_count,
                    result: row.result,
                    effects: row.effects,
                    generic_start: row.generic_start,
                    generic_count: row.generic_count,
                    cap_start: row.cap_start,
                    cap_count: row.cap_count,
                    owner: row.owner,
                    ext_start: row.ext_start,
                    ext_count: row.ext_count
                }),
                Option::None => {},
            }
        }
        for _ in 0..fn_tail_count {
            let _ = ast.fns.pop();
        }
        for i in 0..new_fns.len() {
            match new_fns.try_get(i) {
                Option::Some(row) => ast.fns.push(FnR {
                    key: row.key,
                    name: row.name,
                    has_body: row.has_body,
                    body: row.body,
                    param_start: row.param_start,
                    param_count: row.param_count,
                    result: row.result,
                    effects: row.effects,
                    generic_start: row.generic_start,
                    generic_count: row.generic_count,
                    cap_start: row.cap_start,
                    cap_count: row.cap_count,
                    owner: row.owner,
                    ext_start: row.ext_start,
                    ext_count: row.ext_count
                }),
                Option::None => {},
            }
        }
        let mut new_pms = ChunkSeq::new[Pm]();
        let pm_tail_count = wrapping_sub(ast.pms.len(), n_pms);
        for i in n_pms..ast.pms.len() {
            match ast.pms.try_get(i) {
                Option::Some(row) => new_pms.push(Pm {
                    name: row.name,
                    pass: row.pass,
                    proj_start: row.proj_start,
                    proj_count: row.proj_count,
                    ty: row.ty,
                    s0: row.s0,
                    s1: row.s1
                }),
                Option::None => {},
            }
        }
        for _ in 0..pm_tail_count {
            let _ = ast.pms.pop();
        }
        for i in 0..new_pms.len() {
            match new_pms.try_get(i) {
                Option::Some(row) => ast.pms.push(Pm {
                    name: row.name,
                    pass: row.pass,
                    proj_start: row.proj_start,
                    proj_count: row.proj_count,
                    ty: row.ty,
                    s0: row.s0,
                    s1: row.s1
                }),
                Option::None => {},
            }
        }
        let Ast {
            exs,
            xs,
            pts,
            pxs,
            fns,
            pms,
            projs,
            paths,
            psyms,
            gens,
            caps,
            exts,
            fn_by_key,
            effs,
            egens,
            eops,
            eff_by_name,
            hds,
            cls,
            pool_count,
        } = ast;
        Ast {
            exs: exs,
            xs: xs,
            pts: pts,
            pxs: pxs,
            fns: fns,
            pms: pms,
            projs: projs,
            paths: paths,
            psyms: psyms,
            gens: gens,
            caps: caps,
            exts: exts,
            fn_by_key: fn_by_key,
            effs: effs,
            egens: egens,
            eops: eops,
            eff_by_name: eff_by_name,
            hds: hds,
            cls: cls,
            pool_count: pool_count,
        }
    }

    pub fn deep_clone_in_heap(in self) -> Ast {
        let mut exs = ChunkSeq::with_capacity[Ex](self.exs.len());
        for i in 0..self.exs.len() {
            match self.exs.try_get(i) {
                Option::Some(src) => exs.push(Ex {
                    kind: src.kind,
                    s0: src.s0,
                    s1: src.s1,
                    a: src.a,
                    b: src.b,
                    c: src.c,
                    n: src.n,
                    m: src.m,
                    x: src.x,
                }),
                Option::None => {},
            }
        }
        let mut pts = ChunkSeq::with_capacity[Pt](self.pts.len());
        for i in 0..self.pts.len() {
            match self.pts.try_get(i) {
                Option::Some(src) => pts.push(Pt {
                    kind: src.kind,
                    s0: src.s0,
                    s1: src.s1,
                    a: src.a,
                    b: src.b,
                    c: src.c,
                    n: src.n,
                }),
                Option::None => {},
            }
        }
        let mut fns = ChunkSeq::with_capacity[FnR](self.fns.len());
        for i in 0..self.fns.len() {
            match self.fns.try_get(i) {
                Option::Some(src) => fns.push(FnR {
                    key: src.key,
                    name: src.name,
                    has_body: src.has_body,
                    body: src.body,
                    param_start: src.param_start,
                    param_count: src.param_count,
                    result: src.result,
                    effects: src.effects,
                    generic_start: src.generic_start,
                    generic_count: src.generic_count,
                    cap_start: src.cap_start,
                    cap_count: src.cap_count,
                    owner: src.owner,
                    ext_start: src.ext_start,
                    ext_count: src.ext_count,
                }),
                Option::None => {},
            }
        }
        let mut pms = ChunkSeq::with_capacity[Pm](self.pms.len());
        for i in 0..self.pms.len() {
            match self.pms.try_get(i) {
                Option::Some(src) => pms.push(Pm {
                    name: src.name,
                    pass: src.pass,
                    proj_start: src.proj_start,
                    proj_count: src.proj_count,
                    ty: src.ty,
                    s0: src.s0,
                    s1: src.s1,
                }),
                Option::None => {},
            }
        }
        let mut paths = ChunkSeq::with_capacity[PathR](self.paths.len());
        for i in 0..self.paths.len() {
            match self.paths.try_get(i) {
                Option::Some(src) => paths.push(PathR { a: src.a, n: src.n }),
                Option::None => {},
            }
        }
        let mut gens = ChunkSeq::with_capacity[Gn](self.gens.len());
        for i in 0..self.gens.len() {
            match self.gens.try_get(i) {
                Option::Some(src) => gens.push(Gn {
                    name: src.name,
                    bound: src.bound,
                    is_row: src.is_row
                }),
                Option::None => {},
            }
        }
        let mut effs = ChunkSeq::with_capacity[Ef](self.effs.len());
        for i in 0..self.effs.len() {
            match self.effs.try_get(i) {
                Option::Some(src) => effs.push(Ef {
                    name: src.name,
                    linear: src.linear,
                    generic_start: src.generic_start,
                    generic_count: src.generic_count,
                    op_start: src.op_start,
                    op_count: src.op_count,
                }),
                Option::None => {},
            }
        }
        let mut eops = ChunkSeq::with_capacity[Eop](self.eops.len());
        for i in 0..self.eops.len() {
            match self.eops.try_get(i) {
                Option::Some(src) => eops.push(Eop {
                    name: src.name,
                    param_start: src.param_start,
                    param_count: src.param_count,
                    result: src.result,
                }),
                Option::None => {},
            }
        }
        let mut hds = ChunkSeq::with_capacity[Hd](self.hds.len());
        for i in 0..self.hds.len() {
            match self.hds.try_get(i) {
                Option::Some(src) => hds.push(Hd {
                    pool: src.pool,
                    label: src.label,
                    eff_name: src.eff_name,
                    arg_ty_start: src.arg_ty_start,
                    arg_ty_count: src.arg_ty_count,
                    has_state: src.has_state,
                    state_pattern: src.state_pattern,
                    state_expr: src.state_expr,
                    body: src.body,
                    return_clause: src.return_clause,
                    op_count: src.op_count,
                    outgoing: src.outgoing,
                    move_start: src.move_start,
                    move_count: src.move_count,
                }),
                Option::None => {},
            }
        }
        let mut cls = ChunkSeq::with_capacity[Cl](self.cls.len());
        for i in 0..self.cls.len() {
            match self.cls.try_get(i) {
                Option::Some(src) => cls.push(Cl {
                    name: src.name,
                    pattern_start: src.pattern_start,
                    pattern_count: src.pattern_count,
                    body: src.body,
                }),
                Option::None => {},
            }
        }
        Ast {
            exs: exs,
            xs: copy_seq[u64](in self.xs),
            pts: pts,
            pxs: copy_seq[u64](in self.pxs),
            fns: fns,
            pms: pms,
            projs: copy_seq[u64](in self.projs),
            paths: paths,
            psyms: copy_seq[u32](in self.psyms),
            gens: gens,
            caps: copy_seq[u32](in self.caps),
            exts: copy_seq[u32](in self.exts),
            fn_by_key: copy_seq[u32](in self.fn_by_key),
            effs: effs,
            egens: copy_seq[u32](in self.egens),
            eops: eops,
            eff_by_name: copy_seq[u32](in self.eff_by_name),
            hds: hds,
            cls: cls,
            pool_count: self.pool_count,
        }
    }

    pub fn ex(in self, i: u64) -> Ex {
        match self.exs.try_get(i) {
            Option::Some(row) => row,
            Option::None => Ex {
                kind: X_FOREIGN,
                s0: 0,
                s1: 0,
                a: NONE64,
                b: NONE64,
                c: NONE64,
                n: 0,
                m: 0,
                x: 0
            },
        }
    }

    pub fn pt(in self, i: u64) -> Pt {
        match self.pts.try_get(i) {
            Option::Some(row) => row,
            Option::None => Pt { kind: 0, s0: 0, s1: 0, a: 0, b: 0, c: 0, n: 0 },
        }
    }

    pub fn x(in self, i: u64) -> u64 {
        u64_at(in self.xs, i)
    }

    pub fn px(in self, i: u64) -> u64 {
        u64_at(in self.pxs, i)
    }

    pub fn function(in self, i: u64) -> FnR {
        match self.fns.try_get(i) {
            Option::Some(row) => row,
            Option::None => FnR {
                key: 0,
                name: 0,
                has_body: false,
                body: NONE64,
                param_start: 0,
                param_count: 0,
                result: 0,
                effects: 0,
                generic_start: 0,
                generic_count: 0,
                cap_start: 0,
                cap_count: 0,
                owner: 0,
                ext_start: 0,
                ext_count: 0
            },
        }
    }

    pub fn param(in self, i: u64) -> Pm {
        match self.pms.try_get(i) {
            Option::Some(row) => row,
            Option::None => Pm {
                name: 0,
                pass: 0,
                proj_start: 0,
                proj_count: 0,
                ty: 0,
                s0: 0,
                s1: 0
            },
        }
    }

    pub fn generic(in self, i: u64) -> Gn {
        match self.gens.try_get(i) {
            Option::Some(row) => row,
            Option::None => Gn { name: 0, bound: 0, is_row: false },
        }
    }

    pub fn path(in self, i: u64) -> PathR {
        match self.paths.try_get(i) {
            Option::Some(row) => row,
            Option::None => PathR { a: 0, n: 0 },
        }
    }

    pub fn psym(in self, i: u64) -> u32 {
        u32_at(in self.psyms, i)
    }

    pub fn proj(in self, i: u64) -> u64 {
        u64_at(in self.projs, i)
    }

    pub fn cap(in self, i: u64) -> u32 {
        u32_at(in self.caps, i)
    }

    // The index of the world function keyed `key`, or NONE.
    pub fn fn_index(in self, key: u32) -> u64 {
        if key == NONE32 {
            return NONE64;
        }
        let entry = u32_at(in self.fn_by_key, w(key));
        if entry == 0 {
            NONE64
        } else {
            w(wrapping_sub(entry, 1))
        }
    }

    pub fn effect_decl(in self, i: u64) -> Ef {
        match self.effs.try_get(i) {
            Option::Some(row) => row,
            Option::None => Ef {
                name: 0,
                linear: false,
                generic_start: 0,
                generic_count: 0,
                op_start: 0,
                op_count: 0
            },
        }
    }

    pub fn egen(in self, i: u64) -> u32 {
        u32_at(in self.egens, i)
    }

    pub fn eop(in self, i: u64) -> Eop {
        match self.eops.try_get(i) {
            Option::Some(row) => row,
            Option::None => Eop { name: 0, param_start: 0, param_count: 0, result: 0 },
        }
    }

    pub fn handler(in self, i: u64) -> Hd {
        match self.hds.try_get(i) {
            Option::Some(row) => row,
            Option::None => Hd {
                pool: 0,
                label: 0,
                eff_name: 0,
                arg_ty_start: 0,
                arg_ty_count: 0,
                has_state: false,
                state_pattern: NONE64,
                state_expr: NONE64,
                body: NONE64,
                return_clause: 0,
                op_count: 0,
                outgoing: 0,
                move_start: 0,
                move_count: 0
            },
        }
    }

    pub fn clause(in self, i: u64) -> Cl {
        match self.cls.try_get(i) {
            Option::Some(row) => row,
            Option::None => Cl { name: 0, pattern_start: 0, pattern_count: 0, body: NONE64 },
        }
    }

    // Appends a parameter row; returns its index.
    pub fn add_param(inout self, row: Pm) -> u64 {
        let i = self.pms.len();
        self.pms.push(row);
        i
    }

    // Appends a function row (a nested closure or handler function).
    pub fn add_function(inout self, func: FnR) {
        self.fns.push(func);
    }

    // Appends a capability pair (label, effect).
    pub fn add_cap(inout self, label: u32, eff: u32) {
        self.caps.push(label);
        self.caps.push(eff);
    }

    // Appends an external capture name.
    pub fn add_ext(inout self, name: u32) {
        self.exts.push(name);
    }

    pub fn ext(in self, i: u64) -> u32 {
        u32_at(in self.exts, i)
    }

    // The index of the effect named `name`, or NONE.
    pub fn effect_index(in self, name: u32) -> u64 {
        if name == NONE32 {
            return NONE64;
        }
        let entry = u32_at(in self.eff_by_name, w(name));
        if entry == 0 {
            NONE64
        } else {
            w(wrapping_sub(entry, 1))
        }
    }
}

fn sym(in ctx: Ctx, raw_id: u64) -> u32 {
    u32_at(in ctx.nmap, raw_id)
}

fn tyw(in ctx: Ctx, raw_id: u64) -> u32 {
    u32_at(in ctx.tmap, raw_id)
}

fn read_path(inout reader: Reader, in bytes: Slice[u8], in ctx: Ctx, inout ast: Ast) -> u64 {
    let count = reader.word(in bytes);
    let start = ast.psyms.len();
    for i in 0..count {
        ast.psyms.push(sym(in ctx, reader.word(in bytes)));
    }
    let id = ast.paths.len();
    ast.paths.push(PathR { a: start, n: count });
    id
}

// n, then n parameters (name, pass, projections, type, span).
fn read_params(inout reader: Reader, in bytes: Slice[u8], in ctx: Ctx, inout ast: Ast) -> u64 {
    let n = reader.word(in bytes);
    for i in 0..n {
        let name = sym(in ctx, reader.word(in bytes));
        let pass = wrapping_u8(reader.word(in bytes));
        let proj_count = reader.word(in bytes);
        let mut ids: ChunkSeq[u64] = ChunkSeq::new[u64]();
        for j in 0..proj_count {
            let id = read_path(inout reader, in bytes, in ctx, inout ast);
            ids.push(id);
        }
        let proj_start = ast.projs.len();
        for j in 0..proj_count {
            ast.projs.push(u64_at(in ids, j));
        }
        let ty = tyw(in ctx, reader.word(in bytes));
        let s0 = reader.word(in bytes);
        let s1 = reader.word(in bytes);
        ast.pms.push(Pm {
            name: name,
            pass: pass,
            proj_start: proj_start,
            proj_count: proj_count,
            ty: ty,
            s0: s0,
            s1: s1
        });
    }
    n
}

fn read_literal(inout reader: Reader, in bytes: Slice[u8], in ctx: Ctx, inout expr: Ex) {
    expr.a = reader.word(in bytes);
    expr.b = reader.word(in bytes);
    if expr.a == Lit::String {
        expr.b = w(sym(in ctx, expr.b));
    }
    expr.c = reader.word(in bytes);
}

fn read_pattern(inout reader: Reader, in bytes: Slice[u8], in ctx: Ctx, inout ast: Ast) {
    let kind = wrapping_u8(reader.word(in bytes));
    let mut pat = Pt {
        kind: kind,
        s0: reader.word(in bytes),
        s1: reader.word(in bytes),
        a: 0,
        b: 0,
        c: 0,
        n: 0
    };
    if kind == Pat::Bind {
        pat.a = w(sym(in ctx, reader.word(in bytes)));
    } else if kind == Pat::Literal {
        pat.a = reader.word(in bytes);
        pat.b = reader.word(in bytes);
        if pat.a == Lit::String {
            pat.b = w(sym(in ctx, pat.b));
        }
        pat.c = reader.word(in bytes);
    } else if kind == Pat::Tuple {
        pat.n = reader.word(in bytes);
        pat.b = ast.pxs.len();
        for i in 0..pat.n {
            ast.pxs.push(reader.word(in bytes));
        }
    } else if kind == Pat::Constructor {
        pat.a = w(sym(in ctx, reader.word(in bytes)));
        pat.c = reader.word(in bytes);
        pat.n = reader.word(in bytes);
        pat.b = ast.pxs.len();
        for i in 0..pat.n {
            ast.pxs.push(w(sym(in ctx, reader.word(in bytes))));
            ast.pxs.push(reader.word(in bytes));
        }
    }
    ast.pts.push(pat);
}

fn read_expr(inout reader: Reader, in bytes: Slice[u8], in ctx: Ctx, inout ast: Ast) {
    let kind = wrapping_u8(reader.word(in bytes));
    let mut expr = Ex {
        kind: kind,
        s0: reader.word(in bytes),
        s1: reader.word(in bytes),
        a: NONE64,
        b: NONE64,
        c: NONE64,
        n: 0,
        m: 0,
        x: 0
    };
    if kind == X_LITERAL {
        read_literal(inout reader, in bytes, in ctx, inout expr);
    } else if kind == X_NAME {
        expr.a = w(sym(in ctx, reader.word(in bytes)));
    } else if kind == X_TUPLE {
        expr.n = reader.word(in bytes);
        expr.a = ast.xs.len();
        for i in 0..expr.n {
            ast.xs.push(reader.word(in bytes));
        }
    } else if kind == X_STRUCT {
        expr.a = w(sym(in ctx, reader.word(in bytes)));
        expr.n = reader.word(in bytes);
        expr.b = ast.xs.len();
        for i in 0..expr.n {
            ast.xs.push(w(sym(in ctx, reader.word(in bytes))));
            ast.xs.push(reader.word(in bytes));
        }
    } else if kind == X_FIELD {
        expr.a = reader.word(in bytes);
        expr.b = w(sym(in ctx, reader.word(in bytes)));
    } else if kind == X_INDEX {
        expr.a = reader.word(in bytes);
        expr.b = reader.word(in bytes);
    } else if kind == X_UNARY {
        expr.a = w(sym(in ctx, reader.word(in bytes)));
        expr.b = reader.word(in bytes);
    } else if kind == X_BINARY || kind == X_ASSIGN {
        expr.a = w(sym(in ctx, reader.word(in bytes)));
        expr.b = reader.word(in bytes);
        expr.c = reader.word(in bytes);
    } else if kind == X_BLOCK {
        expr.n = reader.word(in bytes);
        expr.a = ast.xs.len();
        for i in 0..expr.n {
            let is_let = reader.word(in bytes);
            ast.xs.push(is_let);
            if is_let == 1 {
                ast.xs.push(reader.word(in bytes));
            } else {
                ast.xs.push(NONE64);
            }
            ast.xs.push(reader.word(in bytes));
        }
        expr.b = reader.word(in bytes);
    } else if kind == X_CALL {
        expr.a = reader.word(in bytes);
        expr.x = reader.word(in bytes);
        expr.n = reader.word(in bytes);
        expr.b = ast.xs.len();
        for i in 0..expr.n {
            ast.xs.push(reader.word(in bytes));
            ast.xs.push(reader.word(in bytes));
        }
        expr.m = reader.word(in bytes);
        expr.c = ast.xs.len();
        for i in 0..expr.m {
            ast.xs.push(w(tyw(in ctx, reader.word(in bytes))));
        }
    } else if kind == X_TRY || kind == X_LOOP || kind == X_BREAK || kind == X_RETURN {
        expr.a = reader.word(in bytes);
    } else if kind == X_IF || kind == X_FOR || kind == X_RANGE {
        expr.a = reader.word(in bytes);
        expr.b = reader.word(in bytes);
        expr.c = reader.word(in bytes);
    } else if kind == X_MATCH {
        expr.a = reader.word(in bytes);
        expr.n = reader.word(in bytes);
        expr.b = ast.xs.len();
        for i in 0..expr.n {
            ast.xs.push(reader.word(in bytes));
            ast.xs.push(reader.word(in bytes));
        }
    } else if kind == X_CLOSURE {
        expr.a = reader.word(in bytes);
        expr.b = ast.pms.len();
        expr.n = read_params(inout reader, in bytes, in ctx, inout ast);
        expr.c = reader.word(in bytes);
        expr.m = reader.word(in bytes);
        expr.x = ast.xs.len();
        read_moves(inout reader, in bytes, in ctx, inout ast, expr.m);
    } else if kind == X_HANDLE {
        expr.a = ast.hds.len();
        read_handler(inout reader, in bytes, in ctx, inout ast);
    }
    ast.exs.push(expr);
}

// m moves (root, path) into xs as (root symbol, path id) pairs.
fn read_moves(
    inout reader: Reader,
    in bytes: Slice[u8],
    in ctx: Ctx,
    inout ast: Ast,
    move_count: u64
) {
    for i in 0..move_count {
        let root = sym(in ctx, reader.word(in bytes));
        let path_id = read_path(inout reader, in bytes, in ctx, inout ast);
        ast.xs.push(w(root));
        ast.xs.push(path_id);
    }
}

fn read_clause(inout reader: Reader, in bytes: Slice[u8], in ctx: Ctx, inout ast: Ast) {
    let name = sym(in ctx, reader.word(in bytes));
    let pattern_count = reader.word(in bytes);
    let pattern_start = ast.xs.len();
    for i in 0..pattern_count {
        ast.xs.push(reader.word(in bytes));
    }
    let body = reader.word(in bytes);
    ast.cls.push(Cl {
        name: name,
        pattern_start: pattern_start,
        pattern_count: pattern_count,
        body: body
    });
}

fn read_handler(inout reader: Reader, in bytes: Slice[u8], in ctx: Ctx, inout ast: Ast) {
    let pool = reader.word(in bytes);
    let label_word = reader.word(in bytes);
    let label = if label_word == 0 {
        0
    } else {
        inc32w(sym(in ctx, wrapping_sub(label_word, 1)))
    };
    let eff_name = sym(in ctx, reader.word(in bytes));
    let arg_ty_count = reader.word(in bytes);
    let arg_ty_start = ast.xs.len();
    for i in 0..arg_ty_count {
        ast.xs.push(w(tyw(in ctx, reader.word(in bytes))));
    }
    let has_state = reader.word(in bytes) != 0;
    let state_pattern = reader.word(in bytes);
    let state_expr = reader.word(in bytes);
    let body = reader.word(in bytes);
    let op_count = reader.word(in bytes);
    let return_clause = ast.cls.len();
    for i in 0..inc(op_count) {
        read_clause(inout reader, in bytes, in ctx, inout ast);
    }
    let outgoing = tyw(in ctx, reader.word(in bytes));
    let move_count = reader.word(in bytes);
    let move_start = ast.xs.len();
    read_moves(inout reader, in bytes, in ctx, inout ast, move_count);
    ast.hds.push(Hd {
        pool: pool,
        label: label,
        eff_name: eff_name,
        arg_ty_start: arg_ty_start,
        arg_ty_count: arg_ty_count,
        has_state: has_state,
        state_pattern: state_pattern,
        state_expr: state_expr,
        body: body,
        return_clause: return_clause,
        op_count: op_count,
        outgoing: outgoing,
        move_start: move_start,
        move_count: move_count
    });
}

fn inc32w(value: u32) -> u32 {
    wrapping_add(value, 1)
}

// The lowering section, after `read_ctx`.
pub fn read_ast(inout reader: Reader, in bytes: Slice[u8], in ctx: Ctx) -> Ast {
    let mut ast = Ast {
        exs: ChunkSeq::new[Ex](),
        xs: ChunkSeq::new[u64](),
        pts: ChunkSeq::new[Pt](),
        pxs: ChunkSeq::new[u64](),
        fns: ChunkSeq::new[FnR](),
        pms: ChunkSeq::new[Pm](),
        projs: ChunkSeq::new[u64](),
        paths: ChunkSeq::new[PathR](),
        psyms: ChunkSeq::new[u32](),
        gens: ChunkSeq::new[Gn](),
        caps: ChunkSeq::new[u32](),
        fn_by_key: ChunkSeq::new[u32](),
        effs: ChunkSeq::new[Ef](),
        egens: ChunkSeq::new[u32](),
        eops: ChunkSeq::new[Eop](),
        eff_by_name: ChunkSeq::new[u32](),
        hds: ChunkSeq::new[Hd](),
        cls: ChunkSeq::new[Cl](),
        pool_count: 0,
        exts: ChunkSeq::new[u32](),
    };
    ast.pool_count = reader.word(in bytes);
    let fn_count = reader.word(in bytes);
    for i in 0..fn_count {
        let key = sym(in ctx, reader.word(in bytes));
        let name = sym(in ctx, reader.word(in bytes));
        let has_body = reader.word(in bytes) != 0;
        let body = reader.word(in bytes);
        let param_start = ast.pms.len();
        let param_count = read_params(inout reader, in bytes, in ctx, inout ast);
        let result = tyw(in ctx, reader.word(in bytes));
        let effects = tyw(in ctx, reader.word(in bytes));
        let generic_count = reader.word(in bytes);
        let generic_start = ast.gens.len();
        for j in 0..generic_count {
            let generic = Gn {
                name: sym(in ctx, reader.word(in bytes)),
                bound: wrapping_u8(reader.word(in bytes)),
                is_row: reader.word(in bytes) != 0
            };
            ast.gens.push(generic);
        }
        let cap_count = reader.word(in bytes);
        let cap_start = ast.caps.len();
        for j in 0..cap_count {
            ast.caps.push(sym(in ctx, reader.word(in bytes)));
            ast.caps.push(sym(in ctx, reader.word(in bytes)));
        }
        ast.fns.push(FnR {
            key: key,
            name: name,
            has_body: has_body,
            body: body,
            param_start: param_start,
            param_count: param_count,
            result: result,
            effects: effects,
            generic_start: generic_start,
            generic_count: generic_count,
            cap_start: cap_start,
            cap_count: cap_count,
            owner: name,
            ext_start: 0,
            ext_count: 0
        });
        set_by_symbol(inout ast.fn_by_key, key, n32(inc(i)));
    }
    let effect_count = reader.word(in bytes);
    for i in 0..effect_count {
        let name = sym(in ctx, reader.word(in bytes));
        let linear = reader.word(in bytes) != 0;
        let generic_count = reader.word(in bytes);
        let generic_start = ast.egens.len();
        for j in 0..generic_count {
            ast.egens.push(sym(in ctx, reader.word(in bytes)));
        }
        let op_count = reader.word(in bytes);
        let op_start = ast.eops.len();
        for j in 0..op_count {
            let op = sym(in ctx, reader.word(in bytes));
            let param_start = ast.pms.len();
            let param_count = read_params(inout reader, in bytes, in ctx, inout ast);
            let result = tyw(in ctx, reader.word(in bytes));
            ast.eops.push(Eop {
                name: op,
                param_start: param_start,
                param_count: param_count,
                result: result
            });
        }
        ast.effs.push(Ef {
            name: name,
            linear: linear,
            generic_start: generic_start,
            generic_count: generic_count,
            op_start: op_start,
            op_count: op_count
        });
        set_by_symbol(inout ast.eff_by_name, name, n32(inc(i)));
    }
    let pattern_count = reader.word(in bytes);
    for i in 0..pattern_count {
        read_pattern(inout reader, in bytes, in ctx, inout ast);
    }
    let expr_count = reader.word(in bytes);
    for i in 0..expr_count {
        read_expr(inout reader, in bytes, in ctx, inout ast);
    }
    ast
}
