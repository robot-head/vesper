// The CFG extractor's emitter (src/lean_ir.rs `Emitter`): per block one
// `partial def $block_f_b` over the block's live locals whose body is
// `Id.run do` of the block's instructions and a `pure` call of the next
// block, then `partial def f` over the parameters, calling block 0.
//
// Errors keep Rust's order. The printer's stream is prefix order, but Rust
// builds some nodes' parts out of that order (a definition's binders and
// body before its name and result type, an application's arguments before
// its function): those parts are written quietly (`B::quiet`) or with
// `emit_ty`, and checked afterwards in Rust's order. A term Rust builds
// before the node that holds it (an updated place's new value) is written
// first and moved into place (`B::cut`, `B::paste`).

use @vesper/check-data::types::{Types, substitute, TyKind, TyPass};
use @vesper/check-data::util::{add, inc, n32, u32_at, u64_at, w};
use @vesper/check-data::world::{Adt, Variant, World, constructor};
use @vesper/place-ir::{InstRow, Program};
use self::build::{
    B, B_EXPLICIT, B_IMPLICIT, D_DEF, K_PARTIAL, OP_ADD, OP_BOOL_AND, OP_BOOL_EQ, OP_BOOL_NE,
    OP_BOOL_OR, OP_DIV, OP_GE, OP_GT, OP_LE, OP_LT, OP_MOD, OP_MUL, OP_SUB, P_BIND, P_BOOL, P_CTOR,
    P_INT, P_STRING, P_TUPLE, P_WILD, S_LET, T_APP, T_ASCRIBE, T_BOOL, T_DO, T_FUN, T_IF, T_MATCH,
    T_NAT, T_PRODUCT, T_PROJECT, T_REF, T_STRING, T_TUPLE, T_UNARY, T_UPDATE, U_BOOL_NOT, U_NEG,
    put_decimal
};
use self::ty::{emit_ty, spells, ty_check};
use self::fn_input::{Fns, Sig, SigParam};
use self::cfg::{
    ARG_WORDS, Fun, NONE32, NONE64, arg_at, arm_bindings, block_has, block_params, fun, liveness,
    pattern_end, set_next, takes
};
use @vesper/place-ir::codes::{Lit, Op, Pat, Term};

pub const LOOP_REFUSAL: Str = "Lean extraction does not model loop, for, break or return yet; write the iteration as a tail-recursive function";

// What the emitter reads besides the builder and the type table.
pub struct X {
    program: Program,
    world: World,
    fns: Fns,
    fip: bool,
    // `recursive_structs`, by ADT index
    recursive_structs: ChunkSeq[bool],
    // program function index + 1, by name symbol
    fn_by_name: ChunkSeq[u32],
}

// One function's emitter state.
pub struct S {
    func: Fun,
    live: ChunkSeq[u64],
    arms: ChunkSeq[u64],
    sig: Sig,
}

fn put(inout out: ChunkSeq[u8], in text: Str) {
    out.extend(in text.as_bytes());
}

// ----- small terms ----------------------------------------------------------------

// `$value{v}`.
fn value_sym(inout builder: B, v: u64) -> u32 {
    builder.numbered(in "$value", v)
}

fn value(inout builder: B, value_id: u64) {
    let sym = value_sym(inout builder, value_id);
    builder.sref(sym);
}

// `Pure.pure(...)`: write the argument after it.
fn pure_app(inout builder: B) {
    let mark = builder.app(1);
    builder.global2(in "Pure", in "pure");
    builder.args(mark);
    builder.arg();
}

// A one-argument application of a fixed global; write the argument after.
fn global_app(inout builder: B, in namespace: Str, in member: Str) {
    let mark = builder.app(1);
    builder.global2(in namespace, in member);
    builder.args(mark);
    builder.arg();
}

fn global_app2(inout builder: B, in namespace: Str, in member: Str) -> u64 {
    let mark = builder.app(2);
    builder.global2(in namespace, in member);
    builder.args(mark);
    mark
}

// `project(value, "toNat")`.
fn to_nat_of_value(inout builder: B, value_id: u64) {
    builder.w(T_PROJECT);
    value(inout builder, value_id);
    builder.w(0);
    builder.text(in "toNat");
}

fn unit_tuple(inout builder: B) {
    builder.w(T_TUPLE);
    builder.w(0);
}

// The local behind bit `bit`: its raw name's symbol.
fn local_sym(inout builder: B, in func: Fun, bit: u64) -> u32 {
    if bit < func.nlocals() {
        u32_at(in func.local_names, bit)
    } else {
        let value_id = u64_at(in func.value_ids, wrapping_sub(bit, func.nlocals()));
        value_sym(inout builder, value_id)
    }
}

fn typ(inout builder: B, in types: Types, in env: X, ty: u32) {
    ty_check(inout builder, in types, ty, env.fip);
    emit_ty(inout builder, in types, ty, env.fip);
}

// `Name::qualified([ident(a), ident(b)])` written quietly; `name2_check`
// makes its checks.
fn name2_quiet(inout builder: B, rooted: bool, a: u32, c: u32) {
    builder.w(if rooted { 1 } else { 0 });
    builder.w(2);
    builder.sym(a);
    builder.sym(c);
}

fn name2_check(inout builder: B, a: u32, c: u32) {
    builder.check(a, in "identifier");
    builder.check(c, in "identifier");
}

// `$block_{f}_{b}`.
fn block_sym(inout builder: B, in func: Fun, block_index: u64) -> u32 {
    let mut spelling: ChunkSeq[u8] = ChunkSeq::new[u8]();
    put(inout spelling, in "$block_");
    builder.names.write(func.row.name, inout spelling);
    put(inout spelling, in "_");
    put_decimal(inout spelling, block_index);
    builder.names.intern(in spelling.as_slice())
}

// The non-row generics of a signature.
fn generic_count(in env: X, sig: Sig) -> u64 {
    let mut count: u64 = 0;
    for i in 0..sig.gn {
        if !env.fns.generic(sig, i).row {
            count = inc(count);
        }
    }
    count
}

// `type_params`: `{T : Type}` per non-row generic.
fn type_params(inout builder: B, in env: X, sig: Sig) {
    for i in 0..sig.gn {
        let generic = env.fns.generic(sig, i);
        if !generic.row {
            builder.w(B_IMPLICIT);
            builder.w(1);
            builder.ident(generic.name);
            builder.type0();
        }
    }
}

// `generic_args`: `(T := T)` per non-row generic, as arguments.
fn generic_args(inout builder: B, in env: X, sig: Sig) {
    for i in 0..sig.gn {
        let generic = env.fns.generic(sig, i);
        if !generic.row {
            builder.w(1);
            builder.ident(generic.name);
            builder.sref(generic.name);
        }
    }
}

// The inout parameters of the function.
fn inout_count(in func: Fun) -> u64 {
    let mut count: u64 = 0;
    for k in 0..func.params.len() {
        if func.param(k).pass == TyPass::Inout {
            count = inc(count);
        }
    }
    count
}

// `result_type` without its checks.
fn result_type(inout builder: B, in types: Types, in env: X, in func: Fun) {
    let inout_params = inout_count(in func);
    if inout_params > 0 {
        builder.w(T_PRODUCT);
        builder.w(inc(inout_params));
    }
    emit_ty(inout builder, in types, func.result, env.fip);
    for k in 0..func.params.len() {
        let param_row = func.param(k);
        if param_row.pass == TyPass::Inout {
            emit_ty(inout builder, in types, param_row.ty, env.fip);
        }
    }
}

fn result_check(inout builder: B, in types: Types, in env: X, in func: Fun) {
    ty_check(inout builder, in types, func.result, env.fip);
    for k in 0..func.params.len() {
        let param_row = func.param(k);
        if param_row.pass == TyPass::Inout {
            ty_check(inout builder, in types, param_row.ty, env.fip);
        }
    }
}

// The number of live locals of block `block_index`.
fn live_count(in emitter: S, block_index: u64) -> u64 {
    let mut count: u64 = 0;
    let mut bit = set_next_in(in emitter, block_index, 0);
    loop {
        if bit == NONE64 {
            break;
        }
        count = inc(count);
        bit = set_next_in(in emitter, block_index, inc(bit));
    }
    count
}

// The next live local of block `block_index` at or after bit `from`, or NONE64.
fn set_next_in(in emitter: S, block_index: u64, from: u64) -> u64 {
    let mut bit = from;
    loop {
        if bit >= emitter.func.set_bits {
            return NONE64;
        }
        if block_has(in emitter.live, block_index, emitter.func.set_words, bit) {
            return bit;
        }
        bit = inc(bit);
    }
}

// `call_block(k, replacements)`: the replacements are the jump's
// arguments at `args` (NONE64 for none) for the target's parameters.
fn call_block(inout builder: B, in env: X, in emitter: S, block_index: u64, args: u64) {
    let arity = add(generic_count(in env, emitter.sig), live_count(in emitter, block_index));
    let mark = builder.app(arity);
    let name = block_sym(inout builder, in emitter.func, block_index);
    builder.quiet = inc(builder.quiet);
    builder.sref(name);
    builder.quiet = wrapping_sub(builder.quiet, 1);
    builder.args(mark);
    generic_args(inout builder, in env, emitter.sig);
    let target_block = emitter.func.block(in env.program, block_index);
    let params_at = block_params(in env.program, target_block);
    let mut bit = set_next_in(in emitter, block_index, 0);
    loop {
        if bit == NONE64 {
            break;
        }
        builder.arg();
        let mut done = false;
        if bit >= emitter.func.nlocals() && args != NONE64 {
            let value_id = u64_at(
                in emitter.func.value_ids,
                wrapping_sub(bit, emitter.func.nlocals())
            );
            let jump_arg_count = env.program.op(args);
            let param_count = env.program.op(params_at);
            for j in 0..jump_arg_count {
                if !done && j < param_count && env.program.op(add(inc(params_at), j)) == value_id {
                    value(inout builder, env.program.op(add(inc(args), j)));
                    done = true;
                }
            }
        }
        if !done {
            let local_name = local_sym(inout builder, in emitter.func, bit);
            builder.sref(local_name);
        }
        bit = set_next_in(in emitter, block_index, inc(bit));
    }
    builder.check(name, in "name");
}

// ----- types and constructors -----------------------------------------------------

// `IntegerKind::from_type(ty).is_some_and(signed)`.
fn signed_kind(in builder: B, in types: Types, ty: u32) -> bool {
    if ty == NONE32 {
        return false;
    }
    let node = types.node(ty);
    if node.kind == TyKind::Lit {
        return !(node.mode == 0 && wrapping_u64(node.lit) > 9223372036854775807);
    }
    if node.kind != TyKind::Named {
        return false;
    }
    spells(in builder, node.name, in "i8")
        || spells(in builder, node.name, in "i16")
        || spells(in builder, node.name, in "i32")
        || spells(in builder, node.name, in "i64")
        || spells(in builder, node.name, in "isize")
        || spells(in builder, node.name, in "i128")
}

// `World::constructor(name)`: (adt index << 32) + variant index, or NONE64.
pub fn lookup_constructor(inout builder: B, in world: World, name: u32) -> u64 {
    let len = builder.names.size(name);
    let mut sep_count: u64 = 0;
    let mut last_sep: u64 = 0;
    let mut i: u64 = 0;
    loop {
        if inc(i) >= len {
            break;
        }
        if builder.names.byte(name, i) == 58 && builder.names.byte(name, inc(i)) == 58 {
            sep_count = inc(sep_count);
            last_sep = i;
            i = add(i, 2);
        } else {
            i = inc(i);
        }
    }
    if sep_count > 1 {
        return NONE64;
    }
    if sep_count == 0 {
        return constructor(in world, NONE32, name);
    }
    let mut qualifier: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut rest: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for j in 0..len {
        let byte = builder.names.byte(name, j);
        if j < last_sep {
            qualifier.push(byte);
        } else if j >= add(last_sep, 2) {
            rest.push(byte);
        }
    }
    let qualifier_sym = builder.names.lookup(in qualifier.as_slice());
    let rest_sym = builder.names.lookup(in rest.as_slice());
    if qualifier_sym == NONE32 || rest_sym == NONE32 {
        return NONE64;
    }
    constructor(in world, qualifier_sym, rest_sym)
}

pub fn adt_of(in world: World, ctor: u64) -> Adt {
    world.adt(n32(wrapping_shr_u64(ctor, 32)))
}

pub fn variant_of(in world: World, ctor: u64) -> Variant {
    world.variant(ctor & 4294967295)
}

// `Emitter::constructor` written quietly; `constructor_check` checks it.
fn constructor_name(inout builder: B, in world: World, ctor: u64) {
    let adt = adt_of(in world, ctor);
    let variant = variant_of(in world, ctor);
    if spells(in builder, adt.name, in "Option") && spells(in builder, variant.name, in "Some") {
        builder.w(1);
        builder.w(2);
        builder.text(in "Option");
        builder.text(in "some");
    } else if spells(in builder, adt.name, in "Option")
        && spells(in builder, variant.name, in "None") {
        builder.w(1);
        builder.w(2);
        builder.text(in "Option");
        builder.text(in "none");
    } else if spells(in builder, adt.name, in "Result")
        && spells(in builder, variant.name, in "Ok") {
        builder.w(1);
        builder.w(2);
        builder.text(in "Except");
        builder.text(in "ok");
    } else if spells(in builder, adt.name, in "Result")
        && spells(in builder, variant.name, in "Err") {
        builder.w(1);
        builder.w(2);
        builder.text(in "Except");
        builder.text(in "error");
    } else if adt.is_enum {
        name2_quiet(inout builder, false, adt.name, variant.name);
    } else {
        let mk_sym = builder.intern(in "mk");
        name2_quiet(inout builder, false, adt.name, mk_sym);
    }
}

fn constructor_check(inout builder: B, in world: World, ctor: u64) {
    let adt = adt_of(in world, ctor);
    let variant = variant_of(in world, ctor);
    let special = (
        spells(in builder, adt.name, in "Option")
            && (
                spells(in builder, variant.name, in "Some")
                    || spells(in builder, variant.name, in "None")
            )
    )
        || (
            spells(in builder, adt.name, in "Result")
                && (
                    spells(in builder, variant.name, in "Ok")
                        || spells(in builder, variant.name, in "Err")
                )
        );
    if special {
        return;
    }
    builder.check(adt.name, in "identifier");
    if adt.is_enum {
        builder.check(variant.name, in "identifier");
    }
}

// `World::field(ty, [field])`, or NONE32.
fn field_type(inout types: Types, in builder: B, in world: World, ty: u32, field: u32) -> u32 {
    if ty == NONE32 {
        return NONE32;
    }
    let node = types.node(ty);
    if node.kind == TyKind::Tuple {
        let index = parse_index(in builder, field);
        if index == NONE64 || index >= w(node.n) {
            return NONE32;
        }
        return types.arg(ty, index);
    }
    if node.kind != TyKind::Named {
        return NONE32;
    }
    let mut adt_ty = ty;
    if spells(in builder, node.name, in "TiledSeq") {
        if node.n == 0 {
            return NONE32;
        }
        adt_ty = types.arg(ty, 0);
        let elem_node = types.node(adt_ty);
        if elem_node.kind != TyKind::Named {
            return NONE32;
        }
        let adt_index = world.lookup(elem_node.name);
        if adt_index == NONE32 {
            return NONE32;
        }
        let adt = world.adt(adt_index);
        if adt.is_enum || adt.tile == 0 {
            return NONE32;
        }
    } else if spells(in builder, node.name, in "ChunkSeq")
        || spells(in builder, node.name, in "Slice")
        || spells(in builder, node.name, in "String")
        || spells(in builder, node.name, in "Str") {
        // Interval and view loans of sequences and strings are not places
        // the CFG extractor updates.
        return NONE32;
    }
    let adt_node = types.node(adt_ty);
    let adt_index = world.lookup(adt_node.name);
    if adt_index == NONE32 {
        return NONE32;
    }
    let adt = world.adt(adt_index);
    if adt.is_enum {
        return NONE32;
    }
    let variant = world.variant(w(adt.va));
    let field_index = world.find_field(variant, field);
    if field_index == NONE32 {
        return NONE32;
    }
    let vars = world.vars_of(in types, adt, adt_ty);
    let field_ty = world.field(w(field_index)).ty;
    substitute(inout types, field_ty, in vars)
}

// A projection's field as a tuple index (`str::parse::<usize>`), or NONE64.
pub fn parse_index(in builder: B, sym: u32) -> u64 {
    let len = builder.names.size(sym);
    if len == 0 {
        return NONE64;
    }
    let mut start: u64 = 0;
    if builder.names.byte(sym, 0) == 43 {
        start = 1;
        if len == 1 {
            return NONE64;
        }
    }
    let mut value: u64 = 0;
    for i in start..len {
        let byte = builder.names.byte(sym, i);
        if byte < 48 || byte > 57 {
            return NONE64;
        }
        let next = wrapping_add(wrapping_mul(value, 10), widen_u64(wrapping_sub(byte, 48)));
        if value > 1844674407370955161 || next < value {
            return NONE64;
        }
        value = next;
    }
    value
}

// ----- projections and updates ----------------------------------------------------

// `project(base, path, ty)` (src/lean_ir.rs) is the base under projections:
// `proj_count` counts them, `proj_tail` writes them after the base and
// raises the out-of-range tuple error where Rust does.
fn proj_count(in builder: B, in types: Types, in path: ChunkSeq[u32], ty: u32) -> u64 {
    let mut cur = ty;
    let mut count: u64 = 0;
    for i in 0..path.len() {
        let field = u32_at(in path, i);
        let node = types.node(cur);
        let index = parse_index(in builder, field);
        if cur != NONE32 && node.kind == TyKind::Tuple && index != NONE64 {
            if index >= w(node.n) {
                return count;
            }
            count = add(count, index);
            if inc(index) < w(node.n) {
                count = inc(count);
            }
            cur = types.arg(cur, index);
        } else {
            count = inc(count);
            cur = NONE32;
        }
    }
    count
}

fn proj_tail(inout builder: B, in types: Types, in path: ChunkSeq[u32], ty: u32) {
    let mut cur = ty;
    for i in 0..path.len() {
        let field = u32_at(in path, i);
        let node = types.node(cur);
        let index = parse_index(in builder, field);
        if cur != NONE32 && node.kind == TyKind::Tuple && index != NONE64 {
            if index >= w(node.n) {
                builder.fail(in "tuple projection is outside Lean tuple type");
                return;
            }
            for j in 0..index {
                builder.w(1);
                builder.w(2);
            }
            if inc(index) < w(node.n) {
                builder.w(1);
                builder.w(1);
            }
            cur = types.arg(cur, index);
        } else {
            builder.w(0);
            builder.ident(field);
            cur = NONE32;
        }
    }
}

// `project(source_ref(root), path, ty)`.
fn project_ref(inout builder: B, in types: Types, root: u32, in path: ChunkSeq[u32], ty: u32) {
    let count = proj_count(in builder, in types, in path, ty);
    for i in 0..count {
        builder.w(T_PROJECT);
    }
    builder.sref(root);
    proj_tail(inout builder, in types, in path, ty);
}

// `project(value(v), path, ty)`.
fn project_value(
    inout builder: B,
    in types: Types,
    value_id: u64,
    in path: ChunkSeq[u32],
    ty: u32
) {
    let count = proj_count(in builder, in types, in path, ty);
    for i in 0..count {
        builder.w(T_PROJECT);
    }
    value(inout builder, value_id);
    proj_tail(inout builder, in types, in path, ty);
}

// The base of an update at depth `depth`: `root.f1.f2...fd` as field
// projections.
fn update_base(inout builder: B, root: u32, in path: ChunkSeq[u32], depth: u64) {
    for i in 0..depth {
        builder.w(T_PROJECT);
    }
    builder.sref(root);
    for i in 0..depth {
        builder.w(0);
        builder.ident(u32_at(in path, i));
    }
}

// `update_place_typed(world, place, value, root_ty, rec)`: `value` was
// written and cut out already.
fn update(
    inout builder: B,
    inout types: Types,
    in env: X,
    root: u32,
    in path: ChunkSeq[u32],
    depth: u64,
    ty: u32,
    in value: ChunkSeq[u64]
) {
    if depth >= path.len() {
        builder.paste(in value);
        return;
    }
    let field = u32_at(in path, depth);
    let field_ty = field_type(inout types, in builder, in env.world, ty, field);
    builder.check(field, in "identifier");
    let node = types.node(ty);
    let mut adt_index = NONE32;
    if ty != NONE32 && node.kind == TyKind::Named {
        adt_index = env.world.lookup(node.name);
    }
    let mut is_rec = false;
    if adt_index != NONE32 {
        is_rec = env.recursive_structs.try_get(w(adt_index)).unwrap_or(false);
    }
    if is_rec {
        let adt = env.world.adt(adt_index);
        let variant = env.world.variant(w(adt.va));
        let mark = builder.app(w(variant.fc));
        builder.w(T_REF);
        let mk_sym = builder.intern(in "mk");
        name2_quiet(inout builder, false, adt.name, mk_sym);
        builder.args(mark);
        for i in 0..w(variant.fc) {
            let field_row = env.world.field(add(w(variant.fa), i));
            builder.arg();
            if field_row.name == field {
                update(
                    inout builder,
                    inout types,
                    in env,
                    root,
                    in path,
                    inc(depth),
                    field_ty,
                    in value
                );
            } else {
                // lean_nodes::project: a fixed identifier, never refused
                builder.w(T_PROJECT);
                builder.quiet = inc(builder.quiet);
                update_base(inout builder, root, in path, depth);
                builder.w(0);
                builder.ident(field_row.name);
                builder.quiet = wrapping_sub(builder.quiet, 1);
            }
        }
        name2_check(inout builder, adt.name, mk_sym);
        return;
    }
    builder.w(T_UPDATE);
    builder.w(1);
    update_base(inout builder, root, in path, depth);
    builder.ident(field);
    update(inout builder, inout types, in env, root, in path, inc(depth), field_ty, in value);
}

// The path of place-ir path `i` as symbols.
fn ir_path(in program: Program, i: u64) -> ChunkSeq[u32] {
    let row = program.path(i);
    let mut out: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for k in 0..row.n {
        out.push(program.path_name(i, k));
    }
    out
}

// `let root := update(place, <cut value>)`.
fn let_update(
    inout builder: B,
    inout types: Types,
    in env: X,
    in func: Fun,
    root: u32,
    in path: ChunkSeq[u32],
    in value: ChunkSeq[u64]
) {
    builder.w(S_LET);
    builder.w(0);
    builder.w(P_BIND);
    builder.ident(root);
    builder.w(0);
    update(inout builder, inout types, in env, root, in path, 0, func.local_ty(root), in value);
}

// A `Write` place `a.b.c`: the root symbol and the path.
fn split_place(inout builder: B, sym: u32, inout path: ChunkSeq[u32]) -> u32 {
    let len = builder.names.size(sym);
    let mut part: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut root = NONE32;
    for i in 0..len {
        let byte = builder.names.byte(sym, i);
        if byte == 46 {
            let part_sym = builder.names.intern(in part.as_slice());
            if root == NONE32 {
                root = part_sym;
            } else {
                path.push(part_sym);
            }
            part.clear();
        } else {
            part.push(byte);
        }
    }
    let part_sym = builder.names.intern(in part.as_slice());
    if root == NONE32 {
        root = part_sym;
    } else {
        path.push(part_sym);
    }
    root
}

// ----- literals ---------------------------------------------------------------------

// The decimal digits of the 128-bit magnitude (hi, lo).
pub fn put_u128(inout out: ChunkSeq[u8], hi: u64, lo: u64) {
    if hi == 0 {
        put_decimal(inout out, lo);
        return;
    }
    // Long division by 10 over 32-bit limbs, most significant first.
    let mut limbs: ChunkSeq[u64] = ChunkSeq::new[u64]();
    limbs.push(wrapping_shr_u64(hi, 32));
    limbs.push(hi & 4294967295);
    limbs.push(wrapping_shr_u64(lo, 32));
    limbs.push(lo & 4294967295);
    let mut digits: ChunkSeq[u8] = ChunkSeq::new[u8]();
    loop {
        let mut zero = true;
        let mut rem: u64 = 0;
        for i in 0..4 {
            let cur = wrapping_add(wrapping_shl_u64(rem, 32), u64_at(in limbs, i));
            let quotient = cur / 10;
            rem = cur % 10;
            let ok = limbs.try_set(i, quotient);
            if quotient != 0 {
                zero = false;
            }
        }
        digits.push(wrapping_u8(wrapping_add(rem, 48)));
        if zero {
            break;
        }
    }
    let mut i = digits.len();
    loop {
        if i == 0 {
            break;
        }
        i = wrapping_sub(i, 1);
        match digits.try_get(i) {
            Option::Some(digit) => out.push(digit),
            Option::None => {},
        }
    }
}

fn nat_u128(inout builder: B, hi: u64, lo: u64) {
    let mut digits: ChunkSeq[u8] = ChunkSeq::new[u8]();
    put_u128(inout digits, hi, lo);
    let sym = builder.names.intern(in digits.as_slice());
    builder.w(T_NAT);
    builder.sym(sym);
}

fn nat_u64(inout builder: B, value: u64) {
    nat_u128(inout builder, 0, value);
}

// `(x as f32).to_bits()` of the f64 with bits `bits`, round to nearest even.
pub fn f32_bits(bits: u64) -> u64 {
    let sign = wrapping_shl_u64(wrapping_shr_u64(bits, 63), 31);
    let exp = wrapping_shr_u64(bits, 52) & 2047;
    let mant = bits & 4503599627370495;
    if exp == 2047 {
        if mant == 0 {
            return sign | 2139095040;
        }
        return sign | 2143289344 | wrapping_shr_u64(mant, 29);
    }
    if exp == 0 {
        return sign;
    }
    let significand = mant | 4503599627370496;
    // the f32 exponent field, before rounding
    let biased_exp = wrapping_sub(wrapping_add(exp, 127), 1023);
    let signed_exp = wrapping_i64(biased_exp);
    if signed_exp >= 255 {
        return sign | 2139095040;
    }
    let mut shift: u64 = 29;
    if signed_exp <= 0 {
        shift = wrapping_add(30, wrapping_u64(wrapping_sub(0, signed_exp)));
    }
    if shift >= 64 {
        return sign;
    }
    let mut rounded = wrapping_shr_u64(significand, wrapping_u32(shift));
    let rem = significand & wrapping_sub(wrapping_shl_u64(1, wrapping_u32(shift)), 1);
    let half = wrapping_shl_u64(1, wrapping_u32(wrapping_sub(shift, 1)));
    if rem > half || (rem == half && (rounded & 1) != 0) {
        rounded = inc(rounded);
    }
    if signed_exp <= 0 {
        return sign | rounded;
    }
    // q has the hidden bit at 2^23; a carry to 2^24 bumps the exponent.
    sign | wrapping_add(wrapping_shl_u64(biased_exp, 23), wrapping_sub(rounded, 8388608))
}

// `typed_literal(l, ty)` for the literal at `i` (kind, lo or symbol, hi).
fn literal(inout builder: B, in types: Types, in env: X, i: u64, ty: u32) {
    let kind = env.program.op(i);
    let lo = env.program.op(inc(i));
    let hi = env.program.op(add(i, 2));
    if kind == Lit::Int {
        if wrapping_shr_u64(hi, 63) != 0 {
            // the magnitude of a negative i128
            let neg_lo = wrapping_add(lo ^ 18446744073709551615, 1);
            let mut neg_hi = hi ^ 18446744073709551615;
            if neg_lo == 0 {
                neg_hi = wrapping_add(neg_hi, 1);
            }
            builder.w(T_UNARY);
            builder.w(U_NEG);
            nat_u128(inout builder, neg_hi, neg_lo);
        } else {
            nat_u128(inout builder, hi, lo);
        }
    } else if kind == Lit::WideInt {
        nat_u128(inout builder, hi, lo);
    } else if kind == Lit::Float {
        let node = types.node(ty);
        if node.kind == TyKind::Named && spells(in builder, node.name, in "f32") {
            global_app(inout builder, in "Float32", in "ofBits");
            nat_u64(inout builder, f32_bits(lo));
        } else {
            global_app(inout builder, in "Float", in "ofBits");
            nat_u64(inout builder, lo);
        }
    } else if kind == Lit::Bool {
        builder.w(T_BOOL);
        builder.w(lo);
    } else {
        builder.w(T_STRING);
        builder.sym(n32(lo));
    }
}

// ----- patterns ---------------------------------------------------------------------

// Whether the pattern at `i` is a built-in `Box` pattern (`is_box_pattern`).
fn box_pattern(inout builder: B, in env: X, i: u64) -> bool {
    if !env.fip || env.program.op(i) != Pat::Constructor {
        return false;
    }
    let name = n32(env.program.op(add(i, 3)));
    let field_count = env.program.op(add(i, 5));
    if !(spells(in builder, name, in "Box") || spells(in builder, name, in "Box::Box"))
        || field_count != 1 {
        return false;
    }
    spells(in builder, n32(env.program.op(add(i, 6))), in "0")
}

// `Emitter::pattern` of the pattern at `i`.
fn pattern(inout builder: B, in types: Types, in env: X, i: u64) {
    if box_pattern(inout builder, in env, i) {
        pattern(inout builder, in types, in env, add(i, 7));
        return;
    }
    let kind = env.program.op(i);
    let payload = add(i, 3);
    if kind == Pat::Bind {
        builder.w(P_BIND);
        builder.ident(n32(env.program.op(payload)));
    } else if kind == Pat::Wild {
        builder.w(P_WILD);
    } else if kind == Pat::Literal {
        let lit_kind = env.program.op(payload);
        if lit_kind == Lit::Int {
            builder.w(P_INT);
            builder.w(env.program.op(inc(payload)));
            builder.w(env.program.op(add(payload, 2)));
        } else if lit_kind == Lit::Bool {
            builder.w(P_BOOL);
            builder.w(env.program.op(inc(payload)));
        } else if lit_kind == Lit::String {
            builder.w(P_STRING);
            builder.sym(n32(env.program.op(inc(payload))));
        } else if lit_kind == Lit::WideInt {
            builder.fail(in "128-bit literal patterns are unsupported in Lean extraction");
            builder.w(P_WILD);
        } else {
            builder.fail(in "floating-point patterns are unsupported in Lean extraction");
            builder.w(P_WILD);
        }
    } else if kind == Pat::Tuple {
        let count = env.program.op(payload);
        if count != 1 {
            builder.w(P_TUPLE);
            builder.w(count);
        }
        let mut cursor = inc(payload);
        for m in 0..count {
            pattern(inout builder, in types, in env, cursor);
            cursor = pattern_end(in env.program, cursor);
        }
    } else if kind == Pat::Constructor {
        let ctor = lookup_constructor(inout builder, in env.world, n32(env.program.op(payload)));
        if ctor == NONE64 {
            builder.fail(in "unknown Lean pattern");
            builder.w(P_WILD);
            return;
        }
        let variant = variant_of(in env.world, ctor);
        builder.w(P_CTOR);
        builder.quiet = inc(builder.quiet);
        constructor_name(inout builder, in env.world, ctor);
        builder.quiet = wrapping_sub(builder.quiet, 1);
        builder.w(w(variant.fc));
        let field_count = env.program.op(add(payload, 2));
        for field_index in 0..w(variant.fc) {
            let field = env.world.field(add(w(variant.fa), field_index)).name;
            let mut cursor = add(payload, 3);
            let mut at = NONE64;
            for m in 0..field_count {
                if at == NONE64 && n32(env.program.op(cursor)) == field {
                    at = inc(cursor);
                }
                cursor = pattern_end(in env.program, inc(cursor));
            }
            if at == NONE64 {
                builder.fail(in "missing pattern field");
                builder.w(P_WILD);
            } else {
                pattern(inout builder, in types, in env, at);
            }
        }
        constructor_check(inout builder, in env.world, ctor);
    }
}

// ----- instructions -------------------------------------------------------------------

// `let $value{dest} : ty := ` before the right-hand side; `let_dest_end`
// makes the type's check after it.
fn let_dest(inout builder: B, in types: Types, in env: X, inst: InstRow) {
    builder.w(S_LET);
    builder.w(0);
    builder.w(P_BIND);
    let sym = value_sym(inout builder, w(inst.dest));
    builder.ident(sym);
    builder.w(1);
    emit_ty(inout builder, in types, inst.ty, env.fip);
}

fn let_dest_end(inout builder: B, in types: Types, in env: X, inst: InstRow) {
    ty_check(inout builder, in types, inst.ty, env.fip);
}

// `arith_term(op, kind, a, b)` after the operator: writes the prefix and
// returns how the operands go: 0 binary (write a, then b), 1 the signed
// `%` (`binary_mod_rest`), 2 refused.
fn arith_prefix(inout builder: B, op: u32, signed: bool) -> u64 {
    let code = arith_code(in builder, op);
    if code == NONE64 {
        let mut message: ChunkSeq[u8] = ChunkSeq::new[u8]();
        put(inout message, in "unsupported Lean binary operator \"");
        let len = builder.names.size(op);
        for i in 0..len {
            let byte = builder.names.byte(op, i);
            if byte == 34 || byte == 92 {
                message.push(92);
            }
            message.push(byte);
        }
        put(inout message, in "\"");
        if !builder.failed {
            builder.failed = true;
            builder.err = message;
        }
        unit_tuple(inout builder);
        return 2;
    }
    if code == OP_MOD && signed {
        return 1;
    }
    builder.binary(code);
    0
}

fn arith_code(in builder: B, op: u32) -> u64 {
    if spells(in builder, op, in "+") {
        OP_ADD
    } else if spells(in builder, op, in "-") {
        OP_SUB
    } else if spells(in builder, op, in "*") {
        OP_MUL
    } else if spells(in builder, op, in "/") {
        OP_DIV
    } else if spells(in builder, op, in "%") {
        OP_MOD
    } else if spells(in builder, op, in "==") {
        OP_BOOL_EQ
    } else if spells(in builder, op, in "!=") {
        OP_BOOL_NE
    } else if spells(in builder, op, in "<") {
        OP_LT
    } else if spells(in builder, op, in "<=") {
        OP_LE
    } else if spells(in builder, op, in ">") {
        OP_GT
    } else if spells(in builder, op, in ">=") {
        OP_GE
    } else if spells(in builder, op, in "&&") {
        OP_BOOL_AND
    } else if spells(in builder, op, in "||") {
        OP_BOOL_OR
    } else {
        NONE64
    }
}

// The signed `%`: `if b == -1 then 0 else a % b`, from the operands' words.
fn signed_mod(inout builder: B, in lhs: ChunkSeq[u64], in rhs: ChunkSeq[u64]) {
    builder.w(T_IF);
    builder.binary(OP_BOOL_EQ);
    builder.paste(in rhs);
    builder.w(T_UNARY);
    builder.w(U_NEG);
    nat_u64(inout builder, 1);
    nat_u64(inout builder, 0);
    builder.binary(OP_MOD);
    builder.paste(in lhs);
    builder.paste(in rhs);
}

// `wrapping_intrinsic(op).unwrap_or(op)`.
fn unwrapped(inout builder: B, op: u32) -> u32 {
    if spells(in builder, op, in "wrapping_add") {
        builder.intern(in "+")
    } else if spells(in builder, op, in "wrapping_sub") {
        builder.intern(in "-")
    } else if spells(in builder, op, in "wrapping_mul") {
        builder.intern(in "*")
    } else {
        op
    }
}

// Whether `name` has `prefix` and then exactly `rest`.
fn spells_after(in builder: B, name: u32, in prefix: Str, in rest: Str) -> bool {
    let len = builder.names.size(name);
    let prefix_len = prefix.len();
    if len != add(prefix_len, rest.len()) {
        return false;
    }
    let prefix_bytes = prefix.as_bytes();
    let rest_bytes = rest.as_bytes();
    for i in 0..len {
        let want = if i < prefix_len {
            prefix_bytes.try_get(i).unwrap_or(0)
        } else {
            rest_bytes.try_get(wrapping_sub(i, prefix_len)).unwrap_or(0)
        };
        if builder.names.byte(name, i) != want {
            return false;
        }
    }
    true
}

fn float_kind_after(in builder: B, name: u32, in prefix: Str) -> bool {
    spells_after(in builder, name, in prefix, in "f32")
        || spells_after(in builder, name, in prefix, in "f64")
}

fn integer_kind_after(in builder: B, name: u32, in prefix: Str) -> bool {
    spells_after(in builder, name, in prefix, in "u8")
        || spells_after(in builder, name, in prefix, in "u16")
        || spells_after(in builder, name, in prefix, in "u32")
        || spells_after(in builder, name, in prefix, in "u64")
        || spells_after(in builder, name, in prefix, in "usize")
        || spells_after(in builder, name, in prefix, in "i8")
        || spells_after(in builder, name, in prefix, in "i16")
        || spells_after(in builder, name, in prefix, in "i32")
        || spells_after(in builder, name, in prefix, in "i64")
        || spells_after(in builder, name, in prefix, in "isize")
        || spells_after(in builder, name, in prefix, in "i128")
        || spells_after(in builder, name, in prefix, in "u128")
}

// `numeric::float::is_float_intrinsic`.
fn float_intrinsic(in builder: B, name: u32) -> bool {
    spells(in builder, name, in "sqrt")
        || spells(in builder, name, in "abs")
        || spells(in builder, name, in "floor")
        || spells(in builder, name, in "ceil")
        || spells(in builder, name, in "round")
        || spells(in builder, name, in "trunc")
        || spells(in builder, name, in "min")
        || spells(in builder, name, in "max")
        || spells(in builder, name, in "fma")
        || float_kind_after(in builder, name, in "widen_")
        || float_kind_after(in builder, name, in "nearest_")
        || integer_kind_after(in builder, name, in "saturating_")
        || float_kind_after(in builder, name, in "to_bits_")
        || float_kind_after(in builder, name, in "from_bits_")
}

// Statements of instruction `inst`; returns how many.
fn instruction(
    inout builder: B,
    inout types: Types,
    in env: X,
    in emitter: S,
    inst: InstRow
) -> u64 {
    let operand_at = inst.a;
    let op = inst.op;
    if op == Op::Bind {
        builder.w(S_LET);
        builder.w(0);
        pattern(inout builder, in types, in env, inc(operand_at));
        builder.w(0);
        value(inout builder, env.program.op(operand_at));
        let_dest(inout builder, in types, in env, inst);
        unit_tuple(inout builder);
        let_dest_end(inout builder, in types, in env, inst);
        return 2;
    }
    if op == Op::Write {
        let mut path: ChunkSeq[u32] = ChunkSeq::new[u32]();
        let root = split_place(inout builder, n32(env.program.op(operand_at)), inout path);
        let op_sym = n32(env.program.op(inc(operand_at)));
        let value_id = env.program.op(add(operand_at, 2));
        let mark = builder.slice_len();
        if spells(in builder, op_sym, in "=") {
            value(inout builder, value_id);
        } else {
            let op_len = builder.names.size(op_sym);
            if op_len == 0 || builder.names.byte(op_sym, wrapping_sub(op_len, 1)) != 61 {
                builder.fail(in "invalid Lean compound operator");
                unit_tuple(inout builder);
            } else {
                let mut stripped: ChunkSeq[u8] = ChunkSeq::new[u8]();
                for i in 0..wrapping_sub(op_len, 1) {
                    stripped.push(builder.names.byte(op_sym, i));
                }
                let stripped_sym = builder.names.intern(in stripped.as_slice());
                let signed = signed_kind(in builder, in types, emitter.func.value_ty(value_id));
                let base_mark = builder.slice_len();
                project_ref(inout builder, in types, root, in path, emitter.func.local_ty(root));
                let lhs = builder.cut(base_mark);
                let value_mark = builder.slice_len();
                value(inout builder, value_id);
                let rhs = builder.cut(value_mark);
                let how = arith_prefix(inout builder, stripped_sym, signed);
                if how == 0 {
                    builder.paste(in lhs);
                    builder.paste(in rhs);
                } else if how == 1 {
                    signed_mod(inout builder, in lhs, in rhs);
                }
            }
        }
        let new = builder.cut(mark);
        let_update(inout builder, inout types, in env, in emitter.func, root, in path, in new);
        let_dest(inout builder, in types, in env, inst);
        unit_tuple(inout builder);
        let_dest_end(inout builder, in types, in env, inst);
        return 2;
    }
    if op == Op::Indirect {
        return indirect(inout builder, inout types, in env, in emitter, inst);
    }
    if op == Op::Call {
        return call(inout builder, inout types, in env, in emitter, inst);
    }
    if op == Op::Tiled {
        return tiled(inout builder, inout types, in env, in emitter, inst);
    }
    if (op == Op::Unary || op == Op::Binary)
        && float_intrinsic(in builder, n32(env.program.op(operand_at))) {
        // float_math::lean_refusal
        let mut message: ChunkSeq[u8] = ChunkSeq::new[u8]();
        put(inout message, in "Lean extraction does not model the float intrinsic '");
        builder.names.write(n32(env.program.op(operand_at)), inout message);
        put(
            inout message,
            in "' yet (vesper.float.ieee754/1: only + - * /, negation and comparisons of f32 and f64 are modeled)"
        );
        if !builder.failed {
            builder.failed = true;
            builder.err = message;
        }
        return 0;
    }
    if op == Op::Loop || op == Op::Exit {
        builder.fail(in LOOP_REFUSAL);
        return 0;
    }
    if !(
        op == Op::Const
            || op == Op::Unit
            || op == Op::Read
            || op == Op::Closure
            || op == Op::Unary
            || op == Op::Binary
            || op == Op::Tuple
            || op == Op::Data
            || op == Op::Project
            || op == Op::Fip
    ) {
        builder.fail(in "unsupported operation in Lean CFG extraction");
        return 0;
    }
    if op == Op::Closure {
        // The binders' types and the lifted name are checked after the
        // arguments.
        let_dest(inout builder, in types, in env, inst);
        closure(inout builder, in types, in env, in emitter, inst);
        let_dest_end(inout builder, in types, in env, inst);
        return 1;
    }
    let_dest(inout builder, in types, in env, inst);
    if op == Op::Const {
        builder.w(T_ASCRIBE);
        literal(inout builder, in types, in env, operand_at, inst.ty);
        typ(inout builder, in types, in env, inst.ty);
    } else if op == Op::Unit {
        unit_tuple(inout builder);
    } else if op == Op::Read {
        let root = n32(env.program.op(operand_at));
        let callee = env.fns.find(root);
        if callee != NONE32 && emitter.func.slot_bit(root) == NONE64 {
            if env.fns.sig(w(callee)).param_count == 0 {
                builder.w(T_FUN);
                builder.w(1);
                builder.w(B_EXPLICIT);
                builder.w(0);
                builder.global(in "Unit");
                builder.sref(root);
            } else {
                builder.sref(root);
            }
        } else {
            let path = ir_path(in env.program, env.program.op(inc(operand_at)));
            project_ref(inout builder, in types, root, in path, emitter.func.local_ty(root));
        }
    } else if op == Op::Unary {
        let op_sym = n32(env.program.op(operand_at));
        if spells(in builder, op_sym, in "-") || spells(in builder, op_sym, in "!") {
            builder.w(T_UNARY);
            builder.w(
                if spells(in builder, op_sym, in "-") {
                    U_NEG
                } else {
                    U_BOOL_NOT
                }
            );
            value(inout builder, env.program.op(inc(operand_at)));
        } else {
            let mut message: ChunkSeq[u8] = ChunkSeq::new[u8]();
            put(inout message, in "unsupported Lean unary operator ");
            builder.names.write(op_sym, inout message);
            if !builder.failed {
                builder.failed = true;
                builder.err = message;
            }
            unit_tuple(inout builder);
        }
    } else if op == Op::Binary {
        let op_sym = unwrapped(inout builder, n32(env.program.op(operand_at)));
        let left_value = env.program.op(inc(operand_at));
        let right_value = env.program.op(add(operand_at, 2));
        let mut cmp = NONE64;
        if spells(in builder, op_sym, in "<") {
            cmp = OP_LT;
        } else if spells(in builder, op_sym, in "<=") {
            cmp = OP_LE;
        } else if spells(in builder, op_sym, in ">") {
            cmp = OP_GT;
        } else if spells(in builder, op_sym, in ">=") {
            cmp = OP_GE;
        }
        if cmp != NONE64 {
            global_app(inout builder, in "Decidable", in "decide");
            builder.binary(cmp);
            value(inout builder, left_value);
            value(inout builder, right_value);
        } else {
            let signed = signed_kind(in builder, in types, emitter.func.value_ty(left_value));
            let how = arith_prefix(inout builder, op_sym, signed);
            if how == 0 {
                value(inout builder, left_value);
                value(inout builder, right_value);
            } else if how == 1 {
                let operand_mark = builder.slice_len();
                value(inout builder, left_value);
                let lhs = builder.cut(operand_mark);
                value(inout builder, right_value);
                let rhs = builder.cut(operand_mark);
                signed_mod(inout builder, in lhs, in rhs);
            }
        }
    } else if op == Op::Tuple {
        let count = env.program.op(operand_at);
        if count != 1 {
            builder.w(T_TUPLE);
            builder.w(count);
        }
        for k in 0..count {
            value(inout builder, env.program.op(add(inc(operand_at), k)));
        }
    } else if op == Op::Data {
        let ctor = lookup_constructor(inout builder, in env.world, n32(env.program.op(operand_at)));
        if ctor == NONE64 {
            builder.fail(in "unknown Lean data");
            unit_tuple(inout builder);
        } else {
            let variant = variant_of(in env.world, ctor);
            let mark = builder.app(w(variant.fc));
            builder.w(T_REF);
            builder.quiet = inc(builder.quiet);
            constructor_name(inout builder, in env.world, ctor);
            builder.quiet = wrapping_sub(builder.quiet, 1);
            builder.args(mark);
            let field_count = env.program.op(inc(operand_at));
            for field_index in 0..w(variant.fc) {
                let field = env.world.field(add(w(variant.fa), field_index)).name;
                builder.arg();
                let mut found = false;
                for k in 0..field_count {
                    let at = add(operand_at, add(2, wrapping_mul(k, 2)));
                    if !found && n32(env.program.op(at)) == field {
                        value(inout builder, env.program.op(inc(at)));
                        found = true;
                    }
                }
                if !found {
                    builder.fail(in "missing Lean field");
                    unit_tuple(inout builder);
                }
            }
            constructor_check(inout builder, in env.world, ctor);
        }
    } else if op == Op::Project {
        let value_id = env.program.op(operand_at);
        let mut path: ChunkSeq[u32] = ChunkSeq::new[u32]();
        path.push(n32(env.program.op(inc(operand_at))));
        project_value(inout builder, in types, value_id, in path, emitter.func.value_ty(value_id));
    } else if op == Op::Fip {
        let args = inc(operand_at);
        if env.program.op(args) != 1 {
            builder.fail(in "Box op expects 1 argument");
            unit_tuple(inout builder);
        } else {
            value(inout builder, env.program.op(inc(arg_at(args, 0))));
        }
    }
    let_dest_end(inout builder, in types, in env, inst);
    1
}

// `Op::Closure`: `fun $arg0 .. => $lambda_f_d (T := T).. captures.. $arg0..`.
fn closure(inout builder: B, in types: Types, in env: X, in emitter: S, inst: InstRow) {
    let closure_index = env.fns.closure(emitter.func.row.name, w(inst.dest));
    let row = env.fns.closure_at(w(closure_index));
    let ty = inst.ty;
    let param_count = types.arity(ty);
    builder.w(T_FUN);
    if param_count == 0 {
        builder.w(1);
        builder.w(B_EXPLICIT);
        builder.w(0);
        builder.global(in "Unit");
    } else {
        builder.w(param_count);
        for k in 0..param_count {
            builder.w(B_EXPLICIT);
            builder.w(1);
            let arg_sym = builder.numbered(in "$arg", k);
            builder.ident(arg_sym);
            emit_ty(inout builder, in types, types.arg(ty, k), env.fip);
        }
    }
    let arity = add(add(generic_count(in env, emitter.sig), row.n), param_count);
    let mark = builder.app(arity);
    builder.quiet = inc(builder.quiet);
    builder.sref(row.lifted);
    builder.quiet = wrapping_sub(builder.quiet, 1);
    builder.args(mark);
    generic_args(inout builder, in env, emitter.sig);
    for k in 0..row.n {
        builder.arg();
        builder.sref(env.fns.capture(row, k));
    }
    for k in 0..param_count {
        builder.arg();
        let arg_sym = builder.numbered(in "$arg", k);
        builder.sref(arg_sym);
    }
    for k in 0..param_count {
        ty_check(inout builder, in types, types.arg(ty, k), env.fip);
    }
    builder.check(row.lifted, in "name");
}

// The `let ($value{d}, $state{d}_0, ..) := call` of a call with states.
fn let_states(inout builder: B, dest: u64, state_count: u64) {
    builder.w(S_LET);
    builder.w(0);
    builder.w(P_TUPLE);
    builder.w(inc(state_count));
    builder.w(P_BIND);
    let value_name = builder.numbered(in "$value", dest);
    builder.ident(value_name);
    for k in 0..state_count {
        builder.w(P_BIND);
        let state_name = state_sym(inout builder, dest, k);
        builder.ident(state_name);
    }
    builder.w(0);
}

// `$state{d}_{k}`.
fn state_sym(inout builder: B, dest: u64, k: u64) -> u32 {
    let mut spelling: ChunkSeq[u8] = ChunkSeq::new[u8]();
    put(inout spelling, in "$state");
    put_decimal(inout spelling, dest);
    put(inout spelling, in "_");
    put_decimal(inout spelling, k);
    builder.names.intern(in spelling.as_slice())
}

// `Op::Indirect`.
fn indirect(inout builder: B, inout types: Types, in env: X, in emitter: S, inst: InstRow) -> u64 {
    let operand_at = inst.a;
    let args = inc(operand_at);
    let arg_count = env.program.op(args);
    let mut states: u64 = 0;
    for k in 0..arg_count {
        if env.program.op(arg_at(args, k)) == TyPass::Inout {
            states = inc(states);
        }
    }
    let mark = builder.slice_len();
    if states == 0 {
        let_dest(inout builder, in types, in env, inst);
    } else {
        let_states(inout builder, w(inst.dest), states);
    }
    let app_mark = builder.app(if arg_count == 0 { 1 } else { arg_count });
    value(inout builder, env.program.op(operand_at));
    builder.args(app_mark);
    if arg_count == 0 {
        builder.arg();
        unit_tuple(inout builder);
    }
    for k in 0..arg_count {
        builder.arg();
        value(inout builder, env.program.op(inc(arg_at(args, k))));
    }
    if states == 0 {
        let_dest_end(inout builder, in types, in env, inst);
        return 1;
    }
    let mut count: u64 = 1;
    let mut state_index: u64 = 0;
    for k in 0..arg_count {
        let at = arg_at(args, k);
        if env.program.op(at) == TyPass::Inout {
            let root = env.program.op(add(at, 2));
            if root == 0 {
                builder.fail(in "mutable indirect argument requires place");
                return count;
            }
            let root_sym = n32(wrapping_sub(root, 1));
            let path = ir_path(in env.program, env.program.op(add(at, 3)));
            let state_mark = builder.slice_len();
            let state_name = state_sym(inout builder, w(inst.dest), state_index);
            builder.sref(state_name);
            let new = builder.cut(state_mark);
            let_update(
                inout builder,
                inout types,
                in env,
                in emitter.func,
                root_sym,
                in path,
                in new
            );
            count = inc(count);
            state_index = inc(state_index);
        }
    }
    count
}

// `Op::Call`.
fn call(inout builder: B, inout types: Types, in env: X, in emitter: S, inst: InstRow) -> u64 {
    let operand_at = inst.a;
    let callee = n32(env.program.op(operand_at));
    let args = inc(operand_at);
    let arg_count = env.program.op(args);
    let sig_index = env.fns.find(callee);
    let sig = env.fns.sig(w(sig_index));
    let call_row = env.fns.call(inst.s0, inst.s1);
    // call_states: the inout parameters zipped with the arguments
    let mut states: u64 = 0;
    for k in 0..arg_count {
        if k < sig.param_count && widen_u64(env.fns.param(sig, k).pass) == TyPass::Inout {
            states = inc(states);
        }
    }
    if states == 0 {
        let_dest(inout builder, in types, in env, inst);
    } else {
        let_states(inout builder, w(inst.dest), states);
    }
    let mut named_count: u64 = 0;
    for i in 0..sig.gn {
        let generic = env.fns.generic(sig, i);
        if !generic.row && env.fns.call_var(call_row, generic.name) != NONE32 {
            named_count = inc(named_count);
        }
    }
    let mark = builder.app(add(named_count, arg_count));
    builder.quiet = inc(builder.quiet);
    builder.sref(callee);
    builder.quiet = wrapping_sub(builder.quiet, 1);
    builder.args(mark);
    for i in 0..sig.gn {
        let generic = env.fns.generic(sig, i);
        let var_ty = env.fns.call_var(call_row, generic.name);
        if !generic.row && var_ty != NONE32 {
            builder.w(1);
            builder.ident(generic.name);
            typ(inout builder, in types, in env, var_ty);
        }
    }
    for k in 0..arg_count {
        builder.arg();
        value(inout builder, env.program.op(inc(arg_at(args, k))));
    }
    builder.check(callee, in "name");
    if states == 0 {
        let_dest_end(inout builder, in types, in env, inst);
        return 1;
    }
    let mut count: u64 = 1;
    let mut state_index: u64 = 0;
    for k in 0..arg_count {
        if k < sig.param_count && widen_u64(env.fns.param(sig, k).pass) == TyPass::Inout {
            let param = env.fns.param(sig, k);
            let at = arg_at(args, k);
            let root = env.program.op(add(at, 2));
            if root == 0 {
                builder.fail(in "mutable Lean argument requires a place");
                return count;
            }
            let root_sym = n32(wrapping_sub(root, 1));
            let state_name = state_sym(inout builder, w(inst.dest), state_index);
            let path_count = if param.proj_count == 0 {
                1
            } else {
                param.proj_count
            };
            for path_index in 0..path_count {
                let mut sub: ChunkSeq[u32] = ChunkSeq::new[u32]();
                if param.proj_count > 0 {
                    let proj_path = env.fns.path(add(param.proj_start, path_index));
                    for j in 0..proj_path.n {
                        sub.push(env.fns.path_sym(proj_path, j));
                    }
                }
                let state_mark = builder.slice_len();
                project_ref(inout builder, in types, state_name, in sub, param.ty);
                let new = builder.cut(state_mark);
                let mut full = ir_path(in env.program, env.program.op(add(at, 3)));
                for j in 0..sub.len() {
                    full.push(u32_at(in sub, j));
                }
                let_update(
                    inout builder,
                    inout types,
                    in env,
                    in emitter.func,
                    root_sym,
                    in full,
                    in new
                );
                count = inc(count);
            }
            state_index = inc(state_index);
        }
    }
    count
}

// The tiled operation of pool entry `i`, from its `Debug` text: its kind
// symbol's prefix up to the first space.
fn tiled_kind(in builder: B, in env: X, label: u32, in name: Str) -> bool {
    let label_len = builder.names.size(label);
    let name_len = name.len();
    if label_len < name_len {
        return false;
    }
    let bytes = name.as_bytes();
    for i in 0..name_len {
        match bytes.try_get(i) {
            Option::Some(byte) => {
                if builder.names.byte(label, i) != byte {
                    return false;
                }
            },
            Option::None => {},
        }
    }
    label_len == name_len || builder.names.byte(label, name_len) == 32
}

// The text after `key` up to the next `"` (a field name) in the label.
fn label_field(inout builder: B, label: u32, in key: Str) -> u32 {
    let label_len = builder.names.size(label);
    let key_bytes = key.as_bytes();
    let key_len = key.len();
    let mut i: u64 = 0;
    loop {
        if add(i, key_len) > label_len {
            return NONE32;
        }
        let mut hit = true;
        for j in 0..key_len {
            match key_bytes.try_get(j) {
                Option::Some(byte) => {
                    if builder.names.byte(label, add(i, j)) != byte {
                        hit = false;
                    }
                },
                Option::None => {},
            }
        }
        if hit {
            break;
        }
        i = inc(i);
    }
    let mut spelling: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut j = add(i, key_len);
    loop {
        if j >= label_len || builder.names.byte(label, j) == 34 {
            break;
        }
        spelling.push(builder.names.byte(label, j));
        j = inc(j);
    }
    builder.names.intern(in spelling.as_slice())
}

fn label_number(in builder: B, label: u32, in key: Str) -> u64 {
    let label_len = builder.names.size(label);
    let key_bytes = key.as_bytes();
    let key_len = key.len();
    let mut i: u64 = 0;
    loop {
        if add(i, key_len) > label_len {
            return 0;
        }
        let mut hit = true;
        for j in 0..key_len {
            match key_bytes.try_get(j) {
                Option::Some(byte) => {
                    if builder.names.byte(label, add(i, j)) != byte {
                        hit = false;
                    }
                },
                Option::None => {},
            }
        }
        if hit {
            break;
        }
        i = inc(i);
    }
    let mut value: u64 = 0;
    let mut j = add(i, key_len);
    loop {
        if j >= label_len {
            break;
        }
        let byte = builder.names.byte(label, j);
        if byte < 48 || byte > 57 {
            break;
        }
        value = wrapping_add(wrapping_mul(value, 10), widen_u64(wrapping_sub(byte, 48)));
        j = inc(j);
    }
    value
}

// `getElem! a0 a1.toNat`.
fn get_elem(inout builder: B, in env: X, args: u64) {
    let mark = global_app2(inout builder, in "GetElem?", in "getElem!");
    builder.arg();
    value(inout builder, env.program.op(inc(arg_at(args, 0))));
    builder.arg();
    to_nat_of_value(inout builder, env.program.op(inc(arg_at(args, 1))));
}

// The term of `tiled_op_term` for the operation with `Debug` text `label`.
fn tiled_term(inout builder: B, in env: X, label: u32, args: u64) {
    let first_value = env.program.op(inc(arg_at(args, 0)));
    if tiled_kind(in builder, in env, label, in "New") {
        global_app(inout builder, in "Array", in "emptyWithCapacity");
        nat_u64(inout builder, 0);
    } else if tiled_kind(in builder, in env, label, in "WithCapacity")
        || tiled_kind(in builder, in env, label, in "WithRegion") {
        global_app(inout builder, in "Array", in "emptyWithCapacity");
        to_nat_of_value(inout builder, first_value);
    } else if tiled_kind(in builder, in env, label, in "Len") {
        global_app(inout builder, in "Nat", in "toUInt64");
        global_app(inout builder, in "Array", in "size");
        value(inout builder, first_value);
    } else if tiled_kind(in builder, in env, label, in "TileCount") {
        let tile_width = label_number(in builder, label, in "tile_width: ");
        global_app(inout builder, in "Nat", in "toUInt64");
        builder.binary(OP_DIV);
        builder.binary(OP_ADD);
        global_app(inout builder, in "Array", in "size");
        value(inout builder, first_value);
        nat_u64(inout builder, wrapping_sub(tile_width, 1));
        nat_u64(inout builder, tile_width);
    } else if tiled_kind(in builder, in env, label, in "Get") {
        get_elem(inout builder, in env, args);
    } else if tiled_kind(in builder, in env, label, in "ColGet") {
        let field = label_field(inout builder, label, in "field: \"");
        builder.w(T_PROJECT);
        get_elem(inout builder, in env, args);
        builder.w(0);
        builder.ident(field);
    } else if tiled_kind(in builder, in env, label, in "Push") {
        let mark = global_app2(inout builder, in "Array", in "push");
        builder.arg();
        value(inout builder, first_value);
        builder.arg();
        value(inout builder, env.program.op(inc(arg_at(args, 1))));
    } else if tiled_kind(in builder, in env, label, in "Set") {
        let mark = builder.app(3);
        builder.global2(in "Array", in "setIfInBounds");
        builder.args(mark);
        builder.arg();
        value(inout builder, first_value);
        builder.arg();
        to_nat_of_value(inout builder, env.program.op(inc(arg_at(args, 1))));
        builder.arg();
        value(inout builder, env.program.op(inc(arg_at(args, 2))));
    } else if tiled_kind(in builder, in env, label, in "ColSet") {
        let field = label_field(inout builder, label, in "field: \"");
        let mark = builder.app(3);
        builder.global2(in "Array", in "setIfInBounds");
        builder.args(mark);
        builder.arg();
        value(inout builder, first_value);
        builder.arg();
        to_nat_of_value(inout builder, env.program.op(inc(arg_at(args, 1))));
        builder.arg();
        builder.w(T_UPDATE);
        builder.w(1);
        get_elem(inout builder, in env, args);
        builder.ident(field);
        value(inout builder, env.program.op(inc(arg_at(args, 2))));
    } else {
        builder.fail(in "Lean extraction does not lower SIMD load_tile_vec");
        unit_tuple(inout builder);
    }
}

// `Op::Tiled`.
fn tiled(inout builder: B, inout types: Types, in env: X, in emitter: S, inst: InstRow) -> u64 {
    let operand_at = inst.a;
    let label = env.program.pool_row(env.program.op(operand_at)).label;
    let args = inc(operand_at);
    let mutates = tiled_kind(in builder, in env, label, in "Push")
        || tiled_kind(in builder, in env, label, in "Set")
        || tiled_kind(in builder, in env, label, in "ColSet");
    let mark = builder.slice_len();
    tiled_term(inout builder, in env, label, args);
    let term = builder.cut(mark);
    if !mutates {
        let_dest(inout builder, in types, in env, inst);
        builder.paste(in term);
        let_dest_end(inout builder, in types, in env, inst);
        return 1;
    }
    let arg_count = env.program.op(args);
    let mut at = NONE64;
    for k in 0..arg_count {
        if at == NONE64 && env.program.op(arg_at(args, k)) == TyPass::Inout {
            at = arg_at(args, k);
        }
    }
    if at == NONE64 || env.program.op(add(at, 2)) == 0 {
        builder.fail(in "mutable TiledSeq argument requires a place");
        return 0;
    }
    let root_sym = n32(wrapping_sub(env.program.op(add(at, 2)), 1));
    let path = ir_path(in env.program, env.program.op(add(at, 3)));
    let_update(inout builder, inout types, in env, in emitter.func, root_sym, in path, in term);
    let_dest(inout builder, in types, in env, inst);
    unit_tuple(inout builder);
    let_dest_end(inout builder, in types, in env, inst);
    2
}

// ----- definitions -------------------------------------------------------------------

// The terminator of block `block_index` (its `pure` result).
fn terminator(inout builder: B, in types: Types, in env: X, in emitter: S, block_index: u64) {
    let block = emitter.func.block(in env.program, block_index);
    let term_at = block.ta;
    if block.term == Term::Return {
        let inout_params = inout_count(in emitter.func);
        pure_app(inout builder);
        if inout_params > 0 {
            builder.w(T_TUPLE);
            builder.w(inc(inout_params));
        }
        value(inout builder, env.program.op(term_at));
        for j in 0..emitter.func.params.len() {
            let param_row = emitter.func.param(j);
            if param_row.pass == TyPass::Inout {
                builder.sref(param_row.name);
            }
        }
    } else if block.term == Term::Jump {
        pure_app(inout builder);
        call_block(inout builder, in env, in emitter, env.program.op(term_at), inc(term_at));
    } else if block.term == Term::Branch {
        builder.w(T_IF);
        value(inout builder, env.program.op(term_at));
        pure_app(inout builder);
        call_block(inout builder, in env, in emitter, env.program.op(inc(term_at)), NONE64);
        pure_app(inout builder);
        call_block(inout builder, in env, in emitter, env.program.op(add(term_at, 2)), NONE64);
    } else if block.term == Term::Match {
        let arm_count = env.program.op(inc(term_at));
        builder.w(T_MATCH);
        builder.w(arm_count);
        value(inout builder, env.program.op(term_at));
        let mut pattern_at = add(term_at, 2);
        for m in 0..arm_count {
            let end = pattern_end(in env.program, pattern_at);
            let target = env.program.op(end);
            let bound = u64_at(in emitter.arms, target);
            if bound == NONE64 {
                pattern(inout builder, in types, in env, pattern_at);
            } else {
                pattern(inout builder, in types, in env, bound);
            }
            pure_app(inout builder);
            call_block(inout builder, in env, in emitter, target, NONE64);
            pattern_at = inc(end);
        }
    } else {
        builder.fail(in "unreachable control flow has no pure Lean value");
        unit_tuple(inout builder);
    }
}

// `partial def $block_f_k {T..} (live..) : result := Id.run do ..`.
fn block_definition(
    inout builder: B,
    inout types: Types,
    in env: X,
    in emitter: S,
    block_index: u64
) {
    let block = emitter.func.block(in env.program, block_index);
    let name = block_sym(inout builder, in emitter.func, block_index);
    builder.w(D_DEF);
    builder.w(K_PARTIAL);
    builder.quiet = inc(builder.quiet);
    builder.name(name);
    builder.quiet = wrapping_sub(builder.quiet, 1);
    builder.w(add(generic_count(in env, emitter.sig), live_count(in emitter, block_index)));
    type_params(inout builder, in env, emitter.sig);
    let mut bit = set_next_in(in emitter, block_index, 0);
    loop {
        if bit == NONE64 {
            break;
        }
        builder.w(B_EXPLICIT);
        builder.w(1);
        let local_name = local_sym(inout builder, in emitter.func, bit);
        builder.ident(local_name);
        typ(inout builder, in types, in env, emitter.func.bit_ty(bit));
        bit = set_next_in(in emitter, block_index, inc(bit));
    }
    result_type(inout builder, in types, in env, in emitter.func);
    // Id.run (do ..)
    global_app(inout builder, in "Id", in "run");
    builder.w(T_DO);
    let count_at = builder.hole();
    let mut stmt_count: u64 = 0;
    let arm = u64_at(in emitter.arms, block_index) != NONE64;
    for j in 0..block.ic {
        let inst = env.program.inst(add(block.i0, j));
        if j == 0 && arm {
            // `let $value{d} : Unit := ()`
            builder.w(S_LET);
            builder.w(0);
            builder.w(P_BIND);
            let dest_name = value_sym(inout builder, w(inst.dest));
            builder.ident(dest_name);
            builder.w(1);
            builder.global(in "Unit");
            unit_tuple(inout builder);
            stmt_count = inc(stmt_count);
        } else {
            stmt_count = add(
                stmt_count,
                instruction(inout builder, inout types, in env, in emitter, inst)
            );
        }
    }
    builder.fill(count_at, stmt_count);
    terminator(inout builder, in types, in env, in emitter, block_index);
    builder.check(name, in "name");
    result_check(inout builder, in types, in env, in emitter.func);
}

// `partial def f {T..} (params..) : result := $block_f_0 ..`.
fn main_definition(inout builder: B, inout types: Types, in env: X, in emitter: S) {
    builder.w(D_DEF);
    builder.w(K_PARTIAL);
    builder.quiet = inc(builder.quiet);
    builder.name(emitter.func.row.name);
    builder.quiet = wrapping_sub(builder.quiet, 1);
    builder.w(add(generic_count(in env, emitter.sig), emitter.func.params.len()));
    type_params(inout builder, in env, emitter.sig);
    for j in 0..emitter.func.params.len() {
        let param_row = emitter.func.param(j);
        builder.w(B_EXPLICIT);
        builder.w(1);
        builder.ident(param_row.name);
        typ(inout builder, in types, in env, param_row.ty);
    }
    result_type(inout builder, in types, in env, in emitter.func);
    builder.check(emitter.func.row.name, in "name");
    result_check(inout builder, in types, in env, in emitter.func);
    call_block(inout builder, in env, in emitter, 0, NONE64);
}

// `extract_function_nodes` of program function `func_index`: writes its
// definitions (the lifted closures' first) and adds their number to
// `count`. False when the structured extractor takes the function; stops
// at the first error.
pub fn extract(
    inout builder: B,
    inout types: Types,
    in env: X,
    func_index: u64,
    inout count: u64
) -> bool {
    let func = fun(in env.program, in env.fns, func_index);
    if !takes(in env.program, in types, in env.world, in env.fns, in func) {
        return false;
    }
    for block_index in 0..func.row.bc {
        let block = func.block(in env.program, block_index);
        for inst_index in 0..block.ic {
            let inst = env.program.inst(add(block.i0, inst_index));
            if inst.op == Op::Closure {
                let closure_index = env.fns.closure(func.row.name, w(inst.dest));
                if closure_index == NONE32 {
                    builder.fail(in "invalid closure IR");
                    return true;
                }
                let lifted = env.fns.closure_at(w(closure_index)).lifted;
                let lifted_entry = u32_at(in env.fn_by_name, w(lifted));
                if lifted_entry == 0 {
                    builder.fail(in "invalid closure IR");
                    return true;
                }
                if !extract(
                    inout builder,
                    inout types,
                    in env,
                    w(wrapping_sub(lifted_entry, 1)),
                    inout count
                ) {
                    return false;
                }
                if builder.failed {
                    return true;
                }
            }
        }
    }
    let arms = arm_bindings(in env.program, in func);
    let live = liveness(in env.program, inout builder.names, in env.fns, in func, in arms);
    let sig = env.fns.sig(w(func.sig));
    let emitter = S { func: func, live: live, arms: arms, sig: sig };
    for k in 0..emitter.func.row.bc {
        block_definition(inout builder, inout types, in env, in emitter, k);
        count = inc(count);
    }
    main_definition(inout builder, inout types, in env, in emitter);
    count = inc(count);
    true
}
