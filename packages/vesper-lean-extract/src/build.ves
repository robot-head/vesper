// The Lean syntax builder: writes a tree straight into the prefix-order
// word stream that the @vesper/lean-syntax printer reads (the node tags are
// documented in crates/vesper-lean-syntax/src/port.rs, `Enc`). Every text
// (identifier, literal) is a symbol of the names table, so the table's
// bytes are the printer's text pool: a text is its start and length there.
//
// Errors follow `src/lean_nodes.rs`: the first one wins (`fail`), and the
// tree is still written to its end so the caller needs no early exits.

use @vesper/check-data::names::{Names};

// Term tags.
pub const T_INFER: u64 = 0;
pub const T_REF: u64 = 1;
pub const T_TYPE: u64 = 3;
pub const T_NAT: u64 = 4;
pub const T_BOOL: u64 = 5;
pub const T_STRING: u64 = 6;
pub const T_APP: u64 = 8;
pub const T_FUN: u64 = 9;
pub const T_FORALL: u64 = 10;
pub const T_ARROW: u64 = 11;
pub const T_PRODUCT: u64 = 12;
pub const T_TUPLE: u64 = 13;
pub const T_IF: u64 = 16;
pub const T_MATCH: u64 = 17;
pub const T_PROJECT: u64 = 18;
pub const T_ASCRIBE: u64 = 19;
pub const T_UNARY: u64 = 20;
pub const T_BINARY: u64 = 21;
pub const T_RECORD: u64 = 22;
pub const T_UPDATE: u64 = 23;
pub const T_DO: u64 = 24;
pub const T_ELIMINATE: u64 = 27;

// Binder kinds.
pub const B_EXPLICIT: u64 = 0;
pub const B_IMPLICIT: u64 = 1;
pub const B_INSTANCE: u64 = 2;

// Patterns.
pub const P_WILD: u64 = 0;
pub const P_BIND: u64 = 1;
pub const P_CTOR: u64 = 2;
pub const P_TUPLE: u64 = 3;
pub const P_NAT: u64 = 4;
pub const P_BOOL: u64 = 5;
pub const P_STRING: u64 = 6;
pub const P_INT: u64 = 8;
pub const P_RECORD: u64 = 9;

// Do statements.
pub const S_LET: u64 = 0;
pub const S_BIND: u64 = 1;
pub const S_ASSIGN: u64 = 2;
pub const S_EXPR: u64 = 3;
pub const S_BIND_TYPED: u64 = 4;
pub const S_IF: u64 = 6;

// Declarations.
pub const D_INSTANCE: u64 = 0;
pub const D_OPTION: u64 = 1;
pub const D_DEF: u64 = 2;
pub const D_TYPE: u64 = 3;
pub const D_MUTUAL_TYPES: u64 = 5;
pub const D_NAMESPACE: u64 = 6;
pub const D_THEOREM: u64 = 7;

// Type declarations.
pub const TD_CLASS: u64 = 0;
pub const TD_INDUCTIVE: u64 = 1;
pub const TD_STRUCTURE: u64 = 2;

// Definition kinds.
pub const K_DEF: u64 = 0;
pub const K_PARTIAL: u64 = 2;
pub const K_ABBREV: u64 = 3;

// `BinaryOp` (its declaration order in vesper-lean-syntax).
pub const OP_ADD: u64 = 0;
pub const OP_SUB: u64 = 1;
pub const OP_MUL: u64 = 2;
pub const OP_DIV: u64 = 3;
pub const OP_MOD: u64 = 4;
pub const OP_EQ: u64 = 5;
pub const OP_BOOL_EQ: u64 = 7;
pub const OP_BOOL_NE: u64 = 8;
pub const OP_LT: u64 = 9;
pub const OP_LE: u64 = 10;
pub const OP_GT: u64 = 11;
pub const OP_GE: u64 = 12;
pub const OP_AND: u64 = 13;
pub const OP_BOOL_AND: u64 = 15;
pub const OP_BOOL_OR: u64 = 16;
pub const OP_IFF: u64 = 17;

// `UnaryOp`.
pub const U_NEG: u64 = 0;
pub const U_NOT: u64 = 1;
pub const U_BOOL_NOT: u64 = 2;

pub struct B {
    words: ChunkSeq[u64],
    names: Names,
    failed: bool,
    // The first error's message.
    err: ChunkSeq[u8],
    // Above 0, identifier checks are deferred: the caller makes them
    // afterwards, in Rust's evaluation order.
    quiet: u64,
}

pub fn builder(sink names: Names) -> B {
    B {
        words: ChunkSeq::with_capacity[u64](4096),
        names: names,
        failed: false,
        err: ChunkSeq::new[u8](),
        quiet: 0,
    }
}

fn put(inout out: ChunkSeq[u8], in text: Str) {
    out.extend(in text.as_bytes());
}

fn hex(digit: u32) -> u8 {
    if digit < 10 {
        wrapping_u8(wrapping_add(digit, 48))
    } else {
        wrapping_u8(wrapping_add(digit, 87))
    }
}

impl B {
    pub fn w(inout self, word: u64) {
        self.words.push(word);
    }

    // A word to fill in later (a count or a size).
    pub fn hole(inout self) -> u64 {
        let at = self.words.len();
        self.words.push(0);
        at
    }

    pub fn fill(inout self, at: u64, value: u64) {
        let ok = self.words.try_set(at, value);
    }

    // Fills `at` with the number of words written after it.
    pub fn close(inout self, at: u64) {
        let len = wrapping_sub(wrapping_sub(self.words.len(), at), 1);
        self.fill(at, len);
    }

    // The text of symbol `sym`.
    pub fn sym(inout self, sym: u32) {
        let start = self.names.start(sym);
        let len = self.names.size(sym);
        self.words.push(start);
        self.words.push(len);
    }

    pub fn intern(inout self, in text: Str) -> u32 {
        self.names.intern(in text.as_bytes())
    }

    // A fixed text.
    pub fn text(inout self, in text: Str) {
        let interned = self.intern(in text);
        self.sym(interned);
    }

    // The symbol spelling `prefix` then symbol `sym` (then `suffix`).
    pub fn joined(inout self, in prefix: Str, sym: u32, in suffix: Str) -> u32 {
        let mut spelling: ChunkSeq[u8] = ChunkSeq::new[u8]();
        put(inout spelling, in prefix);
        self.names.write(sym, inout spelling);
        put(inout spelling, in suffix);
        self.names.intern(in spelling.as_slice())
    }

    // `$arg{i}`.
    pub fn numbered(inout self, in prefix: Str, i: u64) -> u32 {
        let mut spelling: ChunkSeq[u8] = ChunkSeq::new[u8]();
        put(inout spelling, in prefix);
        put_decimal(inout spelling, i);
        self.names.intern(in spelling.as_slice())
    }

    pub fn fail(inout self, in message: Str) {
        if !self.failed {
            self.failed = true;
            put(inout self.err, in message);
        }
    }

    // `Ident::new`: not empty, not `_root_`, no control character (C0, DEL,
    // C1) and none of « » U+2028 U+2029 U+202A..U+202E U+2066..U+2069
    // U+FEFF, checked on the UTF-8 bytes.
    pub fn valid(in self, sym: u32) -> bool {
        let len = self.names.size(sym);
        if len == 0 || self.names.spells(sym, in "_root_".as_bytes()) {
            return false;
        }
        let mut i: u64 = 0;
        loop {
            if i >= len {
                break;
            }
            let byte = self.names.byte(sym, i);
            if byte < 32 || byte == 127 {
                return false;
            }
            if byte == 194 && wrapping_add(i, 1) < len {
                let second = self.names.byte(sym, wrapping_add(i, 1));
                if second <= 159 || second == 171 || second == 187 {
                    return false;
                }
            }
            if byte == 226 && wrapping_add(i, 2) < len {
                let second = self.names.byte(sym, wrapping_add(i, 1));
                let third = self.names.byte(sym, wrapping_add(i, 2));
                if second == 128 && third >= 168 && third <= 174 {
                    return false;
                }
                if second == 129 && third >= 166 && third <= 169 {
                    return false;
                }
            }
            if byte == 239 && wrapping_add(i, 2) < len {
                if self.names.byte(sym, wrapping_add(i, 1)) == 187
                    && self.names.byte(sym, wrapping_add(i, 2)) == 191 {
                    return false;
                }
            }
            i = wrapping_add(i, 1);
        }
        true
    }

    // `ident`/`source_name`'s error: "unsupported Lean <what> {s:?}: ...".
    pub fn check(inout self, sym: u32, in what: Str) {
        if self.failed || self.quiet > 0 || self.valid(sym) {
            return;
        }
        let mut message: ChunkSeq[u8] = ChunkSeq::new[u8]();
        put(inout message, in "unsupported Lean ");
        put(inout message, in what);
        put(inout message, in " \"");
        let len = self.names.size(sym);
        let mut i: u64 = 0;
        loop {
            if i >= len {
                break;
            }
            let byte = self.names.byte(sym, i);
            let code_point = self.escaped_at(sym, i);
            if byte == 34 {
                put(inout message, in "\\\"");
            } else if byte == 92 {
                put(inout message, in "\\\\");
            } else if byte == 10 {
                put(inout message, in "\\n");
            } else if byte == 13 {
                put(inout message, in "\\r");
            } else if byte == 9 {
                put(inout message, in "\\t");
            } else if byte == 0 {
                put(inout message, in "\\0");
            } else if byte < 32 || byte == 127 {
                put_escape(inout message, widen_u32(byte));
            } else if code_point != 0 {
                put_escape(inout message, code_point);
                i = wrapping_add(i, if code_point < 2048 { 1 } else { 2 });
            } else {
                message.push(byte);
            }
            i = wrapping_add(i, 1);
        }
        put(
            inout message,
            in "\": identifier is empty, reserved _root_, or contains an unsupported delimiter/control"
        );
        self.failed = true;
        self.err = message;
    }

    // The code point of the sequence at byte `i` of `sym` when Rust's `Debug`
    // escapes it and `Ident::new` refuses it (C1 controls, U+2028..U+202E,
    // U+2066..U+2069, U+FEFF), else 0.
    fn escaped_at(in self, sym: u32, i: u64) -> u32 {
        let len = self.names.size(sym);
        let byte = self.names.byte(sym, i);
        if byte == 194 && wrapping_add(i, 1) < len {
            let second = self.names.byte(sym, wrapping_add(i, 1));
            if second <= 159 {
                return widen_u32(second);
            }
        }
        if (byte == 226 || byte == 239) && wrapping_add(i, 2) < len {
            let second = widen_u32(self.names.byte(sym, wrapping_add(i, 1)));
            let third = widen_u32(self.names.byte(sym, wrapping_add(i, 2)));
            let code_point = ((widen_u32(byte) & 15) << 12) | ((second & 63) << 6) | (third & 63);
            if (code_point >= 8232 && code_point <= 8238)
                || (code_point >= 8294 && code_point <= 8297)
                || code_point == 65279 {
                return code_point;
            }
        }
        0
    }

    // A source identifier (`ident`).
    pub fn ident(inout self, sym: u32) {
        self.check(sym, in "identifier");
        self.sym(sym);
    }

    // A one-component source name (`source_name`).
    pub fn name(inout self, sym: u32) {
        self.check(sym, in "name");
        self.w(0);
        self.w(1);
        self.sym(sym);
    }

    // A fixed one-component name.
    pub fn name_fixed(inout self, in text: Str) {
        self.w(0);
        self.w(1);
        self.text(in text);
    }

    // `Name::qualified([ident(a), ident(b)])`.
    pub fn name2(inout self, a: u32, b: u32) {
        self.check(a, in "identifier");
        self.check(b, in "identifier");
        self.w(0);
        self.w(2);
        self.sym(a);
        self.sym(b);
    }

    // `source_ref`.
    pub fn sref(inout self, sym: u32) {
        self.w(T_REF);
        self.name(sym);
    }

    // `named`: a fixed unrooted reference.
    pub fn named(inout self, in text: Str) {
        self.w(T_REF);
        self.name_fixed(in text);
    }

    // `global(&[a])`, rooted.
    pub fn global(inout self, in a: Str) {
        self.w(T_REF);
        self.w(1);
        self.w(1);
        self.text(in a);
    }

    pub fn global2(inout self, in a: Str, in b: Str) {
        self.w(T_REF);
        self.w(1);
        self.w(2);
        self.text(in a);
        self.text(in b);
    }

    // `Sort::Type(0)`.
    pub fn type0(inout self) {
        self.w(T_TYPE);
        self.w(0);
    }

    // `Type → Type`.
    pub fn monad_ty(inout self) {
        self.w(T_ARROW);
        self.type0();
        self.type0();
    }

    // An application of `n` arguments: write the function after this, then
    // `args()` with the mark, then each argument after `arg()`.
    pub fn app(inout self, n: u64) -> u64 {
        self.w(T_APP);
        self.w(n);
        self.hole()
    }

    pub fn args(inout self, mark: u64) {
        self.close(mark);
    }

    pub fn arg(inout self) {
        self.w(0);
    }

    // A named argument `(name := ...)`; write the value after it.
    pub fn named_arg(inout self, in name: Str) {
        self.w(1);
        self.text(in name);
    }

    // `app(named(f), [named(a)])` and longer, for fixed names.
    pub fn app_named(inout self, in f: Str, in a: Str) {
        let mark = self.app(1);
        self.named(in f);
        self.args(mark);
        self.arg();
        self.named(in a);
    }

    // A binder with a fixed name; write its type after it.
    pub fn binder(inout self, kind: u64, in name: Str) {
        self.w(kind);
        self.w(1);
        self.text(in name);
    }

    // An anonymous instance binder; write its type after it.
    pub fn instance_binder(inout self) {
        self.w(B_INSTANCE);
        self.w(0);
    }

    // `implicit(name, Type)`.
    pub fn implicit_type(inout self, in name: Str) {
        self.binder(B_IMPLICIT, in name);
        self.type0();
    }

    // `{m : Type → Type}`.
    pub fn implicit_type_m(inout self) {
        self.binder(B_IMPLICIT, in "m");
        self.monad_ty();
    }

    // `[Monad m]`.
    pub fn monad_instance(inout self) {
        self.instance_binder();
        self.app_named_global(in "Monad", in "m");
    }

    // `app(global(&[f]), [named(a)])`.
    pub fn app_named_global(inout self, in f: Str, in a: Str) {
        let mark = self.app(1);
        self.global(in f);
        self.args(mark);
        self.arg();
        self.named(in a);
    }

    // `inferred`: a lambda over `n` fixed names, each `_`-typed; write the
    // names with `lambda_name`, then the body.
    pub fn lambda(inout self, n: u64) {
        self.w(T_FUN);
        self.w(n);
    }

    pub fn lambda_name(inout self, in name: Str) {
        self.binder(B_EXPLICIT, in name);
        self.w(T_INFER);
    }

    pub fn lambda_sym(inout self, sym: u32) {
        self.w(B_EXPLICIT);
        self.w(1);
        self.ident(sym);
        self.w(T_INFER);
    }

    pub fn binary(inout self, op: u64) {
        self.w(T_BINARY);
        self.w(op);
    }

    pub fn nat(inout self, in digits: Str) {
        self.w(T_NAT);
        self.text(in digits);
    }

    // The words written since `mark`, removed from the stream.
    pub fn cut(inout self, mark: u64) -> ChunkSeq[u64] {
        let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
        for i in mark..self.words.len() {
            match self.words.try_get(i) {
                Option::Some(word) => out.push(word),
                Option::None => {},
            }
        }
        self.words.truncate(mark);
        out
    }

    pub fn paste(inout self, in words: ChunkSeq[u64]) {
        for i in 0..words.len() {
            match words.try_get(i) {
                Option::Some(word) => self.words.push(word),
                Option::None => {},
            }
        }
    }

    // The encoded words, for the printer.
    pub fn slice_len(in self) -> u64 {
        self.words.len()
    }

    // ----- terms as word ranges (the structured extractor, part 3) -----

    pub fn at(in self) -> u64 {
        self.words.len()
    }

    // The words written since mark `mark`, as a term.
    pub fn since(in self, mark: u64) -> T {
        T { a: mark, n: wrapping_sub(self.words.len(), mark) }
    }

    // Writes a copy of `term`.
    pub fn put(inout self, term: T) {
        for i in 0..term.n {
            let word = self.words.try_get(wrapping_add(term.a, i)).unwrap_or(0);
            self.words.push(word);
        }
    }
}

// A subtree written earlier: words[a..a+n] of the builder. Composing terms
// copies their words, so a range stays valid for the builder's lifetime.
pub copy struct T {
    a: u64,
    n: u64,
}

// `\u{hex}`, lower case, no leading zeros.
fn put_escape(inout message: ChunkSeq[u8], code_point: u32) {
    put(inout message, in "\\u{");
    let mut shift: u32 = 28;
    let mut started = false;
    loop {
        let digit = wrapping_shr_u32(code_point, shift) & 15;
        if digit != 0 || started || shift == 0 {
            message.push(hex(digit));
            started = true;
        }
        if shift == 0 {
            break;
        }
        shift = wrapping_sub(shift, 4);
    }
    put(inout message, in "}");
}

pub fn put_decimal(inout out: ChunkSeq[u8], value: u64) {
    if value >= 10 {
        put_decimal(inout out, value / 10);
    }
    out.push(wrapping_u8(wrapping_add(value % 10, 48)));
}
