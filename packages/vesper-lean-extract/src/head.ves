// The source declarations before the functions (src/lean.rs
// `extract_report`): the ADT groups with the getters of recursive
// structures, then each effect's class, then each effect's CPS lift and its
// instance. `adt_groups` and `recursive_structs` order the ADTs by
// petgraph's `tarjan_scc` over a `DiGraphMap`, reproduced here exactly
// (`Graph`, `scc`).

use @vesper/check-data::types::{Types, TyKind, TyPass};
use @vesper/check-data::util::{add, n32, u32_at, u64_at, w};
use @vesper/check-data::world::{Adt, World};
use self::build::{
    B, B_EXPLICIT, B_IMPLICIT, D_DEF, D_INSTANCE, D_MUTUAL_TYPES, D_TYPE, K_ABBREV, K_DEF, P_BIND,
    P_CTOR, P_WILD, S_BIND, TD_CLASS, TD_INDUCTIVE, TD_STRUCTURE, T_ARROW, T_DO, T_MATCH, T_PRODUCT,
    T_RECORD
};
use self::input::{Effect, Effects, Op, Param};
use self::ty::{emit_ty, spells, ty_check};

const NONE32: u32 = 4294967295;

// The ADT graph: nodes are ADT indices in name order (Option, Result and,
// with fip active, Box left out); out-edges in first-insertion order.
pub struct Graph {
    // node -> ADT index
    adts: ChunkSeq[u32],
    // ADT index -> node + 1, or 0
    node_of: ChunkSeq[u32],
    // out-edges of node v: targets[starts[v]..starts[v + 1]]
    starts: ChunkSeq[u64],
    targets: ChunkSeq[u32],
}

fn excluded(in builder: B, in world: World, adt: Adt) -> bool {
    spells(in builder, adt.name, in "Option")
        || spells(in builder, adt.name, in "Result")
        || (world.box_active && spells(in builder, adt.name, in "Box"))
}

// `dependencies`/`deps`: the named types of `ty`, in preorder.
fn deps(in types: Types, ty: u32, inout out: ChunkSeq[u32]) {
    let node = types.node(ty);
    if node.kind == TyKind::Named {
        out.push(node.name);
        for i in 0..w(node.n) {
            deps(in types, types.arg(ty, i), inout out);
        }
    } else if node.kind == TyKind::Tuple {
        for i in 0..w(node.n) {
            deps(in types, types.arg(ty, i), inout out);
        }
    } else if node.kind == TyKind::Fn {
        for i in 0..w(node.n) {
            deps(in types, types.arg(ty, i), inout out);
        }
        deps(in types, node.r, inout out);
    }
}

pub fn graph(in builder: B, in types: Types, in world: World) -> Graph {
    let adt_count = world.adts.len();
    let mut adt_graph = Graph {
        adts: ChunkSeq::new[u32](),
        node_of: ChunkSeq::with_capacity[u32](adt_count),
        starts: ChunkSeq::new[u64](),
        targets: ChunkSeq::new[u32](),
    };
    adt_graph.node_of.resize(adt_count, 0);
    for i in 0..adt_count {
        let adt = world.adt(wrapping_u32(i));
        if !excluded(in builder, in world, adt) {
            let node = adt_graph.adts.len();
            adt_graph.adts.push(wrapping_u32(i));
            let ok = adt_graph.node_of.try_set(i, wrapping_u32(wrapping_add(node, 1)));
        }
    }
    let mut names: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for node in 0..adt_graph.adts.len() {
        let start = adt_graph.targets.len();
        adt_graph.starts.push(start);
        let adt = world.adt(u32_at(in adt_graph.adts, node));
        for variant_index in 0..w(adt.vn) {
            let variant = world.variant(add(w(adt.va), variant_index));
            for field_index in 0..w(variant.fc) {
                let field = world.field(add(w(variant.fa), field_index));
                names.clear();
                deps(in types, field.ty, inout names);
                for k in 0..names.len() {
                    let dep_index = world.lookup(u32_at(in names, k));
                    if dep_index != NONE32 {
                        let target = u32_at(in adt_graph.node_of, w(dep_index));
                        if target != 0 {
                            let to = wrapping_sub(target, 1);
                            let mut seen = false;
                            for edge in start..adt_graph.targets.len() {
                                if u32_at(in adt_graph.targets, edge) == to {
                                    seen = true;
                                }
                            }
                            if !seen {
                                adt_graph.targets.push(to);
                            }
                        }
                    }
                }
            }
        }
    }
    let end = adt_graph.targets.len();
    adt_graph.starts.push(end);
    adt_graph
}

impl Graph {
    pub fn has_edge(in self, from: u32, to: u32) -> bool {
        let edge_start = u64_at(in self.starts, w(from));
        let edge_end = u64_at(in self.starts, add(w(from), 1));
        for edge in edge_start..edge_end {
            if u32_at(in self.targets, edge) == to {
                return true;
            }
        }
        false
    }
}

// petgraph's `TarjanScc` state (`rootindex`, 0 for `None`).
pub struct Tarjan {
    root: ChunkSeq[u64],
    index: u64,
    count: u64,
    stack: ChunkSeq[u32],
    // the components, concatenated, and where each ends
    out: ChunkSeq[u32],
    ends: ChunkSeq[u64],
}

fn root_of(in tarjan: Tarjan, node: u32) -> u64 {
    u64_at(in tarjan.root, w(node))
}

fn set_root(inout tarjan: Tarjan, node: u32, root: u64) {
    let ok = tarjan.root.try_set(w(node), root);
}

fn visit(in adt_graph: Graph, inout tarjan: Tarjan, node: u32) {
    let mut local_root = true;
    set_root(inout tarjan, node, tarjan.index);
    tarjan.index = wrapping_add(tarjan.index, 1);
    let edge_start = u64_at(in adt_graph.starts, w(node));
    let edge_end = u64_at(in adt_graph.starts, add(w(node), 1));
    for edge in edge_start..edge_end {
        let target = u32_at(in adt_graph.targets, edge);
        if root_of(in tarjan, target) == 0 {
            visit(in adt_graph, inout tarjan, target);
        }
        if root_of(in tarjan, target) < root_of(in tarjan, node) {
            let target_root = root_of(in tarjan, target);
            set_root(inout tarjan, node, target_root);
            local_root = false;
        }
    }
    if local_root {
        let mut adjustment: u64 = 1;
        let component = tarjan.count;
        let node_root = root_of(in tarjan, node);
        let mut start: u64 = 0;
        let mut i = tarjan.stack.len();
        loop {
            if i == 0 {
                break;
            }
            let target = u32_at(in tarjan.stack, wrapping_sub(i, 1));
            if node_root > root_of(in tarjan, target) {
                start = i;
                break;
            }
            set_root(inout tarjan, target, component);
            adjustment = wrapping_add(adjustment, 1);
            i = wrapping_sub(i, 1);
        }
        set_root(inout tarjan, node, component);
        tarjan.stack.push(node);
        for k in start..tarjan.stack.len() {
            let member = u32_at(in tarjan.stack, k);
            tarjan.out.push(member);
        }
        let end = tarjan.out.len();
        tarjan.ends.push(end);
        tarjan.stack.truncate(start);
        tarjan.index = wrapping_sub(tarjan.index, adjustment);
        tarjan.count = wrapping_sub(tarjan.count, 1);
    } else {
        tarjan.stack.push(node);
    }
}

// `tarjan_scc`: components as node lists (`out`, cut at `ends`).
pub fn scc(in adt_graph: Graph) -> Tarjan {
    let node_count = adt_graph.adts.len();
    let mut tarjan = Tarjan {
        root: ChunkSeq::with_capacity[u64](node_count),
        index: 1,
        count: 18446744073709551615,
        stack: ChunkSeq::new[u32](),
        out: ChunkSeq::new[u32](),
        ends: ChunkSeq::new[u64](),
    };
    tarjan.root.resize(node_count, 0);
    for node in 0..node_count {
        if root_of(in tarjan, wrapping_u32(node)) == 0 {
            visit(in adt_graph, inout tarjan, wrapping_u32(node));
        }
    }
    tarjan
}

// `recursive_structs`: per node, whether it is a structure on a cycle.
fn recursive(in adt_graph: Graph, in tarjan: Tarjan, in world: World) -> ChunkSeq[bool] {
    let mut rec: ChunkSeq[bool] = ChunkSeq::with_capacity[bool](adt_graph.adts.len());
    rec.resize(adt_graph.adts.len(), false);
    let mut comp_start: u64 = 0;
    for component in 0..tarjan.ends.len() {
        let comp_end = u64_at(in tarjan.ends, component);
        let first = u32_at(in tarjan.out, comp_start);
        let cycle = wrapping_sub(comp_end, comp_start) > 1 || adt_graph.has_edge(first, first);
        if cycle {
            for k in comp_start..comp_end {
                let node = u32_at(in tarjan.out, k);
                if !world.adt(u32_at(in adt_graph.adts, w(node))).is_enum {
                    let ok = rec.try_set(w(node), true);
                }
            }
        }
        comp_start = comp_end;
    }
    rec
}

fn is_rec(in rec: ChunkSeq[bool], node: u32) -> bool {
    match rec.try_get(w(node)) {
        Option::Some(flag) => flag,
        Option::None => false,
    }
}

// The non-row generics of `adt`, as `(name : Type)` binders of `kind`.
fn generic_count(in world: World, adt: Adt) -> u64 {
    let mut count: u64 = 0;
    for i in 0..w(adt.gn) {
        if !world.generic(add(w(adt.ga), i)).row {
            count = wrapping_add(count, 1);
        }
    }
    count
}

fn generic_binders(inout builder: B, in world: World, adt: Adt, kind: u64) {
    for i in 0..w(adt.gn) {
        let generic = world.generic(add(w(adt.ga), i));
        if !generic.row {
            builder.w(kind);
            builder.w(1);
            builder.ident(generic.name);
            builder.type0();
        }
    }
}

// `(fNAME : T)` binders of a variant's fields.
fn field_binders(inout builder: B, in types: Types, in world: World, fa: u32, fc: u32) {
    builder.w(w(fc));
    for i in 0..w(fc) {
        let field = world.field(add(w(fa), i));
        builder.w(B_EXPLICIT);
        builder.w(1);
        let field_sym = builder.joined(in "f", field.name, in "");
        builder.ident(field_sym);
        emit_ty(inout builder, in types, field.ty, world.box_active);
    }
}

// The ADT's identifier and type errors in the order `extract_report`
// meets them: the generic names, then (for a recursive structure, whose
// getters come first) the self type and the getters' field names and
// types, then the declaration's name, constructor names, field names and
// field types.
fn check_adt(inout builder: B, in types: Types, in world: World, adt: Adt, rec: bool) {
    for i in 0..w(adt.gn) {
        let generic = world.generic(add(w(adt.ga), i));
        if !generic.row {
            builder.check(generic.name, in "identifier");
        }
    }
    if rec {
        for i in 0..w(adt.gn) {
            let generic = world.generic(add(w(adt.ga), i));
            if !generic.row {
                builder.check(generic.name, in "name");
            }
        }
        builder.check(adt.name, in "name");
        builder.check(adt.name, in "identifier");
        let variant = world.variant(w(adt.va));
        for field_index in 0..w(variant.fc) {
            let field = world.field(add(w(variant.fa), field_index));
            builder.check(adt.name, in "identifier");
            builder.check(field.name, in "identifier");
            ty_check(inout builder, in types, field.ty, world.box_active);
        }
    }
    builder.check(adt.name, in "name");
    for variant_index in 0..w(adt.vn) {
        let variant = world.variant(add(w(adt.va), variant_index));
        if adt.is_enum {
            builder.check(variant.name, in "identifier");
        }
        for field_index in 0..w(variant.fc) {
            let field = world.field(add(w(variant.fa), field_index));
            if adt.is_enum || rec {
                let field_sym = builder.joined(in "f", field.name, in "");
                builder.check(field_sym, in "identifier");
            } else {
                builder.check(field.name, in "identifier");
            }
            ty_check(inout builder, in types, field.ty, world.box_active);
        }
    }
}

fn deriving(inout builder: B, adt: Adt) {
    if adt.tile != 0 {
        builder.w(1);
        builder.name_fixed(in "Inhabited");
    } else {
        builder.w(0);
    }
}

fn type_declaration(inout builder: B, in types: Types, in world: World, adt: Adt, rec: bool) {
    let params = generic_count(in world, adt);
    if adt.is_enum {
        builder.w(TD_INDUCTIVE);
        builder.name(adt.name);
        builder.w(params);
        generic_binders(inout builder, in world, adt, B_EXPLICIT);
        builder.type0();
        builder.w(w(adt.vn));
        for variant_index in 0..w(adt.vn) {
            let variant = world.variant(add(w(adt.va), variant_index));
            builder.ident(variant.name);
            field_binders(inout builder, in types, in world, variant.fa, variant.fc);
            builder.w(0);
        }
        builder.w(0);
    } else if rec {
        let variant = world.variant(w(adt.va));
        builder.w(TD_INDUCTIVE);
        builder.name(adt.name);
        builder.w(params);
        generic_binders(inout builder, in world, adt, B_EXPLICIT);
        builder.type0();
        builder.w(1);
        builder.text(in "mk");
        field_binders(inout builder, in types, in world, variant.fa, variant.fc);
        builder.w(0);
        deriving(inout builder, adt);
    } else {
        let variant = world.variant(w(adt.va));
        builder.w(TD_STRUCTURE);
        builder.name(adt.name);
        builder.w(params);
        generic_binders(inout builder, in world, adt, B_EXPLICIT);
        builder.w(w(variant.fc));
        for i in 0..w(variant.fc) {
            let field = world.field(add(w(variant.fa), i));
            builder.ident(field.name);
            emit_ty(inout builder, in types, field.ty, world.box_active);
            builder.w(0);
        }
        deriving(inout builder, adt);
    }
}

// The getters of a recursive structure: `def A.f {α} ($self : A α) : T :=
// match $self with | A.mk _ .. $field .. _ => $field`.
fn getters(inout builder: B, in types: Types, in world: World, adt: Adt) -> u64 {
    let variant = world.variant(w(adt.va));
    let params = generic_count(in world, adt);
    let mk_sym = builder.intern(in "mk");
    for i in 0..w(variant.fc) {
        let field = world.field(add(w(variant.fa), i));
        builder.w(D_DEF);
        builder.w(K_DEF);
        builder.name2(adt.name, field.name);
        builder.w(wrapping_add(params, 1));
        generic_binders(inout builder, in world, adt, B_IMPLICIT);
        builder.w(B_EXPLICIT);
        builder.w(1);
        builder.text(in "$self");
        if params == 0 {
            builder.sref(adt.name);
        } else {
            let mark = builder.app(params);
            builder.sref(adt.name);
            builder.args(mark);
            for generic_index in 0..w(adt.gn) {
                let generic = world.generic(add(w(adt.ga), generic_index));
                if !generic.row {
                    builder.arg();
                    builder.sref(generic.name);
                }
            }
        }
        emit_ty(inout builder, in types, field.ty, world.box_active);
        builder.w(T_MATCH);
        builder.w(1);
        builder.named(in "$self");
        builder.w(P_CTOR);
        builder.name2(adt.name, mk_sym);
        builder.w(w(variant.fc));
        for field_index in 0..w(variant.fc) {
            if field_index == i {
                builder.w(P_BIND);
                builder.text(in "$field");
            } else {
                builder.w(P_WILD);
            }
        }
        builder.named(in "$field");
    }
    w(variant.fc)
}

// The ADT groups and their getters; returns the number of declarations.
pub fn adt_groups(inout builder: B, in types: Types, in world: World) -> u64 {
    let adt_graph = graph(in builder, in types, in world);
    let tarjan = scc(in adt_graph);
    let rec = recursive(in adt_graph, in tarjan, in world);
    let mut count: u64 = 0;
    let mut comp_start: u64 = 0;
    for component in 0..tarjan.ends.len() {
        let comp_end = u64_at(in tarjan.ends, component);
        for k in comp_start..comp_end {
            let node = u32_at(in tarjan.out, k);
            let adt = world.adt(u32_at(in adt_graph.adts, w(node)));
            check_adt(inout builder, in types, in world, adt, is_rec(in rec, node));
        }
        builder.w(D_MUTUAL_TYPES);
        builder.w(wrapping_sub(comp_end, comp_start));
        for k in comp_start..comp_end {
            let node = u32_at(in tarjan.out, k);
            let adt = world.adt(u32_at(in adt_graph.adts, w(node)));
            type_declaration(inout builder, in types, in world, adt, is_rec(in rec, node));
        }
        count = wrapping_add(count, 1);
        for k in comp_start..comp_end {
            let node = u32_at(in tarjan.out, k);
            if is_rec(in rec, node) {
                let adt = world.adt(u32_at(in adt_graph.adts, w(node)));
                let getter_count = getters(inout builder, in types, in world, adt);
                count = wrapping_add(count, getter_count);
            }
        }
        comp_start = comp_end;
    }
    count
}

// `Effect_E α.. m` applied to the caller's last argument (written after).
fn effect_app(inout builder: B, in effects: Effects, decl: Effect, class_sym: u32) {
    let mark = builder.app(wrapping_add(w(decl.gn), 1));
    builder.sref(class_sym);
    builder.args(mark);
    for i in 0..w(decl.gn) {
        builder.arg();
        builder.sref(effects.generic(decl, i));
    }
    builder.arg();
}

// Each effect's class: `class Effect_E (α : Type) .. (m : Type → Type)
// where op : P.. → m (R × inout..)`.
pub fn effect_classes(
    inout builder: B,
    in types: Types,
    in world: World,
    in effects: Effects
) -> u64 {
    let effect_count = effects.effects.len();
    for i in 0..effect_count {
        let decl = effects.effect_at(i);
        for op_index in 0..w(decl.op_count) {
            let op = effects.op(decl, op_index);
            ty_check(inout builder, in types, op.result, world.box_active);
            for param_index in 0..w(op.param_count) {
                let param = effects.param(op, param_index);
                if param.pass == TyPass::Inout {
                    ty_check(inout builder, in types, param.ty, world.box_active);
                }
            }
            for param_index in 0..w(op.param_count) {
                ty_check(
                    inout builder,
                    in types,
                    effects.param(op, param_index).ty,
                    world.box_active
                );
            }
        }
        builder.w(D_TYPE);
        builder.w(TD_CLASS);
        let class_sym = builder.joined(in "Effect_", decl.name, in "");
        builder.name(class_sym);
        builder.w(wrapping_add(w(decl.gn), 1));
        for generic_index in 0..w(decl.gn) {
            builder.w(B_EXPLICIT);
            builder.w(1);
            builder.ident(effects.generic(decl, generic_index));
            builder.type0();
        }
        builder.binder(B_EXPLICIT, in "m");
        builder.monad_ty();
        builder.w(w(decl.op_count));
        for op_index in 0..w(decl.op_count) {
            let op = effects.op(decl, op_index);
            builder.ident(op.name);
            for param_index in 0..w(op.param_count) {
                builder.w(T_ARROW);
                emit_ty(
                    inout builder,
                    in types,
                    effects.param(op, param_index).ty,
                    world.box_active
                );
            }
            let mark = builder.app(1);
            builder.named(in "m");
            builder.args(mark);
            builder.arg();
            let mut results: u64 = 1;
            for param_index in 0..w(op.param_count) {
                if effects.param(op, param_index).pass == TyPass::Inout {
                    results = wrapping_add(results, 1);
                }
            }
            if results > 1 {
                builder.w(T_PRODUCT);
                builder.w(results);
            }
            emit_ty(inout builder, in types, op.result, world.box_active);
            for param_index in 0..w(op.param_count) {
                let param = effects.param(op, param_index);
                if param.pass == TyPass::Inout {
                    emit_ty(inout builder, in types, param.ty, world.box_active);
                }
            }
            builder.w(0);
        }
    }
    effect_count
}

// `{S O : Type} {m : Type → Type} [Monad m] {α : Type} ..`.
fn lift_binders(inout builder: B, in effects: Effects, decl: Effect) {
    builder.implicit_type(in "S");
    builder.implicit_type(in "O");
    builder.binder(B_IMPLICIT, in "m");
    builder.monad_ty();
    builder.monad_instance();
    for generic_index in 0..w(decl.gn) {
        builder.w(B_IMPLICIT);
        builder.w(1);
        builder.ident(effects.generic(decl, generic_index));
        builder.type0();
    }
}

// `Effect_E α.. (HandlerCPS S O m)`.
fn destination(inout builder: B, in effects: Effects, decl: Effect, class_sym: u32) {
    effect_app(inout builder, in effects, decl, class_sym);
    let mark = builder.app(3);
    builder.named(in "HandlerCPS");
    builder.args(mark);
    builder.arg();
    builder.named(in "S");
    builder.arg();
    builder.named(in "O");
    builder.arg();
    builder.named(in "m");
}

// Each effect's `abbrev lift_E` and its instance.
pub fn effect_lifts(inout builder: B, in effects: Effects) -> u64 {
    let effect_count = effects.effects.len();
    for i in 0..effect_count {
        let decl = effects.effect_at(i);
        let class_sym = builder.joined(in "Effect_", decl.name, in "");
        let lift = builder.joined(in "lift_", decl.name, in "");
        builder.w(D_DEF);
        builder.w(K_ABBREV);
        builder.name(lift);
        builder.w(wrapping_add(w(decl.gn), 5));
        lift_binders(inout builder, in effects, decl);
        builder.binder(B_EXPLICIT, in "evidence");
        effect_app(inout builder, in effects, decl, class_sym);
        builder.named(in "m");
        destination(inout builder, in effects, decl, class_sym);
        builder.w(T_RECORD);
        builder.w(w(decl.op_count));
        for op_index in 0..w(decl.op_count) {
            let op = effects.op(decl, op_index);
            builder.ident(op.name);
            // fun $arg0 .. k s => do let result ← Effect_E.op (self :=
            // evidence) $arg0 ..; k result s
            builder.lambda(wrapping_add(w(op.param_count), 2));
            for param_index in 0..w(op.param_count) {
                let arg = builder.numbered(in "$arg", param_index);
                builder.lambda_sym(arg);
            }
            builder.lambda_name(in "k");
            builder.lambda_name(in "s");
            builder.w(T_DO);
            builder.w(1);
            builder.w(S_BIND);
            builder.w(P_BIND);
            builder.text(in "result");
            let mark = builder.app(wrapping_add(w(op.param_count), 1));
            builder.w(1);
            builder.name2(class_sym, op.name);
            builder.args(mark);
            builder.named_arg(in "self");
            builder.named(in "evidence");
            for param_index in 0..w(op.param_count) {
                builder.arg();
                let arg = builder.numbered(in "$arg", param_index);
                builder.w(1);
                builder.w(0);
                builder.w(1);
                builder.ident(arg);
            }
            let cont_mark = builder.app(2);
            builder.named(in "k");
            builder.args(cont_mark);
            builder.arg();
            builder.named(in "result");
            builder.arg();
            builder.named(in "s");
        }
        // instance [evidence : Effect_E α.. m] : Effect_E α.. (HandlerCPS S O m)
        builder.w(D_INSTANCE);
        builder.w(0);
        builder.w(wrapping_add(w(decl.gn), 5));
        lift_binders(inout builder, in effects, decl);
        builder.w(2);
        builder.w(1);
        builder.text(in "evidence");
        effect_app(inout builder, in effects, decl, class_sym);
        builder.named(in "m");
        destination(inout builder, in effects, decl, class_sym);
        let mark = builder.app(1);
        builder.sref(lift);
        builder.args(mark);
        builder.arg();
        builder.named(in "evidence");
    }
    wrapping_mul(effect_count, 2)
}

// Whether `world.effects["Fail"]` is `Fail[E]` with the one op `raise`.
pub fn has_fail_model(in builder: B, in effects: Effects) -> bool {
    for i in 0..effects.effects.len() {
        let decl = effects.effect_at(i);
        if spells(in builder, decl.name, in "Fail") {
            return decl.gn == 1
                && decl.op_count == 1
                && spells(in builder, effects.op(decl, 0).name, in "raise");
        }
    }
    false
}

// `recursive_structs`, by ADT index: whether the ADT is a structure in a
// recursive group.
pub fn recursive_structs(in builder: B, in types: Types, in world: World) -> ChunkSeq[bool] {
    let adt_graph = graph(in builder, in types, in world);
    let tarjan = scc(in adt_graph);
    let rec = recursive(in adt_graph, in tarjan, in world);
    let mut out: ChunkSeq[bool] = ChunkSeq::with_capacity[bool](world.adts.len());
    out.resize(world.adts.len(), false);
    for node in 0..adt_graph.adts.len() {
        if is_rec(in rec, n32(node)) {
            let ok = out.try_set(w(u32_at(in adt_graph.adts, node)), true);
        }
    }
    out
}
