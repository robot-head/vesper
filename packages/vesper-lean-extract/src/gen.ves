    Ast,
    EffDecl,
    EffOp,
    Range,
    L_BOOL,
    L_FLOAT,
    L_INT,
    NONE,
    NONE32,
    PK_BIND,
    PK_CTOR,
    PK_LITERAL,
    PK_TUPLE,
    PK_WILD,
    Q_AS_SLICE,
    Q_CLEAR,
    Q_EXTEND,
    Q_FINISH,
    Q_GET,
    Q_LAST,
    Q_LEN,
    Q_NEW,
    Q_POP,
    Q_PUSH,
    Q_RESERVE,
    Q_SET,
    Q_SUB_SLICE,
    Q_TRUNCATE,
    Q_TRY_GET,
    Q_TRY_SET,
    Q_WITH_CAPACITY,
    SrcFn,
    TO_COL_GET,
    TO_COL_SET,
    TO_GET,
    TO_LEN,
    TO_LOAD_TILE_VEC,
    TO_NEW,
    TO_PUSH,
    TO_SET,
    TO_TILE_COUNT,
    TO_WITH_CAPACITY,
    TO_WITH_REGION,
    X_ASSIGN,
    X_BINARY,
    X_BLOCK,
    X_CALL,
    X_CLOSURE,
    X_FIELD,
    X_HANDLE,
    X_IF,
    X_INDEX,
    X_LITERAL,
    X_LOOP,
    X_MATCH,
    X_NAME,
    X_STRUCT,
    X_TRY,
    X_TUPLE,
    X_UNARY
};
use self::build::{
    B,
    B_EXPLICIT,
    B_IMPLICIT,
    B_INSTANCE,
    D_DEF,
    K_PARTIAL,
    OP_ADD,
    OP_BOOL_AND,
    OP_BOOL_EQ,
    OP_BOOL_NE,
    OP_BOOL_OR,
    OP_DIV,
    OP_GE,
    OP_GT,
    OP_LE,
    OP_LT,
    OP_MOD,
    OP_MUL,
    OP_SUB,
