// The structured extractor (`Generator` in src/lean.rs) over `Id`: the
// functions the CFG extractor refuses that need no ambient monad (part 3a).
// It walks the source AST (ast.ves) and builds terms as word ranges
// (tm.ves) in Rust's evaluation order, so the first error is Rust's.
//
// What this part does not port yet sets `skip` instead of guessing:
// handlers and effect operations, effectful closures and calls, and types
// with effectful arrows (which need the `Id` monad in `ty`). The
// differential compares the other functions.

use @vesper/check-data::types::{Types, Vars, substitute, vars_new, TyKind, TyPass};
use @vesper/check-data::util::{add, inc, n32, u32_at, u64_at, w};
use @vesper/check-data::world::{Adt, World, set_by_symbol};
use self::ast::{
    Ast, EffDecl, EffOp, Range, L_BOOL, L_FLOAT, L_INT, L_WIDE, NONE, NONE32, PK_BIND, PK_CTOR,
    PK_LITERAL, PK_TUPLE, PK_WILD, Q_AS_SLICE, Q_CLEAR, Q_EXTEND, Q_FINISH, Q_GET, Q_LAST, Q_LEN,
    Q_NEW, Q_POP, Q_PUSH, Q_RESERVE, Q_SET, Q_SUB_SLICE, Q_TRUNCATE, Q_TRY_GET, Q_TRY_SET,
    Q_WITH_CAPACITY, SrcFn, TO_COL_GET, TO_COL_SET, TO_GET, TO_LEN, TO_LOAD_TILE_VEC, TO_NEW,
    TO_PUSH, TO_SET, TO_TILE_COUNT, TO_WITH_CAPACITY, TO_WITH_REGION, X_ASSIGN, X_BINARY, X_BLOCK,
    X_CALL, X_CLOSURE, X_FIELD, X_HANDLE, X_IF, X_INDEX, X_LITERAL, X_LOOP, X_MATCH, X_NAME,
    X_STRUCT, X_TRY, X_TUPLE, X_UNARY
};
use self::build::{
    B, B_EXPLICIT, B_IMPLICIT, B_INSTANCE, D_DEF, K_DEF, K_PARTIAL, OP_ADD, OP_BOOL_AND, OP_BOOL_EQ,
    OP_BOOL_NE, OP_BOOL_OR, OP_DIV, OP_GE, OP_GT, OP_LE, OP_LT, OP_MOD, OP_MUL, OP_SUB, OP_AND,
    P_BOOL, P_INT, P_RECORD, P_STRING, T, T_BOOL, T_REF, T_STRING, U_BOOL_NOT, U_NEG
};
use self::tm::{
    arrow, arrows, let_instance, match_stmt2, app, app1, app2, app3, app_args, arm, ascribe,
    assign as push_assign, bind_local, bind_pattern_stmt, binary, eliminate, empty, explicit,
    anonymous, binder_sym, expr_stmt, extend, field as record_field, gapp1, gapp2, gapp3, get,
    global, global2, if_stmt, infer, ite, lambda, let_local, let_pattern, lref, match_term, named,
    named_arg, named_arg_sym, nat, nat_u64, p_ctor, p_tuple, p_wild, p_bind, p_nat, pos, product,
    project, project_fixed, pure, pair_get, record, rooted2, sequence, sref, tuple, tuple_get,
    unary, unit, update
};
use self::ty::{E_NONE, emit_ty, emit_ty_m, report, spells, ty_check, ty_error, ty_error_m};
use self::cfg::{effectful_arrow};
use self::fn_input::{Fns, Sig};
use self::emit::{
    LOOP_REFUSAL, X, adt_of, f32_bits, lookup_constructor, parse_index, put_u128, variant_of
};

const NONE64: u64 = 18446744073709551615;

// Integer kinds: bits, plus 256 when signed; 0 is no kind.
const SIGNED: u64 = 256;

const INOUT_SLICE: Str = "Lean extraction does not model inout Slice arguments: they write through to their sequence";

// The read-only context.
pub struct Y {
    // the CFG extractor's context: program, world, signatures and
    // `recursive_structs` (per ADT index)
    env: X,
    ast: Ast,
    fip: bool,
    infer: u32,
}

pub copy struct Local {
    name: u32,
    id: u64,
    ty: u32,
    // the number of enclosing handler layers at the declaration
    depth: u64,
}

pub copy struct Cur {
    id: u64,
    sym: u32,
}

// An effect instance: name, label symbol or NONE32, arguments
// (`G::inst_args[arg_start..arg_start+arg_count]`) and its `instance_key` symbol or NONE32.
pub copy struct Inst {
    name: u32,
    label: u32,
    arg_start: u64,
    arg_count: u64,
    key: u32,
}

// `CapBinding` under `key` (a label for `caps`, an effect name for
// `unlabeled`); `removed` hides earlier entries of the key.
pub copy struct Cap {
    key: u32,
    removed: bool,
    inst: Inst,
    term: T,
    depth: u64,
}

// `Layer`: one lexical CPS handler. Its frame ids are `G::index_pool[fa..fa+fz]`,
// its operations `G::infos[op_start..op_start+op_count]`.
pub copy struct Layer {
    state: T,
    output: T,
    base: T,
    child: T,
    inst: Inst,
    fa: u64,
    fz: u64,
    frame_ty: T,
    op_start: u64,
    op_count: u64,
    closures: u64,
}

// `OpInfo` for the operation `name`; aliased parameter indices are
// `G::index_pool[aliased_start..aliased_start+aliased_count]`.
pub copy struct OpInfo {
    name: u32,
    implementation: u32,
    aliased_start: u64,
    aliased_count: u64,
    post_access: bool,
}

// `Alias`; its bindings are `G::alias_binds[bind_start..bind_start+bind_count]`.
pub copy struct Alias {
    lens: u32,
    raw: u32,
    ty: u32,
    pass: u64,
    bind_start: u64,
    bind_count: u64,
}

// A binding of an alias: the binding id and its path
// `G::paths[path_start..path_start+path_count]`.
pub copy struct ABind {
    id: u64,
    path_start: u64,
    path_count: u64,
}

// `Resumption` of continuation `key`; aliases are
// `G::aliases[alias_start..alias_start+alias_count]`.
pub copy struct Resumption {
    key: u32,
    resume: u32,
    state: u32,
    stateful: bool,
    frame: u32,
    context: u64,
    depth: u64,
    alias_start: u64,
    alias_count: u64,
    // NONE32 when there is no first-class fallback
    fallback: u32,
}

// `Saved`: what `save` records and `restore` puts back. Stacks are
// truncated to their saved lengths.
pub copy struct Saved {
    scope_len: u64,
    current_len: u64,
    caps_len: u64,
    unlabeled_len: u64,
    conts_len: u64,
    context: u64,
    bl_len: u64,
    bl_start: u64,
    closures: u64,
    ca_len: u64,
    ca_start: u64,
    alias_written: bool,
    monad: T,
    monad_id: bool,
    own_sync: bool,
    own_sync_start: u64,
    own_sync_count: u64,
}

// `Generator`'s state for one function.
pub struct G {
    counter: u64,
    // symbol -> 1 when used
    used: ChunkSeq[u32],
    used_list: ChunkSeq[u32],
    // `scope` and `current` as stacks: the last entry wins, and a restore
    // truncates.
    scope: ChunkSeq[Local],
    current: ChunkSeq[Cur],
    next_binding: u64,
    skip: bool,
    // the ambient monad and whether it is `Id`
    monad: T,
    monad_id: bool,
    caps: ChunkSeq[Cap],
    unlabeled: ChunkSeq[Cap],
    layers: ChunkSeq[Layer],
    conts: ChunkSeq[Resumption],
    context: u64,
    next_context: u64,
    // `body_layers` and `clause_aliases`: entries from the start index on
    body_layers: ChunkSeq[u64],
    bl_start: u64,
    closures: u64,
    clause_aliases: ChunkSeq[u64],
    ca_start: u64,
    alias_written: bool,
    // `own_sync`: on, with ids `index_pool[own_sync_start..own_sync_start+own_sync_count]`
    own_sync: bool,
    own_sync_start: u64,
    own_sync_count: u64,
    // append-only pools
    inst_args: ChunkSeq[u32],
    index_pool: ChunkSeq[u64],
    infos: ChunkSeq[OpInfo],
    aliases: ChunkSeq[Alias],
    alias_binds: ChunkSeq[ABind],
    paths: ChunkSeq[u32],
    // fuel companions (part 3c): symbol -> 1 for the recursive family
    family: ChunkSeq[u32],
    // generating the total `f$fuel` companions (`Generator::fuel`)
    fuel: bool,
}

pub fn gen_new() -> G {
    G {
        counter: 0,
        used: ChunkSeq::new[u32](),
        used_list: ChunkSeq::new[u32](),
        scope: ChunkSeq::new[Local](),
        current: ChunkSeq::new[Cur](),
        next_binding: 0,
        skip: false,
        monad: T { a: 0, n: 0 },
        monad_id: true,
        caps: ChunkSeq::new[Cap](),
        unlabeled: ChunkSeq::new[Cap](),
        layers: ChunkSeq::new[Layer](),
        conts: ChunkSeq::new[Resumption](),
        context: 0,
        next_context: 1,
        body_layers: ChunkSeq::new[u64](),
        bl_start: 0,
        closures: 0,
        clause_aliases: ChunkSeq::new[u64](),
        ca_start: 0,
        alias_written: false,
        own_sync: false,
        own_sync_start: 0,
        own_sync_count: 0,
        inst_args: ChunkSeq::new[u32](),
        index_pool: ChunkSeq::new[u64](),
        infos: ChunkSeq::new[OpInfo](),
        aliases: ChunkSeq::new[Alias](),
        alias_binds: ChunkSeq::new[ABind](),
        paths: ChunkSeq::new[u32](),
        family: ChunkSeq::new[u32](),
        fuel: false,
    }
}

fn no_inst() -> Inst {
    Inst { name: 0, label: NONE32, arg_start: 0, arg_count: 0, key: NONE32 }
}

fn no_cap() -> Cap {
    Cap { key: NONE32, removed: true, inst: no_inst(), term: T { a: 0, n: 0 }, depth: 0 }
}

fn no_t() -> T {
    T { a: 0, n: 0 }
}

impl G {
    pub fn reset(inout self) {
        for i in 0..self.used_list.len() {
            let sym = u32_at(in self.used_list, i);
            let ok = self.used.try_set(w(sym), 0);
        }
        self.used_list.clear();
        self.scope.clear();
        self.current.clear();
        self.counter = 0;
        self.next_binding = 0;
        self.skip = false;
        self.monad_id = true;
        self.caps.clear();
        self.unlabeled.clear();
        self.layers.clear();
        self.conts.clear();
        self.context = 0;
        self.next_context = 1;
        self.body_layers.clear();
        self.bl_start = 0;
        self.closures = 0;
        self.clause_aliases.clear();
        self.ca_start = 0;
        self.alias_written = false;
        self.own_sync = false;
        self.own_sync_start = 0;
        self.own_sync_count = 0;
        self.inst_args.clear();
        self.index_pool.clear();
        self.infos.clear();
        self.aliases.clear();
        self.alias_binds.clear();
        self.paths.clear();
    }

    fn is_used(in self, sym: u32) -> bool {
        u32_at(in self.used, w(sym)) != 0
    }

    fn mark_used(inout self, sym: u32) {
        if !self.is_used(sym) {
            set_by_symbol(inout self.used, sym, 1);
            self.used_list.push(sym);
        }
    }

    // The scope entry of `name`, or NONE64.
    fn find(in self, name: u32) -> u64 {
        let mut i = self.scope.len();
        loop {
            if i == 0 {
                return NONE64;
            }
            i = wrapping_sub(i, 1);
            match self.scope.try_get(i) {
                Option::Some(entry) => {
                    if entry.name == name {
                        return i;
                    }
                },
                Option::None => {},
            }
        }
    }

    fn local(in self, i: u64) -> Local {
        match self.scope.try_get(i) {
            Option::Some(entry) => entry,
            Option::None => Local { name: 0, id: 0, ty: 0, depth: 0 },
        }
    }

    fn has(in self, name: u32) -> bool {
        self.find(name) != NONE64
    }

    // `current[id]`.
    fn cur(in self, id: u64) -> u32 {
        let mut i = self.current.len();
        loop {
            if i == 0 {
                return 0;
            }
            i = wrapping_sub(i, 1);
            match self.current.try_get(i) {
                Option::Some(entry) => {
                    if entry.id == id {
                        return entry.sym;
                    }
                },
                Option::None => {},
            }
        }
    }

    // Whether `current` has `id`.
    fn has_cur(in self, id: u64) -> bool {
        let mut i = self.current.len();
        loop {
            if i == 0 {
                return false;
            }
            i = wrapping_sub(i, 1);
            match self.current.try_get(i) {
                Option::Some(entry) => {
                    if entry.id == id {
                        return true;
                    }
                },
                Option::None => {},
            }
        }
    }

    fn set_cur(inout self, id: u64, sym: u32) {
        self.current.push(Cur { id: id, sym: sym });
    }

    fn ix(in self, i: u64) -> u64 {
        self.index_pool.try_get(i).unwrap_or(0)
    }

    fn layer(in self, i: u64) -> Layer {
        match self.layers.try_get(i) {
            Option::Some(l) => l,
            Option::None => Layer {
                state: no_t(),
                output: no_t(),
                base: no_t(),
                child: no_t(),
                inst: no_inst(),
                fa: 0,
                fz: 0,
                frame_ty: no_t(),
                op_start: 0,
                op_count: 0,
                closures: 0
            },
        }
    }

    fn info(in self, layer: Layer, op: u32) -> OpInfo {
        for i in 0..layer.op_count {
            match self.infos.try_get(add(layer.op_start, i)) {
                Option::Some(entry) => {
                    if entry.name == op {
                        return entry;
                    }
                },
                Option::None => {},
            }
        }
        OpInfo {
            name: NONE32,
            implementation: 0,
            aliased_start: 0,
            aliased_count: 0,
            post_access: false
        }
    }

    fn alias(in self, i: u64) -> Alias {
        match self.aliases.try_get(i) {
            Option::Some(a) => a,
            Option::None => Alias { lens: 0, raw: 0, ty: 0, pass: 0, bind_start: 0, bind_count: 0 },
        }
    }

    fn abind(in self, i: u64) -> ABind {
        match self.alias_binds.try_get(i) {
            Option::Some(a) => a,
            Option::None => ABind { id: 0, path_start: 0, path_count: 0 },
        }
    }

    fn earg(in self, inst: Inst, i: u64) -> u32 {
        u32_at(in self.inst_args, add(inst.arg_start, i))
    }

    // The last entry of `key` in `caps` (or `unlabeled`), or a removed one.
    fn cap_in(in self, in table: ChunkSeq[Cap], key: u32) -> Cap {
        let mut i = table.len();
        loop {
            if i == 0 {
                return no_cap();
            }
            i = wrapping_sub(i, 1);
            match table.try_get(i) {
                Option::Some(entry) => {
                    if entry.key == key {
                        return entry;
                    }
                },
                Option::None => {},
            }
        }
    }

    fn cap(in self, label: u32) -> Cap {
        self.cap_in(in self.caps, label)
    }

    fn unlabeled_cap(in self, name: u32) -> Cap {
        self.cap_in(in self.unlabeled, name)
    }

    // The continuation named `key`, or one with key NONE32.
    fn cont(in self, key: u32) -> Resumption {
        let mut i = self.conts.len();
        loop {
            if i == 0 {
                return Resumption {
                    key: NONE32,
                    resume: 0,
                    state: 0,
                    stateful: false,
                    frame: 0,
                    context: 0,
                    depth: 0,
                    alias_start: 0,
                    alias_count: 0,
                    fallback: NONE32
                };
            }
            i = wrapping_sub(i, 1);
            match self.conts.try_get(i) {
                Option::Some(entry) => {
                    if entry.key == key {
                        return entry;
                    }
                },
                Option::None => {},
            }
        }
    }

    fn in_family(in self, n: u32) -> bool {
        u32_at(in self.family, w(n)) != 0
    }

    fn save(in self) -> Saved {
        Saved {
            scope_len: self.scope.len(),
            current_len: self.current.len(),
            caps_len: self.caps.len(),
            unlabeled_len: self.unlabeled.len(),
            conts_len: self.conts.len(),
            context: self.context,
            bl_len: self.body_layers.len(),
            bl_start: self.bl_start,
            closures: self.closures,
            ca_len: self.clause_aliases.len(),
            ca_start: self.ca_start,
            alias_written: self.alias_written,
            monad: self.monad,
            monad_id: self.monad_id,
            own_sync: self.own_sync,
            own_sync_start: self.own_sync_start,
            own_sync_count: self.own_sync_count
        }
    }

    fn restore(inout self, saved: Saved) {
        self.scope.truncate(saved.scope_len);
        self.current.truncate(saved.current_len);
        self.caps.truncate(saved.caps_len);
        self.unlabeled.truncate(saved.unlabeled_len);
        self.conts.truncate(saved.conts_len);
        self.context = saved.context;
        self.body_layers.truncate(saved.bl_len);
        self.bl_start = saved.bl_start;
        self.closures = saved.closures;
        self.clause_aliases.truncate(saved.ca_len);
        self.ca_start = saved.ca_start;
        self.alias_written = saved.alias_written;
        self.monad = saved.monad;
        self.monad_id = saved.monad_id;
        self.own_sync = saved.own_sync;
        self.own_sync_start = saved.own_sync_start;
        self.own_sync_count = saved.own_sync_count;
    }

    fn new_context(inout self) {
        self.context = self.next_context;
        self.next_context = inc(self.next_context);
    }

    fn clear_body_layers(inout self) {
        self.bl_start = self.body_layers.len();
    }

    fn clear_clause_aliases(inout self) {
        self.ca_start = self.clause_aliases.len();
    }

    fn has_clause_aliases(in self) -> bool {
        self.clause_aliases.len() > self.ca_start
    }

    fn is_clause_alias(in self, id: u64) -> bool {
        for i in self.ca_start..self.clause_aliases.len() {
            match self.clause_aliases.try_get(i) {
                Option::Some(alias_id) => {
                    if alias_id == id {
                        return true;
                    }
                },
                Option::None => {},
            }
        }
        false
    }

    // `enter_clause`.
    fn enter_clause(inout self) {
        self.new_context();
        self.own_sync = false;
        self.clear_body_layers();
        self.clear_clause_aliases();
        self.alias_written = false;
    }
}

// Marks what this part does not port yet (unless an error came first).
fn skip(inout builder: B, inout gen: G) {
    if !builder.failed {
        gen.skip = true;
    }
}

// ----- names ---------------------------------------------------------------------

fn put(inout out: ChunkSeq[u8], in text: Str) {
    out.extend(in text.as_bytes());
}

fn sym_of(inout builder: B, in bytes: ChunkSeq[u8]) -> u32 {
    builder.names.intern(in bytes.as_slice())
}

// The symbol `{prefix}{s}{suffix}`.
fn joined(inout builder: B, in prefix: Str, sym: u32, in suffix: Str) -> u32 {
    builder.joined(in prefix, sym, in suffix)
}

fn decimal_sym(inout builder: B, in prefix: Str, value: u64) -> u32 {
    builder.numbered(in prefix, value)
}

// `fresh(base)`: checks `base`, then the first of base, base'1, ... unused.
fn fresh(inout builder: B, inout gen: G, base: u32) -> u32 {
    builder.check(base, in "identifier");
    let mut candidate = base;
    let mut index: u64 = 1;
    loop {
        if !gen.is_used(candidate) {
            break;
        }
        let mut spelling: ChunkSeq[u8] = ChunkSeq::new[u8]();
        builder.names.write(base, inout spelling);
        put(inout spelling, in "'");
        put_dec(inout spelling, index);
        candidate = sym_of(inout builder, in spelling);
        index = inc(index);
    }
    gen.mark_used(candidate);
    candidate
}

fn fresh_fixed(inout builder: B, inout gen: G, in base: Str) -> u32 {
    let base_sym = builder.intern(in base);
    fresh(inout builder, inout gen, base_sym)
}

fn put_dec(inout out: ChunkSeq[u8], value: u64) {
    if value >= 10 {
        put_dec(inout out, value / 10);
    }
    out.push(wrapping_u8(wrapping_add(value % 10, 48)));
}

// `temp()`: `$t{counter}`.
fn temp(inout builder: B, inout gen: G) -> u32 {
    gen.counter = inc(gen.counter);
    let base = decimal_sym(inout builder, in "$t", gen.counter);
    fresh(inout builder, inout gen, base)
}

fn declare_as(inout gen: G, name: u32, ty: u32, lean: u32) -> u64 {
    let id = gen.next_binding;
    gen.next_binding = inc(gen.next_binding);
    gen.mark_used(lean);
    gen.scope.push(Local { name: name, id: id, ty: ty, depth: gen.layers.len() });
    gen.set_cur(id, lean);
    id
}

fn declare(inout builder: B, inout gen: G, name: u32, ty: u32) -> u32 {
    let lean = fresh(inout builder, inout gen, name);
    let id = declare_as(inout gen, name, ty, lean);
    lean
}

// `var(name)`: the current Lean local of source local `name`.
fn var(inout builder: B, in gen: G, name: u32) -> T {
    let index = gen.find(name);
    let entry = gen.local(index);
    lref(inout builder, gen.cur(entry.id))
}

// ----- handler layers ------------------------------------------------------------

const SYNC: Str = "$sync";

// `lift_action(action, depth)`: lifts through every layer from `depth` on.
fn lift_action(inout builder: B, in gen: G, action: T, depth: u64) -> T {
    let mut lifted = action;
    for i in depth..gen.layers.len() {
        let layer = gen.layer(i);
        let lift_fn = named(inout builder, in "liftAction");
        let mut args = empty();
        let state_arg = named_arg(inout builder, in "S", layer.state);
        args.push(state_arg);
        let output_arg = named_arg(inout builder, in "O", layer.output);
        args.push(output_arg);
        let action_arg = pos(inout builder, lifted);
        args.push(action_arg);
        lifted = app_args(inout builder, lift_fn, in args);
    }
    lifted
}

fn effectful_fn_type(in types: Types, ty: u32) -> bool {
    if ty == NONE32 {
        return false;
    }
    let node = types.node(ty);
    if node.kind != TyKind::Fn {
        return false;
    }
    let row = types.row(node.r2);
    row.n > 0 || row.tail != 0
}

// `adapt_callable(value, t, depth)`.
fn adapt_callable(
    inout builder: B,
    in types: Types,
    in gen: G,
    value: T,
    ty: u32,
    depth: u64
) -> T {
    if depth >= gen.layers.len() || !effectful_fn_type(in types, ty) {
        return value;
    }
    let param_count = w(types.node(ty).n);
    let mut names: ChunkSeq[u32] = ChunkSeq::new[u32]();
    if param_count == 0 {
        let unit_sym = builder.intern(in "$unit");
        names.push(unit_sym);
    } else {
        for i in 0..param_count {
            let arg_sym = builder.numbered(in "$arg", i);
            names.push(arg_sym);
        }
    }
    let mut refs = empty();
    for i in 0..names.len() {
        let arg_ref = lref(inout builder, sym_at(in names, i));
        refs.push(arg_ref);
    }
    let call = app(inout builder, value, in refs);
    let lifted = lift_action(inout builder, in gen, call, depth);
    inferred(inout builder, in names, lifted)
}

// `inferred(names, body)`: a lambda over `_`-typed binders.
pub fn inferred(inout builder: B, in names: ChunkSeq[u32], body: T) -> T {
    let mut binders = empty();
    for i in 0..names.len() {
        let hole = infer(inout builder);
        let binder = explicit(inout builder, sym_at(in names, i), hole);
        binders.push(binder);
    }
    lambda(inout builder, in binders, body)
}

fn inferred2(inout builder: B, in first: Str, in second: Str, body: T) -> T {
    let mut names: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let first_sym = builder.intern(in first);
    names.push(first_sym);
    let second_sym = builder.intern(in second);
    names.push(second_sym);
    inferred(inout builder, in names, body)
}

// `evidence(cap)`: the capability lifted through the layers above it.
fn evidence(inout builder: B, in gen: G, cap: Cap) -> T {
    let mut term = cap.term;
    let lift = builder.joined(in "lift_", cap.inst.name, in "");
    for i in cap.depth..gen.layers.len() {
        let layer = gen.layer(i);
        let lift_fn = sref(inout builder, lift);
        let mut args = empty();
        let state_arg = named_arg(inout builder, in "S", layer.state);
        args.push(state_arg);
        let output_arg = named_arg(inout builder, in "O", layer.output);
        args.push(output_arg);
        let monad_arg = named_arg(inout builder, in "m", layer.base);
        args.push(monad_arg);
        let term_arg = pos(inout builder, term);
        args.push(term_arg);
        term = app_args(inout builder, lift_fn, in args);
    }
    term
}

// `guard_abort(may_abort)`.
fn guard_abort(inout builder: B, in gen: G, may_abort: bool) {
    if may_abort && gen.has_clause_aliases() && gen.alias_written {
        builder.fail(
            in "Lean extraction cannot order a write to a borrowed operation argument before a potentially aborting effect inside its clause"
        );
    }
}

// `sync(out)`: reports each enclosing body layer's frame.
fn sync(inout builder: B, in gen: G, inout out: ChunkSeq[T]) {
    for k in gen.bl_start..gen.body_layers.len() {
        let index = gen.body_layers.try_get(k).unwrap_or(0);
        let layer = gen.layer(index);
        if layer.fz == 0 {
            continue;
        }
        let mut values = empty();
        for j in 0..layer.fz {
            let value_ref = lref(inout builder, gen.cur(gen.ix(add(layer.fa, j))));
            values.push(value_ref);
        }
        let cont_ref = named(inout builder, in "$k");
        let state_ref = named(inout builder, in "$s");
        let unit_value = unit(inout builder);
        let new_state = pair_get(inout builder, state_ref, 1);
        let values_tuple = tuple(inout builder, in values);
        let mut pair = empty();
        pair.push(new_state);
        pair.push(values_tuple);
        let result_pair = tuple(inout builder, in pair);
        let call = app2(inout builder, cont_ref, unit_value, result_pair);
        let lam = inferred2(inout builder, in "$k", in "$s", call);
        let unit_ty = global(inout builder, in "Unit");
        let child_ty = app1(inout builder, layer.child, unit_ty);
        let action = ascribe(inout builder, lam, child_ty);
        let lifted = lift_action(inout builder, in gen, action, inc(index));
        let wildcard = p_wild(inout builder);
        bind_pattern_stmt(inout builder, inout out, wildcard, lifted);
    }
}

// `sync_caller(out)`: reports this function's own `inout` values.
fn sync_caller(inout builder: B, in gen: G, inout out: ChunkSeq[T]) {
    if !gen.own_sync {
        return;
    }
    let mut values = empty();
    for j in 0..gen.own_sync_count {
        let id = gen.ix(add(gen.own_sync_start, j));
        if !gen.has_cur(id) {
            builder.fail(in "missing mutable parameter");
            return;
        }
        let value_ref = lref(inout builder, gen.cur(id));
        values.push(value_ref);
    }
    let sync_fn = named(inout builder, in SYNC);
    let values_tuple = tuple(inout builder, in values);
    let call = app1(inout builder, sync_fn, values_tuple);
    let lifted = lift_action(inout builder, in gen, call, 0);
    let wildcard = p_wild(inout builder);
    bind_pattern_stmt(inout builder, inout out, wildcard, lifted);
}

// `sync_abort(out)`: before a primitive failure point.
fn sync_abort(inout builder: B, in gen: G, inout out: ChunkSeq[T]) {
    sync(inout builder, in gen, inout out);
    sync_caller(inout builder, in gen, inout out);
    guard_abort(inout builder, in gen, true);
}

// `action_with(action, may_abort, out)`.
fn action_with(
    inout builder: B,
    inout gen: G,
    action: T,
    may_abort: bool,
    inout out: ChunkSeq[T]
) -> T {
    sync(inout builder, in gen, inout out);
    if may_abort {
        sync_caller(inout builder, in gen, inout out);
    }
    guard_abort(inout builder, in gen, may_abort);
    let tmp = temp(inout builder, inout gen);
    let none = unit(inout builder);
    bind_local(inout builder, inout out, tmp, action, false, none);
    lref(inout builder, tmp)
}

fn action(inout builder: B, inout gen: G, a: T, inout out: ChunkSeq[T]) -> T {
    action_with(inout builder, inout gen, a, true, inout out)
}

// `copy_binding(id, out)`: a fresh mutable copy of binding `id`.
fn copy_binding(inout builder: B, inout gen: G, id: u64, inout out: ChunkSeq[T]) -> u32 {
    let old = lref(inout builder, gen.cur(id));
    let mut base = NONE32;
    // the name whose visible entry is the binding (BTreeMap order: the
    // least such name, and ids are unique)
    for i in 0..gen.scope.len() {
        let entry = gen.local(i);
        if entry.id == id && gen.find(entry.name) == i {
            if base == NONE32 || name_less(in builder, entry.name, base) {
                base = entry.name;
            }
        }
    }
    if base == NONE32 {
        base = decimal_sym(inout builder, in "$b", id);
    }
    let new = fresh(inout builder, inout gen, base);
    let none = unit(inout builder);
    let_local(inout builder, inout out, new, old, false, none, true);
    gen.set_cur(id, new);
    new
}

// Whether symbol `a` sorts before `c` (bytewise, as `String` does).
fn name_less(in builder: B, a: u32, c: u32) -> bool {
    let a_len = builder.names.size(a);
    let c_len = builder.names.size(c);
    let mut i: u64 = 0;
    loop {
        if i >= a_len || i >= c_len {
            return a_len < c_len;
        }
        let a_byte = builder.names.byte(a, i);
        let c_byte = builder.names.byte(c, i);
        if a_byte != c_byte {
            return a_byte < c_byte;
        }
        i = inc(i);
    }
}

// ----- types ---------------------------------------------------------------------

fn is_named(in builder: B, in types: Types, ty: u32, in name: Str) -> bool {
    if ty == NONE32 {
        return false;
    }
    let node = types.node(ty);
    node.kind == TyKind::Named && spells(in builder, node.name, in name)
}

fn never(in builder: B, in types: Types, ty: u32) -> bool {
    is_named(in builder, in types, ty, in "Never")
}

// `IntegerKind::from_type`.
fn int_kind(in builder: B, in types: Types, ty: u32) -> u64 {
    if ty == NONE32 {
        return 0;
    }
    let node = types.node(ty);
    if node.kind == TyKind::Lit {
        if node.mode == 0 && wrapping_u64(node.lit) > 9223372036854775807 {
            return 64;
        }
        return add(64, SIGNED);
    }
    if node.kind != TyKind::Named {
        return 0;
    }
    let name = node.name;
    if spells(in builder, name, in "u8") {
        8
    } else if spells(in builder, name, in "u16") {
        16
    } else if spells(in builder, name, in "u32") {
        32
    } else if spells(in builder, name, in "u64") || spells(in builder, name, in "usize") {
        64
    } else if spells(in builder, name, in "u128") {
        128
    } else if spells(in builder, name, in "i8") {
        add(8, SIGNED)
    } else if spells(in builder, name, in "i16") {
        add(16, SIGNED)
    } else if spells(in builder, name, in "i32") {
        add(32, SIGNED)
    } else if spells(in builder, name, in "i64") || spells(in builder, name, in "isize") {
        add(64, SIGNED)
    } else if spells(in builder, name, in "i128") {
        add(128, SIGNED)
    } else {
        0
    }
}

fn kind_bits(kind: u64) -> u64 {
    kind & 255
}

fn kind_signed(kind: u64) -> bool {
    (kind & SIGNED) != 0
}

// `ty(t)?` (`ty_monad_with_fip` over the ambient monad): checks, then
// writes.
fn ty(inout builder: B, in types: Types, in ctx: Y, inout gen: G, ty: u32) -> T {
    let mark = builder.at();
    let mut name: u32 = 0;
    let error = ty_error_m(in builder, in types, ty, ctx.fip, true, inout name);
    if error != E_NONE {
        report(inout builder, error, name);
    }
    emit_ty_m(inout builder, in types, ty, ctx.fip, true, gen.monad);
    builder.since(mark)
}

// `ty_with_fip(t)?`: with no ambient monad.
fn ty_plain(inout builder: B, in types: Types, in ctx: Y, ty: u32) -> T {
    let mark = builder.at();
    ty_check(inout builder, in types, ty, ctx.fip);
    emit_ty(inout builder, in types, ty, ctx.fip);
    builder.since(mark)
}

// `ty(t).ok()`: whether it would succeed (then `emit_ty_m` writes it).
fn ty_ok(in builder: B, in types: Types, in ctx: Y, ty: u32) -> bool {
    let mut name: u32 = 0;
    ty_error_m(in builder, in types, ty, ctx.fip, true, inout name) == E_NONE
}

// `known_type`.
fn known_type(in types: Types, ty: u32) -> bool {
    let node = types.node(ty);
    if node.kind == TyKind::Infer {
        return false;
    }
    if node.kind == TyKind::Named || node.kind == TyKind::Tuple {
        for i in 0..w(node.n) {
            if !known_type(in types, types.arg(ty, i)) {
                return false;
            }
        }
        return true;
    }
    if node.kind == TyKind::Fn {
        for i in 0..w(node.n) {
            if !known_type(in types, types.arg(ty, i)) {
                return false;
            }
        }
        return known_type(in types, node.r);
    }
    true
}

// `Generator::field_type`, or NONE32.
fn field_type(inout types: Types, in builder: B, in ctx: Y, ty: u32, field: u32) -> u32 {
    if ty == NONE32 {
        return NONE32;
    }
    let node = types.node(ty);
    if node.kind == TyKind::Tuple {
        let index = parse_index(in builder, field);
        if index == NONE64 || index >= w(node.n) {
            return NONE32;
        }
        return types.arg(ty, index);
    }
    if node.kind != TyKind::Named {
        return NONE32;
    }
    let adt_index = ctx.env.world.lookup(node.name);
    if adt_index == NONE32 {
        return NONE32;
    }
    let adt = ctx.env.world.adt(adt_index);
    if adt.is_enum || adt.vn == 0 {
        return NONE32;
    }
    let variant = ctx.env.world.variant(w(adt.va));
    let field_index = ctx.env.world.find_field(variant, field);
    if field_index == NONE32 {
        return NONE32;
    }
    let vars = ctx.env.world.vars_of(in types, adt, ty);
    let field_ty = ctx.env.world.field(w(field_index)).ty;
    substitute(inout types, field_ty, in vars)
}

fn is_tuple(in types: Types, ty: u32) -> bool {
    ty != NONE32 && types.node(ty).kind == TyKind::Tuple
}

fn rec_struct(in ctx: Y, adt_index: u32) -> bool {
    ctx.env.recursive_structs.try_get(w(adt_index)).unwrap_or(false)
}

// `fip::box_inner`, or NONE32.
fn box_inner(in builder: B, in types: Types, in ctx: Y, ty: u32) -> u32 {
    if !ctx.fip || ty == NONE32 {
        return NONE32;
    }
    let node = types.node(ty);
    if node.kind == TyKind::Named && node.n == 1 && spells(in builder, node.name, in "Box") {
        types.arg(ty, 0)
    } else {
        NONE32
    }
}

// ----- fixed terms ---------------------------------------------------------------

// `fail_action(value)`.
fn fail_action(inout builder: B, value: T) -> T {
    let impossible = builder.intern(in "$impossible");
    let mark = builder.at();
    builder.w(1);
    builder.w(0);
    builder.w(2);
    builder.text(in "Effect_Fail");
    builder.text(in "raise");
    let op = builder.since(mark);
    let raise = app1(inout builder, op, value);
    let mut stmts = empty();
    let pattern = p_bind(inout builder, impossible);
    bind_pattern_stmt(inout builder, inout stmts, pattern, raise);
    let impossible_ref = lref(inout builder, impossible);
    let absurd = eliminate(inout builder, impossible_ref);
    sequence(inout builder, in stmts, absurd)
}

// A fixed unrooted two-component reference.
fn ref2(inout builder: B, in first: Str, in second: Str) -> T {
    let mark = builder.at();
    builder.w(1);
    builder.w(0);
    builder.w(2);
    builder.text(in first);
    builder.text(in second);
    builder.since(mark)
}

fn runtime_failure(inout builder: B, in variant: Str) -> T {
    let error_ref = ref2(inout builder, in "RuntimeError", in variant);
    fail_action(inout builder, error_ref)
}

fn overflow_action(inout builder: B) -> T {
    let error_ref = ref2(inout builder, in "ArithOverflow", in "mk");
    fail_action(inout builder, error_ref)
}

fn decide(inout builder: B, prop: T) -> T {
    gapp1(inout builder, in "Decidable", in "decide", prop)
}

fn nat_text(inout builder: B, in digits: Str) -> T {
    nat(inout builder, in digits)
}

fn negative(inout builder: B, in digits: Str) -> T {
    let magnitude = nat_text(inout builder, in digits);
    unary(inout builder, U_NEG, magnitude)
}

fn max_text(kind: u64) -> Str {
    let bits = kind_bits(kind);
    if kind_signed(kind) {
        if bits == 8 {
            "127"
        } else if bits == 16 {
            "32767"
        } else if bits == 32 {
            "2147483647"
        } else if bits == 64 {
            "9223372036854775807"
        } else {
            "170141183460469231731687303715884105727"
        }
    } else if bits == 8 {
        "255"
    } else if bits == 16 {
        "65535"
    } else if bits == 32 {
        "4294967295"
    } else if bits == 64 {
        "18446744073709551615"
    } else {
        "170141183460469231731687303715884105727"
    }
}

fn min_text(kind: u64) -> Str {
    let bits = kind_bits(kind);
    if bits == 8 {
        "128"
    } else if bits == 16 {
        "32768"
    } else if bits == 32 {
        "2147483648"
    } else if bits == 64 {
        "9223372036854775808"
    } else {
        "170141183460469231731687303715884105728"
    }
}

fn op_is(in builder: B, op: u32, in text: Str) -> bool {
    spells(in builder, op, in text)
}

// `in_range(op, kind, a, x)`; `ok` is false for None.
fn in_range(inout builder: B, op: u32, neg: bool, kind: u64, a: T, x: T, inout ok: bool) -> T {
    ok = true;
    if !kind_signed(kind) {
        if !neg && (op_is(in builder, op, in "+") || op_is(in builder, op, in "*")) {
            let a_nat = project_fixed(inout builder, a, in "toNat");
            let x_nat = project_fixed(inout builder, x, in "toNat");
            let nat_result = binary(
                inout builder,
                if op_is(in builder, op, in "+") {
                    OP_ADD
                } else {
                    OP_MUL
                },
                a_nat,
                x_nat
            );
            let max_value = nat_text(inout builder, in max_text(kind));
            let fits = binary(inout builder, OP_LE, nat_result, max_value);
            return decide(inout builder, fits);
        }
        if !neg && op_is(in builder, op, in "-") {
            let fits = binary(inout builder, OP_LE, x, a);
            return decide(inout builder, fits);
        }
        if neg {
            let zero = nat_u64(inout builder, 0);
            return binary(inout builder, OP_BOOL_EQ, a, zero);
        }
        ok = false;
        return a;
    }
    if !neg
        && (op_is(in builder, op, in "+")
            || op_is(in builder, op, in "-")
            || op_is(in builder, op, in "*"))
    {
        let min = negative(inout builder, in min_text(kind));
        let a_int = project_fixed(inout builder, a, in "toInt");
        let x_int = project_fixed(inout builder, x, in "toInt");
        let code = if op_is(in builder, op, in "+") {
            OP_ADD
        } else if op_is(in builder, op, in "-") {
            OP_SUB
        } else {
            OP_MUL
        };
        let exact = binary(inout builder, code, a_int, x_int);
        if kind_bits(kind) == 64 {
            let check_sym = builder.intern(in "inI64");
            let check_fn = sref(inout builder, check_sym);
            return app1(inout builder, check_fn, exact);
        }
        let lo = binary(inout builder, OP_LE, min, exact);
        let max_value = nat_text(inout builder, in max_text(kind));
        let hi = binary(inout builder, OP_LE, exact, max_value);
        let both = binary(inout builder, OP_AND, lo, hi);
        return decide(inout builder, both);
    }
    if !neg && op_is(in builder, op, in "/") {
        let min = negative(inout builder, in min_text(kind));
        let one = negative(inout builder, in "1");
        let a_is_min = binary(inout builder, OP_BOOL_EQ, a, min);
        let x_is_minus_one = binary(inout builder, OP_BOOL_EQ, x, one);
        let both = binary(inout builder, OP_BOOL_AND, a_is_min, x_is_minus_one);
        return unary(inout builder, U_BOOL_NOT, both);
    }
    if neg {
        let min = negative(inout builder, in min_text(kind));
        return binary(inout builder, OP_BOOL_NE, a, min);
    }
    ok = false;
    a
}

// `arith_term(op, kind, a, x)`.
fn arith_term(inout builder: B, op: u32, kind: u64, a: T, x: T) -> T {
    let code = if op_is(in builder, op, in "+") {
        OP_ADD
    } else if op_is(in builder, op, in "-") {
        OP_SUB
    } else if op_is(in builder, op, in "*") {
        OP_MUL
    } else if op_is(in builder, op, in "/") {
        OP_DIV
    } else if op_is(in builder, op, in "%") {
        OP_MOD
    } else if op_is(in builder, op, in "==") {
        OP_BOOL_EQ
    } else if op_is(in builder, op, in "!=") {
        OP_BOOL_NE
    } else if op_is(in builder, op, in "<") {
        OP_LT
    } else if op_is(in builder, op, in "<=") {
        OP_LE
    } else if op_is(in builder, op, in ">") {
        OP_GT
    } else if op_is(in builder, op, in ">=") {
        OP_GE
    } else if op_is(in builder, op, in "&&") {
        OP_BOOL_AND
    } else if op_is(in builder, op, in "||") {
        OP_BOOL_OR
    } else {
        NONE64
    };
    if code == NONE64 {
        let mut message: ChunkSeq[u8] = ChunkSeq::new[u8]();
        put(inout message, in "unsupported Lean binary operator \"");
        builder.names.write(op, inout message);
        put(inout message, in "\"");
        match String::from_utf8(in message.as_slice()) {
            Option::Some(text) => builder.fail(in text.as_str()),
            Option::None => builder.fail(in "unsupported Lean binary operator"),
        }
        return a;
    }
    if code == OP_MOD && kind != 0 && kind_signed(kind) {
        let one = negative(inout builder, in "1");
        let is_minus_one = binary(inout builder, OP_BOOL_EQ, x, one);
        let zero = nat_u64(inout builder, 0);
        let remainder = binary(inout builder, code, a, x);
        return ite(inout builder, is_minus_one, zero, remainder);
    }
    binary(inout builder, code, a, x)
}

// The first byte of operator symbol `op` (`&op[..1]`).
fn op_head(inout builder: B, op: u32) -> u32 {
    let mut bytes: ChunkSeq[u8] = ChunkSeq::new[u8]();
    if builder.names.size(op) > 0 {
        bytes.push(builder.names.byte(op, 0));
    }
    sym_of(inout builder, in bytes)
}

// ----- literals ------------------------------------------------------------------

fn nat_u128_t(inout builder: B, hi: u64, lo: u64) -> T {
    let mut digits: ChunkSeq[u8] = ChunkSeq::new[u8]();
    put_u128(inout digits, hi, lo);
    let digits_sym = builder.names.intern(in digits.as_slice());
    let mark = builder.at();
    builder.w(4);
    builder.sym(digits_sym);
    builder.since(mark)
}

// `typed_literal(l, ty)` (`literal` when ty is NONE32) of the literal
// words (kind, lo, hi).
fn literal(inout builder: B, in types: Types, kind: u64, lo: u64, hi: u64, sym: u32, ty: u32) -> T {
    if kind == L_INT {
        if wrapping_shr_u64(hi, 63) != 0 {
            let neg_lo = wrapping_add(lo ^ 18446744073709551615, 1);
            let mut neg_hi = hi ^ 18446744073709551615;
            if neg_lo == 0 {
                neg_hi = wrapping_add(neg_hi, 1);
            }
            let magnitude = nat_u128_t(inout builder, neg_hi, neg_lo);
            return unary(inout builder, U_NEG, magnitude);
        }
        return nat_u128_t(inout builder, hi, lo);
    }
    if kind == L_WIDE {
        return nat_u128_t(inout builder, hi, lo);
    }
    if kind == L_FLOAT {
        if ty != NONE32 && is_named(in builder, in types, ty, in "f32") {
            let bits = nat_u64(inout builder, f32_bits(lo));
            return gapp1(inout builder, in "Float32", in "ofBits", bits);
        }
        let bits = nat_u64(inout builder, lo);
        return gapp1(inout builder, in "Float", in "ofBits", bits);
    }
    let mark = builder.at();
    if kind == L_BOOL {
        builder.w(T_BOOL);
        builder.w(lo);
    } else {
        builder.w(T_STRING);
        builder.sym(sym);
    }
    builder.since(mark)
}

// ----- constructors --------------------------------------------------------------

// `Generator::constructor_name(n)` as an encoded name.
fn constructor_name(inout builder: B, in ctx: Y, name: u32) -> T {
    if spells(in builder, name, in "Ok") {
        return rooted2(inout builder, in "Except", in "ok");
    }
    if spells(in builder, name, in "Err") {
        return rooted2(inout builder, in "Except", in "error");
    }
    if spells(in builder, name, in "Some") || spells(in builder, name, in "Option::Some") {
        return rooted2(inout builder, in "Option", in "some");
    }
    if spells(in builder, name, in "None") || spells(in builder, name, in "Option::None") {
        return rooted2(inout builder, in "Option", in "none");
    }
    let ctor = lookup_constructor(inout builder, in ctx.env.world, name);
    let mark = builder.at();
    if ctor == NONE64 {
        builder.fail(in "unknown Lean constructor");
        builder.w(0);
        builder.w(0);
        return builder.since(mark);
    }
    let adt = adt_of(in ctx.env.world, ctor);
    let variant = variant_of(in ctx.env.world, ctor);
    builder.check(adt.name, in "identifier");
    if adt.is_enum {
        builder.check(variant.name, in "identifier");
    }
    builder.w(0);
    builder.w(2);
    builder.sym(adt.name);
    if adt.is_enum {
        builder.sym(variant.name);
    } else {
        builder.text(in "mk");
    }
    builder.since(mark)
}

fn constructor(inout builder: B, in ctx: Y, ctor_sym: u32) -> T {
    let name = constructor_name(inout builder, in ctx, ctor_sym);
    let mark = builder.at();
    builder.w(1);
    builder.put(name);
    builder.since(mark)
}

// ----- places --------------------------------------------------------------------

// `Place::from_expr(expr_id)`: the root symbol (NONE32 when `expr_id` is not a place)
// and the path in `path`.
fn place_of(in ctx: Y, expr_id: u64, inout path: ChunkSeq[u32]) -> u32 {
    let kind = ctx.ast.kind(expr_id);
    if kind == X_NAME {
        return ctx.ast.xs(expr_id, 0);
    }
    if kind == X_FIELD {
        let root = place_of(in ctx, ctx.ast.x(expr_id, 0), inout path);
        if root == NONE32 {
            return NONE32;
        }
        path.push(ctx.ast.xs(expr_id, 1));
        return root;
    }
    NONE32
}

fn sym_at(in syms: ChunkSeq[u32], i: u64) -> u32 {
    u32_at(in syms, i)
}

// `get_path(base, ty, path[from..])`.
fn get_path(
    inout builder: B,
    inout types: Types,
    in ctx: Y,
    base: T,
    ty: u32,
    in path: ChunkSeq[u32],
    from: u64
) -> T {
    let mut term = base;
    let mut current = ty;
    for i in from..path.len() {
        let field_sym = sym_at(in path, i);
        let index = parse_index(in builder, field_sym);
        if is_tuple(in types, current) && index != NONE64 {
            term = tuple_get(inout builder, term, index, types.arity(current));
        } else {
            term = project(inout builder, term, field_sym);
        }
        current = field_type(inout types, in builder, in ctx, current, field_sym);
    }
    term
}

fn get_field(
    inout builder: B,
    inout types: Types,
    in ctx: Y,
    base: T,
    ty: u32,
    field_sym: u32
) -> T {
    let mut path: ChunkSeq[u32] = ChunkSeq::new[u32]();
    path.push(field_sym);
    get_path(inout builder, inout types, in ctx, base, ty, in path, 0)
}

// `set_path(base, ty, path[from..], value)`.
fn set_path(
    inout builder: B,
    inout types: Types,
    in ctx: Y,
    base: T,
    ty: u32,
    in path: ChunkSeq[u32],
    from: u64,
    value: T
) -> T {
    if from >= path.len() {
        return value;
    }
    let field_sym = sym_at(in path, from);
    let mut inner_ty = field_type(inout types, in builder, in ctx, ty, field_sym);
    if inner_ty == NONE32 {
        inner_ty = ctx.infer;
    }
    let inner = get_field(inout builder, inout types, in ctx, base, ty, field_sym);
    let updated = set_path(
        inout builder,
        inout types,
        in ctx,
        inner,
        inner_ty,
        in path,
        inc(from),
        value
    );
    let index = parse_index(in builder, field_sym);
    if is_tuple(in types, ty) && index != NONE64 {
        let arity = types.arity(ty);
        let mut parts = empty();
        for j in 0..arity {
            if j == index {
                parts.push(updated);
            } else {
                let element = tuple_get(inout builder, base, j, arity);
                parts.push(element);
            }
        }
        return tuple(inout builder, in parts);
    }
    if ty != NONE32 && types.node(ty).kind == TyKind::Named {
        let adt_index = ctx.env.world.lookup(types.node(ty).name);
        if adt_index != NONE32 && rec_struct(in ctx, adt_index) {
            let adt = ctx.env.world.adt(adt_index);
            let ctor = constructor(inout builder, in ctx, adt.name);
            let variant = ctx.env.world.variant(w(adt.va));
            let mut fields = empty();
            for i in 0..w(variant.fc) {
                let field_def = ctx.env.world.field(add(w(variant.fa), i));
                if field_def.name == field_sym {
                    fields.push(updated);
                } else {
                    let projected = project(inout builder, base, field_def.name);
                    fields.push(projected);
                }
            }
            return app(inout builder, ctor, in fields);
        }
    }
    let mut updates = empty();
    let update_field = record_field(inout builder, field_sym, updated);
    updates.push(update_field);
    update(inout builder, base, in updates)
}

// `assign(place, value, out)`.
fn assign(
    inout builder: B,
    inout types: Types,
    in ctx: Y,
    inout gen: G,
    root: u32,
    in path: ChunkSeq[u32],
    value: T,
    inout out: ChunkSeq[T]
) {
    let index = gen.find(root);
    if index == NONE64 {
        builder.fail(in "assignment to an unknown Lean local");
        return;
    }
    let entry = gen.local(index);
    if gen.is_clause_alias(entry.id) {
        gen.alias_written = true;
    }
    let lean = gen.cur(entry.id);
    let current_ref = lref(inout builder, lean);
    let updated = set_path(
        inout builder,
        inout types,
        in ctx,
        current_ref,
        entry.ty,
        in path,
        0,
        value
    );
    push_assign(inout builder, inout out, lean, updated);
}

// `place_term(place)`.
fn place_term(
    inout builder: B,
    inout types: Types,
    in ctx: Y,
    in gen: G,
    root: u32,
    in path: ChunkSeq[u32]
) -> T {
    let index = gen.find(root);
    if index == NONE64 {
        builder.fail(in "unknown Lean place");
        return unit(inout builder);
    }
    let entry = gen.local(index);
    let root_ref = lref(inout builder, gen.cur(entry.id));
    get_path(inout builder, inout types, in ctx, root_ref, entry.ty, in path, 0)
}

// ----- patterns ------------------------------------------------------------------

pub copy struct Rename {
    name: u32,
    tmp: u32,
}

fn rename_of(in renames: ChunkSeq[Rename], name: u32) -> u32 {
    let mut i = renames.len();
    loop {
        if i == 0 {
            return NONE32;
        }
        i = wrapping_sub(i, 1);
        match renames.try_get(i) {
            Option::Some(entry) => {
                if entry.name == name {
                    return entry.tmp;
                }
            },
            Option::None => {},
        }
    }
}

pub copy struct NameTy {
    name: u32,
    ty: u32,
}

// `pattern_types(p, ty, out)`.
fn pattern_types(
    inout types: Types,
    inout builder: B,
    in ctx: Y,
    pat_id: u64,
    ty: u32,
    inout out: ChunkSeq[NameTy]
) {
    if ctx.ast.is_box(pat_id) {
        let mut inner = box_inner(in builder, in types, in ctx, ty);
        if inner == NONE32 {
            inner = ty;
        }
        let n = ctx.ast.px(pat_id, 2);
        for i in 0..n {
            let sub = ctx.ast.px(pat_id, add(4, wrapping_mul(i, 2)));
            pattern_types(inout types, inout builder, in ctx, sub, inner, inout out);
        }
        return;
    }
    let kind = ctx.ast.pkind(pat_id);
    if kind == PK_BIND {
        out.push(NameTy { name: ctx.ast.pxs(pat_id, 0), ty: ty });
    } else if kind == PK_TUPLE {
        if is_tuple(in types, ty) {
            let n = ctx.ast.px(pat_id, 0);
            let arity = types.arity(ty);
            for i in 0..n {
                if i >= arity {
                    break;
                }
                pattern_types(
                    inout types,
                    inout builder,
                    in ctx,
                    ctx.ast.px(pat_id, inc(i)),
                    types.arg(ty, i),
                    inout out
                );
            }
        }
    } else if kind == PK_CTOR {
        let ctor = lookup_constructor(inout builder, in ctx.env.world, ctx.ast.pxs(pat_id, 0));
        if ctor != NONE64 {
            let adt = adt_of(in ctx.env.world, ctor);
            let variant = variant_of(in ctx.env.world, ctor);
            let mut vars = vars_new();
            if ty != NONE32 && types.node(ty).kind == TyKind::Named {
                vars = ctx.env.world.vars_of(in types, adt, ty);
            }
            let n = ctx.ast.px(pat_id, 2);
            for i in 0..n {
                let fname = ctx.ast.sym(ctx.ast.px(pat_id, add(3, wrapping_mul(i, 2))));
                let sub = ctx.ast.px(pat_id, add(4, wrapping_mul(i, 2)));
                let field_index = ctx.env.world.find_field(variant, fname);
                if field_index != NONE32 {
                    let field_ty = substitute(
                        inout types,
                        ctx.env.world.field(w(field_index)).ty,
                        in vars
                    );
                    pattern_types(inout types, inout builder, in ctx, sub, field_ty, inout out);
                }
            }
        }
    }
}

// `pat(p, renames)`.
fn pat(
    inout builder: B,
    in types: Types,
    in ctx: Y,
    inout gen: G,
    pat_id: u64,
    inout renames: ChunkSeq[Rename]
) -> T {
    if ctx.ast.is_box(pat_id) {
        return pat(
            inout builder,
            in types,
            in ctx,
            inout gen,
            ctx.ast.px(pat_id, 4),
            inout renames
        );
    }
    let kind = ctx.ast.pkind(pat_id);
    if kind == PK_WILD {
        return p_wild(inout builder);
    }
    if kind == PK_BIND {
        let bind_name = ctx.ast.pxs(pat_id, 0);
        let base = joined(inout builder, in "", bind_name, in "$p");
        let tmp = fresh(inout builder, inout gen, base);
        renames.push(Rename { name: bind_name, tmp: tmp });
        return p_bind(inout builder, tmp);
    }
    if kind == PK_LITERAL {
        let lit_kind = ctx.ast.px(pat_id, 0);
        let lo = ctx.ast.px(pat_id, 1);
        let hi = ctx.ast.px(pat_id, 2);
        let mark = builder.at();
        if lit_kind == L_INT {
            builder.w(P_INT);
            builder.w(lo);
            builder.w(hi);
        } else if lit_kind == L_BOOL {
            builder.w(P_BOOL);
            builder.w(lo);
        } else if lit_kind == L_FLOAT {
            builder.fail(in "Lean extraction does not support floating-point literal patterns");
            builder.w(0);
        } else if lit_kind == L_WIDE {
            builder.fail(in "Lean extraction does not support 128-bit literal patterns");
            builder.w(0);
        } else {
            builder.w(P_STRING);
            builder.sym(ctx.ast.sym(lo));
        }
        return builder.since(mark);
    }
    if kind == PK_TUPLE {
        let n = ctx.ast.px(pat_id, 0);
        let mut sub_pats = empty();
        for i in 0..n {
            let sub_pat = pat(
                inout builder,
                in types,
                in ctx,
                inout gen,
                ctx.ast.px(pat_id, inc(i)),
                inout renames
            );
            sub_pats.push(sub_pat);
        }
        return p_tuple(inout builder, in sub_pats);
    }
    // constructor: name, named, n, (field, id)...
    let name = ctx.ast.pxs(pat_id, 0);
    let named_pat = ctx.ast.px(pat_id, 1) != 0;
    let n = ctx.ast.px(pat_id, 2);
    if named_pat {
        let ctor = lookup_constructor(inout builder, in ctx.env.world, name);
        if ctor != NONE64 {
            let adt = adt_of(in ctx.env.world, ctor);
            let adt_index = n32(wrapping_shr_u64(ctor, 32));
            if adt.is_enum || rec_struct(in ctx, adt_index) {
                let variant = variant_of(in ctx.env.world, ctor);
                let mut args = empty();
                for j in 0..w(variant.fc) {
                    let fname = ctx.env.world.field(add(w(variant.fa), j)).name;
                    let mut found = NONE64;
                    for i in 0..n {
                        if found == NONE64
                            && ctx.ast.sym(ctx.ast.px(pat_id, add(3, wrapping_mul(i, 2)))) == fname
                        {
                            found = ctx.ast.px(pat_id, add(4, wrapping_mul(i, 2)));
                        }
                    }
                    if found == NONE64 {
                        let wcard = p_wild(inout builder);
                        args.push(wcard);
                    } else {
                        let sub_pat = pat(
                            inout builder,
                            in types,
                            in ctx,
                            inout gen,
                            found,
                            inout renames
                        );
                        args.push(sub_pat);
                    }
                }
                let ctor_name = constructor_name(inout builder, in ctx, name);
                return p_ctor(inout builder, ctor_name, in args);
            }
        }
        let mut field_pats = empty();
        for i in 0..n {
            let fname = ctx.ast.sym(ctx.ast.px(pat_id, add(3, wrapping_mul(i, 2))));
            // The field name is checked before the sub-pattern, as in Rust;
            // the sub-pattern may leave intermediate words, so both parts
            // are copied into one range.
            let mark = builder.at();
            builder.ident(fname);
            let label = builder.since(mark);
            let sub_pat = pat(
                inout builder,
                in types,
                in ctx,
                inout gen,
                ctx.ast.px(pat_id, add(4, wrapping_mul(i, 2))),
                inout renames
            );
            let pair_mark = builder.at();
            builder.put(label);
            builder.put(sub_pat);
            field_pats.push(builder.since(pair_mark));
        }
        let mark = builder.at();
        builder.w(P_RECORD);
        builder.w(field_pats.len());
        for i in 0..field_pats.len() {
            builder.put(get(in field_pats, i));
        }
        return builder.since(mark);
    }
    let ctor_name = constructor_name(inout builder, in ctx, name);
    let mut args = empty();
    for i in 0..n {
        let sub_pat = pat(
            inout builder,
            in types,
            in ctx,
            inout gen,
            ctx.ast.px(pat_id, add(4, wrapping_mul(i, 2))),
            inout renames
        );
        args.push(sub_pat);
    }
    p_ctor(inout builder, ctor_name, in args)
}

// `declare_renamed(p, ty, renames, out)`.
fn declare_renamed(
    inout builder: B,
    inout types: Types,
    in ctx: Y,
    inout gen: G,
    pat_id: u64,
    ty: u32,
    in renames: ChunkSeq[Rename],
    inout out: ChunkSeq[T]
) {
    let mut name_tys: ChunkSeq[NameTy] = ChunkSeq::new[NameTy]();
    pattern_types(inout types, inout builder, in ctx, pat_id, ty, inout name_tys);
    for i in 0..name_tys.len() {
        match name_tys.try_get(i) {
            Option::Some(entry) => {
                let tmp = rename_of(in renames, entry.name);
                if tmp != NONE32 {
                    let lean = declare(inout builder, inout gen, entry.name, entry.ty);
                    let tmp_ref = lref(inout builder, tmp);
                    let none = unit(inout builder);
                    let_local(inout builder, inout out, lean, tmp_ref, false, none, true);
                }
            },
            Option::None => {},
        }
    }
}

// `bind_pattern(p, ty, value, out)`.
fn bind_pattern(
    inout builder: B,
    inout types: Types,
    in ctx: Y,
    inout gen: G,
    pat_id: u64,
    ty: u32,
    value: T,
    inout out: ChunkSeq[T]
) {
    if ctx.ast.pkind(pat_id) == PK_BIND && !ctx.ast.is_box(pat_id) {
        let lean = declare(inout builder, inout gen, ctx.ast.pxs(pat_id, 0), ty);
        if known_type(in types, ty) && ty_ok(in builder, in types, in ctx, ty) {
            let mark = builder.at();
            emit_ty_m(inout builder, in types, ty, ctx.fip, true, gen.monad);
            let ty_term = builder.since(mark);
            let_local(inout builder, inout out, lean, value, true, ty_term, true);
        } else {
            let none = unit(inout builder);
            let_local(inout builder, inout out, lean, value, false, none, true);
        }
        return;
    }
    let mut renames: ChunkSeq[Rename] = ChunkSeq::new[Rename]();
    let pattern = pat(inout builder, in types, in ctx, inout gen, pat_id, inout renames);
    let_pattern(inout builder, inout out, pattern, value);
    declare_renamed(
        inout builder,
        inout types,
        in ctx,
        inout gen,
        pat_id,
        ty,
        in renames,
        inout out
    );
}

// ----- expressions ---------------------------------------------------------------

fn type_of(in ctx: Y, expr_id: u64) -> u32 {
    ctx.ast.ty(expr_id)
}

fn partial(in ctx: Y, expr_id: u64) -> bool {
    ctx.env.world.is_partial(ctx.ast.start(expr_id), ctx.ast.end(expr_id))
}

fn overflow(in ctx: Y, expr_id: u64) -> bool {
    ctx.env.world.may_overflow(ctx.ast.start(expr_id), ctx.ast.end(expr_id))
}

// `expr(expr_id, out)`.
fn expr(
    inout builder: B,
    inout types: Types,
    in ctx: Y,
    inout gen: G,
    expr_id: u64,
    inout out: ChunkSeq[T]
) -> T {
    let term = expr_inner(inout builder, inout types, in ctx, inout gen, expr_id, inout out);
    if never(in builder, in types, type_of(in ctx, expr_id)) {
        return gapp1(inout builder, in "Empty", in "elim", term);
    }
    term
}

// `operands(es, out)`.
fn operands(
    inout builder: B,
    inout types: Types,
    in ctx: Y,
    inout gen: G,
    in exprs: ChunkSeq[u64],
    inout out: ChunkSeq[T]
) -> ChunkSeq[T] {
    let mut buffers: ChunkSeq[ChunkSeq[T]] = ChunkSeq::new[ChunkSeq[T]]();
    let mut terms = empty();
    let mut lits: ChunkSeq[bool] = ChunkSeq::new[bool]();
    for i in 0..exprs.len() {
        let expr_id = exprs.try_get(i).unwrap_or(0);
        let mut buffer = empty();
        let term = expr(inout builder, inout types, in ctx, inout gen, expr_id, inout buffer);
        buffers.push(buffer);
        terms.push(term);
        lits.push(ctx.ast.kind(expr_id) == X_LITERAL);
    }
    let mut result = empty();
    for i in 0..exprs.len() {
        let mut later = false;
        for j in inc(i)..exprs.len() {
            match buffers.try_get(j) {
                Option::Some(later_buffer) => {
                    if later_buffer.len() > 0 {
                        later = true;
                    }
                },
                Option::None => {},
            }
        }
        match buffers.try_get(i) {
            Option::Some(own_buffer) => extend(inout out, in own_buffer),
            Option::None => {},
        }
        let lit = lits.try_get(i).unwrap_or(false);
        let term = get(in terms, i);
        if later && !lit {
            let tmp = temp(inout builder, inout gen);
            let none = unit(inout builder);
            let_local(inout builder, inout out, tmp, term, false, none, false);
            let tmp_ref = lref(inout builder, tmp);
            result.push(tmp_ref);
        } else {
            result.push(term);
        }
    }
    result
}

fn one(expr_id: u64) -> ChunkSeq[u64] {
    let mut ids: ChunkSeq[u64] = ChunkSeq::new[u64]();
    ids.push(expr_id);
    ids
}

fn two(first: u64, second: u64) -> ChunkSeq[u64] {
    let mut ids: ChunkSeq[u64] = ChunkSeq::new[u64]();
    ids.push(first);
    ids.push(second);
    ids
}

// `seq(expr_id)`: the expression as a `do` block in its own scope.
fn seq(inout builder: B, inout types: Types, in ctx: Y, inout gen: G, expr_id: u64) -> T {
    let scope_len = gen.scope.len();
    let current_len = gen.current.len();
    let mut out = empty();
    let term = expr(inout builder, inout types, in ctx, inout gen, expr_id, inout out);
    gen.scope.truncate(scope_len);
    gen.current.truncate(current_len);
    let result = pure(inout builder, term);
    sequence(inout builder, in out, result)
}

fn bool_ty(inout builder: B) -> T {
    global(inout builder, in "Bool")
}

// `failure_checks(op, kind, key, left, right)`.
fn failure_checks(
    inout builder: B,
    in ctx: Y,
    expr_id: u64,
    op: u32,
    kind: u64,
    left: T,
    right: T,
    inout out: ChunkSeq[T]
) {
    if (op_is(in builder, op, in "/") || op_is(in builder, op, in "%"))
        && partial(in ctx, expr_id)
    {
        let zero = nat_u64(inout builder, 0);
        let cond = binary(inout builder, OP_BOOL_EQ, right, zero);
        let failure = runtime_failure(inout builder, in "DivisionByZero");
        let mut yes = empty();
        let stmt = expr_stmt(inout builder, failure);
        yes.push(stmt);
        let check = if_stmt(inout builder, cond, in yes);
        out.push(check);
    }
    if overflow(in ctx, expr_id) && kind != 0 {
        let mut ok = false;
        let fits = in_range(inout builder, op, false, kind, left, right, inout ok);
        if ok {
            let cond = unary(inout builder, U_BOOL_NOT, fits);
            let failure = overflow_action(inout builder);
            let mut yes = empty();
            let stmt = expr_stmt(inout builder, failure);
            yes.push(stmt);
            let check = if_stmt(inout builder, cond, in yes);
            out.push(check);
        }
    }
}

// The checked arithmetic action of `op` over `a` and `x` (the binary,
// compound-assignment and failure paths share it).
fn checked(
    inout builder: B,
    in ctx: Y,
    inout gen: G,
    expr_id: u64,
    op: u32,
    kind: u64,
    a: T,
    x: T,
    inout out: ChunkSeq[T]
) -> T {
    sync_abort(inout builder, in gen, inout out);
    let tmp = temp(inout builder, inout gen);
    let left = fresh_fixed(inout builder, inout gen, in "$left");
    let right = fresh_fixed(inout builder, inout gen, in "$right");
    let mut stmts = empty();
    let none = unit(inout builder);
    let_local(inout builder, inout stmts, left, a, false, none, false);
    let_local(inout builder, inout stmts, right, x, false, none, false);
    let left_ref = lref(inout builder, left);
    let right_ref = lref(inout builder, right);
    failure_checks(inout builder, in ctx, expr_id, op, kind, left_ref, right_ref, inout stmts);
    let result = arith_term(inout builder, op, kind, left_ref, right_ref);
    let pure_result = pure(inout builder, result);
    let action = sequence(inout builder, in stmts, pure_result);
    bind_local(inout builder, inout out, tmp, action, false, none);
    lref(inout builder, tmp)
}

fn expr_inner(
    inout builder: B,
    inout types: Types,
    in ctx: Y,
    inout gen: G,
    expr_id: u64,
    inout out: ChunkSeq[T]
) -> T {
    let kind = ctx.ast.kind(expr_id);
    if kind == X_LITERAL {
        let lit_ty = type_of(in ctx, expr_id);
        let term = literal(
            inout builder,
            in types,
            ctx.ast.x(expr_id, 0),
            ctx.ast.x(expr_id, 1),
            ctx.ast.x(expr_id, 2),
            ctx.ast.xs(expr_id, 1),
            lit_ty
        );
        if lit_ty != NONE32 {
            let ty_term = ty(inout builder, in types, in ctx, inout gen, lit_ty);
            return ascribe(inout builder, term, ty_term);
        }
        return term;
    }
    if kind == X_NAME {
        return name_expr(inout builder, inout types, in ctx, inout gen, ctx.ast.xs(expr_id, 0));
    }
    if kind == X_TUPLE {
        let n = ctx.ast.x(expr_id, 0);
        let mut elems: ChunkSeq[u64] = ChunkSeq::new[u64]();
        for i in 0..n {
            elems.push(ctx.ast.x(expr_id, inc(i)));
        }
        let values = operands(inout builder, inout types, in ctx, inout gen, in elems, inout out);
        return tuple(inout builder, in values);
    }
    if kind == X_STRUCT {
        return struct_expr(inout builder, inout types, in ctx, inout gen, expr_id, inout out);
    }
    if kind == X_FIELD {
        let base = ctx.ast.x(expr_id, 0);
        let field_sym = ctx.ast.xs(expr_id, 1);
        let base_ty = type_of(in ctx, base);
        let base_value = expr(inout builder, inout types, in ctx, inout gen, base, inout out);
        if base_ty != NONE32 {
            return get_field(inout builder, inout types, in ctx, base_value, base_ty, field_sym);
        }
        return project(inout builder, base_value, field_sym);
    }
    if kind == X_UNARY {
        return unary_expr(inout builder, inout types, in ctx, inout gen, expr_id, inout out);
    }
    if kind == X_BINARY {
        return binary_expr(inout builder, inout types, in ctx, inout gen, expr_id, inout out);
    }
    if kind == X_ASSIGN {
        assign_expr(inout builder, inout types, in ctx, inout gen, expr_id, inout out);
        return unit(inout builder);
    }
    if kind == X_BLOCK {
        return block_expr(inout builder, inout types, in ctx, inout gen, expr_id, inout out);
    }
    if kind == X_IF {
        let cond = expr(
            inout builder,
            inout types,
            in ctx,
            inout gen,
            ctx.ast.x(expr_id, 0),
            inout out
        );
        let yes = seq(inout builder, inout types, in ctx, inout gen, ctx.ast.x(expr_id, 1));
        let else_id = ctx.ast.x(expr_id, 2);
        let mut no = T { a: 0, n: 0 };
        if else_id == NONE {
            let unit_value = unit(inout builder);
            no = pure(inout builder, unit_value);
        } else {
            no = seq(inout builder, inout types, in ctx, inout gen, else_id);
        }
        let tmp = temp(inout builder, inout gen);
        let if_ty = type_of(in ctx, expr_id);
        let mut annotation = T { a: 0, n: 0 };
        if if_ty != NONE32 {
            annotation = ty(inout builder, in types, in ctx, inout gen, if_ty);
        }
        let if_term = ite(inout builder, cond, yes, no);
        bind_local(inout builder, inout out, tmp, if_term, if_ty != NONE32, annotation);
        return lref(inout builder, tmp);
    }
    if kind == X_MATCH {
        return match_expr(inout builder, inout types, in ctx, inout gen, expr_id, inout out);
    }
    if kind == X_CALL {
        let n = ctx.ast.x(expr_id, 1);
        let mut args: ChunkSeq[u64] = ChunkSeq::new[u64]();
        for i in 0..n {
            args.push(ctx.ast.x(expr_id, add(3, wrapping_mul(i, 2))));
        }
        return call(
            inout builder,
            inout types,
            in ctx,
            inout gen,
            expr_id,
            ctx.ast.x(expr_id, 0),
            NONE32,
            in args,
            inout out
        );
    }
    if kind == X_LOOP {
        builder.fail(in LOOP_REFUSAL);
        return unit(inout builder);
    }
    if kind == X_CLOSURE {
        return closure(inout builder, inout types, in ctx, inout gen, expr_id, inout out);
    }
    if kind == X_HANDLE {
        return handler(inout builder, inout types, in ctx, inout gen, expr_id, inout out);
    }
    if kind == X_TRY {
        let value = expr(
            inout builder,
            inout types,
            in ctx,
            inout gen,
            ctx.ast.x(expr_id, 0),
            inout out
        );
        sync_abort(inout builder, in gen, inout out);
        let tmp = temp(inout builder, inout gen);
        let value_sym = builder.intern(in "$value");
        let error_sym = builder.intern(in "$error");
        let mut arms = empty();
        let ok_name = rooted2(inout builder, in "Except", in "ok");
        let mut ok_pats = empty();
        let value_bind = p_bind(inout builder, value_sym);
        ok_pats.push(value_bind);
        let ok_pat = p_ctor(inout builder, ok_name, in ok_pats);
        let value_ref = named(inout builder, in "$value");
        let ok_body = pure(inout builder, value_ref);
        let ok_arm = arm(inout builder, ok_pat, ok_body);
        arms.push(ok_arm);
        let error_name = rooted2(inout builder, in "Except", in "error");
        let mut error_pats = empty();
        let error_bind = p_bind(inout builder, error_sym);
        error_pats.push(error_bind);
        let error_pat = p_ctor(inout builder, error_name, in error_pats);
        let error_ref = named(inout builder, in "$error");
        let error_body = fail_action(inout builder, error_ref);
        let error_arm = arm(inout builder, error_pat, error_body);
        arms.push(error_arm);
        let action = match_term(inout builder, value, in arms);
        let none = unit(inout builder);
        bind_local(inout builder, inout out, tmp, action, false, none);
        return lref(inout builder, tmp);
    }
    if kind == X_INDEX {
        return index_expr(inout builder, inout types, in ctx, inout gen, expr_id, inout out);
    }
    skip(inout builder, inout gen);
    unit(inout builder)
}

fn name_expr(inout builder: B, inout types: Types, in ctx: Y, inout gen: G, name: u32) -> T {
    let resumption = gen.cont(name);
    if resumption.key != NONE32 {
        if resumption.fallback == NONE32 {
            builder.fail(
                in "Lean extraction cannot pass this continuation as a value: its frame or borrowed arguments must be threaded by a direct resumption"
            );
            return unit(inout builder);
        }
        return lref(inout builder, resumption.fallback);
    }
    if lookup_constructor(inout builder, in ctx.env.world, name) != NONE64 {
        return constructor(inout builder, in ctx, name);
    }
    let local_pos = gen.find(name);
    if local_pos != NONE64 {
        let entry = gen.local(local_pos);
        let current_ref = lref(inout builder, gen.cur(entry.id));
        return adapt_callable(inout builder, in types, in gen, current_ref, entry.ty, entry.depth);
    }
    if gen.in_family(name) {
        let func_index = ctx.ast.fn_index(name);
        let sig = ctx.env.fns.sig(w(ctx.env.fns.find(name)));
        let mut labeled = false;
        if func_index != NONE {
            let reqs = requirements(in types, in ctx, func_index);
            for index in 0..reqs.len() {
                if types.effect_at(u64_at(in reqs, index)).label != 0 {
                    labeled = true;
                }
            }
        }
        if func_index == NONE
            || !fn_effectful(in types, in ctx, func_index)
            || sig.gn != 0
            || gen.monad_id
            || labeled
        {
            fail_with_name(
                inout builder,
                in "a fuel companion cannot pass the recursive function '",
                name,
                in "' as a value unless it is effectful, non-generic, unlabeled and in a monadic context"
            );
            return unit(inout builder);
        }
        let fuel_value = named(inout builder, in FUEL);
        let fuel_arg = named_arg(inout builder, in FUEL, fuel_value);
        let mut fargs = empty();
        fargs.push(fuel_arg);
        let fuel_fn = fuel_ref(inout builder, name);
        let value = app_args(inout builder, fuel_fn, in fargs);
        if sig.param_count == 0 {
            let unit_ty = global(inout builder, in "Unit");
            let unit_sym = builder.intern(in "$unit");
            let binder = explicit(inout builder, unit_sym, unit_ty);
            let mut binders = empty();
            binders.push(binder);
            return lambda(inout builder, in binders, value);
        }
        return value;
    }
    let sig_index = ctx.env.fns.find(name);
    if sig_index != NONE32 && ctx.env.fns.sig(w(sig_index)).param_count == 0 {
        let unit_ty = global(inout builder, in "Unit");
        let binder = anonymous(inout builder, B_EXPLICIT, unit_ty);
        let mut binders = empty();
        binders.push(binder);
        let fn_ref = sref(inout builder, name);
        return lambda(inout builder, in binders, fn_ref);
    }
    sref(inout builder, name)
}

fn struct_expr(
    inout builder: B,
    inout types: Types,
    in ctx: Y,
    inout gen: G,
    expr_id: u64,
    inout out: ChunkSeq[T]
) -> T {
    let struct_name = ctx.ast.xs(expr_id, 0);
    let field_count = ctx.ast.x(expr_id, 1);
    let mut field_exprs: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for i in 0..field_count {
        field_exprs.push(ctx.ast.x(expr_id, add(3, wrapping_mul(i, 2))));
    }
    let values = operands(inout builder, inout types, in ctx, inout gen, in field_exprs, inout out);
    let ctor_id = lookup_constructor(inout builder, in ctx.env.world, struct_name);
    if ctor_id != NONE64 {
        let adt = adt_of(in ctx.env.world, ctor_id);
        let adt_index = n32(wrapping_shr_u64(ctor_id, 32));
        if adt.is_enum || rec_struct(in ctx, adt_index) {
            let variant = variant_of(in ctx.env.world, ctor_id);
            let mut args = empty();
            for j in 0..w(variant.fc) {
                let fname = ctx.env.world.field(add(w(variant.fa), j)).name;
                let mut found = NONE64;
                for i in 0..field_count {
                    if found == NONE64
                        && ctx.ast.sym(ctx.ast.x(expr_id, add(2, wrapping_mul(i, 2)))) == fname
                    {
                        found = i;
                    }
                }
                if found == NONE64 {
                    let mut message: ChunkSeq[u8] = ChunkSeq::new[u8]();
                    put(inout message, in "missing field '");
                    builder.names.write(fname, inout message);
                    put(inout message, in "' in ");
                    builder.names.write(struct_name, inout message);
                    match String::from_utf8(in message.as_slice()) {
                        Option::Some(text) => builder.fail(in text.as_str()),
                        Option::None => builder.fail(in "missing field"),
                    }
                    return unit(inout builder);
                }
                args.push(get(in values, found));
            }
            let ctor = constructor(inout builder, in ctx, struct_name);
            return app(inout builder, ctor, in args);
        }
    }
    let mut field_terms = empty();
    for i in 0..field_count {
        let fname = ctx.ast.sym(ctx.ast.x(expr_id, add(2, wrapping_mul(i, 2))));
        let field_term = record_field(inout builder, fname, get(in values, i));
        field_terms.push(field_term);
    }
    let record_term = record(inout builder, in field_terms);
    let struct_ref = sref(inout builder, struct_name);
    ascribe(inout builder, record_term, struct_ref)
}

fn unary_expr(
    inout builder: B,
    inout types: Types,
    in ctx: Y,
    inout gen: G,
    expr_id: u64,
    inout out: ChunkSeq[T]
) -> T {
    let op = ctx.ast.xs(expr_id, 0);
    let operand_id = ctx.ast.x(expr_id, 1);
    let value = expr(inout builder, inout types, in ctx, inout gen, operand_id, inout out);
    let kind = int_kind(in builder, in types, type_of(in ctx, operand_id));
    if op_is(in builder, op, in "-") && overflow(in ctx, expr_id) && kind != 0 {
        sync_abort(inout builder, in gen, inout out);
        let tmp = temp(inout builder, inout gen);
        let operand = fresh_fixed(inout builder, inout gen, in "$operand");
        let operand_ref = lref(inout builder, operand);
        let unit_value = unit(inout builder);
        let mut has_check = false;
        let fits = in_range(
            inout builder,
            op,
            true,
            kind,
            operand_ref,
            unit_value,
            inout has_check
        );
        let mut stmts = empty();
        let none = unit(inout builder);
        let_local(inout builder, inout stmts, operand, value, false, none, false);
        let negated = unary(inout builder, U_NEG, operand_ref);
        let yes = pure(inout builder, negated);
        let no = overflow_action(inout builder);
        let checked_term = ite(inout builder, fits, yes, no);
        let action = sequence(inout builder, in stmts, checked_term);
        bind_local(inout builder, inout out, tmp, action, false, none);
        return lref(inout builder, tmp);
    }
    if op_is(in builder, op, in "-") {
        return unary(inout builder, U_NEG, value);
    }
    if op_is(in builder, op, in "!") {
        return unary(inout builder, U_BOOL_NOT, value);
    }
    let mut message: ChunkSeq[u8] = ChunkSeq::new[u8]();
    put(inout message, in "unsupported Lean unary operator ");
    builder.names.write(op, inout message);
    match String::from_utf8(in message.as_slice()) {
        Option::Some(text) => builder.fail(in text.as_str()),
        Option::None => builder.fail(in "unsupported Lean unary operator"),
    }
    value
}

fn binary_expr(
    inout builder: B,
    inout types: Types,
    in ctx: Y,
    inout gen: G,
    expr_id: u64,
    inout out: ChunkSeq[T]
) -> T {
    let op = ctx.ast.xs(expr_id, 0);
    let left_id = ctx.ast.x(expr_id, 1);
    let right_id = ctx.ast.x(expr_id, 2);
    if op_is(in builder, op, in "&&") || op_is(in builder, op, in "||") {
        let left = expr(inout builder, inout types, in ctx, inout gen, left_id, inout out);
        let mut rhs_stmts = empty();
        let scope_len = gen.scope.len();
        let current_len = gen.current.len();
        let right = expr(inout builder, inout types, in ctx, inout gen, right_id, inout rhs_stmts);
        gen.scope.truncate(scope_len);
        gen.current.truncate(current_len);
        let is_and = op_is(in builder, op, in "&&");
        if rhs_stmts.len() == 0 {
            return binary(
                inout builder,
                if is_and { OP_BOOL_AND } else { OP_BOOL_OR },
                left,
                right
            );
        }
        let tmp = temp(inout builder, inout gen);
        let pure_right = pure(inout builder, right);
        let right_action = sequence(inout builder, in rhs_stmts, pure_right);
        let mark = builder.at();
        builder.w(T_BOOL);
        builder.w(if is_and { 0 } else { 1 });
        let short_value = builder.since(mark);
        let other = pure(inout builder, short_value);
        let if_term = if is_and {
            ite(inout builder, left, right_action, other)
        } else {
            ite(inout builder, left, other, right_action)
        };
        let result_ty = bool_ty(inout builder);
        bind_local(inout builder, inout out, tmp, if_term, true, result_ty);
        return lref(inout builder, tmp);
    }
    let kind = int_kind(in builder, in types, type_of(in ctx, left_id));
    let values = operands(
        inout builder,
        inout types,
        in ctx,
        inout gen,
        in two(left_id, right_id),
        inout out
    );
    let left_value = get(in values, 0);
    let right_value = get(in values, 1);
    if partial(in ctx, expr_id) || overflow(in ctx, expr_id) {
        return checked(
            inout builder,
            in ctx,
            inout gen,
            expr_id,
            op,
            kind,
            left_value,
            right_value,
            inout out
        );
    }
    let cmp = if op_is(in builder, op, in "<") {
        OP_LT
    } else if op_is(in builder, op, in "<=") {
        OP_LE
    } else if op_is(in builder, op, in ">") {
        OP_GT
    } else if op_is(in builder, op, in ">=") {
        OP_GE
    } else {
        NONE64
    };
    if cmp != NONE64 {
        let comparison = binary(inout builder, cmp, left_value, right_value);
        return decide(inout builder, comparison);
    }
    arith_term(inout builder, op, kind, left_value, right_value)
}

fn assign_expr(
    inout builder: B,
    inout types: Types,
    in ctx: Y,
    inout gen: G,
    expr_id: u64,
    inout out: ChunkSeq[T]
) {
    let op = ctx.ast.xs(expr_id, 0);
    let place_id = ctx.ast.x(expr_id, 1);
    let value_id = ctx.ast.x(expr_id, 2);
    let value = expr(inout builder, inout types, in ctx, inout gen, value_id, inout out);
    let mut path: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let root = place_of(in ctx, place_id, inout path);
    if root == NONE32 {
        builder.fail(in "assignment requires a place");
        return;
    }
    let mut new = value;
    if !op_is(in builder, op, in "=") {
        let old = place_term(inout builder, inout types, in ctx, in gen, root, in path);
        let kind = int_kind(in builder, in types, type_of(in ctx, place_id));
        let head = op_head(inout builder, op);
        if partial(in ctx, expr_id) || overflow(in ctx, expr_id) {
            new = checked(
                inout builder,
                in ctx,
                inout gen,
                expr_id,
                head,
                kind,
                old,
                value,
                inout out
            );
        } else {
            new = arith_term(inout builder, head, kind, old, value);
        }
    }
    assign(inout builder, inout types, in ctx, inout gen, root, in path, new, inout out);
}

fn block_expr(
    inout builder: B,
    inout types: Types,
    in ctx: Y,
    inout gen: G,
    expr_id: u64,
    inout out: ChunkSeq[T]
) -> T {
    let scope_len = gen.scope.len();
    let stmt_count = ctx.ast.x(expr_id, 0);
    let mut at: u64 = 1;
    let mut diverged = false;
    let mut result = T { a: 0, n: 0 };
    for i in 0..stmt_count {
        let kind = ctx.ast.x(expr_id, at);
        if kind == 0 {
            let stmt_expr = ctx.ast.x(expr_id, inc(at));
            at = add(at, 2);
            if never(in builder, in types, type_of(in ctx, stmt_expr)) {
                result = expr(inout builder, inout types, in ctx, inout gen, stmt_expr, inout out);
                diverged = true;
                break;
            }
            expr(inout builder, inout types, in ctx, inout gen, stmt_expr, inout out);
        } else {
            let pat_id = ctx.ast.x(expr_id, inc(at));
            let declared = ctx.ast.xt(expr_id, add(at, 2));
            let fallback = ctx.ast.xt(expr_id, add(at, 3));
            let init_id = ctx.ast.x(expr_id, add(at, 4));
            at = add(at, 5);
            if never(in builder, in types, type_of(in ctx, init_id)) {
                result = expr(inout builder, inout types, in ctx, inout gen, init_id, inout out);
                diverged = true;
                break;
            }
            let init_value = expr(
                inout builder,
                inout types,
                in ctx,
                inout gen,
                init_id,
                inout out
            );
            let mut inferred = declared;
            if declared == NONE32 {
                inferred = type_of(in ctx, init_id);
                if inferred == NONE32 {
                    if fallback != NONE32 {
                        inferred = fallback;
                    } else if ctx.ast.kind(init_id) == X_NAME && gen.has(ctx.ast.xs(init_id, 0)) {
                        inferred = gen.local(gen.find(ctx.ast.xs(init_id, 0))).ty;
                    } else {
                        inferred = ctx.infer;
                    }
                }
            }
            bind_pattern(
                inout builder,
                inout types,
                in ctx,
                inout gen,
                pat_id,
                inferred,
                init_value,
                inout out
            );
        }
    }
    if !diverged {
        // the tail follows the statements
        let tail = ctx.ast.x(expr_id, at);
        if tail != NONE {
            result = expr(inout builder, inout types, in ctx, inout gen, tail, inout out);
        } else {
            result = unit(inout builder);
        }
    }
    gen.scope.truncate(scope_len);
    result
}

fn match_expr(
    inout builder: B,
    inout types: Types,
    in ctx: Y,
    inout gen: G,
    expr_id: u64,
    inout out: ChunkSeq[T]
) -> T {
    let value = ctx.ast.x(expr_id, 0);
    let mut scrutinee_ty = type_of(in ctx, value);
    if scrutinee_ty == NONE32 {
        scrutinee_ty = ctx.infer;
    }
    let scrutinee = expr(inout builder, inout types, in ctx, inout gen, value, inout out);
    let tmp = temp(inout builder, inout gen);
    let match_ty = type_of(in ctx, expr_id);
    let mut annotation = T { a: 0, n: 0 };
    if match_ty != NONE32 {
        annotation = ty(inout builder, in types, in ctx, inout gen, match_ty);
    }
    let n = ctx.ast.x(expr_id, 1);
    let mut arms = empty();
    for i in 0..n {
        let pat_id = ctx.ast.x(expr_id, add(2, wrapping_mul(i, 2)));
        let body = ctx.ast.x(expr_id, add(3, wrapping_mul(i, 2)));
        let scope_len = gen.scope.len();
        let current_len = gen.current.len();
        let mut renames: ChunkSeq[Rename] = ChunkSeq::new[Rename]();
        let pattern = pat(inout builder, in types, in ctx, inout gen, pat_id, inout renames);
        let mut stmts = empty();
        declare_renamed(
            inout builder,
            inout types,
            in ctx,
            inout gen,
            pat_id,
            scrutinee_ty,
            in renames,
            inout stmts
        );
        let result = expr(inout builder, inout types, in ctx, inout gen, body, inout stmts);
        let pure_result = pure(inout builder, result);
        let arm_body = sequence(inout builder, in stmts, pure_result);
        let match_arm = arm(inout builder, pattern, arm_body);
        arms.push(match_arm);
        gen.scope.truncate(scope_len);
        gen.current.truncate(current_len);
    }
    let match_value = match_term(inout builder, scrutinee, in arms);
    bind_local(inout builder, inout out, tmp, match_value, match_ty != NONE32, annotation);
    lref(inout builder, tmp)
}

fn index_expr(
    inout builder: B,
    inout types: Types,
    in ctx: Y,
    inout gen: G,
    expr_id: u64,
    inout out: ChunkSeq[T]
) -> T {
    let base = ctx.ast.x(expr_id, 0);
    let index = ctx.ast.x(expr_id, 1);
    let route = ctx.ast.x(expr_id, 2);
    if route == 4 {
        let message_sym = ctx.ast.xs(expr_id, 3);
        let mut message: ChunkSeq[u8] = ChunkSeq::new[u8]();
        builder.names.write(message_sym, inout message);
        match String::from_utf8(in message.as_slice()) {
            Option::Some(text) => builder.fail(in text.as_str()),
            Option::None => builder.fail(in "refused"),
        }
        return unit(inout builder);
    }
    if route == 1 {
        let mut exprs: ChunkSeq[u64] = two(base, index);
        return seq_op(inout builder, inout types, in ctx, inout gen, Q_GET, in exprs, inout out);
    }
    if route == 3 {
        let mut exprs: ChunkSeq[u64] = ChunkSeq::new[u64]();
        exprs.push(base);
        exprs.push(ctx.ast.x(index, 1));
        exprs.push(ctx.ast.x(index, 2));
        return seq_op(
            inout builder,
            inout types,
            in ctx,
            inout gen,
            Q_SUB_SLICE,
            in exprs,
            inout out
        );
    }
    let base_ty = type_of(in ctx, base);
    if !is_tuple(in types, base_ty) {
        builder.fail(in "Lean indexing requires a typed tuple");
        return unit(inout builder);
    }
    let n = types.arity(base_ty);
    if n == 0 {
        builder.fail(in "cannot extract indexing of an empty tuple");
        return unit(inout builder);
    }
    let values = operands(
        inout builder,
        inout types,
        in ctx,
        inout gen,
        in two(base, index),
        inout out
    );
    if builder.failed {
        // The first error is the output; the selection chain is quadratic
        // in the arity, so do not build it.
        return unit(inout builder);
    }
    let tuple_s = fresh_fixed(inout builder, inout gen, in "$tuple");
    let position = fresh_fixed(inout builder, inout gen, in "$index");
    let tuple_ref = lref(inout builder, tuple_s);
    let index_ref = lref(inout builder, position);
    let mut body = T { a: 0, n: 0 };
    if partial(in ctx, expr_id) {
        body = runtime_failure(inout builder, in "IndexOutOfBounds");
    } else {
        let last = tuple_get(inout builder, tuple_ref, wrapping_sub(n, 1), n);
        body = pure(inout builder, last);
    }
    let mut i = n;
    loop {
        if i == 0 {
            break;
        }
        i = wrapping_sub(i, 1);
        let index_nat = nat_u64(inout builder, i);
        let cond = binary(inout builder, OP_BOOL_EQ, index_ref, index_nat);
        let element = tuple_get(inout builder, tuple_ref, i, n);
        let yes = pure(inout builder, element);
        body = ite(inout builder, cond, yes, body);
    }
    sync_abort(inout builder, in gen, inout out);
    let tmp = temp(inout builder, inout gen);
    let mut stmts = empty();
    let none = unit(inout builder);
    let_local(inout builder, inout stmts, tuple_s, get(in values, 0), false, none, false);
    let_local(inout builder, inout stmts, position, get(in values, 1), false, none, false);
    let sequenced = sequence(inout builder, in stmts, body);
    bind_local(inout builder, inout out, tmp, sequenced, false, none);
    lref(inout builder, tmp)
}

// ----- sequences -----------------------------------------------------------------

fn to_nat(inout builder: B, x: T) -> T {
    project_fixed(inout builder, x, in "toNat")
}

fn size(inout builder: B, array: T) -> T {
    gapp1(inout builder, in "Array", in "size", array)
}

fn in_bounds(inout builder: B, array: T, index: T) -> T {
    let index_nat = to_nat(inout builder, index);
    let seq_size = size(inout builder, array);
    let less = binary(inout builder, OP_LT, index_nat, seq_size);
    decide(inout builder, less)
}

fn seq_checked(inout builder: B, inout gen: G, ok: T, value: T, inout out: ChunkSeq[T]) -> T {
    sync(inout builder, in gen, inout out);
    guard_abort(inout builder, in gen, true);
    let tmp = temp(inout builder, inout gen);
    let cond = unary(inout builder, U_BOOL_NOT, ok);
    let failure = runtime_failure(inout builder, in "IndexOutOfBounds");
    let mut yes = empty();
    let stmt = expr_stmt(inout builder, failure);
    yes.push(stmt);
    let check = if_stmt(inout builder, cond, in yes);
    let mut stmts = empty();
    stmts.push(check);
    let pure_value = pure(inout builder, value);
    let action = sequence(inout builder, in stmts, pure_value);
    let none = unit(inout builder);
    bind_local(inout builder, inout out, tmp, action, false, none);
    lref(inout builder, tmp)
}

fn seq_update(
    inout builder: B,
    inout types: Types,
    in ctx: Y,
    inout gen: G,
    recv: u64,
    value: T,
    inout out: ChunkSeq[T]
) {
    let mut path: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let root = place_of(in ctx, recv, inout path);
    if root == NONE32 {
        builder.fail(in "a mutable Lean ChunkSeq receiver requires a place");
        return;
    }
    assign(inout builder, inout types, in ctx, inout gen, root, in path, value, inout out);
}

fn empty_array(inout builder: B) -> T {
    let zero = nat_u64(inout builder, 0);
    gapp1(inout builder, in "Array", in "emptyWithCapacity", zero)
}

// `seq_op(op, es, out)` after its refusals (the encoder's route).
fn seq_op(
    inout builder: B,
    inout types: Types,
    in ctx: Y,
    inout gen: G,
    op: u64,
    in es: ChunkSeq[u64],
    inout out: ChunkSeq[T]
) -> T {
    let terms = operands(inout builder, inout types, in ctx, inout gen, in es, inout out);
    let recv_id = es.try_get(0).unwrap_or(0);
    let a0 = get(in terms, 0);
    let a1 = get(in terms, 1);
    let a2 = get(in terms, 2);
    if op == Q_NEW {
        return empty_array(inout builder);
    }
    if op == Q_WITH_CAPACITY {
        let capacity = to_nat(inout builder, a0);
        return gapp1(inout builder, in "Array", in "emptyWithCapacity", capacity);
    }
    if op == Q_LEN {
        let length = size(inout builder, a0);
        return gapp1(inout builder, in "Nat", in "toUInt64", length);
    }
    if op == Q_PUSH {
        let new_seq = gapp2(inout builder, in "Array", in "push", a0, a1);
        seq_update(inout builder, inout types, in ctx, inout gen, recv_id, new_seq, inout out);
        return unit(inout builder);
    }
    if op == Q_POP {
        let tmp = temp(inout builder, inout gen);
        let back = gapp1(inout builder, in "Array", in "back?", a0);
        let none = unit(inout builder);
        let_local(inout builder, inout out, tmp, back, false, none, false);
        let new_seq = gapp1(inout builder, in "Array", in "pop", a0);
        seq_update(inout builder, inout types, in ctx, inout gen, recv_id, new_seq, inout out);
        return lref(inout builder, tmp);
    }
    if op == Q_GET {
        let index_nat = to_nat(inout builder, a1);
        let value = gapp2(inout builder, in "GetElem?", in "getElem!", a0, index_nat);
        let ok = in_bounds(inout builder, a0, a1);
        return seq_checked(inout builder, inout gen, ok, value, inout out);
    }
    if op == Q_SET {
        let index_nat = to_nat(inout builder, a1);
        let value = gapp3(inout builder, in "Array", in "setIfInBounds", a0, index_nat, a2);
        let ok = in_bounds(inout builder, a0, a1);
        let updated = seq_checked(inout builder, inout gen, ok, value, inout out);
        seq_update(inout builder, inout types, in ctx, inout gen, recv_id, updated, inout out);
        return unit(inout builder);
    }
    if op == Q_TRY_GET {
        let index_nat = to_nat(inout builder, a1);
        return gapp2(inout builder, in "GetElem?", in "getElem?", a0, index_nat);
    }
    if op == Q_LAST {
        return gapp1(inout builder, in "Array", in "back?", a0);
    }
    if op == Q_TRY_SET {
        let tmp = temp(inout builder, inout gen);
        let ok = in_bounds(inout builder, a0, a1);
        let none = unit(inout builder);
        let_local(inout builder, inout out, tmp, ok, false, none, false);
        let index_nat = to_nat(inout builder, a1);
        let value = gapp3(inout builder, in "Array", in "setIfInBounds", a0, index_nat, a2);
        seq_update(inout builder, inout types, in ctx, inout gen, recv_id, value, inout out);
        return lref(inout builder, tmp);
    }
    if op == Q_CLEAR {
        let value = empty_array(inout builder);
        seq_update(inout builder, inout types, in ctx, inout gen, recv_id, value, inout out);
        return unit(inout builder);
    }
    if op == Q_TRUNCATE {
        let zero = nat_u64(inout builder, 0);
        let new_len = to_nat(inout builder, a1);
        let value = gapp3(inout builder, in "Array", in "extract", a0, zero, new_len);
        seq_update(inout builder, inout types, in ctx, inout gen, recv_id, value, inout out);
        return unit(inout builder);
    }
    if op == Q_RESERVE {
        return unit(inout builder);
    }
    if op == Q_EXTEND {
        let value = gapp2(inout builder, in "Array", in "append", a0, a1);
        seq_update(inout builder, inout types, in ctx, inout gen, recv_id, value, inout out);
        return unit(inout builder);
    }
    if op == Q_FINISH {
        let length = size(inout builder, a0);
        let zero = nat_u64(inout builder, 0);
        let is_empty = binary(inout builder, OP_BOOL_EQ, length, zero);
        let unit_value = unit(inout builder);
        return seq_checked(inout builder, inout gen, is_empty, unit_value, inout out);
    }
    if op == Q_AS_SLICE {
        return a0;
    }
    // Q_SUB_SLICE
    let lo = to_nat(inout builder, a1);
    let hi = to_nat(inout builder, a2);
    gapp3(inout builder, in "Array", in "extract", a0, lo, hi)
}

// ----- calls ---------------------------------------------------------------------

fn fail_sym(inout builder: B, message_sym: u32) {
    let mut message: ChunkSeq[u8] = ChunkSeq::new[u8]();
    builder.names.write(message_sym, inout message);
    match String::from_utf8(in message.as_slice()) {
        Option::Some(text) => builder.fail(in text.as_str()),
        Option::None => builder.fail(in "refused"),
    }
}

fn fail_with_name(inout builder: B, in prefix: Str, name: u32, in suffix: Str) {
    let mut message: ChunkSeq[u8] = ChunkSeq::new[u8]();
    put(inout message, in prefix);
    builder.names.write(name, inout message);
    put(inout message, in suffix);
    match String::from_utf8(in message.as_slice()) {
        Option::Some(text) => builder.fail(in text.as_str()),
        Option::None => builder.fail(in prefix),
    }
}

// Whether world function `name` has an `inout` Slice parameter.
fn inout_slice(in builder: B, in types: Types, in ctx: Y, name: u32) -> bool {
    let sig_index = ctx.env.fns.find(name);
    if sig_index == NONE32 {
        return false;
    }
    let sig = ctx.env.fns.sig(w(sig_index));
    for i in 0..sig.param_count {
        let param = ctx.env.fns.param(sig, i);
        if widen_u64(param.pass) == TyPass::Inout {
            let param_node = types.node(param.ty);
            if param_node.kind == TyKind::Named
                && param_node.n == 1
                && spells(in builder, param_node.name, in "Slice")
            {
                return true;
            }
        }
    }
    false
}

fn starts_with(in builder: B, sym: u32, in prefix: Str) -> bool {
    let prefix_bytes = prefix.as_bytes();
    if builder.names.size(sym) < prefix_bytes.len() {
        return false;
    }
    for i in 0..prefix_bytes.len() {
        let expected = prefix_bytes.try_get(i).unwrap_or(0);
        if builder.names.byte(sym, i) != expected {
            return false;
        }
    }
    true
}

// The effect of `eff::op` when `eff` is an effect of the world.
fn effect_call(inout builder: B, in ctx: Y, name: u32) -> bool {
    let size = builder.names.size(name);
    let mut i: u64 = 0;
    loop {
        if inc(i) >= size {
            return false;
        }
        if builder.names.byte(name, i) == 58 && builder.names.byte(name, inc(i)) == 58 {
            break;
        }
        i = inc(i);
    }
    let mut prefix: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for j in 0..i {
        prefix.push(builder.names.byte(name, j));
    }
    let prefix_sym = builder.names.lookup(in prefix.as_slice());
    prefix_sym != NONE32 && ctx.env.world.effect_index(prefix_sym) != NONE32
}

// The tiled operation's term (`tiled_op_term`); `mutates` reports a write.
fn tiled_term(
    inout builder: B,
    op: u64,
    extra: u64,
    in terms: ChunkSeq[T],
    inout mutates: bool
) -> T {
    let a0 = get(in terms, 0);
    let a1 = get(in terms, 1);
    let a2 = get(in terms, 2);
    mutates = false;
    if op == TO_NEW {
        return empty_array(inout builder);
    }
    if op == TO_WITH_CAPACITY || op == TO_WITH_REGION {
        let capacity = to_nat(inout builder, a0);
        return gapp1(inout builder, in "Array", in "emptyWithCapacity", capacity);
    }
    if op == TO_LEN {
        let length = size(inout builder, a0);
        return gapp1(inout builder, in "Nat", in "toUInt64", length);
    }
    if op == TO_TILE_COUNT {
        let length = size(inout builder, a0);
        let width_minus_one = nat_u64(inout builder, wrapping_sub(extra, 1));
        let numerator = binary(inout builder, OP_ADD, length, width_minus_one);
        let width = nat_u64(inout builder, extra);
        let tiles = binary(inout builder, OP_DIV, numerator, width);
        return gapp1(inout builder, in "Nat", in "toUInt64", tiles);
    }
    if op == TO_GET {
        let index_nat = to_nat(inout builder, a1);
        return gapp2(inout builder, in "GetElem?", in "getElem!", a0, index_nat);
    }
    if op == TO_COL_GET {
        let index_nat = to_nat(inout builder, a1);
        let row = gapp2(inout builder, in "GetElem?", in "getElem!", a0, index_nat);
        return project(inout builder, row, n32(extra));
    }
    if op == TO_PUSH {
        mutates = true;
        return gapp2(inout builder, in "Array", in "push", a0, a1);
    }
    if op == TO_SET {
        mutates = true;
        let index_nat = to_nat(inout builder, a1);
        return gapp3(inout builder, in "Array", in "setIfInBounds", a0, index_nat, a2);
    }
    if op == TO_COL_SET {
        mutates = true;
        let idx = to_nat(inout builder, a1);
        let current_row = gapp2(inout builder, in "GetElem?", in "getElem!", a0, idx);
        let mut updates = empty();
        let update_field = record_field(inout builder, n32(extra), a2);
        updates.push(update_field);
        let updated = update(inout builder, current_row, in updates);
        return gapp3(inout builder, in "Array", in "setIfInBounds", a0, idx, updated);
    }
    builder.fail(in "Lean extraction does not lower SIMD load_tile_vec");
    unit(inout builder)
}

// Words of the call row of `expr_id`: callee 0, n 1, (pass, id)..., m, types...,
// then 10 route words.
fn route_at(in ctx: Y, expr_id: u64) -> u64 {
    let arg_count = ctx.ast.x(expr_id, 1);
    let type_count_at = add(2, wrapping_mul(arg_count, 2));
    let type_count = ctx.ast.x(expr_id, type_count_at);
    add(inc(type_count_at), type_count)
}

// `call(expr_id, callee, args, out)`. `rewritten` is the method name symbol
// when the callee is the rewritten `Type::method` of a method call, else
// NONE32 (the callee expression is then `callee`).
fn call(
    inout builder: B,
    inout types: Types,
    in ctx: Y,
    inout gen: G,
    expr_id: u64,
    callee: u64,
    rewritten: u32,
    in args: ChunkSeq[u64],
    inout out: ChunkSeq[T]
) -> T {
    let route = route_at(in ctx, expr_id);
    let callee_kind = if rewritten != NONE32 {
        X_NAME
    } else {
        ctx.ast.kind(callee)
    };
    let callee_name = if rewritten != NONE32 {
        rewritten
    } else if callee_kind == X_NAME {
        ctx.ast.xs(callee, 0)
    } else {
        NONE32
    };
    if callee_kind == X_NAME && inout_slice(in builder, in types, in ctx, callee_name) {
        builder.fail(in INOUT_SLICE);
        return unit(inout builder);
    }
    // seq_expr: the call's route (Name callees only when not a local).
    let seq_kind = ctx.ast.x(expr_id, route);
    let seq_code = ctx.ast.x(expr_id, inc(route));
    let seq_applies = seq_kind != 0
        && (ctx.ast.kind(callee) != X_NAME || !gen.has(ctx.ast.xs(callee, 0)));
    if seq_applies {
        if seq_kind == 2 {
            fail_sym(inout builder, ctx.ast.sym(seq_code));
            return unit(inout builder);
        }
        let mut exprs: ChunkSeq[u64] = ChunkSeq::new[u64]();
        if ctx.ast.kind(callee) == X_FIELD {
            exprs.push(ctx.ast.x(callee, 0));
        }
        let arg_count = ctx.ast.x(expr_id, 1);
        for i in 0..arg_count {
            exprs.push(ctx.ast.x(expr_id, add(3, wrapping_mul(i, 2))));
        }
        return seq_op(inout builder, inout types, in ctx, inout gen, seq_code, in exprs, inout out);
    }
    // tiled
    if rewritten != NONE32 {
        if starts_with(in builder, rewritten, in "TiledSeq::") {
            skip(inout builder, inout gen);
            return unit(inout builder);
        }
    } else {
        let tiled_op = ctx.ast.x(expr_id, add(route, 2));
        let tiled_applies = tiled_op != 0 && (callee_kind != X_NAME || !gen.has(callee_name));
        if tiled_applies {
            // Column operations carry a name-table index; tile widths a number.
            let raw = ctx.ast.x(expr_id, add(route, 3));
            let extra = if tiled_op == TO_COL_GET || tiled_op == TO_COL_SET {
                widen_u64(ctx.ast.sym(raw))
            } else {
                raw
            };
            let skip_first = ctx.ast.x(expr_id, add(route, 4)) != 0;
            let place = ctx.ast.x(expr_id, add(route, 5));
            let mut exprs: ChunkSeq[u64] = ChunkSeq::new[u64]();
            if callee_kind == X_FIELD {
                exprs.push(ctx.ast.x(callee, 0));
            }
            for i in 0..args.len() {
                if !(skip_first && i == 0) {
                    exprs.push(args.try_get(i).unwrap_or(0));
                }
            }
            let terms = operands(
                inout builder,
                inout types,
                in ctx,
                inout gen,
                in exprs,
                inout out
            );
            let mut mutates = false;
            let term = tiled_term(inout builder, tiled_op, extra, in terms, inout mutates);
            if mutates {
                let mut place_id = NONE;
                if place == 1 {
                    place_id = ctx.ast.x(callee, 0);
                } else if place == 2 {
                    place_id = args.try_get(0).unwrap_or(NONE);
                }
                let mut path: ChunkSeq[u32] = ChunkSeq::new[u32]();
                let root = if place_id == NONE {
                    NONE32
                } else {
                    place_of(in ctx, place_id, inout path)
                };
                if root == NONE32 {
                    builder.fail(in "mutable TiledSeq argument requires a place");
                    return unit(inout builder);
                }
                assign(
                    inout builder,
                    inout types,
                    in ctx,
                    inout gen,
                    root,
                    in path,
                    term,
                    inout out
                );
                return unit(inout builder);
            }
            return term;
        }
    }
    // method call sugar: `local.method(args)`
    if callee_kind == X_FIELD {
        let base = ctx.ast.x(callee, 0);
        if ctx.ast.kind(base) == X_NAME && gen.has(ctx.ast.xs(base, 0)) {
            let entry = gen.local(gen.find(ctx.ast.xs(base, 0)));
            let type_name = types.name(entry.ty);
            let method = ctx.ast.xs(callee, 1);
            let mut spelling: ChunkSeq[u8] = ChunkSeq::new[u8]();
            if type_name != 0 {
                builder.names.write(type_name, inout spelling);
            }
            put(inout spelling, in "::");
            builder.names.write(method, inout spelling);
            let method_name = builder.names.lookup(in spelling.as_slice());
            if method_name != NONE32 && ctx.env.fns.find(method_name) != NONE32 {
                let mut actual: ChunkSeq[u64] = ChunkSeq::new[u64]();
                actual.push(base);
                for i in 0..args.len() {
                    actual.push(args.try_get(i).unwrap_or(0));
                }
                return call(
                    inout builder,
                    inout types,
                    in ctx,
                    inout gen,
                    expr_id,
                    callee,
                    method_name,
                    in actual,
                    inout out
                );
            }
        }
    }
    if callee_kind == X_FIELD {
        let base = ctx.ast.x(callee, 0);
        if ctx.ast.kind(base) == X_NAME {
            let label = ctx.ast.xs(base, 0);
            let cap = gen.cap(label);
            if !cap.removed {
                let mut layer = NONE64;
                if cap.depth > 0 && gen.layer(wrapping_sub(cap.depth, 1)).inst.label == label {
                    layer = wrapping_sub(cap.depth, 1);
                }
                let cap_evidence = evidence(inout builder, in gen, cap);
                return perform_op(
                    inout builder,
                    inout types,
                    in ctx,
                    inout gen,
                    cap.inst.name,
                    ctx.ast.xs(callee, 1),
                    layer,
                    true,
                    cap_evidence,
                    in args,
                    inout out
                );
            }
        }
    }
    if callee_kind != X_NAME {
        builder.fail(in "Lean extraction of method and indirect calls requires named functions");
        return unit(inout builder);
    }
    let is_fn = ctx.env.fns.find(callee_name) != NONE32;
    let local = gen.has(callee_name);
    if rewritten == NONE32 {
        let float = ctx.ast.x(expr_id, add(route, 6));
        let is_int = ctx.ast.x(expr_id, add(route, 7)) != 0;
        let wrapping = ctx.ast.x(expr_id, add(route, 8));
        if float != NONE && !local && !is_fn {
            fail_sym(inout builder, ctx.ast.sym(float));
            return unit(inout builder);
        }
        if is_int && !local && !is_fn {
            fail_with_name(
                inout builder,
                in "Lean extraction does not model the integer intrinsic '",
                callee_name,
                in "' yet (vesper.arith.checked/1 bit operations, shifts and conversions are refused)"
            );
            return unit(inout builder);
        }
        if wrapping != NONE && !local && !is_fn && args.len() == 2 {
            let values = operands(
                inout builder,
                inout types,
                in ctx,
                inout gen,
                in args,
                inout out
            );
            return arith_term(
                inout builder,
                ctx.ast.sym(wrapping),
                0,
                get(in values, 0),
                get(in values, 1)
            );
        }
    }
    let resumption = gen.cont(callee_name);
    if resumption.key != NONE32 {
        if resumption.context == gen.context {
            return resume_call(
                inout builder,
                inout types,
                in ctx,
                inout gen,
                resumption,
                in args,
                inout out
            );
        }
        if resumption.fallback == NONE32 {
            builder.fail(
                in "Lean extraction cannot resume this continuation outside its clause: its frame or borrowed arguments must be threaded by a direct resumption"
            );
            return unit(inout builder);
        }
        let values = operands(inout builder, inout types, in ctx, inout gen, in args, inout out);
        let fallback_ref = lref(inout builder, resumption.fallback);
        let call = app(inout builder, fallback_ref, in values);
        let lifted = lift_action(inout builder, in gen, call, resumption.depth);
        return action(inout builder, inout gen, lifted, inout out);
    }
    if effect_call(inout builder, in ctx, callee_name) {
        let mut eff = NONE32;
        let mut op = NONE32;
        split_op(inout builder, callee_name, inout eff, inout op);
        let cap = gen.unlabeled_cap(eff);
        if !cap.removed {
            let label = cap.inst.label;
            let mut layer = NONE64;
            if cap.depth > 0 {
                let entry = gen.layer(wrapping_sub(cap.depth, 1));
                if entry.inst.label != NONE32 && entry.inst.label == label {
                    layer = wrapping_sub(cap.depth, 1);
                }
            }
            let cap_evidence = evidence(inout builder, in gen, cap);
            return perform_op(
                inout builder,
                inout types,
                in ctx,
                inout gen,
                eff,
                op,
                layer,
                true,
                cap_evidence,
                in args,
                inout out
            );
        }
        let key = if rewritten == NONE32 {
            ctx.ast.xs(expr_id, add(route, 10))
        } else {
            NONE32
        };
        let mut layer = NONE64;
        if key != NONE32 {
            layer = last_layer(in gen, key, true);
        }
        if layer == NONE64 {
            layer = last_layer(in gen, eff, false);
        }
        let none = no_t();
        return perform_op(
            inout builder,
            inout types,
            in ctx,
            inout gen,
            eff,
            op,
            layer,
            false,
            none,
            in args,
            inout out
        );
    }
    if ctx.fip
        && (spells(in builder, callee_name, in "Box::new")
            || spells(in builder, callee_name, in "Box::new_in_caller"))
    {
        if args.len() != 1 {
            builder.fail(in "Box::new expects one argument");
            return unit(inout builder);
        }
        let x = args.try_get(0).unwrap_or(0);
        return expr(inout builder, inout types, in ctx, inout gen, x, inout out);
    }
    if lookup_constructor(inout builder, in ctx.env.world, callee_name) != NONE64 && !local {
        let values = operands(inout builder, inout types, in ctx, inout gen, in args, inout out);
        let ctor = constructor(inout builder, in ctx, callee_name);
        return app(inout builder, ctor, in values);
    }
    if local {
        return local_call(
            inout builder,
            inout types,
            in ctx,
            inout gen,
            expr_id,
            callee_name,
            in args,
            inout out
        );
    }
    if !is_fn {
        fail_with_name(inout builder, in "unknown Lean callee ", callee_name, in "");
        return unit(inout builder);
    }
    let sig = ctx.env.fns.sig(w(ctx.env.fns.find(callee_name)));
    let func_index = ctx.ast.fn_index(callee_name);
    // the capabilities of the callee's labeled requirements
    let mut evidence_args = empty();
    if func_index != NONE {
        let reqs = requirements(in types, in ctx, func_index);
        for index in 0..reqs.len() {
            let req = types.effect_at(u64_at(in reqs, index));
            if req.label != 0 {
                let cap = gen.cap(wrapping_sub(req.label, 1));
                if !cap.removed {
                    let cap_sym = builder.numbered(in "$cap", index);
                    let cap_evidence = evidence(inout builder, in gen, cap);
                    let cap_arg = named_arg_sym(inout builder, cap_sym, cap_evidence);
                    evidence_args.push(cap_arg);
                }
            }
        }
    }
    let call_index = ctx.env.fns.call(ctx.ast.start(expr_id), ctx.ast.end(expr_id));
    let mut arguments = empty();
    for i in 0..sig.gn {
        let generic = ctx.env.fns.generic(sig, i);
        if !generic.row {
            let solved = ctx.env.fns.call_var(call_index, generic.name);
            if solved != NONE32 {
                builder.check(generic.name, in "identifier");
                let ty_term = ty(inout builder, in types, in ctx, inout gen, solved);
                let generic_arg = named_arg_sym(inout builder, generic.name, ty_term);
                arguments.push(generic_arg);
            }
        }
    }
    extend(inout arguments, in evidence_args);
    let values = operands(inout builder, inout types, in ctx, inout gen, in args, inout out);
    for i in 0..values.len() {
        let pos_arg = pos(inout builder, get(in values, i));
        arguments.push(pos_arg);
    }
    // the callee's borrowed arguments and the solved generics
    let mut states: ChunkSeq[St] = ChunkSeq::new[St]();
    for i in 0..sig.param_count {
        let param = ctx.env.fns.param(sig, i);
        if widen_u64(param.pass) == TyPass::Inout && i < args.len() {
            states.push(St {
                ty: param.ty,
                src: 0,
                proj_start: param.proj_start,
                proj_count: param.proj_count,
                arg: args.try_get(i).unwrap_or(0)
            });
        }
    }
    let mut vars = vars_new();
    if call_index != NONE32 {
        let call_row = ctx.env.fns.call_at(w(call_index));
        for i in 0..call_row.n {
            match ctx.env.fns.vars.try_get(add(call_row.a, i)) {
                Option::Some(bound_var) => vars.set(bound_var.name, bound_var.ty),
                Option::None => {},
            }
        }
    }
    if func_index != NONE && takes_sync(in types, in ctx, func_index) {
        let mut has_sync = false;
        let sync_value = callee_sync(
            inout builder,
            inout types,
            in ctx,
            inout gen,
            in states,
            in vars,
            inout has_sync
        );
        if has_sync {
            let sync_arg = named_arg(inout builder, in SYNC, sync_value);
            arguments.push(sync_arg);
        }
    }
    if gen.in_family(callee_name) && gen.monad_id {
        fail_with_name(
            inout builder,
            in "a fuel companion cannot call the recursive function '",
            callee_name,
            in "' inside a pure closure"
        );
        return unit(inout builder);
    }
    let mut callee_ref = no_t();
    if gen.in_family(callee_name) {
        let fuel_value = named(inout builder, in FUEL);
        let fuel_arg = named_arg(inout builder, in FUEL, fuel_value);
        let mut with_fuel = empty();
        with_fuel.push(fuel_arg);
        extend(inout with_fuel, in arguments);
        arguments = with_fuel;
        callee_ref = fuel_ref(inout builder, callee_name);
    } else {
        callee_ref = sref(inout builder, callee_name);
    }
    let call_term = app_args(inout builder, callee_ref, in arguments);
    let mut result = no_t();
    if func_index != NONE && callee_effectful(in types, in ctx, in gen, func_index) {
        result = action(inout builder, inout gen, call_term, inout out);
    } else if states.len() == 0 {
        return call_term;
    } else {
        let tmp = temp(inout builder, inout gen);
        let none = unit(inout builder);
        let_local(inout builder, inout out, tmp, call_term, false, none, false);
        result = lref(inout builder, tmp);
    }
    restore_states(
        inout builder,
        inout types,
        in ctx,
        inout gen,
        result,
        in states,
        in vars,
        inout out
    )
}

// `$fuel`: the fuel binder of total companions.
const FUEL: Str = "$fuel";

// `Term::Ref(fuel_name(n))`: `n$fuel`.
fn fuel_ref(inout builder: B, n: u32) -> T {
    let fuel_sym = builder.joined(in "", n, in FUEL);
    sref(inout builder, fuel_sym)
}

// `eff::op` split at the first `::`.
fn split_op(inout builder: B, name: u32, inout eff: u32, inout op: u32) {
    let size = builder.names.size(name);
    let mut i: u64 = 0;
    loop {
        if inc(i) >= size {
            return;
        }
        if builder.names.byte(name, i) == 58 && builder.names.byte(name, inc(i)) == 58 {
            break;
        }
        i = inc(i);
    }
    let mut eff_bytes: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for j in 0..i {
        eff_bytes.push(builder.names.byte(name, j));
    }
    eff = builder.names.intern(in eff_bytes.as_slice());
    let mut op_bytes: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for j in add(i, 2)..size {
        op_bytes.push(builder.names.byte(name, j));
    }
    op = builder.names.intern(in op_bytes.as_slice());
}

// The last layer whose instance key (`by_key`) or effect name is `sym`, or
// NONE64.
fn last_layer(in gen: G, sym: u32, by_key: bool) -> u64 {
    let mut i = gen.layers.len();
    loop {
        if i == 0 {
            return NONE64;
        }
        i = wrapping_sub(i, 1);
        let layer = gen.layer(i);
        if (by_key && layer.inst.key == sym) || (!by_key && layer.inst.name == sym) {
            return i;
        }
    }
}

// A call of a local function value.
fn local_call(
    inout builder: B,
    inout types: Types,
    in ctx: Y,
    inout gen: G,
    expr_id: u64,
    name: u32,
    in args: ChunkSeq[u64],
    inout out: ChunkSeq[T]
) -> T {
    let entry = gen.local(gen.find(name));
    let fn_node = types.node(entry.ty);
    if fn_node.kind != TyKind::Fn {
        builder.fail(in "call of a non-function Lean local");
        return unit(inout builder);
    }
    let mut values = operands(inout builder, inout types, in ctx, inout gen, in args, inout out);
    if values.len() == 0 {
        let unit_value = unit(inout builder);
        values.push(unit_value);
    }
    let fn_ref = lref(inout builder, gen.cur(entry.id));
    let call_term = app(inout builder, fn_ref, in values);
    let effectful = effectful_fn_type(in types, entry.ty);
    let mut states: ChunkSeq[St] = ChunkSeq::new[St]();
    for i in 0..w(fn_node.n) {
        if i < args.len() && widen_u64(types.param_pass(entry.ty, i)) == TyPass::Inout {
            states.push(St {
                ty: types.arg(entry.ty, i),
                src: 2,
                proj_start: 0,
                proj_count: 0,
                arg: args.try_get(i).unwrap_or(0)
            });
        }
    }
    if states.len() > 0 && abortable_row(in types, in ctx, fn_node.r2) {
        builder.fail(
            in "Lean extraction does not model keep-writes for an abortable call through a function value with inout parameters"
        );
        return unit(inout builder);
    }
    let mut result = no_t();
    if effectful {
        let lifted = lift_action(inout builder, in gen, call_term, entry.depth);
        result = action(inout builder, inout gen, lifted, inout out);
    } else if states.len() == 0 {
        return call_term;
    } else {
        let tmp = temp(inout builder, inout gen);
        let none = unit(inout builder);
        let_local(inout builder, inout out, tmp, call_term, false, none, false);
        result = lref(inout builder, tmp);
    }
    let vars = vars_new();
    restore_states(
        inout builder,
        inout types,
        in ctx,
        inout gen,
        result,
        in states,
        in vars,
        inout out
    )
}

// ----- effects -------------------------------------------------------------------

// The effect instance of row entry `i` (`Types::effect_at`).
fn inst_of_node(in types: Types, inout gen: G, i: u64) -> Inst {
    let entry = types.effect_at(i);
    let arg_start = gen.inst_args.len();
    for j in 0..w(entry.n) {
        gen.inst_args.push(u32_at(in types.items, add(w(entry.a), j)));
    }
    Inst {
        name: entry.name,
        label: if entry.label == 0 {
            NONE32
        } else {
            wrapping_sub(entry.label, 1)
        },
        arg_start: arg_start,
        arg_count: w(entry.n),
        key: NONE32
    }
}

fn same_node(in types: Types, i: u64, j: u64) -> bool {
    let first = types.effect_at(i);
    let second = types.effect_at(j);
    if first.label != second.label || first.name != second.name || first.n != second.n {
        return false;
    }
    for k in 0..w(first.n) {
        if u32_at(in types.items, add(w(first.a), k))
            != u32_at(in types.items, add(w(second.a), k))
        {
            return false;
        }
    }
    true
}

fn req_visit(in types: Types, ty: u32, inout out: ChunkSeq[u64]) {
    if ty == NONE32 {
        return;
    }
    let node = types.node(ty);
    if node.kind == TyKind::Fn {
        let row = types.row(node.r2);
        for k in 0..w(row.n) {
            let i = add(w(row.a), k);
            let mut seen = false;
            for q in 0..out.len() {
                if same_node(in types, u64_at(in out, q), i) {
                    seen = true;
                }
            }
            if !seen {
                out.push(i);
            }
        }
        req_visit(in types, node.r, inout out);
    } else if node.kind == TyKind::Named || node.kind == TyKind::Tuple {
        for k in 0..w(node.n) {
            req_visit(in types, types.arg(ty, k), inout out);
        }
    }
}

// `function_requirements(f)`: row entries of the function's effects, then
// those of the arrows in its result.
fn requirements(in types: Types, in ctx: Y, func_index: u64) -> ChunkSeq[u64] {
    let func = ctx.ast.function(func_index);
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let row = types.row(types.node(func.row).r2);
    for k in 0..w(row.n) {
        out.push(add(w(row.a), k));
    }
    req_visit(in types, func.result, inout out);
    out
}

// `effectful_function(f)`.
fn fn_effectful(in types: Types, in ctx: Y, func_index: u64) -> bool {
    let func = ctx.ast.function(func_index);
    let row = types.row(types.node(func.row).r2);
    row.n > 0 || row.tail != 0
}

fn callee_effectful(in types: Types, in ctx: Y, in gen: G, func_index: u64) -> bool {
    fn_effectful(in types, in ctx, func_index) || gen.in_family(ctx.ast.function(func_index).name)
}

// `abortable_row(world, effects)`.
fn abortable_row(in types: Types, in ctx: Y, row_id: u32) -> bool {
    let row = types.row(row_id);
    if row.tail != 0 {
        return true;
    }
    for k in 0..w(row.n) {
        let entry = types.effect_at(add(w(row.a), k));
        let decl_index = ctx.ast.eff_index(entry.name);
        if decl_index == NONE || !ctx.ast.eff(decl_index).linear {
            return true;
        }
    }
    false
}

// `takes_sync(world, f)`.
fn takes_sync(in types: Types, in ctx: Y, func_index: u64) -> bool {
    if !fn_effectful(in types, in ctx, func_index) {
        return false;
    }
    let func = ctx.ast.function(func_index);
    let mut any = false;
    for i in 0..func.param_count {
        if ctx.ast.param_pass(func, i) == TyPass::Inout {
            any = true;
        }
    }
    any && abortable_row(in types, in ctx, types.node(func.row).r2)
}

// A borrowed (`inout`) argument a call writes back: the parameter's type
// and projections (`src` 0: a signature's, 1: an operation's, 2: none) and
// the argument expression.
pub copy struct St {
    ty: u32,
    src: u64,
    proj_start: u64,
    proj_count: u64,
    arg: u64,
}

fn st_at(in states: ChunkSeq[St], i: u64) -> St {
    match states.try_get(i) {
        Option::Some(entry) => entry,
        Option::None => St { ty: 0, src: 2, proj_start: 0, proj_count: 0, arg: 0 },
    }
}

// Projection `q` of `s` as a path.
fn st_proj(in ctx: Y, s: St, q: u64, inout out: ChunkSeq[u32]) {
    if s.src == 0 {
        let path = ctx.env.fns.path(add(s.proj_start, q));
        for j in 0..path.n {
            out.push(ctx.env.fns.path_sym(path, j));
        }
    } else if s.src == 1 {
        let proj_range = match ctx.ast.eff_projs.try_get(add(s.proj_start, q)) {
            Option::Some(proj_range) => proj_range,
            Option::None => Range { a: 0, n: 0 },
        };
        for j in 0..proj_range.n {
            out.push(ctx.ast.proj_sym(proj_range, j));
        }
    }
}

// `assign_states(source, offset, n, states, vars, out)`.
fn assign_states(
    inout builder: B,
    inout types: Types,
    in ctx: Y,
    inout gen: G,
    source: T,
    offset: u64,
    n: u64,
    in states: ChunkSeq[St],
    in vars: Vars,
    inout out: ChunkSeq[T]
) {
    for index in 0..states.len() {
        let borrowed = st_at(in states, index);
        let mut path: ChunkSeq[u32] = ChunkSeq::new[u32]();
        let root = place_of(in ctx, borrowed.arg, inout path);
        if root == NONE32 {
            builder.fail(in "a mutable Lean argument requires a place");
            return;
        }
        let param_ty = substitute(inout types, borrowed.ty, in vars);
        let value = tuple_get(inout builder, source, add(index, offset), n);
        if borrowed.proj_count == 0 {
            assign(inout builder, inout types, in ctx, inout gen, root, in path, value, inout out);
        } else {
            for q in 0..borrowed.proj_count {
                let mut proj: ChunkSeq[u32] = ChunkSeq::new[u32]();
                st_proj(in ctx, borrowed, q, inout proj);
                let mut target: ChunkSeq[u32] = ChunkSeq::new[u32]();
                for j in 0..path.len() {
                    target.push(sym_at(in path, j));
                }
                for j in 0..proj.len() {
                    target.push(sym_at(in proj, j));
                }
                let projected = get_path(
                    inout builder,
                    inout types,
                    in ctx,
                    value,
                    param_ty,
                    in proj,
                    0
                );
                assign(
                    inout builder,
                    inout types,
                    in ctx,
                    inout gen,
                    root,
                    in target,
                    projected,
                    inout out
                );
            }
        }
    }
}

// `restore_states(result, states, vars, out)`.
fn restore_states(
    inout builder: B,
    inout types: Types,
    in ctx: Y,
    inout gen: G,
    result: T,
    in states: ChunkSeq[St],
    in vars: Vars,
    inout out: ChunkSeq[T]
) -> T {
    let arity = inc(states.len());
    assign_states(
        inout builder,
        inout types,
        in ctx,
        inout gen,
        result,
        1,
        arity,
        in states,
        in vars,
        inout out
    );
    tuple_get(inout builder, result, 0, arity)
}

// `callee_sync(states, vars)`: `has` is false for `None`.
fn callee_sync(
    inout builder: B,
    inout types: Types,
    in ctx: Y,
    inout gen: G,
    in states: ChunkSeq[St],
    in vars: Vars,
    inout has: bool
) -> T {
    has = false;
    let mut frames = false;
    for k in gen.bl_start..gen.body_layers.len() {
        let index = gen.body_layers.try_get(k).unwrap_or(0);
        if gen.layer(index).fz > 0 {
            frames = true;
        }
    }
    if !frames && !gen.own_sync {
        return no_t();
    }
    let sigma = builder.intern(in "$sigma");
    let mut body = empty();
    let mut roots: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..states.len() {
        let borrowed = st_at(in states, i);
        let mut path: ChunkSeq[u32] = ChunkSeq::new[u32]();
        let root = place_of(in ctx, borrowed.arg, inout path);
        if root == NONE32 {
            builder.fail(in "a mutable Lean argument requires a place");
            return no_t();
        }
        let mut seen = false;
        for j in 0..roots.len() {
            if sym_at(in roots, j) == root {
                seen = true;
            }
        }
        if !seen {
            roots.push(root);
            let local_index = gen.find(root);
            if local_index == NONE64 {
                builder.fail(in "unknown Lean place");
                return no_t();
            }
            let lean = gen.cur(gen.local(local_index).id);
            let current_ref = lref(inout builder, lean);
            let none = unit(inout builder);
            let_local(inout builder, inout body, lean, current_ref, false, none, true);
        }
    }
    let written = gen.alias_written;
    let src = lref(inout builder, sigma);
    assign_states(
        inout builder,
        inout types,
        in ctx,
        inout gen,
        src,
        0,
        states.len(),
        in states,
        in vars,
        inout body
    );
    gen.alias_written = written;
    sync(inout builder, in gen, inout body);
    sync_caller(inout builder, in gen, inout body);
    let unit_value = unit(inout builder);
    let pure_unit = pure(inout builder, unit_value);
    let sync_body = sequence(inout builder, in body, pure_unit);
    let mut names: ChunkSeq[u32] = ChunkSeq::new[u32]();
    names.push(sigma);
    has = true;
    inferred(inout builder, in names, sync_body)
}

// The index of operation `op` of `decl`, or NONE.
fn op_index(in ctx: Y, decl: EffDecl, op: u32) -> u64 {
    for i in 0..decl.op_count {
        if ctx.ast.eff_op(decl, i).name == op {
            return i;
        }
    }
    NONE
}

// `op_value_type(sig, vars)`.
fn op_value_type(
    inout builder: B,
    inout types: Types,
    in ctx: Y,
    inout gen: G,
    sig: EffOp,
    in vars: Vars
) -> T {
    let mut tys = empty();
    let result_ty = substitute(inout types, sig.result, in vars);
    let result_term = ty(inout builder, in types, in ctx, inout gen, result_ty);
    tys.push(result_term);
    for i in 0..sig.param_count {
        let param = ctx.ast.op_param(sig, i);
        if param.pass == TyPass::Inout {
            let param_ty = substitute(inout types, param.ty, in vars);
            let ty_term = ty(inout builder, in types, in ctx, inout gen, param_ty);
            tys.push(ty_term);
        }
    }
    product(inout builder, in tys)
}

// The vars of an effect's generics applied to a layer's arguments (zip).
fn effect_vars(in ctx: Y, in gen: G, decl: EffDecl, layer: u64) -> Vars {
    let mut vars = vars_new();
    if layer == NONE64 {
        return vars;
    }
    let entry = gen.layer(layer);
    for i in 0..decl.gn {
        if i < entry.inst.arg_count {
            vars.set(ctx.ast.eff_generic(decl, i), gen.earg(entry.inst, i));
        }
    }
    vars
}

fn put_sym(inout builder: B, inout message: ChunkSeq[u8], sym: u32) {
    builder.names.write(sym, inout message);
}

fn fail_bytes(inout builder: B, in message: ChunkSeq[u8]) {
    match String::from_utf8(in message.as_slice()) {
        Option::Some(text) => builder.fail(in text.as_str()),
        Option::None => builder.fail(in "refused"),
    }
}

// `perform(effect, op, layer, evidence, args, out)`; `layer` is NONE64
// for none.
fn perform_op(
    inout builder: B,
    inout types: Types,
    in ctx: Y,
    inout gen: G,
    eff: u32,
    op: u32,
    layer: u64,
    has_evidence: bool,
    ev: T,
    in args: ChunkSeq[u64],
    inout out: ChunkSeq[T]
) -> T {
    let decl_index = ctx.ast.eff_index(eff);
    if decl_index == NONE {
        builder.fail(in "unknown Lean effect");
        return unit(inout builder);
    }
    let decl = ctx.ast.eff(decl_index);
    let op_offset = op_index(in ctx, decl, op);
    if op_offset == NONE {
        builder.fail(in "unknown Lean operation");
        return unit(inout builder);
    }
    let sig = ctx.ast.eff_op(decl, op_offset);
    let values = operands(inout builder, inout types, in ctx, inout gen, in args, inout out);
    let vars = effect_vars(in ctx, in gen, decl, layer);
    let mut direct = false;
    let mut info = OpInfo {
        name: NONE32,
        implementation: 0,
        aliased_start: 0,
        aliased_count: 0,
        post_access: false
    };
    if layer != NONE64 {
        let handler_layer = gen.layer(layer);
        info = gen.info(handler_layer, op);
        direct = gen.closures == handler_layer.closures
            && info.name != NONE32
            && info.aliased_count > 0;
    }
    let mut performed = no_t();
    if direct {
        let handler_layer = gen.layer(layer);
        let mut lenses = empty();
        for k in 0..info.aliased_count {
            let i = gen.ix(add(info.aliased_start, k));
            let arg = args.try_get(i).unwrap_or(0);
            let mut path: ChunkSeq[u32] = ChunkSeq::new[u32]();
            let root = place_of(in ctx, arg, inout path);
            let local_index = if root == NONE32 {
                NONE64
            } else {
                gen.find(root)
            };
            let mut lens = no_t();
            let mut done = false;
            if local_index != NONE64 {
                let local = gen.local(local_index);
                let mut frame_slot = NONE64;
                for j in 0..handler_layer.fz {
                    if frame_slot == NONE64 && gen.ix(add(handler_layer.fa, j)) == local.id {
                        frame_slot = j;
                    }
                }
                if frame_slot != NONE64 {
                    let frame_len = handler_layer.fz;
                    let param = ctx.ast.op_param(sig, i);
                    let param_subst = substitute(inout types, param.ty, in vars);
                    let param_term = ty(inout builder, in types, in ctx, inout gen, param_subst);
                    let getter_frame = named(inout builder, in "$w");
                    let slot_value = tuple_get(inout builder, getter_frame, frame_slot, frame_len);
                    let getv = get_path(
                        inout builder,
                        inout types,
                        in ctx,
                        slot_value,
                        local.ty,
                        in path,
                        0
                    );
                    let param_ty = substitute(inout types, param.ty, in vars);
                    let setter_frame = named(inout builder, in "$w");
                    let mut component = tuple_get(
                        inout builder,
                        setter_frame,
                        frame_slot,
                        frame_len
                    );
                    let borrowed = St {
                        ty: param.ty,
                        src: 1,
                        proj_start: param.proj_start,
                        proj_count: param.proj_count,
                        arg: arg
                    };
                    let proj_count = if param.proj_count == 0 {
                        1
                    } else {
                        param.proj_count
                    };
                    for q in 0..proj_count {
                        let mut proj: ChunkSeq[u32] = ChunkSeq::new[u32]();
                        if param.proj_count > 0 {
                            st_proj(in ctx, borrowed, q, inout proj);
                        }
                        let mut full: ChunkSeq[u32] = ChunkSeq::new[u32]();
                        for j in 0..path.len() {
                            full.push(sym_at(in path, j));
                        }
                        for j in 0..proj.len() {
                            full.push(sym_at(in proj, j));
                        }
                        let new_value = named(inout builder, in "$v");
                        let new_part = get_path(
                            inout builder,
                            inout types,
                            in ctx,
                            new_value,
                            param_ty,
                            in proj,
                            0
                        );
                        component = set_path(
                            inout builder,
                            inout types,
                            in ctx,
                            component,
                            local.ty,
                            in full,
                            0,
                            new_part
                        );
                    }
                    let mut comps = empty();
                    for j in 0..frame_len {
                        if j == frame_slot {
                            comps.push(component);
                        } else {
                            let frame_ref = named(inout builder, in "$w");
                            let old_slot = tuple_get(inout builder, frame_ref, j, frame_len);
                            comps.push(old_slot);
                        }
                    }
                    let frame_sym = builder.intern(in "$w");
                    let value_sym = builder.intern(in "$v");
                    let mut getter_binders = empty();
                    let getter_binder = explicit(inout builder, frame_sym, handler_layer.frame_ty);
                    getter_binders.push(getter_binder);
                    let getter = lambda(inout builder, in getter_binders, getv);
                    let mut setter_binders = empty();
                    let frame_binder = explicit(inout builder, frame_sym, handler_layer.frame_ty);
                    setter_binders.push(frame_binder);
                    let value_binder = explicit(inout builder, value_sym, param_term);
                    setter_binders.push(value_binder);
                    let new_frame = tuple(inout builder, in comps);
                    let setter = lambda(inout builder, in setter_binders, new_frame);
                    let mut pair = empty();
                    pair.push(getter);
                    pair.push(setter);
                    let lens_pair = tuple(inout builder, in pair);
                    let some = global2(inout builder, in "Option", in "some");
                    lens = app1(inout builder, some, lens_pair);
                    done = true;
                } else if local.depth > layer && info.post_access {
                    let mut message: ChunkSeq[u8] = ChunkSeq::new[u8]();
                    put(inout message, in "Lean extraction cannot observe the final value of '");
                    put_sym(inout builder, inout message, root);
                    put(inout message, in "' after resuming operation ");
                    put_sym(inout builder, inout message, eff);
                    put(inout message, in "::");
                    put_sym(inout builder, inout message, op);
                    put(
                        inout message,
                        in ": the borrowed place is local to the handled computation"
                    );
                    fail_bytes(inout builder, in message);
                    return unit(inout builder);
                }
            }
            if !done {
                lens = global2(inout builder, in "Option", in "none");
            }
            lenses.push(lens);
        }
        let value_ty = op_value_type(inout builder, inout types, in ctx, inout gen, sig, in vars);
        let impl_ref = lref(inout builder, info.implementation);
        let mut callargs = empty();
        extend(inout callargs, in lenses);
        extend(inout callargs, in values);
        let call = app(inout builder, impl_ref, in callargs);
        let child_ty = app1(inout builder, handler_layer.child, value_ty);
        let ascribed = ascribe(inout builder, call, child_ty);
        performed = lift_action(inout builder, in gen, ascribed, inc(layer));
    } else {
        let mut arguments = empty();
        if has_evidence {
            let self_arg = named_arg(inout builder, in "self", ev);
            arguments.push(self_arg);
        }
        for i in 0..values.len() {
            let pos_arg = pos(inout builder, get(in values, i));
            arguments.push(pos_arg);
        }
        let effect_sym = builder.joined(in "Effect_", eff, in "");
        let mark = builder.at();
        builder.w(T_REF);
        builder.name2(effect_sym, op);
        let op_ref = builder.since(mark);
        performed = app_args(inout builder, op_ref, in arguments);
    }
    let result = action_with(inout builder, inout gen, performed, !decl.linear, inout out);
    let mut states: ChunkSeq[St] = ChunkSeq::new[St]();
    for i in 0..sig.param_count {
        let inout_param = ctx.ast.op_param(sig, i);
        if inout_param.pass == TyPass::Inout && i < args.len() {
            states.push(St {
                ty: inout_param.ty,
                src: 1,
                proj_start: inout_param.proj_start,
                proj_count: inout_param.proj_count,
                arg: args.try_get(i).unwrap_or(0)
            });
        }
    }
    if states.len() == 0 {
        if never(in builder, in types, sig.result) {
            return gapp1(inout builder, in "Empty", in "elim", result);
        }
        return result;
    }
    restore_states(
        inout builder,
        inout types,
        in ctx,
        inout gen,
        result,
        in states,
        in vars,
        inout out
    )
}

// The path of an alias binding as a sequence.
fn abind_path(in gen: G, alias_bind: ABind) -> ChunkSeq[u32] {
    let mut path: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for j in 0..alias_bind.path_count {
        path.push(u32_at(in gen.paths, add(alias_bind.path_start, j)));
    }
    path
}

// `reconstruct(a)`.
fn reconstruct(inout builder: B, inout types: Types, in ctx: Y, in gen: G, a: Alias) -> T {
    let mut value = lref(inout builder, a.raw);
    for k in 0..a.bind_count {
        let alias_bind = gen.abind(add(a.bind_start, k));
        let path = abind_path(in gen, alias_bind);
        let current = lref(inout builder, gen.cur(alias_bind.id));
        value = set_path(inout builder, inout types, in ctx, value, a.ty, in path, 0, current);
    }
    value
}

fn option_pattern(inout builder: B, some: bool, in sub_pats: ChunkSeq[T]) -> T {
    let ctor_name = if some {
        rooted2(inout builder, in "Option", in "some")
    } else {
        rooted2(inout builder, in "Option", in "none")
    };
    p_ctor(inout builder, ctor_name, in sub_pats)
}

// `resume(k, args, out)`.
fn resume_call(
    inout builder: B,
    inout types: Types,
    in ctx: Y,
    inout gen: G,
    k: Resumption,
    in args: ChunkSeq[u64],
    inout out: ChunkSeq[T]
) -> T {
    let values = operands(inout builder, inout types, in ctx, inout gen, in args, inout out);
    let mut resumed = empty();
    if values.len() > 0 {
        resumed.push(get(in values, 0));
    } else {
        let unit_value = unit(inout builder);
        resumed.push(unit_value);
    }
    for i in 0..k.alias_count {
        let alias = gen.alias(add(k.alias_start, i));
        if alias.pass == TyPass::Inout {
            let rebuilt = reconstruct(inout builder, inout types, in ctx, in gen, alias);
            resumed.push(rebuilt);
        }
    }
    let mut user = no_t();
    if k.stateful {
        if values.len() > 1 {
            user = get(in values, 1);
        } else {
            builder.fail(in "stateful continuation lacks a state");
            return unit(inout builder);
        }
    } else {
        user = unit(inout builder);
    }
    let tmp = temp(inout builder, inout gen);
    let resume_ref = lref(inout builder, k.resume);
    let resumed_tuple = tuple(inout builder, in resumed);
    let state_ref = lref(inout builder, k.state);
    let state_frame = pair_get(inout builder, state_ref, 2);
    let mut pair = empty();
    pair.push(user);
    pair.push(state_frame);
    let user_pair = tuple(inout builder, in pair);
    let call = app2(inout builder, resume_ref, resumed_tuple, user_pair);
    let none = unit(inout builder);
    bind_local(inout builder, inout out, tmp, call, false, none);
    let result_ref = lref(inout builder, tmp);
    let new_frame = pair_get(inout builder, result_ref, 2);
    push_assign(inout builder, inout out, k.frame, new_frame);
    let get_s = builder.intern(in "$get");
    for i in 0..k.alias_count {
        let alias = gen.alias(add(k.alias_start, i));
        let mut refresh = empty();
        let get_fn = named(inout builder, in "$get");
        let frame_ref = lref(inout builder, k.frame);
        let got = app1(inout builder, get_fn, frame_ref);
        push_assign(inout builder, inout refresh, alias.raw, got);
        for j in 0..alias.bind_count {
            let alias_bind = gen.abind(add(alias.bind_start, j));
            let path = abind_path(in gen, alias_bind);
            let raw = lref(inout builder, alias.raw);
            let part = get_path(inout builder, inout types, in ctx, raw, alias.ty, in path, 0);
            push_assign(inout builder, inout refresh, gen.cur(alias_bind.id), part);
        }
        let lens = lref(inout builder, alias.lens);
        let mut inner = empty();
        let get_pat = p_bind(inout builder, get_s);
        inner.push(get_pat);
        let wild_pat = p_wild(inout builder);
        inner.push(wild_pat);
        let tuple_pat = p_tuple(inout builder, in inner);
        let mut some_pats = empty();
        some_pats.push(tuple_pat);
        let some_pat = option_pattern(inout builder, true, in some_pats);
        let none_pats = empty();
        let none_pat = option_pattern(inout builder, false, in none_pats);
        let none_body = empty();
        let lens_match = match_stmt2(
            inout builder,
            lens,
            some_pat,
            in refresh,
            none_pat,
            in none_body
        );
        out.push(lens_match);
    }
    let final_ref = lref(inout builder, tmp);
    pair_get(inout builder, final_ref, 1)
}

// ----- handlers ------------------------------------------------------------------

// A handler clause's payload offsets (`clause_row` in ast.ves).
pub copy struct Clause {
    name: u32,
    pat_count: u64,
    pats_at: u64,
    body: u64,
    free_count: u64,
    free_at: u64,
    name_count: u64,
    names_at: u64,
    next: u64,
}

fn clause_at(in ctx: Y, expr_id: u64, offset: u64, names: bool) -> Clause {
    let pat_count = ctx.ast.x(expr_id, inc(offset));
    let pats_at = add(offset, 2);
    let body = ctx.ast.x(expr_id, add(pats_at, pat_count));
    let free_count = ctx.ast.x(expr_id, inc(add(pats_at, pat_count)));
    let free_at = add(add(pats_at, pat_count), 2);
    let mut next = add(free_at, free_count);
    let mut name_count: u64 = 0;
    let mut names_at: u64 = 0;
    if names {
        name_count = ctx.ast.x(expr_id, next);
        names_at = inc(next);
        next = add(names_at, wrapping_mul(name_count, 3));
    }
    Clause {
        name: ctx.ast.xs(expr_id, offset),
        pat_count: pat_count,
        pats_at: pats_at,
        body: body,
        free_count: free_count,
        free_at: free_at,
        name_count: name_count,
        names_at: names_at,
        next: next
    }
}

fn clause_pat(in ctx: Y, expr_id: u64, clause: Clause, i: u64) -> u64 {
    if i >= clause.pat_count {
        NONE
    } else {
        ctx.ast.x(expr_id, add(clause.pats_at, i))
    }
}

// `capture_clause(captures, saved, out)`: nothing changed the scope since
// the save, so the saved bindings are the visible ones.
fn capture_clause(
    inout builder: B,
    inout gen: G,
    in ctx: Y,
    expr_id: u64,
    clause: Clause,
    inout out: ChunkSeq[T]
) {
    for i in 0..clause.free_count {
        let name = ctx.ast.xs(expr_id, add(clause.free_at, i));
        let local_index = gen.find(name);
        if local_index != NONE64 {
            let local = gen.local(local_index);
            let lean = fresh(inout builder, inout gen, name);
            let current_ref = lref(inout builder, gen.cur(local.id));
            let none = unit(inout builder);
            let_local(inout builder, inout out, lean, current_ref, false, none, true);
            gen.set_cur(local.id, lean);
        }
    }
}

// A pattern path of `pattern_paths`: the bound name, its path
// (`paths[path_start..path_start+path_count]` of the caller's pool) and type.
pub copy struct PPath {
    name: u32,
    path_start: u64,
    path_count: u64,
    ty: u32,
}

// `pattern_paths(p, ty, path, out)`; `pool` holds the paths.
fn pattern_paths(
    inout builder: B,
    inout types: Types,
    in ctx: Y,
    pat_id: u64,
    ty: u32,
    in path: ChunkSeq[u32],
    inout pool: ChunkSeq[u32],
    inout out: ChunkSeq[PPath]
) {
    if builder.failed {
        return;
    }
    if ctx.ast.is_box(pat_id) {
        let inner = box_inner(in builder, in types, in ctx, ty);
        if inner == NONE32 {
            builder.fail(in "Box pattern lacks Box[T] type");
            return;
        }
        if ctx.ast.pkind(pat_id) == PK_CTOR {
            let n = ctx.ast.px(pat_id, 2);
            for i in 0..n {
                let sub = ctx.ast.px(pat_id, add(4, wrapping_mul(i, 2)));
                pattern_paths(
                    inout builder,
                    inout types,
                    in ctx,
                    sub,
                    inner,
                    in path,
                    inout pool,
                    inout out
                );
            }
        }
        return;
    }
    let kind = ctx.ast.pkind(pat_id);
    if kind == PK_BIND {
        let path_start = pool.len();
        for j in 0..path.len() {
            pool.push(sym_at(in path, j));
        }
        out.push(PPath {
            name: ctx.ast.pxs(pat_id, 0),
            path_start: path_start,
            path_count: path.len(),
            ty: ty
        });
    } else if kind == PK_TUPLE {
        if !is_tuple(in types, ty) {
            builder.fail(in "tuple pattern lacks a tuple type");
            return;
        }
        let n = ctx.ast.px(pat_id, 0);
        let arity = types.arity(ty);
        for i in 0..n {
            if i >= arity {
                break;
            }
            let mut next: ChunkSeq[u32] = ChunkSeq::new[u32]();
            for j in 0..path.len() {
                next.push(sym_at(in path, j));
            }
            let index_sym = decimal_sym(inout builder, in "", i);
            next.push(index_sym);
            pattern_paths(
                inout builder,
                inout types,
                in ctx,
                ctx.ast.px(pat_id, inc(i)),
                types.arg(ty, i),
                in next,
                inout pool,
                inout out
            );
        }
    } else if kind == PK_CTOR {
        let ctor = lookup_constructor(inout builder, in ctx.env.world, ctx.ast.pxs(pat_id, 0));
        if ctor == NONE64 {
            builder.fail(in "unknown pattern");
            return;
        }
        if adt_of(in ctx.env.world, ctor).is_enum {
            builder.fail(
                in "Lean extraction requires irrefutable patterns for borrowed operation arguments"
            );
            return;
        }
        let n = ctx.ast.px(pat_id, 2);
        for i in 0..n {
            let field_sym = ctx.ast.sym(ctx.ast.px(pat_id, add(3, wrapping_mul(i, 2))));
            let sub = ctx.ast.px(pat_id, add(4, wrapping_mul(i, 2)));
            let field_ty = field_type(inout types, in builder, in ctx, ty, field_sym);
            if field_ty == NONE32 {
                builder.fail(in "unknown pattern field");
                return;
            }
            let mut next: ChunkSeq[u32] = ChunkSeq::new[u32]();
            for j in 0..path.len() {
                next.push(sym_at(in path, j));
            }
            next.push(field_sym);
            pattern_paths(
                inout builder,
                inout types,
                in ctx,
                sub,
                field_ty,
                in next,
                inout pool,
                inout out
            );
        }
    } else if kind == PK_LITERAL {
        builder.fail(
            in "Lean extraction requires irrefutable patterns for borrowed operation arguments"
        );
    }
}

fn pp_at(in paths: ChunkSeq[PPath], i: u64) -> PPath {
    match paths.try_get(i) {
        Option::Some(x) => x,
        Option::None => PPath { name: 0, path_start: 0, path_count: 0, ty: 0 },
    }
}

// `post_resume_access(body, resume, aliases)` over the clause's names.
fn post_resume_access(
    in ctx: Y,
    expr_id: u64,
    clause: Clause,
    resume: u32,
    in aliases: ChunkSeq[PPath]
) -> bool {
    let mut first = NONE64;
    for i in 0..clause.name_count {
        let at = add(clause.names_at, wrapping_mul(i, 3));
        if ctx.ast.xs(expr_id, at) == resume {
            let end = ctx.ast.x(expr_id, add(at, 2));
            if first == NONE64 || end < first {
                first = end;
            }
        }
    }
    if first == NONE64 {
        return false;
    }
    for i in 0..clause.name_count {
        let at = add(clause.names_at, wrapping_mul(i, 3));
        let name = ctx.ast.xs(expr_id, at);
        let start = ctx.ast.x(expr_id, inc(at));
        if start >= first {
            for j in 0..aliases.len() {
                if pp_at(in aliases, j).name == name {
                    return true;
                }
            }
        }
    }
    false
}

// `handler`'s `routes`: whether the handled computation may perform
// through a helper, callback or closure.
fn routes(in types: Types, in ctx: Y, in gen: G, expr_id: u64, at: u64) -> bool {
    let mut any = ctx.ast.x(expr_id, at) != 0;
    let route_count = ctx.ast.x(expr_id, inc(at));
    let mut offset = add(at, 2);
    for i in 0..route_count {
        let kind = ctx.ast.x(expr_id, offset);
        let name = ctx.ast.xs(expr_id, inc(offset));
        if kind == 1 {
            let arrow = ctx.ast.x(expr_id, add(offset, 2)) != 0;
            if name != NONE32 {
                let func_index = ctx.ast.fn_index(name);
                if func_index != NONE && callee_effectful(in types, in ctx, in gen, func_index) {
                    any = true;
                }
            }
            if arrow {
                any = true;
            }
            offset = add(offset, 3);
        } else if kind == 2 {
            let fn_count = ctx.ast.x(expr_id, add(offset, 2));
            let capped = name != NONE32 && !gen.cap(name).removed;
            if !capped {
                for j in 0..fn_count {
                    let func_index = ctx.ast.fn_index(ctx.ast.xs(expr_id, add(add(offset, 3), j)));
                    if func_index != NONE
                        && callee_effectful(in types, in ctx, in gen, func_index)
                    {
                        any = true;
                    }
                }
            }
            offset = add(add(offset, 3), fn_count);
        } else {
            any = true;
            offset = add(offset, 2);
        }
    }
    any
}

fn sort_ids(inout ids: ChunkSeq[u64]) {
    let n = ids.len();
    for i in 1..n {
        let mut j = i;
        loop {
            if j == 0 {
                break;
            }
            let prev = u64_at(in ids, wrapping_sub(j, 1));
            let next = u64_at(in ids, j);
            if prev <= next {
                break;
            }
            let ok1 = ids.try_set(wrapping_sub(j, 1), next);
            let ok2 = ids.try_set(j, prev);
            j = wrapping_sub(j, 1);
        }
    }
}

// The fixed name `{prefix}{id}` and `{prefix}{id}_{suffix}`.
fn id_sym(inout builder: B, in prefix: Str, id: u64) -> u32 {
    decimal_sym(inout builder, in prefix, id)
}

fn id_sym2(inout builder: B, in prefix: Str, id: u64, suffix: u32) -> u32 {
    let base = decimal_sym(inout builder, in prefix, id);
    let mut spelling: ChunkSeq[u8] = ChunkSeq::new[u8]();
    builder.names.write(base, inout spelling);
    put(inout spelling, in "_");
    builder.names.write(suffix, inout spelling);
    sym_of(inout builder, in spelling)
}

fn id_num(inout builder: B, in prefix: Str, id: u64, i: u64) -> u32 {
    let mut spelling: ChunkSeq[u8] = ChunkSeq::new[u8]();
    put(inout spelling, in prefix);
    put_dec(inout spelling, id);
    put(inout spelling, in "_");
    put_dec(inout spelling, i);
    sym_of(inout builder, in spelling)
}

// `handler(expr_id, effect, state, body, ret, ops, out)`.
fn handler(
    inout builder: B,
    inout types: Types,
    in ctx: Y,
    inout gen: G,
    expr_id: u64,
    inout out: ChunkSeq[T]
) -> T {
    gen.counter = inc(gen.counter);
    let id = gen.counter;
    let parent = gen.monad;
    // the payload
    let eff = ctx.ast.xs(expr_id, 0);
    let label = ctx.ast.xs(expr_id, 1);
    let arg_count = ctx.ast.x(expr_id, 2);
    let key = ctx.ast.xs(expr_id, add(3, arg_count));
    let state_pat = ctx.ast.x(expr_id, add(4, arg_count));
    let state_expr = ctx.ast.x(expr_id, add(5, arg_count));
    let body = ctx.ast.x(expr_id, add(6, arg_count));
    let return_clause = clause_at(in ctx, expr_id, add(7, arg_count), false);
    let clause_count = ctx.ast.x(expr_id, return_clause.next);
    let ops_at = inc(return_clause.next);
    let mut o = ops_at;
    for i in 0..clause_count {
        o = clause_at(in ctx, expr_id, o, true).next;
    }
    let written_count = ctx.ast.x(expr_id, o);
    let written_at = inc(o);
    let routes_at = add(written_at, written_count);
    let stateful = state_pat != NONE;
    let body_type = type_of(in ctx, body);
    if body_type == NONE32 {
        builder.fail(in "handler body lacks a type");
        return unit(inout builder);
    }
    let handler_ty = type_of(in ctx, expr_id);
    if handler_ty == NONE32 {
        builder.fail(in "handler lacks an output type");
        return unit(inout builder);
    }
    let output = ty(inout builder, in types, in ctx, inout gen, handler_ty);
    let mut state_type = NONE32;
    if stateful {
        state_type = type_of(in ctx, state_expr);
    }
    if state_type == NONE32 {
        let none: ChunkSeq[u32] = ChunkSeq::new[u32]();
        state_type = types.tuple(in none);
    }
    let user = ty(inout builder, in types, in ctx, inout gen, state_type);
    let body_ty_term = ty(inout builder, in types, in ctx, inout gen, body_type);
    // the frame: written places in scope, by binding id
    let mut frame: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for i in 0..written_count {
        let n = ctx.ast.xs(expr_id, add(written_at, i));
        let local_index = gen.find(n);
        if local_index != NONE64 {
            frame.push(gen.local(local_index).id);
        }
    }
    sort_ids(inout frame);
    let mut frame_types = empty();
    for i in 0..frame.len() {
        let frame_id = u64_at(in frame, i);
        let mut slot_ty = NONE32;
        for j in 0..gen.scope.len() {
            let l = gen.local(j);
            if l.id == frame_id {
                slot_ty = l.ty;
            }
        }
        let ty_term = ty(inout builder, in types, in ctx, inout gen, slot_ty);
        frame_types.push(ty_term);
    }
    let frame_ty = product(inout builder, in frame_types);
    let mut state_parts = empty();
    state_parts.push(user);
    state_parts.push(frame_ty);
    let cps_state = product(inout builder, in state_parts);
    let mut answer_parts = empty();
    answer_parts.push(output);
    answer_parts.push(frame_ty);
    let answer = product(inout builder, in answer_parts);
    let cps_ref = named(inout builder, in "HandlerCPS");
    let child = app3(inout builder, cps_ref, cps_state, answer, parent);
    let mut initial = no_t();
    if stateful {
        initial = expr(inout builder, inout types, in ctx, inout gen, state_expr, inout out);
    } else {
        initial = unit(inout builder);
    }
    let mut frame_values = empty();
    for i in 0..frame.len() {
        let body_tmp = lref(inout builder, gen.cur(u64_at(in frame, i)));
        frame_values.push(body_tmp);
    }
    let frame0 = tuple(inout builder, in frame_values);
    let di = ctx.ast.eff_index(eff);
    if di == NONE {
        builder.fail(in "unknown Lean effect");
        return unit(inout builder);
    }
    let decl = ctx.ast.eff(di);
    // the instance: its arguments in the pool
    let arg_start = gen.inst_args.len();
    for i in 0..arg_count {
        gen.inst_args.push(ctx.ast.xt(expr_id, add(3, i)));
    }
    let inst = Inst {
        name: eff,
        label: label,
        arg_start: arg_start,
        arg_count: arg_count,
        key: key
    };
    let mut vars = vars_new();
    for i in 0..decl.gn {
        if i < arg_count {
            vars.set(ctx.ast.eff_generic(decl, i), gen.earg(inst, i));
        }
    }
    let mut args = empty();
    for i in 0..arg_count {
        let arg_ty = ty(inout builder, in types, in ctx, inout gen, gen.earg(inst, i));
        args.push(arg_ty);
    }
    let has_routes = routes(in types, in ctx, in gen, expr_id, routes_at);
    let mut statements = empty();
    let init_base = id_sym(inout builder, in "$init", id);
    let init = fresh(inout builder, inout gen, init_base);
    let_local(inout builder, inout statements, init, initial, true, user, false);
    let return_base = id_sym(inout builder, in "$return", id);
    let returned = fresh(inout builder, inout gen, return_base);
    let result_base = id_sym(inout builder, in "$result", id);
    let result_arg = fresh(inout builder, inout gen, result_base);
    let state_base = id_sym(inout builder, in "$state", id);
    let state_arg = fresh(inout builder, inout gen, state_base);
    // the return clause
    let saved = gen.save();
    gen.enter_clause();
    let mut clause = empty();
    capture_clause(inout builder, inout gen, in ctx, expr_id, return_clause, inout clause);
    let mut return_type = body_type;
    if stateful {
        let mut parts: ChunkSeq[u32] = ChunkSeq::new[u32]();
        parts.push(body_type);
        parts.push(state_type);
        return_type = types.tuple(in parts);
    }
    let mut return_value = no_t();
    if stateful {
        let result_arg_ref = lref(inout builder, result_arg);
        let state_ref = lref(inout builder, state_arg);
        let user_part = pair_get(inout builder, state_ref, 1);
        let mut return_parts = empty();
        return_parts.push(result_arg_ref);
        return_parts.push(user_part);
        return_value = tuple(inout builder, in return_parts);
    } else {
        return_value = lref(inout builder, result_arg);
    }
    bind_pattern(
        inout builder,
        inout types,
        in ctx,
        inout gen,
        clause_pat(in ctx, expr_id, return_clause, 0),
        return_type,
        return_value,
        inout clause
    );
    let return_output = expr(
        inout builder,
        inout types,
        in ctx,
        inout gen,
        return_clause.body,
        inout clause
    );
    let frame_state_ref = lref(inout builder, state_arg);
    let return_frame = pair_get(inout builder, frame_state_ref, 2);
    let mut ret_pair = empty();
    ret_pair.push(return_output);
    ret_pair.push(return_frame);
    let return_pair = tuple(inout builder, in ret_pair);
    let pure_return = pure(inout builder, return_pair);
    let rbody = sequence(inout builder, in clause, pure_return);
    let mut rnames: ChunkSeq[u32] = ChunkSeq::new[u32]();
    rnames.push(result_arg);
    rnames.push(state_arg);
    let return_fn = inferred(inout builder, in rnames, rbody);
    let mut rargs = empty();
    rargs.push(body_ty_term);
    rargs.push(cps_state);
    let return_answer = app1(inout builder, parent, answer);
    let return_fn_ty = arrows(inout builder, in rargs, return_answer);
    let_local(inout builder, inout statements, returned, return_fn, true, return_fn_ty, false);
    gen.restore(saved);
    // the operation clauses
    // This handler's operations, appended to `G::infos` as one range after
    // the clauses (a nested handler in a clause appends its own first).
    let mut own_infos: ChunkSeq[OpInfo] = ChunkSeq::new[OpInfo]();
    let mut fields = empty();
    let mut clause_offset = ops_at;
    for ci in 0..clause_count {
        let op_clause = clause_at(in ctx, expr_id, clause_offset, true);
        clause_offset = op_clause.next;
        let op_ordinal = op_index(in ctx, decl, op_clause.name);
        if op_ordinal == NONE {
            builder.fail(in "unknown Lean operation");
            return unit(inout builder);
        }
        let sig = ctx.ast.eff_op(decl, op_ordinal);
        let impl_base = id_sym2(inout builder, in "$impl", id, op_clause.name);
        let implementation = fresh(inout builder, inout gen, impl_base);
        let aliased_start = gen.index_pool.len();
        for i in 0..sig.param_count {
            if ctx.ast.op_param(sig, i).pass != TyPass::Sink {
                gen.index_pool.push(i);
            }
        }
        let aliased_count = wrapping_sub(gen.index_pool.len(), aliased_start);
        let mut index = sig.param_count;
        if stateful {
            index = inc(index);
        }
        let resume_pat = clause_pat(in ctx, expr_id, op_clause, index);
        let mut k_name = NONE32;
        if resume_pat != NONE && ctx.ast.pkind(resume_pat) == PK_BIND {
            k_name = ctx.ast.pxs(resume_pat, 0);
        }
        let mut alias_names: ChunkSeq[PPath] = ChunkSeq::new[PPath]();
        let mut scratch: ChunkSeq[u32] = ChunkSeq::new[u32]();
        for k in 0..aliased_count {
            let i = gen.ix(add(aliased_start, k));
            let param_ty = substitute(inout types, ctx.ast.op_param(sig, i).ty, in vars);
            let root: ChunkSeq[u32] = ChunkSeq::new[u32]();
            pattern_paths(
                inout builder,
                inout types,
                in ctx,
                clause_pat(in ctx, expr_id, op_clause, i),
                param_ty,
                in root,
                inout scratch,
                inout alias_names
            );
        }
        if builder.failed {
            return unit(inout builder);
        }
        let post_access = k_name != NONE32
            && post_resume_access(in ctx, expr_id, op_clause, k_name, in alias_names);
        if post_access && has_routes {
            let mut message: ChunkSeq[u8] = ChunkSeq::new[u8]();
            put(inout message, in "Lean extraction cannot track borrowed arguments of ");
            put_sym(inout builder, inout message, eff);
            put(inout message, in "::");
            put_sym(inout builder, inout message, op_clause.name);
            put(
                inout message,
                in " after resumption when the handled computation may perform it through a helper, callback, or closure"
            );
            fail_bytes(inout builder, in message);
            return unit(inout builder);
        }
        let value_type = op_value_type(inout builder, inout types, in ctx, inout gen, sig, in vars);
        let resume_base = id_sym(inout builder, in "$resume", id);
        let resume = fresh(inout builder, inout gen, resume_base);
        let st_base = id_sym(inout builder, in "$st", id);
        let st_var = fresh(inout builder, inout gen, st_base);
        let frame_base = id_sym(inout builder, in "$frame", id);
        let frame_var = fresh(inout builder, inout gen, frame_base);
        let saved2 = gen.save();
        gen.enter_clause();
        let mut clause_stmts = empty();
        let st_ref = lref(inout builder, st_var);
        let clause_frame = pair_get(inout builder, st_ref, 2);
        let none = unit(inout builder);
        let_local(inout builder, inout clause_stmts, frame_var, clause_frame, false, none, true);
        capture_clause(inout builder, inout gen, in ctx, expr_id, op_clause, inout clause_stmts);
        let mut parameters = empty();
        let mut lens_types = empty();
        let mut lens_names: ChunkSeq[u32] = ChunkSeq::new[u32]();
        let alias_start = gen.aliases.len();
        for i in 0..sig.param_count {
            let param = ctx.ast.op_param(sig, i);
            let param_ty = substitute(inout types, param.ty, in vars);
            let raw_base = id_num(inout builder, in "$op", id, i);
            let raw = fresh(inout builder, inout gen, raw_base);
            let param_term = ty(inout builder, in types, in ctx, inout gen, param_ty);
            let param_binder = explicit(inout builder, raw, param_term);
            parameters.push(param_binder);
            if param.pass == TyPass::Sink {
                let raw_ref = lref(inout builder, raw);
                bind_pattern(
                    inout builder,
                    inout types,
                    in ctx,
                    inout gen,
                    clause_pat(in ctx, expr_id, op_clause, i),
                    param_ty,
                    raw_ref,
                    inout clause_stmts
                );
                continue;
            }
            let lens_base = id_num(inout builder, in "$lens", id, i);
            let lens = fresh(inout builder, inout gen, lens_base);
            let get_value_ty = ty(inout builder, in types, in ctx, inout gen, param_ty);
            let get_ty = arrow(inout builder, frame_ty, get_value_ty);
            let set_value_ty = ty(inout builder, in types, in ctx, inout gen, param_ty);
            let mut setter_args = empty();
            setter_args.push(frame_ty);
            setter_args.push(set_value_ty);
            let set_ty = arrows(inout builder, in setter_args, frame_ty);
            let mut lens_parts = empty();
            lens_parts.push(get_ty);
            lens_parts.push(set_ty);
            let lens_pair_ty = product(inout builder, in lens_parts);
            let option_ty = global(inout builder, in "Option");
            let lens_ty = app1(inout builder, option_ty, lens_pair_ty);
            lens_types.push(lens_ty);
            lens_names.push(lens);
            let whole_base = id_num(inout builder, in "$arg", id, i);
            let whole = fresh(inout builder, inout gen, whole_base);
            let raw_ref = lref(inout builder, raw);
            let none2 = unit(inout builder);
            let_local(inout builder, inout clause_stmts, whole, raw_ref, false, none2, true);
            let mut arg_paths: ChunkSeq[PPath] = ChunkSeq::new[PPath]();
            let mut pool: ChunkSeq[u32] = ChunkSeq::new[u32]();
            let root: ChunkSeq[u32] = ChunkSeq::new[u32]();
            pattern_paths(
                inout builder,
                inout types,
                in ctx,
                clause_pat(in ctx, expr_id, op_clause, i),
                param_ty,
                in root,
                inout pool,
                inout arg_paths
            );
            if builder.failed {
                return unit(inout builder);
            }
            let bind_start = gen.alias_binds.len();
            for j in 0..arg_paths.len() {
                let alias_path = pp_at(in arg_paths, j);
                let lean = declare(inout builder, inout gen, alias_path.name, alias_path.ty);
                let mut path: ChunkSeq[u32] = ChunkSeq::new[u32]();
                for z in 0..alias_path.path_count {
                    path.push(u32_at(in pool, add(alias_path.path_start, z)));
                }
                let whole_ref = lref(inout builder, whole);
                let part_value = get_path(
                    inout builder,
                    inout types,
                    in ctx,
                    whole_ref,
                    param_ty,
                    in path,
                    0
                );
                let none3 = unit(inout builder);
                let_local(inout builder, inout clause_stmts, lean, part_value, false, none3, true);
                let bind_id = gen.local(gen.find(alias_path.name)).id;
                gen.clause_aliases.push(bind_id);
                let path_start = gen.paths.len();
                for z in 0..path.len() {
                    gen.paths.push(sym_at(in path, z));
                }
                gen.alias_binds
                    .push(ABind { id: bind_id, path_start: path_start, path_count: path.len() });
            }
            gen.aliases.push(Alias {
                lens: lens,
                raw: whole,
                ty: param_ty,
                pass: param.pass,
                bind_start: bind_start,
                bind_count: wrapping_sub(gen.alias_binds.len(), bind_start)
            });
        }
        let alias_count = wrapping_sub(gen.aliases.len(), alias_start);
        if stateful {
            let user_st_ref = lref(inout builder, st_var);
            let user_part = pair_get(inout builder, user_st_ref, 1);
            bind_pattern(
                inout builder,
                inout types,
                in ctx,
                inout gen,
                clause_pat(in ctx, expr_id, op_clause, sig.param_count),
                state_type,
                user_part,
                inout clause_stmts
            );
        }
        let fallback_ok = frame.len() == 0 && aliased_count == 0;
        if k_name != NONE32 {
            let mut fallback = NONE32;
            if fallback_ok {
                let fallback_fn = fresh(inout builder, inout gen, k_name);
                let result_subst = substitute(inout types, sig.result, in vars);
                let result_ty = ty(inout builder, in types, in ctx, inout gen, result_subst);
                let value_sym = builder.intern(in "$value");
                let mut binders = empty();
                let value_binder = explicit(inout builder, value_sym, result_ty);
                binders.push(value_binder);
                let mut user_value = no_t();
                if stateful {
                    let state_sym = builder.intern(in "$state");
                    let state_binder = explicit(inout builder, state_sym, user);
                    binders.push(state_binder);
                    user_value = named(inout builder, in "$state");
                } else {
                    user_value = unit(inout builder);
                }
                let resume_ref = lref(inout builder, resume);
                let value_ref = named(inout builder, in "$value");
                let resume_st_ref = lref(inout builder, st_var);
                let resume_frame = pair_get(inout builder, resume_st_ref, 2);
                let mut resume_parts = empty();
                resume_parts.push(user_value);
                resume_parts.push(resume_frame);
                let resume_arg = tuple(inout builder, in resume_parts);
                let resumed = app2(inout builder, resume_ref, value_ref, resume_arg);
                let mut stmts = empty();
                let result_sym = builder.intern(in "$r");
                let result_bind = p_bind(inout builder, result_sym);
                bind_pattern_stmt(inout builder, inout stmts, result_bind, resumed);
                let result_ref = named(inout builder, in "$r");
                let result_value = pair_get(inout builder, result_ref, 1);
                let pure_result = pure(inout builder, result_value);
                let fallback_body = sequence(inout builder, in stmts, pure_result);
                let parent_output = app1(inout builder, parent, output);
                let value = ascribe(inout builder, fallback_body, parent_output);
                let fallback_lambda = lambda(inout builder, in binders, value);
                let none4 = unit(inout builder);
                let_local(
                    inout builder,
                    inout clause_stmts,
                    fallback_fn,
                    fallback_lambda,
                    false,
                    none4,
                    false
                );
                fallback = fallback_fn;
            }
            gen.conts.push(Resumption {
                key: k_name,
                resume: resume,
                state: st_var,
                stateful: stateful,
                frame: frame_var,
                context: gen.context,
                depth: gen.layers.len(),
                alias_start: alias_start,
                alias_count: alias_count,
                fallback: fallback
            });
        }
        let clause_output = expr(
            inout builder,
            inout types,
            in ctx,
            inout gen,
            op_clause.body,
            inout clause_stmts
        );
        let output_tmp = temp(inout builder, inout gen);
        let_local(
            inout builder,
            inout clause_stmts,
            output_tmp,
            clause_output,
            true,
            output,
            false
        );
        for i in 0..alias_count {
            let alias = gen.alias(add(alias_start, i));
            if alias.pass == TyPass::Inout {
                let value = reconstruct(inout builder, inout types, in ctx, in gen, alias);
                let lens = lref(inout builder, alias.lens);
                let mut inner = empty();
                let wild_pat = p_wild(inout builder);
                inner.push(wild_pat);
                let set_sym = builder.intern(in "$set");
                let set_pat = p_bind(inout builder, set_sym);
                inner.push(set_pat);
                let tuple_pat = p_tuple(inout builder, in inner);
                let mut some_pats = empty();
                some_pats.push(tuple_pat);
                let some_pat = option_pattern(inout builder, true, in some_pats);
                let none_pats = empty();
                let none_pat = option_pattern(inout builder, false, in none_pats);
                let mut set_body = empty();
                let set_fn = named(inout builder, in "$set");
                let frame_ref = lref(inout builder, frame_var);
                let new_frame = app2(inout builder, set_fn, frame_ref, value);
                push_assign(inout builder, inout set_body, frame_var, new_frame);
                let none_body = empty();
                let stmt = match_stmt2(
                    inout builder,
                    lens,
                    some_pat,
                    in set_body,
                    none_pat,
                    in none_body
                );
                clause_stmts.push(stmt);
            }
        }
        let output_ref = lref(inout builder, output_tmp);
        let final_frame = lref(inout builder, frame_var);
        let mut final_parts = empty();
        final_parts.push(output_ref);
        final_parts.push(final_frame);
        let final_tuple = tuple(inout builder, in final_parts);
        let pure_final = pure(inout builder, final_tuple);
        let clause_body = sequence(inout builder, in clause_stmts, pure_final);
        gen.restore(saved2);
        let mut resume_args = empty();
        resume_args.push(value_type);
        resume_args.push(cps_state);
        let resume_answer = app1(inout builder, parent, answer);
        let resume_type = arrows(inout builder, in resume_args, resume_answer);
        let mut signature = empty();
        extend(inout signature, in lens_types);
        for i in 0..sig.param_count {
            let p = ctx.ast.op_param(sig, i);
            let op_param_ty = substitute(inout types, p.ty, in vars);
            let ty_term = ty(inout builder, in types, in ctx, inout gen, op_param_ty);
            signature.push(ty_term);
        }
        signature.push(resume_type);
        signature.push(cps_state);
        let mut binders = empty();
        for i in 0..lens_names.len() {
            let hole = infer(inout builder);
            let lens_binder = explicit(inout builder, sym_at(in lens_names, i), hole);
            binders.push(lens_binder);
        }
        extend(inout binders, in parameters);
        let resume_hole = infer(inout builder);
        let resume_binder = explicit(inout builder, resume, resume_hole);
        binders.push(resume_binder);
        let st_hole = infer(inout builder);
        let st_binder = explicit(inout builder, st_var, st_hole);
        binders.push(st_binder);
        let impl_lambda = lambda(inout builder, in binders, clause_body);
        let impl_answer = app1(inout builder, parent, answer);
        let sig_ty = arrows(inout builder, in signature, impl_answer);
        let_local(
            inout builder,
            inout statements,
            implementation,
            impl_lambda,
            true,
            sig_ty,
            false
        );
        let impl_ref = lref(inout builder, implementation);
        let mut nones = empty();
        for i in 0..lens_names.len() {
            let none_lens = global2(inout builder, in "Option", in "none");
            nones.push(none_lens);
        }
        let impl_value = app(inout builder, impl_ref, in nones);
        let dict_field = record_field(inout builder, op_clause.name, impl_value);
        fields.push(dict_field);
        own_infos.push(OpInfo {
            name: op_clause.name,
            implementation: implementation,
            aliased_start: aliased_start,
            aliased_count: aliased_count,
            post_access: post_access
        });
    }
    let op_start = gen.infos.len();
    for i in 0..own_infos.len() {
        match own_infos.try_get(i) {
            Option::Some(o) => gen.infos.push(o),
            Option::None => {},
        }
    }
    let op_count = own_infos.len();
    let dict_base = id_sym(inout builder, in "$handler", id);
    let dictionary = fresh(inout builder, inout gen, dict_base);
    let effect_sym = builder.joined(in "Effect_", eff, in "");
    let effect_ref = sref(inout builder, effect_sym);
    let mut dict_args = empty();
    extend(inout dict_args, in args);
    dict_args.push(child);
    let dictionary_type = app(inout builder, effect_ref, in dict_args);
    let dict_value = record(inout builder, in fields);
    let_local(
        inout builder,
        inout statements,
        dictionary,
        dict_value,
        true,
        dictionary_type,
        false
    );
    let dict_ref = lref(inout builder, dictionary);
    let instance_stmt = let_instance(inout builder, dictionary_type, dict_ref);
    statements.push(instance_stmt);
    let body_base = id_sym(inout builder, in "$body", id);
    let computation = fresh(inout builder, inout gen, body_base);
    // the handled computation
    let saved3 = gen.save();
    gen.new_context();
    let frame_start = gen.index_pool.len();
    for i in 0..frame.len() {
        gen.index_pool.push(u64_at(in frame, i));
    }
    gen.layers.push(Layer {
        state: cps_state,
        output: answer,
        base: parent,
        child: child,
        inst: inst,
        fa: frame_start,
        fz: frame.len(),
        frame_ty: frame_ty,
        op_start: op_start,
        op_count: op_count,
        closures: gen.closures
    });
    let index = wrapping_sub(gen.layers.len(), 1);
    gen.body_layers.push(index);
    gen.monad = child;
    gen.monad_id = false;
    gen.unlabeled.push(Cap { key: eff, removed: true, inst: no_inst(), term: no_t(), depth: 0 });
    gen.clear_clause_aliases();
    gen.alias_written = false;
    if label != NONE32 {
        let dict_term = lref(inout builder, dictionary);
        gen.caps.push(Cap {
            key: label,
            removed: false,
            inst: inst,
            term: dict_term,
            depth: gen.layers.len()
        });
    }
    let mut body_statements = empty();
    for i in 0..frame.len() {
        let copied = copy_binding(
            inout builder,
            inout gen,
            u64_at(in frame, i),
            inout body_statements
        );
    }
    let body_value = expr(
        inout builder,
        inout types,
        in ctx,
        inout gen,
        body,
        inout body_statements
    );
    let body_tmp = temp(inout builder, inout gen);
    let_local(
        inout builder,
        inout body_statements,
        body_tmp,
        body_value,
        true,
        body_ty_term,
        false
    );
    sync(inout builder, in gen, inout body_statements);
    sync_caller(inout builder, in gen, inout body_statements);
    let body_ref = lref(inout builder, body_tmp);
    let pure_body = pure(inout builder, body_ref);
    let computation_body = sequence(inout builder, in body_statements, pure_body);
    gen.layers.truncate(index);
    gen.restore(saved3);
    let computation_ty = app1(inout builder, child, body_ty_term);
    let_local(
        inout builder,
        inout statements,
        computation,
        computation_body,
        true,
        computation_ty,
        false
    );
    let computation_ref = lref(inout builder, computation);
    let return_ref = lref(inout builder, returned);
    let init_ref = lref(inout builder, init);
    let mut init_parts = empty();
    init_parts.push(init_ref);
    init_parts.push(frame0);
    let init_pair = tuple(inout builder, in init_parts);
    let call = app2(inout builder, computation_ref, return_ref, init_pair);
    let handled = sequence(inout builder, in statements, call);
    let handled_value = action(inout builder, inout gen, handled, inout out);
    for slot in 0..frame.len() {
        let frame_tuple = pair_get(inout builder, handled_value, 2);
        let slot_value = tuple_get(inout builder, frame_tuple, slot, frame.len());
        push_assign(inout builder, inout out, gen.cur(u64_at(in frame, slot)), slot_value);
    }
    pair_get(inout builder, handled_value, 1)
}

// ----- closures ------------------------------------------------------------------

fn closure(
    inout builder: B,
    inout types: Types,
    in ctx: Y,
    inout gen: G,
    expr_id: u64,
    inout out: ChunkSeq[T]
) -> T {
    let fn_ty = ctx.ast.xt(expr_id, 0);
    if fn_ty == NONE32 || types.node(fn_ty).kind != TyKind::Fn {
        builder.fail(in "closure lacks its checked arrow type");
        return unit(inout builder);
    }
    let fnode = types.node(fn_ty);
    let row = types.row(fnode.r2);
    let effectful = row.n > 0 || row.tail != 0;
    let param_count = ctx.ast.x(expr_id, 1);
    let body = ctx.ast.x(expr_id, add(2, param_count));
    let free_count = ctx.ast.x(expr_id, add(3, param_count));
    let declared = ctx.ast.xt(expr_id, add(4, add(param_count, free_count)));
    let mut captures: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..free_count {
        let free_name = ctx.ast.xs(expr_id, add(4, add(param_count, i)));
        if gen.has(free_name) {
            captures.push(free_name);
        }
    }
    let mut snapshot: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..captures.len() {
        let capture_name = sym_at(in captures, i);
        let base = joined(inout builder, in "$capture_", capture_name, in "");
        let snapshot_sym = fresh(inout builder, inout gen, base);
        let captured_value = var(inout builder, in gen, capture_name);
        let none = unit(inout builder);
        let_local(inout builder, inout out, snapshot_sym, captured_value, false, none, false);
        snapshot.push(snapshot_sym);
    }
    // the saved scope's ids of the captures
    let mut ids: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for i in 0..captures.len() {
        ids.push(gen.local(gen.find(sym_at(in captures, i))).id);
    }
    let saved = gen.save();
    gen.new_context();
    gen.own_sync = false;
    gen.clear_body_layers();
    gen.closures = inc(gen.closures);
    // labeled instances of the declared and checked rows bind their
    // effects' unlabeled operations to the label's capability
    let mut rows: ChunkSeq[u32] = ChunkSeq::new[u32]();
    if declared != NONE32 {
        rows.push(types.node(declared).r2);
    }
    rows.push(fnode.r2);
    for row_index in 0..rows.len() {
        let effect_row = types.row(sym_at(in rows, row_index));
        for k in 0..w(effect_row.n) {
            let entry = types.effect_at(add(w(effect_row.a), k));
            if entry.label != 0 {
                let cap = gen.cap(wrapping_sub(entry.label, 1));
                if !cap.removed {
                    gen.unlabeled.push(Cap {
                        key: entry.name,
                        removed: false,
                        inst: cap.inst,
                        term: cap.term,
                        depth: cap.depth
                    });
                }
            }
        }
    }
    gen.clear_clause_aliases();
    gen.alias_written = false;
    if !effectful {
        gen.monad = global(inout builder, in "Id");
        gen.monad_id = true;
    }
    let mut arg_names: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut arguments = empty();
    let pcount = if param_count < w(fnode.n) {
        param_count
    } else {
        w(fnode.n)
    };
    for i in 0..pcount {
        let pname = ctx.ast.xs(expr_id, add(2, i));
        let base = joined(inout builder, in "", pname, in "$a");
        let arg_sym = fresh(inout builder, inout gen, base);
        let param_term = ty(inout builder, in types, in ctx, inout gen, types.arg(fn_ty, i));
        let binder = explicit(inout builder, arg_sym, param_term);
        arguments.push(binder);
        arg_names.push(arg_sym);
    }
    if arguments.len() == 0 {
        let unit_ty = global(inout builder, in "Unit");
        let binder = anonymous(inout builder, B_EXPLICIT, unit_ty);
        arguments.push(binder);
    }
    let mut stmts = empty();
    for i in 0..captures.len() {
        let capture_name = sym_at(in captures, i);
        let lean = fresh(inout builder, inout gen, capture_name);
        let snapshot_ref = lref(inout builder, sym_at(in snapshot, i));
        let none = unit(inout builder);
        let_local(inout builder, inout stmts, lean, snapshot_ref, false, none, true);
        gen.set_cur(ids.try_get(i).unwrap_or(0), lean);
    }
    for i in 0..pcount {
        let pname = ctx.ast.xs(expr_id, add(2, i));
        let lean = declare(inout builder, inout gen, pname, types.arg(fn_ty, i));
        let arg_ref = lref(inout builder, sym_at(in arg_names, i));
        let none = unit(inout builder);
        let_local(inout builder, inout stmts, lean, arg_ref, false, none, true);
    }
    let value = expr(inout builder, inout types, in ctx, inout gen, body, inout stmts);
    let result_tmp = temp(inout builder, inout gen);
    let result_ty = ty(inout builder, in types, in ctx, inout gen, fnode.r);
    let_local(inout builder, inout stmts, result_tmp, value, true, result_ty, false);
    let mut results = empty();
    let result_ref = lref(inout builder, result_tmp);
    results.push(result_ref);
    for i in 0..pcount {
        if widen_u64(types.param_pass(fn_ty, i)) == TyPass::Inout {
            let inout_value = var(inout builder, in gen, ctx.ast.xs(expr_id, add(2, i)));
            results.push(inout_value);
        }
    }
    let results_tuple = tuple(inout builder, in results);
    let pure_results = pure(inout builder, results_tuple);
    let body_action = sequence(inout builder, in stmts, pure_results);
    gen.restore(saved);
    let tmp = temp(inout builder, inout gen);
    let run = if effectful {
        body_action
    } else {
        gapp1(inout builder, in "Id", in "run", body_action)
    };
    let lam = lambda(inout builder, in arguments, run);
    let none = unit(inout builder);
    let_local(inout builder, inout out, tmp, lam, false, none, false);
    lref(inout builder, tmp)
}

// ----- functions -----------------------------------------------------------------

// `Generator::function(f)` as a module of one `partial def` declaration
// (no imports), over the ambient monad `m` when `func` is polymorphic and
// over `Id` otherwise.
pub fn function(
    inout builder: B,
    inout types: Types,
    in ctx: Y,
    inout gen: G,
    func_index: u64
) -> T {
    let func = ctx.ast.function(func_index);
    let sig_index = ctx.env.fns.find(func.name);
    let sig = ctx.env.fns.sig(w(sig_index));
    // A fuel companion is always over `m` (`Generator::new(world, m)`).
    let polymorphic = func.polymorphic || gen.fuel;
    if polymorphic {
        gen.monad = named(inout builder, in "m");
        gen.monad_id = false;
    } else {
        gen.monad = global(inout builder, in "Id");
        gen.monad_id = true;
    }
    let effectful = callee_effectful(in types, in ctx, in gen, func_index);
    let mut binders = empty();
    for i in 0..sig.gn {
        let generic = ctx.env.fns.generic(sig, i);
        if !generic.row {
            builder.check(generic.name, in "identifier");
            let mark = builder.at();
            builder.type0();
            let sort_term = builder.since(mark);
            let bd = binder_sym(inout builder, B_IMPLICIT, generic.name, sort_term);
            binders.push(bd);
        }
    }
    if polymorphic {
        let mark = builder.at();
        builder.implicit_type_m();
        binders.push(builder.since(mark));
        let instance_mark = builder.at();
        builder.monad_instance();
        binders.push(builder.since(instance_mark));
        // `f$fuel`: `[VesperDiverge m] ($fuel : Nat)` after the first instance
        if gen.in_family(func.name) {
            let diverge_sym = builder.intern(in "VesperDiverge");
            let diverge_ref = sref(inout builder, diverge_sym);
            let monad_ref = named(inout builder, in "m");
            let diverge_ty = app1(inout builder, diverge_ref, monad_ref);
            let diverge_inst = anonymous(inout builder, B_INSTANCE, diverge_ty);
            binders.push(diverge_inst);
            let fuel_sym = builder.intern(in FUEL);
            let nat = global(inout builder, in "Nat");
            let fuel_binder = explicit(inout builder, fuel_sym, nat);
            binders.push(fuel_binder);
        }
        let reqs = requirements(in types, in ctx, func_index);
        for index in 0..reqs.len() {
            let variable = builder.numbered(in "$cap", index);
            let inst = inst_of_node(in types, inout gen, u64_at(in reqs, index));
            if inst.label != NONE32 {
                let cap_ref = lref(inout builder, variable);
                gen.caps.push(Cap {
                    key: inst.label,
                    removed: false,
                    inst: inst,
                    term: cap_ref,
                    depth: 0
                });
            }
            let mut targs = empty();
            for j in 0..inst.arg_count {
                let arg_ty = ty_plain(inout builder, in types, in ctx, gen.earg(inst, j));
                targs.push(arg_ty);
            }
            let effect_sym = builder.joined(in "Effect_", inst.name, in "");
            let effect_ref = sref(inout builder, effect_sym);
            let monad_ref = named(inout builder, in "m");
            targs.push(monad_ref);
            let cap_ty = app(inout builder, effect_ref, in targs);
            let bd = binder_sym(inout builder, B_INSTANCE, variable, cap_ty);
            binders.push(bd);
        }
    }
    for i in 0..func.param_count {
        let param_name = ctx.ast.param_name(func, i);
        builder.check(param_name, in "identifier");
        let param_term = ty(inout builder, in types, in ctx, inout gen, ctx.ast.param_ty(func, i));
        let bd = explicit(inout builder, param_name, param_term);
        binders.push(bd);
        gen.mark_used(param_name);
    }
    let sync = polymorphic && takes_sync(in types, in ctx, func_index);
    if sync {
        let mut states = empty();
        for i in 0..func.param_count {
            if ctx.ast.param_pass(func, i) == TyPass::Inout {
                let param_term = ty(
                    inout builder,
                    in types,
                    in ctx,
                    inout gen,
                    ctx.ast.param_ty(func, i)
                );
                states.push(param_term);
            }
        }
        let states_ty = product(inout builder, in states);
        let monad_ref = named(inout builder, in "m");
        let unit_ty = global(inout builder, in "Unit");
        let monad_unit = app1(inout builder, monad_ref, unit_ty);
        let sync_arrow = arrow(inout builder, states_ty, monad_unit);
        let ignored_sym = builder.intern(in "$ignored");
        let mut ignored_names: ChunkSeq[u32] = ChunkSeq::new[u32]();
        ignored_names.push(ignored_sym);
        let unit_value = unit(inout builder);
        let pure_unit = pure(inout builder, unit_value);
        let default_sync = inferred(inout builder, in ignored_names, pure_unit);
        let opt_param_ref = global(inout builder, in "optParam");
        let sync_param_ty = app2(inout builder, opt_param_ref, sync_arrow, default_sync);
        let sync_sym = builder.intern(in SYNC);
        let bd = explicit(inout builder, sync_sym, sync_param_ty);
        binders.push(bd);
    }
    let mut results = empty();
    let value_ty = ty(inout builder, in types, in ctx, inout gen, func.result);
    results.push(value_ty);
    for i in 0..func.param_count {
        if ctx.ast.param_pass(func, i) == TyPass::Inout {
            let param_term = ty(
                inout builder,
                in types,
                in ctx,
                inout gen,
                ctx.ast.param_ty(func, i)
            );
            results.push(param_term);
        }
    }
    let mut result = product(inout builder, in results);
    if effectful {
        let monad_ref = named(inout builder, in "m");
        result = app1(inout builder, monad_ref, result);
    }
    let mut out = empty();
    for i in 0..func.param_count {
        let param_name = ctx.ast.param_name(func, i);
        let param_ref = lref(inout builder, param_name);
        let none = unit(inout builder);
        let_local(inout builder, inout out, param_name, param_ref, false, none, true);
        let id = declare_as(inout gen, param_name, ctx.ast.param_ty(func, i), param_name);
    }
    if sync {
        gen.own_sync = true;
        gen.own_sync_start = gen.index_pool.len();
        for i in 0..func.param_count {
            if ctx.ast.param_pass(func, i) == TyPass::Inout {
                let local_index = gen.find(ctx.ast.param_name(func, i));
                gen.index_pool.push(gen.local(local_index).id);
            }
        }
        gen.own_sync_count = wrapping_sub(gen.index_pool.len(), gen.own_sync_start);
    }
    if func.body == NONE {
        builder.fail(in "missing function body");
    }
    let term = expr(inout builder, inout types, in ctx, inout gen, func.body, inout out);
    let result_tmp = temp(inout builder, inout gen);
    let result_ty = ty(inout builder, in types, in ctx, inout gen, func.result);
    let_local(inout builder, inout out, result_tmp, term, true, result_ty, false);
    let mut values = empty();
    let result_ref = lref(inout builder, result_tmp);
    values.push(result_ref);
    for i in 0..func.param_count {
        if ctx.ast.param_pass(func, i) == TyPass::Inout {
            let inout_value = var(inout builder, in gen, ctx.ast.param_name(func, i));
            values.push(inout_value);
        }
    }
    let values_tuple = tuple(inout builder, in values);
    let pure_values = pure(inout builder, values_tuple);
    let body0 = sequence(inout builder, in out, pure_values);
    let mut body = if effectful {
        body0
    } else {
        gapp1(inout builder, in "Id", in "run", body0)
    };
    let fuel = gen.in_family(func.name);
    if fuel {
        // structurally recursive on `$fuel`; running out is `VesperDiverge`
        let scrutinee = named(inout builder, in FUEL);
        let zero = p_nat(inout builder, in "0");
        let diverge_mark = builder.at();
        builder.w(T_REF);
        builder.w(0);
        builder.w(2);
        builder.text(in "VesperDiverge");
        builder.text(in "diverge");
        let diverge = builder.since(diverge_mark);
        let zero_arm = arm(inout builder, zero, diverge);
        let succ = rooted2(inout builder, in "Nat", in "succ");
        let fuel_sym = builder.intern(in FUEL);
        let fuel_bind = p_bind(inout builder, fuel_sym);
        let mut succ_pats = empty();
        succ_pats.push(fuel_bind);
        let succ_pat = p_ctor(inout builder, succ, in succ_pats);
        let succ_arm = arm(inout builder, succ_pat, body);
        let mut arms = empty();
        arms.push(zero_arm);
        arms.push(succ_arm);
        body = match_term(inout builder, scrutinee, in arms);
    }
    // the declaration: imports 0, one declaration
    let mark = builder.at();
    builder.w(0);
    builder.w(1);
    builder.w(D_DEF);
    if fuel {
        builder.w(K_DEF);
        let fname = builder.joined(in "", func.name, in FUEL);
        builder.name(fname);
    } else {
        builder.w(K_PARTIAL);
        builder.name(func.name);
    }
    builder.w(binders.len());
    for i in 0..binders.len() {
        builder.put(get(in binders, i));
    }
    builder.put(result);
    builder.put(body);
    builder.since(mark)
}
