// Lean terms as word ranges of the builder (`T`), for the structured
// extractor (part 3): it composes terms out of order (`sequence`,
// `ascribe`, buffered operands), so each helper writes a node whose
// children are copies of earlier ranges. The helpers mirror the
// constructors src/lean.rs uses (`app`, `pure`, `sequence`, `let_local`,
// `bind_local`, `tuple_get`, ...); identifier checks happen where Rust
// calls `ident`/`source_name`.

use self::build::{
    B, B_EXPLICIT, P_BIND, P_NAT, P_CTOR, P_TUPLE, P_WILD, S_ASSIGN, S_BIND, S_BIND_TYPED, S_EXPR,
    S_IF, S_LET, T, T_APP, T_ARROW, T_ASCRIBE, T_BINARY, T_DO, T_ELIMINATE, T_FUN, T_IF, T_INFER,
    T_MATCH, T_NAT, T_PRODUCT, T_PROJECT, T_REF, T_TUPLE, T_UNARY, T_UPDATE, T_RECORD
};

pub fn empty() -> ChunkSeq[T] {
    ChunkSeq::new[T]()
}

fn t_at(in ts: ChunkSeq[T], i: u64) -> T {
    match ts.try_get(i) {
        Option::Some(term) => term,
        Option::None => T { a: 0, n: 0 },
    }
}

pub fn get(in ts: ChunkSeq[T], i: u64) -> T {
    t_at(in ts, i)
}

fn put_all(inout builder: B, in ts: ChunkSeq[T]) {
    for i in 0..ts.len() {
        builder.put(t_at(in ts, i));
    }
}

// `reference(&ident)`: an unrooted one-component name of a checked local.
pub fn lref(inout builder: B, sym: u32) -> T {
    let mark = builder.at();
    builder.w(T_REF);
    builder.w(0);
    builder.w(1);
    builder.sym(sym);
    builder.since(mark)
}

// `source_ref(sym)`.
pub fn sref(inout builder: B, sym: u32) -> T {
    let mark = builder.at();
    builder.sref(sym);
    builder.since(mark)
}

// `named(text)`: a fixed unrooted reference.
pub fn named(inout builder: B, in text: Str) -> T {
    let mark = builder.at();
    builder.named(in text);
    builder.since(mark)
}

pub fn global(inout builder: B, in name: Str) -> T {
    let mark = builder.at();
    builder.global(in name);
    builder.since(mark)
}

pub fn global2(inout builder: B, in namespace: Str, in member: Str) -> T {
    let mark = builder.at();
    builder.global2(in namespace, in member);
    builder.since(mark)
}

// `unit()`: `Unit.unit`.
pub fn unit(inout builder: B) -> T {
    global2(inout builder, in "Unit", in "unit")
}

pub fn infer(inout builder: B) -> T {
    let mark = builder.at();
    builder.w(T_INFER);
    builder.since(mark)
}

pub fn nat(inout builder: B, in digits: Str) -> T {
    let mark = builder.at();
    builder.nat(in digits);
    builder.since(mark)
}

// A natural number literal of `value`.
pub fn nat_u64(inout builder: B, value: u64) -> T {
    let mut digits: ChunkSeq[u8] = ChunkSeq::new[u8]();
    put_decimal_u64(inout digits, value);
    let sym = builder.names.intern(in digits.as_slice());
    let mark = builder.at();
    builder.w(T_NAT);
    builder.sym(sym);
    builder.since(mark)
}

fn put_decimal_u64(inout out: ChunkSeq[u8], value: u64) {
    if value >= 10 {
        put_decimal_u64(inout out, value / 10);
    }
    out.push(wrapping_u8(wrapping_add(value % 10, 48)));
}

// A positional argument.
pub fn pos(inout builder: B, value: T) -> T {
    let mark = builder.at();
    builder.w(0);
    builder.put(value);
    builder.since(mark)
}

// A named argument `(sym := value)` with a checked source identifier.
pub fn named_arg_sym(inout builder: B, sym: u32, value: T) -> T {
    let mark = builder.at();
    builder.w(1);
    builder.ident(sym);
    builder.put(value);
    builder.since(mark)
}

// A named argument with a fixed name.
pub fn named_arg(inout builder: B, in name: Str, value: T) -> T {
    let mark = builder.at();
    builder.w(1);
    builder.text(in name);
    builder.put(value);
    builder.since(mark)
}

// `Term::App` over encoded arguments (`pos`, `named_arg`).
pub fn app_args(inout builder: B, func: T, in args: ChunkSeq[T]) -> T {
    let mark = builder.at();
    builder.w(T_APP);
    builder.w(args.len());
    builder.w(func.n);
    builder.put(func);
    put_all(inout builder, in args);
    builder.since(mark)
}

// `app(func, args)`.
pub fn app(inout builder: B, func: T, in args: ChunkSeq[T]) -> T {
    let mark = builder.at();
    builder.w(T_APP);
    builder.w(args.len());
    builder.w(func.n);
    builder.put(func);
    for i in 0..args.len() {
        builder.w(0);
        builder.put(t_at(in args, i));
    }
    builder.since(mark)
}

pub fn app1(inout builder: B, func: T, arg: T) -> T {
    let mut args = empty();
    args.push(arg);
    app(inout builder, func, in args)
}

pub fn app2(inout builder: B, func: T, first: T, second: T) -> T {
    let mut args = empty();
    args.push(first);
    args.push(second);
    app(inout builder, func, in args)
}

pub fn app3(inout builder: B, func: T, first: T, second: T, third: T) -> T {
    let mut args = empty();
    args.push(first);
    args.push(second);
    args.push(third);
    app(inout builder, func, in args)
}

// `app(global(&[namespace, member]), [arg])`.
pub fn gapp1(inout builder: B, in namespace: Str, in member: Str, arg: T) -> T {
    let func = global2(inout builder, in namespace, in member);
    app1(inout builder, func, arg)
}

pub fn gapp2(inout builder: B, in namespace: Str, in member: Str, first: T, second: T) -> T {
    let func = global2(inout builder, in namespace, in member);
    app2(inout builder, func, first, second)
}

pub fn gapp3(
    inout builder: B,
    in namespace: Str,
    in member: Str,
    first: T,
    second: T,
    third: T
) -> T {
    let func = global2(inout builder, in namespace, in member);
    app3(inout builder, func, first, second, third)
}

// `pure(value)`.
pub fn pure(inout builder: B, value: T) -> T {
    gapp1(inout builder, in "Pure", in "pure", value)
}

pub fn binary(inout builder: B, op: u64, lhs: T, rhs: T) -> T {
    let mark = builder.at();
    builder.w(T_BINARY);
    builder.w(op);
    builder.put(lhs);
    builder.put(rhs);
    builder.since(mark)
}

pub fn unary(inout builder: B, op: u64, operand: T) -> T {
    let mark = builder.at();
    builder.w(T_UNARY);
    builder.w(op);
    builder.put(operand);
    builder.since(mark)
}

pub fn ite(inout builder: B, condition: T, yes: T, no: T) -> T {
    let mark = builder.at();
    builder.w(T_IF);
    builder.put(condition);
    builder.put(yes);
    builder.put(no);
    builder.since(mark)
}

pub fn ascribe(inout builder: B, value: T, ty: T) -> T {
    let mark = builder.at();
    builder.w(T_ASCRIBE);
    builder.put(value);
    builder.put(ty);
    builder.since(mark)
}

pub fn eliminate(inout builder: B, value: T) -> T {
    let mark = builder.at();
    builder.w(T_ELIMINATE);
    builder.put(value);
    builder.since(mark)
}

// `Term::Do`.
pub fn sequence(inout builder: B, in ss: ChunkSeq[T], result: T) -> T {
    let mark = builder.at();
    builder.w(T_DO);
    builder.w(ss.len());
    put_all(inout builder, in ss);
    builder.put(result);
    builder.since(mark)
}

// `Term::Match` over encoded arms (`arm`).
pub fn match_term(inout builder: B, scrutinee: T, in arms: ChunkSeq[T]) -> T {
    let mark = builder.at();
    builder.w(T_MATCH);
    builder.w(arms.len());
    builder.put(scrutinee);
    put_all(inout builder, in arms);
    builder.since(mark)
}

pub fn arm(inout builder: B, pattern: T, body: T) -> T {
    let mark = builder.at();
    builder.put(pattern);
    builder.put(body);
    builder.since(mark)
}

// `Term::Project` with a field: `project(base, field)` checks the field.
pub fn project(inout builder: B, base: T, field: u32) -> T {
    let mark = builder.at();
    builder.w(T_PROJECT);
    builder.put(base);
    builder.w(0);
    builder.ident(field);
    builder.since(mark)
}

// A fixed field projection (`lean_nodes::project`).
pub fn project_fixed(inout builder: B, base: T, in field: Str) -> T {
    let mark = builder.at();
    builder.w(T_PROJECT);
    builder.put(base);
    builder.w(0);
    builder.text(in field);
    builder.since(mark)
}

// `pair_get(base, k)`.
pub fn pair_get(inout builder: B, base: T, k: u64) -> T {
    let mark = builder.at();
    builder.w(T_PROJECT);
    builder.put(base);
    builder.w(1);
    builder.w(k);
    builder.since(mark)
}

// `tuple_get(tuple_term, i, n)`.
pub fn tuple_get(inout builder: B, tuple_term: T, i: u64, n: u64) -> T {
    if n <= 1 {
        return tuple_term;
    }
    let mut part = tuple_term;
    for k in 0..i {
        part = pair_get(inout builder, part, 2);
    }
    if wrapping_add(i, 1) < n {
        part = pair_get(inout builder, part, 1);
    }
    part
}

// `lean_nodes::tuple`.
pub fn tuple(inout builder: B, in ts: ChunkSeq[T]) -> T {
    if ts.len() == 0 {
        return unit(inout builder);
    }
    if ts.len() == 1 {
        return t_at(in ts, 0);
    }
    let mark = builder.at();
    builder.w(T_TUPLE);
    builder.w(ts.len());
    put_all(inout builder, in ts);
    builder.since(mark)
}

// `lean_nodes::product`.
pub fn product(inout builder: B, in ts: ChunkSeq[T]) -> T {
    if ts.len() == 0 {
        return global(inout builder, in "Unit");
    }
    if ts.len() == 1 {
        return t_at(in ts, 0);
    }
    let mark = builder.at();
    builder.w(T_PRODUCT);
    builder.w(ts.len());
    put_all(inout builder, in ts);
    builder.since(mark)
}

// `Term::Record` over encoded fields (`field`).
pub fn record(inout builder: B, in fs: ChunkSeq[T]) -> T {
    let mark = builder.at();
    builder.w(T_RECORD);
    builder.w(fs.len());
    put_all(inout builder, in fs);
    builder.since(mark)
}

pub fn update(inout builder: B, base: T, in fs: ChunkSeq[T]) -> T {
    let mark = builder.at();
    builder.w(T_UPDATE);
    builder.w(fs.len());
    builder.put(base);
    put_all(inout builder, in fs);
    builder.since(mark)
}

// A record field `name := value` (checked).
pub fn field(inout builder: B, name: u32, value: T) -> T {
    let mark = builder.at();
    builder.ident(name);
    builder.put(value);
    builder.since(mark)
}

// Binders: an explicit binder with a checked local (`explicit`).
pub fn explicit(inout builder: B, name: u32, ty: T) -> T {
    let mark = builder.at();
    builder.w(B_EXPLICIT);
    builder.w(1);
    builder.sym(name);
    builder.put(ty);
    builder.since(mark)
}

// An anonymous binder of kind `kind`.
pub fn anonymous(inout builder: B, kind: u64, ty: T) -> T {
    let mark = builder.at();
    builder.w(kind);
    builder.w(0);
    builder.put(ty);
    builder.since(mark)
}

pub fn binder_sym(inout builder: B, kind: u64, name: u32, ty: T) -> T {
    let mark = builder.at();
    builder.w(kind);
    builder.w(1);
    builder.sym(name);
    builder.put(ty);
    builder.since(mark)
}

pub fn lambda(inout builder: B, in binders: ChunkSeq[T], body: T) -> T {
    let mark = builder.at();
    builder.w(T_FUN);
    builder.w(binders.len());
    put_all(inout builder, in binders);
    builder.put(body);
    builder.since(mark)
}

// Patterns.
pub fn p_wild(inout builder: B) -> T {
    let mark = builder.at();
    builder.w(P_WILD);
    builder.since(mark)
}

// `Pattern::Nat` of decimal text `digits`.
pub fn p_nat(inout builder: B, in digits: Str) -> T {
    let mark = builder.at();
    builder.w(P_NAT);
    builder.text(in digits);
    builder.since(mark)
}

pub fn p_bind(inout builder: B, sym: u32) -> T {
    let mark = builder.at();
    builder.w(P_BIND);
    builder.sym(sym);
    builder.since(mark)
}

pub fn p_tuple(inout builder: B, in ps: ChunkSeq[T]) -> T {
    let mark = builder.at();
    builder.w(P_TUPLE);
    builder.w(ps.len());
    put_all(inout builder, in ps);
    builder.since(mark)
}

// A constructor pattern; `name` is an encoded name (`name_range`).
pub fn p_ctor(inout builder: B, name: T, in ps: ChunkSeq[T]) -> T {
    let mark = builder.at();
    builder.w(P_CTOR);
    builder.put(name);
    builder.w(ps.len());
    put_all(inout builder, in ps);
    builder.since(mark)
}

// A fixed rooted two-component name (`fixed_name(&[namespace, member]).rooted()`).
pub fn rooted2(inout builder: B, in namespace: Str, in member: Str) -> T {
    let mark = builder.at();
    builder.w(1);
    builder.w(2);
    builder.text(in namespace);
    builder.text(in member);
    builder.since(mark)
}

// Statements (`DoStatement`).
pub fn let_local(
    inout builder: B,
    inout out: ChunkSeq[T],
    name: u32,
    value: T,
    has_ty: bool,
    ty: T,
    mutable: bool
) {
    let mark = builder.at();
    builder.w(S_LET);
    builder.w(if mutable { 1 } else { 0 });
    builder.w(P_BIND);
    builder.sym(name);
    if has_ty {
        builder.w(1);
        builder.put(ty);
    } else {
        builder.w(0);
    }
    builder.put(value);
    out.push(builder.since(mark));
}

// `let pattern := value` (immutable, untyped).
pub fn let_pattern(inout builder: B, inout out: ChunkSeq[T], pattern: T, value: T) {
    let mark = builder.at();
    builder.w(S_LET);
    builder.w(0);
    builder.put(pattern);
    builder.w(0);
    builder.put(value);
    out.push(builder.since(mark));
}

pub fn bind_local(
    inout builder: B,
    inout out: ChunkSeq[T],
    name: u32,
    action: T,
    has_ty: bool,
    ty: T
) {
    let mark = builder.at();
    if has_ty {
        builder.w(S_BIND_TYPED);
        builder.w(P_BIND);
        builder.sym(name);
        builder.put(ty);
        builder.put(action);
    } else {
        builder.w(S_BIND);
        builder.w(P_BIND);
        builder.sym(name);
        builder.put(action);
    }
    out.push(builder.since(mark));
}

pub fn bind_pattern_stmt(inout builder: B, inout out: ChunkSeq[T], pattern: T, action: T) {
    let mark = builder.at();
    builder.w(S_BIND);
    builder.put(pattern);
    builder.put(action);
    out.push(builder.since(mark));
}

pub fn assign(inout builder: B, inout out: ChunkSeq[T], local: u32, value: T) {
    let mark = builder.at();
    builder.w(S_ASSIGN);
    builder.sym(local);
    builder.put(value);
    out.push(builder.since(mark));
}

pub fn expr_stmt(inout builder: B, term: T) -> T {
    let mark = builder.at();
    builder.w(S_EXPR);
    builder.put(term);
    builder.since(mark)
}

// `DS::If { condition, yes, no: None }`.
pub fn if_stmt(inout builder: B, condition: T, in yes: ChunkSeq[T]) -> T {
    let mark = builder.at();
    builder.w(S_IF);
    builder.put(condition);
    builder.w(yes.len());
    put_all(inout builder, in yes);
    builder.w(0);
    builder.since(mark)
}

pub fn extend(inout out: ChunkSeq[T], in more: ChunkSeq[T]) {
    for i in 0..more.len() {
        out.push(t_at(in more, i));
    }
}

// `DS::Match` with two arms.
pub fn match_stmt2(
    inout builder: B,
    scrutinee: T,
    p1: T,
    in s1: ChunkSeq[T],
    p2: T,
    in s2: ChunkSeq[T]
) -> T {
    let mark = builder.at();
    builder.w(7);
    builder.w(2);
    builder.put(scrutinee);
    builder.put(p1);
    builder.w(s1.len());
    put_all(inout builder, in s1);
    builder.put(p2);
    builder.w(s2.len());
    put_all(inout builder, in s2);
    builder.since(mark)
}

// `DS::LetInstance { name: None, ty, value }`.
pub fn let_instance(inout builder: B, ty: T, value: T) -> T {
    let mark = builder.at();
    builder.w(5);
    builder.w(0);
    builder.put(ty);
    builder.put(value);
    builder.since(mark)
}

// `arrow(domain, codomain)`.
pub fn arrow(inout builder: B, domain: T, codomain: T) -> T {
    let mark = builder.at();
    builder.w(T_ARROW);
    builder.put(domain);
    builder.put(codomain);
    builder.since(mark)
}

// `arrows(args, result)`.
pub fn arrows(inout builder: B, in args: ChunkSeq[T], result: T) -> T {
    let mark = builder.at();
    for i in 0..args.len() {
        builder.w(T_ARROW);
        builder.put(t_at(in args, i));
    }
    builder.put(result);
    builder.since(mark)
}
