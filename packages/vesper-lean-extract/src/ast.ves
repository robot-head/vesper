// The AST section of the structured extractor's input (part 3), after the
// sections of fn_input.ves: the source functions, their patterns and
// expressions as rows of words (`Ast` in tests/self_host_lean_extract.rs
// documents each payload). Names and types stay input indices in the rows;
// the accessors map them to symbols and type ids.

use @vesper/check-data::input::{Reader};
use @vesper/check-data::util::{add, inc, n32, u32_at, u64_at};
use @vesper/check-data::world::{set_by_symbol};

pub const NONE: u64 = 18446744073709551615;
pub const NONE32: u32 = 4294967295;

// Expression kinds.
pub const X_LITERAL: u64 = 1;
pub const X_NAME: u64 = 2;
pub const X_TUPLE: u64 = 3;
pub const X_STRUCT: u64 = 4;
pub const X_FIELD: u64 = 5;
pub const X_INDEX: u64 = 6;
pub const X_UNARY: u64 = 7;
pub const X_BINARY: u64 = 8;
pub const X_ASSIGN: u64 = 9;
pub const X_BLOCK: u64 = 10;
pub const X_CALL: u64 = 11;
pub const X_TRY: u64 = 12;
pub const X_IF: u64 = 13;
pub const X_MATCH: u64 = 14;
pub const X_LOOP: u64 = 15;
pub const X_CLOSURE: u64 = 21;
pub const X_HANDLE: u64 = 22;

// Pattern kinds.
pub const PK_WILD: u64 = 0;
pub const PK_BIND: u64 = 1;
pub const PK_LITERAL: u64 = 2;
pub const PK_TUPLE: u64 = 3;
pub const PK_CTOR: u64 = 4;

// Literal kinds.
pub const L_INT: u64 = 0;
pub const L_FLOAT: u64 = 1;
pub const L_BOOL: u64 = 2;
pub const L_STRING: u64 = 3;
// An integer past `i128::MAX`.
pub const L_WIDE: u64 = 4;

// Sequence operations (`seq_code` in the test).
pub const Q_NEW: u64 = 1;
pub const Q_WITH_CAPACITY: u64 = 2;
pub const Q_LEN: u64 = 3;
pub const Q_PUSH: u64 = 4;
pub const Q_POP: u64 = 5;
pub const Q_GET: u64 = 6;
pub const Q_SET: u64 = 7;
pub const Q_TRY_GET: u64 = 8;
pub const Q_LAST: u64 = 9;
pub const Q_TRY_SET: u64 = 10;
pub const Q_CLEAR: u64 = 11;
pub const Q_TRUNCATE: u64 = 12;
pub const Q_RESERVE: u64 = 13;
pub const Q_EXTEND: u64 = 14;
pub const Q_FINISH: u64 = 15;
pub const Q_AS_SLICE: u64 = 16;
pub const Q_SUB_SLICE: u64 = 17;

// Tiled operations.
pub const TO_NEW: u64 = 1;
pub const TO_WITH_CAPACITY: u64 = 2;
pub const TO_WITH_REGION: u64 = 3;
pub const TO_LEN: u64 = 4;
pub const TO_TILE_COUNT: u64 = 5;
pub const TO_GET: u64 = 6;
pub const TO_COL_GET: u64 = 7;
pub const TO_PUSH: u64 = 8;
pub const TO_SET: u64 = 9;
pub const TO_COL_SET: u64 = 10;
pub const TO_LOAD_TILE_VEC: u64 = 11;

pub copy struct SrcFn {
    name: u32,
    body: u64,
    // params: pnames/ppass/ptys[pa..pa+pn]
    pa: u64,
    pn: u64,
    result: u32,
    polymorphic: bool,
    // `() -> Unit / effects` holding the function's effects row
    row: u32,
    // the result type as `function_requirements` reads it
    req_result: u32,
}

// An effect declaration (the effect section at the end of the AST input).
pub copy struct EffDecl {
    name: u32,
    linear: bool,
    // generic names: egens[ga..ga+gn]
    ga: u64,
    gn: u64,
    // operations: eops[oa..oa+on]
    oa: u64,
    on: u64,
}

pub copy struct EffOp {
    name: u32,
    // parameters: eparams[pa..pa+pn]
    pa: u64,
    pn: u64,
    result: u32,
}

pub copy struct EffParam {
    pass: u64,
    // projections: eprojs[qa..qa+qn], each a range of eproj_syms
    qa: u64,
    qn: u64,
    ty: u32,
}

pub copy struct Range {
    a: u64,
    n: u64,
}

pub struct Ast {
    fip: bool,
    fns: ChunkSeq[SrcFn],
    pnames: ChunkSeq[u32],
    ppass: ChunkSeq[u64],
    ptys: ChunkSeq[u32],
    // rows: words[at[i]..]
    pw: ChunkSeq[u64],
    pat_at: ChunkSeq[u64],
    ew: ChunkSeq[u64],
    expr_at: ChunkSeq[u64],
    nmap: ChunkSeq[u32],
    tmap: ChunkSeq[u32],
    // symbol -> function index + 1
    fn_by_name: ChunkSeq[u32],
    effs: ChunkSeq[EffDecl],
    egens: ChunkSeq[u32],
    eops: ChunkSeq[EffOp],
    eparams: ChunkSeq[EffParam],
    eprojs: ChunkSeq[Range],
    eproj_syms: ChunkSeq[u32],
    // symbol -> effect index + 1
    eff_by_name: ChunkSeq[u32],
}

fn copy_words(inout r: Reader, in b: Slice[u8], n: u64, inout out: ChunkSeq[u64]) {
    for i in 0..n {
        out.push(r.word(in b));
    }
}

// A pattern row's payload length.
fn pattern_len(inout r: Reader, in b: Slice[u8], inout out: ChunkSeq[u64]) {
    let kind = r.word(in b);
    out.push(kind);
    copy_words(inout r, in b, 3, inout out);
    if kind == PK_BIND {
        copy_words(inout r, in b, 1, inout out);
    } else if kind == PK_LITERAL {
        copy_words(inout r, in b, 3, inout out);
    } else if kind == PK_TUPLE {
        let n = r.word(in b);
        out.push(n);
        copy_words(inout r, in b, n, inout out);
    } else if kind == PK_CTOR {
        copy_words(inout r, in b, 2, inout out);
        let n = r.word(in b);
        out.push(n);
        copy_words(inout r, in b, add(n, n), inout out);
    }
}

fn count_then(inout r: Reader, in b: Slice[u8], per: u64, inout out: ChunkSeq[u64]) {
    let n = r.word(in b);
    out.push(n);
    copy_words(inout r, in b, wrapping_mul(n, per), inout out);
}

fn expr_row(inout r: Reader, in b: Slice[u8], inout out: ChunkSeq[u64]) {
    let kind = r.word(in b);
    out.push(kind);
    copy_words(inout r, in b, 3, inout out);
    if kind == X_LITERAL {
        copy_words(inout r, in b, 3, inout out);
    } else if kind == X_NAME || kind == X_TRY {
        copy_words(inout r, in b, 1, inout out);
    } else if kind == X_TUPLE {
        count_then(inout r, in b, 1, inout out);
    } else if kind == X_STRUCT {
        copy_words(inout r, in b, 1, inout out);
        count_then(inout r, in b, 2, inout out);
    } else if kind == X_FIELD {
        copy_words(inout r, in b, 2, inout out);
    } else if kind == X_INDEX {
        copy_words(inout r, in b, 2, inout out);
        let route = r.word(in b);
        out.push(route);
        if route == 4 {
            copy_words(inout r, in b, 1, inout out);
        }
    } else if kind == X_UNARY {
        copy_words(inout r, in b, 2, inout out);
    } else if kind == X_BINARY || kind == X_ASSIGN || kind == X_IF {
        copy_words(inout r, in b, 3, inout out);
    } else if kind == X_BLOCK {
        let n = r.word(in b);
        out.push(n);
        for i in 0..n {
            let k = r.word(in b);
            out.push(k);
            if k == 0 {
                copy_words(inout r, in b, 1, inout out);
            } else {
                copy_words(inout r, in b, 4, inout out);
            }
        }
        copy_words(inout r, in b, 1, inout out);
    } else if kind == X_CALL {
        copy_words(inout r, in b, 1, inout out);
        count_then(inout r, in b, 2, inout out);
        count_then(inout r, in b, 1, inout out);
        copy_words(inout r, in b, 11, inout out);
    } else if kind == X_MATCH {
        copy_words(inout r, in b, 1, inout out);
        count_then(inout r, in b, 2, inout out);
    } else if kind == X_CLOSURE {
        copy_words(inout r, in b, 1, inout out);
        count_then(inout r, in b, 1, inout out);
        copy_words(inout r, in b, 1, inout out);
        count_then(inout r, in b, 1, inout out);
        copy_words(inout r, in b, 1, inout out);
    } else if kind == X_HANDLE {
        copy_words(inout r, in b, 2, inout out);
        count_then(inout r, in b, 1, inout out);
        copy_words(inout r, in b, 4, inout out);
        clause_row(inout r, in b, false, inout out);
        let n = r.word(in b);
        out.push(n);
        for i in 0..n {
            clause_row(inout r, in b, true, inout out);
        }
        count_then(inout r, in b, 1, inout out);
        copy_words(inout r, in b, 1, inout out);
        let m = r.word(in b);
        out.push(m);
        for i in 0..m {
            let k = r.word(in b);
            out.push(k);
            copy_words(inout r, in b, 1, inout out);
            if k == 1 {
                copy_words(inout r, in b, 1, inout out);
            } else if k == 2 {
                count_then(inout r, in b, 1, inout out);
            }
        }
    }
}

// A handler clause: name, patterns, body, free names (then, for operation
// clauses, the body's names with their spans).
fn clause_row(inout r: Reader, in b: Slice[u8], names: bool, inout out: ChunkSeq[u64]) {
    copy_words(inout r, in b, 1, inout out);
    count_then(inout r, in b, 1, inout out);
    copy_words(inout r, in b, 1, inout out);
    count_then(inout r, in b, 1, inout out);
    if names {
        count_then(inout r, in b, 3, inout out);
    }
}

pub fn read_ast(
    inout r: Reader,
    in b: Slice[u8],
    in nmap: ChunkSeq[u32],
    in tmap: ChunkSeq[u32]
) -> Ast {
    let mut a = Ast {
        fip: false,
        fns: ChunkSeq::new[SrcFn](),
        pnames: ChunkSeq::new[u32](),
        ppass: ChunkSeq::new[u64](),
        ptys: ChunkSeq::new[u32](),
        pw: ChunkSeq::new[u64](),
        pat_at: ChunkSeq::new[u64](),
        ew: ChunkSeq::new[u64](),
        expr_at: ChunkSeq::new[u64](),
        nmap: ChunkSeq::new[u32](),
        tmap: ChunkSeq::new[u32](),
        fn_by_name: ChunkSeq::new[u32](),
        effs: ChunkSeq::new[EffDecl](),
        egens: ChunkSeq::new[u32](),
        eops: ChunkSeq::new[EffOp](),
        eparams: ChunkSeq::new[EffParam](),
        eprojs: ChunkSeq::new[Range](),
        eproj_syms: ChunkSeq::new[u32](),
        eff_by_name: ChunkSeq::new[u32](),
    };
    for i in 0..nmap.len() {
        a.nmap.push(u32_at(in nmap, i));
    }
    for i in 0..tmap.len() {
        a.tmap.push(u32_at(in tmap, i));
    }
    a.fip = r.word(in b) != 0;
    let nf = r.word(in b);
    for i in 0..nf {
        let name = u32_at(in a.nmap, r.word(in b));
        let body = r.word(in b);
        let pa = a.pnames.len();
        let pn = r.word(in b);
        for j in 0..pn {
            let n = u32_at(in a.nmap, r.word(in b));
            a.pnames.push(n);
            a.ppass.push(r.word(in b));
            let t = u32_at(in a.tmap, r.word(in b));
            a.ptys.push(t);
        }
        let result = u32_at(in a.tmap, r.word(in b));
        let polymorphic = r.word(in b) != 0;
        let row = u32_at(in a.tmap, r.word(in b));
        let req_result = u32_at(in a.tmap, r.word(in b));
        a.fns.push(SrcFn {
            name: name,
            body: body,
            pa: pa,
            pn: pn,
            result: result,
            polymorphic: polymorphic,
            row: row,
            req_result: req_result
        });
        set_by_symbol(inout a.fn_by_name, name, n32(inc(i)));
    }
    let np = r.word(in b);
    for i in 0..np {
        a.pat_at.push(a.pw.len());
        pattern_len(inout r, in b, inout a.pw);
    }
    let ne = r.word(in b);
    for i in 0..ne {
        a.expr_at.push(a.ew.len());
        expr_row(inout r, in b, inout a.ew);
    }
    let neff = r.word(in b);
    for i in 0..neff {
        let name = u32_at(in a.nmap, r.word(in b));
        let linear = r.word(in b) != 0;
        let ga = a.egens.len();
        let gn = r.word(in b);
        for j in 0..gn {
            let g = u32_at(in a.nmap, r.word(in b));
            a.egens.push(g);
        }
        let oa = a.eops.len();
        let on = r.word(in b);
        for j in 0..on {
            let op = u32_at(in a.nmap, r.word(in b));
            let pa = a.eparams.len();
            let pn = r.word(in b);
            for k in 0..pn {
                let pass = r.word(in b);
                let qa = a.eprojs.len();
                let qn = r.word(in b);
                for q in 0..qn {
                    let sa = a.eproj_syms.len();
                    let sn = r.word(in b);
                    for z in 0..sn {
                        let s = u32_at(in a.nmap, r.word(in b));
                        a.eproj_syms.push(s);
                    }
                    a.eprojs.push(Range { a: sa, n: sn });
                }
                let ty = u32_at(in a.tmap, r.word(in b));
                a.eparams.push(EffParam { pass: pass, qa: qa, qn: qn, ty: ty });
            }
            let result = u32_at(in a.tmap, r.word(in b));
            a.eops.push(EffOp { name: op, pa: pa, pn: pn, result: result });
        }
        a.effs.push(EffDecl { name: name, linear: linear, ga: ga, gn: gn, oa: oa, on: on });
        set_by_symbol(inout a.eff_by_name, name, n32(inc(i)));
    }
    a
}

impl Ast {
    pub fn function(in self, i: u64) -> SrcFn {
        match self.fns.try_get(i) {
            Option::Some(f) => f,
            Option::None => SrcFn {
                name: 0,
                body: NONE,
                pa: 0,
                pn: 0,
                result: 0,
                polymorphic: false,
                row: 0,
                req_result: 0
            },
        }
    }

    // The function named `n`, or NONE.
    pub fn fn_index(in self, n: u32) -> u64 {
        let k = u32_at(in self.fn_by_name, widen_u64(n));
        if k == 0 {
            NONE
        } else {
            wrapping_sub(widen_u64(k), 1)
        }
    }

    // The effect declaration named `n`, or NONE.
    pub fn eff_index(in self, n: u32) -> u64 {
        let k = u32_at(in self.eff_by_name, widen_u64(n));
        if k == 0 {
            NONE
        } else {
            wrapping_sub(widen_u64(k), 1)
        }
    }

    pub fn eff(in self, i: u64) -> EffDecl {
        match self.effs.try_get(i) {
            Option::Some(e) => e,
            Option::None => EffDecl { name: 0, linear: false, ga: 0, gn: 0, oa: 0, on: 0 },
        }
    }

    pub fn eff_generic(in self, e: EffDecl, i: u64) -> u32 {
        u32_at(in self.egens, add(e.ga, i))
    }

    pub fn eff_op(in self, e: EffDecl, i: u64) -> EffOp {
        match self.eops.try_get(add(e.oa, i)) {
            Option::Some(o) => o,
            Option::None => EffOp { name: 0, pa: 0, pn: 0, result: 0 },
        }
    }

    // The operation of `e` named `op`, or an operation with name 0.
    pub fn find_op(in self, e: EffDecl, op: u32) -> EffOp {
        for i in 0..e.on {
            let o = self.eff_op(e, i);
            if o.name == op {
                return o;
            }
        }
        EffOp { name: 0, pa: 0, pn: 0, result: 0 }
    }

    pub fn op_param(in self, o: EffOp, i: u64) -> EffParam {
        match self.eparams.try_get(add(o.pa, i)) {
            Option::Some(p) => p,
            Option::None => EffParam { pass: 0, qa: 0, qn: 0, ty: 0 },
        }
    }

    pub fn proj(in self, p: EffParam, q: u64) -> Range {
        match self.eprojs.try_get(add(p.qa, q)) {
            Option::Some(x) => x,
            Option::None => Range { a: 0, n: 0 },
        }
    }

    pub fn proj_sym(in self, r: Range, j: u64) -> u32 {
        u32_at(in self.eproj_syms, add(r.a, j))
    }

    pub fn param_name(in self, f: SrcFn, i: u64) -> u32 {
        u32_at(in self.pnames, add(f.pa, i))
    }

    pub fn param_pass(in self, f: SrcFn, i: u64) -> u64 {
        u64_at(in self.ppass, add(f.pa, i))
    }

    pub fn param_ty(in self, f: SrcFn, i: u64) -> u32 {
        u32_at(in self.ptys, add(f.pa, i))
    }

    // Word `k` of expression `e`'s row: 0 kind, 1 start, 2 end, 3 type,
    // then the payload.
    pub fn ew(in self, e: u64, k: u64) -> u64 {
        u64_at(in self.ew, add(u64_at(in self.expr_at, e), k))
    }

    pub fn kind(in self, e: u64) -> u64 {
        self.ew(e, 0)
    }

    pub fn start(in self, e: u64) -> u64 {
        self.ew(e, 1)
    }

    pub fn end(in self, e: u64) -> u64 {
        self.ew(e, 2)
    }

    // The checked type (after `default_type`), or NONE32.
    pub fn ty(in self, e: u64) -> u32 {
        let x = self.ew(e, 3);
        if x == NONE {
            NONE32
        } else {
            u32_at(in self.tmap, x)
        }
    }

    // Payload word `k`.
    pub fn x(in self, e: u64, k: u64) -> u64 {
        self.ew(e, add(4, k))
    }

    // Payload word `k` as a symbol (NONE32 for NONE).
    pub fn xs(in self, e: u64, k: u64) -> u32 {
        let x = self.x(e, k);
        if x == NONE {
            NONE32
        } else {
            u32_at(in self.nmap, x)
        }
    }

    // Payload word `k` as a type (NONE32 for NONE).
    pub fn xt(in self, e: u64, k: u64) -> u32 {
        let x = self.x(e, k);
        if x == NONE {
            NONE32
        } else {
            u32_at(in self.tmap, x)
        }
    }

    pub fn pw(in self, p: u64, k: u64) -> u64 {
        u64_at(in self.pw, add(u64_at(in self.pat_at, p), k))
    }

    pub fn pkind(in self, p: u64) -> u64 {
        self.pw(p, 0)
    }

    pub fn is_box(in self, p: u64) -> bool {
        self.pw(p, 3) != 0
    }

    // Pattern payload word `k`.
    pub fn px(in self, p: u64, k: u64) -> u64 {
        self.pw(p, add(4, k))
    }

    pub fn pxs(in self, p: u64, k: u64) -> u32 {
        u32_at(in self.nmap, self.px(p, k))
    }

    pub fn sym(in self, x: u64) -> u32 {
        u32_at(in self.nmap, x)
    }

    pub fn tyw(in self, x: u64) -> u32 {
        if x == NONE {
            NONE32
        } else {
            u32_at(in self.tmap, x)
        }
    }
}
