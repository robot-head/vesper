// `ty_with_fip` (src/lean_nodes.rs `typed`) with no ambient monad: a
// checked type as a Lean type. `ty_error` finds the error Rust reports
// first, in Rust's evaluation order; `ty` writes the term and assumes the
// caller checked (`emit_ty`).

use @vesper/check-data::types::{Types, TyKind, TyPass};
use @vesper/check-data::util::{add, u32_at, u8_at, w};
use self::build::{B, T, T_APP, T_ARROW, T_INFER, T_PRODUCT};

// Error codes of `ty_error`.
pub const E_NONE: u64 = 0;
pub const E_I128: u64 = 1;
pub const E_U128: u64 = 2;
pub const E_MONAD: u64 = 3;
pub const E_ROW: u64 = 4;
// A named type whose name is not a Lean name: `B::check` reports it.
pub const E_NAME: u64 = 5;

// Records error `code` (type `ty` for E_NAME) on `builder`.
pub fn report(inout builder: B, code: u64, name: u32) {
    if code == E_I128 {
        builder.fail(in "Lean extraction does not model i128 yet");
    } else if code == E_U128 {
        builder.fail(in "Lean extraction does not model u128 yet");
    } else if code == E_MONAD {
        builder.fail(in "effectful function type needs an ambient Lean monad");
    } else if code == E_ROW {
        builder.fail(in "effect rows are not first-class Lean values");
    } else if code == E_NAME {
        builder.check(name, in "name");
    }
}

// The Lean constructor of a primitive type name, or "" for a source name.
fn primitive(in builder: B, sym: u32) -> Str {
    if spells(in builder, sym, in "u8") {
        "UInt8"
    } else if spells(in builder, sym, in "u16") {
        "UInt16"
    } else if spells(in builder, sym, in "u32") {
        "UInt32"
    } else if spells(in builder, sym, in "u64") || spells(in builder, sym, in "usize") {
        "UInt64"
    } else if spells(in builder, sym, in "i8") {
        "Int8"
    } else if spells(in builder, sym, in "i16") {
        "Int16"
    } else if spells(in builder, sym, in "i32") {
        "Int32"
    } else if spells(in builder, sym, in "i64") || spells(in builder, sym, in "isize") {
        "Int64"
    } else {
        primitive_rest(in builder, sym)
    }
}

fn primitive_rest(in builder: B, sym: u32) -> Str {
    if spells(in builder, sym, in "f64") {
        "Float"
    } else if spells(in builder, sym, in "f32") {
        "Float32"
    } else if spells(in builder, sym, in "bool") {
        "Bool"
    } else if spells(in builder, sym, in "Unit") {
        "Unit"
    } else if spells(in builder, sym, in "Never") {
        "Empty"
    } else if spells(in builder, sym, in "String") {
        "String"
    } else if spells(in builder, sym, in "Option") {
        "Option"
    } else if spells(in builder, sym, in "Result") {
        "Except"
    } else if spells(in builder, sym, in "TiledSeq")
        || spells(in builder, sym, in "ChunkSeq")
        || spells(in builder, sym, in "Slice")
    {
        "Array"
    } else {
        ""
    }
}

pub fn spells(in builder: B, sym: u32, in text: Str) -> bool {
    builder.names.spells(sym, in text.as_bytes())
}

// Whether `Box[T]` erases to `T` (fip active, one argument).
fn erased(in builder: B, in types: Types, ty: u32, erase_box: bool) -> bool {
    let node = types.node(ty);
    erase_box
        && node.kind == TyKind::Named
        && w(node.n) == 1
        && spells(in builder, node.name, in "Box")
}

// The argument order of a named type: `Result[T, E]` is `Except E T`, and a
// `TiledSeq` keeps its element only.
fn ordered_count(in builder: B, in types: Types, ty: u32) -> u64 {
    let node = types.node(ty);
    if spells(in builder, node.name, in "TiledSeq") && node.n > 0 {
        1
    } else {
        w(node.n)
    }
}

fn ordered_arg(in builder: B, in types: Types, ty: u32, i: u64) -> u32 {
    let node = types.node(ty);
    if spells(in builder, node.name, in "Result") && node.n == 2 {
        types.arg(ty, wrapping_sub(1, i))
    } else {
        types.arg(ty, i)
    }
}

fn has_effects(in types: Types, row_ty: u32) -> bool {
    let row = types.row(row_ty);
    row.n > 0 || row.tail != 0
}

// The first error of `typed(ty, None, erase_box)` and, for E_NAME, the
// offending name.
pub fn ty_error(in builder: B, in types: Types, ty: u32, erase_box: bool, inout name: u32) -> u64 {
    ty_error_m(in builder, in types, ty, erase_box, false, inout name)
}

// `ty_error` of `typed(ty, monad, erase_box)`: with an ambient monad an
// effectful arrow is no error.
pub fn ty_error_m(
    in builder: B,
    in types: Types,
    ty: u32,
    erase_box: bool,
    monad: bool,
    inout name: u32
) -> u64 {
    let node = types.node(ty);
    if node.kind == TyKind::Lit || node.kind == T_INFER_KIND {
        return E_NONE;
    }
    if node.kind == TyKind::Named {
        if erased(in builder, in types, ty, erase_box) {
            return ty_error_m(in builder, in types, types.arg(ty, 0), erase_box, monad, inout name);
        }
        if spells(in builder, node.name, in "i128") {
            return E_I128;
        }
        if spells(in builder, node.name, in "u128") {
            return E_U128;
        }
        if primitive(in builder, node.name).len() == 0 && !builder.valid(node.name) {
            name = node.name;
            return E_NAME;
        }
        for i in 0..ordered_count(in builder, in types, ty) {
            let code = ty_error_m(
                in builder,
                in types,
                ordered_arg(in builder, in types, ty, i),
                erase_box,
                monad,
                inout name
            );
            if code != E_NONE {
                return code;
            }
        }
        return E_NONE;
    }
    if node.kind == TyKind::Tuple {
        for i in 0..w(node.n) {
            let code = ty_error_m(
                in builder,
                in types,
                types.arg(ty, i),
                erase_box,
                monad,
                inout name
            );
            if code != E_NONE {
                return code;
            }
        }
        return E_NONE;
    }
    if node.kind == TyKind::Fn {
        let code = ty_error_m(in builder, in types, node.r, erase_box, monad, inout name);
        if code != E_NONE {
            return code;
        }
        for i in 0..w(node.n) {
            if types.param_pass(ty, i) == TyPass::Inout {
                let code = ty_error_m(
                    in builder,
                    in types,
                    types.arg(ty, i),
                    erase_box,
                    monad,
                    inout name
                );
                if code != E_NONE {
                    return code;
                }
            }
        }
        if !monad && has_effects(in types, node.r2) {
            return E_MONAD;
        }
        let mut i = w(node.n);
        loop {
            if i == 0 {
                break;
            }
            i = wrapping_sub(i, 1);
            let code = ty_error_m(
                in builder,
                in types,
                types.arg(ty, i),
                erase_box,
                monad,
                inout name
            );
            if code != E_NONE {
                return code;
            }
        }
        return E_NONE;
    }
    if node.kind == TyKind::Row {
        return E_ROW;
    }
    E_NONE
}

const T_INFER_KIND: u8 = 5;

// Checks `ty` and records its first error on `builder`.
pub fn ty_check(inout builder: B, in types: Types, ty: u32, erase_box: bool) {
    let mut name: u32 = 0;
    let code = ty_error(in builder, in types, ty, erase_box, inout name);
    if code != E_NONE {
        report(inout builder, code, name);
    }
}

// Writes `typed(ty, None, erase_box)`.
pub fn emit_ty(inout builder: B, in types: Types, ty: u32, erase_box: bool) {
    let none = T { a: 0, n: 0 };
    emit_ty_m(inout builder, in types, ty, erase_box, false, none);
}

// Writes `typed(ty, Some(monad), erase_box)` when `has_monad`, else with no
// monad.
pub fn emit_ty_m(
    inout builder: B,
    in types: Types,
    ty: u32,
    erase_box: bool,
    has_monad: bool,
    monad: T
) {
    let node = types.node(ty);
    if node.kind == TyKind::Lit {
        if node.mode == 0 && wrapping_u64(node.lit) > 9223372036854775807 {
            builder.global(in "UInt64");
        } else {
            builder.global(in "Int64");
        }
        return;
    }
    if node.kind == TyKind::Named {
        if erased(in builder, in types, ty, erase_box) {
            emit_ty_m(inout builder, in types, types.arg(ty, 0), erase_box, has_monad, monad);
            return;
        }
        let count = ordered_count(in builder, in types, ty);
        let mut mark: u64 = 0;
        if count > 0 {
            mark = builder.app(count);
        }
        if primitive(in builder, node.name).len() == 0 {
            builder.sref(node.name);
        } else {
            let lean_name = primitive(in builder, node.name);
            builder.global(in lean_name);
        }
        if count > 0 {
            builder.args(mark);
            for i in 0..count {
                builder.arg();
                let arg_ty = ordered_arg(in builder, in types, ty, i);
                emit_ty_m(inout builder, in types, arg_ty, erase_box, has_monad, monad);
            }
        }
        return;
    }
    if node.kind == TyKind::Tuple {
        if node.n == 0 {
            builder.global(in "Unit");
        } else if node.n == 1 {
            emit_ty_m(inout builder, in types, types.arg(ty, 0), erase_box, has_monad, monad);
        } else {
            builder.w(T_PRODUCT);
            builder.w(w(node.n));
            for i in 0..w(node.n) {
                emit_ty_m(inout builder, in types, types.arg(ty, i), erase_box, has_monad, monad);
            }
        }
        return;
    }
    if node.kind == TyKind::Fn {
        let params = w(node.n);
        for i in 0..params {
            builder.w(T_ARROW);
            emit_ty_m(inout builder, in types, types.arg(ty, i), erase_box, has_monad, monad);
        }
        if params == 0 {
            builder.w(T_ARROW);
            builder.global(in "Unit");
        }
        // product([result, inout parameters...])
        let mut results: u64 = 1;
        for i in 0..params {
            if types.param_pass(ty, i) == TyPass::Inout {
                results = wrapping_add(results, 1);
            }
        }
        let wrap = has_monad && has_effects(in types, node.r2);
        let mut mark: u64 = 0;
        if wrap {
            mark = builder.app(1);
            builder.put(monad);
            builder.args(mark);
            builder.arg();
        }
        if results > 1 {
            builder.w(T_PRODUCT);
            builder.w(results);
        }
        emit_ty_m(inout builder, in types, node.r, erase_box, has_monad, monad);
        for i in 0..params {
            if types.param_pass(ty, i) == TyPass::Inout {
                emit_ty_m(inout builder, in types, types.arg(ty, i), erase_box, has_monad, monad);
            }
        }
        return;
    }
    builder.w(T_INFER);
}
