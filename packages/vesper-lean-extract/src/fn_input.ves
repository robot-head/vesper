// The function sections of the input (`cfg_input` in
// tests/self_host_lean_extract.rs), after the program section of
// @vesper/place-ir:
//
// - sigs: per function of the world the CFG extractor sees (the source
//   functions and the closures it lifts), its generics, parameters (pass,
//   projections, type) and whether it has effects: what `world.functions`
//   answers for callees and for the generics of each definition.
// - calls: `world.calls` at the program's call spans (generic name to type).
// - closures: per closure instruction, its owner, destination, the lifted
//   function's name and the captured slots (`lean_ir::extract_closures`).

use @vesper/check-data::input::{Reader};
use @vesper/check-data::world::{set_by_symbol};
use @vesper/check-data::util::{add, n32, u32_at, w};

const NONE32: u32 = 4294967295;

pub copy struct Sig {
    name: u32,
    source: bool,
    // generics: gens[ga..ga+gn]
    ga: u64,
    gn: u64,
    // parameters: params[param_start..param_start+param_count]
    param_start: u64,
    param_count: u64,
    effectful: bool,
}

pub copy struct Generic {
    name: u32,
    row: bool,
}

pub copy struct SigParam {
    pass: u8,
    // projections: paths[proj_start..proj_start+proj_count]
    proj_start: u64,
    proj_count: u64,
    ty: u32,
}

pub copy struct Path {
    // syms[a..a+n]
    a: u64,
    n: u64,
}

pub copy struct Call {
    s0: u64,
    s1: u64,
    // vars[a..a+n]
    a: u64,
    n: u64,
}

pub copy struct Var {
    name: u32,
    ty: u32,
}

pub copy struct Closure {
    owner: u32,
    dest: u64,
    lifted: u32,
    // captured slots: syms[a..a+n]
    a: u64,
    n: u64,
}

pub struct Fns {
    sigs: ChunkSeq[Sig],
    gens: ChunkSeq[Generic],
    params: ChunkSeq[SigParam],
    paths: ChunkSeq[Path],
    syms: ChunkSeq[u32],
    calls: ChunkSeq[Call],
    vars: ChunkSeq[Var],
    closures: ChunkSeq[Closure],
    // symbol -> signature index + 1
    by_name: ChunkSeq[u32],
}

fn sym(inout reader: Reader, in bytes: Slice[u8], in nmap: ChunkSeq[u32]) -> u32 {
    let index = reader.word(in bytes);
    u32_at(in nmap, index)
}

fn ty(inout reader: Reader, in bytes: Slice[u8], in tmap: ChunkSeq[u32]) -> u32 {
    let index = reader.word(in bytes);
    u32_at(in tmap, index)
}

pub fn read_fns(
    inout reader: Reader,
    in bytes: Slice[u8],
    in nmap: ChunkSeq[u32],
    in tmap: ChunkSeq[u32]
) -> Fns {
    let mut out = Fns {
        sigs: ChunkSeq::new[Sig](),
        gens: ChunkSeq::new[Generic](),
        params: ChunkSeq::new[SigParam](),
        paths: ChunkSeq::new[Path](),
        syms: ChunkSeq::new[u32](),
        calls: ChunkSeq::new[Call](),
        vars: ChunkSeq::new[Var](),
        closures: ChunkSeq::new[Closure](),
        by_name: ChunkSeq::new[u32](),
    };
    let sig_count = reader.word(in bytes);
    for i in 0..sig_count {
        let name = sym(inout reader, in bytes, in nmap);
        let source = reader.word(in bytes) != 0;
        let generic_start = out.gens.len();
        let generic_count = reader.word(in bytes);
        for j in 0..generic_count {
            let generic = sym(inout reader, in bytes, in nmap);
            let row = reader.word(in bytes) != 0;
            out.gens.push(Generic { name: generic, row: row });
        }
        let param_start = out.params.len();
        let param_count = reader.word(in bytes);
        for j in 0..param_count {
            let pass = wrapping_u8(reader.word(in bytes));
            let proj_start = out.paths.len();
            let proj_count = reader.word(in bytes);
            for k in 0..proj_count {
                let segment_start = out.syms.len();
                let segment_count = reader.word(in bytes);
                for m in 0..segment_count {
                    let segment = sym(inout reader, in bytes, in nmap);
                    out.syms.push(segment);
                }
                out.paths.push(Path { a: segment_start, n: segment_count });
            }
            let param_ty = ty(inout reader, in bytes, in tmap);
            out.params.push(SigParam {
                pass: pass,
                proj_start: proj_start,
                proj_count: proj_count,
                ty: param_ty
            });
        }
        let effectful = reader.word(in bytes) != 0;
        set_by_symbol(inout out.by_name, name, n32(add(out.sigs.len(), 1)));
        out.sigs.push(Sig {
            name: name,
            source: source,
            ga: generic_start,
            gn: generic_count,
            param_start: param_start,
            param_count: param_count,
            effectful: effectful
        });
    }
    let call_count = reader.word(in bytes);
    for i in 0..call_count {
        let s0 = reader.word(in bytes);
        let s1 = reader.word(in bytes);
        let var_start = out.vars.len();
        let var_count = reader.word(in bytes);
        for j in 0..var_count {
            let name = sym(inout reader, in bytes, in nmap);
            let var_ty = ty(inout reader, in bytes, in tmap);
            out.vars.push(Var { name: name, ty: var_ty });
        }
        out.calls.push(Call { s0: s0, s1: s1, a: var_start, n: var_count });
    }
    let closure_count = reader.word(in bytes);
    for i in 0..closure_count {
        let owner = sym(inout reader, in bytes, in nmap);
        let dest = reader.word(in bytes);
        let lifted = sym(inout reader, in bytes, in nmap);
        let capture_start = out.syms.len();
        let capture_count = reader.word(in bytes);
        for j in 0..capture_count {
            let captured = sym(inout reader, in bytes, in nmap);
            out.syms.push(captured);
        }
        out.closures.push(Closure {
            owner: owner,
            dest: dest,
            lifted: lifted,
            a: capture_start,
            n: capture_count
        });
    }
    out
}

impl Fns {
    // `world.functions.get(name)`: the signature index, or NONE32.
    pub fn find(in self, name: u32) -> u32 {
        let entry = u32_at(in self.by_name, w(name));
        if entry == 0 {
            NONE32
        } else {
            wrapping_sub(entry, 1)
        }
    }

    pub fn sig(in self, i: u64) -> Sig {
        match self.sigs.try_get(i) {
            Option::Some(s) => s,
            Option::None => Sig {
                name: 0,
                source: false,
                ga: 0,
                gn: 0,
                param_start: 0,
                param_count: 0,
                effectful: false
            },
        }
    }

    pub fn generic(in self, sig: Sig, i: u64) -> Generic {
        match self.gens.try_get(add(sig.ga, i)) {
            Option::Some(g) => g,
            Option::None => Generic { name: 0, row: false },
        }
    }

    pub fn param(in self, sig: Sig, i: u64) -> SigParam {
        match self.params.try_get(add(sig.param_start, i)) {
            Option::Some(p) => p,
            Option::None => SigParam { pass: 0, proj_start: 0, proj_count: 0, ty: 0 },
        }
    }

    pub fn path(in self, i: u64) -> Path {
        match self.paths.try_get(i) {
            Option::Some(p) => p,
            Option::None => Path { a: 0, n: 0 },
        }
    }

    pub fn path_sym(in self, path: Path, k: u64) -> u32 {
        u32_at(in self.syms, add(path.a, k))
    }

    // `world.calls.get(&(s0, s1))`: the call index, or NONE32. The calls
    // are in span order.
    pub fn call(in self, s0: u64, s1: u64) -> u32 {
        let mut lo: u64 = 0;
        let mut hi = self.calls.len();
        loop {
            if lo >= hi {
                break;
            }
            let mid = add(lo, wrapping_sub(hi, lo) / 2);
            let probe = self.call_at(mid);
            if probe.s0 < s0 || (probe.s0 == s0 && probe.s1 < s1) {
                lo = add(mid, 1);
            } else {
                hi = mid;
            }
        }
        let probe = self.call_at(lo);
        if lo < self.calls.len() && probe.s0 == s0 && probe.s1 == s1 {
            n32(lo)
        } else {
            NONE32
        }
    }

    pub fn call_at(in self, i: u64) -> Call {
        match self.calls.try_get(i) {
            Option::Some(c) => c,
            Option::None => Call { s0: 0, s1: 0, a: 0, n: 0 },
        }
    }

    // The type call `call_index` gives generic `name`, or NONE32.
    pub fn call_var(in self, call_index: u32, name: u32) -> u32 {
        if call_index == NONE32 {
            return NONE32;
        }
        let row = self.call_at(w(call_index));
        for i in 0..row.n {
            match self.vars.try_get(add(row.a, i)) {
                Option::Some(v) => {
                    if v.name == name {
                        return v.ty;
                    }
                },
                Option::None => {},
            }
        }
        NONE32
    }

    // The closure lifted from instruction `dest` of `owner`: its index, or
    // NONE32.
    pub fn closure(in self, owner: u32, dest: u64) -> u32 {
        for i in 0..self.closures.len() {
            let candidate = self.closure_at(i);
            if candidate.owner == owner && candidate.dest == dest {
                return n32(i);
            }
        }
        NONE32
    }

    pub fn closure_at(in self, i: u64) -> Closure {
        match self.closures.try_get(i) {
            Option::Some(c) => c,
            Option::None => Closure { owner: 0, dest: 0, lifted: 0, a: 0, n: 0 },
        }
    }

    pub fn capture(in self, closure: Closure, k: u64) -> u32 {
        u32_at(in self.syms, add(closure.a, k))
    }
}
