// @vesper/lean-extract: Lean extraction (src/lean.rs, src/lean_ir.rs,
// src/lean_nodes.rs) in Vesper (self-hosting wave SH5 lane 18, #1341).
//
// Part 1 ports the head of the module `extract_report` builds: the
// prelude, the arithmetic simp set, the divergence class, the ADT groups
// with the getters of recursive structures, the effect classes and CPS
// lifts and the `Fail` models, wrapped in `import Std`, the unused-variable
// option and `namespace Vesper`. The functions, their fuel companions and
// contracts are the next parts.
//
// Built on @vesper/check-data (the harness input: the world's names, types
// and ADTs) and @vesper/lean-syntax (the printer). The extractor writes
// the printer's word stream directly (build.ves); the names table is its
// text pool. Rust stays the default extractor;
// tests/self_host_lean_extract.rs compares the text byte for byte.
//
// - build.ves: the word-stream builder and the identifier checks.
// - ty.ves: `ty_with_fip`.
// - prelude.ves: the fixed declarations.
// - head.ves: ADT groups (petgraph's Tarjan order), getters, effects.
// - input.ves: the effect section of the input.

use @vesper/check-data::input::{
    Reader,
    read_ctx
};
use @vesper/check-data::{
    pack_text
};
use @vesper/lean-syntax::{
    LeanError,
    render_module
};
use @vesper/check-data::names::{
    names_new
};
use self::build::{
    B,
    D_NAMESPACE,
    D_OPTION,
    builder
};
use self::head::{
    adt_groups,
    effect_classes,
    effect_lifts,
    has_fail_model
};
use self::input::{
    read_effects
};
use self::prelude::{
    arithmetic_semantics,
    arithmetic_simp_bundle,
    cps_monad,
    divergence,
    fail_models,
    handler_cps,
    in_i64,
    lift_action
};

// The prelude's declarations: HandlerCPS, its Monad, liftAction, the simp
// set, the semantics tag, inI64 and the four divergence declarations.
const PRELUDE_DECLARATIONS: u64 = 10;
const FAIL_MODEL_DECLARATIONS: u64 = 2;

// The head module as printer words.
fn head(in input: Str) -> B {
    let bytes = input.as_bytes();
    let mut r = Reader {
        pos: 0
    };
    let c = read_ctx(inout r, in bytes);
    let fx = read_effects(inout r, in bytes, in c.nmap, in c.tmap);
    let mut b = builder(names_new());
    b.names = c.names;
    let t = c.types;
    let wd = c.world;
    // import Std
    b.w(1);
    b.w(1);
    b.text(in "Std");
    b.w(2);
    // set_option linter.unusedVariables false
    b.w(D_OPTION);
    b.w(0);
    b.w(0);
    b.w(0);
    // namespace Vesper
    b.w(D_NAMESPACE);
    b.name_fixed(in "Vesper");
    let count = b.hole();
    handler_cps(inout b);
    cps_monad(inout b);
    lift_action(inout b);
    arithmetic_simp_bundle(inout b);
    arithmetic_semantics(inout b);
    in_i64(inout b);
    divergence(inout b);
    let mut n = PRELUDE_DECLARATIONS;
    n = wrapping_add(n, adt_groups(inout b, in t, in wd));
    n = wrapping_add(n, effect_classes(inout b, in t, in wd, in fx));
    n = wrapping_add(n, effect_lifts(inout b, in fx));
    if has_fail_model(in b, in fx) {
        fail_models(inout b);
        n = wrapping_add(n, FAIL_MODEL_DECLARATIONS);
    }
    b.fill(count, n);
    b
}

fn printer_error(e: LeanError) -> Str {
    match e {
        LeanError::OneTuple => "Lean has no one-element tuple syntax",
        LeanError::NoBinders => "lambda/forall requires at least one binder",
        LeanError::ShortProduct => "product type needs at least two elements",
        LeanError::EmptyMatch => "empty match syntax is unsupported",
        LeanError::EmptyUpdate => "record update needs at least one field",
        LeanError::MutablePattern => "mutable do bindings require one local identifier",
        LeanError::EmptyStatementMatch => "empty statement match is unsupported; use nomatch",
        LeanError::OptionType => "option value has the wrong fixed type",
        LeanError::EmptyMutual => "empty mutual group",
        LeanError::RootedNamespace => "root-qualified namespace commands are unsupported",
    }
}

fn put(inout o: ChunkSeq[u8], in s: Str) {
    o.extend(in s.as_bytes());
}

// The head module's text, or `error: <message>` and a newline (what
// `lean::extract` returns for the world without its functions).
pub fn extract_head(in input: Str) -> ChunkSeq[u64] {
    let b = head(in input);
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    if b.failed {
        put(inout out, in "error: ");
        out.extend(in b.err.as_slice());
        put(inout out, in "\n");
        return pack_text(in out);
    }
    let pool = match String::from_utf8(in b.names.text.as_slice()) {
        Option::Some(s) => s,
        Option::None => String::new(),
    };
    let rendered: Result[String, LeanError] = handle Fail[LeanError] in {
        render_module(in b.words.as_slice(), in pool.as_str())
    } with {
        return x => Result::Ok(x),
        raise(error, k) => Result::Err(error),
    };
    match rendered {
        Result::Ok(text) => out.extend(in text.as_bytes()),
        Result::Err(e) => {
            put(inout out, in "error: ");
            put(inout out, in printer_error(e));
            put(inout out, in "\n");
        },
    }
    pack_text(in out)
}

// The number of words of the head (timing without the printer).
pub fn extract_head_words(in input: Str) -> u64 {
    let b = head(in input);
    b.words.len()
}
