// @vesper/lean-extract: Lean extraction (src/lean.rs, src/lean_ir.rs,
// src/lean_nodes.rs) in Vesper (self-hosting wave SH5 lane 18, #1341).
//
// Part 1 ports the head of the module `extract_report` builds: the
// prelude, the arithmetic simp set, the divergence class, the ADT groups
// with the getters of recursive structures, the effect classes and CPS
// lifts and the `Fail` models, wrapped in `import Std`, the unused-variable
// option and `namespace Vesper`. Part 2 ports the CFG extractor
// (src/lean_ir.rs) over the lowered program from @vesper/place-ir:
// `extract_cfg_functions`. The structured extractor, fuel companions and
// contracts are next.
//
// Built on @vesper/check-data (the harness input: the world's names, types
// and ADTs) and @vesper/lean-syntax (the printer). The extractor writes
// the printer's word stream directly (build.ves); the names table is its
// text pool. Rust stays the default extractor;
// tests/self_host_lean_extract.rs compares the text byte for byte.
//
// - build.ves: the word-stream builder and the identifier checks.
// - ty.ves: `ty_with_fip`.
// - prelude.ves: the fixed declarations.
// - head.ves: ADT groups (petgraph's Tarjan order), getters, effects.
// - input.ves: the effect section of the input.
// - fn_input.ves: signatures, call types and lifted closures (part 2).
// - cfg.ves: the CFG extractor's gate and liveness.
// - emit.ves: the CFG extractor's definitions.
// - ast.ves: the source AST section (part 3).
// - tm.ves: terms as word ranges of the builder.
// - gen.ves: the structured extractor (with effects and fuel companions).
// - module.ves: the whole module: ordering, companions, the proof module.
// - contract.ves: `f$contract` and `f$admissible`.

use @vesper/check-data::input::{Reader, read_ctx};
use @vesper/check-data::{pack_text};
use @vesper/lean-syntax::{LeanError, render_module};
use @vesper/check-data::names::{names_new};
use self::build::{B, D_NAMESPACE, D_OPTION, K_DEF, K_PARTIAL, builder};
use self::head::{adt_groups, effect_classes, effect_lifts, has_fail_model};
use self::input::{read_effects};
use self::fn_input::{read_fns};
use self::emit::{X, extract};
use self::head::{recursive_structs};
use @vesper/place-ir::{read_program};
use @vesper/check-data::world::{set_by_symbol};
use @vesper/check-data::util::{add, inc, n32, u32_at, u64_at};
use self::ast::{read_ast};
use self::contract::{contracts, read_contracts};
use self::module::{defs_new, K_NONCOMPUTABLE, emit_ordered, order, references_symbol, take_module};
use self::input::{Effects};
use @vesper/check-data::types::{Types};
use @vesper/check-data::world::{World};
use self::gen::{G, Y, function, gen_new};
use self::prelude::{
    arithmetic_semantics, arithmetic_simp_bundle, cps_monad, divergence, fail_models, handler_cps,
    in_i64, lift_action
};

// The prelude's declarations: HandlerCPS, its Monad, liftAction, the simp
// set, the semantics tag, inI64 and the four divergence declarations.
const PRELUDE_DECLARATIONS: u64 = 10;
const FAIL_MODEL_DECLARATIONS: u64 = 2;

// The head module as printer words.
fn head(in input: Str) -> B {
    let bytes = input.as_bytes();
    let mut reader = Reader { pos: 0 };
    let input_ctx = read_ctx(inout reader, in bytes);
    let effects = read_effects(inout reader, in bytes, in input_ctx.nmap, in input_ctx.tmap);
    let mut lean_builder = builder(names_new());
    lean_builder.names = input_ctx.names;
    let types = input_ctx.types;
    let world = input_ctx.world;
    // import Std
    lean_builder.w(1);
    lean_builder.w(1);
    lean_builder.text(in "Std");
    lean_builder.w(2);
    // set_option linter.unusedVariables false
    lean_builder.w(D_OPTION);
    lean_builder.w(0);
    lean_builder.w(0);
    lean_builder.w(0);
    // namespace Vesper
    lean_builder.w(D_NAMESPACE);
    lean_builder.name_fixed(in "Vesper");
    let count_at = lean_builder.hole();
    let decl_count = head_decls(inout lean_builder, in types, in world, in effects);
    lean_builder.fill(count_at, decl_count);
    lean_builder
}

// `import Std`, the unused-variable option and `namespace Vesper` up to
// the declaration count (a hole, returned).
fn module_header(inout lean_builder: B) -> u64 {
    lean_builder.w(1);
    lean_builder.w(1);
    lean_builder.text(in "Std");
    lean_builder.w(2);
    lean_builder.w(D_OPTION);
    lean_builder.w(0);
    lean_builder.w(0);
    lean_builder.w(0);
    lean_builder.w(D_NAMESPACE);
    lean_builder.name_fixed(in "Vesper");
    lean_builder.hole()
}

// The head's declarations into `lean_builder.words`; returns their number.
fn head_decls(inout lean_builder: B, in types: Types, in world: World, in effects: Effects) -> u64 {
    handler_cps(inout lean_builder);
    cps_monad(inout lean_builder);
    lift_action(inout lean_builder);
    arithmetic_simp_bundle(inout lean_builder);
    arithmetic_semantics(inout lean_builder);
    in_i64(inout lean_builder);
    divergence(inout lean_builder);
    let mut decl_count = PRELUDE_DECLARATIONS;
    decl_count = wrapping_add(decl_count, adt_groups(inout lean_builder, in types, in world));
    decl_count = wrapping_add(
        decl_count,
        effect_classes(inout lean_builder, in types, in world, in effects)
    );
    decl_count = wrapping_add(decl_count, effect_lifts(inout lean_builder, in effects));
    if has_fail_model(in lean_builder, in effects) {
        fail_models(inout lean_builder);
        decl_count = wrapping_add(decl_count, FAIL_MODEL_DECLARATIONS);
    }
    decl_count
}

fn printer_error(error: LeanError) -> Str {
    match error {
        LeanError::OneTuple => "Lean has no one-element tuple syntax",
        LeanError::NoBinders => "lambda/forall requires at least one binder",
        LeanError::ShortProduct => "product type needs at least two elements",
        LeanError::EmptyMatch => "empty match syntax is unsupported",
        LeanError::EmptyUpdate => "record update needs at least one field",
        LeanError::MutablePattern => "mutable do bindings require one local identifier",
        LeanError::EmptyStatementMatch => "empty statement match is unsupported; use nomatch",
        LeanError::OptionType => "option value has the wrong fixed type",
        LeanError::EmptyMutual => "empty mutual group",
        LeanError::RootedNamespace => "root-qualified namespace commands are unsupported",
    }
}

fn put(inout out: ChunkSeq[u8], in text: Str) {
    out.extend(in text.as_bytes());
}

// The head module's text, or `error: <message>` and a newline (what
// `lean::extract` returns for the world without its functions).
pub fn extract_head(in input: Str) -> ChunkSeq[u64] {
    let lean_builder = head(in input);
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    if lean_builder.failed {
        put(inout out, in "error: ");
        out.extend(in lean_builder.err.as_slice());
        put(inout out, in "\n");
        return pack_text(in out);
    }
    let pool = match String::from_utf8(in lean_builder.names.text.as_slice()) {
        Option::Some(s) => s,
        Option::None => String::new(),
    };
    let rendered: Result[String, LeanError] = handle Fail[LeanError] in {
        render_module(in lean_builder.words.as_slice(), in pool.as_str())
    } with {
        return x => Result::Ok(x),
        raise(error, k) => Result::Err(error),
    };
    match rendered {
        Result::Ok(text) => out.extend(in text.as_bytes()),
        Result::Err(printer_err) => {
            put(inout out, in "error: ");
            put(inout out, in printer_error(printer_err));
            put(inout out, in "\n");
        },
    }
    pack_text(in out)
}

// The number of words of the head (timing without the printer).
pub fn extract_head_words(in input: Str) -> u64 {
    let lean_builder = head(in input);
    lean_builder.words.len()
}

// ----- part 2: the CFG extractor ---------------------------------------------------

fn put_part(inout out: ChunkSeq[u8], in bytes: Slice[u8], start: u64, end: u64) {
    out.extend(in bytes[start..end]);
}

fn render_part(
    in words: Slice[u64],
    start: u64,
    end: u64,
    in pool: Str
) -> Result[String, LeanError] {
    handle Fail[LeanError] in {
        render_module(in words[start..end], in pool)
    } with {
        return text => Result::Ok(text),
        raise(error, k) => Result::Err(error),
    }
}

const ST_NONE: u64 = 0;
const ST_ERROR: u64 = 1;
const ST_OK: u64 = 2;

// Per source function with IR (name order), `fn <name>` and what
// `lean_ir::extract_function_nodes` gives: `none` (the structured
// extractor's), `error: <message>`, or the definitions as a module without
// imports (tests/self_host_lean_extract.rs `rust_cfg_text`).
pub fn extract_cfg_functions(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mut reader = Reader { pos: 0 };
    let input_ctx = read_ctx(inout reader, in bytes);
    let program = read_program(inout reader, in bytes, in input_ctx);
    let fns = read_fns(inout reader, in bytes, in input_ctx.nmap, in input_ctx.tmap);
    let mut lean_builder = builder(names_new());
    lean_builder.names = input_ctx.names;
    let mut types = input_ctx.types;
    let world = input_ctx.world;
    let rec = recursive_structs(in lean_builder, in types, in world);
    let mut by_name: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..program.fn_count() {
        set_by_symbol(inout by_name, program.function(i).name, n32(inc(i)));
    }
    let fip = world.box_active;
    let env = X {
        program: program,
        world: world,
        fns: fns,
        fip: fip,
        recursive_structs: rec,
        fn_by_name: by_name
    };
    // per function: name, status, words[wa..wz] or errs[wa..wz]
    let mut names: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut status: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut starts: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut ends: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut all: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut errs: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for i in 0..env.program.fn_count() {
        let row = env.program.function(i);
        let sig_index = env.fns.find(row.name);
        if sig_index != 4294967295 && env.fns.sig(widen_u64(sig_index)).source {
            lean_builder.words.clear();
            lean_builder.failed = false;
            lean_builder.err.clear();
            lean_builder.quiet = 0;
            lean_builder.w(0);
            let count_at = lean_builder.hole();
            let mut count: u64 = 0;
            let taken = extract(inout lean_builder, inout types, in env, i, inout count);
            lean_builder.fill(count_at, count);
            names.push(row.name);
            if !taken {
                status.push(ST_NONE);
                starts.push(0);
                ends.push(0);
            } else if lean_builder.failed {
                status.push(ST_ERROR);
                starts.push(errs.len());
                errs.extend(in lean_builder.err.as_slice());
                ends.push(errs.len());
            } else {
                status.push(ST_OK);
                starts.push(all.len());
                for k in 0..lean_builder.words.len() {
                    all.push(u64_at(in lean_builder.words, k));
                }
                ends.push(all.len());
            }
        }
    }
    let pool = match String::from_utf8(in lean_builder.names.text.as_slice()) {
        Option::Some(s) => s,
        Option::None => String::new(),
    };
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for k in 0..names.len() {
        put(inout out, in "fn ");
        lean_builder.names.write(u32_at(in names, k), inout out);
        put(inout out, in "\n");
        let fn_status = u64_at(in status, k);
        let start = u64_at(in starts, k);
        let end = u64_at(in ends, k);
        if fn_status == ST_NONE {
            put(inout out, in "none\n");
        } else if fn_status == ST_ERROR {
            put(inout out, in "error: ");
            put_part(inout out, in errs.as_slice(), start, end);
            put(inout out, in "\n");
        } else {
            let rendered = render_part(in all.as_slice(), start, end, in pool.as_str());
            match rendered {
                Result::Ok(text) => out.extend(in text.as_bytes()),
                Result::Err(printer_err) => {
                    put(inout out, in "error: ");
                    put(inout out, in printer_error(printer_err));
                    put(inout out, in "\n");
                },
            }
        }
    }
    pack_text(in out)
}

// ----- part 3: the structured extractor ----------------------------------------------

const ST_SKIP: u64 = 3;

// Per source function with IR (name order), `fn <name>` and what
// `lean::structured_function_nodes` gives: `none` (the CFG extractor's, or
// one that needs the ambient monad), `error: <message>`, or the definition
// as a module without imports; `skip` where this part does not port the
// function yet (tests/self_host_lean_extract.rs `rust_structured_text`).
pub fn extract_structured_functions(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mut reader = Reader { pos: 0 };
    let input_ctx = read_ctx(inout reader, in bytes);
    let program = read_program(inout reader, in bytes, in input_ctx);
    let fns = read_fns(inout reader, in bytes, in input_ctx.nmap, in input_ctx.tmap);
    let ast = read_ast(inout reader, in bytes, in input_ctx.nmap, in input_ctx.tmap);
    let mut lean_builder = builder(names_new());
    lean_builder.names = input_ctx.names;
    let mut types = input_ctx.types;
    let world = input_ctx.world;
    let rec = recursive_structs(in lean_builder, in types, in world);
    let mut by_name: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..program.fn_count() {
        set_by_symbol(inout by_name, program.function(i).name, n32(inc(i)));
    }
    let fip = world.box_active;
    let infer = types.infer;
    let env = X {
        program: program,
        world: world,
        fns: fns,
        fip: fip,
        recursive_structs: rec,
        fn_by_name: by_name
    };
    let fip_ast = ast.fip;
    let ctx = Y { env: env, ast: ast, fip: fip_ast, infer: infer };
    let mut gen = gen_new();
    let mut names: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut status: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut starts: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut ends: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut all: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut errs: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for i in 0..ctx.ast.fns.len() {
        let func = ctx.ast.function(i);
        let program_entry = u32_at(in ctx.env.fn_by_name, widen_u64(func.name));
        if program_entry != 0 {
            names.push(func.name);
            lean_builder.words.clear();
            lean_builder.failed = false;
            lean_builder.err.clear();
            lean_builder.quiet = 0;
            let mut count: u64 = 0;
            let taken = extract(
                inout lean_builder,
                inout types,
                in ctx.env,
                wrapping_sub(widen_u64(program_entry), 1),
                inout count
            );
            lean_builder.words.clear();
            lean_builder.failed = false;
            lean_builder.err.clear();
            lean_builder.quiet = 0;
            if taken {
                status.push(ST_NONE);
                starts.push(0);
                ends.push(0);
            } else {
                gen.reset();
                let def_term = function(inout lean_builder, inout types, in ctx, inout gen, i);
                if gen.skip {
                    status.push(ST_SKIP);
                    starts.push(0);
                    ends.push(0);
                } else if lean_builder.failed {
                    status.push(ST_ERROR);
                    starts.push(errs.len());
                    errs.extend(in lean_builder.err.as_slice());
                    ends.push(errs.len());
                } else {
                    status.push(ST_OK);
                    starts.push(all.len());
                    for k in 0..def_term.n {
                        all.push(u64_at(in lean_builder.words, add(def_term.a, k)));
                    }
                    ends.push(all.len());
                }
            }
        }
    }
    let pool = match String::from_utf8(in lean_builder.names.text.as_slice()) {
        Option::Some(s) => s,
        Option::None => String::new(),
    };
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for k in 0..names.len() {
        put(inout out, in "fn ");
        lean_builder.names.write(u32_at(in names, k), inout out);
        put(inout out, in "\n");
        let fn_status = u64_at(in status, k);
        let start = u64_at(in starts, k);
        let end = u64_at(in ends, k);
        if fn_status == ST_NONE {
            put(inout out, in "none\n");
        } else if fn_status == ST_SKIP {
            put(inout out, in "skip\n");
        } else if fn_status == ST_ERROR {
            put(inout out, in "error: ");
            put_part(inout out, in errs.as_slice(), start, end);
            put(inout out, in "\n");
        } else {
            let rendered = render_part(in all.as_slice(), start, end, in pool.as_str());
            match rendered {
                Result::Ok(text) => out.extend(in text.as_bytes()),
                Result::Err(printer_err) => {
                    put(inout out, in "error: ");
                    put(inout out, in printer_error(printer_err));
                    put(inout out, in "\n");
                },
            }
        }
    }
    pack_text(in out)
}

// ----- part 3c: the whole module ---------------------------------------------------

fn put_error(inout out: ChunkSeq[u8], in err: Slice[u8]) {
    put(inout out, in "error: ");
    out.extend(in err);
    put(inout out, in "\n");
}

fn render_words(inout out: ChunkSeq[u8], in lean_builder: B, in pool: Str) -> bool {
    let rendered = render_part(
        in lean_builder.words.as_slice(),
        0,
        lean_builder.words.len(),
        in pool
    );
    match rendered {
        Result::Ok(text) => {
            out.extend(in text.as_bytes());
            true
        },
        Result::Err(printer_err) => {
            out.clear();
            put(inout out, in "error: ");
            put(inout out, in printer_error(printer_err));
            put(inout out, in "\n");
            false
        },
    }
}

const TOTAL: u64 = 0;
const FUEL: u64 = 1;
const PARTIAL: u64 = 2;
const NONE: u64 = 18446744073709551615;

// `lean::extract_report` of the world: the module, `-- proof` and the
// proof module, `-- omitted` and the omitted executable definitions, and
// `-- totality` with one `name: total|fuel|partial: reason` line per
// function, then `-- contracts` and the contracted functions; or `error: <message>` (tests/self_host_lean_extract.rs
// `rust_module_text`). The input is the structured input followed by the
// effect section and the contract section (contract.ves).
pub fn extract_module(in input: Str) -> ChunkSeq[u64] {
    module_text(in input.as_bytes(), true)
}

// `lean::extract` of the world: the module alone, or `error: <message>`,
// packed by `pack_text`; the text the hybrid's `lean_extract` swap returns.
pub fn extract_text(in input: Slice[u8]) -> ChunkSeq[u64] {
    module_text(in input, false)
}

// [`extract_module`], or with `full` false only its module.
fn module_text(in bytes: Slice[u8], full: bool) -> ChunkSeq[u64] {
    let mut reader = Reader { pos: 0 };
    let input_ctx = read_ctx(inout reader, in bytes);
    let program = read_program(inout reader, in bytes, in input_ctx);
    let fns = read_fns(inout reader, in bytes, in input_ctx.nmap, in input_ctx.tmap);
    let ast = read_ast(inout reader, in bytes, in input_ctx.nmap, in input_ctx.tmap);
    let effects = read_effects(inout reader, in bytes, in input_ctx.nmap, in input_ctx.tmap);
    let all_contracts = read_contracts(inout reader, in bytes, in input_ctx.nmap);
    let mut lean_builder = builder(names_new());
    lean_builder.names = input_ctx.names;
    let mut types = input_ctx.types;
    let world = input_ctx.world;
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    // the head
    let head_count = head_decls(inout lean_builder, in types, in world, in effects);
    if lean_builder.failed {
        put_error(inout out, in lean_builder.err.as_slice());
        return pack_text(in out);
    }
    let mut head_words: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for k in 0..lean_builder.words.len() {
        head_words.push(u64_at(in lean_builder.words, k));
    }
    let rec = recursive_structs(in lean_builder, in types, in world);
    let mut by_name: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..program.fn_count() {
        set_by_symbol(inout by_name, program.function(i).name, n32(inc(i)));
    }
    let fip = world.box_active;
    let infer = types.infer;
    let env = X {
        program: program,
        world: world,
        fns: fns,
        fip: fip,
        recursive_structs: rec,
        fn_by_name: by_name
    };
    let fip_ast = ast.fip;
    let ctx = Y { env: env, ast: ast, fip: fip_ast, infer: infer };
    let mut gen = gen_new();
    let mut defs = defs_new();
    let fn_count = ctx.ast.fns.len();
    // the executable definitions
    for i in 0..fn_count {
        let func = ctx.ast.function(i);
        let program_entry = u32_at(in ctx.env.fn_by_name, widen_u64(func.name));
        lean_builder.words.clear();
        lean_builder.failed = false;
        lean_builder.err.clear();
        lean_builder.quiet = 0;
        lean_builder.w(0);
        let count_at = lean_builder.hole();
        let mut count: u64 = 0;
        let mut taken = false;
        if program_entry != 0 {
            taken = extract(
                inout lean_builder,
                inout types,
                in ctx.env,
                wrapping_sub(widen_u64(program_entry), 1),
                inout count
            );
        }
        if taken {
            if lean_builder.failed {
                put_error(inout out, in lean_builder.err.as_slice());
                return pack_text(in out);
            }
            lean_builder.fill(count_at, count);
            if !take_module(inout lean_builder, inout defs, i) {
                put(
                    inout out,
                    in "error: Lean CFG extractor returned a non-function declaration\n"
                );
                return pack_text(in out);
            }
        } else {
            lean_builder.words.clear();
            lean_builder.failed = false;
            lean_builder.err.clear();
            lean_builder.quiet = 0;
            gen.reset();
            let def_term = function(inout lean_builder, inout types, in ctx, inout gen, i);
            if lean_builder.failed {
                put_error(inout out, in lean_builder.err.as_slice());
                return pack_text(in out);
            }
            if gen.skip {
                put(inout out, in "skip\n");
                return pack_text(in out);
            }
            // the definition module at the end of the words
            let mut words: ChunkSeq[u64] = ChunkSeq::new[u64]();
            for k in 0..def_term.n {
                words.push(u64_at(in lean_builder.words, add(def_term.a, k)));
            }
            lean_builder.words = words;
            let ok = take_module(inout lean_builder, inout defs, i);
        }
    }
    let mut family: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let exec = order(inout lean_builder, in defs, 0, K_PARTIAL, inout family);
    // the total companions of the recursive family
    gen.fuel = true;
    for i in 0..fn_count {
        if u32_at(in family, i) != 0 {
            set_by_symbol(inout gen.family, ctx.ast.function(i).name, 1);
        }
    }
    let mut status: ChunkSeq[u64] = ChunkSeq::new[u64]();
    // per function: its companion definition index, or NONE
    let mut companion: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut reasons: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut reason_starts: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut reason_ends: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut companion_defs = defs_new();
    for i in 0..fn_count {
        reason_starts.push(0);
        reason_ends.push(0);
        companion.push(NONE);
        if u32_at(in family, i) == 0 {
            status.push(TOTAL);
        } else {
            lean_builder.words.clear();
            lean_builder.failed = false;
            lean_builder.err.clear();
            lean_builder.quiet = 0;
            gen.reset();
            let def_term = function(inout lean_builder, inout types, in ctx, inout gen, i);
            if lean_builder.failed {
                status.push(PARTIAL);
                let ok1 = reason_starts.try_set(i, reasons.len());
                reasons.extend(in lean_builder.err.as_slice());
                let ok2 = reason_ends.try_set(i, reasons.len());
            } else {
                status.push(FUEL);
                let mut words: ChunkSeq[u64] = ChunkSeq::new[u64]();
                for k in 0..def_term.n {
                    words.push(u64_at(in lean_builder.words, add(def_term.a, k)));
                }
                lean_builder.words = words;
                let ok1 = companion.try_set(i, companion_defs.defs.len());
                let ok = take_module(inout lean_builder, inout companion_defs, i);
            }
        }
    }
    // a companion that calls a missing companion cannot elaborate
    let mut fuel_syms: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..fn_count {
        let fuel_sym = lean_builder.joined(in "", ctx.ast.function(i).name, in "$fuel");
        fuel_syms.push(fuel_sym);
    }
    loop {
        let mut found = false;
        let mut owner: u64 = 0;
        let mut callee: u64 = 0;
        for i in 0..fn_count {
            let companion_index = u64_at(in companion, i);
            if companion_index != NONE && !found {
                let companion_def = match companion_defs.defs.try_get(companion_index) {
                    Option::Some(def) => def,
                    Option::None => break,
                };
                for j in 0..fn_count {
                    if !found && u32_at(in family, j) != 0 && u64_at(in companion, j) == NONE {
                        if references_symbol(
                            in lean_builder,
                            in companion_defs,
                            companion_def,
                            u32_at(in fuel_syms, j)
                        ) {
                            found = true;
                            owner = i;
                            callee = j;
                        }
                    }
                }
            }
        }
        if !found {
            break;
        }
        let ok0 = companion.try_set(owner, NONE);
        let ok1 = status.try_set(owner, PARTIAL);
        let ok2 = reason_starts.try_set(owner, reasons.len());
        put(inout reasons, in "calls '");
        lean_builder.names.write(ctx.ast.function(callee).name, inout reasons);
        put(inout reasons, in "', which has no total fuel companion");
        let ok3 = reason_ends.try_set(owner, reasons.len());
    }
    // the remaining companions, in owner order
    let mut kept = defs_new();
    for k in 0..companion_defs.words.len() {
        kept.words.push(u64_at(in companion_defs.words, k));
    }
    for i in 0..fn_count {
        let companion_index = u64_at(in companion, i);
        if companion_index != NONE {
            match companion_defs.defs.try_get(companion_index) {
                Option::Some(def) => kept.defs.push(def),
                Option::None => {},
            }
        }
    }
    let mut unused: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let fuel_ordered = order(inout lean_builder, in kept, 0, K_DEF, inout unused);
    // the contracts
    let mut contract_words: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut contract_names: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut contract_err: ChunkSeq[u8] = ChunkSeq::new[u8]();
    if !contracts(
        inout lean_builder,
        inout types,
        in ctx,
        in all_contracts,
        in status,
        in reasons,
        in reason_starts,
        in reason_ends,
        inout contract_words,
        inout contract_names,
        inout contract_err
    ) {
        put_error(inout out, in contract_err.as_slice());
        return pack_text(in out);
    }
    let contract_count = wrapping_mul(contract_names.len(), 2);
    let none: ChunkSeq[u32] = ChunkSeq::new[u32]();
    // the module
    lean_builder.words.clear();
    let module_count_at = module_header(inout lean_builder);
    for k in 0..head_words.len() {
        lean_builder.w(u64_at(in head_words, k));
    }
    let exec_count = emit_ordered(inout lean_builder, in defs, in exec, in none, false, NONE);
    let fuel_count = emit_ordered(
        inout lean_builder,
        in kept,
        in fuel_ordered,
        in none,
        false,
        NONE
    );
    for k in 0..contract_words.len() {
        lean_builder.w(u64_at(in contract_words, k));
    }
    lean_builder
        .fill(module_count_at, add(add(head_count, contract_count), add(exec_count, fuel_count)));
    let pool = match String::from_utf8(in lean_builder.names.text.as_slice()) {
        Option::Some(s) => s,
        Option::None => String::new(),
    };
    if !render_words(inout out, in lean_builder, in pool.as_str()) || !full {
        return pack_text(in out);
    }
    // the proof module
    put(inout out, in "-- proof\n");
    lean_builder.words.clear();
    let proof_count_at = module_header(inout lean_builder);
    for k in 0..head_words.len() {
        lean_builder.w(u64_at(in head_words, k));
    }
    let proof_exec_count = emit_ordered(
        inout lean_builder,
        in defs,
        in exec,
        in family,
        true,
        NONE
    );
    let proof_fuel_count = emit_ordered(
        inout lean_builder,
        in kept,
        in fuel_ordered,
        in none,
        false,
        K_NONCOMPUTABLE
    );
    for k in 0..contract_words.len() {
        lean_builder.w(u64_at(in contract_words, k));
    }
    lean_builder.fill(
        proof_count_at,
        add(add(head_count, contract_count), add(proof_exec_count, proof_fuel_count))
    );
    let pool2 = match String::from_utf8(in lean_builder.names.text.as_slice()) {
        Option::Some(s) => s,
        Option::None => String::new(),
    };
    if !render_words(inout out, in lean_builder, in pool2.as_str()) {
        return pack_text(in out);
    }
    // the omitted executable definitions, sorted
    put(inout out, in "-- omitted\n");
    let mut omitted: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for k in 0..defs.defs.len() {
        let def = match defs.defs.try_get(k) {
            Option::Some(v) => v,
            Option::None => break,
        };
        if u32_at(in family, def.owner) != 0 {
            let mut pos = omitted.len();
            omitted.push(def.key);
            loop {
                if pos == 0 {
                    break;
                }
                let prev = u32_at(in omitted, wrapping_sub(pos, 1));
                if !sym_less(in lean_builder, def.key, prev) {
                    break;
                }
                let o1 = omitted.try_set(pos, prev);
                let o2 = omitted.try_set(wrapping_sub(pos, 1), def.key);
                pos = wrapping_sub(pos, 1);
            }
        }
    }
    for k in 0..omitted.len() {
        put(inout out, in "Vesper.");
        lean_builder.names.write(u32_at(in omitted, k), inout out);
        put(inout out, in "\n");
    }
    // the totality of every function
    put(inout out, in "-- totality\n");
    for i in 0..fn_count {
        lean_builder.names.write(ctx.ast.function(i).name, inout out);
        let fn_status = u64_at(in status, i);
        if fn_status == TOTAL {
            put(inout out, in ": total\n");
        } else if fn_status == FUEL {
            put(inout out, in ": fuel\n");
        } else {
            put(inout out, in ": partial: ");
            put_part(
                inout out,
                in reasons.as_slice(),
                u64_at(in reason_starts, i),
                u64_at(in reason_ends, i)
            );
            put(inout out, in "\n");
        }
    }
    put(inout out, in "-- contracts\n");
    for k in 0..contract_names.len() {
        lean_builder.names.write(u32_at(in contract_names, k), inout out);
        put(inout out, in "\n");
    }
    pack_text(in out)
}

// Byte order of two symbols' texts.
fn sym_less(in lean_builder: B, x: u32, y: u32) -> bool {
    let x_len = lean_builder.names.size(x);
    let y_len = lean_builder.names.size(y);
    let len = if x_len < y_len { x_len } else { y_len };
    for i in 0..len {
        let x_byte = lean_builder.names.byte(x, i);
        let y_byte = lean_builder.names.byte(y, i);
        if x_byte != y_byte {
            return x_byte < y_byte;
        }
    }
    x_len < y_len
}
