// @vesper/lean-extract: Lean extraction (src/lean.rs, src/lean_ir.rs,
// src/lean_nodes.rs) in Vesper (self-hosting wave SH5 lane 18, #1341).
//
// Part 1 ports the head of the module `extract_report` builds: the
// prelude, the arithmetic simp set, the divergence class, the ADT groups
// with the getters of recursive structures, the effect classes and CPS
// lifts and the `Fail` models, wrapped in `import Std`, the unused-variable
// option and `namespace Vesper`. Part 2 ports the CFG extractor
// (src/lean_ir.rs) over the lowered program from @vesper/place-ir:
// `extract_cfg_functions`. The structured extractor, fuel companions and
// contracts are next.
//
// Built on @vesper/check-data (the harness input: the world's names, types
// and ADTs) and @vesper/lean-syntax (the printer). The extractor writes
// the printer's word stream directly (build.ves); the names table is its
// text pool. Rust stays the default extractor;
// tests/self_host_lean_extract.rs compares the text byte for byte.
//
// - build.ves: the word-stream builder and the identifier checks.
// - ty.ves: `ty_with_fip`.
// - prelude.ves: the fixed declarations.
// - head.ves: ADT groups (petgraph's Tarjan order), getters, effects.
// - input.ves: the effect section of the input.
// - fn_input.ves: signatures, call types and lifted closures (part 2).
// - cfg.ves: the CFG extractor's gate and liveness.
// - emit.ves: the CFG extractor's definitions.
// - ast.ves: the source AST section (part 3).
// - tm.ves: terms as word ranges of the builder.
// - gen.ves: the structured extractor over `Id`.

use @vesper/check-data::input::{
    Reader,
    read_ctx
};
use @vesper/check-data::{
    pack_text
};
use @vesper/lean-syntax::{
    LeanError,
    render_module
};
use @vesper/check-data::names::{
    names_new
};
use self::build::{
    B,
    D_NAMESPACE,
    D_OPTION,
    builder
};
use self::head::{
    adt_groups,
    effect_classes,
    effect_lifts,
    has_fail_model
};
use self::input::{
    read_effects
};
use self::fn_input::{
    read_fns
};
use self::emit::{
    X,
    extract
};
use self::head::{
    recursive_structs
};
use @vesper/place-ir::{
    read_program
};
use @vesper/check-data::world::{
    set_by_symbol
};
use @vesper/check-data::util::{
    add,
    inc,
    n32,
    u32_at,
    u64_at
};
use self::ast::{
    read_ast
};
use self::gen::{
    G,
    Y,
    function,
    gen_new
};
use self::prelude::{
    arithmetic_semantics,
    arithmetic_simp_bundle,
    cps_monad,
    divergence,
    fail_models,
    handler_cps,
    in_i64,
    lift_action
};

// The prelude's declarations: HandlerCPS, its Monad, liftAction, the simp
// set, the semantics tag, inI64 and the four divergence declarations.
const PRELUDE_DECLARATIONS: u64 = 10;
const FAIL_MODEL_DECLARATIONS: u64 = 2;

// The head module as printer words.
fn head(in input: Str) -> B {
    let bytes = input.as_bytes();
    let mut r = Reader {
        pos: 0
    };
    let c = read_ctx(inout r, in bytes);
    let fx = read_effects(inout r, in bytes, in c.nmap, in c.tmap);
    let mut b = builder(names_new());
    b.names = c.names;
    let t = c.types;
    let wd = c.world;
    // import Std
    b.w(1);
    b.w(1);
    b.text(in "Std");
    b.w(2);
    // set_option linter.unusedVariables false
    b.w(D_OPTION);
    b.w(0);
    b.w(0);
    b.w(0);
    // namespace Vesper
    b.w(D_NAMESPACE);
    b.name_fixed(in "Vesper");
    let count = b.hole();
    handler_cps(inout b);
    cps_monad(inout b);
    lift_action(inout b);
    arithmetic_simp_bundle(inout b);
    arithmetic_semantics(inout b);
    in_i64(inout b);
    divergence(inout b);
    let mut n = PRELUDE_DECLARATIONS;
    n = wrapping_add(n, adt_groups(inout b, in t, in wd));
    n = wrapping_add(n, effect_classes(inout b, in t, in wd, in fx));
    n = wrapping_add(n, effect_lifts(inout b, in fx));
    if has_fail_model(in b, in fx) {
        fail_models(inout b);
        n = wrapping_add(n, FAIL_MODEL_DECLARATIONS);
    }
    b.fill(count, n);
    b
}

fn printer_error(e: LeanError) -> Str {
    match e {
        LeanError::OneTuple => "Lean has no one-element tuple syntax",
        LeanError::NoBinders => "lambda/forall requires at least one binder",
        LeanError::ShortProduct => "product type needs at least two elements",
        LeanError::EmptyMatch => "empty match syntax is unsupported",
        LeanError::EmptyUpdate => "record update needs at least one field",
        LeanError::MutablePattern => "mutable do bindings require one local identifier",
        LeanError::EmptyStatementMatch => "empty statement match is unsupported; use nomatch",
        LeanError::OptionType => "option value has the wrong fixed type",
        LeanError::EmptyMutual => "empty mutual group",
        LeanError::RootedNamespace => "root-qualified namespace commands are unsupported",
    }
}

fn put(inout o: ChunkSeq[u8], in s: Str) {
    o.extend(in s.as_bytes());
}

// The head module's text, or `error: <message>` and a newline (what
// `lean::extract` returns for the world without its functions).
pub fn extract_head(in input: Str) -> ChunkSeq[u64] {
    let b = head(in input);
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    if b.failed {
        put(inout out, in "error: ");
        out.extend(in b.err.as_slice());
        put(inout out, in "\n");
        return pack_text(in out);
    }
    let pool = match String::from_utf8(in b.names.text.as_slice()) {
        Option::Some(s) => s,
        Option::None => String::new(),
    };
    let rendered: Result[String, LeanError] = handle Fail[LeanError] in {
        render_module(in b.words.as_slice(), in pool.as_str())
    } with {
        return x => Result::Ok(x),
        raise(error, k) => Result::Err(error),
    };
    match rendered {
        Result::Ok(text) => out.extend(in text.as_bytes()),
        Result::Err(e) => {
            put(inout out, in "error: ");
            put(inout out, in printer_error(e));
            put(inout out, in "\n");
        },
    }
    pack_text(in out)
}

// The number of words of the head (timing without the printer).
pub fn extract_head_words(in input: Str) -> u64 {
    let b = head(in input);
    b.words.len()
}

// ----- part 2: the CFG extractor ---------------------------------------------------

fn put_part(inout out: ChunkSeq[u8], in s: Slice[u8], a: u64, z: u64) {
    out.extend(in s[a..z]);
}

fn render_part(in words: Slice[u64], a: u64, z: u64, in pool: Str) -> Result[String, LeanError] {
    handle Fail[LeanError] in {
        render_module(in words[a..z], in pool)
    } with {
        return v => Result::Ok(v),
        raise(error, k) => Result::Err(error),
    }
}

const ST_NONE: u64 = 0;
const ST_ERROR: u64 = 1;
const ST_OK: u64 = 2;

// Per source function with IR (name order), `fn <name>` and what
// `lean_ir::extract_function_nodes` gives: `none` (the structured
// extractor's), `error: <message>`, or the definitions as a module without
// imports (tests/self_host_lean_extract.rs `rust_cfg_text`).
pub fn extract_cfg_functions(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mut r = Reader {
        pos: 0
    };
    let c = read_ctx(inout r, in bytes);
    let p = read_program(inout r, in bytes, in c);
    let fx = read_fns(inout r, in bytes, in c.nmap, in c.tmap);
    let mut b = builder(names_new());
    b.names = c.names;
    let mut t = c.types;
    let wd = c.world;
    let rec = recursive_structs(in b, in t, in wd);
    let mut by_name: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..p.fn_count() {
        set_by_symbol(inout by_name, p.function(i).name, n32(inc(i)));
    }
    let fip = wd.box_active;
    let x = X {
        p: p,
        wd: wd,
        fx: fx,
        fip: fip,
        rec: rec,
        fn_by_name: by_name
    };
    // per function: name, status, words[wa..wz] or errs[wa..wz]
    let mut names: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut status: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut starts: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut ends: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut all: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut errs: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for i in 0..x.p.fn_count() {
        let row = x.p.function(i);
        let si = x.fx.find(row.name);
        if si != 4294967295 && x.fx.sig(widen_u64(si)).source {
            b.words.clear();
            b.failed = false;
            b.err.clear();
            b.quiet = 0;
            b.w(0);
            let count_at = b.hole();
            let mut count: u64 = 0;
            let taken = extract(inout b, inout t, in x, i, inout count);
            b.fill(count_at, count);
            names.push(row.name);
            if !taken {
                status.push(ST_NONE);
                starts.push(0);
                ends.push(0);
            } else if b.failed {
                status.push(ST_ERROR);
                starts.push(errs.len());
                errs.extend(in b.err.as_slice());
                ends.push(errs.len());
            } else {
                status.push(ST_OK);
                starts.push(all.len());
                for k in 0..b.words.len() {
                    all.push(u64_at(in b.words, k));
                }
                ends.push(all.len());
            }
        }
    }
    let pool = match String::from_utf8(in b.names.text.as_slice()) {
        Option::Some(s) => s,
        Option::None => String::new(),
    };
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for k in 0..names.len() {
        put(inout out, in "fn ");
        b.names.write(u32_at(in names, k), inout out);
        put(inout out, in "\n");
        let st = u64_at(in status, k);
        let a = u64_at(in starts, k);
        let z = u64_at(in ends, k);
        if st == ST_NONE {
            put(inout out, in "none\n");
        } else if st == ST_ERROR {
            put(inout out, in "error: ");
            put_part(inout out, in errs.as_slice(), a, z);
            put(inout out, in "\n");
        } else {
            let rendered = render_part(in all.as_slice(), a, z, in pool.as_str());
            match rendered {
                Result::Ok(text) => out.extend(in text.as_bytes()),
                Result::Err(e) => {
                    put(inout out, in "error: ");
                    put(inout out, in printer_error(e));
                    put(inout out, in "\n");
                },
            }
        }
    }
    pack_text(in out)
}

// ----- part 3: the structured extractor ----------------------------------------------

const ST_SKIP: u64 = 3;

// Per source function with IR (name order), `fn <name>` and what
// `lean::structured_function_nodes` gives: `none` (the CFG extractor's, or
// one that needs the ambient monad), `error: <message>`, or the definition
// as a module without imports; `skip` where this part does not port the
// function yet (tests/self_host_lean_extract.rs `rust_structured_text`).
pub fn extract_structured_functions(in input: Str) -> ChunkSeq[u64] {
    let bytes = input.as_bytes();
    let mut r = Reader {
        pos: 0
    };
    let c = read_ctx(inout r, in bytes);
    let p = read_program(inout r, in bytes, in c);
    let fx = read_fns(inout r, in bytes, in c.nmap, in c.tmap);
    let ast = read_ast(inout r, in bytes, in c.nmap, in c.tmap);
    let mut b = builder(names_new());
    b.names = c.names;
    let mut t = c.types;
    let wd = c.world;
    let rec = recursive_structs(in b, in t, in wd);
    let mut by_name: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..p.fn_count() {
        set_by_symbol(inout by_name, p.function(i).name, n32(inc(i)));
    }
    let fip = wd.box_active;
    let infer = t.infer;
    let x = X {
        p: p,
        wd: wd,
        fx: fx,
        fip: fip,
        rec: rec,
        fn_by_name: by_name
    };
    let fip_ast = ast.fip;
    let y = Y {
        x: x,
        a: ast,
        fip: fip_ast,
        infer: infer
    };
    let mut g = gen_new();
    let mut names: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut status: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut starts: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut ends: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut all: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut errs: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for i in 0..y.a.fns.len() {
        let f = y.a.function(i);
        let pi = u32_at(in y.x.fn_by_name, widen_u64(f.name));
        if pi != 0 {
            names.push(f.name);
            b.words.clear();
            b.failed = false;
            b.err.clear();
            b.quiet = 0;
            let mut count: u64 = 0;
            let taken = extract(
                inout b,
                inout t,
                in y.x,
                wrapping_sub(widen_u64(pi), 1),
                inout count
            );
            b.words.clear();
            b.failed = false;
            b.err.clear();
            b.quiet = 0;
            if taken || f.polymorphic {
                status.push(ST_NONE);
                starts.push(0);
                ends.push(0);
            } else {
                g.reset();
                let m = function(inout b, inout t, in y, inout g, i);
                if g.skip {
                    status.push(ST_SKIP);
                    starts.push(0);
                    ends.push(0);
                } else if b.failed {
                    status.push(ST_ERROR);
                    starts.push(errs.len());
                    errs.extend(in b.err.as_slice());
                    ends.push(errs.len());
                } else {
                    status.push(ST_OK);
                    starts.push(all.len());
                    for k in 0..m.n {
                        all.push(u64_at(in b.words, add(m.a, k)));
                    }
                    ends.push(all.len());
                }
            }
        }
    }
    let pool = match String::from_utf8(in b.names.text.as_slice()) {
        Option::Some(s) => s,
        Option::None => String::new(),
    };
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for k in 0..names.len() {
        put(inout out, in "fn ");
        b.names.write(u32_at(in names, k), inout out);
        put(inout out, in "\n");
        let st = u64_at(in status, k);
        let a = u64_at(in starts, k);
        let z = u64_at(in ends, k);
        if st == ST_NONE {
            put(inout out, in "none\n");
        } else if st == ST_SKIP {
            put(inout out, in "skip\n");
        } else if st == ST_ERROR {
            put(inout out, in "error: ");
            put_part(inout out, in errs.as_slice(), a, z);
            put(inout out, in "\n");
        } else {
            let rendered = render_part(in all.as_slice(), a, z, in pool.as_str());
            match rendered {
                Result::Ok(text) => out.extend(in text.as_bytes()),
                Result::Err(e) => {
                    put(inout out, in "error: ");
                    put(inout out, in printer_error(e));
                    put(inout out, in "\n");
                },
            }
        }
    }
    pack_text(in out)
}
