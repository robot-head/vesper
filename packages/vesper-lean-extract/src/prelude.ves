// The fixed declarations at the top of every extracted module
// (src/lean.rs `prelude`, `arithmetic_simp_bundle`, `divergence` and
// `fail_models`). Each function writes one declaration, in the order
// `extract_report` lists them.

use self::build::{
    B, B_EXPLICIT, B_IMPLICIT, D_DEF, D_INSTANCE, D_THEOREM, D_TYPE, K_ABBREV, K_DEF, OP_ADD,
    OP_AND, OP_EQ, OP_IFF, OP_LE, OP_LT, OP_MOD, OP_MUL, OP_SUB, P_BIND, S_BIND, TD_CLASS, T_ARROW,
    T_DO, T_FORALL, T_RECORD, T_STRING, T_UNARY, U_NEG
};

// `app(m, [x])` for fixed names.
fn m_of(inout builder: B, in x: Str) {
    builder.app_named(in "m", in x);
}

// `HandlerCPS S O m`.
fn cps_som(inout builder: B) {
    let mark = builder.app(3);
    builder.named(in "HandlerCPS");
    builder.args(mark);
    builder.arg();
    builder.named(in "S");
    builder.arg();
    builder.named(in "O");
    builder.arg();
    builder.named(in "m");
}

// `{S O : Type} {m : Type → Type}`.
fn som_binders(inout builder: B) {
    builder.implicit_type(in "S");
    builder.implicit_type(in "O");
    builder.binder(B_IMPLICIT, in "m");
    builder.monad_ty();
}

// `k a s`-shaped applications of fixed names.
fn call2(inout builder: B, in f: Str, in x: Str, in y: Str) {
    let mark = builder.app(2);
    builder.named(in f);
    builder.args(mark);
    builder.arg();
    builder.named(in x);
    builder.arg();
    builder.named(in y);
}

pub fn handler_cps(inout builder: B) {
    builder.w(D_DEF);
    builder.w(K_ABBREV);
    builder.name_fixed(in "HandlerCPS");
    builder.w(4);
    builder.binder(B_EXPLICIT, in "S");
    builder.type0();
    builder.binder(B_EXPLICIT, in "O");
    builder.type0();
    builder.binder(B_EXPLICIT, in "m");
    builder.monad_ty();
    builder.binder(B_EXPLICIT, in "A");
    builder.type0();
    builder.type0();
    // (A → S → m O) → S → m O
    builder.w(T_ARROW);
    builder.w(T_ARROW);
    builder.named(in "A");
    builder.w(T_ARROW);
    builder.named(in "S");
    m_of(inout builder, in "O");
    builder.w(T_ARROW);
    builder.named(in "S");
    m_of(inout builder, in "O");
}

pub fn cps_monad(inout builder: B) {
    builder.w(D_INSTANCE);
    builder.w(0);
    builder.w(4);
    som_binders(inout builder);
    builder.monad_instance();
    let mark = builder.app(1);
    builder.global(in "Monad");
    builder.args(mark);
    builder.arg();
    cps_som(inout builder);
    builder.w(T_RECORD);
    builder.w(2);
    // pure := fun a k s => k a s
    builder.text(in "pure");
    builder.lambda(3);
    builder.lambda_name(in "a");
    builder.lambda_name(in "k");
    builder.lambda_name(in "s");
    call2(inout builder, in "k", in "a", in "s");
    // bind := fun action next k s => action (fun a s' => next a k s') s
    builder.text(in "bind");
    builder.lambda(4);
    builder.lambda_name(in "action");
    builder.lambda_name(in "next");
    builder.lambda_name(in "k");
    builder.lambda_name(in "s");
    let outer = builder.app(2);
    builder.named(in "action");
    builder.args(outer);
    builder.arg();
    builder.lambda(2);
    builder.lambda_name(in "a");
    builder.lambda_name(in "s'");
    let inner = builder.app(3);
    builder.named(in "next");
    builder.args(inner);
    builder.arg();
    builder.named(in "a");
    builder.arg();
    builder.named(in "k");
    builder.arg();
    builder.named(in "s'");
    builder.arg();
    builder.named(in "s");
}

pub fn lift_action(inout builder: B) {
    builder.w(D_DEF);
    builder.w(K_DEF);
    builder.name_fixed(in "liftAction");
    builder.w(6);
    som_binders(inout builder);
    builder.implicit_type(in "A");
    builder.monad_instance();
    builder.binder(B_EXPLICIT, in "action");
    m_of(inout builder, in "A");
    // HandlerCPS S O m A
    let mark = builder.app(4);
    builder.named(in "HandlerCPS");
    builder.args(mark);
    builder.arg();
    builder.named(in "S");
    builder.arg();
    builder.named(in "O");
    builder.arg();
    builder.named(in "m");
    builder.arg();
    builder.named(in "A");
    // fun k s => do let value ← action; k value s
    builder.lambda(2);
    builder.lambda_name(in "k");
    builder.lambda_name(in "s");
    builder.w(T_DO);
    builder.w(1);
    builder.w(S_BIND);
    builder.w(P_BIND);
    builder.text(in "value");
    builder.named(in "action");
    call2(inout builder, in "k", in "value", in "s");
}

// `kind.toNat v` around a fixed name.
fn to_nat(inout builder: B, in kind: Str, in v: Str) {
    let mark = builder.app(1);
    builder.global2(in kind, in "toNat");
    builder.args(mark);
    builder.arg();
    builder.named(in v);
}

// `kind.toNat (x op y)`.
fn to_nat_op(inout builder: B, in kind: Str, op: u64) {
    let mark = builder.app(1);
    builder.global2(in kind, in "toNat");
    builder.args(mark);
    builder.arg();
    builder.binary(op);
    builder.named(in "x");
    builder.named(in "y");
}

// `(x y : kind)`.
fn xy_binders(inout builder: B, in kind: Str) {
    builder.w(2);
    builder.binder(B_EXPLICIT, in "x");
    builder.global(in kind);
    builder.binder(B_EXPLICIT, in "y");
    builder.global(in kind);
}

fn modulus(inout builder: B, width: u64) {
    if width == 8 {
        builder.nat(in "256");
    } else if width == 16 {
        builder.nat(in "65536");
    } else if width == 32 {
        builder.nat(in "4294967296");
    } else {
        builder.nat(in "18446744073709551616");
    }
}

fn kind_name(kind_index: u64) -> Str {
    if kind_index == 0 {
        "UInt8"
    } else if kind_index == 1 {
        "UInt16"
    } else if kind_index == 2 {
        "UInt32"
    } else {
        "UInt64"
    }
}

fn width_of(kind_index: u64) -> u64 {
    if kind_index == 0 {
        8
    } else if kind_index == 1 {
        16
    } else if kind_index == 2 {
        32
    } else {
        64
    }
}

// Rule `rule` (0..6) of kind `kind_index`: le, lt, add, sub, mul, ofNat.
fn rule_proposition(inout builder: B, kind_index: u64, rule: u64) {
    let kind = kind_name(kind_index);
    if rule < 2 {
        let op = if rule == 0 { OP_LE } else { OP_LT };
        builder.w(T_FORALL);
        xy_binders(inout builder, in kind);
        builder.binary(OP_IFF);
        builder.binary(op);
        builder.named(in "x");
        builder.named(in "y");
        builder.binary(op);
        to_nat(inout builder, in kind, in "x");
        to_nat(inout builder, in kind, in "y");
    } else if rule < 5 {
        let op = if rule == 2 {
            OP_ADD
        } else if rule == 3 {
            OP_SUB
        } else {
            OP_MUL
        };
        builder.w(T_FORALL);
        xy_binders(inout builder, in kind);
        builder.binary(OP_EQ);
        to_nat_op(inout builder, in kind, op);
        builder.binary(OP_MOD);
        if op == OP_SUB {
            builder.binary(OP_ADD);
            builder.binary(OP_SUB);
            modulus(inout builder, width_of(kind_index));
            to_nat(inout builder, in kind, in "y");
            to_nat(inout builder, in kind, in "x");
        } else {
            builder.binary(op);
            to_nat(inout builder, in kind, in "x");
            to_nat(inout builder, in kind, in "y");
        }
        modulus(inout builder, width_of(kind_index));
    } else {
        builder.w(T_FORALL);
        builder.w(1);
        builder.binder(B_EXPLICIT, in "n");
        builder.global(in "Nat");
        builder.binary(OP_EQ);
        let mark = builder.app(1);
        builder.global2(in kind, in "toNat");
        builder.args(mark);
        builder.arg();
        let inner = builder.app(1);
        builder.global2(in kind, in "ofNat");
        builder.args(inner);
        builder.arg();
        builder.named(in "n");
        builder.binary(OP_MOD);
        builder.named(in "n");
        modulus(inout builder, width_of(kind_index));
    }
}

fn lemma(rule: u64) -> Str {
    if rule == 0 {
        "le_iff_toNat_le"
    } else if rule == 1 {
        "lt_iff_toNat_lt"
    } else if rule == 2 {
        "toNat_add"
    } else if rule == 3 {
        "toNat_sub"
    } else if rule == 4 {
        "toNat_mul"
    } else {
        "toNat_ofNat"
    }
}

fn rule_proof(inout builder: B, kind_index: u64, rule: u64) {
    let kind = kind_name(kind_index);
    let name = lemma(rule);
    if rule < 5 {
        builder.lambda(2);
        builder.binder(B_EXPLICIT, in "x");
        builder.global(in kind);
        builder.binder(B_EXPLICIT, in "y");
        builder.global(in kind);
    } else {
        builder.lambda(1);
        builder.binder(B_EXPLICIT, in "n");
        builder.global(in "Nat");
    }
    if rule < 2 || rule == 5 {
        builder.global2(in kind, in name);
    } else {
        let mark = builder.app(2);
        builder.global2(in kind, in name);
        builder.args(mark);
        builder.arg();
        builder.named(in "x");
        builder.arg();
        builder.named(in "y");
    }
}

// `theorem $arith_simps : r0 ∧ (r1 ∧ ...) := And.intro e0 (And.intro e1 ...)`.
pub fn arithmetic_simp_bundle(inout builder: B) {
    let rules: u64 = 24;
    builder.w(D_THEOREM);
    builder.name_fixed(in "$arith_simps");
    builder.w(0);
    for rule_index in 0..rules {
        if wrapping_add(rule_index, 1) < rules {
            builder.binary(OP_AND);
        }
        rule_proposition(inout builder, rule_index / 6, rule_index % 6);
    }
    for rule_index in 0..rules {
        if wrapping_add(rule_index, 1) < rules {
            let mark = builder.app(2);
            builder.global2(in "And", in "intro");
            builder.args(mark);
            builder.arg();
            rule_proof(inout builder, rule_index / 6, rule_index % 6);
            builder.arg();
        } else {
            rule_proof(inout builder, rule_index / 6, rule_index % 6);
        }
    }
}

pub fn arithmetic_semantics(inout builder: B) {
    builder.w(D_DEF);
    builder.w(K_DEF);
    builder.name_fixed(in "$arithmetic_semantics");
    builder.w(0);
    builder.global(in "String");
    builder.w(T_STRING);
    // `numeric::ARITHMETIC_SEMANTICS`.
    builder.text(in "vesper.arith.checked/1");
}

pub fn in_i64(inout builder: B) {
    builder.w(D_DEF);
    builder.w(K_DEF);
    builder.name_fixed(in "inI64");
    builder.w(1);
    builder.binder(B_EXPLICIT, in "x");
    builder.global(in "Int");
    builder.global(in "Bool");
    let mark = builder.app(1);
    builder.global2(in "Decidable", in "decide");
    builder.args(mark);
    builder.arg();
    builder.binary(OP_AND);
    builder.binary(OP_LE);
    builder.w(T_UNARY);
    builder.w(U_NEG);
    builder.nat(in "9223372036854775808");
    builder.named(in "x");
    builder.binary(OP_LE);
    builder.named(in "x");
    builder.nat(in "9223372036854775807");
}

// `VesperDiverge.diverge`.
fn diverge(inout builder: B) {
    builder.w(1);
    builder.w(0);
    builder.w(2);
    builder.text(in "VesperDiverge");
    builder.text(in "diverge");
}

// `VesperDiverge x` where `x` is written by the caller.
fn diverge_class(inout builder: B) {
    let mark = builder.app(1);
    builder.named(in "VesperDiverge");
    builder.args(mark);
    builder.arg();
}

pub fn divergence(inout builder: B) {
    // class VesperDiverge (m : Type → Type) where diverge : ∀ {A : Type}, m A
    builder.w(D_TYPE);
    builder.w(TD_CLASS);
    builder.name_fixed(in "VesperDiverge");
    builder.w(1);
    builder.binder(B_EXPLICIT, in "m");
    builder.monad_ty();
    builder.w(1);
    builder.text(in "diverge");
    builder.w(T_FORALL);
    builder.w(1);
    builder.implicit_type(in "A");
    m_of(inout builder, in "A");
    builder.w(0);
    // instance [Monad m] [VesperDiverge m] : VesperDiverge (HandlerCPS S O m)
    builder.w(D_INSTANCE);
    builder.w(0);
    builder.w(5);
    som_binders(inout builder);
    builder.monad_instance();
    builder.instance_binder();
    diverge_class(inout builder);
    builder.named(in "m");
    diverge_class(inout builder);
    cps_som(inout builder);
    builder.w(T_RECORD);
    builder.w(1);
    builder.text(in "diverge");
    builder.lambda(2);
    builder.lambda_name(in "k");
    builder.lambda_name(in "s");
    diverge(inout builder);
    // instance : VesperDiverge Option
    builder.w(D_INSTANCE);
    builder.w(0);
    builder.w(0);
    diverge_class(inout builder);
    builder.global(in "Option");
    builder.w(T_RECORD);
    builder.w(1);
    builder.text(in "diverge");
    builder.global2(in "Option", in "none");
    // instance [Monad m] [VesperDiverge m] : VesperDiverge (ExceptT E m)
    builder.w(D_INSTANCE);
    builder.w(0);
    builder.w(4);
    builder.implicit_type(in "E");
    builder.binder(B_IMPLICIT, in "m");
    builder.monad_ty();
    builder.monad_instance();
    builder.instance_binder();
    diverge_class(inout builder);
    builder.named(in "m");
    diverge_class(inout builder);
    call_global2(inout builder, in "ExceptT", in "E", in "m");
    builder.w(T_RECORD);
    builder.w(1);
    builder.text(in "diverge");
    let mark = builder.app(1);
    builder.global2(in "ExceptT", in "lift");
    builder.args(mark);
    builder.arg();
    diverge(inout builder);
}

// `app(global(&[f]), [named(x), named(y)])`.
fn call_global2(inout builder: B, in f: Str, in x: Str, in y: Str) {
    let mark = builder.app(2);
    builder.global(in f);
    builder.args(mark);
    builder.arg();
    builder.named(in x);
    builder.arg();
    builder.named(in y);
}

// `Effect_Fail E <model>`: the model is written by the caller.
fn fail_head(inout builder: B) {
    let mark = builder.app(2);
    builder.named(in "Effect_Fail");
    builder.args(mark);
    builder.arg();
    builder.named(in "E");
    builder.arg();
}

// `{ raise := fun e => MonadExcept.throw e }`.
fn raise_record(inout builder: B) {
    builder.w(T_RECORD);
    builder.w(1);
    builder.text(in "raise");
    builder.lambda(1);
    builder.lambda_name(in "e");
    let mark = builder.app(1);
    builder.global2(in "MonadExcept", in "throw");
    builder.args(mark);
    builder.arg();
    builder.named(in "e");
}

pub fn fail_models(inout builder: B) {
    builder.w(D_INSTANCE);
    builder.w(0);
    builder.w(1);
    builder.implicit_type(in "E");
    fail_head(inout builder);
    builder.app_named_global(in "Except", in "E");
    raise_record(inout builder);
    builder.w(D_INSTANCE);
    builder.w(0);
    builder.w(3);
    builder.implicit_type(in "E");
    builder.binder(B_IMPLICIT, in "m");
    builder.monad_ty();
    builder.monad_instance();
    fail_head(inout builder);
    call_global2(inout builder, in "ExceptT", in "E", in "m");
    raise_record(inout builder);
}
