// Bootstrap switch slice 3d (#2659): @vesper/native-lib's calls input from
// Stage 2's own front end, for a package whose library roots are given.
//
// `vesper build --lib` hands the native walk the checker's world and the
// first lowering (`native_export::compile_exports`); the test harness
// encodes them as a calls input (tests/common/codegen_calls_words.rs
// `calls_input_flags_wide`). Here @vesper/stage2's `stage2_lower_dir`
// loads, checks and lowers the package, and the calls input is written
// from its tables: the context and program with @vesper/check-data's and
// @vesper/place-ir's writers, and the calls section from the IR AST's
// function table, body rows and the checker's call instantiations
// (@vesper/codegen-calls `put_calls`'s layout).
//
// Stage 2's checker records no `dyn` tables, trace effects or fip caller
// slots, and its function rows carry no spans or fip flags, so those
// sections are empty; a package that needs them is declined
// (`DECLINE_FEATURES`).
use @vesper/check-data::input::{put_world};
use @vesper/check-data::util::{u32_at, u64_at};
use @vesper/check-data::world::{SpanRow, find_span, set_by_symbol};
use @vesper/place-ir::{put_names, put_program_section, put_types};
use @vesper/place-ir-lower::ast::{Ast, Ex};
use @vesper/stage2::{Lowered, stage2_lower_dir_with};
use self::{foreign_sources};

const NONE64: u64 = 18446744073709551615;
const WORD_BYTES: u64 = 8;

// The IR AST's expression kinds (@vesper/place-ir-lower ast.ves `X_*`).
const X_FOREIGN: u8 = 0;
const X_LITERAL: u8 = 1;
const X_NAME: u8 = 2;
const X_TUPLE: u8 = 3;
const X_STRUCT: u8 = 4;
const X_FIELD: u8 = 5;
const X_INDEX: u8 = 6;
const X_UNARY: u8 = 7;
const X_BINARY: u8 = 8;
const X_ASSIGN: u8 = 9;
const X_BLOCK: u8 = 10;
const X_CALL: u8 = 11;
const X_TRY: u8 = 12;
const X_IF: u8 = 13;
const X_MATCH: u8 = 14;
const X_LOOP: u8 = 15;
const X_FOR: u8 = 16;
const X_RANGE: u8 = 17;
const X_BREAK: u8 = 18;
const X_CONTINUE: u8 = 19;
const X_RETURN: u8 = 20;
const X_CLOSURE: u8 = 21;
const X_HANDLE: u8 = 22;

// The calls section's expression kinds (codegen_calls_words.rs
// `expr_kind`, the Rust `ExprKind` order).
const E_LITERAL: u64 = 0;
const E_NAME: u64 = 1;
const E_TUPLE: u64 = 2;
const E_STRUCT: u64 = 3;
const E_BLOCK: u64 = 4;
const E_CALL: u64 = 5;
const E_FIELD: u64 = 6;
const E_INDEX: u64 = 7;
const E_TRY: u64 = 8;
const E_UNARY: u64 = 9;
const E_BINARY: u64 = 10;
const E_ASSIGN: u64 = 11;
const E_IF: u64 = 12;
const E_MATCH: u64 = 13;
const E_CLOSURE: u64 = 14;
const E_HANDLE: u64 = 15;
const E_LOOP: u64 = 16;
const E_FOR: u64 = 17;
const E_RANGE: u64 = 18;
const E_BREAK: u64 = 19;
const E_RETURN: u64 = 20;
const E_CONTINUE: u64 = 21;
// The words of one expression row: kind, span start, end, symbol + 1,
// children, size.
const ROW_WORDS: u64 = 6;
const ROW_SIZE: u64 = 5;

// Why a calls input was not made.
pub const CALLS_OK: u8 = 0;
pub const CALLS_FRONT_END: u8 = 1;
pub const CALLS_FEATURES: u8 = 2;
pub const CALLS_NO_ROOT: u8 = 3;

pub struct CallsInput {
    declined: u8,
    // the front end's error, when `declined` is `CALLS_FRONT_END`
    err: ChunkSeq[u8],
    bytes: ChunkSeq[u8],
    // whether a function's row names `DetFloat` (`needs_nan_canonicalization`:
    // the ISA then canonicalizes NaNs)
    det_float: bool,
}

fn row_kind(kind: u8) -> u64 {
    if kind == X_LITERAL {
        E_LITERAL
    } else if kind == X_NAME {
        E_NAME
    } else if kind == X_TUPLE {
        E_TUPLE
    } else if kind == X_STRUCT {
        E_STRUCT
    } else if kind == X_FIELD {
        E_FIELD
    } else if kind == X_INDEX {
        E_INDEX
    } else if kind == X_UNARY {
        E_UNARY
    } else if kind == X_BINARY {
        E_BINARY
    } else if kind == X_ASSIGN {
        E_ASSIGN
    } else if kind == X_BLOCK {
        E_BLOCK
    } else if kind == X_CALL {
        E_CALL
    } else if kind == X_TRY {
        E_TRY
    } else if kind == X_IF {
        E_IF
    } else if kind == X_MATCH {
        E_MATCH
    } else if kind == X_LOOP {
        E_LOOP
    } else if kind == X_FOR {
        E_FOR
    } else if kind == X_RANGE {
        E_RANGE
    } else if kind == X_BREAK {
        E_BREAK
    } else if kind == X_CONTINUE {
        E_CONTINUE
    } else if kind == X_RETURN {
        E_RETURN
    } else if kind == X_CLOSURE {
        E_CLOSURE
    } else {
        E_HANDLE
    }
}

fn xs_at(in a: Ast, i: u64) -> u64 {
    u64_at(in a.xs, i)
}

fn push_if(inout kids: ChunkSeq[u64], e: u64) {
    if e != NONE64 {
        kids.push(e);
    }
}

// The direct subexpressions of `e`, in the walk's evaluation order
// (codegen_calls_words.rs `children`).
fn children(in a: Ast, e: Ex) -> ChunkSeq[u64] {
    let mut kids: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let k = e.kind;
    if k == X_TUPLE {
        for i in 0..e.n {
            kids.push(xs_at(in a, wrapping_add(e.a, i)));
        }
    } else if k == X_STRUCT {
        for i in 0..e.n {
            kids.push(xs_at(in a, wrapping_add(wrapping_add(e.b, wrapping_mul(i, 2)), 1)));
        }
    } else if k == X_BLOCK {
        for i in 0..e.n {
            kids.push(xs_at(in a, wrapping_add(wrapping_add(e.a, wrapping_mul(i, 3)), 2)));
        }
        push_if(inout kids, e.b);
    } else if k == X_CALL {
        kids.push(e.a);
        for i in 0..e.n {
            kids.push(xs_at(in a, wrapping_add(wrapping_add(e.b, wrapping_mul(i, 2)), 1)));
        }
    } else if k == X_FIELD || k == X_TRY || k == X_LOOP {
        kids.push(e.a);
    } else if k == X_UNARY {
        kids.push(e.b);
    } else if k == X_BINARY || k == X_ASSIGN {
        kids.push(e.b);
        kids.push(e.c);
    } else if k == X_INDEX || k == X_RANGE {
        kids.push(e.a);
        kids.push(e.b);
    } else if k == X_IF {
        kids.push(e.a);
        kids.push(e.b);
        push_if(inout kids, e.c);
    } else if k == X_MATCH {
        kids.push(e.a);
        for i in 0..e.n {
            kids.push(xs_at(in a, wrapping_add(wrapping_add(e.b, wrapping_mul(i, 2)), 1)));
        }
    } else if k == X_FOR {
        kids.push(e.b);
        kids.push(e.c);
    } else if k == X_BREAK || k == X_RETURN {
        push_if(inout kids, e.a);
    } else if k == X_CLOSURE {
        kids.push(e.c);
    } else if k == X_HANDLE {
        match a.hds.try_get(e.a) {
            Option::Some(h) => {
                if h.has_state {
                    kids.push(h.state_expr);
                }
                kids.push(h.body);
                for i in 0..wrapping_add(h.op_count, 1) {
                    match a.cls.try_get(wrapping_add(h.return_clause, i)) {
                        Option::Some(c) => kids.push(c.body),
                        Option::None => {},
                    }
                }
            },
            Option::None => {},
        }
    }
    kids
}

// Pre-order rows of the expression `id` and its subtree; false when one
// is not an expression the encoder can spell.
fn put_expr(in a: Ast, id: u64, inout rows: ChunkSeq[u64]) -> bool {
    let e = a.ex(id);
    if e.kind == X_FOREIGN || e.kind > X_HANDLE {
        return false;
    }
    let at = rows.len();
    let sym = if e.kind == X_NAME {
        wrapping_add(e.a, 1)
    } else if e.kind == X_FIELD {
        wrapping_add(e.b, 1)
    } else {
        0
    };
    let kids = children(in a, e);
    rows.push(row_kind(e.kind));
    rows.push(e.s0);
    rows.push(e.s1);
    rows.push(sym);
    rows.push(kids.len());
    rows.push(0);
    for i in 0..kids.len() {
        if !put_expr(in a, u64_at(in kids, i), inout rows) {
            return false;
        }
    }
    let size = wrapping_sub(rows.len(), at) / ROW_WORDS;
    let ok = rows.try_set(wrapping_add(at, ROW_SIZE), size);
    true
}

// The calls input of the package at `root_dir` for native target OS `os`:
// its library task over `roots` (symbols named one per line), optimized
// when `optimize`.
pub fn stage2_calls_input(
    in root_dir: Slice[u8],
    in os: Slice[u8],
    in roots: Slice[u8],
    optimize: bool
) -> CallsInput eff [Ffi[StdFs]] {
    calls_input_of(in root_dir, in os, in roots, optimize, in NO_WRAPPERS.as_bytes(), true)
}

// No instance wrappers.
const NO_WRAPPERS: Str = "";

// `stage2_calls_input` with `wrappers` (@vesper/export-build's instance
// wrappers, `ExportFiles.wrappers`) appended to the root module.
pub fn stage2_calls_input_with(
    in root_dir: Slice[u8],
    in os: Slice[u8],
    in roots: Slice[u8],
    optimize: bool,
    in wrappers: Slice[u8]
) -> CallsInput eff [Ffi[StdFs]] {
    calls_input_of(in root_dir, in os, in roots, optimize, in wrappers, true)
}

// The calls input of the package at `root_dir` for native target OS `os`
// whose one task is the executable entry `entry`, optimized when
// `optimize`, as `vesper build` hands `compile_entry` (slice 4e, #2752):
// no library flag, so the entry passes `compile_entry`'s checks instead
// of being compiled as an export.
pub fn stage2_entry_calls_input(
    in root_dir: Slice[u8],
    in os: Slice[u8],
    in entry: Slice[u8],
    optimize: bool
) -> CallsInput eff [Ffi[StdFs]] {
    calls_input_of(in root_dir, in os, in entry, optimize, in NO_WRAPPERS.as_bytes(), false)
}

fn calls_input_of(
    in root_dir: Slice[u8],
    in os: Slice[u8],
    in roots: Slice[u8],
    optimize: bool,
    in wrappers: Slice[u8],
    library: bool
) -> CallsInput eff [Ffi[StdFs]] {
    let mut err: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let sources = match foreign_sources(in root_dir, in os) {
        Option::Some(s) => s,
        Option::None => {
            err.extend(in "foreign imports do not read".as_bytes());
            return CallsInput {
                declined: CALLS_FRONT_END,
                err: err,
                bytes: ChunkSeq::new[u8](),
                det_float: false
            };
        },
    };
    let mut lw = match stage2_lower_dir_with(
        in root_dir,
        in os,
        in sources,
        in wrappers,
        inout err
    ) {
        Option::Some(lw) => lw,
        Option::None => {
            return CallsInput {
                declined: CALLS_FRONT_END,
                err: err,
                bytes: ChunkSeq::new[u8](),
                det_float: false
            };
        },
    };
    let mut o: ChunkSeq[u64] = ChunkSeq::new[u64]();
    // The roots, interned before the names are written.
    let mut root_syms: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut start: u64 = 0;
    for i in 0..wrapping_add(roots.len(), 1) {
        let end_here = i == roots.len() || roots.try_get(i).unwrap_or(0) == NEWLINE;
        if end_here {
            if i > start {
                root_syms.push(lw.low.ctx.names.intern(in roots[start..i]));
            }
            start = wrapping_add(i, 1);
        }
    }
    if root_syms.len() == 0 {
        return CallsInput {
            declined: CALLS_NO_ROOT,
            err: err,
            bytes: ChunkSeq::new[u8](),
            det_float: false
        };
    }
    let det_float = names_det_float(in lw);
    let effect_types = effect_types(inout lw);
    drop_callee_types(inout lw);
    put_names(inout o, in lw.low.ctx.names);
    put_types(inout o, in lw.low.ctx.types);
    put_world(in lw.low.ctx.world, inout o);
    put_program_section(in lw.low.program, inout o);
    if !put_section(in lw, in effect_types, in root_syms, optimize, library, inout o) {
        return CallsInput {
            declined: CALLS_FEATURES,
            err: err,
            bytes: ChunkSeq::new[u8](),
            det_float: false
        };
    }
    let mut bytes: ChunkSeq[u8] = ChunkSeq::new[u8]();
    bytes.resize(wrapping_mul(o.len(), WORD_BYTES), 0);
    for i in 0..o.len() {
        let ok = bytes.try_write_u64_le(wrapping_mul(i, WORD_BYTES), u64_at(in o, i));
    }
    CallsInput { declined: CALLS_OK, err: err, bytes: bytes, det_float: det_float }
}

const NEWLINE: u8 = 10;
// The calls task flags (@vesper/codegen-calls data.ves `Task`).
const TASK_OPTIMIZE: u64 = 1;
const TASK_LIBRARY: u64 = 4;
const TASK_MORE_ROOTS: u64 = 8;
// An executable entry task: no flag bit.
const TASK_ENTRY: u64 = 0;

fn put_section(
    in lw: Lowered,
    in effect_types: ChunkSeq[u32],
    in roots: ChunkSeq[u32],
    optimize: bool,
    library: bool,
    inout o: ChunkSeq[u64]
) -> bool {
    // trace effects: none
    o.push(0);
    let mut rows: ChunkSeq[u64] = ChunkSeq::new[u64]();
    o.push(lw.low.ast.fns.len());
    for fi in 0..lw.low.ast.fns.len() {
        let f = match lw.low.ast.fns.try_get(fi) {
            Option::Some(f) => f,
            Option::None => return false,
        };
        o.push(widen_u64(f.name));
        // not fip; no span
        o.push(0);
        o.push(0);
        o.push(0);
        o.push(f.generic_count);
        for gi in 0..f.generic_count {
            match lw.low.ast.gens.try_get(wrapping_add(f.generic_start, gi)) {
                Option::Some(g) => o.push(widen_u64(g.name)),
                Option::None => return false,
            }
        }
        o.push(f.param_count);
        for pi in 0..f.param_count {
            match lw.low.ast.pms.try_get(wrapping_add(f.param_start, pi)) {
                Option::Some(p) => {
                    o.push(widen_u64(p.name));
                    o.push(widen_u64(p.pass));
                    o.push(widen_u64(p.ty));
                },
                Option::None => return false,
            }
        }
        o.push(widen_u64(f.result));
        o.push(widen_u64(u32_at(in effect_types, fi)));
        if f.has_body {
            o.push(wrapping_add(rows.len() / ROW_WORDS, 1));
            if !put_expr(in lw.low.ast, f.body, inout rows) {
                return false;
            }
        } else {
            o.push(0);
        }
    }
    o.push(rows.len() / ROW_WORDS);
    o.extend(in rows.as_slice());
    // `world.calls`, by span.
    let n = lw.call_rows.len();
    let mut order: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for i in 0..n {
        order.push(i);
    }
    sort_calls(in lw, inout order);
    o.push(n);
    for k in 0..n {
        match lw.call_rows.try_get(u64_at(in order, k)) {
            Option::Some(row) => {
                o.push(row.s0);
                o.push(row.s1);
                o.push(row.vn);
                for j in 0..row.vn {
                    match lw.call_pairs.try_get(wrapping_add(row.v0, j)) {
                        Option::Some(p) => {
                            o.push(widen_u64(p.name));
                            o.push(widen_u64(p.ty));
                        },
                        Option::None => return false,
                    }
                }
            },
            Option::None => return false,
        }
    }
    // `dyn` params: none (only boxed objects reach Stage 2).
    o.push(0);
    // Vtable stubs, by name (Rust's `DynObjects::stubs` is a BTreeMap).
    let mut stubs: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for i in 0..lw.dyn_out.stubs.len() {
        stubs.push(u32_at(in lw.dyn_out.stubs, i));
    }
    sort_by_name(in lw, inout stubs);
    o.push(stubs.len());
    for i in 0..stubs.len() {
        o.push(widen_u64(u32_at(in stubs, i)));
    }
    // Vtables: object type, value type, then each slot function with no
    // type arguments.
    o.push(lw.dyn_out.vtabs.len());
    for vi in 0..lw.dyn_out.vtabs.len() {
        match lw.dyn_out.vtabs.try_get(vi) {
            Option::Some(v) => {
                o.push(widen_u64(v.object));
                o.push(widen_u64(v.self_ty));
                o.push(v.tn);
                for k in 0..v.tn {
                    o.push(widen_u64(u32_at(in lw.dyn_out.slots, wrapping_add(v.t0, k))));
                    o.push(0);
                }
            },
            Option::None => return false,
        }
    }
    // Caller-slot functions: none.
    o.push(0);
    o.push(roots.len());
    let base = if optimize { TASK_OPTIMIZE } else { 0 };
    for i in 0..roots.len() {
        o.push(widen_u64(u32_at(in roots, i)));
        let mut kind = TASK_ENTRY;
        if i != 0 {
            kind = TASK_MORE_ROOTS;
        } else if library {
            kind = TASK_LIBRARY;
        }
        o.push(base | kind);
    }
    true
}

// `needs_nan_canonicalization`: whether some function's row (closures
// and handlers are functions of their own here) names `DetFloat`.
fn names_det_float(in lw: Lowered) -> bool {
    let det_float = lw.low.ctx.names.lookup(in DET_FLOAT.as_bytes());
    if det_float == NO_NAME {
        return false;
    }
    for fi in 0..lw.low.ast.fns.len() {
        let effects = match lw.low.ast.fns.try_get(fi) {
            Option::Some(f) => f.effects,
            Option::None => continue,
        };
        let row = lw.low.ctx.types.row(effects);
        for i in 0..widen_u64(row.n) {
            if lw.low.ctx.types.effect_at(wrapping_add(widen_u64(row.a), i)).name == det_float {
                return true;
            }
        }
    }
    false
}

const DET_FLOAT: Str = "DetFloat";
// `Names::lookup` of a name never interned.
const NO_NAME: u32 = 4294967295;

// Stage 2's function rows hold their effects as a row of the type table,
// where the encoder writes a Row type: the Row type of each function's
// row (by IR AST function), also put in the program header of the
// function lowered from it.
fn effect_types(inout lw: Lowered) -> ChunkSeq[u32] {
    let mut out: ChunkSeq[u32] = ChunkSeq::new[u32]();
    let mut by_name: ChunkSeq[u32] = ChunkSeq::new[u32]();
    for fi in 0..lw.low.ast.fns.len() {
        let (name, row) = match lw.low.ast.fns.try_get(fi) {
            Option::Some(f) => (f.name, f.effects),
            Option::None => (0, 0),
        };
        let ty = lw.low.ctx.types.row_type(row);
        out.push(ty);
        set_by_symbol(inout by_name, name, wrapping_add(ty, 1));
    }
    for pi in 0..lw.low.program.fn_count() {
        let f = lw.low.program.function(pi);
        let ty1 = u32_at(in by_name, widen_u64(f.name));
        if ty1 == 0 {
            continue;
        }
        // The header: n params, each (name, pass, k, k paths, type, start,
        // end), then the result and the effects.
        let mut at = f.ha;
        let np = u64_at(in lw.low.program.ops, at);
        at = wrapping_add(at, 1);
        for _ in 0..np {
            at = wrapping_add(at, PARAM_NAME_PASS);
            let k = u64_at(in lw.low.program.ops, at);
            at = wrapping_add(wrapping_add(at, 1), wrapping_add(k, PARAM_TYPE_SPAN));
        }
        let ok = lw.low.program.ops.try_set(wrapping_add(at, 1), widen_u64(wrapping_sub(ty1, 1)));
    }
    out
}

// A header parameter's name and pass words, and its type and span words.
const PARAM_NAME_PASS: u64 = 2;
const PARAM_TYPE_SPAN: u64 = 3;

// The Rust checker records no type for the name a direct call names
// (`world.types` holds value expressions), and @vesper/codegen-calls
// reads a typed callee as a function value: the spans of direct callee
// names are dropped from the expression types.
fn drop_callee_types(inout lw: Lowered) {
    // The checker's expression types are sorted by span (`find_span`), so
    // each callee's row is found by a binary search, not a scan of them
    // all: Stage 2's self-built heap frees nothing, and a scan per callee
    // allocates more than its 4 GiB on a port.
    let n = lw.low.ctx.world.expr_types.len();
    let mut drop: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut any = false;
    for i in 0..lw.low.ast.exs.len() {
        let e = lw.low.ast.ex(i);
        if e.kind != X_CALL {
            continue;
        }
        let callee = lw.low.ast.ex(e.a);
        if callee.kind == X_NAME && u32_at(in lw.low.ast.fn_by_key, callee.a) != 0 {
            let at = find_span(in lw.low.ctx.world.expr_types, callee.s0, callee.s1);
            if at < n {
                if !any {
                    drop.resize(n, 0);
                    any = true;
                }
                let ok = drop.try_set(at, 1);
            }
        }
    }
    if !any {
        return;
    }
    let mut kept: ChunkSeq[SpanRow] = ChunkSeq::with_capacity[SpanRow](n);
    for i in 0..n {
        if drop.try_get(i).unwrap_or(0) != 0 {
            continue;
        }
        match lw.low.ctx.world.expr_types.try_get(i) {
            Option::Some(r) => kept.push(r),
            Option::None => {},
        }
    }
    lw.low.ctx.world.expr_types = kept;
}

// Insertion sort of call row indexes by (start, end), as the checker's
// span-keyed map orders them.
// Sorts symbols by their names' bytes (insertion sort: a program has a
// few vtable stubs).
fn sort_by_name(in lw: Lowered, inout syms: ChunkSeq[u32]) {
    for i in 1..syms.len() {
        let x = u32_at(in syms, i);
        let mut j = i;
        loop {
            if j == 0 {
                break;
            }
            let y = u32_at(in syms, wrapping_sub(j, 1));
            if !name_lt(in lw, x, y) {
                break;
            }
            let _ = syms.try_set(j, y);
            j = wrapping_sub(j, 1);
        }
        let _ = syms.try_set(j, x);
    }
}

fn name_lt(in lw: Lowered, x: u32, y: u32) -> bool {
    let mut a: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut b: ChunkSeq[u8] = ChunkSeq::new[u8]();
    lw.low.ctx.names.write(x, inout a);
    lw.low.ctx.names.write(y, inout b);
    let n = if a.len() < b.len() { a.len() } else { b.len() };
    for i in 0..n {
        let p = a.try_get(i).unwrap_or(0);
        let q = b.try_get(i).unwrap_or(0);
        if p != q {
            return p < q;
        }
    }
    a.len() < b.len()
}

fn sort_calls(in lw: Lowered, inout order: ChunkSeq[u64]) {
    for i in 1..order.len() {
        let mut j = i;
        loop {
            if j == 0 {
                break;
            }
            let x = u64_at(in order, j);
            let y = u64_at(in order, wrapping_sub(j, 1));
            if !span_before(in lw, x, y) {
                break;
            }
            let ok1 = order.try_set(j, y);
            let ok2 = order.try_set(wrapping_sub(j, 1), x);
            j = wrapping_sub(j, 1);
        }
    }
}

fn span_before(in lw: Lowered, x: u64, y: u64) -> bool {
    match (lw.call_rows.try_get(x), lw.call_rows.try_get(y)) {
        (Option::Some(a), Option::Some(b)) => a.s0 < b.s0 || (a.s0 == b.s0 && a.s1 < b.s1),
        _ => false,
    }
}
