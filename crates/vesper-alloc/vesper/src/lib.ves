// Vesper port of vesper-alloc (port wave P1 lane 6, #903): the bookkeeping
// of a Strata region (manuscript section 15.2/15.3).
//
// A `Book` decides everything a region decides: where an allocation goes
// (chunk fit, spare reuse, the growth policy and the reservation bound), the
// allocation table with its never-reused serials, handle validation,
// tail reclamation, watermarks with LIFO rewind, reset with partial chunk
// retention, and the element metadata of region vectors (length, capacity,
// amortized growth, in-place growth at the tip, relocation and freezing).
//
// The Rust crate keeps the memory: chunks come from its `ChunkBacking` and
// payloads are Rust values, so it reads and writes bytes at the addresses
// this library returns, runs destructors, and returns chunks to the backing.
// Work for Rust is queued on `pending` (see `Action`) and taken with
// `book_take_pending` after an operation that reports it.
//
// When an operation needs a new chunk it changes nothing and answers
// `Need { cap, align }`. Rust obtains that chunk from its backing and repeats
// the same call with `fresh_base`/`fresh_cap` set; the book is unchanged in
// between, so the repeated call takes the same path and adopts the chunk.
//
// Codes shared with src/region/port.rs: the slot `Kind` and `State`, and
// the `ConfigError` index of `Fault::Config`.
// - A finalizer (`fin`, `edrop`) is the address of a Rust drop function, or 0.

// RegionConfig.
pub copy struct Cfg {
    initial: u64,
    max_chunk: u64,
    max_reserved: u64,
    max_align: u64,
    max_allocations: u64,
    max_checkpoints: u64,
    retained: u64
}

// A chunk obtained from the backing: its address, capacity, layout alignment
// and bump cursor. Stored as four words per chunk in `Book::chunks`.
copy struct Chunk {
    base: u64,
    cap: u64,
    align: u64,
    cursor: u64
}

// One tracked allocation. `prior` is the chunk cursor before it (including
// alignment padding) and `addr` its address. The `e*` fields are the element
// metadata of Elements and Frozen slots (`elems` is true for those). Stored as
// `SLOT_WORDS` words per slot in `Book::slots` (see `slot_at`), so the hot
// paths read only the words they need.
copy struct Slot {
    serial: u64,
    addr: u64,
    chunk: u64,
    prior: u64,
    start: u64,
    len: u64,
    align: u64,
    kind: u64,
    st: u64,
    fin: u64,
    lin: bool,
    elems: bool,
    elen: u64,
    ecap: u64,
    esize: u64,
    edrop: u64,
    elin: bool
}

copy struct Mark {
    serial: u64,
    slot_len: u64,
    chunk: u64,
    cursor: u64
}

// Work the Rust side does, in queue order.
pub copy enum Action {
    // Run the drop function `fin` on the value at `addr`.
    Finalize {
        fin: u64,
        addr: u64
    },
    // Run the element drop function `fin` on `len` elements at `addr`.
    DropElems {
        fin: u64,
        addr: u64,
        len: u64
    },
    // Return a chunk to the backing.
    Release {
        base: u64,
        cap: u64,
        align: u64
    }
}

// Every failure the book reports. The Rust side maps each to the crate's
// AllocError, HandleError, RegionError or ConfigError.
pub copy enum Fault {
    InvalidAlignment(u64),
    AlignmentTooLarge {
        align: u64,
        max: u64
    },
    SizeOverflow,
    CapacityExceeded {
        requested: u64,
        reserved: u64,
        limit: u64
    },
    TooManyAllocations(u64),
    ExhaustedSerials,
    Stale,
    Moved,
    Linear(u64),
    TooManyCheckpoints(u64),
    Protected,
    // A `ConfigError`.
    Config(u64)
}

// The answer of an allocating operation. `pending` is the number of queued
// actions (released spare chunks).
pub copy enum Placed {
    Done {
        slot: u64,
        serial: u64,
        addr: u64,
        pending: u64
    },
    Need {
        cap: u64,
        align: u64
    },
    Fail(Fault)
}

// The answer of `book_extend`.
pub copy enum Extended {
    // Nothing to append.
    Unchanged,
    // The allocation grew at the tip; append at `dst`.
    InPlace {
        dst: u64
    },
    // The allocation moved: copy `old_len` bytes from `src` to `dst`, then
    // append at `dst + old_len`. The old slot is released.
    Relocated {
        slot: u64,
        serial: u64,
        src: u64,
        dst: u64,
        old_len: u64,
        pending: u64
    },
    Need {
        cap: u64,
        align: u64
    },
    Fail(Fault)
}

// The answer of `book_grow`. `len` is the element count before the claim.
pub copy enum Grown {
    Ready {
        slot: u64,
        serial: u64,
        base: u64,
        len: u64
    },
    // The buffer moved: copy `bytes` from `src` to `base` before anything
    // else touches the elements.
    Relocated {
        slot: u64,
        serial: u64,
        src: u64,
        base: u64,
        len: u64,
        bytes: u64,
        pending: u64
    },
    // `retry`: if the backing refuses this chunk, repeat with `skip_target`
    // (the amortized target falls back to the exact requirement).
    // `fallback`: the chunk is for the exact fallback, so repeat with
    // `skip_target` and the fresh chunk.
    Need {
        cap: u64,
        align: u64,
        retry: bool,
        fallback: bool
    },
    Fail(Fault)
}

// A live allocation as a handle sees it.
pub copy struct View {
    addr: u64,
    len: u64,
    elen: u64,
    ecap: u64,
    lin: bool
}

// A run of elements `from..to` at `base`, for the Rust side to drop or move.
pub copy struct Span {
    base: u64,
    from: u64,
    to: u64,
    pending: u64
}

pub copy struct Stats {
    reserved: u64,
    used: u64,
    chunks: u64,
    tracked: u64,
    live_linear: u64,
    checkpoints: u64,
    epoch: u64
}

pub struct Book {
    cfg: Cfg,
    chunks: ChunkSeq[u64],
    nchunks: u64,
    current: u64,
    reserved: u64,
    slots: ChunkSeq[u64],
    nslots: u64,
    next_serial: u64,
    marks: ChunkSeq[Mark],
    live_linear: u64,
    epoch: u64,
    pending: ChunkSeq[Action]
}

// Internal placement result.
copy enum Place {
    At {
        chunk: u64,
        prior: u64,
        start: u64
    },
    Need {
        cap: u64,
        align: u64
    },
    Fail(Fault)
}

const MAX_U64: u64 = 18446744073709551615;
const ISIZE_MAX: u64 = 9223372036854775807;
// The alignment of every chunk layout, at least `max_align`.
const CHUNK_ALIGN: u64 = 16;
// RegionConfig's allocation limit: slot indices fit in u32.
const MAX_ALLOCATIONS: u64 = 4294967295;
// Chunks and element buffers grow by doubling.
const GROWTH_FACTOR: u64 = 2;
// The smallest nonzero element capacity (Rust's `RawVec` minimum): 8 for
// one-byte elements, 4 up to SMALL_ELEMENT_MAX bytes, then 1.
const MIN_CAP_BYTES: u64 = 8;
const SMALL_ELEMENT_MAX: u64 = 1024;
const MIN_CAP_SMALL: u64 = 4;
const MIN_CAP_LARGE: u64 = 1;

// Slot kinds.
enum Kind: _ {
    Bytes,
    Value,
    Elements,
    Frozen
}

// Slot states.
enum State: _ {
    Live,
    Moved,
    Released
}

// `Fault::Config` indices of the crate's ConfigError variants.
enum ConfigError: _ {
    ZeroInitialChunk,
    InitialExceedsMaxChunk,
    InitialExceedsReservation,
    MaxAlignNotPowerOfTwo,
    ChunkLayout,
    AllocationLimitTooLarge
}

fn max(a: u64, b: u64) -> u64 {
    if a > b {
        a
    } else {
        b
    }
}

fn min(a: u64, b: u64) -> u64 {
    if a < b {
        a
    } else {
        b
    }
}

fn dec(n: u64) -> u64 {
    wrapping_sub(n, 1)
}

fn inc(n: u64) -> u64 {
    wrapping_add(n, 1)
}

fn is_pow2(x: u64) -> bool {
    x != 0 && (x & wrapping_sub(x, 1)) == 0
}

// Whether `a + b` overflows u64.
fn add_overflows(a: u64, b: u64) -> bool {
    wrapping_add(a, b) < a
}

// `a * b` if it fits in isize::MAX.
fn mul_bytes(a: u64, b: u64) -> Option[u64] {
    if a == 0 || b == 0 {
        return Option::Some(0);
    }
    let (low, high) = mul_wide(a, b);
    if high != 0 || low > ISIZE_MAX {
        Option::None
    } else {
        Option::Some(low)
    }
}

// Layout::from_size_align(size, align) for a power-of-two align.
fn layout_ok(size: u64, align: u64) -> bool {
    size <= wrapping_sub(ISIZE_MAX, dec(align))
}

fn empty_chunk() -> Chunk {
    Chunk {
        base: 0,
        cap: 0,
        align: 0,
        cursor: 0
    }
}

fn empty_slot() -> Slot {
    Slot {
        serial: 0,
        addr: 0,
        chunk: 0,
        prior: 0,
        start: 0,
        len: 0,
        align: 0,
        kind: 0,
        st: 0,
        fin: 0,
        lin: false,
        elems: false,
        elen: 0,
        ecap: 0,
        esize: 0,
        edrop: 0,
        elin: false
    }
}

// ----- storage ------------------------------------------------------------------

// Chunk words.
enum ChunkWord: _ {
    Base,
    Cap,
    Align,
    Cursor
}

const CHUNK_WORDS: u64 = 4;

// Slot words.
enum SlotWord: _ {
    Serial,
    Chunk,
    Prior,
    Start,
    Len,
    Align,
    Flags,
    Fin,
    Addr,
    Elen,
    Ecap,
    Esize,
    Edrop
}

const SLOT_WORDS: u64 = 13;

// The flags word holds the kind (bits 0-1), the state (bits 2-3) and these
// flag bits.
const KIND_MASK: u64 = 3;
const STATE_SHIFT: u64 = 2;
const STATE_MASK: u64 = 3;

enum Flag: _ {
    Lin = 16,
    Elems = 32,
    Elin = 64
}

fn cget(in b: Book, i: u64, f: u64) -> u64 {
    match b.chunks.try_get(wrapping_add(wrapping_mul(i, CHUNK_WORDS), f)) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

fn cset(inout b: Book, i: u64, f: u64, v: u64) {
    b.chunks.try_set(wrapping_add(wrapping_mul(i, CHUNK_WORDS), f), v);
}

fn sget(in b: Book, i: u64, f: u64) -> u64 {
    match b.slots.try_get(wrapping_add(wrapping_mul(i, SLOT_WORDS), f)) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

fn sset(inout b: Book, i: u64, f: u64, v: u64) {
    b.slots.try_set(wrapping_add(wrapping_mul(i, SLOT_WORDS), f), v);
}

fn flag(flags: u64, bit: u64) -> bool {
    (flags & bit) != 0
}

fn kind_of(flags: u64) -> u64 {
    flags & KIND_MASK
}

fn state_of(flags: u64) -> u64 {
    (flags >> STATE_SHIFT) & STATE_MASK
}

fn pack(kind: u64, st: u64, lin: bool, elems: bool, elin: bool) -> u64 {
    let mut f = kind | (st << STATE_SHIFT);
    if lin {
        f = f | Flag::Lin;
    }
    if elems {
        f = f | Flag::Elems;
    }
    if elin {
        f = f | Flag::Elin;
    }
    f
}

fn chunk_at(in b: Book, i: u64) -> Chunk {
    Chunk {
        base: cget(in b, i, ChunkWord::Base),
        cap: cget(in b, i, ChunkWord::Cap),
        align: cget(in b, i, ChunkWord::Align),
        cursor: cget(in b, i, ChunkWord::Cursor)
    }
}

fn set_chunk(inout b: Book, i: u64, c: Chunk) {
    cset(inout b, i, ChunkWord::Base, c.base);
    cset(inout b, i, ChunkWord::Cap, c.cap);
    cset(inout b, i, ChunkWord::Align, c.align);
    cset(inout b, i, ChunkWord::Cursor, c.cursor);
}

fn push_chunk(inout b: Book, c: Chunk) {
    b.chunks.push(c.base);
    b.chunks.push(c.cap);
    b.chunks.push(c.align);
    b.chunks.push(c.cursor);
    b.nchunks = inc(b.nchunks);
}

fn truncate_chunks(inout b: Book, n: u64) {
    b.chunks.truncate(wrapping_mul(n, CHUNK_WORDS));
    b.nchunks = n;
}

fn cursor_of(in b: Book, i: u64) -> u64 {
    cget(in b, i, ChunkWord::Cursor)
}

fn set_cursor(inout b: Book, i: u64, cursor: u64) {
    if i < b.nchunks {
        cset(inout b, i, ChunkWord::Cursor, cursor);
    }
}

fn slot_at(in b: Book, i: u64) -> Slot {
    let flags = sget(in b, i, SlotWord::Flags);
    Slot {
        serial: sget(in b, i, SlotWord::Serial),
        addr: sget(in b, i, SlotWord::Addr),
        chunk: sget(in b, i, SlotWord::Chunk),
        prior: sget(in b, i, SlotWord::Prior),
        start: sget(in b, i, SlotWord::Start),
        len: sget(in b, i, SlotWord::Len),
        align: sget(in b, i, SlotWord::Align),
        kind: kind_of(flags),
        st: state_of(flags),
        fin: sget(in b, i, SlotWord::Fin),
        lin: flag(flags, Flag::Lin),
        elems: flag(flags, Flag::Elems),
        elen: sget(in b, i, SlotWord::Elen),
        ecap: sget(in b, i, SlotWord::Ecap),
        esize: sget(in b, i, SlotWord::Esize),
        edrop: sget(in b, i, SlotWord::Edrop),
        elin: flag(flags, Flag::Elin)
    }
}

fn set_slot(inout b: Book, i: u64, s: Slot) {
    sset(inout b, i, SlotWord::Serial, s.serial);
    sset(inout b, i, SlotWord::Chunk, s.chunk);
    sset(inout b, i, SlotWord::Prior, s.prior);
    sset(inout b, i, SlotWord::Start, s.start);
    sset(inout b, i, SlotWord::Len, s.len);
    sset(inout b, i, SlotWord::Align, s.align);
    sset(inout b, i, SlotWord::Flags, pack(s.kind, s.st, s.lin, s.elems, s.elin));
    sset(inout b, i, SlotWord::Fin, s.fin);
    sset(inout b, i, SlotWord::Addr, s.addr);
    sset(inout b, i, SlotWord::Elen, s.elen);
    sset(inout b, i, SlotWord::Ecap, s.ecap);
    sset(inout b, i, SlotWord::Esize, s.esize);
    sset(inout b, i, SlotWord::Edrop, s.edrop);
}

fn truncate_slots(inout b: Book, n: u64) {
    b.slots.truncate(wrapping_mul(n, SLOT_WORDS));
    b.nslots = n;
}

fn addr_of(in b: Book, s: Slot) -> u64 {
    s.addr
}

// ----- configuration ---------------------------------------------------------

pub fn config_check(c: Cfg) -> Option[Fault] {
    if c.initial == 0 {
        return Option::Some(Fault::Config(ConfigError::ZeroInitialChunk));
    }
    if c.initial > c.max_chunk {
        return Option::Some(Fault::Config(ConfigError::InitialExceedsMaxChunk));
    }
    if c.initial > c.max_reserved {
        return Option::Some(Fault::Config(ConfigError::InitialExceedsReservation));
    }
    if !is_pow2(c.max_align) {
        return Option::Some(Fault::Config(ConfigError::MaxAlignNotPowerOfTwo));
    }
    if !layout_ok(c.max_chunk, max(CHUNK_ALIGN, c.max_align)) {
        return Option::Some(Fault::Config(ConfigError::ChunkLayout));
    }
    if c.max_allocations > MAX_ALLOCATIONS {
        return Option::Some(Fault::Config(ConfigError::AllocationLimitTooLarge));
    }
    Option::None
}

pub fn book_new(c: Cfg) -> Book {
    Book {
        cfg: c,
        chunks: ChunkSeq::new[u64](),
        nchunks: 0,
        current: 0,
        reserved: 0,
        slots: ChunkSeq::new[u64](),
        nslots: 0,
        next_serial: 0,
        marks: ChunkSeq::new[Mark](),
        live_linear: 0,
        epoch: 0,
        pending: ChunkSeq::new[Action]()
    }
}

pub fn book_stats(in b: Book) -> Stats {
    let mut used: u64 = 0;
    for i in 0..b.nchunks {
        used = wrapping_add(used, chunk_at(in b, i).cursor);
    }
    Stats {
        reserved: b.reserved,
        used: used,
        chunks: b.nchunks,
        tracked: b.nslots,
        live_linear: b.live_linear,
        checkpoints: b.marks.len(),
        epoch: b.epoch
    }
}

// Moves the queued actions out, in order.
pub fn book_take_pending(inout b: Book) -> ChunkSeq[Action] {
    let mut out: ChunkSeq[Action] = ChunkSeq::new[Action]();
    for i in 0..b.pending.len() {
        match b.pending.try_get(i) {
            Option::Some(a) => out.push(a),
            Option::None => (),
        }
    }
    b.pending.clear();
    out
}

// ----- placement ---------------------------------------------------------------

fn check_align(in b: Book, align: u64) -> Option[Fault] {
    if !is_pow2(align) {
        return Option::Some(Fault::InvalidAlignment(align));
    }
    if align > b.cfg.max_align {
        return Option::Some(
            Fault::AlignmentTooLarge {
                align: align,
                max: b.cfg.max_align
            }
        );
    }
    Option::None
}

// Offset of an aligned `size`-byte block at the cursor of `c`, if it fits;
// `MAX_U64` otherwise.
fn fit(c: Chunk, size: u64, align: u64) -> u64 {
    if add_overflows(c.base, c.cursor) {
        return MAX_U64;
    }
    let at = wrapping_add(c.base, c.cursor);
    if add_overflows(at, dec(align)) {
        return MAX_U64;
    }
    let bumped = wrapping_add(at, dec(align));
    let aligned = bumped & ~dec(align);
    let start = wrapping_sub(aligned, c.base);
    if add_overflows(start, size) {
        return MAX_U64;
    }
    if wrapping_add(start, size) <= c.cap {
        start
    } else {
        MAX_U64
    }
}

fn commit_placement(inout b: Book, chunk: u64, start: u64, size: u64) -> Place {
    let prior = cursor_of(in b, chunk);
    set_cursor(inout b, chunk, wrapping_add(start, size));
    Place::At {
        chunk: chunk,
        prior: prior,
        start: start
    }
}

fn queue_release(inout b: Book, c: Chunk) {
    b.reserved = wrapping_sub(b.reserved, c.cap);
    b
        .pending
        .push(
            Action::Release {
                base: c.base,
                cap: c.cap,
                align: c.align
            }
        );
}

// Releases chunks `from..to` and closes the gap.
fn release_chunks(inout b: Book, from: u64, to: u64) {
    if from >= to {
        return;
    }
    for i in from..to {
        let c = chunk_at(in b, i);
        queue_release(inout b, c);
    }
    let n = b.nchunks;
    let gap = wrapping_sub(to, from);
    for i in to..n {
        let c = chunk_at(in b, i);
        set_chunk(inout b, wrapping_sub(i, gap), c);
    }
    truncate_chunks(inout b, wrapping_sub(n, gap));
}

// Reserves `size` bytes at `align`. On `Need` and `Fail` nothing changes,
// except that an adopted fresh chunk that cannot be used is queued for release.
fn place(inout b: Book, size: u64, align: u64, fresh_base: u64, fresh_cap: u64) -> Place {
    match check_align(in b, align) {
        Option::Some(f) => {
            return Place::Fail(f);
        },
        Option::None => (),
    }
    if size > ISIZE_MAX {
        return Place::Fail(Fault::SizeOverflow);
    }
    let n = b.nchunks;
    if b.current < n {
        let start = fit(chunk_at(in b, b.current), size, align);
        if start != MAX_U64 {
            let cur = b.current;
            return commit_placement(inout b, cur, start, size);
        }
    }
    // Reuse spare chunks retained by an earlier rewind. Spares before the
    // first one that fits are released, so the chunk list stays
    // allocation-ordered.
    let first_spare = if n == 0 {
        0
    } else {
        inc(b.current)
    };
    let mut found = MAX_U64;
    let mut found_start: u64 = 0;
    for i in first_spare..n {
        if found == MAX_U64 {
            let s = fit(chunk_at(in b, i), size, align);
            if s != MAX_U64 {
                found = i;
                found_start = s;
            }
        }
    }
    if found != MAX_U64 {
        release_chunks(inout b, first_spare, found);
        b.current = first_spare;
        return commit_placement(inout b, first_spare, found_start, size);
    }
    // No spare fits: a new chunk replaces them all, so their capacity counts
    // as available to it.
    let mut spare_bytes: u64 = 0;
    for i in first_spare..n {
        spare_bytes = wrapping_add(spare_bytes, chunk_at(in b, i).cap);
    }
    let growth = if first_spare == 0 {
        b.cfg.initial
    } else {
        let last = chunk_at(in b, dec(first_spare)).cap;
        let doubled = if last > ISIZE_MAX {
            MAX_U64
        } else {
            wrapping_mul(last, GROWTH_FACTOR)
        };
        min(doubled, b.cfg.max_chunk)
    };
    let reserved = wrapping_sub(b.reserved, spare_bytes);
    let remaining = wrapping_sub(b.cfg.max_reserved, reserved);
    let exceeded = Fault::CapacityExceeded {
        requested: size,
        reserved: reserved,
        limit: b.cfg.max_reserved
    };
    if size > remaining {
        return Place::Fail(exceeded);
    }
    let capacity = max(min(growth, remaining), size);
    if capacity == 0 {
        return Place::Fail(exceeded);
    }
    let lay = max(CHUNK_ALIGN, align);
    if !layout_ok(capacity, lay) {
        return Place::Fail(Fault::SizeOverflow);
    }
    if fresh_cap == 0 {
        return Place::Need {
            cap: capacity,
            align: lay
        };
    }
    let c = Chunk {
        base: fresh_base,
        cap: fresh_cap,
        align: lay,
        cursor: 0
    };
    b.reserved = wrapping_add(b.reserved, fresh_cap);
    let start = fit(c, size, align);
    if fresh_cap != capacity || start == MAX_U64 {
        queue_release(inout b, c);
        return Place::Fail(Fault::SizeOverflow);
    }
    release_chunks(inout b, first_spare, n);
    push_chunk(inout b, c);
    let cur = dec(b.nchunks);
    b.current = cur;
    commit_placement(inout b, cur, start, size)
}

fn reserve_slot(in b: Book) -> Option[Fault] {
    if b.nslots >= b.cfg.max_allocations {
        return Option::Some(Fault::TooManyAllocations(b.cfg.max_allocations));
    }
    if b.next_serial == MAX_U64 {
        return Option::Some(Fault::ExhaustedSerials);
    }
    Option::None
}

fn push_slot(
    inout b: Book,
    chunk: u64,
    prior: u64,
    start: u64,
    len: u64,
    align: u64,
    flags: u64,
    fin: u64
) -> u64 {
    let serial = b.next_serial;
    b.next_serial = inc(serial);
    let addr = wrapping_add(cget(in b, chunk, ChunkWord::Base), start);
    b.slots.push(serial);
    b.slots.push(chunk);
    b.slots.push(prior);
    b.slots.push(start);
    b.slots.push(len);
    b.slots.push(align);
    b.slots.push(flags);
    b.slots.push(fin);
    b.slots.push(addr);
    b.slots.push(0);
    b.slots.push(0);
    b.slots.push(0);
    b.slots.push(0);
    let i = b.nslots;
    b.nslots = inc(i);
    i
}

fn mark_floor(in b: Book) -> u64 {
    let n = b.marks.len();
    if n == 0 {
        0
    } else {
        match b.marks.try_get(dec(n)) {
            Option::Some(m) => m.slot_len,
            Option::None => 0,
        }
    }
}

fn mark_chunk(in b: Book) -> u64 {
    let n = b.marks.len();
    if n == 0 {
        0
    } else {
        match b.marks.try_get(dec(n)) {
            Option::Some(m) => m.chunk,
            Option::None => 0,
        }
    }
}

// Whether `index` is the newest allocation, is not protected by a watermark,
// and ends exactly at the bump cursor of the active chunk.
fn is_tip(in b: Book, index: u64) -> bool {
    if inc(index) != b.nslots || index < mark_floor(in b) {
        return false;
    }
    let chunk = sget(in b, index, SlotWord::Chunk);
    chunk == b.current
        && cursor_of(in b, chunk)
            == wrapping_add(sget(in b, index, SlotWord::Start), sget(in b, index, SlotWord::Len))
}

// Pops released or moved allocations at the tip so their bytes are reused.
// When the active chunk empties, the previous chunk becomes active again.
fn reclaim_tail(inout b: Book) {
    loop {
        let pinned = mark_chunk(in b);
        loop {
            if b.current <= pinned {
                break;
            }
            if chunk_at(in b, b.current).cursor != 0 {
                break;
            }
            let n = b.nslots;
            if n != 0 && slot_at(in b, dec(n)).chunk >= b.current {
                break;
            }
            b.current = dec(b.current);
        }
        let n = b.nslots;
        if n == 0 {
            break;
        }
        let last = dec(n);
        let s = slot_at(in b, last);
        if s.st == State::Live || !is_tip(in b, last) {
            break;
        }
        truncate_slots(inout b, last);
        set_cursor(inout b, s.chunk, s.prior);
    }
}

// ----- handle validation -------------------------------------------------------

fn resolve(in b: Book, slot: u64, serial: u64, kind: u64) -> Result[u64, Fault] {
    if slot >= b.nslots || sget(in b, slot, SlotWord::Serial) != serial {
        return Result::Err(Fault::Stale);
    }
    let flags = sget(in b, slot, SlotWord::Flags);
    if kind_of(flags) != kind {
        return Result::Err(Fault::Stale);
    }
    let st = state_of(flags);
    if st == State::Live {
        Result::Ok(slot)
    } else if st == State::Moved {
        Result::Err(Fault::Moved)
    } else {
        Result::Err(Fault::Stale)
    }
}

pub fn book_view(in b: Book, slot: u64, serial: u64, kind: u64) -> Result[View, Fault] {
    match resolve(in b, slot, serial, kind) {
        Result::Ok(i) => Result::Ok(
            View {
                addr: sget(in b, i, SlotWord::Addr),
                len: sget(in b, i, SlotWord::Len),
                elen: sget(in b, i, SlotWord::Elen),
                ecap: sget(in b, i, SlotWord::Ecap),
                lin: flag(sget(in b, i, SlotWord::Flags), Flag::Lin)
            }
        ),
        Result::Err(f) => Result::Err(f),
    }
}

// ----- allocation ----------------------------------------------------------------

fn done(in b: Book, slot: u64, addr: u64) -> Placed {
    Placed::Done {
        slot: slot,
        serial: sget(in b, slot, SlotWord::Serial),
        addr: addr,
        pending: b.pending.len()
    }
}

// A tracked byte (kind 0) or value (kind 1) allocation. `fin` is the value's
// drop function and `linear` marks a live linear obligation.
pub fn book_alloc(
    inout b: Book,
    size: u64,
    align: u64,
    kind: u64,
    fin: u64,
    lin: bool,
    fresh_base: u64,
    fresh_cap: u64
) -> Placed {
    match reserve_slot(in b) {
        Option::Some(f) => {
            return Placed::Fail(f);
        },
        Option::None => (),
    }
    match place(inout b, size, align, fresh_base, fresh_cap) {
        Place::At {
            chunk,
            prior,
            start
        } => {
            let i = push_slot(
                inout b,
                chunk,
                prior,
                start,
                size,
                align,
                pack(kind, State::Live, lin, false, false),
                fin
            );
            if lin {
                b.live_linear = inc(b.live_linear);
            }
            let addr = sget(in b, i, SlotWord::Addr);
            done(in b, i, addr)
        },
        Place::Need {
            cap,
            align
        } => Placed::Need {
            cap: cap,
            align: align
        },
        Place::Fail(f) => Placed::Fail(f),
    }
}

// An untracked raw bump allocation (no slot, no finalizer).
pub fn book_alloc_raw(inout b: Book, size: u64, align: u64, fresh_base: u64, fresh_cap: u64)
    -> Placed {
    match place(inout b, size, align, fresh_base, fresh_cap) {
        Place::At {
            chunk,
            prior,
            start
        } => Placed::Done {
            slot: MAX_U64,
            serial: 0,
            addr: wrapping_add(chunk_at(in b, chunk).base, start),
            pending: b.pending.len()
        },
        Place::Need {
            cap,
            align
        } => Placed::Need {
            cap: cap,
            align: align
        },
        Place::Fail(f) => Placed::Fail(f),
    }
}

// An element buffer (kind 2) for `cap` elements of `esize` bytes. A
// zero-sized element type has capacity `MAX_U64` and no bytes.
pub fn book_alloc_elems(
    inout b: Book,
    cap: u64,
    esize: u64,
    align: u64,
    edrop: u64,
    elin: bool,
    fresh_base: u64,
    fresh_cap: u64
) -> Placed {
    let ecap = if esize == 0 {
        MAX_U64
    } else {
        cap
    };
    let bytes = if esize == 0 {
        0
    } else {
        match mul_bytes(cap, esize) {
            Option::Some(n) => n,
            Option::None => {
                return Placed::Fail(Fault::SizeOverflow);
            },
        }
    };
    match reserve_slot(in b) {
        Option::Some(f) => {
            return Placed::Fail(f);
        },
        Option::None => (),
    }
    match place(inout b, bytes, align, fresh_base, fresh_cap) {
        Place::At {
            chunk,
            prior,
            start
        } => {
            let i = push_slot(inout b, chunk, prior, start, bytes, align, Kind::Elements, 0);
            let mut s = slot_at(in b, i);
            s.elems = true;
            s.elen = 0;
            s.ecap = ecap;
            s.esize = esize;
            s.edrop = edrop;
            s.elin = elin;
            set_slot(inout b, i, s);
            let addr = addr_of(in b, s);
            done(in b, i, addr)
        },
        Place::Need {
            cap,
            align
        } => Placed::Need {
            cap: cap,
            align: align
        },
        Place::Fail(f) => Placed::Fail(f),
    }
}

// ----- bytes ---------------------------------------------------------------------

// Appends `add` bytes to a byte allocation: in place at the unprotected tip,
// otherwise by relocation (the old slot is released).
pub fn book_extend(inout b: Book, slot: u64, serial: u64, add: u64, fresh_base: u64, fresh_cap: u64)
    -> Extended {
    let index = match resolve(in b, slot, serial, Kind::Bytes) {
        Result::Ok(i) => i,
        Result::Err(f) => {
            return Extended::Fail(f);
        },
    };
    if add == 0 {
        return Extended::Unchanged;
    }
    if index < mark_floor(in b) {
        return Extended::Fail(Fault::Protected);
    }
    let s = slot_at(in b, index);
    if add_overflows(s.len, add) || wrapping_add(s.len, add) > ISIZE_MAX {
        return Extended::Fail(Fault::SizeOverflow);
    }
    let new_len = wrapping_add(s.len, add);
    let src = addr_of(in b, s);
    if is_tip(in b, index) && wrapping_add(s.start, new_len) <= chunk_at(in b, s.chunk).cap {
        set_cursor(inout b, s.chunk, wrapping_add(s.start, new_len));
        let mut t = s;
        t.len = new_len;
        set_slot(inout b, index, t);
        return Extended::InPlace {
            dst: wrapping_add(src, s.len)
        };
    }
    match reserve_slot(in b) {
        Option::Some(f) => {
            return Extended::Fail(f);
        },
        Option::None => (),
    }
    match place(inout b, new_len, s.align, fresh_base, fresh_cap) {
        Place::At {
            chunk,
            prior,
            start
        } => {
            let i = push_slot(inout b, chunk, prior, start, new_len, s.align, Kind::Bytes, 0);
            let mut old = s;
            old.st = State::Released;
            set_slot(inout b, index, old);
            let fresh = slot_at(in b, i);
            Extended::Relocated {
                slot: i,
                serial: fresh.serial,
                src: src,
                dst: addr_of(in b, fresh),
                old_len: s.len,
                pending: b.pending.len()
            }
        },
        Place::Need {
            cap,
            align
        } => Extended::Need {
            cap: cap,
            align: align
        },
        Place::Fail(f) => Extended::Fail(f),
    }
}

// Releases a byte allocation; its bytes are reused at once at the tip.
pub fn book_release(inout b: Book, slot: u64, serial: u64) -> Result[u64, Fault] {
    match resolve(in b, slot, serial, Kind::Bytes) {
        Result::Ok(i) => {
            let mut s = slot_at(in b, i);
            s.st = State::Released;
            set_slot(inout b, i, s);
            reclaim_tail(inout b);
            Result::Ok(0)
        },
        Result::Err(f) => Result::Err(f),
    }
}

// Moves a value out of its box: no finalizer runs for it and a linear
// obligation is discharged. Returns the value's address.
pub fn book_take(inout b: Book, slot: u64, serial: u64) -> Result[u64, Fault] {
    match resolve(in b, slot, serial, Kind::Value) {
        Result::Ok(i) => {
            let mut s = slot_at(in b, i);
            s.st = State::Moved;
            s.fin = 0;
            if s.lin {
                s.lin = false;
                b.live_linear = dec(b.live_linear);
            }
            set_slot(inout b, i, s);
            let addr = addr_of(in b, s);
            reclaim_tail(inout b);
            Result::Ok(addr)
        },
        Result::Err(f) => Result::Err(f),
    }
}

// ----- checkpoints, rewind, reset ------------------------------------------------

pub fn book_checkpoint(inout b: Book) -> Result[u64, Fault] {
    if b.marks.len() >= b.cfg.max_checkpoints {
        return Result::Err(Fault::TooManyCheckpoints(b.cfg.max_checkpoints));
    }
    if b.next_serial == MAX_U64 {
        return Result::Err(Fault::ExhaustedSerials);
    }
    let serial = b.next_serial;
    b.next_serial = inc(serial);
    let cursor = if b.current < b.nchunks {
        chunk_at(in b, b.current).cursor
    } else {
        0
    };
    b
        .marks
        .push(
            Mark {
                serial: serial,
                slot_len: b.nslots,
                chunk: b.current,
                cursor: cursor
            }
        );
    Result::Ok(serial)
}

fn find_mark(in b: Book, serial: u64) -> u64 {
    let mut found = MAX_U64;
    for i in 0..b.marks.len() {
        match b.marks.try_get(i) {
            Option::Some(m) => {
                if m.serial == serial {
                    found = i;
                }
            },
            Option::None => (),
        }
    }
    found
}

// Pops slots down to `floor` in LIFO order and queues their finalizers.
fn finalize_from(inout b: Book, floor: u64) {
    let n = b.nslots;
    if n <= floor {
        return;
    }
    let mut i = n;
    loop {
        if i <= floor {
            break;
        }
        i = dec(i);
        let flags = sget(in b, i, SlotWord::Flags);
        if state_of(flags) == State::Live {
            if flag(flags, Flag::Lin) {
                b.live_linear = dec(b.live_linear);
            }
            let addr = sget(in b, i, SlotWord::Addr);
            let fin = sget(in b, i, SlotWord::Fin);
            if fin != 0 {
                b
                    .pending
                    .push(
                        Action::Finalize {
                            fin: fin,
                            addr: addr
                        }
                    );
            }
            if flag(flags, Flag::Elems) {
                let edrop = sget(in b, i, SlotWord::Edrop);
                let elen = sget(in b, i, SlotWord::Elen);
                if edrop != 0 && elen > 0 {
                    b
                        .pending
                        .push(
                            Action::DropElems {
                                fin: edrop,
                                addr: addr,
                                len: elen
                            }
                        );
                }
            }
        }
    }
    truncate_slots(inout b, floor);
}

// Rewinds to the watermark `serial`. `Fault::Linear(count)` leaves
// everything unchanged. Returns the number of queued actions.
pub fn book_rewind(inout b: Book, serial: u64) -> Result[u64, Fault] {
    let pos = find_mark(in b, serial);
    if pos == MAX_U64 {
        return Result::Err(Fault::Stale);
    }
    let record = match b.marks.try_get(pos) {
        Option::Some(m) => m,
        Option::None => {
            return Result::Err(Fault::Stale);
        },
    };
    let floor = record.slot_len;
    let mut count: u64 = 0;
    for i in floor..b.nslots {
        let flags = sget(in b, i, SlotWord::Flags);
        if state_of(flags) == State::Live && flag(flags, Flag::Lin) {
            count = inc(count);
        }
    }
    if count > 0 {
        return Result::Err(Fault::Linear(count));
    }
    b.marks.truncate(pos);
    finalize_from(inout b, floor);
    for i in record.chunk..b.nchunks {
        set_cursor(inout b, i, 0);
    }
    if record.chunk < b.nchunks {
        set_cursor(inout b, record.chunk, record.cursor);
    }
    b.current = record.chunk;
    b.epoch = inc(b.epoch);
    Result::Ok(b.pending.len())
}

// Discards a watermark without rewinding.
pub fn book_commit(inout b: Book, serial: u64) -> Result[u64, Fault] {
    let pos = find_mark(in b, serial);
    if pos == MAX_U64 {
        return Result::Err(Fault::Stale);
    }
    let n = b.marks.len();
    for i in inc(pos)..n {
        match b.marks.try_get(i) {
            Option::Some(m) => {
                b.marks.try_set(dec(i), m);
            },
            Option::None => (),
        }
    }
    b.marks.truncate(dec(n));
    reclaim_tail(inout b);
    Result::Ok(0)
}

// Finalizes every allocation and returns chunk capacity beyond the retained
// bytes. Fails without changes while linear payloads are live.
pub fn book_reset(inout b: Book) -> Result[u64, Fault] {
    if b.live_linear > 0 {
        return Result::Err(Fault::Linear(b.live_linear));
    }
    b.marks.clear();
    finalize_from(inout b, 0);
    let n = b.nchunks;
    let mut kept: u64 = 0;
    let mut retained: u64 = 0;
    let mut stop = false;
    for i in 0..n {
        if !stop {
            let c = chunk_at(in b, i);
            let total = if add_overflows(retained, c.cap) {
                MAX_U64
            } else {
                wrapping_add(retained, c.cap)
            };
            if total > b.cfg.retained {
                stop = true;
            } else {
                retained = total;
                set_cursor(inout b, i, 0);
                kept = inc(kept);
            }
        }
    }
    release_chunks(inout b, kept, n);
    b.current = 0;
    b.epoch = inc(b.epoch);
    Result::Ok(b.pending.len())
}

// Region drop and close: finalizes every allocation, then releases every
// chunk. Returns the number of live linear obligations that were abandoned.
pub fn book_finish(inout b: Book) -> u64 {
    let abandoned = b.live_linear;
    b.marks.clear();
    finalize_from(inout b, 0);
    let n = b.nchunks;
    release_chunks(inout b, 0, n);
    b.current = 0;
    abandoned
}

// ----- element buffers -------------------------------------------------------------

fn min_growth_cap(esize: u64) -> u64 {
    if esize == 1 {
        MIN_CAP_BYTES
    } else if esize <= SMALL_ELEMENT_MAX {
        MIN_CAP_SMALL
    } else {
        MIN_CAP_LARGE
    }
}

// Keeps the slot's linear flag and the book's counter in step with the
// element count.
fn sync_linear(inout b: Book, index: u64) {
    let flags = sget(in b, index, SlotWord::Flags);
    let want = state_of(flags) == State::Live
        && flag(flags, Flag::Elems)
        && flag(flags, Flag::Elin)
        && sget(in b, index, SlotWord::Elen) > 0;
    if want != flag(flags, Flag::Lin) {
        let next = if want {
            flags | Flag::Lin
        } else {
            flags & ~Flag::Lin
        };
        sset(inout b, index, SlotWord::Flags, next);
        if want {
            b.live_linear = inc(b.live_linear);
        } else {
            b.live_linear = dec(b.live_linear);
        }
    }
}

// Gives buffer `index` room for `new_cap` elements, in place at the tip or by
// relocation.
fn resize(inout b: Book, index: u64, new_cap: u64, fresh_base: u64, fresh_cap: u64) -> Grown {
    let s = slot_at(in b, index);
    let new_bytes = match mul_bytes(new_cap, s.esize) {
        Option::Some(n) => n,
        Option::None => {
            return Grown::Fail(Fault::SizeOverflow);
        },
    };
    let base = addr_of(in b, s);
    if is_tip(in b, index)
        && !add_overflows(s.start, new_bytes)
        && wrapping_add(s.start, new_bytes) <= chunk_at(in b, s.chunk).cap {
        set_cursor(inout b, s.chunk, wrapping_add(s.start, new_bytes));
        let mut t = s;
        t.len = new_bytes;
        t.ecap = new_cap;
        set_slot(inout b, index, t);
        return Grown::Ready {
            slot: index,
            serial: s.serial,
            base: base,
            len: s.elen
        };
    }
    match reserve_slot(in b) {
        Option::Some(f) => {
            return Grown::Fail(f);
        },
        Option::None => (),
    }
    match place(inout b, new_bytes, s.align, fresh_base, fresh_cap) {
        Place::At {
            chunk,
            prior,
            start
        } => {
            let i = push_slot(inout b, chunk, prior, start, new_bytes, s.align, Kind::Elements, 0);
            let mut old = s;
            old.elems = false;
            old.lin = false;
            old.st = State::Released;
            set_slot(inout b, index, old);
            let mut fresh = slot_at(in b, i);
            fresh.elems = true;
            fresh.elen = s.elen;
            fresh.ecap = new_cap;
            fresh.esize = s.esize;
            fresh.edrop = s.edrop;
            fresh.elin = s.elin;
            fresh.lin = s.lin;
            set_slot(inout b, i, fresh);
            Grown::Relocated {
                slot: i,
                serial: fresh.serial,
                src: base,
                base: addr_of(in b, fresh),
                len: s.elen,
                bytes: wrapping_mul(s.elen, s.esize),
                pending: b.pending.len()
            }
        },
        Place::Need {
            cap,
            align
        } => Grown::Need {
            cap: cap,
            align: align,
            retry: false,
            fallback: false
        },
        Place::Fail(f) => Grown::Fail(f),
    }
}

fn falls_back(g: Grown) -> bool {
    match g {
        Grown::Fail(f) => match f {
            Fault::SizeOverflow => true,
            Fault::CapacityExceeded {
                requested,
                reserved,
                limit
            } => true,
            _ => false,
        },
        _ => false,
    }
}

// Adds `claim` to the element count of the (possibly relocated) buffer.
fn claim_elems(inout b: Book, g: Grown, claim: u64) -> Grown {
    if claim == 0 {
        return g;
    }
    let index = match g {
        Grown::Ready {
            slot,
            serial,
            base,
            len
        } => slot,
        Grown::Relocated {
            slot,
            serial,
            src,
            base,
            len,
            bytes,
            pending
        } => slot,
        _ => {
            return g;
        },
    };
    let elen = wrapping_add(sget(in b, index, SlotWord::Elen), claim);
    sset(inout b, index, SlotWord::Elen, elen);
    sync_linear(inout b, index);
    g
}

// Ensures room for `additional` more elements, amortized (doubling) unless
// `exact`, falling back to the exact requirement when the amortized request
// does not fit the region's bounds (`skip_target` makes that fallback
// directly, after the backing refused the amortized chunk). Then counts
// `claim` new elements as initialized; the Rust side writes them at once.
pub fn book_grow(
    inout b: Book,
    slot: u64,
    serial: u64,
    additional: u64,
    exact: bool,
    claim: u64,
    skip_target: bool,
    fresh_base: u64,
    fresh_cap: u64
) -> Grown {
    let index = match resolve(in b, slot, serial, Kind::Elements) {
        Result::Ok(i) => i,
        Result::Err(f) => {
            return Grown::Fail(f);
        },
    };
    let elen = sget(in b, index, SlotWord::Elen);
    if add_overflows(elen, additional) {
        return Grown::Fail(Fault::SizeOverflow);
    }
    let required = wrapping_add(elen, additional);
    if required <= sget(in b, index, SlotWord::Ecap) {
        // The fast path: room already reserved.
        if claim != 0 {
            sset(inout b, index, SlotWord::Elen, wrapping_add(elen, claim));
            if flag(sget(in b, index, SlotWord::Flags), Flag::Elin) {
                sync_linear(inout b, index);
            }
        }
        return Grown::Ready {
            slot: index,
            serial: serial,
            base: sget(in b, index, SlotWord::Addr),
            len: elen
        };
    }
    let s = slot_at(in b, index);
    if index < mark_floor(in b) {
        return Grown::Fail(Fault::Protected);
    }
    if exact || skip_target {
        let g = resize(inout b, index, required, fresh_base, fresh_cap);
        return claim_elems(inout b, g, claim);
    }
    let doubled = if s.ecap > ISIZE_MAX {
        MAX_U64
    } else {
        wrapping_mul(s.ecap, GROWTH_FACTOR)
    };
    let target = max(max(required, doubled), min_growth_cap(s.esize));
    let g = resize(inout b, index, target, fresh_base, fresh_cap);
    let g = match g {
        Grown::Need {
            cap,
            align,
            retry,
            fallback
        } => Grown::Need {
            cap: cap,
            align: align,
            retry: target > required,
            fallback: false
        },
        _ => g,
    };
    if target > required && falls_back(g) {
        let r = resize(inout b, index, required, fresh_base, fresh_cap);
        let r = match r {
            Grown::Need {
                cap,
                align,
                retry,
                fallback
            } => Grown::Need {
                cap: cap,
                align: align,
                retry: false,
                fallback: true
            },
            _ => r,
        };
        return claim_elems(inout b, r, claim);
    }
    claim_elems(inout b, g, claim)
}

// Moves the last element out: its address, or `MAX_U64` when empty.
pub fn book_pop(inout b: Book, slot: u64, serial: u64) -> Result[u64, Fault] {
    match resolve(in b, slot, serial, Kind::Elements) {
        Result::Ok(i) => {
            let mut s = slot_at(in b, i);
            if s.elen == 0 {
                return Result::Ok(MAX_U64);
            }
            s.elen = dec(s.elen);
            set_slot(inout b, i, s);
            sync_linear(inout b, i);
            Result::Ok(wrapping_add(addr_of(in b, s), wrapping_mul(s.elen, s.esize)))
        },
        Result::Err(f) => Result::Err(f),
    }
}

// Shortens the buffer to `new_len`; the Rust side drops `from..to`.
pub fn book_truncate(inout b: Book, slot: u64, serial: u64, new_len: u64) -> Result[Span, Fault] {
    match resolve(in b, slot, serial, Kind::Elements) {
        Result::Ok(i) => {
            let mut s = slot_at(in b, i);
            let base = addr_of(in b, s);
            if new_len >= s.elen {
                return Result::Ok(
                    Span {
                        base: base,
                        from: s.elen,
                        to: s.elen,
                        pending: 0
                    }
                );
            }
            if s.elin {
                return Result::Err(Fault::Linear(wrapping_sub(s.elen, new_len)));
            }
            let len = s.elen;
            s.elen = new_len;
            set_slot(inout b, i, s);
            Result::Ok(
                Span {
                    base: base,
                    from: new_len,
                    to: len,
                    pending: 0
                }
            )
        },
        Result::Err(f) => Result::Err(f),
    }
}

// Empties the buffer, keeping its capacity; the Rust side moves `0..to` out.
pub fn book_drain(inout b: Book, slot: u64, serial: u64) -> Result[Span, Fault] {
    match resolve(in b, slot, serial, Kind::Elements) {
        Result::Ok(i) => {
            let mut s = slot_at(in b, i);
            let len = s.elen;
            s.elen = 0;
            set_slot(inout b, i, s);
            sync_linear(inout b, i);
            Result::Ok(
                Span {
                    base: addr_of(in b, s),
                    from: 0,
                    to: len,
                    pending: 0
                }
            )
        },
        Result::Err(f) => Result::Err(f),
    }
}

// Releases an element buffer (kind 2, or 3 for a frozen slice). A nonempty
// linear vector fails with `Fault::Linear(len)` and is unchanged. The Rust
// side drops `0..to`.
pub fn book_release_elems(inout b: Book, slot: u64, serial: u64, kind: u64) -> Result[Span, Fault] {
    match resolve(in b, slot, serial, kind) {
        Result::Ok(i) => {
            let s = slot_at(in b, i);
            if s.lin {
                return Result::Err(Fault::Linear(s.elen));
            }
            let len = s.elen;
            let base = addr_of(in b, s);
            let mut t = s;
            t.elen = 0;
            set_slot(inout b, i, t);
            sync_linear(inout b, i);
            let mut u = slot_at(in b, i);
            u.st = State::Released;
            set_slot(inout b, i, u);
            reclaim_tail(inout b);
            Result::Ok(
                Span {
                    base: base,
                    from: 0,
                    to: len,
                    pending: b.pending.len()
                }
            )
        },
        Result::Err(f) => Result::Err(f),
    }
}

// Freezes a vector into a read-only slice naming the same buffer.
pub fn book_freeze(inout b: Book, slot: u64, serial: u64) -> Result[u64, Fault] {
    match resolve(in b, slot, serial, Kind::Elements) {
        Result::Ok(i) => {
            let mut s = slot_at(in b, i);
            if s.lin {
                return Result::Err(Fault::Linear(s.elen));
            }
            s.elin = false;
            s.kind = Kind::Frozen;
            set_slot(inout b, i, s);
            Result::Ok(0)
        },
        Result::Err(f) => Result::Err(f),
    }
}
