// @vesper/warp-bbr, part 2 of 8 (order in ../Loom.toml): integer helpers,
// including the 128-bit products the Rust code computed in u128 (from the
// total full product `mul_wide`).

fn min(a: u64, b: u64) -> u64 {
    if a < b {
        a
    } else {
        b
    }
}

fn max(a: u64, b: u64) -> u64 {
    if a > b {
        a
    } else {
        b
    }
}

fn add_overflows(a: u64, b: u64) -> bool {
    wrapping_add(a, b) < a
}

fn sat_add(a: u64, b: u64) -> u64 {
    let s = wrapping_add(a, b);
    if s < a {
        INFINITY
    } else {
        s
    }
}

fn sat_sub(a: u64, b: u64) -> u64 {
    if a > b {
        wrapping_sub(a, b)
    } else {
        0
    }
}

fn sat_mul(a: u64, b: u64) -> u64 {
    let (lo, hi) = mul_wide(a, b);
    if hi != 0 {
        INFINITY
    } else {
        lo
    }
}

// `a / b` for a divisor the caller knows is non-zero (0 otherwise). The
// explicit test proves the divisor non-zero to the checker, so the body needs
// no `Fail[RuntimeError]` handler and the inliner can inline it.
fn div(a: u64, b: u64) -> u64 {
    if b == 0 {
        0
    } else {
        a / b
    }
}

// `2^n` for `n < 64` (0 otherwise). `rotate_left` is total and equals
// `1 << n` for `n < 64`, so no `Fail[ArithOverflow]` handler is needed.
fn pow2(n: u32) -> u64 {
    if n < 64 {
        let one: u64 = 1;
        rotate_left(one, n)
    } else {
        0
    }
}

// floor((hi * 2^64 + lo) / d), saturated to u64::MAX; `d > 0`.
fn div_wide_sat(hi: u64, lo: u64, d: u64) -> u64 {
    if d == 0 {
        return INFINITY;
    }
    if hi == 0 {
        return div(lo, d);
    }
    if hi >= d {
        return INFINITY;
    }
    // Restoring long division: the remainder stays below d, and the bit
    // shifted out of it (`top`) stands for 2^64.
    let mut rem = hi;
    let mut rest = lo;
    let mut q: u64 = 0;
    for i in 0..64 {
        let top = rem >> 63;
        rem = (rem << 1) | (rest >> 63);
        rest = rest << 1;
        q = q << 1;
        if top == 1 || rem >= d {
            rem = wrapping_sub(rem, d);
            q = q | 1;
        }
    }
    q
}

// floor(a * b / c), saturated; `c > 0`.
// The common case, both factors below 2^32, needs no wide product.
fn mul_div_sat(a: u64, b: u64, c: u64) -> u64 {
    if a <= U32_MAX && b <= U32_MAX {
        return div(wrapping_mul(a, b), c);
    }
    let (lo, hi) = mul_wide(a, b);
    div_wide_sat(hi, lo, c)
}

// Whether a * b > c * d, exactly.
fn product_gt(a: u64, b: u64, c: u64, d: u64) -> bool {
    if a <= U32_MAX && b <= U32_MAX && c <= U32_MAX && d <= U32_MAX {
        return wrapping_mul(a, b) > wrapping_mul(c, d);
    }
    let (l1, h1) = mul_wide(a, b);
    let (l2, h2) = mul_wide(c, d);
    h1 > h2 || (h1 == h2 && l1 > l2)
}

// Saturating `x * gain / 1000`; Infinity stays Infinity.
pub fn mul_gain(x: u64, gain: u64) -> u64 {
    if x == INFINITY {
        INFINITY
    } else {
        mul_div_sat(x, gain, GAIN_UNIT)
    }
}

// Saturating `bw * ns / 10^9`: bytes delivered at `bw` over `ns`.
fn bw_volume(bw: u64, ns: u64) -> u64 {
    mul_div_sat(bw, ns, NANOS_PER_SEC)
}
