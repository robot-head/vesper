// @vesper/warp-bbr, part 1 of 8 (order in ../Loom.toml): sans-IO BBRv3
// congestion control and earliest-departure-time pacing for Vesper Warp
// (port wave P1 lane 10, #907).
//
// This is the implementation of the `vesper-warp-bbr` crate. The Rust crate
// keeps the public types and a thin wrapper that forwards every call here
// through the generated binding (`port/binding.rs`).
//
// The state machine follows draft-ietf-ccwg-bbr-07, transcribed into integer
// arithmetic: volumes in bytes, rates in bytes per second, times in caller-
// supplied virtual nanoseconds, gains per mille (1000 means 1.0). The
// draft's "Infinity" is 18446744073709551615 (`u64::MAX`). Products the Rust
// code computed in `u128` use the full product `mul_wide` and the helpers of
// part 2, and saturate to `u64::MAX`; differences of counters saturate at 0.
//
// Every entry point that can reject its input raises `Fail[BbrFault]`
// (the binding returns it as `Result<_, BbrFault>`) and checks everything
// before it changes the state. A failure keeps the writes made to an
// `inout` parameter before it, and there are none: a rejected call leaves
// the controller unchanged.
//
// Export ABI v3 (#934): the Rust crate keeps `repr::Bbrv3`, the binding's
// mirror of `Bbrv3`, as its storage in the Vesper build and lends it to
// every call in place.
// @export abi 3 options

// ---------------------------------------------------------------------
// Constants (the same names as the Rust crate's `bbr.rs`, `pacing.rs` and
// `events.rs`). Gains are per mille: `GAIN_UNIT` (1000) means 1.0.
// Initializers are literals because `-` and `*` on `u64` may raise.

// The draft's "Infinity" for volumes and rates (`u64::MAX`).
const INFINITY: u64 = 18446744073709551615;
// `u32::MAX`: windows are reported as `u32`.
const U32_MAX: u64 = 4294967295;
const NANOS_PER_SEC: u64 = 1000000000;
// `pacing_rate / MILLIS_PER_SEC` is one millisecond of data.
const MILLIS_PER_SEC: u64 = 1000;
// Fixed-point unit for gains and fractions: 1000 means 1.0.
const GAIN_UNIT: u64 = 1000;
// `BBR.StartupPacingGain` = 4 ln 2, about 2.77.
const STARTUP_PACING_GAIN: u64 = 2770;
// `BBR.DrainPacingGain` = 0.5.
const DRAIN_PACING_GAIN: u64 = 500;
// `BBR.DefaultCwndGain` = 2.
const DEFAULT_CWND_GAIN: u64 = 2000;
// ProbeBW_DOWN pacing gain 0.90.
const PROBE_DOWN_PACING_GAIN: u64 = 900;
// ProbeBW_CRUISE, ProbeBW_REFILL and ProbeRTT pacing gain 1.0.
const UNIT_PACING_GAIN: u64 = 1000;
// ProbeBW_UP pacing gain 1.25.
const PROBE_UP_PACING_GAIN: u64 = 1250;
// ProbeBW_UP cwnd gain 2.25.
const PROBE_UP_CWND_GAIN: u64 = 2250;
// `BBR.ProbeRTTCwndGain` = 0.5.
const PROBE_RTT_CWND_GAIN: u64 = 500;
// `BBR.LossThresh` = 2%.
const LOSS_THRESH: u64 = 20;
// `GAIN_UNIT - LOSS_THRESH`.
const GAIN_UNIT_MINUS_LOSS_THRESH: u64 = 980;
// `BBR.Beta` = 0.7.
const BETA: u64 = 700;
// `BBR.Headroom` = 0.15.
const HEADROOM: u64 = 150;
// `100 - BBR.PacingMarginPercent` (the margin is 1%).
const PACING_MARGIN_KEEP_PERCENT: u64 = 99;
// `GAIN_UNIT * 100`, the divisor of a gain times a percentage.
const GAIN_UNIT_TIMES_PERCENT: u64 = 100000;
// Full-pipe growth threshold 1.25.
const FULL_BW_GROWTH: u64 = 1250;
// `BBR.MinRTTFilterLen` = 10 s.
const MIN_RTT_FILTER_LEN_NS: u64 = 10000000000;
// `BBR.ProbeRTTDuration` = 200 ms.
const PROBE_RTT_DURATION_NS: u64 = 200000000;
// Maximum send quantum, 64 KiB.
const MAX_SEND_QUANTUM: u64 = 65536;
// Lower bound of the randomized ProbeBW wait, 2 s.
const PROBE_WAIT_BASE_NS: u64 = 2000000000;
// The randomized part of the ProbeBW wait is drawn from
// `0..PROBE_WAIT_DRAWS_NS`, that is up to `PROBE_WAIT_RANGE_NS` (1 s).
const PROBE_WAIT_DRAWS_NS: u64 = 1000000001;
// Cap on Reno-coexistence rounds.
const RENO_ROUNDS_CAP: u64 = 63;
// Cap on `bw_probe_up_rounds`, so `1 << rounds` stays in range.
const MAX_PROBE_UP_ROUNDS: u32 = 30;
// The smoothed RTT assumed before there is a sample, 1 ms.
const DEFAULT_SRTT_NS: u64 = 1000000;
// RFC 9002 §7.2 initial window floor: `min(10 * smss, max(14720, 2 * smss))`.
const INITIAL_WINDOW_FLOOR_BYTES: u64 = 14720;
// The largest accepted sender maximum segment size.
const MAX_SMSS: u32 = 65535;
// QUIC packet numbers are below 2^62 (RFC 9000 §12.3).
const MAX_PACKET_NUMBER: u64 = 4611686018427387903;
// The default seed of the ProbeBW wait generator ("bbr3warp" in ASCII).
const DEFAULT_PROBE_SEED: u64 = 0x6262723377617270;
// SplitMix64 increment and finalizer multipliers.
const SPLITMIX_GAMMA: u64 = 0x9e3779b97f4a7c15;
const SPLITMIX_MUL_1: u64 = 0xbf58476d1ce4e5b9;
const SPLITMIX_MUL_2: u64 = 0x94d049bb133111eb;

// ---------------------------------------------------------------------
// Types shared with the Rust crate (same names, fields and variants).

// `BBR.state`.
copy enum BbrState {
    Startup,
    Drain,
    ProbeBwDown,
    ProbeBwCruise,
    ProbeBwRefill,
    ProbeBwUp,
    ProbeRtt
}

// How `BBR.offload_budget` is computed.
copy enum OffloadModel {
    Quic,
    Tcp
}

// Controller configuration.
copy struct BbrConfig {
    smss: u32,
    initial_cwnd: u32,
    has_selective_acks: bool,
    offload: OffloadModel,
    probe_seed: u64
}

// The per-ACK rate sample `RS`.
copy struct RateSample {
    delivery_rate: u64,
    is_app_limited: bool,
    interval_ns: u64,
    delivered: u64,
    prior_delivered: u64,
    prior_time_ns: Option[u64],
    send_elapsed_ns: u64,
    ack_elapsed_ns: u64,
    last_acked_pn: u64,
    rtt_ns: Option[u64],
    newly_acked: u64,
    tx_in_flight: u64,
    lost: u64
}

// Kathleen Nichols' windowed running maximum over three (time, value)
// samples, as in Linux `lib/minmax.c`.
copy struct WindowedMax {
    t0: u64,
    v0: u64,
    t1: u64,
    v1: u64,
    t2: u64,
    v2: u64
}

// The two-slot bandwidth filter keyed by `BBR.cycle_count`.
copy struct CycleMax {
    previous: u64,
    current: u64
}

// A packet handed to the network.
copy struct SentPacket {
    pn: u64,
    sent_ns: u64,
    bytes: u32,
    ack_eliciting: bool,
    in_flight: bool
}

// A packet newly acknowledged by the peer.
copy struct AckedPacket {
    pn: u64,
    sent_ns: u64,
    bytes: u32
}

// A packet declared lost by loss detection.
copy struct LostPacket {
    pn: u64,
    sent_ns: u64,
    bytes: u32
}

// RTT estimator output for the ACK being processed (RFC 9002 section 5).
copy struct RttSample {
    latest_ns: u64,
    min_ns: u64,
    smoothed_ns: u64,
    ack_delay_ns: u64
}

// Delivery-rate state snapshotted when a packet is sent.
copy struct PacketDeliveryState {
    delivered: u64,
    delivered_ns: u64,
    first_sent_ns: u64,
    is_app_limited: bool,
    tx_in_flight: u64,
    lost: u64,
    counted: bool
}

// The crate's `BbrError`, with the configuration message as a code
// (0: smss out of range, 1: initial_cwnd below smss); the Rust wrapper maps
// it to the error's `&'static str`.
copy enum BbrFault {
    InvalidConfig(u64),
    PacketNumberOutOfRange {
        pn: u64
    },
    EmptyInFlightPacket {
        pn: u64
    },
    CwndFull {
        bytes_in_flight: u64,
        cwnd: u64
    },
    InflightUnderflow {
        bytes_in_flight: u64,
        released: u64
    },
    ForeignSnapshot {
        pn: u64
    },
    TimeWentBackwards {
        last_ns: u64,
        now_ns: u64
    },
    AckedBeforeSent {
        pn: u64
    },
    CounterOverflow
}

// The BBRv3 controller and EDT pacer for one flow. `rng` is the SplitMix64
// state of the randomized probe wait.
copy struct Bbrv3 {
    smss: u64,
    initial_cwnd: u64,
    has_selective_acks: bool,
    offload: OffloadModel,
    rng: u64,
    delivered: u64,
    delivered_ns: u64,
    first_sent_ns: u64,
    app_limited: u64,
    lost: u64,
    ce_bytes: u64,
    inflight: u64,
    cwnd: u64,
    pacing_rate: u64,
    send_quantum: u64,
    next_edt_ns: u64,
    srtt_ns: Option[u64],
    lifetime_min_rtt_ns: Option[u64],
    pacing_from_rtt: bool,
    is_cwnd_limited: bool,
    cwnd_limited_this_round: bool,
    in_recovery: bool,
    recovery_start_ns: u64,
    last_now_ns: u64,
    ce_pending: bool,
    ce_in_loss_round: bool,
    rs: RateSample,
    bbr_state: BbrState,
    pacing_gain: u64,
    cwnd_gain: u64,
    round_count: u64,
    round_start: bool,
    next_round_delivered: u64,
    idle_restart: bool,
    drain_start_round: u64,
    max_bw_filter: CycleMax,
    max_bw: u64,
    bw_shortterm: u64,
    bw: u64,
    cycle_count: u64,
    min_rtt_ns: Option[u64],
    min_rtt_stamp_ns: u64,
    min_rtt_expired: bool,
    bdp: u64,
    extra_acked_filter: WindowedMax,
    extra_acked: u64,
    extra_acked_interval_start_ns: u64,
    extra_acked_delivered: u64,
    offload_budget: u64,
    max_inflight: u64,
    inflight_longterm: u64,
    inflight_shortterm: u64,
    bw_latest: u64,
    inflight_latest: u64,
    loss_round_delivered: u64,
    loss_round_start: bool,
    is_loss_in_round: bool,
    loss_events_in_round: u64,
    full_bw_reached: bool,
    full_bw_now: bool,
    full_bw: u64,
    full_bw_count: u32,
    is_bw_probe_stopping: bool,
    check_probe_loss: bool,
    bw_probe_up_acked: u64,
    probe_up_acked_per_inc: u64,
    bw_probe_up_rounds: u32,
    rounds_since_probe_up: u64,
    bw_probe_wait_ns: u64,
    cycle_stamp_ns: u64,
    prev_probe_too_high: bool,
    prev_probe_precautionary: bool,
    undo_state: Option[BbrState],
    undo_bw_shortterm: u64,
    undo_inflight_shortterm: u64,
    undo_inflight_longterm: u64,
    prior_cwnd: u64,
    probe_rtt_done_stamp_ns: Option[u64],
    probe_rtt_round_done: bool,
    probe_rtt_cwnd: u64
}

// The state of one ACK between the calls the Rust wrapper makes for it:
// `ack_check` per packet (validation, no state change), `ack_check_totals`
// once, then `bbrv3_ack_step` per packet. This replaces the Rust slice
// parameter, which the export ABI would copy into a heap buffer.
copy struct AckProgress {
    rs: RateSample,
    has_newest: bool,
    newest_sent_ns: u64,
    newest_tx_in_flight: u64,
    newest_lost: u64,
    released: u64,
    newly_delivered: u64
}
