use self::ascii::{
    Ascii
};
// Byte-level grammars of the decoder: tokens, targets, Host (with Rust std's
// IPv4/IPv6 parsers) and field values.

// ASCII bytes this module compares against (constants are per module).
// 'a' - 'A': adding it lowercases an ASCII capital.
const ASCII_CASE_OFFSET: u8 = 32;
// 'a' - 10 and 'A' - 10: subtracting them gives a hex letter's value.
const LOWER_HEX_OFFSET: u8 = 87;
const UPPER_HEX_OFFSET: u8 = 55;
// `u64::MAX / 10` and `u64::MAX % 10`: the overflow check of a decimal read.
const U64_MAX_DIV_10: u64 = 1844674407370955161;
const U64_MAX_LAST_DIGIT: u64 = 5;

// The RFC 9110 §5.6.2 `tchar` bytes (ALPHA, DIGIT and !#$%&'*+-.^_`|~):
// bit `b` of LOW for bytes 0-63, bit `b - 64` of HIGH for 64-127.
const TCHAR_MASK_LOW: u64 = 288068722172624896;
const TCHAR_MASK_HIGH: u64 = 6341068274398134270;
// RFC 9110 §5.5 field-value bytes: VCHAR, SP and HTAB (LOW) and 64-126
// (HIGH); bytes 128-255 (obs-text) pass with `find_not_in`'s high flag.
const FIELD_VALUE_MASK_LOW: u64 = 18446744069414584832;
const FIELD_VCHAR_MASK_HIGH: u64 = 9223372036854775807;
// The bytes RFC 3986 lets an origin-form target carry unescaped (ALPHA,
// DIGIT and -._~!$&'()*+,;=:@/?): bit `b` of LOW for bytes 0-63, bit
// `b - 64` of HIGH for 64-127.
const TARGET_CHAR_MASK_LOW: u64 = 12682136353106821120;
const TARGET_CHAR_MASK_HIGH: u64 = 5188146764422578175;

pub fn inc(x: u64) -> u64 {
    wrapping_add(x, 1)
}

pub fn dec(x: u64) -> u64 {
    wrapping_sub(x, 1)
}

pub fn max_u64() -> u64 {
    18446744073709551615
}

pub fn byte(in s: Slice[u8], i: u64) -> u8 {
    match s.try_get(i) {
        Option::Some(b) => b,
        Option::None => 0,
    }
}

pub fn queued(in front: Slice[u8], in back: Slice[u8], i: u64) -> u8 {
    if i < front.len() {
        byte(in front, i)
    } else {
        byte(in back, wrapping_sub(i, front.len()))
    }
}

pub fn is_digit(b: u8) -> bool {
    b >= Ascii::Digit0 && b <= Ascii::Digit9
}

pub fn is_alpha(b: u8) -> bool {
    (b >= Ascii::UpperA && b <= Ascii::UpperZ) || (b >= Ascii::LowerA && b <= Ascii::LowerZ)
}

pub fn is_alnum(b: u8) -> bool {
    is_digit(b) || is_alpha(b)
}

pub fn is_hex(b: u8) -> bool {
    is_digit(b)
        || (b >= Ascii::UpperA && b <= Ascii::UpperF)
        || (b >= Ascii::LowerA && b <= Ascii::LowerF)
}

pub fn lower(b: u8) -> u8 {
    if b >= Ascii::UpperA && b <= Ascii::UpperZ {
        wrapping_add(b, ASCII_CASE_OFFSET)
    } else {
        b
    }
}

// The RFC 9110 `tchar` bytes (ALPHA, DIGIT and !#$%&'*+-.^_`|~) as two
// 64-bit masks. A mask test calls nothing and stays small enough to inline;
// a comparison chain does not. `rotate_right` is the total shift.
pub fn token(b: u8) -> bool {
    let i = widen_u64(b);
    let low = TCHAR_MASK_LOW;
    let high = TCHAR_MASK_HIGH;
    if i < 64 {
        (rotate_right(low, i) & 1) == 1
    } else if i < 128 {
        (rotate_right(high, wrapping_sub(i, 64)) & 1) == 1
    } else {
        false
    }
}

// The hot loops read with `try_get` directly: a call to `byte` is not
// inlined, because the inliner skips functions with slice parameters.
pub fn all_token(in s: Slice[u8], lo: u64, hi: u64) -> bool {
    if lo > hi || hi > s.len() {
        return false;
    }
    tokens(in s[lo..hi])
}

fn tokens(in s: Slice[u8]) -> bool {
    match s.find_not_in(TCHAR_MASK_LOW, TCHAR_MASK_HIGH, false) {
        Option::Some(i) => false,
        Option::None => true,
    }
}

// No control byte but tab (field values; bytes >= 128 are obs-text).
pub fn value_ok(in s: Slice[u8]) -> bool {
    match s.find_not_in(FIELD_VALUE_MASK_LOW, FIELD_VCHAR_MASK_HIGH, true) {
        Option::Some(i) => false,
        Option::None => true,
    }
}

fn same_fold(in a: Slice[u8], in b: Slice[u8]) -> bool {
    a.eq_ignore_ascii_case(in b)
}

fn target_run(in t: Slice[u8]) -> Option[u64] {
    t.find_not_in(TARGET_CHAR_MASK_LOW, TARGET_CHAR_MASK_HIGH, false)
}

fn same_bytes(in a: Slice[u8], in b: Slice[u8]) -> bool {
    a.eq(in b)
}

pub fn eq_lit(in s: Slice[u8], lo: u64, hi: u64, in lit: Str, fold: bool) -> bool {
    if wrapping_sub(hi, lo) != lit.len() {
        return false;
    }
    if lo <= hi && hi <= s.len() {
        if fold {
            return same_fold(in s[lo..hi], in lit.as_bytes());
        }
        return same_bytes(in s[lo..hi], in lit.as_bytes());
    }
    for i in 0..lit.len() {
        let want = match lit.try_byte_at(i) {
            Option::Some(b) => b,
            Option::None => 0,
        };
        let have = match s.try_get(wrapping_add(lo, i)) {
            Option::Some(b) => b,
            Option::None => 0,
        };
        if fold {
            if lower(have) != lower(want) {
                return false;
            }
        } else if have != want {
            return false;
        }
    }
    true
}

pub fn named(in s: Slice[u8], lo: u64, hi: u64, in lit: Str) -> bool {
    eq_lit(in s, lo, hi, lit, true)
}

pub fn is_ows(b: u8) -> bool {
    b == Ascii::Space || b == Ascii::Tab
}

pub copy struct Span {
    lo: u64,
    hi: u64
}

pub fn trim_ows(in s: Slice[u8], lo: u64, hi: u64) -> Span {
    let mut a = lo;
    let mut b = hi;
    loop {
        if a >= b || !is_ows(byte(in s, a)) {
            break;
        }
        a = inc(a);
    }
    loop {
        if b <= a || !is_ows(byte(in s, dec(b))) {
            break;
        }
        b = dec(b);
    }
    Span {
        lo: a,
        hi: b
    }
}

fn first_byte(in s: Slice[u8], b: u8) -> Option[u64] {
    s.find_byte(b)
}

// The first `i` in `lo..hi` with `byte(in s, i) == b`, else `hi`. Bytes past
// the end read as 0, as in `byte`.
pub fn find(in s: Slice[u8], lo: u64, hi: u64, b: u8) -> u64 {
    let end = if hi < s.len() {
        hi
    } else {
        s.len()
    };
    if lo < end {
        match first_byte(in s[lo..end], b) {
            Option::Some(i) => {
                return wrapping_add(lo, i);
            },
            Option::None => (),
        }
    }
    if b == Ascii::Nul && end < hi && lo < hi {
        if lo > end {
            lo
        } else {
            end
        }
    } else {
        hi
    }
}

// The bytes the origin-form grammar allows unescaped (ALPHA, DIGIT and
// -._~!$&'()*+,;=:@/?) as two 64-bit masks, like `token`.
fn target_char(b: u8) -> bool {
    let i = widen_u64(b);
    let low = TARGET_CHAR_MASK_LOW;
    let high = TARGET_CHAR_MASK_HIGH;
    if i < 64 {
        (rotate_right(low, i) & 1) == 1
    } else if i < 128 {
        (rotate_right(high, wrapping_sub(i, 64)) & 1) == 1
    } else {
        false
    }
}

pub fn valid_target(options: bool, in t: Slice[u8], lo: u64, hi: u64) -> bool {
    let n = wrapping_sub(hi, lo);
    if n == 1 && byte(in t, lo) == 42 {
        return options;
    }
    if n == 0 || byte(in t, lo) != Ascii::Slash {
        return false;
    }
    if n >= 2 && byte(in t, inc(lo)) == Ascii::Slash {
        return false;
    }
    let mut i = lo;
    if hi > t.len() {
        return false;
    }
    loop {
        if i >= hi {
            break;
        }
        match target_run(in t[i..hi]) {
            Option::Some(j) => {
                i = wrapping_add(i, j);
            },
            Option::None => {
                return true;
            },
        }
        let b = match t.try_get(i) {
            Option::Some(b) => b,
            Option::None => 0,
        };
        if b == Ascii::Percent {
            let h1 = inc(i);
            let h2 = wrapping_add(i, 2);
            if h1 >= hi || !is_hex(byte(in t, h1)) || h2 >= hi || !is_hex(byte(in t, h2)) {
                return false;
            }
            i = wrapping_add(i, 3);
        } else if target_char(b) {
            i = inc(i);
        } else {
            return false;
        }
    }
    true
}

pub fn valid_port(in s: Slice[u8], lo: u64, hi: u64) -> bool {
    read_number(in s, lo, hi, 10, max_u64(), true, MAX_PORT) == hi
}

// Authority limits (RFC 3986 §3.2.2-3.2.3, RFC 1035 §2.3.4).
const MAX_PORT: u64 = 65535;
const IPV4_OCTET_DIGITS: u64 = 3;
const MAX_IPV4_OCTET: u64 = 255;
const IPV6_GROUP_DIGITS: u64 = 4;
const MAX_IPV6_GROUP: u64 = 65535;
const MAX_DNS_LABEL_LEN: u64 = 63;

pub fn digit_value(b: u8, radix: u64) -> u64 {
    if is_digit(b) {
        wrapping_sub(widen_u64(b), widen_u64(Ascii::Digit0))
    } else if radix == 16 && b >= Ascii::LowerA && b <= Ascii::LowerF {
        wrapping_sub(widen_u64(b), widen_u64(LOWER_HEX_OFFSET))
    } else if radix == 16 && b >= Ascii::UpperA && b <= Ascii::UpperF {
        wrapping_sub(widen_u64(b), widen_u64(UPPER_HEX_OFFSET))
    } else {
        radix
    }
}

// Rust's `read_number`: at most `max_digits` digits of `radix` with a value
pub fn read_number(
    in s: Slice[u8],
    at: u64,
    hi: u64,
    radix: u64,
    max_digits: u64,
    zero_prefix: bool,
    max_value: u64
) -> u64 {
    let leading_zero = at < hi && byte(in s, at) == Ascii::Digit0;
    let mut i = at;
    let mut value: u64 = 0;
    let mut digits: u64 = 0;
    loop {
        if i >= hi {
            break;
        }
        let d = digit_value(byte(in s, i), radix);
        if d >= radix {
            break;
        }
        value = wrapping_add(wrapping_mul(value, radix), d);
        if value > max_value {
            return max_u64();
        }
        digits = inc(digits);
        if digits > max_digits {
            return max_u64();
        }
        i = inc(i);
    }
    if digits == 0 || (!zero_prefix && leading_zero && digits > 1) {
        max_u64()
    } else {
        i
    }
}

// Rust's `Ipv4Addr` grammar: four decimal octets without leading zeros.
pub fn read_ipv4(in s: Slice[u8], at: u64, hi: u64) -> u64 {
    let mut i = at;
    for k in 0..4 {
        if k > 0 {
            if i >= hi || byte(in s, i) != Ascii::Dot {
                return max_u64();
            }
            i = inc(i);
        }
        i = read_number(in s, i, hi, 10, IPV4_OCTET_DIGITS, false, MAX_IPV4_OCTET);
        if i == max_u64() {
            return max_u64();
        }
    }
    i
}

pub copy struct Groups {
    count: u64,
    ipv4: bool,
    at: u64
}

pub fn groups(count: u64, ipv4: bool, at: u64) -> Groups {
    Groups {
        count: count,
        ipv4: ipv4,
        at: at
    }
}

// Rust's `read_groups` of the IPv6 parser.
pub fn read_groups(in s: Slice[u8], at: u64, hi: u64, limit: u64) -> Groups {
    let mut i = at;
    for g in 0..limit {
        let mut start = i;
        let mut ok = true;
        if g > 0 {
            if i < hi && byte(in s, i) == Ascii::Colon {
                start = inc(i);
            } else {
                ok = false;
            }
        }
        if !ok {
            return groups(g, false, i);
        }
        if inc(g) < limit {
            let v4 = read_ipv4(in s, start, hi);
            if v4 != max_u64() {
                return Groups {
                    count: wrapping_add(g, 2),
                    ipv4: true,
                    at: v4
                };
            }
        }
        let next = read_number(in s, start, hi, 16, IPV6_GROUP_DIGITS, true, MAX_IPV6_GROUP);
        if next == max_u64() {
            return groups(g, false, i);
        }
        i = next;
    }
    groups(limit, false, i)
}

// Rust's `Ipv6Addr::from_str` over `s[lo..hi]`.
pub fn valid_ipv6(in s: Slice[u8], lo: u64, hi: u64) -> bool {
    let head = read_groups(in s, lo, hi, 8);
    if head.count == 8 {
        return head.at == hi;
    }
    if head.ipv4 {
        return false;
    }
    let i = head.at;
    if inc(i) >= hi || byte(in s, i) != Ascii::Colon || byte(in s, inc(i)) != Ascii::Colon {
        return false;
    }
    let limit = wrapping_sub(8, inc(head.count));
    let tail = read_groups(in s, wrapping_add(i, 2), hi, limit);
    tail.at == hi
}

pub fn numeric_part(in s: Slice[u8], lo: u64, hi: u64) -> bool {
    if wrapping_sub(hi, lo) >= 2
        && byte(in s, lo) == Ascii::Digit0
        && lower(byte(in s, inc(lo))) == Ascii::LowerX {
        read_number(in s, wrapping_add(lo, 2), hi, 16, max_u64(), true, max_u64()) == hi
    } else {
        read_number(in s, lo, hi, 10, max_u64(), true, max_u64()) == hi
    }
}

pub fn valid_label(in s: Slice[u8], lo: u64, hi: u64) -> bool {
    let n = wrapping_sub(hi, lo);
    if n == 0 || n > MAX_DNS_LABEL_LEN {
        return false;
    }
    if !is_alnum(byte(in s, lo)) || !is_alnum(byte(in s, dec(hi))) {
        return false;
    }
    for i in lo..hi {
        let b = match s.try_get(i) {
            Option::Some(b) => b,
            Option::None => 0,
        };
        if !is_alnum(b) && b != 45 {
            return false;
        }
    }
    true
}

pub fn valid_host(in s: Slice[u8], lo: u64, hi: u64) -> bool {
    if lo < hi && byte(in s, lo) == 91 {
        let end = find(in s, lo, hi, 93);
        if end == hi {
            return false;
        }
        if !valid_ipv6(in s, inc(lo), end) {
            return false;
        }
        let after = inc(end);
        if after == hi {
            return true;
        }
        return byte(in s, after) == Ascii::Colon && valid_port(in s, inc(after), hi);
    }
    let colon = find(in s, lo, hi, Ascii::Colon);
    if colon < hi {
        let port_lo = inc(colon);
        let port_hi = find(in s, port_lo, hi, Ascii::Colon);
        if !valid_port(in s, port_lo, port_hi) || port_hi < hi {
            return false;
        }
    }
    let host_hi = colon;
    let mut class_hi = host_hi;
    if class_hi > lo && byte(in s, dec(class_hi)) == Ascii::Dot {
        class_hi = dec(class_hi);
    }
    let mut numeric = true;
    let mut part = lo;
    loop {
        let end = find(in s, part, class_hi, Ascii::Dot);
        if !numeric_part(in s, part, end) {
            numeric = false;
            break;
        }
        if end >= class_hi {
            break;
        }
        part = inc(end);
    }
    if numeric {
        return read_ipv4(in s, lo, host_hi) == host_hi;
    }
    let mut name_hi = host_hi;
    if name_hi > lo && byte(in s, dec(name_hi)) == Ascii::Dot {
        name_hi = dec(name_hi);
    }
    let n = wrapping_sub(name_hi, lo);
    if n == 0 || n > 253 {
        return false;
    }
    let mut label = lo;
    loop {
        let end = find(in s, label, name_hi, Ascii::Dot);
        if !valid_label(in s, label, end) {
            return false;
        }
        if end >= name_hi {
            break;
        }
        label = inc(end);
    }
    true
}

pub fn decimal(in s: Slice[u8], lo: u64, hi: u64) -> Option[u64] {
    if lo >= hi {
        return Option::None;
    }
    let mut v: u64 = 0;
    for i in lo..hi {
        let d = wrapping_sub(widen_u64(byte(in s, i)), widen_u64(Ascii::Digit0));
        if d > 9 || v > U64_MAX_DIV_10 || (v == U64_MAX_DIV_10 && d > U64_MAX_LAST_DIGIT) {
            return Option::None;
        }
        v = wrapping_add(wrapping_mul(v, 10), d);
    }
    Option::Some(v)
}

pub fn push_range(inout out: ChunkSeq[u8], in s: Slice[u8], lo: u64, hi: u64) {
    if lo <= hi && hi <= s.len() {
        out.extend(in s[lo..hi]);
    } else {
        for i in lo..hi {
            out.push(byte(in s, i));
        }
    }
}

// `all_token(in s, lo, hi)`, appending the lowercased bytes to `out` on
// the way (one pass for the check and the copy of a field name).
pub fn push_token_lower(inout out: ChunkSeq[u8], in s: Slice[u8], lo: u64, hi: u64) -> bool {
    if lo <= hi && hi <= s.len() {
        if !tokens(in s[lo..hi]) {
            return false;
        }
        out.extend_ascii_lowercase(in s[lo..hi]);
        return true;
    }
    for i in lo..hi {
        match s.try_get(i) {
            Option::Some(b) => {
                if !token(b) {
                    return false;
                }
                out.push(lower(b));
            },
            Option::None => {
                return false;
            },
        }
    }
    true
}

pub fn connection_options(in s: Slice[u8], lo: u64, hi: u64) -> u64 {
    let mut flags: u64 = 0;
    let mut start = lo;
    loop {
        let comma = find(in s, start, hi, 44);
        let o = trim_ows(in s, start, comma);
        if o.lo >= o.hi || !all_token(in s, o.lo, o.hi) {
            return 4;
        }
        let option_len = wrapping_sub(o.hi, o.lo);
        if option_len == 7 && named(in s, o.lo, o.hi, "upgrade") {
            flags = flags | 1;
        }
        if option_len == 5 && named(in s, o.lo, o.hi, "close") {
            flags = flags | 2;
        }
        if (option_len == 14 && named(in s, o.lo, o.hi, "content-length"))
            || (option_len == 17 && named(in s, o.lo, o.hi, "transfer-encoding"))
            || (option_len == 4 && named(in s, o.lo, o.hi, "host")) {
            return 4;
        }
        if comma >= hi {
            break;
        }
        start = inc(comma);
    }
    flags
}
