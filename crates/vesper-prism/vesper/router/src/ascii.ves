// Module ascii of @vesper/prism-router: the ASCII bytes its modules compare
// against. Untyped, so a member is a `u8` or a `u64` where it is used.

// ASCII characters.
pub enum Ascii: _ {
    Nul = 0,
    Space = 0x20,
    Hash = 0x23,
    Percent = 0x25,
    Dot = 0x2e,
    Slash = 0x2f,
    Digit0 = 0x30,
    Digit9 = 0x39,
    Colon = 0x3a,
    Question = 0x3f,
    UpperA = 0x41,
    UpperZ = 0x5a,
    Backslash = 0x5c,
    Underscore = 0x5f,
    LowerA = 0x61,
    LowerZ = 0x7a,
    Del = 0x7f,
}
