// Vesper port of the fixed-length HTTP/1.1 response encoder of
// crates/vesper-prism (`ResponseBuilder` in src/response.rs, port wave P1
// lane 14, #911).
//
// A `ResponsePlan` is the validated builder state: status, context,
// connection policy, the declared representation length, the retained
// fields and the running head length and field count. Every limit is checked
// before a field is retained or output is allocated.

// ASCII bytes this module compares against (constants are per module).
const SPACE: u8 = 32;
const DIGIT_0: u8 = 48;
const DIGIT_9: u8 = 57;
const UPPER_A: u8 = 65;
const UPPER_Z: u8 = 90;
const LOWER_A: u8 = 97;
const LOWER_Z: u8 = 122;
// 'a' - 'A': adding it lowercases an ASCII capital.
const ASCII_CASE_OFFSET: u8 = 32;

// The RFC 9110 §5.6.2 `tchar` bytes (ALPHA, DIGIT and !#$%&'*+-.^_`|~):
// bit `b` of LOW for bytes 0-63, bit `b - 64` of HIGH for 64-127.
const TCHAR_MASK_LOW: u64 = 288068722172624896;
const TCHAR_MASK_HIGH: u64 = 6341068274398134270;
// RFC 9110 §5.5 field-value bytes: VCHAR and SP (LOW) and 64-126 (HIGH);
// bytes 128-255 (obs-text) pass with `find_not_in`'s high flag.
const FIELD_VCHAR_MASK_LOW: u64 = 18446744069414584320;
const FIELD_VCHAR_MASK_HIGH: u64 = 9223372036854775807;

copy struct ResponseLimits {
    max_head_bytes: u64,
    max_headers: u64,
    max_body_bytes: u64,
    max_total_bytes: u64
}

copy enum ResponseContext {
    Ordinary,
    Head,
    Connect
}

copy enum ConnectionPolicy {
    KeepAlive,
    Close
}

copy enum ResponseError {
    UnsupportedStatus,
    UnsupportedConnect,
    UnsupportedUpgrade,
    UnsupportedTransferCoding,
    ReservedHeader,
    InvalidHeaderName,
    InvalidHeaderValue,
    BodyForbidden,
    LengthMismatch {
        expected: u64,
        actual: u64
    },
    LengthOverflow,
    HeadLimit,
    HeaderCountLimit,
    BodyLimit,
    TotalLimit,
    AllocationFailed
}

struct ResponsePlan {
    status: u64,
    head: bool,
    close: bool,
    representation_length: u64,
    limits: ResponseLimits,
    names: ChunkSeq[u8],
    name_ends: ChunkSeq[u64],
    values: ChunkSeq[u8],
    value_ends: ChunkSeq[u64],
    head_length: u64,
    header_count: u64
}

fn byte(in s: Slice[u8], i: u64) -> u8 {
    match s.try_get(i) {
        Option::Some(b) => b,
        Option::None => 0,
    }
}

fn is_alnum(b: u8) -> bool {
    (b >= DIGIT_0 && b <= DIGIT_9)
        || (b >= UPPER_A && b <= UPPER_Z)
        || (b >= LOWER_A && b <= LOWER_Z)
}

fn lower(b: u8) -> u8 {
    if b >= UPPER_A && b <= UPPER_Z {
        wrapping_add(b, ASCII_CASE_OFFSET)
    } else {
        b
    }
}

// The RFC 9110 `tchar` bytes (ALPHA, DIGIT and !#$%&'*+-.^_`|~) as two
// 64-bit masks. A mask test calls nothing and stays small enough to inline;
// a comparison chain does not. `rotate_right` is the total shift.
fn token(b: u8) -> bool {
    let i = widen_u64(b);
    let low = TCHAR_MASK_LOW;
    let high = TCHAR_MASK_HIGH;
    if i < 64 {
        (rotate_right(low, i) & 1) == 1
    } else if i < 128 {
        (rotate_right(high, wrapping_sub(i, 64)) & 1) == 1
    } else {
        false
    }
}

fn eq_fold(in s: Slice[u8], in lit: Str) -> bool {
    if s.len() == lit.len() {
        return s.eq_ignore_ascii_case(in lit.as_bytes());
    }
    if s.len() != lit.len() {
        return false;
    }
    for i in 0..lit.len() {
        let want = match lit.try_byte_at(i) {
            Option::Some(b) => b,
            Option::None => 0,
        };
        let have = match s.try_get(i) {
            Option::Some(b) => b,
            Option::None => 0,
        };
        if lower(have) != want {
            return false;
        }
    }
    true
}

// `a + b`, or `None` on overflow (`LengthOverflow`).
fn add(a: u64, b: u64) -> Option[u64] {
    let s = wrapping_add(a, b);
    if s < a {
        Option::None
    } else {
        Option::Some(s)
    }
}

// Status codes this module treats specially (RFC 9110 §15), and the final
// statuses a response may carry (1xx are rejected).
const NO_CONTENT: u64 = 204;
const RESET_CONTENT: u64 = 205;
const NOT_MODIFIED: u64 = 304;
const UPGRADE_REQUIRED: u64 = 426;
const MIN_STATUS: u64 = 200;
const MAX_STATUS: u64 = 599;
// Fixed bytes of the head: `HTTP/1.1 NNN ` and CRLF; `Content-Length: `
// and CRLF; `Connection: `, CRLF and the final empty line.
const STATUS_LINE_FIXED_LEN: u64 = 15;
const CONTENT_LENGTH_FIXED_LEN: u64 = 18;
const CONNECTION_FIXED_LEN: u64 = 16;

fn body_forbidden(status: u64) -> bool {
    status == NO_CONTENT || status == RESET_CONTENT || status == NOT_MODIFIED
}

fn carries_length(status: u64) -> bool {
    status != NO_CONTENT && status != NOT_MODIFIED
}

fn decimal_length(value: u64) -> u64 {
    let mut v = value;
    let mut n: u64 = 1;
    loop {
        if v < 10 {
            break;
        }
        v = v / 10;
        n = wrapping_add(n, 1);
    }
    n
}

fn policy_length(close: bool) -> u64 {
    if close {
        5
    } else {
        10
    }
}

fn push_text(inout out: ChunkSeq[u8], in text: Str) {
    out.extend(in text.as_bytes());
}

fn push_decimal(inout out: ChunkSeq[u8], value: u64) {
    let mut digits: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut rest = value;
    loop {
        digits.push(wrapping_u8(wrapping_add(rest % 10, widen_u64(DIGIT_0))));
        rest = rest / 10;
        if rest == 0 {
            break;
        }
    }
    let n = digits.len();
    for i in 0..n {
        match digits.try_get(wrapping_sub(wrapping_sub(n, 1), i)) {
            Option::Some(d) => out.push(d),
            Option::None => (),
        }
    }
}

// The fixed standard reason phrase, appended to `out`; unknown codes add
// nothing.
fn push_reason(inout out: ChunkSeq[u8], status: u64) {
    match status {
        200 => push_text(inout out, "OK"),
        201 => push_text(inout out, "Created"),
        202 => push_text(inout out, "Accepted"),
        203 => push_text(inout out, "Non-Authoritative Information"),
        204 => push_text(inout out, "No Content"),
        205 => push_text(inout out, "Reset Content"),
        206 => push_text(inout out, "Partial Content"),
        207 => push_text(inout out, "Multi-Status"),
        208 => push_text(inout out, "Already Reported"),
        226 => push_text(inout out, "IM Used"),
        300 => push_text(inout out, "Multiple Choices"),
        301 => push_text(inout out, "Moved Permanently"),
        302 => push_text(inout out, "Found"),
        303 => push_text(inout out, "See Other"),
        304 => push_text(inout out, "Not Modified"),
        305 => push_text(inout out, "Use Proxy"),
        307 => push_text(inout out, "Temporary Redirect"),
        308 => push_text(inout out, "Permanent Redirect"),
        400 => push_text(inout out, "Bad Request"),
        401 => push_text(inout out, "Unauthorized"),
        402 => push_text(inout out, "Payment Required"),
        403 => push_text(inout out, "Forbidden"),
        404 => push_text(inout out, "Not Found"),
        405 => push_text(inout out, "Method Not Allowed"),
        406 => push_text(inout out, "Not Acceptable"),
        407 => push_text(inout out, "Proxy Authentication Required"),
        408 => push_text(inout out, "Request Timeout"),
        409 => push_text(inout out, "Conflict"),
        410 => push_text(inout out, "Gone"),
        411 => push_text(inout out, "Length Required"),
        412 => push_text(inout out, "Precondition Failed"),
        413 => push_text(inout out, "Content Too Large"),
        414 => push_text(inout out, "URI Too Long"),
        415 => push_text(inout out, "Unsupported Media Type"),
        416 => push_text(inout out, "Range Not Satisfiable"),
        417 => push_text(inout out, "Expectation Failed"),
        421 => push_text(inout out, "Misdirected Request"),
        422 => push_text(inout out, "Unprocessable Content"),
        423 => push_text(inout out, "Locked"),
        424 => push_text(inout out, "Failed Dependency"),
        425 => push_text(inout out, "Too Early"),
        428 => push_text(inout out, "Precondition Required"),
        429 => push_text(inout out, "Too Many Requests"),
        431 => push_text(inout out, "Request Header Fields Too Large"),
        451 => push_text(inout out, "Unavailable For Legal Reasons"),
        500 => push_text(inout out, "Internal Server Error"),
        501 => push_text(inout out, "Not Implemented"),
        502 => push_text(inout out, "Bad Gateway"),
        503 => push_text(inout out, "Service Unavailable"),
        504 => push_text(inout out, "Gateway Timeout"),
        505 => push_text(inout out, "HTTP Version Not Supported"),
        506 => push_text(inout out, "Variant Also Negotiates"),
        507 => push_text(inout out, "Insufficient Storage"),
        508 => push_text(inout out, "Loop Detected"),
        510 => push_text(inout out, "Not Extended"),
        511 => push_text(inout out, "Network Authentication Required"),
        _ => (),
    }
}

fn reason_length(status: u64) -> u64 {
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    push_reason(inout out, status);
    out.len()
}

fn wire_body_length(head: bool, representation_length: u64) -> u64 {
    if head {
        0
    } else {
        representation_length
    }
}

fn check_sizes(
    limits: ResponseLimits,
    head: bool,
    representation_length: u64,
    head_length: u64,
    header_count: u64
) -> Option[ResponseError] {
    if head_length > limits.max_head_bytes {
        return Option::Some(ResponseError::HeadLimit);
    }
    if header_count > limits.max_headers {
        return Option::Some(ResponseError::HeaderCountLimit);
    }
    match add(head_length, wire_body_length(head, representation_length)) {
        Option::None => Option::Some(ResponseError::LengthOverflow),
        Option::Some(total) => if total > limits.max_total_bytes {
            Option::Some(ResponseError::TotalLimit)
        } else {
            Option::None
        },
    }
}

fn plan_head_length(status: u64, close: bool, representation_length: u64) -> u64 {
    // Status line, the Content-Length field when carried, the Connection
    // field and the final empty line. These stay far below 2^64 because the
    // representation length is bounded by the body limit first.
    let mut n = wrapping_add(STATUS_LINE_FIXED_LEN, reason_length(status));
    if carries_length(status) {
        n = wrapping_add(
            n,
            wrapping_add(CONTENT_LENGTH_FIXED_LEN, decimal_length(representation_length))
        );
    }
    wrapping_add(n, wrapping_add(CONNECTION_FIXED_LEN, policy_length(close)))
}

// `ResponseBuilder::new`.
pub fn response_plan_new(
    status: u64,
    context: ResponseContext,
    connection: ConnectionPolicy,
    representation_length: u64,
    limits: ResponseLimits
) -> ResponsePlan eff [Fail[ResponseError]] {
    if status < MIN_STATUS || status > MAX_STATUS {
        Fail::raise(ResponseError::UnsupportedStatus);
    }
    // A valid 426 requires Upgrade, which this fixed-length subset cannot
    // produce.
    if status == UPGRADE_REQUIRED {
        Fail::raise(ResponseError::UnsupportedUpgrade);
    }
    let head = match context {
        ResponseContext::Ordinary => false,
        ResponseContext::Head => true,
        ResponseContext::Connect => Fail::raise(ResponseError::UnsupportedConnect),
    };
    if body_forbidden(status) && representation_length != 0 {
        Fail::raise(ResponseError::BodyForbidden);
    }
    if representation_length > limits.max_body_bytes {
        Fail::raise(ResponseError::BodyLimit);
    }
    let close = match connection {
        ConnectionPolicy::KeepAlive => false,
        ConnectionPolicy::Close => true,
    };
    let head_length = plan_head_length(status, close, representation_length);
    let header_count: u64 = if carries_length(status) {
        2
    } else {
        1
    };
    match check_sizes(limits, head, representation_length, head_length, header_count) {
        Option::Some(e) => Fail::raise(e),
        Option::None => (),
    }
    ResponsePlan {
        status: status,
        head: head,
        close: close,
        representation_length: representation_length,
        limits: limits,
        names: ChunkSeq::new[u8](),
        name_ends: ChunkSeq::new[u64](),
        values: ChunkSeq::new[u8](),
        value_ends: ChunkSeq::new[u64](),
        head_length: head_length,
        header_count: header_count
    }
}

// `ResponseBuilder::header`: validate and retain one ordinary field.
pub fn response_plan_header(inout p: ResponsePlan, in name: Slice[u8], in value: Slice[u8])
    -> Option[ResponseError] {
    if name.len() == 0 {
        return Option::Some(ResponseError::InvalidHeaderName);
    }
    match name.find_not_in(TCHAR_MASK_LOW, TCHAR_MASK_HIGH, false) {
        Option::Some(i) => {
            return Option::Some(ResponseError::InvalidHeaderName);
        },
        Option::None => (),
    }
    match value.find_not_in(FIELD_VCHAR_MASK_LOW, FIELD_VCHAR_MASK_HIGH, true) {
        Option::Some(i) => {
            return Option::Some(ResponseError::InvalidHeaderValue);
        },
        Option::None => (),
    }
    if (name.len() == 17 && eq_fold(in name, "transfer-encoding"))
        || (name.len() == 7 && eq_fold(in name, "trailer"))
        || (name.len() == 2 && eq_fold(in name, "te")) {
        return Option::Some(ResponseError::UnsupportedTransferCoding);
    }
    if name.len() == 7 && eq_fold(in name, "upgrade") {
        return Option::Some(ResponseError::UnsupportedUpgrade);
    }
    if (name.len() == 14 && eq_fold(in name, "content-length"))
        || (name.len() == 10 && eq_fold(in name, "connection"))
        || (name.len() == 10 && eq_fold(in name, "keep-alive"))
        || (name.len() == 16 && eq_fold(in name, "proxy-connection")) {
        return Option::Some(ResponseError::ReservedHeader);
    }
    let field = match add(name.len(), value.len()) {
        Option::Some(n) => add(n, 4),
        Option::None => Option::None,
    };
    let head_length = match field {
        Option::Some(f) => add(p.head_length, f),
        Option::None => Option::None,
    };
    let head_length = match head_length {
        Option::Some(n) => n,
        Option::None => {
            return Option::Some(ResponseError::LengthOverflow);
        },
    };
    let header_count = wrapping_add(p.header_count, 1);
    match check_sizes(p.limits, p.head, p.representation_length, head_length, header_count) {
        Option::Some(e) => {
            return Option::Some(e);
        },
        Option::None => (),
    }
    p.names.extend_ascii_lowercase(in name);
    p.name_ends.push(p.names.len());
    p.values.extend(in value);
    p.value_ends.push(p.values.len());
    p.head_length = head_length;
    p.header_count = header_count;
    Option::None
}

fn at(in s: ChunkSeq[u64], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

// `ResponseBuilder::finish`: the exact wire bytes. No partial output on an
// error.
pub fn response_plan_finish(in p: ResponsePlan, in body: Slice[u8])
    -> ChunkSeq[u8] eff [Fail[ResponseError]] {
    if body_forbidden(p.status) && body.len() != 0 {
        Fail::raise(ResponseError::BodyForbidden);
    }
    if body.len() != p.representation_length {
        Fail::raise(
            ResponseError::LengthMismatch {
                expected: p.representation_length,
                actual: body.len()
            }
        );
    }
    match check_sizes(p.limits, p.head, p.representation_length, p.head_length, p.header_count) {
        Option::Some(e) => Fail::raise(e),
        Option::None => (),
    }
    let body_length = wire_body_length(p.head, p.representation_length);
    let mut out: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](
        wrapping_add(p.head_length, body_length)
    );
    push_text(inout out, "HTTP/1.1 ");
    push_decimal(inout out, p.status);
    out.push(SPACE);
    push_reason(inout out, p.status);
    push_text(inout out, "\r\n");
    let mut name_at: u64 = 0;
    let mut value_at: u64 = 0;
    for f in 0..p.name_ends.len() {
        let name_end = at(in p.name_ends, f);
        let value_end = at(in p.value_ends, f);
        out.extend(in p.names[name_at..name_end]);
        push_text(inout out, ": ");
        out.extend(in p.values[value_at..value_end]);
        push_text(inout out, "\r\n");
        name_at = name_end;
        value_at = value_end;
    }
    if carries_length(p.status) {
        push_text(inout out, "Content-Length: ");
        push_decimal(inout out, p.representation_length);
        push_text(inout out, "\r\n");
    }
    push_text(inout out, "Connection: ");
    if p.close {
        push_text(inout out, "close");
    } else {
        push_text(inout out, "keep-alive");
    }
    push_text(inout out, "\r\n\r\n");
    if !p.head {
        out.extend(in body);
    }
    out
}
