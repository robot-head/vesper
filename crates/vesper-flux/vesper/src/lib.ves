// CDC batches (cdc.rs `Executor::ingest_cdc`, module cdc)

// Every way a CDC batch fails after the wrapper's empty and size checks.
pub copy enum CdcErr {
    Work,
    Rows,
    Overflow,
    Records,
    TruncatedHeader,
    Partition,
    Schema,
    Flags,
    Weight,
    Offset,
    TruncatedRow
}

// Decodes a batch into the accumulator (see cdc.ves for the arguments).
pub fn cdc_ingest(
    inout a: ZAcc,
    in bytes: Slice[u8],
    in parts: Slice[u64],
    in binds: Slice[u64],
    inout next: ChunkSeq[u64],
    max_records: u64,
    inout budget: u64,
    inout stats: ChunkSeq[i64]
) eff [Fail[CdcErr]] {
    cdc_decode(
        inout a,
        in bytes,
        in parts,
        in binds,
        inout next,
        max_records,
        inout budget,
        inout stats
    );
}

