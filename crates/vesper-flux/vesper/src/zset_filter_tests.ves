// Filter keeps the order and signed weights of an already canonical batch.
test {
    use self::{ZErr, zs_filter, zset};

    fn fixture() -> ChunkSeq[i64] {
        let mut rows = ChunkSeq::new[i64]();
        for cell in [2, 13, 3, -4, 5, 7] {
            rows.push(cell);
        }
        rows
    }

    // @case equality(0, 3, 5, 1, 3, -4, 0)
    // @case threshold(1, 3, 8, 2, 3, -4, 1)
    // @case no_matches(0, 9, 3, 0, 0, 0, 0)
    fn filter_preserves_signed_rows(
        kind: u64,
        key: i64,
        available: u64,
        kept: u64,
        first: i64,
        weight: i64,
        remaining: u64
    ) -> bool {
        let input = fixture();
        let mut budget = available;
        let result: Result[ChunkSeq[i64], ZErr] = handle Fail[ZErr] in {
            zs_filter(1, in input.as_slice(), 3, kind, 0, key, 1, 2, inout budget)
        } with {
            return value => Result::Ok(value),
            raise(error, _) => Result::Err(error),
        };
        match result {
            Result::Ok(value) => budget == remaining
                && value.len() == wrapping_mul(kept, 2)
                && (kept == 0
                    || (value.try_get(0) == Option::Some(first)
                        && value.try_get(1) == Option::Some(weight)))
                && (kept != 2
                    || (value.try_get(2) == Option::Some(5)
                        && value.try_get(3) == Option::Some(7))),
            Result::Err(_) => false,
        }
    }

    // @case width_before_work(0, 0, 0, ZErr::Columns, 0, 0)
    // @case inspect_charge_before_predicate(1, 2, 0, ZErr::Work, 0, 0)
    // @case emit_work_before_rows(1, 0, 2, ZErr::Work, 1, 1)
    // @case row_error_keeps_prior_charges(1, 1, 7, ZErr::Rows, 1, 2)
    fn filter_failure_priorities(
        max_columns: u64,
        max_rows: u64,
        available: u64,
        want: ZErr,
        remaining: u64,
        calls: u64
    ) -> bool {
        let input = fixture();
        let cells = input.as_slice();
        let mut budget = available;
        let mut seen: u64 = 0;
        let result: Result[ChunkSeq[i64], ZErr] = handle Fail[ZErr] in {
            zset{
                keep from in cells,
                width 1;
                rows 3 at at when {
                    seen = wrapping_add(seen, 1);
                    cells.try_get(at) != Option::None
                };
                limits max_columns,
                max_rows;
                inout budget
            }
        } with {
            return value => Result::Ok(value),
            raise(error, _) => Result::Err(error),
        };
        match result {
            Result::Err(error) => error == want && budget == remaining && seen == calls,
            Result::Ok(_) => false,
        }
    }

    // @case weight_only_row()
    fn keeps_a_row_without_columns() -> bool {
        let mut input = ChunkSeq::new[i64]();
        input.push(-4);
        let mut budget: u64 = 2;
        let result: Result[ChunkSeq[i64], ZErr] = handle Fail[ZErr] in {
            zs_filter(0, in input.as_slice(), 1, 1, 0, -4, 0, 1, inout budget)
        } with {
            return value => Result::Ok(value),
            raise(error, _) => Result::Err(error),
        };
        match result {
            Result::Ok(value) => budget == 0
                && value.len() == 1
                && value.try_get(0) == Option::Some(-4),
            Result::Err(_) => false,
        }
    }

    // @case empty_row_range()
    fn does_not_spend_or_test_when_empty() -> bool {
        let input = ChunkSeq::new[i64]();
        let cells = input.as_slice();
        let mut budget: u64 = 0;
        let mut calls: u64 = 0;
        let result: Result[ChunkSeq[i64], ZErr] = handle Fail[ZErr] in {
            zset{
                keep from in cells,
                width 0;
                rows 0 at row_offset when {
                    calls = wrapping_add(calls, 1);
                    row_offset == 0
                };
                limits 0,
                0;
                inout budget
            }
        } with {
            return value => Result::Ok(value),
            raise(error, _) => Result::Err(error),
        };
        match result {
            Result::Ok(value) => value.len() == 0 && calls == 0 && budget == 0,
            Result::Err(_) => false,
        }
    }
}
