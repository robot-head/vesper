// The same map kernel used by the Flux port, with the new source notation.
test {
    use self::{ZErr, zs_map, zset};

    fn stats(current: ChunkSeq[i64], budget: u64) -> bool {
        current.len() == 4
            && current.try_get(0) == Option::Some(3)
            && current.try_get(1) == Option::Some(2)
            && current.try_get(2) == Option::Some(7)
            && current.try_get(3) == Option::Some(-4)
            && budget == 1
    }

    // @case mapped_signed_rows()
    fn maps_sorts_and_cancels() -> bool {
        let mut cells = ChunkSeq::new[i64]();
        for x in [5, 1, 3, 2, 5, -1, 7, -4] {
            cells.push(x);
        }
        let mut fields = ChunkSeq::new[i64]();
        fields.push(0);
        fields.push(0);
        let mut budget: u64 = 13;
        let result: Result[ChunkSeq[i64], ZErr] = handle Fail[ZErr] in {
            zs_map(1, in cells.as_slice(), 4, in fields.as_slice(), 1, 1, 3, inout budget)
        } with {
            return value => Result::Ok(value),
            raise(error, _) => Result::Err(error),
        };
        match result {
            Result::Ok(value) => stats(value, budget),
            Result::Err(_) => false,
        }
    }

    // @case merged_weights(4, -2, false)
    // @case weight_overflow(9223372036854775807, 1, true)
    fn constant_projection_consolidates(first: i64, second: i64, overflow: bool) -> bool {
        let mut cells = ChunkSeq::new[i64]();
        cells.push(2);
        cells.push(first);
        cells.push(9);
        cells.push(second);
        let mut fields = ChunkSeq::new[i64]();
        fields.push(1);
        fields.push(17);
        let mut budget: u64 = 6;
        let result: Result[ChunkSeq[i64], ZErr] = handle Fail[ZErr] in {
            zs_map(1, in cells.as_slice(), 2, in fields.as_slice(), 1, 1, 1, inout budget)
        } with {
            return value => Result::Ok(value),
            raise(error, _) => Result::Err(error),
        };
        match result {
            Result::Ok(value) => !overflow
                && budget == 0
                && value.len() == 2
                && value.try_get(0) == Option::Some(17)
                && value.try_get(1) == Option::Some(2),
            Result::Err(error) => overflow && error == ZErr::Overflow && budget == 6,
        }
    }

    // @case order()
    fn setup_once_and_prepare_once_per_row() -> bool {
        let mut seen: u64 = 0;
        let mut budget: u64 = 10;
        let result: Result[ChunkSeq[i64], ZErr] = handle Fail[ZErr] in {
            zset{
                {
                    wrapping_i64(wrapping_add(first, column))
                } => {
                    1
                }
                | row in 0..2 with first = {
                    seen = wrapping_add(seen, 1);
                    wrapping_mul(row, 10)
                },
                column in 0..2;
                limits 2,
                2;
                inout budget
            }
        } with {
            return value => Result::Ok(value),
            raise(error, _) => Result::Err(error),
        };
        match result {
            Result::Ok(value) => {
                seen == 2
                    && budget == 0
                    && value.len() == 6
                    && value.try_get(0) == Option::Some(0)
                    && value.try_get(1) == Option::Some(1)
                    && value.try_get(2) == Option::Some(1)
                    && value.try_get(3) == Option::Some(10)
                    && value.try_get(4) == Option::Some(11)
                    && value.try_get(5) == Option::Some(1)
            },
            Result::Err(_) => false,
        }
    }

    // @case invalid_width(0, 1, 0, ZErr::Columns)
    // @case work_before_row_limit(1, 0, 0, ZErr::Work)
    // @case row_limit_with_work(1, 0, 3, ZErr::Rows)
    fn keeps_error_precedence(max_columns: u64, max_rows: u64, available: u64, want: ZErr) -> bool {
        let mut budget = available;
        let result: Result[ChunkSeq[i64], ZErr] = handle Fail[ZErr] in {
            zset{
                {
                    wrapping_i64(first)
                } => {
                    1
                }
                | row in 0..1 with first = {
                    row
                },
                column in 0..1;
                limits max_columns,
                max_rows;
                inout budget
            }
        } with {
            return value => Result::Ok(value),
            raise(error, _) => Result::Err(error),
        };
        match result {
            Result::Err(error) => error == want && budget == available,
            Result::Ok(_) => false,
        }
    }
}
