load("//tools/bazel:defs.bzl", "vesper_crate")

vesper_crate(
    # tests/lean_model.rs kernel-checks lean/FluxDbsp.lean; Lean rejects
    # symlinked runfiles outside --root, so it runs in a regular copy.
    copy_test_cwd = ["test/lean_model"],
    extra_test_data = ["//:lean"],
    # Fault injection at every scheduler step of several protocols.
    # tests/kafka.rs needs a broker (VESPER_KAFKA_HOME); without one it
    # skips, and .github/workflows/flux-kafka.yml runs it against Kafka.
    test_timeouts = {
        "test/live_rescale": "long",
        "test/recovery": "long",
    },
)
