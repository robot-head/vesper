// ---------------------------------------------------------------------------
// The timing wheel.
//
// Entry `i` is the eight words at `ix(i, 0)` of `e`: deadline, tick,
// sequence, generation, prev, next, list and a pad word, so one entry is
// one cache line, as in the Rust build's `Vec<Entry>`. List `l` is the two
// words at `lx(l, 0)` of `l`: head and tail. Lists `0 .. levels * slots`
// are the wheel slots, then the overflow list, then the sorted ready list.
// See src/reference/wheel.rs for the model.

// Word `field` of entry `index` (fields: 0 deadline, 1 tick, 2 sequence,
// 3 generation, 4 prev, 5 next, 6 list).
fn ix(index: u64, field: u64) -> u64 {
    wrapping_add(wrapping_mul(index, 8), field)
}

// Word `end` of list `list` (0 head, 1 tail).
fn lx(list: u64, end: u64) -> u64 {
    wrapping_add(wrapping_mul(list, 2), end)
}

struct WheelCore {
    e: ChunkSeq[u64],
    l: ChunkSeq[u64],
    occupied: ChunkSeq[u64],
    // `level_of_bit[b] = min(b / slot_bits, levels)`: the level of a tick
    // distance whose highest set bit is `b` (`levels` is overflow; see
    // `place`).
    level_of_bit: ChunkSeq[u64],
    tick_ns: u64,
    slot_bits: u64,
    levels: u64,
    slots: u64,
    capacity: u64,
    free_head: u64,
    len: u64,
    cursor: u64,
    now_ns: u64,
    next_seq: u64,
    overflow_min_tick: u64
}

fn config_error(config: WheelConfig) -> Option[WheelConfigError] {
    if config.tick_ns == 0 {
        return Option::Some(WheelConfigError::ZeroTick);
    }
    if config.slot_bits < 1 || config.slot_bits > MAX_SLOT_BITS {
        return Option::Some(WheelConfigError::SlotBits(config.slot_bits));
    }
    let span = wrapping_mul(widen_u64(config.levels), widen_u64(config.slot_bits));
    if config.levels == 0 || span > MAX_SPAN_BITS {
        return Option::Some(WheelConfigError::Levels(config.levels));
    }
    if config.capacity == 0 || config.capacity > max_capacity() {
        return Option::Some(WheelConfigError::Capacity(config.capacity));
    }
    if config.start_ns > max_time_ns() {
        return Option::Some(WheelConfigError::StartOutOfRange);
    }
    Option::None
}

fn build_wheel(config: WheelConfig) -> WheelCore {
    let slot_bits = widen_u64(config.slot_bits);
    let levels = widen_u64(config.levels);
    let slots = shl(1, slot_bits);
    let cap = widen_u64(config.capacity);
    // cap <= max_capacity() (a u32), so cap * 8 cannot wrap.
    let mut e: ChunkSeq[u64] = filled(wrapping_mul(cap, 8), 0);
    for i in 0..cap {
        let after = wrapping_add(i, 1);
        e.try_set(ix(i, 4), nil());
        if after < cap {
            e.try_set(ix(i, 5), after);
        } else {
            e.try_set(ix(i, 5), nil());
        }
        e.try_set(ix(i, 6), nil());
    }
    let lists = wrapping_add(wrapping_mul(levels, slots), 2);
    let mut level_of_bit: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](64);
    for b in 0..64 {
        level_of_bit.push(min(div(b, slot_bits), levels));
    }
    WheelCore {
        e: e,
        l: filled(wrapping_mul(lists, 2), nil()),
        occupied: filled(levels, 0),
        level_of_bit: level_of_bit,
        tick_ns: config.tick_ns,
        slot_bits: slot_bits,
        levels: levels,
        slots: slots,
        capacity: cap,
        free_head: 0,
        len: 0,
        cursor: div(config.start_ns, config.tick_ns),
        now_ns: config.start_ns,
        next_seq: 0,
        overflow_min_tick: u64_max()
    }
}

impl WheelCore {
    fn overflow_list(in self) -> u64 {
        wrapping_mul(self.levels, self.slots)
    }

    fn ready_list(in self) -> u64 {
        wrapping_add(wrapping_mul(self.levels, self.slots), 1)
    }

    fn slot_mask(in self) -> u64 {
        wrapping_sub(self.slots, 1)
    }

    fn deadline_of(in self, index: u64) -> u64 {
        at(in self.e, ix(index, 0))
    }

    fn next_of(in self, index: u64) -> u64 {
        at(in self.e, ix(index, 5))
    }

    fn prev_of(in self, index: u64) -> u64 {
        at(in self.e, ix(index, 4))
    }

    fn head_of(in self, list: u64) -> u64 {
        at(in self.l, lx(list, 0))
    }

    fn tail_of(in self, list: u64) -> u64 {
        at(in self.l, lx(list, 1))
    }

    // `(deadline, sequence)` of `a` is `<=` that of `b`.
    fn key_le(in self, a: u64, b: u64) -> bool {
        let da = self.deadline_of(a);
        let db = self.deadline_of(b);
        if da != db {
            da < db
        } else {
            at(in self.e, ix(a, 2)) <= at(in self.e, ix(b, 2))
        }
    }

    // Index of the lowest set bit of a non-zero `x`.
    fn low_bit(in self, x: u64) -> u64 {
        widen_u64(trailing_zeros_u64(x))
    }

    fn clear_occupied(inout self, list: u64) {
        if list < self.overflow_list() {
            let level = div(list, self.slots);
            let slot = list & self.slot_mask();
            let bits = at(in self.occupied, level);
            self.occupied.try_set(level, bits & ~shl(1, slot));
        }
    }
}

// The wheel's entry operations.
impl WheelCore {
    // The entry for a handle, or why the handle names none.
    fn check(in self, index: u64, generation: u64) -> Option[HandleError] {
        if index >= self.capacity {
            return Option::Some(HandleError::Foreign);
        }
        if at(in self.e, ix(index, 6)) == nil() || at(in self.e, ix(index, 3)) != generation {
            return Option::Some(HandleError::Stale);
        }
        Option::None
    }

    // Store a new entry; `(index, generation)` names it.
    fn insert(inout self, deadline_ns: u64) -> Result[(u64, u64), InsertErrorKind] {
        if deadline_ns > max_time_ns() {
            return Result::Err(InsertErrorKind::DeadlineOutOfRange);
        }
        let index = self.free_head;
        if index == nil() {
            return Result::Err(InsertErrorKind::Full);
        }
        let seq = self.next_seq;
        // A u64 sequence cannot be exhausted by inserts in practice.
        self.next_seq = wrapping_add(seq, 1);
        let tick = div(deadline_ns, self.tick_ns);
        self.free_head = self.next_of(index);
        self.e.try_set(ix(index, 0), deadline_ns);
        self.e.try_set(ix(index, 1), tick);
        self.e.try_set(ix(index, 2), seq);
        let generation = at(in self.e, ix(index, 3));
        self.len = wrapping_add(self.len, 1);
        self.place(index);
        Result::Ok((index, generation))
    }

    fn release(inout self, index: u64) {
        let generation = at(in self.e, ix(index, 3));
        self.e.try_set(ix(index, 3), wrapping_add(generation, 1));
        self.e.try_set(ix(index, 6), nil());
        self.e.try_set(ix(index, 4), nil());
        self.e.try_set(ix(index, 5), self.free_head);
        self.free_head = index;
        self.len = wrapping_sub(self.len, 1);
    }

    // Move the clock to `now_ns`, opening every tick with work up to it.
    fn advance(inout self, now_ns: u64) -> Option[AdvanceError] {
        if now_ns < self.now_ns {
            return Option::Some(AdvanceError::Backwards {
                now_ns: self.now_ns,
                requested_ns: now_ns
            });
        }
        if now_ns > max_time_ns() {
            return Option::Some(AdvanceError::OutOfRange);
        }
        self.now_ns = now_ns;
        let target = div(now_ns, self.tick_ns);
        loop {
            if self.cursor > target {
                break;
            }
            match self.next_work_tick() {
                Option::Some(tick) => {
                    if tick <= target {
                        self.cursor = tick;
                        self.open_tick(tick);
                        // tick <= target <= MAX_TIME_NS: no overflow.
                        self.cursor = wrapping_add(tick, 1);
                    } else {
                        self.cursor = wrapping_add(target, 1);
                    }
                },
                Option::None => {
                    self.cursor = wrapping_add(target, 1);
                },
            }
        }
        Option::None
    }

    // The earliest due entry, as `(deadline, index)`, released.
    fn pop_due(inout self) -> Option[(u64, u64)] {
        let head = self.head_of(self.ready_list());
        if head == nil() {
            return Option::None;
        }
        let deadline = self.deadline_of(head);
        if deadline > self.now_ns {
            return Option::None;
        }
        self.unlink(head);
        self.release(head);
        Option::Some((deadline, head))
    }

    fn next_wake_hint(in self) -> Option[u64] {
        let ready = self.head_of(self.ready_list());
        if ready != nil() {
            return Option::Some(self.deadline_of(ready));
        }
        match self.next_work_tick() {
            Option::Some(tick) => {
                let start_ns = saturating_mul(tick, self.tick_ns);
                Option::Some(max(start_ns, self.now_ns))
            },
            Option::None => Option::None,
        }
    }

    // Remove every entry in slab order, as flattened `(deadline, index)`
    // pairs.
    fn drain(inout self) -> ChunkSeq[u64] {
        let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
        for index in 0..self.capacity {
            if at(in self.e, ix(index, 6)) != nil() {
                let deadline = self.deadline_of(index);
                self.unlink(index);
                self.release(index);
                out.push(deadline);
                out.push(index);
            }
        }
        out
    }
}
