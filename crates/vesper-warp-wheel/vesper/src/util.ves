// ---------------------------------------------------------------------------
// Constants and total arithmetic helpers.

// The list terminator and the "free entry" marker (u32::MAX in the Rust
// build, where entry links are u32).
fn nil() -> u64 {
    4294967295
}

// The same limits as `wheel.rs`.
const MAX_SLOT_BITS: u8 = 6;
const MAX_SPAN_BITS: u64 = 63;

fn u64_max() -> u64 {
    18446744073709551615
}

// MAX_TIME_NS: u64::MAX is reserved so the cursor is always representable.
fn max_time_ns() -> u64 {
    18446744073709551614
}

// MAX_CAPACITY = u32::MAX - 1.
fn max_capacity() -> u32 {
    4294967294
}

// MAX_PACKET_NUMBER = 2^62.
fn max_packet_number() -> u64 {
    4611686018427387904
}

fn at(in s: ChunkSeq[u64], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

fn min(a: u64, b: u64) -> u64 {
    if a < b {
        a
    } else {
        b
    }
}

fn max(a: u64, b: u64) -> u64 {
    if a > b {
        a
    } else {
        b
    }
}

// `x << s` and `x >> s`, 0 for `s >= 64` (every caller's amount is below
// 64). `x << s` may raise `Fail[ArithOverflow]`, and a handler would keep
// these out of the inliner, so the in-range case uses the total
// `wrapping_shl_u64`/`wrapping_shr_u64`.
fn shl(x: u64, s: u64) -> u64 {
    if s < 64 {
        wrapping_shl_u64(x, wrapping_u32(s))
    } else {
        0
    }
}

fn shr(x: u64, s: u64) -> u64 {
    if s < 64 {
        wrapping_shr_u64(x, wrapping_u32(s))
    } else {
        0
    }
}

// `a / b` for `b > 0` (every divisor is a validated tick width or slot
// width), and 0 for `b == 0`.
// The `b != 0` test lets the checker prove the division total, so there is
// no handler and the inliner takes it.
fn div(a: u64, b: u64) -> u64 {
    if b != 0 {
        a / b
    } else {
        0
    }
}

fn saturating_add(a: u64, b: u64) -> u64 {
    let s = wrapping_add(a, b);
    if s < a {
        u64_max()
    } else {
        s
    }
}

fn saturating_mul(a: u64, b: u64) -> u64 {
    if a == 0 || b == 0 {
        return 0;
    }
    if a > div(u64_max(), b) {
        u64_max()
    } else {
        wrapping_mul(a, b)
    }
}

// A sequence of `n` copies of `v`, allocated once.
fn filled(n: u64, v: u64) -> ChunkSeq[u64] {
    let mut s: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](n);
    for i in 0..n {
        s.push(v);
    }
    s
}
