// The wheel's list and cascade operations (the second half of
// `impl WheelCore`; see wheel.ves).

impl WheelCore {
    // Place a detached entry relative to the cursor.
    fn place(inout self, index: u64) {
        let tick = at(in self.e, ix(index, 1));
        if tick < self.cursor {
            self.insert_ready_sorted(index);
            return;
        }
        let diff = tick ^ self.cursor;
        // The level is `(63 - leading_zeros(diff)) / slot_bits` (0 for
        // `diff == 0`), or `levels` (overflow) past the last level, read
        // from the precomputed table. `diff | 1` has the same highest bit
        // for a non-zero `diff`, and bit 0 (level 0) for zero.
        let top = wrapping_sub(63, widen_u64(leading_zeros_u64(diff | 1)));
        let level = at(in self.level_of_bit, top);
        // One `push_back` call site, so the inliner takes it.
        let list = if level >= self.levels {
            self.overflow_min_tick = min(self.overflow_min_tick, tick);
            self.overflow_list()
        } else {
            // level * slot_bits < levels * slot_bits <= 63, and
            // slot < slots <= 2^MAX_SLOT_BITS <= 64.
            let low = wrapping_u32(wrapping_mul(level, self.slot_bits));
            let slot = wrapping_shr_u64(tick, low) & self.slot_mask();
            let bits = at(in self.occupied, level);
            self.occupied.try_set(level, bits | wrapping_shl_u64(1, wrapping_u32(slot)));
            wrapping_add(wrapping_mul(level, self.slots), slot)
        };
        self.push_back(list, index);
    }

    fn push_back(inout self, list: u64, index: u64) {
        let tail = self.tail_of(list);
        self.e.try_set(ix(index, 4), tail);
        self.e.try_set(ix(index, 5), nil());
        self.e.try_set(ix(index, 6), list);
        if tail == nil() {
            self.l.try_set(lx(list, 0), index);
        } else {
            self.e.try_set(ix(tail, 5), index);
        }
        self.l.try_set(lx(list, 1), index);
    }

    fn unlink(inout self, index: u64) {
        let prev = self.prev_of(index);
        let next = self.next_of(index);
        let list = at(in self.e, ix(index, 6));
        if prev == nil() {
            self.l.try_set(lx(list, 0), next);
        } else {
            self.e.try_set(ix(prev, 5), next);
        }
        if next == nil() {
            self.l.try_set(lx(list, 1), prev);
        } else {
            self.e.try_set(ix(next, 4), prev);
        }
        if self.head_of(list) == nil() {
            if list < self.overflow_list() {
                self.clear_occupied(list);
            } else if list == self.overflow_list() {
                self.overflow_min_tick = u64_max();
            }
        }
        self.e.try_set(ix(index, 4), nil());
        self.e.try_set(ix(index, 5), nil());
    }

    // Detach a whole list, returning its head (entries keep `next` links).
    fn take_list(inout self, list: u64) -> u64 {
        let head = self.head_of(list);
        self.l.try_set(lx(list, 0), nil());
        self.l.try_set(lx(list, 1), nil());
        self.clear_occupied(list);
        head
    }

    // Insert into the sorted ready list, scanning from the tail. The new
    // entry carries the newest sequence number, so it goes after every
    // entry with a deadline `<=` its own.
    fn insert_ready_sorted(inout self, index: u64) {
        let list = self.ready_list();
        let deadline = self.deadline_of(index);
        let mut after = self.tail_of(list);
        loop {
            if after == nil() || self.deadline_of(after) <= deadline {
                break;
            }
            after = self.prev_of(after);
        }
        let next = if after == nil() {
            self.head_of(list)
        } else {
            self.next_of(after)
        };
        self.e.try_set(ix(index, 4), after);
        self.e.try_set(ix(index, 5), next);
        self.e.try_set(ix(index, 6), list);
        if after == nil() {
            self.l.try_set(lx(list, 0), index);
        } else {
            self.e.try_set(ix(after, 5), index);
        }
        if next == nil() {
            self.l.try_set(lx(list, 1), index);
        } else {
            self.e.try_set(ix(next, 4), index);
        }
    }

    // Smallest tick `>= cursor` at which a cascade, overflow re-placement
    // or level-0 opening is needed.
    fn next_work_tick(in self) -> Option[u64] {
        let c = self.cursor;
        let mut best = u64_max();
        let mut found = false;
        for level in 0..self.levels {
            let bitmap = at(in self.occupied, level);
            if bitmap != 0 {
                let low = wrapping_mul(level, self.slot_bits);
                // rotation <= 63 by the configuration check.
                let rotation = wrapping_add(low, self.slot_bits);
                let position = shr_in(c, low) & self.slot_mask();
                let base = shl_in(shr_in(c, rotation), rotation);
                let ahead = bitmap & shl_in(u64_max(), position);
                if ahead != 0 {
                    let slot = self.low_bit(ahead);
                    let t = max(wrapping_add(base, shl_in(slot, low)), c);
                    if !found || t < best {
                        best = t;
                        found = true;
                    }
                } else {
                    // Unreachable under the placement invariant (occupied
                    // slots are never behind the cursor); handled
                    // conservatively, as the Rust build does.
                    let slot = self.low_bit(bitmap);
                    let block = wrapping_add(base, shl_in(1, rotation));
                    if block >= base {
                        let t = wrapping_add(block, shl_in(slot, low));
                        if t >= block {
                            if !found || t < best {
                                best = t;
                                found = true;
                            }
                        }
                    }
                }
            }
        }
        if self.head_of(self.overflow_list()) != nil() {
            let span = wrapping_mul(self.levels, self.slot_bits);
            let block = shl_in(shr_in(self.overflow_min_tick, span), span);
            let t = max(block, c);
            if !found || t < best {
                best = t;
                found = true;
            }
        }
        if found {
            Option::Some(best)
        } else {
            Option::None
        }
    }

    // Re-place every entry of a detached chain.
    fn replace_chain(inout self, head: u64) {
        let mut cur = head;
        loop {
            if cur == nil() {
                break;
            }
            let next = self.next_of(cur);
            self.place(cur);
            cur = next;
        }
    }

    // Open tick `c` (== cursor): re-place overflow if its block is reached,
    // cascade every level whose boundary `c` is, then move the level-0 slot
    // to the ready list in sorted order.
    fn open_tick(inout self, c: u64) {
        let overflow = self.overflow_list();
        if self.head_of(overflow) != nil() {
            let span = wrapping_mul(self.levels, self.slot_bits);
            if c >= shl_in(shr_in(self.overflow_min_tick, span), span) {
                self.overflow_min_tick = u64_max();
                let head = self.take_list(overflow);
                self.replace_chain(head);
            }
        }
        let mut level = wrapping_sub(self.levels, 1);
        loop {
            if level < 1 {
                break;
            }
            let low = wrapping_mul(level, self.slot_bits);
            if c & wrapping_sub(shl_in(1, low), 1) == 0 {
                let slot = shr_in(c, low) & self.slot_mask();
                let list = wrapping_add(wrapping_mul(level, self.slots), slot);
                let head = self.take_list(list);
                self.replace_chain(head);
            }
            level = wrapping_sub(level, 1);
        }
        let slot = c & self.slot_mask();
        let head = self.take_list(slot);
        if head == nil() {
            return;
        }
        let (head, tail) = self.sort_chain(head);
        let ready = self.ready_list();
        let ready_tail = self.tail_of(ready);
        // Entries already on the ready list belong to earlier ticks, so the
        // sorted chain is appended after them.
        let mut prev = ready_tail;
        let mut cur = head;
        loop {
            if cur == nil() {
                break;
            }
            self.e.try_set(ix(cur, 4), prev);
            self.e.try_set(ix(cur, 6), ready);
            prev = cur;
            cur = self.next_of(cur);
        }
        if ready_tail == nil() {
            self.l.try_set(lx(ready, 0), head);
        } else {
            self.e.try_set(ix(ready_tail, 5), head);
        }
        self.l.try_set(lx(ready, 1), tail);
    }

    // Stable bottom-up merge sort of a `next`-linked chain by
    // `(deadline, sequence)`, in place. Returns `(head, tail)`.
    fn sort_chain(inout self, head: u64) -> (u64, u64) {
        // A one-entry chain (most level-0 slots) is already sorted.
        if self.next_of(head) == nil() {
            return (head, head);
        }
        let mut list = head;
        let mut width: u64 = 1;
        loop {
            let mut p = list;
            list = nil();
            let mut tail = nil();
            let mut merges: u64 = 0;
            loop {
                if p == nil() {
                    break;
                }
                merges = wrapping_add(merges, 1);
                let mut q = p;
                let mut psize: u64 = 0;
                loop {
                    if psize >= width || q == nil() {
                        break;
                    }
                    psize = wrapping_add(psize, 1);
                    q = self.next_of(q);
                }
                let mut qsize = width;
                loop {
                    if !(psize > 0 || (qsize > 0 && q != nil())) {
                        break;
                    }
                    let take_p = if psize == 0 {
                        false
                    } else if qsize == 0 || q == nil() {
                        true
                    } else {
                        self.key_le(p, q)
                    };
                    let e = if take_p {
                        let e = p;
                        p = self.next_of(p);
                        psize = wrapping_sub(psize, 1);
                        e
                    } else {
                        let e = q;
                        q = self.next_of(q);
                        qsize = wrapping_sub(qsize, 1);
                        e
                    };
                    if tail == nil() {
                        list = e;
                    } else {
                        self.e.try_set(ix(tail, 5), e);
                    }
                    tail = e;
                }
                p = q;
            }
            self.e.try_set(ix(tail, 5), nil());
            if merges <= 1 {
                break(list, tail);
            }
            width = if width > 9223372036854775807 {
                u64_max()
            } else {
                wrapping_mul(width, 2)
            };
        }
    }
}
