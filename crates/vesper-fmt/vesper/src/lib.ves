// The `.vsys` library `Blake3` is @vesper-std/hash-sys's (its manifest's
// `[package] vsys`), provided in C by the package's `[package] objects`,
// which the port harness archives with this port's object.
//
// @vesper/fmt: `vesper_fmt::format_source` in Vesper (self-hosting SH1
// lane 11, #1154), over the token table and CST parser of @vesper/front.
//
// `format` is crates/vesper-fmt/src/lib.rs `format_with_capture` without a
// proof capture: the lexer gate (gate.ves), the parser's syntax check, the
// layout of the significant tokens (layout.ves), the bounded document and
// its renderer (doc.ves), then the conservation and idempotence checks. It
// charges the same work units as Rust, so the same input and limits give the
// same output or the same error. Sugar sources and test blocks are laid
// out over @vesper/front's surface CST (`surface::syntax`, `sugar_layout`).
// Sources in the macro profile (`m!`, `quote`) are `OpaqueMacro` here: the
// Rust side formats them with its own macro-profile parser, which this
// package does not port yet.

use @vesper/front::{Tokens, P};
use @vesper-std/hash::blake3::{Digest};
use @vesper-std/hash-sys::{hash};
use @vesper/front::diag::{diags_new};
use @vesper/front::parse::{parse_tokens, parse_surface_tokens, sugar_operator_at, hard_depth};
use @vesper/front::{Tokens};
use @vesper/front::lex::{lex_with_limits, lex_sugar_with_limits, max_diagnostics, token_end};
use @vesper/front::diag::{diags_new};

// ---------------------------------------------------------------- kinds

// Token kinds: the discriminants of `vesper_syntax::lexer::TokenKind`, which
// are also the `kind` rows of @vesper/front's token table.

// CST events of @vesper/front (`Event`, `NodeKind` in its tree.ves).
const EV_START_BASE: u64 = 2147483648;
const EV_FINISH: u64 = 4294967295;
const NODE_EXPR: u64 = 202;
const NODE_PATTERN: u64 = 203;
// The surface CST's sugar and expression macro nodes
// (`parser::is_sugar_node`, `SURFACE_MACRO_*`).
const NODE_SUGAR_ITEM: u64 = 208;
const NODE_SUGAR_STMT: u64 = 209;
const NODE_SUGAR_GROUP: u64 = 211;
const NODE_SUGAR_DECL: u64 = 212;
const NODE_SUGAR_PATTERN: u64 = 214;
const NODE_SUGAR_TEMPLATE: u64 = 215;
const NODE_SUGAR_CONTINUATION: u64 = 216;
const NODE_SUGAR_HOLE: u64 = 217;
const NODE_SUGAR_PAT: u64 = 218;
const NODE_SUGAR_OPERATOR: u64 = 220;
const NODE_TAGGED_LITERAL: u64 = 223;
const NODE_SURFACE_MACRO_DECL: u64 = 224;
const NODE_SURFACE_MACRO_ARG: u64 = 226;

const K_WHITESPACE: u8 = 0;
const K_COMMENT: u8 = 1;
const K_BLOCK_COMMENT: u8 = 2;
const K_UPPER: u8 = 3;
const K_LOWER: u8 = 4;
const K_FLOAT: u8 = 5;
const K_INT: u8 = 6;
const K_STRING: u8 = 7;
const K_STRUCT: u8 = 8;
const K_ENUM: u8 = 9;
const K_EFFECT: u8 = 10;
const K_IMPL: u8 = 11;
const K_FN: u8 = 12;
const K_LET: u8 = 13;
const K_COPY: u8 = 14;
const K_AFFINE: u8 = 15;
const K_LINEAR: u8 = 16;
const K_MOD: u8 = 17;
const K_EFF: u8 = 18;
const K_IN: u8 = 19;
const K_INOUT: u8 = 20;
const K_SINK: u8 = 21;
const K_SELF_KW: u8 = 22;
const K_HANDLE: u8 = 23;
const K_STATE: u8 = 24;
const K_WITH: u8 = 25;
const K_RETURN: u8 = 26;
const K_MATCH: u8 = 27;
const K_IF: u8 = 28;
const K_ELSE: u8 = 29;
const K_TRUE: u8 = 30;
const K_FALSE: u8 = 31;
const K_L_PAREN: u8 = 32;
const K_R_PAREN: u8 = 33;
const K_L_BRACE: u8 = 34;
const K_R_BRACE: u8 = 35;
const K_L_BRACKET: u8 = 36;
const K_R_BRACKET: u8 = 37;
const K_COMMA: u8 = 38;
const K_SEMI: u8 = 39;
const K_COLON: u8 = 40;
const K_COLON_COLON: u8 = 41;
const K_DOT: u8 = 42;
const K_QUESTION: u8 = 43;
const K_AT: u8 = 44;
const K_AT_AT: u8 = 45;
const K_ARROW: u8 = 46;
const K_FAT_ARROW: u8 = 47;
const K_EQ: u8 = 48;
const K_PLUS_EQ: u8 = 49;
const K_STAR_EQ: u8 = 50;
const K_SLASH_EQ: u8 = 51;
const K_PERCENT_EQ: u8 = 52;
const K_MINUS_EQ: u8 = 53;
const K_PLUS: u8 = 54;
const K_MINUS: u8 = 55;
const K_STAR: u8 = 56;
const K_SLASH: u8 = 57;
const K_PERCENT: u8 = 58;
const K_EQ_EQ: u8 = 59;
const K_NE: u8 = 60;
const K_LT: u8 = 61;
const K_LE: u8 = 62;
const K_GT: u8 = 63;
const K_GE: u8 = 64;
const K_AND: u8 = 65;
const K_OR: u8 = 66;
const K_BANG: u8 = 67;
const K_PIPE: u8 = 68;
const K_ERROR: u8 = 69;
const K_EOF: u8 = 70;
const K_DOLLAR: u8 = 71;
const K_TILDE: u8 = 72;
const K_PIPE_EQ: u8 = 73;
const K_AMP_EQ: u8 = 74;
const K_DOT_DOT: u8 = 75;
const K_DOT_DOT_EQ: u8 = 76;
const K_AMP: u8 = 77;
const K_CARET: u8 = 78;
const K_SHL: u8 = 79;
const K_SHR: u8 = 80;
const K_BACKTICK: u8 = 81;

// ---------------------------------------------------------------- work

// The error record, the limits and the work counter of `vesper_fmt`
// (crates/vesper-fmt/src/lib.rs `Error`, `Limits` and `Work`).

// `FmtFail::code` is the index of the Rust `Error` variant:
//   0 InputLimit, 1 OutputLimit, 2 TokenLimit, 3 NodeLimit, 4 DepthLimit,
//   5 WorkLimit, 6 Overflow, 7 Allocation, 8 InvalidDoc,
//   9 Syntax { offset }, 10 OpaqueMacro, 11 Conservation, 12 NotIdempotent.
// `offset` is the byte offset of `Syntax`, else 0.
pub copy struct FmtFail {
    code: u64,
    offset: u64
}

const E_INPUT: u64 = 0;
const E_OUTPUT: u64 = 1;
const E_TOKEN: u64 = 2;
const E_NODE: u64 = 3;
const E_DEPTH: u64 = 4;
const E_WORK: u64 = 5;
const E_OVERFLOW: u64 = 6;
const E_SYNTAX: u64 = 9;
const E_MACRO: u64 = 10;
const E_CONSERVATION: u64 = 11;
const E_IDEMPOTENT: u64 = 12;

const U64_MAX: u64 = 18446744073709551615;

fn fail(code: u64) eff [Fail[FmtFail]] {
    Fail::raise(FmtFail { code: code, offset: 0 });
}

fn fail_at(offset: u64) eff [Fail[FmtFail]] {
    Fail::raise(FmtFail { code: E_SYNTAX, offset: offset });
}

// `a + b`, or `Overflow`.
fn cadd(a: u64, b: u64) -> u64 eff [Fail[FmtFail]] {
    if a > wrapping_sub(U64_MAX, b) {
        fail(E_OVERFLOW);
    }
    wrapping_add(a, b)
}

fn min64(a: u64, b: u64) -> u64 {
    if a < b { a } else { b }
}

// `Limits` (all fields are `usize` in Rust, at most `u64::MAX` here).
copy struct Limits {
    max_input_bytes: u64,
    max_output_bytes: u64,
    max_tokens: u64,
    max_doc_nodes: u64,
    max_depth: u64,
    max_work: u64
}

// `Work`: units used and the ceiling.
copy struct Work {
    used: u64,
    max: u64
}

fn charge(inout w: Work, n: u64) eff [Fail[FmtFail]] {
    w.used = cadd(w.used, n);
    if w.used > w.max {
        fail(E_WORK);
    }
}

// ---------------------------------------------------------------- doc

// The bounded document algebra and its renderer: crates/vesper-fmt/src/doc.rs
// (`Document::push`, `render` and `following_width`), charge for charge, so
// the same inputs give the same output and the same limit errors.
//
// Nodes are rows of parallel sequences. A text node is a byte range of the
// source being formatted; the two literal texts the formatter adds, " " and
// "\n", are their own kinds. A concatenation's children are a run of `kids`.

const D_NIL: u8 = 0;
const D_TEXT: u8 = 1;
const D_COMMENT: u8 = 2;
const D_HARD: u8 = 3;
const D_SOFT_SPACE: u8 = 4;
const D_SOFT_EMPTY: u8 = 5;
const D_NEST: u8 = 6;
const D_CONCAT: u8 = 7;
const D_GROUP: u8 = 8;
// `Doc::Text(" ")` and `Doc::Text("\n")`.
const D_SPACE: u8 = 9;
const D_NEWLINE: u8 = 10;

// No width: the node holds a line break.
const NONE: u64 = 18446744073709551615;
const LINE_WIDTH: u64 = 100;
const MAX_DOC_DEPTH: u64 = 256;

struct Doc {
    kind: ChunkSeq[u8],
    // Text: start; Nest: spaces; Concat: first child in `kids`; Group: inner.
    a: ChunkSeq[u32],
    // Text: end; Nest: inner; Concat: child count.
    b: ChunkSeq[u32],
    width: ChunkSeq[u64],
    depth: ChunkSeq[u32],
    kids: ChunkSeq[u32],
    w: Work,
    max_nodes: u64,
    max_output: u64
}

fn doc_new(in lim: Limits, capacity: u64) -> Doc {
    Doc {
        kind: ChunkSeq::with_capacity[u8](capacity),
        a: ChunkSeq::with_capacity[u32](capacity),
        b: ChunkSeq::with_capacity[u32](capacity),
        width: ChunkSeq::with_capacity[u64](capacity),
        depth: ChunkSeq::with_capacity[u32](capacity),
        kids: ChunkSeq::with_capacity[u32](capacity),
        w: Work { used: 0, max: lim.max_work },
        max_nodes: lim.max_doc_nodes,
        max_output: lim.max_output_bytes
    }
}

fn u32_at(in s: ChunkSeq[u32], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(v) => widen_u64(v),
        Option::None => 0,
    }
}

fn kind_at(in d: Doc, id: u64) -> u8 {
    match d.kind.try_get(id) {
        Option::Some(k) => k,
        Option::None => D_NIL,
    }
}

fn width_at(in d: Doc, id: u64) -> u64 {
    match d.width.try_get(id) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

fn depth_at(in d: Doc, id: u64) -> u64 {
    u32_at(in d.depth, id)
}

fn byte(in s: Slice[u8], i: u64) -> u8 {
    match s.try_get(i) {
        Option::Some(c) => c,
        Option::None => 0,
    }
}

// Unicode scalars in `s[a..b]` (UTF-8 lead bytes).
fn chars(in s: Slice[u8], a: u64, b: u64) -> u64 {
    let mut n: u64 = 0;
    for i in a..b {
        if byte(in s, i) & 192 != 128 {
            n = wrapping_add(n, 1);
        }
    }
    n
}

// Whether `s[a..b]` holds a `\n` or `\r`.
fn has_break(in s: Slice[u8], a: u64, b: u64) -> bool {
    if a >= b {
        return false;
    }
    match s[a..b].find_either(10, 13) {
        Option::Some(_) => true,
        Option::None => false,
    }
}

fn add_node(
    inout d: Doc,
    kind: u8,
    a: u64,
    b: u64,
    width: u64,
    depth: u64
) -> u64 eff [Fail[FmtFail]] {
    if depth > MAX_DOC_DEPTH {
        fail(E_DEPTH);
    }
    let id = d.kind.len();
    d.kind.push(kind);
    d.a.push(wrapping_u32(a));
    d.b.push(wrapping_u32(b));
    d.width.push(width);
    d.depth.push(wrapping_u32(depth));
    id
}

fn begin(inout d: Doc) eff [Fail[FmtFail]] {
    charge(inout d.w, 1);
    if d.kind.len() >= d.max_nodes {
        fail(E_NODE);
    }
}

// `Doc::Text` or `Doc::Comment` of `src[s..e]`.
fn push_text(
    inout d: Doc,
    in src: Slice[u8],
    s: u64,
    e: u64,
    comment: bool
) -> u64 eff [Fail[FmtFail]] {
    begin(inout d);
    charge(inout d.w, wrapping_sub(e, s));
    let line_comment = comment
        && wrapping_sub(e, s) >= 2
        && byte(in src, s) == 47
        && byte(in src, wrapping_add(s, 1)) == 47;
    let width = if line_comment || has_break(in src, s, e) {
        NONE
    } else {
        chars(in src, s, e)
    };
    let kind = if comment { D_COMMENT } else { D_TEXT };
    add_node(inout d, kind, s, e, width, 1)
}

// A leaf without a source range: `HardLine`, `SoftLineOrSpace`,
// `SoftLineOrEmpty`, `Text(" ")` or `Text("\n")`.
fn push_leaf(inout d: Doc, kind: u8) -> u64 eff [Fail[FmtFail]] {
    begin(inout d);
    let width = if kind == D_HARD || kind == D_NEWLINE {
        NONE
    } else if kind == D_SOFT_SPACE || kind == D_SPACE {
        1
    } else {
        0
    };
    if kind == D_SPACE || kind == D_NEWLINE {
        charge(inout d.w, 1);
    }
    add_node(inout d, kind, 0, 0, width, 1)
}

fn push_nest(inout d: Doc, spaces: u64, inner: u64) -> u64 eff [Fail[FmtFail]] {
    begin(inout d);
    if spaces > d.max_output {
        fail(E_OUTPUT);
    }
    let depth = cadd(depth_at(in d, inner), 1);
    let width = width_at(in d, inner);
    add_node(inout d, D_NEST, spaces, inner, width, depth)
}

fn push_group(inout d: Doc, inner: u64) -> u64 eff [Fail[FmtFail]] {
    begin(inout d);
    let depth = cadd(depth_at(in d, inner), 1);
    let width = width_at(in d, inner);
    add_node(inout d, D_GROUP, inner, 0, width, depth)
}

fn push_concat(inout d: Doc, in ids: Slice[u32]) -> u64 eff [Fail[FmtFail]] {
    push_concat_range(inout d, in ids, 0, ids.len())
}

fn push_concat_range(
    inout d: Doc,
    in ids: Slice[u32],
    start: u64,
    end: u64
) -> u64 eff [Fail[FmtFail]] {
    begin(inout d);
    let n = wrapping_sub(end, start);
    if n > d.max_nodes {
        fail(E_NODE);
    }
    charge(inout d.w, n);
    let mut width: u64 = 0;
    let mut depth: u64 = 1;
    let first = d.kids.len();
    for i in start..end {
        let id = match ids.try_get(i) {
            Option::Some(v) => widen_u64(v),
            Option::None => 0,
        };
        let child = cadd(depth_at(in d, id), 1);
        if child > depth {
            depth = child;
        }
        let w = width_at(in d, id);
        if width != NONE {
            width = if w == NONE { NONE } else { cadd(width, w) };
        }
        d.kids.push(wrapping_u32(id));
    }
    add_node(inout d, D_CONCAT, first, n, width, depth)
}

fn push_concat2(inout d: Doc, x: u64, y: u64) -> u64 eff [Fail[FmtFail]] {
    let mut ids = ChunkSeq::with_capacity[u32](2);
    ids.push(wrapping_u32(x));
    ids.push(wrapping_u32(y));
    push_concat(inout d, in ids.as_slice())
}

// The bytes a text node emits.
fn text_len(in d: Doc, id: u64) -> u64 {
    let k = kind_at(in d, id);
    if k == D_TEXT || k == D_COMMENT {
        wrapping_sub(u32_at(in d.b, id), u32_at(in d.a, id))
    } else if k == D_SPACE || k == D_NEWLINE {
        1
    } else {
        0
    }
}

// A pending render entry: node, flat flag and indentation in one word.
fn entry(indent: u64, flat: bool, id: u64) -> u64 {
    let f: u64 = if flat { 4294967296 } else { 0 };
    id | f | wrapping_shl_u64(indent, 33)
}

fn entry_id(e: u64) -> u64 {
    e & 4294967295
}

fn entry_flat(e: u64) -> bool {
    e & 4294967296 != 0
}

fn entry_rest(e: u64) -> u64 {
    wrapping_shr_u64(e, 33)
}

fn push_frame(in d: Doc, inout frames: ChunkSeq[u64], id: u64, flat: bool) eff [Fail[FmtFail]] {
    if frames.len() >= d.max_nodes {
        fail(E_NODE);
    }
    frames.push(entry(0, flat, id));
}

// `Document::following_width`: the width of what follows on the current
// line, from the top of the pending stack, until a line break or until it
// passes `remaining`.
fn following_width(
    inout d: Doc,
    in src: Slice[u8],
    in pending: ChunkSeq[u64],
    remaining: u64
) -> u64 eff [Fail[FmtFail]] {
    let mut width: u64 = 0;
    // Frames: node, flat flag and the next child index of a Concat.
    let mut frames = ChunkSeq::with_capacity[u64](16);
    let mut p = pending.len();
    loop {
        if p == 0 {
            break;
        }
        p = wrapping_sub(p, 1);
        let top = match pending.try_get(p) {
            Option::Some(e) => e,
            Option::None => 0,
        };
        frames.truncate(0);
        frames.push(entry(0, entry_flat(top), entry_id(top)));
        loop {
            let nf = frames.len();
            if nf == 0 {
                break;
            }
            charge(inout d.w, 1);
            let last = wrapping_sub(nf, 1);
            let frame = match frames.try_get(last) {
                Option::Some(e) => e,
                Option::None => 0,
            };
            let fid = entry_id(frame);
            let fflat = entry_flat(frame);
            let mut vid: u64 = fid;
            let vflat = fflat;
            if kind_at(in d, fid) == D_CONCAT {
                let next = entry_rest(frame);
                if next < u32_at(in d.b, fid) {
                    frames.try_set(last, entry(wrapping_add(next, 1), fflat, fid));
                    vid = u32_at(in d.kids, wrapping_add(u32_at(in d.a, fid), next));
                } else {
                    frames.truncate(last);
                    continue;
                }
            } else {
                frames.truncate(last);
            }
            charge(inout d.w, 1);
            charge(inout d.w, text_len(in d, vid));
            let k = kind_at(in d, vid);
            if k == D_TEXT || k == D_COMMENT {
                let s = u32_at(in d.a, vid);
                let e = u32_at(in d.b, vid);
                let cut = if s >= e {
                    e
                } else {
                    match src[s..e].find_either(10, 13) {
                        Option::Some(j) => wrapping_add(s, j),
                        Option::None => e,
                    }
                };
                width = cadd(width, chars(in src, s, cut));
                if cut != e {
                    return width;
                }
            } else if k == D_SPACE {
                width = cadd(width, 1);
            } else if k == D_NEWLINE || k == D_HARD {
                return width;
            } else if k == D_SOFT_SPACE || k == D_SOFT_EMPTY {
                if !vflat {
                    return width;
                }
                if k == D_SOFT_SPACE {
                    width = cadd(width, 1);
                }
            } else if k == D_NEST {
                push_frame(in d, inout frames, u32_at(in d.b, vid), vflat);
                continue;
            } else if k == D_GROUP {
                push_frame(in d, inout frames, u32_at(in d.a, vid), false);
                continue;
            } else if k == D_CONCAT {
                push_frame(in d, inout frames, vid, vflat);
                continue;
            }
            if width > remaining {
                return width;
            }
        }
    }
    width
}

fn append_check(in out: ChunkSeq[u8], n: u64, max: u64) eff [Fail[FmtFail]] {
    if cadd(out.len(), n) > max {
        fail(E_OUTPUT);
    }
}

// `Document::render`.
fn render(inout d: Doc, in src: Slice[u8], root: u64) -> ChunkSeq[u8] eff [Fail[FmtFail]] {
    let mut out = ChunkSeq::with_capacity[u8](
        wrapping_add(src.len(), wrapping_shr_u64(src.len(), 2))
    );
    let mut stack = ChunkSeq::with_capacity[u64](64);
    stack.push(entry(0, false, root));
    let mut column: u64 = 0;
    let max = d.max_output;
    loop {
        let ns = stack.len();
        if ns == 0 {
            break;
        }
        let top = match stack.try_get(wrapping_sub(ns, 1)) {
            Option::Some(e) => e,
            Option::None => 0,
        };
        stack.truncate(wrapping_sub(ns, 1));
        let id = entry_id(top);
        let flat = entry_flat(top);
        let indent = entry_rest(top);
        charge(inout d.w, 1);
        charge(inout d.w, text_len(in d, id));
        let k = kind_at(in d, id);
        if k == D_TEXT || k == D_COMMENT {
            let s = u32_at(in d.a, id);
            let e = u32_at(in d.b, id);
            append_check(in out, wrapping_sub(e, s), max);
            out.extend(src[s..e]);
            // The column after the text: its last line, or the line it
            // extends.
            let mut j = e;
            let mut nl = false;
            loop {
                if j <= s {
                    break;
                }
                if byte(in src, wrapping_sub(j, 1)) == 10 {
                    nl = true;
                    break;
                }
                j = wrapping_sub(j, 1);
            }
            column = if nl {
                chars(in src, j, e)
            } else {
                cadd(column, chars(in src, s, e))
            };
        } else if k == D_SPACE {
            append_check(in out, 1, max);
            out.push(32);
            column = cadd(column, 1);
        } else if k == D_NEWLINE {
            append_check(in out, 1, max);
            out.push(10);
            column = 0;
        } else if k == D_HARD || k == D_SOFT_SPACE || k == D_SOFT_EMPTY {
            if k == D_HARD || !flat {
                append_check(in out, 1, max);
                out.push(10);
                charge(inout d.w, indent);
                append_check(in out, indent, max);
                out.resize(wrapping_add(out.len(), indent), 32);
                column = indent;
            } else if k == D_SOFT_SPACE {
                append_check(in out, 1, max);
                out.push(32);
                column = cadd(column, 1);
            }
        } else if k == D_NEST {
            stack.push(entry(cadd(indent, u32_at(in d.a, id)), flat, u32_at(in d.b, id)));
        } else if k == D_GROUP {
            let inner = u32_at(in d.a, id);
            let available = if column >= LINE_WIDTH {
                0
            } else {
                wrapping_sub(LINE_WIDTH, column)
            };
            let width = width_at(in d, inner);
            let fits = if width != NONE && width <= available {
                let room = wrapping_sub(available, width);
                following_width(inout d, in src, in stack, room) <= room
            } else {
                false
            };
            stack.push(entry(indent, fits, inner));
        } else if k == D_CONCAT {
            let first = u32_at(in d.a, id);
            let n = u32_at(in d.b, id);
            if cadd(stack.len(), n) > d.max_nodes {
                fail(E_NODE);
            }
            let mut i = n;
            loop {
                if i == 0 {
                    break;
                }
                i = wrapping_sub(i, 1);
                stack.push(entry(indent, flat, u32_at(in d.kids, wrapping_add(first, i))));
            }
        }
        charge(inout d.w, 1);
    }
    out
}

// ---------------------------------------------------------------- gate

// The lexer gate: crates/vesper-fmt/src/lib.rs `guarded_lex`. It lexes with
// the lexer's hard ceilings and one diagnostic, refuses macro syntax, and
// preflights delimiter depth and expression chains, charging the same work
// units as Rust.

// `lexer::HARD_SOURCE_BYTES` and `lexer::HARD_TOKENS`.
const HARD_SOURCE_BYTES: u64 = 8388608;
const HARD_TOKENS: u64 = 262144;
// The parser charge per lexed token (`PARSE_UNITS_PER_TOKEN`).
const PARSE_UNITS_PER_TOKEN: u64 = 64;
// Expression height the preflight accepts (`MAX_CHAIN`).
const MAX_CHAIN: u64 = 160;
// `ChainStep`: how a token changes the height estimate at its level.
const STEP_END: u8 = 0;
const STEP_OPERATOR: u8 = 1;
const STEP_POSTFIX: u8 = 2;
const STEP_OPERAND: u8 = 3;
const MAX_NESTING: u64 = 24;

fn tok_kind(in t: Tokens, i: u64) -> u8 {
    match t.kind.try_get(i) {
        Option::Some(k) => k,
        Option::None => K_EOF,
    }
}

fn tok_start(in t: Tokens, i: u64) -> u64 {
    match t.start.try_get(i) {
        Option::Some(v) => widen_u64(v),
        Option::None => 0,
    }
}

fn tok_end(in t: Tokens, i: u64) -> u64 {
    token_end(in t, i)
}

fn trivia(k: u8) -> bool {
    k <= K_BLOCK_COMMENT
}

// Weakest to strongest, matching the parser. A pipe can also open a closure.
fn infix_precedence(k: u8) -> u8 {
    if k == K_OR {
        2
    } else if k == K_AND {
        3
    } else if k == K_EQ_EQ || k == K_NE {
        4
    } else if k == K_LT || k == K_LE || k == K_GT || k == K_GE {
        5
    } else if k == K_CARET {
        7
    } else if k == K_AMP {
        8
    } else if k == K_SHL || k == K_SHR {
        9
    } else if k == K_PLUS || k == K_MINUS {
        10
    } else if k == K_STAR || k == K_SLASH || k == K_PERCENT {
        11
    } else {
        0
    }
}

fn is_binary_operator(k: u8) -> bool {
    infix_precedence(k) != 0
}

fn text_is(in src: Slice[u8], s: u64, e: u64, in word: Slice[u8]) -> bool {
    if wrapping_sub(e, s) != word.len() {
        return false;
    }
    for i in 0..word.len() {
        let a = match src.try_get(wrapping_add(s, i)) {
            Option::Some(c) => c,
            Option::None => 0,
        };
        let b = match word.try_get(i) {
            Option::Some(c) => c,
            Option::None => 1,
        };
        if a != b {
            return false;
        }
    }
    true
}

// `continues_chain`: whether a token right after a closing `}` extends the
// same expression.
fn continues_chain(k: u8, in src: Slice[u8], s: u64, e: u64) -> bool {
    is_binary_operator(k)
        || k == K_DOT
        || k == K_QUESTION
        || k == K_ELSE
        || k == K_WITH
        || k == K_L_PAREN
        || k == K_L_BRACKET
        || k == K_DOT_DOT
        || k == K_DOT_DOT_EQ
        || k == K_EQ
        || k == K_PLUS_EQ
        || k == K_MINUS_EQ
        || k == K_STAR_EQ
        || k == K_SLASH_EQ
        || k == K_PERCENT_EQ
        || k == K_ARROW
        || k == K_FAT_ARROW
        || k == K_COLON
        || k == K_COLON_COLON
        || text_is(in src, s, e, in "as".as_bytes())
}

// `chain_step`: `;` and `,` end the expression, operators start a new
// operand of the chain, postfix steps extend the current operand.
fn chain_step(k: u8, in src: Slice[u8], s: u64, e: u64) -> u8 {
    if k == K_SEMI || k == K_COMMA {
        STEP_END
    } else if is_binary_operator(k) || operator_step(k) {
        STEP_OPERATOR
    } else if postfix_step(k) || text_is(in src, s, e, in "as".as_bytes()) {
        STEP_POSTFIX
    } else {
        STEP_OPERAND
    }
}

fn operator_step(k: u8) -> bool {
    k == K_BANG
        || k == K_TILDE
        || k == K_ELSE
        || k == K_DOT_DOT
        || k == K_DOT_DOT_EQ
        || k == K_EQ
        || k == K_PLUS_EQ
        || k == K_MINUS_EQ
        || k == K_STAR_EQ
        || k == K_SLASH_EQ
        || k == K_PERCENT_EQ
        || k == K_PIPE_EQ
        || k == K_AMP_EQ
        || k == K_ARROW
        || k == K_FAT_ARROW
}

fn postfix_step(k: u8) -> bool {
    k == K_DOT
        || k == K_L_PAREN
        || k == K_L_BRACKET
        || k == K_L_BRACE
        || k == K_QUESTION
        || k == K_WITH
}

fn opaque_word(in src: Slice[u8], s: u64, e: u64) -> bool {
    text_is(in src, s, e, in "quote".as_bytes())
        || text_is(in src, s, e, in "quasiquote".as_bytes())
        || text_is(in src, s, e, in "syntax_quote".as_bytes())
}

// Lexes `src` with `lex_with_limits(HARD_SOURCE_BYTES, HARD_TOKENS, 1)`,
// as `guarded_lex` does: a lexer limit (a second error or a token overflow)
// is `TokenLimit`, one error is `Syntax` at its start. The caller has
// checked the byte ceiling.
fn lex_hard(in src: Slice[u8]) -> Tokens eff [Fail[FmtFail]] {
    let mut d = diags_new();
    let t = lex_sugar_with_limits(in src, inout d, HARD_SOURCE_BYTES, HARD_TOKENS, 1);
    if t.limited || t.rejected {
        fail(E_TOKEN);
    }
    // Lexer errors are code 1 rows, in source order.
    if d.code.len() != 0 {
        let first = match d.start.try_get(0) {
            Option::Some(v) => widen_u64(v),
            Option::None => 0,
        };
        fail_at(first);
    }
    t
}

// `guarded_lex` with `allow_macros = false` (the sugar surface lexer, so a
// backtick is a token). Macro syntax is
// `OpaqueMacro`, which the caller hands to the Rust build.
fn gate(in src: Slice[u8], in lim: Limits, inout w: Work) -> Tokens eff [Fail[FmtFail]] {
    charge(inout w, src.len());
    if src.len() > HARD_SOURCE_BYTES {
        fail(E_INPUT);
    }
    let t = lex_hard(in src);
    let ntok = t.kind.len();
    if ntok > min64(lim.max_tokens, HARD_TOKENS) {
        fail(E_TOKEN);
    }
    let max_depth = min64(lim.max_depth, MAX_NESTING);
    // Open delimiters, and the chain count at every level (`path_counts`)
    // with their running sum.
    let mut stack = ChunkSeq::with_capacity[u8](32);
    let mut counts = ChunkSeq::with_capacity[u64](32);
    counts.push(0);
    // Per level: the postfix steps of the current operand (`operand_steps`).
    let mut steps = ChunkSeq::with_capacity[u64](32);
    steps.push(0);
    // Per delimiter level: the chain count where the latest `if` that does
    // not continue an `else` started (NONE for none).
    let mut if_bases = ChunkSeq::with_capacity[u64](32);
    if_bases.push(NONE);
    let mut total: u64 = 0;
    let mut previous: u8 = K_EOF;
    let mut after_block = false;
    for i in 0..ntok {
        let k = tok_kind(in t, i);
        if trivia(k) || k == K_EOF {
            continue;
        }
        let s = tok_start(in t, i);
        let e = tok_end(in t, i);
        if k == K_BANG && (previous == K_LOWER || previous == K_UPPER) {
            fail(E_MACRO);
        }
        if k == K_LOWER && opaque_word(in src, s, e) {
            fail(E_MACRO);
        }
        let top = wrapping_sub(counts.len(), 1);
        let mut counter = match counts.try_get(top) {
            Option::Some(c) => c,
            Option::None => 0,
        };
        let mut step = match steps.try_get(top) {
            Option::Some(c) => c,
            Option::None => 0,
        };
        total = wrapping_sub(total, counter);
        let ifs = wrapping_sub(if_bases.len(), 1);
        if after_block && k == K_ELSE {
            // `} else` goes back to where its `if` started: every arm of an
            // `else if` chain is one component of the same expression, so a
            // chain of any length counts like a single `if`.
            let base = match if_bases.try_get(ifs) {
                Option::Some(b) => b,
                Option::None => NONE,
            };
            if base != NONE {
                counter = base;
                step = 0;
            }
        } else if after_block && !continues_chain(k, in src, s, e) {
            counter = 0;
            step = 0;
        }
        after_block = false;
        if k == K_IF && previous != K_ELSE {
            if_bases.try_set(ifs, counter);
        }
        let kind_step = chain_step(k, in src, s, e);
        if kind_step == STEP_END {
            counter = 0;
            step = 0;
        } else if kind_step == STEP_OPERATOR {
            counter = cadd(wrapping_sub(counter, step), 1);
            step = 0;
        } else if kind_step == STEP_POSTFIX {
            counter = cadd(counter, 1);
            step = cadd(step, 1);
        }
        counts.try_set(top, counter);
        steps.try_set(top, step);
        total = cadd(total, counter);
        if total > MAX_CHAIN {
            fail(E_DEPTH);
        }
        if k == K_L_PAREN || k == K_L_BRACKET || k == K_L_BRACE {
            stack.push(k);
            counts.push(0);
            steps.push(0);
            if_bases.push(NONE);
            if stack.len() > max_depth {
                fail(E_DEPTH);
            }
        } else if k == K_R_PAREN || k == K_R_BRACKET || k == K_R_BRACE {
            let expected = if k == K_R_PAREN {
                K_L_PAREN
            } else if k == K_R_BRACKET {
                K_L_BRACKET
            } else {
                K_L_BRACE
            };
            let n = stack.len();
            let open = if n == 0 {
                K_EOF
            } else {
                match stack.try_get(wrapping_sub(n, 1)) {
                    Option::Some(o) => o,
                    Option::None => K_EOF,
                }
            };
            if open != expected {
                fail_at(s);
            }
            stack.truncate(wrapping_sub(n, 1));
            let last = wrapping_sub(counts.len(), 1);
            let dropped = match counts.try_get(last) {
                Option::Some(c) => c,
                Option::None => 0,
            };
            total = wrapping_sub(total, dropped);
            counts.truncate(last);
            steps.truncate(last);
            if_bases.truncate(wrapping_sub(if_bases.len(), 1));
            if stack.len() == 0 {
                let base = match counts.try_get(0) {
                    Option::Some(c) => c,
                    Option::None => 0,
                };
                total = wrapping_sub(total, base);
                counts.try_set(0, 0);
                steps.try_set(0, 0);
            }
            after_block = k == K_R_BRACE;
        }
        previous = k;
    }
    if stack.len() != 0 {
        fail_at(src.len());
    }
    charge(inout w, wrapping_mul(ntok, PARSE_UNITS_PER_TOKEN));
    t
}

// The work units of a second `guarded_lex` of a source the gate accepted
// with `ntok` tokens: the same charges, without lexing again.
fn gate_charge(len: u64, ntok: u64, inout w: Work) eff [Fail[FmtFail]] {
    charge(inout w, len);
    charge(inout w, wrapping_mul(ntok, PARSE_UNITS_PER_TOKEN));
}

// ---------------------------------------------------------------- layout

// Layout: crates/vesper-fmt/src/lib.rs `gap` and `sequence`, which lower the
// significant tokens (the CST's leaves without whitespace) to a document.

// The significant tokens. `flags` bit 0: the whitespace before held a blank
// line; bit 1: no whitespace separates the token from the previous one.
struct Atoms {
    kind: ChunkSeq[u8],
    start: ChunkSeq[u32],
    end: ChunkSeq[u32],
    flags: ChunkSeq[u8],
    // The token's index in the parser's token table.
    raw: ChunkSeq[u32],
    // `Piece::sugar_gap` (`SGAP_NONE` for none), and the precedence of a
    // `G_OPERATOR` one.
    sgap: ChunkSeq[u8],
    slevel: ChunkSeq[u8]
}

const G_NONE: u8 = 0;
const G_SOFT: u8 = 1;
const G_EMPTY: u8 = 2;
const G_OPERATOR: u8 = 3;
const G_RETURN: u8 = 4;
const G_HARD: u8 = 5;
// Only from the sugar layout: a single space that never breaks.
const G_SPACE: u8 = 6;
const SGAP_NONE: u8 = 255;
// No closing delimiter: the top-level sequence.
const NO_END: u8 = 255;

fn akind(in a: Atoms, i: u64) -> u8 {
    match a.kind.try_get(i) {
        Option::Some(k) => k,
        Option::None => K_EOF,
    }
}

fn w32(in s: ChunkSeq[u32], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(v) => widen_u64(v),
        Option::None => 0,
    }
}

fn aflags(in a: Atoms, i: u64) -> u8 {
    match a.flags.try_get(i) {
        Option::Some(f) => f,
        Option::None => 0,
    }
}

fn starts_range_bound(k: u8) -> bool {
    k == K_INT
        || k == K_FLOAT
        || k == K_LOWER
        || k == K_UPPER
        || k == K_L_PAREN
        || k == K_MINUS
        || k == K_SELF_KW
}

fn ends_operand(k: u8) -> bool {
    k == K_LOWER
        || k == K_UPPER
        || k == K_INT
        || k == K_FLOAT
        || k == K_STRING
        || k == K_TRUE
        || k == K_FALSE
        || k == K_SELF_KW
        || k == K_R_PAREN
        || k == K_R_BRACKET
        || k == K_R_BRACE
        || k == K_QUESTION
}

fn gap(p: u8, c: u8, block: bool, after_block: bool) -> u8 {
    if p == K_DOLLAR || c == K_BANG && (p == K_LOWER || p == K_UPPER) {
        return G_NONE;
    }
    if p == K_COMMENT || p == K_SEMI {
        return G_HARD;
    }
    if p == K_COMMA {
        return if block { G_HARD } else { G_SOFT };
    }
    if after_block
        && !(
            c == K_COMMA
                || c == K_SEMI
                || c == K_R_PAREN
                || c == K_R_BRACKET
                || c == K_DOT
                || c == K_QUESTION
                || c == K_ELSE
                || c == K_WITH
                || c == K_EQ
                || c == K_FAT_ARROW
        ) {
        return G_HARD;
    }
    if c == K_COMMENT || c == K_BLOCK_COMMENT || p == K_BLOCK_COMMENT {
        return G_SOFT;
    }
    if c == K_DOT && (p == K_INT || p == K_FLOAT) {
        return G_SOFT;
    }
    if c == K_DOT {
        return G_EMPTY;
    }
    if c == K_COLON_COLON {
        return G_NONE;
    }
    if (c == K_DOT_DOT || c == K_DOT_DOT_EQ) && ends_operand(p)
        || (p == K_DOT_DOT || p == K_DOT_DOT_EQ) && starts_range_bound(c) {
        return G_NONE;
    }
    if c == K_ARROW {
        return G_RETURN;
    }
    if is_binary_operator(c) && ends_operand(p) {
        return G_OPERATOR;
    }
    if c == K_COMMA
        || c == K_SEMI
        || c == K_COLON
        || c == K_DOT
        || c == K_COLON_COLON
        || c == K_QUESTION
        || c == K_R_PAREN
        || c == K_R_BRACKET {
        return G_NONE;
    }
    if p == K_DOT || p == K_COLON_COLON || p == K_AT || p == K_AT_AT {
        return if p == K_AT && c == K_AT {
            G_SOFT
        } else {
            G_NONE
        };
    }
    if (c == K_L_PAREN || c == K_L_BRACKET) && (ends_operand(p) || p == K_BANG || p == K_FN) {
        return G_NONE;
    }
    // `eff (` never starts an effect row, so `eff` is a name there
    // (`fn eff(..)`, `r.eff()`; contextual `eff`, #1175). `effect (`,
    // `handle (`, `sink (` and `inout (` are calls of a value of that name
    // too (#1244).
    if c == K_L_PAREN
        && (p == K_EFF || p == K_EFFECT || p == K_HANDLE || p == K_SINK || p == K_INOUT) {
        return G_NONE;
    }
    G_SOFT
}

copy struct LayoutBreak {
    offset: u64,
    level: u8
}

fn break_at(in breaks: ChunkSeq[LayoutBreak], i: u64) -> LayoutBreak {
    match breaks.try_get(i) {
        Option::Some(b) => b,
        Option::None => LayoutBreak { offset: 0, level: 0 },
    }
}

// `Chain`: the member chain of the operand at the end of a line, its flat
// width so far (NONE: it holds a line break) and each `.` break with the
// width before it. A short receiver keeps its first step (`self.f`), and a
// chain whose one method call ends it keeps its dots on one line when that
// call could not fit on a line of its own anyway (`out.rows.push(Row {`).
copy struct ChainDot {
    at: u64,
    before: u64
}

struct Chain {
    width: u64,
    dots: ChunkSeq[ChainDot],
    calls: u64,
    ends_with_call: bool
}

fn new_chain() -> Chain {
    Chain { width: 0, dots: ChunkSeq::new[ChainDot](), calls: 0, ends_with_call: false }
}

fn chain_dot(inout chain: Chain, at: u64) {
    chain.dots.push(ChainDot { at: at, before: chain.width });
}

fn chain_push(inout chain: Chain, width: u64, call: bool, kind: u8) eff [Fail[FmtFail]] {
    chain.width = if chain.width == NONE || width == NONE {
        NONE
    } else {
        cadd(chain.width, width)
    };
    if call && chain.dots.len() != 0 {
        chain.calls = wrapping_add(chain.calls, 1);
        chain.ends_with_call = true;
    } else if kind != K_QUESTION && kind != K_SEMI && kind != K_COMMA {
        chain.ends_with_call = false;
    }
}

fn dot_at(in dots: ChunkSeq[ChainDot], i: u64) -> ChainDot {
    match dots.try_get(i) {
        Option::Some(dot) => dot,
        Option::None => ChainDot { at: 0, before: NONE },
    }
}

fn chain_finish(
    inout chain: Chain,
    inout line: ChunkSeq[u32],
    inout breaks: ChunkSeq[LayoutBreak],
    indent: u64,
    inout d: Doc
) eff [Fail[FmtFail]] {
    let n = chain.dots.len();
    if n == 0 {
        chain = new_chain();
        return;
    }
    let first = dot_at(in chain.dots, 0).at;
    let before_last = dot_at(in chain.dots, wrapping_sub(n, 1)).before;
    // The last step's flat width on a line of its own, or NONE when it holds
    // a line break.
    let alone = if chain.width == NONE || before_last == NONE {
        NONE
    } else {
        cadd(cadd(indent, 5), wrapping_sub(chain.width, before_last))
    };
    let mut kept: u64 = 0;
    if chain.calls == 1 && chain.ends_with_call && (alone == NONE || alone > LINE_WIDTH) {
        kept = n;
    } else {
        loop {
            if kept >= n {
                break;
            }
            let root = dot_at(in chain.dots, kept).before;
            if root == NONE || root > 4 {
                break;
            }
            kept = wrapping_add(kept, 1);
        }
    }
    for i in 0..kept {
        let offset = break_at(in breaks, dot_at(in chain.dots, i).at).offset;
        let _ = line.try_set(offset, wrapping_u32(push_leaf(inout d, D_NIL)));
    }
    // No other break follows the chain's dots: an operator ends it.
    let total = breaks.len();
    for i in wrapping_add(first, kept)..total {
        let _ = breaks.try_set(wrapping_sub(i, kept), break_at(in breaks, i));
    }
    breaks.truncate(wrapping_sub(total, kept));
    chain = new_chain();
}

fn nest_continuation(inout d: Doc, lead: u64, content: u64) -> u64 eff [Fail[FmtFail]] {
    if lead == NONE {
        content
    } else {
        let continuation = push_concat2(inout d, lead, content);
        push_nest(inout d, 4, continuation)
    }
}

// Each recursive operand contains only stronger breaks, bounding the
// stack by the number of precedence levels even for long chains.
fn layout_line(
    in ids: ChunkSeq[u32],
    in breaks: ChunkSeq[LayoutBreak],
    start: u64,
    end: u64,
    first: u64,
    last: u64,
    inout d: Doc
) -> u64 eff [Fail[FmtFail]] {
    if first == last {
        return push_concat_range(inout d, in ids.as_slice(), start, end);
    }
    let mut weakest: u8 = 255;
    for i in first..last {
        let b = break_at(in breaks, i);
        if b.level < weakest {
            weakest = b.level;
        }
    }
    let mut segments = ChunkSeq::new[u32]();
    let mut operand = start;
    let mut child = first;
    let mut lead = NONE;
    for i in first..last {
        let b = break_at(in breaks, i);
        if b.level == weakest {
            if operand < b.offset {
                let rhs = layout_line(in ids, in breaks, operand, b.offset, child, i, inout d);
                segments.push(wrapping_u32(nest_continuation(inout d, lead, rhs)));
            }
            lead = w32(in ids, b.offset);
            operand = wrapping_add(b.offset, 1);
            child = wrapping_add(i, 1);
        }
    }
    let rhs = layout_line(in ids, in breaks, operand, end, child, last, inout d);
    segments.push(wrapping_u32(nest_continuation(inout d, lead, rhs)));
    let concat = push_concat(inout d, in segments.as_slice());
    push_group(inout d, concat)
}

fn concat_group(
    inout ids: ChunkSeq[u32],
    inout breaks: ChunkSeq[LayoutBreak],
    inout d: Doc,
    inout out: ChunkSeq[u32]
) eff [Fail[FmtFail]] {
    if ids.len() != 0 {
        let group = if breaks.len() == 0 {
            let concat = push_concat(inout d, in ids.as_slice());
            push_group(inout d, concat)
        } else {
            layout_line(in ids, in breaks, 0, ids.len(), 0, breaks.len(), inout d)
        };
        out.push(wrapping_u32(group));
        ids.truncate(0);
        breaks.truncate(0);
    }
}

fn close_of(k: u8) -> u8 {
    if k == K_L_PAREN {
        K_R_PAREN
    } else if k == K_L_BRACKET {
        K_R_BRACKET
    } else {
        K_R_BRACE
    }
}

fn concat4(inout d: Doc, a: u64, b: u64, c: u64, e: u64) -> u64 eff [Fail[FmtFail]] {
    let mut ids = ChunkSeq::with_capacity[u32](4);
    ids.push(wrapping_u32(a));
    ids.push(wrapping_u32(b));
    if c != 4294967295 {
        ids.push(wrapping_u32(c));
    }
    if e != 4294967295 {
        ids.push(wrapping_u32(e));
    }
    push_concat(inout d, in ids.as_slice())
}

// `word_used_as_name`: `effect`, `handle`, `sink`, `inout`, `copy` or
// `affine` after `.`, `fn` or `let`, or before an infix operator or `?`,
// spaces as a name; so do `copy (`, `copy [` and `affine (` except after
// `@` or `@@` (`fn @copy (u64)`).
fn word_used_as_name(has_prev: bool, prev: u8, c: u8, next: u8) -> bool {
    let modal = c == K_COPY || c == K_AFFINE;
    (c == K_EFFECT || c == K_HANDLE || c == K_SINK || c == K_INOUT || modal)
        && (
            has_prev && (prev == K_DOT || prev == K_FN || prev == K_LET)
                || is_binary_operator(next)
                || next == K_QUESTION
                || modal
                    && (next == K_L_PAREN || next == K_L_BRACKET)
                    && !(has_prev && (prev == K_AT || prev == K_AT_AT))
        )
}

// `sequence`: the atoms from `pos` up to the closing delimiter `end`.
// The widest short `if` expression that stays on one line, as rustfmt's
// `single_line_if_else_max_width`.
const SHORT_IF_ELSE_WIDTH: u64 = 50;

// Where a short `if c { a } else { b }` starting at `start` ends: the index
// of its last `}` (NONE: it is not one), when each branch holds one
// expression and no comment, its one-line width is at most
// SHORT_IF_ELSE_WIDTH, and it ends the expression it is in. rustfmt keeps
// such an `if` on one line.
fn short_if_else(in at: Atoms, start: u64, end: u8, in src: Slice[u8]) -> u64 {
    let n = at.kind.len();
    // 0: condition, 1: first branch, 2: `else`, 3: its `{`, 4: second branch.
    let mut state: u8 = 0;
    let mut depth: u64 = 0;
    let mut tokens: u64 = 0;
    let mut width: u64 = 0;
    let mut has_prev = false;
    let mut prev: u8 = 0;
    let mut unary = false;
    let mut i = start;
    let mut close = NONE;
    loop {
        if i >= n {
            return NONE;
        }
        let kind = akind(in at, i);
        let sugar = match at.sgap.try_get(i) {
            Option::Some(g) => g,
            Option::None => SGAP_NONE,
        };
        // A comment, a statement, a separator or a sugar boundary (`else` on
        // its own line in a template) can break the line, so the `if` cannot
        // be one group.
        if kind == K_COMMENT
            || kind == K_BLOCK_COMMENT
            || kind == K_SEMI
            || i > start && sugar != SGAP_NONE
            || depth == 0 && (kind == K_COMMA || kind == K_ARROW) {
            return NONE;
        }
        if has_prev {
            let space = if prev == K_L_PAREN
                || prev == K_L_BRACKET
                || kind == K_R_PAREN
                || kind == K_R_BRACKET
                || unary {
                false
            } else if prev == K_L_BRACE || kind == K_R_BRACE {
                true
            } else {
                let g = gap(prev, kind, false, prev == K_R_BRACE);
                g != G_NONE && g != G_EMPTY
            };
            if space {
                width = wrapping_add(width, 1);
            }
        }
        width = wrapping_add(width, chars(in src, w32(in at.start, i), w32(in at.end, i)));
        if width > SHORT_IF_ELSE_WIDTH {
            return NONE;
        }
        unary = (kind == K_MINUS || kind == K_BANG || kind == K_TILDE)
            && !(has_prev && ends_operand(prev));
        has_prev = true;
        prev = kind;
        if kind == K_L_BRACE {
            if depth == 0 && (state == 0 && tokens > 1 || state == 3) {
                state = wrapping_add(state, 1);
                tokens = 0;
                depth = 1;
            } else {
                return NONE;
            }
        } else if kind == K_R_BRACE && depth == 1 && (state == 1 || state == 4) {
            if tokens == 0 {
                return NONE;
            }
            if state == 4 {
                close = i;
                break;
            }
            state = 2;
            depth = 0;
        } else if kind == K_ELSE && depth == 0 && state == 2 {
            state = 3;
        } else if depth == 0 && state != 0 {
            return NONE;
        } else if kind == K_L_PAREN || kind == K_L_BRACKET {
            depth = wrapping_add(depth, 1);
            tokens = wrapping_add(tokens, 1);
        } else if kind == K_R_PAREN || kind == K_R_BRACKET || kind == K_R_BRACE {
            if depth == 0 {
                return NONE;
            }
            depth = wrapping_sub(depth, 1);
            tokens = wrapping_add(tokens, 1);
        } else {
            tokens = wrapping_add(tokens, 1);
        }
        i = wrapping_add(i, 1);
    }
    let next = wrapping_add(close, 1);
    if next >= n {
        return close;
    }
    let k = akind(in at, next);
    if end != NO_END && k == end
        || k == K_SEMI
        || k == K_COMMA
        || k == K_R_PAREN
        || k == K_R_BRACKET
        || k == K_R_BRACE {
        close
    } else {
        NONE
    }
}

fn sequence(
    in at: Atoms,
    inout pos: u64,
    end: u8,
    block: bool,
    fill: bool,
    // The least column a line inside this sequence can start at: every
    // delimiter or block it is nested in adds 4 once it breaks, and a line
    // break inside one means it broke.
    indent: u64,
    inout d: Doc,
    in src: Slice[u8]
) -> u64 eff [Fail[FmtFail]] {
    let n = at.kind.len();
    let list = end != NO_END && !block;
    let mut output = ChunkSeq::new[u32]();
    let mut line = ChunkSeq::new[u32]();
    let mut breaks = ChunkSeq::new[LayoutBreak]();
    let mut has_prev = false;
    let mut prev: u8 = 0;
    let mut previous_block = false;
    let mut previous_unary = false;
    let mut previous_ends_operand = false;
    let mut package = false;
    // Inside the head of an `if`, `match`, `for` or `while` at this level,
    // up to its `{`: the parser admits no struct literal there, so a type
    // name before `{` ends the head (`for i in 0..N {`).
    let mut head = false;
    // A `use` group fills its lines like rustfmt: each separator and the name
    // after it break on their own, so names pack to the width. These are the
    // separators' places in `output`; a comment or trailing comma keeps the
    // plain one-name-per-line layout.
    let mut separators = ChunkSeq::new[u32]();
    let mut commented = false;
    // The previous atom was a non-empty parameter list before `->`.
    let mut previous_params = false;
    // The member chain being built on `line` (`out.rows.push(..)`).
    let mut chain = new_chain();
    // A short `if c { a } else { b }` laid out on `line` as one group: the
    // index of its last `}` (NONE: none is open), and where its docs and
    // breaks start on `line`.
    let mut short_close = NONE;
    let mut short_docs: u64 = 0;
    let mut short_breaks: u64 = 0;
    loop {
        if pos >= n {
            break;
        }
        let c = akind(in at, pos);
        if end != NO_END && c == end {
            break;
        }
        // An `if` used as a value (`let x = if ..`, an argument, a match
        // arm, a block's last expression), as rustfmt decides.
        let starts_short_if = short_close == NONE && c == K_IF && !(has_prev && prev == K_ELSE);
        // An `if` that starts a statement is a value only as its block's last
        // expression.
        let starts_statement = block
            && (
                !has_prev
                    || previous_block
                    || prev == K_SEMI
                    || prev == K_COMMENT
                    || prev == K_BLOCK_COMMENT
            );
        let short_if_close = if starts_short_if {
            let close = short_if_else(in at, pos, end, in src);
            let next = wrapping_add(close, 1);
            if close == NONE
                || !starts_statement
                || next >= n
                || end != NO_END && akind(in at, next) == end {
                close
            } else {
                NONE
            }
        } else {
            NONE
        };
        let f = aflags(in at, pos);
        let blank = f & 1 != 0;
        let glued = f & 2 != 0;
        let in_expr = f & 4 != 0;
        // `{` after `.` or `::` opens a list, not a block: a tagged literal or
        // a `use` group (`use a::{b, c};`), which stays on one line when it fits.
        let opens_block = c == K_L_BRACE && (!has_prev || (prev != K_DOT && prev != K_COLON_COLON));
        // A struct literal or pattern (`Point { x: 1, y: 2 }`) is a list
        // too, spaced inside its braces.
        let is_record = opens_block && in_expr && !head && has_prev && prev == K_UPPER;
        let is_block = opens_block && !is_record;
        // A branch of a short `if` breaks only with the whole `if`.
        let soft_block = is_block && short_close != NONE;
        let cs0 = w32(in at.start, pos);
        let ce0 = w32(in at.end, pos);
        if c == K_IF
            || c == K_MATCH
            || c == K_LOWER
                && (
                    text_is(in src, cs0, ce0, in "for".as_bytes())
                        || text_is(in src, cs0, ce0, in "while".as_bytes())
                ) {
            head = true;
        } else if c == K_L_BRACE || c == K_SEMI {
            head = false;
        }
        package = glued
            && has_prev
            && (
                prev == K_AT && c == K_LOWER
                    || package && (c == K_LOWER || c == K_MINUS || c == K_SLASH || c == K_INT)
            );
        let sugar = match at.sgap.try_get(pos) {
            Option::Some(g) => g,
            Option::None => SGAP_NONE,
        };
        let spacing = if !has_prev {
            G_NONE
        } else if sugar != SGAP_NONE {
            sugar
        } else if previous_unary || package {
            G_NONE
        } else if list && has_prev && prev == K_SEMI {
            G_SOFT
        } else if has_prev {
            let g = gap(prev, c, block, previous_block);
            // A return type follows its parameter list on the same line, as
            // in rustfmt: the list breaks first (`) -> T {`).
            if g == G_RETURN && previous_params {
                G_SOFT
            } else {
                g
            }
        } else {
            G_NONE
        };
        // Anything but an attached token ends the operand and its chain.
        if is_block || spacing != G_NONE && spacing != G_EMPTY {
            chain_finish(inout chain, inout line, inout breaks, indent, inout d);
        }
        let after_comma = has_prev && prev == K_COMMA;
        let near_comment = c == K_COMMENT
            || c == K_BLOCK_COMMENT
            || has_prev && prev == K_BLOCK_COMMENT;
        if c == K_COMMENT || c == K_BLOCK_COMMENT {
            commented = true;
        }
        if spacing == G_HARD {
            concat_group(inout line, inout breaks, inout d, inout output);
            if blank {
                output.push(wrapping_u32(push_leaf(inout d, D_NEWLINE)));
            }
            output.push(wrapping_u32(push_leaf(inout d, D_HARD)));
        } else if spacing == G_SOFT && list && after_comma {
            concat_group(inout line, inout breaks, inout d, inout output);
            separators.push(wrapping_u32(output.len()));
            output.push(wrapping_u32(push_leaf(inout d, D_SOFT_SPACE)));
        } else if spacing == G_SOFT && !is_block && near_comment {
            line.push(wrapping_u32(push_leaf(inout d, D_SOFT_SPACE)));
        } else if (spacing == G_SOFT || spacing == G_SPACE) && (!is_block || soft_block) {
            line.push(wrapping_u32(push_leaf(inout d, D_SPACE)));
        } else if spacing == G_RETURN {
            concat_group(inout line, inout breaks, inout d, inout output);
            let lead = push_leaf(inout d, D_SOFT_SPACE);
            breaks.push(LayoutBreak { offset: line.len(), level: 1 });
            line.push(wrapping_u32(lead));
        } else if spacing == G_EMPTY || spacing == G_OPERATOR {
            let lead = push_leaf(
                inout d,
                if spacing == G_EMPTY {
                    D_SOFT_EMPTY
                } else {
                    D_SOFT_SPACE
                }
            );
            let level: u8 = if spacing == G_EMPTY {
                12
            } else if sugar == G_OPERATOR {
                match at.slevel.try_get(pos) {
                    Option::Some(l) => l,
                    Option::None => 0,
                }
            } else {
                infix_precedence(c)
            };
            breaks.push(LayoutBreak { offset: line.len(), level: level });
            line.push(wrapping_u32(lead));
            if spacing == G_EMPTY {
                chain_dot(inout chain, wrapping_sub(breaks.len(), 1));
            }
        }
        if is_block && !soft_block {
            concat_group(inout line, inout breaks, inout d, inout output);
            if spacing == G_SOFT || spacing == G_SPACE {
                output.push(wrapping_u32(push_leaf(inout d, D_SPACE)));
            }
        }
        if short_if_close != NONE {
            short_close = short_if_close;
            short_docs = line.len();
            short_breaks = breaks.len();
        }
        let cs = w32(in at.start, pos);
        let ce = w32(in at.end, pos);
        pos = wrapping_add(pos, 1);
        let mut params = false;
        let node = if c == K_L_PAREN || c == K_L_BRACKET || c == K_L_BRACE {
            let close = close_of(c);
            let empty = pos < n && akind(in at, pos) == close;
            let start = push_text(inout d, in src, cs, ce, false);
            let fill = c == K_L_BRACE && has_prev && prev == K_COLON_COLON;
            let inner = sequence(
                in at,
                inout pos,
                close,
                is_block,
                fill,
                cadd(indent, 4),
                inout d,
                in src
            );
            let last_is_line_comment = pos > 0 && akind(in at, wrapping_sub(pos, 1)) == K_COMMENT;
            let mut before_close = pos;
            loop {
                if before_close == 0 {
                    break;
                }
                let last = akind(in at, wrapping_sub(before_close, 1));
                if last != K_COMMENT && last != K_BLOCK_COMMENT {
                    break;
                }
                before_close = wrapping_sub(before_close, 1);
            }
            let trailing_comma = !is_block
                && before_close > 0
                && akind(in at, wrapping_sub(before_close, 1)) == K_COMMA;
            if !(pos < n && akind(in at, pos) == close) {
                fail(E_CONSERVATION);
            }
            let fs = w32(in at.start, pos);
            let fe = w32(in at.end, pos);
            pos = wrapping_add(pos, 1);
            let finish = push_text(inout d, in src, fs, fe, false);
            params = c == K_L_PAREN && !empty && pos < n && akind(in at, pos) == K_ARROW;
            if empty {
                concat4(inout d, start, finish, 4294967295, 4294967295)
            } else {
                let lead = push_leaf(
                    inout d,
                    if soft_block {
                        D_SOFT_SPACE
                    } else if is_block || trailing_comma {
                        D_HARD
                    } else if is_record {
                        D_SOFT_SPACE
                    } else {
                        D_SOFT_EMPTY
                    }
                );
                let content = concat4(inout d, lead, inner, 4294967295, 4294967295);
                let nest = push_nest(inout d, 4, content);
                let trail = push_leaf(
                    inout d,
                    if soft_block {
                        D_SOFT_SPACE
                    } else if is_block || last_is_line_comment || trailing_comma {
                        D_HARD
                    } else if is_record {
                        D_SOFT_SPACE
                    } else {
                        D_SOFT_EMPTY
                    }
                );
                let all = concat4(inout d, start, nest, trail, finish);
                // A parameter list before `->` shares its line's group, so it
                // breaks whenever the signature with its return type cannot
                // fit on one line; a short `if`'s branch shares the `if`'s.
                if params || soft_block {
                    all
                } else {
                    push_group(inout d, all)
                }
            }
        } else {
            push_text(inout d, in src, cs, ce, c == K_COMMENT || c == K_BLOCK_COMMENT)
        };
        if is_block && !soft_block {
            output.push(wrapping_u32(node));
        } else {
            line.push(wrapping_u32(node));
            chain_push(inout chain, width_at(in d, node), c == K_L_PAREN, c);
        }
        // The short `if` ends: it becomes one group that breaks like any
        // other `if`, with the breaks in its condition kept on one line.
        if short_close != NONE && pos > short_close {
            short_close = NONE;
            // Unless the line broke inside the `if`, which `short_if_else`
            // rules out, leaving nothing to group.
            if short_docs <= line.len() && short_breaks <= breaks.len() {
                for i in short_breaks..breaks.len() {
                    let b = break_at(in breaks, i);
                    let glue = push_leaf(inout d, if b.level == 12 { D_NIL } else { D_SPACE });
                    let _ = line.try_set(b.offset, wrapping_u32(glue));
                }
                breaks.truncate(short_breaks);
                let inner = push_concat_range(inout d, in line.as_slice(), short_docs, line.len());
                line.truncate(short_docs);
                line.push(wrapping_u32(push_group(inout d, inner)));
            }
        }
        previous_block = is_block;
        previous_params = params;
        previous_unary = (c == K_MINUS || c == K_BANG || c == K_TILDE) && !previous_ends_operand;
        let used_as_name = word_used_as_name(has_prev, prev, c, akind(in at, pos));
        has_prev = true;
        prev = if c == K_L_PAREN || c == K_L_BRACKET || c == K_L_BRACE {
            close_of(c)
        } else if used_as_name {
            // A contextual keyword used as a name spaces like one.
            K_LOWER
        } else {
            c
        };
        if prev != K_COMMENT && prev != K_BLOCK_COMMENT {
            previous_ends_operand = ends_operand(prev);
        }
    }
    chain_finish(inout chain, inout line, inout breaks, indent, inout d);
    concat_group(inout line, inout breaks, inout d, inout output);
    if fill && !commented && has_prev && prev != K_COMMA && separators.len() != 0 {
        let mut filled = ChunkSeq::new[u32]();
        let first = u32_at(in separators, 0);
        for i in 0..first {
            filled.push(wrapping_u32(u32_at(in output, i)));
        }
        for i in 0..separators.len() {
            let from = u32_at(in separators, i);
            let to = if wrapping_add(i, 1) < separators.len() {
                u32_at(in separators, wrapping_add(i, 1))
            } else {
                output.len()
            };
            let item = push_concat_range(inout d, in output.as_slice(), from, to);
            filled.push(wrapping_u32(push_group(inout d, item)));
        }
        return push_concat(inout d, in filled.as_slice());
    }
    push_concat(inout d, in output.as_slice())
}

// ---------------------------------------------------------------- entry points

// The significant tokens of a parsed token table, with the blank-line and
// glued flags the layout reads.
// Per token of `t`, 1 when its CST parent (from the parser's events `ev`)
// is an expression or pattern node: a token index, a node start (2^31 +
// kind) or a node finish (2^32 - 1).
fn expr_parents(in ev: ChunkSeq[u32], n: u64) -> ChunkSeq[u8] {
    let mut out = ChunkSeq::with_capacity[u8](wrapping_add(n, 1));
    for _ in 0..n {
        out.push(0);
    }
    let mut stack = ChunkSeq::new[u32]();
    for i in 0..ev.len() {
        let e = u32_at(in ev, i);
        if e == EV_FINISH {
            let depth = stack.len();
            if depth > 0 {
                stack.truncate(wrapping_sub(depth, 1));
            }
        } else if e >= EV_START_BASE {
            stack.push(wrapping_u32(wrapping_sub(e, EV_START_BASE)));
        } else {
            let depth = stack.len();
            if depth > 0 {
                let parent = u32_at(in stack, wrapping_sub(depth, 1));
                if parent == NODE_EXPR || parent == NODE_PATTERN {
                    out.try_set(e, 1);
                }
            }
        }
    }
    out
}

fn atoms(in src: Slice[u8], in t: Tokens, in ev: ChunkSeq[u32]) -> Atoms {
    let n = t.kind.len();
    let parents = expr_parents(in ev, n);
    let cap = wrapping_add(wrapping_shr_u64(n, 1), 1);
    let mut a = Atoms {
        kind: ChunkSeq::with_capacity[u8](cap),
        start: ChunkSeq::with_capacity[u32](cap),
        end: ChunkSeq::with_capacity[u32](cap),
        flags: ChunkSeq::with_capacity[u8](cap),
        raw: ChunkSeq::with_capacity[u32](cap),
        sgap: ChunkSeq::new[u8](),
        slevel: ChunkSeq::new[u8]()
    };
    let mut blank = false;
    let mut glued = false;
    for i in 0..n {
        let k = tok_kind(in t, i);
        if k == K_EOF {
            continue;
        }
        let s = tok_start(in t, i);
        let e = tok_end(in t, i);
        if k == K_WHITESPACE {
            if !blank {
                let mut lines: u64 = 0;
                let mut j = s;
                loop {
                    if j >= e || lines >= 2 {
                        break;
                    }
                    match src[j..e].find_byte(10) {
                        Option::Some(at) => {
                            lines = wrapping_add(lines, 1);
                            j = wrapping_add(wrapping_add(j, at), 1);
                        },
                        Option::None => {
                            j = e;
                        },
                    }
                }
                blank = lines >= 2;
            }
            glued = false;
        } else {
            let mut f: u8 = 0;
            if blank {
                f = f | 1;
            }
            if glued {
                f = f | 2;
            }
            let parent = match parents.try_get(i) {
                Option::Some(v) => v,
                Option::None => 0,
            };
            if parent != 0 {
                f = f | 4;
            }
            a.kind.push(k);
            a.start.push(wrapping_u32(s));
            a.end.push(wrapping_u32(e));
            a.flags.push(f);
            a.raw.push(wrapping_u32(i));
            blank = false;
            glued = true;
        }
    }
    a
}

// Whether two gated sources have the same significant tokens (kinds and
// texts).
fn same_pieces(in a: Slice[u8], in ta: Tokens, in b: Slice[u8], in tb: Tokens) -> bool {
    let na = ta.kind.len();
    let nb = tb.kind.len();
    let mut i: u64 = 0;
    let mut j: u64 = 0;
    loop {
        loop {
            if i >= na {
                break;
            }
            let k = tok_kind(in ta, i);
            if k != K_WHITESPACE && k != K_EOF {
                break;
            }
            i = wrapping_add(i, 1);
        }
        loop {
            if j >= nb {
                break;
            }
            let k = tok_kind(in tb, j);
            if k != K_WHITESPACE && k != K_EOF {
                break;
            }
            j = wrapping_add(j, 1);
        }
        if i >= na || j >= nb {
            return i >= na && j >= nb;
        }
        if tok_kind(in ta, i) != tok_kind(in tb, j) {
            return false;
        }
        let s = tok_start(in ta, i);
        let e = tok_end(in ta, i);
        let s2 = tok_start(in tb, j);
        let e2 = tok_end(in tb, j);
        if wrapping_sub(e, s) != wrapping_sub(e2, s2) {
            return false;
        }
        for x in 0..wrapping_sub(e, s) {
            if byte(in a, wrapping_add(s, x)) != byte(in b, wrapping_add(s2, x)) {
                return false;
            }
        }
        i = wrapping_add(i, 1);
        j = wrapping_add(j, 1);
    }
}

// ---------------------------------------------------------------- surface

// crates/vesper-fmt/src/surface.rs and sugar_layout.rs: sources the core
// parser refuses (sugar declarations, phrases, operators, tagged literals)
// or whose test blocks its batch mode skips are laid out over the surface
// CST, with the sugar layout's gaps.

fn is_comment(k: u8) -> bool {
    k == K_COMMENT || k == K_BLOCK_COMMENT
}

// `surface::may_have_test_block`: `test` followed (after whitespace) by `{`,
// `//` or `/*` somewhere in the text.
fn may_have_test_block(in src: Slice[u8]) -> bool {
    let n = src.len();
    if n < 4 {
        return false;
    }
    for i in 0..wrapping_sub(n, 3) {
        if byte(in src, i) == 116
            && byte(in src, wrapping_add(i, 1)) == 101
            && byte(in src, wrapping_add(i, 2)) == 115
            && byte(in src, wrapping_add(i, 3)) == 116 {
            let mut j = wrapping_add(i, 4);
            loop {
                if j >= n {
                    break;
                }
                let b = byte(in src, j);
                // `str::trim_start`: ASCII whitespace here (other Unicode
                // white space cannot precede `{` in a token stream the
                // lexer accepts anyway).
                if b != 32 && b != 9 && b != 10 && b != 13 && b != 11 && b != 12 {
                    break;
                }
                j = wrapping_add(j, 1);
            }
            if j < n {
                let b = byte(in src, j);
                if b == 123 {
                    return true;
                }
                if b == 47 && wrapping_add(j, 1) < n {
                    let c = byte(in src, wrapping_add(j, 1));
                    if c == 47 || c == 42 {
                        return true;
                    }
                }
            }
        }
    }
    false
}

// `surface::contains_test_block`: a `test` name token followed, past
// trivia, by `{`.
fn contains_test_block(in src: Slice[u8], in t: Tokens) -> bool {
    let mut after_test = false;
    for i in 0..t.kind.len() {
        let k = tok_kind(in t, i);
        if trivia(k) {
            continue;
        }
        if after_test && k == K_L_BRACE {
            return true;
        }
        after_test = k == K_LOWER
            && text_is(in src, tok_start(in t, i), tok_end(in t, i), in "test".as_bytes());
    }
    false
}

fn has_kind(in t: Tokens, k: u8) -> bool {
    for i in 0..t.kind.len() {
        if tok_kind(in t, i) == k {
            return true;
        }
    }
    false
}

// The profile's nodes (`Profile::nodes`): each sugar or expression macro
// node of the CST in preorder as three words, its kind and the ordinals
// of the significant tokens where it starts and ends.
fn surface_nodes(in ev: ChunkSeq[u32], in t: Tokens) -> ChunkSeq[u64] {
    let mut out = ChunkSeq::new[u64]();
    // Per open node: the index of its row in `out`, or NONE.
    let mut open = ChunkSeq::new[u64]();
    let mut seen: u64 = 0;
    for i in 0..ev.len() {
        let e = u32_at(in ev, i);
        if e == EV_FINISH {
            let depth = open.len();
            if depth > 0 {
                let row = match open.try_get(wrapping_sub(depth, 1)) {
                    Option::Some(r) => r,
                    Option::None => NONE,
                };
                open.truncate(wrapping_sub(depth, 1));
                if row != NONE {
                    out.try_set(wrapping_add(row, 2), seen);
                }
            }
        } else if e >= EV_START_BASE {
            let kind = wrapping_sub(e, EV_START_BASE);
            let tracked = (kind >= NODE_SUGAR_ITEM && kind <= NODE_SUGAR_PAT)
                || (kind >= NODE_SUGAR_OPERATOR && kind <= NODE_SURFACE_MACRO_ARG);
            if tracked {
                open.push(out.len());
                out.push(kind);
                out.push(seen);
                out.push(seen);
            } else {
                open.push(NONE);
            }
        } else {
            let k = tok_kind(in t, e);
            if k != K_WHITESPACE && k != K_EOF {
                seen = wrapping_add(seen, 1);
            }
        }
    }
    out
}

// Whether `nodes` holds a sugar node (`parser::is_sugar_node`).
fn has_sugar(in nodes: ChunkSeq[u64]) -> bool {
    let mut i: u64 = 0;
    loop {
        if i >= nodes.len() {
            break;
        }
        let k = match nodes.try_get(i) {
            Option::Some(k) => k,
            Option::None => 0,
        };
        if k < NODE_SURFACE_MACRO_DECL {
            return true;
        }
        i = wrapping_add(i, 3);
    }
    false
}

fn same_words(in a: ChunkSeq[u64], in b: ChunkSeq[u64]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for i in 0..a.len() {
        if a.try_get(i) != b.try_get(i) {
            return false;
        }
    }
    true
}

// `Layout::previous_code`: the last atom before `i` that is not a comment.
fn previous_code(in at: Atoms, i: u64) -> u64 {
    let mut p = i;
    loop {
        if p == 0 {
            return NONE;
        }
        p = wrapping_sub(p, 1);
        if !is_comment(akind(in at, p)) {
            return p;
        }
    }
}

fn set_gap(inout at: Atoms, i: u64, gap: u8, level: u8) {
    at.sgap.try_set(i, gap);
    at.slevel.try_set(i, level);
}

// `Layout::join`: a same-line boundary that never swallows a line comment.
fn join(inout at: Atoms, i: u64, gap: u8) {
    if i > 0 && i < at.kind.len() && akind(in at, wrapping_sub(i, 1)) != K_COMMENT {
        set_gap(inout at, i, gap, 0);
    }
}

fn join_level(inout at: Atoms, i: u64, gap: u8, level: u8) {
    if i > 0 && i < at.kind.len() && akind(in at, wrapping_sub(i, 1)) != K_COMMENT {
        set_gap(inout at, i, gap, level);
    }
}

// `Layout::clause_boundary`.
fn clause_boundary(inout at: Atoms, in src: Slice[u8], i: u64) {
    let brace = previous_code(in at, i);
    if brace == NONE || akind(in at, brace) != K_R_BRACE {
        return;
    }
    let a = w32(in at.end, brace);
    let b = w32(in at.start, i);
    let mut newline = false;
    let mut x = a;
    loop {
        if x >= b {
            break;
        }
        let c = byte(in src, x);
        if c == 10 || c == 13 {
            newline = true;
            break;
        }
        x = wrapping_add(x, 1);
    }
    if newline {
        set_gap(inout at, i, G_HARD, 0);
    } else {
        // A comment between the brace and head belongs on this line too.
        let mut j = wrapping_add(brace, 1);
        loop {
            if j > i {
                break;
            }
            join(inout at, j, G_SPACE);
            j = wrapping_add(j, 1);
        }
    }
}

// `Layout::operator`: the atom after the operator, or NONE.
fn sugar_operator(inout at: Atoms, in p: P, i: u64) -> u64 {
    let raw = w32(in at.raw, i);
    let (tier, raw_end) = sugar_operator_at(in p, raw);
    if tier == 0 {
        return NONE;
    }
    // Operators cannot contain trivia, so their raw and atom lengths agree.
    let end = wrapping_add(i, wrapping_sub(raw_end, raw));
    let quoted = i > 0 && akind(in at, wrapping_sub(i, 1)) == K_BACKTICK;
    if quoted {
        join(inout at, i, G_NONE);
    } else {
        join_level(inout at, i, G_OPERATOR, wrapping_u8(tier / 2));
    }
    let mut j = wrapping_add(i, 1);
    loop {
        if j >= end {
            break;
        }
        join(inout at, j, G_NONE);
        j = wrapping_add(j, 1);
    }
    if end < at.kind.len() {
        let next = akind(in at, end);
        if quoted && next == K_BACKTICK {
            join(inout at, end, G_NONE);
        } else if !is_comment(next) {
            join(inout at, end, G_SPACE);
        }
    }
    end
}

fn ascii_punctuation(in src: Slice[u8], s: u64, e: u64) -> bool {
    let mut x = s;
    loop {
        if x >= e {
            return true;
        }
        let b = byte(in src, x);
        let punct = (b >= 33 && b <= 47)
            || (b >= 58 && b <= 64)
            || (b >= 91 && b <= 96)
            || (b >= 123 && b <= 126);
        if !punct {
            return false;
        }
        x = wrapping_add(x, 1);
    }
}

// `Layout::group`: the contents of an unexpanded group keep their lexical
// tags, operator glyphs and clause boundaries.
fn sugar_group(inout at: Atoms, in p: P, in src: Slice[u8], start: u64, end: u64) {
    let mut parens = ChunkSeq::new[bool]();
    let mut i = start;
    loop {
        if i >= end {
            break;
        }
        let k = akind(in at, i);
        let has_prev = i > 0;
        let prev = if has_prev {
            akind(in at, wrapping_sub(i, 1))
        } else {
            K_EOF
        };
        if k == K_DOT || k == K_PIPE {
            let after = sugar_operator(inout at, in p, i);
            if after != NONE {
                i = after;
                continue;
            }
            // Introducing adjacency here could create a new operator.
            let next = wrapping_add(i, 1);
            if next < at.kind.len() {
                let nk = akind(in at, next);
                let glued = aflags(in at, next) & 2 != 0;
                if !glued && !is_comment(nk) && nk != K_LOWER && nk != K_UPPER && nk != K_L_BRACE {
                    join(inout at, next, G_SPACE);
                }
            }
        } else if (k == K_L_BRACE || k == K_STRING)
            && i > start
            && (
                prev == K_LOWER
                    || prev == K_STATE
                    || prev == K_WITH
                    || prev == K_EFF
                    || prev == K_LINEAR
            ) {
            let gap = if aflags(in at, i) & 2 != 0 {
                G_NONE
            } else {
                G_SPACE
            };
            join(inout at, i, gap);
        } else if k == K_LOWER || k == K_ELSE {
            clause_boundary(inout at, in src, i);
        } else if k == K_L_PAREN {
            // Template repetitions are token trees too. Keep their
            // separator and quantifier with the matching `$(...)`.
            let pc = previous_code(in at, i);
            parens.push(pc != NONE && akind(in at, pc) == K_DOLLAR);
        } else if k == K_R_PAREN {
            let depth = parens.len();
            let repeat = if depth == 0 {
                false
            } else {
                let top = match parens.try_get(wrapping_sub(depth, 1)) {
                    Option::Some(b) => b,
                    Option::None => false,
                };
                parens.truncate(wrapping_sub(depth, 1));
                top
            };
            if repeat {
                let a1 = wrapping_add(i, 1);
                let a2 = wrapping_add(i, 2);
                let k1 = if a1 < end { akind(in at, a1) } else { K_EOF };
                let k2 = if a2 < end { akind(in at, a2) } else { K_EOF };
                if a1 < end && (k1 == K_STAR || k1 == K_PLUS) {
                    join(inout at, a1, G_NONE);
                } else if a2 < end
                    && ascii_punctuation(in src, w32(in at.start, a1), w32(in at.end, a1))
                    && (k2 == K_STAR || k2 == K_PLUS) {
                    join(inout at, a1, G_NONE);
                    join(inout at, a2, G_NONE);
                }
            }
        }
        i = wrapping_add(i, 1);
    }
}

fn node_word(in nodes: ChunkSeq[u64], i: u64) -> u64 {
    match nodes.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

// `sugar_layout::annotate`.
fn annotate(inout at: Atoms, in p: P, in src: Slice[u8], in nodes: ChunkSeq[u64]) {
    let n = at.kind.len();
    for _ in 0..n {
        at.sgap.push(SGAP_NONE);
        at.slevel.push(0);
    }
    let mut covered: u64 = 0;
    let mut r: u64 = 0;
    loop {
        if r >= nodes.len() {
            break;
        }
        let kind = node_word(in nodes, r);
        let start = node_word(in nodes, wrapping_add(r, 1));
        let end = node_word(in nodes, wrapping_add(r, 2));
        r = wrapping_add(r, 3);
        if start >= end {
            continue;
        }
        if kind == NODE_TAGGED_LITERAL {
            join(inout at, wrapping_add(start, 1), G_NONE);
        } else if kind == NODE_SUGAR_OPERATOR {
            let _ = sugar_operator(inout at, in p, start);
        } else if kind == NODE_SUGAR_CONTINUATION {
            clause_boundary(inout at, in src, start);
        } else if kind == NODE_SUGAR_STMT || kind == NODE_SUGAR_ITEM {
            let pc = previous_code(in at, start);
            if pc != NONE && akind(in at, pc) == K_R_BRACE {
                set_gap(inout at, start, G_HARD, 0);
            }
        } else if kind == NODE_SUGAR_HOLE {
            // In a typed hole the sort is the final token: `$name:sort`.
            if akind(in at, wrapping_sub(end, 1)) == K_LOWER
                && end >= 2
                && akind(in at, wrapping_sub(end, 2)) == K_COLON {
                join(inout at, wrapping_sub(end, 1), G_NONE);
            }
        } else if kind == NODE_SUGAR_DECL {
            if akind(in at, start) == K_AT {
                let mut i = wrapping_add(start, 1);
                loop {
                    if i >= end {
                        break;
                    }
                    let s = w32(in at.start, i);
                    let e = w32(in at.end, i);
                    if text_is(in src, s, e, in "pub".as_bytes())
                        || text_is(in src, s, e, in "sugar".as_bytes()) {
                        set_gap(inout at, i, G_HARD, 0);
                        break;
                    }
                    i = wrapping_add(i, 1);
                }
            }
        } else if kind == NODE_SUGAR_PATTERN
            || kind == NODE_SUGAR_TEMPLATE
            || kind == NODE_SUGAR_GROUP {
            if kind == NODE_SUGAR_PATTERN {
                join(inout at, start, G_SPACE);
            }
            // CST ranges are in preorder; the outer scan includes nested groups.
            if start >= covered {
                sugar_group(inout at, in p, in src, start, end);
                covered = end;
            }
        }
    }
}

// What one formatting pass produced: the text, the profile's nodes, and
// the document and its root after the render (what `once` projects for a
// proof capture).
struct Pass {
    out: ChunkSeq[u8],
    nodes: ChunkSeq[u64],
    doc: Doc,
    root: u64
}

// Lay out and render the parse `p` of `src`.
fn layout(
    in src: Slice[u8],
    in p: P,
    sink nodes: ChunkSeq[u64],
    in lim: Limits,
    inout w: Work
) -> Pass eff [Fail[FmtFail]] {
    let mut at = atoms(in src, in p.t, in p.ev);
    if nodes.len() != 0 {
        annotate(inout at, in p, in src, in nodes);
    }
    let mut dl = lim;
    dl.max_work = wrapping_sub(w.max, w.used);
    let mut d = doc_new(in dl, wrapping_add(wrapping_mul(at.kind.len(), 3), 8));
    let mut pos: u64 = 0;
    let root = sequence(in at, inout pos, 255, false, false, 0, inout d, in src);
    let end = push_leaf(inout d, D_HARD);
    let root = push_concat2(inout d, root, end);
    let out = render(inout d, in src, root);
    charge(inout w, d.w.used);
    charge(inout w, out.len());
    Pass { out: out, nodes: nodes, doc: d, root: root }
}

fn first_diag(in p: P) -> u64 {
    match p.d.start.try_get(0) {
        Option::Some(v) => widen_u64(v),
        Option::None => 0,
    }
}

// `once` without a capture: parse, lay out and render `src` (`surface::
// syntax` without the macro profile). `t` is the token table the gate
// accepted (lexed again by the caller when it has one already).
fn once_tokens(
    in src: Slice[u8],
    sink t: Tokens,
    in lim: Limits,
    inout w: Work
) -> Pass eff [Fail[FmtFail]] {
    let ntok = t.kind.len();
    // Ordinary modules use the compiler parser. Its batch mode skips the
    // contents of test blocks, so parse those in surface mode as well.
    let test_block = may_have_test_block(in src) && contains_test_block(in src, in t);
    let mut core_error = NONE;
    if !test_block {
        // `parse_with_limits(HARD_SOURCE_BYTES, HARD_TOKENS)`: the default
        // diagnostic limit and parse depth, over the core lexer's tokens
        // (the gate's, unless a backtick needs the core lexer's error).
        let p = if has_kind(in t, K_BACKTICK) {
            let mut d = diags_new();
            let ct = lex_with_limits(
                in src,
                inout d,
                HARD_SOURCE_BYTES,
                HARD_TOKENS,
                max_diagnostics()
            );
            if ct.rejected {
                fail(E_TOKEN);
            }
            parse_tokens(in src, ct, d, max_diagnostics(), hard_depth())
        } else {
            parse_tokens(in src, t, diags_new(), max_diagnostics(), hard_depth())
        };
        if p.d.code.len() == 0 {
            return layout(in src, in p, ChunkSeq::new[u64](), in lim, inout w);
        }
        core_error = first_diag(in p);
        charge(inout w, wrapping_mul(ntok, PARSE_UNITS_PER_TOKEN));
    }
    let mut d = diags_new();
    let st = lex_sugar_with_limits(
        in src,
        inout d,
        HARD_SOURCE_BYTES,
        HARD_TOKENS,
        max_diagnostics()
    );
    if st.rejected {
        fail(E_TOKEN);
    }
    let p = parse_surface_tokens(in src, st, d, max_diagnostics(), hard_depth(), true);
    if p.d.code.len() != 0 {
        if core_error != NONE {
            fail_at(core_error);
        }
        fail_at(first_diag(in p));
    }
    let nodes = surface_nodes(in p.ev, in p.t);
    if nodes.len() == 0 && core_error != NONE {
        fail_at(core_error);
    }
    layout(in src, in p, nodes, in lim, inout w)
}

// `format_source(source, limits)`: the canonical text, or the error.
pub fn format(
    in source: Str,
    max_input_bytes: u64,
    max_output_bytes: u64,
    max_tokens: u64,
    max_doc_nodes: u64,
    max_depth: u64,
    max_work: u64
) -> ChunkSeq[u8] eff [Fail[FmtFail]] {
    let src = source.as_bytes();
    if src.len() > max_input_bytes {
        fail(E_INPUT);
    }
    let lim = Limits {
        max_input_bytes: max_input_bytes,
        max_output_bytes: max_output_bytes,
        max_tokens: max_tokens,
        max_doc_nodes: max_doc_nodes,
        max_depth: max_depth,
        max_work: max_work
    };
    let mut w = Work { used: 0, max: max_work };
    let t = gate(in src, in lim, inout w);
    let first = once_tokens(in src, t, in lim, inout w);
    let first_nodes = first.nodes;
    let output = first.out;
    let ts = gate(in src, in lim, inout w);
    let to = gate(in output.as_slice(), in lim, inout w);
    if !same_pieces(in src, in ts, in output.as_slice(), in to) {
        fail(E_CONSERVATION);
    }
    let to2 = gate(in output.as_slice(), in lim, inout w);
    let again = once_tokens(in output.as_slice(), to2, in lim, inout w);
    let second = again.out;
    if second.len() != output.len() || !same_words(in first_nodes, in again.nodes) {
        fail(E_IDEMPOTENT);
    }
    for i in 0..output.len() {
        if byte(in second.as_slice(), i) != byte(in output.as_slice(), i) {
            fail(E_IDEMPOTENT);
        }
    }
    output
}

// The BLAKE3 digest of `data` (`blake3::hash`), through @vesper-std/hash-sys:
// `format_for_verification`'s source and output hashes.
pub fn blake3(in data: Str) -> Hash32 eff [Ffi[Blake3]] {
    let d = hash(in data.as_bytes());
    Hash32 { w0: d.w0, w1: d.w1, w2: d.w2, w3: d.w3 }
}

// A digest's 32 bytes as four little-endian words.
pub copy struct Hash32 {
    w0: u64,
    w1: u64,
    w2: u64,
    w3: u64
}

// ---------------------------------------------------------------- proof

// `format_for_verification` (crates/vesper-fmt/src/proof_source.rs) and the
// arena projection it captures (`proof_model::project`): format `source`
// under the source-proof limits and keep the first pass's document, read
// back as a bounded model, with the same limit errors in the same order.
//
// The model is the projection's `ModelDoc` tree in prefix order: one kind
// per node (the `D_` kinds; the formatter's own " " and "\n" are text), a
// word per node (a nest's spaces, a concatenation's child count, else 0)
// and, for text and comment nodes, their bytes in order.

// `ProofError` as a code; `resource` names a `Resource` limit (`R_`).
const P_NONE: u64 = 0;
const P_INVALID_LIMITS: u64 = 1;
const P_RESOURCE: u64 = 2;
const P_INVALID_DOCUMENT: u64 = 3;
const P_ALLOCATION: u64 = 4;
// `Formatter(error)`: `fmt` is the error.
const P_FORMATTER: u64 = 5;
const P_CONSERVATION: u64 = 6;
const P_LEAN_SYNTAX: u64 = 7;

const R_ARITHMETIC: u64 = 0;
const R_WORK: u64 = 1;
const R_METADATA: u64 = 2;
const R_NODES: u64 = 3;
const R_DEPTH: u64 = 4;
const R_TEXT: u64 = 5;
const R_SOURCE_WORK: u64 = 6;

// `ProofLimits`.
pub copy struct ProofLimits {
    pub max_nodes: u64,
    pub max_text_bytes: u64,
    pub max_depth: u64,
    pub max_metadata_bytes: u64,
    pub max_lean_bytes: u64,
    pub max_work: u64
}

pub fn proof_limits_default() -> ProofLimits {
    ProofLimits {
        max_nodes: 4096,
        max_text_bytes: 131072,
        max_depth: 64,
        max_metadata_bytes: 1048576,
        max_lean_bytes: 1048576,
        max_work: 67108864
    }
}

// `ProofLimits::validate`: every limit from 1 to its `HARD` cap.
pub fn proof_limits_valid(in l: ProofLimits) -> bool {
    within(l.max_nodes, 16384)
        && within(l.max_text_bytes, 262144)
        && within(l.max_depth, 128)
        && within(l.max_metadata_bytes, 4194304)
        && within(l.max_lean_bytes, 2097152)
        && within(l.max_work, 268435456)
}

fn within(v: u64, cap: u64) -> bool {
    v != 0 && v <= cap
}

// A `ProofError`.
pub copy struct ProofFail {
    pub code: u64,
    pub resource: u64,
    pub fmt: FmtFail
}

pub fn no_proof_fail() -> ProofFail {
    ProofFail { code: P_NONE, resource: 0, fmt: FmtFail { code: 0, offset: 0 } }
}

fn proof_fail(code: u64) -> ProofFail {
    ProofFail { code: code, resource: 0, fmt: FmtFail { code: 0, offset: 0 } }
}

fn resource(r: u64) -> ProofFail {
    ProofFail { code: P_RESOURCE, resource: r, fmt: FmtFail { code: 0, offset: 0 } }
}

// `DocumentModel`: the prefix-order tree, its statistics and the comments.
// The fields are private, like Rust's: only `format_for_verification`
// builds a model, and readers get copies.
pub struct Model {
    kind: ChunkSeq[u8],
    arg: ChunkSeq[u64],
    // Text and comment payloads, in prefix order, and where each ends.
    text: ChunkSeq[u8],
    text_ends: ChunkSeq[u64],
    // Each comment's payload number.
    comment_text: ChunkSeq[u64],
    node_count: u64,
    text_bytes: u64,
    depth: u64,
    comments: u64
}

fn model_new() -> Model {
    Model {
        kind: ChunkSeq::new[u8](),
        arg: ChunkSeq::new[u64](),
        text: ChunkSeq::new[u8](),
        text_ends: ChunkSeq::new[u64](),
        comment_text: ChunkSeq::new[u64](),
        node_count: 0,
        text_bytes: 0,
        depth: 0,
        comments: 0
    }
}

// Rust's `size_of` for the projection's charges.
const SIZE_DOCUMENT_MODEL: u64 = 80;
const SIZE_FRAME: u64 = 40;
const SIZE_MODEL_DOC: u64 = 32;
const SIZE_STRING: u64 = 24;
const SIZE_TOKEN: u64 = 24;

// `Budget`.
copy struct Budget {
    remaining: u64,
    metadata: u64,
    max_metadata: u64
}

fn work(inout b: Budget, units: u64) -> bool {
    if units > b.remaining {
        return false;
    }
    b.remaining = wrapping_sub(b.remaining, units);
    true
}

// `Budget::metadata`: the error, or `P_NONE`.
fn metadata(inout b: Budget, bytes: u64) -> ProofFail {
    if b.metadata > wrapping_sub(U64_MAX, bytes) {
        return resource(R_ARITHMETIC);
    }
    b.metadata = wrapping_add(b.metadata, bytes);
    if b.metadata > b.max_metadata {
        return resource(R_METADATA);
    }
    if !work(inout b, bytes) {
        return resource(R_WORK);
    }
    no_proof_fail()
}

// `project(document, root, limits)`: `preflight`'s walk, building the
// prefix-order model as it enters each node (Rust builds it after the walk
// succeeds; it fails only on allocation after that, so the model is the
// same). The text of text and comment nodes is `src[a..b]`.
fn project(
    in d: Doc,
    root: u64,
    in src: Slice[u8],
    in l: ProofLimits,
    inout m: Model
) -> ProofFail {
    if !proof_limits_valid(in l) {
        return proof_fail(P_INVALID_LIMITS);
    }
    let mut b = Budget { remaining: l.max_work, metadata: 0, max_metadata: l.max_metadata_bytes };
    let f = metadata(inout b, SIZE_DOCUMENT_MODEL);
    if f.code != P_NONE {
        return f;
    }
    let f = metadata(inout b, wrapping_mul(l.max_depth, SIZE_FRAME));
    if f.code != P_NONE {
        return f;
    }
    // The stack: node, depth, next child.
    let mut s_id: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](l.max_depth);
    let mut s_depth: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](l.max_depth);
    let mut s_next: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](l.max_depth);
    s_id.push(root);
    s_depth.push(1);
    s_next.push(0);
    let mut build_work: u64 = 0;
    loop {
        let top = s_id.len();
        if top == 0 {
            break;
        }
        let t = wrapping_sub(top, 1);
        if !work(inout b, 1) {
            return resource(R_WORK);
        }
        let id = word(in s_id, t);
        let depth = word(in s_depth, t);
        let next = word(in s_next, t);
        let k = kind_at(in d, id);
        if next == 0 {
            // Entering (a leaf or a node before its first child).
            m.node_count = wrapping_add(m.node_count, 1);
            if m.node_count > l.max_nodes {
                return resource(R_NODES);
            }
            if depth > m.depth {
                m.depth = depth;
            }
            if m.depth > l.max_depth {
                return resource(R_DEPTH);
            }
            let f = metadata(inout b, SIZE_MODEL_DOC);
            if f.code != P_NONE {
                return f;
            }
            build_work = wrapping_add(build_work, wrapping_add(SIZE_MODEL_DOC, 4));
            let text = k == D_TEXT || k == D_COMMENT || k == D_SPACE || k == D_NEWLINE;
            let mut ta: u64 = 0;
            let mut tb: u64 = 0;
            if k == D_TEXT || k == D_COMMENT {
                ta = u32_at(in d.a, id);
                tb = u32_at(in d.b, id);
            }
            let len = if k == D_SPACE || k == D_NEWLINE {
                1
            } else {
                wrapping_sub(tb, ta)
            };
            if text {
                m.text_bytes = wrapping_add(m.text_bytes, len);
                if m.text_bytes > l.max_text_bytes {
                    return resource(R_TEXT);
                }
                let f = metadata(inout b, len);
                if f.code != P_NONE {
                    return f;
                }
                build_work = wrapping_add(build_work, len);
                if k == D_COMMENT {
                    m.comments = wrapping_add(m.comments, 1);
                    let f = metadata(inout b, wrapping_add(SIZE_STRING, len));
                    if f.code != P_NONE {
                        return f;
                    }
                    build_work = wrapping_add(build_work, wrapping_add(SIZE_STRING, len));
                }
            }
            // The model node.
            if k == D_SPACE {
                m.kind.push(D_TEXT);
                m.arg.push(0);
                m.text.push(32);
                m.text_ends.push(m.text.len());
            } else if k == D_NEWLINE {
                m.kind.push(D_TEXT);
                m.arg.push(0);
                m.text.push(10);
                m.text_ends.push(m.text.len());
            } else if text {
                if k == D_COMMENT {
                    m.comment_text.push(m.text_ends.len());
                }
                m.kind.push(k);
                m.arg.push(0);
                m.text.extend(in src[ta..tb]);
                m.text_ends.push(m.text.len());
            } else if k == D_NEST {
                m.kind.push(k);
                m.arg.push(u32_at(in d.a, id));
            } else if k == D_CONCAT {
                m.kind.push(k);
                m.arg.push(u32_at(in d.b, id));
            } else {
                m.kind.push(k);
                m.arg.push(0);
            }
        }
        // The next child, if any.
        let mut child = U64_MAX;
        if k == D_NEST && next == 0 {
            child = u32_at(in d.b, id);
        } else if k == D_GROUP && next == 0 {
            child = u32_at(in d.a, id);
        } else if k == D_CONCAT && next < u32_at(in d.b, id) {
            child = u32_at(in d.kids, wrapping_add(u32_at(in d.a, id), next));
        }
        if child != U64_MAX {
            let _ = s_next.try_set(t, wrapping_add(next, 1));
            let cd = wrapping_add(depth, 1);
            if cd > l.max_depth {
                return resource(R_DEPTH);
            }
            s_id.push(child);
            s_depth.push(cd);
            s_next.push(0);
        } else {
            let _ = s_id.pop();
            let _ = s_depth.pop();
            let _ = s_next.pop();
        }
    }
    if !work(inout b, build_work) {
        return resource(R_WORK);
    }
    no_proof_fail()
}

fn word(in s: ChunkSeq[u64], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

// What `format_for_verification` returns: the error, or the output, the
// two digests and the model.
pub struct Verified {
    fail: ProofFail,
    output: ChunkSeq[u8],
    changed: bool,
    source_hash: Hash32,
    output_hash: Hash32,
    model: Model
}

fn verified_fail(f: ProofFail) -> Verified {
    let z = Hash32 { w0: 0, w1: 0, w2: 0, w3: 0 };
    Verified {
        fail: f,
        output: ChunkSeq::new[u8](),
        changed: false,
        source_hash: z,
        output_hash: z,
        model: model_new()
    }
}

// `bounded_format_limits(Limits::default())`.
fn proof_format_limits() -> Limits {
    Limits {
        max_input_bytes: 131072,
        max_output_bytes: 262144,
        max_tokens: 8192,
        max_doc_nodes: 100000,
        max_depth: 24,
        max_work: 134217728
    }
}

// `format_with_capture` with a capture: `format`, projecting the first
// pass. A projection error comes back in the result; a formatter error is
// raised.
fn capture(
    in src: Slice[u8],
    in lim: Limits,
    inout w: Work,
    in pl: ProofLimits
) -> Verified eff [Fail[FmtFail]] {
    if src.len() > lim.max_input_bytes {
        fail(E_INPUT);
    }
    let t = gate(in src, in lim, inout w);
    let first = once_tokens(in src, t, in lim, inout w);
    let mut m = model_new();
    let f = project(in first.doc, first.root, in src, in pl, inout m);
    if f.code != P_NONE {
        return verified_fail(f);
    }
    let first_nodes = first.nodes;
    let output = first.out;
    let ts = gate(in src, in lim, inout w);
    let to = gate(in output.as_slice(), in lim, inout w);
    if !same_pieces(in src, in ts, in output.as_slice(), in to) {
        fail(E_CONSERVATION);
    }
    let to2 = gate(in output.as_slice(), in lim, inout w);
    let again = once_tokens(in output.as_slice(), to2, in lim, inout w);
    let second = again.out;
    if second.len() != output.len() || !same_words(in first_nodes, in again.nodes) {
        fail(E_IDEMPOTENT);
    }
    for i in 0..output.len() {
        if byte(in second.as_slice(), i) != byte(in output.as_slice(), i) {
            fail(E_IDEMPOTENT);
        }
    }
    let mut changed = src.len() != output.len();
    if !changed {
        for i in 0..src.len() {
            if byte(in src, i) != byte(in output.as_slice(), i) {
                changed = true;
                break;
            }
        }
    }
    // Pay for the source association before it runs.
    let assoc = wrapping_add(
        wrapping_add(wrapping_mul(src.len(), 8), wrapping_mul(lim.max_tokens, SIZE_TOKEN)),
        wrapping_add(wrapping_mul(output.len(), 2), wrapping_mul(m.text_bytes, 2))
    );
    charge(inout w, assoc);
    let z = Hash32 { w0: 0, w1: 0, w2: 0, w3: 0 };
    Verified {
        fail: no_proof_fail(),
        output: output,
        changed: changed,
        source_hash: z,
        output_hash: z,
        model: m
    }
}

// `format_for_verification(source, Limits::default(), ProofLimits::default())`.
pub fn format_for_verification(in source: Str) -> Verified eff [Ffi[Blake3]] {
    let pl = proof_limits_default();
    let lim = proof_format_limits();
    let src = source.as_bytes();
    let mut w = Work { used: 0, max: wrapping_add(lim.max_work, pl.max_work) };
    w.used = pl.max_work;
    let mut v = handle Fail[FmtFail] in {
        capture(in src, in lim, inout w, in pl)
    } with {
        return v => v,
        raise(e, _k) => verified_fail(ProofFail { code: P_FORMATTER, resource: 0, fmt: e }),
    };
    if v.fail.code != P_NONE {
        return v;
    }
    // The comments, in order, are the source's comment tokens.
    let mut d = diags_new();
    let t = lex_with_limits(in src, inout d, lim.max_input_bytes, lim.max_tokens, 1);
    if t.rejected || d.code.len() != 0 {
        return verified_fail(proof_fail(P_CONSERVATION));
    }
    let mut c: u64 = 0;
    let mut same = true;
    for i in 0..t.kind.len() {
        let k = match t.kind.try_get(i) {
            Option::Some(k) => k,
            Option::None => 0,
        };
        if k != 1 && k != 2 {
            continue;
        }
        let a = match t.start.try_get(i) {
            Option::Some(s) => widen_u64(s),
            Option::None => 0,
        };
        let e = token_end(in t, i);
        if !comment_is(in v.model, c, in src[a..e]) {
            same = false;
            break;
        }
        c = wrapping_add(c, 1);
    }
    if !same || c != v.model.comments {
        return verified_fail(proof_fail(P_CONSERVATION));
    }
    v.source_hash = blake3(in source);
    v.output_hash = hash_bytes(in v.output.as_slice());
    v
}

fn hash_bytes(in b: Slice[u8]) -> Hash32 eff [Ffi[Blake3]] {
    let d = hash(in b);
    Hash32 { w0: d.w0, w1: d.w1, w2: d.w2, w3: d.w3 }
}

// Whether the model's comment number `c` is `b`.
fn comment_is(in m: Model, c: u64, in b: Slice[u8]) -> bool {
    if c >= m.comment_text.len() {
        return false;
    }
    let t = word(in m.comment_text, c);
    let a = if t == 0 {
        0
    } else {
        word(in m.text_ends, wrapping_sub(t, 1))
    };
    let e = word(in m.text_ends, t);
    if wrapping_sub(e, a) != b.len() {
        return false;
    }
    for j in 0..b.len() {
        if byte(in m.text.as_slice(), wrapping_add(a, j)) != byte(in b, j) {
            return false;
        }
    }
    true
}

// Read-only views of a `Verified` (`FormatVerification`'s accessors): its
// error, output, digests and model, copied out, so no caller can pair a
// model or digest with text that was not formatted.
pub fn verified_error(in v: Verified) -> ProofFail {
    v.fail
}

pub fn verified_output(in v: Verified) -> ChunkSeq[u8] {
    copy_bytes(in v.output)
}

pub fn verified_changed(in v: Verified) -> bool {
    v.changed
}

pub fn verified_source_hash(in v: Verified) -> Hash32 {
    v.source_hash
}

pub fn verified_output_hash(in v: Verified) -> Hash32 {
    v.output_hash
}

// The model: kinds, words, payload bytes and ends in prefix order, then
// `node_count`, `text_bytes`, `depth` and `comments`.
pub fn model_kinds(in v: Verified) -> ChunkSeq[u8] {
    copy_bytes(in v.model.kind)
}

pub fn model_args(in v: Verified) -> ChunkSeq[u64] {
    copy_words(in v.model.arg)
}

pub fn model_text(in v: Verified) -> ChunkSeq[u8] {
    copy_bytes(in v.model.text)
}

pub fn model_text_ends(in v: Verified) -> ChunkSeq[u64] {
    copy_words(in v.model.text_ends)
}

pub fn model_node_count(in v: Verified) -> u64 {
    v.model.node_count
}

pub fn model_text_bytes(in v: Verified) -> u64 {
    v.model.text_bytes
}

pub fn model_depth(in v: Verified) -> u64 {
    v.model.depth
}

pub fn model_comments(in v: Verified) -> u64 {
    v.model.comments
}

fn copy_bytes(in s: ChunkSeq[u8]) -> ChunkSeq[u8] {
    let mut out: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](s.len());
    out.extend(in s.as_slice());
    out
}

fn copy_words(in s: ChunkSeq[u64]) -> ChunkSeq[u64] {
    let mut out: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](s.len());
    for i in 0..s.len() {
        out.push(word(in s, i));
    }
    out
}

// A formatter error's `Error` variant (the `E_` code) and syntax offset.
pub fn fail_code(f: FmtFail) -> u64 {
    f.code
}

pub fn fail_offset(f: FmtFail) -> u64 {
    f.offset
}

// A digest as 64 lower-case hex digits (`blake3::Hash::to_hex`).
pub fn hash_hex(h: Hash32) -> ChunkSeq[u8] {
    let mut out: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](64);
    hex_word(inout out, h.w0);
    hex_word(inout out, h.w1);
    hex_word(inout out, h.w2);
    hex_word(inout out, h.w3);
    out
}

// The eight bytes of `w`, least significant first, as hex.
fn hex_word(inout out: ChunkSeq[u8], w: u64) {
    let mut v = w;
    for _i in 0..8 {
        let b = v % 256;
        out.push(hex_digit(b / 16));
        out.push(hex_digit(b % 16));
        v = v / 256;
    }
}

fn hex_digit(n: u64) -> u8 {
    if n < 10 {
        wrapping_u8(wrapping_add(48, n))
    } else {
        wrapping_u8(wrapping_add(87, n))
    }
}
