load("//tools/bazel:defs.bzl", "vesper_crate")
load("//tools/bazel:vesper_port.bzl", "VESPER_TARGET", "vesper_package", "vesper_port_object")

# The Rust build is the default (default features, generated by vesper_crate
# below). The Vesper port (the Loom package in vesper/, Cargo feature
# `vesper-port`, self-hosting SH1 lane 11, #1154) is non-default until the
# compiler switches to it. The compiler links neither: it links the Rust seed
# copy, //crates/vesper-fmt/seed (seed-copy rule,
# docs/maintenance/porting-a-crate.md). The port's differential tests run in
# Cargo (port/test-port.sh, Linux port shard 7).
vesper_package(
    name = "port_package",
    srcs = glob(["vesper/src/**/*.ves"]),
    manifest = "vesper/Loom.toml",
    deps = [
        "//:front_package",
        "//:std_hash_package",
        "//:std_hash_sys_package",
    ],
)

vesper_port_object(
    name = "fmt_vesper",
    library = "fmt",
    package = ":port_package",
    rust_types = "crate::port",
    target = VESPER_TARGET,
)

filegroup(
    name = "fmt_vesper_binding",
    srcs = [":fmt_vesper"],
    output_group = "rust_binding",
)

# The divergent builds, one per ported area (the Cargo
# `vesper-port-divergent` feature applies the same edits from build.rs, one
# at a time with VESPER_FMT_DIVERGE): each must keep compiling, and
# port/test-port.sh asserts that the differential test catches it.
[
    vesper_port_object(
        name = "fmt_vesper_divergent_" + area,
        edit_src = "vesper/src/lib.ves",
        edits = {old: new},
        library = "fmt",
        package = ":port_package",
        rust_types = "crate::port",
        target = VESPER_TARGET,
    )
    for area, old, new in [
        (
            "doc",
            "const LINE_WIDTH: u64 = 100;",
            "const LINE_WIDTH: u64 = 99;",
        ),
        (
            "gate",
            "if k == K_SEMI || k == K_COMMA {\n            counter = 0;",
            "if k == K_SEMI {\n            counter = 0;",
        ),
        (
            "layout",
            "let trailing_comma = !is_block",
            "let trailing_comma = false",
        ),
    ]
]

# The build script links this object only under `vesper-port`; passing it
# keeps the port in this package's dependency graph.
vesper_crate(
    build_script_data = [
        ":fmt_vesper",
        ":fmt_vesper_binding",
    ],
    build_script_env = {
        # rules_rust already makes these execpaths absolute.
        "VESPER_PORT_OBJECT": "$(execpath :fmt_vesper)",
        "VESPER_PORT_GENERATED_BINDING": "$(execpath :fmt_vesper_binding)",
    },
    extra_compile_data = [
        "//:examples",
        "//:lean",
    ],
)

# The seed package (seed/) builds these same Rust sources without the port.
exports_files(glob([
    "src/**/*.rs",
    "tests/**/*.rs",
]))

filegroup(
    name = "rust_srcs",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//crates/vesper-fmt/seed:__pkg__"],
)
