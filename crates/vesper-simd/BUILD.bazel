load("//tools/bazel:defs.bzl", "vesper_crate")
load("//tools/bazel:vesper_port.bzl", "VESPER_TARGET", "vesper_package", "vesper_port_object")

# The Rust build is the default (default features, generated by
# vesper_crate below). The Vesper port of the scanner builder (the Loom
# package in vesper/, Cargo feature `vesper-port`, #1969) stays
# non-default until it is the only build. Its Cargo tests run in the
# Platforms Linux port shards (`aspect crate simd test-port`); here the
# objects are built so the port keeps compiling.
vesper_package(
    name = "port_package",
    srcs = glob(["vesper/src/**/*.ves"]),
    manifest = "vesper/Loom.toml",
    deps = ["//packages/vesper-cranelift:cranelift_package"],
)

vesper_port_object(
    name = "simd_vesper",
    library = "simd",
    package = ":port_package",
    target = VESPER_TARGET,
)

filegroup(
    name = "simd_vesper_binding",
    srcs = [":simd_vesper"],
    output_group = "rust_binding",
)

# The divergent build: the edit of `EDITS` in build.rs.
vesper_port_object(
    name = "simd_vesper_divergent",
    edit_src = "vesper/src/lib.ves",
    edits = {"let bit = ins_band_imm(inout b, bit, 1);": "let bit = ins_band_imm(inout b, bit, 3);"},
    library = "simd",
    package = ":port_package",
    target = VESPER_TARGET,
)

vesper_crate(
    # The build script links this object only under `vesper-port`; passing
    # it keeps the port in this package's dependency graph.
    build_script_data = [
        ":simd_vesper",
        ":simd_vesper_binding",
    ],
    build_script_env = {
        # rules_rust already makes these execpaths absolute.
        "VESPER_PORT_OBJECT": "$(execpath :simd_vesper)",
        "VESPER_PORT_GENERATED_BINDING": "$(execpath :simd_vesper_binding)",
    },
    # Lean resolves symlinked runfiles to the source tree and then rejects
    # them as outside --root, so these run in a copy of regular files.
    copy_test_cwd = ["test/model"],
    extra_test_data = ["//:lean"],
)
