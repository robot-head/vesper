    };
    l_init(inout c);
    c
}

// `parse_choreography`: `out` is `0 nroles roles.. tree..` or
// `1 line col kind payload..` (see parse.ves).
pub fn parse(in src: Str) -> C {
    let mut c = new_c();
    parse_src(inout c, in src.as_bytes());
    c
}

// `Choreography::new`: `out` is `0`, or `1` and the error words
// (tree.ves).
pub fn check_chor(in w: Slice[u64], in t: Slice[u8]) -> C {
    let mut c = new_c();
    let _ = read_chor(inout c, in w, in t, 0);
    let root = c.root;
    if validate(inout c, root) {
        c.out.push(0);
    } else {
        c.out.push(1);
        for i in 0..c.ew.len() {
            let x = match c.ew.try_get(i) {
                Option::Some(v) => v,
                Option::None => 0,
            };
            c.out.push(x);
        }
    }
    c
}

// `project_role` for role `role`, or `project_all` when `role` is
// `none()`: `out` is `0 n (len local..)*n` or `1` and the error words
// (project.ves).
pub fn project(in w: Slice[u64], in t: Slice[u8], role: u64) -> C {
    let mut c = new_c();
    let _ = read_chor(inout c, in w, in t, 0);
    let n = c.ro.len();
    let (lo, hi) = if role == none() {
        (0, n)
    } else {
        (role, inc(role))
    };
    let mut locals: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for r in lo..hi {
        let l = project_role(inout c, r);
        if c.failed {
            c.out.clear();
            c.out.push(1);
            for i in 0..c.ew.len() {
                let x = match c.ew.try_get(i) {
                    Option::Some(v) => v,
                    Option::None => 0,
                };
                c.out.push(x);
            }
            return c;
        }
        locals.push(l);
    }
    c.out.push(0);
    c.out.push(locals.len());
    for i in 0..locals.len() {
        let l = match locals.try_get(i) {
            Option::Some(v) => v,
            Option::None => 0,
        };
        let at = c.out.len();
        c.out.push(0);
        emit_l_into_out(inout c, l, at);
    }
    c
}

fn emit_l_into_out(inout c: C, l: u64, at: u64) {
    emit_l(inout c, l);
    let len = wrapping_sub(wrapping_sub(c.out.len(), at), 1);
    let _ = c.out.try_set(at, len);
}

// `check::explore` (locals projected here) when `nlocals` is `none()`,
// else `check::explore_locals` over the `nlocals` local types that follow
// the role list. `out` is `0 states completed cut` or `1` and the error
// words (explore.ves).
pub fn explore(in w: Slice[u64], in t: Slice[u8], nlocals: u64, max_states: u64, max_queue: u64)
    -> C {
    let mut c = new_c();
    let mut locals: ChunkSeq[u64] = ChunkSeq::new[u64]();
    if nlocals == none() {
        let _ = read_chor(inout c, in w, in t, 0);
        for r in 0..c.ro.len() {
            let l = project_role(inout c, r);
            if c.failed {
                c.out.push(1);
                c.out.push(1);
                for i in 0..c.ew.len() {
                    let x = match c.ew.try_get(i) {
                        Option::Some(v) => v,
                        Option::None => 0,
                    };
                    c.out.push(x);
                }
                return c;
            }
            locals.push(l);
        }
    } else {
        let mut at = read_roles(inout c, in w, in t, 0);
        for _ in 0..nlocals {
            let len = iw(in w, at);
            let l = read_local(inout c, in w, in t, inc(at), len);
            locals.push(l);
            at = wrapping_add(at, inc(len));
        }
    }
    explore_run(inout c, in locals, max_states, max_queue);
    c
}

// `are_dual(a, s_a, b, s_b)`: the words are `len s_a.. len s_b..`.
pub fn dual(in w: Slice[u64], in t: Slice[u8], a: u64, b: u64) -> bool {
    let mut c = new_c();
    let la = iw(in w, 0);
    let x = read_local(inout c, in w, in t, 1, la);
    let at = inc(la);
    let lb = iw(in w, at);
    let y = read_local(inout c, in w, in t, inc(at), lb);
    are_dual(inout c, a, x, b, y)
}
