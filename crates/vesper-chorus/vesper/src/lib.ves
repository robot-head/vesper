    sb: ChunkSeq[u64],
    tk_kind: ChunkSeq[u64],
    tk_sym: ChunkSeq[u64],
    tk_line: ChunkSeq[u64],
    tk_col: ChunkSeq[u64],
    sc_src: ChunkSeq[u64],
    sc_uni: ChunkSeq[u64],
    s_kind: ChunkSeq[u64],
    s_a: ChunkSeq[u64],
    s_b: ChunkSeq[u64],
    s_c: ChunkSeq[u64],
    s_d: ChunkSeq[u64],
    s_line: ChunkSeq[u64],
    s_col: ChunkSeq[u64],
