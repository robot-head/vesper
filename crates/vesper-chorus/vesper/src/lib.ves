fn new_c() -> C {
    let mut c = C {
        sy_off: ChunkSeq::new[u64](),
        sy_len: ChunkSeq::new[u64](),
        sy_hash: ChunkSeq::new[u64](),
        sy_ht: ChunkSeq::new[u64](),
        sy_flag: ChunkSeq::new[u64](),
        sy_txt: ChunkSeq::new[u8](),
        tb: ChunkSeq::new[u8](),
        ro: ChunkSeq::new[u64](),
        gt: ChunkSeq::new[u64](),
        ga: ChunkSeq::new[u64](),
        gb: ChunkSeq::new[u64](),
        gc: ChunkSeq::new[u64](),
        gsz: ChunkSeq::new[u64](),
        gks: ChunkSeq::new[u64](),
        gk: ChunkSeq::new[u64](),
        lt: ChunkSeq::new[u64](),
        la: ChunkSeq::new[u64](),
        lb: ChunkSeq::new[u64](),
        lc: ChunkSeq::new[u64](),
        ld: ChunkSeq::new[u64](),
        lks: ChunkSeq::new[u64](),
        lkn: ChunkSeq::new[u64](),
        lh: ChunkSeq::new[u64](),
        lht: ChunkSeq::new[u64](),
        lk: ChunkSeq::new[u64](),
        lu: ChunkSeq::new[u64](),
        tmp: ChunkSeq::new[u64](),
        vs: ChunkSeq::new[u64](),
        bnd: ChunkSeq::new[u64](),
        ugs: ChunkSeq::new[u64](),
        used: ChunkSeq::new[u64](),
        path: ChunkSeq::new[u64](),
        dbe: ChunkSeq::new[u64](),
        dvx: ChunkSeq::new[u64](),
        dvy: ChunkSeq::new[u64](),
        xw: ChunkSeq::new[u64](),
        xoff: ChunkSeq::new[u64](),
        xlen: ChunkSeq::new[u64](),
        xh: ChunkSeq::new[u64](),
        xht: ChunkSeq::new[u64](),
        work: ChunkSeq::new[u64](),
        nw: ChunkSeq::new[u64](),
        sb: ChunkSeq::new[u64](),
        tk_kind: ChunkSeq::new[u64](),
        tk_sym: ChunkSeq::new[u64](),
        tk_line: ChunkSeq::new[u64](),
        tk_col: ChunkSeq::new[u64](),
        sc_src: ChunkSeq::new[u64](),
        sc_uni: ChunkSeq::new[u64](),
        s_kind: ChunkSeq::new[u64](),
        s_a: ChunkSeq::new[u64](),
        s_b: ChunkSeq::new[u64](),
        s_c: ChunkSeq::new[u64](),
        s_d: ChunkSeq::new[u64](),
        s_line: ChunkSeq::new[u64](),
        s_col: ChunkSeq::new[u64](),
        sk: ChunkSeq::new[u64](),
        bstk: ChunkSeq::new[u64](),
        out: ChunkSeq::new[u64](),
        ew: ChunkSeq::new[u64](),
        sy_mask: 0,
        l_mask: 0,
        x_mask: 0,
        ug_base: 0,
        stamp: 0,
        target: 0,
        root: 0,
        l_end: 0,
        mf_kind: 0,
        mf_a: 0,
        mf_b: 0,
        mf_peer: 0,
        mf_label: 0,
        pos: 0,
        end_line: 0,
