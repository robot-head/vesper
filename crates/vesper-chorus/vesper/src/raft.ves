    nodes: u64,
    quorum: u64,
    duration_ns: u64,
    heartbeat_ns: u64,
    election_min_ns: u64,
    election_max_ns: u64,
    rpc_timeout_ns: u64,
    min_latency_ns: u64,
    max_latency_ns: u64,
    drop_per_mille: u64,
    duplicate_per_mille: u64,
    max_skew_ppm: u64,
    crashes: bool,
    partitions: bool,
    propose_per_mille: u64,
    max_log: u64,
    max_batch: u64,
    max_steps: u64,
    snapshot_threshold: u64,
    initial_members: u64,
    membership_per_mille: u64,
    min_members: u64,
    durable: bool,
    torn_crash_per_mille: u64,
    reply_before_sync: bool
}

