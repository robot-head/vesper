// Module raft of @vesper/chorus (see lib.ves): Raft cluster simulation state
// machine, ChaosPlan, RawSession choreography monitors, wire encoding/decoding,
// and invariant checking (src/raft.rs).
use self::{new_c, C};
use self::util::{inc, intern_str, none, sat_add, setw, sw, LTag};
use self::local::{choice, l_action, l_init, l_msg, lt as ltag};
use self::session::{c_mon_action, c_mon_step};
use self::simnet::{sm_chance, sm_range};
use self::wire::{
    ack_decode_range, ack_encode_seq, batch_decode_range, batch_encode_arena_seq,
    checker_core_committed_arena, checker_core_compacted_changed, checker_core_leader_elected,
    checker_core_logs_changed_arena, checker_core_new, checker_core_record, config_index_arena,
    quorum_size, raft_config_of_arena, term_decode_range, term_encode_seq, votereq_decode_range,
    votereq_encode_seq, CheckerCore, RaftEntry, ViolKind, WireAck, WireErr, WireHeader, WireVoteReq,
    CONFIG_FLAG, MAX_BATCH
};

const MAX_U64: u64 = 18446744073709551615;
const FNV_OFFSET: u64 = 14695981039346656037;
const FNV_PRIME: u64 = 1099511628211;
const MIN_SEEN_HT: u64 = 1024;
const INIT_LOG_CAP: u64 = 64;

const SEED_RAFT_XOR: u64 = 8241981442229496173;
// 0x7261_6674_2d73_696d
const SEED_DISK_XOR: u64 = 7238820263653106977;
// 0x6475_7261_626c_6521

const PROTO_CANDIDATE: u64 = 0;
const PROTO_VOTER: u64 = 1;
const PROTO_LEADER: u64 = 0;
const PROTO_FOLLOWER: u64 = 1;

pub enum RaftRole: _ {
    Follower = 0,
    Candidate = 1,
    Leader = 2
}

enum RpcKind: _ {
    Vote = 0,
    Append = 1,
    Snapshot = 2
}

enum NodeEv: _ {
    Leader = 0,
    LogChanged = 1,
    Committed = 2,
    CompactedChanged = 3
}

pub enum RaftInitErr: _ {
    Ok = 0,
    BadNodes = 1,
    InvertedRange = 2,
    MaxBatch = 3,
    SnapMaxLog = 4,
    InitialMembers = 5,
    MembershipMaxNodes = 6,
    TornNeedsDurable = 7
}

pub enum RaftStepCode: _ {
    Continue = 0,
    Finished = 1,
    NeedPersist = 2,
    NeedChaosRecover = 3
}

