// Real source ADTs: the bridge parses and checks this with the Vesper front end.
copy struct Point { x: i64, y: i64 }
enum Shape[T] { Dot(T), Segment(T, T) }
struct Layer[T] { name: String, first: Option[Shape[T]] }
struct Index[K, V] { key: Option[K], value: Option[V] }
linear struct Canvas { id: u64 }

fn first_point(layer: Layer[Point]) -> i64 { 0 }
