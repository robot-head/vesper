{
  "notes": [
    "The flip gate for vesper-fusion's independent rewrite-witness checker,",
    "S-expression reader, rule-set parser, and source-term builder",
    "(aspect ci flip-gate --, SH6 lane 18, #1413 / #2239).",
    "witness.ves shares no e-graph, saturation, or explanation code with",
    "engine.ves so REVIEW-STATUS COMP-03 diversity is preserved.",
    "Differential cases compare RuleSet::parse, source_term, and witness::check",
    "against the pure-Rust reference in tests/witness_port.rs across valid,",
    "malformed, and tampered inputs; ABBA compares 30 epochs of 16-step DSP",
    "witness replay and rule-set + source-term parsing."
  ],
  "name": "vesper-fusion",
  "lane": "SH6-18",
  "env": {
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0"
  },
  "tests": [
    {
      "run": [
        "cargo",
        "test",
        "--locked",
        "--release",
        "-p",
        "vesper-fusion",
        "--test",
        "witness",
        "--test",
        "witness_port",
        "--test",
        "tensor_fusion",
        "--test",
        "dsp_fusion",
        "--test",
        "engine_edges"
      ]
    }
  ],
  "differential": {
    "run": [
      "cargo",
      "test",
      "--locked",
      "--release",
      "-p",
      "vesper-fusion",
      "--test",
      "witness_port",
      "--",
      "--nocapture"
    ]
  },
  "abba": [
    {
      "workload": "witness_check",
      "run": [
        "cargo",
        "test",
        "--locked",
        "--release",
        "-p",
        "vesper-fusion",
        "--test",
        "witness_port",
        "abba_witness",
        "--",
        "--ignored",
        "--nocapture"
      ]
    },
    {
      "workload": "witness_parse",
      "run": [
        "cargo",
        "test",
        "--locked",
        "--release",
        "-p",
        "vesper-fusion",
        "--test",
        "witness_port",
        "abba_witness",
        "--",
        "--ignored",
        "--nocapture"
      ]
    }
  ]
}
