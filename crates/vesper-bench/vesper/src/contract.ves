// Module contract of @vesper/bench (see lib.ves): contract.rs's bounded
// `@bench(...)` attribute parser and contract_gate.rs's exact limit
// arithmetic.
use self::{
    ContractOut,
    ErrorKind,
    GateError,
    GateIn,
    GateOut,
    ParseError
};
use self::util::{
    NO_BYTE,
    add,
    gb,
    inc,
    mul,
    sub
};
use self::wide::{
    w_mul_u64,
    w_ult
};

// The bytes the attribute grammar names.
enum Ascii: _ {
    Tab = 9,
    Lf = 10,
    FormFeed = 12,
    Cr = 13,
    Space = 32,
    LParen = 40,
    RParen = 41,
    Comma = 44,
    Dot = 46,
    Zero = 48,
    Nine = 57,
    Equals = 61,
    At = 64,
    Underscore = 95,
    LowerA = 97,
    LowerZ = 122
}

// The longest attribute parsed (Error InputLimit past it).
const MAX_ATTRIBUTE_BYTES: u64 = 4096;
// The most fractional digits a decimal keeps (u64 holds 10^19).
const MAX_DECIMAL_SCALE: u64 = 18;
const DECIMAL_BASE: u64 = 10;
// The largest value that still takes another digit: u64::MAX / 10.
const MAX_BEFORE_DIGIT: u64 = 1844674407370955161;

// The `@bench` fields, in the order of the parser's checks.
enum Field: _ {
    ZeroAlloc,
    ExpectVectorized,
    InstructionsPerByte,
    StabilizerPages,
    L1dMissesPerOp
}

// `zero_alloc` and `expect_vectorized` (ContractOut).
enum Flag: _ {
    Unset,
    False,
    True
}

fn perr(kind: ErrorKind, offset: u64) eff [Fail[ParseError]] {
    Fail::raise(
        ParseError {
            kind: kind,
            offset: widen_usize(offset)
        }
    );
}

// `u8::is_ascii_whitespace`: space, tab, line feed, form feed, return.
fn is_space(b: u64) -> bool {
    b == Ascii::Space || b == Ascii::Tab || b == Ascii::Lf || b == Ascii::FormFeed || b == Ascii::Cr
}

fn is_name_byte(b: u64) -> bool {
    (b >= Ascii::LowerA && b <= Ascii::LowerZ) || is_digit(b) || b == Ascii::Underscore
}

fn is_digit(b: u64) -> bool {
    b >= Ascii::Zero && b <= Ascii::Nine
}

fn space(in input: Slice[u8], pos: u64) -> u64 {
    let mut p = pos;
    loop {
        if !is_space(gb(in input, p)) {
            break;
        }
        p = inc(p);
    }
    p
}

// Skips space and one expected byte; Syntax at the first other byte.
fn expect(in input: Slice[u8], pos: u64, byte: u64) -> u64 eff [Fail[ParseError]] {
    let p = space(in input, pos);
    if gb(in input, p) != byte {
        perr(ErrorKind::Syntax, p);
    }
    inc(p)
}

// The end of the name that starts at `start` (after space).
fn name_end(in input: Slice[u8], start: u64) -> u64 {
    let mut p = start;
    loop {
        if !is_name_byte(gb(in input, p)) {
            break;
        }
        p = inc(p);
    }
    p
}

fn name_is(in input: Slice[u8], start: u64, end: u64, in word: Str) -> bool {
    if sub(end, start) != word.len() {
        return false;
    }
    for i in 0..word.len() {
        let want = match word.try_byte_at(i) {
            Option::Some(b) => widen_u64(b),
            Option::None => NO_BYTE,
        };
        if gb(in input, add(start, i)) != want {
            return false;
        }
    }
    true
}

// A boolean literal; returns the position after it and the value.
fn boolean(in input: Slice[u8], pos: u64) -> (u64, bool) eff [Fail[ParseError]] {
    let start = space(in input, pos);
    let end = name_end(in input, start);
    if name_is(in input, start, end, "true") {
        return (end, true);
    }
    if name_is(in input, start, end, "false") {
        return (end, false);
    }
    perr(ErrorKind::Syntax, end);
    (end, false)
}

// value * 10 + digit, or None where Rust's checked arithmetic overflows.
fn push_digit(value: u64, digit: u64) -> Option[u64] {
    if value > MAX_BEFORE_DIGIT {
        return Option::None;
    }
    let ten = mul(value, DECIMAL_BASE);
    let next = wrapping_add(ten, digit);
    if next < ten {
        Option::None
    } else {
        Option::Some(next)
    }
}

// A decimal; returns (position, coefficient, scale).
fn number(in input: Slice[u8], pos: u64, fractional: bool)
    -> (u64, u64, u64) eff [Fail[ParseError]] {
    let start = space(in input, pos);
    let mut p = start;
    let mut value: u64 = 0;
    loop {
        let b = gb(in input, p);
        if !is_digit(b) {
            break;
        }
        match push_digit(value, sub(b, Ascii::Zero)) {
            Option::Some(v) => value = v,
            Option::None => perr(ErrorKind::NumberOverflow, p),
        }
        p = inc(p);
    }
    if p == start {
        perr(ErrorKind::Syntax, p);
    }
    let mut scale: u64 = 0;
    if fractional && gb(in input, p) == Ascii::Dot {
        p = inc(p);
        let fraction_start = p;
        loop {
            let b = gb(in input, p);
            if !is_digit(b) {
                break;
            }
            scale = inc(scale);
            if scale > MAX_DECIMAL_SCALE {
                perr(ErrorKind::NumberOverflow, p);
            }
            match push_digit(value, sub(b, Ascii::Zero)) {
                Option::Some(v) => value = v,
                Option::None => perr(ErrorKind::NumberOverflow, p),
            }
            p = inc(p);
        }
        if p == fraction_start {
            perr(ErrorKind::Syntax, p);
        }
    }
    (p, value, scale)
}

fn empty_contract() -> ContractOut {
    ContractOut {
        zero_alloc: 0,
        expect_vectorized: 0,
        has_instructions_per_byte: false,
        instructions_coefficient: 0,
        instructions_scale: 0,
        has_stabilizer_pages: false,
        stabilizer_pages: 0,
        has_l1d_misses_per_op: false,
        l1d_misses_per_op: 0
    }
}

fn duplicate(start: u64) eff [Fail[ParseError]] {
    perr(ErrorKind::DuplicateField, start);
}

// `zero_alloc` and `expect_vectorized` are Flag codes.
pub fn do_parse_attribute(in input: Slice[u8]) -> ContractOut eff [Fail[ParseError]] {
    let len = input.len();
    if len > MAX_ATTRIBUTE_BYTES {
        perr(ErrorKind::InputLimit, MAX_ATTRIBUTE_BYTES);
    }
    let mut p = expect(in input, 0, Ascii::At);
    let name_start = space(in input, p);
    p = name_end(in input, name_start);
    if !name_is(in input, name_start, p, "bench") {
        perr(ErrorKind::Syntax, p);
    }
    p = space(in input, p);
    let mut r = empty_contract();
    if p == len {
        return r;
    }
    p = expect(in input, p, Ascii::LParen);
    loop {
        p = space(in input, p);
        if gb(in input, p) == Ascii::RParen {
            p = inc(p);
            break;
        }
        let start = p;
        p = name_end(in input, start);
        let id: u64 = if name_is(in input, start, p, "zero_alloc") {
            Field::ZeroAlloc
        } else if name_is(in input, start, p, "expect_vectorized") {
            Field::ExpectVectorized
        } else if name_is(in input, start, p, "max_instructions_per_byte") {
            Field::InstructionsPerByte
        } else if name_is(in input, start, p, "stabilizer_pages") {
            Field::StabilizerPages
        } else if name_is(in input, start, p, "max_l1d_misses_per_op") {
            Field::L1dMissesPerOp
        } else if p == start {
            perr(ErrorKind::Syntax, p);
            Field::ZeroAlloc
        } else {
            perr(ErrorKind::UnknownField, start);
            Field::ZeroAlloc
        };
        p = expect(in input, p, Ascii::Equals);
        if id == Field::ZeroAlloc {
            if r.zero_alloc != Flag::Unset {
                duplicate(start);
            }
            let (q, v) = boolean(in input, p);
            p = q;
            r.zero_alloc = if v {
                Flag::True
            } else {
                Flag::False
            };
        } else if id == Field::ExpectVectorized {
            if r.expect_vectorized != Flag::Unset {
                duplicate(start);
            }
            let (q, v) = boolean(in input, p);
            p = q;
            r.expect_vectorized = if v {
                Flag::True
            } else {
                Flag::False
            };
        } else if id == Field::InstructionsPerByte {
            if r.has_instructions_per_byte {
                duplicate(start);
            }
            let (q, c, s) = number(in input, p, true);
            p = q;
            r.has_instructions_per_byte = true;
            r.instructions_coefficient = c;
            r.instructions_scale = wrapping_u32(s);
        } else if id == Field::StabilizerPages {
            if r.has_stabilizer_pages {
                duplicate(start);
            }
            let (q, c, s) = number(in input, p, false);
            p = q;
            r.has_stabilizer_pages = true;
            r.stabilizer_pages = c;
        } else {
            if r.has_l1d_misses_per_op {
                duplicate(start);
            }
            let (q, c, s) = number(in input, p, false);
            p = q;
            r.has_l1d_misses_per_op = true;
            r.l1d_misses_per_op = c;
        }
        p = space(in input, p);
        let b = gb(in input, p);
        if b == Ascii::Comma {
            p = inc(p);
        } else if b == Ascii::RParen {
            p = inc(p);
            break;
        } else {
            perr(ErrorKind::Syntax, p);
        }
    }
    p = space(in input, p);
    if p != len {
        perr(ErrorKind::Syntax, p);
    }
    r
}

// ---------------------------------------------------------------------------
// contract_gate.rs
//
// GateReport status codes (src/port.rs): every status from
// MissingInstructions on is Inconclusive with that reason.
enum Status: _ {
    NotRequested,
    Pass,
    Fail,
    // Counter(InstructionsRetired) and Counter(L1dReadMisses).
    MissingInstructions,
    MissingL1dMisses,
    MissingInputBytes,
    MissingOperations,
    ZeroInputBytes,
    ZeroOperations,
    AllocationEvidence,
    VectorizationEvidence,
    LayoutEvidence
}

// GateReport's overall decision.
enum Overall: _ {
    NotRequested,
    Pass,
    Fail,
    Inconclusive
}

fn pow10(scale: u64) -> u64 {
    let mut p: u64 = 1;
    for i in 0..scale {
        p = mul(p, DECIMAL_BASE);
    }
    p
}

fn ratio_gate(
    has_counter: bool,
    counter: u64,
    has_denominator: bool,
    denominator: u64,
    coefficient: u64,
    scale: u64,
    missing_counter: u64,
    missing_denominator: u64,
    zero_denominator: u64
) -> u64 {
    if !has_counter {
        return missing_counter;
    }
    if !has_denominator {
        return missing_denominator;
    }
    if denominator == 0 {
        return zero_denominator;
    }
    let left = w_mul_u64(counter, pow10(scale));
    let right = w_mul_u64(coefficient, denominator);
    if w_ult(right, left) {
        Status::Fail
    } else {
        Status::Pass
    }
}

pub fn do_gate_evaluate(g: GateIn) -> GateOut eff [Fail[GateError]] {
    let scale = widen_u64(g.instructions_scale);
    if g.has_instructions_per_byte && scale > MAX_DECIMAL_SCALE {
        Fail::raise(GateError::InvalidDecimalScale);
    }
    let ipb = if g.has_instructions_per_byte {
        ratio_gate(
            g.has_instructions,
            g.instructions,
            g.has_input_bytes,
            g.input_bytes,
            g.instructions_coefficient,
            scale,
            Status::MissingInstructions,
            Status::MissingInputBytes,
            Status::ZeroInputBytes
        )
    } else {
        Status::NotRequested
    };
    let l1d = if g.has_l1d_misses_per_op {
        ratio_gate(
            g.has_l1d_misses,
            g.l1d_misses,
            g.has_operations,
            g.operations,
            g.l1d_misses_per_op,
            0,
            Status::MissingL1dMisses,
            Status::MissingOperations,
            Status::ZeroOperations
        )
    } else {
        Status::NotRequested
    };
    let zero_alloc: u64 = if g.zero_alloc {
        Status::AllocationEvidence
    } else {
        Status::NotRequested
    };
    let vectorized: u64 = if g.expect_vectorized {
        Status::VectorizationEvidence
    } else {
        Status::NotRequested
    };
    let pages: u64 = if g.has_stabilizer_pages {
        Status::LayoutEvidence
    } else {
        Status::NotRequested
    };
    let any_fail = ipb == Status::Fail || l1d == Status::Fail;
    let counters = ipb >= Status::MissingInstructions || l1d >= Status::MissingInstructions;
    let evidence = zero_alloc != Status::NotRequested || vectorized != Status::NotRequested;
    let any_inconclusive = counters || evidence || pages != Status::NotRequested;
    let any_pass = ipb == Status::Pass || l1d == Status::Pass;
    let overall: u64 = if any_fail {
        Overall::Fail
    } else if any_inconclusive {
        Overall::Inconclusive
    } else if any_pass {
        Overall::Pass
    } else {
        Overall::NotRequested
    };
    GateOut {
        instructions_per_byte: ipb,
        l1d_misses_per_op: l1d,
        zero_alloc: zero_alloc,
        expect_vectorized: vectorized,
        stabilizer_pages: pages,
        overall: overall
    }
}
