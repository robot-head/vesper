pub fn mann_whitney_exact(in first: Slice[u64], in second: Slice[u64])
    -> ExactMw eff [Fail[PortError]] {
    do_mann_whitney_exact(in first, in second)
}

pub fn mann_whitney_exact_with_ties(in first: Slice[u64], in second: Slice[u64])
