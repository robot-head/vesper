// ---------------------------------------------------------------------------
// layout.rs, execution.rs, causal.rs, arithmetic.rs, lib.rs

pub fn layout_plan(seed: u64, run: u32) -> LayoutPlan {
    do_layout_plan(seed, run)
}

pub fn layout_sample(in pairs: Slice[Sample]) -> Sample eff [Fail[PortError]] {
    do_layout_sample(in pairs)
}

pub fn layout_survival(in per_layout: Slice[Sample]) -> SurvivalOut eff [Fail[PortError]] {
    do_layout_survival(in per_layout)
}

pub fn validate_config(
    epochs: usize,
    warmup_epochs: usize,
    operations_per_window: usize,
    max_total_calls: usize,
    max_elapsed_nanos: u64
) -> usize eff [Fail[PortError]] {
    do_validate_config(
        epochs,
        warmup_epochs,
        operations_per_window,
        max_total_calls,
        max_elapsed_nanos
    )
}

pub fn fold_epoch(w0: u64, w1: u64, w2: u64, w3: u64, operations: u64)
    -> Sample eff [Fail[PortError]] {
    do_fold_epoch(w0, w1, w2, w3, operations)
}

pub fn experiment_run(elapsed: u64, delay: u64, progress: u64)
    -> ExperimentRun eff [Fail[CausalErr]] {
    do_experiment_run(elapsed, delay, progress)
}

pub fn median_run(in runs: Slice[ExperimentRun]) -> ExperimentRun {
    do_median_run(in runs)
}

pub fn median_i64(in values: Slice[i64]) -> i64 {
    do_median_i64(in values)
}

pub fn predicted_bp(baseline: ExperimentRun, run: ExperimentRun) -> i64 eff [Fail[PortError]] {
    do_predicted_bp(baseline, run)
}

pub fn region_delay(elapsed: u64, speedup_pct: u32) -> u64 {
    do_region_delay(elapsed, speedup_pct)
}

pub fn modular_counter_delta(start: u64, end: u64, width_bits: u8) -> u64 eff [Fail[PortError]] {
    do_modular_counter_delta(start, end, width_bits)
}

pub fn layout_offset_bytes(seed: u64, epoch: u64) -> u32 {
    do_layout_offset_bytes(seed, epoch)
}

pub fn unavailable_evidence(requirement: EvidenceRequirement) -> UnavailableEvidence {
    do_unavailable_evidence(requirement)
}

pub fn evaluate_evidence_requirement(requirement: EvidenceRequirement) -> EvidenceGate {
    do_evaluate_evidence_requirement(requirement)
}
