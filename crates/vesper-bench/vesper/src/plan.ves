// Module plan of @vesper/bench (see lib.ves): the pure planning and
// folding of the measurement driver. arithmetic.rs, layout.rs's layout
// plans, execution.rs's configuration check and per-epoch fold, causal.rs's
// experiment folds (effective time, medians, predicted speedups, the delay
// a selected region charges) and lib.rs's evidence gate. The clock reads,
// the callback run loop and the profiler's threads stay in Rust and pass
// their measurements in.
use self::{
    CausalErr,
    Decision,
    EvidenceGate,
    EvidenceRequirement,
    ExperimentRun,
    LayoutPlan,
    PortError,
    Sample,
    UnavailableEvidence,
    UnavailableReason
};
use self::stats::{
    Limit,
    cadd,
    do_paired_sample_new
};
use self::util::{
    BP_SCALE,
    I64_MIN_MAGNITUDE,
    MAX_EPOCHS,
    add,
    dec,
    div,
    gi,
    inc,
    mul,
    pow2,
    rem,
    sort_u64,
    sub
};
use self::wide::{
    w_floor_divrem,
    w_fits_i64,
    w_is_neg,
    w_is_zero,
    w_mul_small,
    w_mul_u64,
    w_sub,
    w_u64,
    w_ucmp,
    w_udivrem
};

// The widest counter, in bits.
const MAX_COUNTER_WIDTH: u64 = 64;
// layout_offset_bytes: one of 64 cache lines in [0, 4096).
const OFFSET_LINE_MASK: u64 = 63;
const CACHE_LINE_BYTES: u64 = 64;
// layout.rs: heap offsets are 256 steps of HEAP_OFFSET_STEP bytes, stack
// padding 64 frames of STACK_FRAME_BYTES, env padding below MAX_ENV_PADDING.
const HEAP_OFFSET_STEPS: u64 = 256;
const HEAP_OFFSET_STEP: u64 = 16;
const STACK_FRAMES: u64 = 64;
const STACK_FRAME_BYTES: u64 = 64;
const MAX_ENV_PADDING: u64 = 4096;
// execution.rs RunConfig limits.
const MAX_OPERATIONS_PER_WINDOW: u64 = 65536;
const MAX_TOTAL_CALLS: u64 = 10000000;
const MAX_ELAPSED_NANOS: u64 = 600000000000;
// An A/B/B/A epoch: four windows, two for each arm.
const WINDOWS_PER_EPOCH: u64 = 4;
const WINDOWS_PER_ARM: u64 = 2;
const PERCENT: u64 = 100;

// Error::InvalidConfig codes (src/port.rs CONFIG_MESSAGES).
enum ConfigCode: _ {
    Epochs,
    WarmupEpochs,
    Operations,
    TotalCalls,
    ElapsedBudget
}

// ---------------------------------------------------------------------------
// arithmetic.rs

pub fn do_modular_counter_delta(start: u64, end: u64, width_bits: u8) -> u64 eff [Fail[PortError]] {
    let width = widen_u64(width_bits);
    if width < 1 || width > MAX_COUNTER_WIDTH {
        Fail::raise(PortError::InvalidCounterWidth);
    }
    if width == MAX_COUNTER_WIDTH {
        return wrapping_sub(end, start);
    }
    let modulus = pow2(width);
    if start >= modulus || end >= modulus {
        Fail::raise(PortError::CounterValueOutOfRange);
    }
    rem(sub(add(end, modulus), start), modulus)
}

fn mix(x: u64) -> u64 {
    let mut z = x;
    z = wrapping_mul(z ^ (z >> 30), 13787848793156543929);
    z = wrapping_mul(z ^ (z >> 27), 10723151780598845931);
    z ^ (z >> 31)
}

pub fn do_layout_offset_bytes(seed: u64, epoch: u64) -> u32 {
    let z = mix(wrapping_add(seed, wrapping_mul(epoch, 11400714819323198485)));
    wrapping_u32(mul(z & OFFSET_LINE_MASK, CACHE_LINE_BYTES))
}

// ---------------------------------------------------------------------------
// layout.rs

// SplitMix64: the next state and its output.
fn splitmix64(st: u64) -> (u64, u64) {
    let s = wrapping_add(st, 11400714819323198485);
    (s, mix(s))
}

pub fn do_layout_plan(seed: u64, run: u32) -> LayoutPlan {
    let r = widen_u64(run);
    let s0 = seed ^ ((r << 32) | r);
    let (s1, ignored) = splitmix64(s0);
    let (s2, heap) = splitmix64(s1);
    let (s3, stack) = splitmix64(s2);
    let (s4, env) = splitmix64(s3);
    let (s5, run_seed) = splitmix64(s4);
    LayoutPlan {
        seed: seed,
        run: run,
        heap_offset_bytes: wrapping_u32(mul(rem(heap, HEAP_OFFSET_STEPS), HEAP_OFFSET_STEP)),
        stack_padding_bytes: wrapping_u32(mul(rem(stack, STACK_FRAMES), STACK_FRAME_BYTES)),
        env_padding_bytes: wrapping_u32(rem(env, MAX_ENV_PADDING)),
        run_seed: run_seed
    }
}

// ---------------------------------------------------------------------------
// execution.rs

// Error::InvalidConfig codes (src/port.rs CONFIG_MESSAGES).
fn invalid(code: u64) eff [Fail[PortError]] {
    Fail::raise(
        PortError::InvalidConfig {
            code: code
        }
    );
}

fn cmul(a: u64, b: u64) -> u64 eff [Fail[PortError]] {
    let (lo, hi) = mul_wide(a, b);
    if hi != 0 {
        Fail::raise(PortError::ArithmeticOverflow);
    }
    lo
}

// `RunConfig::validate`: the body calls the configuration makes.
pub fn do_validate_config(
    epochs: usize,
    warmup_epochs: usize,
    operations_per_window: usize,
    max_total_calls: usize,
    max_elapsed_nanos: u64
) -> usize eff [Fail[PortError]] {
    let e = widen_u64(epochs);
    let w = widen_u64(warmup_epochs);
    let o = widen_u64(operations_per_window);
    let c = widen_u64(max_total_calls);
    if e == 0 || e > MAX_EPOCHS {
        invalid(ConfigCode::Epochs);
    }
    if w > MAX_EPOCHS {
        invalid(ConfigCode::WarmupEpochs);
    }
    if o == 0 || o > MAX_OPERATIONS_PER_WINDOW {
        invalid(ConfigCode::Operations);
    }
    if c == 0 || c > MAX_TOTAL_CALLS {
        invalid(ConfigCode::TotalCalls);
    }
    if max_elapsed_nanos == 0 || max_elapsed_nanos > MAX_ELAPSED_NANOS {
        invalid(ConfigCode::ElapsedBudget);
    }
    let calls = cmul(cmul(cadd(e, w), WINDOWS_PER_EPOCH), o);
    if calls > c {
        Fail::raise(
            PortError::Limit {
                code: Limit::BodyCalls
            }
        );
    }
    widen_usize(calls)
}

// One measured A/B/B/A epoch: A = windows 0 + 3, B = windows 1 + 2, over
// twice the window's operations.
pub fn do_fold_epoch(w0: u64, w1: u64, w2: u64, w3: u64, operations: u64)
    -> Sample eff [Fail[PortError]] {
    let a = cadd(w0, w3);
    let b = cadd(w1, w2);
    do_paired_sample_new(a, b, cmul(operations, WINDOWS_PER_ARM))
}

// ---------------------------------------------------------------------------
// causal.rs

pub fn do_experiment_run(elapsed: u64, delay: u64, progress: u64)
    -> ExperimentRun eff [Fail[CausalErr]] {
    if progress == 0 {
        Fail::raise(CausalErr::EmptyEvidence);
    }
    if delay >= elapsed {
        Fail::raise(
            CausalErr::DelayExceedsElapsed {
                elapsed: elapsed,
                delay: delay
            }
        );
    }
    ExperimentRun {
        elapsed_ns: elapsed,
        global_delay_ns: delay,
        effective_ns: sub(elapsed, delay),
        progress: progress
    }
}

fn period_cmp(a: ExperimentRun, b: ExperimentRun) -> i64 {
    w_ucmp(w_mul_u64(a.effective_ns, b.progress), w_mul_u64(b.effective_ns, a.progress))
}

fn grun(in s: Slice[ExperimentRun], i: u64) -> ExperimentRun {
    match s.try_get(i) {
        Option::Some(x) => x,
        Option::None => ExperimentRun {
            elapsed_ns: 0,
            global_delay_ns: 0,
            effective_ns: 0,
            progress: 0
        },
    }
}

// The median run by period (Rust sorts stably, so equal periods keep their
// order).
pub fn do_median_run(in runs: Slice[ExperimentRun]) -> ExperimentRun {
    let n = runs.len();
    let mut s: ChunkSeq[ExperimentRun] = ChunkSeq::with_capacity[ExperimentRun](n);
    for i in 0..n {
        let x = grun(in runs, i);
        s.push(x);
        let mut j = i;
        loop {
            if j == 0 {
                break;
            }
            let p = grun(in s.as_slice(), dec(j));
            if period_cmp(p, x) > 0 {
                s.try_set(j, p);
                j = dec(j);
            } else {
                break;
            }
        }
        s.try_set(j, x);
    }
    grun(in s.as_slice(), div(n, 2))
}

// The middle prediction after an ascending sort.
pub fn do_median_i64(in values: Slice[i64]) -> i64 {
    let n = values.len();
    let mut s: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](n);
    for i in 0..n {
        // Flipping the sign bit makes the i64 order the u64 order.
        s.push(wrapping_u64(gi(in values, i)) ^ I64_MIN_MAGNITUDE);
    }
    sort_u64(inout s, n);
    let m = match s.try_get(div(n, 2)) {
        Option::Some(x) => x,
        Option::None => I64_MIN_MAGNITUDE,
    };
    wrapping_i64(m ^ I64_MIN_MAGNITUDE)
}

// BP_SCALE * (1 - period_s / period_0), floored. A product beyond `i128`
// (which Rust's `i128` arithmetic does not define) is ArithmeticOverflow.
pub fn do_predicted_bp(baseline: ExperimentRun, run: ExperimentRun) -> i64 eff [Fail[PortError]] {
    let product = w_mul_u64(run.effective_ns, baseline.progress);
    let num = w_mul_small(product, BP_SCALE);
    let (back, r0) = w_udivrem(num, w_u64(BP_SCALE));
    if w_is_neg(num) || w_ucmp(back, product) != 0 {
        Fail::raise(PortError::ArithmeticOverflow);
    }
    let den = w_mul_u64(run.progress, baseline.effective_ns);
    if w_is_neg(den) {
        Fail::raise(PortError::ArithmeticOverflow);
    }
    if w_is_zero(den) {
        Fail::raise(PortError::EmptyEvidence);
    }
    let (q, r) = w_floor_divrem(num, den);
    let mut result = w_sub(w_u64(BP_SCALE), q);
    if !w_is_zero(r) {
        result = w_sub(result, w_u64(1));
    }
    if !w_fits_i64(result) {
        Fail::raise(PortError::ArithmeticOverflow);
    }
    wrapping_i64(result.lo)
}

// The delay a selected region's visit charges: elapsed * pct / PERCENT.
pub fn do_region_delay(elapsed: u64, speedup_pct: u32) -> u64 {
    let (q, r) = w_udivrem(w_mul_u64(elapsed, widen_u64(speedup_pct)), w_u64(PERCENT));
    q.lo
}

// ---------------------------------------------------------------------------
// lib.rs

pub fn do_unavailable_evidence(requirement: EvidenceRequirement) -> UnavailableEvidence {
    let reason = match requirement {
        EvidenceRequirement::ZeroAllocation => UnavailableReason::NoAllocationInstrumentation,
        EvidenceRequirement::Vectorization => UnavailableReason::NoCompilerVectorizationEvidence,
        _ => UnavailableReason::NoPmuProvider,
    };
    UnavailableEvidence {
        requirement: requirement,
        reason: reason
    }
}

pub fn do_evaluate_evidence_requirement(requirement: EvidenceRequirement) -> EvidenceGate {
    EvidenceGate {
        decision: Decision::Inconclusive,
        unavailable: do_unavailable_evidence(requirement)
    }
}
