// Module stats of @vesper/bench (see lib.ves): statistics.rs (Mann-Whitney
// ranks and exact probabilities, the exact median-ratio interval behind
// `analyze_pairs`), contract.rs `PairedSample` and layout.rs's survival
// test and sample fold.
//
// Mann-Whitney counts are binomial coefficients of at most 64 choose 32
// (below 2^61), so they fit a word; Rust keeps them in `u128`, and the
// wrappers widen them. The checked additions still raise
// `ArithmeticOverflow` exactly where Rust's `checked_add` would.
use self::{
    AnalysisOut,
    BpBounds,
    Decision,
    ExactMw,
    MannWhitneyRanks,
    PortError,
    Sample,
    SurvivalOut,
    W
};
use self::util::{
    BP_SCALE,
    MAX_EPOCHS,
    add,
    cs,
    cu,
    dec,
    div,
    gs,
    gu,
    inc,
    min_u64,
    mul,
    no_sample,
    pow2,
    sort_u64,
    sub,
    zeros
};
use self::wide::{
    udiv_u128,
    w_from_u128,
    w,
    w_add,
    w_floor_divrem,
    w_is_zero,
    w_mul_small,
    w_mul_u64,
    w_neg,
    w_sub,
    w_twice,
    w_u64,
    w_ucmp,
    w_udivrem,
    w_ult,
    w_zero
};

// Error::Limit codes (src/port.rs LIMITS).
pub enum Limit: _ {
    Rank,
    ExactRank,
    Epochs,
    Layouts,
    BodyCalls,
    Elapsed
}

// `analyze_pairs`'s InconclusiveReason (src/port.rs `analysis`).
enum Reason: _ {
    None,
    InsufficientEpochs,
    IntervalCrossesThreshold
}

// LayoutSurvival verdicts (src/port.rs).
enum Verdict: _ {
    CandidateSlower,
    CandidateFaster,
    DoesNotSurvive,
    InsufficientLayouts
}

// The most observations in each sample of the exact Mann-Whitney test.
const MAX_EXACT_RANK_SAMPLES: u64 = 32;
// The median interval's one-sided binomial tail is at most 5/200 = 2.5%.
const ALPHA_TAIL_NUMERATOR: u64 = 5;
const ALPHA_TAIL_DENOMINATOR: u64 = 200;
// The lowest regression threshold (-99.99%): a ratio stays positive.
const MIN_REGRESSION_BP: i64 = -9999;

fn overflow() eff [Fail[PortError]] {
    Fail::raise(PortError::ArithmeticOverflow);
}

// a + b, raising ArithmeticOverflow where `checked_add` returns None.
pub fn cadd(a: u64, b: u64) -> u64 eff [Fail[PortError]] {
    let s = wrapping_add(a, b);
    if s < a {
        overflow();
    }
    s
}

// ---------------------------------------------------------------------------
// statistics.rs

pub fn do_mann_whitney_ranks(in first: Slice[u64], in second: Slice[u64])
    -> MannWhitneyRanks eff [Fail[PortError]] {
    let n = first.len();
    let m = second.len();
    if n == 0 || m == 0 {
        Fail::raise(PortError::EmptyEvidence);
    }
    if n > MAX_EPOCHS || m > MAX_EPOCHS {
        Fail::raise(
            PortError::Limit {
                code: Limit::Rank
            }
        );
    }
    let mut greater: u64 = 0;
    let mut less: u64 = 0;
    let mut tied: u64 = 0;
    for i in 0..n {
        let x = gu(in first, i);
        for j in 0..m {
            let y = gu(in second, j);
            if x > y {
                greater = add(greater, 2);
            } else if x < y {
                less = add(less, 2);
            } else {
                greater = inc(greater);
                less = inc(less);
                tied = inc(tied);
            }
        }
    }
    MannWhitneyRanks {
        first_count: widen_usize(n),
        second_count: widen_usize(m),
        twice_u_first: greater,
        twice_u_second: less,
        tied_pairs: tied
    }
}

fn pooled_sorted(in first: Slice[u64], in second: Slice[u64]) -> ChunkSeq[u64] {
    let n = first.len();
    let m = second.len();
    let mut pooled = zeros(add(n, m));
    for i in 0..n {
        pooled.try_set(i, gu(in first, i));
    }
    for j in 0..m {
        pooled.try_set(add(n, j), gu(in second, j));
    }
    sort_u64(inout pooled, add(n, m));
    pooled
}

fn check_exact_sizes(n: u64, m: u64) eff [Fail[PortError]] {
    if n == 0 || m == 0 {
        Fail::raise(PortError::EmptyEvidence);
    }
    if n > MAX_EXACT_RANK_SAMPLES || m > MAX_EXACT_RANK_SAMPLES {
        Fail::raise(
            PortError::Limit {
                code: Limit::ExactRank
            }
        );
    }
}

pub fn do_mann_whitney_exact(in first: Slice[u64], in second: Slice[u64])
    -> ExactMw eff [Fail[PortError]] {
    let n = first.len();
    let m = second.len();
    check_exact_sizes(n, m);
    let pooled = pooled_sorted(in first, in second);
    for i in 1..add(n, m) {
        if cu(in pooled, dec(i)) == cu(in pooled, i) {
            Fail::raise(PortError::TiedObservations);
        }
    }
    let ranks = do_mann_whitney_ranks(in first, in second);
    let observed = div(ranks.twice_u_first, 2);
    let max_u = mul(n, m);
    let width = inc(max_u);
    let cells = mul(inc(m), width);
    // `previous` and `current` are the two halves of one buffer.
    let mut table = zeros(mul(2, cells));
    let mut prev: u64 = 0;
    let mut cur: u64 = cells;
    for j in 0..inc(m) {
        table.try_set(add(prev, mul(j, width)), 1);
    }
    for i in 1..inc(n) {
        for c in 0..cells {
            table.try_set(add(cur, c), 0);
        }
        table.try_set(cur, 1);
        for j in 1..inc(m) {
            for u in 0..inc(mul(i, j)) {
                let from_second = cu(in table, add(cur, add(mul(dec(j), width), u)));
                let from_first = if u >= j {
                    cu(in table, add(prev, sub(add(mul(j, width), u), j)))
                } else {
                    0
                };
                table.try_set(add(cur, add(mul(j, width), u)), cadd(from_second, from_first));
            }
        }
        let t = prev;
        prev = cur;
        cur = t;
    }
    let base = add(prev, mul(m, width));
    let mut denominator: u64 = 0;
    let mut tail: u64 = 0;
    let tail_limit = min_u64(observed, sub(max_u, observed));
    for u in 0..width {
        let count = cu(in table, add(base, u));
        denominator = cadd(denominator, count);
        if u <= tail_limit {
            tail = cadd(tail, count);
        }
    }
    ExactMw {
        u_first: observed,
        numerator: min_u64(cadd(tail, tail), denominator),
        denominator: denominator
    }
}

pub fn do_mann_whitney_exact_with_ties(in first: Slice[u64], in second: Slice[u64])
    -> ExactMw eff [Fail[PortError]] {
    let n = first.len();
    let m = second.len();
    check_exact_sizes(n, m);
    let total_count = add(n, m);
    let pooled = pooled_sorted(in first, in second);
    let width = inc(mul(mul(2, n), total_count));
    let mut counts = zeros(mul(inc(n), width));
    counts.try_set(0, 1);
    let mut processed: u64 = 0;
    let mut start: u64 = 0;
    loop {
        if start >= total_count {
            break;
        }
        let value = cu(in pooled, start);
        let mut end = inc(start);
        loop {
            if end >= total_count || cu(in pooled, end) != value {
                break;
            }
            end = inc(end);
        }
        let doubled_rank = add(inc(start), end);
        for k in start..end {
            processed = inc(processed);
            let mut selected = inc(min_u64(n, processed));
            loop {
                selected = dec(selected);
                if selected == 0 {
                    break;
                }
                let from = mul(dec(selected), width);
                let to = mul(selected, width);
                for sum in doubled_rank..width {
                    let add_v = cu(in counts, add(from, sub(sum, doubled_rank)));
                    let at = add(to, sum);
                    counts.try_set(at, cadd(cu(in counts, at), add_v));
                }
            }
        }
        start = end;
    }
    let twice_u_first = do_mann_whitney_ranks(in first, in second).twice_u_first;
    let observed = cadd(twice_u_first, mul(n, inc(n)));
    let base = mul(n, width);
    let mut lower: u64 = 0;
    let mut upper: u64 = 0;
    let mut denominator: u64 = 0;
    for sum in 0..width {
        let count = cu(in counts, add(base, sum));
        denominator = cadd(denominator, count);
        if sum <= observed {
            lower = cadd(lower, count);
        }
        if sum >= observed {
            upper = cadd(upper, count);
        }
    }
    let low = min_u64(lower, upper);
    ExactMw {
        u_first: twice_u_first,
        numerator: min_u64(cadd(low, low), denominator),
        denominator: denominator
    }
}

// ---------------------------------------------------------------------------
// contract.rs PairedSample

pub fn do_paired_sample_new(baseline: u64, candidate: u64, operations: u64)
    -> Sample eff [Fail[PortError]] {
    if baseline == 0 || candidate == 0 || operations == 0 {
        Fail::raise(PortError::NonPositiveEvidence);
    }
    Sample {
        baseline: baseline,
        candidate: candidate,
        operations: operations
    }
}

// Directed rounding of the regression in basis points, floor and ceiling.
pub fn do_regression_bp_bounds(s: Sample) -> BpBounds {
    if s.baseline == 0 {
        let scaled = w_mul_small(w_sub(w_u64(s.candidate), w_u64(s.baseline)), BP_SCALE);
        let (q, r) = w_floor_divrem(scaled, w_u64(s.baseline));
        return BpBounds {
            floor: q,
            ceil: if w_is_zero(r) {
                q
            } else {
                w_add(q, w_u64(1))
            }
        };
    }
    // |candidate - baseline| * BP_SCALE / baseline in native u128, then the
    // sign: floor(-x) = -ceil(x).
    let up = s.candidate >= s.baseline;
    let magnitude = if up {
        wrapping_sub(s.candidate, s.baseline)
    } else {
        wrapping_sub(s.baseline, s.candidate)
    };
    let (q, exact) = udiv_u128(
        wrapping_mul(widen_u128(magnitude), widen_u128(BP_SCALE)),
        s.baseline
    );
    let down = w_from_u128(q);
    let away = if exact {
        down
    } else {
        w_add(down, w_u64(1))
    };
    if up {
        BpBounds {
            floor: down,
            ceil: away
        }
    } else {
        BpBounds {
            floor: w_neg(away),
            ceil: w_neg(down)
        }
    }
}

// The exact ratio order candidate/baseline (-1, 0, 1).

// candidate/baseline against 1 + bp/BP_SCALE, for bp >= MIN_REGRESSION_BP.
fn compare_threshold(s: Sample, bp: i64) -> i64 {
    let factor = wrapping_add(wrapping_u64(bp), BP_SCALE);
    w_ucmp(w_mul_u64(s.candidate, BP_SCALE), w_mul_u64(s.baseline, factor))
}

// A stable bottom-up merge sort by ratio (Rust `sort_by` is stable, and
// the interval reports the samples themselves, so equal ratios keep their
// input order): runs of width 1, 2, 4, ... of sample positions merge from
// `src` into `dst`, taking the left run's position on a tie. The keys sit
// in two word sequences and the cross products are native `u128`, so a
// merge step moves one word instead of a `Sample`.
fn sorted_by_ratio(in samples: Slice[Sample]) -> ChunkSeq[Sample] {
    let n = samples.len();
    let mut base: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](n);
    let mut cand: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](n);
    let mut src: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](n);
    let mut dst: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](n);
    for i in 0..n {
        let x = gs(in samples, i);
        base.push(x.baseline);
        cand.push(x.candidate);
        src.push(i);
        dst.push(i);
    }
    let mut width: u64 = 1;
    loop {
        if width >= n {
            break;
        }
        let mut lo: u64 = 0;
        loop {
            if lo >= n {
                break;
            }
            let mid = min_u64(add(lo, width), n);
            let hi = min_u64(add(mid, width), n);
            let mut i = lo;
            let mut j = mid;
            let mut k = lo;
            loop {
                if k >= hi {
                    break;
                }
                let take_left = if i < mid && j < hi {
                    let a = cu(in src, i);
                    let b = cu(in src, j);
                    let left = wrapping_mul(widen_u128(cu(in cand, a)), widen_u128(cu(in base, b)));
                    let right = wrapping_mul(
                        widen_u128(cu(in cand, b)),
                        widen_u128(cu(in base, a))
                    );
                    left <= right
                } else {
                    i < mid
                };
                if take_left {
                    let at = cu(in src, i);
                    dst.try_set(k, at);
                    i = inc(i);
                } else {
                    let at = cu(in src, j);
                    dst.try_set(k, at);
                    j = inc(j);
                }
                k = inc(k);
            }
            lo = hi;
        }
        swap(inout src, inout dst);
        width = add(width, width);
    }
    let mut out: ChunkSeq[Sample] = ChunkSeq::with_capacity[Sample](n);
    for i in 0..n {
        out.push(gs(in samples, cu(in src, i)));
    }
    out
}

// Decision codes are the crate's `Decision`; reasons are Reason codes.
pub fn do_analyze_pairs(in samples: Slice[Sample], max_regression_bp: i64)
    -> AnalysisOut eff [Fail[PortError]] {
    let n = samples.len();
    if n == 0 {
        Fail::raise(PortError::EmptyEvidence);
    }
    if n > MAX_EPOCHS {
        Fail::raise(
            PortError::Limit {
                code: Limit::Epochs
            }
        );
    }
    if max_regression_bp < MIN_REGRESSION_BP {
        Fail::raise(PortError::InvalidThreshold);
    }
    let sorted = sorted_by_ratio(in samples);
    let median_lower = cs(in sorted, div(dec(n), 2));
    let median_upper = cs(in sorted, div(n, 2));
    let total = if n == MAX_EPOCHS {
        w(1, 0)
    } else {
        w_u64(pow2(n))
    };
    let mut coefficient = w_u64(1);
    let mut tail = w_zero();
    let mut found = false;
    let mut rank: u64 = 0;
    let mut chosen_tail = w_zero();
    for j in 0..div(n, 2) {
        tail = w_add(tail, coefficient);
        if !w_ult(
            w_mul_small(total, ALPHA_TAIL_NUMERATOR),
            w_mul_small(tail, ALPHA_TAIL_DENOMINATOR)
        ) {
            found = true;
            rank = inc(j);
            chosen_tail = tail;
        } else {
            break;
        }
        let (q, r) = w_udivrem(w_mul_small(coefficient, sub(n, j)), w_u64(inc(j)));
        coefficient = q;
    }
    if !found {
        return AnalysisOut {
            decision: Decision::Inconclusive,
            reason: Reason::InsufficientEpochs,
            median_lower: median_lower,
            median_upper: median_upper,
            has_interval: false,
            lower: no_sample(),
            upper: no_sample(),
            lower_rank: widen_usize(0),
            upper_rank: widen_usize(0),
            covered_outcomes: w_zero(),
            total_outcomes: w_zero()
        };
    }
    let lower = cs(in sorted, dec(rank));
    let upper = cs(in sorted, sub(n, rank));
    let (decision, reason): (Decision, u64) = if compare_threshold(upper, max_regression_bp) != 1 {
        (Decision::Pass, Reason::None)
    } else if compare_threshold(lower, max_regression_bp) == 1 {
        (Decision::Regression, Reason::None)
    } else {
        (Decision::Inconclusive, Reason::IntervalCrossesThreshold)
    };
    AnalysisOut {
        decision: decision,
        reason: reason,
        median_lower: median_lower,
        median_upper: median_upper,
        has_interval: true,
        lower: lower,
        upper: upper,
        lower_rank: widen_usize(rank),
        upper_rank: widen_usize(inc(sub(n, rank))),
        covered_outcomes: w_sub(total, w_twice(chosen_tail)),
        total_outcomes: total
    }
}

// ---------------------------------------------------------------------------
// layout.rs

pub fn do_layout_survival(in per_layout: Slice[Sample]) -> SurvivalOut eff [Fail[PortError]] {
    if per_layout.len() > MAX_EPOCHS {
        Fail::raise(
            PortError::Limit {
                code: Limit::Layouts
            }
        );
    }
    let analysis = do_analyze_pairs(in per_layout, 0);
    let verdict: u64 = if !analysis.has_interval {
        Verdict::InsufficientLayouts
    } else {
        match analysis.decision {
            Decision::Regression => Verdict::CandidateSlower,
            _ => if analysis.upper.candidate < analysis.upper.baseline {
                Verdict::CandidateFaster
            } else {
                Verdict::DoesNotSurvive
            },
        }
    };
    SurvivalOut {
        verdict: verdict,
        analysis: analysis
    }
}

// Every measured epoch of one run summed into one paired sample.
pub fn do_layout_sample(in pairs: Slice[Sample]) -> Sample eff [Fail[PortError]] {
    let mut baseline: u64 = 0;
    let mut candidate: u64 = 0;
    let mut operations: u64 = 0;
    for i in 0..pairs.len() {
        let p = gs(in pairs, i);
        baseline = cadd(baseline, p.baseline);
        candidate = cadd(candidate, p.candidate);
        operations = cadd(operations, p.operations);
    }
    do_paired_sample_new(baseline, candidate, operations)
}
