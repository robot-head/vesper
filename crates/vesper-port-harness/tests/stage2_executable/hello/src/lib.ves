// An executable whose main calls a local function; exits 42.
// Arithmetic is wrapping: Stage 2's checker does not yet mark checked
// `+` as fallible like Rust's (#2691), so the body hook refuses it.
fn add(a: u64, b: u64) -> u64 {
    wrapping_add(a, b)
}

pub fn main() -> u64 {
    add(40, 2)
}
