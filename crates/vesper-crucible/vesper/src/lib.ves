// Vesper port of vesper-crucible (port wave P1 lane 18, #915), part 1: the
// choice tape (src/tape.rs), the SplitMix64 generator (src/rng.rs), the draw
// decision of a `Source` (src/source.rs `raw`) and the shrinker
// (src/shrink.rs) as a step machine. The Rust files are the model.
//
// Property bodies are Rust closures, so control is inverted: the shrinker
// proposes the next candidate tape (`shrinker_next`, `shrinker_candidate`),
// the Rust wrapper runs the property on it, and reports the outcome back
// (`shrinker_record`). The wrapper keeps only the closure loop and the
// failure value; every choice of what to try next is made here.
//
// Codes shared with the wrapper:
// - `Draw.code`: 0 ok (`value`), 1 Overrun.
// - `shrinker_record` outcome: 0 failed with the shrunk kind, 1 invalid,
//   2 passed or failed with another kind.
// - `Parsed.code`: 0 ok, 1 MissingHeader, 2 UnknownHeader (`start`/`end`
//   are the trimmed header's byte range), 3 BadValue (`index`), 4 TooLong.
// @export abi 3

// ---------------------------------------------------------------------------
// Helpers.

fn max_u64() -> u64 {
    18446744073709551615
}

fn at(in s: Slice[u64], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

fn atb(in s: Slice[bool], i: u64) -> bool {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => false,
    }
}

fn byte(in s: Slice[u8], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(v) => widen_u64(v),
        Option::None => 0,
    }
}

fn inc(x: u64) -> u64 {
    wrapping_add(x, 1)
}

fn min_u64(a: u64, b: u64) -> u64 {
    if a < b {
        a
    } else {
        b
    }
}

// `a % b` for `b > 0`.
fn rem(a: u64, b: u64) -> u64 {
    if b == 0 {
        return 0;
    }
    handle Fail[RuntimeError] in {
        a % b
    } with {
        return v => v,
        raise(e, k) => 0,
    }
}

fn copy_of(in s: Slice[u64]) -> ChunkSeq[u64] {
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for i in 0..s.len() {
        out.push(at(in s, i));
    }
    out
}

// ---------------------------------------------------------------------------
// The shrink key (src/tape.rs `ShrinkKey`): length, then the sum of the
// choices, held as two words because the sum needs up to 84 bits.

pub copy struct Key {
    len: u64,
    hi: u64,
    lo: u64
}

pub fn tape_key(in values: Slice[u64]) -> Key {
    let n = values.len();
    let mut hi: u64 = 0;
    let mut lo: u64 = 0;
    for i in 0..n {
        let next = wrapping_add(lo, at(in values, i));
        if next < lo {
            hi = inc(hi);
        }
        lo = next;
    }
    Key {
        len: n,
        hi: hi,
        lo: lo
    }
}

// Strictly smaller in the `(len, sum)` lexicographic order.
pub fn key_smaller(a: Key, b: Key) -> bool {
    if a.len != b.len {
        a.len < b.len
    } else if a.hi != b.hi {
        a.hi < b.hi
    } else {
        a.lo < b.lo
    }
}

// ---------------------------------------------------------------------------
// SplitMix64 (src/rng.rs).

pub copy struct Rng {
    word: u64
}

pub fn rng_next(inout r: Rng) -> u64 {
    r.word = wrapping_add(r.word, 0x9e3779b97f4a7c15);
    let mut z = r.word;
    z = wrapping_mul(z ^ (z >> 30), 0xbf58476d1ce4e5b9);
    z = wrapping_mul(z ^ (z >> 27), 0x94d049bb133111eb);
    z ^ (z >> 31)
}

// Uniform in `0..=max_inclusive`, by rejection sampling.
pub fn rng_below_inclusive(inout r: Rng, max_inclusive: u64) -> u64 {
    if max_inclusive == max_u64() {
        return rng_next(inout r);
    }
    let bound = inc(max_inclusive);
    let threshold = rem(wrapping_sub(0, bound), bound);
    loop {
        let value = rng_next(inout r);
        if value >= threshold {
            break rem(value, bound);
        }
    }
}

// True with probability `numerator / 1024`.
pub fn rng_chance(inout r: Rng, numerator: u64) -> bool {
    rng_below_inclusive(inout r, 1023) < numerator
}

// ---------------------------------------------------------------------------
// One draw of a `Source` (src/source.rs `Source::raw`): the replayed value
// clamped to `max`, an overrun, or a fresh value. The wrapper keeps the
// realized tape and the draw kinds.

pub copy struct Draw {
    code: u64,
    value: u64
}

// `random` false is strict replay. `bernoulli` true draws 1 with
// probability `n / 1024`, else the draw is uniform in `0..=max`.
pub fn source_draw(
    inout r: Rng,
    in prefix: Slice[u64],
    pos: u64,
    max_draws: u64,
    max: u64,
    random: bool,
    bernoulli: bool,
    n: u64
) -> Draw {
    if pos >= max_draws {
        return Draw {
            code: 1,
            value: 0
        };
    }
    match prefix.try_get(pos) {
        Option::Some(v) => Draw {
            code: 0,
            value: min_u64(v, max)
        },
        Option::None => {
            if !random {
                Draw {
                    code: 1,
                    value: 0
                }
            } else if bernoulli {
                let one: u64 = if rng_chance(inout r, n) {
                    1
                } else {
                    0
                };
                Draw {
                    code: 0,
                    value: min_u64(one, max)
                }
            } else {
                Draw {
                    code: 0,
                    value: rng_below_inclusive(inout r, max)
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// The saved-tape text format (src/tape.rs `to_text`, `from_text`).

fn header() -> ChunkSeq[u8] {
    // "vesper-crucible-tape/1"
    let mut h: ChunkSeq[u8] = ChunkSeq::new[u8]();
    h.push(118);
    h.push(101);
    h.push(115);
    h.push(112);
    h.push(101);
    h.push(114);
    h.push(45);
    h.push(99);
    h.push(114);
    h.push(117);
    h.push(99);
    h.push(105);
    h.push(98);
    h.push(108);
    h.push(101);
    h.push(45);
    h.push(116);
    h.push(97);
    h.push(112);
    h.push(101);
    h.push(47);
    h.push(49);
    h
}

fn hex_digit(d: u64) -> u8 {
    if d < 10 {
        wrapping_u8(wrapping_add(d, 48))
    } else {
        wrapping_u8(wrapping_add(d, 87))
    }
}

// The header line, then one lowercase hex value per line.
pub fn tape_to_text(in values: Slice[u64]) -> ChunkSeq[u8] {
    let mut out = header();
    out.push(10);
    for i in 0..values.len() {
        let mut v = at(in values, i);
        let start = out.len();
        loop {
            out.push(hex_digit(v & 15));
            v = v >> 4;
            if v == 0 {
                break;
            }
        }
        // The digits went in least significant first.
        let mut lo = start;
        let mut hi = wrapping_sub(out.len(), 1);
        loop {
            if lo >= hi {
                break;
            }
            let x = match out.try_get(lo) {
                Option::Some(d) => d,
                Option::None => 0,
            };
            let y = match out.try_get(hi) {
                Option::Some(d) => d,
                Option::None => 0,
            };
            out.try_set(lo, y);
            out.try_set(hi, x);
            lo = inc(lo);
            hi = wrapping_sub(hi, 1);
        }
        out.push(10);
    }
    out
}

// The length of the Unicode White_Space character (what Rust's `str::trim`
// removes) that starts at `i`, or 0.
fn space_at(in s: Slice[u8], i: u64, end: u64) -> u64 {
    if i >= end {
        return 0;
    }
    let a = byte(in s, i);
    if (a >= 9 && a <= 13) || a == 32 {
        return 1;
    }
    if a == 0xc2 && inc(i) < end {
        let b = byte(in s, inc(i));
        if b == 0x85 || b == 0xa0 {
            return 2;
        }
        return 0;
    }
    if (a == 0xe1 || a == 0xe2 || a == 0xe3) && wrapping_add(i, 2) < end {
        let b = byte(in s, inc(i));
        let c = byte(in s, wrapping_add(i, 2));
        let hit = if a == 0xe1 {
            b == 0x9a && c == 0x80
        } else if a == 0xe3 {
            b == 0x80 && c == 0x80
        } else if b == 0x80 {
            c <= 0x8a || c == 0xa8 || c == 0xa9 || c == 0xaf
        } else {
            b == 0x81 && c == 0x9f
        };
        if hit {
            return 3;
        }
    }
    0
}

// The length of the White_Space character that ends just before `end`, or 0.
fn space_before(in s: Slice[u8], start: u64, end: u64) -> u64 {
    if end <= start {
        return 0;
    }
    let one = wrapping_sub(end, 1);
    if space_at(in s, one, end) == 1 {
        return 1;
    }
    if end >= wrapping_add(start, 2) && space_at(in s, wrapping_sub(end, 2), end) == 2 {
        return 2;
    }
    if end >= wrapping_add(start, 3) && space_at(in s, wrapping_sub(end, 3), end) == 3 {
        return 3;
    }
    0
}

pub struct Parsed {
    code: u64,
    index: u64,
    start: u64,
    end: u64,
    values: ChunkSeq[u64]
}

fn parsed(code: u64, index: u64, start: u64, end: u64, sink values: ChunkSeq[u64]) -> Parsed {
    Parsed {
        code: code,
        index: index,
        start: start,
        end: end,
        values: values
    }
}

// The value of `s[start..end]` as 1-16 lowercase hex digits, or `max_u64()`
// with `ok` false.
fn hex_value(in s: Slice[u8], start: u64, end: u64) -> (bool, u64) {
    let n = wrapping_sub(end, start);
    if n == 0 || n > 16 {
        return (false, 0);
    }
    let mut v: u64 = 0;
    let mut i = start;
    loop {
        if i >= end {
            break(true, v);
        }
        let c = byte(in s, i);
        let d = if c >= 48 && c <= 57 {
            wrapping_sub(c, 48)
        } else if c >= 97 && c <= 102 {
            wrapping_sub(c, 87)
        } else {
            16
        };
        if d == 16 {
            break(false, 0);
        }
        v = (v << 4) | d;
        i = inc(i);
    }
}

// Blank lines are ignored; every other line after the header must be 1-16
// lowercase hex digits. Never fails on untrusted text: errors are codes.
pub fn tape_parse(in text: Str, max_len: u64) -> Parsed {
    parse_bytes(in text.as_bytes(), max_len)
}

fn parse_bytes(in s: Slice[u8], max_len: u64) -> Parsed {
    let total = s.len();
    let mut pos: u64 = 0;
    let mut seen_header = false;
    let mut values: ChunkSeq[u64] = ChunkSeq::new[u64]();
    loop {
        if pos >= total {
            break;
        }
        // The line `s[pos..stop]`, without its `\n`.
        let mut stop = pos;
        loop {
            if stop >= total || byte(in s, stop) == 10 {
                break;
            }
            stop = inc(stop);
        }
        let next = inc(stop);
        let mut a = pos;
        loop {
            let w = space_at(in s, a, stop);
            if w == 0 {
                break;
            }
            a = wrapping_add(a, w);
        }
        let mut b = stop;
        loop {
            let w = space_before(in s, a, b);
            if w == 0 {
                break;
            }
            b = wrapping_sub(b, w);
        }
        if a < b {
            if !seen_header {
                let h = header();
                let hn = h.len();
                let mut same = wrapping_sub(b, a) == hn;
                let mut i: u64 = 0;
                loop {
                    if !same || i >= hn {
                        break;
                    }
                    let want = match h.try_get(i) {
                        Option::Some(x) => widen_u64(x),
                        Option::None => 0,
                    };
                    same = byte(in s, wrapping_add(a, i)) == want;
                    i = inc(i);
                }
                if !same {
                    return parsed(2, 0, a, b, values);
                }
                seen_header = true;
            } else {
                let index = values.len();
                if index == max_len {
                    return parsed(4, 0, 0, 0, values);
                }
                let (ok, v) = hex_value(in s, a, b);
                if !ok {
                    return parsed(3, index, 0, 0, values);
                }
                values.push(v);
            }
        }
        pos = next;
    }
    if !seen_header {
        return parsed(1, 0, 0, 0, values);
    }
    parsed(0, 0, 0, 0, values)
}

// ---------------------------------------------------------------------------
// The shrinker (src/shrink.rs `Reducer`) as a step machine. `pc` is the
// point of the pass loops to continue from; an attempt that needs a
// property run stops the machine there with the candidate in `cand`, and
// `shrinker_record` resumes it at `after` with the result in `res`.
//
// pc: 1 round start, 2-4 span deletion, 5-7 span zeroing, 8-13 value
// lowering (8 next value, 9-10 small values, 11-13 binary search), 14-16
// lower-and-delete, 17 round end, 18 done, 19 waiting for an outcome.

pub copy struct Stats {
    runs: u64,
    accepted: u64,
    invalid: u64,
    not_reproducing: u64,
    budget_exhausted: bool
}

pub struct Shrinker {
    best: ChunkSeq[u64],
    cand: ChunkSeq[u64],
    max_runs: u64,
    stats: Stats,
    pc: u64,
    after: u64,
    res: bool,
    improved: bool,
    chunk: u64,
    idx: u64,
    wi: u64,
    width: u64,
    i: u64,
    small: u64,
    small_end: u64,
    lo: u64,
    hi: u64,
    mid: u64,
    k: u64
}

// The shrinker for a tape that failed on its first run (which counts as
// one run).
pub fn shrinker_new(sink best: ChunkSeq[u64], max_runs: u64) -> Shrinker {
    Shrinker {
        best: best,
        cand: ChunkSeq::new[u64](),
        max_runs: max_runs,
        stats: Stats {
            runs: 1,
            accepted: 0,
            invalid: 0,
            not_reproducing: 0,
            budget_exhausted: false
        },
        pc: 1,
        after: 0,
        res: false,
        improved: false,
        chunk: 0,
        idx: 0,
        wi: 0,
        width: 0,
        i: 0,
        small: 0,
        small_end: 0,
        lo: 0,
        hi: 0,
        mid: 0,
        k: 0
    }
}

fn zero_width(wi: u64) -> u64 {
    if wi == 0 {
        8
    } else if wi == 1 {
        4
    } else {
        2
    }
}

impl Shrinker {
    fn out_of_budget(inout self) -> bool {
        if self.stats.runs >= self.max_runs {
            self.stats.budget_exhausted = true;
        }
        self.stats.budget_exhausted
    }

    fn best_at(in self, i: u64) -> u64 {
        at(in self.best.as_slice(), i)
    }

    fn cand_from_best(inout self) {
        self.cand.clear();
        let n = self.best.len();
        for j in 0..n {
            self.cand.push(at(in self.best.as_slice(), j));
        }
    }

    // `cand` = `best` without `best[from..to]`.
    fn cand_without(inout self, from: u64, to: u64) {
        self.cand.clear();
        let n = self.best.len();
        for j in 0..n {
            if j < from || j >= to {
                self.cand.push(at(in self.best.as_slice(), j));
            }
        }
    }

    // Start an attempt of `cand`, to continue at `after`. True when the
    // property must run on it; otherwise the attempt failed without a run.
    fn attempt(inout self, after: u64) -> bool {
        self.after = after;
        let smaller = key_smaller(
            tape_key(in self.cand.as_slice()),
            tape_key(in self.best.as_slice())
        );
        if !smaller || self.out_of_budget() {
            self.res = false;
            self.pc = after;
            return false;
        }
        self.stats.runs = inc(self.stats.runs);
        self.pc = 19;
        true
    }

    // Run the machine to the next candidate (true) or to the end (false).
    fn advance(inout self) -> bool {
        loop {
            let pc = self.pc;
            if pc >= 18 {
                // 18 done; 19 waits for `shrinker_record`.
                break false;
            }
            let ready = if pc <= 4 {
                self.step_delete(pc)
            } else if pc <= 7 {
                self.step_zero(pc)
            } else if pc <= 10 {
                self.step_small(pc)
            } else if pc <= 13 {
                self.step_binary(pc)
            } else {
                self.step_lower_delete(pc)
            };
            if ready {
                break true;
            }
        }
    }

    // pc 1-4: round start and span deletion.
    fn step_delete(inout self, pc: u64) -> bool {
        let n = self.best.len();
        if pc == 1 {
            self.improved = false;
            self.chunk = n >> 1;
            self.pc = 2;
            return false;
        }
        if pc == 2 {
            if self.chunk > 0 {
                self.idx = 0;
                self.pc = 3;
            } else {
                self.wi = 0;
                self.pc = 5;
            }
            return false;
        }
        if pc == 3 {
            if wrapping_add(self.idx, self.chunk) <= n && !self.out_of_budget() {
                let from = self.idx;
                let to = wrapping_add(from, self.chunk);
                self.cand_without(from, to);
                return self.attempt(4);
            }
            self.chunk = self.chunk >> 1;
            self.pc = 2;
            return false;
        }
        if self.res {
            self.improved = true;
        } else {
            self.idx = inc(self.idx);
        }
        self.pc = 3;
        false
    }

    // pc 5-7: span zeroing.
    fn step_zero(inout self, pc: u64) -> bool {
        let n = self.best.len();
        if pc == 5 {
            if self.wi < 3 {
                self.width = zero_width(self.wi);
                self.idx = 0;
                self.pc = 6;
            } else {
                self.i = 0;
                self.pc = 8;
            }
            return false;
        }
        if pc == 6 {
            if wrapping_add(self.idx, self.width) <= n && !self.out_of_budget() {
                let from = self.idx;
                let to = wrapping_add(from, self.width);
                let mut nonzero = false;
                for j in from..to {
                    if self.best_at(j) != 0 {
                        nonzero = true;
                    }
                }
                if !nonzero {
                    self.idx = inc(self.idx);
                    return false;
                }
                self.cand_from_best();
                for j in from..to {
                    self.cand.try_set(j, 0);
                }
                return self.attempt(7);
            }
            self.wi = inc(self.wi);
            self.pc = 5;
            return false;
        }
        if self.res {
            self.improved = true;
        }
        self.idx = inc(self.idx);
        self.pc = 6;
        false
    }

    // pc 8-10: the next value to lower, and its small values first.
    fn step_small(inout self, pc: u64) -> bool {
        let n = self.best.len();
        if pc == 8 {
            if self.i < n && !self.out_of_budget() {
                self.small = 0;
                self.small_end = min_u64(self.best_at(self.i), 8);
                self.pc = 9;
            } else {
                self.i = 0;
                self.pc = 14;
            }
            return false;
        }
        if pc == 9 {
            if self.small >= self.small_end || self.i >= n || self.small >= self.best_at(self.i) {
                self.pc = 11;
                return false;
            }
            self.cand_from_best();
            self.cand.try_set(self.i, self.small);
            return self.attempt(10);
        }
        if self.res {
            self.improved = true;
            self.pc = 11;
        } else {
            self.small = inc(self.small);
            self.pc = 9;
        }
        false
    }

    // pc 11-13: binary-search lowering of one value.
    fn step_binary(inout self, pc: u64) -> bool {
        let n = self.best.len();
        if pc == 11 {
            if self.i >= n {
                self.i = 0;
                self.pc = 14;
            } else {
                self.lo = 0;
                self.hi = self.best_at(self.i);
                self.pc = 12;
            }
            return false;
        }
        if pc == 12 {
            if self.lo < self.hi && self.i < n && !self.out_of_budget() {
                self.mid = wrapping_add(self.lo, wrapping_sub(self.hi, self.lo) >> 1);
                self.cand_from_best();
                self.cand.try_set(self.i, self.mid);
                return self.attempt(13);
            }
            self.i = inc(self.i);
            self.pc = 8;
            return false;
        }
        if self.res {
            self.improved = true;
            self.hi = min_u64(self.best_at(self.i), self.mid);
        } else {
            self.lo = inc(self.mid);
        }
        self.pc = 12;
        false
    }

    // pc 14-17: lower a count and delete what follows, then the round end.
    fn step_lower_delete(inout self, pc: u64) -> bool {
        let n = self.best.len();
        if pc == 14 {
            if self.i < n && !self.out_of_budget() {
                if self.best_at(self.i) > 0 {
                    self.k = 1;
                    self.pc = 15;
                } else {
                    self.i = inc(self.i);
                }
            } else {
                self.pc = 17;
            }
            return false;
        }
        if pc == 15 {
            let from = inc(self.i);
            let to = wrapping_add(from, self.k);
            if self.k > 8 || to > n || self.out_of_budget() {
                self.i = inc(self.i);
                self.pc = 14;
                return false;
            }
            self.cand_without(from, to);
            let lowered = wrapping_sub(self.best_at(self.i), 1);
            self.cand.try_set(self.i, lowered);
            return self.attempt(16);
        }
        if pc == 16 {
            if self.res {
                self.improved = true;
                self.i = inc(self.i);
                self.pc = 14;
            } else {
                self.k = inc(self.k);
                self.pc = 15;
            }
            return false;
        }
        if !self.improved || self.out_of_budget() {
            self.pc = 18;
        } else {
            self.pc = 1;
        }
        false
    }
}

// Advance to the next candidate: true when `shrinker_candidate` holds one
// to run, false when shrinking is over.
pub fn shrinker_next(inout s: Shrinker) -> bool {
    s.advance()
}

pub fn shrinker_candidate(in s: Shrinker) -> ChunkSeq[u64] {
    copy_of(in s.cand.as_slice())
}

// Report the run of the candidate: `outcome` as in the header, `realized`
// the tape the run consumed. True when the run is the new best.
pub fn shrinker_record(inout s: Shrinker, outcome: u64, in realized: Slice[u64]) -> bool {
    if s.pc != 19 {
        return false;
    }
    let mut accepted = false;
    if outcome == 0 {
        if key_smaller(tape_key(in realized), tape_key(in s.best.as_slice())) {
            // Refilled in place: the buffer is reused and nothing is
            // dropped by assignment.
            s.best.clear();
            for j in 0..realized.len() {
                s.best.push(at(in realized, j));
            }
            s.stats.accepted = inc(s.stats.accepted);
            accepted = true;
        }
    } else if outcome == 1 {
        s.stats.invalid = inc(s.stats.invalid);
    } else {
        s.stats.not_reproducing = inc(s.stats.not_reproducing);
    }
    s.res = accepted;
    s.pc = s.after;
    accepted
}

pub fn shrinker_stats(in s: Shrinker) -> Stats {
    s.stats
}

pub fn shrinker_best(in s: Shrinker) -> ChunkSeq[u64] {
    copy_of(in s.best.as_slice())
}

// ---------------------------------------------------------------------------
// The fuzzer (src/fuzz.rs `Fuzzer`) as a step machine. `fuzzer_next` picks
// the next run (a fresh random run, a solver candidate or a mutation of a
// corpus entry) and its source seed; the wrapper runs the property with
// `Source::build_random(candidate, seed, ..)` and reports the verdict and
// the run's coverage features (`fuzzer_observe`), and, for a run that
// joins the corpus, its tape, draw kinds and comparisons (`fuzzer_keep`).
//
// Feature words come in pairs `(key, value)`: key tag 0 an edge, 1 a
// comparison outcome (both with value 0), 2 operand closeness of site
// `key & 0xffffffff` with the closeness in `value`.
// Draw kind tags: 0 value, 1 byte, 2 flag, 3 schedule.
// Comparison words: `0, kind, lhs, rhs` for integers (kind 0 Eq, 1 Ne,
// 2-5 orderings), `1, nl, nr, lhs bytes.., rhs bytes..` for byte strings.

pub copy struct FuzzStats {
    execs: u64,
    invalid: u64,
    solver_runs: u64,
    solver_hits: u64,
    features: u64
}

pub struct Fuzzer {
    rng: Rng,
    max_execs: u64,
    random: bool,
    initial_random: u64,
    max_solver: u64,
    stats: FuzzStats,
    found: bool,
    seen: ChunkSeq[u64],
    close_site: ChunkSeq[u64],
    close_val: ChunkSeq[u64],
    // Corpus entry `e` is `c_vals[c_off[e]..c_off[e + 1]]`, with its draw
    // kinds at the same positions, and its comparison words at
    // `c_cmps[c_cmp_off[e]..c_cmp_off[e + 1]]`.
    c_off: ChunkSeq[u64],
    c_vals: ChunkSeq[u64],
    c_max: ChunkSeq[u64],
    c_tag: ChunkSeq[u64],
    c_cmp_off: ChunkSeq[u64],
    c_cmps: ChunkSeq[u64],
    c_solved: ChunkSeq[bool],
    // Solver candidates of the entry in progress: rows of `width` choices,
    // kept sorted and unique through `order`, run in that order from `k`.
    in_solver: bool,
    width: u64,
    cands: ChunkSeq[u64],
    order: ChunkSeq[u64],
    k: u64,
    full: bool,
    lane: ChunkSeq[u64],
    scratch: ChunkSeq[u64],
    // The run handed out by `fuzzer_next`.
    cur: ChunkSeq[u64],
    seed: u64,
    solver_run: bool
}

pub fn fuzzer_new(seed: u64, max_execs: u64, random: bool, initial_random: u64, max_solver: u64)
    -> Fuzzer {
    let mut c_off: ChunkSeq[u64] = ChunkSeq::new[u64]();
    c_off.push(0);
    let mut c_cmp_off: ChunkSeq[u64] = ChunkSeq::new[u64]();
    c_cmp_off.push(0);
    Fuzzer {
        rng: Rng {
            word: seed
        },
        max_execs: max_execs,
        random: random,
        initial_random: initial_random,
        max_solver: max_solver,
        stats: FuzzStats {
            execs: 0,
            invalid: 0,
            solver_runs: 0,
            solver_hits: 0,
            features: 0
        },
        found: false,
        seen: ChunkSeq::new[u64](),
        close_site: ChunkSeq::new[u64](),
        close_val: ChunkSeq::new[u64](),
        c_off: c_off,
        c_vals: ChunkSeq::new[u64](),
        c_max: ChunkSeq::new[u64](),
        c_tag: ChunkSeq::new[u64](),
        c_cmp_off: c_cmp_off,
        c_cmps: ChunkSeq::new[u64](),
        c_solved: ChunkSeq::new[bool](),
        in_solver: false,
        width: 0,
        cands: ChunkSeq::new[u64](),
        order: ChunkSeq::new[u64](),
        k: 0,
        full: false,
        lane: ChunkSeq::new[u64](),
        scratch: ChunkSeq::new[u64](),
        cur: ChunkSeq::new[u64](),
        seed: 0,
        solver_run: false
    }
}

// The first position of `in s` (sorted) not below `x`.
fn lower_bound(in s: Slice[u64], x: u64) -> u64 {
    let mut lo: u64 = 0;
    let mut hi = s.len();
    loop {
        if lo >= hi {
            break lo;
        }
        let mid = wrapping_add(lo, wrapping_sub(hi, lo) >> 1);
        if at(in s, mid) < x {
            lo = inc(mid);
        } else {
            hi = mid;
        }
    }
}

// Insert `x` into the sorted `s`; true when it was not there.
fn set_insert(inout s: ChunkSeq[u64], x: u64) -> bool {
    let pos = lower_bound(in s.as_slice(), x);
    if pos < s.len() && at(in s.as_slice(), pos) == x {
        return false;
    }
    s.push(0);
    let mut j = wrapping_sub(s.len(), 1);
    loop {
        if j <= pos {
            break;
        }
        let prev = at(in s.as_slice(), wrapping_sub(j, 1));
        s.try_set(j, prev);
        j = wrapping_sub(j, 1);
    }
    s.try_set(pos, x);
    true
}

// Insert `x` at `pos` of `s`, moving the tail up.
fn insert_at(inout s: ChunkSeq[u64], pos: u64, x: u64) {
    s.push(0);
    let mut j = wrapping_sub(s.len(), 1);
    loop {
        if j <= pos {
            break;
        }
        let prev = at(in s.as_slice(), wrapping_sub(j, 1));
        s.try_set(j, prev);
        j = wrapping_sub(j, 1);
    }
    s.try_set(pos, x);
}

fn sat_add(a: u64, b: u64) -> u64 {
    let s = wrapping_add(a, b);
    if s < a {
        max_u64()
    } else {
        s
    }
}

fn sat_sub(a: u64, b: u64) -> u64 {
    if b > a {
        0
    } else {
        wrapping_sub(a, b)
    }
}

// `1 << bit` for `bit < 64`.
fn bit_of(bit: u64) -> u64 {
    let mut v: u64 = 1;
    for i in 0..bit {
        v = wrapping_add(v, v);
    }
    v
}

fn rng_index(inout r: Rng, len: u64) -> u64 {
    rng_below_inclusive(inout r, wrapping_sub(len, 1))
}

impl Fuzzer {
    fn corpus_len(in self) -> u64 {
        wrapping_sub(self.c_off.len(), 1)
    }

    fn entry_start(in self, e: u64) -> u64 {
        at(in self.c_off.as_slice(), e)
    }

    fn entry_end(in self, e: u64) -> u64 {
        at(in self.c_off.as_slice(), inc(e))
    }

    fn budget_left(in self) -> bool {
        !self.found && self.stats.execs < self.max_execs
    }

    fn hand_out(inout self, solver: bool) {
        self.solver_run = solver;
        self.seed = rng_next(inout self.rng);
        self.stats.execs = inc(self.stats.execs);
    }

    // `cur` = a mutation of a random corpus entry (src/fuzz.rs `mutate`).
    fn mutate(inout self) {
        let n = self.corpus_len();
        let index = rng_index(inout self.rng, n);
        let start = self.entry_start(index);
        let end = self.entry_end(index);
        let klen = wrapping_sub(end, start);
        self.cur.clear();
        for j in start..end {
            self.cur.push(at(in self.c_vals.as_slice(), j));
        }
        let rounds = inc(rng_index(inout self.rng, 4));
        for r in 0..rounds {
            self.mutate_once(start, klen, n);
        }
    }

    fn mutate_once(inout self, kstart: u64, klen: u64, n: u64) {
        let len = self.cur.len();
        if len == 0 {
            let v = rng_next(inout self.rng);
            self.cur.push(v);
            return;
        }
        let pos = rng_index(inout self.rng, len);
        let max = if pos < klen {
            at(in self.c_max.as_slice(), wrapping_add(kstart, pos))
        } else {
            max_u64()
        };
        let op = rng_index(inout self.rng, 10);
        let v = at(in self.cur.as_slice(), pos);
        if op == 0 {
            let x = rng_below_inclusive(inout self.rng, max);
            self.cur.try_set(pos, x);
        } else if op == 1 {
            self.cur.try_set(pos, 0);
        } else if op == 2 {
            self.cur.try_set(pos, max);
        } else if op == 3 {
            let delta = inc(rng_below_inclusive(inout self.rng, 15));
            self.cur.try_set(pos, min_u64(sat_add(v, delta), max));
        } else if op == 4 {
            let delta = inc(rng_below_inclusive(inout self.rng, 15));
            self.cur.try_set(pos, sat_sub(v, delta));
        } else {
            self.mutate_span(op, pos, len, max, v, n);
        }
    }

    fn mutate_span(inout self, op: u64, pos: u64, len: u64, max: u64, v: u64, n: u64) {
        if op == 5 {
            let span = min_u64(inc(rng_index(inout self.rng, 8)), wrapping_sub(len, pos));
            self.scratch.clear();
            for j in 0..len {
                if j < pos || j >= wrapping_add(pos, span) {
                    self.scratch.push(at(in self.cur.as_slice(), j));
                }
            }
            self.take_scratch();
        } else if op == 6 {
            let span = min_u64(inc(rng_index(inout self.rng, 8)), wrapping_sub(len, pos));
            let at_pos = rng_index(inout self.rng, inc(len));
            self.scratch.clear();
            for j in 0..at_pos {
                self.scratch.push(at(in self.cur.as_slice(), j));
            }
            for j in pos..wrapping_add(pos, span) {
                self.scratch.push(at(in self.cur.as_slice(), j));
            }
            for j in at_pos..len {
                self.scratch.push(at(in self.cur.as_slice(), j));
            }
            self.take_scratch();
        } else if op == 7 {
            self.cur.truncate(pos);
        } else if op == 8 {
            let other = rng_index(inout self.rng, n);
            let dstart = self.entry_start(other);
            let dend = self.entry_end(other);
            let cut = rng_index(inout self.rng, inc(wrapping_sub(dend, dstart)));
            self.cur.truncate(pos);
            for j in wrapping_add(dstart, cut)..dend {
                self.cur.push(at(in self.c_vals.as_slice(), j));
            }
        } else {
            let bit = rng_below_inclusive(inout self.rng, 63);
            self.cur.try_set(pos, min_u64(v ^ bit_of(bit), max));
        }
    }

    fn take_scratch(inout self) {
        self.cur.clear();
        for j in 0..self.scratch.len() {
            self.cur.push(at(in self.scratch.as_slice(), j));
        }
    }
}

// ---------------------------------------------------------------------------
// The comparison solver (src/fuzz.rs `solver_candidates`): bounded
// input-to-state replacement over one corpus entry. Candidates are rows of
// the entry's length; `order` keeps them sorted and unique, the order the
// Rust build's `BTreeSet<Vec<u64>>` runs them in.

impl Fuzzer {
    fn row_at(in self, row: u64, j: u64) -> u64 {
        at(in self.cands.as_slice(), wrapping_add(wrapping_mul(row, self.width), j))
    }

    // Compare `scratch` with candidate row `row`: 0 less, 1 equal, 2 greater.
    fn cmp_row(in self, row: u64) -> u64 {
        let mut j: u64 = 0;
        loop {
            if j >= self.width {
                break 1;
            }
            let a = at(in self.scratch.as_slice(), j);
            let b = self.row_at(row, j);
            if a != b {
                break if a < b {
                    0
                } else {
                    2
                };
            }
            j = inc(j);
        }
    }

    // `push` of the Rust build: false stops the whole candidate search.
    // `scratch` holds the candidate, built by the caller.
    fn push_scratch(inout self, estart: u64) -> bool {
        if self.order.len() >= self.max_solver {
            self.full = true;
            return false;
        }
        let mut same = true;
        for j in 0..self.width {
            if at(in self.scratch.as_slice(), j)
                != at(in self.c_vals.as_slice(), wrapping_add(estart, j)) {
                same = false;
            }
        }
        if !same {
            let mut lo: u64 = 0;
            let mut hi = self.order.len();
            let mut dup = false;
            loop {
                if lo >= hi {
                    break;
                }
                let mid = wrapping_add(lo, wrapping_sub(hi, lo) >> 1);
                let c = self.cmp_row(at(in self.order.as_slice(), mid));
                if c == 1 {
                    dup = true;
                    break;
                }
                if c == 2 {
                    lo = inc(mid);
                } else {
                    hi = mid;
                }
            }
            if !dup {
                // Rows are appended, so the new row's number is the count.
                let row = self.order.len();
                for j in 0..self.width {
                    self.cands.push(at(in self.scratch.as_slice(), j));
                }
                insert_at(inout self.order, lo, row);
            }
        }
        if self.order.len() >= self.max_solver {
            self.full = true;
            return false;
        }
        true
    }

    fn scratch_from_entry(inout self, estart: u64) {
        self.scratch.clear();
        for j in 0..self.width {
            self.scratch.push(at(in self.c_vals.as_slice(), wrapping_add(estart, j)));
        }
    }

    // Byte-lane start offsets where `needle` occurs, at most 8.
    fn find_in_lane(in self, estart: u64, in needle: Slice[u64]) -> ChunkSeq[u64] {
        let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let nl = needle.len();
        let ll = self.lane.len();
        if nl == 0 || nl > ll {
            return out;
        }
        let last = wrapping_sub(ll, nl);
        let mut start: u64 = 0;
        loop {
            if start > last || out.len() >= 8 {
                break;
            }
            let mut all = true;
            for k in 0..nl {
                let pos = at(in self.lane.as_slice(), wrapping_add(start, k));
                if at(in self.c_vals.as_slice(), wrapping_add(estart, pos)) != at(in needle, k) {
                    all = false;
                }
            }
            if all {
                out.push(start);
            }
            start = inc(start);
        }
        out
    }

    // Push `entry` with the byte lane from `start` replaced by `bytes`.
    fn push_lane(inout self, estart: u64, start: u64, in bytes: Slice[u64]) -> bool {
        self.scratch_from_entry(estart);
        let ll = self.lane.len();
        for k in 0..bytes.len() {
            let li = wrapping_add(start, k);
            if li < ll {
                let pos = at(in self.lane.as_slice(), li);
                self.scratch.try_set(pos, at(in bytes, k));
            }
        }
        self.push_scratch(estart)
    }

    // Every start of `needle` in the lane, replaced by `repl`.
    fn push_lane_all(inout self, estart: u64, in needle: Slice[u64], in repl: Slice[u64]) {
        let starts = self.find_in_lane(estart, in needle);
        for s in 0..starts.len() {
            if self.full {
                break;
            }
            let start = at(in starts.as_slice(), s);
            self.push_lane(estart, start, in repl);
        }
    }

    fn solve_int(inout self, estart: u64, kind: u64, needle: u64, target: u64) {
        self.solve_repl(estart, needle, target);
        if kind >= 2 {
            if target != max_u64() && !self.full {
                self.solve_repl(estart, needle, inc(target));
            }
            if target != 0 && !self.full {
                self.solve_repl(estart, needle, wrapping_sub(target, 1));
            }
        }
    }

    fn solve_repl(inout self, estart: u64, needle: u64, repl: u64) {
        // Whole drawn values.
        for i in 0..self.width {
            if self.full {
                return;
            }
            let pos = wrapping_add(estart, i);
            if at(in self.c_vals.as_slice(), pos)
                == needle
                && at(in self.c_tag.as_slice(), pos)
                == 0
                && repl
                <= at(in self.c_max.as_slice(), pos) {
                self.scratch_from_entry(estart);
                self.scratch.try_set(i, repl);
                self.push_scratch(estart);
            }
        }
        // Byte-lane encodings, widths 2, 4, 8, 1.
        for wi in 0..4 {
            if self.full {
                return;
            }
            let w: u64 = if wi == 0 {
                2
            } else if wi == 1 {
                4
            } else if wi == 2 {
                8
            } else {
                1
            };
            if fits(needle, w) && fits(repl, w) {
                let nle = le_bytes(needle, w);
                let rle = le_bytes(repl, w);
                self.push_lane_all(estart, in nle.as_slice(), in rle.as_slice());
                if !self.full {
                    let nbe = be_bytes(needle, w);
                    let rbe = be_bytes(repl, w);
                    self.push_lane_all(estart, in nbe.as_slice(), in rbe.as_slice());
                }
            }
        }
    }

    // Build the sorted candidate list of entry `e`.
    fn solve(inout self, e: u64) {
        let estart = self.entry_start(e);
        let eend = self.entry_end(e);
        self.width = wrapping_sub(eend, estart);
        self.cands.clear();
        self.order.clear();
        self.k = 0;
        self.full = false;
        self.lane.clear();
        for i in 0..self.width {
            if at(in self.c_tag.as_slice(), wrapping_add(estart, i)) == 1 {
                self.lane.push(i);
            }
        }
        let mut p = at(in self.c_cmp_off.as_slice(), e);
        let cend = at(in self.c_cmp_off.as_slice(), inc(e));
        loop {
            if p >= cend || self.full || self.order.len() >= self.max_solver {
                break;
            }
            let tag = at(in self.c_cmps.as_slice(), p);
            if tag == 0 {
                let kind = at(in self.c_cmps.as_slice(), inc(p));
                let lhs = at(in self.c_cmps.as_slice(), wrapping_add(p, 2));
                let rhs = at(in self.c_cmps.as_slice(), wrapping_add(p, 3));
                self.solve_int(estart, kind, lhs, rhs);
                if !self.full {
                    self.solve_int(estart, kind, rhs, lhs);
                }
                p = wrapping_add(p, 4);
            } else {
                let nl = at(in self.c_cmps.as_slice(), inc(p));
                let nr = at(in self.c_cmps.as_slice(), wrapping_add(p, 2));
                let ls = wrapping_add(p, 3);
                let rs = wrapping_add(ls, nl);
                self.solve_bytes(estart, ls, nl, rs, nr);
                if !self.full {
                    self.solve_bytes(estart, rs, nr, ls, nl);
                }
                p = wrapping_add(rs, nr);
            }
        }
    }

    // Byte-string comparison: replace `needle` (at `ns`, `nl` words of
    // `c_cmps`) by the first `min(nl, tl)` bytes of the target.
    fn solve_bytes(inout self, estart: u64, ns: u64, nl: u64, ts: u64, tl: u64) {
        if nl == 0 {
            return;
        }
        let width = min_u64(nl, tl);
        if width == 0 {
            return;
        }
        let mut needle: ChunkSeq[u64] = ChunkSeq::new[u64]();
        for k in 0..nl {
            needle.push(at(in self.c_cmps.as_slice(), wrapping_add(ns, k)));
        }
        let mut repl: ChunkSeq[u64] = ChunkSeq::new[u64]();
        for k in 0..width {
            repl.push(at(in self.c_cmps.as_slice(), wrapping_add(ts, k)));
        }
        self.push_lane_all(estart, in needle.as_slice(), in repl.as_slice());
    }
}

// `value` fits in `w` bytes.
fn fits(value: u64, w: u64) -> bool {
    if w >= 8 {
        return true;
    }
    let mut v = value;
    for i in 0..w {
        v = v >> 8;
    }
    v == 0
}

fn le_bytes(value: u64, w: u64) -> ChunkSeq[u64] {
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut v = value;
    for i in 0..w {
        out.push(v & 255);
        v = v >> 8;
    }
    out
}

fn be_bytes(value: u64, w: u64) -> ChunkSeq[u64] {
    let le = le_bytes(value, w);
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut j = le.len();
    loop {
        if j == 0 {
            break;
        }
        j = wrapping_sub(j, 1);
        out.push(at(in le.as_slice(), j));
    }
    out
}

// ---------------------------------------------------------------------------
// The campaign loop (src/fuzz.rs `campaign`, `observe`).

// Pick the next run: true with `fuzzer_candidate` and `fuzzer_seed` set,
// false when the campaign is over (a failure was found or the budget spent).
pub fn fuzzer_next(inout f: Fuzzer) -> bool {
    loop {
        if !f.budget_left() {
            break false;
        }
        if f.in_solver {
            if f.k < f.order.len() {
                let row = at(in f.order.as_slice(), f.k);
                f.k = inc(f.k);
                f.cur.clear();
                for j in 0..f.width {
                    let v = f.row_at(row, j);
                    f.cur.push(v);
                }
                f.stats.solver_runs = inc(f.stats.solver_runs);
                f.hand_out(true);
                break true;
            }
            f.in_solver = false;
        } else {
            let n = f.corpus_len();
            if f.random || n == 0 || f.stats.execs < f.initial_random {
                f.cur.clear();
                f.hand_out(false);
                break true;
            }
            let mut unsolved = n;
            for e in 0..n {
                if unsolved == n && !atb(in f.c_solved.as_slice(), e) {
                    unsolved = e;
                }
            }
            if unsolved < n {
                f.c_solved.try_set(unsolved, true);
                f.solve(unsolved);
                f.in_solver = true;
            } else {
                f.mutate();
                f.hand_out(false);
                break true;
            }
        }
    }
}

pub fn fuzzer_candidate(in f: Fuzzer) -> ChunkSeq[u64] {
    copy_of(in f.cur.as_slice())
}

pub fn fuzzer_seed(in f: Fuzzer) -> u64 {
    f.seed
}

// Report the run's verdict (0 pass, 1 fail, 2 invalid) and, for a pass,
// its features. Returns 0 (nothing new), 1 (new coverage: call
// `fuzzer_keep` with the run) or 2 (the failure that ends the campaign).
pub fn fuzzer_observe(inout f: Fuzzer, verdict: u64, in features: Slice[u64]) -> u64 {
    let code = if verdict == 1 {
        f.found = true;
        2
    } else if verdict == 2 {
        f.stats.invalid = inc(f.stats.invalid);
        0
    } else if f.random {
        0
    } else {
        f.novelty(in features)
    };
    if f.solver_run && code != 0 {
        f.stats.solver_hits = inc(f.stats.solver_hits);
    }
    code
}

impl Fuzzer {
    fn novelty(inout self, in features: Slice[u64]) -> u64 {
        let mut novel = false;
        let pairs = features.len() >> 1;
        for i in 0..pairs {
            let key = at(in features, wrapping_add(i, i));
            let value = at(in features, inc(wrapping_add(i, i)));
            if (key >> 62) == 2 {
                let site = key & 0xffffffff;
                let pos = lower_bound(in self.close_site.as_slice(), site);
                if pos < self.close_site.len() && at(in self.close_site.as_slice(), pos) == site {
                    if value > at(in self.close_val.as_slice(), pos) {
                        self.close_val.try_set(pos, value);
                        novel = true;
                    }
                } else {
                    insert_at(inout self.close_site, pos, site);
                    insert_at(inout self.close_val, pos, value);
                    if value > 0 {
                        novel = true;
                    }
                }
            } else if set_insert(inout self.seen, key) {
                novel = true;
            }
        }
        if novel {
            1
        } else {
            0
        }
    }
}

// Add the run just observed (code 1) to the corpus.
pub fn fuzzer_keep(
    inout f: Fuzzer,
    in values: Slice[u64],
    in kind_tag: Slice[u64],
    in kind_max: Slice[u64],
    in cmps: Slice[u64]
) {
    for i in 0..values.len() {
        f.c_vals.push(at(in values, i));
        f.c_tag.push(at(in kind_tag, i));
        f.c_max.push(at(in kind_max, i));
    }
    let end = f.c_vals.len();
    f.c_off.push(end);
    for i in 0..cmps.len() {
        f.c_cmps.push(at(in cmps, i));
    }
    let cend = f.c_cmps.len();
    f.c_cmp_off.push(cend);
    f.c_solved.push(false);
}

pub fn fuzzer_stats(in f: Fuzzer) -> FuzzStats {
    let mut s = f.stats;
    s.features = wrapping_add(f.seen.len(), f.close_site.len());
    s
}

pub fn fuzzer_corpus_len(in f: Fuzzer) -> u64 {
    f.corpus_len()
}

pub fn fuzzer_corpus_entry(in f: Fuzzer, e: u64) -> ChunkSeq[u64] {
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let start = f.entry_start(e);
    let end = f.entry_end(e);
    for j in start..end {
        out.push(at(in f.c_vals.as_slice(), j));
    }
    out
}

// ---------------------------------------------------------------------------
// Systematic schedule search (src/dpor.rs `explore`): exhaustive search and
// persistent-set DPOR with sleep sets, the preemption bound and the state
// cache, as a step machine. The Rust wrapper keeps the SimPulse machine, the
// fibers and the observer: it re-executes the prefix (`search_prefix`),
// reports each new state (`search_root`, `search_child`, `search_key`) and
// executes the process `search_choose` picks. `search_backtrack` moves to
// the next unexplored alternative.
//
// Processes are encoded so that their order is kept: Task(i) = i,
// Io{task, seq, choice} = 1 << 62 | task << 40 | seq << 8 | choice and
// Timer{task, seq} = 2 << 62 | task << 32 | seq. A fiber's next transition
// is the id of its footprint (`search_footprint`, interned by the wrapper);
// deliveries and timers have transition 0. `search_choose` codes: 0 run
// `value`, 1 every enabled process sleeps, 2 the machine quiesced. State
// keys are ids interned by the wrapper (`none` when not caching).

fn none() -> u64 {
    max_u64()
}

fn proc_tag(p: u64) -> u64 {
    p >> 62
}

fn proc_task(p: u64) -> u64 {
    let tag = p >> 62;
    if tag == 0 {
        p
    } else if tag == 1 {
        (p >> 40) & 0x3fffff
    } else {
        (p >> 32) & 0x3fffffff
    }
}

// Whether two transitions can ever be enabled together (explore.rs
// `may_co_enable`).
fn may_co_enable(a: u64, b: u64) -> bool {
    let ta = proc_tag(a);
    let tb = proc_tag(b);
    if (ta == 0 && tb == 2) || (ta == 2 && tb == 0) {
        return false;
    }
    if (ta == 0 && tb == 1) || (ta == 1 && tb == 0) {
        return proc_task(a) != proc_task(b);
    }
    true
}

// The first position in `lo..hi` of the sorted range of `s` not below `x`.
fn lower_bound_in(in s: Slice[u64], lo0: u64, hi0: u64, x: u64) -> u64 {
    let mut lo = lo0;
    let mut hi = hi0;
    loop {
        if lo >= hi {
            break lo;
        }
        let mid = wrapping_add(lo, wrapping_sub(hi, lo) >> 1);
        if at(in s, mid) < x {
            lo = inc(mid);
        } else {
            hi = mid;
        }
    }
}

fn range_has(in s: Slice[u64], lo: u64, hi: u64, x: u64) -> bool {
    let pos = lower_bound_in(in s, lo, hi, x);
    pos < hi && at(in s, pos) == x
}

// Whether the sorted ranges `a0..a1` of `a` and `b0..b1` of `b` meet.
fn ranges_meet(in a: Slice[u64], a0: u64, a1: u64, in b: Slice[u64], b0: u64, b1: u64) -> bool {
    let mut i = a0;
    let mut j = b0;
    loop {
        if i >= a1 || j >= b1 {
            break false;
        }
        let x = at(in a, i);
        let y = at(in b, j);
        if x < y {
            i = inc(i);
        } else if x > y {
            j = inc(j);
        } else {
            break true;
        }
    }
}

fn seq_has(in s: Slice[u64], x: u64) -> bool {
    let mut found = false;
    for i in 0..s.len() {
        if at(in s, i) == x {
            found = true;
        }
    }
    found
}

// Whether the sorted range `a0..a1` of `a` is a subset of `b0..b1` of `b`.
fn range_subset(in a: Slice[u64], a0: u64, a1: u64, in b: Slice[u64], b0: u64, b1: u64) -> bool {
    let mut j = b0;
    let mut ok = true;
    for i in a0..a1 {
        let x = at(in a, i);
        loop {
            if j >= b1 || at(in b, j) >= x {
                break;
            }
            j = inc(j);
        }
        if j >= b1 || at(in b, j) != x {
            ok = false;
        }
    }
    ok
}

pub copy struct SearchStats {
    sleep_blocked: u64,
    cache_hits: u64,
    bound_pruned: u64
}

pub struct Search {
    dpor: bool,
    bounded: bool,
    sleeping: bool,
    has_bound: bool,
    bound: u64,
    caching: bool,
    stats: SearchStats,
    p_proc: u64,
    p_next: u64,
    p_pre: u64,
    p_mark: u64,
    fp_r_off: ChunkSeq[u64],
    fp_r: ChunkSeq[u64],
    fp_w_off: ChunkSeq[u64],
    fp_w: ChunkSeq[u64],
    fp_c_off: ChunkSeq[u64],
    fp_c: ChunkSeq[u64],
    n_en: ChunkSeq[u64],
    n_en_len: ChunkSeq[u64],
    n_nx: ChunkSeq[u64],
    n_nx_len: ChunkSeq[u64],
    n_pc: ChunkSeq[u64],
    n_pc_len: ChunkSeq[u64],
    n_sl: ChunkSeq[u64],
    n_sl_len: ChunkSeq[u64],
    n_sm: ChunkSeq[u64],
    n_cl: ChunkSeq[u64],
    n_chosen: ChunkSeq[u64],
    n_running: ChunkSeq[u64],
    n_pre: ChunkSeq[u64],
    n_key: ChunkSeq[u64],
    en: ChunkSeq[u64],
    en_ord: ChunkSeq[u64],
    nx_proc: ChunkSeq[u64],
    nx_next: ChunkSeq[u64],
    pc_proc: ChunkSeq[u64],
    pc_off: ChunkSeq[u64],
    pc_len: ChunkSeq[u64],
    cl_proc: ChunkSeq[u64],
    cl_val: ChunkSeq[u64],
    sl: ChunkSeq[u64],
    sm_proc: ChunkSeq[u64],
    sm_next: ChunkSeq[u64],
    ev_proc: ChunkSeq[u64],
    ev_next: ChunkSeq[u64],
    ev_cl: ChunkSeq[u64],
    ev_cl_len: ChunkSeq[u64],
    ca_sl_off: ChunkSeq[u64],
    ca_sl_len: ChunkSeq[u64],
    ca_sm_off: ChunkSeq[u64],
    ca_sm_len: ChunkSeq[u64],
    ca_sl: ChunkSeq[u64],
    ca_smp: ChunkSeq[u64],
    ca_smn: ChunkSeq[u64],
    p_sleep: ChunkSeq[u64],
    t1: ChunkSeq[u64],
    t2: ChunkSeq[u64],
    t3: ChunkSeq[u64],
    t4: ChunkSeq[u64],
    fp_spawn: ChunkSeq[bool],
    n_hit: ChunkSeq[bool],
    en_bt: ChunkSeq[bool],
    en_done: ChunkSeq[bool],
    en_slept: ChunkSeq[bool],
    ca_set: ChunkSeq[bool]
}

pub fn search_new(dpor: bool, has_bound: bool, bound: u64, caching: bool) -> Search {
    let mut fp_r_off: ChunkSeq[u64] = ChunkSeq::new[u64]();
    fp_r_off.push(0);
    let mut fp_w_off: ChunkSeq[u64] = ChunkSeq::new[u64]();
    fp_w_off.push(0);
    let mut fp_c_off: ChunkSeq[u64] = ChunkSeq::new[u64]();
    fp_c_off.push(0);
    Search {
        dpor: dpor,
        bounded: has_bound && dpor,
        sleeping: dpor && !has_bound,
        has_bound: has_bound,
        bound: bound,
        caching: caching,
        stats: SearchStats {
            sleep_blocked: 0,
            cache_hits: 0,
            bound_pruned: 0
        },
        p_proc: 0,
        p_next: 0,
        p_pre: 0,
        p_mark: 0,
        fp_r_off: fp_r_off,
        fp_r: ChunkSeq::new[u64](),
        fp_w_off: fp_w_off,
        fp_w: ChunkSeq::new[u64](),
        fp_c_off: fp_c_off,
        fp_c: ChunkSeq::new[u64](),
        n_en: ChunkSeq::new[u64](),
        n_en_len: ChunkSeq::new[u64](),
        n_nx: ChunkSeq::new[u64](),
        n_nx_len: ChunkSeq::new[u64](),
        n_pc: ChunkSeq::new[u64](),
        n_pc_len: ChunkSeq::new[u64](),
        n_sl: ChunkSeq::new[u64](),
        n_sl_len: ChunkSeq::new[u64](),
        n_sm: ChunkSeq::new[u64](),
        n_cl: ChunkSeq::new[u64](),
        n_chosen: ChunkSeq::new[u64](),
        n_running: ChunkSeq::new[u64](),
        n_pre: ChunkSeq::new[u64](),
        n_key: ChunkSeq::new[u64](),
        en: ChunkSeq::new[u64](),
        en_ord: ChunkSeq::new[u64](),
        nx_proc: ChunkSeq::new[u64](),
        nx_next: ChunkSeq::new[u64](),
        pc_proc: ChunkSeq::new[u64](),
        pc_off: ChunkSeq::new[u64](),
        pc_len: ChunkSeq::new[u64](),
        cl_proc: ChunkSeq::new[u64](),
        cl_val: ChunkSeq::new[u64](),
        sl: ChunkSeq::new[u64](),
        sm_proc: ChunkSeq::new[u64](),
        sm_next: ChunkSeq::new[u64](),
        ev_proc: ChunkSeq::new[u64](),
        ev_next: ChunkSeq::new[u64](),
        ev_cl: ChunkSeq::new[u64](),
        ev_cl_len: ChunkSeq::new[u64](),
        ca_sl_off: ChunkSeq::new[u64](),
        ca_sl_len: ChunkSeq::new[u64](),
        ca_sm_off: ChunkSeq::new[u64](),
        ca_sm_len: ChunkSeq::new[u64](),
        ca_sl: ChunkSeq::new[u64](),
        ca_smp: ChunkSeq::new[u64](),
        ca_smn: ChunkSeq::new[u64](),
        p_sleep: ChunkSeq::new[u64](),
        t1: ChunkSeq::new[u64](),
        t2: ChunkSeq::new[u64](),
        t3: ChunkSeq::new[u64](),
        t4: ChunkSeq::new[u64](),
        fp_spawn: ChunkSeq::new[bool](),
        n_hit: ChunkSeq::new[bool](),
        en_bt: ChunkSeq::new[bool](),
        en_done: ChunkSeq::new[bool](),
        en_slept: ChunkSeq::new[bool](),
        ca_set: ChunkSeq::new[bool]()
    }
}

// Register a footprint (sorted reads, writes and cancellation targets);
// returns its id.
pub fn search_footprint(
    inout s: Search,
    in reads: Slice[u64],
    in writes: Slice[u64],
    spawns: bool,
    in cancels: Slice[u64]
) -> u64 {
    let id = s.fp_spawn.len();
    for i in 0..reads.len() {
        s.fp_r.push(at(in reads, i));
    }
    let r = s.fp_r.len();
    s.fp_r_off.push(r);
    for i in 0..writes.len() {
        s.fp_w.push(at(in writes, i));
    }
    let w = s.fp_w.len();
    s.fp_w_off.push(w);
    for i in 0..cancels.len() {
        s.fp_c.push(at(in cancels, i));
    }
    let c = s.fp_c.len();
    s.fp_c_off.push(c);
    s.fp_spawn.push(spawns);
    id
}

// Dependence and footprints.
impl Search {
    fn conflicts(in self, a: u64, b: u64) -> bool {
        let ar0 = at(in self.fp_r_off.as_slice(), a);
        let ar1 = at(in self.fp_r_off.as_slice(), inc(a));
        let aw0 = at(in self.fp_w_off.as_slice(), a);
        let aw1 = at(in self.fp_w_off.as_slice(), inc(a));
        let br0 = at(in self.fp_r_off.as_slice(), b);
        let br1 = at(in self.fp_r_off.as_slice(), inc(b));
        let bw0 = at(in self.fp_w_off.as_slice(), b);
        let bw1 = at(in self.fp_w_off.as_slice(), inc(b));
        if ranges_meet(in self.fp_w.as_slice(), aw0, aw1, in self.fp_w.as_slice(), bw0, bw1) {
            return true;
        }
        if ranges_meet(in self.fp_w.as_slice(), aw0, aw1, in self.fp_r.as_slice(), br0, br1) {
            return true;
        }
        if ranges_meet(in self.fp_r.as_slice(), ar0, ar1, in self.fp_w.as_slice(), bw0, bw1) {
            return true;
        }
        atb(in self.fp_spawn.as_slice(), a) && atb(in self.fp_spawn.as_slice(), b)
    }

    fn cancels(in self, f: u64, task: u64) -> bool {
        let c0 = at(in self.fp_c_off.as_slice(), f);
        let c1 = at(in self.fp_c_off.as_slice(), inc(f));
        range_has(in self.fp_c.as_slice(), c0, c1, task)
    }

    // explore.rs `dependent`.
    fn dep(in self, pa: u64, na: u64, pb: u64, nb: u64) -> bool {
        let ta = proc_tag(pa);
        let tb = proc_tag(pb);
        if ta == 2 || tb == 2 {
            return true;
        }
        if ta == 0 && tb == 0 {
            return pa
                == pb
                || self
                .conflicts(na, nb)
                || self
                .cancels(na, pb)
                || self
                .cancels(nb, pa);
        }
        if ta == 0 && tb == 1 {
            return pa == proc_task(pb);
        }
        if ta == 1 && tb == 0 {
            return proc_task(pa) == pb;
        }
        if ta == 1 && tb == 1 {
            return proc_task(pa) == proc_task(pb);
        }
        true
    }
}

// Node lookups.
impl Search {
    fn en_start(in self, n: u64) -> u64 {
        at(in self.n_en.as_slice(), n)
    }

    fn en_end(in self, n: u64) -> u64 {
        wrapping_add(at(in self.n_en.as_slice(), n), at(in self.n_en_len.as_slice(), n))
    }

    // The position of `q` in node `n`'s enabled list, or `none`.
    fn en_find(in self, n: u64, q: u64) -> u64 {
        let start = self.en_start(n);
        let end = self.en_end(n);
        let mut i = start;
        loop {
            if i >= end {
                break none();
            }
            if at(in self.en.as_slice(), i) == q {
                break i;
            }
            i = inc(i);
        }
    }

    // The position of `q` in node `n`'s next transitions, or `none`.
    fn nx_find(in self, n: u64, q: u64) -> u64 {
        let start = at(in self.n_nx.as_slice(), n);
        let end = wrapping_add(start, at(in self.n_nx_len.as_slice(), n));
        let mut i = start;
        loop {
            if i >= end {
                break none();
            }
            if at(in self.nx_proc.as_slice(), i) == q {
                break i;
            }
            i = inc(i);
        }
    }

    // The position of `q` among the process clocks `start..end`, or `none`.
    fn pc_find_in(in self, start: u64, end: u64, q: u64) -> u64 {
        let pos = lower_bound_in(in self.pc_proc.as_slice(), start, end, q);
        if pos < end && at(in self.pc_proc.as_slice(), pos) == q {
            pos
        } else {
            none()
        }
    }

    fn pc_find(in self, n: u64, q: u64) -> u64 {
        let start = at(in self.n_pc.as_slice(), n);
        let end = wrapping_add(start, at(in self.n_pc_len.as_slice(), n));
        self.pc_find_in(start, end, q)
    }

    // `clock[q]` of the clock block `off..off + len` (0 when absent).
    fn clock_get(in self, off: u64, len: u64, q: u64) -> u64 {
        let end = wrapping_add(off, len);
        let pos = lower_bound_in(in self.cl_proc.as_slice(), off, end, q);
        if pos < end && at(in self.cl_proc.as_slice(), pos) == q {
            at(in self.cl_val.as_slice(), pos)
        } else {
            0
        }
    }

    fn in_sleep(in self, n: u64, q: u64) -> bool {
        let start = at(in self.n_sl.as_slice(), n);
        let end = wrapping_add(start, at(in self.n_sl_len.as_slice(), n));
        if range_has(in self.sl.as_slice(), start, end, q) {
            return true;
        }
        let i = self.en_find(n, q);
        i != none() && atb(in self.en_slept.as_slice(), i)
    }

    fn preempts(in self, n: u64, p: u64) -> bool {
        let r = at(in self.n_running.as_slice(), n);
        if r == none() || proc_tag(p) != 0 {
            return false;
        }
        p != r && self.en_find(n, r) != none()
    }

    fn allowed(in self, n: u64, p: u64) -> bool {
        if !self.has_bound {
            return true;
        }
        let extra: u64 = if self.preempts(n, p) {
            1
        } else {
            0
        };
        wrapping_add(at(in self.n_pre.as_slice(), n), extra) <= self.bound
    }

    fn bt_insert(inout self, n: u64, q: u64) {
        let i = self.en_find(n, q);
        if i != none() {
            self.en_bt.try_set(i, true);
        }
    }

    fn bt_all(inout self, n: u64) {
        let start = self.en_start(n);
        let end = self.en_end(n);
        for i in start..end {
            self.en_bt.try_set(i, true);
        }
    }
}

// Choosing (dpor.rs `pick`, `add_siblings`).
impl Search {
    fn add_siblings(inout self, n: u64, p: u64) {
        if proc_tag(p) != 1 {
            return;
        }
        let start = self.en_start(n);
        let end = self.en_end(n);
        for i in start..end {
            let q = at(in self.en.as_slice(), i);
            if (q >> 8) == (p >> 8) {
                self.en_bt.try_set(i, true);
            }
        }
    }

    // The next unexplored, awake, allowed process of node `n`, from its
    // enabled list or (in order) its backtrack set; `none` when there is
    // none.
    fn pick(inout self, n: u64, from_bt: bool) -> u64 {
        let start = self.en_start(n);
        let len = at(in self.n_en_len.as_slice(), n);
        let mut k: u64 = 0;
        loop {
            if k >= len {
                break none();
            }
            let i = if from_bt {
                wrapping_add(start, at(in self.en_ord.as_slice(), wrapping_add(start, k)))
            } else {
                wrapping_add(start, k)
            };
            k = inc(k);
            let p = at(in self.en.as_slice(), i);
            let skip = (from_bt && !atb(in self.en_bt.as_slice(), i))
                || atb(in self.en_done.as_slice(), i)
                || (self.dpor && self.in_sleep(n, p));
            if !skip {
                if !self.allowed(n, p) {
                    self.en_done.try_set(i, true);
                    self.stats.bound_pruned = inc(self.stats.bound_pruned);
                } else {
                    self.n_chosen.try_set(n, p);
                    self.en_done.try_set(i, true);
                    self.en_bt.try_set(i, true);
                    if self.dpor {
                        self.add_siblings(n, p);
                        let r = at(in self.n_running.as_slice(), n);
                        if self.has_bound && self.preempts(n, p) && r != none() {
                            self.bt_insert(n, r);
                        }
                    }
                    break p;
                }
            }
        }
    }
}

// Backtracking points (dpor.rs `add_at`, `backtrack_for`).
impl Search {
    // Add `p`'s backtracking points at node `n` for a race; `hb_off` and
    // `hb_len` are `p`'s clock.
    fn add_at(inout self, n: u64, p: u64, hb_off: u64, hb_len: u64) {
        self.t3.clear();
        if self.en_find(n, p) != none() {
            self.t3.push(p);
        }
        let m = self.ev_proc.len();
        for j in inc(n)..m {
            let e = at(in self.ev_proc.as_slice(), j);
            if self
                .clock_get(hb_off, hb_len, e)
                > j
                && self
                .en_find(n, e)
                != none()
                && !seq_has(in self.t3.as_slice(), e) {
                self.t3.push(e);
            }
        }
        let mut any = false;
        for c in 0..self.t3.len() {
            let q = at(in self.t3.as_slice(), c);
            if (self.bounded || !any) && !self.in_sleep(n, q) {
                self.bt_insert(n, q);
                any = true;
            }
        }
        if !any {
            self.bt_all(n);
        }
    }

    fn switches(in self, k: u64) -> bool {
        let e = at(in self.ev_proc.as_slice(), k);
        proc_tag(e) == 0 && at(in self.n_running.as_slice(), k) != e
    }

    fn backtrack_for(inout self, p: u64, next: u64, hb_off: u64, hb_len: u64, all: bool) {
        let mut i = self.ev_proc.len();
        loop {
            if i == 0 {
                break;
            }
            i = wrapping_sub(i, 1);
            let e = at(in self.ev_proc.as_slice(), i);
            let en = at(in self.ev_next.as_slice(), i);
            let races = e
                != p
                && may_co_enable(e, p)
                && self
                .dep(e, en, p, next)
                && !(self.clock_get(hb_off, hb_len, e) > i);
            if races {
                self.add_at(i, p, hb_off, hb_len);
                if self.bounded {
                    let mut b = i;
                    loop {
                        if b == 0 || self.switches(b) {
                            break;
                        }
                        b = wrapping_sub(b, 1);
                    }
                    if b < i {
                        self.add_at(b, p, hb_off, hb_len);
                    }
                }
                if !all {
                    break;
                }
            }
        }
    }

    fn backtrack_one(inout self, cur: u64, p: u64, next: u64, all: bool) {
        let pci = self.pc_find(cur, p);
        let (off, len) = if pci == none() {
            (0, 0)
        } else {
            (at(in self.pc_off.as_slice(), pci), at(in self.pc_len.as_slice(), pci))
        };
        self.backtrack_for(p, next, off, len, all);
    }

    // Race-check every next transition of the newest node.
    fn add_backtrack_points(inout self) {
        let cur = self.ev_proc.len();
        let start = at(in self.n_nx.as_slice(), cur);
        let end = wrapping_add(start, at(in self.n_nx_len.as_slice(), cur));
        for k in start..end {
            let p = at(in self.nx_proc.as_slice(), k);
            let next = at(in self.nx_next.as_slice(), k);
            self.backtrack_one(cur, p, next, false);
        }
    }

    // Race-check the newest node's cached subtree summary against every
    // racing event.
    fn add_summary_points(inout self) {
        let cur = self.ev_proc.len();
        let start = at(in self.n_sm.as_slice(), cur);
        let end = self.sm_proc.len();
        for k in start..end {
            let p = at(in self.sm_proc.as_slice(), k);
            let next = at(in self.sm_next.as_slice(), k);
            self.backtrack_one(cur, p, next, true);
        }
    }
}

// Clocks and the summary arena.
impl Search {
    // `t1` (pairs) joined with the clock block `off..off + len`.
    fn join_into(inout self, off: u64, len: u64) {
        self.t2.clear();
        let n1 = self.t1.len() >> 1;
        let mut i: u64 = 0;
        let mut j: u64 = 0;
        loop {
            if i >= n1 && j >= len {
                break;
            }
            let ap = if i < n1 {
                at(in self.t1.as_slice(), wrapping_add(i, i))
            } else {
                none()
            };
            let bp = if j < len {
                at(in self.cl_proc.as_slice(), wrapping_add(off, j))
            } else {
                none()
            };
            let av = at(in self.t1.as_slice(), inc(wrapping_add(i, i)));
            let bv = at(in self.cl_val.as_slice(), wrapping_add(off, j));
            if i < n1 && (j >= len || ap < bp) {
                self.t2.push(ap);
                self.t2.push(av);
                i = inc(i);
            } else if i >= n1 || bp < ap {
                self.t2.push(bp);
                self.t2.push(bv);
                j = inc(j);
            } else {
                self.t2.push(ap);
                let v = if av > bv {
                    av
                } else {
                    bv
                };
                self.t2.push(v);
                i = inc(i);
                j = inc(j);
            }
        }
        self.t1.clear();
        for k in 0..self.t2.len() {
            let v = at(in self.t2.as_slice(), k);
            self.t1.push(v);
        }
    }

    // Set `t1[p] = v`.
    fn t1_set(inout self, p: u64, v: u64) {
        let n1 = self.t1.len() >> 1;
        let mut pos = n1;
        for i in 0..n1 {
            if pos == n1 && at(in self.t1.as_slice(), wrapping_add(i, i)) >= p {
                pos = i;
            }
        }
        let at2 = wrapping_add(pos, pos);
        if pos < n1 && at(in self.t1.as_slice(), at2) == p {
            self.t1.try_set(inc(at2), v);
        } else {
            insert_at(inout self.t1, at2, v);
            insert_at(inout self.t1, at2, p);
        }
    }

    // Insert the process clock `q -> off, len` into the sorted entries from
    // `start` (the newest node's) unless `q` has one.
    fn pc_insert(inout self, start: u64, q: u64, off: u64, len: u64, replace: bool) {
        let end = self.pc_proc.len();
        let pos = lower_bound_in(in self.pc_proc.as_slice(), start, end, q);
        if pos < end && at(in self.pc_proc.as_slice(), pos) == q {
            if replace {
                self.pc_off.try_set(pos, off);
                self.pc_len.try_set(pos, len);
            }
        } else {
            insert_at(inout self.pc_proc, pos, q);
            insert_at(inout self.pc_off, pos, off);
            insert_at(inout self.pc_len, pos, len);
        }
    }

    // Insert `(p, next)` into the sorted summary entries from `start`.
    fn sm_insert(inout self, start: u64, p: u64, next: u64) {
        let end = self.sm_proc.len();
        let mut pos = end;
        let mut k = start;
        loop {
            if k >= end {
                break;
            }
            let q = at(in self.sm_proc.as_slice(), k);
            let nq = at(in self.sm_next.as_slice(), k);
            if q == p && nq == next {
                return;
            }
            if q > p || (q == p && nq > next) {
                pos = k;
                break;
            }
            k = inc(k);
        }
        insert_at(inout self.sm_proc, pos, p);
        insert_at(inout self.sm_next, pos, next);
    }
}

// Nodes.
impl Search {
    fn push_node(
        inout self,
        in enabled: Slice[u64],
        in nexts: Slice[u64],
        running: u64,
        pre: u64,
        mark: u64
    ) {
        let start = self.en.len();
        self.n_en.push(start);
        self.n_en_len.push(enabled.len());
        for i in 0..enabled.len() {
            let p = at(in enabled, i);
            self.en.push(p);
            self.en_bt.push(false);
            self.en_done.push(false);
            self.en_slept.push(false);
            // Insertion sort of the positions by process.
            let mut pos = i;
            for k in 0..i {
                let o = at(in self.en_ord.as_slice(), wrapping_add(start, k));
                if pos == i && at(in enabled, o) > p {
                    pos = k;
                }
            }
            insert_at(inout self.en_ord, wrapping_add(start, pos), i);
        }
        let nx_start = self.nx_proc.len();
        self.n_nx.push(nx_start);
        let pairs = nexts.len() >> 1;
        self.n_nx_len.push(pairs);
        for i in 0..pairs {
            self.nx_proc.push(at(in nexts, wrapping_add(i, i)));
            self.nx_next.push(at(in nexts, inc(wrapping_add(i, i))));
        }
        let sl_start = self.sl.len();
        self.n_sl.push(sl_start);
        self.n_sl_len.push(self.p_sleep.len());
        for i in 0..self.p_sleep.len() {
            let q = at(in self.p_sleep.as_slice(), i);
            self.sl.push(q);
        }
        self.p_sleep.clear();
        self.n_cl.push(mark);
        self.n_chosen.push(none());
        self.n_running.push(running);
        self.n_pre.push(pre);
        self.n_key.push(none());
        self.n_hit.push(false);
        let sm_start = self.sm_proc.len();
        self.n_sm.push(sm_start);
        if self.caching {
            for i in 0..pairs {
                let p = at(in nexts, wrapping_add(i, i));
                let next = at(in nexts, inc(wrapping_add(i, i)));
                self.sm_insert(sm_start, p, next);
            }
        }
    }

    fn ev_truncate(inout self, k: u64) {
        self.ev_proc.truncate(k);
        self.ev_next.truncate(k);
        self.ev_cl.truncate(k);
        self.ev_cl_len.truncate(k);
    }

    // Record node `n` (the newest) in the cache.
    fn cache_insert(inout self, n: u64) {
        let key = at(in self.n_key.as_slice(), n);
        if key == none() || atb(in self.n_hit.as_slice(), n) {
            return;
        }
        loop {
            if self.ca_set.len() > key {
                break;
            }
            self.ca_set.push(false);
            self.ca_sl_off.push(0);
            self.ca_sl_len.push(0);
            self.ca_sm_off.push(0);
            self.ca_sm_len.push(0);
        }
        let sl0 = at(in self.n_sl.as_slice(), n);
        let sl1 = wrapping_add(sl0, at(in self.n_sl_len.as_slice(), n));
        let c0 = at(in self.ca_sl_off.as_slice(), key);
        let c1 = wrapping_add(c0, at(in self.ca_sl_len.as_slice(), key));
        let replace = !atb(in self.ca_set.as_slice(), key)
            || range_subset(in self.sl.as_slice(), sl0, sl1, in self.ca_sl.as_slice(), c0, c1);
        if !replace {
            return;
        }
        self.ca_set.try_set(key, true);
        let off = self.ca_sl.len();
        self.ca_sl_off.try_set(key, off);
        self.ca_sl_len.try_set(key, wrapping_sub(sl1, sl0));
        for i in sl0..sl1 {
            let q = at(in self.sl.as_slice(), i);
            self.ca_sl.push(q);
        }
        let sm0 = at(in self.n_sm.as_slice(), n);
        let sm1 = self.sm_proc.len();
        let soff = self.ca_smp.len();
        self.ca_sm_off.try_set(key, soff);
        self.ca_sm_len.try_set(key, wrapping_sub(sm1, sm0));
        for i in sm0..sm1 {
            let p = at(in self.sm_proc.as_slice(), i);
            let next = at(in self.sm_next.as_slice(), i);
            self.ca_smp.push(p);
            self.ca_smn.push(next);
        }
    }

    // Merge the newest node's summary into its parent's (the block below).
    fn merge_summary(inout self, n: u64) {
        let a = at(in self.n_sm.as_slice(), wrapping_sub(n, 1));
        let b = at(in self.n_sm.as_slice(), n);
        let end = self.sm_proc.len();
        self.t2.clear();
        let mut i = a;
        let mut j = b;
        loop {
            if i >= b && j >= end {
                break;
            }
            let ip = at(in self.sm_proc.as_slice(), i);
            let inx = at(in self.sm_next.as_slice(), i);
            let jp = at(in self.sm_proc.as_slice(), j);
            let jnx = at(in self.sm_next.as_slice(), j);
            let take_i = j >= end || (i < b && (ip < jp || (ip == jp && inx <= jnx)));
            if take_i {
                self.t2.push(ip);
                self.t2.push(inx);
                if j < end && ip == jp && inx == jnx {
                    j = inc(j);
                }
                i = inc(i);
            } else {
                self.t2.push(jp);
                self.t2.push(jnx);
                j = inc(j);
            }
        }
        self.sm_proc.truncate(a);
        self.sm_next.truncate(a);
        let pairs = self.t2.len() >> 1;
        for k in 0..pairs {
            let p = at(in self.t2.as_slice(), wrapping_add(k, k));
            let next = at(in self.t2.as_slice(), inc(wrapping_add(k, k)));
            self.sm_proc.push(p);
            self.sm_next.push(next);
        }
    }

    fn pop_node(inout self) {
        let n = wrapping_sub(self.n_chosen.len(), 1);
        if self.caching {
            self.cache_insert(n);
            if n > 0 {
                self.merge_summary(n);
            } else {
                self.sm_proc.truncate(0);
                self.sm_next.truncate(0);
            }
        }
        let en0 = self.en_start(n);
        self.en.truncate(en0);
        self.en_bt.truncate(en0);
        self.en_done.truncate(en0);
        self.en_slept.truncate(en0);
        self.en_ord.truncate(en0);
        let nx0 = at(in self.n_nx.as_slice(), n);
        self.nx_proc.truncate(nx0);
        self.nx_next.truncate(nx0);
        let pc0 = at(in self.n_pc.as_slice(), n);
        self.pc_proc.truncate(pc0);
        self.pc_off.truncate(pc0);
        self.pc_len.truncate(pc0);
        let sl0 = at(in self.n_sl.as_slice(), n);
        self.sl.truncate(sl0);
        let cl0 = at(in self.n_cl.as_slice(), n);
        self.cl_proc.truncate(cl0);
        self.cl_val.truncate(cl0);
        self.n_en.truncate(n);
        self.n_en_len.truncate(n);
        self.n_nx.truncate(n);
        self.n_nx_len.truncate(n);
        self.n_pc.truncate(n);
        self.n_pc_len.truncate(n);
        self.n_sl.truncate(n);
        self.n_sl_len.truncate(n);
        self.n_sm.truncate(n);
        self.n_cl.truncate(n);
        self.n_chosen.truncate(n);
        self.n_running.truncate(n);
        self.n_pre.truncate(n);
        self.n_key.truncate(n);
        self.n_hit.truncate(n);
    }
}

// ---------------------------------------------------------------------------
// The search loop (src/dpor.rs `explore`).

pub fn search_nodes(in s: Search) -> u64 {
    s.n_chosen.len()
}

// The processes of the recorded prefix, to re-execute.
pub fn search_prefix(in s: Search) -> ChunkSeq[u64] {
    copy_of(in s.ev_proc.as_slice())
}

// The first state: its enabled processes, its `(process, transition)`
// pairs and its key.
pub fn search_root(inout s: Search, in enabled: Slice[u64], in nexts: Slice[u64], key: u64) {
    s.p_sleep.clear();
    s.n_pc.push(0);
    s.n_pc_len.push(0);
    s.push_node(in enabled, in nexts, none(), 0, 0);
    s.n_key.try_set(0, key);
}

// Whether the re-executed prefix reached the recorded enabled processes.
pub fn search_same_enabled(in s: Search, in enabled: Slice[u64]) -> bool {
    let d = s.ev_proc.len();
    let start = s.en_start(d);
    let len = at(in s.n_en_len.as_slice(), d);
    if len != enabled.len() {
        return false;
    }
    let mut same = true;
    for i in 0..len {
        if at(in s.en.as_slice(), wrapping_add(start, i)) != at(in enabled, i) {
            same = false;
        }
    }
    same
}

// The process to run at the current state (see the codes above). On code
// 0 the event is recorded; execute it, then call `search_child`.
pub fn search_choose(inout s: Search) -> Draw {
    let d = s.ev_proc.len();
    let mut p = at(in s.n_chosen.as_slice(), d);
    if p == none() {
        p = s.pick(d, false);
    }
    if p == none() {
        if at(in s.n_en_len.as_slice(), d) == 0 {
            return Draw {
                code: 2,
                value: 0
            };
        }
        s.stats.sleep_blocked = inc(s.stats.sleep_blocked);
        return Draw {
            code: 1,
            value: 0
        };
    }
    let next = at(in s.nx_next.as_slice(), s.nx_find(d, p));
    // The child's sleep set: sleeping processes independent of `p`.
    s.p_sleep.clear();
    if s.sleeping {
        let sl0 = at(in s.n_sl.as_slice(), d);
        let sl1 = wrapping_add(sl0, at(in s.n_sl_len.as_slice(), d));
        for i in sl0..sl1 {
            let q = at(in s.sl.as_slice(), i);
            s.sleep_keep(d, q, p, next);
        }
        let start = s.en_start(d);
        let end = s.en_end(d);
        for i in start..end {
            if atb(in s.en_slept.as_slice(), i) {
                let q = at(in s.en.as_slice(), i);
                s.sleep_keep(d, q, p, next);
            }
        }
    }
    let extra: u64 = if s.preempts(d, p) {
        1
    } else {
        0
    };
    s.p_pre = wrapping_add(at(in s.n_pre.as_slice(), d), extra);
    // The happens-before clock of the new event.
    s.t1.clear();
    let pci = s.pc_find(d, p);
    if pci != none() {
        let off = at(in s.pc_off.as_slice(), pci);
        let len = at(in s.pc_len.as_slice(), pci);
        for k in off..wrapping_add(off, len) {
            let q = at(in s.cl_proc.as_slice(), k);
            let v = at(in s.cl_val.as_slice(), k);
            s.t1.push(q);
            s.t1.push(v);
        }
    }
    for e in 0..d {
        let ep = at(in s.ev_proc.as_slice(), e);
        let en = at(in s.ev_next.as_slice(), e);
        if s.dep(ep, en, p, next) {
            let off = at(in s.ev_cl.as_slice(), e);
            let len = at(in s.ev_cl_len.as_slice(), e);
            s.join_into(off, len);
        }
    }
    s.t1_set(p, inc(d));
    let mark = s.cl_proc.len();
    let pairs = s.t1.len() >> 1;
    for k in 0..pairs {
        let q = at(in s.t1.as_slice(), wrapping_add(k, k));
        let v = at(in s.t1.as_slice(), inc(wrapping_add(k, k)));
        s.cl_proc.push(q);
        s.cl_val.push(v);
    }
    s.ev_proc.push(p);
    s.ev_next.push(next);
    s.ev_cl.push(mark);
    s.ev_cl_len.push(pairs);
    s.p_proc = p;
    s.p_next = next;
    s.p_mark = mark;
    Draw {
        code: 0,
        value: p
    }
}

impl Search {
    fn sleep_keep(inout self, d: u64, q: u64, p: u64, next: u64) {
        if q == p {
            return;
        }
        let i = self.nx_find(d, q);
        if i == none() {
            return;
        }
        let nq = at(in self.nx_next.as_slice(), i);
        if !self.dep(q, nq, p, next) {
            set_insert(inout self.p_sleep, q);
        }
    }
}

// The state after the chosen process ran: whether the fiber that ran is
// still ready, and the new enabled processes and transitions.
pub fn search_child(
    inout s: Search,
    still_ready: bool,
    in enabled: Slice[u64],
    in nexts: Slice[u64]
) {
    let d = wrapping_sub(s.ev_proc.len(), 1);
    let p = s.p_proc;
    let running = if proc_tag(p) == 0 {
        if still_ready {
            p
        } else {
            none()
        }
    } else {
        at(in s.n_running.as_slice(), d)
    };
    // Process clocks: the parent's, `p`'s new clock, and the new clock for
    // every process the step created.
    let start = s.pc_proc.len();
    let p0 = at(in s.n_pc.as_slice(), d);
    let p1 = wrapping_add(p0, at(in s.n_pc_len.as_slice(), d));
    for k in p0..p1 {
        let q = at(in s.pc_proc.as_slice(), k);
        let off = at(in s.pc_off.as_slice(), k);
        let len = at(in s.pc_len.as_slice(), k);
        s.pc_proc.push(q);
        s.pc_off.push(off);
        s.pc_len.push(len);
    }
    let coff = at(in s.ev_cl.as_slice(), d);
    let clen = at(in s.ev_cl_len.as_slice(), d);
    s.pc_insert(start, p, coff, clen, true);
    let pairs = nexts.len() >> 1;
    for i in 0..pairs {
        let q = at(in nexts, wrapping_add(i, i));
        if s.nx_find(d, q) == none() {
            s.pc_insert(start, q, coff, clen, false);
        }
    }
    s.n_pc.push(start);
    let pc_count = wrapping_sub(s.pc_proc.len(), start);
    s.n_pc_len.push(pc_count);
    let pre = s.p_pre;
    let mark = s.p_mark;
    s.push_node(in enabled, in nexts, running, pre, mark);
}

// The newest state's running fiber (`none` when none) and preemptions, for
// its key.
pub fn search_running(in s: Search) -> u64 {
    at(in s.n_running.as_slice(), wrapping_sub(s.n_running.len(), 1))
}

pub fn search_preemptions(in s: Search) -> u64 {
    at(in s.n_pre.as_slice(), wrapping_sub(s.n_pre.len(), 1))
}

// The newest state's key; adds the backtracking points. True when the
// state was already explored (abandon the execution).
pub fn search_key(inout s: Search, key: u64) -> bool {
    let n = s.ev_proc.len();
    s.n_key.try_set(n, key);
    let mut hit = false;
    if key != none() && s.caching && key < s.ca_set.len() && atb(in s.ca_set.as_slice(), key) {
        let sl0 = at(in s.n_sl.as_slice(), n);
        let sl1 = wrapping_add(sl0, at(in s.n_sl_len.as_slice(), n));
        let c0 = at(in s.ca_sl_off.as_slice(), key);
        let c1 = wrapping_add(c0, at(in s.ca_sl_len.as_slice(), key));
        hit = !s
            .dpor
            || (
            !s.bounded && range_subset(in s.ca_sl.as_slice(), c0, c1, in s.sl.as_slice(), sl0, sl1)
        );
    }
    if hit {
        s.n_hit.try_set(n, true);
        let sm0 = at(in s.n_sm.as_slice(), n);
        s.sm_proc.truncate(sm0);
        s.sm_next.truncate(sm0);
        let off = at(in s.ca_sm_off.as_slice(), key);
        let len = at(in s.ca_sm_len.as_slice(), key);
        for k in off..wrapping_add(off, len) {
            let p = at(in s.ca_smp.as_slice(), k);
            let next = at(in s.ca_smn.as_slice(), k);
            s.sm_proc.push(p);
            s.sm_next.push(next);
        }
    }
    if s.dpor {
        s.add_backtrack_points();
    }
    if hit {
        s.stats.cache_hits = inc(s.stats.cache_hits);
        if s.dpor {
            s.add_summary_points();
        }
    }
    hit
}

// Move to the deepest state with an unexplored alternative; false when
// the search is over.
pub fn search_backtrack(inout s: Search) -> bool {
    loop {
        let n = s.n_chosen.len();
        if n == 0 {
            break false;
        }
        let last = wrapping_sub(n, 1);
        let prev = at(in s.n_chosen.as_slice(), last);
        if prev != none() {
            s.n_chosen.try_set(last, none());
            if s.sleeping {
                let i = s.en_find(last, prev);
                if i != none() {
                    s.en_slept.try_set(i, true);
                }
            }
        }
        let found = if atb(in s.n_hit.as_slice(), last) {
            none()
        } else {
            let dpor = s.dpor;
            s.pick(last, dpor)
        };
        if found != none() {
            s.ev_truncate(last);
            break true;
        }
        s.pop_node();
        s.ev_truncate(sat_sub(last, 1));
    }
}

pub fn search_stats(in s: Search) -> SearchStats {
    s.stats
}

test {
    fn test_shrinker_reduces_length_then_value() -> bool {
        let mut initial = ChunkSeq::new[u64]();
        initial.push(7);
        initial.push(8);
        initial.push(9);
        let mut shrinker = shrinker_new(initial, 80);
        let empty = ChunkSeq::new[u64]();
        let rejected_before_next = !shrinker_record(inout shrinker, 0, in empty.as_slice());
        loop {
            let runs = shrinker.stats.runs;
            if !shrinker_next(inout shrinker) {
                break;
            }
            if shrinker.pc != 19 || shrinker.stats.runs != inc(runs) {
                return false;
            }
            let candidate = shrinker_candidate(in shrinker);
            let mut reproduces = false;
            for i in 0..candidate.len() {
                if at(in candidate.as_slice(), i) >= 3 {
                    reproduces = true;
                }
            }
            let invalid = candidate
                .len()
                == 0
                || (candidate.len() == 1 && candidate.try_get(0) == Option::Some(0));
            let outcome: u64 = if invalid {
                1
            } else if reproduces {
                0
            } else {
                2
            };
            let accepted = shrinker_record(inout shrinker, outcome, in candidate.as_slice());
            if outcome != 0 && accepted {
                return false;
            }
        }
        let best = shrinker_best(in shrinker);
        let stats = shrinker_stats(in shrinker);
        rejected_before_next
            && best
            .len()
            == 1
            && best
            .try_get(0)
            == Option::Some(3)
            && stats
            .accepted
            > 0
            && stats
            .invalid
            > 0
            && stats
            .not_reproducing
            > 0
            && stats
            .runs
            < 80
            && !stats
            .budget_exhausted
    }

    fn test_shrinker_stops_at_run_budget() -> bool {
        let mut tape = ChunkSeq::new[u64]();
        tape.push(77);
        let mut shrinker = shrinker_new(tape, 1);
        let stopped = !shrinker_next(inout shrinker);
        let stats = shrinker_stats(in shrinker);
        let best = shrinker_best(in shrinker);
        stopped && stats.runs == 1 && stats.budget_exhausted && best.try_get(0) == Option::Some(77)
    }

    fn test_fuzzer_observes_novelty_and_executes_solver_candidate() -> bool {
        let mut fuzzer = fuzzer_new(0, 4, false, 1, 8);
        let mut features = ChunkSeq::new[u64]();
        features.push(11);
        features.push(0);
        let closeness: u64 = (1 << 63) | 3;
        features.push(closeness);
        features.push(4);
        if !fuzzer_next(inout fuzzer)
            || fuzzer_seed(in fuzzer)
            != 16294208416658607535
            || fuzzer_observe(inout fuzzer, 0, in features.as_slice())
            != 1
            || fuzzer_observe(inout fuzzer, 0, in features.as_slice())
            != 0 {
            return false;
        }

        let mut values = ChunkSeq::new[u64]();
        values.push(2);
        let mut tags = ChunkSeq::new[u64]();
        tags.push(0);
        let mut limits = ChunkSeq::new[u64]();
        limits.push(7);
        let mut comparisons = ChunkSeq::new[u64]();
        comparisons.push(0);
        comparisons.push(0);
        comparisons.push(2);
        comparisons.push(7);
        fuzzer_keep(
            inout fuzzer,
            in values.as_slice(),
            in tags.as_slice(),
            in limits.as_slice(),
            in comparisons.as_slice()
        );
        if fuzzer_corpus_len(in fuzzer) != 1 || !fuzzer_next(inout fuzzer) {
            return false;
        }
        let entry = fuzzer_corpus_entry(in fuzzer, 0);
        let candidate = fuzzer_candidate(in fuzzer);
        features.try_set(3, 5);
        if entry
            .len()
            != 1
            || entry
            .try_get(0)
            != Option::Some(2)
            || candidate
            .len()
            != 1
            || candidate
            .try_get(0)
            != Option::Some(7)
            || fuzzer_observe(inout fuzzer, 0, in features.as_slice())
            != 1 {
            return false;
        }
        let stats = fuzzer_stats(in fuzzer);
        stats.execs == 2 && stats.solver_runs == 1 && stats.solver_hits == 1 && stats.features == 2
    }

    // @case budget(2, 0)
    // @case failure(4, 1)
    fn test_random_campaign_stops(max_execs: u64, verdict: u64) -> bool {
        let mut fuzzer = fuzzer_new(0, max_execs, true, 0, 0);
        let features = ChunkSeq::new[u64]();
        if !fuzzer_next(inout fuzzer)
            || fuzzer_observe(inout fuzzer, 2, in features.as_slice())
            != 0
            || !fuzzer_next(inout fuzzer) {
            return false;
        }
        let result = fuzzer_observe(inout fuzzer, verdict, in features.as_slice());
        let expected: u64 = if verdict == 1 {
            2
        } else {
            0
        };
        let stopped = !fuzzer_next(inout fuzzer);
        let stats = fuzzer_stats(in fuzzer);
        result == expected && stopped && stats.execs == 2 && stats.invalid == 1
    }

    fn test_exhaustive_search_revisits_root_for_second_choice() -> bool {
        let mut search = search_new(false, false, 0, false);
        let empty = ChunkSeq::new[u64]();
        let mut enabled = ChunkSeq::new[u64]();
        enabled.push(1);
        enabled.push(2);
        let footprint = search_footprint(
            inout search,
            in empty.as_slice(),
            in empty.as_slice(),
            false,
            in empty.as_slice()
        );
        let mut transitions = ChunkSeq::new[u64]();
        transitions.push(1);
        transitions.push(footprint);
        transitions.push(2);
        transitions.push(footprint);
        search_root(inout search, in enabled.as_slice(), in transitions.as_slice(), none());
        if !search_same_enabled(in search, in enabled.as_slice()) || search_nodes(in search) != 1 {
            return false;
        }
        let first = search_choose(inout search);
        if first.code != 0 || first.value != 1 {
            return false;
        }
        search_child(inout search, false, in empty.as_slice(), in empty.as_slice());
        let done = search_choose(inout search);
        let prefix = search_prefix(in search);
        if done
            .code
            != 2
            || prefix
            .len()
            != 1
            || prefix
            .try_get(0)
            != Option::Some(1)
            || search_running(in search)
            != none()
            || search_preemptions(in search)
            != 0
            || !search_backtrack(inout search)
            || search_nodes(in search)
            != 1 {
            return false;
        }
        let second = search_choose(inout search);
        if second.code != 0 || second.value != 2 {
            return false;
        }
        search_child(inout search, false, in empty.as_slice(), in empty.as_slice());
        !search_backtrack(inout search)
    }

    // @case same_task_io(1, 4611687117939015680, false)
    // @case other_task_io(2, 4611687117939015680, true)
    // @case task_and_timer(1, 9223372041149743104, false)
    // @case io_and_timer(4611687117939015680, 9223372041149743104, true)
    // @case two_tasks(1, 2, true)
    fn test_process_coexistence(a: u64, b: u64, expected: bool) -> bool {
        may_co_enable(a, b) == expected && may_co_enable(b, a) == expected
    }

    // @case all_bits(0, 18446744073709551615, 16294208416658607535)
    // @case single_outcome(0, 0, 0)
    // First output is exactly the rejection threshold for a range of size three.
    // @case threshold(17885559969949501885, 2, 1)
    fn test_rng_draw(seed: u64, max_value: u64, expected: u64) -> bool {
        let mut rng = Rng {
            word: seed
        };
        rng_below_inclusive(inout rng, max_value)
            == expected
            && rng
            .word
            == wrapping_add(seed, 0x9e3779b97f4a7c15)
    }

    fn footprint_from_masks(
        inout search: Search,
        reads: u64,
        writes: u64,
        cancels: u64,
        spawns: bool
    ) -> u64 {
        let mut r = ChunkSeq::new[u64]();
        let mut w = ChunkSeq::new[u64]();
        let mut c = ChunkSeq::new[u64]();
        let count: u32 = 8;
        for i in 0..count {
            let bit: u64 = 1 << i;
            if (reads & bit) != 0 {
                r.push(widen_u64(i));
            }
            if (writes & bit) != 0 {
                w.push(widen_u64(i));
            }
            if (cancels & bit) != 0 {
                c.push(widen_u64(i));
            }
        }
        search_footprint(inout search, in r.as_slice(), in w.as_slice(), spawns, in c.as_slice())
    }

    // @case read_read(6, 0, 0, false, 4, 0, false, false)
    // @case read_write(6, 0, 0, false, 0, 4, false, true)
    // @case write_read(0, 6, 0, false, 4, 0, false, true)
    // @case write_write(0, 6, 0, false, 0, 5, false, true)
    // @case disjoint_writes(0, 6, 0, false, 0, 9, false, false)
    // @case two_spawns(0, 0, 0, true, 0, 0, true, true)
    // @case one_spawn(0, 0, 0, true, 0, 0, false, false)
    // @case cancels_other_task(0, 0, 4, false, 0, 0, false, true)
    // @case cancels_unrelated_task(0, 0, 8, false, 0, 0, false, false)
    fn test_transition_footprint_conflicts(
        a_reads: u64,
        a_writes: u64,
        a_cancels: u64,
        a_spawns: bool,
        b_reads: u64,
        b_writes: u64,
        b_spawns: bool,
        dependent: bool
    ) -> bool {
        let mut search = search_new(true, false, 0, false);
        let a = footprint_from_masks(inout search, a_reads, a_writes, a_cancels, a_spawns);
        let b = footprint_from_masks(inout search, b_reads, b_writes, 0, b_spawns);
        a
            == 0
            && b
            == 1
            && search
            .dep(1, a, 2, b)
            == dependent
            && search
            .dep(2, b, 1, a)
            == dependent
    }

    // @case shorter_wins(1, 3, 9, 2, 0, 0, true)
    // @case longer_loses(2, 0, 0, 1, 3, 9, false)
    // @case fewer_carries_wins(2, 0, 18446744073709551615, 2, 1, 0, true)
    // @case more_carries_loses(2, 1, 0, 2, 0, 18446744073709551615, false)
    // @case lower_sum_wins(2, 0, 5, 2, 0, 6, true)
    // @case higher_sum_loses(2, 0, 6, 2, 0, 5, false)
    // @case equal_is_not_smaller(2, 1, 5, 2, 1, 5, false)
    fn test_shrink_key_order(
        a_len: u64,
        a_hi: u64,
        a_lo: u64,
        b_len: u64,
        b_hi: u64,
        b_lo: u64,
        expected: bool
    ) -> bool {
        let a = Key {
            len: a_len,
            hi: a_hi,
            lo: a_lo
        };
        let b = Key {
            len: b_len,
            hi: b_hi,
            lo: b_lo
        };
        key_smaller(a, b) == expected
    }

    // @case tab(in "\t", 1)
    // @case line_feed(in "\n", 1)
    // @case vertical_tab(in "\u000b", 1)
    // @case form_feed(in "\f", 1)
    // @case carriage_return(in "\r", 1)
    // @case space(in " ", 1)
    // @case before_ascii_whitespace(in "\b", 0)
    // @case after_ascii_whitespace(in "\u000e", 0)
    // @case non_space_ascii(in "!", 0)
    // @case next_line(in "\u0085", 2)
    // @case nonbreaking_space(in "\u00a0", 2)
    // @case other_c2_character(in "\u00a1", 0)
    // @case ogham_space(in "\u1680", 3)
    // @case non_whitespace_ogham(in "\u1681", 0)
    // @case other_e1_second_byte(in "\u1600", 0)
    // @case first_en_space(in "\u2000", 3)
    // @case hair_space(in "\u200a", 3)
    // @case zero_width_space(in "\u200b", 0)
    // @case line_separator(in "\u2028", 3)
    // @case paragraph_separator(in "\u2029", 3)
    // @case narrow_nonbreaking_space(in "\u202f", 3)
    // @case medium_mathematical_space(in "\u205f", 3)
    // @case other_medium_symbol(in "\u205e", 0)
    // @case ideographic_space(in "\u3000", 3)
    // @case ideographic_comma(in "\u3001", 0)
    // @case other_e3_second_byte(in "\u3040", 0)
    // @case other_e2_second_byte(in "\u2080", 0)
    // @case unrelated_unicode(in "\u00e9", 0)
    fn test_unicode_trimming(in value: Str, width: u64) -> bool {
        let bytes = value.as_bytes();
        let n = bytes.len();
        if space_at(in bytes, 0, n) != width || space_before(in bytes, 0, n) != width {
            return false;
        }
        let cut = wrapping_sub(n, 1);
        space_at(in bytes, 0, cut)
            == 0
            && space_before(in bytes, 1, n)
            == 0
            && space_at(in bytes, n, n)
            == 0
            && space_before(in bytes, n, n)
            == 0
    }

    // @case no_solver_rows(0, in "")
    // @case first_candidate_only(1, in "8")
    // @case sorted_distinct_candidates(8, in "789")
    fn test_solver_orders_and_deduplicates_candidates(budget: u64, in expected: Str) -> bool {
        let mut fuzzer = fuzzer_new(0, 8, false, 0, budget);
        let mut values = ChunkSeq::new[u64]();
        values.push(2);
        let mut kinds = ChunkSeq::new[u64]();
        kinds.push(0);
        let mut limits = ChunkSeq::new[u64]();
        limits.push(9);
        let mut comparisons = ChunkSeq::new[u64]();
        let count: u64 = 2;
        for i in 0..count {
            comparisons.push(0);
            comparisons.push(2);
            comparisons.push(2);
            comparisons.push(8);
        }
        fuzzer_keep(
            inout fuzzer,
            in values.as_slice(),
            in kinds.as_slice(),
            in limits.as_slice(),
            in comparisons.as_slice()
        );
        fuzzer.solve(0);
        if fuzzer.width != 1 || fuzzer.order.len() != expected.len() {
            return false;
        }
        if budget == 0 && fuzzer.full {
            return false;
        }
        let expected_bytes = expected.as_bytes();
        for i in 0..expected.len() {
            let row = at(in fuzzer.order.as_slice(), i);
            if fuzzer.row_at(row, 0) != wrapping_sub(byte(in expected_bytes, i), 48) {
                return false;
            }
        }
        true
    }

    // @case random_choice(25, in "3379")
    // @case zero_choice(3, in "3079")
    // @case maximum_choice(32, in "3f79")
    // @case add_delta(34, in "3f79")
    // @case subtract_delta(4, in "3509")
    // @case delete_span(11, in "3")
    // @case duplicate_span(2, in "379579")
    // @case truncate_tape(8, in "35")
    // @case splice_corpus(18, in "353579")
    // @case flip_bit(1, in "3f79")
    // @case delete_keeps_tail(58, in "359")
    fn test_seeded_tape_mutations(seed: u64, in expected: Str) -> bool {
        let mut fuzzer = fuzzer_new(seed, 8, false, 0, 0);
        let mut source = ChunkSeq::new[u64]();
        source.push(3);
        source.push(5);
        source.push(7);
        source.push(9);
        let mut kinds = ChunkSeq::new[u64]();
        kinds.resize(4, 0);
        let mut limits = ChunkSeq::new[u64]();
        limits.resize(4, 15);
        let comparisons = ChunkSeq::new[u64]();
        fuzzer_keep(
            inout fuzzer,
            in source.as_slice(),
            in kinds.as_slice(),
            in limits.as_slice(),
            in comparisons.as_slice()
        );
        fuzzer.cur.extend(in source.as_slice());
        fuzzer.mutate_once(0, 4, 1);
        let tape = fuzzer_candidate(in fuzzer);
        let bytes = expected.as_bytes();
        if tape.len() != bytes.len() {
            return false;
        }
        for i in 0..tape.len() {
            if widen_u64(hex_digit(at(in tape.as_slice(), i))) != byte(in bytes, i) {
                return false;
            }
        }
        true
    }

    // @case disabled(false, false, 0)
    // @case enabled(true, true, 1)
    fn test_search_records_exhausted_child_in_cache(caching: bool, expected_hit: bool, hits: u64)
        -> bool {
        let mut search = search_new(false, false, 0, caching);
        let empty = ChunkSeq::new[u64]();
        let mut enabled = ChunkSeq::new[u64]();
        enabled.push(1);
        enabled.push(2);
        let mut nexts = ChunkSeq::new[u64]();
        nexts.push(1);
        nexts.push(0);
        nexts.push(2);
        nexts.push(0);
        search_root(inout search, in enabled.as_slice(), in nexts.as_slice(), none());
        if search_choose(inout search).code != 0 {
            return false;
        }
        search_child(inout search, false, in empty.as_slice(), in empty.as_slice());
        if search_key(inout search, 2)
            || !search_backtrack(inout search)
            || search_choose(inout search)
            .code
            != 0 {
            return false;
        }
        search_child(inout search, false, in empty.as_slice(), in empty.as_slice());
        if search_key(inout search, 1) {
            return false;
        }
        let hit = search_key(inout search, 2);
        hit
            == expected_hit
            && search_stats(in search)
            .cache_hits
            == hits
            && !search_backtrack(inout search)
    }

    // @case same_task(1, true, 0, 1, false, true)
    // @case no_running_task(18446744073709551615, true, 0, 2, false, true)
    // @case disabled_running_task(3, true, 0, 2, false, true)
    // @case switches_at_bound(1, true, 0, 2, true, false)
    // @case switches_with_budget(1, true, 1, 2, true, true)
    // @case switches_without_bound(1, false, 0, 2, true, true)
    // @case io_does_not_preempt(1, true, 0, 4611687117939015680, false, true)
    fn test_preemption_budget(
        running: u64,
        bounded: bool,
        limit: u64,
        next: u64,
        preempts: bool,
        allowed: bool
    ) -> bool {
        let mut search = search_new(true, bounded, limit, false);
        let mut enabled = ChunkSeq::new[u64]();
        enabled.push(1);
        enabled.push(2);
        let nexts = ChunkSeq::new[u64]();
        search_root(inout search, in enabled.as_slice(), in nexts.as_slice(), none());
        search.n_running.try_set(0, running);
        search.preempts(0, next) == preempts && search.allowed(0, next) == allowed
    }

    fn test_clock_join_keeps_sorted_componentwise_maxima() -> bool {
        let mut search = search_new(true, false, 0, false);
        search.t1_set(4, 2);
        search.t1_set(1, 7);
        search.t1_set(2, 6);
        search.t1_set(1, 8);
        search.cl_proc.push(0);
        search.cl_val.push(99);
        search.cl_proc.push(2);
        search.cl_val.push(3);
        search.cl_proc.push(3);
        search.cl_val.push(9);
        search.cl_proc.push(4);
        search.cl_val.push(5);
        search.cl_proc.push(5);
        search.cl_val.push(1);
        search.join_into(1, 4);
        let first = search
            .t1
            .try_get(0)
            == Option::Some(1)
            && search
            .t1
            .try_get(1)
            == Option::Some(8)
            && search
            .t1
            .try_get(2)
            == Option::Some(2)
            && search
            .t1
            .try_get(3)
            == Option::Some(6);
        let middle = search
            .t1
            .try_get(4)
            == Option::Some(3)
            && search
            .t1
            .try_get(5)
            == Option::Some(9)
            && search
            .t1
            .try_get(6)
            == Option::Some(4)
            && search
            .t1
            .try_get(7)
            == Option::Some(5);
        let last = search
            .t1
            .try_get(8)
            == Option::Some(5)
            && search
            .t1
            .try_get(9)
            == Option::Some(1);
        search.t1.len() == 10 && first && middle && last
    }

    fn test_merge_ordered_summaries_deduplicates_transitions() -> bool {
        let mut search = search_new(true, false, 0, true);
        search.n_sm.push(0);
        search.sm_insert(0, 4, 8);
        search.sm_insert(0, 1, 7);
        search.sm_insert(0, 4, 6);
        search.sm_insert(0, 4, 6);
        let child = search.sm_proc.len();
        search.n_sm.push(child);
        search.sm_insert(child, 4, 8);
        search.sm_insert(child, 4, 7);
        search.sm_insert(child, 0, 3);
        search.sm_insert(child, 9, 2);
        search.merge_summary(1);
        let bounds = search
            .sm_proc
            .try_get(0)
            == Option::Some(0)
            && search
            .sm_proc
            .try_get(1)
            == Option::Some(1)
            && search
            .sm_proc
            .try_get(5)
            == Option::Some(9);
        let ordered_process = search
            .sm_proc
            .try_get(2)
            == Option::Some(4)
            && search
            .sm_proc
            .try_get(3)
            == Option::Some(4)
            && search
            .sm_proc
            .try_get(4)
            == Option::Some(4);
        let ordered_next = search
            .sm_next
            .try_get(2)
            == Option::Some(6)
            && search
            .sm_next
            .try_get(3)
            == Option::Some(7)
            && search
            .sm_next
            .try_get(4)
            == Option::Some(8);
        search
            .sm_proc
            .len()
            == 6
            && search
            .sm_next
            .len()
            == 6
            && bounds
            && ordered_process
            && ordered_next
    }

    // @case two_matches(in "ab", in "XY", in "XYZababZXY")
    // @case target_is_longer(in "ab", in "XYZ", in "XYZababZXY")
    // @case target_is_shorter(in "ab", in "X", in "XbZababZXb")
    // @case empty_target(in "ab", in "", in "")
    // @case empty_needle(in "", in "XY", in "")
    // @case no_match(in "ac", in "XY", in "")
    // @case reverse_comparison(in "XY", in "ab", in "XYZababZXY")
    fn test_solver_replaces_bytes_across_draws(
        in needle: Str,
        in replacement: Str,
        in expected: Str
    ) -> bool {
        let mut fuzzer = fuzzer_new(0, 8, false, 0, 8);
        let sample = "abZab".as_bytes();
        let mut values = ChunkSeq::new[u64]();
        let mut kinds = ChunkSeq::new[u64]();
        let mut limits = ChunkSeq::new[u64]();
        for i in 0..sample.len() {
            values.push(byte(in sample, i));
            kinds
                .push(
                if i == 2 {
                    0
                } else {
                    1
                }
            );
            limits.push(255);
        }
        let mut comparisons = ChunkSeq::new[u64]();
        comparisons.push(1);
        comparisons.push(needle.len());
        comparisons.push(replacement.len());
        let lhs = needle.as_bytes();
        let rhs = replacement.as_bytes();
        for i in 0..lhs.len() {
            comparisons.push(byte(in lhs, i));
        }
        for i in 0..rhs.len() {
            comparisons.push(byte(in rhs, i));
        }
        fuzzer_keep(
            inout fuzzer,
            in values.as_slice(),
            in kinds.as_slice(),
            in limits.as_slice(),
            in comparisons.as_slice()
        );
        fuzzer.solve(0);
        let expected_bytes = expected.as_bytes();
        if wrapping_mul(fuzzer.order.len(), sample.len()) != expected_bytes.len() {
            return false;
        }
        for i in 0..fuzzer.order.len() {
            let row = at(in fuzzer.order.as_slice(), i);
            for j in 0..sample.len() {
                let offset = wrapping_add(wrapping_mul(i, sample.len()), j);
                if fuzzer.row_at(row, j) != byte(in expected_bytes, offset) {
                    return false;
                }
            }
        }
        true
    }

    fn test_missing_boolean_reads_as_false() -> bool {
        let mut values = ChunkSeq::new[bool]();
        values.push(true);
        atb(in values.as_slice(), 0) && !atb(in values.as_slice(), 1)
    }

    fn test_chance_excludes_threshold() -> bool {
        // The first SplitMix64 result is exactly 1.
        let mut rng = Rng {
            word: 17885559969949501885
        };
        !rng_chance(inout rng, 1)
    }

    fn test_shrinker_zeros_span_when_deletions_are_invalid() -> bool {
        let mut initial = ChunkSeq::new[u64]();
        initial.resize(8, 5);
        let mut shrinker = shrinker_new(initial, 70);
        let mut zeroed = false;
        loop {
            let runs = shrinker.stats.runs;
            if !shrinker_next(inout shrinker) {
                break;
            }
            if shrinker.pc != 19 || shrinker.stats.runs != inc(runs) {
                return false;
            }
            let candidate = shrinker_candidate(in shrinker);
            if candidate.len() == 8 && !zeroed {
                let key = tape_key(in candidate.as_slice());
                if key.lo != 0 || key.hi != 0 {
                    return false;
                }
                zeroed = true;
            }
            let outcome: u64 = if candidate.len() == 8 {
                0
            } else {
                1
            };
            shrinker_record(inout shrinker, outcome, in candidate.as_slice());
        }
        let best = shrinker_best(in shrinker);
        let stats = shrinker_stats(in shrinker);
        let key = tape_key(in best.as_slice());
        zeroed
            && key
            .len
            == 8
            && key
            .lo
            == 0
            && stats
            .accepted
            == 1
            && stats
            .invalid
            == 40
            && !stats
            .budget_exhausted
    }

    fn test_shrinker_lowers_with_binary_search() -> bool {
        let mut initial = ChunkSeq::new[u64]();
        initial.push(49);
        let mut shrinker = shrinker_new(initial, 60);
        loop {
            let runs = shrinker.stats.runs;
            if !shrinker_next(inout shrinker) {
                break;
            }
            if shrinker.pc != 19 || shrinker.stats.runs != inc(runs) {
                return false;
            }
            let candidate = shrinker_candidate(in shrinker);
            let reproduces = candidate.len() == 1 && at(in candidate.as_slice(), 0) >= 13;
            let outcome: u64 = if reproduces {
                0
            } else {
                2
            };
            shrinker_record(inout shrinker, outcome, in candidate.as_slice());
        }
        let best = shrinker_best(in shrinker);
        let stats = shrinker_stats(in shrinker);
        best
            .len()
            == 1
            && best
            .try_get(0)
            == Option::Some(13)
            && stats
            .accepted
            > 0
            && stats
            .not_reproducing
            > 8
            && !stats
            .budget_exhausted
    }

    fn test_shrinker_lowers_count_and_removes_corresponding_value() -> bool {
        let mut initial = ChunkSeq::new[u64]();
        initial.push(2);
        initial.push(37);
        initial.push(42);
        let mut shrinker = shrinker_new(initial, 160);
        loop {
            let runs = shrinker.stats.runs;
            if !shrinker_next(inout shrinker) {
                break;
            }
            if shrinker.pc != 19 || shrinker.stats.runs != inc(runs) {
                return false;
            }
            let candidate = shrinker_candidate(in shrinker);
            let valid = candidate
                .len()
                > 0
                && wrapping_add(at(in candidate.as_slice(), 0), 1)
                == candidate
                .len();
            let outcome: u64 = if valid {
                0
            } else {
                1
            };
            shrinker_record(inout shrinker, outcome, in candidate.as_slice());
        }
        let best = shrinker_best(in shrinker);
        let stats = shrinker_stats(in shrinker);
        best
            .len()
            == 1
            && best
            .try_get(0)
            == Option::Some(0)
            && stats
            .accepted
            > 0
            && stats
            .invalid
            > 0
            && !stats
            .budget_exhausted
    }

    fn test_shrinker_waits_for_the_current_result() -> bool {
        let mut initial = ChunkSeq::new[u64]();
        initial.push(11);
        initial.push(13);
        let mut shrinker = shrinker_new(initial, 8);
        if !shrinker_next(inout shrinker) {
            return false;
        }
        let current = shrinker_candidate(in shrinker);
        let waiting = !shrinker_next(inout shrinker);
        let next = shrinker_candidate(in shrinker);
        waiting
            && shrinker
            .stats
            .runs
            == 2
            && shrinker
            .pc
            == 19
            && current
            .len()
            == 1
            && current
            .try_get(0)
            == Option::Some(13)
            && next
            .len()
            == 1
            && next
            .try_get(0)
            == Option::Some(13)
    }

    // @case smaller_with_budget(2, 1, true, 2, 19)
    // @case equal_is_skipped(2, 9, false, 1, 10)
    // @case larger_is_skipped(2, 10, false, 1, 10)
    // @case smaller_without_budget(1, 1, false, 1, 10)
    fn test_shrinker_attempt_requires_progress_and_budget(
        max_runs: u64,
        value: u64,
        starts: bool,
        runs: u64,
        pc: u64
    ) -> bool {
        let mut best = ChunkSeq::new[u64]();
        best.push(9);
        let mut shrinker = shrinker_new(best, max_runs);
        if shrinker.res || shrinker.improved {
            return false;
        }
        shrinker.cand.push(value);
        shrinker.res = true;
        let actual = shrinker.attempt(10);
        actual
            == starts
            && shrinker
            .stats
            .runs
            == runs
            && shrinker
            .pc
            == pc
            && shrinker
            .res
            == starts
            && shrinker
            .after
            == 10
    }

    // @case delete_last_legal_span(2, 2, 2, 1, 2)
    // @case delete_first_span(0, 2, 2, 3, 4)
    fn test_shrinker_deletes_exact_span(index: u64, width: u64, size: u64, first: u64, last: u64)
        -> bool {
        let mut initial = ChunkSeq::new[u64]();
        initial.push(1);
        initial.push(2);
        initial.push(3);
        initial.push(4);
        let mut shrinker = shrinker_new(initial, 10);
        shrinker.idx = index;
        shrinker.chunk = width;
        shrinker.pc = 3;
        let starts = shrinker_next(inout shrinker);
        let candidate = shrinker_candidate(in shrinker);
        starts
            && candidate
            .len()
            == size
            && candidate
            .try_get(0)
            == Option::Some(first)
            && candidate
            .try_get(wrapping_sub(size, 1))
            == Option::Some(last)
    }

    // @case reproduces(0, true, 1, 0, 0)
    // @case invalid(1, false, 0, 1, 0)
    // @case passes(2, false, 0, 0, 1)
    fn test_shrinker_records_exact_outcome(
        outcome: u64,
        accepted: bool,
        improvements: u64,
        invalid: u64,
        passed: u64
    ) -> bool {
        let mut initial = ChunkSeq::new[u64]();
        initial.push(11);
        initial.push(13);
        let mut shrinker = shrinker_new(initial, 8);
        if !shrinker_next(inout shrinker) {
            return false;
        }
        let candidate = shrinker_candidate(in shrinker);
        let result = shrinker_record(inout shrinker, outcome, in candidate.as_slice());
        let stats = shrinker_stats(in shrinker);
        let best = shrinker_best(in shrinker);
        let expected_len: u64 = if accepted {
            1
        } else {
            2
        };
        result
            == accepted
            && stats
            .accepted
            == improvements
            && stats
            .invalid
            == invalid
            && stats
            .not_reproducing
            == passed
            && best
            .len()
            == expected_len
    }

    fn test_fuzzer_initial_control_state() -> bool {
        let fuzzer = fuzzer_new(0, 8, false, 0, 0);
        let stats = fuzzer_stats(in fuzzer);
        !fuzzer
            .found
            && !fuzzer
            .in_solver
            && !fuzzer
            .full
            && !fuzzer
            .solver_run
            && fuzzer_corpus_len(in fuzzer)
            == 0
            && stats
            .execs
            == 0
    }

    fn test_sorted_feature_set_keeps_unique_values() -> bool {
        let mut values = ChunkSeq::new[u64]();
        let zero = set_insert(inout values, 0);
        let high = set_insert(inout values, 7);
        let middle = set_insert(inout values, 4);
        let repeated = set_insert(inout values, 4);
        let small = set_insert(inout values, 1);
        let membership_changed = zero && high && middle && !repeated && small;
        membership_changed
            && values
            .len()
            == 4
            && values
            .try_get(0)
            == Option::Some(0)
            && values
            .try_get(1)
            == Option::Some(1)
            && values
            .try_get(2)
            == Option::Some(4)
            && values
            .try_get(3)
            == Option::Some(7)
    }

    // @case identity(7, 0, 7, 7)
    // @case finite_result(9, 4, 13, 5)
    // @case subtraction_saturates(3, 4, 7, 0)
    // @case addition_saturates(18446744073709551615, 1, 18446744073709551615, 18446744073709551614)
    fn test_choice_arithmetic_saturates(a: u64, b: u64, sum: u64, difference: u64) -> bool {
        sat_add(a, b) == sum && sat_sub(a, b) == difference
    }

    fn test_solver_does_not_admit_rows_past_limit() -> bool {
        let mut fuzzer = fuzzer_new(0, 8, false, 0, 0);
        fuzzer.width = 1;
        fuzzer.c_vals.push(2);
        fuzzer.scratch.push(7);
        !fuzzer.push_scratch(0) && fuzzer.full && fuzzer.order.len() == 0
    }

    fn test_new_tape_position_uses_unrestricted_range() -> bool {
        let mut fuzzer = fuzzer_new(65, 8, false, 0, 0);
        fuzzer.cur.resize(5, 4);
        fuzzer.c_max.resize(4, 5);
        fuzzer.mutate_once(0, 4, 1);
        fuzzer.cur.len() == 5 && fuzzer.cur.try_get(4) == Option::Some(18446744073709551615)
    }

    fn test_solver_admits_only_unique_changed_rows() -> bool {
        let mut fuzzer = fuzzer_new(0, 8, false, 0, 2);
        fuzzer.width = 1;
        fuzzer.c_vals.push(2);
        fuzzer.scratch.push(2);
        if !fuzzer.push_scratch(0) || fuzzer.order.len() != 0 {
            return false;
        }
        fuzzer.scratch.try_set(0, 1);
        if !fuzzer.push_scratch(0) || !fuzzer.push_scratch(0) || fuzzer.order.len() != 1 {
            return false;
        }
        fuzzer.scratch.try_set(0, 3);
        let admitted_final = !fuzzer.push_scratch(0);
        let full = fuzzer.full && fuzzer.order.len() == 2;
        fuzzer.scratch.try_set(0, 4);
        admitted_final && full && !fuzzer.push_scratch(0) && fuzzer.order.len() == 2
    }

    // @case lower_limit(0, 0, 1)
    // @case upper_limit(18446744073709551615, 18446744073709551614, 18446744073709551615)
    fn test_solver_does_not_wrap_ordering_targets(target: u64, first: u64, second: u64) -> bool {
        let mut fuzzer = fuzzer_new(0, 8, false, 0, 8);
        fuzzer.width = 1;
        fuzzer.c_vals.push(2);
        fuzzer.c_tag.push(0);
        fuzzer.c_max.push(18446744073709551615);
        fuzzer.solve_int(0, 2, 2, target);
        fuzzer
            .order
            .len()
            == 2
            && fuzzer
            .row_at(at(in fuzzer.order.as_slice(), 0), 0)
            == first
            && fuzzer
            .row_at(at(in fuzzer.order.as_slice(), 1), 0)
            == second
    }

    fn test_solver_keeps_comparisons_inside_each_corpus_entry() -> bool {
        let mut fuzzer = fuzzer_new(0, 8, false, 0, 8);
        let mut values = ChunkSeq::new[u64]();
        values.push(2);
        let mut kinds = ChunkSeq::new[u64]();
        kinds.push(0);
        let mut limits = ChunkSeq::new[u64]();
        limits.push(9);
        let mut cmps = ChunkSeq::new[u64]();
        fuzzer_keep(
            inout fuzzer,
            in values.as_slice(),
            in kinds.as_slice(),
            in limits.as_slice(),
            in cmps.as_slice()
        );
        cmps.push(0);
        cmps.push(0);
        cmps.push(2);
        cmps.push(9);
        fuzzer_keep(
            inout fuzzer,
            in values.as_slice(),
            in kinds.as_slice(),
            in limits.as_slice(),
            in cmps.as_slice()
        );
        fuzzer.solve(0);
        if fuzzer.order.len() != 0 {
            return false;
        }
        fuzzer.solve(1);
        fuzzer.order.len() == 1 && fuzzer.row_at(at(in fuzzer.order.as_slice(), 0), 0) == 9
    }

    // @case width_1_little(in "a", 97, 87, in "W")
    // @case width_2_little(in "ab", 25185, 22615, in "WX")
    // @case width_2_big(in "ab", 24930, 22360, in "WX")
    // @case width_4_little(in "abcd", 1684234849, 1515804759, in "WXYZ")
    // @case width_4_big(in "abcd", 1633837924, 1465407834, in "WXYZ")
    // @case width_8_little(in "abcdefgh", 7523094288207667809, 6003950658793330775, in "WXYZPQRS")
    // @case width_8_big(in "abcdefgh", 7017280452245743464, 6293878723679703635, in "WXYZPQRS")
    // @case target_too_wide(in "a", 97, 256, in "")
    // @case reverse_comparison(in "a", 88, 97, in "X")
    fn test_solver_encodes_integer_targets_in_byte_lanes(
        in sample: Str,
        needle: u64,
        target: u64,
        in expected: Str
    ) -> bool {
        let mut fuzzer = fuzzer_new(0, 8, false, 0, 8);
        let mut values = ChunkSeq::new[u64]();
        let mut kinds = ChunkSeq::new[u64]();
        let mut limits = ChunkSeq::new[u64]();
        let bytes = sample.as_bytes();
        for i in 0..bytes.len() {
            values.push(byte(in bytes, i));
            kinds.push(1);
            limits.push(255);
        }
        let mut comparisons = ChunkSeq::new[u64]();
        comparisons.push(0);
        comparisons.push(0);
        comparisons.push(needle);
        comparisons.push(target);
        fuzzer_keep(
            inout fuzzer,
            in values.as_slice(),
            in kinds.as_slice(),
            in limits.as_slice(),
            in comparisons.as_slice()
        );
        fuzzer.solve(0);
        if expected.len() == 0 {
            return fuzzer.order.len() == 0;
        }
        if fuzzer.order.len() != 1 {
            return false;
        }
        let row = at(in fuzzer.order.as_slice(), 0);
        let desired = expected.as_bytes();
        for i in 0..desired.len() {
            if fuzzer.row_at(row, i) != byte(in desired, i) {
                return false;
            }
        }
        true
    }

    // @case guided_without_corpus(false, false, 0)
    // @case random_ignores_corpus(true, true, 0)
    // @case initial_random_ignores_corpus(false, true, 2)
    fn test_fuzzer_empty_candidate_policy(random: bool, seeded: bool, initial_random: u64) -> bool {
        let mut fuzzer = fuzzer_new(0, 3, random, initial_random, 0);
        if seeded {
            let mut values = ChunkSeq::new[u64]();
            values.push(3);
            let empty = ChunkSeq::new[u64]();
            fuzzer_keep(
                inout fuzzer,
                in values.as_slice(),
                in empty.as_slice(),
                in empty.as_slice(),
                in empty.as_slice()
            );
        }
        let starts = fuzzer_next(inout fuzzer);
        let candidate = fuzzer_candidate(in fuzzer);
        starts && candidate.len() == 0 && !fuzzer.solver_run && fuzzer.stats.execs == 1
    }

    fn keep_integer_comparison(inout fuzzer: Fuzzer, input: u64, target: u64) {
        let mut values = ChunkSeq::new[u64]();
        let mut kinds = ChunkSeq::new[u64]();
        let mut limits = ChunkSeq::new[u64]();
        let mut comparisons = ChunkSeq::new[u64]();
        values.push(input);
        kinds.push(0);
        limits.push(15);
        comparisons.push(0);
        comparisons.push(0);
        comparisons.push(input);
        comparisons.push(target);
        fuzzer_keep(
            inout fuzzer,
            in values.as_slice(),
            in kinds.as_slice(),
            in limits.as_slice(),
            in comparisons.as_slice()
        );
    }

    fn test_fuzzer_exhausts_each_solver_before_mutating_corpus() -> bool {
        let mut fuzzer = fuzzer_new(42, 3, false, 0, 8);
        keep_integer_comparison(inout fuzzer, 2, 7);
        keep_integer_comparison(inout fuzzer, 4, 9);
        if !fuzzer_next(inout fuzzer) || !fuzzer.solver_run {
            return false;
        }
        let first = fuzzer_candidate(in fuzzer);
        if first
            .len()
            != 1
            || first
            .try_get(0)
            != Option::Some(7)
            || !fuzzer_next(inout fuzzer)
            || !fuzzer
            .solver_run {
            return false;
        }
        let second = fuzzer_candidate(in fuzzer);
        if second.len() != 1 || second.try_get(0) != Option::Some(9) {
            return false;
        }
        let mutates = fuzzer_next(inout fuzzer);
        let mutation = mutates && !fuzzer.solver_run && fuzzer.stats.solver_runs == 2;
        mutation && fuzzer.stats.execs == 3 && !fuzzer_next(inout fuzzer)
    }

    fn test_comparison_feature_requires_strict_improvement() -> bool {
        let mut fuzzer = fuzzer_new(0, 4, false, 0, 0);
        let mut feature = ChunkSeq::new[u64]();
        feature.push(0x8000000000000005);
        feature.push(0);
        let first = fuzzer_observe(inout fuzzer, 0, in feature.as_slice());
        feature.try_set(1, 2);
        let improves = fuzzer_observe(inout fuzzer, 0, in feature.as_slice());
        let equal = fuzzer_observe(inout fuzzer, 0, in feature.as_slice());
        feature.try_set(1, 1);
        let worse = fuzzer_observe(inout fuzzer, 0, in feature.as_slice());
        feature.try_set(0, 0x8000000000000003);
        let different_site = fuzzer_observe(inout fuzzer, 0, in feature.as_slice());
        let novelty = first
            == 0
            && improves
            == 1
            && equal
            == 0
            && worse
            == 0
            && different_site
            == 1;
        let stats = fuzzer_stats(in fuzzer);
        novelty && stats.features == 2
    }

    // @case middle_is_subset(1, 4, true)
    // @case empty_range(2, 2, true)
    // @case left_item_outside(2, 4, false)
    // @case right_item_outside(1, 3, false)
    // @case right_range_empty(2, 2, false)
    fn test_subset_uses_both_range_bounds(start: u64, end: u64, expected: bool) -> bool {
        let mut a = ChunkSeq::new[u64]();
        a.push(2);
        a.push(4);
        let mut b = ChunkSeq::new[u64]();
        b.push(1);
        b.push(2);
        b.push(3);
        b.push(4);
        let a_end: u64 = if start == 2 && end == 2 && expected {
            0
        } else {
            2
        };
        let subset = range_subset(in a.as_slice(), 0, a_end, in b.as_slice(), start, end)
            == expected;
        subset
            && range_has(in b.as_slice(), 1, 3, 2)
            && !range_has(in b.as_slice(), 1, 3, 4)
            && seq_has(in b.as_slice(), 3)
            && !seq_has(in b.as_slice(), 5)
    }

    // @case exhaustive(false, false, false, false)
    // @case exhaustive_with_bound(false, true, false, false)
    // @case dpor_sleep(true, false, false, true)
    // @case dpor_bound(true, true, true, false)
    fn test_search_modes(dpor: bool, has_bound: bool, bounded: bool, sleeps: bool) -> bool {
        let search = search_new(dpor, has_bound, 1, false);
        search
            .dpor
            == dpor
            && search
            .has_bound
            == has_bound
            && search
            .bounded
            == bounded
            && search
            .sleeping
            == sleeps
    }

    // @case two_timers(9223372041149743104, 9223372045444710400, true)
    // @case task_and_timer(1, 9223372041149743104, true)
    // @case same_io_task(4611687117939015680, 4611687117939015681, true)
    // @case distinct_io_tasks(4611687117939015680, 4611688217450643456, false)
    // @case distinct_task_and_io(2, 4611687117939015680, false)
    // @case same_task_and_io(1, 4611687117939015680, true)
    fn test_process_dependency(a: u64, b: u64, dependent: bool) -> bool {
        let search = search_new(true, false, 0, false);
        search.dep(a, 0, b, 0) == dependent && search.dep(b, 0, a, 0) == dependent
    }

    // @case independent(0, 1)
    // @case competing_writes(2, 2)
    fn test_dpor_skips_only_commuting_schedules(other_writes: u64, expected: u64) -> bool {
        let mut search = search_new(true, false, 0, false);
        let first_fp = footprint_from_masks(inout search, 0, 2, 0, false);
        let second_fp = footprint_from_masks(inout search, 0, other_writes, 0, false);
        let mut enabled = ChunkSeq::new[u64]();
        enabled.push(1);
        enabled.push(2);
        let mut nexts = ChunkSeq::new[u64]();
        nexts.push(1);
        nexts.push(first_fp);
        nexts.push(2);
        nexts.push(second_fp);
        search_root(inout search, in enabled.as_slice(), in nexts.as_slice(), none());
        let empty = ChunkSeq::new[u64]();
        let mut explored: u64 = 0;
        loop {
            let first = search_choose(inout search);
            let expected_first: u64 = if explored == 0 {
                1
            } else {
                2
            };
            if first.code != 0 || first.value != expected_first || explored >= expected {
                return false;
            }
            let other = wrapping_sub(3, first.value);
            let mut remaining = ChunkSeq::new[u64]();
            let mut last_transition = ChunkSeq::new[u64]();
            remaining.push(other);
            last_transition.push(other);
            let footprint = if other == 1 {
                first_fp
            } else {
                second_fp
            };
            last_transition.push(footprint);
            search_child(
                inout search,
                false,
                in remaining.as_slice(),
                in last_transition.as_slice()
            );
            search_key(inout search, none());
            let second = search_choose(inout search);
            if second.code != 0 || second.value != other {
                return false;
            }
            search_child(inout search, false, in empty.as_slice(), in empty.as_slice());
            let prefix = search_prefix(in search);
            if prefix
                .len()
                != 2
                || prefix
                .try_get(0)
                != Option::Some(first.value)
                || prefix
                .try_get(1)
                != Option::Some(second.value) {
                return false;
            }
            explored = inc(explored);
            if !search_backtrack(inout search) {
                break;
            }
            let departed = wrapping_sub(first.value, 1);
            if !atb(in search.en_slept.as_slice(), departed) {
                return false;
            }
        }
        explored == expected
    }

    fn test_io_siblings_are_added_as_alternative_choices() -> bool {
        let mut search = search_new(true, false, 0, false);
        let first: u64 = 4611687117939015680;
        let sibling = inc(first);
        let unrelated: u64 = 4611688217450643456;
        let mut enabled = ChunkSeq::new[u64]();
        enabled.push(first);
        enabled.push(sibling);
        enabled.push(unrelated);
        let mut nexts = ChunkSeq::new[u64]();
        for i in 0..enabled.len() {
            nexts.push(at(in enabled.as_slice(), i));
            nexts.push(0);
        }
        search_root(inout search, in enabled.as_slice(), in nexts.as_slice(), none());
        let initial = search_choose(inout search);
        let empty = ChunkSeq::new[u64]();
        if initial.code != 0 || initial.value != first {
            return false;
        }
        search_child(inout search, false, in empty.as_slice(), in empty.as_slice());
        if !search_backtrack(inout search) {
            return false;
        }
        let next = search_choose(inout search);
        if next.code != 0 || next.value != sibling {
            return false;
        }
        search_child(inout search, false, in empty.as_slice(), in empty.as_slice());
        !search_backtrack(inout search)
    }

    fn test_lookup_does_not_cross_into_following_node() -> bool {
        let mut search = search_new(true, false, 0, false);
        let mut first = ChunkSeq::new[u64]();
        let mut first_next = ChunkSeq::new[u64]();
        first.push(1);
        first_next.push(1);
        first_next.push(4);
        search_root(inout search, in first.as_slice(), in first_next.as_slice(), none());
        let choice = search_choose(inout search);
        if choice.code != 0 || choice.value != 1 {
            return false;
        }
        let mut second = ChunkSeq::new[u64]();
        let mut second_next = ChunkSeq::new[u64]();
        second.push(2);
        second_next.push(2);
        second_next.push(5);
        search_child(inout search, false, in second.as_slice(), in second_next.as_slice());
        let present = search.en_find(0, 1) == 0 && search.nx_find(0, 1) == 0;
        let absent = search.en_find(0, 2) == none() && search.nx_find(0, 2) == none();
        present && absent && search.nx_find(1, 2) == 1 && search.en_find(1, 2) == 1
    }

    fn test_clock_lookups_respect_block_bounds() -> bool {
        let mut search = search_new(true, false, 0, false);
        search.pc_insert(0, 1, 3, 4, false);
        search.pc_insert(0, 1, 9, 9, false);
        search.pc_insert(0, 2, 5, 6, false);
        search.cl_proc.push(1);
        search.cl_proc.push(2);
        search.cl_val.push(3);
        search.cl_val.push(5);
        let process_index = search
            .pc_find_in(0, 1, 1)
            == 0
            && search
            .pc_find_in(0, 1, 2)
            == none()
            && search
            .pc_find_in(0, 1, 0)
            == none();
        let clock = search
            .clock_get(0, 1, 1)
            == 3
            && search
            .clock_get(0, 1, 2)
            == 0
            && search
            .clock_get(0, 1, 0)
            == 0;
        process_index && clock && search.pc_off.try_get(0) == Option::Some(3)
    }

    fn test_node_preserves_sleep_set_and_recorded_siblings() -> bool {
        let mut search = search_new(true, false, 0, false);
        let mut processes = ChunkSeq::new[u64]();
        processes.push(1);
        processes.push(3);
        search.p_sleep.push(5);
        let nexts = ChunkSeq::new[u64]();
        search.push_node(in processes.as_slice(), in nexts.as_slice(), none(), 0, 0);
        search.en_slept.try_set(1, true);
        let from_sleep_set = search.in_sleep(0, 5);
        let from_sibling = search.in_sleep(0, 3);
        let awake = !search.in_sleep(0, 1) && !search.in_sleep(0, 2);
        from_sleep_set && from_sibling && awake && search.p_sleep.len() == 0
    }

    // @case exhaustive_reuses_unconditionally(false, false, 2, true)
    // @case dpor_with_superset(true, false, 1, true)
    // @case dpor_without_cached_sleeper(true, false, 2, false)
    // @case bounded_dpor_bypasses_cache(true, true, 1, false)
    fn test_search_cache_respects_sleep_and_preemption_modes(
        dpor: bool,
        bounded: bool,
        sleep: u64,
        expected_hit: bool
    ) -> bool {
        let mut search = search_new(dpor, bounded, 1, true);
        let empty = ChunkSeq::new[u64]();
        search.p_sleep.push(1);
        search.push_node(in empty.as_slice(), in empty.as_slice(), none(), 0, 0);
        search.n_key.try_set(0, 2);
        search.pop_node();
        search.p_sleep.push(sleep);
        if sleep == 1 {
            search.p_sleep.push(2);
        }
        let mut enabled = ChunkSeq::new[u64]();
        enabled.push(3);
        let mut steps = ChunkSeq::new[u64]();
        steps.push(3);
        steps.push(0);
        search.push_node(in enabled.as_slice(), in steps.as_slice(), none(), 0, 0);
        let hit = search_key(inout search, 2);
        if hit != expected_hit || atb(in search.n_hit.as_slice(), 0) != expected_hit {
            return false;
        }
        if hit {
            !search_backtrack(inout search) && search.sm_proc.len() == 0
        } else {
            search_choose(inout search).value == 3
        }
    }

    fn test_enabled_set_checks_order_and_length() -> bool {
        let mut search = search_new(false, false, 0, false);
        let mut enabled = ChunkSeq::new[u64]();
        enabled.push(1);
        enabled.push(3);
        let nexts = ChunkSeq::new[u64]();
        search_root(inout search, in enabled.as_slice(), in nexts.as_slice(), none());
        let matches = search_same_enabled(in search, in enabled.as_slice());
        enabled.try_set(0, 3);
        enabled.try_set(1, 1);
        let reordered = search_same_enabled(in search, in enabled.as_slice());
        enabled.truncate(1);
        matches && !reordered && !search_same_enabled(in search, in enabled.as_slice())
    }

    // @case independent(0, true)
    // @case conflicting(2, false)
    fn test_sleep_preserves_only_enabled_independent_peers(other_writes: u64, kept: bool) -> bool {
        let mut search = search_new(true, false, 0, false);
        let first_fp = footprint_from_masks(inout search, 0, 2, 0, false);
        let other_fp = footprint_from_masks(inout search, 0, other_writes, 0, false);
        let mut enabled = ChunkSeq::new[u64]();
        enabled.push(1);
        enabled.push(2);
        let mut nexts = ChunkSeq::new[u64]();
        nexts.push(1);
        nexts.push(first_fp);
        nexts.push(2);
        nexts.push(other_fp);
        search_root(inout search, in enabled.as_slice(), in nexts.as_slice(), none());
        search.sleep_keep(0, 1, 1, first_fp);
        search.sleep_keep(0, 3, 1, first_fp);
        if search.p_sleep.len() != 0 {
            return false;
        }
        search.sleep_keep(0, 2, 1, first_fp);
        let expected: Option[u64] = if kept {
            Option::Some(2)
        } else {
            Option::None
        };
        search.p_sleep.try_get(0) == expected
    }

    fn test_child_clocks_inherit_parent_and_replace_running_task_clock() -> bool {
        let mut search = search_new(false, false, 0, false);
        let mut enabled = ChunkSeq::new[u64]();
        enabled.push(1);
        let mut nexts = ChunkSeq::new[u64]();
        nexts.push(1);
        nexts.push(0);
        search_root(inout search, in enabled.as_slice(), in nexts.as_slice(), none());
        let first = search_choose(inout search);
        if first.code != 0 || first.value != 1 {
            return false;
        }
        enabled.push(2);
        nexts.push(2);
        nexts.push(0);
        search_child(inout search, true, in enabled.as_slice(), in nexts.as_slice());
        let child = search.pc_find(1, 2);
        if child == none() || search_running(in search) != 1 {
            return false;
        }
        let child_clock = at(in search.pc_off.as_slice(), child);
        let child_length = at(in search.pc_len.as_slice(), child);
        if search.clock_get(child_clock, child_length, 1) != 1 {
            return false;
        }
        let second = search_choose(inout search);
        if second.code != 0 || second.value != 1 {
            return false;
        }
        search_child(inout search, true, in enabled.as_slice(), in nexts.as_slice());
        let running = search.pc_find(2, 1);
        if running == none() {
            return false;
        }
        let clock = at(in search.pc_off.as_slice(), running);
        let length = at(in search.pc_len.as_slice(), running);
        search.clock_get(clock, length, 1) == 2
    }

    // @case newest_race_only(false, false, 0, true, false, true)
    // @case all_races(false, true, 0, true, true, true)
    // @case bound_backtracks_to_previous_switch(true, false, 0, true, true, true)
    // @case happened_before_all_earlier_events(false, true, 2, true, false, false)
    // @case happened_before_first_event_only(false, true, 1, true, false, true)
    // @case independent_events(false, true, 0, false, false, false)
    fn test_backtracking_uses_races_clocks_and_switches(
        bounded: bool,
        all: bool,
        happens_before: u64,
        conflict: bool,
        first_node: bool,
        second_node: bool
    ) -> bool {
        let mut search = search_new(true, bounded, 2, false);
        let first_fp = footprint_from_masks(inout search, 0, 2, 0, false);
        let writes: u64 = if conflict {
            2
        } else {
            0
        };
        let second_fp = footprint_from_masks(inout search, 0, writes, 0, false);
        let mut enabled = ChunkSeq::new[u64]();
        enabled.push(1);
        enabled.push(2);
        let mut steps = ChunkSeq::new[u64]();
        steps.push(1);
        steps.push(first_fp);
        steps.push(2);
        steps.push(second_fp);
        search_root(inout search, in enabled.as_slice(), in steps.as_slice(), none());
        let first = search_choose(inout search);
        if first.code != 0 || first.value != 1 {
            return false;
        }
        search_child(inout search, true, in enabled.as_slice(), in steps.as_slice());
        let second = search_choose(inout search);
        if second.code != 0 || second.value != 1 {
            return false;
        }
        let mut last_enabled = ChunkSeq::new[u64]();
        last_enabled.push(2);
        let mut last_steps = ChunkSeq::new[u64]();
        last_steps.push(2);
        last_steps.push(second_fp);
        search_child(inout search, false, in last_enabled.as_slice(), in last_steps.as_slice());
        let clock = search.cl_proc.len();
        search.cl_proc.push(1);
        search.cl_val.push(happens_before);
        let process_start = at(in search.n_pc.as_slice(), 2);
        search.pc_insert(process_start, 2, clock, 1, true);
        let process_count = wrapping_sub(search.pc_proc.len(), process_start);
        search.n_pc_len.try_set(2, process_count);
        if all {
            let summary = at(in search.n_sm.as_slice(), 2);
            search.sm_insert(summary, 2, second_fp);
            search.add_summary_points();
        } else {
            search.add_backtrack_points();
        }
        atb(in search.en_bt.as_slice(), 1)
            == first_node
            && atb(in search.en_bt.as_slice(), 3)
            == second_node
    }

    // @case eight(0, 8, 6)
    // @case four(1, 4, 6)
    // @case two(2, 2, 6)
    // @case exhausted_widths(3, 0, 8)
    fn test_shrinker_zero_width_order(index: u64, width: u64, phase: u64) -> bool {
        let initial = ChunkSeq::new[u64]();
        let mut shrinker = shrinker_new(initial, 8);
        shrinker.wi = index;
        shrinker.pc = 5;
        let started = shrinker.step_zero(5);
        !started && shrinker.width == width && shrinker.pc == phase
    }

    fn test_shrinker_skips_a_span_that_is_already_zero() -> bool {
        let mut initial = ChunkSeq::new[u64]();
        initial.resize(4, 0);
        let mut shrinker = shrinker_new(initial, 8);
        shrinker.pc = 6;
        shrinker.width = 2;
        let started = shrinker.step_zero(6);
        !started && shrinker.idx == 1 && shrinker.pc == 6 && shrinker.cand.len() == 0
    }

    fn test_shrinker_tries_next_zero_span_after_rejection() -> bool {
        let mut initial = ChunkSeq::new[u64]();
        initial.resize(9, 5);
        let mut shrinker = shrinker_new(initial, 80);
        let first = loop {
            if !shrinker_next(inout shrinker) {
                return false;
            }
            let candidate = shrinker_candidate(in shrinker);
            if candidate.len() == 9 {
                break candidate;
            }
            shrinker_record(inout shrinker, 1, in candidate.as_slice());
        };
        if first.try_get(0) != Option::Some(0) || first.try_get(8) != Option::Some(5) {
            return false;
        }
        shrinker_record(inout shrinker, 2, in first.as_slice());
        if !shrinker_next(inout shrinker) {
            return false;
        }
        let second = shrinker_candidate(in shrinker);
        let key = tape_key(in second.as_slice());
        key.len == 9 && key.lo == 5 && second.try_get(0) == Option::Some(5)
    }

    // @case deletion(4, 3)
    // @case small_value(10, 11)
    // @case binary_value(13, 12)
    fn test_shrinker_marks_accepted_step_as_progress(phase: u64, next: u64) -> bool {
        let mut initial = ChunkSeq::new[u64]();
        initial.push(9);
        let mut shrinker = shrinker_new(initial, 8);
        shrinker.res = true;
        shrinker.pc = phase;
        let started = if phase == 4 {
            shrinker.step_delete(phase)
        } else if phase == 10 {
            shrinker.step_small(phase)
        } else {
            shrinker.step_binary(phase)
        };
        !started && shrinker.improved && shrinker.pc == next
    }

    // @case at_end(1, 8, 14)
    // @case budget_exhausted(0, 1, 14)
    // @case can_lower(0, 8, 9)
    fn test_shrinker_small_phase_requires_index_and_budget(index: u64, budget: u64, next: u64)
        -> bool {
        let mut initial = ChunkSeq::new[u64]();
        initial.push(4);
        let mut shrinker = shrinker_new(initial, budget);
        shrinker.i = index;
        shrinker.pc = 8;
        !shrinker.step_small(8) && shrinker.pc == next
    }

    // @case at_small_limit(0, 3, 3, 9)
    // @case at_current_value(0, 3, 8, 3)
    // @case value_removed_after_realization(1, 0, 8, 3)
    fn test_shrinker_small_candidates_must_strictly_lower_value(
        index: u64,
        small: u64,
        limit: u64,
        value: u64
    ) -> bool {
        let mut initial = ChunkSeq::new[u64]();
        initial.push(value);
        let mut shrinker = shrinker_new(initial, 8);
        shrinker.i = index;
        shrinker.small = small;
        shrinker.small_end = limit;
        shrinker.pc = 9;
        !shrinker.step_small(9) && shrinker.pc == 11 && shrinker.cand.len() == 0
    }

    // @case binary_setup_at_end(11, 1, 1, 3, 14)
    // @case binary_window_empty(12, 0, 3, 3, 8)
    // @case binary_value_removed(12, 1, 1, 3, 8)
    // @case last_lower_delete_value(14, 1, 0, 0, 17)
    fn test_shrinker_pass_stops_at_end(phase: u64, index: u64, lo: u64, hi: u64, next: u64)
        -> bool {
        let mut initial = ChunkSeq::new[u64]();
        initial.push(9);
        let mut shrinker = shrinker_new(initial, 8);
        shrinker.i = index;
        shrinker.lo = lo;
        shrinker.hi = hi;
        shrinker.pc = phase;
        let started = if phase == 14 {
            shrinker.step_lower_delete(phase)
        } else {
            shrinker.step_binary(phase)
        };
        !started && shrinker.pc == next && shrinker.cand.len() == 0
    }

    // @case reaches_end(3, 2, 8, 19, 1)
    // @case maximum_width(10, 8, 8, 19, 2)
    // @case above_maximum_width(12, 9, 8, 14, 0)
    // @case past_end(3, 3, 8, 14, 0)
    // @case budget_exhausted(3, 2, 1, 14, 0)
    fn test_shrinker_lower_and_delete_bounds(
        size: u64,
        width: u64,
        budget: u64,
        next: u64,
        remaining: u64
    ) -> bool {
        let mut initial = ChunkSeq::new[u64]();
        initial.resize(size, 9);
        let mut shrinker = shrinker_new(initial, budget);
        shrinker.k = width;
        shrinker.pc = 15;
        let started = shrinker.step_lower_delete(15);
        let candidate = shrinker_candidate(in shrinker);
        started == (next == 19) && shrinker.pc == next && candidate.len() == remaining
    }

    fn test_backtrack_falls_back_to_all_enabled_processes() -> bool {
        let mut search = search_new(true, false, 0, false);
        let mut enabled = ChunkSeq::new[u64]();
        enabled.push(1);
        enabled.push(2);
        let nexts = ChunkSeq::new[u64]();
        search_root(inout search, in enabled.as_slice(), in nexts.as_slice(), none());
        search.add_at(0, 3, 0, 0);
        atb(in search.en_bt.as_slice(), 0) && atb(in search.en_bt.as_slice(), 1)
    }

    // @case first_awake_candidate(false, false, true, false)
    // @case skips_sleeping_candidate(false, true, false, true)
    // @case bounded_adds_all_awake_candidates(true, false, true, true)
    fn test_backtrack_adds_only_eligible_causal_processes(
        bounded: bool,
        asleep: bool,
        second: bool,
        third: bool
    ) -> bool {
        let mut search = search_new(true, bounded, 1, false);
        let mut enabled = ChunkSeq::new[u64]();
        enabled.push(1);
        enabled.push(2);
        enabled.push(3);
        enabled.push(4);
        let nexts = ChunkSeq::new[u64]();
        search_root(inout search, in enabled.as_slice(), in nexts.as_slice(), none());
        search.en_slept.try_set(1, asleep);
        search.ev_proc.push(1);
        search.ev_proc.push(3);
        search.ev_proc.push(3);
        search.ev_proc.push(4);
        search.ev_proc.push(9);
        search.cl_proc.push(3);
        search.cl_proc.push(4);
        search.cl_proc.push(9);
        search.cl_val.push(3);
        search.cl_val.push(3);
        search.cl_val.push(5);
        search.add_at(0, 2, 0, 3);
        let unique = search
            .t3
            .len()
            == 2
            && search
            .t3
            .try_get(0)
            == Option::Some(2)
            && search
            .t3
            .try_get(1)
            == Option::Some(3);
        unique
            && !atb(in search.en_bt.as_slice(), 0)
            && !atb(in search.en_bt.as_slice(), 3)
            && atb(in search.en_bt.as_slice(), 1)
            == second
            && atb(in search.en_bt.as_slice(), 2)
            == third
    }

    // @case prunes_preempting_choice(true, 0, 1, 1, true)
    // @case adds_current_task_when_preempting(true, 1, 2, 0, true)
    // @case unbounded_selects_first(false, 0, 2, 0, false)
    fn test_picker_respects_preemption_budget(
        bounded: bool,
        bound: u64,
        choice: u64,
        pruned: u64,
        adds_running: bool
    ) -> bool {
        let mut search = search_new(true, bounded, bound, false);
        let mut enabled = ChunkSeq::new[u64]();
        enabled.push(2);
        enabled.push(1);
        let nexts = ChunkSeq::new[u64]();
        search_root(inout search, in enabled.as_slice(), in nexts.as_slice(), none());
        search.n_running.try_set(0, 1);
        let picked = search.pick(0, false);
        let stats = search_stats(in search);
        let ready = atb(in search.en_done.as_slice(), 0) && stats.bound_pruned == pruned;
        let chosen = search.n_chosen.try_get(0) == Option::Some(choice);
        picked == choice && chosen && ready && atb(in search.en_bt.as_slice(), 1) == adds_running
    }

    fn test_switch_marks_only_newly_running_tasks() -> bool {
        let mut search = search_new(true, true, 1, false);
        search.ev_proc.push(1);
        search.ev_proc.push(1);
        search.ev_proc.push(4611687117939015680);
        search.n_running.push(none());
        search.n_running.push(1);
        search.n_running.push(1);
        search.switches(0) && !search.switches(1) && !search.switches(2)
    }

    fn test_popping_cached_nodes_merges_child_and_clears_root_summary() -> bool {
        let mut search = search_new(true, false, 0, true);
        let mut root = ChunkSeq::new[u64]();
        let mut root_steps = ChunkSeq::new[u64]();
        root.push(2);
        root_steps.push(2);
        root_steps.push(0);
        search_root(inout search, in root.as_slice(), in root_steps.as_slice(), none());
        let first = search_choose(inout search);
        if first.code != 0 || first.value != 2 {
            return false;
        }
        let mut child = ChunkSeq::new[u64]();
        let mut child_steps = ChunkSeq::new[u64]();
        child.push(1);
        child_steps.push(1);
        child_steps.push(0);
        search_child(inout search, false, in child.as_slice(), in child_steps.as_slice());
        search.pop_node();
        let merged = search
            .sm_proc
            .len()
            == 2
            && search
            .sm_proc
            .try_get(0)
            == Option::Some(1)
            && search
            .sm_proc
            .try_get(1)
            == Option::Some(2);
        search.pop_node();
        merged && search.sm_proc.len() == 0 && search.sm_next.len() == 0
    }

    fn test_new_task_uses_inherited_clock_when_steps_are_independent() -> bool {
        let mut search = search_new(false, false, 0, false);
        let footprint = footprint_from_masks(inout search, 0, 0, 0, false);
        let mut enabled = ChunkSeq::new[u64]();
        let mut steps = ChunkSeq::new[u64]();
        enabled.push(1);
        steps.push(1);
        steps.push(footprint);
        search_root(inout search, in enabled.as_slice(), in steps.as_slice(), none());
        let first = search_choose(inout search);
        if first.code != 0 || first.value != 1 {
            return false;
        }
        enabled.try_set(0, 2);
        steps.try_set(0, 2);
        search_child(inout search, false, in enabled.as_slice(), in steps.as_slice());
        let second = search_choose(inout search);
        let off = at(in search.ev_cl.as_slice(), 1);
        let len = at(in search.ev_cl_len.as_slice(), 1);
        second
            .code
            == 0
            && second
            .value
            == 2
            && search
            .clock_get(off, len, 1)
            == 1
            && search
            .clock_get(off, len, 2)
            == 2
    }

    fn test_reenabled_task_keeps_earlier_clock() -> bool {
        let mut search = search_new(false, false, 0, false);
        let footprint = footprint_from_masks(inout search, 0, 0, 0, false);
        let mut enabled = ChunkSeq::new[u64]();
        let mut steps = ChunkSeq::new[u64]();
        enabled.push(1);
        steps.push(1);
        steps.push(footprint);
        search_root(inout search, in enabled.as_slice(), in steps.as_slice(), none());
        let mut both = ChunkSeq::new[u64]();
        both.extend(in enabled.as_slice());
        both.push(2);
        let mut both_steps = ChunkSeq::new[u64]();
        both_steps.extend(in steps.as_slice());
        both_steps.push(2);
        both_steps.push(footprint);
        let first = search_choose(inout search);
        search_child(inout search, true, in both.as_slice(), in both_steps.as_slice());
        let second = search_choose(inout search);
        search_child(inout search, true, in enabled.as_slice(), in steps.as_slice());
        let third = search_choose(inout search);
        search_child(inout search, true, in both.as_slice(), in both_steps.as_slice());
        let index = search.pc_find(3, 2);
        if index == none() || first.value != 1 || second.value != 1 || third.value != 1 {
            return false;
        }
        let off = at(in search.pc_off.as_slice(), index);
        let len = at(in search.pc_len.as_slice(), index);
        search.clock_get(off, len, 1) == 1
    }

    fn test_clock_insertion_keeps_zero_and_interior_keys() -> bool {
        let mut search = search_new(true, false, 0, false);
        search.t1_set(0, 7);
        search.t1_set(3, 9);
        search.t1_set(2, 8);
        search.pc_insert(0, 0, 4, 1, false);
        search.pc_insert(0, 3, 6, 1, false);
        search.pc_insert(0, 2, 5, 1, false);
        let clock = search
            .t1
            .len()
            == 6
            && search
            .t1
            .try_get(0)
            == Option::Some(0)
            && search
            .t1
            .try_get(2)
            == Option::Some(2)
            && search
            .t1
            .try_get(4)
            == Option::Some(3);
        let indices = search
            .pc_find_in(0, 3, 0)
            == 0
            && search
            .pc_find_in(0, 3, 2)
            == 1
            && search
            .pc_find_in(0, 3, 3)
            == 2;
        clock && indices && search.pc_off.try_get(1) == Option::Some(5)
    }

    fn test_summary_starts_at_zero_and_orders_transitions_of_same_process() -> bool {
        let mut search = search_new(true, false, 0, true);
        search.sm_insert(0, 0, 0);
        search.sm_insert(0, 4, 2);
        search.sm_insert(0, 4, 5);
        search.sm_insert(0, 4, 5);
        let processes = search
            .sm_proc
            .len()
            == 3
            && search
            .sm_proc
            .try_get(0)
            == Option::Some(0)
            && search
            .sm_proc
            .try_get(1)
            == Option::Some(4)
            && search
            .sm_proc
            .try_get(2)
            == Option::Some(4);
        processes
            && search
            .sm_next
            .try_get(0)
            == Option::Some(0)
            && search
            .sm_next
            .try_get(1)
            == Option::Some(2)
            && search
            .sm_next
            .try_get(2)
            == Option::Some(5)
    }

    fn test_backtrack_order_sorts_enabled_positions() -> bool {
        let mut search = search_new(true, false, 0, false);
        let mut enabled = ChunkSeq::new[u64]();
        enabled.push(3);
        enabled.push(1);
        enabled.push(4);
        enabled.push(2);
        let nexts = ChunkSeq::new[u64]();
        search_root(inout search, in enabled.as_slice(), in nexts.as_slice(), none());
        search
            .en_ord
            .len()
            == 4
            && search
            .en_ord
            .try_get(0)
            == Option::Some(1)
            && search
            .en_ord
            .try_get(1)
            == Option::Some(3)
            && search
            .en_ord
            .try_get(2)
            == Option::Some(0)
            && search
            .en_ord
            .try_get(3)
            == Option::Some(2)
    }

    fn test_solver_limits_match_starts_to_eight() -> bool {
        let mut fuzzer = fuzzer_new(0, 8, false, 0, 16);
        let count: u64 = 10;
        fuzzer.c_vals.resize(count, 97);
        for i in 0..count {
            fuzzer.lane.push(i);
        }
        let mut needle = ChunkSeq::new[u64]();
        needle.push(97);
        let starts = fuzzer.find_in_lane(0, in needle.as_slice());
        starts
            .len()
            == 8
            && starts
            .try_get(0)
            == Option::Some(0)
            && starts
            .try_get(7)
            == Option::Some(7)
    }

    fn test_solver_clips_replacement_at_end_of_lane() -> bool {
        let mut fuzzer = fuzzer_new(0, 8, false, 0, 16);
        fuzzer.c_vals.push(97);
        fuzzer.c_vals.push(98);
        fuzzer.width = 2;
        fuzzer.lane.push(0);
        fuzzer.lane.push(1);
        let mut bytes = ChunkSeq::new[u64]();
        bytes.push(88);
        bytes.push(89);
        let pushed = fuzzer.push_lane(0, 1, in bytes.as_slice());
        pushed && fuzzer.order.len() == 1 && fuzzer.row_at(0, 0) == 97 && fuzzer.row_at(0, 1) == 88
    }

    // @case edge(0, 0)
    // @case comparison_outcome(4611686018427387904, 0)
    // @case closeness_at_site_zero(9223372036854775808, 1)
    fn test_one_feature_is_novel_only_once(key: u64, value: u64) -> bool {
        let mut fuzzer = fuzzer_new(0, 4, false, 0, 0);
        let mut feature = ChunkSeq::new[u64]();
        feature.push(key);
        feature.push(value);
        let first = fuzzer_observe(inout fuzzer, 0, in feature.as_slice());
        let repeated = fuzzer_observe(inout fuzzer, 0, in feature.as_slice());
        let stats = fuzzer_stats(in fuzzer);
        first == 1 && repeated == 0 && stats.features == 1
    }

    fn test_bounded_search_backtracks_to_nearest_switch() -> bool {
        let mut search = search_new(true, true, 3, false);
        let independent = footprint_from_masks(inout search, 0, 0, 0, false);
        let writes = footprint_from_masks(inout search, 0, 2, 0, false);
        let mut enabled = ChunkSeq::new[u64]();
        enabled.push(1);
        enabled.push(2);
        enabled.push(3);
        let mut steps = ChunkSeq::new[u64]();
        steps.push(1);
        steps.push(independent);
        steps.push(2);
        steps.push(writes);
        steps.push(3);
        steps.push(writes);
        search_root(inout search, in enabled.as_slice(), in steps.as_slice(), none());
        let first = search_choose(inout search);
        if first.code != 0 || first.value != 1 {
            return false;
        }
        enabled.try_set(0, 2);
        enabled.try_set(1, 1);
        search_child(inout search, true, in enabled.as_slice(), in steps.as_slice());
        let second = search_choose(inout search);
        if second.code != 0 || second.value != 2 {
            return false;
        }
        search_child(inout search, true, in enabled.as_slice(), in steps.as_slice());
        let third = search_choose(inout search);
        if third.code != 0 || third.value != 2 {
            return false;
        }
        search_child(inout search, true, in enabled.as_slice(), in steps.as_slice());
        search.backtrack_for(3, writes, 0, 0, false);
        !atb(in search.en_bt.as_slice(), 2)
            && atb(in search.en_bt.as_slice(), 5)
            && atb(in search.en_bt.as_slice(), 8)
    }

    fn test_solver_prioritizes_wide_match_before_single_byte_budget() -> bool {
        let mut fuzzer = fuzzer_new(0, 8, false, 0, 9);
        // The first a is a one-byte match. Eight intervening a values fill the
        // shorter search limits, so the last a is admitted by the eight-byte pass.
        fuzzer.c_vals.push(120);
        fuzzer.c_vals.push(97);
        fuzzer.c_vals.push(120);
        let narrow_matches: u64 = 8;
        for i in 0..narrow_matches {
            fuzzer.c_vals.push(97);
            fuzzer.c_vals.push(0);
            fuzzer.c_vals.push(0);
            fuzzer.c_vals.push(0);
            fuzzer.c_vals.push(120);
        }
        let wide_offset = fuzzer.c_vals.len();
        fuzzer.c_vals.push(97);
        fuzzer.c_vals.resize(wrapping_add(wide_offset, 8), 0);
        fuzzer.width = fuzzer.c_vals.len();
        let width = fuzzer.width;
        for i in 0..width {
            fuzzer.lane.push(i);
            fuzzer.c_tag.push(1);
            fuzzer.c_max.push(255);
        }
        fuzzer.solve_repl(0, 97, 98);
        let mut wide_match = false;
        for i in 0..fuzzer.order.len() {
            let row = at(in fuzzer.order.as_slice(), i);
            if fuzzer.row_at(row, 1) != 97 {
                return false;
            }
            if fuzzer.row_at(row, wide_offset) == 98 {
                wide_match = true;
            }
        }
        fuzzer.order.len() == 9 && wide_match
    }

    // @case empty(0, 0, 0, 0)
    // @case one_maximum(1, 18446744073709551615, 0, 18446744073709551615)
    // @case one_carry(2, 18446744073709551615, 1, 18446744073709551614)
    // @case repeated_carry(3, 18446744073709551615, 2, 18446744073709551613)
    // @case small_values(3, 16, 0, 48)
    // @case zero_values(3, 0, 0, 0)
    fn test_tape_key(count: u64, value: u64, high: u64, low: u64) -> bool {
        let mut values = ChunkSeq::new[u64]();
        values.resize(count, value);
        let key = tape_key(in values.as_slice());
        key.len == count && key.hi == high && key.lo == low
    }

    // @case empty_input(in "", 2, 1, 0, 0, 0, 0, Option::None)
    // @case header_only(in "vesper-crucible-tape/1", 0, 0, 0, 0, 0, 0, Option::None)
    // @case wrong_version(in "  vesper-crucible-tape/2  ", 1, 2, 0, 2, 24, 0, Option::None)
    // @case canonical(in "vesper-crucible-tape/1\n0\nffffffffffffffff\n", 2, 0, 0, 0, 0, 2, Option::Some(18446744073709551615))
    // @case trims_lines(in " \nvesper-crucible-tape/1 \r\n\t00a \n\n", 1, 0, 0, 0, 0, 1, Option::Some(10))
    // @case refuses_uppercase(in "vesper-crucible-tape/1\n1\nFF", 2, 3, 1, 0, 0, 1, Option::Some(1))
    // @case refuses_prefix(in "vesper-crucible-tape/1\n0x1", 1, 3, 0, 0, 0, 0, Option::None)
    // @case refuses_wide_word(in "vesper-crucible-tape/1\n10000000000000000", 1, 3, 0, 0, 0, 0, Option::None)
    // @case limit_exceeded(in "vesper-crucible-tape/1\n1\n2", 1, 4, 0, 0, 0, 1, Option::Some(1))
    // @case last_decimal_hex_digit(in "vesper-crucible-tape/1\n9", 1, 0, 0, 0, 0, 1, Option::Some(9))
    fn test_parse_tape(
        in text: Str,
        limit: u64,
        code: u64,
        index: u64,
        start: u64,
        end: u64,
        count: u64,
        last: Option[u64]
    ) -> bool {
        let parsed = tape_parse(in text, limit);
        parsed
            .code
            == code
            && parsed
            .index
            == index
            && parsed
            .start
            == start
            && parsed
            .end
            == end
            && parsed
            .values
            .len()
            == count
            && parsed
            .values
            .try_get(wrapping_sub(count, 1))
            == last
    }

    // @case empty(0, 0, in "vesper-crucible-tape/1\n")
    // @case zero(1, 0, in "vesper-crucible-tape/1\n0\n")
    // @case repeated_hex(2, 175, in "vesper-crucible-tape/1\naf\naf\n")
    // @case maximum(1, 18446744073709551615, in "vesper-crucible-tape/1\nffffffffffffffff\n")
    fn test_write_tape(count: u64, word: u64, in expected: Str) -> bool {
        let mut values = ChunkSeq::new[u64]();
        values.resize(count, word);
        let actual = tape_to_text(in values.as_slice());
        let bytes = expected.as_bytes();
        if actual.len() != bytes.len() {
            return false;
        }
        for i in 0..actual.len() {
            if actual.try_get(i) != bytes.try_get(i) {
                return false;
            }
        }
        true
    }

    // @case exact_replay(3, 0, 1, 5, false, false, 0, 0, 3)
    // @case clamps_replay(8, 0, 1, 5, false, false, 0, 0, 5)
    // @case overrun_strict(3, 1, 2, 5, false, false, 0, 1, 0)
    // @case overrun_budget(3, 0, 0, 5, true, false, 0, 1, 0)
    // @case random_zero_max(3, 1, 2, 0, true, false, 0, 0, 0)
    // @case never_bernoulli(3, 1, 2, 5, true, true, 0, 0, 0)
    // @case always_bernoulli(3, 1, 2, 5, true, true, 1024, 0, 1)
    // @case clamped_bernoulli(3, 1, 2, 0, true, true, 1024, 0, 0)
    fn test_source_draw(
        prefix_value: u64,
        position: u64,
        budget: u64,
        max: u64,
        random: bool,
        bernoulli: bool,
        numerator: u64,
        code: u64,
        value: u64
    ) -> bool {
        let mut rng = Rng {
            word: 0
        };
        let mut prefix = ChunkSeq::new[u64]();
        prefix.push(prefix_value);
        let draw = source_draw(
            inout rng,
            in prefix.as_slice(),
            position,
            budget,
            max,
            random,
            bernoulli,
            numerator
        );
        draw.code == code && draw.value == value
    }
}
