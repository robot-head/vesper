load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/bazel:defs.bzl", "vesper_crate")
load("//tools/bazel:vesper_port.bzl", "VESPER_TARGET", "vesper_port_object")

# The Rust build (default features), with its tests.
vesper_crate()

# The Vesper build: the same API forwarding to vesper/pilot.ves through the
# committed binding, and tests/api.rs run unchanged against it. The
# vesper-port-harness tests check that the committed binding is current.
vesper_port_object(
    name = "pilot_vesper",
    src = "vesper/pilot.ves",
    library = "pilot",
    target = VESPER_TARGET,
)

# The divergence check: the same edit build.rs applies under the
# `vesper-port-divergent` feature. :port_divergence_detected expects the
# test binary linked against it to fail.
vesper_port_object(
    name = "pilot_vesper_divergent",
    src = "vesper/pilot.ves",
    edits = {"c >= 48 && c <= 57": "c >= 48 && c <= 58"},
    library = "pilot",
    target = VESPER_TARGET,
)

# The export ABI v2 library (#898), and its divergent build: the edits of
# KIT_EDITS in build.rs, one per exported form plus one omitted free.
vesper_port_object(
    name = "kit_vesper",
    src = "vesper/kit.ves",
    library = "kit",
    target = VESPER_TARGET,
)

vesper_port_object(
    name = "kit_vesper_divergent",
    src = "vesper/kit.ves",
    edits = {
        "        s.push(wrapping_mul(i, i));": "        s.push(wrapping_mul(i, wrapping_add(i, 1)));",
        "if c >= 48 && c <= 57 {": "if c >= 48 && c <= 58 {",
        "    s.push_char(33);": "    s.push_char(63);",
        "c.total = wrapping_add(c.total, v);": "c.total = wrapping_add(c.total, wrapping_add(v, 1));",
        "    id\n}": "    wrapping_add(id, 1)\n}",
        "Tree::Leaf(v) => v,": "Tree::Leaf(v) => wrapping_add(v, 1),",
        "Greater => {": "Less => {",
        "wrapping_add(base, Clock::pilot_clock_ticks())": "wrapping_sub(base, Clock::pilot_clock_ticks())",
        "c.hits.clear();": "let parked = Box::new(ChunkSeq::with_capacity[u64](4));\n    c.hits.clear();",
    },
    library = "kit",
    target = VESPER_TARGET,
)

# The export ABI v3 library (#934): copy structs lent in place.
vesper_port_object(
    name = "gauge_vesper",
    src = "vesper/gauge.ves",
    library = "gauge",
    target = VESPER_TARGET,
)

# The export ABI widening library (#1087): f32, lent handles, handles
# that own sequences of handles and boxed trait objects.
vesper_port_object(
    name = "widen_vesper",
    src = "vesper/widen.ves",
    library = "widen",
    target = VESPER_TARGET,
)

rust_library(
    name = "port",
    srcs = glob(["src/**/*.rs"]) + [
        "port/binding.rs",
        "port/gauge.rs",
        "port/kit.rs",
        "port/widen.rs",
    ],
    crate_features = ["vesper-port"],
    crate_name = "vesper_port_pilot",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = ["//crates/vesper-port-abi"],
)

rust_test(
    name = "port_api_test",
    srcs = ["tests/api.rs"],
    compile_data = [
        ":gauge_vesper",
        ":kit_vesper",
        ":pilot_vesper",
        ":widen_vesper",
    ],
    crate_features = ["vesper-port"],
    edition = "2024",
    rustc_flags = [
        "-Clink-arg=$(location :pilot_vesper)",
        "-Clink-arg=$(location :kit_vesper)",
        "-Clink-arg=$(location :gauge_vesper)",
        "-Clink-arg=$(location :widen_vesper)",
    ],
    deps = [":port"],
)

rust_test(
    name = "_port_api_divergent.bin",
    srcs = ["tests/api.rs"],
    crate_name = "api_divergent",
    compile_data = [
        ":gauge_vesper",
        ":kit_vesper",
        ":pilot_vesper_divergent",
        ":widen_vesper",
    ],
    crate_features = ["vesper-port"],
    edition = "2024",
    rustc_flags = [
        "-Clink-arg=$(location :pilot_vesper_divergent)",
        "-Clink-arg=$(location :kit_vesper)",
        "-Clink-arg=$(location :gauge_vesper)",
        "-Clink-arg=$(location :widen_vesper)",
    ],
    tags = ["manual"],
    deps = [":port"],
)

[
    rust_test(
        name = name,
        srcs = [src],
        compile_data = [
            ":gauge_vesper",
            ":pilot_vesper",
            kit,
            ":widen_vesper",
        ],
        crate_features = ["vesper-port"],
        crate_name = crate,
        edition = "2024",
        rustc_flags = [
            "-Clink-arg=$(location :pilot_vesper)",
            "-Clink-arg=$(location %s)" % kit,
            "-Clink-arg=$(location :gauge_vesper)",
            "-Clink-arg=$(location :widen_vesper)",
        ],
        tags = tags,
        deps = [
            ":port",
            "//crates/vesper-port-abi",
        ],
    )
    for name, src, crate, kit, tags in [
        ("port_kit_test", "tests/kit.rs", "kit", ":kit_vesper", []),
        ("port_kit_memory_test", "tests/kit_memory.rs", "kit_memory", ":kit_vesper", []),
        ("port_gauge_test", "tests/gauge.rs", "gauge", ":kit_vesper", []),
        ("port_widen_test", "tests/widen.rs", "widen", ":kit_vesper", []),
        ("_port_kit_divergent.bin", "tests/kit.rs", "kit_divergent", ":kit_vesper_divergent", ["manual"]),
        ("_port_kit_memory_divergent.bin", "tests/kit_memory.rs", "kit_memory_divergent", ":kit_vesper_divergent", ["manual"]),
    ]
]

rust_test(
    name = "port_divergence_detected",
    srcs = ["tests/divergence.rs"],
    data = [
        ":_port_api_divergent.bin",
        ":_port_kit_divergent.bin",
        ":_port_kit_memory_divergent.bin",
    ],
    edition = "2024",
    env = {
        "VESPER_PORT_DIVERGENT_TEST": "$(rootpath :_port_api_divergent.bin)",
        "VESPER_PORT_KIT_DIVERGENT_TEST": "$(rootpath :_port_kit_divergent.bin)",
        "VESPER_PORT_KIT_MEMORY_DIVERGENT_TEST": "$(rootpath :_port_kit_memory_divergent.bin)",
    },
)
