// AArch64 control-flow reconstruction from ETE / ETMv4 atoms over a code image.

use self::ete::{EteElement, EteElementAt, InstructionSet};

pub struct CodeSegment {
    pub base: u64,
    pub bytes: ChunkSeq[u8],
}

pub struct CodeImage {
    pub segments: ChunkSeq[CodeSegment],
}

pub fn new_code_image() -> CodeImage {
    CodeImage {
        segments: ChunkSeq::new(),
    }
}

pub fn single_code_image(base: u64, inout bytes: ChunkSeq[u8]) -> CodeImage {
    let mut segs: ChunkSeq[CodeSegment] = ChunkSeq::new();
    segs.push(CodeSegment { base: base, bytes: replace(inout bytes, ChunkSeq::new()) });
    CodeImage { segments: segs }
}

pub enum BranchKind {
    Conditional {
        taken: bool,
    },
    DirectJump,
    DirectCall,
    IndirectJump,
    IndirectCall,
    Return {
        compressed: bool,
    },
    Far,
    Async,
    Enable,
    Disable,
}

pub struct Branch {
    pub from: u64,
    pub to: Option[u64],
    pub kind: BranchKind,
    pub tsc_lo: Option[u64],
    pub tsc_hi: Option[u64],
    pub packet_index: u64,
}

pub struct FlowLimits {
    pub max_instructions: u64,
    pub max_call_depth: u64,
}

pub fn default_flow_limits() -> FlowLimits {
    FlowLimits {
        max_instructions: 10_000_000,
        max_call_depth: 64,
    }
}

pub struct FlowTrace {
    pub branches: ChunkSeq[Branch],
    pub instructions: u64,
    pub overflows: u64,
    pub stopped_at: Option[u64],
}

pub enum A64Flow {
    Sequential,
    Direct {
        target: u64,
        call: bool,
    },
    Conditional {
        target: u64,
    },
    Indirect {
        call: bool,
    },
    A64Return,
    A64ExceptionReturn,
}

pub enum EteFlowError {
    BadSegment {
        base: u64,
    },
    NoAddress {
        element_index: u64,
    },
    IpOutsideImage {
        ip: u64,
        element_index: u64,
    },
    UnexpectedNotTaken {
        ip: u64,
        element_index: u64,
    },
    UnsupportedInsn {
        ip: u64,
        insn: u32,
    },
    ExceptionPastBranch {
        ip: u64,
        preferred_return: u64,
        element_index: u64,
    },
    NotA64 {
        element_index: u64,
    },
    InstructionBudget {
        limit: u64,
    },
}

fn bit_not_u64(x: u64) -> u64 {
    x ^ 0xffff_ffff_ffff_ffff
}

fn shl(x: u64, s: u64) -> u64 {
    wrapping_shl_u64(x, wrapping_u32(s))
}

fn sext_u64(value: u64, bits: u64) -> u64 {
    let mask = wrapping_sub(shl(1, bits), 1);
    let v = value & mask;
    let sign_bit = shl(1, wrapping_sub(bits, 1));
    if (v & sign_bit) != 0 {
        v | bit_not_u64(mask)
    } else {
        v
    }
}

fn rel_target(pc: u64, imm: u64, bits: u64) -> u64 {
    wrapping_add(pc, wrapping_mul(sext_u64(imm, bits), 4))
}

pub fn classify(pc: u64, insn: u32) -> Option[A64Flow] {
    let i = widen_u64(insn);
    if (i & 0x7c00_0000) == 0x1400_0000 {
        return Option::Some(A64Flow::Direct {
            target: rel_target(pc, i & 0x03ff_ffff, 26),
            call: (i >> 31) == 1,
        });
    }
    if (i & 0xff00_0000) == 0x5400_0000 {
        return Option::Some(A64Flow::Conditional {
            target: rel_target(pc, (i >> 5) & 0x7ffff, 19),
        });
    }
    if (i & 0x7e00_0000) == 0x3400_0000 {
        return Option::Some(A64Flow::Conditional {
            target: rel_target(pc, (i >> 5) & 0x7ffff, 19),
        });
    }
    if (i & 0x7e00_0000) == 0x3600_0000 {
        return Option::Some(A64Flow::Conditional {
            target: rel_target(pc, (i >> 5) & 0x3fff, 14),
        });
    }
    if (i & 0xfe1f_0000) == 0xd61f_0000 {
        let opc = (i >> 21) & 0x0f;
        if opc == 0 || opc == 8 {
            return Option::Some(A64Flow::Indirect { call: false });
        }
        if opc == 1 || opc == 9 {
            return Option::Some(A64Flow::Indirect { call: true });
        }
        if opc == 2 {
            return Option::Some(A64Flow::A64Return);
        }
        if opc == 4 {
            return Option::Some(A64Flow::A64ExceptionReturn);
        }
        return Option::None;
    }
    Option::Some(A64Flow::Sequential)
}

fn byte_at(in b: Slice[u8], idx: u64) -> u8 {
    match b.try_get(idx) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

fn seg_overlaps(in s: CodeSegment, base: u64, end: u64) -> bool {
    let s_end = wrapping_add(s.base, s.bytes.len());
    base < s_end && s.base < end
}

pub fn add_segment(
    inout img: CodeImage,
    base: u64,
    inout bytes: ChunkSeq[u8]
) -> Result[u64, EteFlowError] {
    let len = bytes.len();
    if wrapping_sub(0xffff_ffff_ffff_ffff, base) < len {
        return Result::Err(EteFlowError::BadSegment { base: base });
    }
    let end = wrapping_add(base, len);
    let mut ok = true;
    let mut tmp: ChunkSeq[CodeSegment] = ChunkSeq::new();
    loop {
        match img.segments.pop() {
            Option::Some(s) => {
                if seg_overlaps(in s, base, end) {
                    ok = false;
                }
                tmp.push(s);
            }
            Option::None => break,
        }
    }
    if !ok {
        loop {
            match tmp.pop() {
                Option::Some(s) => img.segments.push(s),
                Option::None => break,
            }
        }
        return Result::Err(EteFlowError::BadSegment { base: base });
    }
    let mut right: ChunkSeq[CodeSegment] = ChunkSeq::new();
    loop {
        match tmp.pop() {
            Option::Some(s) => {
                if s.base < base {
                    img.segments.push(s);
                } else {
                    right.push(s);
                }
            }
            Option::None => break,
        }
    }
    img.segments.push(CodeSegment { base: base, bytes: replace(inout bytes, ChunkSeq::new()) });
    let mut right_rev: ChunkSeq[CodeSegment] = ChunkSeq::new();
    loop {
        match right.pop() {
            Option::Some(s) => right_rev.push(s),
            Option::None => break,
        }
    }
    loop {
        match right_rev.pop() {
            Option::Some(s) => img.segments.push(s),
            Option::None => break,
        }
    }
    Result::Ok(img.segments.len())
}

fn seg_read_byte(in seg: CodeSegment, ip: u64) -> Option[u8] {
    if ip < seg.base {
        return Option::None;
    }
    let off = wrapping_sub(ip, seg.base);
    if off >= seg.bytes.len() {
        return Option::None;
    }
    Option::Some(byte_at(in seg.bytes.as_slice(), off))
}

fn image_read_byte(in segs: Slice[CodeSegment], ip: u64) -> Option[u8] {
    let mut i: u64 = 0;
    loop {
        if i >= segs.len() {
            break;
        }
        let mut found = false;
        let mut val: u8 = 0;
        let _ = handle Fail[RuntimeError] in {
            match seg_read_byte(in segs[i], ip) {
                Option::Some(b) => {
                    found = true;
                    val = b;
                }
                Option::None => {}
            }
            0
        } with {
            return _ => 0,
            raise(e, k) => {
                found = false;
                0
            },
        };
        if found {
            return Option::Some(val);
        }
        i = wrapping_add(i, 1);
    }
    Option::None
}

fn read_insn_u32(in img: CodeImage, ip: u64, element_index: u64) -> Result[u32, EteFlowError] {
    if (ip & 3) != 0 {
        return Result::Err(EteFlowError::IpOutsideImage {
            ip: ip,
            element_index: element_index,
        });
    }
    let b0 = match image_read_byte(in img.segments.as_slice(), ip) {
        Option::Some(v) => v,
        Option::None => {
            return Result::Err(EteFlowError::IpOutsideImage {
                ip: ip,
                element_index: element_index,
            });
        }
    };
    let b1 = match image_read_byte(in img.segments.as_slice(), wrapping_add(ip, 1)) {
        Option::Some(v) => v,
        Option::None => {
            return Result::Err(EteFlowError::IpOutsideImage {
                ip: ip,
                element_index: element_index,
            });
        }
    };
    let b2 = match image_read_byte(in img.segments.as_slice(), wrapping_add(ip, 2)) {
        Option::Some(v) => v,
        Option::None => {
            return Result::Err(EteFlowError::IpOutsideImage {
                ip: ip,
                element_index: element_index,
            });
        }
    };
    let b3 = match image_read_byte(in img.segments.as_slice(), wrapping_add(ip, 3)) {
        Option::Some(v) => v,
        Option::None => {
            return Result::Err(EteFlowError::IpOutsideImage {
                ip: ip,
                element_index: element_index,
            });
        }
    };
    let w = widen_u64(b0) | (widen_u64(b1) << 8) | (widen_u64(b2) << 16) | (widen_u64(b3) << 24);
    Result::Ok(wrapping_u32(w))
}

enum Waiting {
    WaitNothing,
    WaitIndirect {
        from: u64,
        kind: BranchKind,
    },
    WaitException {
        from: u64,
    },
}

struct Walker {
    max_instructions: u64,
    pc: Option[u64],
    waiting: Waiting,
    ts: Option[u64],
    pending_lo: Option[u64],
    pending_hi: Option[u64],
    aarch32: bool,
    open: ChunkSeq[Branch],
    branches: ChunkSeq[Branch],
    instructions: u64,
    overflows: u64,
}

fn clone_opt_u64(in o: Option[u64]) -> Option[u64] {
    match o {
        Option::Some(v) => Option::Some(v),
        Option::None => Option::None,
    }
}

fn clone_branch_kind(in k: BranchKind) -> BranchKind {
    match k {
        BranchKind::Conditional { taken } => BranchKind::Conditional { taken: taken },
        BranchKind::DirectJump => BranchKind::DirectJump,
        BranchKind::DirectCall => BranchKind::DirectCall,
        BranchKind::IndirectJump => BranchKind::IndirectJump,
        BranchKind::IndirectCall => BranchKind::IndirectCall,
        BranchKind::Return { compressed } => BranchKind::Return { compressed: compressed },
        BranchKind::Far => BranchKind::Far,
        BranchKind::Async => BranchKind::Async,
        BranchKind::Enable => BranchKind::Enable,
        BranchKind::Disable => BranchKind::Disable,
    }
}

fn walker_step(inout w: Walker) -> Result[u64, EteFlowError] {
    w.instructions = wrapping_add(w.instructions, 1);
    if w.instructions > w.max_instructions {
        return Result::Err(EteFlowError::InstructionBudget {
            limit: w.max_instructions,
        });
    }
    Result::Ok(0)
}

fn walker_push(
    inout w: Walker,
    from: u64,
    in to: Option[u64],
    in kind: BranchKind,
    element_index: u64
) {
    w.open.push(Branch {
        from: from,
        to: clone_opt_u64(in to),
        kind: clone_branch_kind(in kind),
        tsc_lo: clone_opt_u64(in w.ts),
        tsc_hi: Option::None,
        packet_index: element_index,
    });
}

fn flush_open(inout w: Walker, ts: Option[u64]) {
    let mut rev: ChunkSeq[Branch] = ChunkSeq::new();
    loop {
        match w.open.pop() {
            Option::Some(b) => rev.push(b),
            Option::None => break,
        }
    }
    loop {
        match rev.pop() {
            Option::Some(b) => {
                let b2 = Branch {
                    from: b.from,
                    to: b.to,
                    kind: b.kind,
                    tsc_lo: b.tsc_lo,
                    tsc_hi: clone_opt_u64(in ts),
                    packet_index: b.packet_index,
                };
                w.branches.push(b2);
            }
            Option::None => break,
        }
    }
}

fn walker_push_pending(inout w: Walker, from: u64, to: u64, in kind: BranchKind, i: u64) {
    let b = Branch {
        from: from,
        to: Option::Some(to),
        kind: clone_branch_kind(in kind),
        tsc_lo: clone_opt_u64(in w.pending_lo),
        tsc_hi: clone_opt_u64(in w.pending_hi),
        packet_index: i,
    };
    match w.pending_hi {
        Option::Some(_) => w.branches.push(b),
        Option::None => w.open.push(b),
    }
}

struct WalkOut {
    ip: u64,
    flow: A64Flow,
}

fn is_sequential(in f: A64Flow) -> bool {
    match f {
        A64Flow::Sequential => true,
        _ => false,
    }
}

fn walk_to_branch(
    inout w: Walker,
    in img: CodeImage,
    element_index: u64
) -> Result[WalkOut, EteFlowError] {
    let mut ip = match w.pc {
        Option::Some(v) => v,
        Option::None => return Result::Err(EteFlowError::NoAddress {
            element_index: element_index
        }),
    };
    loop {
        let insn = match read_insn_u32(in img, ip, element_index) {
            Result::Ok(v) => v,
            Result::Err(e) => return Result::Err(e),
        };
        match walker_step(inout w) {
            Result::Ok(_) => {}
            Result::Err(e) => return Result::Err(e),
        }
        let flow = match classify(ip, insn) {
            Option::Some(f) => f,
            Option::None => return Result::Err(EteFlowError::UnsupportedInsn {
                ip: ip,
                insn: insn
            }),
        };
        if is_sequential(in flow) {
            ip = wrapping_add(ip, 4);
        } else {
            return Result::Ok(WalkOut { ip: ip, flow: flow });
        }
    }
}

fn walker_atom(
    inout w: Walker,
    in img: CodeImage,
    executed: bool,
    i: u64
) -> Result[u64, EteFlowError] {
    let wo = match walk_to_branch(inout w, in img, i) {
        Result::Ok(v) => v,
        Result::Err(e) => return Result::Err(e),
    };
    let ip = wo.ip;
    match wo.flow {
        A64Flow::Sequential => Result::Ok(0),
        A64Flow::Conditional { target } => {
            let to = if executed {
                target
            } else {
                wrapping_add(ip, 4)
            };
            walker_push(
                inout w,
                ip,
                Option::Some(to),
                BranchKind::Conditional { taken: executed },
                i
            );
            w.pc = Option::Some(to);
            Result::Ok(0)
        }
        A64Flow::Direct { target, call } => {
            if !executed {
                return Result::Err(EteFlowError::UnexpectedNotTaken { ip: ip, element_index: i });
            }
            let kind = if call {
                BranchKind::DirectCall
            } else {
                BranchKind::DirectJump
            };
            walker_push(inout w, ip, Option::Some(target), kind, i);
            w.pc = Option::Some(target);
            Result::Ok(0)
        }
        A64Flow::Indirect { call } => {
            if !executed {
                return Result::Err(EteFlowError::UnexpectedNotTaken { ip: ip, element_index: i });
            }
            let kind = if call {
                BranchKind::IndirectCall
            } else {
                BranchKind::IndirectJump
            };
            w.waiting = Waiting::WaitIndirect { from: ip, kind: kind };
            w.pending_lo = clone_opt_u64(in w.ts);
            w.pending_hi = Option::None;
            w.pc = Option::None;
            Result::Ok(0)
        }
        A64Flow::A64Return => {
            if !executed {
                return Result::Err(EteFlowError::UnexpectedNotTaken { ip: ip, element_index: i });
            }
            w.waiting = Waiting::WaitIndirect {
                from: ip,
                kind: BranchKind::Return { compressed: false },
            };
            w.pending_lo = clone_opt_u64(in w.ts);
            w.pending_hi = Option::None;
            w.pc = Option::None;
            Result::Ok(0)
        }
        A64Flow::A64ExceptionReturn => {
            if !executed {
                return Result::Err(EteFlowError::UnexpectedNotTaken { ip: ip, element_index: i });
            }
            w.waiting = Waiting::WaitIndirect { from: ip, kind: BranchKind::Far };
            w.pending_lo = clone_opt_u64(in w.ts);
            w.pending_hi = Option::None;
            w.pc = Option::None;
            Result::Ok(0)
        }
    }
}

fn walker_exception(
    inout w: Walker,
    in img: CodeImage,
    preferred_return: u64,
    i: u64,
) -> Result[u64, EteFlowError] {
    match w.pc {
        Option::Some(start_ip) => {
            let mut ip = start_ip;
            loop {
                if ip == preferred_return {
                    break;
                }
                let insn = match read_insn_u32(in img, ip, i) {
                    Result::Ok(v) => v,
                    Result::Err(e) => return Result::Err(e),
                };
                let flow = match classify(ip, insn) {
                    Option::Some(f) => f,
                    Option::None => return Result::Err(EteFlowError::UnsupportedInsn {
                        ip: ip,
                        insn: insn
                    }),
                };
                match flow {
                    A64Flow::Sequential => {
                        match walker_step(inout w) {
                            Result::Ok(_) => {}
                            Result::Err(e) => return Result::Err(e),
                        }
                        ip = wrapping_add(ip, 4);
                    }
                    _ => {
                        return Result::Err(EteFlowError::ExceptionPastBranch {
                            ip: ip,
                            preferred_return: preferred_return,
                            element_index: i,
                        });
                    }
                }
            }
        }
        Option::None => {}
    }
    w.waiting = Waiting::WaitException { from: preferred_return };
    w.pending_lo = clone_opt_u64(in w.ts);
    w.pending_hi = Option::None;
    w.pc = Option::None;
    Result::Ok(0)
}

fn is_isa_is0(in isa: InstructionSet) -> bool {
    match isa {
        InstructionSet::Is0 => true,
        InstructionSet::Is1 => false,
    }
}

fn walker_address(
    inout w: Walker,
    address: u64,
    in isa: InstructionSet,
    i: u64,
) -> Result[u64, EteFlowError] {
    if !is_isa_is0(in isa) {
        return Result::Err(EteFlowError::NotA64 { element_index: i });
    }
    let prev_waiting = replace(inout w.waiting, Waiting::WaitNothing);
    match prev_waiting {
        Waiting::WaitIndirect { from, kind } => {
            walker_push_pending(inout w, from, address, kind, i);
        }
        Waiting::WaitException { from } => {
            walker_push_pending(inout w, from, address, BranchKind::Far, i);
        }
        Waiting::WaitNothing => {
            let same_pc = match w.pc {
                Option::Some(p) => p == address,
                Option::None => false,
            };
            if !same_pc {
                walker_push(inout w, address, Option::Some(address), BranchKind::Enable, i);
            }
        }
    }
    w.pc = Option::Some(address);
    Result::Ok(0)
}

fn waiting_is_nothing(in w: Waiting) -> bool {
    match w {
        Waiting::WaitNothing => true,
        _ => false,
    }
}

fn process_element(
    inout w: Walker,
    in img: CodeImage,
    in el: EteElement,
    i: u64,
) -> Result[u64, EteFlowError] {
    match el {
        EteElement::Atom { executed } => {
            if w.aarch32 {
                return Result::Err(EteFlowError::NotA64 { element_index: i });
            }
            walker_atom(inout w, in img, executed, i)
        }
        EteElement::Address { address, isa } => {
            if w.aarch32 {
                return Result::Err(EteFlowError::NotA64 { element_index: i });
            }
            walker_address(inout w, address, in isa, i)
        }
        EteElement::Exception { exception_type: _, preferred_return, isa: _ } => {
            if w.aarch32 {
                return Result::Err(EteFlowError::NotA64 { element_index: i });
            }
            walker_exception(inout w, in img, preferred_return, i)
        }
        EteElement::Context(c) => {
            w.aarch32 = !c.sixty_four;
            Result::Ok(0)
        }
        EteElement::Timestamp { timestamp, cycle_count: _ } => {
            if !waiting_is_nothing(in w.waiting) {
                match w.pending_hi {
                    Option::None => {
                        w.pending_hi = Option::Some(timestamp);
                    }
                    Option::Some(_) => {}
                }
            }
            flush_open(inout w, Option::Some(timestamp));
            w.ts = Option::Some(timestamp);
            Result::Ok(0)
        }
        EteElement::Overflow => {
            w.overflows = wrapping_add(w.overflows, 1);
            w.pc = Option::None;
            w.waiting = Waiting::WaitNothing;
            Result::Ok(0)
        }
        EteElement::Discard | EteElement::TraceOn | EteElement::Sync => {
            w.pc = Option::None;
            w.waiting = Waiting::WaitNothing;
            Result::Ok(0)
        }
        _ => Result::Ok(0),
    }
}

pub fn reconstruct(
    in elements: Slice[EteElementAt],
    in image: CodeImage,
    in limits: FlowLimits,
) -> Result[FlowTrace, EteFlowError] {
    let mut w = Walker {
        max_instructions: limits.max_instructions,
        pc: Option::None,
        waiting: Waiting::WaitNothing,
        ts: Option::None,
        pending_lo: Option::None,
        pending_hi: Option::None,
        aarch32: false,
        open: ChunkSeq::new(),
        branches: ChunkSeq::new(),
        instructions: 0,
        overflows: 0,
    };
    let mut i: u64 = 0;
    loop {
        if i >= elements.len() {
            break;
        }
        let step_res = handle Fail[RuntimeError] in {
            process_element(inout w, in image, in elements[i].element, i)
        } with {
            return x => x,
            raise(e, k) => Result::Ok(0),
        };
        match step_res {
            Result::Ok(_) => {}
            Result::Err(e) => return Result::Err(e),
        }
        i = wrapping_add(i, 1);
    }
    flush_open(inout w, Option::None);
    let stopped_at = match w.waiting {
        Waiting::WaitIndirect { from, kind: _ } => Option::Some(from),
        Waiting::WaitException { from } => Option::Some(from),
        Waiting::WaitNothing => w.pc,
    };
    Result::Ok(FlowTrace {
        branches: w.branches,
        instructions: w.instructions,
        overflows: w.overflows,
        stopped_at: stopped_at,
    })
}
