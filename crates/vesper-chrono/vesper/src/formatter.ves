// CoreSight trace formatter removal (§31.1 item 3).
pub fn frame_len() -> u64 {
    16
}

pub struct Deformatted {
    stream_ids: ChunkSeq[u8],
    stream_bytes: ChunkSeq[u8],
    pub frames: u64,
    pub syncs: u64,
    pub unattributed: u64,
    pub padding: u64,
    pub control: u64,
}

// err_code:
// 0 = Ok
// 1 = PartialFrame (err_offset = offset, err_val = len)
// 2 = NoSync
// 3 = ReservedId (err_offset = offset, err_val = id)
// 4 = BadAuxBit (err_offset = offset)
// 5 = OutputBudget (err_val = limit)
pub struct DeformatResult {
    pub err_code: u32,
    pub err_offset: u64,
    pub err_val: u64,
    pub out: Deformatted,
}

fn empty_deformatted() -> Deformatted {
    Deformatted {
        stream_ids: ChunkSeq::new(),
        stream_bytes: ChunkSeq::new(),
        frames: 0,
        syncs: 0,
        unattributed: 0,
        padding: 0,
        control: 0,
    }
}

pub fn stream_for(in d: Deformatted, id: u8) -> ChunkSeq[u8] {
    let mut out: ChunkSeq[u8] = ChunkSeq::new();
    let ids = d.stream_ids.as_slice();
    let bs = d.stream_bytes.as_slice();
    let mut i: u64 = 0;
    loop {
        if i >= ids.len() {
            break;
        }
        let sid = match ids.try_get(i) {
            Option::Some(v) => v,
            Option::None => 0,
        };
        if sid == id {
            let b = match bs.try_get(i) {
                Option::Some(v) => v,
                Option::None => 0,
            };
            out.push(b);
        }
        i = wrapping_add(i, 1);
    }
    out
}

fn byte_at(in s: Slice[u8], i: u64) -> u8 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

fn is_fsync_at(in s: Slice[u8], at: u64) -> bool {
    if at > s.len() || wrapping_sub(s.len(), at) < 4 {
        return false;
    }
    byte_at(in s, at) == 255
        && byte_at(in s, wrapping_add(at, 1)) == 255
        && byte_at(in s, wrapping_add(at, 2)) == 255
        && byte_at(in s, wrapping_add(at, 3)) == 127
}

fn is_fsync_prefix(in s: Slice[u8], at: u64) -> bool {
    let rem = wrapping_sub(s.len(), at);
    if rem == 0 || rem > 4 {
        return false;
    }
    let mut i: u64 = 0;
    loop {
        if i >= rem {
            break;
        }
        let want: u8 = if i < 3 {
            255
        } else {
            127
        };
        if byte_at(in s, wrapping_add(at, i)) != want {
            return false;
        }
        i = wrapping_add(i, 1);
    }
    true
}

fn find_first_fsync(in s: Slice[u8]) -> Option[u64] {
    if s.len() < 4 {
        return Option::None;
    }
    let limit = wrapping_sub(s.len(), 4);
    let mut i: u64 = 0;
    loop {
        if i > limit {
            break;
        }
        if is_fsync_at(in s, i) {
            return Option::Some(i);
        }
        i = wrapping_add(i, 1);
    }
    Option::None
}

fn emit_byte(
    inout out: Deformatted,
    has_id: bool,
    cur_id: u8,
    inout total: u64,
    max_output: u64,
    b: u8,
) -> u32 {
    if !has_id {
        out.unattributed = wrapping_add(out.unattributed, 1);
        return 0;
    }
    if cur_id == 0 {
        out.padding = wrapping_add(out.padding, 1);
        return 0;
    }
    if cur_id == 123 || cur_id == 125 {
        out.control = wrapping_add(out.control, 1);
        return 0;
    }
    total = wrapping_add(total, 1);
    if total > max_output {
        return 5;
    }
    out.stream_ids.push(cur_id);
    out.stream_bytes.push(b);
    0
}

fn check_id(b: u8) -> (bool, u8) {
    let id = wrapping_u8(wrapping_shr_u64(widen_u64(b), 1));
    if id >= 112 && id <= 127 && id != 123 && id != 125 {
        (false, id)
    } else {
        (true, id)
    }
}

// mode: 0 = Frames, 1 = FrameSync.
pub fn deformat(in bytes: Slice[u8], mode: u32, max_output: u64) -> DeformatResult {
    let mut out = empty_deformatted();
    let mut has_id = false;
    let mut cur_id: u8 = 0;
    let mut total: u64 = 0;
    let mut at: u64 = if mode == 0 {
        0
    } else {
        match find_first_fsync(in bytes) {
            Option::Some(first) => {
                out.syncs = wrapping_add(out.syncs, 1);
                wrapping_add(first, 4)
            }
            Option::None => {
                return DeformatResult {
                    err_code: 2,
                    err_offset: 0,
                    err_val: 0,
                    out: out,
                };
            }
        }
    };

    loop {
        if at >= bytes.len() {
            break;
        }
        if mode == 1 && is_fsync_at(in bytes, at) {
            out.syncs = wrapping_add(out.syncs, 1);
            at = wrapping_add(at, 4);
            continue;
        }
        let rem = wrapping_sub(bytes.len(), at);
        if rem < frame_len() {
            if mode == 1 && is_fsync_prefix(in bytes, at) {
                break;
            }
            return DeformatResult {
                err_code: 1,
                err_offset: at,
                err_val: rem,
                out: out,
            };
        }
        let aux = byte_at(in bytes, wrapping_add(at, 15));
        let mut n: u64 = 0;
        loop {
            if n >= 7 {
                break;
            }
            let off = wrapping_add(at, wrapping_mul(2, n));
            let b = byte_at(in bytes, off);
            let next_b = byte_at(in bytes, wrapping_add(off, 1));
            let flag = wrapping_u8(wrapping_shr_u64(widen_u64(aux), wrapping_u32(n)) & 1);
            if (b & 1) == 1 {
                if flag == 1 {
                    let e1 = emit_byte(inout out, has_id, cur_id, inout total, max_output, next_b);
                    if e1 != 0 {
                        return DeformatResult {
                            err_code: 5,
                            err_offset: 0,
                            err_val: max_output,
                            out: out,
                        };
                    }
                    let (ok, new_id) = check_id(b);
                    if !ok {
                        return DeformatResult {
                            err_code: 3,
                            err_offset: off,
                            err_val: widen_u64(new_id),
                            out: out,
                        };
                    }
                    has_id = true;
                    cur_id = new_id;
                } else {
                    let (ok, new_id) = check_id(b);
                    if !ok {
                        return DeformatResult {
                            err_code: 3,
                            err_offset: off,
                            err_val: widen_u64(new_id),
                            out: out,
                        };
                    }
                    has_id = true;
                    cur_id = new_id;
                    let e2 = emit_byte(inout out, has_id, cur_id, inout total, max_output, next_b);
                    if e2 != 0 {
                        return DeformatResult {
                            err_code: 5,
                            err_offset: 0,
                            err_val: max_output,
                            out: out,
                        };
                    }
                }
            } else {
                let d0 = (b & 254) | flag;
                let e3 = emit_byte(inout out, has_id, cur_id, inout total, max_output, d0);
                if e3 != 0 {
                    return DeformatResult {
                        err_code: 5,
                        err_offset: 0,
                        err_val: max_output,
                        out: out,
                    };
                }
                let e4 = emit_byte(inout out, has_id, cur_id, inout total, max_output, next_b);
                if e4 != 0 {
                    return DeformatResult {
                        err_code: 5,
                        err_offset: 0,
                        err_val: max_output,
                        out: out,
                    };
                }
            }
            n = wrapping_add(n, 1);
        }
        let b14 = byte_at(in bytes, wrapping_add(at, 14));
        let flag7 = wrapping_u8(wrapping_shr_u64(widen_u64(aux), 7) & 1);
        if (b14 & 1) == 1 {
            if flag7 != 0 {
                return DeformatResult {
                    err_code: 4,
                    err_offset: wrapping_add(at, 15),
                    err_val: 0,
                    out: out,
                };
            }
            let (ok, new_id) = check_id(b14);
            if !ok {
                return DeformatResult {
                    err_code: 3,
                    err_offset: wrapping_add(at, 14),
                    err_val: widen_u64(new_id),
                    out: out,
                };
            }
            has_id = true;
            cur_id = new_id;
        } else {
            let d14 = (b14 & 254) | flag7;
            let e5 = emit_byte(inout out, has_id, cur_id, inout total, max_output, d14);
            if e5 != 0 {
                return DeformatResult {
                    err_code: 5,
                    err_offset: 0,
                    err_val: max_output,
                    out: out,
                };
            }
        }
        out.frames = wrapping_add(out.frames, 1);
        at = wrapping_add(at, frame_len());
    }

    DeformatResult {
        err_code: 0,
        err_offset: 0,
        err_val: 0,
        out: out,
    }
}

// ---------------------------------------------------------------------------
// The export the Rust crate calls (formatter::deformat, Rust-exit SH6 lane 14
// part 7a, #1409). Trace bytes go to `data` in arrival order (it is at
// least `bytes.len()` long, which bounds what frames can emit); `runs`
// gets one word per run of bytes of one source, `id | start << 8`, so the
// caller appends whole runs to the streams. When `runs` is full the result
// is 6 and the caller retries with `bytes.len() / 2 + 1` words, which is
// always enough: every run but the first starts at an ID change, which
// takes a flag-carrying byte. `w` gets the counters: w[0]
// frames, w[1] syncs, w[2] unattributed, w[3] padding, w[4] control, w[5]
// the bytes emitted, w[6] and w[7] the error's offset and value, w[8] the
// runs. The result is the error code of DeformatResult (0 for none).

// Bit 0 of bytes 0, 2, 4 and 6 of a word: the flag-carrying bytes.
const EVEN_BIT0: u64 = 281479271743489;
// Bytes 0-6 of a word.
const BYTES_0_6: u64 = 72057594037927935;

// Whether a source ID is reserved.
fn reserved_id(id: u64) -> bool {
    id >= 112 && id != 123 && id != 125
}

fn set_err(inout w: Slice[u64], code: u64, off: u64, val: u64) -> u64 {
    w.try_set(6, off);
    w.try_set(7, val);
    code
}

pub fn deformat_into(
    in bytes: Slice[u8],
    mode: u64,
    max_output: u64,
    inout data: Slice[u8],
    inout runs: Slice[u64],
    inout w: Slice[u64]
) -> u64 {
    let len = bytes.len();
    let mut frames: u64 = 0;
    let mut syncs: u64 = 0;
    let mut unattributed: u64 = 0;
    let mut padding: u64 = 0;
    let mut control: u64 = 0;
    let mut n: u64 = 0;
    let mut nruns: u64 = 0;
    // The source of the last emitted trace byte (256: none yet).
    let mut run_id: u64 = 256;
    // The current ID: 256 before the first ID change.
    let mut cur: u64 = 256;
    let mut at: u64 = 0;
    let mut code: u64 = 0;
    if mode == 1 {
        match find_first_fsync(in bytes) {
            Option::Some(first) => {
                syncs = 1;
                at = wrapping_add(first, 4);
            },
            Option::None => {
                code = 2;
                at = len;
            },
        }
    }
    loop {
        if code != 0 || at >= len {
            break;
        }
        if mode == 1 && is_fsync_at(in bytes, at) {
            syncs = wrapping_add(syncs, 1);
            at = wrapping_add(at, 4);
            continue;
        }
        let rem = wrapping_sub(len, at);
        if rem < 16 {
            if mode == 1 && is_fsync_prefix(in bytes, at) {
                break;
            }
            code = set_err(inout w, 1, at, rem);
            break;
        }
        let lo = match bytes.try_read_u64_le(at) {
            Option::Some(v) => v,
            Option::None => 0,
        };
        let hi = match bytes.try_read_u64_le(wrapping_add(at, 8)) {
            Option::Some(v) => v,
            Option::None => 0,
        };
        let aux = wrapping_shr_u64(hi, 56);
        // The common frame: no ID change (bit 0 of every flag-carrying byte
        // clear) under a trace source whose run is open, with room left.
        // Its 15 bytes are the frame with each flag-carrying byte's bit 0
        // taken from the auxiliary byte, written as two words (the second
        // spills one byte past the frame into space the buffer has, since
        // `n <= at`).
        if ((lo | hi) & EVEN_BIT0) == 0
            && cur == run_id
            && run_id != 256
            && wrapping_add(n, 15) <= max_output {
            let lo_bits = (aux & 1) | wrapping_shl_u64(aux & 2, 15) | wrapping_shl_u64(
                aux & 4,
                30
            ) | wrapping_shl_u64(aux & 8, 45);
            let hi_bits = wrapping_shr_u64(aux & 16, 4) | wrapping_shl_u64(
                aux & 32,
                11
            ) | wrapping_shl_u64(aux & 64, 26) | wrapping_shl_u64(aux & 128, 41);
            let _w0 = data.try_write_u64_le(n, lo | lo_bits);
            let _w1 = data.try_write_u64_le(wrapping_add(n, 8), (hi | hi_bits) & BYTES_0_6);
            n = wrapping_add(n, 15);
            frames = wrapping_add(frames, 1);
            at = wrapping_add(at, 16);
            continue;
        }
        // Bytes 0..14 in order: k even is flag-carrying, k odd is data.
        let mut k: u64 = 0;
        loop {
            if k >= 15 {
                break;
            }
            let b = if k < 8 {
                wrapping_shr_u64(lo, wrapping_u32(k << 3)) & 255
            } else {
                wrapping_shr_u64(hi, wrapping_u32((k & 7) << 3)) & 255
            };
            let flag = wrapping_shr_u64(aux, wrapping_u32(k >> 1)) & 1;
            // An ID change, and whether the data byte after it still
            // belongs to the previous ID.
            let change = (k & 1) == 0 && (b & 1) == 1;
            let mut emits: u64 = 1;
            let mut e: u64 = b;
            if (k & 1) == 0 {
                if change {
                    if k == 14 {
                        if flag != 0 {
                            code = set_err(inout w, 4, wrapping_add(at, 15), 0);
                            break;
                        }
                        emits = 0;
                    } else {
                        emits = 2;
                        let k1 = wrapping_add(k, 1);
                        e = if k1 < 8 {
                            wrapping_shr_u64(lo, wrapping_u32(k1 << 3)) & 255
                        } else {
                            wrapping_shr_u64(hi, wrapping_u32((k1 & 7) << 3)) & 255
                        };
                    }
                } else {
                    e = (b & 254) | flag;
                }
            }
            let id = wrapping_shr_u64(b, 1);
            if change && (k == 14 || flag == 0) {
                if reserved_id(id) {
                    code = set_err(inout w, 3, wrapping_add(at, k), id);
                    break;
                }
                cur = id;
            }
            if emits != 0 {
                if cur > 0 && cur < 112 {
                    if n >= max_output {
                        code = set_err(inout w, 5, 0, max_output);
                        break;
                    }
                    if cur != run_id {
                        if nruns >= runs.len() {
                            code = 6;
                            break;
                        }
                        runs.try_set(nruns, cur | (n << 8));
                        nruns = wrapping_add(nruns, 1);
                        run_id = cur;
                    }
                    data.try_set(n, wrapping_u8(e));
                    n = wrapping_add(n, 1);
                } else if cur == 256 {
                    unattributed = wrapping_add(unattributed, 1);
                } else if cur == 0 {
                    padding = wrapping_add(padding, 1);
                } else {
                    control = wrapping_add(control, 1);
                }
            }
            if change && k != 14 && flag == 1 {
                if reserved_id(id) {
                    code = set_err(inout w, 3, wrapping_add(at, k), id);
                    break;
                }
                cur = id;
            }
            // An ID change consumes its data byte too.
            if emits == 2 {
                k = wrapping_add(k, 2);
            } else {
                k = wrapping_add(k, 1);
            }
        }
        if code != 0 {
            break;
        }
        frames = wrapping_add(frames, 1);
        at = wrapping_add(at, 16);
    }
    w.try_set(0, frames);
    w.try_set(1, syncs);
    w.try_set(2, unattributed);
    w.try_set(3, padding);
    w.try_set(4, control);
    w.try_set(5, n);
    w.try_set(8, nruns);
    code
}
