# The frozen Rust seed copy of vesper-loom-trust (package
# vesper-loom-trust-seed, library vesper_loom_trust) that the compiler's tool
# binaries and the crates of the compiler's build link: the sources in ../src
# with cfg(vesper_port) off, over the Rust engine in ../src/reference. The
# port-backed package needs //:bin/vesper to build its object, and
# //:bin/vesper carries the vesper-tools binaries as run-time data, so those
# must not link the port. Written by hand because its sources live in the
# parent package; see "Crates the compiler links" in
# docs/maintenance/porting-a-crate.md.
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rs//rs/private:all_crate_deps.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test")
load("@vesper_cargo//:packages.bzl", "PACKAGES")

_CRATE = PACKAGES["crates/vesper-loom-trust/seed"].crate_data()

_DEPS = all_crate_deps(_CRATE, normal = True, platforms = _CRATE["platforms"])

rust_library(
    name = "seed",
    srcs = ["//crates/vesper-loom-trust:rust_srcs"],
    aliases = _CRATE.get("aliases", {}),
    crate_name = "vesper_loom_trust",
    crate_root = "//crates/vesper-loom-trust:src/lib.rs",
    edition = "2024",
    rustc_env = {
        "CARGO_PKG_NAME": "vesper-loom-trust-seed",
        "CARGO_PKG_VERSION": "0.1.0",
    },
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = _DEPS,
)

rust_test(
    name = "seed_test_slopsquat",
    srcs = ["//crates/vesper-loom-trust:tests/slopsquat.rs"],
    crate_root = "//crates/vesper-loom-trust:tests/slopsquat.rs",
    edition = "2024",
    deps = [":seed"] + _DEPS,
)

rust_clippy_test(
    name = "clippy",
    targets = [":seed"],
    tags = [
        "clippy",
        "lint",
    ],
)
