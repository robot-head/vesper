<?xml version="1.0" encoding="utf-8"?>
<!--
  Hand-written CMSIS-SVD 1.3 fixture for the vesper-silicon tests.
  It follows the CMSIS-SVD schema (https://open-cmsis-pack.github.io/svd-spec/)
  and is loosely modelled on common Cortex-M SPI/UART/Ethernet-MAC register
  layouts. It describes no real device. Licence: same as this repository.
-->
<device schemaVersion="1.3" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="CMSIS-SVD.xsd">
  <vendor>Vesper</vendor>
  <name>VSIM32</name>
  <version>1.0</version>
  <description>Simulated 32-bit microcontroller for Silicon register-model tests</description>
  <addressUnitBits>8</addressUnitBits>
  <width>32</width>
  <size>32</size>
  <access>read-write</access>
  <resetValue>0x00000000</resetValue>
  <resetMask>0xFFFFFFFF</resetMask>
  <peripherals>
    <peripheral>
      <name>SPI1</name>
      <description>Serial peripheral interface</description>
      <baseAddress>0x40013000</baseAddress>
      <addressBlock><offset>0x0</offset><size>0x400</size><usage>registers</usage></addressBlock>
      <interrupt><name>SPI1</name><value>35</value></interrupt>
      <registers>
        <register>
          <name>CR1</name>
          <description>Control register 1</description>
          <addressOffset>0x00</addressOffset>
          <fields>
            <field><name>CPHA</name><bitOffset>0</bitOffset><bitWidth>1</bitWidth></field>
            <field><name>CPOL</name><bitOffset>1</bitOffset><bitWidth>1</bitWidth></field>
            <field><name>MSTR</name><bitOffset>2</bitOffset><bitWidth>1</bitWidth></field>
            <field><name>BR</name><bitOffset>3</bitOffset><bitWidth>3</bitWidth></field>
            <field><name>SPE</name><bitOffset>6</bitOffset><bitWidth>1</bitWidth></field>
          </fields>
        </register>
        <register>
          <name>SR</name>
          <description>Status register</description>
          <addressOffset>0x08</addressOffset>
          <resetValue>0x00000002</resetValue>
          <fields>
            <field><name>RXNE</name><bitOffset>0</bitOffset><bitWidth>1</bitWidth><access>read-only</access></field>
            <field><name>TXE</name><bitOffset>1</bitOffset><bitWidth>1</bitWidth><access>read-only</access></field>
            <field><name>CRCERR</name><bitOffset>4</bitOffset><bitWidth>1</bitWidth><access>read-write</access><modifiedWriteValues>oneToClear</modifiedWriteValues></field>
            <field><name>BSY</name><bitOffset>7</bitOffset><bitWidth>1</bitWidth><access>read-only</access></field>
          </fields>
        </register>
        <register>
          <name>DR</name>
          <description>Data register</description>
          <addressOffset>0x0C</addressOffset>
          <size>16</size>
          <fields>
            <field><name>DR</name><bitOffset>0</bitOffset><bitWidth>16</bitWidth></field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral derivedFrom="SPI1">
      <name>SPI2</name>
      <baseAddress>0x40003800</baseAddress>
    </peripheral>
    <peripheral>
      <name>ETHMAC</name>
      <description>Ethernet MAC interrupt block</description>
      <baseAddress>0x40028000</baseAddress>
      <addressBlock><offset>0x0</offset><size>0x100</size><usage>registers</usage></addressBlock>
      <interrupt><name>ETH</name><value>42</value></interrupt>
      <registers>
        <register>
          <name>IRQ_STATUS</name>
          <description>Pending interrupts, write 1 to acknowledge</description>
          <addressOffset>0x10</addressOffset>
          <access>read-write</access>
          <modifiedWriteValues>oneToClear</modifiedWriteValues>
          <fields>
            <field><name>RX_DONE</name><bitOffset>0</bitOffset><bitWidth>1</bitWidth></field>
            <field><name>TX_DONE</name><bitOffset>1</bitOffset><bitWidth>1</bitWidth></field>
            <field><name>RX_OVERFLOW</name><bitOffset>2</bitOffset><bitWidth>1</bitWidth></field>
            <field><name>LINK_CHANGE</name><bitOffset>3</bitOffset><bitWidth>1</bitWidth></field>
          </fields>
        </register>
        <register>
          <name>IRQ_ENABLE</name>
          <addressOffset>0x14</addressOffset>
          <fields>
            <field><name>MASK</name><bitOffset>0</bitOffset><bitWidth>4</bitWidth></field>
          </fields>
        </register>
        <register>
          <name>MAC_ID</name>
          <addressOffset>0x00</addressOffset>
          <access>read-only</access>
          <resetValue>0x56455350</resetValue>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>UART0</name>
      <baseAddress>0x40004000</baseAddress>
      <addressBlock><offset>0x0</offset><size>0x100</size><usage>registers</usage></addressBlock>
      <registers>
        <register>
          <name>RXDATA</name>
          <description>Received byte; reading pops it and clears the flags</description>
          <addressOffset>0x00</addressOffset>
          <access>read-only</access>
          <readAction>clear</readAction>
          <fields>
            <field><name>DATA</name><bitOffset>0</bitOffset><bitWidth>8</bitWidth></field>
            <field><name>FRAME_ERR</name><bitOffset>8</bitOffset><bitWidth>1</bitWidth></field>
          </fields>
        </register>
        <register>
          <name>TXDATA</name>
          <addressOffset>0x04</addressOffset>
          <access>write-only</access>
          <fields>
            <field><name>DATA</name><bitOffset>0</bitOffset><bitWidth>8</bitWidth></field>
          </fields>
        </register>
        <register>
          <name>CTRL</name>
          <addressOffset>0x08</addressOffset>
          <fields>
            <field><name>EN</name><bitOffset>0</bitOffset><bitWidth>1</bitWidth></field>
            <field><name>VERSION</name><bitOffset>4</bitOffset><bitWidth>4</bitWidth><access>read-only</access></field>
            <field><name>FLUSH</name><bitOffset>8</bitOffset><bitWidth>1</bitWidth><access>read-write</access><modifiedWriteValues>oneToSet</modifiedWriteValues></field>
          </fields>
        </register>
      </registers>
    </peripheral>
  </peripherals>
</device>
