# The frozen Rust seed copy of vesper-silicon (package vesper-silicon-seed,
# library vesper_silicon) that the compiler and every other dependent link:
# ../src built without the port, so cfg(vesper_port) is off. Written by hand
# because its sources live in the parent package; see "Crates the compiler
# links" in docs/maintenance/porting-a-crate.md (port wave P3a lane 7, #1042).
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rs//rs/private:all_crate_deps.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test")
load("@vesper_cargo//:packages.bzl", "PACKAGES")

# The seed's external dependencies (Cranelift, svd-parser, and
# cranelift-frontend for the tests), from its Cargo metadata as
# vesper_crate derives them.
_DATA = PACKAGES["crates/vesper-silicon/seed"].crate_data()

_NORMAL = all_crate_deps(_DATA, platforms = _DATA["platforms"], normal = True)

_DEV = all_crate_deps(_DATA, platforms = _DATA["platforms"], normal_dev = True)

_ENV = {
    "CARGO_PKG_NAME": "vesper-silicon-seed",
    "CARGO_PKG_VERSION": "0.1.0",
}

# As vesper_crate does for integration tests: compiled code must not keep
# Bazel's absolute CARGO_MANIFEST_DIR (tests/rp2040.rs names it on its
# VESPER_REGEN_PAC path).
_TEST_ENV = dict(
    _ENV,
    CARGO_MANIFEST_DIR = ".",
    CARGO_TARGET_TMPDIR = ".",
)

rust_library(
    name = "seed",
    srcs = ["//crates/vesper-silicon:rust_srcs"],
    crate_name = "vesper_silicon",
    crate_root = "//crates/vesper-silicon:src/lib.rs",
    edition = "2024",
    rustc_env = _ENV,
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = _NORMAL,
)

rust_test(
    name = "seed_unit_test",
    crate = ":seed",
    edition = "2024",
    deps = _DEV,
)

# Every integration test but tests/lean.rs, which reads lean/ through a
# regular-file copy of the runfiles; it runs against the seed in Cargo
# (aspect crate silicon check) and against the port here.
[
    rust_test(
        name = "seed_test_" + t,
        srcs = [
            "//crates/vesper-silicon:tests/%s.rs" % t,
            "//crates/vesper-silicon:test_common",
        ],
        compile_data = ["//crates/vesper-silicon:fixtures"],
        crate_root = "//crates/vesper-silicon:tests/%s.rs" % t,
        edition = "2024",
        rustc_env = _TEST_ENV,
        deps = [":seed"] + _NORMAL + _DEV,
    )
    for t in [
        "aia",
        "aia_hypervisor",
        "aia_qemu",
        "atomic",
        "devicetree_rest",
        "dma_ranges",
        "dtb",
        "intc",
        "rp2040",
        "runtime",
        "stack",
        "svd",
        "zicbom",
    ]
]

rust_clippy_test(
    name = "clippy",
    targets = [":seed"],
    tags = [
        "clippy",
        "lint",
    ],
)
