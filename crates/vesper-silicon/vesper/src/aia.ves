// Module aia of @vesper/silicon (see lib.ves): the RISC-V AIA register
// models of src/aia.rs, the IMSIC interrupt file and the APLIC domain.
//
// Each model is a bank: one handle holds any number of files (domains),
// each a header plus its run of the bank's sequences, and every operation
// names the file (domain) it acts on. A standalone `ImsicFile` or
// `AplicDomain` is a bank of one; the interrupt fabric (module intc) keeps
// every file and domain of a platform in one bank each, so its loops stay
// inside this library. (A handle cannot hold a sequence of handles.)
//
// Source modes are their `sourcecfg.SM` codes: 0 Inactive, 1 Detached,
// 4 EdgeRising, 5 EdgeFalling, 6 LevelHigh, 7 LevelLow.
use self::{
    AiaFault,
    Aplic,
    AplicHdr,
    Imsic,
    ImsicHdr,
    Msi,
    MsiCfg
};

// The constants of src/aia.rs and src/aia/rust.rs, by the same names
// (RISC-V AIA 1.0 section numbers).

// `*iselect` numbers of the IMSIC indirect registers (§3.8).
const ISEL_EIDELIVERY: u64 = 112;
const ISEL_EITHRESHOLD: u64 = 114;
const ISEL_EIP0: u64 = 128;
const ISEL_EIP63: u64 = 191;
const ISEL_EIE0: u64 = 192;
const ISEL_EIE63: u64 = 255;
// `eidelivery`: on, and delivery from a PLIC or APLIC (§3.8.1).
const EIDELIVERY_ON: u64 = 1;
const EIDELIVERY_EXTERNAL: u64 = 1073741824;
// IMSIC interrupt-file registers (§3.6): seteipnum_le and seteipnum_be.
const SETEIPNUM_LE: u64 = 0;
const SETEIPNUM_BE: u64 = 4;
// Smallest and largest IMSIC identity count the binding allows.
const IMSIC_MIN_IDS: u64 = 63;
const IMSIC_MAX_IDS: u64 = 2047;
// Largest APLIC source count.
const APLIC_MAX_SOURCES: u64 = 1023;
// `topei`/`topi`/`claimi`: the identity sits at bit 16 (§3.9, §4.8.1.4).
const TOP_ID_SHIFT: u64 = 16;
// An MSI target address is a page number shifted by the 4 KiB page size.
const PAGE_SHIFT: u64 = 12;

// APLIC register offsets (§4.5).
const DOMAINCFG: u64 = 0;
const SOURCECFG: u64 = 4;
const MMSIADDRCFG: u64 = 7104;
const MMSIADDRCFGH: u64 = 7108;
const SMSIADDRCFG: u64 = 7112;
const SMSIADDRCFGH: u64 = 7116;
const SETIP: u64 = 7168;
const SETIPNUM: u64 = 7388;
const IN_CLRIP: u64 = 7424;
const CLRIPNUM: u64 = 7644;
const SETIE: u64 = 7680;
const SETIENUM: u64 = 7900;
const CLRIE: u64 = 7936;
const CLRIENUM: u64 = 8156;
const SETIPNUM_LE: u64 = 8192;
const SETIPNUM_BE: u64 = 8196;
const GENMSI: u64 = 12288;
const TARGET: u64 = 12292;
// First IDC; each is IDC_BYTES long.
const APLIC_IDC: u64 = 16384;
const IDC_BYTES: u64 = 32;
// IDC register offsets (§4.8.1).
const IDC_IDELIVERY: u64 = 0;
const IDC_IFORCE: u64 = 4;
const IDC_ITHRESHOLD: u64 = 8;
const IDC_TOPI: u64 = 24;
const IDC_CLAIMI: u64 = 28;

// `domaincfg` bits: 31:24 read as 0x80, IE and DM (§4.5.1).
const DOMAINCFG_READ_ONE: u64 = 2147483648;
const DOMAINCFG_IE: u64 = 256;
const DOMAINCFG_DM: u64 = 4;
const DOMAINCFG_IE_SHIFT: u64 = 8;
const DOMAINCFG_DM_SHIFT: u64 = 2;
// `sourcecfg[i]`: D (delegate), the Child Index when D = 1, and SM (§4.5.2).
const SOURCECFG_D: u64 = 1024;
const SOURCECFG_CHILD: u64 = 1023;
const SOURCECFG_SM: u64 = 7;
// Source modes (`sourcecfg.SM`); 2 and 3 are reserved.
const SM_INACTIVE: u64 = 0;
const SM_DETACHED: u64 = 1;
const SM_RESERVED_2: u64 = 2;
const SM_RESERVED_3: u64 = 3;
const SM_EDGE_RISING: u64 = 4;
const SM_EDGE_FALLING: u64 = 5;
const SM_LEVEL_HIGH: u64 = 6;
const SM_LEVEL_LOW: u64 = 7;
// `mmsiaddrcfgh`/`smsiaddrcfgh` fields (§4.5.4, §4.5.5): the PPN's bits
// 43:32, LHXW, HHXW, LHXS and HHXS, and the Lock bit.
const MSIADDRCFGH_PPN: u64 = 4095;
const MSIADDRCFGH_LHXW_SHIFT: u64 = 12;
const MSIADDRCFGH_LHXW: u64 = 15;
const MSIADDRCFGH_HHXW_SHIFT: u64 = 16;
const MSIADDRCFGH_HHXW: u64 = 7;
const MSIADDRCFGH_LHXS_SHIFT: u64 = 20;
const MSIADDRCFGH_LHXS: u64 = 7;
const MSIADDRCFGH_HHXS_SHIFT: u64 = 24;
const MSIADDRCFGH_HHXS: u64 = 31;
const MSIADDRCFGH_L: u64 = 2147483648;
const MSIADDRCFGH_L_SHIFT: u64 = 31;
// `target[i]` fields (§4.5.16): Hart Index 31:18, Guest Index 17:12, EIID
// 10:0 in MSI mode, IPRIO 7:0 in direct mode.
const TARGET_HART_SHIFT: u64 = 18;
const TARGET_HART: u64 = 4294705152;
const TARGET_GUEST_SHIFT: u64 = 12;
const TARGET_GUEST: u64 = 63;
const TARGET_GUEST_FIELD: u64 = 258048;
const TARGET_EIID: u64 = 2047;
const TARGET_IPRIO: u64 = 255;
// The low and high 32-bit halves of a u64.
const LOW_32_BITS: u64 = 4294967295;
const HIGH_32_BITS: u64 = 18446744069414584320;

fn word_at(in s: ChunkSeq[u64], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

fn flag_at(in s: ChunkSeq[bool], i: u64) -> bool {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => false,
    }
}

fn thirty_two() -> u64 {
    32
}

fn words_eq(in x: Slice[u64], in y: Slice[u64]) -> bool {
    if x.len() != y.len() {
        return false;
    }
    for i in 0..x.len() {
        if x.try_get(i) != y.try_get(i) {
            return false;
        }
    }
    true
}

fn bit(x: u64, b: u64) -> bool {
    (wrapping_shr_u64(x, wrapping_u32(b)) & 1) != 0
}

fn flag(b: bool) -> u64 {
    if b {
        1
    } else {
        0
    }
}

// `u32::swap_bytes` of the low 32 bits.
fn swap32(v: u64) -> u64 {
    ((v & 255) << 24) | (((v >> 8) & 255) << 16) | (((v >> 16) & 255) << 8) | ((v >> 24) & 255)
}

fn bad_iselect(isel: u64) -> Never eff [Fail[AiaFault]] {
    Fail::raise(AiaFault::BadIselect(isel))
}

// ---------------------------------------------------------------- IMSIC

fn no_file() -> ImsicHdr {
    ImsicHdr {
        ids: 0,
        delivery: 0,
        external: false,
        threshold: 0,
        off: 0,
        words: 0
    }
}

pub fn m_imsic_hdr(in f: Imsic, i: u64) -> ImsicHdr {
    match f.hdr.try_get(i) {
        Option::Some(h) => h,
        Option::None => no_file(),
    }
}

fn put_hdr(inout f: Imsic, i: u64, h: ImsicHdr) {
    let _ = f.hdr.try_set(i, h);
}

pub fn m_imsic_empty() -> Imsic {
    Imsic {
        hdr: ChunkSeq::new(),
        eip: ChunkSeq::new(),
        eie: ChunkSeq::new()
    }
}

// Appends a file with identities 1..=ids (`ImsicFile::new`, or
// `::with_external_delivery` when `external`).
pub fn m_imsic_push(inout f: Imsic, ids: u64, external: bool) eff [Fail[AiaFault]] {
    if ids < IMSIC_MIN_IDS || ids > IMSIC_MAX_IDS || (wrapping_add(ids, 1) & 63) != 0 {
        Fail::raise(AiaFault::BadIdCount(ids));
    }
    let words = wrapping_add(ids, 1) >> 6;
    let off = f.eip.len();
    for i in 0..words {
        f.eip.push(0);
        f.eie.push(0);
    }
    f
        .hdr
        .push(
        ImsicHdr {
            ids: ids,
            delivery: if external {
                EIDELIVERY_EXTERNAL
            } else {
                0
            },
            external: external,
            threshold: 0,
            off: off,
            words: words
        }
    );
}

pub fn m_imsic_make(ids: u64, external: bool) -> Imsic eff [Fail[AiaFault]] {
    let mut f = m_imsic_empty();
    m_imsic_push(inout f, ids, external);
    f
}

pub fn m_imsic_copy(in f: Imsic) -> Imsic {
    let mut g = m_imsic_empty();
    g.hdr.extend(in f.hdr.as_slice());
    g.eip.extend(in f.eip.as_slice());
    g.eie.extend(in f.eie.as_slice());
    g
}

fn hdr_same(a: ImsicHdr, b: ImsicHdr) -> bool {
    a
        .ids
        == b
        .ids
        && a
        .delivery
        == b
        .delivery
        && a
        .external
        == b
        .external
        && a
        .threshold
        == b
        .threshold
        && a
        .off
        == b
        .off
        && a
        .words
        == b
        .words
}

pub fn m_imsic_same(in a: Imsic, in b: Imsic) -> bool {
    if a.hdr.len() != b.hdr.len() {
        return false;
    }
    for i in 0..a.hdr.len() {
        if !hdr_same(m_imsic_hdr(in a, i), m_imsic_hdr(in b, i)) {
            return false;
        }
    }
    words_eq(in a.eip.as_slice(), in b.eip.as_slice())
        && words_eq(in a.eie.as_slice(), in b.eie.as_slice())
}

fn eip_word(in f: Imsic, h: ImsicHdr, w: u64) -> u64 {
    if w < h.words {
        word_at(in f.eip, wrapping_add(h.off, w))
    } else {
        0
    }
}

fn eie_word(in f: Imsic, h: ImsicHdr, w: u64) -> u64 {
    if w < h.words {
        word_at(in f.eie, wrapping_add(h.off, w))
    } else {
        0
    }
}

pub fn m_imsic_bit_eip(in f: Imsic, i: u64, id: u64) -> bool {
    let h = m_imsic_hdr(in f, i);
    bit(eip_word(in f, h, id >> 6), id & 63)
}

pub fn m_imsic_bit_eie(in f: Imsic, i: u64, id: u64) -> bool {
    let h = m_imsic_hdr(in f, i);
    bit(eie_word(in f, h, id >> 6), id & 63)
}

fn set_eip(inout f: Imsic, h: ImsicHdr, id: u64, on: bool) {
    let w = id >> 6;
    if w >= h.words {
        return;
    }
    let at = wrapping_add(h.off, w);
    match f.eip.try_get(at) {
        Option::Some(x) => {
            let m = wrapping_shl_u64(1, wrapping_u32(id & 63));
            let _ = f
                .eip
                .try_set(
                at,
                if on {
                    x | m
                } else {
                    x & ~m
                }
            );
        },
        Option::None => (),
    }
}

pub fn m_imsic_seteipnum(inout f: Imsic, i: u64, id: u64) {
    let h = m_imsic_hdr(in f, i);
    if id != 0 && id <= h.ids {
        set_eip(inout f, h, id, true);
    }
}

pub fn m_imsic_mmio_write32(inout f: Imsic, i: u64, off: u64, v: u64) {
    if off == SETEIPNUM_LE {
        m_imsic_seteipnum(inout f, i, v);
    } else if off == SETEIPNUM_BE {
        m_imsic_seteipnum(inout f, i, swap32(v));
    }
}

pub fn m_imsic_csr_read(in f: Imsic, i: u64, isel: u64) -> u64 eff [Fail[AiaFault]] {
    let h = m_imsic_hdr(in f, i);
    if isel == ISEL_EIDELIVERY {
        return h.delivery;
    }
    if isel == ISEL_EITHRESHOLD {
        return h.threshold;
    }
    if isel >= ISEL_EIP0 && isel <= ISEL_EIP63 {
        let k = wrapping_sub(isel, ISEL_EIP0);
        if (k & 1) != 0 {
            bad_iselect(isel);
        }
        return eip_word(in f, h, k >> 1);
    }
    if isel >= ISEL_EIE0 && isel <= ISEL_EIE63 {
        let k = wrapping_sub(isel, ISEL_EIE0);
        if (k & 1) != 0 {
            bad_iselect(isel);
        }
        return eie_word(in f, h, k >> 1);
    }
    bad_iselect(isel)
}

pub fn m_imsic_csr_write(inout f: Imsic, i: u64, isel: u64, v: u64) eff [Fail[AiaFault]] {
    let mut h = m_imsic_hdr(in f, i);
    if isel == ISEL_EIDELIVERY {
        h.delivery = if h.external && v == EIDELIVERY_EXTERNAL {
            EIDELIVERY_EXTERNAL
        } else {
            v & 1
        };
        put_hdr(inout f, i, h);
        return;
    }
    if isel == ISEL_EITHRESHOLD {
        let bits = wrapping_sub(64, widen_u64(leading_zeros_u64(h.ids)));
        h.threshold = v & wrapping_sub(wrapping_shl_u64(1, wrapping_u32(bits)), 1) & LOW_32_BITS;
        put_hdr(inout f, i, h);
        return;
    }
    if isel >= ISEL_EIP0 && isel <= ISEL_EIP63 {
        let k = wrapping_sub(isel, ISEL_EIP0);
        if (k & 1) != 0 {
            bad_iselect(isel);
        }
        let w = k >> 1;
        if w < h.words {
            let _ = f
                .eip
                .try_set(
                wrapping_add(h.off, w),
                if w == 0 {
                    v & ~1
                } else {
                    v
                }
            );
        }
        return;
    }
    if isel >= ISEL_EIE0 && isel <= ISEL_EIE63 {
        let k = wrapping_sub(isel, ISEL_EIE0);
        if (k & 1) != 0 {
            bad_iselect(isel);
        }
        let w = k >> 1;
        if w < h.words {
            let _ = f
                .eie
                .try_set(
                wrapping_add(h.off, w),
                if w == 0 {
                    v & ~1
                } else {
                    v
                }
            );
        }
        return;
    }
    bad_iselect(isel)
}

fn top_of(in f: Imsic, h: ImsicHdr) -> u64 {
    for w in 0..h.words {
        let at = wrapping_add(h.off, w);
        let m = word_at(in f.eip, at) & word_at(in f.eie, at);
        if m != 0 {
            let id = wrapping_add(w << 6, widen_u64(trailing_zeros_u64(m)));
            if h.threshold == 0 || id < h.threshold {
                return id;
            }
            return 0;
        }
    }
    0
}

pub fn m_imsic_top(in f: Imsic, i: u64) -> u64 {
    top_of(in f, m_imsic_hdr(in f, i))
}

pub fn m_imsic_topei(in f: Imsic, i: u64) -> u64 {
    let id = m_imsic_top(in f, i);
    (id << TOP_ID_SHIFT) | id
}

pub fn m_imsic_claim(inout f: Imsic, i: u64) -> u64 {
    let h = m_imsic_hdr(in f, i);
    let id = top_of(in f, h);
    if id != 0 {
        set_eip(inout f, h, id, false);
    }
    (id << TOP_ID_SHIFT) | id
}

pub fn m_imsic_asserted(in f: Imsic, i: u64) -> bool {
    let h = m_imsic_hdr(in f, i);
    h.delivery == EIDELIVERY_ON && top_of(in f, h) != 0
}

// ---------------------------------------------------------------- MSI addresses

fn low_mask(w: u64) -> u64 {
    wrapping_sub(wrapping_shl_u64(1, wrapping_u32(w)), 1)
}

// MsiAddrCfg::address (§4.9.1).
pub fn m_msi_address(c: MsiCfg, supervisor: bool, hart: u64, guest: u64) -> u64 {
    let g = wrapping_shr_u64(hart, wrapping_u32(c.lhxw)) & low_mask(c.hhxw);
    let h = hart & low_mask(c.lhxw);
    let ppn = if supervisor {
        c.s_ppn
    } else {
        c.m_ppn
    };
    let lhxs = if supervisor {
        c.lhxs_s
    } else {
        c.lhxs_m
    };
    let gu = if supervisor {
        guest
    } else {
        0
    };
    let v = ppn | wrapping_shl_u64(
        g,
        wrapping_u32(wrapping_add(c.hhxs, PAGE_SHIFT))
    ) | wrapping_shl_u64(h, wrapping_u32(lhxs)) | gu;
    wrapping_shl_u64(v, wrapping_u32(PAGE_SHIFT))
}

fn high_m(c: MsiCfg) -> u64 {
    wrapping_shl_u64(flag(c.locked), wrapping_u32(MSIADDRCFGH_L_SHIFT)) | wrapping_shl_u64(
        c.hhxs,
        wrapping_u32(MSIADDRCFGH_HHXS_SHIFT)
    ) | wrapping_shl_u64(c.lhxs_m, wrapping_u32(MSIADDRCFGH_LHXS_SHIFT)) | wrapping_shl_u64(
        c.hhxw,
        wrapping_u32(MSIADDRCFGH_HHXW_SHIFT)
    ) | wrapping_shl_u64(c.lhxw, wrapping_u32(MSIADDRCFGH_LHXW_SHIFT)) | (
        (c.m_ppn >> 32) & MSIADDRCFGH_PPN
    )
}

fn high_s(c: MsiCfg) -> u64 {
    wrapping_shl_u64(c.lhxs_s, wrapping_u32(MSIADDRCFGH_LHXS_SHIFT)) | (
        (c.s_ppn >> 32) & MSIADDRCFGH_PPN
    )
}

// ---------------------------------------------------------------- APLIC

fn mode_of(sm: u64) -> u64 {
    let m = sm & SOURCECFG_SM;
    if m == SM_RESERVED_2 || m == SM_RESERVED_3 {
        SM_INACTIVE
    } else {
        m
    }
}

fn rectify(mode: u64, raw: bool) -> bool {
    if mode == SM_EDGE_RISING || mode == SM_LEVEL_HIGH {
        raw
    } else if mode == SM_EDGE_FALLING || mode == SM_LEVEL_LOW {
        !raw
    } else {
        false
    }
}

fn is_level(mode: u64) -> bool {
    mode == SM_LEVEL_HIGH || mode == SM_LEVEL_LOW
}

fn zero_cfg() -> MsiCfg {
    MsiCfg {
        m_ppn: 0,
        s_ppn: 0,
        hhxs: 0,
        lhxs_m: 0,
        lhxs_s: 0,
        hhxw: 0,
        lhxw: 0,
        locked: false
    }
}

fn no_domain() -> AplicHdr {
    AplicHdr {
        base: 0,
        sources: 0,
        supervisor: false,
        root: false,
        msi_capable: false,
        direct_capable: false,
        children: 0,
        ie: false,
        dm: false,
        msicfg: zero_cfg(),
        src_off: 0,
        idc_off: 0,
        idcs: 0
    }
}

pub fn m_aplic_hdr(in a: Aplic, d: u64) -> AplicHdr {
    match a.hdr.try_get(d) {
        Option::Some(h) => h,
        Option::None => no_domain(),
    }
}

fn put_ahdr(inout a: Aplic, d: u64, h: AplicHdr) {
    let _ = a.hdr.try_set(d, h);
}

pub fn m_aplic_empty() -> Aplic {
    Aplic {
        hdr: ChunkSeq::new(),
        sourcecfg: ChunkSeq::new(),
        active_here: ChunkSeq::new(),
        raw: ChunkSeq::new(),
        pending: ChunkSeq::new(),
        enabled: ChunkSeq::new(),
        target: ChunkSeq::new(),
        idc_delivery: ChunkSeq::new(),
        idc_force: ChunkSeq::new(),
        idc_threshold: ChunkSeq::new(),
        outbox: ChunkSeq::new(),
        outbox_dom: ChunkSeq::new()
    }
}

// Appends a domain (`AplicDomain::new`).
pub fn m_aplic_push(
    inout a: Aplic,
    base: u64,
    size: u64,
    sources: u64,
    idcs: u64,
    msi_capable: bool,
    root: bool,
    supervisor: bool,
    children: u64
) eff [Fail[AiaFault]] {
    if sources == 0 || sources > APLIC_MAX_SOURCES {
        Fail::raise(AiaFault::BadSourceCount(sources));
    }
    if idcs == 0 && !msi_capable {
        Fail::raise(AiaFault::NoDeliveryMode);
    }
    let needed = wrapping_add(APLIC_IDC, wrapping_mul(IDC_BYTES, idcs));
    if size < needed {
        Fail::raise(
            AiaFault::WindowTooSmall {
                size: size,
                needed: needed
            }
        );
    }
    let src_off = a.sourcecfg.len();
    let idc_off = a.idc_delivery.len();
    let n = wrapping_add(sources, 1);
    for i in 0..n {
        a.sourcecfg.push(0);
        a.active_here.push(root);
        a.raw.push(false);
        a.pending.push(false);
        a.enabled.push(false);
        a.target.push(0);
    }
    for i in 0..idcs {
        a.idc_delivery.push(false);
        a.idc_force.push(false);
        a.idc_threshold.push(0);
    }
    a
        .hdr
        .push(
        AplicHdr {
            base: base,
            sources: sources,
            supervisor: supervisor,
            root: root,
            msi_capable: msi_capable,
            direct_capable: idcs > 0,
            children: children,
            ie: false,
            dm: msi_capable && idcs == 0,
            msicfg: zero_cfg(),
            src_off: src_off,
            idc_off: idc_off,
            idcs: idcs
        }
    );
}

pub fn m_aplic_make(
    base: u64,
    size: u64,
    sources: u64,
    idcs: u64,
    msi_capable: bool,
    root: bool,
    supervisor: bool,
    children: u64
) -> Aplic eff [Fail[AiaFault]] {
    let mut a = m_aplic_empty();
    m_aplic_push(inout a, base, size, sources, idcs, msi_capable, root, supervisor, children);
    a
}

pub fn m_aplic_copy(in a: Aplic) -> Aplic {
    let mut b = m_aplic_empty();
    b.hdr.extend(in a.hdr.as_slice());
    b.sourcecfg.extend(in a.sourcecfg.as_slice());
    b.active_here.extend(in a.active_here.as_slice());
    b.raw.extend(in a.raw.as_slice());
    b.pending.extend(in a.pending.as_slice());
    b.enabled.extend(in a.enabled.as_slice());
    b.target.extend(in a.target.as_slice());
    b.idc_delivery.extend(in a.idc_delivery.as_slice());
    b.idc_force.extend(in a.idc_force.as_slice());
    b.idc_threshold.extend(in a.idc_threshold.as_slice());
    b.outbox.extend(in a.outbox.as_slice());
    b.outbox_dom.extend(in a.outbox_dom.as_slice());
    b
}

// Per-source and per-IDC state of a domain.
fn src_flag(in s: ChunkSeq[bool], h: AplicHdr, src: u64) -> bool {
    src <= h.sources && flag_at(in s, wrapping_add(h.src_off, src))
}

fn src_word(in s: ChunkSeq[u64], h: AplicHdr, src: u64) -> u64 {
    if src <= h.sources {
        word_at(in s, wrapping_add(h.src_off, src))
    } else {
        0
    }
}

fn set_src_flag(inout s: ChunkSeq[bool], h: AplicHdr, src: u64, v: bool) {
    if src <= h.sources {
        let _ = s.try_set(wrapping_add(h.src_off, src), v);
    }
}

fn set_src_word(inout s: ChunkSeq[u64], h: AplicHdr, src: u64, v: u64) {
    if src <= h.sources {
        let _ = s.try_set(wrapping_add(h.src_off, src), v);
    }
}

fn idc_flag(in s: ChunkSeq[bool], h: AplicHdr, i: u64) -> bool {
    i < h.idcs && flag_at(in s, wrapping_add(h.idc_off, i))
}

fn idc_word(in s: ChunkSeq[u64], h: AplicHdr, i: u64) -> u64 {
    if i < h.idcs {
        word_at(in s, wrapping_add(h.idc_off, i))
    } else {
        0
    }
}

fn contains_h(h: AplicHdr, addr: u64) -> bool {
    let end = wrapping_add(APLIC_IDC, wrapping_mul(IDC_BYTES, h.idcs));
    addr >= h.base && wrapping_sub(addr, h.base) < end
}

pub fn m_aplic_contains(in a: Aplic, d: u64, addr: u64) -> bool {
    contains_h(m_aplic_hdr(in a, d), addr)
}

fn mode_h(in a: Aplic, h: AplicHdr, src: u64) -> u64 {
    if src == 0 || src > h.sources || !src_flag(in a.active_here, h, src) {
        return 0;
    }
    let cfg = src_word(in a.sourcecfg, h, src);
    if (cfg & SOURCECFG_D) != 0 {
        0
    } else {
        mode_of(cfg)
    }
}

pub fn m_aplic_mode(in a: Aplic, d: u64, src: u64) -> u64 {
    mode_h(in a, m_aplic_hdr(in a, d), src)
}

fn delegated_h(in a: Aplic, h: AplicHdr, src: u64) -> Option[u64] {
    if src == 0 || src > h.sources || !src_flag(in a.active_here, h, src) {
        return Option::None;
    }
    let cfg = src_word(in a.sourcecfg, h, src);
    if (cfg & SOURCECFG_D) != 0 {
        Option::Some(cfg & SOURCECFG_CHILD)
    } else {
        Option::None
    }
}

pub fn m_aplic_delegated_to(in a: Aplic, d: u64, src: u64) -> Option[u64] {
    delegated_h(in a, m_aplic_hdr(in a, d), src)
}

// Whether the source is delegated away from this domain (`delegated_to`
// is Some).
pub fn m_aplic_is_delegated_away(in a: Aplic, d: u64, src: u64) -> bool {
    let h = m_aplic_hdr(in a, d);
    src
        != 0
        && src
        <= h
        .sources
        && src_flag(in a.active_here, h, src)
        && (src_word(in a.sourcecfg, h, src) & SOURCECFG_D)
        != 0
}

pub fn m_aplic_is_delegated_here(in a: Aplic, d: u64, src: u64) -> bool {
    let h = m_aplic_hdr(in a, d);
    src != 0 && src <= h.sources && src_flag(in a.active_here, h, src)
}

pub fn m_aplic_is_pending(in a: Aplic, d: u64, src: u64) -> bool {
    src_flag(in a.pending, m_aplic_hdr(in a, d), src)
}

fn rectified_h(in a: Aplic, h: AplicHdr, src: u64) -> bool {
    src <= h.sources && rectify(mode_h(in a, h, src), src_flag(in a.raw, h, src))
}

pub fn m_aplic_rectified(in a: Aplic, d: u64, src: u64) -> bool {
    rectified_h(in a, m_aplic_hdr(in a, d), src)
}

fn settle(inout a: Aplic, h: AplicHdr, s: u64) {
    let mode = mode_h(in a, h, s);
    if mode == SM_INACTIVE {
        set_src_flag(inout a.pending, h, s, false);
        set_src_flag(inout a.enabled, h, s, false);
        set_src_word(inout a.target, h, s, 0);
        return;
    }
    if is_level(mode) {
        let r = rectify(mode, src_flag(in a.raw, h, s));
        if !h.dm {
            set_src_flag(inout a.pending, h, s, r);
        } else if !r {
            set_src_flag(inout a.pending, h, s, false);
        }
    }
}

pub fn m_aplic_set_active_here(inout a: Aplic, d: u64, src: u64, active: bool) {
    let h = m_aplic_hdr(in a, d);
    if src == 0 || src > h.sources {
        return;
    }
    if src_flag(in a.active_here, h, src) != active {
        set_src_flag(inout a.active_here, h, src, active);
        if !active {
            set_src_word(inout a.sourcecfg, h, src, 0);
        }
        settle(inout a, h, src);
    }
}

// Whether the source is active or delegated onward in the domain.
fn live_h(in a: Aplic, h: AplicHdr, src: u64) -> bool {
    if src == 0 || src > h.sources || !src_flag(in a.active_here, h, src) {
        return false;
    }
    let cfg = src_word(in a.sourcecfg, h, src);
    (cfg & SOURCECFG_D) != 0 || mode_of(cfg) != 0
}

// Child `c`, child index `ci` of domain `p`: each source is active in `c`
// exactly when `p` delegates it to `ci` (m_aplic_set_active_here for every
// source, with both headers read once). True when a source's liveness in
// `c` changed.
pub fn m_aplic_inherit(inout a: Aplic, p: u64, ci: u64, c: u64) -> bool {
    let hp = m_aplic_hdr(in a, p);
    let hc = m_aplic_hdr(in a, c);
    let mut changed = false;
    let mut s: u64 = 1;
    loop {
        if s > hc.sources {
            break;
        }
        let here = match delegated_h(in a, hp, s) {
            Option::Some(x) => x == ci,
            Option::None => false,
        };
        if src_flag(in a.active_here, hc, s) != here {
            let before = live_h(in a, hc, s);
            set_src_flag(inout a.active_here, hc, s, here);
            if !here {
                set_src_word(inout a.sourcecfg, hc, s, 0);
            }
            settle(inout a, hc, s);
            if before != live_h(in a, hc, s) {
                changed = true;
            }
        }
        s = wrapping_add(s, 1);
    }
    changed
}

pub fn m_aplic_set_wire(inout a: Aplic, d: u64, src: u64, high: bool) {
    let h = m_aplic_hdr(in a, d);
    if src == 0 || src > h.sources {
        return;
    }
    let mode = mode_h(in a, h, src);
    let before = rectify(mode, src_flag(in a.raw, h, src));
    set_src_flag(inout a.raw, h, src, high);
    let after = rectify(mode, high);
    if mode == SM_EDGE_RISING || mode == SM_EDGE_FALLING {
        if !before && after {
            set_src_flag(inout a.pending, h, src, true);
        }
    } else if is_level(mode) {
        if !h.dm {
            set_src_flag(inout a.pending, h, src, after);
        } else if !after {
            set_src_flag(inout a.pending, h, src, false);
        } else if !before {
            set_src_flag(inout a.pending, h, src, true);
        }
    }
}

pub fn m_aplic_set_msi_cfg(inout a: Aplic, d: u64, c: MsiCfg) {
    let mut h = m_aplic_hdr(in a, d);
    h.msicfg = c;
    put_ahdr(inout a, d, h);
}

fn set_pending(inout a: Aplic, h: AplicHdr, src: u64) {
    let mode = mode_h(in a, h, src);
    if mode == SM_DETACHED || mode == SM_EDGE_RISING || mode == SM_EDGE_FALLING {
        set_src_flag(inout a.pending, h, src, true);
    } else if is_level(mode) {
        if h.dm && rectify(mode, src_flag(in a.raw, h, src)) {
            set_src_flag(inout a.pending, h, src, true);
        }
    }
}

fn clear_pending(inout a: Aplic, h: AplicHdr, src: u64) {
    let mode = mode_h(in a, h, src);
    if mode == SM_INACTIVE {
        return;
    }
    if is_level(mode) && !h.dm {
        return;
    }
    set_src_flag(inout a.pending, h, src, false);
}

fn set_enable(inout a: Aplic, h: AplicHdr, src: u64, on: bool) {
    if mode_h(in a, h, src) != 0 {
        set_src_flag(inout a.enabled, h, src, on);
    }
}

// The bits of 32-source word `w`: 0 pending, 1 rectified input, 2 enabled.
fn word_bits(in a: Aplic, h: AplicHdr, w: u64, which: u64) -> u64 {
    let mut acc: u64 = 0;
    for b in 0..thirty_two() {
        let s = wrapping_add(wrapping_mul(w, 32), b);
        if s != 0 && s <= h.sources {
            let on = if which == 0 {
                src_flag(in a.pending, h, s)
            } else if which == 1 {
                rectified_h(in a, h, s)
            } else {
                src_flag(in a.enabled, h, s)
            };
            if on {
                acc = acc | wrapping_shl_u64(1, wrapping_u32(b));
            }
        }
    }
    acc
}

fn words(h: AplicHdr) -> u64 {
    wrapping_add(h.sources >> 5, 1)
}

fn topi_h(in a: Aplic, h: AplicHdr, idc: u64) -> u64 {
    if idc >= h.idcs || h.dm {
        return 0;
    }
    let threshold = idc_word(in a.idc_threshold, h, idc);
    let mut found = false;
    let mut bp: u64 = 0;
    let mut bs: u64 = 0;
    let mut s: u64 = 1;
    loop {
        if s > h.sources {
            break;
        }
        let at = wrapping_add(h.src_off, s);
        if flag_at(in a.pending, at) && flag_at(in a.enabled, at) {
            let t = word_at(in a.target, at);
            if (t >> TARGET_HART_SHIFT) == idc {
                let prio = t & TARGET_IPRIO;
                if threshold == 0 || prio < threshold {
                    if !found || prio < bp {
                        found = true;
                        bp = prio;
                        bs = s;
                    }
                }
            }
        }
        s = wrapping_add(s, 1);
    }
    if found {
        (bs << TOP_ID_SHIFT) | bp
    } else {
        0
    }
}

pub fn m_aplic_topi(in a: Aplic, d: u64, idc: u64) -> u64 {
    topi_h(in a, m_aplic_hdr(in a, d), idc)
}

fn claimi_h(inout a: Aplic, h: AplicHdr, idc: u64) -> u64 {
    let v = topi_h(in a, h, idc);
    if v == 0 {
        if idc < h.idcs {
            let _ = a.idc_force.try_set(wrapping_add(h.idc_off, idc), false);
        }
        return 0;
    }
    let s = v >> TOP_ID_SHIFT;
    let mode = mode_h(in a, h, s);
    if is_level(mode) {
        let r = rectify(mode, src_flag(in a.raw, h, s));
        set_src_flag(inout a.pending, h, s, r);
    } else {
        set_src_flag(inout a.pending, h, s, false);
    }
    v
}

pub fn m_aplic_claimi(inout a: Aplic, d: u64, idc: u64) -> u64 {
    let h = m_aplic_hdr(in a, d);
    claimi_h(inout a, h, idc)
}

pub fn m_aplic_idc_asserted(in a: Aplic, d: u64, idc: u64) -> bool {
    let h = m_aplic_hdr(in a, d);
    idc
        < h
        .idcs
        && h
        .ie
        && !h
        .dm
        && idc_flag(in a.idc_delivery, h, idc)
        && (idc_flag(in a.idc_force, h, idc) || topi_h(in a, h, idc) != 0)
}

fn post(inout a: Aplic, d: u64, m: Msi) {
    a.outbox.push(m);
    a.outbox_dom.push(d);
}

// Forwards the domain's pending, enabled sources (MSI mode) and hands back
// everything its outbox holds, oldest first.
pub fn m_aplic_take_msis(inout a: Aplic, d: u64) -> ChunkSeq[Msi] {
    let h = m_aplic_hdr(in a, d);
    if h.dm && h.ie {
        let mut s: u64 = 1;
        loop {
            if s > h.sources {
                break;
            }
            let at = wrapping_add(h.src_off, s);
            if flag_at(in a.pending, at) && flag_at(in a.enabled, at) {
                let t = word_at(in a.target, at);
                let addr = m_msi_address(
                    h.msicfg,
                    h.supervisor,
                    t >> TARGET_HART_SHIFT,
                    (t >> TARGET_GUEST_SHIFT) & TARGET_GUEST
                );
                post(
                    inout a,
                    d,
                    Msi {
                        addr: addr,
                        data: t & TARGET_EIID
                    }
                );
                let _ = a.pending.try_set(at, false);
            }
            s = wrapping_add(s, 1);
        }
    }
    let mut out: ChunkSeq[Msi] = ChunkSeq::new();
    let n = a.outbox.len();
    if n == 0 {
        return out;
    }
    let mut keep: ChunkSeq[Msi] = ChunkSeq::new();
    let mut keep_dom: ChunkSeq[u64] = ChunkSeq::new();
    for i in 0..n {
        match a.outbox.try_get(i) {
            Option::Some(m) => {
                if word_at(in a.outbox_dom, i) == d {
                    out.push(m);
                } else {
                    keep.push(m);
                    keep_dom.push(word_at(in a.outbox_dom, i));
                }
            },
            Option::None => (),
        }
    }
    a.outbox.clear();
    a.outbox_dom.clear();
    a.outbox.extend(in keep.as_slice());
    a.outbox_dom.extend(in keep_dom.as_slice());
    out
}

fn decode(h: AplicHdr, addr: u64) -> u64 eff [Fail[AiaFault]] {
    if (addr & 3) != 0 {
        Fail::raise(AiaFault::Misaligned(addr));
    }
    if !contains_h(h, addr) {
        Fail::raise(AiaFault::Unmapped(addr));
    }
    wrapping_sub(addr, h.base)
}

fn num(h: AplicHdr, v: u64) -> u64 {
    if v != 0 && v <= h.sources {
        v
    } else {
        0
    }
}

fn in_words(o: u64, base: u64, n: u64) -> bool {
    o >= base && o < wrapping_add(base, wrapping_mul(4, n))
}

fn unmapped(addr: u64) -> Never eff [Fail[AiaFault]] {
    Fail::raise(AiaFault::Unmapped(addr))
}

pub fn m_aplic_read32(inout a: Aplic, d: u64, addr: u64) -> u64 eff [Fail[AiaFault]] {
    let h = m_aplic_hdr(in a, d);
    let off = decode(h, addr);
    let cfg_ok = h.root && h.msi_capable;
    if off == DOMAINCFG {
        return DOMAINCFG_READ_ONE | (flag(h.ie) << DOMAINCFG_IE_SHIFT) | (
            flag(h.dm) << DOMAINCFG_DM_SHIFT
        );
    }
    if in_words(off, SOURCECFG, h.sources) {
        let s = wrapping_add(wrapping_sub(off, SOURCECFG) >> 2, 1);
        if src_flag(in a.active_here, h, s) {
            return src_word(in a.sourcecfg, h, s);
        }
        return 0;
    }
    if off >= MMSIADDRCFG && off <= SMSIADDRCFGH {
        if !cfg_ok {
            return 0;
        }
        if off == MMSIADDRCFG {
            return h.msicfg.m_ppn & LOW_32_BITS;
        }
        if off == MMSIADDRCFGH {
            return high_m(h.msicfg);
        }
        if off == SMSIADDRCFG {
            return h.msicfg.s_ppn & LOW_32_BITS;
        }
        return high_s(h.msicfg);
    }
    let nw = words(h);
    if in_words(off, SETIP, nw) {
        return word_bits(in a, h, wrapping_sub(off, SETIP) >> 2, 0);
    }
    if in_words(off, IN_CLRIP, nw) {
        return word_bits(in a, h, wrapping_sub(off, IN_CLRIP) >> 2, 1);
    }
    if in_words(off, SETIE, nw) {
        return word_bits(in a, h, wrapping_sub(off, SETIE) >> 2, 2);
    }
    if off
        == SETIPNUM
        || off
        == CLRIPNUM
        || off
        == SETIENUM
        || off
        == CLRIENUM
        || off
        == SETIPNUM_LE
        || off
        == SETIPNUM_BE {
        return 0;
    }
    if in_words(off, CLRIE, nw) {
        return 0;
    }
    if off == GENMSI {
        return 0;
    }
    if in_words(off, TARGET, h.sources) {
        return src_word(in a.target, h, wrapping_add(wrapping_sub(off, TARGET) >> 2, 1));
    }
    if off >= APLIC_IDC && h.direct_capable {
        let rel = wrapping_sub(off, APLIC_IDC);
        let i = rel >> 5;
        let r = rel & 31;
        if r == IDC_IDELIVERY {
            return flag(idc_flag(in a.idc_delivery, h, i));
        }
        if r == IDC_IFORCE {
            return flag(idc_flag(in a.idc_force, h, i));
        }
        if r == IDC_ITHRESHOLD {
            return idc_word(in a.idc_threshold, h, i);
        }
        if r == IDC_TOPI {
            return topi_h(in a, h, i);
        }
        if r == IDC_CLAIMI {
            return claimi_h(inout a, h, i);
        }
        unmapped(addr);
    }
    unmapped(addr)
}

fn each_bit(inout a: Aplic, h: AplicHdr, w: u64, v: u64, op: u64) {
    for b in 0..thirty_two() {
        if bit(v, b) {
            let s = num(h, wrapping_add(wrapping_mul(w, 32), b));
            if s != 0 {
                if op == 0 {
                    set_pending(inout a, h, s);
                } else if op == 1 {
                    clear_pending(inout a, h, s);
                } else {
                    set_enable(inout a, h, s, op == 2);
                }
            }
        }
    }
}

pub fn m_aplic_write32(inout a: Aplic, d: u64, addr: u64, v: u64) eff [Fail[AiaFault]] {
    let mut h = m_aplic_hdr(in a, d);
    let off = decode(h, addr);
    if off == DOMAINCFG {
        h.ie = (v & DOMAINCFG_IE) != 0;
        if h.msi_capable && h.direct_capable {
            h.dm = (v & DOMAINCFG_DM) != 0;
            put_ahdr(inout a, d, h);
            let mut s: u64 = 1;
            loop {
                if s > h.sources {
                    break;
                }
                settle(inout a, h, s);
                s = wrapping_add(s, 1);
            }
        } else {
            put_ahdr(inout a, d, h);
        }
        return;
    }
    if in_words(off, SOURCECFG, h.sources) {
        let s = wrapping_add(wrapping_sub(off, SOURCECFG) >> 2, 1);
        if !src_flag(in a.active_here, h, s) {
            return;
        }
        let cfg = if (v & SOURCECFG_D) != 0 && h.children > 0 {
            SOURCECFG_D | (v & SOURCECFG_CHILD)
        } else {
            mode_of(v)
        };
        set_src_word(inout a.sourcecfg, h, s, cfg);
        settle(inout a, h, s);
        return;
    }
    if off >= MMSIADDRCFG && off <= SMSIADDRCFGH {
        if !h.root || !h.msi_capable || h.msicfg.locked {
            return;
        }
        let mut c = h.msicfg;
        if off == MMSIADDRCFG {
            c.m_ppn = (c.m_ppn & HIGH_32_BITS) | v;
        } else if off == MMSIADDRCFGH {
            c.m_ppn = (c.m_ppn & LOW_32_BITS) | ((v & MSIADDRCFGH_PPN) << 32);
            c.lhxw = (v >> MSIADDRCFGH_LHXW_SHIFT) & MSIADDRCFGH_LHXW;
            c.hhxw = (v >> MSIADDRCFGH_HHXW_SHIFT) & MSIADDRCFGH_HHXW;
            c.lhxs_m = (v >> MSIADDRCFGH_LHXS_SHIFT) & MSIADDRCFGH_LHXS;
            c.hhxs = (v >> MSIADDRCFGH_HHXS_SHIFT) & MSIADDRCFGH_HHXS;
            c.locked = (v & MSIADDRCFGH_L) != 0;
        } else if off == SMSIADDRCFG {
            c.s_ppn = (c.s_ppn & HIGH_32_BITS) | v;
        } else {
            c.s_ppn = (c.s_ppn & LOW_32_BITS) | ((v & MSIADDRCFGH_PPN) << 32);
            c.lhxs_s = (v >> MSIADDRCFGH_LHXS_SHIFT) & MSIADDRCFGH_LHXS;
        }
        h.msicfg = c;
        put_ahdr(inout a, d, h);
        return;
    }
    let nw = words(h);
    if in_words(off, SETIP, nw) {
        each_bit(inout a, h, wrapping_sub(off, SETIP) >> 2, v, 0);
        return;
    }
    if off == SETIPNUM || off == SETIPNUM_LE {
        let s = num(h, v);
        if s != 0 {
            set_pending(inout a, h, s);
        }
        return;
    }
    if off == SETIPNUM_BE {
        let s = num(h, swap32(v));
        if s != 0 {
            set_pending(inout a, h, s);
        }
        return;
    }
    if in_words(off, IN_CLRIP, nw) {
        each_bit(inout a, h, wrapping_sub(off, IN_CLRIP) >> 2, v, 1);
        return;
    }
    if off == CLRIPNUM {
        let s = num(h, v);
        if s != 0 {
            clear_pending(inout a, h, s);
        }
        return;
    }
    if in_words(off, SETIE, nw) {
        each_bit(inout a, h, wrapping_sub(off, SETIE) >> 2, v, 2);
        return;
    }
    if off == SETIENUM {
        let s = num(h, v);
        if s != 0 {
            set_enable(inout a, h, s, true);
        }
        return;
    }
    if in_words(off, CLRIE, nw) {
        each_bit(inout a, h, wrapping_sub(off, CLRIE) >> 2, v, 3);
        return;
    }
    if off == CLRIENUM {
        let s = num(h, v);
        if s != 0 {
            set_enable(inout a, h, s, false);
        }
        return;
    }
    if off == GENMSI {
        if h.dm {
            let addr = m_msi_address(h.msicfg, h.supervisor, v >> TARGET_HART_SHIFT, 0);
            post(
                inout a,
                d,
                Msi {
                    addr: addr,
                    data: v & TARGET_EIID
                }
            );
        }
        return;
    }
    if in_words(off, TARGET, h.sources) {
        let s = wrapping_add(wrapping_sub(off, TARGET) >> 2, 1);
        if mode_h(in a, h, s) == SM_INACTIVE {
            return;
        }
        let t = if h.dm {
            let guest = if h.supervisor {
                v & TARGET_GUEST_FIELD
            } else {
                0
            };
            (v & TARGET_HART) | guest | (v & TARGET_EIID)
        } else {
            let p = v & TARGET_IPRIO;
            let prio = if p == 0 {
                1
            } else {
                p
            };
            (v & TARGET_HART) | prio
        };
        set_src_word(inout a.target, h, s, t);
        return;
    }
    if off >= APLIC_IDC && h.direct_capable {
        let rel = wrapping_sub(off, APLIC_IDC);
        let i = rel >> 5;
        let r = rel & 31;
        if i < h.idcs {
            let at = wrapping_add(h.idc_off, i);
            if r == IDC_IDELIVERY {
                let _ = a.idc_delivery.try_set(at, (v & 1) != 0);
                return;
            }
            if r == IDC_IFORCE {
                let _ = a.idc_force.try_set(at, (v & 1) != 0);
                return;
            }
            if r == IDC_ITHRESHOLD {
                let _ = a.idc_threshold.try_set(at, v & TARGET_IPRIO);
                return;
            }
        }
        if r == IDC_TOPI || r == IDC_CLAIMI {
            return;
        }
        if r == IDC_IDELIVERY || r == IDC_IFORCE || r == IDC_ITHRESHOLD {
            return;
        }
        unmapped(addr);
    }
    unmapped(addr)
}
