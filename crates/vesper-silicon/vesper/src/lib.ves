pub fn aplic_write32(inout a: Aplic, addr: u64, v: u64) eff [Fail[AiaFault]] {
    m_aplic_write32(inout a, 0, addr, v)
}

// ---------------------------------------------------------------- fabric types

// intc::IntcError as the controller core raises it; Aia carries the AIA
// model's fault (NoDeliveryMode gets the domain's path in the wrapper).
pub copy enum IntcFault {
    Unmapped(u64),
    Misaligned(u64),
    ReadOnly(u64),
    NoSuchSource(u64),
    TooManyContexts(u64),
    WindowTooSmall {
        size: u64,
        needed: u64
    },
    NoGuestFile {
        hart: u64,
        vgein: u64
    },
    Aia(AiaFault)
}

// One PLIC: `ndev + 1` per-source entries from `src_off`, `nctx` context
// targets and thresholds from `ctx_off`, and `nctx` rows of `ndev + 1`
// enable bits from `en_off`.
pub copy struct PlicHdr {
    base: u64,
    ndev: u64,
    nctx: u64,
    src_off: u64,
    ctx_off: u64,
    en_off: u64
}

// One APLIC domain's place in its tree: the parent (none() for a root),
// `nchild` modelled children from `child_off`, `nidc` IDC targets from
// `idc_off`.
pub copy struct DomTopo {
    parent: u64,
    child_off: u64,
    nchild: u64,
    idc_off: u64,
    nidc: u64
}

// One IMSIC: `ntgt` targets, `naddr` file addresses and `nslot` implemented
// files (each `ImsicSlot`).
pub copy struct ImsicBlk {
    gib: u64,
    ids: u64,
    tgt_off: u64,
    ntgt: u64,
    addr_off: u64,
    naddr: u64,
    slot_off: u64,
    nslot: u64
}

// An implemented IMSIC file: guest 0 and its guest files are `nguest`
// interrupt files of the fabric's bank from `first`.
pub copy struct ImsicSlot {
    first: u64,
    nguest: u64
}

// One CLINT (kind 0) or ACLINT MSWI (1), SSWI (2) or MTIMER (3) block:
// `nreg` register windows, `ntgt` targets, `nslot` SIP/MTIMECMP slots, and
// the MTIME register's address (none() without one).
pub copy struct ClintHdr {
    kind: u64,
    reg_off: u64,
    nreg: u64,
    tgt_off: u64,
    ntgt: u64,
    slot_off: u64,
    nslot: u64,
    mtime: u64
}

// One claimed external interrupt: the controller (`kind` 0 PLIC `a`, 1
// APLIC domain `a`, 2 IMSIC `a` file `b`) and the source or identity.
pub copy struct Claim {
    found: bool,
    kind: u64,
    a: u64,
    b: u64,
    number: u64
}

// A located IMSIC file (`k` none() when there is none).
pub copy struct Located {
    k: u64,
    g: u64,
    off: u64
}

// The controller state of the interrupt fabric (src/intc.rs `Core`).
pub struct Fabric {
    plic: ChunkSeq[PlicHdr],
    p_ctx: ChunkSeq[u64],
    p_priority: ChunkSeq[u64],
    p_level: ChunkSeq[bool],
    p_edge: ChunkSeq[bool],
    p_held: ChunkSeq[bool],
    p_pending: ChunkSeq[bool],
    p_service: ChunkSeq[bool],
    p_enable: ChunkSeq[bool],
    p_threshold: ChunkSeq[u64],
    aplic: Aplic,
    dom: ChunkSeq[DomTopo],
    d_child: ChunkSeq[u64],
    d_idc: ChunkSeq[u64],
    imsic: Imsic,
    mblk: ChunkSeq[ImsicBlk],
    m_tgt: ChunkSeq[u64],
    m_addr: ChunkSeq[u64],
    mslot: ChunkSeq[ImsicSlot],
    clint: ChunkSeq[ClintHdr],
    c_base: ChunkSeq[u64],
    c_size: ChunkSeq[u64],
    c_tgt: ChunkSeq[u64],
    c_sip: ChunkSeq[bool],
    c_cmp: ChunkSeq[u64],
    mt_addr: ChunkSeq[u64],
    mt_val: ChunkSeq[u64],
    hy_hart: ChunkSeq[u64],
    hy_vgein: ChunkSeq[u64],
    hy_hgeie: ChunkSeq[u64],
    lost: ChunkSeq[Msi]
}

// ---------------------------------------------------------------- fabric exports
//
// A hart target is `hart << 32 | cause` (cause 0xffffffff when absent); an
// absent index is u64::MAX.

pub fn fabric_new() -> Fabric {
    m_fabric_new()
}

pub fn fabric_add_plic(inout f: Fabric, base: u64, size: u64, ndev: u64, in ctx: Slice[u64]) eff [
    Fail[IntcFault]
] {
    m_add_plic(inout f, base, size, ndev, in ctx)
}

pub fn fabric_add_aplic(
    inout f: Fabric,
    base: u64,
    size: u64,
    sources: u64,
    in idcs: Slice[u64],
    msi_capable: bool,
    root: bool,
    supervisor: bool,
    children: u64
) eff [Fail[IntcFault]] {
    m_add_aplic(inout f, base, size, sources, in idcs, msi_capable, root, supervisor, children)
}

pub fn fabric_link_aplic(inout f: Fabric, d: u64, parent: u64, in children: Slice[u64]) {
    m_link_aplic(inout f, d, parent, in children)
}

pub fn fabric_add_imsic(
    inout f: Fabric,
    gib: u64,
    ids: u64,
    in targets: Slice[u64],
    in addrs: Slice[u64],
    in wired: Slice[bool]
) eff [Fail[IntcFault]] {
    m_add_imsic(inout f, gib, ids, in targets, in addrs, in wired)
}

pub fn fabric_add_clint(
    inout f: Fabric,
    kind: u64,
    in bases: Slice[u64],
    in sizes: Slice[u64],
    in targets: Slice[u64]
) {
    m_add_clint(inout f, kind, in bases, in sizes, in targets)
}

