    m_write32
};
use self::dtb::{
    m_parse
};

// ---------------------------------------------------------------- AIA types

// aia::AiaError; NoDeliveryMode gets the domain's path in the wrapper.
pub copy enum AiaFault {
    Unmapped(u64),
    Misaligned(u64),
    BadIselect(u64),
    BadIdCount(u64),
    BadSourceCount(u64),
    WindowTooSmall {
        size: u64,
        needed: u64
    },
    NoDeliveryMode
}

// aia::MsiAddrCfg.
pub copy struct MsiCfg {
    m_ppn: u64,
    s_ppn: u64,
    hhxs: u64,
    lhxs_m: u64,
    lhxs_s: u64,
    hhxw: u64,
    lhxw: u64,
    locked: bool
}

// aia::Msi.
pub copy struct Msi {
    addr: u64,
    data: u64
}

// One IMSIC interrupt file of a bank: its `eip` and `eie` words (64
// identities each) are `words` entries of the bank's sequences from `off`.
pub copy struct ImsicHdr {
    ids: u64,
    delivery: u64,
    external: bool,
    threshold: u64,
    off: u64,
    words: u64
}

// A bank of aia::ImsicFile; a standalone file is a bank of one.
pub struct Imsic {
    hdr: ChunkSeq[ImsicHdr],
    eip: ChunkSeq[u64],
    eie: ChunkSeq[u64]
}

// One aia::AplicDomain of a bank: `sources + 1` per-source entries (index 0
// unused) from `src_off` and `idcs` per-IDC entries from `idc_off`.
pub copy struct AplicHdr {
    base: u64,
    sources: u64,
    supervisor: bool,
    root: bool,
    msi_capable: bool,
    direct_capable: bool,
    children: u64,
    ie: bool,
    dm: bool,
    msicfg: MsiCfg,
    src_off: u64,
    idc_off: u64,
    idcs: u64
}

// A bank of APLIC domains; `outbox_dom` names the domain of each queued MSI.
pub struct Aplic {
    hdr: ChunkSeq[AplicHdr],
    sourcecfg: ChunkSeq[u64],
    active_here: ChunkSeq[bool],
    raw: ChunkSeq[bool],
    pending: ChunkSeq[bool],
    enabled: ChunkSeq[bool],
    target: ChunkSeq[u64],
    idc_delivery: ChunkSeq[bool],
    idc_force: ChunkSeq[bool],
    idc_threshold: ChunkSeq[u64],
    outbox: ChunkSeq[Msi],
    outbox_dom: ChunkSeq[u64]
}

// ---------------------------------------------------------------- AIA exports
//
// The standalone ImsicFile and AplicDomain: banks of one, file (domain) 0.

// ImsicFile::new (`external` false) and ::with_external_delivery.
