// Vesper port of vesper-silicon (port wave P3a lane 7, #1042).
//
// Ported here: the RISC-V AIA register models of src/aia.rs (module aia,
// banks of IMSIC files and APLIC domains), the controller state of the
// interrupt fabric in src/intc.rs (module intc, its `Core`: PLICs, APLIC
// trees, IMSIC files, CLINT/ACLINT blocks, MTIME and the hypervisor CSRs)
// and the flattened-devicetree reader of DeviceTree::parse in src/dtb.rs
// (module dtb). The Rust crate keeps its public types; its wrappers in
// src/port/ call this library and convert what comes back. The Rust build
// stays the default (the compiler links the seed copy, seed/) until the
// port reaches performance parity.
//
// @export abi 3
use self::aia::{
    m_aplic_claimi,
    m_aplic_contains,
    m_aplic_copy,
    m_aplic_delegated_to,
    m_aplic_hdr,
    m_aplic_idc_asserted,
    m_aplic_is_delegated_here,
    m_aplic_is_pending,
    m_aplic_make,
    m_aplic_mode,
    m_aplic_read32,
    m_aplic_rectified,
    m_aplic_set_active_here,
    m_aplic_set_msi_cfg,
    m_aplic_set_wire,
    m_aplic_take_msis,
    m_aplic_topi,
    m_aplic_write32,
    m_imsic_asserted,
    m_imsic_bit_eie,
    m_imsic_bit_eip,
    m_imsic_claim,
    m_imsic_copy,
    m_imsic_csr_read,
    m_imsic_csr_write,
    m_imsic_hdr,
    m_imsic_make,
    m_imsic_mmio_write32,
    m_imsic_same,
    m_imsic_seteipnum,
    m_imsic_top,
    m_imsic_topei,
    m_msi_address
};
use self::intc::{
    m_add_aplic,
    m_add_clint,
    m_add_imsic,
    m_add_plic,
    m_advance_mtime,
    m_aplic_count,
    m_aplic_raw_write32,
    m_claim_external,
    m_claim_vstopei,
    m_clear_ssip,
    m_clip_hgeie,
    m_complete_external,
    m_deliver_msi,
    m_fabric_new,
    m_file_claim,
    m_file_csr_read,
    m_file_csr_write,
    m_file_eidelivery,
    m_file_external,
    m_file_is_pending,
    m_file_topei,
    m_files_len,
    m_geilen,
    m_guest_files,
    m_hart_mtime,
    m_hgeie,
    m_hgeip,
    m_hyp_harts,
