// Module ascii of @vesper/serde: the ASCII bytes and UTF-8 patterns the
// JSON scanner, the number parsers and the encoders share. Untyped, so a
// member is a `u8` or a `u64` where it is used.

// ASCII characters.
pub enum Ascii: _ {
    Tab = 9,
    Lf = 0xa,
    Ff = 0xc,
    Cr = 0xd,
    Backspace = 8,
    Space = 0x20,
    Quote = 0x22,
    Plus = 0x2b,
    Comma = 0x2c,
    Minus = 0x2d,
    Dot = 0x2e,
    Slash = 0x2f,
    Zero = 0x30,
    One = 0x31,
    Nine = 0x39,
    Colon = 0x3a,
    UpperA = 0x41,
    UpperE = 0x45,
    UpperF = 0x46,
    Lbracket = 0x5b,
    Backslash = 0x5c,
    Rbracket = 0x5d,
    LowerA = 0x61,
    LowerB = 0x62,
    LowerE = 0x65,
    LowerF = 0x66,
    LowerL = 0x6c,
    LowerN = 0x6e,
    LowerR = 0x72,
    LowerS = 0x73,
    LowerT = 0x74,
    LowerU = 0x75,
    Lbrace = 0x7b,
    Rbrace = 0x7d,
    Tilde = 0x7e,
}

// UTF-8 lead and continuation byte patterns and the code point at which
// each encoded length starts (RFC 3629).
pub enum Utf8: _ {
    Lead4Payload = 7,
    Lead3Payload = 0xf,
    Lead2Payload = 0x1f,
    ContPayload = 0x3f,
    Cont = 0x80,
    TwoByteMin = 0x80,
    F4SecondHi = 0x8f,
    F0SecondLo = 0x90,
    EdSecondHi = 0x9f,
    E0SecondLo = 0xa0,
    ContHi = 0xbf,
    ContMask = 0xc0,
    Lead2Tag = 0xc0,
    Lead2Lo = 0xc2,
    Lead2Hi = 0xdf,
    Lead3Lo = 0xe0,
    Lead3Tag = 0xe0,
    SurrogateLead = 0xed,
    Lead3Hi = 0xef,
    Lead4Lo = 0xf0,
    Lead4Tag = 0xf0,
    Lead4Hi = 0xf4,
    ThreeByteMin = 0x800,
    FourByteMin = 0x10000,
}
