// @vesper/serde: shortest round-trip binary64 to decimal text, as Rust's
// `{}` (`Display`) formats an `f64`, which the encoder of src/encode.rs
// writes. The digits come from Rust's own shortest algorithm
// (`core::num::flt2dec::strategy::dragon::format_shortest`, the exact
// fallback that Grisu agrees with whenever it succeeds), over 1,280-bit
// numbers held as 40 little-endian 32-bit limbs; the layout is
// `flt2dec::digits_to_dec_str` with no fractional digits requested.

use self::grisu::{
    clz64,
    grisu_shortest
};
use self::ascii::{
    Ascii
};

// Rust's `Big32x40`: 40 little-endian 32-bit limbs, enough for any
// binary64 exponent plus the 192-bit headroom of `limbs_for`.
const MAX_LIMBS: u64 = 40;
const LIMB_BITS: u64 = 32;
const LIMB_HEADROOM_BITS: u64 = 192;
const LIMB_MASK: u64 = 0xffffffff;
const LIMB_BASE: u64 = 0x100000000;
// `mul_pow10` multiplies by 10^9, the largest power of ten in a limb.
const POW10_PER_LIMB: u64 = 9;
const TEN_TO_NINE: u64 = 1000000000;
const DECIMAL_BASE: u64 = 10;
// `estimate_scaling_factor`: log10(2) * 2^32, rounded up.
const LOG10_2_Q32: i64 = 1292913986;
// IEEE 754 binary64.
const MANTISSA_BITS: u64 = 52;
const EXPONENT_MASK: u64 = 0x7ff;
const MANTISSA_MASK: u64 = 0x000fffffffffffff;
const HIDDEN_BIT: u64 = 0x0010000000000000;
const SIGN_SHIFT: u64 = 63;
// `integer_decode`: the exponent bias 1023 plus the 52 mantissa bits.
const EXPONENT_OFFSET: i64 = 1075;
// The exponent `integer_decode` gives a subnormal (biased exponent 0).
const SUBNORMAL_EXPONENT: i64 = -1075;
// At most 17 shortest digits, plus slack.
const DIGIT_CAPACITY: u64 = 20;
// The digit value of an ASCII digit (u64 arithmetic).
const DIGIT_ZERO: u64 = 0x30;

// At most 40 limbs (Rust's `Big32x40`); a value uses only those its
// exponent can reach (`limbs_for`), so the loops run over `b.len()`.
fn limbs_for(exp: i64) -> u64 {
    let e = if exp < 0 {
        wrapping_u64(wrapping_sub(0, exp))
    } else {
        wrapping_u64(exp)
    };
    let n = wrapping_add(e, LIMB_HEADROOM_BITS) / LIMB_BITS;
    if n > MAX_LIMBS {
        MAX_LIMBS
    } else {
        n
    }
}

fn mask32() -> u64 {
    LIMB_MASK
}

fn big_zero(n: u64) -> ChunkSeq[u64] {
    let mut b: ChunkSeq[u64] = ChunkSeq::with_capacity(n);
    for _i in 0..n {
        b.push(0);
    }
    b
}

fn limb(in b: ChunkSeq[u64], i: u64) -> u64 {
    match b.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

fn big_from(v: u64, n: u64) -> ChunkSeq[u64] {
    let mut b = big_zero(n);
    b.try_set(0, v & mask32());
    b.try_set(1, v >> LIMB_BITS);
    b
}

fn big_copy(in a: ChunkSeq[u64]) -> ChunkSeq[u64] {
    let n = a.len();
    let mut b: ChunkSeq[u64] = ChunkSeq::with_capacity(n);
    for i in 0..n {
        b.push(limb(in a, i));
    }
    b
}

fn mul_small(inout b: ChunkSeq[u64], m: u64) {
    let size = b.len();
    let mut carry: u64 = 0;
    for i in 0..size {
        let v = wrapping_add(wrapping_mul(limb(in b, i), m), carry);
        b.try_set(i, v & mask32());
        carry = v >> LIMB_BITS;
    }
}

fn mul_pow2(inout b: ChunkSeq[u64], n: u64) {
    let size = b.len();
    let words = n / LIMB_BITS;
    let bits = n % LIMB_BITS;
    if words > 0 {
        let mut i = size;
        loop {
            if i == 0 {
                break;
            }
            i = wrapping_sub(i, 1);
            let v = if i >= words {
                limb(in b, wrapping_sub(i, words))
            } else {
                0
            };
            b.try_set(i, v);
        }
    }
    if bits > 0 {
        let mut carry: u64 = 0;
        for i in 0..size {
            let v = bit_shl(limb(in b, i), bits) | carry;
            b.try_set(i, v & mask32());
            carry = v >> LIMB_BITS;
        }
    }
}

fn mul_pow10(inout b: ChunkSeq[u64], n: u64) {
    let mut left = n;
    loop {
        if left < POW10_PER_LIMB {
            break;
        }
        mul_small(inout b, TEN_TO_NINE);
        left = wrapping_sub(left, POW10_PER_LIMB);
    }
    let mut m: u64 = 1;
    for _i in 0..left {
        m = wrapping_mul(m, DECIMAL_BASE);
    }
    if m > 1 {
        mul_small(inout b, m);
    }
}

// -1, 0 or 1 as a < b, a == b, a > b.
fn big_cmp(in a: ChunkSeq[u64], in b: ChunkSeq[u64]) -> i64 {
    let size = a.len();
    let mut i = size;
    loop {
        if i == 0 {
            break;
        }
        i = wrapping_sub(i, 1);
        let x = limb(in a, i);
        let y = limb(in b, i);
        if x < y {
            return -1;
        }
        if x > y {
            return 1;
        }
    }
    0
}

// `a + b` compared with `c`.
fn sum_cmp(in a: ChunkSeq[u64], in b: ChunkSeq[u64], in c: ChunkSeq[u64]) -> i64 {
    let mut s = big_copy(in a);
    big_add(inout s, in b);
    big_cmp(in c, in s)
}

fn big_add(inout a: ChunkSeq[u64], in b: ChunkSeq[u64]) {
    let size = a.len();
    let mut carry: u64 = 0;
    for i in 0..size {
        let v = wrapping_add(wrapping_add(limb(in a, i), limb(in b, i)), carry);
        a.try_set(i, v & mask32());
        carry = v >> LIMB_BITS;
    }
}

// `a -= b` for `a >= b`.
fn big_sub(inout a: ChunkSeq[u64], in b: ChunkSeq[u64]) {
    let size = a.len();
    let mut borrow: u64 = 0;
    for i in 0..size {
        let x = limb(in a, i);
        let y = wrapping_add(limb(in b, i), borrow);
        if x >= y {
            a.try_set(i, wrapping_sub(x, y));
            borrow = 0;
        } else {
            a.try_set(i, wrapping_sub(wrapping_add(x, LIMB_BASE), y));
            borrow = 1;
        }
    }
}

// `flt2dec::estimate_scaling_factor`.
fn estimate_scaling_factor(mant: u64, exp: i64) -> i64 {
    let nbits = wrapping_i64(wrapping_sub(64, clz64(wrapping_sub(mant, 1))));
    wrapping_mul(wrapping_add(nbits, exp), LOG10_2_Q32) >> LIMB_BITS
}

// Shortest digits of `mant * 2^exp`, with neighbors `minus` and `plus`
// (in units of 2^exp) and `inclusive` interval ends: returns the decimal
// exponent `k` (the value is 0.d1 d2 ... times 10^k); digits go to `out`.
fn format_shortest(
    mant0: u64,
    minus0: u64,
    plus0: u64,
    exp: i64,
    inclusive: bool,
    inout out: ChunkSeq[u8]
) -> i64 {
    // `a.cmp(b) < rounding` is `a <= b` when inclusive, else `a < b`.
    let rounding: i64 = if inclusive {
        1
    } else {
        0
    };
    let mut k = estimate_scaling_factor(wrapping_add(mant0, plus0), exp);
    let size = limbs_for(exp);
    let mut mant = big_from(mant0, size);
    let mut minus = big_from(minus0, size);
    let mut plus = big_from(plus0, size);
    let mut scale = big_from(1, size);
    if exp < 0 {
        mul_pow2(inout scale, wrapping_u64(wrapping_sub(0, exp)));
    } else {
        mul_pow2(inout mant, wrapping_u64(exp));
        mul_pow2(inout minus, wrapping_u64(exp));
        mul_pow2(inout plus, wrapping_u64(exp));
    }
    if k >= 0 {
        mul_pow10(inout scale, wrapping_u64(k));
    } else {
        let n = wrapping_u64(wrapping_sub(0, k));
        mul_pow10(inout mant, n);
        mul_pow10(inout minus, n);
        mul_pow10(inout plus, n);
    }
    if sum_cmp(in mant, in plus, in scale) < rounding {
        k = wrapping_add(k, 1);
    } else {
        mul_small(inout mant, DECIMAL_BASE);
        mul_small(inout minus, DECIMAL_BASE);
        mul_small(inout plus, DECIMAL_BASE);
    }
    let mut scale2 = big_copy(in scale);
    mul_pow2(inout scale2, 1);
    let mut scale4 = big_copy(in scale);
    mul_pow2(inout scale4, 2);
    let mut scale8 = big_copy(in scale);
    mul_pow2(inout scale8, 3);
    let mut down = false;
    let mut up = false;
    loop {
        let mut d: u64 = 0;
        if big_cmp(in mant, in scale8) >= 0 {
            big_sub(inout mant, in scale8);
            d = wrapping_add(d, 8);
        }
        if big_cmp(in mant, in scale4) >= 0 {
            big_sub(inout mant, in scale4);
            d = wrapping_add(d, 4);
        }
        if big_cmp(in mant, in scale2) >= 0 {
            big_sub(inout mant, in scale2);
            d = wrapping_add(d, 2);
        }
        if big_cmp(in mant, in scale) >= 0 {
            big_sub(inout mant, in scale);
            d = wrapping_add(d, 1);
        }
        out.push(wrapping_u8(wrapping_add(DIGIT_ZERO, d)));
        down = big_cmp(in mant, in minus) < rounding;
        up = sum_cmp(in mant, in plus, in scale) < rounding;
        if down || up {
            break;
        }
        mul_small(inout mant, DECIMAL_BASE);
        mul_small(inout minus, DECIMAL_BASE);
        mul_small(inout plus, DECIMAL_BASE);
    }
    if up {
        let mut round = !down;
        if !round {
            let mut twice = big_copy(in mant);
            mul_pow2(inout twice, 1);
            round = big_cmp(in twice, in scale) >= 0;
        }
        if round {
            // `round_up`: propagate the carry; all nines become 1000...
            let n = out.len();
            let mut i = n;
            let mut done = false;
            loop {
                if i == 0 {
                    break;
                }
                i = wrapping_sub(i, 1);
                let c = match out.try_get(i) {
                    Option::Some(c) => c,
                    Option::None => Ascii::Zero,
                };
                if c == Ascii::Nine {
                    out.try_set(i, Ascii::Zero);
                } else {
                    out.try_set(i, wrapping_add(c, 1));
                    done = true;
                    break;
                }
            }
            if !done {
                // Every digit was a nine: 1 followed by zeros, one longer.
                out.try_set(0, Ascii::One);
                out.push(Ascii::Zero);
                k = wrapping_add(k, 1);
            }
        }
    }
    k
}

// Rust's `{}` for a finite binary64, before layout: the sign, and the
// shortest digits with their exponent (`n` is 0 for a zero).
pub copy struct Shortest {
    neg: bool,
    digits: u64,
    n: u64,
    k: i64
}

// The digits Dragon pushed, as one integer (there are at most 17).
fn digits_value(in d: ChunkSeq[u8]) -> u64 {
    let mut v: u64 = 0;
    for i in 0..d.len() {
        let c = match d.try_get(i) {
            Option::Some(c) => widen_u64(c),
            Option::None => DIGIT_ZERO,
        };
        v = wrapping_add(wrapping_mul(v, DECIMAL_BASE), wrapping_sub(c, DIGIT_ZERO));
    }
    v
}

// `flt2dec::decode` then `grisu::format_shortest`, Dragon as its fallback.
pub fn shortest(bits: u64) -> Shortest {
    let neg = bits >> SIGN_SHIFT == 1;
    let biased = (bits >> MANTISSA_BITS) & EXPONENT_MASK;
    let frac = bits & MANTISSA_MASK;
    if biased == 0 && frac == 0 {
        return Shortest {
            neg: neg,
            digits: 0,
            n: 0,
            k: 0
        };
    }
    // `integer_decode` then `flt2dec::decode`: (mant, minus, plus, exp).
    let mut mant = frac;
    let mut exp: i64 = SUBNORMAL_EXPONENT;
    if biased != 0 {
        mant = frac | HIDDEN_BIT;
        exp = wrapping_sub(wrapping_i64(biased), EXPONENT_OFFSET);
    } else {
        mant = frac << 1;
    }
    let even = mant & 1 == 0;
    let mut minus: u64 = 1;
    let mut plus: u64 = 1;
    if biased != 0 {
        if mant == HIDDEN_BIT {
            mant = mant << 2;
            plus = 2;
            exp = wrapping_sub(exp, 2);
        } else {
            mant = mant << 1;
            exp = wrapping_sub(exp, 1);
        }
    }
    let g = grisu_shortest(mant, minus, plus, exp);
    if g.ok {
        return Shortest {
            neg: neg,
            digits: g.digits,
            n: g.n,
            k: g.k
        };
    }
    let mut d: ChunkSeq[u8] = ChunkSeq::with_capacity(DIGIT_CAPACITY);
    let k = format_shortest(mant, minus, plus, exp, even, inout d);
    Shortest {
        neg: neg,
        digits: digits_value(in d),
        n: d.len(),
        k: k
    }
}

// The length of the text `{}` writes for `s` (`digits_to_dec_str` with
// no fractional digits requested; a zero is `0`).
pub fn shortest_len(s: Shortest) -> u64 {
    let sign: u64 = if s.neg {
        1
    } else {
        0
    };
    if s.n == 0 {
        return wrapping_add(sign, 1);
    }
    let body = if s.k <= 0 {
        wrapping_add(wrapping_add(2, wrapping_u64(wrapping_sub(0, s.k))), s.n)
    } else if wrapping_u64(s.k) < s.n {
        wrapping_add(s.n, 1)
    } else {
        wrapping_u64(s.k)
    };
    wrapping_add(sign, body)
}

// Writes the text of `s` to `out[at..at + shortest_len(s)]`, digits from
// the last one back.
pub fn put_shortest(inout out: Slice[u8], at: u64, s: Shortest) {
    let mut p = at;
    if s.neg {
        out.try_set(p, Ascii::Minus);
        p = wrapping_add(p, 1);
    }
    if s.n == 0 {
        out.try_set(p, Ascii::Zero);
        return;
    }
    let n = s.n;
    let mut v = s.digits;
    if s.k <= 0 {
        // `0.` then -k zeros then the digits.
        let zeros = wrapping_u64(wrapping_sub(0, s.k));
        out.try_set(p, Ascii::Zero);
        out.try_set(wrapping_add(p, 1), Ascii::Dot);
        let first = wrapping_add(wrapping_add(p, 2), zeros);
        for z in 0..zeros {
            out.try_set(wrapping_add(wrapping_add(p, 2), z), Ascii::Zero);
        }
        let mut i = n;
        loop {
            if i == 0 {
                break;
            }
            i = wrapping_sub(i, 1);
            out
                .try_set(
                wrapping_add(first, i),
                wrapping_u8(wrapping_add(DIGIT_ZERO, v % DECIMAL_BASE))
            );
            v = v / DECIMAL_BASE;
        }
    } else if wrapping_u64(s.k) < n {
        // The point after the first k digits.
        let point = wrapping_u64(s.k);
        out.try_set(wrapping_add(p, point), Ascii::Dot);
        let mut i = n;
        loop {
            if i == 0 {
                break;
            }
            i = wrapping_sub(i, 1);
            let at_i = if i >= point {
                wrapping_add(wrapping_add(p, i), 1)
            } else {
                wrapping_add(p, i)
            };
            out.try_set(at_i, wrapping_u8(wrapping_add(DIGIT_ZERO, v % DECIMAL_BASE)));
            v = v / DECIMAL_BASE;
        }
    } else {
        // The digits, then k - n zeros.
        let k = wrapping_u64(s.k);
        for z in n..k {
            out.try_set(wrapping_add(p, z), Ascii::Zero);
        }
        let mut i = n;
        loop {
            if i == 0 {
                break;
            }
            i = wrapping_sub(i, 1);
            out
                .try_set(
                wrapping_add(p, i),
                wrapping_u8(wrapping_add(DIGIT_ZERO, v % DECIMAL_BASE))
            );
            v = v / DECIMAL_BASE;
        }
    }
}
