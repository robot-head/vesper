}

// `round_and_weed`: move the last digit down while that brings the
// candidate closer to `v`, then accept only when the result is provably
// the shortest correctly rounded one. Rust's std arithmetic wraps here, so
// every operation is a wrapping one.
fn round_and_weed(
    digits0: u64,
    n: u64,
    k: i64,
    remainder: u64,
    threshold: u64,
    plus1v: u64,
    ten_kappa: u64,
    ulp: u64
) -> Digits {
    let plus1v_down = wrapping_add(plus1v, ulp);
    let plus1v_up = wrapping_sub(plus1v, ulp);
    let mut digits = digits0;
    let mut plus1w = remainder;
    loop {
        if !(plus1w < plus1v_up && wrapping_sub(threshold, plus1w) >= ten_kappa) {
            break;
        }
        let next = wrapping_add(plus1w, ten_kappa);
        if !(next < plus1v_up || wrapping_sub(plus1v_up, plus1w) >= wrapping_sub(next, plus1v_up)) {
            break;
        }
        digits = wrapping_sub(digits, 1);
        plus1w = next;
    }
    if plus1w < plus1v_down && wrapping_sub(threshold, plus1w) >= ten_kappa {
        let next = wrapping_add(plus1w, ten_kappa);
        if next < plus1v_down
            || wrapping_sub(plus1v_down, plus1w) >= wrapping_sub(next, plus1v_down) {
            return none();
        }
    }
    if wrapping_mul(2, ulp) <= plus1w && plus1w <= wrapping_sub(threshold, wrapping_mul(4, ulp)) {
        Digits {
            ok: true,
            digits: digits,
            n: n,
            k: k
        }
    } else {
        none()
    }
}

// `format_shortest_opt` for the decoded `mant * 2^exp` with neighbors
// `mant - minus` and `mant + plus` (Rust's `flt2dec::Decoded`; the
// interval ends' inclusiveness does not matter to Grisu).
pub fn grisu_shortest(mant: u64, minus: u64, plus: u64, exp: i64) -> Digits {
    // `Fp::normalize` of mant + plus, the others normalized to its exponent.
    let s = clz64(wrapping_add(mant, plus));
    let plus_f = bit_shl(wrapping_add(mant, plus), s);
    let plus_e = wrapping_sub(exp, wrapping_i64(s));
    let minus_f = bit_shl(wrapping_sub(mant, minus), s);
    let v_f = bit_shl(mant, s);
    // `cached_power(ALPHA - plus.e - 64, GAMMA - plus.e - 64)`.
    let gamma = wrapping_sub(wrapping_sub(GAMMA, plus_e), FP_BITS);
    let idx = wrapping_mul(
        wrapping_u64(wrapping_add(gamma, CACHED_POW10_E_BIAS)),
        CACHED_POW10_STEPS
    )
        / CACHED_POW10_E_SPAN;
    let (cf, ce) = cached_pow10(idx);
    let minusk = wrapping_sub(
        wrapping_mul(CACHED_POW10_K_STEP, wrapping_i64(idx)),
        CACHED_POW10_K_BIAS
    );
    let plus_m = fp_mul(plus_f, cf);
    let minus_m = fp_mul(minus_f, cf);
    let v_m = fp_mul(v_f, cf);
    let e = wrapping_u64(wrapping_sub(0, wrapping_add(wrapping_add(plus_e, ce), FP_BITS)));
    let plus1 = wrapping_add(plus_m, 1);
    let minus1 = wrapping_sub(minus_m, 1);
    let mask = wrapping_sub(bit_shl(1, e), 1);
    let plus1int = bit_shr(plus1, e);
    let plus1frac = plus1 & mask;
    let (max_kappa, max_ten_kappa) = max_pow10_no_more_than(plus1int);
    let k = wrapping_add(wrapping_sub(wrapping_i64(max_kappa), minusk), 1);
    let delta1 = wrapping_sub(plus1, minus1);
    let delta1frac = delta1 & mask;
    let plus1v = wrapping_sub(plus1, v_m);
    // The integral part, one digit per power of ten.
    let mut digits: u64 = 0;
    let mut i: u64 = 0;
    let mut kappa = max_kappa;
    let mut ten_kappa = max_ten_kappa;
    let mut remainder = plus1int;
    loop {
        let (q, r) = div_pow10(remainder, kappa);
        digits = wrapping_add(wrapping_mul(digits, DECIMAL_BASE), q);
        i = wrapping_add(i, 1);
        let plus1rem = wrapping_add(bit_shl(r, e), plus1frac);
        if plus1rem < delta1 {
            return round_and_weed(digits, i, k, plus1rem, delta1, plus1v, bit_shl(ten_kappa, e), 1);
        }
        if i > max_kappa {
            break;
        }
        kappa = wrapping_sub(kappa, 1);
        ten_kappa = ten_kappa / DECIMAL_BASE;
        remainder = r;
    }
    // The fractional part, scaled by ten per digit.
    let mut remainder = plus1frac;
    let mut threshold = delta1frac;
    let mut ulp: u64 = 1;
    loop {
        remainder = wrapping_mul(remainder, DECIMAL_BASE);
        threshold = wrapping_mul(threshold, DECIMAL_BASE);
        ulp = wrapping_mul(ulp, DECIMAL_BASE);
        let q = bit_shr(remainder, e);
        let r = remainder & mask;
        digits = wrapping_add(wrapping_mul(digits, DECIMAL_BASE), q);
        i = wrapping_add(i, 1);
        if r < threshold {
            return round_and_weed(
                digits,
                i,
                k,
                r,
                threshold,
                wrapping_mul(plus1v, ulp),
                bit_shl(1, e),
                ulp
            );
        }
        if i > MAX_SIG_DIGITS {
            // Unreachable by Grisu's bounds; never trust more digits.
            return none();
        }
        remainder = r;
    }
}
