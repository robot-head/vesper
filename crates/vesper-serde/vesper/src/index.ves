// @vesper/serde: the scalar recursive-descent JSON parser and tape helpers
// of src/index.rs: UTF-8 validation, the parser with its work, entry and
// limit accounting, duplicate-key checks, JSON escapes, decoded string
// comparison and decoding, and schema-directed field lookup.
use self::{
    Doc,
    Error,
    ErrorKind,
    Kind,
    Limits,
    Token
};
use self::ascii::{
    Ascii,
    Utf8
};

// `at` past the end: no byte has this value.
const NO_BYTE: u64 = 256;
// The decoders' end-of-string mark: one past the last code point.
const NO_CHAR: u64 = 0x110000;
const U64_MAX: u64 = 0xffffffffffffffff;
// UTF-8 (Unicode Table 3-7).
// Tag bits of 2-, 3- and 4-byte leads, and the payload masks of a
// continuation byte and of each lead.
// The first code point that needs 2, 3 and 4 bytes.
// Any byte of a word with its high bit set is not ASCII.
const ASCII_WORD_HIGH_BITS: u64 = 0x8080808080808080;
const WORD_BYTES: u64 = 8;
// UTF-16 surrogates.
const HIGH_SURROGATE_FIRST: u64 = 0xd800;
const HIGH_SURROGATE_LAST: u64 = 0xdbff;
const LOW_SURROGATE_FIRST: u64 = 0xdc00;
const LOW_SURROGATE_LAST: u64 = 0xdfff;
const SURROGATE_BITS: u64 = 10;
// `\uXXXX`: four hex digits.
const HEX_ESCAPE_DIGITS: u64 = 4;
const HEX_BASE: u64 = 16;
// `hex_digit` for a byte that is not one.
const NOT_HEX: u64 = 16;
// 'a' - 10 and 'A' - 10.
const HEX_LOWER_OFFSET: u64 = 0x57;
const HEX_UPPER_OFFSET: u64 = 0x37;
// Control characters JSON names with a letter escape.
// Work units per character compared in a duplicate-key or field-name
// check (src/index.rs).
const COMPARE_STEP_WORK: u64 = 24;
// U64_MAX / COMPARE_STEP_WORK: more steps would overflow the work count.
const MAX_COMPARE_STEPS: u64 = 768614336404564650;
// src/index.rs `TOKEN_BYTES`, and the bytes of one stage 1 entry
// (`size_of::<u32>()`).
const TOKEN_BYTES: u64 = 48;
const ENTRY_BYTES: u64 = 4;

pub fn raise(kind: ErrorKind, offset: u64) -> Unit eff [Fail[Error]] {
    Fail::raise(
        Error {
            kind: kind,
            offset: offset
        }
    )
}

// src/index.rs `HARD_DEPTH`.
pub fn hard_depth() -> u64 {
    128
}

// Logical bytes of one tape token: `size_of::<Token>()` in the Rust build,
// which every limit and statistic is stated in.
pub fn token_bytes() -> u64 {
    TOKEN_BYTES
}

pub fn min64(a: u64, b: u64) -> u64 {
    if a < b {
        a
    } else {
        b
    }
}

// The byte at `p`, or 256 past the end.
pub fn at(in t: Slice[u8], p: u64) -> u64 {
    match t.try_get(p) {
        Option::Some(b) => widen_u64(b),
        Option::None => NO_BYTE,
    }
}

pub fn tok(in toks: ChunkSeq[Token], i: u64) -> Token {
    match toks.try_get(i) {
        Option::Some(t) => t,
        Option::None => Token {
            start: 0,
            end: 0,
            next: 0,
            kind: Kind::Null,
            decoded_len: 0,
            escaped: false,
            depth: 0
        },
    }
}

// -------------------------------------------------------------------
// UTF-8 (`core::str::from_utf8`): the offset of the first byte of the
// first invalid sequence in `t[from..to]`, or `to`.
// -------------------------------------------------------------------

fn cont(in t: Slice[u8], p: u64, to: u64) -> bool {
    p < to && at(in t, p) & Utf8::ContMask == Utf8::Cont
}

fn in_range(in t: Slice[u8], p: u64, to: u64, lo: u64, hi: u64) -> bool {
    if p >= to {
        return false;
    }
    let b = at(in t, p);
    b >= lo && b <= hi
}

pub fn utf8_valid_up_to(in t: Slice[u8], from: u64, to: u64) -> u64 {
    let mut p = from;
    loop {
        // Eight ASCII bytes at a time.
        loop {
            if wrapping_add(p, WORD_BYTES) > to {
                break;
            }
            match t.try_read_u64_le(p) {
                Option::Some(w) => {
                    if w & ASCII_WORD_HIGH_BITS != 0 {
                        break;
                    }
                    p = wrapping_add(p, WORD_BYTES);
                },
                Option::None => break,
            }
        }
        if p >= to {
            return to;
        }
        let b = at(in t, p);
        if b < Utf8::TwoByteMin {
            p = wrapping_add(p, 1);
        } else if b >= Utf8::Lead2Lo && b <= Utf8::Lead2Hi {
            if !cont(in t, wrapping_add(p, 1), to) {
                return p;
            }
            p = wrapping_add(p, 2);
        } else if b >= Utf8::Lead3Lo && b <= Utf8::Lead3Hi {
            let ok1 = if b == Utf8::Lead3Lo {
                in_range(in t, wrapping_add(p, 1), to, Utf8::E0SecondLo, Utf8::ContHi)
            } else if b == Utf8::SurrogateLead {
                in_range(in t, wrapping_add(p, 1), to, Utf8::Cont, Utf8::EdSecondHi)
            } else {
                cont(in t, wrapping_add(p, 1), to)
            };
            if !ok1 || !cont(in t, wrapping_add(p, 2), to) {
                return p;
            }
            p = wrapping_add(p, 3);
        } else if b >= Utf8::Lead4Lo && b <= Utf8::Lead4Hi {
            let ok1 = if b == Utf8::Lead4Lo {
                in_range(in t, wrapping_add(p, 1), to, Utf8::F0SecondLo, Utf8::ContHi)
            } else if b == Utf8::Lead4Hi {
                in_range(in t, wrapping_add(p, 1), to, Utf8::Cont, Utf8::F4SecondHi)
            } else {
                cont(in t, wrapping_add(p, 1), to)
            };
            if !ok1 || !cont(in t, wrapping_add(p, 2), to) || !cont(in t, wrapping_add(p, 3), to) {
                return p;
            }
            p = wrapping_add(p, 4);
        } else {
            return p;
        }
    }
    to
}

// The Unicode scalar starting at `p` of valid UTF-8, and its length.
pub fn utf8_char(in t: Slice[u8], p: u64) -> (u64, u64) {
    let b = at(in t, p);
    if b < Utf8::TwoByteMin {
        (b, 1)
    } else if b < Utf8::Lead3Lo {
        (((b & Utf8::Lead2Payload) << 6) | (at(in t, wrapping_add(p, 1)) & Utf8::ContPayload), 2)
    } else if b < Utf8::Lead4Lo {
        (
            ((b & Utf8::Lead3Payload) << 12) | (
                (at(in t, wrapping_add(p, 1)) & Utf8::ContPayload) << 6
            ) | (at(in t, wrapping_add(p, 2)) & Utf8::ContPayload),
            3
        )
    } else {
        (
            ((b & Utf8::Lead4Payload) << 18) | (
                (at(in t, wrapping_add(p, 1)) & Utf8::ContPayload) << 12
            ) | ((at(in t, wrapping_add(p, 2)) & Utf8::ContPayload) << 6) | (
                at(in t, wrapping_add(p, 3)) & Utf8::ContPayload
            ),
            4
        )
    }
}

pub fn utf8_len(c: u64) -> u64 {
    if c < Utf8::TwoByteMin {
        1
    } else if c < Utf8::ThreeByteMin {
        2
    } else if c < Utf8::FourByteMin {
        3
    } else {
        4
    }
}

// -------------------------------------------------------------------
// Escapes (`escape_with`). The body after a backslash at `pos`; `err` is
// 0 on success, else the error kind (1 Escape, 2 AllocationLimit) at `at`.
// `mode` charges the backslash of a surrogate pair's low half: 0 not at
// all, 1 against `budget` stage 1 entries (the scalar parser), 2 failing
// when it is at or after the truncation position `budget` (stage 2).
// -------------------------------------------------------------------

pub copy struct Esc {
    code: u64,
    pos: u64,
    err: u64,
    at: u64,
    budget: u64
}

fn esc_fail(kind: u64, at: u64, budget: u64) -> Esc {
    Esc {
        code: 0,
        pos: 0,
        err: kind,
        at: at,
        budget: budget
    }
}

fn hex_digit(b: u64) -> u64 {
    if b >= Ascii::Zero && b <= Ascii::Nine {
        wrapping_sub(b, Ascii::Zero)
    } else if b >= Ascii::LowerA && b <= Ascii::LowerF {
        wrapping_sub(b, HEX_LOWER_OFFSET)
    } else if b >= Ascii::UpperA && b <= Ascii::UpperF {
        wrapping_sub(b, HEX_UPPER_OFFSET)
    } else {
        NOT_HEX
    }
}

// Four hex digits at `p`: (value, error position or 2^64 - 1).
fn hex4(in t: Slice[u8], p: u64) -> (u64, u64) {
    let mut n: u64 = 0;
    for k in 0..HEX_ESCAPE_DIGITS {
        let q = wrapping_add(p, k);
        let b = at(in t, q);
        if b == NO_BYTE {
            return (0, q);
        }
        let d = hex_digit(b);
        if d == NOT_HEX {
            return (0, q);
        }
        n = wrapping_add(wrapping_mul(n, HEX_BASE), d);
    }
    (n, U64_MAX)
}

pub fn escape_body(in t: Slice[u8], pos0: u64, mode: u64, budget0: u64) -> Esc {
    let mut budget = budget0;
    let b = at(in t, pos0);
    if b == NO_BYTE {
        return esc_fail(1, pos0, budget);
    }
    let mut pos = wrapping_add(pos0, 1);
    let code: u64 = if b == Ascii::Quote {
        Ascii::Quote
    } else if b == Ascii::Backslash {
        Ascii::Backslash
    } else if b == Ascii::Slash {
        Ascii::Slash
    } else if b == Ascii::LowerB {
        Ascii::Backspace
    } else if b == Ascii::LowerF {
        Ascii::Ff
    } else if b == Ascii::LowerN {
        Ascii::Lf
    } else if b == Ascii::LowerR {
        Ascii::Cr
    } else if b == Ascii::LowerT {
        Ascii::Tab
    } else if b == Ascii::LowerU {
        let (hi, bad) = hex4(in t, pos);
        if bad != U64_MAX {
            return esc_fail(1, bad, budget);
        }
        pos = wrapping_add(pos, HEX_ESCAPE_DIGITS);
        if hi >= HIGH_SURROGATE_FIRST && hi <= HIGH_SURROGATE_LAST {
            if at(in t, pos) == Ascii::Backslash {
                if mode == 1 {
                    if budget == 0 {
                        return esc_fail(2, pos, budget);
                    }
                    budget = wrapping_sub(budget, 1);
                } else if mode == 2 && pos >= budget {
                    return esc_fail(2, budget, budget);
                }
            }
            if at(in t, pos) != Ascii::Backslash
                || at(in t, wrapping_add(pos, 1)) != Ascii::LowerU {
                return esc_fail(1, pos, budget);
            }
            pos = wrapping_add(pos, 2);
            let (lo, bad2) = hex4(in t, pos);
            if bad2 != U64_MAX {
                return esc_fail(1, bad2, budget);
            }
            pos = wrapping_add(pos, HEX_ESCAPE_DIGITS);
            if lo < LOW_SURROGATE_FIRST || lo > LOW_SURROGATE_LAST {
                return esc_fail(1, wrapping_sub(pos, HEX_ESCAPE_DIGITS), budget);
            }
            wrapping_sub(
                wrapping_add(
                    wrapping_add(
                        Utf8::FourByteMin,
                        wrapping_sub(hi, HIGH_SURROGATE_FIRST) << SURROGATE_BITS
                    ),
                    lo
                ),
                LOW_SURROGATE_FIRST
            )
        } else {
            if hi >= LOW_SURROGATE_FIRST && hi <= LOW_SURROGATE_LAST {
                // A lone low surrogate is not a Unicode scalar.
                return esc_fail(1, pos, budget);
            }
            hi
        }
    } else {
        return esc_fail(1, pos0, budget);
    };
    Esc {
        code: code,
        pos: pos,
        err: 0,
        at: 0,
        budget: budget
    }
}

// The next decoded scalar of validated string content `t[pos..end]`, and
// the position after it; scalar NO_CHAR at the end.
pub fn next_decoded(in t: Slice[u8], pos: u64, end: u64) -> (u64, u64) {
    if pos >= end {
        return (NO_CHAR, pos);
    }
    let (c, n) = utf8_char(in t, pos);
    let after = wrapping_add(pos, n);
    if c != Ascii::Backslash {
        return (c, after);
    }
    let e = escape_body(in t, after, 0, 0);
    (e.code, e.pos)
}

// The next scalar of plain UTF-8 `t[pos..end]`; NO_CHAR at the end.
pub fn next_plain(in t: Slice[u8], pos: u64, end: u64) -> (u64, u64) {
    if pos >= end {
        return (NO_CHAR, pos);
    }
    let (c, n) = utf8_char(in t, pos);
    (c, wrapping_add(pos, n))
}

pub fn strings_equal(in raw: Slice[u8], in text: Slice[u8]) -> bool {
    let n = raw.len();
    let m = text.len();
    let mut a: u64 = 0;
    let mut b: u64 = 0;
    loop {
        let (x, a2) = next_decoded(in raw, a, n);
        let (y, b2) = next_plain(in text, b, m);
        if x != y {
            return false;
        }
        if x == NO_CHAR {
            return true;
        }
        a = a2;
        b = b2;
    }
    true
}

// UTF-8 encode `c` at `scratch[pos..]`; returns the position after it.
pub fn put_utf8(inout out: Slice[u8], pos: u64, c: u64) -> u64 {
    if c < Utf8::TwoByteMin {
        out.try_set(pos, wrapping_u8(c));
        wrapping_add(pos, 1)
    } else if c < Utf8::ThreeByteMin {
        out.try_set(pos, wrapping_u8(Utf8::Lead2Tag | (c >> 6)));
        out.try_set(wrapping_add(pos, 1), wrapping_u8(Utf8::Cont | (c & Utf8::ContPayload)));
        wrapping_add(pos, 2)
    } else if c < Utf8::FourByteMin {
        out.try_set(pos, wrapping_u8(Utf8::Lead3Tag | (c >> 12)));
        out.try_set(wrapping_add(pos, 1), wrapping_u8(Utf8::Cont | ((c >> 6) & Utf8::ContPayload)));
        out.try_set(wrapping_add(pos, 2), wrapping_u8(Utf8::Cont | (c & Utf8::ContPayload)));
        wrapping_add(pos, 3)
    } else {
        out.try_set(pos, wrapping_u8(Utf8::Lead4Tag | (c >> 18)));
        out
            .try_set(
                wrapping_add(pos, 1),
                wrapping_u8(Utf8::Cont | ((c >> 12) & Utf8::ContPayload))
            );
        out.try_set(wrapping_add(pos, 2), wrapping_u8(Utf8::Cont | ((c >> 6) & Utf8::ContPayload)));
        out.try_set(wrapping_add(pos, 3), wrapping_u8(Utf8::Cont | (c & Utf8::ContPayload)));
        wrapping_add(pos, 4)
    }
}

pub fn decode_into(in raw: Slice[u8], inout scratch: Slice[u8]) -> u64 {
    let n = raw.len();
    let mut a: u64 = 0;
    let mut pos: u64 = 0;
    loop {
        let (c, a2) = next_decoded(in raw, a, n);
        if c == NO_CHAR {
            break;
        }
        pos = put_utf8(inout scratch, pos, c);
        a = a2;
    }
    pos
}

// -------------------------------------------------------------------
// Duplicate keys (`check_duplicate`, shared with stage 2).
// -------------------------------------------------------------------

fn work_tick(inout work: u64, amount: u64, max_work: u64, at: u64) -> Unit eff [Fail[Error]] {
    if amount > wrapping_sub(U64_MAX, work) {
        raise(ErrorKind::WorkLimit, at);
    }
    work = wrapping_add(work, amount);
    if work > max_work {
        raise(ErrorKind::WorkLimit, at);
    }
}

// Steps of the decoded comparison loop on two unescaped UTF-8 keys
// `t[a0..a1]` and `t[b0..b1]`: one per equal scalar, plus one.
fn raw_compare_steps(in t: Slice[u8], a0: u64, a1: u64, b0: u64, b1: u64) -> u64 {
    let la = wrapping_sub(a1, a0);
    let lb = wrapping_sub(b1, b0);
    let shorter = min64(la, lb);
    let mut k: u64 = 0;
    loop {
        if k >= shorter {
            break;
        }
        if at(in t, wrapping_add(a0, k)) != at(in t, wrapping_add(b0, k)) {
            break;
        }
        k = wrapping_add(k, 1);
    }
    let mut boundary = k;
    loop {
        if boundary == 0 || boundary >= shorter {
            break;
        }
        if at(in t, wrapping_add(a0, boundary)) & Utf8::ContMask != Utf8::Cont {
            break;
        }
        boundary = wrapping_sub(boundary, 1);
    }
    let mut steps: u64 = 1;
    for i in 0..boundary {
        if at(in t, wrapping_add(a0, i)) & Utf8::ContMask != Utf8::Cont {
            steps = wrapping_add(steps, 1);
        }
    }
    steps
}

pub fn check_duplicate(
    in toks: ChunkSeq[Token],
    in t: Slice[u8],
    start: u64,
    current: u64,
    inout work: u64,
    max_work: u64,
    at_pos: u64
) -> Unit eff [Fail[Error]] {
    let y = tok(in toks, current);
    let mut previous = start;
    loop {
        if previous >= current {
            break;
        }
        work_tick(inout work, 1, max_work, at_pos);
        let x = tok(in toks, previous);
        if !x.escaped && !y.escaped {
            let a0 = wrapping_add(x.start, 1);
            let a1 = wrapping_sub(x.end, 1);
            let b0 = wrapping_add(y.start, 1);
            let b1 = wrapping_sub(y.end, 1);
            let steps = raw_compare_steps(in t, a0, a1, b0, b1);
            if steps > MAX_COMPARE_STEPS {
                raise(ErrorKind::WorkLimit, at_pos);
            }
            let units = wrapping_mul(steps, COMPARE_STEP_WORK);
            if units > wrapping_sub(max_work, work) {
                raise(ErrorKind::WorkLimit, at_pos);
            }
            work_tick(inout work, units, max_work, at_pos);
            let la = wrapping_sub(a1, a0);
            if la == wrapping_sub(b1, b0) {
                // Equal lengths: equal exactly when the common prefix is all.
                let mut same = true;
                for k in 0..la {
                    if at(in t, wrapping_add(a0, k)) != at(in t, wrapping_add(b0, k)) {
                        same = false;
                        break;
                    }
                }
                if same {
                    raise(ErrorKind::DuplicateKey, at_pos);
                }
            }
        } else {
            let ae = wrapping_sub(x.end, 1);
            let be = wrapping_sub(y.end, 1);
            let mut a = wrapping_add(x.start, 1);
            let mut b = wrapping_add(y.start, 1);
            let mut units: u64 = 0;
            let mut equal = false;
            loop {
                units = wrapping_add(units, COMPARE_STEP_WORK);
                // Enforce while comparing, not after an unbounded key scan.
                if units > wrapping_sub(max_work, work) {
                    raise(ErrorKind::WorkLimit, at_pos);
                }
                let (p, a2) = next_decoded(in t, a, ae);
                let (q, b2) = next_decoded(in t, b, be);
                if p != q {
                    break;
                }
                if p == NO_CHAR {
                    equal = true;
                    break;
                }
                a = a2;
                b = b2;
            }
            work_tick(inout work, units, max_work, at_pos);
            if equal {
                raise(ErrorKind::DuplicateKey, at_pos);
            }
        }
        previous = tok(in toks, wrapping_add(previous, 1)).next;
    }
}

// -------------------------------------------------------------------
// The recursive-descent parser (`Parser`).
// -------------------------------------------------------------------

copy struct P {
    pos: u64,
    capacity: u64,
    work: u64,
    string_bytes: u64,
    entries_left: u64,
    lim: Limits
}

fn perr(in p: P, kind: ErrorKind) -> Unit eff [Fail[Error]] {
    raise(kind, p.pos)
}

// Charge one stage 1 entry at the current position.
fn entry(inout p: P) -> Unit eff [Fail[Error]] {
    if p.entries_left == 0 {
        perr(in p, ErrorKind::AllocationLimit);
    }
    p.entries_left = wrapping_sub(p.entries_left, 1);
}

fn tick(inout p: P, amount: u64) -> Unit eff [Fail[Error]] {
    if amount > wrapping_sub(U64_MAX, p.work) {
        perr(in p, ErrorKind::WorkLimit);
    }
    p.work = wrapping_add(p.work, amount);
    if p.work > p.lim.max_work {
        perr(in p, ErrorKind::WorkLimit);
    }
}

fn step(inout p: P) -> Unit eff [Fail[Error]] {
    tick(inout p, 1);
    p.pos = wrapping_add(p.pos, 1);
}

fn expect(inout p: P, in t: Slice[u8], b: u64) -> Unit eff [Fail[Error]] {
    if at(in t, p.pos) != b {
        perr(in p, ErrorKind::Syntax);
    }
    step(inout p);
}

// An operator byte: syntax first, then its index entry, then the step.
fn op(inout p: P, in t: Slice[u8], b: u64) -> Unit eff [Fail[Error]] {
    if at(in t, p.pos) != b {
        perr(in p, ErrorKind::Syntax);
    }
    entry(inout p);
    step(inout p);
}

fn ws(inout p: P, in t: Slice[u8]) -> Unit eff [Fail[Error]] {
    loop {
        let b = at(in t, p.pos);
        if b == Ascii::Space || b == Ascii::Cr || b == Ascii::Lf || b == Ascii::Tab {
            step(inout p);
        } else {
            break;
        }
    }
}

fn push(inout p: P, inout toks: ChunkSeq[Token], kind: Kind, depth: u64) -> u64 eff [Fail[Error]] {
    let n = toks.len();
    if n >= p.lim.max_tokens {
        perr(in p, ErrorKind::TokenLimit);
    }
    if n >= p.capacity {
        perr(in p, ErrorKind::AllocationLimit);
    }
    toks
        .push(
            Token {
                start: p.pos,
                end: 0,
                next: wrapping_add(n, 1),
                kind: kind,
                decoded_len: 0,
                escaped: false,
                depth: depth
            }
        );
    n
}

fn is_digit(b: u64) -> bool {
    b >= Ascii::Zero && b <= Ascii::Nine
}

fn digits(inout p: P, in t: Slice[u8]) -> Unit eff [Fail[Error]] {
    loop {
        if !is_digit(at(in t, p.pos)) {
            break;
        }
        step(inout p);
    }
}

fn number(inout p: P, in t: Slice[u8]) -> Unit eff [Fail[Error]] {
    if at(in t, p.pos) == Ascii::Minus {
        step(inout p);
    }
    let b = at(in t, p.pos);
    if b == Ascii::Zero {
        step(inout p);
    } else if b >= Ascii::One && b <= Ascii::Nine {
        step(inout p);
        digits(inout p, in t);
    } else {
        perr(in p, ErrorKind::Number);
    }
    if at(in t, p.pos) == Ascii::Dot {
        step(inout p);
        if !is_digit(at(in t, p.pos)) {
            perr(in p, ErrorKind::Number);
        }
        digits(inout p, in t);
    }
    let e = at(in t, p.pos);
    if e == Ascii::LowerE || e == Ascii::UpperE {
        step(inout p);
        let s = at(in t, p.pos);
        if s == Ascii::Plus || s == Ascii::Minus {
            step(inout p);
        }
        if !is_digit(at(in t, p.pos)) {
            perr(in p, ErrorKind::Number);
        }
        digits(inout p, in t);
    }
}

fn string(inout p: P, inout toks: ChunkSeq[Token], in t: Slice[u8], index: u64)
    -> Unit eff [Fail[Error]] {
    expect(inout p, in t, Ascii::Quote);
    let mut decoded: u64 = 0;
    let mut escaped = false;
    loop {
        let b = at(in t, p.pos);
        if b == Ascii::Quote {
            entry(inout p);
            step(inout p);
            break;
        } else if b == Ascii::Backslash {
            escaped = true;
            entry(inout p);
            step(inout p);
            let old = p.pos;
            let e = escape_body(in t, p.pos, 1, p.entries_left);
            if e.err == 1 {
                raise(ErrorKind::Escape, e.at);
            } else if e.err == 2 {
                raise(ErrorKind::AllocationLimit, e.at);
            }
            p.entries_left = e.budget;
            p.pos = e.pos;
            let consumed = wrapping_sub(p.pos, old);
            tick(inout p, consumed);
            decoded = wrapping_add(decoded, utf8_len(e.code));
        } else if b < Ascii::Space || b == NO_BYTE {
            perr(in p, ErrorKind::Syntax);
        } else {
            step(inout p);
            decoded = wrapping_add(decoded, 1);
        }
        if decoded > p.lim.max_string_bytes {
            perr(in p, ErrorKind::StringLimit);
        }
    }
    p.string_bytes = wrapping_add(p.string_bytes, decoded);
    if p.string_bytes > p.lim.max_total_string_bytes {
        perr(in p, ErrorKind::StringLimit);
    }
    let mut tk = tok(in toks, index);
    tk.decoded_len = decoded;
    tk.escaped = escaped;
    toks.try_set(index, tk);
}

fn literal(inout p: P, in t: Slice[u8], kind: u64) -> Unit eff [Fail[Error]] {
    if kind == 0 {
        expect(inout p, in t, Ascii::LowerN);
        expect(inout p, in t, Ascii::LowerU);
        expect(inout p, in t, Ascii::LowerL);
        expect(inout p, in t, Ascii::LowerL);
    } else if kind == 1 {
        expect(inout p, in t, Ascii::LowerT);
        expect(inout p, in t, Ascii::LowerR);
        expect(inout p, in t, Ascii::LowerU);
        expect(inout p, in t, Ascii::LowerE);
    } else {
        expect(inout p, in t, Ascii::LowerF);
        expect(inout p, in t, Ascii::LowerA);
        expect(inout p, in t, Ascii::LowerL);
        expect(inout p, in t, Ascii::LowerS);
        expect(inout p, in t, Ascii::LowerE);
    }
}

fn container(
    inout p: P,
    inout toks: ChunkSeq[Token],
    in t: Slice[u8],
    index: u64,
    depth: u64,
    object: bool
) -> Unit eff [Fail[Error]] {
    step(inout p);
    ws(inout p, in t);
    let close: u64 = if object {
        Ascii::Rbrace
    } else {
        Ascii::Rbracket
    };
    if at(in t, p.pos) == close {
        op(inout p, in t, close);
        return ();
    }
    loop {
        if object {
            if at(in t, p.pos) != Ascii::Quote {
                perr(in p, ErrorKind::Syntax);
            }
            let key = toks.len();
            value(inout p, inout toks, in t, wrapping_add(depth, 1));
            let here = p.pos;
            let max_work = p.lim.max_work;
            let mut work = p.work;
            check_duplicate(in toks, in t, wrapping_add(index, 1), key, inout work, max_work, here);
            p.work = work;
            ws(inout p, in t);
            op(inout p, in t, Ascii::Colon);
            ws(inout p, in t);
        }
        value(inout p, inout toks, in t, wrapping_add(depth, 1));
        ws(inout p, in t);
        if at(in t, p.pos) == close {
            op(inout p, in t, close);
            return ();
        }
        op(inout p, in t, Ascii::Comma);
        ws(inout p, in t);
    }
}

fn value(inout p: P, inout toks: ChunkSeq[Token], in t: Slice[u8], depth: u64)
    -> Unit eff [Fail[Error]] {
    let b = at(in t, p.pos);
    let kind = if b == Ascii::LowerN {
        Kind::Null
    } else if b == Ascii::LowerT || b == Ascii::LowerF {
        Kind::Bool
    } else if b == Ascii::Minus || is_digit(b) {
        Kind::Number
    } else if b == Ascii::Quote {
        Kind::String
    } else if b == Ascii::Lbracket {
        Kind::Array
    } else if b == Ascii::Lbrace {
        Kind::Object
    } else {
        perr(in p, ErrorKind::Syntax);
        Kind::Null
    };
    let nested = b == Ascii::Lbracket || b == Ascii::Lbrace;
    if nested && (depth >= p.lim.max_depth || depth >= hard_depth()) {
        perr(in p, ErrorKind::DepthLimit);
    }
    let index = push(inout p, inout toks, kind, depth);
    entry(inout p);
    if b == Ascii::LowerN {
        literal(inout p, in t, 0);
    } else if b == Ascii::LowerT {
        literal(inout p, in t, 1);
    } else if b == Ascii::LowerF {
        literal(inout p, in t, 2);
    } else if b == Ascii::Quote {
        string(inout p, inout toks, in t, index);
    } else if nested {
        container(inout p, inout toks, in t, index, depth, b == Ascii::Lbrace);
    } else {
        number(inout p, in t);
    }
    let mut tk = tok(in toks, index);
    tk.end = p.pos;
    tk.next = toks.len();
    toks.try_set(index, tk);
}

// `IndexPlan::new`: (tape capacity in tokens, stage 1 entries allowed).
pub fn index_plan(len: u64, lim: Limits) -> (u64, u64) {
    let capacity = min64(min64(len, lim.max_tokens), lim.max_index_bytes / TOKEN_BYTES);
    let entries = wrapping_sub(lim.max_index_bytes, wrapping_mul(capacity, token_bytes()))
        / ENTRY_BYTES;
    (capacity, entries)
}

pub fn doc_clear(inout doc: Doc) {
    doc.tokens.clear();
    doc.capacity = 0;
    doc.work = 0;
    doc.entries = 0;
}

// Make room for `capacity` tokens (`try_reserve_exact` on a cleared tape):
// the tape's reserved capacity only grows.
pub fn doc_reserve(inout doc: Doc, capacity: u64) {
    doc.tokens.clear();
    if doc.capacity < capacity {
        doc.tokens = ChunkSeq::with_capacity(capacity);
        doc.capacity = capacity;
    }
    doc.work = 0;
    doc.entries = 0;
}

pub fn parse_document(inout doc: Doc, in input: Slice[u8], lim: Limits) -> Unit eff [Fail[Error]] {
    let n = input.len();
    if n > lim.max_input_bytes {
        raise(ErrorKind::InputLimit, 0);
    }
    if n > lim.max_work {
        raise(ErrorKind::WorkLimit, 0);
    }
    let valid = utf8_valid_up_to(in input, 0, n);
    if valid != n {
        raise(ErrorKind::Utf8, valid);
    }
    let (capacity, entries) = index_plan(n, lim);
    doc_reserve(inout doc, capacity);
    let mut p = P {
        pos: 0,
        capacity: capacity,
        work: n,
        string_bytes: 0,
        entries_left: entries,
        lim: lim
    };
    ws(inout p, in input);
    value(inout p, inout doc.tokens, in input, 0);
    ws(inout p, in input);
    if p.pos != n {
        perr(in p, ErrorKind::Syntax);
    }
    doc.work = p.work;
    doc.entries = wrapping_sub(entries, p.entries_left);
}

// -------------------------------------------------------------------
// `Node::field`: schema-directed lookup with its own work allowance.
// -------------------------------------------------------------------

pub fn field_lookup(in doc: Doc, in input: Slice[u8], index: u64, in key: Slice[u8], max_work: u64)
    -> Option[u64] eff [Fail[Error]] {
    let obj = tok(in doc.tokens, index);
    if obj.kind != Kind::Object {
        raise(ErrorKind::Type, obj.start);
    }
    let kn = key.len();
    let mut work = max_work;
    let mut i = wrapping_add(index, 1);
    loop {
        if i >= obj.next {
            break;
        }
        let name = tok(in doc.tokens, i);
        let value_index = wrapping_add(i, 1);
        let end = wrapping_sub(name.end, 1);
        let mut a = wrapping_add(name.start, 1);
        let mut b: u64 = 0;
        loop {
            if work < COMPARE_STEP_WORK {
                raise(ErrorKind::WorkLimit, obj.start);
            }
            work = wrapping_sub(work, COMPARE_STEP_WORK);
            let (x, a2) = next_decoded(in input, a, end);
            let (y, b2) = next_plain(in key, b, kn);
            if x == NO_CHAR && y == NO_CHAR {
                return Option::Some(value_index);
            }
            if x != y || x == NO_CHAR || y == NO_CHAR {
                break;
            }
            a = a2;
            b = b2;
        }
        i = tok(in doc.tokens, value_index).next;
    }
    Option::None
}
