// @vesper/serde: the binary host codecs of src/streamvbyte.rs (raw,
// non-delta 1/2/3/4-byte StreamVByte) and src/archive.rs (the VSPA tree
// archive, version 1, schema 1), with the common errors of src/binary.rs.
use self::{
    ArchiveLimits,
    BinError,
    BinErrorKind,
    Span,
    VbyteLimits
};
use self::index::utf8_valid_up_to;

// StreamVByte: four 2-bit width tags per control byte; values of 1 to 4
// little-endian bytes. Decoding charges two work units per byte.
const VALUES_PER_CONTROL: u64 = 4;
const TAG_BITS: u64 = 2;
const TAG_MASK: u64 = 3;
const MAX_VALUE_BYTES: u64 = 4;
const ONE_BYTE_LIMIT: u32 = 0x100;
const TWO_BYTE_LIMIT: u32 = 0x10000;
const THREE_BYTE_LIMIT: u32 = 0x1000000;
const DECODE_WORK_PER_BYTE: u64 = 2;
const BYTE_MASK: u64 = 0xff;
// The VSPA archive (src/archive.rs): the header fields.
const MAGIC_V: u64 = 0x56;
const MAGIC_S: u64 = 0x53;
const MAGIC_P: u64 = 0x50;
const MAGIC_A: u64 = 0x41;
const VERSION: u64 = 1;
const TREE_SCHEMA: u64 = 1;
const HDR_VERSION: u64 = 4;
const HDR_SCHEMA: u64 = 6;
const HDR_TOTAL_LEN: u64 = 8;
const HDR_NODE_COUNT: u64 = 12;
const HDR_ROOT: u64 = 16;
const HDR_NODES: u64 = 20;
const HDR_NODES_COUNT: u64 = 24;
const HDR_RESERVED: u64 = 28;
// The root and the node array both start right after the header:
// HEADER_LEN - HDR_ROOT and HEADER_LEN - HDR_NODES.
const ROOT_RELATIVE: u64 = 16;
const NODES_RELATIVE: u64 = 12;
// Node fields, after the u32 id, then three reserved words (20, 24, 28).
const NODE_LABEL: u64 = 4;
const NODE_LABEL_COUNT: u64 = 8;
const NODE_CHILDREN: u64 = 12;
const NODE_CHILD_COUNT: u64 = 16;
const NODE_RESERVED_FIRST: u64 = 20;
const NODE_RESERVED_LAST: u64 = 28;
// Relative pointers and child entries are 4-byte aligned i32s; a slice
// field is pointer plus count.
const REL_BYTES: u64 = 4;
const REL_SLICE_BYTES: u64 = 8;
const ALIGN_MASK: u64 = 0xfffffffffffffffc;
// Words per flattened input node: id, label offset and length, children
// offset and count.
const NODE_WORDS: u64 = 5;
const NODE_LABEL_OFF_WORD: u64 = 1;
const NODE_LABEL_LEN_WORD: u64 = 2;
const NODE_CHILD_OFF_WORD: u64 = 3;
const NODE_CHILD_COUNT_WORD: u64 = 4;
// Validation charges per edge, and keeps two metadata words per node.
const EDGE_WORK: u64 = 8;
const META_WORDS: u64 = 2;
const U32_MAX: u64 = 0xffffffff;

fn raise(kind: BinErrorKind, offset: u64) -> Unit eff [Fail[BinError]] {
    Fail::raise(
        BinError {
            kind: kind,
            offset: offset
        }
    )
}

fn max64() -> u64 {
    0xffffffffffffffff
}

fn add(a: u64, b: u64) -> u64 eff [Fail[BinError]] {
    if b > wrapping_sub(max64(), a) {
        raise(BinErrorKind::BOverflow, 0);
    }
    wrapping_add(a, b)
}

fn mul(a: u64, b: u64) -> u64 eff [Fail[BinError]] {
    let (lo, hi) = mul_wide(a, b);
    if hi != 0 {
        raise(BinErrorKind::BOverflow, 0);
    }
    lo
}

fn bound(n: u64, max: u64, kind: BinErrorKind) -> Unit eff [Fail[BinError]] {
    if n > max {
        raise(kind, 0);
    }
}

fn work(inout remaining: u64, units: u64) -> Unit eff [Fail[BinError]] {
    if units > remaining {
        raise(BinErrorKind::BWorkLimit, 0);
    }
    remaining = wrapping_sub(remaining, units);
}

fn byte(in s: Slice[u8], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(b) => widen_u64(b),
        Option::None => 0,
    }
}

// -------------------------------------------------------------------
// StreamVByte (src/streamvbyte.rs).
// -------------------------------------------------------------------

fn controls(count: u64) -> u64 {
    let tail: u64 = if count % VALUES_PER_CONTROL != 0 {
        1
    } else {
        0
    };
    wrapping_add(count / VALUES_PER_CONTROL, tail)
}

fn width(v: u32) -> u64 {
    if v < ONE_BYTE_LIMIT {
        1
    } else if v < TWO_BYTE_LIMIT {
        2
    } else if v < THREE_BYTE_LIMIT {
        3
    } else {
        MAX_VALUE_BYTES
    }
}

fn value_at(in values: Slice[u32], i: u64) -> u32 {
    match values.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

pub fn vbyte_max_size(count: u64) -> u64 eff [Fail[BinError]] {
    add(controls(count), mul(count, MAX_VALUE_BYTES))
}

pub fn vbyte_size(in values: Slice[u32], lim: VbyteLimits) -> u64 eff [Fail[BinError]] {
    let n = values.len();
    bound(n, lim.max_values, BinErrorKind::BCountLimit);
    let control = controls(n);
    let mut size = control;
    let mut remaining = lim.max_work;
    work(inout remaining, add(control, mul(n, 2)));
    for i in 0..n {
        let w = width(value_at(in values, i));
        work(inout remaining, wrapping_mul(w, DECODE_WORK_PER_BYTE));
        size = add(size, w);
        bound(size, lim.max_bytes, BinErrorKind::BByteLimit);
    }
    bound(size, lim.max_bytes, BinErrorKind::BByteLimit);
    size
}

pub fn vbyte_encode(in values: Slice[u32], inout out: Slice[u8], lim: VbyteLimits)
    -> u64 eff [Fail[BinError]] {
    let size = vbyte_size(in values, lim);
    if out.len() < size {
        raise(BinErrorKind::BOutputTooSmall, 0);
    }
    let n = values.len();
    let control = controls(n);
    for i in 0..control {
        out.try_set(i, 0);
    }
    let mut pos = control;
    for i in 0..n {
        let v = widen_u64(value_at(in values, i));
        let w = width(value_at(in values, i));
        let c = i / VALUES_PER_CONTROL;
        let shift = wrapping_mul(i % VALUES_PER_CONTROL, TAG_BITS);
        let tag = bit_shl(wrapping_sub(w, 1), shift);
        let old = byte(in out, c);
        out.try_set(c, wrapping_u8(old | tag));
        for k in 0..w {
            out
                .try_set(
                wrapping_add(pos, k),
                wrapping_u8(bit_shr(v, wrapping_mul(k, 8)) & BYTE_MASK)
            );
        }
        pos = wrapping_add(pos, w);
    }
    size
}

fn tag_width(in input: Slice[u8], i: u64) -> u64 {
    let shift = wrapping_mul(i % VALUES_PER_CONTROL, TAG_BITS);
    wrapping_add(bit_shr(byte(in input, i / VALUES_PER_CONTROL), shift) & TAG_MASK, 1)
}

pub fn vbyte_decode(in input: Slice[u8], count: u64, inout out: Slice[u32], lim: VbyteLimits)
    -> u64 eff [Fail[BinError]] {
    bound(count, lim.max_values, BinErrorKind::BCountLimit);
    let len = input.len();
    bound(len, lim.max_bytes, BinErrorKind::BByteLimit);
    let control = controls(count);
    if len < control {
        raise(BinErrorKind::BTruncated, len);
    }
    if out.len() < count {
        raise(BinErrorKind::BOutputTooSmall, 0);
    }
    let mut remaining = lim.max_work;
    work(inout remaining, add(control, mul(count, DECODE_WORK_PER_BYTE)));
    let mut end = control;
    for i in 0..count {
        let w = tag_width(in input, i);
        work(inout remaining, wrapping_mul(w, DECODE_WORK_PER_BYTE));
        end = add(end, w);
        if end > len {
            raise(BinErrorKind::BTruncated, len);
        }
    }
    if end != len {
        raise(BinErrorKind::BTrailingBytes, end);
    }
    let mut pos = control;
    for i in 0..count {
        let w = tag_width(in input, i);
        let mut v: u64 = 0;
        for k in 0..w {
            v = v | bit_shl(byte(in input, wrapping_add(pos, k)), wrapping_mul(k, 8));
        }
        out.try_set(i, wrapping_u32(v));
        pos = wrapping_add(pos, w);
    }
    count
}

// -------------------------------------------------------------------
// The VSPA archive (src/archive.rs).
// -------------------------------------------------------------------

// src/archive.rs `HEADER_LEN` and `NODE_LEN`.
const HEADER_BYTES: u64 = 32;
const NODE_BYTES: u64 = 32;

fn header_len() -> u64 {
    HEADER_BYTES
}

fn node_len() -> u64 {
    NODE_BYTES
}

fn i32_max() -> u64 {
    2147483647
}

// Payload bytes of one validation metadata entry (`size_of::<Meta>()`).
fn meta_bytes() -> u64 {
    16
}

pub fn archive_validation_bytes(count: u64) -> u64 eff [Fail[BinError]] {
    mul(count, meta_bytes())
}

fn is_power_of_two(n: u64) -> bool {
    n != 0 && n & wrapping_sub(n, 1) == 0
}

fn field(offset: u64, size: u64, len: u64) -> Unit eff [Fail[BinError]] {
    if offset % REL_BYTES != 0 {
        raise(BinErrorKind::BAlignment, offset);
    }
    if add(offset, size) > len {
        raise(BinErrorKind::BOffset, offset);
    }
}

fn alignment_valid(alignment: u64) -> Unit eff [Fail[BinError]] {
    if !is_power_of_two(alignment) {
        raise(BinErrorKind::BAlignment, 0);
    }
}

// `RelPtr32::resolve`.
pub fn relptr_resolve(offset: i32, field_offset: u64, size: u64, alignment: u64, archive_len: u64)
    -> Span eff [Fail[BinError]] {
    field(field_offset, REL_BYTES, archive_len);
    alignment_valid(alignment);
    let o = widen_i64(offset);
    let target = if o < 0 {
        let magnitude = wrapping_u64(wrapping_sub(0, o));
        if magnitude > field_offset {
            raise(BinErrorKind::BOffset, field_offset);
        }
        wrapping_sub(field_offset, magnitude)
    } else {
        let magnitude = wrapping_u64(o);
        if magnitude > wrapping_sub(max64(), field_offset) {
            raise(BinErrorKind::BOffset, field_offset);
        }
        wrapping_add(field_offset, magnitude)
    };
    if target & wrapping_sub(alignment, 1) != 0 {
        raise(BinErrorKind::BAlignment, field_offset);
    }
    let end = add(target, size);
    if end > archive_len {
        raise(BinErrorKind::BOffset, field_offset);
    }
    Span {
        start: target,
        end: end
    }
}

// `RelSlice32::resolve`.
pub fn relslice_resolve(
    offset: i32,
    count: u32,
    field_offset: u64,
    item_size: u64,
    alignment: u64,
    archive_len: u64
) -> Span eff [Fail[BinError]] {
    field(field_offset, REL_SLICE_BYTES, archive_len);
    alignment_valid(alignment);
    if item_size == 0 {
        raise(BinErrorKind::BLayout, field_offset);
    }
    if count == 0 {
        if offset != 0 {
            raise(BinErrorKind::BLayout, field_offset);
        }
        return Span {
            start: 0,
            end: 0
        };
    }
    relptr_resolve(offset, field_offset, mul(widen_u64(count), item_size), alignment, archive_len)
}

// `RelPtr32::between`.
pub fn relptr_between(field_offset: u64, target_offset: u64) -> i32 eff [Fail[BinError]] {
    if target_offset >= field_offset {
        let d = wrapping_sub(target_offset, field_offset);
        if d > i32_max() {
            raise(BinErrorKind::BOverflow, field_offset);
        }
        wrapping_i32(d)
    } else {
        let magnitude = wrapping_sub(field_offset, target_offset);
        if magnitude > wrapping_add(i32_max(), 1) {
            raise(BinErrorKind::BOverflow, field_offset);
        }
        wrapping_i32(wrapping_sub(0, magnitude))
    }
}

fn aligned(n: u64) -> u64 eff [Fail[BinError]] {
    add(n, wrapping_sub(REL_BYTES, 1)) & ALIGN_MASK
}

fn node_offset(index: u64) -> u64 eff [Fail[BinError]] {
    add(header_len(), mul(index, node_len()))
}

fn get_u32(in bytes: Slice[u8], offset: u64) -> u64 eff [Fail[BinError]] {
    match bytes.try_read_u32_le(offset) {
        Option::Some(v) => widen_u64(v),
        Option::None => {
            raise(BinErrorKind::BTruncated, offset);
            0
        },
    }
}

fn get_i32(in bytes: Slice[u8], offset: u64) -> i32 eff [Fail[BinError]] {
    wrapping_i32(get_u32(in bytes, offset))
}

// Validation metadata: per node, its parent count and depth.
copy struct Check {
    lim: ArchiveLimits,
    remaining: u64,
    edges: u64,
    labels: u64,
    count: u64
}

fn meta_get(in meta: ChunkSeq[u64], i: u64) -> u64 {
    match meta.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

fn check_new(count: u64, lim: ArchiveLimits, inout meta: ChunkSeq[u64])
    -> Check eff [Fail[BinError]] {
    if count == 0 {
        raise(BinErrorKind::BTree, HDR_NODE_COUNT);
    }
    bound(count, lim.max_nodes, BinErrorKind::BCountLimit);
    bound(count, U32_MAX, BinErrorKind::BOverflow);
    bound(1, lim.max_depth, BinErrorKind::BDepthLimit);
    let bytes = archive_validation_bytes(count);
    bound(bytes, lim.max_validation_bytes, BinErrorKind::BAllocationLimit);
    let mut remaining = lim.max_work;
    work(inout remaining, count);
    // Two words per node: parents, depth.
    meta = ChunkSeq::with_capacity(wrapping_mul(count, META_WORDS));
    for _i in 0..count {
        meta.push(0);
        meta.push(0);
    }
    meta.try_set(1, 1);
    Check {
        lim: lim,
        remaining: remaining,
        edges: 0,
        labels: 0,
        count: count
    }
}

fn check_label(inout c: Check, len: u64) -> Unit eff [Fail[BinError]] {
    bound(len, c.lim.max_label_bytes, BinErrorKind::BStringLimit);
    c.labels = add(c.labels, len);
    bound(c.labels, c.lim.max_total_label_bytes, BinErrorKind::BStringLimit);
    work(inout c.remaining, len);
}

fn check_node(inout c: Check, in meta: ChunkSeq[u64], index: u64, children: u64)
    -> Unit eff [Fail[BinError]] {
    work(inout c.remaining, node_len());
    if meta_get(in meta, wrapping_add(wrapping_mul(index, 2), 1)) == 0 {
        raise(BinErrorKind::BTree, node_offset(index));
    }
    bound(children, c.lim.max_children_per_node, BinErrorKind::BCountLimit);
    c.edges = add(c.edges, children);
    bound(c.edges, c.lim.max_edges, BinErrorKind::BCountLimit);
}

fn check_edge(inout c: Check, inout meta: ChunkSeq[u64], parent: u64, child: u64)
    -> Unit eff [Fail[BinError]] {
    work(inout c.remaining, EDGE_WORK);
    if child <= parent || child >= c.count {
        raise(BinErrorKind::BTree, node_offset(parent));
    }
    if meta_get(in meta, wrapping_mul(child, 2)) != 0 {
        raise(BinErrorKind::BTree, node_offset(child));
    }
    let depth = add(meta_get(in meta, wrapping_add(wrapping_mul(parent, 2), 1)), 1);
    bound(depth, c.lim.max_depth, BinErrorKind::BDepthLimit);
    meta.try_set(wrapping_mul(child, 2), 1);
    meta.try_set(wrapping_add(wrapping_mul(child, 2), 1), depth);
}

fn check_size(in c: Check, bytes: u64) -> Unit eff [Fail[BinError]] {
    bound(bytes, c.lim.max_archive_bytes, BinErrorKind::BByteLimit);
    bound(bytes, i32_max(), BinErrorKind::BOverflow);
}

fn w_at(in w: Slice[u64], i: u64) -> u64 {
    match w.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

// `archive::encoded_size` over flattened nodes: five words per node (value,
// label offset and length in `labels`, children offset and count in
// `children`).
pub fn archive_size(
    in nodes: Slice[u64],
    in labels: Slice[u8],
    in children: Slice[u32],
    lim: ArchiveLimits
) -> u64 eff [Fail[BinError]] {
    let count = nodes.len() / NODE_WORDS;
    let mut meta: ChunkSeq[u64] = ChunkSeq::new();
    let mut c = check_new(count, lim, inout meta);
    let mut cursor = node_offset(count);
    check_size(in c, cursor);
    for i in 0..count {
        let base = wrapping_mul(i, NODE_WORDS);
        let label_len = w_at(in nodes, wrapping_add(base, NODE_LABEL_LEN_WORD));
        let child_off = w_at(in nodes, wrapping_add(base, NODE_CHILD_OFF_WORD));
        let child_count = w_at(in nodes, wrapping_add(base, NODE_CHILD_COUNT_WORD));
        check_node(inout c, in meta, i, child_count);
        check_label(inout c, label_len);
        cursor = aligned(add(cursor, label_len));
        cursor = add(cursor, mul(child_count, REL_BYTES));
        check_size(in c, cursor);
        for k in 0..child_count {
            let child = match children.try_get(wrapping_add(child_off, k)) {
                Option::Some(v) => widen_u64(v),
                Option::None => 0,
            };
            check_edge(inout c, inout meta, i, child);
        }
    }
    // Both initialization and encoding touch at most two complete prefixes.
    work(inout c.remaining, mul(cursor, 2));
    cursor
}

fn put_u32(inout out: Slice[u8], offset: u64, v: u64) {
    out.try_write_u32_le(offset, wrapping_u32(v));
}

fn put_relative(inout out: Slice[u8], field_offset: u64, target: u64) {
    let rel = wrapping_sub(target, field_offset);
    out.try_write_u32_le(field_offset, wrapping_u32(rel));
}

// `archive::encode_into`.
pub fn archive_encode(
    in nodes: Slice[u64],
    in labels: Slice[u8],
    in children: Slice[u32],
    inout out: Slice[u8],
    lim: ArchiveLimits
) -> u64 eff [Fail[BinError]] {
    let size = archive_size(in nodes, in labels, in children, lim);
    if out.len() < size {
        raise(BinErrorKind::BOutputTooSmall, 0);
    }
    let count = nodes.len() / NODE_WORDS;
    for i in 0..size {
        out.try_set(i, 0);
    }
    out.try_set(0, wrapping_u8(MAGIC_V));
    out.try_set(1, wrapping_u8(MAGIC_S));
    out.try_set(2, wrapping_u8(MAGIC_P));
    out.try_set(3, wrapping_u8(MAGIC_A));
    out.try_set(HDR_VERSION, wrapping_u8(VERSION));
    out.try_set(HDR_SCHEMA, wrapping_u8(TREE_SCHEMA));
    put_u32(inout out, HDR_TOTAL_LEN, size);
    put_u32(inout out, HDR_NODE_COUNT, count);
    put_u32(inout out, HDR_ROOT, ROOT_RELATIVE);
    put_u32(inout out, HDR_NODES, NODES_RELATIVE);
    put_u32(inout out, HDR_NODES_COUNT, count);
    let mut cursor = wrapping_add(header_len(), wrapping_mul(count, node_len()));
    for i in 0..count {
        let base = wrapping_mul(i, NODE_WORDS);
        let offset = wrapping_add(header_len(), wrapping_mul(i, node_len()));
        put_u32(inout out, offset, w_at(in nodes, base));
        let label_off = w_at(in nodes, wrapping_add(base, NODE_LABEL_OFF_WORD));
        let label_len = w_at(in nodes, wrapping_add(base, NODE_LABEL_LEN_WORD));
        let child_off = w_at(in nodes, wrapping_add(base, NODE_CHILD_OFF_WORD));
        let child_count = w_at(in nodes, wrapping_add(base, NODE_CHILD_COUNT_WORD));
        if label_len != 0 {
            put_relative(inout out, wrapping_add(offset, NODE_LABEL), cursor);
            put_u32(inout out, wrapping_add(offset, NODE_LABEL_COUNT), label_len);
            for k in 0..label_len {
                out
                    .try_set(
                    wrapping_add(cursor, k),
                    wrapping_u8(byte(in labels, wrapping_add(label_off, k)))
                );
            }
            cursor = wrapping_add(cursor, label_len);
        }
        cursor = wrapping_add(cursor, wrapping_sub(REL_BYTES, 1)) & ALIGN_MASK;
        if child_count != 0 {
            put_relative(inout out, wrapping_add(offset, NODE_CHILDREN), cursor);
            put_u32(inout out, wrapping_add(offset, NODE_CHILD_COUNT), child_count);
            for k in 0..child_count {
                let child = match children.try_get(wrapping_add(child_off, k)) {
                    Option::Some(v) => widen_u64(v),
                    Option::None => 0,
                };
                put_relative(
                    inout out,
                    cursor,
                    wrapping_add(header_len(), wrapping_mul(child, node_len()))
                );
                cursor = wrapping_add(cursor, REL_BYTES);
            }
        }
    }
    size
}

// `Archive::validate`: the node count of a fully validated archive.
pub fn archive_validate(in bytes: Slice[u8], lim: ArchiveLimits) -> u64 eff [Fail[BinError]] {
    let len = bytes.len();
    bound(len, lim.max_archive_bytes, BinErrorKind::BByteLimit);
    bound(len, i32_max(), BinErrorKind::BOverflow);
    if len < header_len() {
        raise(BinErrorKind::BTruncated, len);
    }
    if byte(in bytes, 0)
        != MAGIC_V
        || byte(in bytes, 1)
        != MAGIC_S
        || byte(in bytes, 2)
        != MAGIC_P
        || byte(in bytes, 3)
        != MAGIC_A {
        raise(BinErrorKind::BMagic, 0);
    }
    if byte(in bytes, HDR_VERSION) != VERSION || byte(in bytes, wrapping_add(HDR_VERSION, 1)) != 0 {
        raise(BinErrorKind::BVersion, HDR_VERSION);
    }
    if byte(in bytes, HDR_SCHEMA)
        != TREE_SCHEMA
        || byte(in bytes, wrapping_add(HDR_SCHEMA, 1))
        != 0 {
        raise(BinErrorKind::BSchema, HDR_SCHEMA);
    }
    let total = get_u32(in bytes, HDR_TOTAL_LEN);
    if total > len {
        raise(BinErrorKind::BTruncated, len);
    }
    if total < len {
        raise(BinErrorKind::BTrailingBytes, total);
    }
    if get_u32(in bytes, HDR_RESERVED) != 0 {
        raise(BinErrorKind::BLayout, HDR_RESERVED);
    }
    let count = get_u32(in bytes, HDR_NODE_COUNT);
    bound(count, lim.max_nodes, BinErrorKind::BCountLimit);
    let nodes_offset = get_i32(in bytes, HDR_NODES);
    let nodes_count = get_u32(in bytes, HDR_NODES_COUNT);
    if nodes_count != count {
        raise(BinErrorKind::BLayout, HDR_NODES_COUNT);
    }
    let range = relslice_resolve(
        nodes_offset,
        wrapping_u32(nodes_count),
        HDR_NODES,
        node_len(),
        REL_BYTES,
        len
    );
    if range.start != header_len() {
        raise(BinErrorKind::BLayout, HDR_NODES);
    }
    let root = relptr_resolve(get_i32(in bytes, HDR_ROOT), HDR_ROOT, node_len(), REL_BYTES, len);
    if root.start != header_len() {
        raise(BinErrorKind::BTree, HDR_ROOT);
    }
    // A hostile count must fit actual node bytes before any metadata
    // allocation, even when caller-supplied limits are large.
    let mut meta: ChunkSeq[u64] = ChunkSeq::new();
    let mut c = check_new(count, lim, inout meta);
    check_size(in c, len);
    work(inout c.remaining, len);
    let mut cursor = range.end;
    for i in 0..count {
        let offset = node_offset(i);
        let mut r: u64 = NODE_RESERVED_FIRST;
        loop {
            if r > NODE_RESERVED_LAST {
                break;
            }
            if get_u32(in bytes, wrapping_add(offset, r)) != 0 {
                raise(BinErrorKind::BLayout, wrapping_add(offset, r));
            }
            r = wrapping_add(r, REL_BYTES);
        }
        let label_offset = get_i32(in bytes, wrapping_add(offset, NODE_LABEL));
        let label_count = get_u32(in bytes, wrapping_add(offset, NODE_LABEL_COUNT));
        let child_offset = get_i32(in bytes, wrapping_add(offset, NODE_CHILDREN));
        let child_count = get_u32(in bytes, wrapping_add(offset, NODE_CHILD_COUNT));
        check_node(inout c, in meta, i, child_count);
        check_label(inout c, label_count);
        let label = relslice_resolve(
            label_offset,
            wrapping_u32(label_count),
            wrapping_add(offset, NODE_LABEL),
            1,
            1,
            len
        );
        if label_count != 0 {
            if label.start != cursor {
                raise(BinErrorKind::BLayout, wrapping_add(offset, NODE_LABEL));
            }
            let valid = utf8_valid_up_to(in bytes, label.start, label.end);
            if valid != label.end {
                raise(BinErrorKind::BUtf8, valid);
            }
            cursor = label.end;
        }
        let next = aligned(cursor);
        if next > len {
            raise(BinErrorKind::BTruncated, cursor);
        }
        for p in cursor..next {
            if byte(in bytes, p) != 0 {
                raise(BinErrorKind::BLayout, cursor);
            }
        }
        cursor = next;
        let kids = relslice_resolve(
            child_offset,
            wrapping_u32(child_count),
            wrapping_add(offset, NODE_CHILDREN),
            REL_BYTES,
            REL_BYTES,
            len
        );
        if child_count != 0 {
            if kids.start != cursor {
                raise(BinErrorKind::BLayout, wrapping_add(offset, NODE_CHILDREN));
            }
            let mut entry = kids.start;
            loop {
                if entry >= kids.end {
                    break;
                }
                let target = relptr_resolve(
                    get_i32(in bytes, entry),
                    entry,
                    node_len(),
                    REL_BYTES,
                    len
                );
                if target
                    .start
                    < header_len()
                    || target
                    .start
                    >= range
                    .end
                    || wrapping_sub(target.start, header_len())
                    % NODE_BYTES
                    != 0 {
                    raise(BinErrorKind::BTree, entry);
                }
                check_edge(
                    inout c,
                    inout meta,
                    i,
                    wrapping_sub(target.start, header_len()) / NODE_BYTES
                );
                entry = wrapping_add(entry, REL_BYTES);
            }
            cursor = kids.end;
        }
    }
    if cursor != len {
        raise(BinErrorKind::BTrailingBytes, cursor);
    }
    count
}
