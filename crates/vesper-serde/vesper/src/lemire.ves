// @vesper/serde: decimal to binary64 conversion for validated JSON numbers
// (src/lemire.rs). Clinger's fast path, then Eisel-Lemire over the 128-bit
// power-of-five table (pow5.ves). When Eisel-Lemire cannot decide, the
// result says so and the Rust wrapper asks `str::parse`, which is the
// Fallback path of the Rust build too.
use self::Decoded;
use self::ascii::{
    Ascii
};

const DECIMAL_BASE: u64 = 10;
const EXP_BASE: i64 = 10;
// `digit_at` past the digits.
const NOT_DIGIT: u64 = 10;
// `byte_at` past the end: no byte has this value.
const NO_BYTE: u64 = 256;
// SWAR digit runs (fast_float): every byte of an eight-digit run has high
// nibble 3, and adding 6 keeps it 3.
const SWAR_HIGH_NIBBLES: u64 = 0xf0f0f0f0f0f0f0f0;
const SWAR_PLUS_SIX: u64 = 0x0606060606060606;
const SWAR_ALL_THREES: u64 = 0x3333333333333333;
const SWAR_LOW_NIBBLES: u64 = 0x0f0f0f0f0f0f0f0f;
// Pairwise combine: 10 * hi + lo per byte pair, then per u16 pair (100),
// then per u32 pair (10^4).
const SWAR_TENS: u64 = 2561;
const SWAR_HUNDREDS: u64 = 6553601;
const SWAR_TEN_THOUSANDS: u64 = 42949672960001;
const SWAR_BYTE_PAIRS: u64 = 0x00ff00ff00ff00ff;
const SWAR_U16_PAIRS: u64 = 0x0000ffff0000ffff;
const SWAR_DIGITS: u64 = 8;
const TEN_TO_EIGHT: u64 = 100000000;
// The exponent saturates once `e * 10` could pass `EXP_CAP` (EXP_CAP / 10).
const EXP_SATURATE: i64 = 461168601842738790;
// u64 holds any 19-digit significand exactly.
const MAX_EXACT_DIGITS: u64 = 19;
// floor(log2(10^q)) ~= q * 217706 / 2^16 (Lemire).
const LOG2_10_Q16: i64 = 217706;
const LOG2_10_SHIFT: i64 = 16;
// The power-of-five table covers 10^-342..10^308 (src/lemire.rs).
const SMALLEST_POWER_OF_TEN: i64 = -342;
const LARGEST_POWER_OF_TEN: i64 = 308;
// Table index of 10^q: q - SMALLEST_POWER_OF_TEN.
const POW5_INDEX_BIAS: i64 = 342;
// Words per power-of-five entry (hi, lo).
const POW5_WORDS: u64 = 2;
// The low 9 bits of the high product that a 55-bit approximation drops.
const PRODUCT_MASK: u64 = 511;
// q in -27..=55 is exact even when the truncated low half is all ones.
const MIN_SAFE_Q: i64 = -27;
const MAX_SAFE_Q: i64 = 55;
const SHIFT_BASE: u64 = 9;
const EXPONENT_BIAS: i64 = 1023;
// IEEE 754 binary64.
const INFINITE_POWER: i64 = 0x7ff;
const HIDDEN_BIT: u64 = 0x0010000000000000;
const MANTISSA_MASK: u64 = 0x000fffffffffffff;
const MANTISSA_OVERFLOW: u64 = 0x0020000000000000;
const MANTISSA_AND_HIDDEN: u64 = 0xffefffffffffffff;
const SIGN_BIT: u64 = 0x8000000000000000;
const NOT_LOWEST_BIT: u64 = 0xfffffffffffffffe;
// Round-to-even halfway cases are only exact for q in -4..=23.
const MIN_EXPONENT_ROUND_TO_EVEN: i64 = -4;
const MAX_EXPONENT_ROUND_TO_EVEN: i64 = 23;
// Clinger: w <= 2^53 and |q| <= 22 is one exact float operation.
const MAX_EXACT_INT: u64 = 0x0020000000000000;
const MAX_EXACT_POW10: i64 = 22;
const MIN_EXACT_POW10: i64 = -22;
const U64_MAX: u64 = 0xffffffffffffffff;

// A decimal `w * 10^q`; `truncated` when digits beyond the first 19
// significant ones were dropped from `w`; `ok` is false when the text is
// not a JSON number.
copy struct Decimal {
    ok: bool,
    negative: bool,
    w: u64,
    q: i64,
    truncated: bool
}

// Biased binary exponent and 52-bit mantissa; `ok` is false when
// Eisel-Lemire cannot decide the rounding.
copy struct Fp {
    ok: bool,
    power2: i64,
    mantissa: u64
}

// Exponent magnitudes are clamped to 2^62 (see src/lemire.rs).
const EXP_CAP: i64 = 4611686018427387904;

const MANTISSA_BITS: u64 = 52;

// The digit value of the byte at `p`, or 10 when it is not a digit or `p`
// is past the end.
fn digit_at(in text: Slice[u8], p: u64) -> u64 {
    match text.try_get(p) {
        Option::Some(c) => {
            let d = wrapping_sub(widen_u64(c), Ascii::Zero);
            if d < DECIMAL_BASE {
                d
            } else {
                NOT_DIGIT
            }
        },
        Option::None => NOT_DIGIT,
    }
}

fn byte_at(in text: Slice[u8], p: u64) -> u64 {
    match text.try_get(p) {
        Option::Some(c) => widen_u64(c),
        Option::None => NO_BYTE,
    }
}

// Fold runs of eight ASCII digits into `w` a word at a time (SWAR, as in
// fast_float); returns the new position and significand.
fn eight_digits(in text: Slice[u8], p0: u64, w0: u64) -> (u64, u64) {
    let mut p = p0;
    let mut w = w0;
    loop {
        match text.try_read_u64_le(p) {
            Option::Some(v) => {
                let hi = SWAR_HIGH_NIBBLES;
                let all = (v & hi) | ((wrapping_add(v, SWAR_PLUS_SIX) & hi) >> 4);
                if all != SWAR_ALL_THREES {
                    break;
                }
                let a = wrapping_mul(v & SWAR_LOW_NIBBLES, SWAR_TENS) >> 8;
                let b = wrapping_mul(a & SWAR_BYTE_PAIRS, SWAR_HUNDREDS) >> 16;
                let c = wrapping_mul(b & SWAR_U16_PAIRS, SWAR_TEN_THOUSANDS) >> 32;
                w = wrapping_add(wrapping_mul(w, TEN_TO_EIGHT), c);
                p = wrapping_add(p, SWAR_DIGITS);
            },
            Option::None => break,
        }
    }
    (p, w)
}

fn digits_from(in text: Slice[u8], p0: u64, w0: u64) -> (u64, u64) {
    let (p1, w1) = eight_digits(in text, p0, w0);
    let mut p = p1;
    let mut w = w1;
    loop {
        let d = digit_at(in text, p);
        if d == NOT_DIGIT {
            break;
        }
        w = wrapping_add(wrapping_mul(w, DECIMAL_BASE), d);
        p = wrapping_add(p, 1);
    }
    (p, w)
}

fn not_number() -> Decimal {
    Decimal {
        ok: false,
        negative: false,
        w: 0,
        q: 0,
        truncated: false
    }
}

// The JSON number grammar and its significand (src/lemire.rs `decimal`).
fn decimal(in text: Slice[u8]) -> Decimal {
    let n = text.len();
    let mut p: u64 = 0;
    let negative = byte_at(in text, 0) == Ascii::Minus;
    if negative {
        p = 1;
    }
    let int_start = p;
    let (p1, w1) = digits_from(in text, p, 0);
    p = p1;
    let mut w = w1;
    let int_end = p;
    if int_end == int_start {
        return not_number();
    }
    if wrapping_sub(int_end, int_start) > 1 && byte_at(in text, int_start) == Ascii::Zero {
        return not_number();
    }
    let mut frac_start = p;
    let mut frac_end = p;
    if byte_at(in text, p) == Ascii::Dot {
        p = wrapping_add(p, 1);
        frac_start = p;
        let (p2, w2) = digits_from(in text, p, w);
        p = p2;
        w = w2;
        frac_end = p;
        if frac_end == frac_start {
            return not_number();
        }
    }
    let mut e: i64 = 0;
    let c = byte_at(in text, p);
    if c == Ascii::LowerE || c == Ascii::UpperE {
        p = wrapping_add(p, 1);
        let mut exp_negative = false;
        let s = byte_at(in text, p);
        if s == Ascii::Minus {
            p = wrapping_add(p, 1);
            exp_negative = true;
        } else if s == Ascii::Plus {
            p = wrapping_add(p, 1);
        }
        let exp_start = p;
        loop {
            let d = digit_at(in text, p);
            if d == NOT_DIGIT {
                break;
            }
            // Saturate far beyond any digit count a slice can hold.
            if e > EXP_SATURATE {
                e = EXP_CAP;
            } else {
                e = wrapping_add(wrapping_mul(e, EXP_BASE), wrapping_i64(d));
                if e > EXP_CAP {
                    e = EXP_CAP;
                }
            }
            p = wrapping_add(p, 1);
        }
        if p == exp_start {
            return not_number();
        }
        if exp_negative {
            e = wrapping_sub(0, e);
        }
    }
    if p != n {
        return not_number();
    }
    let int_len = wrapping_sub(int_end, int_start);
    let frac_len = wrapping_sub(frac_end, frac_start);
    let digits = wrapping_add(int_len, frac_len);
    let mut d = Decimal {
        ok: true,
        negative: negative,
        w: w,
        q: wrapping_sub(e, wrapping_i64(frac_len)),
        truncated: false
    };
    if digits > MAX_EXACT_DIGITS {
        // Leading zeros do not count; re-read when there are too many
        // significant digits for `w` to be exact.
        let mut zeros: u64 = 0;
        let mut seen = false;
        let mut kept: u64 = 0;
        let mut w3: u64 = 0;
        let mut truncated = false;
        for k in 0..digits {
            let at = if k < int_len {
                wrapping_add(int_start, k)
            } else {
                wrapping_add(frac_start, wrapping_sub(k, int_len))
            };
            let dv = digit_at(in text, at);
            if !seen && dv == 0 {
                zeros = wrapping_add(zeros, 1);
            } else {
                seen = true;
                if kept < MAX_EXACT_DIGITS {
                    w3 = wrapping_add(wrapping_mul(w3, DECIMAL_BASE), dv);
                    kept = wrapping_add(kept, 1);
                } else if dv != 0 {
                    truncated = true;
                }
            }
        }
        let significant = wrapping_sub(digits, zeros);
        if significant > MAX_EXACT_DIGITS {
            d.w = w3;
            // Every significant digit past the 19th moves the scale by one.
            d.q = wrapping_add(d.q, wrapping_i64(wrapping_sub(significant, MAX_EXACT_DIGITS)));
            d.truncated = truncated;
        }
    }
    d
}

// Leading zero bits of `v` (64 for zero).
pub fn clz64(v: u64) -> u64 {
    if v == 0 {
        return 64;
    }
    let mut x = v;
    let mut n: u64 = 0;
    if x >> 32 == 0 {
        n = wrapping_add(n, 32);
        x = x << 32;
    }
    if x >> 48 == 0 {
        n = wrapping_add(n, 16);
        x = x << 16;
    }
    if x >> 56 == 0 {
        n = wrapping_add(n, 8);
        x = x << 8;
    }
    if x >> 60 == 0 {
        n = wrapping_add(n, 4);
        x = x << 4;
    }
    if x >> 62 == 0 {
        n = wrapping_add(n, 2);
        x = x << 2;
    }
    if x >> 63 == 0 {
        n = wrapping_add(n, 1);
    }
    n
}

fn fp(power2: i64, mantissa: u64) -> Fp {
    Fp {
        ok: true,
        power2: power2,
        mantissa: mantissa
    }
}

// floor(log2(10^q)) + 63.
fn power(q: i64) -> i64 {
    wrapping_add(wrapping_mul(q, LOG2_10_Q16) >> LOG2_10_SHIFT, 63)
}

// (src/lemire.rs `eisel_lemire`.)
fn eisel_lemire(q: i64, w: u64, in pow5: Slice[u64]) -> Fp {
    if w == 0 || q < SMALLEST_POWER_OF_TEN {
        return fp(0, 0);
    }
    if q > LARGEST_POWER_OF_TEN {
        return fp(INFINITE_POWER, 0);
    }
    let lz = clz64(w);
    let wn = bit_shl(w, lz);
    // The high 128 bits of `wn * 5^q` to 55 bits (`product_approx`).
    let mask: u64 = PRODUCT_MASK;
    let index = wrapping_u64(wrapping_add(q, POW5_INDEX_BIAS));
    let hi5 = match pow5.try_get(wrapping_mul(index, POW5_WORDS)) {
        Option::Some(v) => v,
        Option::None => 0,
    };
    let lo5 = match pow5.try_get(wrapping_add(wrapping_mul(index, POW5_WORDS), 1)) {
        Option::Some(v) => v,
        Option::None => 0,
    };
    let (first_lo0, first_hi0) = mul_wide(wn, hi5);
    let mut lo = first_lo0;
    let mut hi = first_hi0;
    if hi & mask == mask {
        let (_, second_hi) = mul_wide(wn, lo5);
        lo = wrapping_add(lo, second_hi);
        if second_hi > lo {
            hi = wrapping_add(hi, 1);
        }
    }
    if lo == U64_MAX {
        // The truncated low half may hide a carry into the bits we keep;
        // Lemire shows this cannot change the result for q in -27..=55.
        if q < MIN_SAFE_Q || q > MAX_SAFE_Q {
            return Fp {
                ok: false,
                power2: 0,
                mantissa: 0
            };
        }
    }
    let upperbit = hi >> 63;
    let shift = wrapping_add(upperbit, SHIFT_BASE);
    let mut mantissa = bit_shr(hi, shift);
    let mut power2 = wrapping_add(
        wrapping_sub(wrapping_add(power(q), wrapping_i64(upperbit)), wrapping_i64(lz)),
        EXPONENT_BIAS
    );
    if power2 <= 0 {
        // Subnormal (or zero) result.
        let s = wrapping_add(wrapping_sub(0, power2), 1);
        if s >= 64 {
            return fp(0, 0);
        }
        mantissa = bit_shr(mantissa, wrapping_u64(s));
        mantissa = wrapping_add(mantissa, mantissa & 1);
        mantissa = mantissa >> 1;
        let p2: i64 = if mantissa >= HIDDEN_BIT {
            1
        } else {
            0
        };
        return fp(p2, mantissa & MANTISSA_MASK);
    }
    // A product exactly halfway between two doubles: round to even.
    if lo <= 1
        && q >= MIN_EXPONENT_ROUND_TO_EVEN
        && q <= MAX_EXPONENT_ROUND_TO_EVEN
        && mantissa & 3 == 1
        && bit_shl(mantissa, shift) == hi {
        mantissa = mantissa & NOT_LOWEST_BIT;
    }
    mantissa = wrapping_add(mantissa, mantissa & 1);
    mantissa = mantissa >> 1;
    if mantissa >= MANTISSA_OVERFLOW {
        mantissa = HIDDEN_BIT;
        power2 = wrapping_add(power2, 1);
    }
    mantissa = mantissa & MANTISSA_AND_HIDDEN;
    if power2 >= INFINITE_POWER {
        return fp(INFINITE_POWER, 0);
    }
    fp(power2, mantissa)
}

fn assemble(negative: bool, f: Fp) -> u64 {
    let sign: u64 = if negative {
        SIGN_BIT
    } else {
        0
    };
    (wrapping_u64(f.power2) << MANTISSA_BITS) | f.mantissa | sign
}

// 10^k for k in 0..=22, exactly.
fn pow10(k: i64) -> f64 {
    let mut v = 1.0;
    let mut i: i64 = 0;
    loop {
        if i >= k {
            break;
        }
        v = v * 10.0;
        i = wrapping_add(i, 1);
    }
    v
}

// Convert a JSON number (src/lemire.rs `decode_f64`). `path`: 0 not a JSON
// number, 1 Clinger, 2 Eisel-Lemire, 3 undecided (the caller falls back).
pub fn decode_bits(in text: Slice[u8], in pow5: Slice[u64]) -> Decoded {
    let d = decimal(in text);
    if !d.ok {
        return Decoded {
            path: 0,
            bits: 0
        };
    }
    let sign: u64 = if d.negative {
        SIGN_BIT
    } else {
        0
    };
    if d.w == 0 {
        return Decoded {
            path: 1,
            bits: sign
        };
    }
    if !d.truncated && d.w <= MAX_EXACT_INT && d.q >= MIN_EXACT_POW10 && d.q <= MAX_EXACT_POW10 {
        let w = nearest_f64(d.w);
        let value = if d.q < 0 {
            w / pow10(wrapping_sub(0, d.q))
        } else {
            w * pow10(d.q)
        };
        return Decoded {
            path: 1,
            bits: to_bits_f64(value) | sign
        };
    }
    let f = eisel_lemire(d.q, d.w, in pow5);
    if f.ok {
        if d.truncated {
            // The true significand lies in (w, w + 1): both ends must agree.
            let up = eisel_lemire(d.q, wrapping_add(d.w, 1), in pow5);
            if up.ok && up.power2 == f.power2 && up.mantissa == f.mantissa {
                return Decoded {
                    path: 2,
                    bits: assemble(d.negative, f)
                };
            }
        } else {
            return Decoded {
                path: 2,
                bits: assemble(d.negative, f)
            };
        }
    }
    Decoded {
        path: 3,
        bits: 0
    }
}
