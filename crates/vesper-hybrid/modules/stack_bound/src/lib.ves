// @vesper/hybrid-stack-bound: `vesper::stack_bound::stack_bound_report`
// served from Vesper in the hybrid Stage 2 build (self-hosting SH2 lane 10,
// #1182).
//
// `report_words` takes one call's input as little-endian words (names, no
// types, an empty world, then the call graph and its policy; written by
// `stack_input` in tests/common/stack_words.rs) and returns the report as
// words (`stack_bound_words` of @vesper/check-loops-atomics), which
// `decode_stack_report` reads back into the Rust report.

// @export abi 4

use @vesper/check-loops-atomics::{
    stack_bound_words
};

// The layout version of `report_words`; the hybrid's tests check it.
pub fn format() -> u64 {
    1
}

pub fn report_words(in input: Slice[u8]) -> ChunkSeq[u64] {
    stack_bound_words(in input)
}

// The divergent build's stream (build.rs `divergent-stack-bound`): every
// graph is rejected as malformed with the error "divergent".
fn divergent_words(in input: Slice[u8]) -> ChunkSeq[u64] {
    let mut o: ChunkSeq[u64] = ChunkSeq::new[u64]();
    o.push(1);
    o.push(9);
    o.push(7954878057846040932);
    o.push(116);
    o
}
