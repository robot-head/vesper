// @export vsys Cranelift direct rust=vesper_cranelift_sys
//
// The `ffi` codegen swap of the hybrid Stage 2 build (self-hosting SH4
// lane 13, #1287): foreign (`.vsys`) calls emitted in Vesper through the
// lent Cranelift builder. crates/vesper-hybrid installs `ffi` as the `ffi`
// hook of `vesper::codegen_swap`; it emits one typed request of
// `codegen_swap::ffi`, and returns 0 to leave it to Rust.
use @vesper/ffi-emit::{
    ffi_hook
};

// One request: `call` is the address of the lent call. Returns 1 when it
// emitted the request, 0 to leave it to Rust.
pub fn ffi(call: u64) -> u64 eff [Ffi[Cranelift]] {
    ffi_hook(call)
}
