// @export vsys Cranelift direct rust=vesper_cranelift_sys
//
// The `scalar` and `body` codegen swaps of the hybrid Stage 2 build
// (self-hosting SH4 lane 6, #1280; native walk part 6a, #2094): scalars,
// locals, control flow and whole scalar function bodies emitted in Vesper
// through the lent Cranelift builder. `plan` reads one program (the words
// of `program_input` in tests/common/ir_words.rs) and returns six words per
// instruction Vesper emits, `[function, block, instruction, request, a,
// b]`; `body_plan` reads the same words and returns `[function, length,
// words...]` per function body Vesper emits. crates/vesper-hybrid installs
// `scalar` as the `scalar` hook of `vesper::codegen_swap` and `body` as its
// `body` hook; each emits its request and returns 0 to leave it to Rust.
use @vesper/codegen-scalar::{codegen_scalar_body_plan_bytes, codegen_scalar_plan_bytes};
use @vesper/codegen-scalar-emit::{body_hook, scalar_hook};

pub fn plan(in input: Slice[u8]) -> ChunkSeq[u64] {
    codegen_scalar_plan_bytes(in input)
}

pub fn body_plan(in input: Slice[u8]) -> ChunkSeq[u64] {
    codegen_scalar_body_plan_bytes(in input)
}

// One request: `call` is the address of the lent call. Returns 1 when it
// emitted the request, 0 to leave it to Rust.
pub fn scalar(call: u64) -> u64 eff [Ffi[Cranelift]] {
    scalar_hook(call)
}

// One function body: `call` is the address of the lent call. Returns 1
// when it emitted the body, 0 to leave it to Rust and 2 when the plan's
// words do not read.
pub fn body(call: u64) -> u64 eff [Ffi[Cranelift]] {
    body_hook(call)
}
