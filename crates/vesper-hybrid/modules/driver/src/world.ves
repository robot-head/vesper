// The checked world the driver holds (#2024): the session hands over the
// world's declarations once (`WorldDecls`, crates/vesper-hybrid/src/driver/
// world.rs), and `build`'s main check, `run`'s entry check and the
// interface export (interface.ves) read them here instead of asking the
// Rust session. Until the checker builds the world in Vesper (#2024 slice
// 3), the declarations cross as one byte stream:
//
//   index:  n adts (key, generic count, nominal mode)
//           n effects (key, generic count, linear)
//   adts:   key, G, is_enum, n variants (name, named, n fields (name, T))
//   effects: key, linear, G, n ops (name, local, F)
//   traits: n names
//   conformances: n (has_model, model, path, trait, self type)
//   functions: n (key, generated, G, F), in key order
//   G: n (name, row, bound)
//   F: n params (pass, n projections (n parts), T), T result, E
//   E: n instances (labeled, name, n args T), has_tail, tail
//   T: 0 named (name, n T) | 1 tuple (n T) | 2 function (n (pass, T), T, E,
//      mode) | 3 row | 4 unresolved
//
// LEB128 numbers, and texts as their length and bytes.

const NONE: u64 = 18446744073709551615;

const T_NAMED: u64 = 0;
const T_TUPLE: u64 = 1;
const T_FUNCTION: u64 = 2;

// ---------------------------------------------------------- the stream

pub fn byte_at(in b: Slice[u8], i: u64) -> u64 {
    match b.try_get(i) {
        Option::Some(v) => widen_u64(v),
        Option::None => 0,
    }
}

pub fn num(in b: Slice[u8], inout p: u64) -> u64 {
    let mut v: u64 = 0;
    let mut shift: u64 = 0;
    loop {
        let c = byte_at(in b, p);
        p = wrapping_add(p, 1);
        v = v | wrapping_shl_u64(c & 127, wrapping_u32(shift));
        if c < 128 || shift >= 63 {
            break;
        }
        shift = wrapping_add(shift, 7);
    }
    v
}

// A text: its start and length.
pub fn text(in b: Slice[u8], inout p: u64) -> (u64, u64) {
    let n = num(in b, inout p);
    let start = p;
    p = wrapping_add(p, n);
    (start, n)
}

pub fn cmp_bytes(in a: Slice[u8], sa: u64, la: u64, in c: Slice[u8], sc: u64, lc: u64) -> i64 {
    let n = if la < lc {
        la
    } else {
        lc
    };
    for i in 0..n {
        let x = byte_at(in a, wrapping_add(sa, i));
        let y = byte_at(in c, wrapping_add(sc, i));
        if x != y {
            return if x < y {
                -1
            } else {
                1
            };
        }
    }
    if la < lc {
        -1
    } else if la > lc {
        1
    } else {
        0
    }
}

pub fn same(in b: Slice[u8], s1: u64, l1: u64, s2: u64, l2: u64) -> bool {
    cmp_bytes(in b, s1, l1, in b, s2, l2) == 0
}

pub fn is_name(in b: Slice[u8], s: u64, l: u64, in lit: Str) -> bool {
    let t = lit.as_bytes();
    cmp_bytes(in b, s, l, in t, 0, t.len()) == 0
}

pub fn skip_effects(in b: Slice[u8], inout p: u64) {
    let n = num(in b, inout p);
    for _ in 0..n {
        num(in b, inout p);
        text(in b, inout p);
        let args = num(in b, inout p);
        for _ in 0..args {
            skip_ty(in b, inout p);
        }
    }
    num(in b, inout p);
    text(in b, inout p);
}

pub fn skip_ty(in b: Slice[u8], inout p: u64) {
    let tag = num(in b, inout p);
    if tag == T_NAMED {
        text(in b, inout p);
        let n = num(in b, inout p);
        for _ in 0..n {
            skip_ty(in b, inout p);
        }
    } else if tag == T_TUPLE {
        let n = num(in b, inout p);
        for _ in 0..n {
            skip_ty(in b, inout p);
        }
    } else if tag == T_FUNCTION {
        let n = num(in b, inout p);
        for _ in 0..n {
            num(in b, inout p);
            skip_ty(in b, inout p);
        }
        skip_ty(in b, inout p);
        skip_effects(in b, inout p);
        num(in b, inout p);
    }
}

pub fn skip_generics(in b: Slice[u8], inout p: u64) {
    let n = num(in b, inout p);
    for _ in 0..n {
        text(in b, inout p);
        num(in b, inout p);
        num(in b, inout p);
    }
}

pub fn skip_projections(in b: Slice[u8], inout p: u64) {
    let n = num(in b, inout p);
    for _ in 0..n {
        let parts = num(in b, inout p);
        for _ in 0..parts {
            text(in b, inout p);
        }
    }
}

// Past a function's parameters and result: the position of its effects.
pub fn effects_at(in b: Slice[u8], p: u64) -> u64 {
    let mut q = p;
    let n = num(in b, inout q);
    for _ in 0..n {
        num(in b, inout q);
        skip_projections(in b, inout q);
        skip_ty(in b, inout q);
    }
    skip_ty(in b, inout q);
    q
}

pub fn skip_function(in b: Slice[u8], inout p: u64) {
    p = effects_at(in b, p);
    skip_effects(in b, inout p);
}

// ---------------------------------------------------------- the world

// The declarations and the position of each function (in key order).
pub struct World {
    b: ChunkSeq[u8],
    fn_start: ChunkSeq[u64],
    fn_len: ChunkSeq[u64],
    fn_at: ChunkSeq[u64],
}

fn at(in s: ChunkSeq[u64], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

// Indexes the session's declaration stream.
pub fn world_of(sink b: ChunkSeq[u8]) -> World {
    let mut fn_start: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut fn_len: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut fn_at: ChunkSeq[u64] = ChunkSeq::new[u64]();
    scan(in b.as_slice(), inout fn_start, inout fn_len, inout fn_at);
    World {
        b: b,
        fn_start: fn_start,
        fn_len: fn_len,
        fn_at: fn_at,
    }
}

// Each function's key and the position of its signature.
fn scan(
    in s: Slice[u8],
    inout fn_start: ChunkSeq[u64],
    inout fn_len: ChunkSeq[u64],
    inout fn_at: ChunkSeq[u64]
) {
    let mut p: u64 = 0;
    let adts = num(in s, inout p);
    for _ in 0..adts {
        text(in s, inout p);
        num(in s, inout p);
        num(in s, inout p);
    }
    let effs = num(in s, inout p);
    for _ in 0..effs {
        text(in s, inout p);
        num(in s, inout p);
        num(in s, inout p);
    }
    for _ in 0..adts {
        text(in s, inout p);
        skip_generics(in s, inout p);
        num(in s, inout p);
        let n = num(in s, inout p);
        for _ in 0..n {
            text(in s, inout p);
            num(in s, inout p);
            let fields = num(in s, inout p);
            for _ in 0..fields {
                text(in s, inout p);
                skip_ty(in s, inout p);
            }
        }
    }
    for _ in 0..effs {
        text(in s, inout p);
        num(in s, inout p);
        skip_generics(in s, inout p);
        let n = num(in s, inout p);
        for _ in 0..n {
            text(in s, inout p);
            num(in s, inout p);
            skip_function(in s, inout p);
        }
    }
    let traits = num(in s, inout p);
    for _ in 0..traits {
        text(in s, inout p);
    }
    let conformances = num(in s, inout p);
    for _ in 0..conformances {
        num(in s, inout p);
        text(in s, inout p);
        text(in s, inout p);
        text(in s, inout p);
        text(in s, inout p);
    }
    let functions = num(in s, inout p);
    for _ in 0..functions {
        let (start, len) = text(in s, inout p);
        fn_start.push(start);
        fn_len.push(len);
        num(in s, inout p);
        skip_generics(in s, inout p);
        // The signature.
        fn_at.push(p);
        skip_function(in s, inout p);
    }
}

// The interface export's input (`interface_json`): the package name as a
// text, then the declarations.
pub fn interface_stream(in w: World, in package: Slice[u8]) -> ChunkSeq[u8] {
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut n = package.len();
    loop {
        let low = n & 127;
        n = wrapping_shr_u64(n, 7);
        if n == 0 {
            out.push(wrapping_u8(low));
            break;
        }
        out.push(wrapping_u8(low | 128));
    }
    out.extend(in package);
    out.extend(in w.b.as_slice());
    out
}

// The position of function `name`'s signature, or NONE.
pub fn function(in w: World, in name: Slice[u8]) -> u64 {
    let b = w.b.as_slice();
    let mut lo: u64 = 0;
    let mut hi = w.fn_start.len();
    loop {
        if lo >= hi {
            break NONE;
        }
        let mid = wrapping_shr_u64(wrapping_add(lo, hi), 1);
        let c = cmp_bytes(
            in b,
            at(in w.fn_start, mid),
            at(in w.fn_len, mid),
            in name,
            0,
            name.len()
        );
        if c < 0 {
            lo = wrapping_add(mid, 1);
        } else if c > 0 {
            hi = mid;
        } else {
            break at(in w.fn_at, mid);
        }
    }
}

pub fn is_none(p: u64) -> bool {
    p == NONE
}

// The number of parameters of the signature at `p`.
pub fn param_count(in w: World, p: u64) -> u64 {
    let mut q = p;
    num(in w.b.as_slice(), inout q)
}

// Whether the signature at `p` leaves an effect unhandled: an effect
// instance or a row tail.
pub fn has_effects(in w: World, p: u64) -> bool {
    let b = w.b.as_slice();
    let mut q = effects_at(in b, p);
    let instances = num(in b, inout q);
    if instances != 0 {
        return true;
    }
    num(in b, inout q) == 1
}

// Whether the result of the signature at `p` may be an executable's: an
// integer kind, `Unit`, or no named type (`Type::name` is empty).
pub fn main_result(in w: World, p: u64) -> bool {
    let b = w.b.as_slice();
    let mut q = p;
    let n = num(in b, inout q);
    for _ in 0..n {
        num(in b, inout q);
        skip_projections(in b, inout q);
        skip_ty(in b, inout q);
    }
    if num(in b, inout q) != T_NAMED {
        return true;
    }
    let (s, l) = text(in b, inout q);
    l == 0 || is_name(in b, s, l, "Unit") || is_integer_name(in b, s, l)
}

// `vesper::numeric::is_integer_name`.
fn is_integer_name(in b: Slice[u8], s: u64, l: u64) -> bool {
    is_name(in b, s, l, "u8")
        || is_name(in b, s, l, "u16")
        || is_name(in b, s, l, "u32")
        || is_name(in b, s, l, "u64")
        || is_name(in b, s, l, "usize")
        || is_name(in b, s, l, "i8")
        || is_name(in b, s, l, "i16")
        || is_name(in b, s, l, "i32")
        || is_name(in b, s, l, "i64")
        || is_name(in b, s, l, "isize")
        || is_name(in b, s, l, "i128")
        || is_name(in b, s, l, "u128")
}
