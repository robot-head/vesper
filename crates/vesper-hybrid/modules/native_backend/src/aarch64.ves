const IMM12_MASK: u64 = 0xfff;
const IMM12_SCALE: u32 = 12;
const IMM12_SCALED: u32 = 0x00400000;
const BITMASK_N: u32 = 0x00400000;
const IMMR_SHIFT: u32 = 16;
const IMMS_SHIFT: u32 = 10;
const SHIFT_MASK: u64 = QWORD_BITS - 1;
const BYTE_SHIFT_BITS: u64 = 3;
const WORD_SHIFT_BITS: u64 = 4;
const BITMASK_ELEMENT_HALVINGS: u64 = 5;
const HALFWORDS: u64 = 4;
const HALFWORD_BITS: u64 = 16;
const HALFWORD_MASK: u64 = 0xffff;
const HALFWORD_SHIFT: u32 = 21;
const IMM16_SHIFT: u32 = 5;

const EQ: u32 = 0;
const NE: u32 = 1;
const HS: u32 = 2;
const LO: u32 = 3;
const VS: u32 = 6;
const VC: u32 = 7;
const HI: u32 = 8;
const LS: u32 = 9;
const GE: u32 = 10;
const LT: u32 = 11;
const GT: u32 = 12;
const LE: u32 = 13;

copy struct BranchArm {
    start: u64,
    end: u64,
}

copy struct Branch {
    offset: u64,
    instruction: u32,
}

copy struct LabelBranch {
    branch: Branch,
    target: u64,
    block: bool,
}

struct FrameLayout {
    slots: ChunkSeq[FrameSlot],
    size: u64,
}

copy struct SavedRegisters {
    mask: u32,
    first: u32,
    offset: u64,
}

copy struct HomeCell {
    width: u64,
    next_store: u64,
}

copy enum Allocation {
    RegisterHomes,
    StackHomes,
    Spills,
    SpillsWithRegisterHomes,
}

copy enum Retry {
    Allocate(Allocation),
    LongTables,
    WithoutCalleeRegisters,
}

fn sh(value: u32, amount: u32) -> u32 {
    wrapping_shl_u32(value, amount)
}

fn rrr(inout out: ChunkSeq[u8], op: u32, dest: u32, lhs: u32, rhs: u32) {
    push32(inout out, op | sh(rhs, RM_SHIFT) | sh(lhs, RN_SHIFT) | dest);
}

fn bitfield(inout out: ChunkSeq[u8], op: u32, dest: u32, source: u32, rotate: u64, last: u64) {
    push32(
        inout out,
        op
            | sh(wrapping_u32(rotate), IMMR_SHIFT)
            | sh(wrapping_u32(last), IMMS_SHIFT)
            | sh(source, RN_SHIFT)
            | dest
    );
}

fn scalar_width(width: u64) -> bool {
    width == BYTE_BITS || width == WORD_BITS || width == DWORD_BITS || width == QWORD_BITS
}

fn float_width(width: u64) -> bool {
    width == DWORD_BITS || width == QWORD_BITS
}

fn scalar_opcode_mask(width: u64) -> u32 {
    if width == DWORD_BITS { ~REG64 } else { ~0 }
}

fn low_bits(bits: u64, width: u64) -> u64 {
    bits & wrapping_shr_u64(~0, wrapping_u32(wrapping_sub(QWORD_BITS, width)))
}

fn normalize(inout out: ChunkSeq[u8], register: u32, width: u64) {
    if width != QWORD_BITS {
        bitfield(inout out, UBFM, register, register, 0, wrapping_sub(width, 1));
    }
}

fn halfword(bits: u64, index: u64) -> u64 {
    wrapping_shr_u64(bits, wrapping_u32(wrapping_mul(index, HALFWORD_BITS))) & HALFWORD_MASK
}

// A logical immediate is a power-of-two element repeated across the register.
// The element contains one circular run of ones and at least one zero.
fn bitmask_immediate(bits: u64) -> Option[u32] {
    if bits == 0 || bits == ~0 {
        return Option::None;
    }
    let mut width = QWORD_BITS;
    let mut mask: u64 = ~0;
    for _ in 0..BITMASK_ELEMENT_HALVINGS {
        let half = width / 2;
        let half_mask = wrapping_shr_u64(mask, wrapping_u32(half));
        if (bits & half_mask) != ((wrapping_shr_u64(bits, wrapping_u32(half))) & half_mask) {
            break;
        }
        width = half;
        mask = half_mask;
    }
    let element = bits & mask;
    let last = wrapping_u32(wrapping_sub(width, 1));
    let previous = (wrapping_shl_u64(element, 1) & mask) | wrapping_shr_u64(element, last);
    let starts = element & ~previous;
    if (starts & wrapping_sub(starts, 1)) != 0 {
        return Option::None;
    }
    let start = trailing_zeros_u64(starts);
    let rotation = wrapping_sub(0, start) & last;
    let run = wrapping_shr_u64(element, start) | (wrapping_shl_u64(element, rotation) & mask);
    let ones = trailing_zeros_u64(~run);
    let size = (sh(~last, 1) | wrapping_sub(ones, 1)) & wrapping_u32(SHIFT_MASK);
    let n = if width == QWORD_BITS { BITMASK_N } else { 0 };
    Option::Some(n | sh(rotation, IMMR_SHIFT) | sh(size, IMMS_SHIFT))
}

fn immediate(inout out: ChunkSeq[u8], dest: u32, bits: u64) {
    let mut zero_parts: u64 = 0;
    let mut one_parts: u64 = 0;
    for index in 0..HALFWORDS {
        let part = halfword(bits, index);
        if part == 0 {
            zero_parts = wrapping_add(zero_parts, 1);
        } else if part == HALFWORD_MASK {
            one_parts = wrapping_add(one_parts, 1);
        }
    }
    let inverted = one_parts > zero_parts;
    let filled = if inverted { one_parts } else { zero_parts };
    if filled < wrapping_sub(HALFWORDS, 1) {
        match bitmask_immediate(bits) {
            Option::Some(encoded) => {
                push32(inout out, ORR_IMM | encoded | sh(ZERO, RN_SHIFT) | dest);
                return;
            },
            Option::None => (),
        }
    }
    let fill = if inverted { HALFWORD_MASK } else { 0 };
    let first = if inverted { MOVN } else { MOVZ };
    let mut op = first;
    for index in 0..HALFWORDS {
        let part = halfword(bits, index);
        if part != fill {
            let encoded = if op == MOVN {
                part ^ HALFWORD_MASK
            } else {
                part
            };
            push32(
                inout out,
                op
                    | sh(wrapping_u32(index), HALFWORD_SHIFT)
                    | sh(wrapping_u32(encoded), IMM16_SHIFT)
                    | dest
            );
            op = MOVK;
        }
    }
    if op == first {
        push32(inout out, first | dest);
    }
}

fn condition(code: u64) -> u32 {
    match code {
        EQUAL => EQ,
        NOT_EQUAL => NE,
        SIGNED_LESS => LT,
        SIGNED_GREATER_EQUAL => GE,
        SIGNED_GREATER => GT,
        SIGNED_LESS_EQUAL => LE,
        UNSIGNED_LESS => LO,
        UNSIGNED_GREATER_EQUAL => HS,
        UNSIGNED_GREATER => HI,
        _ => LS,
    }
}

fn magnitude(signed: i64) -> u64 {
    wrapping_u64(
        if signed < 0 {
            wrapping_sub(0, signed)
        } else {
            signed
        }
    )
}

fn arithmetic_immediate(amount: u64) -> Option[u32] {
    if amount <= IMM12_MASK {
        return Option::Some(sh(wrapping_u32(amount), IMM12_SHIFT));
    }
    let scaled = wrapping_shr_u64(amount, IMM12_SCALE);
    if (amount & IMM12_MASK) == 0 && scaled <= IMM12_MASK {
        return Option::Some(IMM12_SCALED | sh(wrapping_u32(scaled), IMM12_SHIFT));
    }
    Option::None
}

fn comparison_width(op: u64) -> u64 {
    match op {
        COMPARE | COMPARE_IMMEDIATE => QWORD_BITS,
        COMPARE_DWORD | COMPARE_DWORD_IMMEDIATE => DWORD_BITS,
        COMPARE_WORD | COMPARE_WORD_IMMEDIATE => WORD_BITS,
        COMPARE_BYTE | COMPARE_BYTE_IMMEDIATE => BYTE_BITS,
        _ => 0,
    }
}

fn comparison_uses_immediate(op: u64) -> bool {
    op >= COMPARE_IMMEDIATE && op <= COMPARE_DWORD_IMMEDIATE
}

fn compare(inout out: ChunkSeq[u8], in r: Record, lhs: u32, rhs: u32) {
    let width = comparison_width(r.op);
    let reg_mask = scalar_opcode_mask(width);
    let signed_narrow = width < DWORD_BITS
        && r.extra >= SIGNED_LESS
        && r.extra <= SIGNED_LESS_EQUAL;
    let mut lhs = lhs;
    if signed_narrow {
        bitfield(inout out, SBFM, SECOND_SCRATCH, lhs, 0, wrapping_sub(width, 1));
        lhs = SECOND_SCRATCH;
    }
    if comparison_uses_immediate(r.op) {
        let signed = if width >= DWORD_BITS || signed_narrow {
            widen_i64(wrapping_i32(r.right))
        } else {
            wrapping_i64(low_bits(r.right, width))
        };
        match arithmetic_immediate(magnitude(signed)) {
            Option::Some(encoded) => {
                let op = if signed < 0 { CMN_IMM } else { CMP_IMM };
                push32(inout out, (op & reg_mask) | encoded | sh(lhs, RN_SHIFT));
            },
            Option::None => {
                immediate(inout out, SCRATCH, wrapping_u64(signed));
                rrr(inout out, SUBS_REG & reg_mask, ZERO, lhs, SCRATCH);
            },
        }
    } else {
        let mut rhs = rhs;
        if signed_narrow {
            bitfield(inout out, SBFM, SCRATCH, rhs, 0, wrapping_sub(width, 1));
            rhs = SCRATCH;
        }
        rrr(inout out, SUBS_REG & reg_mask, ZERO, lhs, rhs);
    }
}

fn store_width(op: u64) -> u64 {
    match op {
        STORE_BYTE | STACK_STORE_BYTE => BYTE_BITS,
        STORE_WORD | STACK_STORE_WORD => WORD_BITS,
        STORE_DWORD | STACK_STORE_DWORD | FLOAT_STORE32 | FLOAT_STACK_STORE32 => DWORD_BITS,
        STORE_QWORD | STACK_STORE_QWORD | FLOAT_STORE64 | FLOAT_STACK_STORE64 => QWORD_BITS,
        _ => 0,
    }
}

fn is_stack_store(op: u64) -> bool {
    (op >= STACK_STORE_BYTE && op <= STACK_STORE_QWORD)
        || op == FLOAT_STACK_STORE32
        || op == FLOAT_STACK_STORE64
}

fn is_stack_load(op: u64) -> bool {
    op == STACK_LOAD || op == FLOAT_STACK_LOAD
}

fn frame_layout(in words: Slice[u64], count: u64) -> Option[FrameLayout] {
    let mut slots = ChunkSeq::new[FrameSlot]();
    let mut used: u64 = 0;
    for index in 0..count {
        let r = read_record(in words, index);
        if r.op != STACK_SLOT {
            break;
        }
        let alignment = r.right;
        if alignment == 0
            || alignment > STACK_ALIGNMENT
            || (alignment & wrapping_sub(alignment, 1)) != 0
            || r.left > MAX_FRAME_BYTES
            || r.extra != 0
        {
            return Option::None;
        }
        let offset = align_up(used, alignment);
        used = wrapping_add(offset, r.left);
        if used > MAX_FRAME_BYTES {
            return Option::None;
        }
        slots.push(FrameSlot { offset: offset, size: r.left });
    }
    Option::Some(FrameLayout { slots: slots, size: align_up(used, STACK_ALIGNMENT) })
}

fn stack_displacement(in frame: FrameLayout, in r: Record) -> Option[u64] {
    let store = is_stack_store(r.op);
    let index = if store { r.right } else { r.left };
    let offset = if store { r.extra } else { r.right };
    let width = if store { store_width(r.op) } else { r.extra };
    match frame.slots.try_get(index) {
        Option::Some(slot) => {
            if offset <= slot.size && width / BYTE_BITS <= wrapping_sub(slot.size, offset) {
                Option::Some(wrapping_add(slot.offset, offset))
            } else {
                Option::None
            }
        },
        Option::None => Option::None,
    }
}

fn home_register(first: u32, cell: u32, mask: u32) -> u32 {
    if cell < wrapping_u32(HOME_REGISTERS) && (mask & sh(1, cell)) != 0 {
        wrapping_add(first, cell)
    } else {
        UNASSIGNED
    }
}

fn home_cell(in r: Record, home_slot: u64) -> u32 {
    let (slot, offset) = if is_stack_store(r.op) {
        (r.right, r.extra)
    } else {
        (r.left, r.right)
    };
    if slot == home_slot && offset % HOME_WORD_BYTES == 0 {
        wrapping_u32(offset / HOME_WORD_BYTES)
    } else {
        UNASSIGNED
    }
}

fn worth_spilling_with_homes(
    in words: Slice[u64],
    in aliases: ChunkSeq[u64],
    homes: u32,
    returns: u64
) -> bool {
    // Conservatively charge a save on entry and a restore on each normal return.
    let cost = wrapping_mul(widen_u64(count_ones_u64(widen_u64(homes))), wrapping_add(returns, 1));
    if aliases.len() <= cost {
        return false;
    }
    let mut savings: u64 = 0;
    for index in 0..aliases.len() {
        let reload = read_record(in words, aliases.try_get(index).unwrap_or(0));
        let cell = wrapping_u32(reload.right / HOME_WORD_BYTES);
        if (homes & sh(1, cell)) != 0 {
            savings = wrapping_add(savings, 1);
            if savings > cost {
                return true;
            }
        }
    }
    false
}

fn write_home(inout out: ChunkSeq[u8], home: u32, source: u32, width: u64) {
    if width == QWORD_BITS {
        if home != source {
            rrr(inout out, ORR_REG, home, ZERO, source);
        }
    } else if width == DWORD_BITS {
        rrr(inout out, ORR_REG & ~REG64, home, ZERO, source);
    } else {
        bitfield(inout out, UBFM & ~BITFIELD64, home, source, 0, wrapping_sub(width, 1));
    }
}

fn memory(
    inout out: ChunkSeq[u8],
    load: bool,
    width: u64,
    address: u32,
    data: u32,
    displacement: u64
) {
    let bytes = width / BYTE_BITS;
    let scale = trailing_zeros_u64(bytes);
    let size = sh(scale, MEMORY_SIZE_SHIFT);
    let opcode = size | (if load { MEMORY_LOAD } else { 0 });
    let offset = widen_i64(wrapping_i32(displacement));
    let unsigned = wrapping_u64(offset);
    let scaled = wrapping_shr_u64(unsigned, scale);
    if offset >= 0 && (unsigned & wrapping_sub(bytes, 1)) == 0 && scaled <= IMM12_MASK {
        push32(
            inout out,
            MEMORY_SCALED
                | opcode
                | sh(wrapping_u32(scaled), IMM12_SHIFT)
                | sh(address, RN_SHIFT)
                | data
        );
    } else if offset >= MEMORY_IMM9_MIN && offset <= MEMORY_IMM9_MAX {
        let imm = wrapping_u32(offset) & MEMORY_IMM9_MASK;
        push32(
            inout out,
            MEMORY_UNSCALED | opcode | sh(imm, MEMORY_IMM9_SHIFT) | sh(address, RN_SHIFT) | data
        );
    } else {
        immediate(inout out, SCRATCH, unsigned);
        rrr(inout out, MEMORY_REGISTER | opcode, data, address, SCRATCH);
    }
}

fn conditional_branch(op: u64) -> bool {
    op == BRANCH_ZERO || op == BRANCH_BLOCK || op == BRANCH_LABEL
}

fn flags_survive_stack_stores(in words: Slice[u64], start: u64, end: u64, value: u64) -> bool {
    for index in start..end {
        let store = read_record(in words, index);
        if !is_stack_store(store.op) || store.left == value {
            return false;
        }
    }
    true
}

fn direct_call(op: u64) -> bool {
    op == CALL || op == CALL_VOID || op == CALL_PAIR
}

fn float_operands(in r: Record) -> Option[u64] {
    if is_float_compare(r.op) {
        return if r.extra <= FLOAT_UNORDERED_OR_GREATER_EQUAL {
            Option::Some(2)
        } else {
            Option::None
        };
    }
    if r.op == FLOAT_SELECT {
        return Option::Some(3);
    }
    if is_stack_store(r.op) {
        return Option::Some(1);
    }
    if r.op == FLOAT_STORE32 || r.op == FLOAT_STORE64 {
        return if r.extra <= DISP32_MASK {
            Option::Some(2)
        } else {
            Option::None
        };
    }
    if !float_width(r.extra) {
        return Option::None;
    }
    if is_float_binary(r.op) {
        return Option::Some(2);
    }
    match r.op {
        FLOAT_CONSTANT => if r.right == 0 {
            Option::Some(0)
        } else {
            Option::None
        },
        FLOAT_STACK_LOAD => Option::Some(0),
        FLOAT_LOAD => if r.right <= DISP32_MASK {
            Option::Some(1)
        } else {
            Option::None
        },
        FLOAT_NEG | FLOAT_ABS | FLOAT_SQRT | BITS_TO_FLOAT | FLOAT_TO_BITS => if r.right == 0 {
            Option::Some(1)
        } else {
            Option::None
        },
        _ => Option::None,
    }
}

fn operands(in r: Record, returns: u64) -> Option[u64] {
    if r.op == CONSTANT || r.op == STACK_SLOT || r.op == BLOCK_LABEL {
        return Option::Some(0);
    }
    if r.op >= FLOAT_CONSTANT && r.op <= FLOAT_COPY_SIGN {
        return float_operands(in r);
    }
    if is_symbol(r.op) {
        return if r.left <= DISP32_MASK && r.right == 0 && r.extra == 0 {
            Option::Some(0)
        } else {
            Option::None
        };
    }
    if r.op == EDGE_LABEL || r.op == JUMP_LABEL {
        return if r.right == 0 && r.extra == 0 {
            Option::Some(0)
        } else {
            Option::None
        };
    }
    if r.op == BRANCH_TABLE {
        return Option::Some(1);
    }
    if r.op == BRANCH_TABLE_TARGET {
        return if r.right == 0 && r.extra == 0 {
            Option::Some(0)
        } else {
            Option::None
        };
    }
    if direct_call(r.op) {
        return if r.right <= ARGUMENT_REGISTERS
            && r.extra == 0
            && (r.left < LIBCALL_TARGET_BASE
                || (r.op != CALL_PAIR
                    && wrapping_sub(r.left, LIBCALL_TARGET_BASE) <= MEMCPY_LIBCALL))
        {
            Option::Some(0)
        } else {
            Option::None
        };
    }
    if r.op == CALL_ARGUMENT {
        return if r.right == 0 && r.extra == 0 {
            Option::Some(1)
        } else {
            Option::None
        };
    }
    if r.op == CALL_HIGH {
        return if r.left == 0 && r.right == 0 && r.extra == 0 {
            Option::Some(0)
        } else {
            Option::None
        };
    }
    if r.op == RETURN_PAIR || r.op == TRAP {
        return Option::Some(0);
    }
    if r.op == OVERFLOW_FLAG || r.op == FENCE {
        return if r.left == 0 && r.right == 0 && r.extra == 0 {
            Option::Some(0)
        } else {
            Option::None
        };
    }
    if consumes_carry(r.op) {
        return Option::Some(3);
    }
    if is_checked_arithmetic(r.op) {
        return if r.extra == DWORD_BITS || r.extra == QWORD_BITS {
            Option::Some(2)
        } else {
            Option::None
        };
    }
    if comparison_width(r.op) != 0 {
        if r.extra > UNSIGNED_LESS_EQUAL {
            return Option::None;
        }
        if !comparison_uses_immediate(r.op) {
            return Option::Some(2);
        }
        if r.right <= DISP32_MASK {
            return Option::Some(1);
        }
        return Option::None;
    }
    if r.op == SELECT {
        return Option::Some(3);
    }
    if conditional_branch(r.op) {
        if r.extra == 0 && (r.right == 0) == (r.op == BRANCH_ZERO) {
            return Option::Some(1);
        }
        return Option::None;
    }
    if r.op == EARLY_RETURN || r.op == BLOCK_RETURN {
        if r.op == BLOCK_RETURN && r.extra != 0 {
            return Option::None;
        }
        if r.left == TRAP_VALUE {
            return if r.right == 0 {
                Option::Some(0)
            } else {
                Option::None
            };
        }
        if (returns != PAIRED_RESULTS && r.right != 0) || (r.left == NO_VALUE) != (returns == 0) {
            return Option::None;
        }
        return Option::Some(returns);
    }
    if r.op == STACK_LOAD || r.op == STACK_ADDRESS {
        if (r.op == STACK_LOAD && scalar_width(r.extra))
            || (r.op == STACK_ADDRESS && r.extra == 0)
        {
            return Option::Some(0);
        }
        return Option::None;
    }
    if is_stack_store(r.op) {
        return Option::Some(1);
    }
    if store_width(r.op) != 0 {
        if r.extra <= DISP32_MASK {
            return Option::Some(2);
        }
        return Option::None;
    }
    if r.op == FUNNEL_RIGHT {
        return if r.extra < QWORD_BITS {
            Option::Some(2)
        } else {
            Option::None
        };
    }
    if !scalar_width(r.extra) {
        return Option::None;
    }
    if is_atomic_rmw(r.op) || r.op == ATOMIC_STORE {
        return Option::Some(2);
    }
    match r.op {
        ATOMIC_LOAD => if r.right == 0 {
            Option::Some(1)
        } else {
            Option::None
        },
        LOAD => if r.right <= DISP32_MASK {
            Option::Some(1)
        } else {
            Option::None
        },
        ADD | SUB | MUL | AND | OR | XOR | AND_NOT | OR_NOT | XOR_NOT => Option::Some(2),
        ROTATE_RIGHT_REGISTER | ROTATE_LEFT_REGISTER => Option::Some(2),
        ROTATE_RIGHT => Option::Some(1),
        SHL_REGISTER | SHR_REGISTER | SAR_REGISTER => Option::Some(2),
        SIGNED_DIV | UNSIGNED_DIV | SIGNED_REM | UNSIGNED_REM => Option::Some(2),
        SIGNED_MUL_HIGH | UNSIGNED_MUL_HIGH => if r.extra == QWORD_BITS {
            Option::Some(2)
        } else {
            Option::None
        },
        TRUNCATE => if scalar_width(r.right) && r.right > r.extra {
            Option::Some(1)
        } else {
            Option::None
        },
        ZERO_EXTEND | SIGN_EXTEND => if scalar_width(r.right) && r.right < r.extra {
            Option::Some(1)
        } else {
            Option::None
        },
        NEG | NOT | SHL | SHR | SAR => Option::Some(1),
        ABS => if r.right == 0 {
            Option::Some(1)
        } else {
            Option::None
        },
        BYTE_SWAP => if r.extra >= WORD_BITS {
            Option::Some(1)
        } else {
            Option::None
        },
        LEADING_ZEROS
            | TRAILING_ZEROS
            | POPULATION_COUNT
            | REVERSE_BITS
            | LEADING_SIGN_BITS => if r.right
            == 0
        {
            Option::Some(1)
        } else {
            Option::None
        },
        ADD_IMMEDIATE
            | SUB_IMMEDIATE
            | MUL_IMMEDIATE
            | AND_IMMEDIATE
            | OR_IMMEDIATE
            | XOR_IMMEDIATE => if r.right
            <= DISP32_MASK
        {
            Option::Some(1)
        } else {
            Option::None
        },
        _ => Option::None,
    }
}

fn division_checks(inout out: ChunkSeq[u8], in r: Record, lhs: u32, rhs: u32) {
    let reg_mask: u32 = if r.extra == QWORD_BITS { ~0 } else { ~REG64 };
    let skip = sh(SKIP_TRAP_DISPLACEMENT, BRANCH_IMM19_SHIFT);
    if r.op == SIGNED_DIV {
        // The zero check branches straight to the same trap as overflow.
        let trap = sh(SIGNED_DIV_TRAP_DISPLACEMENT, BRANCH_IMM19_SHIFT);
        push32(inout out, (BRANCH_IF_ZERO & reg_mask) | trap | rhs);
        if r.extra < DWORD_BITS {
            // After sign extension, MIN + its magnitude and -1 + 1 both set Z.
            let magnitude = wrapping_shl_u64(1, wrapping_u32(wrapping_sub(r.extra, 1)));
            let encoded = arithmetic_immediate(magnitude).unwrap_or(0);
            push32(inout out, (CMN_IMM & reg_mask) | encoded | sh(lhs, RN_SHIFT));
            push32(
                inout out,
                CCMN_IMM_W | sh(1, RM_SHIFT) | sh(EQ, CONDITION_SHIFT) | sh(rhs, RN_SHIFT)
            );
            push32(inout out, BRANCH_IF_CONDITION | skip | NE);
        } else {
            // Only a divisor of -1 can overflow. For that divisor, subtracting
            // one from the dividend sets V precisely when the dividend is MIN.
            push32(inout out, (CMN_IMM & reg_mask) | sh(1, IMM12_SHIFT) | sh(rhs, RN_SHIFT));
            push32(
                inout out,
                (CCMP_IMM & reg_mask)
                    | sh(1, RM_SHIFT)
                    | sh(EQ, CONDITION_SHIFT)
                    | sh(lhs, RN_SHIFT)
            );
            push32(inout out, BRANCH_IF_CONDITION | skip | VC);
        }
    } else {
        push32(inout out, (BRANCH_IF_NOT_ZERO & reg_mask) | skip | rhs);
    }
    push32(inout out, TRAP_INSTRUCTION);
}

fn narrow_division_operands(
    inout out: ChunkSeq[u8],
    in r: Record,
    lhs: u32,
    rhs: u32
) -> (u32, u32) {
    let op = if r.op == SIGNED_DIV || r.op == SIGNED_REM {
        SBFM
    } else {
        UBFM
    };
    let top = wrapping_sub(r.extra, 1);
    bitfield(inout out, op & ~BITFIELD64, SCRATCH, lhs, 0, top);
    bitfield(inout out, op & ~BITFIELD64, SECOND_SCRATCH, rhs, 0, top);
    (SCRATCH, SECOND_SCRATCH)
}

fn overflow_condition(op: u64) -> u32 {
    match op {
        UNSIGNED_ADD_OVERFLOW => HS,
        UNSIGNED_SUB_OVERFLOW => LO,
        SIGNED_ADD_OVERFLOW | SIGNED_SUB_OVERFLOW => VS,
        _ => NE,
    }
}

fn emit_checked(inout out: ChunkSeq[u8], in r: Record, dest: u32, lhs: u32, rhs: u32, flags: bool) {
    let reg_mask = scalar_opcode_mask(r.extra);
    let opcode = match r.op {
        UNSIGNED_ADD_OVERFLOW | SIGNED_ADD_OVERFLOW => if flags { ADDS_REG } else { ADD_REG },
        UNSIGNED_SUB_OVERFLOW | SIGNED_SUB_OVERFLOW => if flags { SUBS_REG } else { SUB_REG },
        _ => MUL_REG,
    };
    if opcode != MUL_REG || !flags {
        rrr(inout out, opcode & reg_mask, dest, lhs, rhs);
        return;
    }
    let signed = r.op == SIGNED_MUL_OVERFLOW;
    if r.extra == DWORD_BITS {
        let long = if signed { SMULL_REG } else { UMULL_REG };
        let narrow = if signed { SUBS_SXTW } else { SUBS_UXTW };
        rrr(inout out, long, SCRATCH, lhs, rhs);
        // The full product must equal its narrowed and re-extended value.
        rrr(inout out, narrow, ZERO, SCRATCH, SCRATCH);
        if dest != ZERO {
            rrr(inout out, ORR_REG & ~REG64, dest, ZERO, SCRATCH);
        }
    } else if signed {
        rrr(inout out, SMULH_REG, SCRATCH, lhs, rhs);
        let low = if dest == ZERO { SECOND_SCRATCH } else { dest };
        rrr(inout out, MUL_REG, low, lhs, rhs);
        // The high half must be the sign extension of the low half.
        rrr(inout out, SUBS_ASR_SIGN, ZERO, SCRATCH, low);
    } else {
        rrr(inout out, UMULH_REG, SCRATCH, lhs, rhs);
        rrr(inout out, SUBS_REG, ZERO, SCRATCH, ZERO);
        if dest != ZERO {
            rrr(inout out, MUL_REG, dest, lhs, rhs);
        }
    }
}

fn atomic_address(width: u64, address: u32) -> u32 {
    let size = sh(trailing_zeros_u64(width / BYTE_BITS), MEMORY_SIZE_SHIFT);
    sh(address, RN_SHIFT) | size
}

fn emit_atomic(inout out: ChunkSeq[u8], in r: Record, old: u32, address: u32, operand: u32) {
    let base = atomic_address(r.extra, address);
    if r.op == ATOMIC_LOAD {
        push32(inout out, LOAD_ACQUIRE | base | old);
        return;
    }
    push32(inout out, LOAD_ACQUIRE_EXCLUSIVE | base | old);
    let (source, distance) = if r.op == ATOMIC_EXCHANGE {
        (operand, EXCHANGE_RETRY_DISTANCE)
    } else {
        let op = if r.op == ATOMIC_ADD { ADD_REG } else { SUB_REG };
        let opcode = if r.extra == QWORD_BITS {
            op
        } else {
            op & ~REG64
        };
        rrr(inout out, opcode, SCRATCH, old, operand);
        (SCRATCH, ARITHMETIC_RETRY_DISTANCE)
    };
    push32(inout out, STORE_RELEASE_EXCLUSIVE | base | sh(SECOND_SCRATCH, RM_SHIFT) | source);
    let retry = sh(wrapping_sub(0, distance) & BRANCH_IMM19_MASK, BRANCH_IMM19_SHIFT);
    push32(inout out, (BRANCH_IF_NOT_ZERO & ~REG64) | retry | SECOND_SCRATCH);
}

fn emit_float_predicate(inout out: ChunkSeq[u8], predicate: u64, dest: u32) {
    // FCMP sets C for equal, greater and unordered, and V only for unordered.
    let (first, second) = match predicate {
        FLOAT_ORDERED => (VC, Option::None),
        FLOAT_UNORDERED => (VS, Option::None),
        FLOAT_EQUAL => (EQ, Option::None),
        FLOAT_NOT_EQUAL => (NE, Option::None),
        FLOAT_ORDERED_NOT_EQUAL => (LO, Option::Some(GT)),
        FLOAT_UNORDERED_OR_EQUAL => (EQ, Option::Some(VS)),
        FLOAT_LESS => (LO, Option::None),
        FLOAT_LESS_EQUAL => (LS, Option::None),
        FLOAT_GREATER => (GT, Option::None),
        FLOAT_GREATER_EQUAL => (GE, Option::None),
        FLOAT_UNORDERED_OR_LESS => (LT, Option::None),
        FLOAT_UNORDERED_OR_LESS_EQUAL => (LE, Option::None),
        FLOAT_UNORDERED_OR_GREATER => (HI, Option::None),
        _ => (HS, Option::None),
    };
    push32(inout out, CSET | sh(first ^ 1, CONDITION_SHIFT) | dest);
    match second {
        Option::Some(cc) => {
            rrr(inout out, CSINC | sh(cc ^ 1, CONDITION_SHIFT), dest, dest, ZERO);
        },
        Option::None => (),
    }
}

fn emit_float_alu(inout out: ChunkSeq[u8], in r: Record, dest: u32, lhs: u32, rhs: u32) {
    // Keep the bits in the ordinary allocator. The FP temporaries never live
    // across an instruction boundary, spill, or call.
    let compare = is_float_compare(r.op);
    let double = if compare {
        r.op == FLOAT_COMPARE64
    } else {
        r.extra == QWORD_BITS
    };
    let precision = if double { FP_DOUBLE } else { 0 };
    let move_width = if double { FP_DOUBLE | REG64 } else { 0 };
    let to_fp = FMOV_FROM_GP | move_width;
    push32(inout out, to_fp | sh(lhs, RN_SHIFT) | FP_LEFT);
    if r.op == FLOAT_SQRT {
        push32(inout out, FSQRT | precision | sh(FP_LEFT, RN_SHIFT) | FP_LEFT);
    } else {
        push32(inout out, to_fp | sh(rhs, RN_SHIFT) | FP_RIGHT);
        if compare {
            rrr(inout out, FCMP | precision, 0, FP_LEFT, FP_RIGHT);
            emit_float_predicate(inout out, r.extra, dest);
            return;
        }
        let op = match r.op {
            FLOAT_ADD => FADD,
            FLOAT_SUB => FSUB,
            FLOAT_MUL => FMUL,
            _ => FDIV,
        };
        rrr(inout out, op | precision, FP_LEFT, FP_LEFT, FP_RIGHT);
    }
    push32(inout out, FMOV_TO_GP | move_width | sh(FP_LEFT, RN_SHIFT) | dest);
}

fn emit_float_instruction(
    inout out: ChunkSeq[u8],
    in r: Record,
    dest: u32,
    lhs: u32,
    rhs: u32,
    third: u32
) {
    if r.op == FLOAT_CONSTANT {
        immediate(inout out, dest, low_bits(r.left, r.extra));
    } else if r.op == BITS_TO_FLOAT || r.op == FLOAT_TO_BITS {
        if dest != lhs || r.extra == DWORD_BITS {
            rrr(inout out, ORR_REG & scalar_opcode_mask(r.extra), dest, ZERO, lhs);
        }
    } else if r.op == FLOAT_NEG {
        let op = if r.extra == DWORD_BITS {
            EOR_F32_SIGN
        } else {
            EOR_F64_SIGN
        };
        push32(inout out, op | sh(lhs, RN_SHIFT) | dest);
    } else if r.op == FLOAT_ABS {
        let op = if r.extra == DWORD_BITS {
            UBFM & ~BITFIELD64
        } else {
            UBFM
        };
        let sign = wrapping_sub(r.extra, 1);
        bitfield(inout out, op, dest, lhs, 0, wrapping_sub(sign, 1));
    } else if r.op == FLOAT_COPY_SIGN {
        let sign = wrapping_sub(r.extra, 1);
        bitfield(inout out, UBFM, SCRATCH, rhs, sign, sign);
        if dest != lhs {
            rrr(inout out, ORR_REG, dest, ZERO, lhs);
        }
        bitfield(inout out, BFM, dest, SCRATCH, wrapping_sub(0, sign) & SHIFT_MASK, 0);
    } else if r.op == FLOAT_LOAD {
        memory(inout out, true, r.extra, lhs, dest, r.right);
    } else if r.op == FLOAT_SELECT {
        rrr(inout out, SUBS_REG, ZERO, lhs, ZERO);
        rrr(inout out, CSEL | sh(NE, CONDITION_SHIFT), dest, rhs, third);
    } else {
        emit_float_alu(inout out, in r, dest, lhs, rhs);
    }
}

fn emit_bit_operation(inout out: ChunkSeq[u8], in r: Record, dest: u32, source: u32) {
    let narrow = r.extra < DWORD_BITS;
    let wide = r.extra == QWORD_BITS;
    let reg_mask: u32 = if wide { ~0 } else { ~REG64 };
    let mut source = source;
    if r.op == TRAILING_ZEROS {
        if narrow {
            // Put a sentinel above the input so an all-zero value counts to its width.
            let rotate = sh(wrapping_u32(wrapping_sub(DWORD_BITS, r.extra)), IMMR_SHIFT);
            push32(inout out, (ORR_IMM & reg_mask) | rotate | sh(source, RN_SHIFT) | SCRATCH);
            source = SCRATCH;
        }
        push32(inout out, (RBIT_REG & reg_mask) | sh(source, RN_SHIFT) | SCRATCH);
        push32(inout out, (CLZ_REG & reg_mask) | sh(SCRATCH, RN_SHIFT) | dest);
    } else if r.op == REVERSE_BITS {
        push32(inout out, (RBIT_REG & reg_mask) | sh(source, RN_SHIFT) | dest);
        if narrow {
            let shift = wrapping_sub(DWORD_BITS, r.extra);
            bitfield(inout out, UBFM & ~BITFIELD64, dest, dest, shift, DWORD_BITS - 1);
        }
    } else {
        if narrow {
            let extend = if r.op == LEADING_SIGN_BITS {
                SBFM
            } else {
                UBFM
            };
            bitfield(inout out, extend & ~BITFIELD64, SCRATCH, source, 0, wrapping_sub(r.extra, 1));
            source = SCRATCH;
        }
        if r.op == POPULATION_COUNT {
            let move_width = if wide { FP_DOUBLE | REG64 } else { 0 };
            push32(inout out, FMOV_FROM_GP | move_width | sh(source, RN_SHIFT) | FP_LEFT);
            push32(inout out, CNT_8B | sh(FP_LEFT, RN_SHIFT) | FP_LEFT);
            push32(inout out, ADDV_8B | sh(FP_LEFT, RN_SHIFT) | FP_LEFT);
            push32(inout out, UMOV_LOW_BYTE | sh(FP_LEFT, RN_SHIFT) | dest);
        } else {
            let op = if r.op == LEADING_SIGN_BITS {
                CLS_REG
            } else {
                CLZ_REG
            };
            push32(inout out, (op & reg_mask) | sh(source, RN_SHIFT) | dest);
            if narrow {
                let excess = sh(wrapping_u32(wrapping_sub(DWORD_BITS, r.extra)), IMM12_SHIFT);
                push32(inout out, (SUB_IMM & reg_mask) | excess | sh(dest, RN_SHIFT) | dest);
            }
        }
    }
}

fn emit_rotate(inout out: ChunkSeq[u8], in r: Record, dest: u32, lhs: u32, rhs: u32) {
    let narrow = r.extra < DWORD_BITS;
    let immediate = r.op == ROTATE_RIGHT;
    let count = r.right & wrapping_sub(r.extra, 1);
    let reg_mask: u32 = if r.extra == QWORD_BITS { ~0 } else { ~REG64 };
    let mut source = lhs;
    if narrow {
        let field = UBFM & ~BITFIELD64;
        if immediate && count == 0 {
            bitfield(inout out, field, dest, source, 0, wrapping_sub(r.extra, 1));
            return;
        }
        // Repeating the narrow value makes each window of its width a rotation.
        bitfield(inout out, field, SCRATCH, lhs, 0, wrapping_sub(r.extra, 1));
        let shifted_half = sh(wrapping_u32(r.extra), LOGICAL_AMOUNT_SHIFT);
        rrr(inout out, (ORR_REG & reg_mask) | shifted_half, SCRATCH, SCRATCH, SCRATCH);
        if immediate {
            let last = wrapping_sub(wrapping_add(count, r.extra), 1);
            bitfield(inout out, field, dest, SCRATCH, count, last);
            return;
        }
        if r.extra == BYTE_BITS {
            let shifted_word = sh(wrapping_u32(WORD_BITS), LOGICAL_AMOUNT_SHIFT);
            rrr(inout out, (ORR_REG & reg_mask) | shifted_word, SCRATCH, SCRATCH, SCRATCH);
        }
        source = SCRATCH;
    } else if immediate {
        let op = if r.extra == QWORD_BITS {
            EXTR
        } else {
            EXTR & ~BITFIELD64
        };
        rrr(inout out, op | sh(wrapping_u32(count), EXTR_AMOUNT_SHIFT), dest, lhs, lhs);
        return;
    }
    let count_register = if r.op == ROTATE_LEFT_REGISTER {
        rrr(inout out, SUB_REG & reg_mask, SECOND_SCRATCH, ZERO, rhs);
        SECOND_SCRATCH
    } else {
        rhs
    };
    rrr(inout out, ROR_REG & reg_mask, dest, source, count_register);
    if narrow {
        normalize(inout out, dest, r.extra);
    }
}

fn emit_abs(inout out: ChunkSeq[u8], dest: u32, source: u32, width: u64) {
    let wide = width == QWORD_BITS;
    let reg_mask: u32 = if wide { ~0 } else { ~REG64 };
    let word_bits = if wide { QWORD_BITS } else { DWORD_BITS };
    // TST tests the declared sign bit even if a caller has dirtied the upper bits.
    let rotate = sh(wrapping_u32(wrapping_add(wrapping_sub(word_bits, width), 1)), IMMR_SHIFT);
    let size = if wide { BITMASK_N } else { 0 };
    push32(inout out, (TST_IMM & reg_mask) | size | rotate | sh(source, RN_SHIFT));
    rrr(inout out, (CSNEG & reg_mask) | sh(EQ, CONDITION_SHIFT), dest, source, source);
    if width < DWORD_BITS {
        normalize(inout out, dest, width);
    }
}

fn emit_narrow_shift(
    inout out: ChunkSeq[u8],
    in r: Record,
    op: u32,
    dest: u32,
    lhs: u32,
    rhs: u32
) {
    let count_bits = if r.extra == BYTE_BITS {
        BYTE_SHIFT_BITS
    } else {
        WORD_SHIFT_BITS
    };
    bitfield(inout out, UBFM & ~BITFIELD64, SCRATCH, rhs, 0, wrapping_sub(count_bits, 1));
    let mut source = lhs;
    if r.op != SHL_REGISTER {
        let extend = if r.op == SAR_REGISTER { SBFM } else { UBFM };
        bitfield(inout out, extend & ~BITFIELD64, SECOND_SCRATCH, lhs, 0, wrapping_sub(r.extra, 1));
        source = SECOND_SCRATCH;
    }
    rrr(inout out, op & ~REG64, dest, source, SCRATCH);
    if r.op != SHR_REGISTER {
        normalize(inout out, dest, r.extra);
    }
}

fn emit_instruction(
    inout out: ChunkSeq[u8],
    in r: Record,
    dest: u32,
    lhs: u32,
    rhs: u32,
    third: u32
) {
    if r.op == CONSTANT {
        immediate(inout out, dest, r.left);
    } else if r.op >= FLOAT_CONSTANT && r.op <= FLOAT_COPY_SIGN {
        emit_float_instruction(inout out, in r, dest, lhs, rhs, third);
    } else if r.op >= LEADING_ZEROS && r.op <= LEADING_SIGN_BITS {
        emit_bit_operation(inout out, in r, dest, lhs);
    } else if r.op >= ROTATE_RIGHT && r.op <= ROTATE_LEFT_REGISTER {
        emit_rotate(inout out, in r, dest, lhs, rhs);
    } else if r.op == FUNNEL_RIGHT {
        let op = EXTR | sh(wrapping_u32(r.extra), EXTR_AMOUNT_SHIFT);
        rrr(inout out, op, dest, rhs, lhs);
    } else if r.op == ABS {
        emit_abs(inout out, dest, lhs, r.extra);
    } else if r.op == BYTE_SWAP {
        let op = match r.extra {
            WORD_BITS => REV16_W,
            DWORD_BITS => REV_W,
            _ => REV_X,
        };
        push32(inout out, op | sh(lhs, RN_SHIFT) | dest);
        if r.extra == WORD_BITS {
            // REV16 also swaps the high halfword. Keep the result zero-extended.
            normalize(inout out, dest, WORD_BITS);
        }
    } else if consumes_carry(r.op) {
        let op = if r.op == ADD_CARRY { ADC_REG } else { SBC_REG };
        rrr(inout out, op, dest, lhs, rhs);
    } else if is_integer_division(r.op) {
        let divide = if r.op == SIGNED_DIV || r.op == SIGNED_REM {
            SDIV_REG
        } else {
            UDIV_REG
        };
        let remainder = r.op == SIGNED_REM || r.op == UNSIGNED_REM;
        let narrow = r.extra < DWORD_BITS;
        let quotient = if remainder && !narrow { SCRATCH } else { dest };
        let reg_mask: u32 = if r.extra == QWORD_BITS { ~0 } else { ~REG64 };
        rrr(inout out, divide & reg_mask, quotient, lhs, rhs);
        if remainder {
            let multiply_subtract = (MSUB_REG & reg_mask) | sh(lhs, ACCUMULATOR_SHIFT);
            rrr(inout out, multiply_subtract, dest, quotient, rhs);
        }
        if narrow {
            normalize(inout out, dest, r.extra);
        }
    } else if r.op == LOAD {
        memory(inout out, true, r.extra, lhs, dest, r.right);
    } else if r.op == TRUNCATE || r.op == ZERO_EXTEND || r.op == SIGN_EXTEND {
        if r.op == SIGN_EXTEND {
            let op = if r.extra == DWORD_BITS {
                SBFM & ~BITFIELD64
            } else {
                SBFM
            };
            bitfield(inout out, op, dest, lhs, 0, wrapping_sub(r.right, 1));
            if r.extra < DWORD_BITS {
                normalize(inout out, dest, r.extra);
            }
        } else {
            if r.op == TRUNCATE {
                bitfield(inout out, UBFM, dest, lhs, 0, wrapping_sub(r.extra, 1));
            } else if dest != lhs {
                rrr(inout out, ORR_REG, dest, ZERO, lhs);
            }
        }
    } else if r.op == NEG || r.op == NOT {
        let op = if r.op == NEG { SUB_REG } else { ORN_REG };
        let reg_mask = scalar_opcode_mask(r.extra);
        rrr(inout out, op & reg_mask, dest, ZERO, lhs);
        if r.extra < DWORD_BITS {
            normalize(inout out, dest, r.extra);
        }
    } else if r.op == SHL || r.op == SHR || r.op == SAR {
        let width_mask = wrapping_sub(r.extra, 1);
        let count = r.right & width_mask;
        if count == 0 {
            if dest != lhs {
                rrr(inout out, ORR_REG, dest, ZERO, lhs);
            }
            return;
        }
        let mut op = if r.op == SAR { SBFM } else { UBFM };
        let register_mask = if r.extra > DWORD_BITS {
            SHIFT_MASK
        } else {
            DWORD_BITS - 1
        };
        let (rotate, last) = if r.op == SHL {
            (wrapping_sub(0, count) & register_mask, wrapping_sub(width_mask, count))
        } else {
            (count, width_mask)
        };
        if r.extra <= DWORD_BITS {
            op = op & ~BITFIELD64;
        }
        bitfield(inout out, op, dest, lhs, rotate, last);
        if r.op == SAR && r.extra < DWORD_BITS {
            normalize(inout out, dest, r.extra);
        }
    } else if r.op == SELECT {
        rrr(inout out, SUBS_REG, ZERO, lhs, ZERO);
        rrr(inout out, CSEL | sh(NE, CONDITION_SHIFT), dest, rhs, third);
    } else if comparison_width(r.op) != 0 {
        compare(inout out, in r, lhs, rhs);
        push32(inout out, CSET | sh(condition(r.extra) ^ 1, CONDITION_SHIFT) | dest);
    } else {
        let reg_mask = scalar_opcode_mask(r.extra);
        let mut rhs = rhs;
        if r.op >= ADD_IMMEDIATE && r.op <= XOR_IMMEDIATE {
            let signed = widen_i64(wrapping_i32(r.right));
            if r.op == ADD_IMMEDIATE || r.op == SUB_IMMEDIATE {
                match arithmetic_immediate(magnitude(signed)) {
                    Option::Some(encoded) => {
                        let subtract = (r.op == SUB_IMMEDIATE) != (signed < 0);
                        let op = if subtract { SUB_IMM } else { ADD_IMM };
                        push32(inout out, (op & reg_mask) | encoded | sh(lhs, RN_SHIFT) | dest);
                        if r.extra < DWORD_BITS {
                            normalize(inout out, dest, r.extra);
                        }
                        return;
                    },
                    Option::None => (),
                }
            } else if r.op != MUL_IMMEDIATE {
                match bitmask_immediate(low_bits(wrapping_u64(signed), r.extra)) {
                    Option::Some(encoded) => {
                        let op = match r.op {
                            AND_IMMEDIATE => AND_IMM,
                            OR_IMMEDIATE => ORR_IMM,
                            _ => EOR_IMM,
                        };
                        push32(inout out, op | encoded | sh(lhs, RN_SHIFT) | dest);
                        return;
                    },
                    Option::None => (),
                }
            }
            immediate(inout out, SCRATCH, wrapping_u64(signed));
            rhs = SCRATCH;
        }
        let op = match r.op {
            SIGNED_MUL_HIGH => SMULH_REG,
            UNSIGNED_MUL_HIGH => UMULH_REG,
            ADD | ADD_IMMEDIATE => ADD_REG,
            SUB | SUB_IMMEDIATE => SUB_REG,
            MUL | MUL_IMMEDIATE => MUL_REG,
            AND | AND_IMMEDIATE => AND_REG,
            AND_NOT => BIC_REG,
            OR | OR_IMMEDIATE => ORR_REG,
            OR_NOT => ORN_REG,
            XOR | XOR_IMMEDIATE => EOR_REG,
            XOR_NOT => EON_REG,
            SHL_REGISTER => LSL_REG,
            SHR_REGISTER => LSR_REG,
            _ => ASR_REG,
        };
        if r.op >= SHL_REGISTER && r.op <= SAR_REGISTER && r.extra < DWORD_BITS {
            emit_narrow_shift(inout out, in r, op, dest, lhs, rhs);
            return;
        }
        rrr(inout out, op & reg_mask, dest, lhs, rhs);
        if r.extra < DWORD_BITS {
            normalize(inout out, dest, r.extra);
        }
    }
}

fn last_read(in ends: ChunkSeq[u64], value: u64) -> u64 {
    ends.try_get(value).unwrap_or(NEVER_READ)
}

fn location(in locations: ChunkSeq[u32], id: u64) -> u32 {
    locations.try_get(id).unwrap_or(UNASSIGNED)
}

fn expire(used: u32, in ends: ChunkSeq[u64], value: u64, current: u64, assigned: u32) -> u32 {
    if assigned < UNASSIGNED && last_read(in ends, value) == current {
        used & ~sh(1, assigned)
    } else {
        used
    }
}

fn spill_offset(frame_bytes: u64, assigned: u32) -> u64 {
    let slot = widen_u64(wrapping_sub(assigned, SPILL_BASE));
    wrapping_add(frame_bytes, wrapping_mul(slot, HOME_WORD_BYTES))
}

fn allocate_spill(
    inout spills: ChunkSeq[u64],
    frame_bytes: u64,
    value: u64,
    last: u64
) -> Option[u32] {
    for slot in 0..spills.len() {
        if spills.try_get(slot).unwrap_or(NO_VALUE) <= value {
            let _ = spills.try_set(slot, last);
            return Option::Some(wrapping_add(SPILL_BASE, wrapping_u32(slot)));
        }
    }
    let assigned = wrapping_add(SPILL_BASE, wrapping_u32(spills.len()));
    if wrapping_add(spill_offset(frame_bytes, assigned), HOME_WORD_BYTES) > MAX_FRAME_BYTES {
        return Option::None;
    }
    spills.push(last);
    Option::Some(assigned)
}

fn materialize(inout output: ChunkSeq[u8], assigned: u32, scratch: u32, frame_bytes: u64) -> u32 {
    if assigned >= SPILL_BASE {
        if assigned == REMATERIALIZED_ZERO {
            // Register 31 encodes SP in address and some arithmetic operands.
            rrr(inout output, ORR_REG, scratch, ZERO, ZERO);
        } else {
            memory(
                inout output,
                true,
                QWORD_BITS,
                SP,
                scratch,
                spill_offset(frame_bytes, assigned)
            );
        }
        scratch
    } else {
        assigned
    }
}

fn store_source(inout output: ChunkSeq[u8], assigned: u32, scratch: u32, frame_bytes: u64) -> u32 {
    if assigned == REMATERIALIZED_ZERO {
        ZERO
    } else {
        materialize(inout output, assigned, scratch, frame_bytes)
    }
}

fn no_result(op: u64) -> bool {
    op == BRANCH_ZERO
        || op == EARLY_RETURN
        || op == STACK_SLOT
        || store_width(op) != 0
        || (op >= BLOCK_LABEL && op <= BRANCH_BLOCK)
        || op == BRANCH_TABLE
        || op == BRANCH_TABLE_TARGET
        || op == CALL_VOID
        || op == CALL_ARGUMENT
        || op == RETURN_PAIR
        || op == TRAP
        || op == FENCE
        || op == ATOMIC_STORE
}

fn stack_adjust(opcode: u32, adjustment: u32) -> u32 {
    opcode | adjustment | sh(SP, RN_SHIFT) | SP
}

fn emit_return(
    inout output: ChunkSeq[u8],
    low: u32,
    high: u32,
    adjustment: u32,
    spill_mode: bool,
    link_slot: u64,
    in callee: SavedRegisters,
    inout restores: ChunkSeq[u64]
) {
    if high == FIRST_RESULT && low != FIRST_RESULT {
        // Moving the first result would overwrite the second result.
        let source = if low == SECOND_RESULT {
            rrr(inout output, ORR_REG, SCRATCH, ZERO, low);
            SCRATCH
        } else {
            low
        };
        rrr(inout output, ORR_REG, SECOND_RESULT, ZERO, high);
        rrr(inout output, ORR_REG, FIRST_RESULT, ZERO, source);
    } else {
        if low != UNASSIGNED && low != FIRST_RESULT {
            rrr(inout output, ORR_REG, FIRST_RESULT, ZERO, low);
        }
        if high != UNASSIGNED && high != SECOND_RESULT {
            rrr(inout output, ORR_REG, SECOND_RESULT, ZERO, high);
        }
    }
    if link_slot != NO_VALUE {
        memory(inout output, true, QWORD_BITS, SP, LINK_REGISTER, link_slot);
    }
    frame_registers(inout output, in callee, true);
    if spill_mode {
        restores.push(output.len());
    }
    if spill_mode || adjustment != 0 {
        push32(inout output, stack_adjust(ADD_IMM, adjustment));
    }
    push32(inout output, RETURN);
}

fn call_frame_bytes() -> u64 {
    align_up(wrapping_mul(wrapping_add(CALL_SAVE_REGISTERS, 1), HOME_WORD_BYTES), STACK_ALIGNMENT)
}

fn call_save_slot(frame_bytes: u64, register: u64) -> u64 {
    wrapping_add(
        wrapping_sub(frame_bytes, call_frame_bytes()),
        wrapping_mul(wrapping_add(register, 1), HOME_WORD_BYTES)
    )
}

fn frame_registers(inout out: ChunkSeq[u8], in saved: SavedRegisters, load: bool) {
    let mut remaining = saved.mask;
    loop {
        if remaining == 0 {
            break;
        }
        let first = trailing_zeros_u64(widen_u64(remaining));
        remaining = remaining & ~sh(1, first);
        let next = wrapping_add(first, 1);
        let index = widen_u64(wrapping_sub(first, saved.first));
        let offset = wrapping_add(saved.offset, wrapping_mul(index, HOME_WORD_BYTES));
        let scaled = offset / HOME_WORD_BYTES;
        if (remaining & sh(1, next)) != 0 && scaled <= PAIR_IMM7_MAX {
            let opcode = if load {
                MEMORY_PAIR | MEMORY_LOAD
            } else {
                MEMORY_PAIR
            };
            push32(
                inout out,
                opcode
                    | sh(wrapping_u32(scaled), PAIR_IMM7_SHIFT)
                    | sh(next, PAIR_SECOND_REGISTER_SHIFT)
                    | sh(SP, RN_SHIFT)
                    | first
            );
            remaining = remaining & ~sh(1, next);
        } else {
            memory(inout out, load, QWORD_BITS, SP, first, offset);
        }
    }
}

fn emit_call(
    inout out: ChunkSeq[u8],
    in words: Slice[u64],
    in locations: ChunkSeq[u32],
    in record: Record,
    index: u64,
    used: u32,
    frame_bytes: u64,
    keep_result: bool,
    keep_high: bool,
    inout relocations: ChunkSeq[u64]
) -> Option[u32] {
    let start = wrapping_sub(index, record.right);
    let mut save = used;
    let mut overwritten: u32 = 0;
    let mut reload: u32 = 0;
    for arg in 0..record.right {
        let source = location(in locations, read_record(in words, wrapping_add(start, arg)).left);
        if source == UNASSIGNED {
            return Option::None;
        }
        let dest = wrapping_u32(arg);
        if source != dest {
            let dest_bit = sh(1, dest);
            // An argument left in its own register still holds the initial
            // value when a later argument reads from it.
            if source < dest && (overwritten & sh(1, source)) != 0 {
                save = save | sh(1, source);
                reload = reload | dest_bit;
            }
            overwritten = overwritten | dest_bit;
        }
    }
    let save_base = call_save_slot(frame_bytes, 0);
    frame_registers(
        inout out,
        in SavedRegisters { mask: save, first: 0, offset: save_base },
        false
    );
    for arg in 0..record.right {
        let source = location(in locations, read_record(in words, wrapping_add(start, arg)).left);
        let dest = wrapping_u32(arg);
        if source >= SPILL_BASE {
            let _ = materialize(inout out, source, dest, frame_bytes);
        } else if (reload & sh(1, dest)) != 0 {
            memory(
                inout out,
                true,
                QWORD_BITS,
                SP,
                dest,
                call_save_slot(frame_bytes, widen_u64(source))
            );
        } else if source != dest {
            rrr(inout out, ORR_REG, dest, ZERO, source);
        }
    }
    relocations.push(out.len());
    if record.left < LIBCALL_TARGET_BASE {
        relocations.push(ARM64_CALL);
        relocations.push(record.left);
    } else {
        relocations.push(ARM64_LIBCALL);
        relocations.push(wrapping_sub(record.left, LIBCALL_TARGET_BASE));
    }
    push32(inout out, BRANCH_AND_LINK);
    let result = if keep_result && (used & sh(1, FIRST_RESULT)) != 0 {
        // The restore below writes x0 when its incoming contents are live.
        rrr(inout out, ORR_REG, SCRATCH, ZERO, FIRST_RESULT);
        SCRATCH
    } else {
        FIRST_RESULT
    };
    if keep_high {
        // The low result's allocator runs before the high result is placed.
        rrr(inout out, ORR_REG, SECOND_SCRATCH, ZERO, SECOND_RESULT);
    }
    frame_registers(inout out, in SavedRegisters { mask: used, first: 0, offset: save_base }, true);
    Option::Some(result)
}

fn write_instruction(inout output: ChunkSeq[u8], offset: u64, instruction: u32) {
    for index in 0..INSTRUCTION_BYTES {
        let shift = wrapping_u32(wrapping_mul(index, BYTE_BITS));
        let byte = wrapping_u8(wrapping_shr_u32(instruction, shift));
        let _ = output.try_set(wrapping_add(offset, index), byte);
    }
}

fn patch_branch(inout output: ChunkSeq[u8], in branch: Branch, target: u64) -> bool {
    // AArch64 displacements count instructions from the branch itself.
    let delta = wrapping_i64(wrapping_sub(target, branch.offset));
    let distance = wrapping_shr_i64(delta, INSTRUCTION_SHIFT);
    let (reach, shift) = if branch.instruction == JUMP {
        (BRANCH_IMM26_REACH, 0)
    } else {
        (BRANCH_IMM19_REACH, BRANCH_IMM19_SHIFT)
    };
    if distance < wrapping_sub(0, reach) || distance >= reach {
        return false;
    }
    let mask = wrapping_sub(sh(wrapping_u32(reach), 1), 1);
    let instruction = branch.instruction | sh(wrapping_u32(distance) & mask, shift);
    write_instruction(inout output, branch.offset, instruction);
    true
}

fn compare_table_index(inout output: ChunkSeq[u8], index: u32, cases: u64) {
    // The bounds check and the table address both use the low 32 bits.
    match arithmetic_immediate(cases) {
        Option::Some(encoded) => {
            push32(inout output, (CMP_IMM & ~REG64) | encoded | sh(index, RN_SHIFT));
        },
        Option::None => {
            immediate(inout output, SCRATCH, cases);
            rrr(inout output, SUBS_REG & ~REG64, ZERO, index, SCRATCH);
        },
    };
}

fn emit_table_lookup(inout output: ChunkSeq[u8], index: u32, long_tables: bool) {
    // Mask a speculatively out-of-range index before it can reach the load.
    let select = (CSEL & ~REG64) | sh(HS, CONDITION_SHIFT);
    rrr(inout output, select, SECOND_SCRATCH, ZERO, index);
    push32(inout output, CSDB);
    push32(inout output, ADR_TABLE | SCRATCH);
    let load = if long_tables {
        LDRSW_UXTW_SCALED
    } else {
        LDRSH_UXTW_SCALED
    };
    rrr(inout output, load, SECOND_SCRATCH, SCRATCH, SECOND_SCRATCH);
    let add = if long_tables {
        ADD_REG
    } else {
        ADD_REG | ADD_INSTRUCTION_SCALE
    };
    rrr(inout output, add, SECOND_SCRATCH, SCRATCH, SECOND_SCRATCH);
    push32(inout output, BRANCH_REGISTER | sh(SECOND_SCRATCH, RN_SHIFT));
}

fn patch_table_entry(
    inout output: ChunkSeq[u8],
    in entry: TableFixup,
    target: u64,
    long_tables: bool
) -> bool {
    let delta = wrapping_i64(wrapping_sub(target, entry.base));
    if long_tables {
        if delta < wrapping_sub(0, LONG_TABLE_REACH) || delta >= LONG_TABLE_REACH {
            return false;
        }
        write_instruction(inout output, entry.offset, wrapping_u32(delta));
    } else {
        let distance = wrapping_shr_i64(delta, INSTRUCTION_SHIFT);
        if distance < wrapping_sub(0, SHORT_TABLE_REACH) || distance >= SHORT_TABLE_REACH {
            return false;
        }
        let distance = wrapping_u32(distance);
        let _ = output.try_set(entry.offset, wrapping_u8(distance));
        let high = wrapping_u8(wrapping_shr_u32(distance, wrapping_u32(BYTE_BITS)));
        let _ = output.try_set(wrapping_add(entry.offset, 1), high);
    }
    true
}

pub fn encode_leaf(in words: Slice[u64]) -> ChunkSeq[u8] {
    let mut relocations = ChunkSeq::new[u64]();
    encode(in words, false, inout relocations)
}

pub fn encode(
    in words: Slice[u64],
    allow_relocations: bool,
    inout relocations: ChunkSeq[u64]
) -> ChunkSeq[u8] {
    let mut allocation = Allocation::RegisterHomes;
    let mut long_tables = false;
    let mut use_callee_registers = true;
    for attempt in 0..ENCODING_ATTEMPTS {
        let mut retry: Option[Retry] = Option::None;
        let mut references = ChunkSeq::new[u64]();
        let code = encode_pass(
            in words,
            allocation,
            long_tables,
            use_callee_registers,
            allow_relocations,
            inout retry,
            inout references
        );
        match retry {
            Option::Some(Retry::Allocate(next)) => allocation = next,
            Option::Some(Retry::LongTables) => long_tables = true,
            Option::Some(Retry::WithoutCalleeRegisters) => use_callee_registers = false,
            Option::None => {
                if code.len() != 0 {
                    relocations.extend(in references.as_slice());
                }
                return code;
            },
        };
    }
    ChunkSeq::new[u8]()
}

fn encode_pass(
    in words: Slice[u64],
    allocation: Allocation,
    long_tables: bool,
    use_callee_registers: bool,
    allow_relocations: bool,
    inout retry: Option[Retry],
    inout relocations: ChunkSeq[u64]
) -> ChunkSeq[u8] {
    let mut out = ChunkSeq::new[u8]();
    if words.len() < HEADER_WORDS {
        return out;
    }
    let args = word_at(in words, ARGUMENT_COUNT);
    let result = word_at(in words, RETURN_VALUE);
    let body = wrapping_sub(words.len(), HEADER_WORDS);
    let count = body / RECORD_WORDS;
    let values = wrapping_add(args, count);
    if args > ARGUMENT_REGISTERS
        || body % RECORD_WORDS != 0
        || (result != NO_VALUE && result >= values)
    {
        return out;
    }
    let frame = match frame_layout(in words, count) {
        Option::Some(frame) => frame,
        Option::None => return out,
    };
    let entry = read_record(in words, frame.slots.len());
    let labeled = frame.slots.len() < count && entry.op == BLOCK_LABEL;
    let last_index = wrapping_sub(count, 1);
    let tail = read_record(in words, last_index);
    let terminal_trap = !labeled && count != 0 && tail.op == TRAP;
    if terminal_trap
        && (result != NO_VALUE || tail.left > PAIRED_RESULTS || tail.right != 0 || tail.extra != 0)
    {
        return out;
    }
    let mut second = NO_VALUE;
    if !labeled && count != 0 && tail.op == RETURN_PAIR {
        if result == NO_VALUE
            || tail.left >= wrapping_add(args, last_index)
            || tail.right != 0
            || tail.extra != 0
        {
            return out;
        }
        second = tail.left;
    }
    if labeled
        && (result != NO_VALUE
            || entry.extra > PAIRED_RESULTS
            || (entry.right != 0 && entry.right != frame.slots.len())
            || !valid_block_layout(in words, frame.slots.len(), count, entry.extra))
    {
        return out;
    }
    let returns = if labeled {
        entry.extra
    } else if terminal_trap {
        tail.left
    } else if second != NO_VALUE {
        PAIRED_RESULTS
    } else if result != NO_VALUE {
        1
    } else {
        0
    };
    let register_home = (
        match allocation {
            Allocation::RegisterHomes | Allocation::SpillsWithRegisterHomes => true,
            _ => false,
        }
    )
        && labeled
        && entry.right != 0;
    let home_slot = if register_home {
        wrapping_sub(entry.right, 1)
    } else {
        NO_VALUE
    };
    let mut home_candidates: u32 = 0;
    let mut unpromotable_homes: u32 = 0;
    let mut home_cells = ChunkSeq::new[HomeCell]();
    let mut home_aliases = ChunkSeq::new[u64]();
    let mut normal_returns: u64 = 0;
    if register_home {
        for index in 0..HOME_REGISTERS {
            home_cells.push(HomeCell { width: 0, next_store: values });
        }
    }
    let mut frame_used = false;
    let mut ends = ChunkSeq::with_capacity[u64](values);
    for index in 0..values {
        ends.push(NEVER_READ);
    }
    if result != NO_VALUE {
        let _ = ends.try_set(result, values);
    }
    if second != NO_VALUE {
        let _ = ends.try_set(second, values);
    }
    let mut live_values = if result != NO_VALUE { 1 } else { 0 };
    if second != NO_VALUE && second != result {
        live_values = wrapping_add(live_values, 1);
    }
    let mut arms = ChunkSeq::new[BranchArm]();
    let mut depth: u64 = 0;
    let mut block_end = values;
    let mut entry_end = values;
    let mut call_end = NEVER_READ;
    let mut pending_arguments: u64 = 0;
    let mut needs_call_pair = false;
    let mut needs_checked = false;
    let mut has_float = false;
    let mut call_sites = ChunkSeq::new[u64]();
    let mut max_live_across_calls: u64 = 0;
    for reverse in 0..count {
        let index = wrapping_sub(wrapping_sub(count, 1), reverse);
        let value = wrapping_add(args, index);
        let r = read_record(in words, index);
        has_float = has_float || (r.op >= FLOAT_CONSTANT && r.op <= FLOAT_COPY_SIGN);
        if register_home && r.op == BLOCK_RETURN && r.left != TRAP_VALUE {
            normal_returns = wrapping_add(normal_returns, 1);
        }
        if needs_call_pair != (r.op == CALL_PAIR)
            || needs_checked != is_checked_arithmetic(r.op)
            || (r.op == RETURN_PAIR && (labeled || index != last_index))
            || (r.op == TRAP && (!terminal_trap || index != last_index))
            || (is_symbol(r.op) && !allow_relocations)
        {
            return out;
        }
        needs_call_pair = r.op == CALL_HIGH;
        needs_checked = r.op == OVERFLOW_FLAG;
        if consumes_carry(r.op) {
            if index < CHECKED_ARITHMETIC_RECORDS
                || r.extra != wrapping_sub(value, 1)
                || read_record(in words, wrapping_sub(index, 1)).op != OVERFLOW_FLAG
            {
                return out;
            }
            let low = read_record(in words, wrapping_sub(index, CHECKED_ARITHMETIC_RECORDS));
            let expected = if r.op == ADD_CARRY {
                UNSIGNED_ADD_OVERFLOW
            } else {
                UNSIGNED_SUB_OVERFLOW
            };
            if low.op != expected || low.extra != QWORD_BITS {
                return out;
            }
        }
        if r.op == CALL_ARGUMENT {
            if pending_arguments == 0 {
                return out;
            }
            pending_arguments = wrapping_sub(pending_arguments, 1);
        } else if pending_arguments != 0 {
            return out;
        }
        if direct_call(r.op) {
            if !allow_relocations || r.right > index {
                return out;
            }
            pending_arguments = r.right;
            call_end = value;
        }
        let n = match operands(in r, returns) {
            Option::Some(n) => n,
            Option::None => return out,
        };
        if (n >= 1 && r.left >= value)
            || (n >= 2 && r.right >= value)
            || (n == 3 && r.extra >= value)
        {
            return out;
        }
        if r.op == CALL_ARGUMENT && float_value(in words, args, r.left) {
            return out;
        }
        let last = last_read(in ends, value);
        if last != NEVER_READ {
            live_values = wrapping_sub(live_values, 1);
        }
        if direct_call(r.op) {
            call_sites.push(value);
            if live_values > max_live_across_calls {
                max_live_across_calls = live_values;
            }
        }
        if labeled {
            if r.op == BLOCK_LABEL {
                entry_end = block_end;
                block_end = value;
            } else if last != NEVER_READ && last >= block_end {
                // Values crossing a block boundary must use stack homes.
                return out;
            }
        } else if (r.op >= BLOCK_LABEL && r.op <= BRANCH_BLOCK)
            || r.op == BRANCH_TABLE
            || r.op == BRANCH_TABLE_TARGET
        {
            return out;
        }
        if r.op == STACK_SLOT && index >= frame.slots.len() {
            return out;
        }
        if is_stack_load(r.op) || r.op == STACK_ADDRESS || is_stack_store(r.op) {
            if stack_displacement(in frame, in r).is_none() {
                return out;
            }
            if last != NEVER_READ || is_stack_store(r.op) {
                if register_home {
                    // An address or an unaligned access prevents independent cell promotion.
                    let store = is_stack_store(r.op);
                    let slot = if store { r.right } else { r.left };
                    let offset = if store { r.extra } else { r.right };
                    if slot == home_slot
                        && (r.op == STACK_ADDRESS || offset % HOME_WORD_BYTES != 0)
                    {
                        unpromotable_homes = ~0;
                    }
                    let cell = widen_u64(home_cell(in r, home_slot));
                    match home_cells.try_get(cell) {
                        Option::Some(previous) => {
                            let width = if store { store_width(r.op) } else { r.extra };
                            let bit = sh(1, wrapping_u32(cell));
                            if previous.width != 0 && previous.width != width {
                                unpromotable_homes = unpromotable_homes | bit;
                            }
                            home_candidates = home_candidates | bit;
                            let next_store = if store { value } else { previous.next_store };
                            if store || previous.width == 0 {
                                let _ = home_cells.try_set(
                                    cell,
                                    HomeCell { width: width, next_store: next_store }
                                );
                            }
                            if !store && last <= next_store {
                                // Until the next store, the home itself holds this SSA value.
                                home_aliases.push(index);
                            }
                        },
                        Option::None => frame_used = true,
                    };
                } else {
                    frame_used = true;
                }
            }
        }
        let arm = arms.try_get(wrapping_sub(depth, 1))
            .unwrap_or(BranchArm { start: NO_VALUE, end: values });
        if r.op == EARLY_RETURN {
            if r.extra < args || r.extra >= value || (depth != 0 && r.extra <= arm.start) {
                return out;
            }
            let nested = BranchArm { start: r.extra, end: value };
            if depth == arms.len() {
                arms.push(nested);
            } else {
                let _ = arms.try_set(depth, nested);
            }
            depth = wrapping_add(depth, 1);
        } else if r.op == BRANCH_ZERO {
            if depth == 0 || arm.start != value {
                return out;
            }
            depth = wrapping_sub(depth, 1);
        } else if depth != 0 && (value <= arm.start || last > arm.end) {
            // Values defined in a skipped arm are unavailable at its target.
            return out;
        }
        if no_result(r.op) {
            if last != NEVER_READ {
                return out;
            }
        } else if last == NEVER_READ
            && !is_integer_division(r.op)
            && !is_atomic_rmw(r.op)
            && r.op != ATOMIC_LOAD
            && !live_overflow_flag(in ends, value, r.op)
        {
            continue;
        }
        if n >= 1 && last_read(in ends, r.left) == NEVER_READ {
            let end = if r.op == CALL_ARGUMENT {
                call_end
            } else {
                value
            };
            let _ = ends.try_set(r.left, end);
            live_values = wrapping_add(live_values, 1);
        }
        if n >= 2 && last_read(in ends, r.right) == NEVER_READ {
            let _ = ends.try_set(r.right, value);
            live_values = wrapping_add(live_values, 1);
        }
        if n == 3 && last_read(in ends, r.extra) == NEVER_READ {
            let _ = ends.try_set(r.extra, value);
            live_values = wrapping_add(live_values, 1);
        }
    }
    if depth != 0 || pending_arguments != 0 || needs_call_pair || needs_checked {
        return out;
    }
    if has_float
        && ((result != NO_VALUE && float_value(in words, args, result))
            || (second != NO_VALUE && float_value(in words, args, second))
            || !valid_float_operands(in words, args, count, returns == PAIRED_RESULTS, false))
    {
        return out;
    }

    let has_calls = call_sites.len() != 0;
    let callee_count = if use_callee_registers && call_sites.len() >= CALLS_FOR_CALLEE_REGISTERS {
        if max_live_across_calls < CALLEE_REGISTERS {
            max_live_across_calls
        } else {
            CALLEE_REGISTERS
        }
    } else {
        0
    };
    // Keep the registers used by temporaries live across calls available.
    let (home_first, home_limit) = if has_calls {
        let remaining = if use_callee_registers {
            wrapping_sub(CALLEE_REGISTERS, callee_count)
        } else {
            0
        };
        (wrapping_add(FIRST_CALLEE_REGISTER, wrapping_u32(callee_count)), remaining)
    } else {
        (wrapping_u32(ARGUMENT_REGISTERS), HOME_REGISTERS)
    };
    let home_range = wrapping_sub(sh(1, wrapping_u32(home_limit)), 1);
    let homes = home_candidates & ~unpromotable_homes & home_range;
    let home_mask = sh(homes, home_first);
    let spill_mode = match allocation {
        Allocation::Spills | Allocation::SpillsWithRegisterHomes => true,
        _ => false,
    };
    let local_bytes = if frame_used || homes != home_candidates {
        frame.size
    } else {
        0
    };
    let mut callee_mask = sh(
        wrapping_sub(sh(1, wrapping_u32(callee_count)), 1),
        FIRST_CALLEE_REGISTER
    );
    if has_calls {
        callee_mask = callee_mask | home_mask;
    }
    let callee = SavedRegisters {
        mask: callee_mask,
        first: FIRST_CALLEE_REGISTER,
        offset: local_bytes
    };
    let callee_slots = if callee_mask == 0 {
        0
    } else {
        widen_u64(wrapping_sub(
            wrapping_sub(UNASSIGNED, leading_zeros_u32(callee_mask)),
            FIRST_CALLEE_REGISTER
        ))
    };
    let callee_bytes = align_up(wrapping_mul(callee_slots, HOME_WORD_BYTES), STACK_ALIGNMENT);
    let call_base = wrapping_add(local_bytes, callee_bytes);
    let link_slot = if has_calls { call_base } else { NO_VALUE };
    let frame_bytes = if has_calls {
        wrapping_add(call_base, call_frame_bytes())
    } else {
        local_bytes
    };
    if frame_bytes > MAX_FRAME_BYTES {
        if callee_mask != 0 {
            retry = Option::Some(Retry::WithoutCalleeRegisters);
        }
        return out;
    }
    let adjustment = arithmetic_immediate(frame_bytes).unwrap_or(0);
    if spill_mode || adjustment != 0 {
        push32(inout out, stack_adjust(SUB_IMM, adjustment));
    }
    if has_calls {
        memory(inout out, false, QWORD_BITS, SP, LINK_REGISTER, link_slot);
    }
    frame_registers(inout out, in callee, false);
    let register_mask = if spill_mode {
        SPILL_REGISTER_MASK
    } else {
        CALLER_REGISTER_MASK
    };
    let mut spills = ChunkSeq::new[u64]();
    let mut restores = ChunkSeq::new[u64]();
    let mut locations = ChunkSeq::with_capacity[u32](values);
    let mut used: u32 = 0;
    let mut flags_for_next: Option[u32] = Option::None;
    let mut branches = ChunkSeq::new[Branch]();
    let mut labels = ChunkSeq::new[Label]();
    let mut fixups = ChunkSeq::new[LabelBranch]();
    let mut table_fixups = ChunkSeq::new[TableFixup]();
    let mut remaining_aliases = home_aliases.len();
    let mut next_alias = home_aliases.try_get(wrapping_sub(remaining_aliases, 1)).unwrap_or(count);
    let mut remaining_calls = call_sites.len();
    let mut next_call = call_sites.try_get(wrapping_sub(remaining_calls, 1)).unwrap_or(values);
    if labeled {
        for index in 0..count {
            labels.push(Label { address: NO_VALUE, block: false });
        }
    }
    for arg in 0..args {
        let reg = wrapping_u32(arg);
        let mut assigned = reg;
        let last = last_read(in ends, arg);
        if last != NEVER_READ {
            if labeled && last >= entry_end {
                return ChunkSeq::new[u8]();
            }
            let available = callee_mask & ~used & ~home_mask;
            if available != 0 && last > next_call {
                assigned = trailing_zeros_u64(widen_u64(available));
                rrr(inout out, ORR_REG, assigned, ZERO, reg);
            }
            used = used | sh(1, assigned);
        }
        locations.push(assigned);
    }
    for index in 0..count {
        let value = wrapping_add(args, index);
        let r = read_record(in words, index);
        let stored = store_width(r.op);
        let last = last_read(in ends, value);
        let live = last != NEVER_READ;
        let calls = direct_call(r.op);
        let division = is_integer_division(r.op);
        let atomic_rmw = is_atomic_rmw(r.op);
        let atomic = atomic_rmw || r.op == ATOMIC_LOAD;
        let checked = is_checked_arithmetic(r.op);
        let overflow_live = checked && last_read(in ends, wrapping_add(value, 1)) != NEVER_READ;
        if r.op == STACK_SLOT
            || r.op == BRANCH_TABLE_TARGET
            || r.op == CALL_ARGUMENT
            || r.op == RETURN_PAIR
            || r.op == TRAP
            || (!calls && !division && !atomic && !no_result(r.op) && !live && !overflow_live)
        {
            locations.push(UNASSIGNED);
            continue;
        }
        if r.op == FENCE {
            push32(inout out, DMB_ISH);
            locations.push(UNASSIGNED);
            continue;
        }
        let call_result = if calls {
            remaining_calls = wrapping_sub(remaining_calls, 1);
            next_call = call_sites.try_get(wrapping_sub(remaining_calls, 1)).unwrap_or(values);
            let start = wrapping_sub(index, r.right);
            for arg in 0..r.right {
                let source = read_record(in words, wrapping_add(start, arg)).left;
                used = expire(used, in ends, source, value, location(in locations, source));
            }
            let reg = match emit_call(
                inout out,
                in words,
                in locations,
                in r,
                index,
                used & CALLER_REGISTER_MASK,
                frame_bytes,
                live,
                r.op == CALL_PAIR && last_read(in ends, wrapping_add(value, 1)) != NEVER_READ,
                inout relocations
            ) {
                Option::Some(reg) => reg,
                Option::None => return ChunkSeq::new[u8](),
            };
            if !live {
                locations.push(UNASSIGNED);
                continue;
            }
            reg
        } else if r.op == CALL_HIGH {
            SECOND_SCRATCH
        } else {
            UNASSIGNED
        };
        if r.op == BLOCK_LABEL || r.op == EDGE_LABEL {
            let old = labels.try_get(r.left).unwrap_or(Label { address: 0, block: false });
            if old.address != NO_VALUE {
                return ChunkSeq::new[u8]();
            }
            let _ = labels
                .try_set(r.left, Label { address: out.len(), block: r.op == BLOCK_LABEL });
            locations.push(UNASSIGNED);
            continue;
        }
        if r.op == JUMP_LABEL {
            if r.left == 0 || r.left >= count {
                return ChunkSeq::new[u8]();
            }
            let next_index = wrapping_add(index, 1);
            let next = read_record(in words, next_index);
            if next_index == count || next.op != BLOCK_LABEL || next.left != r.left {
                let branch = Branch { offset: out.len(), instruction: JUMP };
                fixups.push(LabelBranch { branch: branch, target: r.left, block: true });
                push32(inout out, JUMP);
            }
            locations.push(UNASSIGNED);
            continue;
        }
        let n = operands(in r, returns).unwrap_or(0);
        let left = if n >= 1 {
            location(in locations, r.left)
        } else {
            UNASSIGNED
        };
        let right = if n >= 2 {
            location(in locations, r.right)
        } else {
            UNASSIGNED
        };
        let extra = if n == 3 {
            location(in locations, r.extra)
        } else {
            UNASSIGNED
        };
        if n >= 1 {
            used = expire(used, in ends, r.left, value, left);
        }
        if n >= 2 {
            used = expire(used, in ends, r.right, value, right);
        }
        if n == 3 {
            used = expire(used, in ends, r.extra, value, extra);
        }
        if stored != 0 || r.op == ATOMIC_STORE {
            if r.op == ATOMIC_STORE {
                let address = materialize(inout out, left, SPILL_LEFT, frame_bytes);
                let source = store_source(inout out, right, SPILL_RIGHT, frame_bytes);
                push32(inout out, STORE_RELEASE | atomic_address(r.extra, address) | source);
            } else if is_stack_store(r.op) {
                let source = store_source(inout out, left, SPILL_LEFT, frame_bytes);
                let displacement = stack_displacement(in frame, in r).unwrap_or(0);
                let home = if homes != 0 {
                    home_register(home_first, home_cell(in r, home_slot), homes)
                } else {
                    UNASSIGNED
                };
                if home != UNASSIGNED {
                    write_home(inout out, home, source, stored);
                } else {
                    memory(inout out, false, stored, SP, source, displacement);
                }
            } else {
                let address = materialize(inout out, left, SPILL_LEFT, frame_bytes);
                let source = store_source(inout out, right, SPILL_RIGHT, frame_bytes);
                memory(inout out, false, stored, address, source, r.extra);
            }
            locations.push(UNASSIGNED);
            continue;
        }
        let mut lhs = materialize(inout out, left, SPILL_LEFT, frame_bytes);
        let mut rhs = materialize(inout out, right, SPILL_RIGHT, frame_bytes);
        let third = if consumes_carry(r.op) {
            UNASSIGNED
        } else {
            materialize(inout out, extra, SPILL_THIRD, frame_bytes)
        };
        if checked && !live {
            emit_checked(inout out, in r, ZERO, lhs, rhs, overflow_live);
            locations.push(UNASSIGNED);
            continue;
        }
        if atomic && !live {
            emit_atomic(inout out, in r, SCRATCH, lhs, rhs);
            locations.push(UNASSIGNED);
            continue;
        }
        if division {
            if r.extra < DWORD_BITS {
                let (narrow_lhs, narrow_rhs) = narrow_division_operands(inout out, in r, lhs, rhs);
                lhs = narrow_lhs;
                rhs = narrow_rhs;
            }
            division_checks(inout out, in r, lhs, rhs);
            if !live {
                locations.push(UNASSIGNED);
                continue;
            }
        }
        if r.op == BRANCH_TABLE {
            compare_table_index(inout out, lhs, r.right);
            let instruction = BRANCH_IF_CONDITION | HS;
            let default = Branch { offset: out.len(), instruction: instruction };
            fixups.push(LabelBranch { branch: default, target: r.extra, block: true });
            push32(inout out, instruction);
            emit_table_lookup(inout out, lhs, long_tables);
            let base = out.len();
            for case in 0..r.right {
                let target = read_record(in words, wrapping_add(wrapping_add(index, 1), case));
                table_fixups
                    .push(TableFixup { target: target.left, offset: out.len(), base: base });
                if long_tables {
                    push32(inout out, 0);
                } else {
                    push16(inout out, 0);
                }
            }
            if !long_tables && r.right % SHORT_ENTRIES_PER_INSTRUCTION != 0 {
                push16(inout out, 0);
            }
            locations.push(UNASSIGNED);
            continue;
        }
        if conditional_branch(r.op) {
            let instruction = match flags_for_next {
                Option::Some(cc) => BRANCH_IF_CONDITION | (cc ^ 1),
                Option::None => BRANCH_IF_ZERO | lhs,
            };
            flags_for_next = Option::None;
            let branch = Branch { offset: out.len(), instruction: instruction };
            if r.op != BRANCH_ZERO {
                fixups.push(LabelBranch {
                    branch: branch,
                    target: r.right,
                    block: r.op == BRANCH_BLOCK
                });
            } else {
                if depth == branches.len() {
                    branches.push(branch);
                } else {
                    let _ = branches.try_set(depth, branch);
                }
                depth = wrapping_add(depth, 1);
            }
            push32(inout out, instruction);
            locations.push(UNASSIGNED);
            continue;
        }
        if r.op == EARLY_RETURN || r.op == BLOCK_RETURN {
            if r.left == TRAP_VALUE {
                push32(inout out, TRAP_INSTRUCTION);
            } else {
                emit_return(
                    inout out,
                    lhs,
                    rhs,
                    adjustment,
                    spill_mode,
                    link_slot,
                    in callee,
                    inout restores
                );
            }
            if r.op == EARLY_RETURN {
                depth = wrapping_sub(depth, 1);
                let target = out.len();
                match branches.try_get(depth) {
                    Option::Some(branch) => if !patch_branch(inout out, in branch, target) {
                        return ChunkSeq::new[u8]();
                    },
                    Option::None => return ChunkSeq::new[u8](),
                };
            }
            locations.push(UNASSIGNED);
            continue;
        }
        let overflow_cc = if r.op == OVERFLOW_FLAG {
            Option::Some(overflow_condition(read_record(in words, wrapping_sub(index, 1)).op))
        } else {
            Option::None
        };
        if (comparison_width(r.op) != 0 || overflow_cc.is_some()) && last > value && last < values {
            let consumer = wrapping_sub(last, args);
            let following = wrapping_add(index, 1);
            let next = read_record(in words, consumer);
            if consumer == following
                && overflow_cc.is_some()
                && consumes_carry(next.op)
                && next.left != value
                && next.right != value
            {
                // The high operation reads carry directly from NZCV.
                locations.push(UNASSIGNED);
                continue;
            }
            if next.left == value
                && (conditional_branch(next.op)
                    || ((next.op == SELECT || next.op == FLOAT_SELECT)
                        && next.right != value
                        && next.extra != value))
                && (consumer == following
                    || flags_survive_stack_stores(in words, following, consumer, value))
            {
                flags_for_next = match overflow_cc {
                    Option::Some(cc) => Option::Some(cc),
                    Option::None => {
                        compare(inout out, in r, lhs, rhs);
                        Option::Some(condition(r.extra))
                    },
                };
                locations.push(UNASSIGNED);
                continue;
            }
        }
        let home = if homes != 0 && is_stack_load(r.op) {
            home_register(home_first, home_cell(in r, home_slot), homes)
        } else {
            UNASSIGNED
        };
        if index == next_alias {
            remaining_aliases = wrapping_sub(remaining_aliases, 1);
            next_alias = home_aliases.try_get(wrapping_sub(remaining_aliases, 1)).unwrap_or(count);
            if home != UNASSIGNED {
                locations.push(home);
                continue;
            }
        }
        // A failed store retries with both original operands.
        let atomic_operands = if atomic_rmw {
            sh(1, lhs) | sh(1, rhs)
        } else {
            0
        };
        let unavailable = used | home_mask | atomic_operands;
        let preserved = if last > next_call {
            callee_mask & ~unavailable
        } else {
            0
        };
        let available = if preserved != 0 {
            preserved
        } else {
            register_mask & ~unavailable
        };
        let assigned = if available != 0 {
            let reg = trailing_zeros_u64(widen_u64(available));
            used = used | sh(1, reg);
            reg
        } else if spill_mode {
            if (r.op == CONSTANT || r.op == FLOAT_CONSTANT) && r.left == 0 {
                locations.push(REMATERIALIZED_ZERO);
                continue;
            }
            match allocate_spill(inout spills, frame_bytes, value, last) {
                Option::Some(spill) => spill,
                Option::None => {
                    if callee_mask != 0 {
                        retry = Option::Some(Retry::WithoutCalleeRegisters);
                    }
                    return ChunkSeq::new[u8]();
                },
            }
        } else {
            let next = if has_calls
                && home_mask != 0
                && worth_spilling_with_homes(in words, in home_aliases, homes, normal_returns)
            {
                Allocation::SpillsWithRegisterHomes
            } else if home_mask != 0 {
                Allocation::StackHomes
            } else {
                Allocation::Spills
            };
            retry = Option::Some(Retry::Allocate(next));
            return ChunkSeq::new[u8]();
        };
        locations.push(assigned);
        let dest = if assigned >= SPILL_BASE {
            SPILL_RESULT
        } else {
            assigned
        };
        if call_result != UNASSIGNED {
            if dest != call_result {
                rrr(inout out, ORR_REG, dest, ZERO, call_result);
            }
        } else if checked {
            emit_checked(inout out, in r, dest, lhs, rhs, overflow_live);
        } else if atomic {
            emit_atomic(inout out, in r, dest, lhs, rhs);
        } else if r.op == OVERFLOW_FLAG {
            let cc = overflow_cc.unwrap_or(EQ);
            push32(inout out, CSET | sh(cc ^ 1, CONDITION_SHIFT) | dest);
        } else if is_symbol(r.op) {
            // The hosted object module supports GOT pairs on ELF and Mach-O,
            // including for data defined in this object.
            relocations.push(out.len());
            relocations.push(ARM64_GOT_PAGE);
            relocations.push(r.left);
            push32(inout out, ADRP | dest);
            relocations.push(out.len());
            relocations.push(ARM64_GOT_LOAD);
            relocations.push(r.left);
            memory(inout out, true, QWORD_BITS, dest, dest, 0);
        } else if r.op == STACK_ADDRESS || is_stack_load(r.op) {
            let displacement = stack_displacement(in frame, in r).unwrap_or(0);
            if r.op == STACK_ADDRESS {
                let encoded = arithmetic_immediate(displacement).unwrap_or(0);
                push32(inout out, ADD_IMM | encoded | sh(SP, RN_SHIFT) | dest);
            } else if home != UNASSIGNED {
                rrr(inout out, ORR_REG, dest, ZERO, home);
            } else {
                memory(inout out, true, r.extra, SP, dest, displacement);
            }
        } else {
            match flags_for_next {
                Option::Some(cc) => {
                    rrr(inout out, CSEL | sh(cc, CONDITION_SHIFT), dest, rhs, third);
                    flags_for_next = Option::None;
                },
                Option::None => emit_instruction(inout out, in r, dest, lhs, rhs, third),
            };
        }
        if assigned >= SPILL_BASE {
            memory(inout out, false, QWORD_BITS, SP, dest, spill_offset(frame_bytes, assigned));
        }
    }
    if labeled {
        for index in 0..fixups.len() {
            match fixups.try_get(index) {
                Option::Some(fixup) => match labels.try_get(fixup.target) {
                    Option::Some(label) => {
                        if label.address == NO_VALUE
                            || label.block != fixup.block
                            || !patch_branch(inout out, in fixup.branch, label.address)
                        {
                            return ChunkSeq::new[u8]();
                        }
                    },
                    Option::None => return ChunkSeq::new[u8](),
                },
                Option::None => return ChunkSeq::new[u8](),
            };
        }
        for index in 0..table_fixups.len() {
            let entry = match table_fixups.try_get(index) {
                Option::Some(entry) => entry,
                Option::None => return ChunkSeq::new[u8](),
            };
            let label = match labels.try_get(entry.target) {
                Option::Some(label) => label,
                Option::None => return ChunkSeq::new[u8](),
            };
            if label.address == NO_VALUE || !label.block {
                return ChunkSeq::new[u8]();
            }
            if !patch_table_entry(inout out, in entry, label.address, long_tables) {
                if !long_tables {
                    retry = Option::Some(Retry::LongTables);
                }
                return ChunkSeq::new[u8]();
            }
        }
    } else if terminal_trap {
        push32(inout out, TRAP_INSTRUCTION);
    } else {
        let low = materialize(inout out, location(in locations, result), SPILL_LEFT, frame_bytes);
        let high = materialize(inout out, location(in locations, second), SPILL_RIGHT, frame_bytes);
        emit_return(
            inout out,
            low,
            high,
            adjustment,
            spill_mode,
            link_slot,
            in callee,
            inout restores
        );
    }
    if spill_mode {
        let size = align_up(
            wrapping_add(frame_bytes, wrapping_mul(spills.len(), HOME_WORD_BYTES)),
            STACK_ALIGNMENT
        );
        let adjusted = arithmetic_immediate(size).unwrap_or(0);
        write_instruction(inout out, 0, stack_adjust(SUB_IMM, adjusted));
        for index in 0..restores.len() {
            match restores.try_get(index) {
                Option::Some(offset) => write_instruction(
                    inout out,
                    offset,
                    stack_adjust(ADD_IMM, adjusted)
                ),
                Option::None => return ChunkSeq::new[u8](),
            };
        }
    }
    out
}
