// AAPCS64 integer leaves. The input is the shared scalar
// machine tape. Unsupported operations or register pressure decline before
// a function is defined.
use @vesper/codegen-freestanding::util::{push32};
use self::scalar::{
    Record, FrameSlot, Label, align_up, word_at, read_record, valid_block_layout, CONSTANT, ADD,
    SUB, MUL, AND, OR, XOR, NEG, NOT, SHL, SHR, SAR, COMPARE, COMPARE_BYTE, COMPARE_WORD,
    COMPARE_DWORD, SELECT, TRUNCATE, ZERO_EXTEND, SIGN_EXTEND, SHL_REGISTER, SHR_REGISTER,
    SAR_REGISTER, LOAD, STORE_BYTE, STORE_WORD, STORE_DWORD, STORE_QWORD, BRANCH_ZERO, EARLY_RETURN,
    STACK_SLOT, STACK_ADDRESS, STACK_LOAD, STACK_STORE_BYTE, STACK_STORE_WORD, STACK_STORE_DWORD,
    STACK_STORE_QWORD, SIGNED_MUL_HIGH, UNSIGNED_MUL_HIGH, ADD_IMMEDIATE, SUB_IMMEDIATE,
    MUL_IMMEDIATE, AND_IMMEDIATE, OR_IMMEDIATE, XOR_IMMEDIATE, COMPARE_IMMEDIATE,
    COMPARE_BYTE_IMMEDIATE, COMPARE_WORD_IMMEDIATE, COMPARE_DWORD_IMMEDIATE, EQUAL, NOT_EQUAL,
    SIGNED_LESS, SIGNED_GREATER_EQUAL, SIGNED_GREATER, SIGNED_LESS_EQUAL, UNSIGNED_LESS,
    UNSIGNED_GREATER_EQUAL, UNSIGNED_GREATER, UNSIGNED_LESS_EQUAL, BLOCK_LABEL, EDGE_LABEL,
    JUMP_LABEL, BRANCH_LABEL, BLOCK_RETURN, BRANCH_BLOCK, ARGUMENT_COUNT, RETURN_VALUE,
    HEADER_WORDS, RECORD_WORDS, NEVER_READ, NO_VALUE, DISP32_MASK
};
use self::x86_64::{BYTE_BITS, WORD_BITS, DWORD_BITS, QWORD_BITS};

const ARGUMENT_REGISTERS: u64 = 8;
// Keep x16 and x17 out of allocation for architectural scratch uses.
const CALLER_REGISTER_MASK: u32 = 0xffff;
const UNASSIGNED: u32 = 32;
const SCRATCH: u32 = 16;
const COMPARE_LEFT_SCRATCH: u32 = 17;
const ZERO: u32 = 31;
const SP: u32 = 31;
const STACK_ALIGNMENT: u64 = 16;
// Larger frames need to probe the stack at least once per base page.
const MAX_FRAME_BYTES: u64 = 4096;
const RETURN: u32 = 0xd65f03c0;
const JUMP: u32 = 0x14000000;
const BRANCH_IF_ZERO: u32 = 0xb4000000;
const BRANCH_IF_CONDITION: u32 = 0x54000000;
const BRANCH_IMM19_SHIFT: u32 = 5;
const BRANCH_IMM19_REACH: i64 = 0x40000;
const BRANCH_IMM26_REACH: i64 = 0x2000000;
const INSTRUCTION_BYTES: u64 = 4;
const INSTRUCTION_SHIFT: u32 = 2;
const ADD_REG: u32 = 0x8b000000;
const SUB_REG: u32 = 0xcb000000;
const MUL_REG: u32 = 0x9b007c00;
const SMULH_REG: u32 = 0x9b407c00;
const UMULH_REG: u32 = 0x9bc07c00;
const AND_REG: u32 = 0x8a000000;
const ORR_REG: u32 = 0xaa000000;
const EOR_REG: u32 = 0xca000000;
const ORN_REG: u32 = 0xaa200000;
const LSL_REG: u32 = 0x9ac02000;
const LSR_REG: u32 = 0x9ac02400;
const ASR_REG: u32 = 0x9ac02800;
const ADD_IMM: u32 = 0x91000000;
const SUB_IMM: u32 = 0xd1000000;
const AND_IMM: u32 = 0x92000000;
const ORR_IMM: u32 = 0xb2000000;
const EOR_IMM: u32 = 0xd2000000;
const CMP_IMM: u32 = 0xf100001f;
const CMN_IMM: u32 = 0xb100001f;
const SUBS_REG: u32 = 0xeb000000;
const UBFM: u32 = 0xd3400000;
const SBFM: u32 = 0x93400000;
const REG64: u32 = 0x80000000;
const BITFIELD64: u32 = 0x80400000;
const CSET: u32 = 0x9a9f07e0;
const CSEL: u32 = 0x9a800000;
const MOVN: u32 = 0x92800000;
const MOVZ: u32 = 0xd2800000;
const MOVK: u32 = 0xf2800000;
const MEMORY_SCALED: u32 = 0x39000000;
const MEMORY_UNSCALED: u32 = 0x38000000;
const MEMORY_REGISTER: u32 = 0x38206800;
const MEMORY_LOAD: u32 = 0x00400000;
const MEMORY_SIZE_SHIFT: u32 = 30;
const MEMORY_IMM9_SHIFT: u32 = 12;
const MEMORY_IMM9_MASK: u32 = 0x1ff;
const MEMORY_IMM9_MIN: i64 = -256;
const MEMORY_IMM9_MAX: i64 = 255;
const RM_SHIFT: u32 = 16;
const RN_SHIFT: u32 = 5;
const CONDITION_SHIFT: u32 = 12;
const IMM12_SHIFT: u32 = 10;
const IMM12_MASK: u64 = 0xfff;
const IMM12_SCALE: u32 = 12;
const IMM12_SCALED: u32 = 0x00400000;
const BITMASK_N: u32 = 0x00400000;
const IMMR_SHIFT: u32 = 16;
const IMMS_SHIFT: u32 = 10;
const SHIFT_MASK: u64 = QWORD_BITS - 1;
const BITMASK_ELEMENT_HALVINGS: u64 = 5;
const HALFWORDS: u64 = 4;
const HALFWORD_BITS: u64 = 16;
const HALFWORD_MASK: u64 = 0xffff;
const HALFWORD_SHIFT: u32 = 21;
const IMM16_SHIFT: u32 = 5;

const EQ: u32 = 0;
const NE: u32 = 1;
const HS: u32 = 2;
const LO: u32 = 3;
const HI: u32 = 8;
const LS: u32 = 9;
const GE: u32 = 10;
const LT: u32 = 11;
const GT: u32 = 12;
const LE: u32 = 13;

copy struct BranchArm {
    start: u64,
    end: u64,
}

copy struct Branch {
    offset: u64,
    instruction: u32,
}

copy struct LabelBranch {
    branch: Branch,
    target: u64,
    block: bool,
}

struct FrameLayout {
    slots: ChunkSeq[FrameSlot],
    size: u64,
}

fn sh(value: u32, amount: u32) -> u32 {
    wrapping_shl_u32(value, amount)
}

fn rrr(inout out: ChunkSeq[u8], op: u32, dest: u32, lhs: u32, rhs: u32) {
    push32(inout out, op | sh(rhs, RM_SHIFT) | sh(lhs, RN_SHIFT) | dest);
}

fn bitfield(inout out: ChunkSeq[u8], op: u32, dest: u32, source: u32, rotate: u64, last: u64) {
    push32(
        inout out,
        op
            | sh(wrapping_u32(rotate), IMMR_SHIFT)
            | sh(wrapping_u32(last), IMMS_SHIFT)
            | sh(source, RN_SHIFT)
            | dest
    );
}

fn scalar_width(width: u64) -> bool {
    width == BYTE_BITS || width == WORD_BITS || width == DWORD_BITS || width == QWORD_BITS
}

fn scalar_opcode_mask(width: u64) -> u32 {
    if width == DWORD_BITS { ~REG64 } else { ~0 }
}

fn low_bits(bits: u64, width: u64) -> u64 {
    bits & wrapping_shr_u64(~0, wrapping_u32(wrapping_sub(QWORD_BITS, width)))
}

fn normalize(inout out: ChunkSeq[u8], register: u32, width: u64) {
    if width != QWORD_BITS {
        bitfield(inout out, UBFM, register, register, 0, wrapping_sub(width, 1));
    }
}

fn halfword(bits: u64, index: u64) -> u64 {
    wrapping_shr_u64(bits, wrapping_u32(wrapping_mul(index, HALFWORD_BITS))) & HALFWORD_MASK
}

// A logical immediate is a power-of-two element repeated across the register.
// The element contains one circular run of ones and at least one zero.
fn bitmask_immediate(bits: u64) -> Option[u32] {
    if bits == 0 || bits == ~0 {
        return Option::None;
    }
    let mut width = QWORD_BITS;
    let mut mask: u64 = ~0;
    for _ in 0..BITMASK_ELEMENT_HALVINGS {
        let half = width / 2;
        let half_mask = wrapping_shr_u64(mask, wrapping_u32(half));
        if (bits & half_mask) != ((wrapping_shr_u64(bits, wrapping_u32(half))) & half_mask) {
            break;
        }
        width = half;
        mask = half_mask;
    }
    let element = bits & mask;
    let last = wrapping_u32(wrapping_sub(width, 1));
    let previous = (wrapping_shl_u64(element, 1) & mask) | wrapping_shr_u64(element, last);
    let starts = element & ~previous;
    if (starts & wrapping_sub(starts, 1)) != 0 {
        return Option::None;
    }
    let start = trailing_zeros_u64(starts);
    let rotation = wrapping_sub(0, start) & last;
    let run = wrapping_shr_u64(element, start) | (wrapping_shl_u64(element, rotation) & mask);
    let ones = trailing_zeros_u64(~run);
    let size = (sh(~last, 1) | wrapping_sub(ones, 1)) & wrapping_u32(SHIFT_MASK);
    let n = if width == QWORD_BITS { BITMASK_N } else { 0 };
    Option::Some(n | sh(rotation, IMMR_SHIFT) | sh(size, IMMS_SHIFT))
}

fn immediate(inout out: ChunkSeq[u8], dest: u32, bits: u64) {
    let mut zero_parts: u64 = 0;
    let mut one_parts: u64 = 0;
    for index in 0..HALFWORDS {
        let part = halfword(bits, index);
        if part == 0 {
            zero_parts = wrapping_add(zero_parts, 1);
        } else if part == HALFWORD_MASK {
            one_parts = wrapping_add(one_parts, 1);
        }
    }
    let inverted = one_parts > zero_parts;
    let filled = if inverted { one_parts } else { zero_parts };
    if filled < wrapping_sub(HALFWORDS, 1) {
        match bitmask_immediate(bits) {
            Option::Some(encoded) => {
                push32(inout out, ORR_IMM | encoded | sh(ZERO, RN_SHIFT) | dest);
                return;
            },
            Option::None => (),
        }
    }
    let fill = if inverted { HALFWORD_MASK } else { 0 };
    let first = if inverted { MOVN } else { MOVZ };
    let mut op = first;
    for index in 0..HALFWORDS {
        let part = halfword(bits, index);
        if part != fill {
            let encoded = if op == MOVN {
                part ^ HALFWORD_MASK
            } else {
                part
            };
            push32(
                inout out,
                op
                    | sh(wrapping_u32(index), HALFWORD_SHIFT)
                    | sh(wrapping_u32(encoded), IMM16_SHIFT)
                    | dest
            );
            op = MOVK;
        }
    }
    if op == first {
        push32(inout out, first | dest);
    }
}

fn condition(code: u64) -> u32 {
    match code {
        EQUAL => EQ,
        NOT_EQUAL => NE,
        SIGNED_LESS => LT,
        SIGNED_GREATER_EQUAL => GE,
        SIGNED_GREATER => GT,
        SIGNED_LESS_EQUAL => LE,
        UNSIGNED_LESS => LO,
        UNSIGNED_GREATER_EQUAL => HS,
        UNSIGNED_GREATER => HI,
        _ => LS,
    }
}

fn magnitude(signed: i64) -> u64 {
    wrapping_u64(
        if signed < 0 {
            wrapping_sub(0, signed)
        } else {
            signed
        }
    )
}

fn arithmetic_immediate(amount: u64) -> Option[u32] {
    if amount <= IMM12_MASK {
        return Option::Some(sh(wrapping_u32(amount), IMM12_SHIFT));
    }
    let scaled = wrapping_shr_u64(amount, IMM12_SCALE);
    if (amount & IMM12_MASK) == 0 && scaled <= IMM12_MASK {
        return Option::Some(IMM12_SCALED | sh(wrapping_u32(scaled), IMM12_SHIFT));
    }
    Option::None
}

fn comparison_width(op: u64) -> u64 {
    match op {
        COMPARE | COMPARE_IMMEDIATE => QWORD_BITS,
        COMPARE_DWORD | COMPARE_DWORD_IMMEDIATE => DWORD_BITS,
        COMPARE_WORD | COMPARE_WORD_IMMEDIATE => WORD_BITS,
        COMPARE_BYTE | COMPARE_BYTE_IMMEDIATE => BYTE_BITS,
        _ => 0,
    }
}

fn comparison_uses_immediate(op: u64) -> bool {
    op >= COMPARE_IMMEDIATE && op <= COMPARE_DWORD_IMMEDIATE
}

fn compare(inout out: ChunkSeq[u8], in r: Record, lhs: u32, rhs: u32) {
    let width = comparison_width(r.op);
    let reg_mask = scalar_opcode_mask(width);
    let signed_narrow = width < DWORD_BITS
        && r.extra >= SIGNED_LESS
        && r.extra <= SIGNED_LESS_EQUAL;
    let mut lhs = lhs;
    if signed_narrow {
        bitfield(inout out, SBFM, COMPARE_LEFT_SCRATCH, lhs, 0, wrapping_sub(width, 1));
        lhs = COMPARE_LEFT_SCRATCH;
    }
    if comparison_uses_immediate(r.op) {
        let signed = if width >= DWORD_BITS || signed_narrow {
            widen_i64(wrapping_i32(r.right))
        } else {
            wrapping_i64(low_bits(r.right, width))
        };
        match arithmetic_immediate(magnitude(signed)) {
            Option::Some(encoded) => {
                let op = if signed < 0 { CMN_IMM } else { CMP_IMM };
                push32(inout out, (op & reg_mask) | encoded | sh(lhs, RN_SHIFT));
            },
            Option::None => {
                immediate(inout out, SCRATCH, wrapping_u64(signed));
                rrr(inout out, SUBS_REG & reg_mask, ZERO, lhs, SCRATCH);
            },
        }
    } else {
        let mut rhs = rhs;
        if signed_narrow {
            bitfield(inout out, SBFM, SCRATCH, rhs, 0, wrapping_sub(width, 1));
            rhs = SCRATCH;
        }
        rrr(inout out, SUBS_REG & reg_mask, ZERO, lhs, rhs);
    }
}

fn store_width(op: u64) -> u64 {
    match op {
        STORE_BYTE | STACK_STORE_BYTE => BYTE_BITS,
        STORE_WORD | STACK_STORE_WORD => WORD_BITS,
        STORE_DWORD | STACK_STORE_DWORD => DWORD_BITS,
        STORE_QWORD | STACK_STORE_QWORD => QWORD_BITS,
        _ => 0,
    }
}

fn is_stack_store(op: u64) -> bool {
    op >= STACK_STORE_BYTE && op <= STACK_STORE_QWORD
}

fn frame_layout(in words: Slice[u64], count: u64) -> Option[FrameLayout] {
    let mut slots = ChunkSeq::new[FrameSlot]();
    let mut used: u64 = 0;
    for index in 0..count {
        let r = read_record(in words, index);
        if r.op != STACK_SLOT {
            break;
        }
        let alignment = r.right;
        if alignment == 0
            || alignment > STACK_ALIGNMENT
            || (alignment & wrapping_sub(alignment, 1)) != 0
            || r.left > MAX_FRAME_BYTES
            || r.extra != 0
        {
            return Option::None;
        }
        let offset = align_up(used, alignment);
        used = wrapping_add(offset, r.left);
        if used > MAX_FRAME_BYTES {
            return Option::None;
        }
        slots.push(FrameSlot { offset: offset, size: r.left });
    }
    Option::Some(FrameLayout { slots: slots, size: align_up(used, STACK_ALIGNMENT) })
}

fn stack_displacement(in frame: FrameLayout, in r: Record) -> Option[u64] {
    let store = is_stack_store(r.op);
    let index = if store { r.right } else { r.left };
    let offset = if store { r.extra } else { r.right };
    let width = if store { store_width(r.op) } else { r.extra };
    match frame.slots.try_get(index) {
        Option::Some(slot) => {
            if offset <= slot.size && width / BYTE_BITS <= wrapping_sub(slot.size, offset) {
                Option::Some(wrapping_add(slot.offset, offset))
            } else {
                Option::None
            }
        },
        Option::None => Option::None,
    }
}

fn memory(
    inout out: ChunkSeq[u8],
    load: bool,
    width: u64,
    address: u32,
    data: u32,
    displacement: u64
) {
    let bytes = width / BYTE_BITS;
    let scale = trailing_zeros_u64(bytes);
    let size = sh(scale, MEMORY_SIZE_SHIFT);
    let opcode = size | (if load { MEMORY_LOAD } else { 0 });
    let offset = widen_i64(wrapping_i32(displacement));
    let unsigned = wrapping_u64(offset);
    let scaled = wrapping_shr_u64(unsigned, scale);
    if offset >= 0 && (unsigned & wrapping_sub(bytes, 1)) == 0 && scaled <= IMM12_MASK {
        push32(
            inout out,
            MEMORY_SCALED
                | opcode
                | sh(wrapping_u32(scaled), IMM12_SHIFT)
                | sh(address, RN_SHIFT)
                | data
        );
    } else if offset >= MEMORY_IMM9_MIN && offset <= MEMORY_IMM9_MAX {
        let imm = wrapping_u32(offset) & MEMORY_IMM9_MASK;
        push32(
            inout out,
            MEMORY_UNSCALED | opcode | sh(imm, MEMORY_IMM9_SHIFT) | sh(address, RN_SHIFT) | data
        );
    } else {
        immediate(inout out, SCRATCH, unsigned);
        rrr(inout out, MEMORY_REGISTER | opcode, data, address, SCRATCH);
    }
}

fn conditional_branch(op: u64) -> bool {
    op == BRANCH_ZERO || op == BRANCH_BLOCK || op == BRANCH_LABEL
}

fn operands(in r: Record) -> Option[u64] {
    if r.op == CONSTANT || r.op == STACK_SLOT || r.op == BLOCK_LABEL {
        return Option::Some(0);
    }
    if r.op == EDGE_LABEL || r.op == JUMP_LABEL {
        return if r.right == 0 && r.extra == 0 {
            Option::Some(0)
        } else {
            Option::None
        };
    }
    if comparison_width(r.op) != 0 {
        if r.extra > UNSIGNED_LESS_EQUAL {
            return Option::None;
        }
        if !comparison_uses_immediate(r.op) {
            return Option::Some(2);
        }
        if r.right <= DISP32_MASK {
            return Option::Some(1);
        }
        return Option::None;
    }
    if r.op == SELECT {
        return Option::Some(3);
    }
    if conditional_branch(r.op) {
        if r.extra == 0 && (r.right == 0) == (r.op == BRANCH_ZERO) {
            return Option::Some(1);
        }
        return Option::None;
    }
    if r.op == EARLY_RETURN || r.op == BLOCK_RETURN {
        if r.right != 0 || (r.op == BLOCK_RETURN && r.extra != 0) {
            return Option::None;
        }
        return Option::Some(if r.left == NO_VALUE { 0 } else { 1 });
    }
    if r.op == STACK_LOAD || r.op == STACK_ADDRESS {
        if (r.op == STACK_LOAD && scalar_width(r.extra))
            || (r.op == STACK_ADDRESS && r.extra == 0)
        {
            return Option::Some(0);
        }
        return Option::None;
    }
    if is_stack_store(r.op) {
        return Option::Some(1);
    }
    if store_width(r.op) != 0 {
        if r.extra <= DISP32_MASK {
            return Option::Some(2);
        }
        return Option::None;
    }
    if !scalar_width(r.extra) {
        return Option::None;
    }
    match r.op {
        LOAD => if r.right <= DISP32_MASK {
            Option::Some(1)
        } else {
            Option::None
        },
        ADD | SUB | MUL | AND | OR | XOR => Option::Some(2),
        SHL_REGISTER | SHR_REGISTER | SAR_REGISTER => if r.extra >= DWORD_BITS {
            Option::Some(2)
        } else {
            Option::None
        },
        SIGNED_MUL_HIGH | UNSIGNED_MUL_HIGH => if r.extra == QWORD_BITS {
            Option::Some(2)
        } else {
            Option::None
        },
        TRUNCATE => if scalar_width(r.right) && r.right > r.extra {
            Option::Some(1)
        } else {
            Option::None
        },
        ZERO_EXTEND | SIGN_EXTEND => if scalar_width(r.right) && r.right < r.extra {
            Option::Some(1)
        } else {
            Option::None
        },
        NEG | NOT | SHL | SHR | SAR => Option::Some(1),
        ADD_IMMEDIATE
            | SUB_IMMEDIATE
            | MUL_IMMEDIATE
            | AND_IMMEDIATE
            | OR_IMMEDIATE
            | XOR_IMMEDIATE => if r.right
            <= DISP32_MASK
        {
            Option::Some(1)
        } else {
            Option::None
        },
        _ => Option::None,
    }
}

fn emit_instruction(
    inout out: ChunkSeq[u8],
    in r: Record,
    dest: u32,
    lhs: u32,
    rhs: u32,
    third: u32
) {
    if r.op == CONSTANT {
        immediate(inout out, dest, r.left);
    } else if r.op == LOAD {
        memory(inout out, true, r.extra, lhs, dest, r.right);
    } else if r.op == TRUNCATE || r.op == ZERO_EXTEND || r.op == SIGN_EXTEND {
        if r.op == SIGN_EXTEND {
            let op = if r.extra == DWORD_BITS {
                SBFM & ~BITFIELD64
            } else {
                SBFM
            };
            bitfield(inout out, op, dest, lhs, 0, wrapping_sub(r.right, 1));
            if r.extra < DWORD_BITS {
                normalize(inout out, dest, r.extra);
            }
        } else {
            if r.op == TRUNCATE {
                bitfield(inout out, UBFM, dest, lhs, 0, wrapping_sub(r.extra, 1));
            } else if dest != lhs {
                rrr(inout out, ORR_REG, dest, ZERO, lhs);
            }
        }
    } else if r.op == NEG || r.op == NOT {
        let op = if r.op == NEG { SUB_REG } else { ORN_REG };
        let reg_mask = scalar_opcode_mask(r.extra);
        rrr(inout out, op & reg_mask, dest, ZERO, lhs);
        if r.extra < DWORD_BITS {
            normalize(inout out, dest, r.extra);
        }
    } else if r.op == SHL || r.op == SHR || r.op == SAR {
        let width_mask = wrapping_sub(r.extra, 1);
        let count = r.right & width_mask;
        if count == 0 {
            if dest != lhs {
                rrr(inout out, ORR_REG, dest, ZERO, lhs);
            }
            return;
        }
        let mut op = if r.op == SAR { SBFM } else { UBFM };
        let register_mask = if r.extra > DWORD_BITS {
            SHIFT_MASK
        } else {
            DWORD_BITS - 1
        };
        let (rotate, last) = if r.op == SHL {
            (wrapping_sub(0, count) & register_mask, wrapping_sub(width_mask, count))
        } else {
            (count, width_mask)
        };
        if r.extra <= DWORD_BITS {
            op = op & ~BITFIELD64;
        }
        bitfield(inout out, op, dest, lhs, rotate, last);
        if r.op == SAR && r.extra < DWORD_BITS {
            normalize(inout out, dest, r.extra);
        }
    } else if r.op == SELECT {
        rrr(inout out, SUBS_REG, ZERO, lhs, ZERO);
        rrr(inout out, CSEL | sh(NE, CONDITION_SHIFT), dest, rhs, third);
    } else if comparison_width(r.op) != 0 {
        compare(inout out, in r, lhs, rhs);
        push32(inout out, CSET | sh(condition(r.extra) ^ 1, CONDITION_SHIFT) | dest);
    } else {
        let reg_mask = scalar_opcode_mask(r.extra);
        let mut rhs = rhs;
        if r.op >= ADD_IMMEDIATE && r.op <= XOR_IMMEDIATE {
            let signed = widen_i64(wrapping_i32(r.right));
            if r.op == ADD_IMMEDIATE || r.op == SUB_IMMEDIATE {
                match arithmetic_immediate(magnitude(signed)) {
                    Option::Some(encoded) => {
                        let subtract = (r.op == SUB_IMMEDIATE) != (signed < 0);
                        let op = if subtract { SUB_IMM } else { ADD_IMM };
                        push32(inout out, (op & reg_mask) | encoded | sh(lhs, RN_SHIFT) | dest);
                        if r.extra < DWORD_BITS {
                            normalize(inout out, dest, r.extra);
                        }
                        return;
                    },
                    Option::None => (),
                }
            } else if r.op != MUL_IMMEDIATE {
                match bitmask_immediate(low_bits(wrapping_u64(signed), r.extra)) {
                    Option::Some(encoded) => {
                        let op = match r.op {
                            AND_IMMEDIATE => AND_IMM,
                            OR_IMMEDIATE => ORR_IMM,
                            _ => EOR_IMM,
                        };
                        push32(inout out, op | encoded | sh(lhs, RN_SHIFT) | dest);
                        return;
                    },
                    Option::None => (),
                }
            }
            immediate(inout out, SCRATCH, wrapping_u64(signed));
            rhs = SCRATCH;
        }
        let op = match r.op {
            SIGNED_MUL_HIGH => SMULH_REG,
            UNSIGNED_MUL_HIGH => UMULH_REG,
            ADD | ADD_IMMEDIATE => ADD_REG,
            SUB | SUB_IMMEDIATE => SUB_REG,
            MUL | MUL_IMMEDIATE => MUL_REG,
            AND | AND_IMMEDIATE => AND_REG,
            OR | OR_IMMEDIATE => ORR_REG,
            XOR | XOR_IMMEDIATE => EOR_REG,
            SHL_REGISTER => LSL_REG,
            SHR_REGISTER => LSR_REG,
            _ => ASR_REG,
        };
        rrr(inout out, op & reg_mask, dest, lhs, rhs);
        if r.extra < DWORD_BITS {
            normalize(inout out, dest, r.extra);
        }
    }
}

fn last_read(in ends: ChunkSeq[u64], value: u64) -> u64 {
    ends.try_get(value).unwrap_or(NEVER_READ)
}

fn register(in regs: ChunkSeq[u32], id: u64) -> u32 {
    regs.try_get(id).unwrap_or(UNASSIGNED)
}

fn expire(used: u32, in ends: ChunkSeq[u64], value: u64, current: u64, reg: u32) -> u32 {
    if reg != UNASSIGNED && last_read(in ends, value) == current {
        used & ~sh(1, reg)
    } else {
        used
    }
}

fn no_result(op: u64) -> bool {
    op == BRANCH_ZERO
        || op == EARLY_RETURN
        || op == STACK_SLOT
        || store_width(op) != 0
        || (op >= BLOCK_LABEL && op <= BRANCH_BLOCK)
}

fn emit_stack_adjust(inout output: ChunkSeq[u8], opcode: u32, adjustment: u32) {
    if adjustment != 0 {
        push32(inout output, opcode | adjustment | sh(SP, RN_SHIFT) | SP);
    }
}

fn emit_return(inout output: ChunkSeq[u8], reg: u32, adjustment: u32) {
    if reg != UNASSIGNED && reg != 0 {
        rrr(inout output, ORR_REG, 0, ZERO, reg);
    }
    emit_stack_adjust(inout output, ADD_IMM, adjustment);
    push32(inout output, RETURN);
}

fn patch_branch(inout output: ChunkSeq[u8], in branch: Branch, target: u64) -> bool {
    // AArch64 displacements count instructions from the branch itself.
    let delta = wrapping_i64(wrapping_sub(target, branch.offset));
    let distance = wrapping_shr_i64(delta, INSTRUCTION_SHIFT);
    let (reach, shift) = if branch.instruction == JUMP {
        (BRANCH_IMM26_REACH, 0)
    } else {
        (BRANCH_IMM19_REACH, BRANCH_IMM19_SHIFT)
    };
    if distance < wrapping_sub(0, reach) || distance >= reach {
        return false;
    }
    let mask = wrapping_sub(sh(wrapping_u32(reach), 1), 1);
    let instruction = branch.instruction | sh(wrapping_u32(distance) & mask, shift);
    for index in 0..INSTRUCTION_BYTES {
        let shift = wrapping_u32(wrapping_mul(index, BYTE_BITS));
        let byte = wrapping_u8(wrapping_shr_u32(instruction, shift));
        let _ = output.try_set(wrapping_add(branch.offset, index), byte);
    }
    true
}

pub fn encode_leaf(in words: Slice[u64]) -> ChunkSeq[u8] {
    let mut out = ChunkSeq::new[u8]();
    if words.len() < HEADER_WORDS {
        return out;
    }
    let args = word_at(in words, ARGUMENT_COUNT);
    let result = word_at(in words, RETURN_VALUE);
    let body = wrapping_sub(words.len(), HEADER_WORDS);
    let count = body / RECORD_WORDS;
    let values = wrapping_add(args, count);
    if args > ARGUMENT_REGISTERS
        || body % RECORD_WORDS != 0
        || (result != NO_VALUE && result >= values)
    {
        return out;
    }
    let frame = match frame_layout(in words, count) {
        Option::Some(frame) => frame,
        Option::None => return out,
    };
    let entry = read_record(in words, frame.slots.len());
    let labeled = frame.slots.len() < count && entry.op == BLOCK_LABEL;
    if labeled
        && (result != NO_VALUE
            || entry.extra > 1
            || (entry.right != 0 && entry.right != frame.slots.len())
            || !valid_block_layout(in words, frame.slots.len(), count, entry.extra))
    {
        return out;
    }
    let mut frame_used = false;
    let mut ends = ChunkSeq::with_capacity[u64](values);
    for index in 0..values {
        ends.push(NEVER_READ);
    }
    if result != NO_VALUE {
        let _ = ends.try_set(result, values);
    }
    let mut arms = ChunkSeq::new[BranchArm]();
    let mut depth: u64 = 0;
    let mut block_end = values;
    let mut entry_end = values;
    for reverse in 0..count {
        let index = wrapping_sub(wrapping_sub(count, 1), reverse);
        let value = wrapping_add(args, index);
        let r = read_record(in words, index);
        let n = match operands(in r) {
            Option::Some(n) => n,
            Option::None => return out,
        };
        if (n >= 1 && r.left >= value)
            || (n >= 2 && r.right >= value)
            || (n == 3 && r.extra >= value)
        {
            return out;
        }
        let last = last_read(in ends, value);
        if labeled {
            if r.op == BLOCK_LABEL {
                entry_end = block_end;
                block_end = value;
            } else if (last != NEVER_READ && last >= block_end)
                || (r.op == BLOCK_RETURN && (r.left == NO_VALUE) != (entry.extra == 0))
            {
                // Values crossing a block boundary must use stack homes.
                return out;
            }
        } else if r.op >= BLOCK_LABEL && r.op <= BRANCH_BLOCK {
            return out;
        }
        if r.op == STACK_SLOT && index >= frame.slots.len() {
            return out;
        }
        if r.op == STACK_LOAD || r.op == STACK_ADDRESS || is_stack_store(r.op) {
            match stack_displacement(in frame, in r) {
                Option::Some(_) => {},
                Option::None => return out,
            };
            frame_used = frame_used || last != NEVER_READ || is_stack_store(r.op);
        }
        let arm = arms.try_get(wrapping_sub(depth, 1))
            .unwrap_or(BranchArm { start: NO_VALUE, end: values });
        if r.op == EARLY_RETURN {
            if ((r.left == NO_VALUE) != (result == NO_VALUE))
                || r.extra < args
                || r.extra >= value
                || (depth != 0 && r.extra <= arm.start)
            {
                return out;
            }
            let nested = BranchArm { start: r.extra, end: value };
            if depth == arms.len() {
                arms.push(nested);
            } else {
                let _ = arms.try_set(depth, nested);
            }
            depth = wrapping_add(depth, 1);
        } else if r.op == BRANCH_ZERO {
            if depth == 0 || arm.start != value {
                return out;
            }
            depth = wrapping_sub(depth, 1);
        } else if depth != 0 && (value <= arm.start || last > arm.end) {
            // Values defined in a skipped arm are unavailable at its target.
            return out;
        }
        if no_result(r.op) {
            if last != NEVER_READ {
                return out;
            }
        } else if last == NEVER_READ {
            continue;
        }
        if n >= 1 && last_read(in ends, r.left) == NEVER_READ {
            let _ = ends.try_set(r.left, value);
        }
        if n >= 2 && last_read(in ends, r.right) == NEVER_READ {
            let _ = ends.try_set(r.right, value);
        }
        if n == 3 && last_read(in ends, r.extra) == NEVER_READ {
            let _ = ends.try_set(r.extra, value);
        }
    }
    if depth != 0 {
        return out;
    }

    let adjustment = if frame_used {
        arithmetic_immediate(frame.size).unwrap_or(0)
    } else {
        0
    };
    emit_stack_adjust(inout out, SUB_IMM, adjustment);
    let mut regs = ChunkSeq::with_capacity[u32](values);
    let mut used: u32 = 0;
    let mut flags_for_next: Option[u32] = Option::None;
    let mut branches = ChunkSeq::new[Branch]();
    let mut labels = ChunkSeq::new[Label]();
    let mut fixups = ChunkSeq::new[LabelBranch]();
    if labeled {
        for index in 0..count {
            labels.push(Label { address: NO_VALUE, block: false });
        }
    }
    for arg in 0..args {
        let reg = wrapping_u32(arg);
        regs.push(reg);
        let last = last_read(in ends, arg);
        if last != NEVER_READ {
            if labeled && last >= entry_end {
                return ChunkSeq::new[u8]();
            }
            used = used | sh(1, reg);
        }
    }
    for index in 0..count {
        let value = wrapping_add(args, index);
        let r = read_record(in words, index);
        let stored = store_width(r.op);
        if r.op == STACK_SLOT || (!no_result(r.op) && last_read(in ends, value) == NEVER_READ) {
            regs.push(UNASSIGNED);
            continue;
        }
        if r.op == BLOCK_LABEL || r.op == EDGE_LABEL {
            let old = labels.try_get(r.left).unwrap_or(Label { address: 0, block: false });
            if old.address != NO_VALUE {
                return ChunkSeq::new[u8]();
            }
            let _ = labels
                .try_set(r.left, Label { address: out.len(), block: r.op == BLOCK_LABEL });
            regs.push(UNASSIGNED);
            continue;
        }
        if r.op == JUMP_LABEL {
            if r.left == 0 || r.left >= count {
                return ChunkSeq::new[u8]();
            }
            let next_index = wrapping_add(index, 1);
            let next = read_record(in words, next_index);
            if next_index == count || next.op != BLOCK_LABEL || next.left != r.left {
                let branch = Branch { offset: out.len(), instruction: JUMP };
                fixups.push(LabelBranch { branch: branch, target: r.left, block: true });
                push32(inout out, JUMP);
            }
            regs.push(UNASSIGNED);
            continue;
        }
        let n = operands(in r).unwrap_or(0);
        let lhs = if n >= 1 {
            register(in regs, r.left)
        } else {
            UNASSIGNED
        };
        let rhs = if n >= 2 {
            register(in regs, r.right)
        } else {
            UNASSIGNED
        };
        let third = if n == 3 {
            register(in regs, r.extra)
        } else {
            UNASSIGNED
        };
        if n >= 1 {
            used = expire(used, in ends, r.left, value, lhs);
        }
        if n >= 2 {
            used = expire(used, in ends, r.right, value, rhs);
        }
        if n == 3 {
            used = expire(used, in ends, r.extra, value, third);
        }
        if conditional_branch(r.op) {
            let instruction = match flags_for_next {
                Option::Some(cc) => BRANCH_IF_CONDITION | (cc ^ 1),
                Option::None => BRANCH_IF_ZERO | lhs,
            };
            flags_for_next = Option::None;
            let branch = Branch { offset: out.len(), instruction: instruction };
            if r.op != BRANCH_ZERO {
                fixups.push(LabelBranch {
                    branch: branch,
                    target: r.right,
                    block: r.op == BRANCH_BLOCK
                });
            } else {
                if depth == branches.len() {
                    branches.push(branch);
                } else {
                    let _ = branches.try_set(depth, branch);
                }
                depth = wrapping_add(depth, 1);
            }
            push32(inout out, instruction);
            regs.push(UNASSIGNED);
            continue;
        }
        if r.op == EARLY_RETURN {
            emit_return(inout out, lhs, adjustment);
            depth = wrapping_sub(depth, 1);
            let target = out.len();
            match branches.try_get(depth) {
                Option::Some(branch) => if !patch_branch(inout out, in branch, target) {
                    return ChunkSeq::new[u8]();
                },
                Option::None => return ChunkSeq::new[u8](),
            };
            regs.push(UNASSIGNED);
            continue;
        }
        if r.op == BLOCK_RETURN {
            emit_return(inout out, lhs, adjustment);
            regs.push(UNASSIGNED);
            continue;
        }
        if stored != 0 {
            if is_stack_store(r.op) {
                let displacement = stack_displacement(in frame, in r).unwrap_or(0);
                memory(inout out, false, stored, SP, lhs, displacement);
            } else {
                memory(inout out, false, stored, lhs, rhs, r.extra);
            }
            regs.push(UNASSIGNED);
            continue;
        }
        if comparison_width(r.op) != 0
            && wrapping_add(index, 1) < count
            && last_read(in ends, value) == wrapping_add(value, 1)
        {
            let next = read_record(in words, wrapping_add(index, 1));
            if next.left == value
                && (conditional_branch(next.op)
                    || (next.op == SELECT && next.right != value && next.extra != value))
            {
                compare(inout out, in r, lhs, rhs);
                flags_for_next = Option::Some(condition(r.extra));
                regs.push(UNASSIGNED);
                continue;
            }
        }
        let available = CALLER_REGISTER_MASK & ~used;
        if available == 0 {
            return ChunkSeq::new[u8]();
        }
        let dest = wrapping_u32(trailing_zeros_u64(widen_u64(available)));
        used = used | sh(1, dest);
        regs.push(dest);
        if r.op == STACK_ADDRESS || r.op == STACK_LOAD {
            let displacement = stack_displacement(in frame, in r).unwrap_or(0);
            if r.op == STACK_ADDRESS {
                let encoded = arithmetic_immediate(displacement).unwrap_or(0);
                push32(inout out, ADD_IMM | encoded | sh(SP, RN_SHIFT) | dest);
            } else {
                memory(inout out, true, r.extra, SP, dest, displacement);
            }
            continue;
        }
        match flags_for_next {
            Option::Some(cc) => {
                rrr(inout out, CSEL | sh(cc, CONDITION_SHIFT), dest, rhs, third);
                flags_for_next = Option::None;
            },
            Option::None => emit_instruction(inout out, in r, dest, lhs, rhs, third),
        };
    }
    if labeled {
        for index in 0..fixups.len() {
            match fixups.try_get(index) {
                Option::Some(fixup) => match labels.try_get(fixup.target) {
                    Option::Some(label) => {
                        if label.address == NO_VALUE
                            || label.block != fixup.block
                            || !patch_branch(inout out, in fixup.branch, label.address)
                        {
                            return ChunkSeq::new[u8]();
                        }
                    },
                    Option::None => return ChunkSeq::new[u8](),
                },
                Option::None => return ChunkSeq::new[u8](),
            };
        }
    } else {
        emit_return(inout out, register(in regs, result), adjustment);
    }
    out
}
