// AAPCS64 functions with register-only integer signatures. The input is the shared scalar
// machine tape. Unsupported operations or oversized frames decline before a
// function is defined.
use @vesper/codegen-freestanding::util::{push16, push32};
use self::scalar::{
    Record, FrameSlot, Label, align_up, word_at, read_record, valid_block_layout, CONSTANT, ADD,
    SUB, MUL, AND, OR, XOR, NEG, NOT, SHL, SHR, SAR, COMPARE, COMPARE_BYTE, COMPARE_WORD,
    COMPARE_DWORD, SELECT, TRUNCATE, ZERO_EXTEND, SIGN_EXTEND, SHL_REGISTER, SHR_REGISTER,
