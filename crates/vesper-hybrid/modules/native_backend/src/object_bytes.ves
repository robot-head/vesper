use @vesper/codegen-freestanding::util::{grow};

pub fn fits(start: u64, size: u64, end: u64) -> bool {
    start <= end && size <= wrapping_sub(end, start)
}

pub fn pad_to(inout out: ChunkSeq[u8], offset: u64) {
    let _ = grow(inout out, wrapping_sub(offset, out.len()));
}

pub fn valid_name(in bytes: Slice[u8], offset: u64, size: u64) -> bool {
    if size == 0 || !fits(offset, size, bytes.len()) {
        return false;
    }
    for index in 0..size {
        if bytes.try_get(wrapping_add(offset, index)).unwrap_or(0) == 0 {
            return false;
        }
    }
    true
}
