// Physical registers and instructions for the x86-64 backend.
pub const RAX: u8 = 0;
const RCX: u8 = 1;
const RDX: u8 = 2;
const RSI: u8 = 6;
const RDI: u8 = 7;
const R8: u8 = 8;
const R9: u8 = 9;
const R10: u8 = 10;
const R11: u8 = 11;

pub const ARGUMENTS: u64 = 6;
pub const UNASSIGNED: u8 = 255;
pub const BYTE_BITS: u64 = 8;
pub const WORD_BITS: u64 = 16;
pub const DWORD_BITS: u64 = 32;
pub const QWORD_BITS: u64 = 64;

const REX: u8 = 0x40;
const REX_W: u8 = 0x48;
const REX_R: u8 = 0x04;
const REX_B: u8 = 0x01;
const LOW_REGISTER_MASK: u8 = 0x07;
const HIGH_REGISTER: u8 = 0x08;
const MOD_REGISTER: u8 = 0xc0;
const MOD_DISP8: u8 = 0x40;
const MOD_DISP32: u8 = 0x80;
const RM_SIB: u8 = 4;
const RM_DISP32_WITHOUT_BASE: u8 = 5;
const SIB_NO_INDEX: u8 = 0x20;
const MOD_FIELD_SHIFT: u32 = 3;
const MOV_RM_R64: u8 = 0x89;
const MOV_R64_RM: u8 = 0x8b;
const MOV_REGISTER_IMMEDIATE: u8 = 0xb8;
const MOV_RM64_IMM32: u8 = 0xc7;
const TWO_BYTE_OPCODE: u8 = 0x0f;
const IMUL_R64_RM64: u8 = 0xaf;
const UNARY_GROUP: u8 = 0xf7;
const SHIFT_BYTE_GROUP_IMM8: u8 = 0xc0;
const OPERAND_SIZE_OVERRIDE: u8 = 0x66;
const SHIFT_GROUP_IMM8: u8 = 0xc1;
const SHIFT_GROUP_CL: u8 = 0xd3;
const XCHG_RM_R64: u8 = 0x87;
const CMP_RM_R8: u8 = 0x38;
const CMP_RM_R64: u8 = 0x39;
const SETCC: u8 = 0x90;
const CMOVCC: u8 = 0x40;
const TEST_RM_R64: u8 = 0x85;
const MOVZX_R32_RM8: u8 = 0xb6;
const MOVSX_R64_RM8: u8 = 0xbe;
const MOVZX_R32_RM16: u8 = 0xb7;
const MOVSX_R64_RM16: u8 = 0xbf;
const MOVSXD_R64_RM32: u8 = 0x63;
const RET_NEAR: u8 = 0xc3;
const U32_MAX_BITS: u64 = 0xffffffff;
const I32_MIN_BITS: u64 = 0xffffffff80000000;
const DISP8_MAX: u32 = 0x7f;
const DISP8_MIN_AS_DISP32: u32 = 0xffffff80;
const IMM32_BYTES: u64 = 4;
const IMM64_BYTES: u64 = 8;

pub const ADD_RM_R64: u8 = 0x01;
pub const SUB_RM_R64: u8 = 0x29;
pub const AND_RM_R64: u8 = 0x21;
pub const OR_RM_R64: u8 = 0x09;
pub const XOR_RM_R64: u8 = 0x31;
pub const NOT_EXTENSION: u8 = 2;
pub const NEG_EXTENSION: u8 = 3;
pub const SHL_EXTENSION: u8 = 4;
pub const SHR_EXTENSION: u8 = 5;
pub const SAR_EXTENSION: u8 = 7;

pub const CC_B: u8 = 2;
pub const CC_AE: u8 = 3;
pub const CC_E: u8 = 4;
pub const CC_NE: u8 = 5;
pub const CC_BE: u8 = 6;
pub const CC_A: u8 = 7;
pub const CC_L: u8 = 12;
pub const CC_GE: u8 = 13;
pub const CC_LE: u8 = 14;
pub const CC_G: u8 = 15;

pub copy enum Instruction {
    Immediate(u8, u64),
    Move(u8, u8),
    Binary(u8, u8, u8, u64),
    Multiply(u8, u8, u64),
    Unary(u8, u8, u64),
    Shift(u8, u8, u8, u64),
    ShiftRegister(u8, u8, u8, u64),
    Load(u8, u8, u32, u64),
    Compare(u8, u8, u8, u8, u64),
    Select(u8, u8, u8, u8, u8),
    Truncate(u8, u8, u64),
    SignExtend(u8, u8, u64, u64),
    Return,
}

pub fn arg_register(argument: u64) -> u8 {
    match argument {
        0 => RDI,
        1 => RSI,
        2 => RDX,
        3 => RCX,
        4 => R8,
        5 => R9,
        _ => UNASSIGNED,
    }
}

pub fn register_bit(reg: u8) -> u32 {
    wrapping_shl_u32(1, widen_u32(reg))
}

// Use caller-saved GPRs exclusively. Prefer rax, the result register.
pub fn find_register(used: u32) -> u8 {
    let candidates = register_bit(RAX)
        | register_bit(RCX)
        | register_bit(RDX)
        | register_bit(RSI)
        | register_bit(RDI)
        | register_bit(R8)
        | register_bit(R9)
        | register_bit(R10)
        | register_bit(R11);
    let available = candidates ^ (candidates & used);
    if available == 0 {
        UNASSIGNED
    } else {
        wrapping_u8(trailing_zeros_u64(widen_u64(available)))
    }
}

fn modrm_fields(reg: u8, rm: u8) -> u8 {
    wrapping_shl_u8(reg & LOW_REGISTER_MASK, MOD_FIELD_SHIFT) | (rm & LOW_REGISTER_MASK)
}

fn modrm(reg: u8, rm: u8) -> u8 {
    MOD_REGISTER | modrm_fields(reg, rm)
}

fn rex(reg: u8, rm: u8, wide: bool) -> u8 {
    let first = if wide { REX_W } else { REX };
    let reg_extension = if reg >= HIGH_REGISTER { REX_R } else { 0 };
    let rm_extension = if rm >= HIGH_REGISTER { REX_B } else { 0 };
    first | reg_extension | rm_extension
}

fn binary(inout out: ChunkSeq[u8], opcode: u8, destination: u8, source: u8, wide: bool) {
    out.push(rex(source, destination, wide));
    out.push(opcode);
    out.push(modrm(source, destination));
}

fn immediate(inout out: ChunkSeq[u8], bits: u64, size: u64) {
    for i in 0..size {
        let shift = wrapping_mul(wrapping_u32(i), wrapping_u32(BYTE_BITS));
        out.push(wrapping_u8(wrapping_shr_u64(bits, shift)));
    }
}

fn load_memory(inout out: ChunkSeq[u8], destination: u8, base: u8, displacement: u32, width: u64) {
    out.push(rex(destination, base, width == QWORD_BITS));
    if width == BYTE_BITS || width == WORD_BITS {
        out.push(TWO_BYTE_OPCODE);
        out.push(
            if width == BYTE_BITS {
                MOVZX_R32_RM8
            } else {
                MOVZX_R32_RM16
            }
        );
    } else {
        out.push(MOV_R64_RM);
    }

    let low_base = base & LOW_REGISTER_MASK;
    let mode = if displacement == 0 && low_base != RM_DISP32_WITHOUT_BASE {
        0
    } else if displacement <= DISP8_MAX || displacement >= DISP8_MIN_AS_DISP32 {
        MOD_DISP8
    } else {
        MOD_DISP32
    };
    out.push(mode | modrm_fields(destination, base));
    if low_base == RM_SIB {
        out.push(SIB_NO_INDEX | low_base);
    }
    if mode == MOD_DISP8 {
        out.push(wrapping_u8(displacement));
    } else if mode == MOD_DISP32 {
        immediate(inout out, widen_u64(displacement), IMM32_BYTES);
    }
}

fn load_constant(inout out: ChunkSeq[u8], destination: u8, bits: u64) {
    if bits == 0 {
        let prefix = rex(destination, destination, false);
        if prefix != REX {
            out.push(prefix);
        }
        out.push(XOR_RM_R64);
        out.push(modrm(destination, destination));
    } else if bits <= U32_MAX_BITS {
        let prefix = rex(0, destination, false);
        if prefix != REX {
            out.push(prefix);
        }
        out.push(MOV_REGISTER_IMMEDIATE | (destination & LOW_REGISTER_MASK));
        immediate(inout out, bits, IMM32_BYTES);
    } else if bits >= I32_MIN_BITS {
        out.push(rex(0, destination, true));
        out.push(MOV_RM64_IMM32);
        out.push(modrm(0, destination));
        immediate(inout out, bits, IMM32_BYTES);
    } else {
        out.push(rex(0, destination, true));
        out.push(MOV_REGISTER_IMMEDIATE | (destination & LOW_REGISTER_MASK));
        immediate(inout out, bits, IMM64_BYTES);
    }
}

fn truncate(inout out: ChunkSeq[u8], destination: u8, source: u8, width: u64) {
    if width == DWORD_BITS {
        // A 32-bit write zeroes the high half, even for a self-move.
        binary(inout out, MOV_RM_R64, destination, source, false);
    } else {
        out.push(rex(destination, source, false));
        out.push(TWO_BYTE_OPCODE);
        out.push(
            if width == BYTE_BITS {
                MOVZX_R32_RM8
            } else {
                MOVZX_R32_RM16
            }
        );
        out.push(modrm(destination, source));
    }
}

fn sign_extend(inout out: ChunkSeq[u8], destination: u8, source: u8, from: u64, width: u64) {
    out.push(rex(destination, source, width == QWORD_BITS));
    if from == DWORD_BITS {
        out.push(MOVSXD_R64_RM32);
    } else {
        out.push(TWO_BYTE_OPCODE);
        out.push(
            if from == BYTE_BITS {
                MOVSX_R64_RM8
            } else {
                MOVSX_R64_RM16
            }
        );
    }
    out.push(modrm(destination, source));
    if width == WORD_BITS {
        truncate(inout out, destination, destination, width);
    }
}

fn normalize_small_result(inout out: ChunkSeq[u8], destination: u8, width: u64) {
    if width < DWORD_BITS {
        truncate(inout out, destination, destination, width);
    }
}

pub fn emit(inout out: ChunkSeq[u8], in instruction: Instruction) {
    match instruction {
        Instruction::Immediate(destination, bits) => load_constant(inout out, destination, bits),
        Instruction::Move(destination, source) => {
            if destination != source {
                binary(inout out, MOV_RM_R64, destination, source, true);
            }
        },
        Instruction::Binary(opcode, destination, source, width) => {
            binary(inout out, opcode, destination, source, width == QWORD_BITS);
            // Low-width bitwise operations preserve the zeroed upper bits.
            if opcode == ADD_RM_R64 || opcode == SUB_RM_R64 {
                normalize_small_result(inout out, destination, width);
            }
        },
        Instruction::Multiply(destination, source, width) => {
            out.push(rex(destination, source, width == QWORD_BITS));
            out.push(TWO_BYTE_OPCODE);
            out.push(IMUL_R64_RM64);
            out.push(modrm(destination, source));
            normalize_small_result(inout out, destination, width);
        },
        Instruction::Unary(extension, destination, width) => {
            out.push(rex(0, destination, width == QWORD_BITS));
            out.push(UNARY_GROUP);
            out.push(modrm(extension, destination));
            normalize_small_result(inout out, destination, width);
        },
        Instruction::Shift(extension, destination, count, width) => {
            if width == WORD_BITS {
                out.push(OPERAND_SIZE_OVERRIDE);
            }
            out.push(rex(0, destination, width == QWORD_BITS));
            out.push(
                if width == BYTE_BITS {
                    SHIFT_BYTE_GROUP_IMM8
                } else {
                    SHIFT_GROUP_IMM8
                }
            );
            out.push(modrm(extension, destination));
            out.push(count);
            normalize_small_result(inout out, destination, width);
        },
        Instruction::ShiftRegister(extension, destination, count, width) => {
            // Legacy shifts read CL. Exchange full registers to preserve a
            // live RCX and restore the count when the operation is finished.
            let shifted = if count == RCX {
                destination
            } else {
                binary(inout out, XCHG_RM_R64, RCX, count, true);
                if destination == RCX {
                    count
                } else if destination == count {
                    RCX
                } else {
                    destination
                }
            };
            out.push(rex(0, shifted, width == QWORD_BITS));
            out.push(SHIFT_GROUP_CL);
            out.push(modrm(extension, shifted));
            if count != RCX {
                binary(inout out, XCHG_RM_R64, RCX, count, true);
            }
        },
        Instruction::Load(destination, base, displacement, width) => load_memory(
            inout out,
            destination,
            base,
            displacement,
            width
        ),
        Instruction::Compare(destination, left, right, cc, width) => {
            if width == WORD_BITS {
                out.push(OPERAND_SIZE_OVERRIDE);
            }
            // REX also selects the low byte of rsi/rdi for byte operations.
            out.push(rex(right, left, width == QWORD_BITS));
            out.push(
                if width == BYTE_BITS {
                    CMP_RM_R8
                } else {
                    CMP_RM_R64
                }
            );
            out.push(modrm(right, left));
            out.push(rex(0, destination, false));
            out.push(TWO_BYTE_OPCODE);
            out.push(SETCC | cc);
            out.push(modrm(0, destination));
            truncate(inout out, destination, destination, BYTE_BITS);
        },
        Instruction::Select(destination, condition, first, alternative, cc) => {
            // Test before copying. The destination may share the condition register.
            binary(inout out, TEST_RM_R64, condition, condition, true);
            if destination != first {
                binary(inout out, MOV_RM_R64, destination, first, true);
            }
            out.push(rex(destination, alternative, true));
            out.push(TWO_BYTE_OPCODE);
            out.push(CMOVCC | cc);
            out.push(modrm(destination, alternative));
        },
        Instruction::Truncate(destination, source, width) => truncate(
            inout out,
            destination,
            source,
            width
        ),
        Instruction::SignExtend(destination, source, from, width) => sign_extend(
            inout out,
            destination,
            source,
            from,
            width
        ),
        Instruction::Return => out.push(RET_NEAR),
    };
}
