pub copy enum PackedInteger {
    Add,
    Subtract,
    SignedSaturatingAdd,
    UnsignedSaturatingAdd,
    SignedSaturatingSubtract,
    UnsignedSaturatingSubtract,
    RoundedAverage,
}

pub fn packed_integer_opcode(in op: PackedInteger, width: u64) -> u8 {
    let byte = width == BYTE_BITS;
    match op {
        PackedInteger::Add => match width {
            BYTE_BITS => PADDB,
            WORD_BITS => PADDW,
            DWORD_BITS => PADDD,
            _ => PADDQ,
        },
        PackedInteger::Subtract => match width {
            BYTE_BITS => PSUBB,
            WORD_BITS => PSUBW,
            DWORD_BITS => PSUBD,
            _ => PSUBQ,
        },
        PackedInteger::SignedSaturatingAdd => if byte { PADDSB } else { PADDSW },
        PackedInteger::UnsignedSaturatingAdd => if byte { PADDUSB } else { PADDUSW },
        PackedInteger::SignedSaturatingSubtract => if byte { PSUBSB } else { PSUBSW },
        PackedInteger::UnsignedSaturatingSubtract => if byte { PSUBUSB } else { PSUBUSW },
        PackedInteger::RoundedAverage => if byte { PAVGB } else { PAVGW },
    }
}

pub fn is_xmm(register: u8) -> bool {
    register >= XMM0 && register <= XMM_RIGHT_SCRATCH
}

pub fn find_float_register(used: u32) -> u8 {
    for index in 0..REGISTER_CODES {
        let reg = wrapping_add(XMM0, wrapping_u8(index));
        if (used & register_bit(reg)) == 0 {
            return reg;
        }
    }
    UNASSIGNED
}

pub fn arg_register(argument: u64) -> u8 {
    match argument {
        0 => RDI,
        1 => RSI,
        2 => RDX,
        3 => RCX,
        4 => R8,
        5 => R9,
        _ => UNASSIGNED,
    }
}

pub fn home_register(index: u64) -> u8 {
    match index {
        0 => RBX,
        1 => R12,
        2 => R13,
        3 => R14,
        4 => R15,
        _ => UNASSIGNED,
    }
}

pub fn xmm_home_register(index: u64) -> u8 {
    wrapping_add(FIRST_XMM_HOME, wrapping_u8(index))
}

pub fn register_bit(reg: u8) -> u32 {
    if reg == UNASSIGNED {
        0
    } else {
        wrapping_shl_u32(1, widen_u32(reg))
    }
}

fn first_register(available: u32) -> u8 {
    if available == 0 {
        UNASSIGNED
    } else {
        wrapping_u8(trailing_zeros_u64(widen_u64(available)))
    }
}

pub fn callee_saved_registers() -> u32 {
    register_bit(RBX)
        | register_bit(R12)
        | register_bit(R13)
        | register_bit(R14)
        | register_bit(R15)
}

pub fn find_callee_saved_register(used: u32) -> u8 {
    first_register(callee_saved_registers() & ~used)
}

// Prefer RAX among the caller-saved GPRs.
pub fn find_register(used: u32) -> u8 {
    let candidates = register_bit(RAX)
        | register_bit(RCX)
        | register_bit(RDX)
        | register_bit(RSI)
        | register_bit(RDI)
        | register_bit(R8)
        | register_bit(R9)
        | register_bit(R10)
        | register_bit(R11);
    first_register(candidates & ~used)
}

fn modrm_fields(reg: u8, rm: u8) -> u8 {
    wrapping_shl_u8(reg & LOW_REGISTER_MASK, MOD_FIELD_SHIFT) | (rm & LOW_REGISTER_MASK)
}

fn modrm(reg: u8, rm: u8) -> u8 {
    MOD_REGISTER | modrm_fields(reg, rm)
}

fn rex(reg: u8, rm: u8, wide: bool) -> u8 {
    let first = if wide { REX_W } else { REX };
    let reg_extension = if reg >= HIGH_REGISTER { REX_R } else { 0 };
    let rm_extension = if rm >= HIGH_REGISTER { REX_B } else { 0 };
    first | reg_extension | rm_extension
}

fn emit_rex(inout out: ChunkSeq[u8], reg: u8, rm: u8, wide: bool, low_byte: bool) {
    let prefix = rex(reg, rm, wide);
    if prefix != REX || low_byte {
        out.push(prefix);
    }
}

fn byte_register_needs_rex(reg: u8) -> bool {
    // Without REX, encodings 4–7 refer to AH, CH, DH and BH.
    reg >= RSP
}

fn binary(inout out: ChunkSeq[u8], opcode: u8, destination: u8, source: u8, wide: bool) {
    let low_byte = opcode == TEST_RM_R8
        && (byte_register_needs_rex(source) || byte_register_needs_rex(destination));
    emit_rex(inout out, source, destination, wide, low_byte);
    out.push(opcode);
    out.push(modrm(source, destination));
}

fn trap(inout out: ChunkSeq[u8]) {
    out.push(TWO_BYTE_OPCODE);
    out.push(UD2_OPCODE);
}

fn sign_extend_dividend(inout out: ChunkSeq[u8], wide: bool) {
    if wide {
        out.push(REX_W);
    }
    out.push(SIGN_EXTEND_DIVIDEND);
}

fn fixed_arithmetic(inout out: ChunkSeq[u8], in op: FixedArithmetic, rhs: u8, wide: bool) {
    let prefix = rex(0, rhs, wide);
    let extension = match op {
        FixedArithmetic::SignedDivide => {
            // An explicit zero trap distinguishes divide by zero from overflow.
            binary(inout out, TEST_RM_R64, rhs, rhs, wide);
            out.push(JCC_SHORT | CC_NE);
            out.push(TRAP_BYTES);
            trap(inout out);
            sign_extend_dividend(inout out, wide);
            IDIV_EXTENSION
        },
        FixedArithmetic::UnsignedDivide | FixedArithmetic::UnsignedRemainder => {
            binary(inout out, XOR_RM_R64, RDX, RDX, false);
            DIV_EXTENSION
        },
        FixedArithmetic::SignedRemainder => {
            sign_extend_dividend(inout out, wide);
            // The remainder by -1 is zero even when the quotient overflows.
            if prefix != REX {
                out.push(prefix);
            }
            out.push(ALU_RM64_IMM8);
            out.push(modrm(ALU_CMP_EXTENSION, rhs));
            out.push(NEGATIVE_ONE_IMM8);
            out.push(JCC_SHORT | CC_NE);
            out.push(REGISTER_INSTRUCTION_BYTES + SHORT_BRANCH_BYTES);
            binary(inout out, XOR_RM_R64, RDX, RDX, false);
            out.push(JMP_SHORT);
            out.push(wrapping_add(REGISTER_INSTRUCTION_BYTES, if prefix != REX { 1 } else { 0 }));
            IDIV_EXTENSION
        },
        FixedArithmetic::SignedMultiplyHigh => IMUL_EXTENSION,
        FixedArithmetic::UnsignedMultiplyHigh => MUL_EXTENSION,
    };
    if prefix != REX {
        out.push(prefix);
    }
    out.push(UNARY_GROUP);
    out.push(modrm(extension, rhs));
}

fn immediate(inout out: ChunkSeq[u8], bits: u64, size: u64) {
    for i in 0..size {
        let shift = wrapping_mul(wrapping_u32(i), wrapping_u32(BYTE_BITS));
        out.push(wrapping_u8(wrapping_shr_u64(bits, shift)));
    }
}

pub fn fits_signed_byte(bits: u32) -> bool {
    bits <= DISP8_MAX || bits >= DISP8_MIN_AS_DISP32
}

fn alu_immediate(inout out: ChunkSeq[u8], extension: u8, reg: u8, bits: u32, width: u64) {
    let short = width == BYTE_BITS || fits_signed_byte(bits);
    if width == WORD_BITS {
        out.push(OPERAND_SIZE_OVERRIDE);
    }
    emit_rex(
        inout out,
        0,
        reg,
        width == QWORD_BITS,
        width == BYTE_BITS && byte_register_needs_rex(reg)
    );
    out.push(
        if width == BYTE_BITS {
            ALU_RM8_IMM8
        } else if short {
            ALU_RM64_IMM8
        } else {
            ALU_RM64_IMM32
        }
    );
    out.push(modrm(extension, reg));
    let bytes = if short {
        1
    } else if width == WORD_BITS {
        WORD_BITS / BYTE_BITS
    } else {
        IMM32_BYTES
    };
    immediate(inout out, widen_u64(bits), bytes);
}

pub fn emit_direct_call(inout out: ChunkSeq[u8]) -> u64 {
    out.push(CALL_REL32);
    let displacement = out.len();
    immediate(inout out, 0, IMM32_BYTES);
    displacement
}

pub fn emit_direct_jump(inout out: ChunkSeq[u8]) -> u64 {
    out.push(JMP_REL32);
    let displacement = out.len();
    immediate(inout out, 0, IMM32_BYTES);
    displacement
}

pub fn emit_indirect_call(inout out: ChunkSeq[u8], register: u8) {
    emit_rex(inout out, 0, register, false, false);
    out.push(CALL_JUMP_RM_GROUP);
    out.push(modrm(CALL_REGISTER_EXTENSION, register));
}

pub fn emit_symbol_address(inout out: ChunkSeq[u8], destination: u8, got: bool) -> u64 {
    out.push(rex(destination, 0, true));
    out.push(if got { MOV_R64_RM } else { LEA });
    out.push(modrm_fields(destination, RM_DISP32_WITHOUT_BASE));
    let displacement = out.len();
    immediate(inout out, 0, IMM32_BYTES);
    displacement
}

// The final table entry is the default. Clamp the unsigned index before the
// indexed load so even speculative execution stays inside this function.
pub fn emit_jump_table(inout out: ChunkSeq[u8], index: u8, case_count: u32) -> bool {
    truncate(inout out, R10, index, DWORD_BITS);
    load_constant(inout out, R11, widen_u64(case_count));
    compare_registers(inout out, R10, R11, DWORD_BITS);
    out.push(rex(R10, R11, false));
    out.push(TWO_BYTE_OPCODE);
    out.push(CMOVCC | CC_AE);
    out.push(modrm(R10, R11));

    let _ = emit_symbol_address(inout out, R11, false);
    let address_end = out.len();
    out.push(rex(R10, R11, true) | REX_X);
    out.push(MOVSXD_R64_RM32);
    out.push(modrm_fields(R10, RM_SIB));
    out.push(SIB_SCALE_DWORD | modrm_fields(R10, R11));
    binary(inout out, ADD_RM_R64, R10, R11, true);
    out.push(rex(0, R10, false));
    out.push(CALL_JUMP_RM_GROUP);
    out.push(modrm(JMP_RM_EXTENSION, R10));
    patch_forward_branch(inout out, address_end)
}

pub fn emit_jump_table_entry(inout out: ChunkSeq[u8]) -> u64 {
    let offset = out.len();
    immediate(inout out, 0, IMM32_BYTES);
    offset
}

fn adjust_stack(inout out: ChunkSeq[u8], extension: u8, size: u32) {
    if size == 0 {
        return;
    }
    out.push(REX_W);
    if size <= DISP8_MAX {
        out.push(ALU_RM64_IMM8);
        out.push(modrm(extension, RSP));
        out.push(wrapping_u8(size));
    } else {
        out.push(ALU_RM64_IMM32);
        out.push(modrm(extension, RSP));
        immediate(inout out, widen_u64(size), IMM32_BYTES);
    }
}

// The forward target is the next instruction, at the current end of output.
pub fn patch_forward_branch(inout out: ChunkSeq[u8], branch_end: u64) -> bool {
    let target = out.len();
    patch_relative_branch(inout out, branch_end, target)
}

pub fn patch_relative_branch(inout out: ChunkSeq[u8], branch_end: u64, target: u64) -> bool {
    patch_relative_offset(inout out, wrapping_sub(branch_end, IMM32_BYTES), branch_end, target)
}

pub fn patch_relative_offset(inout out: ChunkSeq[u8], start: u64, base: u64, target: u64) -> bool {
    if start > out.len() || wrapping_sub(out.len(), start) < IMM32_BYTES {
        return false;
    }
    let distance = wrapping_sub(target, base);
    if distance > DISP32_MAX && distance < I32_MIN_BITS {
        return false;
    }
    for i in 0..IMM32_BYTES {
        let shift = wrapping_mul(wrapping_u32(i), wrapping_u32(BYTE_BITS));
        let byte = wrapping_u8(wrapping_shr_u64(distance, shift));
        let _ = out.try_set(wrapping_add(start, i), byte);
    }
    true
}

fn load_memory(inout out: ChunkSeq[u8], destination: u8, base: u8, displacement: u32, width: u64) {
    emit_rex(inout out, destination, base, width == QWORD_BITS, false);
    if width == BYTE_BITS || width == WORD_BITS {
        out.push(TWO_BYTE_OPCODE);
        out.push(
            if width == BYTE_BITS {
                MOVZX_R32_RM8
            } else {
                MOVZX_R32_RM16
            }
        );
    } else {
        out.push(MOV_R64_RM);
    }

    memory_operand(inout out, destination, base, displacement);
}

fn store_memory(inout out: ChunkSeq[u8], source: u8, base: u8, displacement: u32, width: u64) {
    if width == WORD_BITS {
        out.push(OPERAND_SIZE_OVERRIDE);
    }
    emit_rex(
        inout out,
        source,
        base,
        width == QWORD_BITS,
        width == BYTE_BITS && byte_register_needs_rex(source)
    );
    out.push(
        if width == BYTE_BITS {
            MOV_RM_R8
        } else {
            MOV_RM_R64
        }
    );
    memory_operand(inout out, source, base, displacement);
}

pub fn store_immediate_fits(bits: u64, width: u64) -> bool {
    width != QWORD_BITS || wrapping_u64(widen_i64(wrapping_i32(bits))) == bits
}

pub fn store_immediate(
    inout out: ChunkSeq[u8],
    base: u8,
    displacement: u32,
    bits: u64,
    width: u64
) {
    if width == WORD_BITS {
        out.push(OPERAND_SIZE_OVERRIDE);
    }
    emit_rex(inout out, 0, base, width == QWORD_BITS, false);
    out.push(
        if width == BYTE_BITS {
            MOV_RM8_IMM8
        } else {
            MOV_RM64_IMM32
        }
    );
    memory_operand(inout out, 0, base, displacement);
    immediate(
        inout out,
        bits,
        if width == QWORD_BITS {
            IMM32_BYTES
        } else {
            width / BYTE_BITS
        }
    );
}

fn memory_operand(inout out: ChunkSeq[u8], reg: u8, base: u8, displacement: u32) {
    let low_base = base & LOW_REGISTER_MASK;
    let mode = if displacement == 0 && low_base != RM_DISP32_WITHOUT_BASE {
        0
    } else if fits_signed_byte(displacement) {
        MOD_DISP8
    } else {
        MOD_DISP32
    };
    out.push(mode | modrm_fields(reg, base));
    if low_base == RM_SIB {
        out.push(SIB_NO_INDEX | low_base);
    }
    if mode == MOD_DISP8 {
        out.push(wrapping_u8(displacement));
    } else if mode == MOD_DISP32 {
        immediate(inout out, widen_u64(displacement), IMM32_BYTES);
    }
}

fn atomic_memory(inout out: ChunkSeq[u8], in op: AtomicMemory, register: u8, base: u8, width: u64) {
    match op {
        AtomicMemory::Exchange => {},
        _ => out.push(LOCK_PREFIX),
    };
    if width == WORD_BITS {
        out.push(OPERAND_SIZE_OVERRIDE);
    }
    let byte = width == BYTE_BITS;
    emit_rex(
        inout out,
        register,
        base,
        width == QWORD_BITS,
        byte && byte_register_needs_rex(register)
    );
    match op {
        AtomicMemory::FetchAdd => {
            out.push(TWO_BYTE_OPCODE);
            out.push(if byte { XADD_RM_R8 } else { XADD_RM_R64 });
        },
        AtomicMemory::CompareExchange => {
            out.push(TWO_BYTE_OPCODE);
            out.push(if byte { CMPXCHG_RM_R8 } else { CMPXCHG_RM_R64 });
        },
        AtomicMemory::Exchange => out.push(if byte { XCHG_RM_R8 } else { XCHG_RM_R64 }),
        AtomicMemory::Add => out.push(if byte { ADD_RM_R8 } else { ADD_RM_R64 }),
        AtomicMemory::Subtract => out.push(if byte { SUB_RM_R8 } else { SUB_RM_R64 }),
    };
    memory_operand(inout out, register, base, 0);
}

fn atomic_update(inout out: ChunkSeq[u8], in op: AtomicUpdate, base: u8, width: u64) {
    load_memory(inout out, RAX, base, 0, width);
    let retry = out.len();
    gp_move(inout out, R10, RAX);
    match op {
        AtomicUpdate::Bitwise(opcode, invert) => {
            binary(inout out, opcode, R10, RDX, width == QWORD_BITS);
            if invert {
                let machine_width = if width == QWORD_BITS {
                    QWORD_BITS
                } else {
                    DWORD_BITS
                };
                gp_unary(inout out, NOT_EXTENSION, R10, machine_width);
            }
        },
        AtomicUpdate::MinMax(cc) => {
            compare_registers(inout out, RAX, RDX, width);
            emit_rex(inout out, R10, RDX, width == QWORD_BITS, false);
            out.push(TWO_BYTE_OPCODE);
            out.push(CMOVCC | cc);
            out.push(modrm(R10, RDX));
        },
    };
    atomic_memory(inout out, in AtomicMemory::CompareExchange, R10, base, width);
    // Compare-exchange refreshes RAX on failure. The short branch spans only
    // the fixed instruction sequence above.
    out.push(JCC_SHORT | CC_NE);
    let end = wrapping_add(out.len(), 1);
    out.push(wrapping_u8(wrapping_sub(retry, end)));
}

fn rotate_word_bytes(inout out: ChunkSeq[u8], register: u8) {
    out.push(OPERAND_SIZE_OVERRIDE);
    emit_rex(inout out, 0, register, false, false);
    out.push(SHIFT_GROUP_IMM8);
    out.push(modrm(ROR_EXTENSION, register));
    out.push(wrapping_u8(BYTE_BITS));
}

fn byte_swap(inout out: ChunkSeq[u8], register: u8, width: u64) {
    if width == WORD_BITS {
        rotate_word_bytes(inout out, register);
    } else {
        emit_rex(inout out, 0, register, width == QWORD_BITS, false);
        out.push(TWO_BYTE_OPCODE);
        out.push(BSWAP_REGISTER | (register & LOW_REGISTER_MASK));
    }
}

fn gp_move(inout out: ChunkSeq[u8], destination: u8, source: u8) {
    if destination != source {
        binary(inout out, MOV_RM_R64, destination, source, true);
    }
}

fn gp_unary(inout out: ChunkSeq[u8], extension: u8, destination: u8, width: u64) {
    emit_rex(inout out, 0, destination, width == QWORD_BITS, false);
    out.push(UNARY_GROUP);
    out.push(modrm(extension, destination));
    normalize_small_result(inout out, destination, width);
}

fn shift_immediate(
    inout out: ChunkSeq[u8],
    extension: u8,
    destination: u8,
    count: u64,
    width: u64
) {
    if width == WORD_BITS {
        out.push(OPERAND_SIZE_OVERRIDE);
    }
    emit_rex(
        inout out,
        0,
        destination,
        width == QWORD_BITS,
        width == BYTE_BITS && byte_register_needs_rex(destination)
    );
    out.push(
        if width == BYTE_BITS {
            SHIFT_BYTE_GROUP_IMM8
        } else {
            SHIFT_GROUP_IMM8
        }
    );
    out.push(modrm(extension, destination));
    out.push(wrapping_u8(count));
    normalize_small_result(inout out, destination, width);
}

fn power_division(
    inout out: ChunkSeq[u8],
    dest: u8,
    source: u8,
    width: u64,
    shift: u64,
    signed: bool,
    negative: bool,
    remainder: bool
) {
    let wide = width == QWORD_BITS;
    let discard = wrapping_sub(width, shift);
    gp_move(inout out, dest, source);
    if signed {
        // Add 2^shift - 1 only for a negative dividend to round toward zero.
        gp_move(inout out, R11, source);
        if shift != 1 {
            shift_immediate(inout out, SAR_EXTENSION, R11, wrapping_sub(width, 1), width);
        }
        shift_immediate(inout out, SHR_EXTENSION, R11, discard, width);
        binary(inout out, ADD_RM_R64, dest, R11, wide);
    }
    if remainder {
        if shift < DWORD_BITS {
            let mask = wrapping_sub(wrapping_shl_u64(1, wrapping_u32(shift)), 1);
            alu_immediate(inout out, ALU_AND_EXTENSION, dest, wrapping_u32(mask), width);
        } else {
            shift_immediate(inout out, SHL_EXTENSION, dest, discard, width);
            shift_immediate(inout out, SHR_EXTENSION, dest, discard, width);
        }
        if signed {
            binary(inout out, SUB_RM_R64, dest, R11, wide);
        }
    } else {
        let extension = if signed { SAR_EXTENSION } else { SHR_EXTENSION };
        shift_immediate(inout out, extension, dest, shift, width);
        if negative {
            gp_unary(inout out, NEG_EXTENSION, dest, width);
        }
    }
}

fn bit_scan(inout out: ChunkSeq[u8], dest: u8, source: u8, width: u64, leading: bool) {
    let wide = width == QWORD_BITS;
    emit_rex(inout out, dest, source, wide, false);
    out.push(TWO_BYTE_OPCODE);
    out.push(if leading { BSR_REGISTER } else { BSF_REGISTER });
    out.push(modrm(dest, source));
    // The scan leaves ZF set on zero. MOV preserves it for the conditional move.
    move_constant(inout out, R11, if leading { BSR_ZERO_INDEX } else { width });
    emit_rex(inout out, dest, R11, wide, false);
    out.push(TWO_BYTE_OPCODE);
    out.push(CMOVCC | CC_E);
    out.push(modrm(dest, R11));
    if leading {
        let machine_width = if wide { QWORD_BITS } else { DWORD_BITS };
        gp_unary(inout out, NEG_EXTENSION, dest, machine_width);
        alu_immediate(
            inout out,
            ALU_ADD_EXTENSION,
            dest,
            wrapping_u32(wrapping_sub(width, 1)),
            machine_width
        );
    }
}

fn swap_bit_groups(inout out: ChunkSeq[u8], dest: u8, mask: u64, shift: u64) {
    gp_move(inout out, R10, dest);
    move_constant(inout out, R11, mask);
    shift_immediate(inout out, SHR_EXTENSION, R10, shift, QWORD_BITS);
    binary(inout out, AND_RM_R64, R10, R11, true);
    binary(inout out, AND_RM_R64, dest, R11, true);
    shift_immediate(inout out, SHL_EXTENSION, dest, shift, QWORD_BITS);
    binary(inout out, OR_RM_R64, dest, R10, true);
}

fn population_count(inout out: ChunkSeq[u8], dest: u8, source: u8) {
    gp_move(inout out, dest, source);
    gp_move(inout out, R10, dest);
    move_constant(inout out, R11, SWAR_ODD_BITS);
    shift_immediate(inout out, SHR_EXTENSION, R10, 1, QWORD_BITS);
    binary(inout out, AND_RM_R64, R10, R11, true);
    binary(inout out, SUB_RM_R64, dest, R10, true);

    gp_move(inout out, R10, dest);
    move_constant(inout out, R11, SWAR_BIT_PAIRS);
    shift_immediate(inout out, SHR_EXTENSION, R10, PAIR_BITS, QWORD_BITS);
    binary(inout out, AND_RM_R64, R10, R11, true);
    binary(inout out, AND_RM_R64, dest, R11, true);
    binary(inout out, ADD_RM_R64, dest, R10, true);

    gp_move(inout out, R10, dest);
    move_constant(inout out, R11, SWAR_NIBBLES);
    shift_immediate(inout out, SHR_EXTENSION, R10, NIBBLE_BITS, QWORD_BITS);
    binary(inout out, ADD_RM_R64, dest, R10, true);
    binary(inout out, AND_RM_R64, dest, R11, true);
    move_constant(inout out, R11, SWAR_BYTE_SUM);
    emit_rex(inout out, dest, R11, true, false);
    out.push(TWO_BYTE_OPCODE);
    out.push(IMUL_R64_RM64);
    out.push(modrm(dest, R11));
    shift_immediate(inout out, SHR_EXTENSION, dest, QWORD_BITS - BYTE_BITS, QWORD_BITS);
}

fn gp_sign_mask(inout out: ChunkSeq[u8], source: u8, width: u64) {
    if width == QWORD_BITS {
        gp_move(inout out, R11, source);
    } else {
        sign_extend(inout out, R11, source, width, QWORD_BITS);
    }
    shift_immediate(inout out, SAR_EXTENSION, R11, QWORD_BITS - 1, QWORD_BITS);
}

fn bit_operation(inout out: ChunkSeq[u8], dest: u8, source: u8, width: u64, in op: BitOperation) {
    match op {
        BitOperation::LeadingZeros => bit_scan(inout out, dest, source, width, true),
        BitOperation::TrailingZeros => bit_scan(inout out, dest, source, width, false),
        BitOperation::PopulationCount => population_count(inout out, dest, source),
        BitOperation::HardwarePopulationCount => {
            out.push(SCALAR_SINGLE);
            emit_rex(inout out, dest, source, width == QWORD_BITS, false);
            out.push(TWO_BYTE_OPCODE);
            out.push(POPCNT_REGISTER);
            out.push(modrm(dest, source));
        },
        BitOperation::Reverse => {
            gp_move(inout out, dest, source);
            swap_bit_groups(inout out, dest, SWAR_ODD_BITS, 1);
            swap_bit_groups(inout out, dest, SWAR_BIT_PAIRS, PAIR_BITS);
            swap_bit_groups(inout out, dest, SWAR_NIBBLES, NIBBLE_BITS);
            if width != BYTE_BITS {
                byte_swap(inout out, dest, width);
            }
        },
        BitOperation::LeadingSignBits => {
            gp_sign_mask(inout out, source, width);
            gp_move(inout out, dest, source);
            binary(inout out, XOR_RM_R64, dest, R11, width == QWORD_BITS);
            normalize_small_result(inout out, dest, width);
            bit_scan(inout out, dest, dest, width, true);
            alu_immediate(inout out, ALU_SUB_EXTENSION, dest, 1, DWORD_BITS);
        },
        BitOperation::Absolute => {
            gp_sign_mask(inout out, source, width);
            gp_move(inout out, dest, source);
            binary(inout out, XOR_RM_R64, dest, R11, width == QWORD_BITS);
            binary(inout out, SUB_RM_R64, dest, R11, width == QWORD_BITS);
            normalize_small_result(inout out, dest, width);
        },
    };
}

fn load_constant(inout out: ChunkSeq[u8], destination: u8, bits: u64) {
    if bits == 0 {
        emit_rex(inout out, destination, destination, false, false);
        out.push(XOR_RM_R64);
        out.push(modrm(destination, destination));
    } else {
        move_constant(inout out, destination, bits);
    }
}

pub fn cheap_immediate(bits: u64) -> bool {
    bits <= U32_MAX_BITS || bits >= I32_MIN_BITS
}

pub fn move_constant(inout out: ChunkSeq[u8], destination: u8, bits: u64) {
    if bits <= U32_MAX_BITS {
        emit_rex(inout out, 0, destination, false, false);
        out.push(MOV_REGISTER_IMMEDIATE | (destination & LOW_REGISTER_MASK));
        immediate(inout out, bits, IMM32_BYTES);
    } else if bits >= I32_MIN_BITS {
        out.push(rex(0, destination, true));
        out.push(MOV_RM64_IMM32);
        out.push(modrm(0, destination));
        immediate(inout out, bits, IMM32_BYTES);
    } else {
        out.push(rex(0, destination, true));
        out.push(MOV_REGISTER_IMMEDIATE | (destination & LOW_REGISTER_MASK));
        immediate(inout out, bits, IMM64_BYTES);
    }
}

fn truncate(inout out: ChunkSeq[u8], destination: u8, source: u8, width: u64) {
    if width == DWORD_BITS {
        // A 32-bit write zeroes the high half, even for a self-move.
        binary(inout out, MOV_RM_R64, destination, source, false);
    } else {
        emit_rex(
            inout out,
            destination,
            source,
            false,
            width == BYTE_BITS && byte_register_needs_rex(source)
        );
        out.push(TWO_BYTE_OPCODE);
        out.push(
            if width == BYTE_BITS {
                MOVZX_R32_RM8
            } else {
                MOVZX_R32_RM16
            }
        );
        out.push(modrm(destination, source));
    }
}

fn sign_extend(inout out: ChunkSeq[u8], destination: u8, source: u8, from: u64, width: u64) {
    emit_rex(
        inout out,
        destination,
        source,
        width == QWORD_BITS,
        from == BYTE_BITS && byte_register_needs_rex(source)
    );
    if from == DWORD_BITS {
        out.push(MOVSXD_R64_RM32);
    } else {
        out.push(TWO_BYTE_OPCODE);
        out.push(
            if from == BYTE_BITS {
                MOVSX_R64_RM8
            } else {
                MOVSX_R64_RM16
            }
        );
    }
    out.push(modrm(destination, source));
    if width == WORD_BITS {
        truncate(inout out, destination, destination, width);
    }
}

fn normalize_small_result(inout out: ChunkSeq[u8], destination: u8, width: u64) {
    if width < DWORD_BITS {
        truncate(inout out, destination, destination, width);
    }
}

fn set_condition(inout out: ChunkSeq[u8], destination: u8, cc: u8) {
    emit_rex(inout out, 0, destination, false, byte_register_needs_rex(destination));
    out.push(TWO_BYTE_OPCODE);
    out.push(SETCC | cc);
    out.push(modrm(0, destination));
    truncate(inout out, destination, destination, BYTE_BITS);
}

fn compare_registers(inout out: ChunkSeq[u8], left: u8, right: u8, width: u64) {
    if width == WORD_BITS {
        out.push(OPERAND_SIZE_OVERRIDE);
    }
    let low_byte = width == BYTE_BITS
        && (byte_register_needs_rex(left) || byte_register_needs_rex(right));
    emit_rex(inout out, right, left, width == QWORD_BITS, low_byte);
    out.push(
        if width == BYTE_BITS {
            CMP_RM_R8
        } else {
            CMP_RM_R64
        }
    );
    out.push(modrm(right, left));
}

fn compare_immediate(inout out: ChunkSeq[u8], reg: u8, bits: u32, width: u64) {
    if bits == 0 {
        if width == WORD_BITS {
            out.push(OPERAND_SIZE_OVERRIDE);
        }
        let opcode = if width == BYTE_BITS {
            TEST_RM_R8
        } else {
            TEST_RM_R64
        };
        binary(inout out, opcode, reg, reg, width == QWORD_BITS);
    } else {
        alu_immediate(inout out, ALU_CMP_EXTENSION, reg, bits, width);
    }
}

fn conditional_jump(inout out: ChunkSeq[u8], cc: u8) {
    out.push(TWO_BYTE_OPCODE);
    out.push(JCC_NEAR | cc);
    immediate(inout out, 0, IMM32_BYTES);
}

fn float_prefix(width: u64) -> u8 {
    if width == DWORD_BITS {
        SCALAR_SINGLE
    } else {
        SCALAR_DOUBLE
    }
}

fn xmm_code(reg: u8) -> u8 {
    wrapping_sub(reg, XMM0)
}

fn xmm_binary(inout out: ChunkSeq[u8], opcode: u8, destination: u8, source: u8) {
    let dst = xmm_code(destination);
    let src = xmm_code(source);
    emit_rex(inout out, dst, src, false, false);
    out.push(TWO_BYTE_OPCODE);
    out.push(opcode);
    out.push(modrm(dst, src));
}

fn compare_float_registers(inout out: ChunkSeq[u8], left: u8, right: u8, width: u64) {
    if width == QWORD_BITS {
        out.push(OPERAND_SIZE_OVERRIDE);
    }
    xmm_binary(inout out, UCOMIS, left, right);
}

fn float_fma(inout out: ChunkSeq[u8], dest: u8, left: u8, right: u8, addend: u8, width: u64) {
    // Keep the CLIF source order for NaN payload selection.
    let result = if dest != left && (dest == right || dest == addend) {
        XMM_LEFT_SCRATCH
    } else {
        dest
    };
    float_move(inout out, result, left);
    let reg = xmm_code(result);
    let source = xmm_code(right);
    let rm = xmm_code(addend);
    let r = if reg < HIGH_REGISTER {
        VEX_R_INVERTED
    } else {
        0
    };
    let b = if rm < HIGH_REGISTER {
        VEX_B_INVERTED
    } else {
        0
    };
    let w = if width == QWORD_BITS { VEX_W } else { 0 };
    let inverted_source = wrapping_sub(wrapping_u8(REGISTER_CODES - 1), source);
    out.push(THREE_BYTE_VEX);
    out.push(r | VEX_X_INVERTED | b | VEX_0F38_MAP);
    out.push(w | wrapping_shl_u8(inverted_source, VEX_SOURCE_SHIFT) | VEX_66_PREFIX);
    out.push(VFMADD213_SCALAR);
    out.push(modrm(reg, rm));
    float_move(inout out, dest, result);
}

fn emit_short_branch(inout out: ChunkSeq[u8], opcode: u8) -> u64 {
    out.push(opcode);
    let displacement = out.len();
    out.push(0);
    displacement
}

fn patch_short_forward(inout out: ChunkSeq[u8], displacement: u64) {
    // The caller keeps each forward target within its fixed instruction sequence.
    let distance = wrapping_sub(out.len(), wrapping_add(displacement, 1));
    let _ = out.try_set(displacement, wrapping_u8(distance));
}

fn float_min_max(inout out: ChunkSeq[u8], dest: u8, left: u8, right: u8, min: bool, width: u64) {
    let result = if dest == left && left != right {
        XMM_RIGHT_SCRATCH
    } else {
        dest
    };
    float_move(inout out, result, right);
    compare_float_registers(inout out, result, left, width);
    let unequal = emit_short_branch(inout out, JCC_SHORT | CC_NE);
    let unordered = emit_short_branch(inout out, JCC_SHORT | CC_P);

    // Equal operands can differ in the sign of zero.
    xmm_binary(inout out, if min { ORPS } else { ANDPS }, result, left);
    let equal_done = emit_short_branch(inout out, JMP_SHORT);

    // Addition quiets a signaling NaN and propagates its payload.
    patch_short_forward(inout out, unordered);
    out.push(float_prefix(width));
    xmm_binary(inout out, SSE_ADD, result, left);
    let unordered_done = emit_short_branch(inout out, JMP_SHORT);

    patch_short_forward(inout out, unequal);
    out.push(float_prefix(width));
    xmm_binary(inout out, if min { SSE_MIN } else { SSE_MAX }, result, left);
    patch_short_forward(inout out, equal_done);
    patch_short_forward(inout out, unordered_done);
    float_move(inout out, dest, result);
}

fn float_round(inout out: ChunkSeq[u8], dest: u8, source: u8, in mode: Rounding, width: u64) {
    let dest = xmm_code(dest);
    let source = xmm_code(source);
    out.push(OPERAND_SIZE_OVERRIDE);
    emit_rex(inout out, dest, source, false, false);
    out.push(TWO_BYTE_OPCODE);
    out.push(THREE_BYTE_3A_MAP);
    out.push(
        if width == DWORD_BITS {
            ROUNDSS
        } else {
            ROUNDSD
        }
    );
    out.push(modrm(dest, source));
    out.push(match mode {
        Rounding::Nearest => ROUND_NEAREST_EVEN,
        Rounding::Floor => ROUND_DOWN,
        Rounding::Ceil => ROUND_UP,
        Rounding::Trunc => ROUND_TOWARD_ZERO,
    });
}

fn float_immediate(inout out: ChunkSeq[u8], destination: u8, bits: u64, width: u64) {
    if bits == 0 {
        xmm_binary(inout out, XORPS, destination, destination);
    } else {
        load_constant(inout out, R11, bits);
        float_bits(inout out, destination, R11, width);
    }
}

fn float_to_integer(inout out: ChunkSeq[u8], destination: u8, source: u8, from: u64, width: u64) {
    let source = xmm_code(source);
    out.push(float_prefix(from));
    emit_rex(inout out, destination, source, width == QWORD_BITS, false);
    out.push(TWO_BYTE_OPCODE);
    out.push(SSE_FLOAT_TO_INTEGER_TRUNC);
    out.push(modrm(destination, source));
}

fn float_power_of_two(exponent: u64, width: u64) -> u64 {
    if width == DWORD_BITS {
        wrapping_shl_u64(wrapping_add(exponent, F32_EXPONENT_BIAS), F32_EXPONENT_SHIFT)
    } else {
        wrapping_shl_u64(wrapping_add(exponent, F64_EXPONENT_BIAS), F64_EXPONENT_SHIFT)
    }
}

fn float_to_unsigned_qword(inout out: ChunkSeq[u8], dest: u8, source: u8, from: u64) {
    let cutoff = XMM_RIGHT_SCRATCH;
    float_immediate(inout out, cutoff, float_power_of_two(QWORD_BITS - 1, from), from);
    compare_float_registers(inout out, source, cutoff, from);
    let direct = emit_short_branch(inout out, JCC_SHORT | CC_B);

    // Values in the upper half fit a signed conversion after subtracting 2^63.
    let reduced = XMM_LEFT_SCRATCH;
    float_move(inout out, reduced, source);
    out.push(float_prefix(from));
    xmm_binary(inout out, SSE_SUB, reduced, cutoff);
    float_to_integer(inout out, dest, reduced, from, QWORD_BITS);
    move_constant(inout out, R11, wrapping_shl_u64(1, wrapping_u32(QWORD_BITS - 1)));
    binary(inout out, OR_RM_R64, dest, R11, true);
    let done = emit_short_branch(inout out, JMP_SHORT);

    patch_short_forward(inout out, direct);
    float_to_integer(inout out, dest, source, from, QWORD_BITS);
    patch_short_forward(inout out, done);
}

fn float_to_integer_saturating(
    inout out: ChunkSeq[u8],
    dest: u8,
    source: u8,
    from: u64,
    width: u64,
    signed: bool
) {
    let limit = if signed {
        wrapping_sub(width, 1)
    } else {
        width
    };
    let cutoff = XMM_RIGHT_SCRATCH;
    compare_float_registers(inout out, source, source, from);
    conditional_jump(inout out, CC_P);
    let unordered = out.len();

    let upper = float_power_of_two(limit, from);
    let sign = if from == DWORD_BITS {
        F32_SIGN
    } else {
        F64_SIGN
    };
    float_immediate(inout out, cutoff, if signed { upper | sign } else { 0 }, from);
    compare_float_registers(inout out, source, cutoff, from);
    conditional_jump(inout out, CC_BE);
    let below = out.len();
    float_immediate(inout out, cutoff, upper, from);
    compare_float_registers(inout out, source, cutoff, from);
    conditional_jump(inout out, CC_AE);
    let above = out.len();

    if !signed && width == QWORD_BITS {
        float_to_unsigned_qword(inout out, dest, source, from);
    } else {
        let conversion = if width == QWORD_BITS || (!signed && width == DWORD_BITS) {
            QWORD_BITS
        } else {
            DWORD_BITS
        };
        float_to_integer(inout out, dest, source, from, conversion);
        normalize_small_result(inout out, dest, width);
    }
    let in_range_done = emit_short_branch(inout out, JMP_SHORT);

    let _ = patch_forward_branch(inout out, below);
    let minimum = if signed {
        wrapping_shl_u64(1, wrapping_u32(limit))
    } else {
        0
    };
    load_constant(inout out, dest, minimum);
    let below_done = emit_short_branch(inout out, JMP_SHORT);

    let _ = patch_forward_branch(inout out, above);
    load_constant(
        inout out,
        dest,
        wrapping_shr_u64(ALL_REGISTER_BITS, wrapping_u32(wrapping_sub(QWORD_BITS, limit)))
    );
    let above_done = emit_short_branch(inout out, JMP_SHORT);

    let _ = patch_forward_branch(inout out, unordered);
    load_constant(inout out, dest, 0);
    patch_short_forward(inout out, in_range_done);
    patch_short_forward(inout out, below_done);
    patch_short_forward(inout out, above_done);
}

fn cvtsi(inout out: ChunkSeq[u8], destination: u8, source: u8, wide: bool, width: u64) {
    let dest = xmm_code(destination);
    out.push(float_prefix(width));
    emit_rex(inout out, dest, source, wide, false);
    out.push(TWO_BYTE_OPCODE);
    out.push(SSE_INTEGER_TO_FLOAT);
    out.push(modrm(dest, source));
}

fn integer_to_float(
    inout out: ChunkSeq[u8],
    dest: u8,
    source: u8,
    from: u64,
    width: u64,
    signed: bool
) {
    if signed && from < DWORD_BITS {
        sign_extend(inout out, R11, source, from, DWORD_BITS);
        cvtsi(inout out, dest, R11, false, width);
    } else if !signed && from == QWORD_BITS {
        binary(inout out, TEST_RM_R64, source, source, true);
        conditional_jump(inout out, CC_GE);
        let direct = out.len();

        // Fold the low bit into the shifted value before rounding, then
        // double the float. This avoids double rounding above i64::MAX.
        gp_move(inout out, R11, source);
        shift_immediate(inout out, SHR_EXTENSION, R11, 1, QWORD_BITS);
        conditional_jump(inout out, CC_AE);
        let even = out.len();
        alu_immediate(inout out, ALU_OR_EXTENSION, R11, 1, QWORD_BITS);
        let _ = patch_forward_branch(inout out, even);
        cvtsi(inout out, dest, R11, true, width);
        out.push(float_prefix(width));
        xmm_binary(inout out, SSE_ADD, dest, dest);

        let _ = emit_direct_jump(inout out);
        let done = out.len();
        let _ = patch_forward_branch(inout out, direct);
        cvtsi(inout out, dest, source, true, width);
        let _ = patch_forward_branch(inout out, done);
    } else {
        let wide = from == QWORD_BITS || (!signed && from == DWORD_BITS);
        cvtsi(inout out, dest, source, wide, width);
    }
}

fn packed_38(inout out: ChunkSeq[u8], opcode: u8, destination: u8, source: u8) {
    let dst = xmm_code(destination);
    let src = xmm_code(source);
    out.push(OPERAND_SIZE_OVERRIDE);
    emit_rex(inout out, dst, src, false, false);
    out.push(TWO_BYTE_OPCODE);
    out.push(THREE_BYTE_38_MAP);
    out.push(opcode);
    out.push(modrm(dst, src));
}

fn packed_binary(inout out: ChunkSeq[u8], opcode: u8, destination: u8, source: u8) {
    out.push(OPERAND_SIZE_OVERRIDE);
    xmm_binary(inout out, opcode, destination, source);
}

fn packed_word_shift_right(inout out: ChunkSeq[u8], destination: u8, count: u8) {
    let destination = xmm_code(destination);
    out.push(OPERAND_SIZE_OVERRIDE);
    emit_rex(inout out, 0, destination, false, false);
    out.push(TWO_BYTE_OPCODE);
    out.push(PACKED_SHIFT_WORD);
    out.push(modrm(PACKED_SHIFT_RIGHT, destination));
    out.push(count);
}

fn packed_shift(inout out: ChunkSeq[u8], destination: u8, extension: u8, width: u64) {
    let destination = xmm_code(destination);
    out.push(OPERAND_SIZE_OVERRIDE);
    emit_rex(inout out, 0, destination, false, false);
    out.push(TWO_BYTE_OPCODE);
    out.push(
        if width == DWORD_BITS {
            PACKED_SHIFT_DWORD
        } else {
            PACKED_SHIFT_QWORD
        }
    );
    out.push(modrm(extension, destination));
    out.push(wrapping_u8(wrapping_sub(width, 1)));
}

fn float_move(inout out: ChunkSeq[u8], destination: u8, source: u8) {
    if destination != source {
        xmm_binary(inout out, MOVAPS_LOAD, destination, source);
    }
}

fn float_bits(inout out: ChunkSeq[u8], destination: u8, source: u8, width: u64) {
    let to_xmm = is_xmm(destination);
    let xmm = xmm_code(if to_xmm { destination } else { source });
    let gp = if to_xmm { source } else { destination };
    out.push(OPERAND_SIZE_OVERRIDE);
    emit_rex(inout out, xmm, gp, width == QWORD_BITS, false);
    out.push(TWO_BYTE_OPCODE);
    out.push(if to_xmm { GPR_TO_XMM } else { XMM_TO_GPR });
    out.push(modrm(xmm, gp));
}

fn packed_shuffle(inout out: ChunkSeq[u8], destination: u8, source: u8, lanes: u8) {
    out.push(OPERAND_SIZE_OVERRIDE);
    xmm_binary(inout out, PSHUFD, destination, source);
    out.push(lanes);
}

fn vector_constant(inout out: ChunkSeq[u8], destination: u8, low: u64, high: u64) {
    if low == 0 && high == 0 {
        out.push(OPERAND_SIZE_OVERRIDE);
        xmm_binary(inout out, PXOR, destination, destination);
        return;
    }
    move_constant(inout out, R11, low);
    float_bits(inout out, destination, R11, QWORD_BITS);
    if high == 0 {
        return;
    }
    if high == low {
        packed_shuffle(inout out, destination, destination, DUPLICATE_LOW_QWORD);
    } else {
        move_constant(inout out, R11, high);
        float_bits(inout out, XMM_RIGHT_SCRATCH, R11, QWORD_BITS);
        out.push(OPERAND_SIZE_OVERRIDE);
        xmm_binary(inout out, PUNPCKLQDQ, destination, XMM_RIGHT_SCRATCH);
    }
}

fn vector_pairwise_add(inout out: ChunkSeq[u8], dest: u8, left: u8, right: u8, width: u64) {
    if width == BYTE_BITS {
        let mask = XMM_AUX_SCRATCH;
        float_move(inout out, XMM_RIGHT_SCRATCH, right);
        float_move(inout out, dest, left);
        packed_binary(inout out, PCMPEQB, mask, mask);
        packed_38(inout out, PABSB, mask, mask);
        // Multiplication by one sums adjacent unsigned bytes into each word.
        packed_38(inout out, PMADDUBSW, dest, mask);
        packed_38(inout out, PMADDUBSW, XMM_RIGHT_SCRATCH, mask);
        packed_binary(inout out, PCMPEQB, mask, mask);
        packed_word_shift_right(inout out, mask, wrapping_u8(BYTE_BITS));
        packed_binary(inout out, PAND, dest, mask);
        packed_binary(inout out, PAND, XMM_RIGHT_SCRATCH, mask);
        packed_binary(inout out, PACKUSWB, dest, XMM_RIGHT_SCRATCH);
    } else {
        float_move(inout out, dest, left);
        packed_38(inout out, if width == WORD_BITS { PHADDW } else { PHADDD }, dest, right);
    }
}

fn vector_swizzle(inout out: ChunkSeq[u8], dest: u8, left: u8, right: u8, zero_high: bool) {
    let mask = if zero_high {
        right
    } else {
        vector_constant(inout out, XMM_AUX_SCRATCH, SWIZZLE_CLAMP_QWORD, SWIZZLE_CLAMP_QWORD);
        float_move(inout out, XMM_RIGHT_SCRATCH, right);
        packed_binary(inout out, PADDUSB, XMM_RIGHT_SCRATCH, XMM_AUX_SCRATCH);
        XMM_RIGHT_SCRATCH
    };
    float_move(inout out, dest, left);
    packed_38(inout out, PSHUFB, dest, mask);
}

fn vector_splat(inout out: ChunkSeq[u8], destination: u8, source: u8, lane: u64) {
    let lane_move = if lane == QWORD_BITS {
        QWORD_BITS
    } else {
        DWORD_BITS
    };
    float_bits(inout out, destination, source, lane_move);
    if lane == BYTE_BITS {
        out.push(OPERAND_SIZE_OVERRIDE);
        xmm_binary(inout out, PUNPCKLBW, destination, destination);
    }
    if lane <= WORD_BITS {
        out.push(OPERAND_SIZE_OVERRIDE);
        xmm_binary(inout out, PUNPCKLWD, destination, destination);
    }
    let lanes = if lane == QWORD_BITS {
        DUPLICATE_LOW_QWORD
    } else {
        DUPLICATE_LOW_DWORD
    };
    packed_shuffle(inout out, destination, destination, lanes);
}

fn vector_compare_inputs(inout out: ChunkSeq[u8], a: u8, b: u8) {
    let left = XMM_LEFT_SCRATCH;
    let right = XMM_RIGHT_SCRATCH;
    if a == right && b == left {
        float_move(inout out, XMM_AUX_SCRATCH, left);
        float_move(inout out, left, right);
        float_move(inout out, right, XMM_AUX_SCRATCH);
    } else if a == right {
        float_move(inout out, left, a);
        float_move(inout out, right, b);
    } else {
        float_move(inout out, right, b);
        float_move(inout out, left, a);
    }
}

fn vector_bias(inout out: ChunkSeq[u8], pattern: u64) {
    let mask = XMM_AUX_SCRATCH;
    vector_constant(inout out, mask, pattern, pattern);
    packed_binary(inout out, PXOR, XMM_LEFT_SCRATCH, mask);
    packed_binary(inout out, PXOR, XMM_RIGHT_SCRATCH, mask);
}

fn vector_greater_qword(inout out: ChunkSeq[u8], unsigned: bool) {
    let gt = XMM_LEFT_SCRATCH;
    let low = XMM_RIGHT_SCRATCH;
    let eq = XMM_AUX_SCRATCH;
    // With equal high halves the low half determines the comparison, unsigned.
    vector_bias(
        inout out,
        if unsigned {
            DWORD_SIGN_BITS
        } else {
            LOW_DWORD_SIGN_BIT
        }
    );
    float_move(inout out, eq, gt);
    packed_binary(inout out, PCMPEQD, eq, low);
    packed_binary(inout out, PCMPGTD, gt, low);
    packed_shuffle(inout out, low, gt, DUPLICATE_EVEN_DWORDS);
    packed_shuffle(inout out, gt, gt, DUPLICATE_ODD_DWORDS);
    packed_shuffle(inout out, eq, eq, DUPLICATE_ODD_DWORDS);
    packed_binary(inout out, PAND, low, eq);
    packed_binary(inout out, POR, gt, low);
}

fn vector_integer_compare(
    inout out: ChunkSeq[u8],
    dest: u8,
    a: u8,
    b: u8,
    width: u64,
    in relation: PackedRelation,
    invert: bool
) {
    let aux = XMM_AUX_SCRATCH;
    let (equal, unsigned) = match relation {
        PackedRelation::Equal => (true, false),
        PackedRelation::SignedGreater => (false, false),
        PackedRelation::UnsignedGreater => (false, true),
    };
    if unsigned || (!equal && width == QWORD_BITS) {
        vector_compare_inputs(inout out, a, b);
        if width == QWORD_BITS {
            vector_greater_qword(inout out, unsigned);
        } else {
            let (mask, opcode) = match width {
                BYTE_BITS => (BYTE_SIGN_BITS, PCMPGTB),
                WORD_BITS => (WORD_SIGN_BITS, PCMPGTW),
                _ => (DWORD_SIGN_BITS, PCMPGTD),
            };
            vector_bias(inout out, mask);
            packed_binary(inout out, opcode, XMM_LEFT_SCRATCH, XMM_RIGHT_SCRATCH);
        }
        float_move(inout out, dest, XMM_LEFT_SCRATCH);
    } else {
        let rhs = if dest == b && a != b {
            float_move(inout out, aux, b);
            aux
        } else {
            b
        };
        float_move(inout out, dest, a);
        let opcode = match width {
            BYTE_BITS => if equal { PCMPEQB } else { PCMPGTB },
            WORD_BITS => if equal { PCMPEQW } else { PCMPGTW },
            _ => if equal { PCMPEQD } else { PCMPGTD },
        };
        packed_binary(inout out, opcode, dest, rhs);
        if width == QWORD_BITS {
            packed_shuffle(inout out, aux, dest, SWAP_ADJACENT_DWORDS);
            packed_binary(inout out, PAND, dest, aux);
        }
    }
    if invert {
        packed_binary(inout out, PCMPEQB, aux, aux);
        packed_binary(inout out, PXOR, dest, aux);
    }
}

fn shift_right_lane(inout out: ChunkSeq[u8], destination: u8, shift: u64, wide: bool) {
    emit_rex(inout out, 0, destination, wide, false);
    out.push(SHIFT_GROUP_IMM8);
    out.push(modrm(SHR_EXTENSION, destination));
    out.push(wrapping_u8(shift));
}

fn extract_word(inout out: ChunkSeq[u8], destination: u8, source: u8, lane: u64) {
    let source = xmm_code(source);
    out.push(OPERAND_SIZE_OVERRIDE);
    emit_rex(inout out, destination, source, false, false);
    out.push(TWO_BYTE_OPCODE);
    out.push(PEXTRW);
    out.push(modrm(destination, source));
    out.push(wrapping_u8(lane));
}

fn insert_word(inout out: ChunkSeq[u8], destination: u8, source: u8, lane: u64) {
    let destination = xmm_code(destination);
    out.push(OPERAND_SIZE_OVERRIDE);
    emit_rex(inout out, destination, source, false, false);
    out.push(TWO_BYTE_OPCODE);
    out.push(PINSRW);
    out.push(modrm(destination, source));
    out.push(wrapping_u8(lane));
}

fn vector_extract(inout out: ChunkSeq[u8], dest: u8, source: u8, lane: u64, width: u64) {
    if width <= WORD_BITS {
        let word = if width == BYTE_BITS {
            lane / BYTE_LANES_PER_WORD
        } else {
            lane
        };
        extract_word(inout out, dest, source, word);
        if width == BYTE_BITS {
            if lane % BYTE_LANES_PER_WORD == 0 {
                truncate(inout out, dest, dest, BYTE_BITS);
            } else {
                shift_right_lane(inout out, dest, BYTE_BITS, false);
            }
        }
    } else {
        let mut source = source;
        if lane != 0 {
            let shuffle = if width == QWORD_BITS {
                HIGH_QWORD_TO_LOW
            } else {
                wrapping_u8(lane)
            };
            packed_shuffle(inout out, XMM_RIGHT_SCRATCH, source, shuffle);
            source = XMM_RIGHT_SCRATCH;
        }
        float_bits(inout out, dest, source, width);
    }
}

fn vector_insert(inout out: ChunkSeq[u8], dest: u8, source: u8, lane: u64, width: u64) {
    if width == BYTE_BITS {
        let word = lane / BYTE_LANES_PER_WORD;
        let odd = lane % BYTE_LANES_PER_WORD != 0;
        extract_word(inout out, R11, dest, word);
        if odd {
            rotate_word_bytes(inout out, R11);
        }
        emit_rex(inout out, source, R11, false, true);
        out.push(MOV_RM_R8);
        out.push(modrm(source, R11));
        if odd {
            rotate_word_bytes(inout out, R11);
        }
        insert_word(inout out, dest, R11, word);
        return;
    }
    let words = width / WORD_BITS;
    let first = wrapping_mul(lane, words);
    insert_word(inout out, dest, source, first);
    if words > 1 {
        binary(inout out, MOV_RM_R64, R11, source, width == QWORD_BITS);
        for word in 1..words {
            shift_right_lane(inout out, R11, WORD_BITS, width == QWORD_BITS);
            insert_word(inout out, dest, R11, wrapping_add(first, word));
        }
    }
}

fn vector_mask(inout out: ChunkSeq[u8], dest: u8, source: u8, width: u64) {
    if width == BYTE_BITS || width == QWORD_BITS {
        out.push(OPERAND_SIZE_OVERRIDE);
    }
    let source = xmm_code(source);
    emit_rex(inout out, dest, source, false, false);
    out.push(TWO_BYTE_OPCODE);
    out.push(if width == BYTE_BITS { PMOVMSKB } else { MOVMSK });
    out.push(modrm(dest, source));
}

fn vector_high_bits(inout out: ChunkSeq[u8], dest: u8, source: u8, width: u64) {
    if width == WORD_BITS {
        // Signed saturation preserves each word's sign in the corresponding byte.
        float_move(inout out, XMM_LEFT_SCRATCH, source);
        out.push(OPERAND_SIZE_OVERRIDE);
        xmm_binary(inout out, PACKSSWB, XMM_LEFT_SCRATCH, XMM_LEFT_SCRATCH);
        vector_mask(inout out, dest, XMM_LEFT_SCRATCH, BYTE_BITS);
        alu_immediate(inout out, ALU_AND_EXTENSION, dest, LOW_BYTE_MASK, DWORD_BITS);
    } else {
        vector_mask(inout out, dest, source, width);
    }
}

fn vector_truth(inout out: ChunkSeq[u8], dest: u8, source: u8, all: bool, width: u64) {
    float_move(inout out, XMM_LEFT_SCRATCH, source);
    if all && width == QWORD_BITS {
        // SSE2 compares dwords. OR each qword's two halves into both dwords.
        packed_shuffle(inout out, XMM_RIGHT_SCRATCH, XMM_LEFT_SCRATCH, SWAP_ADJACENT_DWORDS);
        out.push(OPERAND_SIZE_OVERRIDE);
        xmm_binary(inout out, POR, XMM_LEFT_SCRATCH, XMM_RIGHT_SCRATCH);
    }
    out.push(OPERAND_SIZE_OVERRIDE);
    xmm_binary(inout out, PXOR, XMM_RIGHT_SCRATCH, XMM_RIGHT_SCRATCH);
    let compare = if !all || width == BYTE_BITS {
        PCMPEQB
    } else if width == WORD_BITS {
        PCMPEQW
    } else {
        PCMPEQD
    };
    out.push(OPERAND_SIZE_OVERRIDE);
    xmm_binary(inout out, compare, XMM_LEFT_SCRATCH, XMM_RIGHT_SCRATCH);
    vector_mask(inout out, dest, XMM_LEFT_SCRATCH, BYTE_BITS);
    compare_immediate(inout out, dest, if all { 0 } else { ALL_BYTE_SIGN_BITS }, DWORD_BITS);
    set_condition(inout out, dest, if all { CC_E } else { CC_NE });
}

fn float_memory(
    inout out: ChunkSeq[u8],
    register: u8,
    base: u8,
    displacement: u32,
    width: u64,
    load: bool
) {
    let register = xmm_code(register);
    if width != VECTOR_BITS {
        out.push(float_prefix(width));
    }
    emit_rex(inout out, register, base, false, false);
    out.push(TWO_BYTE_OPCODE);
    out.push(
        if load {
            MOV_SCALAR_LOAD
        } else {
            MOV_SCALAR_STORE
        }
    );
    memory_operand(inout out, register, base, displacement);
}

fn float_compare(
    inout out: ChunkSeq[u8],
    destination: u8,
    left: u8,
    right: u8,
    predicate: u64,
    width: u64
) {
    // UCOMIS reports an unordered pair with ZF, PF and CF all set.
    let swap = predicate == FLOAT_LESS
        || predicate == FLOAT_LESS_EQUAL
        || predicate == FLOAT_UNORDERED_OR_GREATER
        || predicate == FLOAT_UNORDERED_OR_GREATER_EQUAL;
    if swap {
        compare_float_registers(inout out, right, left, width);
    } else {
        compare_float_registers(inout out, left, right, width);
    }
    let cc = match predicate {
        FLOAT_ORDERED => CC_NP,
        FLOAT_UNORDERED => CC_P,
        FLOAT_EQUAL | FLOAT_UNORDERED_OR_EQUAL => CC_E,
        FLOAT_NOT_EQUAL | FLOAT_ORDERED_NOT_EQUAL => CC_NE,
        FLOAT_LESS | FLOAT_GREATER => CC_A,
        FLOAT_LESS_EQUAL | FLOAT_GREATER_EQUAL => CC_AE,
        FLOAT_UNORDERED_OR_LESS | FLOAT_UNORDERED_OR_GREATER => CC_B,
        FLOAT_UNORDERED_OR_LESS_EQUAL | FLOAT_UNORDERED_OR_GREATER_EQUAL => CC_BE,
        _ => CC_NP,
    };
    set_condition(inout out, destination, cc);
    if predicate == FLOAT_EQUAL {
        set_condition(inout out, R11, CC_NP);
        binary(inout out, AND_RM_R64, destination, R11, false);
    } else if predicate == FLOAT_NOT_EQUAL {
        set_condition(inout out, R11, CC_P);
        binary(inout out, OR_RM_R64, destination, R11, false);
    }
}

pub fn emit(inout out: ChunkSeq[u8], in instruction: Instruction) {
    match instruction {
        Instruction::Atomic(op, register, base, width) => atomic_memory(
            inout out,
            in op,
            register,
            base,
            width
        ),
        Instruction::AtomicUpdate(op, base, width) => atomic_update(inout out, in op, base, width),
        Instruction::Fence => {
            out.push(TWO_BYTE_OPCODE);
            out.push(FENCE_GROUP);
            out.push(MFENCE_MODRM);
        },
        Instruction::ByteSwap(register, width) => byte_swap(inout out, register, width),
        Instruction::Fixed(op, rhs, width) => fixed_arithmetic(
            inout out,
            in op,
            rhs,
            width == QWORD_BITS
        ),
        Instruction::PowerDivision(
            destination,
            source,
            width,
            shift,
            signed,
            negative,
            remainder
        ) => {
            power_division(
                inout out,
                destination,
                source,
                width,
                shift,
                signed,
                negative,
                remainder
            );
        },
        Instruction::Immediate(destination, bits) => load_constant(inout out, destination, bits),
        Instruction::FloatImmediate(destination, bits, width) => float_immediate(
            inout out,
            destination,
            bits,
            width
        ),
        Instruction::FloatBinary(op, destination, source, width) => {
            out.push(float_prefix(width));
            xmm_binary(inout out, op, destination, source);
        },
        Instruction::FloatSign(destination, absolute, width) => {
            let sign = if width == DWORD_BITS {
                F32_SIGN
            } else {
                F64_SIGN
            };
            load_constant(
                inout out,
                R11,
                if absolute {
                    wrapping_sub(sign, 1)
                } else {
                    sign
                }
            );
            float_bits(inout out, XMM_RIGHT_SCRATCH, R11, width);
            xmm_binary(
                inout out,
                if absolute { ANDPS } else { XORPS },
                destination,
                XMM_RIGHT_SCRATCH
            );
        },
        Instruction::FloatCopySign(destination, sign, width) => {
            // Isolate the differing sign bit, then toggle it in the magnitude.
            let scratch = XMM_RIGHT_SCRATCH;
            float_move(inout out, scratch, sign);
            xmm_binary(inout out, XORPS, scratch, destination);
            packed_shift(inout out, scratch, PACKED_SHIFT_RIGHT, width);
            packed_shift(inout out, scratch, PACKED_SHIFT_LEFT, width);
            xmm_binary(inout out, XORPS, destination, scratch);
        },
        Instruction::FloatToInteger(destination, source, source_width, width) => float_to_integer(
            inout out,
            destination,
            source,
            source_width,
            width
        ),
        Instruction::FloatToIntegerSat(
            destination,
            source,
            source_width,
            width,
            signed
        ) => float_to_integer_saturating(
            inout out,
            destination,
            source,
            source_width,
            width,
            signed
        ),
        Instruction::FloatFma(destination, left, right, addend, width) => float_fma(
            inout out,
            destination,
            left,
            right,
            addend,
            width
        ),
        Instruction::VectorConstant(destination, low, high) => vector_constant(
            inout out,
            destination,
            low,
            high
        ),
        Instruction::VectorSplat(destination, source, lane) => vector_splat(
            inout out,
            destination,
            source,
            lane
        ),
        Instruction::VectorBinary(opcode, destination, source) => packed_binary(
            inout out,
            opcode,
            destination,
            source
        ),
        Instruction::VectorPairwiseAdd(destination, left, right, width) => vector_pairwise_add(
            inout out,
            destination,
            left,
            right,
            width
        ),
        Instruction::VectorSwizzle(destination, left, right, zero_high) => vector_swizzle(
            inout out,
            destination,
            left,
            right,
            zero_high
        ),
        Instruction::VectorIntegerCompare(destination, left, right, width, relation, invert) => {
            vector_integer_compare(inout out, destination, left, right, width, in relation, invert);
        },
        Instruction::VectorConvert(destination, source, demote) => {
            if demote {
                out.push(OPERAND_SIZE_OVERRIDE);
            }
            xmm_binary(inout out, SSE_CONVERT_PRECISION, destination, source);
        },
        Instruction::FloatConvert(destination, source, source_width) => {
            out.push(float_prefix(source_width));
            xmm_binary(inout out, SSE_CONVERT_PRECISION, destination, source);
        },
        Instruction::FloatMinMax(destination, left, right, min, width) => {
            float_min_max(inout out, destination, left, right, min, width);
        },
        Instruction::FloatRound(destination, source, mode, width) => {
            float_round(inout out, destination, source, in mode, width);
        },
        Instruction::IntegerToFloat(destination, source, from, width, signed) => {
            integer_to_float(inout out, destination, source, from, width, signed);
        },
        Instruction::VectorExtract(destination, source, lane, width) => vector_extract(
            inout out,
            destination,
            source,
            lane,
            width
        ),
        Instruction::VectorInsert(destination, source, lane, width) => vector_insert(
            inout out,
            destination,
            source,
            lane,
            width
        ),
        Instruction::VectorHighBits(destination, source, width) => vector_high_bits(
            inout out,
            destination,
            source,
            width
        ),
        Instruction::VectorTruth(destination, source, all, width) => vector_truth(
            inout out,
            destination,
            source,
            all,
            width
        ),
        Instruction::BitOperation(destination, source, width, op) => bit_operation(
            inout out,
            destination,
            source,
            width,
            in op
        ),
        Instruction::ComplementedBitwise(opcode, destination, source, width) => {
            gp_move(inout out, R11, source);
            gp_unary(inout out, NOT_EXTENSION, R11, QWORD_BITS);
            binary(inout out, opcode, destination, R11, width == QWORD_BITS);
            if opcode != AND_RM_R64 {
                normalize_small_result(inout out, destination, width);
            }
        },
        Instruction::FunnelRight(destination, source, amount) => {
            emit_rex(inout out, source, destination, true, false);
            out.push(TWO_BYTE_OPCODE);
            out.push(SHRD_IMMEDIATE);
            out.push(modrm(source, destination));
            out.push(amount);
        },
        Instruction::FloatBits(destination, source, width) => float_bits(
            inout out,
            destination,
            source,
            width
        ),
        Instruction::FloatCompare(destination, left, right, predicate, width) => float_compare(
            inout out,
            destination,
            left,
            right,
            predicate,
            width
        ),
        Instruction::Move(destination, source) => {
            if is_xmm(destination) {
                float_move(inout out, destination, source);
            } else {
                gp_move(inout out, destination, source);
            }
        },
        Instruction::Exchange(left, right) => binary(inout out, XCHG_RM_R64, left, right, true),
        Instruction::Binary(opcode, destination, source, width) => {
            binary(inout out, opcode, destination, source, width == QWORD_BITS);
            // Low-width bitwise operations preserve the zeroed upper bits.
            if opcode == ADD_RM_R64 || opcode == SUB_RM_R64 {
                normalize_small_result(inout out, destination, width);
            }
        },
        Instruction::BinaryImmediate(extension, destination, bits, width) => {
            // The input is already zero-extended. A byte or word operation
            // preserves those zero upper bits.
            alu_immediate(inout out, extension, destination, bits, width);
        },
        Instruction::Multiply(destination, source, width) => {
            emit_rex(inout out, destination, source, width == QWORD_BITS, false);
            out.push(TWO_BYTE_OPCODE);
            out.push(IMUL_R64_RM64);
            out.push(modrm(destination, source));
            normalize_small_result(inout out, destination, width);
        },
        Instruction::MultiplyImmediate(destination, source, bits, width) => {
            let short = fits_signed_byte(bits);
            emit_rex(inout out, destination, source, width == QWORD_BITS, false);
            out.push(
                if short {
                    IMUL_R64_RM64_IMM8
                } else {
                    IMUL_R64_RM64_IMM32
                }
            );
            out.push(modrm(destination, source));
            immediate(inout out, widen_u64(bits), if short { 1 } else { IMM32_BYTES });
            normalize_small_result(inout out, destination, width);
        },
        Instruction::Unary(extension, destination, width) => gp_unary(
            inout out,
            extension,
            destination,
            width
        ),
        Instruction::Shift(extension, destination, count, width) => shift_immediate(
            inout out,
            extension,
            destination,
            widen_u64(count),
            width
        ),
        Instruction::ShiftRegister(extension, destination, count, width) => {
            // Legacy shifts read CL. Exchange full registers to preserve a
            // live RCX and restore the count when the operation is finished.
            let shifted = if count == RCX {
                destination
            } else {
                binary(inout out, XCHG_RM_R64, RCX, count, true);
                if destination == RCX {
                    count
                } else if destination == count {
                    RCX
                } else {
                    destination
                }
            };
            if width == WORD_BITS {
                out.push(OPERAND_SIZE_OVERRIDE);
            }
            emit_rex(
                inout out,
                0,
                shifted,
                width == QWORD_BITS,
                width == BYTE_BITS && byte_register_needs_rex(shifted)
            );
            out.push(
                if width == BYTE_BITS {
                    SHIFT_BYTE_GROUP_CL
                } else {
                    SHIFT_GROUP_CL
                }
            );
            out.push(modrm(extension, shifted));
            if count != RCX {
                binary(inout out, XCHG_RM_R64, RCX, count, true);
            }
        },
        Instruction::Load(destination, base, displacement, width) => {
            if is_xmm(destination) {
                float_memory(inout out, destination, base, displacement, width, true);
            } else {
                load_memory(inout out, destination, base, displacement, width);
            }
        },
        Instruction::Store(source, base, displacement, width) => {
            if is_xmm(source) {
                float_memory(inout out, source, base, displacement, width, false);
            } else {
                store_memory(inout out, source, base, displacement, width);
            }
        },
        Instruction::Compare(destination, left, right, cc, width) => {
            compare_registers(inout out, left, right, width);
            set_condition(inout out, destination, cc);
        },
        Instruction::CompareImmediate(destination, source, bits, cc, width) => {
            compare_immediate(inout out, source, bits, width);
            set_condition(inout out, destination, cc);
        },
        Instruction::SetCondition(destination, cc) => set_condition(inout out, destination, cc),
        Instruction::Select(destination, condition, first, alternative, cc) => {
            if is_xmm(destination) {
                float_move(inout out, destination, first);
                if destination != alternative {
                    binary(inout out, TEST_RM_R64, condition, condition, true);
                    conditional_jump(inout out, cc ^ INVERT_CC);
                    let end = out.len();
                    float_move(inout out, destination, alternative);
                    let _ = patch_forward_branch(inout out, end);
                }
                return;
            }
            // Test before copying. The destination may share the condition register.
            binary(inout out, TEST_RM_R64, condition, condition, true);
            if destination != first {
                binary(inout out, MOV_RM_R64, destination, first, true);
            }
            out.push(rex(destination, alternative, true));
            out.push(TWO_BYTE_OPCODE);
            out.push(CMOVCC | cc);
            out.push(modrm(destination, alternative));
        },
        Instruction::Truncate(destination, source, width) => truncate(
            inout out,
            destination,
            source,
            width
        ),
        Instruction::SignExtend(destination, source, from, width) => sign_extend(
            inout out,
            destination,
            source,
            from,
            width
        ),
        Instruction::BranchZero(condition) => {
            binary(inout out, TEST_RM_R64, condition, condition, true);
            conditional_jump(inout out, CC_E);
        },
        Instruction::BranchWithFlags(cc) => conditional_jump(inout out, cc),
        Instruction::BranchCompare(left, right, cc, width) => {
            compare_registers(inout out, left, right, width);
            conditional_jump(inout out, cc);
        },
        Instruction::BranchCompareImmediate(left, bits, cc, width) => {
            compare_immediate(inout out, left, bits, width);
            conditional_jump(inout out, cc);
        },
        Instruction::Jump => {
            let _ = emit_direct_jump(inout out);
        },
        Instruction::FrameEnter(size) => adjust_stack(inout out, ALU_SUB_EXTENSION, size),
        Instruction::FrameLeave(size) => adjust_stack(inout out, ALU_ADD_EXTENSION, size),
        Instruction::StackAddress(destination, displacement) => {
            out.push(rex(destination, RSP, true));
            out.push(LEA);
            memory_operand(inout out, destination, RSP, displacement);
        },
        Instruction::Trap => trap(inout out),
        Instruction::TrapIf(source, when_zero) => {
            binary(inout out, TEST_RM_R64, source, source, true);
            out.push(JCC_SHORT | (if when_zero { CC_NE } else { CC_E }));
            out.push(TRAP_BYTES);
            trap(inout out);
        },
        Instruction::Return => out.push(RET_NEAR),
    };
}
