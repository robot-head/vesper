// Physical registers and instructions for the x86-64 backend.
pub const RAX: u8 = 0;
const RCX: u8 = 1;
pub const RDX: u8 = 2;
const RBX: u8 = 3;
pub const RSP: u8 = 4;
const RSI: u8 = 6;
const RDI: u8 = 7;
const R8: u8 = 8;
const R9: u8 = 9;
pub const R10: u8 = 10;
pub const R11: u8 = 11;
const R12: u8 = 12;
const R13: u8 = 13;
const R14: u8 = 14;
const R15: u8 = 15;

pub const ARGUMENTS: u64 = 6;
pub const REGISTER_CODES: u64 = 16;
pub const HOME_REGISTERS: u64 = 5;
pub const UNASSIGNED: u8 = 255;
pub const BYTE_BITS: u64 = 8;
pub const WORD_BITS: u64 = 16;
pub const DWORD_BITS: u64 = 32;
pub const QWORD_BITS: u64 = 64;

const REX: u8 = 0x40;
const REX_W: u8 = 0x48;
const REX_R: u8 = 0x04;
const REX_B: u8 = 0x01;
const LOW_REGISTER_MASK: u8 = 0x07;
const HIGH_REGISTER: u8 = 0x08;
const MOD_REGISTER: u8 = 0xc0;
const MOD_DISP8: u8 = 0x40;
const MOD_DISP32: u8 = 0x80;
const RM_SIB: u8 = 4;
const RM_DISP32_WITHOUT_BASE: u8 = 5;
const SIB_NO_INDEX: u8 = 0x20;
const MOD_FIELD_SHIFT: u32 = 3;
const MOV_RM_R8: u8 = 0x88;
const MOV_RM_R64: u8 = 0x89;
const MOV_R64_RM: u8 = 0x8b;
const LEA: u8 = 0x8d;
const MOV_REGISTER_IMMEDIATE: u8 = 0xb8;
const MOV_RM64_IMM32: u8 = 0xc7;
const ALU_RM8_IMM8: u8 = 0x80;
const ALU_RM64_IMM8: u8 = 0x83;
const ALU_RM64_IMM32: u8 = 0x81;
pub const ALU_ADD_EXTENSION: u8 = 0;
pub const ALU_OR_EXTENSION: u8 = 1;
pub const ALU_AND_EXTENSION: u8 = 4;
pub const ALU_SUB_EXTENSION: u8 = 5;
pub const ALU_XOR_EXTENSION: u8 = 6;
const ALU_CMP_EXTENSION: u8 = 7;
const TWO_BYTE_OPCODE: u8 = 0x0f;
const UD2_OPCODE: u8 = 0x0b;
const IMUL_R64_RM64: u8 = 0xaf;
const IMUL_R64_RM64_IMM8: u8 = 0x6b;
const IMUL_R64_RM64_IMM32: u8 = 0x69;
const UNARY_GROUP: u8 = 0xf7;
const SHIFT_BYTE_GROUP_IMM8: u8 = 0xc0;
const OPERAND_SIZE_OVERRIDE: u8 = 0x66;
const SHIFT_GROUP_IMM8: u8 = 0xc1;
const SHIFT_GROUP_CL: u8 = 0xd3;
const XCHG_RM_R64: u8 = 0x87;
const CMP_RM_R8: u8 = 0x38;
const CMP_RM_R64: u8 = 0x39;
const SETCC: u8 = 0x90;
const CMOVCC: u8 = 0x40;
const JCC_NEAR: u8 = 0x80;
const JCC_SHORT: u8 = 0x70;
const JMP_SHORT: u8 = 0xeb;
const JMP_REL32: u8 = 0xe9;
const SIGN_EXTEND_DIVIDEND: u8 = 0x99;
const MUL_EXTENSION: u8 = 4;
const IMUL_EXTENSION: u8 = 5;
const DIV_EXTENSION: u8 = 6;
const IDIV_EXTENSION: u8 = 7;
const TRAP_BYTES: u8 = 2;
const SHORT_BRANCH_BYTES: u8 = 2;
const PREFIXED_REGISTER_INSTRUCTION_BYTES: u8 = 3;
const NEGATIVE_ONE_IMM8: u8 = 0xff;
const TEST_RM_R64: u8 = 0x85;
const TEST_RM_R8: u8 = 0x84;
const MOVZX_R32_RM8: u8 = 0xb6;
const MOVSX_R64_RM8: u8 = 0xbe;
const MOVZX_R32_RM16: u8 = 0xb7;
const MOVSX_R64_RM16: u8 = 0xbf;
const MOVSXD_R64_RM32: u8 = 0x63;
const RET_NEAR: u8 = 0xc3;
const CALL_REL32: u8 = 0xe8;
const U32_MAX_BITS: u64 = 0xffffffff;
const I32_MIN_BITS: u64 = 0xffffffff80000000;
const DISP8_MAX: u32 = 0x7f;
const DISP8_MIN_AS_DISP32: u32 = 0xffffff80;
const DISP32_MAX: u64 = 0x7fffffff;
const IMM32_BYTES: u64 = 4;
const IMM64_BYTES: u64 = 8;

pub const ADD_RM_R64: u8 = 0x01;
pub const SUB_RM_R64: u8 = 0x29;
pub const AND_RM_R64: u8 = 0x21;
pub const OR_RM_R64: u8 = 0x09;
pub const XOR_RM_R64: u8 = 0x31;
pub const NOT_EXTENSION: u8 = 2;
pub const NEG_EXTENSION: u8 = 3;
pub const SHL_EXTENSION: u8 = 4;
pub const SHR_EXTENSION: u8 = 5;
pub const SAR_EXTENSION: u8 = 7;

pub const CC_B: u8 = 2;
pub const CC_AE: u8 = 3;
pub const CC_E: u8 = 4;
pub const CC_NE: u8 = 5;
pub const CC_BE: u8 = 6;
pub const CC_A: u8 = 7;
pub const CC_L: u8 = 12;
pub const CC_GE: u8 = 13;
pub const CC_LE: u8 = 14;
pub const CC_G: u8 = 15;

pub copy enum FixedArithmetic {
    SignedDivide,
    UnsignedDivide,
    SignedRemainder,
    UnsignedRemainder,
    SignedMultiplyHigh,
    UnsignedMultiplyHigh,
}

pub copy enum Instruction {
    Immediate(u8, u64),
    Move(u8, u8),
    Exchange(u8, u8),
    Binary(u8, u8, u8, u64),
    BinaryImmediate(u8, u8, u32, u64),
    Multiply(u8, u8, u64),
    MultiplyImmediate(u8, u8, u32, u64),
    Fixed(FixedArithmetic, u8, u64),
    Unary(u8, u8, u64),
    Shift(u8, u8, u8, u64),
    ShiftRegister(u8, u8, u8, u64),
    Load(u8, u8, u32, u64),
    Store(u8, u8, u32, u64),
    Compare(u8, u8, u8, u8, u64),
    CompareImmediate(u8, u8, u32, u8, u64),
    Select(u8, u8, u8, u8, u8),
    Truncate(u8, u8, u64),
    SignExtend(u8, u8, u64, u64),
    BranchZero(u8),
    BranchCompare(u8, u8, u8, u64),
    BranchCompareImmediate(u8, u32, u8, u64),
    Jump,
    FrameEnter(u32),
    FrameLeave(u32),
    StackAddress(u8, u32),
    Trap,
    Return,
}

pub fn arg_register(argument: u64) -> u8 {
    match argument {
        0 => RDI,
        1 => RSI,
        2 => RDX,
        3 => RCX,
        4 => R8,
        5 => R9,
        _ => UNASSIGNED,
    }
}

pub fn home_register(index: u64) -> u8 {
    match index {
        0 => RBX,
        1 => R12,
        2 => R13,
        3 => R14,
        4 => R15,
        _ => UNASSIGNED,
    }
}

pub fn register_bit(reg: u8) -> u32 {
    wrapping_shl_u32(1, widen_u32(reg))
}

// Use caller-saved GPRs exclusively. Prefer rax, the result register.
pub fn find_register(used: u32) -> u8 {
    let candidates = register_bit(RAX)
        | register_bit(RCX)
        | register_bit(RDX)
        | register_bit(RSI)
        | register_bit(RDI)
        | register_bit(R8)
        | register_bit(R9)
        | register_bit(R10)
        | register_bit(R11);
    let available = candidates ^ (candidates & used);
    if available == 0 {
        UNASSIGNED
    } else {
        wrapping_u8(trailing_zeros_u64(widen_u64(available)))
    }
}

fn modrm_fields(reg: u8, rm: u8) -> u8 {
    wrapping_shl_u8(reg & LOW_REGISTER_MASK, MOD_FIELD_SHIFT) | (rm & LOW_REGISTER_MASK)
}

fn modrm(reg: u8, rm: u8) -> u8 {
    MOD_REGISTER | modrm_fields(reg, rm)
}

fn rex(reg: u8, rm: u8, wide: bool) -> u8 {
    let first = if wide { REX_W } else { REX };
    let reg_extension = if reg >= HIGH_REGISTER { REX_R } else { 0 };
    let rm_extension = if rm >= HIGH_REGISTER { REX_B } else { 0 };
    first | reg_extension | rm_extension
}

fn binary(inout out: ChunkSeq[u8], opcode: u8, destination: u8, source: u8, wide: bool) {
    out.push(rex(source, destination, wide));
    out.push(opcode);
    out.push(modrm(source, destination));
}

fn trap(inout out: ChunkSeq[u8]) {
    out.push(TWO_BYTE_OPCODE);
    out.push(UD2_OPCODE);
}

fn sign_extend_dividend(inout out: ChunkSeq[u8], wide: bool) {
    if wide {
        out.push(REX_W);
    }
    out.push(SIGN_EXTEND_DIVIDEND);
}

fn fixed_arithmetic(inout out: ChunkSeq[u8], in op: FixedArithmetic, rhs: u8, wide: bool) {
    let extension = match op {
        FixedArithmetic::SignedDivide => {
            // An explicit zero trap distinguishes divide by zero from overflow.
            binary(inout out, TEST_RM_R64, rhs, rhs, wide);
            out.push(JCC_SHORT | CC_NE);
            out.push(TRAP_BYTES);
            trap(inout out);
            sign_extend_dividend(inout out, wide);
            IDIV_EXTENSION
        },
        FixedArithmetic::UnsignedDivide | FixedArithmetic::UnsignedRemainder => {
            binary(inout out, XOR_RM_R64, RDX, RDX, false);
            DIV_EXTENSION
        },
        FixedArithmetic::SignedRemainder => {
            sign_extend_dividend(inout out, wide);
            // The remainder by -1 is zero even when the quotient overflows.
            out.push(rex(0, rhs, wide));
            out.push(ALU_RM64_IMM8);
            out.push(modrm(ALU_CMP_EXTENSION, rhs));
            out.push(NEGATIVE_ONE_IMM8);
            out.push(JCC_SHORT | CC_NE);
            out.push(PREFIXED_REGISTER_INSTRUCTION_BYTES + SHORT_BRANCH_BYTES);
            binary(inout out, XOR_RM_R64, RDX, RDX, false);
            out.push(JMP_SHORT);
            out.push(PREFIXED_REGISTER_INSTRUCTION_BYTES);
            IDIV_EXTENSION
        },
        FixedArithmetic::SignedMultiplyHigh => IMUL_EXTENSION,
        FixedArithmetic::UnsignedMultiplyHigh => MUL_EXTENSION,
    };
    out.push(rex(0, rhs, wide));
    out.push(UNARY_GROUP);
    out.push(modrm(extension, rhs));
}

fn immediate(inout out: ChunkSeq[u8], bits: u64, size: u64) {
    for i in 0..size {
        let shift = wrapping_mul(wrapping_u32(i), wrapping_u32(BYTE_BITS));
        out.push(wrapping_u8(wrapping_shr_u64(bits, shift)));
    }
}

fn fits_signed_byte(bits: u32) -> bool {
    bits <= DISP8_MAX || bits >= DISP8_MIN_AS_DISP32
}

fn alu_immediate(inout out: ChunkSeq[u8], extension: u8, reg: u8, bits: u32, width: u64) {
    let short = width == BYTE_BITS || fits_signed_byte(bits);
    if width == WORD_BITS {
        out.push(OPERAND_SIZE_OVERRIDE);
    }
    out.push(rex(0, reg, width == QWORD_BITS));
    out.push(
        if width == BYTE_BITS {
            ALU_RM8_IMM8
        } else if short {
            ALU_RM64_IMM8
        } else {
            ALU_RM64_IMM32
        }
    );
    out.push(modrm(extension, reg));
    let bytes = if short {
        1
    } else if width == WORD_BITS {
        WORD_BITS / BYTE_BITS
    } else {
        IMM32_BYTES
    };
    immediate(inout out, widen_u64(bits), bytes);
}

pub fn emit_direct_call(inout out: ChunkSeq[u8]) -> u64 {
    out.push(CALL_REL32);
    let displacement = out.len();
    immediate(inout out, 0, IMM32_BYTES);
    displacement
}

pub fn emit_symbol_address(inout out: ChunkSeq[u8], destination: u8, got: bool) -> u64 {
    out.push(rex(destination, 0, true));
    out.push(if got { MOV_R64_RM } else { LEA });
    out.push(modrm_fields(destination, RM_DISP32_WITHOUT_BASE));
    let displacement = out.len();
    immediate(inout out, 0, IMM32_BYTES);
    displacement
}

fn adjust_stack(inout out: ChunkSeq[u8], extension: u8, size: u32) {
    if size == 0 {
        return;
    }
    out.push(REX_W);
    if size <= DISP8_MAX {
        out.push(ALU_RM64_IMM8);
        out.push(modrm(extension, RSP));
        out.push(wrapping_u8(size));
    } else {
        out.push(ALU_RM64_IMM32);
        out.push(modrm(extension, RSP));
        immediate(inout out, widen_u64(size), IMM32_BYTES);
    }
}

// The forward target is the next instruction, at the current end of output.
pub fn patch_forward_branch(inout out: ChunkSeq[u8], branch_end: u64) -> bool {
    let target = out.len();
    patch_relative_branch(inout out, branch_end, target)
}

pub fn patch_relative_branch(inout out: ChunkSeq[u8], branch_end: u64, target: u64) -> bool {
    let distance = wrapping_sub(target, branch_end);
    if distance > DISP32_MAX && distance < I32_MIN_BITS {
        return false;
    }
    let start = wrapping_sub(branch_end, IMM32_BYTES);
    for i in 0..IMM32_BYTES {
        let shift = wrapping_mul(wrapping_u32(i), wrapping_u32(BYTE_BITS));
        let byte = wrapping_u8(wrapping_shr_u64(distance, shift));
        let _ = out.try_set(wrapping_add(start, i), byte);
    }
    true
}

fn load_memory(inout out: ChunkSeq[u8], destination: u8, base: u8, displacement: u32, width: u64) {
    out.push(rex(destination, base, width == QWORD_BITS));
    if width == BYTE_BITS || width == WORD_BITS {
        out.push(TWO_BYTE_OPCODE);
        out.push(
            if width == BYTE_BITS {
                MOVZX_R32_RM8
            } else {
                MOVZX_R32_RM16
            }
        );
    } else {
        out.push(MOV_R64_RM);
    }

    memory_operand(inout out, destination, base, displacement);
}

fn store_memory(inout out: ChunkSeq[u8], source: u8, base: u8, displacement: u32, width: u64) {
    if width == WORD_BITS {
        out.push(OPERAND_SIZE_OVERRIDE);
    }
    out.push(rex(source, base, width == QWORD_BITS));
    out.push(
        if width == BYTE_BITS {
            MOV_RM_R8
        } else {
            MOV_RM_R64
        }
    );
    memory_operand(inout out, source, base, displacement);
}

fn memory_operand(inout out: ChunkSeq[u8], reg: u8, base: u8, displacement: u32) {
    let low_base = base & LOW_REGISTER_MASK;
    let mode = if displacement == 0 && low_base != RM_DISP32_WITHOUT_BASE {
        0
    } else if fits_signed_byte(displacement) {
        MOD_DISP8
    } else {
        MOD_DISP32
    };
    out.push(mode | modrm_fields(reg, base));
    if low_base == RM_SIB {
        out.push(SIB_NO_INDEX | low_base);
    }
    if mode == MOD_DISP8 {
        out.push(wrapping_u8(displacement));
    } else if mode == MOD_DISP32 {
        immediate(inout out, widen_u64(displacement), IMM32_BYTES);
    }
}

fn load_constant(inout out: ChunkSeq[u8], destination: u8, bits: u64) {
    if bits == 0 {
        let prefix = rex(destination, destination, false);
        if prefix != REX {
            out.push(prefix);
        }
        out.push(XOR_RM_R64);
        out.push(modrm(destination, destination));
    } else if bits <= U32_MAX_BITS {
        let prefix = rex(0, destination, false);
        if prefix != REX {
            out.push(prefix);
        }
        out.push(MOV_REGISTER_IMMEDIATE | (destination & LOW_REGISTER_MASK));
        immediate(inout out, bits, IMM32_BYTES);
    } else if bits >= I32_MIN_BITS {
        out.push(rex(0, destination, true));
        out.push(MOV_RM64_IMM32);
        out.push(modrm(0, destination));
        immediate(inout out, bits, IMM32_BYTES);
    } else {
        out.push(rex(0, destination, true));
        out.push(MOV_REGISTER_IMMEDIATE | (destination & LOW_REGISTER_MASK));
        immediate(inout out, bits, IMM64_BYTES);
    }
}

fn truncate(inout out: ChunkSeq[u8], destination: u8, source: u8, width: u64) {
    if width == DWORD_BITS {
        // A 32-bit write zeroes the high half, even for a self-move.
        binary(inout out, MOV_RM_R64, destination, source, false);
    } else {
        out.push(rex(destination, source, false));
        out.push(TWO_BYTE_OPCODE);
        out.push(
            if width == BYTE_BITS {
                MOVZX_R32_RM8
            } else {
                MOVZX_R32_RM16
            }
        );
        out.push(modrm(destination, source));
    }
}

fn sign_extend(inout out: ChunkSeq[u8], destination: u8, source: u8, from: u64, width: u64) {
    out.push(rex(destination, source, width == QWORD_BITS));
    if from == DWORD_BITS {
        out.push(MOVSXD_R64_RM32);
    } else {
        out.push(TWO_BYTE_OPCODE);
        out.push(
            if from == BYTE_BITS {
                MOVSX_R64_RM8
            } else {
                MOVSX_R64_RM16
            }
        );
    }
    out.push(modrm(destination, source));
    if width == WORD_BITS {
        truncate(inout out, destination, destination, width);
    }
}

fn normalize_small_result(inout out: ChunkSeq[u8], destination: u8, width: u64) {
    if width < DWORD_BITS {
        truncate(inout out, destination, destination, width);
    }
}

fn set_condition(inout out: ChunkSeq[u8], destination: u8, cc: u8) {
    out.push(rex(0, destination, false));
    out.push(TWO_BYTE_OPCODE);
    out.push(SETCC | cc);
    out.push(modrm(0, destination));
    truncate(inout out, destination, destination, BYTE_BITS);
}

fn compare_registers(inout out: ChunkSeq[u8], left: u8, right: u8, width: u64) {
    if width == WORD_BITS {
        out.push(OPERAND_SIZE_OVERRIDE);
    }
    // REX also selects the low byte of rsi/rdi for byte operations.
    out.push(rex(right, left, width == QWORD_BITS));
    out.push(
        if width == BYTE_BITS {
            CMP_RM_R8
        } else {
            CMP_RM_R64
        }
    );
    out.push(modrm(right, left));
}

fn compare_immediate(inout out: ChunkSeq[u8], reg: u8, bits: u32, width: u64) {
    if bits == 0 {
        if width == WORD_BITS {
            out.push(OPERAND_SIZE_OVERRIDE);
        }
        let opcode = if width == BYTE_BITS {
            TEST_RM_R8
        } else {
            TEST_RM_R64
        };
        binary(inout out, opcode, reg, reg, width == QWORD_BITS);
    } else {
        alu_immediate(inout out, ALU_CMP_EXTENSION, reg, bits, width);
    }
}

fn conditional_jump(inout out: ChunkSeq[u8], cc: u8) {
    out.push(TWO_BYTE_OPCODE);
    out.push(JCC_NEAR | cc);
    immediate(inout out, 0, IMM32_BYTES);
}

pub fn emit(inout out: ChunkSeq[u8], in instruction: Instruction) {
    match instruction {
        Instruction::Fixed(op, rhs, width) => fixed_arithmetic(
            inout out,
            in op,
            rhs,
            width == QWORD_BITS
        ),
        Instruction::Immediate(destination, bits) => load_constant(inout out, destination, bits),
        Instruction::Move(destination, source) => {
            if destination != source {
                binary(inout out, MOV_RM_R64, destination, source, true);
            }
        },
        Instruction::Exchange(left, right) => binary(inout out, XCHG_RM_R64, left, right, true),
        Instruction::Binary(opcode, destination, source, width) => {
            binary(inout out, opcode, destination, source, width == QWORD_BITS);
            // Low-width bitwise operations preserve the zeroed upper bits.
            if opcode == ADD_RM_R64 || opcode == SUB_RM_R64 {
                normalize_small_result(inout out, destination, width);
            }
        },
        Instruction::BinaryImmediate(extension, destination, bits, width) => {
            // The input is already zero-extended. A byte or word operation
            // preserves those zero upper bits.
            alu_immediate(inout out, extension, destination, bits, width);
        },
        Instruction::Multiply(destination, source, width) => {
            out.push(rex(destination, source, width == QWORD_BITS));
            out.push(TWO_BYTE_OPCODE);
            out.push(IMUL_R64_RM64);
            out.push(modrm(destination, source));
            normalize_small_result(inout out, destination, width);
        },
        Instruction::MultiplyImmediate(destination, source, bits, width) => {
            let short = fits_signed_byte(bits);
            out.push(rex(destination, source, width == QWORD_BITS));
            out.push(
                if short {
                    IMUL_R64_RM64_IMM8
                } else {
                    IMUL_R64_RM64_IMM32
                }
            );
            out.push(modrm(destination, source));
            immediate(inout out, widen_u64(bits), if short { 1 } else { IMM32_BYTES });
            normalize_small_result(inout out, destination, width);
        },
        Instruction::Unary(extension, destination, width) => {
            out.push(rex(0, destination, width == QWORD_BITS));
            out.push(UNARY_GROUP);
            out.push(modrm(extension, destination));
            normalize_small_result(inout out, destination, width);
        },
        Instruction::Shift(extension, destination, count, width) => {
            if width == WORD_BITS {
                out.push(OPERAND_SIZE_OVERRIDE);
            }
            out.push(rex(0, destination, width == QWORD_BITS));
            out.push(
                if width == BYTE_BITS {
                    SHIFT_BYTE_GROUP_IMM8
                } else {
                    SHIFT_GROUP_IMM8
                }
            );
            out.push(modrm(extension, destination));
            out.push(count);
            normalize_small_result(inout out, destination, width);
        },
        Instruction::ShiftRegister(extension, destination, count, width) => {
            // Legacy shifts read CL. Exchange full registers to preserve a
            // live RCX and restore the count when the operation is finished.
            let shifted = if count == RCX {
                destination
            } else {
                binary(inout out, XCHG_RM_R64, RCX, count, true);
                if destination == RCX {
                    count
                } else if destination == count {
                    RCX
                } else {
                    destination
                }
            };
            out.push(rex(0, shifted, width == QWORD_BITS));
            out.push(SHIFT_GROUP_CL);
            out.push(modrm(extension, shifted));
            if count != RCX {
                binary(inout out, XCHG_RM_R64, RCX, count, true);
            }
        },
        Instruction::Load(destination, base, displacement, width) => load_memory(
            inout out,
            destination,
            base,
            displacement,
            width
        ),
        Instruction::Store(source, base, displacement, width) => store_memory(
            inout out,
            source,
            base,
            displacement,
            width
        ),
        Instruction::Compare(destination, left, right, cc, width) => {
            compare_registers(inout out, left, right, width);
            set_condition(inout out, destination, cc);
        },
        Instruction::CompareImmediate(destination, source, bits, cc, width) => {
            compare_immediate(inout out, source, bits, width);
            set_condition(inout out, destination, cc);
        },
        Instruction::Select(destination, condition, first, alternative, cc) => {
            // Test before copying. The destination may share the condition register.
            binary(inout out, TEST_RM_R64, condition, condition, true);
            if destination != first {
                binary(inout out, MOV_RM_R64, destination, first, true);
            }
            out.push(rex(destination, alternative, true));
            out.push(TWO_BYTE_OPCODE);
            out.push(CMOVCC | cc);
            out.push(modrm(destination, alternative));
        },
        Instruction::Truncate(destination, source, width) => truncate(
            inout out,
            destination,
            source,
            width
        ),
        Instruction::SignExtend(destination, source, from, width) => sign_extend(
            inout out,
            destination,
            source,
            from,
            width
        ),
        Instruction::BranchZero(condition) => {
            binary(inout out, TEST_RM_R64, condition, condition, true);
            conditional_jump(inout out, CC_E);
        },
        Instruction::BranchCompare(left, right, cc, width) => {
            compare_registers(inout out, left, right, width);
            conditional_jump(inout out, cc);
        },
        Instruction::BranchCompareImmediate(left, bits, cc, width) => {
            compare_immediate(inout out, left, bits, width);
            conditional_jump(inout out, cc);
        },
        Instruction::Jump => {
            out.push(JMP_REL32);
            immediate(inout out, 0, IMM32_BYTES);
        },
        Instruction::FrameEnter(size) => adjust_stack(inout out, ALU_SUB_EXTENSION, size),
        Instruction::FrameLeave(size) => adjust_stack(inout out, ALU_ADD_EXTENSION, size),
        Instruction::StackAddress(destination, displacement) => {
            out.push(rex(destination, RSP, true));
            out.push(LEA);
            memory_operand(inout out, destination, RSP, displacement);
        },
        Instruction::Trap => trap(inout out),
        Instruction::Return => out.push(RET_NEAR),
    };
}
