// @export abi 4

use self::x86_64::{encode, select_leaf};

// Hybrid inputs describe frameless System V functions with one i64 result.
// An empty stream declines, leaving the module free to use Cranelift.
pub fn x86_64_leaf(op: u64, left: u64, right: u64) -> ChunkSeq[u8] {
    let mut bytes = ChunkSeq::new[u8]();
    match select_leaf(op, left, right) {
        Option::Some(machine) => encode(inout bytes, in machine),
        Option::None => (),
    };
    bytes
}
