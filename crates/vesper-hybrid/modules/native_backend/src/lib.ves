// @export abi 4

use self::aarch64::{encode as encode_aarch64, encode_leaf};
use self::coff::{write_coff};
use self::scalar::{encode_block};
use self::elf::{write_elf};
use self::macho::{write_macho};
use @vesper/codegen-freestanding::util::{push64};

pub fn aarch64_integer_leaf(in words: Slice[u64]) -> ChunkSeq[u8] {
    encode_leaf(in words)
}

// An empty result declines the block before the hybrid defines its symbol.
pub fn x86_64_integer_block(in words: Slice[u64]) -> ChunkSeq[u8] {
    let mut relocations = ChunkSeq::new[u64]();
    encode_block(in words, false, inout relocations)
}

// Length-prefixed code followed by (displacement offset, relocation kind,
// symbol ID) records, all fields encoded as little-endian u64s.
pub fn x86_64_relocatable_block(in words: Slice[u64]) -> ChunkSeq[u8] {
    let mut relocations = ChunkSeq::new[u64]();
    let code = encode_block(in words, true, inout relocations);
    relocation_packet(in code, in relocations)
}

pub fn aarch64_relocatable_block(in words: Slice[u64]) -> ChunkSeq[u8] {
    let mut relocations = ChunkSeq::new[u64]();
    let code = encode_aarch64(in words, true, inout relocations);
    relocation_packet(in code, in relocations)
}

fn relocation_packet(in code: ChunkSeq[u8], in relocations: ChunkSeq[u64]) -> ChunkSeq[u8] {
    let mut packet = ChunkSeq::new[u8]();
    if code.len() != 0 {
        push64(inout packet, code.len());
        packet.extend(in code.as_slice());
        for index in 0..relocations.len() {
            push64(inout packet, relocations.try_get(index).unwrap_or(0));
        }
    }
    packet
}

// An empty result declines the object request.
pub fn x86_64_elf_object(in words: Slice[u64], in bytes: Slice[u8]) -> ChunkSeq[u8] {
    write_elf(in words, in bytes, false)
}

// AArch64 relocation kinds are the ELF relocation numbers.
pub fn aarch64_elf_object(in words: Slice[u64], in bytes: Slice[u8]) -> ChunkSeq[u8] {
    write_elf(in words, in bytes, true)
}

// An empty result declines the Mach-O object request.
pub fn macho_object(in words: Slice[u64], in bytes: Slice[u8]) -> ChunkSeq[u8] {
    write_macho(in words, in bytes)
}

// An empty result declines the AMD64 COFF object request.
pub fn x86_64_coff_object(in words: Slice[u64], in bytes: Slice[u8]) -> ChunkSeq[u8] {
    write_coff(in words, in bytes)
}
