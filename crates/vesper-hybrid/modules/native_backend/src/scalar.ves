    saved_masks: ChunkSeq[u32],
    local_frame: u64,
    save_frame: u64,
    callee_save_frame: u64,
    callee_save_mask: u32,
}

pub fn word_at(in words: Slice[u64], position: u64) -> u64 {
    match words.try_get(position) {
        Option::Some(word) => word,
        Option::None => 0,
    }
}

pub fn read_record(in words: Slice[u64], index: u64) -> Record {
    let start = wrapping_add(HEADER_WORDS, wrapping_mul(index, RECORD_WORDS));
    Record {
        op: word_at(in words, wrapping_add(start, OP)),
        left: word_at(in words, wrapping_add(start, LEFT)),
        right: word_at(in words, wrapping_add(start, RIGHT)),
        extra: word_at(in words, wrapping_add(start, EXTRA))
    }
}

fn write_record(inout words: ChunkSeq[u64], index: u64, in record: Record) {
    let start = wrapping_add(HEADER_WORDS, wrapping_mul(index, RECORD_WORDS));
    let _ = words.try_set(wrapping_add(start, OP), record.op);
    let _ = words.try_set(wrapping_add(start, LEFT), record.left);
    let _ = words.try_set(wrapping_add(start, RIGHT), record.right);
    let _ = words.try_set(wrapping_add(start, EXTRA), record.extra);
}

fn fold_memory_address(
    in words: Slice[u64],
    in reads: ChunkSeq[u64],
    arguments: u64,
    index: u64,
    in memory: Record
) -> Option[Record] {
    let store = is_store(memory.op);
    if index == 0 || (!store && memory.op != LOAD && memory.op != FLOAT_LOAD) {
        return Option::None;
    }
    let address_index = wrapping_sub(index, 1);
    let address_value = wrapping_add(arguments, address_index);
    if memory.left != address_value
        || (store && memory.right == address_value)
        || last_read(in reads, address_value) != wrapping_add(address_value, 1)
    {
        return Option::None;
    }
    let address = read_record(in words, address_index);
    if address.extra != QWORD_BITS || (address.op != ADD_IMMEDIATE && address.op != SUB_IMMEDIATE) {
        return Option::None;
    }
    let displacement = widen_i64(wrapping_i32(if store { memory.extra } else { memory.right }));
    let immediate = widen_i64(wrapping_i32(address.right));
    let combined = if address.op == ADD_IMMEDIATE {
        wrapping_add(displacement, immediate)
    } else {
        wrapping_sub(displacement, immediate)
    };
    let encoded = wrapping_i32(combined);
    if widen_i64(encoded) != combined {
        return Option::None;
    }
    let bits = widen_u64(wrapping_u32(encoded));
    Option::Some(Record {
        op: memory.op,
        left: address.left,
        right: if store { memory.right } else { bits },
        extra: if store { bits } else { memory.extra }
    })
}

// Keep original record IDs when rewriting inputs. The second analysis
// discards dead arithmetic and computes the new operand lifetimes.
fn optimize_scalar_block(
    in words: Slice[u64],
    in reads: ChunkSeq[u64],
    arguments: u64,
    count: u64
) -> ChunkSeq[u64] {
    let mut folded = ChunkSeq::new[u64]();
    let mut next: u64 = 0;
    for index in 0..count {
        if index < next {
            continue;
        }
        let first = read_record(in words, index);
        if first.op != ADD || (first.extra != DWORD_BITS && first.extra != QWORD_BITS) {
            match fold_memory_address(in words, in reads, arguments, index, in first) {
                Option::Some(memory) => {
                    if folded.len() == 0 {
                        folded.extend(in words);
                    }
                    write_record(inout folded, index, in memory);
                },
                Option::None => {},
            };
            continue;
        }
        // A wrapping add chain can become one multiply and one add.
        let mut base = first.left;
        let mut term = first.right;
        let mut end = index;
        for candidate in wrapping_add(index, 1)..count {
            let previous = wrapping_add(arguments, wrapping_sub(candidate, 1));
            let current = read_record(in words, candidate);
            // The preceding value is defined immediately before this record.
            // Its last read here proves that no other record can use it.
            if current.op != ADD
                || current.extra != first.extra
                || last_read(in reads, previous) != wrapping_add(previous, 1)
            {
                break;
            }
            let repeated = if current.left == previous {
                current.right
            } else if current.right == previous {
                current.left
            } else {
                break;
            };
            if repeated != term {
                if candidate == wrapping_add(index, 1) && repeated == first.left {
                    base = first.right;
                    term = first.left;
                } else {
                    break;
                }
            }
            end = candidate;
        }
        let length = wrapping_add(wrapping_sub(end, index), 1);
        next = wrapping_add(end, 1);
        if length < MIN_FOLDED_ADDS || length > MAX_FOLDED_ADDS {
            continue;
        }
        if folded.len() == 0 {
            folded.extend(in words);
        }
        let product = wrapping_sub(end, 1);
        write_record(
            inout folded,
            product,
            in Record { op: MUL_IMMEDIATE, left: term, right: length, extra: first.extra }
        );
        write_record(
            inout folded,
            end,
            in Record {
                op: ADD,
                left: base,
                right: wrapping_add(arguments, product),
                extra: first.extra
            }
        );
    }
    folded
}

fn call_argument(in words: Slice[u64], start: u64, argument: u64) -> u64 {
    read_record(in words, wrapping_add(start, argument)).left
}

pub fn align_up(size: u64, alignment: u64) -> u64 {
    let mask = wrapping_sub(alignment, 1);
    wrapping_add(size, mask) & ~mask
}

fn aligned_frame_size(used: u64) -> u64 {
    // Incoming RSP is one return address below a 16-byte boundary.
    wrapping_sub(
        align_up(wrapping_add(used, RETURN_ADDRESS_BYTES), STACK_ALIGNMENT),
        RETURN_ADDRESS_BYTES
    )
}

fn frame_layout(in words: Slice[u64], count: u64) -> Option[FrameLayout] {
    let mut slots = ChunkSeq::new[FrameSlot]();
    let mut used: u64 = 0;
    for index in 0..count {
        let record = read_record(in words, index);
        if record.op != STACK_SLOT {
            break;
        }
        let alignment = record.right;
        if alignment == 0
            || alignment > STACK_ALIGNMENT
            || (alignment & wrapping_sub(alignment, 1)) != 0
            || record.left > STACK_PROBE_INTERVAL
        {
            return Option::None;
        }
        let offset = align_up(used, alignment);
        used = wrapping_add(offset, record.left);
        if used > STACK_PROBE_INTERVAL {
            return Option::None;
        }
        slots.push(FrameSlot { offset: offset, size: record.left });
    }
    let size = if slots.len() == 0 {
        0
    } else {
        aligned_frame_size(used)
    };
    if size > STACK_PROBE_INTERVAL {
        return Option::None;
    }
    Option::Some(FrameLayout {
        slots: slots,
        size: size,
        used: false,
        outgoing: 0,
        fixed: false,
        floating: false,
        vectors: false,
        xmm_aux: false,
        temporary_registers: 0,
        indirect_calls: false,
        home_slot: NO_VALUE,
        promoted: 0,
        gp_homes: 0,
        single_homes: 0,
        double_homes: 0
    })
}

fn last_read(in reads: ChunkSeq[u64], value: u64) -> u64 {
    match reads.try_get(value) {
        Option::Some(user) => user,
        Option::None => NEVER_READ,
    }
}

fn first_read_backwards(inout reads: ChunkSeq[u64], value: u64, user: u64) {
    if last_read(in reads, value) == NEVER_READ {
        let _ = reads.try_set(value, user);
    }
}

fn is_comparison(op: u64) -> bool {
    op == COMPARE
        || op == COMPARE_BYTE
        || op == COMPARE_WORD
        || op == COMPARE_DWORD
        || is_immediate_comparison(op)
}

fn is_immediate_comparison(op: u64) -> bool {
    op >= COMPARE_IMMEDIATE && op <= COMPARE_DWORD_IMMEDIATE
}

fn is_immediate_arithmetic(op: u64) -> bool {
    op >= ADD_IMMEDIATE && op <= XOR_IMMEDIATE
}

fn comparison_width(op: u64) -> u64 {
    match op {
        COMPARE_BYTE | COMPARE_BYTE_IMMEDIATE => BYTE_BITS,
        COMPARE_WORD | COMPARE_WORD_IMMEDIATE => WORD_BITS,
        COMPARE_DWORD | COMPARE_DWORD_IMMEDIATE => DWORD_BITS,
        _ => QWORD_BITS,
    }
}

fn valid_width(width: u64) -> bool {
    width == BYTE_BITS || width == WORD_BITS || width == DWORD_BITS || width == QWORD_BITS
}

fn is_register_shift(op: u64) -> bool {
    op >= SHL_REGISTER && op <= SAR_REGISTER
}

fn is_store(op: u64) -> bool {
    (op >= STORE_BYTE && op <= STORE_QWORD)
        || op == FLOAT_STORE32
        || op == FLOAT_STORE64
        || op == VECTOR_STORE
}

fn is_stack_store(op: u64) -> bool {
    (op >= STACK_STORE_BYTE && op <= STACK_STORE_QWORD)
        || op == FLOAT_STACK_STORE32
        || op == FLOAT_STACK_STORE64
}

fn is_stack_operation(op: u64) -> bool {
    (op >= STACK_ADDRESS && op <= STACK_STORE_QWORD) || is_float_stack_operation(op)
}

fn is_float_stack_operation(op: u64) -> bool {
    op == FLOAT_STACK_LOAD || op == FLOAT_STACK_STORE32 || op == FLOAT_STACK_STORE64
}

fn is_home_reload(in record: Record, home_slot: u64) -> bool {
    (record.op == STACK_LOAD || record.op == FLOAT_STACK_LOAD) && record.left == home_slot
}

fn stack_slot(in record: Record) -> u64 {
    if is_stack_store(record.op) {
        record.right
    } else {
        record.left
    }
}

fn stack_access_offset(in record: Record) -> u64 {
    if is_stack_store(record.op) {
        record.extra
    } else {
        record.right
    }
}

fn is_cfg_record(op: u64) -> bool {
    (op >= BLOCK_LABEL && op <= BRANCH_BLOCK) || op == BRANCH_TABLE || op == BRANCH_TABLE_TARGET
}

fn has_no_result(op: u64) -> bool {
    (op >= STORE_BYTE && op <= STACK_SLOT)
        || is_stack_store(op)
        || op == RETURN_PAIR
        || op == CALL_ARGUMENT
        || op == CALL_VOID
        || op == TAIL_CALL
        || op == TRAP
        || is_conditional_trap(op)
        || op == FENCE
        || op == FLOAT_RETURN
        || op == FLOAT_STORE32
        || op == FLOAT_STORE64
        || op == VECTOR_STORE
        || is_cfg_record(op)
}

pub fn is_conditional_trap(op: u64) -> bool {
    op == TRAP_IF_ZERO || op == TRAP_IF_NONZERO
}

pub fn is_call(op: u64) -> bool {
    op == CALL || op == CALL_VOID || op == CALL_PAIR || op == CALL_FLOAT || op == CALL_FLOAT32
}

pub fn indirect_call(layout: u64) -> bool {
    (layout & INDIRECT_CALL) != 0
}

pub fn is_atomic_rmw(op: u64) -> bool {
    op >= ATOMIC_ADD && op <= ATOMIC_EXCHANGE
}

fn atomic_uses_retry(op: u64) -> bool {
    op >= ATOMIC_AND && op <= ATOMIC_SIGNED_MAX
}

pub fn is_atomic_update(op: u64) -> bool {
    is_atomic_rmw(op) || atomic_uses_retry(op)
}

pub fn is_atomic_cas(op: u64) -> bool {
    op >= ATOMIC_CAS_BYTE && op <= ATOMIC_CAS_QWORD
}

fn is_fixed_arithmetic(op: u64) -> bool {
    (op >= SIGNED_DIV && op <= UNSIGNED_MUL_HIGH)
        || op == UNSIGNED_MUL_OVERFLOW
        || op == SIGNED_MUL_OVERFLOW
}

fn uses_fixed_registers(op: u64) -> bool {
    is_fixed_arithmetic(op) || is_atomic_cas(op) || atomic_uses_retry(op)
}

fn is_scalar_bit_operation(op: u64) -> bool {
    (op >= LEADING_ZEROS && op <= LEADING_SIGN_BITS) || op == ABS
}

fn is_bit_mix(op: u64) -> bool {
    op >= ROTATE_RIGHT && op <= XOR_NOT
}

pub fn is_integer_division(op: u64) -> bool {
    op >= SIGNED_DIV && op <= UNSIGNED_REM
}

fn fixed_result(op: u64) -> u8 {
    if op == SIGNED_DIV
        || op == UNSIGNED_DIV
        || op == UNSIGNED_MUL_OVERFLOW
        || op == SIGNED_MUL_OVERFLOW
        || is_atomic_cas(op)
        || atomic_uses_retry(op)
    {
        RAX
    } else {
        RDX
    }
}

pub fn is_checked_arithmetic(op: u64) -> bool {
    op >= UNSIGNED_ADD_OVERFLOW && op <= SIGNED_MUL_OVERFLOW
}

pub fn consumes_carry(op: u64) -> bool {
    op == ADD_CARRY || op == SUB_BORROW
}

pub fn live_overflow_flag(in reads: ChunkSeq[u64], value: u64, op: u64) -> bool {
    is_checked_arithmetic(op) && last_read(in reads, wrapping_add(value, 1)) != NEVER_READ
}

fn overflow_condition(op: u64) -> u8 {
    if op == SIGNED_ADD_OVERFLOW || op == SIGNED_SUB_OVERFLOW || op == SIGNED_MUL_OVERFLOW {
        CC_O
    } else {
        CC_B
    }
}

pub fn is_symbol(op: u64) -> bool {
    op == SYMBOL_RELATIVE || op == SYMBOL_GOT || op == FUNCTION_GOT
}

fn store_width(op: u64) -> u64 {
    match op {
        STORE_BYTE | STACK_STORE_BYTE => BYTE_BITS,
        STORE_WORD | STACK_STORE_WORD => WORD_BITS,
        STORE_DWORD | STACK_STORE_DWORD | FLOAT_STORE32 | FLOAT_STACK_STORE32 => DWORD_BITS,
        VECTOR_STORE => VECTOR_BITS,
        _ => QWORD_BITS,
    }
}

fn immediate_store_consumer(in record: Record, value: u64, bits: u64) -> bool {
    let uses_source = if record.op >= STORE_BYTE && record.op <= STORE_QWORD {
        record.right == value && record.left != value
    } else {
        record.op >= STACK_STORE_BYTE && record.op <= STACK_STORE_QWORD && record.left == value
    };
    let width = store_width(record.op);
    // A register zeroing idiom can be shorter than a full-size immediate.
    uses_source && (bits != 0 || width < DWORD_BITS) && store_immediate_fits(bits, width)
}

fn stack_displacement(in frame: FrameLayout, in record: Record) -> Option[u32] {
    let store = is_stack_store(record.op);
    let index = if store { record.right } else { record.left };
    let offset = if store { record.extra } else { record.right };
    let width = if store {
        store_width(record.op)
    } else if record.op == STACK_LOAD || record.op == FLOAT_STACK_LOAD {
        if !valid_width(record.extra)
            || (record.op == FLOAT_STACK_LOAD
                && record.extra != DWORD_BITS
                && record.extra != QWORD_BITS)
        {
            return Option::None;
        }
        record.extra
    } else {
        0
    };
    match frame.slots.try_get(index) {
        Option::Some(slot) => {
            if offset <= slot.size && width / BYTE_BITS <= wrapping_sub(slot.size, offset) {
                Option::Some(wrapping_u32(wrapping_add(slot.offset, offset)))
            } else {
                Option::None
            }
        },
        Option::None => Option::None,
    }
}

fn track_home(inout frame: FrameLayout, in record: Record) {
    if frame.promoted == 0 || stack_slot(in record) != frame.home_slot {
        return;
    }
    let offset = stack_access_offset(in record);
    if record.op == STACK_ADDRESS || offset % SPILL_SLOT_BYTES != 0 {
        // Escaping addresses and overlapping accesses can reach other cells.
        frame.promoted = 0;
        return;
    }
    let home = offset / SPILL_SLOT_BYTES;
    if home >= frame.promoted {
        return;
    }
    let integer_qword = record.op == STACK_STORE_QWORD
        || (record.op == STACK_LOAD && record.extra == QWORD_BITS);
    let floating = is_float_stack_operation(record.op);
    if !integer_qword && !floating {
        // Narrow integer accesses within promotable cells still need memory.
        frame.promoted = 0;
        return;
    }
    let bit = register_bit(wrapping_u8(home));
    if integer_qword {
        frame.gp_homes = frame.gp_homes | bit;
    } else if record.op == FLOAT_STACK_STORE32
        || (record.op == FLOAT_STACK_LOAD && record.extra == DWORD_BITS)
    {
        frame.single_homes = frame.single_homes | bit;
    } else {
        frame.double_homes = frame.double_homes | bit;
    }
}

fn promoted_home(in frame: FrameLayout, in record: Record) -> u8 {
    let home = stack_access_offset(in record) / SPILL_SLOT_BYTES;
    if stack_slot(in record) != frame.home_slot || home >= frame.promoted {
        return UNASSIGNED;
    }
    let bit = register_bit(wrapping_u8(home));
    if (frame.gp_homes & bit) != 0 {
        home_register(home)
    } else if ((frame.single_homes | frame.double_homes) & bit) != 0 {
        xmm_home_register(home)
    } else {
        UNASSIGNED
    }
}

fn local_displacement(in frame: FrameLayout, in record: Record, local_frame: u64) -> Option[u32] {
    match stack_displacement(in frame, in record) {
        Option::Some(offset) => Option::Some(wrapping_u32(wrapping_add(
            local_frame,
            widen_u64(offset)
        ))),
        Option::None => Option::None,
    }
}

fn reads_left(in record: Record) -> bool {
    let op = record.op;
    op != CONSTANT
        && op != VECTOR_CONSTANT
        && op != STACK_SLOT
        && op != STACK_POINTER
        && op != STACK_ADDRESS
        && op != STACK_LOAD
        && op != FLOAT_STACK_LOAD
        && op != RETURN_PAIR
        && !is_call(op)
        && op != TAIL_CALL
        && !is_symbol(op)
        && op != CALL_ARGUMENT
        && op != CALL_STACK_ARGUMENT
        && op != CALL_HIGH
        && op != OVERFLOW_FLAG
        && op != TRAP
        && op != FENCE
        && op != BLOCK_LABEL
        && op != EDGE_LABEL
        && op != JUMP_LABEL
        && op != BRANCH_TABLE_TARGET
        && op != FLOAT_ARGUMENT
        && op != STACK_ARGUMENT
        && op != FLOAT_STACK_ARGUMENT
        && op != FLOAT_CONSTANT
        && op != FLOAT_RETURN
        && (!is_branch_return(op) || (record.left != NO_VALUE && record.left != TRAP_VALUE))
}

fn reads_right(in record: Record, paired: bool) -> bool {
    let op = record.op;
    (op >= ADD && op <= XOR)
        || (is_comparison(op) && !is_immediate_comparison(op))
        || op == SELECT
        || op == FLOAT_SELECT
        || is_float_binary(op)
        || is_vector_binary(op)
        || op == VECTOR_INSERT
        || is_float_fma(op)
        || is_float_compare(op)
        || is_register_shift(op)
        || (is_bit_mix(op) && op != ROTATE_RIGHT)
        || is_fixed_arithmetic(op)
        || is_checked_arithmetic(op)
        || is_atomic_update(op)
        || is_atomic_cas(op)
        || consumes_carry(op)
        || is_store(op)
        || (is_branch_return(op) && paired && record.left != TRAP_VALUE)
}

pub fn is_float_binary(op: u64) -> bool {
    (op >= FLOAT_ADD && op <= FLOAT_DIV) || op == FLOAT_COPY_SIGN || is_float_min_max(op)
}

fn is_float_min_max(op: u64) -> bool {
    op == FLOAT_MIN || op == FLOAT_MAX
}

pub fn is_float_fma(op: u64) -> bool {
    op == FLOAT_FMA32 || op == FLOAT_FMA64
}

fn reads_third(op: u64) -> bool {
    op == SELECT
        || op == FLOAT_SELECT
        || is_float_fma(op)
        || consumes_carry(op)
        || is_atomic_cas(op)
}

pub fn is_float_compare(op: u64) -> bool {
    op == FLOAT_COMPARE32 || op == FLOAT_COMPARE64
}

pub fn is_float_conversion(op: u64) -> bool {
    op >= FLOAT_PROMOTE && op <= UNSIGNED_TO_FLOAT
}

pub fn is_float_to_integer(op: u64) -> bool {
    op == FLOAT_TO_SIGNED_SAT || op == FLOAT_TO_UNSIGNED_SAT
}

pub fn is_vector_binary(op: u64) -> bool {
    (op >= VECTOR_AND && op <= VECTOR_ROUNDED_AVERAGE)
        || op == VECTOR_PAIRWISE_ADD
        || op == VECTOR_SWIZZLE
        || op == VECTOR_INTEGER_COMPARE
}

fn is_vector_convert(op: u64) -> bool {
    op == VECTOR_PROMOTE_LOW || op == VECTOR_DEMOTE
}

pub fn uses_vector_left(op: u64) -> bool {
    is_vector_binary(op) || is_vector_convert(op) || op >= VECTOR_INSERT && op <= VECTOR_HIGH_BITS
}

pub fn is_vector_operation(op: u64) -> bool {
    (op >= VECTOR_CONSTANT && op <= VECTOR_HIGH_BITS) || op == VECTOR_INTEGER_COMPARE
}

pub fn valid_vector_lane(index: u64, width: u64) -> bool {
    valid_width(width)
        && index < VECTOR_BITS / BYTE_BITS
        && wrapping_mul(index, width) < VECTOR_BITS
}

fn vector_binary_opcode(op: u64, width: u64) -> u8 {
    let packed = match op {
        VECTOR_AND => return PAND,
        VECTOR_OR => return POR,
        VECTOR_XOR => return PXOR,
        VECTOR_ADD => PackedInteger::Add,
        VECTOR_SUB => PackedInteger::Subtract,
        VECTOR_SIGNED_SAT_ADD => PackedInteger::SignedSaturatingAdd,
        VECTOR_UNSIGNED_SAT_ADD => PackedInteger::UnsignedSaturatingAdd,
        VECTOR_SIGNED_SAT_SUB => PackedInteger::SignedSaturatingSubtract,
        VECTOR_UNSIGNED_SAT_SUB => PackedInteger::UnsignedSaturatingSubtract,
        _ => PackedInteger::RoundedAverage,
    };
    packed_integer_opcode(in packed, width)
}

pub fn is_vector_result(op: u64) -> bool {
    (op >= VECTOR_CONSTANT && op <= VECTOR_INSERT && op != VECTOR_STORE)
        || op == VECTOR_INTEGER_COMPARE
}

pub fn vector_value(in words: Slice[u64], arguments: u64, value: u64) -> bool {
    value >= arguments && is_vector_result(read_record(in words, wrapping_sub(value, arguments)).op)
}

fn is_float_result(op: u64) -> bool {
    (op >= FLOAT_ARGUMENT && op <= FLOAT_ABS)
        || op == FLOAT_LOAD
        || op == BITS_TO_FLOAT
        || op == FLOAT_SELECT
        || op == CALL_FLOAT
        || op == FLOAT_STACK_LOAD
        || op == FLOAT_COPY_SIGN
        || (op >= CALL_FLOAT32 && op <= UNSIGNED_TO_FLOAT)
        || (op >= FLOAT_CEIL && op <= FLOAT_FMA64)
        || op == FLOAT_STACK_ARGUMENT
        || is_vector_result(op)
}

pub fn float_value(in words: Slice[u64], arguments: u64, value: u64) -> bool {
    value >= arguments && is_float_result(read_record(in words, wrapping_sub(value, arguments)).op)
}

fn float_left(op: u64) -> bool {
    (op >= FLOAT_ADD && op <= FLOAT_COMPARE64)
        || op == FLOAT_TO_BITS
        || op == FLOAT_STACK_STORE32
        || op == FLOAT_STACK_STORE64
        || op == FLOAT_COPY_SIGN
        || op == FLOAT_PROMOTE
        || op == FLOAT_DEMOTE
        || op == FLOAT_TO_INTEGER_TRUNC
        || uses_vector_left(op)
        || (op >= FLOAT_TO_SIGNED_SAT && op <= FLOAT_FMA64)
}

fn float_right(op: u64) -> bool {
    is_float_binary(op)
        || is_float_fma(op)
        || is_float_compare(op)
        || op == FLOAT_SELECT
        || op == FLOAT_STORE32
        || op == FLOAT_STORE64
        || op == VECTOR_STORE
        || is_vector_binary(op)
}

pub fn valid_float_operands(
    in words: Slice[u64],
    arguments: u64,
    count: u64,
    paired: bool,
    float_return: bool
) -> bool {
    for index in 0..count {
        let record = read_record(in words, index);
        let left_is_float = float_left(record.op) || (is_branch_return(record.op) && float_return);
        let extra_is_float = record.op == FLOAT_SELECT || is_float_fma(record.op);
        if (reads_left(in record) && float_value(in words, arguments, record.left) != left_is_float)
            || (reads_right(in record, paired)
                && float_value(in words, arguments, record.right) != float_right(record.op))
            || ((record.op == SELECT
                || extra_is_float
                || consumes_carry(record.op)
                || is_atomic_cas(record.op))
                && float_value(in words, arguments, record.extra) != extra_is_float)
        {
            return false;
        }
    }
    true
}

fn valid_vector_operands(in words: Slice[u64], arguments: u64, count: u64, paired: bool) -> bool {
    for index in 0..count {
        let record = read_record(in words, index);
        let vector_binary = is_vector_binary(record.op);
        if (reads_left(in record)
            && vector_value(in words, arguments, record.left) != uses_vector_left(record.op))
            || (reads_right(in record, paired)
                && vector_value(in words, arguments, record.right)
                    != (vector_binary || record.op == VECTOR_STORE))
            || ((record.op == FLOAT_SELECT || is_float_fma(record.op))
                && vector_value(in words, arguments, record.extra))
        {
            return false;
        }
    }
    true
}

fn is_branch_return(op: u64) -> bool {
    op == EARLY_RETURN || op == BLOCK_RETURN
}

pub fn valid_block_layout(in words: Slice[u64], start: u64, count: u64, returns: u64) -> bool {
    let mut part = BlockPart::End;
    for index in start..count {
        let record = read_record(in words, index);
        match part {
            BlockPart::End => {
                if record.op != BLOCK_LABEL
                    || record.extra != returns
                    || record.left >= count
                    || (index == start && record.left != 0)
                    || (index != start && record.right != 0)
                {
                    return false;
                }
                part = BlockPart::Body;
            },
            BlockPart::Body => {
                if record.op == BRANCH_LABEL {
                    part = BlockPart::Taken(record.right);
                } else if record.op == BRANCH_BLOCK {
                    part = BlockPart::JumpOnly;
                } else if record.op == BRANCH_TABLE {
                    if record.right == 0
                        || record.right > DISP32_MASK
                        || record.right >= wrapping_sub(count, index)
                        || record.extra == 0
                        || record.extra >= count
                    {
                        return false;
                    }
                    part = BlockPart::Table(record.right);
                } else if record.op == JUMP_LABEL || record.op == BLOCK_RETURN {
                    part = BlockPart::End;
                } else if record.op == BLOCK_LABEL
                    || record.op == EDGE_LABEL
                    || record.op == BRANCH_ZERO
                    || record.op == EARLY_RETURN
                    || record.op == RETURN_PAIR
                    || record.op == TRAP
                    || record.op == BRANCH_TABLE_TARGET
                {
                    return false;
                }
            },
            BlockPart::Taken(label) => {
                if record.op == JUMP_LABEL {
                    part = BlockPart::AwaitingEdge(label);
                } else if !is_stack_store(record.op) {
                    return false;
                }
            },
            BlockPart::AwaitingEdge(label) => {
                if record.op != EDGE_LABEL || record.left != label || record.left >= count {
                    return false;
                }
                part = BlockPart::Untaken;
            },
            BlockPart::Untaken => {
                if record.op == JUMP_LABEL {
                    part = BlockPart::End;
                } else if !is_stack_store(record.op) {
                    return false;
                }
            },
            BlockPart::JumpOnly => {
                if record.op != JUMP_LABEL {
                    return false;
                }
                part = BlockPart::End;
            },
            BlockPart::Table(remaining) => {
                if record.op != BRANCH_TABLE_TARGET || record.left == 0 || record.left >= count {
                    return false;
                }
                part = if remaining == 1 {
                    BlockPart::End
                } else {
                    BlockPart::Table(wrapping_sub(remaining, 1))
                };
            },
        };
    }
    match part {
        BlockPart::End => true,
        _ => false,
    }
}

// A shift must keep its count until the destructive instruction reads it.
fn can_reuse_right(op: u64) -> bool {
    op != SUB
        && op != SUB_BORROW
        && op != SIGNED_SUB_OVERFLOW
        && op != UNSIGNED_SUB_OVERFLOW
        && op != FLOAT_SUB
        && op != FLOAT_DIV
        && op != FLOAT_COPY_SIGN
        && op != VECTOR_SUB
        && op != VECTOR_SIGNED_SAT_SUB
        && op != VECTOR_UNSIGNED_SAT_SUB
        && op != VECTOR_PAIRWISE_ADD
        && op != VECTOR_SWIZZLE
        && op != VECTOR_INTEGER_COMPARE
        && !is_bit_mix(op)
        && !is_register_shift(op)
}

fn condition_code(condition: u64) -> u8 {
    match condition {
        EQUAL => CC_E,
        NOT_EQUAL => CC_NE,
        SIGNED_LESS => CC_L,
        SIGNED_GREATER_EQUAL => CC_GE,
        SIGNED_GREATER => CC_G,
        SIGNED_LESS_EQUAL => CC_LE,
        UNSIGNED_LESS => CC_B,
        UNSIGNED_GREATER_EQUAL => CC_AE,
        UNSIGNED_GREATER => CC_A,
        _ => CC_BE,
    }
}

fn is_conditional_branch(op: u64) -> bool {
    op == BRANCH_ZERO || op == BRANCH_LABEL || op == BRANCH_BLOCK
}

fn flags_feed_branch(in reads: ChunkSeq[u64], value: u64, in branch: Record) -> bool {
    is_conditional_branch(branch.op)
        && branch.left == value
        && last_read(in reads, value) == wrapping_add(value, 1)
}

// Walk backwards to discard dead arithmetic while keeping memory operations
// and their inputs in program order.
fn find_last_reads(
    in words: Slice[u64],
    arguments: u64,
    count: u64,
    result: u64,
    second: u64,
    return_arity: u64,
    allow_relocations: bool,
    labeled: bool,
    inout frame: FrameLayout
) -> Option[ChunkSeq[u64]] {
    let values = wrapping_add(arguments, count);
    let mut reads = ChunkSeq::with_capacity[u64](values);
    for i in 0..values {
        reads.push(NEVER_READ);
    }
    if result != NO_VALUE {
        let _ = reads.try_set(result, values);
    }
    let paired = return_arity == PAIRED_RESULTS;
    if second != NO_VALUE {
        let _ = reads.try_set(second, values);
    }
    let mut arms = ChunkSeq::new[BranchArm]();
    let mut depth: u64 = 0;
    let mut pending_arguments: u64 = 0;
    let mut has_calls = false;
    let mut block_end = values;
    let mut entry_end = values;
    for reverse_index in 0..count {
        let index = wrapping_sub(wrapping_sub(count, 1), reverse_index);
        let value = wrapping_add(arguments, index);
        let record = read_record(in words, index);
        let tail_call = record.op == TAIL_CALL;
        let bit_operation = is_scalar_bit_operation(record.op);
        let bit_mix = is_bit_mix(record.op);
        let cas = is_atomic_cas(record.op);
        let atomic_retry = atomic_uses_retry(record.op);
        if (record.op > BYTE_SWAP
            && record.op != FUNCTION_GOT
            && record.op != STACK_POINTER
            && record.op != FLOAT_TO_INTEGER_TRUNC
            && !is_float_to_integer(record.op)
            && !is_conditional_trap(record.op)
            && !is_float_conversion(record.op)
            && !(record.op >= FLOAT_CEIL && record.op <= FLOAT_FMA64)
            && !tail_call
            && !bit_operation
            && !bit_mix
            && !cas
            && !atomic_retry
            && !is_vector_operation(record.op))
            || (!labeled && is_cfg_record(record.op))
            || (record.op == STACK_SLOT && index >= frame.slots.len())
            || (record.op == RETURN_PAIR && (reverse_index != 0 || record.left >= value))
            || (record.op == TRAP && (reverse_index != 0 || result != NO_VALUE))
            || (record.op == FLOAT_RETURN && (reverse_index != 0 || result == NO_VALUE))
            || (tail_call
                && (reverse_index != 0 || labeled || result != NO_VALUE || arguments > ARGUMENTS))
        {
            return Option::None;
        }
        if record.op >= FLOAT_ARGUMENT && record.op <= FLOAT_COPY_SIGN {
            frame.floating = true;
            let entry_start = wrapping_add(frame.slots.len(), if labeled { 1 } else { 0 });
            if record.op == FLOAT_ARGUMENT
                && (record.left >= XMM_ARGUMENTS || index != wrapping_add(entry_start, record.left))
            {
                return Option::None;
            }
            if ((record.op >= FLOAT_ARGUMENT && record.op <= FLOAT_ABS)
                || record.op == FLOAT_LOAD
                || record.op == BITS_TO_FLOAT
                || record.op == FLOAT_TO_BITS
                || record.op == FLOAT_COPY_SIGN)
                && record.extra != DWORD_BITS
                && record.extra != QWORD_BITS
            {
                return Option::None;
            }
            if (is_float_compare(record.op) && record.extra > FLOAT_UNORDERED_OR_GREATER_EQUAL)
                || (record.op == FLOAT_LOAD && record.right > DISP32_MASK)
            {
                return Option::None;
            }
        }
        let last = last_read(in reads, value);
        let live = last != NEVER_READ || live_overflow_flag(in reads, value, record.op);
        if bit_operation {
            let hardware = record.op == POPULATION_COUNT && record.right == X86_HARDWARE_POPCOUNT;
            if !valid_width(record.extra) || (record.right != 0 && !hardware) {
                return Option::None;
            }
            if live && !hardware {
                frame.temporary_registers = frame.temporary_registers | register_bit(THIRD_SCRATCH);
                if record.op == POPULATION_COUNT || record.op == REVERSE_BITS {
                    frame.temporary_registers = frame.temporary_registers
                        | register_bit(RIGHT_SCRATCH);
                }
            }
        }
        if bit_mix {
            let valid = if record.op == FUNNEL_RIGHT {
                record.extra < QWORD_BITS
            } else {
                valid_width(record.extra)
            };
            if !valid {
                return Option::None;
            }
            if live && record.op >= AND_NOT {
                frame.temporary_registers = frame.temporary_registers | register_bit(THIRD_SCRATCH);
            }
        }
        if is_vector_operation(record.op) {
            let valid = match record.op {
                VECTOR_CONSTANT | VECTOR_AND | VECTOR_OR | VECTOR_XOR => record.extra == 0,
                VECTOR_LOAD => record.right <= DISP32_MASK && record.extra == 0,
                VECTOR_STORE => record.extra <= DISP32_MASK,
                VECTOR_SPLAT => record.right == 0 && valid_width(record.extra),
                VECTOR_ADD | VECTOR_SUB => valid_width(record.extra),
                VECTOR_PAIRWISE_ADD => record.extra == BYTE_BITS
                    || record.extra == WORD_BITS
                    || record.extra == DWORD_BITS,
                VECTOR_SWIZZLE => record.extra == 0 || record.extra == X86_SWIZZLE_ZERO_HIGH,
                VECTOR_INTEGER_COMPARE => valid_width(record.extra & VECTOR_LANE_WIDTH_MASK)
                    && wrapping_shr_u64(record.extra, VECTOR_CONDITION_SHIFT)
                        <= UNSIGNED_LESS_EQUAL,
                VECTOR_PROMOTE_LOW | VECTOR_DEMOTE => record.right == 0 && record.extra == 0,
                VECTOR_INSERT => valid_vector_lane(
                    wrapping_shr_u64(record.extra, VECTOR_LANE_INDEX_SHIFT),
                    record.extra & VECTOR_LANE_WIDTH_MASK
                ),
                VECTOR_EXTRACT => valid_vector_lane(record.right, record.extra),
                VECTOR_ANY_TRUE | VECTOR_ALL_TRUE | VECTOR_HIGH_BITS => {
                    record.right == 0 && valid_width(record.extra)
                },
                _ => record.extra == BYTE_BITS || record.extra == WORD_BITS,
            };
            if !valid {
                return Option::None;
            }
            frame.floating = true;
            frame.vectors = true;
            frame.xmm_aux = frame.xmm_aux
                || record.op == VECTOR_INTEGER_COMPARE
                || (record.op == VECTOR_PAIRWISE_ADD && record.extra == BYTE_BITS)
                || (record.op == VECTOR_SWIZZLE && record.extra == 0);
        }
        if is_conditional_trap(record.op) && (record.right != 0 || record.extra != 0) {
            return Option::None;
        }
        if record.op == STACK_POINTER {
            if record.left != 0 || record.right != 0 || record.extra != 0 {
                return Option::None;
            }
            if live {
                frame.promoted = 0;
                frame.used = true;
            }
        }
        if record.op == FLOAT_TO_INTEGER_TRUNC || is_float_to_integer(record.op) {
            let valid_width = if record.op == FLOAT_TO_INTEGER_TRUNC {
                record.extra == DWORD_BITS || record.extra == QWORD_BITS
            } else {
                valid_width(record.extra)
            };
            if (record.right != DWORD_BITS && record.right != QWORD_BITS) || !valid_width {
                return Option::None;
            }
            frame.floating = true;
        }
        if is_float_conversion(record.op) {
            let valid = match record.op {
                FLOAT_PROMOTE => record.right == DWORD_BITS && record.extra == QWORD_BITS,
                FLOAT_DEMOTE => record.right == QWORD_BITS && record.extra == DWORD_BITS,
                _ => valid_width(record.right)
                    && (record.extra == DWORD_BITS || record.extra == QWORD_BITS),
            };
            if !valid {
                return Option::None;
            }
            frame.floating = true;
        }
        if record.op >= FLOAT_CEIL && record.op <= FLOAT_MAX {
            if (record.extra != DWORD_BITS && record.extra != QWORD_BITS)
                || (!is_float_min_max(record.op) && record.right != 0)
            {
                return Option::None;
            }
            frame.floating = true;
        }
        if is_float_fma(record.op) {
            frame.floating = true;
            frame.xmm_aux = true;
        }
        let atomic = is_atomic_update(record.op);
        if cas || atomic_retry {
            frame.fixed = true;
            frame.temporary_registers = frame.temporary_registers
                | register_bit(RIGHT_SCRATCH)
                | register_bit(THIRD_SCRATCH);
        }
        if atomic {
            if !valid_width(record.extra) {
                return Option::None;
            }
            frame.fixed = frame.fixed || live || record.op == ATOMIC_EXCHANGE;
        }
        if record.op == BYTE_SWAP && (record.extra < WORD_BITS || !valid_width(record.extra)) {
            return Option::None;
        }
        if labeled {
            if record.op == BLOCK_LABEL {
                entry_end = block_end;
                block_end = value;
            } else if last >= block_end {
                // Every cross-block value must go through a frame home.
                return Option::None;
            }
        }
        if is_fixed_arithmetic(record.op) || is_checked_arithmetic(record.op) {
            if record.extra != DWORD_BITS && record.extra != QWORD_BITS {
                return Option::None;
            }
            if is_fixed_arithmetic(record.op) {
                frame.fixed = frame.fixed || live || is_integer_division(record.op);
            }
        }
        if is_checked_arithmetic(record.op)
            && (wrapping_add(index, 1) == count
                || read_record(in words, wrapping_add(index, 1)).op != OVERFLOW_FLAG)
        {
            return Option::None;
        }
        if record.op == OVERFLOW_FLAG
            && (index == 0
                || !is_checked_arithmetic(read_record(in words, wrapping_sub(index, 1)).op))
        {
            return Option::None;
        }
        let carry = consumes_carry(record.op);
        if carry {
            if index < CHECKED_ARITHMETIC_RECORDS
                || record.extra != wrapping_sub(value, 1)
                || read_record(in words, wrapping_sub(index, 1)).op != OVERFLOW_FLAG
            {
                return Option::None;
            }
            let low = read_record(in words, wrapping_sub(index, CHECKED_ARITHMETIC_RECORDS));
            let expected = if record.op == ADD_CARRY {
                UNSIGNED_ADD_OVERFLOW
            } else {
                UNSIGNED_SUB_OVERFLOW
            };
            if low.op != expected || low.extra != QWORD_BITS {
                return Option::None;
            }
        }
        if is_symbol(record.op)
            && (!allow_relocations
                || record.left > DISP32_MASK
                || record.right != 0
                || record.extra != 0)
        {
            return Option::None;
        }
        if record.op == CALL_HIGH
            && (index == 0 || read_record(in words, wrapping_sub(index, 1)).op != CALL_PAIR)
        {
            return Option::None;
        }
        if record.op == CALL_ARGUMENT {
            if pending_arguments == 0 || last != NEVER_READ {
                return Option::None;
            }
            pending_arguments = wrapping_sub(pending_arguments, 1);
            continue;
        }
        if is_stack_operation(record.op) {
            match stack_displacement(in frame, in record) {
                Option::Some(_) => {},
                Option::None => return Option::None,
            };
            // Validate even dead reloads. A private home read inside the
            // allocated frame has no effect once its result is unused.
            if live || !is_home_reload(in record, frame.home_slot) {
                track_home(inout frame, in record);
                frame.used = frame.used || record.op != STACK_ADDRESS || live;
            }
        }
        if record.op >= ADD && record.op <= SAR && !valid_width(record.extra) {
            return Option::None;
        }
        if (is_immediate_arithmetic(record.op)
            && (!valid_width(record.extra) || record.right > DISP32_MASK))
            || (is_immediate_comparison(record.op) && record.right > DISP32_MASK)
        {
            return Option::None;
        }
        if is_register_shift(record.op)
            && record.extra != DWORD_BITS
            && record.extra != QWORD_BITS
        {
            return Option::None;
        }
        if record.op >= TRUNCATE && record.op <= SIGN_EXTEND {
            if !valid_width(record.extra) || !valid_width(record.right) {
                return Option::None;
            }
            if (record.op == TRUNCATE && record.extra >= record.right)
                || (record.op != TRUNCATE && record.extra <= record.right)
            {
                return Option::None;
            }
        }
        if record.op == LOAD && (!valid_width(record.extra) || record.right > DISP32_MASK) {
            return Option::None;
        }
        let no_result = has_no_result(record.op);
        if (no_result && last != NEVER_READ)
            || (is_store(record.op) && record.extra > DISP32_MASK)
        {
            return Option::None;
        }
        let arm = arms.try_get(wrapping_sub(depth, 1))
            .unwrap_or(BranchArm { start: NO_VALUE, end: values });
        if record.op == EARLY_RETURN {
            if (record.left != TRAP_VALUE && (record.left == NO_VALUE) != (return_arity == 0))
                || record.extra < arguments
                || record.extra >= value
                || (depth != 0 && record.extra <= arm.start)
            {
                return Option::None;
            }
            let nested = BranchArm { start: record.extra, end: value };
            if depth == arms.len() {
                arms.push(nested);
            } else {
                let _ = arms.try_set(depth, nested);
            }
            depth = wrapping_add(depth, 1);
        } else if record.op == BRANCH_ZERO {
            if depth == 0 || arm.start != value {
                return Option::None;
            }
            depth = wrapping_sub(depth, 1);
        } else if depth != 0 && (value <= arm.start || last > arm.end) {
            // A definition in this arm cannot reach past its return.
            return Option::None;
        }
        if record.op == BLOCK_RETURN
            && record.left != TRAP_VALUE
            && (record.left == NO_VALUE) != (return_arity == 0)
        {
            return Option::None;
        }
        if is_call(record.op) || tail_call {
            has_calls = has_calls || !tail_call;
            let indirect = indirect_call(record.extra);
            let fp_arguments = record.extra & ~INDIRECT_CALL;
            let gp_arguments = wrapping_sub(record.right, fp_arguments);
            if (!indirect && !allow_relocations)
                || fp_arguments > XMM_ARGUMENTS
                || fp_arguments > record.right
                || gp_arguments > MAX_ARGUMENTS
                || (tail_call && (indirect || gp_arguments > ARGUMENTS))
                || record.right > index
                || (!indirect
                    && record.left >= LIBCALL_TARGET_BASE
                    && (record.op != CALL
                        || wrapping_sub(record.left, LIBCALL_TARGET_BASE) > MEMCPY_LIBCALL
                        || record.right != MEMORY_COPY_ARGUMENTS
                        || fp_arguments != 0))
            {
                return Option::None;
            }
            if record.op == CALL_PAIR
                && (wrapping_add(index, 1) == count
                    || read_record(in words, wrapping_add(index, 1)).op != CALL_HIGH)
            {
                return Option::None;
            }
            frame.floating = frame.floating || fp_arguments != 0;
            frame.indirect_calls = frame.indirect_calls || indirect;
            if gp_arguments > ARGUMENTS {
                let slots = wrapping_sub(gp_arguments, ARGUMENTS);
                // Keep the explicit slots aligned after the outgoing area.
                let bytes = align_up(wrapping_mul(slots, SPILL_SLOT_BYTES), STACK_ALIGNMENT);
                if bytes > frame.outgoing {
                    frame.outgoing = bytes;
                }
            }
            let start = wrapping_sub(index, record.right);
            let limit = wrapping_add(arguments, start);
            if indirect {
                if record.left >= limit || float_value(in words, arguments, record.left) {
                    return Option::None;
                }
                first_read_backwards(inout reads, record.left, value);
            }
            for i in 0..record.right {
                let argument = read_record(in words, wrapping_add(start, i));
                if argument.op != CALL_ARGUMENT
                    || argument.left >= limit
                    || float_value(in words, arguments, argument.left) != (i >= gp_arguments)
                    || vector_value(in words, arguments, argument.left)
                {
                    return Option::None;
                }
                first_read_backwards(inout reads, argument.left, value);
            }
            pending_arguments = record.right;
        }
        let has_left = reads_left(in record);
        let has_right = reads_right(in record, paired);
        let has_third = reads_third(record.op);
        if (has_left && record.left >= value)
            || (has_right && record.right >= value)
            || (has_third && record.extra >= value)
            || (is_comparison(record.op) && record.extra > UNSIGNED_LESS_EQUAL)
        {
            return Option::None;
        }
        if live
            || record.op == LOAD
            || record.op == FLOAT_LOAD
            || record.op == VECTOR_LOAD
            || record.op == STACK_LOAD
            || record.op == FLOAT_STACK_LOAD
            || atomic
            || cas
            || is_integer_division(record.op)
            || no_result
        {
            if has_left {
                first_read_backwards(inout reads, record.left, value);
            }
            if has_right {
                first_read_backwards(inout reads, record.right, value);
            }
            if has_third {
                first_read_backwards(inout reads, record.extra, value);
            }
        }
    }
    if depth != 0 {
        return Option::None;
    }
    if frame.promoted == 0 {
        frame.gp_homes = 0;
        frame.single_homes = 0;
        frame.double_homes = 0;
    } else {
        // Type-punning accesses use the actual frame bytes. XMM homes are
        // caller-saved, so calls keep all cross-block float homes in memory.
        let conflicts = (frame.gp_homes & (frame.single_homes | frame.double_homes))
            | (frame.single_homes & frame.double_homes);
        frame.gp_homes = frame.gp_homes & ~conflicts;
        frame.single_homes = if has_calls {
            0
        } else {
            frame.single_homes & ~conflicts
        };
        frame.double_homes = if has_calls {
            0
        } else {
            frame.double_homes & ~conflicts
        };
    }
    if labeled {
        for argument in 0..arguments {
            if last_read(in reads, argument) >= entry_end {
                return Option::None;
            }
        }
    }
    Option::Some(reads)
}

fn assigned(in locations: ChunkSeq[Location], value: u64) -> Location {
    match locations.try_get(value) {
        Option::Some(location) => location,
        Option::None => Location::Absent,
    }
}

fn without_register(used: u32, register: u8) -> u32 {
    used ^ (used & register_bit(register))
}

fn emits_instruction(in record: Record, result_live: bool, home_slot: u64) -> bool {
    let op = record.op;
    op != STACK_SLOT
        && op != RETURN_PAIR
        && op != CALL_ARGUMENT
        && op != FLOAT_RETURN
        && (result_live
            || op == LOAD
            || op == FLOAT_LOAD
            || op == VECTOR_LOAD
            || ((op == STACK_LOAD || op == FLOAT_STACK_LOAD)
                && !is_home_reload(in record, home_slot))
            || is_call(op)
            || is_atomic_update(op)
            || is_atomic_cas(op)
            || is_integer_division(op)
            || has_no_result(op))
}

fn compatible_register(reg: u8, floating: bool) -> u8 {
    if is_xmm(reg) == floating {
        reg
    } else {
        UNASSIGNED
    }
}

fn dying_register(
    in reads: ChunkSeq[u64],
    in locations: ChunkSeq[Location],
    operand: u64,
    current: u64
) -> u8 {
    if last_read(in reads, operand) != current {
        return UNASSIGNED;
    }
    match assigned(in locations, operand) {
        Location::Register(reg) => reg,
        _ => UNASSIGNED,
    }
}

// Scan in instruction order. Expire a register at its last use. If the
// register-only pass fills up, retry with three reload registers reserved
// and let spilled values with disjoint lifetimes share stack slots.
fn allocate(
    in words: Slice[u64],
    in reads: ChunkSeq[u64],
    arguments: u64,
    count: u64,
    in frame: FrameLayout,
    paired: bool,
    spills: bool
) -> Option[Allocation] {
    let mut locations = ChunkSeq::with_capacity[Location](wrapping_add(arguments, count));
    // Incoming stack arguments materialize through the same scratch bank
    // as allocator spills, even when every result fits in a register.
    let gp_reserved = if spills || arguments > ARGUMENTS {
        register_bit(LEFT_SCRATCH) | register_bit(RIGHT_SCRATCH) | register_bit(THIRD_SCRATCH)
    } else if frame.outgoing != 0 || frame.fixed || frame.floating || frame.indirect_calls {
        register_bit(THIRD_SCRATCH)
    } else {
        0
    };
    let mut reserved = if frame.floating {
        gp_reserved
            | frame.temporary_registers
            | register_bit(XMM_LEFT_SCRATCH)
            | register_bit(XMM_RIGHT_SCRATCH)
    } else {
        gp_reserved | frame.temporary_registers
    };
    if frame.xmm_aux {
        reserved = reserved | register_bit(XMM_AUX_SCRATCH);
    }
    let mut callee_save_mask: u32 = 0;
    let mut callee_save_slots: u64 = 0;
    let xmm_homes = frame.single_homes | frame.double_homes;
    for home in 0..frame.promoted {
        let bit = register_bit(wrapping_u8(home));
        if (frame.gp_homes & bit) != 0 {
            callee_save_mask = callee_save_mask | register_bit(home_register(home));
            callee_save_slots = wrapping_add(callee_save_slots, 1);
        }
        if (xmm_homes & bit) != 0 {
            reserved = reserved | register_bit(xmm_home_register(home));
        }
    }
    let mut used = reserved | callee_save_mask;
    let callee_saved = callee_saved_registers();
    let register_codes = if frame.floating {
        ALL_REGISTER_CODES
    } else {
        REGISTER_CODES
    };
    let spill_base = wrapping_add(frame.outgoing, if frame.used { frame.size } else { 0 });
    let slot_bytes = if frame.vectors {
        VECTOR_SLOT_BYTES
    } else {
        SPILL_SLOT_BYTES
    };
    let mut spill_ends = ChunkSeq::new[u64]();
    let mut saved_masks = ChunkSeq::new[u32]();
    let mut save_slots: u64 = 0;
    let mut has_calls = false;
    for argument in 0..arguments {
        if argument < ARGUMENTS {
            let reg = arg_register(argument);
            locations.push(Location::Register(reg));
            if last_read(in reads, argument) != NEVER_READ {
                used = used | register_bit(reg);
            }
        } else {
            // Resolve the incoming stack offsets once the frame size is known.
            locations.push(Location::Absent);
        }
    }

    for index in 0..count {
        let value = wrapping_add(arguments, index);
        let record = read_record(in words, index);
        let end = last_read(in reads, value);
        let result_live = end != NEVER_READ;
        if !emits_instruction(
            in record,
            result_live || live_overflow_flag(in reads, value, record.op),
            frame.home_slot
        ) {
            locations.push(Location::Absent);
            continue;
        }
        let call = is_call(record.op);
        let fixed = uses_fixed_registers(record.op);
        let atomic = is_atomic_rmw(record.op);
        if call {
            has_calls = true;
            if indirect_call(record.extra) {
                used = without_register(
                    used,
                    dying_register(in reads, in locations, record.left, value)
                );
            }
            let start = wrapping_sub(index, record.right);
            for i in 0..record.right {
                let operand = call_argument(in words, start, i);
                used = without_register(
                    used,
                    dying_register(in reads, in locations, operand, value)
                );
            }
        }
        let left = if reads_left(in record) {
            dying_register(in reads, in locations, record.left, value)
        } else {
            UNASSIGNED
        };
        let right = if reads_right(in record, paired) {
            dying_register(in reads, in locations, record.right, value)
        } else {
            UNASSIGNED
        };
        let third = if reads_third(record.op) {
            dying_register(in reads, in locations, record.extra, value)
        } else {
            UNASSIGNED
        };
        let survivors = without_register(
            without_register(without_register(used, left), right),
            third
        );
        if call || fixed {
            let clobbers = if call {
                ~callee_saved
            } else if is_atomic_cas(record.op) {
                register_bit(RAX)
            } else {
                register_bit(RAX) | register_bit(RDX)
            };
            let saved = survivors & clobbers & ~reserved;
            let mut slots: u64 = 0;
            for reg in 0..register_codes {
                if (saved & register_bit(wrapping_u8(reg))) != 0 {
                    slots = wrapping_add(slots, 1);
                }
            }
            if slots > save_slots {
                save_slots = slots;
            }
            saved_masks.push(saved);
        }
        let implicit_result = if record.op == CALL_FLOAT {
            XMM0
        } else {
            fixed_result(record.op)
        };
        let floating = is_float_result(record.op);
        let left = compatible_register(left, floating);
        let right = compatible_register(right, floating);
        let third = compatible_register(third, floating);
        let register = if record.op == FLOAT_ARGUMENT {
            wrapping_add(XMM0, wrapping_u8(record.left))
        } else if atomic && (used & register_bit(RAX)) == 0 {
            RAX
        } else if atomic && right != UNASSIGNED && right != left {
            right
        } else if (fixed || record.op == CALL_FLOAT)
            && (survivors & register_bit(implicit_result)) == 0
        {
            implicit_result
        } else if (record.op == SELECT || record.op == FLOAT_SELECT || is_float_min_max(record.op))
            && right != UNASSIGNED
        {
            right
        } else if is_float_fma(record.op) && left != UNASSIGNED {
            left
        } else if third != UNASSIGNED {
            third
        } else if left != UNASSIGNED {
            left
        } else if right != UNASSIGNED && can_reuse_right(record.op) {
            right
        } else if floating {
            find_float_register(used)
        } else {
            find_register(used)
        };
        if record.op == CONSTANT {
            let next = wrapping_add(index, 1);
            let fold_store = if next < count && end == wrapping_add(value, 1) {
                let consumer = read_record(in words, next);
                immediate_store_consumer(in consumer, value, record.left)
            } else {
                false
            };
            if fold_store || (register == UNASSIGNED && spills && cheap_immediate(record.left)) {
                // Avoid a temporary when the next instruction can encode the value.
                locations.push(Location::Rematerialized(record.left));
                used = survivors;
                continue;
            }
        }
        // The retry uses unused nonvolatile GPRs before spilling. Save
        // each register once in the prologue, including any CFG homes.
        let register = if register == UNASSIGNED && spills && !floating && result_live {
            find_callee_saved_register(used)
        } else {
            register
        };
        used = survivors;
        let location = if has_no_result(record.op) || ((call || fixed || atomic) && !result_live) {
            Location::Absent
        } else if register != UNASSIGNED {
            if result_live {
                let bit = register_bit(register);
                used = used | bit;
                if (callee_saved & bit) != 0 && (callee_save_mask & bit) == 0 {
                    callee_save_mask = callee_save_mask | bit;
                    callee_save_slots = wrapping_add(callee_save_slots, 1);
                }
            }
            Location::Register(register)
        } else if !spills {
            return Option::None;
        } else if !result_live {
            // A retained load can finish in a scratch register.
            Location::Register(
                if floating {
                    XMM_LEFT_SCRATCH
                } else {
                    LEFT_SCRATCH
                }
            )
        } else {
            let mut slot = spill_ends.len();
            for candidate in 0..spill_ends.len() {
                if spill_ends.try_get(candidate).unwrap_or(NEVER_READ) < value {
                    slot = candidate;
                    break;
                }
            }
            let offset = wrapping_add(spill_base, wrapping_mul(slot, slot_bytes));
            if slot == spill_ends.len() {
                if aligned_frame_size(wrapping_add(offset, slot_bytes)) > STACK_PROBE_INTERVAL {
                    return Option::None;
                }
                spill_ends.push(end);
            } else {
                let _ = spill_ends.try_set(slot, end);
            }
            Location::Spill(wrapping_u32(offset))
        };
        locations.push(location);
    }
    let mut stack_end = wrapping_add(spill_base, wrapping_mul(spill_ends.len(), slot_bytes));
    let save_bytes = wrapping_mul(save_slots, slot_bytes);
    let callee_save_bytes = wrapping_mul(callee_save_slots, SPILL_SLOT_BYTES);
    let mut local_frame = frame.outgoing;
    let mut save_frame = stack_end;
    let mut callee_save_frame = wrapping_add(stack_end, save_bytes);
    if save_slots != 0
        && !fits_signed_byte(wrapping_u32(save_frame))
        && fits_signed_byte(wrapping_u32(frame.outgoing))
    {
        // Save slots are reused at each call. Keep them in short reach of RSP
        // when large locals would otherwise require wider displacements.
        let shifted_local_frame = align_up(
            wrapping_add(frame.outgoing, save_bytes),
            STACK_ALIGNMENT
        );
        let shift = wrapping_sub(shifted_local_frame, frame.outgoing);
        let shifted_callee_save = wrapping_add(stack_end, shift);
        if aligned_frame_size(wrapping_add(shifted_callee_save, callee_save_bytes))
            <= STACK_PROBE_INTERVAL
        {
            local_frame = shifted_local_frame;
            save_frame = frame.outgoing;
            callee_save_frame = shifted_callee_save;
            if spills {
                for value in arguments..wrapping_add(arguments, count) {
                    match assigned(in locations, value) {
                        Location::Spill(offset) => {
                            let shifted = wrapping_u32(wrapping_add(widen_u64(offset), shift));
                            let _ = locations.try_set(value, Location::Spill(shifted));
                        },
                        _ => {},
                    };
                }
            }
        }
    }
    stack_end = wrapping_add(callee_save_frame, callee_save_bytes);
    let size = if stack_end == 0 && !has_calls {
        0
    } else {
        aligned_frame_size(stack_end)
    };
    if size > STACK_PROBE_INTERVAL {
        return Option::None;
    }
    for argument in ARGUMENTS..arguments {
        let slot = wrapping_sub(argument, ARGUMENTS);
        // The caller's first stack argument follows our return address.
        let offset = wrapping_add(
            wrapping_add(size, RETURN_ADDRESS_BYTES),
            wrapping_mul(slot, SPILL_SLOT_BYTES)
        );
        let _ = locations.try_set(argument, Location::Spill(wrapping_u32(offset)));
    }
    Option::Some(Allocation {
        locations: locations,
        frame_size: wrapping_u32(size),
        saved_masks: saved_masks,
        local_frame: local_frame,
        save_frame: save_frame,
        callee_save_frame: callee_save_frame,
        callee_save_mask: callee_save_mask
    })
}

fn materialize(inout output: ChunkSeq[u8], in location: Location, scratch: u8) -> u8 {
    materialize_width(inout output, in location, scratch, QWORD_BITS)
}

fn materialize_width(
    inout output: ChunkSeq[u8],
    in location: Location,
    scratch: u8,
    width: u64
) -> u8 {
    match location {
        Location::Register(reg) => reg,
        Location::Spill(offset) => {
            emit(inout output, in Instruction::Load(scratch, RSP, offset, width));
            scratch
        },
        Location::Rematerialized(bits) => {
            // A reload may happen between instructions that share condition flags.
            move_constant(inout output, scratch, bits);
            scratch
        },
        Location::Absent => UNASSIGNED,
    }
}

fn emit_store_value(
    inout output: ChunkSeq[u8],
    in source: Location,
    base: u8,
    displacement: u32,
    width: u64,
    scratch: u8
) {
    match source {
        Location::Rematerialized(bits) => {
            if store_immediate_fits(bits, width) {
                store_immediate(inout output, base, displacement, bits, width);
                return;
            }
        },
        _ => (),
    };
    let source = materialize_width(
        inout output,
        in source,
        scratch,
        if width == VECTOR_BITS {
            VECTOR_BITS
        } else {
            QWORD_BITS
        }
    );
    emit(inout output, in Instruction::Store(source, base, displacement, width));
}

fn operation(in record: Record, destination: u8, source: u8) -> Instruction {
    let width = record.extra;
    let count = wrapping_u8(record.right & wrapping_sub(width, 1));
    match record.op {
        ADD
            | UNSIGNED_ADD_OVERFLOW
            | SIGNED_ADD_OVERFLOW => Instruction::Binary(ADD_RM_R64, destination, source, width),
        SUB
            | UNSIGNED_SUB_OVERFLOW
            | SIGNED_SUB_OVERFLOW => Instruction::Binary(SUB_RM_R64, destination, source, width),
        ADD_CARRY => Instruction::Binary(ADC_RM_R64, destination, source, QWORD_BITS),
        SUB_BORROW => Instruction::Binary(SBB_RM_R64, destination, source, QWORD_BITS),
        MUL => Instruction::Multiply(destination, source, width),
        BYTE_SWAP => Instruction::ByteSwap(destination, width),
        AND => Instruction::Binary(AND_RM_R64, destination, source, width),
        OR => Instruction::Binary(OR_RM_R64, destination, source, width),
        XOR => Instruction::Binary(XOR_RM_R64, destination, source, width),
        NEG => Instruction::Unary(NEG_EXTENSION, destination, width),
        NOT => Instruction::Unary(NOT_EXTENSION, destination, width),
        SHL => Instruction::Shift(SHL_EXTENSION, destination, count, width),
        SHR => Instruction::Shift(SHR_EXTENSION, destination, count, width),
        SHL_REGISTER => Instruction::ShiftRegister(SHL_EXTENSION, destination, source, width),
        SHR_REGISTER => Instruction::ShiftRegister(SHR_EXTENSION, destination, source, width),
        SAR_REGISTER => Instruction::ShiftRegister(SAR_EXTENSION, destination, source, width),
        _ => Instruction::Shift(SAR_EXTENSION, destination, count, width),
    }
}

fn emit_immediate_arithmetic(
    inout output: ChunkSeq[u8],
    in record: Record,
    destination: u8,
    source: u8
) {
    let bits = wrapping_u32(record.right);
    let width = record.extra;
    if record.op == MUL_IMMEDIATE {
        emit(inout output, in Instruction::MultiplyImmediate(destination, source, bits, width));
    } else {
        let extension = match record.op {
            ADD_IMMEDIATE => ALU_ADD_EXTENSION,
            SUB_IMMEDIATE => ALU_SUB_EXTENSION,
            AND_IMMEDIATE => ALU_AND_EXTENSION,
            OR_IMMEDIATE => ALU_OR_EXTENSION,
            _ => ALU_XOR_EXTENSION,
        };
        emit(inout output, in Instruction::Move(destination, source));
        emit(inout output, in Instruction::BinaryImmediate(extension, destination, bits, width));
    }
}

fn in_register(in location: Location, expected: u8) -> bool {
    match location {
        Location::Register(reg) => reg == expected,
        _ => false,
    }
}

fn move_return(inout output: ChunkSeq[u8], in location: Location, destination: u8) {
    let source = materialize(inout output, in location, destination);
    if source != UNASSIGNED {
        emit(inout output, in Instruction::Move(destination, source));
    }
}

fn emit_return(
    inout output: ChunkSeq[u8],
    in low: Location,
    in high: Location,
    in allocation: Allocation,
    floating: bool
) {
    // Treat the ABI return registers as a parallel copy. Moving the high
    // result first preserves RAX when it holds that result.
    if floating {
        move_return(inout output, in low, XMM0);
    } else if in_register(in high, RAX) {
        if in_register(in low, RDX) {
            emit(inout output, in Instruction::Exchange(RAX, RDX));
        } else {
            move_return(inout output, in high, RDX);
            move_return(inout output, in low, RAX);
        }
    } else {
        move_return(inout output, in low, RAX);
        move_return(inout output, in high, RDX);
    }
    emit_frame_leave(inout output, in allocation);
    emit(inout output, in Instruction::Return);
}

fn emit_frame_leave(inout output: ChunkSeq[u8], in allocation: Allocation) {
    preserve_registers(
        inout output,
        allocation.callee_save_mask,
        allocation.callee_save_frame,
        SPILL_SLOT_BYTES,
        true
    );
    emit(inout output, in Instruction::FrameLeave(allocation.frame_size));
}

fn call_register(index: u64, floating: bool) -> u8 {
    if floating {
        wrapping_add(XMM0, wrapping_u8(index))
    } else {
        arg_register(index)
    }
}

fn move_call_arguments(
    inout out: ChunkSeq[u8],
    in words: Slice[u64],
    in locations: ChunkSeq[Location],
    start: u64,
    arguments: u64,
    floating: bool
) {
    let mut homes = ChunkSeq::with_capacity[Location](arguments);
    for i in 0..arguments {
        let home = assigned(in locations, call_argument(in words, start, i));
        homes.push(
            if in_register(in home, call_register(i, floating)) {
                Location::Absent
            } else {
                home
            }
        );
    }
    for round in 0..arguments {
        let mut needed: u32 = 0;
        let mut first = arguments;
        for i in 0..arguments {
            match assigned(in homes, i) {
                Location::Absent => continue,
                Location::Register(reg) => {
                    needed = needed | register_bit(reg);
                },
                Location::Spill(_) | Location::Rematerialized(_) => {},
            };
            if first == arguments {
                first = i;
            }
        }
        if first == arguments {
            break;
        }
        let mut ready = arguments;
        for i in first..arguments {
            let home = assigned(in homes, i);
            match home {
                Location::Absent => continue,
                _ => {},
            };
            let destination = call_register(i, floating);
            if in_register(in home, destination) || (needed & register_bit(destination)) == 0 {
                ready = i;
                break;
            }
        }
        if ready < arguments {
            let home = assigned(in homes, ready);
            move_return(inout out, in home, call_register(ready, floating));
            let _ = homes.try_set(ready, Location::Absent);
        } else {
            // Every pending destination is still needed, so these moves
            // form register cycles. Preserve the displaced destination.
            let destination = call_register(first, floating);
            let source = match assigned(in homes, first) {
                Location::Register(reg) => reg,
                _ => return,
            };
            let displaced = if floating {
                emit(inout out, in Instruction::Move(XMM_RIGHT_SCRATCH, destination));
                emit(inout out, in Instruction::Move(destination, source));
                XMM_RIGHT_SCRATCH
            } else {
                emit(inout out, in Instruction::Exchange(destination, source));
                source
            };
            let _ = homes.try_set(first, Location::Absent);
            for i in wrapping_add(first, 1)..arguments {
                let home = assigned(in homes, i);
                if !floating && in_register(in home, source) {
                    let _ = homes.try_set(i, Location::Register(destination));
                } else if in_register(in home, destination) {
                    let _ = homes.try_set(i, Location::Register(displaced));
                }
            }
        }
    }
}

fn emit_tail_call(
    inout output: ChunkSeq[u8],
    in words: Slice[u64],
    in allocation: Allocation,
    in record: Record,
    index: u64,
    inout relocations: ChunkSeq[u64]
) {
    let start = wrapping_sub(index, record.right);
    let gp = wrapping_sub(record.right, record.extra);
    move_call_arguments(inout output, in words, in allocation.locations, start, gp, false);
    move_call_arguments(
        inout output,
        in words,
        in allocation.locations,
        wrapping_add(start, gp),
        record.extra,
        true
    );
    emit_frame_leave(inout output, in allocation);
    let offset = emit_direct_jump(inout output);
    relocations.push(offset);
    relocations.push(PLT_CALL);
    relocations.push(record.left);
}

fn save_result(inout out: ChunkSeq[u8], in result: Location, source: u8) {
    match result {
        Location::Register(reg) => emit(inout out, in Instruction::Move(reg, source)),
        Location::Spill(offset) => emit(
            inout out,
            in Instruction::Store(source, RSP, offset, QWORD_BITS)
        ),
        Location::Absent | Location::Rematerialized(_) => {},
    };
}

fn emit_atomic(
    inout output: ChunkSeq[u8],
    in record: Record,
    in result: Location,
    base: u8,
    input: u8,
    live: bool
) {
    let width = record.extra;
    if !live && record.op != ATOMIC_EXCHANGE {
        let op = if record.op == ATOMIC_ADD {
            AtomicMemory::Add
        } else {
            AtomicMemory::Subtract
        };
        emit(inout output, in Instruction::Atomic(op, input, base, width));
        return;
    }
    let register = match result {
        Location::Register(register) => if register != base {
            register
        } else {
            THIRD_SCRATCH
        },
        _ => THIRD_SCRATCH,
    };
    emit(inout output, in Instruction::Move(register, input));
    if record.op == ATOMIC_SUB {
        emit(inout output, in Instruction::Unary(NEG_EXTENSION, register, width));
    }
    let op = if record.op == ATOMIC_EXCHANGE {
        AtomicMemory::Exchange
    } else {
        AtomicMemory::FetchAdd
    };
    emit(inout output, in Instruction::Atomic(op, register, base, width));
    if live {
        if width < DWORD_BITS {
            emit(inout output, in Instruction::Truncate(register, register, width));
        }
        save_result(inout output, in result, register);
    }
}

fn preserve_registers(
    inout out: ChunkSeq[u8],
    saved: u32,
    frame: u64,
    slot_bytes: u64,
    restoring: bool
) {
    if saved == 0 {
        return;
    }
    let mut slot = frame;
    let register_codes = if saved >= register_bit(XMM0) {
        ALL_REGISTER_CODES
    } else {
        REGISTER_CODES
    };
    for code in 0..register_codes {
        let reg = wrapping_u8(code);
        if (saved & register_bit(reg)) != 0 {
            let offset = wrapping_u32(slot);
            let width = if slot_bytes == VECTOR_SLOT_BYTES && is_xmm(reg) {
                VECTOR_BITS
            } else {
                QWORD_BITS
            };
            let instruction = if restoring {
                Instruction::Load(reg, RSP, offset, width)
            } else {
                Instruction::Store(reg, RSP, offset, width)
            };
            emit(inout out, in instruction);
            slot = wrapping_add(slot, slot_bytes);
        }
    }
}

fn emit_fixed_arithmetic(
    inout out: ChunkSeq[u8],
    in allocation: Allocation,
    in record: Record,
    in result: Location
) {
    let left = assigned(in allocation.locations, record.left);
    let right = assigned(in allocation.locations, record.right);
    let mut rhs = materialize(inout out, in right, THIRD_SCRATCH);
    if rhs == RAX || rhs == RDX {
        emit(inout out, in Instruction::Move(THIRD_SCRATCH, rhs));
        rhs = THIRD_SCRATCH;
    }
    move_return(inout out, in left, RAX);
    let op = match record.op {
        SIGNED_DIV => FixedArithmetic::SignedDivide,
        UNSIGNED_DIV => FixedArithmetic::UnsignedDivide,
        SIGNED_REM => FixedArithmetic::SignedRemainder,
        UNSIGNED_REM => FixedArithmetic::UnsignedRemainder,
        SIGNED_MUL_HIGH | SIGNED_MUL_OVERFLOW => FixedArithmetic::SignedMultiplyHigh,
        _ => FixedArithmetic::UnsignedMultiplyHigh,
    };
    emit(inout out, in Instruction::Fixed(op, rhs, record.extra));
    save_result(inout out, in result, fixed_result(record.op));
}

fn emit_atomic_cas(
    inout out: ChunkSeq[u8],
    in allocation: Allocation,
    in record: Record,
    in result: Location
) {
    let address = assigned(in allocation.locations, record.left);
    let new_value = assigned(in allocation.locations, record.extra);
    let expected = assigned(in allocation.locations, record.right);
    let mut base = materialize(inout out, in address, THIRD_SCRATCH);
    if base == RAX {
        emit(inout out, in Instruction::Move(THIRD_SCRATCH, base));
        base = THIRD_SCRATCH;
    }
    let mut replacement = materialize(inout out, in new_value, RIGHT_SCRATCH);
    if replacement == RAX {
        emit(inout out, in Instruction::Move(RIGHT_SCRATCH, replacement));
        replacement = RIGHT_SCRATCH;
    }
    move_return(inout out, in expected, RAX);
    let width = wrapping_shl_u64(BYTE_BITS, wrapping_u32(wrapping_sub(record.op, ATOMIC_CAS_BYTE)));
    emit(
        inout out,
        in Instruction::Atomic(AtomicMemory::CompareExchange, replacement, base, width)
    );
    if width < DWORD_BITS {
        emit(inout out, in Instruction::Truncate(RAX, RAX, width));
    }
    save_result(inout out, in result, RAX);
}

fn emit_atomic_update(
    inout out: ChunkSeq[u8],
    in allocation: Allocation,
    in record: Record,
    in result: Location
) {
    let address = assigned(in allocation.locations, record.left);
    let input = assigned(in allocation.locations, record.right);
    let mut base = materialize(inout out, in address, THIRD_SCRATCH);
    if base == RAX || base == RDX {
        emit(inout out, in Instruction::Move(THIRD_SCRATCH, base));
        base = THIRD_SCRATCH;
    }
    move_return(inout out, in input, RDX);
    let op = match record.op {
        ATOMIC_AND => AtomicUpdate::Bitwise(AND_RM_R64, false),
        ATOMIC_NAND => AtomicUpdate::Bitwise(AND_RM_R64, true),
        ATOMIC_OR => AtomicUpdate::Bitwise(OR_RM_R64, false),
        ATOMIC_XOR => AtomicUpdate::Bitwise(XOR_RM_R64, false),
        ATOMIC_UNSIGNED_MIN => AtomicUpdate::MinMax(CC_A),
        ATOMIC_UNSIGNED_MAX => AtomicUpdate::MinMax(CC_B),
        ATOMIC_SIGNED_MIN => AtomicUpdate::MinMax(CC_G),
        _ => AtomicUpdate::MinMax(CC_L),
    };
    emit(inout out, in Instruction::AtomicUpdate(op, base, record.extra));
    save_result(inout out, in result, RAX);
}

fn emit_call(
    inout out: ChunkSeq[u8],
    in words: Slice[u64],
    in allocation: Allocation,
    start: u64,
    in record: Record,
    in low: Location,
    in high: Location
) -> Option[u64] {
    let indirect = indirect_call(record.extra);
    let fp_arguments = record.extra & ~INDIRECT_CALL;
    let arguments = wrapping_sub(record.right, fp_arguments);
    let register_arguments = if arguments > ARGUMENTS {
        ARGUMENTS
    } else {
        arguments
    };
    // Stack arguments start at the current RSP before the call. Copy them
    // before the register moves can overwrite one of their sources.
    for i in register_arguments..arguments {
        let home = assigned(in allocation.locations, call_argument(in words, start, i));
        let register = materialize(inout out, in home, THIRD_SCRATCH);
        let offset = wrapping_mul(wrapping_sub(i, register_arguments), SPILL_SLOT_BYTES);
        emit(inout out, in Instruction::Store(register, RSP, wrapping_u32(offset), QWORD_BITS));
    }
    let mut target = UNASSIGNED;
    if indirect {
        let home = assigned(in allocation.locations, record.left);
        target = materialize(inout out, in home, THIRD_SCRATCH);
        // Stack argument copies are finished, so the GP shuffle can keep the
        // target in R11 when it would overwrite the original register.
        for i in 0..register_arguments {
            if arg_register(i) == target {
                let input = assigned(in allocation.locations, call_argument(in words, start, i));
                if !in_register(in input, target) {
                    emit(inout out, in Instruction::Move(THIRD_SCRATCH, target));
                    target = THIRD_SCRATCH;
                }
                break;
            }
        }
    }
    if register_arguments != 0 {
        move_call_arguments(
            inout out,
            in words,
            in allocation.locations,
            start,
            register_arguments,
            false
        );
    }
    if fp_arguments != 0 {
        let float_start = wrapping_add(start, arguments);
        move_call_arguments(
            inout out,
            in words,
            in allocation.locations,
            float_start,
            fp_arguments,
            true
        );
    }
    let reference = if indirect {
        emit_indirect_call(inout out, target);
        Option::None
    } else {
        Option::Some(emit_direct_call(inout out))
    };
    // Copy both return registers before restoring the live caller registers.
    if record.op == CALL_FLOAT {
        save_result(inout out, in low, XMM0);
    } else if in_register(in low, RDX) {
        if in_register(in high, RAX) {
            emit(inout out, in Instruction::Exchange(RAX, RDX));
        } else {
            save_result(inout out, in high, RDX);
            save_result(inout out, in low, RAX);
        }
    } else {
        save_result(inout out, in low, RAX);
        save_result(inout out, in high, RDX);
    }
    reference
}

pub fn encode_block(
    in words: Slice[u64],
    allow_relocations: bool,
    inout relocations: ChunkSeq[u64]
) -> ChunkSeq[u8] {
    encode_block_pass(in words, allow_relocations, inout relocations, true)
}

fn emit_vector_instruction(
    inout output: ChunkSeq[u8],
    in record: Record,
    destination: u8,
    left: u8,
    right: u8
) {
    let instruction = match record.op {
        VECTOR_CONSTANT => Instruction::VectorConstant(destination, record.left, record.right),
        VECTOR_SPLAT => Instruction::VectorSplat(destination, left, record.extra),
        VECTOR_LOAD => Instruction::Load(
            destination,
            left,
            wrapping_u32(record.right),
            VECTOR_BITS
        ),
        VECTOR_PROMOTE_LOW
            | VECTOR_DEMOTE => Instruction::VectorConvert(
                destination,
                left,
                record.op == VECTOR_DEMOTE
            ),
        VECTOR_PAIRWISE_ADD => Instruction::VectorPairwiseAdd(
            destination,
            left,
            right,
            record.extra
        ),
        VECTOR_SWIZZLE => Instruction::VectorSwizzle(
            destination,
            left,
            right,
            record.extra == X86_SWIZZLE_ZERO_HIGH
        ),
        VECTOR_INTEGER_COMPARE => {
            let condition = wrapping_shr_u64(record.extra, VECTOR_CONDITION_SHIFT);
            let reverse = condition == SIGNED_LESS
                || condition == UNSIGNED_LESS
                || condition == SIGNED_GREATER_EQUAL
                || condition == UNSIGNED_GREATER_EQUAL;
            let invert = condition == NOT_EQUAL
                || condition == SIGNED_GREATER_EQUAL
                || condition == SIGNED_LESS_EQUAL
                || condition == UNSIGNED_GREATER_EQUAL
                || condition == UNSIGNED_LESS_EQUAL;
            let relation = if condition <= NOT_EQUAL {
                PackedRelation::Equal
            } else if condition < UNSIGNED_LESS {
                PackedRelation::SignedGreater
            } else {
                PackedRelation::UnsignedGreater
            };
            let (a, b) = if reverse {
                (right, left)
            } else {
                (left, right)
            };
            Instruction::VectorIntegerCompare(
                destination,
                a,
                b,
                record.extra & VECTOR_LANE_WIDTH_MASK,
                relation,
                invert
            )
        },
        VECTOR_INSERT => {
            let lane = wrapping_shr_u64(record.extra, VECTOR_LANE_INDEX_SHIFT);
            let width = record.extra & VECTOR_LANE_WIDTH_MASK;
            emit(inout output, in Instruction::Move(destination, left));
            Instruction::VectorInsert(destination, right, lane, width)
        },
        VECTOR_EXTRACT => Instruction::VectorExtract(destination, left, record.right, record.extra),
        VECTOR_HIGH_BITS => Instruction::VectorHighBits(destination, left, record.extra),
        VECTOR_ANY_TRUE
            | VECTOR_ALL_TRUE => Instruction::VectorTruth(
                destination,
                left,
                record.op == VECTOR_ALL_TRUE,
                record.extra
            ),
        _ => {
            let (first, second) = if destination == right && can_reuse_right(record.op) {
                (right, left)
            } else {
                (left, right)
            };
            emit(inout output, in Instruction::Move(destination, first));
            Instruction::VectorBinary(
                vector_binary_opcode(record.op, record.extra),
                destination,
                second
            )
        },
    };
    emit(inout output, in instruction);
}

fn emit_bit_operation(inout output: ChunkSeq[u8], in record: Record, destination: u8, source: u8) {
    let op = match record.op {
        LEADING_ZEROS => BitOperation::LeadingZeros,
        TRAILING_ZEROS => BitOperation::TrailingZeros,
        REVERSE_BITS => BitOperation::Reverse,
        LEADING_SIGN_BITS => BitOperation::LeadingSignBits,
        ABS => BitOperation::Absolute,
        _ => if record.right == X86_HARDWARE_POPCOUNT {
            BitOperation::HardwarePopulationCount
        } else {
            BitOperation::PopulationCount
        },
    };
    emit(inout output, in Instruction::BitOperation(destination, source, record.extra, op));
}

fn emit_bit_mix(
    inout output: ChunkSeq[u8],
    in record: Record,
    destination: u8,
    left: u8,
    right: u8
) {
    emit(inout output, in Instruction::Move(destination, left));
    let width = record.extra;
    let instruction = match record.op {
        ROTATE_RIGHT => {
            let amount = record.right & wrapping_sub(width, 1);
            if amount == 0 {
                return;
            }
            Instruction::Shift(ROR_EXTENSION, destination, wrapping_u8(amount), width)
        },
        ROTATE_RIGHT_REGISTER => Instruction::ShiftRegister(
            ROR_EXTENSION,
            destination,
            right,
            width
        ),
        ROTATE_LEFT_REGISTER => Instruction::ShiftRegister(
            ROL_EXTENSION,
            destination,
            right,
            width
        ),
        FUNNEL_RIGHT => Instruction::FunnelRight(destination, right, wrapping_u8(record.extra)),
        AND_NOT => Instruction::ComplementedBitwise(AND_RM_R64, destination, right, width),
        OR_NOT => Instruction::ComplementedBitwise(OR_RM_R64, destination, right, width),
        _ => Instruction::ComplementedBitwise(XOR_RM_R64, destination, right, width),
    };
    emit(inout output, in instruction);
}

fn is_scalar_fp_instruction(op: u64) -> bool {
    (op >= FLOAT_CONSTANT && op <= FLOAT_COMPARE64)
        || op == FLOAT_COPY_SIGN
        || op == BITS_TO_FLOAT
        || op == FLOAT_TO_BITS
        || op == FLOAT_TO_INTEGER_TRUNC
        || is_float_to_integer(op)
        || is_float_conversion(op)
        || (op >= FLOAT_CEIL && op <= FLOAT_FMA64)
}

fn emit_scalar_fp(
    inout output: ChunkSeq[u8],
    in record: Record,
    destination: u8,
    left: u8,
    right: u8,
    third: u8
) {
    let width = record.extra;
    let instruction = match record.op {
        FLOAT_CONSTANT => Instruction::FloatImmediate(destination, record.left, width),
        FLOAT_PROMOTE | FLOAT_DEMOTE => Instruction::FloatConvert(destination, left, record.right),
        SIGNED_TO_FLOAT
            | UNSIGNED_TO_FLOAT => Instruction::IntegerToFloat(
                destination,
                left,
                record.right,
                width,
                record.op == SIGNED_TO_FLOAT
            ),
        FLOAT_COMPARE32
            | FLOAT_COMPARE64 => Instruction::FloatCompare(
                destination,
                left,
                right,
                record.extra,
                if record.op == FLOAT_COMPARE32 {
                    DWORD_BITS
                } else {
                    QWORD_BITS
                }
            ),
        FLOAT_COPY_SIGN => {
            emit(inout output, in Instruction::Move(destination, left));
            Instruction::FloatCopySign(destination, right, width)
        },
        FLOAT_MIN
            | FLOAT_MAX => Instruction::FloatMinMax(
                destination,
                left,
                right,
                record.op == FLOAT_MIN,
                width
            ),
        FLOAT_FMA32
            | FLOAT_FMA64 => Instruction::FloatFma(
                destination,
                left,
                right,
                third,
                if record.op == FLOAT_FMA64 {
                    QWORD_BITS
                } else {
                    DWORD_BITS
                }
            ),
        FLOAT_CEIL | FLOAT_FLOOR | FLOAT_TRUNC | FLOAT_NEAREST => {
            let mode = match record.op {
                FLOAT_CEIL => Rounding::Ceil,
                FLOAT_FLOOR => Rounding::Floor,
                FLOAT_TRUNC => Rounding::Trunc,
                _ => Rounding::Nearest,
            };
            Instruction::FloatRound(destination, left, mode, width)
        },
        FLOAT_SQRT => Instruction::FloatBinary(SSE_SQRT, destination, left, width),
        FLOAT_NEG | FLOAT_ABS => {
            emit(inout output, in Instruction::Move(destination, left));
            Instruction::FloatSign(destination, record.op == FLOAT_ABS, width)
        },
        BITS_TO_FLOAT | FLOAT_TO_BITS => Instruction::FloatBits(destination, left, width),
        FLOAT_TO_INTEGER_TRUNC => Instruction::FloatToInteger(
            destination,
            left,
            record.right,
            width
        ),
        FLOAT_TO_SIGNED_SAT
            | FLOAT_TO_UNSIGNED_SAT => Instruction::FloatToIntegerSat(
                destination,
                left,
                record.right,
                width,
                record.op == FLOAT_TO_SIGNED_SAT
            ),
        _ => {
            let reuse_right = destination == right && can_reuse_right(record.op);
            let (first, second) = if reuse_right {
                (right, left)
            } else {
                (left, right)
            };
            let op = match record.op {
                FLOAT_ADD => SSE_ADD,
                FLOAT_SUB => SSE_SUB,
                FLOAT_MUL => SSE_MUL,
                _ => SSE_DIV,
            };
            emit(inout output, in Instruction::Move(destination, first));
            Instruction::FloatBinary(op, destination, second, width)
        },
    };
    emit(inout output, in instruction);
}

fn encode_block_pass(
    in words: Slice[u64],
    allow_relocations: bool,
    inout relocations: ChunkSeq[u64],
    optimize: bool
) -> ChunkSeq[u8] {
    if words.len() < HEADER_WORDS {
        return ChunkSeq::new[u8]();
    }
    let body_words = wrapping_sub(words.len(), HEADER_WORDS);
    let count = body_words / RECORD_WORDS;
    let arguments = word_at(in words, ARGUMENT_COUNT);
    let result = word_at(in words, RETURN_VALUE);
    if wrapping_mul(count, RECORD_WORDS) != body_words
        || arguments > MAX_ARGUMENTS
        || (result != NO_VALUE && result >= wrapping_add(arguments, count))
    {
        return ChunkSeq::new[u8]();
    }
    let mut frame = match frame_layout(in words, count) {
        Option::Some(layout) => layout,
        Option::None => return ChunkSeq::new[u8](),
    };
    let first = read_record(in words, frame.slots.len());
    let labeled = frame.slots.len() < count && first.op == BLOCK_LABEL;
    if labeled && first.right != 0 {
        if first.right != frame.slots.len() {
            return ChunkSeq::new[u8]();
        }
        frame.home_slot = wrapping_sub(first.right, 1);
        let home = frame.slots.try_get(frame.home_slot).unwrap_or(FrameSlot { offset: 0, size: 0 });
        let count = home.size / SPILL_SLOT_BYTES;
        frame.promoted = if count < HOME_REGISTERS {
            count
        } else {
            HOME_REGISTERS
        };
    }
    let tail = if count == 0 {
        Record { op: CONSTANT, left: 0, right: 0, extra: 0 }
    } else {
        read_record(in words, wrapping_sub(count, 1))
    };
    let second = if tail.op == RETURN_PAIR {
        tail.left
    } else {
        NO_VALUE
    };
    let float_return = if labeled {
        first.extra == FLOAT_RETURN_LAYOUT
    } else {
        tail.op == FLOAT_RETURN
    };
    frame.floating = frame.floating || float_return;
    let return_arity = if float_return {
        1
    } else if labeled {
        first.extra
    } else if tail.op == TRAP {
        tail.left
    } else if second != NO_VALUE {
        PAIRED_RESULTS
    } else if result != NO_VALUE {
        1
    } else {
        0
    };
    let paired = return_arity == PAIRED_RESULTS;
    if return_arity > PAIRED_RESULTS
        || (second != NO_VALUE && result == NO_VALUE)
        || (labeled
            && (result != NO_VALUE
                || !valid_block_layout(in words, frame.slots.len(), count, first.extra)))
    {
        return ChunkSeq::new[u8]();
    }
    let reads = match find_last_reads(
        in words,
        arguments,
        count,
        result,
        second,
        return_arity,
        allow_relocations,
        labeled,
        inout frame
    ) {
        Option::Some(last) => last,
        Option::None => return ChunkSeq::new[u8](),
    };
    if frame.floating
        && ((result != NO_VALUE && float_value(in words, arguments, result) != float_return)
            || (second != NO_VALUE && float_value(in words, arguments, second))
            || !valid_float_operands(in words, arguments, count, paired, float_return))
    {
        return ChunkSeq::new[u8]();
    }
    if frame.vectors
        && ((result != NO_VALUE && vector_value(in words, arguments, result))
            || !valid_vector_operands(in words, arguments, count, paired))
    {
        return ChunkSeq::new[u8]();
    }
    if optimize {
        let folded = optimize_scalar_block(in words, in reads, arguments, count);
        if folded.len() != 0 {
            let mut folded_relocations = ChunkSeq::new[u64]();
            let output = encode_block_pass(
                in folded.as_slice(),
                allow_relocations,
                inout folded_relocations,
                false
            );
            if output.len() != 0 {
                relocations.extend(in folded_relocations.as_slice());
                return output;
            }
        }
    }
    let allocation = match allocate(in words, in reads, arguments, count, in frame, paired, false) {
        Option::Some(result) => result,
        Option::None => match allocate(
            in words,
            in reads,
            arguments,
            count,
            in frame,
            paired,
            true
        ) {
            Option::Some(result) => result,
            Option::None => return ChunkSeq::new[u8](),
        },
    };
    let frame_size = allocation.frame_size;

    let mut output = ChunkSeq::new[u8]();
    emit(inout output, in Instruction::FrameEnter(frame_size));
    let callee_save_mask = allocation.callee_save_mask;
    if callee_save_mask != 0 {
        preserve_registers(
            inout output,
            callee_save_mask,
            allocation.callee_save_frame,
            SPILL_SLOT_BYTES,
            false
        );
    }
    let mut branch_ends = ChunkSeq::new[u64]();
    let mut branch_depth: u64 = 0;
    let mut clobber_index: u64 = 0;
    let mut labels = ChunkSeq::new[Label]();
    let mut fixups = ChunkSeq::new[Fixup]();
    let mut table_fixups = ChunkSeq::new[TableFixup]();
    if labeled {
        for index in 0..count {
            labels.push(Label { address: NO_VALUE, block: false });
        }
    }

    for index in 0..count {
        let value = wrapping_add(arguments, index);
        let record = read_record(in words, index);
        let result_live = last_read(in reads, value) != NEVER_READ;
        match assigned(in allocation.locations, value) {
            Location::Rematerialized(_) => continue,
            _ => (),
        };
        if record.op == CALL_HIGH
            || record.op == FLOAT_ARGUMENT
            || record.op == BRANCH_TABLE_TARGET
            || !emits_instruction(
                in record,
                result_live || live_overflow_flag(in reads, value, record.op),
                frame.home_slot
            )
        {
            continue;
        }
        if record.op == BLOCK_LABEL || record.op == EDGE_LABEL {
            let old = labels.try_get(record.left).unwrap_or(Label { address: 0, block: false });
            if old.address != NO_VALUE {
                return ChunkSeq::new[u8]();
            }
            let _ = labels.try_set(
                record.left,
                Label { address: output.len(), block: record.op == BLOCK_LABEL }
            );
            continue;
        }
        if record.op == JUMP_LABEL {
            if record.left == 0 {
                return ChunkSeq::new[u8]();
            }
            let next = read_record(in words, wrapping_add(index, 1));
            if next.op == BLOCK_LABEL && next.left == record.left {
                continue;
            }
            emit(inout output, in Instruction::Jump);
            fixups.push(Fixup { target: record.left, end: output.len(), block: true });
            continue;
        }
        if record.op == BRANCH_TABLE {
            let home = assigned(in allocation.locations, record.left);
            let source = materialize(inout output, in home, RIGHT_SCRATCH);
            if !emit_jump_table(inout output, source, wrapping_u32(record.right)) {
                return ChunkSeq::new[u8]();
            }
            let base = output.len();
            for case in 0..record.right {
                let target = read_record(in words, wrapping_add(wrapping_add(index, 1), case));
                let offset = emit_jump_table_entry(inout output);
                table_fixups.push(TableFixup { target: target.left, offset: offset, base: base });
            }
            let offset = emit_jump_table_entry(inout output);
            table_fixups.push(TableFixup { target: record.extra, offset: offset, base: base });
            continue;
        }
        if (is_comparison(record.op) || record.op == OVERFLOW_FLAG)
            && wrapping_add(index, 1) < count
        {
            let next = read_record(in words, wrapping_add(index, 1));
            if flags_feed_branch(in reads, value, in next)
                || (record.op == OVERFLOW_FLAG
                    && consumes_carry(next.op)
                    && next.extra == value
                    && last_read(in reads, value) == wrapping_add(value, 1))
            {
                continue;
            }
        }
        if is_conditional_branch(record.op) {
            let comparison = if index != 0 {
                let previous = read_record(in words, wrapping_sub(index, 1));
                if (is_comparison(previous.op) || previous.op == OVERFLOW_FLAG)
                    && flags_feed_branch(in reads, wrapping_sub(value, 1), in record)
                {
                    Option::Some(previous)
                } else {
                    Option::None
                }
            } else {
                Option::None
            };
            let instruction = match comparison {
                Option::Some(compare) => {
                    if compare.op == OVERFLOW_FLAG {
                        let arithmetic = read_record(
                            in words,
                            wrapping_sub(index, CHECKED_ARITHMETIC_RECORDS)
                        );
                        // Result moves and fixed-register restores preserve the flags.
                        Instruction::BranchWithFlags(
                            overflow_condition(arithmetic.op) ^ INVERT_CONDITION
                        )
                    } else {
                        // The branch skips the true arm when the comparison is false.
                        let cc = condition_code(compare.extra) ^ INVERT_CONDITION;
                        let width = comparison_width(compare.op);
                        let home = assigned(in allocation.locations, compare.left);
                        let lhs = materialize(inout output, in home, LEFT_SCRATCH);
                        if is_immediate_comparison(compare.op) {
                            Instruction::BranchCompareImmediate(
                                lhs,
                                wrapping_u32(compare.right),
                                cc,
                                width
                            )
                        } else {
                            let home = assigned(in allocation.locations, compare.right);
                            let rhs = materialize(inout output, in home, RIGHT_SCRATCH);
                            Instruction::BranchCompare(lhs, rhs, cc, width)
                        }
                    }
                },
                Option::None => {
                    let home = assigned(in allocation.locations, record.left);
                    Instruction::BranchZero(materialize(inout output, in home, LEFT_SCRATCH))
                },
            };
            emit(inout output, in instruction);
            if record.op != BRANCH_ZERO {
                if record.right == 0 {
                    return ChunkSeq::new[u8]();
                }
                fixups.push(Fixup {
                    target: record.right,
                    end: output.len(),
                    block: record.op == BRANCH_BLOCK
                });
                continue;
            }
            if branch_depth == branch_ends.len() {
                branch_ends.push(output.len());
            } else {
                let _ = branch_ends.try_set(branch_depth, output.len());
            }
            branch_depth = wrapping_add(branch_depth, 1);
            continue;
        }
        if record.op == TAIL_CALL {
            emit_tail_call(
                inout output,
                in words,
                in allocation,
                in record,
                index,
                inout relocations
            );
            return output;
        }
        let call = is_call(record.op);
        if call || uses_fixed_registers(record.op) {
            let saved = match allocation.saved_masks.try_get(clobber_index) {
                Option::Some(saved) => saved,
                Option::None => return ChunkSeq::new[u8](),
            };
            let home = assigned(in allocation.locations, value);
            let slot_bytes = if frame.vectors {
                VECTOR_SLOT_BYTES
            } else {
                SPILL_SLOT_BYTES
            };
            preserve_registers(inout output, saved, allocation.save_frame, slot_bytes, false);
            if call {
                let high = if record.op == CALL_PAIR {
                    assigned(in allocation.locations, wrapping_add(value, 1))
                } else {
                    Location::Absent
                };
                let start = wrapping_sub(index, record.right);
                let offset = emit_call(
                    inout output,
                    in words,
                    in allocation,
                    start,
                    in record,
                    in home,
                    in high
                );
                match offset {
                    Option::Some(offset) => {
                        relocations.push(offset);
                        if record.left >= LIBCALL_TARGET_BASE {
                            relocations.push(PLT_LIBCALL);
                            relocations.push(wrapping_sub(record.left, LIBCALL_TARGET_BASE));
                        } else {
                            relocations.push(PLT_CALL);
                            relocations.push(record.left);
                        }
                    },
                    Option::None => (),
                };
            } else if is_atomic_cas(record.op) {
                emit_atomic_cas(inout output, in allocation, in record, in home);
            } else if atomic_uses_retry(record.op) {
                emit_atomic_update(inout output, in allocation, in record, in home);
            } else {
                emit_fixed_arithmetic(inout output, in allocation, in record, in home);
            }
            preserve_registers(inout output, saved, allocation.save_frame, slot_bytes, true);
            clobber_index = wrapping_add(clobber_index, 1);
            continue;
        }
        if record.op == TRAP {
            emit(inout output, in Instruction::Trap);
            return output;
        }
        if record.op == FENCE {
            emit(inout output, in Instruction::Fence);
            continue;
        }
        if is_branch_return(record.op) {
            if record.left == TRAP_VALUE {
                emit(inout output, in Instruction::Trap);
            } else {
                let low = assigned(in allocation.locations, record.left);
                let high = if paired {
                    assigned(in allocation.locations, record.right)
                } else {
                    Location::Absent
                };
                emit_return(inout output, in low, in high, in allocation, float_return);
            }
            if record.op == BLOCK_RETURN {
                continue;
            }
            branch_depth = wrapping_sub(branch_depth, 1);
            let offset = branch_ends.try_get(branch_depth).unwrap_or(0);
            if !patch_forward_branch(inout output, offset) {
                return ChunkSeq::new[u8]();
            }
            continue;
        }
        if is_store(record.op) {
            let address = assigned(in allocation.locations, record.left);
            let source = assigned(in allocation.locations, record.right);
            let base = materialize(inout output, in address, LEFT_SCRATCH);
            let scratch = if float_right(record.op) {
                XMM_RIGHT_SCRATCH
            } else {
                RIGHT_SCRATCH
            };
            emit_store_value(
                inout output,
                in source,
                base,
                wrapping_u32(record.extra),
                store_width(record.op),
                scratch
            );
            continue;
        }
        if is_stack_store(record.op) {
            let source = assigned(in allocation.locations, record.left);
            let promoted = promoted_home(in frame, in record);
            if promoted != UNASSIGNED {
                move_return(inout output, in source, promoted);
            } else {
                let offset = match local_displacement(in frame, in record, allocation.local_frame) {
                    Option::Some(offset) => offset,
                    Option::None => return ChunkSeq::new[u8](),
                };
                let scratch = if float_left(record.op) {
                    XMM_LEFT_SCRATCH
                } else {
                    LEFT_SCRATCH
                };
                emit_store_value(
                    inout output,
                    in source,
                    RSP,
                    offset,
                    store_width(record.op),
                    scratch
                );
            }
            continue;
        }
        let has_right = reads_right(in record, paired);
        let vector_binary = is_vector_binary(record.op);
        let left_width = if uses_vector_left(record.op) {
            VECTOR_BITS
        } else {
            QWORD_BITS
        };
        let left = if reads_left(in record) {
            let location = assigned(in allocation.locations, record.left);
            materialize_width(
                inout output,
                in location,
                if float_left(record.op) {
                    XMM_LEFT_SCRATCH
                } else {
                    LEFT_SCRATCH
                },
                left_width
            )
        } else {
            UNASSIGNED
        };
        if is_conditional_trap(record.op) {
            emit(inout output, in Instruction::TrapIf(left, record.op == TRAP_IF_ZERO));
            continue;
        }
        let right = if has_right {
            let location = assigned(in allocation.locations, record.right);
            let scratch = if record.op == FLOAT_SELECT {
                XMM_LEFT_SCRATCH
            } else if float_right(record.op) {
                XMM_RIGHT_SCRATCH
            } else {
                RIGHT_SCRATCH
            };
            let width = if vector_binary {
                VECTOR_BITS
            } else {
                QWORD_BITS
            };
            materialize_width(inout output, in location, scratch, width)
        } else {
            UNASSIGNED
        };
        let conditional = record.op == SELECT || record.op == FLOAT_SELECT;
        let fma = is_float_fma(record.op);
        let third = if conditional || fma {
            let location = assigned(in allocation.locations, record.extra);
            materialize(
                inout output,
                in location,
                if fma {
                    XMM_AUX_SCRATCH
                } else if record.op == FLOAT_SELECT {
                    XMM_RIGHT_SCRATCH
                } else {
                    THIRD_SCRATCH
                }
            )
        } else {
            UNASSIGNED
        };
        let home = assigned(in allocation.locations, value);
        if is_atomic_rmw(record.op) {
            emit_atomic(inout output, in record, in home, left, right, result_live);
            continue;
        }
        let destination = match home {
            Location::Register(reg) => reg,
            Location::Spill(_) => if is_float_result(record.op) {
                XMM_LEFT_SCRATCH
            } else {
                LEFT_SCRATCH
            },
            Location::Absent | Location::Rematerialized(_) => UNASSIGNED,
        };
        if record.op == CONSTANT {
            emit(inout output, in Instruction::Immediate(destination, record.left));
        } else if is_scalar_fp_instruction(record.op) {
            emit_scalar_fp(inout output, in record, destination, left, right, third);
        } else if is_vector_operation(record.op) {
            emit_vector_instruction(inout output, in record, destination, left, right);
        } else if is_scalar_bit_operation(record.op) {
            emit_bit_operation(inout output, in record, destination, left);
        } else if is_bit_mix(record.op) {
            emit_bit_mix(inout output, in record, destination, left, right);
        } else if record.op == STACK_POINTER {
            emit(inout output, in Instruction::Move(destination, RSP));
        } else if is_symbol(record.op) {
            let kind = match record.op {
                FUNCTION_GOT => X86_FUNCTION_GOT,
                SYMBOL_GOT => GOT_DATA,
                _ => RELATIVE_DATA,
            };
            let offset = emit_symbol_address(inout output, destination, kind != RELATIVE_DATA);
            relocations.push(offset);
            relocations.push(kind);
            relocations.push(record.left);
        } else if is_stack_operation(record.op) {
            let offset = match local_displacement(in frame, in record, allocation.local_frame) {
                Option::Some(offset) => offset,
                Option::None => return ChunkSeq::new[u8](),
            };
            let promoted = promoted_home(in frame, in record);
            let instruction = if promoted != UNASSIGNED {
                Instruction::Move(destination, promoted)
            } else if record.op == STACK_LOAD || record.op == FLOAT_STACK_LOAD {
                Instruction::Load(destination, RSP, offset, record.extra)
            } else {
                Instruction::StackAddress(destination, offset)
            };
            emit(inout output, in instruction);
        } else if record.op == LOAD || record.op == FLOAT_LOAD {
            emit(
                inout output,
                in Instruction::Load(destination, left, wrapping_u32(record.right), record.extra)
            );
        } else if conditional {
            if destination == right {
                emit(inout output, in Instruction::Select(destination, left, right, third, CC_E));
            } else {
                emit(inout output, in Instruction::Select(destination, left, third, right, CC_NE));
            }
        } else if is_comparison(record.op) {
            let cc = condition_code(record.extra);
            let width = comparison_width(record.op);
            let instruction = if is_immediate_comparison(record.op) {
                Instruction::CompareImmediate(
                    destination,
                    left,
                    wrapping_u32(record.right),
                    cc,
                    width
                )
            } else {
                Instruction::Compare(destination, left, right, cc, width)
            };
            emit(inout output, in instruction);
        } else if record.op == OVERFLOW_FLAG {
            let arithmetic = read_record(in words, wrapping_sub(index, 1));
            emit(
                inout output,
                in Instruction::SetCondition(destination, overflow_condition(arithmetic.op))
            );
        } else if is_immediate_arithmetic(record.op) {
            emit_immediate_arithmetic(inout output, in record, destination, left);
        } else if record.op == TRUNCATE {
            emit(inout output, in Instruction::Truncate(destination, left, record.extra));
        } else if record.op == SIGN_EXTEND {
            emit(
                inout output,
                in Instruction::SignExtend(destination, left, record.right, record.extra)
            );
        } else if record.op == ZERO_EXTEND {
            // Narrow results stay zero-extended in their physical registers.
            emit(inout output, in Instruction::Move(destination, left));
        } else {
            let reuse_right = has_right && destination == right && can_reuse_right(record.op);
            let first = if reuse_right { right } else { left };
            let second = if reuse_right { left } else { right };
            emit(inout output, in Instruction::Move(destination, first));
            emit(inout output, in operation(in record, destination, second));
        }

        match home {
            Location::Spill(offset) => {
                let width = if is_vector_result(record.op) {
                    VECTOR_BITS
                } else {
                    QWORD_BITS
                };
                emit(inout output, in Instruction::Store(destination, RSP, offset, width));
            },
            _ => {},
        };
    }
    if labeled {
        for index in 0..fixups.len() {
            let fixup = fixups
                .try_get(index)
                .unwrap_or(Fixup { target: NO_VALUE, end: 0, block: false });
            let target = labels
                .try_get(fixup.target)
                .unwrap_or(Label { address: NO_VALUE, block: false });
            if target.address == NO_VALUE
                || target.block != fixup.block
                || !patch_relative_branch(inout output, fixup.end, target.address)
            {
                return ChunkSeq::new[u8]();
            }
        }
        for index in 0..table_fixups.len() {
            let fixup = table_fixups
                .try_get(index)
                .unwrap_or(TableFixup { target: NO_VALUE, offset: 0, base: 0 });
            let target = labels
                .try_get(fixup.target)
                .unwrap_or(Label { address: NO_VALUE, block: false });
            if target.address == NO_VALUE
                || !target.block
                || !patch_relative_offset(inout output, fixup.offset, fixup.base, target.address)
            {
                return ChunkSeq::new[u8]();
            }
        }
        return output;
    }
    let low = assigned(in allocation.locations, result);
    let high = if paired {
        assigned(in allocation.locations, second)
    } else {
        Location::Absent
    };
    emit_return(inout output, in low, in high, in allocation, float_return);
    output
}
