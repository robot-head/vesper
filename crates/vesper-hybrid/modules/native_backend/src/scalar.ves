const SPILL_SLOT_BYTES: u64 = 8;
const VECTOR_SLOT_BYTES: u64 = VECTOR_BITS / BYTE_BITS;
const LEFT_SCRATCH: u8 = RAX;
const RIGHT_SCRATCH: u8 = R10;
const THIRD_SCRATCH: u8 = R11;
// One Linux x86-64 base page. Larger frames need stack probes.
const STACK_PROBE_INTERVAL: u64 = 4096;
const MAX_ARGUMENTS: u64 = ARGUMENTS + STACK_PROBE_INTERVAL / SPILL_SLOT_BYTES - 1;
const MIN_FOLDED_ADDS: u64 = 4;
const MAX_FOLDED_ADDS: u64 = 0x7fffffff;

pub copy struct Record {
    op: u64,
    left: u64,
    right: u64,
    extra: u64,
}

pub copy struct FrameSlot {
    offset: u64,
    size: u64,
}

copy struct BranchArm {
    start: u64,
    end: u64,
}

copy enum BlockPart {
    End,
    Body,
    Taken(u64),
    AwaitingEdge(u64),
    Untaken,
    JumpOnly,
    Table(u64),
}

pub copy struct Label {
    address: u64,
    block: bool,
}

copy struct Fixup {
    target: u64,
    end: u64,
    block: bool,
}

pub copy struct TableFixup {
    target: u64,
    offset: u64,
    base: u64,
}

struct FrameLayout {
    slots: ChunkSeq[FrameSlot],
    size: u64,
    used: bool,
    outgoing: u64,
    fixed: bool,
    floating: bool,
    vectors: bool,
    xmm_aux: bool,
    temporary_registers: u32,
    indirect_calls: bool,
    home_slot: u64,
    promoted: u64,
    gp_homes: u32,
    single_homes: u32,
    double_homes: u32,
}

copy enum Location {
    Absent,
    Register(u8),
    Spill(u32),
    Rematerialized(u64),
}

struct Allocation {
