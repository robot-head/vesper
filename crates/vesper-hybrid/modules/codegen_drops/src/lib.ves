// @export vsys Cranelift direct rust=vesper_cranelift_sys
//
// The `drops` family of the hybrid Stage 2 build (SH4 lane 8, #1282):
// drop glue of boxed values (`Codegen::drop_box_value`,
// `codegen_swap::drops::DROP_BOX`) emitted in Vesper through the lent
// Cranelift builder.

use @vesper/codegen-aggregates-emit::{
    drops_hook
};

// One request of the `drops` family: `call` is the address of the lent
// call. Returns 1 when it emitted the request, 0 to leave it to Rust.
pub fn drops(call: u64) -> u64 eff [Ffi[Cranelift]] {
    drops_hook(call)
}
