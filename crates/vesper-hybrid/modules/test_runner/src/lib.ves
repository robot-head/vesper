// @vesper/hybrid-test-runner: `vesper::test_discovery` and
// `vesper::doctest_extract` served from Vesper in the hybrid Stage 2 build
// (self-hosting SH5 lane 14, #1337).
//
// `case_rows_words` and `discover_words` take one call's input as the
// little-endian words of tests/common/test_runner_words.rs (the source,
// the parse's function items and the case rows) and return the result
// words that `decode_case_rows` and `decode_discover` read back.
// `doctest_preflight_words` and `doctest_extract_words` take and return the
// words of tests/common/doctest_extract_words.rs.

// @export abi 4

use @vesper/test-runner::{
    case_rows_words as rows,
    discover_words as tests,
    doctest_extract_words as fences,
    doctest_preflight_words as limits,
    format as words_format
};

// The word format of both entries; tests/common/test_runner_words.rs
// checks it.
pub fn format() -> u64 {
    words_format()
}

pub fn case_rows_words(in input: Slice[u8]) -> ChunkSeq[u64] {
    rows(in input)
}

pub fn discover_words(in input: Slice[u8]) -> ChunkSeq[u64] {
    tests(in input)
}

pub fn doctest_preflight_words(in input: Slice[u8]) -> ChunkSeq[u64] {
    limits(in input)
}

pub fn doctest_extract_words(in input: Slice[u8]) -> ChunkSeq[u64] {
    fences(in input)
}
