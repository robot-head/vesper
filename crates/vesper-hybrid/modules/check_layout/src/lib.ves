// @vesper/hybrid-check-layout: `vesper::layout::Layout::of` served from
// Vesper in the hybrid Stage 2 build (self-hosting SH2 lane 5, #1177).
//
// `layout_of_words` takes one call's input as little-endian words (names,
// types, the ADTs the layout can reach, then the type's index; written by
// `layout_input` in tests/common/check_words.rs) and returns the layout as
// the word stream of `put_layout_words` (@vesper/check-layout), which
// `decode_layout` reads back into a Rust `Layout`.

// @export abi 4

use @vesper/check-data::input::{
    Ctx,
    ctx_new
};
use @vesper/check-layout::{
    layout_part,
    layout_words
};

// The layout version of `layout_of_words`; tests/check_words.rs checks it.
pub fn format() -> u64 {
    1
}

pub fn layout_of_words(in input: Slice[u8]) -> ChunkSeq[u64] {
    layout_words(in input)
}

// One compilation's world, decoded once (self-hosting SH4 lane 2, #1276).
// The hybrid build keeps one per compilation (src/swap_input.rs) and sends
// each `layout_input_layout_of` call only what this input does not have
// yet: the new names and types, the ADTs the type reaches that were not
// sent before, then the type's index (`WorldLog::part` in
// tests/common/check_words.rs).
pub struct LayoutInput {
    c: Ctx,
}

pub fn layout_input_new() -> LayoutInput {
    LayoutInput {
        c: ctx_new()
    }
}

// `layout_of_words` over the world this input holds, after adding `part`.
pub fn layout_input_layout_of(inout s: LayoutInput, in part: Slice[u8]) -> ChunkSeq[u64] {
    layout_part(inout s.c, in part)
}
