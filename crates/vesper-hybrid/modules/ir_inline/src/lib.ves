// @vesper/hybrid-ir-inline: `vesper::ir_inline::inline` served from Vesper
// in the hybrid Stage 2 build (self-hosting SH3 lane 11, #1250), through
// the `inline` hook of `vesper::ir_swap`.
//
// `inline_words` takes the inliner's input as little-endian words (names,
// types with their facts, effect rows, the budget, the program and the
// generic call sites; written by `inline_input` in
// tests/common/inline_words.rs) and returns the report and the inlined
// program as words, which `decode_program` reads back into a Rust
// `Report` and `Program`.

// @export abi 4

use @vesper/ir-inline::{
    inline_program_words
};

// The layout version of `inline_words`.
pub fn format() -> u64 {
    1
}

pub fn inline_words(in input: Slice[u8]) -> ChunkSeq[u64] {
    inline_program_words(in input)
}

// The divergent build's stream (build.rs `divergent-ir-inline`): an empty
// report, which reads back as "nothing inlined", so optimized objects keep
// every call the default compiler inlines.
fn divergent_words(in input: Slice[u8]) -> ChunkSeq[u64] {
    let mut o: ChunkSeq[u64] = ChunkSeq::new[u64]();
    o.push(0);
    o
}
