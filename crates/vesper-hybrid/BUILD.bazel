load("//tools/bazel:vesper_hybrid.bzl", "vesper_hybrid")

# The hybrid Stage 2 compiler (self-hosting SH0 lane 1, #1123): the default
# CLI with swapped modules linked from Vesper objects that //:bin/vesper
# builds. It is never the default compiler. Every directory of modules/
# with a Loom.toml is a module (`hybrid_<dir>`, as in build.rs), so a new
# module adds no list entry here, only its `module_deps` entry, kept in
# sorted order so parallel PRs touch different lines (#1897). Keep
# `divergent` in step with the DIVERGENT_* edits in build.rs.
vesper_hybrid(
    divergent = {
        "hybrid_check_layout": {
            "edit_src": "modules/check_layout/src/lib.ves",
            "edits": {
                "    layout_words(in input)\n": "    layout_words(in input[0..0])\n",
                "    layout_part(inout s.c, in part)\n": "    layout_part(inout s.c, in part[0..0])\n",
            },
        },
        # SH5 lane 10 (#1333): the shared-world module gets both
        # divergences (the bzl applies every edit in the divergent build).
        "hybrid_checks": {
            "edit_src": "modules/checks/src/lib.ves",
            "edits": {
                "        self.body.push(w(n.size));\n": "        self.body.push(inc(w(n.size)));\n",
                "    ir_check_task(inout r, in part, inout s.c)\n": "    divergent_words(in part)\n",
            },
        },
        "hybrid_doc": {
            "edit_src": "modules/doc/src/lib.ves",
            "edits": {"(sink page: ChunkSeq[u8]) -> ChunkSeq[u8] {\n    page\n": "(sink page: ChunkSeq[u8]) -> ChunkSeq[u8] {\n    let mut p = page;\n    p.push(32);\n    p\n"},
        },
        "hybrid_driver": {
            "edit_src": "modules/driver/src/lib.ves",
            "edits": {"        write_path(in path.as_slice(), in bytes.as_slice());\n": "        write_path(in path.as_slice(), in b[0..0]);\n"},
        },
        "hybrid_ir_check": {
            "edit_src": "modules/ir_check/src/lib.ves",
            "edits": {
                "    ir_check_words(in input)\n": "    divergent_words(in input)\n",
                "    ir_check_part(inout s.c, in part)\n": "    divergent_words(in part)\n",
            },
        },
        "hybrid_ir_inline": {
            "edit_src": "modules/ir_inline/src/lib.ves",
            "edits": {"    inline_program_words(in input)\n": "    divergent_words(in input)\n"},
        },
        "hybrid_ir_opt": {
            "edit_src": "modules/ir_opt/src/lib.ves",
            "edits": {"    policy_words(in input)\n": "    divergent_words(in input)\n"},
        },
        "hybrid_lean_extract": {
            "edit_src": "modules/lean_extract/src/lib.ves",
            "edits": {"(sink text: ChunkSeq[u64]) -> ChunkSeq[u64] {\n    text\n": "(sink text: ChunkSeq[u64]) -> ChunkSeq[u64] {\n    let mut t = text;\n    let _ = t.try_set(0, 0);\n    t\n"},
        },
        "hybrid_sugar": {
            "edit_src": "modules/sugar/src/lib.ves",
            "edits": {"(sink words: ChunkSeq[u64]) -> ChunkSeq[u64] {\n    words\n": "(sink words: ChunkSeq[u64]) -> ChunkSeq[u64] {\n    let mut t = words;\n    let _ = t.try_set(0, 0);\n    t\n"},
        },
        "hybrid_verified_codegen": {
            "edit_src": "modules/verified_codegen/src/lib.ves",
            "edits": {"(sink words: ChunkSeq[u64]) -> ChunkSeq[u64] {\n    words\n": "(sink words: ChunkSeq[u64]) -> ChunkSeq[u64] {\n    let mut t = words;\n    let _ = t.try_set(0, 0);\n    t\n"},
        },
        "hybrid_layout": {
            "edit_src": "modules/layout/src/lib.ves",
            "edits": {"    if is_enum { 8 } else { 0 }\n": "    if is_enum { 16 } else { 0 }\n"},
        },
        "hybrid_optimize": {
            "edit_src": "modules/optimize/src/lib.ves",
            "edits": {"    optimize_propose_split(in input, in names)\n": "    divergent_words(in input, in names)\n"},
        },
        "hybrid_pact": {
            "edit_src": "modules/pact/src/lib.ves",
            "edits": {"    session_open(in input)\n": "    divergent_session(in input)\n"},
        },
        "hybrid_parse": {
            "edit_src": "modules/parse/src/lib.ves",
            "edits": {"    put_ast_words(inout o, in l.ast);\n": "    put_ast_words(inout o, in lower_source(in \"\").ast);\n"},
        },
        "hybrid_stack_bound": {
            "edit_src": "modules/stack_bound/src/lib.ves",
            "edits": {"    stack_bound_words(in input)\n": "    divergent_words(in input)\n"},
        },
    },
