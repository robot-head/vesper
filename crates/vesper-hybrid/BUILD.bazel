load("//tools/bazel:vesper_hybrid.bzl", "vesper_hybrid")

# The hybrid Stage 2 compiler (self-hosting SH0 lane 1, #1123): the default
# CLI with swapped modules linked from Vesper objects that //:bin/vesper
# builds. It is never the default compiler. Keep `modules` and `divergent`
# in step with MODULES and DIVERGENT_EDIT in build.rs.
vesper_hybrid(
    divergent = {
        "hybrid_layout": {
            "edit_src": "modules/layout/src/lib.ves",
            "edits": {"        8\n    } else {\n        0\n": "        16\n    } else {\n        0\n"},
        },
        "hybrid_check_layout": {
            "edit_src": "modules/check_layout/src/lib.ves",
            "edits": {
                "    layout_words(in input)\n": "    layout_words(in input[0..0])\n",
                "    layout_part(inout s.c, in part)\n": "    layout_part(inout s.c, in part[0..0])\n",
            },
        },
        "hybrid_ir_check": {
            "edit_src": "modules/ir_check/src/lib.ves",
            "edits": {
                "    ir_check_words(in input)\n": "    divergent_words(in input)\n",
                "    ir_check_part(inout s.c, in part)\n": "    divergent_words(in part)\n",
            },
        },
        "hybrid_stack_bound": {
            "edit_src": "modules/stack_bound/src/lib.ves",
            "edits": {"    stack_bound_words(in input)\n": "    divergent_words(in input)\n"},
        },
        "hybrid_ir_inline": {
            "edit_src": "modules/ir_inline/src/lib.ves",
            "edits": {"    inline_program_words(in input)\n": "    divergent_words(in input)\n"},
        },
        "hybrid_ir_opt": {
            "edit_src": "modules/ir_opt/src/lib.ves",
            "edits": {"    ir_opt_words(in input)\n": "    divergent_words(in input)\n"},
        },
        "hybrid_parse": {
            "edit_src": "modules/parse/src/lib.ves",
            "edits": {"    if b {\n        1\n    } else {\n        0\n    }": "    if b {\n        0\n    } else {\n        1\n    }"},
        },
    },
    # The included CLI sources (src/main.rs and its command modules) and
    # what they embed.
    extra_compile_data = ["//:files"],
    # The differential harness runs the default compiler beside the hybrid
    # over the bootstrap corpus, examples/ and tests/; tests/parse.rs also
    # reads the parser test sources.
    extra_test_data = [
        "//:files",
        "//bootstrap:files",
        "//crates/vesper-syntax:files",
    ],
    # The parse module (#1155) builds on the front end v2 and the AST.
    module_deps = {
        # The checker swaps (#1177) build on @vesper/check-data.
        "hybrid_check_layout": [
            "//:check_data_package",
            "//:check_layout_package",
        ],
        # The driver (#1335) builds on @vesper/driver and @vesper-std I/O.
        "hybrid_driver": [
            "//:driver_package",
            "//:std_env_package",
            "//:std_fmt_package",
            "//:std_fs_package",
            "//:std_process_package",
        ],
        # The codegen swap (#1275) emits through the Cranelift shim.
        "hybrid_codegen": [
            "//:codegen_base_package",
            "//packages/vesper-cranelift:cranelift_package",
        ],
        # The export planner and glue (#1286); the glue emits through the
        # Cranelift shim too.
        "hybrid_codegen_export": [
            "//:codegen_export_glue_package",
            "//:codegen_export_package",
            "//packages/vesper-cranelift:cranelift_package",
        ],
        "hybrid_ir_check": [
            "//:check_data_package",
            "//:ir_check_package",
        ],
        # The stack-bound swap (#1182) builds on @vesper/check-loops-atomics.
        "hybrid_stack_bound": [
            "//:check_data_package",
            "//:check_loops_atomics_package",
        ],
        "hybrid_ir_inline": [
            "//:check_data_package",
            "//:ir_inline_package",
        ],
        "hybrid_ir_opt": [
            "//:check_data_package",
            "//:egraph_package",
            "//:ir_opt_package",
            "//:place_ir_package",
        ],
        # The IR swap point's identity round trip (#1240).
        "hybrid_place_ir": [
            "//:check_data_package",
            "//:place_ir_package",
        ],
        # The IR swap point's `hoist` hook (#1251).
        "hybrid_bounds_hoist": [
            "//:bounds_hoist_package",
            "//:check_data_package",
            "//:place_ir_package",
        ],
        "hybrid_parse": [
            "//:ast_package",
            "//:front_package",
            "//:std_intern_package",
        ],
        # Test discovery (#1337) builds on @vesper/test-runner.
        "hybrid_test_runner": [
            "//:front_package",
            "//:test_runner_package",
        ],
    },
    modules = {
        "hybrid_check_layout": "modules/check_layout",
        "hybrid_driver": "modules/driver",
        "hybrid_codegen": "modules/codegen",
        "hybrid_codegen_export": "modules/codegen_export",
        "hybrid_ir_check": "modules/ir_check",
        "hybrid_ir_inline": "modules/ir_inline",
        "hybrid_ir_opt": "modules/ir_opt",
        "hybrid_layout": "modules/layout",
        "hybrid_parse": "modules/parse",
        "hybrid_test_runner": "modules/test_runner",
        "hybrid_place_ir": "modules/place_ir",
        "hybrid_stack_bound": "modules/stack_bound",
        "hybrid_bounds_hoist": "modules/bounds_hoist",
    },
    # The export glue swap (#1286) builds every library a port crate links
    # (tests/self_host_codegen_export/ports.rs) with both compilers.
    test_data_by_target = {
        "test/codegen_export": [
            "//:files",
            "//crates/vesper-aegis:files",
            "//crates/vesper-alloc:files",
            "//crates/vesper-aura:files",
            "//crates/vesper-beacon:files",
            "//crates/vesper-bench:files",
            "//crates/vesper-chorus:files",
            "//crates/vesper-crucible:files",
            "//crates/vesper-diagnostics:files",
            "//crates/vesper-ebpf:files",
            "//crates/vesper-flux:files",
            "//crates/vesper-fmt:files",
            "//crates/vesper-forge:files",
            "//crates/vesper-grammar:files",
            "//crates/vesper-highlight:files",
            "//crates/vesper-hybrid:files",
            "//crates/vesper-ignis:files",
            "//crates/vesper-kinetic:files",
            "//crates/vesper-lean-syntax:files",
            "//crates/vesper-lint:files",
            "//crates/vesper-loom-audit:files",
            "//crates/vesper-loom-calculus:files",
            "//crates/vesper-loom-solver:files",
            "//crates/vesper-pact:files",
            "//crates/vesper-port-build:files",
            "//crates/vesper-port-pilot:files",
            "//crates/vesper-prism:files",
            # vesper/target/ is outside :files (no **/target/** glob).
            "//crates/vesper-prism:target_package",
            "//crates/vesper-prism-h3:files",
            "//crates/vesper-quarry:files",
            "//crates/vesper-resonance:files",
            "//crates/vesper-semver:files",
            "//crates/vesper-serde:files",
            "//crates/vesper-silicon:files",
            "//crates/vesper-simpulse:files",
            "//crates/vesper-span:files",
            "//crates/vesper-std-driver:files",
            "//crates/vesper-tensor:files",
            "//crates/vesper-warp:files",
            "//crates/vesper-warp-bbr:files",
            "//crates/vesper-warp-tcp:files",
            "//crates/vesper-warp-wheel:files",
        ],
    },
    test_env = {"VESPER_DEFAULT_COMPILER": "vesper"},
    # 51 libraries, each built by both compilers.
    test_timeouts = {"test/codegen_export": "long"},
    test_path_binaries = {
        "test/codegen_export": [
            ":bin/vesper-hybrid",
            "//:bin/vesper",
        ],
        "test/differential": [
            ":bin/vesper-hybrid",
            "//:bin/vesper",
        ],
        "test/driver": [
            ":bin/vesper-hybrid",
            "//:bin/vesper",
        ],
        # The stack-bound swap (#1182) through the CLI.
        "test/stack_bound": [
            ":bin/vesper-hybrid",
            "//:bin/vesper",
        ],
        # SH4 lane 2 (#1276): the hybrid's own cost report.
        "test/swap_inputs": [":bin/vesper-hybrid"],
    },
)
