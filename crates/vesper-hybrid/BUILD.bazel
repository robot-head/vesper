load("//tools/bazel:vesper_hybrid.bzl", "vesper_hybrid")

# The hybrid Stage 2 compiler (self-hosting SH0 lane 1, #1123): the default
# CLI with swapped modules linked from Vesper objects that //:bin/vesper
# builds. It is never the default compiler. Keep `modules` and `divergent`
# in step with MODULES and DIVERGENT_EDIT in build.rs.
vesper_hybrid(
    divergent = {
        "hybrid_layout": {
            "edit_src": "modules/layout/src/lib.ves",
            "edits": {"        8\n    } else {\n        0\n": "        16\n    } else {\n        0\n"},
        },
        "hybrid_check_layout": {
            "edit_src": "modules/check_layout/src/lib.ves",
            "edits": {"    layout_words(in input)\n": "    layout_words(in input[0..0])\n"},
        },
        "hybrid_ir_check": {
            "edit_src": "modules/ir_check/src/lib.ves",
            "edits": {"    ir_check_words(in input)\n": "    divergent_words(in input)\n"},
        },
        "hybrid_stack_bound": {
            "edit_src": "modules/stack_bound/src/lib.ves",
            "edits": {"    stack_bound_words(in input)\n": "    divergent_words(in input)\n"},
        },
        "hybrid_ir_inline": {
            "edit_src": "modules/ir_inline/src/lib.ves",
            "edits": {"    inline_program_words(in input)\n": "    divergent_words(in input)\n"},
        },
        "hybrid_parse": {
            "edit_src": "modules/parse/src/lib.ves",
            "edits": {"    if b {\n        1\n    } else {\n        0\n    }": "    if b {\n        0\n    } else {\n        1\n    }"},
        },
    },
    # The included CLI sources (src/main.rs and its command modules) and
    # what they embed.
    extra_compile_data = ["//:files"],
    # The differential harness runs the default compiler beside the hybrid
    # over the bootstrap corpus, examples/ and tests/; tests/parse.rs also
    # reads the parser test sources.
    extra_test_data = [
        "//:files",
        "//bootstrap:files",
        "//crates/vesper-syntax:files",
    ],
    # The parse module (#1155) builds on the front end v2 and the AST.
    module_deps = {
        # The checker swaps (#1177) build on @vesper/check-data.
        "hybrid_check_layout": [
            "//:check_data_package",
            "//:check_layout_package",
        ],
        # The codegen swap (#1275) emits through the Cranelift shim.
        "hybrid_codegen": [
            "//:codegen_base_package",
            "//packages/vesper-cranelift:cranelift_package",
        ],
        "hybrid_ir_check": [
            "//:check_data_package",
            "//:ir_check_package",
        ],
        # The stack-bound swap (#1182) builds on @vesper/check-loops-atomics.
        "hybrid_stack_bound": [
            "//:check_data_package",
            "//:check_loops_atomics_package",
        ],
        "hybrid_ir_inline": [
            "//:check_data_package",
            "//:ir_inline_package",
        ],
        # The IR swap point's identity round trip (#1240).
        "hybrid_place_ir": [
            "//:check_data_package",
            "//:place_ir_package",
        ],
        "hybrid_parse": [
            "//:ast_package",
            "//:front_package",
            "//:std_intern_package",
        ],
        # Test discovery (#1337) builds on @vesper/test-runner.
        "hybrid_test_runner": [
            "//:front_package",
            "//:test_runner_package",
        ],
    },
    modules = {
        "hybrid_check_layout": "modules/check_layout",
        "hybrid_codegen": "modules/codegen",
        "hybrid_ir_check": "modules/ir_check",
        "hybrid_ir_inline": "modules/ir_inline",
        "hybrid_layout": "modules/layout",
        "hybrid_parse": "modules/parse",
        "hybrid_test_runner": "modules/test_runner",
        "hybrid_place_ir": "modules/place_ir",
        "hybrid_stack_bound": "modules/stack_bound",
    },
    test_env = {"VESPER_DEFAULT_COMPILER": "vesper"},
    test_path_binaries = {
        "test/differential": [
            ":bin/vesper-hybrid",
            "//:bin/vesper",
        ],
        # The stack-bound swap (#1182) through the CLI.
        "test/stack_bound": [
            ":bin/vesper-hybrid",
            "//:bin/vesper",
        ],
    },
)
