load("//tools/bazel:vesper_hybrid.bzl", "vesper_hybrid")

# The hybrid Stage 2 compiler (self-hosting SH0 lane 1, #1123): the default
# CLI with swapped modules linked from Vesper objects that //:bin/vesper
# builds. It is never the default compiler. Keep `modules` and `divergent`
# in step with MODULES and DIVERGENT_EDIT in build.rs.
vesper_hybrid(
    divergent = {
        "hybrid_layout": {
            "edit_src": "modules/layout/src/lib.ves",
            "edits": {"        8\n    } else {\n        0\n": "        16\n    } else {\n        0\n"},
        },
        "hybrid_check_layout": {
            "edit_src": "modules/check_layout/src/lib.ves",
            "edits": {"    layout_words(in input)\n": "    layout_words(in input[0..0])\n"},
        },
        "hybrid_ir_check": {
            "edit_src": "modules/ir_check/src/lib.ves",
            "edits": {"    ir_check_words(in input)\n": "    divergent_words(in input)\n"},
        },
        "hybrid_doc": {
            "edit_src": "modules/doc/src/lib.ves",
            "edits": {"(sink page: ChunkSeq[u8]) -> ChunkSeq[u8] {\n    page\n": "(sink page: ChunkSeq[u8]) -> ChunkSeq[u8] {\n    let mut p = page;\n    p.push(32);\n    p\n"},
        },
        "hybrid_parse": {
            "edit_src": "modules/parse/src/lib.ves",
            "edits": {"    if b {\n        1\n    } else {\n        0\n    }": "    if b {\n        0\n    } else {\n        1\n    }"},
        },
    },
    # The included CLI sources (src/main.rs and its command modules) and
    # what they embed.
    extra_compile_data = ["//:files"],
    # The differential harness runs the default compiler beside the hybrid
    # over the bootstrap corpus, examples/ and tests/; tests/parse.rs also
    # reads the parser test sources.
    extra_test_data = [
        "//:files",
        "//bootstrap:files",
        "//crates/vesper-syntax:files",
    ],
    # The parse module (#1155) builds on the front end v2 and the AST.
    module_deps = {
        # The checker swaps (#1177) build on @vesper/check-data.
        "hybrid_check_layout": [
            "//:check_data_package",
            "//:check_layout_package",
        ],
        # The doc renderers (#1338) build on @vesper/doc and @vesper/serde.
        "hybrid_doc": [
            "//:doc_package",
            "//crates/vesper-serde:port_package",
        ],
        "hybrid_ir_check": [
            "//:check_data_package",
            "//:ir_check_package",
        ],
        "hybrid_parse": [
            "//:ast_package",
            "//:front_package",
            "//:std_intern_package",
        ],
    },
    modules = {
        "hybrid_check_layout": "modules/check_layout",
        "hybrid_doc": "modules/doc",
        "hybrid_ir_check": "modules/ir_check",
        "hybrid_layout": "modules/layout",
        "hybrid_parse": "modules/parse",
    },
    test_env = {"VESPER_DEFAULT_COMPILER": "vesper"},
    test_path_binaries = {
        "test/differential": [
            ":bin/vesper-hybrid",
            "//:bin/vesper",
        ],
        "test/doc": [
            ":bin/vesper-hybrid",
            "//:bin/vesper",
        ],
    },
)
