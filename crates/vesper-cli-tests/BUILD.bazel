load("//tools/bazel:defs.bzl", "vesper_crate")

# The CLI tests (#1397 retirement step R5, #2743), moved out of the root
# package. They run the shipped compiler, `//:vesper_shipped`, which the
# launcher puts on PATH as `vesper` (tests/support/mod.rs), with the
# `vesper-<tool>` binaries beside it, and start it in the repository root,
# where they ran as root integration tests (`//:files`).
vesper_crate(
    # doc_links_cli, doc_navigation_cli and macro_preview_cli include root
    # fixtures that the self-host checker corpus also walks.
    extra_integration_compile_data = ["//:cli_test_sources"],
    extra_test_data = [
        "//:files",
        # attestation_cli and publish_cli sign with the Loom trust fixtures;
        # grammar_cli reads the grammar's IPC fixtures.
        "//crates/vesper-grammar:files",
        "//crates/vesper-loom-trust:files",
    ],
    extra_test_path_binaries = [
        "//:vesper_shipped",
        "//:vesper_tools",
    ],
)
