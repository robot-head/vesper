// @vesper/pact: Vesper port of vesper-pact (port wave P3a lane 3, #1038),
// canonical trait goals and tabled trait resolution (design §16.2-16.3).
//
// All state lives in one handle `S`: a hash-consed node arena (term.ves),
// the decoded program tables (program.ves), diagnostics with their text in
// `txt` (diag.ves), the solver's answer table and stack (solver.ves) and
// the result words `out` (out.ves). The Rust wrapper (src/port.rs) encodes
// the DTOs as words, calls one entry point below and rebuilds its own types
// from `out` and `txt`.
//
// Modules: term (arena), fold (folds and substitutions), infer
// (unification), canon (canonicalization), mode (modal bounds), render
// (Display and Debug text), diag (diagnostics), program (decoding and
// validation), solver (resolution), query (`Solver::solve`), coherence,
// deriv (`check_derivation`) and out (result words).
use self::term::{
    inc,
    new_arena
};
use self::program::{
    index_impls,
    rd_conformance,
    rd_der,
    rd_env,
    rd_program,
    rd_query,
    validate_program,
    validate_query
};
use self::diag::{
    sort_diags,
    truncate_diags
};
use self::query::{
    reset_solver,
    solve_query
};
use self::coherence::{
    check_coherence,
    conformance_env,
    orphan
};
use self::canon::{
    binders_slist,
    canon_free,
    canon_placeholders
};
use self::deriv::{
    check_derivation
};
use self::out::{
    w,
    w_diags,
    w_env,
    w_outcome,
    w_slist,
    w_term
};

// Default solver limits, as in the Rust `SolverConfig::default()`. The
// depth bound keeps recursion within a 2 MiB thread stack.
const DEFAULT_MAX_DEPTH: u64 = 48;
const DEFAULT_MAX_STEPS: u64 = 100000;
const DEFAULT_MAX_FIX: u64 = 16;

pub struct S {
    tg: ChunkSeq[u64],
    fa: ChunkSeq[u64],
    fb: ChunkSeq[u64],
    fc: ChunkSeq[u64],
    ls: ChunkSeq[u64],
    ln: ChunkSeq[u64],
    fl: ChunkSeq[u64],
    hs: ChunkSeq[u64],
    kids: ChunkSeq[u64],
    ht: ChunkSeq[u64],
    tmp: ChunkSeq[u64],
    ford: ChunkSeq[u64],
    cn_key: ChunkSeq[u64],
    cn_val: ChunkSeq[u64],
    cn_stamp: ChunkSeq[u64],
    cn_binders: ChunkSeq[u64],
    cn_origins: ChunkSeq[u64],
    dg_code: ChunkSeq[u64],
    dg_sv: ChunkSeq[u64],
    dg_sa: ChunkSeq[u64],
    dg_sb: ChunkSeq[u64],
    dg_off: ChunkSeq[u64],
    dg_len: ChunkSeq[u64],
    pk_id: ChunkSeq[u64],
    ct_id: ChunkSeq[u64],
    ct_pkg: ChunkSeq[u64],
    ct_params: ChunkSeq[u64],
    ct_base: ChunkSeq[u64],
    ct_joins: ChunkSeq[u64],
    ef_id: ChunkSeq[u64],
    ef_pkg: ChunkSeq[u64],
    ef_params: ChunkSeq[u64],
    tr_id: ChunkSeq[u64],
    tr_pkg: ChunkSeq[u64],
    tr_params: ChunkSeq[u64],
    tr_as_at: ChunkSeq[u64],
    tr_as_n: ChunkSeq[u64],
    tr_coind: ChunkSeq[u64],
    as_mode: ChunkSeq[u64],
    as_bd_at: ChunkSeq[u64],
    as_bd_n: ChunkSeq[u64],
    bd_trait: ChunkSeq[u64],
    bd_args: ChunkSeq[u64],
    bd_brand: ChunkSeq[u64],
    cf_id: ChunkSeq[u64],
    cf_pkg: ChunkSeq[u64],
    cf_params: ChunkSeq[u64],
    cf_tref: ChunkSeq[u64],
    cf_where: ChunkSeq[u64],
    cf_vals: ChunkSeq[u64],
    ib: ChunkSeq[u64],
    ib_at: ChunkSeq[u64],
    ib_n: ChunkSeq[u64],
    seen: ChunkSeq[u64],
    atoms: ChunkSeq[u64],
    ck_env: ChunkSeq[u64],
    ck_goal: ChunkSeq[u64],
    ck_val: ChunkSeq[u64],
    sk_env: ChunkSeq[u64],
    sk_goal: ChunkSeq[u64],
    sk_co: ChunkSeq[u64],
    sk_pco: ChunkSeq[u64],
    sk_pind: ChunkSeq[u64],
    sk_uco: ChunkSeq[u64],
    sk_uind: ChunkSeq[u64],
    sk_min: ChunkSeq[u64],
    ph_src: ChunkSeq[u64],
    ph_val: ChunkSeq[u64],
    de_path: ChunkSeq[u64],
    path: ChunkSeq[u64],
    anc: ChunkSeq[u64],
    out: ChunkSeq[u64],
    txt: ChunkSeq[u8],
    hmask: u64,
    hcount: u64,
    ferr: u64,
    rerr: u64,
    dkey: u64,
    fsub: u64,
    cn_gen: u64,
    cn_mask: u64,
    nimpl: u64,
