fn new_s() -> S {
    let mut s = S {
        tg: ChunkSeq::new[u64](),
        fa: ChunkSeq::new[u64](),
        fb: ChunkSeq::new[u64](),
        fc: ChunkSeq::new[u64](),
        ls: ChunkSeq::new[u64](),
        ln: ChunkSeq::new[u64](),
        fl: ChunkSeq::new[u64](),
        hs: ChunkSeq::new[u64](),
        kids: ChunkSeq::new[u64](),
        ht: ChunkSeq::new[u64](),
        tmp: ChunkSeq::new[u64](),
        ford: ChunkSeq::new[u64](),
        cn_key: ChunkSeq::new[u64](),
        cn_val: ChunkSeq::new[u64](),
        cn_stamp: ChunkSeq::new[u64](),
        cn_binders: ChunkSeq::new[u64](),
        cn_origins: ChunkSeq::new[u64](),
        dg_code: ChunkSeq::new[u64](),
        dg_sv: ChunkSeq::new[u64](),
        dg_sa: ChunkSeq::new[u64](),
        dg_sb: ChunkSeq::new[u64](),
        dg_off: ChunkSeq::new[u64](),
        dg_len: ChunkSeq::new[u64](),
        pk_id: ChunkSeq::new[u64](),
        ct_id: ChunkSeq::new[u64](),
        ct_pkg: ChunkSeq::new[u64](),
        ct_params: ChunkSeq::new[u64](),
        ct_base: ChunkSeq::new[u64](),
        ct_joins: ChunkSeq::new[u64](),
        ef_id: ChunkSeq::new[u64](),
        ef_pkg: ChunkSeq::new[u64](),
        ef_params: ChunkSeq::new[u64](),
        tr_id: ChunkSeq::new[u64](),
        tr_pkg: ChunkSeq::new[u64](),
        tr_params: ChunkSeq::new[u64](),
        tr_as_at: ChunkSeq::new[u64](),
        tr_as_n: ChunkSeq::new[u64](),
        tr_coind: ChunkSeq::new[u64](),
        as_mode: ChunkSeq::new[u64](),
        as_bd_at: ChunkSeq::new[u64](),
        as_bd_n: ChunkSeq::new[u64](),
        bd_trait: ChunkSeq::new[u64](),
        bd_args: ChunkSeq::new[u64](),
        bd_brand: ChunkSeq::new[u64](),
        cf_id: ChunkSeq::new[u64](),
        cf_pkg: ChunkSeq::new[u64](),
        cf_params: ChunkSeq::new[u64](),
        cf_tref: ChunkSeq::new[u64](),
        cf_where: ChunkSeq::new[u64](),
        cf_vals: ChunkSeq::new[u64](),
        ib: ChunkSeq::new[u64](),
        ib_at: ChunkSeq::new[u64](),
        ib_n: ChunkSeq::new[u64](),
        seen: ChunkSeq::new[u64](),
        atoms: ChunkSeq::new[u64](),
        ck_env: ChunkSeq::new[u64](),
        ck_goal: ChunkSeq::new[u64](),
        ck_val: ChunkSeq::new[u64](),
        sk_env: ChunkSeq::new[u64](),
        sk_goal: ChunkSeq::new[u64](),
        sk_co: ChunkSeq::new[u64](),
        sk_pco: ChunkSeq::new[u64](),
        sk_pind: ChunkSeq::new[u64](),
        sk_uco: ChunkSeq::new[u64](),
        sk_uind: ChunkSeq::new[u64](),
        sk_min: ChunkSeq::new[u64](),
        ph_src: ChunkSeq::new[u64](),
        ph_val: ChunkSeq::new[u64](),
        de_path: ChunkSeq::new[u64](),
        path: ChunkSeq::new[u64](),
        anc: ChunkSeq::new[u64](),
        out: ChunkSeq::new[u64](),
        txt: ChunkSeq::new[u8](),
        hmask: 0,
        hcount: 0,
        ferr: 18446744073709551615,
        rerr: 18446744073709551615,
        dkey: 0,
        fsub: 0,
        cn_gen: 0,
        cn_mask: 0,
        nimpl: 0,
        nmodel: 0,
        smaj: 0,
        smin: 0,
        pos: 0,
        sc_kind: 0,
        sc_params: 0,
        sc_phs: 0,
        sc_binders: 0,
        vatom: 0,
        ck_mask: 0,
        ck_count: 0,
        st_evals: 0,
        st_hits: 0,
        st_cocyc: 0,
        st_indcyc: 0,
        st_reruns: 0,
        max_depth: DEFAULT_MAX_DEPTH,
        max_steps: DEFAULT_MAX_STEPS,
        max_fix: DEFAULT_MAX_FIX,
        steps: 0,
        cenv: 0,
        cgoal: 0,
        corigin: 0,
        qmaj: 0,
        qmin: 0,
        qenv: 0,
        qbinders: 0,
        qgoal: 0,
        de_off: 0,
        rp_d: 0,
        rp_next: 0,
        rp_end: 0,
        de_failed: false,
        oob: false,
        rp_ok: false
    };
    new_arena(inout s);
    let mut i: u64 = 0;
    loop {
        if i >= 64 {
            break;
        }
        s.cn_key.push(0);
        s.cn_val.push(0);
        s.cn_stamp.push(0);
        i = inc(i);
    }
    s.cn_mask = 63;
    s
}

// A validated program, decoded and indexed.
fn load(in words: Slice[u64]) -> S {
    let mut s = new_s();
    rd_program(inout s, in words);
    index_impls(inout s);
    s
}

// `Program::new`: out is the sorted diagnostics (none when valid).
pub fn program_check(in words: Slice[u64]) -> S {
    let mut s = new_s();
    rd_program(inout s, in words);
    validate_program(inout s);
    sort_diags(inout s, 0);
    w_diags(inout s, 0);
    s
}

// `check_coherence` of a validated program: out is the sorted diagnostics.
pub fn coherence(in words: Slice[u64]) -> S {
    let mut s = load(in words);
    check_coherence(inout s);
    w_diags(inout s, 0);
    s
}

// `Solver::with_config` over a validated program.
pub fn solver_new(in words: Slice[u64], max_depth: u64, max_steps: u64, max_fix: u64) -> S {
    let mut s = load(in words);
    s.max_depth = max_depth;
    s.max_steps = max_steps;
    s.max_fix = max_fix;
    reset_solver(inout s);
    s
}

// `Solver::solve`: out is `0 outcome`, `1 diagnostics`, or `2` when the
// query names a placeholder the environment does not declare (the Rust
// build panics there).
pub fn s_solve(inout s: S, in query: Slice[u64]) {
    s.out.clear();
    s.txt.clear();
    s.pos = 0;
    rd_query(inout s, in query);
    let base = s.dg_code.len();
    let maj = s.qmaj;
    let min = s.qmin;
    let env = s.qenv;
    let binders = s.qbinders;
    let goal = s.qgoal;
    s.oob = false;
    let r = solve_query(inout s, maj, min, env, binders, goal);
    if s.oob {
        w(inout s, 2);
    } else if r == 0 {
        w(inout s, 1);
        w_diags(inout s, base);
    } else {
        w(inout s, 0);
        w_outcome(inout s, r);
    }
    truncate_diags(inout s, base);
}

// `canonicalize_query`: out is `0 env binders goal`, `1 key` on a
// duplicate label, or `2` on an undeclared placeholder.
pub fn canonicalize(in query: Slice[u64]) -> S {
    let mut s = new_s();
    rd_query(inout s, in query);
    let env = s.qenv;
    let goal = s.qgoal;
    if !canon_placeholders(inout s, env, goal) {
        w(inout s, 1);
        let k = s.dkey;
        w(inout s, k);
        return s;
    }
    if s.oob {
        w(inout s, 2);
        return s;
    }
    let cg = s.cgoal;
    let g = canon_free(inout s, cg);
    if g == 0 {
        w(inout s, 1);
        let k = s.dkey;
        w(inout s, k);
        return s;
    }
    let b = binders_slist(inout s);
    w(inout s, 0);
    let ce = s.cenv;
    w_env(inout s, ce);
    w_slist(inout s, b);
    w_term(inout s, g);
    s
}

// `check_derivation`: the program, an environment and a derivation. out
// is `0` when it checks, else `1 n index*` with the message in txt.
pub fn derivation(in words: Slice[u64]) -> S {
    let mut s = load(in words);
    let env = rd_env(inout s, in words);
    let d = rd_der(inout s, in words);
    if check_derivation(inout s, env, d) {
        w(inout s, 0);
    } else {
        w(inout s, 1);
        let n = s.de_path.len();
        w(inout s, n);
        let mut i: u64 = 0;
        loop {
            if i >= n {
                break;
            }
            let x = match s.de_path.try_get(i) {
                Option::Some(v) => v,
                Option::None => 0
            };
            w(inout s, x);
            i = inc(i);
        }
        let off = s.de_off;
        w(inout s, off);
    }
    s
}

// The input of `orphan_check` and `conformance_env_of` is a validated
// program followed by one conformance (`ConformanceDecl` words), which is
// decoded after the program's impls and models.
// `check_orphan`: out is `0` when legal, `1` with the message in txt, or
// `2` when the conformance names a trait or type constructor the program
// does not declare (the Rust build panics there).
pub fn orphan_check(in words: Slice[u64]) -> S {
    let mut s = load(in words);
    let c = s.cf_id.len();
    rd_conformance(inout s, in words, 0);
    let legal = orphan(inout s, c);
    if s.oob {
        w(inout s, 2);
    } else if legal {
        w(inout s, 0);
    } else {
        w(inout s, 1);
    }
    s
}

// `conformance_env`: out is `0 env`, or `2` when a mode bound names a
// parameter the conformance does not declare (the Rust build panics
// there).
pub fn conformance_env_of(in words: Slice[u64]) -> S {
    let mut s = load(in words);
    let c = s.cf_id.len();
    rd_conformance(inout s, in words, 0);
    let e = conformance_env(inout s, c);
    if s.oob {
        w(inout s, 2);
    } else {
        w(inout s, 0);
        w_env(inout s, e);
    }
    s
}

// `validate_query` of a validated program and a query: out is `0` when it
// passes, else `1` and the sorted diagnostics.
pub fn query_check(in words: Slice[u64]) -> S {
    let mut s = load(in words);
    rd_query(inout s, in words);
    let base = s.dg_code.len();
    let maj = s.qmaj;
    let min = s.qmin;
    let env = s.qenv;
    let binders = s.qbinders;
    let goal = s.qgoal;
    if validate_query(inout s, maj, min, env, binders, goal) {
        w(inout s, 0);
    } else {
        w(inout s, 1);
        w_diags(inout s, base);
    }
    s
}
