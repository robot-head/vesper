// Module query of @vesper/pact (see lib.ves): `Solver::solve`, one
// top-level query, and mapping its outcome back to the caller's
// placeholders (`restore_placeholders`).
use self::{S};
use self::term::{
    am_stalled, c_nested, cf_node, f_node, field_a, field_b, field_c, inc, intern, intern1, intern2,
    intern_with_kids, k_list, kid, kid_count, q_ambig, q_nosol, q_proven, q_unsup, r_cands, r_mode,
    tag_of, un_dup, un_mixed
};
use self::fold::{run};
use self::infer::{fresh_args};
use self::canon::{canon_placeholders};
use self::program::{validate_query};
use self::solver::{drive, make_response};

// Resets the table, the stack and the statistics (a new `Solver`).
pub fn reset_solver(inout s: S) {
    let cap: u64 = 64;
    s.ck_env.clear();
    s.ck_goal.clear();
    s.ck_val.clear();
    for i in 0..cap {
        s.ck_env.push(0);
        s.ck_goal.push(0);
        s.ck_val.push(0);
    }
    s.ck_mask = 63;
    s.ck_count = 0;
    s.sk_env.clear();
    s.sk_goal.clear();
    s.sk_co.clear();
    s.sk_pco.clear();
    s.sk_pind.clear();
    s.sk_uco.clear();
    s.sk_uind.clear();
    s.sk_min.clear();
    s.st_evals = 0;
    s.st_hits = 0;
    s.st_cocyc = 0;
    s.st_indcyc = 0;
    s.st_reruns = 0;
}

// Folds n with op 8 (placeholders restored through s.fsub), keeping n
// when that fails (`unwrap_or_else(|_| g.clone())`).
fn restore(inout s: S, n: u64) -> u64 {
    let e = ChunkSeq::new[u64]();
    let r = run(inout s, in e, 8, n);
    if r == 0 { n } else { r }
}

fn restore_failure(inout s: S, f: u64) -> u64 {
    let g = field_a(in s, f);
    let g2 = restore(inout s, g);
    let r = field_b(in s, f);
    let t = tag_of(in s, r);
    let r2 = if t == r_cands() {
        let from = s.tmp.len();
        let n = kid_count(in s, r);
        for i in 0..n {
            let c = kid(in s, r, i);
            let cause = field_b(in s, c);
            let cause2 = if tag_of(in s, cause) == c_nested() {
                let inner = field_a(in s, cause);
                let inner2 = restore_failure(inout s, inner);
                intern1(inout s, c_nested(), inner2)
            } else {
                cause
            };
            let source = field_a(in s, c);
            let c2 = intern2(inout s, cf_node(), source, cause2);
            s.tmp.push(c2);
        }
        intern_with_kids(inout s, r_cands(), 0, 0, 0, from)
    } else if t == r_mode() {
        let a = field_a(in s, r);
        let b = field_b(in s, r);
        let a2 = restore(inout s, a);
        let b2 = restore(inout s, b);
        intern2(inout s, r_mode(), a2, b2)
    } else {
        r
    };
    intern2(inout s, f_node(), g2, r2)
}

fn restore_outcome(inout s: S, o: u64, origin: u64) -> u64 {
    let saved = s.fsub;
    s.fsub = origin;
    let t = tag_of(in s, o);
    let a = field_a(in s, o);
    let r = if t == q_proven() {
        let vals = field_b(in s, o);
        let from = s.tmp.len();
        let n = kid_count(in s, vals);
        for i in 0..n {
            let v = kid(in s, vals, i);
            let v2 = restore(inout s, v);
            s.tmp.push(v2);
        }
        let vals2 = intern_with_kids(inout s, k_list(), 0, 0, 0, from);
        let d = field_c(in s, o);
        let d2 = restore(inout s, d);
        intern(inout s, q_proven(), a, vals2, d2)
    } else if t == q_nosol() {
        let f = restore_failure(inout s, a);
        intern1(inout s, q_nosol(), f)
    } else if t == q_ambig() && tag_of(in s, a) == am_stalled() {
        let g = field_a(in s, a);
        let g2 = restore(inout s, g);
        let am = intern1(inout s, am_stalled(), g2);
        intern1(inout s, q_ambig(), am)
    } else if t == q_unsup() && tag_of(in s, a) == un_mixed() {
        let g = field_a(in s, a);
        let g2 = restore(inout s, g);
        let un = intern1(inout s, un_mixed(), g2);
        intern1(inout s, q_unsup(), un)
    } else {
        o
    };
    s.fsub = saved;
    r
}

// Solves one query: the restored outcome (an answer node), or 0 when the
// query is rejected (sorted diagnostics from the base it had on entry).
pub fn solve_query(inout s: S, maj: u64, min: u64, env: u64, binders: u64, goal: u64) -> u64 {
    if !validate_query(inout s, maj, min, env, binders, goal) {
        return 0;
    }
    s.steps = 0;
    if !canon_placeholders(inout s, env, goal) {
        let k = s.dkey;
        let r = intern1(inout s, un_dup(), k);
        return intern1(inout s, q_unsup(), r);
    }
    let cenv = s.cenv;
    let cgoal = s.cgoal;
    let origin = s.corigin;
    let mut cx = ChunkSeq::new[u64]();
    let vars = fresh_args(inout s, inout cx, binders);
    let from = s.tmp.len();
    s.tmp.push(cgoal);
    let goals = intern_with_kids(inout s, k_list(), 0, 0, 0, from);
    let r = drive(inout s, cenv, inout cx, goals);
    let outcome = if tag_of(in s, r) == k_list() {
        let d = kid(in s, r, 0);
        make_response(inout s, in cx, vars, d)
    } else {
        r
    };
    restore_outcome(inout s, outcome, origin)
}
