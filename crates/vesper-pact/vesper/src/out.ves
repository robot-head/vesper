// Module out of @vesper/pact (see lib.ves): result words for src/port.rs.
//
// Terms use the input encoding (program.ves). Then:
//
//   outcome     0 n kind* n arg* derivation coinductive | 1 ambiguity
//               | 2 failure | 3 reason | 4 overflow_kind
//   ambiguity   0 self | 1 n source* | 2 n model* | 3 mode | 4 noninjective
//               | 5 goal (stalled)
//   reason      0 label_key | 1 goal (mixed cycle) | 2 code has_goal [goal]
//   failure     goal (0 | 1 n (source cause)* | 2 mode mode | 3 model | 4)
//   cause       0 failure | 1
//   derivation  goal step n derivation*
//   step        0 source n arg* | 1 index | 2 bound | 3 source k n arg*
//               | 4 index | 5 | 6 | 7 | 8
//   diagnostics n (code sv sa sb off len)*     text in txt
//   env         n (kind bound)* n goal* n (n model*)*
use self::{S};
use self::term::{
    am_mode, am_multi, am_noninj, am_scoped, am_self, b_canon, c_nested, field_a, field_b, field_c,
    g_impl, g_mode, g_peq, g_row, inc, kid, kid_count, l_eff, none, q_ambig, q_nosol, q_proven,
    q_unsup, r_cands, r_mode, r_modelmis, r_nocand, st_alias, st_assume, st_cohyp, st_conf,
    st_passume, st_pconf, sub, t_ctor, t_proj, tag_of, un_dup, un_mixed, word_at
};

pub fn w(inout s: S, x: u64) {
    s.out.push(x);
}

fn w_kids(inout s: S, n: u64) {
    let len = kid_count(in s, n);
    w(inout s, len);
    for i in 0..len {
        let k = kid(in s, n, i);
        w_term(inout s, k);
    }
}

pub fn w_slist(inout s: S, n: u64) {
    let len = kid_count(in s, n);
    w(inout s, len);
    for i in 0..len {
        let k = kid(in s, n, i);
        w(inout s, k);
    }
}

pub fn w_tref(inout s: S, n: u64) {
    let h21 = field_a(in s, n);
    w(inout s, h21);
    let st = field_b(in s, n);
    w_term(inout s, st);
    w_kids(inout s, n);
}

pub fn w_term(inout s: S, n: u64) {
    let t = tag_of(in s, n);
    let a = field_a(in s, n);
    let b = field_b(in s, n);
    if t == t_ctor() || t == l_eff() {
        w(inout s, t);
        w(inout s, a);
        w_kids(inout s, n);
    } else if t == t_proj() {
        w(inout s, 3);
        w_tref(inout s, a);
        w_term(inout s, b);
        let h20 = field_c(in s, n);
        w(inout s, h20);
    } else if t == g_row() {
        w(inout s, 6);
        w_kids(inout s, n);
        w(inout s, a);
    } else if t == b_canon() {
        w(inout s, 7);
    } else if t == g_impl() {
        w(inout s, 14);
        w_tref(inout s, a);
        w_term(inout s, b);
    } else if t == g_peq() {
        w(inout s, 15);
        let tr = field_a(in s, a);
        w_tref(inout s, tr);
        let pb = field_b(in s, a);
        w_term(inout s, pb);
        let h19 = field_c(in s, a);
        w(inout s, h19);
        w_term(inout s, b);
    } else if t == g_mode() {
        w(inout s, 16);
        w_term(inout s, a);
        w_term(inout s, b);
    } else {
        w(inout s, t);
        w(inout s, a);
    }
}

pub fn w_der(inout s: S, d: u64) {
    let g = field_a(in s, d);
    w_term(inout s, g);
    let st = field_b(in s, d);
    let t = tag_of(in s, st);
    if t == st_conf() {
        w(inout s, 0);
        let h18 = field_a(in s, st);
        w(inout s, h18);
        w_kids(inout s, st);
    } else if t == st_pconf() {
        w(inout s, 3);
        let h17 = field_a(in s, st);
        w(inout s, h17);
        let h16 = field_b(in s, st);
        w(inout s, h16);
        w_kids(inout s, st);
    } else if t == st_assume() || t == st_alias() || t == st_passume() {
        let code: u64 = if t == st_assume() {
            1
        } else if t == st_alias() {
            2
        } else {
            4
        };
        w(inout s, code);
        let h15 = field_a(in s, st);
        w(inout s, h15);
    } else {
        w(inout s, sub(t, 18));
    }
    let len = kid_count(in s, d);
    w(inout s, len);
    for i in 0..len {
        let c = kid(in s, d, i);
        w_der(inout s, c);
    }
}

pub fn w_failure(inout s: S, f: u64) {
    let g = field_a(in s, f);
    w_term(inout s, g);
    let r = field_b(in s, f);
    let t = tag_of(in s, r);
    if t == r_nocand() {
        w(inout s, 0);
    } else if t == r_cands() {
        w(inout s, 1);
        let n = kid_count(in s, r);
        w(inout s, n);
        for i in 0..n {
            let c = kid(in s, r, i);
            let h14 = field_a(in s, c);
            w(inout s, h14);
            let cause = field_b(in s, c);
            if tag_of(in s, cause) == c_nested() {
                w(inout s, 0);
                let inner = field_a(in s, cause);
                w_failure(inout s, inner);
            } else {
                w(inout s, 1);
            }
        }
    } else if t == r_mode() {
        w(inout s, 2);
        let a = field_a(in s, r);
        w_term(inout s, a);
        let b = field_b(in s, r);
        w_term(inout s, b);
    } else if t == r_modelmis() {
        w(inout s, 3);
        let h13 = field_a(in s, r);
        w(inout s, h13);
    } else {
        w(inout s, 4);
    }
}

// Whether a derivation closes a coinductive cycle.
pub fn uses_coinduction(in s: S, d: u64) -> bool {
    if tag_of(in s, field_b(in s, d)) == st_cohyp() {
        return true;
    }
    let n = kid_count(in s, d);
    let mut i: u64 = 0;
    loop {
        if i >= n {
            return false;
        }
        if uses_coinduction(in s, kid(in s, d, i)) {
            return true;
        }
        i = inc(i);
    }
}

// Writes an outcome (a restored answer node).
pub fn w_outcome(inout s: S, o: u64) {
    let t = tag_of(in s, o);
    let a = field_a(in s, o);
    if t == q_proven() {
        w(inout s, 0);
        w_slist(inout s, a);
        let vals = field_b(in s, o);
        w_kids(inout s, vals);
        let d = field_c(in s, o);
        w_der(inout s, d);
        let co: u64 = if uses_coinduction(in s, d) {
            1
        } else {
            0
        };
        w(inout s, co);
    } else if t == q_ambig() {
        w(inout s, 1);
        let at = tag_of(in s, a);
        if at == am_self() {
            w(inout s, 0);
        } else if at == am_multi() || at == am_scoped() {
            w(
                inout s,
                if at == am_multi() {
                    1
                } else {
                    2
                }
            );
            let l = field_a(in s, a);
            w_slist(inout s, l);
        } else if at == am_mode() {
            w(inout s, 3);
        } else if at == am_noninj() {
            w(inout s, 4);
        } else {
            w(inout s, 5);
            let g = field_a(in s, a);
            w_term(inout s, g);
        }
    } else if t == q_nosol() {
        w(inout s, 2);
        w_failure(inout s, a);
    } else if t == q_unsup() {
        w(inout s, 3);
        let rt = tag_of(in s, a);
        if rt == un_dup() {
            w(inout s, 0);
            let h12 = field_a(in s, a);
            w(inout s, h12);
        } else if rt == un_mixed() {
            w(inout s, 1);
            let g = field_a(in s, a);
            w_term(inout s, g);
        } else {
            w(inout s, 2);
            let h11 = field_a(in s, a);
            w(inout s, h11);
            let g = field_b(in s, a);
            if g == none() {
                w(inout s, 0);
            } else {
                w(inout s, 1);
                w_term(inout s, g);
            }
        }
    } else {
        w(inout s, 4);
        w(inout s, a);
    }
}

// Writes the diagnostics from base on.
pub fn w_diags(inout s: S, base: u64) {
    let n = s.dg_code.len();
    let cnt = sub(n, base);
    w(inout s, cnt);
    for i in base..n {
        let h10 = word_at(in s.dg_code, i);
        w(inout s, h10);
        let h9 = word_at(in s.dg_sv, i);
        w(inout s, h9);
        let h8 = word_at(in s.dg_sa, i);
        w(inout s, h8);
        let h7 = word_at(in s.dg_sb, i);
        w(inout s, h7);
        let h6 = word_at(in s.dg_off, i);
        w(inout s, h6);
        let h5 = word_at(in s.dg_len, i);
        w(inout s, h5);
    }
}

pub fn w_env(inout s: S, e: u64) {
    let phs = field_a(in s, e);
    let n = kid_count(in s, phs);
    w(inout s, n);
    let mut i: u64 = 0;
    loop {
        if i >= n {
            break;
        }
        let p = kid(in s, phs, i);
        let h4 = field_a(in s, p);
        w(inout s, h4);
        let h3 = field_b(in s, p);
        w(inout s, h3);
        i = inc(i);
    }
    let asm = field_b(in s, e);
    w_kids(inout s, asm);
    let sc = field_c(in s, e);
    let ns = kid_count(in s, sc);
    w(inout s, ns);
    i = 0;
    loop {
        if i >= ns {
            break;
        }
        let l = kid(in s, sc, i);
        w_slist(inout s, l);
        i = inc(i);
    }
}
