// Module coherence of @vesper/pact (see lib.ves): `coherence.rs`, the
// orphan rule, overlap of canonical impl heads and well-formedness of
// impls and models. Conformance c is row c of the cf_* tables: impls
// first (c = impl id), then models (c = nimpl + model id).
use self::{S};
use self::term::{
    add, byte_at, e_env, e_ph, field_a, field_b, g_impl, g_mode, inc, intern, intern2,
    intern_with_kids, k_list, k_slist, kid, kid_count, m_const, none, q_ambig, q_nosol, q_proven,
    q_unsup, sub, t_ctor, t_proj, t_ref, t_var, tag_of, vidx, vkind, word_at
};
use self::fold::{inst, run};
use self::infer::{fresh_args, unify_trait_ref};
use self::render::{byte, d_label_key, lit, num, r_failure, r_goal, r_id, r_ty, r_var};
use self::diag::{emit, render_diags, sort_diags, truncate_diags};
use self::query::{reset_solver, solve_query};

// Coherence checks run with the default solver limits, as in the Rust `SolverConfig::default()`. The
// depth bound keeps recursion within a 2 MiB thread stack.
const DEFAULT_MAX_DEPTH: u64 = 48;
const DEFAULT_MAX_STEPS: u64 = 100000;
const DEFAULT_MAX_FIX: u64 = 16;

// ASCII bytes.
const TAB: u8 = 9;
const CR: u8 = 13;
const SPACE: u8 = 32;

// `check_orphan`: true when legal; otherwise the message is appended to
// txt and false is returned. s.oob is set (and false returned) when the
// trait or a type constructor reached is not declared, where the Rust
// build panics; validated programs never reach it.
pub fn orphan(inout s: S, c: u64) -> bool {
    let tr = word_at(in s.cf_tref, c);
    let t = field_a(in s, tr);
    let pkg = word_at(in s.cf_pkg, c);
    if t >= s.tr_id.len() {
        s.oob = true;
        return false;
    }
    if word_at(in s.tr_pkg, t) == pkg {
        return true;
    }
    let n = kid_count(in s, tr);
    let mut pos: u64 = 0;
    let mut i: u64 = 0;
    loop {
        // Position 0 is Self; then the type arguments in order.
        if i > n {
            break;
        }
        let ty = if i == 0 {
            field_b(in s, tr)
        } else {
            kid(in s, tr, sub(i, 1))
        };
        i = inc(i);
        let k = tag_of(in s, ty);
        if k == t_ctor() {
            if field_a(in s, ty) >= s.ct_id.len() {
                s.oob = true;
                return false;
            }
            if word_at(in s.ct_pkg, field_a(in s, ty)) == pkg {
                return true;
            }
            pos = inc(pos);
        } else if k == t_var() {
            lit(inout s, "orphan canonical impl: uncovered parameter ");
            let h1 = field_a(in s, ty);
            r_var(inout s, h1);
            lit(inout s, " at type position ");
            num(inout s, pos);
            lit(inout s, " precedes any local type; declare a named `model` instead");
            return false;
        } else if k == t_proj() {
            lit(inout s, "projection in impl head");
            return false;
        }
    }
    lit(inout s, "orphan canonical impl: neither ");
    r_id(inout s, "trait", t);
    lit(inout s, " nor any type argument is defined in ");
    r_id(inout s, "pkg", pkg);
    lit(inout s, "; declare a named `model` instead");
    false
}

// `heads_unify`: 0 disjoint, 1 overlapping, 2 undecidable (the message
// appended to txt).
fn heads_unify(inout s: S, a: u64, b: u64) -> u64 {
    let mut cx = ChunkSeq::new[u64]();
    let pa = word_at(in s.cf_params, a);
    let pb = word_at(in s.cf_params, b);
    let aa = fresh_args(inout s, inout cx, pa);
    let ba = fresh_args(inout s, inout cx, pb);
    let ta = word_at(in s.cf_tref, a);
    let ha = inst(inout s, ta, aa);
    if ha == 0 {
        lit(inout s, "duplicate label ");
        let k = s.dkey;
        d_label_key(inout s, k);
        return 2;
    }
    let tb = word_at(in s.cf_tref, b);
    let hb = inst(inout s, tb, ba);
    if hb == 0 {
        lit(inout s, "duplicate label ");
        let k = s.dkey;
        d_label_key(inout s, k);
        return 2;
    }
    let r = unify_trait_ref(inout s, inout cx, ha, hb);
    if r == 0 {
        1
    } else if r == 1 {
        0
    } else if r == 2 {
        lit(inout s, "cannot decide overlap of projection heads");
        2
    } else {
        lit(inout s, "cannot decide overlap: rows merge duplicate label ");
        let k = s.dkey;
        d_label_key(inout s, k);
        2
    }
}

// `conformance_env` of conformance c: an e_env node. s.oob is set when a
// mode bound names a parameter c does not declare.
pub fn conformance_env(inout s: S, c: u64) -> u64 {
    let params = word_at(in s.cf_params, c);
    let np = kid_count(in s, params);
    let mut bounds = ChunkSeq::new[u64]();
    let mut i: u64 = 0;
    loop {
        if i >= np {
            break;
        }
        bounds.push(none());
        i = inc(i);
    }
    let wh = word_at(in s.cf_where, c);
    let nw = kid_count(in s, wh);
    let e = ChunkSeq::new[u64]();
    let from = s.tmp.len();
    i = 0;
    loop {
        if i >= nw {
            break;
        }
        let w = kid(in s, wh, i);
        if tag_of(in s, w) == g_mode() {
            let ty = field_a(in s, w);
            let bd = field_b(in s, w);
            if tag_of(in s, ty) == t_var()
                && vkind(field_a(in s, ty)) == 0
                && tag_of(in s, bd) == m_const() {
                let p = vidx(field_a(in s, ty));
                if p >= np {
                    // The Rust build panics on an out-of-range parameter.
                    s.oob = true;
                }
                let m = field_a(in s, bd);
                let old = word_at(in bounds, p);
                let nb = if old == none() || m < old {
                    m
                } else {
                    old
                };
                let _ = bounds.try_set(p, nb);
            }
        } else {
            let g = run(inout s, in e, 5, w);
            if g != 0 {
                s.tmp.push(g);
            }
        }
        i = inc(i);
    }
    let asm = intern_with_kids(inout s, k_list(), 0, 0, 0, from);
    let f2 = s.tmp.len();
    i = 0;
    loop {
        if i >= np {
            break;
        }
        let k = kid(in s, params, i);
        let b = word_at(in bounds, i);
        let p = intern2(inout s, e_ph(), k, b);
        s.tmp.push(p);
        i = inc(i);
    }
    let phs = intern_with_kids(inout s, k_list(), 0, 0, 0, f2);
    let f3 = s.tmp.len();
    let scopes = intern_with_kids(inout s, k_list(), 0, 0, 0, f3);
    intern(inout s, e_env(), phs, asm, scopes)
}

fn is_space(b: u8) -> bool {
    b == SPACE || (b >= TAB && b <= CR)
}

// `trim_end` of txt[off ..].
fn trim_from(inout s: S, off: u64) {
    loop {
        let n = s.txt.len();
        if n <= off {
            return;
        }
        let b = byte_at(in s.txt, sub(n, 1));
        if !is_space(b) {
            return;
        }
        s.txt.truncate(sub(n, 1));
    }
}

fn unsupported_begin(inout s: S) -> u64 {
    let off = s.txt.len();
    lit(inout s, "cannot check well-formedness: ");
    off
}

fn unsupported_end(inout s: S, sv: u64, sa: u64, off: u64) {
    lit(inout s, "; rejected rather than skipped");
    emit(inout s, 8, sv, sa, 0, off);
}

fn assoc_idx(inout s: S, ai: u64) {
    lit(inout s, "assoc#");
    num(inout s, ai);
}

// Checks goal g of associated value ai (value `value`) under env.
fn wf_goal(inout s: S, sv: u64, sa: u64, env: u64, ai: u64, value: u64, g: u64) {
    let base = s.dg_code.len();
    let f0 = s.tmp.len();
    let binders = intern_with_kids(inout s, k_slist(), 0, 0, 0, f0);
    let o = solve_query(inout s, 0, 1, env, binders, g);
    if o != 0 && tag_of(in s, o) == q_proven() {
        return;
    }
    let off = s.txt.len();
    lit(inout s, "associated value ");
    assoc_idx(inout s, ai);
    lit(inout s, " = ");
    r_ty(inout s, value);
    lit(inout s, " must satisfy `");
    r_goal(inout s, g);
    lit(inout s, "`: ");
    if o == 0 {
        let at = s.txt.len();
        render_diags(inout s, base);
        trim_from(inout s, at);
        truncate_diags(inout s, base);
    } else {
        let t = tag_of(in s, o);
        if t == q_nosol() {
            lit(inout s, "no-solution\n");
            let at = s.txt.len();
            let f = field_a(in s, o);
            r_failure(inout s, f, 0);
            trim_from(inout s, at);
        } else if t == q_ambig() {
            lit(inout s, "ambiguous");
        } else if t == q_unsup() {
            lit(inout s, "unsupported");
        } else {
            lit(inout s, "overflow");
        }
    }
    emit(inout s, 11, sv, sa, 0, off);
}

// `well_formed` of conformance c with subject (sv, sa).
fn well_formed(inout s: S, c: u64, sv: u64, sa: u64) {
    let env = conformance_env(inout s, c);
    let e = ChunkSeq::new[u64]();
    let tr0 = word_at(in s.cf_tref, c);
    let tr = run(inout s, in e, 5, tr0);
    if tr == 0 {
        let off = unsupported_begin(inout s);
        lit(inout s, "head repeats an effect label");
        unsupported_end(inout s, sv, sa, off);
        return;
    }
    let t = field_a(in s, tr);
    let from = s.tmp.len();
    let st = field_b(in s, tr);
    s.tmp.push(st);
    let na = kid_count(in s, tr);
    for i in 0..na {
        let a = kid(in s, tr, i);
        s.tmp.push(a);
    }
    let binder = intern_with_kids(inout s, k_list(), 0, 0, 0, from);
    reset_solver(inout s);
    let vals = word_at(in s.cf_vals, c);
    let nv = kid_count(in s, vals);
    let nas = word_at(in s.tr_as_n, t);
    let at = word_at(in s.tr_as_at, t);
    let n = if nv < nas {
        nv
    } else {
        nas
    };
    let mut ai: u64 = 0;
    loop {
        if ai >= n {
            break;
        }
        let v0 = kid(in s, vals, ai);
        let value = run(inout s, in e, 5, v0);
        if value == 0 {
            let off = unsupported_begin(inout s);
            lit(inout s, "value of ");
            assoc_idx(inout s, ai);
            lit(inout s, " repeats an effect label");
            unsupported_end(inout s, sv, sa, off);
            ai = inc(ai);
        } else {
            let x = add(at, ai);
            let gf = s.tmp.len();
            let m0 = word_at(in s.as_mode, x);
            let m = inst(inout s, m0, binder);
            let g0 = intern2(inout s, g_mode(), value, m);
            s.tmp.push(g0);
            let nb = word_at(in s.as_bd_n, x);
            let bat = word_at(in s.as_bd_at, x);
            let mut bi: u64 = 0;
            loop {
                if bi >= nb {
                    break;
                }
                let y = add(bat, bi);
                let ba = word_at(in s.bd_args, y);
                let args = inst(inout s, ba, binder);
                if args == 0 {
                    let off = unsupported_begin(inout s);
                    lit(inout s, "bound ");
                    num(inout s, bi);
                    lit(inout s, " of ");
                    assoc_idx(inout s, ai);
                    lit(inout s, " repeats an effect label after substitution");
                    unsupported_end(inout s, sv, sa, off);
                    bi = inc(bi);
                } else {
                    let bt = word_at(in s.bd_trait, y);
                    let af = s.tmp.len();
                    let nargs = kid_count(in s, args);
                    for j in 0..nargs {
                        let a = kid(in s, args, j);
                        s.tmp.push(a);
                    }
                    let tref = intern_with_kids(inout s, t_ref(), bt, value, 0, af);
                    let bb = word_at(in s.bd_brand, y);
                    let brand = inst(inout s, bb, binder);
                    let g = intern2(inout s, g_impl(), tref, brand);
                    s.tmp.push(g);
                    bi = inc(bi);
                }
            }
            let goals = intern_with_kids(inout s, k_list(), 0, 0, 0, gf);
            let ng = kid_count(in s, goals);
            for k in 0..ng {
                let g = kid(in s, goals, k);
                wf_goal(inout s, sv, sa, env, ai, value, g);
            }
            ai = inc(ai);
        }
    }
}

// `check_coherence`: the sorted diagnostics from dg base on.
pub fn check_coherence(inout s: S) {
    let base = s.dg_code.len();
    let md = s.max_depth;
    let ms = s.max_steps;
    let mf = s.max_fix;
    s.max_depth = DEFAULT_MAX_DEPTH;
    s.max_steps = DEFAULT_MAX_STEPS;
    s.max_fix = DEFAULT_MAX_FIX;
    let ni = s.nimpl;
    let mut i: u64 = 0;
    loop {
        if i >= ni {
            break;
        }
        let off = s.txt.len();
        if !orphan(inout s, i) {
            let id = word_at(in s.cf_id, i);
            emit(inout s, 9, 4, id, 0, off);
        }
        i = inc(i);
    }
    let nt = s.tr_id.len();
    for t in 0..nt {
        let at = word_at(in s.ib_at, t);
        let n = word_at(in s.ib_n, t);
        for x in 0..n {
            let a = word_at(in s.ib, add(at, x));
            let mut y = inc(x);
            loop {
                if y >= n {
                    break;
                }
                let b = word_at(in s.ib, add(at, y));
                let off = s.txt.len();
                let r = heads_unify(inout s, a, b);
                let ida = word_at(in s.cf_id, a);
                let idb = word_at(in s.cf_id, b);
                if r == 1 {
                    lit(inout s, "canonical impls of ");
                    let tid = word_at(in s.tr_id, t);
                    r_id(inout s, "trait", tid);
                    lit(inout s, " overlap; declare one as a named `model`");
                    emit(inout s, 10, 5, ida, idb, off);
                } else if r == 2 {
                    emit(inout s, 8, 5, ida, idb, off);
                }
                y = inc(y);
            }
        }
    }
    i = 0;
    loop {
        if i >= ni {
            break;
        }
        let id = word_at(in s.cf_id, i);
        well_formed(inout s, i, 4, id);
        i = inc(i);
    }
    let nm = s.nmodel;
    i = 0;
    loop {
        if i >= nm {
            break;
        }
        let c = add(ni, i);
        let id = word_at(in s.cf_id, c);
        well_formed(inout s, c, 6, id);
        i = inc(i);
    }
    s.max_depth = md;
    s.max_steps = ms;
    s.max_fix = mf;
    sort_diags(inout s, base);
}
