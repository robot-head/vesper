// Module mode of @vesper/pact (see lib.ves): `mode.rs`, modal kinding of
// goal types as a join of atoms. An atom is a mode term node, or none()
// for the mode of an unresolved inference variable.
use self::{
    S
};
use self::term::{
    add,
    fa,
    fb,
    fc,
    inc,
    is_inf,
    kid,
    mk1,
    mkl,
    nlen,
    none,
    push_kids,
    sw,
    tg,
    vidx,
    vkind
};
use self::fold::{
    inst
};

// Pushes the atoms of a resolved, normalized type onto s.atoms.
pub fn mode_atoms(inout s: S, env: u64, ty: u64) {
    let t = tg(in s, ty);
    if t == 1 {
        let c = fa(in s, ty);
        let base = sw(in s.ct_base, c);
        let m = mk1(inout s, 4, base);
        s.atoms.push(m);
        let joins = sw(in s.ct_joins, c);
        let nj = nlen(in s, joins);
        let mut i: u64 = 0;
        loop {
            if i >= nj {
                break;
            }
            let j = kid(in s, joins, i);
            let a = kid(in s, ty, j);
            if tg(in s, a) <= 3 {
                mode_atoms(inout s, env, a);
            }
            i = inc(i);
        }
    } else if t == 2 {
        let v = fa(in s, ty);
        if vkind(v) == 1 {
            let phs = fa(in s, env);
            let p = kid(in s, phs, vidx(v));
            let mut b = fb(in s, p);
            if b == none() {
                b = 2;
            }
            let m = mk1(inout s, 4, b);
            s.atoms.push(m);
        } else {
            s.atoms.push(none());
        }
    } else {
        let tr = fa(in s, ty);
        let tid = fa(in s, tr);
        let at = add(sw(in s.tr_as_at, tid), fc(in s, ty));
        let mb = sw(in s.as_mode, at);
        let from = s.tmp.len();
        let st = fb(in s, tr);
        s.tmp.push(st);
        push_kids(inout s, tr);
        let binder = mkl(inout s, 27, 0, 0, 0, from);
        let b = inst(inout s, mb, binder);
        if tg(in s, b) == 5 && is_inf(fa(in s, b)) {
            s.atoms.push(none());
        } else {
            s.atoms.push(b);
        }
    }
}

// Decides `atoms[from ..] <= bound`: 0 holds, 1 fails (the atom in
// s.vatom), 2 unknown.
pub fn decide(inout s: S, from: u64, bound: u64) -> u64 {
    let lin = mk1(inout s, 4, 2);
    let n = s.atoms.len();
    let bt = tg(in s, bound);
    let bv = fa(in s, bound);
    let mut unknown = false;
    let mut i = from;
    loop {
        if i >= n {
            break;
        }
        let a = sw(in s.atoms, i);
        i = inc(i);
        if a == none() {
            if bound != lin {
                unknown = true;
            }
        } else {
            let at = tg(in s, a);
            let av = fa(in s, a);
            // 0 false, 1 true, 2 unknown
            let ok = if at == 4 && av == 0 {
                1
            } else if bound == lin {
                1
            } else if at == 4 && bt == 4 {
                if av <= bv {
                    1
                } else {
                    0
                }
            } else if (at == 5 && is_inf(av)) || (bt == 5 && is_inf(bv)) {
                2
            } else if at == 5 && bt == 5 {
                if av == bv {
                    1
                } else {
                    0
                }
            } else {
                0
            };
            if ok == 0 {
                s.vatom = a;
                return 1;
            }
            if ok == 2 {
                unknown = true;
            }
        }
    }
    if unknown {
        2
    } else {
        0
    }
}
