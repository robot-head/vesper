// Module mode of @vesper/pact (see lib.ves): `mode.rs`, modal kinding of
// goal types as a join of atoms. An atom is a mode term node, or none()
// for the mode of an unresolved inference variable.
use self::{
    S
};
use self::term::{
    add,
    field_a,
    field_b,
    field_c,
    inc,
    intern1,
    intern_with_kids,
    is_inf,
    k_list,
    kid,
    kid_count,
    m_const,
    m_var,
    none,
    push_kids,
    t_ctor,
    t_var,
    tag_of,
    vidx,
    vkind,
    word_at
};
use self::fold::{
    inst
};

// Pushes the atoms of a resolved, normalized type onto s.atoms.
pub fn mode_atoms(inout s: S, env: u64, ty: u64) {
    let t = tag_of(in s, ty);
    if t == t_ctor() {
        let c = field_a(in s, ty);
        let base = word_at(in s.ct_base, c);
        let m = intern1(inout s, m_const(), base);
        s.atoms.push(m);
        let joins = word_at(in s.ct_joins, c);
        let nj = kid_count(in s, joins);
        for i in 0..nj {
            let j = kid(in s, joins, i);
            let a = kid(in s, ty, j);
            if tag_of(in s, a) <= 3 {
                mode_atoms(inout s, env, a);
            }
        }
    } else if t == t_var() {
        let v = field_a(in s, ty);
        if vkind(v) == 1 {
            let phs = field_a(in s, env);
            let p = kid(in s, phs, vidx(v));
            let mut b = field_b(in s, p);
            if b == none() {
                b = 2;
            }
            let m = intern1(inout s, m_const(), b);
            s.atoms.push(m);
        } else {
            s.atoms.push(none());
        }
    } else {
        let tr = field_a(in s, ty);
        let tid = field_a(in s, tr);
        let at = add(word_at(in s.tr_as_at, tid), field_c(in s, ty));
        let mb = word_at(in s.as_mode, at);
        let from = s.tmp.len();
        let st = field_b(in s, tr);
        s.tmp.push(st);
        push_kids(inout s, tr);
        let binder = intern_with_kids(inout s, k_list(), 0, 0, 0, from);
        let b = inst(inout s, mb, binder);
        if tag_of(in s, b) == m_var() && is_inf(field_a(in s, b)) {
            s.atoms.push(none());
        } else {
            s.atoms.push(b);
        }
    }
}

// Decides `atoms[from ..] <= bound`: 0 holds, 1 fails (the atom in
// s.vatom), 2 unknown.
pub fn decide(inout s: S, from: u64, bound: u64) -> u64 {
    let lin = intern1(inout s, m_const(), 2);
    let n = s.atoms.len();
    let bt = tag_of(in s, bound);
    let bv = field_a(in s, bound);
    let mut unknown = false;
    let mut i = from;
    loop {
        if i >= n {
            break;
        }
        let a = word_at(in s.atoms, i);
        i = inc(i);
        if a == none() {
            if bound != lin {
                unknown = true;
            }
        } else {
            let at = tag_of(in s, a);
            let av = field_a(in s, a);
            // 0 false, 1 true, 2 unknown
            let ok = if at == m_const() && av == 0 {
                1
            } else if bound == lin {
                1
            } else if at == m_const() && bt == m_const() {
                if av <= bv {
                    1
                } else {
                    0
                }
            } else if (at == m_var() && is_inf(av)) || (bt == m_var() && is_inf(bv)) {
                2
            } else if at == m_var() && bt == m_var() {
                if av == bv {
                    1
                } else {
                    0
                }
            } else {
                0
            };
            if ok == 0 {
                s.vatom = a;
                return 1;
            }
            if ok == 2 {
                unknown = true;
            }
        }
    }
    if unknown {
        2
    } else {
        0
    }
}
