// Module render of @vesper/pact (see lib.ves): the deterministic `Display`
// renderings of `term.rs`, `solver.rs` and `diag.rs`, and the `Debug`
// renderings that diagnostics quote, appended to `s.txt`.
use self::{
    S
};
use self::term::{
    b_canon,
    b_named,
    b_var,
    c_nested,
    dec,
    field_a,
    field_b,
    field_c,
    g_impl,
    g_peq,
    g_row,
    inc,
    kid,
    kid_count,
    l_eff,
    m_const,
    m_var,
    none,
    r_indcyc,
    r_modelmis,
    r_nocand,
    st_alias,
    st_assume,
    st_conf,
    st_mode,
    st_norm,
    st_passume,
    st_pconf,
    st_rigid,
    t_ctor,
    t_proj,
    t_var,
    tag_of,
    vidx,
    vkind
};

// ASCII bytes.
const NEWLINE: u8 = 10;
const SPACE: u8 = 32;
const BANG: u8 = 33;
const HASH: u8 = 35;
const RPAREN: u8 = 41;
const LT: u8 = 60;
const QUESTION: u8 = 63;
const LBRACKET: u8 = 91;
const RBRACKET: u8 = 93;
const CARET: u8 = 94;
const BACKTICK: u8 = 96;

// term.ves `r_mode()`: this module's own `r_mode` renders a mode.
const R_MODE_TAG: u64 = 46;

pub fn lit(inout s: S, in t: Str) {
    for i in 0..t.len() {
        match t.try_byte_at(i) {
            Option::Some(b) => s.txt.push(b),
            Option::None => (),
        }
    }
}

pub fn byte(inout s: S, b: u8) {
    s.txt.push(b);
}

pub fn num(inout s: S, x: u64) {
    if x >= 10 {
        num(inout s, x / 10);
    }
    let d = wrapping_sub(x, wrapping_mul(x / 10, 10));
    s.txt.push(wrapping_u8(wrapping_add(d, 48)));
}

pub fn r_var(inout s: S, v: u64) {
    let k = vkind(v);
    if k == 0 {
        byte(inout s, CARET);
    } else if k == 1 {
        byte(inout s, BANG);
    } else {
        byte(inout s, QUESTION);
    }
    num(inout s, vidx(v));
}

pub fn r_mode_const(inout s: S, m: u64) {
    if m == 0 {
        lit(inout s, "copy");
    } else if m == 1 {
        lit(inout s, "affine");
    } else {
        lit(inout s, "linear");
    }
}

pub fn r_kind_debug(inout s: S, k: u64) {
    if k == 0 {
        lit(inout s, "Type");
    } else if k == 1 {
        lit(inout s, "Mode");
    } else if k == 2 {
        lit(inout s, "Row");
    } else if k == 3 {
        lit(inout s, "Brand");
    } else {
        lit(inout s, "Capability");
    }
}

pub fn r_id(inout s: S, in prefix: Str, x: u64) {
    lit(inout s, prefix);
    byte(inout s, HASH);
    num(inout s, x);
}

// Renders the kids of n from index `from` as a comma-separated argument
// list.
fn r_args_from(inout s: S, n: u64, from: u64) {
    let len = kid_count(in s, n);
    for i in from..len {
        if i > from {
            lit(inout s, ", ");
        }
        let k = kid(in s, n, i);
        r_arg(inout s, k);
    }
}

// `[args]` when there are any.
fn r_bracket_args(inout s: S, n: u64) {
    if kid_count(in s, n) > 0 {
        byte(inout s, LBRACKET);
        r_args_from(inout s, n, 0);
        byte(inout s, RBRACKET);
    }
}

pub fn r_mode(inout s: S, n: u64) {
    if tag_of(in s, n) == m_const() {
        let h51 = field_a(in s, n);
        r_mode_const(inout s, h51);
    } else {
        let h50 = field_a(in s, n);
        r_var(inout s, h50);
    }
}

pub fn r_brand(inout s: S, n: u64) {
    let t = tag_of(in s, n);
    if t == b_canon() {
        lit(inout s, "canonical");
    } else if t == b_named() {
        let h49 = field_a(in s, n);
        r_id(inout s, "model", h49);
    } else {
        let h48 = field_a(in s, n);
        r_var(inout s, h48);
    }
}

pub fn r_label(inout s: S, l: u64) {
    if tag_of(in s, l) == l_eff() {
        let h47 = field_a(in s, l);
        r_id(inout s, "effect", h47);
        r_bracket_args(inout s, l);
    } else {
        lit(inout s, "cap ");
        let h46 = field_a(in s, l);
        r_var(inout s, h46);
    }
}

pub fn r_row(inout s: S, n: u64) {
    lit(inout s, "eff [");
    let len = kid_count(in s, n);
    for i in 0..len {
        if i > 0 {
            lit(inout s, ", ");
        }
        let l = kid(in s, n, i);
        r_label(inout s, l);
    }
    let t = field_a(in s, n);
    if t != none() {
        if len > 0 {
            byte(inout s, SPACE);
        }
        lit(inout s, "| ");
        r_var(inout s, t);
    }
    byte(inout s, RBRACKET);
}

pub fn r_trait_ref(inout s: S, n: u64) {
    let st = field_b(in s, n);
    r_ty(inout s, st);
    lit(inout s, ": ");
    let h45 = field_a(in s, n);
    r_id(inout s, "trait", h45);
    r_bracket_args(inout s, n);
}

pub fn r_proj(inout s: S, n: u64) {
    byte(inout s, LT);
    let t = field_a(in s, n);
    r_trait_ref(inout s, t);
    lit(inout s, " via ");
    let b = field_b(in s, n);
    r_brand(inout s, b);
    lit(inout s, ">::");
    let h44 = field_c(in s, n);
    r_id(inout s, "assoc", h44);
}

pub fn r_ty(inout s: S, n: u64) {
    let t = tag_of(in s, n);
    if t == t_ctor() {
        let h43 = field_a(in s, n);
        r_id(inout s, "type", h43);
        r_bracket_args(inout s, n);
    } else if t == t_var() {
        let h42 = field_a(in s, n);
        r_var(inout s, h42);
    } else {
        r_proj(inout s, n);
    }
}

// `GenericArg` Display.
pub fn r_arg(inout s: S, n: u64) {
    let t = tag_of(in s, n);
    if t <= t_proj() {
        r_ty(inout s, n);
    } else if t <= m_var() {
        lit(inout s, "mod ");
        r_mode(inout s, n);
    } else if t == g_row() {
        r_row(inout s, n);
    } else if t <= b_var() {
        lit(inout s, "brand ");
        r_brand(inout s, n);
    } else {
        lit(inout s, "cap ");
        let h41 = field_a(in s, n);
        r_var(inout s, h41);
    }
}

pub fn r_goal(inout s: S, n: u64) {
    let t = tag_of(in s, n);
    let a = field_a(in s, n);
    let b = field_b(in s, n);
    if t == g_impl() {
        r_trait_ref(inout s, a);
        lit(inout s, " via ");
        r_brand(inout s, b);
    } else if t == g_peq() {
        r_proj(inout s, a);
        lit(inout s, " == ");
        r_ty(inout s, b);
    } else {
        lit(inout s, "mode(");
        r_ty(inout s, a);
        lit(inout s, ") <= ");
        r_mode(inout s, b);
    }
}

// ---------------------------------------------------------------------------
// Debug renderings.

pub fn d_var(inout s: S, v: u64) {
    let k = vkind(v);
    if k == 0 {
        lit(inout s, "Bound(");
    } else if k == 1 {
        lit(inout s, "Placeholder(");
    } else {
        lit(inout s, "Infer(");
    }
    num(inout s, vidx(v));
    byte(inout s, RPAREN);
}

// `LabelKey` Debug.
pub fn d_label_key(inout s: S, k: u64) {
    if k < 17179869184 {
        lit(inout s, "Effect(EffectId(");
        num(inout s, k);
        lit(inout s, "))");
    } else {
        lit(inout s, "Capability(");
        let v = wrapping_sub(k, 17179869184);
        d_var(inout s, v);
        byte(inout s, RPAREN);
    }
}

fn d_list(inout s: S, n: u64) {
    byte(inout s, LBRACKET);
    let len = kid_count(in s, n);
    for i in 0..len {
        if i > 0 {
            lit(inout s, ", ");
        }
        let k = kid(in s, n, i);
        d_arg(inout s, k);
    }
    byte(inout s, RBRACKET);
}

fn d_mode_term(inout s: S, n: u64) {
    if tag_of(in s, n) == m_const() {
        lit(inout s, "Const(");
        let m = field_a(in s, n);
        if m == 0 {
            lit(inout s, "Copy");
        } else if m == 1 {
            lit(inout s, "Affine");
        } else {
            lit(inout s, "Linear");
        }
        byte(inout s, RPAREN);
    } else {
        lit(inout s, "Var(");
        let h40 = field_a(in s, n);
        d_var(inout s, h40);
        byte(inout s, RPAREN);
    }
}

fn d_brand(inout s: S, n: u64) {
    let t = tag_of(in s, n);
    if t == b_canon() {
        lit(inout s, "Canonical");
    } else if t == b_named() {
        lit(inout s, "Named(ModelId(");
        let h39 = field_a(in s, n);
        num(inout s, h39);
        lit(inout s, "))");
    } else {
        lit(inout s, "Var(");
        let h38 = field_a(in s, n);
        d_var(inout s, h38);
        byte(inout s, RPAREN);
    }
}

fn d_trait_ref(inout s: S, n: u64) {
    lit(inout s, "TraitRef { trait_id: TraitId(");
    let h37 = field_a(in s, n);
    num(inout s, h37);
    lit(inout s, "), self_ty: ");
    let st = field_b(in s, n);
    d_ty(inout s, st);
    lit(inout s, ", args: ");
    d_list(inout s, n);
    lit(inout s, " }");
}

fn d_ty(inout s: S, n: u64) {
    let t = tag_of(in s, n);
    if t == t_ctor() {
        lit(inout s, "Ctor { ctor: TypeCtorId(");
        let h36 = field_a(in s, n);
        num(inout s, h36);
        lit(inout s, "), args: ");
        d_list(inout s, n);
        lit(inout s, " }");
    } else if t == t_var() {
        lit(inout s, "Var(");
        let h35 = field_a(in s, n);
        d_var(inout s, h35);
        byte(inout s, RPAREN);
    } else {
        lit(inout s, "Projection(Projection { trait_ref: ");
        let tr = field_a(in s, n);
        d_trait_ref(inout s, tr);
        lit(inout s, ", brand: ");
        let b = field_b(in s, n);
        d_brand(inout s, b);
        lit(inout s, ", assoc: AssocIdx(");
        let h34 = field_c(in s, n);
        num(inout s, h34);
        lit(inout s, ") })");
    }
}

fn d_row(inout s: S, n: u64) {
    lit(inout s, "EffectRow { labels: [");
    let len = kid_count(in s, n);
    for i in 0..len {
        if i > 0 {
            lit(inout s, ", ");
        }
        let l = kid(in s, n, i);
        if tag_of(in s, l) == l_eff() {
            lit(inout s, "Effect { effect: EffectId(");
            let h33 = field_a(in s, l);
            num(inout s, h33);
            lit(inout s, "), args: ");
            d_list(inout s, l);
            lit(inout s, " }");
        } else {
            lit(inout s, "Capability(");
            let h32 = field_a(in s, l);
            d_var(inout s, h32);
            byte(inout s, RPAREN);
        }
    }
    lit(inout s, "], tail: ");
    let t = field_a(in s, n);
    if t == none() {
        lit(inout s, "None");
    } else {
        lit(inout s, "Some(");
        d_var(inout s, t);
        byte(inout s, RPAREN);
    }
    lit(inout s, " }");
}

// `GenericArg` Debug.
pub fn d_arg(inout s: S, n: u64) {
    let t = tag_of(in s, n);
    if t <= t_proj() {
        lit(inout s, "Ty(");
        d_ty(inout s, n);
    } else if t <= m_var() {
        lit(inout s, "Mode(");
        d_mode_term(inout s, n);
    } else if t == g_row() {
        lit(inout s, "Row(");
        d_row(inout s, n);
    } else if t <= b_var() {
        lit(inout s, "Brand(");
        d_brand(inout s, n);
    } else {
        lit(inout s, "Capability(");
        let h31 = field_a(in s, n);
        d_var(inout s, h31);
    }
    byte(inout s, RPAREN);
}

fn d_source(inout s: S, src: u64) {
    if (src & 1) == 0 {
        lit(inout s, "Impl(ImplId(");
    } else {
        lit(inout s, "Model(ModelId(");
    }
    num(inout s, src >> 1);
    lit(inout s, "))");
}

// `Step` Debug.
pub fn d_step(inout s: S, n: u64) {
    let t = tag_of(in s, n);
    if t == st_conf() {
        lit(inout s, "Conformance { source: ");
        let h30 = field_a(in s, n);
        d_source(inout s, h30);
        lit(inout s, ", args: ");
        d_list(inout s, n);
        lit(inout s, " }");
    } else if t == st_assume() {
        lit(inout s, "Assumption { index: ");
        let h29 = field_a(in s, n);
        num(inout s, h29);
        lit(inout s, " }");
    } else if t == st_alias() {
        lit(inout s, "AliasBound { bound: ");
        let h28 = field_a(in s, n);
        num(inout s, h28);
        lit(inout s, " }");
    } else if t == st_pconf() {
        lit(inout s, "ProjectionConformance { source: ");
        let h27 = field_a(in s, n);
        d_source(inout s, h27);
        lit(inout s, ", args: ");
        d_list(inout s, n);
        lit(inout s, ", value_normalizations: ");
        let h26 = field_b(in s, n);
        num(inout s, h26);
        lit(inout s, " }");
    } else if t == st_passume() {
        lit(inout s, "ProjectionAssumption { index: ");
        let h25 = field_a(in s, n);
        num(inout s, h25);
        lit(inout s, " }");
    } else if t == st_rigid() {
        lit(inout s, "RigidProjection");
    } else if t == st_mode() {
        lit(inout s, "Mode");
    } else if t == st_norm() {
        lit(inout s, "Normalize");
    } else {
        lit(inout s, "CoinductiveHypothesis");
    }
}

// ---------------------------------------------------------------------------
// Failure::render and Derivation::render, appended to txt.

fn pad(inout s: S, depth: u64) {
    for i in 0..depth {
        lit(inout s, "  ");
    }
}

pub fn r_source(inout s: S, c: u64) {
    let v = c >> 32;
    let x = c & 4294967295;
    if v == 0 {
        r_id(inout s, "impl", x);
    } else if v == 1 {
        r_id(inout s, "model", x);
    } else if v == 2 {
        lit(inout s, "assumption ");
        num(inout s, x);
    } else if v == 3 {
        lit(inout s, "alias bound ");
        num(inout s, x);
    } else {
        lit(inout s, "rigid projection");
    }
}

fn goal_tick(inout s: S, depth: u64, g: u64) {
    pad(inout s, depth);
    byte(inout s, BACKTICK);
    r_goal(inout s, g);
    lit(inout s, "`: ");
}

pub fn r_failure(inout s: S, f: u64, depth: u64) {
    let g = field_a(in s, f);
    let r = field_b(in s, f);
    let t = tag_of(in s, r);
    goal_tick(inout s, depth, g);
    if t == r_nocand() {
        lit(inout s, "no matching impl, model or assumption\n");
    } else if t == R_MODE_TAG {
        lit(inout s, "mode ");
        let a = field_a(in s, r);
        r_mode(inout s, a);
        lit(inout s, " is not below ");
        let b = field_b(in s, r);
        r_mode(inout s, b);
        byte(inout s, NEWLINE);
    } else if t == r_modelmis() {
        let h24 = field_a(in s, r);
        r_id(inout s, "model", h24);
        lit(inout s, " does not model this trait\n");
    } else if t == r_indcyc() {
        lit(inout s, "inductive cycle without a base case\n");
    } else {
        lit(inout s, "every candidate failed\n");
        let n = kid_count(in s, r);
        for i in 0..n {
            let c = kid(in s, r, i);
            let cause = field_b(in s, c);
            pad(inout s, depth);
            lit(inout s, "  ");
            let h23 = field_a(in s, c);
            r_source(inout s, h23);
            if tag_of(in s, cause) == c_nested() {
                lit(inout s, " requires\n");
                let inner = field_a(in s, cause);
                r_failure(inout s, inner, wrapping_add(depth, 2));
            } else {
                lit(inout s, ": associated type differs\n");
            }
        }
    }
}
