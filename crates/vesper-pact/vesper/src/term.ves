// Module term of @vesper/pact (see lib.ves): the hash-consed term arena.
//
// Every term, goal, derivation, failure and answer is a node: a tag, three
// fields `a`, `b`, `c` and a list of words `kids[ls .. ls + ln]`. Nodes are
// interned, so two nodes are equal exactly when their ids are equal, and
// every comparison the Rust build makes on whole terms is one word here.
// `fl` caches which variable forms a node contains (bound, placeholder,
// inference), whether it contains a projection, and whether it contains a
// row whose labels are not strictly sorted by key; folds skip subterms
// without the forms they rewrite.
use self::{S};

// 64-bit FNV-1a offset basis and prime (node hashes).
const FNV_OFFSET: u64 = 14695981039346656037;
const FNV_PRIME: u64 = 1099511628211;
// SplitMix64's first finalizer multiplier.
const MIX_MUL: u64 = 13787848793156543929;
// Finalizer shifts.
const MIX_SHIFT_A: u64 = 29;
const MIX_SHIFT_B: u64 = 32;

pub fn none() -> u64 {
    18446744073709551615
}

pub fn inc(x: u64) -> u64 {
    wrapping_add(x, 1)
}

pub fn dec(x: u64) -> u64 {
    wrapping_sub(x, 1)
}

pub fn add(a: u64, b: u64) -> u64 {
    wrapping_add(a, b)
}

pub fn sub(a: u64, b: u64) -> u64 {
    wrapping_sub(a, b)
}

// Word `i` of `q`, or 0 past its end.
pub fn word_at(in q: ChunkSeq[u64], i: u64) -> u64 {
    match q.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

// Sets word `i` of `q` to `v`; a write past the end does nothing.
pub fn set_word(inout q: ChunkSeq[u64], i: u64, v: u64) {
    let _ = q.try_set(i, v);
}

// Word `i` of the slice `q`, or 0 past its end.
pub fn slice_word_at(in q: Slice[u64], i: u64) -> u64 {
    match q.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

// Byte `i` of `q`, or 0 past its end.
pub fn byte_at(in q: ChunkSeq[u8], i: u64) -> u8 {
    match q.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

// ---------------------------------------------------------------------------
// Tags. Type terms 1-3, mode terms 4-5, rows 6, brands 7-9, capability
// arguments 10, row labels 11-12, trait refs 13, goals 14-16.

pub fn t_ctor() -> u64 {
    1
}
pub fn t_var() -> u64 {
    2
}
pub fn t_proj() -> u64 {
    3
}
pub fn m_const() -> u64 {
    4
}
pub fn m_var() -> u64 {
    5
}
pub fn g_row() -> u64 {
    6
}
pub fn b_canon() -> u64 {
    7
}
pub fn b_named() -> u64 {
    8
}
pub fn b_var() -> u64 {
    9
}
pub fn g_cap() -> u64 {
    10
}
pub fn l_eff() -> u64 {
    11
}
pub fn l_cap() -> u64 {
    12
}
pub fn t_ref() -> u64 {
    13
}
pub fn g_impl() -> u64 {
    14
}
pub fn g_peq() -> u64 {
    15
}
pub fn g_mode() -> u64 {
    16
}
// Derivations: a = goal, b = step, kids = children.
pub fn d_node() -> u64 {
    17
}
// Steps. Conformance sources are `2 i` (impl i) or `2 m + 1` (model m).
pub fn st_conf() -> u64 {
    18
}
pub fn st_assume() -> u64 {
    19
}
pub fn st_alias() -> u64 {
    20
}
pub fn st_pconf() -> u64 {
    21
}
pub fn st_passume() -> u64 {
    22
}
pub fn st_rigid() -> u64 {
    23
}
pub fn st_mode() -> u64 {
    24
}
pub fn st_norm() -> u64 {
    25
}
pub fn st_cohyp() -> u64 {
    26
}
// A list of nodes, and a list of plain words.
pub fn k_list() -> u64 {
    27
}
pub fn k_slist() -> u64 {
    28
}
// Answers (the Rust `QResult`); a = binders (slist), b = values (list),
// c = derivation for q_proven. q_ambig, q_nosol, q_unsup and q_over are
// also the nested errors of the obligation driver.
pub fn q_proven() -> u64 {
    29
}
pub fn q_ambig() -> u64 {
    30
}
pub fn q_nosol() -> u64 {
    31
}
pub fn q_unsup() -> u64 {
    32
}
pub fn q_over() -> u64 {
    33
}
// Ambiguities.
pub fn am_self() -> u64 {
    34
}
pub fn am_multi() -> u64 {
    35
}
pub fn am_scoped() -> u64 {
    36
}
pub fn am_mode() -> u64 {
    37
}
pub fn am_noninj() -> u64 {
    38
}
pub fn am_stalled() -> u64 {
    39
}
// Unsupported reasons; un_internal a = message code, b = goal or none().
pub fn un_dup() -> u64 {
    40
}
pub fn un_mixed() -> u64 {
    41
}
pub fn un_internal() -> u64 {
    42
}
// Failures: a = goal, b = reason.
pub fn f_node() -> u64 {
    43
}
pub fn r_nocand() -> u64 {
    44
}
pub fn r_cands() -> u64 {
    45
}
pub fn r_mode() -> u64 {
    46
}
pub fn r_modelmis() -> u64 {
    47
}
pub fn r_indcyc() -> u64 {
    48
}
// Candidate failure: a = candidate source, b = cause.
pub fn cf_node() -> u64 {
    49
}
pub fn c_nested() -> u64 {
    50
}
pub fn c_value() -> u64 {
    51
}
// Candidate errors that are not nested errors.
pub fn ce_head() -> u64 {
    52
}
pub fn ce_nosol() -> u64 {
    53
}
// Placeholder declaration (a = kind, b = mode bound or none()) and
// environment (a = placeholders, b = assumptions, c = model scopes, a list
// of slists).
pub fn e_ph() -> u64 {
    54
}
pub fn e_env() -> u64 {
    55
}

// Parameter kinds, in `ParamKind` order.
pub fn kd_type() -> u64 {
    0
}
pub fn kd_mode() -> u64 {
    1
}
pub fn kd_row() -> u64 {
    2
}
pub fn kd_brand() -> u64 {
    3
}
pub fn kd_cap() -> u64 {
    4
}

// Variables: `vk << 32 | index` with vk 0 bound, 1 placeholder, 2 inference.
pub fn vbound(i: u64) -> u64 {
    i
}
pub fn vph(i: u64) -> u64 {
    4294967296 | i
}
pub fn vinf(i: u64) -> u64 {
    8589934592 | i
}
pub fn vkind(v: u64) -> u64 {
    v >> 32
}
pub fn vidx(v: u64) -> u64 {
    v & 4294967295
}
pub fn is_inf(v: u64) -> bool {
    (v >> 32) == 2
}

// Flags.
pub fn fl_bound() -> u64 {
    1
}
pub fn fl_ph() -> u64 {
    2
}
pub fn fl_inf() -> u64 {
    4
}
pub fn fl_proj() -> u64 {
    8
}
pub fn fl_rowbad() -> u64 {
    16
}

fn var_flag(v: u64) -> u64 {
    let k = v >> 32;
    if k == 0 {
        1
    } else if k == 1 {
        2
    } else {
        4
    }
}

// Which fields hold node ids: a, b, c and the kids. Var fields are
// reported by `var_field`.
const REF_A: u64 = 1;
const REF_B: u64 = 2;
const REF_C: u64 = 4;
const REF_KIDS: u64 = 8;

pub fn refs(tag: u64) -> u64 {
    if tag == t_ctor() {
        REF_KIDS
    } else if tag == t_proj() {
        REF_A | REF_B
    } else if tag == g_row() || tag == l_eff() {
        REF_KIDS
    } else if tag == t_ref() {
        REF_B | REF_KIDS
    } else if tag >= g_impl() && tag <= d_node() {
        if tag == d_node() {
            REF_A | REF_B | REF_KIDS
        } else {
            REF_A | REF_B
        }
    } else if tag == st_conf() || tag == st_pconf() || tag == k_list() || tag == r_cands() {
        REF_KIDS
    } else if tag == q_proven() {
        REF_A | REF_B | REF_C
    } else if tag >= q_ambig() && tag <= q_unsup() {
        REF_A
    } else if tag == am_stalled()
        || tag == un_mixed()
        || tag == f_node()
        || tag == c_nested()
        || tag == ce_nosol() {
        if tag == f_node() {
            REF_A | REF_B
        } else {
            REF_A
        }
    } else if tag == un_internal() || tag == cf_node() {
        REF_B
    } else if tag == r_mode() {
        REF_A | REF_B
    } else if tag == e_env() {
        REF_A | REF_B | REF_C
    } else {
        0
    }
}

// Whether field `a` is a variable.
pub fn var_field(tag: u64) -> bool {
    tag == t_var() || tag == m_var() || tag == b_var() || tag == g_cap() || tag == l_cap()
}

// The parameter kind of an argument node.
pub fn kind_of(tag: u64) -> u64 {
    if tag <= t_proj() {
        kd_type()
    } else if tag <= m_var() {
        kd_mode()
    } else if tag == g_row() {
        kd_row()
    } else if tag <= b_var() {
        kd_brand()
    } else {
        kd_cap()
    }
}

// ---------------------------------------------------------------------------
// Accessors.

// The tag, fields `a`, `b` and `c`, kid count and flags of node `n`.
pub fn tag_of(in s: S, n: u64) -> u64 {
    word_at(in s.tg, n)
}
pub fn field_a(in s: S, n: u64) -> u64 {
    word_at(in s.fa, n)
}
pub fn field_b(in s: S, n: u64) -> u64 {
    word_at(in s.fb, n)
}
pub fn field_c(in s: S, n: u64) -> u64 {
    word_at(in s.fc, n)
}
pub fn kid_count(in s: S, n: u64) -> u64 {
    word_at(in s.ln, n)
}
pub fn flags(in s: S, n: u64) -> u64 {
    word_at(in s.fl, n)
}
// Kid i of node n.
pub fn kid(in s: S, n: u64, i: u64) -> u64 {
    word_at(in s.kids, add(word_at(in s.ls, n), i))
}

// Label key: an effect id, or `1 << 34 | var` for a capability label.
pub fn label_key(in s: S, l: u64) -> u64 {
    if tag_of(in s, l) == l_eff() {
        field_a(in s, l)
    } else {
        17179869184 | field_a(in s, l)
    }
}

// ---------------------------------------------------------------------------
// Interning.

fn mix(h: u64, x: u64) -> u64 {
    wrapping_mul(h ^ x, FNV_PRIME)
}

fn finish(h: u64) -> u64 {
    let x = wrapping_mul(h ^ (h >> MIX_SHIFT_A), MIX_MUL);
    x ^ (x >> MIX_SHIFT_B)
}

fn node_flags(in s: S, tag: u64, a: u64, b: u64, c: u64, from: u64) -> u64 {
    let r = refs(tag);
    let mut f: u64 = 0;
    if var_field(tag) {
        f = var_flag(a);
    }
    if tag == t_proj() {
        f = fl_proj();
    }
    if tag == g_row() && a != none() {
        f = var_flag(a);
    }
    if (r & REF_A) != 0 {
        f = f | flags(in s, a);
    }
    if (r & REF_B) != 0 {
        f = f | flags(in s, b);
    }
    if (r & REF_C) != 0 {
        f = f | flags(in s, c);
    }
    if (r & REF_KIDS) != 0 {
        let n = s.tmp.len();
        let mut i = from;
        let mut prev: u64 = 0;
        let mut bad = false;
        loop {
            if i >= n {
                break;
            }
            let k = word_at(in s.tmp, i);
            f = f | flags(in s, k);
            if tag == g_row() {
                let key = label_key(in s, k);
                if i > from && key <= prev {
                    bad = true;
                }
                prev = key;
            }
            i = inc(i);
        }
        if bad {
            f = f | 16;
        }
    }
    f
}

fn grow(inout s: S) {
    let cap = wrapping_mul(inc(s.hmask), 2);
    s.ht.clear();
    for i in 0..cap {
        s.ht.push(0);
    }
    s.hmask = dec(cap);
    let n = s.tg.len();
    for j in 0..n {
        let mut at = word_at(in s.hs, j) & s.hmask;
        loop {
            if word_at(in s.ht, at) == 0 {
                set_word(inout s.ht, at, inc(j));
                break;
            }
            at = inc(at) & s.hmask;
        }
    }
}

// Interns the node (tag, a, b, c) whose kids are `tmp[from ..]`, and pops
// the kids off `tmp`.
pub fn intern_with_kids(inout s: S, tag: u64, a: u64, b: u64, c: u64, from: u64) -> u64 {
    let n = s.tmp.len();
    let len = sub(n, from);
    let mut h = mix(mix(mix(mix(FNV_OFFSET, tag), a), b), c);
    for i in from..n {
        h = mix(h, word_at(in s.tmp, i));
    }
    h = finish(h);
    let mut at = h & s.hmask;
    loop {
        let e = word_at(in s.ht, at);
        if e == 0 {
            break;
        }
        let m = dec(e);
        if word_at(in s.hs, m) == h
            && word_at(in s.tg, m) == tag
            && word_at(in s.fa, m) == a
            && word_at(in s.fb, m) == b
            && word_at(in s.fc, m) == c
            && word_at(in s.ln, m) == len {
            let base = word_at(in s.ls, m);
            let mut same = true;
            for j in 0..len {
                if word_at(in s.kids, add(base, j)) != word_at(in s.tmp, add(from, j)) {
                    same = false;
                    break;
                }
            }
            if same {
                s.tmp.truncate(from);
                return m;
            }
        }
        at = inc(at) & s.hmask;
    }
    let f = node_flags(in s, tag, a, b, c, from);
    let id = s.tg.len();
    s.tg.push(tag);
    s.fa.push(a);
    s.fb.push(b);
    s.fc.push(c);
    s.ls.push(s.kids.len());
    s.ln.push(len);
    s.fl.push(f);
    s.hs.push(h);
    for k in from..n {
        let w = word_at(in s.tmp, k);
        s.kids.push(w);
    }
    s.tmp.truncate(from);
    set_word(inout s.ht, at, inc(id));
    s.hcount = inc(s.hcount);
    if wrapping_mul(s.hcount, 2) > s.hmask {
        grow(inout s);
    }
    id
}

// Interns the node (tag, a, b, c) with no kids; `intern0`, `intern1` and
// `intern2` leave the trailing fields 0.
pub fn intern(inout s: S, tag: u64, a: u64, b: u64, c: u64) -> u64 {
    let from = s.tmp.len();
    intern_with_kids(inout s, tag, a, b, c, from)
}

pub fn intern0(inout s: S, tag: u64) -> u64 {
    intern(inout s, tag, 0, 0, 0)
}

pub fn intern1(inout s: S, tag: u64, a: u64) -> u64 {
    intern(inout s, tag, a, 0, 0)
}

pub fn intern2(inout s: S, tag: u64, a: u64, b: u64) -> u64 {
    intern(inout s, tag, a, b, 0)
}

// Pushes the kids of n onto tmp.
pub fn push_kids(inout s: S, n: u64) {
    let len = kid_count(in s, n);
    let base = word_at(in s.ls, n);
    for i in 0..len {
        let w = word_at(in s.kids, add(base, i));
        s.tmp.push(w);
    }
}

// The empty list and slist.
pub fn nil(inout s: S) -> u64 {
    intern0(inout s, k_list())
}

pub fn snil(inout s: S) -> u64 {
    intern0(inout s, k_slist())
}

// The bare variable of a kind as an argument node.
pub fn var_arg(inout s: S, kind: u64, v: u64) -> u64 {
    if kind == kd_type() {
        intern1(inout s, t_var(), v)
    } else if kind == kd_mode() {
        intern1(inout s, m_var(), v)
    } else if kind == kd_row() {
        intern(inout s, g_row(), v, 0, 0)
    } else if kind == kd_brand() {
        intern1(inout s, b_var(), v)
    } else {
        intern1(inout s, g_cap(), v)
    }
}

// The kind of an argument node.
pub fn arg_kind(in s: S, n: u64) -> u64 {
    kind_of(tag_of(in s, n))
}

pub fn goal_impl(inout s: S, tref: u64, brand: u64) -> u64 {
    intern2(inout s, g_impl(), tref, brand)
}

pub fn der_leaf(inout s: S, goal: u64, step: u64) -> u64 {
    intern2(inout s, d_node(), goal, step)
}

pub fn new_arena(inout s: S) {
    for i in 0..1024 {
        s.ht.push(0);
    }
    s.hmask = 1023;
    // Node 0 is a sentinel, so no real node has id 0.
    let _ = intern(inout s, 0, 0, 0, 0);
}
