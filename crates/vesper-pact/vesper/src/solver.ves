// Module solver of @vesper/pact (see lib.ves): `solver.rs`, the tabled
// canonical goal solver.
//
// Results are nodes. A canonical answer (`QResult`) is q_proven (the
// response: binders, values, derivation), q_ambig, q_nosol, q_unsup or
// q_over; the last four are also the driver's nested errors. Candidate
// errors add ce_head and ce_nosol (with the cause).
//
// Candidates. The Rust build collects `(source, Result<(InferCtxt,
// Derivation), CandErr>)` per candidate and builds each proof's canonical
// response in `combine`. Building the response reads only that
// candidate's context, so this port builds it as soon as the candidate
// succeeds and keeps `(source, response or error)` on the phase stack
// `ph_src`/`ph_val`, which needs no context per candidate. A duplicate
// label met while building it becomes the candidate's q_unsup, which
// `applies` and `combine` treat as the Rust build treats the proof whose
// response fails (it applies; `combine` returns the error in order).
//
// Goal builders. The Rust build passes `goal_of: &dyn Fn(&InferCtxt) ->
// Goal` closures that rebuild the goal with its brand resolved in the
// candidate's context. All of them are one of two shapes, so a builder is
// the goal node itself (`Implements` or `ProjectionEq`) and `goal_of`
// resolves its brand (`goal_of` below).
//
// Candidate sources are `variant << 32 | x`: 0 impl, 1 model, 2
// assumption, 3 alias bound, 4 rigid (the `CandidateSource` order).
use self::{S};
use self::term::{
    add, am_mode, am_multi, am_noninj, am_scoped, am_self, am_stalled, arg_kind, b_canon, b_named,
    b_var, c_nested, c_value, ce_head, ce_nosol, cf_node, d_node, dec, f_node, field_a, field_b,
    field_c, flags, g_impl, g_mode, g_peq, g_row, inc, intern, intern0, intern1, intern2,
    intern_with_kids, is_inf, k_list, k_slist, kid, kid_count, l_eff, none, push_kids, q_ambig,
    q_nosol, q_over, q_proven, q_unsup, r_cands, r_indcyc, r_mode, r_modelmis, r_nocand, set_word,
    st_alias, st_assume, st_cohyp, st_conf, st_mode, st_norm, st_passume, st_pconf, st_rigid, sub,
    t_ctor, t_proj, t_ref, t_var, tag_of, un_dup, un_internal, un_mixed, var_arg, vidx, vinf, vkind,
    word_at
};
use self::fold::{cn_begin, inst, resolve, run};
use self::infer::{
    clone_cx, fresh_args, new_var, unify_arg, unify_args, unify_brand, unify_trait_ref, unify_ty
};
use self::mode::{decide, mode_atoms};

// Fibonacci hashing: 2^64 / φ, rounded to odd.
const GOLDEN_GAMMA: u64 = 11400714819323198485;
// SplitMix64's first finalizer multiplier.
const MIX_MUL: u64 = 13787848793156543929;
// The cache slot is taken from the high half of the hash.
const HALF_BITS: u64 = 32;

fn src(v: u64, x: u64) -> u64 {
    (v << 32) | x
}

fn dup_err(inout s: S) -> u64 {
    let k = s.dkey;
    let r = intern1(inout s, un_dup(), k);
    intern1(inout s, q_unsup(), r)
}

// `unify_err`.
fn unify_err(inout s: S, e: u64) -> u64 {
    if e == 1 {
        intern0(inout s, ce_head())
    } else if e == 2 {
        let a = intern0(inout s, am_noninj());
        intern1(inout s, q_ambig(), a)
    } else {
        dup_err(inout s)
    }
}

// `From<NestedErr> for CandErr`.
fn nested_to_cand(inout s: S, e: u64) -> u64 {
    if tag_of(in s, e) == q_nosol() {
        let f = field_a(in s, e);
        let c = intern1(inout s, c_nested(), f);
        intern1(inout s, ce_nosol(), c)
    } else {
        e
    }
}

fn is_err(in s: S, n: u64) -> bool {
    let t = tag_of(in s, n);
    t >= q_proven() && t <= q_over() || t == ce_head() || t == ce_nosol()
}

fn bump(inout s: S) -> bool {
    s.steps = inc(s.steps);
    s.steps > s.max_steps
}

fn overflow(inout s: S, k: u64) -> u64 {
    intern1(inout s, q_over(), k)
}

// The candidate's goal: the builder with its brand resolved in cx.
fn goal_of(inout s: S, in cx: ChunkSeq[u64], g: u64) -> u64 {
    if tag_of(in s, g) == g_impl() {
        let tr = field_a(in s, g);
        let b = field_b(in s, g);
        let rb = resolve(inout s, in cx, b);
        intern2(inout s, g_impl(), tr, rb)
    } else {
        let p = field_a(in s, g);
        let ty = field_b(in s, g);
        let tr = field_a(in s, p);
        let b = field_b(in s, p);
        let assoc = field_c(in s, p);
        let rb = resolve(inout s, in cx, b);
        let np = intern(inout s, t_proj(), tr, rb, assoc);
        intern2(inout s, g_peq(), np, ty)
    }
}

// The canonical response of a proof: the query variables' values, then the
// derivation, sharing one renaming. q_proven, or q_unsup on a duplicate.
pub fn make_response(inout s: S, in cx: ChunkSeq[u64], vars: u64, d: u64) -> u64 {
    let base = s.tmp.len();
    cn_begin(inout s);
    let n = kid_count(in s, vars);
    for i in 0..n {
        let v = kid(in s, vars, i);
        let r = resolve(inout s, in cx, v);
        if r == 0 {
            s.tmp.truncate(base);
            return dup_err(inout s);
        }
        let c = run(inout s, in cx, 3, r);
        if c == 0 {
            s.tmp.truncate(base);
            return dup_err(inout s);
        }
        s.tmp.push(c);
    }
    let resolved = run(inout s, in cx, 7, d);
    if resolved == 0 {
        s.tmp.truncate(base);
        return dup_err(inout s);
    }
    let der = run(inout s, in cx, 3, resolved);
    if der == 0 {
        s.tmp.truncate(base);
        return dup_err(inout s);
    }
    let values = intern_with_kids(inout s, k_list(), 0, 0, 0, base);
    let from = s.tmp.len();
    let nb = s.cn_binders.len();
    for j in 0..nb {
        let k = word_at(in s.cn_binders, j);
        s.tmp.push(k);
    }
    let binders = intern_with_kids(inout s, k_slist(), 0, 0, 0, from);
    intern(inout s, q_proven(), binders, values, der)
}

// ---------------------------------------------------------------------------
// Eager normalization: every projection (innermost first, left to right)
// becomes a fresh variable `?v` with `ProjectionEq(p, ?v)` pushed onto out.

fn norm_args(inout s: S, inout cx: ChunkSeq[u64], n: u64, inout out: ChunkSeq[u64]) -> u64 {
    let from = s.tmp.len();
    let len = kid_count(in s, n);
    for i in 0..len {
        let a = kid(in s, n, i);
        let x = norm_arg(inout s, inout cx, a, inout out);
        s.tmp.push(x);
    }
    from
}

fn norm_arg(inout s: S, inout cx: ChunkSeq[u64], a: u64, inout out: ChunkSeq[u64]) -> u64 {
    if (flags(in s, a) & 8) == 0 {
        return a;
    }
    let t = tag_of(in s, a);
    if t <= t_proj() {
        return norm_ty(inout s, inout cx, a, inout out);
    }
    if t == g_row() {
        let from = s.tmp.len();
        let len = kid_count(in s, a);
        for i in 0..len {
            let l = kid(in s, a, i);
            if tag_of(in s, l) == l_eff() {
                let f2 = norm_args(inout s, inout cx, l, inout out);
                let e = field_a(in s, l);
                let x = intern_with_kids(inout s, l_eff(), e, 0, 0, f2);
                s.tmp.push(x);
            } else {
                s.tmp.push(l);
            }
        }
        let tail = field_a(in s, a);
        return intern_with_kids(inout s, g_row(), tail, 0, 0, from);
    }
    a
}

fn norm_tref(inout s: S, inout cx: ChunkSeq[u64], tr: u64, inout out: ChunkSeq[u64]) -> u64 {
    if (flags(in s, tr) & 8) == 0 {
        return tr;
    }
    let st = field_b(in s, tr);
    let st2 = norm_ty(inout s, inout cx, st, inout out);
    let from = norm_args(inout s, inout cx, tr, inout out);
    let t = field_a(in s, tr);
    intern_with_kids(inout s, t_ref(), t, st2, 0, from)
}

pub fn norm_ty(inout s: S, inout cx: ChunkSeq[u64], t: u64, inout out: ChunkSeq[u64]) -> u64 {
    if (flags(in s, t) & 8) == 0 {
        return t;
    }
    let tag = tag_of(in s, t);
    if tag == t_ctor() {
        let from = norm_args(inout s, inout cx, t, inout out);
        let c = field_a(in s, t);
        return intern_with_kids(inout s, t_ctor(), c, 0, 0, from);
    }
    if tag == t_proj() {
        let tr = field_a(in s, t);
        let tr2 = norm_tref(inout s, inout cx, tr, inout out);
        let b = field_b(in s, t);
        let assoc = field_c(in s, t);
        let inner = intern(inout s, t_proj(), tr2, b, assoc);
        let v = new_var(inout cx, 0);
        let tv = intern1(inout s, t_var(), v);
        let g = intern2(inout s, g_peq(), inner, tv);
        out.push(g);
        return tv;
    }
    t
}

// `normalize_goal`: 0 with s.dkey when resolving repeats a label.
fn norm_goal(inout s: S, inout cx: ChunkSeq[u64], g: u64, inout out: ChunkSeq[u64]) -> u64 {
    let g = resolve(inout s, in cx, g);
    if g == 0 {
        return 0;
    }
    if (flags(in s, g) & 8) == 0 {
        return g;
    }
    let t = tag_of(in s, g);
    let a = field_a(in s, g);
    let b = field_b(in s, g);
    if t == g_impl() {
        let tr = norm_tref(inout s, inout cx, a, inout out);
        intern2(inout s, g_impl(), tr, b)
    } else if t == g_peq() {
        let tr = field_a(in s, a);
        let tr2 = norm_tref(inout s, inout cx, tr, inout out);
        let pb = field_b(in s, a);
        let assoc = field_c(in s, a);
        let p = intern(inout s, t_proj(), tr2, pb, assoc);
        let ty = norm_ty(inout s, inout cx, b, inout out);
        intern2(inout s, g_peq(), p, ty)
    } else {
        let ty = norm_ty(inout s, inout cx, a, inout out);
        intern2(inout s, g_mode(), ty, b)
    }
}

// ---------------------------------------------------------------------------
// The obligation driver: proves the goals of the list node `goals` in cx;
// a list of derivations, or a nested error.

pub fn drive(inout s: S, env: u64, inout cx: ChunkSeq[u64], goals: u64) -> u64 {
    let mut obl = ChunkSeq::new[u64]();
    let mut roots = ChunkSeq::new[u64]();
    let ng = kid_count(in s, goals);
    for i in 0..ng {
        let g = kid(in s, goals, i);
        let start = obl.len();
        let normalized = norm_goal(inout s, inout cx, g, inout obl);
        if normalized == 0 {
            return dup_err(inout s);
        }
        roots.push(g);
        roots.push(start);
        roots.push(obl.len());
        obl.push(normalized);
    }
    let n = obl.len();
    let mut proofs = ChunkSeq::with_capacity[u64](n);
    let mut pending = ChunkSeq::with_capacity[u64](n);
    for j in 0..n {
        proofs.push(0);
        pending.push(j);
    }
    loop {
        let mut progress = false;
        let mut still = ChunkSeq::new[u64]();
        let mut first = none();
        let np = pending.len();
        for k in 0..np {
            let idx = word_at(in pending, k);
            let g = word_at(in obl, idx);
            let r = solve_nested(inout s, env, inout cx, g);
            let t = tag_of(in s, r);
            if t == d_node() {
                set_word(inout proofs, idx, r);
                progress = true;
            } else if t == q_ambig() {
                if first == none() {
                    first = field_a(in s, r);
                }
                still.push(idx);
            } else {
                return r;
            }
        }
        if still.len() == 0 {
            break;
        }
        if !progress {
            let g0 = word_at(in obl, word_at(in still, 0));
            let g = resolve(inout s, in cx, g0);
            if g == 0 {
                return dup_err(inout s);
            }
            let amb = if tag_of(in s, first) == am_stalled() {
                first
            } else if still.len() == 1 {
                first
            } else {
                intern1(inout s, am_stalled(), g)
            };
            return intern1(inout s, q_ambig(), amb);
        }
        pending = still;
    }
    let from = s.tmp.len();
    let nr = roots.len();
    let mut r: u64 = 0;
    loop {
        if r >= nr {
            break;
        }
        let orig = word_at(in roots, r);
        let start = word_at(in roots, inc(r));
        let main = word_at(in roots, add(r, 2));
        let mp = word_at(in proofs, main);
        if start == main {
            s.tmp.push(mp);
        } else {
            let f2 = s.tmp.len();
            for q in start..main {
                let p = word_at(in proofs, q);
                s.tmp.push(p);
            }
            s.tmp.push(mp);
            let step = intern0(inout s, st_norm());
            let d = intern_with_kids(inout s, d_node(), orig, step, 0, f2);
            s.tmp.push(d);
        }
        r = add(r, 3);
    }
    intern_with_kids(inout s, k_list(), 0, 0, 0, from)
}

// Canonicalizes a goal of cx, answers it through the table, and applies
// the answer back to cx: a derivation, or a nested error.
fn solve_nested(inout s: S, env: u64, inout cx: ChunkSeq[u64], goal: u64) -> u64 {
    let resolved = resolve(inout s, in cx, goal);
    if resolved == 0 {
        return dup_err(inout s);
    }
    cn_begin(inout s);
    let canon = run(inout s, in cx, 3, resolved);
    if canon == 0 {
        return dup_err(inout s);
    }
    let from = s.tmp.len();
    let nb = s.cn_binders.len();
    let mut i: u64 = 0;
    loop {
        if i >= nb {
            break;
        }
        let k = word_at(in s.cn_binders, i);
        s.tmp.push(k);
        i = inc(i);
    }
    let binders = intern_with_kids(inout s, k_slist(), 0, 0, 0, from);
    let from2 = s.tmp.len();
    i = 0;
    loop {
        if i >= nb {
            break;
        }
        let o = word_at(in s.cn_origins, i);
        s.tmp.push(o);
        i = inc(i);
    }
    let origins = intern_with_kids(inout s, k_slist(), 0, 0, 0, from2);
    let result = solve_key(inout s, env, canon, binders);
    if tag_of(in s, result) != q_proven() {
        return result;
    }
    let rb = field_a(in s, result);
    let values = field_b(in s, result);
    let der = field_c(in s, result);
    let fresh = fresh_args(inout s, inout cx, rb);
    let nv = kid_count(in s, values);
    for j in 0..nv {
        let value = kid(in s, values, j);
        let saved = s.fsub;
        s.fsub = fresh;
        let v = run(inout s, in cx, 4, value);
        s.fsub = saved;
        if v == 0 {
            return dup_err(inout s);
        }
        let kind = arg_kind(in s, v);
        let o = kid(in s, origins, j);
        let var = var_arg(inout s, kind, vinf(o));
        let e = unify_arg(inout s, inout cx, var, v);
        if e != 0 {
            if e == 3 {
                return dup_err(inout s);
            }
            let r = intern2(inout s, un_internal(), 0, goal);
            return intern1(inout s, q_unsup(), r);
        }
    }
    let saved = s.fsub;
    s.fsub = fresh;
    let d = run(inout s, in cx, 4, der);
    s.fsub = saved;
    if d == 0 {
        return dup_err(inout s);
    }
    d
}

// ---------------------------------------------------------------------------
// Tabling and cycles.

fn same_answer(in s: S, a: u64, b: u64) -> bool {
    let ta = tag_of(in s, a);
    let tb = tag_of(in s, b);
    if ta == q_proven() && tb == q_proven() {
        return field_a(in s, a) == field_a(in s, b) && field_b(in s, a) == field_b(in s, b);
    }
    ta == tb
}

fn ck_slot(in s: S, env: u64, goal: u64) -> u64 {
    let h = wrapping_mul(wrapping_mul(env, GOLDEN_GAMMA) ^ goal, MIX_MUL);
    let mut at = (h >> HALF_BITS) & s.ck_mask;
    loop {
        let g = word_at(in s.ck_goal, at);
        if g == 0 {
            return at;
        }
        if g == goal && word_at(in s.ck_env, at) == env {
            return at;
        }
        at = inc(at) & s.ck_mask;
    }
}

fn ck_grow(inout s: S) {
    let cap = wrapping_mul(inc(s.ck_mask), 2);
    let mut oe = ChunkSeq::with_capacity[u64](s.ck_count);
    let mut og = ChunkSeq::with_capacity[u64](s.ck_count);
    let mut ov = ChunkSeq::with_capacity[u64](s.ck_count);
    let old = inc(s.ck_mask);
    let mut i: u64 = 0;
    loop {
        if i >= old {
            break;
        }
        let g = word_at(in s.ck_goal, i);
        if g != 0 {
            oe.push(word_at(in s.ck_env, i));
            og.push(g);
            ov.push(word_at(in s.ck_val, i));
        }
        i = inc(i);
    }
    s.ck_env.clear();
    s.ck_goal.clear();
    s.ck_val.clear();
    i = 0;
    loop {
        if i >= cap {
            break;
        }
        s.ck_env.push(0);
        s.ck_goal.push(0);
        s.ck_val.push(0);
        i = inc(i);
    }
    s.ck_mask = dec(cap);
    let n = og.len();
    i = 0;
    loop {
        if i >= n {
            break;
        }
        let e = word_at(in oe, i);
        let g = word_at(in og, i);
        let at = ck_slot(in s, e, g);
        set_word(inout s.ck_env, at, e);
        set_word(inout s.ck_goal, at, g);
        set_word(inout s.ck_val, at, word_at(in ov, i));
        i = inc(i);
    }
}

fn ck_insert(inout s: S, env: u64, goal: u64, v: u64) {
    let at = ck_slot(in s, env, goal);
    if word_at(in s.ck_goal, at) == 0 {
        s.ck_count = inc(s.ck_count);
    }
    set_word(inout s.ck_env, at, env);
    set_word(inout s.ck_goal, at, goal);
    set_word(inout s.ck_val, at, v);
    if wrapping_mul(s.ck_count, 2) > s.ck_mask {
        ck_grow(inout s);
    }
}

fn cohyp_leaf(inout s: S, goal: u64) -> u64 {
    let st = intern0(inout s, st_cohyp());
    intern2(inout s, d_node(), goal, st)
}

pub fn solve_key(inout s: S, env: u64, goal: u64, binders: u64) -> u64 {
    let at = ck_slot(in s, env, goal);
    if word_at(in s.ck_goal, at) != 0 {
        s.st_hits = inc(s.st_hits);
        return word_at(in s.ck_val, at);
    }
    let depth = s.sk_env.len();
    for i in 0..depth {
        if word_at(in s.sk_goal, i) == goal && word_at(in s.sk_env, i) == env {
            let mut co = true;
            for j in i..depth {
                if word_at(in s.sk_co, j) == 0 {
                    co = false;
                }
            }
            let top = dec(depth);
            let m = word_at(in s.sk_min, top);
            if i < m {
                set_word(inout s.sk_min, top, i);
            }
            if co {
                set_word(inout s.sk_uco, i, 1);
                s.st_cocyc = inc(s.st_cocyc);
            } else {
                set_word(inout s.sk_uind, i, 1);
                s.st_indcyc = inc(s.st_indcyc);
            }
            if word_at(in s.sk_uco, i) != 0 && word_at(in s.sk_uind, i) != 0 {
                let r = intern1(inout s, un_mixed(), goal);
                return intern1(inout s, q_unsup(), r);
            }
            return if co {
                word_at(in s.sk_pco, i)
            } else {
                word_at(in s.sk_pind, i)
            };
        }
    }
    if depth >= s.max_depth {
        return overflow(inout s, 0);
    }
    let mut coinductive = false;
    if tag_of(in s, goal) == g_impl() {
        let tr = field_a(in s, goal);
        coinductive = word_at(in s.tr_coind, field_a(in s, tr)) != 0;
    }
    // The identity response with a coinductive-hypothesis leaf.
    let from = s.tmp.len();
    let nb = kid_count(in s, binders);
    for b in 0..nb {
        let k = kid(in s, binders, b);
        let v = var_arg(inout s, k, vinf(b));
        s.tmp.push(v);
    }
    let ids = intern_with_kids(inout s, k_list(), 0, 0, 0, from);
    let leaf = cohyp_leaf(inout s, goal);
    let identity = intern(inout s, q_proven(), binders, ids, leaf);
    let ic = intern0(inout s, r_indcyc());
    let fl = intern2(inout s, f_node(), goal, ic);
    let ind = intern1(inout s, q_nosol(), fl);
    s.sk_env.push(env);
    s.sk_goal.push(goal);
    s.sk_co.push(if coinductive { 1 } else { 0 });
    s.sk_pco.push(identity);
    s.sk_pind.push(ind);
    s.sk_uco.push(0);
    s.sk_uind.push(0);
    s.sk_min.push(none());
    let index = depth;
    let mut iterations: u64 = 0;
    let mut result: u64 = 0;
    loop {
        set_word(inout s.sk_uco, index, 0);
        set_word(inout s.sk_uind, index, 0);
        set_word(inout s.sk_min, index, none());
        let r = evaluate(inout s, env, goal, binders);
        let uco = word_at(in s.sk_uco, index) != 0;
        let uind = word_at(in s.sk_uind, index) != 0;
        let mixed = tag_of(in s, r) == q_unsup() && tag_of(in s, field_a(in s, r)) == un_mixed();
        if mixed || (uco && uind) {
            let m = intern1(inout s, un_mixed(), goal);
            result = intern1(inout s, q_unsup(), m);
            break;
        }
        let stable = (!uco || same_answer(in s, r, word_at(in s.sk_pco, index)))
            && (!uind || same_answer(in s, r, word_at(in s.sk_pind, index)));
        if stable {
            result = r;
            break;
        }
        iterations = inc(iterations);
        if iterations >= s.max_fix {
            result = overflow(inout s, 2);
            break;
        }
        s.st_reruns = inc(s.st_reruns);
        if uco {
            let p = if tag_of(in s, r) == q_proven() {
                let rb = field_a(in s, r);
                let rv = field_b(in s, r);
                let lf = cohyp_leaf(inout s, goal);
                intern(inout s, q_proven(), rb, rv, lf)
            } else {
                r
            };
            set_word(inout s.sk_pco, index, p);
        }
        if uind {
            set_word(inout s.sk_pind, index, r);
        }
    }
    let min = word_at(in s.sk_min, index);
    s.sk_env.truncate(index);
    s.sk_goal.truncate(index);
    s.sk_co.truncate(index);
    s.sk_pco.truncate(index);
    s.sk_pind.truncate(index);
    s.sk_uco.truncate(index);
    s.sk_uind.truncate(index);
    s.sk_min.truncate(index);
    if min < index {
        if index > 0 {
            let p = dec(index);
            if min < word_at(in s.sk_min, p) {
                set_word(inout s.sk_min, p, min);
            }
        }
    } else if tag_of(in s, result) != q_over() {
        ck_insert(inout s, env, goal, result);
    }
    result
}

// ---------------------------------------------------------------------------
// Evaluation.

fn evaluate(inout s: S, env: u64, goal: u64, binders: u64) -> u64 {
    s.st_evals = inc(s.st_evals);
    if bump(inout s) {
        return overflow(inout s, 1);
    }
    let mut cx = ChunkSeq::new[u64]();
    let vars = fresh_args(inout s, inout cx, binders);
    let t = tag_of(in s, goal);
    let base = s.ph_src.len();
    let st = if t == g_impl() {
        let tr = field_a(in s, goal);
        let b = field_b(in s, goal);
        implements(inout s, env, in cx, tr, b, vars)
    } else if t == g_peq() {
        let p = field_a(in s, goal);
        let ty = field_b(in s, goal);
        projection_eq(inout s, env, in cx, p, ty, vars)
    } else {
        let ty = field_a(in s, goal);
        let b = field_b(in s, goal);
        return mode_bound(inout s, env, in cx, goal, ty, b, vars);
    };
    if st != 0 {
        truncate_phase(inout s, base);
        let tag = tag_of(in s, st);
        if tag == q_ambig() || tag == q_unsup() || tag == q_over() {
            return st;
        }
        let reason = if tag == r_modelmis() {
            st
        } else {
            intern0(inout s, r_nocand())
        };
        let f = intern2(inout s, f_node(), goal, reason);
        return intern1(inout s, q_nosol(), f);
    }
    let r = combine(inout s, goal, base);
    truncate_phase(inout s, base);
    r
}

fn truncate_phase(inout s: S, base: u64) {
    s.ph_src.truncate(base);
    s.ph_val.truncate(base);
}

fn push_phase(inout s: S, source: u64, v: u64) {
    s.ph_src.push(source);
    s.ph_val.push(v);
}

// `applies`: the head matched and the candidate did not definitely fail.
fn applies_from(in s: S, base: u64, nosol_counts: bool) -> bool {
    let n = s.ph_val.len();
    let mut i = base;
    loop {
        if i >= n {
            return false;
        }
        let t = tag_of(in s, word_at(in s.ph_val, i));
        if t != ce_head() && (t != ce_nosol() || nosol_counts) {
            return true;
        }
        i = inc(i);
    }
}

fn is_unresolved_infer(inout s: S, in cx: ChunkSeq[u64], t: u64) -> bool {
    let r = resolve(inout s, in cx, t);
    r != 0 && tag_of(in s, r) == t_var() && is_inf(field_a(in s, r))
}

// How a brand is resolved, binding implicit brands: b_canon, b_named or
// b_var (a placeholder), or a candidate error.
fn brand_mode(inout s: S, env: u64, inout cx: ChunkSeq[u64], tr: u64, brand: u64) -> u64 {
    let rb = resolve(inout s, in cx, brand);
    let t = tag_of(in s, rb);
    if t == b_canon() || t == b_named() {
        return rb;
    }
    let v = field_a(in s, rb);
    if vkind(v) == 1 {
        return rb;
    }
    if vkind(v) == 0 {
        let r = intern2(inout s, un_internal(), 1, none());
        return intern1(inout s, q_unsup(), r);
    }
    let scopes = field_c(in s, env);
    let ns = kid_count(in s, scopes);
    let tid = field_a(in s, tr);
    let mut si = ns;
    loop {
        if si == 0 {
            break;
        }
        si = dec(si);
        let scope = kid(in s, scopes, si);
        let n = kid_count(in s, scope);
        let mut matching = ChunkSeq::new[u64]();
        for i in 0..n {
            let m = kid(in s, scope, i);
            let ci = add(s.nimpl, m);
            let mtr = word_at(in s.cf_tref, ci);
            if field_a(in s, mtr) == tid {
                let mut probe = clone_cx(in cx);
                let params = word_at(in s.cf_params, ci);
                let args = fresh_args(inout s, inout probe, params);
                let head = inst(inout s, mtr, args);
                if head == 0 {
                    return dup_err(inout s);
                }
                let u = unify_trait_ref(inout s, inout probe, head, tr);
                if u == 0 || u == 2 {
                    matching.push(m);
                } else if u == 3 {
                    return dup_err(inout s);
                }
            }
        }
        // sort and dedup
        let nm = matching.len();
        for a in 1..nm {
            let x = word_at(in matching, a);
            let mut j = a;
            loop {
                if j == 0 {
                    break;
                }
                let y = word_at(in matching, dec(j));
                if y <= x {
                    break;
                }
                set_word(inout matching, j, y);
                j = dec(j);
            }
            set_word(inout matching, j, x);
        }
        let from = s.tmp.len();
        for k in 0..nm {
            let x = word_at(in matching, k);
            if k == 0 || x != word_at(in matching, dec(k)) {
                s.tmp.push(x);
            }
        }
        let distinct = sub(s.tmp.len(), from);
        if distinct == 0 {
            s.tmp.truncate(from);
        } else {
            if distinct == 1 {
                let m = word_at(in s.tmp, from);
                s.tmp.truncate(from);
                let named = intern1(inout s, b_named(), m);
                let u = unify_brand(inout s, inout cx, rb, named);
                if u != 0 {
                    return unify_err(inout s, u);
                }
                return named;
            }
            let l = intern_with_kids(inout s, k_slist(), 0, 0, 0, from);
            let am = intern1(inout s, am_scoped(), l);
            return intern1(inout s, q_ambig(), am);
        }
    }
    let canon = intern0(inout s, b_canon());
    let u = unify_brand(inout s, inout cx, rb, canon);
    if u != 0 {
        return unify_err(inout s, u);
    }
    canon
}

// Phase of an `Implements` goal: 0 with the candidates on the phase stack,
// r_modelmis for a model of another trait, or a candidate error.
fn implements(inout s: S, env: u64, in cx0: ChunkSeq[u64], tr: u64, brand: u64, vars: u64) -> u64 {
    let st = field_b(in s, tr);
    if is_unresolved_infer(inout s, in cx0, st) {
        let a = intern0(inout s, am_self());
        return intern1(inout s, q_ambig(), a);
    }
    let mut cx = clone_cx(in cx0);
    let mode = brand_mode(inout s, env, inout cx, tr, brand);
    if is_err(in s, mode) {
        return mode;
    }
    let rbrand = resolve(inout s, in cx, brand);
    let builder = intern2(inout s, g_impl(), tr, brand);
    let tid = field_a(in s, tr);
    let base = s.ph_src.len();
    let mt = tag_of(in s, mode);
    if mt == b_named() {
        let m = field_a(in s, mode);
        let ci = add(s.nimpl, m);
        if field_a(in s, word_at(in s.cf_tref, ci)) != tid {
            return intern1(inout s, r_modelmis(), m);
        }
        env_implements(inout s, env, in cx, tr, rbrand, builder, vars);
        if applies_from(in s, base, false) {
            return 0;
        }
        truncate_phase(inout s, base);
        let r = try_conformance(
            inout s,
            env,
            in cx,
            ci,
            inc(wrapping_mul(m, 2)),
            tr,
            builder,
            vars
        );
        push_phase(inout s, src(1, m), r);
        return 0;
    }
    env_implements(inout s, env, in cx, tr, rbrand, builder, vars);
    if applies_from(in s, base, false) || mt == b_var() {
        return 0;
    }
    let at = word_at(in s.ib_at, tid);
    let n = word_at(in s.ib_n, tid);
    for i in 0..n {
        let ci = word_at(in s.ib, add(at, i));
        let r = try_conformance(inout s, env, in cx, ci, wrapping_mul(ci, 2), tr, builder, vars);
        push_phase(inout s, src(0, ci), r);
    }
    0
}

// Environment candidates: assumptions and, for rigid projection self
// types, bounds declared on the associated type.
fn env_implements(
    inout s: S,
    env: u64,
    in cx0: ChunkSeq[u64],
    tr: u64,
    brand: u64,
    builder: u64,
    vars: u64
) {
    let asm = field_b(in s, env);
    let na = kid_count(in s, asm);
    let tid = field_a(in s, tr);
    for k in 0..na {
        let a = kid(in s, asm, k);
        if tag_of(in s, a) == g_impl() && field_a(in s, field_a(in s, a)) == tid {
            let mut cx = clone_cx(in cx0);
            let atr = field_a(in s, a);
            let ab = field_b(in s, a);
            let mut u = unify_trait_ref(inout s, inout cx, atr, tr);
            if u == 0 {
                u = unify_brand(inout s, inout cx, ab, brand);
            }
            let v = if u != 0 {
                unify_err(inout s, u)
            } else {
                let g = goal_of(inout s, in cx, builder);
                let step = intern1(inout s, st_assume(), k);
                let d = intern2(inout s, d_node(), g, step);
                make_response(inout s, in cx, vars, d)
            };
            push_phase(inout s, src(2, k), v);
        }
    }
    let st = field_b(in s, tr);
    if tag_of(in s, st) != t_proj() {
        return;
    }
    let ptr = field_a(in s, st);
    let pb = field_b(in s, st);
    let pt = field_a(in s, ptr);
    let at = add(word_at(in s.tr_as_at, pt), field_c(in s, st));
    let bat = word_at(in s.as_bd_at, at);
    let bn = word_at(in s.as_bd_n, at);
    let from = s.tmp.len();
    let pst = field_b(in s, ptr);
    s.tmp.push(pst);
    push_kids(inout s, ptr);
    let binder = intern_with_kids(inout s, k_list(), 0, 0, 0, from);
    for bi in 0..bn {
        let bt = word_at(in s.bd_trait, add(bat, bi));
        if bt == tid {
            let bargs = word_at(in s.bd_args, add(bat, bi));
            let bbrand = word_at(in s.bd_brand, add(bat, bi));
            let v = alias_bound(
                inout s,
                env,
                in cx0,
                tr,
                brand,
                builder,
                vars,
                binder,
                bargs,
                bbrand,
                ptr,
                pb,
                bi
            );
            push_phase(inout s, src(3, bi), v);
        }
    }
}

fn alias_bound(
    inout s: S,
    env: u64,
    in cx0: ChunkSeq[u64],
    tr: u64,
    brand: u64,
    builder: u64,
    vars: u64,
    binder: u64,
    bargs: u64,
    bbrand: u64,
    ptr: u64,
    pb: u64,
    bi: u64
) -> u64 {
    if bump(inout s) {
        return overflow(inout s, 1);
    }
    let mut cx = clone_cx(in cx0);
    let args = inst(inout s, bargs, binder);
    if args == 0 {
        return dup_err(inout s);
    }
    let u = unify_args(inout s, inout cx, args, tr);
    if u != 0 {
        return unify_err(inout s, u);
    }
    let ib = inst(inout s, bbrand, binder);
    let u2 = unify_brand(inout s, inout cx, ib, brand);
    if u2 != 0 {
        return unify_err(inout s, u2);
    }
    let parent = intern2(inout s, g_impl(), ptr, pb);
    let from = s.tmp.len();
    s.tmp.push(parent);
    let goals = intern_with_kids(inout s, k_list(), 0, 0, 0, from);
    let children = drive(inout s, env, inout cx, goals);
    if tag_of(in s, children) != k_list() {
        return nested_to_cand(inout s, children);
    }
    let g = goal_of(inout s, in cx, builder);
    let step = intern1(inout s, st_alias(), bi);
    let f2 = s.tmp.len();
    push_kids(inout s, children);
    let d = intern_with_kids(inout s, d_node(), g, step, 0, f2);
    make_response(inout s, in cx, vars, d)
}

// Instantiates the where-clauses of conformance ci with args onto tmp
// (from `from`); false on a duplicate label.
fn where_goals(inout s: S, ci: u64, args: u64) -> bool {
    let wh = word_at(in s.cf_where, ci);
    let n = kid_count(in s, wh);
    for i in 0..n {
        let w = kid(in s, wh, i);
        let g = inst(inout s, w, args);
        if g == 0 {
            return false;
        }
        s.tmp.push(g);
    }
    true
}

fn try_conformance(
    inout s: S,
    env: u64,
    in cx0: ChunkSeq[u64],
    ci: u64,
    source: u64,
    tr: u64,
    builder: u64,
    vars: u64
) -> u64 {
    if bump(inout s) {
        return overflow(inout s, 1);
    }
    let mut cx = clone_cx(in cx0);
    let params = word_at(in s.cf_params, ci);
    let args = fresh_args(inout s, inout cx, params);
    let ctr = word_at(in s.cf_tref, ci);
    let head = inst(inout s, ctr, args);
    if head == 0 {
        return dup_err(inout s);
    }
    let u = unify_trait_ref(inout s, inout cx, head, tr);
    if u != 0 {
        return unify_err(inout s, u);
    }
    let from = s.tmp.len();
    if !where_goals(inout s, ci, args) {
        s.tmp.truncate(from);
        return dup_err(inout s);
    }
    let wcs = intern_with_kids(inout s, k_list(), 0, 0, 0, from);
    let children = drive(inout s, env, inout cx, wcs);
    if tag_of(in s, children) != k_list() {
        return nested_to_cand(inout s, children);
    }
    let g = goal_of(inout s, in cx, builder);
    let f2 = s.tmp.len();
    push_kids(inout s, args);
    let step = intern_with_kids(inout s, st_conf(), source, 0, 0, f2);
    let f3 = s.tmp.len();
    push_kids(inout s, children);
    let d = intern_with_kids(inout s, d_node(), g, step, 0, f3);
    make_response(inout s, in cx, vars, d)
}

fn projection_eq(inout s: S, env: u64, in cx0: ChunkSeq[u64], p: u64, ty: u64, vars: u64) -> u64 {
    let tr = field_a(in s, p);
    let st = field_b(in s, tr);
    if is_unresolved_infer(inout s, in cx0, st) {
        let a = intern0(inout s, am_self());
        return intern1(inout s, q_ambig(), a);
    }
    let mut cx = clone_cx(in cx0);
    let pbrand = field_b(in s, p);
    let assoc = field_c(in s, p);
    let mode = brand_mode(inout s, env, inout cx, tr, pbrand);
    if is_err(in s, mode) {
        return mode;
    }
    let builder = intern2(inout s, g_peq(), p, ty);
    let tid = field_a(in s, tr);
    let mt = tag_of(in s, mode);
    if mt == b_named() {
        let m = field_a(in s, mode);
        if field_a(in s, word_at(in s.cf_tref, add(s.nimpl, m))) != tid {
            return intern1(inout s, r_modelmis(), m);
        }
    }
    let brand = resolve(inout s, in cx, pbrand);
    let base = s.ph_src.len();
    // 1. Explicit equality assumptions.
    let asm = field_b(in s, env);
    let na = kid_count(in s, asm);
    for k in 0..na {
        let a = kid(in s, asm, k);
        if tag_of(in s, a) == g_peq() {
            let ap = field_a(in s, a);
            let aty = field_b(in s, a);
            let atr = field_a(in s, ap);
            if field_a(in s, atr) == tid && field_c(in s, ap) == assoc {
                let mut c = clone_cx(in cx);
                let mut u = unify_trait_ref(inout s, inout c, atr, tr);
                if u == 0 {
                    let ab = field_b(in s, ap);
                    u = unify_brand(inout s, inout c, ab, brand);
                }
                let v = if u != 0 {
                    unify_err(inout s, u)
                } else {
                    let u2 = unify_ty(inout s, inout c, aty, ty);
                    if u2 == 1 {
                        let cv = intern0(inout s, c_value());
                        intern1(inout s, ce_nosol(), cv)
                    } else if u2 != 0 {
                        unify_err(inout s, u2)
                    } else {
                        let g = goal_of(inout s, in c, builder);
                        let step = intern1(inout s, st_passume(), k);
                        let d = intern2(inout s, d_node(), g, step);
                        make_response(inout s, in c, vars, d)
                    }
                };
                push_phase(inout s, src(2, k), v);
            }
        }
    }
    if applies_from(in s, base, true) {
        return 0;
    }
    // 2. The trait holds through the environment: rigid projection.
    let tbuilder = intern2(inout s, g_impl(), tr, brand);
    let ebase = s.ph_src.len();
    env_implements(inout s, env, in cx, tr, brand, tbuilder, vars);
    let n = s.ph_val.len();
    let mut env_applies = false;
    for i in ebase..n {
        if tag_of(in s, word_at(in s.ph_val, i)) != ce_head() {
            env_applies = true;
        }
    }
    truncate_phase(inout s, ebase);
    if env_applies || mt == b_var() {
        let stt = tag_of(in s, st);
        let rigid = (stt == t_var() && vkind(field_a(in s, st)) == 1) || stt == t_proj();
        let v = if !rigid {
            let r = intern2(inout s, un_internal(), 2, none());
            intern1(inout s, q_unsup(), r)
        } else {
            rigid_projection(inout s, env, in cx, p, brand, ty, builder, vars)
        };
        truncate_phase(inout s, base);
        push_phase(inout s, src(4, 0), v);
        return 0;
    }
    // 3. The selected model's value, or canonical impls.
    if mt == b_named() {
        let m = field_a(in s, mode);
        let ci = add(s.nimpl, m);
        let v = try_proj_conformance(
            inout s,
            env,
            in cx,
            ci,
            inc(wrapping_mul(m, 2)),
            p,
            ty,
            builder,
            vars
        );
        push_phase(inout s, src(1, m), v);
        return 0;
    }
    let at = word_at(in s.ib_at, tid);
    let ni = word_at(in s.ib_n, tid);
    for j in 0..ni {
        let ci = word_at(in s.ib, add(at, j));
        let v = try_proj_conformance(
            inout s,
            env,
            in cx,
            ci,
            wrapping_mul(ci, 2),
            p,
            ty,
            builder,
            vars
        );
        push_phase(inout s, src(0, ci), v);
    }
    0
}

fn rigid_projection(
    inout s: S,
    env: u64,
    in cx0: ChunkSeq[u64],
    p: u64,
    brand: u64,
    ty: u64,
    builder: u64,
    vars: u64
) -> u64 {
    if bump(inout s) {
        return overflow(inout s, 1);
    }
    let mut cx = clone_cx(in cx0);
    let tr = field_a(in s, p);
    let assoc = field_c(in s, p);
    let pp = intern(inout s, t_proj(), tr, brand, assoc);
    let parent = intern2(inout s, g_impl(), tr, brand);
    let from = s.tmp.len();
    s.tmp.push(parent);
    let goals = intern_with_kids(inout s, k_list(), 0, 0, 0, from);
    let children = drive(inout s, env, inout cx, goals);
    if tag_of(in s, children) != k_list() {
        return nested_to_cand(inout s, children);
    }
    let u = unify_ty(inout s, inout cx, pp, ty);
    if u == 1 {
        let cv = intern0(inout s, c_value());
        return intern1(inout s, ce_nosol(), cv);
    }
    if u != 0 {
        return unify_err(inout s, u);
    }
    let g = goal_of(inout s, in cx, builder);
    let step = intern0(inout s, st_rigid());
    let f2 = s.tmp.len();
    push_kids(inout s, children);
    let d = intern_with_kids(inout s, d_node(), g, step, 0, f2);
    make_response(inout s, in cx, vars, d)
}

fn try_proj_conformance(
    inout s: S,
    env: u64,
    in cx0: ChunkSeq[u64],
    ci: u64,
    source: u64,
    p: u64,
    ty: u64,
    builder: u64,
    vars: u64
) -> u64 {
    if bump(inout s) {
        return overflow(inout s, 1);
    }
    let mut cx = clone_cx(in cx0);
    let params = word_at(in s.cf_params, ci);
    let args = fresh_args(inout s, inout cx, params);
    let ctr = word_at(in s.cf_tref, ci);
    let head = inst(inout s, ctr, args);
    if head == 0 {
        return dup_err(inout s);
    }
    let tr = field_a(in s, p);
    let u = unify_trait_ref(inout s, inout cx, head, tr);
    if u != 0 {
        return unify_err(inout s, u);
    }
    let vals = word_at(in s.cf_vals, ci);
    let raw = kid(in s, vals, field_c(in s, p));
    let value = inst(inout s, raw, args);
    if value == 0 {
        return dup_err(inout s);
    }
    let mut norms = ChunkSeq::new[u64]();
    let value = norm_ty(inout s, inout cx, value, inout norms);
    let u2 = unify_ty(inout s, inout cx, value, ty);
    if u2 == 1 {
        let cv = intern0(inout s, c_value());
        return intern1(inout s, ce_nosol(), cv);
    }
    if u2 != 0 {
        return unify_err(inout s, u2);
    }
    let from = s.tmp.len();
    if !where_goals(inout s, ci, args) {
        s.tmp.truncate(from);
        return dup_err(inout s);
    }
    let k = norms.len();
    for i in 0..k {
        let g = word_at(in norms, i);
        s.tmp.push(g);
    }
    let goals = intern_with_kids(inout s, k_list(), 0, 0, 0, from);
    let children = drive(inout s, env, inout cx, goals);
    if tag_of(in s, children) != k_list() {
        return nested_to_cand(inout s, children);
    }
    let g = goal_of(inout s, in cx, builder);
    let f2 = s.tmp.len();
    push_kids(inout s, args);
    let step = intern_with_kids(inout s, st_pconf(), source, k, 0, f2);
    let f3 = s.tmp.len();
    push_kids(inout s, children);
    let d = intern_with_kids(inout s, d_node(), g, step, 0, f3);
    make_response(inout s, in cx, vars, d)
}

fn mode_bound(
    inout s: S,
    env: u64,
    in cx: ChunkSeq[u64],
    goal: u64,
    ty: u64,
    bound: u64,
    vars: u64
) -> u64 {
    let t = resolve(inout s, in cx, ty);
    if t == 0 {
        return dup_err(inout s);
    }
    let from = s.atoms.len();
    mode_atoms(inout s, env, t);
    let b = resolve(inout s, in cx, bound);
    let v = decide(inout s, from, b);
    s.atoms.truncate(from);
    if v == 0 {
        let step = intern0(inout s, st_mode());
        let d = intern2(inout s, d_node(), goal, step);
        return make_response(inout s, in cx, vars, d);
    }
    if v == 1 {
        let atom = s.vatom;
        let r = intern2(inout s, r_mode(), atom, b);
        let f = intern2(inout s, f_node(), goal, r);
        return intern1(inout s, q_nosol(), f);
    }
    let a = intern0(inout s, am_mode());
    intern1(inout s, q_ambig(), a)
}

// Combines the candidates of the phase stack from base on: any unsupported
// or overflowing candidate decides; several distinct answers or a
// remaining ambiguity are ambiguous.
fn combine(inout s: S, goal: u64, base: u64) -> u64 {
    let n = s.ph_val.len();
    let mut proven = ChunkSeq::new[u64]();
    let mut amb = ChunkSeq::new[u64]();
    let from = s.tmp.len();
    for i in base..n {
        let v = word_at(in s.ph_val, i);
        let source = word_at(in s.ph_src, i);
        let t = tag_of(in s, v);
        if t == q_proven() {
            proven.push(i);
        } else if t == ce_nosol() {
            let cause = field_a(in s, v);
            let cf = intern2(inout s, cf_node(), source, cause);
            s.tmp.push(cf);
        } else if t == q_ambig() {
            amb.push(i);
        } else if t == q_unsup() || t == q_over() {
            s.tmp.truncate(from);
            return v;
        }
    }
    let np = proven.len();
    let mut distinct: u64 = 0;
    for a in 0..np {
        let pa = word_at(in s.ph_val, word_at(in proven, a));
        let mut seen = false;
        for b in 0..a {
            let pb = word_at(in s.ph_val, word_at(in proven, b));
            if field_a(in s, pa) == field_a(in s, pb) && field_b(in s, pa) == field_b(in s, pb) {
                seen = true;
                break;
            }
        }
        if !seen {
            distinct = inc(distinct);
        }
    }
    if distinct > 1 || (distinct > 0 && amb.len() > 0) {
        s.tmp.truncate(from);
        let mut srcs = ChunkSeq::new[u64]();
        let mut x: u64 = 0;
        loop {
            if x >= np {
                break;
            }
            srcs.push(word_at(in s.ph_src, word_at(in proven, x)));
            x = inc(x);
        }
        let na = amb.len();
        x = 0;
        loop {
            if x >= na {
                break;
            }
            srcs.push(word_at(in s.ph_src, word_at(in amb, x)));
            x = inc(x);
        }
        let ns = srcs.len();
        for q in 1..ns {
            let y = word_at(in srcs, q);
            let mut j = q;
            loop {
                if j == 0 {
                    break;
                }
                let z = word_at(in srcs, dec(j));
                if z <= y {
                    break;
                }
                set_word(inout srcs, j, z);
                j = dec(j);
            }
            set_word(inout srcs, j, y);
        }
        let f2 = s.tmp.len();
        x = 0;
        loop {
            if x >= ns {
                break;
            }
            s.tmp.push(word_at(in srcs, x));
            x = inc(x);
        }
        let l = intern_with_kids(inout s, k_slist(), 0, 0, 0, f2);
        let am = intern1(inout s, am_multi(), l);
        return intern1(inout s, q_ambig(), am);
    }
    if np > 0 {
        s.tmp.truncate(from);
        return word_at(in s.ph_val, word_at(in proven, 0));
    }
    if amb.len() > 0 {
        s.tmp.truncate(from);
        return word_at(in s.ph_val, word_at(in amb, 0));
    }
    let reason = if s.tmp.len() == from {
        intern0(inout s, r_nocand())
    } else {
        intern_with_kids(inout s, r_cands(), 0, 0, 0, from)
    };
    let f = intern2(inout s, f_node(), goal, reason);
    intern1(inout s, q_nosol(), f)
}
