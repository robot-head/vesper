load("//tools/bazel:defs.bzl", "vesper_crate")
load("//tools/bazel:vesper_port.bzl", "VESPER_TARGET", "vesper_package", "vesper_port_object")

# The Rust build is the default (default features, generated by
# vesper_crate below). The Vesper port (the Loom package in vesper/, Cargo
# feature `vesper-port`, port wave P3a lane 3, #1038) is non-default until it
# reaches performance parity. The compiler links neither: it links the Rust
# seed copy, //crates/vesper-pact/seed (seed-copy rule,
# docs/maintenance/porting-a-crate.md).
vesper_package(
    name = "port_package",
    srcs = glob(["vesper/src/**/*.ves"]),
    manifest = "vesper/Loom.toml",
)

vesper_port_object(
    name = "pact_vesper",
    library = "pact",
    package = ":port_package",
    target = VESPER_TARGET,
)

filegroup(
    name = "pact_vesper_binding",
    srcs = [":pact_vesper"],
    output_group = "rust_binding",
)

# The build script links this object only under `vesper-port`; passing it
# keeps the port in this package's dependency graph, which the seed-copy
# guard's positive control queries
# (//crates/vesper-port-harness:compiler_closure_has_no_ports).
vesper_crate(
    build_script_data = [
        ":pact_vesper",
        ":pact_vesper_binding",
    ],
    build_script_env = {
        # rules_rust already makes these execpaths absolute.
        "VESPER_PORT_OBJECT": "$(execpath :pact_vesper)",
        "VESPER_PORT_GENERATED_BINDING": "$(execpath :pact_vesper_binding)",
    },
)

# The seed package (seed/) builds these same Rust sources without the port.
exports_files(glob([
    "src/**/*.rs",
    "tests/**/*.rs",
]))

filegroup(
    name = "rust_srcs",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//crates/vesper-pact/seed:__pkg__"],
)

# The divergent builds, one per ported module (the Cargo
# `vesper-port-divergent` feature applies the same edits, DIVERGENT in
# build.rs): each must build from a copy of the package with its edit
# applied. The Cargo run in crates/vesper-pact/port/test-port.sh asserts
# which test catches each one.
[
    vesper_port_object(
        name = "pact_vesper_divergent_" + module,
        edit_src = "vesper/src/%s.ves" % module,
        edits = {old: new},
        library = "pact",
        package = ":port_package",
        target = VESPER_TARGET,
    )
    for module, old, new in [
        ("term", "            if same {", "            if same && tag != 14 {"),
        ("fold", "        if a == label_key(in s, sw(in s.tmp, k)) {", "        if a == none() {"),
        ("infer", "        if !has_key(in s, other, label_key(in s, l)) {", "        if !has_key(in s, other, none()) {"),
        ("canon", "        if nlen(in s, sc) > 0 {", "        if nlen(in s, sc) > 1 {"),
        ("mode", "            if av <= bv {", "            if av < bv {"),
        ("render", "        r_id(inout s, \"type\", h43);", "        r_id(inout s, \"ty\", h43);"),
        ("diag", "            if cmp_diag(in s, dec(j), j) != 2 {", "            if cmp_diag(in s, dec(j), j) != 0 {"),
        ("program", "    if maj != 0 || min > 1 {", "    if maj != 0 || min > 2 {"),
        ("solver", "    s.steps > s.max_steps", "    s.steps > wrapping_add(s.max_steps, 1000)"),
        ("query", "    if r == 0 {\n        n\n    } else {\n        r\n    }", "    if r == 0 {\n        n\n    } else {\n        n\n    }"),
        ("coherence", "    if sw(in s.tr_pkg, t) == pkg {", "    if sw(in s.tr_pkg, t) != pkg {"),
        ("deriv", "        if nlen(in s, d) != nlen(in s, sw(in s.cf_where, ci)) {", "        if nlen(in s, d) > nlen(in s, sw(in s.cf_where, ci)) {"),
        ("out", "        let co: u64 = if uses_coinduction(in s, d) {", "        let co: u64 = if !uses_coinduction(in s, d) {"),
    ]
]
