# The frozen Rust seed copy of vesper-pact (package vesper-pact-seed,
# library vesper_pact) that the compiler links: the shared API in ../src
# (cfg(vesper_port) off) over the Rust engine in src/engine. Written by hand
# because part of its sources live in the parent package; see "Crates the
# compiler links" in docs/maintenance/porting-a-crate.md.
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rs//rs/private:all_crate_deps.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test")
load("@vesper_cargo//:packages.bzl", "PACKAGES")

_CRATE = PACKAGES["crates/vesper-pact/seed"].crate_data()

_DEPS = all_crate_deps(_CRATE, normal = True, platforms = _CRATE["platforms"])

_TEST_DEPS = all_crate_deps(
    _CRATE,
    normal = True,
    normal_dev = True,
    platforms = _CRATE["platforms"],
)

rust_library(
    name = "seed",
    srcs = glob(["src/**/*.rs"]) + ["//crates/vesper-pact:rust_srcs"],
    aliases = _CRATE.get("aliases", {}),
    crate_name = "vesper_pact",
    crate_root = "src/lib.rs",
    edition = "2024",
    rustc_env = {
        "CARGO_PKG_NAME": "vesper-pact-seed",
        "CARGO_PKG_VERSION": "0.1.0",
    },
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = _DEPS,
)

rust_test(
    name = "seed_unit_test",
    crate = ":seed",
    edition = "2024",
)

# The tests that read no files at run time; Cargo runs dto.rs (which reads
# tests/fixtures) against the seed too (crates/vesper-pact/port/test-port.sh).
[
    rust_test(
        name = "seed_test_" + t,
        srcs = [
            "//crates/vesper-pact:tests/%s.rs" % t,
            "//crates/vesper-pact:tests/common/mod.rs",
        ],
        crate_root = "//crates/vesper-pact:tests/%s.rs" % t,
        edition = "2024",
        deps = [":seed"] + _TEST_DEPS,
    )
    for t in [
        "coherence",
        "solver",
    ]
]

rust_clippy_test(
    name = "clippy",
    targets = [":seed"],
    tags = [
        "clippy",
        "lint",
    ],
)
