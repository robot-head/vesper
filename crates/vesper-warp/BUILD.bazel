load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("@rules_rs//rs/private:all_crate_deps.bzl", "all_crate_deps")
load("@vesper_cargo//:packages.bzl", "PACKAGES")
load("//tools/bazel:defs.bzl", "vesper_crate")
load("//tools/bazel:vesper_port.bzl", "VESPER_TARGET", "vesper_package", "vesper_port_object")

# The Rust build is the default (default features, generated by
# vesper_crate below). The Vesper port of varint, packet_number, header,
# frame and ack (the Loom package in vesper/, Cargo feature `vesper-port`,
# port wave P3b lane 4, #1066) is non-default until it reaches performance
# parity.
vesper_crate(
    # Lean resolves symlinked runfiles to the source tree and then rejects
    # them as outside --root, so these run in a copy of regular files.
    copy_test_cwd = ["test/lean_model"],
    extra_test_data = ["//:lean"],
)

vesper_package(
    name = "port_package",
    srcs = glob(["vesper/src/**/*.ves"]),
    manifest = "vesper/Loom.toml",
)

vesper_port_object(
    name = "warp_vesper",
    library = "warp",
    package = ":port_package",
    target = VESPER_TARGET,
)

# The divergent builds, one per ported module (the Cargo
# `vesper-port-divergent` feature applies the same edits from build.rs, one
# at a time with VESPER_WARP_DIVERGE): each must keep compiling, and
# crates/vesper-warp/port/check.sh asserts which test catches it.
[
    vesper_port_object(
        name = "warp_vesper_divergent_" + module,
        edit_src = "vesper/src/%s.ves" % module,
        edits = {old: new},
        library = "warp",
        package = ":port_package",
        target = VESPER_TARGET,
    )
    for module, old, new in [
        ("varint", "widen_u64(v) & 16383", "widen_u64(v) & 8191"),
        ("pn", "let hwin = win / 2;", "let hwin = win / 4;"),
        ("header", "let pn_offset = wrapping_add(dcid_len, 1);", "let pn_offset = wrapping_add(dcid_len, 2);"),
        ("frame", "fin: ty & stream_fin() != 0,", "fin: ty & stream_fin() == 0,"),
        ("ack", "s.unacked_ack_eliciting >= 2", "s.unacked_ack_eliciting >= 3"),
        ("recovery", "sat_add(e.pn, 3)", "sat_add(e.pn, 4)"),
    ]
]

# The Vesper build: the same sources with the `vesper-port` feature,
# forwarding to the port through the committed binding (which the Cargo
# build checks against the generated one). The object is linked into each
# test binary.
_CRATE_DATA = PACKAGES["crates/vesper-warp"].crate_data()

rust_library(
    name = "port",
    srcs = glob(["src/**/*.rs"]) + ["port/binding.rs"],
    crate_features = ["vesper-port"],
    crate_name = "vesper_warp",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = ["//crates/vesper-port-abi"] + all_crate_deps(
        _CRATE_DATA,
        normal = True,
        platforms = _CRATE_DATA["platforms"],
    ),
)

# The in-crate unit tests (varint and packet_number) of the port build,
# compiled from the same sources as :port (a `crate = ":port"` test does
# not find the crate root here).
rust_test(
    name = "port_unit_test",
    srcs = glob(["src/**/*.rs"]) + ["port/binding.rs"],
    compile_data = [":warp_vesper"],
    crate_features = ["vesper-port"],
    crate_name = "vesper_warp",
    crate_root = "src/lib.rs",
    edition = "2024",
    rustc_flags = ["-Clink-arg=$(location :warp_vesper)"],
    deps = ["//crates/vesper-port-abi"] + all_crate_deps(
        _CRATE_DATA,
        normal = True,
        platforms = _CRATE_DATA["platforms"],
    ),
)

# The test files of the ported modules against the port. Every other test
# file (the endpoint, streams, quinn interop) runs against the port in
# Cargo, in the Linux "Vesper ports" job (crates/vesper-warp/port/check.sh).
[
    rust_test(
        name = "port_%s_test" % test,
        srcs = ["tests/%s.rs" % test] + glob(["tests/common/**/*.rs"]),
        compile_data = [":warp_vesper"],
        crate_features = ["vesper-port"],
        crate_name = test,
        crate_root = "tests/%s.rs" % test,
        edition = "2024",
        rustc_flags = ["-Clink-arg=$(location :warp_vesper)"],
        deps = [":port"],
    )
    for test in [
        "ack_tracking",
        "frames",
        "headers",
        "lifecycle_frames",
        "packet_number",
        "recovery",
        "zero_alloc",
    ]
]
