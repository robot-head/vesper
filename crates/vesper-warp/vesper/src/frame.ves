// Module frame of @vesper/warp (see lib.ves): RFC 9000 §19 frames
// (frame.rs). A parsed frame names its byte fields as spans of the input;
// an encoded one takes them as the slices `a` (data, reason, token, CID or
// ACK range pairs) and `b` (the stateless reset token).
use self::{
    AckRange,
    FrameAt,
    FrameErr,
    FrameW,
    PktType,
    Sp,
    WireStep
};
use self::varint::{
    b8,
    vi_len_or_zero,
    vi_max,
    vi_prefix_len,
    vi_put,
    vi_value_at
};

// Frame types (RFC 9000 §19, Table 3). STREAM is 0x08-0x0f: the low bits
// are OFF, LEN and FIN.
const T_PADDING: u64 = 0;
const T_PING: u64 = 1;
const T_ACK: u64 = 2;
const T_ACK_ECN: u64 = 3;
const T_RESET_STREAM: u64 = 4;
const T_STOP_SENDING: u64 = 5;
const T_CRYPTO: u64 = 6;
const T_NEW_TOKEN: u64 = 7;
const T_STREAM: u64 = 8;
const T_STREAM_MAX: u64 = 15;
const T_MAX_DATA: u64 = 16;
const T_MAX_STREAM_DATA: u64 = 17;
const T_MAX_STREAMS_BIDI: u64 = 18;
const T_MAX_STREAMS_UNI: u64 = 19;
const T_DATA_BLOCKED: u64 = 20;
const T_STREAM_DATA_BLOCKED: u64 = 21;
const T_STREAMS_BLOCKED_BIDI: u64 = 22;
const T_STREAMS_BLOCKED_UNI: u64 = 23;
const T_NEW_CONNECTION_ID: u64 = 24;
const T_RETIRE_CONNECTION_ID: u64 = 25;
const T_PATH_CHALLENGE: u64 = 26;
const T_PATH_RESPONSE: u64 = 27;
const T_CONNECTION_CLOSE: u64 = 28;
const T_CONNECTION_CLOSE_APP: u64 = 29;
const T_HANDSHAKE_DONE: u64 = 30;

// A frame's kind: the variant index of `Frame` and `FrameW`.
const K_PADDING: u64 = 0;
const K_PING: u64 = 1;
const K_ACK: u64 = 2;
const K_CRYPTO: u64 = 3;
const K_STREAM: u64 = 4;
const K_MAX_DATA: u64 = 5;
const K_MAX_STREAM_DATA: u64 = 6;
const K_RESET_STREAM: u64 = 7;
const K_STOP_SENDING: u64 = 8;
const K_MAX_STREAMS: u64 = 9;
const K_DATA_BLOCKED: u64 = 10;
const K_STREAM_DATA_BLOCKED: u64 = 11;
const K_STREAMS_BLOCKED: u64 = 12;
const K_CONNECTION_CLOSE: u64 = 13;
const K_HANDSHAKE_DONE: u64 = 14;
const K_NEW_TOKEN: u64 = 15;
const K_NEW_CONNECTION_ID: u64 = 16;
const K_RETIRE_CONNECTION_ID: u64 = 17;
const K_PATH_CHALLENGE: u64 = 18;
const K_PATH_RESPONSE: u64 = 19;

// Connection IDs are at most 20 bytes (RFC 9000 §17.2); PATH_CHALLENGE and
// PATH_RESPONSE carry 8 bytes of data (§19.17).
const MAX_CID_LEN: u64 = 20;
const PATH_DATA_LEN: u64 = 8;
const U64_MAX: u64 = 18446744073709551615;

fn stream_off() -> u64 {
    4
}

fn stream_len() -> u64 {
    2
}

fn stream_fin() -> u64 {
    1
}

// 2^60, the stream count limit (RFC 9000 §4.6).
pub fn max_stream_count() -> u64 {
    1152921504606846976
}

fn reset_token_len() -> u64 {
    16
}

// Table 3 permissions (RFC 9000 §12.4).
pub fn fr_allowed(ty: u64, pt: PktType) -> bool {
    let zero_rtt = match pt {
        PktType::ZeroRtt => true,
        _ => false,
    };
    let one_rtt = match pt {
        PktType::OneRtt => true,
        _ => false,
    };
    if ty == T_PADDING || ty == T_PING || ty == T_CONNECTION_CLOSE {
        true
    } else if ty == T_ACK || ty == T_ACK_ECN || ty == T_CRYPTO {
        !zero_rtt
    } else if ty == T_NEW_TOKEN || ty == T_PATH_RESPONSE || ty == T_HANDSHAKE_DONE {
        one_rtt
    } else if ty == T_NEW_CONNECTION_ID
        || ty == T_RETIRE_CONNECTION_ID
        || ty == T_PATH_CHALLENGE
        || ty == T_RESET_STREAM
        || ty == T_STOP_SENDING
        || ty == T_CONNECTION_CLOSE_APP
        || ty >= T_STREAM && ty <= T_STREAMS_BLOCKED_UNI {
        zero_rtt || one_rtt
    } else {
        false
    }
}

fn truncated(ty: u64) eff [Fail[FrameErr]] {
    Fail::raise(
        FrameErr::Truncated {
            frame_type: ty
        }
    );
}

fn malformed(ty: u64) eff [Fail[FrameErr]] {
    Fail::raise(
        FrameErr::Malformed {
            frame_type: ty
        }
    );
}

// `Reader::varint` at `at`: the value and the next position, or `None`.
fn rd_vi(in buf: Slice[u8], at: u64) -> Option[(u64, u64)] {
    if at >= buf.len() {
        return Option::None;
    }
    let len = vi_prefix_len(wrapping_u8(b8(in buf, at)));
    if wrapping_sub(buf.len(), at) < len {
        return Option::None;
    }
    Option::Some((vi_value_at(in buf, at, len), wrapping_add(at, len)))
}

// A varint field of a frame of type `ty`.
fn vi(in buf: Slice[u8], at: u64, ty: u64) -> (u64, u64) eff [Fail[FrameErr]] {
    match rd_vi(in buf, at) {
        Option::Some(r) => r,
        Option::None => {
            truncated(ty);
            (0, 0)
        }
    }
}

// `len` bytes at `at` of a frame of type `ty`.
fn take(in buf: Slice[u8], at: u64, len: u64, ty: u64) -> Sp eff [Fail[FrameErr]] {
    let end = wrapping_add(at, len);
    if end < at || end > buf.len() {
        truncated(ty);
    }
    Sp {
        start: at,
        len: len
    }
}

// `check_end`: `offset + len` stays a varint.
fn end_ok(offset: u64, len: u64) -> bool {
    let end = wrapping_add(offset, len);
    end >= offset && end <= vi_max()
}

// Parses the frame at `buf[at..]`; spans are positions in `buf`.
pub fn fr_parse_at(in buf: Slice[u8], at: u64, pt: PktType) -> FrameAt eff [Fail[FrameErr]] {
    let (ty, p0) = vi(in buf, at, 0);
    if wrapping_sub(p0, at) != vi_len_or_zero(ty) {
        Fail::raise(
            FrameErr::NonMinimalType {
                ty: ty
            }
        );
    }
    if ty > T_HANDSHAKE_DONE {
        Fail::raise(
            FrameErr::UnknownType {
                ty: ty
            }
        );
    }
    if !fr_allowed(ty, pt) {
        Fail::raise(
            FrameErr::NotAllowed {
                frame_type: ty,
                packet_type: pt
            }
        );
    }
    if ty == T_PADDING {
        let mut p = p0;
        loop {
            if p >= buf.len() || b8(in buf, p) != 0 {
                break;
            }
            p = wrapping_add(p, 1);
        }
        return FrameAt {
            f: FrameW::Padding {
                len: wrapping_add(wrapping_sub(p, p0), 1)
            },
            end: p
        };
    }
    if ty == T_PING {
        return FrameAt {
            f: FrameW::Ping,
            end: p0
        };
    }
    if ty == T_ACK || ty == T_ACK_ECN {
        return parse_ack(in buf, p0, ty);
    }
    if ty == T_CRYPTO {
        let (offset, p1) = vi(in buf, p0, ty);
        let (len, p2) = vi(in buf, p1, ty);
        let data = take(in buf, p2, len, ty);
        if !end_ok(offset, len) {
            Fail::raise(
                FrameErr::OffsetOverflow {
                    frame_type: ty
                }
            );
        }
        return FrameAt {
            f: FrameW::Crypto {
                offset: offset,
                data: data
            },
            end: wrapping_add(p2, len)
        };
    }
    if ty >= T_STREAM && ty <= T_STREAM_MAX {
        let (stream_id, p1) = vi(in buf, p0, ty);
        let mut p = p1;
        let mut offset: u64 = 0;
        if ty & stream_off() != 0 {
            let (o, p2) = vi(in buf, p, ty);
            offset = o;
            p = p2;
        }
        let has_length = ty & stream_len() != 0;
        let mut len: u64 = 0;
        if has_length {
            let (l, p3) = vi(in buf, p, ty);
            len = l;
            p = p3;
        } else {
            len = wrapping_sub(buf.len(), p);
        }
        let data = take(in buf, p, len, ty);
        if !end_ok(offset, len) {
            Fail::raise(
                FrameErr::OffsetOverflow {
                    frame_type: ty
                }
            );
        }
        return FrameAt {
            f: FrameW::Stream {
                stream_id: stream_id,
                offset: offset,
                data: data,
                fin: ty & stream_fin() != 0,
                has_length: has_length
            },
            end: wrapping_add(p, len)
        };
    }
    if ty == T_MAX_DATA {
        let (max, p1) = vi(in buf, p0, ty);
        return FrameAt {
            f: FrameW::MaxData {
                max: max
            },
            end: p1
        };
    }
    if ty == T_MAX_STREAM_DATA {
        let (stream_id, p1) = vi(in buf, p0, ty);
        let (max, p2) = vi(in buf, p1, ty);
        return FrameAt {
            f: FrameW::MaxStreamData {
                stream_id: stream_id,
                max: max
            },
            end: p2
        };
    }
    if ty == T_RESET_STREAM {
        let (stream_id, p1) = vi(in buf, p0, ty);
        let (error_code, p2) = vi(in buf, p1, ty);
        let (final_size, p3) = vi(in buf, p2, ty);
        return FrameAt {
            f: FrameW::ResetStream {
                stream_id: stream_id,
                error_code: error_code,
                final_size: final_size
            },
            end: p3
        };
    }
    if ty == T_STOP_SENDING {
        let (stream_id, p1) = vi(in buf, p0, ty);
        let (error_code, p2) = vi(in buf, p1, ty);
        return FrameAt {
            f: FrameW::StopSending {
                stream_id: stream_id,
                error_code: error_code
            },
            end: p2
        };
    }
    if ty >= T_MAX_STREAMS_BIDI
        && ty <= T_STREAMS_BLOCKED_UNI
        && ty != T_DATA_BLOCKED
        && ty != T_STREAM_DATA_BLOCKED {
        let (n, p1) = vi(in buf, p0, ty);
        if n > max_stream_count() {
            malformed(ty);
        }
        let uni = ty & 1 == 1;
        if ty <= T_MAX_STREAMS_UNI {
            return FrameAt {
                f: FrameW::MaxStreams {
                    uni: uni,
                    max: n
                },
                end: p1
            };
        }
        return FrameAt {
            f: FrameW::StreamsBlocked {
                uni: uni,
                limit: n
            },
            end: p1
        };
    }
    if ty == T_DATA_BLOCKED {
        let (limit, p1) = vi(in buf, p0, ty);
        return FrameAt {
            f: FrameW::DataBlocked {
                limit: limit
            },
            end: p1
        };
    }
    if ty == T_STREAM_DATA_BLOCKED {
        let (stream_id, p1) = vi(in buf, p0, ty);
        let (limit, p2) = vi(in buf, p1, ty);
        return FrameAt {
            f: FrameW::StreamDataBlocked {
                stream_id: stream_id,
                limit: limit
            },
            end: p2
        };
    }
    if ty == T_CONNECTION_CLOSE || ty == T_CONNECTION_CLOSE_APP {
        let (error_code, p1) = vi(in buf, p0, ty);
        let mut p = p1;
        let mut frame_type: u64 = 0;
        if ty == T_CONNECTION_CLOSE {
            let (t, p2) = vi(in buf, p, ty);
            frame_type = t;
            p = p2;
        }
        let (len, p3) = vi(in buf, p, ty);
        let reason = take(in buf, p3, len, ty);
        return FrameAt {
            f: FrameW::ConnectionClose {
                error_code: error_code,
                has_frame_type: ty == T_CONNECTION_CLOSE,
                frame_type: frame_type,
                reason: reason
            },
            end: wrapping_add(p3, len)
        };
    }
    if ty == T_HANDSHAKE_DONE {
        return FrameAt {
            f: FrameW::HandshakeDone,
            end: p0
        };
    }
    if ty == T_NEW_TOKEN {
        let (len, p1) = vi(in buf, p0, ty);
        if len == 0 {
            malformed(ty);
        }
        let token = take(in buf, p1, len, ty);
        return FrameAt {
            f: FrameW::NewToken {
                token: token
            },
            end: wrapping_add(p1, len)
        };
    }
    if ty == T_NEW_CONNECTION_ID {
        let (seq, p1) = vi(in buf, p0, ty);
        let (retire_prior_to, p2) = vi(in buf, p1, ty);
        if p2 >= buf.len() {
            truncated(ty);
        }
        let len = b8(in buf, p2);
        if len == 0 || len > MAX_CID_LEN || retire_prior_to > seq {
            malformed(ty);
        }
        let p3 = wrapping_add(p2, 1);
        let cid = take(in buf, p3, len, ty);
        let p4 = wrapping_add(p3, len);
        let token = take(in buf, p4, reset_token_len(), ty);
        return FrameAt {
            f: FrameW::NewConnectionId {
                seq: seq,
                retire_prior_to: retire_prior_to,
                cid: cid,
                reset_token: token.start
            },
            end: wrapping_add(p4, reset_token_len())
        };
    }
    if ty == T_RETIRE_CONNECTION_ID {
        let (seq, p1) = vi(in buf, p0, ty);
        return FrameAt {
            f: FrameW::RetireConnectionId {
                seq: seq
            },
            end: p1
        };
    }
    // PATH_CHALLENGE (26) and PATH_RESPONSE (27).
    let _d = take(in buf, p0, PATH_DATA_LEN, ty);
    let data = match buf.try_read_u64_be(p0) {
        Option::Some(v) => v,
        Option::None => 0,
    };
    if ty == T_PATH_CHALLENGE {
        return FrameAt {
            f: FrameW::PathChallenge {
                data: data
            },
            end: wrapping_add(p0, PATH_DATA_LEN)
        };
    }
    FrameAt {
        f: FrameW::PathResponse {
            data: data
        },
        end: wrapping_add(p0, PATH_DATA_LEN)
    }
}

fn parse_ack(in buf: Slice[u8], p0: u64, ty: u64) -> FrameAt eff [Fail[FrameErr]] {
    let (largest, p1) = vi(in buf, p0, ty);
    let (ack_delay, p2) = vi(in buf, p1, ty);
    let (count, p3) = vi(in buf, p2, ty);
    let (first_range, p4) = vi(in buf, p3, ty);
    if first_range > largest {
        malformed(ty);
    }
    let mut smallest = wrapping_sub(largest, first_range);
    let mut p = p4;
    let mut i: u64 = 0;
    loop {
        if i >= count {
            break;
        }
        let (gap, q1) = vi(in buf, p, ty);
        let (len, q2) = vi(in buf, q1, ty);
        if gap > smallest || wrapping_sub(smallest, gap) < 2 {
            malformed(ty);
        }
        let next_largest = wrapping_sub(wrapping_sub(smallest, gap), 2);
        if len > next_largest {
            malformed(ty);
        }
        smallest = wrapping_sub(next_largest, len);
        p = q2;
        i = wrapping_add(i, 1);
    }
    let pairs = Sp {
        start: p4,
        len: wrapping_sub(p, p4)
    };
    let mut has_ecn = false;
    let mut ect0: u64 = 0;
    let mut ect1: u64 = 0;
    let mut ce: u64 = 0;
    if ty == T_ACK_ECN {
        let (a, q1) = vi(in buf, p, ty);
        let (b, q2) = vi(in buf, q1, ty);
        let (c, q3) = vi(in buf, q2, ty);
        has_ecn = true;
        ect0 = a;
        ect1 = b;
        ce = c;
        p = q3;
    }
    FrameAt {
        f: FrameW::Ack {
            largest: largest,
            ack_delay: ack_delay,
            has_ecn: has_ecn,
            ect0: ect0,
            ect1: ect1,
            ce: ce,
            decoded: false,
            first_range: first_range,
            count: count,
            pairs: pairs
        },
        end: p
    }
}

// The next range below `prev_smallest` from the `(gap, length)` pairs at
// `pairs[at..]`, or `None` once they are used up.
pub fn fr_wire_next(in pairs: Slice[u8], at: u64, prev_smallest: u64) -> Option[WireStep] {
    match rd_vi(in pairs, at) {
        Option::None => Option::None,
        Option::Some((gap, q1)) => match rd_vi(in pairs, q1) {
            Option::None => Option::None,
            Option::Some((len, q2)) => {
                if gap > prev_smallest || wrapping_sub(prev_smallest, gap) < 2 {
                    return Option::None;
                }
                let largest = wrapping_sub(wrapping_sub(prev_smallest, gap), 2);
                if len > largest {
                    return Option::None;
                }
                Option::Some(
                    WireStep {
                        smallest: wrapping_sub(largest, len),
                        largest: largest,
                        next: q2
                    }
                )
            },
        },
    }
}

// `AckFrame::from_ranges`' checks: descending, disjoint, non-adjacent.
pub fn fr_check_ranges(in ranges: Slice[AckRange], ack_delay: u64) eff [Fail[FrameErr]] {
    if ranges.len() == 0 {
        malformed(T_ACK);
    }
    let mut prev_smallest: u64 = 0;
    for i in 0..ranges.len() {
        let r = match ranges.try_get(i) {
            Option::Some(x) => x,
            Option::None => AckRange {
                smallest: 0,
                largest: 0
            },
        };
        if r.smallest > r.largest || r.largest > vi_max() {
            malformed(T_ACK);
        }
        if i > 0
            && (
                r.largest > wrapping_sub(U64_MAX, 2) || wrapping_add(r.largest, 2) > prev_smallest
            ) {
            malformed(T_ACK);
        }
        prev_smallest = r.smallest;
    }
    if ack_delay > vi_max() {
        malformed(T_ACK);
    }
}

// A frame's kind is the variant index of `Frame` (and of `FrameW`):
// Padding 0, Ping 1, Ack 2, Crypto 3, Stream 4, MaxData 5, MaxStreamData 6,
// ResetStream 7, StopSending 8, MaxStreams 9, DataBlocked 10,
// StreamDataBlocked 11, StreamsBlocked 12, ConnectionClose 13,
// HandshakeDone 14, NewToken 15, NewConnectionId 16, RetireConnectionId 17,
// PathChallenge 18, PathResponse 19. `bits` holds what else the wire type
// encodes: ECN for an ACK (1); FIN (1), LEN (2) and OFF (4) for a STREAM;
// `uni` (1) for MAX_STREAMS and STREAMS_BLOCKED; the transport variant (1)
// for a CONNECTION_CLOSE.
pub fn fr_kind_type(kind: u64, bits: u64) -> u64 {
    if kind == K_PADDING {
        T_PADDING
    } else if kind == K_PING {
        T_PING
    } else if kind == K_ACK {
        T_ACK | bits & 1
    } else if kind == K_CRYPTO {
        T_CRYPTO
    } else if kind == K_STREAM {
        T_STREAM | bits & 7
    } else if kind == K_MAX_DATA {
        T_MAX_DATA
    } else if kind == K_MAX_STREAM_DATA {
        T_MAX_STREAM_DATA
    } else if kind == K_RESET_STREAM {
        T_RESET_STREAM
    } else if kind == K_STOP_SENDING {
        T_STOP_SENDING
    } else if kind == K_MAX_STREAMS {
        T_MAX_STREAMS_BIDI | bits & 1
    } else if kind == K_DATA_BLOCKED {
        T_DATA_BLOCKED
    } else if kind == K_STREAM_DATA_BLOCKED {
        T_STREAM_DATA_BLOCKED
    } else if kind == K_STREAMS_BLOCKED {
        T_STREAMS_BLOCKED_BIDI | bits & 1
    } else if kind == K_CONNECTION_CLOSE {
        wrapping_sub(T_CONNECTION_CLOSE_APP, bits & 1)
    } else if kind == K_HANDSHAKE_DONE {
        T_HANDSHAKE_DONE
    } else if kind == K_NEW_TOKEN {
        T_NEW_TOKEN
    } else if kind == K_NEW_CONNECTION_ID {
        T_NEW_CONNECTION_ID
    } else if kind == K_RETIRE_CONNECTION_ID {
        T_RETIRE_CONNECTION_ID
    } else if kind == K_PATH_CHALLENGE {
        T_PATH_CHALLENGE
    } else {
        T_PATH_RESPONSE
    }
}

// RFC 9002 §2: everything but ACK, PADDING and CONNECTION_CLOSE.
pub fn fr_kind_is_ack_eliciting(kind: u64) -> bool {
    !(kind == K_PADDING || kind == K_ACK || kind == K_CONNECTION_CLOSE)
}

// RFC 9000 §9.1 probing frames: PADDING, PATH_CHALLENGE, PATH_RESPONSE and
// NEW_CONNECTION_ID.
pub fn fr_kind_is_probing(kind: u64) -> bool {
    kind == K_PADDING
        || kind == K_PATH_CHALLENGE
        || kind == K_PATH_RESPONSE
        || kind == K_NEW_CONNECTION_ID
}

fn flag(b: bool, v: u64) -> u64 {
    if b {
        v
    } else {
        0
    }
}

// The kind and type bits of a frame's words.
fn kind_of(f: FrameW) -> (u64, u64) {
    match f {
        FrameW::Padding {
            len
        } => (K_PADDING, 0),
        FrameW::Ping => (K_PING, 0),
        FrameW::Ack {
            largest,
            ack_delay,
            has_ecn,
            ect0,
            ect1,
            ce,
            decoded,
            first_range,
            count,
            pairs
        } => (K_ACK, flag(has_ecn, 1)),
        FrameW::Crypto {
            offset,
            data
        } => (K_CRYPTO, 0),
        FrameW::Stream {
            stream_id,
            offset,
            data,
            fin,
            has_length
        } => (
            K_STREAM,
            flag(fin, stream_fin()) | flag(has_length, stream_len()) | flag(
                offset != 0,
                stream_off()
            )
        ),
        FrameW::MaxData {
            max
        } => (K_MAX_DATA, 0),
        FrameW::MaxStreamData {
            stream_id,
            max
        } => (K_MAX_STREAM_DATA, 0),
        FrameW::ResetStream {
            stream_id,
            error_code,
            final_size
        } => (K_RESET_STREAM, 0),
        FrameW::StopSending {
            stream_id,
            error_code
        } => (K_STOP_SENDING, 0),
        FrameW::MaxStreams {
            uni,
            max
        } => (K_MAX_STREAMS, flag(uni, 1)),
        FrameW::DataBlocked {
            limit
        } => (K_DATA_BLOCKED, 0),
        FrameW::StreamDataBlocked {
            stream_id,
            limit
        } => (K_STREAM_DATA_BLOCKED, 0),
        FrameW::StreamsBlocked {
            uni,
            limit
        } => (K_STREAMS_BLOCKED, flag(uni, 1)),
        FrameW::ConnectionClose {
            error_code,
            has_frame_type,
            frame_type,
            reason
        } => (K_CONNECTION_CLOSE, flag(has_frame_type, 1)),
        FrameW::HandshakeDone => (K_HANDSHAKE_DONE, 0),
        FrameW::NewToken {
            token
        } => (K_NEW_TOKEN, 0),
        FrameW::NewConnectionId {
            seq,
            retire_prior_to,
            cid,
            reset_token
        } => (K_NEW_CONNECTION_ID, 0),
        FrameW::RetireConnectionId {
            seq
        } => (K_RETIRE_CONNECTION_ID, 0),
        FrameW::PathChallenge {
            data
        } => (K_PATH_CHALLENGE, 0),
        FrameW::PathResponse {
            data
        } => (K_PATH_RESPONSE, 0),
    }
}

pub fn fr_type(f: FrameW) -> u64 {
    let (kind, bits) = kind_of(f);
    fr_kind_type(kind, bits)
}

fn enc() eff [Fail[FrameErr]] {
    Fail::raise(FrameErr::Encode);
}

// `Writer::varint`, any error being `FrameError::Encode`.
fn w_vi(inout out: Slice[u8], at: u64, value: u64) -> u64 eff [Fail[FrameErr]] {
    let len = vi_len_or_zero(value);
    if len == 0 || wrapping_add(at, len) > out.len() {
        enc();
    }
    vi_put(value, len, inout out, at);
    wrapping_add(at, len)
}

fn w_bytes(inout out: Slice[u8], at: u64, in bytes: Slice[u8]) -> u64 eff [Fail[FrameErr]] {
    let end = wrapping_add(at, bytes.len());
    if end > out.len() {
        enc();
    }
    let _c = out.try_copy_from(at, in bytes);
    end
}

fn w_u64(inout out: Slice[u8], at: u64, v: u64) -> u64 eff [Fail[FrameErr]] {
    if wrapping_add(at, 8) > out.len() {
        enc();
    }
    let _w = out.try_write_u64_be(at, v);
    wrapping_add(at, 8)
}

fn range_at(in ranges: Slice[AckRange], i: u64) -> AckRange {
    match ranges.try_get(i) {
        Option::Some(x) => x,
        Option::None => AckRange {
            smallest: 0,
            largest: 0
        },
    }
}

// `Frame::encode`: returns the bytes written.
pub fn fr_encode(
    inout out: Slice[u8],
    f: FrameW,
    in a: Slice[u8],
    in b: Slice[u8],
    in ranges: Slice[AckRange]
) -> u64 eff [Fail[FrameErr]] {
    match f {
        FrameW::Padding {
            len
        } => {
            // The Rust writer fills the room it has before failing.
            let n = if len > out.len() {
                out.len()
            } else {
                len
            };
            for i in 0..n {
                out.try_set(i, 0);
            }
            if len > n {
                enc();
            }
            return len;
        },
        _ => {},
    }
    let mut at = w_vi(inout out, 0, fr_type(f));
    match f {
        FrameW::Ack {
            largest,
            ack_delay,
            has_ecn,
            ect0,
            ect1,
            ce,
            decoded,
            first_range,
            count,
            pairs
        } => {
            if decoded {
                let n = ranges.len();
                if n == 0 {
                    enc();
                }
                let first = range_at(in ranges, 0);
                at = w_vi(inout out, at, largest);
                at = w_vi(inout out, at, ack_delay);
                at = w_vi(inout out, at, wrapping_sub(n, 1));
                at = w_vi(inout out, at, wrapping_sub(first.largest, first.smallest));
                let mut prev = first.smallest;
                for i in 1..n {
                    let r = range_at(in ranges, i);
                    at = w_vi(inout out, at, wrapping_sub(wrapping_sub(prev, r.largest), 2));
                    at = w_vi(inout out, at, wrapping_sub(r.largest, r.smallest));
                    prev = r.smallest;
                }
            } else {
                if first_range > largest {
                    enc();
                }
                at = w_vi(inout out, at, largest);
                at = w_vi(inout out, at, ack_delay);
                at = w_vi(inout out, at, count);
                at = w_vi(inout out, at, first_range);
                {
                    let mut prev = wrapping_sub(largest, first_range);
                    let mut p: u64 = 0;
                    let mut i: u64 = 0;
                    loop {
                        if i >= count {
                            break;
                        }
                        match fr_wire_next(in a, p, prev) {
                            Option::None => {
                                break;
                            },
                            Option::Some(s) => {
                                at = w_vi(
                                    inout out,
                                    at,
                                    wrapping_sub(wrapping_sub(prev, s.largest), 2)
                                );
                                at = w_vi(inout out, at, wrapping_sub(s.largest, s.smallest));
                                prev = s.smallest;
                                p = s.next;
                            },
                        }
                        i = wrapping_add(i, 1);
                    }
                }
            }
            if has_ecn {
                at = w_vi(inout out, at, ect0);
                at = w_vi(inout out, at, ect1);
                at = w_vi(inout out, at, ce);
            }
        },
        FrameW::Crypto {
            offset,
            data
        } => {
            if !end_ok(offset, a.len()) {
                enc();
            }
            at = w_vi(inout out, at, offset);
            at = w_vi(inout out, at, a.len());
            at = w_bytes(inout out, at, in a);
        },
        FrameW::Stream {
            stream_id,
            offset,
            data,
            fin,
            has_length
        } => {
            if !end_ok(offset, a.len()) {
                enc();
            }
            at = w_vi(inout out, at, stream_id);
            if offset != 0 {
                at = w_vi(inout out, at, offset);
            }
            if has_length {
                at = w_vi(inout out, at, a.len());
            }
            at = w_bytes(inout out, at, in a);
        },
        FrameW::MaxData {
            max
        } => {
            at = w_vi(inout out, at, max);
        },
        FrameW::MaxStreamData {
            stream_id,
            max
        } => {
            at = w_vi(inout out, at, stream_id);
            at = w_vi(inout out, at, max);
        },
        FrameW::ResetStream {
            stream_id,
            error_code,
            final_size
        } => {
            at = w_vi(inout out, at, stream_id);
            at = w_vi(inout out, at, error_code);
            at = w_vi(inout out, at, final_size);
        },
        FrameW::StopSending {
            stream_id,
            error_code
        } => {
            at = w_vi(inout out, at, stream_id);
            at = w_vi(inout out, at, error_code);
        },
        FrameW::MaxStreams {
            uni,
            max
        } => {
            if max > max_stream_count() {
                enc();
            }
            at = w_vi(inout out, at, max);
        },
        FrameW::StreamsBlocked {
            uni,
            limit
        } => {
            if limit > max_stream_count() {
                enc();
            }
            at = w_vi(inout out, at, limit);
        },
        FrameW::DataBlocked {
            limit
        } => {
            at = w_vi(inout out, at, limit);
        },
        FrameW::StreamDataBlocked {
            stream_id,
            limit
        } => {
            at = w_vi(inout out, at, stream_id);
            at = w_vi(inout out, at, limit);
        },
        FrameW::ConnectionClose {
            error_code,
            has_frame_type,
            frame_type,
            reason
        } => {
            at = w_vi(inout out, at, error_code);
            if has_frame_type {
                at = w_vi(inout out, at, frame_type);
            }
            at = w_vi(inout out, at, a.len());
            at = w_bytes(inout out, at, in a);
        },
        FrameW::NewToken {
            token
        } => {
            if a.len() == 0 {
                enc();
            }
            at = w_vi(inout out, at, a.len());
            at = w_bytes(inout out, at, in a);
        },
        FrameW::NewConnectionId {
            seq,
            retire_prior_to,
            cid,
            reset_token
        } => {
            if retire_prior_to > seq || a.len() == 0 || a.len() > MAX_CID_LEN {
                enc();
            }
            at = w_vi(inout out, at, seq);
            at = w_vi(inout out, at, retire_prior_to);
            if at >= out.len() {
                enc();
            }
            out.try_set(at, wrapping_u8(a.len()));
            at = wrapping_add(at, 1);
            at = w_bytes(inout out, at, in a);
            at = w_bytes(inout out, at, in b);
        },
        FrameW::RetireConnectionId {
            seq
        } => {
            at = w_vi(inout out, at, seq);
        },
        FrameW::PathChallenge {
            data
        } => {
            at = w_u64(inout out, at, data);
        },
        FrameW::PathResponse {
            data
        } => {
            at = w_u64(inout out, at, data);
        },
        _ => {},
    }
    at
}

// `encode_stream_header`: type with LEN (and OFF for a nonzero offset).
pub fn fr_encode_stream_header(
    inout out: Slice[u8],
    stream_id: u64,
    offset: u64,
    len: u64,
    fin: bool
) -> u64 eff [Fail[FrameErr]] {
    if !end_ok(offset, len) {
        enc();
    }
    let mut ty = T_STREAM | stream_len();
    if offset != 0 {
        ty = ty | stream_off();
    }
    if fin {
        ty = ty | stream_fin();
    }
    let mut at = w_vi(inout out, 0, ty);
    at = w_vi(inout out, at, stream_id);
    if offset != 0 {
        at = w_vi(inout out, at, offset);
    }
    w_vi(inout out, at, len)
}

pub fn fr_encode_crypto_header(inout out: Slice[u8], offset: u64, len: u64)
    -> u64 eff [Fail[FrameErr]] {
    if !end_ok(offset, len) {
        enc();
    }
    let at = w_vi(inout out, 0, T_CRYPTO);
    let at2 = w_vi(inout out, at, offset);
    w_vi(inout out, at2, len)
}

fn vl(v: u64) -> u64 {
    let n = vi_len_or_zero(v);
    if n == 0 {
        8
    } else {
        n
    }
}

pub fn fr_stream_header_len(stream_id: u64, offset: u64, len: u64) -> u64 {
    let off = if offset != 0 {
        vl(offset)
    } else {
        0
    };
    wrapping_add(wrapping_add(wrapping_add(1, vl(stream_id)), off), vl(len))
}

pub fn fr_crypto_header_len(offset: u64, len: u64) -> u64 {
    wrapping_add(wrapping_add(1, vl(offset)), vl(len))
}
