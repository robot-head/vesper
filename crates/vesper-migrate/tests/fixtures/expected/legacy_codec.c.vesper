@wire_layout(native)
struct batch_header {
    base_offset: i64,
    batch_length: i32,
    leader_epoch: i32,
    magic: u8,
    reserved: [u8; 3],
    crc: u32,
}

@wire_layout(native)
struct decoder_stats {
    last_crc: u32,
    record_count: i32,
    last: batch_header,
}

struct padded_record {
    tag: u8,
    value: u32,
}

enum codec_status { CODEC_OK = 0, CODEC_SHORT = 1, CODEC_BAD_MAGIC = 2, CODEC_LAST = 3 }

