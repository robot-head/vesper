{
  "notes": [
    "The flip gate for vesper-migrate's C header comment stripper and",
    "preprocessor directive filter (aspect ci flip-gate --, SH6 lane 18,",
    "#1413 / #2333)."
  ],
  "name": "vesper-migrate",
  "lane": "SH6-18",
  "env": {
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0"
  },
  "tests": [
    {
      "run": ["cargo", "test", "--locked", "--release", "-p", "vesper-migrate"]
    },
    {
      "run": ["cargo", "test", "--locked", "--release", "-p", "vesper-migrate", "--features", "vesper-port"]
    }
  ],
  "differential": {
    "run": [
      "cargo",
      "test",
      "--locked",
      "--release",
      "-p",
      "vesper-migrate",
      "--features",
      "vesper-port",
      "--test",
      "c_preprocess_port",
      "--",
      "--nocapture"
    ]
  },
  "abba": [
    {
      "workload": "c_preprocess",
      "run": [
        "cargo",
        "test",
        "--locked",
        "--release",
        "-p",
        "vesper-migrate",
        "--features",
        "vesper-port",
        "--test",
        "c_preprocess_port",
        "abba_c_preprocess",
        "--",
        "--ignored",
        "--nocapture"
      ]
    }
  ]
}
