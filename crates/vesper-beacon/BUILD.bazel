load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/bazel:defs.bzl", "vesper_crate")
load("//tools/bazel:vesper_port.bzl", "VESPER_TARGET", "vesper_package", "vesper_port_object")

# The Rust build is the default (default features, generated by
# vesper_crate below). The Vesper port (the Loom package in vesper/, Cargo
# feature `vesper-port`, port wave P1 lane 4, #901) is non-default until it
# reaches performance parity. The compiler links neither: it links the Rust
# seed copy, //crates/vesper-beacon/seed (seed-copy rule,
# docs/maintenance/porting-a-crate.md).
vesper_package(
    name = "port_package",
    srcs = glob(["vesper/src/**/*.ves"]),
    manifest = "vesper/Loom.toml",
)

vesper_port_object(
    name = "beacon_vesper",
    library = "beacon",
    package = ":port_package",
    rust_types = "crate::port",
    target = VESPER_TARGET,
)

filegroup(
    name = "beacon_vesper_binding",
    srcs = [":beacon_vesper"],
    output_group = "rust_binding",
)

# The build script links this object only under `vesper-port`; passing it
# keeps the port in this package's (and vesper-beacon-arrow's) dependency
# graph, which the seed-copy guard's positive control queries
# (//crates/vesper-port-harness:compiler_closure_has_no_ports).
vesper_crate(
    build_script_data = [
        ":beacon_vesper",
        ":beacon_vesper_binding",
    ],
    build_script_env = {
        # rules_rust already makes these execpaths absolute.
        "VESPER_PORT_OBJECT": "$(execpath :beacon_vesper)",
        "VESPER_PORT_GENERATED_BINDING": "$(execpath :beacon_vesper_binding)",
    },
)

# The seed package (seed/) builds these same Rust sources without the port.
exports_files(glob([
    "src/**/*.rs",
    "tests/**/*.rs",
]))

filegroup(
    name = "rust_srcs",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//crates/vesper-beacon/seed:__pkg__"],
)

# The divergent builds, one per ported module (the Cargo
# `vesper-port-divergent` feature applies the same edits from build.rs).
# :port_divergence_detected runs each one's tests and checks which fail.
[
    vesper_port_object(
        name = "beacon_vesper_divergent_" + module,
        edit_src = "vesper/src/lib.ves",
        edits = {old: new},
        library = "beacon",
        package = ":port_package",
        rust_types = "crate::port",
        target = VESPER_TARGET,
    )
    for module, old, new in [
        (
            "histogram",
            "            + ((value >> (octave - SUB_BITS)) - OCTAVE_BINS)",
            "            + ((value >> (octave - SUB_BITS)) - (OCTAVE_BINS - 1))",
        ),
        (
            "exponential",
            "if (hi >> shift) - (lo >> shift) + 1 <= EXP_BUCKETS {",
            "if (hi >> shift) - (lo >> shift) + 1 <= 80 {",
        ),
        (
            "traceparent",
            "} else if c >= Ascii::LowerA && c <= Ascii::LowerF {",
            "} else if (c >= Ascii::LowerA && c <= Ascii::LowerF) || (c >= 65 && c <= 70) {",
        ),
        (
            "spans",
            "            if p.span_id == id {",
            "            if p.span_id == 0 {",
        ),
    ]
]

# The Vesper build: the same sources with cfg(vesper_port), forwarding to
# the port through the committed binding (which the Cargo build checks
# against the generated one), and the crate's tests run unchanged against
# it. The object is linked into each test binary.
rust_library(
    name = "port",
    srcs = glob(["src/**/*.rs"]) + ["port/binding.rs"],
    crate_features = ["vesper-port"],
    crate_name = "vesper_beacon",
    crate_root = "src/lib.rs",
    edition = "2021",
    rustc_flags = ["--cfg=vesper_port"],
    deps = ["//crates/vesper-port-abi"],
)

# The in-crate unit tests of the port build, compiled from the same sources
# as :port (a `crate = ":port"` test does not find the crate root here).
rust_test(
    name = "port_unit_test",
    srcs = glob(["src/**/*.rs"]) + ["port/binding.rs"],
    compile_data = [":beacon_vesper"],
    crate_features = ["vesper-port"],
    crate_name = "vesper_beacon",
    crate_root = "src/lib.rs",
    edition = "2021",
    rustc_flags = [
        "--cfg=vesper_port",
        "-Clink-arg=$(location :beacon_vesper)",
    ],
    deps = ["//crates/vesper-port-abi"],
)

[
    rust_test(
        name = name,
        srcs = ["tests/%s.rs" % test],
        compile_data = [obj],
        crate_name = crate,
        edition = "2021",
        rustc_flags = ["-Clink-arg=$(location %s)" % obj],
        tags = tags,
        deps = [":port"],
    )
    for name, test, crate, obj, tags in [
        ("port_behavior_test", "behavior", "behavior", ":beacon_vesper", []),
        ("port_exponential_test", "exponential", "exponential", ":beacon_vesper", []),
        ("port_histogram_test", "histogram", "histogram", ":beacon_vesper", []),
        ("_port_histogram_divergent.bin", "histogram", "histogram_divergent", ":beacon_vesper_divergent_histogram", ["manual"]),
        ("_port_exponential_divergent.bin", "exponential", "exponential_divergent", ":beacon_vesper_divergent_exponential", ["manual"]),
        ("_port_traceparent_divergent.bin", "behavior", "behavior_traceparent_divergent", ":beacon_vesper_divergent_traceparent", ["manual"]),
        ("_port_spans_divergent.bin", "behavior", "behavior_spans_divergent", ":beacon_vesper_divergent_spans", ["manual"]),
    ]
]

rust_test(
    name = "port_divergence_detected",
    srcs = ["tests/divergence.rs"],
    data = [
        ":_port_exponential_divergent.bin",
        ":_port_histogram_divergent.bin",
        ":_port_spans_divergent.bin",
        ":_port_traceparent_divergent.bin",
    ],
    edition = "2021",
    env = {
        "BEACON_DIVERGENT_EXPONENTIAL": "$(rootpath :_port_exponential_divergent.bin)",
        "BEACON_DIVERGENT_HISTOGRAM": "$(rootpath :_port_histogram_divergent.bin)",
        "BEACON_DIVERGENT_SPANS": "$(rootpath :_port_spans_divergent.bin)",
        "BEACON_DIVERGENT_TRACEPARENT": "$(rootpath :_port_traceparent_divergent.bin)",
    },
)
