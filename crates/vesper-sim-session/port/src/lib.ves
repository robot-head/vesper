// @vesper/sim-session: Vesper port of vesper-sim-session's deterministic
// models (self-hosting wave SH5 lane 19, #1342), part 1.
//
// Part 2 adds SHA-256 (sha256.ves) and the WAL frame codec and recovery
// scan (wal.ves, src/model/wal.rs). Part 3 adds the virtual message network
// `net-v1` (src/model/net.rs), and part 4 the WAL state machine (`Wal` in
// src/model/wal.rs), at the end of this file.
//
// Ported in part 1: the datagram link model `datagram-v1` (src/model/link.rs): the
// SplitMix64 generator, the FNV-1a name seeds, the Gilbert-Elliott chain and
// its stationary rates, independent loss, the finite bottleneck queue and
// reordering. The Rust crate keeps the scenario JSON, the session driver
// (which steps the compiler's reference evaluator) and the other models;
// src/model/link.rs forwards to this library under the `vesper-port`
// feature. Every function is total: a virtual-clock overflow is a returned
// outcome, never a raise.

use self::sha256::{
    sha256_digest
};
use self::wal::{
    ScanResult,
    frame_bytes,
    scan_bytes
};

const PPM: u64 = 1000000;
const NS_PER_SEC: u64 = 1000000000;
const U64_MAX: u64 = 18446744073709551615;
const SPLITMIX_GAMMA: u64 = 11400714819323198485;
const SPLITMIX_MUL1: u64 = 13787848793156543929;
const SPLITMIX_MUL2: u64 = 10723151780598845931;
const FNV_OFFSET: u64 = 14695981039346656037;
const FNV_PRIME: u64 = 1099511628211;
// The amount `name_seed` rotates the scenario seed left by.
const SEED_ROTATION: u64 = 17;
// Loss causes, in the order of `LossCause` in link.rs.
const CAUSE_GILBERT_ELLIOTT: u8 = 0;
const CAUSE_INDEPENDENT: u8 = 1;
const CAUSE_QUEUE_OVERFLOW: u8 = 2;
// Served departures kept at the front of the queue before it is compacted.
const COMPACT_AT: u64 = 256;

// A link's configuration (`LinkSpec` without its name), flattened: the
// optional chain and reorder are a flag and their fields.
copy struct LinkParams {
    base_delay_ns: u64,
    has_gilbert_elliott: bool,
    good_to_bad_ppm: u32,
    bad_to_good_ppm: u32,
    loss_good_ppm: u32,
    loss_bad_ppm: u32,
    loss_ppm: u32,
    duplicate_ppm: u32,
    has_reorder: bool,
    reorder_ppm: u32,
    reorder_extra_delay_ns: u64,
    buffer_packets: u32,
    rate_bytes_per_sec: u64
}

// What one transmission did (`Result<Transmission, LinkError>`): the
// Gilbert-Elliott state the datagram saw, then its fate.
copy enum TransmitOutcome {
    TimeOverflow,
    Lost(bool, u8),
    Delivered(bool, u64, u64, u64)
}

// One direction of a WAN path. `departures[head..]` are the departure times
// of queued datagrams, ascending; `head` skips the served ones.
struct LinkState {
    params: LinkParams,
    rng: u64,
    bad: bool,
    departures: ChunkSeq[u64],
    head: u64
}

fn max(a: u64, b: u64) -> u64 {
    if a > b {
        a
    } else {
        b
    }
}

fn at(in s: ChunkSeq[u64], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

// `a + b`, or None when it overflows.
fn add(a: u64, b: u64) -> Option[u64] {
    if a > wrapping_sub(U64_MAX, b) {
        Option::None
    } else {
        Option::Some(wrapping_add(a, b))
    }
}

// SplitMix64: advance the state and return the next output.
pub fn splitmix_next(inout state: u64) -> u64 {
    state = wrapping_add(state, SPLITMIX_GAMMA);
    let mut z = state;
    z = wrapping_mul(z ^ (z >> 30), SPLITMIX_MUL1);
    z = wrapping_mul(z ^ (z >> 27), SPLITMIX_MUL2);
    z ^ (z >> 31)
}

// One Bernoulli draw with probability `ppm / 10^6`. Always consumes one
// value, so the draw sequence does not depend on the probabilities.
pub fn splitmix_chance(inout state: u64, ppm: u32) -> bool {
    let x = splitmix_next(inout state);
    x % PPM < widen_u64(ppm)
}

// FNV-1a of a name, xor the seed rotated left by 17.
pub fn name_seed(seed: u64, in name: Str) -> u64 {
    let bytes = name.as_bytes();
    let n = bytes.len();
    let mut h = FNV_OFFSET;
    for i in 0..n {
        let b = match bytes.try_get(i) {
            Option::Some(b) => b,
            Option::None => 0,
        };
        h = wrapping_mul(h ^ widen_u64(b), FNV_PRIME);
    }
    h ^ ((seed << SEED_ROTATION) | (seed >> wrapping_sub(64, SEED_ROTATION)))
}

// Stationary probability of the Bad state, in ppm (rounded down).
pub fn stationary_bad_ppm(good_to_bad_ppm: u32, bad_to_good_ppm: u32) -> u32 {
    let g = widen_u64(good_to_bad_ppm);
    let total = wrapping_add(g, widen_u64(bad_to_good_ppm));
    if total == 0 {
        0
    } else {
        wrapping_u32(wrapping_mul(g, PPM) / total)
    }
}

// Stationary loss probability of the chain alone, in ppm.
pub fn stationary_loss_ppm(
    good_to_bad_ppm: u32,
    bad_to_good_ppm: u32,
    loss_good_ppm: u32,
    loss_bad_ppm: u32
) -> u32 {
    let bad = widen_u64(stationary_bad_ppm(good_to_bad_ppm, bad_to_good_ppm));
    let good = wrapping_sub(PPM, bad);
    let sum = wrapping_add(
        wrapping_mul(good, widen_u64(loss_good_ppm)),
        wrapping_mul(bad, widen_u64(loss_bad_ppm))
    );
    wrapping_u32(sum / PPM)
}

pub fn link_state_new(params: LinkParams, seed: u64, in name: Str) -> LinkState {
    LinkState {
        params: params,
        rng: name_seed(seed, in name),
        bad: false,
        departures: ChunkSeq::new[u64](),
        head: 0
    }
}

pub fn link_state_clone(in l: LinkState) -> LinkState {
    let n = l.departures.len();
    let mut departures: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](wrapping_sub(n, l.head));
    for i in l.head..n {
        departures.push(at(in l.departures, i));
    }
    LinkState {
        params: l.params,
        rng: l.rng,
        bad: l.bad,
        departures: departures,
        head: 0
    }
}

// The same state: configuration, generator, chain state and queue.
pub fn link_state_same(in a: LinkState, in b: LinkState) -> bool {
    let na = wrapping_sub(a.departures.len(), a.head);
    let nb = wrapping_sub(b.departures.len(), b.head);
    if a.rng != b.rng || a.bad != b.bad || na != nb {
        return false;
    }
    for i in 0..na {
        if at(in a.departures, wrapping_add(a.head, i))
            != at(in b.departures, wrapping_add(b.head, i)) {
            return false;
        }
    }
    true
}

pub fn link_state_in_bad_state(in l: LinkState) -> bool {
    l.bad
}

// The first queued index whose departure is after `t`.
fn served_until(in l: LinkState, t: u64) -> u64 {
    let mut lo = l.head;
    let mut hi = l.departures.len();
    loop {
        if lo >= hi {
            break;
        }
        let mid = wrapping_add(lo, wrapping_sub(hi, lo) >> 1);
        if at(in l.departures, mid) <= t {
            lo = wrapping_add(mid, 1);
        } else {
            hi = mid;
        }
    }
    lo
}

// Datagrams queued in the bottleneck at `at_ns`.
pub fn link_state_queued_at(in l: LinkState, at_ns: u64) -> u32 {
    wrapping_u32(wrapping_sub(l.departures.len(), served_until(in l, at_ns)))
}

// Service time of a datagram of `bytes`, rounded up (at least 1 ns). The
// product fits: bytes < 2^32 and 10^9 < 2^30.
pub fn link_state_service_ns(in l: LinkState, bytes: u32) -> u64 {
    service_ns(l.params.rate_bytes_per_sec, bytes)
}

fn service_ns(rate_bytes_per_sec: u64, bytes: u32) -> u64 {
    let rate = max(rate_bytes_per_sec, 1);
    let n = wrapping_mul(widen_u64(bytes), NS_PER_SEC);
    let mut ns = 0;
    if rate != 0 {
        ns = n / rate;
        if n % rate != 0 {
            ns = wrapping_add(ns, 1);
        }
    }
    max(ns, 1)
}

// Whether the next datagram is duplicated (one draw).
pub fn link_state_duplicates(inout l: LinkState) -> bool {
    splitmix_chance(inout l.rng, l.params.duplicate_ppm)
}

// Drop served departures: advance `head`, and compact once it is large.
fn discard_served(inout l: LinkState, now_ns: u64) {
    l.head = served_until(in l, now_ns);
    let n = l.departures.len();
    if l.head == n {
        l.departures.clear();
        l.head = 0;
    } else if l.head >= COMPACT_AT {
        for i in l.head..n {
            l.departures.try_set(wrapping_sub(i, l.head), at(in l.departures, i));
        }
        l.departures.truncate(wrapping_sub(n, l.head));
        l.head = 0;
    }
}

// Insert `departure` keeping the queue ascending (after equal entries).
fn insert_departure(inout l: LinkState, departure: u64) {
    let index = served_until(in l, departure);
    l.departures.push(departure);
    let mut i = wrapping_sub(l.departures.len(), 1);
    loop {
        if i <= index {
            break;
        }
        l.departures.try_set(i, at(in l.departures, wrapping_sub(i, 1)));
        i = wrapping_sub(i, 1);
    }
    l.departures.try_set(index, departure);
}

// Draw the fate of one datagram of `bytes` handed to the link at `at_ns`.
// `now_ns` is the virtual clock (never later than `at_ns`); queue entries
// that departed by then are discarded. Fixed draw order: GE step, GE loss,
// independent loss, reorder.
pub fn link_state_transmit(inout l: LinkState, now_ns: u64, at_ns: u64, bytes: u32)
    -> TransmitOutcome {
    discard_served(inout l, now_ns);
    let p = l.params;
    let mut ge_lost = false;
    if p.has_gilbert_elliott {
        let flip = if l.bad {
            splitmix_chance(inout l.rng, p.bad_to_good_ppm)
        } else {
            splitmix_chance(inout l.rng, p.good_to_bad_ppm)
        };
        if flip {
            l.bad = !l.bad;
        }
        let loss = if l.bad {
            p.loss_bad_ppm
        } else {
            p.loss_good_ppm
        };
        ge_lost = splitmix_chance(inout l.rng, loss);
    }
    let independent = splitmix_chance(inout l.rng, p.loss_ppm);
    let mut reordered = false;
    if p.has_reorder {
        reordered = splitmix_chance(inout l.rng, p.reorder_ppm);
    }
    let ge_bad = l.bad;
    if ge_lost {
        return TransmitOutcome::Lost(ge_bad, CAUSE_GILBERT_ELLIOTT);
    }
    if independent {
        return TransmitOutcome::Lost(ge_bad, CAUSE_INDEPENDENT);
    }
    if link_state_queued_at(in l, at_ns) >= p.buffer_packets {
        return TransmitOutcome::Lost(ge_bad, CAUSE_QUEUE_OVERFLOW);
    }
    let n = l.departures.len();
    let start = if n > l.head {
        max(at(in l.departures, wrapping_sub(n, 1)), at_ns)
    } else {
        at_ns
    };
    let departure = match add(start, service_ns(p.rate_bytes_per_sec, bytes)) {
        Option::Some(d) => d,
        Option::None => {
            return TransmitOutcome::TimeOverflow;
        },
    };
    let reorder_extra_ns = if reordered {
        p.reorder_extra_delay_ns
    } else {
        0
    };
    let arrive_at_ns = match add(departure, p.base_delay_ns) {
        Option::Some(t) => match add(t, reorder_extra_ns) {
            Option::Some(t) => t,
            Option::None => {
                return TransmitOutcome::TimeOverflow;
            },
        },
        Option::None => {
            return TransmitOutcome::TimeOverflow;
        },
    };
    insert_departure(inout l, departure);
    TransmitOutcome::Delivered(
        ge_bad,
        wrapping_sub(departure, at_ns),
        reorder_extra_ns,
        arrive_at_ns
    )
}

// SHA-256 of `bytes` (program.rs `sha256_hex`, before hex).
pub fn sha256(in bytes: Slice[u8]) -> ChunkSeq[u8] {
    sha256_digest(in bytes)
}

// The `wal-frame-v1` frame of one record (wal.rs `WalRecord::frame`).
pub fn wal_frame(lsn: u64, in payload: Str) -> ChunkSeq[u8] {
    frame_bytes(lsn, in payload.as_bytes())
}

// Recovery scan of a medium (wal.rs `scan`).
pub fn wal_scan(in bytes: Slice[u8]) -> ScanResult {
    scan_bytes(in bytes)
}

pub fn scan_result_records(in s: ScanResult) -> ChunkSeq[u64] {
    let mut out: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](s.records.len());
    out.extend(in s.records.as_slice());
    out
}

pub fn scan_result_valid_bytes(in s: ScanResult) -> u64 {
    s.valid_bytes
}

pub fn scan_result_damage(in s: ScanResult) -> (u8, u64, u64) {
    (s.damage, s.expected, s.found)
}

// ---------------------------------------------------------------------------
// Part 3: the virtual message network `net-v1` (src/model/net.rs).
//
// The Vesper state owns every decision: message ids, link delays,
// partitions, the send-time bounds and reservations, and the FIFO order of
// each endpoint's inbox and waiting receivers. The Rust wrapper keeps the
// payloads, keyed by message id, so no string crosses the boundary.

// Drop reasons, in the order of `DropReason` in net.rs.
const DROP_PARTITIONED: u8 = 0;
const DROP_DESTINATION_DOWN: u8 = 1;
// Words per entry of the flat tables below.
const DELAY_WORDS: u64 = 3;
const PAIR_WORDS: u64 = 2;
const FLIGHT_WORDS: u64 = 3;
// What `net_state_take_queued` returns for an empty inbox. Message ids
// start at 1.
const NO_MESSAGE: u64 = 0;

// What a send did (`Result<Sent, NetError>`), without the payload.
copy enum SendOutcome {
    // The payload's byte length.
    TooLarge(u64),
    InFlightFull,
    InboxFull,
    // The message id and its delivery time.
    InFlight(u64, u64),
    // The message id, its delivery time and the drop reason.
    Dropped(u64, u64, u8)
}

// What an arrival did (`Option<Arrival>`), without the message.
copy enum ArriveOutcome {
    Unknown,
    // Handed to this waiting receive request.
    Delivered(u64),
    Queued,
    Dropped(u8)
}

// The network. Endpoint tables are parallel to `endpoints` (ascending).
struct NetState {
    max_in_flight: u64,
    max_inbox: u64,
    max_message_bytes: u64,
    default_delay_ns: u64,
    next_message: u64,
    // (from, to, delay_ns) triples, ascending by (from, to).
    delays: ChunkSeq[u64],
    endpoints: ChunkSeq[u64],
    // Messages in flight to each endpoint.
    reserved: ChunkSeq[u64],
    // Messages in each endpoint's inbox.
    queued: ChunkSeq[u64],
    // (min, max) endpoint pairs, ascending.
    partitions: ChunkSeq[u64],
    // (id, from, to) triples, ascending by id.
    flight: ChunkSeq[u64],
    // (endpoint, id) pairs, oldest first.
    inbox: ChunkSeq[u64],
    // (endpoint, request) pairs, oldest first.
    waiters: ChunkSeq[u64]
}

fn copy_words(in s: ChunkSeq[u64]) -> ChunkSeq[u64] {
    let mut out: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](s.len());
    out.extend(in s.as_slice());
    out
}

fn same_words(in a: ChunkSeq[u64], in b: ChunkSeq[u64]) -> bool {
    let n = a.len();
    if n != b.len() {
        return false;
    }
    for i in 0..n {
        if at(in a, i) != at(in b, i) {
            return false;
        }
    }
    true
}

// Remove the `width` words at `start`, keeping the order of the rest.
fn remove_words(inout s: ChunkSeq[u64], start: u64, width: u64) {
    let n = s.len();
    for i in wrapping_add(start, width)..n {
        s.try_set(wrapping_sub(i, width), at(in s, i));
    }
    s.truncate(wrapping_sub(n, width));
}

fn min(a: u64, b: u64) -> u64 {
    if a < b {
        a
    } else {
        b
    }
}

// The index of `endpoint` in `endpoints`, or its length when unknown.
fn endpoint_index(in n: NetState, endpoint: u64) -> u64 {
    let count = n.endpoints.len();
    for i in 0..count {
        if at(in n.endpoints, i) == endpoint {
            return i;
        }
    }
    count
}

// The word offset of the (min, max) pair in `partitions`, or where it
// would go, and whether it is there.
fn partition_at(in n: NetState, a: u64, b: u64) -> (u64, bool) {
    let lo = min(a, b);
    let hi = max(a, b);
    let len = n.partitions.len();
    let mut i: u64 = 0;
    loop {
        if i >= len {
            return (len, false);
        }
        let x = at(in n.partitions, i);
        let y = at(in n.partitions, wrapping_add(i, 1));
        if x == lo && y == hi {
            return (i, true);
        }
        if x > lo || (x == lo && y > hi) {
            return (i, false);
        }
        i = wrapping_add(i, PAIR_WORDS);
    }
}

// Words `delays` as (from, to, delay_ns) triples ascending by (from, to)
// and `endpoints` ascending, as the Rust maps iterate.
pub fn net_state_new(
    max_in_flight: u64,
    max_inbox: u64,
    max_message_bytes: u64,
    default_delay_ns: u64,
    in delays: Slice[u64],
    in endpoints: Slice[u64]
) -> NetState {
    let count = endpoints.len();
    let mut d: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](delays.len());
    d.extend(in delays);
    let mut e: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](count);
    e.extend(in endpoints);
    let mut reserved: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](count);
    let mut queued: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](count);
    for _ in 0..count {
        reserved.push(0);
        queued.push(0);
    }
    NetState {
        max_in_flight: max_in_flight,
        max_inbox: max_inbox,
        max_message_bytes: max_message_bytes,
        default_delay_ns: default_delay_ns,
        next_message: 1,
        delays: d,
        endpoints: e,
        reserved: reserved,
        queued: queued,
        partitions: ChunkSeq::new[u64](),
        flight: ChunkSeq::new[u64](),
        inbox: ChunkSeq::new[u64](),
        waiters: ChunkSeq::new[u64]()
    }
}

pub fn net_state_clone(in n: NetState) -> NetState {
    NetState {
        max_in_flight: n.max_in_flight,
        max_inbox: n.max_inbox,
        max_message_bytes: n.max_message_bytes,
        default_delay_ns: n.default_delay_ns,
        next_message: n.next_message,
        delays: copy_words(in n.delays),
        endpoints: copy_words(in n.endpoints),
        reserved: copy_words(in n.reserved),
        queued: copy_words(in n.queued),
        partitions: copy_words(in n.partitions),
        flight: copy_words(in n.flight),
        inbox: copy_words(in n.inbox),
        waiters: copy_words(in n.waiters)
    }
}

pub fn net_state_same(in a: NetState, in b: NetState) -> bool {
    let limits_a = (a.max_in_flight, a.max_inbox, a.max_message_bytes);
    let limits_b = (b.max_in_flight, b.max_inbox, b.max_message_bytes);
    if limits_a != limits_b {
        return false;
    }
    if a.default_delay_ns != b.default_delay_ns || a.next_message != b.next_message {
        return false;
    }
    same_words(in a.delays, in b.delays)
        && same_words(in a.endpoints, in b.endpoints)
        && same_words(in a.reserved, in b.reserved)
        && same_words(in a.queued, in b.queued)
        && same_words(in a.partitions, in b.partitions)
        && same_words(in a.flight, in b.flight)
        && same_words(in a.inbox, in b.inbox)
        && same_words(in a.waiters, in b.waiters)
}

pub fn net_state_has_endpoint(in n: NetState, endpoint: u64) -> bool {
    endpoint_index(in n, endpoint) < n.endpoints.len()
}

pub fn net_state_is_partitioned(in n: NetState, a: u64, b: u64) -> bool {
    let (_, found) = partition_at(in n, a, b);
    found
}

pub fn net_state_delay(in n: NetState, from: u64, to: u64) -> u64 {
    let len = n.delays.len();
    let mut i: u64 = 0;
    loop {
        if i >= len {
            return n.default_delay_ns;
        }
        if at(in n.delays, i) == from && at(in n.delays, wrapping_add(i, 1)) == to {
            return at(in n.delays, wrapping_add(i, 2));
        }
        i = wrapping_add(i, DELAY_WORDS);
    }
}

// Returns whether the partition is new.
pub fn net_state_partition(inout n: NetState, a: u64, b: u64) -> bool {
    let (index, found) = partition_at(in n, a, b);
    if found {
        return false;
    }
    let len = n.partitions.len();
    n.partitions.push(0);
    n.partitions.push(0);
    let mut i = len;
    loop {
        if i <= index {
            break;
        }
        let from = wrapping_sub(i, PAIR_WORDS);
        n.partitions.try_set(i, at(in n.partitions, from));
        n.partitions.try_set(wrapping_add(i, 1), at(in n.partitions, wrapping_add(from, 1)));
        i = from;
    }
    n.partitions.try_set(index, min(a, b));
    n.partitions.try_set(wrapping_add(index, 1), max(a, b));
    true
}

// Returns whether a partition was removed.
pub fn net_state_heal(inout n: NetState, a: u64, b: u64) -> bool {
    let (index, found) = partition_at(in n, a, b);
    if found {
        remove_words(inout n.partitions, index, PAIR_WORDS);
    }
    found
}

// Validate the bounds and either put the message in flight or drop it.
// `to` must be a known endpoint; `destination_up` is its process state.
pub fn net_state_send(
    inout n: NetState,
    from: u64,
    to: u64,
    bytes: u64,
    now_ns: u64,
    destination_up: bool
) -> SendOutcome {
    if bytes > n.max_message_bytes {
        return SendOutcome::TooLarge(bytes);
    }
    let id = n.next_message;
    let delay = net_state_delay(in n, from, to);
    let deliver_at_ns = if now_ns > wrapping_sub(U64_MAX, delay) {
        U64_MAX
    } else {
        wrapping_add(now_ns, delay)
    };
    if net_state_is_partitioned(in n, from, to) {
        n.next_message = wrapping_add(id, 1);
        return SendOutcome::Dropped(id, deliver_at_ns, DROP_PARTITIONED);
    }
    if !destination_up {
        n.next_message = wrapping_add(id, 1);
        return SendOutcome::Dropped(id, deliver_at_ns, DROP_DESTINATION_DOWN);
    }
    if n.flight.len() / FLIGHT_WORDS >= n.max_in_flight {
        return SendOutcome::InFlightFull;
    }
    let e = endpoint_index(in n, to);
    let reserved = at(in n.reserved, e);
    if wrapping_add(reserved, at(in n.queued, e)) >= n.max_inbox {
        return SendOutcome::InboxFull;
    }
    n.next_message = wrapping_add(id, 1);
    n.reserved.try_set(e, wrapping_add(reserved, 1));
    n.flight.push(id);
    n.flight.push(from);
    n.flight.push(to);
    SendOutcome::InFlight(id, deliver_at_ns)
}

// The message's link delay elapsed.
pub fn net_state_arrive(inout n: NetState, id: u64, destination_up: bool) -> ArriveOutcome {
    let len = n.flight.len();
    let mut i: u64 = 0;
    loop {
        if i >= len {
            return ArriveOutcome::Unknown;
        }
        if at(in n.flight, i) == id {
            break;
        }
        i = wrapping_add(i, FLIGHT_WORDS);
    }
    let from = at(in n.flight, wrapping_add(i, 1));
    let to = at(in n.flight, wrapping_add(i, 2));
    remove_words(inout n.flight, i, FLIGHT_WORDS);
    let e = endpoint_index(in n, to);
    n.reserved.try_set(e, wrapping_sub(at(in n.reserved, e), 1));
    if net_state_is_partitioned(in n, from, to) {
        return ArriveOutcome::Dropped(DROP_PARTITIONED);
    }
    if !destination_up {
        return ArriveOutcome::Dropped(DROP_DESTINATION_DOWN);
    }
    let w = first_of(in n.waiters, to);
    if w < n.waiters.len() {
        let request = at(in n.waiters, wrapping_add(w, 1));
        remove_words(inout n.waiters, w, PAIR_WORDS);
        return ArriveOutcome::Delivered(request);
    }
    n.inbox.push(to);
    n.inbox.push(id);
    n.queued.try_set(e, wrapping_add(at(in n.queued, e), 1));
    ArriveOutcome::Queued
}

// The word offset of `endpoint`'s oldest (endpoint, value) pair, or the
// length when it has none.
fn first_of(in pairs: ChunkSeq[u64], endpoint: u64) -> u64 {
    let len = pairs.len();
    let mut i: u64 = 0;
    loop {
        if i >= len || at(in pairs, i) == endpoint {
            return i;
        }
        i = wrapping_add(i, PAIR_WORDS);
    }
}

// The values of `endpoint`'s pairs, oldest first.
fn values_of(in pairs: ChunkSeq[u64], endpoint: u64) -> ChunkSeq[u64] {
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let len = pairs.len();
    let mut i: u64 = 0;
    loop {
        if i >= len {
            return out;
        }
        if at(in pairs, i) == endpoint {
            out.push(at(in pairs, wrapping_add(i, 1)));
        }
        i = wrapping_add(i, PAIR_WORDS);
    }
}

// Take the oldest queued message id, or NO_MESSAGE.
pub fn net_state_take_queued(inout n: NetState, endpoint: u64) -> u64 {
    let i = first_of(in n.inbox, endpoint);
    if i >= n.inbox.len() {
        return NO_MESSAGE;
    }
    let id = at(in n.inbox, wrapping_add(i, 1));
    remove_words(inout n.inbox, i, PAIR_WORDS);
    let e = endpoint_index(in n, endpoint);
    n.queued.try_set(e, wrapping_sub(at(in n.queued, e), 1));
    id
}

pub fn net_state_wait(inout n: NetState, endpoint: u64, request: u64) {
    n.waiters.push(endpoint);
    n.waiters.push(request);
}

// Remove a waiting request (for a timeout). Returns whether it waited.
pub fn net_state_cancel_wait(inout n: NetState, endpoint: u64, request: u64) -> bool {
    let len = n.waiters.len();
    let mut i: u64 = 0;
    loop {
        if i >= len {
            return false;
        }
        if at(in n.waiters, i) == endpoint && at(in n.waiters, wrapping_add(i, 1)) == request {
            remove_words(inout n.waiters, i, PAIR_WORDS);
            return true;
        }
        i = wrapping_add(i, PAIR_WORDS);
    }
}

// Crash: drop the endpoint's inbox and waiters (read them first with
// `net_state_inbox` and `net_state_waiting`).
pub fn net_state_crash(inout n: NetState, endpoint: u64) {
    let mut keep: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](n.inbox.len());
    let len = n.inbox.len();
    let mut i: u64 = 0;
    loop {
        if i >= len {
            break;
        }
        if at(in n.inbox, i) != endpoint {
            keep.push(at(in n.inbox, i));
            keep.push(at(in n.inbox, wrapping_add(i, 1)));
        }
        i = wrapping_add(i, PAIR_WORDS);
    }
    n.inbox = keep;
    let mut kept: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](n.waiters.len());
    let wlen = n.waiters.len();
    let mut j: u64 = 0;
    loop {
        if j >= wlen {
            break;
        }
        if at(in n.waiters, j) != endpoint {
            kept.push(at(in n.waiters, j));
            kept.push(at(in n.waiters, wrapping_add(j, 1)));
        }
        j = wrapping_add(j, PAIR_WORDS);
    }
    n.waiters = kept;
    let e = endpoint_index(in n, endpoint);
    n.queued.try_set(e, 0);
}

// Endpoint ids, ascending.
pub fn net_state_endpoints(in n: NetState) -> ChunkSeq[u64] {
    copy_words(in n.endpoints)
}

// (min, max) pairs, ascending.
pub fn net_state_partitions(in n: NetState) -> ChunkSeq[u64] {
    copy_words(in n.partitions)
}

// In-flight message ids, ascending.
pub fn net_state_in_flight(in n: NetState) -> ChunkSeq[u64] {
    let mut out: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](n.flight.len() / FLIGHT_WORDS);
    let len = n.flight.len();
    let mut i: u64 = 0;
    loop {
        if i >= len {
            return out;
        }
        out.push(at(in n.flight, i));
        i = wrapping_add(i, FLIGHT_WORDS);
    }
}

// `endpoint`'s queued message ids, oldest first.
pub fn net_state_inbox(in n: NetState, endpoint: u64) -> ChunkSeq[u64] {
    values_of(in n.inbox, endpoint)
}

// `endpoint`'s waiting requests, oldest first.
pub fn net_state_waiting(in n: NetState, endpoint: u64) -> ChunkSeq[u64] {
    values_of(in n.waiters, endpoint)
}

// ---------------------------------------------------------------------------
// Part 4: the write-ahead log state machine (`Wal` in src/model/wal.rs).
//
// The Vesper state owns the medium's bytes, LSN assignment, the volatile and
// in-flight regions (as their frames, built at append), the bounds, flush
// completion and failure, and crash clamping with torn tails. The Rust
// wrapper keeps each live record's payload string, keyed by LSN.

// The frame header: length, LSN and check.
const WAL_FRAME_HEADER_BYTES: u64 = 20;
const U32_MAX: u64 = 4294967295;
// What `wal_state_view_lsn` returns past the end of the view. LSNs start
// at 1.
const NO_LSN: u64 = 0;

// `Result<u64, WalError>`: the value is the LSN for an append, the batch
// size for a flush, and 0 otherwise.
copy enum WalResult {
    Ok(u64),
    NotRecovered,
    AlreadyRecovered,
    FlushInFlight,
    NoFlushInFlight,
    // The payload's bytes and the limit.
    RecordTooLarge(u64, u64),
    // The records and framed bytes the append would reach.
    LogFull(u64, u64)
}

// What a crash did (`CrashApplied`).
copy struct WalCrash {
    volatile_lost: u64,
    in_flight_records: u64,
    persisted_records: u64,
    torn_bytes: u64
}

struct WalState {
    max_records: u64,
    max_bytes: u64,
    max_record_bytes: u64,
    // The simulated medium.
    durable: ChunkSeq[u8],
    // LSNs of the durable records visible to this epoch.
    view: ChunkSeq[u64],
    // (lsn, frame_len) pairs: the in-flight batch, then the volatile region.
    pending: ChunkSeq[u64],
    // The frames of `pending`, concatenated.
    frames: ChunkSeq[u8],
    // How many records at the front of `pending` are in flight.
    in_flight: u64,
    flushing: bool,
    request: u64,
    next_lsn: u64,
    recovered: bool,
    // Bumped by every crash.
    generation: u64
}

// A recovery: whether the log was open for it, and the scan.
struct WalRecovery {
    ok: bool,
    scan: ScanResult
}

fn byte_of(in s: ChunkSeq[u8], i: u64) -> u8 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

fn copy_bytes(in s: ChunkSeq[u8]) -> ChunkSeq[u8] {
    let mut out: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](s.len());
    out.extend(in s.as_slice());
    out
}

fn same_bytes(in a: ChunkSeq[u8], in b: ChunkSeq[u8]) -> bool {
    a.as_slice().eq(in b.as_slice())
}

// Append `frames[start..end]` to the medium.
fn persist(inout w: WalState, start: u64, end: u64) {
    for i in start..end {
        w.durable.push(byte_of(in w.frames, i));
    }
}

// Bytes of the first `count` pending frames.
fn pending_bytes(in w: WalState, count: u64) -> u64 {
    let mut total: u64 = 0;
    for i in 0..count {
        total = wrapping_add(total, at(in w.pending, wrapping_add(wrapping_mul(i, PAIR_WORDS), 1)));
    }
    total
}

// Drop the first `count` pending records and their frames.
fn drop_pending(inout w: WalState, count: u64) {
    let bytes = pending_bytes(in w, count);
    let n = w.frames.len();
    for i in bytes..n {
        w.frames.try_set(wrapping_sub(i, bytes), byte_of(in w.frames, i));
    }
    w.frames.truncate(wrapping_sub(n, bytes));
    remove_words(inout w.pending, 0, wrapping_mul(count, PAIR_WORDS));
}

fn pending_count(in w: WalState) -> u64 {
    w.pending.len() / PAIR_WORDS
}

pub fn wal_state_new(max_records: u64, max_bytes: u64, max_record_bytes: u64) -> WalState {
    WalState {
        max_records: max_records,
        max_bytes: max_bytes,
        max_record_bytes: max_record_bytes,
        durable: ChunkSeq::new[u8](),
        view: ChunkSeq::new[u64](),
        pending: ChunkSeq::new[u64](),
        frames: ChunkSeq::new[u8](),
        in_flight: 0,
        flushing: false,
        request: 0,
        next_lsn: 1,
        recovered: false,
        generation: 0
    }
}

pub fn wal_state_clone(in w: WalState) -> WalState {
    WalState {
        max_records: w.max_records,
        max_bytes: w.max_bytes,
        max_record_bytes: w.max_record_bytes,
        durable: copy_bytes(in w.durable),
        view: copy_words(in w.view),
        pending: copy_words(in w.pending),
        frames: copy_bytes(in w.frames),
        in_flight: w.in_flight,
        flushing: w.flushing,
        request: w.request,
        next_lsn: w.next_lsn,
        recovered: w.recovered,
        generation: w.generation
    }
}

pub fn wal_state_same(in a: WalState, in b: WalState) -> bool {
    let limits_a = (a.max_records, a.max_bytes, a.max_record_bytes);
    let limits_b = (b.max_records, b.max_bytes, b.max_record_bytes);
    if limits_a != limits_b {
        return false;
    }
    let flush_a = (a.in_flight, a.flushing, a.request);
    let flush_b = (b.in_flight, b.flushing, b.request);
    if flush_a != flush_b {
        return false;
    }
    let epoch_a = (a.next_lsn, a.recovered, a.generation);
    let epoch_b = (b.next_lsn, b.recovered, b.generation);
    if epoch_a != epoch_b {
        return false;
    }
    same_bytes(in a.durable, in b.durable)
        && same_words(in a.view, in b.view)
        && same_words(in a.pending, in b.pending)
        && same_bytes(in a.frames, in b.frames)
}

pub fn wal_state_durable(in w: WalState) -> ChunkSeq[u8] {
    copy_bytes(in w.durable)
}

pub fn wal_state_durable_len(in w: WalState) -> u64 {
    w.durable.len()
}

pub fn wal_state_generation(in w: WalState) -> u64 {
    w.generation
}

pub fn wal_state_is_recovered(in w: WalState) -> bool {
    w.recovered
}

// Highest durable LSN visible to this epoch, or 0.
pub fn wal_state_durable_lsn(in w: WalState) -> u64 {
    let n = w.view.len();
    if n == 0 {
        0
    } else {
        at(in w.view, wrapping_sub(n, 1))
    }
}

pub fn wal_state_view_len(in w: WalState) -> u64 {
    w.view.len()
}

// The LSN of the `index`th visible durable record, or NO_LSN.
pub fn wal_state_view_lsn(in w: WalState, index: u64) -> u64 {
    match w.view.try_get(index) {
        Option::Some(lsn) => lsn,
        Option::None => NO_LSN,
    }
}

pub fn wal_state_view_lsns(in w: WalState) -> ChunkSeq[u64] {
    copy_words(in w.view)
}

// LSNs of the in-flight batch, oldest first; empty without a flush.
pub fn wal_state_in_flight_lsns(in w: WalState) -> ChunkSeq[u64] {
    let mut out: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](w.in_flight);
    for i in 0..w.in_flight {
        out.push(at(in w.pending, wrapping_mul(i, PAIR_WORDS)));
    }
    out
}

pub fn wal_state_is_flushing(in w: WalState) -> bool {
    w.flushing
}

pub fn wal_state_request(in w: WalState) -> u64 {
    w.request
}

// LSNs of the volatile region, oldest first.
pub fn wal_state_volatile_lsns(in w: WalState) -> ChunkSeq[u64] {
    let count = pending_count(in w);
    let mut out: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](wrapping_sub(count, w.in_flight));
    for i in w.in_flight..count {
        out.push(at(in w.pending, wrapping_mul(i, PAIR_WORDS)));
    }
    out
}

// Open the log for this epoch: scan, truncate damage, and continue LSNs
// after the last valid record.
pub fn wal_state_recover(inout w: WalState) -> WalRecovery {
    let scan = scan_bytes(in w.durable.as_slice());
    if w.recovered {
        return WalRecovery {
            ok: false,
            scan: scan
        };
    }
    w.durable.truncate(scan.valid_bytes);
    w.view.clear();
    let triples = scan.records.len();
    let mut i: u64 = 0;
    loop {
        if i >= triples {
            break;
        }
        w.view.push(at(in scan.records, i));
        i = wrapping_add(i, 3);
    }
    w.next_lsn = wrapping_add(wal_state_durable_lsn(in w), 1);
    w.recovered = true;
    WalRecovery {
        ok: true,
        scan: scan
    }
}

pub fn wal_recovery_ok(in r: WalRecovery) -> bool {
    r.ok
}

// (lsn, start, len) triples of the recovered records, with ranges into
// the medium after recovery.
pub fn wal_recovery_records(in r: WalRecovery) -> ChunkSeq[u64] {
    scan_result_records(in r.scan)
}

pub fn wal_recovery_valid_bytes(in r: WalRecovery) -> u64 {
    r.scan.valid_bytes
}

pub fn wal_recovery_damage(in r: WalRecovery) -> (u8, u64, u64) {
    scan_result_damage(in r.scan)
}

// Check that a payload of `len` bytes can be appended without exceeding a
// bound.
pub fn wal_state_check_append(in w: WalState, len: u64) -> WalResult {
    if !w.recovered {
        return WalResult::NotRecovered;
    }
    if len > w.max_record_bytes || len > U32_MAX {
        return WalResult::RecordTooLarge(len, w.max_record_bytes);
    }
    let records = wrapping_add(wrapping_add(w.view.len(), pending_count(in w)), 1);
    let used = wrapping_add(w.durable.len(), w.frames.len());
    let bytes = wrapping_add(wrapping_add(used, WAL_FRAME_HEADER_BYTES), len);
    if records > w.max_records || bytes > w.max_bytes {
        return WalResult::LogFull(records, bytes);
    }
    WalResult::Ok(0)
}

// Append to the volatile region; the result holds the assigned LSN.
pub fn wal_state_append(inout w: WalState, in payload: Str) -> WalResult {
    let bytes = payload.as_bytes();
    match wal_state_check_append(in w, bytes.len()) {
        WalResult::Ok(_) => {},
        other => {
            return other;
        },
    }
    let lsn = w.next_lsn;
    w.next_lsn = wrapping_add(lsn, 1);
    let frame = frame_bytes(lsn, in bytes);
    w.pending.push(lsn);
    w.pending.push(frame.len());
    w.frames.extend(in frame.as_slice());
    WalResult::Ok(lsn)
}

pub fn wal_state_check_flush(in w: WalState) -> WalResult {
    if !w.recovered {
        return WalResult::NotRecovered;
    }
    if w.flushing {
        return WalResult::FlushInFlight;
    }
    WalResult::Ok(0)
}

// Move every volatile record into the in-flight batch.
pub fn wal_state_begin_flush(inout w: WalState, request: u64) -> WalResult {
    match wal_state_check_flush(in w) {
        WalResult::Ok(_) => {},
        other => {
            return other;
        },
    }
    w.in_flight = pending_count(in w);
    w.flushing = true;
    w.request = request;
    WalResult::Ok(w.in_flight)
}

// The device acknowledged the flush: the batch becomes durable.
pub fn wal_state_complete_flush(inout w: WalState) -> WalResult {
    if !w.flushing {
        return WalResult::NoFlushInFlight;
    }
    let count = w.in_flight;
    persist(inout w, 0, pending_bytes(in w, count));
    for i in 0..count {
        w.view.push(at(in w.pending, wrapping_mul(i, PAIR_WORDS)));
    }
    drop_pending(inout w, count);
    w.in_flight = 0;
    w.flushing = false;
    WalResult::Ok(count)
}

// The device reported failure: the batch returns, oldest first, to the
// front of the volatile region (it is already there in `pending`).
pub fn wal_state_fail_flush(inout w: WalState) -> WalResult {
    if !w.flushing {
        return WalResult::NoFlushInFlight;
    }
    let count = w.in_flight;
    w.in_flight = 0;
    w.flushing = false;
    WalResult::Ok(count)
}

// Process crash: volatile records vanish; the first `persisted` in-flight
// records reach the medium whole and, if a further record exists, `torn`
// bytes of its frame (clamped below the full frame) follow.
pub fn wal_state_crash(inout w: WalState, persisted: u64, torn: u64) -> WalCrash {
    let in_flight = if w.flushing {
        w.in_flight
    } else {
        0
    };
    let persisted = min(persisted, in_flight);
    let whole = pending_bytes(in w, persisted);
    persist(inout w, 0, whole);
    let mut torn_bytes: u64 = 0;
    if persisted < in_flight && torn > 0 {
        let frame_len = at(in w.pending, wrapping_add(wrapping_mul(persisted, PAIR_WORDS), 1));
        torn_bytes = min(torn, wrapping_sub(frame_len, 1));
        persist(inout w, whole, wrapping_add(whole, torn_bytes));
    }
    let volatile_lost = wrapping_sub(pending_count(in w), in_flight);
    w.pending.clear();
    w.frames.clear();
    w.view.clear();
    w.in_flight = 0;
    w.flushing = false;
    w.recovered = false;
    w.generation = wrapping_add(w.generation, 1);
    WalCrash {
        volatile_lost: volatile_lost,
        in_flight_records: in_flight,
        persisted_records: persisted,
        torn_bytes: torn_bytes
    }
}

// ---------------------------------------------------------------------------
// Part 6: the Warp QUIC wire codec (src/model/umem.rs and warp.rs): the
// short header, the fixed-width ACK frame (RFC 9000 §19.3 fields as
// big-endian integers) and the peer's ACK range bookkeeping.

// QUIC short header: flags byte, 8-byte DCID, 4-byte truncated PN.
const SHORT_HEADER_BYTES: u64 = 13;
// Error codes delivered to source as `Err(code)`; 0 is success here.
const QUIC_OK: u32 = 0;
const ERR_TRUNCATED: u32 = 1;
const ERR_LONG_HEADER: u32 = 2;
const ERR_FIXED_BIT: u32 = 3;
const ERR_NOT_ACK: u32 = 4;
const ERR_BAD_ACK: u32 = 5;
// Header bits: the long-header form bit and the fixed bit.
const FORM_BIT: u8 = 128;
const FIXED_BIT: u8 = 64;
const DCID_AT: u64 = 1;
const PN_AT: u64 = 9;
// Packet numbers are below 2^62 (RFC 9000 §12.3).
const MAX_PACKET_NUMBER: u64 = 4611686018427387903;
const ACK_FRAME_TYPE: u8 = 2;
// Type, largest, delay, range count, first range.
const ACK_FRAME_FIXED_BYTES: u32 = 29;
// Each additional ACK range: gap and length.
const ACK_RANGE_BYTES: u64 = 16;
// RFC 9000 §19.3.1: the next largest is the previous smallest - gap - 2.
const ACK_GAP_BIAS: u64 = 2;

// `(code, first_byte, dcid, truncated pn)` of a short header; `code` is
// QUIC_OK or the error.
pub fn parse_short_header(in bytes: Slice[u8]) -> (u32, u8, u64, u32) {
    if bytes.len() < SHORT_HEADER_BYTES {
        return (ERR_TRUNCATED, 0, 0, 0);
    }
    let first = match bytes.try_get(0) {
        Option::Some(b) => b,
        Option::None => 0,
    };
    if first & FORM_BIT != 0 {
        return (ERR_LONG_HEADER, 0, 0, 0);
    }
    if first & FIXED_BIT == 0 {
        return (ERR_FIXED_BIT, 0, 0, 0);
    }
    let dcid = match bytes.try_read_u64_be(DCID_AT) {
        Option::Some(v) => v,
        Option::None => 0,
    };
    let pn = match bytes.try_read_u32_be(PN_AT) {
        Option::Some(v) => v,
        Option::None => 0,
    };
    (QUIC_OK, first, dcid, pn)
}

// A datagram whose payload starts with an ACK frame, as words:
// `[code, dcid, largest, ack_delay_ns, lo0, hi0, lo1, hi1, ...]` with the
// ranges largest first, or just `[code]` for an error.
pub fn parse_ack(in bytes: Slice[u8]) -> ChunkSeq[u64] {
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let (code, _, dcid, _) = parse_short_header(in bytes);
    if code != QUIC_OK {
        out.push(widen_u64(code));
        return out;
    }
    let n = bytes.len();
    let kind = match bytes.try_get(SHORT_HEADER_BYTES) {
        Option::Some(b) => b,
        Option::None => 0,
    };
    if n <= SHORT_HEADER_BYTES || kind != ACK_FRAME_TYPE {
        out.push(widen_u64(ERR_NOT_ACK));
        return out;
    }
    let payload_len = wrapping_sub(n, SHORT_HEADER_BYTES);
    // The fixed fields, at offsets from the frame type.
    let base = wrapping_add(SHORT_HEADER_BYTES, 1);
    let fixed = widen_u64(ACK_FRAME_FIXED_BYTES);
    if payload_len < fixed {
        out.push(widen_u64(ERR_BAD_ACK));
        return out;
    }
    let largest = be64(in bytes, base);
    let ack_delay_ns = be64(in bytes, wrapping_add(base, 8));
    let count = match bytes.try_read_u32_be(wrapping_add(base, 16)) {
        Option::Some(v) => widen_u64(v),
        Option::None => 0,
    };
    let first = be64(in bytes, wrapping_add(base, 20));
    if largest > MAX_PACKET_NUMBER || first > largest {
        out.push(widen_u64(ERR_BAD_ACK));
        return out;
    }
    let mut hi = largest;
    let mut lo = wrapping_sub(hi, first);
    if wrapping_mul(count, ACK_RANGE_BYTES) > payload_len {
        out.push(widen_u64(ERR_BAD_ACK));
        return out;
    }
    let mut ranges: ChunkSeq[u64] = ChunkSeq::new[u64]();
    ranges.push(lo);
    ranges.push(hi);
    let mut at_byte = wrapping_add(SHORT_HEADER_BYTES, fixed);
    for _ in 0..count {
        if wrapping_add(at_byte, ACK_RANGE_BYTES) > n {
            out.push(widen_u64(ERR_BAD_ACK));
            return out;
        }
        let gap = be64(in bytes, at_byte);
        let len = be64(in bytes, wrapping_add(at_byte, 8));
        at_byte = wrapping_add(at_byte, ACK_RANGE_BYTES);
        if gap > lo || wrapping_sub(lo, gap) < ACK_GAP_BIAS {
            out.push(widen_u64(ERR_BAD_ACK));
            return out;
        }
        hi = wrapping_sub(wrapping_sub(lo, gap), ACK_GAP_BIAS);
        if len > hi {
            out.push(widen_u64(ERR_BAD_ACK));
            return out;
        }
        lo = wrapping_sub(hi, len);
        ranges.push(lo);
        ranges.push(hi);
    }
    out.push(widen_u64(QUIC_OK));
    out.push(dcid);
    out.push(largest);
    out.push(ack_delay_ns);
    out.extend(in ranges.as_slice());
    out
}

fn be64(in bytes: Slice[u8], at: u64) -> u64 {
    match bytes.try_read_u64_be(at) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

fn push_be64(inout out: ChunkSeq[u8], v: u64) {
    let at = out.len();
    out.resize(wrapping_add(at, 8), 0);
    out.try_write_u64_be(at, v);
}

// Encode an ACK frame for `(lo, hi)` word pairs given largest first,
// disjoint and separated by at least one missing packet number (at least
// one pair).
pub fn ack_frame_bytes(in ranges: Slice[u64], ack_delay_ns: u64) -> ChunkSeq[u8] {
    let pairs = ranges.len() / PAIR_WORDS;
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    out.push(ACK_FRAME_TYPE);
    let lo0 = word_of(in ranges, 0);
    let hi0 = word_of(in ranges, 1);
    push_be64(inout out, hi0);
    push_be64(inout out, ack_delay_ns);
    let at = out.len();
    out.resize(wrapping_add(at, 4), 0);
    out.try_write_u32_be(at, wrapping_u32(wrapping_sub(pairs, 1)));
    push_be64(inout out, wrapping_sub(hi0, lo0));
    let mut prev_lo = lo0;
    for i in 1..pairs {
        let lo = word_of(in ranges, wrapping_mul(i, PAIR_WORDS));
        let hi = word_of(in ranges, wrapping_add(wrapping_mul(i, PAIR_WORDS), 1));
        push_be64(inout out, wrapping_sub(wrapping_sub(prev_lo, hi), ACK_GAP_BIAS));
        push_be64(inout out, wrapping_sub(hi, lo));
        prev_lo = lo;
    }
    out
}

fn word_of(in s: Slice[u64], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

// The bytes of a datagram's materialised head.
pub fn short_header(first_byte: u8, dcid: u64, pkt_num: u64) -> ChunkSeq[u8] {
    let mut out: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](SHORT_HEADER_BYTES);
    out.push(first_byte);
    push_be64(inout out, dcid);
    // Truncation to the low 32 bits is the wire encoding (4-byte PN field).
    let at = out.len();
    out.resize(wrapping_add(at, 4), 0);
    out.try_write_u32_be(at, wrapping_u32(pkt_num));
    out
}

// Bytes of an ACK datagram carrying `ranges` ranges.
pub fn ack_datagram_len(ranges: u32) -> u32 {
    let extra = if ranges > 0 {
        wrapping_sub(ranges, 1)
    } else {
        0
    };
    wrapping_add(
        wrapping_add(wrapping_u32(SHORT_HEADER_BYTES), ACK_FRAME_FIXED_BYTES),
        wrapping_mul(wrapping_u32(ACK_RANGE_BYTES), extra)
    )
}

// Add `pn` to `(lo, hi)` word pairs kept largest first, merging
// neighbours, and keep at most `max` ranges (the oldest are forgotten).
pub fn record_pn(in ranges: Slice[u64], pn: u64, max: u64) -> ChunkSeq[u64] {
    let pairs = ranges.len() / PAIR_WORDS;
    let mut out: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](
        wrapping_add(ranges.len(), PAIR_WORDS)
    );
    for i in 0..pairs {
        let lo = word_of(in ranges, wrapping_mul(i, PAIR_WORDS));
        let hi = word_of(in ranges, wrapping_add(wrapping_mul(i, PAIR_WORDS), 1));
        if lo <= pn && pn <= hi {
            out.extend(in ranges);
            return out;
        }
    }
    // Insert (pn, pn) before the first range whose high end is below it,
    // merging as the Rust sort-and-fold does: a range absorbs the next one
    // when the next one's high end is at least its low end minus one.
    let mut inserted = false;
    for i in 0..wrapping_add(pairs, 1) {
        let (lo, hi) = if i < pairs {
            (
                word_of(in ranges, wrapping_mul(i, PAIR_WORDS)),
                word_of(in ranges, wrapping_add(wrapping_mul(i, PAIR_WORDS), 1))
            )
        } else {
            (0, 0)
        };
        if !inserted && (i == pairs || hi < pn) {
            merge_range(inout out, pn, pn);
            inserted = true;
        }
        if i < pairs {
            merge_range(inout out, lo, hi);
        }
    }
    let keep = wrapping_mul(min(max, out.len() / PAIR_WORDS), PAIR_WORDS);
    out.truncate(keep);
    out
}

// Append `(lo, hi)` to ranges kept largest first, merging it into the last
// range when `hi + 1 >= last.lo`.
fn merge_range(inout out: ChunkSeq[u64], lo: u64, hi: u64) {
    let n = out.len();
    if n >= PAIR_WORDS {
        let last_lo = at(in out, wrapping_sub(n, PAIR_WORDS));
        if wrapping_add(hi, 1) >= last_lo {
            out.try_set(wrapping_sub(n, PAIR_WORDS), min(last_lo, lo));
            return;
        }
    }
    out.push(lo);
    out.push(hi);
}
