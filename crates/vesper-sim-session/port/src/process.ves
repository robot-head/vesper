// The `process-epochs-v1` state machine and model-bounds check
// (src/model/mod.rs and src/session/model_ops.rs).

const MAX_PROCESSES: u64 = 16;
const MAX_LOGS: u64 = 16;
const MAX_NETWORKS: u64 = 8;
const MAX_FAULTS: u64 = 256;
const MAX_FAILURES: u64 = 256;
const MAX_EVENTS: u64 = 1000000;
const MAX_EPOCHS: u64 = 64;
const MAX_INSTANCES: u64 = 256;
const MAX_LOG_BYTES: u64 = 1048576;
const MAX_LOG_RECORDS: u64 = 65536;
const MAX_QUEUE: u64 = 4096;
const MAX_MESSAGE_BYTES: u64 = 65536;
const I32_MAX: u64 = 2147483647;
const WARP_MAX_NICS: u64 = 4;
const WARP_MAX_LINKS: u64 = 8;
const WARP_MAX_FLOWS: u64 = 16;
const WARP_MAX_EVENTS: u64 = 256;
const WARP_MAX_FRAMES: u64 = 4096;
const WARP_MAX_IN_FLIGHT: u64 = 65536;
const WARP_PPM: u64 = 1000000;

pub struct ProcessTable {
    epochs: ChunkSeq[u64],
    up: ChunkSeq[bool],
    crashes: u64,
    max_epochs: u64
}

fn epoch_at(in s: ChunkSeq[u64], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

fn up_at(in s: ChunkSeq[bool], i: u64) -> bool {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => false,
    }
}

pub fn process_table_new(n: u64, max_epochs: u64) -> ProcessTable {
    let mut epochs = ChunkSeq::new[u64]();
    let mut up = ChunkSeq::new[bool]();
    let mut i: u64 = 0;
    loop {
        if i >= n {
            break;
        }
        epochs.push(0);
        up.push(true);
        i = wrapping_add(i, 1);
    }
    ProcessTable { epochs: epochs, up: up, crashes: 0, max_epochs: max_epochs }
}

pub fn process_table_clone(in t: ProcessTable) -> ProcessTable {
    let n = t.epochs.len();
    let mut epochs = ChunkSeq::new[u64]();
    let mut up = ChunkSeq::new[bool]();
    let mut i: u64 = 0;
    loop {
        if i >= n {
            break;
        }
        epochs.push(epoch_at(in t.epochs, i));
        up.push(up_at(in t.up, i));
        i = wrapping_add(i, 1);
    }
    ProcessTable { epochs: epochs, up: up, crashes: t.crashes, max_epochs: t.max_epochs }
}

pub fn process_table_crash(inout t: ProcessTable, p: u64) -> (u8, u64) {
    if p >= t.epochs.len() {
        return (3, 0);
    }
    if !up_at(in t.up, p) {
        return (1, 0);
    }
    if t.crashes >= t.max_epochs {
        return (2, 0);
    }
    t.crashes = wrapping_add(t.crashes, 1);
    let _ = t.up.try_set(p, false);
    (0, epoch_at(in t.epochs, p))
}

pub fn process_table_restart(inout t: ProcessTable, p: u64) -> (u8, u64) {
    if p >= t.epochs.len() {
        return (2, 0);
    }
    if up_at(in t.up, p) {
        return (1, 0);
    }
    let next_epoch = wrapping_add(epoch_at(in t.epochs, p), 1);
    let _ = t.epochs.try_set(p, next_epoch);
    let _ = t.up.try_set(p, true);
    (0, next_epoch)
}

pub fn process_table_is_up(in t: ProcessTable, p: u64) -> bool {
    if p >= t.up.len() {
        false
    } else {
        up_at(in t.up, p)
    }
}

pub fn process_table_epoch(in t: ProcessTable, p: u64) -> u64 {
    if p >= t.epochs.len() {
        0
    } else {
        epoch_at(in t.epochs, p)
    }
}

pub fn process_table_crashes(in t: ProcessTable) -> u64 {
    t.crashes
}

pub fn process_table_len(in t: ProcessTable) -> u64 {
    t.epochs.len()
}

pub fn validate_model_bounds(
    max_events: u64,
    max_epochs: u64,
    max_instances: u64,
    n_processes: u64,
    n_logs: u64,
    n_networks: u64,
    n_faults: u64,
    n_failures: u64
) -> u8 {
    if max_events == 0 || max_events > MAX_EVENTS {
        return 1;
    }
    if max_epochs > MAX_EPOCHS {
        return 2;
    }
    if max_instances == 0 || max_instances > MAX_INSTANCES {
        return 3;
    }
    if n_processes > MAX_PROCESSES
        || n_logs > MAX_LOGS
        || n_networks > MAX_NETWORKS
        || n_faults > MAX_FAULTS
        || n_failures > MAX_FAILURES
    {
        return 4;
    }
    0
}

pub fn validate_log_bounds(max_records: u64, max_bytes: u64, max_record_bytes: u64) -> bool {
    max_records > 0
        && max_records <= MAX_LOG_RECORDS
        && max_bytes > 0
        && max_bytes <= MAX_LOG_BYTES
        && max_record_bytes > 0
        && max_record_bytes <= max_bytes
}

pub fn validate_network_bounds(
    max_in_flight: u64,
    max_inbox: u64,
    max_message_bytes: u64,
    timeout_code: u64,
    unreachable_code: u64
) -> u8 {
    if max_in_flight == 0
        || max_in_flight > MAX_QUEUE
        || max_inbox == 0
        || max_inbox > MAX_QUEUE
        || max_message_bytes == 0
        || max_message_bytes > MAX_MESSAGE_BYTES
    {
        return 1;
    }
    if timeout_code > I32_MAX || unreachable_code > I32_MAX {
        return 2;
    }
    0
}

fn slice_at(in s: Slice[u64], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

pub fn validate_process_timeline(in events: Slice[u64]) -> (bool, u64) {
    let n = events.len() / 2;
    let mut times = ChunkSeq::new[u64]();
    let mut crashes = ChunkSeq::new[u64]();
    let mut i: u64 = 0;
    loop {
        if i >= n {
            break;
        }
        let off = wrapping_mul(i, 2);
        times.push(slice_at(in events, off));
        crashes.push(slice_at(in events, wrapping_add(off, 1)));
        i = wrapping_add(i, 1);
    }
    // Insertion sort by `(at_ns, is_crash)` ascending.
    let mut k: u64 = 1;
    loop {
        if k >= n {
            break;
        }
        let kt = epoch_at(in times, k);
        let kc = epoch_at(in crashes, k);
        let mut j = k;
        loop {
            if j == 0 {
                break;
            }
            let prev = wrapping_sub(j, 1);
            let pt = epoch_at(in times, prev);
            let pc = epoch_at(in crashes, prev);
            if pt < kt || (pt == kt && pc <= kc) {
                break;
            }
            let _ = times.try_set(j, pt);
            let _ = crashes.try_set(j, pc);
            j = prev;
        }
        let _ = times.try_set(j, kt);
        let _ = crashes.try_set(j, kc);
        k = wrapping_add(k, 1);
    }
    let mut expect_crash: u64 = 1;
    let mut has_last = false;
    let mut last: u64 = 0;
    let mut restarts: u64 = 0;
    let mut m: u64 = 0;
    loop {
        if m >= n {
            break;
        }
        let at = epoch_at(in times, m);
        let crash = epoch_at(in crashes, m);
        if (has_last && last == at) || crash != expect_crash {
            return (false, 0);
        }
        if crash == 0 {
            restarts = wrapping_add(restarts, 1);
        }
        expect_crash = if expect_crash == 1 { 0 } else { 1 };
        has_last = true;
        last = at;
        m = wrapping_add(m, 1);
    }
    (true, restarts)
}

pub fn validate_warp_bounds(
    max_in_flight: u64,
    max_leases: u64,
    n_nics: u64,
    n_links: u64,
    n_flows: u64,
    n_events: u64
) -> u8 {
    if max_in_flight == 0
        || max_in_flight > WARP_MAX_IN_FLIGHT
        || max_leases == 0
        || max_leases > WARP_MAX_FRAMES
    {
        return 1;
    }
    if n_nics == 0
        || n_nics > WARP_MAX_NICS
        || n_links > WARP_MAX_LINKS
        || n_flows > WARP_MAX_FLOWS
        || n_events > WARP_MAX_EVENTS
    {
        return 2;
    }
    0
}

pub fn validate_warp_link_params(
    loss_ppm: u64,
    dup_ppm: u64,
    reorder_ppm: u64,
    ge_g2b: u64,
    ge_b2g: u64,
    ge_lg: u64,
    ge_lb: u64,
    buffer_packets: u64,
    rate_bps: u64
) -> u8 {
    if loss_ppm > WARP_PPM
        || dup_ppm > WARP_PPM
        || reorder_ppm > WARP_PPM
        || ge_g2b > WARP_PPM
        || ge_b2g > WARP_PPM
        || ge_lg > WARP_PPM
        || ge_lb > WARP_PPM
    {
        return 1;
    }
    if buffer_packets == 0 || rate_bps == 0 {
        return 2;
    }
    0
}

pub fn warp_admit_allows(in_flight: u64, egress_in_flight: u64, max_in_flight: u64) -> bool {
    wrapping_add(in_flight, egress_in_flight) < max_in_flight
}
