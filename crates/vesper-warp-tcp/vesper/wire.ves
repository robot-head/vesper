// ---------------------------------------------------------------------
// wire.rs: header and options, checksums (RFC 9293 §3.1, RFC 7323,
// RFC 2018, RFC 1071)
// ---------------------------------------------------------------------

// Header sizes and field offsets (RFC 9293 §3.1), the same names as
// `wire.rs` and its `offsets` module.
const HEADER_LEN: u64 = 20;
// Data offset 15.
const MAX_HEADER_LEN: u64 = 60;
// `MAX_HEADER_LEN - HEADER_LEN`.
const MAX_OPTIONS_LEN: u64 = 40;

// Header field offsets (RFC 9293 §3.1).
enum Field: u64 {
    SrcPort = 0,
    DstPort = 2,
    Seq = 4,
    Ack = 8,
    DataOffset = 12,
    Flags = 13,
    Window = 14,
    Checksum = 16,
    Urgent = 18,
}

// IP protocol number for TCP, as a pseudo-header word.
const IPPROTO_TCP: u64 = 6;
// The pseudo-header length field: 16 bits over IPv4, 32 over IPv6
// (RFC 8200 §8.1).
const MAX_IPV4_TCP_LEN: u64 = 65535;
const MAX_IPV6_TCP_LEN: u64 = 4294967295;
// Largest permitted window shift (RFC 7323 §2.3).
const MAX_WINDOW_SCALE: u8 = 14;
// Largest window the 16-bit window field carries unscaled.
const MAX_UNSCALED_WINDOW: u64 = 65535;
// Default send MSS without an MSS option (RFC 9293 §3.7.1).
const DEFAULT_IPV4_MSS: u16 = 536;
const DEFAULT_IPV6_MSS: u16 = 1220;
// Maximum SACK blocks in one option (RFC 2018 §3).
const MAX_SACK_BLOCKS: u64 = 4;

// Option kinds (RFC 9293 §3.2, RFC 7323, RFC 2018), as `wire::options`.
enum OptKind: u8 {
    End = 0,
    Nop = 1,
    Mss = 2,
    WindowScale = 3,
    SackPermitted = 4,
    Sack = 5,
    Timestamps = 8,
}

// The length byte of each fixed-size option.
enum OptLen: u8 {
    Mss = 4,
    WindowScale = 3,
    SackPermitted = 2,
    Timestamps = 10,
}

// Kind and length bytes before an option's body.
const KIND_AND_LEN: u64 = 2;
// Bytes of one SACK block (two sequence numbers).
const SACK_BLOCK_LEN: u64 = 8;
// Every option but the timestamps is one NOP-padded 4-byte word.
const PADDED_LEN: u64 = 4;
// The timestamps option, NOP NOP-padded.
const PADDED_TIMESTAMPS_LEN: u64 = 12;
// `PADDED_LEN + SACK_BLOCK_LEN`: a SACK option with one block.
const SACK_ONE_BLOCK_LEN: u64 = 12;

copy enum WireError {
    Truncated,
    BadDataOffset,
    MalformedOption {
        kind: u8
    },
    OptionsTooLong,
    BufferTooSmall,
    TooLong,
    BadChecksum
}

// A SACK block of the option list (`wire::SackBlock` with plain words).
copy struct Blk {
    left: u32,
    right: u32
}

copy struct Timestamps {
    val: u32,
    ecr: u32
}

// `wire::TcpOptions`, with the four SACK blocks as fields.
copy struct Opts {
    mss: Option[u16],
    window_scale: Option[u8],
    sack_permitted: bool,
    b0: Blk,
    b1: Blk,
    b2: Blk,
    b3: Blk,
    sack_len: u8,
    timestamps: Option[Timestamps]
}

// `wire::HeaderFields` with plain words.
copy struct Hdr {
    src_port: u16,
    dst_port: u16,
    seq: u32,
    ack: u32,
    flags: u8,
    window: u16,
    urgent: u16
}

// A parsed segment header (`wire::Segment` without its borrowed payload,
// which starts at `header_len`).
copy struct Parsed {
    src_port: u16,
    dst_port: u16,
    seq: u32,
    ack: u32,
    flags: u8,
    window: u16,
    checksum: u16,
    urgent: u16,
    header_len: u64,
    options: Opts
}

// `wire::IpPair` with the addresses as big-endian words.
copy enum Ips {
    V4 {
        src: u32,
        dst: u32
    },
    V6 {
        s0: u64,
        s1: u64,
        d0: u64,
        d1: u64
    }
}

fn fin_bit() -> u8 {
    1
}

fn syn_bit() -> u8 {
    2
}

fn rst_bit() -> u8 {
    4
}

fn psh_bit() -> u8 {
    8
}

fn ack_bit() -> u8 {
    16
}

fn urg_bit() -> u8 {
    32
}

fn has(flags: u8, bit: u8) -> bool {
    flags & bit == bit
}

pub fn flags_contains(f: u8, other: u8) -> bool {
    f & other == other
}

pub fn flags_with(f: u8, other: u8) -> u8 {
    f | other
}
