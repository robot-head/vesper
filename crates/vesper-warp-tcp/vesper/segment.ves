// `bytes[at..at + 8]` as a big-endian word; the caller checked the room.
fn hdr64(in bytes: Slice[u8], at: u64) -> u64 {
    match bytes.try_read_u64_be(at) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

pub fn segment_parse(in bytes: Slice[u8]) -> Result[Parsed, WireError] {
    if bytes.len() < HEADER_LEN {
        return Result::Err(WireError::Truncated);
    }
    // The fixed header as three wide reads: ports and sequence number;
    // acknowledgment, data offset, flags and window; checksum and urgent
    // pointer (the last read ends at byte 20).
    let w0 = hdr64(in bytes, 0);
    let w1 = hdr64(in bytes, 8);
    let w2 = hdr64(in bytes, 12);
    let header_len = wrapping_mul(w1 >> 28 & 15, 4);
    if header_len < HEADER_LEN || header_len > bytes.len() {
        return Result::Err(WireError::BadDataOffset);
    }
    match opts_parse_at(in bytes, HEADER_LEN, header_len) {
        Result::Err(e) => Result::Err(e),
        Result::Ok(options) => Result::Ok(
            Parsed {
                src_port: wrapping_u16(w0 >> 48),
                dst_port: wrapping_u16(w0 >> 32),
                seq: wrapping_u32(w0),
                ack: wrapping_u32(w1 >> 32),
                flags: wrapping_u8(w1 >> 16),
                window: wrapping_u16(w1),
                checksum: wrapping_u16(w2 >> 16),
                urgent: wrapping_u16(w2),
                header_len: header_len,
                options: options
            }
        ),
    }
}

pub fn segment_seq_len(flags: u8, payload_len: u64) -> u32 {
    let mut n = wrapping_u32(payload_len);
    if has(flags, syn_bit()) {
        n = wrapping_add(n, 1);
    }
    if has(flags, fin_bit()) {
        n = wrapping_add(n, 1);
    }
    n
}

pub fn write_header(inout out: Slice[u8], h: Hdr, o: Opts) -> Result[u64, WireError] {
    let opt_len = opts_encoded_len(o);
    if opt_len > MAX_OPTIONS_LEN {
        return Result::Err(WireError::OptionsTooLong);
    }
    let header_len = wrapping_add(HEADER_LEN, opt_len);
    if out.len() < header_len {
        return Result::Err(WireError::BufferTooSmall);
    }
    wr16(inout out, OFF_SRC_PORT, h.src_port);
    wr16(inout out, OFF_DST_PORT, h.dst_port);
    wr32(inout out, OFF_SEQ, h.seq);
    wr32(inout out, OFF_ACK, h.ack);
    wr8(inout out, OFF_DATA_OFFSET, wrapping_u8(header_len / 4) << 4);
    wr8(inout out, OFF_FLAGS, h.flags);
    wr16(inout out, OFF_WINDOW, h.window);
    wr16(inout out, OFF_CHECKSUM, 0);
    wr16(inout out, OFF_URGENT, h.urgent);
    opts_put(o, inout out, HEADER_LEN);
    Result::Ok(header_len)
}

pub fn ips_default_mss(ips: Ips) -> u16 {
    match ips {
        Ips::V4 {
            src,
            dst
        }
        => DEFAULT_IPV4_MSS,
        Ips::V6 {
            s0,
            s1,
            d0,
            d1
        }
        => DEFAULT_IPV6_MSS,
    }
}

pub fn ips_reversed(ips: Ips) -> Ips {
    match ips {
        Ips::V4 {
            src,
            dst
        }
        => Ips::V4 {
            src: dst,
            dst: src
        },
        Ips::V6 {
            s0,
            s1,
            d0,
            d1
        }
        => Ips::V6 {
            s0: d0,
            s1: d1,
            d0: s0,
            d1: s1
        },
    }
}

fn ips_eq(a: Ips, b: Ips) -> bool {
    match a {
        Ips::V4 {
            src,
            dst
        }
        => match b {
            Ips::V4 {
                src: s2,
                dst: d2
            }
            => src == s2 && dst == d2,
            Ips::V6 {
                s0,
                s1,
                d0,
                d1
            }
            => false,
        },
        Ips::V6 {
            s0,
            s1,
            d0,
            d1
        }
        => match b {
            Ips::V4 {
                src,
                dst
            }
            => false,
            Ips::V6 {
                s0: t0,
                s1: t1,
                d0: e0,
                d1: e1
            }
            => s0 == t0 && s1 == t1 && d0 == e0 && d1 == e1,
        },
    }
}

fn words16_32(x: u32) -> u64 {
    wrapping_add(widen_u64(x >> 16), widen_u64(x & 65535))
}

fn words16_64(x: u64) -> u64 {
    wrapping_add(wrapping_add(x >> 48, x >> 32 & 65535), wrapping_add(x >> 16 & 65535, x & 65535))
}

// The one's-complement sum of `bytes[from..to]` as big-endian 16-bit
// words, an odd trailing byte padded with zero; `to` is clamped to the
// slice and an empty range adds nothing. One vectorized `sum_be16` scan.
fn sum_range(acc: u64, in bytes: Slice[u8], from: u64, to: u64) -> u64 {
    let end = min64(to, bytes.len());
    if from >= end {
        return acc;
    }
    wrapping_add(acc, sum_view(in bytes[from..end]))
}

fn sum_view(in s: Slice[u8]) -> u64 {
    s.sum_be16()
}
