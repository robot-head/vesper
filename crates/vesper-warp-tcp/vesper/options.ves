fn no_blk() -> Blk {
    Blk {
        left: 0,
        right: 0
    }
}

pub fn opts_default() -> Opts {
    Opts {
        mss: Option::None,
        window_scale: Option::None,
        sack_permitted: false,
        b0: no_blk(),
        b1: no_blk(),
        b2: no_blk(),
        b3: no_blk(),
        sack_len: 0,
        timestamps: Option::None
    }
}

fn opts_blk(o: Opts, k: u64) -> Blk {
    if k == 0 {
        o.b0
    } else if k == 1 {
        o.b1
    } else if k == 2 {
        o.b2
    } else {
        o.b3
    }
}

fn opts_set_blk(inout o: Opts, k: u64, b: Blk) {
    if k == 0 {
        o.b0 = b;
    } else if k == 1 {
        o.b1 = b;
    } else if k == 2 {
        o.b2 = b;
    } else {
        o.b3 = b;
    }
}

fn sack_count(o: Opts) -> u64 {
    min64(widen_u64(o.sack_len), MAX_SACK_BLOCKS)
}

pub fn opts_encoded_len(o: Opts) -> u64 {
    let mut n: u64 = 0;
    match o.mss {
        Option::Some(m) => {
            n = wrapping_add(n, PADDED_LEN);
        },
        Option::None => (),
    }
    match o.window_scale {
        Option::Some(w) => {
            n = wrapping_add(n, PADDED_LEN);
        },
        Option::None => (),
    }
    if o.sack_permitted {
        n = wrapping_add(n, PADDED_LEN);
    }
    match o.timestamps {
        Option::Some(t) => {
            n = wrapping_add(n, PADDED_TIMESTAMPS_LEN);
        },
        Option::None => (),
    }
    if o.sack_len > 0 {
        n = wrapping_add(n, wrapping_add(PADDED_LEN, wrapping_mul(SACK_BLOCK_LEN, sack_count(o))));
    }
    n
}

// Byte access. Reads outside the slice are 0 and writes outside it are
// dropped; every caller checks the bounds first, as the Rust code does.
fn rd8(in b: Slice[u8], i: u64) -> u8 {
    match b.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

fn rd16(in b: Slice[u8], i: u64) -> u16 {
    match b.try_read_u16_be(i) {
        Option::Some(v) => v,
        Option::None => widen_u16(rd8(in b, i)) << 8 | widen_u16(rd8(in b, wrapping_add(i, 1))),
    }
}

fn rd32(in b: Slice[u8], i: u64) -> u32 {
    match b.try_read_u32_be(i) {
        Option::Some(v) => v,
        Option::None => widen_u32(rd16(in b, i)) << 16 | widen_u32(rd16(in b, wrapping_add(i, 2))),
    }
}

fn wr8(inout b: Slice[u8], i: u64, v: u8) {
    b.try_set(i, v);
}

// The wide write stores nothing when the interval does not fit; the byte
// path then keeps the old partial write at the end of the buffer.
fn wr16(inout b: Slice[u8], i: u64, v: u16) {
    if !b.try_write_u16_be(i, v) {
        b.try_set(i, wrapping_u8(v >> 8));
        b.try_set(wrapping_add(i, 1), wrapping_u8(v));
    }
}

fn wr32(inout b: Slice[u8], i: u64, v: u32) {
    if !b.try_write_u32_be(i, v) {
        wr16(inout b, i, wrapping_u16(v >> 16));
        wr16(inout b, wrapping_add(i, 2), wrapping_u16(v));
    }
}

// Write the options at `out[at..]`; the caller checked the room.
fn opts_put(o: Opts, inout out: Slice[u8], at: u64) -> u64 {
    let mut i = at;
    match o.mss {
        Option::Some(mss) => {
            wr8(inout out, i, OptKind::Mss);
            wr8(inout out, wrapping_add(i, 1), OptLen::Mss);
            wr16(inout out, wrapping_add(i, 2), mss);
            i = wrapping_add(i, PADDED_LEN);
        },
        Option::None => (),
    }
    match o.window_scale {
        Option::Some(ws) => {
            wr8(inout out, i, OptKind::Nop);
            wr8(inout out, wrapping_add(i, 1), OptKind::WindowScale);
            wr8(inout out, wrapping_add(i, 2), OptLen::WindowScale);
            wr8(inout out, wrapping_add(i, 3), ws);
            i = wrapping_add(i, PADDED_LEN);
        },
        Option::None => (),
    }
    if o.sack_permitted {
        wr8(inout out, i, OptKind::Nop);
        wr8(inout out, wrapping_add(i, 1), OptKind::Nop);
        wr8(inout out, wrapping_add(i, 2), OptKind::SackPermitted);
        wr8(inout out, wrapping_add(i, 3), OptLen::SackPermitted);
        i = wrapping_add(i, PADDED_LEN);
    }
    match o.timestamps {
        Option::Some(ts) => {
            wr8(inout out, i, OptKind::Nop);
            wr8(inout out, wrapping_add(i, 1), OptKind::Nop);
            wr8(inout out, wrapping_add(i, 2), OptKind::Timestamps);
            wr8(inout out, wrapping_add(i, 3), OptLen::Timestamps);
            wr32(inout out, wrapping_add(i, 4), ts.val);
            wr32(inout out, wrapping_add(i, 8), ts.ecr);
            i = wrapping_add(i, PADDED_TIMESTAMPS_LEN);
        },
        Option::None => (),
    }
    if o.sack_len > 0 {
        let n = sack_count(o);
        wr8(inout out, i, OptKind::Nop);
        wr8(inout out, wrapping_add(i, 1), OptKind::Nop);
        wr8(inout out, wrapping_add(i, 2), OptKind::Sack);
        wr8(
            inout out,
            wrapping_add(i, 3),
            wrapping_u8(wrapping_add(KIND_AND_LEN, wrapping_mul(SACK_BLOCK_LEN, n)))
        );
        i = wrapping_add(i, PADDED_LEN);
        for k in 0..n {
            let b = opts_blk(o, k);
            wr32(inout out, i, b.left);
            wr32(inout out, wrapping_add(i, 4), b.right);
            i = wrapping_add(i, SACK_BLOCK_LEN);
        }
    }
    wrapping_sub(i, at)
}

pub fn opts_write(o: Opts, inout out: Slice[u8]) -> Result[u64, WireError] {
    let len = opts_encoded_len(o);
    if len > MAX_OPTIONS_LEN {
        Result::Err(WireError::OptionsTooLong)
    } else if out.len() < len {
        Result::Err(WireError::BufferTooSmall)
    } else {
        Result::Ok(opts_put(o, inout out, 0))
    }
}

fn malformed(kind: u8) -> Result[Opts, WireError] {
    Result::Err(
        WireError::MalformedOption {
            kind: kind
        }
    )
}

// The SACK block at `bytes[at..at + 8]`: one wide read when it fits.
fn sack_blk_at(in bytes: Slice[u8], at: u64) -> Blk {
    match bytes.try_read_u64_be(at) {
        Option::Some(w) => Blk {
            left: wrapping_u32(w >> 32),
            right: wrapping_u32(w)
        },
        Option::None => Blk {
            left: rd32(in bytes, at),
            right: rd32(in bytes, wrapping_add(at, 4))
        },
    }
}

// Parse the option list `bytes[from..to]`.
fn opts_parse_at(in bytes: Slice[u8], from: u64, to: u64) -> Result[Opts, WireError] {
    let mut opts = opts_default();
    let mut i = from;
    loop {
        if i >= to {
            break;
        }
        let kind = match bytes.try_get(i) {
            Option::Some(v) => v,
            Option::None => 0,
        };
        if kind == OptKind::End {
            // End of option list; the rest is padding.
            break;
        }
        if kind == OptKind::Nop {
            i = wrapping_add(i, 1);
        } else {
            if wrapping_add(i, 1) >= to {
                return malformed(kind);
            }
            let len = match bytes.try_get(wrapping_add(i, 1)) {
                Option::Some(v) => widen_u64(v),
                Option::None => 0,
            };
            if len < KIND_AND_LEN || wrapping_add(i, len) > to {
                return malformed(kind);
            }
            let body = wrapping_add(i, KIND_AND_LEN);
            if kind == OptKind::Mss {
                let dup = match opts.mss {
                    Option::Some(m) => true,
                    Option::None => false,
                };
                if len != widen_u64(OptLen::Mss) || dup {
                    return malformed(kind);
                }
                opts.mss = Option::Some(rd16(in bytes, body));
            } else if kind == OptKind::WindowScale {
                let dup = match opts.window_scale {
                    Option::Some(w) => true,
                    Option::None => false,
                };
                if len != widen_u64(OptLen::WindowScale) || dup {
                    return malformed(kind);
                }
                opts.window_scale = Option::Some(rd8(in bytes, body));
            } else if kind == OptKind::SackPermitted {
                if len != widen_u64(OptLen::SackPermitted) || opts.sack_permitted {
                    return malformed(kind);
                }
                opts.sack_permitted = true;
            } else if kind == OptKind::Sack {
                let n = wrapping_sub(len, KIND_AND_LEN) / SACK_BLOCK_LEN;
                if wrapping_sub(len, KIND_AND_LEN) % SACK_BLOCK_LEN != 0
                    || n == 0
                    || n > MAX_SACK_BLOCKS
                    || opts.sack_len != 0 {
                    return malformed(kind);
                }
                for k in 0..n {
                    let at = wrapping_add(body, wrapping_mul(k, SACK_BLOCK_LEN));
                    opts_set_blk(inout opts, k, sack_blk_at(in bytes, at));
                }
                opts.sack_len = wrapping_u8(n);
            } else if kind == OptKind::Timestamps {
                let dup = match opts.timestamps {
                    Option::Some(t) => true,
                    Option::None => false,
                };
                if len != widen_u64(OptLen::Timestamps) || dup {
                    return malformed(kind);
                }
                // One wide read of TSval and TSecr (the length check above
                // keeps it inside `bytes[..to]`).
                let w = match bytes.try_read_u64_be(body) {
                    Option::Some(v) => v,
                    Option::None => widen_u64(rd32(in bytes, body))
                        << 32 | widen_u64(rd32(in bytes, wrapping_add(body, 4))),
                };
                opts
                    .timestamps = Option::Some(
                        Timestamps {
                            val: wrapping_u32(w >> 32),
                            ecr: wrapping_u32(w)
                        }
                    );
            }
            // Unknown options with a valid length are skipped.
            i = wrapping_add(i, len);
        }
    }
    Result::Ok(opts)
}

pub fn opts_parse(in bytes: Slice[u8]) -> Result[Opts, WireError] {
    opts_parse_at(in bytes, 0, bytes.len())
}
