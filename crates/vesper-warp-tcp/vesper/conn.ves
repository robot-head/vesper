// ---------------------------------------------------------------------
// conn.rs: the connection (one TCB)
// ---------------------------------------------------------------------

copy enum State {
    Closed,
    Listen,
    SynSent,
    SynReceived,
    Established,
    FinWait1,
    FinWait2,
    CloseWait,
    Closing,
    LastAck,
    TimeWait
}

pub fn state_is_synchronized(s: State) -> bool {
    !(s == State::Closed || s == State::Listen || s == State::SynSent)
}

copy struct Config {
    local_port: u16,
    mss: u16,
    recv_buffer: u32,
    window_scale: Option[u8],
    sack: bool,
    timestamps: bool,
    rto: RtoConfig,
    max_retransmits: u32,
    time_wait_ns: u64,
    delayed_ack_ns: u64,
    max_in_flight_segments: u32,
    max_ooo_ranges: u32,
    challenge_ack_limit: u32,
    initial_window_segments: u32,
    nagle: bool
}

copy enum CloseReason {
    Reset,
    Refused,
    TimedOut,
    Aborted
}

copy enum Event {
    Connected,
    PeerFinished,
    Closed(Option[CloseReason])
}

// `conn::TcpError`; `InvalidConfig` carries an index into the Rust
// messages (`port::CONFIG_ERRORS`).
copy enum TcpFail {
    Wire(WireError),
    NotForThisConnection,
    RingSizeMismatch,
    InvalidState(State),
    ConnectionClosing,
    SendViewMissing {
        start: u64,
        end: u64
    },
    BufferTooSmall,
    InvalidConfig(u8),
    ReleaseExceedsUnread,
    Overflow
}

copy struct Stats {
    segments_sent: u64,
    retransmits: u64,
    retransmitted_bytes: u64,
    recoveries: u64,
    rtos: u64,
    window_probes: u64,
    challenge_acks: u64,
    challenge_acks_suppressed: u64,
    ooo_dropped: u64,
    paws_dropped: u64,
    dup_acks: u64
}

copy struct SentSeg {
    start: u64,
    end: u64,
    syn: bool,
    fin: bool,
    pn: u64,
    sent_ns: u64,
    retransmits: u32,
    sacked: bool,
    lost: bool,
    rexmit_in_recovery: bool
}

copy struct OooRange {
    start: u64,
    end: u64,
    stamp: u64
}

copy struct RstSpec {
    ips: Ips,
    src_port: u16,
    dst_port: u16,
    seq: u32,
    ack: Option[u32]
}

// A congestion-controller call, recorded in order for the Rust wrapper to
// apply to its `CongestionController` after the call that made it.
copy enum CcCmd {
    Mss(u32),
    Rtt(RttSample),
    Event {
        event: CongestionEvent,
        now: u64
    }
}

// In-order payload surfaced by one segment, as offsets: the segment's own
// bytes `[seg_start, seg_start + seg_len)`, then the ring
// `[ring_start, ring_start + ring_len1)` and `[0, ring_len2)`.
copy struct RecvOut {
    seg_start: u64,
    seg_len: u64,
    ring_start: u64,
    ring_len1: u64,
    ring_len2: u64,
    fin: bool
}

// One segment written by `tcb_poll_transmit`. For a sequence-space entry
// (`entry`), the wrapper asks its controller for the departure time of
// `bytes` and reports the send of `pn`; `edt_ns` is `now` until
// `tcb_commit_edt` moves it.
copy struct Tx {
    len: u64,
    edt_ns: u64,
    ips: Ips,
    entry: bool,
    pn: u64,
    bytes: u32
}

struct Tcb {
    cfg: Config,
    st: State,
    passive: bool,
    remote_port: u16,
    ips: Option[Ips],
    iss_base: u32,
    snd_isn: u32,
    snd_una: u64,
    snd_nxt: u64,
    snd_wnd: u32,
    max_snd_wnd: u32,
    snd_wl1: u32,
    snd_wl2: u32,
    snd_wscale: u8,
    rcv_wscale: u8,
    ws_ok: bool,
    sack_ok: bool,
    ts_ok: bool,
    peer_mss: u16,
    smss: u32,
    need_syn: bool,
    write_end: u64,
    fin_requested: bool,
    fin_abs: Option[u64],
    released_off: u64,
    sent: ChunkSeq[SentSeg],
    sent_head: u64,
    sent_len: u64,
    sent_cap: u64,
    next_pn: u64,
    rtt: RttEstimator,
    timed: Option[u64],
    rto_deadline: Option[u64],
    retries: u32,
    persist_deadline: Option[u64],
    persist_backoff: u32,
    probe_due: bool,
    dupacks: u32,
    recovery_point: Option[u64],
    force_retx: bool,
    rcv_isn: u32,
    have_irs: bool,
    rcv_nxt: u64,
    rcv_adv_right: u64,
    read_off: u64,
    ooo: ChunkSeq[OooRange],
    ooo_stamp: u64,
    ooo_fin: Option[u64],
    fin_received: bool,
    urgent_off: Option[u64],
    ts_recent: u32,
    ts_recent_valid: bool,
    last_ack_sent: u64,
    ack_now: bool,
    ack_pending: u32,
    delack_deadline: Option[u64],
    challenge_window_ns: u64,
    challenge_count: u32,
    pending_rst: Option[RstSpec],
    time_wait_deadline: Option[u64],
    events: u8,
    close_reason: Option[CloseReason],
    stats: Stats,
    cmds: ChunkSeq[CcCmd],
    edt_entry: Option[u64],
    edt_armed_rto: bool
}

// Limits and clocks, as in `reference/conn.rs`.
// Largest receive buffer a configuration may ask for, 2^30.
const MAX_RECV_BUFFER: u32 = 1073741824;
// Stream offsets stay below 2^62.
const MAX_STREAM_OFFSET: u64 = 4611686018427387904;
// At most one challenge ACK per window (RFC 5961 §7), 1 s.
const CHALLENGE_ACK_WINDOW_NS: u64 = 1000000000;
// Cap on the persist timer's exponential backoff shift.
const MAX_PERSIST_BACKOFF_SHIFT: u32 = 16;
// RFC 9293 §3.4.1 ISN clock: one tick per 4 µs.
const ISN_TICK_NS: u64 = 4000;
// Timestamp clock tick (1 ms, within RFC 7323 §5.4's 1 ms to 1 s range).
const TS_TICK_NS: u64 = 1000000;

fn dup_thresh() -> u32 {
    3
}

fn min_send_mss() -> u16 {
    64
}

fn ev_connected() -> u8 {
    1
}

fn ev_peer_fin() -> u8 {
    2
}

fn ev_closed() -> u8 {
    4
}

fn is_some(o: Option[u64]) -> bool {
    match o {
        Option::Some(v) => true,
        Option::None => false,
    }
}

fn no_seg() -> SentSeg {
    SentSeg {
        start: 0,
        end: 0,
        syn: false,
        fin: false,
        pn: 0,
        sent_ns: 0,
        retransmits: 0,
        sacked: false,
        lost: false,
        rexmit_in_recovery: false
    }
}

fn seg_bytes(s: SentSeg) -> u32 {
    // Entries are at most one MSS (+SYN/FIN).
    wrapping_u32(wrapping_sub(s.end, s.start))
}

fn seg_data_start(s: SentSeg) -> u64 {
    max64(s.start, 1)
}

fn seg_data_end(s: SentSeg) -> u64 {
    let e = if s.fin {
        wrapping_sub(s.end, 1)
    } else {
        s.end
    };
    max64(e, seg_data_start(s))
}

fn zero_stats() -> Stats {
    Stats {
        segments_sent: 0,
        retransmits: 0,
        retransmitted_bytes: 0,
        recoveries: 0,
        rtos: 0,
        window_probes: 0,
        challenge_acks: 0,
        challenge_acks_suppressed: 0,
        ooo_dropped: 0,
        paws_dropped: 0,
        dup_acks: 0
    }
}

fn no_recv() -> RecvOut {
    RecvOut {
        seg_start: 0,
        seg_len: 0,
        ring_start: 0,
        ring_len1: 0,
        ring_len2: 0,
        fin: false
    }
}

fn some_ips(o: Option[Ips]) -> Ips {
    match o {
        Option::Some(i) => i,
        Option::None => Ips::V4 {
            src: 0,
            dst: 0
        },
    }
}

// The sent queue: a fixed-capacity ring of `sent_cap` entries.

fn sq_slot(in t: Tcb, i: u64) -> u64 {
    let k = wrapping_add(t.sent_head, i);
    if k >= t.sent_cap {
        wrapping_sub(k, t.sent_cap)
    } else {
        k
    }
}

fn sq_get(in t: Tcb, i: u64) -> SentSeg {
    match t.sent.try_get(sq_slot(in t, i)) {
        Option::Some(s) => s,
        Option::None => no_seg(),
    }
}

fn sq_set(inout t: Tcb, i: u64, s: SentSeg) {
    let k = sq_slot(in t, i);
    t.sent.try_set(k, s);
}

fn sq_push(inout t: Tcb, s: SentSeg) -> bool {
    if t.sent_len == t.sent_cap {
        false
    } else {
        let k = sq_slot(in t, t.sent_len);
        t.sent.try_set(k, s);
        t.sent_len = wrapping_add(t.sent_len, 1);
        true
    }
}

fn sq_pop_front(inout t: Tcb) {
    if t.sent_len > 0 {
        t.sent_head = wrapping_add(t.sent_head, 1);
        if t.sent_head == t.sent_cap {
            t.sent_head = 0;
        }
        t.sent_len = wrapping_sub(t.sent_len, 1);
    }
}

fn sq_clear(inout t: Tcb) {
    t.sent_head = 0;
    t.sent_len = 0;
}

fn ooo_remove(inout t: Tcb, i: u64) {
    // swap_remove
    let last = wrapping_sub(t.ooo.len(), 1);
    match t.ooo.try_get(last) {
        Option::Some(r) => {
            t.ooo.try_set(i, r);
        },
        Option::None => (),
    }
    t.ooo.truncate(last);
}

fn ooo_at(in t: Tcb, i: u64) -> OooRange {
    match t.ooo.try_get(i) {
        Option::Some(r) => r,
        Option::None => OooRange {
            start: 0,
            end: 0,
            stamp: 0
        },
    }
}

fn cc_cmd(inout t: Tcb, c: CcCmd) {
    t.cmds.push(c);
}

fn cc_event(inout t: Tcb, event: CongestionEvent, now: u64) {
    t
        .cmds
        .push(
        CcCmd::Event {
            event: event,
            now: now
        }
    );
}

pub fn config_validate(cfg: Config) -> Result[Unit, TcpFail] {
    let ws_bad = match cfg.window_scale {
        Option::Some(s) => s > MAX_WINDOW_SCALE,
        Option::None => false,
    };
    if cfg.mss < min_send_mss() {
        Result::Err(TcpFail::InvalidConfig(0))
    } else if cfg.recv_buffer == 0 || cfg.recv_buffer > MAX_RECV_BUFFER {
        Result::Err(TcpFail::InvalidConfig(1))
    } else if ws_bad {
        Result::Err(TcpFail::InvalidConfig(2))
    } else if cfg.max_in_flight_segments == 0 || cfg.max_ooo_ranges == 0 {
        Result::Err(TcpFail::InvalidConfig(3))
    } else if cfg.rto.min_ns == 0 || cfg.rto.min_ns > cfg.rto.max_ns {
        Result::Err(TcpFail::InvalidConfig(4))
    } else {
        Result::Ok(())
    }
}

// A closed connection for a configuration `config_validate` accepted.
pub fn tcb_new(cfg: Config) -> Tcb {
    let cap = widen_u64(cfg.max_in_flight_segments);
    let mut sent: ChunkSeq[SentSeg] = ChunkSeq::with_capacity[SentSeg](cap);
    for i in 0..cap {
        sent.push(no_seg());
    }
    Tcb {
        cfg: cfg,
        st: State::Closed,
        passive: false,
        remote_port: 0,
        ips: Option::None,
        iss_base: 0,
        snd_isn: 0,
        snd_una: 0,
        snd_nxt: 0,
        snd_wnd: 0,
        max_snd_wnd: 0,
        snd_wl1: 0,
        snd_wl2: 0,
        snd_wscale: 0,
        rcv_wscale: 0,
        ws_ok: false,
        sack_ok: false,
        ts_ok: false,
        peer_mss: DEFAULT_IPV4_MSS,
        smss: widen_u32(DEFAULT_IPV4_MSS),
        need_syn: false,
        write_end: 0,
        fin_requested: false,
        fin_abs: Option::None,
        released_off: 0,
        sent: sent,
        sent_head: 0,
        sent_len: 0,
        sent_cap: cap,
        next_pn: 0,
        rtt: rtt_new(cfg.rto),
        timed: Option::None,
        rto_deadline: Option::None,
        retries: 0,
        persist_deadline: Option::None,
        persist_backoff: 0,
        probe_due: false,
        dupacks: 0,
        recovery_point: Option::None,
        force_retx: false,
        rcv_isn: 0,
        have_irs: false,
        rcv_nxt: 0,
        rcv_adv_right: 0,
        read_off: 0,
        ooo: ChunkSeq::with_capacity[OooRange](widen_u64(cfg.max_ooo_ranges)),
        ooo_stamp: 0,
        ooo_fin: Option::None,
        fin_received: false,
        urgent_off: Option::None,
        ts_recent: 0,
        ts_recent_valid: false,
        last_ack_sent: 0,
        ack_now: false,
        ack_pending: 0,
        delack_deadline: Option::None,
        challenge_window_ns: 0,
        challenge_count: 0,
        pending_rst: Option::None,
        time_wait_deadline: Option::None,
        events: 0,
        close_reason: Option::None,
        stats: zero_stats(),
        cmds: ChunkSeq::with_capacity[CcCmd](64),
        edt_entry: Option::None,
        edt_armed_rto: false
    }
}
