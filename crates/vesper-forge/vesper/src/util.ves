// Module util of @vesper/forge: word and byte reads, sorted scope sets and
// origin sets.

// The error codes of `fg_parse` and `fg_resolve` (0 is success), shared
// with src/port.rs.
pub enum Code: _ {
    Depth = 1,
    Unbalanced = 2,
    Parse = 3,
    Exhausted = 4,
    PreresolvedBinder = 5,
    MixedPath = 6,
    Unbound = 7,
    Ambiguous = 8,
    WrongKind = 9,
    ExpectedGlobal = 10,
    UnknownDefinition = 11,
    UnknownPackage = 12,
    NotADependency = 13,
    Private = 14,
    PrintedMismatch = 15,
    Parameter = 16
}

// The `expected` texts of `ForgeError::Parse`.
pub enum Want: _ {
    End = 1,
    Eq = 2,
    Semi = 3,
    With = 4,
    CloseParen = 5,
    CloseBrace = 6,
    OpenBrace = 7,
    Ident = 8
}

// Token kinds (0 is past the end). A closing delimiter's kind is its
// opening one's plus `Close`.
pub enum Tk: _ {
    Ident = 1,
    Punct = 2,
    Int = 3,
    Str = 4,
    OpenParen = 5,
    OpenBrace = 7,
    CloseParen = 8,
    CloseBrace = 10,
    Close = 3
}

// The tags of term nodes: post-order out of the parser, pre-order in `w`.
pub enum Node: _ {
    Ref = 1,
    Lit = 2,
    Let = 3,
    Call = 4,
    Handle = 5,
    Block = 6
}

// A token row of `fg_parse`: kind, text start, text len.
pub enum Row: _ {
    Kind = 0,
    Start = 1,
    Len = 2,
    Words = 3
}

// The header words of `w` and its token rows (layouts in resolve.ves).
pub enum W: _ {
    MaxDepth = 0,
    NextScope = 1,
    ScopeLimit = 2,
    NextBinder = 3,
    BinderLimit = 4,
    Tokens = 5,
    TokenBase = 6,
    OriginBase = 8,
    Defs = 11,
    DefBase = 12,
    Params = 15,
    ParamBase = 16,
    Term = 17
}

pub enum Token: _ {
    Kind = 0,
    Symbol = 1,
    Origin = 2,
    HasClaim = 3,
    ClaimPackage = 4,
    ClaimItem = 5,
    ScopesFirst = 6,
    ScopesLen = 7,
    TextStart = 8,
    TextLen = 9,
    Words = 10
}

// The header of `fg_resolve`'s result.
pub enum Out: _ {
    Error = 0,
    Scopes = 1,
    Binders = 2,
    E1 = 3,
    E2 = 4,
    E3 = 5,
    E4 = 6,
    Extra = 7,
    Words = 8
}

// What `byte` reads past the end: no byte.
const PAST_END: u64 = 256;

// Word `i` of `s`, or 0 past its end.
pub fn wd(in s: Slice[u64], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

// Word `i` of `s`, or 0 past its end.
pub fn sq(in s: ChunkSeq[u64], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

// Byte `i` of `s` as a word, or `PAST_END` past its end.
pub fn byte(in s: Slice[u8], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(v) => widen_u64(v),
        Option::None => PAST_END,
    }
}

// Whether text[start..start + len] spells `lit`.
pub fn spells(in text: Slice[u8], start: u64, len: u64, in lit: Str) -> bool {
    let b = lit.as_bytes();
    if b.len() != len {
        return false;
    }
    for i in 0..len {
        if byte(in text, wrapping_add(start, i)) != byte(in b, i) {
            return false;
        }
    }
    true
}

// Whether the sorted set a[af..af + al] is a subset of the sorted set
// b[bf..bf + bl] (`ScopeSet::is_subset`).
pub fn subset(in a: Slice[u64], af: u64, al: u64, in b: Slice[u64], bf: u64, bl: u64) -> bool {
    if al > bl {
        return false;
    }
    let mut j: u64 = 0;
    for i in 0..al {
        let x = wd(in a, wrapping_add(af, i));
        loop {
            if j >= bl {
                return false;
            }
            let y = wd(in b, wrapping_add(bf, j));
            j = wrapping_add(j, 1);
            if y == x {
                break;
            }
            if y > x {
                return false;
            }
        }
    }
    true
}

// Whether the sorted sets a[af..af + al] and b[bf..bf + bl] are equal.
pub fn same_set(in a: Slice[u64], af: u64, al: u64, in b: Slice[u64], bf: u64, bl: u64) -> bool {
    if al != bl {
        return false;
    }
    for i in 0..al {
        if wd(in a, wrapping_add(af, i)) != wd(in b, wrapping_add(bf, i)) {
            return false;
        }
    }
    true
}

// Inserts `v` into the sorted, duplicate-free run s[from..] (a
// `BTreeSet` insert), keeping it sorted.
pub fn set_insert(inout s: ChunkSeq[u64], from: u64, v: u64) {
    let n = s.len();
    let mut i = n;
    loop {
        if i <= from {
            break;
        }
        let x = sq(in s, wrapping_sub(i, 1));
        if x == v {
            return;
        }
        if x < v {
            break;
        }
        i = wrapping_sub(i, 1);
    }
    s.push(v);
    let mut k = n;
    loop {
        if k <= i {
            break;
        }
        let x = sq(in s, wrapping_sub(k, 1));
        let _ = s.try_set(k, x);
        k = wrapping_sub(k, 1);
    }
    let _ = s.try_set(i, v);
}
