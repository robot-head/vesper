load("//tools/bazel:defs.bzl", "vesper_crate")
load("//tools/bazel:vesper_port.bzl", "VESPER_TARGET", "vesper_package", "vesper_port_object")

# The Rust build is the default (default features, generated by
# vesper_crate below). The Vesper port of the hygiene core (the Loom package
# in vesper/, Cargo feature `vesper-port`, self-hosting SH1 lane 14, #1157)
# is non-default until it reaches parity. The compiler links neither: it
# links the Rust seed copy, //crates/vesper-forge/seed (seed-copy rule,
# docs/maintenance/porting-a-crate.md).
vesper_package(
    name = "port_package",
    srcs = glob(["vesper/src/**/*.ves"]),
    manifest = "vesper/Loom.toml",
)

vesper_port_object(
    name = "forge_vesper",
    library = "forge",
    package = ":port_package",
    target = VESPER_TARGET,
)

filegroup(
    name = "forge_vesper_binding",
    srcs = [":forge_vesper"],
    output_group = "rust_binding",
)

# The divergent builds, one per ported area: the same edits as the Cargo
# feature `vesper-port-divergent` (EDITS in build.rs). They must build; the
# Cargo run in port/test-port.sh (scripts/test-port-harness.sh) asserts that
# the tests catch each edit.
[
    vesper_port_object(
        name = "forge_vesper_divergent_" + area,
        edit_src = src,
        edits = {old: new},
        library = "forge",
        package = ":port_package",
        target = VESPER_TARGET,
    )
    for area, src, old, new in [
        (
            "delimiters",
            "vesper/src/parse.ves",
            "            if wrapping_add(top, Tk::Close) != k {",
            "            if top == 0 {",
        ),
        (
            "parse",
            "vesper/src/parse.ves",
            "\n        && !text_is(in toks, in text, p.pos, in \"with\") {",
            " {",
        ),
        (
            "resolve",
            "vesper/src/resolve.ves",
            "            if rank <= sq(in ctx, wrapping_add(wrapping_mul(j, Ctx::Words), Ctx::Rank)) {",
            "            if rank <= 18446744073709551615 {",
        ),
        (
            "registry",
            "vesper/src/resolve.ves",
            "    if def_word(in w, in g, d, Def::Visibility) != Vis::Public {",
            "    if def_word(in w, in g, d, Def::Visibility) > 1 {",
        ),
    ]
]

# The build script links the object only under `vesper-port`; passing it
# keeps the port in this package's dependency graph.
vesper_crate(
    build_script_data = [
        ":forge_vesper",
        ":forge_vesper_binding",
    ],
    build_script_env = {
        # rules_rust already makes these execpaths absolute.
        "VESPER_PORT_OBJECT": "$(execpath :forge_vesper)",
        "VESPER_PORT_GENERATED_BINDING": "$(execpath :forge_vesper_binding)",
    },
    extra_compile_data = ["//crates/vesper-loom-sandbox:files"],
)

# The seed package (seed/) builds these same Rust sources without the port.
exports_files(glob([
    "src/**/*.rs",
    "tests/**/*.rs",
]))

filegroup(
    name = "rust_srcs",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//crates/vesper-forge/seed:__pkg__"],
)
