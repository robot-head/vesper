# The frozen Rust seed copy of vesper-forge (package vesper-forge-seed,
# library vesper_forge) that the compiler links: ../src built without the
# port, so cfg(vesper_port) is off. Written by hand because its sources live
# in the parent package; see "Crates the compiler links" in
# docs/maintenance/porting-a-crate.md (self-hosting SH1 lane 14, #1157).
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rs//rs/private:all_crate_deps.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test")
load("@vesper_cargo//:packages.bzl", "PACKAGES")

# The seed's dependencies and features (`sandbox-transport` where the
# workspace enables it) from its Cargo metadata, as vesper_crate derives
# them.
_DATA = PACKAGES["crates/vesper-forge/seed"].crate_data()

_NORMAL = all_crate_deps(_DATA, platforms = _DATA["platforms"], normal = True)

_DEV = all_crate_deps(_DATA, platforms = _DATA["platforms"], normal_dev = True)

_FEATURES = _DATA.get("crate_features", [])

_ENV = {
    "CARGO_PKG_NAME": "vesper-forge-seed",
    "CARGO_PKG_VERSION": "0.1.0",
}

rust_library(
    name = "seed",
    srcs = ["//crates/vesper-forge:rust_srcs"],
    crate_features = _FEATURES,
    crate_name = "vesper_forge",
    crate_root = "//crates/vesper-forge:src/lib.rs",
    edition = "2024",
    rustc_env = _ENV,
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = _NORMAL,
)

rust_test(
    name = "seed_unit_test",
    crate = ":seed",
    crate_features = _FEATURES,
    edition = "2024",
    deps = _DEV,
)

[
    rust_test(
        name = "seed_test_" + t,
        srcs = [
            "//crates/vesper-forge:tests/%s.rs" % t,
            "//crates/vesper-forge:tests/common/mod.rs",
        ],
        # tests/sandbox_execution.rs includes the sandbox's fixture
        # component.
        compile_data = ["//crates/vesper-loom-sandbox:files"],
        crate_features = _FEATURES,
        crate_root = "//crates/vesper-forge:tests/%s.rs" % t,
        edition = "2024",
        rustc_env = _ENV,
        deps = [":seed"] + _NORMAL + _DEV,
    )
    for t in [
        "authority",
        "fragment",
        "hygiene",
        "sandbox_execution",
        "transport",
        "typed_function_parameters",
        "typed_quote",
        "typed_tuple",
    ]
]

rust_clippy_test(
    name = "clippy",
    targets = [":seed"],
    tags = [
        "clippy",
        "lint",
    ],
)
