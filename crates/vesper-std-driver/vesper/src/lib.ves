// @export vsys StdFs rust=crate::fs
// @export vsys StdProcess rust=crate::process
// @export vsys StdEnv rust=crate::env
//
// The sample driver of self-hosting SH0 lane 3 (#1125): the I/O a Vesper
// compiler driver does, through @vesper-std/fs, process and env. It reads
// its settings from the environment, walks a package's `src/**`, reads
// every `.ves` file, spawns a compiler (`cc --version` by default) and
// writes a report atomically:
//
//     file <relative path> <size> <FNV-1a 64 of the contents, hex>
//     ...
//     files <count>
//     bytes <total size>
//     cc <exit code> <first line of stdout>      (or: cc error <kind>)
//
// The three `.vsys` libraries come from the packages' manifests
// (`[package] vsys` in packages/vesper-std/{fs,process,env}/Loom.toml); the
// directives above only name the Rust modules of this crate that provide
// their symbols.
use @vesper-std/fs::{
    IoError,
    read_path,
    replace_path,
    metadata_path,
    kind_file
};
use @vesper-std/fs::walk::{
    walk_path,
    entry_count,
    entry_start,
    entry_end,
    entry_kind,
    entry_join
};
use @vesper-std/process::{
    command_path,
    arg,
    output
};
use @vesper-std/env::var_bytes;
use @vesper-std/fmt::{
    write_u64,
    write_i64,
    write_hex_u64
};

fn fnv(in s: Slice[u8]) -> u64 {
    let mut h: u64 = 14695981039346656037;
    for i in 0..s.len() {
        let b = match s.try_get(i) {
            Option::Some(b) => b,
            Option::None => 0,
        };
        h = wrapping_mul(h ^ widen_u64(b), 1099511628211);
    }
    h
}

// Byte `i` of `s` (0 past the end).
fn at(in s: Slice[u8], i: u64) -> u8 {
    match s.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

// Whether `bytes[a..b]` ends in `.ves`.
fn is_ves(in bytes: Slice[u8], a: u64, b: u64) -> bool {
    if wrapping_sub(b, a) < 4 || b < 4 {
        return false;
    }
    let s = wrapping_sub(b, 4);
    let dot = at(in bytes, s) == 46;
    let v = at(in bytes, wrapping_add(s, 1)) == 118;
    let e = at(in bytes, wrapping_add(s, 2)) == 101;
    let x = at(in bytes, wrapping_add(s, 3)) == 115;
    dot && v && e && x
}

fn setting(in name: Str, in fallback: Str) -> ChunkSeq[u8] eff [Ffi[StdEnv]] {
    match var_bytes(in name) {
        Option::Some(b) => b,
        Option::None => {
            let mut b: ChunkSeq[u8] = ChunkSeq::new[u8]();
            b.extend(in fallback.as_bytes());
            b
        },
    }
}

fn first_line(in s: Slice[u8]) -> u64 {
    let mut n = s.len();
    for i in 0..s.len() {
        let b = match s.try_get(i) {
            Option::Some(b) => b,
            Option::None => 0,
        };
        if (b == 10 || b == 13) && n == s.len() {
            n = i;
        }
    }
    n
}

fn compiler(in cc: Slice[u8], inout report: ChunkSeq[u8]) eff [Ffi[StdProcess]] {
    report.extend(in "cc ".as_bytes());
    let failed = handle Fail[IoError] in {
        let mut c = command_path(in cc);
        arg(inout c, in "--version");
        let out = output(c);
        write_i64(inout report, out.status.code);
        report.push(32);
        let n = first_line(in out.stdout.as_slice());
        report.extend(in out.stdout[0..n]);
        0
    } with {
        return v => v,
        raise(e, _) => wrapping_add(1000, widen_u64(e.kind)),
    };
    if failed != 0 {
        report.extend(in "error ".as_bytes());
        write_u64(inout report, wrapping_sub(failed, 1000));
    }
    report.push(10);
}

fn drive() -> u64 eff [Ffi[StdFs], Ffi[StdProcess], Ffi[StdEnv], Fail[IoError]] {
    let root = setting(in "VESPER_STD_DRIVER_ROOT", in ".");
    let out = setting(in "VESPER_STD_DRIVER_OUT", in "io-driver-report.txt");
    let cc = setting(in "VESPER_STD_DRIVER_CC", in "cc");
    let mut src: ChunkSeq[u8] = ChunkSeq::new[u8]();
    src.extend(in root.as_slice());
    src.extend(in "/src".as_bytes());
    let e = walk_path(in src.as_slice());
    let mut report: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let mut files: u64 = 0;
    let mut total: u64 = 0;
    for i in 0..entry_count(in e) {
        let a = entry_start(in e, i);
        let b = entry_end(in e, i);
        if entry_kind(in e, i) == kind_file() && is_ves(in e.bytes.as_slice(), a, b) {
            let path = entry_join(in src.as_slice(), in e, i);
            let size = metadata_path(in path.as_slice()).size;
            let text = read_path(in path.as_slice());
            report.extend(in "file ".as_bytes());
            report.extend(in e.bytes[a..b]);
            report.push(32);
            write_u64(inout report, size);
            report.push(32);
            write_hex_u64(inout report, fnv(in text.as_slice()), 16);
            report.push(10);
            files = wrapping_add(files, 1);
            total = wrapping_add(total, size);
        }
    }
    report.extend(in "files ".as_bytes());
    write_u64(inout report, files);
    report.extend(in "\nbytes ".as_bytes());
    write_u64(inout report, total);
    report.push(10);
    compiler(in cc.as_slice(), inout report);
    replace_path(in out.as_slice(), in report.as_slice());
    files
}

// Run the driver: the number of `.ves` files reported, or 1,000,000 plus
// the IoError kind when the walk, a read or the write failed.
pub fn run() -> u64 eff [Ffi[StdFs], Ffi[StdProcess], Ffi[StdEnv]] {
    handle Fail[IoError] in {
        drive()
    } with {
        return v => v,
        raise(e, _) => wrapping_add(1000000, widen_u64(e.kind)),
    }
}
