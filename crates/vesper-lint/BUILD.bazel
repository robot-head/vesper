load("//tools/bazel:defs.bzl", "vesper_crate")
load("//tools/bazel:vesper_port.bzl", "VESPER_TARGET", "vesper_package", "vesper_port_object")

# The Rust build is the default (default features, generated by vesper_crate
# below). The Vesper port (the Loom package in vesper/, Cargo feature
# `vesper-port`, self-hosting SH1 lane 13, #1156) is non-default until the
# compiler switches to it. The compiler links neither: it links the Rust seed
# copy, //crates/vesper-lint/seed (seed-copy rule,
# docs/maintenance/porting-a-crate.md). The port's differential tests run in
# Cargo (port/test-port.sh, Linux port shard 7).
vesper_package(
    name = "port_package",
    srcs = glob(["vesper/src/**/*.ves"]),
    manifest = "vesper/Loom.toml",
    deps = [
        "//:ast_package",
        "//:std_intern_package",
        "//:std_sort_package",
    ],
)

vesper_port_object(
    name = "lint_vesper",
    library = "lint",
    package = ":port_package",
    rust_types = "crate::port",
    target = VESPER_TARGET,
)

filegroup(
    name = "lint_vesper_binding",
    srcs = [":lint_vesper"],
    output_group = "rust_binding",
)

# The divergent builds, one per ported area (the Cargo
# `vesper-port-divergent` feature applies the same edits from build.rs, one
# at a time with VESPER_LINT_DIVERGE): each must keep compiling, and
# port/test-port.sh asserts that the differential test catches it.
[
    vesper_port_object(
        name = "lint_vesper_divergent_" + area,
        edit_src = "vesper/src/" + src,
        edits = {old: new},
        library = "lint",
        package = ":port_package",
        rust_types = "crate::port",
        target = VESPER_TARGET,
    )
    for area, src, old, new in [
        (
            "effects",
            "lib.ves",
            "(q.label == NONE || e.label == q.label)",
            "(q.label == NONE || e.label != NONE)",
        ),
        (
            "projections",
            "lib.ves",
            "if starts_with(\n                    in p,\n                    act_path(in p, f, r),",
            "if path_eq(\n                    in p,\n                    act_path(in p, f, r),",
        ),
        (
            "toml",
            "policy.ves",
            "if x.kind != N_TABLE || !x.implicit || x.dotted {",
            "if x.kind != N_TABLE || !x.implicit {",
        ),
        (
            "edits",
            "lib.ves",
            "fail(E_CANDIDATE);",
            "fail(E_STALE);",
        ),
    ]
]

# The build script links this object only under `vesper-port`; passing it
# keeps the port in this package's dependency graph.
vesper_crate(
    build_script_data = [
        ":lint_vesper",
        ":lint_vesper_binding",
    ],
    build_script_env = {
        # rules_rust already makes these execpaths absolute.
        "VESPER_PORT_OBJECT": "$(execpath :lint_vesper)",
        "VESPER_PORT_GENERATED_BINDING": "$(execpath :lint_vesper_binding)",
    },
)

# The seed package (seed/) builds these same Rust sources without the port.
exports_files(glob([
    "src/**/*.rs",
    "tests/**/*.rs",
]) + ["examples/Loom.lint.toml"])

filegroup(
    name = "rust_srcs",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//crates/vesper-lint/seed:__pkg__"],
)
