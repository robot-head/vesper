# The frozen Rust seed copy of vesper-lint (package vesper-lint-seed, library
# vesper_lint) that the compiler links: ../src built without the port, so
# cfg(vesper_port) is off. Written by hand because its sources live in the
# parent package; see "Crates the compiler links" in
# docs/maintenance/porting-a-crate.md (self-hosting SH1 lane 13, #1156).
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rs//rs/private:all_crate_deps.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test")
load("@vesper_cargo//:packages.bzl", "PACKAGES")

# The seed's dependencies from its Cargo metadata, as vesper_crate derives
# them.
_DATA = PACKAGES["crates/vesper-lint/seed"].crate_data()

_NORMAL = all_crate_deps(_DATA, platforms = _DATA["platforms"], normal = True)

_ENV = {
    "CARGO_PKG_NAME": "vesper-lint-seed",
    "CARGO_PKG_VERSION": "0.1.0",
}

rust_library(
    name = "seed",
    srcs = ["//crates/vesper-lint:rust_srcs"],
    crate_name = "vesper_lint",
    crate_root = "//crates/vesper-lint:src/lib.rs",
    edition = "2024",
    rustc_env = _ENV,
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = _NORMAL,
)

rust_test(
    name = "seed_unit_test",
    crate = ":seed",
    edition = "2024",
)

# tests/policy.rs embeds the example policy at compile time.
[
    rust_test(
        name = "seed_test_" + t,
        srcs = ["//crates/vesper-lint:tests/%s.rs" % t],
        compile_data = ["//crates/vesper-lint:examples/Loom.lint.toml"],
        crate_root = "//crates/vesper-lint:tests/%s.rs" % t,
        edition = "2024",
        rustc_env = _ENV,
        deps = [":seed"] + _NORMAL,
    )
    for t in [
        "policy",
        "typed",
    ]
]

rust_clippy_test(
    name = "clippy",
    targets = [":seed"],
    tags = [
        "clippy",
        "lint",
    ],
)
