// plan.rs: the mounted state and reconciliation.
use self::codes::{
    Budget,
    OpTag,
    ValueTag,
    MAX_U64,
    NONE_ID
};
use self::{
    MNode,
    MProp,
    MSub,
    Mounted,
    Op,
    Prepared,
    Tree,
    ViewFault
};
use self::util::{
    add,
    bytes_eq,
    dec,
    find_key,
    fits,
    inc,
    insert_at,
    mnode,
    mprop,
    msub,
    op,
    position,
    remove_at,
    seq_u64,
    tnode,
    tprop,
    tsub
};
use self::view::{
    tree_find,
    tree_new
};

pub fn mounted_new() -> Mounted {
    Mounted {
        present: false,
        nodes: ChunkSeq::new[MNode](),
        props: ChunkSeq::new[MProp](),
        subs: ChunkSeq::new[MSub](),
        kids: ChunkSeq::new[u64](),
        kidx: ChunkSeq::new[u64](),
        text: ChunkSeq::new[u8](),
        keys: ChunkSeq::new[u64](),
        sorted: ChunkSeq::new[u64]()
    }
}

pub fn mounted_find(in m: Mounted, key: u64) -> u64 {
    if m.present {
        find_key(in m.keys, in m.sorted, key)
    } else {
        NONE_ID
    }
}

// The property `property` of mounted node `n`, as an index into `props`.
pub fn mounted_prop(in m: Mounted, n: MNode, property: u64) -> u64 {
    for j in 0..n.pcount {
        if mprop(in m.props, add(n.pstart, j)).property == property {
            return add(n.pstart, j);
        }
    }
    NONE_ID
}

pub fn mounted_sub(in m: Mounted, n: MNode, event: u64) -> u64 {
    for j in 0..n.scount {
        if msub(in m.subs, add(n.sstart, j)).event == event {
            return add(n.sstart, j);
        }
    }
    NONE_ID
}

pub fn copy_mounted(in src: Mounted, inout dst: Mounted) {
    dst.present = src.present;
    dst.nodes.clear();
    dst.props.clear();
    dst.subs.clear();
    dst.kids.clear();
    dst.kidx.clear();
    dst.text.clear();
    dst.keys.clear();
    dst.sorted.clear();
    dst.nodes.extend(in src.nodes.as_slice());
    dst.props.extend(in src.props.as_slice());
    dst.subs.extend(in src.subs.as_slice());
    dst.kids.extend(in src.kids.as_slice());
    dst.kidx.extend(in src.kidx.as_slice());
    dst.text.extend(in src.text.as_slice());
    dst.keys.extend(in src.keys.as_slice());
    dst.sorted.extend(in src.sorted.as_slice());
}

// Whether mounted property `a` of `old` holds the same value as `b` of `new`.
pub fn same_value(in old: Mounted, a: MProp, in new: Mounted, b: MProp) -> bool {
    if a.tag != b.tag {
        false
    } else if a.tag != 0 {
        a.payload == b.payload
    } else if a.tlen != b.tlen {
        false
    } else if fits(a.tstart, a.tlen, old.text.len()) && fits(b.tstart, b.tlen, new.text.len()) {
        bytes_eq(
            in old.text[a.tstart..add(a.tstart, a.tlen)],
            in new.text[b.tstart..add(b.tstart, b.tlen)]
        )
    } else {
        false
    }
}

pub fn prepared_empty(session: u64, base: u64, serial: u64) -> Prepared {
    Prepared {
        fault: Option::None,
        session: session,
        base: base,
        next: base,
        serial: serial,
        ops: ChunkSeq::new[Op](),
        tree: tree_new(),
        m: mounted_new(),
        prev: ChunkSeq::new[u64](),
        succ: ChunkSeq::new[u64](),
        cur: ChunkSeq::new[u64](),
        cur_start: ChunkSeq::new[u64](),
        cur_len: ChunkSeq::new[u64]()
    }
}

// A prepared update for the validated `tree`, with the next mounted state
// sized to the tree's shape.
pub fn prepared_for(session: u64, base: u64, serial: u64, sink tree: Tree, text_len: u64)
    -> Prepared {
    let n = tree.nodes.len();
    let np = tree.props.len();
    let ns = tree.subs.len();
    let nk = tree.kids.len();
    Prepared {
        fault: Option::None,
        session: session,
        base: base,
        next: base,
        serial: serial,
        ops: ChunkSeq::new[Op](),
        tree: tree,
        m: Mounted {
            present: false,
            nodes: ChunkSeq::with_capacity[MNode](n),
            props: ChunkSeq::with_capacity[MProp](np),
            subs: ChunkSeq::with_capacity[MSub](ns),
            kids: ChunkSeq::with_capacity[u64](nk),
            kidx: ChunkSeq::with_capacity[u64](nk),
            text: ChunkSeq::with_capacity[u8](text_len),
            keys: ChunkSeq::with_capacity[u64](n),
            sorted: ChunkSeq::with_capacity[u64](n)
        },
        prev: ChunkSeq::with_capacity[u64](n),
        succ: ChunkSeq::new[u64](),
        cur: ChunkSeq::with_capacity[u64](nk),
        cur_start: ChunkSeq::with_capacity[u64](n),
        cur_len: ChunkSeq::with_capacity[u64](n)
    }
}

// Ids::next: hand out the counter, failing once it would overflow.
pub fn next_id(inout p: Prepared) -> Option[u64] {
    let n = p.serial;
    if n == MAX_U64 {
        Option::None
    } else {
        p.serial = inc(n);
        Option::Some(n)
    }
}

// Push one patch, or record the patch budget failure and answer false.
pub fn emit(inout p: Prepared, max: u64, o: Op) -> bool {
    if p.ops.len() >= max {
        p.fault = Option::Some(ViewFault::Budget(Budget::Patches));
        false
    } else {
        p.ops.push(o);
        true
    }
}

pub fn exhausted(inout p: Prepared) {
    p.fault = Option::Some(ViewFault::IdentityExhausted);
}

// Build the next mounted state from the validated tree: retained widgets,
// slots and subscriptions keep their identities, everything else gets a
// fresh one, in the order plan::build hands them out. `prev` maps each new
// node to the old node it retains (or none).
// Match old and new nodes by merging the two key orders: `old_of[ti]` is
// the old node with tree node `ti`'s key and `new_of[oi]` the tree node
// with old node `oi`'s key (none when absent). Keys are unique on both
// sides.
pub fn match_keys(
    in old: Mounted,
    in t: Tree,
    inout old_of: ChunkSeq[u64],
    inout new_of: ChunkSeq[u64]
) {
    for i in 0..t.nodes.len() {
        old_of.push(NONE_ID);
    }
    for i in 0..old.nodes.len() {
        new_of.push(NONE_ID);
    }
    if !old.present {
        return;
    }
    let na = old.sorted.len();
    let nb = t.sorted.len();
    let mut a: u64 = 0;
    let mut b: u64 = 0;
    loop {
        if a >= na || b >= nb {
            break;
        }
        let oi = seq_u64(in old.sorted, a);
        let ti = seq_u64(in t.sorted, b);
        let ka = seq_u64(in old.keys, oi);
        let kb = seq_u64(in t.keys, ti);
        if ka < kb {
            a = inc(a);
        } else if kb < ka {
            b = inc(b);
        } else {
            old_of.try_set(ti, oi);
            new_of.try_set(oi, ti);
            a = inc(a);
            b = inc(b);
        }
    }
}

// pos[ti]: the pre-order position of tree node `ti` (every node of a
// validated tree is in its order).
pub fn positions(in t: Tree, inout pos: ChunkSeq[u64]) {
    for i in 0..t.nodes.len() {
        pos.push(NONE_ID);
    }
    for oi in 0..t.order.len() {
        pos.try_set(seq_u64(in t.order, oi), oi);
    }
}

pub fn mount_next(
    in old: Mounted,
    inout p: Prepared,
    in text: Slice[u8],
    in old_of: ChunkSeq[u64],
    in pos: ChunkSeq[u64]
) {
    for oi in 0..p.tree.order.len() {
        let ti = seq_u64(in p.tree.order, oi);
        let tn = tnode(in p.tree.nodes, ti);
        let found = seq_u64(in old_of, ti);
        let retained = found != NONE_ID && mnode(in old.nodes, found).kind == tn.kind;
        let prev = if retained {
            found
        } else {
            NONE_ID
        };
        let pn = mnode(in old.nodes, prev);
        let id = if retained {
            pn.id
        } else {
            match next_id(inout p) {
                Option::Some(v) => v,
                Option::None => {
                    exhausted(inout p);
                    return;
                },
            }
        };
        let pstart = p.m.props.len();
        for j in 0..tn.pcount {
            let tp = tprop(in p.tree.props, add(tn.pstart, j));
            let old_prop = if retained {
                mounted_prop(in old, pn, tp.property)
            } else {
                NONE_ID
            };
            let slot = if old_prop != NONE_ID {
                mprop(in old.props, old_prop).slot
            } else {
                match next_id(inout p) {
                    Option::Some(v) => v,
                    Option::None => {
                        exhausted(inout p);
                        return;
                    },
                }
            };
            let tstart = p.m.text.len();
            if tp.tag == ValueTag::Text && fits(tp.tstart, tp.tlen, text.len()) {
                p.m.text.extend(in text[tp.tstart..add(tp.tstart, tp.tlen)]);
            }
            p
                .m
                .props
                .push(
                    MProp {
                        property: tp.property,
                        slot: slot,
                        tag: tp.tag,
                        payload: tp.payload,
                        tstart: tstart,
                        tlen: if tp.tag == ValueTag::Text {
                            tp.tlen
                        } else {
                            0
                        }
                    }
                );
        }
        let sstart = p.m.subs.len();
        for j in 0..tn.scount {
            let ts = tsub(in p.tree.subs, add(tn.sstart, j));
            let old_sub = if retained {
                mounted_sub(in old, pn, ts.event)
            } else {
                NONE_ID
            };
            let keep = old_sub != NONE_ID && msub(in old.subs, old_sub).handler == ts.handler;
            let sid = if keep {
                msub(in old.subs, old_sub).id
            } else {
                match next_id(inout p) {
                    Option::Some(v) => v,
                    Option::None => {
                        exhausted(inout p);
                        return;
                    },
                }
            };
            p
                .m
                .subs
                .push(
                    MSub {
                        event: ts.event,
                        id: sid,
                        handler: ts.handler
                    }
                );
        }
        let cstart = p.m.kids.len();
        for j in 0..tn.ccount {
            p.m.kids.push(seq_u64(in p.tree.kids, add(tn.cstart, j)));
            p.m.kidx.push(seq_u64(in pos, seq_u64(in p.tree.kidx, add(tn.cstart, j))));
        }
        p
            .m
            .nodes
            .push(
                MNode {
                    key: tn.key,
                    id: id,
                    kind: tn.kind,
                    src: ti,
                    pstart: pstart,
                    pcount: tn.pcount,
                    sstart: sstart,
                    scount: tn.scount,
                    cstart: cstart,
                    ccount: tn.ccount
                }
            );
        p.m.keys.push(tn.key);
        p.prev.push(prev);
        p.cur_start.push(0);
        p.cur_len.push(0);
    }
    p.m.present = true;
    // The keys are the tree's, so their order is the tree's `sorted`
    // mapped to pre-order positions.
    for r in 0..p.tree.sorted.len() {
        p.m.sorted.push(seq_u64(in pos, seq_u64(in p.tree.sorted, r)));
    }
}

// Whether `key` has a parent in the new tree and that parent is `parent_key`
// (a key can be u64::MAX, so a missing parent is not a sentinel key).
pub fn new_parent_is(in t: Tree, key: u64, parent_key: u64) -> bool {
    let c = tree_find(in t, key);
    if c == NONE_ID {
        false
    } else {
        let parent = seq_u64(in t.parent, c);
        parent != NONE_ID && tnode(in t.nodes, parent).key == parent_key
    }
}

// Whether new node `nj` has a parent in the new tree and that parent's key
// is `parent_key`.
pub fn new_parent_key_is(in p: Prepared, nj: u64, parent_key: u64) -> bool {
    let parent = seq_u64(in p.tree.parent, mnode(in p.m.nodes, nj).src);
    parent != NONE_ID && tnode(in p.tree.nodes, parent).key == parent_key
}

// Whether old node `oi` is retained, through `succ` (old index to new index).
pub fn old_retained(in p: Prepared, oi: u64) -> bool {
    seq_u64(in p.succ, oi) != NONE_ID
}

// Detach every edge not retained under the same parent, child-last per
// node; keep the rest per new node in `cur`.
pub fn detach(in old: Mounted, inout p: Prepared, max: u64) -> bool {
    let mut work: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for oi in 0..old.nodes.len() {
        let node = mnode(in old.nodes, oi);
        let keep_node = old_retained(in p, oi);
        work.clear();
        for j in 0..node.ccount {
            work.push(seq_u64(in old.kids, add(node.cstart, j)));
        }
        let mut i = node.ccount;
        loop {
            if i == 0 {
                break;
            }
            i = dec(i);
            let ci = seq_u64(in old.kidx, add(node.cstart, i));
            let keep = keep_node
                && old_retained(in p, ci)
                && new_parent_key_is(in p, seq_u64(in p.succ, ci), node.key);
            if !keep {
                if !emit(
                    inout p,
                    max,
                    op(OpTag::RemoveChild, node.id, mnode(in old.nodes, ci).id, i, 0)
                ) {
                    return false;
                }
                remove_at(inout work, i);
            }
        }
        if keep_node {
            let nj = seq_u64(in p.succ, oi);
            p.cur_start.try_set(nj, p.cur.len());
            p.cur_len.try_set(nj, work.len());
            for j in 0..work.len() {
                p.cur.push(seq_u64(in work, j));
            }
        }
    }
    true
}

// Disconnect, unbind and destroy, child-first.
pub fn teardown(in old: Mounted, inout p: Prepared, in found: ChunkSeq[u64], max: u64) -> bool {
    let mut oi = old.nodes.len();
    loop {
        if oi == 0 {
            break;
        }
        oi = dec(oi);
        let node = mnode(in old.nodes, oi);
        let nj = seq_u64(in found, oi);
        let next = mnode(in p.m.nodes, nj);
        for j in 0..node.scount {
            let s = msub(in old.subs, add(node.sstart, j));
            let keep = if nj == NONE_ID {
                false
            } else {
                let k = mounted_sub(in p.m, next, s.event);
                k != NONE_ID && msub(in p.m.subs, k).id == s.id
            };
            if !keep {
                if !emit(inout p, max, op(OpTag::Disconnect, s.id, 0, 0, 0)) {
                    return false;
                }
            }
        }
        for j in 0..node.pcount {
            let s = mprop(in old.props, add(node.pstart, j));
            let keep = if nj == NONE_ID {
                false
            } else {
                let k = mounted_prop(in p.m, next, s.property);
                k != NONE_ID && mprop(in p.m.props, k).slot == s.slot
            };
            if !keep {
                if !emit(inout p, max, op(OpTag::UnbindSlot, node.id, s.property, s.slot, 0)) {
                    return false;
                }
            }
        }
        if !old_retained(in p, oi) {
            if !emit(inout p, max, op(OpTag::Destroy, node.id, 0, 0, 0)) {
                return false;
            }
        }
    }
    true
}

// Create new widgets, bind or update slots, subscribe, in pre-order.
pub fn create(in old: Mounted, inout p: Prepared, max: u64) -> bool {
    for nj in 0..p.m.nodes.len() {
        let node = mnode(in p.m.nodes, nj);
        let prev = seq_u64(in p.prev, nj);
        let pn = mnode(in old.nodes, prev);
        if prev == NONE_ID {
            if !emit(inout p, max, op(OpTag::Create, node.id, node.kind, 0, 0)) {
                return false;
            }
        }
        for j in 0..node.pcount {
            let s = mprop(in p.m.props, add(node.pstart, j));
            let k = if prev == NONE_ID {
                NONE_ID
            } else {
                mounted_prop(in old, pn, s.property)
            };
            if k == NONE_ID {
                if !emit(inout p, max, op(OpTag::BindSlot, node.id, s.property, s.slot, node.src)) {
                    return false;
                }
            } else if !same_value(in old, mprop(in old.props, k), in p.m, s) {
                if !emit(inout p, max, op(OpTag::SetSlot, s.slot, s.property, 0, node.src)) {
                    return false;
                }
            }
        }
        for j in 0..node.scount {
            let s = msub(in p.m.subs, add(node.sstart, j));
            let keep = if prev == NONE_ID {
                false
            } else {
                let k = mounted_sub(in old, pn, s.event);
                k != NONE_ID && msub(in old.subs, k).id == s.id
            };
            if !keep {
                if !emit(inout p, max, op(OpTag::Subscribe, node.id, s.event, s.handler, s.id)) {
                    return false;
                }
            }
        }
    }
    true
}

// Attach and reorder children: moves for retained edges, inserts for new.
pub fn attach(inout p: Prepared, max: u64) -> bool {
    let mut work: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for nj in 0..p.m.nodes.len() {
        let node = mnode(in p.m.nodes, nj);
        work.clear();
        let start = seq_u64(in p.cur_start, nj);
        for j in 0..seq_u64(in p.cur_len, nj) {
            work.push(seq_u64(in p.cur, add(start, j)));
        }
        for index in 0..node.ccount {
            let child = seq_u64(in p.m.kids, add(node.cstart, index));
            let here = index < work.len() && seq_u64(in work, index) == child;
            if !here {
                let child_id = mnode(in p.m.nodes, seq_u64(in p.m.kidx, add(node.cstart, index)))
                    .id;
                let from = position(in work, child);
                if from != NONE_ID {
                    if !emit(inout p, max, op(OpTag::MoveChild, node.id, child_id, from, index)) {
                        return false;
                    }
                    remove_at(inout work, from);
                    insert_at(inout work, index, child);
                } else {
                    if !emit(inout p, max, op(OpTag::InsertChild, node.id, child_id, index, 0)) {
                        return false;
                    }
                    insert_at(inout work, index, child);
                }
            }
        }
    }
    true
}

// plan::build: the sparse patch plan from `old` to the validated tree in
// `p.tree` (or to nothing), in the same safe application order.
pub fn plan(in old: Mounted, inout p: Prepared, has_tree: bool, in text: Slice[u8], max: u64) {
    let mut old_of: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut new_of: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut pos: ChunkSeq[u64] = ChunkSeq::new[u64]();
    if has_tree {
        match_keys(in old, in p.tree, inout old_of, inout new_of);
        positions(in p.tree, inout pos);
        mount_next(in old, inout p, in text, in old_of, in pos);
        match p.fault {
            Option::Some(_) => {
                return;
            },
            Option::None => (),
        }
    }
    // found[oi]: old node `oi`'s key in the new tree, or none.
    let mut found: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](old.nodes.len());
    for oi in 0..old.nodes.len() {
        let node = mnode(in old.nodes, oi);
        let ti = seq_u64(in new_of, oi);
        let nj = if ti == NONE_ID {
            NONE_ID
        } else {
            seq_u64(in pos, ti)
        };
        found.push(nj);
        let same = nj != NONE_ID && mnode(in p.m.nodes, nj).kind == node.kind;
        p
            .succ
            .push(
                if same {
                    nj
                } else {
                    NONE_ID
                }
            );
    }
    let old_root = mnode(in old.nodes, 0).id;
    let new_root = mnode(in p.m.nodes, 0).id;
    if old.present && (!has_tree || old_root != new_root) {
        if !emit(inout p, max, op(OpTag::SetRoot, 0, 0, 0, 0)) {
            return;
        }
    }
    if old.present {
        if !detach(in old, inout p, max) {
            return;
        }
        if !teardown(in old, inout p, in found, max) {
            return;
        }
    }
    if has_tree {
        if !create(in old, inout p, max) {
            return;
        }
        if !attach(inout p, max) {
            return;
        }
        if !old.present || new_root != old_root {
            if !emit(inout p, max, op(OpTag::SetRoot, 1, new_root, 0, 0)) {
                return;
            }
        }
    }
}
