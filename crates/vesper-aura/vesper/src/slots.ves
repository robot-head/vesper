// recording.rs: the slot, subscription and child patches.
use self::apply::{
    allocate,
    budget,
    foreign,
    invalid,
    push_text,
    record,
    same_text,
    stale_widget,
    word
};
use self::codes::{
    b_children,
    b_disconnect_counter,
    b_properties,
    b_subscription_counter,
    b_subscriptions,
    b_text,
    i_bound,
    i_event,
    i_insert_detached,
    i_insert_position,
    i_move_position,
    i_parent_mismatch,
    i_property,
    i_redundant,
    i_remove_position,
    i_subscribed,
    k_container,
    max_u64,
    none_id,
    op_insert_child,
    op_remove_child,
    v_text
};
use self::recording::{
    child_edge,
    child_scan,
    insert_edge,
    move_edge,
    move_target,
    redge,
    remove_edge,
    rslot,
    rsub,
    rwidget,
    session_ok,
    set_widget,
    slot_index,
    sub_index,
    widget_index,
    widget_slot,
    widget_slot_count,
    widget_sub,
    widget_sub_count
};
use self::{
    BackendFault,
    Edge,
    Lim,
    RSlot,
    RState,
    RSub,
    RWidget
};
use self::util::{
    dec,
    event_valid,
    inc,
    op,
    property_valid
};

// Recorded event tags (Op in lib.ves, decoded by src/ported/codec.rs);
// constants, not code functions, so that `record` inlines them (see
// docs/parallel-results/magic-constants.md).
const EV_SLOT_BOUND: u64 = 3;
const EV_SLOT_CHANGED: u64 = 4;
const EV_SLOT_UNBOUND: u64 = 5;
const EV_SUBSCRIBED: u64 = 6;
const EV_DISCONNECTED: u64 = 7;
const EV_CHILD_REMOVED: u64 = 8;
const EV_CHILD_INSERTED: u64 = 9;
const EV_CHILD_MOVED: u64 = 10;

pub fn patch_bind_slot(inout s: RState, lim: Lim, in w: Slice[u64], base: u64, in text: Slice[u8])
    -> Option[BackendFault] {
    if !session_ok(in s, word(in w, base, 1)) {
        return foreign();
    }
    let widget = word(in w, base, 2);
    let property = word(in w, base, 3);
    let slot = word(in w, base, 5);
    let vtag = word(in w, base, 6);
    let payload = word(in w, base, 7);
    let tstart = word(in w, base, 8);
    let tlen = word(in w, base, 9);
    match allocate(inout s, word(in w, base, 4), slot) {
        Option::Some(f) => {
            return Option::Some(f);
        },
        Option::None => (),
    }
    let i = widget_index(in s, widget);
    if i == none_id() {
        return stale_widget();
    }
    if widget_slot(in s, widget, property) != none_id() {
        return invalid(i_bound());
    }
    if widget_slot_count(in s, widget) >= lim.properties {
        return budget(b_properties());
    }
    if !property_valid(rwidget(in s.widgets, i).kind, property, vtag, payload) {
        return invalid(i_property());
    }
    if vtag == v_text() && tlen > lim.text {
        return budget(b_text());
    }
    let at = if vtag == v_text() {
        push_text(inout s, in text, tstart, tlen)
    } else {
        0
    };
    s
        .slots
        .push(
        RSlot {
            serial: slot,
            widget: widget,
            property: property,
            tag: vtag,
            payload: payload,
            tstart: at,
            tlen: if vtag == v_text() {
                tlen
            } else {
                0
            }
        }
    );
    s.slive.push(true);
    s.nslots = inc(s.nslots);
    record(inout s, lim, op(EV_SLOT_BOUND, slot, 0, 0, 0))
}

pub fn patch_set_slot(inout s: RState, lim: Lim, in w: Slice[u64], base: u64, in text: Slice[u8])
    -> Option[BackendFault] {
    if !session_ok(in s, word(in w, base, 1)) {
        return foreign();
    }
    let slot = word(in w, base, 2);
    let vtag = word(in w, base, 3);
    let payload = word(in w, base, 4);
    let tstart = word(in w, base, 5);
    let tlen = word(in w, base, 6);
    let k = slot_index(in s, slot);
    if k == none_id() {
        return Option::Some(BackendFault::StaleSlot);
    }
    let old = rslot(in s.slots, k);
    let i = widget_index(in s, old.widget);
    if i == none_id() {
        return stale_widget();
    }
    if !property_valid(rwidget(in s.widgets, i).kind, old.property, vtag, payload) {
        return invalid(i_property());
    }
    if vtag == v_text() && tlen > lim.text {
        return budget(b_text());
    }
    let same = if old.tag != vtag {
        false
    } else if vtag != v_text() {
        old.payload == payload
    } else {
        same_text(in s, old, in text, tstart, tlen)
    };
    if same {
        return invalid(i_redundant());
    }
    let at = if vtag == v_text() {
        push_text(inout s, in text, tstart, tlen)
    } else {
        0
    };
    s
        .slots
        .try_set(
        k,
        RSlot {
            serial: old.serial,
            widget: old.widget,
            property: old.property,
            tag: vtag,
            payload: payload,
            tstart: at,
            tlen: if vtag == v_text() {
                tlen
            } else {
                0
            }
        }
    );
    record(inout s, lim, op(EV_SLOT_CHANGED, slot, 0, 0, 0))
}

pub fn patch_unbind_slot(inout s: RState, lim: Lim, in w: Slice[u64], base: u64, in text: Slice[u8])
    -> Option[BackendFault] {
    let widget_session = word(in w, base, 1);
    let widget = word(in w, base, 2);
    let property = word(in w, base, 3);
    if !session_ok(in s, word(in w, base, 4)) {
        return foreign();
    }
    let slot = word(in w, base, 5);
    let k = slot_index(in s, slot);
    let owner = rslot(in s.slots, k);
    if k
        == none_id()
        || !session_ok(in s, widget_session)
        || owner
        .widget
        != widget
        || owner
        .property
        != property {
        return Option::Some(BackendFault::StaleSlot);
    }
    if widget_index(in s, widget) == none_id() {
        return stale_widget();
    }
    s.slive.try_set(k, false);
    s.nslots = dec(s.nslots);
    record(inout s, lim, op(EV_SLOT_UNBOUND, slot, 0, 0, 0))
}

pub fn patch_subscribe(inout s: RState, lim: Lim, in w: Slice[u64], base: u64, in text: Slice[u8])
    -> Option[BackendFault] {
    if !session_ok(in s, word(in w, base, 1)) {
        return foreign();
    }
    let widget = word(in w, base, 2);
    let event = word(in w, base, 3);
    let handler = word(in w, base, 4);
    let sub = word(in w, base, 6);
    match allocate(inout s, word(in w, base, 5), sub) {
        Option::Some(f) => {
            return Option::Some(f);
        },
        Option::None => (),
    }
    let i = widget_index(in s, widget);
    if i == none_id() {
        return stale_widget();
    }
    if widget_sub(in s, widget, event) != none_id() {
        return invalid(i_subscribed());
    }
    if widget_sub_count(in s, widget) >= lim.subscriptions {
        return budget(b_subscriptions());
    }
    if !event_valid(rwidget(in s.widgets, i).kind, event) {
        return invalid(i_event());
    }
    s
        .subs
        .push(
        RSub {
            serial: sub,
            widget: widget,
            event: event,
            handler: handler
        }
    );
    s.blive.push(true);
    s.nsubs = inc(s.nsubs);
    if s.created == max_u64() {
        return budget(b_subscription_counter());
    }
    s.created = inc(s.created);
    record(inout s, lim, op(EV_SUBSCRIBED, sub, 0, 0, 0))
}

pub fn patch_disconnect(inout s: RState, lim: Lim, in w: Slice[u64], base: u64, in text: Slice[u8])
    -> Option[BackendFault] {
    if !session_ok(in s, word(in w, base, 1)) {
        return foreign();
    }
    let sub = word(in w, base, 2);
    let k = sub_index(in s, sub);
    if k == none_id() {
        return Option::Some(BackendFault::StaleSubscription);
    }
    let v = rsub(in s.subs, k);
    s.blive.try_set(k, false);
    s.nsubs = dec(s.nsubs);
    if widget_index(in s, v.widget) == none_id() {
        return stale_widget();
    }
    if s.disconnected == max_u64() {
        return budget(b_disconnect_counter());
    }
    s.disconnected = inc(s.disconnected);
    record(inout s, lim, op(EV_DISCONNECTED, sub, 0, 0, 0))
}

pub fn patch_children(inout s: RState, lim: Lim, in w: Slice[u64], base: u64, in text: Slice[u8])
    -> Option[BackendFault] {
    let tag = word(in w, base, 0);
    if !session_ok(in s, word(in w, base, 1)) {
        return foreign();
    }
    if !session_ok(in s, word(in w, base, 3)) {
        return foreign();
    }
    let parent = word(in w, base, 2);
    let child = word(in w, base, 4);
    let index = word(in w, base, 5);
    if tag == op_remove_child() {
        if widget_index(in s, parent) == none_id() {
            return stale_widget();
        }
        let at = child_edge(in s, parent, index);
        if at == none_id() || redge(in s.edges, at).child != child {
            return invalid(i_remove_position());
        }
        remove_edge(inout s, at);
        let c = widget_index(in s, child);
        if c == none_id() {
            return stale_widget();
        }
        let cw = rwidget(in s.widgets, c);
        if !cw.has_parent || cw.parent != parent {
            return invalid(i_parent_mismatch());
        }
        set_widget(
            inout s,
            c,
            RWidget {
                serial: cw.serial,
                kind: cw.kind,
                has_parent: false,
                parent: 0,
                user_state: cw.user_state
            }
        );
        record(inout s, lim, op(EV_CHILD_REMOVED, parent, child, index, 0))
    } else if tag == op_insert_child() {
        let c = widget_index(in s, child);
        if c == none_id() {
            return stale_widget();
        }
        let cw = rwidget(in s.widgets, c);
        if parent == child || (s.has_root && s.root == child) || cw.has_parent {
            return invalid(i_insert_detached());
        }
        let pi = widget_index(in s, parent);
        if pi == none_id() {
            return stale_widget();
        }
        let (count, at) = child_scan(in s, parent, index);
        if rwidget(in s.widgets, pi).kind != k_container() || index > count {
            return invalid(i_insert_position());
        }
        if count >= lim.children {
            return budget(b_children());
        }
        let e = Edge {
            parent: parent,
            child: child
        };
        if at == none_id() {
            s.edges.push(e);
        } else {
            insert_edge(inout s, at, e);
        }
        set_widget(
            inout s,
            c,
            RWidget {
                serial: cw.serial,
                kind: cw.kind,
                has_parent: true,
                parent: parent,
                user_state: cw.user_state
            }
        );
        record(inout s, lim, op(EV_CHILD_INSERTED, parent, child, index, 0))
    } else {
        let to = word(in w, base, 6);
        if widget_index(in s, parent) == none_id() {
            return stale_widget();
        }
        let (count, at) = child_scan(in s, parent, index);
        if at == none_id() || redge(in s.edges, at).child != child || to >= count {
            return invalid(i_move_position());
        }
        let dest = move_target(in s, parent, at, to);
        move_edge(inout s, at, dest);
        record(inout s, lim, op(EV_CHILD_MOVED, parent, child, index, to))
    }
}
