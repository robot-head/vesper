// recording.rs: applying a transaction and the final checks.
use self::codes::{
    Budget,
    Invalid,
    OpTag,
    ValueTag,
    MAX_U64,
    NONE_ID
};
use self::recording::{
    copy_state,
    redge,
    rslot,
    rwidget,
    session_ok,
    widget_index
};
use self::slots::{
    patch_bind_slot,
    patch_children,
    patch_disconnect,
    patch_set_slot,
    patch_subscribe,
    patch_unbind_slot
};
use self::{
    BackendFault,
    Lim,
    Op,
    RSlot,
    RState,
    Recorder
};
use self::util::{
    add,
    bytes_eq,
    dec,
    fits,
    get_u64,
    inc,
    lim_ok,
    seq_bool,
    seq_u64
};
use self::widgets::{
    patch_create,
    patch_destroy,
    patch_set_root
};

// The words of one encoded patch: the tag, then every identity as a
// session and a serial (src/ported/codec.rs).
const PATCH_WORDS: u64 = 10;

pub fn word(in w: Slice[u64], base: u64, k: u64) -> u64 {
    get_u64(in w, add(base, k))
}

// RecordingSnapshot::allocate.
pub fn allocate(inout s: RState, session: u64, serial: u64) -> Option[BackendFault] {
    if !session_ok(in s, session) {
        return Option::Some(BackendFault::ForeignSession);
    }
    if serial <= s.high_water {
        return Option::Some(BackendFault::Invalid(Invalid::Reused));
    }
    s.high_water = serial;
    Option::None
}

pub fn foreign() -> Option[BackendFault] {
    Option::Some(BackendFault::ForeignSession)
}

pub fn invalid(code: u64) -> Option[BackendFault] {
    Option::Some(BackendFault::Invalid(code))
}

pub fn budget(code: u64) -> Option[BackendFault] {
    Option::Some(BackendFault::Budget(code))
}

pub fn stale_widget() -> Option[BackendFault] {
    Option::Some(BackendFault::StaleWidget)
}

pub fn record(inout s: RState, lim: Lim, e: Op) -> Option[BackendFault] {
    if s.events.len() >= lim.patches {
        return budget(Budget::EventBatch);
    }
    s.events.push(e);
    Option::None
}

// The text bytes of a value carried by a patch, compared with a stored one.
pub fn same_text(in s: RState, v: RSlot, in text: Slice[u8], tstart: u64, tlen: u64) -> bool {
    if v.tlen != tlen {
        false
    } else if fits(v.tstart, v.tlen, s.text.len()) && fits(tstart, tlen, text.len()) {
        bytes_eq(in s.text[v.tstart..add(v.tstart, v.tlen)], in text[tstart..add(tstart, tlen)])
    } else {
        false
    }
}

pub fn push_text(inout s: RState, in text: Slice[u8], tstart: u64, tlen: u64) -> u64 {
    let at = s.text.len();
    if fits(tstart, tlen, text.len()) {
        s.text.extend(in text[tstart..add(tstart, tlen)]);
    }
    at
}

// RecordingSnapshot::apply for the patch at `w[base ..]` (ten words: the tag,
// then every identity as a session and a serial; see src/ported/codec.rs).
pub fn apply_patch(inout s: RState, lim: Lim, in w: Slice[u64], base: u64, in text: Slice[u8])
    -> Option[BackendFault] {
    let tag = word(in w, base, 0);
    if tag == OpTag::SetRoot {
        patch_set_root(inout s, lim, in w, base, in text)
    } else if tag == OpTag::Create {
        patch_create(inout s, lim, in w, base, in text)
    } else if tag == OpTag::Destroy {
        patch_destroy(inout s, lim, in w, base, in text)
    } else if tag == OpTag::BindSlot {
        patch_bind_slot(inout s, lim, in w, base, in text)
    } else if tag == OpTag::SetSlot {
        patch_set_slot(inout s, lim, in w, base, in text)
    } else if tag == OpTag::UnbindSlot {
        patch_unbind_slot(inout s, lim, in w, base, in text)
    } else if tag == OpTag::Subscribe {
        patch_subscribe(inout s, lim, in w, base, in text)
    } else if tag == OpTag::Disconnect {
        patch_disconnect(inout s, lim, in w, base, in text)
    } else if tag == OpTag::RemoveChild || tag == OpTag::InsertChild || tag == OpTag::MoveChild {
        patch_children(inout s, lim, in w, base, in text)
    } else {
        invalid(Invalid::Limits)
    }
}

// RecordingSnapshot::validate_final over the staged state.
pub fn validate_final(inout rec: Recorder) -> Option[BackendFault] {
    let lim = rec.lim;
    if !rec.stage.has_root {
        if rec.stage.nwidgets == 0 && rec.stage.nslots == 0 && rec.stage.nsubs == 0 {
            return Option::None;
        }
        return invalid(Invalid::Unmounted);
    }
    // Separate session/backend limits are permitted, so the backend must
    // independently retain enough patch budget to close its accepted tree.
    let n = rec.stage.nwidgets;
    let ns = rec.stage.nslots;
    let nb = rec.stage.nsubs;
    let ne = rec.stage.edges.len();
    if n > wrapping_sub(MAX_U64, 1)
        || ns > wrapping_sub(MAX_U64, inc(n))
        || nb > wrapping_sub(MAX_U64, add(inc(n), ns))
        || ne > wrapping_sub(MAX_U64, add(add(inc(n), ns), nb)) {
        return budget(Budget::Teardown);
    }
    if add(add(add(inc(n), ns), nb), ne) > lim.patches {
        return budget(Budget::Teardown);
    }
    let mut total: u64 = 0;
    for i in 0..rec.stage.slots.len() {
        if seq_bool(in rec.stage.slive, i) {
            let v = rslot(in rec.stage.slots, i);
            if v.tag == ValueTag::Text {
                if v.tlen > lim.text {
                    return budget(Budget::Text);
                }
                if total > wrapping_sub(MAX_U64, v.tlen) {
                    return budget(Budget::TotalText);
                }
                total = add(total, v.tlen);
                if total > lim.total {
                    return budget(Budget::TotalText);
                }
            }
        }
    }
    // Group the edges by parent once: `kids[first[i] .. first[i + 1]]` are
    // the child widget indices (none when stale) of widget `i`, in edge
    // order, so the walk does not scan every edge for every widget.
    let nw = rec.stage.widgets.len();
    let mut first: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](inc(nw));
    for i in 0..inc(nw) {
        first.push(0);
    }
    let mut owner: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](ne);
    for e in 0..ne {
        let p = widget_index(in rec.stage, redge(in rec.stage.edges, e).parent);
        owner.push(p);
        if p != NONE_ID {
            let count = seq_u64(in first, inc(p));
            first.try_set(inc(p), inc(count));
        }
    }
    for i in 0..nw {
        let sum = add(seq_u64(in first, inc(i)), seq_u64(in first, i));
        first.try_set(inc(i), sum);
    }
    let mut next_at: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](nw);
    next_at.extend(in first[0..nw]);
    let mut kids: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](ne);
    for e in 0..ne {
        kids.push(NONE_ID);
    }
    for e in 0..ne {
        let p = seq_u64(in owner, e);
        if p != NONE_ID {
            let at = seq_u64(in next_at, p);
            kids.try_set(at, widget_index(in rec.stage, redge(in rec.stage.edges, e).child));
            next_at.try_set(p, inc(at));
        }
    }
    let mut seen_at: ChunkSeq[bool] = ChunkSeq::with_capacity[bool](nw);
    for i in 0..nw {
        seen_at.push(false);
    }
    // The walk holds widget indices; a stale child fails when it is pushed.
    let mut stack: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut depths: ChunkSeq[u64] = ChunkSeq::new[u64]();
    stack.push(widget_index(in rec.stage, rec.stage.root));
    depths.push(1);
    let mut seen: u64 = 0;
    loop {
        let top = stack.len();
        if top == 0 {
            break;
        }
        let i = seq_u64(in stack, dec(top));
        let depth = seq_u64(in depths, dec(top));
        stack.truncate(dec(top));
        depths.truncate(dec(top));
        if depth > lim.depth {
            return budget(Budget::Depth);
        }
        if i != NONE_ID && seq_bool(in seen_at, i) {
            return invalid(Invalid::Cycle);
        }
        if i == NONE_ID {
            return stale_widget();
        }
        seen_at.try_set(i, true);
        seen = inc(seen);
        let widget = rwidget(in rec.stage.widgets, i).serial;
        for k in seq_u64(in first, i)..seq_u64(in first, inc(i)) {
            let c = seq_u64(in kids, k);
            if c == NONE_ID {
                return stale_widget();
            }
            let cw = rwidget(in rec.stage.widgets, c);
            if !cw.has_parent || cw.parent != widget {
                return invalid(Invalid::BrokenParent);
            }
            stack.push(c);
            depths.push(inc(depth));
        }
    }
    if seen != n {
        return invalid(Invalid::Disconnected);
    }
    Option::None
}

// Backend::apply for RecordingBackend after the thread check: stage every
// patch, validate the result, publish it only if everything succeeded.
// `w` holds ten words per patch, `text` the bytes of their text values.
pub fn do_recorder_apply(
    inout rec: Recorder,
    session: u64,
    base: u64,
    next: u64,
    in w: Slice[u64],
    in text: Slice[u8]
) -> Option[BackendFault] {
    if !lim_ok(rec.lim) {
        return invalid(Invalid::Limits);
    }
    if rec.st.has_session && rec.st.session != session {
        return foreign();
    }
    if base == MAX_U64 || rec.st.revision != base || next != inc(base) {
        return Option::Some(BackendFault::StaleRevision);
    }
    let count = w.len() / PATCH_WORDS;
    if count > rec.lim.patches {
        return budget(Budget::Patches);
    }
    let has_reject = rec.has_reject;
    let reject = rec.reject;
    rec.has_reject = false;
    copy_state(in rec.st, inout rec.stage);
    rec.stage.has_session = true;
    rec.stage.session = session;
    rec.stage.events.clear();
    let lim = rec.lim;
    for i in 0..count {
        if has_reject && reject == i {
            return Option::Some(BackendFault::Injected(i));
        }
        match apply_patch(inout rec.stage, lim, in w, wrapping_mul(i, PATCH_WORDS), in text) {
            Option::Some(f) => {
                return Option::Some(f);
            },
            Option::None => (),
        }
    }
    if has_reject && reject >= count {
        return Option::Some(BackendFault::Injected(count));
    }
    match validate_final(inout rec) {
        Option::Some(f) => {
            return Option::Some(f);
        },
        Option::None => (),
    }
    rec.stage.revision = next;
    swap(inout rec.st, inout rec.stage);
    Option::None
}
