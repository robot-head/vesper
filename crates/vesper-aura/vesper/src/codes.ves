// The budget and message codes the wrappers turn into names (src/ported/codec.rs),
// as value enums the modules import.

// The id of no node.
pub const NONE_ID: u64 = 18446744073709551615;
pub const MAX_U64: u64 = 18446744073709551615;

// The budget names of ViewError::Budget and BackendError::Budget.
pub enum Budget: u64 {
    Nodes,
    Teardown,
    Children,
    Properties,
    Subscriptions,
    Text,
    TotalText,
    Depth,
    Patches,
    Slots,
    Handler,
    EventBatch,
    SubscriptionCounter,
    DisconnectCounter,
}

// The messages of BackendError::Invalid.
pub enum Invalid: u64 {
    Limits,
    Reused,
    RootParent,
    Destroy,
    Bound,
    Property,
    Redundant,
    SlotMismatch,
    Subscribed,
    Event,
    SubscriptionMismatch,
    RemovePosition,
    ParentMismatch,
    InsertDetached,
    InsertPosition,
    MovePosition,
    Unmounted,
    Cycle,
    BrokenParent,
    Disconnected,
}

// Widget kinds (ViewKind).
pub enum WidgetKind: u64 {
    Container,
    Text,
    Button,
    Input,
}

// Widget properties (Property).
pub enum Prop: u64 {
    Text,
    Value,
    Enabled,
    Visible,
    Width,
}

// Widget events (EventKind).
pub enum Event: u64 {
    Click,
    Changed,
    Focused,
}

// Property value tags (PropertyValue).
pub enum ValueTag: u64 {
    Text,
    Bool,
    Int,
}

// Patch tags (Op.tag of a plan; see Op in lib.ves).
pub enum OpTag: u64 {
    SetRoot,
    Create,
    Destroy,
    BindSlot,
    SetSlot,
    UnbindSlot,
    Subscribe,
    Disconnect,
    RemoveChild,
    InsertChild,
    MoveChild,
}
