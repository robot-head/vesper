// view.rs: decoding and validating an input tree.
use self::codes::{
    Budget,
    ValueTag,
    WidgetKind,
    MAX_U64,
    NONE_ID
};
use self::plan::{
    teardown
};
use self::{
    Lim,
    TNode,
    TProp,
    TSub,
    Tree,
    ViewFault
};
use self::util::{
    add,
    dec,
    event_valid,
    find_key,
    get_u64,
    inc,
    lim_ok,
    property_valid,
    seq_bool,
    seq_u64,
    sort_by_key,
    tnode,
    tprop,
    tsub
};

pub fn tree_new() -> Tree {
    Tree {
        root: 0,
        nodes: ChunkSeq::new[TNode](),
        props: ChunkSeq::new[TProp](),
        subs: ChunkSeq::new[TSub](),
        kids: ChunkSeq::new[u64](),
        kidx: ChunkSeq::new[u64](),
        keys: ChunkSeq::new[u64](),
        sorted: ChunkSeq::new[u64](),
        parent: ChunkSeq::new[u64](),
        order: ChunkSeq::new[u64]()
    }
}

// The node count to size a tree decoded from `w` for: every node is at
// least five words, so the count is not trusted past the input.
pub fn decode_cap(in w: Slice[u64]) -> u64 {
    let n = get_u64(in w, 1);
    if n < w.len() / 5 {
        n
    } else {
        w.len() / 5
    }
}

// An empty tree with room for `cap` nodes. (A new sequence assigned to a
// field of an `inout` handle does not free the old one natively, so the
// capacity is chosen when the tree is built.)
pub fn tree_sized(cap: u64) -> Tree {
    Tree {
        root: 0,
        nodes: ChunkSeq::with_capacity[TNode](cap),
        props: ChunkSeq::with_capacity[TProp](cap),
        subs: ChunkSeq::with_capacity[TSub](cap),
        kids: ChunkSeq::with_capacity[u64](cap),
        kidx: ChunkSeq::with_capacity[u64](cap),
        keys: ChunkSeq::with_capacity[u64](cap),
        sorted: ChunkSeq::with_capacity[u64](cap),
        parent: ChunkSeq::with_capacity[u64](cap),
        order: ChunkSeq::with_capacity[u64](cap)
    }
}

// Decode the wrapper's words: `root, n`, then per node `key, kind, np, ns,
// nc`, `np` properties of five words (property, tag, payload, text start,
// text length), `ns` subscriptions of two words (event, handler) and `nc`
// child keys.
pub fn decode(inout t: Tree, in w: Slice[u64]) {
    t.root = get_u64(in w, 0);
    let n = get_u64(in w, 1);
    let mut at: u64 = 2;
    for i in 0..n {
        let key = get_u64(in w, at);
        let kind = get_u64(in w, inc(at));
        let np = get_u64(in w, add(at, 2));
        let ns = get_u64(in w, add(at, 3));
        let nc = get_u64(in w, add(at, 4));
        at = add(at, 5);
        let node = TNode {
            key: key,
            kind: kind,
            pstart: t.props.len(),
            pcount: np,
            sstart: t.subs.len(),
            scount: ns,
            cstart: t.kids.len(),
            ccount: nc
        };
        for j in 0..np {
            t
                .props
                .push(
                    TProp {
                        property: get_u64(in w, at),
                        tag: get_u64(in w, inc(at)),
                        payload: get_u64(in w, add(at, 2)),
                        tstart: get_u64(in w, add(at, 3)),
                        tlen: get_u64(in w, add(at, 4))
                    }
                );
            at = add(at, 5);
        }
        for j in 0..ns {
            t
                .subs
                .push(
                    TSub {
                        event: get_u64(in w, at),
                        handler: get_u64(in w, inc(at))
                    }
                );
            at = add(at, 2);
        }
        for j in 0..nc {
            t.kids.push(get_u64(in w, at));
            at = inc(at);
        }
        t.nodes.push(node);
        t.keys.push(key);
        t.sorted.push(i);
        t.parent.push(NONE_ID);
    }
}

pub fn tree_find(in t: Tree, key: u64) -> u64 {
    find_key(in t.keys, in t.sorted, key)
}

// view::validate over a decoded tree, with the same order of checks, so the
// first error is the same one. Fills `parent` and `order`.
pub fn validate(inout t: Tree, lim: Lim, in text: Slice[u8]) -> Option[ViewFault] {
    if !lim_ok(lim) {
        return Option::Some(ViewFault::InvalidLimits);
    }
    let n = t.nodes.len();
    if n > lim.nodes {
        return Option::Some(ViewFault::Budget(Budget::Nodes));
    }
    let mut dup: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](n);
    sort_by_key(in t.keys, inout t.sorted, inout dup);
    // dup[i]: an earlier node has the same key (the sort is stable).
    dup.clear();
    for i in 0..n {
        dup.push(0);
    }
    for r in 0..n {
        if r > 0 {
            let i = seq_u64(in t.sorted, r);
            let j = seq_u64(in t.sorted, dec(r));
            if seq_u64(in t.keys, i) == seq_u64(in t.keys, j) {
                dup.try_set(i, 1);
            }
        }
    }
    let mut total: u64 = 0;
    let mut teardown: u64 = 1;
    for i in 0..n {
        let node = tnode(in t.nodes, i);
        // Every accepted tree must remain fully unmountable under the budget.
        let more = add(add(add(1, node.pcount), node.scount), node.ccount);
        if teardown > wrapping_sub(MAX_U64, more) {
            return Option::Some(ViewFault::Budget(Budget::Teardown));
        }
        teardown = add(teardown, more);
        if teardown > lim.patches {
            return Option::Some(ViewFault::Budget(Budget::Teardown));
        }
        if seq_u64(in dup, i) == 1 {
            return Option::Some(ViewFault::DuplicateKey(node.key));
        }
        if node.ccount > lim.children {
            return Option::Some(ViewFault::Budget(Budget::Children));
        }
        if node.pcount > lim.properties {
            return Option::Some(ViewFault::Budget(Budget::Properties));
        }
        if node.scount > lim.subscriptions {
            return Option::Some(ViewFault::Budget(Budget::Subscriptions));
        }
        if node.kind != WidgetKind::Container && node.ccount != 0 {
            return Option::Some(ViewFault::ChildrenOnLeaf(node.key));
        }
        for j in 0..node.pcount {
            let p = tprop(in t.props, add(node.pstart, j));
            if !property_valid(node.kind, p.property, p.tag, p.payload) {
                return Option::Some(
                    ViewFault::PropertyType {
                        key: node.key,
                        property: p.property
                    }
                );
            }
            if p.tag == ValueTag::Text {
                if p.tlen > lim.text {
                    return Option::Some(ViewFault::Budget(Budget::Text));
                }
                if total > wrapping_sub(MAX_U64, p.tlen) {
                    return Option::Some(ViewFault::Budget(Budget::TotalText));
                }
                total = add(total, p.tlen);
                if total > lim.total {
                    return Option::Some(ViewFault::Budget(Budget::TotalText));
                }
            }
        }
        for j in 0..node.scount {
            let s = tsub(in t.subs, add(node.sstart, j));
            if !event_valid(node.kind, s.event) {
                return Option::Some(
                    ViewFault::UnsupportedEvent {
                        key: node.key,
                        event: s.event
                    }
                );
            }
        }
    }
    let root = tree_find(in t, t.root);
    if root == NONE_ID {
        return Option::Some(ViewFault::MissingRoot(t.root));
    }
    for i in 0..n {
        let node = tnode(in t.nodes, i);
        for j in 0..node.ccount {
            let child = seq_u64(in t.kids, add(node.cstart, j));
            let c = tree_find(in t, child);
            if c == NONE_ID {
                return Option::Some(
                    ViewFault::MissingChild {
                        parent: node.key,
                        child: child
                    }
                );
            }
            if seq_u64(in t.parent, c) != NONE_ID {
                return Option::Some(ViewFault::MultipleParents(child));
            }
            t.parent.try_set(c, i);
            t.kidx.push(c);
        }
    }
    if seq_u64(in t.parent, root) != NONE_ID {
        return Option::Some(ViewFault::RootHasParent);
    }
    let mut seen_at: ChunkSeq[bool] = ChunkSeq::with_capacity[bool](n);
    for i in 0..n {
        seen_at.push(false);
    }
    let mut stack: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut depths: ChunkSeq[u64] = ChunkSeq::new[u64]();
    stack.push(root);
    depths.push(1);
    let mut seen: u64 = 0;
    loop {
        let top = stack.len();
        if top == 0 {
            break;
        }
        let i = seq_u64(in stack, dec(top));
        let depth = seq_u64(in depths, dec(top));
        stack.truncate(dec(top));
        depths.truncate(dec(top));
        if depth > lim.depth {
            return Option::Some(ViewFault::Budget(Budget::Depth));
        }
        if seq_bool(in seen_at, i) {
            return Option::Some(ViewFault::CycleOrDisconnected);
        }
        seen_at.try_set(i, true);
        seen = inc(seen);
        t.order.push(i);
        let node = tnode(in t.nodes, i);
        let mut j = node.ccount;
        loop {
            if j == 0 {
                break;
            }
            j = dec(j);
            stack.push(seq_u64(in t.kidx, add(node.cstart, j)));
            depths.push(inc(depth));
        }
    }
    if seen != n {
        return Option::Some(ViewFault::CycleOrDisconnected);
    }
    Option::None
}
