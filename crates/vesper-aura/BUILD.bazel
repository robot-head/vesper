load("//tools/bazel:defs.bzl", "vesper_crate")
load("//tools/bazel:vesper_port.bzl", "VESPER_TARGET", "vesper_package", "vesper_port_object")

# The Vesper port is the only build (#979): build.rs links the object built
# here from the Loom package in vesper/ and checks port/binding.rs against the
# generated binding, as for vesper-beacon. The five divergent builds stay
# compiling here; scripts/test-port-harness.sh asserts which test catches
# each divergent edit.
vesper_package(
    name = "port_package",
    srcs = glob(["vesper/src/**/*.ves"]),
    manifest = "vesper/Loom.toml",
)

vesper_port_object(
    name = "aura_vesper",
    library = "aura",
    package = ":port_package",
    target = VESPER_TARGET,
)

filegroup(
    name = "aura_vesper_binding",
    srcs = [":aura_vesper"],
    output_group = "rust_binding",
)

# The divergent builds, one per ported module (the Cargo
# `vesper-port-divergent` feature applies the same edits from build.rs): each
# must build from a copy of the package with its edit applied. The Cargo run
# in scripts/test-port-harness.sh asserts which test catches each one.
vesper_port_object(
    name = "aura_vesper_divergent_view",
    edit_src = "vesper/src/view.ves",
    edits = {"if node.ccount > lim.children {": "if node.ccount > inc(lim.children) {"},
    library = "aura",
    package = ":port_package",
    target = VESPER_TARGET,
)

vesper_port_object(
    name = "aura_vesper_divergent_plan",
    edit_src = "vesper/src/plan.ves",
    edits = {"op(OpTag::MoveChild, node.id, child_id, from, index)": "op(OpTag::MoveChild, node.id, child_id, index, from)"},
    library = "aura",
    package = ":port_package",
    target = VESPER_TARGET,
)

vesper_port_object(
    name = "aura_vesper_divergent_session",
    edit_src = "vesper/src/session.ves",
    edits = {"    } else if p.base != r.revision {": "    } else if p.base == MAX_U64 {"},
    library = "aura",
    package = ":port_package",
    target = VESPER_TARGET,
)

vesper_port_object(
    name = "aura_vesper_divergent_apply",
    edit_src = "vesper/src/apply.ves",
    edits = {"if has_reject && reject == i {": "if has_reject && reject == inc(i) {"},
    library = "aura",
    package = ":port_package",
    target = VESPER_TARGET,
)

vesper_port_object(
    name = "aura_vesper_divergent_sim",
    edit_src = "vesper/src/sim.ves",
    edits = {"                if kind == WidgetKind::Button || kind == WidgetKind::Input {\n                    q.items.push(id);": "                if kind == WidgetKind::Button {\n                    q.items.push(id);"},
    library = "aura",
    package = ":port_package",
    target = VESPER_TARGET,
)

vesper_crate(
    build_script_data = [
        ":aura_vesper",
        ":aura_vesper_binding",
    ],
    build_script_env = {
        # rules_rust already makes these execpaths absolute.
        "VESPER_PORT_OBJECT": "$(execpath :aura_vesper)",
        "VESPER_PORT_GENERATED_BINDING": "$(execpath :aura_vesper_binding)",
    },
)
