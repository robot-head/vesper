// Module decode of @vesper/loom-calculus (see lib.ves): the input word
// stream (documented in src/port.rs) into the tables of `L`.
use self::{
    Change,
    Cmp,
    Dep,
    Diag,
    Feat,
    GNode,
    L,
    Man,
    Req,
    Root,
    SEdge,
    Snap,
    Sys,
    SysSel,
    Ver
};
use self::util::{
    Order,
    SortKind,
    add,
    gb,
    inc,
    mul,
    occ_ord,
    pool_ord,
    sort,
    sw
};

pub fn new_l(in words: Slice[u64], in text: Slice[u8]) -> L {
    let mut l = L {
        inw: ChunkSeq::new[u64](),
        skat: ChunkSeq::new[u64](),
        sk: ChunkSeq::new[u64](),
        pos: 0,
        pool: ChunkSeq::new[u8](),
        out: ChunkSeq::new[u64](),
        k: 0,
        rank: ChunkSeq::new[u64](),
        roff: ChunkSeq::new[u64](),
        rlen: ChunkSeq::new[u64](),
        rocc: ChunkSeq::new[u64](),
        vers: ChunkSeq::new[Ver](),
        cmps: ChunkSeq::new[Cmp](),
        reqs: ChunkSeq::new[Req](),
        ids: ChunkSeq::new[u64](),
        mans: ChunkSeq::new[Man](),
        feats: ChunkSeq::new[Feat](),
        syss: ChunkSeq::new[Sys](),
        deps: ChunkSeq::new[Dep](),
        roots: ChunkSeq::new[Root](),
        ssels: ChunkSeq::new[SysSel](),
        schema: 0,
        sel_at: 0,
        sel_n: 0,
        root_at: 0,
        root_n: 0,
        ss_at: 0,
        ss_n: 0,
        diags: ChunkSeq::new[Diag](),
        dtmp: ChunkSeq::new[Diag](),
        udiags: ChunkSeq::new[Diag](),
        snaps: ChunkSeq::new[Snap](),
        gn: ChunkSeq::new[GNode](),
        gids: ChunkSeq::new[u64](),
        ge: ChunkSeq::new[u64](),
        gs: ChunkSeq::new[SEdge](),
        gl: ChunkSeq::new[u64](),
        changes: ChunkSeq::new[Change](),
        cids: ChunkSeq::new[u64](),
        np: 0,
        nc: 0,
        nf: 0,
        cmap: ChunkSeq::new[u64](),
        clist: ChunkSeq::new[u64](),
        fmap: ChunkSeq::new[u64](),
        flist: ChunkSeq::new[u64](),
        pof: ChunkSeq::new[u64](),
        sysof: ChunkSeq::new[u64](),
        pname: ChunkSeq::new[u64](),
        psel: ChunkSeq::new[u64](),
        frow: ChunkSeq::new[bool](),
        nrow: ChunkSeq::new[bool](),
        rrow: ChunkSeq::new[bool](),
        reach: ChunkSeq::new[bool](),
        hasn: ChunkSeq::new[bool](),
        queued: ChunkSeq::new[bool](),
        nfirst: ChunkSeq::new[u64](),
        mk: ChunkSeq::new[bool](),
        rootf: ChunkSeq::new[bool](),
        usedsys: ChunkSeq::new[bool](),
        queue: ChunkSeq::new[u64](),
        work: ChunkSeq::new[u64](),
        idx: ChunkSeq::new[u64](),
        tmp: ChunkSeq::new[u64](),
        se: ChunkSeq::new[SEdge](),
        pcount: ChunkSeq::new[u64](),
        pstart: ChunkSeq::new[u64](),
        plist: ChunkSeq::new[u64](),
        sa: ChunkSeq::new[u64](),
        sb: ChunkSeq::new[u64](),
        ea: ChunkSeq::new[u64](),
        eb: ChunkSeq::new[u64]()
    };
    l.inw.extend(in words);
    l.pool.extend(in text);
    l
}

pub fn rd(inout l: L) -> u64 {
    let w = sw(in l.inw, l.pos);
    l.pos = inc(l.pos);
    w
}

pub fn rd_bool(inout l: L) -> bool {
    rd(inout l) != 0
}

// A string occurrence, as its id.
pub fn rd_str(inout l: L) -> u64 {
    let occ = rd(inout l);
    sw(in l.rank, occ)
}

// A set: a count, then string occurrences in ascending order. Returns its
// start in `ids`.
pub fn rd_set(inout l: L) -> (u64, u64) {
    let n = rd(inout l);
    let at = l.ids.len();
    for i in 0..n {
        let id = rd_str(inout l);
        l.ids.push(id);
    }
    (at, n)
}

// Reads the given order into idx: true when it is a permutation of the
// occurrences in ascending byte order. Then tmp[j] holds the order of
// occurrence idx[j - 1] to idx[j], and rank marks the occurrences seen.
fn given_order(inout l: L, nocc: u64) -> bool {
    let at = add(1, add(nocc, nocc));
    for j in 0..nocc {
        let occ = sw(in l.inw, add(at, j));
        if occ >= nocc || sw(in l.rank, occ) != 0 {
            return false;
        }
        l.rank.try_set(occ, 1);
        l.idx.push(occ);
        let o = if j == 0 {
            Order::Equal
        } else {
            pool_ord(in l, sw(in l.idx, wrapping_sub(j, 1)), occ)
        };
        if o == Order::Greater {
            return false;
        }
        l.tmp.push(o);
    }
    true
}

// Sorts the occurrences into idx by their bytes, over big-endian words.
fn sort_occurrences(inout l: L, nocc: u64) {
    l.idx.clear();
    l.tmp.clear();
    l.skat.clear();
    l.sk.clear();
    l.skat.reserve(nocc);
    l.sk.reserve(add(nocc, l.pool.len() >> 3));
    for i in 0..nocc {
        l.idx.push(i);
        l.rank.try_set(i, 0);
        let base = add(1, add(i, i));
        let off = sw(in l.inw, base);
        let len = sw(in l.inw, inc(base));
        l.skat.push(l.sk.len());
        let mut p: u64 = 0;
        loop {
            if p >= len {
                break;
            }
            let mut w: u64 = 0;
            if add(p, 8) <= len {
                w = match l.pool.try_read_u64_be(add(off, p)) {
                    Option::Some(v) => v,
                    Option::None => 0,
                };
            } else {
                // The last, partial word: zero padded on the right.
                for b in 0..8 {
                    let q = add(p, b);
                    let x: u64 = if q < len {
                        widen_u64(gb(in l, add(off, q)))
                    } else {
                        0
                    };
                    w = (w << 8) | x;
                }
            }
            l.sk.push(w);
            p = add(p, 8);
        }
    }
    sort(inout l, SortKind::Strings);
}

// The string table, the versions and the requirements:
//   nocc, (off, len)*; nver, (major, minor, patch, pre, build, text)*;
//   nreq, (text, ncmp, (op, major, minor, has_minor, patch, has_patch,
//   pre)*)*.
// Sorting the occurrences by their bytes gives each distinct string its
// rank, which is its id. When the top bit of nocc is set, nocc words of
// occurrence indices in byte order follow the pairs (the wrappers sort the
// strings they intern); the port checks that they form a permutation in
// order and sorts the occurrences itself when they do not.
pub fn decode_tables(inout l: L) {
    let head = rd(inout l);
    let given = (head >> 63) != 0;
    let nocc = head & 0x7fff_ffff_ffff_ffff;
    l.idx.clear();
    l.idx.reserve(nocc);
    l.rank.reserve(nocc);
    l.rocc.reserve(nocc);
    l.roff.reserve(nocc);
    l.rlen.reserve(nocc);
    l.tmp.clear();
    for i in 0..nocc {
        l.rank.push(0);
    }
    let sorted = given && given_order(inout l, nocc);
    if !sorted {
        sort_occurrences(inout l, nocc);
    }
    let mut k: u64 = 0;
    for j in 0..nocc {
        let occ = sw(in l.idx, j);
        let base = add(1, add(occ, occ));
        let off = sw(in l.inw, base);
        let len = sw(in l.inw, inc(base));
        let same = if j == 0 {
            false
        } else if sorted {
            sw(in l.tmp, j) == Order::Equal
        } else {
            let prev = sw(in l.rocc, wrapping_sub(k, 1));
            occ_ord(in l, prev, occ) == Order::Equal
        };
        if !same {
            l.rocc.push(occ);
            l.roff.push(off);
            l.rlen.push(len);
            k = inc(k);
        }
        l.rank.try_set(occ, wrapping_sub(k, 1));
    }
    l.k = k;
    l
        .pos = add(
        1,
        mul(
            nocc,
            if given {
                3
            } else {
                2
            }
        )
    );
    let nver = rd(inout l);
    l.vers.reserve(nver);
    for i in 0..nver {
        let major = rd(inout l);
        let minor = rd(inout l);
        let patch = rd(inout l);
        let pre = rd_str(inout l);
        let build = rd_str(inout l);
        let text = rd_str(inout l);
        l
            .vers
            .push(
            Ver {
                major: major,
                minor: minor,
                patch: patch,
                pre: pre,
                build: build,
                text: text
            }
        );
    }
    let nreq = rd(inout l);
    l.reqs.reserve(nreq);
    for i in 0..nreq {
        let text = rd_str(inout l);
        let n = rd(inout l);
        let at = l.cmps.len();
        for j in 0..n {
            let op = rd(inout l);
            let major = rd(inout l);
            let minor = rd(inout l);
            let has_minor = rd_bool(inout l);
            let patch = rd(inout l);
            let has_patch = rd_bool(inout l);
            let pre = rd_str(inout l);
            l
                .cmps
                .push(
                Cmp {
                    op: op,
                    major: major,
                    minor: minor,
                    has_minor: has_minor,
                    patch: patch,
                    has_patch: has_patch,
                    pre: pre
                }
            );
        }
        l
            .reqs
            .push(
            Req {
                at: at,
                n: n,
                text: text
            }
        );
    }
}

// One manifest:
//   name, version, ceiling set, forbid_unsafe_ffi,
//   nfeat, (name, effects set, deps set, features set,
//     nsys, (raw, ok, name, req)*)*,
//   ndep, (name, req, effects set, optional, features set)*,
//   has_sandbox, [allow_network, paths set (script first, then
//     wasi_read_paths)].
// Returns its index in `mans`. Feature and dependency names come in
// ascending order.
pub fn decode_manifest(inout l: L) -> u64 {
    let name = rd_str(inout l);
    let v = rd(inout l);
    let (ceil_at, ceil_n) = rd_set(inout l);
    let forbid = rd_bool(inout l);
    let nfeat = rd(inout l);
    let feat_at = l.feats.len();
    for i in 0..nfeat {
        let fname = rd_str(inout l);
        let (eff_at, eff_n) = rd_set(inout l);
        let (deps_at, deps_n) = rd_set(inout l);
        let (sub_at, sub_n) = rd_set(inout l);
        let nsys = rd(inout l);
        let sys_at = l.syss.len();
        for j in 0..nsys {
            let raw = rd_str(inout l);
            let ok = rd_bool(inout l);
            let sname = rd_str(inout l);
            let r = rd(inout l);
            l
                .syss
                .push(
                Sys {
                    raw: raw,
                    ok: ok,
                    name: sname,
                    req: r
                }
            );
        }
        l
            .feats
            .push(
            Feat {
                name: fname,
                eff_at: eff_at,
                eff_n: eff_n,
                deps_at: deps_at,
                deps_n: deps_n,
                sub_at: sub_at,
                sub_n: sub_n,
                sys_at: sys_at,
                sys_n: nsys
            }
        );
    }
    let ndep = rd(inout l);
    let dep_at = l.deps.len();
    for i in 0..ndep {
        let dname = rd_str(inout l);
        let r = rd(inout l);
        let (eff_at, eff_n) = rd_set(inout l);
        let opt = rd_bool(inout l);
        let (fa, fan) = rd_set(inout l);
        l
            .deps
            .push(
            Dep {
                name: dname,
                req: r,
                eff_at: eff_at,
                eff_n: eff_n,
                opt: opt,
                feat_at: fa,
                feat_n: fan
            }
        );
    }
    let sandbox = rd_bool(inout l);
    let mut net = false;
    let mut path_at = l.ids.len();
    let mut path_n: u64 = 0;
    if sandbox {
        net = rd_bool(inout l);
        let (pa, pn) = rd_set(inout l);
        path_at = pa;
        path_n = pn;
    }
    let at = l.mans.len();
    l
        .mans
        .push(
        Man {
            name: name,
            ver: v,
            ceil_at: ceil_at,
            ceil_n: ceil_n,
            forbid: forbid,
            feat_at: feat_at,
            feat_n: nfeat,
            dep_at: dep_at,
            dep_n: ndep,
            sandbox: sandbox,
            net: net,
            path_at: path_at,
            path_n: path_n,
            json: 0,
            fs_at: 0,
            fs_n: 0
        }
    );
    at
}

// One solution:
//   schema_version, nroots, (name, req, features set)*,
//   nsel, (json, features set, manifest)*, nsys, (name, version)*.
pub fn decode_solution(inout l: L) {
    l.schema = rd(inout l);
    let nroots = rd(inout l);
    l.root_at = l.roots.len();
    l.root_n = nroots;
    for i in 0..nroots {
        let name = rd_str(inout l);
        let r = rd(inout l);
        let (fa, fan) = rd_set(inout l);
        l
            .roots
            .push(
            Root {
                name: name,
                req: r,
                feat_at: fa,
                feat_n: fan
            }
        );
    }
    let nsel = rd(inout l);
    l.sel_at = l.mans.len();
    l.sel_n = nsel;
    for i in 0..nsel {
        let json = rd_str(inout l);
        let (fa, fan) = rd_set(inout l);
        let m = decode_manifest(inout l);
        match l.mans.try_get(m) {
            Option::Some(x) => {
                let mut y = x;
                y.json = json;
                y.fs_at = fa;
                y.fs_n = fan;
                l.mans.try_set(m, y);
            },
            Option::None => (),
        }
    }
    let nsys = rd(inout l);
    l.ss_at = l.ssels.len();
    l.ss_n = nsys;
    for i in 0..nsys {
        let name = rd_str(inout l);
        let v = rd(inout l);
        l
            .ssels
            .push(
            SysSel {
                name: name,
                ver: v
            }
        );
    }
}
