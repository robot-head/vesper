load("@crates//vesper-cranelift-component:data.bzl", "all_crate_deps")
load("@rules_rs//rs:rust_shared_library.bzl", "rust_shared_library")
load("//tools/bazel:defs.bzl", "vesper_crate")

# The root crate's Wasm tests embed the WIT (tests/common/wasm_words.rs).
exports_files(
    ["wit/vcl.wit"],
    visibility = ["//visibility:public"],
)

# vesper-cranelift-sys as a wasm component (#2210). build.rs generates the
# WIT and the glue from cranelift.vsys, and tests/generated.rs checks the
# checked-in copies. crates/vesper-cranelift-sys's fixture tests run
# :component (below).
vesper_crate(
    build_script_data = ["//packages/vesper-cranelift:cranelift.vsys"],
    build_script_env = {
        # rules_rust already makes this execpath absolute.
        "VESPER_CRANELIFT_VSYS": "$(execpath //packages/vesper-cranelift:cranelift.vsys)",
    },
    # The checked-in tables live in packages/vesper-wasm-backend and
    # packages/vesper-stage2 (both in //:files).
    extra_test_data = ["//:files"],
)

# The component: the cdylib built for wasm32-wasip2, written as
# vesper_cranelift_component.wasm (named after the crate). The wasip2 link
# writes a component, as Cargo's does. The Stage 2 composition (`wac plug`)
# and crates/vesper-cranelift-sys's fixture tests take this file.
rust_shared_library(
    name = "component",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "vesper_cranelift_component",
    crate_root = "src/lib.rs",
    edition = "2024",
    platform = "@rules_rs//rs/platforms:wasm32-wasip2",
    rustc_env = {
        "CARGO_PKG_NAME": "vesper-cranelift-component",
        "CARGO_PKG_VERSION": "0.1.0",
    },
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True) + [":vesper-cranelift-component_build_script"],
)
