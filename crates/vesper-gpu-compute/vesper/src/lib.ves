// @vesper/gpu-compute: the Vulkan compute runtime of crates/vesper-gpu-compute
// (design §28, §36) in Vesper, calling the Vulkan loader and libc directly
// through `.vsys` (SH6 lane 15, #1410). One device and queue, host-visible
// storage buffers, compute pipelines from SPIR-V, recorded dispatches with
// descriptor sets and immediates, and submissions ordered by one timeline
// semaphore.
//
// C memory. Every create-info struct, out array and mapped buffer is C
// memory the package allocates (`calloc`), fills from a Vesper image
// (`memcpy`) and reads back (`bcopy`): see `Scratch`. Vulkan handles and
// addresses are u64 words. They never leave the package except as fields
// of the copy structs below, which the crate's Rust API owns and finalizes
// through `close`, `buffer_free`, `kernel_free` and `rec_free`.
//
// Struct offsets are the Vulkan headers' LP64 layout (x86_64 and AArch64
// Linux, macOS), checked against `offsetof` with the 1.3.275 headers.

// Why a call failed. `kind` is one of `Kind::Unavailable` .. `Kind::Unsupported`;
// `detail` says which call or check (the crate's error table names them);
// `code` is the VkResult or, for an old instance, its version.
pub copy struct GpuErr {
    pub kind: u32,
    pub detail: u32,
    pub code: i64,
}

// Why a call failed (`GpuErr.kind`).
enum Kind: _ {
    Unavailable = 1,
    Vulkan = 2,
    Shape = 3,
    Limit = 4,
    Unsupported = 5,
}

pub fn unavailable() -> u32 {
    Kind::Unavailable
}

pub fn vulkan() -> u32 {
    Kind::Vulkan
}

pub fn shape() -> u32 {
    Kind::Shape
}

pub fn limit() -> u32 {
    Kind::Limit
}

pub fn unsupported() -> u32 {
    Kind::Unsupported
}

fn raise[T](kind: u32, detail: u32, code: i64) -> T eff [Fail[GpuErr]] {
    Fail::raise(
        GpuErr {
            kind: kind,
            detail: detail,
            code: code,
        }
    )
}

fn fail(kind: u32, detail: u32, code: i64) eff [Fail[GpuErr]] {
    Fail::raise(
        GpuErr {
            kind: kind,
            detail: detail,
            code: code,
        }
    )
}

// A VkResult below zero is an error of call `call`.
fn check(rc: i32, call: u32) eff [Fail[GpuErr]] {
    if rc < 0 {
        fail(Kind::Vulkan, call, widen_i64(rc));
    }
}

// The open device. Field order is the crate's `repr` of it.
pub copy struct Dev {
    pub instance: u64,
    pub physical: u64,
    pub device: u64,
    pub queue: u64,
    pub family: u64,
    pub timeline: u64,
    pub api_version: u64,
    pub device_type: u64,
    pub max_invocations: u64,
    pub max_range: u64,
}

// A host-visible, host-coherent storage buffer, mapped at `ptr` for its
// lifetime; `len` is a multiple of 4.
pub copy struct Buf {
    pub buffer: u64,
    pub memory: u64,
    pub ptr: u64,
    pub len: u64,
}

// A compute pipeline binding `bindings` storage buffers and an immediate
// block of `imm` bytes.
pub copy struct Kern {
    pub set_layout: u64,
    pub layout: u64,
    pub pipeline: u64,
    pub bindings: u64,
    pub imm: u64,
}

// A command buffer being recorded, with the descriptor pools its sets come
// from (`sets_left` in the last one).
pub struct Rec {
    pub pool: u64,
    pub cmd: u64,
    pub sets_left: u64,
    pub pools: ChunkSeq[u64],
}

// Limits of the crate's API (runtime.rs), and of one descriptor pool.
enum Max: _ {
    BufferBytes = 1073741824,
    Bindings = 8,
    ImmediateBytes = 128,
    SetsPerPool = 256,
    Groups = 65535,
}

pub fn max_buffer_bytes() -> u64 {
    Max::BufferBytes
}

pub fn max_bindings() -> u64 {
    Max::Bindings
}

pub fn max_immediate_bytes() -> u64 {
    Max::ImmediateBytes
}

// VK_API_VERSION_1_2.
enum Api: _ {
    Version1_2 = 4202496,
}

// VK_WHOLE_SIZE, and the no-timeout value of `vkWaitSemaphores`.
const WHOLE_SIZE: u64 = 18446744073709551615;

// The low word of a u64.
const LOW_WORD: u64 = 4294967295;

// VK_MAX_PHYSICAL_DEVICE_NAME_SIZE and VK_MAX_DRIVER_NAME_SIZE.
const MAX_NAME_SIZE: u64 = 256;

// 1.0f, the queue priority.
const ONE_F32_BITS: u32 = 1065353216;

// VkStructureType values.
enum St: _ {
    ApplicationInfo = 0,
    InstanceCreateInfo = 1,
    DeviceQueueCreateInfo = 2,
    DeviceCreateInfo = 3,
    SubmitInfo = 4,
    MemoryAllocateInfo = 5,
    SemaphoreCreateInfo = 9,
    BufferCreateInfo = 12,
    ShaderModuleCreateInfo = 16,
    PipelineShaderStageCreateInfo = 18,
    ComputePipelineCreateInfo = 29,
    PipelineLayoutCreateInfo = 30,
    DescriptorSetLayoutCreateInfo = 32,
    DescriptorPoolCreateInfo = 33,
    DescriptorSetAllocateInfo = 34,
    WriteDescriptorSet = 35,
    CommandPoolCreateInfo = 39,
    CommandBufferAllocateInfo = 40,
    CommandBufferBeginInfo = 42,
    MemoryBarrier = 46,
    Vulkan12Features = 51,
    Features2 = 1000059000,
    Properties2 = 1000059001,
    DriverProperties = 1000196000,
    TimelineFeatures = 1000207000,
    SemaphoreTypeCreateInfo = 1000207002,
    TimelineSubmitInfo = 1000207003,
    SemaphoreWaitInfo = 1000207004,
}

// Flag and enum values.
enum Queue: _ {
    Compute = 2,
}

enum ShaderStage: _ {
    Compute = 32,
}

enum DescriptorType: _ {
    StorageBuffer = 7,
}

enum BindPoint: _ {
    Compute = 1,
}

enum PipelineStage: _ {
    Compute = 2048,
    Host = 16384,
}

enum Access: _ {
    ShaderRead = 32,
    ShaderWrite = 64,
    HostRead = 8192,
}

// HOST_VISIBLE | HOST_COHERENT.
enum MemoryProperty: _ {
    HostVisibleCoherent = 6,
}

// STORAGE_BUFFER | TRANSFER_SRC | TRANSFER_DST.
enum BufferUsage: _ {
    StorageTransfer = 35,
}

enum SemaphoreKind: _ {
    Timeline = 1,
}

enum CommandPoolFlag: _ {
    Transient = 1,
}

enum CommandBufferUsage: _ {
    OneTimeSubmit = 1,
}

// Which call failed (`GpuErr.detail` with `Kind::Vulkan`).
enum Call: _ {
    EnumerateInstanceVersion = 1,
    EnumeratePhysicalDevices = 2,
    CreateDevice = 3,
    CreateSemaphore = 4,
    GetSemaphoreCounterValue = 5,
    WaitSemaphores = 6,
    CreateBuffer = 7,
    AllocateMemory = 8,
    BindBufferMemory = 9,
    MapMemory = 10,
    CreateDescriptorSetLayout = 11,
    CreatePipelineLayout = 12,
    CreateShaderModule = 13,
    CreateComputePipelines = 14,
    CreateCommandPool = 15,
    AllocateCommandBuffers = 16,
    BeginCommandBuffer = 17,
    CreateDescriptorPool = 18,
    AllocateDescriptorSets = 19,
    EndCommandBuffer = 20,
    QueueSubmit = 21,
    DeviceWaitIdle = 22,
}

// `Kind::Unavailable` details.
enum Unavailable: _ {
    OldInstance = 2,
    CreateInstance = 3,
    NoDevice = 4,
}

// `Kind::Shape` details.
enum BadShape: _ {
    ZeroBuffer = 1,
    BufferRange = 2,
    DispatchBuffers = 3,
    DispatchImmediates = 4,
    ZeroGroups = 5,
    EntryNul = 7,
}

// `Kind::Limit` details.
enum OverLimit: _ {
    BufferSize = 1,
    Bindings = 2,
    Immediates = 3,
    Groups = 4,
}

// `Kind::Unsupported` details.
enum Unsupported: _ {
    MemoryType = 1,
}

// Struct layouts. Each enum gives a Vulkan struct's field offsets and its
// size (`Bytes`); every struct starts with `Header`.
enum Header: _ {
    SType = 0,
    PNext = 8,
}

// A dispatchable or non-dispatchable handle, or a u64 value.
enum Handle: _ {
    Bytes = 8,
}

enum ApplicationInfo: _ {
    ApplicationName = 16,
    EngineName = 32,
    ApiVersion = 44,
    Bytes = 48,
}

enum InstanceCreateInfo: _ {
    ApplicationInfo = 24,
    Bytes = 64,
}

// VkPhysicalDeviceProperties2 (its `properties` at 16).
enum Properties2: _ {
    ApiVersion = 16,
    DeviceType = 32,
    DeviceName = 36,
    MaxStorageBufferRange = 340,
    MaxComputeWorkGroupInvocations = 544,
    Bytes = 840,
}

enum DriverProperties: _ {
    DriverName = 20,
    DriverInfo = 276,
    Bytes = 536,
}

enum Features2: _ {
    Bytes = 240,
}

enum TimelineFeatures: _ {
    TimelineSemaphore = 16,
    Bytes = 24,
}

enum QueueFamilyProperties: _ {
    QueueFlags = 0,
    Bytes = 24,
}

enum DeviceQueueCreateInfo: _ {
    QueueFamilyIndex = 20,
    QueueCount = 24,
    QueuePriorities = 32,
    Bytes = 40,
}

enum Vulkan12Features: _ {
    TimelineSemaphore = 164,
    Bytes = 208,
}

enum DeviceCreateInfo: _ {
    QueueCreateInfoCount = 20,
    QueueCreateInfos = 24,
    Bytes = 72,
}

enum SemaphoreTypeCreateInfo: _ {
    SemaphoreType = 16,
    Bytes = 32,
}

enum SemaphoreCreateInfo: _ {
    Bytes = 24,
}

enum SemaphoreWaitInfo: _ {
    SemaphoreCount = 20,
    Semaphores = 24,
    Values = 32,
    Bytes = 40,
}

enum BufferCreateInfo: _ {
    Size = 24,
    Usage = 32,
    Bytes = 56,
}

enum MemoryRequirements: _ {
    Size = 0,
    MemoryTypeBits = 16,
    Bytes = 24,
}

enum MemoryProperties: _ {
    MemoryTypeCount = 0,
    MemoryTypes = 4,
    Bytes = 520,
}

enum MemoryType: _ {
    PropertyFlags = 0,
    Bytes = 8,
}

enum MemoryAllocateInfo: _ {
    AllocationSize = 16,
    MemoryTypeIndex = 24,
    Bytes = 32,
}

enum SetLayoutBinding: _ {
    Binding = 0,
    DescriptorType = 4,
    DescriptorCount = 8,
    StageFlags = 12,
    Bytes = 24,
}

enum SetLayoutCreateInfo: _ {
    BindingCount = 20,
    Bindings = 24,
    Bytes = 32,
}

enum PushConstantRange: _ {
    StageFlags = 0,
    Size = 8,
    Bytes = 12,
}

enum PipelineLayoutCreateInfo: _ {
    SetLayoutCount = 20,
    SetLayouts = 24,
    PushConstantRangeCount = 32,
    PushConstantRanges = 40,
    Bytes = 48,
}

enum ShaderModuleCreateInfo: _ {
    CodeSize = 24,
    Code = 32,
    Bytes = 40,
}

enum ShaderStageCreateInfo: _ {
    Stage = 20,
    Module = 24,
    Name = 32,
    Bytes = 48,
