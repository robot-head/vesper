// Raises `Unavailable::MissingEntryPoint` with the index (in the crate's
// ENTRY_POINTS table) of the first entry point the loader lacks.
fn check_entry_points(library: u64) eff [Ffi[Vk], Fail[GpuErr]] {
    if lookup_or_zero(library, in "vkEnumerateInstanceVersion") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 0);
    }
    if lookup_or_zero(library, in "vkCreateInstance") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 1);
    }
    if lookup_or_zero(library, in "vkDestroyInstance") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 2);
    }
    if lookup_or_zero(library, in "vkEnumeratePhysicalDevices") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 3);
    }
    if lookup_or_zero(library, in "vkGetPhysicalDeviceProperties2") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 4);
    }
    if lookup_or_zero(library, in "vkGetPhysicalDeviceFeatures2") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 5);
    }
    if lookup_or_zero(library, in "vkGetPhysicalDeviceQueueFamilyProperties") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 6);
    }
    if lookup_or_zero(library, in "vkGetPhysicalDeviceMemoryProperties") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 7);
    }
    if lookup_or_zero(library, in "vkCreateDevice") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 8);
    }
    if lookup_or_zero(library, in "vkDestroyDevice") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 9);
    }
    if lookup_or_zero(library, in "vkDeviceWaitIdle") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 10);
    }
    if lookup_or_zero(library, in "vkGetDeviceQueue") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 11);
    }
    if lookup_or_zero(library, in "vkCreateSemaphore") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 12);
    }
    if lookup_or_zero(library, in "vkDestroySemaphore") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 13);
    }
    if lookup_or_zero(library, in "vkGetSemaphoreCounterValue") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 14);
    }
    if lookup_or_zero(library, in "vkWaitSemaphores") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 15);
    }
    if lookup_or_zero(library, in "vkCreateBuffer") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 16);
    }
    if lookup_or_zero(library, in "vkDestroyBuffer") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 17);
    }
    if lookup_or_zero(library, in "vkGetBufferMemoryRequirements") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 18);
    }
    if lookup_or_zero(library, in "vkAllocateMemory") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 19);
    }
    if lookup_or_zero(library, in "vkFreeMemory") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 20);
    }
    if lookup_or_zero(library, in "vkBindBufferMemory") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 21);
    }
    if lookup_or_zero(library, in "vkMapMemory") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 22);
    }
    if lookup_or_zero(library, in "vkUnmapMemory") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 23);
    }
    if lookup_or_zero(library, in "vkCreateDescriptorSetLayout") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 24);
    }
    if lookup_or_zero(library, in "vkDestroyDescriptorSetLayout") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 25);
    }
    if lookup_or_zero(library, in "vkCreatePipelineLayout") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 26);
    }
    if lookup_or_zero(library, in "vkDestroyPipelineLayout") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 27);
    }
    if lookup_or_zero(library, in "vkCreateShaderModule") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 28);
    }
    if lookup_or_zero(library, in "vkDestroyShaderModule") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 29);
    }
    if lookup_or_zero(library, in "vkCreateComputePipelines") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 30);
    }
    if lookup_or_zero(library, in "vkDestroyPipeline") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 31);
    }
    if lookup_or_zero(library, in "vkCreateCommandPool") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 32);
    }
    if lookup_or_zero(library, in "vkDestroyCommandPool") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 33);
    }
    if lookup_or_zero(library, in "vkAllocateCommandBuffers") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 34);
    }
    if lookup_or_zero(library, in "vkBeginCommandBuffer") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 35);
    }
    if lookup_or_zero(library, in "vkEndCommandBuffer") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 36);
    }
    if lookup_or_zero(library, in "vkCreateDescriptorPool") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 37);
    }
    if lookup_or_zero(library, in "vkDestroyDescriptorPool") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 38);
    }
    if lookup_or_zero(library, in "vkAllocateDescriptorSets") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 39);
    }
    if lookup_or_zero(library, in "vkUpdateDescriptorSets") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 40);
    }
    if lookup_or_zero(library, in "vkCmdBindPipeline") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 41);
    }
    if lookup_or_zero(library, in "vkCmdBindDescriptorSets") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 42);
    }
    if lookup_or_zero(library, in "vkCmdPushConstants") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 43);
    }
    if lookup_or_zero(library, in "vkCmdDispatch") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 44);
    }
    if lookup_or_zero(library, in "vkCmdPipelineBarrier") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 45);
    }
    if lookup_or_zero(library, in "vkQueueSubmit") == 0 {
        fail(Kind::Unavailable, Unavailable::MissingEntryPoint, 46);
    }
}

fn lookup_or_zero(library: u64, in name: Str) -> u64 eff [Ffi[Vk]] {
    match Vk::lookup(library, in name.as_bytes()) {
        Result::Ok(p) => p,
        Result::Err(_) => 0,
    }
}

// A host-visible, host-coherent storage buffer, mapped at `ptr` for its
// lifetime; `len` is a multiple of 4.
pub copy struct Buf {
    pub buffer: u64,
    pub memory: u64,
    pub ptr: u64,
    pub len: u64,
}

// A compute pipeline binding `bindings` storage buffers and an immediate
// block of `imm` bytes.
pub copy struct Kern {
    pub set_layout: u64,
    pub layout: u64,
    pub pipeline: u64,
    pub bindings: u64,
    pub imm: u64,
}

// A command buffer being recorded, with the descriptor pools its sets come
// from (`sets_left` in the last one).
pub struct Rec {
    pub pool: u64,
    pub cmd: u64,
    pub sets_left: u64,
    pub pools: ChunkSeq[u64],
}

// Limits of the crate's API (runtime.rs), and of one descriptor pool.
enum Max: _ {
    BufferBytes = 1073741824,
    Bindings = 8,
    ImmediateBytes = 128,
    SetsPerPool = 256,
    Groups = 65535,
}

pub fn max_buffer_bytes() -> u64 {
    Max::BufferBytes
}

pub fn max_bindings() -> u64 {
    Max::Bindings
}

pub fn max_immediate_bytes() -> u64 {
    Max::ImmediateBytes
}

// VK_API_VERSION_1_2.
enum Api: _ {
    Version1_2 = 4202496,
}

// VK_WHOLE_SIZE, and the no-timeout value of `vkWaitSemaphores`.
const WHOLE_SIZE: u64 = 18446744073709551615;

// The low word of a u64.
const LOW_WORD: u64 = 4294967295;

// VK_MAX_PHYSICAL_DEVICE_NAME_SIZE and VK_MAX_DRIVER_NAME_SIZE.
const MAX_NAME_SIZE: u64 = 256;

// 1.0f, the queue priority.
const ONE_F32_BITS: u32 = 1065353216;

// VkStructureType values.
enum St: _ {
    ApplicationInfo = 0,
    InstanceCreateInfo = 1,
    DeviceQueueCreateInfo = 2,
    DeviceCreateInfo = 3,
    SubmitInfo = 4,
    MemoryAllocateInfo = 5,
    SemaphoreCreateInfo = 9,
    BufferCreateInfo = 12,
    ShaderModuleCreateInfo = 16,
    PipelineShaderStageCreateInfo = 18,
    ComputePipelineCreateInfo = 29,
    PipelineLayoutCreateInfo = 30,
    DescriptorSetLayoutCreateInfo = 32,
    DescriptorPoolCreateInfo = 33,
    DescriptorSetAllocateInfo = 34,
    WriteDescriptorSet = 35,
    CommandPoolCreateInfo = 39,
    CommandBufferAllocateInfo = 40,
    CommandBufferBeginInfo = 42,
    MemoryBarrier = 46,
    Vulkan12Features = 51,
    Features2 = 1000059000,
    Properties2 = 1000059001,
    DriverProperties = 1000196000,
    TimelineFeatures = 1000207000,
    SemaphoreTypeCreateInfo = 1000207002,
    TimelineSubmitInfo = 1000207003,
    SemaphoreWaitInfo = 1000207004,
}

// Flag and enum values.
enum Queue: _ {
    Compute = 2,
}

enum ShaderStage: _ {
    Compute = 32,
}

enum DescriptorType: _ {
    StorageBuffer = 7,
}

enum BindPoint: _ {
    Compute = 1,
}

enum PipelineStage: _ {
    Compute = 2048,
    Host = 16384,
}

enum Access: _ {
    ShaderRead = 32,
    ShaderWrite = 64,
    HostRead = 8192,
}

// HOST_VISIBLE | HOST_COHERENT.
enum MemoryProperty: _ {
    HostVisibleCoherent = 6,
}

// STORAGE_BUFFER | TRANSFER_SRC | TRANSFER_DST.
enum BufferUsage: _ {
    StorageTransfer = 35,
}

enum SemaphoreKind: _ {
    Timeline = 1,
}

enum CommandPoolFlag: _ {
    Transient = 1,
}

enum CommandBufferUsage: _ {
    OneTimeSubmit = 1,
}

// Which call failed (`GpuErr.detail` with `Kind::Vulkan`).
enum Call: _ {
    EnumerateInstanceVersion = 1,
    EnumeratePhysicalDevices = 2,
    CreateDevice = 3,
    CreateSemaphore = 4,
    GetSemaphoreCounterValue = 5,
    WaitSemaphores = 6,
    CreateBuffer = 7,
    AllocateMemory = 8,
    BindBufferMemory = 9,
    MapMemory = 10,
    CreateDescriptorSetLayout = 11,
    CreatePipelineLayout = 12,
    CreateShaderModule = 13,
    CreateComputePipelines = 14,
    CreateCommandPool = 15,
    AllocateCommandBuffers = 16,
    BeginCommandBuffer = 17,
    CreateDescriptorPool = 18,
    AllocateDescriptorSets = 19,
    EndCommandBuffer = 20,
    QueueSubmit = 21,
    DeviceWaitIdle = 22,
}

// `Kind::Unavailable` details.
enum Unavailable: _ {
    NoLoader = 1,
    OldInstance = 2,
    CreateInstance = 3,
    NoDevice = 4,
    MissingEntryPoint = 5,
}

// `Kind::Shape` details.
enum BadShape: _ {
    ZeroBuffer = 1,
    BufferRange = 2,
    DispatchBuffers = 3,
    DispatchImmediates = 4,
    ZeroGroups = 5,
    EntryNul = 7,
}

// `Kind::Limit` details.
enum OverLimit: _ {
    BufferSize = 1,
    Bindings = 2,
    Immediates = 3,
    Groups = 4,
}

// `Kind::Unsupported` details.
enum Unsupported: _ {
    MemoryType = 1,
}

// Struct layouts. Each enum gives a Vulkan struct's field offsets and its
// size (`Bytes`); every struct starts with `Header`.
enum Header: _ {
    SType = 0,
    PNext = 8,
}

// A dispatchable or non-dispatchable handle, or a u64 value.
enum Handle: _ {
    Bytes = 8,
}

enum ApplicationInfo: _ {
    ApplicationName = 16,
    EngineName = 32,
    ApiVersion = 44,
    Bytes = 48,
}

enum InstanceCreateInfo: _ {
    ApplicationInfo = 24,
    Bytes = 64,
}

// VkPhysicalDeviceProperties2 (its `properties` at 16).
enum Properties2: _ {
    ApiVersion = 16,
    DeviceType = 32,
    DeviceName = 36,
    MaxStorageBufferRange = 340,
    MaxComputeWorkGroupInvocations = 544,
    Bytes = 840,
}

enum DriverProperties: _ {
    DriverName = 20,
    DriverInfo = 276,
    Bytes = 536,
}

enum Features2: _ {
    Bytes = 240,
}

enum TimelineFeatures: _ {
    TimelineSemaphore = 16,
    Bytes = 24,
}

enum QueueFamilyProperties: _ {
    QueueFlags = 0,
    Bytes = 24,
}

enum DeviceQueueCreateInfo: _ {
    QueueFamilyIndex = 20,
    QueueCount = 24,
    QueuePriorities = 32,
    Bytes = 40,
}

enum Vulkan12Features: _ {
    TimelineSemaphore = 164,
    Bytes = 208,
}

enum DeviceCreateInfo: _ {
    QueueCreateInfoCount = 20,
    QueueCreateInfos = 24,
    EnabledFeatures = 64,
    Bytes = 72,
}

// VkPhysicalDeviceFeatures: 55 VkBool32s, `robustBufferAccess` first.
enum DeviceFeatures: _ {
    RobustBufferAccess = 0,
    Bytes = 220,
}

enum SemaphoreTypeCreateInfo: _ {
    SemaphoreType = 16,
    Bytes = 32,
}

enum SemaphoreCreateInfo: _ {
    Bytes = 24,
}

enum SemaphoreWaitInfo: _ {
    SemaphoreCount = 20,
    Semaphores = 24,
    Values = 32,
    Bytes = 40,
}

enum BufferCreateInfo: _ {
    Size = 24,
    Usage = 32,
    Bytes = 56,
}

enum MemoryRequirements: _ {
    Size = 0,
    MemoryTypeBits = 16,
    Bytes = 24,
}

enum MemoryProperties: _ {
    MemoryTypeCount = 0,
    MemoryTypes = 4,
    Bytes = 520,
}

enum MemoryType: _ {
    PropertyFlags = 0,
    Bytes = 8,
}

enum MemoryAllocateInfo: _ {
    AllocationSize = 16,
    MemoryTypeIndex = 24,
    Bytes = 32,
}

enum SetLayoutBinding: _ {
    Binding = 0,
    DescriptorType = 4,
    DescriptorCount = 8,
    StageFlags = 12,
    Bytes = 24,
}

enum SetLayoutCreateInfo: _ {
    BindingCount = 20,
    Bindings = 24,
    Bytes = 32,
}

enum PushConstantRange: _ {
    StageFlags = 0,
    Size = 8,
    Bytes = 12,
}

enum PipelineLayoutCreateInfo: _ {
    SetLayoutCount = 20,
    SetLayouts = 24,
    PushConstantRangeCount = 32,
    PushConstantRanges = 40,
    Bytes = 48,
}

enum ShaderModuleCreateInfo: _ {
    CodeSize = 24,
    Code = 32,
    Bytes = 40,
}

enum ShaderStageCreateInfo: _ {
    Stage = 20,
    Module = 24,
    Name = 32,
    Bytes = 48,
}

enum ComputePipelineCreateInfo: _ {
    Stage = 24,
    Layout = 72,
    Bytes = 96,
}

enum CommandPoolCreateInfo: _ {
    Flags = 16,
    QueueFamilyIndex = 20,
    Bytes = 24,
}

enum CommandBufferAllocateInfo: _ {
    CommandPool = 16,
    CommandBufferCount = 28,
    Bytes = 32,
}

enum CommandBufferBeginInfo: _ {
    Flags = 16,
    Bytes = 32,
}

enum DescriptorPoolSize: _ {
    Type = 0,
    DescriptorCount = 4,
    Bytes = 8,
}

enum DescriptorPoolCreateInfo: _ {
    MaxSets = 20,
    PoolSizeCount = 24,
    PoolSizes = 32,
    Bytes = 40,
}

enum DescriptorSetAllocateInfo: _ {
    DescriptorPool = 16,
    DescriptorSetCount = 24,
    SetLayouts = 32,
    Bytes = 40,
}

enum DescriptorBufferInfo: _ {
    Buffer = 0,
    Range = 16,
    Bytes = 24,
}

enum WriteDescriptorSet: _ {
    DstSet = 16,
    DstBinding = 24,
    DescriptorCount = 32,
    DescriptorType = 36,
    BufferInfo = 48,
    Bytes = 64,
}

enum MemoryBarrier: _ {
    SrcAccessMask = 16,
    DstAccessMask = 20,
    Bytes = 24,
}

enum TimelineSubmitInfo: _ {
    WaitValueCount = 16,
    WaitValues = 24,
    SignalValueCount = 32,
    SignalValues = 40,
    Bytes = 48,
}

enum SubmitInfo: _ {
    WaitSemaphoreCount = 16,
    WaitSemaphores = 24,
    WaitDstStageMask = 32,
    CommandBufferCount = 40,
    CommandBuffers = 48,
    SignalSemaphoreCount = 56,
    SignalSemaphores = 64,
    Bytes = 72,
}

// Scratch block layouts: where each function puts its structs.
// `create_instance`: the two names follow VkInstanceCreateInfo, 24 bytes
// each.
enum InstanceBlock: _ {
    Instance = 48,
    AppName = 112,
    EngineName = 136,
    Bytes = 160,
}

// `properties`: VkPhysicalDeviceProperties2 at 0, then the driver
// properties.
enum PropertiesBlock: _ {
    Driver = 840,
    Bytes = 1376,
}

// `open_on`: the queue info at 0, then its priority, the Vulkan 1.2
// features, the device info and the Vulkan 1.0 features.
enum DeviceBlock: _ {
    Priority = 40,
    Features = 48,
    Device = 256,
    CoreFeatures = 328,
    Bytes = 548,
}

// `wait_value`: the semaphore, the value, then the wait info.
enum WaitBlock: _ {
    Semaphore = 0,
    Value = 8,
    Info = 16,
    Bytes = 56,
}

// `buffer_new`: the buffer info at 0.
enum BufferBlock: _ {
    Requirements = 56,
    Properties = 80,
    Allocate = 600,
    Bytes = 632,
}

// `kernel_new`: up to `Max::Bindings` set-layout bindings at 0.
enum LayoutBlock: _ {
    SetLayoutInfo = 192,
    PushRange = 224,
    SetLayout = 240,
    PipelineLayoutInfo = 248,
    Bytes = 296,
}

// `rec_new`: the command pool info at 0.
enum CommandBlock: _ {
    Allocate = 24,
    Begin = 56,
    Bytes = 88,
}

// `rec_dispatch`: up to `Max::Bindings` buffer infos at 0.
enum DispatchBlock: _ {
    Writes = 192,
    Barrier = 704,
    Set = 728,
    Immediates = 736,
    Bytes = 864,
}

// `rec_submit`.
enum SubmitBlock: _ {
    WaitValue = 0,
    SignalValue = 8,
    Timeline = 16,
    Semaphore = 64,
    Stage = 72,
    Command = 80,
    Submit = 88,
    Bytes = 160,
}

// A block of C memory and the Vesper image of its bytes. `put*` write the
// image, `flush` copies it to C, `pull` copies C back into it and `get*`
// read the image. `release` frees the C block.
struct Scratch {
    base: u64,
    image: ChunkSeq[u8],
}

fn scratch(bytes: u64) -> Scratch eff [Ffi[LibC]] {
    let mut image: ChunkSeq[u8] = ChunkSeq::with_capacity[u8](bytes);
    image.resize(bytes, 0);
    Scratch {
        base: LibC::calloc(bytes, 1),
        image: image,
    }
}

fn addr(in s: Scratch, offset: u64) -> u64 {
    wrapping_add(s.base, offset)
}

fn put32(inout s: Scratch, at: u64, v: u32) eff [Fail[RuntimeError], Fail[ArithOverflow]] {
    s.image.set(at, narrow_u8(v & 255));
    s.image.set(at + 1, narrow_u8((v >> 8) & 255));
    s.image.set(at + 2, narrow_u8((v >> 16) & 255));
    s.image.set(at + 3, narrow_u8(v >> 24));
}

fn put64(inout s: Scratch, at: u64, v: u64) eff [Fail[RuntimeError], Fail[ArithOverflow]] {
    put32(inout s, at, narrow_u32(v & LOW_WORD));
    put32(inout s, at + 4, narrow_u32(v >> 32));
}

// A sType and a zero pNext at `at`.
fn header(inout s: Scratch, at: u64, s_type: u32) eff [Fail[RuntimeError], Fail[ArithOverflow]] {
    put32(inout s, at, s_type);
}

fn put_bytes(inout s: Scratch, at: u64, in bytes: Slice[u8]) eff [
    Fail[RuntimeError],
    Fail[ArithOverflow]
] {
    for i in 0..bytes.len() {
        s.image.set(at + i, bytes[i]);
    }
}

fn get32(in s: Scratch, at: u64) -> u32 eff [Fail[RuntimeError], Fail[ArithOverflow]] {
    widen_u32(s.image[at]) | (widen_u32(s.image[at + 1]) << 8) | (
        widen_u32(s.image[at + 2]) << 16
    ) | (widen_u32(s.image[at + 3]) << 24)
}

fn get64(in s: Scratch, at: u64) -> u64 eff [Fail[RuntimeError], Fail[ArithOverflow]] {
    widen_u64(get32(in s, at)) | (widen_u64(get32(in s, at + 4)) << 32)
}

fn flush(in s: Scratch) eff [Ffi[LibC]] {
    LibC::memcpy(s.base, in s.image.as_slice());
}

fn pull(inout s: Scratch) eff [Ffi[LibC]] {
    LibC::bcopy(s.base, inout s.image.as_slice_mut());
}

fn release(in s: Scratch) eff [Ffi[LibC]] {
    LibC::free(s.base);
}

// The NUL-terminated bytes of a fixed `char[256]` field at `at`.
fn c_string(in s: Scratch, at: u64) -> ChunkSeq[u8] eff [Fail[RuntimeError], Fail[ArithOverflow]] {
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for i in 0..MAX_NAME_SIZE {
        let b = s.image[at + i];
        if b == 0 {
            break;
        }
        out.push(b);
    }
    out
}

fn contains(in hay: Slice[u8], in needle: Slice[u8])
    -> bool eff [Fail[RuntimeError], Fail[ArithOverflow]] {
    if needle.len() == 0 {
        return true;
    }
    if needle.len() > hay.len() {
        return false;
    }
    for start in 0..(hay.len() - needle.len() + 1) {
        let mut same = true;
        for j in 0..needle.len() {
            if hay[start + j] != needle[j] {
                same = false;
                break;
            }
        }
        if same {
            return true;
        }
    }
    false
}

// VkPhysicalDeviceProperties2 at 0 chained to VkPhysicalDeviceDriverProperties
// at 840, filled for `physical`.
fn properties(library: u64, physical: u64)
    -> Scratch eff [Ffi[Vk], Ffi[LibC], Fail[RuntimeError], Fail[ArithOverflow]] {
    let mut s = scratch(PropertiesBlock::Bytes);
    header(inout s, 0, St::Properties2);
    put64(inout s, Header::PNext, addr(in s, PropertiesBlock::Driver));
    header(inout s, PropertiesBlock::Driver, St::DriverProperties);
    flush(in s);
    Vk::PfnGetPhysicalDeviceProperties2(
        pfn_get_physical_device_properties2(library),
        physical,
        s.base
    );
    pull(inout s);
    s
}

fn timeline_supported(library: u64, physical: u64)
    -> bool eff [Ffi[Vk], Ffi[LibC], Fail[RuntimeError], Fail[ArithOverflow]] {
    let mut s = scratch(Features2::Bytes + TimelineFeatures::Bytes);
    header(inout s, 0, St::Features2);
    put64(inout s, Header::PNext, addr(in s, Features2::Bytes));
    header(inout s, Features2::Bytes, St::TimelineFeatures);
    flush(in s);
    Vk::PfnGetPhysicalDeviceFeatures2(pfn_get_physical_device_features2(library), physical, s.base);
    pull(inout s);
    let on = get32(in s, Features2::Bytes + TimelineFeatures::TimelineSemaphore) != 0;
    release(in s);
    on
}

// The first queue family with compute, or None.
fn compute_family(library: u64, physical: u64)
    -> Option[u64] eff [Ffi[Vk], Ffi[LibC], Fail[RuntimeError], Fail[ArithOverflow]] {
    let mut count: u32 = 0;
    Vk::PfnGetPhysicalDeviceQueueFamilyProperties(
        pfn_get_physical_device_queue_family_properties(library),
        physical,
        inout count,
        0
    );
    let n = widen_u64(count);
    if n == 0 {
        return Option::None;
    }
    let mut s = scratch(n * QueueFamilyProperties::Bytes);
    Vk::PfnGetPhysicalDeviceQueueFamilyProperties(
        pfn_get_physical_device_queue_family_properties(library),
        physical,
        inout count,
        s.base
    );
    pull(inout s);
    let mut found: Option[u64] = Option::None;
    for i in 0..widen_u64(count) {
        if get32(in s, i * QueueFamilyProperties::Bytes + QueueFamilyProperties::QueueFlags)
            & Queue::Compute
            != 0 {
            found = Option::Some(i);
            break;
        }
    }
    release(in s);
    found
}

fn create_instance(library: u64)
    -> u64 eff [Ffi[Vk], Ffi[LibC], Fail[GpuErr], Fail[RuntimeError], Fail[ArithOverflow]] {
    let mut version: u32 = 0;
    check(
        Vk::PfnEnumerateInstanceVersion(pfn_enumerate_instance_version(library), inout version),
        Call::EnumerateInstanceVersion
    );
    if version < Api::Version1_2 {
        fail(Kind::Unavailable, Unavailable::OldInstance, widen_i64(version));
    }
    // VkApplicationInfo at 0, VkInstanceCreateInfo at 48, then the names.
    let app_name = "vesper-gpu-compute";
    let engine_name = "vesper";
    let mut s = scratch(InstanceBlock::Bytes);
    header(inout s, 0, St::ApplicationInfo);
    put64(inout s, ApplicationInfo::ApplicationName, addr(in s, InstanceBlock::AppName));
    put64(inout s, ApplicationInfo::EngineName, addr(in s, InstanceBlock::EngineName));
    put32(inout s, ApplicationInfo::ApiVersion, Api::Version1_2);
    header(inout s, InstanceBlock::Instance, St::InstanceCreateInfo);
    put64(inout s, InstanceBlock::Instance + InstanceCreateInfo::ApplicationInfo, s.base);
    put_bytes(inout s, InstanceBlock::AppName, in app_name.as_bytes());
    put_bytes(inout s, InstanceBlock::EngineName, in engine_name.as_bytes());
    flush(in s);
    let mut instance: u64 = 0;
    let rc = Vk::PfnCreateInstance(
        pfn_create_instance(library),
        addr(in s, InstanceBlock::Instance),
        0,
        inout instance
    );
    release(in s);
    if rc != 0 {
        fail(Kind::Unavailable, Unavailable::CreateInstance, widen_i64(rc));
    }
    instance
}

// `dlopen(name, RTLD_NOW)`, or 0 when the library is missing.
fn try_loader(in name: Str) -> u64 eff [Ffi[Vk]] {
    match Vk::dlopen(in name.as_bytes(), 2) {
        Result::Ok(h) => h,
        _ => 0,
    }
}

// The first Vulkan loader `dlopen` finds, or 0: Linux's, then macOS's (the
// SDK's loader, then MoltenVK on its own).
fn open_loader() -> u64 eff [Ffi[Vk]] {
    let mut library = try_loader(in "libvulkan.so.1");
    if library == 0 {
        library = try_loader(in "libvulkan.so");
    }
    if library == 0 {
        library = try_loader(in "libvulkan.1.dylib");
    }
    if library == 0 {
        library = try_loader(in "libvulkan.dylib");
    }
    if library == 0 {
        library = try_loader(in "libMoltenVK.dylib");
    }
    library
}

// Loads the Vulkan loader and its entry points, creates an instance and
// opens the first physical device with a compute queue and Vulkan 1.2
// timeline semaphores whose name contains `wanted` (any device when it is
// empty).
pub fn open(in wanted: Str)
    -> Dev eff [Ffi[Vk], Ffi[LibC], Fail[GpuErr], Fail[RuntimeError], Fail[ArithOverflow]] {
    let library = open_loader();
    if library == 0 {
        fail(Kind::Unavailable, Unavailable::NoLoader, 0);
    }
    handle Fail[GpuErr] in {
        check_entry_points(library);
        open_with(library, in wanted)
    } with {
        return d => d,
        raise(e, k) => {
            Vk::dlclose(library);
            raise(e.kind, e.detail, e.code)
        },
    }
}

fn open_with(library: u64, in wanted: Str)
    -> Dev eff [Ffi[Vk], Ffi[LibC], Fail[GpuErr], Fail[RuntimeError], Fail[ArithOverflow]] {
    let instance = create_instance(library);
    handle Fail[GpuErr] in {
        open_on(library, instance, in wanted)
    } with {
        return d => d,
        raise(e, k) => {
            Vk::PfnDestroyInstance(pfn_destroy_instance(library), instance, 0);
            raise(e.kind, e.detail, e.code)
        },
    }
}

fn open_on(library: u64, instance: u64, in wanted: Str)
    -> Dev eff [Ffi[Vk], Ffi[LibC], Fail[GpuErr], Fail[RuntimeError], Fail[ArithOverflow]] {
    let mut count: u32 = 0;
    check(
        Vk::PfnEnumeratePhysicalDevices(
            pfn_enumerate_physical_devices(library),
            instance,
            inout count,
            0
        ),
        Call::EnumeratePhysicalDevices
    );
    let mut list = scratch(wrapping_add(widen_u64(count) * Handle::Bytes, Handle::Bytes));
    check(
        Vk::PfnEnumeratePhysicalDevices(
            pfn_enumerate_physical_devices(library),
            instance,
            inout count,
            list.base
        ),
        Call::EnumeratePhysicalDevices
    );
    pull(inout list);
    let mut chosen: Option[Dev] = Option::None;
    for i in 0..widen_u64(count) {
        let physical = get64(in list, i * Handle::Bytes);
        let p = properties(library, physical);
        let api = get32(in p, Properties2::ApiVersion);
        let name = c_string(in p, Properties2::DeviceName);
        let fits = api >= Api::Version1_2
            && contains(in name.as_slice(), in wanted.as_bytes())
            && timeline_supported(library, physical);
        if fits {
            match compute_family(library, physical) {
                Option::Some(family) => {
                    chosen = Option::Some(
                        Dev {
                            instance: instance,
                            physical: physical,
                            device: 0,
                            queue: 0,
                            family: family,
                            timeline: 0,
                            api_version: widen_u64(api),
                            device_type: widen_u64(get32(in p, Properties2::DeviceType)),
                            max_invocations: widen_u64(
                                get32(in p, Properties2::MaxComputeWorkGroupInvocations)
                            ),
                            max_range: widen_u64(get32(in p, Properties2::MaxStorageBufferRange)),
                            library: library,
                        }
                    );
                }
                Option::None => {}
            }
        }
        release(in p);
        let done = match chosen {
            Option::Some(_) => true,
            Option::None => false,
        };
        if done {
            break;
        }
    }
    release(in list);
    let mut d = match chosen {
        Option::Some(d) => d,
        Option::None => return raise(Kind::Unavailable, Unavailable::NoDevice, 0),
    };
    // VkDeviceQueueCreateInfo at 0, its priority (1.0f) at 40,
    // VkPhysicalDeviceVulkan12Features at 48, VkDeviceCreateInfo at 256,
    // VkPhysicalDeviceFeatures at 328. `robustBufferAccess` (a feature every
    // Vulkan 1.0 device has) keeps a kernel that indexes past a buffer from
    // touching other memory, whatever SPIR-V the caller supplies.
    let mut s = scratch(DeviceBlock::Bytes);
    header(inout s, 0, St::DeviceQueueCreateInfo);
    put32(inout s, DeviceQueueCreateInfo::QueueFamilyIndex, narrow_u32(d.family));
    put32(inout s, DeviceQueueCreateInfo::QueueCount, 1);
    put64(inout s, DeviceQueueCreateInfo::QueuePriorities, addr(in s, DeviceBlock::Priority));
    put32(inout s, DeviceBlock::Priority, ONE_F32_BITS);
    header(inout s, DeviceBlock::Features, St::Vulkan12Features);
    put32(inout s, DeviceBlock::Features + Vulkan12Features::TimelineSemaphore, 1);
    header(inout s, DeviceBlock::Device, St::DeviceCreateInfo);
    put64(inout s, DeviceBlock::Device + Header::PNext, addr(in s, DeviceBlock::Features));
    put32(inout s, DeviceBlock::Device + DeviceCreateInfo::QueueCreateInfoCount, 1);
    put64(inout s, DeviceBlock::Device + DeviceCreateInfo::QueueCreateInfos, s.base);
    put64(
        inout s,
        DeviceBlock::Device + DeviceCreateInfo::EnabledFeatures,
        addr(in s, DeviceBlock::CoreFeatures)
    );
    put32(inout s, DeviceBlock::CoreFeatures + DeviceFeatures::RobustBufferAccess, 1);
    flush(in s);
    let mut device: u64 = 0;
    let rc = Vk::PfnCreateDevice(
        pfn_create_device(library),
        d.physical,
        addr(in s, DeviceBlock::Device),
        0,
        inout device
    );
    release(in s);
    check(rc, Call::CreateDevice);
    d.device = device;
    let mut queue: u64 = 0;
    Vk::PfnGetDeviceQueue(
        pfn_get_device_queue(library),
        device,
        narrow_u32(d.family),
        0,
        inout queue
    );
    d.queue = queue;
    // VkSemaphoreTypeCreateInfo (timeline, initial 0) at 0 chained from
    // VkSemaphoreCreateInfo at 32.
    let mut t = scratch(SemaphoreTypeCreateInfo::Bytes + SemaphoreCreateInfo::Bytes);
    header(inout t, 0, St::SemaphoreTypeCreateInfo);
    put32(inout t, SemaphoreTypeCreateInfo::SemaphoreType, SemaphoreKind::Timeline);
    header(inout t, SemaphoreTypeCreateInfo::Bytes, St::SemaphoreCreateInfo);
    put64(inout t, SemaphoreTypeCreateInfo::Bytes + Header::PNext, t.base);
    flush(in t);
    let mut timeline: u64 = 0;
    let rc = Vk::PfnCreateSemaphore(
        pfn_create_semaphore(library),
        device,
        addr(in t, SemaphoreTypeCreateInfo::Bytes),
        0,
        inout timeline
    );
    release(in t);
    if rc < 0 {
        Vk::PfnDestroyDevice(pfn_destroy_device(library), device, 0);
        fail(Kind::Vulkan, Call::CreateSemaphore, widen_i64(rc));
    }
    d.timeline = timeline;
    d
}

// Waits for the device, then destroys the timeline, the device and the
// instance. Every buffer, kernel and recording must be freed first.
pub fn close(in d: Dev) eff [Ffi[Vk]] {
    Vk::PfnDeviceWaitIdle(pfn_device_wait_idle(d.library), d.device);
    Vk::PfnDestroySemaphore(pfn_destroy_semaphore(d.library), d.device, d.timeline, 0);
    Vk::PfnDestroyDevice(pfn_destroy_device(d.library), d.device, 0);
    Vk::PfnDestroyInstance(pfn_destroy_instance(d.library), d.instance, 0);
    Vk::dlclose(d.library);
}

// Waits for the device to go idle (after a failed wait, before freeing).
pub fn wait_idle(in d: Dev) eff [Ffi[Vk]] {
    Vk::PfnDeviceWaitIdle(pfn_device_wait_idle(d.library), d.device);
}

// The device name, the driver name and the driver info, each followed by a
// NUL byte.
pub fn device_strings(in d: Dev)
    -> ChunkSeq[u8] eff [Ffi[Vk], Ffi[LibC], Fail[RuntimeError], Fail[ArithOverflow]] {
    let p = properties(d.library, d.physical);
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let name = c_string(in p, Properties2::DeviceName);
    let driver = c_string(in p, PropertiesBlock::Driver + DriverProperties::DriverName);
    let info = c_string(in p, PropertiesBlock::Driver + DriverProperties::DriverInfo);
    out.extend(in name.as_slice());
    out.push(0);
    out.extend(in driver.as_slice());
    out.push(0);
    out.extend(in info.as_slice());
    out.push(0);
    release(in p);
    out
}

// The timeline value of the last completed submission.
pub fn completed(in d: Dev) -> u64 eff [Ffi[Vk], Fail[GpuErr]] {
    let mut value: u64 = 0;
    check(
        Vk::PfnGetSemaphoreCounterValue(
            pfn_get_semaphore_counter_value(d.library),
            d.device,
            d.timeline,
            inout value
        ),
        Call::GetSemaphoreCounterValue
    );
    value
}

// Blocks until the timeline reaches `value`. With the compute-to-host
// barrier after every dispatch, the device's writes are then visible to
// the host.
pub fn wait_value(in d: Dev, value: u64) eff [
    Ffi[Vk],
    Ffi[LibC],
    Fail[GpuErr],
    Fail[RuntimeError],
    Fail[ArithOverflow]
] {
    // The semaphore at 0, the value at 8, VkSemaphoreWaitInfo at 16.
    let mut s = scratch(WaitBlock::Bytes);
    put64(inout s, WaitBlock::Semaphore, d.timeline);
    put64(inout s, WaitBlock::Value, value);
    header(inout s, WaitBlock::Info, St::SemaphoreWaitInfo);
    put32(inout s, WaitBlock::Info + SemaphoreWaitInfo::SemaphoreCount, 1);
    put64(
        inout s,
        WaitBlock::Info + SemaphoreWaitInfo::Semaphores,
        addr(in s, WaitBlock::Semaphore)
    );
    put64(inout s, WaitBlock::Info + SemaphoreWaitInfo::Values, addr(in s, WaitBlock::Value));
    flush(in s);
    let rc = Vk::PfnWaitSemaphores(
        pfn_wait_semaphores(d.library),
        d.device,
        addr(in s, WaitBlock::Info),
        WHOLE_SIZE
    );
    release(in s);
    check(rc, Call::WaitSemaphores);
}

// A zero-filled storage buffer of `bytes` bytes rounded up to 4, mapped
// host-visible and coherent.
pub fn buffer_new(in d: Dev, bytes: u64)
    -> Buf eff [Ffi[Vk], Ffi[LibC], Fail[GpuErr], Fail[RuntimeError], Fail[ArithOverflow]] {
    if bytes == 0 {
        return raise(Kind::Shape, BadShape::ZeroBuffer, 0);
    }
    if bytes > Max::BufferBytes || bytes > d.max_range {
        return raise(Kind::Limit, OverLimit::BufferSize, 0);
    }
    let len = (bytes + 3) / 4 * 4;
    // VkBufferCreateInfo at 0, VkMemoryRequirements at 56,
    // VkPhysicalDeviceMemoryProperties at 80, VkMemoryAllocateInfo at 600.
    let mut s = scratch(BufferBlock::Bytes);
    header(inout s, 0, St::BufferCreateInfo);
    put64(inout s, BufferCreateInfo::Size, len);
    put32(inout s, BufferCreateInfo::Usage, BufferUsage::StorageTransfer);
    flush(in s);
    let mut buffer: u64 = 0;
    let rc = Vk::PfnCreateBuffer(pfn_create_buffer(d.library), d.device, s.base, 0, inout buffer);
    if rc < 0 {
        release(in s);
        return raise(Kind::Vulkan, Call::CreateBuffer, widen_i64(rc));
    }
    Vk::PfnGetBufferMemoryRequirements(
        pfn_get_buffer_memory_requirements(d.library),
        d.device,
        buffer,
        addr(in s, BufferBlock::Requirements)
    );
    Vk::PfnGetPhysicalDeviceMemoryProperties(
        pfn_get_physical_device_memory_properties(d.library),
        d.physical,
        addr(in s, BufferBlock::Properties)
    );
    pull(inout s);
    let size = get64(in s, BufferBlock::Requirements + MemoryRequirements::Size);
    let bits = get32(in s, BufferBlock::Requirements + MemoryRequirements::MemoryTypeBits);
    let types = widen_u64(get32(in s, BufferBlock::Properties + MemoryProperties::MemoryTypeCount));
    let mut chosen: Option[u32] = Option::None;
    for i in 0..types {
        let flags = get32(
            in s,
            BufferBlock::Properties
                + MemoryProperties::MemoryTypes
                + i * MemoryType::Bytes
                + MemoryType::PropertyFlags
        );
        let allowed = (bits >> narrow_u32(i)) & 1 != 0;
        if allowed
            && flags & MemoryProperty::HostVisibleCoherent == MemoryProperty::HostVisibleCoherent {
            chosen = Option::Some(narrow_u32(i));
            break;
        }
    }
    let index = match chosen {
        Option::Some(i) => i,
        Option::None => {
            release(in s);
            Vk::PfnDestroyBuffer(pfn_destroy_buffer(d.library), d.device, buffer, 0);
            return raise(Kind::Unsupported, Unsupported::MemoryType, 0);
        }
    };
    header(inout s, BufferBlock::Allocate, St::MemoryAllocateInfo);
    put64(inout s, BufferBlock::Allocate + MemoryAllocateInfo::AllocationSize, size);
    put32(inout s, BufferBlock::Allocate + MemoryAllocateInfo::MemoryTypeIndex, index);
    flush(in s);
    let mut memory: u64 = 0;
    let rc = Vk::PfnAllocateMemory(
        pfn_allocate_memory(d.library),
        d.device,
        addr(in s, BufferBlock::Allocate),
        0,
        inout memory
    );
    release(in s);
    if rc < 0 {
        Vk::PfnDestroyBuffer(pfn_destroy_buffer(d.library), d.device, buffer, 0);
        return raise(Kind::Vulkan, Call::AllocateMemory, widen_i64(rc));
    }
    let rc = Vk::PfnBindBufferMemory(
        pfn_bind_buffer_memory(d.library),
        d.device,
        buffer,
        memory,
        0
    );
    if rc < 0 {
        Vk::PfnDestroyBuffer(pfn_destroy_buffer(d.library), d.device, buffer, 0);
        Vk::PfnFreeMemory(pfn_free_memory(d.library), d.device, memory, 0);
        return raise(Kind::Vulkan, Call::BindBufferMemory, widen_i64(rc));
    }
    let mut ptr: u64 = 0;
    let rc = Vk::PfnMapMemory(
        pfn_map_memory(d.library),
        d.device,
        memory,
        0,
        WHOLE_SIZE,
        0,
        inout ptr
    );
    if rc < 0 {
        Vk::PfnDestroyBuffer(pfn_destroy_buffer(d.library), d.device, buffer, 0);
        Vk::PfnFreeMemory(pfn_free_memory(d.library), d.device, memory, 0);
        return raise(Kind::Vulkan, Call::MapMemory, widen_i64(rc));
    }
    LibC::memset(ptr, 0, len);
    Buf {
        buffer: buffer,
        memory: memory,
        ptr: ptr,
        len: len,
    }
}

fn in_range(in b: Buf, offset: u64, n: u64) eff [Fail[GpuErr]] {
    if offset > b.len || n > wrapping_sub(b.len, offset) {
        fail(Kind::Shape, BadShape::BufferRange, 0);
    }
}

// Copies `data` to byte `offset`. The caller has waited for every
// submission that bound the buffer (`wait_value`).
pub fn buffer_write(in b: Buf, offset: u64, in data: Slice[u8]) eff [Ffi[LibC], Fail[GpuErr]] {
    in_range(in b, offset, data.len());
    LibC::memcpy(wrapping_add(b.ptr, offset), in data);
}

// Copies from byte `offset` into `out`, after the same wait.
pub fn buffer_read(in b: Buf, offset: u64, inout out: Slice[u8]) eff [Ffi[LibC], Fail[GpuErr]] {
    in_range(in b, offset, out.len());
    LibC::bcopy(wrapping_add(b.ptr, offset), inout out);
}

// Unmaps and frees a buffer no pending submission uses.
pub fn buffer_free(in d: Dev, in b: Buf) eff [Ffi[Vk]] {
    Vk::PfnUnmapMemory(pfn_unmap_memory(d.library), d.device, b.memory);
    Vk::PfnDestroyBuffer(pfn_destroy_buffer(d.library), d.device, b.buffer, 0);
    Vk::PfnFreeMemory(pfn_free_memory(d.library), d.device, b.memory, 0);
}

// `Kind::Shader` details: a SPIR-V module that is not one, lacks the entry
// point, or binds something other than what the runtime binds.
enum BadSpirv: _ {
    Malformed = 1,
    NoEntry = 2,
    Bindings = 3,
    Immediates = 4,
    Layout = 5,
}

// The SPIR-V opcodes, decorations and storage classes the interface reader
// looks at.
enum Spv: _ {
    Magic = 119734787,
    MaxBound = 4194304,
    EntryPoint = 15,
    TypeInt = 21,
    TypeFloat = 22,
    TypeVector = 23,
    TypeStruct = 30,
    TypePointer = 32,
    Variable = 59,
    Decorate = 71,
    MemberDecorate = 72,
    GlCompute = 5,
    Binding = 33,
    DescriptorSet = 34,
    Offset = 35,
    UniformConstant = 0,
    Uniform = 2,
    PushConstant = 9,
    StorageBuffer = 12,
}

// Module header word offsets and instruction header fields (SPIR-V §2.3).
enum SpirvHeader: u64 {
    Magic = 0,
    IdBound = 3,
    Words = 5,
}

const SPIRV_WORD_BYTES: u64 = 4;
const SPIRV_WORD_COUNT_SHIFT: u32 = 16;
const SPIRV_OPCODE_MASK: u32 = 0xffff;
const UNSET: u32 = 4294967295;

// A kernel module's binding interface: how many storage buffers it binds
// (all in set 0 at 0..n) and the size of its immediate block.
pub copy struct SpirvInterface {
    pub bindings: u64,
    pub immediate_bytes: u64,
}

fn id_table(bound: u64, v: u32) -> ChunkSeq[u32] {
    let mut t: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](bound);
    t.resize(bound, v);
    t
}

// The id in word `at`, which must be below the module's bound.
fn id_at(in spirv: Slice[u8], at: u64, bound: u64)
    -> u64 eff [Fail[GpuErr], Fail[RuntimeError], Fail[ArithOverflow]] {
    let id = widen_u64(word_at(in spirv, at));
    if id >= bound {
        return raise(Kind::Shader, BadSpirv::Malformed, 0);
    }
    id
}

// Whether the NUL-terminated literal string from word `at` up to word `end`
// is `name`.
fn names(in spirv: Slice[u8], at: u64, end: u64, in name: Slice[u8])
    -> bool eff [Fail[RuntimeError], Fail[ArithOverflow]] {
    let start = at * SPIRV_WORD_BYTES;
    if start + name.len() >= end * SPIRV_WORD_BYTES {
        return false;
    }
    for i in 0..name.len() {
        if spirv[start + i] != name[i] {
            return false;
        }
    }
    spirv[start + name.len()] == 0
}

// The bytes a struct type `ty` (declared at word `at`) spans: the end of its
// last member, rounded up to 4, or 0 when a member has no size (a runtime
// array, a pointer) or no `Offset`. Member decorations come before the
// types in a module, so every `Offset` is known here.
fn struct_bytes(
    in spirv: Slice[u8],
    at: u64,
    ty: u64,
    bound: u64,
    in sizes: ChunkSeq[u32],
    in offsets: ChunkSeq[u64]
) -> u64 eff [Fail[GpuErr], Fail[RuntimeError], Fail[ArithOverflow]] {
    let members = widen_u64(word_at(in spirv, at) >> SPIRV_WORD_COUNT_SHIFT) - 2;
    let mut end: u64 = 0;
    for m in 0..members {
        let size = widen_u64(sizes[id_at(in spirv, at + 2 + m, bound)]);
        if size == 0 {
            return 0;
        }
        let mut offset: u64 = widen_u64(UNSET);
        for i in 0..offsets.len() {
            let w = offsets[i];
            if widen_u64(word_at(in spirv, w + 1)) == ty
                && widen_u64(word_at(in spirv, w + 2)) == m {
                offset = widen_u64(word_at(in spirv, w + 4));
            }
        }
        if offset == widen_u64(UNSET) {
            return 0;
        }
        if offset + size > end {
            end = offset + size;
        }
    }
    (end + 3) / 4 * 4
}

// Reads the binding interface of `spirv` for the compute entry point
// `entry`: every storage buffer in set 0 at bindings 0..n without gaps, at
// most one immediate block of scalars, vectors and structs of them, and no
// uniform buffers, images or samplers.
pub fn spirv_interface(in spirv: Slice[u8], in entry: Str)
    -> SpirvInterface eff [Fail[GpuErr], Fail[RuntimeError], Fail[ArithOverflow]] {
    let len = spirv.len();
    if len < SpirvHeader::Words * SPIRV_WORD_BYTES || len % SPIRV_WORD_BYTES != 0 {
        return raise(Kind::Shader, BadSpirv::Malformed, 0);
    }
    if word_at(in spirv, SpirvHeader::Magic) != Spv::Magic {
        return raise(Kind::Shader, BadSpirv::Malformed, 0);
    }
    let bound = widen_u64(word_at(in spirv, SpirvHeader::IdBound));
    if bound > Spv::MaxBound {
        return raise(Kind::Shader, BadSpirv::Malformed, 0);
    }
    let words = len / SPIRV_WORD_BYTES;
    let name = entry.as_bytes();
    let mut pointee = id_table(bound, UNSET);
    let mut sizes = id_table(bound, 0);
    let mut is_struct = id_table(bound, 0);
    let mut set_of = id_table(bound, UNSET);
    let mut binding_of = id_table(bound, UNSET);
    let mut vars: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut offsets: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut found = false;
    let mut at = SpirvHeader::Words;
    loop {
        if at >= words {
            break;
        }
        let head = word_at(in spirv, at);
        let count = widen_u64(head >> SPIRV_WORD_COUNT_SHIFT);
        let op = head & SPIRV_OPCODE_MASK;
        if count == 0 || count > words - at {
            return raise(Kind::Shader, BadSpirv::Malformed, 0);
        }
        if op == Spv::EntryPoint && count >= 4 {
            if word_at(in spirv, at + 1) == Spv::GlCompute
                && names(in spirv, at + 3, at + count, in name) {
                found = true;
            }
        } else if (op == Spv::TypeInt || op == Spv::TypeFloat) && count >= 3 {
            sizes.set(id_at(in spirv, at + 1, bound), word_at(in spirv, at + 2) / 8);
        } else if op == Spv::TypeVector && count >= 4 {
            let component = widen_u64(sizes[id_at(in spirv, at + 2, bound)]);
            let lanes = widen_u64(word_at(in spirv, at + 3));
            if lanes <= 4 {
                sizes.set(id_at(in spirv, at + 1, bound), narrow_u32(component * lanes));
            }
        } else if op == Spv::TypeStruct && count >= 2 {
            let id = id_at(in spirv, at + 1, bound);
            is_struct.set(id, 1);
            let bytes = struct_bytes(in spirv, at, id, bound, in sizes, in offsets);
            if bytes <= Max::ImmediateBytes {
                sizes.set(id, narrow_u32(bytes));
            }
        } else if op == Spv::TypePointer && count >= 4 {
            pointee.set(id_at(in spirv, at + 1, bound), narrow_u32(id_at(in spirv, at + 3, bound)));
        } else if op == Spv::Variable && count >= 4 {
            vars.push(at);
        } else if op == Spv::Decorate && count >= 4 {
            let id = id_at(in spirv, at + 1, bound);
            let decoration = word_at(in spirv, at + 2);
            if decoration == Spv::Binding {
                binding_of.set(id, word_at(in spirv, at + 3));
            } else if decoration == Spv::DescriptorSet {
                set_of.set(id, word_at(in spirv, at + 3));
            }
        } else if op == Spv::MemberDecorate && count >= 5 {
            if word_at(in spirv, at + 3) == Spv::Offset {
                offsets.push(at);
            }
        }
        at = at + count;
    }
    if !found {
        return raise(Kind::Shader, BadSpirv::NoEntry, 0);
    }
    let one: u64 = 1;
    let mut mask: u64 = 0;
    let mut bindings: u64 = 0;
    let mut immediate_bytes: u64 = 0;
    for v in 0..vars.len() {
        let w = vars[v];
        let ty = id_at(in spirv, w + 1, bound);
        let id = id_at(in spirv, w + 2, bound);
        let class = word_at(in spirv, w + 3);
        if class == Spv::StorageBuffer {
            // One buffer per binding: the pointee must be the block struct
            // itself, not an array of them (a descriptor array, which the
            // runtime's descriptorCount of 1 cannot bind).
            let block = pointee[ty];
            if block == UNSET || is_struct[widen_u64(block)] == 0 {
                return raise(Kind::Shader, BadSpirv::Layout, 0);
            }
            let b = widen_u64(binding_of[id]);
            if set_of[id] != 0 || b >= Max::Bindings || mask & (one << b) != 0 {
                return raise(Kind::Shader, BadSpirv::Layout, 0);
            }
            mask = mask | (one << b);
            bindings = bindings + 1;
        } else if class == Spv::PushConstant {
            let block = pointee[ty];
            if immediate_bytes != 0 || block == UNSET || sizes[widen_u64(block)] == 0 {
                return raise(Kind::Shader, BadSpirv::Layout, 0);
            }
            immediate_bytes = widen_u64(sizes[widen_u64(block)]);
        } else if class == Spv::Uniform || class == Spv::UniformConstant {
            return raise(Kind::Shader, BadSpirv::Layout, 0);
        }
    }
    if mask != (one << bindings) - 1 {
        return raise(Kind::Shader, BadSpirv::Layout, 0);
    }
    SpirvInterface {
        bindings: bindings,
        immediate_bytes: immediate_bytes,
    }
}

// A compute pipeline for entry point `entry` of the SPIR-V module `spirv`
// (little-endian words), binding `bindings` storage buffers at
// group 0, bindings 0.., and an immediate block of `imm` bytes.
pub fn kernel_new(in d: Dev, in spirv: Slice[u8], in entry: Str, bindings: u64, imm: u64)
    -> Kern eff [Ffi[Vk], Ffi[LibC], Fail[GpuErr], Fail[RuntimeError], Fail[ArithOverflow]] {
    if bindings == 0 || bindings > Max::Bindings {
        return raise(Kind::Limit, OverLimit::Bindings, 0);
    }
    if imm > Max::ImmediateBytes || imm % 4 != 0 {
        return raise(Kind::Limit, OverLimit::Immediates, 0);
    }
    let name = entry.as_bytes();
    for i in 0..name.len() {
        if name[i] == 0 {
            return raise(Kind::Shape, BadShape::EntryNul, 0);
        }
    }
    let interface = spirv_interface(in spirv, in entry);
    if interface.bindings != bindings {
        return raise(Kind::Shader, BadSpirv::Bindings, wrapping_i64(interface.bindings));
    }
    if interface.immediate_bytes > imm {
        return raise(Kind::Shader, BadSpirv::Immediates, wrapping_i64(interface.immediate_bytes));
    }
    // Set-layout bindings at 0 (24 each, up to 8), VkDescriptorSetLayoutCreateInfo
    // at 192, VkPushConstantRange at 224, the set layout at 240,
    // VkPipelineLayoutCreateInfo at 248.
    let mut s = scratch(LayoutBlock::Bytes);
    for i in 0..bindings {
        put32(inout s, i * SetLayoutBinding::Bytes + SetLayoutBinding::Binding, narrow_u32(i));
        put32(
            inout s,
            i * SetLayoutBinding::Bytes + SetLayoutBinding::DescriptorType,
            DescriptorType::StorageBuffer
        );
        put32(inout s, i * SetLayoutBinding::Bytes + SetLayoutBinding::DescriptorCount, 1);
        put32(
            inout s,
            i * SetLayoutBinding::Bytes + SetLayoutBinding::StageFlags,
            ShaderStage::Compute
        );
    }
    header(inout s, LayoutBlock::SetLayoutInfo, St::DescriptorSetLayoutCreateInfo);
    put32(
        inout s,
        LayoutBlock::SetLayoutInfo + SetLayoutCreateInfo::BindingCount,
        narrow_u32(bindings)
    );
    put64(inout s, LayoutBlock::SetLayoutInfo + SetLayoutCreateInfo::Bindings, s.base);
    flush(in s);
    let mut set_layout: u64 = 0;
    let rc = Vk::PfnCreateDescriptorSetLayout(
        pfn_create_descriptor_set_layout(d.library),
        d.device,
        addr(in s, LayoutBlock::SetLayoutInfo),
        0,
        inout set_layout
    );
    if rc < 0 {
        release(in s);
        return raise(Kind::Vulkan, Call::CreateDescriptorSetLayout, widen_i64(rc));
    }
    put32(inout s, LayoutBlock::PushRange + PushConstantRange::StageFlags, ShaderStage::Compute);
    put32(inout s, LayoutBlock::PushRange + PushConstantRange::Size, narrow_u32(imm));
    put64(inout s, LayoutBlock::SetLayout, set_layout);
    header(inout s, LayoutBlock::PipelineLayoutInfo, St::PipelineLayoutCreateInfo);
    put32(inout s, LayoutBlock::PipelineLayoutInfo + PipelineLayoutCreateInfo::SetLayoutCount, 1);
    put64(
        inout s,
        LayoutBlock::PipelineLayoutInfo + PipelineLayoutCreateInfo::SetLayouts,
        addr(in s, LayoutBlock::SetLayout)
    );
    if imm > 0 {
        put32(
            inout s,
            LayoutBlock::PipelineLayoutInfo + PipelineLayoutCreateInfo::PushConstantRangeCount,
            1
        );
        put64(
            inout s,
            LayoutBlock::PipelineLayoutInfo + PipelineLayoutCreateInfo::PushConstantRanges,
            addr(in s, LayoutBlock::PushRange)
        );
    }
    flush(in s);
    let mut layout: u64 = 0;
    let rc = Vk::PfnCreatePipelineLayout(
        pfn_create_pipeline_layout(d.library),
        d.device,
        addr(in s, LayoutBlock::PipelineLayoutInfo),
        0,
        inout layout
    );
    release(in s);
    if rc < 0 {
        Vk::PfnDestroyDescriptorSetLayout(
            pfn_destroy_descriptor_set_layout(d.library),
            d.device,
            set_layout,
            0
        );
        return raise(Kind::Vulkan, Call::CreatePipelineLayout, widen_i64(rc));
    }
    // The code, then VkShaderModuleCreateInfo after it (8-aligned).
    let code_at = 0;
    let info_at = (spirv.len() + 7) / 8 * 8;
    let mut m = scratch(info_at + ShaderModuleCreateInfo::Bytes);
    put_bytes(inout m, code_at, in spirv);
    header(inout m, info_at, St::ShaderModuleCreateInfo);
    put64(inout m, info_at + ShaderModuleCreateInfo::CodeSize, spirv.len());
    put64(inout m, info_at + ShaderModuleCreateInfo::Code, m.base);
    flush(in m);
    let mut module: u64 = 0;
    let rc = Vk::PfnCreateShaderModule(
        pfn_create_shader_module(d.library),
        d.device,
        addr(in m, info_at),
        0,
        inout module
    );
    release(in m);
    if rc < 0 {
        Vk::PfnDestroyPipelineLayout(pfn_destroy_pipeline_layout(d.library), d.device, layout, 0);
        Vk::PfnDestroyDescriptorSetLayout(
            pfn_destroy_descriptor_set_layout(d.library),
            d.device,
            set_layout,
            0
        );
        return raise(Kind::Vulkan, Call::CreateShaderModule, widen_i64(rc));
    }
    // VkComputePipelineCreateInfo at 0 with its stage at 24, the entry
    // name (NUL-terminated) at 96.
    let mut p = scratch(ComputePipelineCreateInfo::Bytes + 1 + name.len());
    header(inout p, 0, St::ComputePipelineCreateInfo);
    header(inout p, ComputePipelineCreateInfo::Stage, St::PipelineShaderStageCreateInfo);
    put32(
        inout p,
        ComputePipelineCreateInfo::Stage + ShaderStageCreateInfo::Stage,
        ShaderStage::Compute
    );
    put64(inout p, ComputePipelineCreateInfo::Stage + ShaderStageCreateInfo::Module, module);
    put64(
        inout p,
        ComputePipelineCreateInfo::Stage + ShaderStageCreateInfo::Name,
        addr(in p, ComputePipelineCreateInfo::Bytes)
    );
    put64(inout p, ComputePipelineCreateInfo::Layout, layout);
    put_bytes(inout p, ComputePipelineCreateInfo::Bytes, in name);
    flush(in p);
    let mut pipeline: u64 = 0;
    let rc = Vk::PfnCreateComputePipelines(
        pfn_create_compute_pipelines(d.library),
        d.device,
        0,
        1,
        p.base,
        0,
        inout pipeline
    );
    release(in p);
    Vk::PfnDestroyShaderModule(pfn_destroy_shader_module(d.library), d.device, module, 0);
    if rc < 0 {
        Vk::PfnDestroyPipelineLayout(pfn_destroy_pipeline_layout(d.library), d.device, layout, 0);
        Vk::PfnDestroyDescriptorSetLayout(
            pfn_destroy_descriptor_set_layout(d.library),
            d.device,
            set_layout,
            0
        );
        return raise(Kind::Vulkan, Call::CreateComputePipelines, widen_i64(rc));
    }
    Kern {
        set_layout: set_layout,
        layout: layout,
        pipeline: pipeline,
        bindings: bindings,
        imm: imm,
    }
}

// Destroys a kernel no pending submission uses.
pub fn kernel_free(in d: Dev, in k: Kern) eff [Ffi[Vk]] {
    Vk::PfnDestroyPipeline(pfn_destroy_pipeline(d.library), d.device, k.pipeline, 0);
    Vk::PfnDestroyPipelineLayout(pfn_destroy_pipeline_layout(d.library), d.device, k.layout, 0);
    Vk::PfnDestroyDescriptorSetLayout(
        pfn_destroy_descriptor_set_layout(d.library),
        d.device,
        k.set_layout,
        0
    );
}

// Starts recording a one-time-submit command buffer from a transient pool.
pub fn rec_new(in d: Dev)
    -> Rec eff [Ffi[Vk], Ffi[LibC], Fail[GpuErr], Fail[RuntimeError], Fail[ArithOverflow]] {
    // VkCommandPoolCreateInfo at 0, VkCommandBufferAllocateInfo at 24,
    // VkCommandBufferBeginInfo at 56.
    let mut s = scratch(CommandBlock::Bytes);
    header(inout s, 0, St::CommandPoolCreateInfo);
    put32(inout s, CommandPoolCreateInfo::Flags, CommandPoolFlag::Transient);
    put32(inout s, CommandPoolCreateInfo::QueueFamilyIndex, narrow_u32(d.family));
    flush(in s);
    let mut pool: u64 = 0;
    let rc = Vk::PfnCreateCommandPool(
        pfn_create_command_pool(d.library),
        d.device,
        s.base,
        0,
        inout pool
    );
    if rc < 0 {
        release(in s);
        return raise(Kind::Vulkan, Call::CreateCommandPool, widen_i64(rc));
    }
    header(inout s, CommandBlock::Allocate, St::CommandBufferAllocateInfo);
    put64(inout s, CommandBlock::Allocate + CommandBufferAllocateInfo::CommandPool, pool);
    put32(inout s, CommandBlock::Allocate + CommandBufferAllocateInfo::CommandBufferCount, 1);
    header(inout s, CommandBlock::Begin, St::CommandBufferBeginInfo);
    put32(
        inout s,
        CommandBlock::Begin + CommandBufferBeginInfo::Flags,
        CommandBufferUsage::OneTimeSubmit
    );
    flush(in s);
    let mut cmd: u64 = 0;
    let rc = Vk::PfnAllocateCommandBuffers(
        pfn_allocate_command_buffers(d.library),
        d.device,
        addr(in s, CommandBlock::Allocate),
        inout cmd
    );
    if rc < 0 {
        release(in s);
        Vk::PfnDestroyCommandPool(pfn_destroy_command_pool(d.library), d.device, pool, 0);
        return raise(Kind::Vulkan, Call::AllocateCommandBuffers, widen_i64(rc));
    }
    let rc = Vk::PfnBeginCommandBuffer(
        pfn_begin_command_buffer(d.library),
        cmd,
        addr(in s, CommandBlock::Begin)
    );
    release(in s);
    if rc < 0 {
        Vk::PfnDestroyCommandPool(pfn_destroy_command_pool(d.library), d.device, pool, 0);
        return raise(Kind::Vulkan, Call::BeginCommandBuffer, widen_i64(rc));
    }
    Rec {
        pool: pool,
        cmd: cmd,
        sets_left: 0,
        pools: ChunkSeq::new[u64](),
    }
}

fn descriptor_set(in d: Dev, inout r: Rec, in k: Kern)
    -> u64 eff [Ffi[Vk], Ffi[LibC], Fail[GpuErr], Fail[RuntimeError], Fail[ArithOverflow]] {
    if r.sets_left == 0 {
        // VkDescriptorPoolSize at 0, VkDescriptorPoolCreateInfo at 8.
        let mut s = scratch(DescriptorPoolSize::Bytes + DescriptorPoolCreateInfo::Bytes);
        put32(inout s, DescriptorPoolSize::Type, DescriptorType::StorageBuffer);
        put32(
            inout s,
            DescriptorPoolSize::DescriptorCount,
            narrow_u32(Max::SetsPerPool * Max::Bindings)
        );
        header(inout s, DescriptorPoolSize::Bytes, St::DescriptorPoolCreateInfo);
        put32(
            inout s,
            DescriptorPoolSize::Bytes + DescriptorPoolCreateInfo::MaxSets,
            narrow_u32(Max::SetsPerPool)
        );
        put32(inout s, DescriptorPoolSize::Bytes + DescriptorPoolCreateInfo::PoolSizeCount, 1);
        put64(inout s, DescriptorPoolSize::Bytes + DescriptorPoolCreateInfo::PoolSizes, s.base);
        flush(in s);
        let mut pool: u64 = 0;
        let rc = Vk::PfnCreateDescriptorPool(
            pfn_create_descriptor_pool(d.library),
            d.device,
            addr(in s, DescriptorPoolSize::Bytes),
            0,
            inout pool
        );
        release(in s);
        check(rc, Call::CreateDescriptorPool);
        r.pools.push(pool);
        r.sets_left = Max::SetsPerPool;
    }
    let pool = r.pools[r.pools.len() - 1];
    // The set layout at 0, VkDescriptorSetAllocateInfo at 8.
    let mut s = scratch(Handle::Bytes + DescriptorSetAllocateInfo::Bytes);
    put64(inout s, 0, k.set_layout);
    header(inout s, Handle::Bytes, St::DescriptorSetAllocateInfo);
    put64(inout s, Handle::Bytes + DescriptorSetAllocateInfo::DescriptorPool, pool);
    put32(inout s, Handle::Bytes + DescriptorSetAllocateInfo::DescriptorSetCount, 1);
    put64(inout s, Handle::Bytes + DescriptorSetAllocateInfo::SetLayouts, s.base);
    flush(in s);
    let mut set: u64 = 0;
    let rc = Vk::PfnAllocateDescriptorSets(
        pfn_allocate_descriptor_sets(d.library),
        d.device,
        addr(in s, Handle::Bytes),
        inout set
    );
    release(in s);
    check(rc, Call::AllocateDescriptorSets);
    r.sets_left = r.sets_left - 1;
    set
}

// Records `k` over `gx * gy * gz` workgroups with `buffers` (their
// VkBuffer handles) bound to bindings 0.. and `immediates` as its immediate
// block, followed by a compute-to-compute and compute-to-host memory
// barrier. Arguments are checked before anything is recorded.
pub fn rec_dispatch(
    in d: Dev,
    inout r: Rec,
    in k: Kern,
    in buffers: Slice[u64],
    in immediates: Slice[u8],
    gx: u32,
    gy: u32,
    gz: u32,
) eff [Ffi[Vk], Ffi[LibC], Fail[GpuErr], Fail[RuntimeError], Fail[ArithOverflow]] {
    if buffers.len() != k.bindings {
        return raise(Kind::Shape, BadShape::DispatchBuffers, 0);
    }
    if immediates.len() != k.imm {
        return raise(Kind::Shape, BadShape::DispatchImmediates, 0);
    }
    if gx == 0 || gy == 0 || gz == 0 {
        return raise(Kind::Shape, BadShape::ZeroGroups, 0);
    }
    if gx > Max::Groups || gy > Max::Groups || gz > Max::Groups {
        return raise(Kind::Limit, OverLimit::Groups, 0);
    }
    let set = descriptor_set(in d, inout r, in k);
    // VkDescriptorBufferInfo at 0 (24 each, up to 8), VkWriteDescriptorSet at
    // 192 (64 each), VkMemoryBarrier at 704, the set at 728, immediates at 736.
    let mut s = scratch(DispatchBlock::Bytes);
    let n = buffers.len();
    for i in 0..n {
        put64(inout s, i * DescriptorBufferInfo::Bytes + DescriptorBufferInfo::Buffer, buffers[i]);
        put64(inout s, i * DescriptorBufferInfo::Bytes + DescriptorBufferInfo::Range, WHOLE_SIZE);
        let w = DispatchBlock::Writes + i * WriteDescriptorSet::Bytes;
        header(inout s, w, St::WriteDescriptorSet);
        put64(inout s, w + WriteDescriptorSet::DstSet, set);
        put32(inout s, w + WriteDescriptorSet::DstBinding, narrow_u32(i));
        put32(inout s, w + WriteDescriptorSet::DescriptorCount, 1);
        put32(inout s, w + WriteDescriptorSet::DescriptorType, DescriptorType::StorageBuffer);
        put64(
            inout s,
            w + WriteDescriptorSet::BufferInfo,
            addr(in s, i * DescriptorBufferInfo::Bytes)
        );
    }
    header(inout s, DispatchBlock::Barrier, St::MemoryBarrier);
    put32(inout s, DispatchBlock::Barrier + MemoryBarrier::SrcAccessMask, Access::ShaderWrite);
    put32(
        inout s,
        DispatchBlock::Barrier + MemoryBarrier::DstAccessMask,
        Access::ShaderRead | Access::ShaderWrite | Access::HostRead
    );
    put64(inout s, DispatchBlock::Set, set);
    put_bytes(inout s, DispatchBlock::Immediates, in immediates);
    flush(in s);
    Vk::PfnUpdateDescriptorSets(
        pfn_update_descriptor_sets(d.library),
        d.device,
        narrow_u32(n),
        addr(in s, DispatchBlock::Writes),
        0,
        0
    );
    Vk::PfnCmdBindPipeline(pfn_cmd_bind_pipeline(d.library), r.cmd, BindPoint::Compute, k.pipeline);
    Vk::PfnCmdBindDescriptorSets(
        pfn_cmd_bind_descriptor_sets(d.library),
        r.cmd,
        BindPoint::Compute,
        k.layout,
        0,
        1,
        addr(in s, DispatchBlock::Set),
        0,
        0
    );
    if immediates.len() > 0 {
        Vk::PfnCmdPushConstants(
            pfn_cmd_push_constants(d.library),
            r.cmd,
            k.layout,
            ShaderStage::Compute,
            0,
            narrow_u32(immediates.len()),
            addr(in s, DispatchBlock::Immediates)
        );
    }
    Vk::PfnCmdDispatch(pfn_cmd_dispatch(d.library), r.cmd, gx, gy, gz);
    Vk::PfnCmdPipelineBarrier(
        pfn_cmd_pipeline_barrier(d.library),
        r.cmd,
        PipelineStage::Compute,
        PipelineStage::Compute | PipelineStage::Host,
        0,
        1,
        addr(in s, DispatchBlock::Barrier),
        0,
        0,
        0,
        0
    );
    release(in s);
}

// Ends recording and submits: the submission waits for timeline value
// `previous` and signals `previous + 1`, which it returns. The caller
// serializes submissions on the queue.
pub fn rec_submit(in d: Dev, in r: Rec, previous: u64)
    -> u64 eff [Ffi[Vk], Ffi[LibC], Fail[GpuErr], Fail[RuntimeError], Fail[ArithOverflow]] {
    check(
        Vk::PfnEndCommandBuffer(pfn_end_command_buffer(d.library), r.cmd),
        Call::EndCommandBuffer
    );
    let value = previous + 1;
    // Wait value at 0, signal value at 8, VkTimelineSemaphoreSubmitInfo at
    // 16, the semaphore at 64, the wait stage at 72, the command buffer at
    // 80, VkSubmitInfo at 88.
    let mut s = scratch(SubmitBlock::Bytes);
    let tl = SubmitBlock::Timeline;
    let sub = SubmitBlock::Submit;
    put64(inout s, SubmitBlock::WaitValue, previous);
    put64(inout s, SubmitBlock::SignalValue, value);
    header(inout s, tl, St::TimelineSubmitInfo);
    put32(inout s, tl + TimelineSubmitInfo::WaitValueCount, 1);
    put64(inout s, tl + TimelineSubmitInfo::WaitValues, addr(in s, SubmitBlock::WaitValue));
    put32(inout s, tl + TimelineSubmitInfo::SignalValueCount, 1);
    put64(inout s, tl + TimelineSubmitInfo::SignalValues, addr(in s, SubmitBlock::SignalValue));
    put64(inout s, SubmitBlock::Semaphore, d.timeline);
    put32(inout s, SubmitBlock::Stage, PipelineStage::Compute);
    put64(inout s, SubmitBlock::Command, r.cmd);
    header(inout s, sub, St::SubmitInfo);
    put64(inout s, sub + Header::PNext, addr(in s, tl));
    put32(inout s, sub + SubmitInfo::WaitSemaphoreCount, 1);
    put64(inout s, sub + SubmitInfo::WaitSemaphores, addr(in s, SubmitBlock::Semaphore));
    put64(inout s, sub + SubmitInfo::WaitDstStageMask, addr(in s, SubmitBlock::Stage));
    put32(inout s, sub + SubmitInfo::CommandBufferCount, 1);
    put64(inout s, sub + SubmitInfo::CommandBuffers, addr(in s, SubmitBlock::Command));
    put32(inout s, sub + SubmitInfo::SignalSemaphoreCount, 1);
    put64(inout s, sub + SubmitInfo::SignalSemaphores, addr(in s, SubmitBlock::Semaphore));
    flush(in s);
    let rc = Vk::PfnQueueSubmit(pfn_queue_submit(d.library), d.queue, 1, addr(in s, sub), 0);
    release(in s);
    check(rc, Call::QueueSubmit);
    value
}

// Frees a recording's descriptor pools and command pool. Its command
// buffer must not be pending: never submitted, or its value waited for.
pub fn rec_free(in d: Dev, in r: Rec) eff [Ffi[Vk], Fail[RuntimeError]] {
    for i in 0..r.pools.len() {
        Vk::PfnDestroyDescriptorPool(
            pfn_destroy_descriptor_pool(d.library),
            d.device,
            r.pools[i],
            0
        );
    }
    Vk::PfnDestroyCommandPool(pfn_destroy_command_pool(d.library), d.device, r.pool, 0);
}

// ---------------------------------------------------------------------------
// The Kinetic broadphase (src/broadphase.rs): sort and sweep on the device.
// The crate keeps the buffers and kernels; this part checks the boxes,
// records the whole schedule in one submission, waits for it and reads the
// pair count back.

// The broadphase's four kernels (keys, bitonic sort step, sweep, scan).
pub copy struct BpKernels {
    pub keys: Kern,
    pub sort: Kern,
    pub sweep: Kern,
    pub scan: Kern,
}

// The broadphase's device buffers: 6 words per box, the padded keys and
// ids, per-box counts, their exclusive prefix sums (plus the total) and the
// pair words.
pub copy struct BpBuffers {
    pub boxes: Buf,
    pub keys: Buf,
    pub ids: Buf,
    pub counts: Buf,
    pub offsets: Buf,
    pub pairs: Buf,
}

// A call that may have failed (handlers return it, so the recording is
// freed outside them).
copy struct Outcome {
    failed: bool,
    value: u64,
    err: GpuErr,
}

fn no_error() -> GpuErr {
    GpuErr {
        kind: 0,
        detail: 0,
        code: 0
    }
}

// One run: the timeline value it submitted (0 when nothing was submitted),
// the pair count the device wrote, and the wait's error (`kind` 0 when the
// wait succeeded).
pub copy struct BpRun {
    pub value: u64,
    pub total: u64,
    pub err: GpuErr,
}

const F32_EXPONENT: u32 = 2139095040;
const F32_SIGN: u32 = 2147483648;

fn word_at(in words: Slice[u8], i: u64) -> u32 eff [Fail[RuntimeError], Fail[ArithOverflow]] {
    let at = i * 4;
    widen_u32(words[at]) | (widen_u32(words[at + 1]) << 8) | (widen_u32(words[at + 2]) << 16) | (
        widen_u32(words[at + 3]) << 24
    )
}

// The order-preserving encoding of a finite f32's bits (-0 as +0), the one
// the kernels compare (`order_key` in src/broadphase.rs).
pub fn order_key(bits: u32) -> u32 {
    let b = if bits == F32_SIGN {
        0
    } else {
        bits
    };
    if b & F32_SIGN != 0 {
        b ^ 4294967295
    } else {
        b | F32_SIGN
    }
}

fn finite(bits: u32) -> bool {
    bits & F32_EXPONENT != F32_EXPONENT
}

// 1 + the index of the first box that is not finite or has min > max on an
// axis (the CPU broadphase's `InvalidBox`), or 0 when every one of the `n`
// boxes (6 f32 bit patterns each: min xyz, max xyz) is valid.
pub fn bp_check(in words: Slice[u8], n: u64) -> u64 eff [Fail[RuntimeError], Fail[ArithOverflow]] {
    let mut bad: u64 = 0;
    for i in 0..n {
        let mut ok = true;
        for a in 0..3 {
            let lo = word_at(in words, i * 6 + a);
            let hi = word_at(in words, i * 6 + 3 + a);
            if !(finite(lo) && finite(hi) && order_key(lo) <= order_key(hi)) {
                ok = false;
            }
        }
        if !ok {
            bad = i + 1;
            break;
        }
    }
    bad
}

fn imm4(a: u32, b: u32, c: u32, e: u32)
    -> ChunkSeq[u8] eff [Fail[RuntimeError], Fail[ArithOverflow]] {
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    out.resize(16, 0);
    let mut s = Scratch {
        base: 0,
        image: out
    };
    put32(inout s, 0, a);
    put32(inout s, 4, b);
    put32(inout s, 8, c);
    put32(inout s, 12, e);
    s.image
}

fn groups64(items: u64) -> u32 eff [Fail[ArithOverflow]] {
    narrow_u32((items + 63) / 64)
}

fn next_power_of_two(n: u64) -> u64 eff [Fail[ArithOverflow]] {
    let mut p: u64 = 1;
    loop {
        if p >= n {
            break;
        }
        p = p * 2;
    }
    p
}

// Records the broadphase over `n` (2 or more) checked boxes whose words are
// `words`: keys, the bitonic sort over the padded length, the counting
// sweep, the scan and the writing sweep. Leaves the recording to the caller.
fn bp_record(
    in d: Dev,
    inout r: Rec,
    in k: BpKernels,
    in b: BpBuffers,
    n: u64,
    max_pairs: u64
) eff [Ffi[Vk], Ffi[LibC], Fail[GpuErr], Fail[RuntimeError], Fail[ArithOverflow]] {
    let padded = next_power_of_two(n);
    let n32 = narrow_u32(n);
    let padded32 = narrow_u32(padded);
    let cap = narrow_u32(max_pairs);
    let mut keys_bufs: ChunkSeq[u64] = ChunkSeq::new[u64]();
    keys_bufs.push(b.boxes.buffer);
    keys_bufs.push(b.keys.buffer);
    keys_bufs.push(b.ids.buffer);
    let imm = imm4(n32, padded32, 0, 0);
    rec_dispatch(
        in d,
        inout r,
        in k.keys,
        in keys_bufs.as_slice(),
        in imm.as_slice(),
        groups64(padded),
        1,
        1
    );
    let mut sort_bufs: ChunkSeq[u64] = ChunkSeq::new[u64]();
    sort_bufs.push(b.keys.buffer);
    sort_bufs.push(b.ids.buffer);
    let mut kk: u32 = 2;
    loop {
        if kk > padded32 {
            break;
        }
        let mut j = kk / 2;
        loop {
            if j == 0 {
                break;
            }
            let imm = imm4(n32, padded32, j, kk);
            rec_dispatch(
                in d,
                inout r,
                in k.sort,
                in sort_bufs.as_slice(),
                in imm.as_slice(),
                groups64(padded),
                1,
                1
            );
            j = j / 2;
        }
        kk = kk * 2;
    }
    let mut sweep_bufs: ChunkSeq[u64] = ChunkSeq::new[u64]();
    sweep_bufs.push(b.boxes.buffer);
    sweep_bufs.push(b.keys.buffer);
    sweep_bufs.push(b.ids.buffer);
    sweep_bufs.push(b.counts.buffer);
    sweep_bufs.push(b.offsets.buffer);
    sweep_bufs.push(b.pairs.buffer);
    let count = imm4(n32, 0, cap, 0);
    rec_dispatch(
        in d,
        inout r,
        in k.sweep,
        in sweep_bufs.as_slice(),
        in count.as_slice(),
        groups64(n),
        1,
        1
    );
    let mut scan_bufs: ChunkSeq[u64] = ChunkSeq::new[u64]();
    scan_bufs.push(b.counts.buffer);
    scan_bufs.push(b.offsets.buffer);
    let scan = imm4(n32, 0, 0, 0);
    rec_dispatch(in d, inout r, in k.scan, in scan_bufs.as_slice(), in scan.as_slice(), 1, 1, 1);
    let write = imm4(n32, 1, cap, 0);
    rec_dispatch(
        in d,
        inout r,
        in k.sweep,
        in sweep_bufs.as_slice(),
        in write.as_slice(),
        groups64(n),
        1,
        1
    );
}

// Writes the `n` boxes' words, runs the whole broadphase in one submission
// after timeline value `previous`, waits for it and returns its value and
// the pair count (which may exceed `max_pairs`: the caller reports that).
// A failed wait is returned in `err`, not raised, with the submitted value.
// The caller holds the queue lock and owns every buffer and kernel, none of
// which a pending submission uses. Fewer than 2 boxes submit nothing.
pub fn bp_run(
    in d: Dev,
    in k: BpKernels,
    in b: BpBuffers,
    in words: Slice[u8],
    n: u64,
    max_pairs: u64,
    previous: u64,
) -> BpRun eff [Ffi[Vk], Ffi[LibC], Fail[GpuErr], Fail[RuntimeError], Fail[ArithOverflow]] {
    if n < 2 {
        return BpRun {
            value: 0,
            total: 0,
            err: no_error(),
        };
    }
    buffer_write(in b.boxes, 0, in words);
    let mut r = rec_new(in d);
    let submitted = handle Fail[GpuErr] in {
        bp_record(in d, inout r, in k, in b, n, max_pairs);
        Outcome {
            failed: false,
            value: rec_submit(in d, in r, previous),
            err: no_error()
        }
    } with {
        return v => v,
        raise(e, k2) => Outcome {
            failed: true,
            value: 0,
            err: e
        },
    };
    if submitted.failed {
        rec_free(in d, in r);
        fail(submitted.err.kind, submitted.err.detail, submitted.err.code);
    }
    let value = submitted.value;
    let waited = handle Fail[GpuErr] in {
        wait_value(in d, value);
        Outcome {
            failed: false,
            value: value,
            err: no_error()
        }
    } with {
        return v => v,
        raise(e, k3) => Outcome {
            failed: true,
            value: 0,
            err: e
        },
    };
    if waited.failed {
        // The value was signalled or the device is lost: report it with the
        // error, so the crate still advances its timeline past it.
        wait_idle(in d);
        rec_free(in d, in r);
        return BpRun {
            value: value,
            total: 0,
            err: waited.err
        };
    }
    rec_free(in d, in r);
    let mut total: ChunkSeq[u8] = ChunkSeq::new[u8]();
    total.resize(4, 0);
    buffer_read(in b.offsets, n * 4, inout total.as_slice_mut());
    BpRun {
        value: value,
        total: widen_u64(word_at(in total.as_slice(), 0)),
        err: no_error(),
    }
}

// ---------------------------------------------------------------------------
// The tensor kernels' checks and dispatches (src/tensor.rs) and the whole
// llama2.c decode step. The crate owns every buffer and kernel and passes
// their handles; each function here checks the shapes exactly as the CPU
// kernels' contract states, then records the dispatch.

// `Kind::Shape` details of the tensor kernels' checks (src/tensor.rs).
enum TensorShape: _ {
    MatmulA = 8,
    MatmulW = 9,
    MatmulOut = 10,
    RmsEpsilon = 11,
    RmsX = 12,
    RmsOut = 13,
    RmsWeight = 14,
    RopeHeads = 15,
    RopeX = 16,
    RopeFreqs = 17,
    SwigluGate = 18,
    SwigluUp = 19,
    KvK = 20,
    KvV = 21,
    KvPosition = 22,
    KvKeys = 23,
    KvValues = 24,
    AttEmpty = 25,
    AttQ = 26,
    AttOut = 27,
    AttTable = 28,
    AttKeys = 29,
    AttValues = 30,
}

// `Kind::Limit` details of the tensor kernels' checks.
enum TensorLimit: _ {
    OperandSize = 5,
    MK = 6,
    NK = 7,
    MN = 8,
    RowsN = 9,
    AttHeadDim = 10,
    AttTokens = 11,
    AttWidth = 12,
    M = 13,
    N = 14,
    K = 15,
    MatmulRows = 16,
    RmsRows = 17,
    Len = 18,
    HeadDim = 19,
    Position = 20,
    KvDim = 21,
    QueryHeads = 22,
    KvHeads = 23,
    Tokens = 24,
}
// The six tensor kernels.
pub copy struct TensorKs {
    pub matmul: Kern,
    pub rms_norm: Kern,
    pub rope: Kern,
    pub swiglu: Kern,
    pub kv_write: Kern,
    pub attention: Kern,
}

// 16-token K/V pages (`vesper_tensor::kv::TOKENS_PER_PAGE`).
const TOKENS_PER_PAGE: u64 = 16;
// The attention kernel's workgroup score buffer and head width limits.
const MAX_ATTENTION_TOKENS: u64 = 2048;
const MAX_HEAD_DIM: u64 = 1024;
const U32_MAX: u64 = 4294967295;

// `a * b`, or `Kind::Limit` `what` when it overflows.
fn mul_or(a: u64, b: u64, what: u32) -> u64 eff [Fail[GpuErr], Fail[ArithOverflow]] {
    let r = handle Fail[ArithOverflow] in {
        Outcome {
            failed: false,
            value: a * b,
            err: no_error()
        }
    } with {
        return v => v,
        raise(e, k) => Outcome {
            failed: true,
            value: 0,
            err: no_error()
        },
    };
    if r.failed {
        fail(Kind::Limit, what, 0);
    }
    r.value
}

// `v` as a u32, or `Kind::Limit` `what`.
fn u32_of(v: u64, what: u32) -> u32 eff [Fail[GpuErr], Fail[ArithOverflow]] {
    if v > U32_MAX {
        fail(Kind::Limit, what, 0);
    }
    narrow_u32(v)
}

// `buffer` holds `floats` (more than zero) f32s, or `Kind::Shape` `what`.
fn need(in b: Buf, floats: u64, what: u32) eff [Fail[GpuErr], Fail[ArithOverflow]] {
    let bytes = mul_or(floats, 4, TensorLimit::OperandSize);
    if floats == 0 || bytes > b.len {
        fail(Kind::Shape, what, 0);
    }
}

fn groups_for(n: u64, per: u64) -> u32 eff [Fail[GpuErr], Fail[RuntimeError], Fail[ArithOverflow]] {
    let g = n / per + if n % per == 0 {
        0
    } else {
        1
    };
    u32_of(g, OverLimit::Groups)
}

fn immediates(in words: Slice[u32]) -> ChunkSeq[u8] eff [Fail[RuntimeError], Fail[ArithOverflow]] {
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    out.resize(words.len() * 4, 0);
    let mut s = Scratch {
        base: 0,
        image: out
    };
    for i in 0..words.len() {
        put32(inout s, i * 4, words[i]);
    }
    s.image
}

// With `dry`, every tensor function makes all of its checks and records
// nothing, so a caller can report a shape error before an ownership one.
fn dispatch(
    in d: Dev,
    inout r: Rec,
    in k: Kern,
    in buffers: Slice[u64],
    in imm: Slice[u32],
    gx: u32,
    gy: u32,
    dry: bool,
) eff [Ffi[Vk], Ffi[LibC], Fail[GpuErr], Fail[RuntimeError], Fail[ArithOverflow]] {
    if dry {
        return;
    }
    let bytes = immediates(in imm);
    rec_dispatch(in d, inout r, in k, in buffers, in bytes.as_slice(), gx, gy, 1);
}

fn handles3(in a: Buf, in b: Buf, in c: Buf) -> ChunkSeq[u64] {
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    out.push(a.buffer);
    out.push(b.buffer);
    out.push(c.buffer);
    out
}

fn handles2(in a: Buf, in b: Buf) -> ChunkSeq[u64] {
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    out.push(a.buffer);
    out.push(b.buffer);
    out
}

fn handles5(in a: Buf, in b: Buf, in c: Buf, in e: Buf, in f: Buf) -> ChunkSeq[u64] {
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    out.push(a.buffer);
    out.push(b.buffer);
    out.push(c.buffer);
    out.push(e.buffer);
    out.push(f.buffer);
    out
}

// `out[r, c] = sum_i w[c, i] * a[r, i]` for `a: [m, k]`, `w: [n, k]`; with
// `accumulate` the sum is added to `out`.
pub fn tk_matmul(
    in d: Dev,
    inout r: Rec,
    in kern: Kern,
    in a: Buf,
    in w: Buf,
    in out: Buf,
    m: u64,
    n: u64,
    k: u64,
    accumulate: bool,
    dry: bool,
) eff [Ffi[Vk], Ffi[LibC], Fail[GpuErr], Fail[RuntimeError], Fail[ArithOverflow]] {
    need(in a, mul_or(m, k, TensorLimit::MK), TensorShape::MatmulA);
    need(in w, mul_or(n, k, TensorLimit::NK), TensorShape::MatmulW);
    need(in out, mul_or(m, n, TensorLimit::MN), TensorShape::MatmulOut);
    let mut imm: ChunkSeq[u32] = ChunkSeq::new[u32]();
    imm.push(u32_of(m, TensorLimit::M));
    imm.push(u32_of(n, TensorLimit::N));
    imm.push(u32_of(k, TensorLimit::K));
    imm
        .push(
            if accumulate {
                1
            } else {
                0
            }
        );
    let gx = groups_for(n, 64);
    let gy = u32_of(m, TensorLimit::MatmulRows);
    let bufs = handles3(in a, in w, in out);
    dispatch(in d, inout r, in kern, in bufs.as_slice(), in imm.as_slice(), gx, gy, dry);
}

// RMSNorm of each of `rows` rows of width `n`; `epsilon` is an f32's bits
// and must be finite and above zero.
pub fn tk_rms_norm(
    in d: Dev,
    inout r: Rec,
    in kern: Kern,
    in x: Buf,
    in weight: Buf,
    in out: Buf,
    rows: u64,
    n: u64,
    epsilon: u32,
    dry: bool,
) eff [Ffi[Vk], Ffi[LibC], Fail[GpuErr], Fail[RuntimeError], Fail[ArithOverflow]] {
    if !(finite(epsilon) && epsilon & F32_SIGN == 0 && epsilon != 0) {
        fail(Kind::Shape, TensorShape::RmsEpsilon, 0);
    }
    let total = mul_or(rows, n, TensorLimit::RowsN);
    need(in x, total, TensorShape::RmsX);
    need(in out, total, TensorShape::RmsOut);
    need(in weight, n, TensorShape::RmsWeight);
    let mut imm: ChunkSeq[u32] = ChunkSeq::new[u32]();
    imm.push(u32_of(n, TensorLimit::N));
    imm.push(epsilon);
    let gx = u32_of(rows, TensorLimit::RmsRows);
    let bufs = handles3(in x, in weight, in out);
    dispatch(in d, inout r, in kern, in bufs.as_slice(), in imm.as_slice(), gx, 1, dry);
}

// RoPE in place over `len` floats of whole heads of width `head_dim`, with
// `head_dim / 2` frequencies in `freqs`.
pub fn tk_rope(
    in d: Dev,
    inout r: Rec,
    in kern: Kern,
    in x: Buf,
    in freqs: Buf,
    len: u64,
    head_dim: u64,
    position: u64,
    dry: bool,
) eff [Ffi[Vk], Ffi[LibC], Fail[GpuErr], Fail[RuntimeError], Fail[ArithOverflow]] {
    let whole = head_dim != 0 && head_dim % 2 == 0 && len % head_dim == 0;
    if !whole {
        fail(Kind::Shape, TensorShape::RopeHeads, 0);
    }
    need(in x, len, TensorShape::RopeX);
    need(in freqs, head_dim / 2, TensorShape::RopeFreqs);
    let mut imm: ChunkSeq[u32] = ChunkSeq::new[u32]();
    imm.push(u32_of(len, TensorLimit::Len));
    imm.push(u32_of(head_dim, TensorLimit::HeadDim));
    imm.push(u32_of(position, TensorLimit::Position));
    let gx = groups_for(len / 2, 64);
    let bufs = handles2(in x, in freqs);
    dispatch(in d, inout r, in kern, in bufs.as_slice(), in imm.as_slice(), gx, 1, dry);
}

// `gate[i] = silu(gate[i]) * up[i]` for `n` elements.
pub fn tk_swiglu(
    in d: Dev,
    inout r: Rec,
    in kern: Kern,
    in gate: Buf,
    in up: Buf,
    n: u64,
    dry: bool
) eff [Ffi[Vk], Ffi[LibC], Fail[GpuErr], Fail[RuntimeError], Fail[ArithOverflow]] {
    need(in gate, n, TensorShape::SwigluGate);
    need(in up, n, TensorShape::SwigluUp);
    let mut imm: ChunkSeq[u32] = ChunkSeq::new[u32]();
    imm.push(u32_of(n, TensorLimit::N));
    let gx = groups_for(n, 64);
    let bufs = handles2(in gate, in up);
    dispatch(in d, inout r, in kern, in bufs.as_slice(), in imm.as_slice(), gx, 1, dry);
}

// Stores `k` and `v` (`kv_dim` floats each) at `position` of the paged
// sequence whose page table is `table`.
pub fn tk_kv_write(
    in d: Dev,
    inout r: Rec,
    in kern: Kern,
    in k: Buf,
    in v: Buf,
    in table: Buf,
    in keys: Buf,
    in values: Buf,
    position: u64,
    kv_dim: u64,
    dry: bool,
) eff [Ffi[Vk], Ffi[LibC], Fail[GpuErr], Fail[RuntimeError], Fail[ArithOverflow]] {
    need(in k, kv_dim, TensorShape::KvK);
    need(in v, kv_dim, TensorShape::KvV);
    if (position / TOKENS_PER_PAGE + 1) * 4 > table.len {
        fail(Kind::Shape, TensorShape::KvPosition, 0);
    }
    let page_floats = TOKENS_PER_PAGE * kv_dim;
    need(in keys, page_floats, TensorShape::KvKeys);
    need(in values, page_floats, TensorShape::KvValues);
    let mut imm: ChunkSeq[u32] = ChunkSeq::new[u32]();
    imm.push(u32_of(position, TensorLimit::Position));
    imm.push(u32_of(kv_dim, TensorLimit::KvDim));
    let gx = groups_for(kv_dim, 64);
    let bufs = handles5(in k, in v, in table, in keys, in values);
    dispatch(in d, inout r, in kern, in bufs.as_slice(), in imm.as_slice(), gx, 1, dry);
}

// Paged grouped-query attention of `q` (`[query_heads, head_dim]`) over
// `tokens` tokens into `out`. The caller checked the head ratio
// (`vesper_tensor::shape::gqa_ratio`, whose error type the crate keeps).
pub fn tk_attention(
    in d: Dev,
    inout r: Rec,
    in kern: Kern,
    in q: Buf,
    in keys: Buf,
    in values: Buf,
    in table: Buf,
    in out: Buf,
    query_heads: u64,
    kv_heads: u64,
    head_dim: u64,
    tokens: u64,
    dry: bool,
) eff [Ffi[Vk], Ffi[LibC], Fail[GpuErr], Fail[RuntimeError], Fail[ArithOverflow]] {
    if head_dim == 0 || head_dim > MAX_HEAD_DIM {
        fail(Kind::Limit, TensorLimit::AttHeadDim, 0);
    }
    if tokens == 0 {
        fail(Kind::Shape, TensorShape::AttEmpty, 0);
    }
    if tokens > MAX_ATTENTION_TOKENS {
        fail(Kind::Limit, TensorLimit::AttTokens, 0);
    }
    let width = mul_or(query_heads, head_dim, TensorLimit::AttWidth);
    need(in q, width, TensorShape::AttQ);
    need(in out, width, TensorShape::AttOut);
    let pages = tokens / TOKENS_PER_PAGE + if tokens % TOKENS_PER_PAGE == 0 {
        0
    } else {
        1
    };
    if pages * 4 > table.len {
        fail(Kind::Shape, TensorShape::AttTable, 0);
    }
    let page_floats = TOKENS_PER_PAGE * kv_heads * head_dim;
    need(in keys, page_floats, TensorShape::AttKeys);
    need(in values, page_floats, TensorShape::AttValues);
    let mut imm: ChunkSeq[u32] = ChunkSeq::new[u32]();
    imm.push(u32_of(query_heads, TensorLimit::QueryHeads));
    imm.push(u32_of(kv_heads, TensorLimit::KvHeads));
    imm.push(u32_of(head_dim, TensorLimit::HeadDim));
    imm.push(u32_of(tokens, TensorLimit::Tokens));
    let gx = u32_of(query_heads, TensorLimit::QueryHeads);
    let bufs = handles5(in q, in keys, in values, in table, in out);
    dispatch(in d, inout r, in kern, in bufs.as_slice(), in imm.as_slice(), gx, 1, dry);
}

// A model's shape for one decode step.
pub copy struct StepShape {
    pub dim: u64,
    pub kv_dim: u64,
    pub head_dim: u64,
    pub heads: u64,
    pub kv_heads: u64,
    pub hidden_dim: u64,
    pub vocab: u64,
    pub layers: u64,
    pub position: u64,
    pub epsilon: u32,
}

// One session's activation buffers and page table.
pub copy struct StepSession {
    pub table: Buf,
    pub x: Buf,
    pub xb: Buf,
    pub q: Buf,
    pub k: Buf,
    pub v: Buf,
    pub att: Buf,
    pub hb: Buf,
    pub hb2: Buf,
    pub logits: Buf,
}

// The model's global buffers.
pub copy struct StepModel {
    pub rms_final: Buf,
    pub classifier: Buf,
    pub freqs: Buf,
}

// Words per layer in `tk_step`'s `layers`: (buffer, length) of rms_attention,
// wq, wk, wv, wo, rms_ffn, w1, w2, w3, then the cache's keys and values.
const LAYER_WORDS: u64 = 22;

fn layer_buf(in layers: Slice[u64], l: u64, slot: u64)
    -> Buf eff [Fail[RuntimeError], Fail[ArithOverflow]] {
    let at = l * LAYER_WORDS + slot * 2;
    Buf {
        buffer: layers[at],
        memory: 0,
        ptr: 0,
        len: layers[at + 1]
    }
}

// Records one llama2.c decode step at `shape.position` (`14 * layers + 2`
// dispatches): per layer RMSNorm, the Q/K/V projections, RoPE, the K/V
// write, paged attention, the output projection, RMSNorm and the SwiGLU
// feed-forward; then the final RMSNorm and the classifier into `logits`.
pub fn tk_step(
    in d: Dev,
    inout r: Rec,
    in ks: TensorKs,
    in c: StepShape,
    in s: StepSession,
    in m: StepModel,
    in layers: Slice[u64],
    dry: bool,
) eff [Ffi[Vk], Ffi[LibC], Fail[GpuErr], Fail[RuntimeError], Fail[ArithOverflow]] {
    for l in 0..c.layers {
        let rms_attention = layer_buf(in layers, l, 0);
        let wq = layer_buf(in layers, l, 1);
        let wk = layer_buf(in layers, l, 2);
        let wv = layer_buf(in layers, l, 3);
        let wo = layer_buf(in layers, l, 4);
        let rms_ffn = layer_buf(in layers, l, 5);
        let w1 = layer_buf(in layers, l, 6);
        let w2 = layer_buf(in layers, l, 7);
        let w3 = layer_buf(in layers, l, 8);
        let keys = layer_buf(in layers, l, 9);
        let values = layer_buf(in layers, l, 10);
        tk_rms_norm(
            in d,
            inout r,
            in ks.rms_norm,
            in s.x,
            in rms_attention,
            in s.xb,
            1,
            c.dim,
            c.epsilon,
            dry
        );
        tk_matmul(in d, inout r, in ks.matmul, in s.xb, in wq, in s.q, 1, c.dim, c.dim, false, dry);
        tk_matmul(
            in d,
            inout r,
            in ks.matmul,
            in s.xb,
            in wk,
            in s.k,
            1,
            c.kv_dim,
            c.dim,
            false,
            dry
        );
        tk_matmul(
            in d,
            inout r,
            in ks.matmul,
            in s.xb,
            in wv,
            in s.v,
            1,
            c.kv_dim,
            c.dim,
            false,
            dry
        );
        tk_rope(in d, inout r, in ks.rope, in s.q, in m.freqs, c.dim, c.head_dim, c.position, dry);
        tk_rope(
            in d,
            inout r,
            in ks.rope,
            in s.k,
            in m.freqs,
            c.kv_dim,
            c.head_dim,
            c.position,
            dry
        );
        tk_kv_write(
            in d,
            inout r,
            in ks.kv_write,
            in s.k,
            in s.v,
            in s.table,
            in keys,
            in values,
            c.position,
            c.kv_dim,
            dry
        );
        tk_attention(
            in d,
            inout r,
            in ks.attention,
            in s.q,
            in keys,
            in values,
            in s.table,
            in s.att,
            c.heads,
            c.kv_heads,
            c.head_dim,
            c.position + 1,
            dry
        );
        tk_matmul(in d, inout r, in ks.matmul, in s.att, in wo, in s.x, 1, c.dim, c.dim, true, dry);
        tk_rms_norm(
            in d,
            inout r,
            in ks.rms_norm,
            in s.x,
            in rms_ffn,
            in s.xb,
            1,
            c.dim,
            c.epsilon,
            dry
        );
        tk_matmul(
            in d,
            inout r,
            in ks.matmul,
            in s.xb,
            in w1,
            in s.hb,
            1,
            c.hidden_dim,
            c.dim,
            false,
            dry
        );
        tk_matmul(
            in d,
            inout r,
            in ks.matmul,
            in s.xb,
            in w3,
            in s.hb2,
            1,
            c.hidden_dim,
            c.dim,
            false,
            dry
        );
        tk_swiglu(in d, inout r, in ks.swiglu, in s.hb, in s.hb2, c.hidden_dim, dry);
        tk_matmul(
            in d,
            inout r,
            in ks.matmul,
            in s.hb,
            in w2,
            in s.x,
            1,
            c.dim,
            c.hidden_dim,
            true,
            dry
        );
    }
    tk_rms_norm(
        in d,
        inout r,
        in ks.rms_norm,
        in s.x,
        in m.rms_final,
        in s.xb,
        1,
        c.dim,
        c.epsilon,
        dry
    );
    tk_matmul(
        in d,
        inout r,
        in ks.matmul,
        in s.xb,
        in m.classifier,
        in s.logits,
        1,
        c.vocab,
        c.dim,
        false,
        dry
    );
}
