// @vesper/gpu-compute: the Vulkan compute runtime of crates/vesper-gpu-compute
// (design §28, §36) in Vesper, calling the Vulkan loader and libc directly
// through `.vsys` (SH6 lane 15, #1410). One device and queue, host-visible
// storage buffers, compute pipelines from SPIR-V, recorded dispatches with
// descriptor sets and immediates, and submissions ordered by one timeline
// semaphore.
//
// C memory. Every create-info struct, out array and mapped buffer is C
// memory the package allocates (`calloc`), fills from a Vesper image
// (`memcpy`) and reads back (`bcopy`): see `Scratch`. Vulkan handles and
// addresses are u64 words. They never leave the package except as fields
// of the copy structs below, which the crate's Rust API owns and finalizes
// through `close`, `buffer_free`, `kernel_free` and `rec_free`.
//
// Struct offsets are the Vulkan headers' LP64 layout (x86_64 and AArch64
// Linux, macOS), checked against `offsetof` with the 1.3.275 headers.

// Why a call failed. `kind` is one of `unavailable()` .. `unsupported()`;
// `detail` says which call or check (the crate's error table names them);
// `code` is the VkResult or, for an old instance, its version.
pub copy struct GpuErr {
    pub kind: u32,
    pub detail: u32,
    pub code: i64,
}

pub fn unavailable() -> u32 {
    1
}

pub fn vulkan() -> u32 {
    2
}

pub fn shape() -> u32 {
    3
}

pub fn limit() -> u32 {
    4
}

pub fn unsupported() -> u32 {
    5
}

fn raise[T](kind: u32, detail: u32, code: i64) -> T eff [Fail[GpuErr]] {
    Fail::raise(
        GpuErr {
            kind: kind,
            detail: detail,
            code: code,
        }
    )
}

fn fail(kind: u32, detail: u32, code: i64) eff [Fail[GpuErr]] {
    Fail::raise(
        GpuErr {
            kind: kind,
            detail: detail,
            code: code,
        }
    )
}

// A VkResult below zero is an error of call `call`.
fn check(rc: i32, call: u32) eff [Fail[GpuErr]] {
    if rc < 0 {
        fail(vulkan(), call, widen_i64(rc));
    }
}

// The open device. Field order is the crate's `repr` of it.
pub copy struct Dev {
    pub instance: u64,
    pub physical: u64,
    pub device: u64,
    pub queue: u64,
    pub family: u64,
    pub timeline: u64,
    pub api_version: u64,
    pub device_type: u64,
    pub max_invocations: u64,
    pub max_range: u64,
}

// A host-visible, host-coherent storage buffer, mapped at `ptr` for its
// lifetime; `len` is a multiple of 4.
pub copy struct Buf {
    pub buffer: u64,
    pub memory: u64,
    pub ptr: u64,
    pub len: u64,
}

// A compute pipeline binding `bindings` storage buffers and an immediate
// block of `imm` bytes.
pub copy struct Kern {
    pub set_layout: u64,
    pub layout: u64,
    pub pipeline: u64,
    pub bindings: u64,
    pub imm: u64,
}

// A command buffer being recorded, with the descriptor pools its sets come
// from (`sets_left` in the last one).
pub struct Rec {
    pub pool: u64,
    pub cmd: u64,
    pub sets_left: u64,
    pub pools: ChunkSeq[u64],
}

