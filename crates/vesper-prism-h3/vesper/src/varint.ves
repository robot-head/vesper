// QUIC variable-length integers (RFC 9000 §16), as vesper_warp::varint
// decodes and encodes them for frame.rs and capsule.rs.

use self::int::{
    inc,
    byte,
    shl,
    shr
};
use self::prefix::{
    Num,
    max_int
};

// QUIC variable-length integers (RFC 9000 §16): the top two bits of the
// first byte give the length (1, 2, 4 or 8 bytes), the rest is the value.
const VI_PREFIX_SHIFT: u64 = 6;
const VI_VALUE_MASK: u64 = 0x3f;
const VI1_LIMIT: u64 = 64;
const VI2_LIMIT: u64 = 16384;
const VI4_LIMIT: u64 = 1073741824;
const VI2_PREFIX: u64 = 0x40;
const VI4_PREFIX: u64 = 0x80;
const VI8_PREFIX: u64 = 0xc0;

// The varint at `buf[at]`, or `None` if the buffer ends inside it.
pub fn vdec(in buf: Slice[u8], at: u64) -> Option[Num] {
    if at >= buf.len() {
        return Option::None;
    }
    let first = widen_u64(byte(in buf, at));
    let len = shl(1, shr(first, VI_PREFIX_SHIFT));
    if wrapping_sub(buf.len(), at) < len {
        return Option::None;
    }
    let mut v = first & VI_VALUE_MASK;
    let base = inc(at);
    for k in 0..wrapping_sub(len, 1) {
        v = shl(v, 8) | widen_u64(byte(in buf, wrapping_add(base, k)));
    }
    Option::Some(
        Num {
            value: v,
            used: len
        }
    )
}

// Appends `v` in its shortest form; false (nothing written) above 2^62 - 1.
pub fn vput(inout out: ChunkSeq[u8], v: u64) -> bool {
    if v < VI1_LIMIT {
        out.push(wrapping_u8(v));
    } else if v < VI2_LIMIT {
        out.push(wrapping_u8(shr(v, 8) | VI2_PREFIX));
        out.push(wrapping_u8(v));
    } else if v < VI4_LIMIT {
        out.push(wrapping_u8(shr(v, 24) | VI4_PREFIX));
        out.push(wrapping_u8(shr(v, 16)));
        out.push(wrapping_u8(shr(v, 8)));
        out.push(wrapping_u8(v));
    } else if v <= max_int() {
        out.push(wrapping_u8(shr(v, 56) | VI8_PREFIX));
        out.push(wrapping_u8(shr(v, 48)));
        out.push(wrapping_u8(shr(v, 40)));
        out.push(wrapping_u8(shr(v, 32)));
        out.push(wrapping_u8(shr(v, 24)));
        out.push(wrapping_u8(shr(v, 16)));
        out.push(wrapping_u8(shr(v, 8)));
        out.push(wrapping_u8(v));
    } else {
        return false;
    }
    true
}

// A frame or capsule: type, length, payload (`write_frame`).
pub fn put_record(inout out: ChunkSeq[u8], ty: u64, in payload: Slice[u8]) -> bool {
    let a = vput(inout out, ty);
    let b = vput(inout out, payload.len());
    out.extend(in payload);
    a && b
}

test {
    // Expected bytes are packed in the low bits, with the first byte lowest.
    // @case zero(0, 1, 0)
    // @case last_single_byte(63, 1, 0x3f)
    // @case first_two_bytes(64, 2, 0x4040)
    // @case last_two_bytes(16383, 2, 0xff7f)
    // @case first_four_bytes(16384, 4, 0x00400080)
    // @case last_four_bytes(1073741823, 4, 0xffffffbf)
    // @case first_eight_bytes(1073741824, 8, 0x00000040000000c0)
    // @case largest(4611686018427387903, 8, 0xffffffffffffffff)
    // @case overflow(4611686018427387904, 0, 0)
    fn test_varint_shortest(value: u64, width: u64, packed: u64) -> bool {
        let mut out = ChunkSeq::new[u8]();
        out.push(90);
        let written = vput(inout out, value);
        let prefix_unchanged = out.try_get(0) == Option::Some(90);
        if out.len() != wrapping_add(width, 1) || !prefix_unchanged || written != (width != 0) {
            return false;
        }
        for i in 0..width {
            let expected = wrapping_u8(wrapping_shr_u64(packed, wrapping_u32(i << 3)));
            if out.try_get(wrapping_add(i, 1)) != Option::Some(expected) {
                return false;
            }
        }
        match vdec(in out.as_slice(), 1) {
            Option::Some(number) => width != 0 && number.value == value && number.used == width,
            Option::None => width == 0,
        }
    }

    // @case empty_buffer(0, 0, 0, 0, 0)
    // @case long_encoding_is_accepted(0x0140, 2, 0, 1, 2)
    // @case truncated_two_byte(0x40, 1, 0, 0, 0)
    // @case truncated_four_byte(0x4080, 2, 0, 0, 0)
    // @case truncated_eight_byte(0x40c0, 2, 0, 0, 0)
    // @case valid_after_prefix(0x01405a, 3, 1, 1, 2)
    // @case huge_offset(0x0140, 2, 18446744073709551615, 0, 0)
    fn test_varint_reads(packed: u64, length: u64, offset: u64, value: u64, used: u64) -> bool {
        let mut input = ChunkSeq::new[u8]();
        for i in 0..length {
            input.push(wrapping_u8(wrapping_shr_u64(packed, wrapping_u32(i << 3))));
        }
        match vdec(in input.as_slice(), offset) {
            Option::Some(number) => used != 0 && number.value == value && number.used == used,
            Option::None => used == 0,
        }
    }

    // @case no_payload(0, in "", 1)
    // @case short_type(63, in "abc", 1)
    // @case longer_type(64, in "abc", 2)
    // @case largest_type(4611686018427387903, in "x", 8)
    fn test_record_layout(kind: u64, in payload: Str, type_width: u64) -> bool {
        let mut out = ChunkSeq::new[u8]();
        if !put_record(inout out, kind, in payload.as_bytes()) {
            return false;
        }
        match (vdec(in out.as_slice(), 0), vdec(in out.as_slice(), type_width)) {
            (Option::Some(ty), Option::Some(size)) => {
                let size_matches = size.value == payload.len() && size.used == 1;
                if ty.value != kind || ty.used != type_width || !size_matches {
                    return false;
                }
                let start = wrapping_add(type_width, size.used);
                if out.len() != wrapping_add(start, payload.len()) {
                    return false;
                }
                for i in 0..payload.len() {
                    if out.try_get(wrapping_add(start, i)) != payload.try_byte_at(i) {
                        return false;
                    }
                }
                true
            },
            _ => false,
        }
    }

    // @case empty(in "")
    // @case nonempty(in "x")
    fn test_record_rejects_out_of_range_type(in payload: Str) -> bool {
        let mut out = ChunkSeq::new[u8]();
        !put_record(inout out, 4611686018427387904, in payload.as_bytes())
    }
}
