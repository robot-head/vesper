// `impl From<prefix::PrefixError> for Reason` (qpack/mod.rs).

use self::{
    PrefixError,
    Reason
};

pub fn reason_of(e: PrefixError) -> Reason {
    match e {
        PrefixError::Incomplete => Reason::Truncated,
        PrefixError::IntegerOverflow => Reason::IntegerOverflow,
        PrefixError::StringTooLong => Reason::StringTooLong,
        PrefixError::Huffman(h) => Reason::Huffman(h),
    }
}
