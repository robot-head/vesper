// qpack/huffman.rs: the HPACK Huffman code (RFC 7541 Appendix B, RFC 9204
// §4.1.2), decoded canonically one bit at a time from the code lengths, with
// the RFC 7541 §5.2 padding and EOS rules.

use self::table::{
    static_new
};
use self::{
    HuffmanError,
    Huff
};
use self::int::{
    inc,
    word,
    byte,
    div_ceil,
    bit,
    shl,
    shr
};
use self::huffman_codes::{
    huffman_codes
};

// A code word (huffman_codes): `bit length << CODE_LEN_SHIFT | code`.
const CODE_LEN_SHIFT: u64 = 32;
const CODE_MASK: u64 = 0xffffffff;
// The trie's internal nodes (the code is complete) and the EOS symbol
// (RFC 7541 Appendix B); a leaf child holds `leaf() | symbol`.
const INTERNAL_NODES: u64 = 256;
const EOS_SYMBOL: u64 = 256;
const SYMBOL_MASK: u64 = 0x1ff;
// The nibble table: 16 entries per node, each the next node in the low 16
// bits and a decoded symbol above them.
const NIBBLE_BITS: u64 = 4;
const NIBBLES: u64 = 16;
const NIBBLE_MASK: u64 = 0x0f;
const NIB_NODE_MASK: u64 = 0xffff;
const NIB_SYMBOL_SHIFT: u64 = 16;
// `info[node]`: the depth in the low 8 bits and bit 8 when those bits are
// all ones; RFC 7541 §5.2 allows at most 7 bits of such padding.
const INFO_DEPTH_MASK: u64 = 0xff;
const INFO_ALL_ONES: u64 = 0x100;
const MAX_PADDING_BITS: u64 = 7;

fn symbol_count() -> u64 {
    257
}

fn zeros(n: u64) -> ChunkSeq[u64] {
    let mut s = ChunkSeq::with_capacity[u64](n);
    for i in 0..n {
        s.push(0);
    }
    s
}

// A trie child that is a leaf: this flag and the symbol.
fn leaf() -> u64 {
    1048576
}

// Nibble-table entry flags: a symbol was decoded, or EOS was reached.
fn emitted() -> u64 {
    4294967296
}

fn eos_seen() -> u64 {
    8589934592
}

// The decoding tables. The code's binary trie has 256 internal nodes (the
// code is complete, RFC 7541 Appendix B); `child[2 * node + bit]` is a node
// index, `leaf() | symbol`, or 0 while unbuilt (the root is never a child).
// `nib[16 * node + nibble]` is where four more bits lead from `node`: the
// next node, the symbol decoded on the way (`emitted()`, at most one, as
// every code is at least 5 bits long) or `eos_seen()`. `info[node]` is the
// node's depth (bits since the last symbol) and, in bit 8, whether those
// bits are all ones (the EOS prefix, valid padding).
pub fn huff_tables() -> Huff {
    let codes = huffman_codes();
    let mut child = zeros(2);
    let mut info = ChunkSeq::with_capacity[u64](INTERNAL_NODES);
    info.push(INFO_ALL_ONES);
    let mut nodes: u64 = 1;
    for s in 0..symbol_count() {
        let e = word(in codes.as_slice(), s);
        let len = shr(e, CODE_LEN_SHIFT);
        let code = e & CODE_MASK;
        let mut node: u64 = 0;
        for k in 0..len {
            let b = shr(code, wrapping_sub(wrapping_sub(len, 1), k)) & 1;
            let slot = wrapping_add(wrapping_mul(node, 2), b);
            if inc(k) == len {
                let _set = child.try_set(slot, leaf() | s);
            } else {
                let mut c = word(in child.as_slice(), slot);
                if c == 0 {
                    c = nodes;
                    nodes = inc(nodes);
                    child.push(0);
                    child.push(0);
                    let _set = child.try_set(slot, c);
                    let up = word(in info.as_slice(), node);
                    let ones = if b == 1 {
                        up & INFO_ALL_ONES
                    } else {
                        0
                    };
                    info.push(inc(up & INFO_DEPTH_MASK) | ones);
                }
                node = c;
            }
        }
    }
    let mut nib = ChunkSeq::with_capacity[u64](wrapping_mul(nodes, NIBBLES));
    for node_at in 0..nodes {
        for n in 0..NIBBLES {
            nib.push(walk(in child, node_at, n));
        }
    }
    Huff {
        codes: codes,
        nib: nib,
        info: info,
        st: static_new()
    }
}

fn walk(in child: ChunkSeq[u64], node_at: u64, nibble: u64) -> u64 {
    let mut node = node_at;
    let mut out: u64 = 0;
    for k in 0..4 {
        let b = shr(nibble, wrapping_u64(wrapping_sub(3, k))) & 1;
        let c = word(in child.as_slice(), wrapping_add(wrapping_mul(node, 2), b));
        if c & leaf() != 0 {
            let sym = c & SYMBOL_MASK;
            if sym == EOS_SYMBOL {
                return eos_seen();
            }
            out = emitted() | shl(sym, NIB_SYMBOL_SHIFT);
            node = 0;
        } else {
            node = c;
        }
    }
    out | node
}

// Encoded length in bytes, padding included.
pub fn huff_encoded_len(in h: Huff, in data: Slice[u8]) -> u64 {
    let mut bits: u64 = 0;
    for i in 0..data.len() {
        let e = word(in h.codes.as_slice(), widen_u64(byte(in data, i)));
        bits = wrapping_add(bits, shr(e, CODE_LEN_SHIFT));
    }
    div_ceil(bits, 8)
}

// Appends the Huffman encoding of `data` to `out`, padded with the EOS
// prefix (all ones).
pub fn huff_encode(in h: Huff, in data: Slice[u8], inout out: ChunkSeq[u8]) {
    let mut acc: u64 = 0;
    let mut nbits: u64 = 0;
    for i in 0..data.len() {
        let e = word(in h.codes.as_slice(), widen_u64(byte(in data, i)));
        let len = shr(e, CODE_LEN_SHIFT);
        acc = shl(acc, len) | (e & CODE_MASK);
        nbits = wrapping_add(nbits, len);
        loop {
            if nbits < 8 {
                break;
            }
            nbits = wrapping_sub(nbits, 8);
            out.push(wrapping_u8(shr(acc, nbits)));
        }
        acc = acc & wrapping_sub(bit(nbits), 1);
    }
    if nbits > 0 {
        let pad = wrapping_sub(8, nbits);
        out.push(wrapping_u8(shl(acc, pad) | wrapping_sub(bit(pad), 1)));
    }
}

// Appends the decoding of `data` to `out`, refusing more than `max_len`
// bytes of output (`TooLong`) before it is produced: four bits per step
// through the nibble table, with the RFC 7541 §5.2 padding and EOS rules
// (the same results as decoding one bit at a time).
pub fn huff_decode(in h: Huff, in data: Slice[u8], max_len: u64, inout out: ChunkSeq[u8])
    -> Option[HuffmanError] {
    let mut node_at: u64 = 0;
    let mut produced: u64 = 0;
    for i in 0..data.len() {
        let b = widen_u64(byte(in data, i));
        let hi = word(
            in h.nib.as_slice(),
            wrapping_add(wrapping_mul(node_at, NIBBLES), shr(b, NIBBLE_BITS))
        );
        if hi & eos_seen() != 0 {
            return Option::Some(HuffmanError::Eos);
        }
        if hi & emitted() != 0 {
            if produced == max_len {
                return Option::Some(HuffmanError::TooLong);
            }
            out.push(wrapping_u8(shr(hi, NIB_SYMBOL_SHIFT)));
            produced = inc(produced);
        }
        let lo = word(
            in h.nib.as_slice(),
            wrapping_add(wrapping_mul(hi & NIB_NODE_MASK, NIBBLES), b & NIBBLE_MASK)
        );
        if lo & eos_seen() != 0 {
            return Option::Some(HuffmanError::Eos);
        }
        if lo & emitted() != 0 {
            if produced == max_len {
                return Option::Some(HuffmanError::TooLong);
            }
            out.push(wrapping_u8(shr(lo, NIB_SYMBOL_SHIFT)));
            produced = inc(produced);
        }
        node_at = lo & NIB_NODE_MASK;
    }
    let info = word(in h.info.as_slice(), node_at);
    if info & INFO_DEPTH_MASK > MAX_PADDING_BITS || info & INFO_ALL_ONES == 0 {
        return Option::Some(HuffmanError::BadPadding);
    }
    Option::None
}
