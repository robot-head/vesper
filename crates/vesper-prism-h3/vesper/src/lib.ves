    client_handle_goaway(inout c);
}

pub fn client_core_drain_unblocked(inout c: ClientCore, inout dec: DecoderCore, in h: Huff)
    -> Result[Unit, ConnectionError] {
    client_drain_unblocked(inout c, inout dec, in h)
}

pub fn client_core_can_read_stream(in c: ClientCore, id: u64) -> bool {
    client_can_read_stream(in c, id)
}

pub fn client_core_stream_reset(inout c: ClientCore, inout dec: DecoderCore, id: u64, code: u64) {
    client_stream_reset(inout c, inout dec, id, code);
}

pub fn client_core_stream_data(
    inout c: ClientCore,
    inout dec: DecoderCore,
    in h: Huff,
    id: u64,
    in bytes: Slice[u8],
    fin: bool
) -> Result[Unit, ConnectionError] {
    client_stream_data(inout c, inout dec, in h, id, in bytes, fin)
}

pub fn client_core_on_quic_datagram(inout c: ClientCore, in bytes: Slice[u8])
    -> Result[Unit, ConnectionError] {
    on_quic_datagram(
        inout c.conn.sess,
        inout c.conn.pool,
        inout c.conn.sev,
        c.conn.sent_settings,
        in bytes
    )
}

pub fn client_core_fail(inout c: ClientCore, e: ConnectionError) {
    core_fail(inout c.conn, e);
}

pub fn client_core_flush_begin(inout c: ClientCore, inout enc: EncoderCore, inout dec: DecoderCore)
    -> FlushStep {
    core_flush_begin(inout c.conn, inout enc, inout dec)
}

pub fn client_core_flush_step(inout c: ClientCore, status: u64, wrote: u64, err_code: u64)
    -> FlushStep {
    core_flush_step(inout c.conn, status, wrote, err_code)
}

pub fn client_core_clear_cmds(inout c: ClientCore) {
    cmd_clear(inout c.conn.cmd);
}

pub fn client_core_clear_events(inout c: ClientCore) {
    sev_clear(inout c.conn.sev);
    hev_clear(inout c.conn.hev);
}

pub fn client_core_wt_can_open(in c: ClientCore, session: u64) -> Result[Unit, SessionError] {
    wt_can_open(in c.conn.sess, c.conn.error, session)
}

pub fn client_core_wt_register_opened(inout c: ClientCore, id: u64, session: u64, bidi: bool) {
    wt_register_opened(inout c.conn.sess, inout c.conn.pool, inout c.conn.out, id, session, bidi);
}

pub fn client_core_send_datagram_prepare(
    inout c: ClientCore,
    max_dgram: Option[u64],
    session: u64,
    in payload: Slice[u8]
) -> Result[DgramSendPlan, SessionError] {
    send_datagram_prepare(
        inout c.conn.sess,
        inout c.conn.pool,
        inout c.conn.out,
        inout c.conn.scratch,
        c.conn.error,
        c.conn.sent_settings,
        c.conn.peer_settings,
        max_dgram,
        c.conn.cfg.max_frame_payload,
        c.conn.cfg.max_stream_buffer,
        session,
        in payload
    )
}

pub fn client_core_on_quic_datagram_sent(inout c: ClientCore) {
    c.conn.sess.stats.datagrams_sent = inc(c.conn.sess.stats.datagrams_sent);
}

pub fn client_core_wt_can_write(in c: ClientCore, id: u64) -> Result[bool, SessionError] {
    wt_can_write(in c.conn.sess, in c.conn.out, in c.conn.pool, id)
}

pub fn client_core_wt_on_write_reset(inout c: ClientCore, id: u64, code: u64)
    -> Result[u64, SessionError] {
    wt_on_write_reset(inout c.conn.sess, in c.conn.pool, id, code)
}

pub fn client_core_wt_finish(inout c: ClientCore, id: u64) -> Result[bool, SessionError] {
    wt_finish_prepare(inout c.conn.sess, in c.conn.pool, inout c.conn.out, id)
}

pub fn client_core_wt_read_pre(inout c: ClientCore, id: u64, max_n: u64)
    -> Result[WtReadPre, SessionError] {
    wt_read_pre(inout c.conn.sess, inout c.conn.pool, inout c.conn.scratch, id, max_n)
}

pub fn client_core_wt_on_read_fin(inout c: ClientCore, id: u64) -> bool {
    wt_on_read_fin(inout c.conn.sess, in c.conn.pool, id)
}

pub fn client_core_wt_reset(inout c: ClientCore, id: u64, code: u32) -> Result[Unit, SessionError] {
    wt_reset(inout c.conn.sess, inout c.conn.pool, inout c.conn.out, inout c.conn.cmd, id, code)
}

pub fn client_core_wt_stop_sending(inout c: ClientCore, id: u64, code: u32)
    -> Result[Unit, SessionError] {
    wt_stop_sending(inout c.conn.sess, inout c.conn.pool, inout c.conn.cmd, id, code)
}
