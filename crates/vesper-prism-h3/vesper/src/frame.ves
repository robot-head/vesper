// frame.rs: HTTP/3 frames (RFC 9114 §7), SETTINGS (§7.2.4) and the
// incremental frame reader. The reader keeps unread bytes in `buf` from
// `head` on and compacts when bytes are pushed, so a frame is never moved
// twice; a DATA chunk or a HEADERS payload is copied into `out`, which the
// Rust wrapper reads after each call.

use self::{
    Settings,
    FrameError,
    FrameOut,
    FrameReaderCore
};
use self::int::{
    inc,
    min64,
    max64,
    word,
    drain_front
};
use self::varint::{
    vdec,
    vput,
    put_record
};
use self::priority::{
    priority_update_request,
    priority_update_push,
    priority_update_parse
};

// SETTINGS identifiers (RFC 9114 §7.2.4.1, RFC 9204 §5, RFC 9220 §3,
// RFC 9297 §2.1.1, RFC 9218 §2.1 and the WebTransport drafts; src/frame.rs).
enum Setting: u64 {
    QpackMaxTableCapacity = 0x01,
    MaxFieldSectionSize = 0x06,
    QpackBlockedStreams = 0x07,
    EnableConnectProtocol = 0x08,
    NoRfc7540Priorities = 0x09,
    H3Datagram = 0x33,
    EnableWebtransport = 0x2b603742,
    WebtransportMaxSessionsDraft07 = 0xc671706a,
    WtMaxSessions = 0x14e9cd29,
    // A reserved setting (0x1f * 7 + 0x21) sent as grease (§7.2.4.1).
    Grease = 0xfa,
}
// HTTP/2 frame types with no HTTP/3 meaning (§7.2.8, §11.2.1).
enum H2Frame: u64 {
    Priority = 0x02,
    Ping = 0x06,
    WindowUpdate = 0x08,
    Continuation = 0x09,
}
// HTTP/2 settings that must not appear (§7.2.4.1, §11.2.2): 0x00 and
// SETTINGS_ENABLE_PUSH (0x02) through SETTINGS_MAX_FRAME_SIZE (0x05).
enum H2Setting: u64 {
    Reserved = 0x00,
    EnablePush = 0x02,
    MaxFrameSize = 0x05,
}
// FrameReader modes.
enum Mode: u64 {
    Header = 0,
    Data = 1,
    Skip = 2,
    Payload = 3,
    Opaque = 4,
}

fn data_type() -> u64 {
    0
}

fn headers_type() -> u64 {
    1
}

fn cancel_push_type() -> u64 {
    3
}

fn settings_type() -> u64 {
    4
}

fn push_promise_type() -> u64 {
    5
}

fn goaway_type() -> u64 {
    7
}

fn max_push_id_type() -> u64 {
    13
}

fn webtransport_stream_type() -> u64 {
    65
}

fn is_http2_frame(ty: u64) -> bool {
    ty == H2Frame::Priority
        || ty == H2Frame::Ping
        || ty == H2Frame::WindowUpdate
        || ty == H2Frame::Continuation
}

fn is_http2_setting(id: u64) -> bool {
    id == H2Setting::Reserved || (id >= H2Setting::EnablePush && id <= H2Setting::MaxFrameSize)
}

pub fn settings_default() -> Settings {
    Settings {
        qpack_max_table_capacity: 0,
        qpack_blocked_streams: 0,
        max_field_section_size: Option::None,
        enable_connect_protocol: false,
        h3_datagram: false,
        webtransport_max_sessions: Option::None,
        no_rfc7540_priorities: false
    }
}

fn flag(id: u64, v: u64) -> Result[bool, FrameError] {
    if v == 0 {
        Result::Ok(false)
    } else if v == 1 {
        Result::Ok(true)
    } else {
        Result::Err(FrameError::BadSetting(id))
    }
}

fn sessions_at_least(s: Option[u64], v: u64) -> Option[u64] {
    match s {
        Option::Some(n) => Option::Some(max64(n, v)),
        Option::None => Option::Some(v),
    }
}

fn contains(in s: Slice[u64], v: u64) -> bool {
    for i in 0..s.len() {
        if word(in s, i) == v {
            return true;
        }
    }
    false
}

// `Settings::parse`.
pub fn settings_parse(in p: Slice[u8]) -> Result[Settings, FrameError] {
    let mut s = settings_default();
    let mut seen = ChunkSeq::new[u64]();
    let mut at: u64 = 0;
    loop {
        if at >= p.len() {
            return Result::Ok(s);
        }
        let id = match vdec(in p, at) {
            Option::Some(n) => {
                at = wrapping_add(at, n.used);
                n.value
            }
            Option::None => return Result::Err(FrameError::Malformed),
        };
        let value = match vdec(in p, at) {
            Option::Some(n) => {
                at = wrapping_add(at, n.used);
                n.value
            }
            Option::None => return Result::Err(FrameError::Malformed),
        };
        if is_http2_setting(id) || contains(in seen.as_slice(), id) {
            return Result::Err(FrameError::BadSetting(id));
        }
        seen.push(id);
        if id == Setting::QpackMaxTableCapacity {
            s.qpack_max_table_capacity = value;
        } else if id == Setting::QpackBlockedStreams {
            s.qpack_blocked_streams = value;
        } else if id == Setting::MaxFieldSectionSize {
            s.max_field_section_size = Option::Some(value);
        } else if id == Setting::EnableConnectProtocol
            || id == Setting::H3Datagram
            || id == Setting::NoRfc7540Priorities
            || id == Setting::EnableWebtransport {
            let f = match flag(id, value) {
                Result::Ok(f) => f,
                Result::Err(e) => return Result::Err(e),
            };
            if id == Setting::EnableConnectProtocol {
                s.enable_connect_protocol = f;
            } else if id == Setting::H3Datagram {
                s.h3_datagram = f;
            } else if id == Setting::NoRfc7540Priorities {
                s.no_rfc7540_priorities = f;
            } else if f {
                s.webtransport_max_sessions = sessions_at_least(s.webtransport_max_sessions, 1);
            }
        } else if (id == Setting::WebtransportMaxSessionsDraft07 || id == Setting::WtMaxSessions)
            && value > 0 {
            s.webtransport_max_sessions = sessions_at_least(s.webtransport_max_sessions, value);
        }
    }
}

fn put_setting(inout out: ChunkSeq[u8], id: u64, value: Option[u64]) -> bool {
    match value {
        Option::Some(v) => {
            let a = vput(inout out, id);
            let b = vput(inout out, v);
            a && b
        }
        Option::None => true,
    }
}

fn on(b: bool) -> Option[u64] {
    let one: u64 = 1;
    if b {
        Option::Some(one)
    } else {
        Option::None
    }
}

// `Settings::encode`: the SETTINGS frame, with one reserved identifier as
// grease (§7.2.4.1).
pub fn settings_write(s: Settings, inout out: ChunkSeq[u8]) -> bool {
    let mut p = ChunkSeq::new[u8]();
    let mut ok = put_setting(
        inout p,
        Setting::QpackMaxTableCapacity,
        Option::Some(s.qpack_max_table_capacity)
    );
    ok = put_setting(inout p, Setting::QpackBlockedStreams, Option::Some(s.qpack_blocked_streams))
        && ok;
    ok = put_setting(inout p, Setting::MaxFieldSectionSize, s.max_field_section_size) && ok;
    ok = put_setting(inout p, Setting::EnableConnectProtocol, on(s.enable_connect_protocol)) && ok;
    ok = put_setting(inout p, Setting::H3Datagram, on(s.h3_datagram)) && ok;
    ok = put_setting(inout p, Setting::NoRfc7540Priorities, on(s.no_rfc7540_priorities)) && ok;
    let wt = match s.webtransport_max_sessions {
        Option::Some(_n) => on(true),
        Option::None => Option::None,
    };
    ok = put_setting(inout p, Setting::EnableWebtransport, wt) && ok;
    ok = put_setting(inout p, Setting::WebtransportMaxSessionsDraft07, s.webtransport_max_sessions)
        && ok;
    ok = put_setting(inout p, Setting::WtMaxSessions, s.webtransport_max_sessions) && ok;
    ok = put_setting(
        inout p,
        Setting::Grease,
        Option::Some(wrapping_sub(Setting::Grease, Setting::Grease))
    )
        && ok;
    put_record(inout out, settings_type(), in p.as_slice()) && ok
}

// ---------------------------------------------------------------------
// FrameReader (modes: 0 header, 1 DATA, 2 skip, 3 payload, 4 opaque)
// ---------------------------------------------------------------------

pub fn reader_new(max_payload: u64, webtransport: bool) -> FrameReaderCore {
    FrameReaderCore {
        buf: ChunkSeq::new[u8](),
        head: 0,
        mode: Mode::Header,
        remaining: 0,
        ty: 0,
        len: 0,
        max_payload: max_payload,
        webtransport: webtransport,
        out: ChunkSeq::new[u8]()
    }
}

pub fn reader_push(inout r: FrameReaderCore, in bytes: Slice[u8]) {
    if r.head > 0 {
        drain_front(inout r.buf, r.head);
        r.head = 0;
    }
    r.buf.extend(in bytes);
}

pub fn reader_buffered(in r: FrameReaderCore) -> u64 {
    wrapping_sub(r.buf.len(), r.head)
}

pub fn reader_at_boundary(in r: FrameReaderCore) -> bool {
    r.mode == Mode::Header && r.head >= r.buf.len()
}

// `take_rest`: the unread bytes, moved to `out`.
pub fn reader_take_rest(inout r: FrameReaderCore) {
    r.out.clear();
    let n = r.buf.len();
    r.out.extend(in r.buf[r.head..n]);
    r.buf.clear();
    r.head = 0;
}

fn single_varint(in p: Slice[u8]) -> Result[u64, FrameError] {
    match vdec(in p, 0) {
        Option::Some(n) => {
            if n.used == p.len() {
                Result::Ok(n.value)
            } else {
                Result::Err(FrameError::Malformed)
            }
        }
        Option::None => Result::Err(FrameError::Malformed),
    }
}

fn buffered_type(ty: u64) -> bool {
    ty == headers_type()
        || ty == settings_type()
        || ty == goaway_type()
        || ty == cancel_push_type()
        || ty == max_push_id_type()
        || ty == push_promise_type()
        || ty == priority_update_request()
        || ty == priority_update_push()
}

fn parse_payload(ty: u64, in p: Slice[u8], inout out: ChunkSeq[u8])
    -> Result[FrameOut, FrameError] {
    if ty == headers_type() {
        out.extend(in p);
        return Result::Ok(FrameOut::Headers);
    }
    if ty == settings_type() {
        return match settings_parse(in p) {
            Result::Ok(s) => Result::Ok(FrameOut::SettingsFrame(s)),
            Result::Err(e) => Result::Err(e),
        };
    }
    if ty == push_promise_type() {
        return Result::Ok(FrameOut::PushPromise);
    }
    if ty == priority_update_request() || ty == priority_update_push() {
        return match priority_update_parse(ty, in p) {
            Result::Ok(u) => Result::Ok(FrameOut::PriorityUpdateFrame(u)),
            Result::Err(e) => Result::Err(e),
        };
    }
    let v = match single_varint(in p) {
        Result::Ok(v) => v,
        Result::Err(e) => return Result::Err(e),
    };
    if ty == goaway_type() {
        Result::Ok(FrameOut::GoAway(v))
    } else if ty == cancel_push_type() {
        Result::Ok(FrameOut::CancelPush(v))
    } else {
        Result::Ok(FrameOut::MaxPushId(v))
    }
}

// `next_frame`: `FrameOut::None` until more bytes arrive.
pub fn reader_next(inout r: FrameReaderCore) -> Result[FrameOut, FrameError] {
    r.out.clear();
    loop {
        let avail = wrapping_sub(r.buf.len(), r.head);
        if r.mode == Mode::Header {
            let t = match vdec(in r.buf.as_slice(), r.head) {
                Option::Some(n) => n,
                Option::None => return Result::Ok(FrameOut::None),
            };
            let l = match vdec(in r.buf.as_slice(), wrapping_add(r.head, t.used)) {
                Option::Some(n) => n,
                Option::None => return Result::Ok(FrameOut::None),
            };
            r.head = wrapping_add(r.head, wrapping_add(t.used, l.used));
            let ty = t.value;
            let len = l.value;
            if is_http2_frame(ty) {
                return Result::Err(FrameError::Http2Frame(ty));
            }
            if ty == webtransport_stream_type() && r.webtransport {
                r.mode = Mode::Opaque;
                return Result::Ok(FrameOut::WebTransportStream(len));
            }
            if ty == data_type() {
                if len == 0 {
                    return Result::Ok(FrameOut::Data);
                }
                r.mode = Mode::Data;
                r.remaining = len;
            } else if buffered_type(ty) {
                if len > r.max_payload {
                    return Result::Err(
                        FrameError::TooLarge {
                            frame_type: ty,
                            len: len
                        }
                    );
                }
                r.mode = Mode::Payload;
                r.ty = ty;
                r.len = len;
            } else {
                r.mode = Mode::Skip;
                r.remaining = len;
                return Result::Ok(FrameOut::Unknown(ty));
            }
        } else if r.mode == Mode::Data {
            if avail == 0 {
                return Result::Ok(FrameOut::None);
            }
            let n = min64(r.remaining, avail);
            let lo = r.head;
            let hi = wrapping_add(lo, n);
            r.out.extend(in r.buf[lo..hi]);
            r.head = hi;
            r.remaining = wrapping_sub(r.remaining, n);
            if r.remaining == 0 {
                r.mode = Mode::Header;
            }
            return Result::Ok(FrameOut::Data);
        } else if r.mode == Mode::Skip {
            let n = min64(r.remaining, avail);
            r.head = wrapping_add(r.head, n);
            r.remaining = wrapping_sub(r.remaining, n);
            if r.remaining > 0 {
                return Result::Ok(FrameOut::None);
            }
            r.mode = Mode::Header;
        } else if r.mode == Mode::Payload {
            if avail < r.len {
                return Result::Ok(FrameOut::None);
            }
            let lo = r.head;
            let hi = wrapping_add(lo, r.len);
            r.head = hi;
            r.mode = Mode::Header;
            return parse_payload(r.ty, in r.buf[lo..hi], inout r.out);
        } else {
            return Result::Err(FrameError::Malformed);
        }
    }
}
