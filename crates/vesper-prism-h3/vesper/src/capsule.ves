// capsule.rs: the Capsule protocol (RFC 9297 §3) and the incremental
// capsule reader, laid out like the frame reader (frame.ves): unread bytes
// from `head` on, a value copied into `out` for the Rust wrapper.

use self::{
    CapsuleError,
    CapsuleOut,
    CapsuleReaderCore
};
use self::int::{
    inc,
    byte,
    min64,
    drain_front
};
use self::varint::{
    vdec,
    put_record
};

// CLOSE_WEBTRANSPORT_SESSION: a 32-bit application error code, then the
// UTF-8 reason.
const CLOSE_CODE_LEN: u64 = 4;
// CapsuleReader modes.
const MODE_HEADER: u64 = 0;
const MODE_SKIP: u64 = 2;
const MODE_VALUE: u64 = 3;
// Well-formed UTF-8 (Unicode Table 3-7, RFC 3629 §4): continuation bytes,
// the lead-byte ranges of 2-, 3- and 4-byte sequences, and the narrower
// second-byte ranges after E0 (no overlong forms), ED (no surrogates), F0
// (no overlong forms) and F4 (nothing above U+10FFFF).
const UTF8_CONT_LO: u8 = 0x80;
const UTF8_CONT_HI: u8 = 0xbf;
const UTF8_LEAD2_LO: u8 = 0xc2;
const UTF8_LEAD2_HI: u8 = 0xdf;
const UTF8_LEAD3_LO: u8 = 0xe0;
const UTF8_LEAD3_HI: u8 = 0xef;
const UTF8_E0_SECOND_LO: u8 = 0xa0;
const UTF8_SURROGATE_LEAD: u8 = 0xed;
const UTF8_ED_SECOND_HI: u8 = 0x9f;
const UTF8_LEAD4_LO: u8 = 0xf0;
const UTF8_LEAD4_HI: u8 = 0xf4;
const UTF8_F0_SECOND_LO: u8 = 0x90;
const UTF8_F4_SECOND_HI: u8 = 0x8f;

fn datagram_type() -> u64 {
    0
}

fn close_type() -> u64 {
    10307
}

fn drain_type() -> u64 {
    30894
}

pub fn max_close_reason() -> u64 {
    1024
}

pub fn capsule_reader_new(max_value: u64) -> CapsuleReaderCore {
    CapsuleReaderCore {
        buf: ChunkSeq::new[u8](),
        head: 0,
        mode: MODE_HEADER,
        remaining: 0,
        ty: 0,
        len: 0,
        max_value: max_value,
        out: ChunkSeq::new[u8]()
    }
}

pub fn capsule_push(inout r: CapsuleReaderCore, in bytes: Slice[u8]) {
    if r.head > 0 {
        drain_front(inout r.buf, r.head);
        r.head = 0;
    }
    r.buf.extend(in bytes);
}

pub fn capsule_buffered(in r: CapsuleReaderCore) -> u64 {
    wrapping_sub(r.buf.len(), r.head)
}

pub fn capsule_at_boundary(in r: CapsuleReaderCore) -> bool {
    r.mode == MODE_HEADER && r.head >= r.buf.len()
}

fn cont(in s: Slice[u8], i: u64) -> bool {
    let c = byte(in s, i);
    i < s.len() && c >= UTF8_CONT_LO && c <= UTF8_CONT_HI
}

fn in_range(in s: Slice[u8], i: u64, lo: u8, hi: u8) -> bool {
    let c = byte(in s, i);
    i < s.len() && c >= lo && c <= hi
}

// UTF-8 as `std::str::from_utf8` accepts it: no overlong forms, no
// surrogates, nothing above U+10FFFF.
pub fn valid_utf8(in s: Slice[u8]) -> bool {
    let mut i: u64 = 0;
    loop {
        if i >= s.len() {
            return true;
        }
        let c = byte(in s, i);
        if c < UTF8_CONT_LO {
            i = inc(i);
        } else if c >= UTF8_LEAD2_LO && c <= UTF8_LEAD2_HI {
            if !cont(in s, inc(i)) {
                return false;
            }
            i = wrapping_add(i, 2);
        } else if c >= UTF8_LEAD3_LO && c <= UTF8_LEAD3_HI {
            let lo: u8 = if c == UTF8_LEAD3_LO {
                UTF8_E0_SECOND_LO
            } else {
                UTF8_CONT_LO
            };
            let hi: u8 = if c == UTF8_SURROGATE_LEAD {
                UTF8_ED_SECOND_HI
            } else {
                UTF8_CONT_HI
            };
            if !in_range(in s, inc(i), lo, hi) || !cont(in s, wrapping_add(i, 2)) {
                return false;
            }
            i = wrapping_add(i, 3);
        } else if c >= UTF8_LEAD4_LO && c <= UTF8_LEAD4_HI {
            let lo: u8 = if c == UTF8_LEAD4_LO {
                UTF8_F0_SECOND_LO
            } else {
                UTF8_CONT_LO
            };
            let hi: u8 = if c == UTF8_LEAD4_HI {
                UTF8_F4_SECOND_HI
            } else {
                UTF8_CONT_HI
            };
            if !in_range(in s, inc(i), lo, hi)
                || !cont(in s, wrapping_add(i, 2))
                || !cont(in s, wrapping_add(i, 3)) {
                return false;
            }
            i = wrapping_add(i, 4);
        } else {
            return false;
        }
    }
}

fn parse_value(ty: u64, in v: Slice[u8], inout out: ChunkSeq[u8])
    -> Result[CapsuleOut, CapsuleError] {
    if ty == datagram_type() {
        out.extend(in v);
        return Result::Ok(CapsuleOut::Datagram);
    }
    if ty == close_type() {
        let n = v.len();
        if n < CLOSE_CODE_LEN {
            return Result::Err(
                CapsuleError::Malformed {
                    capsule_type: ty
                }
            );
        }
        if !valid_utf8(in v[(CLOSE_CODE_LEN)..n]) {
            return Result::Err(
                CapsuleError::Malformed {
                    capsule_type: ty
                }
            );
        }
        let code = (widen_u64(byte(in v, 0)) << 24) | (widen_u64(byte(in v, 1)) << 16) | (
            widen_u64(byte(in v, 2)) << 8
        ) | widen_u64(byte(in v, 3));
        out.extend(in v[(CLOSE_CODE_LEN)..n]);
        return Result::Ok(CapsuleOut::CloseSession(wrapping_u32(code)));
    }
    if v.len() != 0 {
        return Result::Err(
            CapsuleError::Malformed {
                capsule_type: ty
            }
        );
    }
    Result::Ok(CapsuleOut::DrainSession)
}

// `next_capsule`: `CapsuleOut::None` until more bytes arrive.
pub fn capsule_next(inout r: CapsuleReaderCore) -> Result[CapsuleOut, CapsuleError] {
    r.out.clear();
    loop {
        let avail = wrapping_sub(r.buf.len(), r.head);
        if r.mode == MODE_HEADER {
            let t = match vdec(in r.buf.as_slice(), r.head) {
                Option::Some(n) => n,
                Option::None => return Result::Ok(CapsuleOut::None),
            };
            let l = match vdec(in r.buf.as_slice(), wrapping_add(r.head, t.used)) {
                Option::Some(n) => n,
                Option::None => return Result::Ok(CapsuleOut::None),
            };
            r.head = wrapping_add(r.head, wrapping_add(t.used, l.used));
            let ty = t.value;
            let len = l.value;
            if ty == datagram_type() || ty == close_type() || ty == drain_type() {
                let bound = if ty == close_type() {
                    wrapping_add(CLOSE_CODE_LEN, max_close_reason())
                } else {
                    r.max_value
                };
                if len > bound {
                    return Result::Err(
                        CapsuleError::TooLarge {
                            capsule_type: ty,
                            len: len
                        }
                    );
                }
                r.mode = MODE_VALUE;
                r.ty = ty;
                r.len = len;
            } else {
                r.mode = MODE_SKIP;
                r.remaining = len;
                return Result::Ok(CapsuleOut::Unknown(ty));
            }
        } else if r.mode == MODE_SKIP {
            let n = min64(r.remaining, avail);
            r.head = wrapping_add(r.head, n);
            r.remaining = wrapping_sub(r.remaining, n);
            if r.remaining > 0 {
                return Result::Ok(CapsuleOut::None);
            }
            r.mode = MODE_HEADER;
        } else {
            if avail < r.len {
                return Result::Ok(CapsuleOut::None);
            }
            let lo = r.head;
            let hi = wrapping_add(lo, r.len);
            r.head = hi;
            r.mode = MODE_HEADER;
            return parse_value(r.ty, in r.buf[lo..hi], inout r.out);
        }
    }
}

// `write_close_session`.
pub fn capsule_write_close(inout out: ChunkSeq[u8], code: u32, in reason: Slice[u8]) -> bool {
    let mut v = ChunkSeq::new[u8]();
    let c = widen_u64(code);
    v.push(wrapping_u8(c >> 24));
    v.push(wrapping_u8(c >> 16));
    v.push(wrapping_u8(c >> 8));
    v.push(wrapping_u8(c));
    v.extend(in reason);
    put_record(inout out, close_type(), in v.as_slice())
}
