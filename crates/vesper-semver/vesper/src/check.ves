// Module check of @vesper/semver (see lib.ves): the conservative
// source-interface checker of src/lib.rs (`compare`, `Checker`,
// `Projection::is_subset_of`, the range counterexamples, `resumption` and
// `type_mode`), over the flat encoding that src/port.rs writes.
//
// Input words `w`: [old interface, new interface, string count n, string
// table offset s, then the nodes], with the n (offset, length) ranges of `t`
// at `s`. String ids follow Rust `String` order, so comparing ids compares
// the strings. Every other value is a node offset into `w`. The encoder hash-conses nodes, so two nodes of the same class
// are structurally equal exactly when their offsets are equal.
//
// The codes and node words are named by the enums below.
//
// Nodes:
//   interface  [schema, semantics, m, (name, declaration) * m,
//               k, (name, arity, mode) * k]
//   declaration Function [0, function], Struct [1, generics, mode, fields],
//               Enum [2, generics, mode, open, m, (name, payload) * m],
//               Effect [3, generics, sealed, resumption, m,
//               (name, function) * m], Unsupported [4, description]
//   fields     Closed [0], Public [1, m, (name, type) * m]
//   payload    [m, type * m]
//   generics   [m, (kind, value) * m]
//   function   [generics, mode, result, result mode, effects, m,
//               parameter * m]
//   parameter  [pass, type, projection]
//   projection All [0], Paths [1, m, path * m]; path [m, string * m]
//   effects    [m, capability * m, r, row variable * r]
//   capability [identity, effect, resumption, has ceiling, ceiling,
//               grade relation, m, argument type * m]
//   type       Primitive [0, name], I64Range [1, min, max], U64Range
//              [2, min, max], Parameter [3, index], Named [4, name, m,
//              argument * m], Tuple [5, m, element * m], Function
//              [6, function], Unsupported [7, description]; a subtree
//              cut by the encoder past 256 levels is [7, description, k]
// Maps and sets are in Rust iteration order (sorted).
use self::Q;
use self::util::{
    Class,
    none,
    put,
    put_i64,
    put_text,
    put_u64
};

// SCHEMA_VERSION and SEMANTICS_VERSION of src/lib.rs.
const SCHEMA_VERSION: u64 = 1;
const SEMANTICS_VERSION: u64 = 2;
// Recursion limit of validation, `type_mode` and subtyping.
const MAX_DEPTH: u64 = 128;
// i64::MIN and i64::MAX as u64 bit patterns.
const I64_MIN: u64 = 9223372036854775808;
const I64_MAX: u64 = 9223372036854775807;

// Input header words.
enum Input: _ {
    Old,
    New,
    StringCount,
    StringTable
}

// Words per string table entry (offset, length).
const STR_WORDS: u64 = 2;

// A list node [m, item * m]: the count, then the items.
enum List: _ {
    Count,
    First
}

// Interface words; the k (name, arity, mode) external types follow the
// exports.
enum Iface: _ {
    Schema,
    Semantics,
    ExportCount,
    FirstExport
}

// Words per export (name, declaration).
const EXPORT_WORDS: u64 = 2;

// The fields of an external type entry.
enum Ext: _ {
    Name,
    Arity,
    Mode
}

const EXT_WORDS: u64 = 3;

// Declaration tags.
enum DeclTag: _ {
    Function,
    Struct,
    Enum,
    Effect,
    Unsupported
}

// Declaration words, by kind (Function, Description: Function and
// Unsupported; Generics, Mode, Fields: Struct; Generics, Mode, Open and the
// entries: Enum; Generics, Sealed, Resumption and the entries: Effect).
enum Decl: _ {
    Tag = 0,
    Function = 1,
    Description = 1,
    Generics = 1,
    Mode = 2,
    Sealed = 2,
    Fields = 3,
    Open = 3,
    Resumption = 3,
    EntryCount = 4,
    FirstEntry = 5
}

// Words per (name, value) entry of an enum or effect declaration.
const ENTRY_WORDS: u64 = 2;

// Struct fields: Closed [Closed], Public [Public, m, (name, type) * m].
enum Fields: _ {
    Closed,
    Public
}

enum FieldList: _ {
    Kind = 0,
    Count = 1,
    FirstType = 3
}

const FIELD_WORDS: u64 = 2;

// Generic binders: (kind, value) entries of a list.
enum Gen: _ {
    Kind,
    Value
}

const GEN_WORDS: u64 = 2;

// A binder kind, with the value a bound `Mode` (Type) or a minimum
// `Resumption` (Row).
enum GenKind: _ {
    Type,
    Row
}

// Type tags.
enum TypeTag: _ {
    Primitive,
    I64Range,
    U64Range,
    Parameter,
    Named,
    Tuple,
    Function,
    Unsupported
}

// Type words, by tag (Name: Primitive and Named; Min, Max: the ranges;
// Index: Parameter; ArgCount, FirstArg: Named; ElementCount, FirstElement:
// Tuple; Function: Function; Description: Unsupported).
enum Ty: _ {
    Tag = 0,
    Name = 1,
    Min = 1,
    Index = 1,
    ElementCount = 1,
    Function = 1,
    Description = 1,
    Max = 2,
    ArgCount = 2,
    FirstElement = 2,
    FirstArg = 3
}

// Primitive type names.
enum Prim: _ {
    Unit,
    Never,
    Bool,
    U8,
    U32,
    U64,
    I64,
    F64,
    String
}

// Modal kinds, ordered from most to least reusable.
enum Mode: _ {
    Copy,
    Affine,
    Linear
}

enum Resumption: _ {
    Affine,
    Linear
}

// Function words; the parameters follow.
enum Func: _ {
    Generics,
    Mode,
    Result,
    ResultMode,
    Effects,
    ParamCount,
    FirstParam
}

// Parameter words.
enum Param: _ {
    Pass,
    Type,
    Projection
}

enum Pass: _ {
    In,
    Inout,
    Sink
}

// Projections: All [All], Paths [Paths, m, path * m].
enum ProjKind: _ {
    All,
    Paths
}

enum Proj: _ {
    Kind,
    Count,
    First
}

// Capability words; the argument types follow.
enum Cap: _ {
    Identity,
    Effect,
    Resumption,
    HasCeiling,
    Ceiling,
    Grade,
    ArgCount,
    FirstArg
}

// `GradeRelation`.
enum Grade: _ {
    UpperBound,
    Exact
}

// Issue path nodes: (parent, kind, value) words in `q.paths`.
enum PathWord: _ {
    Parent,
    Kind,
    Value
}

// Path node kinds: a root string id, the `Side`, `.{string id}`,
// `.parameter[{value}]` and `.result`.
enum PathKind: _ {
    Root,
    Side,
    Field,
    Parameter,
    Result
}

enum Side: _ {
    Old,
    New
}

enum IssueKind: _ {
    Breaking,
    Unsupported
}

// Words of a found issue in `q.found`: kind, path node, then the rule,
// message and witness pool ranges copied to `q.issues`.
enum Found: _ {
    Kind,
    Path,
    Rule
}

const FOUND_WORDS: u64 = 8;

// Words of a found adapter in `q.adapts`.
enum Adapt: _ {
    Path,
    Index
}

const ADAPT_WORDS: u64 = 2;

// Word `i` of the input, or 0 past the end. The input is copied into a
// `ChunkSeq` once, because functions with slice parameters are never
// inlined, and these accessors run for every node read.
fn word(in w: ChunkSeq[u64], i: u64) -> u64 {
    match w.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

fn at(in w: ChunkSeq[u64], p: u64, k: u64) -> u64 {
    word(in w, wrapping_add(p, k))
}

fn str_off(in w: ChunkSeq[u64], id: u64) -> u64 {
    word(in w, wrapping_add(word(in w, Input::StringTable), wrapping_mul(id, STR_WORDS)))
}

fn str_len(in w: ChunkSeq[u64], id: u64) -> u64 {
    word(
        in w,
        wrapping_add(wrapping_add(word(in w, Input::StringTable), 1), wrapping_mul(id, STR_WORDS))
    )
}

fn str_empty(in w: ChunkSeq[u64], id: u64) -> bool {
    str_len(in w, id) == 0
}

fn max_mode(a: u64, b: u64) -> u64 {
    if a > b {
        a
    } else {
        b
    }
}

// Signed comparison of two i64 bit patterns: a <= b.
fn le_i64(a: u64, b: u64) -> bool {
    wrapping_i64(a) <= wrapping_i64(b)
}

// Whether declaration `d` is a nominal type (a struct or an enum).
fn is_nominal(in w: ChunkSeq[u64], d: u64) -> bool {
    let tag = at(in w, d, Decl::Tag);
    tag == DeclTag::Struct || tag == DeclTag::Enum
}

// Interfaces.

fn export_count(in w: ChunkSeq[u64], i: u64) -> u64 {
    at(in w, i, Iface::ExportCount)
}

fn export_name(in w: ChunkSeq[u64], i: u64, k: u64) -> u64 {
    at(in w, i, wrapping_add(Iface::FirstExport, wrapping_mul(k, EXPORT_WORDS)))
}

fn export_decl(in w: ChunkSeq[u64], i: u64, k: u64) -> u64 {
    at(in w, i, wrapping_add(Iface::FirstExport + 1, wrapping_mul(k, EXPORT_WORDS)))
}

fn ext_base(in w: ChunkSeq[u64], i: u64) -> u64 {
    wrapping_add(
        wrapping_add(i, Iface::FirstExport),
        wrapping_mul(export_count(in w, i), EXPORT_WORDS)
    )
}

fn ext_count(in w: ChunkSeq[u64], i: u64) -> u64 {
    word(in w, ext_base(in w, i))
}

fn ext_field(in w: ChunkSeq[u64], i: u64, k: u64, f: u64) -> u64 {
    at(
        in w,
        ext_base(in w, i),
        wrapping_add(wrapping_add(List::First, wrapping_mul(k, EXT_WORDS)), f)
    )
}

// Binary search of a sorted (name, value) list of `m` entries of `stride`
// words at `base`: the entry index, or none.
fn find_sorted(in w: ChunkSeq[u64], base: u64, m: u64, stride: u64, id: u64) -> u64 {
    let mut lo: u64 = 0;
    let mut hi = m;
    loop {
        if lo >= hi {
            break;
        }
        let mid = wrapping_add(lo, hi) >> 1;
        let name = at(in w, base, wrapping_mul(mid, stride));
        if name == id {
            return mid;
        }
        if name < id {
            lo = wrapping_add(mid, 1);
        } else {
            hi = mid;
        }
    }
    none()
}

// `exports.get(name)`: the declaration node, or none.
fn find_export(in w: ChunkSeq[u64], i: u64, id: u64) -> u64 {
    let k = find_sorted(
        in w,
        wrapping_add(i, Iface::FirstExport),
        export_count(in w, i),
        EXPORT_WORDS,
        id
    );
    if k == none() {
        none()
    } else {
        export_decl(in w, i, k)
    }
}

// `external_types.get(name)`: the entry index, or none.
fn find_ext(in w: ChunkSeq[u64], i: u64, id: u64) -> u64 {
    find_sorted(
        in w,
        wrapping_add(ext_base(in w, i), List::First),
        ext_count(in w, i),
        EXT_WORDS,
        id
    )
}

// Generics.

fn gen_count(in w: ChunkSeq[u64], g: u64) -> u64 {
    word(in w, g)
}

fn gen_kind(in w: ChunkSeq[u64], g: u64, k: u64) -> u64 {
    at(in w, g, wrapping_add(List::First + Gen::Kind, wrapping_mul(k, GEN_WORDS)))
}

fn gen_value(in w: ChunkSeq[u64], g: u64, k: u64) -> u64 {
    at(in w, g, wrapping_add(List::First + Gen::Value, wrapping_mul(k, GEN_WORDS)))
}

// `a.starts_with(b)` for generic lists.
fn gen_starts_with(in w: ChunkSeq[u64], a: u64, b: u64) -> bool {
    let n = gen_count(in w, b);
    if gen_count(in w, a) < n {
        return false;
    }
    for k in 0..n {
        if gen_kind(in w, a, k) != gen_kind(in w, b, k)
            || gen_value(in w, a, k) != gen_value(in w, b, k) {
            return false;
        }
    }
    true
}

// Functions, parameters, effects and capabilities.

fn fn_generics(in w: ChunkSeq[u64], f: u64) -> u64 {
    at(in w, f, Func::Generics)
}

fn fn_mode(in w: ChunkSeq[u64], f: u64) -> u64 {
    at(in w, f, Func::Mode)
}

fn fn_result(in w: ChunkSeq[u64], f: u64) -> u64 {
    at(in w, f, Func::Result)
}

fn fn_result_mode(in w: ChunkSeq[u64], f: u64) -> u64 {
    at(in w, f, Func::ResultMode)
}

fn fn_effects(in w: ChunkSeq[u64], f: u64) -> u64 {
    at(in w, f, Func::Effects)
}

fn fn_param_count(in w: ChunkSeq[u64], f: u64) -> u64 {
    at(in w, f, Func::ParamCount)
}

fn fn_param(in w: ChunkSeq[u64], f: u64, k: u64) -> u64 {
    at(in w, f, wrapping_add(Func::FirstParam, k))
}

fn cap_count(in w: ChunkSeq[u64], e: u64) -> u64 {
    word(in w, e)
}

fn cap_at(in w: ChunkSeq[u64], e: u64, k: u64) -> u64 {
    at(in w, e, wrapping_add(List::First, k))
}

fn row_base(in w: ChunkSeq[u64], e: u64) -> u64 {
    wrapping_add(wrapping_add(e, List::First), cap_count(in w, e))
}

fn row_count(in w: ChunkSeq[u64], e: u64) -> u64 {
    word(in w, row_base(in w, e))
}

fn row_at(in w: ChunkSeq[u64], e: u64, k: u64) -> u64 {
    at(in w, row_base(in w, e), wrapping_add(List::First, k))
}

fn cap_identity(in w: ChunkSeq[u64], c: u64) -> u64 {
    at(in w, c, Cap::Identity)
}

fn cap_effect(in w: ChunkSeq[u64], c: u64) -> u64 {
    at(in w, c, Cap::Effect)
}

fn cap_resumption(in w: ChunkSeq[u64], c: u64) -> u64 {
    at(in w, c, Cap::Resumption)
}

fn cap_has_ceiling(in w: ChunkSeq[u64], c: u64) -> bool {
    at(in w, c, Cap::HasCeiling) != 0
}

fn cap_ceiling(in w: ChunkSeq[u64], c: u64) -> u64 {
    at(in w, c, Cap::Ceiling)
}

fn cap_grade(in w: ChunkSeq[u64], c: u64) -> u64 {
    at(in w, c, Cap::Grade)
}

fn cap_arg_count(in w: ChunkSeq[u64], c: u64) -> u64 {
    at(in w, c, Cap::ArgCount)
}

fn cap_arg(in w: ChunkSeq[u64], c: u64, k: u64) -> u64 {
    at(in w, c, wrapping_add(Cap::FirstArg, k))
}

// The same identity, effect and type arguments.
fn same_capability(in w: ChunkSeq[u64], a: u64, b: u64) -> bool {
    if cap_identity(in w, a) != cap_identity(in w, b)
        || cap_effect(in w, a) != cap_effect(in w, b) {
        return false;
    }
    let n = cap_arg_count(in w, a);
    if cap_arg_count(in w, b) != n {
        return false;
    }
    for k in 0..n {
        if cap_arg(in w, a, k) != cap_arg(in w, b, k) {
            return false;
        }
    }
    true
}

// Projections.

fn proj_full(in w: ChunkSeq[u64], p: u64) -> bool {
    if at(in w, p, Proj::Kind) == ProjKind::All {
        return true;
    }
    let n = at(in w, p, Proj::Count);
    if n == 0 {
        return true;
    }
    for k in 0..n {
        if word(in w, at(in w, p, wrapping_add(Proj::First, k))) == 0 {
            return true;
        }
    }
    false
}

// `path a` starts with `path b`.
fn path_starts_with(in w: ChunkSeq[u64], a: u64, b: u64) -> bool {
    let n = word(in w, b);
    if word(in w, a) < n {
        return false;
    }
    for k in 0..n {
        if at(in w, a, wrapping_add(List::First, k)) != at(in w, b, wrapping_add(List::First, k)) {
            return false;
        }
    }
    true
}

// The exported `is_subset_of`.
pub fn subset_words(in ws: Slice[u64], new: u64, old: u64) -> bool {
    let mut w = ChunkSeq::new[u64]();
    w.extend(in ws);
    subset_q(in w, new, old)
}

// `Projection::is_subset_of(new, old)`.
fn subset_q(in w: ChunkSeq[u64], new: u64, old: u64) -> bool {
    if proj_full(in w, old) {
        return true;
    }
    if proj_full(in w, new) {
        return false;
    }
    let nn = at(in w, new, Proj::Count);
    let on = at(in w, old, Proj::Count);
    for i in 0..nn {
        let np = at(in w, new, wrapping_add(Proj::First, i));
        let mut found = false;
        for j in 0..on {
            if path_starts_with(in w, np, at(in w, old, wrapping_add(Proj::First, j))) {
                found = true;
                break;
            }
        }
        if !found {
            return false;
        }
    }
    true
}

// Output: pool text and issues.

// Issue paths are built lazily, as nodes (parent, kind, value) in
// `q.paths`, and written as text only for the issues and adapters that use
// them.
fn path_node(inout q: Q, parent: u64, kind: u64, value: u64) -> u64 {
    let at = q.paths.len();
    q.paths.push(parent);
    q.paths.push(kind);
    q.paths.push(value);
    at
}

fn path_word(in q: Q, p: u64, k: u64) -> u64 {
    match q.paths.try_get(wrapping_add(p, k)) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

fn put_path(inout q: Q, in w: ChunkSeq[u64], in t: Slice[u8], p: u64) {
    let parent = path_word(in q, p, PathWord::Parent);
    let kind = path_word(in q, p, PathWord::Kind);
    let value = path_word(in q, p, PathWord::Value);
    if parent != none() {
        put_path(inout q, in w, in t, parent);
    }
    if kind == PathKind::Root {
        put_text(inout q.pool, in t, str_off(in w, value), str_len(in w, value));
    } else if kind == PathKind::Side {
        if value == Side::Old {
            put(inout q.pool, "old");
        } else {
            put(inout q.pool, "new");
        }
    } else if kind == PathKind::Field {
        put(inout q.pool, ".");
        put_text(inout q.pool, in t, str_off(in w, value), str_len(in w, value));
    } else if kind == PathKind::Parameter {
        put(inout q.pool, ".parameter[");
        put_u64(inout q.pool, value);
        put(inout q.pool, "]");
    } else {
        put(inout q.pool, ".result");
    }
}

fn found_word(in q: Q, i: u64) -> u64 {
    match q.found.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

fn adapt_word(in q: Q, i: u64) -> u64 {
    match q.adapts.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

// Writes the found issues and adapters into `issues` and `adapters` with
// their paths as text ranges.
fn finish_paths(inout q: Q, in w: ChunkSeq[u64], in t: Slice[u8]) {
    let mut i: u64 = 0;
    loop {
        if i >= q.found.len() {
            break;
        }
        let o = q.pool.len();
        let p = found_word(in q, wrapping_add(i, Found::Path));
        put_path(inout q, in w, in t, p);
        let l = wrapping_sub(q.pool.len(), o);
        let kind = found_word(in q, wrapping_add(i, Found::Kind));
        q.issues.push(kind);
        q.issues.push(o);
        q.issues.push(l);
        let mut k: u64 = Found::Rule;
        loop {
            if k >= FOUND_WORDS {
                break;
            }
            let x = found_word(in q, wrapping_add(i, k));
            k = wrapping_add(k, 1);
            q.issues.push(x);
        }
        i = wrapping_add(i, FOUND_WORDS);
    }
    let mut i: u64 = 0;
    loop {
        if i >= q.adapts.len() {
            break;
        }
        let o = q.pool.len();
        let p = adapt_word(in q, wrapping_add(i, Adapt::Path));
        put_path(inout q, in w, in t, p);
        let l = wrapping_sub(q.pool.len(), o);
        q.adapters.push(o);
        q.adapters.push(l);
        let x = adapt_word(in q, wrapping_add(i, Adapt::Index));
        q.adapters.push(x);
        i = wrapping_add(i, ADAPT_WORDS);
    }
}

fn lit(inout q: Q, in s: Str) -> (u64, u64) {
    let o = q.pool.len();
    put(inout q.pool, s);
    (o, s.len())
}

fn text_range(inout q: Q, in w: ChunkSeq[u64], in t: Slice[u8], id: u64) -> (u64, u64) {
    let o = q.pool.len();
    let n = str_len(in w, id);
    put_text(inout q.pool, in t, str_off(in w, id), n);
    (o, n)
}

fn push_issue(inout q: Q, kind: u64, path: u64, in rule: Str, mo: u64, ml: u64, wo: u64, wl: u64) {
    let (ro, rl) = lit(inout q, rule);
    // `finish_paths` writes the path node's text.
    q.found.push(kind);
    q.found.push(path);
    q.found.push(ro);
    q.found.push(rl);
    q.found.push(mo);
    q.found.push(ml);
    q.found.push(wo);
    q.found.push(wl);
}

fn breaking(inout q: Q, path: u64, in rule: Str, in message: Str, in witness: Str) {
    let (mo, ml) = lit(inout q, message);
    let (wo, wl) = lit(inout q, witness);
    push_issue(inout q, IssueKind::Breaking, path, rule, mo, ml, wo, wl);
}

fn breaking_witness(inout q: Q, path: u64, in rule: Str, in message: Str, wo: u64, wl: u64) {
    let (mo, ml) = lit(inout q, message);
    push_issue(inout q, IssueKind::Breaking, path, rule, mo, ml, wo, wl);
}

fn unsupported_range(inout q: Q, path: u64, mo: u64, ml: u64) {
    let (wo, wl) = lit(
        inout q,
        "The checker cannot certify substitutability for this interface feature."
    );
    push_issue(inout q, IssueKind::Unsupported, path, "Unsupported", mo, ml, wo, wl);
}

fn unsupported(inout q: Q, path: u64, in message: Str) {
    let (mo, ml) = lit(inout q, message);
    unsupported_range(inout q, path, mo, ml);
}

// An unsupported issue whose message is the string `id` after `prefix`.
fn unsupported_text(
    inout q: Q,
    in w: ChunkSeq[u64],
    in t: Slice[u8],
    path: u64,
    in prefix: Str,
    id: u64
) {
    let mo = q.pool.len();
    put(inout q.pool, prefix);
    put_text(inout q.pool, in t, str_off(in w, id), str_len(in w, id));
    let ml = wrapping_sub(q.pool.len(), mo);
    unsupported_range(inout q, path, mo, ml);
}

fn issue_count(in q: Q) -> u64 {
    q.found.len()
}

fn has_unsupported(in q: Q) -> bool {
    let n = q.found.len();
    let mut i: u64 = 0;
    loop {
        if i >= n {
            break;
        }
        if found_word(in q, wrapping_add(i, Found::Kind)) == IssueKind::Unsupported {
            return true;
        }
        i = wrapping_add(i, FOUND_WORDS);
    }
    false
}

// `type_mode`: the modal kind of a type, or none.
fn type_mode(in w: ChunkSeq[u64], i: u64, ty: u64, g: u64, depth: u64) -> u64 {
    if depth > MAX_DEPTH {
        return none();
    }
    let tag = at(in w, ty, Ty::Tag);
    if tag == TypeTag::Primitive {
        if at(in w, ty, Ty::Name) == Prim::String {
            Mode::Affine
        } else {
            Mode::Copy
        }
    } else if tag == TypeTag::I64Range || tag == TypeTag::U64Range {
        Mode::Copy
    } else if tag == TypeTag::Parameter {
        let index = at(in w, ty, Ty::Index);
        if index < gen_count(in w, g) && gen_kind(in w, g, index) == GenKind::Type {
            gen_value(in w, g, index)
        } else {
            none()
        }
    } else if tag == TypeTag::Function {
        fn_mode(in w, at(in w, ty, Ty::Function))
    } else if tag == TypeTag::Tuple {
        let mut m: u64 = Mode::Copy;
        for k in 0..at(in w, ty, Ty::ElementCount) {
            let n = type_mode(
                in w,
                i,
                at(in w, ty, wrapping_add(Ty::FirstElement, k)),
                g,
                wrapping_add(depth, 1)
            );
            if n == none() {
                return none();
            }
            m = max_mode(m, n);
        }
        m
    } else if tag == TypeTag::Named {
        let name = at(in w, ty, Ty::Name);
        let d = find_export(in w, i, name);
        let mut m: u64 = Mode::Copy;
        if d != none() && is_nominal(in w, d) {
            m = at(in w, d, Decl::Mode);
        } else {
            let e = find_ext(in w, i, name);
            if e == none() {
                return none();
            }
            m = ext_field(in w, i, e, Ext::Mode);
        }
        for k in 0..at(in w, ty, Ty::ArgCount) {
            let n = type_mode(
                in w,
                i,
                at(in w, ty, wrapping_add(Ty::FirstArg, k)),
                g,
                wrapping_add(depth, 1)
            );
            if n == none() {
                return none();
            }
            m = max_mode(m, n);
        }
        m
    } else {
        none()
    }
}

// Validation (`Checker::validate`, `validate_function`, `validate_type`).

fn validate_type(
    inout q: Q,
    in w: ChunkSeq[u64],
    in t: Slice[u8],
    i: u64,
    ty: u64,
    g: u64,
    path: u64,
    depth: u64
) {
    if depth > MAX_DEPTH {
        unsupported(inout q, path, "type nesting exceeds 128 levels");
        return;
    }
    let tag = at(in w, ty, Ty::Tag);
    if tag == TypeTag::I64Range {
        if !le_i64(at(in w, ty, Ty::Min), at(in w, ty, Ty::Max)) {
            unsupported(inout q, path, "invalid i64 refinement range");
        }
    } else if tag == TypeTag::U64Range {
        if at(in w, ty, Ty::Min) > at(in w, ty, Ty::Max) {
            unsupported(inout q, path, "invalid u64 refinement range");
        }
    } else if tag == TypeTag::Parameter {
        let index = at(in w, ty, Ty::Index);
        if !(index < gen_count(in w, g) && gen_kind(in w, g, index) == GenKind::Type) {
            unsupported(inout q, path, "unbound or non-type generic parameter");
        }
    } else if tag == TypeTag::Named {
        let name = at(in w, ty, Ty::Name);
        let n = at(in w, ty, Ty::ArgCount);
        let d = find_export(in w, i, name);
        let nominal = d != none() && is_nominal(in w, d);
        let arity = if nominal {
            gen_count(in w, at(in w, d, Decl::Generics))
        } else {
            let e = find_ext(in w, i, name);
            if e == none() {
                none()
            } else {
                ext_field(in w, i, e, Ext::Arity)
            }
        };
        if arity != n {
            unsupported_text(
                inout q,
                in w,
                in t,
                path,
                "unknown nominal type or wrong arity: ",
                name
            );
        }
        if nominal {
            let ps = at(in w, d, Decl::Generics);
            let pn = gen_count(in w, ps);
            for k in 0..n {
                if k >= pn {
                    break;
                }
                let arg = at(in w, ty, wrapping_add(Ty::FirstArg, k));
                if gen_kind(in w, ps, k) == GenKind::Type {
                    let m = type_mode(in w, i, arg, g, 0);
                    if m != none() && m > gen_value(in w, ps, k) {
                        unsupported(inout q, path, "nominal type argument exceeds its modal bound");
                    }
                } else {
                    unsupported(
                        inout q,
                        path,
                        "nominal row arguments are not supported by this schema"
                    );
                }
            }
        }
        for k in 0..n {
            validate_type(
                inout q,
                in w,
                in t,
                i,
                at(in w, ty, wrapping_add(Ty::FirstArg, k)),
                g,
                path,
                wrapping_add(depth, 1)
            );
        }
    } else if tag == TypeTag::Tuple {
        for k in 0..at(in w, ty, Ty::ElementCount) {
            validate_type(
                inout q,
                in w,
                in t,
                i,
                at(in w, ty, wrapping_add(Ty::FirstElement, k)),
                g,
                path,
                wrapping_add(depth, 1)
            );
        }
    } else if tag == TypeTag::Function {
        validate_function(
            inout q,
            in w,
            in t,
            i,
            at(in w, ty, Ty::Function),
            path,
            wrapping_add(depth, 1)
        );
    } else if tag == TypeTag::Unsupported {
        let (mo, ml) = text_range(inout q, in w, in t, at(in w, ty, Ty::Description));
        unsupported_range(inout q, path, mo, ml);
    }
}

fn validate_function(
    inout q: Q,
    in w: ChunkSeq[u64],
    in t: Slice[u8],
    i: u64,
    f: u64,
    path: u64,
    depth: u64
) {
    if depth > MAX_DEPTH {
        unsupported(inout q, path, "function type nesting exceeds 128 levels");
        return;
    }
    let g = fn_generics(in w, f);
    for k in 0..fn_param_count(in w, f) {
        let p = fn_param(in w, f, k);
        validate_type(
            inout q,
            in w,
            in t,
            i,
            at(in w, p, Param::Type),
            g,
            path,
            wrapping_add(depth, 1)
        );
        let proj = at(in w, p, Param::Projection);
        if at(in w, proj, Proj::Kind) == ProjKind::Paths {
            let n = at(in w, proj, Proj::Count);
            let mut bad = n == 0;
            for j in 0..n {
                let path = at(in w, proj, wrapping_add(Proj::First, j));
                let m = word(in w, path);
                if m == 0 {
                    bad = true;
                }
                for c in 0..m {
                    if str_empty(in w, at(in w, path, wrapping_add(List::First, c))) {
                        bad = true;
                    }
                }
            }
            if bad {
                unsupported(inout q, path, "projection paths must have nonempty components");
            }
        }
        if at(in w, p, Param::Pass) == Pass::Sink && at(in w, proj, Proj::Kind) != ProjKind::All {
            unsupported(
                inout q,
                path,
                "sink projections are not supported by this interface schema"
            );
        }
    }
    validate_type(inout q, in w, in t, i, fn_result(in w, f), g, path, wrapping_add(depth, 1));
    let kind = type_mode(in w, i, fn_result(in w, f), g, 0);
    if kind != none() && kind > fn_result_mode(in w, f) {
        unsupported(inout q, path, "exported return mode weakens the result type's modal kind");
    }
    // Capability identities of this function, above `base` in `seen`.
    let base = q.seen.len();
    let e = fn_effects(in w, f);
    for k in 0..cap_count(in w, e) {
        let c = cap_at(in w, e, k);
        if cap_grade(in w, c) == Grade::Exact && !cap_has_ceiling(in w, c) {
            unsupported(inout q, path, "an exact grade requires a constant value");
        }
        let id = cap_identity(in w, c);
        let mut fresh = !str_empty(in w, id) && !str_empty(in w, cap_effect(in w, c));
        if fresh {
            for j in base..q.seen.len() {
                match q.seen.try_get(j) {
                    Option::Some(s) => {
                        if s == id {
                            fresh = false;
                        }
                    },
                    Option::None => (),
                }
            }
            if fresh {
                q.seen.push(id);
            }
        }
        if !fresh {
            unsupported(inout q, path, "capability identities must be nonempty and unique");
        }
        let d = find_export(in w, i, cap_effect(in w, c));
        if d != none() && at(in w, d, Decl::Tag) == DeclTag::Effect {
            if cap_resumption(in w, c) != at(in w, d, Decl::Resumption)
                || cap_arg_count(in w, c) != gen_count(in w, at(in w, d, Decl::Generics)) {
                unsupported(
                    inout q,
                    path,
                    "capability disagrees with its exported effect declaration"
                );
            }
        }
        for j in 0..cap_arg_count(in w, c) {
            validate_type(
                inout q,
                in w,
                in t,
                i,
                cap_arg(in w, c, j),
                g,
                path,
                wrapping_add(depth, 1)
            );
        }
    }
    q.seen.truncate(base);
    for k in 0..row_count(in w, e) {
        let index = row_at(in w, e, k);
        if !(index < gen_count(in w, g) && gen_kind(in w, g, index) == GenKind::Row) {
            unsupported(inout q, path, "unbound or non-row effect variable");
        }
    }
}

// `side` is a `Side`.
fn validate(inout q: Q, in w: ChunkSeq[u64], in t: Slice[u8], i: u64, side: u64) {
    let spath = path_node(inout q, none(), PathKind::Side, side);
    if at(in w, i, Iface::Semantics) != SEMANTICS_VERSION {
        unsupported(inout q, spath, "unsupported language-semantics version");
    }
    if at(in w, i, Iface::Schema) != SCHEMA_VERSION {
        unsupported(inout q, spath, "unsupported interface schema version");
    }
    for k in 0..ext_count(in w, i) {
        let name = ext_field(in w, i, k, Ext::Name);
        if str_empty(in w, name) || find_export(in w, i, name) != none() {
            unsupported(inout q, spath, "invalid or conflicting external type identity");
        }
    }
    for k in 0..export_count(in w, i) {
        let name = export_name(in w, i, k);
        if str_empty(in w, name) {
            unsupported(inout q, spath, "empty export identity");
        }
        let path = path_node(inout q, spath, PathKind::Field, name);
        let d = export_decl(in w, i, k);
        let tag = at(in w, d, Decl::Tag);
        if tag == DeclTag::Function {
            validate_function(inout q, in w, in t, i, at(in w, d, Decl::Function), path, 0);
        } else if tag == DeclTag::Struct {
            let g = at(in w, d, Decl::Generics);
            let fields = at(in w, d, Decl::Fields);
            if at(in w, fields, FieldList::Kind) == Fields::Public {
                for j in 0..at(in w, fields, FieldList::Count) {
                    let ty = at(
                        in w,
                        fields,
                        wrapping_add(FieldList::FirstType, wrapping_mul(j, FIELD_WORDS))
                    );
                    validate_type(inout q, in w, in t, i, ty, g, path, 0);
                }
            }
        } else if tag == DeclTag::Enum {
            let g = at(in w, d, Decl::Generics);
            for j in 0..entry_count(in w, d) {
                let payload = entry_value(in w, d, j);
                for x in 0..word(in w, payload) {
                    validate_type(
                        inout q,
                        in w,
                        in t,
                        i,
                        at(in w, payload, wrapping_add(List::First, x)),
                        g,
                        path,
                        0
                    );
                }
            }
        } else if tag == DeclTag::Effect {
            let g = at(in w, d, Decl::Generics);
            for j in 0..entry_count(in w, d) {
                let op = entry_value(in w, d, j);
                if !gen_starts_with(in w, fn_generics(in w, op), g) {
                    unsupported(
                        inout q,
                        path,
                        "operation generics must start with effect declaration binders"
                    );
                }
                validate_function(inout q, in w, in t, i, op, path, 0);
            }
        } else {
            let (mo, ml) = text_range(inout q, in w, in t, at(in w, d, Decl::Description));
            unsupported_range(inout q, path, mo, ml);
        }
    }
}

// Comparison.

fn generic_bounds(inout q: Q, in w: ChunkSeq[u64], path: u64, a: u64, b: u64) {
    let n = gen_count(in w, a);
    if n != gen_count(in w, b) {
        breaking(
            inout q,
            path,
            "SV-Fn",
            "generic binder arity changed",
            "A caller explicitly instantiates the old binder list."
        );
        return;
    }
    for k in 0..n {
        let ka = gen_kind(in w, a, k);
        let kb = gen_kind(in w, b, k);
        let va = gen_value(in w, a, k);
        let vb = gen_value(in w, b, k);
        let safe = (ka == GenKind::Type && kb == GenKind::Type && va <= vb)
            || (ka == GenKind::Row && kb == GenKind::Row && vb <= va);
        if !safe {
            breaking(
                inout q,
                path,
                "SV-Fn",
                "generic constraint strengthened or binder kind changed",
                "Instantiate the old interface with a type or row admitted by its original bound."
            );
        }
    }
}

// The inclusive u64 bounds of a validated direct u64 interval: (ok, min, max).
fn u64_bounds(in w: ChunkSeq[u64], ty: u64) -> (bool, u64, u64) {
    let tag = at(in w, ty, Ty::Tag);
    if tag == TypeTag::Primitive && at(in w, ty, Ty::Name) == Prim::U64 {
        (true, 0, none())
    } else if tag == TypeTag::U64Range && at(in w, ty, Ty::Min) <= at(in w, ty, Ty::Max) {
        (true, at(in w, ty, Ty::Min), at(in w, ty, Ty::Max))
    } else {
        (false, 0, 0)
    }
}

fn i64_bounds(in w: ChunkSeq[u64], ty: u64) -> (bool, u64, u64) {
    let tag = at(in w, ty, Ty::Tag);
    if tag == TypeTag::Primitive && at(in w, ty, Ty::Name) == Prim::I64 {
        (true, I64_MIN, I64_MAX)
    } else if tag == TypeTag::I64Range && le_i64(at(in w, ty, Ty::Min), at(in w, ty, Ty::Max)) {
        (true, at(in w, ty, Ty::Min), at(in w, ty, Ty::Max))
    } else {
        (false, 0, 0)
    }
}

// `u64_counterexample(sub, sup)`: (found, value).
fn u64_counterexample(in w: ChunkSeq[u64], sub: u64, sup: u64) -> (bool, u64) {
    let (a, sub_min, sub_max) = u64_bounds(in w, sub);
    let (b, sup_min, sup_max) = u64_bounds(in w, sup);
    if !a || !b {
        (false, 0)
    } else if sub_min < sup_min {
        (true, sub_min)
    } else if sub_max > sup_max {
        (true, sub_max)
    } else {
        (false, 0)
    }
}

fn i64_counterexample(in w: ChunkSeq[u64], sub: u64, sup: u64) -> (bool, u64) {
    let (a, sub_min, sub_max) = i64_bounds(in w, sub);
    let (b, sup_min, sup_max) = i64_bounds(in w, sup);
    if !a || !b {
        (false, 0)
    } else if !le_i64(sup_min, sub_min) {
        (true, sub_min)
    } else if !le_i64(sub_max, sup_max) {
        (true, sub_max)
    } else {
        (false, 0)
    }
}

// `resumption(effects, generics)`.
fn resumption(in w: ChunkSeq[u64], e: u64, g: u64) -> u64 {
    let mut r: u64 = Resumption::Linear;
    for k in 0..cap_count(in w, e) {
        let x = cap_resumption(in w, cap_at(in w, e, k));
        if x < r {
            r = x;
        }
    }
    for k in 0..row_count(in w, e) {
        let index = row_at(in w, e, k);
        if index < gen_count(in w, g) && gen_kind(in w, g, index) == GenKind::Row {
            let x = gen_value(in w, g, index);
            if x < r {
                r = x;
            }
        }
    }
    r
}

// `b.row_variables.is_subset(&a.row_variables)` over sorted sets.
fn rows_subset(in w: ChunkSeq[u64], b: u64, a: u64) -> bool {
    for k in 0..row_count(in w, b) {
        let x = row_at(in w, b, k);
        let mut found = false;
        for j in 0..row_count(in w, a) {
            if row_at(in w, a, j) == x {
                found = true;
                break;
            }
        }
        if !found {
            return false;
        }
    }
    true
}

fn function(
    inout q: Q,
    in w: ChunkSeq[u64],
    in t: Slice[u8],
    path: u64,
    a: u64,
    b: u64,
    depth: u64
) {
    if depth > MAX_DEPTH {
        unsupported(inout q, path, "subtyping recursion exceeds 128 levels");
        return;
    }
    generic_bounds(inout q, in w, path, fn_generics(in w, a), fn_generics(in w, b));
    if fn_mode(in w, b) > fn_mode(in w, a) {
        breaking(
            inout q,
            path,
            "SV-Fn",
            "function value became less reusable",
            "A caller copies or drops the function value under its old mode."
        );
    }
    let na = fn_param_count(in w, a);
    let nb = fn_param_count(in w, b);
    if na != nb {
        breaking(
            inout q,
            path,
            "SV-Fn",
            "parameter arity changed",
            "Call the function with the old argument list."
        );
    }
    for index in 0..na {
        if index >= nb {
            break;
        }
        let old = fn_param(in w, a, index);
        let new = fn_param(in w, b, index);
        let xpath = path_node(inout q, path, PathKind::Parameter, index);
        let old_pass = at(in w, old, Param::Pass);
        let new_pass = at(in w, new, Param::Pass);
        let narrowed = subset_q(
            in w,
            at(in w, new, Param::Projection),
            at(in w, old, Param::Projection)
        );
        if !narrowed {
            breaking(
                inout q,
                xpath,
                "SV-Fn",
                "borrowed projection widened",
                "Borrow a newly selected field separately at the same call site."
            );
        }
        if old_pass != new_pass {
            if old_pass == Pass::Inout && new_pass == Pass::In && narrowed {
                q.adapts.push(path);
                q.adapts.push(index);
                breaking(
                    inout q,
                    xpath,
                    "SV-Pass",
                    "inout-to-in requires an explicit compatibility adapter",
                    "A caller uses explicit inout syntax; an old-signature wrapper must reborrow it as in."
                );
            } else {
                breaking(
                    inout q,
                    xpath,
                    "SV-Pass",
                    "passing mode changed",
                    "For sink-to-borrow, a caller relied on consuming a linear argument; for in-to-write/consume, it retains only shared access."
                );
            }
        }
        let old_ty = at(in w, old, Param::Type);
        let new_ty = at(in w, new, Param::Type);
        let ok = if old_pass == Pass::Inout {
            old_ty == new_ty
        } else {
            subtype(inout q, in w, in t, old_ty, new_ty, xpath, wrapping_add(depth, 1))
        };
        if !ok {
            let mut witnessed = false;
            let wo = q.pool.len();
            if old_pass == new_pass && old_pass != Pass::Inout {
                let (fu, vu) = u64_counterexample(in w, old_ty, new_ty);
                if fu {
                    put(inout q.pool, "Pass ");
                    put_u64(inout q.pool, vu);
                    put(
                        inout q.pool,
                        ": u64; the old parameter admits this value but the new parameter rejects it."
                    );
                    witnessed = true;
                } else {
                    let (fi, vi) = i64_counterexample(in w, old_ty, new_ty);
                    if fi {
                        put(inout q.pool, "Pass ");
                        put_i64(inout q.pool, vi);
                        put(
                            inout q.pool,
                            ": i64; the old parameter admits this value but the new parameter rejects it."
                        );
                        witnessed = true;
                    }
                }
            }
            if !witnessed {
                put(
                    inout q.pool,
                    "Pass a value admitted by the old parameter type; mutable places cannot change stored type."
                );
            }
            let wl = wrapping_sub(q.pool.len(), wo);
            breaking_witness(inout q, xpath, "SV-Fn", "parameter type is incompatible", wo, wl);
        }
    }
    if fn_result_mode(in w, b) > fn_result_mode(in w, a) {
        breaking(
            inout q,
            path,
            "SV-Fn",
            "return mode became stricter",
            "Discard or duplicate a returned value as permitted by the old return mode."
        );
    }
    let rpath = path_node(inout q, path, PathKind::Result, 0);
    let br = fn_result(in w, b);
    let ar = fn_result(in w, a);
    if !subtype(inout q, in w, in t, br, ar, rpath, wrapping_add(depth, 1)) {
        let wo = q.pool.len();
        let (fu, vu) = u64_counterexample(in w, br, ar);
        if fu {
            put(inout q.pool, "The new result admits ");
            put_u64(inout q.pool, vu);
            put(inout q.pool, ": u64, which the old result type rejects.");
        } else {
            let (fi, vi) = i64_counterexample(in w, br, ar);
            if fi {
                put(inout q.pool, "The new result admits ");
                put_i64(inout q.pool, vi);
                put(inout q.pool, ": i64, which the old result type rejects.");
            } else {
                put(inout q.pool, "Use the returned value at the old result type.");
            }
        }
        let wl = wrapping_sub(q.pool.len(), wo);
        breaking_witness(inout q, path, "SV-Fn", "return type is incompatible", wo, wl);
    }
    let ea = fn_effects(in w, a);
    let eb = fn_effects(in w, b);
    let mut subset = true;
    for k in 0..cap_count(in w, eb) {
        let n = cap_at(in w, eb, k);
        let mut found = false;
        for j in 0..cap_count(in w, ea) {
            let o = cap_at(in w, ea, j);
            if same_capability(in w, n, o) && cap_resumption(in w, n) >= cap_resumption(in w, o) {
                found = true;
                break;
            }
        }
        if !found {
            subset = false;
            break;
        }
    }
    if !subset || !rows_subset(in w, eb, ea) {
        breaking(
            inout q,
            path,
            "SV-EffRow",
            "function requires new capabilities/rows or a weaker capability contract",
            "A caller grants exactly the old capability ceiling."
        );
    }
    for k in 0..cap_count(in w, ea) {
        let o = cap_at(in w, ea, k);
        if cap_grade(in w, o) == Grade::Exact {
            let mut kept = false;
            for j in 0..cap_count(in w, eb) {
                if same_capability(in w, o, cap_at(in w, eb, j)) {
                    kept = true;
                    break;
                }
            }
            if !kept {
                breaking(
                    inout q,
                    path,
                    "SV-Grade",
                    "exact graded capability removed",
                    "A caller relies on the old exact cost, not just an upper bound."
                );
            }
        }
    }
    for k in 0..cap_count(in w, eb) {
        let n = cap_at(in w, eb, k);
        let mut o = none();
        for j in 0..cap_count(in w, ea) {
            let c = cap_at(in w, ea, j);
            if same_capability(in w, c, n) {
                o = c;
                break;
            }
        }
        if o != none() {
            if cap_grade(in w, o) != cap_grade(in w, n) {
                breaking(
                    inout q,
                    path,
                    "SV-Grade",
                    "grade relation changed",
                    "An equality contract cannot be replaced by an upper-bound contract."
                );
            } else if cap_grade(in w, o) == Grade::Exact {
                if cap_has_ceiling(in w, o) != cap_has_ceiling(in w, n)
                    || cap_ceiling(in w, o) != cap_ceiling(in w, n) {
                    breaking(
                        inout q,
                        path,
                        "SV-Grade",
                        "exact resource grade changed",
                        "A caller relies on equality with the old published cost."
                    );
                }
            } else {
                let oh = cap_has_ceiling(in w, o);
                let nh = cap_has_ceiling(in w, n);
                if oh && nh {
                    if cap_ceiling(in w, n) > cap_ceiling(in w, o) {
                        breaking(
                            inout q,
                            path,
                            "SV-Grade",
                            "resource ceiling increased",
                            "Call under the old resource ceiling."
                        );
                    }
                } else if oh != nh {
                    unsupported(
                        inout q,
                        path,
                        "cannot compare a graded capability with an ungraded capability"
                    );
                }
            }
        }
    }
    if resumption(in w, eb, fn_generics(in w, b)) < resumption(in w, ea, fn_generics(in w, a)) {
        breaking(
            inout q,
            path,
            "SV-EffRow",
            "resumption guarantee weakened",
            "Hold a live linear obligation across a formerly guaranteed-resumptive call."
        );
    }
}

fn subtype(
    inout q: Q,
    in w: ChunkSeq[u64],
    in t: Slice[u8],
    sub: u64,
    sup: u64,
    path: u64,
    depth: u64
) -> bool {
    if depth > MAX_DEPTH {
        unsupported(inout q, path, "subtyping recursion exceeds 128 levels");
        return false;
    }
    let a = at(in w, sub, Ty::Tag);
    let b = at(in w, sup, Ty::Tag);
    if a == TypeTag::Primitive && at(in w, sub, Ty::Name) == Prim::Never {
        return true;
    }
    if a == TypeTag::Unsupported || b == TypeTag::Unsupported {
        return false;
    }
    if a == TypeTag::I64Range && b == TypeTag::I64Range {
        return le_i64(at(in w, sup, Ty::Min), at(in w, sub, Ty::Min))
            && le_i64(at(in w, sub, Ty::Max), at(in w, sup, Ty::Max));
    }
    if a == TypeTag::I64Range && b == TypeTag::Primitive && at(in w, sup, Ty::Name) == Prim::I64 {
        return true;
    }
    if a == TypeTag::Primitive && at(in w, sub, Ty::Name) == Prim::I64 && b == TypeTag::I64Range {
        return at(in w, sup, Ty::Min) == I64_MIN && at(in w, sup, Ty::Max) == I64_MAX;
    }
    if a == TypeTag::U64Range && b == TypeTag::U64Range {
        return at(in w, sup, Ty::Min) <= at(in w, sub, Ty::Min)
            && at(in w, sub, Ty::Max) <= at(in w, sup, Ty::Max);
    }
    if a == TypeTag::U64Range && b == TypeTag::Primitive && at(in w, sup, Ty::Name) == Prim::U64 {
        return true;
    }
    if a == TypeTag::Primitive && at(in w, sub, Ty::Name) == Prim::U64 && b == TypeTag::U64Range {
        return at(in w, sup, Ty::Min) == 0 && at(in w, sup, Ty::Max) == none();
    }
    if a == TypeTag::Function && b == TypeTag::Function {
        let before = issue_count(in q);
        let adapters = q.adapts.len();
        // A value of `sub` must be usable at `sup`, so `sub` is the candidate.
        function(
            inout q,
            in w,
            in t,
            path,
            at(in w, sup, Ty::Function),
            at(in w, sub, Ty::Function),
            wrapping_add(depth, 1)
        );
        return before == issue_count(in q) && adapters == q.adapts.len();
    }
    if a == TypeTag::Tuple && b == TypeTag::Tuple {
        let n = at(in w, sub, Ty::ElementCount);
        if n != at(in w, sup, Ty::ElementCount) {
            return false;
        }
        for k in 0..n {
            let x = at(in w, sub, wrapping_add(Ty::FirstElement, k));
            let y = at(in w, sup, wrapping_add(Ty::FirstElement, k));
            if !subtype(inout q, in w, in t, x, y, path, wrapping_add(depth, 1)) {
                return false;
            }
        }
        return true;
    }
    sub == sup
}

// The (name, value) entry list of an enum or effect declaration.
fn entry_count(in w: ChunkSeq[u64], d: u64) -> u64 {
    at(in w, d, Decl::EntryCount)
}

fn entry_name(in w: ChunkSeq[u64], d: u64, k: u64) -> u64 {
    at(in w, d, wrapping_add(Decl::FirstEntry, wrapping_mul(k, ENTRY_WORDS)))
}

fn entry_value(in w: ChunkSeq[u64], d: u64, k: u64) -> u64 {
    at(in w, d, wrapping_add(Decl::FirstEntry + 1, wrapping_mul(k, ENTRY_WORDS)))
}

fn find_entry(in w: ChunkSeq[u64], d: u64, id: u64) -> u64 {
    let k = find_sorted(
        in w,
        wrapping_add(d, Decl::FirstEntry),
        entry_count(in w, d),
        ENTRY_WORDS,
        id
    );
    if k == none() {
        none()
    } else {
        entry_value(in w, d, k)
    }
}

fn declaration(
    inout q: Q,
    in w: ChunkSeq[u64],
    in t: Slice[u8],
    new_i: u64,
    path: u64,
    a: u64,
    b: u64
) {
    let ta = at(in w, a, Decl::Tag);
    let tb = at(in w, b, Decl::Tag);
    if ta == DeclTag::Unsupported || tb == DeclTag::Unsupported {
        return;
    }
    if ta != tb {
        breaking(
            inout q,
            path,
            "SV-Export",
            "public declaration kind changed",
            "A caller uses the declaration at its old syntactic and semantic kind."
        );
        return;
    }
    if ta == DeclTag::Function {
        function(
            inout q,
            in w,
            in t,
            path,
            at(in w, a, Decl::Function),
            at(in w, b, Decl::Function),
            0
        );
    } else if ta == DeclTag::Struct {
        generic_bounds(
            inout q,
            in w,
            path,
            at(in w, a, Decl::Generics),
            at(in w, b, Decl::Generics)
        );
        if at(in w, b, Decl::Mode) > at(in w, a, Decl::Mode) {
            breaking(
                inout q,
                path,
                "SV-Adt-Closed",
                "struct kind became stricter",
                "A caller discards or copies a value under the old kind."
            );
        }
        if at(in w, a, Decl::Fields) != at(in w, b, Decl::Fields) {
            breaking(
                inout q,
                path,
                "SV-Adt-Closed",
                "public field contract or field visibility changed",
                "A caller constructs, projects or destructures the old public field set."
            );
        }
    } else if ta == DeclTag::Enum {
        let ag = at(in w, a, Decl::Generics);
        let am = at(in w, a, Decl::Mode);
        let ao = at(in w, a, Decl::Open) != 0;
        let bo = at(in w, b, Decl::Open) != 0;
        generic_bounds(inout q, in w, path, ag, at(in w, b, Decl::Generics));
        if at(in w, b, Decl::Mode) > am || ao != bo {
            breaking(
                inout q,
                path,
                "SV-Enum-Open",
                "enum kind or openness changed incompatibly",
                "A caller exhaustively matches a closed enum or discards unknown variants of an open enum."
            );
        }
        for k in 0..entry_count(in w, a) {
            let name = entry_name(in w, a, k);
            if find_entry(in w, b, name) != entry_value(in w, a, k) {
                breaking(
                    inout q,
                    path,
                    "SV-Enum-Open",
                    "existing variant removed or changed",
                    "A caller constructs or pattern-matches this old variant payload."
                );
            }
        }
        for k in 0..entry_count(in w, b) {
            let name = entry_name(in w, b, k);
            if find_entry(in w, a, name) == none() {
                if !ao {
                    breaking(
                        inout q,
                        path,
                        "SV-Enum-Open",
                        "variant added to a closed enum",
                        "An exhaustive old match has no arm for the added variant."
                    );
                }
                let payload = entry_value(in w, b, k);
                let mut m: u64 = Mode::Copy;
                for x in 0..word(in w, payload) {
                    let n = type_mode(
                        in w,
                        new_i,
                        at(in w, payload, wrapping_add(List::First, x)),
                        ag,
                        0
                    );
                    if n == none() {
                        m = none();
                        break;
                    }
                    m = max_mode(m, n);
                }
                if m == none() {
                    unsupported(inout q, path, "cannot establish the added payload's modal kind");
                } else if m > am {
                    let vpath = path_node(inout q, path, PathKind::Field, name);
                    breaking(
                        inout q,
                        vpath,
                        "SV-Enum-Open",
                        "added payload exceeds the old enum kind",
                        "An old wildcard arm discards an unknown variant containing a linear obligation."
                    );
                }
            }
        }
    } else if ta == DeclTag::Effect {
        generic_bounds(
            inout q,
            in w,
            path,
            at(in w, a, Decl::Generics),
            at(in w, b, Decl::Generics)
        );
        let aseal = at(in w, a, Decl::Sealed) != 0;
        let bseal = at(in w, b, Decl::Sealed) != 0;
        let aq = at(in w, a, Decl::Resumption);
        let bq = at(in w, b, Decl::Resumption);
        if aseal != bseal || (!aseal && aq != bq) || (aseal && bq < aq) {
            breaking(
                inout q,
                path,
                "SV-Effect-Decl",
                "effect openness or resumption contract changed",
                "An external handler may discard an affine continuation, or a caller retains a linear frame across the old effect."
            );
        }
        let n = entry_count(in w, a);
        let mut same_keys = n == entry_count(in w, b);
        if same_keys {
            for k in 0..n {
                if entry_name(in w, a, k) != entry_name(in w, b, k) {
                    same_keys = false;
                    break;
                }
            }
        }
        if !same_keys {
            breaking(
                inout q,
                path,
                "SV-Effect-Decl",
                "effect operation set changed",
                "An old handler implements exactly the old operation set."
            );
        }
        // Even sealed operation signature changes are conservatively
        // invariant until bidirectional handler/caller variance exists.
        for k in 0..n {
            let name = entry_name(in w, a, k);
            let new = find_entry(in w, b, name);
            if new != none() && new != entry_value(in w, a, k) {
                let vpath = path_node(inout q, path, PathKind::Field, name);
                breaking(
                    inout q,
                    vpath,
                    "SV-Effect-Decl",
                    "effect operation signature changed",
                    "Old callers and external handlers must agree on both sides of this operation signature."
                );
            }
        }
    }
}

fn new_q() -> Q {
    Q {
        class: Class::Patch,
        issues: ChunkSeq::new[u64](),
        adapters: ChunkSeq::new[u64](),
        pool: ChunkSeq::new[u8](),
        seen: ChunkSeq::new[u64](),
        paths: ChunkSeq::new[u64](),
        found: ChunkSeq::new[u64](),
        adapts: ChunkSeq::new[u64]()
    }
}

// `compare(old, new)`.
pub fn compare_q(in ws: Slice[u64], in t: Slice[u8]) -> Q {
    let mut q = new_q();
    let mut w = ChunkSeq::new[u64]();
    w.extend(in ws);
    let old = word(in w, Input::Old);
    let new = word(in w, Input::New);
    validate(inout q, in w, in t, old, Side::Old);
    validate(inout q, in w, in t, new, Side::New);
    for k in 0..ext_count(in w, old) {
        let name = ext_field(in w, old, k, Ext::Name);
        let e = find_ext(in w, new, name);
        if e != none() {
            if ext_field(in w, new, e, Ext::Arity) != ext_field(in w, old, k, Ext::Arity)
                || ext_field(in w, new, e, Ext::Mode) > ext_field(in w, old, k, Ext::Mode) {
                let path = path_node(inout q, none(), PathKind::Root, name);
                breaking(
                    inout q,
                    path,
                    "SV-Nominal",
                    "referenced external type contract became stricter",
                    "A caller relies on the old nominal type's arity or discard/copy permissions."
                );
            }
        }
    }
    for k in 0..export_count(in w, old) {
        let name = export_name(in w, old, k);
        let path = path_node(inout q, none(), PathKind::Root, name);
        let after = find_export(in w, new, name);
        if after != none() {
            declaration(inout q, in w, in t, new, path, export_decl(in w, old, k), after);
        } else {
            breaking(
                inout q,
                path,
                "SV-Export",
                "public declaration removed",
                "A caller still imports this public declaration."
            );
        }
    }
    q.class = if has_unsupported(in q) {
        Class::Unknown
    } else if q.found.len() != 0 || q.adapts.len() != 0 {
        Class::Major
    } else if old == new {
        Class::Patch
    } else {
        Class::Minor
    };
    finish_paths(inout q, in w, in t);
    q
}
