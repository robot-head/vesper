//! Relocatable data frames for suspended native computations.
//!
//! Stored addresses name a live frame and byte offset; no address points into a
//! raw host pointer. Machine code, continuation entry points, and drop plans
//! belong to the caller.

pub copy struct FrameId {
    pub bits: u64,
}

pub copy struct Address {
    pub frame: FrameId,
    pub offset: u32,
}

pub copy enum FrameError {
    Allocation,
    ExhaustedIds,
    InvalidSize,
    StaleFrame,
    OutOfBounds,
    NotTopFrame,
}

copy struct Frame {
    id: FrameId,
    segment: u64,
    start: u64,
    length: u64,
}

pub struct FrameStack {
    segment_size: u64,
    seg_bytes: ChunkSeq[u8],
    seg_bases: ChunkSeq[u64],
    seg_caps: ChunkSeq[u64],
    seg_used: ChunkSeq[u64],
    frames: ChunkSeq[Frame],
    next_id: u64,
}

fn u64_at(in seq: ChunkSeq[u64], idx: u64) -> u64 {
    match seq.try_get(idx) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

fn u8_at(in seq: ChunkSeq[u8], idx: u64) -> u8 {
    match seq.try_get(idx) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

fn frame_at(in seq: ChunkSeq[Frame], idx: u64) -> Frame {
    match seq.try_get(idx) {
        Option::Some(v) => v,
        Option::None => Frame {
            id: FrameId { bits: 0 },
            segment: 0,
            start: 0,
            length: 0,
        },
    }
}

fn align_up_8(length: u64) -> (bool, u64) {
    let min_len = if length == 0 {
        1
    } else {
        length
    };
    let max_u64: u64 = wrapping_sub(0, 1);
    if min_len > wrapping_sub(max_u64, 7) {
        return (false, 0);
    }
    let aligned = wrapping_add(min_len, 7) & (!7);
    (true, aligned)
}

fn find_frame_index(in frames: ChunkSeq[Frame], target_bits: u64) -> (bool, u64) {
    let mut lo: u64 = 0;
    let mut hi: u64 = frames.len();
    loop {
        if lo >= hi {
            break;
        }
        let half = wrapping_shr_u64(wrapping_sub(hi, lo), 1);
        let mid = wrapping_add(lo, half);
        let mid_bits = frame_at(in frames, mid).id.bits;
        if mid_bits == target_bits {
            return (true, mid);
        }
        if mid_bits < target_bits {
            lo = wrapping_add(mid, 1);
        } else {
            hi = mid;
        }
    }
    (false, 0)
}

pub fn frame_stack_new(segment_size: u64) -> FrameStack eff [Fail[FrameError]] {
    if segment_size == 0 || segment_size > 4294967295 {
        return Fail::raise(FrameError::InvalidSize);
    }
    FrameStack {
        segment_size: segment_size,
        seg_bytes: ChunkSeq::new[u8](),
        seg_bases: ChunkSeq::new[u64](),
        seg_caps: ChunkSeq::new[u64](),
        seg_used: ChunkSeq::new[u64](),
        frames: ChunkSeq::new[Frame](),
        next_id: 1,
    }
}

pub fn frame_stack_depth(in stack: FrameStack) -> u64 {
    stack.frames.len()
}

pub fn frame_stack_segments(in stack: FrameStack) -> u64 {
    stack.seg_caps.len()
}

pub fn frame_stack_bytes(in stack: FrameStack) -> u64 {
    let mut total: u64 = 0;
    let n = stack.frames.len();
    for i in 0..n {
        total = wrapping_add(total, frame_at(in stack.frames, i).length);
    }
    total
}

pub fn frame_stack_live_id(in stack: FrameStack, bits: u64) -> FrameId eff [Fail[FrameError]] {
    let (found, _idx) = find_frame_index(in stack.frames, bits);
    if !found {
        return Fail::raise(FrameError::StaleFrame);
    }
    FrameId { bits: bits }
}

fn resolve_range(
    in stack: FrameStack,
    address: Address,
    length: u64,
) -> u64 eff [Fail[FrameError]] {
    let (found, idx) = find_frame_index(in stack.frames, address.frame.bits);
    if !found {
        return Fail::raise(FrameError::StaleFrame);
    }
    let frame = frame_at(in stack.frames, idx);
    let offset = widen_u64(address.offset);
    let max_u64: u64 = wrapping_sub(0, 1);
    if offset > wrapping_sub(max_u64, length) {
        return Fail::raise(FrameError::OutOfBounds);
    }
    let end = wrapping_add(offset, length);
    if end > frame.length {
        return Fail::raise(FrameError::OutOfBounds);
    }
    let seg_base = u64_at(in stack.seg_bases, frame.segment);
    wrapping_add(wrapping_add(seg_base, frame.start), offset)
}

pub fn frame_stack_push(inout stack: FrameStack, length: u32) -> FrameId eff [Fail[FrameError]] {
    let id_bits = stack.next_id;
    let max_u64: u64 = wrapping_sub(0, 1);
    if id_bits == max_u64 {
        return Fail::raise(FrameError::ExhaustedIds);
    }
    let next = wrapping_add(id_bits, 1);
    let len_u64 = widen_u64(length);
    let (ok_align, aligned) = align_up_8(len_u64);
    if !ok_align {
        return Fail::raise(FrameError::InvalidSize);
    }
    let seg_count = stack.seg_caps.len();
    let need_segment = if seg_count == 0 {
        true
    } else {
        let last = wrapping_sub(seg_count, 1);
        let cap = u64_at(in stack.seg_caps, last);
        let used = u64_at(in stack.seg_used, last);
        wrapping_sub(cap, used) < aligned
    };
    if need_segment {
        let cap = if stack.segment_size > aligned {
            stack.segment_size
        } else {
            aligned
        };
        let base = stack.seg_bytes.len();
        for _i in 0..cap {
            stack.seg_bytes.push(0);
        }
        stack.seg_bases.push(base);
        stack.seg_caps.push(cap);
        stack.seg_used.push(0);
    }
    let seg_idx = wrapping_sub(stack.seg_caps.len(), 1);
    let seg_base = u64_at(in stack.seg_bases, seg_idx);
    let start = u64_at(in stack.seg_used, seg_idx);
    for k in 0..aligned {
        let _ok = stack.seg_bytes.try_set(wrapping_add(wrapping_add(seg_base, start), k), 0);
    }
    let _ok_u = stack.seg_used.try_set(seg_idx, wrapping_add(start, aligned));
    let id = FrameId { bits: id_bits };
    stack.frames.push(
        Frame {
            id: id,
            segment: seg_idx,
            start: start,
            length: len_u64,
        }
    );
    stack.next_id = next;
    id
}

pub fn frame_stack_read(
    in stack: FrameStack,
    address: Address,
    length: u64,
) -> ChunkSeq[u8] eff [Fail[FrameError]] {
    let base = resolve_range(in stack, address, length);
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for i in 0..length {
        out.push(u8_at(in stack.seg_bytes, wrapping_add(base, i)));
    }
    out
}

pub fn frame_stack_write(
    inout stack: FrameStack,
    address: Address,
    in bytes: Slice[u8],
) -> () eff [Fail[FrameError]] {
    let len = bytes.len();
    let base = resolve_range(in stack, address, len);
    for i in 0..len {
        let b = match bytes.try_get(i) {
            Option::Some(v) => v,
            Option::None => 0,
        };
        let _ok = stack.seg_bytes.try_set(wrapping_add(base, i), b);
    }
}

pub fn frame_stack_read_word(in stack: FrameStack, address: Address) -> u64 eff [Fail[FrameError]] {
    let base = resolve_range(in stack, address, 8);
    let mut val: u64 = 0;
    for i in 0..8 {
        let idx = wrapping_u64(i);
        let shift = wrapping_u32(wrapping_mul(idx, 8));
        let b = widen_u64(u8_at(in stack.seg_bytes, wrapping_add(base, idx)));
        val = val | wrapping_shl_u64(b, shift);
    }
    val
}

pub fn frame_stack_write_word(
    inout stack: FrameStack,
    address: Address,
    value: u64,
) -> () eff [Fail[FrameError]] {
    let base = resolve_range(in stack, address, 8);
    for i in 0..8 {
        let idx = wrapping_u64(i);
        let shift = wrapping_u32(wrapping_mul(idx, 8));
        let b = wrapping_u8(wrapping_shr_u64(value, shift) & 255);
        let _ok = stack.seg_bytes.try_set(wrapping_add(base, idx), b);
    }
}

pub fn frame_stack_write_address(
    inout stack: FrameStack,
    destination: Address,
    value: Address,
) -> () eff [Fail[FrameError]] {
    let _check = resolve_range(in stack, value, 0);
    let base = resolve_range(in stack, destination, 16);
    for i in 0..8 {
        let idx = wrapping_u64(i);
        let shift = wrapping_u32(wrapping_mul(idx, 8));
        let b = wrapping_u8(wrapping_shr_u64(value.frame.bits, shift) & 255);
        let _ok = stack.seg_bytes.try_set(wrapping_add(base, idx), b);
    }
    let off = widen_u64(value.offset);
    for j in 0..4 {
        let jdx = wrapping_u64(j);
        let shift = wrapping_u32(wrapping_mul(jdx, 8));
        let b = wrapping_u8(wrapping_shr_u64(off, shift) & 255);
        let _ok = stack.seg_bytes.try_set(wrapping_add(wrapping_add(base, 8), jdx), b);
    }
    for z in 12..16 {
        let _ok = stack.seg_bytes.try_set(wrapping_add(base, wrapping_u64(z)), 0);
    }
}

pub fn frame_stack_read_address(
    in stack: FrameStack,
    source: Address,
) -> Address eff [Fail[FrameError]] {
    let base = resolve_range(in stack, source, 16);
    let mut bits: u64 = 0;
    for i in 0..8 {
        let idx = wrapping_u64(i);
        let shift = wrapping_u32(wrapping_mul(idx, 8));
        let b = widen_u64(u8_at(in stack.seg_bytes, wrapping_add(base, idx)));
        bits = bits | wrapping_shl_u64(b, shift);
    }
    let mut off: u32 = 0;
    for j in 0..4 {
        let jdx = wrapping_u64(j);
        let shift = wrapping_u32(wrapping_mul(jdx, 8));
        let b = widen_u32(u8_at(in stack.seg_bytes, wrapping_add(wrapping_add(base, 8), jdx)));
        off = off | wrapping_shl_u32(b, shift);
    }
    let id = frame_stack_live_id(in stack, bits);
    let addr = Address { frame: id, offset: off };
    let _check = resolve_range(in stack, addr, 0);
    addr
}

pub fn frame_stack_pop(
    inout stack: FrameStack,
    id: FrameId
) -> ChunkSeq[u8] eff [Fail[FrameError]] {
    let n = stack.frames.len();
    if n == 0 {
        return Fail::raise(FrameError::StaleFrame);
    }
    let top = frame_at(in stack.frames, wrapping_sub(n, 1));
    if top.id.bits != id.bits {
        let (found, _idx) = find_frame_index(in stack.frames, id.bits);
        if found {
            return Fail::raise(FrameError::NotTopFrame);
        }
        return Fail::raise(FrameError::StaleFrame);
    }
    let seg_base = u64_at(in stack.seg_bases, top.segment);
    let mut owned: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for i in 0..top.length {
        owned.push(u8_at(in stack.seg_bytes, wrapping_add(wrapping_add(seg_base, top.start), i)));
    }
    let _popped = stack.frames.pop();
    let _ok_u = stack.seg_used.try_set(top.segment, top.start);
    loop {
        if stack.seg_caps.len() == 0 {
            break;
        }
        let last_idx = wrapping_sub(stack.seg_caps.len(), 1);
        if u64_at(in stack.seg_used, last_idx) == 0 {
            let cap = u64_at(in stack.seg_caps, last_idx);
            let _c = stack.seg_caps.pop();
            let _u = stack.seg_used.pop();
            let _b = stack.seg_bases.pop();
            for _k in 0..cap {
                let _byte = stack.seg_bytes.pop();
            }
        } else {
            break;
        }
    }
    owned
}

pub fn frame_stack_relocate(inout stack: FrameStack) -> () {
    let mut replacements: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let n = stack.seg_bytes.len();
    for i in 0..n {
        replacements.push(u8_at(in stack.seg_bytes, i));
    }
    stack.seg_bytes = replacements;
}

pub copy struct EpollPoller {
    pub fd: i32,
}

pub copy struct EpollArmResult {
    // 0 = Registered, 1 = AlwaysReady (EPERM), 2 = Error
    pub status: u32,
    pub errno: u32,
}

pub copy struct EpollWaitResult {
    pub ok: bool,
    pub fired: bool,
    pub token: u64,
    pub events: u32,
    pub errno: u32,
}

fn epoll_mask(interest: u32) -> u32 {
    let base = PulseSys::EPOLLONESHOT | PulseSys::EPOLLRDHUP;
    if interest == 0 {
        base | PulseSys::EPOLLIN
    } else {
        base | PulseSys::EPOLLOUT
    }
}

fn make_epoll_event(events: u32, token: u64) -> EpollEvent {
    let lo = wrapping_u32(token);
    let hi = wrapping_u32(wrapping_shr_u64(token, 32));
    if PulseSys::EPOLL_DATA_WORD == 1 {
        EpollEvent {
            w0: events,
            w1: lo,
            w2: hi,
            w3: 0,
        }
    } else {
        EpollEvent {
            w0: events,
            w1: 0,
            w2: lo,
            w3: hi,
        }
    }
}

fn epoll_event_token(ev: EpollEvent) -> u64 {
    let (lo, hi) = if PulseSys::EPOLL_DATA_WORD == 1 {
        (ev.w1, ev.w2)
    } else {
        (ev.w2, ev.w3)
    };
    widen_u64(lo) | wrapping_shl_u64(widen_u64(hi), 32)
}

pub fn epoll_new() -> Option[EpollPoller] eff [Ffi[PulseSys]] {
    let (fd, _) = PulseSys::epoll_create1(PulseSys::EPOLL_CLOEXEC);
    if fd < 0 {
        return Option::None;
    }
    Option::Some(EpollPoller { fd: fd })
}

pub fn epoll_arm(
    in poller: EpollPoller,
    fd: i32,
    interest: u32,
    token: u64,
) -> EpollArmResult eff [Ffi[PulseSys]] {
    let ev = make_epoll_event(epoll_mask(interest), token);
    let (rc, err) = PulseSys::epoll_ctl_add_mod(poller.fd, PulseSys::EPOLL_CTL_ADD, fd, in ev);
    if rc >= 0 {
        return EpollArmResult { status: 0, errno: 0 };
    }
    if err == PulseSys::EPERM_ERR {
        return EpollArmResult { status: 1, errno: 0 };
    }
    EpollArmResult { status: 2, errno: err }
}

pub fn epoll_rearm(
    in poller: EpollPoller,
    fd: i32,
    interest: u32,
    token: u64,
) -> (bool, u32) eff [Ffi[PulseSys]] {
    let ev = make_epoll_event(epoll_mask(interest), token);
    let (rc, err) = PulseSys::epoll_ctl_add_mod(poller.fd, PulseSys::EPOLL_CTL_MOD, fd, in ev);
    if rc >= 0 {
        (true, 0)
    } else {
        (false, err)
    }
}

pub fn epoll_release(in poller: EpollPoller, fd: i32) -> (bool, u32) eff [Ffi[PulseSys]] {
    let (rc, err) = PulseSys::epoll_ctl_del(poller.fd, PulseSys::EPOLL_CTL_DEL, fd, 0);
    if rc >= 0 {
        (true, 0)
    } else {
        (false, err)
    }
}

pub fn epoll_wait_one(
    in poller: EpollPoller,
    timeout_ms: i32
) -> EpollWaitResult eff [Ffi[PulseSys]] {
    let mut ev = EpollEvent {
        w0: 0,
        w1: 0,
        w2: 0,
        w3: 0,
    };
    let (rc, err) = PulseSys::epoll_wait(poller.fd, inout ev, 1, timeout_ms);
    if rc < 0 {
        if err == PulseSys::EINTR_ERR {
            return EpollWaitResult {
                ok: true,
                fired: false,
                token: 0,
                events: 0,
                errno: 0,
            };
        }
        return EpollWaitResult {
            ok: false,
            fired: false,
            token: 0,
            events: 0,
            errno: err,
        };
    }
    if rc == 0 {
        return EpollWaitResult {
            ok: true,
            fired: false,
            token: 0,
            events: 0,
            errno: 0,
        };
    }
    EpollWaitResult {
        ok: true,
        fired: true,
        token: epoll_event_token(ev),
        events: ev.w0,
        errno: 0,
    }
}

pub fn epoll_close(in poller: EpollPoller) -> () eff [Ffi[PulseSys]] {
    let _ = PulseSys::close(poller.fd);
}

pub fn epoll_pipe_roundtrip_check() -> u64 eff [Ffi[PulseSys]] {
    let poller = match epoll_new() {
        Option::Some(p) => p,
        Option::None => return 0,
    };
    // Empty epoll_wait(timeout=0) must return ok=true, fired=false.
    let w0 = epoll_wait_one(in poller, 0);
    if !w0.ok || w0.fired {
        epoll_close(in poller);
        return 1;
    }
    let mut fds = PipeFds {
        read_fd: -1,
        write_fd: -1,
    };
    let (prc, _) = PulseSys::pipe2(inout fds, PulseSys::EPOLL_CLOEXEC);
    if prc < 0 {
        epoll_close(in poller);
        return 2;
    }
    let token: u64 = 1311768467463790320;
    let arm = epoll_arm(in poller, fds.read_fd, 0, token);
    if arm.status != 0 {
        let _ = PulseSys::close(fds.read_fd);
        let _ = PulseSys::close(fds.write_fd);
        epoll_close(in poller);
        return 3;
    }
    // Before writing, pipe read end is not ready.
    let w1 = epoll_wait_one(in poller, 0);
    if !w1.ok || w1.fired {
        let _ = PulseSys::close(fds.read_fd);
        let _ = PulseSys::close(fds.write_fd);
        epoll_close(in poller);
        return 4;
    }
    let b: u8 = 42;
    let (wrc, _) = PulseSys::write_byte(fds.write_fd, in b, 1);
    if wrc != 1 {
        let _ = PulseSys::close(fds.read_fd);
        let _ = PulseSys::close(fds.write_fd);
        epoll_close(in poller);
        return 5;
    }
    let w2 = epoll_wait_one(in poller, 1000);
    if !w2.ok || !w2.fired || w2.token != token {
        let _ = PulseSys::close(fds.read_fd);
        let _ = PulseSys::close(fds.write_fd);
        epoll_close(in poller);
        return 6;
    }
    let (rel_ok, _) = epoll_release(in poller, fds.read_fd);
    let _ = PulseSys::close(fds.read_fd);
    let _ = PulseSys::close(fds.write_fd);
    epoll_close(in poller);
    if !rel_ok {
        return 7;
    }
    100
}

pub copy enum DriverKind {
    IoUring,
    Epoll,
    Kqueue,
    Iocp,
}

pub copy struct RequestId {
    pub bits: u64,
}

pub copy enum Operation {
    Read,
    Write,
}

pub copy enum DriverError {
    QueueFull,
    UnknownRequest,
    InvalidCapacity,
}

pub copy struct RequestSlot {
    pub id: RequestId,
    pub fd: i32,
    pub op: Operation,
    pub offset: u64,
    pub len: u64,
    pub token: u64,
    pub cancelled: bool,
}

pub copy struct CompletionSlot {
    pub id: RequestId,
    pub ok: bool,
    pub bytes: u64,
    pub errno: u32,
    pub cancelled: bool,
}

pub struct ReadinessQueue {
    kind: DriverKind,
    capacity: u64,
    next_id: u64,
    waiting: ChunkSeq[RequestSlot],
    ready: ChunkSeq[CompletionSlot],
}

fn ascii_lower(b: u8) -> u8 {
    if b >= 65 && b <= 90 {
        wrapping_u8(wrapping_add(widen_u64(b), 32))
    } else {
        b
    }
}

fn is_ascii_ws(b: u8) -> bool {
    b == 32 || b == 9 || b == 10 || b == 13
}

fn slice_byte(in s: Slice[u8], i: u64) -> u8 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

fn eq_trimmed_lower(in name: Slice[u8], a: u64, b: u64, in target: Slice[u8]) -> bool {
    let len = wrapping_sub(b, a);
    if len != target.len() {
        return false;
    }
    for i in 0..len {
        let ch = ascii_lower(slice_byte(in name, wrapping_add(a, i)));
        let tc = slice_byte(in target, i);
        if ch != tc {
            return false;
        }
    }
    true
}

pub fn driver_kind_id(k: DriverKind) -> u32 {
    match k {
        DriverKind::IoUring => 0,
        DriverKind::Epoll => 1,
        DriverKind::Kqueue => 2,
        DriverKind::Iocp => 3,
    }
}

pub fn driver_kind_from_name(in name: Slice[u8]) -> Option[DriverKind] {
    let mut a: u64 = 0;
    let mut b: u64 = name.len();
    loop {
        if a >= b {
            break;
        }
        if !is_ascii_ws(slice_byte(in name, a)) {
            break;
        }
        a = wrapping_add(a, 1);
    }
    loop {
        if b <= a {
            break;
        }
        if !is_ascii_ws(slice_byte(in name, wrapping_sub(b, 1))) {
            break;
        }
        b = wrapping_sub(b, 1);
    }
    if eq_trimmed_lower(in name, a, b, in "io_uring".as_bytes())
        || eq_trimmed_lower(in name, a, b, in "io-uring".as_bytes())
        || eq_trimmed_lower(in name, a, b, in "uring".as_bytes()) {
        return Option::Some(DriverKind::IoUring);
    }
    if eq_trimmed_lower(in name, a, b, in "epoll".as_bytes()) {
        return Option::Some(DriverKind::Epoll);
    }
    if eq_trimmed_lower(in name, a, b, in "kqueue".as_bytes()) {
        return Option::Some(DriverKind::Kqueue);
    }
    if eq_trimmed_lower(in name, a, b, in "iocp".as_bytes()) {
        return Option::Some(DriverKind::Iocp);
    }
    Option::None
}

fn slot_at(in seq: ChunkSeq[RequestSlot], idx: u64) -> RequestSlot {
    match seq.try_get(idx) {
        Option::Some(v) => v,
        Option::None => RequestSlot {
            id: RequestId { bits: 0 },
            fd: -1,
            op: Operation::Read,
            offset: 0,
            len: 0,
            token: 0,
            cancelled: false,
        },
    }
}

pub fn readiness_queue_new(
    kind: DriverKind,
    capacity: u64
) -> ReadinessQueue eff [Fail[DriverError]] {
    if capacity == 0 {
        return Fail::raise(DriverError::InvalidCapacity);
    }
    ReadinessQueue {
        kind: kind,
        capacity: capacity,
        next_id: 1,
        waiting: ChunkSeq::new[RequestSlot](),
        ready: ChunkSeq::new[CompletionSlot](),
    }
}

pub fn readiness_queue_kind(in q: ReadinessQueue) -> DriverKind {
    q.kind
}

pub fn readiness_queue_pending(in q: ReadinessQueue) -> u64 {
    wrapping_add(q.waiting.len(), q.ready.len())
}

pub fn readiness_queue_in_flight(in q: ReadinessQueue) -> u64 {
    q.waiting.len()
}

pub fn readiness_queue_has_ready(in q: ReadinessQueue) -> bool {
    q.ready.len() > 0
}

pub fn readiness_queue_submit(
    inout q: ReadinessQueue,
    fd: i32,
    op: Operation,
    offset: u64,
    len: u64,
    token: u64,
) -> RequestId eff [Fail[DriverError]] {
    if readiness_queue_pending(in q) >= q.capacity {
        return Fail::raise(DriverError::QueueFull);
    }
    let id = RequestId { bits: q.next_id };
    q.next_id = wrapping_add(q.next_id, 1);
    q.waiting.push(
        RequestSlot {
            id: id,
            fd: fd,
            op: op,
            offset: offset,
            len: len,
            token: token,
            cancelled: false,
        }
    );
    id
}

pub fn readiness_queue_mark_cancelled(inout q: ReadinessQueue, id: RequestId) -> bool {
    let n = q.waiting.len();
    for i in 0..n {
        let mut s = slot_at(in q.waiting, i);
        if s.id.bits == id.bits {
            s.cancelled = true;
            let _ok = q.waiting.try_set(i, s);
            return true;
        }
    }
    false
}

pub fn readiness_queue_cancel_all(inout q: ReadinessQueue) -> u64 {
    let n = q.waiting.len();
    for i in 0..n {
        let mut s = slot_at(in q.waiting, i);
        s.cancelled = true;
        let _ok = q.waiting.try_set(i, s);
    }
    n
}

pub fn readiness_queue_complete(
    inout q: ReadinessQueue,
    id: RequestId,
    ok: bool,
    bytes: u64,
    errno: u32,
) -> () eff [Fail[DriverError]] {
    let n = q.waiting.len();
    let mut found = false;
    let mut found_idx: u64 = 0;
    let mut was_cancelled = false;
    for i in 0..n {
        let s = slot_at(in q.waiting, i);
        if s.id.bits == id.bits {
            found = true;
            found_idx = i;
            was_cancelled = s.cancelled;
            break;
        }
    }
    if !found {
        return Fail::raise(DriverError::UnknownRequest);
    }
    let last = wrapping_sub(n, 1);
    for j in found_idx..last {
        let next_slot = slot_at(in q.waiting, wrapping_add(j, 1));
        let _ok = q.waiting.try_set(j, next_slot);
    }
    let _popped = q.waiting.pop();
    q.ready.push(
        CompletionSlot {
            id: id,
            ok: ok,
            bytes: bytes,
            errno: errno,
            cancelled: was_cancelled,
        }
    );
}

pub fn readiness_queue_take_ready(inout q: ReadinessQueue) -> ChunkSeq[CompletionSlot] {
    replace(inout q.ready, ChunkSeq::new[CompletionSlot]())
}

pub copy enum FiberEvent {
    Start,
    Yield,
    IoOk(u64),
    IoErr(u32),
    Cancelled,
}

pub copy enum StepKind {
    Complete(u64),
    Failed(u32),
    Yield(u64),
    Io(u64),
}

pub copy struct ReadyEntry {
    pub fiber_id: u64,
    pub event: FiberEvent,
}

pub struct SchedulerState {
    ready: ChunkSeq[ReadyEntry],
    ready_head: u64,
    completed: ChunkSeq[u64],
    completed_head: u64,
    failures: ChunkSeq[u32],
    failures_head: u64,
    in_flight: u64,
}

fn ready_at(in seq: ChunkSeq[ReadyEntry], idx: u64) -> ReadyEntry {
    match seq.try_get(idx) {
        Option::Some(v) => v,
        Option::None => ReadyEntry {
            fiber_id: 0,
            event: FiberEvent::Start,
        },
    }
}

pub fn scheduler_new() -> SchedulerState {
    SchedulerState {
        ready: ChunkSeq::new[ReadyEntry](),
        ready_head: 0,
        completed: ChunkSeq::new[u64](),
        completed_head: 0,
        failures: ChunkSeq::new[u32](),
        failures_head: 0,
        in_flight: 0,
    }
}

pub fn scheduler_spawn(inout s: SchedulerState, fiber_id: u64) -> () {
    s.ready.push(
        ReadyEntry {
            fiber_id: fiber_id,
            event: FiberEvent::Start,
        }
    );
}

pub fn scheduler_ready_count(in s: SchedulerState) -> u64 {
    wrapping_sub(s.ready.len(), s.ready_head)
}

pub fn scheduler_completed_count(in s: SchedulerState) -> u64 {
    wrapping_sub(s.completed.len(), s.completed_head)
}

pub fn scheduler_failure_count(in s: SchedulerState) -> u64 {
    wrapping_sub(s.failures.len(), s.failures_head)
}

pub fn scheduler_is_idle(in s: SchedulerState) -> bool {
    scheduler_ready_count(in s) == 0 && s.in_flight == 0
}

pub fn scheduler_cancel_all(inout s: SchedulerState) -> u64 {
    let n = s.ready.len();
    let mut marked: u64 = 0;
    for i in s.ready_head..n {
        let mut entry = ready_at(in s.ready, i);
        entry.event = FiberEvent::Cancelled;
        let _ok = s.ready.try_set(i, entry);
        marked = wrapping_add(marked, 1);
    }
    marked
}

pub fn scheduler_pop_ready(inout s: SchedulerState) -> Option[ReadyEntry] {
    if s.ready_head >= s.ready.len() {
        return Option::None;
    }
    let entry = ready_at(in s.ready, s.ready_head);
    s.ready_head = wrapping_add(s.ready_head, 1);
    if s.ready_head == s.ready.len() {
        s.ready = ChunkSeq::new[ReadyEntry]();
        s.ready_head = 0;
    }
    Option::Some(entry)
}

pub fn scheduler_apply_step(inout s: SchedulerState, step: StepKind) -> () {
    match step {
        StepKind::Complete(val) => s.completed.push(val),
        StepKind::Failed(code) => s.failures.push(code),
        StepKind::Yield(fiber_id) => {
            s.ready.push(
                ReadyEntry {
                    fiber_id: fiber_id,
                    event: FiberEvent::Yield,
                }
            );
        }
        StepKind::Io(_req_id) => {
            s.in_flight = wrapping_add(s.in_flight, 1);
        }
    }
}

pub fn scheduler_enqueue_io(
    inout s: SchedulerState,
    fiber_id: u64,
    ok: bool,
    bytes: u64,
    errno: u32,
) -> () {
    if s.in_flight > 0 {
        s.in_flight = wrapping_sub(s.in_flight, 1);
    }
    let ev = if ok {
        FiberEvent::IoOk(bytes)
    } else {
        FiberEvent::IoErr(errno)
    };
    s.ready.push(
        ReadyEntry {
            fiber_id: fiber_id,
            event: ev,
        }
    );
}

pub fn scheduler_take_completed(inout s: SchedulerState) -> Option[u64] {
    if s.completed_head >= s.completed.len() {
        return Option::None;
    }
    let v = match s.completed.try_get(s.completed_head) {
        Option::Some(x) => x,
        Option::None => 0,
    };
    s.completed_head = wrapping_add(s.completed_head, 1);
    if s.completed_head == s.completed.len() {
        s.completed = ChunkSeq::new[u64]();
        s.completed_head = 0;
    }
    Option::Some(v)
}

pub fn scheduler_take_failure(inout s: SchedulerState) -> Option[u32] {
    if s.failures_head >= s.failures.len() {
        return Option::None;
    }
    let v = match s.failures.try_get(s.failures_head) {
        Option::Some(x) => x,
        Option::None => 0,
    };
    s.failures_head = wrapping_add(s.failures_head, 1);
    if s.failures_head == s.failures.len() {
        s.failures = ChunkSeq::new[u32]();
        s.failures_head = 0;
    }
    Option::Some(v)
}

pub copy enum Preference {
    Auto,
    Only(DriverKind),
}

pub copy enum SelectError {
    UnknownDriver,
    NotCompiled(DriverKind),
    Unavailable,
}

fn trim_ascii_bounds(in s: Slice[u8]) -> (u64, u64) {
    let mut a: u64 = 0;
    let mut b: u64 = s.len();
    loop {
        if a >= b {
            break;
        }
        if !is_ascii_ws(slice_byte(in s, a)) {
            break;
        }
        a = wrapping_add(a, 1);
    }
    loop {
        if b <= a {
            break;
        }
        if !is_ascii_ws(slice_byte(in s, wrapping_sub(b, 1))) {
            break;
        }
        b = wrapping_sub(b, 1);
    }
    (a, b)
}

pub fn preference_parse(in value: Slice[u8]) -> Preference eff [Fail[SelectError]] {
    let (a, b) = trim_ascii_bounds(in value);
    if a == b || eq_trimmed_lower(in value, a, b, in "auto".as_bytes()) {
        return Preference::Auto;
    }
    match driver_kind_from_name(in value) {
        Option::Some(k) => Preference::Only(k),
        Option::None => Fail::raise(SelectError::UnknownDriver),
    }
}

pub fn select_driver_for_host(pref: Preference) -> DriverKind eff [Fail[SelectError]] {
    match pref {
        Preference::Only(k) => {
            if !driver_kind_compiled(k) {
                return Fail::raise(SelectError::NotCompiled(k));
            }
            k
        }
        Preference::Auto => {
            let order = host_order();
            match order.try_get(0) {
                Option::Some(k) => k,
                Option::None => Fail::raise(SelectError::Unavailable),
            }
        }
    }
}

pub fn driver_kind_compiled(k: DriverKind) -> bool {
    match k {
        DriverKind::IoUring => true,
        DriverKind::Epoll => true,
        _ => false
    }
}

pub fn host_order() -> ChunkSeq[DriverKind] {
    let mut out = ChunkSeq::new[DriverKind]();
    out.push(DriverKind::IoUring);
    out.push(DriverKind::Epoll);
    out
}

// Deterministic work-stealing fiber pool (§12.4).

pub copy struct FiberId {
    pub bits: u64,
}

pub copy struct PoolConfig {
    pub workers: u64,
    pub seed: u64,
    pub lifo_slot: bool,
    pub driver_wakeup: bool,
    pub pin_cores: bool,
    pub keep_results: bool,
}

pub fn max_workers() -> u64 {
    1024
}

pub fn default_pool_config(workers: u64) -> PoolConfig {
    PoolConfig {
        workers: workers,
        seed: 0,
        lifo_slot: true,
        driver_wakeup: true,
        pin_cores: false,
        keep_results: true,
    }
}

pub copy struct WorkerStats {
    pub resumed: u64,
    pub stolen: u64,
    pub steal_attempts: u64,
    pub submitted: u64,
    pub parked: u64,
    pub pinned_core: Option[u64],
}

pub copy enum TraceEvent {
    TraceStart,
    TraceYield,
    TraceIo,
    TraceCancelled,
}

pub copy struct TraceEntry {
    pub step: u64,
    pub worker: u64,
    pub fiber: FiberId,
    pub event: TraceEvent,
    pub stolen_from: Option[u64],
}

pub copy enum PoolError {
    InvalidWorkers(u64),
    NoSuchWorker(u64),
    PoolClosed,
}

pub copy struct CompletedFiber {
    pub id: FiberId,
    pub tag: u64,
}

pub copy struct FailedFiber {
    pub id: FiberId,
    pub code: u64,
}

pub struct PoolOutput {
    pub completed: ChunkSeq[CompletedFiber],
    pub failures: ChunkSeq[FailedFiber],
    pub workers: ChunkSeq[WorkerStats],
    pub trace: ChunkSeq[TraceEntry],
    pub abandoned: u64,
}

pub copy struct Rng {
    pub rng_state: u64,
}

pub fn rng_next(inout r: Rng) -> u64 {
    r.rng_state = wrapping_add(r.rng_state, 0x9e37_79b9_7f4a_7c15);
    let mut z = r.rng_state;
    z = wrapping_mul(z ^ (z >> 30), 0xbf58_476d_1ce4_e5b9);
    z = wrapping_mul(z ^ (z >> 27), 0x94d0_49bb_1331_11eb);
    z ^ (z >> 31)
}

pub fn rng_new(seed: u64, stream: u64) -> Rng {
    let mut r = Rng {
        rng_state: seed ^ wrapping_mul(stream, 0xa076_1d64_78bd_642f),
    };
    let _ = rng_next(inout r);
    r
}

pub fn rng_below(inout r: Rng, n: u64) -> u64 {
    if n == 0 {
        return 0;
    }
    let v = rng_next(inout r);
    handle Fail[RuntimeError] in {
        v % n
    } with {
        return x => x,
        raise(e, k) => 0,
    }
}

pub copy struct FiberTask {
    pub id: FiberId,
    pub home: Option[u64],
    pub remaining_yields: u64,
    pub fail_on_complete: bool,
    pub result_tag: u64,
    pub spawn_child_yields: Option[u64],
    pub event: TraceEvent,
}

struct WorkerState {
    local: ChunkSeq[FiberTask],
    pinned: ChunkSeq[FiberTask],
    lifo: Option[FiberTask],
    rng: Rng,
    ticks: u64,
    lifo_streak: u64,
    stats: WorkerStats,
}

pub struct SeededPool {
    pub config: PoolConfig,
    workers: ChunkSeq[WorkerState],
    injector: ChunkSeq[FiberTask],
    next_id: u64,
    live: u64,
    cancelled: bool,
    closed: bool,
    trace_step: u64,
    completed: ChunkSeq[CompletedFiber],
    failures: ChunkSeq[FailedFiber],
    trace: ChunkSeq[TraceEntry],
}

fn empty_stats() -> WorkerStats {
    WorkerStats {
        resumed: 0,
        stolen: 0,
        steal_attempts: 0,
        submitted: 0,
        parked: 0,
        pinned_core: Option::None,
    }
}

pub fn new_seeded_pool(config: PoolConfig) -> Result[SeededPool, PoolError] {
    if config.workers == 0 || config.workers > max_workers() {
        return Result::Err(PoolError::InvalidWorkers(config.workers));
    }
    let mut workers: ChunkSeq[WorkerState] = ChunkSeq::new();
    let mut i: u64 = 0;
    loop {
        if i >= config.workers {
            break;
        }
        workers.push(
            WorkerState {
                local: ChunkSeq::new(),
                pinned: ChunkSeq::new(),
                lifo: Option::None,
                rng: rng_new(config.seed, wrapping_add(i, 1)),
                ticks: 0,
                lifo_streak: 0,
                stats: empty_stats(),
            }
        );
        i = wrapping_add(i, 1);
    }
    Result::Ok(
        SeededPool {
            config: config,
            workers: workers,
            injector: ChunkSeq::new(),
            next_id: 1,
            live: 0,
            cancelled: false,
            closed: false,
            trace_step: 0,
            completed: ChunkSeq::new(),
            failures: ChunkSeq::new(),
            trace: ChunkSeq::new(),
        }
    )
}

fn pop_front_task(inout q: ChunkSeq[FiberTask]) -> Option[FiberTask] {
    let mut rev: ChunkSeq[FiberTask] = ChunkSeq::new();
    loop {
        match q.pop() {
            Option::Some(t) => rev.push(t),
            Option::None => break,
        }
    }
    let first = rev.pop();
    loop {
        match rev.pop() {
            Option::Some(t) => q.push(t),
            Option::None => break,
        }
    }
    first
}

pub fn spawn_fiber(
    inout pool: SeededPool,
    yields: u64,
    fail_on_complete: bool,
    result_tag: u64,
    spawn_child_yields: Option[u64],
) -> Result[FiberId, PoolError] {
    if pool.closed {
        return Result::Err(PoolError::PoolClosed);
    }
    let id = FiberId { bits: pool.next_id };
    pool.next_id = wrapping_add(pool.next_id, 1);
    pool.live = wrapping_add(pool.live, 1);
    let ev = if pool.cancelled {
        TraceEvent::TraceCancelled
    } else {
        TraceEvent::TraceStart
    };
    pool.injector.push(
        FiberTask {
            id: id,
            home: Option::None,
            remaining_yields: yields,
            fail_on_complete: fail_on_complete,
            result_tag: result_tag,
            spawn_child_yields: spawn_child_yields,
            event: ev,
        }
    );
    Result::Ok(id)
}

pub fn spawn_pinned(
    inout pool: SeededPool,
    worker: u64,
    yields: u64,
    fail_on_complete: bool,
    result_tag: u64,
) -> Result[FiberId, PoolError] {
    if pool.closed {
        return Result::Err(PoolError::PoolClosed);
    }
    if worker >= pool.workers.len() {
        return Result::Err(PoolError::NoSuchWorker(worker));
    }
    let id = FiberId { bits: pool.next_id };
    pool.next_id = wrapping_add(pool.next_id, 1);
    pool.live = wrapping_add(pool.live, 1);
    let ev = if pool.cancelled {
        TraceEvent::TraceCancelled
    } else {
        TraceEvent::TraceStart
    };
    let task = FiberTask {
        id: id,
        home: Option::Some(worker),
        remaining_yields: yields,
        fail_on_complete: fail_on_complete,
        result_tag: result_tag,
        spawn_child_yields: Option::None,
        event: ev,
    };
    let _ = handle Fail[RuntimeError] in {
        pool.workers[worker].pinned.push(task);
        0
    } with {
        return x => x,
        raise(e, k) => 0,
    };
    Result::Ok(id)
}

pub fn cancel_pool(inout pool: SeededPool) {
    pool.cancelled = true;
}

fn mod_u64(a: u64, b: u64) -> u64 {
    if b == 0 {
        return 0;
    }
    handle Fail[RuntimeError] in {
        a % b
    } with {
        return x => x,
        raise(e, k) => 0,
    }
}

fn div_u64(a: u64, b: u64) -> u64 {
    if b == 0 {
        return 0;
    }
    handle Fail[RuntimeError] in {
        a / b
    } with {
        return x => x,
        raise(e, k) => 0,
    }
}

copy struct PickedJob {
    found: bool,
    task: FiberTask,
    stolen_from: Option[u64],
}

fn empty_task() -> FiberTask {
    FiberTask {
        id: FiberId { bits: 0 },
        home: Option::None,
        remaining_yields: 0,
        fail_on_complete: false,
        result_tag: 0,
        spawn_child_yields: Option::None,
        event: TraceEvent::TraceStart,
    }
}

fn try_steal_from(inout pool: SeededPool, thief: u64, victim: u64) -> PickedJob {
    let vlen = handle Fail[RuntimeError] in {
        pool.workers[victim].local.len()
    } with {
        return x => x,
        raise(e, k) => 0,
    };
    if vlen == 0 {
        return PickedJob {
            found: false,
            task: empty_task(),
            stolen_from: Option::None,
        };
    }
    let half = div_u64(wrapping_add(vlen, 1), 2);
    let take_n = if half > 32 {
        32
    } else if half == 0 {
        1
    } else {
        half
    };
    let mut stolen_batch: ChunkSeq[FiberTask] = ChunkSeq::new();
    let mut i: u64 = 0;
    loop {
        if i >= take_n {
            break;
        }
        let popped = handle Fail[RuntimeError] in {
            pop_front_task(inout pool.workers[victim].local)
        } with {
            return x => x,
            raise(e, k) => Option::None,
        };
        match popped {
            Option::Some(t) => stolen_batch.push(t),
            Option::None => break,
        }
        i = wrapping_add(i, 1);
    }
    let first_opt = pop_front_task(inout stolen_batch);
    let first = match first_opt {
        Option::Some(t) => t,
        Option::None => {
            return PickedJob {
                found: false,
                task: empty_task(),
                stolen_from: Option::None,
            };
        }
    };
    let mut extra: u64 = 0;
    loop {
        match pop_front_task(inout stolen_batch) {
            Option::Some(t) => {
                let _ = handle Fail[RuntimeError] in {
                    pool.workers[thief].local.push(t);
                    0
                } with {
                    return x => x,
                    raise(e, k) => 0,
                };
                extra = wrapping_add(extra, 1);
            }
            Option::None => break,
        }
    }
    let total_stolen = wrapping_add(1, extra);
    let _ = handle Fail[RuntimeError] in {
        pool.workers[thief]
            .stats
            .stolen = wrapping_add(pool.workers[thief].stats.stolen, total_stolen);
        0
    } with {
        return x => x,
        raise(e, k) => 0,
    };
    PickedJob {
        found: true,
        task: first,
        stolen_from: Option::Some(victim),
    }
}

fn next_job(inout pool: SeededPool, w: u64) -> PickedJob {
    let n = pool.workers.len();
    let ticks = handle Fail[RuntimeError] in {
        pool.workers[w].ticks = wrapping_add(pool.workers[w].ticks, 1);
        pool.workers[w].ticks
    } with {
        return x => x,
        raise(e, k) => 1,
    };
    if mod_u64(ticks, 61) == 0 {
        match pop_front_task(inout pool.injector) {
            Option::Some(t) => {
                return PickedJob {
                    found: true,
                    task: t,
                    stolen_from: Option::None,
                };
            }
            Option::None => {}
        }
    }
    let streak = handle Fail[RuntimeError] in {
        pool.workers[w].lifo_streak
    } with {
        return x => x,
        raise(e, k) => 0,
    };
    if streak < 3 {
        let lifo_opt = handle Fail[RuntimeError] in {
            replace(inout pool.workers[w].lifo, Option::None)
        } with {
            return x => x,
            raise(e, k) => Option::None,
        };
        match lifo_opt {
            Option::Some(t) => {
                let _ = handle Fail[RuntimeError] in {
                    pool.workers[w].lifo_streak = wrapping_add(streak, 1);
                    0
                } with {
                    return x => x,
                    raise(e, k) => 0,
                };
                return PickedJob {
                    found: true,
                    task: t,
                    stolen_from: Option::None,
                };
            }
            Option::None => {}
        }
    }
    let _ = handle Fail[RuntimeError] in {
        pool.workers[w].lifo_streak = 0;
        0
    } with {
        return x => x,
        raise(e, k) => 0,
    };
    let even = mod_u64(ticks, 2) == 0;
    let first_own = if even {
        handle Fail[RuntimeError] in {
            pop_front_task(inout pool.workers[w].pinned)
        } with {
            return x => x,
            raise(e, k) => Option::None,
        }
    } else {
        handle Fail[RuntimeError] in {
            pop_front_task(inout pool.workers[w].local)
        } with {
            return x => x,
            raise(e, k) => Option::None,
        }
    };
    match first_own {
        Option::Some(t) => {
            return PickedJob {
                found: true,
                task: t,
                stolen_from: Option::None,
            };
        }
        Option::None => {}
    }
    let second_own = if even {
        handle Fail[RuntimeError] in {
            pop_front_task(inout pool.workers[w].local)
        } with {
            return x => x,
            raise(e, k) => Option::None,
        }
    } else {
        handle Fail[RuntimeError] in {
            pop_front_task(inout pool.workers[w].pinned)
        } with {
            return x => x,
            raise(e, k) => Option::None,
        }
    };
    match second_own {
        Option::Some(t) => {
            return PickedJob {
                found: true,
                task: t,
                stolen_from: Option::None,
            };
        }
        Option::None => {}
    }
    let lifo_fb = handle Fail[RuntimeError] in {
        replace(inout pool.workers[w].lifo, Option::None)
    } with {
        return x => x,
        raise(e, k) => Option::None,
    };
    match lifo_fb {
        Option::Some(t) => {
            return PickedJob {
                found: true,
                task: t,
                stolen_from: Option::None,
            };
        }
        Option::None => {}
    }
    match pop_front_task(inout pool.injector) {
        Option::Some(t) => {
            return PickedJob {
                found: true,
                task: t,
                stolen_from: Option::None,
            };
        }
        Option::None => {}
    }
    if n < 2 {
        return PickedJob {
            found: false,
            task: empty_task(),
            stolen_from: Option::None,
        };
    }
    let start = handle Fail[RuntimeError] in {
        pool.workers[w]
            .stats
            .steal_attempts = wrapping_add(pool.workers[w].stats.steal_attempts, 1);
        rng_below(inout pool.workers[w].rng, n)
    } with {
        return x => x,
        raise(e, k) => 0,
    };
    let mut k: u64 = 0;
    loop {
        if k >= n {
            break;
        }
        let victim = mod_u64(wrapping_add(start, k), n);
        if victim != w {
            let stolen = try_steal_from(inout pool, w, victim);
            if stolen.found {
                return stolen;
            }
        }
        k = wrapping_add(k, 1);
    }
    PickedJob {
        found: false,
        task: empty_task(),
        stolen_from: Option::None,
    }
}

fn place_task(inout pool: SeededPool, w: u64, task: FiberTask, internal_spawn: bool) {
    match task.home {
        Option::Some(h) => {
            let _ = handle Fail[RuntimeError] in {
                pool.workers[h].pinned.push(task);
                0
            } with {
                return x => x,
                raise(e, k) => 0,
            };
        }
        Option::None => {
            if internal_spawn && pool.config.lifo_slot {
                let prev_lifo = handle Fail[RuntimeError] in {
                    replace(inout pool.workers[w].lifo, Option::Some(task))
                } with {
                    return x => x,
                    raise(e, k) => Option::None,
                };
                match prev_lifo {
                    Option::Some(displaced) => {
                        let _ = handle Fail[RuntimeError] in {
                            pool.workers[w].local.push(displaced);
                            0
                        } with {
                            return x => x,
                            raise(e, k) => 0,
                        };
                    }
                    Option::None => {}
                }
            } else {
                let _ = handle Fail[RuntimeError] in {
                    pool.workers[w].local.push(task);
                    0
                } with {
                    return x => x,
                    raise(e, k) => 0,
                };
            }
        }
    }
}

fn worker_step(inout pool: SeededPool, w: u64) -> bool {
    let job = next_job(inout pool, w);
    if !job.found {
        return false;
    }
    let t = job.task;
    let ev = if pool.cancelled {
        TraceEvent::TraceCancelled
    } else {
        t.event
    };
    let step_idx = pool.trace_step;
    pool.trace_step = wrapping_add(pool.trace_step, 1);
    pool.trace.push(
        TraceEntry {
            step: step_idx,
            worker: w,
            fiber: t.id,
            event: ev,
            stolen_from: job.stolen_from,
        }
    );
    let _ = handle Fail[RuntimeError] in {
        pool.workers[w].stats.resumed = wrapping_add(pool.workers[w].stats.resumed, 1);
        0
    } with {
        return x => x,
        raise(e, k) => 0,
    };
    match t.spawn_child_yields {
        Option::Some(cy) => {
            let cid = FiberId { bits: pool.next_id };
            pool.next_id = wrapping_add(pool.next_id, 1);
            pool.live = wrapping_add(pool.live, 1);
            let cev = if pool.cancelled {
                TraceEvent::TraceCancelled
            } else {
                TraceEvent::TraceStart
            };
            place_task(
                inout pool,
                w,
                FiberTask {
                    id: cid,
                    home: Option::None,
                    remaining_yields: cy,
                    fail_on_complete: false,
                    result_tag: cid.bits,
                    spawn_child_yields: Option::None,
                    event: cev,
                },
                true,
            );
        }
        Option::None => {}
    }
    if t.remaining_yields > 0 {
        let next_t = FiberTask {
            id: t.id,
            home: t.home,
            remaining_yields: wrapping_sub(t.remaining_yields, 1),
            fail_on_complete: t.fail_on_complete,
            result_tag: t.result_tag,
            spawn_child_yields: Option::None,
            event: TraceEvent::TraceYield,
        };
        place_task(inout pool, w, next_t, false);
    } else {
        if pool.config.keep_results {
            if t.fail_on_complete {
                pool.failures.push(FailedFiber { id: t.id, code: t.result_tag });
            } else {
                pool.completed.push(CompletedFiber { id: t.id, tag: t.result_tag });
            }
        }
        pool.live = wrapping_sub(pool.live, 1);
    }
    true
}

pub fn run_seeded(inout pool: SeededPool) -> PoolOutput {
    pool.closed = true;
    let n = pool.workers.len();
    let mut chooser = rng_new(pool.config.seed, 0);
    let mut idle_rounds: u64 = 0;
    let limit = wrapping_mul(n, 4);
    loop {
        if pool.live == 0 {
            break;
        }
        let w = rng_below(inout chooser, n);
        if worker_step(inout pool, w) {
            idle_rounds = 0;
            continue;
        }
        idle_rounds = wrapping_add(idle_rounds, 1);
        if idle_rounds >= limit {
            break;
        }
    }
    let mut wstats: ChunkSeq[WorkerStats] = ChunkSeq::new();
    let mut i: u64 = 0;
    loop {
        if i >= n {
            break;
        }
        let st = handle Fail[RuntimeError] in {
            pool.workers[i].stats
        } with {
            return x => x,
            raise(e, k) => empty_stats(),
        };
        wstats.push(st);
        i = wrapping_add(i, 1);
    }
    PoolOutput {
        completed: replace(inout pool.completed, ChunkSeq::new()),
        failures: replace(inout pool.failures, ChunkSeq::new()),
        workers: wstats,
        trace: replace(inout pool.trace, ChunkSeq::new()),
        abandoned: pool.live,
    }
}

// ---------------------------------------------------------------------------
// The epoll completion driver (`readiness.rs` over `epoll.rs`, #1938).
//
// A readiness kernel interface never holds a user buffer: the driver
// performs the read or write itself once the descriptor is ready. Each
// request is in exactly one place: `waiting` (registered with epoll) or
// `ready` (finished, returned by the next poll). Descriptors epoll refuses
// because they are always ready (`EPERM`: regular files, most character
// devices) are serviced inline with `pread`/`pwrite` at the request
// offset; their completion is delivered by the next poll, never by
// `submit`. Stream descriptors are switched to `O_NONBLOCK` (and left so)
// and registered one-shot; a spurious wake-up re-arms. Zero-length
// operations and operations against the descriptor's access mode
// (`EBADF`) need no readiness and complete at the next poll.
//
// Request buffers live in the driver's byte arena (`start`, `len`); a
// poll copies its completions' bytes into the `EpollPoll` it returns.
// Errors are errno values, or one of the `io_error_*` codes below for the
// failures Rust reports without one.

// The submission queue is full (Rust: `WouldBlock`, no errno).
pub fn io_error_queue_full() -> u32 {
    1000001
}

// Request ids are exhausted.
pub fn io_error_ids_exhausted() -> u32 {
    1000002
}

// The kernel reported more bytes than the buffer holds.
pub fn io_error_invalid_length() -> u32 {
    1000003
}

// epoll reported a token that names no waiting request.
pub fn io_error_unknown_event() -> u32 {
    1000004
}

// A driver needs at least one entry.
pub fn io_error_invalid_entries() -> u32 {
    1000005
}

// A request the driver owns. `start` and `len` name its buffer in the
// driver's arena.
copy struct IoRequest {
    id: RequestId,
    fd: i32,
    op: Operation,
    offset: u64,
    token: u64,
    start: u64,
    len: u64,
}

// A finished request: `bytes` read or written when `ok`, else `errno`
// (`PulseSys::ECANCELED_ERR` for a cancelled request). `start` and `len`
// name its buffer in the `EpollPoll` that returned it: a successful read
// is truncated to the bytes read; anything else keeps the buffer as
// submitted.
pub copy struct IoCompletion {
    pub id: RequestId,
    pub token: u64,
    pub op: Operation,
    pub ok: bool,
    pub bytes: u64,
    pub errno: u32,
    pub start: u64,
    pub len: u64,
}

// One poll's completions, their buffers, and the first driver error
// (0 for none). The completions are returned even when `error` is set.
pub struct EpollPoll {
    pub completions: ChunkSeq[IoCompletion],
    pub data: ChunkSeq[u8],
    pub error: u32,
}

pub struct EpollDriver {
    poller: EpollPoller,
    capacity: u64,
    next: u64,
    waiting: ChunkSeq[IoRequest],
    ready: ChunkSeq[IoCompletion],
    arena: ChunkSeq[u8],
}

fn io_request_at(in seq: ChunkSeq[IoRequest], idx: u64) -> IoRequest {
    match seq.try_get(idx) {
        Option::Some(v) => v,
        Option::None => IoRequest {
            id: RequestId { bits: 0 },
            fd: -1,
            op: Operation::Read,
            offset: 0,
            token: 0,
            start: 0,
            len: 0,
        },
    }
}

fn io_completion_at(in seq: ChunkSeq[IoCompletion], idx: u64) -> IoCompletion {
    match seq.try_get(idx) {
        Option::Some(v) => v,
        Option::None => IoCompletion {
            id: RequestId { bits: 0 },
            token: 0,
            op: Operation::Read,
            ok: false,
            bytes: 0,
            errno: 0,
            start: 0,
            len: 0,
        },
    }
}

fn is_read(op: Operation) -> bool {
    match op {
        Operation::Read => true,
        Operation::Write => false,
    }
}

// The epoll interest of `op`, as `epoll_mask` takes it.
fn op_interest(op: Operation) -> u32 {
    if is_read(op) {
        0
    } else {
        1
    }
}

// A driver of `entries` requests at most, or `Err` with the error.
pub fn epoll_driver_new(entries: u32) -> Result[EpollDriver, u32] eff [Ffi[PulseSys]] {
    if entries == 0 {
        return Result::Err(io_error_invalid_entries());
    }
    let (fd, err) = PulseSys::epoll_create1(PulseSys::EPOLL_CLOEXEC);
    if fd < 0 {
        return Result::Err(err);
    }
    Result::Ok(
        EpollDriver {
            poller: EpollPoller { fd: fd },
            capacity: widen_u64(entries),
            next: 1,
            waiting: ChunkSeq::new[IoRequest](),
            ready: ChunkSeq::new[IoCompletion](),
            arena: ChunkSeq::new[u8](),
        }
    )
}

// The epoll instance, which is readable while a registered request fired.
pub fn epoll_driver_fd(in d: EpollDriver) -> i32 {
    d.poller.fd
}

// Requests the driver owns: waiting and finished but not yet polled.
pub fn epoll_driver_pending(in d: EpollDriver) -> u64 {
    wrapping_add(d.waiting.len(), d.ready.len())
}

// Requests registered with epoll.
pub fn epoll_driver_in_flight(in d: EpollDriver) -> u64 {
    d.waiting.len()
}

// Whether the next poll returns completions without waiting.
pub fn epoll_driver_has_ready(in d: EpollDriver) -> bool {
    d.ready.len() > 0
}

// Finish `r` with `n` bytes (`ok`) or `errno`, as Rust's `finish` does.
fn io_finish(r: IoRequest, ok: bool, n: u64, errno: u32) -> IoCompletion {
    let mut good = ok;
    let mut e = errno;
    if good && n > r.len {
        good = false;
        e = io_error_invalid_length();
    }
    let len = if good && is_read(r.op) {
        n
    } else {
        r.len
    };
    IoCompletion {
        id: r.id,
        token: r.token,
        op: r.op,
        ok: good,
        bytes: if good {
            n
        } else {
            0
        },
        errno: if good {
            0
        } else {
            e
        },
        start: r.start,
        len: len,
    }
}

// `pread`/`pwrite` of `r` at its offset, retrying `EINTR`: `(ok, n, errno)`.
fn io_positional(inout d: EpollDriver, r: IoRequest) -> (bool, u64, u32) eff [Ffi[PulseSys]] {
    let end = wrapping_add(r.start, r.len);
    loop {
        let (n, e) = if is_read(r.op) {
            PulseSys::pread(r.fd, inout d.arena[r.start..end], wrapping_i64(r.offset))
        } else {
            PulseSys::pwrite(r.fd, in d.arena[r.start..end], wrapping_i64(r.offset))
        };
        if n >= 0 {
            return (true, wrapping_u64(n), 0);
        }
        if e != PulseSys::EINTR_ERR {
            return (false, 0, e);
        }
    }
}

// `read`/`write` of `r` on its non-blocking stream, retrying `EINTR`.
fn io_streamed(inout d: EpollDriver, r: IoRequest) -> (bool, u64, u32) eff [Ffi[PulseSys]] {
    let end = wrapping_add(r.start, r.len);
    loop {
        let (n, e) = if is_read(r.op) {
            PulseSys::read(r.fd, inout d.arena[r.start..end])
        } else {
            PulseSys::write(r.fd, in d.arena[r.start..end])
        };
        if n >= 0 {
            return (true, wrapping_u64(n), 0);
        }
        if e != PulseSys::EINTR_ERR {
            return (false, 0, e);
        }
    }
}

// Remove the registration of `fd`: 0 or the errno.
fn io_deregister(in d: EpollDriver, fd: i32) -> u32 eff [Ffi[PulseSys]] {
    let (ok, e) = epoll_release(in d.poller, fd);
    if ok {
        0
    } else {
        e
    }
}

// Submit a read into a buffer of `buffer.len()` bytes (its contents are
// kept when the read fails) or a write of `buffer`, at `offset` (0 for a
// stream). The request's id, or `Err` with the error; a rejected request
// leaves nothing behind.
pub fn epoll_driver_submit(
    inout d: EpollDriver,
    fd: i32,
    op: Operation,
    in buffer: Slice[u8],
    offset: u64,
    token: u64,
) -> Result[RequestId, u32] eff [Ffi[PulseSys]] {
    if epoll_driver_pending(in d) >= d.capacity {
        return Result::Err(io_error_queue_full());
    }
    if d.next == 18446744073709551615 {
        return Result::Err(io_error_ids_exhausted());
    }
    let id = RequestId { bits: d.next };
    let (flags, ferr) = PulseSys::fcntl(fd, PulseSys::F_GETFL, 0);
    if flags < 0 {
        return Result::Err(ferr);
    }
    let start = d.arena.len();
    d.arena.extend(in buffer);
    let r = IoRequest {
        id: id,
        fd: fd,
        op: op,
        offset: offset,
        token: token,
        start: start,
        len: buffer.len(),
    };
    // Requests that can finish without readiness complete at the next
    // poll: a readiness event for them might never arrive.
    let mode = flags & PulseSys::O_ACCMODE;
    let wrong = if is_read(op) {
        mode == PulseSys::O_WRONLY
    } else {
        mode == PulseSys::O_RDONLY
    };
    if wrong || buffer.len() == 0 {
        d.next = wrapping_add(d.next, 1);
        let c = if wrong {
            io_finish(r, false, 0, PulseSys::EBADF_ERR)
        } else {
            io_finish(r, true, 0, 0)
        };
        d.ready.push(c);
        return Result::Ok(id);
    }
    let armed = epoll_arm(in d.poller, fd, op_interest(op), id.bits);
    if armed.status == 2 {
        d.arena.truncate(start);
        return Result::Err(armed.errno);
    }
    if armed.status == 1 {
        d.next = wrapping_add(d.next, 1);
        let (ok, n, e) = io_positional(inout d, r);
        d.ready.push(io_finish(r, ok, n, e));
        return Result::Ok(id);
    }
    if offset != 0 {
        // A stream has no position; refusing beats reading from somewhere
        // other than the requested offset.
        let _ = io_deregister(in d, fd);
        d.arena.truncate(start);
        return Result::Err(PulseSys::ESPIPE_ERR);
    }
    if (flags & PulseSys::O_NONBLOCK) == 0 {
        let (rc, e) = PulseSys::fcntl(
            fd,
            PulseSys::F_SETFL,
            widen_i64(flags | PulseSys::O_NONBLOCK)
        );
        if rc < 0 {
            let _ = io_deregister(in d, fd);
            d.arena.truncate(start);
            return Result::Err(e);
        }
    }
    d.next = wrapping_add(d.next, 1);
    d.waiting.push(r);
    Result::Ok(id)
}

// The index of waiting request `id`, or the waiting count.
fn io_waiting_index(in d: EpollDriver, id: u64) -> u64 {
    let n = d.waiting.len();
    for i in 0..n {
        if io_request_at(in d.waiting, i).id.bits == id {
            return i;
        }
    }
    n
}

// Remove waiting request `i`, keeping the rest in id order.
fn io_remove_waiting(inout d: EpollDriver, i: u64) {
    let n = d.waiting.len();
    let last = wrapping_sub(n, 1);
    for j in i..last {
        let next = io_request_at(in d.waiting, wrapping_add(j, 1));
        let _ok = d.waiting.try_set(j, next);
    }
    let _popped = d.waiting.pop();
}

// Cancel a waiting request: true when it was waiting (its cancelled
// completion comes with the next poll), false when it is not; `Err` with
// the errno when epoll refuses to forget it (it stays waiting).
pub fn epoll_driver_cancel(
    inout d: EpollDriver,
    id: RequestId
) -> Result[bool, u32] eff [Ffi[PulseSys]] {
    let i = io_waiting_index(in d, id.bits);
    if i >= d.waiting.len() {
        return Result::Ok(false);
    }
    let r = io_request_at(in d.waiting, i);
    let e = io_deregister(in d, r.fd);
    if e != 0 {
        return Result::Err(e);
    }
    io_remove_waiting(inout d, i);
    d.ready.push(io_finish(r, false, 0, PulseSys::ECANCELED_ERR));
    Result::Ok(true)
}

// Cancel every waiting request, in id order, going on past failures: 0 or
// the first error.
pub fn epoll_driver_cancel_all(inout d: EpollDriver) -> u32 eff [Ffi[PulseSys]] {
    let mut ids: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for i in 0..d.waiting.len() {
        ids.push(io_request_at(in d.waiting, i).id.bits);
    }
    let mut first: u32 = 0;
    for i in 0..ids.len() {
        let id = match ids.try_get(i) {
            Option::Some(v) => v,
            Option::None => 0,
        };
        let rid = RequestId { bits: id };
        let r = epoll_driver_cancel(inout d, rid);
        match r {
            Result::Ok(_) => {},
            Result::Err(e) => {
                if first == 0 {
                    first = e;
                }
            },
        }
    }
    first
}

// Append the tokens of fired registrations to `fired`, at most 64; when
// `block`, wait until one fires. `EINTR` is retried. 0 or the errno.
fn io_wait(in d: EpollDriver, block: bool, inout fired: ChunkSeq[u64]) -> u32 eff [Ffi[PulseSys]] {
    let mut timeout: i32 = if block {
        -1
    } else {
        0
    };
    loop {
        if fired.len() >= 64 {
            return 0;
        }
        let mut ev = EpollEvent {
            w0: 0,
            w1: 0,
            w2: 0,
            w3: 0,
        };
        let (rc, err) = PulseSys::epoll_wait(d.poller.fd, inout ev, 1, timeout);
        if rc < 0 {
            if err == PulseSys::EINTR_ERR {
                continue;
            }
            return err;
        }
        if rc == 0 {
            return 0;
        }
        fired.push(epoll_event_token(ev));
        timeout = 0;
    }
}

// Perform one fired request. It always reaches `ready` or stays waiting;
// an error here is a driver error, reported after the request itself has
// been accounted for.
fn io_service(inout d: EpollDriver, token: u64) -> u32 eff [Ffi[PulseSys]] {
    let i = io_waiting_index(in d, token);
    if i >= d.waiting.len() {
        return io_error_unknown_event();
    }
    let r = io_request_at(in d.waiting, i);
    let (ok, n, e) = io_streamed(inout d, r);
    if !ok && e == PulseSys::EAGAIN_ERR {
        let (rearmed, re) = epoll_rearm(in d.poller, r.fd, op_interest(r.op), r.id.bits);
        if rearmed {
            return 0;
        }
        io_remove_waiting(inout d, i);
        d.ready.push(io_finish(r, false, 0, re));
        return re;
    }
    io_remove_waiting(inout d, i);
    let released = io_deregister(in d, r.fd);
    d.ready.push(io_finish(r, ok, n, e));
    released
}

// Collect what finished: fired registrations are serviced, then every
// finished request is returned with its buffer. `wait` blocks until a
// registered request fires when nothing is finished yet.
pub fn epoll_driver_poll(inout d: EpollDriver, wait: bool) -> EpollPoll eff [Ffi[PulseSys]] {
    let mut error: u32 = 0;
    if d.waiting.len() > 0 {
        let block = wait && d.ready.len() == 0;
        let mut fired: ChunkSeq[u64] = ChunkSeq::new[u64]();
        let we = io_wait(in d, block, inout fired);
        if we != 0 {
            error = we;
        }
        for k in 0..fired.len() {
            let token = match fired.try_get(k) {
                Option::Some(v) => v,
                Option::None => 0,
            };
            let se = io_service(inout d, token);
            if se != 0 && error == 0 {
                error = se;
            }
        }
    }
    let ready = replace(inout d.ready, ChunkSeq::new[IoCompletion]());
    let mut completions: ChunkSeq[IoCompletion] = ChunkSeq::new[IoCompletion]();
    let mut data: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for k in 0..ready.len() {
        let mut c = io_completion_at(in ready, k);
        let at = data.len();
        data.extend(in d.arena[c.start..wrapping_add(c.start, c.len)]);
        c.start = at;
        completions.push(c);
    }
    io_compact(inout d);
    EpollPoll {
        completions: completions,
        data: data,
        error: error,
    }
}

// Drop arena bytes no waiting request uses: all of them when none waits,
// else rebuild once the arena is twice the live bytes.
fn io_compact(inout d: EpollDriver) {
    if d.waiting.len() == 0 && d.ready.len() == 0 {
        d.arena.truncate(0);
        return;
    }
    let mut live: u64 = 0;
    for i in 0..d.waiting.len() {
        live = wrapping_add(live, io_request_at(in d.waiting, i).len);
    }
    for i in 0..d.ready.len() {
        live = wrapping_add(live, io_completion_at(in d.ready, i).len);
    }
    if d.arena.len() < wrapping_add(wrapping_mul(live, 2), 4096) {
        return;
    }
    let mut arena: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for i in 0..d.waiting.len() {
        let mut r = io_request_at(in d.waiting, i);
        let at = arena.len();
        arena.extend(in d.arena[r.start..wrapping_add(r.start, r.len)]);
        r.start = at;
        let _ok = d.waiting.try_set(i, r);
    }
    for i in 0..d.ready.len() {
        let mut c = io_completion_at(in d.ready, i);
        let at = arena.len();
        arena.extend(in d.arena[c.start..wrapping_add(c.start, c.len)]);
        c.start = at;
        let _ok = d.ready.try_set(i, c);
    }
    d.arena = arena;
}

// Forget every registration without completing it and close the epoll
// instance: the requests abandoned (Rust's drop path).
pub fn epoll_driver_close(in d: EpollDriver) -> u64 eff [Ffi[PulseSys]] {
    for i in 0..d.waiting.len() {
        let _ = io_deregister(in d, io_request_at(in d.waiting, i).fd);
    }
    let n = epoll_driver_pending(in d);
    let _ = PulseSys::close(d.poller.fd);
    n
}

// The io_uring completion driver (`uring.rs`).
//
// The kernel performs each request itself, so a request's buffer is an
// allocation (`malloc`, an address) the driver owns until the request's
// completion: the submitted bytes are copied in at submit and the result
// copied out at completion. The submission and completion rings and the
// submission entries are `mmap`ed from the ring descriptor; ring indices
// and entries are read and written with `memcpy`, ordered by
// `PulseSys::ring_fence` (acquire after reading an index the kernel
// writes, release before publishing one). Request ids are never reused,
// and a cancellation's own completion carries the request id with bit 63
// set, so it never passes for the request's completion. Entries are queued
// at submit and handed to the kernel by the next poll (or when the queue
// is full, or at once when an outside loop waits on the eventfd).

// The id bit of a cancellation's completion.
fn uring_cancel_bit() -> u64 {
    9223372036854775808
}

// A cancellation completion for a request with no cancellation queued.
pub fn io_error_unexpected_cancel() -> u32 {
    1000006
}

// The kernel lacks `IORING_FEAT_NODROP`, which exactly-once I/O needs
// (Rust: `Unsupported`).
pub fn io_error_unsupported() -> u32 {
    1000007
}

// A buffer longer than `u32::MAX` bytes (Rust: `InvalidInput`).
pub fn io_error_buffer_too_long() -> u32 {
    1000008
}

// A request the kernel owns: `buf` is its allocation of `max(len, 1)`
// bytes.
copy struct UringRequest {
    id: RequestId,
    fd: i32,
    op: Operation,
    offset: u64,
    token: u64,
    buf: u64,
    len: u64,
}

// One poll's completions, their buffers, and the first driver error (0 for
// none). The completions are returned even when `error` is set.
pub struct UringPoll {
    pub completions: ChunkSeq[IoCompletion],
    pub data: ChunkSeq[u8],
    pub error: u32,
}

pub struct UringDriver {
    fd: i32,
    // The submission ring mapping (and the completion ring, with
    // `IORING_FEAT_SINGLE_MMAP`), the completion ring mapping (length 0
    // when shared) and the submission entries.
    sq_map: u64,
    sq_map_len: u64,
    cq_map: u64,
    cq_map_len: u64,
    sqes: u64,
    sqes_len: u64,
    // Addresses of the ring fields.
    sq_head: u64,
    sq_tail: u64,
    sq_flags: u64,
    sq_array: u64,
    sq_mask: u32,
    sq_entries: u32,
    cq_head: u64,
    cq_tail: u64,
    cqes: u64,
    cq_mask: u32,
    // The submission tail as published.
    tail: u32,
    next: u64,
    // In id order.
    requests: ChunkSeq[UringRequest],
    // Requests with a queued cancellation, until its completion; and
    // requests whose cancellation was issued, until their own completion
    // (a cancelled operation io-wq was running may end with `EINTR`).
    cancellations: ChunkSeq[u64],
    cancel_requested: ChunkSeq[u64],
    eventfd: i32,
}

fn uring_request_at(in seq: ChunkSeq[UringRequest], idx: u64) -> UringRequest {
    match seq.try_get(idx) {
        Option::Some(v) => v,
        Option::None => UringRequest {
            id: RequestId { bits: 0 },
            fd: -1,
            op: Operation::Read,
            offset: 0,
            token: 0,
            buf: 0,
            len: 0,
        },
    }
}

fn uring_u64_index(in seq: ChunkSeq[u64], v: u64) -> u64 {
    for i in 0..seq.len() {
        if u64_at(in seq, i) == v {
            return i;
        }
    }
    seq.len()
}

// Remove `v` from `seq`, keeping the order: whether it was there.
fn uring_u64_remove(inout seq: ChunkSeq[u64], v: u64) -> bool {
    let i = uring_u64_index(in seq, v);
    let n = seq.len();
    if i >= n {
        return false;
    }
    for j in i..wrapping_sub(n, 1) {
        let _ok = seq.try_set(j, u64_at(in seq, wrapping_add(j, 1)));
    }
    let _popped = seq.pop();
    true
}

fn uring_get_word(address: u64) -> u32 eff [Ffi[PulseSys]] {
    let mut w: u32 = 0;
    let _ = PulseSys::get_word(inout w, address, 4);
    w
}

fn uring_put_word(address: u64, w: u32) eff [Ffi[PulseSys]] {
    let _ = PulseSys::put_word(address, in w, 4);
}

fn uring_unmap(address: u64, len: u64) eff [Ffi[PulseSys]] {
    if len > 0 {
        let _ = PulseSys::munmap(address, len);
    }
}

// A mapping of the ring descriptor at `offset`, or `Err` with the errno.
fn uring_map(fd: i32, len: u64, offset: i64) -> Result[u64, u32] eff [Ffi[PulseSys]] {
    let (address, e) = PulseSys::mmap(
        0,
        len,
        PulseSys::PROT_READ_WRITE,
        PulseSys::MAP_SHARED_POPULATE,
        fd,
        offset
    );
    if address == 18446744073709551615 {
        return Result::Err(e);
    }
    Result::Ok(address)
}

// A driver of at least `entries` submission entries (the kernel rounds up
// to a power of two), or `Err` with the error.
pub fn uring_driver_new(entries: u32) -> Result[UringDriver, u32] eff [Ffi[PulseSys]] {
    if entries == 0 {
        return Result::Err(io_error_invalid_entries());
    }
    let mut p = UringParams {
        sq_entries: 0,
        cq_entries: 0,
        flags: 0,
        sq_thread_cpu: 0,
        sq_thread_idle: 0,
        features: 0,
        wq_fd: 0,
        resv0: 0,
        resv1: 0,
        resv2: 0,
        sq_head: 0,
        sq_tail: 0,
        sq_ring_mask: 0,
        sq_ring_entries: 0,
        sq_flags: 0,
        sq_dropped: 0,
        sq_array: 0,
        sq_resv: 0,
        sq_user_lo: 0,
        sq_user_hi: 0,
        cq_head: 0,
        cq_tail: 0,
        cq_ring_mask: 0,
        cq_ring_entries: 0,
        cq_overflow: 0,
        cq_cqes: 0,
        cq_flags: 0,
        cq_resv: 0,
        cq_user_lo: 0,
        cq_user_hi: 0,
    };
    let (rc, err) = PulseSys::uring_setup(
        PulseSys::SYS_IO_URING_SETUP,
        widen_u64(entries),
        inout p
    );
    if rc < 0 {
        return Result::Err(err);
    }
    let fd = wrapping_i32(rc);
    if (p.features & PulseSys::IORING_FEAT_NODROP) == 0 {
        let _ = PulseSys::close(fd);
        return Result::Err(io_error_unsupported());
    }
    let sq_len = wrapping_add(widen_u64(p.sq_array), wrapping_mul(widen_u64(p.sq_entries), 4));
    let cq_len = wrapping_add(widen_u64(p.cq_cqes), wrapping_mul(widen_u64(p.cq_entries), 16));
    let single = (p.features & PulseSys::IORING_FEAT_SINGLE_MMAP) != 0;
    let sq_map_len = if single && cq_len > sq_len {
        cq_len
    } else {
        sq_len
    };
    let sq_map = match uring_map(fd, sq_map_len, PulseSys::IORING_OFF_SQ_RING) {
        Result::Ok(a) => a,
        Result::Err(e) => {
            let _ = PulseSys::close(fd);
            return Result::Err(e);
        },
    };
    let (cq_map, cq_map_len) = if single {
        (sq_map, 0)
    } else {
        match uring_map(fd, cq_len, PulseSys::IORING_OFF_CQ_RING) {
            Result::Ok(a) => (a, cq_len),
            Result::Err(e) => {
                uring_unmap(sq_map, sq_map_len);
                let _ = PulseSys::close(fd);
                return Result::Err(e);
            },
        }
    };
    let sqes_len = wrapping_mul(widen_u64(p.sq_entries), 64);
    let sqes = match uring_map(fd, sqes_len, PulseSys::IORING_OFF_SQES) {
        Result::Ok(a) => a,
        Result::Err(e) => {
            uring_unmap(cq_map, cq_map_len);
            uring_unmap(sq_map, sq_map_len);
            let _ = PulseSys::close(fd);
            return Result::Err(e);
        },
    };
    let sq_tail = wrapping_add(sq_map, widen_u64(p.sq_tail));
    let tail = uring_get_word(sq_tail);
    Result::Ok(
        UringDriver {
            fd: fd,
            sq_map: sq_map,
            sq_map_len: sq_map_len,
            cq_map: cq_map,
            cq_map_len: cq_map_len,
            sqes: sqes,
            sqes_len: sqes_len,
            sq_head: wrapping_add(sq_map, widen_u64(p.sq_head)),
            sq_tail: sq_tail,
            sq_flags: wrapping_add(sq_map, widen_u64(p.sq_flags)),
            sq_array: wrapping_add(sq_map, widen_u64(p.sq_array)),
            sq_mask: uring_get_word(wrapping_add(sq_map, widen_u64(p.sq_ring_mask))),
            sq_entries: p.sq_entries,
            cq_head: wrapping_add(cq_map, widen_u64(p.cq_head)),
            cq_tail: wrapping_add(cq_map, widen_u64(p.cq_tail)),
            cqes: wrapping_add(cq_map, widen_u64(p.cq_cqes)),
            cq_mask: uring_get_word(wrapping_add(cq_map, widen_u64(p.cq_ring_mask))),
            tail: tail,
            next: 1,
            requests: ChunkSeq::new[UringRequest](),
            cancellations: ChunkSeq::new[u64](),
            cancel_requested: ChunkSeq::new[u64](),
            eventfd: -1,
        }
    )
}

// Requests the kernel owns.
pub fn uring_driver_pending(in d: UringDriver) -> u64 {
    d.requests.len()
}

// Queued entries the kernel has not taken yet.
fn uring_queued(in d: UringDriver) -> u32 eff [Ffi[PulseSys]] {
    let head = uring_get_word(d.sq_head);
    PulseSys::ring_fence();
    wrapping_sub(d.tail, head)
}

// Hand the queued entries to the kernel and, with `want` > 0, wait for that
// many completions: 0 or the errno.
fn uring_enter(in d: UringDriver, want: u64) -> u32 eff [Ffi[PulseSys]] {
    let queued = uring_queued(in d);
    let overflow = (uring_get_word(d.sq_flags) & PulseSys::IORING_SQ_CQ_OVERFLOW) != 0;
    let flags = if want > 0 || overflow {
        PulseSys::IORING_ENTER_GETEVENTS
    } else {
        0
    };
    let (rc, e) = PulseSys::uring_enter(
        PulseSys::SYS_IO_URING_ENTER,
        widen_i64(d.fd),
        widen_u64(queued),
        want,
        flags,
        0,
        0
    );
    if rc < 0 {
        e
    } else {
        0
    }
}

// Queue `sqe`, handing the queue to the kernel first when it is full: 0,
// the errno, or `io_error_queue_full` when it stays full.
fn uring_push(inout d: UringDriver, sqe: Sqe) -> u32 eff [Ffi[PulseSys]] {
    if uring_queued(in d) >= d.sq_entries {
        let e = uring_enter(in d, 0);
        if e != 0 {
            return e;
        }
        if uring_queued(in d) >= d.sq_entries {
            return io_error_queue_full();
        }
    }
    let slot = d.tail & d.sq_mask;
    let _ = PulseSys::put_sqe(wrapping_add(d.sqes, wrapping_mul(widen_u64(slot), 64)), in sqe, 64);
    uring_put_word(wrapping_add(d.sq_array, wrapping_mul(widen_u64(slot), 4)), slot);
    PulseSys::ring_fence();
    d.tail = wrapping_add(d.tail, 1);
    uring_put_word(d.sq_tail, d.tail);
    0
}

fn uring_sqe(opcode: u8, fd: i32, off: u64, addr: u64, len: u32, user_data: u64) -> Sqe {
    Sqe {
        opcode: opcode,
        flags: 0,
        ioprio: 0,
        fd: fd,
        off: off,
        addr: addr,
        len: len,
        rw_flags: 0,
        user_data: user_data,
        buf_index: 0,
        personality: 0,
        splice_fd_in: 0,
        addr3: 0,
        pad: 0,
    }
}

// Signal the eventfd once.
fn uring_signal(fd: i32) eff [Ffi[PulseSys]] {
    let mut one: ChunkSeq[u8] = ChunkSeq::new[u8]();
    one.resize(8, 0);
    let _ok = one.try_set(0, 1);
    let _ = PulseSys::write(fd, in one.as_slice());
}

// Reset the eventfd's counter (nothing signalled is fine).
fn uring_drain(fd: i32) eff [Ffi[PulseSys]] {
    let mut counter: ChunkSeq[u8] = ChunkSeq::new[u8]();
    counter.resize(8, 0);
    let _ = PulseSys::read(fd, inout counter[0..8]);
}

// With an outside loop waiting on the eventfd, nothing else would hand
// queued entries to the kernel before it waits: submit them now. If that
// fails they stay queued, and the eventfd is signalled so the loop's next
// poll submits them again and reports the error.
fn uring_flush_for_outside_loop(in d: UringDriver) eff [Ffi[PulseSys]] {
    if d.eventfd < 0 {
        return;
    }
    if uring_enter(in d, 0) != 0 {
        uring_signal(d.eventfd);
    }
}

// Submit a read into a buffer of `buffer.len()` bytes (its contents are
// kept when the read fails) or a write of `buffer`, at `offset`. The
// request's id, or `Err` with the error; a rejected request leaves nothing
// behind.
pub fn uring_driver_submit(
    inout d: UringDriver,
    fd: i32,
    op: Operation,
    in buffer: Slice[u8],
    offset: u64,
    token: u64,
) -> Result[RequestId, u32] eff [Ffi[PulseSys]] {
    let len = buffer.len();
    if len > 4294967295 {
        return Result::Err(io_error_buffer_too_long());
    }
    if uring_queued(in d) >= d.sq_entries {
        let e = uring_enter(in d, 0);
        if e != 0 {
            return Result::Err(e);
        }
        if uring_queued(in d) >= d.sq_entries {
            return Result::Err(io_error_queue_full());
        }
    }
    if d.next >= uring_cancel_bit() {
        return Result::Err(io_error_ids_exhausted());
    }
    let buf = PulseSys::malloc(
        if len == 0 {
            1
        } else {
            len
        }
    );
    if buf == 0 {
        return Result::Err(PulseSys::ENOMEM_ERR);
    }
    if len > 0 {
        let _ = PulseSys::put_bytes(buf, in buffer);
    }
    let id = RequestId { bits: d.next };
    d.next = wrapping_add(d.next, 1);
    let opcode = if is_read(op) {
        PulseSys::IORING_OP_READ
    } else {
        PulseSys::IORING_OP_WRITE
    };
    let pushed = uring_push(
        inout d,
        uring_sqe(opcode, fd, offset, buf, wrapping_u32(len), id.bits)
    );
    if pushed != 0 {
        let _ = PulseSys::free(buf);
        return Result::Err(io_error_queue_full());
    }
    d.requests.push(
        UringRequest {
            id: id,
            fd: fd,
            op: op,
            offset: offset,
            token: token,
            buf: buf,
            len: len,
        }
    );
    uring_flush_for_outside_loop(in d);
    Result::Ok(id)
}

fn uring_request_index(in d: UringDriver, id: u64) -> u64 {
    let n = d.requests.len();
    for i in 0..n {
        if uring_request_at(in d.requests, i).id.bits == id {
            return i;
        }
    }
    n
}

// Queue the cancellation of request `id`: true when it is owned and not
// already being cancelled (its completion, `ECANCELED`, comes with a later
// poll), else false; `Err` when the cancellation cannot be queued.
pub fn uring_driver_cancel(
    inout d: UringDriver,
    id: RequestId
) -> Result[bool, u32] eff [Ffi[PulseSys]] {
    if uring_request_index(in d, id.bits) >= d.requests.len()
        || uring_u64_index(in d.cancellations, id.bits) < d.cancellations.len() {
        return Result::Ok(false);
    }
    let sqe = uring_sqe(
        PulseSys::IORING_OP_ASYNC_CANCEL,
        -1,
        0,
        id.bits,
        0,
        id.bits | uring_cancel_bit()
    );
    let e = uring_push(inout d, sqe);
    if e != 0 {
        return Result::Err(e);
    }
    d.cancellations.push(id.bits);
    d.cancel_requested.push(id.bits);
    uring_flush_for_outside_loop(in d);
    Result::Ok(true)
}

// Cancel every owned request in id order, stopping at the first error: 0
// or that error.
pub fn uring_driver_cancel_all(inout d: UringDriver) -> u32 eff [Ffi[PulseSys]] {
    let mut ids: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for i in 0..d.requests.len() {
        ids.push(uring_request_at(in d.requests, i).id.bits);
    }
    for i in 0..ids.len() {
        let rid = RequestId { bits: u64_at(in ids, i) };
        let r = uring_driver_cancel(inout d, rid);
        match r {
            Result::Ok(_) => {},
            Result::Err(e) => return e,
        }
    }
    0
}

// The ring's eventfd, made and registered on first use: the kernel signals
// it for every completion it posts. It is signalled once at creation
// (completions posted before it never signal it).
pub fn uring_driver_eventfd(inout d: UringDriver) -> Result[i32, u32] eff [Ffi[PulseSys]] {
    if d.eventfd >= 0 {
        return Result::Ok(d.eventfd);
    }
    let (efd, e) = PulseSys::eventfd(0, PulseSys::EFD_CLOEXEC_NONBLOCK);
    if efd < 0 {
        return Result::Err(e);
    }
    let (rc, re) = PulseSys::uring_register(
        PulseSys::SYS_IO_URING_REGISTER,
        widen_i64(d.fd),
        PulseSys::IORING_REGISTER_EVENTFD,
        in efd,
        1
    );
    if rc < 0 {
        let _ = PulseSys::close(efd);
        return Result::Err(re);
    }
    uring_signal(efd);
    d.eventfd = efd;
    Result::Ok(efd)
}

// Account for one completion (`user_data`, `res`): appends the request's
// completion and buffer to `out`, or nothing for a cancellation's own
// completion; 0 or the error.
fn uring_complete(
    inout d: UringDriver,
    user_data: u64,
    res: i32,
    inout out: UringPoll
) -> u32 eff [Ffi[PulseSys]] {
    if (user_data & uring_cancel_bit()) != 0 {
        let id = user_data ^ uring_cancel_bit();
        if !uring_u64_remove(inout d.cancellations, id) {
            return io_error_unexpected_cancel();
        }
        return 0;
    }
    let i = uring_request_index(in d, user_data);
    if i >= d.requests.len() {
        return io_error_unknown_event();
    }
    let r = uring_request_at(in d.requests, i);
    let n = d.requests.len();
    for j in i..wrapping_sub(n, 1) {
        let _ok = d.requests.try_set(j, uring_request_at(in d.requests, wrapping_add(j, 1)));
    }
    let _popped = d.requests.pop();
    let interrupted = uring_u64_remove(inout d.cancel_requested, r.id.bits) && res == -4;
    let (ok, bytes, errno) = if interrupted {
        (false, 0, PulseSys::ECANCELED_ERR)
    } else if res < 0 {
        (false, 0, wrapping_u32(wrapping_sub(0, widen_i64(res))))
    } else if wrapping_u64(widen_i64(res)) > r.len {
        (false, 0, io_error_invalid_length())
    } else {
        (true, wrapping_u64(widen_i64(res)), 0)
    };
    let keep = if ok && is_read(r.op) {
        bytes
    } else {
        r.len
    };
    let at = out.data.len();
    out.data.resize(wrapping_add(at, keep), 0);
    if keep > 0 {
        let _ = PulseSys::get_bytes(r.buf, inout out.data[at..wrapping_add(at, keep)]);
    }
    let _ = PulseSys::free(r.buf);
    out.completions.push(
        IoCompletion {
            id: r.id,
            token: r.token,
            op: r.op,
            ok: ok,
            bytes: bytes,
            errno: errno,
            start: at,
            len: keep,
        }
    );
    0
}

// Hand queued entries to the kernel and collect the posted completions.
// `wait` waits for at least one when a request or cancellation is
// outstanding. A failed wait returns no completions.
pub fn uring_driver_poll(inout d: UringDriver, wait: bool) -> UringPoll eff [Ffi[PulseSys]] {
    let mut out = UringPoll {
        completions: ChunkSeq::new[IoCompletion](),
        data: ChunkSeq::new[u8](),
        error: 0,
    };
    if d.eventfd >= 0 {
        // Reset the counter before harvesting, so a completion posted
        // after this point signals the descriptor again.
        uring_drain(d.eventfd);
    }
    let want: u64 = if wait && (d.requests.len() > 0 || d.cancellations.len() > 0) {
        1
    } else {
        0
    };
    loop {
        let e = uring_enter(in d, want);
        if e == PulseSys::EINTR_ERR {
            continue;
        }
        if e != 0 {
            out.error = e;
            return out;
        }
        break;
    }
    let head = uring_get_word(d.cq_head);
    let tail = uring_get_word(d.cq_tail);
    PulseSys::ring_fence();
    let mut events: ChunkSeq[Cqe] = ChunkSeq::new[Cqe]();
    let mut i = head;
    loop {
        if i == tail {
            break;
        }
        let mut cqe = Cqe {
            user_data: 0,
            res: 0,
            flags: 0,
        };
        let slot = i & d.cq_mask;
        let _ = PulseSys::get_cqe(
            inout cqe,
            wrapping_add(d.cqes, wrapping_mul(widen_u64(slot), 16)),
            16
        );
        events.push(cqe);
        i = wrapping_add(i, 1);
    }
    PulseSys::ring_fence();
    uring_put_word(d.cq_head, tail);
    for k in 0..events.len() {
        let c = match events.try_get(k) {
            Option::Some(c) => c,
            Option::None => Cqe {
                user_data: 0,
                res: 0,
                flags: 0,
            },
        };
        let e = uring_complete(inout d, c.user_data, c.res, inout out);
        if e != 0 && out.error == 0 {
            out.error = e;
        }
    }
    out
}

// Cancel and collect every request: the completions (each cancelled one
// `ECANCELED`) and the first error, at which it stops.
pub fn uring_driver_shutdown(inout d: UringDriver) -> UringPoll eff [Ffi[PulseSys]] {
    let mut all = UringPoll {
        completions: ChunkSeq::new[IoCompletion](),
        data: ChunkSeq::new[u8](),
        error: 0,
    };
    let e = uring_driver_cancel_all(inout d);
    if e != 0 {
        all.error = e;
        return all;
    }
    loop {
        if d.requests.len() == 0 && d.cancellations.len() == 0 {
            return all;
        }
        let p = uring_driver_poll(inout d, true);
        for k in 0..p.completions.len() {
            let mut c = match p.completions.try_get(k) {
                Option::Some(c) => c,
                Option::None => return all,
            };
            let at = all.data.len();
            all.data.extend(in p.data[c.start..wrapping_add(c.start, c.len)]);
            c.start = at;
            all.completions.push(c);
        }
        if p.error != 0 {
            all.error = p.error;
            return all;
        }
    }
}

// Release the driver (Rust's drop path): cancel and wait out every
// request, then unmap the rings and close the descriptors. When a wait
// fails the kernel may still hold the remaining buffers, which are kept
// (not freed); the result is how many.
pub fn uring_driver_close(inout d: UringDriver) -> u64 eff [Ffi[PulseSys]] {
    let mut ids: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for i in 0..d.requests.len() {
        ids.push(uring_request_at(in d.requests, i).id.bits);
    }
    for i in 0..ids.len() {
        let rid = RequestId { bits: u64_at(in ids, i) };
        let _ = uring_driver_cancel(inout d, rid);
    }
    loop {
        if d.requests.len() == 0 {
            break;
        }
        let p = uring_driver_poll(inout d, true);
        if p.error != 0 {
            break;
        }
    }
    let kept = d.requests.len();
    uring_unmap(d.sqes, d.sqes_len);
    uring_unmap(d.cq_map, d.cq_map_len);
    uring_unmap(d.sq_map, d.sq_map_len);
    if d.eventfd >= 0 {
        let _ = PulseSys::close(d.eventfd);
    }
    let _ = PulseSys::close(d.fd);
    kept
}
