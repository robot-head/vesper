//! Relocatable data frames for suspended native computations.
//!
//! Stored addresses name a live frame and byte offset; no address points into a
//! raw host pointer. Machine code, continuation entry points, and drop plans
//! belong to the caller.

pub copy struct FrameId {
    pub bits: u64,
}

pub copy struct Address {
    pub frame: FrameId,
    pub offset: u32,
}

pub copy enum FrameError {
    Allocation,
    ExhaustedIds,
    InvalidSize,
    StaleFrame,
    OutOfBounds,
    NotTopFrame,
}

copy struct Frame {
    id: FrameId,
    segment: u64,
    start: u64,
    length: u64,
}

pub struct FrameStack {
    segment_size: u64,
    seg_bytes: ChunkSeq[u8],
    seg_bases: ChunkSeq[u64],
    seg_caps: ChunkSeq[u64],
    seg_used: ChunkSeq[u64],
    frames: ChunkSeq[Frame],
    next_id: u64,
}

fn u64_at(in seq: ChunkSeq[u64], idx: u64) -> u64 {
    match seq.try_get(idx) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

fn u8_at(in seq: ChunkSeq[u8], idx: u64) -> u8 {
    match seq.try_get(idx) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

fn frame_at(in seq: ChunkSeq[Frame], idx: u64) -> Frame {
    match seq.try_get(idx) {
        Option::Some(v) => v,
        Option::None => Frame {
            id: FrameId { bits: 0 },
            segment: 0,
            start: 0,
            length: 0,
        },
    }
}

fn align_up_8(length: u64) -> (bool, u64) {
    let min_len = if length == 0 { 1 } else { length };
    let max_u64: u64 = wrapping_sub(0, 1);
    if min_len > wrapping_sub(max_u64, 7) {
        return (false, 0);
    }
    let aligned = wrapping_add(min_len, 7) & (!7);
    (true, aligned)
}

fn find_frame_index(in frames: ChunkSeq[Frame], target_bits: u64) -> (bool, u64) {
    let mut lo: u64 = 0;
    let mut hi: u64 = frames.len();
    loop {
        if lo >= hi {
            break;
        }
        let half = wrapping_shr_u64(wrapping_sub(hi, lo), 1);
        let mid = wrapping_add(lo, half);
        let mid_bits = frame_at(in frames, mid).id.bits;
        if mid_bits == target_bits {
            return (true, mid);
        }
        if mid_bits < target_bits {
            lo = wrapping_add(mid, 1);
        } else {
            hi = mid;
        }
    }
    (false, 0)
}

pub fn frame_stack_new(segment_size: u64) -> FrameStack eff [Fail[FrameError]] {
    if segment_size == 0 || segment_size > 4294967295 {
        return Fail::raise(FrameError::InvalidSize);
    }
    FrameStack {
        segment_size: segment_size,
        seg_bytes: ChunkSeq::new[u8](),
        seg_bases: ChunkSeq::new[u64](),
        seg_caps: ChunkSeq::new[u64](),
        seg_used: ChunkSeq::new[u64](),
        frames: ChunkSeq::new[Frame](),
        next_id: 1,
    }
}

pub fn frame_stack_depth(in stack: FrameStack) -> u64 {
    stack.frames.len()
}

pub fn frame_stack_segments(in stack: FrameStack) -> u64 {
    stack.seg_caps.len()
}

pub fn frame_stack_bytes(in stack: FrameStack) -> u64 {
    let mut total: u64 = 0;
    let n = stack.frames.len();
    for i in 0..n {
        total = wrapping_add(total, frame_at(in stack.frames, i).length);
    }
    total
}

pub fn frame_stack_live_id(in stack: FrameStack, bits: u64) -> FrameId eff [Fail[FrameError]] {
    let (found, _idx) = find_frame_index(in stack.frames, bits);
    if !found {
        return Fail::raise(FrameError::StaleFrame);
    }
    FrameId { bits: bits }
}

fn resolve_range(
    in stack: FrameStack,
    address: Address,
    length: u64,
) -> u64 eff [Fail[FrameError]] {
    let (found, idx) = find_frame_index(in stack.frames, address.frame.bits);
    if !found {
        return Fail::raise(FrameError::StaleFrame);
    }
    let frame = frame_at(in stack.frames, idx);
    let offset = widen_u64(address.offset);
    let max_u64: u64 = wrapping_sub(0, 1);
    if offset > wrapping_sub(max_u64, length) {
        return Fail::raise(FrameError::OutOfBounds);
    }
    let end = wrapping_add(offset, length);
    if end > frame.length {
        return Fail::raise(FrameError::OutOfBounds);
    }
    let seg_base = u64_at(in stack.seg_bases, frame.segment);
    wrapping_add(wrapping_add(seg_base, frame.start), offset)
}

pub fn frame_stack_push(inout stack: FrameStack, length: u32) -> FrameId eff [Fail[FrameError]] {
    let id_bits = stack.next_id;
    let max_u64: u64 = wrapping_sub(0, 1);
    if id_bits == max_u64 {
        return Fail::raise(FrameError::ExhaustedIds);
    }
    let next = wrapping_add(id_bits, 1);
    let len_u64 = widen_u64(length);
    let (ok_align, aligned) = align_up_8(len_u64);
    if !ok_align {
        return Fail::raise(FrameError::InvalidSize);
    }
    let seg_count = stack.seg_caps.len();
    let need_segment = if seg_count == 0 {
        true
    } else {
        let last = wrapping_sub(seg_count, 1);
        let cap = u64_at(in stack.seg_caps, last);
        let used = u64_at(in stack.seg_used, last);
        wrapping_sub(cap, used) < aligned
    };
    if need_segment {
        let cap = if stack.segment_size > aligned {
            stack.segment_size
        } else {
            aligned
        };
        let base = stack.seg_bytes.len();
        for _i in 0..cap {
            stack.seg_bytes.push(0);
        }
        stack.seg_bases.push(base);
        stack.seg_caps.push(cap);
        stack.seg_used.push(0);
    }
    let seg_idx = wrapping_sub(stack.seg_caps.len(), 1);
    let seg_base = u64_at(in stack.seg_bases, seg_idx);
    let start = u64_at(in stack.seg_used, seg_idx);
    for k in 0..aligned {
        let _ok = stack.seg_bytes.try_set(wrapping_add(wrapping_add(seg_base, start), k), 0);
    }
    let _ok_u = stack.seg_used.try_set(seg_idx, wrapping_add(start, aligned));
    let id = FrameId { bits: id_bits };
    stack.frames.push(Frame {
        id: id,
        segment: seg_idx,
        start: start,
        length: len_u64,
    });
    stack.next_id = next;
    id
}

pub fn frame_stack_read(
    in stack: FrameStack,
    address: Address,
    length: u64,
) -> ChunkSeq[u8] eff [Fail[FrameError]] {
    let base = resolve_range(in stack, address, length);
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for i in 0..length {
        out.push(u8_at(in stack.seg_bytes, wrapping_add(base, i)));
    }
    out
}

pub fn frame_stack_write(
    inout stack: FrameStack,
    address: Address,
    in bytes: Slice[u8],
) -> () eff [Fail[FrameError]] {
    let len = bytes.len();
    let base = resolve_range(in stack, address, len);
    for i in 0..len {
        let b = match bytes.try_get(i) {
            Option::Some(v) => v,
            Option::None => 0,
        };
        let _ok = stack.seg_bytes.try_set(wrapping_add(base, i), b);
    }
}

pub fn frame_stack_read_word(in stack: FrameStack, address: Address) -> u64 eff [Fail[FrameError]] {
    let base = resolve_range(in stack, address, 8);
    let mut val: u64 = 0;
    for i in 0..8 {
        let idx = wrapping_u64(i);
        let shift = wrapping_u32(wrapping_mul(idx, 8));
        let b = widen_u64(u8_at(in stack.seg_bytes, wrapping_add(base, idx)));
        val = val | wrapping_shl_u64(b, shift);
    }
    val
}

pub fn frame_stack_write_word(
    inout stack: FrameStack,
    address: Address,
    value: u64,
) -> () eff [Fail[FrameError]] {
    let base = resolve_range(in stack, address, 8);
    for i in 0..8 {
        let idx = wrapping_u64(i);
        let shift = wrapping_u32(wrapping_mul(idx, 8));
        let b = wrapping_u8(wrapping_shr_u64(value, shift) & 255);
        let _ok = stack.seg_bytes.try_set(wrapping_add(base, idx), b);
    }
}

pub fn frame_stack_write_address(
    inout stack: FrameStack,
    destination: Address,
    value: Address,
) -> () eff [Fail[FrameError]] {
    let _check = resolve_range(in stack, value, 0);
    let base = resolve_range(in stack, destination, 16);
    for i in 0..8 {
        let idx = wrapping_u64(i);
        let shift = wrapping_u32(wrapping_mul(idx, 8));
        let b = wrapping_u8(wrapping_shr_u64(value.frame.bits, shift) & 255);
        let _ok = stack.seg_bytes.try_set(wrapping_add(base, idx), b);
    }
    let off = widen_u64(value.offset);
    for j in 0..4 {
        let jdx = wrapping_u64(j);
        let shift = wrapping_u32(wrapping_mul(jdx, 8));
        let b = wrapping_u8(wrapping_shr_u64(off, shift) & 255);
        let _ok = stack.seg_bytes.try_set(wrapping_add(wrapping_add(base, 8), jdx), b);
    }
    for z in 12..16 {
        let _ok = stack.seg_bytes.try_set(wrapping_add(base, wrapping_u64(z)), 0);
    }
}

pub fn frame_stack_read_address(
    in stack: FrameStack,
    source: Address,
) -> Address eff [Fail[FrameError]] {
    let base = resolve_range(in stack, source, 16);
    let mut bits: u64 = 0;
    for i in 0..8 {
        let idx = wrapping_u64(i);
        let shift = wrapping_u32(wrapping_mul(idx, 8));
        let b = widen_u64(u8_at(in stack.seg_bytes, wrapping_add(base, idx)));
        bits = bits | wrapping_shl_u64(b, shift);
    }
    let mut off: u32 = 0;
    for j in 0..4 {
        let jdx = wrapping_u64(j);
        let shift = wrapping_u32(wrapping_mul(jdx, 8));
        let b = widen_u32(u8_at(in stack.seg_bytes, wrapping_add(wrapping_add(base, 8), jdx)));
        off = off | wrapping_shl_u32(b, shift);
    }
    let id = frame_stack_live_id(in stack, bits);
    let addr = Address { frame: id, offset: off };
    let _check = resolve_range(in stack, addr, 0);
    addr
}

pub fn frame_stack_pop(
    inout stack: FrameStack,
    id: FrameId
) -> ChunkSeq[u8] eff [Fail[FrameError]] {
    let n = stack.frames.len();
    if n == 0 {
        return Fail::raise(FrameError::StaleFrame);
    }
    let top = frame_at(in stack.frames, wrapping_sub(n, 1));
    if top.id.bits != id.bits {
        let (found, _idx) = find_frame_index(in stack.frames, id.bits);
        if found {
            return Fail::raise(FrameError::NotTopFrame);
        }
        return Fail::raise(FrameError::StaleFrame);
    }
    let seg_base = u64_at(in stack.seg_bases, top.segment);
    let mut owned: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for i in 0..top.length {
        owned.push(u8_at(in stack.seg_bytes, wrapping_add(wrapping_add(seg_base, top.start), i)));
    }
    let _popped = stack.frames.pop();
    let _ok_u = stack.seg_used.try_set(top.segment, top.start);
    loop {
        if stack.seg_caps.len() == 0 {
            break;
        }
        let last_idx = wrapping_sub(stack.seg_caps.len(), 1);
        if u64_at(in stack.seg_used, last_idx) == 0 {
            let cap = u64_at(in stack.seg_caps, last_idx);
            let _c = stack.seg_caps.pop();
            let _u = stack.seg_used.pop();
            let _b = stack.seg_bases.pop();
            for _k in 0..cap {
                let _byte = stack.seg_bytes.pop();
            }
        } else {
            break;
        }
    }
    owned
}

pub fn frame_stack_relocate(inout stack: FrameStack) -> () {
    let mut replacements: ChunkSeq[u8] = ChunkSeq::new[u8]();
    let n = stack.seg_bytes.len();
    for i in 0..n {
        replacements.push(u8_at(in stack.seg_bytes, i));
    }
    stack.seg_bytes = replacements;
}

pub copy struct IocpPort {
    pub port: u64,
}

pub copy struct IocpPollResult {
    pub ok: bool,
    pub fired: bool,
    pub bytes: u32,
    pub key: u64,
    pub overlapped: u64,
    pub win32_err: u32,
}

pub fn iocp_new() -> Option[IocpPort] eff [Ffi[PulseSys]] {
    let h = PulseSys::CreateIoCompletionPort(PulseSys::INVALID_HANDLE_VALUE, 0, 0, 1);
    if h == 0 {
        return Option::None;
    }
    Option::Some(IocpPort { port: h })
}

pub fn iocp_associate(
    in port: IocpPort,
    file_handle: u64,
    key: u64,
) -> (bool, u32) eff [Ffi[PulseSys]] {
    let h = PulseSys::CreateIoCompletionPort(file_handle, port.port, key, 0);
    if h == 0 {
        (false, PulseSys::GetLastError())
    } else {
        (true, 0)
    }
}

pub fn iocp_post(
    in port: IocpPort,
    bytes: u32,
    key: u64,
    overlapped: u64,
) -> (bool, u32) eff [Ffi[PulseSys]] {
    let rc = PulseSys::PostQueuedCompletionStatus(port.port, bytes, key, overlapped);
    if rc == 0 {
        (false, PulseSys::GetLastError())
    } else {
        (true, 0)
    }
}

pub fn iocp_poll_one(in port: IocpPort, timeout_ms: u32) -> IocpPollResult eff [Ffi[PulseSys]] {
    let mut bytes: u32 = 0;
    let mut key: u64 = 0;
    let mut overlapped: u64 = 0;
    let rc = PulseSys::GetQueuedCompletionStatus(
        port.port,
        inout bytes,
        inout key,
        inout overlapped,
        timeout_ms,
    );
    if rc != 0 {
        return IocpPollResult {
            ok: true,
            fired: true,
            bytes: bytes,
            key: key,
            overlapped: overlapped,
            win32_err: 0,
        };
    }
    let err = PulseSys::GetLastError();
    if overlapped == 0 && err == PulseSys::WAIT_TIMEOUT_ERR {
        return IocpPollResult {
            ok: true,
            fired: false,
            bytes: 0,
            key: 0,
            overlapped: 0,
            win32_err: 0,
        };
    }
    IocpPollResult {
        ok: false,
        fired: overlapped != 0,
        bytes: bytes,
        key: key,
        overlapped: overlapped,
        win32_err: err,
    }
}

pub fn iocp_close(in port: IocpPort) -> () eff [Ffi[PulseSys]] {
    let _ = PulseSys::CloseHandle(port.port);
}

pub fn iocp_roundtrip_check() -> u64 eff [Ffi[PulseSys]] {
    let port = match iocp_new() {
        Option::Some(p) => p,
        Option::None => return 0,
    };
    let p0 = iocp_poll_one(in port, 0);
    if !p0.ok || p0.fired {
        iocp_close(in port);
        return 1;
    }
    let token: u64 = 1311768467463790320;
    let (posted, _) = iocp_post(in port, 64, PulseSys::KEY_POSTED, token);
    if !posted {
        iocp_close(in port);
        return 2;
    }
    let p1 = iocp_poll_one(in port, 1000);
    iocp_close(in port);
    if !p1.ok
        || !p1.fired
        || p1.bytes != 64
        || p1.key != PulseSys::KEY_POSTED
        || p1.overlapped != token {
        return 3;
    }
    100
}

pub copy enum DriverKind {
    IoUring,
    Epoll,
    Kqueue,
    Iocp,
}

pub copy struct RequestId {
    pub bits: u64,
}

pub copy enum Operation {
    Read,
    Write,
}

pub copy enum DriverError {
    QueueFull,
    UnknownRequest,
    InvalidCapacity,
}

pub copy struct RequestSlot {
    pub id: RequestId,
    pub fd: i32,
    pub op: Operation,
    pub offset: u64,
    pub len: u64,
    pub token: u64,
    pub cancelled: bool,
}

pub copy struct CompletionSlot {
    pub id: RequestId,
    pub ok: bool,
    pub bytes: u64,
    pub errno: u32,
    pub cancelled: bool,
}

pub struct ReadinessQueue {
    kind: DriverKind,
    capacity: u64,
    next_id: u64,
    waiting: ChunkSeq[RequestSlot],
    ready: ChunkSeq[CompletionSlot],
}

fn ascii_lower(b: u8) -> u8 {
    if b >= 65 && b <= 90 {
        wrapping_u8(wrapping_add(widen_u64(b), 32))
    } else {
        b
    }
}

fn is_ascii_ws(b: u8) -> bool {
    b == 32 || b == 9 || b == 10 || b == 13
}

fn slice_byte(in s: Slice[u8], i: u64) -> u8 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

fn eq_trimmed_lower(in name: Slice[u8], a: u64, b: u64, in target: Slice[u8]) -> bool {
    let len = wrapping_sub(b, a);
    if len != target.len() {
        return false;
    }
    for i in 0..len {
        let ch = ascii_lower(slice_byte(in name, wrapping_add(a, i)));
        let tc = slice_byte(in target, i);
        if ch != tc {
            return false;
        }
    }
    true
}

pub fn driver_kind_id(k: DriverKind) -> u32 {
    match k {
        DriverKind::IoUring => 0,
        DriverKind::Epoll => 1,
        DriverKind::Kqueue => 2,
        DriverKind::Iocp => 3,
    }
}

pub fn driver_kind_from_name(in name: Slice[u8]) -> Option[DriverKind] {
    let mut a: u64 = 0;
    let mut b: u64 = name.len();
    loop {
        if a >= b {
            break;
        }
        if !is_ascii_ws(slice_byte(in name, a)) {
            break;
        }
        a = wrapping_add(a, 1);
    }
    loop {
        if b <= a {
            break;
        }
        if !is_ascii_ws(slice_byte(in name, wrapping_sub(b, 1))) {
            break;
        }
        b = wrapping_sub(b, 1);
    }
    if eq_trimmed_lower(in name, a, b, in "io_uring".as_bytes())
        || eq_trimmed_lower(in name, a, b, in "io-uring".as_bytes())
        || eq_trimmed_lower(in name, a, b, in "uring".as_bytes()) {
        return Option::Some(DriverKind::IoUring);
    }
    if eq_trimmed_lower(in name, a, b, in "epoll".as_bytes()) {
        return Option::Some(DriverKind::Epoll);
    }
    if eq_trimmed_lower(in name, a, b, in "kqueue".as_bytes()) {
        return Option::Some(DriverKind::Kqueue);
    }
    if eq_trimmed_lower(in name, a, b, in "iocp".as_bytes()) {
        return Option::Some(DriverKind::Iocp);
    }
    Option::None
}

fn slot_at(in seq: ChunkSeq[RequestSlot], idx: u64) -> RequestSlot {
    match seq.try_get(idx) {
        Option::Some(v) => v,
        Option::None => RequestSlot {
            id: RequestId { bits: 0 },
            fd: -1,
            op: Operation::Read,
            offset: 0,
            len: 0,
            token: 0,
            cancelled: false,
        },
    }
}

pub fn readiness_queue_new(
    kind: DriverKind,
    capacity: u64
) -> ReadinessQueue eff [Fail[DriverError]] {
    if capacity == 0 {
        return Fail::raise(DriverError::InvalidCapacity);
    }
    ReadinessQueue {
        kind: kind,
        capacity: capacity,
        next_id: 1,
        waiting: ChunkSeq::new[RequestSlot](),
        ready: ChunkSeq::new[CompletionSlot](),
    }
}

pub fn readiness_queue_kind(in q: ReadinessQueue) -> DriverKind {
    q.kind
}

pub fn readiness_queue_pending(in q: ReadinessQueue) -> u64 {
    wrapping_add(q.waiting.len(), q.ready.len())
}

pub fn readiness_queue_in_flight(in q: ReadinessQueue) -> u64 {
    q.waiting.len()
}

pub fn readiness_queue_has_ready(in q: ReadinessQueue) -> bool {
    q.ready.len() > 0
}

pub fn readiness_queue_submit(
    inout q: ReadinessQueue,
    fd: i32,
    op: Operation,
    offset: u64,
    len: u64,
    token: u64,
) -> RequestId eff [Fail[DriverError]] {
    if readiness_queue_pending(in q) >= q.capacity {
        return Fail::raise(DriverError::QueueFull);
    }
    let id = RequestId { bits: q.next_id };
    q.next_id = wrapping_add(q.next_id, 1);
    q.waiting.push(RequestSlot {
        id: id,
        fd: fd,
        op: op,
        offset: offset,
        len: len,
        token: token,
        cancelled: false,
    });
    id
}

pub fn readiness_queue_mark_cancelled(inout q: ReadinessQueue, id: RequestId) -> bool {
    let n = q.waiting.len();
    for i in 0..n {
        let mut s = slot_at(in q.waiting, i);
        if s.id.bits == id.bits {
            s.cancelled = true;
            let _ok = q.waiting.try_set(i, s);
            return true;
        }
    }
    false
}

pub fn readiness_queue_cancel_all(inout q: ReadinessQueue) -> u64 {
    let n = q.waiting.len();
    for i in 0..n {
        let mut s = slot_at(in q.waiting, i);
        s.cancelled = true;
        let _ok = q.waiting.try_set(i, s);
    }
    n
}

pub fn readiness_queue_complete(
    inout q: ReadinessQueue,
    id: RequestId,
    ok: bool,
    bytes: u64,
    errno: u32,
) -> () eff [Fail[DriverError]] {
    let n = q.waiting.len();
    let mut found = false;
    let mut found_idx: u64 = 0;
    let mut was_cancelled = false;
    for i in 0..n {
        let s = slot_at(in q.waiting, i);
        if s.id.bits == id.bits {
            found = true;
            found_idx = i;
            was_cancelled = s.cancelled;
            break;
        }
    }
    if !found {
        return Fail::raise(DriverError::UnknownRequest);
    }
    let last = wrapping_sub(n, 1);
    for j in found_idx..last {
        let next_slot = slot_at(in q.waiting, wrapping_add(j, 1));
        let _ok = q.waiting.try_set(j, next_slot);
    }
    let _popped = q.waiting.pop();
    q.ready.push(CompletionSlot {
        id: id,
        ok: ok,
        bytes: bytes,
        errno: errno,
        cancelled: was_cancelled,
    });
}

pub fn readiness_queue_take_ready(inout q: ReadinessQueue) -> ChunkSeq[CompletionSlot] {
    replace(inout q.ready, ChunkSeq::new[CompletionSlot]())
}

pub copy enum FiberEvent {
    Start,
    Yield,
    IoOk(u64),
    IoErr(u32),
    Cancelled,
}

pub copy enum StepKind {
    Complete(u64),
    Failed(u32),
    Yield(u64),
    Io(u64),
}

pub copy struct ReadyEntry {
    pub fiber_id: u64,
    pub event: FiberEvent,
}

pub struct SchedulerState {
    ready: ChunkSeq[ReadyEntry],
    ready_head: u64,
    completed: ChunkSeq[u64],
    completed_head: u64,
    failures: ChunkSeq[u32],
    failures_head: u64,
    in_flight: u64,
}

fn ready_at(in seq: ChunkSeq[ReadyEntry], idx: u64) -> ReadyEntry {
    match seq.try_get(idx) {
        Option::Some(v) => v,
        Option::None => ReadyEntry {
            fiber_id: 0,
            event: FiberEvent::Start,
        },
    }
}

pub fn scheduler_new() -> SchedulerState {
    SchedulerState {
        ready: ChunkSeq::new[ReadyEntry](),
        ready_head: 0,
        completed: ChunkSeq::new[u64](),
        completed_head: 0,
        failures: ChunkSeq::new[u32](),
        failures_head: 0,
        in_flight: 0,
    }
}

pub fn scheduler_spawn(inout s: SchedulerState, fiber_id: u64) -> () {
    s.ready.push(ReadyEntry {
        fiber_id: fiber_id,
        event: FiberEvent::Start,
    });
}

pub fn scheduler_ready_count(in s: SchedulerState) -> u64 {
    wrapping_sub(s.ready.len(), s.ready_head)
}

pub fn scheduler_completed_count(in s: SchedulerState) -> u64 {
    wrapping_sub(s.completed.len(), s.completed_head)
}

pub fn scheduler_failure_count(in s: SchedulerState) -> u64 {
    wrapping_sub(s.failures.len(), s.failures_head)
}

pub fn scheduler_is_idle(in s: SchedulerState) -> bool {
    scheduler_ready_count(in s) == 0 && s.in_flight == 0
}

pub fn scheduler_cancel_all(inout s: SchedulerState) -> u64 {
    let n = s.ready.len();
    let mut marked: u64 = 0;
    for i in s.ready_head..n {
        let mut entry = ready_at(in s.ready, i);
        entry.event = FiberEvent::Cancelled;
        let _ok = s.ready.try_set(i, entry);
        marked = wrapping_add(marked, 1);
    }
    marked
}

pub fn scheduler_pop_ready(inout s: SchedulerState) -> Option[ReadyEntry] {
    if s.ready_head >= s.ready.len() {
        return Option::None;
    }
    let entry = ready_at(in s.ready, s.ready_head);
    s.ready_head = wrapping_add(s.ready_head, 1);
    if s.ready_head == s.ready.len() {
        s.ready = ChunkSeq::new[ReadyEntry]();
        s.ready_head = 0;
    }
    Option::Some(entry)
}

pub fn scheduler_apply_step(inout s: SchedulerState, step: StepKind) -> () {
    match step {
        StepKind::Complete(val) => s.completed.push(val),
        StepKind::Failed(code) => s.failures.push(code),
        StepKind::Yield(fiber_id) => {
            s.ready.push(ReadyEntry {
                fiber_id: fiber_id,
                event: FiberEvent::Yield,
            });
        }
        StepKind::Io(_req_id) => {
            s.in_flight = wrapping_add(s.in_flight, 1);
        }
    }
}

pub fn scheduler_enqueue_io(
    inout s: SchedulerState,
    fiber_id: u64,
    ok: bool,
    bytes: u64,
    errno: u32,
) -> () {
    if s.in_flight > 0 {
        s.in_flight = wrapping_sub(s.in_flight, 1);
    }
    let ev = if ok {
        FiberEvent::IoOk(bytes)
    } else {
        FiberEvent::IoErr(errno)
    };
    s.ready.push(ReadyEntry {
        fiber_id: fiber_id,
        event: ev,
    });
}

pub fn scheduler_take_completed(inout s: SchedulerState) -> Option[u64] {
    if s.completed_head >= s.completed.len() {
        return Option::None;
    }
    let v = match s.completed.try_get(s.completed_head) {
        Option::Some(x) => x,
        Option::None => 0,
    };
    s.completed_head = wrapping_add(s.completed_head, 1);
    if s.completed_head == s.completed.len() {
        s.completed = ChunkSeq::new[u64]();
        s.completed_head = 0;
    }
    Option::Some(v)
}

pub fn scheduler_take_failure(inout s: SchedulerState) -> Option[u32] {
    if s.failures_head >= s.failures.len() {
        return Option::None;
    }
    let v = match s.failures.try_get(s.failures_head) {
        Option::Some(x) => x,
        Option::None => 0,
    };
    s.failures_head = wrapping_add(s.failures_head, 1);
    if s.failures_head == s.failures.len() {
        s.failures = ChunkSeq::new[u32]();
        s.failures_head = 0;
    }
    Option::Some(v)
}

pub copy enum Preference {
    Auto,
    Only(DriverKind),
}

pub copy enum SelectError {
    UnknownDriver,
    NotCompiled(DriverKind),
    Unavailable,
}

fn trim_ascii_bounds(in s: Slice[u8]) -> (u64, u64) {
    let mut a: u64 = 0;
    let mut b: u64 = s.len();
    loop {
        if a >= b {
            break;
        }
        if !is_ascii_ws(slice_byte(in s, a)) {
            break;
        }
        a = wrapping_add(a, 1);
    }
    loop {
        if b <= a {
            break;
        }
        if !is_ascii_ws(slice_byte(in s, wrapping_sub(b, 1))) {
            break;
        }
        b = wrapping_sub(b, 1);
    }
    (a, b)
}

pub fn preference_parse(in value: Slice[u8]) -> Preference eff [Fail[SelectError]] {
    let (a, b) = trim_ascii_bounds(in value);
    if a == b || eq_trimmed_lower(in value, a, b, in "auto".as_bytes()) {
        return Preference::Auto;
    }
    match driver_kind_from_name(in value) {
        Option::Some(k) => Preference::Only(k),
        Option::None => Fail::raise(SelectError::UnknownDriver),
    }
}

pub fn select_driver_for_host(pref: Preference) -> DriverKind eff [Fail[SelectError]] {
    match pref {
        Preference::Only(k) => {
            if !driver_kind_compiled(k) {
                return Fail::raise(SelectError::NotCompiled(k));
            }
            k
        }
        Preference::Auto => {
            let order = host_order();
            match order.try_get(0) {
                Option::Some(k) => k,
                Option::None => Fail::raise(SelectError::Unavailable),
            }
        }
    }
}

pub fn driver_kind_compiled(k: DriverKind) -> bool {
    match k {
        DriverKind::Iocp => true,
        _ => false
    }
}

pub fn host_order() -> ChunkSeq[DriverKind] {
    let mut out = ChunkSeq::new[DriverKind]();
    out.push(DriverKind::Iocp);
    out
}

// Deterministic work-stealing fiber pool (§12.4).

pub copy struct FiberId {
    pub bits: u64,
}

pub copy struct PoolConfig {
    pub workers: u64,
    pub seed: u64,
    pub lifo_slot: bool,
    pub driver_wakeup: bool,
    pub pin_cores: bool,
    pub keep_results: bool,
}

pub fn max_workers() -> u64 {
    1024
}

pub fn default_pool_config(workers: u64) -> PoolConfig {
    PoolConfig {
        workers: workers,
        seed: 0,
        lifo_slot: true,
        driver_wakeup: true,
        pin_cores: false,
        keep_results: true,
    }
}

pub copy struct WorkerStats {
    pub resumed: u64,
    pub stolen: u64,
    pub steal_attempts: u64,
    pub submitted: u64,
    pub parked: u64,
    pub pinned_core: Option[u64],
}

pub copy enum TraceEvent {
    TraceStart,
    TraceYield,
    TraceIo,
    TraceCancelled,
}

pub copy struct TraceEntry {
    pub step: u64,
    pub worker: u64,
    pub fiber: FiberId,
    pub event: TraceEvent,
    pub stolen_from: Option[u64],
}

pub copy enum PoolError {
    InvalidWorkers(u64),
    NoSuchWorker(u64),
    PoolClosed,
}

pub copy struct CompletedFiber {
    pub id: FiberId,
    pub tag: u64,
}

pub copy struct FailedFiber {
    pub id: FiberId,
    pub code: u64,
}

pub struct PoolOutput {
    pub completed: ChunkSeq[CompletedFiber],
    pub failures: ChunkSeq[FailedFiber],
    pub workers: ChunkSeq[WorkerStats],
    pub trace: ChunkSeq[TraceEntry],
    pub abandoned: u64,
}

pub copy struct Rng {
    pub rng_state: u64,
}

pub fn rng_next(inout r: Rng) -> u64 {
    r.rng_state = wrapping_add(r.rng_state, 0x9e37_79b9_7f4a_7c15);
    let mut z = r.rng_state;
    z = wrapping_mul(z ^ (z >> 30), 0xbf58_476d_1ce4_e5b9);
    z = wrapping_mul(z ^ (z >> 27), 0x94d0_49bb_1331_11eb);
    z ^ (z >> 31)
}

pub fn rng_new(seed: u64, stream: u64) -> Rng {
    let mut r = Rng {
        rng_state: seed ^ wrapping_mul(stream, 0xa076_1d64_78bd_642f),
    };
    let _ = rng_next(inout r);
    r
}

pub fn rng_below(inout r: Rng, n: u64) -> u64 {
    if n == 0 {
        return 0;
    }
    let v = rng_next(inout r);
    handle Fail[RuntimeError] in {
        v % n
    } with {
        return x => x,
        raise(e, k) => 0,
    }
}

pub copy struct FiberTask {
    pub id: FiberId,
    pub home: Option[u64],
    pub remaining_yields: u64,
    pub fail_on_complete: bool,
    pub result_tag: u64,
    pub spawn_child_yields: Option[u64],
    pub event: TraceEvent,
}

struct WorkerState {
    local: ChunkSeq[FiberTask],
    pinned: ChunkSeq[FiberTask],
    lifo: Option[FiberTask],
    rng: Rng,
    ticks: u64,
    lifo_streak: u64,
    stats: WorkerStats,
}

pub struct SeededPool {
    pub config: PoolConfig,
    workers: ChunkSeq[WorkerState],
    injector: ChunkSeq[FiberTask],
    next_id: u64,
    live: u64,
    cancelled: bool,
    closed: bool,
    trace_step: u64,
    completed: ChunkSeq[CompletedFiber],
    failures: ChunkSeq[FailedFiber],
    trace: ChunkSeq[TraceEntry],
}

fn empty_stats() -> WorkerStats {
    WorkerStats {
        resumed: 0,
        stolen: 0,
        steal_attempts: 0,
        submitted: 0,
        parked: 0,
        pinned_core: Option::None,
    }
}

pub fn new_seeded_pool(config: PoolConfig) -> Result[SeededPool, PoolError] {
    if config.workers == 0 || config.workers > max_workers() {
        return Result::Err(PoolError::InvalidWorkers(config.workers));
    }
    let mut workers: ChunkSeq[WorkerState] = ChunkSeq::new();
    let mut i: u64 = 0;
    loop {
        if i >= config.workers {
            break;
        }
        workers.push(WorkerState {
            local: ChunkSeq::new(),
            pinned: ChunkSeq::new(),
            lifo: Option::None,
            rng: rng_new(config.seed, wrapping_add(i, 1)),
            ticks: 0,
            lifo_streak: 0,
            stats: empty_stats(),
        });
        i = wrapping_add(i, 1);
    }
    Result::Ok(SeededPool {
        config: config,
        workers: workers,
        injector: ChunkSeq::new(),
        next_id: 1,
        live: 0,
        cancelled: false,
        closed: false,
        trace_step: 0,
        completed: ChunkSeq::new(),
        failures: ChunkSeq::new(),
        trace: ChunkSeq::new(),
    })
}

fn pop_front_task(inout q: ChunkSeq[FiberTask]) -> Option[FiberTask] {
    let mut rev: ChunkSeq[FiberTask] = ChunkSeq::new();
    loop {
        match q.pop() {
            Option::Some(t) => rev.push(t),
            Option::None => break,
        }
    }
    let first = rev.pop();
    loop {
        match rev.pop() {
            Option::Some(t) => q.push(t),
            Option::None => break,
        }
    }
    first
}

pub fn spawn_fiber(
    inout pool: SeededPool,
    yields: u64,
    fail_on_complete: bool,
    result_tag: u64,
    spawn_child_yields: Option[u64],
) -> Result[FiberId, PoolError] {
    if pool.closed {
        return Result::Err(PoolError::PoolClosed);
    }
    let id = FiberId { bits: pool.next_id };
    pool.next_id = wrapping_add(pool.next_id, 1);
    pool.live = wrapping_add(pool.live, 1);
    let ev = if pool.cancelled {
        TraceEvent::TraceCancelled
    } else {
        TraceEvent::TraceStart
    };
    pool.injector.push(FiberTask {
        id: id,
        home: Option::None,
        remaining_yields: yields,
        fail_on_complete: fail_on_complete,
        result_tag: result_tag,
        spawn_child_yields: spawn_child_yields,
        event: ev,
    });
    Result::Ok(id)
}

pub fn spawn_pinned(
    inout pool: SeededPool,
    worker: u64,
    yields: u64,
    fail_on_complete: bool,
    result_tag: u64,
) -> Result[FiberId, PoolError] {
    if pool.closed {
        return Result::Err(PoolError::PoolClosed);
    }
    if worker >= pool.workers.len() {
        return Result::Err(PoolError::NoSuchWorker(worker));
    }
    let id = FiberId { bits: pool.next_id };
    pool.next_id = wrapping_add(pool.next_id, 1);
    pool.live = wrapping_add(pool.live, 1);
    let ev = if pool.cancelled {
        TraceEvent::TraceCancelled
    } else {
        TraceEvent::TraceStart
    };
    let task = FiberTask {
        id: id,
        home: Option::Some(worker),
        remaining_yields: yields,
        fail_on_complete: fail_on_complete,
        result_tag: result_tag,
        spawn_child_yields: Option::None,
        event: ev,
    };
    let _ = handle Fail[RuntimeError] in {
        pool.workers[worker].pinned.push(task);
        0
    } with {
        return x => x,
        raise(e, k) => 0,
    };
    Result::Ok(id)
}

pub fn cancel_pool(inout pool: SeededPool) {
    pool.cancelled = true;
}

fn mod_u64(a: u64, b: u64) -> u64 {
    if b == 0 {
        return 0;
    }
    handle Fail[RuntimeError] in {
        a % b
    } with {
        return x => x,
        raise(e, k) => 0,
    }
}

fn div_u64(a: u64, b: u64) -> u64 {
    if b == 0 {
        return 0;
    }
    handle Fail[RuntimeError] in {
        a / b
    } with {
        return x => x,
        raise(e, k) => 0,
    }
}

copy struct PickedJob {
    found: bool,
    task: FiberTask,
    stolen_from: Option[u64],
}

fn empty_task() -> FiberTask {
    FiberTask {
        id: FiberId { bits: 0 },
        home: Option::None,
        remaining_yields: 0,
        fail_on_complete: false,
        result_tag: 0,
        spawn_child_yields: Option::None,
        event: TraceEvent::TraceStart,
    }
}

fn try_steal_from(inout pool: SeededPool, thief: u64, victim: u64) -> PickedJob {
    let vlen = handle Fail[RuntimeError] in {
        pool.workers[victim].local.len()
    } with {
        return x => x,
        raise(e, k) => 0,
    };
    if vlen == 0 {
        return PickedJob {
            found: false,
            task: empty_task(),
            stolen_from: Option::None,
        };
    }
    let half = div_u64(wrapping_add(vlen, 1), 2);
    let take_n = if half > 32 {
        32
    } else if half == 0 {
        1
    } else {
        half
    };
    let mut stolen_batch: ChunkSeq[FiberTask] = ChunkSeq::new();
    let mut i: u64 = 0;
    loop {
        if i >= take_n {
            break;
        }
        let popped = handle Fail[RuntimeError] in {
            pop_front_task(inout pool.workers[victim].local)
        } with {
            return x => x,
            raise(e, k) => Option::None,
        };
        match popped {
            Option::Some(t) => stolen_batch.push(t),
            Option::None => break,
        }
        i = wrapping_add(i, 1);
    }
    let first_opt = pop_front_task(inout stolen_batch);
    let first = match first_opt {
        Option::Some(t) => t,
        Option::None => {
            return PickedJob {
                found: false,
                task: empty_task(),
                stolen_from: Option::None,
            };
        }
    };
    let mut extra: u64 = 0;
    loop {
        match pop_front_task(inout stolen_batch) {
            Option::Some(t) => {
                let _ = handle Fail[RuntimeError] in {
                    pool.workers[thief].local.push(t);
                    0
                } with {
                    return x => x,
                    raise(e, k) => 0,
                };
                extra = wrapping_add(extra, 1);
            }
            Option::None => break,
        }
    }
    let total_stolen = wrapping_add(1, extra);
    let _ = handle Fail[RuntimeError] in {
        pool.workers[thief]
            .stats
            .stolen = wrapping_add(pool.workers[thief].stats.stolen, total_stolen);
        0
    } with {
        return x => x,
        raise(e, k) => 0,
    };
    PickedJob {
        found: true,
        task: first,
        stolen_from: Option::Some(victim),
    }
}

fn next_job(inout pool: SeededPool, w: u64) -> PickedJob {
    let n = pool.workers.len();
    let ticks = handle Fail[RuntimeError] in {
        pool.workers[w].ticks = wrapping_add(pool.workers[w].ticks, 1);
        pool.workers[w].ticks
    } with {
        return x => x,
        raise(e, k) => 1,
    };
    if mod_u64(ticks, 61) == 0 {
        match pop_front_task(inout pool.injector) {
            Option::Some(t) => {
                return PickedJob {
                    found: true,
                    task: t,
                    stolen_from: Option::None,
                };
            }
            Option::None => {}
        }
    }
    let streak = handle Fail[RuntimeError] in {
        pool.workers[w].lifo_streak
    } with {
        return x => x,
        raise(e, k) => 0,
    };
    if streak < 3 {
        let lifo_opt = handle Fail[RuntimeError] in {
            replace(inout pool.workers[w].lifo, Option::None)
        } with {
            return x => x,
            raise(e, k) => Option::None,
        };
        match lifo_opt {
            Option::Some(t) => {
                let _ = handle Fail[RuntimeError] in {
                    pool.workers[w].lifo_streak = wrapping_add(streak, 1);
                    0
                } with {
                    return x => x,
                    raise(e, k) => 0,
                };
                return PickedJob {
                    found: true,
                    task: t,
                    stolen_from: Option::None,
                };
            }
            Option::None => {}
        }
    }
    let _ = handle Fail[RuntimeError] in {
        pool.workers[w].lifo_streak = 0;
        0
    } with {
        return x => x,
        raise(e, k) => 0,
    };
    let even = mod_u64(ticks, 2) == 0;
    let first_own = if even {
        handle Fail[RuntimeError] in {
            pop_front_task(inout pool.workers[w].pinned)
        } with {
            return x => x,
            raise(e, k) => Option::None,
        }
    } else {
        handle Fail[RuntimeError] in {
            pop_front_task(inout pool.workers[w].local)
        } with {
            return x => x,
            raise(e, k) => Option::None,
        }
    };
    match first_own {
        Option::Some(t) => {
            return PickedJob {
                found: true,
                task: t,
                stolen_from: Option::None,
            };
        }
        Option::None => {}
    }
    let second_own = if even {
        handle Fail[RuntimeError] in {
            pop_front_task(inout pool.workers[w].local)
        } with {
            return x => x,
            raise(e, k) => Option::None,
        }
    } else {
        handle Fail[RuntimeError] in {
            pop_front_task(inout pool.workers[w].pinned)
        } with {
            return x => x,
            raise(e, k) => Option::None,
        }
    };
    match second_own {
        Option::Some(t) => {
            return PickedJob {
                found: true,
                task: t,
                stolen_from: Option::None,
            };
        }
        Option::None => {}
    }
    let lifo_fb = handle Fail[RuntimeError] in {
        replace(inout pool.workers[w].lifo, Option::None)
    } with {
        return x => x,
        raise(e, k) => Option::None,
    };
    match lifo_fb {
        Option::Some(t) => {
            return PickedJob {
                found: true,
                task: t,
                stolen_from: Option::None,
            };
        }
        Option::None => {}
    }
    match pop_front_task(inout pool.injector) {
        Option::Some(t) => {
            return PickedJob {
                found: true,
                task: t,
                stolen_from: Option::None,
            };
        }
        Option::None => {}
    }
    if n < 2 {
        return PickedJob {
            found: false,
            task: empty_task(),
            stolen_from: Option::None,
        };
    }
    let start = handle Fail[RuntimeError] in {
        pool.workers[w]
            .stats
            .steal_attempts = wrapping_add(pool.workers[w].stats.steal_attempts, 1);
        rng_below(inout pool.workers[w].rng, n)
    } with {
        return x => x,
        raise(e, k) => 0,
    };
    let mut k: u64 = 0;
    loop {
        if k >= n {
            break;
        }
        let victim = mod_u64(wrapping_add(start, k), n);
        if victim != w {
            let stolen = try_steal_from(inout pool, w, victim);
            if stolen.found {
                return stolen;
            }
        }
        k = wrapping_add(k, 1);
    }
    PickedJob {
        found: false,
        task: empty_task(),
        stolen_from: Option::None,
    }
}

fn place_task(inout pool: SeededPool, w: u64, task: FiberTask, internal_spawn: bool) {
    match task.home {
        Option::Some(h) => {
            let _ = handle Fail[RuntimeError] in {
                pool.workers[h].pinned.push(task);
                0
            } with {
                return x => x,
                raise(e, k) => 0,
            };
        }
        Option::None => {
            if internal_spawn && pool.config.lifo_slot {
                let prev_lifo = handle Fail[RuntimeError] in {
                    replace(inout pool.workers[w].lifo, Option::Some(task))
                } with {
                    return x => x,
                    raise(e, k) => Option::None,
                };
                match prev_lifo {
                    Option::Some(displaced) => {
                        let _ = handle Fail[RuntimeError] in {
                            pool.workers[w].local.push(displaced);
                            0
                        } with {
                            return x => x,
                            raise(e, k) => 0,
                        };
                    }
                    Option::None => {}
                }
            } else {
                let _ = handle Fail[RuntimeError] in {
                    pool.workers[w].local.push(task);
                    0
                } with {
                    return x => x,
                    raise(e, k) => 0,
                };
            }
        }
    }
}

fn worker_step(inout pool: SeededPool, w: u64) -> bool {
    let job = next_job(inout pool, w);
    if !job.found {
        return false;
    }
    let t = job.task;
    let ev = if pool.cancelled {
        TraceEvent::TraceCancelled
    } else {
        t.event
    };
    let step_idx = pool.trace_step;
    pool.trace_step = wrapping_add(pool.trace_step, 1);
    pool.trace.push(TraceEntry {
        step: step_idx,
        worker: w,
        fiber: t.id,
        event: ev,
        stolen_from: job.stolen_from,
    });
    let _ = handle Fail[RuntimeError] in {
        pool.workers[w].stats.resumed = wrapping_add(pool.workers[w].stats.resumed, 1);
        0
    } with {
        return x => x,
        raise(e, k) => 0,
    };
    match t.spawn_child_yields {
        Option::Some(cy) => {
            let cid = FiberId { bits: pool.next_id };
            pool.next_id = wrapping_add(pool.next_id, 1);
            pool.live = wrapping_add(pool.live, 1);
            let cev = if pool.cancelled {
                TraceEvent::TraceCancelled
            } else {
                TraceEvent::TraceStart
            };
            place_task(
                inout pool,
                w,
                FiberTask {
                    id: cid,
                    home: Option::None,
                    remaining_yields: cy,
                    fail_on_complete: false,
                    result_tag: cid.bits,
                    spawn_child_yields: Option::None,
                    event: cev,
                },
                true,
            );
        }
        Option::None => {}
    }
    if t.remaining_yields > 0 {
        let next_t = FiberTask {
            id: t.id,
            home: t.home,
            remaining_yields: wrapping_sub(t.remaining_yields, 1),
            fail_on_complete: t.fail_on_complete,
            result_tag: t.result_tag,
            spawn_child_yields: Option::None,
            event: TraceEvent::TraceYield,
        };
        place_task(inout pool, w, next_t, false);
    } else {
        if pool.config.keep_results {
            if t.fail_on_complete {
                pool.failures.push(FailedFiber { id: t.id, code: t.result_tag });
            } else {
                pool.completed.push(CompletedFiber { id: t.id, tag: t.result_tag });
            }
        }
        pool.live = wrapping_sub(pool.live, 1);
    }
    true
}

pub fn run_seeded(inout pool: SeededPool) -> PoolOutput {
    pool.closed = true;
    let n = pool.workers.len();
    let mut chooser = rng_new(pool.config.seed, 0);
    let mut idle_rounds: u64 = 0;
    let limit = wrapping_mul(n, 4);
    loop {
        if pool.live == 0 {
            break;
        }
        let w = rng_below(inout chooser, n);
        if worker_step(inout pool, w) {
            idle_rounds = 0;
            continue;
        }
        idle_rounds = wrapping_add(idle_rounds, 1);
        if idle_rounds >= limit {
            break;
        }
    }
    let mut wstats: ChunkSeq[WorkerStats] = ChunkSeq::new();
    let mut i: u64 = 0;
    loop {
        if i >= n {
            break;
        }
        let st = handle Fail[RuntimeError] in {
            pool.workers[i].stats
        } with {
            return x => x,
            raise(e, k) => empty_stats(),
        };
        wstats.push(st);
        i = wrapping_add(i, 1);
    }
    PoolOutput {
        completed: replace(inout pool.completed, ChunkSeq::new()),
        failures: replace(inout pool.failures, ChunkSeq::new()),
        workers: wstats,
        trace: replace(inout pool.trace, ChunkSeq::new()),
        abandoned: pool.live,
    }
}
