load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("@rules_rs//rs/private:all_crate_deps.bzl", "all_crate_deps")
load("@vesper_cargo//:packages.bzl", "PACKAGES")
load("//tools/bazel:defs.bzl", "vesper_crate")
load("//tools/bazel:vesper_port.bzl", "VESPER_TARGET", "vesper_package", "vesper_port_object")

# The Rust build is the default (default features, generated by
# vesper_crate below). The Vesper port (the Loom package in vesper/, Cargo
# feature `vesper-port`, port wave P3a lane 6, #1041) is non-default until it
# reaches performance parity. The compiler links neither: it links the Rust
# seed copy, //crates/vesper-ebpf/seed (seed-copy rule,
# docs/maintenance/porting-a-crate.md).
vesper_package(
    name = "port_package",
    srcs = glob(["vesper/src/**/*.ves"]),
    manifest = "vesper/Loom.toml",
)

vesper_port_object(
    name = "ebpf_vesper",
    library = "ebpf",
    package = ":port_package",
    rust_types = "crate::port",
    target = VESPER_TARGET,
)

filegroup(
    name = "ebpf_vesper_binding",
    srcs = [":ebpf_vesper"],
    output_group = "rust_binding",
)

# The build script links this object only under `vesper-port`; passing it
# keeps the port in this package's dependency graph for the seed-copy guard.
vesper_crate(
    build_script_data = [
        ":ebpf_vesper",
        ":ebpf_vesper_binding",
    ],
    build_script_env = {
        # rules_rust already makes these execpaths absolute.
        "VESPER_PORT_OBJECT": "$(execpath :ebpf_vesper)",
        "VESPER_PORT_GENERATED_BINDING": "$(execpath :ebpf_vesper_binding)",
    },
    # tests/lean_model.rs compiles lean/EbpfFirewall.lean; Lean resolves
    # symlinked runfiles to the source tree and then rejects them as outside
    # --root, so it runs in a copy of regular files.
    copy_test_cwd = ["test/lean_model"],
    extra_test_data = ["//:lean"],
)

# The seed package (seed/) builds these same Rust sources without the port.
exports_files(glob([
    "src/**/*.rs",
    "tests/**/*.rs",
]))

filegroup(
    name = "rust_srcs",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//crates/vesper-ebpf/seed:__pkg__"],
)

# The divergent builds, one per ported module (the Cargo
# `vesper-port-divergent` feature applies the same edits from build.rs, one
# at a time with VESPER_EBPF_DIVERGENT): each must keep compiling, and
# crates/vesper-ebpf/port/check.sh asserts which test catches it.
[
    vesper_port_object(
        name = "ebpf_vesper_divergent_" + module,
        edit_src = "vesper/src/%s.ves" % src,
        edits = {old: new},
        library = "ebpf",
        package = ":port_package",
        rust_types = "crate::port",
        target = VESPER_TARGET,
    )
    for module, src, old, new in [
        ("insn", "insn", "        AluOp::Lsh => (OP_LSH, 0),\n", "        AluOp::Lsh => (OP_RSH, 0),\n"),
        ("scalar", "scalar", "    let mu = chi | a.mask | b.mask;\n    tn(sv & ~mu, mu)", "    let mu = chi | a.mask;\n    tn(sv & ~mu, mu)"),
        ("interp", "concrete", "        AluOp::Arsh => sar(a, b & 63),\n", "        AluOp::Arsh => shr(a, b & 63),\n"),
        ("verifier", "scalar", "            x.umin = max_u64(x.umin, wrapping_add(y.umin, 1));\n", "            x.umin = max_u64(x.umin, wrapping_add(y.umin, 2));\n"),
        ("helpers", "helpers", "        ProgramType::SchedCls => id == 84 || id == 86,\n", "        ProgramType::SchedCls => id == 44 || id == 84 || id == 86,\n"),
        ("program", "program", "            if max_entries < 4096 ||", "            if max_entries < 2048 ||"),
        ("callgraph", "callgraph", "        if bytes > lim {\n", "        if bytes > wrapping_add(lim, 8) {\n"),
        ("wire", "wire", "        src_ipv4: wrapping_u32(be(in s, 26, 4)),\n", "        src_ipv4: wrapping_u32(be(in s, 30, 4)),\n"),
        ("explore", "verifier", "            if p.var.smin < 0 || total < 0 || wrapping_add(total, ni) > range {\n", "            if p.var.smin < 0 || total < 0 || wrapping_add(total, ni) > wrapping_add(range, 1) {\n"),
        ("btf", "btf", "        if kind == 0 || kind > 19 {\n", "        if kind == 0 || kind > 20 {\n"),
        ("core", "core", "        if slen(in strs, mname) == 0 {\n", "        if slen(in strs, mname) == 99 {\n"),
        ("btf_ext", "btf_ext", "        out.push(lc & 1023);\n", "        out.push(lc & 511);\n"),
        ("interp_run", "interp", "    if kind == 1 && at < i.data_off {\n", "    if kind == 1 && wrapping_add(at, 1) < i.data_off {\n"),
    ]
]

# The Vesper build: the same sources with cfg(vesper_port), forwarding to
# the port through the committed binding (which the Cargo build checks
# against the generated one). The object is linked into each test binary.
_CRATE_DATA = PACKAGES["crates/vesper-ebpf"].crate_data()

rust_library(
    name = "port",
    srcs = glob(["src/**/*.rs"]) + ["port/binding.rs"],
    crate_features = ["vesper-port"],
    crate_name = "vesper_ebpf",
    crate_root = "src/lib.rs",
    edition = "2024",
    rustc_flags = ["--cfg=vesper_port"],
    deps = ["//crates/vesper-port-abi"] + all_crate_deps(
        _CRATE_DATA,
        normal = True,
        platforms = _CRATE_DATA["platforms"],
    ),
)

# The pure test files against the port. The rest (ELF objects, the kernel,
# Lean and the builders over them) run against the port in Cargo, in the
# Linux "Vesper ports" job (crates/vesper-ebpf/port/check.sh).
[
    rust_test(
        name = "port_%s_test" % test,
        srcs = ["tests/%s.rs" % test] + glob(["tests/common/**/*.rs"]),
        compile_data = [":ebpf_vesper"] + (["src/verifier.rs"] if test == "verifier_rules" else []),
        crate_features = ["vesper-port"],
        crate_name = test,
        crate_root = "tests/%s.rs" % test,
        edition = "2024",
        rustc_flags = ["-Clink-arg=$(location :ebpf_vesper)"],
        deps = [":port"],
    )
    for test in [
        "codec",
        "port_surface",
        "scalar_soundness",
        "soundness",
        "verifier_rules",
    ]
]
