// Module program of @vesper/ebpf (see lib.ves): the program and map kinds of
// src/program.rs and `MapDef::validate`. The assembler and the `Program`
// record stay Rust in this part of the port.

pub copy enum MapKind {
    Hash,
    Array,
    PerCpuHash,
    PerCpuArray,
    LruHash,
    RingBuf,
    ProgArray
}

pub copy enum ProgramType {
    Xdp,
    SchedCls,
    Tracepoint,
    Kprobe
}

pub fn map_kernel_type(k: MapKind) -> u32 {
    match k {
        MapKind::Hash => 1,
        MapKind::Array => 2,
        MapKind::PerCpuHash => 5,
        MapKind::PerCpuArray => 6,
        MapKind::LruHash => 9,
        MapKind::RingBuf => 27,
        MapKind::ProgArray => 3,
    }
}

pub fn map_from_kernel_type(t: u32) -> Option[MapKind] {
    if t == 1 {
        Option::Some(MapKind::Hash)
    } else if t == 2 {
        Option::Some(MapKind::Array)
    } else if t == 5 {
        Option::Some(MapKind::PerCpuHash)
    } else if t == 6 {
        Option::Some(MapKind::PerCpuArray)
    } else if t == 9 {
        Option::Some(MapKind::LruHash)
    } else if t == 27 {
        Option::Some(MapKind::RingBuf)
    } else if t == 3 {
        Option::Some(MapKind::ProgArray)
    } else {
        Option::None
    }
}

pub fn map_is_array(k: MapKind) -> bool {
    match k {
        MapKind::Array => true,
        MapKind::PerCpuArray => true,
        MapKind::ProgArray => true,
        _ => false,
    }
}

pub fn prog_kernel_type(p: ProgramType) -> u32 {
    match p {
        ProgramType::Xdp => 6,
        ProgramType::SchedCls => 3,
        ProgramType::Tracepoint => 5,
        ProgramType::Kprobe => 2,
    }
}

pub fn prog_from_kernel_type(t: u32) -> Option[ProgramType] {
    if t == 6 {
        Option::Some(ProgramType::Xdp)
    } else if t == 3 {
        Option::Some(ProgramType::SchedCls)
    } else if t == 5 {
        Option::Some(ProgramType::Tracepoint)
    } else if t == 2 {
        Option::Some(ProgramType::Kprobe)
    } else {
        Option::None
    }
}

pub fn prog_has_packet(p: ProgramType) -> bool {
    match p {
        ProgramType::Xdp => true,
        ProgramType::SchedCls => true,
        _ => false,
    }
}

pub fn prog_is_tracing(p: ProgramType) -> bool {
    !prog_has_packet(p)
}

fn ascii(in name: Str) -> bool {
    for i in 0..name.len() {
        match name.try_byte_at(i) {
            Option::Some(b) => if b >= 128 {
                return false;
            },
            Option::None => (),
        }
    }
    true
}

// `MapDef::validate`: 0 when valid, else the rule that fails (the Rust
// wrapper formats the message): 1 name, 2 ringbuf key/value size, 3 ringbuf
// size, 4 zero max_entries or value_size, 5 array key size, 6 program array
// value size, 7 key size, 8 value size.
pub fn map_validate(in name: Str, kind: MapKind, key_size: u32, value_size: u32, max_entries: u32)
    -> u64 {
    if name.len() == 0 || name.len() > 15 || !ascii(in name) {
        return 1;
    }
    match kind {
        MapKind::RingBuf => {
            if key_size != 0 || value_size != 0 {
                return 2;
            }
            if max_entries < 4096 || (max_entries & wrapping_sub(max_entries, 1)) != 0 {
                return 3;
            }
            0
        },
        _ => {
            if max_entries == 0 || value_size == 0 {
                return 4;
            }
            if map_is_array(kind) && key_size != 4 {
                return 5;
            }
            let prog_array = match kind {
                MapKind::ProgArray => true,
                _ => false,
            };
            if prog_array && value_size != 4 {
                return 6;
            }
            if key_size == 0 || key_size > 512 {
                return 7;
            }
            if value_size > 1048576 {
                return 8;
            }
            0
        },
    }
}
