// btf.rs

pub fn btf_parse(in btf: Slice[u8], split: bool, base_types: u64, in base_strings: Slice[u8])
    -> ChunkSeq[u64] {
    parse_btf(in btf, split, base_types, in base_strings)
}

// core.rs

pub fn core_local_value(kind: u64, in lt: Slice[u64], in access: Slice[u64], local_id: u64)
    -> ChunkSeq[u64] {
    let mut out: u64 = 0;
    let mut bad: u64 = 0;
    let code = local_value(kind, in lt, in access, local_id, inout out, inout bad);
    let mut w: ChunkSeq[u64] = ChunkSeq::new[u64]();
    w.push(code);
    w.push(out);
    w.push(bad);
    w
}

pub fn core_candidates(
    in lt: Slice[u64],
    in tab: Slice[u64],
    in idx: Slice[u64],
    in ids: Slice[u64],
    from: u64
) -> ChunkSeq[u64] {
    filter_candidates(in lt, in tab, in idx, in ids, from)
}

pub fn core_values(
    kind: u64,
    in lt: Slice[u64],
    in ltext: Slice[u8],
    in access: Slice[u64],
    in tab: Slice[u64],
    in idx: Slice[u64],
    in strs: Slice[u8],
    in cands: Slice[u64]
) -> ChunkSeq[u64] {
    values_over(kind, in lt, in ltext, in access, in tab, in idx, in strs, in cands)
}

// `CoreSpec::target_value_with` without split modules, in one call: the
// result code, with the value and the bad member index in `value` and `bad`.
pub fn core_target_value(
    kind: u64,
    in lt: Slice[u64],
    in ltext: Slice[u8],
    in access: Slice[u32],
    in tab: Slice[u64],
    in idx: Slice[u64],
    in strs: Slice[u8],
    in ids: Slice[u32],
    inout value: u64,
    inout bad: u64
) -> u64 {
    target_value(
        kind,
        in lt,
        in ltext,
        in access,
        in tab,
        in idx,
        in strs,
        in ids,
        0,
        inout value,
        inout bad
    )
}

pub fn core_combine(kind: u64, in values: Slice[u64]) -> ChunkSeq[u64] {
    let mut out: u64 = 0;
    let code = combine(kind, in values, inout out);
    let mut w: ChunkSeq[u64] = ChunkSeq::new[u64]();
    w.push(code);
    w.push(out);
    w
}

pub fn core_patch(
    present: bool,
    code: u64,
    imm: u64,
    off: u64,
    has_next: bool,
    next_imm: u64,
    expected: u64,
    value: u64
) -> ChunkSeq[u64] {
    patch_insn(present, code, imm, off, has_next, next_imm, expected, value)
}

