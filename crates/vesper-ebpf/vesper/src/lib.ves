}

// interp.rs

pub fn interp_new_env(in maps: Slice[u64]) -> Mach {
    new_env(in maps)
}

pub fn interp_clone(in m: Mach) -> Mach {
    clone_mach(in m)
}

pub fn interp_map_has(in m: Mach, map: u64, in key: Slice[u8]) -> bool {
    map_has(in m, map, in key)
}

pub fn interp_map_value(in m: Mach, map: u64, in key: Slice[u8]) -> ChunkSeq[u8] {
