    scalar_srange,
    scalar_sub,
    scalar_truncate,
    scalar_unknown_bits,
    scalar_urange,
    scalar_xor,
    scalar_zext32,
    sext_imm,
    tnum_add,
    tnum_and,
    tnum_arsh,
    tnum_contains,
    tnum_includes,
    tnum_intersect,
    tnum_lsh,
    tnum_or,
