// verifier.rs

pub fn verifier_new_pools() -> Pools {
    new_pools()
}

pub fn verifier_verify(
    in slots: Slice[RawInsn],
    ptype: ProgramType,
    pt_regs: i64,
    gpl: bool,
    in maps: Slice[u64],
    in kfuncs: Slice[u64],
    in text: Slice[u8],
    max_insns: u64,
    max_states: u64,
    widen_loops: bool,
    inout pools: Pools
) -> Outcome {
    verify_program(
        in slots,
        ptype,
        pt_regs,
        gpl,
        in maps,
        in kfuncs,
        in text,
        max_insns,
        max_states,
        widen_loops,
        inout pools
    )
}

