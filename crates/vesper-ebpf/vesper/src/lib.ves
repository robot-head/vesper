}

pub fn interp_run(
    in slots: Slice[RawInsn],
    in kf: Slice[u64],
    ptype: u64,
    input: u64,
    in pkt: Slice[u8],
    in ctx: Slice[u8],
    in cfg: Slice[u64],
    in maps: Slice[u64],
    nmain: u64,
    in tails: Slice[u64],
    in tslots: Slice[RawInsn],
    in taux: Slice[u64],
    reuse: bool,
    inout m: Mach
) {
    run_program(
        in slots,
        in kf,
        ptype,
        input,
        in pkt,
        in ctx,
        in cfg,
        in maps,
        nmain,
        in tails,
        in tslots,
        in taux,
        reuse,
        inout m
    )
}
