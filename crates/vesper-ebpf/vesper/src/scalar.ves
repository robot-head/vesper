// Module scalar of @vesper/ebpf (see lib.ves): src/scalar.rs, the tnum and
// interval domain, and the domain functions of src/verifier.rs
// (`scalar_alu`, `refine_jmp`, `exclude`). The Rust files are the model.
use self::common::{
    bits,
    checked_add_i64,
    checked_sub_i64,
    max_i64,
    max_u64,
    min_i64,
    min_u64,
    sar,
    sext_const,
    shl,
    shr,
    signed,
    smax_i64,
    smin_i64,
    umax
};
use self::insn::{
    AluOp,
    JmpOp
};
use self::concrete::{
    cmp_concrete
};

// Bit `i` is unknown when `mask` bit `i` is set, otherwise it is `value`
// bit `i`. Invariant: `value & mask == 0`.
pub copy struct Tnum {
    value: u64,
    mask: u64
}

pub copy struct Scalar {
    umin: u64,
    umax: u64,
    smin: i64,
    smax: i64,
    var: Tnum
}

fn tn(value: u64, mask: u64) -> Tnum {
    Tnum {
        value: value,
        mask: mask
    }
}

pub fn tnum_unknown() -> Tnum {
    tn(0, umax())
}

pub fn tnum_konst(v: u64) -> Tnum {
    tn(v, 0)
}

// The smallest tnum holding every value of `[min, max]`.
pub fn tnum_range(min: u64, max: u64) -> Tnum {
    let chi = min ^ max;
    let width = wrapping_sub(64, widen_u64(leading_zeros_u64(chi)));
    if width > 63 {
        return tnum_unknown();
    }
    let delta = wrapping_sub(shl(1, width), 1);
    tn(min & ~delta, delta)
}

pub fn tnum_contains(t: Tnum, v: u64) -> bool {
    v & ~t.mask == t.value
}

pub fn tnum_includes(t: Tnum, other: Tnum) -> bool {
    if other.mask & ~t.mask != 0 {
        return false;
    }
    other.value & ~t.mask == t.value
}

pub fn tnum_add(a: Tnum, b: Tnum) -> Tnum {
    let sm = wrapping_add(a.mask, b.mask);
    let sv = wrapping_add(a.value, b.value);
    let sigma = wrapping_add(sm, sv);
    let chi = sigma ^ sv;
    let mu = chi | a.mask | b.mask;
    tn(sv & ~mu, mu)
}

pub fn tnum_sub(a: Tnum, b: Tnum) -> Tnum {
    let dv = wrapping_sub(a.value, b.value);
    let alpha = wrapping_add(dv, a.mask);
    let beta = wrapping_sub(dv, b.mask);
    let chi = alpha ^ beta;
    let mu = chi | a.mask | b.mask;
    tn(dv & ~mu, mu)
}

pub fn tnum_and(a: Tnum, b: Tnum) -> Tnum {
    let alpha = a.value | a.mask;
    let beta = b.value | b.mask;
    let v = a.value & b.value;
    tn(v, alpha & beta & ~v)
}

pub fn tnum_or(a: Tnum, b: Tnum) -> Tnum {
    let v = a.value | b.value;
    let mu = a.mask | b.mask;
    tn(v, mu & ~v)
}

pub fn tnum_xor(a: Tnum, b: Tnum) -> Tnum {
    let v = a.value ^ b.value;
    let mu = a.mask | b.mask;
    tn(v & ~mu, mu)
}

pub fn tnum_lsh(a: Tnum, s: u32) -> Tnum {
    tn(shl(a.value, widen_u64(s)), shl(a.mask, widen_u64(s)))
}

pub fn tnum_rsh(a: Tnum, s: u32) -> Tnum {
    tn(shr(a.value, widen_u64(s)), shr(a.mask, widen_u64(s)))
}

pub fn tnum_arsh(a: Tnum, s: u32) -> Tnum {
    let v = sar(a.value, widen_u64(s));
    let m = sar(a.mask, widen_u64(s));
    tn(v & ~m, m)
}

pub fn tnum_intersect(a: Tnum, b: Tnum) -> Option[Tnum] {
    let known_both = ~a.mask & ~b.mask;
    if (a.value ^ b.value) & known_both != 0 {
        return Option::None;
    }
    let v = a.value | b.value;
    let mu = a.mask & b.mask;
    Option::Some(tn(v & ~mu, mu))
}

pub fn tnum_truncate(a: Tnum, width: u32) -> Tnum {
    if width >= 64 {
        return a;
    }
    let m = wrapping_sub(shl(1, widen_u64(width)), 1);
    tn(a.value & m, a.mask & m)
}

// ---------------------------------------------------------------------------
// Scalar.

pub fn scalar_unknown() -> Scalar {
    Scalar {
        umin: 0,
        umax: umax(),
        smin: smin_i64(),
        smax: smax_i64(),
        var: tnum_unknown()
    }
}

pub fn scalar_konst(v: u64) -> Scalar {
    Scalar {
        umin: v,
        umax: v,
        smin: signed(v),
        smax: signed(v),
        var: tnum_konst(v)
    }
}

fn parts(umin: u64, umax: u64, smin: i64, smax: i64, var: Tnum) -> Scalar {
    Scalar {
        umin: umin,
        umax: umax,
        smin: smin,
        smax: smax,
        var: var
    }
}

pub fn scalar_urange(min: u64, max: u64) -> Scalar {
    let u = scalar_unknown();
    match scalar_normalize(parts(min, max, u.smin, u.smax, u.var)) {
        Option::Some(s) => s,
        Option::None => u,
    }
}

pub fn scalar_srange(min: i64, max: i64) -> Scalar {
    let u = scalar_unknown();
    match scalar_normalize(parts(0, umax(), min, max, u.var)) {
        Option::Some(s) => s,
        Option::None => u,
    }
}

pub fn scalar_unknown_bits(width: u32) -> Scalar {
    if width >= 64 {
        scalar_unknown()
    } else {
        scalar_urange(0, wrapping_sub(shl(1, widen_u64(width)), 1))
    }
}

pub fn scalar_contains(s: Scalar, v: u64) -> bool {
    s
        .umin
        <= v
        && v
        <= s
        .umax
        && s
        .smin
        <= signed(v)
        && signed(v)
        <= s
        .smax
        && tnum_contains(s.var, v)
}

pub fn scalar_includes(s: Scalar, other: Scalar) -> bool {
    s
        .umin
        <= other
        .umin
        && other
        .umax
        <= s
        .umax
        && s
        .smin
        <= other
        .smin
        && other
        .smax
        <= s
        .smax
        && tnum_includes(s.var, other.var)
}

fn is_const(s: Scalar) -> bool {
    s.umin == s.umax
}

// Reduce the three components against each other; None when empty.
pub fn scalar_normalize(input: Scalar) -> Option[Scalar] {
    let mut s = input;
    let sign: u64 = 9223372036854775808;
    // Each round is a function of `s` alone, so a round that changes
    // nothing has reached the fixpoint the remaining rounds would keep.
    for round in 0..3 {
        let before = s;
        // tnum -> intervals
        s.umin = max_u64(s.umin, s.var.value);
        s.umax = min_u64(s.umax, s.var.value | s.var.mask);
        let tsmin = signed(s.var.value | (s.var.mask & sign));
        let tsmax = signed(s.var.value | (s.var.mask & ~sign));
        s.smin = max_i64(s.smin, tsmin);
        s.smax = min_i64(s.smax, tsmax);
        if s.umin > s.umax || s.smin > s.smax {
            return Option::None;
        }
        // signed <-> unsigned
        if s.smin >= 0 || s.smax < 0 {
            let lo = max_u64(s.umin, bits(s.smin));
            let hi = min_u64(s.umax, bits(s.smax));
            if lo > hi {
                return Option::None;
            }
            s.umin = lo;
            s.umax = hi;
            s.smin = signed(lo);
            s.smax = signed(hi);
        } else if signed(s.umax) >= 0 {
            s.smin = signed(s.umin);
            s.smax = min_i64(s.smax, signed(s.umax));
            s.umax = bits(s.smax);
        } else if signed(s.umin) < 0 {
            s.smin = max_i64(s.smin, signed(s.umin));
            s.smax = signed(s.umax);
            s.umin = bits(s.smin);
        }
        if s.umin > s.umax || s.smin > s.smax {
            return Option::None;
        }
        // intervals -> tnum: `tnum_intersect(s.var, tnum_range(..))`, inline
        let chi = s.umin ^ s.umax;
        let width = wrapping_sub(64, widen_u64(leading_zeros_u64(chi)));
        let mut rv: u64 = 0;
        let mut rm: u64 = umax();
        if width <= 63 {
            rm = wrapping_sub(shl(1, width), 1);
            rv = s.umin & ~rm;
        }
        if (s.var.value ^ rv) & (~s.var.mask & ~rm) != 0 {
            return Option::None;
        }
        let mu = s.var.mask & rm;
        let value = (s.var.value | rv) & ~mu;
        let moved_u = (s.umin ^ before.umin) | (s.umax ^ before.umax);
        let moved_s = (bits(s.smin) ^ bits(before.smin)) | (bits(s.smax) ^ bits(before.smax));
        let moved = moved_u | moved_s | (value ^ before.var.value) | (mu ^ before.var.mask);
        s.var = tn(value, mu);
        if moved == 0 {
            break;
        }
    }
    if s.umin > s.umax || s.smin > s.smax {
        return Option::None;
    }
    Option::Some(s)
}

fn norm(s: Scalar) -> Scalar {
    match scalar_normalize(s) {
        Option::Some(n) => n,
        Option::None => scalar_unknown(),
    }
}

fn from_parts(umin: u64, umax: u64, smin: i64, smax: i64, var: Tnum) -> Scalar {
    norm(parts(umin, umax, smin, smax, var))
}

pub fn scalar_add(a: Scalar, b: Scalar) -> Scalar {
    let var = tnum_add(a.var, b.var);
    let lo = wrapping_add(a.umin, b.umin);
    let hi = wrapping_add(a.umax, b.umax);
    let mut umin: u64 = 0;
    let mut umx: u64 = umax();
    if lo >= a.umin && hi >= a.umax {
        umin = lo;
        umx = hi;
    }
    let mut smin = smin_i64();
    let mut smax = smax_i64();
    match checked_add_i64(a.smin, b.smin) {
        Option::Some(l) => match checked_add_i64(a.smax, b.smax) {
            Option::Some(h) => {
                smin = l;
                smax = h;
            },
            Option::None => (),
        },
        Option::None => (),
    }
    from_parts(umin, umx, smin, smax, var)
}

pub fn scalar_sub(a: Scalar, b: Scalar) -> Scalar {
    let var = tnum_sub(a.var, b.var);
    let mut umin: u64 = 0;
    let mut umx: u64 = umax();
    if a.umin >= b.umax {
        umin = wrapping_sub(a.umin, b.umax);
        umx = wrapping_sub(a.umax, b.umin);
    }
    let mut smin = smin_i64();
    let mut smax = smax_i64();
    match checked_sub_i64(a.smin, b.smax) {
        Option::Some(l) => match checked_sub_i64(a.smax, b.smin) {
            Option::Some(h) => {
                smin = l;
                smax = h;
            },
            Option::None => (),
        },
        Option::None => (),
    }
    from_parts(umin, umx, smin, smax, var)
}

pub fn scalar_mul(a: Scalar, b: Scalar) -> Scalar {
    if is_const(a) && is_const(b) {
        return scalar_konst(wrapping_mul(a.umin, b.umin));
    }
    let (hi, hi_over) = mul_wide(a.umax, b.umax);
    let (lo, lo_over) = mul_wide(a.umin, b.umin);
    if hi_over == 0 && lo_over == 0 {
        scalar_urange(lo, hi)
    } else {
        scalar_unknown()
    }
}

pub fn scalar_and(a: Scalar, b: Scalar) -> Scalar {
    let var = tnum_and(a.var, b.var);
    let umx = min_u64(a.umax, b.umax);
    if a.smin >= 0 || b.smin >= 0 {
        let hi = if a.smin >= 0 && b.smin >= 0 {
            min_i64(a.smax, b.smax)
        } else if a.smin >= 0 {
            a.smax
        } else {
            b.smax
        };
        from_parts(0, umx, 0, hi, var)
    } else {
        from_parts(0, umx, smin_i64(), smax_i64(), var)
    }
}

pub fn scalar_or(a: Scalar, b: Scalar) -> Scalar {
    let var = tnum_or(a.var, b.var);
    from_parts(max_u64(a.umin, b.umin), umax(), smin_i64(), smax_i64(), var)
}

pub fn scalar_xor(a: Scalar, b: Scalar) -> Scalar {
    from_parts(0, umax(), smin_i64(), smax_i64(), tnum_xor(a.var, b.var))
}

pub fn scalar_lsh(a: Scalar, s: u32) -> Scalar {
    let var = tnum_lsh(a.var, s);
    if s == 0 {
        return a;
    }
    let n = widen_u64(s);
    if leading_zeros_u64(a.umax) >= s {
        from_parts(shl(a.umin, n), shl(a.umax, n), smin_i64(), smax_i64(), var)
    } else {
        from_parts(0, umax(), smin_i64(), smax_i64(), var)
    }
}

pub fn scalar_rsh(a: Scalar, s: u32) -> Scalar {
    let var = tnum_rsh(a.var, s);
    let n = widen_u64(s);
    from_parts(shr(a.umin, n), shr(a.umax, n), smin_i64(), smax_i64(), var)
}

pub fn scalar_arsh(a: Scalar, s: u32) -> Scalar {
    let var = tnum_arsh(a.var, s);
    let n = widen_u64(s);
    from_parts(0, umax(), signed(sar(bits(a.smin), n)), signed(sar(bits(a.smax), n)), var)
}

pub fn scalar_zext32(a: Scalar) -> Scalar {
    if a.umax <= 4294967295 {
        a
    } else {
        from_parts(0, 4294967295, smin_i64(), smax_i64(), tnum_truncate(a.var, 32))
    }
}

pub fn scalar_truncate(a: Scalar, width: u32) -> Scalar {
    if width >= 64 {
        return a;
    }
    let m = wrapping_sub(shl(1, widen_u64(width)), 1);
    if a.umax <= m {
        a
    } else {
        from_parts(0, m, smin_i64(), smax_i64(), tnum_truncate(a.var, width))
    }
}

pub fn scalar_sext(a: Scalar, width: u32) -> Scalar {
    if is_const(a) {
        return scalar_konst(sext_const(a.umin, widen_u64(width)));
    }
    let half = shl(1, wrapping_sub(widen_u64(width), 1));
    let t = scalar_truncate(a, width);
    if t.umax < half {
        t
    } else {
        scalar_srange(signed(wrapping_sub(0, half)), signed(wrapping_sub(half, 1)))
    }
}

pub fn scalar_hull(a: Scalar, b: Scalar) -> Scalar {
    let x = a.var.value ^ b.var.value;
    let mask = a.var.mask | b.var.mask | x;
    from_parts(
        min_u64(a.umin, b.umin),
        max_u64(a.umax, b.umax),
        min_i64(a.smin, b.smin),
        max_i64(a.smax, b.smax),
        tn(a.var.value & ~mask, mask)
    )
}

pub fn scalar_meet(a: Scalar, b: Scalar) -> Option[Scalar] {
    match tnum_intersect(a.var, b.var) {
        Option::Some(var) => scalar_normalize(
            parts(
                max_u64(a.umin, b.umin),
                min_u64(a.umax, b.umax),
                max_i64(a.smin, b.smin),
                min_i64(a.smax, b.smax),
                var
            )
        ),
        Option::None => Option::None,
    }
}

// ---------------------------------------------------------------------------
// The verifier's domain functions (src/verifier.rs).

// The abstract result of a scalar ALU op on already-truncated operands.
// Mov, MovSx and Neg are the caller's (Rust panics; this returns `a`).
pub fn scalar_alu(op: AluOp, wide: bool, a: Scalar, b: Scalar) -> Scalar {
    let width: u64 = if wide {
        64
    } else {
        32
    };
    let shift = wrapping_u32(b.umin & wrapping_sub(width, 1));
    match op {
        AluOp::Add => scalar_add(a, b),
        AluOp::Sub => scalar_sub(a, b),
        AluOp::Mul => scalar_mul(a, b),
        AluOp::Div => scalar_unknown(),
        AluOp::Mod => scalar_unknown(),
        AluOp::SDiv => scalar_unknown(),
        AluOp::SMod => scalar_unknown(),
        AluOp::Or => scalar_or(a, b),
        AluOp::And => scalar_and(a, b),
        AluOp::Xor => scalar_xor(a, b),
        AluOp::Lsh => if is_const(b) {
            scalar_lsh(a, shift)
        } else {
            scalar_unknown()
        },
        AluOp::Rsh => if is_const(b) {
            scalar_rsh(a, shift)
        } else {
            scalar_urange(0, a.umax)
        },
        AluOp::Arsh => if !is_const(b) {
            scalar_unknown()
        } else if wide {
            scalar_arsh(a, shift)
        } else if is_const(a) {
            let c = widen_i64(wrapping_i32(a.umin));
            let r = wrapping_shr_i64(c, shift);
            scalar_konst(widen_u64(wrapping_u32(r)))
        } else {
            scalar_unknown_bits(32)
        },
        AluOp::Neg => a,
        AluOp::Mov => a,
        AluOp::MovSx(w) => a,
    }
}

fn exclude(input: Scalar, c: u64) -> Option[Scalar] {
    let mut s = input;
    if s.umin == c {
        if c == umax() {
            return Option::None;
        }
        s.umin = wrapping_add(c, 1);
    }
    if s.umax == c {
        if c == 0 {
            return Option::None;
        }
        s.umax = wrapping_sub(c, 1);
    }
    let ci = signed(c);
    if s.smin == ci {
        if ci == smax_i64() {
            return Option::None;
        }
        s.smin = signed(wrapping_add(c, 1));
    }
    if s.smax == ci {
        if ci == smin_i64() {
            return Option::None;
        }
        s.smax = signed(wrapping_sub(c, 1));
    }
    scalar_normalize(s)
}

fn negate(op: JmpOp) -> JmpOp {
    match op {
        JmpOp::Eq => JmpOp::Ne,
        JmpOp::Ne => JmpOp::Eq,
        JmpOp::Gt => JmpOp::Le,
        JmpOp::Le => JmpOp::Gt,
        JmpOp::Ge => JmpOp::Lt,
        JmpOp::Lt => JmpOp::Ge,
        JmpOp::SGt => JmpOp::SLe,
        JmpOp::SLe => JmpOp::SGt,
        JmpOp::SGe => JmpOp::SLt,
        JmpOp::SLt => JmpOp::SGe,
        JmpOp::Set => JmpOp::Set,
    }
}

fn pair(a: Scalar, b: Scalar) -> Option[(Scalar, Scalar)] {
    Option::Some((a, b))
}

fn known_zero_bits(c: u64) -> Scalar {
    let u = scalar_unknown();
    parts(u.umin, u.umax, u.smin, u.smax, tn(0, ~c))
}

// Refine `(a, b)` assuming `a op b` holds (`holds`) or does not; None when
// that outcome is impossible.
pub fn refine_jmp(op: JmpOp, wide: bool, a: Scalar, b: Scalar, holds: bool)
    -> Option[(Scalar, Scalar)] {
    if !wide {
        if is_const(a) && is_const(b) {
            let r = cmp_concrete(op, false, a.umin, b.umin);
            if r == holds {
                return pair(a, b);
            }
            return Option::None;
        }
        let fits = match op {
            JmpOp::SGt => a.umax <= 2147483647 && b.umax <= 2147483647,
            JmpOp::SGe => a.umax <= 2147483647 && b.umax <= 2147483647,
            JmpOp::SLt => a.umax <= 2147483647 && b.umax <= 2147483647,
            JmpOp::SLe => a.umax <= 2147483647 && b.umax <= 2147483647,
            _ => a.umax <= 4294967295 && b.umax <= 4294967295,
        };
        if !fits {
            return pair(a, b);
        }
    }
    if !holds {
        if op == JmpOp::Set {
            if is_const(b) {
                return match scalar_meet(a, known_zero_bits(b.umin)) {
                    Option::Some(na) => pair(na, b),
                    Option::None => Option::None,
                };
            }
            if is_const(a) {
                return match scalar_meet(b, known_zero_bits(a.umin)) {
                    Option::Some(nb) => pair(a, nb),
                    Option::None => Option::None,
                };
            }
            return pair(a, b);
        }
    }
    // `a op b` failing is `a negate(op) b` holding, and `a < b` is `b > a`:
    // one comparison of the four directions, its operands maybe swapped.
    let mut o = op;
    if !holds {
        o = negate(op);
    }
    let flip = o == JmpOp::Lt || o == JmpOp::Le || o == JmpOp::SLt || o == JmpOp::SLe;
    let mut x = a;
    let mut y = b;
    if flip {
        x = b;
        y = a;
        o = match o {
            JmpOp::Lt => JmpOp::Gt,
            JmpOp::Le => JmpOp::Ge,
            JmpOp::SLt => JmpOp::SGt,
            _ => JmpOp::SGe,
        };
    }
    match o {
        JmpOp::Eq => {
            return match scalar_meet(x, y) {
                Option::Some(m) => pair(m, m),
                Option::None => Option::None,
            };
        },
        JmpOp::Ne => {
            if is_const(x) && is_const(y) {
                if x.umin != y.umin {
                    return pair(x, y);
                }
                return Option::None;
            }
            if is_const(y) {
                match exclude(x, y.umin) {
                    Option::Some(n) => {
                        x = n;
                    },
                    Option::None => {
                        return Option::None;
                    },
                }
            } else if is_const(x) {
                match exclude(y, x.umin) {
                    Option::Some(n) => {
                        y = n;
                    },
                    Option::None => {
                        return Option::None;
                    },
                }
            }
            return pair(x, y);
        },
        JmpOp::Set => {
            let t = tnum_and(x.var, y.var);
            if t.value == 0 && t.mask == 0 {
                return Option::None;
            }
            return pair(x, y);
        },
        JmpOp::Gt => {
            if y.umin == umax() || x.umax == 0 {
                return Option::None;
            }
            x.umin = max_u64(x.umin, wrapping_add(y.umin, 1));
            y.umax = min_u64(y.umax, wrapping_sub(x.umax, 1));
        },
        JmpOp::Ge => {
            x.umin = max_u64(x.umin, y.umin);
            y.umax = min_u64(y.umax, x.umax);
        },
        JmpOp::SGt => {
            if y.smin == smax_i64() || x.smax == smin_i64() {
                return Option::None;
            }
            x.smin = max_i64(x.smin, signed(wrapping_add(bits(y.smin), 1)));
            y.smax = min_i64(y.smax, signed(wrapping_sub(bits(x.smax), 1)));
        },
        JmpOp::SGe => {
            x.smin = max_i64(x.smin, y.smin);
            y.smax = min_i64(y.smax, x.smax);
        },
        _ => {},
    }
    match scalar_normalize(x) {
        Option::Some(nx) => match scalar_normalize(y) {
            Option::Some(ny) => if flip {
                pair(ny, nx)
            } else {
                pair(nx, ny)
            },
            Option::None => Option::None,
        },
        Option::None => Option::None,
    }
}

// `sext_const(imm as u32 as u64, bits)` (verifier::sext_imm).
pub fn sext_imm(imm: i32, width: u32) -> u64 {
    sext_const(widen_u64(wrapping_u32(imm)), widen_u64(width))
}
